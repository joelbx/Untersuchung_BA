diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..cc6f727 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,4 +1,6 @@
 from openlibrary.plugins.openlibrary import lists
+from openlibrary.plugins.upstream import utils
+import web
 
 
 def test_process_seeds():
@@ -11,3 +13,36 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_body_overrides_query_and_defaults(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'name=From+body&name=Ignored&seeds--0--key=%2Fbooks%2FOL1M&seeds--1--key=&seeds--2--key=%2Fworks%2FOL2W&seeds--3--key=invalid',
+    )
+    monkeypatch.setattr(web, 'input', lambda **kwargs: (_ for _ in ()).throw(AssertionError('query was read')))
+
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'From body'
+    assert record.description == ''
+    assert record.key is None
+    assert record.seeds == [{'key': '/books/OL1M'}, {'key': '/works/OL2W'}]
+
+
+def test_list_record_query_fallback(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+
+    def input_with_defaults(**defaults):
+        assert defaults == {'key': None, 'name': '', 'description': '', 'seeds': []}
+        return web.storage({**defaults, 'name': 'From query', 'seeds': ['OL1M']})
+
+    monkeypatch.setattr(web, 'input', input_with_defaults)
+    record = lists.ListRecord.from_input()
+    assert record.name == 'From query'
+    assert record.seeds == [{'key': '/books/OL1M'}]
+
+
+def test_unflatten_last_simple_assignment_wins():
+    assert utils.unflatten({'name--part': 'nested', 'name': 'last'}) == {'name': 'last'}
