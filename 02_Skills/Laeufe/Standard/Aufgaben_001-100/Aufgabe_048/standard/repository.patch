+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import pytest
+from jinja2.exceptions import TemplateSyntaxError
+
+from ansible.plugins.loader import filter_loader
+from ansible.template import JinjaPluginIntercept
+
+
+def test_removed_filter_reports_template_syntax_error(mocker):
+    metadata = {'plugin_routing': {'filter': {'old_filter': {'tombstone': {'removal_date': '2025-01-01'}}}}}
+    mocker.patch('ansible.template._get_collection_metadata', return_value=metadata)
+    intercept = JinjaPluginIntercept({}, filter_loader)
+    with pytest.raises(TemplateSyntaxError, match='2025-01-01'):
+        intercept['old_filter']
