+// getOwnerPkgs returns installed package keys for the owners of paths.
+// rpm may report several architectures or versions under the same name; only
+// the package represented in Packages can receive an affected process.
+func (o *redhatBase) getOwnerPkgs(paths []string) ([]string, error) {
+	if len(paths) == 0 {
+		return nil, nil
+	}
+	r := o.exec(util.PrependProxyEnv(o.rpmQf()+strings.Join(paths, " ")), noSudo)
+	// rpm returns a nonzero status for unowned paths even when other paths
+	// produced useful ownership records.
+	return o.parseOwnerPkgs(r.Stdout)
+}
 
