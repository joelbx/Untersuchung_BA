+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages = models.NewPackages(models.Package{
+		Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64",
+	})
+
+	owners, err := r.parseOwnerPkgs(`libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 40.el7 x86_64
+error: file /root/private: Permission denied
+file /tmp/unowned is not owned by any package
+error: file /tmp/gone: No such file or directory
+`)
+	if err != nil {
+		t.Fatalf("unexpected ownership error: %v", err)
+	}
+	if !reflect.DeepEqual(owners, []string{"libgcc"}) {
+		t.Errorf("owners = %v, want [libgcc]", owners)
+	}
+
+	for _, malformed := range []string{"unexpected rpm output\n", "error: file /tmp/bad: Input/output error\n"} {
+		if _, err := r.parseOwnerPkgs(malformed); err == nil {
+			t.Errorf("malformed ownership line %q must return an error", malformed)
+		}
+	}
+}
