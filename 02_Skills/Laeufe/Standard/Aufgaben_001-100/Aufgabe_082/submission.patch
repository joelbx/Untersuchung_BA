 // NewMultiLog returns a new instance of a multi logger
-func NewMultiLog(loggers ...IAuditLog) *MultiLog {
-	return &MultiLog{
-		loggers: loggers,
+func NewMultiLog(loggers ...IAuditLog) (*MultiLog, error) {
+	emitters := make([]Emitter, 0, len(loggers))
+	for _, logger := range loggers {
+		emitter, ok := logger.(Emitter)
+		if !ok {
+			return nil, trace.BadParameter("expected emitter, but %T does not emit", logger)
+		}
+		emitters = append(emitters, emitter)
 	}
+	return &MultiLog{MultiEmitter: NewMultiEmitter(emitters...), loggers: loggers}, nil
 }
 
 // MultiLog is a logger that fan outs write operations
 // to all loggers, and performs all read and search operations
 // on the first logger that implements the operation
 type MultiLog struct {
+	*MultiEmitter
 	loggers []IAuditLog
 }
 
diff --git a/lib/events/multilog_emitter_test.go b/lib/events/multilog_emitter_test.go
new file mode 100644
index 0000000..0783e2d
--- /dev/null
+++ b/lib/events/multilog_emitter_test.go
@@ -0,0 +1,54 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type testEventWriter struct {
+	bytes.Buffer
+	closes   int
+	closeErr error
+}
+
+func (w *testEventWriter) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+func TestWriterEmitterAndMultiLog(t *testing.T) {
+	first, second := &testEventWriter{}, &testEventWriter{}
+	firstEmitter, secondEmitter := NewWriterEmitter(first), NewWriterEmitter(second)
+	combined, err := NewMultiLog(firstEmitter, secondEmitter)
+	require.NoError(t, err)
+
+	event := &SessionStart{}
+	require.NoError(t, combined.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, first.String(), second.String())
+	require.True(t, bytes.HasSuffix(first.Bytes(), []byte("\n")))
+	require.Contains(t, first.String(), "{")
+
+	require.NoError(t, combined.Close())
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
+
+func TestMultiLogRejectsNonEmitter(t *testing.T) {
+	w := &testEventWriter{}
+	combined, err := NewMultiLog(NewWriterEmitter(w), NewWriterLog(w))
+	require.Nil(t, combined)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
+
+func TestWriterEmitterCloseAggregatesErrors(t *testing.T) {
+	w := &testEventWriter{closeErr: errors.New("close failed")}
+	err := NewWriterEmitter(w).Close()
+	require.Error(t, err)
+	require.Equal(t, 2, w.closes)
+}
