+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+jest.mock('@proton/shared/lib/helpers/browser');
+
+const mockGetBrowser = jest.mocked(getBrowser);
+const mockGetOS = jest.mocked(getOS);
+
+describe('mimeTypeFromFile', () => {
+    it('uses a supplied MIME type even for an empty file', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.jxl', { type: 'image/png' }))).resolves.toBe('image/png');
+    });
+
+    it('uses the extension when the MIME type is missing or generic', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.jxl'))).resolves.toBe(SupportedMimeTypes.jxl);
+        await expect(mimeTypeFromFile(new File([], 'photo.jxl', { type: 'application/octet-stream' }))).resolves.toBe(
+            SupportedMimeTypes.jxl
+        );
+    });
+
+    it('falls back to the generic MIME type for unknown extensions', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.unknownextension'))).resolves.toBe(
+            'application/octet-stream'
+        );
+    });
+});
+
+describe('Safari HEIC and JXL support', () => {
+    beforeEach(() => {
+        mockGetBrowser.mockReturnValue({ name: 'Safari', version: '17.0', major: '17' });
+        mockGetOS.mockReturnValue({ name: 'Mac OS', version: '14.0' });
+    });
+
+    it('supports HEIC, HEIF, and JXL on macOS Safari 17', () => {
+        expect(isHEICSupported()).toBe(true);
+        expect(isJXLSupported()).toBe(true);
+        [
+            SupportedMimeTypes.heic,
+            SupportedMimeTypes.heics,
+            SupportedMimeTypes.heif,
+            SupportedMimeTypes.heifs,
+            SupportedMimeTypes.jxl,
+        ].forEach((type) => expect(isSupportedImage(type)).toBe(true));
+    });
+
+    it('supports Mobile Safari 17 on iOS', () => {
+        mockGetBrowser.mockReturnValue({ name: 'Mobile Safari', version: '17.1', major: '17' });
+        mockGetOS.mockReturnValue({ name: 'iOS', version: '17.1' });
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(true);
+        expect(isSupportedImage(SupportedMimeTypes.heic)).toBe(true);
+    });
+
+    it.each([
+        ['Safari', '16.6', 'Mac OS'],
+        ['Chrome', '120', 'Mac OS'],
+        ['Safari', '17.0', 'Windows'],
+        ['Mobile Safari', '16.6', 'iOS'],
+    ])('rejects %s %s on %s', (name, version, osName) => {
+        mockGetBrowser.mockReturnValue({ name, version, major: version.split('.')[0] });
+        mockGetOS.mockReturnValue({ name: osName, version: '' });
+        expect(isHEICSupported()).toBe(false);
+        expect(isJXLSupported()).toBe(false);
+        expect(isSupportedImage(SupportedMimeTypes.heic)).toBe(false);
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(false);
+    });
+});
