+const isSafari17OnAppleOS = () => {
+    const { name, version } = getBrowser();
+    const { name: osName } = getOS();
+
+    return (
+        (osName === 'Mac OS' || osName === 'iOS') &&
+        (name === 'Safari' || name === 'Mobile Safari') &&
+        !!version &&
+        new Version(version).isGreaterThanOrEqual('17')
+    );
+};
+
+export const isHEICSupported = () => isSafari17OnAppleOS();
+
+export const isJXLSupported = () => isSafari17OnAppleOS();
+
 export const isImage = (mimeType: string) => mimeType.startsWith('image/');
 
 export const isExcel = (mimeType: string) => mimeType.startsWith('application/vnd.ms-excel');
