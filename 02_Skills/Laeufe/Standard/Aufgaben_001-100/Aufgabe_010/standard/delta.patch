+limitations under the License.
+*/
+
+import React from "react";
+import { mount } from "enzyme";
+
+import dis from "../../../../src/dispatcher/dispatcher";
+import RoomContext, { TimelineRenderingType } from "../../../../src/contexts/RoomContext";
+import { IRoomState } from "../../../../src/components/structures/RoomView";
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import { mkEvent } from "../../../test-utils";
+
+jest.mock("../../../../src/components/views/rooms/ReplyTile", () => () => null);
+
+describe("ReplyPreview", () => {
+    it("names the reply target and lets the user cancel", () => {
+        const replyToEvent = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:server",
+            user: "@alice:server",
+            content: { msgtype: "m.text", body: "Hello" },
+            ts: Date.now(),
+        });
+        const dispatch = jest.spyOn(dis, "dispatch").mockImplementation(() => null);
+        const wrapper = mount(<RoomContext.Provider value={{
+            timelineRenderingType: TimelineRenderingType.Room,
+        } as IRoomState}>
+            <ReplyPreview replyToEvent={replyToEvent} permalinkCreator={null} />
+        </RoomContext.Provider>);
+
+        expect(wrapper.find(".mx_ReplyPreview_header span").text()).toContain("@alice:server");
+        const cancel = wrapper.find('button[aria-label="Cancel reply"]');
+        expect(cancel).toHaveLength(1);
+        cancel.simulate("click");
+        expect(dispatch).toHaveBeenCalledWith({
+            action: "reply_to_event",
+            event: null,
+            context: TimelineRenderingType.Room,
+        });
+
+        dispatch.mockRestore();
+        wrapper.unmount();
+    });
+});
