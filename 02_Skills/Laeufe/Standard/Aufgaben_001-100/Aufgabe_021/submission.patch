+def is_seed_subject_string(seed: str) -> TypeGuard[SeedSubjectString]:
+    return seed.startswith(("subject:", "place:", "person:", "time:"))
+
+
+def subject_key_to_seed(key: str) -> SeedSubjectString:
+    """Turn a subject path or pseudo key into a list seed."""
+    subject = key.rsplit("/", 1)[-1].replace(",", "_")
+    while "__" in subject:
+        subject = subject.replace("__", "_")
+    if not subject.startswith(("place:", "person:", "time:", "subject:")):
+        subject = "subject:" + subject
+    return SeedSubjectString(subject)
+
+
+def _seed_key(seed: client.Thing | SeedDict | str) -> str:
+    if isinstance(seed, str):
+        return str(subject_key_to_seed(seed)) if seed.startswith('/subjects/') else seed
+    if isinstance(seed, dict):
+        key = seed['key']
+    else:
+        key = seed.key
+    return str(subject_key_to_seed(key)) if key.startswith('/subjects/') else key
+
