+        work = site.quicksave('/works/OL1W', '/type/work', title='A work')
+        author = site.quicksave('/authors/OL1A', '/type/author', name='An author')
+        site.quicksave('/books/OL1M', '/type/edition', title='An edition')
+        lst = site.quicksave('/lists/OL1L', '/type/list', name='A list', seeds=[])
+        assert lst.get_export_list() == {'authors': [], 'works': [], 'editions': []}
+
+        assert lst.add_seed(work)
+        assert not lst.add_seed({'key': work.key})
