@@ -79,9 +80,22 @@ var native nativeTID = &touchIDImpl{}
 type touchIDImpl struct{}
 
 func (touchIDImpl) IsAvailable() bool {
-	// TODO(codingllama): Write a deeper check that looks at binary
-	//  signature/entitlements/etc.
-	return true
+	diag, _ := nativeDiag()
+	return diag.IsAvailable
+}
+
+func nativeDiag() (*DiagResult, error) {
+	checks := uint32(C.TouchIDDiag())
+	result := &DiagResult{
+		HasCompileSupport:       true,
+		HasSignature:            checks&1 != 0,
+		HasEntitlements:         checks&2 != 0,
+		PassedLAPolicyTest:      checks&4 != 0,
+		PassedSecureEnclaveTest: checks&8 != 0,
+	}
+	result.IsAvailable = result.HasSignature && result.HasEntitlements &&
+		result.PassedLAPolicyTest && result.PassedSecureEnclaveTest
+	return result, nil
 }
 
