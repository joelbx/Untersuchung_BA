+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+const device = { device_id: 'device-id', display_name: 'Original', isVerified: false };
+
+const renderHeading = (saveDeviceName = jest.fn().mockResolvedValue(undefined), currentDevice = device) =>
+    render(<DeviceDetailHeading device={currentDevice} saveDeviceName={saveDeviceName} />);
+
+describe('DeviceDetailHeading', () => {
+    it('shows the device ID when the name is undefined', () => {
+        const { getByTestId } = renderHeading(undefined, { ...device, display_name: undefined });
+        expect(getByTestId('device-detail-heading').textContent).toContain('device-id');
+    });
+
+    it('saves an empty name and returns to the read view', async () => {
+        const save = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId, queryByTestId } = renderHeading(save);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        const input = getByTestId('device-detail-name-input') as HTMLInputElement;
+        expect(input.maxLength).toBe(100);
+        expect(getByTestId('device-detail-heading-edit').textContent).toContain('visible');
+        fireEvent.change(input, { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading')).toBeTruthy());
+        expect(save).toHaveBeenCalledWith('device-id', '');
+        expect(queryByTestId('device-detail-heading-edit')).not.toBeTruthy();
+    });
+
+    it('shows a saved name immediately', async () => {
+        const save = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = renderHeading(save);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading').textContent).toContain('Work Laptop'));
+        expect(save).toHaveBeenCalledWith('device-id', 'Work Laptop');
+    });
+
+    it('does not save an unchanged name and cancels edits', async () => {
+        const save = jest.fn();
+        const { getByTestId } = renderHeading(save);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading').textContent).toContain('Original'));
+        expect(save).not.toHaveBeenCalled();
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'New' } });
+        fireEvent.click(getByTestId('device-detail-name-cancel'));
+        expect(getByTestId('device-detail-heading').textContent).toContain('Original');
+        expect(save).not.toHaveBeenCalled();
+    });
+
+    it('shows progress and an error on a failed save', async () => {
+        let reject: (reason: Error) => void;
+        const save = jest.fn().mockImplementation(() => new Promise<void>((_, fail) => { reject = fail; }));
+        const { getByTestId } = renderHeading(save);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'New' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        expect(getByTestId('device-detail-name-save').hasAttribute('disabled')).toBe(true);
+        expect(getByTestId('device-detail-heading-edit').getElementsByClassName('mx_Spinner').length).toBeTruthy();
+        reject(new Error('network'));
+        await waitFor(() => expect(getByTestId('device-detail-name-error').textContent)
+            .toBe('Failed to set display name.'));
+    });
+});
