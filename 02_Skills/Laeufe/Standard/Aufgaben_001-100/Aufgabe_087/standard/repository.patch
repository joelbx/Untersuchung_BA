+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,153 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) { return f(req) }
+
+func TestReporterStateAndReport(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID == "" || r.state.Version != schemaVersion {
+		t.Fatalf("bad initial state: %+v", r.state)
+	}
+	id := r.state.UUID
+	info.Version = "test-version"
+	defer func() { info.Version = "dev" }()
+	r.client.Transport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if req.Method != http.MethodPost {
+			t.Errorf("method = %s", req.Method)
+		}
+		var event struct {
+			AnonymousID string `json:"anonymousId"`
+			Event       string `json:"event"`
+			Properties  struct {
+				UUID    string `json:"uuid"`
+				Version string `json:"version"`
+				Flipt   struct {
+					Version string `json:"version"`
+				} `json:"flipt"`
+			} `json:"properties"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&event); err != nil {
+			t.Error(err)
+		}
+		if event.AnonymousID != id || event.Event != "flipt.ping" || event.Properties.UUID != id || event.Properties.Version != schemaVersion || event.Properties.Flipt.Version != "test-version" {
+			t.Errorf("unexpected event: %+v", event)
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(&emptyReader{})}, nil
+	})
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if r.state.LastTimestamp == "" {
+		t.Fatal("timestamp not updated")
+	}
+	other, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if other.state.UUID != id || other.state.LastTimestamp != r.state.LastTimestamp {
+		t.Fatalf("state not persisted: %+v", other.state)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "telemetry.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !json.Valid(data) {
+		t.Fatal("invalid state JSON")
+	}
+}
+
+type emptyReader struct{}
+
+func (*emptyReader) Read([]byte) (int, error) { return 0, io.EOF }
+
+func TestReporterDisabledAndInvalidState(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.TelemetryEnabled = false
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter = %v, %v", r, err)
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatalf("disabled telemetry created directory: %v", err)
+	}
+	cfg.Meta.TelemetryEnabled = true
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "telemetry.json")
+	if err := os.WriteFile(path, []byte(`{"version":"1.0","uuid":"broken"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	r, err = NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID == "broken" || r.state.UUID == "" {
+		t.Fatal("invalid UUID retained")
+	}
+}
+
+func TestReporterRejectsFileStateDirectory(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "file")
+	if err := os.WriteFile(path, []byte("x"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = path
+	r, err := NewReporter(cfg, logrus.New())
+	if err == nil || r != nil {
+		t.Fatalf("reporter = %v, err = %v", r, err)
+	}
+}
+
+func TestFailedReportDoesNotAdvanceTimestamp(t *testing.T) {
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = t.TempDir()
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.client.Transport = roundTripFunc(func(*http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: http.StatusServiceUnavailable, Body: io.NopCloser(&emptyReader{})}, nil
+	})
+	if err := r.Report(context.Background()); err == nil {
+		t.Fatal("expected send failure")
+	}
+	if r.state.LastTimestamp != "" {
+		t.Fatal("failed report advanced timestamp")
+	}
+	data, err := os.ReadFile(filepath.Join(cfg.Meta.StateDirectory, "telemetry.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var persisted state
+	if err := json.Unmarshal(data, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if persisted.LastTimestamp != "" {
+		t.Fatal("failed report persisted timestamp")
+	}
+}
