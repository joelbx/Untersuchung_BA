index 0000000..14049ac
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,34 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Version is the running Flipt version, set by the executable at startup.
+var Version = "dev"
+
+// Flipt describes the running server's build and update status.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the build information as JSON.
+func (i Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(i)
+	if err != nil {
+		http.Error(w, "encoding build information", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if _, err = w.Write(out); err != nil {
+		// Headers may already have been sent by a partially successful write.
+		w.WriteHeader(http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..76bdee8
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,200 @@
+// Package telemetry reports anonymous Flipt installation usage.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	endpoint      = "https://telemetry.flipt.io/v1/track"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter sends a periodic anonymous ping and keeps the installation ID on disk.
+type Reporter struct {
+	mu     sync.Mutex
+	state  state
+	path   string
+	client *http.Client
+	logger logrus.FieldLogger
+}
+
+// NewReporter initializes persistent state when telemetry is enabled.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	if logger == nil {
+		logger = logrus.StandardLogger()
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		base, err := os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding user configuration directory: %w", err)
+		}
+		dir = filepath.Join(base, "flipt")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+	path := filepath.Join(dir, "telemetry.json")
+	r := &Reporter{path: path, logger: logger, client: &http.Client{Timeout: 10 * time.Second}}
+	data, err := os.ReadFile(path)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.WithError(err).Warn("invalid telemetry state; creating a new identifier")
+			r.state = state{}
+		}
+	}
+	parsedID, parseErr := uuid.FromString(r.state.UUID)
+	if parseErr != nil || parsedID == uuid.Nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry identifier: %w", err)
+		}
+		r.state.UUID = id.String()
+	}
+	r.state.Version = schemaVersion
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+// Start reports when due, then schedules the next report four hours later.
+// It returns when ctx is canceled.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	for {
+		r.mu.Lock()
+		last, err := time.Parse(time.RFC3339, r.state.LastTimestamp)
+		r.mu.Unlock()
+		wait := time.Duration(0)
+		if err == nil {
+			wait = time.Until(last.Add(interval))
+		}
+		if wait > 0 {
+			timer := time.NewTimer(wait)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+		if ctx.Err() != nil {
+			return
+		}
+		if err := r.Report(ctx); err != nil && ctx.Err() == nil {
+			r.logger.WithError(err).Warn("sending telemetry")
+			// Failed sends are retried on the next interval without affecting the server.
+			timer := time.NewTimer(interval)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+	}
+}
+
+// Report sends a single flipt.ping event and records the successful send time.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	payload := struct {
+		AnonymousID string                 `json:"anonymousId"`
+		Event       string                 `json:"event"`
+		Properties  map[string]interface{} `json:"properties"`
+	}{
+		AnonymousID: r.state.UUID,
+		Event:       "flipt.ping",
+		Properties: map[string]interface{}{
+			"uuid":    r.state.UUID,
+			"version": schemaVersion,
+			"flipt":   map[string]string{"version": info.Version},
+		},
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry event: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("telemetry endpoint returned HTTP %d", resp.StatusCode)
+	}
+	previousTimestamp := r.state.LastTimestamp
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.save(); err != nil {
+		r.state.LastTimestamp = previousTimestamp
+		return err
+	}
+	return nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	file, err := os.CreateTemp(filepath.Dir(r.path), ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("creating telemetry state: %w", err)
+	}
+	defer os.Remove(file.Name())
+	if err := file.Chmod(0600); err != nil {
+		file.Close()
+		return fmt.Errorf("securing telemetry state: %w", err)
+	}
+	if _, err := file.Write(data); err != nil {
+		file.Close()
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := file.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(file.Name(), r.path); err != nil {
+		return fmt.Errorf("replacing telemetry state: %w", err)
+	}
+	return nil
+}
