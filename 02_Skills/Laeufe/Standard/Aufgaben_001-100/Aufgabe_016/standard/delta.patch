+def get_service_ip(image_name: str) -> str:
+    """Return a container's IP address from Docker inspection."""
+    container = image_name if image_name.startswith("openlibrary-") else f"openlibrary-{image_name}-1"
+    result = subprocess.run(
+        ["docker", "inspect", "--format", "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}", container],
