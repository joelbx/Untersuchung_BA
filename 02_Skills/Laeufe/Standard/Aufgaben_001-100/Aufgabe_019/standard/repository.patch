+package teleport
+
+import "testing"
+
+func TestRolesCheck(t *testing.T) {
+	tests := []struct {
+		name    string
+		roles   Roles
+		wantErr bool
+	}{
+		{name: "nil"},
+		{name: "empty", roles: Roles{}},
+		{name: "valid unique", roles: Roles{RoleAuth, RoleProxy}},
+		{name: "unknown", roles: Roles{RoleAuth, Role("unknown")}, wantErr: true},
+		{name: "duplicate", roles: Roles{RoleAuth, RoleProxy, RoleAuth}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if err := tt.roles.Check(); (err != nil) != tt.wantErr {
+				t.Fatalf("Check() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestRolesEquals(t *testing.T) {
+	tests := []struct {
+		name  string
+		left  Roles
+		right Roles
+		want  bool
+	}{
+		{name: "nil and empty", right: Roles{}, want: true},
+		{name: "same roles different order", left: Roles{RoleAuth, RoleProxy}, right: Roles{RoleProxy, RoleAuth}, want: true},
+		{name: "duplicate collapses", left: Roles{RoleAuth}, right: Roles{RoleAuth, RoleAuth}, want: true},
+		{name: "same length different roles", left: Roles{RoleAuth, RoleAuth}, right: Roles{RoleAuth, RoleProxy}},
+		{name: "different distinct roles", left: Roles{RoleAuth, RoleProxy}, right: Roles{RoleAuth, RoleNode}},
+		{name: "extra distinct role", left: Roles{RoleAuth, RoleAuth}, right: Roles{RoleAuth, RoleProxy, RoleProxy}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.left.Equals(tt.right); got != tt.want {
+				t.Fatalf("%v.Equals(%v) = %v, want %v", tt.left, tt.right, got, tt.want)
+			}
+			if got := tt.right.Equals(tt.left); got != tt.want {
+				t.Fatalf("%v.Equals(%v) = %v, want %v", tt.right, tt.left, got, tt.want)
+			}
+		})
+	}
+}
