diff --git a/lib/ansible/modules/net_tools/nios/nios_fixed_address.py b/lib/ansible/modules/net_tools/nios/nios_fixed_address.py
new file mode 100644
index 0000000..c7c8b4b
--- /dev/null
+++ b/lib/ansible/modules/net_tools/nios/nios_fixed_address.py
@@ -0,0 +1,164 @@
+#!/usr/bin/python
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1',
+                    'status': ['preview'],
+                    'supported_by': 'certified'}
+
+DOCUMENTATION = '''
+---
+module: nios_fixed_address
+short_description: Manage Infoblox NIOS DHCP fixed addresses
+description:
+  - Creates, updates, and removes IPv4 and IPv6 DHCP fixed addresses through WAPI.
+requirements:
+  - infoblox-client
+extends_documentation_fragment: nios
+options:
+  name:
+    description: Name of the fixed address.
+    required: true
+  ipaddr:
+    description: IPv4 or IPv6 address to reserve.
+    required: true
+  mac:
+    description: MAC address associated with the reservation.
+    required: true
+  network:
+    description: Network containing the address, in CIDR notation.
+    required: true
+  network_view:
+    description: Network view containing the reservation.
+    default: default
+  options:
+    description: DHCP options for the fixed address.
+    suboptions:
+      name:
+        description: DHCP option name. Either C(name) or C(num) is required.
+      num:
+        description: DHCP option number. Either C(name) or C(num) is required.
+        type: int
+      value:
+        description: DHCP option value.
+        required: true
+      use_option:
+        description: Whether to use this option.
+        type: bool
+        default: true
+      vendor_class:
+        description: DHCP vendor class.
+        default: DHCP
+  extattrs:
+    description: Extensible attributes as key and value pairs.
+    type: dict
+  comment:
+    description: Comment associated with the fixed address.
+  state:
+    description: Whether the fixed address should exist.
+    choices: [present, absent]
+    default: present
+'''
+
+EXAMPLES = '''
+- name: Reserve an IPv4 address
+  nios_fixed_address:
+    name: printer
+    ipaddr: 192.0.2.10
+    mac: 00:11:22:33:44:55
+    network: 192.0.2.0/24
+    options:
+      - name: domain-name
+        value: example.com
+    provider: "{{ nios_provider }}"
+  connection: local
+
+- name: Remove an IPv6 fixed address
+  nios_fixed_address:
+    name: printer-v6
+    ipaddr: 2001:db8::10
+    mac: 00:11:22:33:44:55
+    network: 2001:db8::/64
+    state: absent
+    provider: "{{ nios_provider }}"
+  connection: local
+'''
+
+RETURN = ''' # '''
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.six import iteritems
+from ansible.module_utils.network.common.utils import validate_ip_address, validate_ip_v6_address
+from ansible.module_utils.net_tools.nios.api import (WapiModule, NIOS_IPV4_FIXED_ADDRESS,
+                                                     NIOS_IPV6_FIXED_ADDRESS)
+
+
+def options(module):
+    '''Return DHCP options without fields rejected by WAPI.'''
+    result = []
+    for item in module.params['options']:
+        option = dict((key, value) for key, value in iteritems(item) if value is not None)
+        if not ('name' in option or 'num' in option):
+            module.fail_json(msg='one of `name` or `num` is required for option value')
+        if 'value' not in option:
+            module.fail_json(msg='`value` is required for option value')
+        option.setdefault('use_option', True)
+        option.setdefault('vendor_class', 'DHCP')
+        result.append(option)
+    return result
+
+
+def validate_ip_addr_type(ip, arg_spec, module):
+    '''Select the WAPI fixed address type and remap the address field.'''
+    if validate_ip_address(ip):
+        address_field = 'ipv4addr'
+        object_type = NIOS_IPV4_FIXED_ADDRESS
+    elif validate_ip_v6_address(ip):
+        address_field = 'ipv6addr'
+        object_type = NIOS_IPV6_FIXED_ADDRESS
+    else:
+        module.fail_json(msg='ipaddr must be a valid IPv4 or IPv6 address')
+
+    arg_spec[address_field] = arg_spec.pop('ipaddr')
+    module.params[address_field] = module.params.pop('ipaddr')
+    return object_type, arg_spec, module
+
+
+def main():
+    option_spec = dict(
+        name=dict(),
+        num=dict(type='int'),
+        value=dict(required=True),
+        use_option=dict(type='bool', default=True),
+        vendor_class=dict(default='DHCP')
+    )
+    ib_spec = dict(
+        name=dict(required=True),
+        ipaddr=dict(required=True, ib_req=True),
+        mac=dict(required=True, ib_req=True),
+        network=dict(required=True, ib_req=True),
+        network_view=dict(default='default', ib_req=True),
+        options=dict(type='list', elements='dict', options=option_spec, transform=options),
+        extattrs=dict(type='dict'),
+        comment=dict()
+    )
+    argument_spec = dict(state=dict(default='present', choices=['present', 'absent']))
+    argument_spec.update(ib_spec)
+    argument_spec.update(WapiModule.provider_spec)
+    argument_spec['provider'] = dict(WapiModule.provider_spec['provider'], required=True)
+
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+
+    # Keep the required lookup fields together before the address is renamed.
+    obj_filter = dict((key, module.params[key]) for key, value in iteritems(ib_spec)
+                      if value.get('ib_req'))
+    object_type, ib_spec, module = validate_ip_addr_type(obj_filter['ipaddr'], ib_spec, module)
+
+    wapi = WapiModule(module)
+    module.exit_json(**wapi.run(object_type, ib_spec))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/test/units/modules/net_tools/nios/test_nios_fixed_address.py b/test/units/modules/net_tools/nios/test_nios_fixed_address.py
new file mode 100644
index 0000000..e08deaf
--- /dev/null
+++ b/test/units/modules/net_tools/nios/test_nios_fixed_address.py
@@ -0,0 +1,116 @@
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+from units.compat.mock import Mock, patch
+from units.modules.utils import set_module_args
+from .test_nios_module import TestNiosModule
+
+
+class TestNiosFixedAddress(TestNiosModule):
+    module = nios_fixed_address
+
+    def setUp(self):
+        super(TestNiosFixedAddress, self).setUp()
+        self.connector_patch = patch('ansible.module_utils.net_tools.nios.api.get_connector')
+        self.connector_patch.start()
+
+    def tearDown(self):
+        self.connector_patch.stop()
+        super(TestNiosFixedAddress, self).tearDown()
+
+    def _args(self, address, network, state='present', check=False):
+        args = dict(name='printer', ipaddr=address, mac='00:11:22:33:44:55',
+                    network=network, provider={}, state=state)
+        if check:
+            args['_ansible_check_mode'] = True
+        set_module_args(args)
+
+    def _wapi(self, objects):
+        wapi = api.WapiModule
+        get_object = Mock(return_value=objects)
+        create = Mock()
+        update = Mock()
+        delete = Mock()
+        with patch.object(wapi, 'get_object', get_object, create=True), \
+                patch.object(wapi, 'create_object', create, create=True), \
+                patch.object(wapi, 'update_object', update, create=True), \
+                patch.object(wapi, 'delete_object', delete, create=True):
+            result = self.changed(changed=not bool(objects) or self.module_state == 'absent' or self.modified)
+        return result, get_object, create, update, delete
+
+    def test_ipv4_create_and_lookup(self):
+        self._args('192.0.2.10', '192.0.2.0/24')
+        self.module_state = 'present'
+        self.modified = False
+        _, lookup, create, _, _ = self._wapi(None)
+        lookup.assert_called_once()
+        self.assertEqual(lookup.call_args[0][0], api.NIOS_IPV4_FIXED_ADDRESS)
+        self.assertEqual(lookup.call_args[0][1], dict(ipv4addr='192.0.2.10',
+                                                      mac='00:11:22:33:44:55',
+                                                      network='192.0.2.0/24', network_view='default'))
+        self.assertEqual(create.call_args[0][1]['name'], 'printer')
+
+    def test_ipv6_create(self):
+        self._args('2001:db8::10', '2001:db8::/64')
+        self.module_state = 'present'
+        self.modified = False
+        _, lookup, create, _, _ = self._wapi(None)
+        self.assertEqual(lookup.call_args[0][0], api.NIOS_IPV6_FIXED_ADDRESS)
+        self.assertEqual(create.call_args[0][1]['ipv6addr'], '2001:db8::10')
+
+    def test_existing_address_is_idempotent(self):
+        self._args('192.0.2.10', '192.0.2.0/24')
+        self.module_state = 'present'
+        self.modified = False
+        current = [dict(_ref='fixedaddress/ref', name='printer', ipv4addr='192.0.2.10',
+                        mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                        network_view='default')]
+        _, _, create, update, delete = self._wapi(current)
+        create.assert_not_called()
+        update.assert_not_called()
+        delete.assert_not_called()
+
+    def test_check_mode_delete(self):
+        self._args('2001:db8::10', '2001:db8::/64', state='absent', check=True)
+        self.module_state = 'absent'
+        self.modified = False
+        current = [dict(_ref='ipv6fixedaddress/ref', name='printer', ipv6addr='2001:db8::10',
+                        mac='00:11:22:33:44:55', network='2001:db8::/64',
+                        network_view='default')]
+        _, _, create, update, delete = self._wapi(current)
+        create.assert_not_called()
+        update.assert_not_called()
+        delete.assert_not_called()
+
+    def test_invalid_address(self):
+        self._args('invalid', '192.0.2.0/24')
+        result = self.failed()
+        self.assertIn('ipaddr must be', result['msg'])
+
+    def test_update_comment(self):
+        self._args('192.0.2.10', '192.0.2.0/24')
+        self.module_state = 'present'
+        self.modified = True
+        current = [dict(_ref='fixedaddress/ref', name='printer', ipv4addr='192.0.2.10',
+                        mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                        network_view='default', comment='old')]
+        # Supply a changed comment through the module arguments.
+        set_module_args(dict(name='printer', ipaddr='192.0.2.10', mac='00:11:22:33:44:55',
+                             network='192.0.2.0/24', comment='new', provider={}))
+        _, _, create, update, delete = self._wapi(current)
+        create.assert_not_called()
+        delete.assert_not_called()
+        self.assertEqual(update.call_args[0][0], 'fixedaddress/ref')
+        self.assertEqual(update.call_args[0][1]['comment'], 'new')
+
+    def test_options_sanitize(self):
+        module = Mock()
+        module.params = {'options': [dict(name='domain-name', num=None, value='example.com'),
+                                     dict(name=None, num=6, value='192.0.2.1', use_option=False)]}
+        self.assertEqual(nios_fixed_address.options(module),
+                         [dict(name='domain-name', value='example.com', use_option=True,
+                               vendor_class='DHCP'),
+                          dict(num=6, value='192.0.2.1', use_option=False,
+                               vendor_class='DHCP')])
