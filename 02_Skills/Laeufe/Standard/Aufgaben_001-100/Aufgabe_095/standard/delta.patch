+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Format a year and optional month and day as a partial date string."""
+    result = f'{year}'
+    if month is not None:
+        result += f'-{month:02}'
+        if day is not None:
+            result += f'-{day:02}'
+    return result
+
