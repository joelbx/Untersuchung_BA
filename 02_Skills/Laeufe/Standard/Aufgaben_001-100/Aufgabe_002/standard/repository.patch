+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	addrs := c.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = c.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("no public proxy address configured")
+	}
+	addr := addrs[0]
+	host, err := utils.Host(addr.Addr)
+	if err != nil || host == "" || strings.ContainsAny(host, "/@?# \t\r\n[]") {
+		return "", trace.BadParameter("invalid Kubernetes proxy address %q", addr.Addr)
+	}
+	if host != addr.Addr && net.ParseIP(addr.Addr) == nil {
+		_, port, err := net.SplitHostPort(addr.Addr)
+		if err != nil {
+			return "", trace.BadParameter("invalid Kubernetes proxy address %q", addr.Addr)
+		}
+		n, err := strconv.Atoi(port)
+		if err != nil || n < 1 || n > 65535 {
+			return "", trace.BadParameter("invalid Kubernetes proxy address %q", addr.Addr)
+		}
+	}
+	return "https://" + net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)), nil
+}
