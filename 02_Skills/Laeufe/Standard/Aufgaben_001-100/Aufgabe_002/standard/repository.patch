+// kubeAddrFromPublicAddr replaces a registered proxy's HTTP port with the
+// Kubernetes proxy port. Malformed addresses are ignored by the caller.
+func kubeAddrFromPublicAddr(publicAddr string) (string, error) {
+	addr, err := utils.ParseAddr(publicAddr)
+	if err != nil || addr.AddrNetwork == "unix" || addr.Path != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", publicAddr)
+	}
+	host, err := utils.Host(addr.Addr)
+	if err != nil || host == "" || strings.ContainsAny(host, "/@?# \t\r\n[]") {
+		return "", trace.BadParameter("invalid proxy public address %q", publicAddr)
+	}
+	if host != addr.Addr && net.ParseIP(addr.Addr) == nil {
+		_, port, err := net.SplitHostPort(addr.Addr)
+		if err != nil {
+			return "", trace.BadParameter("invalid proxy public address %q", publicAddr)
+		}
+		n, err := strconv.Atoi(port)
+		if err != nil || n < 1 || n > 65535 {
+			return "", trace.BadParameter("invalid proxy public address %q", publicAddr)
+		}
+	}
+	return "https://" + net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)), nil
+}
