+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		input   string
+		want    bool
+	}{
+		{"foo", "foo", true},
+		{"foo", "foobar", false},
+		{"*", "anything", true},
+		{"foo*bar", "foo-middle-bar", true},
+		{"foo*bar", "foo-middle-baz", false},
+		{"^foo+$", "fooo", true},
+		{"^foo+$", "xfooo", false},
+		{`{{regexp.match("^foo+$")}}`, "fooo", true},
+		{`{{regexp.not_match("^foo+$")}}`, "bar", true},
+		{`{{regexp.not_match("^foo+$")}}`, "fooo", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz", true},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz-extra", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-xxbar-baz", true},
+		{`foo-{{regexp.match("^bar$")}}-baz`, "foo-xxbar-baz", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern+"/"+tt.input, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if assert.NoError(t, err) {
+				assert.Equal(t, tt.want, matcher.Match(tt.input))
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		pattern string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `is using template brackets`},
+		{`{{internal.foo}}`, `is not a valid matcher expression`},
+		{`{{regexp.match("foo")}}{{regexp.match("bar")}}`, `is not a valid matcher expression`},
+		{`{{email.local(internal.foo)}}`, `is not a valid matcher expression`},
+		{`{{email.local()}}`, `expects exactly one string literal argument`},
+		{`{{email.local("foo")}}`, `is not a valid matcher expression`},
+		{`{{other.match("foo")}}`, `unsupported function namespace other`},
+		{`{{regexp.unknown("foo")}}`, `unsupported function regexp.unknown`},
+		{`{{email.unknown("foo")}}`, `unsupported function email.unknown`},
+		{`{{regexp.match()}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match("foo", "bar")}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match(internal.foo)}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match("[")}}`, `failed parsing regexp "["`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			_, err := Match(tt.pattern)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err))
+				assert.True(t, strings.Contains(err.Error(), tt.message), err.Error())
+			}
+		})
+	}
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+}
