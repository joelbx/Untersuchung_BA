+// envVarDecodeHookFunc expands exact environment variable references before type conversion.
+func envVarDecodeHookFunc() mapstructure.DecodeHookFunc {
+	return func(_ reflect.Kind, _ reflect.Kind, data interface{}) (interface{}, error) {
+		value, ok := data.(string)
+		if !ok {
+			return data, nil
+		}
+
+		matches := envVarReference.FindStringSubmatch(value)
+		if matches == nil {
+			return data, nil
+		}
+
+		if value, ok := os.LookupEnv(matches[1]); ok {
+			return value, nil
+		}
+
+		return data, nil
+	}
+}
