+func TestLoadDefaultsAndEnvironmentOverrides(t *testing.T) {
+	file := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(file, []byte("log:\n  level: warn\nserver:\n  http_port: 8282\n"), 0600))
+
+	for _, tc := range []struct {
+		name      string
+		path      string
+		baseLevel string
+		basePort  int
+	}{
+		{name: "no configuration file", baseLevel: "INFO", basePort: 8080},
+		{name: "configuration file", path: file, baseLevel: "warn", basePort: 8282},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			res, err := Load(tc.path)
+			require.NoError(t, err)
+			assert.Equal(t, tc.baseLevel, res.Config.Log.Level)
+			assert.Equal(t, tc.basePort, res.Config.Server.HTTPPort)
+			if tc.path == "" {
+				assert.Equal(t, Default(), res.Config)
+			}
+
+			t.Setenv("FLIPT_LOG_LEVEL", "debug")
+			t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+
+			res, err = Load(tc.path)
+			require.NoError(t, err)
+			assert.Equal(t, "debug", res.Config.Log.Level)
+			assert.Equal(t, 8181, res.Config.Server.HTTPPort)
+			assert.Equal(t, Default().Server.GRPCPort, res.Config.Server.GRPCPort)
+		})
+	}
+}
