+func TestUbuntuContentSources(t *testing.T) {
+	contents := NewCveContents(
+		CveContent{Type: Nvd, SourceLink: "nvd", Cpes: []Cpe{{URI: "nvd"}}, References: References{{Link: "nvd"}}, CweIDs: []string{"nvd"}},
+		CveContent{Type: Ubuntu, SourceLink: "ubuntu", Cpes: []Cpe{{URI: "ubuntu"}}, References: References{{Link: "ubuntu"}}, CweIDs: []string{"ubuntu"}},
+		CveContent{Type: UbuntuAPI, SourceLink: "ubuntu-api", Cpes: []Cpe{{URI: "ubuntu-api"}}, References: References{{Link: "ubuntu-api"}}, CweIDs: []string{"ubuntu-api"}},
+	)
+	if got := contents.PrimarySrcURLs("en", "ubuntu", "CVE-1", nil); !reflect.DeepEqual(got, []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "ubuntu"}, {UbuntuAPI, "ubuntu-api"}}) {
+		t.Errorf("source URLs: %v", got)
+	}
+	if got := contents.Cpes("ubuntu"); len(got) != 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI || got[2].Type != Nvd {
+		t.Errorf("CPE order: %v", got)
+	}
+	if got := contents.References("ubuntu"); len(got) != 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI || got[2].Type != Nvd {
+		t.Errorf("reference order: %v", got)
+	}
+	if got := contents.CweIDs("ubuntu"); !reflect.DeepEqual(got, []CveContentStr{{Ubuntu, "ubuntu"}, {UbuntuAPI, "ubuntu-api"}, {Nvd, "nvd"}}) {
+		t.Errorf("CWE order: %v", got)
+	}
+}
