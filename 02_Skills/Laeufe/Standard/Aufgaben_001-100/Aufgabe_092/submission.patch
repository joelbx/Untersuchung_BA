+@pytest.mark.parametrize('upgrade, expected_dep', [(False, '1.0.0'), (True, '2.0.0')])
+def test_resolve_upgrade_transitive_dependency(galaxy_server, monkeypatch, tmp_path, upgrade, expected_dep):
+    versions = {'namespace.parent': ['1.0.0', '2.0.0'], 'namespace.child': ['1.0.0', '2.0.0']}
+    dependencies = {('namespace.parent', '1.0.0'): {'namespace.child': '>=1.0.0'},
+                    ('namespace.parent', '2.0.0'): {'namespace.child': '>=2.0.0'}}
+    monkeypatch.setattr(galaxy_server, 'get_collection_versions',
+                        lambda namespace, name: versions['%s.%s' % (namespace, name)])
+    monkeypatch.setattr(galaxy_server, 'get_collection_version_metadata',
+                        lambda namespace, name, version: api.CollectionVersionMetadata(
+                            namespace, name, version, None, None,
+                            dependencies.get(('%s.%s' % (namespace, name), version), {})))
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(to_bytes(str(tmp_path)), validate_certs=False)
+    installed = {Candidate('namespace.parent', '1.0.0', None, 'galaxy'),
+                 Candidate('namespace.child', '1.0.0', None, 'galaxy')}
+    requested = [Requirement('namespace.parent', '*', None, 'galaxy')]
+
+    result = collection._resolve_depenency_map(requested, [galaxy_server], manager, installed, False, False, upgrade)
+    assert result['namespace.parent'].ver == ('2.0.0' if upgrade else '1.0.0')
+    assert result['namespace.child'].ver == expected_dep
+
+
+@pytest.mark.parametrize('upgrade, no_deps, child_version', [
+    (False, False, None),
+    (True, False, '2.0.0'),
+    (True, True, None),
+])
+def test_upgrade_conflicting_installed_dependency(galaxy_server, monkeypatch, tmp_path,
+                                                  upgrade, no_deps, child_version):
+    monkeypatch.setattr(galaxy_server, 'get_collection_versions', lambda namespace, name: ['2.0.0'])
+    monkeypatch.setattr(galaxy_server, 'get_collection_version_metadata',
+                        lambda namespace, name, version: api.CollectionVersionMetadata(
+                            namespace, name, version, None, None,
+                            {'namespace.child': '>=2.0.0'} if name == 'parent' else {}))
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(to_bytes(str(tmp_path)), validate_certs=False)
+    installed = {Candidate('namespace.child', '1.0.0', None, 'galaxy')}
+    requested = [Requirement('namespace.parent', '2.0.0', None, 'galaxy')]
+    if not upgrade:
+        with pytest.raises(AnsibleError, match='Could not satisfy'):
+            collection._resolve_depenency_map(requested, [galaxy_server], manager, installed, no_deps, False, upgrade)
+    else:
+        result = collection._resolve_depenency_map(requested, [galaxy_server], manager, installed, no_deps, False, upgrade)
+        assert result['namespace.parent'].ver == '2.0.0'
+        if child_version is None:
+            assert 'namespace.child' not in result
+        else:
+            assert result['namespace.child'].ver == child_version
+
+
