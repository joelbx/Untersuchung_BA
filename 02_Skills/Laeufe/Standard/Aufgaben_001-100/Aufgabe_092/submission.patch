+    (True, False, '>=2.0.0,<3.0.0', '2.0.0'),
+])
+def test_resolve_upgrade_versions(galaxy_server, monkeypatch, tmp_path, upgrade, pre, constraint, expected):
+    versions = ['1.0.0', '2.0.0', '3.0.0-beta.1']
