+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,70 @@
+---
+- name: create upgrade test directory - {{ test_name }}
+  file:
+    path: '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+    state: directory
+
+- name: install old collection for upgrade - {{ test_name }}
+  command: ansible-galaxy collection install namespace1.name1:0.0.1 -s {{ test_name }} -p '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+
+- name: upgrade to latest stable collection - {{ test_name }}
+  command: ansible-galaxy collection install namespace1.name1 -U -s {{ test_name }} -p '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+  register: upgrade_stable
+
+- name: inspect upgraded stable collection - {{ test_name }}
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections/namespace1/name1/MANIFEST.json'
+  register: upgrade_stable_manifest
+
+- name: verify stable upgrade - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:1.0.9'' to" in upgrade_stable.stdout'
+    - (upgrade_stable_manifest.content | b64decode | from_json).collection_info.version == '1.0.9'
+
+- name: repeat stable upgrade - {{ test_name }}
+  command: ansible-galaxy collection install namespace1.name1 --upgrade -s {{ test_name }} -p '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+  register: upgrade_repeat
+
+- name: verify repeated upgrade is idempotent - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''namespace1.name1" not in upgrade_repeat.stdout'
+
+- name: upgrade with pre-releases enabled - {{ test_name }}
+  command: ansible-galaxy collection install namespace1.name1 --upgrade --pre -s {{ test_name }} -p '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+  register: upgrade_pre
+
+- name: verify pre-release upgrade - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:1.1.0-beta.1'' to" in upgrade_pre.stdout'
+
+- name: constrain upgrade to stable versions below 1.0.0 - {{ test_name }}
+  command: ansible-galaxy collection install 'namespace1.name1:<1.0.0' --upgrade -s {{ test_name }} -p '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+  register: upgrade_constrained
+
+- name: verify upgrade respects constraint - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:0.1.0'' to" in upgrade_constrained.stdout'
+
+- name: write upgrade requirements - {{ test_name }}
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade-{{ test_name }}/requirements.yml'
+    content: |
+      collections:
+        - name: namespace1.name1
+          version: '<1.1.0'
+        - name: child_dep.child_collection
+          version: '>=0.5.0,<1.0.0'
+
+- name: upgrade collections from requirements - {{ test_name }}
+  command: ansible-galaxy collection install -r '{{ galaxy_dir }}/upgrade-{{ test_name }}/requirements.yml' --upgrade -s {{ test_name }} -p '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+  register: upgrade_requirements
+
+- name: verify requirements upgrades - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:1.0.9'' to" in upgrade_requirements.stdout'
+    - '"Installing ''child_dep.child_collection:0.9.9'' to" in upgrade_requirements.stdout'
