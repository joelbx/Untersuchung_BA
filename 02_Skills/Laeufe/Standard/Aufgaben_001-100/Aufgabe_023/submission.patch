diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..a1a8a0b
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,48 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	cfg := AuthenticationConfig{Required: true}
+	schedule := AuthenticationCleanupSchedule{Interval: time.Hour, GracePeriod: time.Minute}
+
+	for _, info := range cfg.Methods.AllMethods() {
+		assert.Equal(t, info.Method != auth.Method_METHOD_JWT, info.RequiresDatabase, info.Name())
+		info.SetCleanup(t, schedule)
+	}
+
+	// Neither requiring authentication nor a schedule for a disabled method needs a database.
+	assert.False(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+
+	cfg.Methods.JWT.Enabled = true
+	assert.False(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+
+	for _, method := range []auth.Method{
+		auth.Method_METHOD_TOKEN,
+		auth.Method_METHOD_OIDC,
+		auth.Method_METHOD_GITHUB,
+		auth.Method_METHOD_KUBERNETES,
+	} {
+		cfg := cfg
+		for _, info := range cfg.Methods.AllMethods() {
+			if info.Method == method {
+				info.Enable(t)
+			}
+		}
+		assert.True(t, cfg.RequiresDatabase(), method.String())
+		assert.True(t, cfg.ShouldRunCleanup(), method.String())
+	}
+
+	cfg.Methods.Token.Enabled = true
+	cfg.Methods.Token.Cleanup = nil
+	assert.True(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+}
