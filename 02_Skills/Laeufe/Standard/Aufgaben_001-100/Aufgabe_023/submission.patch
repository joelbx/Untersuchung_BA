diff --git a/internal/cmd/authn_test.go b/internal/cmd/authn_test.go
new file mode 100644
index 0000000..67c952a
--- /dev/null
+++ b/internal/cmd/authn_test.go
@@ -0,0 +1,49 @@
+package cmd
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/pem"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap/zaptest"
+)
+
+func TestAuthenticationGRPCJWTWithoutDatabase(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	der, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+	require.NoError(t, err)
+	keyFile := filepath.Join(t.TempDir(), "jwt-public.pem")
+	require.NoError(t, os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der}), 0600))
+
+	for _, storageType := range []config.StorageType{
+		config.LocalStorageType,
+		config.GitStorageType,
+		config.OCIStorageType,
+	} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Storage.Type = storageType
+			cfg.Database.URL = "invalid-database-url"
+			cfg.Authentication.Required = true
+			cfg.Authentication.Methods.JWT.Enabled = true
+			cfg.Authentication.Methods.JWT.Method.PublicKeyFile = keyFile
+			cfg.Cache.Enabled = true
+
+			register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zaptest.NewLogger(t), cfg, false, false)
+			require.NoError(t, err)
+			assert.Len(t, register, 2)
+			assert.Len(t, interceptors, 3)
+			require.NoError(t, shutdown(context.Background()))
+		})
+	}
+}
