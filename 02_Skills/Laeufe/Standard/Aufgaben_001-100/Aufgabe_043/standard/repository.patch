@@ -0,0 +1,153 @@
+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/sdk/trace/tracetest"
+)
+
+func TestNewResource(t *testing.T) {
+	ctx := context.Background()
+	for _, tt := range []struct {
+		name, serviceName, attrs, wantName string
+	}{
+		{name: "defaults", wantName: "flipt"},
+		{name: "resource attributes", attrs: "service.name=from-attributes,service.version=from-env,region=west", wantName: "from-attributes"},
+		{name: "service name override", serviceName: "from-service-name", attrs: "service.name=from-attributes,region=west", wantName: "from-service-name"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("OTEL_SERVICE_NAME", tt.serviceName)
+			t.Setenv("OTEL_RESOURCE_ATTRIBUTES", tt.attrs)
+			res, err := newResource(ctx, "1.2.3")
+			if err != nil {
+				t.Fatal(err)
+			}
+			attrs := res.Set().ToSlice()
+			values := make(map[attribute.Key]string, len(attrs))
+			for _, attr := range attrs {
+				values[attr.Key] = attr.Value.AsString()
+			}
+			if values["service.name"] != tt.wantName || values["service.version"] != "1.2.3" {
+				t.Fatalf("unexpected resource attributes: %v", values)
+			}
+			if tt.attrs != "" && values["region"] != "west" {
+				t.Fatalf("missing environment resource attribute: %v", values)
+			}
+		})
+	}
+}
+
+func TestOTLPHTTPHeadersAndPath(t *testing.T) {
+	var gotHeader, gotPath string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotHeader = r.Header.Get("X-Trace-Key")
+		gotPath = r.URL.Path
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	ctx := context.Background()
+	cfg := &config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{
+		Endpoint: server.URL + "/custom/traces",
+		Headers:  map[string]string{"X-Trace-Key": "secret"},
+	}}
+	exporter, shutdown, err := GetExporter(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = shutdown(ctx) }()
+
+	provider, err := NewProvider(ctx, "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = provider.Shutdown(ctx) }()
+	recorder := tracetest.NewSpanRecorder()
+	provider.RegisterSpanProcessor(recorder)
+	_, span := provider.Tracer("test").Start(ctx, "request")
+	span.End()
+	if err := exporter.ExportSpans(ctx, recorder.Ended()); err != nil {
+		t.Fatal(err)
+	}
+	if gotHeader != "secret" || gotPath != "/custom/traces" {
+		t.Fatalf("received header %q and path %q", gotHeader, gotPath)
+	}
+}
+
+func TestNewProvider(t *testing.T) {
+	provider, err := NewProvider(context.Background(), "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = provider.Shutdown(context.Background()) })
+	_, span := provider.Tracer("test").Start(context.Background(), "sampled")
+	defer span.End()
+	if !span.IsRecording() || !span.SpanContext().IsSampled() {
+		t.Fatal("provider did not sample a root span")
+	}
+}
+
+func TestGetExporter(t *testing.T) {
+	ctx := context.Background()
+	for _, tt := range []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"otlp http", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318/v1/traces", Headers: map[string]string{"key": "value"}}}},
+		{"otlp https", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"otlp grpc", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317", Headers: map[string]string{"key": "value"}}}},
+		{"otlp no scheme", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317", Headers: map[string]string{"key": "value"}}}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			exporter, shutdown, err := GetExporter(ctx, &tt.cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if exporter == nil || shutdown == nil {
+				t.Fatal("missing exporter or shutdown")
+			}
+			if err := shutdown(ctx); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+
+	for _, endpoint := range []string{"", "http://", "grpc://localhost:4317/path", "ftp://localhost:4317", "http://%zz"} {
+		_, _, err := GetExporter(ctx, &config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: endpoint}})
+		if err == nil || !strings.HasPrefix(err.Error(), "parsing otlp endpoint:") {
+			t.Errorf("endpoint %q: expected parsing error, got %v", endpoint, err)
+		}
+	}
+	_, _, err := GetExporter(ctx, &config.TracingConfig{Exporter: config.TracingExporter(99)})
+	if err == nil || err.Error() != "unsupported tracing exporter: 99" {
+		t.Fatalf("unexpected unsupported exporter error: %v", err)
+	}
+
+	// A failed call must not poison later calls or share their exporter.
+	cfg := &config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}
+	first, stopFirst, err := GetExporter(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, stopSecond, err := GetExporter(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("exporter calls shared an instance")
+	}
+	if err := stopFirst(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := stopSecond(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
