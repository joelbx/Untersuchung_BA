+func TestKubeProxyAddressFromSettings(t *testing.T) {
+	tests := []struct {
+		name, listen, public, webPublic, want string
+	}{
+		{"wildcard ipv4", "0.0.0.0:8080", "", "", "proxy.example.com:8080"},
+		{"wildcard ipv6", "[::]:8080", "", "", "proxy.example.com:8080"},
+		{"web public", "0.0.0.0:8080", "", "public.example.com:3080", "public.example.com:8080"},
+		{"kube public", "0.0.0.0:8080", "kube.example.com:443", "public.example.com:3080", "kube.example.com:443"},
+		{"listen host", "kube.example.com:8080", "", "", "kube.example.com:8080"},
+		{"default port", "kube.example.com", "", "", "kube.example.com:3026"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			client := &TeleportClient{Config: Config{WebProxyAddr: "proxy.example.com:3080"}}
+			err := client.applyProxySettings(ProxySettings{
+				Kube: KubeProxySettings{Enabled: true, ListenAddr: tt.listen, PublicAddr: tt.public},
+				SSH:  SSHProxySettings{PublicAddr: tt.webPublic},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if client.KubeProxyAddr != tt.want {
+				t.Fatalf("got %q, want %q", client.KubeProxyAddr, tt.want)
+			}
+		})
+	}
+}
