+func TestProxyKubeListenAddr(t *testing.T) {
+	tests := []struct {
+		name, yaml, wantAddr   string
+		wantEnabled, wantError bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", true, false},
+		{"default port", "proxy_service:\n  kube_listen_addr: kube.example.com\n", "kube.example.com:3026", true, false},
+		{"ipv6", "proxy_service:\n  kube_listen_addr: '[::]:8080'\n", "[::]:8080", true, false},
+		{"legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8081\n", "0.0.0.0:8081", true, false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 0.0.0.0:8081\n", "0.0.0.0:8080", true, false},
+		{"conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8081\n", "", false, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fc, err := ReadConfig(bytes.NewBufferString(tt.yaml))
+			if tt.wantError && err != nil {
+				if !strings.Contains(err.Error(), "kube_listen_addr conflicts") {
+					t.Fatalf("expected conflict error, got %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			cfg := service.MakeDefaultConfig()
+			err = ApplyFileConfig(fc, cfg)
+			if tt.wantError {
+				if err == nil || !strings.Contains(err.Error(), "kube_listen_addr conflicts") {
+					t.Fatalf("expected conflict error, got %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cfg.Proxy.Kube.Enabled != tt.wantEnabled || cfg.Proxy.Kube.ListenAddr.Addr != tt.wantAddr {
+				t.Fatalf("got enabled=%v addr=%q, want enabled=%v addr=%q", cfg.Proxy.Kube.Enabled, cfg.Proxy.Kube.ListenAddr.Addr, tt.wantEnabled, tt.wantAddr)
+			}
+		})
+	}
+}
