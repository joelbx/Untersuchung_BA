+++ b/lib/utils/fanoutbuffer/buffer_test.go
@@ -0,0 +1,124 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestFanoutAndOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	a, c := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	got := make([]int, 5)
+	if n, err := a.TryRead(got[:3]); n != 3 || err != nil || !reflect.DeepEqual(got[:3], []int{1, 2, 3}) {
+		t.Fatalf("first read = %v, %v, %v", n, err, got[:3])
+	}
+	if n, err := a.TryRead(got[3:]); n != 2 || err != nil || !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+		t.Fatalf("second read = %v, %v, %v", n, err, got)
+	}
+	if n, err := c.TryRead(got[:1]); n != 1 || err != nil || got[0] != 1 {
+		t.Fatalf("slow cursor first read = %v, %v, %v", n, err, got[:1])
+	}
+	if n, err := c.TryRead(got[1:]); n != 4 || err != nil || !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+		t.Fatalf("slow cursor second read = %v, %v, %v", n, err, got)
+	}
+	if b.used != 0 || len(b.overflow) != 0 {
+		t.Fatalf("retained %d ring and %d overflow items", b.used, len(b.overflow))
+	}
+	b.Append(6, 7)
+	if n, err := a.TryRead(got[:2]); n != 2 || err != nil || !reflect.DeepEqual(got[:2], []int{6, 7}) {
+		t.Fatalf("read after cleanup = %v, %v, %v", n, err, got[:2])
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClockAt(time.Unix(0, 0))
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3)
+	var out [3]int
+	if n, err := fast.TryRead(out[:]); n != 3 || err != nil {
+		t.Fatalf("fast read = %d, %v", n, err)
+	}
+	clock.Advance(time.Minute)
+	if _, err := slow.TryRead(out[:]); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow read error = %v", err)
+	}
+	if b.used != 0 || len(b.overflow) != 0 {
+		t.Fatal("expired cursor retained items")
+	}
+	if _, err := fast.TryRead(out[:]); err != nil {
+		t.Fatalf("fast cursor error = %v", err)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	results := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		results <- err
+	}()
+	b.Close()
+	select {
+	case err := <-results:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("read error = %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read did not wake on close")
+	}
+	if err := c.Close(); err != nil {
+		t.Fatalf("cursor close = %v", err)
+	}
+	if _, err := c.TryRead(nil); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor error = %v", err)
+	}
+}
+
+func TestConcurrentConsumers(t *testing.T) {
+	const consumers, count = 8, 500
+	b := NewBuffer[int](Config{Capacity: 8})
+	cursors := make([]*Cursor[int], consumers)
+	for i := range cursors {
+		cursors[i] = b.NewCursor()
+	}
+	var wg sync.WaitGroup
+	for _, c := range cursors {
+		wg.Add(1)
+		go func(c *Cursor[int]) {
+			defer wg.Done()
+			out := make([]int, 11)
+			for next := 0; next < count; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, item := range out[:n] {
+					if item != next {
+						t.Errorf("got %d, want %d", item, next)
+						return
+					}
+					next++
+				}
+			}
+		}(c)
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+	for _, c := range cursors {
+		if err := c.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
