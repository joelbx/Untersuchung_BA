+func Test_redhatBase_parseInstalledPackagesContinuesAfterInvalidSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages(`elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)
+bar 1 9 123a ia64 1:bar-9-123a.src.rpm`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(bins["elasticsearch"], models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"}) {
+		t.Errorf("elasticsearch binary = %#v", bins["elasticsearch"])
+	}
+	if !reflect.DeepEqual(bins["bar"], models.Package{Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64"}) {
+		t.Errorf("bar binary = %#v", bins["bar"])
+	}
+	if !reflect.DeepEqual(srcs, models.SrcPackages{"bar": {Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}}}) {
+		t.Errorf("sources = %#v", srcs)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("warnings = %v", o.warns)
+	}
+}
