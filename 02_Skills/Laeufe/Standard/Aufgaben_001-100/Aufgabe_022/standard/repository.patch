+func TestSplitFileNameWithEpoch(t *testing.T) {
+	name, version, release, err := splitFileName("1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if name != "bar" || version != "1:9" || release != "123a" {
+		t.Errorf("splitFileName() = %q, %q, %q", name, version, release)
+	}
+}
