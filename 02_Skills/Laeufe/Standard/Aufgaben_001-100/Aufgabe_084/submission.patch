diff --git a/src/api/common/utils/EntityUtils.ts b/src/api/common/utils/EntityUtils.ts
index 95c62f2..2e2b2f6 100644
--- a/src/api/common/utils/EntityUtils.ts
+++ b/src/api/common/utils/EntityUtils.ts
@@ -131,6 +131,34 @@ export function haveSameId(entity1: SomeEntity, entity2: SomeEntity): boolean {
 	return isSameId(entity1._id, entity2._id)
 }
 
+/**
+ * Removes encryption and error metadata from a copied entity before it is used as a new instance.
+ * The resulting entity must not be used for updates.
+ */
+export function removeTechnicalFields<E extends SomeEntity>(entity: E): void {
+	const visited = new WeakSet<object>()
+
+	function removeFrom(value: object): void {
+		if (visited.has(value)) {
+			return
+		}
+		visited.add(value)
+
+		for (const key of Object.keys(value)) {
+			if (key.startsWith("_finalEncrypted") || key.startsWith("_defaultEncrypted") || key.startsWith("_errors")) {
+				delete (value as Record<string, unknown>)[key]
+			} else {
+				const nested = (value as Record<string, unknown>)[key]
+				if (nested !== null && typeof nested === "object") {
+					removeFrom(nested)
+				}
+			}
+		}
+	}
+
+	removeFrom(entity)
+}
+
 export function containsId(ids: ReadonlyArray<Id | IdTuple>, id: Id | IdTuple): boolean {
 	return ids.find((idInArray) => isSameId(idInArray, id)) != null
 }
