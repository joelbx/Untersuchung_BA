diff --git a/test/units/module_utils/facts/hardware/test_aix.py b/test/units/module_utils/facts/hardware/test_aix.py
new file mode 100644
index 0000000..2b0a6fb
--- /dev/null
+++ b/test/units/module_utils/facts/hardware/test_aix.py
@@ -0,0 +1,58 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat.mock import Mock
+
+from ansible.module_utils.facts.hardware.aix import AIXHardware
+
+
+def test_aix_cpu_facts_with_smt():
+    module = Mock()
+    module.run_command.side_effect = [
+        (0, 'proc0 Available Processor\nproc1 Defined Processor\n'
+            'proc2 Available Processor\nproc3 Available Processor\n', ''),
+        (0, 'type   PowerPC_POWER7   Processor type False\n', ''),
+        (0, 'smt_threads  4  SMT threads False\n', ''),
+    ]
+
+    facts = AIXHardware(module).get_cpu_facts()
+
+    assert facts == {
+        'processor': ['PowerPC_POWER7'],
+        'processor_count': 1,
+        'processor_cores': 3,
+        'processor_threads_per_core': 4,
+        'processor_vcpus': 12,
+    }
+    assert module.run_command.call_args_list[1][0][0] == '/usr/sbin/lsattr -El proc0 -a type'
+
+
+def test_aix_cpu_facts_without_smt_value():
+    module = Mock()
+    module.run_command.side_effect = [
+        (0, 'proc0 Available Processor\n', ''),
+        (0, 'type PowerPC_POWER7 Processor type False\n', ''),
+        (0, '', ''),
+    ]
+
+    assert AIXHardware(module).get_cpu_facts() == {
+        'processor': ['PowerPC_POWER7'],
+        'processor_count': 1,
+        'processor_cores': 1,
+        'processor_threads_per_core': 1,
+        'processor_vcpus': 1,
+    }
+
+
+def test_aix_cpu_facts_without_available_processors():
+    module = Mock()
+    module.run_command.return_value = (0, 'proc0 Defined Processor\n', '')
+
+    assert AIXHardware(module).get_cpu_facts() == {
+        'processor': [],
+        'processor_count': 1,
+        'processor_cores': 0,
+        'processor_threads_per_core': 1,
+        'processor_vcpus': 0,
+    }
+    assert module.run_command.call_count == 1
