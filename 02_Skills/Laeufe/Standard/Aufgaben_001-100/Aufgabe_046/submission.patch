+class ModuleUtilLocatorBase:
+    """Resolve one import without importing module_utils code on the controller."""
+
+    prefix_length = 0
+    redirect_first = False
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False):
+        self.fq_name_parts = tuple(fq_name_parts)
+        self.is_ambiguous = is_ambiguous and len(self.fq_name_parts) > self.prefix_length + 1
+        self.child_is_redirected = child_is_redirected
+        self.candidate_names = [self.fq_name_parts]
