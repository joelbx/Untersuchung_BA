+        self.source_path = None
+        self.redirect_target = None
+        self._resolve()
+
+    def candidate_names_joined(self):
+        return ['.'.join(candidate) for candidate in self.candidate_names]
+
+    def _resolve(self):
+        for candidate in self.candidate_names:
+            methods = (self._redirect, self._local) if self.redirect_first else (self._local, self._redirect)
+            for method in methods:
