diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..6d4a431
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,45 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r userPropsRepository) Put(key string, value string) error {
+	user := userId(r.ctx)
+	update := Update(r.tableName).Set("value", value).Where(Eq{"user_id": user, "key": key})
+	count, err := r.executeSQL(update)
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").Values(user, key, value)
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	sel := Select("value").From(r.tableName).Where(Eq{"user_id": userId(r.ctx), "key": key})
+	resp := struct{ Value string }{}
+	if err := r.queryOne(sel, &resp); err != nil {
+		return "", err
+	}
+	return resp.Value, nil
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	return r.delete(Eq{"user_id": userId(r.ctx), "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..a765d15
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,39 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User properties", func() {
+	It("scopes reads, updates, and deletes to the contextual user", func() {
+		o := orm.NewOrm()
+		for _, id := range []string{"alice", "bob"} {
+			_, err := o.Raw(`insert or ignore into user (id, user_name, email, created_at, updated_at) values (?, ?, ?, current_timestamp, current_timestamp)`, id, id, id+"@example.com").Exec()
+			Expect(err).To(Succeed())
+		}
+		ctx := log.NewContext(context.Background())
+		alice := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "alice"}), o)
+		bob := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "bob"}), o)
+
+		Expect(alice.Put("key", "alice-value")).To(Succeed())
+		Expect(bob.Put("key", "bob-value")).To(Succeed())
+		Expect(alice.Get("key")).To(Equal("alice-value"))
+		Expect(bob.Get("key")).To(Equal("bob-value"))
+
+		Expect(alice.Put("key", "updated")).To(Succeed())
+		Expect(alice.Get("key")).To(Equal("updated"))
+		Expect(bob.Get("key")).To(Equal("bob-value"))
+
+		Expect(alice.Delete("key")).To(Succeed())
+		_, err := alice.Get("key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(bob.Get("key")).To(Equal("bob-value"))
+	})
+})
