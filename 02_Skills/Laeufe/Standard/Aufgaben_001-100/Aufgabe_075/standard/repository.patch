index 0000000..76692e4
--- /dev/null
+++ b/db/migration/20210619231717_create_user_props_table.go
@@ -0,0 +1,39 @@
+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props
+(
+	user_id varchar(255) not null references user (id) on delete cascade,
+	key varchar(255) not null,
+	value text not null,
+	primary key (user_id, key)
+);
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from property p join user u on p.id = 'LastFMSessionKey_' || u.id;
+delete from property where id in (
+	select 'LastFMSessionKey_' || user_id from user_props where key = 'LastFMSessionKey'
+);
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+insert or replace into property (id, value)
+select 'LastFMSessionKey_' || user_id, value from user_props where key = 'LastFMSessionKey';
+drop table user_props;
+`)
+	return err
+}
diff --git a/db/migration/20210619231717_create_user_props_table_test.go b/db/migration/20210619231717_create_user_props_table_test.go
new file mode 100644
index 0000000..978328b
--- /dev/null
+++ b/db/migration/20210619231717_create_user_props_table_test.go
@@ -0,0 +1,45 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsMigratesLastFMSession(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`
+create table user (id text primary key);
+create table property (id text primary key, value text not null);
+insert into user (id) values ('user-1');
+insert into property (id, value) values ('LastFMSessionKey_user-1', 'secret'), ('LastScan', 'recent');
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := db.QueryRow(`select value from user_props where user_id = 'user-1' and key = 'LastFMSessionKey'`).Scan(&value); err != nil || value != "secret" {
+		t.Fatalf("migrated value = %q, error = %v", value, err)
+	}
+	if err := db.QueryRow(`select value from property where id = 'LastFMSessionKey_user-1'`).Scan(&value); err != sql.ErrNoRows {
+		t.Fatalf("old session key remains: %v", err)
+	}
+	if err := db.QueryRow(`select value from property where id = 'LastScan'`).Scan(&value); err != nil || value != "recent" {
+		t.Fatalf("unrelated property = %q, error = %v", value, err)
+	}
+}
