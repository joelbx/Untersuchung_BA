diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..36e38db
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,56 @@
+package evaluation
+
+import (
+	"errors"
+	"testing"
+
+	fliptErrors "go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/storage"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestStringListOperators(t *testing.T) {
+	cases := []struct {
+		operator, list, value string
+		want                  bool
+	}{
+		{flipt.OpIsOneOf, `["a","b"]`, "b", true},
+		{flipt.OpIsOneOf, `["a","b"]`, "c", false},
+		{flipt.OpIsNotOneOf, `["a","b"]`, "b", false},
+		{flipt.OpIsNotOneOf, `["a","b"]`, "c", true},
+		{flipt.OpIsOneOf, `[""]`, "", true},
+		{flipt.OpIsOneOf, `[1]`, "1", false},
+		{flipt.OpIsOneOf, `[null]`, "", false},
+		{flipt.OpIsOneOf, `broken`, "a", false},
+	}
+	for _, tc := range cases {
+		if got := matchesString(storage.EvaluationConstraint{Operator: tc.operator, Value: tc.list}, tc.value); got != tc.want {
+			t.Errorf("%s %s %q: got %v, want %v", tc.operator, tc.list, tc.value, got, tc.want)
+		}
+	}
+}
+
+func TestNumberListOperators(t *testing.T) {
+	cases := []struct {
+		operator, list, value string
+		want                  bool
+		invalid               bool
+	}{
+		{flipt.OpIsOneOf, `[1,2.5]`, "2.5", true, false},
+		{flipt.OpIsOneOf, `[1,2.5]`, "3", false, false},
+		{flipt.OpIsNotOneOf, `[1,2.5]`, "2.5", false, false},
+		{flipt.OpIsNotOneOf, `[1,2.5]`, "3", true, false},
+		{flipt.OpIsOneOf, `[1,"2"]`, "1", false, true},
+		{flipt.OpIsOneOf, `[null]`, "0", false, true},
+		{flipt.OpIsOneOf, `broken`, "1", false, true},
+		{flipt.OpIsOneOf, `null`, "1", false, true},
+		{flipt.OpIsNotOneOf, `broken`, "", false, true},
+	}
+	for _, tc := range cases {
+		got, err := matchesNumber(storage.EvaluationConstraint{Operator: tc.operator, Value: tc.list}, tc.value)
+		var invalid fliptErrors.ErrInvalid
+		if errors.As(err, &invalid) != tc.invalid || got != tc.want {
+			t.Errorf("%s %s %q: got (%v, %v), want (%v, invalid=%v)", tc.operator, tc.list, tc.value, got, err, tc.want, tc.invalid)
+		}
+	}
+}
diff --git a/rpc/flipt/list_operators_test.go b/rpc/flipt/list_operators_test.go
new file mode 100644
index 0000000..31039bb
--- /dev/null
+++ b/rpc/flipt/list_operators_test.go
@@ -0,0 +1,51 @@
+package flipt
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	fliptErrors "go.flipt.io/flipt/errors"
+)
+
+func TestValidateListConstraintRequests(t *testing.T) {
+	for _, typ := range []ComparisonType{ComparisonType_STRING_COMPARISON_TYPE, ComparisonType_NUMBER_COMPARISON_TYPE} {
+		typeName, item := "string", "\"x\""
+		if typ == ComparisonType_NUMBER_COMPARISON_TYPE {
+			typeName, item = "number", "1"
+		}
+		values := make([]json.RawMessage, MAX_JSON_ARRAY_ITEMS+1)
+		for i := range values {
+			values[i] = json.RawMessage(item)
+		}
+		atLimit, _ := json.Marshal(values[:MAX_JSON_ARRAY_ITEMS])
+		overLimit, _ := json.Marshal(values)
+		cases := []struct{ value, want string }{
+			{`[]`, ""},
+			{string(atLimit), ""},
+			{string(overLimit), fmt.Sprintf("too many values provided for property \"p\" of type %s (maximum 100)", typeName)},
+			{`invalid`, fmt.Sprintf("invalid value provided for property \"p\" of type %s", typeName)},
+			{`null`, fmt.Sprintf("invalid value provided for property \"p\" of type %s", typeName)},
+			{`[null]`, fmt.Sprintf("invalid value provided for property \"p\" of type %s", typeName)},
+		}
+		if typ == ComparisonType_STRING_COMPARISON_TYPE {
+			cases = append(cases, struct{ value, want string }{`[1]`, fmt.Sprintf("invalid value provided for property \"p\" of type %s", typeName)})
+		} else {
+			cases = append(cases, struct{ value, want string }{`["x"]`, fmt.Sprintf("invalid value provided for property \"p\" of type %s", typeName)})
+		}
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			for _, tc := range cases {
+				requests := []Validator{
+					&CreateConstraintRequest{SegmentKey: "s", Property: "p", Type: typ, Operator: operator, Value: tc.value},
+					&UpdateConstraintRequest{Id: "id", SegmentKey: "s", Property: "p", Type: typ, Operator: operator, Value: tc.value},
+				}
+				for _, req := range requests {
+					err := req.Validate()
+					if tc.want == "" && err != nil || tc.want != "" && err != fliptErrors.ErrInvalid(tc.want) {
+						t.Errorf("%T %s %s %q: got %v, want %q", req, typ, operator, tc.value, err, tc.want)
+					}
+				}
+			}
+		}
+	}
+}
