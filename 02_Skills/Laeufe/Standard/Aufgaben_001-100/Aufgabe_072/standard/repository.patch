 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
+import punycode from 'punycode.js';
+
+export const getHostnameWithRegex = (url: string): string => {
+    const match = /^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^/?#@]*@)?(?:www\.)?([^./:?#]+)(?:\.[^/?#:]*)?/i.exec(url);
+    return match?.[1] || '';
+};
+
+export const punycodeUrl = (url: string): string => {
+    const parsed = new URL(url);
+    parsed.hostname = punycode.toASCII(parsed.hostname);
+
+    // URL adds a slash to bare origins. Keep the original path convention while
+    // retaining the parsed URL's protocol, authority, search and fragment.
+    const suffix = `${parsed.search}${parsed.hash}`;
+    const withoutSuffix = parsed.href.slice(0, parsed.href.length - suffix.length);
+    return `${withoutSuffix.replace(/\/$/, '')}${suffix}`;
+};
 
