index 0000000..ec2f9b6
--- /dev/null
+++ b/internal/ext/common.go
@@ -0,0 +1,48 @@
+package ext
+
+// Document is the portable representation of flags and segments.
+type Document struct {
+	Flags    []*Flag    `yaml:"flags,omitempty"`
+	Segments []*Segment `yaml:"segments,omitempty"`
+}
+
+type Flag struct {
+	Key         string     `yaml:"key,omitempty"`
+	Name        string     `yaml:"name,omitempty"`
+	Description string     `yaml:"description,omitempty"`
+	Enabled     bool       `yaml:"enabled"`
+	Variants    []*Variant `yaml:"variants,omitempty"`
+	Rules       []*Rule    `yaml:"rules,omitempty"`
+}
+
+type Variant struct {
+	Key         string      `yaml:"key,omitempty"`
+	Name        string      `yaml:"name,omitempty"`
+	Description string      `yaml:"description,omitempty"`
+	Attachment  interface{} `yaml:"attachment,omitempty"`
+}
+
+type Rule struct {
+	SegmentKey    string          `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type Distribution struct {
+	VariantKey string  `yaml:"variant,omitempty"`
+	Rollout    float32 `yaml:"rollout,omitempty"`
+}
+
+type Segment struct {
+	Key         string        `yaml:"key,omitempty"`
+	Name        string        `yaml:"name,omitempty"`
+	Description string        `yaml:"description,omitempty"`
+	Constraints []*Constraint `yaml:"constraints,omitempty"`
+}
+
+type Constraint struct {
+	Type     string `yaml:"type,omitempty"`
+	Property string `yaml:"property,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+	Value    string `yaml:"value,omitempty"`
+}
diff --git a/internal/ext/exporter.go b/internal/ext/exporter.go
new file mode 100644
index 0000000..287098d
--- /dev/null
+++ b/internal/ext/exporter.go
@@ -0,0 +1,94 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type lister interface {
+	ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error)
+	ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error)
+	ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error)
+}
+
+// Exporter writes a portable YAML document from the store.
+type Exporter struct {
+	store     lister
+	batchSize uint64
+}
+
+func NewExporter(store lister) *Exporter {
+	return &Exporter{store: store, batchSize: 25}
+}
+
+func (e *Exporter) Export(ctx context.Context, w io.Writer) error {
+	doc := new(Document)
+	batchSize := e.batchSize
+	if batchSize == 0 {
+		batchSize = 25
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		flags, err := e.store.ListFlags(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting flags: %w", err)
+		}
+		for _, f := range flags {
+			flag := &Flag{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}
+			variantKeys := make(map[string]string, len(f.Variants))
+			for _, v := range f.Variants {
+				variant := &Variant{Key: v.Key, Name: v.Name, Description: v.Description}
+				if v.Attachment != "" {
+					if err := json.Unmarshal([]byte(v.Attachment), &variant.Attachment); err != nil {
+						return fmt.Errorf("parsing attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+				}
+				flag.Variants = append(flag.Variants, variant)
+				variantKeys[v.Id] = v.Key
+			}
+			rules, err := e.store.ListRules(ctx, f.Key)
+			if err != nil {
+				return fmt.Errorf("getting rules for flag %q: %w", f.Key, err)
+			}
+			for _, r := range rules {
+				rule := &Rule{SegmentKey: r.SegmentKey, Rank: uint(r.Rank)}
+				for _, d := range r.Distributions {
+					rule.Distributions = append(rule.Distributions, &Distribution{VariantKey: variantKeys[d.VariantId], Rollout: d.Rollout})
+				}
+				flag.Rules = append(flag.Rules, rule)
+			}
+			doc.Flags = append(doc.Flags, flag)
+		}
+		if uint64(len(flags)) < batchSize {
+			break
+		}
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		segments, err := e.store.ListSegments(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting segments: %w", err)
+		}
+		for _, s := range segments {
+			segment := &Segment{Key: s.Key, Name: s.Name, Description: s.Description}
+			for _, c := range s.Constraints {
+				segment.Constraints = append(segment.Constraints, &Constraint{Type: c.Type.String(), Property: c.Property, Operator: c.Operator, Value: c.Value})
+			}
+			doc.Segments = append(doc.Segments, segment)
+		}
+		if uint64(len(segments)) < batchSize {
+			break
+		}
+	}
+
+	if err := yaml.NewEncoder(w).Encode(doc); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	return nil
+}
diff --git a/internal/ext/ext_test.go b/internal/ext/ext_test.go
new file mode 100644
index 0000000..1f2bc19
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,167 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type memoryStore struct {
+	flags    []*flipt.Flag
+	segments []*flipt.Segment
+	rules    map[string][]*flipt.Rule
+}
+
+func (m *memoryStore) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	p := pageParams(opts)
+	if p.Offset >= uint64(len(m.flags)) {
+		return nil, nil
+	}
+	items := m.flags[p.Offset:]
+	if p.Limit != 0 && p.Limit < uint64(len(items)) {
+		items = items[:p.Limit]
+	}
+	return items, nil
+}
+func (m *memoryStore) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	p := pageParams(opts)
+	if p.Offset >= uint64(len(m.segments)) {
+		return nil, nil
+	}
+	items := m.segments[p.Offset:]
+	if p.Limit != 0 && p.Limit < uint64(len(items)) {
+		items = items[:p.Limit]
+	}
+	return items, nil
+}
+func (m *memoryStore) ListRules(_ context.Context, key string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return m.rules[key], nil
+}
+
+func pageParams(opts []storage.QueryOption) *storage.QueryParams {
+	params := new(storage.QueryParams)
+	for _, opt := range opts {
+		opt(params)
+	}
+	return params
+}
+func (m *memoryStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	f := &flipt.Flag{Key: r.Key, Name: r.Name, Description: r.Description, Enabled: r.Enabled}
+	m.flags = append(m.flags, f)
+	return f, nil
+}
+func (m *memoryStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	v := &flipt.Variant{Id: r.Key + "-id", Key: r.Key, Name: r.Name, Description: r.Description, Attachment: r.Attachment}
+	for _, f := range m.flags {
+		if f.Key == r.FlagKey {
+			f.Variants = append(f.Variants, v)
+		}
+	}
+	return v, nil
+}
+func (m *memoryStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s := &flipt.Segment{Key: r.Key, Name: r.Name, Description: r.Description}
+	m.segments = append(m.segments, s)
+	return s, nil
+}
+func (m *memoryStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	c := &flipt.Constraint{Type: r.Type, Property: r.Property, Operator: r.Operator, Value: r.Value}
+	for _, s := range m.segments {
+		if s.Key == r.SegmentKey {
+			s.Constraints = append(s.Constraints, c)
+		}
+	}
+	return c, nil
+}
+func (m *memoryStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	rule := &flipt.Rule{Id: r.FlagKey + "-rule", SegmentKey: r.SegmentKey, Rank: r.Rank}
+	if m.rules == nil {
+		m.rules = make(map[string][]*flipt.Rule)
+	}
+	m.rules[r.FlagKey] = append(m.rules[r.FlagKey], rule)
+	return rule, nil
+}
+func (m *memoryStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	d := &flipt.Distribution{VariantId: r.VariantId, Rollout: r.Rollout}
+	for _, rule := range m.rules[r.FlagKey] {
+		if rule.Id == r.RuleId {
+			rule.Distributions = append(rule.Distributions, d)
+		}
+	}
+	return d, nil
+}
+
+func TestImportExportAttachments(t *testing.T) {
+	input := `flags:
+- key: checkout
+  name: Checkout
+  enabled: true
+  variants:
+  - key: full
+    attachment:
+      nested:
+        list: [1, true, null, {deep: [text, 2.5]}]
+      empty: []
+  - key: plain
+  rules:
+  - segment: members
+    rank: 1
+    distributions:
+    - variant: full
+      rollout: 75
+segments:
+- key: members
+  constraints:
+  - type: STRING_COMPARISON_TYPE
+    property: plan
+    operator: eq
+    value: gold
+`
+	store := new(memoryStore)
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if len(store.flags) != 1 || len(store.flags[0].Variants) != 2 || len(store.segments) != 1 || len(store.rules["checkout"]) != 1 || len(store.rules["checkout"][0].Distributions) != 1 {
+		t.Fatalf("incomplete import: %#v", store)
+	}
+	if got := store.flags[0].Variants[1].Attachment; got != "" {
+		t.Fatalf("missing attachment: %q", got)
+	}
+	var attachment interface{}
+	if err := json.Unmarshal([]byte(store.flags[0].Variants[0].Attachment), &attachment); err != nil {
+		t.Fatal(err)
+	}
+	var out bytes.Buffer
+	if err := NewExporter(store).Export(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	var exported interface{}
+	encoded, err := json.Marshal(convert(doc.Flags[0].Variants[0].Attachment))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(encoded, &exported); err != nil {
+		t.Fatal(err)
+	}
+	if !equalJSON(attachment, exported) {
+		t.Fatalf("attachment changed: %s", out.String())
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil {
+		t.Fatalf("missing attachment exported: %#v", doc.Flags[0].Variants[1].Attachment)
+	}
+}
+func equalJSON(a, b interface{}) bool {
+	aBytes, _ := json.Marshal(a)
+	bBytes, _ := json.Marshal(b)
+	return bytes.Equal(aBytes, bBytes)
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..83ed052
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,110 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+// Importer creates store objects from a portable YAML document.
+type Importer struct{ store creator }
+
+func NewImporter(store creator) *Importer { return &Importer{store: store} }
+
+// convert recursively turns YAML's interface-keyed maps into JSON-compatible maps.
+func convert(v interface{}) interface{} {
+	switch value := v.(type) {
+	case map[interface{}]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			result[fmt.Sprint(key)] = convert(item)
+		}
+		return result
+	case map[string]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			result[key] = convert(item)
+		}
+		return result
+	case []interface{}:
+		result := make([]interface{}, len(value))
+		for i, item := range value {
+			result[i] = convert(item)
+		}
+		return result
+	default:
+		return v
+	}
+}
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	doc := new(Document)
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+
+	variants := make(map[string]*flipt.Variant)
+	for _, f := range doc.Flags {
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+		for _, v := range f.Variants {
+			attachment := ""
+			if v.Attachment != nil {
+				encoded, err := json.Marshal(convert(v.Attachment))
+				if err != nil {
+					return fmt.Errorf("encoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+				}
+				attachment = string(encoded)
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{FlagKey: f.Key, Key: v.Key, Name: v.Name, Description: v.Description, Attachment: attachment})
+			if err != nil {
+				return fmt.Errorf("importing variant %q for flag %q: %w", v.Key, f.Key, err)
+			}
+			variants[f.Key+":"+v.Key] = variant
+		}
+	}
+
+	for _, s := range doc.Segments {
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: s.Key, Name: s.Name, Description: s.Description}); err != nil {
+			return fmt.Errorf("importing segment %q: %w", s.Key, err)
+		}
+		for _, c := range s.Constraints {
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{SegmentKey: s.Key, Type: flipt.ComparisonType(flipt.ComparisonType_value[c.Type]), Property: c.Property, Operator: c.Operator, Value: c.Value}); err != nil {
+				return fmt.Errorf("importing constraint for segment %q: %w", s.Key, err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{FlagKey: f.Key, SegmentKey: r.SegmentKey, Rank: int32(r.Rank)})
+			if err != nil {
+				return fmt.Errorf("importing rule for flag %q: %w", f.Key, err)
+			}
+			for _, d := range r.Distributions {
+				variant := variants[f.Key+":"+d.VariantKey]
+				if variant == nil {
+					return fmt.Errorf("finding variant %q for flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{FlagKey: f.Key, RuleId: rule.Id, VariantId: variant.Id, Rollout: d.Rollout}); err != nil {
+					return fmt.Errorf("importing distribution for flag %q: %w", f.Key, err)
+				}
+			}
+		}
+	}
+	return nil
+}
