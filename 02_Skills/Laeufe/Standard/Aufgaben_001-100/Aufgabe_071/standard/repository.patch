+@pytest.mark.parametrize('source, expected', [
+    ('_x000D__x000A_', '\r\n'),
+    ('_x263A_', '\u263a'),
+    ('_xD83D__xDE00_', '\U0001f600'),
+    ('_x005f_', '_'),
+    ('_x005F__x000A_', '_\n'),
+    ('_x005F_', '_x005F_'),
+    ('_x005G_ _x123_ _xD83D_', '_x005G_ _x123_ \ud83d'),
+])
+def test_parse_clixml_escapes(source, expected):
+    data = ('<Objs><S S="Error">' + source + '</S></Objs>').encode()
+    assert _parse_clixml(data) == expected.encode('utf-8', errors='surrogatepass')
+
+
+def test_parse_clixml_stream_empty_elements_and_blocks():
+    data = (b'<Objs><S S="Info">ignored</S><S S="Error" />'
+            b'<S S="Error">a_x000D_</S><S S="Error">b</S></Objs>'
+            b'<Objs><S S="Info">ignored</S></Objs>'
+            b'<Objs><S S="Error" /><S S="Error">c</S></Objs>')
+    assert _parse_clixml(data) == b'a\rb\r\nc'
+    assert _parse_clixml(b'<Objs><S S="Error" /></Objs>') == b''
+    assert _parse_clixml(data, stream='Missing') == b''
+
