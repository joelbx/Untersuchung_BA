+    def decode_escapes(value: str) -> str:
+        tokens = list(re.finditer(r'_x[0-9a-fA-F]{4}_', value))
+        result = []
+        position = 0
+        index = 0
+        while index < len(tokens):
+            token = tokens[index]
+            result.append(value[position:token.start()])
+            next_token = tokens[index + 1] if index + 1 < len(tokens) else None
+            adjacent = next_token is not None and next_token.start() == token.end()
+            code_unit = int(token.group()[2:6], 16)
+
+            # An escaped underscore is special only before another escape.
+            if token.group() == '_x005F_':
+                result.append('_' if adjacent else token.group())
+            elif adjacent and 0xD800 <= code_unit <= 0xDBFF and 0xDC00 <= int(next_token.group()[2:6], 16) <= 0xDFFF:
+                low = int(next_token.group()[2:6], 16)
+                result.append(chr(0x10000 + (code_unit - 0xD800) * 0x400 + low - 0xDC00))
+                position = next_token.end()
+                index += 2
+                continue
+            else:
+                result.append(chr(code_unit))
+
+            position = token.end()
+            index += 1
+
+        result.append(value[position:])
+        return ''.join(result)
 
