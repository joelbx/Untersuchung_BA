@@ -0,0 +1,48 @@
+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes, children and ref to the accessible host', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole } = render(
+            <Dialog ref={ref} open aria-label="Example" data-testid="dialog">
+                <button type="button">Action</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(ref.current).toBe(host);
+        expect(host).toHaveAttribute('data-testid', 'dialog');
+        expect(host).toHaveAttribute('open');
+        expect(getByRole('button', { name: 'Action' })).toBeVisible();
+    });
+
+    it('uses the native element and exposes its API when available', () => {
+        const original = Object.getOwnPropertyDescriptor(HTMLDialogElement.prototype, 'showModal');
+        const showModal = jest.fn();
+        Object.defineProperty(HTMLDialogElement.prototype, 'showModal', { configurable: true, value: showModal });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByRole } = render(
+                <Dialog ref={ref} open aria-label="Native">
+                    <button type="button">Action</button>
+                </Dialog>
+            );
+
+            expect(ref.current?.tagName).toBe('DIALOG');
+            ref.current?.showModal();
+            expect(showModal).toHaveBeenCalledTimes(1);
+            expect(getByRole('button', { name: 'Action' })).toBeVisible();
+        } finally {
+            if (original) {
+                Object.defineProperty(HTMLDialogElement.prototype, 'showModal', original);
+            } else {
+                delete (HTMLDialogElement.prototype as Partial<HTMLDialogElement>).showModal;
+            }
+        }
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
new file mode 100644
index 0000000..74d2087
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,24 @@
+import { DialogHTMLAttributes, HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends DialogHTMLAttributes<HTMLDialogElement> {}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ children, ...rest }, ref: Ref<HTMLDialogElement>) => {
+    // Environments such as JSDOM expose <dialog> without its modal API.
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        return (
+            <div role="dialog" {...(rest as HTMLAttributes<HTMLDivElement>)} ref={ref as Ref<HTMLDivElement>}>
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
