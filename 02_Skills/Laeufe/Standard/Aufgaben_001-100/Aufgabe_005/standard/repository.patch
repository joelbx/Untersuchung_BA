+def test_selection_info_str():
+    info = machinery.SelectionInfo(wrapper="PyQt5",
+                                   reason=machinery.SelectionReason.default)
+    assert str(info) == "Qt wrapper: PyQt5 (via default)"
+    info.pyqt5 = "ImportError: missing PyQt5"
+    info.pyqt6 = "ImportError: missing PyQt6"
+    assert str(info) == ("Qt wrapper info:\n"
+                         "PyQt5: ImportError: missing PyQt5\n"
+                         "PyQt6: ImportError: missing PyQt6\n"
+                         "selected: PyQt5 (via default)")
+
+
+def test_no_wrapper_error():
+    info = machinery.SelectionInfo(pyqt5="ImportError: missing PyQt5",
+                                   pyqt6="ImportError: missing PyQt6")
+    error = machinery.NoWrapperAvailableError(info)
+    assert isinstance(error, ImportError)
+    assert error.info is info
+    assert str(error) == f"No Qt wrapper was importable.\n\n\n{info}"
