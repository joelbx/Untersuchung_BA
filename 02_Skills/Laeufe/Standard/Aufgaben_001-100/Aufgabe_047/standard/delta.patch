-type hasher struct {
-	seeds map[string]maphash.Seed
+// Hasher keeps a seed for each id and uses one maphash seed for all hashes.
+type Hasher struct {
+	mu    sync.Mutex
+	seeds map[string]string
+	seed  maphash.Seed
+}
+
+func NewHasher() *Hasher {
+	return &Hasher{
+		seeds: make(map[string]string),
+		seed:  globalSeed,
+	}
 }
 
-func NewHasher() *hasher {
-	h := new(hasher)
-	h.seeds = make(map[string]maphash.Seed)
-	return h
+// SetSeed assigns a reproducible seed to the given id.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.seeds[id] = seed
 }
 
-// Reseed generates a new seed for the given id
-func (h *hasher) Reseed(id string) {
-	h.seeds[id] = maphash.MakeSeed()
+// Reseed generates a new seed for the given id.
+func (h *Hasher) Reseed(id string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	seed := newSeed(id)
+	for seed == h.seeds[id] {
+		seed = newSeed(id)
+	}
+	h.seeds[id] = seed
 }
 
-// HashFunc returns a function that hashes a string using the seed for the given id
-func (h *hasher) HashFunc() func(id, str string) uint64 {
+func newSeed(id string) string {
+	return strconv.FormatUint(maphash.String(maphash.MakeSeed(), id), 16)
+}
+
+// HashFunc returns a function that hashes a string using the seed for the given id.
+func (h *Hasher) HashFunc() func(id, str string) uint64 {
 	return func(id, str string) uint64 {
-		var hash maphash.Hash
-		var seed maphash.Seed
-		var ok bool
-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
+		h.mu.Lock()
+		seed, ok := h.seeds[id]
+		if !ok {
+			seed = newSeed(id)
 			h.seeds[id] = seed
 		}
-		hash.SetSeed(seed)
+		h.mu.Unlock()
+
+		var hash maphash.Hash
+		hash.SetSeed(h.seed)
+		var length [binary.MaxVarintLen64]byte
+		n := binary.PutUvarint(length[:], uint64(len(seed)))
+		_, _ = hash.Write(length[:n])
+		_, _ = hash.WriteString(seed)
 		_, _ = hash.WriteString(str)
 		return hash.Sum64()
 	}
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..d2394da 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,43 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores a hash when a previous seed is set again", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("id", "original")
+		original := hashFunc("id", input)
+		Expect(hashFunc("id", input)).To(Equal(original))
+
+		h.Reseed("id")
+		Expect(hashFunc("id", input)).NotTo(Equal(original))
+
+		h.SetSeed("id", "original")
+		Expect(hashFunc("id", input)).To(Equal(original))
+	})
+
+	It("uses the same hash for the same id and seed across hashers", func() {
+		first := hasher.NewHasher()
+		second := hasher.NewHasher()
+		first.SetSeed("id", "shared")
+		second.SetSeed("id", "shared")
+		Expect(first.HashFunc()("id", input)).To(Equal(second.HashFunc()("id", input)))
+	})
+
+	It("applies a seed set through the package function", func() {
+		hashFunc := hasher.HashFunc()
+		hasher.SetSeed("global-test", "saved")
+		original := hashFunc("global-test", input)
+		hasher.SetSeed("global-test", "changed")
+		Expect(hashFunc("global-test", input)).NotTo(Equal(original))
+		hasher.SetSeed("global-test", "saved")
+		Expect(hashFunc("global-test", input)).To(Equal(original))
+	})
+
+	It("initializes a seed on the first hash", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		first := hashFunc("new-id", input)
+		Expect(hashFunc("new-id", input)).To(Equal(first))
+	})
 })
