+def test_get_ia_record_normalizes_mixed_metadata() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'creator': 'First Author;Second Author',
+            'isbn': [' 1451654685 ', '978 1451654684', 'bad'],
+            'publisher': ['Penguin', ' London : Faber ', '  '],
+            'language': 'eng',
+        }
+    )
+    assert result['authors'] == [{'name': 'First Author'}, {'name': 'Second Author'}]
+    assert result['isbn_10'] == ['1451654685']
+    assert result['isbn_13'] == ['9781451654684']
+    assert result['publishers'] == ['Penguin', 'Faber']
+    assert result['publish_places'] == ['London']
+    assert result['languages'] == ['eng']
+    assert 'isbn' not in result
+    assert 'publisher' not in result
+
+
+@pytest.mark.parametrize('isbn, publisher', [(None, None), ([], []), (' ', ' ')])
+def test_get_ia_record_omits_empty_identifiers(isbn, publisher) -> None:
+    result = code.ia_importapi.get_ia_record({'isbn': isbn, 'publisher': publisher})
+    assert not {'isbn', 'isbn_10', 'isbn_13', 'publisher', 'publishers', 'publish_places'} & result.keys()
