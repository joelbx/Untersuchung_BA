+}
+
+func TestNotifyExitRestoresStdin(t *testing.T) {
+	stdinMU.Lock()
+	old := stdin
+	stdinMU.Unlock()
+	defer SetStdin(old)
+
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	cr := NewContextReader(pr)
+	term := &fakeTerm{reader: pr, reading: make(chan struct{})}
+	cr.term, cr.fd = term, 0
+	SetStdin(cr)
+	go func() { _, _ = cr.ReadPassword(context.Background()) }()
+	<-term.reading
+	NotifyExit()
+	require.True(t, term.restoreCalled)
+	_, err := cr.ReadContext(context.Background())
+	require.ErrorIs(t, err, ErrReaderClosed)
+}
+
+func TestMaybeRestoreTerm(t *testing.T) {
+	restoreErr := errors.New("restore failed")
+	fake := &fakeTerm{restoreErr: restoreErr}
+	cr := &ContextReader{term: fake, fd: 0, state: readerStateClean, previousTermState: &term.State{}}
+	require.NoError(t, cr.maybeRestoreTerm())
+	require.False(t, fake.restoreCalled)
+	cr.state = readerStatePassword
+	cr.previousTermState = nil
+	require.NoError(t, cr.maybeRestoreTerm())
+	require.False(t, fake.restoreCalled)
+	cr.previousTermState = &term.State{}
+	require.ErrorIs(t, cr.maybeRestoreTerm(), restoreErr)
+	require.NotNil(t, cr.previousTermState)
+	fake.restoreErr = nil
+	require.NoError(t, cr.maybeRestoreTerm())
+	require.Nil(t, cr.previousTermState)
+}
