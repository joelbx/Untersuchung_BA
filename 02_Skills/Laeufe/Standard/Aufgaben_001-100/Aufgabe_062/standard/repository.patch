+// NotifyExit closes the global stdin reader so an unfinished password read can
+// restore the terminal before the program exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	rd := stdin
+	stdinMU.Unlock()
+	if closer, ok := rd.(io.Closer); ok {
+		if err := closer.Close(); err != nil {
+			log.Warnf("prompt: failed to close stdin reader: %v", err)
+		}
+	}
+}
