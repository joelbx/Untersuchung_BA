+func TestPasswordReadAbandoned(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ctx  func() (context.Context, context.CancelFunc)
+		want error
+	}{
+		{"cancel", func() (context.Context, context.CancelFunc) { return context.WithCancel(context.Background()) }, context.Canceled},
+		{"deadline", func() (context.Context, context.CancelFunc) {
+			return context.WithTimeout(context.Background(), 500*time.Millisecond)
+		}, context.DeadlineExceeded},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pr, pw := io.Pipe()
+			defer pr.Close()
+			defer pw.Close()
+			cr := NewContextReader(pr)
+			defer cr.Close()
+			term := &fakeTerm{reader: pr, reading: make(chan struct{})}
+			cr.term, cr.fd = term, 0
+
+			ctx, cancel := tc.ctx()
+			defer cancel()
+			result := make(chan readOutcome, 1)
+			go func() {
+				value, err := cr.ReadPassword(ctx)
+				result <- readOutcome{value, err}
+			}()
+			select {
+			case <-term.reading:
+			case got := <-result:
+				t.Fatalf("password read finished before reaching terminal: %v", got.err)
+			}
+			if tc.want == context.Canceled {
+				cancel()
+			}
+			got := <-result
+			require.ErrorIs(t, got.err, tc.want)
+			require.Empty(t, got.value)
+			require.True(t, term.restoreCalled)
+			cr.mu.Lock()
+			require.Equal(t, readerStateClean, cr.state)
+			cr.mu.Unlock()
+
+			go func() { _, _ = pw.Write([]byte("next")) }()
+			value, err := cr.ReadContext(context.Background())
+			require.NoError(t, err)
+			require.Equal(t, "next", string(value))
+		})
+	}
+}
