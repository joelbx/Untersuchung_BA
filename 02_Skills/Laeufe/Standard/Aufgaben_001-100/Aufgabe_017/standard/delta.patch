@@ -0,0 +1,61 @@
+package database
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/gravitational/teleport/lib/srv/db/common"
+	"github.com/gravitational/teleport/lib/srv/db/sqlserver"
+)
+
+func TestSQLServerErrors(t *testing.T) {
+	p := SQLServerPinger{}
+	for _, tt := range []struct {
+		name                    string
+		err                     error
+		refused, user, database bool
+	}{
+		{name: "nil"},
+		{name: "refused", err: fmt.Errorf("dial: %w", syscall.ECONNREFUSED), refused: true},
+		{name: "invalid user", err: fmt.Errorf("login: %w", mssql.Error{Number: 18456}), user: true},
+		{name: "invalid database", err: fmt.Errorf("login: %w", mssql.Error{Number: 4060}), database: true},
+		{name: "other SQL error", err: mssql.Error{Number: 208}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.refused, p.IsConnectionRefusedError(tt.err))
+			require.Equal(t, tt.user, p.IsInvalidDatabaseUserError(tt.err))
+			require.Equal(t, tt.database, p.IsInvalidDatabaseNameError(tt.err))
+		})
+	}
+}
+
+func TestSQLServerPing(t *testing.T) {
+	server, err := sqlserver.NewTestServer(common.TestServerConfig{})
+	require.NoError(t, err)
+	go server.Serve()
+	t.Cleanup(func() { server.Close() })
+	port, err := strconv.Atoi(server.Port())
+	require.NoError(t, err)
+
+	p := SQLServerPinger{}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	params := PingParams{Host: "localhost", Port: port, Username: "someuser", DatabaseName: "somedb"}
+	require.NoError(t, p.Ping(ctx, params))
+
+	require.Error(t, p.Ping(ctx, PingParams{Port: port, DatabaseName: "somedb"}))
+	require.Error(t, p.Ping(ctx, PingParams{Host: "localhost", Port: -1, Username: "someuser", DatabaseName: "somedb"}))
+	expired, cancelExpired := context.WithCancel(context.Background())
+	cancelExpired()
+	require.Error(t, p.Ping(expired, params))
+
+	require.True(t, p.IsConnectionRefusedError(errors.New("connection refused")))
+}
