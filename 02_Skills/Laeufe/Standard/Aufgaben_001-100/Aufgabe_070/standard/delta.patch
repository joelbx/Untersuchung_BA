@@ -6,6 +6,8 @@ from unicodedata import normalize
 
 import web
 
+from openlibrary.plugins.upstream.utils import get_marc21_language, strip_accents
+
 if TYPE_CHECKING:
     from openlibrary.plugins.upstream.models import Author
 
@@ -450,15 +452,52 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     Format language data to match Open Library's expected format.
     For an input of ["eng", "fre"], return:
     [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+    ISO 639-1 codes and English or native names resolve to MARC codes.
+    Repeated languages appear once, in input order.
     """
     if not languages:
         return []
 
     formatted_languages = []
+    seen = set()
+    language_records = None
+
+    def normalized(value: str) -> str:
+        return strip_accents(value.strip().casefold())
+
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
+        token = normalized(language)
+        code = token if len(token) == 3 and web.ctx.site.get(f'/languages/{token}') else None
+
+        if code is None:
+            code = get_marc21_language(token)
+
+        if code is None or web.ctx.site.get(f'/languages/{code}') is None:
+            if language_records is None:
+                keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+                language_records = web.ctx.site.get_many(keys)
+
+            matches = set()
+            for record in language_records:
+                if record.get('deprecated'):
+                    continue
+                iso_codes = record.get('identifiers', {}).get('iso_639_1', [])
+                names = [record['name']]
+                translated = record.get('name_translated', {})
+                for locale in ('en', *iso_codes):
+                    names.extend(translated.get(locale, []))
+                if token in (normalized(value) for value in (*iso_codes, *names)):
+                    matches.add(record['code'])
+
+            if len(matches) != 1:
+                raise InvalidLanguage(language.lower())
+            code = matches.pop()
+
+        key = f'/languages/{code}'
+        if web.ctx.site.get(key) is None:
             raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        if key not in seen:
+            seen.add(key)
+            formatted_languages.append({'key': key})
 
     return formatted_languages
