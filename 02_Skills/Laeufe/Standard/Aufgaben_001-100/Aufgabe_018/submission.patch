+func TestStringToSliceHook(t *testing.T) {
+	tests := []struct {
+		name string
+		from interface{}
+		to   interface{}
+		want interface{}
+	}{
+		{"whitespace", " \tfoo.com bar.com\n\nbaz.com \r\n", []string{}, []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "", []string{}, []string{}},
+		{"only whitespace", " \t\n ", []string{}, []string{}},
+		{"sequence", []string{"foo.com", "bar.com"}, []string{}, []string{"foo.com", "bar.com"}},
+		{"non-string source", 42, []string{}, 42},
+		{"other slice type", "foo bar", []int{}, "foo bar"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := mapstructure.DecodeHookExec(stringToSliceHookFunc(), reflect.ValueOf(tt.from), reflect.ValueOf(tt.to))
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadCORSOriginsWhitespace(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		value string
+		want  []string
+	}{
+		{"mixed whitespace", " \tfoo.com bar.com\n\nbaz.com \r\n", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "", []string{}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(fmt.Sprintf("cors:\n  allowed_origins: %q\n", tt.value)), 0600))
+
+			yamlConfig, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, yamlConfig.Cors.AllowedOrigins)
+
+			t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", tt.value)
+			envConfig, err := Load("./testdata/default.yml")
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, envConfig.Cors.AllowedOrigins)
+		})
+	}
+}
