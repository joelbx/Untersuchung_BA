diff --git a/detector/pkg_detection_test.go b/detector/pkg_detection_test.go
new file mode 100644
index 0000000..f86c30b
--- /dev/null
+++ b/detector/pkg_detection_test.go
@@ -0,0 +1,67 @@
+//go:build !scanner
+// +build !scanner
+
+package detector
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/logging"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestIsPkgCvesDetactable(t *testing.T) {
+	base := models.ScanResult{Family: "debian", Release: "12", Packages: models.Packages{"apt": {Name: "apt"}}}
+	cases := []struct {
+		name   string
+		change func(*models.ScanResult)
+		want   bool
+	}{
+		{"supported", func(*models.ScanResult) {}, true},
+		{"missing family", func(r *models.ScanResult) { r.Family = "" }, false},
+		{"missing release", func(r *models.ScanResult) { r.Release = "" }, false},
+		{"no packages", func(r *models.ScanResult) { r.Packages = nil }, false},
+		{"source packages", func(r *models.ScanResult) { r.Packages = nil; r.SrcPackages = models.SrcPackages{"apt": {Name: "apt"}} }, true},
+		{"trivy", func(r *models.ScanResult) { r.ScannedBy = "trivy" }, false},
+		{"freebsd", func(r *models.ScanResult) { r.Family = constant.FreeBSD }, false},
+		{"raspbian", func(r *models.ScanResult) { r.Family = constant.Raspbian }, false},
+		{"pseudo", func(r *models.ScanResult) { r.Family = constant.ServerTypePseudo }, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r := base
+			tc.change(&r)
+			if got := isPkgCvesDetactable(&r); got != tc.want {
+				t.Errorf("isPkgCvesDetactable() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestReuseTrivyScannedCves(t *testing.T) {
+	r := models.ScanResult{ScannedBy: "trivy"}
+	if !reuseScannedCves(&r) {
+		t.Fatal("Trivy CVEs should be reused")
+	}
+	r.ScannedBy = ""
+	r.Optional = map[string]interface{}{"trivy-target": "old marker"}
+	if reuseScannedCves(&r) {
+		t.Fatal("Optional marker alone should not identify Trivy results")
+	}
+}
+
+func TestDetectPkgCvesSkipsTrivyWithRelease(t *testing.T) {
+	r := models.ScanResult{
+		Family: "debian", Release: "12", ScannedBy: "trivy",
+		Packages:    models.Packages{"apt": {Name: "apt"}},
+		ScannedCves: models.VulnInfos{"CVE-1": {CveID: "CVE-1"}},
+	}
+	if err := DetectPkgCves(&r, config.GovalDictConf{}, config.GostConf{}, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := r.ScannedCves["CVE-1"]; !ok {
+		t.Fatal("Trivy CVEs were not preserved")
+	}
+}
