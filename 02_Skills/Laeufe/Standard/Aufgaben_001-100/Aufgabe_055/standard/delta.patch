@@ -0,0 +1,46 @@
+package v2
+
+import (
+	"testing"
+)
+
+func TestParseMetadata(t *testing.T) {
+	cases := []struct {
+		name, report, serverName, family, release string
+	}{
+		{
+			name:       "OS version and untagged image",
+			report:     `{"ArtifactName":"redis","ArtifactType":"container_image","Metadata":{"OS":{"Family":"debian","Name":"12"}},"Results":[{"Type":"debian"}]}`,
+			serverName: "redis:latest", family: "debian", release: "12",
+		},
+		{
+			name:       "missing OS name",
+			report:     `{"ArtifactName":"ubuntu:22.04","ArtifactType":"container_image","Metadata":{"OS":{"Family":"ubuntu"}},"Results":[{"Type":"ubuntu"}]}`,
+			serverName: "ubuntu:22.04", family: "ubuntu",
+		},
+		{
+			name:       "library only without OS",
+			report:     `{"ArtifactName":"/src/app","ArtifactType":"filesystem","Results":[{"Type":"jar"}]}`,
+			serverName: "/src/app", family: "pseudo",
+		},
+		{
+			name:       "library only image",
+			report:     `{"ArtifactName":"app","ArtifactType":"container_image","Results":[{"Type":"jar"}]}`,
+			serverName: "app:latest", family: "pseudo",
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r, err := (ParserV2{}).Parse([]byte(tc.report))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if r.ServerName != tc.serverName || r.Family != tc.family || r.Release != tc.release {
+				t.Errorf("metadata: got (%q, %q, %q), want (%q, %q, %q)", r.ServerName, r.Family, r.Release, tc.serverName, tc.family, tc.release)
+			}
+			if r.Optional != nil || r.ScannedBy != "trivy" {
+				t.Errorf("Trivy metadata: Optional=%v, ScannedBy=%q", r.Optional, r.ScannedBy)
+			}
+		})
+	}
+}
