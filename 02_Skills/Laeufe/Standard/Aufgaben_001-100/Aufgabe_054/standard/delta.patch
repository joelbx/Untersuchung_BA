+package singleton_test
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/singleton"
+)
+
+func TestGetInstanceReusesValueAndPointerSeparately(t *testing.T) {
+	type item struct{ id int }
+	valueCalls := 0
+	value := singleton.GetInstance(func() item {
+		valueCalls++
+		return item{id: 7}
+	})
+	again := singleton.GetInstance(func() item {
+		valueCalls++
+		return item{id: 8}
+	})
+	if value != again || value.id != 7 || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v again=%v constructor calls=%d", value, again, valueCalls)
+	}
+
+	pointerCalls := 0
+	pointer := singleton.GetInstance(func() *item {
+		pointerCalls++
+		return &item{id: 9}
+	})
+	pointerAgain := singleton.GetInstance(func() *item {
+		pointerCalls++
+		return &item{id: 10}
+	})
+	if pointer != pointerAgain || pointer.id != 9 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p again=%p constructor calls=%d", pointer, pointerAgain, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type item struct{ id int }
+	const callers = 20_000
+	var creations int32
+	results := make([]*item, callers)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(callers)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *item {
+				return &item{id: int(atomic.AddInt32(&creations, 1))}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+	if count := atomic.LoadInt32(&creations); count != 1 {
+		t.Fatalf("constructor called %d times, want 1", count)
+	}
+	for i, result := range results {
+		if result != results[0] || result.id != 1 {
+			t.Fatalf("call %d returned %p (%+v), want %p", i, result, result, results[0])
+		}
+	}
+}
