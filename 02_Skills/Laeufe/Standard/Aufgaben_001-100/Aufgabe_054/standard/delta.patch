+type typedEntry[T any] struct {
+	once  sync.Once
+	value T
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// The constructor passed by later callers for the same type is ignored.
+func GetInstance[T any](constructor func() T) T {
+	typ := reflect.TypeOf((*T)(nil)).Elem()
+	entry, _ := typedInstances.LoadOrStore(typ, &typedEntry[T]{})
+	instance := entry.(*typedEntry[T])
+	instance.once.Do(func() {
+		instance.value = constructor()
+	})
+	return instance.value
+}
+
