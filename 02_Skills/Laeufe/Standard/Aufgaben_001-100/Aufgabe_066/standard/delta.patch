+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and styled descendants', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 100vh; color: red');
+        root.innerHTML = `
+            <div id="nested" style="height: calc(50vh - 10px); width: 25px"></div>
+            <div id="important" style="height: 20vh !important; color: blue"></div>
+            <div id="pixels" style="height: 40px; width: 10vh"></div>
+        `;
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+        expect((root.querySelector('#nested') as HTMLElement).style.height).toBe('auto');
+        expect((root.querySelector('#nested') as HTMLElement).style.width).toBe('25px');
+        expect((root.querySelector('#important') as HTMLElement).style.getPropertyPriority('height')).toBe('important');
+        expect((root.querySelector('#important') as HTMLElement).style.height).toBe('auto');
+        expect((root.querySelector('#pixels') as HTMLElement).style.height).toBe('40px');
+        expect((root.querySelector('#pixels') as HTMLElement).style.width).toBe('10vh');
+    });
+});
