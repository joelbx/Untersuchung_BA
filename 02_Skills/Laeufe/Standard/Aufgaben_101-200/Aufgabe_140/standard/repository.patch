+@pytest.mark.parametrize('block_set', ['_blocked_hosts', '_config_blocked_hosts'])
+def test_parent_domain_blocking(config_stub, host_blocker_factory, block_set):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = ['https://sub.example.com/*']
+    blocker = host_blocker_factory()
+    getattr(blocker, block_set).add('example.com')
+
+    for host in ('example.com', 'a.b.example.com', 'example.com.',
+                 'a.b.example.com.'):
+        assert blocker._is_blocked(QUrl('https://' + host + '/path'))
+    assert not blocker._is_blocked(QUrl('https://sub.example.com/path'))
+    assert not blocker._is_blocked(QUrl('https://unrelated.com/path'))
+
+
