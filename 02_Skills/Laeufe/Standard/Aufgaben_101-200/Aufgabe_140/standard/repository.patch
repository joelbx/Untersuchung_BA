 ]
 
 
+def widened_hostnames(hostname: Optional[str]) -> Iterable[str]:
+    """Yield a hostname and its parents by removing leftmost labels."""
+    while hostname:
+        yield hostname
+        if '.' not in hostname:
+            break
+        hostname = hostname.partition('.')[2]
+
