+++ b/applications/mail/src/app/helpers/assistant/markdown.test.ts
@@ -0,0 +1,34 @@
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+describe('assistant Markdown conversion', () => {
+    it('moves a nested list inside its preceding item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+        fixNestedLists(dom);
+        expect(dom.body.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+        expect(dom.body.querySelector('ul > ul')).toBeNull();
+    });
+
+    it('keeps nested and ordered list markers during HTML round trip', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First<ul><li>Nested</li></ul></li><li>Second</li></ol>';
+        const markdown = htmlToMarkdown(dom);
+        expect(markdown).toMatch(/^1\.\s+First/m);
+        expect(markdown).toMatch(/^2\.\s+Second/m);
+        const converted = document.implementation.createHTMLDocument();
+        converted.body.innerHTML = markdownToHTML(markdown);
+        expect(converted.body.querySelector('ol > li > ul > li')?.textContent).toBe('Nested');
+    });
+
+    it('retains class and style on links and images', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<a href="#1" class="link" style="color: red">Link</a><img src="#2" class="image" style="width: 10px">';
+        const converted = document.implementation.createHTMLDocument();
+        converted.body.innerHTML = markdownToHTML(htmlToMarkdown(dom));
+        expect(converted.body.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(converted.body.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(converted.body.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(converted.body.querySelector('img')?.getAttribute('style')).toBe('width: 10px');
+    });
+});
