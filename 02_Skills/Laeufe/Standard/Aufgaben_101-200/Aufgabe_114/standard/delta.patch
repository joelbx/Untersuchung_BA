+// commonFolder finds the deepest directory that contains all the given paths.
+func commonFolder(paths []string) string {
+	if len(paths) == 0 {
+		return ""
+	}
+	common := filepath.Clean(paths[0])
+	for _, path := range paths[1:] {
+		path = filepath.Clean(path)
+		for {
+			rel, err := filepath.Rel(common, path)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			parent := filepath.Dir(common)
+			if parent == common {
+				return ""
+			}
+			common = parent
+		}
+	}
+	return common
+}
+
+func fromArtistFolder(folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		paths, err := filepath.Glob(filepath.Join(folder, "artist.*"))
+		if err != nil {
+			return nil, "", err
+		}
+		for _, path := range paths {
+			info, err := os.Stat(path)
+			if err != nil || !info.Mode().IsRegular() {
+				continue
+			}
+			file, err := os.Open(path)
+			if err == nil {
+				return file, path, nil
+			}
+		}
+		return nil, "", nil
+	}
+}
