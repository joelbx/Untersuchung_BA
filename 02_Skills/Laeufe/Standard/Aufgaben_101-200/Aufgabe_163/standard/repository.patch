diff --git a/config/database_test.go b/config/database_test.go
new file mode 100644
index 0000000..8e5367e
--- /dev/null
+++ b/config/database_test.go
@@ -0,0 +1,43 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestDatabaseFieldsLoad(t *testing.T) {
+	cases := []struct{ name, body, wantURL, wantError string }{
+		{"fields", "db:\n  protocol: postgres\n  host: localhost\n  name: flipt\n  user: alice\n  password: secret\n", "", ""},
+		{"url precedence", "db:\n  url: file:chosen.db\n  protocol: wrong\n  password: secret\n", "file:chosen.db", ""},
+		{"invalid protocol", "db:\n  protocol: oracle\n  host: localhost\n  name: flipt\n", "", "db.protocol"},
+		{"missing name", "db:\n  protocol: mysql\n  host: localhost\n", "", "db.name"},
+		{"missing host", "db:\n  protocol: sqlite3\n  name: flipt.db\n", "", "db.host"},
+		{"invalid port", "db:\n  protocol: postgres\n  host: localhost\n  name: flipt\n  port: nope\n", "", "db.port"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			if err := os.WriteFile(path, []byte(tc.body), 0600); err != nil {
+				t.Fatal(err)
+			}
+			cfg, err := Load(path)
+			if tc.wantError != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.wantError) {
+					t.Fatalf("error = %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cfg.Database.URL != tc.wantURL {
+				t.Fatalf("URL = %q", cfg.Database.URL)
+			}
+			if tc.name == "fields" && (cfg.Database.Protocol != DatabasePostgres || cfg.Database.Password != "secret") {
+				t.Fatalf("fields not loaded: %+v", cfg.Database)
+			}
+		})
+	}
+}
