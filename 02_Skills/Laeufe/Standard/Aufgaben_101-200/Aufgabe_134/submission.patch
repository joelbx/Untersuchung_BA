diff --git a/openlibrary/tests/test_runeberg_provider.py b/openlibrary/tests/test_runeberg_provider.py
new file mode 100644
index 0000000..879f75f
--- /dev/null
+++ b/openlibrary/tests/test_runeberg_provider.py
@@ -0,0 +1,21 @@
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+)
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.solr_key == 'id_project_runeberg'
+    assert provider.is_own_ocaid('projectruneberg_nordictales')
+    assert provider.is_own_ocaid('ProjectRuneberg_NordicTales')
+    assert not provider.is_own_ocaid('otherarchive')
+
+    edition = {'identifiers': {'project_runeberg': ['nordictales', 'other']}}
+    assert provider.get_identifiers(edition) == ['nordictales', 'other']
+    acquisitions = provider.get_acquisitions(edition)
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].url == 'https://runeberg.org/nordictales/'
