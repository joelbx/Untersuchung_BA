@@ -27,6 +27,28 @@ from qutebrowser.api import cmdutils
 from qutebrowser.utils import objreg
 
 
+@pytest.mark.parametrize('duration, milliseconds', [
+    ('5000', 5000),
+    ('2m30s', 150000),
+])
+def test_later_duration(mocker, qapp, duration, milliseconds):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer').return_value
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration, 'scroll down', win_id=0)
+
+    timer.setInterval.assert_called_once_with(milliseconds)
+    timer.start.assert_called_once_with()
+
+
+@pytest.mark.parametrize('duration', ['-1s', 'bad'])
+def test_later_invalid_duration(mocker, duration):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+    with pytest.raises(cmdutils.CommandError):
+        utilcmds.later(duration, 'scroll down', win_id=0)
+    timer.assert_not_called()
+
