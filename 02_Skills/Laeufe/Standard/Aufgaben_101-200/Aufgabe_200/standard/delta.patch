+def parse_duration(duration: str) -> int:
+    """Return a duration in milliseconds.
+
+    Accept hours, minutes, and seconds in that order, with optional decimal
+    values and whitespace between components. Bare integers are milliseconds.
+
+    Raises:
+        ValueError: If the duration is negative or has an invalid format.
+    """
+    duration = duration.strip()
+    if duration.startswith('-'):
+        raise ValueError("I can't run something in the past!")
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    match = _DURATION_RE.fullmatch(duration)
+    if match is None or not any(match.groupdict().values()):
+        raise ValueError('Invalid duration: {!r}'.format(duration))
+
+    milliseconds = sum(
+        Decimal(value) * factor
+        for value, factor in zip(match.groups(), (3600000, 60000, 1000))
+        if value is not None)
+    return int(milliseconds)
+
