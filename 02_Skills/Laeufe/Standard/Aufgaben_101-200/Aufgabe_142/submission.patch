diff --git a/lib/utils/parse/ast.go b/lib/utils/parse/ast.go
new file mode 100644
index 0000000..ee7f40f
--- /dev/null
+++ b/lib/utils/parse/ast.go
@@ -0,0 +1,171 @@
+package parse
+
+import (
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a typed expression node.
+type Expr interface {
+	String() string
+	Kind() reflect.Kind
+	Evaluate(EvaluateContext) (any, error)
+}
+
+// EvaluateContext supplies traits and the input to boolean matchers.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string                        { return strconv.Quote(e.Value) }
+func (StringLitExpr) Kind() reflect.Kind                      { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) { return []string{e.Value}, nil }
+
+type VarExpr struct{ Namespace, Name string }
+
+func (e VarExpr) String() string   { return e.Namespace + "." + e.Name }
+func (VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if ctx.VarValue == nil && e.Namespace == LiteralNamespace {
+		return []string{e.Name}, nil
+	}
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("no variable resolver for %s", e.String())
+	}
+	return ctx.VarValue(e)
+}
+
+type EmailLocalExpr struct{ Input Expr }
+
+func (e EmailLocalExpr) String() string   { return "email.local(" + e.Input.String() + ")" }
+func (EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	vals, err := evalStrings(e.Input, ctx)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]string, 0, len(vals))
+	for _, v := range vals {
+		if v == "" {
+			return nil, trace.BadParameter("address is empty")
+		}
+		addr, err := mail.ParseAddress(v)
+		if err != nil {
+			return nil, trace.BadParameter("failed to parse address %q: %v", v, err)
+		}
+		parts := strings.SplitN(addr.Address, "@", 2)
+		if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+			return nil, trace.BadParameter("address %q has no local part", v)
+		}
+		out = append(out, parts[0])
+	}
+	return out, nil
+}
+
+type RegexpReplaceExpr struct {
+	Input                Expr
+	Pattern, Replacement string
+	re                   *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return "regexp.replace(" + e.Input.String() + "," + strconv.Quote(e.Pattern) + "," + strconv.Quote(e.Replacement) + ")"
+}
+func (RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	vals, err := evalStrings(e.Input, ctx)
+	if err != nil {
+		return nil, err
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	out := make([]string, 0, len(vals))
+	for _, v := range vals {
+		if re.MatchString(v) {
+			out = append(out, re.ReplaceAllString(v, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string   { return "regexp.match(" + strconv.Quote(e.Pattern) + ")" }
+func (RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	var err error
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	return "regexp.not_match(" + strconv.Quote(e.Pattern) + ")"
+}
+func (RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	matched, err := RegexpMatchExpr{Pattern: e.Pattern, re: e.re}.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return !matched.(bool), nil
+}
+func evalStrings(e Expr, ctx EvaluateContext) ([]string, error) {
+	if e.Kind() != reflect.String {
+		return nil, trace.BadParameter("%s evaluates to %s, expected string", e.String(), e.Kind())
+	}
+	v, err := e.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	vals, ok := v.([]string)
+	if !ok {
+		return nil, trace.BadParameter("%s returned %T, expected []string", e.String(), v)
+	}
+	return vals, nil
+}
+func compileRegexp(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("invalid regexp %q: %v", pattern, err)
+	}
+	return re, nil
+}
+func validateExpr(e Expr) error {
+	switch n := e.(type) {
+	case VarExpr:
+		if n.Name == "" {
+			return trace.BadParameter("variable %q must have namespace.name shape", n.String())
+		}
+	case EmailLocalExpr:
+		return validateExpr(n.Input)
+	case RegexpReplaceExpr:
+		return validateExpr(n.Input)
+	}
+	return nil
+}
diff --git a/lib/utils/parse/ast_test.go b/lib/utils/parse/ast_test.go
new file mode 100644
index 0000000..a8deca5
--- /dev/null
+++ b/lib/utils/parse/ast_test.go
@@ -0,0 +1,66 @@
+package parse
+
+import (
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func TestNestedExpressions(t *testing.T) {
+	expr, err := NewExpression(` pre{{regexp.replace(email.local(external.email), "^([^.]+).*", "$1")}}post `)
+	require.NoError(t, err)
+	vals, err := expr.Interpolate(map[string][]string{"email": {"alice@example.com", "bob.smith@example.com"}}, func(ns, name string) error {
+		require.Equal(t, "external", ns)
+		require.Equal(t, "email", name)
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []string{"prealicepost", "prebobpost"}, vals)
+	expr, err = NewExpression(`{{regexp.replace("aaaa", "a{2}", "b")}}`)
+	require.NoError(t, err)
+	vals, err = expr.Interpolate(nil)
+	require.NoError(t, err)
+	require.Equal(t, []string{"bb"}, vals)
+	expr, err = NewExpression(`{{regexp.replace("foo", "o", "a")}}`)
+	require.NoError(t, err)
+	vals, err = expr.Interpolate(nil)
+	require.NoError(t, err)
+	require.Equal(t, []string{"faa"}, vals)
+}
+func TestExpressionValidation(t *testing.T) {
+	for _, in := range []string{`{{internal}}`, `{{internal.foo.bar}}`, `{{internal.foo["bar"]}}`, `{{internal["foo"]["bar"]}}`, `{{unknown.foo}}`, `{{"asdf"}}`, `{{123}}`, `{{regexp.match("foo")}}`, `{{email.local(regexp.match("foo"))}}`, `{{regexp.replace(external.foo, external.pattern, "bar")}}`, `{{regexp.replace(external.foo, "x", external.replacement)}}`, `{{regexp.replace(external.foo, "x")}}`, `{{regexp.match(external.foo)}}`, `{{email.local("x", "y")}}`, `{{external.foo`} {
+		_, err := NewExpression(in)
+		require.Error(t, err, in)
+		require.True(t, trace.IsBadParameter(err), "%q: %v", in, err)
+	}
+	expr, err := NewExpression(`{{internal.foo}}`)
+	require.NoError(t, err)
+	_, err = expr.Interpolate(map[string][]string{"foo": {"v"}}, func(ns, name string) error { return trace.BadParameter("blocked %s.%s", ns, name) })
+	require.True(t, trace.IsBadParameter(err))
+	_, err = expr.Interpolate(nil)
+	require.True(t, trace.IsNotFound(err))
+	require.Contains(t, err.Error(), "internal.foo")
+	expr, err = NewExpression(`prefix{{regexp.replace(external.foo, "z", "x")}}suffix`)
+	require.NoError(t, err)
+	_, err = expr.Interpolate(map[string][]string{"foo": {"abc"}})
+	require.True(t, trace.IsNotFound(err))
+	require.Contains(t, err.Error(), "no values")
+	_, err = NewExpression("{{" + strings.Repeat("email.local(", 101) + "external.foo" + strings.Repeat(")", 101) + "}}")
+	require.True(t, trace.IsBadParameter(err))
+}
+func TestMatcherAST(t *testing.T) {
+	m, err := NewMatcher(`pre{{regexp.not_match("^bad$")}}post`)
+	require.NoError(t, err)
+	require.True(t, m.Match("pregoodpost"))
+	require.False(t, m.Match("prebadpost"))
+	require.False(t, m.Match("goodpost"))
+	m, err = NewMatcher(`a*b`)
+	require.NoError(t, err)
+	require.True(t, m.Match("axxb"))
+	require.False(t, m.Match("zaxxb"))
+	for _, in := range []string{`{{external.foo}}`, `{{regexp.match(external.foo)}}`, `{{regexp.match("x", "y")}}`, `{{regexp.match("[")}}`} {
+		_, err := NewMatcher(in)
+		require.True(t, trace.IsBadParameter(err), "%s: %v", in, err)
+	}
+}
