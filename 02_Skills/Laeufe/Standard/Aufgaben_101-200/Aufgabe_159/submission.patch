+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typ, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cargo", "serde", "", "serde", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typ+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typ, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.typ, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPURLUsesParsedName(t *testing.T) {
+	for _, tt := range []struct {
+		typ  ftypes.LangType
+		name string
+		want string
+	}{
+		{ftypes.Pom, "com.google.guava:guava", "pkg:pom/com.google.guava/guava@1.0?file_path=pom.xml"},
+		{ftypes.Pip, "My_Package", "pkg:pip/my-package@1.0?file_path=pom.xml"},
+		{ftypes.GoModule, "github.com/protobom/protobom", "pkg:gomod/github.com/protobom/protobom@1.0?file_path=pom.xml"},
+		{ftypes.Npm, "@babel/core", "pkg:npm/%40babel/core@1.0?file_path=pom.xml"},
+		{ftypes.Cocoapods, "GoogleUtilities/NSData+zlib", "pkg:cocoapods/GoogleUtilities@1.0?file_path=pom.xml#NSData+zlib"},
+	} {
+		t.Run(string(tt.typ), func(t *testing.T) {
+			purls := map[string]map[string]string{"pom.xml": {}}
+			components := libpkgToCdxComponents(models.LibraryScanner{
+				Type: tt.typ, LockfilePath: "pom.xml", Libs: []models.Library{{Name: tt.name, Version: "1.0"}},
+			}, purls)
+			if got := components[1].PackageURL; got != tt.want {
+				t.Errorf("PackageURL = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
