+// parsePkgName splits ecosystem-specific package names into PURL fields.
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch t {
+	case "maven", "pom", "jar", "gradle":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			return group, artifact, ""
+		}
+	case "pypi", "pip", "pipenv", "poetry", "uv", "python-pkg":
+		return "", strings.ToLower(strings.ReplaceAll(n, "_", "-")), ""
+	case "golang", "gomod", "gobinary":
+		if i := strings.LastIndexByte(n, '/'); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+	case "npm", "yarn", "pnpm", "node-pkg":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				return scope, pkg, ""
+			}
+		}
+	case "cocoapods":
+		if pkg, path, ok := strings.Cut(n, "/"); ok {
+			return "", pkg, path
+		}
+	}
+	return "", name, ""
+}
