+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name            string
+		opts            []containers.Option[StoreOptions]
+		configMediaType string
+		artifactType    string
+	}{
+		{name: "default", configMediaType: v1.MediaTypeEmptyJSON, artifactType: MediaTypeFliptFeatures},
+		{name: "1.0", opts: []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)}, configMediaType: MediaTypeFliptFeatures},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			ref, err := ParseReference("flipt://local/bundle:latest")
+			require.NoError(t, err)
+			store, err := NewStore(zaptest.NewLogger(t), t.TempDir(), tc.opts...)
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			bundle, err := store.Build(ctx, src, ref)
+			require.NoError(t, err)
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			assert.Equal(t, bundle.Digest, desc.Digest)
+			payload, err := content.FetchAll(ctx, target, desc)
+			require.NoError(t, err)
+			var manifest v1.Manifest
+			require.NoError(t, json.Unmarshal(payload, &manifest))
+			assert.Equal(t, tc.configMediaType, manifest.Config.MediaType)
+			assert.Equal(t, tc.artifactType, manifest.ArtifactType)
+		})
+	}
+}
