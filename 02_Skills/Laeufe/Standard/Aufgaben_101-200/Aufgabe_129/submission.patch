+
+    private onKeyActivationCapture = (ev: React.KeyboardEvent) => {
+        const item = (ev.target as HTMLElement).closest<HTMLElement>('[role^="menuitem"]');
+        if (!item || item.getAttribute('aria-disabled') === 'true') return;
+
+        const action = getKeyBindingsManager().getAccessibilityAction(ev);
+        if ((ev.type === 'keydown' && action === KeyBindingAction.Enter) ||
+            (ev.type === 'keyup' && action === KeyBindingAction.Space)) {
+            this.props.onFinished();
+        }
     };
 
