+
+import React from "react";
+
+import UIStore from "../../../stores/UIStore";
+import { ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import IconizedContextMenu from "./IconizedContextMenu";
+
+interface Props extends Omit<React.ComponentProps<typeof ContextMenuButton>, "label" | "isExpanded" | "onClick"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...props }) => {
+    const [isOpen, button, open, close] = useContextMenu<HTMLElement>();
+    const rect = isOpen ? button.current?.getBoundingClientRect() : undefined;
+
+    return <>
+        <ContextMenuButton
+            {...props}
+            inputRef={button}
+            label={title}
+            isExpanded={isOpen}
+            disabled={disabled}
+            aria-disabled={disabled}
+            onClick={(ev) => {
+                button.current?.focus();
+                open(ev);
+            }}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { isOpen && rect && <IconizedContextMenu
+            top={rect.bottom + 1}
+            right={UIStore.instance.windowWidth - rect.right}
+            menuClassName="mx_KebabContextMenu_menu"
+            onFinished={close}
+        >
+            { options }
+        </IconizedContextMenu> }
+    </>;
+};
