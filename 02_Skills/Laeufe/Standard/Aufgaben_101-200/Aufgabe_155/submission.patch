+func TestEnsureUUIDsImageReference(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+
+	for _, tc := range []struct {
+		image models.Image
+		key   string
+	}{
+		{models.Image{Name: "app", Tag: "v1"}, "app:v1@host"},
+		{models.Image{Name: "app", Digest: "sha256:abc"}, "app@sha256:abc@host"},
+	} {
+		config.Conf.Servers = map[string]config.ServerInfo{"host": {}}
+		path := filepath.Join(t.TempDir(), "config.toml")
+		if err := os.WriteFile(path, []byte(""), 0600); err != nil {
+			t.Fatal(err)
+		}
+		results := models.ScanResults{{ServerName: "host", Image: tc.image}}
+		if err := EnsureUUIDs(path, results); err != nil {
+			t.Fatal(err)
+		}
+		if config.Conf.Servers["host"].UUIDs[tc.key] == "" {
+			t.Errorf("UUID identifier %q missing from %+v", tc.key, config.Conf.Servers["host"].UUIDs)
+		}
+	}
+}
