+func TestImageReference(t *testing.T) {
+	tests := []struct {
+		name, tag, digest, fullName, errorMessage string
+	}{
+		{name: "registry.example/app", tag: "latest", fullName: "registry.example/app:latest"},
+		{name: "registry.example/app", digest: "sha256:abc", fullName: "registry.example/app@sha256:abc"},
+		{tag: "latest", errorMessage: "Invalid arguments : no image name"},
+		{name: "app", errorMessage: "Invalid arguments : no image tag and digest"},
+		{name: "app", tag: "latest", digest: "sha256:abc", errorMessage: "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tc := range tests {
+		image := Image{Name: tc.name, Tag: tc.tag, Digest: tc.digest}
+		err := IsValidImage(image)
+		if tc.errorMessage == "" {
+			if err != nil {
+				t.Errorf("%+v: unexpected error: %v", image, err)
+			}
+			if got := image.GetFullName(); got != tc.fullName {
+				t.Errorf("%+v: full name = %q, want %q", image, got, tc.fullName)
+			}
+		} else if err == nil || err.Error() != tc.errorMessage {
+			t.Errorf("%+v: error = %v, want %q", image, err, tc.errorMessage)
+		}
+	}
+}
