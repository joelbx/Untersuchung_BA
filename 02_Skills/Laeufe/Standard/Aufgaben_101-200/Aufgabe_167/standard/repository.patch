diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..714c5ad
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,105 @@
+package oci
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source builds snapshots from a tracked OCI reference.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+// NewSource constructs a source with a 30 second polling interval.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if logger == nil || store == nil {
+		return nil, fmt.Errorf("OCI source requires a logger and store")
+	}
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, fmt.Errorf("OCI poll interval must be positive")
+	}
+	return s, nil
+}
+
+// WithPollInterval sets the source's polling interval.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+func (*Source) String() string { return "oci" }
+
+// Get returns the latest snapshot, rebuilding it only when the manifest changes.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.logger.Debug("fetching OCI snapshot")
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	if response.Matched && s.snapshot != nil {
+		return s.snapshot, nil
+	}
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	s.snapshot = snapshot
+	s.digest = response.Digest
+	return snapshot, nil
+}
+
+// Subscribe polls for changes until the context is cancelled.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			s.mu.Lock()
+			previous := s.digest
+			s.mu.Unlock()
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				s.logger.Error("failed polling OCI snapshot", zap.Error(err))
+				continue
+			}
+			s.mu.Lock()
+			changed := s.digest != previous
+			s.mu.Unlock()
+			if changed {
+				s.logger.Debug("OCI snapshot changed")
+				select {
+				case ch <- snapshot:
+				case <-ctx.Done():
+					return
+				}
+			}
+		}
+	}
+}
diff --git a/internal/storage/fs/oci/source_test.go b/internal/storage/fs/oci/source_test.go
new file mode 100644
index 0000000..cf32243
--- /dev/null
+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,78 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	ocistore "oras.land/oras-go/v2/content/oci"
+)
+
+func TestLocalSourceSeesExternalUpdates(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	write := func(payload string) {
+		t.Helper()
+		target, err := ocistore.New(filepath.Join(root, "flags"))
+		require.NoError(t, err)
+		target.AutoSaveIndex = true
+		layer := v1.Descriptor{
+			MediaType: fliptoci.MediaTypeFliptNamespace + "+yaml",
+			Digest:    digest.FromString(payload), Size: int64(len(payload)),
+			Annotations: map[string]string{fliptoci.AnnotationFliptNamespace: "production"},
+		}
+		require.NoError(t, target.Push(ctx, layer, bytes.NewBufferString(payload)))
+		manifest, err := oras.PackManifest(ctx, target, oras.PackManifestVersion1_1_RC4,
+			fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{Layers: []v1.Descriptor{layer}})
+		require.NoError(t, err)
+		require.NoError(t, target.Tag(ctx, manifest, "latest"))
+	}
+	write("flags:\n  - key: first\n    name: First\n    enabled: true\n")
+	store, err := fliptoci.NewStore(&config.OCI{BundleDirectory: root, Repository: "flipt://local/flags:latest"})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, WithPollInterval(10*time.Millisecond))
+	require.NoError(t, err)
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "production", "first")
+	require.NoError(t, err)
+	same, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, same)
+
+	write("flags:\n  - key: second\n    name: Second\n    enabled: true\n")
+	second, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.NotSame(t, first, second)
+	_, err = second.GetFlag(ctx, "production", "second")
+	require.NoError(t, err)
+
+	subctx, cancel := context.WithCancel(ctx)
+	updates := make(chan *storagefs.StoreSnapshot)
+	go source.Subscribe(subctx, updates)
+	write("flags:\n  - key: third\n    name: Third\n    enabled: true\n")
+	select {
+	case update := <-updates:
+		_, err = update.GetFlag(ctx, "production", "third")
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("updated OCI manifest was not emitted")
+	}
+	cancel()
+	select {
+	case _, open := <-updates:
+		require.False(t, open)
+	case <-time.After(time.Second):
+		t.Fatal("subscription did not stop")
+	}
+}
