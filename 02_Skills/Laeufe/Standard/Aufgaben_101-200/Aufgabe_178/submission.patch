+
+
+@pytest.mark.skipif(not encrypt.PASSLIB_AVAILABLE, reason='passlib required')
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_passlib(ident):
+    settings = dict(salt='123456789012345678901u', rounds=4, ident=ident)
+    result = get_encrypted_password('foo', 'blowfish', **settings)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+    assert encrypt.do_encrypt('foo', 'bcrypt', **settings) == result
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+def test_bcrypt_ident_crypt(ident):
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+        assert result.startswith('$%s$04$123456789012345678901u' % ident)
+
+
+def test_ident_ignored_for_non_bcrypt():
+    assert get_encrypted_password('123', 'sha256', salt='12345678', ident='2y') == get_encrypted_password('123', 'sha256', salt='12345678')
+
+
+@pytest.mark.skipif(not encrypt.PASSLIB_AVAILABLE, reason='passlib required')
+def test_bcrypt_filter_default_ident_unchanged():
+    result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4)
+    assert result.startswith('$2b$04$')
