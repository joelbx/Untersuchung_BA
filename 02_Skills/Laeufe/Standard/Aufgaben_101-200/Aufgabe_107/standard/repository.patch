index 0000000..a02a06d
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.test.ts
@@ -0,0 +1,72 @@
+import { produce } from 'immer';
+
+import { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+import { optimisticMarkAs } from '../elementsActions';
+import { optimisticUpdates } from '../elementsReducers';
+import { newState } from '../elementsSlice';
+import { getElementsToBypassFilter } from './elementBypassFilters';
+
+const message = { ID: 'message', ConversationID: 'conversation' } as Element;
+
+describe('getElementsToBypassFilter', () => {
+    it.each([
+        [1, MARK_AS_STATUS.UNREAD, false],
+        [1, MARK_AS_STATUS.READ, true],
+        [0, MARK_AS_STATUS.READ, false],
+        [0, MARK_AS_STATUS.UNREAD, true],
+        [undefined, MARK_AS_STATUS.READ, true],
+    ])('classifies filter %s and action %s', (unreadFilter, status, shouldBypass) => {
+        const result = getElementsToBypassFilter([message], status, unreadFilter);
+        expect(result.elementsToBypass).toEqual(shouldBypass ? [message] : []);
+        expect(result.elementsToRemove).toEqual(shouldBypass ? [] : [message]);
+    });
+});
+
+describe('optimisticUpdates bypass filter', () => {
+    it.each([
+        [1, MARK_AS_STATUS.READ, MARK_AS_STATUS.UNREAD],
+        [0, MARK_AS_STATUS.UNREAD, MARK_AS_STATUS.READ],
+    ])('removes stale message IDs for filter %s', (unreadFilter, addStatus, removeStatus) => {
+        let state = newState({ params: { filter: { Unread: unreadFilter } } });
+        const update = (status: MARK_AS_STATUS) => {
+            state = produce(state, (draft) => {
+                optimisticUpdates(
+                    draft,
+                    optimisticMarkAs({
+                        elements: [message],
+                        bypass: true,
+                        conversationMode: false,
+                        markAsStatus: status,
+                    })
+                );
+            });
+        };
+
+        update(addStatus);
+        update(addStatus);
+        expect(state.bypassFilter).toEqual(['message']);
+        update(removeStatus);
+        expect(state.bypassFilter).toEqual([]);
+    });
+
+    it('uses conversation IDs in conversation mode', () => {
+        const initial = newState({ params: { filter: { Unread: 1 } } });
+        const update = (status: MARK_AS_STATUS, state = initial) =>
+            produce(state, (draft) => {
+                optimisticUpdates(
+                    draft,
+                    optimisticMarkAs({
+                        elements: [message],
+                        bypass: true,
+                        conversationMode: true,
+                        markAsStatus: status,
+                    })
+                );
+            });
+
+        const added = update(MARK_AS_STATUS.READ);
+        expect(added.bypassFilter).toEqual(['conversation']);
+        expect(update(MARK_AS_STATUS.UNREAD, added).bypassFilter).toEqual([]);
+    });
+});
diff --git a/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
new file mode 100644
index 0000000..953ca37
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
@@ -0,0 +1,13 @@
+import { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+
+export const getElementsToBypassFilter = (elements: Element[], action: MARK_AS_STATUS, unreadFilter?: number) => {
+    const matchesFilter =
+        (unreadFilter === 1 && action === MARK_AS_STATUS.UNREAD) ||
+        (unreadFilter === 0 && action === MARK_AS_STATUS.READ);
+
+    return {
+        elementsToBypass: matchesFilter ? [] : elements,
+        elementsToRemove: matchesFilter ? elements : [],
+    };
+};
