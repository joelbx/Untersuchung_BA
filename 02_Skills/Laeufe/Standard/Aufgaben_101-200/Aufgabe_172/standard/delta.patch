+// NewPortStat parses a listening address and port.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	address, port, err := net.SplitHostPort(ipPort)
+	portNumber, portErr := strconv.Atoi(port)
+	if err != nil || portErr != nil || portNumber < 1 || portNumber > 65535 || strings.ContainsAny(address, "[]") || (address != "*" && net.ParseIP(address) == nil) {
+		return nil, xerrors.Errorf("Invalid listening port: %s", ipPort)
+	}
+	// SplitHostPort accepts unbracketed hostnames and IPv4 addresses, and
+	// bracketed IPv6 addresses. Preserve the brackets used in scan output.
+	if strings.HasPrefix(ipPort, "[") {
+		address = "[" + address + "]"
+	}
+	stat.BindAddress, stat.Port = address, port
+	return stat, nil
+}
