@@ -0,0 +1,36 @@
+package models
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestLegacyListenPortsJSON(t *testing.T) {
+	var result struct {
+		Packages Packages `json:"packages"`
+	}
+	data := []byte(`{"packages":{"sshd":{"AffectedProcs":[{"pid":"12","listenPorts":["127.0.0.1:22","*:22"]}]}}}`)
+	if err := json.Unmarshal(data, &result); err != nil {
+		t.Fatal(err)
+	}
+	proc := result.Packages["sshd"].AffectedProcs[0]
+	if !reflect.DeepEqual(proc.ListenPorts, []string{"127.0.0.1:22", "*:22"}) || proc.ListenPortStats != nil {
+		t.Fatalf("unexpected legacy ports: %+v", proc)
+	}
+	if result.Packages["sshd"].HasReachablePort() {
+		t.Fatal("legacy ports cannot indicate scan reachability")
+	}
+	proc.ListenPortStats = []PortStat{{BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1"}}}
+	if !(Package{AffectedProcs: []AffectedProcess{proc}}).HasReachablePort() {
+		t.Fatal("reachable port was not detected")
+	}
+}
+
+func TestNewPortStatInvalid(t *testing.T) {
+	for _, input := range []string{"127.0.0.1", ":22", "127.0.0.1:", "127.0.0.1:abc", "127.0.0.1:65536", "::1:22", "[not-ip]:22"} {
+		if stat, err := NewPortStat(input); err == nil {
+			t.Errorf("NewPortStat(%q) = %+v without error", input, stat)
+		}
+	}
+}
