+#!/usr/bin/python
+# Copyright: Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1', 'status': ['preview'], 'supported_by': 'community'}
+
+DOCUMENTATION = '''
+---
+module: icx_logging
+version_added: "2.9"
+short_description: Manage logging on Ruckus ICX 7000 series switches
+description:
+  - Manage syslog hosts, console, buffered levels, persistence, RFC5424, global logging, and facilities.
+options:
+  dest:
+    description: Logging destination or feature.
+    type: str
+    choices: [host, console, buffered, persistence, rfc5424, on]
+  name:
+    description: Syslog host name or IPv4/IPv6 address; required for host.
+    type: str
+  udp_port:
+    description: UDP port for a syslog host.
+    type: int
+  facility:
+    description: Syslog facility to set or clear.
+    type: str
+  level:
+    description: Buffered logging level; required for buffered.
+    type: str
+    choices: [alerts, critical, debugging, emergencies, errors, informational, notifications, warnings]
+  aggregate:
+    description: List of logging settings.
+    type: list
+    elements: dict
+  state:
+    description: Whether the setting should be present or absent.
+    type: str
+    choices: [present, absent]
+    default: present
+  check_running_config:
+    description: Compare against the running configuration; also settable with ANSIBLE_CHECK_ICX_RUNNING_CONFIG.
+    type: bool
+    default: true
+'''
+
+EXAMPLES = '''
+- name: Configure an IPv6 syslog server
+  icx_logging:
+    dest: host
+    name: 2001:db8::1
+    udp_port: 514
+
+- name: Disable console logging
+  icx_logging:
+    dest: console
+    state: absent
+
+- name: Set facility and disable a buffered level
+  icx_logging:
+    aggregate:
+      - facility: local0
+      - dest: buffered
+        level: debugging
+        state: absent
+'''
+
+RETURN = '''
+commands:
+  description: Configuration commands sent to the device.
+  returned: always
+  type: list
+'''
+
+import re
+from copy import deepcopy
+from ansible.module_utils.basic import AnsibleModule, env_fallback
+from ansible.module_utils.network.common.utils import remove_default_spec, validate_ip_v6_address
+from ansible.module_utils.network.icx.icx import get_config, load_config
+from ansible.module_utils.six import string_types
+
+LEVELS = ('alerts', 'critical', 'debugging', 'emergencies', 'errors',
+          'informational', 'notifications', 'warnings')
+
+
+def count_terms(check, param=None):
+    return sum(check.get(key) is not None for key in (param if param is not None else check))
+
+
+def search_obj_in_list(name, lst):
+    for obj in lst:
+        if obj.get('name') == name:
+            return obj
+    return None
+
+
+def diff_in_list(want, have):
+    return set(want) - set(have), set(have) - set(want)
+
+
+def parse_port(line, dest):
+    if dest == 'host':
+        match = re.search(r'\budp-port\s+(\d+)\b', line)
+        if match:
+            return match.group(1)
+    return None
+
+
+def parse_name(line, dest):
+    if dest == 'host':
+        match = re.match(r'^(?:no )?logging host (?:ipv6 )?(\S+)', line.strip())
+        if match:
+            return match.group(1)
+    return None
+
+
+def parse_address(line, dest):
+    return dest == 'host' and bool(re.match(r'^(?:no )?logging host ipv6\s+\S+', line.strip()))
+
+
+def check_required_if(module, spec, param):
+    for key, value, required in spec or []:
+        if param.get(key) == value:
+            for field in required:
+                if param.get(field) is None or param.get(field) == '':
+                    module.fail_json(msg="%s is required when %s is %s" % (field, key, value))
+
+
+def map_params_to_obj(module, required_if=None):
+    params = module.params
+    aggregate = params.get('aggregate')
+    entries = aggregate if aggregate is not None else [params]
+    obj = []
+    for item in entries:
+        item = dict(item)
+        for key in ('dest', 'name', 'udp_port', 'facility', 'level', 'state'):
+            if key == 'dest' and item.get('facility') is not None and item.get('dest') is None:
+                continue
+            if item.get(key) is None:
+                item[key] = params.get(key)
+        item['state'] = item.get('state') or 'present'
+        check_required_if(module, required_if, item)
+        dest = item.get('dest')
+        if count_terms(item, ('dest', 'facility')) == 0:
+            module.fail_json(msg='dest or facility is required')
+        if dest != 'host':
+            item['name'] = None
+            item['udp_port'] = None
+        if dest == 'host':
+            item['addr6'] = bool(validate_ip_v6_address(item['name']))
+            if ':' in item['name'] and not item['addr6']:
+                module.fail_json(msg='invalid IPv6 host address: %s' % item['name'])
+            if item['udp_port'] is not None:
+                item['udp_port'] = str(item['udp_port'])
+        else:
+            item['addr6'] = False
+        if dest == 'buffered':
+            item['level'] = set([item['level']]) if isinstance(item['level'], string_types) else set(item['level'])
+        else:
+            item['level'] = None
+        if dest:
+            entry = dict(item)
+            entry['facility'] = None
+            obj.append(entry)
+        if item.get('facility') is not None:
+            obj.append(dict(dest='facility', facility=item['facility'], state=item['state'],
+                            name=None, udp_port=None, addr6=False, level=None))
+    return obj
+
+
+def map_config_to_obj(module):
+    data = get_config(module, flags='| include logging',
+                      compare=module.params.get('check_running_config'))
+    obj = []
+    facility = 'user'
+    explicit_facility = False
+    on = True
+    buffered = False
+    disabled_levels = set()
+    for raw in data.splitlines():
+        line = raw.strip()
+        if line.startswith('logging host '):
+            obj.append(dict(dest='host', name=parse_name(line, 'host'),
+                            udp_port=parse_port(line, 'host'), addr6=parse_address(line, 'host')))
+        elif line.startswith('logging facility '):
+            facility = line.split()[2]
+            explicit_facility = True
+        elif line == 'no logging facility':
+            facility = 'user'
+            explicit_facility = False
+        elif line == 'no logging on':
+            on = False
+        elif line == 'logging on':
+            on = True
+        elif line == 'logging buffered':
+            buffered = True
+        elif line.startswith('logging buffered '):
+            level = line.split()[2]
+            if level in LEVELS:
+                buffered = True
+                disabled_levels.discard(level)
+        elif line == 'no logging buffered':
+            buffered = False
+        elif line.startswith('no logging buffered '):
+            level = line.split()[3]
+            if level in LEVELS:
+                disabled_levels.add(level)
+        elif line == 'logging console':
+            obj.append(dict(dest='console'))
+        elif line == 'no logging console':
+            obj = [entry for entry in obj if entry['dest'] != 'console']
+        elif line == 'logging persistence':
+            obj.append(dict(dest='persistence'))
+        elif line == 'no logging persistence':
+            obj = [entry for entry in obj if entry['dest'] != 'persistence']
+        elif line == 'logging enable rfc5424':
+            obj.append(dict(dest='rfc5424'))
+        elif line == 'no logging enable rfc5424':
+            obj = [entry for entry in obj if entry['dest'] != 'rfc5424']
+    obj.append(dict(dest='facility', facility=facility, explicit=explicit_facility))
+    obj.append(dict(dest='buffered', level=set(LEVELS) - disabled_levels if buffered else set(),
+                    buffered=buffered))
+    if on:
+        obj.append(dict(dest='on'))
+    return obj
+
+
+def map_obj_to_commands(updates):
+    want, have = updates
+    commands = []
+    for item in want:
+        dest = item['dest']
+        present = item['state'] == 'present'
+        if dest == 'facility':
+            current = next((h for h in have if h['dest'] == 'facility'), None)
+            if present and (current is None or current['facility'] != item['facility']):
+                commands.append('logging facility %s' % item['facility'])
+            elif not present and current and current.get('explicit') and current['facility'] == item['facility']:
+                commands.append('no logging facility')
+        elif dest == 'host':
+            matches = [h for h in have if h['dest'] == 'host' and
+                       h['name'] == item['name'] and h['addr6'] == item['addr6']]
+            exact = [h for h in matches if h['udp_port'] == item['udp_port']]
+            prefix = 'logging host %s%s' % ('ipv6 ' if item['addr6'] else '', item['name'])
+            if present:
+                if not search_obj_in_list(item['name'], exact):
+                    for old in matches:
+                        commands.append('no %s%s' % (prefix, ' udp-port ' + old['udp_port'] if old['udp_port'] else ''))
+                    commands.append('%s%s' % (prefix, ' udp-port ' + item['udp_port'] if item['udp_port'] else ''))
+            else:
+                selected = exact if item['udp_port'] is not None else matches
+                for old in selected:
+                    commands.append('no %s%s' % (prefix, ' udp-port ' + old['udp_port'] if old['udp_port'] else ''))
+        elif dest == 'buffered':
+            current = next((h for h in have if h['dest'] == 'buffered'), {'level': set()})
+            levels = item['level'] or set()
+            if present:
+                adds, _ = diff_in_list(levels, current['level'])
+                commands.extend('logging buffered %s' % level for level in sorted(adds))
+            else:
+                commands.extend('no logging buffered %s' % level
+                                for level in sorted(levels & current['level']))
+        else:
+            exists = any(h['dest'] == dest for h in have)
+            if present != exists:
+                suffix = 'enable rfc5424' if dest == 'rfc5424' else dest
+                commands.append('%slogging %s' % ('' if present else 'no ', suffix))
+    return commands
+
+
+def main():
+    element_spec = dict(
+        dest=dict(type='str', choices=['host', 'console', 'buffered', 'persistence', 'rfc5424', 'on']),
+        name=dict(type='str'), udp_port=dict(type='int'), facility=dict(type='str'),
+        level=dict(type='str', choices=LEVELS),
+        state=dict(type='str', default='present', choices=['present', 'absent']),
+        check_running_config=dict(type='bool', default=True,
+                                  fallback=(env_fallback, ['ANSIBLE_CHECK_ICX_RUNNING_CONFIG'])))
+    aggregate_spec = deepcopy(element_spec)
+    remove_default_spec(aggregate_spec)
+    argument_spec = dict(aggregate=dict(type='list', elements='dict', options=aggregate_spec))
+    argument_spec.update(element_spec)
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+    want = map_params_to_obj(module, [('dest', 'host', ['name']), ('dest', 'buffered', ['level'])])
+    have = map_config_to_obj(module)
+    commands = map_obj_to_commands((want, have))
+    if commands and not module.check_mode:
+        load_config(module, commands)
+    module.exit_json(changed=bool(commands), commands=commands)
+
+
+if __name__ == '__main__':
+    main()
