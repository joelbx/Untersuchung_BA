+import React from "react";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+import { RegistrationTokenAuthEntry } from "../../../src/components/views/auth/InteractiveAuthEntryComponents";
+import { getMockClientWithEventEmitter, unmockClientPeg } from "../../test-utils";
+
+describe("registration token interactive auth", () => {
+    const matrixClient = getMockClientWithEventEmitter({
+        generateClientSecret: jest.fn().mockReturnValue("client-secret"),
+    });
+
+    afterAll(() => unmockClientPeg());
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits and completes the %s stage",
+        async (loginType) => {
+            const response = { user_id: "@new:example.org" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+            const { container } = render(
+                <InteractiveAuth
+                    matrixClient={matrixClient}
+                    authData={{ session: "registration-session", flows: [{ stages: [loginType] }] }}
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+            );
+
+            const tokenField = await screen.findByRole("textbox", { name: "Registration token" });
+            expect(tokenField).toHaveAttribute("name", "registrationTokenField");
+            expect(tokenField).toHaveFocus();
+            expect(
+                screen.getByText("Enter a registration token provided by the homeserver administrator."),
+            ).toBeTruthy();
+            const continueButton = screen.getByRole("button", { name: "Continue" });
+            expect(continueButton).toBeDisabled();
+            expect(continueButton).toHaveClass("mx_AccessibleButton_kind_primary");
+            expect(onStagePhaseChange).toHaveBeenCalledWith(loginType, 0);
+
+            fireEvent.change(tokenField, { target: { value: "invitation-token" } });
+            expect(continueButton).toBeEnabled();
+            if (loginType === AuthType.RegistrationToken) {
+                fireEvent.submit(container.querySelector("form"));
+            } else {
+                fireEvent.click(continueButton);
+            }
+
+            await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+            expect(makeRequest).toHaveBeenCalledWith({
+                session: "registration-session",
+                type: loginType,
+                token: "invitation-token",
+            });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            });
+        },
+    );
+
+    it("prevents duplicate submissions while busy and displays errors", () => {
+        const submitAuthDict = jest.fn();
+        const onPhaseChange = jest.fn();
+        const props = {
+            matrixClient,
+            loginType: AuthType.RegistrationToken,
+            authSessionId: "registration-session",
+            onPhaseChange,
+            submitAuthDict,
+            busy: false,
+        };
+        const { rerender, container } = render(<RegistrationTokenAuthEntry {...props} />);
+        expect(onPhaseChange).toHaveBeenCalledWith(0);
+
+        fireEvent.change(screen.getByRole("textbox", { name: "Registration token" }), {
+            target: { value: "token" },
+        });
+        fireEvent.submit(container.querySelector("form"));
+        fireEvent.submit(container.querySelector("form"));
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: AuthType.RegistrationToken, token: "token" });
+
+        rerender(<RegistrationTokenAuthEntry {...props} busy={true} />);
+        expect(screen.queryByRole("button", { name: "Continue" })).toBeNull();
+        expect(container.querySelector(".mx_Spinner")).toBeTruthy();
+        fireEvent.submit(container.querySelector("form"));
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+
+        rerender(<RegistrationTokenAuthEntry {...props} errorText="Invalid token" />);
+        expect(screen.getByRole("alert")).toHaveTextContent("Invalid token");
+        expect(screen.getByRole("alert")).toHaveClass("error");
+        fireEvent.submit(container.querySelector("form"));
+        expect(submitAuthDict).toHaveBeenCalledTimes(2);
+    });
+});
