+def match_current_rt(rt, direction, current, rt_commands):
+    """Append the command needed for one route-target direction."""
+    command = 'route-target %s %s' % (direction, rt['rt'])
+    present = command in [line.strip() for line in (current or '').splitlines()]
+    if rt['state'] == 'present' and not present and command not in rt_commands:
+        rt_commands.append(command)
+    elif rt['state'] == 'absent' and present and 'no ' + command not in rt_commands:
+        rt_commands.append('no ' + command)
+    return rt_commands
+
+
