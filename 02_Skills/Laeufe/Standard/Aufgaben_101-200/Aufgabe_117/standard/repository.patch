+def _get_locale_pak_path(locales_dir: pathlib.Path, locale: str) -> pathlib.Path:
+    """Return the QtWebEngine resource path for a locale."""
+    return locales_dir / (locale.replace('_', '-') + '.pak')
+
+
+def _get_lang_override(
+        versions: version.WebEngineVersions,
+        locale: str,
+        locales_dir: Optional[pathlib.Path] = None,
+) -> Optional[str]:
+    """Find a Chromium locale to use when QtWebEngine cannot load the system one."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    if locales_dir is None:
+        locales_dir = (pathlib.Path(QLibraryInfo.location(QLibraryInfo.TranslationsPath)) /
+                       'qtwebengine_locales')
+
+    locale = locale.replace('_', '-').split('.', maxsplit=1)[0]
+    if _get_locale_pak_path(locales_dir, locale).is_file():
+        return None
+
+    language = locale.split('-', maxsplit=1)[0]
+    if language == 'en':
+        candidate = 'en-US' if locale in ('en', 'en-LR', 'en-PH', 'en-US') else 'en-GB'
+    elif language == 'es':
+        candidate = 'es' if locale in ('es', 'es-ES') else 'es-419'
+    elif language == 'pt':
+        candidate = 'pt-PT' if locale == 'pt-PT' else 'pt-BR'
+    elif language == 'zh':
+        candidate = 'zh-TW' if locale in ('zh-TW', 'zh-HK', 'zh-MO') else 'zh-CN'
+    else:
+        candidate = language
+
+    for fallback in (candidate, language, 'en-US'):
+        if _get_locale_pak_path(locales_dir, fallback).is_file():
+            return fallback
+    return 'en-US'
+
+
