@@ -0,0 +1,19 @@
+import { render } from '@testing-library/react';
+import { format, fromUnixTime } from 'date-fns';
+
+import { subscriptionMock, upcomingSubscriptionMock } from '@proton/testing/data';
+
+import { ExpirationTime as B2BExpirationTime } from './b2bCommonConfig';
+import { ExpirationTime as B2CExpirationTime } from './b2cCommonConfig';
+
+const subscription = { ...subscriptionMock, UpcomingSubscription: upcomingSubscriptionMock };
+
+it.each([
+    ['B2C', B2CExpirationTime, { cancellablePlan: true }],
+    ['B2B', B2BExpirationTime, { isChargeBeeUser: true }],
+])('%s cancellation confirmation displays the active term end date', (_name, ExpirationTime, props) => {
+    const { container } = render(<ExpirationTime subscription={subscription} {...props} />);
+
+    expect(container).toHaveTextContent(format(fromUnixTime(subscriptionMock.PeriodEnd), 'PP'));
+    expect(container).not.toHaveTextContent(format(fromUnixTime(upcomingSubscriptionMock.PeriodEnd), 'PP'));
+});
