+
+
+def test_reply_decision():
+    reply = mock.Mock()
+    errors = [FakeError('Certificate invalid')]
+    wrapper = certificateerror.CertificateErrorWrapper(reply=reply, errors=errors)
+
+    assert reply.mock_calls == []
+    assert not wrapper.certificate_was_accepted()
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    with pytest.raises(usertypes.UndeferrableError):
+        wrapper.defer()
+
+    positional = certificateerror.CertificateErrorWrapper(reply, errors)
+    assert positional.html() == '<p>Certificate invalid</p>'
