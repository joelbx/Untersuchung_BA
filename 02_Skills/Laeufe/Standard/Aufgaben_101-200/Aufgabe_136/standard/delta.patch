+class UndeferrableError(NotImplementedError):
+
+    """Raised when a certificate decision cannot be deferred."""
+
+
 class AbstractCertificateErrorWrapper:
 
     """A wrapper over an SSL/certificate error."""
 
+    def __init__(self) -> None:
+        self._certificate_accepted = False
+
+    def accept_certificate(self) -> None:
+        """Mark the certificate as accepted."""
+        self._certificate_accepted = True
+
+    def reject_certificate(self) -> None:
+        """Mark the certificate as rejected."""
+        self._certificate_accepted = False
+
+    def defer(self) -> None:
+        """Defer the certificate decision, if supported."""
+        raise UndeferrableError
+
+    def certificate_was_accepted(self) -> bool:
+        return self._certificate_accepted
+
     def __str__(self) -> str:
         raise NotImplementedError
 
diff --git a/tests/unit/browser/webengine/test_webengine_certificateerror.py b/tests/unit/browser/webengine/test_webengine_certificateerror.py
new file mode 100644
index 0000000..00ad591
--- /dev/null
+++ b/tests/unit/browser/webengine/test_webengine_certificateerror.py
@@ -0,0 +1,36 @@
+"""Tests for WebEngine certificate error decisions."""
+
+from unittest import mock
+
+import pytest
+
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+@pytest.mark.parametrize('qt6', [False, True])
+def test_create_and_decisions(monkeypatch, qt6):
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', qt6)
+    error = mock.Mock()
+    wrapper = certificateerror.create(error)
+
+    cls = (certificateerror.CertificateErrorWrapperQt6 if qt6 else
+           certificateerror.CertificateErrorWrapperQt5)
+    assert isinstance(wrapper, cls)
+    assert not wrapper.certificate_was_accepted()
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+
+    if qt6:
+        error.acceptCertificate.assert_called_once_with()
+        error.rejectCertificate.assert_called_once_with()
+        wrapper.defer()
+        error.defer.assert_called_once_with()
+    else:
+        assert not wrapper.ignore
+        wrapper.ignore = True
+        assert wrapper.certificate_was_accepted()
+        with pytest.raises(usertypes.UndeferrableError):
+            wrapper.defer()
