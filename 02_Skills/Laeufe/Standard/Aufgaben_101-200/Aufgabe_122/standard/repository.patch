diff --git a/internal/config/storage_test.go b/internal/config/storage_test.go
new file mode 100644
index 0000000..d38e3a4
--- /dev/null
+++ b/internal/config/storage_test.go
@@ -0,0 +1,23 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestStorageReadOnlyValidation(t *testing.T) {
+	for _, storageType := range []StorageType{LocalStorageType, GitStorageType, ObjectStorageType} {
+		for _, readOnly := range []bool{false, true} {
+			t.Run(string(storageType)+"/readOnly="+map[bool]string{false: "false", true: "true"}[readOnly], func(t *testing.T) {
+				cfg := StorageConfig{Type: storageType, ReadOnly: &readOnly}
+				require.EqualError(t, cfg.validate(), "setting read only mode is only supported with database storage")
+			})
+		}
+	}
+
+	for _, readOnly := range []bool{false, true} {
+		cfg := StorageConfig{Type: DatabaseStorageType, ReadOnly: &readOnly}
+		require.NoError(t, cfg.validate())
+	}
+}
