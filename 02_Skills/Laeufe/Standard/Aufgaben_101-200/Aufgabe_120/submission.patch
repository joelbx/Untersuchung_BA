+class Batch:
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id = item_id, batch_id
+        self.size = _size(size) if size is not None else None
+        self._norm_ids()
+
+    def _norm_ids(self):
+        item_id, batch_id = int(self.item_id), int(self.batch_id)
+        if not 0 <= item_id <= 9999 or not 0 <= batch_id <= 99:
+            raise ValueError('batch ID out of range')
+        return f'{item_id:04d}', f'{batch_id:02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = cls(item_id, batch_id, size)._norm_ids()
+        if not re.fullmatch('[A-Za-z0-9]+', ext):
+            raise ValueError('invalid batch extension')
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        return os.path.join('items', item, f'{item}_{batch_id}.{ext}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    @property
+    def start_id(self):
+        item_id, batch_id = self._norm_ids()
+        return int(item_id) * 1_000_000 + int(batch_id) * 10_000
+
+    def item_name(self, size):
+        item_id, _ = self._norm_ids()
+        prefix = f'{size}_' if size else ''
+        return f'{prefix}covers_{item_id}'
+
+    @contextlib.contextmanager
+    def lock(self):
+        item_id, batch_id = self._norm_ids()
+        root = os.path.join(config.data_root, 'items', '.locks')
+        os.makedirs(root, exist_ok=True)
+        with open(os.path.join(root, f'{item_id}_{batch_id}.lock'), 'a+b') as lockfile:
+            fcntl.flock(lockfile, fcntl.LOCK_EX)
+            try:
+                yield
+            finally:
+                fcntl.flock(lockfile, fcntl.LOCK_UN)
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        uploader = uploader or Uploader()
+        sizes = SIZES if self.size is None else (self.size,)
+        with self.lock():
+            # Finalized batches have had their staging zips removed. Retrying
+            # completion must still report success without uploading again.
+            if (self.size is None
+                    and not any(os.path.isfile(self.get_abspath(self.item_id, self.batch_id, size))
+                                for size in SIZES)
+                    and CoverDB().is_completed(self.start_id)):
+                return True
+            verified = True
+            for size in sizes:
+                path = self.get_abspath(self.item_id, self.batch_id, size)
+                if not os.path.isfile(path) or not zipfile.is_zipfile(path):
+                    verified = False
+                    continue
+                item = self.item_name(size)
+                present = uploader.is_uploaded(item, os.path.basename(path))
+                if upload and not present and not test:
+                    uploader.upload(item, [path])
+                    present = uploader.is_uploaded(item, os.path.basename(path))
+                verified = verified and present
+            if finalize and verified and self.size is None and not test:
+                self.finalize()
+            return verified
+
+    def finalize(self, start_id=None, test=False):
+        if test:
+            return
+        if start_id is not None and start_id != self.start_id:
+            raise ValueError('start ID differs from batch')
+        CoverDB.update_completed_batch(self.item_id, self.batch_id)
+        for size in SIZES:
+            path = self.get_abspath(self.item_id, self.batch_id, size)
+            if os.path.exists(path):
+                os.remove(path)
