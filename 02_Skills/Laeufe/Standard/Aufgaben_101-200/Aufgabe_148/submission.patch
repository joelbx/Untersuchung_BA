+func TestTeleportProxySSH(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		header     string
+		wantRemote string
+	}{
+		{name: "client address", header: "Teleport-Proxy{\"ClientAddr\":\"192.0.2.10:4321\",\"Trace\":\"example\"}\x00", wantRemote: "192.0.2.10:4321"},
+		{name: "empty metadata", header: "Teleport-Proxy{}\x00"},
+		{name: "colon separator", header: "Teleport-Proxy: {\"ClientAddr\":\"[2001:db8::1]:2222\"}\x00", wantRemote: "[2001:db8::1]:2222"},
+		{name: "standard SSH"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			mux, err := New(Config{Listener: listener})
+			require.NoError(t, err)
+			sshListener := mux.SSH()
+			go mux.Serve()
+			defer mux.Close()
+
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			_, err = io.WriteString(client, tt.header+"SSH-2.0-test\r\n")
+			require.NoError(t, err)
+			server, err := sshListener.Accept()
+			require.NoError(t, err)
+			defer server.Close()
+			require.Equal(t, ProtoSSH, server.(*Conn).Protocol())
+			wantRemote := tt.wantRemote
+			if wantRemote == "" {
+				wantRemote = client.LocalAddr().String()
+			}
+			require.Equal(t, wantRemote, server.RemoteAddr().String())
+			banner := make([]byte, len("SSH-2.0-test\r\n"))
+			_, err = io.ReadFull(server, banner)
+			require.NoError(t, err)
+			require.Equal(t, "SSH-2.0-test\r\n", string(banner))
+		})
+	}
+}
+
+func TestTeleportProxyMalformedHeader(t *testing.T) {
+	for _, header := range []string{
+		"Teleport-Proxy{bad}\x00",
+		"Teleport-Proxy{\"ClientAddr\":\"not-an-address\"}\x00",
+		"Teleport-Proxy{}",
+	} {
+		t.Run(header, func(t *testing.T) {
+			reader := bufio.NewReader(bytes.NewBufferString(header))
+			_, err := readTeleportProxyHeader(reader)
+			require.Error(t, err)
+		})
+	}
+}
