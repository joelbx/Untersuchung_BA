+
+// readTeleportProxyHeader consumes the metadata header, leaving the SSH banner
+// as the next bytes in reader. The header is bounded so a peer cannot keep an
+// arbitrarily large amount of metadata in memory.
+func readTeleportProxyHeader(reader *bufio.Reader) (net.Addr, error) {
+	const maxHeaderSize = 64 * 1024
+	header := make([]byte, 0, 256)
+	for len(header) < maxHeaderSize {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport-Proxy header")
+		}
+		if b == 0 {
+			break
+		}
+		header = append(header, b)
+	}
+	if len(header) == maxHeaderSize {
+		return nil, trace.BadParameter("Teleport-Proxy header is too large")
+	}
+	if !bytes.HasPrefix(header, teleportProxyPrefix) {
+		return nil, trace.BadParameter("invalid Teleport-Proxy header")
+	}
+	payload := strings.TrimSpace(string(header[len(teleportProxyPrefix):]))
+	payload = strings.TrimSpace(strings.TrimPrefix(payload, ":"))
+	var metadata struct {
+		ClientAddr string
+	}
+	if err := json.Unmarshal([]byte(payload), &metadata); err != nil {
+		return nil, trace.BadParameter("invalid Teleport-Proxy metadata: %v", err)
+	}
+	if metadata.ClientAddr == "" {
+		return nil, nil
+	}
+	host, port, err := net.SplitHostPort(metadata.ClientAddr)
+	if err != nil {
+		return nil, trace.BadParameter("invalid ClientAddr: %v", err)
+	}
+	ip := net.ParseIP(host)
+	if ip == nil {
+		return nil, trace.BadParameter("invalid ClientAddr IP %q", host)
+	}
+	portNumber, err := parsePortNumber(port)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &net.TCPAddr{IP: ip, Port: portNumber}, nil
+}
