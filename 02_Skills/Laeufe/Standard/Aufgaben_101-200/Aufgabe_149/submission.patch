+    @pytest.mark.parametrize('enable_source', ['commandline', 'config'])
+    @pytest.mark.parametrize('disable_source', ['commandline', 'config'])
+    @pytest.mark.parametrize('overlay', [True, False])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch, parser,
+                                         enable_source, disable_source, overlay):
+        monkeypatch.setattr(qtargs.objects, 'backend', usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+
+        flags = [
+            ('enable-features=First,Second', enable_source),
+            ('disable-features=Blocked,AlsoBlocked', disable_source),
+            ('enable-features=Third', enable_source),
+            ('disable-features=AnotherBlocked', disable_source),
+        ]
+        commandline = [item for flag, source in flags if source == 'commandline'
+                       for item in ('--qt-flag', flag)]
+        config_stub.val.qt.args = [flag for flag, source in flags
+                                   if source == 'config']
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+        enabled = [arg for arg in args
+                   if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        expected = 'First,Second,Third' + (',OverlayScrollbar' if overlay else '')
+        assert enabled == [qtargs.ENABLE_FEATURES_PREFIX + expected]
+        assert [arg for arg in args
+                if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)] == [
+                    '--disable-features=Blocked,AlsoBlocked',
+                    '--disable-features=AnotherBlocked',
+                ]
+
+    @pytest.mark.parametrize('source', ['commandline', 'config'])
+    def test_only_disable_features(self, config_stub, monkeypatch, parser, source):
+        monkeypatch.setattr(qtargs.objects, 'backend', usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        flag = 'disable-features=Blocked,AlsoBlocked'
+        config_stub.val.qt.args = [flag] if source == 'config' else []
+        commandline = ['--qt-flag', flag] if source == 'commandline' else []
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+
+        assert '--disable-features=Blocked,AlsoBlocked' in args
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+
