+package cmd
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+var backupFile string
+var backupForce bool
+
+func init() {
+	backupCmd.AddCommand(backupCreateCmd, backupPruneCmd, backupRestoreCmd)
+	backupPruneCmd.Flags().BoolVarP(&backupForce, "force", "f", false, "skip confirmation")
+	backupRestoreCmd.Flags().BoolVarP(&backupForce, "force", "f", false, "skip confirmation")
+	backupRestoreCmd.Flags().StringVar(&backupFile, "backup-file", "", "SQLite backup file to restore")
+	_ = backupRestoreCmd.MarkFlagRequired("backup-file")
+	rootCmd.AddCommand(backupCmd)
+}
+
+var backupCmd = &cobra.Command{Use: "backup", Short: "Manage database backups"}
+
+var backupCreateCmd = &cobra.Command{
+	Use: "create", Short: "Create a database backup", Args: cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		path, err := db.Db().Backup(cmd.Context())
+		if err == nil {
+			fmt.Fprintln(cmd.OutOrStdout(), path)
+		}
+		return err
+	},
+}
+
+var backupPruneCmd = &cobra.Command{
+	Use: "prune", Short: "Delete old database backups", Args: cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		if conf.Server.Backup.Count == 0 && !backupForce {
+			if !confirmBackup(cmd, "Delete all database backups? [y/N]: ") {
+				return errors.New("backup pruning cancelled")
+			}
+		}
+		count, err := db.Db().Prune(cmd.Context())
+		if err == nil {
+			fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backups\n", count)
+		}
+		return err
+	},
+}
+
+var backupRestoreCmd = &cobra.Command{
+	Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		if !backupForce && !confirmBackup(cmd, "Replace the current database with this backup? [y/N]: ") {
+			return errors.New("database restore cancelled")
+		}
+		if err := db.Db().Restore(cmd.Context(), backupFile); err != nil {
+			return err
+		}
+		fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+		return nil
+	},
+}
+
+func confirmBackup(cmd *cobra.Command, prompt string) bool {
+	fmt.Fprint(cmd.ErrOrStderr(), prompt)
+	line, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	answer := strings.TrimSpace(line)
+	return err == nil && (strings.EqualFold(answer, "y") || strings.EqualFold(answer, "yes"))
+}
