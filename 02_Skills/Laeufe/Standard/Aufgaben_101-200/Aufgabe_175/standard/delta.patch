diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..1ee2377
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,171 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupSuffix = ".db"
+
+// Backup creates a consistent snapshot of the live SQLite database.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup.path is empty")
+	}
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return "", err
+	}
+	tmp, err := os.CreateTemp(dir, ".navidrome_backup_*.tmp")
+	if err != nil {
+		return "", err
+	}
+	tmpPath := tmp.Name()
+	if err = tmp.Close(); err != nil {
+		_ = os.Remove(tmpPath)
+		return "", err
+	}
+	defer os.Remove(tmpPath)
+	dest, err := sql.Open(Driver, tmpPath)
+	if err != nil {
+		return "", err
+	}
+	defer dest.Close()
+	if err = copySQLite(ctx, dest, d.writeDB); err != nil {
+		return "", fmt.Errorf("backing up database: %w", err)
+	}
+	// Close the SQLite handle before renaming, so all writes have reached the file.
+	if err = dest.Close(); err != nil {
+		return "", err
+	}
+	name := fmt.Sprintf("%s%s%s", backupPrefix, time.Now().UTC().Format("20060102T150405.000000000Z"), backupSuffix)
+	path := filepath.Join(dir, name)
+	if err = os.Rename(tmpPath, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+// Restore replaces the current database contents from a SQLite backup.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("backup file must be a regular file")
+	}
+	if live, err := os.Stat(conf.Server.DbPath); err == nil && os.SameFile(info, live) {
+		return errors.New("backup file is the live database")
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	src, err := sql.Open(Driver, (&url.URL{Scheme: "file", Path: absPath, RawQuery: "mode=ro"}).String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var result string
+	if err = src.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("invalid backup: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("invalid backup: integrity_check: %s", result)
+	}
+	if err = copySQLite(ctx, d.writeDB, src); err != nil {
+		return fmt.Errorf("restoring database: %w", err)
+	}
+	return nil
+}
+
+// copySQLite uses the SQLite online backup API, including for restores.
+func copySQLite(ctx context.Context, dest, src *sql.DB) error {
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	return destConn.Raw(func(rawDest interface{}) error {
+		return srcConn.Raw(func(rawSrc interface{}) error {
+			b, err := rawDest.(*sqlite3.SQLiteConn).Backup("main", rawSrc.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = b.Finish()
+					return err
+				}
+				done, err := b.Step(128)
+				if err != nil {
+					_ = b.Finish()
+					return err
+				}
+				if done {
+					return b.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+// prune removes only Navidrome backup files, ordered by their timestamped names.
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count must be non-negative")
+	}
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is empty")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.Type().IsRegular() && strings.HasPrefix(name, backupPrefix) && strings.HasSuffix(name, backupSuffix) {
+			stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), backupSuffix)
+			if _, err := time.Parse("20060102T150405.000000000Z", stamp); err == nil {
+				names = append(names, name)
+			}
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
new file mode 100644
index 0000000..7bf0447
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,85 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	ctx := context.Background()
+	previousBackup := conf.Server.Backup
+	previousPath := conf.Server.DbPath
+	t.Cleanup(func() {
+		conf.Server.Backup = previousBackup
+		conf.Server.DbPath = previousPath
+	})
+	dir := t.TempDir()
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 1
+	conf.Server.DbPath = filepath.Join(dir, "live.db")
+	live, err := sql.Open(Driver, conf.Server.DbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: live, writeDB: live}
+	first, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := live.Exec("UPDATE items SET value='after'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup paths must be unique")
+	}
+	if err := d.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := live.QueryRow("SELECT value FROM items").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "before" {
+		t.Fatalf("restored value = %q", value)
+	}
+	removed, err := d.Prune(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if removed != 1 {
+		t.Fatalf("pruned %d files", removed)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("old backup still exists: %v", err)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(conf.Server.Backup.Path, "unrelated.db"), []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	conf.Server.Backup.Count = 0
+	removed, err = d.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("prune all: removed=%d, err=%v", removed, err)
+	}
+	if _, err := os.Stat(filepath.Join(conf.Server.Backup.Path, "unrelated.db")); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(ctx, conf.Server.DbPath); err == nil {
+		t.Fatal("restoring the live database should fail")
+	}
+}
