+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		backup := conf.Server.Backup
+		if backup.Path == "" || backup.Schedule == "" || backup.Count == 0 {
+			log.Info("Periodic database backup is disabled")
+			return nil
+		}
+		log.Info("Scheduling periodic database backup", "schedule", backup.Schedule)
+		return scheduler.GetInstance().Add(backup.Schedule, func() {
+			path, err := db.Db().Backup(ctx)
+			if err != nil {
+				log.Error("Error creating scheduled database backup", err)
+				return
+			}
+			log.Info("Created scheduled database backup", "path", path)
+			if count, err := db.Db().Prune(ctx); err != nil {
+				log.Error("Error pruning database backups", err)
+			} else {
+				log.Debug("Pruned database backups", "count", count)
+			}
+		})
+	}
+}
