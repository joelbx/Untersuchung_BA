+    def get_locally_reachable_ips(self, ip_path):
+        """Return scope-host routes, including host addresses and prefixes."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, flag in (('ipv4', '-4'), ('ipv6', '-6')):
+            if family == 'ipv6' and not socket.has_ipv6:
+                continue
+
+            try:
+                rc, output, _ = self.module.run_command(
+                    [ip_path, flag, 'route', 'show', 'table', 'all', 'scope', 'host'],
+                    errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Cannot collect locally reachable %s routes' % family)
+                continue
+
+            entries = set()
+            for line in output.splitlines():
+                words = line.split()
+                if not words or words[0] in ('broadcast', 'anycast', 'multicast',
+                                             'blackhole', 'unreachable', 'prohibit',
+                                             'throw', 'nat'):
+                    continue
+                destination = words[1] if words[0] == 'local' and len(words) > 1 else words[0]
+                try:
+                    network = ipaddress.ip_network(destination, strict=False)
+                except ValueError:
+                    continue
+                if network.version != (4 if family == 'ipv4' else 6):
+                    continue
+                entries.add(network)
+
+            reachable[family] = [
+                str(network.network_address) if network.prefixlen == network.max_prefixlen else str(network)
+                for network in sorted(entries, key=lambda network: (int(network.network_address), network.prefixlen))
+            ]
+        return reachable
