index 0bba41b..edca7b6 100644
--- a/test/units/plugins/connection/test_ssh.py
+++ b/test/units/plugins/connection/test_ssh.py
@@ -34,6 +34,42 @@ from ansible.plugins.connection import ssh
 from ansible.plugins.loader import connection_loader, become_loader
 
 
+def _clixml_error(message: bytes) -> bytes:
+    return b'#< CLIXML\r\n<Objs Version="1.1"><S S="Error">' + message + b'</S></Objs>'
+
+
+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain\r\n', b'plain\r\n'),
+    (_clixml_error(b'failure'), b'failure'),
+    (b'before\r\n' + _clixml_error(b'failure') + b' trailing\r\nafter', b'before\r\nfailure trailing\r\nafter'),
+    (_clixml_error(b'one') + b'\r\n' + _clixml_error(b'two'), b'one\r\ntwo'),
+    (b'#< CLIXML\r\n#< CLIXML\r\n<Objs Version="1.1"><S S="Error">repeated</S></Objs>', b'repeated'),
+    (b'#< CLIXML\r\n<Objs Version="1.1"><S S="Error">one</S></Objs>'
+     b'<Objs Version="1.1"><S S="Error">two</S></Objs>', b'one\r\ntwo'),
+    (b'\r\nCLIXML\r\n<Objs Version="1.1"><S S="Error">bare</S></Objs>tail', b'baretail'),
+    (b'#< CLIXML\r\n<Objs Version="1.1">\r\n<S S="Error">split</S>\r\n</Objs>end', b'splitend'),
+    (_clixml_error(b'caf\x82'), 'café'.encode()),
+    (b'before ' + _clixml_error(b'broken')[:-7], b'before ' + _clixml_error(b'broken')[:-7]),
+    (_clixml_error(b'broken').replace(b'</S>', b'</T>'), _clixml_error(b'broken').replace(b'</S>', b'</T>')),
+    (_clixml_error(b'broken').replace(b'</S>', b'</T>') + _clixml_error(b'good'),
+     _clixml_error(b'broken').replace(b'</S>', b'</T>') + b'good'),
+    (b'#< CLIXML\n<Objs Version="1.1"><S S="Error">split header</S></Objs>',
+     b'#< CLIXML\n<Objs Version="1.1"><S S="Error">split header</S></Objs>'),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_exec_command_replaces_windows_stderr():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn._shell = MagicMock(_IS_WINDOWS=True)
+    conn._build_command = MagicMock(return_value='ssh command')
+    conn._run = MagicMock(return_value=(1, b'', b'prefix ' + _clixml_error(b'failure') + b' suffix'))
+    conn.get_option = MagicMock(return_value='host')
+
+    assert conn.exec_command('command') == (1, b'', b'prefix failure suffix')
+
+
