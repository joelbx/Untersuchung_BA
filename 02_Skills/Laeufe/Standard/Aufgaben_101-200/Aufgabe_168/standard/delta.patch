+interface IAdminActionLock {
+    pending: boolean;
+    run(action: () => Promise<void>, errorTitle: string, errorDescription: string): Promise<void>;
+}
+
+const AdminActionLockContext = React.createContext<IAdminActionLock | null>(null);
+
+function useAdminActionLock(): IAdminActionLock {
+    const inFlight = useRef(false);
+    const [pending, setPending] = useState(false);
+    const run = useCallback(async (action: () => Promise<void>, errorTitle: string, errorDescription: string) => {
+        // The ref closes the gap before React renders the disabled buttons.
+        if (inFlight.current) return;
+        inFlight.current = true;
+        setPending(true);
+        try {
+            await action();
+        } catch (err) {
+            logger.error(errorDescription, err);
+            Modal.createDialog(ErrorDialog, {
+                title: errorTitle,
+                description: err instanceof Error && err.message ? err.message : errorDescription,
+            });
+        } finally {
+            inFlight.current = false;
+            setPending(false);
+        }
+    }, []);
+    return { pending, run };
+}
+
+function useMemberAdminActionLock(): IAdminActionLock {
+    const shared = useContext(AdminActionLockContext);
+    const local = useAdminActionLock();
+    return shared ?? local;
+}
