 from __future__ import print_function
 import os
+from types import SimpleNamespace
 import pytest
+import requests
 from openlibrary.catalog import get_ia
 from openlibrary.core import ia
 from openlibrary.catalog.marc.marc_xml import MarcXml
@@ -18,7 +20,97 @@ def return_test_marc_data(url, test_data_subdir="xml_input"):
     filename = url.split('/')[-1]
     test_data_dir = "/../../catalog/marc/tests/test_data/%s/" % test_data_subdir
     path = os.path.dirname(__file__) + test_data_dir + filename
-    return open(path, mode='rb')
+    with open(path, mode='rb') as source:
+        return SimpleNamespace(content=source.read())
+
+
+def make_response(status=200, content=b'', content_type='application/octet-stream'):
+    response = requests.Response()
+    response.status_code = status
+    response._content = content
+    response.headers['Content-Type'] = content_type
+    response.encoding = requests.utils.get_encoding_from_headers(response.headers)
+    return response
+
+
+def test_urlopen_keep_trying_passes_options_and_defaults_to_utf8(monkeypatch):
+    calls = []
+
+    def get(url, **kwargs):
+        calls.append((url, kwargs))
+        return make_response(content='café'.encode('utf-8'), content_type='text/plain')
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    response = get_ia.urlopen_keep_trying('https://example.org/data', headers={'X-Test': 'yes'}, timeout=3)
+    assert calls == [('https://example.org/data', {'headers': {'X-Test': 'yes'}, 'timeout': 3})]
+    assert response.content == 'café'.encode('utf-8')
+    assert response.text == 'café'
+
+
+def test_urlopen_keep_trying_honors_server_charset(monkeypatch):
+    monkeypatch.setattr(get_ia.requests, 'get', lambda *args, **kwargs: make_response(
+        content=b'caf\xe9', content_type='text/plain; charset=iso-8859-1'
+    ))
+    assert get_ia.urlopen_keep_trying('https://example.org/data').text == 'café'
+
+
+@pytest.mark.parametrize('status', [403, 404, 416])
+def test_urlopen_keep_trying_raises_permanent_http_errors(monkeypatch, status):
+    calls = []
+
+    def get(*args, **kwargs):
+        calls.append(1)
+        return make_response(status=status)
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    with pytest.raises(requests.exceptions.HTTPError) as error:
+        get_ia.urlopen_keep_trying('https://example.org/data')
+    assert error.value.response.status_code == status
+    assert len(calls) == 1
+
+
+def test_urlopen_keep_trying_retries_http_and_connection_errors(monkeypatch):
+    responses = [make_response(status=500), requests.exceptions.ConnectionError(), make_response(content=b'ok')]
+
+    def get(*args, **kwargs):
+        result = responses.pop(0)
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    sleeps = []
+    monkeypatch.setattr(get_ia, 'sleep', sleeps.append)
+    assert get_ia.urlopen_keep_trying('https://example.org/data').content == b'ok'
+    assert sleeps == [2, 2]
+
+
+def test_get_from_archive_bulk_uses_range_and_truncates_content(monkeypatch):
+    calls = []
+
+    def get(url, headers=None, **kwargs):
+        calls.append((url, headers))
+        return make_response(content=b'00010abcde00007' + b'extra')
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    monkeypatch.setattr(get_ia, 'MAX_MARC_LENGTH', 15)
+    assert get_ia.get_from_archive_bulk('item/file:20:10') == (b'00010abcde', 30, 7)
+    assert calls == [(get_ia.IA_DOWNLOAD_URL + 'item/file', {'Range': 'bytes=20-34'})]
+
+
+def test_files_parses_response_content_and_retries_malformed_xml(monkeypatch):
+    responses = [b'<files', b'<files><file name="records.mrc"><size>42</size></file></files>']
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', lambda url: SimpleNamespace(content=responses.pop(0)))
+    sleeps = []
+    monkeypatch.setattr(get_ia, 'sleep', sleeps.append)
+    assert list(get_ia.files('item')) == [('records.mrc', 42)]
+    assert sleeps == [2]
+
+
+def test_marc_formats_parses_response_content(monkeypatch):
+    xml = b'<files><file name="item_marc.xml"/><file name="item_meta.mrc"/></files>'
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', lambda url: SimpleNamespace(content=xml))
+    assert get_ia.marc_formats('item') == {'xml': True, 'bin': True}
 
