@@ -0,0 +1,128 @@
+package dynamo
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/awserr"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbiface"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type billingModeDynamoMock struct {
+	dynamodbiface.DynamoDBAPI
+	createInput *dynamodb.CreateTableInput
+	describe    *dynamodb.DescribeTableOutput
+	describeErr error
+}
+
+func (m *billingModeDynamoMock) CreateTableWithContext(_ context.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingModeDynamoMock) WaitUntilTableExistsWithContext(context.Context, *dynamodb.DescribeTableInput, ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingModeDynamoMock) DescribeTableWithContext(context.Context, *dynamodb.DescribeTableInput, ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describe, m.describeErr
+}
+
+func TestBillingModeDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  string
+		valid bool
+	}{
+		{"", "pay_per_request", true},
+		{"pay_per_request", "pay_per_request", true},
+		{"provisioned", "provisioned", true},
+		{"invalid", "", false},
+	} {
+		cfg := Config{TableName: "test", BillingMode: tc.input}
+		err := cfg.CheckAndSetDefaults()
+		if !tc.valid {
+			require.Error(t, err)
+			continue
+		}
+		require.NoError(t, err)
+		require.Equal(t, tc.want, cfg.BillingMode)
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		mode       string
+		awsMode    string
+		throughput bool
+	}{
+		{"pay_per_request", dynamodb.BillingModePayPerRequest, false},
+		{"provisioned", dynamodb.BillingModeProvisioned, true},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			mock := &billingModeDynamoMock{}
+			b := &Backend{Entry: logrus.NewEntry(logrus.New()), Config: Config{
+				BillingMode: tc.mode, ReadCapacityUnits: 12, WriteCapacityUnits: 34,
+			}, svc: mock}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(mock.createInput.BillingMode))
+			if tc.throughput {
+				require.NotNil(t, mock.createInput.ProvisionedThroughput)
+				require.Equal(t, int64(12), aws.Int64Value(mock.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(34), aws.Int64Value(mock.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
+				require.Nil(t, mock.createInput.ProvisionedThroughput)
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		mock   billingModeDynamoMock
+		status tableStatus
+		mode   string
+	}{
+		{"on-demand", billingModeDynamoMock{describe: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+		}}}, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"provisioned", billingModeDynamoMock{describe: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)},
+		}}}, tableStatusOK, dynamodb.BillingModeProvisioned},
+		{"legacy", billingModeDynamoMock{describe: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}}, tableStatusOK, ""},
+		{"migration", billingModeDynamoMock{describe: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}},
+			BillingModeSummary:   &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+		}}}, tableStatusNeedsMigration, ""},
+		{"missing", billingModeDynamoMock{describeErr: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)}, tableStatusMissing, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &tc.mock}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.NoError(t, err)
+			require.Equal(t, tc.status, status)
+			require.Equal(t, tc.mode, mode)
+		})
+	}
+}
+
+func TestDisableAutoScaling(t *testing.T) {
+	for _, reason := range []string{"the table is on-demand", "the table will be on-demand"} {
+		t.Run(reason, func(t *testing.T) {
+			var output bytes.Buffer
+			logger := logrus.New()
+			logger.SetOutput(&output)
+			b := &Backend{Entry: logrus.NewEntry(logger), Config: Config{EnableAutoScaling: true}}
+			b.disableAutoScaling(reason)
+			require.False(t, b.EnableAutoScaling)
+			require.Contains(t, output.String(), "auto_scaling is ignored because "+reason)
+		})
+	}
+}
