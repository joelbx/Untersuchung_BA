+class TestFactsLinuxHardwareGetSysinfoFacts(unittest.TestCase):
+
+    def setUp(self):
+        self.hardware = linux.LinuxHardware(module=Mock(), load_on_init=False)
+
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False)
+    def test_absent_sysinfo(self, mock_exists):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {})
+        mock_exists.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM\n',
+        'Type: 3906\n',
+        'Sequence Code: 0000123456\n',
+        'Model: 296\n',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_sysinfo_fields(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '123456',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+        mock_lines.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=['Type: 3907\n'])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_missing_fields(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'NA',
+            'product_name': '3907',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_best_parsable_locale', return_value='C')
+    def test_populate_includes_sysinfo(self, mock_locale):
+        for method in ('get_cpu_facts', 'get_memory_facts', 'get_device_facts',
+                       'get_uptime_facts', 'get_lvm_facts', 'get_mount_facts'):
+            setattr(self.hardware, method, Mock(return_value={}))
+        self.hardware.get_dmi_facts = Mock(return_value={'product_serial': 'NA'})
+        self.hardware.get_sysinfo_facts = Mock(return_value={'product_serial': '123456'})
+
+        self.assertEqual(self.hardware.populate()['product_serial'], '123456')
+
