+@pytest.mark.parametrize('manifest_yaml, expected', [('', Sentinel), ('manifest: {}', {}), ('manifest: null', None)])
+def test_galaxy_yml_manifest_presence(tmp_path, manifest_yaml, expected):
+    galaxy_yml = tmp_path / 'galaxy.yml'
+    galaxy_yml.write_text('namespace: namespace\nname: collection\nauthors: Jordan\n'
+                          'version: 0.1.0\nreadme: README.md\n' + manifest_yaml)
+
+    actual = collection.concrete_artifact_manager._get_meta_from_src_dir(to_bytes(tmp_path))
+    if expected is Sentinel:
+        assert actual['manifest'] is Sentinel
+    else:
+        assert actual['manifest'] == expected
+
+
+@pytest.mark.parametrize('manifest_control', [{}, None])
+def test_empty_manifest_uses_directives(collection_input, monkeypatch, manifest_control):
+    input_dir = collection_input[0]
+    build_distlib = MagicMock(return_value={'format': 1, 'files': []})
+    monkeypatch.setattr(collection, '_build_files_manifest_distlib', build_distlib)
+
+    actual = collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', [], manifest_control)
+
+    assert actual == {'format': 1, 'files': []}
+    build_distlib.assert_called_once_with(to_bytes(input_dir), 'namespace', 'collection', {})
+
+    with pytest.raises(AnsibleError, match='mutually exclusive'):
+        collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', ['*.md'], manifest_control)
+
