+func TestAmazonLinuxVersionAndEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		version string
+		end     time.Time
+	}{
+		{"2018.03", "1", time.Date(2023, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"1", "1", time.Date(2023, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2 (Karoo)", "2", time.Date(2024, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2022", "2022", time.Date(2026, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2023 (Amazon Linux)", "2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2025", "2025", time.Date(2030, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2027", "2027", time.Date(2032, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2029", "2029", time.Date(2034, 6, 30, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.version {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.version)
+			}
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found || !eol.StandardSupportUntil.Equal(tt.end) {
+				t.Errorf("GetEOL(%q) = (%v, %v), want end %v", tt.release, eol, found, tt.end)
+			}
+			if eol.IsStandardSupportEnded(tt.end) || eol.IsExtendedSuppportEnded(tt.end) {
+				t.Error("support ended at the final supported second")
+			}
+			if !eol.IsStandardSupportEnded(tt.end.Add(time.Second)) || !eol.IsExtendedSuppportEnded(tt.end.Add(time.Second)) {
+				t.Error("support did not end after the final supported second")
+			}
+		})
+	}
+	for _, release := range []string{"", "2024", "2024 (Amazon Linux)", "bad", "2023.1"} {
+		if got := getAmazonLinuxVersion(release); got != "unknown" {
+			t.Errorf("getAmazonLinuxVersion(%q) = %q, want unknown", release, got)
+		}
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL(%q) unexpectedly found", release)
+		}
+	}
+}
+
+func TestEOLWithExtendedSupport(t *testing.T) {
+	standardEnd := time.Date(2030, 1, 1, 0, 0, 0, 0, time.UTC)
+	extendedEnd := standardEnd.Add(24 * time.Hour)
+	eol := EOL{StandardSupportUntil: standardEnd, ExtendedSupportUntil: extendedEnd}
+	if eol.IsStandardSupportEnded(standardEnd) || eol.IsExtendedSuppportEnded(standardEnd) {
+		t.Fatal("support ended on the standard support boundary")
+	}
+	if !eol.IsStandardSupportEnded(standardEnd.Add(time.Second)) || eol.IsExtendedSuppportEnded(standardEnd.Add(time.Second)) {
+		t.Fatal("incorrect support state during extended support")
+	}
+	if !eol.IsExtendedSuppportEnded(extendedEnd.Add(time.Second)) {
+		t.Fatal("extended support did not end")
+	}
+}
