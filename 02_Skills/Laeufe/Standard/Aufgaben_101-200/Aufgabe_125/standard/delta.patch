+describe('Topic backlinks', () => {
+	let uid;
+	let cid;
+	let target;
+	let source;
+	let originalSetting;
+
+	before(async () => {
+		originalSetting = meta.config.topicBacklinks;
+		uid = await user.create({ username: 'backlink-author', password: '123456' });
+		const category = await categories.create({ name: 'Backlink category' });
+		cid = category.cid;
+		target = await topics.post({ title: 'Backlink target', content: 'Target content', uid, cid });
+	});
+
+	after(() => {
+		meta.config.topicBacklinks = originalSetting;
+	});
+
+	it('rejects missing post data', async () => {
+		await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+	});
+
+	it('creates a backlink for an initial post and hides it while disabled', async () => {
+		const { tid } = target.topicData;
+		source = await topics.post({
+			title: 'Backlink source',
+			content: `See ${nconf.get('url')}/topic/${tid}/target and /topic/${tid}`,
+			uid,
+			cid,
+		});
+		const { pid } = source.postData;
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), [String(tid)]);
+		meta.config.topicBacklinks = 0;
+		assert.strictEqual((await topics.events.get(tid)).filter(event => event.type === 'backlink').length, 0);
+		meta.config.topicBacklinks = 1;
+		const backlinks = (await topics.events.get(tid)).filter(event => event.type === 'backlink');
+		assert.strictEqual(backlinks.length, 1);
+		assert.strictEqual(backlinks[0].href, `/post/${pid}`);
+		assert.strictEqual(Number(backlinks[0].uid), uid);
+		assert.strictEqual(backlinks[0].text, '[[topic:backlink]]');
+	});
+
+	it('removes stale references and ignores self and missing topics', async () => {
+		const post = { ...source.postData, content: `/topic/${source.topicData.tid} /topic/999999999` };
+		assert.strictEqual(await topics.syncBacklinks(post), 1);
+		assert.strictEqual(await topics.syncBacklinks(post), 0);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${post.pid}:backlinks`, 0, -1), []);
+		assert.strictEqual((await topics.events.get(target.topicData.tid)).filter(event => event.type === 'backlink').length, 0);
+	});
+
+	it('updates backlinks when a reply is edited', async () => {
+		const { tid } = target.topicData;
+		const reply = await topics.reply({
+			tid: source.topicData.tid,
+			uid,
+			content: 'This reply has no references',
+		});
+		await posts.edit({ pid: reply.pid, uid, content: `/topic/${tid}/target` });
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${reply.pid}:backlinks`, 0, -1), [String(tid)]);
+		await posts.edit({ pid: reply.pid, uid, content: 'The reference is gone now' });
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${reply.pid}:backlinks`, 0, -1), []);
+	});
+});
