+func TestUpdatePreservesFixState(t *testing.T) {
+	r := models.ScanResult{ScannedCves: models.VulnInfos{}}
+	def := defPacks{
+		def:           ovalmodels.Definition{Title: "RHSA-2024:1234: security update", Advisory: ovalmodels.Advisory{Cves: []ovalmodels.Cve{{CveID: "CVE-2024-1234"}}}},
+		binpkgFixstat: map[string]fixStat{"foo": {notFixedYet: true, fixState: "Fix deferred", fixedIn: "2.0"}},
+	}
+	NewRedhat(nil, "").update(&r, def)
+	v := r.ScannedCves["CVE-2024-1234"]
+	if len(v.AffectedPackages) != 1 || v.AffectedPackages[0] != (models.PackageFixStatus{Name: "foo", NotFixedYet: true, FixState: "Fix deferred", FixedIn: "2.0"}) {
+		t.Fatalf("unexpected package status: %+v", v.AffectedPackages)
+	}
+	if len(v.DistroAdvisories) != 1 || v.DistroAdvisories[0].AdvisoryID != "RHSA-2024:1234" {
+		t.Fatalf("unexpected advisories: %+v", v.DistroAdvisories)
+	}
+}
