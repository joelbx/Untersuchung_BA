+func TestConvertToDistroAdvisorySupportedTitles(t *testing.T) {
+	tests := []struct {
+		family, title, want string
+	}{
+		{"redhat", "RHSA-2024:1234: security update", "RHSA-2024:1234"},
+		{"centos", "RHBA-2024:1234: bug fix", "RHBA-2024:1234"},
+		{"oracle", "ELSA-2024-1234: security update", "ELSA-2024-1234"},
+		{"amazon", "ALAS2-2024-1234: security update", "ALAS2-2024-1234"},
+		{"fedora", "FEDORA-2024-1234 security update", "FEDORA-2024-1234"},
+		{"redhat", "CVE-2024-1234 affects foo", ""},
+		{"oracle", "RHSA-2024:1234 security update", ""},
+		{"amazon", "", ""},
+	}
+	for _, tt := range tests {
+		o := RedHatBase{Base: Base{family: tt.family}}
+		got := o.convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
+		if tt.want == "" {
+			if got != nil {
+				t.Errorf("%s %q: got advisory %+v", tt.family, tt.title, got)
+			}
+		} else if got == nil || got.AdvisoryID != tt.want {
+			t.Errorf("%s %q: got %+v, want %q", tt.family, tt.title, got, tt.want)
+		}
+	}
+}
