+// The query format uses one literal separator between columns. Keep empty
+// columns when splitting, while also accepting tab-separated RPM output.
+func rpmQueryFields(line string) []string {
+	return strings.Split(strings.ReplaceAll(strings.TrimSpace(line), "\t", " "), " ")
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if release != "" {
+		version += "-" + release
+	}
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	return version
+}
