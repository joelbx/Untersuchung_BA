+func TestEmptyReleaseRPMQueries(t *testing.T) {
+	for _, tc := range []struct {
+		name, line string
+		repo       bool
+		version    string
+		srcVersion string
+	}{
+		{"rpm zero epoch", "package 0 1.2  x86_64 package-1.2-.src.rpm", false, "1.2", "1.2"},
+		{"rpm nonzero epoch", "package 2 1.2  x86_64 package-1.2-.src.rpm", false, "2:1.2", "2:1.2"},
+		{"repoquery none epoch", "package (none) 1.2  x86_64 package-1.2-.src.rpm installed", true, "1.2", "1.2"},
+		{"repoquery nonzero epoch", "package 2 1.2  x86_64 package-1.2-.src.rpm installed", true, "2:1.2", "2:1.2"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var p *models.Package
+			var src *models.SrcPackage
+			var err error
+			if tc.repo {
+				p, src, err = o.parseInstalledPackagesLineFromRepoquery(tc.line)
+			} else {
+				p, src, err = o.parseInstalledPackagesLine(tc.line)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if p.Version != tc.version || p.Release != "" || p.Arch != "x86_64" || src == nil || src.Version != tc.srcVersion {
+				t.Fatalf("package = %+v, source = %+v", p, src)
+			}
+		})
+	}
+
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Alma, Release: "9"}, log: logging.NewIODiscardLogger()}}
+	packages, sources, err := o.parseInstalledPackages("package 0 1.2  x86_64 package-1.2-.src.rpm\n")
+	if err != nil || packages["package"].Release != "" || packages["package"].Arch != "x86_64" || sources["package"].Version != "1.2" {
+		t.Fatalf("packages = %+v, sources = %+v, err = %v", packages, sources, err)
+	}
+}
