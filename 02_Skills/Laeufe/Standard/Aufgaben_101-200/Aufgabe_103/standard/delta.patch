+func TestSplitFileNameVariants(t *testing.T) {
+	for _, tc := range []struct {
+		file, name, version, release, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src"},
+		{"package-0--src.rpm", "package", "0", "", "src"},
+		{"package-1.2-1-src.rpm", "package", "1.2", "1", "src"},
+		{"package-extra-0-1.src.rpm", "package-extra", "0", "1", "src"},
+	} {
+		name, version, release, _, arch, err := splitFileName(tc.file)
+		if err != nil || name != tc.name || version != tc.version || release != tc.release || arch != tc.arch {
+			t.Errorf("splitFileName(%q) = %q, %q, %q, %q, %v", tc.file, name, version, release, arch, err)
+		}
+	}
+	for _, file := range []string{"package-0-1-src", "package--1.src.rpm", "-0-1.src.rpm", "package-0-1-.rpm", "package-0-1.rpm", "package-0-1-.src.rpm/extra"} {
+		if _, _, _, _, _, err := splitFileName(file); err == nil {
+			t.Errorf("splitFileName(%q) unexpectedly succeeded", file)
+		}
+	}
+}
