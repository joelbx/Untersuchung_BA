+def _have_pip_module():
+    """Whether pip is importable by this Python interpreter."""
+    try:
+        try:
+            from importlib.util import find_spec
+        except ImportError:
+            from pkgutil import find_loader as find_spec
+        return find_spec('pip') is not None
+    except Exception:
+        return False
