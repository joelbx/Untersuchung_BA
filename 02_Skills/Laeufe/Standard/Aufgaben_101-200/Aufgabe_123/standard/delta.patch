diff --git a/packages/components/containers/notifications/notifications.spec.tsx b/packages/components/containers/notifications/notifications.spec.tsx
new file mode 100644
index 0000000..d472b81
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.spec.tsx
@@ -0,0 +1,74 @@
+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import createNotificationManager from './manager';
+import NotificationsContainer from './Container';
+import { NotificationOptions } from './interfaces';
+
+describe('notifications', () => {
+    it('renders safe HTML with secure links and preserves React content', () => {
+        const notifications: NotificationOptions[] = [
+            {
+                id: 1,
+                key: 'html',
+                type: 'error',
+                text: '<strong>Help</strong> <a href="https://example.com" target="_self" rel="opener">details</a><img src=x onerror="alert(1)"><script>alert(1)</script>',
+                isClosing: false,
+            },
+            {
+                id: 2,
+                key: 'element',
+                type: 'info',
+                text: <a href="https://example.org">React link</a>,
+                isClosing: false,
+            },
+        ];
+
+        const { container } = render(
+            <NotificationsContainer
+                notifications={notifications}
+                removeNotification={jest.fn()}
+                hideNotification={jest.fn()}
+            />
+        );
+
+        expect(screen.getByText('Help').tagName).toBe('STRONG');
+        expect(container.querySelector('script')).toBeNull();
+        expect(container.querySelector('img')?.hasAttribute('onerror')).toBe(false);
+        for (const link of screen.getAllByRole('link')) {
+            expect(link).toHaveAttribute('target', '_blank');
+            expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        }
+    });
+
+    it('deduplicates non-success notifications by explicit or derived key', () => {
+        jest.useFakeTimers();
+        let notifications: NotificationOptions[] = [];
+        const setNotifications = (update: React.SetStateAction<NotificationOptions[]>) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        };
+        const manager = createNotificationManager(setNotifications);
+
+        manager.createNotification({ text: 'same', type: 'error' });
+        manager.createNotification({ text: 'same', type: 'info' });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('same');
+        expect(notifications[0].type).toBe('info');
+
+        manager.createNotification({ text: 'first', key: 'shared', type: 'error' });
+        manager.createNotification({ text: <b>second</b>, key: 'shared', type: 'warning' });
+        expect(notifications).toHaveLength(2);
+        expect(notifications[1].key).toBe('shared');
+        expect(notifications[1].text).toEqual(<b>second</b>);
+
+        manager.createNotification({ text: <b>element</b>, type: 'error' });
+        manager.createNotification({ text: <b>element</b>, type: 'error' });
+        expect(notifications).toHaveLength(4);
+        expect(notifications[2].key).toBe(notifications[2].id);
+
+        manager.createNotification({ text: 'same', type: 'success' });
+        manager.createNotification({ text: 'same', type: 'success' });
+        expect(notifications).toHaveLength(6);
+        manager.clearNotifications();
+        jest.useRealTimers();
+    });
+});
