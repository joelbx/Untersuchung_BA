+def supplement_rec_with_import_item_metadata(
+    rec: dict[str, Any], identifier: str
+) -> None:
+    """Fill empty record fields from a staged or pending import item in place."""
+    from openlibrary.core.imports import ImportItem
+
+    try:
+        item = ImportItem.find_staged_or_pending([identifier]).first()
+        if not item:
+            return
+        metadata = json.loads(item.get('data', '{}'))
+        for field in (
+            'authors', 'publish_date', 'publishers', 'number_of_pages',
+            'physical_format', 'isbn_10', 'isbn_13', 'title',
+        ):
+            if not rec.get(field) and metadata.get(field):
+                rec[field] = metadata[field]
+    except Exception:
+        logger.exception('Failed to supplement import record for %s', identifier)
+
+
+def augment_incomplete_import_record(rec: dict) -> None:
+    """Enrich incomplete records when an ISBN-10 or Amazon ASIN is available."""
+    if is_incomplete_import_record(rec) and (
+        identifier := import_record_augmentation_identifier(rec)
+    ):
+        supplement_rec_with_import_item_metadata(rec, identifier)
+
