+def test_incomplete_import_augmented_before_validation(monkeypatch):
+    from openlibrary.core.imports import ImportItem
+
+    calls = []
+    class Result:
+        def first(self):
+            return {'data': json.dumps({
+                'title': 'Staged title', 'authors': [{'name': 'Staged author'}],
+                'publish_date': '2001', 'publishers': ['Staged publisher'],
+                'isbn_13': ['9781234567890'], 'number_of_pages': 200,
+                'physical_format': 'Paperback',
+            })}
+
+    def find(ids):
+        calls.append(ids)
+        return Result()
+
+    monkeypatch.setattr(ImportItem, 'find_staged_or_pending', find)
+    rec = {
+        'title': 'Original title', 'source_records': ['promise:1:sku'],
+        'isbn_10': ['123456789X'], 'identifiers': {'amazon': ['B123456789']},
+        'publishers': ['????'],
+    }
+    result = import_edition_builder(init_dict=rec).get_dict()
+    assert calls == [['123456789X']]
+    assert result['title'] == 'Original title'
+    assert result['authors'] == [{'name': 'Staged author'}]
+    assert result['publish_date'] == '2001'
+    assert result['publishers'] == ['Staged publisher']
+    assert result['isbn_13'] == ['9781234567890']
+    assert result['number_of_pages'] == 200
+    assert result['physical_format'] == 'Paperback'
+
+    import_edition_builder(init_dict={**result, 'publishers': []})
+    assert calls == [['123456789X']]
 
 
