+package commands
+
+import (
+	"flag"
+	"testing"
+
+	c "github.com/future-architect/vuls/config"
+)
+
+func TestReportWpIgnoreInactiveFlag(t *testing.T) {
+	previous := c.Conf
+	defer func() { c.Conf = previous }()
+	c.Conf = c.Config{}
+
+	flags := flag.NewFlagSet("report", flag.ContinueOnError)
+	(&ReportCmd{}).SetFlags(flags)
+	if err := flags.Parse([]string{"-wp-ignore-inactive"}); err != nil {
+		t.Fatal(err)
+	}
+	if !c.Conf.WpIgnoreInactive {
+		t.Fatal("-wp-ignore-inactive did not set configuration")
+	}
+}
