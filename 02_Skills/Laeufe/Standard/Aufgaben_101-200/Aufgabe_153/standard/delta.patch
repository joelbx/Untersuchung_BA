diff --git a/packages/drive-store/zustand/share/share.stores.test.ts b/packages/drive-store/zustand/share/share.stores.test.ts
new file mode 100644
index 0000000..eb060e6
--- /dev/null
+++ b/packages/drive-store/zustand/share/share.stores.test.ts
@@ -0,0 +1,59 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/utils/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (email: string) => ({ inviteeEmail: email }) as ShareInvitation;
+const externalInvitation = (email: string) => ({ inviteeEmail: email }) as ShareExternalInvitation;
+
+describe('share member stores', () => {
+    it('keeps members isolated and replaces only the selected share', () => {
+        const store = useMembersStore.getState();
+        const first = member('first@example.com');
+        const second = member('second@example.com');
+        expect(store.getMembers('unknown')).toEqual([]);
+
+        store.setMembers('first', [first]);
+        store.setMembers('second', [second]);
+        store.setMembers('first', []);
+
+        expect(store.getMembers('first')).toEqual([]);
+        expect(store.getMembers('second')).toEqual([second]);
+    });
+
+    it('keeps internal and external invitations isolated across shares', () => {
+        const store = useInvitationsStore.getState();
+        const first = invitation('first@example.com');
+        const second = invitation('second@example.com');
+        const externalFirst = externalInvitation('external-first@example.com');
+        const externalSecond = externalInvitation('external-second@example.com');
+        expect(store.getInvitations('unknown')).toEqual([]);
+        expect(store.getExternalInvitations('unknown')).toEqual([]);
+
+        store.setInvitations('first', [first]);
+        store.setExternalInvitations('first', [externalFirst]);
+        store.addMultipleInvitations('second', [second], [externalSecond]);
+        store.updateInvitationsPermissions('first', []);
+        store.removeExternalInvitations('first', []);
+        store.removeInvitations('first', [first]);
+        store.updateExternalInvitations('first', [externalFirst]);
+        store.setInvitations('first', []);
+        store.setExternalInvitations('first', []);
+
+        expect(store.getInvitations('first')).toEqual([]);
+        expect(store.getExternalInvitations('first')).toEqual([]);
+        expect(store.getInvitations('second')).toEqual([second]);
+        expect(store.getExternalInvitations('second')).toEqual([externalSecond]);
+    });
+
+    it('combines email addresses from all three lists', () => {
+        expect(
+            getExistingEmails(
+                [member('member@example.com')],
+                [invitation('internal@example.com')],
+                [externalInvitation('external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'internal@example.com', 'external@example.com']);
+    });
+});
