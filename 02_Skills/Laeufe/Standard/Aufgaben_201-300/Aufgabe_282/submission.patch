diff --git a/qutebrowser/config/configdata.yml b/qutebrowser/config/configdata.yml
index 220712e..b03201b 100644
--- a/qutebrowser/config/configdata.yml
+++ b/qutebrowser/config/configdata.yml
@@ -941,15 +941,20 @@ content.javascript.log:
     `error`.
 
 content.javascript.log_message:
+  renamed: content.javascript.log_message.levels
+
+content.javascript.log_message.levels:
   type:
     name: Dict
     keytype: String
     valtype:
       name: FlagList
       valid_values:
+        - debug: Show JS debug messages.
         - info: Show JS info as messages.
         - warning: Show JS warnings as messages.
         - error: Show JS errors as messages.
+    none_ok: true
   default:
     "qute:*": ["error"]
     "userscript:*": ["error"]
@@ -963,6 +968,24 @@ content.javascript.log_message:
     By default, errors happening in qutebrowser internally or in userscripts are
     shown to the user.
 
+content.javascript.log_message.excludes:
+  type:
+    name: Dict
+    keytype: String
+    valtype:
+      name: List
+      valtype: String
+    none_ok: true
+  default: {}
+  desc: >-
+    JavaScript messages to exclude from the qutebrowser UI.
+
+    When the message source matches a glob pattern in the key, messages
+    matching any of the glob patterns in the corresponding list are not shown
+    in the UI, even if enabled by `content.javascript.log_message.levels`.
+    Excluded messages are still written to the JavaScript log according to
+    `content.javascript.log`.
+
