@@ -0,0 +1,98 @@
+package app
+
+import (
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	for _, tc := range []struct {
+		peer, list string
+		want       bool
+	}{
+		{"192.0.2.10:1234", "bad, 192.0.2.0/24", true},
+		{"192.0.2.10:1234", "192.0.2.10:8080", true},
+		{"[2001:db8::1]:1234", "bad, 2001:db8::/32", true},
+		{"[2001:db8::1]:1234", "[2001:db8::1]:8080", true},
+		{"192.0.3.1:1234", "192.0.2.0/24", false},
+		{"192.0.2.10:1234", "", false},
+		{"@", "@", true},
+		{"@", "192.0.2.0/24", false},
+		{"192.0.2.10:1234", "@", false},
+	} {
+		if got := validateIPAgainstList(tc.peer, tc.list); got != tc.want {
+			t.Errorf("validateIPAgainstList(%q, %q) = %v, want %v", tc.peer, tc.list, got, tc.want)
+		}
+	}
+}
+
+func TestHandleLoginFromHeaders(t *testing.T) {
+	oldWhitelist, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() {
+		conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldWhitelist, oldHeader
+	}()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "X-Authenticated-User"
+	ds := &tests.MockDataStore{}
+	request := httptest.NewRequest("GET", "/", nil)
+	request.RemoteAddr = "192.0.3.1:1234"
+	request.Header.Set("X-Authenticated-User", "alice")
+	if got := handleLoginFromHeaders(ds, request); got != nil {
+		t.Fatal("untrusted peer received authentication")
+	}
+	request.RemoteAddr = "192.0.2.1:1234"
+	request.Header.Del("X-Authenticated-User")
+	if got := handleLoginFromHeaders(ds, request); got != nil {
+		t.Fatal("missing username received authentication")
+	}
+	request.Header.Set("X-Authenticated-User", "alice")
+	got := handleLoginFromHeaders(ds, request)
+	if got == nil || got["username"] != "alice" || got["isAdmin"] != true {
+		t.Fatalf("unexpected first user payload: %v", got)
+	}
+	if _, err := auth.Validate(got["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	user, err := ds.User(request.Context()).FindByUsername("alice")
+	if err != nil || user.LastLoginAt == nil {
+		t.Fatalf("last login was not updated: %v, %v", user, err)
+	}
+	request.Header.Set("X-Authenticated-User", "bob")
+	got = handleLoginFromHeaders(ds, request)
+	if got == nil || got["isAdmin"] != false {
+		t.Fatalf("second user should not be admin: %v", got)
+	}
+	if _, err := ds.User(request.Context()).FindByUsername("bob"); err == model.ErrNotFound {
+		t.Fatal("second user was not created")
+	}
+}
+
+func TestServeIndexDoesNotExposeAuthToUntrustedPeer(t *testing.T) {
+	oldWhitelist, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() {
+		conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldWhitelist, oldHeader
+	}()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{}
+	request := httptest.NewRequest("GET", "/index.html", nil)
+	request.RemoteAddr = "192.0.3.1:1234"
+	request.Header.Set("Remote-User", "alice")
+	w := httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(w, request)
+	if _, present := extractAppConfig(w.Body.String())["auth"]; present {
+		t.Fatal("auth must be absent for untrusted peer")
+	}
+	request.RemoteAddr = "192.0.2.1:1234"
+	w = httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(w, request)
+	if _, present := extractAppConfig(w.Body.String())["auth"]; !present {
+		t.Fatal("auth missing for trusted peer")
+	}
+}
