+// validateIPAgainstList only trusts the connection peer, never forwarded IP headers.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteAddr = host
+	}
+	ip := net.ParseIP(strings.Trim(remoteAddr, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		entry = strings.Trim(entry, "[]")
+		if _, network, err := net.ParseCIDR(entry); err == nil {
+			if network.Contains(ip) {
+				return true
+			}
+			continue
+		}
+		if allowed := net.ParseIP(entry); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for proxy login", countErr)
+			return nil
+		}
+		user = &model.User{
+			ID: uuid.NewString(), UserName: username, Name: username,
+			NewPassword: uuid.NewString(), IsAdmin: count == 0,
+		}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Creating proxy user", err)
+			return nil
+		}
+	} else if err != nil {
+		log.Error(r, "Finding proxy user", err)
+		return nil
+	}
+	if err = repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating proxy user login", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating proxy token", err)
+		return nil
+	}
+	salt := strings.ReplaceAll(uuid.NewString(), "-", "")[:6]
+	password := user.Password
+	if password == "" {
+		password = user.NewPassword
+	}
+	payload := map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token,
+		"subsonicSalt":  salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(password+salt))),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
