+package log
+
+import (
+	"testing"
+
+	"github.com/sirupsen/logrus"
+)
+
+func TestNestedMapRedaction(t *testing.T) {
+	h := &Hook{RedactionList: []string{`(jwt=)[^ ]+`}}
+	e := &logrus.Entry{Data: logrus.Fields{
+		"request": map[string]interface{}{
+			"nested": map[string]string{"token": "secret", "url": "jwt=abc next"},
+		},
+	}}
+	if err := h.Fire(e); err != nil {
+		t.Fatal(err)
+	}
+	request := e.Data["request"].(map[string]interface{})
+	nested := request["nested"].(map[string]interface{})
+	if nested["token"] != "[REDACTED]" || nested["url"] != "jwt=[REDACTED] next" {
+		t.Fatalf("unexpected redaction: %#v", nested)
+	}
+}
+
+func TestRedactValueStringifiesOtherTypes(t *testing.T) {
+	h := &Hook{RedactionList: []string{`(jwt=)[^ ]+`}}
+	e := &logrus.Entry{Data: logrus.Fields{"items": []string{"jwt=abc", "public"}}}
+	if err := h.Fire(e); err != nil {
+		t.Fatal(err)
+	}
+	if got := e.Data["items"]; got != "[jwt=[REDACTED] public]" {
+		t.Fatalf("unexpected redaction: %v", got)
+	}
+}
