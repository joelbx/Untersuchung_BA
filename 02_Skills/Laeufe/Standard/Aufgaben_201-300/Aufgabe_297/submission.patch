+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	if s, ok := value.(string); ok {
+		return re.ReplaceAllString(s, "$1[REDACTED]$2")
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map && v.Type().Key().Kind() == reflect.String {
+		redacted := make(map[string]interface{}, v.Len())
+		for _, key := range v.MapKeys() {
+			name := key.String()
+			if re.MatchString(name) || sensitiveField.MatchString(name) {
+				redacted[name] = "[REDACTED]"
+			} else {
+				redacted[name] = redactValue(v.MapIndex(key).Interface(), re)
+			}
+		}
+		return redacted
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
