diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..0a644b9
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,66 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		close(started)
+		<-ctx.Done()
+		<-release
+		close(finished)
+		return false, ctx.Err()
+	}, WithInterval(time.Millisecond))
+	go p.Poll()
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("polling did not start")
+	}
+
+	closed := make(chan struct{})
+	go func() {
+		defer close(closed)
+		if err := p.Close(); err != nil {
+			t.Errorf("Close: %v", err)
+		}
+	}()
+	select {
+	case <-closed:
+		t.Fatal("Close returned before update finished")
+	case <-p.ctx.Done():
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not return")
+	}
+	select {
+	case <-finished:
+	default:
+		t.Fatal("update still running after Close")
+	}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPollerCloseBeforePoll(t *testing.T) {
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		t.Fatal("unexpected update")
+		return false, nil
+	})
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+	p.Poll()
+}
