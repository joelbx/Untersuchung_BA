diff --git a/test/user/emails.js b/test/user/emails.js
index c99f47f..f067232 100644
--- a/test/user/emails.js
+++ b/test/user/emails.js
@@ -10,6 +10,8 @@ const helpers = require('../helpers');
 
 const user = require('../../src/user');
 const groups = require('../../src/groups');
+const meta = require('../../src/meta');
+const plugins = require('../../src/plugins');
 
 describe('email confirmation (v3 api)', () => {
 	let userObj;
@@ -104,4 +106,49 @@ describe('email confirmation (v3 api)', () => {
 		assert.deepStrictEqual(body, JSON.parse('{"status":{"code":"ok","message":"OK"},"response":{}}'));
 		await groups.leave('administrators', userObj.uid);
 	});
+
+	it('should use the live confirmation lifetime for resend eligibility and clear expired requests', async () => {
+		const expiry = meta.config.emailConfirmExpiry;
+		const interval = meta.config.emailConfirmInterval;
+		meta.config.emailConfirmExpiry = 1;
+		meta.config.emailConfirmInterval = 10;
+		plugins.hooks.register('email-expiry-test', {
+			hook: 'action:user.verify',
+			method: () => {},
+		});
+		try {
+			const uid = await user.create({ username: 'email-expiry-test', email: 'expiry@example.org' });
+			const email = 'expiry@example.org';
+			const marker = `confirm:byUid:${uid}`;
+			const code = await db.get(marker);
+			const expiryMs = 24 * 60 * 60 * 1000;
+			const intervalMs = 10 * 60 * 1000;
+
+			assert.strictEqual(await user.email.isValidationPending(uid), true);
+			assert.strictEqual(await user.email.isValidationPending(uid, email), true);
+			assert.strictEqual(await user.email.isValidationPending(uid, 'other@example.org'), false);
+			const ttl = await user.email.getValidationExpiry(uid);
+			assert(ttl > 0 && ttl <= expiryMs);
+			assert((await user.email.getValidationExpiry(uid)) <= ttl);
+			assert.strictEqual(await user.email.canSendValidation(uid, email), false);
+
+			await db.pexpireAt(marker, Date.now() + expiryMs - intervalMs + 1000);
+			assert.strictEqual(await user.email.canSendValidation(uid, email), false);
+			await db.pexpireAt(marker, Date.now() + expiryMs - intervalMs - 1000);
+			assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+
+			await user.email.expireValidation(uid);
+			assert.strictEqual(await db.getObject(`confirm:${code}`), null);
+			assert.strictEqual(await user.email.isValidationPending(uid), false);
+			assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+			assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+			const newCode = await user.email.sendValidationEmail(uid, { email });
+			assert(newCode && newCode !== code);
+			await user.email.expireValidation(uid);
+		} finally {
+			plugins.hooks.unregister('email-expiry-test', 'action:user.verify');
+			meta.config.emailConfirmExpiry = expiry;
+			meta.config.emailConfirmInterval = interval;
+		}
+	});
 });
