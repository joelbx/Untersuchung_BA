diff --git a/applications/mail/src/app/logic/elements/elementsLoading.test.ts b/applications/mail/src/app/logic/elements/elementsLoading.test.ts
new file mode 100644
index 0000000..aefa67c
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsLoading.test.ts
@@ -0,0 +1,64 @@
+import { configureStore } from '@reduxjs/toolkit';
+import elementsReducer, { newState } from './elementsSlice';
+import { backendActionFinished, backendActionStarted, load, reset } from './elementsActions';
+import { loading, shouldSendRequest } from './elementsSelectors';
+import { RootState } from '../store';
+
+describe('elements loading', () => {
+    beforeEach(() => jest.useFakeTimers());
+    afterEach(() => jest.useRealTimers());
+
+    const makeStore = () =>
+        configureStore({
+            reducer: { elements: elementsReducer },
+            middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+        });
+
+    it('tracks concurrent backend actions', () => {
+        const store = makeStore();
+        store.dispatch(backendActionStarted());
+        store.dispatch(backendActionStarted());
+        expect(store.getState().elements.pendingActions).toBe(2);
+        store.dispatch(reset({}));
+        expect(store.getState().elements.pendingActions).toBe(2);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(1);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(0);
+    });
+
+    it('retries a stale response after one second without committing its elements', async () => {
+        const store = makeStore();
+        const params = newState().params;
+        const api = jest.fn().mockResolvedValue({ Total: 1, Conversations: [{ ID: 'stale' }], Stale: 1 });
+
+        const result = await store.dispatch(load({ api: api as any, abortController: undefined, conversationMode: true, page: 0, params }));
+
+        expect(load.rejected.match(result)).toBe(true);
+        expect(store.getState().elements.pages).toEqual([]);
+        expect(store.getState().elements.elements).toEqual({});
+        jest.advanceTimersByTime(999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error: undefined });
+        expect(shouldSendRequest(store.getState() as RootState, { page: 0, params })).toBe(true);
+        expect(loading(store.getState() as RootState, { page: 0, params })).toBe(true);
+    });
+
+    it('retries a failed request after two seconds', async () => {
+        const store = makeStore();
+        const params = newState().params;
+        const error = new Error('request failed');
+        const api = jest.fn().mockRejectedValue(error);
+
+        const result = await store.dispatch(load({ api: api as any, abortController: undefined, conversationMode: true, page: 0, params }));
+
+        expect(load.rejected.match(result)).toBe(true);
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error });
+        expect(store.getState().elements.pendingRequest).toBe(false);
+    });
+});
