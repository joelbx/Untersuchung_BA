+def test_importapi_post_override_validation(monkeypatch, flag, expected):
+    rec = {'title': 'Test', 'source_records': ['test:example']}
+    monkeypatch.setattr(code, 'can_write', lambda: True)
+    monkeypatch.setattr(code.web, 'header', lambda *args: None)
