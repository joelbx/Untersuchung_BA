+    )
+    monkeypatch.setattr(code.web, 'data', lambda: b'{}')
+    monkeypatch.setattr(code, 'parse_data', lambda data: (rec, 'json'))
+    observed = {}
+
+    def fake_load(edition, override_validation=False):
+        observed['edition'] = edition
+        observed['override_validation'] = override_validation
+        return {'success': True}
+
+    monkeypatch.setattr(code.add_book, 'load', fake_load)
+    assert json.loads(code.importapi().POST()) == {'success': True}
+    assert observed == {'edition': rec, 'override_validation': expected}
 
 
