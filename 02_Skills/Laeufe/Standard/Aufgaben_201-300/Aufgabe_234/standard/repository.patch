+func TestSQLiteDSN(t *testing.T) {
+	dsn := sqliteDSN("file:test.db?cache=private&_busy_timeout=100&mode=ro")
+	_, rawQuery, ok := strings.Cut(dsn, "?")
+	if !ok {
+		t.Fatal("missing SQLite query parameters")
+	}
+	query, err := url.ParseQuery(rawQuery)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]string{
+		"cache": "shared", "_cache_size": "1000000000", "_busy_timeout": "5000",
+		"_journal_mode": "WAL", "_synchronous": "NORMAL", "_foreign_keys": "on",
+		"_txlock": "immediate", "mode": "ro",
+	} {
+		if got := query.Get(key); got != want {
+			t.Errorf("%s = %q, want %q", key, got, want)
+		}
+	}
+}
