+// sqliteDSN applies connection settings to every connection opened by database/sql.
+func sqliteDSN(path string) string {
+	filename, rawQuery, _ := strings.Cut(path, "?")
+	query, err := url.ParseQuery(rawQuery)
+	if err != nil {
+		panic(fmt.Errorf("invalid database path %q: %w", path, err))
+	}
+	query.Set("cache", "shared")
+	query.Set("_cache_size", "1000000000")
+	query.Set("_busy_timeout", "5000")
+	query.Set("_journal_mode", "WAL")
+	query.Set("_synchronous", "NORMAL")
+	query.Set("_foreign_keys", "on")
+	query.Set("_txlock", "immediate")
+	return filename + "?" + query.Encode()
+}
