+def _safe_tar_destination(filename, b_dest):
+    b_path = to_bytes(filename, errors='surrogate_or_strict')
+    b_result = os.path.abspath(os.path.join(b_dest, b_path))
+    if os.path.isabs(b_path) or not _is_child_path(b_result, b_dest) or b_result == os.path.abspath(b_dest):
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % to_native(filename, errors='surrogate_or_strict'))
+    return b_result
+
+
+def _extract_tar_dir(tar, filename, b_dest):
+    with _get_tar_file_member(tar, filename) as (member, _):
+        b_path = _safe_tar_destination(filename, b_dest)
+        if member.issym():
+            b_target = to_bytes(member.linkname, errors='surrogate_or_strict')
+            if not _is_child_path(b_path, b_dest, b_target):
+                raise AnsibleError("Cannot extract tar entry '%s' as its link points outside the collection directory"
+                                   % to_native(filename, errors='surrogate_or_strict'))
+            os.makedirs(os.path.dirname(b_path), mode=0o0755, exist_ok=True)
+            os.symlink(b_target, b_path)
+        elif member.isdir():
+            os.makedirs(b_path, mode=0o0755, exist_ok=True)
+        else:
+            raise AnsibleError("Cannot extract tar entry '%s' as a directory" % to_native(filename))
+
+
