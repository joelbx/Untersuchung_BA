+def _is_child_path(path, root, link_target=None):
+    """Check a path, or a link target relative to that path, against a root."""
+    if link_target is not None:
+        path = os.path.join(os.path.dirname(path), link_target)
+    root = os.path.realpath(root)
+    path = os.path.realpath(path)
+    separator = to_bytes(os.path.sep) if isinstance(root, bytes) else os.path.sep
+    return path == root or path.startswith(root if root.endswith(separator) else root + separator)
 
 
