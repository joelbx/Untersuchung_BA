diff --git a/src/api/utils.js b/src/api/utils.js
index 63d5473..3777e4f 100644
--- a/src/api/utils.js
+++ b/src/api/utils.js
@@ -1,13 +1,98 @@
 'use strict';
 
 const db = require('../database');
+const user = require('../user');
+const commonUtils = require('../utils');
 
 const utils = module.exports;
 
-// internal token management utilities only
+utils.tokens = {};
 
-utils.log = async (token) => {
+utils.tokens.list = async () => {
+	const tokens = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await utils.tokens.get(tokens);
+};
+
+utils.tokens.get = async (tokens) => {
+	if (!(typeof tokens === 'string' || Array.isArray(tokens))) {
+		throw new Error('[[error:invalid-data]]');
+	}
+
+	const isArray = Array.isArray(tokens);
+	const tokenList = isArray ? tokens : [tokens];
+	if (tokenList.some(token => typeof token !== 'string' || !token)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokenList.length) {
+		return [];
+	}
+
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenList.map(token => `token:${token}`)),
+		utils.tokens.getLastSeen(tokenList),
+	]);
+	const result = objects.map((object, index) => object && ({
+		uid: Number(object.uid),
+		description: object.description || '',
+		timestamp: Number(object.timestamp),
+		lastSeen: lastSeen[index],
+	}));
+	return isArray ? result : result[0];
+};
+
+utils.tokens.generate = async ({ uid, description } = {}) => {
+	const numericUid = Number(uid);
+	if (uid === undefined || uid === null || !Number.isFinite(numericUid) ||
+		!Number.isInteger(numericUid) || numericUid < 0) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.exists(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = commonUtils.generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, {
+		uid: numericUid,
+		description: description || '',
+		timestamp: timestamp,
+	});
+	await Promise.all([
+		db.sortedSetAdd('tokens:createtime', timestamp, token),
+		db.sortedSetAdd('tokens:uid', numericUid, token),
+	]);
+	return token;
+};
+
+utils.tokens.update = async (token, { description }) => {
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await utils.tokens.get(token);
+};
+
+utils.tokens.delete = async (token) => {
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove('tokens:createtime', token),
+		db.sortedSetRemove('tokens:uid', token),
+		db.sortedSetRemove('tokens:lastSeen', token),
+	]);
+};
+
+utils.tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.tokens.getLastSeen = async (tokens) => {
+	if (!tokens.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokens);
+	return scores.map((score) => {
+		const value = Number(score);
+		return score === null || score === undefined || !Number.isFinite(value) ? null : value;
+	});
+};
+
+// Existing API consumers use these names directly.
+utils.log = utils.tokens.log;
+utils.getLastSeen = utils.tokens.getLastSeen;
diff --git a/test/api-utils-tokens.js b/test/api-utils-tokens.js
new file mode 100644
index 0000000..ee238cc
--- /dev/null
+++ b/test/api-utils-tokens.js
@@ -0,0 +1,55 @@
+'use strict';
+
+const assert = require('assert');
+const db = require('./mocks/databasemock');
+const user = require('../src/user');
+const { tokens } = require('../src/api/utils');
+
+describe('API token utilities', () => {
+	it('handles empty inputs and missing users', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get(undefined), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get([null]), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.generate({ uid: 99999999 }), /\[\[error:no-user\]\]/);
+	});
+
+	it('creates, reads, updates, tracks, and deletes tokens', async () => {
+		const uid = await user.create({ username: 'tokenUtilitiesUser' });
+		const before = Date.now();
+		const first = await tokens.generate({ uid, description: 'first' });
+		await new Promise((resolve) => { setTimeout(resolve, 3); });
+		const second = await tokens.generate({ uid: 0 });
+		const after = Date.now();
+		const firstObject = await tokens.get(first);
+
+		assert.strictEqual(firstObject.uid, uid);
+		assert.strictEqual(firstObject.description, 'first');
+		assert(Number.isFinite(firstObject.timestamp));
+		assert(firstObject.timestamp >= before && firstObject.timestamp <= after);
+		assert.strictEqual(firstObject.lastSeen, null);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', first), firstObject.timestamp);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', first), uid);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', second), 0);
+		assert.deepStrictEqual(await tokens.get([second, first]), [await tokens.get(second), firstObject]);
+		assert.deepStrictEqual(await tokens.list(), [firstObject, await tokens.get(second)]);
+
+		await tokens.log(first);
+		const seen = await tokens.getLastSeen([second, first]);
+		assert.strictEqual(seen[0], null);
+		assert(Number.isFinite(seen[1]));
+		assert(seen[1] >= before && seen[1] <= Date.now());
+		const updated = await tokens.update(first, { description: 'updated' });
+		assert.deepStrictEqual(updated, { ...firstObject, description: 'updated', lastSeen: seen[1] });
+
+		await tokens.delete(first);
+		assert.strictEqual(await tokens.get(first), null);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', first), null);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', first), null);
+		assert.strictEqual(await db.sortedSetScore('tokens:lastSeen', first), null);
+		await tokens.delete(second);
+		assert.deepStrictEqual(await tokens.list(), []);
+	});
+});
