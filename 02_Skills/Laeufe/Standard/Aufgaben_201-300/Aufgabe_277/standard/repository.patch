+
+func TestRuleSegmentAudit(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    *flipt.Rule
+		key      string
+		operator string
+	}{
+		{"legacy", &flipt.Rule{SegmentKey: "legacy"}, "legacy", ""},
+		{"single", &flipt.Rule{SegmentKeys: []string{"first"}}, "first", ""},
+		{"multiple", &flipt.Rule{SegmentKeys: []string{"first", "second"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR}, "first,second", "AND_SEGMENT_OPERATOR"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := NewRule(tt.input)
+			assert.Equal(t, tt.key, got.SegmentKey)
+			assert.Equal(t, tt.operator, got.SegmentOperator)
+			data, err := json.Marshal(got)
+			assert.NoError(t, err)
+			if tt.operator == "" {
+				assert.NotContains(t, string(data), "segment_operator")
+			} else {
+				assert.Contains(t, string(data), `"segment_operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
+
+func TestRolloutSegmentAudit(t *testing.T) {
+	tests := []struct {
+		name     string
+		segment  *flipt.RolloutSegment
+		key      string
+		operator string
+	}{
+		{"legacy", &flipt.RolloutSegment{SegmentKey: "legacy", Value: true}, "legacy", ""},
+		{"single", &flipt.RolloutSegment{SegmentKeys: []string{"first"}, Value: true}, "first", ""},
+		{"multiple", &flipt.RolloutSegment{SegmentKeys: []string{"first", "second"}, SegmentOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR, Value: true}, "first,second", "OR_SEGMENT_OPERATOR"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: tt.segment}})
+			if assert.NotNil(t, got.Segment) {
+				assert.Equal(t, tt.key, got.Segment.Key)
+				assert.True(t, got.Segment.Value)
+				assert.Equal(t, tt.operator, got.Segment.Operator)
+				data, err := json.Marshal(got)
+				assert.NoError(t, err)
+				if tt.operator == "" {
+					assert.NotContains(t, string(data), `"operator"`)
+				} else {
+					assert.Contains(t, string(data), `"operator":"OR_SEGMENT_OPERATOR"`)
+				}
+			}
+		})
+	}
+}
