+#!/usr/bin/python
+# (c) 2019, NetApp, Inc
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1', 'status': ['preview'], 'supported_by': 'community'}
+
+DOCUMENTATION = '''
+---
+module: netapp_e_drive_firmware
+short_description: Manage NetApp E-Series drive firmware
+description:
+  - Upload drive firmware and upgrade compatible drives that are not already running its version.
+  - Firmware files must be E-Series drive firmware obtained from NetApp support.
+version_added: '2.9'
+author: NetApp
+extends_documentation_fragment:
+  - netapp.eseries
+options:
+  firmware:
+    description: Local paths to E-Series drive firmware files.
+    type: list
+    elements: str
+    required: true
+  wait_for_completion:
+    description: Wait until every targeted drive completes the upgrade.
+    type: bool
+    default: false
+  ignore_inaccessible_drives:
+    description: Skip inaccessible drives instead of failing the task.
+    type: bool
+    default: false
+  upgrade_drives_online:
+    description: Upgrade drives while they remain online and accept I/O.
+    type: bool
+    default: true
+notes:
+  - Check mode reports the drives requiring an upgrade without initiating one.
+'''
+
+EXAMPLES = '''
+- name: Upgrade E-Series drive firmware
+  netapp_e_drive_firmware:
+    api_url: https://array.example.com:8443/devmgr/v2
+    api_username: admin
+    api_password: "{{ password }}"
+    ssid: '1'
+    firmware:
+      - /srv/firmware/drive.dlp
+    wait_for_completion: true
+'''
+
+RETURN = '''
+upgrade_in_process:
+  description: Whether an upgrade initiated by this task is still in progress.
+  returned: always
+  type: bool
+'''
+
+import json
+import os
+import time
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils._text import to_native
+from ansible.module_utils.netapp import create_multipart_formdata, eseries_host_argument_spec, request
+
+WAIT_TIMEOUT_SEC = 3600
+POLL_INTERVAL_SEC = 5
+
+
+class NetAppESeriesDriveFirmware(object):
+    def __init__(self):
+        argument_spec = eseries_host_argument_spec()
+        argument_spec.update(dict(
+            firmware=dict(type='list', elements='str', required=True),
+            wait_for_completion=dict(type='bool', default=False),
+            ignore_inaccessible_drives=dict(type='bool', default=False),
+            upgrade_drives_online=dict(type='bool', default=True),
+        ))
+        self.module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+        params = self.module.params
+        self.firmware_list = params['firmware']
+        self.wait_for_completion = params['wait_for_completion']
+        self.ignore_inaccessible_drives = params['ignore_inaccessible_drives']
+        self.upgrade_drives_online = params['upgrade_drives_online']
+        self.ssid = params['ssid']
+        self.url = params['api_url'].rstrip('/') + '/'
+        self.creds = dict(url_username=params['api_username'], url_password=params['api_password'],
+                          validate_certs=params['validate_certs'])
+        self.upgrade_in_progress = False
+        self._upgrade_list = None
+
+    def _request(self, path, **kwargs):
+        if isinstance(kwargs.get('data'), (dict, list)):
+            kwargs['data'] = json.dumps(kwargs['data'])
+        return request(self.url + path, **dict(self.creds, **kwargs))
+
+    def _array_path(self, suffix):
+        return 'storage-systems/%s/firmware/drives%s' % (self.ssid, suffix)
+
+    def upload_firmware(self):
+        for path in self.firmware_list:
+            try:
+                headers, payload = create_multipart_formdata([('file', os.path.basename(path), path)])
+                code, response = self._request('files/drive', data=payload, headers=headers, method='POST')
+                if code < 200 or code >= 300:
+                    raise ValueError('HTTP %s: %s' % (code, response))
+            except Exception as error:
+                self.module.fail_json(msg='Failed to upload drive firmware %s for array %s: %s' %
+                                      (path, self.ssid, to_native(error)))
+
+    @staticmethod
+    def _compatibility_entries(response):
+        if isinstance(response, list):
+            return response
+        for key in ('compatibility', 'compatibilities', 'firmware', 'files', 'driveFirmware'):
+            if isinstance(response.get(key), list):
+                return response[key]
+        return []
+
+    def upgrade_list(self):
+        if self._upgrade_list is not None:
+            return self._upgrade_list
+        try:
+            code, response = self._request(self._array_path(''))
+            if code != 200 or not isinstance(response, (dict, list)):
+                raise ValueError('HTTP %s: %s' % (code, response))
+            entries = self._compatibility_entries(response)
+        except Exception as error:
+            self.module.fail_json(msg='Failed to complete compatibility and health check. Array %s: %s' %
+                                  (self.ssid, to_native(error)))
+
+        requested = set(os.path.basename(path) for path in self.firmware_list)
+        upgrades = []
+        for entry in entries:
+            filename = os.path.basename(entry.get('filename', entry.get('fileName', '')))
+            if filename not in requested:
+                continue
+            target_version = entry.get('firmwareVersion', entry.get('version'))
+            candidates = entry.get('driveRefList', entry.get('compatibleDrives', entry.get('drives', [])))
+            if isinstance(candidates, dict):
+                candidates = candidates.get('driveRef', [])
+            drive_refs = []
+            for candidate in candidates:
+                drive_ref = candidate.get('driveRef') if isinstance(candidate, dict) else candidate
+                try:
+                    code, drive = self._request('storage-systems/%s/drives/%s' % (self.ssid, drive_ref))
+                    if code != 200 or not isinstance(drive, dict):
+                        raise ValueError('HTTP %s: %s' % (code, drive))
+                except Exception as error:
+                    self.module.fail_json(msg='Failed to retrieve drive information. Array %s, drive %s: %s' %
+                                          (self.ssid, drive_ref, to_native(error)))
+                if drive.get('offline') or drive.get('available') is False or drive.get('status') in ('offline', 'unavailable'):
+                    if self.ignore_inaccessible_drives:
+                        continue
+                    self.module.fail_json(msg='Inaccessible drive %s on array %s.' % (drive_ref, self.ssid))
+                version = candidate.get('firmwareVersion', candidate.get('version')) if isinstance(candidate, dict) else None
+                if version is None:
+                    version = target_version
+                if version is None:
+                    self.module.fail_json(msg='No target firmware version for %s on array %s.' % (filename, self.ssid))
+                if drive.get('firmwareVersion') == version:
+                    continue
+                capable = candidate.get('onlineUpgradeCapable') if isinstance(candidate, dict) else None
+                if capable is None:
+                    capable = drive.get('onlineUpgradeCapable', True)
+                if self.upgrade_drives_online and not capable:
+                    self.module.fail_json(msg='Drive is not capable of online upgrade. Array %s, drive %s.' %
+                                          (self.ssid, drive_ref))
+                drive_refs.append(drive_ref)
+            if drive_refs:
+                upgrades.append(dict(filename=filename, driveRefList=drive_refs))
+        self._upgrade_list = upgrades
+        return upgrades
+
+    def wait_for_upgrade_completion(self):
+        targets = set(ref for item in self.upgrade_list() for ref in item['driveRefList'])
+        deadline = time.time() + WAIT_TIMEOUT_SEC
+        while True:
+            try:
+                code, response = self._request(self._array_path('/state'))
+                if code != 200 or not isinstance(response, (dict, list)):
+                    raise ValueError('HTTP %s: %s' % (code, response))
+                states = response if isinstance(response, list) else response.get('drives', response.get('driveState', []))
+                if isinstance(states, dict):
+                    states = [states]
+            except Exception as error:
+                self.module.fail_json(msg='Failed to retrieve drive status. Array %s: %s' %
+                                      (self.ssid, to_native(error)))
+            seen = set()
+            pending = False
+            for state in states:
+                ref = state.get('driveRef')
+                if ref not in targets:
+                    continue
+                seen.add(ref)
+                status = state.get('status')
+                if status in ('inProgress', 'inProgressRecon', 'pending', 'notAttempted'):
+                    pending = True
+                elif status != 'okay':
+                    self.module.fail_json(msg='Drive firmware upgrade failed. Array %s, drive %s: %s' %
+                                          (self.ssid, ref, status))
+            if seen == targets and not pending:
+                self.upgrade_in_progress = False
+                return
+            if time.time() >= deadline:
+                self.module.fail_json(msg='Timed out waiting for drive firmware upgrade. Array %s, drives %s.' %
+                                      (self.ssid, sorted(targets - seen)))
+            time.sleep(POLL_INTERVAL_SEC)
+
+    def upgrade(self):
+        upgrades = self.upgrade_list()
+        if not upgrades:
+            return
+        try:
+            code, response = self._request(self._array_path('/initiate-upgrade'), data=dict(
+                online=self.upgrade_drives_online, firmware=upgrades), method='POST')
+            if code < 200 or code >= 300:
+                raise ValueError('HTTP %s: %s' % (code, response))
+        except Exception as error:
+            self.module.fail_json(msg='Failed to upgrade drive firmware. Array %s: %s' %
+                                  (self.ssid, to_native(error)))
+        self.upgrade_in_progress = True
+        if self.wait_for_completion:
+            self.wait_for_upgrade_completion()
+
+    def apply(self):
+        self.upload_firmware()
+        upgrades = self.upgrade_list()
+        if upgrades and not self.module.check_mode:
+            self.upgrade()
+        self.module.exit_json(changed=bool(upgrades), upgrade_in_process=self.upgrade_in_progress)
+
+
+def main():
+    NetAppESeriesDriveFirmware().apply()
+
+
+if __name__ == '__main__':
+    main()
