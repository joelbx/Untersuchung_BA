diff --git a/lib/httplib/httplib_test.go b/lib/httplib/httplib_test.go
index 9b7ff1e..a86b3e0 100644
--- a/lib/httplib/httplib_test.go
+++ b/lib/httplib/httplib_test.go
@@ -17,6 +17,7 @@ limitations under the License.
 package httplib
 
 import (
+	"errors"
 	"net/http"
 	"net/http/httptest"
 	"testing"
@@ -25,6 +26,50 @@ import (
 	. "gopkg.in/check.v1"
 )
 
+func TestHandlersWithErrorWriter(t *testing.T) {
+	wantErr := errors.New("handler failed")
+	for _, tt := range []struct {
+		name    string
+		handler http.HandlerFunc
+	}{
+		{
+			name: "router handler",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				MakeHandlerWithErrorWriter(func(http.ResponseWriter, *http.Request, httprouter.Params) (interface{}, error) {
+					return nil, wantErr
+				}, func(w http.ResponseWriter, err error) {
+					if err != wantErr {
+						t.Errorf("error = %v, want %v", err, wantErr)
+					}
+					w.WriteHeader(http.StatusTeapot)
+				})(w, r, nil)
+			},
+		},
+		{
+			name: "standard handler",
+			handler: MakeStdHandlerWithErrorWriter(func(http.ResponseWriter, *http.Request) (interface{}, error) {
+				return nil, wantErr
+			}, func(w http.ResponseWriter, err error) {
+				if err != wantErr {
+					t.Errorf("error = %v, want %v", err, wantErr)
+				}
+				w.WriteHeader(http.StatusTeapot)
+			}),
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			tt.handler(recorder, httptest.NewRequest(http.MethodGet, "/", nil))
+			if recorder.Code != http.StatusTeapot {
+				t.Errorf("status = %d, want %d", recorder.Code, http.StatusTeapot)
+			}
+			if recorder.Header().Get("Cache-Control") == "" {
+				t.Error("missing no-cache header")
+			}
+		})
+	}
+}
+
 func TestHTTP(t *testing.T) { TestingT(t) }
 
