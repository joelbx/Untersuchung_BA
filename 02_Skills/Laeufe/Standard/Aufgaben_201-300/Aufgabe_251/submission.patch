+func indexYAML(node *yamlv3.Node, path []string, positions map[string]yamlPosition) {
+	switch node.Kind {
+	case yamlv3.DocumentNode:
+		for _, child := range node.Content {
+			indexYAML(child, path, positions)
+		}
+	case yamlv3.MappingNode:
+		for i := 0; i+1 < len(node.Content); i += 2 {
+			key, value := node.Content[i], node.Content[i+1]
+			child := append(append([]string(nil), path...), key.Value)
+			positions[strings.Join(child, ".")] = yamlPosition{key.Line, key.Column, value.Line, value.Column}
+			indexYAML(value, child, positions)
+		}
+	case yamlv3.SequenceNode:
+		for i, childNode := range node.Content {
+			child := append(append([]string(nil), path...), strconv.Itoa(i))
+			positions[strings.Join(child, ".")] = yamlPosition{childNode.Line, childNode.Column, childNode.Line, childNode.Column}
+			indexYAML(childNode, child, positions)
+		}
+	}
