diff --git a/test/posts-get-upvoters.js b/test/posts-get-upvoters.js
new file mode 100644
index 0000000..5c24a59
--- /dev/null
+++ b/test/posts-get-upvoters.js
@@ -0,0 +1,103 @@
+'use strict';
+
+const assert = require('assert');
+const Module = require('module');
+
+describe('SocketPosts.getUpvoters', () => {
+	let getUpvoters;
+	let state;
+
+	before(() => {
+		state = {
+			cids: [],
+			allowed: [],
+			uids: [],
+			isAdmin: false,
+			voteFetches: 0,
+			usernameLookups: [],
+		};
+		const dependencies = {
+			'../../database': {},
+			'../../user': {
+				isAdministrator: async () => state.isAdmin,
+				getUsernamesByUids: async (uids) => {
+					state.usernameLookups.push(uids);
+					return uids.map(uid => `user${uid}`);
+				},
+			},
+			'../../posts': {
+				getCidsByPids: async () => state.cids,
+				getUpvotedUidsByPids: async () => {
+					state.voteFetches += 1;
+					return state.uids;
+				},
+			},
+			'../../privileges': {
+				categories: {
+					isUserAllowedTo: async (privilege, cids) => {
+						assert.strictEqual(privilege, 'topics:read');
+						assert.deepStrictEqual(cids, [...new Set(state.cids)]);
+						return state.allowed;
+					},
+				},
+			},
+			'../../meta': {},
+		};
+		const originalLoad = Module._load;
+		try {
+			Module._load = function (request, parent, isMain) {
+				if (parent && parent.filename.endsWith('/src/socket.io/posts/votes.js') &&
+					Object.hasOwn(dependencies, request)) {
+					return dependencies[request];
+				}
+				return originalLoad.call(this, request, parent, isMain);
+			};
+			const handlers = {};
+			require('../src/socket.io/posts/votes')(handlers);
+			getUpvoters = handlers.getUpvoters;
+		} finally {
+			Module._load = originalLoad;
+		}
+	});
+
+	beforeEach(() => {
+		state.cids = [1, 2];
+		state.allowed = [true, true];
+		state.uids = [[1, 2], [2, 1]];
+		state.isAdmin = false;
+		state.voteFetches = 0;
+		state.usernameLookups = [];
+	});
+
+	it('rejects when any category is unreadable, before fetching votes', async () => {
+		state.allowed = [true, false];
+		await assert.rejects(getUpvoters({ uid: 0 }, [10, 20]), { message: '[[error:no-privileges]]' });
+		assert.strictEqual(state.voteFetches, 0);
+	});
+
+	it('rejects posts without a category', async () => {
+		state.cids = [1, null];
+		state.allowed = [true, false];
+		await assert.rejects(getUpvoters({ uid: 5 }, [10, 20]), { message: '[[error:no-privileges]]' });
+		assert.strictEqual(state.voteFetches, 0);
+	});
+
+	it('allows administrators through restricted categories', async () => {
+		state.isAdmin = true;
+		state.allowed = [false, false];
+		const result = await getUpvoters({ uid: 1 }, [10, 20]);
+		assert.deepStrictEqual(result[0].usernames, ['user1', 'user2']);
+	});
+
+	it('resolves each distinct UID once and preserves each post order', async () => {
+		state.cids = [1, 1];
+		state.allowed = [true];
+		state.uids = [[3, 1, 2, 4, 5, 6, 7], [2, 3, 1]];
+		const result = await getUpvoters({ uid: 5 }, [10, 20]);
+		assert.deepStrictEqual(state.usernameLookups, [[3, 1, 2, 4, 5]]);
+		assert.deepStrictEqual(result, [
+			{ otherCount: 2, usernames: ['user3', 'user1', 'user2', 'user4', 'user5'], cutoff: 6 },
+			{ otherCount: 0, usernames: ['user2', 'user3', 'user1'], cutoff: 6 },
+		]);
+	});
+});
