+func convertKEVulns(response kevulndb.Response) []models.KEV {
+	var result []models.KEV
+	for _, entry := range response.CISA {
+		var dueDate *time.Time
+		if !entry.DueDate.IsZero() && entry.DueDate.Year() > 1 {
+			dueDate = &entry.DueDate
+		}
+		result = append(result, models.KEV{
+			Type: models.CISAKEVType, VendorProject: entry.VendorProject,
+			Product: entry.Product, VulnerabilityName: entry.VulnerabilityName,
+			ShortDescription: entry.ShortDescription, RequiredAction: entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  entry.DateAdded, DueDate: dueDate,
+			CISA: &models.CISAKEV{Note: entry.Notes},
+		})
+	}
+	for _, entry := range response.VulnCheck {
+		var dueDate *time.Time
+		if entry.DueDate != nil && !entry.DueDate.IsZero() && entry.DueDate.Year() > 1 {
+			dueDate = entry.DueDate
+		}
+		details := &models.VulnCheckKEV{}
+		for _, xdb := range entry.VulnCheckXDB {
+			details.XDB = append(details.XDB, models.VulnCheckXDB{
+				XDBID: xdb.XDBID, XDBURL: xdb.XDBURL, DateAdded: xdb.DateAdded,
+				ExploitType: xdb.ExploitType, CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, report := range entry.VulnCheckReportedExploitation {
+			details.ReportedExploitation = append(details.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL: report.URL, DateAdded: report.DateAdded,
+			})
+		}
+		result = append(result, models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: entry.VendorProject,
+			Product: entry.Product, VulnerabilityName: entry.Name,
+			ShortDescription: entry.Description, RequiredAction: entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  entry.DateAdded, DueDate: dueDate, VulnCheck: details,
+		})
+	}
+	return result
+}
