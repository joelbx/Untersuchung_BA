 type kevulnResponse struct {
 	request kevulnRequest
 	json    string
diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..64ae750
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,33 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestConvertKEVulns(t *testing.T) {
+	added := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	response := kevulndb.Response{
+		CISA:      []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", Product: "CISA product", VulnerabilityName: "CISA name", ShortDescription: "CISA description", RequiredAction: "CISA action", KnownRansomwareCampaignUse: "Known", DateAdded: added, Notes: "CISA note"}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "VC vendor", Product: "VC product", Name: "VC name", Description: "VC description", RequiredAction: "VC action", KnownRansomwareCampaignUse: "Unknown", DateAdded: added, VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{XDBID: "XDB-1", XDBURL: "https://example.com/xdb", DateAdded: added, ExploitType: "poc", CloneSSHURL: "git@example.com:xdb"}}, VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://example.com/report", DateAdded: added}}}},
+	}
+	got := convertKEVulns(response)
+	if len(got) != 2 || got[0].Type != models.CISAKEVType || got[0].CISA == nil || got[0].CISA.Note != "CISA note" || got[0].DueDate != nil || got[0].VendorProject != "CISA vendor" {
+		t.Fatalf("incorrect CISA conversion: %+v", got)
+	}
+	if got[1].Type != models.VulnCheckKEVType || got[1].VulnCheck == nil || got[1].DueDate != nil || got[1].ShortDescription != "VC description" || len(got[1].VulnCheck.XDB) != 1 || got[1].VulnCheck.XDB[0].XDBID != "XDB-1" || len(got[1].VulnCheck.ReportedExploitation) != 1 || got[1].VulnCheck.ReportedExploitation[0].URL != "https://example.com/report" {
+		t.Fatalf("incorrect VulnCheck conversion: %+v", got[1])
+	}
+	response.CISA[0].DueDate = added
+	response.VulnCheck[0].DueDate = &added
+	got = convertKEVulns(response)
+	if got[0].DueDate == nil || !got[0].DueDate.Equal(added) || got[1].DueDate == nil || !got[1].DueDate.Equal(added) {
+		t.Fatalf("valid due dates were lost: %+v", got)
+	}
+}
