+		CveContent{Type: TrivyUbuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "MEDIUM", Cvss3Score: 5.2},
+	)}
+	if got := v.Titles("en", "debian"); len(got) < 2 || got[0].Type != TrivyDebian || got[0].Value != "Debian title" || got[1].Type != TrivyUbuntu {
+		t.Fatalf("titles: %+v", got)
+	}
+	if got := v.Summaries("en", "debian"); len(got) < 2 || got[0].Type != TrivyDebian || got[1].Type != TrivyUbuntu {
+		t.Fatalf("summaries: %+v", got)
+	}
+	if got := v.Cvss2Scores(); len(got) != 1 || got[0].Type != TrivyDebian || got[0].Value.Score != 2.2 {
+		t.Fatalf("CVSS2: %+v", got)
+	}
+	if got := v.Cvss3Scores(); len(got) != 2 || got[0].Type != TrivyDebian || got[0].Value.Score != 3.1 || got[1].Type != TrivyUbuntu || got[1].Value.Score != 5.2 {
+		t.Fatalf("CVSS3: %+v", got)
+	}
+}
