+)
+
+func TestGetCveContentsByTrivySource(t *testing.T) {
+	published := time.Date(2024, 2, 1, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	contents := getCveContents("CVE-2024-0002", trivydb.Vulnerability{
+		Title: "title", Description: "summary",
+		VendorSeverity: trivydb.VendorSeverity{"ghsa": trivydb.SeverityLow, "nvd": trivydb.SeverityHigh},
+		CVSS:           trivydb.VendorCVSS{"ghsa": {V3Score: 3.2, V3Vector: "GHSA"}, "nvd": {V3Score: 8.0, V3Vector: "NVD"}},
+		References:     []string{"https://example.test"}, PublishedDate: &published, LastModifiedDate: &modified,
+	})
+	for _, tc := range []struct {
+		source   models.CveContentType
+		severity string
+		score    float64
+		vector   string
+	}{
+		{models.TrivyGHSA, "LOW", 3.2, "GHSA"},
+		{models.TrivyNVD, "HIGH", 8.0, "NVD"},
+	} {
+		if len(contents[tc.source]) != 1 {
+			t.Fatalf("missing %s", tc.source)
+		}
+		c := contents[tc.source][0]
+		if c.Type != tc.source || c.CveID != "CVE-2024-0002" || c.Cvss3Severity != tc.severity || c.Cvss3Score != tc.score || c.Cvss3Vector != tc.vector || c.Title != "title" || c.Summary != "summary" || !c.Published.Equal(published) || !c.LastModified.Equal(modified) || len(c.References) != 1 {
+			t.Errorf("%s: unexpected content: %+v", tc.source, c)
+		}
+	}
+}
