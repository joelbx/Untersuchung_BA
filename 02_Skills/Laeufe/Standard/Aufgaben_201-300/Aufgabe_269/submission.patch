diff --git a/contrib/trivy/pkg/converter_test.go b/contrib/trivy/pkg/converter_test.go
new file mode 100644
index 0000000..b8b3190
--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,80 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	trivydb "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	date := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := date.Add(24 * time.Hour)
+	debian := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-0001",
+		PkgName:         "a",
+		Vulnerability: trivydb.Vulnerability{
+			Title: "title", Description: "summary", Severity: "LOW",
+			VendorSeverity: trivydb.VendorSeverity{"debian": trivydb.SeverityLow},
+			CVSS:           trivydb.VendorCVSS{"debian": {V2Score: 2.1, V2Vector: "AV:L", V3Score: 3.1, V3Vector: "CVSS:3.1/AV:L"}},
+			References:     []string{"https://example.test/advisory"}, PublishedDate: &date, LastModifiedDate: &modified,
+		},
+	}
+	ubuntu := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-0001", PkgName: "b",
+		Vulnerability: trivydb.Vulnerability{
+			Title: "title", Description: "summary", Severity: "MEDIUM",
+			VendorSeverity: trivydb.VendorSeverity{"ubuntu": trivydb.SeverityMedium, "nvd": trivydb.SeverityHigh},
+			CVSS:           trivydb.VendorCVSS{"ubuntu": {V3Score: 5.5}, "nvd": {V3Score: 8.1}},
+			PublishedDate:  &date, LastModifiedDate: &modified,
+		},
+	}
+	result, err := Convert(types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{debian}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{ubuntu}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-2024-0001"].CveContents
+	for _, tc := range []struct {
+		source   models.CveContentType
+		severity string
+		score    float64
+	}{
+		{models.TrivyDebian, "LOW", 3.1},
+		{models.TrivyUbuntu, "MEDIUM", 5.5},
+		{models.TrivyNVD, "HIGH", 8.1},
+	} {
+		entries := contents[tc.source]
+		if len(entries) != 1 {
+			t.Fatalf("%s: got %d entries", tc.source, len(entries))
+		}
+		entry := entries[0]
+		if entry.Type != tc.source || entry.CveID != "CVE-2024-0001" || entry.Title != "title" || entry.Summary != "summary" || entry.Cvss3Severity != tc.severity || entry.Cvss3Score != tc.score || !entry.Published.Equal(date) || !entry.LastModified.Equal(modified) {
+			t.Errorf("%s: unexpected content: %+v", tc.source, entry)
+		}
+	}
+	if contents[models.TrivyDebian][0].Cvss2Score != 2.1 || contents[models.TrivyDebian][0].Cvss2Vector != "AV:L" || contents[models.TrivyDebian][0].Cvss3Vector != "CVSS:3.1/AV:L" || len(contents[models.TrivyDebian][0].References) != 1 {
+		t.Errorf("Debian scoring or references lost: %+v", contents[models.TrivyDebian][0])
+	}
+}
+
+func TestMergeCveContentsKeepsComplementaryFields(t *testing.T) {
+	existing := models.NewCveContents(models.CveContent{
+		Type: models.TrivyNVD, CveID: "CVE-2024-0003", Cvss2Score: 4.2,
+		References: models.References{{Link: "https://example.test/one"}},
+	})
+	incoming := models.NewCveContents(models.CveContent{
+		Type: models.TrivyNVD, CveID: "CVE-2024-0003", Cvss3Score: 8.1, Cvss3Severity: "HIGH",
+		References: models.References{{Link: "https://example.test/two"}},
+	})
+	merged := MergeCveContents(existing, incoming)[models.TrivyNVD][0]
+	if merged.Cvss2Score != 4.2 || merged.Cvss3Score != 8.1 || merged.Cvss3Severity != "HIGH" || len(merged.References) != 2 {
+		t.Fatalf("complementary fields lost: %+v", merged)
+	}
+}
diff --git a/contrib/trivy/pkg/cvecontents.go b/contrib/trivy/pkg/cvecontents.go
new file mode 100644
index 0000000..dbdf510
--- /dev/null
+++ b/contrib/trivy/pkg/cvecontents.go
@@ -0,0 +1,124 @@
+package pkg
+
+import (
+	"sort"
+	"strings"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+// CveContentsFromVulnerability keeps each Trivy severity and CVSS score with
+// the source that reported it. fallbackSource identifies a selected severity
+// when the vulnerability does not contain a vendor severity map.
+func CveContentsFromVulnerability(cveID string, vul trivydbTypes.Vulnerability, fallbackSource string) models.CveContents {
+	contents := models.CveContents{}
+	sources := map[trivydbTypes.SourceID]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[source] = struct{}{}
+	}
+	if fallbackSource == "" {
+		fallbackSource = "unknown"
+	}
+	if len(sources) == 0 || (vul.Severity != "" && len(vul.VendorSeverity) == 0) {
+		sources[trivydbTypes.SourceID(fallbackSource)] = struct{}{}
+	}
+
+	refs := make(models.References, 0, len(vul.References))
+	for _, url := range vul.References {
+		refs = append(refs, models.Reference{Source: "trivy", Link: url})
+	}
+	sort.Slice(refs, func(i, j int) bool { return refs[i].Link < refs[j].Link })
+
+	for source := range sources {
+		ctype := models.CveContentType("trivy:" + strings.ToLower(string(source)))
+		content := models.CveContent{
+			Type: ctype, CveID: cveID, Title: vul.Title, Summary: vul.Description,
+			References: refs, CweIDs: vul.CweIDs,
+		}
+		if vul.PublishedDate != nil {
+			content.Published = *vul.PublishedDate
+		}
+		if vul.LastModifiedDate != nil {
+			content.LastModified = *vul.LastModifiedDate
+		}
+		if severity, ok := vul.VendorSeverity[source]; ok {
+			content.Cvss3Severity = severity.String()
+		} else if len(vul.VendorSeverity) == 0 && string(source) == fallbackSource {
+			content.Cvss3Severity = vul.Severity
+		}
+		if cvss, ok := vul.CVSS[source]; ok {
+			content.Cvss2Score = cvss.V2Score
+			content.Cvss2Vector = cvss.V2Vector
+			content.Cvss3Score = cvss.V3Score
+			content.Cvss3Vector = cvss.V3Vector
+		}
+		contents[ctype] = []models.CveContent{content}
+	}
+	return contents
+}
+
+// MergeCveContents combines findings for a CVE without dropping a source or
+// fields supplied by another scan target.
+func MergeCveContents(existing, incoming models.CveContents) models.CveContents {
+	if existing == nil {
+		existing = models.CveContents{}
+	}
+	for ctype, entries := range incoming {
+		if len(entries) == 0 {
+			continue
+		}
+		if len(existing[ctype]) == 0 {
+			existing[ctype] = entries
+			continue
+		}
+		old, next := existing[ctype][0], entries[0]
+		if old.Title == "" {
+			old.Title = next.Title
+		}
+		if old.Summary == "" {
+			old.Summary = next.Summary
+		}
+		if old.Cvss2Score == 0 {
+			old.Cvss2Score = next.Cvss2Score
+		}
+		if old.Cvss2Vector == "" {
+			old.Cvss2Vector = next.Cvss2Vector
+		}
+		if old.Cvss3Score == 0 {
+			old.Cvss3Score = next.Cvss3Score
+		}
+		if old.Cvss3Vector == "" {
+			old.Cvss3Vector = next.Cvss3Vector
+		}
+		if old.Cvss3Severity == "" {
+			old.Cvss3Severity = next.Cvss3Severity
+		}
+		if old.Published.IsZero() {
+			old.Published = next.Published
+		}
+		if old.LastModified.IsZero() {
+			old.LastModified = next.LastModified
+		}
+		if len(old.CweIDs) == 0 {
+			old.CweIDs = next.CweIDs
+		}
+		seen := map[string]bool{}
+		for _, ref := range old.References {
+			seen[ref.Link] = true
+		}
+		for _, ref := range next.References {
+			if !seen[ref.Link] {
+				old.References = append(old.References, ref)
+				seen[ref.Link] = true
+			}
+		}
+		sort.Slice(old.References, func(i, j int) bool { return old.References[i].Link < old.References[j].Link })
+		existing[ctype][0] = old
+	}
+	return existing
+}
