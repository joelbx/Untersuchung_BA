+def process_cover_url(
+    edition: dict, allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS
+) -> tuple[str | None, dict]:
+    """Remove and return a cover URL when its HTTP(S) host is allowed."""
+    cover_url = edition.pop('cover', None)
+    if not isinstance(cover_url, str):
+        return None, edition
+
+    try:
+        parsed = urlsplit(cover_url)
+        hostname = parsed.hostname
+    except ValueError:
+        return None, edition
+
+    if parsed.scheme.lower() in ('http', 'https') and hostname and hostname.casefold() in {
+        host.casefold() for host in allowed_cover_hosts
+    }:
+        return cover_url, edition
+    return None, edition
+
