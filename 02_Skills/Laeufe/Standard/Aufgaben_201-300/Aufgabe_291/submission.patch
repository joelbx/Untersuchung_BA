diff --git a/models/utils_cvss40_test.go b/models/utils_cvss40_test.go
new file mode 100644
index 0000000..0e9c93b
--- /dev/null
+++ b/models/utils_cvss40_test.go
@@ -0,0 +1,62 @@
+//go:build !scanner
+
+package models
+
+import (
+	"testing"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertNvdToModelCvss40Sources(t *testing.T) {
+	const cveID = "CVE-2024-1234"
+	contents, _, _ := ConvertNvdToModel(cveID, []cvedict.Nvd{{
+		Cvss3: []cvedict.NvdCvss3{{Source: "nvd@nist.gov", Cvss3: cvedict.Cvss3{BaseScore: 7.1}}},
+		Cvss40: []cvedict.NvdCvss40{
+			{Source: "nvd@nist.gov", Cvss40: cvedict.Cvss40{BaseScore: 8.2, VectorString: "CVSS:4.0/AV:N", BaseSeverity: "HIGH"}},
+			{Source: "other", Cvss40: cvedict.Cvss40{BaseScore: 4.3, VectorString: "CVSS:4.0/AV:L", BaseSeverity: "MEDIUM"}},
+		},
+	}})
+	if len(contents) != 2 {
+		t.Fatalf("got %d contents, want 2", len(contents))
+	}
+	bySource := make(map[string]CveContent, len(contents))
+	for _, content := range contents {
+		bySource[content.Optional["source"]] = content
+		if content.Type != Nvd || content.CveID != cveID {
+			t.Errorf("wrong identity: %+v", content)
+		}
+	}
+	for _, want := range []struct {
+		source, vector, severity string
+		score                    float64
+	}{
+		{"nvd@nist.gov", "CVSS:4.0/AV:N", "HIGH", 8.2},
+		{"other", "CVSS:4.0/AV:L", "MEDIUM", 4.3},
+	} {
+		got, ok := bySource[want.source]
+		if !ok || got.Cvss40Score != want.score || got.Cvss40Vector != want.vector || got.Cvss40Severity != want.severity {
+			t.Errorf("source %q: got %+v", want.source, got)
+		}
+	}
+	if bySource["nvd@nist.gov"].Cvss3Score != 7.1 || bySource["other"].Cvss3Score != 0 {
+		t.Errorf("CVSS v3 associated with wrong source: %+v", bySource)
+	}
+}
+
+func TestCvss40ScoresMitreThenNvd(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Nvd:   {{Cvss40Score: 8.2, Cvss40Vector: "CVSS:4.0/AV:N", Cvss40Severity: "high"}, {}},
+		Mitre: {{Cvss40Score: 6.9, Cvss40Vector: "CVSS:4.0/AV:L", Cvss40Severity: "medium"}},
+	}}
+	got := v.Cvss40Scores()
+	if len(got) != 2 {
+		t.Fatalf("got %d scores, want 2: %+v", len(got), got)
+	}
+	if got[0].Type != Mitre || got[0].Value.Score != 6.9 || got[0].Value.Severity != "MEDIUM" || got[0].Value.Vector != "CVSS:4.0/AV:L" {
+		t.Errorf("MITRE score: %+v", got[0])
+	}
+	if got[1].Type != Nvd || got[1].Value.Score != 8.2 || got[1].Value.Severity != "HIGH" || got[1].Value.Vector != "CVSS:4.0/AV:N" {
+		t.Errorf("NVD score: %+v", got[1])
+	}
+}
