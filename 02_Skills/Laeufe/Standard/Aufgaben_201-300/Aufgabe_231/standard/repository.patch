+func Test_newDBConnection(t *testing.T) {
+	t.Run("valid metadata", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "vuls.db")
+		if err := putMetadata(types.Metadata{SchemaVersion: common.SchemaVersion}, path); err != nil {
+			t.Fatal(err)
+		}
+		dbc, err := newDBConnection(config.Vuls2Conf{Path: path, SkipUpdate: true}, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := dbc.Open(); err != nil {
+			t.Fatalf("returned connection could not be opened: %v", err)
+		}
+		if err := dbc.Close(); err != nil {
+			t.Fatal(err)
+		}
+	})
+
+	t.Run("missing metadata", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "vuls.db")
+		c, err := (&common.Config{Type: "boltdb", Path: path}).New()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := c.Open(); err != nil {
+			t.Fatal(err)
+		}
+		if err := c.Close(); err != nil {
+			t.Fatal(err)
+		}
+		_, err = newDBConnection(config.Vuls2Conf{Path: path, SkipUpdate: true}, true)
+		if err == nil || !strings.Contains(err.Error(), path) {
+			t.Errorf("newDBConnection() error = %v, want path", err)
+		}
+	})
+}
