diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..16dcf77
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,63 @@
+package release
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" {
+		return false
+	}
+
+	v, err := semver.ParseTolerant(version)
+	return err == nil && len(v.Pre) == 0
+}
+
+// Check compares version with the latest published release.
+func Check(ctx context.Context, version string) (Info, error) {
+	return check(ctx, version, github.NewClient(nil))
+}
+
+func check(ctx context.Context, version string, client *github.Client) (info Info, err error) {
+	info = Info{CurrentVersion: version}
+	defer func() {
+		if err != nil {
+			zap.L().Warn("checking for updates", zap.Error(err))
+		}
+	}()
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, fmt.Errorf("checking for latest version: %w", err)
+	}
+
+	parsedLatest, err := semver.ParseTolerant(latest.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latest.GetTagName()
+	info.UpdateAvailable = current.LT(parsedLatest)
+	if info.UpdateAvailable {
+		info.LatestVersionURL = latest.GetHTMLURL()
+	}
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..75f3bce
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,78 @@
+package release
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+)
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"1.2.3-dev", false},
+		{"1.2.3-snapshot", false},
+		{"1.2.3-rc", false},
+		{"1.2.3-rc.1", false},
+		{"1.2.3-alpha", false},
+		{"v1.2.3", true},
+		{"1.2.3+build", true},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			if got := Is(tc.version); got != tc.want {
+				t.Fatalf("Is(%q) = %t, want %t", tc.version, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		current    string
+		latest     string
+		wantUpdate bool
+	}{
+		{"newer available", "1.2.3", "v1.3.0", true},
+		{"already latest", "1.3.0", "v1.3.0", false},
+		{"current newer", "1.4.0", "v1.3.0", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+					t.Errorf("unexpected request path: %s", r.URL.Path)
+				}
+				_ = json.NewEncoder(w).Encode(map[string]string{"tag_name": tc.latest, "html_url": "https://example.test/release"})
+			}))
+			defer server.Close()
+
+			client := github.NewClient(server.Client())
+			baseURL, err := url.Parse(server.URL + "/")
+			if err != nil {
+				t.Fatal(err)
+			}
+			client.BaseURL = baseURL
+			got, err := check(context.Background(), tc.current, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tc.current || got.LatestVersion != tc.latest || got.UpdateAvailable != tc.wantUpdate {
+				t.Fatalf("unexpected release info: %+v", got)
+			}
+			if tc.wantUpdate && got.LatestVersionURL != "https://example.test/release" {
+				t.Fatalf("missing latest URL: %+v", got)
+			}
+			if !tc.wantUpdate && got.LatestVersionURL != "" {
+				t.Fatalf("unexpected latest URL: %+v", got)
+			}
+		})
+	}
+}
