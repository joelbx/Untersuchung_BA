+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPortScanTOMLLoader(t *testing.T) {
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	data := `[servers.alpha]
+host = "192.0.2.1"
+port = "local"
+scanModules = ["ospkg", "port"]
+[servers.alpha.portscan]
+scannerBinPath = "/bin/sh"
+scanTechniques = ["sT"]
+[servers.beta]
+host = "192.0.2.2"
+port = "local"
+scanModules = ["ospkg", "port"]
+`
+	if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if Conf.Servers["alpha"].PortScan == nil || !Conf.Servers["alpha"].PortScan.IsUseExternalScanner {
+		t.Fatal("external flag missing")
+	}
+	if Conf.Servers["beta"].PortScan == nil || Conf.Servers["beta"].PortScan.IsUseExternalScanner {
+		t.Fatal("native server incorrectly uses external scanner")
+	}
+}
