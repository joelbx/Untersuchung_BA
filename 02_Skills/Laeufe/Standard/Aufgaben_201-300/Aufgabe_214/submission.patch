+++ b/config/portscan_test.go
@@ -0,0 +1,84 @@
+package config
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniqueMapping(t *testing.T) {
+	cases := []struct {
+		code string
+		want ScanTechnique
+	}{{"sS", TCPSYN}, {"sT", TCPConnect}, {"sA", TCPACK}, {"sW", TCPWindow}, {"sM", TCPMaimon}, {"sN", TCPNull}, {"sF", TCPFIN}, {"sX", TCPXmas}}
+	for _, tc := range cases {
+		if tc.want.String() != tc.code {
+			t.Errorf("%v String = %q", tc.want, tc.want.String())
+		}
+		for _, code := range []string{tc.code, strings.ToUpper(tc.code)} {
+			got := (&PortScanConf{ScanTechniques: []string{code}}).GetScanTechniques()
+			if !reflect.DeepEqual(got, []ScanTechnique{tc.want}) {
+				t.Errorf("%q = %v", code, got)
+			}
+		}
+	}
+	if len((&PortScanConf{}).GetScanTechniques()) != 0 {
+		t.Fatal("empty techniques returned a value")
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad"}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{NotSupportTechnique}) {
+		t.Fatalf("unsupported = %v", got)
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	tests := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"native", PortScanConf{}, ""},
+		{"missing binary", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"sT", "sT"}}, "multiple"},
+		{"unprivileged", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"sS"}}, "privileges"},
+		{"connect source port", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"sT"}, SourcePort: "443"}, "incompatible"},
+		{"zero source port", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"sT"}, SourcePort: "0"}, "0 is not"},
+		{"out of range", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"sT"}, SourcePort: "65536"}, "[0,65535]"},
+		{"valid connect", PortScanConf{ScannerBinPath: "/bin/sh", ScanTechniques: []string{"sT"}}, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			if tc.want == "" && len(errs) != 0 {
+				t.Fatalf("unexpected errors: %v", errs)
+			}
+			if tc.want != "" {
+				found := false
+				for _, err := range errs {
+					if strings.Contains(err.Error(), tc.want) {
+						found = true
+					}
+				}
+				if !found {
+					t.Fatalf("wanted %q in %v", tc.want, errs)
+				}
+			}
+		})
+	}
+	if (PortScanConf{HasPrivileged: true}).IsZero() || (PortScanConf{SourcePort: "1"}).IsZero() || (PortScanConf{ScanTechniques: []string{"sT"}}).IsZero() || (PortScanConf{ScannerBinPath: "/bin/sh"}).IsZero() {
+		t.Fatal("nonempty configuration is zero")
+	}
+}
+
+func TestRequiredScanCapabilities(t *testing.T) {
+	for _, output := range []string{"/usr/bin/nmap cap_net_raw,cap_net_admin=ep", "/usr/bin/nmap cap_net_admin,cap_net_raw+ep"} {
+		if !hasRequiredScanCapabilities(output) {
+			t.Errorf("rejected %q", output)
+		}
+	}
+	for _, output := range []string{"", "/usr/bin/nmap cap_net_raw=ep", "/usr/bin/nmap cap_net_raw,cap_net_admin=p", "/usr/bin/nmap malformed=ep"} {
+		if hasRequiredScanCapabilities(output) {
+			t.Errorf("accepted %q", output)
+		}
+	}
+}
