diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..b51607d
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,124 @@
+package scanner
+
+import (
+	"context"
+	"encoding/xml"
+	"fmt"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+func (l *base) execPortsScan(dest map[string][]string) ([]string, error) {
+	if l.ServerInfo.PortScan != nil && l.ServerInfo.PortScan.IsUseExternalScanner {
+		return l.execExternalPortScan(dest)
+	}
+	return l.execNativePortScan(dest)
+}
+
+// setScanTechniques converts validated configuration values to nmap arguments.
+func setScanTechniques(conf config.PortScanConf) ([]string, error) {
+	techniques := conf.GetScanTechniques()
+	if len(techniques) > 1 {
+		return nil, fmt.Errorf("multiple scan techniques are not supported")
+	}
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		if technique == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+type nmapOutput struct {
+	Hosts []struct {
+		Address []struct {
+			Addr string `xml:"addr,attr"`
+			Type string `xml:"addrtype,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(dest map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil {
+		return nil, fmt.Errorf("portscan configuration is missing")
+	}
+	options, err := setScanTechniques(*conf)
+	if err != nil {
+		return nil, err
+	}
+	if conf.SourcePort != "" {
+		options = append(options, "-g", conf.SourcePort)
+	}
+	// A connect scan is available to an ordinary user when no mode is specified.
+	if len(conf.ScanTechniques) == 0 && !conf.HasPrivileged {
+		options = append(options, "-sT")
+	}
+	ips := make([]string, 0, len(dest))
+	for ip := range dest {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	open := []string{}
+	for _, ip := range ips {
+		if net.ParseIP(ip) == nil {
+			return nil, fmt.Errorf("invalid portscan destination %q", ip)
+		}
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		if len(dest[ip]) == 0 {
+			continue
+		}
+		args := append([]string{}, options...)
+		args = append(args, "-Pn", "-n", "-oX", "-", "-p", strings.Join(dest[ip], ","), ip)
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+		cmd := osexec.CommandContext(ctx, conf.ScannerBinPath, args...)
+		output, err := cmd.Output()
+		cancel()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed (%s): %w", ip, formatNmapOptionsToString(args), err)
+		}
+		var result nmapOutput
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("parse nmap output for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			address := ip
+			for _, addr := range host.Address {
+				if addr.Type == "ipv4" || addr.Type == "ipv6" {
+					address = addr.Addr
+					break
+				}
+			}
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.State == "open" {
+					open = append(open, address+":"+port.PortID)
+				}
+			}
+		}
+	}
+	return open, nil
+}
+
+// Keep the original correlation entry point available to callers.
+func (l *base) findPortScanSuccessOn(open []string, port models.PortStat) []string {
+	return l.findPortTestSuccessOn(open, port)
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..1db37bf
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,53 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "fake-nmap")
+	script := `#!/bin/sh
+printf '%s\n' "$*" > "` + binary + `.args"
+cat <<'XML'
+<?xml version="1.0"?><nmaprun><host><address addr="192.0.2.1" addrtype="ipv4"/><ports><port protocol="tcp" portid="22"><state state="open"/></port><port protocol="tcp" portid="80"><state state="closed"/></port></ports></host></nmaprun>
+XML
+`
+	if err := os.WriteFile(binary, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := base{ServerInfo: config.ServerInfo{Port: "local", PortScan: &config.PortScanConf{ScannerBinPath: binary, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"22", "80"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.1:22"}) {
+		t.Fatalf("open ports = %v", got)
+	}
+	args, err := os.ReadFile(binary + ".args")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(args) != "-sT -Pn -n -oX - -p 22,80 192.0.2.1\n" {
+		t.Fatalf("arguments = %q", args)
+	}
+}
+
+func TestSetScanTechniques(t *testing.T) {
+	for _, code := range []string{"sS", "sT", "sA", "sW", "sM", "sN", "sF", "sX"} {
+		got, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{code}})
+		if err != nil || !reflect.DeepEqual(got, []string{"-" + code}) {
+			t.Errorf("%s: %v, %v", code, got, err)
+		}
+	}
+	if _, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{"bad"}}); err == nil {
+		t.Fatal("unsupported technique accepted")
+	}
+	if _, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{"sT", "sS"}}); err == nil {
+		t.Fatal("multiple techniques accepted")
+	}
+}
