diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..ee35bcb
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,150 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan mode.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (t ScanTechnique) String() string {
+	switch t {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf controls the scanner running on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	if c == nil {
+		return nil
+	}
+	for _, value := range c.ScanTechniques {
+		technique := NotSupportTechnique
+		for _, candidate := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(value, candidate.String()) {
+				technique = candidate
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, technique)
+	}
+	return scanTechniques
+}
+
+// Validate reports every invalid setting relevant to an external scan.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath %q: %w", c.ScannerBinPath, err))
+	} else if info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath %q is not executable", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan scanTechniques %q is unsupported", c.ScanTechniques[i]))
+		}
+	}
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan multiple scan techniques are not supported"))
+	}
+	if !c.HasPrivileged && len(techniques) > 0 && techniques[0] != TCPConnect {
+		errs = append(errs, fmt.Errorf("portscan only TCPConnect (sT) is allowed without privileges"))
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort %q must be an integer in [0,65535]", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort 0 is not a usable source port"))
+		}
+		if (len(techniques) > 0 && techniques[0] == TCPConnect) || (len(techniques) == 0 && !c.HasPrivileged) {
+			errs = append(errs, fmt.Errorf("portscan sourcePort is incompatible with TCPConnect"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", "-n", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan capability check for %q failed: %w: %s", c.ScannerBinPath, err, strings.TrimSpace(string(output))))
+		} else {
+			caps := strings.ToLower(string(output))
+			if !hasRequiredScanCapabilities(caps) {
+				errs = append(errs, fmt.Errorf("portscan scannerBinPath %q has missing or malformed capabilities (need cap_net_raw and cap_net_admin effective)", c.ScannerBinPath))
+			}
+		}
+	}
+	return errs
+}
+
+// hasRequiredScanCapabilities accepts the effective rights emitted by getcap.
+func hasRequiredScanCapabilities(output string) bool {
+	for _, field := range strings.Fields(output) {
+		separator := strings.IndexAny(field, "=+")
+		if separator < 0 {
+			continue
+		}
+		names := strings.Split(field[:separator], ",")
+		raw, admin := false, false
+		for _, name := range names {
+			if name == "cap_net_raw" {
+				raw = true
+			}
+			if name == "cap_net_admin" {
+				admin = true
+			}
+		}
+		if raw && admin && strings.Contains(field[separator+1:], "e") {
+			return true
+		}
+	}
+	return false
+}
