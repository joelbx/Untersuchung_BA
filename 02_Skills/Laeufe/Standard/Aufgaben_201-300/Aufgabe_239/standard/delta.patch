+++ b/tests/mock_user_props_repo_test.go
@@ -0,0 +1,32 @@
+package tests
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestMockedUserPropsRepoScopesCompositeKeys(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("a_b", "c", "first"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("a", "b_c", "second"); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ userId, key, want string }{
+		{"a_b", "c", "first"},
+		{"a", "b_c", "second"},
+	} {
+		got, err := repo.DefaultGet(tc.userId, tc.key, "fallback")
+		if err != nil || got != tc.want {
+			t.Fatalf("DefaultGet(%q, %q) = %q, %v", tc.userId, tc.key, got, err)
+		}
+	}
+	if got, err := repo.DefaultGet("other", "c", "fallback"); err != nil || got != "fallback" {
+		t.Fatalf("missing user's default = %q, %v", got, err)
+	}
+	repo.err = errors.New("storage failure")
+	if _, err := repo.DefaultGet("a_b", "c", "fallback"); err != repo.err {
+		t.Fatalf("storage error = %v", err)
+	}
+}
