+type linkState struct {
+	UserID  string `json:"userId"`
+	Expires int64  `json:"expires"`
+}
+
+func (s *Router) startLink(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	if user.ID == "" {
+		_ = rest.RespondWithError(w, http.StatusUnauthorized, "user not authenticated")
+		return
+	}
+	data, err := json.Marshal(linkState{user.ID, time.Now().Add(10 * time.Minute).Unix()})
+	if err != nil {
+		_ = rest.RespondWithError(w, http.StatusInternalServerError, err.Error())
+		return
+	}
+	payload := base64.RawURLEncoding.EncodeToString(data)
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(payload))
+	state := payload + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+	_ = rest.RespondWithJSON(w, http.StatusOK, map[string]string{"state": state})
+}
+
+func (s *Router) verifyLinkState(state string) (string, bool) {
+	parts := strings.Split(state, ".")
+	if len(parts) != 2 {
+		return "", false
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", false
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(parts[0]))
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", false
+	}
+	data, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", false
+	}
+	var payload linkState
+	if json.Unmarshal(data, &payload) != nil || payload.UserID == "" || time.Now().Unix() >= payload.Expires {
+		return "", false
+	}
+	return payload.UserID, true
+}
