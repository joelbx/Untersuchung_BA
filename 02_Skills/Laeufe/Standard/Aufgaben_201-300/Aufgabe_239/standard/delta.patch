diff --git a/core/agents/lastfm/user_scope_test.go b/core/agents/lastfm/user_scope_test.go
new file mode 100644
index 0000000..18bfc32
--- /dev/null
+++ b/core/agents/lastfm/user_scope_test.go
@@ -0,0 +1,84 @@
+package lastfm
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestSessionKeysAreUserScoped(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	keys := &sessionKeys{ds: ds}
+	// The context names another user. Only the explicit ID may select a property.
+	ctx := request.WithUser(context.Background(), model.User{ID: "other"})
+	if err := keys.put(ctx, "first", "first-key"); err != nil {
+		t.Fatal(err)
+	}
+	if err := keys.put(ctx, "second", "second-key"); err != nil {
+		t.Fatal(err)
+	}
+	if err := keys.delete(ctx, "first"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := keys.get(ctx, "first"); err != model.ErrNotFound {
+		t.Fatalf("deleted user's key: got error %v", err)
+	}
+	if key, err := keys.get(ctx, "second"); err != nil || key != "second-key" {
+		t.Fatalf("other user's key: got %q, %v", key, err)
+	}
+}
+
+func TestLinkStateBindsAuthenticatedUser(t *testing.T) {
+	router := &Router{secret: "test-secret"}
+	ctx := request.WithUser(context.Background(), model.User{ID: "first"})
+	req := httptest.NewRequest(http.MethodPost, "/link/start", nil).WithContext(ctx)
+	recorder := httptest.NewRecorder()
+	router.startLink(recorder, req)
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("start link: %d", recorder.Code)
+	}
+	var response struct{ State string }
+	if err := json.Unmarshal(recorder.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	if id, ok := router.verifyLinkState(response.State); !ok || id != "first" {
+		t.Fatalf("valid state: got %q, %v", id, ok)
+	}
+	if _, ok := router.verifyLinkState(response.State + "x"); ok {
+		t.Fatal("tampered link state accepted")
+	}
+}
+
+func TestRouterLinkStatusAndUnlinkUseAuthenticatedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	router := &Router{ds: ds, sessionKeys: &sessionKeys{ds: ds}}
+	ctx := context.Background()
+	if err := router.sessionKeys.put(ctx, "first", "first-key"); err != nil {
+		t.Fatal(err)
+	}
+	if err := router.sessionKeys.put(ctx, "second", "second-key"); err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodDelete, "/link", nil)
+	req = req.WithContext(request.WithUser(req.Context(), model.User{ID: "first"}))
+	recorder := httptest.NewRecorder()
+	router.unlink(recorder, req)
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("unlink: %d", recorder.Code)
+	}
+	if key, err := router.sessionKeys.get(ctx, "second"); err != nil || key != "second-key" {
+		t.Fatalf("other user's key changed: %q, %v", key, err)
+	}
+	recorder = httptest.NewRecorder()
+	router.getLinkStatus(recorder, req)
+	var status struct{ Status bool }
+	if err := json.Unmarshal(recorder.Body.Bytes(), &status); err != nil || status.Status {
+		t.Fatalf("unlinked user's status: %v, %v", status.Status, err)
+	}
+}
