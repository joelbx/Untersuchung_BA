+@pytest.mark.parametrize('runtime, compiled_qt, pyqt, expected', [
+    ('6.2.2', '6.7.0', '6.7.0', set()),
+    ('6.2.3', '6.2.2', '6.2.2', {'.jpg', '.jpe'}),
+    ('6.6.9', '6.2.2', '6.2.2', {'.jpg', '.jpe'}),
+    ('6.7.0', '6.2.2', '6.2.2', set()),
+])
+def test_suffixes_workaround_runtime_bounds(monkeypatch, runtime, compiled_qt,
+                                           pyqt, expected):
+    monkeypatch.setattr(qtutils, 'qVersion', lambda: runtime)
+    monkeypatch.setattr(qtutils, 'QT_VERSION_STR', compiled_qt)
+    monkeypatch.setattr(qtutils, 'PYQT_VERSION_STR', pyqt)
+    monkeypatch.setattr(mimetypes, 'guess_all_extensions',
+                        lambda mime: ['.jpg', '.jpe'] if mime == 'image/jpeg' else [])
+    assert webview.extra_suffixes_workaround(['image/jpeg']) == expected
+
