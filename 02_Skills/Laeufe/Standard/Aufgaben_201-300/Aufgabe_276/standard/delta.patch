+					tt.provider, credentials["client_id"], credentials["client_secret"], credentials["redirect_address"])
+			}
+
+			path := t.TempDir() + "/config.yml"
+			config := fmt.Sprintf("authentication:\n  session:\n    domain: localhost\n  methods:\n    %s\n", method)
+			require.NoError(t, os.WriteFile(path, []byte(config), 0600))
+
+			_, err := Load(path)
+			require.EqualError(t, err, tt.wantErr)
+		})
+	}
+}
