diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index cbf68a2..b5bda44 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -75,3 +75,80 @@ def test_get_wikidata_entity(
             mock_get_from_cache.assert_called_once()
         else:
             mock_get_from_cache.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    'language, sitelinks, expected',
+    [
+        (
+            'fr',
+            {
+                'frwiki': {'url': 'https://fr.wikipedia.org/wiki/A'},
+                'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'},
+            },
+            ('https://fr.wikipedia.org/wiki/A', 'fr'),
+        ),
+        ('fr', {'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'}}, ('https://en.wikipedia.org/wiki/A', 'en')),
+        ('fr', {'frwiki': {'title': 'A'}, 'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'}}, ('https://en.wikipedia.org/wiki/A', 'en')),
+        ('fr', {'frwiki': {'title': 'A'}}, None),
+        ('en', {}, None),
+    ],
+)
+def test_get_wikipedia_link(language, sitelinks, expected):
+    entity = createWikidataEntity()
+    entity.sitelinks = sitelinks
+    assert entity._get_wikipedia_link(language) == expected
+
+
+def test_get_statement_values():
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'first'}},
+            {'value': {'content': 'second'}},
+            {'value': {}},
+            {'other': 'invalid'},
+            None,
+        ],
+        'P1': {'value': {'content': 'single'}},
+    }
+    assert entity._get_statement_values('P1960') == ['first', 'second']
+    assert entity._get_statement_values('P1') == ['single']
+    assert entity._get_statement_values('P2') == []
+
+
+def test_get_external_profiles():
+    entity = createWikidataEntity()
+    entity.sitelinks = {'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'}}
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'first'}},
+            {'value': {'content': 'second'}},
+        ]
+    }
+    assert entity.get_external_profiles('fr') == [
+        {
+            'url': 'https://en.wikipedia.org/wiki/A',
+            'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+            'label': 'Wikipedia',
+        },
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=first',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=second',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+    ]
+    entity.sitelinks = {}
+    assert [profile['label'] for profile in entity.get_external_profiles()] == [
+        'Wikidata', 'Google Scholar', 'Google Scholar'
+    ]
