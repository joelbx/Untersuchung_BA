+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "loadstart", "loadedmetadata", "loadeddata", "canplay", "canplaythrough",
+    "play", "playing", "pause", "ended", "waiting", "suspend", "emptied",
+    "durationchange", "timeupdate", "progress", "volumechange", "seeking",
+    "seeked", "ratechange",
+]);
+
+/** A listener for media element events used by legacy call audio. */
+export function handleEvent(e: Event): void {
+    const media = e.currentTarget as HTMLMediaElement | null;
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call audio event", { type: e.type, id: media?.id, error: media?.error });
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call audio event", { type: e.type, id: media?.id });
+    }
+}
