+def test_get_ia_record_multiple_places_and_publishers() -> None:
+    metadata = {
+        'publisher': [
+            '[London] ; New York ; Paris : [Berlitz Publishing]',
+            'Boston : Press A ; Chicago : Press B',
+            '  Exact publisher name  ',
+        ],
+        'isbn': [' 1234567890 ', ' 1234567890123 ', 'invalid'],
+    }
+    result = code.ia_importapi.get_ia_record(metadata)
+    assert result['publish_places'] == ['London', 'New York', 'Paris', 'Boston', 'Chicago']
+    assert result['publishers'] == [
+        'Berlitz Publishing', 'Press A', 'Press B', '  Exact publisher name  '
+    ]
+    assert result['isbn_10'] == ['1234567890']
+    assert result['isbn_13'] == ['1234567890123']
+
+
+def test_get_ia_record_multiple_places_from_string() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {'publisher': 'London ; New York ; Paris : Berlitz Publishing'}
+    )
+    assert result['publishers'] == ['Berlitz Publishing']
+    assert result['publish_places'] == ['London', 'New York', 'Paris']
+
+
+def test_get_ia_record_always_has_publishers_list() -> None:
+    assert code.ia_importapi.get_ia_record({})['publishers'] == []
