+def get_location_and_publisher(loc_pub: str) -> tuple[list[str], list[str]]:
+    """Extract ordered publication places and publishers from IA metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub:
+        return [], []
+
+    loc_pub = loc_pub.replace('Place of publication not identified', '')
+
+    def clean(value: str) -> str:
+        return value.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+
+    if ':' not in loc_pub:
+        publisher = clean(loc_pub.split(',', 1)[1] if ',' in loc_pub else loc_pub)
+        return [], [publisher] if publisher else []
+
+    places: list[str] = []
+    publishers: list[str] = []
+    pending_places: list[str] = []
+    for segment in loc_pub.split(';'):
+        if ':' not in segment:
+            place = clean(segment)
+            if place:
+                pending_places.append(place)
+            continue
+
+        # A third colon is outside the expected location : publisher pair.
+        location, publisher = get_colon_only_loc_pub(':'.join(segment.split(':')[:2]))
+        places.extend(pending_places)
+        pending_places.clear()
+        if place := clean(location):
+            places.append(place)
+        if name := clean(publisher):
+            publishers.append(name)
+
+    return places, publishers
 
 
