diff --git a/src/database/hashBulkIncrements.js b/src/database/hashBulkIncrements.js
new file mode 100644
index 0000000..5981b38
--- /dev/null
+++ b/src/database/hashBulkIncrements.js
@@ -0,0 +1,41 @@
+'use strict';
+
+module.exports = function (data, fieldToString) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+
+	const entries = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must contain [key, increments] tuples');
+		}
+		const fields = Object.entries(item[1]);
+		if (!fields.length) {
+			return;
+		}
+		let increments = entries.get(item[0]);
+		if (!increments) {
+			increments = Object.create(null);
+			entries.set(item[0], increments);
+		}
+		fields.forEach(([field, amount]) => {
+			const name = fieldToString(field);
+			if (!name || field === '__proto__' || field === 'constructor' || field === 'prototype' ||
+				name === '__proto__' || name === 'constructor' || name === 'prototype' || /[.$]/.test(field) || /[.$]/.test(name)) {
+				throw new TypeError(`Invalid bulk increment field: ${field}`);
+			}
+			if (!Number.isSafeInteger(amount)) {
+				throw new TypeError(`Bulk increment for ${field} must be a safe integer`);
+			}
+			const sum = (increments[name] || 0) + amount;
+			if (!Number.isSafeInteger(sum)) {
+				throw new TypeError(`Combined bulk increment for ${field} must be a safe integer`);
+			}
+			increments[name] = sum;
+		});
+	});
+	return entries;
+};
