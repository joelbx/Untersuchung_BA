+
+	describe('incrObjectFieldByBulk()', () => {
+		it('increments multiple fields and creates missing objects and fields', async () => {
+			const result = await db.incrObjectFieldByBulk([
+				['bulkIncrementExisting', { age: 5, newField: 10 }],
+				['bulkIncrementMissing', { age: -2 }],
+			]);
+			assert.strictEqual(result, undefined);
+			let existing = await db.getObject('bulkIncrementExisting');
+			assert.deepStrictEqual(Object.keys(existing).sort(), ['age', 'newField']);
+			assert.strictEqual(Number(existing.age), 5);
+			assert.strictEqual(Number(existing.newField), 10);
+			assert.strictEqual(Number((await db.getObject('bulkIncrementMissing')).age), -2);
+			await db.incrObjectFieldByBulk([['bulkIncrementExisting', { age: -3, newField: 1 }]]);
+			existing = await db.getObject('bulkIncrementExisting');
+			assert.strictEqual(Number(existing.age), 2);
+			assert.strictEqual(Number(existing.newField), 11);
+		});
+
+		it('rejects invalid input before writing', async () => {
+			await assert.rejects(db.incrObjectFieldByBulk({ key: { age: 1 } }), TypeError);
+			await assert.rejects(db.incrObjectFieldByBulk([['bulkIncrementInvalid', { age: 1.5 }]]), TypeError);
+			await assert.rejects(db.incrObjectFieldByBulk([['bulkIncrementInvalid', { 'a.b': 1 }]]), TypeError);
+			await assert.rejects(db.incrObjectFieldByBulk([['bulkIncrementInvalid', { constructor: 1 }]]), TypeError);
+			assert.strictEqual(await db.getObject('bulkIncrementInvalid'), null);
+		});
+
+		it('leaves all fields on an invalid object unchanged', async () => {
+			await db.setObject('bulkIncrementBad', { age: 1, name: 'text' });
+			await assert.rejects(db.incrObjectFieldByBulk([
+				['bulkIncrementBad', { age: 5, name: 2 }],
+				['bulkIncrementGood', { age: 3 }],
+			]));
+			const bad = await db.getObject('bulkIncrementBad');
+			assert.strictEqual(Number(bad.age), 1);
+			assert.strictEqual(bad.name, 'text');
+			assert.strictEqual(Number((await db.getObject('bulkIncrementGood')).age), 3);
+		});
+	});
 });
