@@ -261,4 +262,48 @@ module.exports = function (module) {
 			throw err;
 		}
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const entries = bulkIncrements(data, helpers.fieldToString);
+		if (!entries.size) {
+			return;
+		}
+		const keys = Array.from(entries.keys());
+		const operations = keys.map(key => ({
+			updateOne: {
+				filter: { _key: key },
+				update: { $inc: entries.get(key) },
+				upsert: true,
+			},
+		}));
+		try {
+			await module.client.collection('objects').bulkWrite(operations, { ordered: false });
+			cache.del(keys);
+		} catch (err) {
+			// Unordered writes continue after an individual object fails. Only evict
+			// objects whose writes succeeded; the failed objects remain untouched.
+			const errors = err.writeErrors || (err.result && err.result.getWriteErrors && err.result.getWriteErrors());
+			if (Array.isArray(errors) && errors.length) {
+				const failed = new Set(errors.map(error => error.index));
+				await Promise.all(errors.filter(error => error.code === 11000).map(async ({ index }) => {
+					try {
+						await module.client.collection('objects').updateOne(
+							{ _key: keys[index] }, { $inc: entries.get(keys[index]) }, { upsert: true }
+						);
+						failed.delete(index);
+					} catch (retryError) {
+						// Keep the original bulk error and do not evict the failed key.
+					}
+				}));
+				const succeeded = keys.filter((key, index) => !failed.has(index));
+				if (succeeded.length) {
+					cache.del(succeeded);
+				}
+				if (!failed.size) {
+					return;
+				}
+			}
+			throw err;
+		}
+	};
 };
diff --git a/src/database/redis/hash.js b/src/database/redis/hash.js
