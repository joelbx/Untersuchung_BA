--- a/src/database/redis/hash.js
+++ b/src/database/redis/hash.js
@@ -2,6 +2,26 @@
 
 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const bulkIncrements = require('../hashBulkIncrements');
+	const incrementFieldsScript = `
+for i = 1, #ARGV, 2 do
+	local current = redis.call('HGET', KEYS[1], ARGV[i])
+	if current then
+		if not string.match(current, '^%-?%d+$') then
+			return redis.error_reply('hash field is not an integer')
+		end
+		local value = tonumber(current)
+		local amount = tonumber(ARGV[i + 1])
+		if not value or math.abs(value) > 9007199254740991 or
+			math.abs(value + amount) > 9007199254740991 then
+			return redis.error_reply('hash increment is outside the safe integer range')
+		end
+	end
+end
+for i = 1, #ARGV, 2 do
+	redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+end
+return 1`;
 
 	const cache = require('../cache').create('redis');
 
@@ -219,4 +239,33 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const entries = bulkIncrements(data, String);
+		if (!entries.size) {
+			return;
+		}
+		const keys = Array.from(entries.keys());
+		const batch = module.client.batch();
+		keys.forEach((key) => {
+			const args = Object.entries(entries.get(key)).flatMap(([field, amount]) => [field, String(amount)]);
+			batch.eval(incrementFieldsScript, 1, key, ...args);
+		});
+		const results = await batch.exec();
+		const succeeded = [];
+		let error;
+		results.forEach(([err], index) => {
+			if (err) {
+				error = error || err;
+			} else {
+				succeeded.push(keys[index]);
+			}
+		});
+		if (succeeded.length) {
+			cache.del(succeeded);
+		}
+		if (error) {
+			throw error;
+		}
+	};
 };
