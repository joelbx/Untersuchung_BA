@@ -0,0 +1,112 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, dir, body string) string {
+	t.Helper()
+	path := filepath.Join(dir, "config.yml")
+	if err := ioutil.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path := writeConfig(t, dir, "# defaults\n")
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults: got %+v, want %+v", cfg, defaultConfig())
+	}
+
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, file := range []string{cert, key} {
+		if err := ioutil.WriteFile(file, []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path = writeConfig(t, dir, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: [foo.com]\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: "+cert+"\n  cert_key: "+key+"\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server != (serverConfig{"127.0.0.1", HTTPS, 8081, 8080, 9001, cert, key}) || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("advanced config: %+v", cfg)
+	}
+	path = writeConfig(t, dir, "cors:\n  allowed_origins: foo.com\n")
+	cfg, err = configure(path)
+	if err != nil || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("single origin: cfg=%+v err=%v", cfg, err)
+	}
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	cfg, err = configure(path)
+	if err != nil || cfg.Server.HTTPPort != 8181 {
+		t.Fatalf("environment override: cfg=%+v err=%v", cfg, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	file := filepath.Join(dir, "present")
+	if err := ioutil.WriteFile(file, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	missing := filepath.Join(dir, "missing")
+	for _, tc := range []struct{ cert, key, want string }{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{file, "", "cert_key cannot be empty when using HTTPS"},
+		{missing, file, "cannot find TLS cert_file at \"" + missing + "\""},
+		{file, missing, "cannot find TLS cert_key at \"" + missing + "\""},
+	} {
+		cfg := defaultConfig()
+		cfg.Server.Protocol = HTTPS
+		cfg.Server.CertFile, cfg.Server.CertKey = tc.cert, tc.key
+		if err := cfg.validate(); err == nil || err.Error() != tc.want {
+			t.Fatalf("cert=%q key=%q: got %v, want %q", tc.cert, tc.key, err, tc.want)
+		}
+	}
+	cfg := defaultConfig()
+	cfg.Server.CertFile, cfg.Server.CertKey = missing, missing
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("incorrect scheme strings")
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []interface {
+		ServeHTTP(http.ResponseWriter, *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		r := httptest.NewRecorder()
+		handler.ServeHTTP(r, httptest.NewRequest("GET", "/", nil))
+		if r.Code != 200 || strings.TrimSpace(r.Body.String()) == "" {
+			t.Fatalf("response: status=%d body=%q", r.Code, r.Body.String())
+		}
+	}
+}
