@@ -96,6 +96,28 @@ def import_item_db_staged(setup_item_db):
 
 
 class TestImportItem:
+    def test_find_staged_or_pending(self, import_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'id': 4, 'batch_id': 1, 'ia_id': 'amazon:123', 'status': 'staged'},
+                {'id': 5, 'batch_id': 1, 'ia_id': 'idb:456', 'status': 'pending'},
+                {'id': 6, 'batch_id': 1, 'ia_id': 'amazon:456', 'status': 'created'},
+                {'id': 7, 'batch_id': 1, 'ia_id': 'idb:other', 'status': 'staged'},
+                {'id': 8, 'batch_id': 1, 'ia_id': 'other:123', 'status': 'pending'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['123', '456'])
+        assert isinstance(result, web.db.SqliteResultSet)
+        assert {row.ia_id for row in result} == {'amazon:123', 'idb:456'}
+
+        result = ImportItem.find_staged_or_pending(['123'], sources=iter(['other']))
+        assert [row.ia_id for row in result] == ['other:123']
+
+        assert list(ImportItem.find_staged_or_pending([])) == []
+
