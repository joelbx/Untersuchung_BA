@@ -20,6 +21,35 @@ class MockPrivateEdition(models.Edition):
 
 
 class TestEdition:
+    def test_from_isbn_uses_staged_record_for_either_isbn_form(self, monkeypatch):
+        class Site:
+            imported = False
+
+            def things(self, query):
+                return ['/books/OL1M'] if self.imported and 'isbn_10' in query else []
+
+            def get(self, key):
+                return key
+
+        site = Site()
+        monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+        identifiers_seen = []
+        item = web.storage(ia_id='amazon:0306406152')
+
+        def find_staged_or_pending(identifiers):
+            identifiers_seen.extend(identifiers)
+            return [item]
+
+        monkeypatch.setattr(
+            models.ImportItem,
+            'find_staged_or_pending',
+            find_staged_or_pending,
+        )
+        monkeypatch.setattr(models, 'do_import', lambda item: setattr(site, 'imported', True))
+
+        assert models.Edition.from_isbn('0306406152') == '/books/OL1M'
+        assert identifiers_seen == ['9780306406157', '0306406152']
+
     def mock_edition(self, edition_class):
         data = {"key": "/books/OL1M", "type": {"key": "/type/edition"}, "title": "foo"}
         return edition_class(MockSite(), "/books/OL1M", data=data)
