@@ -1,6 +1,8 @@
 'use strict';
 
 const path = require('path');
+const fs = require('fs');
+const nconf = require('nconf');
 
 const db = require('../database');
 const image = require('../image');
@@ -62,6 +64,45 @@ module.exports = function (Groups) {
 	};
 
 	Groups.removeCover = async function (data) {
+		const urls = await db.getObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url']);
+		const prefix = `${nconf.get('relative_path') || ''}/assets/uploads/files/`;
+		const paths = Object.values(urls || {}).map((url) => {
+			// Upload URLs are stored without relative_path and rendered with it.
+			const matchingPrefix = typeof url === 'string' && [prefix, '/assets/uploads/files/'].find(p => url.startsWith(p));
+			if (!matchingPrefix) {
+				return false;
+			}
+			const filename = url.slice(matchingPrefix.length);
+			if (!filename || filename === '.' || filename === '..' || path.basename(filename) !== filename) {
+				return false;
+			}
+			return path.join(nconf.get('upload_path'), 'files', filename);
+		}).filter(Boolean);
+		// A later upload can use a different extension, leaving the previous variant behind.
+		if (paths.length) {
+			const folder = path.join(nconf.get('upload_path'), 'files');
+			let names = [];
+			try {
+				names = await fs.promises.readdir(folder);
+			} catch (err) {
+				if (err.code !== 'ENOENT') {
+					throw err;
+				}
+			}
+			const stems = paths.map(filename => path.parse(filename).name)
+				.filter(name => name.startsWith('groupCover-') || name.startsWith('groupCoverThumb-'));
+			paths.push(...names.filter(name => stems.some(stem => ['png', 'jpeg', 'jpg', 'bmp']
+				.some(ext => name === `${stem}.${ext}`))).map(name => path.join(folder, name)));
+		}
+		await Promise.all([...new Set(paths)].map(async (filename) => {
+			try {
+				await fs.promises.unlink(filename);
+			} catch (err) {
+				if (err.code !== 'ENOENT') {
+					throw err;
+				}
+			}
+		}));
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
 	};
 };
