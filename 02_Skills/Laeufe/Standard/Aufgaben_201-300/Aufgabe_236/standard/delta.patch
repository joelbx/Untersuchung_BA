+def test_check_type_dict_does_not_call_safe_eval(monkeypatch):
+    import ansible.module_utils.common.validation as validation
+
+    def fail(*args, **kwargs):
+        raise AssertionError('safe_eval must not be called')
+
+    monkeypatch.setattr(validation, 'safe_eval', fail)
+    before = len(get_deprecation_messages())
+    assert check_type_dict("{'key': 'value'}") == {'key': 'value'}
+    assert len(get_deprecation_messages()) == before
+
+
+def test_check_type_dict_does_not_execute_code(tmp_path):
+    marker = tmp_path / 'executed'
+    payload = "{'key': __import__('pathlib').Path(%r).touch()}" % str(marker)
+    with pytest.raises(TypeError):
+        check_type_dict(payload)
+    assert not marker.exists()
