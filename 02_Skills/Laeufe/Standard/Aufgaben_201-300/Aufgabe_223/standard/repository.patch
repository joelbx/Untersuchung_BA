+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/usr/bin/python3.8 -I\nprint(1)\n', {}, b'#!/usr/bin/python3.8 -I'),
+    (b'#!/usr/bin/python3.8  -I "two words"\nprint(1)\n',
+     {'ansible_python_interpreter': '/usr/bin/python3.8'}, b'#!/usr/bin/python3.8  -I "two words"'),
+    (b'#!/opt/venv/bin/python -B\nprint(1)\n', {}, b'#!/opt/venv/bin/python -B'),
+    (b'#!/usr/bin/python3.8 -I\nprint(1)\n', {'ansible_python_interpreter': '/opt/python'}, b'#!/opt/python -I'),
+    (b'#!/usr/bin/python3.8  -I "two words"\nprint(1)\n',
+     {'ansible_python_interpreter': '/opt/python'}, b'#!/opt/python  -I "two words"'),
+    (b'print(1)\n', {}, b'#!/usr/bin/python'),
+    (b'#!/usr/bin/ruby -w\nputs 1\n', {}, b'#!/usr/bin/ruby -w'),
+    (b'#!/usr/bin/ruby  -w\nputs 1\n', {}, b'#!/usr/bin/ruby  -w'),
+    (b'#!/usr/bin/ruby -w\nputs 1\n', {'ansible_ruby_interpreter': '/opt/ruby'}, b'#!/opt/ruby -w'),
+    (b'#!/usr/bin/ruby  -w "two words"\nputs 1\n',
+     {'ansible_ruby_interpreter': '/opt/ruby'}, b'#!/opt/ruby  -w "two words"'),
+])
+def test_module_shebang(tmp_path, templar, source, task_vars, expected):
+    module_path = tmp_path / 'sample'
+    module_path.write_bytes(source)
+    data, style, shebang = modify_module('sample', str(module_path), {}, templar, task_vars=task_vars)
+    assert data.split(b'\n', 2)[:2] == [expected, b'# -*- coding: utf-8 -*-']
+    assert shebang == expected.decode('ascii')
+
+
+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/usr/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n', {}, b'#!/usr/bin/python3.8 -I'),
+    (b'#!/usr/bin/python3.8  -I "two words"\nfrom ansible.module_utils.basic import AnsibleModule\n',
+     {}, b'#!/usr/bin/python3.8  -I "two words"'),
+    (b'#!/usr/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n',
+     {'ansible_python_interpreter': '/opt/python'}, b'#!/opt/python -I'),
+    (b'#!/usr/bin/python3.8  -I "two words"\nfrom ansible.module_utils.basic import AnsibleModule\n',
+     {'ansible_python_interpreter': '/opt/python'}, b'#!/opt/python  -I "two words"'),
+    (b'from ansible.module_utils.basic import AnsibleModule\n', {}, b'#!/usr/bin/python'),
+])
+def test_new_style_python_shebang(tmp_path, mocker, templar, source, task_vars, expected):
+    from ansible.executor import module_common as amc
+
+    module_path = tmp_path / 'sample.py'
+    module_path.write_bytes(source)
+    mocker.patch.object(amc.C, 'DEFAULT_LOCAL_TMP', str(tmp_path))
+    mocker.patch.object(amc, 'recursive_finder')
+    mocker.patch.object(amc, '_add_module_to_zip')
+    data, style, shebang = modify_module('sample', str(module_path), {}, templar, task_vars=task_vars)
+    assert style == 'new'
+    assert data.split(b'\n', 2)[:2] == [expected, b'# -*- coding: utf-8 -*-']
+    assert shebang == expected.decode('ascii')
