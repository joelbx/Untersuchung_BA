+def _extract_interpreter(b_module_data):
+    """Read the interpreter and its arguments from a module's first line."""
+    b_first_line = b_module_data.split(b'\n', 1)[0]
+    if not b_first_line.startswith(b'#!'):
+        return None, []
+    parts = shlex.split(to_native(b_first_line[2:], errors='surrogate_or_strict'))
+    if not parts:
+        return None, []
+    return (to_text(parts[0], errors='surrogate_or_strict'),
+            [to_text(arg, errors='surrogate_or_strict') for arg in parts[1:]])
+
+
+def _replace_shebang_interpreter(b_shebang, interpreter):
+    """Keep the original argument text when changing a shebang's interpreter."""
+    match = re.match(br'#![ \t]*[^ \t\r\n]+(.*)', b_shebang)
+    suffix = match.group(1) if match else b''
+    return b'#!' + to_bytes(interpreter, errors='surrogate_or_strict') + suffix
+
