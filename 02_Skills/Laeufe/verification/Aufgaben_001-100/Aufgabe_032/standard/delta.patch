+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'job', '1', '/bin/true', '_'])
+
+        def fail_fork():
+            raise OSError('fork unavailable')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        lines = capsys.readouterr().out.splitlines()
+        assert len(lines) == 1
+        result = json.loads(lines[0])
+        assert result['failed'] is True
+        assert result['finished'] == 1
+        assert result['ansible_job_id'].startswith('job.')
+        with open(str(tmp_path / result['ansible_job_id'])) as jobfile:
+            assert json.load(jobfile) == result
+
+    def test_timeout_writes_completed_failure(self, tmp_path):
+        module = tmp_path / 'module.py'
+        module.write_text('#!%s\nimport time\ntime.sleep(30)\n' % sys.executable)
+        jobdir = tmp_path / 'jobs'
+        env = os.environ.copy()
+        env['ANSIBLE_ASYNC_DIR'] = str(jobdir)
+        env['PYTHONPATH'] = os.path.abspath('lib')
+        launch = subprocess.run(
+            [sys.executable, '-m', 'ansible.modules.async_wrapper', 'timeout', '1', str(module), '_'],
+            env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=10,
+        )
+        assert launch.returncode == 0, launch.stderr
+        lines = launch.stdout.splitlines()
+        assert len(lines) == 1
+        immediate = json.loads(lines[0])
+        assert immediate['started'] == 1
+        assert immediate['finished'] == 0
+        deadline = time.time() + 10
+        result = None
+        while time.time() < deadline:
+            try:
+                with open(immediate['results_file']) as jobfile:
+                    result = json.load(jobfile)
+            except (IOError, ValueError):
+                pass
+            if result and result.get('finished'):
+                break
+            time.sleep(0.1)
+        assert result is not None
+        assert result['finished'] == 1
+        assert result['failed'] is True
+        assert result['ansible_job_id'] == immediate['ansible_job_id']
+        assert result['child_pid'] > 0
+        assert 'time limit' in result['msg']
