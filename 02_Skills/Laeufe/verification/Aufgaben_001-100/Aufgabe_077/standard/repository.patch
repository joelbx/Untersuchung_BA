@@ -49,3 +49,23 @@ def test_deprecate_without_list(am, capfd):
     assert output['deprecations'] == [
         {u'msg': u'Simple deprecation warning', u'version': None},
     ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_with_date_and_exit_json_merge(am, capfd):
+    am.deprecate('first', date='2030-12-31')
+    with pytest.raises(SystemExit):
+        am.exit_json(deprecations=[{'msg': 'second', 'date': '2031-01-01'}, 'third', ('fourth', '3.0')])
+    output = json.loads(capfd.readouterr()[0])
+    assert output['deprecations'] == [
+        {'msg': 'first', 'date': '2030-12-31'},
+        {'msg': 'second', 'date': '2031-01-01'},
+        {'msg': 'third', 'version': None},
+        {'msg': 'fourth', 'version': '3.0'},
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_rejects_version_and_date(am):
+    with pytest.raises(AssertionError, match='^implementation error -- version and date must not both be set$'):
+        am.deprecate('message', version='3.0', date='2030-12-31')
