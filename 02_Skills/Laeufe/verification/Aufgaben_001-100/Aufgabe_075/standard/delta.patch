@@ -0,0 +1,52 @@
+package tests
+
+import (
+	"errors"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+type mockUserProps struct {
+	userID string
+	data   map[string]map[string]string
+}
+
+func (r *mockUserProps) userData() (map[string]string, error) {
+	if r.userID == "" {
+		return nil, errors.New("user properties require a user in context")
+	}
+	if r.data[r.userID] == nil {
+		r.data[r.userID] = make(map[string]string)
+	}
+	return r.data[r.userID], nil
+}
+
+func (r *mockUserProps) Put(key, value string) error {
+	data, err := r.userData()
+	if err != nil {
+		return err
+	}
+	data[key] = value
+	return nil
+}
+
+func (r *mockUserProps) Get(key string) (string, error) {
+	data, err := r.userData()
+	if err != nil {
+		return "", err
+	}
+	value, ok := data[key]
+	if !ok {
+		return "", model.ErrNotFound
+	}
+	return value, nil
+}
+
+func (r *mockUserProps) Delete(key string) error {
+	data, err := r.userData()
+	if err != nil {
+		return err
+	}
+	delete(data, key)
+	return nil
+}
