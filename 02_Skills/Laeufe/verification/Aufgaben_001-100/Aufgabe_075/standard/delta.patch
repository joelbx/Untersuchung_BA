new file mode 100644
index 0000000..c33356b
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,61 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r userPropsRepository) currentUserID() (string, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return "", errors.New("user properties require a user in context")
+	}
+	return u.ID, nil
+}
+
+func (r userPropsRepository) Put(key, value string) error {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	// SQLite's upsert also handles an existing property whose value is unchanged.
+	stmt := Insert(r.tableName).Columns("user_id", "key", "value").
+		Values(uid, key, value).
+		Suffix("ON CONFLICT(user_id, key) DO UPDATE SET value = excluded.value")
+	_, err = r.executeSQL(stmt)
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return "", err
+	}
+	sel := Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key})
+	var row struct{ Value string }
+	if err := r.queryOne(sel, &row); err != nil {
+		return "", err
+	}
+	return row.Value, nil
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..12e4866
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,56 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User properties repository", func() {
+	var first, second model.UserPropsRepository
+
+	BeforeEach(func() {
+		o := orm.NewOrm()
+		_, err := o.Raw(`insert or ignore into user(id, user_name, email, password, created_at, updated_at)
+			values ('props-user-1', 'props-user-1', 'props-user-1@example.com', '', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
+			       ('props-user-2', 'props-user-2', 'props-user-2@example.com', '', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`).Exec()
+		Expect(err).NotTo(HaveOccurred())
+		first = NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-1"}), o)
+		second = NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-2"}), o)
+		Expect(first.Delete("test-key")).To(Succeed())
+		Expect(second.Delete("test-key")).To(Succeed())
+	})
+
+	It("keeps values scoped to each user through updates and deletion", func() {
+		Expect(first.Put("test-key", "first")).To(Succeed())
+		_, err := second.Get("test-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+	})
+
+	It("updates and deletes only the current user's value", func() {
+		Expect(first.Put("test-key", "first")).To(Succeed())
+		Expect(second.Put("test-key", "second")).To(Succeed())
+		Expect(first.Put("test-key", "updated")).To(Succeed())
+		value, err := first.Get("test-key")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("updated"))
+		Expect(first.Delete("test-key")).To(Succeed())
+		_, err = first.Get("test-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		value, err = second.Get("test-key")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("second"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("key", "value")).To(HaveOccurred())
+		_, err := repo.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(repo.Delete("key")).To(HaveOccurred())
+	})
+})
