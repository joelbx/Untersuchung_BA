index 0000000..995cfad
--- /dev/null
+++ b/db/migration/20210619231717_create_user_props_table.go
@@ -0,0 +1,39 @@
+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props (
+	user_id varchar(255) not null references user(id) on update cascade on delete cascade,
+	key varchar(255) not null,
+	value varchar not null,
+	primary key (user_id, key)
+);
+
+insert into user_props(user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from property p join user u on p.id = 'LastFMSessionKey_' || u.id;
+
+delete from property
+where id in (select 'LastFMSessionKey_' || user_id from user_props where key = 'LastFMSessionKey');
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+insert or replace into property(id, value)
+select 'LastFMSessionKey_' || user_id, value from user_props where key = 'LastFMSessionKey';
+drop table user_props;
+`)
+	return err
+}
diff --git a/db/migration/20210619231717_create_user_props_table_test.go b/db/migration/20210619231717_create_user_props_table_test.go
new file mode 100644
index 0000000..b5afdba
--- /dev/null
+++ b/db/migration/20210619231717_create_user_props_table_test.go
@@ -0,0 +1,60 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`
+create table user (id text primary key);
+create table property (id text primary key, value text not null);
+insert into user(id) values ('user-1'), ('user-2');
+insert into property(id, value) values
+  ('LastFMSessionKey_user-1', 'session-1'),
+  ('LastFMSessionKey_user-2', 'session-2'),
+  ('OtherProperty', 'untouched');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	for userID, want := range map[string]string{"user-1": "session-1", "user-2": "session-2"} {
+		var got string
+		if err := db.QueryRow(`select value from user_props where user_id = ? and key = 'LastFMSessionKey'`, userID).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != want {
+			t.Fatalf("session for %s = %q, want %q", userID, got, want)
+		}
+	}
+	var count int
+	if err := db.QueryRow(`select count(*) from property where id like 'LastFMSessionKey_%'`).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Fatalf("%d legacy session keys remain", count)
+	}
+	var value string
+	if err := db.QueryRow(`select value from property where id = 'OtherProperty'`).Scan(&value); err != nil || value != "untouched" {
+		t.Fatalf("unrelated property = %q, error = %v", value, err)
+	}
+}
