new file mode 100644
index 0000000..689d33f
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,148 @@
+package model
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+const (
+	perMessage = 3
+	perRole    = 1
+	perRequest = 3
+)
+
+// TokenCounter reports a token count.
+type TokenCounter interface{ TokenCount() int }
+
+// TokenCounters is a collection of counters.
+type TokenCounters []TokenCounter
+
+// CountAll sums the counters.
+func (c TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range c {
+		if validCounter(counter) {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+func validCounter(counter TokenCounter) bool {
+	if counter == nil {
+		return false
+	}
+	v := reflect.ValueOf(counter)
+	switch v.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return !v.IsNil()
+	default:
+		return true
+	}
+}
+
+// TokenCount collects prompt and completion usage for an invocation.
+type TokenCount struct {
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount returns an empty usage collector.
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+
+// AddPromptCounter adds a prompt counter.
+func (c *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if validCounter(prompt) {
+		c.prompt = append(c.prompt, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion counter.
+func (c *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if validCounter(completion) {
+		c.completion = append(c.completion, completion)
+	}
+}
+
+// CountAll returns prompt and completion totals, in that order.
+func (c *TokenCount) CountAll() (int, int) { return c.prompt.CountAll(), c.completion.CountAll() }
+
+// StaticTokenCounter holds a fixed token count.
+type StaticTokenCounter struct{ count int }
+
+// TokenCount returns the fixed count.
+func (c *StaticTokenCounter) TokenCount() int { return c.count }
+
+// NewPromptTokenCounter counts prompt content and message overhead.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	enc := codec.NewCl100kBase()
+	count := 0
+	for _, message := range messages {
+		tokens, _, err := enc.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter counts a completed response.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter counts tokens received after a starting fragment.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter counts the starting fragment.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add records one token unless the count has been finalized.
+func (c *AsynchronousTokenCounter) Add() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count++
+	return nil
+}
+
+// setCount updates a stream from its complete text so token merges across
+// chunk boundaries are counted correctly.
+func (c *AsynchronousTokenCounter) setCount(count int) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count = count
+	return nil
+}
+
+// TokenCount finalizes and returns the count. Repeated calls return the same value.
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
