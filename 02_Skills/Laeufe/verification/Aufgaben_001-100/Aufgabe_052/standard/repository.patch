index 0000000..884b2fb
--- /dev/null
+++ b/lib/ai/model/tokencount_test.go
@@ -0,0 +1,45 @@
+package model
+
+import (
+	"testing"
+
+	"github.com/sashabaranov/go-openai"
+	"github.com/stretchr/testify/require"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+func TestTokenCount(t *testing.T) {
+	enc := codec.NewCl100kBase()
+	encode := func(s string) int {
+		tokens, _, err := enc.Encode(s)
+		require.NoError(t, err)
+		return len(tokens)
+	}
+
+	prompt, err := NewPromptTokenCounter([]openai.ChatCompletionMessage{
+		{Role: openai.ChatMessageRoleSystem, Content: "Hello"},
+		{Role: openai.ChatMessageRoleUser, Content: "world!"},
+	})
+	require.NoError(t, err)
+	completion, err := NewSynchronousTokenCounter("Goodbye world!")
+	require.NoError(t, err)
+	stream, err := NewAsynchronousTokenCounter("Hello")
+	require.NoError(t, err)
+	require.NoError(t, stream.Add())
+
+	count := NewTokenCount()
+	count.AddPromptCounter(nil)
+	count.AddCompletionCounter(nil)
+	var nilStatic *StaticTokenCounter
+	count.AddPromptCounter(nilStatic)
+	count.AddCompletionCounter(nilStatic)
+	count.AddPromptCounter(prompt)
+	count.AddCompletionCounter(completion)
+	count.AddCompletionCounter(stream)
+	gotPrompt, gotCompletion := count.CountAll()
+	require.Equal(t, 2*(perMessage+perRole)+encode("Hello")+encode("world!"), gotPrompt)
+	require.Equal(t, 2*perRequest+encode("Goodbye world!")+encode("Hello")+1, gotCompletion)
+	require.Equal(t, gotCompletion, TokenCounters{completion, stream}.CountAll())
+	require.Error(t, stream.Add())
+	require.Equal(t, perRequest+encode("Hello")+1, stream.TokenCount())
+}
