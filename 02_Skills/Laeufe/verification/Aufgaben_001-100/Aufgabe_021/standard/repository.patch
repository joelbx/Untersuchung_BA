@@ -19,6 +19,32 @@ def test_process_seeds():
     assert f("subject:love") == "subject:love"
 
 
+@pytest.mark.parametrize(
+    'key,expected',
+    [
+        ('/subjects/foo,bar__baz', 'subject:foo_bar_baz'),
+        ('/subjects/place:new__york', 'place:new_york'),
+        ('/subjects/person:jane,doe', 'person:jane_doe'),
+        ('/subjects/time:20th_century', 'time:20th_century'),
+    ],
+)
+def test_subject_key_to_seed(key, expected):
+    assert lists.subject_key_to_seed(key) == expected
+    assert lists.is_seed_subject_string(expected)
+
+
+def test_seed_subject_prefix_is_exact():
+    assert not lists.is_seed_subject_string('subjects:foo')
+    assert not lists.is_seed_subject_string('placebo:foo')
+    assert not lists.is_seed_subject_string('/subjects/foo')
+
+
