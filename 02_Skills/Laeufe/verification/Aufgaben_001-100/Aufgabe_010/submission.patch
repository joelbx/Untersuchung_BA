+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import { mount, shallow } from "enzyme";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import DisambiguatedProfile from "../../../../src/components/views/messages/DisambiguatedProfile";
+import { RoomPermalinkCreator } from "../../../../src/utils/permalinks/Permalinks";
+
+describe("ReplyPreview", () => {
+    it("identifies the reply recipient and offers a labelled cancel control", () => {
+        const event = new MatrixEvent({
+            event_id: "$reply:server",
+            room_id: "!room:server",
+            sender: "@alice:server",
+            type: "m.room.message",
+            content: { body: "Hello", msgtype: "m.text" },
+        });
+        const wrapper = shallow(<ReplyPreview
+            replyToEvent={event}
+            permalinkCreator={{} as RoomPermalinkCreator}
+        />);
+
+        expect(wrapper.find(".mx_ReplyPreview_header").text()).toContain("Replying to");
+        expect(wrapper.find("SenderProfile").prop("mxEvent")).toBe(event);
+        expect(wrapper.find("SenderProfile").prop("element")).toBe("span");
+        expect(wrapper.find("SenderProfile").prop("showForEmote")).toBe(true);
+        expect(wrapper.find("CancelButton").prop("aria-label")).toBe("Cancel reply");
+    });
+
+    it("supports an inline profile without changing the default block markup", () => {
+        const inline = mount(<DisambiguatedProfile fallbackName="Alice" element="span" />);
+        const block = mount(<DisambiguatedProfile fallbackName="Alice" />);
+
+        expect(inline.find("span.mx_DisambiguatedProfile").text()).toBe("Alice");
+        expect(block.find("div.mx_DisambiguatedProfile").text()).toBe("Alice");
+    });
+});
