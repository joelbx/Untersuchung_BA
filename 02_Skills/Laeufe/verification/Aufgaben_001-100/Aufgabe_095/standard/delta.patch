+class patron_check_ins(delegate.page):
+    path = r'/people/([^/]+)/check-ins'
+
+    def is_valid(self, data: dict) -> bool:
+        """Require an event ID and at least one field to update."""
+        return isinstance(data, dict) and 'id' in data and (
+            'year' in data or 'data' in data
+        )
+
+    def POST(self, username):
+        data = json.loads(web.data())
+        if not self.is_valid(data):
+            return web.badrequest(message='Invalid request')
+
+        user = get_current_user()
+        if not user or user['key'].split('/')[-1] != username:
+            return web.forbidden()
+
+        event_id = data['id']
+        if not any(
+            event['id'] == event_id
+            for event in BookshelvesEvents.select_all_by_username(username)
+        ):
+            return web.notfound()
+
+        if 'year' in data:
+            date_str = make_date_string(
+                data['year'], data.get('month'), data.get('day')
+            )
+            BookshelvesEvents.update_event_date(event_id, date_str)
+        if 'data' in data:
+            BookshelvesEvents.update_event_data(event_id, data['data'])
+
+        return delegate.RawText(json.dumps({'status': 'ok'}))
 
 
