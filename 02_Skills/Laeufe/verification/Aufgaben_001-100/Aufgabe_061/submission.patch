+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages = models.NewPackages(models.Package{
+		Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64",
+	})
+	owners, err := r.parseOwnerPkgs(`libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 38.el7 x86_64
+error: file /proc/1/exe: Permission denied
+file /missing is not owned by any package
+error: file /gone: No such file or directory
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(owners, []string{"libgcc"}) {
+		t.Fatalf("owners = %v, want libgcc once", owners)
+	}
+	for _, line := range []string{"unexpected rpm output", "libgcc 0 4.8.5", "error: unrelated failure", "error: file /tmp unexpected failure"} {
+		if _, err := r.parseOwnerPkgs(line); err == nil {
+			t.Errorf("expected error for %q", line)
+		}
+	}
