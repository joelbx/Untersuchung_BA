+// Hasher holds a seed for each identifier. The global seed is used only to
+// generate fresh seeds; explicit seeds produce the same hash in any instance.
+type Hasher struct {
+	mu         sync.Mutex
+	seeds      map[string]string
+	globalSeed maphash.Seed
+	counter    uint64
+}
+
+func NewHasher() *Hasher {
+	return &Hasher{
+		seeds:      make(map[string]string),
+		globalSeed: maphash.MakeSeed(),
+	}
+}
+
+// SetSeed assigns a reproducible seed to the given identifier.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.seeds[id] = seed
