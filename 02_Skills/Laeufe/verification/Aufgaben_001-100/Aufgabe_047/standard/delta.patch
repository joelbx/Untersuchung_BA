+func (h *Hasher) reseed(id string) string {
+	h.counter++
+	var seed [16]byte
+	binary.LittleEndian.PutUint64(seed[:8], h.counter)
+	binary.LittleEndian.PutUint64(seed[8:], maphash.String(h.globalSeed, id))
+	h.seeds[id] = string(seed[:])
+	return h.seeds[id]
