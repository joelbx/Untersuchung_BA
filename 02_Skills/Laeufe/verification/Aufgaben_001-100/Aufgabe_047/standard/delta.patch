--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -13,6 +13,49 @@ func TestHasher(t *testing.T) {
 	RunSpecs(t, "Hasher Suite")
 }
 
+func TestExplicitSeedCanBeRestored(t *testing.T) {
+	h := hasher.NewHasher()
+	hash := h.HashFunc()
+	h.SetSeed("user", "first")
+	first := hash("user", "song")
+	if first != hash("user", "song") {
+		t.Fatal("same seed and input produced different hashes")
+	}
+	h.SetSeed("user", "second")
+	if first == hash("user", "song") {
+		t.Fatal("changing the seed did not change the hash")
+	}
+	h.SetSeed("user", "first")
+	if first != hash("user", "song") {
+		t.Fatal("restoring the seed did not restore the hash")
+	}
+	h.Reseed("user")
+	if first == hash("user", "song") {
+		t.Fatal("reseeding did not change the hash")
+	}
+	h.SetSeed("user", "first")
+	if first != hash("user", "song") {
+		t.Fatal("restoring the seed after reseeding did not restore the hash")
+	}
+
+	other := hasher.NewHasher()
+	other.SetSeed("user", "first")
+	if first != other.HashFunc()("user", "song") {
+		t.Fatal("explicit seed was not reproducible across hasher instances")
+	}
+}
+
+func TestGlobalSetSeed(t *testing.T) {
+	hasher.SetSeed("global-test", "known")
+	hash := hasher.HashFunc()
+	first := hash("global-test", "song")
+	hasher.Reseed("global-test")
+	hasher.SetSeed("global-test", "known")
+	if first != hash("global-test", "song") {
+		t.Fatal("global seed was not restored")
+	}
+}
+
