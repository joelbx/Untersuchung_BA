+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+func TestNewResource(t *testing.T) {
+	ctx := context.Background()
+	check := func(wantName string) {
+		t.Helper()
+		res, err := newResource(ctx, "1.2.3")
+		if err != nil {
+			t.Fatal(err)
+		}
+		attrs := map[attribute.Key]attribute.Value{}
+		for _, kv := range res.Attributes() {
+			attrs[kv.Key] = kv.Value
+		}
+		for key, want := range map[attribute.Key]string{
+			"service.name":    wantName,
+			"service.version": "1.2.3",
+		} {
+			if got := attrs[key].AsString(); got != want {
+				t.Errorf("%s = %q, want %q", key, got, want)
+			}
+		}
+	}
+	check("flipt")
+	t.Setenv("OTEL_SERVICE_NAME", "custom-flipt")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "deployment.environment=testing")
+	check("custom-flipt")
+	res, err := newResource(ctx, "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, ok := res.Set().Value("deployment.environment"); !ok || got.AsString() != "testing" {
+		t.Errorf("environment attribute = %v, present = %v", got, ok)
+	}
+}
+
+func TestNewProvider(t *testing.T) {
+	p, err := NewProvider(context.Background(), "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, span := p.Tracer("test").Start(context.Background(), "sampled")
+	if !span.SpanContext().IsSampled() {
+		t.Error("provider did not sample the span")
+	}
+	span.End()
+	if err := p.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestGetExporter(t *testing.T) {
+	cases := []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"otlp http", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318/v1/traces", Headers: map[string]string{"key": "value"}}}},
+		{"otlp https", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"otlp grpc", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317", Headers: map[string]string{"key": "value"}}}},
+		{"otlp host port", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317", Headers: map[string]string{"key": "value"}}}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			exp, shutdown, err := GetExporter(context.Background(), &tc.cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if exp == nil || shutdown == nil {
+				t.Fatal("missing exporter or shutdown")
+			}
+			if err := shutdown(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	// A failed invocation must not poison a later invocation.
+	bad := config.TracingConfig{}
+	_, _, err := GetExporter(context.Background(), &bad)
+	if err == nil || !strings.HasPrefix(err.Error(), "unsupported tracing exporter:") {
+		t.Fatalf("unexpected unsupported exporter error: %v", err)
+	}
+	good := cases[0].cfg
+	exp, shutdown, err := GetExporter(context.Background(), &good)
+	if err != nil || exp == nil || shutdown == nil {
+		t.Fatalf("later invocation: exporter present %t, shutdown present %t, error %v", exp != nil, shutdown != nil, err)
+	}
+	if err := shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	for _, endpoint := range []string{"", "http://", "ftp://localhost:4317", "grpc://localhost:4317/path", "grpc://localhost"} {
+		cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: endpoint}}
+		_, _, err := GetExporter(context.Background(), &cfg)
+		if err == nil || !strings.Contains(err.Error(), "parsing otlp endpoint:") {
+			t.Errorf("endpoint %q: expected parsing error, got %v", endpoint, err)
+		}
+	}
+}
+
+func TestOTLPHTTPHeaders(t *testing.T) {
+	type request struct {
+		header http.Header
+		path   string
+	}
+	requests := make(chan request, 1)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- request{r.Header.Clone(), r.URL.Path}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	cfg := config.TracingConfig{
+		Exporter: config.TracingOTLP,
+		OTLP: config.OTLPTracingConfig{
+			Endpoint: srv.URL + "/v1/traces",
+			Headers:  map[string]string{"X-Test-Trace": "present"},
+		},
+	}
+	exp, shutdown, err := GetExporter(context.Background(), &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSyncer(exp))
+	_, span := provider.Tracer("test").Start(context.Background(), "span")
+	span.End()
+	if err := provider.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err := shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case req := <-requests:
+		if got := req.header.Get("X-Test-Trace"); got != "present" {
+			t.Errorf("header = %q, want present", got)
+		}
+		if req.path != "/v1/traces" {
+			t.Errorf("path = %q, want /v1/traces", req.path)
+		}
+	default:
+		t.Fatal("OTLP HTTP exporter sent no request")
+	}
+}
