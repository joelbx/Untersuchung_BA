+++ b/lib/events/multilog_emitter_test.go
@@ -0,0 +1,71 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type testWriteCloser struct {
+	bytes.Buffer
+	closes   int
+	writeErr error
+	closeErr error
+}
+
+func (w *testWriteCloser) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	return w.Buffer.Write(p)
+}
+
+func (w *testWriteCloser) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+func TestWriterEmitter(t *testing.T) {
+	w := &testWriteCloser{}
+	emitter := NewWriterEmitter(w)
+	event := &SessionStart{}
+	event.SetType(SessionStartEvent)
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.True(t, strings.HasSuffix(w.String(), "\n"))
+	require.Contains(t, w.String(), SessionStartEvent)
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 2, w.closes)
+
+	w = &testWriteCloser{writeErr: io.ErrClosedPipe, closeErr: errors.New("close failed")}
+	emitter = NewWriterEmitter(w)
+	require.Error(t, emitter.EmitAuditEvent(context.Background(), event))
+	err := emitter.Close()
+	require.Error(t, err)
+	require.Equal(t, 2, w.closes)
+	require.Contains(t, err.Error(), "close failed")
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	w1, w2 := &testWriteCloser{}, &testWriteCloser{}
+	multi, err := NewMultiLog(NewWriterEmitter(w1), NewWriterEmitter(w2))
+	require.NoError(t, err)
+	var emitter Emitter = multi
+	event := &SessionStart{}
+	event.SetType(SessionStartEvent)
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, w1.String(), w2.String())
+	require.NotEmpty(t, w1.String())
+	require.NoError(t, multi.Close())
+	require.Equal(t, 2, w1.closes)
+	require.Equal(t, 2, w2.closes)
+
+	_, err = NewMultiLog(NewMockAuditLog(0))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.MockAuditLog")
+}
