+        finder = ModuleDepFinder(current_fqn)
+        finder.visit(tree)
+        imports = set(finder.submodules)
+        # The wrapper always imports basic to pass module arguments.
+        imports.add(('ansible', 'module_utils', 'basic'))
+        for parts in sorted(imports):
+            if parts[:3] == ('ansible', 'module_utils', 'six'):
+                parts = parts[:3]
+            if parts in queued:
+                continue
+            queued.add(parts)
+            locator = locate(parts, parts in finder.ambiguous_submodules)
+            if locator is None:
+                continue
+            if not locator.found:
+                raise AnsibleError('Could not find imported module support code for %s. Looked for (%s)' %
+                                   (current_fqn, ', '.join(locator.candidate_names_joined())))
+            result = locator.name_parts
+            key = result + (('__init__',) if locator.is_package and result != ('ansible', 'module_utils', 'basic') else ())
+            add_parents(result)
+            add_file(key, locator.source, locator.path)
+            redirect_target = locator.redirect_target
+            while redirect_target:
+                if redirect_target in queued:
+                    break
+                queued.add(redirect_target)
+                target = locate(redirect_target)
+                if target is None or not target.found:
+                    candidates = target.candidate_names_joined() if target else ['.'.join(redirect_target)]
+                    raise AnsibleError('Could not find imported module support code for %s. Looked for (%s)' %
+                                       (current_fqn, ', '.join(candidates)))
+                add_parents(target.name_parts)
+                add_file(target.name_parts + (('__init__',) if target.is_package else ()), target.source, target.path)
+                redirect_target = target.redirect_target
+    py_module_cache.clear()
 
 
