@@ -0,0 +1,58 @@
+import { EXTRA_EXTENSION_TYPES, SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+jest.mock('@proton/shared/lib/helpers/browser');
+
+const mockGetBrowser = jest.mocked(getBrowser);
+const mockGetOS = jest.mocked(getOS);
+
+describe('modern image MIME types', () => {
+    beforeEach(() => {
+        mockGetBrowser.mockReturnValue({ name: 'Safari', version: '17.0' });
+        mockGetOS.mockReturnValue({ name: 'Mac OS', version: '14.0' });
+    });
+
+    it('recognizes HEIC variants and JXL on Safari 17 on macOS', () => {
+        expect(isHEICSupported()).toBe(true);
+        expect(isJXLSupported()).toBe(true);
+        [
+            SupportedMimeTypes.heic,
+            SupportedMimeTypes.heics,
+            SupportedMimeTypes.heif,
+            SupportedMimeTypes.heifs,
+            SupportedMimeTypes.jxl,
+        ].forEach((type) => expect(isSupportedImage(type)).toBe(true));
+    });
+
+    it('recognizes Mobile Safari 17 on iOS', () => {
+        mockGetBrowser.mockReturnValue({ name: 'Mobile Safari', version: '17.1' });
+        mockGetOS.mockReturnValue({ name: 'iOS', version: '17.1' });
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(true);
+        expect(isSupportedImage(SupportedMimeTypes.heic)).toBe(true);
+    });
+
+    it.each([
+        ['Safari', '16.6', 'Mac OS'],
+        ['Chrome', '120', 'Mac OS'],
+        ['Safari', '17.0', 'Windows'],
+    ])('rejects modern images on %s %s on %s', (browser, version, os) => {
+        mockGetBrowser.mockReturnValue({ name: browser, version });
+        mockGetOS.mockReturnValue({ name: os, version: '' });
+        expect(isHEICSupported()).toBe(false);
+        expect(isJXLSupported()).toBe(false);
+        expect(isSupportedImage(SupportedMimeTypes.heic)).toBe(false);
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(false);
+    });
+
+    it('uses file type first, then extension when the type is unknown', async () => {
+        expect(EXTRA_EXTENSION_TYPES.jxl).toBe(SupportedMimeTypes.jxl);
+        expect(await mimeTypeFromFile(new File([], 'photo.jxl', { type: 'image/png' }))).toBe('image/png');
+        expect(await mimeTypeFromFile(new File([], 'photo.jxl'))).toBe(SupportedMimeTypes.jxl);
+        expect(await mimeTypeFromFile(new File([], 'photo.jxl', { type: 'application/octet-stream' }))).toBe(
+            SupportedMimeTypes.jxl
+        );
+    });
+});
