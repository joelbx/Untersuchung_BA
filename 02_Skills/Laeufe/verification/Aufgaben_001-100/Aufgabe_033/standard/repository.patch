diff --git a/lib/auth/u2f_challenge_test.go b/lib/auth/u2f_challenge_test.go
new file mode 100644
index 0000000..fec8584
--- /dev/null
+++ b/lib/auth/u2f_challenge_test.go
@@ -0,0 +1,47 @@
+package auth
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/u2f"
+)
+
+func TestU2FAuthenticateChallengeJSON(t *testing.T) {
+	first := u2f.AuthenticateChallenge{Version: "U2F_V2", Challenge: "first", KeyHandle: "key-1", AppID: "app"}
+	second := u2f.AuthenticateChallenge{Version: "U2F_V2", Challenge: "second", KeyHandle: "key-2", AppID: "app"}
+	request := U2FAuthenticateChallenge{
+		AuthenticateChallenge: &first,
+		Challenges:            []u2f.AuthenticateChallenge{first, second},
+	}
+	raw, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var legacy u2f.AuthenticateChallenge
+	if err := json.Unmarshal(raw, &legacy); err != nil {
+		t.Fatal(err)
+	}
+	if legacy != first {
+		t.Fatalf("legacy client got %+v, want %+v", legacy, first)
+	}
+	var multi U2FAuthenticateChallenge
+	if err := json.Unmarshal(raw, &multi); err != nil {
+		t.Fatal(err)
+	}
+	if multi.AuthenticateChallenge == nil || *multi.AuthenticateChallenge != first || len(multi.Challenges) != 2 || multi.Challenges[1] != second {
+		t.Fatalf("multi-device client got %+v", multi)
+	}
+
+	legacyRaw, err := json.Marshal(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fromLegacy U2FAuthenticateChallenge
+	if err := json.Unmarshal(legacyRaw, &fromLegacy); err != nil {
+		t.Fatal(err)
+	}
+	if fromLegacy.AuthenticateChallenge == nil || *fromLegacy.AuthenticateChallenge != first {
+		t.Fatalf("legacy server challenge got %+v", fromLegacy)
+	}
+}
