+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Split ISBNs by length, ignoring spaces and hyphens in each value."""
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    for value in [isbns] if isinstance(isbns, str) else (isbns or []):
+        if not isinstance(value, str):
+            continue
+        isbn = re.sub(r'[\s-]', '', value)
+        if re.fullmatch(r'\d{9}[\dXx]', isbn):
+            isbn_10.append(isbn)
+        elif re.fullmatch(r'\d{13}', isbn):
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
+
+def get_publisher_and_place(
+    publishers: str | list[str],
+) -> tuple[list[str], list[str]]:
+    """Split ``Place: Publisher`` entries into publisher and place lists."""
+    names: list[str] = []
+    places: list[str] = []
+    for value in [publishers] if isinstance(publishers, str) else (publishers or []):
+        if not isinstance(value, str):
+            continue
+        place, separator, name = value.partition(':')
+        if separator:
+            if name.strip() and place.strip():
+                names.append(name.strip())
+                places.append(place.strip())
+        elif place.strip():
+            names.append(place.strip())
+    return names, places
+
