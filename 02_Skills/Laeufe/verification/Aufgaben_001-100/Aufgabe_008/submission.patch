@@ -0,0 +1,72 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { RESPONSE_CODE } from '@proton/shared/lib/drive/constants';
+
+import useLink from './useLink';
+
+const mockRequest = jest.fn();
+const mockGetLink = jest.fn();
+const mockSetLinks = jest.fn();
+
+jest.mock('../_api/useDebouncedRequest', () => () => mockRequest);
+jest.mock('../_crypto', () => ({ useDriveCrypto: () => ({ getVerificationKey: jest.fn() }) }));
+jest.mock('../_shares', () => ({ useShare: () => ({ getSharePrivateKey: jest.fn() }) }));
+jest.mock('./useLinksKeys', () => () => ({}));
+jest.mock('./useLinksState', () => () => ({ getLink: mockGetLink, setLinks: mockSetLinks }));
+jest.mock('../_utils/useDebouncedFunction', () => () => (callback: () => Promise<unknown>) => callback());
+
+describe('useLink failed fetch backoff', () => {
+    const signal = new AbortController().signal;
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        mockRequest.mockReset();
+        mockGetLink.mockReset();
+        mockSetLinks.mockReset();
+    });
+
+    afterEach(() => {
+        jest.runOnlyPendingTimers();
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses error code %s for the same link and retries after the backoff',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequest.mockRejectedValueOnce(error).mockRejectedValueOnce(error);
+            const { result } = renderHook(() => useLink());
+
+            await expect(result.current.loadFreshLink(signal, 'share', `missing-${code}`)).rejects.toBe(error);
+            await expect(result.current.loadFreshLink(signal, 'share', `missing-${code}`)).rejects.toBe(error);
+            expect(mockRequest).toHaveBeenCalledTimes(1);
+
+            jest.advanceTimersByTime(5000);
+            await expect(result.current.loadFreshLink(signal, 'share', `missing-${code}`)).rejects.toBe(error);
+            expect(mockRequest).toHaveBeenCalledTimes(2);
+        }
+    );
+
+    it('does not delay a different link or share', async () => {
+        const error = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequest.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(signal, 'share', 'other')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(signal, 'another-share', 'missing')).rejects.toBe(error);
+        expect(mockRequest).toHaveBeenCalledTimes(3);
+    });
+
+    it('does not cache other errors and still processes successful fetches', async () => {
+        const error = { data: { Code: 9999 } };
+        mockRequest.mockRejectedValueOnce(error).mockResolvedValue({ Link: { LinkID: 'valid', Name: 'name' } });
+        mockGetLink.mockReturnValue({ encrypted: { name: 'name' }, decrypted: { name: 'decrypted' } });
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.loadFreshLink(signal, 'share', 'valid')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(signal, 'share', 'valid')).resolves.toEqual({ name: 'decrypted' });
+        expect(mockRequest).toHaveBeenCalledTimes(2);
+        expect(mockSetLinks).toHaveBeenCalledTimes(1);
+    });
+});
