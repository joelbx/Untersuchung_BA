diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..276f3b2
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,93 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+describe('WebFinger handler', () => {
+	const source = fs.readFileSync(path.join(__dirname, '../src/controllers/well-known.js'), 'utf8');
+	const hostname = 'forum.example';
+	const baseUrl = `https://${hostname}/community`;
+	let allowed;
+	let expectedUid;
+	let lookedUp;
+	let handler;
+
+	beforeEach(() => {
+		allowed = true;
+		expectedUid = 0;
+		lookedUp = [];
+		const exports = {};
+		const dependencies = {
+			nconf: { get: key => (key === 'url_parsed' ? { hostname: hostname } : baseUrl) },
+			'../privileges': {
+				global: {
+					can: async (privilege, uid) => {
+						assert.strictEqual(privilege, 'view:users');
+						assert.strictEqual(uid, expectedUid);
+						return allowed;
+					},
+				},
+			},
+			'../user': {
+				getUidByUserslug: async (slug) => {
+					lookedUp.push(slug);
+					return slug === 'alice' ? 42 : 0;
+				},
+				getUserField: async () => 'alice',
+			},
+		};
+		vm.runInNewContext(source, { exports: exports, require: name => dependencies[name] });
+		handler = exports.webfinger;
+	});
+
+	async function call(resource, uid) {
+		const response = {
+			status: 200,
+			sendStatus(code) { this.status = code; },
+			type(value) { this.contentType = value; return this; },
+			json(value) { this.body = value; },
+		};
+		await handler({ query: resource === undefined ? {} : { resource: resource }, uid: uid }, response);
+		return response;
+	}
+
+	it('rejects invalid resources before lookup', async () => {
+		const resources = [undefined, 'alice', 'acct:alice@other.example', `acct:@${hostname}`, `acct:alice@other@${hostname}`];
+		const results = await Promise.all(resources.map(call));
+		results.forEach(result => assert.strictEqual(result.status, 400));
+		assert.deepStrictEqual(lookedUp, []);
+	});
+
+	it('uses Guest privileges for anonymous requests', async () => {
+		allowed = false;
+		const response = await call(`acct:alice@${hostname}`);
+		assert.strictEqual(response.status, 403);
+		assert.deepStrictEqual(lookedUp, []);
+	});
+
+	it('checks the requesting user privilege', async () => {
+		expectedUid = 7;
+		allowed = false;
+		const response = await call(`acct:alice@${hostname}`, 7);
+		assert.strictEqual(response.status, 403);
+		assert.deepStrictEqual(lookedUp, []);
+	});
+
+	it('returns 404 for an unknown slug', async () => {
+		const response = await call(`acct:unknown@${hostname}`);
+		assert.strictEqual(response.status, 404);
+	});
+
+	it('returns WebFinger aliases and a profile link', async () => {
+		const resource = `acct:alice@${hostname}`;
+		const response = await call(resource);
+		const profileUrl = `${baseUrl}/user/alice`;
+		assert.strictEqual(response.status, 200);
+		assert.strictEqual(response.contentType, 'application/jrd+json');
+		assert.strictEqual(response.body.subject, resource);
+		assert.deepStrictEqual(Array.from(response.body.aliases), [`${baseUrl}/uid/42`, profileUrl]);
+		assert(response.body.links.some(link => link.href === profileUrl && link.type === 'text/html'));
+	});
+});
