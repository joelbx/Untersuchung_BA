+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestCallbackURL(t *testing.T) {
+	for _, tc := range []struct{ host, want string }{
+		{"http://localhost:8080/", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"https://example.com:8443", "https://example.com:8443/auth/v1/method/oidc/google/callback"},
+		{"https://example.com//", "https://example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		if got := callbackURL(tc.host, "google"); got != tc.want {
+			t.Errorf("callbackURL(%q) = %q, want %q", tc.host, got, tc.want)
+		}
+	}
+}
+
+func TestOIDCCookieDomains(t *testing.T) {
+	for _, tc := range []struct{ domain, want string }{
+		{"localhost", ""},
+		{"example.com", "example.com"},
+	} {
+		t.Run(tc.domain, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{
+				Domain: tc.domain, StateLifetime: time.Minute, TokenLifetime: time.Hour,
+			})
+			w := httptest.NewRecorder()
+			r := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			m.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(w, r)
+			cookies := w.Result().Cookies()
+			if len(cookies) != 1 || cookies[0].Name != stateCookieKey {
+				t.Fatalf("state cookies = %v", cookies)
+			}
+			if cookies[0].Domain != tc.want || cookies[0].Path != "/auth/v1/method/oidc/google/callback" {
+				t.Errorf("state cookie domain = %q, path = %q", cookies[0].Domain, cookies[0].Path)
+			}
+			if tc.want == "" && strings.Contains(w.Header().Get("Set-Cookie"), "Domain=") {
+				t.Error("localhost state cookie has Domain attribute")
+			}
+
+			w = httptest.NewRecorder()
+			if err := m.ForwardResponseOption(context.Background(), w, &auth.CallbackResponse{ClientToken: "token"}); err != nil {
+				t.Fatal(err)
+			}
+			cookies = w.Result().Cookies()
+			if len(cookies) != 1 || cookies[0].Name != tokenCookieKey || cookies[0].Domain != tc.want {
+				t.Errorf("token cookies = %v", cookies)
+			}
+		})
+	}
+}
