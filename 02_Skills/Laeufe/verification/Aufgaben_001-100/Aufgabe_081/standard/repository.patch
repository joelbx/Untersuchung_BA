+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAuthenticationSessionDomainNormalization(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  string
+	}{
+		{"http://localhost:8080", "localhost"},
+		{"https://auth.example.com:8443", "auth.example.com"},
+		{"auth.example.com:8080", "auth.example.com"},
+		{"localhost", "localhost"},
+	} {
+		t.Run(tc.input, func(t *testing.T) {
+			c := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tc.input},
+				Methods: AuthenticationMethods{
+					OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+				},
+			}
+			if err := c.validate(); err != nil {
+				t.Fatal(err)
+			}
+			if c.Session.Domain != tc.want {
+				t.Fatalf("domain = %q, want %q", c.Session.Domain, tc.want)
+			}
+		})
+	}
+}
+
+func TestAuthenticationSessionDomainParseError(t *testing.T) {
+	c := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: "http://%"},
+		Methods: AuthenticationMethods{
+			OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+		},
+	}
+	if err := c.validate(); err == nil || !strings.Contains(err.Error(), "invalid URL escape") {
+		t.Fatalf("validate() error = %v, want URL parsing error", err)
+	}
+}
