diff --git a/internal/cue/references_test.go b/internal/cue/references_test.go
new file mode 100644
index 0000000..2e15037
--- /dev/null
+++ b/internal/cue/references_test.go
@@ -0,0 +1,43 @@
+package cue
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestValidateReferences(t *testing.T) {
+	const source = `version: "1.2"
+namespace: demo
+flags:
+- key: flag
+  name: Flag
+  type: BOOLEAN_FLAG_TYPE
+  variants:
+  - key: known
+    name: Known
+  rules:
+  - segment: missing
+    distributions:
+    - variant: absent
+      rollout: 100
+  - segment:
+      keys: [known-segment, other]
+      operator: OR_SEGMENT_OPERATOR
+    distributions: []
+segments:
+- key: known-segment
+  name: Known
+  match_type: ALL_MATCH_TYPE
+`
+	v, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	err = v.Validate("state.yaml", []byte(source))
+	require.ErrorIs(t, err, ErrValidationFailed)
+	issues, ok := Unwrap(err)
+	require.True(t, ok)
+	require.Len(t, issues, 3)
+	require.Equal(t, `flag demo/flag rule 1 references unknown segment "missing" (state.yaml 11:14)`, issues[0].Error())
+	require.Equal(t, `flag demo/flag rule 1 references unknown variant "absent" (state.yaml 13:16)`, issues[1].Error())
+	require.Equal(t, `flag demo/flag rule 2 references unknown segment "other" (state.yaml 16:29)`, issues[2].Error())
+}
