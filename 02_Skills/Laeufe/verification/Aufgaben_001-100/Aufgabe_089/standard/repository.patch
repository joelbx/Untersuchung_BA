+	segments := map[string]bool{}
+	for _, segment := range items(field(root, "segments")) {
+		segments[value(field(segment, "key"))] = true
+	}
+	add := func(message string, at *yamlv3.Node) {
+		if at != nil {
+			issues = append(issues, Error{Message: message, Location: Location{File: file, Line: at.Line, Column: at.Column}})
+		}
