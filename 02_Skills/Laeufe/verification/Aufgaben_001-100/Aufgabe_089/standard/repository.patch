+					}
+				} else {
+					for _, key := range items(field(segment, "keys")) {
+						if !segments[key.Value] {
+							add(fmt.Sprintf("%s segment %q", prefix, key.Value), key)
+						}
+					}
+				}
+			}
+			for _, distribution := range items(field(rule, "distributions")) {
+				variant := field(distribution, "variant")
+				if variant != nil && !variants[variant.Value] {
+					add(fmt.Sprintf("%s variant %q", prefix, variant.Value), variant)
+				}
+			}
+		}
+		for i, rollout := range items(field(flag, "rollouts")) {
+			segment := field(rollout, "segment")
+			if segment == nil {
+				continue
+			}
+			keys := []*yamlv3.Node{field(segment, "key")}
+			keys = append(keys, items(field(segment, "keys"))...)
+			for _, key := range keys {
+				if key != nil && !segments[key.Value] {
+					add(fmt.Sprintf("flag %s/%s rollout %d references unknown segment %q", namespace, flagKey, i+1, key.Value), key)
+				}
+			}
+		}
+	}
+	return issues
 }
