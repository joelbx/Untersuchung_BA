diff --git a/internal/storage/fs/validation_test.go b/internal/storage/fs/validation_test.go
new file mode 100644
index 0000000..743c1e8
--- /dev/null
+++ b/internal/storage/fs/validation_test.go
@@ -0,0 +1,37 @@
+package fs
+
+import (
+	"testing"
+	"testing/fstest"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/cue"
+	"go.uber.org/zap"
+)
+
+func TestSnapshotValidation(t *testing.T) {
+	files := fstest.MapFS{"state.features.yaml": &fstest.MapFile{Data: []byte(`version: "1.2"
+flags:
+- key: flag
+  name: Flag
+  variants:
+  - key: known
+    name: Known
+  rules:
+  - segment: missing
+    distributions:
+    - variant: absent
+      rollout: 100
+segments: []
+`)}}
+	for _, build := range []func() (*StoreSnapshot, error){
+		func() (*StoreSnapshot, error) { return SnapshotFromFS(zap.NewNop(), files) },
+		func() (*StoreSnapshot, error) { return SnapshotFromPaths(files, "state.features.yaml") },
+	} {
+		_, err := build()
+		require.ErrorIs(t, err, cue.ErrValidationFailed)
+		issues, ok := cue.Unwrap(err)
+		require.True(t, ok)
+		require.Len(t, issues, 2)
+	}
+}
