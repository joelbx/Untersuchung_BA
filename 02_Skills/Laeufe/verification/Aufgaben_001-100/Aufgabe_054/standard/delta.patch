@@ -3,15 +3,34 @@ package singleton
 import (
 	"reflect"
 	"strings"
+	"sync"
 
 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances      = make(map[string]interface{})
+	getOrCreateC   = make(chan *entry, 1)
+	typedInstances sync.Map
 )
 
+type typedEntry struct {
+	once  sync.Once
+	value interface{}
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// A value type and its pointer type have separate instances.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	entry, _ := typedInstances.LoadOrStore(typeOfT, &typedEntry{})
+	instance := entry.(*typedEntry)
+	instance.once.Do(func() {
+		instance.value = constructor()
+	})
+	return instance.value.(T)
+}
+
 type entry struct {
 	constructor func() interface{}
 	object      interface{}
diff --git a/utils/singleton/singleton_test.go b/utils/singleton/singleton_test.go
index 9014e4e..e24c7d8 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -73,3 +73,63 @@ var _ = Describe("Get", func() {
 		Expect(numInstances).To(Equal(1))
 	})
 })
+
+func TestGetInstanceValueAndPointer(t *testing.T) {
+	type value struct{ id int }
+	valueCalls := 0
+	first := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 7}
+	})
+	second := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 8}
+	})
+	if first != (value{id: 7}) || second != first || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", first, second, valueCalls)
+	}
+
+	pointerCalls := 0
+	pointer := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 9}
+	})
+	again := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 10}
+	})
+	if pointer == nil || pointer.id != 9 || again != pointer || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%v second=%v constructor calls=%d", pointer, again, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type value struct{ id int }
+	const calls = 20000
+	var constructions int32
+	results := make([]*value, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *value {
+				atomic.AddInt32(&constructions, 1)
+				return &value{id: 42}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&constructions); got != 1 {
+		t.Fatalf("constructor called %d times, want 1", got)
+	}
+	for i, result := range results {
+		if result == nil || result.id != 42 || result != results[0] {
+			t.Fatalf("call %d returned %p, want %p", i, result, results[0])
+		}
+	}
+}
