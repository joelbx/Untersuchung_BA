+package teleport
+
+import "testing"
+
+func TestRolesCheck(t *testing.T) {
+	tests := []struct {
+		name    string
+		roles   Roles
+		wantErr bool
+	}{
+		{name: "nil"},
+		{name: "empty", roles: Roles{}},
+		{name: "valid unique", roles: Roles{RoleAuth, RoleNode}},
+		{name: "remote proxy", roles: Roles{RoleRemoteProxy}},
+		{name: "unknown", roles: Roles{RoleAuth, Role("unknown")}, wantErr: true},
+		{name: "duplicate", roles: Roles{RoleAuth, RoleNode, RoleAuth}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if err := tt.roles.Check(); (err != nil) != tt.wantErr {
+				t.Fatalf("Check() error = %v, want error = %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestRolesEqualsSetSemantics(t *testing.T) {
+	tests := []struct {
+		name  string
+		left  Roles
+		right Roles
+		want  bool
+	}{
+		{name: "nil and empty", right: Roles{}, want: true},
+		{name: "same roles reordered", left: Roles{RoleAuth, RoleNode}, right: Roles{RoleNode, RoleAuth}, want: true},
+		{name: "duplicate on right", left: Roles{RoleAuth}, right: Roles{RoleAuth, RoleAuth}, want: true},
+		{name: "duplicate on left", left: Roles{RoleAuth, RoleAuth}, right: Roles{RoleAuth}, want: true},
+		{name: "different distinct roles with same length", left: Roles{RoleAuth, RoleAuth}, right: Roles{RoleAuth, RoleNode}, want: false},
+		{name: "different distinct roles with different lengths", left: Roles{RoleAuth, RoleNode}, right: Roles{RoleAuth}, want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.left.Equals(tt.right); got != tt.want {
+				t.Errorf("%v.Equals(%v) = %v, want %v", tt.left, tt.right, got, tt.want)
+			}
+			if got := tt.right.Equals(tt.left); got != tt.want {
+				t.Errorf("%v.Equals(%v) = %v, want %v", tt.right, tt.left, got, tt.want)
+			}
+		})
+	}
+}
