+func Test_redhatBase_parseInstalledPackages_continuesAfterBadSourceFilename(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages(`elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)
+bar 1 9 123a ia64 1:bar-9-123a.src.rpm (none)`)
+	if err != nil {
+		t.Fatalf("parseInstalledPackages() error = %v", err)
+	}
+	if got := bins["elasticsearch"]; got.Version != "8.17.0" || got.Release != "1" || got.Arch != "x86_64" {
+		t.Errorf("elasticsearch binary = %+v", got)
+	}
+	if got := bins["bar"]; got.Version != "1:9" || got.Release != "123a" || got.Arch != "ia64" {
+		t.Errorf("bar binary = %+v", got)
+	}
+	if len(srcs) != 1 || !reflect.DeepEqual(srcs["bar"], models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}}) {
+		t.Errorf("source packages = %+v", srcs)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("warnings = %v", o.warns)
+	}
+}
