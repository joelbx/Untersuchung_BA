@@ -0,0 +1,23 @@
+import type { PassBridge, PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { isTrashed } from '@proton/pass/lib/items/item.predicates';
+import { UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+
+import type { PassAliasesVault } from './interface';
+
+export const filterPassAliases = (aliases: PassBridgeAliasItem[]): PassBridgeAliasItem[] =>
+    aliases
+        .filter(({ item }) => !isTrashed(item))
+        .sort((a, b) => (b.item.lastUseTime ?? b.item.revisionTime) - (a.item.lastUseTime ?? a.item.revisionTime));
+
+export const fetchPassAliases = async (PassBridge: PassBridge, defaultVault: PassAliasesVault) => {
+    const [aliases, userAccess] = await Promise.all([
+        PassBridge.alias.getAllByShareId(defaultVault.shareId, { maxAge: UNIX_MINUTE * 5 }),
+        PassBridge.user.getUserAccess({ maxAge: UNIX_MINUTE * 5 }),
+    ]);
+
+    return {
+        aliasesCountLimit: userAccess.plan.AliasLimit ?? Number.MAX_SAFE_INTEGER,
+        filteredAliases: filterPassAliases(aliases),
+        aliases,
+    };
+};
