+import type { PassBridge, PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { ItemState } from '@proton/pass/types';
+import { UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+
+import { fetchPassAliases, filterPassAliases } from './PassAliasesProvider.helpers';
+import type { PassAliasesVault } from './interface';
+
+const alias = (revisionTime: number, lastUseTime?: number, trashed = false) =>
+    ({
+        item: { revisionTime, lastUseTime, state: trashed ? ItemState.Trashed : ItemState.Active },
+    }) as PassBridgeAliasItem;
+
+describe('Pass aliases helpers', () => {
+    it('filters trashed aliases and sorts by last use or revision time', () => {
+        const oldest = alias(1);
+        const recentlyUsed = alias(2, 9);
+        const revised = alias(5);
+
+        expect(filterPassAliases([oldest, recentlyUsed, alias(10, undefined, true), revised])).toEqual([
+            recentlyUsed,
+            revised,
+            oldest,
+        ]);
+    });
+
+    it('fetches aliases and the count limit with a five minute TTL', async () => {
+        const aliases = [alias(1)];
+        const getAllByShareId = jest.fn().mockResolvedValue(aliases);
+        const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 3 } });
+        const bridge = {
+            alias: { getAllByShareId },
+            user: { getUserAccess },
+        } as unknown as PassBridge;
+
+        await expect(fetchPassAliases(bridge, { shareId: 'vault' } as PassAliasesVault)).resolves.toEqual({
+            aliases,
+            filteredAliases: aliases,
+            aliasesCountLimit: 3,
+        });
+        expect(getAllByShareId).toHaveBeenCalledWith('vault', { maxAge: UNIX_MINUTE * 5 });
+        expect(getUserAccess).toHaveBeenCalledWith({ maxAge: UNIX_MINUTE * 5 });
+    });
+});
