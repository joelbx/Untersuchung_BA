@@ -0,0 +1,30 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/model"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("ShareRepository", func() {
+	It("loads a share with no expiration or visit timestamp", func() {
+		db := getDBXBuilder()
+		_, err := db.NewQuery(`insert into share
+			(id, user_id, description, resource_ids, resource_type, contents, format, max_bit_rate, visit_count, created_at, updated_at)
+			values ('nullable-share', 'userid', '', '1001', 'media_file', '', '', 0, 0, '2023-01-01', '2023-01-01')`).Execute()
+		Expect(err).ToNot(HaveOccurred())
+		DeferCleanup(func() {
+			_, err := db.NewQuery("delete from share where id = 'nullable-share'").Execute()
+			Expect(err).ToNot(HaveOccurred())
+		})
+
+		repo := NewShareRepository(context.Background(), db)
+		share, err := repo.Get("nullable-share")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(share).To(BeAssignableToTypeOf(&model.Share{}))
+		Expect(share.ExpiresAt).To(BeNil())
+		Expect(share.LastVisitedAt).To(BeNil())
+	})
+})
