--- a/utils/gg/gg.go
+++ b/utils/gg/gg.go
@@ -1,6 +1,18 @@
 // Package gg implements simple "extensions" to Go language. Based on https://github.com/icza/gog
 package gg
 
+// P returns a pointer to v, including when v is its type's zero value.
+func P[T any](v T) *T { return &v }
+
+// V returns the value pointed to by p, or its type's zero value if p is nil.
+func V[T any](p *T) T {
+	if p != nil {
+		return *p
+	}
+	var zero T
+	return zero
+}
+
 // If returns v if it is a non-zero value, orElse otherwise.
 //
