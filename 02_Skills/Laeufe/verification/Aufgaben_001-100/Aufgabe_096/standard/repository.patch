+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_has_private_mode_on_disk(am, tmp_path, mocker):
+    src = tmp_path / 'src'
+    dest = tmp_path / 'dest'
+    src.write_text('secret')
+    os.chmod(str(src), 0o644)
+    mocker.patch.object(am, 'selinux_enabled', return_value=False)
+    previous_umask = os.umask(0o022)
+    try:
+        am.atomic_move(str(src), str(dest))
+    finally:
+        os.umask(previous_umask)
+
+    assert stat.S_IMODE(dest.stat().st_mode) == 0o600
+
