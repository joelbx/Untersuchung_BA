+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_new_file_warns_when_mode_omitted(atomic_am, atomic_mocks, clean_warnings, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert atomic_am._created_files == {'/path/to/dest'}
+
