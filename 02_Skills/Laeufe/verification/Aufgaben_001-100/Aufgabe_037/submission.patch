+@pytest.mark.parametrize('filter_func', (to_yaml, to_nice_yaml))
+def test_yaml_filters_report_dump_failure(filter_func):
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(object())
+    assert filter_func.__name__ in to_native(error.value)
+    assert 'cannot represent an object' in to_native(error.value)
+    assert isinstance(error.value.orig_exc, yaml.representer.RepresenterError)
+
+
+@pytest.mark.parametrize('filter_func', (to_yaml, to_nice_yaml))
+def test_yaml_filters_keep_undefined_error(filter_func):
+    with pytest.raises(UndefinedError, match='missing_env'):
+        filter_func({'environment': AnsibleUndefined(name='missing_env')})
+
+
+@pytest.mark.parametrize('filter_name', ('to_yaml', 'to_nice_yaml'))
+def test_yaml_filters_template_undefined_variable(filter_name):
+    templar = Templar(loader=DictDataLoader({}), variables={})
+    with pytest.raises(AnsibleUndefinedVariable, match='missing_env') as error:
+        templar.template('{{ missing_env | %s }}' % filter_name)
+    assert isinstance(error.value.__context__, UndefinedError)
