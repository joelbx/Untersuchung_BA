+// KubeAddr returns the public Kubernetes proxy URL. Public address ports are
+// ignored because they may refer to the web proxy instead of the Kube proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	for _, addrs := range [][]utils.NetAddr{c.Kube.PublicAddrs, c.PublicAddrs} {
+		for _, addr := range addrs {
+			if kubeAddr, err := kubeURL(addr.String()); err == nil {
+				return kubeAddr, nil
+			}
+		}
+	}
+	return "", trace.BadParameter("no valid public Kubernetes proxy address")
+}
+
+func kubeURL(address string) (string, error) {
+	if !strings.Contains(address, "://") {
+		address = "https://" + address
+	}
+	parsed, err := url.Parse(address)
+	if err != nil || parsed.Hostname() == "" || parsed.User != nil || parsed.Path != "" || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", address)
+	}
+	host := parsed.Hostname()
+	if strings.Contains(host, ":") && net.ParseIP(host) == nil {
+		return "", trace.BadParameter("invalid proxy public address %q", address)
+	}
+	return (&url.URL{Scheme: "https", Host: net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+}
+
