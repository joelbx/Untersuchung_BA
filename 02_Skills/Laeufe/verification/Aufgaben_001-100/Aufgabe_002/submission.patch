@@ -0,0 +1,35 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/gravitational/teleport/lib/utils"
+)
+
+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  ProxyConfig
+		want string
+	}{
+		{"disabled", ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "web.example:3080"}}}, ""},
+		{"kube public address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example:4443"}}}, PublicAddrs: []utils.NetAddr{{Addr: "web.example:3080"}}}, "https://kube.example:3026"},
+		{"web fallback", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "web.example:3080"}}}, "https://web.example:3026"},
+		{"skip invalid", ProxyConfig{Kube: KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "https://bad.example/path"}, {Addr: "valid.example:3000"}}}}, "https://valid.example:3026"},
+		{"no address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}}, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.KubeAddr()
+			if tt.want == "" {
+				if err == nil {
+					t.Fatalf("expected error, got %q", got)
+				}
+				return
+			}
+			if err != nil || got != tt.want {
+				t.Fatalf("KubeAddr() = %q, %v; want %q", got, err, tt.want)
+			}
+		})
+	}
+}
