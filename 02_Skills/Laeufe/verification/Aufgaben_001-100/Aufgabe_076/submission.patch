diff --git a/packages/shared/test/mail/recipient.spec.ts b/packages/shared/test/mail/recipient.spec.ts
new file mode 100644
index 0000000..f369860
--- /dev/null
+++ b/packages/shared/test/mail/recipient.spec.ts
@@ -0,0 +1,32 @@
+import { inputToRecipient, splitBySeparator } from '../../lib/mail/recipient';
+
+describe('address input parsing', () => {
+    it('splits commas and semicolons, removing brackets and empty tokens in order', () => {
+        expect(
+            splitBySeparator(',plus@debye.proton.black, visionary@debye.proton.black; pro@debye.proton.black,')
+        ).toEqual(['plus@debye.proton.black', 'visionary@debye.proton.black', 'pro@debye.proton.black']);
+        expect(splitBySeparator(' ; < first@example.com > ;; <> , second@example.com ; ')).toEqual([
+            'first@example.com',
+            'second@example.com',
+        ]);
+        expect(splitBySeparator(',,; < > ;')).toEqual([]);
+    });
+
+    it('uses the email for both recipient fields for plain and bracketed emails', () => {
+        expect(inputToRecipient('email@example.com')).toEqual({
+            Name: 'email@example.com',
+            Address: 'email@example.com',
+        });
+        expect(inputToRecipient(' <email@example.com> ')).toEqual({
+            Name: 'email@example.com',
+            Address: 'email@example.com',
+        });
+    });
+
+    it('keeps a display name when one is provided', () => {
+        expect(inputToRecipient('Person <email@example.com>')).toEqual({
+            Name: 'Person',
+            Address: 'email@example.com',
+        });
+    });
+});
