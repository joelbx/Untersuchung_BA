new file mode 100644
index 0000000..f08fc62
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,137 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type testStore struct {
+	lister
+	creator
+	flags       []*flipt.Flag
+	rules       []*flipt.Rule
+	segments    []*flipt.Segment
+	attachments []string
+	created     []string
+}
+
+func (s *testStore) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	return s.flags, nil
+}
+func (s *testStore) ListRules(_ context.Context, _ string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return s.rules, nil
+}
+func (s *testStore) ListSegments(_ context.Context, _ ...storage.QueryOption) ([]*flipt.Segment, error) {
+	return s.segments, nil
+}
+func (s *testStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	s.created = append(s.created, "flag:"+r.Key)
+	return &flipt.Flag{Key: r.Key}, nil
+}
+func (s *testStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.created = append(s.created, "variant:"+r.Key)
+	s.attachments = append(s.attachments, r.Attachment)
+	return &flipt.Variant{Id: r.Key, Key: r.Key}, nil
+}
+func (s *testStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s.created = append(s.created, "segment:"+r.Key)
+	return &flipt.Segment{Key: r.Key}, nil
+}
+func (s *testStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.created = append(s.created, "constraint:"+r.Property)
+	return &flipt.Constraint{}, nil
+}
+func (s *testStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	s.created = append(s.created, "rule:"+r.SegmentKey)
+	return &flipt.Rule{Id: "rule-id"}, nil
+}
+func (s *testStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.created = append(s.created, "distribution:"+r.VariantId)
+	return &flipt.Distribution{}, nil
+}
+
+func TestExportImportAttachmentsAndRelations(t *testing.T) {
+	attachment := `{"nested":{"numbers":[1,2.5,null],"mixed":[true,"word",{"empty":null}]}}`
+	s := &testStore{
+		flags: []*flipt.Flag{{Key: "feature", Name: "Feature", Enabled: true, Variants: []*flipt.Variant{
+			{Id: "id-a", Key: "a", Attachment: attachment}, {Id: "id-b", Key: "b"},
+		}}},
+		rules:    []*flipt.Rule{{SegmentKey: "audience", Rank: 1, Distributions: []*flipt.Distribution{{VariantId: "id-a", Rollout: 100}}}},
+		segments: []*flipt.Segment{{Key: "audience", Constraints: []*flipt.Constraint{{Property: "country", Operator: "eq", Value: "US"}}}},
+	}
+	var output bytes.Buffer
+	if err := NewExporter(s).Export(context.Background(), &output); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(output.String(), "attachment: '") {
+		t.Fatalf("attachment exported as a scalar: %s", output.String())
+	}
+	var doc Document
+	if err := yaml.Unmarshal(output.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	var want, got interface{}
+	if err := json.Unmarshal([]byte(attachment), &want); err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(convert(doc.Flags[0].Variants[0].Attachment))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(encoded, &got); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("attachment mismatch: got %#v want %#v", got, want)
+	}
+	if doc.Flags[0].Rules[0].Distributions[0].VariantKey != "a" || doc.Segments[0].Constraints[0].Property != "country" {
+		t.Fatalf("relationships lost: %#v", doc)
+	}
+	imported := &testStore{}
+	if err := NewImporter(imported).Import(context.Background(), &output); err != nil {
+		t.Fatal(err)
+	}
+	if len(imported.attachments) != 2 || imported.attachments[1] != "" {
+		t.Fatalf("missing attachment handling: %#v", imported.attachments)
+	}
+	var importedValue interface{}
+	if err := json.Unmarshal([]byte(imported.attachments[0]), &importedValue); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(want, importedValue) {
+		t.Fatalf("JSON attachment: got %#v want %#v", importedValue, want)
+	}
+	wantCreated := []string{"flag:feature", "variant:a", "variant:b", "segment:audience", "constraint:country", "rule:audience", "distribution:a"}
+	if !reflect.DeepEqual(imported.created, wantCreated) {
+		t.Fatalf("created: got %v want %v", imported.created, wantCreated)
+	}
+}
+
+func TestImportYAMLMapKeysAndLegacyJSON(t *testing.T) {
+	s := &testStore{}
+	input := `flags:
+  - key: f
+    enabled: true
+    variants:
+      - key: yaml
+        attachment:
+          1: [null, {true: value}]
+      - key: legacy
+        attachment: '{"old": [1, false]}'
+      - key: absent
+`
+	if err := NewImporter(s).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.attachments) != 3 || s.attachments[0] != `{"1":[null,{"true":"value"}]}` || s.attachments[1] != `{"old": [1, false]}` || s.attachments[2] != "" {
+		t.Fatalf("attachments: %#v", s.attachments)
+	}
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..395afdd
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,112 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+type Importer struct {
+	store creator
+}
+
+func NewImporter(store creator) *Importer { return &Importer{store: store} }
+
+// convert replaces YAML's interface-keyed maps with string-keyed maps at every depth.
+func convert(value interface{}) interface{} {
+	switch v := value.(type) {
+	case map[interface{}]interface{}:
+		result := make(map[string]interface{}, len(v))
+		for key, item := range v {
+			result[fmt.Sprint(key)] = convert(item)
+		}
+		return result
+	case map[string]interface{}:
+		result := make(map[string]interface{}, len(v))
+		for key, item := range v {
+			result[key] = convert(item)
+		}
+		return result
+	case []interface{}:
+		for i, item := range v {
+			v[i] = convert(item)
+		}
+		return v
+	default:
+		return value
+	}
+}
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	doc := new(Document)
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+	variants := make(map[string]*flipt.Variant)
+	for _, f := range doc.Flags {
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+		for _, v := range f.Variants {
+			attachment := ""
+			if v.Attachment != nil {
+				// Accept attachments from older exports, which stored JSON as a YAML string.
+				if raw, ok := v.Attachment.(string); ok && json.Valid([]byte(raw)) {
+					attachment = raw
+				} else {
+					encoded, err := json.Marshal(convert(v.Attachment))
+					if err != nil {
+						return fmt.Errorf("encoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+					attachment = string(encoded)
+				}
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{FlagKey: f.Key, Key: v.Key, Name: v.Name, Description: v.Description, Attachment: attachment})
+			if err != nil {
+				return fmt.Errorf("importing variant %q: %w", v.Key, err)
+			}
+			variants[f.Key+":"+v.Key] = variant
+		}
+	}
+	for _, s := range doc.Segments {
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: s.Key, Name: s.Name, Description: s.Description}); err != nil {
+			return fmt.Errorf("importing segment %q: %w", s.Key, err)
+		}
+		for _, c := range s.Constraints {
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{SegmentKey: s.Key, Type: flipt.ComparisonType(flipt.ComparisonType_value[c.Type]), Property: c.Property, Operator: c.Operator, Value: c.Value}); err != nil {
+				return fmt.Errorf("importing constraint for segment %q: %w", s.Key, err)
+			}
+		}
+	}
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{FlagKey: f.Key, SegmentKey: r.SegmentKey, Rank: int32(r.Rank)})
+			if err != nil {
+				return fmt.Errorf("importing rule for flag %q: %w", f.Key, err)
+			}
+			for _, d := range r.Distributions {
+				variant, found := variants[f.Key+":"+d.VariantKey]
+				if !found {
+					return fmt.Errorf("finding variant %q for flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{FlagKey: f.Key, RuleId: rule.Id, VariantId: variant.Id, Rollout: d.Rollout}); err != nil {
+					return fmt.Errorf("importing distribution for flag %q: %w", f.Key, err)
+				}
+			}
+		}
+	}
+	return nil
+}
