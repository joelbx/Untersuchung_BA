+def test_serialize_languages(display_values, expected) -> None:
+    content_info = SimpleNamespace(
+        languages=SimpleNamespace(
+            display_values=[
+                SimpleNamespace(display_value=value, type=type_)
+                for value, type_ in display_values
+            ]
+        ),
+        publication_date=None,
+        pages_count=None,
+        edition=None,
+    )
+    product = AmazonAPIReply(
+        item_info=ItemInfo(None, content_info, None, ''),
+        images='',
+        offers='',
+        asin='',
+    )
+
+    result = AmazonAPI.serialize(product)
+
+    if expected is None:
+        assert 'languages' not in result
+    else:
+        assert result['languages'] == expected
+
+
+def test_serialize_without_language_metadata() -> None:
