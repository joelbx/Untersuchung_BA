diff --git a/lib/client/kube_addr_test.go b/lib/client/kube_addr_test.go
new file mode 100644
index 0000000..6ae0a94
--- /dev/null
+++ b/lib/client/kube_addr_test.go
@@ -0,0 +1,41 @@
+package client
+
+import "testing"
+
+func TestKubeProxyWildcardAddress(t *testing.T) {
+	for _, listen := range []string{"0.0.0.0:8080", "[::]:8080"} {
+		t.Run(listen, func(t *testing.T) {
+			client := &TeleportClient{}
+			client.Config.WebProxyAddr = "proxy.example.com:3080"
+			err := client.applyProxySettings(ProxySettings{Kube: KubeProxySettings{Enabled: true, ListenAddr: listen}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if client.Config.KubeProxyAddr != "proxy.example.com:8080" {
+				t.Fatalf("KubeProxyAddr = %q", client.Config.KubeProxyAddr)
+			}
+		})
+	}
+}
+
+func TestKubeProxyPublicAddrPreferred(t *testing.T) {
+	client := &TeleportClient{}
+	client.Config.WebProxyAddr = "proxy.example.com:3080"
+	err := client.applyProxySettings(ProxySettings{Kube: KubeProxySettings{
+		Enabled: true, ListenAddr: "0.0.0.0:8080", PublicAddr: "public.example.com:8443",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if client.Config.KubeProxyAddr != "public.example.com:8443" {
+		t.Fatalf("KubeProxyAddr = %q", client.Config.KubeProxyAddr)
+	}
+}
+
+func TestKubeProxyHostPortWildcard(t *testing.T) {
+	config := &Config{WebProxyAddr: "proxy.example.com:3080", KubeProxyAddr: "[::]:8080"}
+	host, port := config.KubeProxyHostPort()
+	if host != "proxy.example.com" || port != 8080 {
+		t.Fatalf("KubeProxyHostPort() = %q, %d", host, port)
+	}
+}
