diff --git a/lib/config/kube_listen_test.go b/lib/config/kube_listen_test.go
new file mode 100644
index 0000000..166b826
--- /dev/null
+++ b/lib/config/kube_listen_test.go
@@ -0,0 +1,43 @@
+package config
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/service"
+)
+
+func TestProxyKubeListenAddr(t *testing.T) {
+	tests := []struct {
+		name, yaml, wantAddr, wantError string
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", ""},
+		{"default port", "proxy_service:\n  kube_listen_addr: kube.example.com\n", "kube.example.com:3026", ""},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:4444\n", "0.0.0.0:8080", ""},
+		{"enabled legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:4444\n", "127.0.0.1:4444", ""},
+		{"conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", "", "kube_listen_addr conflicts"},
+		{"implicit conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    listen_addr: 127.0.0.1:4444\n", "", "kube_listen_addr conflicts"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fc, err := ReadFromString(base64.StdEncoding.EncodeToString([]byte(tt.yaml)))
+			if tt.wantError != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantError) {
+					t.Fatalf("ReadFromString error = %v, want %q", err, tt.wantError)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			cfg := service.MakeDefaultConfig()
+			if err := ApplyFileConfig(fc, cfg); err != nil {
+				t.Fatal(err)
+			}
+			if !cfg.Proxy.Kube.Enabled || cfg.Proxy.Kube.ListenAddr.Addr != tt.wantAddr {
+				t.Fatalf("Kubernetes proxy = enabled %v, addr %q; want %q", cfg.Proxy.Kube.Enabled, cfg.Proxy.Kube.ListenAddr.Addr, tt.wantAddr)
+			}
+		})
+	}
+}
