diff --git a/tests/unit/misc/test_earlyinit.py b/tests/unit/misc/test_earlyinit.py
index e29cc0a..92872d0 100644
--- a/tests/unit/misc/test_earlyinit.py
+++ b/tests/unit/misc/test_earlyinit.py
@@ -24,6 +24,45 @@ import sys
 import pytest
 
 from qutebrowser.misc import earlyinit
+from qutebrowser.qt import machinery
+
+
+def test_check_qt_available_no_wrapper(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+
+    def missing(name):
+        raise ImportError(f"missing {name}")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", missing)
+    with pytest.raises(machinery.NoWrapperAvailableError) as exc:
+        earlyinit.check_qt_available(info)
+    assert exc.value.info is info
+    assert info.pyqt5 == "ImportError: missing PyQt5"
+    assert info.pyqt6 == "ImportError: missing PyQt6"
+    assert str(exc.value) == f"No Qt wrapper was importable.\n\n\n{info}"
+
+
+def test_check_qt_available_selected_wrapper(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    calls = []
+    monkeypatch.setattr(earlyinit.importlib, "import_module", calls.append)
+    earlyinit.check_qt_available(info)
+    assert calls == ["PyQt5"]
+    assert info.pyqt5 == "success"
+
+
+def test_check_pyqt_error_spacing(monkeypatch, capsys):
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+    monkeypatch.setattr(sys, "argv", ["qutebrowser"])
+
+    def missing(name):
+        raise ImportError(f"missing {name}")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", missing)
+    with pytest.raises(SystemExit) as exc:
+        earlyinit.check_pyqt()
+    assert exc.value.code == 1
+    assert capsys.readouterr().err.endswith("\n\n\n")
 
 
 @pytest.mark.parametrize('attr', ['stderr', '__stderr__'])
