@@ -136,6 +136,31 @@ def init_faulthandler(fileobj=sys.__stderr__):
         # pylint: enable=no-member,useless-suppression
 
 
+def check_qt_available(info):
+    """Check that at least one Qt wrapper can be imported."""
+    from qutebrowser.qt import machinery
+
+    # Try the selected wrapper first; importing a second wrapper is unnecessary
+    # (and can cause conflicts) once one has loaded successfully.
+    wrappers = [info.wrapper] if info.wrapper else []
+    wrappers.extend(name for name in machinery.WRAPPERS if name not in wrappers)
+    for wrapper in wrappers:
+        outcome = getattr(info, wrapper.lower())
+        if outcome == "success":
+            return
+        if outcome is not None:
+            continue
+        try:
+            importlib.import_module(wrapper)
+        except ImportError as e:
+            info.set_module(wrapper, f"{type(e).__name__}: {e}")
+        else:
+            info.set_module(wrapper, "success")
+            return
+
+    raise machinery.NoWrapperAvailableError(info)
+
+
