+    for name in ("INFO", "USE_PYQT5", "USE_PYQT6", "USE_PYSIDE6",
+                 "IS_QT5", "IS_QT6", "IS_PYQT", "IS_PYSIDE"):
+        monkeypatch.setattr(machinery, name, getattr(machinery, name))
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.auto,
+        pyqt6="ImportError: missing PyQt6", pyqt5="success",
+    )
+    monkeypatch.setattr(machinery, "_autoselect_wrapper", lambda: info)
+
+    def unexpected_select(args):
+        pytest.fail("implicit initialization called explicit selection")
+
+    monkeypatch.setattr(machinery, "_select_wrapper", unexpected_select)
+    assert machinery.init() is info
+    assert machinery.init() is info
+    assert machinery.IS_QT5
