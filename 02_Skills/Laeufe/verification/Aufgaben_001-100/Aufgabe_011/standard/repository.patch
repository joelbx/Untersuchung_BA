@@ -41,3 +41,22 @@ def test_warning_no_color(capsys, mocker, warning_message):
     out, err = capsys.readouterr()
     assert d._warns == {expected_warning_message}
     assert err == expected_warning_message
+
+
+def test_deprecation_config_does_not_hide_normal_warnings(capsys, mocker):
+    mocker.patch('ansible.utils.color.ANSIBLE_COLOR', False)
+    enabled = mocker.patch('ansible.utils.display._DeferredWarningContext.deprecation_warnings_enabled', return_value=False)
+    display = Display()
+    display._deprecations.clear()
+
+    display.deprecated('disabled deprecation')
+    display.warning('visible warning')
+    output = capsys.readouterr().err
+    assert 'disabled deprecation' not in output
+    assert 'visible warning' in output
+
+    enabled.return_value = True
+    display.deprecated('enabled deprecation')
+    output = capsys.readouterr().err
+    assert 'enabled deprecation' in output
+    assert 'deprecation_warnings=False' in output
