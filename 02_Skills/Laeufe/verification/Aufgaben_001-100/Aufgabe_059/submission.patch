+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes, children, and the host ref in a limited DOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole } = render(
+            <Dialog ref={ref} open aria-label="Example" data-testid="dialog-host">
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(host).toHaveAttribute('data-testid', 'dialog-host');
+        expect(host).toHaveAttribute('open');
+        expect(ref.current).toBe(host);
+        expect(host).toContainElement(getByRole('button', { name: 'Hello' }));
+    });
+
+    it('uses a native dialog when the modal API is available', () => {
+        const descriptor = Object.getOwnPropertyDescriptor(HTMLDialogElement.prototype, 'showModal');
+        Object.defineProperty(HTMLDialogElement.prototype, 'showModal', {
+            configurable: true,
+            value: jest.fn(),
+        });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByRole } = render(
+                <Dialog ref={ref} open aria-label="Native" data-testid="native-host">
+                    <button type="button">Hello</button>
+                </Dialog>
+            );
+
+            const host = getByRole('dialog', { name: 'Native' });
+            expect(host.tagName).toBe('DIALOG');
+            expect(host).toHaveAttribute('data-testid', 'native-host');
+            expect(ref.current).toBe(host);
+            expect(host).toContainElement(getByRole('button', { name: 'Hello' }));
+        } finally {
+            if (descriptor) {
+                Object.defineProperty(HTMLDialogElement.prototype, 'showModal', descriptor);
+            } else {
+                delete (HTMLDialogElement.prototype as { showModal?: () => void }).showModal;
+            }
+        }
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
