index 0000000..516e01d
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,21 @@
+import { HTMLAttributes, ReactEventHandler, Ref, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+    onCancel?: ReactEventHandler<HTMLDialogElement>;
+    onClose?: ReactEventHandler<HTMLDialogElement>;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props, ref): JSX.Element => {
+    // JSDOM and older DOM implementations expose <dialog> without its modal API.
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        // The public ref follows the dialog API, while this branch exposes the fallback host.
+        return <div ref={ref as Ref<HTMLDivElement>} role="dialog" {...(props as HTMLAttributes<HTMLDivElement>)} />;
+    }
+
+    return <dialog ref={ref} {...props} />;
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
