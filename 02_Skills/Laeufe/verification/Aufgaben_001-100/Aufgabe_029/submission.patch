+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+from units.compat import unittest
+from units.compat.mock import MagicMock, Mock, patch
+from units.modules.utils import set_module_args
+
+
+class TestNiosFixedAddress(unittest.TestCase):
+
+    def test_provider_is_required(self):
+        set_module_args({'name': 'printer', 'ipaddr': '192.0.2.10',
+                         'mac': '00:11:22:33:44:55', 'network': '192.0.2.0/24'})
+        with patch.object(nios_fixed_address.AnsibleModule, 'fail_json',
+                          side_effect=RuntimeError('missing provider')) as fail:
+            with self.assertRaises(RuntimeError):
+                nios_fixed_address.main()
+        self.assertIn('provider', str(fail.call_args))
+
+    @patch('ansible.modules.net_tools.nios.nios_fixed_address.WapiModule')
+    def test_main_routes_both_address_families(self, wapi_class):
+        wapi_class.return_value.run.return_value = {'changed': False}
+        for address, obj_type, field in (
+                ('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')):
+            set_module_args({'name': 'printer', 'ipaddr': address,
+                             'mac': '00:11:22:33:44:55', 'network': '192.0.2.0/24',
+                             'provider': {'host': 'nios.example.com'}, '_ansible_check_mode': True})
+            with patch.object(nios_fixed_address.AnsibleModule, 'exit_json',
+                              side_effect=RuntimeError('module exited')):
+                with self.assertRaises(RuntimeError):
+                    nios_fixed_address.main()
+            actual_type, spec = wapi_class.return_value.run.call_args[0]
+            self.assertEqual(actual_type, obj_type)
+            self.assertIn(field, spec)
+            self.assertNotIn('ipaddr', spec)
+            module = wapi_class.call_args[0][0]
+            self.assertTrue(module.check_mode)
+            self.assertEqual(module.params[field], address)
+            self.assertEqual(module.params['state'], 'present')
+
+    def test_address_mapping(self):
+        for address, obj_type, field in (
+                ('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')):
+            module = MagicMock()
+            module.params = {'ipaddr': address}
+            spec = {'ipaddr': {'ib_req': True}}
+            result_type, result_spec, result_module = nios_fixed_address.validate_ip_addr_type(
+                address, spec, module)
+            self.assertEqual(result_type, obj_type)
+            self.assertIs(result_module, module)
+            self.assertIn(field, result_spec)
+            self.assertEqual(module.params[field], address)
+            self.assertNotIn('ipaddr', module.params)
+
+    def test_invalid_address(self):
+        module = MagicMock()
+        module.fail_json.side_effect = ValueError('invalid address')
+        with self.assertRaises(ValueError):
+            nios_fixed_address.validate_ip_addr_type('not-an-address', {'ipaddr': {}}, module)
+        module.fail_json.assert_called_once()
+
+    def test_options(self):
+        module = MagicMock()
+        module.params = {'options': [{'num': 3, 'name': None, 'value': '192.0.2.1',
+                                     'use_option': None, 'vendor_class': None}]}
+        self.assertEqual(nios_fixed_address.options(module),
+                         [{'num': 3, 'value': '192.0.2.1',
+                           'use_option': True, 'vendor_class': 'DHCP'}])
+        module.params['options'] = [{'value': 'missing identifier'}]
+        module.fail_json.side_effect = ValueError('missing identifier')
+        with self.assertRaises(ValueError):
+            nios_fixed_address.options(module)
+
+    @patch('ansible.module_utils.net_tools.nios.api.get_connector')
+    def test_lookup_and_check_mode(self, connector):
+        for obj_type, field, address in (
+                (api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr', '192.0.2.10'),
+                (api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr', '2001:db8::10')):
+            module = MagicMock()
+            module.check_mode = True
+            module.params = {'provider': {}, 'state': 'present', 'name': 'printer',
+                             field: address, 'mac': '00:11:22:33:44:55',
+                             'network': '192.0.2.0/24', 'network_view': 'default',
+                             'options': None, 'extattrs': None, 'comment': None}
+            spec = {'name': {}, field: {'ib_req': True}, 'mac': {'ib_req': True},
+                    'network': {'ib_req': True}, 'network_view': {'ib_req': True},
+                    'options': {}, 'extattrs': {}, 'comment': {}}
+            wapi = api.WapiModule(module)
+            wapi.get_object = Mock(return_value=None)
+            wapi.create_object = Mock()
+            result = wapi.run(obj_type, spec)
+            self.assertTrue(result['changed'])
+            self.assertEqual(wapi.get_object.call_args[0][1],
+                             {field: address, 'mac': '00:11:22:33:44:55',
+                              'network': '192.0.2.0/24', 'network_view': 'default'})
+            wapi.create_object.assert_not_called()
+
+    @patch('ansible.module_utils.net_tools.nios.api.get_connector')
+    def test_existing_address_is_idempotent_and_deletable(self, connector):
+        module = MagicMock()
+        module.check_mode = False
+        module.params = {'provider': {}, 'state': 'present', 'name': 'printer',
+                         'ipv4addr': '192.0.2.10', 'mac': '00:11:22:33:44:55',
+                         'network': '192.0.2.0/24', 'network_view': 'default'}
+        spec = {'name': {}, 'ipv4addr': {'ib_req': True}, 'mac': {'ib_req': True},
+                'network': {'ib_req': True}, 'network_view': {'ib_req': True}}
+        existing = dict(module.params)
+        existing.pop('provider')
+        existing.pop('state')
+        existing['_ref'] = 'fixedaddress/ref'
+        wapi = api.WapiModule(module)
+        wapi.get_object = Mock(side_effect=lambda *args, **kwargs: [dict(existing)])
+        wapi.create_object = Mock()
+        wapi.delete_object = Mock()
+        self.assertFalse(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.create_object.assert_not_called()
+        module.params['state'] = 'absent'
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.delete_object.assert_called_once_with('fixedaddress/ref')
+
+    @patch('ansible.module_utils.net_tools.nios.api.get_connector')
+    def test_existing_address_updates_metadata(self, connector):
+        module = MagicMock()
+        module.check_mode = False
+        module.params = {'provider': {}, 'state': 'present', 'name': 'printer',
+                         'ipv6addr': '2001:db8::10', 'mac': '00:11:22:33:44:55',
+                         'network': '2001:db8::/64', 'network_view': 'default',
+                         'comment': 'updated'}
+        spec = {'name': {}, 'ipv6addr': {'ib_req': True}, 'mac': {'ib_req': True},
+                'network': {'ib_req': True}, 'network_view': {'ib_req': True},
+                'comment': {}}
+        existing = dict(module.params)
+        existing.pop('provider')
+        existing.pop('state')
+        existing['comment'] = 'old'
+        existing['_ref'] = 'ipv6fixedaddress/ref'
+        wapi = api.WapiModule(module)
+        wapi.get_object = Mock(return_value=[existing])
+        wapi.update_object = Mock()
+        self.assertTrue(wapi.run(api.NIOS_IPV6_FIXED_ADDRESS, spec)['changed'])
+        update = wapi.update_object.call_args[0]
+        self.assertEqual(update[0], 'ipv6fixedaddress/ref')
+        self.assertEqual(update[1]['comment'], 'updated')
+        self.assertNotIn('network_view', update[1])
