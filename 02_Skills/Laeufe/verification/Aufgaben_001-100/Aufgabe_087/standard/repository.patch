new file mode 100644
index 0000000..9cf02d6
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,34 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Version is the version of the running Flipt binary, set at startup.
+var Version = "dev"
+
+// Flipt describes the running server.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the server information as JSON.
+func (i Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(i)
+	if err != nil {
+		http.Error(w, "encoding server information", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := w.Write(out); err != nil {
+		// The response may already be committed, so a new status cannot be sent.
+		http.Error(w, "writing server information", http.StatusInternalServerError)
+	}
+}
