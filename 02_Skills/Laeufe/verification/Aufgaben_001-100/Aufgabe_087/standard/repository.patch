@@ -0,0 +1,127 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+func TestDisabled(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.TelemetryEnabled = false
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter: %v, %v", r, err)
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatalf("state directory created: %v", err)
+	}
+}
+
+func TestDirectoryIsFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state")
+	if err := os.WriteFile(path, []byte("file"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = path
+	if r, err := NewReporter(cfg, logrus.New()); err == nil || r != nil {
+		t.Fatalf("expected disabled reporter on file path: %v, %v", r, err)
+	}
+}
+
+func TestReportAndRecoverState(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "telemetry.json")
+	if err := os.WriteFile(path, []byte(`{"version":"old","uuid":"invalid","lastTimestamp":"yesterday"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	initial := r.state.UUID
+	if initial == "" || initial == "invalid" {
+		t.Fatalf("invalid regenerated UUID: %q", initial)
+	}
+	info.Version = "test-version"
+	defer func() { info.Version = "dev" }()
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		calls++
+		var e event
+		if err := json.NewDecoder(req.Body).Decode(&e); err != nil {
+			t.Error(err)
+		}
+		if e.Event != "flipt.ping" || e.AnonymousId != initial || e.Properties.UUID != initial || e.Properties.Version != schemaVersion || e.Properties.Flipt.Version != "test-version" {
+			t.Errorf("unexpected event: %+v", e)
+		}
+	}))
+	defer server.Close()
+	r.endpoint = server.URL
+	r.client = server.Client()
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 1 {
+		t.Fatalf("calls: %d", calls)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var s state
+	if err := json.Unmarshal(data, &s); err != nil {
+		t.Fatal(err)
+	}
+	if s.UUID != initial || s.Version != schemaVersion {
+		t.Fatalf("state: %+v", s)
+	}
+	if _, err := time.Parse(time.RFC3339, s.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+	again, err := NewReporter(cfg, logrus.New())
+	if err != nil || again.state.UUID != initial {
+		t.Fatalf("UUID not stable: %v, %v", again, err)
+	}
+}
+
+func TestFailedReportKeepsTimestamp(t *testing.T) {
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = t.TempDir()
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) { w.WriteHeader(http.StatusServiceUnavailable) }))
+	defer server.Close()
+	r.endpoint = server.URL
+	r.client = server.Client()
+	if err := r.Report(context.Background()); err == nil {
+		t.Fatal("expected report failure")
+	}
+	data, err := os.ReadFile(r.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var s state
+	if err := json.Unmarshal(data, &s); err != nil {
+		t.Fatal(err)
+	}
+	if s.LastTimestamp != initialTimestamp {
+		t.Fatalf("timestamp updated after failure: %q", s.LastTimestamp)
+	}
+}
