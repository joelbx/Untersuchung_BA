index 0000000..f1e151e
--- /dev/null
+++ b/internal/info/flipt_test.go
@@ -0,0 +1,31 @@
+package info
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestFliptServeHTTP(t *testing.T) {
+	response := httptest.NewRecorder()
+	(Flipt{Version: "1.2.3"}).ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+	if response.Code != http.StatusOK || !strings.Contains(response.Body.String(), `"version":"1.2.3"`) {
+		t.Fatalf("unexpected response: %d %s", response.Code, response.Body.String())
+	}
+}
+
+type failedWriter struct{ status int }
+
+func (w *failedWriter) Header() http.Header       { return make(http.Header) }
+func (w *failedWriter) Write([]byte) (int, error) { return 0, errors.New("write failed") }
+func (w *failedWriter) WriteHeader(status int)    { w.status = status }
+
+func TestFliptServeHTTPWriteFailure(t *testing.T) {
+	w := &failedWriter{}
+	(Flipt{}).ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+	if w.status != http.StatusInternalServerError {
+		t.Fatalf("status: %d", w.status)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..ec62a13
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,203 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion    = "1.0"
+	interval         = 4 * time.Hour
+	endpoint         = "https://telemetry.flipt.io/v1/track"
+	initialTimestamp = "1970-01-01T00:00:00Z"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type event struct {
+	Event       string `json:"event"`
+	AnonymousId string `json:"anonymousId"`
+	Properties  struct {
+		UUID    string `json:"uuid"`
+		Version string `json:"version"`
+		Flipt   struct {
+			Version string `json:"version"`
+		} `json:"flipt"`
+	} `json:"properties"`
+}
+
+// Reporter sends anonymous usage events and persists the time of the last report.
+type Reporter struct {
+	mu       sync.Mutex
+	state    state
+	path     string
+	logger   logrus.FieldLogger
+	client   *http.Client
+	endpoint string
+}
+
+// NewReporter initializes telemetry state. A disabled reporter is nil.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding config directory: %w", err)
+		}
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry directory: %w", err)
+	}
+	r := &Reporter{path: filepath.Join(dir, "telemetry.json"), logger: logger, client: &http.Client{Timeout: 10 * time.Second}, endpoint: endpoint}
+	data, err := os.ReadFile(r.path)
+	switch {
+	case errors.Is(err, os.ErrNotExist):
+	case err != nil:
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	default:
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.Warnf("parsing telemetry state: %v", err)
+		}
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry ID: %w", err)
+		}
+		r.state.UUID = id.String()
+		r.state.LastTimestamp = initialTimestamp
+	}
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		r.state.LastTimestamp = initialTimestamp
+	}
+	r.state.Version = schemaVersion
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+// Start schedules a report immediately when due, then every four hours.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, err := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			delay := time.Duration(0)
+			if err == nil {
+				delay = time.Until(last.Add(interval))
+			}
+			if delay > 0 {
+				timer := time.NewTimer(delay)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if err := r.Report(ctx); err != nil {
+				r.logger.Warnf("reporting telemetry: %v", err)
+			}
+			// Failed reports retry on the next interval; never spin on a failed send.
+			select {
+			case <-ctx.Done():
+				return
+			case <-time.After(interval):
+			}
+		}
+	}()
+}
+
+// Report sends one ping and records its successful delivery.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	e := event{Event: "flipt.ping", AnonymousId: r.state.UUID}
+	e.Properties.UUID = r.state.UUID
+	e.Properties.Version = schemaVersion
+	e.Properties.Flipt.Version = info.Version
+	data, err := json.Marshal(e)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.save(); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	dir := filepath.Dir(r.path)
+	f, err := os.CreateTemp(dir, ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("creating telemetry state: %w", err)
+	}
+	defer os.Remove(f.Name())
+	if err := f.Chmod(0600); err != nil {
+		f.Close()
+		return err
+	}
+	if _, err := f.Write(data); err != nil {
+		f.Close()
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(f.Name(), r.path); err != nil {
+		return fmt.Errorf("saving telemetry state: %w", err)
+	}
+	return nil
+}
