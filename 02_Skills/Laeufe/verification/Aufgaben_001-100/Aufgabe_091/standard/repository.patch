diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..9bf5052
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,70 @@
+package evaluation
+
+import (
+	"errors"
+	"testing"
+
+	ferrors "go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/storage"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestListOperatorsString(t *testing.T) {
+	tests := []struct {
+		name, operator, list, value string
+		want                        bool
+	}{
+		{"one of present", flipt.OpIsOneOf, `["a","b"]`, "b", true},
+		{"one of absent", flipt.OpIsOneOf, `["a","b"]`, "c", false},
+		{"not one of present", flipt.OpIsNotOneOf, `["a","b"]`, "a", false},
+		{"not one of absent", flipt.OpIsNotOneOf, `["a","b"]`, "c", true},
+		{"empty list", flipt.OpIsNotOneOf, `[]`, "c", true},
+		{"empty string present", flipt.OpIsOneOf, `[""]`, "", true},
+		{"empty string absent", flipt.OpIsNotOneOf, `["a"]`, "", true},
+		{"wrong type", flipt.OpIsOneOf, `["a",1]`, "a", false},
+		{"invalid json", flipt.OpIsOneOf, `[`, "a", false},
+		{"null list", flipt.OpIsOneOf, `null`, "a", false},
+		{"invalid not one of", flipt.OpIsNotOneOf, `[`, "a", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := matchesString(storage.EvaluationConstraint{Operator: tt.operator, Value: tt.list}, tt.value)
+			if got != tt.want {
+				t.Fatalf("matchesString() = %t, want %t", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestListOperatorsNumber(t *testing.T) {
+	tests := []struct {
+		name, operator, list, value string
+		want                        bool
+		invalid                     bool
+	}{
+		{"one of present", flipt.OpIsOneOf, `[1,2.5]`, "2.5", true, false},
+		{"one of absent", flipt.OpIsOneOf, `[1,2.5]`, "3", false, false},
+		{"not one of present", flipt.OpIsNotOneOf, `[1,2.5]`, "1", false, false},
+		{"not one of absent", flipt.OpIsNotOneOf, `[1,2.5]`, "3", true, false},
+		{"empty list", flipt.OpIsNotOneOf, `[]`, "3", true, false},
+		{"wrong type", flipt.OpIsOneOf, `[1,"2"]`, "1", false, true},
+		{"invalid json", flipt.OpIsNotOneOf, `[`, "1", false, true},
+		{"null list", flipt.OpIsOneOf, `null`, "1", false, true},
+		{"invalid list and empty value", flipt.OpIsOneOf, `["a"]`, "", false, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := matchesNumber(storage.EvaluationConstraint{Property: "p", Operator: tt.operator, Value: tt.list}, tt.value)
+			if tt.invalid {
+				var invalid ferrors.ErrInvalid
+				if !errors.As(err, &invalid) || got {
+					t.Fatalf("matchesNumber() = (%t, %v), want (false, ErrInvalid)", got, err)
+				}
+				return
+			}
+			if err != nil || got != tt.want {
+				t.Fatalf("matchesNumber() = (%t, %v), want (%t, nil)", got, err, tt.want)
+			}
+		})
+	}
+}
diff --git a/rpc/flipt/list_operators_validation_test.go b/rpc/flipt/list_operators_validation_test.go
new file mode 100644
index 0000000..566a9f2
--- /dev/null
+++ b/rpc/flipt/list_operators_validation_test.go
@@ -0,0 +1,50 @@
+package flipt
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/errors"
+)
+
+func TestListOperatorConstraintValidation(t *testing.T) {
+	strings100, _ := json.Marshal(make([]string, MAX_JSON_ARRAY_ITEMS))
+	strings101, _ := json.Marshal(make([]string, MAX_JSON_ARRAY_ITEMS+1))
+	numbers100, _ := json.Marshal(make([]float64, MAX_JSON_ARRAY_ITEMS))
+	numbers101, _ := json.Marshal(make([]float64, MAX_JSON_ARRAY_ITEMS+1))
+
+	tests := []struct {
+		name, operator, value string
+		typ                   ComparisonType
+		want                  error
+	}{
+		{"strings valid", OpIsOneOf, `["a","b"]`, ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"strings boundary", OpIsNotOneOf, string(strings100), ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"strings too many", OpIsOneOf, string(strings101), ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`too many values provided for property "p" of type string (maximum 100)`)},
+		{"strings wrong type", OpIsNotOneOf, `["a",1]`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "p" of type string`)},
+		{"strings invalid json", OpIsOneOf, `[`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "p" of type string`)},
+		{"strings null", OpIsOneOf, `null`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "p" of type string`)},
+		{"numbers valid", OpIsNotOneOf, `[1,2.5]`, ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"numbers boundary", OpIsOneOf, string(numbers100), ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"numbers too many", OpIsNotOneOf, string(numbers101), ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`too many values provided for property "p" of type number (maximum 100)`)},
+		{"numbers wrong type", OpIsOneOf, `[1,"2"]`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "p" of type number`)},
+		{"numbers invalid json", OpIsNotOneOf, `[`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "p" of type number`)},
+		{"numbers null", OpIsNotOneOf, `null`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "p" of type number`)},
+	}
+	for _, tt := range tests {
+		for _, method := range []string{"create", "update"} {
+			t.Run(strings.Join([]string{method, tt.name}, "/"), func(t *testing.T) {
+				var err error
+				if method == "create" {
+					err = (&CreateConstraintRequest{SegmentKey: "s", Property: "p", Operator: tt.operator, Type: tt.typ, Value: tt.value}).Validate()
+				} else {
+					err = (&UpdateConstraintRequest{Id: "i", SegmentKey: "s", Property: "p", Operator: tt.operator, Type: tt.typ, Value: tt.value}).Validate()
+				}
+				if err != tt.want {
+					t.Fatalf("Validate() = %v, want %v", err, tt.want)
+				}
+			})
+		}
+	}
+}
