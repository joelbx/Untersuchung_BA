@@ -0,0 +1,180 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestDefaults(t *testing.T) {
+	var cfg Config
+	cfg.SetDefaults()
+	if cfg.Capacity != 64 || cfg.GracePeriod != 5*time.Minute || cfg.Clock == nil {
+		t.Fatalf("unexpected defaults: %+v", cfg)
+	}
+}
+
+func TestOverflowAndIndependentCursors(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	first := make([]int, 2)
+	if n, err := fast.TryRead(first); n != 2 || err != nil || !reflect.DeepEqual(first, []int{1, 2}) {
+		t.Fatalf("fast first read = %v, %d, %v", first, n, err)
+	}
+	b.Append(6, 7)
+	all := make([]int, 7)
+	if n, err := slow.TryRead(all); n != 7 || err != nil || !reflect.DeepEqual(all, []int{1, 2, 3, 4, 5, 6, 7}) {
+		t.Fatalf("slow read = %v, %d, %v", all, n, err)
+	}
+	rest := make([]int, 5)
+	if n, err := fast.TryRead(rest); n != 5 || err != nil || !reflect.DeepEqual(rest, []int{3, 4, 5, 6, 7}) {
+		t.Fatalf("fast rest = %v, %d, %v", rest, n, err)
+	}
+	if len(b.overflow) != 0 {
+		t.Fatalf("overflow retained %d consumed entries", len(b.overflow))
+	}
+	late := b.NewCursor()
+	b.Append(8)
+	one := make([]int, 1)
+	if n, err := late.TryRead(one); n != 1 || err != nil || one[0] != 8 {
+		t.Fatalf("late cursor = %v, %d, %v", one, n, err)
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 1, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2)
+	clock.Advance(59 * time.Second)
+	got := make([]int, 2)
+	if n, err := fast.TryRead(got); n != 2 || err != nil {
+		t.Fatalf("read within grace = %d, %v", n, err)
+	}
+	clock.Advance(time.Second)
+	if n, err := slow.TryRead(got); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("expired read = %d, %v", n, err)
+	}
+	if len(b.overflow) != 0 {
+		t.Fatal("expired cursor retained overflow")
+	}
+	if n, err := fast.TryRead(got); n != 0 || err != nil {
+		t.Fatalf("fast cursor = %d, %v", n, err)
+	}
+}
+
+func TestConsumedItemsReleased(t *testing.T) {
+	b := NewBuffer[*int](Config{Capacity: 2})
+	defer b.Close()
+	c := b.NewCursor()
+	values := []*int{new(int), new(int), new(int)}
+	b.Append(values...)
+	if len(b.overflow) != 1 {
+		t.Fatalf("overflow size = %d", len(b.overflow))
+	}
+	out := make([]*int, 3)
+	if n, err := c.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("read = %d, %v", n, err)
+	}
+	if len(b.overflow) != 0 || b.start != b.next {
+		t.Fatalf("consumed items retained: overflow=%d, start=%d, next=%d", len(b.overflow), b.start, b.next)
+	}
+	for i, value := range b.ring {
+		if value != nil {
+			t.Fatalf("ring slot %d retained an item", i)
+		}
+	}
+}
+
+func TestReadWakeAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]int, 1)
+		n, err := c.Read(context.Background(), out)
+		if n == 1 && out[0] == 42 {
+			result <- err
+		} else {
+			result <- errors.New("unexpected read result")
+		}
+	}()
+	b.Append(42)
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("read did not wake")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled read: %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+	waiting := b.NewCursor()
+	go func() {
+		_, err := waiting.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	b.Close()
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("closed buffer: %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("close did not wake read")
+	}
+}
+
+func TestConcurrentReadersAndAppends(t *testing.T) {
+	const total = 1000
+	b := NewBuffer[int](Config{Capacity: 16})
+	defer b.Close()
+	const readers = 8
+	var wg sync.WaitGroup
+	for i := 0; i < readers; i++ {
+		c := b.NewCursor()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer c.Close()
+			out := make([]int, 37)
+			for expected := 0; expected < total; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, item := range out[:n] {
+					if item != expected {
+						t.Errorf("item %d, want %d", item, expected)
+						return
+					}
+					expected++
+				}
+			}
+		}()
+	}
+	for i := 0; i < total; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
