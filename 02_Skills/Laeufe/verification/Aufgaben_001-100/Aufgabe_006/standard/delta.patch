+// Package fanoutbuffer provides a concurrent, ordered buffer with independent readers.
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+var (
+	ErrGracePeriodExceeded = errors.New("fanout buffer grace period exceeded")
+	ErrUseOfClosedCursor   = errors.New("use of closed fanout buffer cursor")
+	ErrBufferClosed        = errors.New("fanout buffer closed")
+)
+
+// Config controls the buffer's storage and the time allowed for a cursor to
+// consume items displaced from the ring.
+type Config struct {
+	Capacity    uint64
+	GracePeriod time.Duration
+	Clock       clockwork.Clock
+}
+
+// SetDefaults fills in unset configuration fields.
+func (c *Config) SetDefaults() {
+	if c.Capacity == 0 {
+		c.Capacity = 64
+	}
+	if c.GracePeriod == 0 {
+		c.GracePeriod = 5 * time.Minute
+	}
+	if c.Clock == nil {
+		c.Clock = clockwork.NewRealClock()
+	}
+}
+
+type overflowItem[T any] struct {
+	value T
+	at    time.Time // time at which this item left the ring
+}
+
+// Buffer distributes each appended item to every cursor that existed when it
+// was appended. All state is guarded by mu.
+type Buffer[T any] struct {
+	mu       sync.Mutex
+	cfg      Config
+	ring     []T
+	start    uint64 // sequence number of the first item in the ring
+	next     uint64 // sequence number assigned to the next append
+	overflow []overflowItem[T]
+	overBase uint64 // sequence number of overflow[0]
+	cursors  map[*Cursor[T]]struct{}
+	notify   chan struct{}
+	closed   bool
+}
+
+// NewBuffer constructs a fanout buffer using the supplied configuration.
+func NewBuffer[T any](cfg Config) *Buffer[T] {
+	cfg.SetDefaults()
+	return &Buffer[T]{
+		cfg:     cfg,
+		ring:    make([]T, cfg.Capacity),
+		cursors: make(map[*Cursor[T]]struct{}),
+		notify:  make(chan struct{}),
+	}
+}
+
+// Append adds items in order and wakes waiting cursors. Appends after Close
+// have no effect.
+func (b *Buffer[T]) Append(items ...T) {
+	if len(items) == 0 {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+
+	// One clock read per batch also makes items displaced by the same append
+	// share a grace period.
+	now := b.cfg.Clock.Now()
+	minCursor := b.next
+	for c := range b.cursors {
+		if c.next < minCursor {
+			minCursor = c.next
+		}
+	}
+	for _, item := range items {
+		if b.next-b.start == b.cfg.Capacity {
+			if minCursor <= b.start {
+				if len(b.overflow) == 0 {
+					b.overBase = b.start
+				}
+				b.overflow = append(b.overflow, overflowItem[T]{
+					value: b.ring[b.start%b.cfg.Capacity], at: now,
+				})
+			}
+			b.start++
+		}
+		b.ring[b.next%b.cfg.Capacity] = item
+		b.next++
+	}
+	b.expireAndClean(now)
+	b.wake()
+}
+
+// NewCursor starts reading with the next item appended after its creation.
+func (b *Buffer[T]) NewCursor() *Cursor[T] {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	c := &Cursor[T]{buffer: b, next: b.next}
+	if !b.closed {
+		b.cursors[c] = struct{}{}
+	}
+	return c
+}
+
+// Close releases stored items and wakes all blocked readers. It is idempotent.
+func (b *Buffer[T]) Close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.closed = true
+	b.ring = nil
+	b.overflow = nil
+	b.cursors = nil
+	b.wake()
+}
+
+func (b *Buffer[T]) wake() {
+	close(b.notify)
+	b.notify = make(chan struct{})
+}
+
+// expireAndClean drops expired cursors and items no active cursor can read.
+// It is called with mu held.
+func (b *Buffer[T]) expireAndClean(now time.Time) {
+	if len(b.overflow) != 0 {
+		for c := range b.cursors {
+			if c.next < b.start && !now.Before(b.overflow[c.next-b.overBase].at.Add(b.cfg.GracePeriod)) {
+				c.expired = true
+				delete(b.cursors, c)
+			}
+		}
+	}
+	min := b.next
+	for c := range b.cursors {
+		if c.next < min {
+			min = c.next
+		}
+	}
+	if len(b.overflow) != 0 && min > b.overBase {
+		limit := min
+		if limit > b.start {
+			limit = b.start
+		}
+		drop := limit - b.overBase
+		if drop >= uint64(len(b.overflow)) {
+			b.overflow = nil
+			b.overBase = b.start
+		} else {
+			clear(b.overflow[:drop])
+			b.overflow = b.overflow[drop:]
+			b.overBase = limit
+			// Release an oversized backing array once most entries have been consumed.
+			if cap(b.overflow) > 2*len(b.overflow) {
+				b.overflow = append([]overflowItem[T](nil), b.overflow...)
+			}
+		}
+	}
+	if min > b.start {
+		for seq := b.start; seq < min; seq++ {
+			var zero T
+			b.ring[seq%b.cfg.Capacity] = zero
+		}
+		b.start = min
+	}
+}
+
+// Cursor reads the stream independently from other cursors.
+type Cursor[T any] struct {
+	buffer  *Buffer[T]
+	next    uint64
+	closed  bool
+	expired bool
+}
+
+// TryRead copies available items into out without waiting. An empty out
+// slice returns immediately unless the cursor or buffer is closed.
+func (c *Cursor[T]) TryRead(out []T) (int, error) {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return c.tryReadLocked(out)
+}
+
+func (c *Cursor[T]) tryReadLocked(out []T) (int, error) {
+	b := c.buffer
+	if c.closed {
+		return 0, ErrUseOfClosedCursor
+	}
+	if b.closed {
+		return 0, ErrBufferClosed
+	}
+	if c.expired {
+		return 0, ErrGracePeriodExceeded
+	}
+	b.expireAndClean(b.cfg.Clock.Now())
+	if c.expired {
+		return 0, ErrGracePeriodExceeded
+	}
+	if len(out) == 0 {
+		return 0, nil
+	}
+	var n int
+	for n < len(out) && c.next < b.next {
+		if c.next < b.start {
+			out[n] = b.overflow[c.next-b.overBase].value
+		} else {
+			out[n] = b.ring[c.next%b.cfg.Capacity]
+		}
+		c.next++
+		n++
+	}
+	if n != 0 {
+		b.expireAndClean(b.cfg.Clock.Now())
+	}
+	return n, nil
+}
+
+// Read waits for at least one item, a close, or context cancellation.
+func (c *Cursor[T]) Read(ctx context.Context, out []T) (int, error) {
+	for {
+		b := c.buffer
+		b.mu.Lock()
+		n, err := c.tryReadLocked(out)
+		if n != 0 || err != nil || len(out) == 0 {
+			b.mu.Unlock()
+			return n, err
+		}
+		notify := b.notify
+		b.mu.Unlock()
+		select {
+		case <-notify:
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		}
+	}
+}
+
+// Close releases items retained for this cursor and wakes a blocked Read.
+// It is safe to call more than once.
+func (c *Cursor[T]) Close() error {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if c.closed {
+		return ErrUseOfClosedCursor
+	}
+	c.closed = true
+	delete(b.cursors, c)
+	b.expireAndClean(b.cfg.Clock.Now())
+	b.wake()
+	return nil
+}
diff --git a/lib/utils/fanoutbuffer/buffer_test.go b/lib/utils/fanoutbuffer/buffer_test.go
