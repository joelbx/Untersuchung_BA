diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..b7d8e43
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,45 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	var cfg AuthenticationConfig
+	methods := cfg.Methods.AllMethods()
+	schedule := AuthenticationCleanupSchedule{Interval: time.Minute, GracePeriod: time.Minute}
+
+	assert.False(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+
+	for _, method := range methods {
+		t.Run(method.Name(), func(t *testing.T) {
+			var cfg AuthenticationConfig
+			for _, candidate := range cfg.Methods.AllMethods() {
+				if candidate.Method == method.Method {
+					candidate.SetCleanup(t, schedule)
+				}
+			}
+			assert.False(t, cfg.RequiresDatabase(), "disabled method")
+			assert.False(t, cfg.ShouldRunCleanup(), "disabled method")
+
+			for _, candidate := range cfg.Methods.AllMethods() {
+				if candidate.Method == method.Method {
+					candidate.Enable(t)
+				}
+			}
+			wantDatabase := method.Name() != "jwt"
+			assert.Equal(t, wantDatabase, cfg.RequiresDatabase())
+			assert.Equal(t, wantDatabase, cfg.ShouldRunCleanup())
+		})
+	}
+
+	cfg.Methods.JWT.Enabled = true
+	assert.False(t, cfg.RequiresDatabase())
+	cfg.Methods.Token.Enabled = true
+	assert.True(t, cfg.RequiresDatabase(), "enabled database method alongside JWT")
+	assert.False(t, cfg.ShouldRunCleanup(), "no cleanup schedule")
+}
