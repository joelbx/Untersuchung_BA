+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-1', display_name: 'Old name', isVerified: false };
+
+    it('saves a changed name and returns to the read view', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { rerender } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        expect(screen.getByText("A device's name is visible to people you communicate with.")).toBeTruthy();
+        expect(screen.getByTestId('device-detail-name-input').getAttribute('maxlength')).toBe('100');
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(saveDeviceName).toHaveBeenCalledWith('device-1', 'Work Laptop'));
+        await waitFor(() => expect(screen.getByTestId('device-detail-heading').textContent).toContain('Work Laptop'));
+        rerender(<DeviceDetailHeading device={{ ...device, display_name: 'Work Laptop' }}
+            saveDeviceName={saveDeviceName} />);
+        await waitFor(() => expect(screen.getByTestId('device-detail-heading').textContent).toContain('Work Laptop'));
+    });
+
+    it('does not save an unchanged name and accepts an empty name', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(screen.getByTestId('device-detail-heading')).toBeTruthy();
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: '' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(saveDeviceName).toHaveBeenCalledWith('device-1', ''));
+    });
+
+    it('cancels without saving', () => {
+        const saveDeviceName = jest.fn();
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Other name' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-cancel'));
+        expect(screen.getByTestId('device-detail-heading').textContent).toContain('Old name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('uses the device ID when the name is missing', () => {
+        render(<DeviceDetailHeading device={{ device_id: 'device-2', isVerified: false }}
+            saveDeviceName={jest.fn()} />);
+        expect(screen.getByTestId('device-detail-heading').textContent).toContain('device-2');
+    });
+
+    it('shows the required error on failure and keeps the form open', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('network failure'));
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Other name' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        expect((await screen.findByRole('alert')).textContent).toBe('Failed to set display name.');
+        expect(screen.getByTestId('device-detail-heading-edit')).toBeTruthy();
+    });
+
+    it('shows progress while saving', async () => {
+        let finishSave: () => void;
+        const saveDeviceName = jest.fn().mockImplementation(() => new Promise<void>(resolve => {
+            finishSave = resolve;
+        }));
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        expect(screen.getByTestId('device-detail-heading-edit').getElementsByClassName('mx_Spinner').length).toBe(1);
+        expect(screen.getByTestId('device-detail-name-save').hasAttribute('disabled')).toBe(true);
+        finishSave();
+        await waitFor(() => expect(screen.getByTestId('device-detail-heading')).toBeTruthy());
+    });
+});
