+
+
+def test_build_query_removes_honorific_before_import(new_import):
+    result = build_query({'authors': [{'name': 'Mr. Blobby', 'custom': 'kept'}]})
+    assert result['authors'][0]['name'] == 'Blobby'
+    assert result['authors'][0]['custom'] == 'kept'
+
+
+def test_author_dates_across_formats_and_priority(mock_site):
+    for key, name, birth, death in [
+        ('/authors/OL80A', 'William H. Brewer', '1900', '1910'),
+        ('/authors/OL81A', 'William Brewer', '1829-09-14', 'November 1910'),
+    ]:
+        mock_site.save({'key': key, 'type': {'key': '/type/author'},
+                        'name': name, 'birth_date': birth, 'death_date': death})
+    result = find_entity({'name': 'William H. Brewer',
+                          'birth_date': 'September 14th, 1829',
+                          'death_date': '11/2/1910'})
+    assert result['key'] == '/authors/OL81A'
+
+
+def test_literal_asterisk_matches_only_literal_name(mock_site):
+    mock_site.save({'key': '/authors/OL82A', 'type': {'key': '/type/author'},
+                    'name': 'John*'})
+    assert find_entity({'name': 'John*'})['key'] == '/authors/OL82A'
+
+
+def test_alternate_name_requires_matching_years(mock_site):
+    mock_site.save({'key': '/authors/OL83A', 'type': {'key': '/type/author'},
+                    'name': 'William Brewer',
+                    'alternate_names': ['William H. Brewer'],
+                    'birth_date': '1829-09-14', 'death_date': 'November 1910'})
+    query = {'name': 'William H. Brewer', 'birth_date': 'September 1829',
+             'death_date': '11/2/1910'}
+    assert find_entity(query)['key'] == '/authors/OL83A'
+    assert find_entity({**query, 'death_date': '1911'}) is None
+
+
+def test_new_author_keeps_fields_and_asterisk(mock_site):
+    author = {'name': 'New* Author', 'alternate_names': ['Another Name'],
+              'birth_date': '1829', 'custom': 'retained'}
+    created = import_author(author)
+    assert created == {**author, 'type': {'key': '/type/author'}}
+
