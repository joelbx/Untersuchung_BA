+def remove_author_honorifics(name: str) -> str:
+    """Remove a leading honorific when a name follows it."""
+    normalized = re.sub(r'[^\w\s]', ' ', name).casefold().split()
+    if ' '.join(normalized) in {
+        ' '.join(re.sub(r'[^\w\s]', ' ', value).casefold().split())
+        for value in HONORIFC_NAME_EXECPTIONS
+    }:
+        return name
+    for honorific in HONORIFICS:
+        match = re.match(rf'^\s*{re.escape(honorific)}(?=\s|$)', name, re.IGNORECASE)
+        if match and name[match.end() :].strip():
+            return name[match.end() :].lstrip()
+    return name
 
 
