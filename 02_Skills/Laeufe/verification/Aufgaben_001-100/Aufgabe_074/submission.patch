+    def test_required_path_and_typed_lists(self):
+        def fn(path: Path, numbers: list[int]):
+            return path, numbers
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['input.txt', '1', '2', '3'])
+        assert cli.run() == (Path('input.txt'), [1, 2, 3])
+        with pytest.raises(SystemExit):
+            cli.parse_args(['input.txt'])
+
+    def test_optional_path(self):
+        def fn(path: Path | None = None):
+            return path
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args([]).path is None
+        cli.parse_args(['--path', 'input.txt'])
+        assert cli.run() == Path('input.txt')
+
+    @pytest.mark.parametrize(
+        ('annotation', 'values', 'expected'),
+        [
+            (list[int], ['1', '2'], [1, 2]),
+            (list[str], ['a', 'b'], ['a', 'b']),
+            (list[float], ['1.5', '2.25'], [1.5, 2.25]),
+            (list[Path], ['a.txt', 'b.txt'], [Path('a.txt'), Path('b.txt')]),
+        ],
+    )
+    def test_optional_typed_lists(self, annotation, values, expected):
+        def fn(files=None):
+            return files
+
+        fn.__annotations__['files'] = annotation
+        cli = FnToCLI(fn)
+        assert cli.parse_args([]).files is None
+        assert cli.parse_args(['--files', *values]).files == expected
+        assert cli.run() == expected
+
+    def test_nullable_list_without_default(self):
+        def fn(files: list[Path] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args([]).files is None
+        assert cli.parse_args(['--files', 'a.txt', 'b.txt']).files == [
+            Path('a.txt'), Path('b.txt')
+        ]
+
+    def test_option_name_matches_parameter_and_stops_at_next_option(self):
+        def fn(files: list[Path] | None = None, max_count: int = 0):
+            return files, max_count
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--files', 'a.txt', 'b.txt', '--max_count', '2'])
+        assert cli.run() == ([Path('a.txt'), Path('b.txt')], 2)
+
+    def test_async_run_returns_result(self):
+        async def fn(value: int):
+            return value + 1
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['4'])
+        assert cli.run() == 5
 
