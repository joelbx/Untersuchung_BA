+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		matches []string
+		misses  []string
+	}{
+		{"foo", []string{"foo"}, []string{"foobar", "bar"}},
+		{"*", []string{"", "anything"}, nil},
+		{"foo*bar", []string{"foobar", "foo123bar"}, []string{"xfoo123bar", "foobarx"}},
+		{"^foo+$", []string{"foo", "fooo"}, []string{"xfoo", "fo"}},
+		{`{{regexp.match("^bar$")}}`, []string{"bar"}, []string{"barx", "xbar"}},
+		{`{{regexp.not_match("^bar$")}}`, []string{"barx", "xbar"}, []string{"bar"}},
+		{`foo-{{regexp.match("^bar$")}}-baz`, []string{"foo-bar-baz"}, []string{"foo-barx-baz", "foo-bar-bazx", "foo-bar"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, input := range tt.matches {
+				assert.True(t, matcher.Match(input), input)
+			}
+			for _, input := range tt.misses {
+				assert.False(t, matcher.Match(input), input)
+			}
+		})
+	}
+}
