+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		input   string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, `unsupported function namespace other, supported namespaces are email and regexp`},
+		{`{{regexp.foo("foo")}}`, `unsupported function regexp.foo, supported functions are: regexp.match, regexp.not_match.`},
+		{`{{email.foo("foo")}}`, `unsupported function email.foo, supported functions are: email.local`},
+		{`{{regexp.match("[")}}`, `failed parsing regexp "[":`},
+		{`{{regexp.match()}}`, `exactly one string literal argument`},
+		{`{{regexp.match("a", "b")}}`, `exactly one string literal argument`},
+		{`{{regexp.match(external.foo)}}`, `exactly one string literal argument`},
+		{`{{external.foo}}`, `"external.foo" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("a")}}{{regexp.match("b")}}`, `is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{email.local("a@b")}}`, `is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			_, err := Match(tt.input)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err), "%v", err)
+				assert.True(t, strings.Contains(err.Error(), tt.message), "%v", err)
+			}
+		})
+	}
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+}
