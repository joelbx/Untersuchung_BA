@@ -8,6 +8,7 @@ __metaclass__ = type
 import datetime
 import json
 import os
+import re
 import textwrap
 import traceback
 import yaml
@@ -71,6 +72,33 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    _TTY_MACRO = re.compile(r'(?<!\w)(?:(?P<name>[IBMUCRL])\((?P<body>[^()\n]+)\)|(?P<rule>HORIZONTALLINE)(?!\w))')
+
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            if match.group('rule'):
+                return '\n-------------\n'
+
+            name, body = match.group('name', 'body')
+            if name in ('L', 'R'):
+                label, separator, target = body.partition(',')
+                if not separator or not target.strip():
+                    return match.group(0)
+                if name == 'R':
+                    return label
+                return '%s <%s>' % (label, target.lstrip(' '))
+
+            if name == 'B':
+                return '*%s*' % body
+            if name == 'M':
+                return '[%s]' % body
+            if name == 'U':
+                return body
+            return "`%s'" % body
+
+        return cls._TTY_MACRO.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
