+        hostname = os.environ.get("HOSTNAME", "")
+        names = (hostname, hostname.split(".", 1)[0]) if hostname else ()
+
+        def matches(pattern):
+            if pattern.endswith("*") and pattern.count("*") == 1:
+                return any(name.startswith(pattern[:-1]) for name in names)
+            return pattern in names
+
+        if not any(matches(pattern) for pattern in allowed_hosts):
+            job = scheduler.get_job(func.__name__)
+            if job is not None:
+                scheduler.remove_job(job.id)
         return func
 
     return decorator
+
+
+def get_service_ip(image_name: str) -> str:
+    """Find the IP of a service container through Docker inspect."""
+    container = (
+        image_name
+        if image_name.startswith("openlibrary-")
+        else f"openlibrary-{image_name}-1"
+    )
+    result = subprocess.run(
+        [
+            "docker",
+            "inspect",
+            "--format",
+            "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}",
+            container,
+        ],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return result.stdout.strip()
