diff --git a/openlibrary/catalog/utils/__init__.py b/openlibrary/catalog/utils/__init__.py
index 36b2e9f..f082e51 100644
--- a/openlibrary/catalog/utils/__init__.py
+++ b/openlibrary/catalog/utils/__init__.py
@@ -454,11 +454,44 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     if not languages:
         return []
 
+    from openlibrary.plugins.upstream.utils import (
+        LanguageMultipleMatchError,
+        LanguageNoMatchError,
+        convert_iso_to_marc,
+        get_abbrev_from_full_lang_name,
+        get_marc21_language,
+    )
+
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        token = language.casefold()
+        # A valid MARC code takes precedence over aliases and names.
+        if web.ctx.site.get(f'/languages/{token}') is not None:
+            code = token
+        else:
+            code = get_marc21_language(token)
+            if code is None and len(token) == 2:
+                code = convert_iso_to_marc(token)
+            if code is None:
+                try:
+                    keys = web.ctx.site.things(
+                        {'type': '/type/language', 'limit': 10000}
+                    )
+                    records = web.ctx.site.get_many(keys)
+                    code = get_abbrev_from_full_lang_name(
+                        language,
+                        languages=(record for record in records if not record.deprecated),
+                    )
+                except (LanguageNoMatchError, LanguageMultipleMatchError):
+                    raise InvalidLanguage(token) from None
+
+        key = f'/languages/{code}'
+        if web.ctx.site.get(key) is None:
+            raise InvalidLanguage(token)
+
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
