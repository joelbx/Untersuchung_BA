--- /dev/null
+++ b/lib/utils/prompt/stdin_test.go
@@ -0,0 +1,34 @@
+package prompt
+
+import (
+	"context"
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNotifyExitRestoresPasswordPrompt(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr, started: make(chan struct{})}
+	cr := NewContextReader(pr)
+	cr.term, cr.fd = term, 1
+
+	stdinMU.Lock()
+	previous := stdin
+	stdinMU.Unlock()
+	SetStdin(cr)
+	defer SetStdin(previous)
+
+	result := make(chan error, 1)
+	go func() {
+		_, err := cr.ReadPassword(context.Background())
+		result <- err
+	}()
+	<-term.started
+	NotifyExit()
+	require.True(t, term.restoreCalled)
+	require.ErrorIs(t, <-result, ErrReaderClosed)
+}
