--- a/lib/utils/prompt/stdin.go
+++ b/lib/utils/prompt/stdin.go
@@ -52,3 +52,13 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so an active password prompt can
+// restore the terminal before the process exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		_ = closer.Close()
+	}
+}
