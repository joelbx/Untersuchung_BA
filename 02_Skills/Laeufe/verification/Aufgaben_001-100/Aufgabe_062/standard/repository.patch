+func TestMaybeRestoreTerm(t *testing.T) {
+	fake := &fakeTerm{restoreErr: errors.New("restore failed")}
+	cr := &ContextReader{term: fake, fd: 1, previousTermState: &term.State{}}
+	require.NoError(t, cr.maybeRestoreTerm())
