@@ -0,0 +1,22 @@
+package services
+
+import (
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+func TestApplyValueTraitsNestedValidation(t *testing.T) {
+	values, err := ApplyValueTraits(`{{regexp.replace(email.local(external.email), "^(.*)$", "$1")}}`, map[string][]string{"email": {"a@example.com"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"a"}, values)
+
+	_, err = ApplyValueTraits(`{{email.local(internal.secret)}}`, map[string][]string{"secret": {"a@example.com"}})
+	require.True(t, trace.IsBadParameter(err), "%v", err)
+	require.Contains(t, err.Error(), `unsupported variable "secret"`)
+
+	_, err = ApplyValueTraits(`{{regexp.replace(external.email, "^missing$", "x")}}`, map[string][]string{"email": {"a@example.com"}})
+	require.True(t, trace.IsNotFound(err), "%v", err)
+	require.Contains(t, err.Error(), "variable interpolation result is empty")
+}
