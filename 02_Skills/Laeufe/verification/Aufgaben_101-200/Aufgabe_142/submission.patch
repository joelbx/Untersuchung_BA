+package parse
+
+import (
+	"go/ast"
+	"go/parser"
+	"reflect"
+	"strings"
+
+	"github.com/gravitational/trace"
+	"github.com/vulcand/predicate"
+)
+
+const maxExpressionDepth = 100
+
+// parse constructs the expression AST using predicate's function and property callbacks.
+func parse(exprStr string) (Expr, error) {
+	// predicate uses recursive descent. Bound the Go syntax tree before handing it over.
+	syntax, err := parser.ParseExpr(exprStr)
+	if err != nil {
+		return nil, trace.BadParameter("invalid expression %q: %v", exprStr, err)
+	}
+	depth, tooDeep := 0, false
+	ast.Inspect(syntax, func(n ast.Node) bool {
+		if n == nil {
+			depth--
+			return false
+		}
+		depth++
+		if depth > maxExpressionDepth {
+			tooDeep = true
+		}
+		return true
+	})
+	if tooDeep {
+		return nil, trace.BadParameter("expression exceeds maximum depth of %d", maxExpressionDepth)
+	}
+	p, err := predicate.NewParser(predicate.Def{
+		GetIdentifier: buildVarExpr,
+		GetProperty:   buildVarExprFromProperty,
+		Functions: map[string]interface{}{
+			"email.local": func(args ...interface{}) (interface{}, error) {
+				if err := arity("email.local", args, 1); err != nil {
+					return nil, err
+				}
+				in, err := stringArg(args[0])
+				if err != nil {
+					return nil, err
+				}
+				return EmailLocalExpr{Input: in}, nil
+			},
+			"regexp.replace": func(args ...interface{}) (interface{}, error) {
+				if err := arity("regexp.replace", args, 3); err != nil {
+					return nil, err
+				}
+				in, err := stringArg(args[0])
+				if err != nil {
+					return nil, err
+				}
+				pattern, ok := args[1].(string)
+				if !ok {
+					return nil, trace.BadParameter("regexp.replace pattern must be a constant string")
+				}
+				replacement, ok := args[2].(string)
+				if !ok {
+					return nil, trace.BadParameter("regexp.replace replacement must be a constant string")
+				}
+				re, err := compileRegexp(pattern)
+				if err != nil {
+					return nil, err
+				}
+				return RegexpReplaceExpr{Input: in, Pattern: pattern, Replacement: replacement, re: re}, nil
+			},
+			"regexp.match": func(args ...interface{}) (interface{}, error) {
+				if err := arity("regexp.match", args, 1); err != nil {
+					return nil, err
+				}
+				pattern, ok := args[0].(string)
+				if !ok {
+					return nil, trace.BadParameter("regexp.match pattern must be a constant string")
+				}
+				re, err := compileRegexp(pattern)
+				if err != nil {
+					return nil, err
+				}
+				return RegexpMatchExpr{Pattern: pattern, re: re}, nil
+			},
+			"regexp.not_match": func(args ...interface{}) (interface{}, error) {
+				if err := arity("regexp.not_match", args, 1); err != nil {
+					return nil, err
+				}
+				pattern, ok := args[0].(string)
+				if !ok {
+					return nil, trace.BadParameter("regexp.not_match pattern must be a constant string")
+				}
+				re, err := compileRegexp(pattern)
+				if err != nil {
+					return nil, err
+				}
+				return RegexpNotMatchExpr{Pattern: pattern, re: re}, nil
+			},
+		},
+	})
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	v, err := p.Parse(exprStr)
+	if err != nil {
+		return nil, trace.BadParameter("invalid expression %q: %v", exprStr, err)
+	}
+	e, ok := v.(Expr)
+	if !ok {
+		return nil, trace.BadParameter("expected a namespaced variable or function in %q", exprStr)
+	}
+	if err := validateExpr(e); err != nil {
+		return nil, err
+	}
+	return e, nil
+}
+func arity(name string, args []interface{}, n int) error {
+	if len(args) != n {
+		return trace.BadParameter("%s expects %d arguments, got %d", name, n, len(args))
+	}
+	return nil
+}
+func stringArg(v interface{}) (Expr, error) {
+	if s, ok := v.(string); ok {
+		return StringLitExpr{Value: s}, nil
+	}
+	e, ok := v.(Expr)
+	if !ok || e.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %T", v)
+	}
+	return e, nil
+}
+func buildVarExpr(parts []string) (interface{}, error) {
+	if len(parts) > 2 {
+		return nil, trace.BadParameter("variable must have exactly two parts: namespace.name")
+	}
+	if len(parts) == 0 {
+		return nil, trace.BadParameter("variable must have exactly two parts: namespace.name")
+	}
+	if !validNamespace(parts[0]) {
+		return nil, trace.BadParameter("unsupported variable namespace %q", parts[0])
+	}
+	if len(parts) == 1 {
+		return VarExpr{Namespace: parts[0]}, nil
+	}
+	return VarExpr{Namespace: parts[0], Name: parts[1]}, nil
+}
+func buildVarExprFromProperty(base, key interface{}) (interface{}, error) {
+	v, ok := base.(VarExpr)
+	if !ok || v.Name != "" {
+		return nil, trace.BadParameter("variable must have exactly two parts: namespace[\"name\"]")
+	}
+	name, ok := key.(string)
+	if !ok {
+		return nil, trace.BadParameter("variable index must be a quoted string name")
+	}
+	v.Name = name
+	return v, nil
+}
+func validNamespace(ns string) bool {
+	return ns == "internal" || ns == "external" || ns == LiteralNamespace
+}
+func validateExpr(e Expr) error {
+	switch n := e.(type) {
+	case VarExpr:
+		if n.Name == "" {
+			return trace.BadParameter("variable %q must have exactly two parts: namespace.name", n.Namespace)
+		}
+		if !validNamespace(n.Namespace) {
+			return trace.BadParameter("unsupported variable namespace %q", n.Namespace)
+		}
+	case EmailLocalExpr:
+		return validateExpr(n.Input)
+	case RegexpReplaceExpr:
+		return validateExpr(n.Input)
+	}
+	return nil
+}
+
+// splitTemplate returns the static surroundings and the expression inside braces.
+func splitTemplate(input string) (prefix, inner, suffix string, found bool, err error) {
+	value := strings.TrimSpace(input)
+	start := strings.Index(value, "{{")
+	malformed := func() (string, string, string, bool, error) {
+		return "", "", "", false, trace.BadParameter("malformed template usage in %q: expected {{expression}}", input)
+	}
+	if start < 0 {
+		if strings.Contains(value, "}}") {
+			return malformed()
+		}
+		return value, "", "", false, nil
+	}
+	if strings.ContainsAny(value[:start], "{}") {
+		return malformed()
+	}
+	quote, escaped, end := byte(0), false, -1
+	for i := start + 2; i < len(value); i++ {
+		c := value[i]
+		if quote != 0 {
+			if escaped {
+				escaped = false
+				continue
+			}
+			if c == '\\' && quote != '`' {
+				escaped = true
+				continue
+			}
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' || c == '`' || c == '\'' {
+			quote = c
+			continue
+		}
+		if c == '}' && i+1 < len(value) && value[i+1] == '}' {
+			end = i
+			break
+		}
+		if c == '{' || c == '}' {
+			return malformed()
+		}
+	}
+	if end < 0 {
+		return malformed()
+	}
+	prefix, inner, suffix = value[:start], strings.TrimSpace(value[start+2:end]), value[end+2:]
+	if strings.ContainsAny(suffix, "{}") {
+		return malformed()
+	}
+	return prefix, inner, suffix, true, nil
+}
