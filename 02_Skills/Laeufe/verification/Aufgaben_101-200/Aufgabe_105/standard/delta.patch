+func TestGetOpenSubsonicExtensionsWithoutAuthentication(t *testing.T) {
+	router := (&Router{}).routes()
+	want := responses.OpenSubsonicExtensions{
+		{Name: "transcodeOffset", Versions: []int32{1}},
+		{Name: "formPost", Versions: []int32{1}},
+		{Name: "songLyrics", Versions: []int32{1}},
+	}
+
+	for _, path := range []string{"/getOpenSubsonicExtensions", "/getOpenSubsonicExtensions.view"} {
+		t.Run(path, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, path+"?f=json", nil))
+
+			if w.Code != http.StatusOK {
+				t.Fatalf("status = %d, body = %s", w.Code, w.Body.String())
+			}
+			if got := w.Header().Get("Content-Type"); got != "application/json" {
+				t.Fatalf("Content-Type = %q", got)
+			}
+			var response responses.JsonWrapper
+			if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil {
+				t.Fatal(err)
+			}
+			if response.Subsonic.Status != responses.StatusOK {
+				t.Fatalf("response status = %q", response.Subsonic.Status)
+			}
+			got := response.Subsonic.OpenSubsonicExtensions
+			if got == nil || len(*got) != len(want) {
+				t.Fatalf("extensions = %v", got)
+			}
+			for i, extension := range *got {
+				if extension.Name != want[i].Name || len(extension.Versions) != 1 || extension.Versions[0] != 1 {
+					t.Fatalf("extension %d = %+v, want %+v", i, extension, want[i])
+				}
+			}
+		})
+	}
+}
