--- a/lib/srv/db/proxy_test.go
+++ b/lib/srv/db/proxy_test.go
@@ -25,10 +25,54 @@ import (
 	"github.com/gravitational/teleport/lib/auth"
 	"github.com/gravitational/teleport/lib/events"
 	"github.com/gravitational/teleport/lib/multiplexer"
+	"github.com/gravitational/teleport/lib/reversetunnel"
+	"github.com/gravitational/teleport/lib/tlsca"
 
 	"github.com/stretchr/testify/require"
 )
 
+// TestProxyRetriesOfflineDatabaseService verifies that a second service can
+// serve a database when the first service's reverse tunnel is unavailable.
+func TestProxyRetriesOfflineDatabaseService(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	go testCtx.startHandlingConnections()
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+	good := testCtx.postgres["postgres"].server
+	bad := good.Copy().(*types.DatabaseServerV3)
+	bad.Spec.HostID = "offline-host"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, bad)
+	require.NoError(t, err)
+	_, candidates, err := testCtx.proxyServer.pickDatabaseServers(ctx, tlsca.Identity{
+		RouteToCluster:  testCtx.clusterName,
+		RouteToDatabase: tlsca.RouteToDatabase{ServiceName: "postgres"},
+	})
+	require.NoError(t, err)
+	require.Len(t, candidates, 2)
+
+	site, err := testCtx.proxyServer.cfg.Tunnel.GetSite(testCtx.clusterName)
+	require.NoError(t, err)
+	site.(*reversetunnel.FakeRemoteSite).OfflineTunnels = map[string]bool{
+		"offline-host." + testCtx.clusterName: true,
+	}
+	testCtx.proxyServer.cfg.Shuffle = func(servers []types.DatabaseServer) []types.DatabaseServer {
+		if len(servers) < 2 || servers[0].GetHostID() == "offline-host" {
+			return servers
+		}
+		return []types.DatabaseServer{servers[1], servers[0]}
+	}
+
+	conn, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.NoError(t, err)
+	require.NoError(t, conn.Close(ctx))
+
+	// Once every matching tunnel is offline, a new connection must fail.
+	site.(*reversetunnel.FakeRemoteSite).OfflineTunnels[good.GetHostID()+"."+testCtx.clusterName] = true
+	_, err = testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.Error(t, err)
+}
+
