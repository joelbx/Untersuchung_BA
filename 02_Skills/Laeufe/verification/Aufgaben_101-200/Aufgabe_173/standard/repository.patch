+	return fmt.Sprintf("DatabaseServer(Name=%v, HostID=%v, Type=%v, Version=%v, Labels=%v)",
+		s.GetName(), s.GetHostID(), s.GetType(), s.GetTeleportVersion(), s.GetStaticLabels())
 }
 
 // CheckAndSetDefaults checks and sets default values for any missing fields.
@@ -344,11 +344,30 @@ type SortedDatabaseServers []DatabaseServer
 // Len returns the slice length.
 func (s SortedDatabaseServers) Len() int { return len(s) }
 
-// Less compares database servers by name.
-func (s SortedDatabaseServers) Less(i, j int) bool { return s[i].GetName() < s[j].GetName() }
+// Less compares database servers by name, then by host ID.
+func (s SortedDatabaseServers) Less(i, j int) bool {
+	if s[i].GetName() == s[j].GetName() {
+		return s[i].GetHostID() < s[j].GetHostID()
+	}
+	return s[i].GetName() < s[j].GetName()
+}
 
 // Swap swaps two database servers.
 func (s SortedDatabaseServers) Swap(i, j int) { s[i], s[j] = s[j], s[i] }
 
 // DatabaseServers is a list of database servers.
 type DatabaseServers []DatabaseServer
+
+// DeduplicateDatabaseServers returns the first server for each name in input order.
+func DeduplicateDatabaseServers(servers []DatabaseServer) []DatabaseServer {
+	result := make([]DatabaseServer, 0, len(servers))
+	seen := make(map[string]struct{}, len(servers))
+	for _, server := range servers {
+		if _, ok := seen[server.GetName()]; ok {
+			continue
+		}
+		seen[server.GetName()] = struct{}{}
+		result = append(result, server)
+	}
+	return result
+}
diff --git a/api/types/databaseserver_test.go b/api/types/databaseserver_test.go
new file mode 100644
index 0000000..a64a168
--- /dev/null
+++ b/api/types/databaseserver_test.go
@@ -0,0 +1,36 @@
+package types
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDatabaseServerDisplayHelpers(t *testing.T) {
+	server := func(name, hostID string) DatabaseServer {
+		return NewDatabaseServerV3(name, nil, DatabaseServerSpecV3{HostID: hostID})
+	}
+	first := server("alpha", "host-b")
+	second := server("alpha", "host-a")
+	third := server("beta", "host-c")
+
+	servers := []DatabaseServer{third, first, second}
+	deduplicated := DeduplicateDatabaseServers(servers)
+	if len(deduplicated) != 2 || deduplicated[0] != third || deduplicated[1] != first {
+		t.Fatalf("unexpected deduplicated servers: %v", deduplicated)
+	}
+	if len(servers) != 3 || servers[2] != second {
+		t.Fatalf("input was changed: %v", servers)
+	}
+	if got := DeduplicateDatabaseServers(nil); len(got) != 0 {
+		t.Fatalf("expected no servers, got %v", got)
+	}
+
+	sort.Sort(SortedDatabaseServers(servers))
+	if servers[0] != second || servers[1] != first || servers[2] != third {
+		t.Fatalf("unexpected sort order: %v", servers)
+	}
+	if !strings.Contains(first.String(), "HostID=host-b") {
+		t.Fatalf("server string does not include host ID: %s", first)
+	}
+}
