+def test_reply_is_not_used_during_construction():
+    class Reply:
+        def __init__(self):
+            self.ignored = 0
+
+        def ignoreSslErrors(self):
+            self.ignored += 1
+
+    reply = Reply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('<script>"&\'')])
+    assert reply.ignored == 0
+    assert wrapper.html() == '<p>&lt;script&gt;&quot;&amp;&#x27;</p>'
+    wrapper.accept_certificate()
+    assert reply.ignored == 1
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
