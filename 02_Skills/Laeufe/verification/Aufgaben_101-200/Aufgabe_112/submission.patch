@@ -0,0 +1,75 @@
+//go:build !scanner
+
+package models
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertFortinetToModel(t *testing.T) {
+	published := time.Date(2023, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	got := ConvertFortinetToModel("CVE-2023-0001", []cvedict.Fortinet{{
+		AdvisoryID: "FG-IR-23-001", Title: "FortiOS issue", Summary: "Affected versions",
+		AdvisoryURL:   "https://www.fortiguard.com/psirt/FG-IR-23-001",
+		Cvss3:         cvedict.FortinetCvss3{Cvss3: cvedict.Cvss3{BaseScore: 8.1, VectorString: "CVSS:3.1/AV:N", BaseSeverity: "HIGH"}},
+		Cwes:          []cvedict.FortinetCwe{{CweID: "CWE-20"}},
+		References:    []cvedict.FortinetReference{{Reference: cvedict.Reference{Link: "https://example.org/advisory", Source: "vendor"}}},
+		PublishedDate: published, LastModifiedDate: modified,
+	}})
+	want := []CveContent{{
+		Type: Fortinet, CveID: "CVE-2023-0001", Title: "FortiOS issue", Summary: "Affected versions",
+		SourceLink: "https://www.fortiguard.com/psirt/FG-IR-23-001",
+		Cvss3Score: 8.1, Cvss3Vector: "CVSS:3.1/AV:N", Cvss3Severity: "HIGH",
+		CweIDs: []string{"CWE-20"}, References: []Reference{{Link: "https://example.org/advisory", Source: "vendor"}},
+		Published: published, LastModified: modified,
+	}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ConvertFortinetToModel() = %#v, want %#v", got, want)
+	}
+}
+
+func TestFortinetContentOrdering(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Trivy:    {{Type: Trivy, Summary: "trivy", Cvss3Severity: "HIGH"}},
+		Fortinet: {{Type: Fortinet, Title: "fortinet", Summary: "fortinet", Cvss3Score: 8}},
+		Nvd:      {{Type: Nvd, Summary: "nvd", Cvss3Score: 6}},
+		GitHub:   {{Type: GitHub, Summary: "github"}},
+	}}
+	for name, got := range map[string][]CveContentType{
+		"titles":    contentStrTypes(v.Titles("en", "")),
+		"summaries": contentStrTypes(v.Summaries("en", "")),
+		"cvss3":     contentCvssTypes(v.Cvss3Scores()),
+	} {
+		var want []CveContentType
+		switch name {
+		case "titles":
+			want = []CveContentType{Trivy, Fortinet, Nvd, GitHub}
+		case "summaries":
+			want = []CveContentType{Trivy, Fortinet, Nvd, GitHub}
+		case "cvss3":
+			want = []CveContentType{Fortinet, Nvd, Trivy}
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s order = %v, want %v", name, got, want)
+		}
+	}
+}
+
+func contentStrTypes(values []CveContentStr) (types []CveContentType) {
+	for _, value := range values {
+		types = append(types, value.Type)
+	}
+	return types
+}
+
+func contentCvssTypes(values []CveContentCvss) (types []CveContentType) {
+	for _, value := range values {
+		types = append(types, value.Type)
+	}
+	return types
+}
