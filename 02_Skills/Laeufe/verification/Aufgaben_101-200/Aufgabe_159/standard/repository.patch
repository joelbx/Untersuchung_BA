@@ -0,0 +1,78 @@
+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/package-url/packageurl-go"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typeName, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"cargo", "serde", "", "serde", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typeName+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typeName, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.typeName, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPURLPackageName(t *testing.T) {
+	tests := []struct {
+		scannerType, input, wantType, namespace, name, subpath string
+	}{
+		{"pom", "com.google.guava:guava", "maven", "com.google.guava", "guava", ""},
+		{"pip", "My_Package", "pypi", "", "my-package", ""},
+		{"gomod", "github.com/protobom/protobom", "golang", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "npm", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "cocoapods", "", "GoogleUtilities", "NSData+zlib"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.scannerType, func(t *testing.T) {
+			scanner := models.LibraryScanner{Type: ftypes.LangType(tt.scannerType), LockfilePath: "lockfile", Libs: []models.Library{{Name: tt.input, Version: "1.0"}}}
+			components := libpkgToCdxComponents(scanner, map[string]map[string]string{"lockfile": {}})
+			purl, err := packageurl.FromString(components[1].PackageURL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if purl.Type != tt.wantType || purl.Namespace != tt.namespace || purl.Name != tt.name || purl.Subpath != tt.subpath {
+				t.Errorf("PURL fields = (%q, %q, %q, %q), want (%q, %q, %q, %q)", purl.Type, purl.Namespace, purl.Name, purl.Subpath, tt.wantType, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestGitHubDependencyPURLPackageName(t *testing.T) {
+	manifest := models.DependencyGraphManifest{
+		Filename:   "pom.xml",
+		Repository: "https://example.com/repo",
+		Dependencies: []models.Dependency{
+			{PackageName: "com.google.guava:guava", Requirements: "= 1.0"},
+		},
+	}
+	components := ghpkgToCdxComponents(manifest, map[string]map[string]string{manifest.RepoURLFilename(): {}})
+	purl, err := packageurl.FromString(components[1].PackageURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if purl.Type != "maven" || purl.Namespace != "com.google.guava" || purl.Name != "guava" || purl.Subpath != "" {
+		t.Errorf("unexpected PURL fields: type=%q namespace=%q name=%q subpath=%q", purl.Type, purl.Namespace, purl.Name, purl.Subpath)
+	}
+}
