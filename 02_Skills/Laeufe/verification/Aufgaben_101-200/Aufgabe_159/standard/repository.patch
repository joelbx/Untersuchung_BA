+// purlPkgType maps scanner and manifest ecosystem names to PURL types.
+func purlPkgType(t string) string {
+	switch t {
+	case "gomod", "gobinary":
+		return "golang"
+	case "jar", "pom", "gradle", "sbt":
+		return "maven"
+	case "pip", "pipenv", "poetry", "uv", "python-pkg":
+		return "pypi"
+	case "yarn", "pnpm", "node-pkg", "javascript":
+		return "npm"
+	default:
+		return t
+	}
+}
+
+// parsePkgName returns the PURL namespace, name, and subpath for a package.
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch t {
+	case "maven":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			return group, artifact, ""
+		}
+	case "pypi":
+		name = strings.ToLower(strings.ReplaceAll(n, "_", "-"))
+	case "golang":
+		if i := strings.LastIndex(n, "/"); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				return scope, pkg, ""
+			}
+		}
+	case "cocoapods":
+		if pod, part, ok := strings.Cut(n, "/"); ok {
+			return "", pod, part
+		}
+	}
+	return "", name, ""
+}
