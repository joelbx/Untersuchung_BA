diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..84be1a0
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,26 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chats to chat allow lists',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settings = await db.getObjects(uids.map(uid => `user:${uid}:settings`));
+			const restricted = uids.filter((uid, index) => settings[index] &&
+				parseInt(settings[index].restrictChat, 10) === 1 &&
+				settings[index].chatAllowList === undefined);
+			const following = await db.getSortedSetsMembers(restricted.map(uid => `following:${uid}`));
+			await db.setObjectBulk(restricted.map((uid, index) => [
+				`user:${uid}:settings`,
+				{ chatAllowList: JSON.stringify((following[index] || []).map(String)) },
+			]));
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
