+    @pytest.mark.parametrize('val', ['User-Agent {foo}', 'ASCII ~'])
+    def test_to_py_ascii_valid(self, klass, val):
+        assert klass(fields=('foo',), encoding='ascii').to_py(val) == val
+
+    def test_to_py_ascii_invalid(self, klass):
+        with pytest.raises(configexc.ValidationError,
+                           match='contains non-ascii characters'):
+            klass(fields=('foo',), encoding='ascii').to_py('Agent {foo} ä')
+
+    def test_to_py_unrestricted_encoding(self, typ):
+        assert typ.to_py('Agent {foo} ä') == 'Agent {foo} ä'
+
+    def test_to_py_other_encoding(self, klass):
+        typ = klass(fields=('foo',), encoding='latin-1')
+        assert typ.to_py('Agent ä') == 'Agent ä'
+        with pytest.raises(configexc.ValidationError,
