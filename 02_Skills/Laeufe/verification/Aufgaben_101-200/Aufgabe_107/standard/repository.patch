+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs } from './elementsActions';
+import reducer, { newState } from './elementsSlice';
+
+const message = { ID: 'message-1', ConversationID: 'conversation-1' } as Element;
+const conversation = { ID: 'conversation-2' } as Element;
+const elements = [message, conversation];
+
+describe('optimistic mark-as bypass filtering', () => {
+    it('adds unique conversation IDs and removes them when the new status matches the filter', () => {
+        const initial = newState({ params: { filter: { Unread: 1 } } });
+        const markedRead = reducer(
+            initial,
+            optimisticMarkAs({ elements, bypass: true, conversationMode: true, markAsStatus: MARK_AS_STATUS.READ })
+        );
+        expect(markedRead.bypassFilter).toEqual(['conversation-1', 'conversation-2']);
+
+        const markedReadAgain = reducer(
+            markedRead,
+            optimisticMarkAs({ elements, bypass: true, conversationMode: true, markAsStatus: MARK_AS_STATUS.READ })
+        );
+        expect(markedReadAgain.bypassFilter).toEqual(['conversation-1', 'conversation-2']);
+
+        const markedUnread = reducer(
+            markedReadAgain,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: true,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(markedUnread.bypassFilter).toEqual(['conversation-2']);
+    });
+
+    it('uses message IDs in message mode and removes only matching entries', () => {
+        const initial = { ...newState({ params: { filter: { Unread: 0 } } }), bypassFilter: ['other-message'] };
+        const markedUnread = reducer(
+            initial,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(markedUnread.bypassFilter).toEqual(['other-message', 'message-1']);
+
+        const markedRead = reducer(
+            markedUnread,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.READ,
+            })
+        );
+        expect(markedRead.bypassFilter).toEqual(['other-message']);
+    });
+
+    it('leaves bypass entries alone without a bypass request and mark-as status', () => {
+        const initial = { ...newState({ params: { filter: { Unread: 1 } } }), bypassFilter: ['message-1'] };
+        const withoutBypass = reducer(
+            initial,
+            optimisticMarkAs({ elements: [message], markAsStatus: MARK_AS_STATUS.UNREAD })
+        );
+        const withoutStatus = reducer(withoutBypass, optimisticMarkAs({ elements: [message], bypass: true }));
+        expect(withoutStatus.bypassFilter).toEqual(['message-1']);
+    });
+});
