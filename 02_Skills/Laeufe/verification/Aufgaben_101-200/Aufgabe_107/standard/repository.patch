+import { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+import { getElementsToBypassFilter } from './elementBypassFilters';
+
+const elements = [{ ID: 'message-1' }, { ID: 'message-2' }] as Element[];
+
+describe('getElementsToBypassFilter', () => {
+    it.each([
+        [MARK_AS_STATUS.READ, 0],
+        [MARK_AS_STATUS.UNREAD, 1],
+    ])('removes bypass entries when %s matches filter %s', (status, unreadFilter) => {
+        expect(getElementsToBypassFilter(elements, status, unreadFilter)).toEqual({
+            elementsToBypass: [],
+            elementsToRemove: elements,
+        });
+    });
+
+    it.each([
+        [MARK_AS_STATUS.READ, 1],
+        [MARK_AS_STATUS.UNREAD, 0],
+        [MARK_AS_STATUS.READ, undefined],
+    ])('adds bypass entries when %s does not match filter %s', (status, unreadFilter) => {
+        expect(getElementsToBypassFilter(elements, status, unreadFilter)).toEqual({
+            elementsToBypass: elements,
+            elementsToRemove: [],
+        });
+    });
+});
diff --git a/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
