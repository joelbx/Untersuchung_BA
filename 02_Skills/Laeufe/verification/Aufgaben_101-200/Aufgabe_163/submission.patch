+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseSQLite:
+		return "sqlite3"
+	case DatabasePostgres:
+		return "postgres"
+	case DatabaseMySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// Validate checks the selected database configuration mode.
+func (d DatabaseConfig) Validate() error {
+	if d.URL != "" {
+		return nil
+	}
+	if d.Protocol == 0 {
+		return errors.New("db.protocol is required when db.url is empty")
+	}
+	if d.Protocol != DatabaseSQLite && d.Protocol != DatabasePostgres && d.Protocol != DatabaseMySQL {
+		return fmt.Errorf("db.protocol %d is invalid; expected sqlite3, postgres, or mysql", d.Protocol)
+	}
+	if d.Host == "" {
+		return errors.New("db.host is required when db.url is empty (SQLite: filesystem path)")
+	}
+	if d.Name == "" {
+		return errors.New("db.name is required when db.url is empty")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return errors.New("db.port must be between 0 and 65535")
+	}
+	return nil
 }
 
