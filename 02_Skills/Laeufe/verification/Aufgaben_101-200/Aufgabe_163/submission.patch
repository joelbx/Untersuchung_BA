+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	require.NoError(t, err)
+	defer os.Remove(f.Name())
+	defer f.Close()
+	_, err = f.WriteString("db:\n  protocol: oracle\n  host: localhost\n  name: flipt\n")
+	require.NoError(t, err)
+	_, err = Load(f.Name())
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "db.protocol \"oracle\"")
+	assert.Contains(t, err.Error(), "sqlite3, postgres, or mysql")
+	require.NoError(t, f.Truncate(0))
+	_, err = f.Seek(0, 0)
+	require.NoError(t, err)
+	_, err = f.WriteString("db:\n  url: file:flipt.db\n  protocol: oracle\n")
+	require.NoError(t, err)
+	_, err = Load(f.Name())
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "db.protocol \"oracle\"")
+}
