+		{"sqlite", config.DatabaseConfig{Protocol: config.DatabaseSQLite, Host: "/tmp", Name: "flipt.db"}, SQLite, "/tmp/flipt.db?_fk=true&cache=shared"},
+		{"postgres", config.DatabaseConfig{Protocol: config.DatabasePostgres, Host: "localhost", User: "alice", Password: "secret", Name: "flipt"}, Postgres, "dbname=flipt host=localhost password=secret port=5432 user=alice"},
+		{"mysql", config.DatabaseConfig{Protocol: config.DatabaseMySQL, Host: "localhost", User: "alice", Password: "secret", Name: "flipt"}, MySQL, "alice:secret@tcp(localhost:3306)/flipt?multiStatements=true&parseTime=true&sql_mode=ANSI"},
