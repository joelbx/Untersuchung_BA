diff --git a/openlibrary/tests/test_project_runeberg_provider.py b/openlibrary/tests/test_project_runeberg_provider.py
new file mode 100644
index 0000000..cfff2ee
--- /dev/null
+++ b/openlibrary/tests/test_project_runeberg_provider.py
@@ -0,0 +1,56 @@
+from pathlib import Path
+
+from web.template import Template
+
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+    get_solr_keys,
+    is_non_ia_ocaid,
+)
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.solr_key in get_solr_keys()
+    assert provider.is_own_ocaid('projectrunebergbook')
+    assert is_non_ia_ocaid('projectrunebergbook')
+    assert not provider.is_own_ocaid('unrelatedbook')
+
+    edition = {'identifiers': {'project_runeberg': ['nordic/book1', 'other']}}
+    acquisitions = provider.get_acquisitions(edition)
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].price is None
+    assert acquisitions[0].url == 'https://runeberg.org/nordic/book1/'
+    assert acquisitions[0].provider_name == 'runeberg'
+
+
+def test_project_runeberg_templates_render():
+    template_dir = Path(__file__).resolve().parents[1] / 'templates' / 'book_providers'
+    globals = {'_': lambda message: message, 'render_once': lambda _: True}
+
+    read = Template(
+        (template_dir / 'runeberg_read_button.html').read_text(), globals=globals
+    )
+    rendered = str(read('nordic/book1'))
+    assert 'https://runeberg.org/nordic/book1/' in rendered
+    assert 'Project Runeberg' in rendered
+    assert 'Nordic literary works' in rendered
+    assert 'data-event="read"' not in rendered
+
+    rendered_with_analytics = str(
+        read('nordic/book1', lambda action: f'data-event="{action.lower()}"')
+    )
+    assert 'data-event="read"' in rendered_with_analytics
+
+    download = Template(
+        (template_dir / 'runeberg_download_options.html').read_text(),
+        globals=globals,
+    )
+    rendered = str(download('nordic/book1'))
+    for label in ('Scanned images', 'Color images', 'HTML', 'Text files', 'OCR content'):
+        assert label in rendered
+    assert 'https://runeberg.org/nordic/book1/' in rendered
