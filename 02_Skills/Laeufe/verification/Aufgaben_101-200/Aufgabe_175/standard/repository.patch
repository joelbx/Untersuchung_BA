+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	previous := Server.Backup
+	t.Cleanup(func() { Server.Backup = previous })
+	for _, tc := range []struct {
+		input, normalized string
+		valid             bool
+	}{
+		{"1h", "@every 1h", true},
+		{"0 2 * * *", "0 2 * * *", true},
+		{"", "", true},
+		{"not a schedule", "not a schedule", false},
+		{"0s", "0s", false},
+	} {
+		Server.Backup.Schedule = tc.input
+		err := validateBackupSchedule()
+		if (err == nil) != tc.valid || Server.Backup.Schedule != tc.normalized {
+			t.Errorf("input %q: schedule %q, error %v", tc.input, Server.Backup.Schedule, err)
+		}
+	}
+}
