diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..2f51790
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,176 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupSuffix = ".db"
+const backupTimestamp = "20060102T150405.000000000"
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup.path is empty")
+	}
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return "", err
+	}
+	path := filepath.Join(dir, backupPrefix+time.Now().UTC().Format(backupTimestamp)+backupSuffix)
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	if err := file.Close(); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	dest, err := sql.Open(Driver, path)
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	copyErr := copySQLite(ctx, d.readDB, dest)
+	closeErr := dest.Close()
+	if err := errors.Join(copyErr, closeErr); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	if _, err := os.Stat(absolute); err != nil {
+		return err
+	}
+	if Path != ":memory:" {
+		live, err := filepath.Abs(Path)
+		if err == nil && live == absolute {
+			return errors.New("backup file is the live database")
+		}
+		if liveInfo, err := os.Stat(live); err == nil {
+			if sourceInfo, err := os.Stat(absolute); err == nil && os.SameFile(liveInfo, sourceInfo) {
+				return errors.New("backup file is the live database")
+			}
+		}
+	}
+	sourceURL := (&url.URL{Scheme: "file", Path: absolute, RawQuery: "mode=ro"}).String()
+	source, err := sql.Open(Driver, sourceURL)
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var result string
+	if err := source.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&result); err != nil {
+		return fmt.Errorf("invalid backup: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("invalid backup: %s", result)
+	}
+	if err := copySQLite(ctx, source, d.writeDB); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+func copySQLite(ctx context.Context, source, destination *sql.DB) error {
+	src, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	dst, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dst.Close()
+	return src.Raw(func(srcDriver any) error {
+		sqliteSource, ok := srcDriver.(*sqlite3.SQLiteConn)
+		if !ok {
+			return errors.New("source is not SQLite")
+		}
+		return dst.Raw(func(dstDriver any) error {
+			sqliteDestination, ok := dstDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("destination is not SQLite")
+			}
+			backup, err := sqliteDestination.Backup("main", sqliteSource, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(100)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return 0, errors.New("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count cannot be negative")
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, backupSuffix) {
+			continue
+		}
+		timestamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), backupSuffix)
+		if _, err := time.Parse(backupTimestamp, timestamp); err == nil {
+			names = append(names, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(dir, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
