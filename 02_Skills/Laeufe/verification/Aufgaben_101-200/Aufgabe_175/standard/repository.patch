+package cmd
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	create := &cobra.Command{Use: "create", Short: "Create a database backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		path, err := db.Db().Backup(cmd.Context())
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintln(cmd.OutOrStdout(), path)
+		return err
+	}}
+	prune := &cobra.Command{Use: "prune", Short: "Delete old database backups", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		force, _ := cmd.Flags().GetBool("force")
+		if conf.Server.Backup.Count == 0 && !force {
+			if !confirmBackupAction(cmd, "Delete all database backups") {
+				return errors.New("backup pruning cancelled")
+			}
+		}
+		count, err := db.Db().Prune(cmd.Context())
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backups\n", count)
+		return err
+	}}
+	prune.Flags().Bool("force", false, "skip confirmation")
+	restore := &cobra.Command{Use: "restore", Short: "Restore a database backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		path, _ := cmd.Flags().GetString("backup-file")
+		force, _ := cmd.Flags().GetBool("force")
+		if !force && !confirmBackupAction(cmd, "Replace the current database with "+path) {
+			return errors.New("database restore cancelled")
+		}
+		if err := db.Db().Restore(cmd.Context(), path); err != nil {
+			return err
+		}
+		_, err := fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+		return err
+	}}
+	restore.Flags().String("backup-file", "", "backup database file to restore")
+	_ = restore.MarkFlagRequired("backup-file")
+	restore.Flags().Bool("force", false, "skip confirmation")
+	backupCmd.AddCommand(create, prune, restore)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackupAction(cmd *cobra.Command, action string) bool {
+	_, _ = fmt.Fprintf(cmd.OutOrStdout(), "%s? Type yes to continue: ", action)
+	line, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	return err == nil && strings.EqualFold(strings.TrimSpace(line), "yes")
+}
