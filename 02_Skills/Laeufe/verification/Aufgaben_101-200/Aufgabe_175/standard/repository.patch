+++ b/db/backup_test.go
@@ -0,0 +1,87 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "live.db")
+	previousPath, previousBackup := Path, conf.Server.Backup
+	Path = path
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 1
+	t.Cleanup(func() { Path = previousPath; conf.Server.Backup = previousBackup })
+	read, err := sql.Open(Driver, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer read.Close()
+	write, err := sql.Open(Driver, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer write.Close()
+	database := &db{readDB: read, writeDB: write}
+	ctx := context.Background()
+	if _, err := write.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(first); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := write.Exec("UPDATE items SET value='after'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup paths collided")
+	}
+	removed, err := database.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned %d: %v", removed, err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("old backup remains: %v", err)
+	}
+	if _, err := write.Exec("UPDATE items SET value='changed again'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := database.Restore(ctx, second); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := write.QueryRow("SELECT value FROM items").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "after" {
+		t.Fatalf("restored %q", value)
+	}
+	if err := database.Restore(ctx, path); err == nil {
+		t.Fatal("accepted live database as backup")
+	}
+	if err := os.WriteFile(filepath.Join(conf.Server.Backup.Path, "unrelated.db"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	conf.Server.Backup.Count = 0
+	removed, err = database.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned %d with count zero: %v", removed, err)
+	}
+	if _, err := os.Stat(filepath.Join(conf.Server.Backup.Path, "unrelated.db")); err != nil {
+		t.Fatal(err)
+	}
+}
