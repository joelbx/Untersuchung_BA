@@ -62,3 +62,83 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_create_address_family(self):
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[
+            dict(rt='1:1'), dict(rt='2:2', direction='import')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'route-target import 1:1', 'route-target export 1:1',
+            'route-target import 2:2'])
+
+    def test_route_targets_mixed_changes_scoped_to_address_family(self):
+        self.get_config.return_value = '''vrf context other
+  address-family ipv4 unicast
+    route-target import 4:4
+vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target import 2:2
+    route-target import 3:3
+  address-family ipv6 unicast
+    route-target export 4:4
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='1:1'), dict(rt='2:2', direction='import', state='absent'),
+            dict(rt='3:3', direction='both', state='absent'),
+            dict(rt='4:4', direction='export')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target import 2:2', 'no route-target import 3:3',
+            'route-target export 4:4'])
+        self.load_config.assert_called_once()
+
+    def test_match_current_rt_exact_line(self):
+        current = 'address-family ipv4 unicast\n  route-target import 1:10\nend'
+        rt = dict(rt='1:1', state='present')
+        commands = []
+        self.assertIs(nxos_vrf_af.match_current_rt(rt, 'import', current, commands), commands)
+        self.assertEqual(commands, ['route-target import 1:1'])
+
+    def test_route_targets_idempotent(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='1:1'),
+                                            dict(rt='2:2', direction='import', state='absent')]))
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_remove_auto_evpn(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_target_both_auto_evpn=False))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'no route-target both auto evpn'])
+
+    def test_absent_ignores_route_target_options(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='2:2')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'no address-family ipv4 unicast'])
+
+    def test_route_target_requires_rt(self):
