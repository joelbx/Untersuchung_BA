+    def get_locally_reachable_ips(self, ip_path):
+        """Return destinations of local routes, including host-scoped prefixes."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, version in (('ipv4', '-4'), ('ipv6', '-6')):
+            if family == 'ipv6' and not socket.has_ipv6:
+                continue
+            rc, output, stderr = self.module.run_command(
+                [ip_path, version, 'route', 'show', 'table', 'local'],
+                errors='surrogate_then_replace')
+            if rc != 0:
+                self.module.warn('Unable to gather locally reachable %s addresses' % family)
+                continue
+
+            networks = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if network.version == (4 if family == 'ipv4' else 6):
+                    networks.add(network)
+
+            reachable[family] = [
+                str(network.network_address) if network.prefixlen == network.max_prefixlen
+                else network.with_prefixlen
+                for network in sorted(networks, key=lambda item: (int(item.network_address), item.prefixlen))
+            ]
+        return reachable
+
