+// requestCertificate caches only certificates with at least a minute of validity.
+// Concurrent requests for the same authenticated identity share one CSR.
 func (f *Forwarder) requestCertificate(ctx authContext) (*tls.Config, error) {
+	if f.userCredentials == nil {
+		return f.requestCertificateUncached(ctx)
+	}
+	key := ctx.key()
+	for {
+		if config := f.cachedCertificate(key); config != nil {
+			return config, nil
+		}
+
+		wait, done := f.getOrCreateRequestContext(key)
+		if done == nil {
+			select {
+			case <-wait.Done():
+				continue
+			case <-f.ctx.Done():
+				return nil, trace.BadParameter("forwarder is closing, aborting the request")
+			}
+		}
+		// A prior request may have populated the cache between our first
+		// lookup and acquiring the per-key CSR slot.
+		if config := f.cachedCertificate(key); config != nil {
+			done()
+			return config, nil
+		}
+		config, err := f.requestCertificateUncached(ctx)
+		if err == nil {
+			cert := &config.Certificates[0]
+			cert.Leaf, err = x509.ParseCertificate(cert.Certificate[0])
+			if err == nil {
+				ttl := cert.Leaf.NotAfter.Sub(f.Clock.Now()) - time.Minute
+				if ttl > 0 && ctx.sessionTTL > 0 {
+					if ttl > ctx.sessionTTL {
+						ttl = ctx.sessionTTL
+					}
+					f.Lock()
+					err = f.userCredentials.Set(key, config, ttl)
+					f.Unlock()
+				}
+			}
+		}
+		done()
+		return config, trace.Wrap(err)
+	}
+}
