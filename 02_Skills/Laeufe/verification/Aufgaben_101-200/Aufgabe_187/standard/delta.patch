+func TestRequestCertificateCachesConcurrentRequests(t *testing.T) {
+	client, err := newMockCSRClient()
+	require.NoError(t, err)
+	client.notAfter = time.Now().Add(2 * time.Hour)
+	cache, err := ttlmap.New(defaults.ClientCacheSize)
+	require.NoError(t, err)
+	user, err := services.NewUser("bob")
+	require.NoError(t, err)
+	f := &Forwarder{
+		ForwarderConfig: ForwarderConfig{
+			AuthClient: client,
+			Keygen:     testauthority.New(),
+			Clock:      clockwork.NewRealClock(),
+		},
+		log:             logrus.New(),
+		userCredentials: cache,
+		activeRequests:  make(map[string]context.Context),
+		ctx:             context.Background(),
+	}
+	ctx := authContext{
+		Context: auth.Context{
+			User:     user,
+			Identity: auth.WrapIdentity(tlsca.Identity{Username: "bob"}),
+		},
+		teleportCluster: teleportClusterClient{name: "remote"},
+		sessionTTL:      time.Hour,
+	}
+	var wg sync.WaitGroup
+	errs := make(chan error, 10)
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := f.requestCertificate(ctx)
+			errs <- err
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	client.mu.Lock()
+	defer client.mu.Unlock()
+	require.Equal(t, 1, client.calls)
+	require.Equal(t, 1, cache.Len())
+}
