+@pytest.mark.parametrize('blocked_set', ['_blocked_hosts', '_config_blocked_hosts'])
+def test_parent_domain_blocking(config_stub, host_blocker_factory, blocked_set):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = None
+
+    blocker = host_blocker_factory()
+    getattr(blocker, blocked_set).add('example.com')
+
+    for host in ('example.com', 'sub.example.com', 'a.b.example.com',
+                 'a.b.example.com.'):
+        assert blocker._is_blocked(QUrl('https://' + host + '/path'))
+    assert not blocker._is_blocked(QUrl('https://otherexample.com/'))
+
+    config_stub.val.content.blocking.whitelist = ['https://a.b.example.com/*']
+    assert not blocker._is_blocked(QUrl('https://a.b.example.com/path'))
+    assert blocker._is_blocked(QUrl('https://sub.example.com/path'))
+
+    config_stub.val.content.blocking.enabled = False
+    assert not blocker._is_blocked(QUrl('https://sub.example.com/path'))
+
+
