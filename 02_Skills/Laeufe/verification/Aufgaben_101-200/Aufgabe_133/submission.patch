+// NewDowngradedOSSAdminRole returns the restricted admin role used when
+// migrating existing open source users to RBAC.
+func NewDowngradedOSSAdminRole() Role {
+	role := NewOSSUserRole()
+	admin := role.(*RoleV3)
+	admin.Metadata.Name = teleport.AdminRoleName
+	admin.Metadata.Labels = map[string]string{teleport.OSSMigratedV6: types.True}
+	return role
