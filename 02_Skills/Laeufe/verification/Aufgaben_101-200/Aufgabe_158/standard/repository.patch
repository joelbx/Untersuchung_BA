 class ZipArchive(object):
 
+    @staticmethod
+    def _valid_time_stamp(value):
+        """Return a valid ZIP timestamp tuple, or the ZIP epoch for invalid dates."""
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = ZIP_TIMESTAMP_RE.match(value)
+        if not match:
+            return epoch
+
+        year, month, day, hour, minute, second = (int(part) for part in match.groups())
+        if not 1980 <= year <= 2107:
+            return epoch
+        try:
+            return datetime.datetime(year, month, day, hour, minute, second).timetuple()
+        except ValueError:
+            return epoch
+
