+func TestImageDigestJSON(t *testing.T) {
+	image := Image{Name: "alpine", Digest: "sha256:abc"}
+	data, err := json.Marshal(image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded Image
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded != image || decoded.GetFullName() != "alpine@sha256:abc" {
+		t.Errorf("image digest round trip = %+v, JSON = %s", decoded, data)
+	}
+}
