+func TestImageReference(t *testing.T) {
+	tests := []struct {
+		name, tag, digest, fullName, err string
+	}{
+		{"", "latest", "", ":latest", "Invalid arguments : no image name"},
+		{"alpine", "", "", "alpine:", "Invalid arguments : no image tag and digest"},
+		{"alpine", "latest", "sha256:abc", "alpine@sha256:abc", "Invalid arguments : you can either set image tag or digest"},
+		{"alpine", "latest", "", "alpine:latest", ""},
+		{"alpine", "", "sha256:abc", "alpine@sha256:abc", ""},
+	}
+	for _, tt := range tests {
+		image := Image{Name: tt.name, Tag: tt.tag, Digest: tt.digest}
+		if got := image.GetFullName(); got != tt.fullName {
+			t.Errorf("GetFullName(%+v) = %q, want %q", image, got, tt.fullName)
+		}
+		err := IsValidImage(image)
+		if tt.err == "" && err != nil || tt.err != "" && (err == nil || err.Error() != tt.err) {
+			t.Errorf("IsValidImage(%+v) = %v, want %q", image, err, tt.err)
+		}
+	}
+}
