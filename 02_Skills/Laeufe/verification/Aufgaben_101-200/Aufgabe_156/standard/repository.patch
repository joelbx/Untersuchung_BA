+class TestSanitizeKeys(unittest.TestCase):
+    def test_container_classes_and_binary_terms(self):
+        from collections import defaultdict
+        from types import MappingProxyType
+
+        source = defaultdict(list, {'password': [{'nested-password': 1}]})
+        result = sanitize_keys(source, (term for term in (b'password',)))
+        self.assertIs(type(result), defaultdict)
+        self.assertIs(result.default_factory, list)
+        self.assertEqual(result['VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'][0],
+                         {'nested-********': 1})
+        proxy = MappingProxyType({'password': 1})
+        self.assertIs(type(sanitize_keys(proxy, ['password'])), type(proxy))
+        self.assertIs(type(remove_values(frozenset(['secret']), [b'secret'])), frozenset)
+        self.assertEqual(remove_values(b'\xffsecret', ['secret']), b'\xff********')
+
+    def test_keys_only_nested_and_ignored(self):
+        from collections import OrderedDict
+
+        original = OrderedDict([('password', 'secret'),
+                                ('my-password-end', [OrderedDict([('password', 4)])]),
+                                ('changed', 1), ('_ansible_password', 2),
+                                ('nested', {'secret-field': 'secret'})])
+        result = sanitize_keys(original, (b'password', 'secret'), frozenset(('changed',)))
+        self.assertIs(type(result), OrderedDict)
+        self.assertEqual(result['VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'], 'secret')
+        self.assertEqual(result['my-********-end'][0]['VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'], 4)
+        self.assertIs(type(result['my-********-end'][0]), OrderedDict)
+        self.assertEqual(result['nested']['********-field'], 'secret')
+        self.assertEqual(result['changed'], 1)
+        self.assertEqual(result['_ansible_password'], 2)
+        self.assertIn('password', original)
+
+    def test_ignore_exact_and_non_mapping_passthrough(self):
+        from datetime import datetime
+
+        secret = 'status'
+        result = sanitize_keys({'status': 1, 'x-status': 2}, (secret,), {'status'})
+        self.assertEqual(result, {'status': 1, 'x-********': 2})
+        for value in ('status', 1, False, None, {1}, [ {'status': 1} ],
+                      ({'status': 1},), datetime(2020, 1, 1)):
+            self.assertIs(sanitize_keys(value, (secret,)), value)
