+    def test_values_only_and_types(self):
+        import datetime
+        from collections import OrderedDict
+
+        date = datetime.date(2020, 1, 1)
+        original = OrderedDict([('password', 'password and password'),
+                                ('nested', (b'secret', {'secret': [42, False, None, date]}))])
+        result = remove_values(original, (b'password', 'secret'))
+        self.assertIs(type(result), OrderedDict)
+        self.assertEqual(result['password'], '******** and ********')
+        self.assertEqual(result['nested'], (b'********', {'secret': [42, False, None, date]}))
+        self.assertIs(type(result['nested']), tuple)
+        self.assertEqual(list(original), ['password', 'nested'])
+        self.assertEqual(original['password'], 'password and password')
+
+    def test_deep_values(self):
+        root = []
+        leaf = root
+        for _ in range(10000):
+            child = []
+            leaf.append(child)
+            leaf = child
+        leaf.append('secret')
+        result = remove_values(root, ['secret'])
+        for _ in range(10000):
+            result = result[0]
+        self.assertEqual(result[0], '********')
+
