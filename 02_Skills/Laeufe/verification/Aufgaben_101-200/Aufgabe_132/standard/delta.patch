diff --git a/src/topics/system-tags.js b/src/topics/system-tags.js
new file mode 100644
index 0000000..04dfb54
--- /dev/null
+++ b/src/topics/system-tags.js
@@ -0,0 +1,12 @@
+'use strict';
+
+const meta = require('../meta');
+const utils = require('../utils');
+
+module.exports = function (tag) {
+	const configured = meta.config.systemTags;
+	const tags = Array.isArray(configured) ? configured : String(configured || '').split(',');
+	const normalize = value => utils.cleanUpTag(value, meta.config.maximumTagLength);
+	const normalizedTag = normalize(tag);
+	return !!normalizedTag && tags.some(value => normalize(value) === normalizedTag);
+};
