+func TestImportNestedMetadataAndNamespace(t *testing.T) {
+	const yamlInput = `namespace:
+  key: restored
+  name: Restored namespace
+  description: Restored description
+flags:
+  - key: nested
+    enabled: true
+    metadata:
+      settings:
+        labels:
+          - one
+          - two
+        options:
+          enabled: true
+          count: 3
+    variants:
+      - key: option
+        attachment:
+          data:
+            - name: first
+              values: [1, 2]
+`
+	const jsonInput = `{"namespace":{"key":"restored","name":"Restored namespace","description":"Restored description"},"flags":[{"key":"nested","enabled":true,"metadata":{"settings":{"labels":["one","two"],"options":{"enabled":true,"count":3}}},"variants":[{"key":"option","attachment":{"data":[{"name":"first","values":[1,2]}]}}]}]}`
+
+	for _, tc := range []struct {
+		name  string
+		enc   Encoding
+		input string
+	}{
+		{"YAML", EncodingYAML, yamlInput},
+		{"YAML comment", EncodingYAML, "# exported flags\n" + yamlInput},
+		{"JSON", EncodingJSON, jsonInput},
+		{"JSON header", EncodingJSON, "# exported flags\n" + jsonInput},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "restored", Name: "Restored namespace", Description: "Restored description"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "restored", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{"settings": map[string]any{"labels": []any{"one", "two"}, "options": map[string]any{"enabled": true, "count": float64(3)}}}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"data":[{"name":"first","values":[1,2]}]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImportJSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		"# first\n# second\n{}",
+		" \n# comment\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.Error(t, err)
+	}
+}
