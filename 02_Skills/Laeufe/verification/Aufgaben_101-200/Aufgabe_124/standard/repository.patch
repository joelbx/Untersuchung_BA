+func (b *Backend) disableOnDemandAutoScaling(billingMode string, tableExists bool) {
+	if !b.EnableAutoScaling || (billingMode != "pay_per_request" && billingMode != dynamodb.BillingModePayPerRequest) {
+		return
+	}
+	if tableExists {
+		b.Info("auto_scaling is ignored because the table is on-demand")
+	} else {
+		b.Info("auto_scaling is ignored because the table will be on-demand")
+	}
+	b.EnableAutoScaling = false
+}
