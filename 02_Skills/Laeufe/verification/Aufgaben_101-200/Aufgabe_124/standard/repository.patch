+type billingModeDynamo struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+	describeError  error
+}
+
+func (m *billingModeDynamo) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingModeDynamo) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingModeDynamo) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describeOutput, m.describeError
+}
+
+func TestBillingModeDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  string
+		valid bool
+	}{
+		{"", "pay_per_request", true},
+		{"pay_per_request", "pay_per_request", true},
+		{"provisioned", "provisioned", true},
+		{"invalid", "", false},
+	} {
+		cfg := Config{TableName: "test", BillingMode: tc.input}
+		err := cfg.CheckAndSetDefaults()
+		if !tc.valid {
+			require.Error(t, err)
+			continue
+		}
+		require.NoError(t, err)
+		require.Equal(t, tc.want, cfg.BillingMode)
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		mode       string
+		awsMode    string
+		throughput bool
+	}{
+		{"pay_per_request", dynamodb.BillingModePayPerRequest, false},
+		{"provisioned", dynamodb.BillingModeProvisioned, true},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			mock := &billingModeDynamo{}
+			b := &Backend{Entry: logrus.NewEntry(logrus.New()), Config: Config{BillingMode: tc.mode, ReadCapacityUnits: 17, WriteCapacityUnits: 23}, svc: mock}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(mock.createInput.BillingMode))
+			if !tc.throughput {
+				require.Nil(t, mock.createInput.ProvisionedThroughput)
+				return
+			}
+			require.Equal(t, int64(17), aws.Int64Value(mock.createInput.ProvisionedThroughput.ReadCapacityUnits))
+			require.Equal(t, int64(23), aws.Int64Value(mock.createInput.ProvisionedThroughput.WriteCapacityUnits))
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		output *dynamodb.DescribeTableOutput
+		err    error
+		status tableStatus
+		mode   string
+	}{
+		{"on-demand", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, nil, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"legacy provisioned", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}, nil, tableStatusOK, ""},
+		{"missing", nil, awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), tableStatusMissing, ""},
+		{"migration", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}}}, nil, tableStatusNeedsMigration, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &billingModeDynamo{describeOutput: tc.output, describeError: tc.err}}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.NoError(t, err)
+			require.Equal(t, tc.status, status)
+			require.Equal(t, tc.mode, mode)
+		})
+	}
+}
+
+func TestOnDemandDisablesAutoScaling(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		mode        string
+		exists      bool
+		wantEnabled bool
+	}{
+		{"existing on-demand", dynamodb.BillingModePayPerRequest, true, false},
+		{"new on-demand", "pay_per_request", false, false},
+		{"existing provisioned", dynamodb.BillingModeProvisioned, true, true},
+		{"legacy provisioned", "", true, true},
+		{"new provisioned", "provisioned", false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{Entry: logrus.NewEntry(logrus.New()), Config: Config{EnableAutoScaling: true}}
+			b.disableOnDemandAutoScaling(tc.mode, tc.exists)
+			require.Equal(t, tc.wantEnabled, b.EnableAutoScaling)
+		})
+	}
+}
