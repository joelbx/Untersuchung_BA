diff --git a/internal/cmd/auth_test.go b/internal/cmd/auth_test.go
new file mode 100644
index 0000000..a95839e
--- /dev/null
+++ b/internal/cmd/auth_test.go
@@ -0,0 +1,31 @@
+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+func TestAuthenticationGRPCWithoutDatabase(t *testing.T) {
+	for _, storageType := range []config.StorageType{
+		config.LocalStorageType,
+		config.GitStorageType,
+		config.ObjectStorageType,
+	} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := &config.Config{Storage: config.StorageConfig{Type: storageType}}
+			register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zap.NewNop(), cfg, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(register) != 2 || len(interceptors) != 0 {
+				t.Fatalf("unexpected registration: %d services, %d interceptors", len(register), len(interceptors))
+			}
+			if err := shutdown(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
