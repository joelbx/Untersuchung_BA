+export interface AllowedEncryptionSetting {
+    allowChange: boolean;
+    forcedValue?: boolean;
+}
+
+/** Resolve encryption policy for a room preset without changing UI state. */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const serverForcesEncryption = await client.doesServerForceEncryptionForPreset(chatPreset);
+    const wellKnownForcesDisabled = shouldForceDisableEncryption(client);
+    if (serverForcesEncryption && wellKnownForcesDisabled) {
+        console.warn(
+            "Conflicting encryption policies: server requires encryption, well-known disables it; using server policy.",
+        );
+    }
+    if (serverForcesEncryption) return { allowChange: false, forcedValue: true };
+    if (wellKnownForcesDisabled) return { allowChange: false, forcedValue: false };
+    return { allowChange: true };
+}
