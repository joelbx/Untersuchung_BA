+func TestGetAmazonLinuxVersion(t *testing.T) {
+	tests := []struct {
+		release string
+		want    string
+	}{
+		{"1", "1"}, {"2 (Karoo)", "2"}, {"2022 (Amazon Linux)", "2022"},
+		{"2023", "2023"}, {"2023 (Amazon Linux)", "2023"},
+		{"2025", "2025"}, {"2027", "2027"}, {"2029", "2029"},
+		{"2018.03", "1"}, {"2023.03", "1"},
+		{"", "unknown"}, {"unknown", "unknown"}, {"2024", "unknown"},
+		{"20230", "unknown"}, {"2023.3", "unknown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.want {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAmazonLinuxEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		year    int
+	}{
+		{"2023 (Amazon Linux)", 2029},
+		{"2025", 2030},
+		{"2027", 2032},
+		{"2029", 2034},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL did not find release")
+			}
+			want := time.Date(tt.year, 6, 30, 23, 59, 59, 0, time.UTC)
+			if !eol.StandardSupportUntil.Equal(want) {
+				t.Errorf("StandardSupportUntil = %v, want %v", eol.StandardSupportUntil, want)
+			}
+			if eol.IsStandardSupportEnded(want) || eol.IsExtendedSupportEnded(want) {
+				t.Error("support ended on its last supported second")
+			}
+			after := want.Add(time.Second)
+			if !eol.IsStandardSupportEnded(after) || !eol.IsExtendedSupportEnded(after) {
+				t.Error("support did not end after its last supported second")
+			}
+		})
+	}
+	for _, release := range []string{"", "unknown", "2024", "2031"} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL(%q) unexpectedly found a release", release)
+		}
+	}
+}
+
+func TestEOLSupportPhases(t *testing.T) {
+	standardEnd := time.Date(2030, 6, 30, 23, 59, 59, 0, time.UTC)
+	extendedEnd := time.Date(2032, 6, 30, 23, 59, 59, 0, time.UTC)
+	eol := EOL{StandardSupportUntil: standardEnd, ExtendedSupportUntil: extendedEnd}
+	if eol.IsStandardSupportEnded(standardEnd) || eol.IsExtendedSupportEnded(standardEnd) {
+		t.Error("support ended on the standard support deadline")
+	}
+	if !eol.IsStandardSupportEnded(standardEnd.Add(time.Second)) || eol.IsExtendedSupportEnded(standardEnd.Add(time.Second)) {
+		t.Error("extended support status was incorrect after standard support ended")
+	}
+	if !eol.IsStandardSupportEnded(extendedEnd.Add(time.Second)) || !eol.IsExtendedSupportEnded(extendedEnd.Add(time.Second)) {
+		t.Error("support status was incorrect after extended support ended")
+	}
+}
