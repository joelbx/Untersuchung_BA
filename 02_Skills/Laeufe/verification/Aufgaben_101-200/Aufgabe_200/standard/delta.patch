+def parse_duration(duration: str) -> int:
+    """Return a duration in milliseconds.
+
+    Bare integers are milliseconds. Unit values may contain decimals and are
+    given in hours, minutes, seconds order, with optional whitespace between
+    components.
+    """
+    duration = duration.strip()
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    match = _DURATION_RE.fullmatch(duration)
+    if match is None or not any(match.groupdict().values()):
+        raise ValueError('Invalid duration: {!r}'.format(duration))
+
+    total = sum((Decimal(value) * multiplier
+                 for value, multiplier in zip(match.groups(),
+                                              (3600000, 60000, 1000))
+                 if value is not None), Decimal(0))
+    return int(total)
+
