--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -383,6 +383,83 @@ class TestQtArgs:
         assert combined_flag in args
         assert overlay_flag not in args
 
+    @pytest.mark.parametrize('enable_source, disable_source', [
+        ('commandline', 'commandline'),
+        ('commandline', 'config'),
+        ('config', 'commandline'),
+        ('config', 'config'),
+    ])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch,
+                                         parser, enable_source, disable_source):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+
+        enable = 'enable-features=First,Second'
+        disable = 'disable-features=Third,Fourth'
+        commandline = []
+        config_flags = []
+        for flag, source in [(enable, enable_source),
+                             (disable, disable_source)]:
+            if source == 'commandline':
+                commandline += ['--qt-flag', flag]
+            else:
+                config_flags.append(flag)
+        config_stub.val.qt.args = config_flags
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+
+        enabled = [arg for arg in args
+                   if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        disabled = [arg for arg in args
+                    if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)]
+        assert enabled == ['--enable-features=First,Second,OverlayScrollbar']
+        assert disabled == ['--disable-features=Third,Fourth']
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_without_enabled_features(
+            self, config_stub, monkeypatch, parser, via_commandline):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        flag = 'disable-features=First,Second'
+        config_stub.val.qt.args = [] if via_commandline else [flag]
+        commandline = ['--qt-flag', flag] if via_commandline else []
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+
+        assert '--' + flag in args
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+
+    def test_multiple_feature_flags(self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = [
+            'enable-features=Configured',
+            'disable-features=ConfiguredOff,AnotherOff',
+        ]
+
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CommandLine',
+            '--qt-flag', 'disable-features=CommandLineOff',
+        ])
+        args = qtargs.qt_args(parsed)
+
+        assert [arg for arg in args if arg.startswith(
+            qtargs.ENABLE_FEATURES_PREFIX)] == [
+                '--enable-features=CommandLine,Configured']
+        assert [arg for arg in args if arg.startswith(
+            qtargs.DISABLE_FEATURES_PREFIX)] == [
+                '--disable-features=CommandLineOff',
+                '--disable-features=ConfiguredOff,AnotherOff',
+            ]
+
