+// readTeleportProxyHeader consumes the internal SSH metadata header. The
+// limit prevents a peer from sending an unbounded payload without a terminator.
+func readTeleportProxyHeader(reader *bufio.Reader) (net.Addr, error) {
+	if _, err := reader.Discard(len(apisshutils.ProxyHelloSignature)); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	const maxPayloadSize = 64 * 1024
+	payload := make([]byte, 0, 256)
+	for len(payload) < maxPayloadSize {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport proxy header")
+		}
+		if b == 0 {
+			var header apisshutils.HandshakePayload
+			if err := json.Unmarshal(payload, &header); err != nil {
+				return nil, trace.Wrap(err, "invalid Teleport proxy header")
+			}
+			if header.ClientAddr == "" {
+				return nil, nil
+			}
+			host, portString, err := net.SplitHostPort(header.ClientAddr)
+			if err != nil {
+				return nil, trace.Wrap(err, "invalid Teleport proxy client address")
+			}
+			port, err := strconv.Atoi(portString)
+			if err != nil || port < 0 || port > 65535 || net.ParseIP(host) == nil {
+				return nil, trace.BadParameter("invalid Teleport proxy client address %q", header.ClientAddr)
+			}
+			return &net.TCPAddr{IP: net.ParseIP(host), Port: port}, nil
+		}
+		payload = append(payload, b)
+	}
+	return nil, trace.BadParameter("Teleport proxy header exceeds %d bytes", maxPayloadSize)
+}
