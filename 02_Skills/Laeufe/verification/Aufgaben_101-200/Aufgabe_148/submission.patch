@@ -51,6 +51,72 @@ import (
 	"github.com/stretchr/testify/require"
 )
 
+func TestTeleportProxySSHHeader(t *testing.T) {
+	tests := []struct {
+		name       string
+		header     string
+		remoteAddr string
+		wantError  bool
+	}{
+		{name: "standard SSH", header: "", remoteAddr: "pipe"},
+		{name: "client address", header: `Teleport-Proxy{"clientAddr":"192.0.2.10:1234"}` + "\x00", remoteAddr: "192.0.2.10:1234"},
+		{name: "IPv6 client address", header: `Teleport-Proxy{"clientAddr":"[2001:db8::1]:1234"}` + "\x00", remoteAddr: "[2001:db8::1]:1234"},
+		{name: "tracing only", header: `Teleport-Proxy{"tracingContext":{"traceparent":"test"}}` + "\x00", remoteAddr: "pipe"},
+		{name: "invalid JSON", header: "Teleport-Proxy{\x00", wantError: true},
+		{name: "invalid address", header: `Teleport-Proxy{"clientAddr":"bad"}` + "\x00", wantError: true},
+		{name: "missing terminator", header: `Teleport-Proxy{}`, wantError: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server, client := net.Pipe()
+			defer server.Close()
+			go func() {
+				defer client.Close()
+				client.Write([]byte(tt.header + "SSH-2.0-test\r\n"))
+			}()
+			conn, err := detect(server, false)
+			if tt.wantError {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			require.Equal(t, tt.remoteAddr, conn.RemoteAddr().String())
+			banner := make([]byte, len("SSH-2.0-test\r\n"))
+			_, err = io.ReadFull(conn, banner)
+			require.NoError(t, err)
+			require.Equal(t, "SSH-2.0-test\r\n", string(banner))
+		})
+	}
+}
+
+func TestMuxRoutesTeleportProxySSH(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener, Context: ctx})
+	require.NoError(t, err)
+	sshListener := mux.SSH()
+	go mux.Serve()
+	defer mux.Close()
+
+	client, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer client.Close()
+	_, err = client.Write([]byte("Teleport-Proxy{\"clientAddr\":\"192.0.2.10:1234\"}\x00SSH-2.0-test\r\n"))
+	require.NoError(t, err)
+
+	conn, err := sshListener.Accept()
+	require.NoError(t, err)
+	defer conn.Close()
+	require.Equal(t, "192.0.2.10:1234", conn.RemoteAddr().String())
+	banner := make([]byte, len("SSH-2.0-test\r\n"))
+	_, err = io.ReadFull(conn, banner)
+	require.NoError(t, err)
+	require.Equal(t, "SSH-2.0-test\r\n", string(banner))
+}
+
 func TestMain(m *testing.M) {
 	utils.InitLoggerForTests()
 	os.Exit(m.Run())
