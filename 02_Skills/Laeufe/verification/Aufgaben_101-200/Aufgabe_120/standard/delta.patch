+@contextmanager
+def _batch_lock(item, batch):
+    """Serialize staging and finalization of a batch across local processes."""
+    import fcntl
+    lockdir = os.path.join(config.data_root, 'items', '.locks')
+    os.makedirs(lockdir, exist_ok=True)
+    with open(os.path.join(lockdir, f'{item}_{batch}.lock'), 'w') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock, fcntl.LOCK_UN)
