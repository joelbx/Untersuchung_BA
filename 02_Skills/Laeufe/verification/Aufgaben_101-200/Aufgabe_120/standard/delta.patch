+class Batch:
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id, self.size = item_id, batch_id, size
+        self._norm_ids()
+        if size is not None:
+            _size(size)
+
+    def _norm_ids(self):
+        item, batch = int(self.item_id), int(self.batch_id)
+        if not 0 <= item <= 9999 or not 0 <= batch <= 99:
+            raise ValueError('item or batch ID out of range')
+        return f'{item:04d}', f'{batch:02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item, batch = cls(item_id, batch_id)._norm_ids()
+        prefix = _size(size)
+        return os.path.join('items', f'{prefix}covers_{item}',
+                            f'{prefix}covers_{item}_{batch}.{ext.lstrip(".")}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        """Upload existing zips and finalize only after every size is present on IA."""
+        sizes = SIZES if self.size is None else (self.size,)
+        uploader = uploader or Uploader()
+        item, batch = self._norm_ids()
+        with _batch_lock(item, batch):
+            paths = [self.get_abspath(item, batch, size) for size in sizes]
+            for size, path in zip(sizes, paths):
+                if not os.path.isfile(path):
+                    continue
+                name = os.path.basename(path)
+                item_name = f'{_size(size)}covers_{item}'
+                if upload and not uploader.is_uploaded(item_name, name) and not test:
+                    uploader.upload(item_name, [path])
+            if finalize:
+                # A partial batch cannot be marked uploaded. In particular a failed
+                # size must retain its local files for a later retry.
+                if not all(uploader.is_uploaded(
