 SSH_DEBUG = re.compile(r'^debug\d+: .*')
+_CLIXML_HEADER = re.compile(rb"(?:#<|<#) CLIXML\r\n|\r\nCLIXML\r\n")
+_CLIXML_OBJS_START = re.compile(rb"<Objs(?:\s|>)")
+
+
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML blocks in stderr while retaining other bytes."""
+    result = bytearray()
+    scan = 0
+    copied = 0
+
+    while header := _CLIXML_HEADER.search(stderr, scan):
+        xml_start = header.end()
+        # PowerShell can emit the header more than once before the XML.
+        while repeated_header := _CLIXML_HEADER.match(stderr, xml_start):
+            xml_start = repeated_header.end()
+
+        if not _CLIXML_OBJS_START.match(stderr, xml_start):
+            scan = header.end()
+            continue
+
+        xml_end = xml_start
+        incomplete = False
+        while _CLIXML_OBJS_START.match(stderr, xml_end):
+            close = stderr.find(b"</Objs>", xml_end)
+            next_header = _CLIXML_HEADER.search(stderr, xml_end)
+            if close == -1 or (next_header and next_header.start() < close):
+                incomplete = True
+                break
+            xml_end = close + len(b"</Objs>")
+
+        if incomplete:
+            scan = header.end()
+            continue
+
+        try:
+            xml_bytes = stderr[xml_start:xml_end]
+            try:
+                xml_text = xml_bytes.decode("utf-8")
+            except UnicodeDecodeError:
+                xml_text = xml_bytes.decode("cp437")
+            replacement = _parse_clixml(xml_text.encode("utf-8"))
+        except (ET.ParseError, UnicodeError, ValueError):
+            scan = header.end()
+            continue
+
+        result.extend(stderr[copied:header.start()])
+        result.extend(replacement)
+        copied = xml_end
+        scan = xml_end
+
+    if copied == 0:
+        return stderr
+    result.extend(stderr[copied:])
+    return bytes(result)
 
 
