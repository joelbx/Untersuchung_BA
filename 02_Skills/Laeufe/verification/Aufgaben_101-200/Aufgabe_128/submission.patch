+    def test_match_set_rule_with_and_without_explicit_match(self):
+        for matches in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'match': matches,
+                'match_set': 'admin_hosts',
+                'match_set_flags': 'src',
+                'destination_port': '22',
+                'jump': 'ACCEPT',
+                'comment': 'Allow admin SSH',
+                '_ansible_check_mode': True,
+            })
+            with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+                with self.assertRaises(AnsibleExitJson) as result:
+                    iptables.main()
