+func TestSSHServerHeartbeatPeerAddress(t *testing.T) {
+	const serverID = "test-server"
+	tests := []struct {
+		name, addr, peerAddr, want string
+	}{
+		{"IPv6 wildcard", "[::]:3022", "192.0.2.10:41111", "192.0.2.10:3022"},
+		{"IPv4 wildcard", "0.0.0.0:3022", "[2001:db8::1]:41111", "[2001:db8::1]:3022"},
+		{"loopback", "127.0.0.1:3022", "192.0.2.10:41111", "192.0.2.10:3022"},
+		{"routable", "198.51.100.5:3022", "192.0.2.10:41111", "198.51.100.5:3022"},
+		{"unknown peer", "[::]:3022", "", "[::]:3022"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
+			defer controller.Close()
+			upstream, _ := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peerAddr))
+			defer upstream.Close()
+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{
+				ServerID: serverID,
+				Services: []types.SystemRole{types.RoleNode},
+			})
+			server := &types.ServerV2{Metadata: types.Metadata{Name: serverID}}
+			server.SetAddr(tt.addr)
+			require.NoError(t, controller.handleSSHServerHB(handle, server))
+			require.Equal(t, 1, auth.upserts)
+			require.Equal(t, tt.want, auth.lastAddr)
+		})
+	}
+}
