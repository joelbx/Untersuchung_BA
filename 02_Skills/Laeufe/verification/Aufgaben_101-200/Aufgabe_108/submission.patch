diff --git a/utils/cache/simple_cache.go b/utils/cache/simple_cache.go
new file mode 100644
index 0000000..455527f
--- /dev/null
+++ b/utils/cache/simple_cache.go
@@ -0,0 +1,123 @@
+package cache
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// SimpleCache stores typed values under string keys.
+type SimpleCache[V any] interface {
+	Add(key string, value V) error
+	AddWithTTL(key string, value V, ttl time.Duration) error
+	Get(key string) (V, error)
+	GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error)
+	Keys() []string
+}
+
+type cacheEntry[V any] struct {
+	value     V
+	expiresAt time.Time
+	sequence  uint64
+}
+
+type simpleCache[V any] struct {
+	mu         sync.Mutex
+	entries    map[string]cacheEntry[V]
+	maxEntries int
+	nextSeq    uint64
+}
+
+// NewSimpleCache returns a cache whose entries do not expire unless added with a TTL.
+func NewSimpleCache[V any]() SimpleCache[V] {
+	return &simpleCache[V]{entries: make(map[string]cacheEntry[V])}
+}
+
+func newSimpleCacheWithLimit[V any](limit int) SimpleCache[V] {
+	return &simpleCache[V]{entries: make(map[string]cacheEntry[V]), maxEntries: limit}
+}
+
+func (c *simpleCache[V]) Add(key string, value V) error {
+	return c.set(key, value, time.Time{})
+}
+
+func (c *simpleCache[V]) AddWithTTL(key string, value V, ttl time.Duration) error {
+	return c.set(key, value, time.Now().Add(ttl))
+}
+
+func (c *simpleCache[V]) set(key string, value V, expiresAt time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if c.maxEntries > 0 && len(c.entries) >= c.maxEntries {
+		c.removeExpired(time.Now())
+		if _, exists := c.entries[key]; !exists && len(c.entries) >= c.maxEntries {
+			var oldestKey string
+			var oldestSeq uint64
+			found := false
+			for k, entry := range c.entries {
+				if !found || entry.sequence < oldestSeq {
+					oldestKey, oldestSeq = k, entry.sequence
+					found = true
+				}
+			}
+			delete(c.entries, oldestKey)
+		}
+	}
+	c.nextSeq++
+	c.entries[key] = cacheEntry[V]{value: value, expiresAt: expiresAt, sequence: c.nextSeq}
+	return nil
+}
+
+func (c *simpleCache[V]) Get(key string) (V, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	entry, ok := c.entries[key]
+	if ok && !expired(entry, time.Now()) {
+		return entry.value, nil
+	}
+	if ok {
+		delete(c.entries, key)
+	}
+	var zero V
+	return zero, fmt.Errorf("cache key %q not found", key)
+}
+
+func (c *simpleCache[V]) GetWithLoader(key string, loader func(string) (V, time.Duration, error)) (V, error) {
+	if value, err := c.Get(key); err == nil {
+		return value, nil
+	}
+	value, ttl, err := loader(key)
+	if err != nil {
+		var zero V
+		return zero, err
+	}
+	if err := c.AddWithTTL(key, value, ttl); err != nil {
+		var zero V
+		return zero, err
+	}
+	return value, nil
+}
+
+func (c *simpleCache[V]) Keys() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.removeExpired(time.Now())
+	keys := make([]string, 0, len(c.entries))
+	for key := range c.entries {
+		keys = append(keys, key)
+	}
+	return keys
+}
+
+func (c *simpleCache[V]) removeExpired(now time.Time) {
+	for key, entry := range c.entries {
+		if expired(entry, now) {
+			delete(c.entries, key)
+		}
+	}
+}
+
+func expired[V any](entry cacheEntry[V], now time.Time) bool {
+	return !entry.expiresAt.IsZero() && !now.Before(entry.expiresAt)
+}
diff --git a/utils/cache/simple_cache_test.go b/utils/cache/simple_cache_test.go
new file mode 100644
index 0000000..9d4bb5f
--- /dev/null
+++ b/utils/cache/simple_cache_test.go
@@ -0,0 +1,79 @@
+package cache
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestSimpleCacheValuesAndExpiry(t *testing.T) {
+	c := NewSimpleCache[int]()
+	if err := c.Add("persistent", 42); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.AddWithTTL("short", 7, 40*time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := c.Get("persistent"); err != nil || got != 42 {
+		t.Fatalf("persistent: got %d, %v", got, err)
+	}
+	if got, err := c.Get("short"); err != nil || got != 7 {
+		t.Fatalf("short before expiry: got %d, %v", got, err)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if got, err := c.Get("short"); err == nil || got != 0 {
+		t.Fatalf("short after expiry: got %d, %v", got, err)
+	}
+	if got, err := c.Get("missing"); err == nil || got != 0 {
+		t.Fatalf("missing: got %d, %v", got, err)
+	}
+	keys := c.Keys()
+	if len(keys) != 1 || keys[0] != "persistent" {
+		t.Fatalf("active keys: %v", keys)
+	}
+}
+
+func TestSimpleCacheLoader(t *testing.T) {
+	c := NewSimpleCache[string]()
+	loads := 0
+	loader := func(key string) (string, time.Duration, error) {
+		loads++
+		return key + "-value", 40 * time.Millisecond, nil
+	}
+	for i := 0; i < 2; i++ {
+		if got, err := c.GetWithLoader("a", loader); err != nil || got != "a-value" {
+			t.Fatalf("load %d: got %q, %v", i, got, err)
+		}
+	}
+	if loads != 1 {
+		t.Fatalf("loader called %d times for a cached key", loads)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if got, err := c.GetWithLoader("a", loader); err != nil || got != "a-value" || loads != 2 {
+		t.Fatalf("reload: got %q, %v; loads=%d", got, err, loads)
+	}
+
+	want := errors.New("load failed")
+	_, err := c.GetWithLoader("bad", func(string) (string, time.Duration, error) {
+		return "unused", time.Hour, want
+	})
+	if err != want {
+		t.Fatalf("loader error: got %v, want %v", err, want)
+	}
+	if got, err := c.Get("bad"); err == nil || got != "" {
+		t.Fatalf("failed load was cached: got %q, %v", got, err)
+	}
+}
+
+func TestSimpleCacheLimit(t *testing.T) {
+	c := newSimpleCacheWithLimit[int](2)
+	_ = c.Add("first", 1)
+	_ = c.Add("second", 2)
+	_ = c.Add("third", 3)
+	if _, err := c.Get("first"); err == nil {
+		t.Fatal("oldest entry was not evicted")
+	}
+	if len(c.Keys()) != 2 {
+		t.Fatalf("expected two entries, got %v", c.Keys())
+	}
+}
