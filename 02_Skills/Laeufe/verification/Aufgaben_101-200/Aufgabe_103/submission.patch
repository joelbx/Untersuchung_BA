+func TestEmptyReleaseInInstalledPackages(t *testing.T) {
+	r := newCentOS(config.ServerInfo{})
+	r.Distro = config.Distro{Family: constant.CentOS, Release: "7"}
+	bins, srcs, err := r.parseInstalledPackages("package 0 0.1  x86_64 package-0.1-.src.rpm\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := bins["package"]; got.Version != "0.1" || got.Release != "" || got.Arch != "x86_64" {
+		t.Errorf("binary package: %+v", got)
+	}
+	if got := srcs["package"]; got.Version != "0.1" || got.Arch != "src" {
+		t.Errorf("source package: %+v", got)
+	}
+}
+
