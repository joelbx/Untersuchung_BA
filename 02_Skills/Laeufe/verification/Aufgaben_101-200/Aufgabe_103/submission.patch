+// The rpm query format uses one space between fields. Preserve the empty
+// release represented by two consecutive spaces after the version.
+func packageLineFields(line string) []string {
+	fields := strings.Fields(line)
+	if len(fields) >= 3 && strings.Contains(line, fields[2]+"  ") {
+		// Only the separator immediately after VERSION can denote an empty RELEASE.
+		prefix := fields[0] + " " + fields[1] + " " + fields[2] + "  "
+		if strings.HasPrefix(line, prefix) {
+			fields = append(fields[:3], append([]string{""}, fields[3:]...)...)
+		}
+	}
+	return fields
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if release != "" {
+		version += "-" + release
+	}
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	return version
+}
