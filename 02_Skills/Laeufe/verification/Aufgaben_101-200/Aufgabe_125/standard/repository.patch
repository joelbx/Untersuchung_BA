 module.exports = function (Topics) {
+	Topics.syncBacklinks = async function (postData) {
+		if (!postData || !Number.isInteger(Number(postData.pid)) || Number(postData.pid) <= 0 ||
+			!Number.isInteger(Number(postData.tid)) || Number(postData.tid) <= 0 ||
+			!Number.isInteger(Number(postData.uid)) || Number(postData.uid) < 0 ||
+			typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const key = `pid:${postData.pid}:backlinks`;
+		const oldTids = await db.getSortedSetRange(key, 0, -1);
+		const baseUrl = String(nconf.get('url') || '').replace(/\/$/, '');
+		const escapedUrl = baseUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+		const pattern = new RegExp(`(?:${escapedUrl}|(^|[\\s(<\\["'=]))/topic/([0-9]+)(?=/|[^0-9]|$)`, 'g');
+		const referenced = new Set();
+		let match;
+		while (true) {
+			match = pattern.exec(postData.content);
+			if (!match) {
+				break;
+			}
+			const tid = match[2];
+			if (Number(tid) > 0 && Number(tid) !== Number(postData.tid)) {
+				referenced.add(String(Number(tid)));
+			}
+		}
+
+		const existing = await Promise.all([...referenced].map(tid => Topics.exists(tid)));
+		const currentTids = [...referenced].filter((tid, index) => existing[index]);
+		const removed = oldTids.filter(tid => !currentTids.includes(String(tid)));
+		const added = currentTids.filter(tid => !oldTids.includes(tid));
+
+		for (const tid of removed) {
+			/* eslint-disable no-await-in-loop */
+			const eventIds = await db.getSortedSetRange(`topic:${tid}:events`, 0, -1);
+			const events = await db.getObjects(eventIds.map(id => `topicEvent:${id}`));
+			const matchingIds = eventIds.filter((id, index) => events[index] &&
+				events[index].type === 'backlink' && events[index].href === `/post/${postData.pid}`);
+			if (matchingIds.length) {
+				await Topics.events.purge(tid, matchingIds);
+			}
+			await db.sortedSetRemove(key, tid);
+		}
+		for (const tid of added) {
+			/* eslint-disable no-await-in-loop */
+			await Topics.events.log(tid, {
+				type: 'backlink',
+				href: `/post/${postData.pid}`,
+				uid: postData.uid,
+			});
+			await db.sortedSetAdd(key, Date.now(), tid);
+		}
+		return added.length + removed.length;
+	};
+
 	Topics.onNewPostMade = async function (postData) {
 		await Topics.updateLastPostTime(postData.tid, postData.timestamp);
 		await Topics.addPostToTopic(postData.tid, postData);
