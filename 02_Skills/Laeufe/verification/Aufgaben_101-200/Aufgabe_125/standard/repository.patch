+			});
+			assert.strictEqual(changed, 0);
+			assert.strictEqual(await topics.syncBacklinks({ ...post, content: 'No links here' }), 1);
+			assert.deepStrictEqual(await db.getSortedSetRange(`pid:${post.pid}:backlinks`, 0, -1), []);
+			assert(!(await topics.events.get(target.topicData.tid)).some(event => event.href === `/post/${post.pid}`));
+			assert.strictEqual(await topics.syncBacklinks({ ...post, content: `/topic/${target.topicData.tid}` }), 1);
+		});
+
+		it('rejects missing post data', async () => {
+			await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+		});
+
+		it('updates backlinks when a post is edited', async () => {
+			const { pid } = source.postData;
+			await posts.edit({ pid, uid: fooUid, content: 'Removed topic link' });
+			assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), []);
+			await posts.edit({ pid, uid: fooUid, content: `See /topic/${target.topicData.tid}` });
+			assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), [String(target.topicData.tid)]);
+		});
+	});
