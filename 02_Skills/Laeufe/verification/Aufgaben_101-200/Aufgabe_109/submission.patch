+import React from "react";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { PendingEventOrdering } from "matrix-js-sdk/src/client";
+import { Room } from "matrix-js-sdk/src/models/room";
+
+import RoomSummaryCard from "../../../../src/components/views/right_panel/RoomSummaryCard";
+import { PollHistoryDialog } from "../../../../src/components/views/dialogs/polls/PollHistoryDialog";
+import MatrixClientContext from "../../../../src/contexts/MatrixClientContext";
+import { MatrixClientPeg } from "../../../../src/MatrixClientPeg";
+import SettingsStore from "../../../../src/settings/SettingsStore";
+import Modal from "../../../../src/Modal";
+import { stubClient } from "../../../test-utils";
+
+jest.mock("../../../../src/components/views/avatars/RoomAvatar", () => () => <div />);
+
+describe("RoomSummaryCard poll history", () => {
+    const roomId = "!polls:example.org";
+
+    const renderCard = (enabled: boolean): void => {
+        stubClient();
+        const client = MatrixClientPeg.get();
+        const room = new Room(roomId, client, client.getUserId() ?? "", {
+            pendingEventOrdering: PendingEventOrdering.Detached,
+        });
+        jest.spyOn(SettingsStore, "getValue").mockImplementation((name: string) =>
+            name === "feature_poll_history" ? enabled : false,
+        );
+        render(
+            <MatrixClientContext.Provider value={client}>
+                <RoomSummaryCard room={room} onClose={jest.fn()} />
+            </MatrixClientContext.Provider>,
+        );
+    };
+
+    afterEach(() => jest.restoreAllMocks());
+
+    it("hides the entry when the lab is disabled", () => {
+        renderCard(false);
+        expect(screen.queryByText("Polls history")).toBeNull();
+    });
+
+    it("opens the poll history dialog for this room when enabled", () => {
+        const createDialog = jest.spyOn(Modal, "createDialog").mockImplementation(jest.fn());
+        renderCard(true);
+        fireEvent.click(screen.getByText("Polls history"));
+        expect(createDialog).toHaveBeenCalledWith(PollHistoryDialog, { roomId });
+    });
+});
