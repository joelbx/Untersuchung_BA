@@ -410,6 +412,34 @@ class LinuxHardware(Hardware):
 
         return dmi_facts
 
+    def get_sysinfo_facts(self):
+        """Read the system identity exposed by IBM Z in /proc/sysinfo."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer': 'system_vendor',
+            'Type': 'product_name',
+            'Sequence Code': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            key, separator, value = line.partition(':')
+            fact = fields.get(key)
+            if separator and fact:
+                value = value.strip()
+                if fact == 'product_serial':
+                    value = value.lstrip('0')
+                sysinfo_facts[fact] = value
+
+        return sysinfo_facts
+
