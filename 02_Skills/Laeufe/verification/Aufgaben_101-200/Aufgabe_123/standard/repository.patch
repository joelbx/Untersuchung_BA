index 0000000..26d2890
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,73 @@
+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import createNotificationManager from './manager';
+import NotificationsContainer from './Container';
+import { NotificationOptions } from './interfaces';
+
+describe('notifications', () => {
+    it('renders safe HTML and secures every link while preserving React elements', () => {
+        const notifications: NotificationOptions[] = [
+            {
+                id: 1,
+                key: 1,
+                type: 'error',
+                text: '<strong>Help</strong> <a href="https://example.com" target="_self" rel="opener">guide</a> <a href="javascript:alert(1)">unsafe</a><script>alert(1)</script>',
+                isClosing: false,
+            },
+            { id: 2, key: 2, type: 'info', text: <span data-testid="element">React content</span>, isClosing: false },
+        ];
+        const { container } = render(
+            <NotificationsContainer notifications={notifications} hideNotification={jest.fn()} removeNotification={jest.fn()} />
+        );
+
+        expect(screen.getByText('Help').tagName).toBe('STRONG');
+        expect(screen.getByTestId('element')).toHaveTextContent('React content');
+        const links = container.querySelectorAll('a');
+        expect(links).toHaveLength(2);
+        links.forEach((link) => {
+            expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+            expect(link).toHaveAttribute('target', '_blank');
+        });
+        expect(links[0]).toHaveAttribute('href', 'https://example.com');
+        expect(links[1]).not.toHaveAttribute('href');
+        expect(container.querySelector('script')).toBeNull();
+    });
+
+    it('deduplicates non-success messages by their explicit or fallback key', () => {
+        jest.useFakeTimers();
+        let notifications: NotificationOptions[] = [];
+        const setNotifications = (update: React.SetStateAction<NotificationOptions[]>) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        };
+        const manager = createNotificationManager(setNotifications);
+
+        manager.createNotification({ text: 'same', type: 'error' });
+        manager.createNotification({ text: 'same', type: 'info' });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('same');
+        expect(notifications[0].type).toBe('info');
+
+        manager.createNotification({ text: 'different', key: 'same', type: 'error' });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].text).toBe('different');
+
+        manager.createNotification({ text: <span>one</span>, type: 'error' });
+        manager.createNotification({ text: <span>two</span>, type: 'error' });
+        expect(notifications).toHaveLength(3);
+        expect(notifications[1].key).toBe(notifications[1].id);
+        expect(notifications[2].key).toBe(notifications[2].id);
+
+        manager.createNotification({ text: <span>three</span>, key: 'element', type: 'error' });
+        manager.createNotification({ text: <span>four</span>, key: 'element', type: 'warning' });
+        expect(notifications).toHaveLength(4);
+        expect(notifications[3].text).toEqual(<span>four</span>);
+
+        manager.createNotification({ text: 'same', type: 'success' });
+        manager.createNotification({ text: 'same', type: 'success' });
+        expect(notifications).toHaveLength(6);
+        expect(notifications.slice(-2).map(({ key }) => key)).toEqual(['same', 'same']);
+
+        manager.clearNotifications();
+        jest.useRealTimers();
+    });
+});
