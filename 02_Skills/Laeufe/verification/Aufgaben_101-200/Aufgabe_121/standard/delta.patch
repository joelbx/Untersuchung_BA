+func TestEngine_AuthMethodBuiltin(t *testing.T) {
+	ctx := context.Background()
+	engine, err := newEngine(ctx, zaptest.NewLogger(t), withPolicySource(policySource(`package flipt.authz.v1
+import rego.v1
+default allow := false
+allow if { flipt.is_auth_method(input, "k8s") }`)))
+	require.NoError(t, err)
+
+	allowed, err := engine.IsAllowed(ctx, map[string]interface{}{
+		"authentication": map[string]interface{}{"method": 3},
+	})
+	require.NoError(t, err)
+	require.True(t, allowed)
+
+	allowed, err = engine.IsAllowed(ctx, map[string]interface{}{
+		"authentication": &auth.Authentication{Method: auth.Method_METHOD_KUBERNETES},
+	})
+	require.NoError(t, err)
+	require.True(t, allowed)
+
+	allowed, err = engine.IsAllowed(ctx, map[string]interface{}{
+		"authentication": map[string]interface{}{"method": 1},
+	})
+	require.NoError(t, err)
+	require.False(t, allowed)
+}
+
 type policySource string
 
