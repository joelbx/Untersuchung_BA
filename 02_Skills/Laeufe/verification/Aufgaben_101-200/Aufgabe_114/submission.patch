+// Dirs returns the unique directories containing this album's media files.
+func (a Album) Dirs() []string {
+	if a.MediaFileDirs == "" {
+		return nil
+	}
+	dirs := filepath.SplitList(a.MediaFileDirs)
+	slices.Sort(dirs)
+	return slices.Compact(dirs)
+}
+
+// SetDirs stores the directories containing this album's media files.
+func (a *Album) SetDirs(dirs []string) {
+	dirs = append([]string(nil), dirs...)
+	slices.Sort(dirs)
+	a.MediaFileDirs = strings.Join(slices.Compact(dirs), string(filepath.ListSeparator))
+}
