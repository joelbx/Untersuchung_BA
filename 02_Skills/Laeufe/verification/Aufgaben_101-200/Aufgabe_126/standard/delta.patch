+++ b/applications/mail/src/app/helpers/assistant/markdown.test.ts
@@ -0,0 +1,53 @@
+import { simplifyHTML } from './html';
+import { prepareContentToModel } from './input';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+
+describe('assistant Markdown conversion', () => {
+    it('restores formatted content only for its message through the full pipeline', () => {
+        const source =
+            '<a href="https://example.com" class="link" style="color: red">Text</a><img src="https://example.com/a.png" class="photo" style="width: 10px">';
+        const markdown = prepareContentToModel(source, 'uid', 'message-a');
+        const own = document.implementation.createHTMLDocument();
+        own.body.innerHTML = parseModelResult(markdown, 'message-a');
+        expect(own.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+        expect(own.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(own.querySelector('img')?.getAttribute('src')).toBe('https://example.com/a.png');
+        expect(own.querySelector('img')?.getAttribute('style')).toBe('width: 10px');
+
+        const foreign = document.implementation.createHTMLDocument();
+        foreign.body.innerHTML = parseModelResult(markdown, 'message-b');
+        expect(foreign.querySelector('a, img')).toBeNull();
+        expect(foreign.body.textContent).toContain('Text');
+    });
+    it('nests stray lists inside a list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+        fixNestedLists(dom);
+        expect(dom.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+        expect(dom.querySelector('ul > ul')).toBeNull();
+    });
+
+    it('keeps ordered and nested list structure through Markdown', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First<ul><li>Child</li></ul></li><li>Second</li></ol>';
+        const markdown = htmlToMarkdown(dom);
+        const converted = document.implementation.createHTMLDocument();
+        converted.body.innerHTML = markdownToHTML(markdown);
+        expect(converted.querySelector('ol > li > ul > li')?.textContent).toBe('Child');
+        expect(converted.querySelectorAll('ol > li')).toHaveLength(2);
+    });
+
+    it('keeps link and image visual attributes', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<a href="#1" class="link" style="color: red">Text</a><img src="#2" class="image" style="width: 10px">';
+        simplifyHTML(dom);
+        const converted = document.implementation.createHTMLDocument();
+        converted.body.innerHTML = markdownToHTML(htmlToMarkdown(dom));
+        expect(converted.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(converted.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(converted.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(converted.querySelector('img')?.getAttribute('style')).toBe('width: 10px');
+    });
+});
