 _BLINK_SETTINGS = '--blink-settings='
 
 
+def _get_locale_pak_path(locales_dir: str, locale: str) -> str:
+    """Return the Chromium locale resource path for a locale."""
+    return os.path.join(locales_dir, locale.replace('_', '-') + '.pak')
+
+
+def _get_lang_override(versions: version.WebEngineVersions, locale: str,
+                       locales_dir: str) -> Optional[str]:
+    """Choose a resource-backed Chromium language for the 5.15.3 workaround."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    locale = locale.replace('_', '-')
+    if os.path.isfile(_get_locale_pak_path(locales_dir, locale)):
+        return None
+
+    language = locale.split('-')[0]
+    if language == 'en':
+        if locale in ('en', 'en-LR', 'en-PH'):
+            mapped = 'en-US'
+        else:
+            mapped = 'en-GB'
+    elif language == 'es':
+        mapped = 'es' if locale == 'es-ES' else 'es-419'
+    elif language == 'pt':
+        mapped = 'pt-PT' if locale == 'pt-PT' else 'pt-BR'
+    elif language == 'zh':
+        mapped = 'zh-TW' if locale in ('zh-TW', 'zh-HK', 'zh-MO') else 'zh-CN'
+    else:
+        mapped = language
+
+    for fallback in (mapped, language):
+        if os.path.isfile(_get_locale_pak_path(locales_dir, fallback)):
+            return fallback
+    return 'en-US'
+
+
