diff --git a/test/socket-posts-upvoters.js b/test/socket-posts-upvoters.js
new file mode 100644
index 0000000..e26f5f9
--- /dev/null
+++ b/test/socket-posts-upvoters.js
@@ -0,0 +1,72 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+describe('SocketPosts.getUpvoters access and display data', () => {
+	function createSocketPosts({ cids, votes, readableCids, admin = false }) {
+		const calls = { voteReads: 0, usernameLookups: [] };
+		const posts = {
+			getCidsByPids: async () => cids,
+			getUpvotedUidsByPids: async () => {
+				calls.voteReads += 1;
+				return votes;
+			},
+		};
+		const user = {
+			isAdministrator: async () => admin,
+			getUsernamesByUids: async (uids) => {
+				calls.usernameLookups.push(Array.from(uids));
+				return uids.map(uid => `user${uid}`);
+			},
+		};
+		const privileges = {
+			categories: {
+				filterCids: async (privilege, requestedCids) => {
+					assert.strictEqual(privilege, 'topics:read');
+					return [...new Set(requestedCids)].filter(cid => readableCids.includes(cid));
+				},
+			},
+		};
+		const stubs = { '../../database': {}, '../../user': user, '../../posts': posts, '../../privileges': privileges, '../../meta': {} };
+		const filename = path.join(__dirname, '../src/socket.io/posts/votes.js');
+		const source = fs.readFileSync(filename, 'utf8');
+		const module = { exports: {} };
+		vm.runInNewContext(source, { module, require: name => stubs[name] }, { filename });
+		const socketPosts = {};
+		module.exports(socketPosts);
+		return { socketPosts, calls };
+	}
+
+	it('rejects when any post category is unreadable before reading votes', async () => {
+		const { socketPosts, calls } = createSocketPosts({
+			cids: [10, 20, 10], readableCids: [10], votes: [[1], [2], [3]],
+		});
+		await assert.rejects(socketPosts.getUpvoters({ uid: 0 }, [1, 2, 3]), err => err.message === '[[error:no-privileges]]');
+		assert.strictEqual(calls.voteReads, 0);
+		assert.strictEqual(calls.usernameLookups.length, 0);
+	});
+
+	it('allows admins to read restricted categories', async () => {
+		const { socketPosts } = createSocketPosts({ cids: [10], readableCids: [], votes: [[3]], admin: true });
+		const result = await socketPosts.getUpvoters({ uid: 1 }, [1]);
+		assert.strictEqual(result[0].cutoff, 6);
+		assert.strictEqual(JSON.stringify(result[0].usernames), JSON.stringify(['user3']));
+	});
+
+	it('looks up each displayed UID once and preserves each post order at the cutoff', async () => {
+		const { socketPosts, calls } = createSocketPosts({
+			cids: [10, 20],
+			readableCids: [10, 20],
+			votes: [[3, 2, 1, 4, 5, 6], [5, 3, 7, 8, 9, 10, 11]],
+		});
+		const result = await socketPosts.getUpvoters({ uid: 2 }, [1, 2]);
+		assert.strictEqual(JSON.stringify(calls.usernameLookups), JSON.stringify([[3, 2, 1, 4, 5, 7, 8, 9]]));
+		assert.strictEqual(JSON.stringify(result), JSON.stringify([
+			{ cutoff: 6, otherCount: 1, usernames: ['user3', 'user2', 'user1', 'user4', 'user5'] },
+			{ cutoff: 6, otherCount: 2, usernames: ['user5', 'user3', 'user7', 'user8', 'user9'] },
+		]));
+	});
+});
