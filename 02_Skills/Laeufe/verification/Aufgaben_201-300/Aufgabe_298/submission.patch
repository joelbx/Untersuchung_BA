 	"time"
 
 	"github.com/jellydator/ttlcache/v3"
@@ -13,6 +14,7 @@ type SimpleCache[K comparable, V any] interface {
 	Get(key K) (V, error)
 	GetWithLoader(key K, loader func(key K) (V, time.Duration, error)) (V, error)
 	Keys() []K
+	Values() []V
 }
 
 type Options struct {
@@ -41,7 +43,25 @@ func NewSimpleCache[K comparable, V any](options ...Options) SimpleCache[K, V] {
 }
 
 type simpleCache[K comparable, V any] struct {
-	data *ttlcache.Cache[K, V]
+	data             *ttlcache.Cache[K, V]
+	evictionDeadline atomic.Pointer[time.Time]
+}
+
+// evictExpired limits full expiration scans while allowing short-lived items
+// to be removed during normal cache use.
+func (c *simpleCache[K, V]) evictExpired() {
+	now := time.Now()
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && now.Before(*deadline) {
+			return
+		}
+		next := now.Add(10 * time.Millisecond)
+		if c.evictionDeadline.CompareAndSwap(deadline, &next) {
+			c.data.DeleteExpired()
+			return
+		}
+	}
 }
 
 func (c *simpleCache[K, V]) Add(key K, value V) error {
@@ -49,6 +69,7 @@ func (c *simpleCache[K, V]) Add(key K, value V) error {
 }
 
 func (c *simpleCache[K, V]) AddWithTTL(key K, value V, ttl time.Duration) error {
+	c.evictExpired()
 	item := c.data.Set(key, value, ttl)
 	if item == nil {
 		return errors.New("failed to add item")
@@ -57,6 +78,7 @@ func (c *simpleCache[K, V]) AddWithTTL(key K, value V, ttl time.Duration) error
 }
 
 func (c *simpleCache[K, V]) Get(key K) (V, error) {
+	c.evictExpired()
 	item := c.data.Get(key)
 	if item == nil {
 		var zero V
@@ -66,12 +88,14 @@ func (c *simpleCache[K, V]) Get(key K) (V, error) {
 }
 
 func (c *simpleCache[K, V]) GetWithLoader(key K, loader func(key K) (V, time.Duration, error)) (V, error) {
+	c.evictExpired()
 	loaderWrapper := ttlcache.LoaderFunc[K, V](
 		func(t *ttlcache.Cache[K, V], key K) *ttlcache.Item[K, V] {
 			value, ttl, err := loader(key)
 			if err != nil {
 				return nil
 			}
+			c.evictExpired()
 			return t.Set(key, value, ttl)
 		},
 	)
@@ -84,5 +108,25 @@ func (c *simpleCache[K, V]) GetWithLoader(key K, loader func(key K) (V, time.Dur
 }
 
 func (c *simpleCache[K, V]) Keys() []K {
-	return c.data.Keys()
+	c.evictExpired()
+	allKeys := c.data.Keys()
+	keys := make([]K, 0, len(allKeys))
+	for _, key := range allKeys {
+		if c.data.Get(key) != nil {
+			keys = append(keys, key)
+		}
+	}
+	return keys
+}
+
+func (c *simpleCache[K, V]) Values() []V {
+	c.evictExpired()
+	keys := c.data.Keys()
+	values := make([]V, 0, len(keys))
+	for _, key := range keys {
+		if item := c.data.Get(key); item != nil {
+			values = append(values, item.Value())
+		}
+	}
+	return values
 }
