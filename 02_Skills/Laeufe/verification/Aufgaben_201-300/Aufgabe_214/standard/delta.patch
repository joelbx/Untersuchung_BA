+++ b/scanner/portscan_test.go
@@ -0,0 +1,36 @@
+package scanner
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	dir := t.TempDir()
+	bin := dir + "/scanner"
+	args := dir + "/args"
+	script := "#!/bin/sh\nprintf '%s\\n' \"$@\" > " + args + "\ncat <<'XML'\n<nmaprun><host><address addr=\"192.0.2.4\"/><ports><port protocol=\"tcp\" portid=\"443\"><state state=\"open\"/></port><port protocol=\"tcp\" portid=\"22\"><state state=\"closed\"/></port></ports></host></nmaprun>\nXML\n"
+	if err := os.WriteFile(bin, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.4": {"22", "443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0] != "192.0.2.4:443" {
+		t.Fatalf("ports: %v", got)
+	}
+	written, err := os.ReadFile(args)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, option := range []string{"-sT", "-Pn", "--open", "-oX", "-p", "22,443", "192.0.2.4"} {
+		if !strings.Contains(string(written), option) {
+			t.Errorf("missing option %q in %s", option, written)
+		}
+	}
+}
