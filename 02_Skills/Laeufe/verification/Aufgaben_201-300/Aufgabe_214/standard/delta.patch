diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..8b0e3f5
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,147 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan type.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+var scanTechniqueCodes = map[ScanTechnique]string{
+	TCPSYN: "sS", TCPConnect: "sT", TCPACK: "sA", TCPWindow: "sW",
+	TCPMaimon: "sM", TCPNull: "sN", TCPFIN: "sF", TCPXmas: "sX",
+}
+
+func (t ScanTechnique) String() string { return scanTechniqueCodes[t] }
+
+// PortScanConf configures nmap on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	allUnsupported := len(c.ScanTechniques) > 0
+	for _, raw := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for technique, code := range scanTechniqueCodes {
+			if strings.EqualFold(raw, code) {
+				found = technique
+				break
+			}
+		}
+		if found != NotSupportTechnique {
+			allUnsupported = false
+		}
+		scanTechniques = append(scanTechniques, found)
+	}
+	if allUnsupported {
+		return []ScanTechnique{NotSupportTechnique}
+	}
+	return
+}
+
+// Validate checks the locally installed scanner and its scan options.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath %q: %w", c.ScannerBinPath, err))
+	} else if !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath %q is not executable", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple portscan scanTechniques are not supported"))
+	}
+	for i, raw := range c.ScanTechniques {
+		technique := (&PortScanConf{ScanTechniques: []string{raw}}).GetScanTechniques()[0]
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported portscan scanTechnique %q", c.ScanTechniques[i]))
+		}
+		if technique != NotSupportTechnique && technique != TCPConnect && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan technique %s requires hasPrivileged", technique))
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort %q must be an integer in [0,65535]", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort 0 is not a usable source port"))
+		}
+		if len(techniques) == 0 && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan sourcePort cannot be used with TCPConnect"))
+		}
+		for _, technique := range techniques {
+			if technique == TCPConnect {
+				errs = append(errs, fmt.Errorf("portscan sourcePort cannot be used with TCPConnect"))
+				break
+			}
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan capability check failed: %w: %s", err, strings.TrimSpace(string(output))))
+		} else {
+			caps := strings.TrimSpace(string(output))
+			if caps == "" {
+				errs = append(errs, fmt.Errorf("portscan scannerBinPath has no capability data"))
+			} else if !hasNmapCapabilities(caps) {
+				errs = append(errs, fmt.Errorf("portscan scannerBinPath has missing or malformed capability data: %s", caps))
+			}
+		}
+	}
+	return
+}
+
+// getcap prints a path followed by a comma-separated capability set and flags.
+func hasNmapCapabilities(output string) bool {
+	fields := strings.Fields(output)
+	if len(fields) < 2 {
+		return false
+	}
+	spec := fields[len(fields)-1]
+	separator := strings.LastIndexAny(spec, "+=")
+	if separator < 0 || !strings.Contains(spec[separator+1:], "e") {
+		return false
+	}
+	names := strings.Split(spec[:separator], ",")
+	raw, admin := false, false
+	for _, name := range names {
+		switch name {
+		case "cap_net_raw":
+			raw = true
+		case "cap_net_admin":
+			admin = true
+		}
+	}
+	return raw && admin
+}
