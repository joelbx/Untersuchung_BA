diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..07a1017
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,117 @@
+package scanner
+
+import (
+	"bytes"
+	"encoding/xml"
+	"fmt"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+type nmapRun struct {
+	Hosts []struct {
+		Addresses []struct {
+			Addr string `xml:"addr,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+// setScanTechniques converts configured scan types to nmap flags.
+func setScanTechniques(c *config.PortScanConf) ([]string, error) {
+	options := []string{}
+	if c == nil {
+		return options, nil
+	}
+	for i, technique := range c.GetScanTechniques() {
+		if technique == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported portscan scanTechnique %q", c.ScanTechniques[i])
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	c := l.ServerInfo.PortScan
+	if c == nil {
+		return nil, fmt.Errorf("external port scanner is not configured")
+	}
+	if errs := c.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	options, err := setScanTechniques(c)
+	if err != nil {
+		return nil, err
+	}
+	// nmap defaults to SYN as root and Connect as an unprivileged user.
+	if len(options) == 0 && !c.HasPrivileged {
+		options = append(options, "-sT")
+	}
+	if c.SourcePort != "" {
+		options = append(options, "-g", c.SourcePort)
+	}
+	options = append(options, "-Pn", "--open", "-oX", "-")
+	results := []string{}
+	ips := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := append([]string{}, scanDestIPPorts[ip]...)
+		if len(ports) == 0 {
+			continue
+		}
+		sort.Strings(ports)
+		args := append(append([]string{}, options...), "-p", strings.Join(ports, ","), ip)
+		cmd := osexec.Command(c.ScannerBinPath, args...)
+		var stderr bytes.Buffer
+		cmd.Stderr = &stderr
+		output, err := cmd.Output()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed: %w: %s", ip, err, strings.TrimSpace(stderr.String()))
+		}
+		var run nmapRun
+		if err := xml.NewDecoder(bytes.NewReader(output)).Decode(&run); err != nil {
+			return nil, fmt.Errorf("invalid nmap XML for %s: %w", ip, err)
+		}
+		requested := map[string]bool{}
+		for _, port := range ports {
+			requested[port] = true
+		}
+		for _, host := range run.Hosts {
+			hostMatches := false
+			for _, address := range host.Addresses {
+				if address.Addr == ip {
+					hostMatches = true
+					break
+				}
+			}
+			if !hostMatches {
+				continue
+			}
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.State == "open" && requested[port.PortID] {
+					results = append(results, net.JoinHostPort(ip, port.PortID))
+				}
+			}
+		}
+	}
+	return results, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..364f1ba
