+package config
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	cases := map[string]ScanTechnique{"sS": TCPSYN, "sT": TCPConnect, "sA": TCPACK, "sW": TCPWindow, "sM": TCPMaimon, "sN": TCPNull, "sF": TCPFIN, "sX": TCPXmas}
+	for code, want := range cases {
+		if got := (&PortScanConf{ScanTechniques: []string{strings.ToUpper(code)}}).GetScanTechniques(); len(got) != 1 || got[0] != want || want.String() != code {
+			t.Errorf("%s: got %v", code, got)
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty: %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad", "alsoBad"}}).GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Errorf("unknown: %v", got)
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	path := t.TempDir() + "/scanner"
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"valid connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, ""},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"invalid"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sT"}}, "multiple"},
+		{"privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, "hasPrivileged"},
+		{"source connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "TCPConnect"},
+		{"source range", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "65536"}, "[0,65535]"},
+		{"source zero", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "0"}, "0 is not"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			all := ""
+			for _, err := range errs {
+				all += err.Error()
+			}
+			if !strings.Contains(all, tc.want) || (tc.want == "" && len(errs) > 0) {
+				t.Fatalf("errors: %v", errs)
+			}
+		})
+	}
+	if !(&PortScanConf{}).IsZero() || (&PortScanConf{HasPrivileged: true}).IsZero() || (&PortScanConf{SourcePort: "1"}).IsZero() {
+		t.Fatal("IsZero ignored a configured field")
+	}
+}
+
+func TestPortScanLoadedForServer(t *testing.T) {
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	path := t.TempDir() + "/config.toml"
+	content := `[servers.example]
+host = "192.0.2.4"
+user = "root"
+scanModules = ["ospkg", "port"]
+[servers.example.portscan]
+scannerBinPath = "/usr/bin/nmap"
+hasPrivileged = true
+scanTechniques = ["sS"]
+sourcePort = "443"
+`
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	conf := Conf.Servers["example"].PortScan
+	if conf == nil || !conf.IsUseExternalScanner || conf.ScannerBinPath != "/usr/bin/nmap" || !conf.HasPrivileged || conf.SourcePort != "443" || len(conf.ScanTechniques) != 1 {
+		t.Fatalf("loaded portscan: %+v", conf)
+	}
+}
+
+func TestHasNmapCapabilities(t *testing.T) {
+	if !hasNmapCapabilities("/usr/bin/nmap cap_net_raw,cap_net_admin+eip") || hasNmapCapabilities("/usr/bin/nmap cap_net_raw+p") || hasNmapCapabilities("malformed") {
+		t.Fatal("capability parsing")
+	}
+}
