--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,49 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	date := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	makeVuln := func(source dbtypes.SourceID, severity dbtypes.Severity) types.DetectedVulnerability {
+		return types.DetectedVulnerability{
+			VulnerabilityID: "CVE-2024-0001",
+			SeveritySource:  source,
+			Vulnerability: dbtypes.Vulnerability{
+				Title: "title", Description: "description",
+				VendorSeverity: dbtypes.VendorSeverity{source: severity},
+				CVSS:           dbtypes.VendorCVSS{source: {V3Score: 4.2, V3Vector: "CVSS:3.1/example"}},
+				References:     []string{"https://example.com/advisory"},
+				PublishedDate:  &date, LastModifiedDate: &date,
+			},
+		}
+	}
+	result, err := Convert(types.Results{
+		{Vulnerabilities: []types.DetectedVulnerability{makeVuln("debian", dbtypes.SeverityLow)}},
+		{Vulnerabilities: []types.DetectedVulnerability{makeVuln("ubuntu", dbtypes.SeverityMedium)}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-2024-0001"].CveContents
+	for ctype, severity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM"} {
+		if len(contents[ctype]) != 1 {
+			t.Fatalf("%s: got %d entries", ctype, len(contents[ctype]))
+		}
+		got := contents[ctype][0]
+		if got.Type != ctype || got.CveID != "CVE-2024-0001" || got.Cvss3Severity != severity || got.Cvss3Score != 4.2 || got.Cvss3Vector != "CVSS:3.1/example" || !got.Published.Equal(date) || !got.LastModified.Equal(date) || len(got.References) != 1 {
+			t.Errorf("%s: incomplete content: %+v", ctype, got)
+		}
+	}
+	info := result.ScannedCves["CVE-2024-0001"]
+	if len(info.Summaries("en", "debian")) != 2 || len(info.Cvss3Scores()) != 2 {
+		t.Fatalf("source metadata was not aggregated: summaries=%v scores=%v", info.Summaries("en", "debian"), info.Cvss3Scores())
+	}
+}
