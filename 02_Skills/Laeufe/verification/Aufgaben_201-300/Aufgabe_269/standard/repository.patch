diff --git a/detector/library_trivy_test.go b/detector/library_trivy_test.go
new file mode 100644
index 0000000..235dd43
--- /dev/null
+++ b/detector/library_trivy_test.go
@@ -0,0 +1,35 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsGroupsVendorData(t *testing.T) {
+	date := time.Date(2024, 2, 3, 0, 0, 0, 0, time.UTC)
+	contents := getCveContents("CVE-2024-0002", dbtypes.Vulnerability{
+		Title: "title", Description: "description",
+		VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "ubuntu": dbtypes.SeverityMedium},
+		CVSS:           dbtypes.VendorCVSS{"debian": {V2Score: 2.1}, "ubuntu": {V3Score: 5.1}},
+		References:     []string{"https://example.com/advisory"},
+		PublishedDate:  &date, LastModifiedDate: &date,
+	})
+	for ctype, wantSeverity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM"} {
+		if len(contents[ctype]) != 1 {
+			t.Fatalf("%s: got %d contents", ctype, len(contents[ctype]))
+		}
+		got := contents[ctype][0]
+		if got.Type != ctype || got.CveID != "CVE-2024-0002" || got.Cvss3Severity != wantSeverity || !got.Published.Equal(date) || !got.LastModified.Equal(date) || len(got.References) != 1 {
+			t.Errorf("%s: incomplete content: %+v", ctype, got)
+		}
+	}
+	if contents[models.TrivyDebian][0].Cvss2Score != 2.1 || contents[models.TrivyUbuntu][0].Cvss3Score != 5.1 {
+		t.Fatal("CVSS values were not kept by source")
+	}
+}
