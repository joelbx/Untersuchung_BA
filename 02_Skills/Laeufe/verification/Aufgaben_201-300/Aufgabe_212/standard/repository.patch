+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	const base = `{
+		"65": {"vulnerabilities": [{
+			"id": "42", "title": "Example", "created_at": "2024-01-02T03:04:05+02:00",
+			"updated_at": "2024-02-03T04:05:06+02:00", "vuln_type": "AUTHBYPASS",
+			"references": {"cve": ["2024-1234", "2024-5678"], "url": ["https://example.org/one", "https://example.org/two"]},
+			"fixed_in": "6.5.1"%s
+		}]}
+	}`
+	tests := []struct {
+		name     string
+		extra    string
+		summary  string
+		optional map[string]string
+		score    float64
+		vector   string
+		severity string
+	}{
+		{
+			name:    "enterprise",
+			extra:   `, "description": "A detailed summary", "poc": "https://example.org/poc", "introduced_in": "6.5", "cvss": {"score": 8.1, "vector": "CVSS:3.1/AV:N", "severity": "HIGH"}`,
+			summary: "A detailed summary", optional: map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.5"},
+			score: 8.1, vector: "CVSS:3.1/AV:N", severity: "HIGH",
+		},
+		{name: "basic", extra: `, "description": null, "poc": null, "introduced_in": null, "cvss": null`, optional: map[string]string{}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			vinfos, err := convertToVinfos("core", fmt.Sprintf(base, tt.extra))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d vulnerability records, want 1", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2024-1234" || v.VulnType != "AUTHBYPASS" || len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].FixedIn != "6.5.1" {
+				t.Fatalf("unexpected vulnerability: %+v", v)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("got %d WPScan contents, want 1", len(contents))
+			}
+			c := contents[0]
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 2, 5, 6, 0, time.UTC)
+			if c.Type != models.WpScan || c.CveID != v.CveID || !c.Published.Equal(published) || c.Published.Location() != time.UTC || !c.LastModified.Equal(modified) || c.LastModified.Location() != time.UTC {
+				t.Fatalf("unexpected source, ID, or times: %+v", c)
+			}
+			if !reflect.DeepEqual(c.References, models.References{{Link: "https://example.org/one"}, {Link: "https://example.org/two"}}) {
+				t.Fatalf("unexpected references: %+v", c.References)
+			}
+			if c.Summary != tt.summary || !reflect.DeepEqual(c.Optional, tt.optional) || c.Cvss3Score != tt.score || c.Cvss3Vector != tt.vector || c.Cvss3Severity != tt.severity {
+				t.Fatalf("unexpected enriched fields: %+v", c)
+			}
+		})
+	}
+}
+
+func TestConvertToVinfosWPScanOmittedFields(t *testing.T) {
+	const body = `{"65":{"vulnerabilities":[{"id":"42","created_at":"2024-01-02T00:00:00Z","updated_at":"2024-01-03T00:00:00Z","vuln_type":"XSS","references":{"cve":["2024-1234"]}}]}}`
+	vinfos, err := convertToVinfos("core", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(vinfos) != 1 || len(vinfos[0].WpPackageFixStats) != 1 || vinfos[0].WpPackageFixStats[0].FixedIn != "" {
+		t.Fatalf("unexpected records or fix version: %+v", vinfos)
+	}
+	content := vinfos[0].CveContents[models.WpScan][0]
+	if content.Summary != "" || content.Cvss3Score != 0 || content.Cvss3Vector != "" || content.Cvss3Severity != "" || !reflect.DeepEqual(content.Optional, map[string]string{}) {
+		t.Fatalf("unexpected optional fields: %+v", content)
+	}
+}
