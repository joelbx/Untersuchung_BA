+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('https://M.MEDIA-AMAZON.COM/cover.jpg', 'https://M.MEDIA-AMAZON.COM/cover.jpg'),
+        ('http://m.media-amazon.com/cover.jpg', 'http://m.media-amazon.com/cover.jpg'),
+        ('https://unsupported.example/cover.jpg', None),
+        ('https://m.media-amazon.com.evil.example/cover.jpg', None),
+        ('ftp://m.media-amazon.com/cover.jpg', None),
+        ('https://[invalid/cover.jpg', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'Book', 'cover': cover}
+    assert process_cover_url(edition) == (expected, {'title': 'Book'})
+    assert edition == {'title': 'Book'}
+
+
+def test_process_cover_url_missing_and_custom_hosts():
+    edition = {'title': 'Book'}
+    assert process_cover_url(edition) == (None, edition)
+    assert process_cover_url(
+        {'cover': 'https://EXAMPLE.COM/cover.jpg'}, ['example.com']
+    ) == ('https://EXAMPLE.COM/cover.jpg', {})
+
+
