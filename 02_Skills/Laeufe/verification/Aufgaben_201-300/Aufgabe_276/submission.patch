diff --git a/internal/config/authentication_validation_test.go b/internal/config/authentication_validation_test.go
new file mode 100644
index 0000000..533e5b1
--- /dev/null
+++ b/internal/config/authentication_validation_test.go
@@ -0,0 +1,72 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLoadAuthenticationRequiredFields(t *testing.T) {
+	for _, method := range []string{"github", "oidc"} {
+		for _, field := range []string{"client_id", "client_secret", "redirect_address"} {
+			t.Run(method+"/"+field, func(t *testing.T) {
+				fields := map[string]string{
+					"client_id":        "id",
+					"client_secret":    "secret",
+					"redirect_address": "http://localhost/callback",
+				}
+				fields[field] = ""
+				provider := "github"
+				methodConfig := ""
+				if method == "oidc" {
+					provider = "foo"
+					methodConfig = "      providers:\n        foo:\n" +
+						fmt.Sprintf("          client_id: %q\n          client_secret: %q\n          redirect_address: %q\n", fields["client_id"], fields["client_secret"], fields["redirect_address"])
+				} else {
+					methodConfig = fmt.Sprintf("      client_id: %q\n      client_secret: %q\n      redirect_address: %q\n", fields["client_id"], fields["client_secret"], fields["redirect_address"])
+				}
+				config := "authentication:\n  session:\n    domain: localhost\n  methods:\n    " + method + ":\n      enabled: true\n" + methodConfig
+				path := filepath.Join(t.TempDir(), "config.yml")
+				require.NoError(t, os.WriteFile(path, []byte(config), 0600))
+
+				_, err := Load(path)
+				wantErr := fmt.Sprintf("provider %q: field %q: non-empty value is required", provider, field)
+				require.EqualError(t, err, wantErr)
+
+				indent := "      "
+				if method == "oidc" {
+					indent = "          "
+				}
+				withoutField := strings.Replace(config, indent+field+`: ""`+"\n", "", 1)
+				require.NoError(t, os.WriteFile(path, []byte(withoutField), 0600))
+				_, err = Load(path)
+				require.EqualError(t, err, wantErr)
+			})
+		}
+	}
+}
+
+func TestAuthenticationProviderValidation(t *testing.T) {
+	github := AuthenticationMethodGithubConfig{
+		ClientId: "id", ClientSecret: "secret", RedirectAddress: "http://localhost/callback",
+		AllowedOrganizations: []string{"flipt"}, Scopes: []string{"user:email"},
+	}
+	require.EqualError(t, github.validate(), `provider "github": field "scopes": must contain read:org when allowed_organizations is not empty`)
+	github.Scopes = append(github.Scopes, "read:org")
+	require.NoError(t, github.validate())
+
+	oidc := AuthenticationMethodOIDCConfig{Providers: map[string]AuthenticationMethodOIDCProvider{
+		"foo": {ClientID: "id", ClientSecret: "secret", RedirectAddress: "http://localhost/callback"},
+	}}
+	require.NoError(t, oidc.validate())
+	oidc.Providers["bar"] = AuthenticationMethodOIDCProvider{ClientID: "id", ClientSecret: "secret"}
+	require.EqualError(t, oidc.validate(), `provider "bar": field "redirect_address": non-empty value is required`)
+
+	// Whitespace does not provide a usable credential or callback address.
+	github.ClientId = strings.Repeat(" ", 2)
+	require.EqualError(t, github.validate(), `provider "github": field "client_id": non-empty value is required`)
+}
