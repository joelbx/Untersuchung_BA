@@ -1,7 +1,10 @@
 import pytest
 
 from openlibrary.catalog.marc.parse import (
+    name_from_list,
     read_author_person,
+    read_authors,
+    read_contributions,
     read_edition,
     NoTitle,
     SeeAlsoAsTitle,
@@ -153,6 +156,42 @@ class TestParseMARCBinary:
 
 
 class TestParse:
+    def test_name_from_list(self):
+        assert name_from_list([' [Ada,] ', ' / Countess: ', 'Lovelace.']) == 'Ada Countess Lovelace'
+        assert name_from_list([' Writer [from old catalog] ']) == 'Writer'
+
+    @pytest.mark.parametrize('tag', ['100', '700', '720'])
+    def test_linked_author_names(self, tag):
+        def field(field_tag, subfields):
+            children = ''.join(
+                f'<subfield code="{code}">{value}</subfield>'
+                for code, value in subfields
+            )
+            return f'<datafield tag="{field_tag}" ind1="1" ind2="0">{children}</datafield>'
+
+        xml = (
+            '<record xmlns="http://www.loc.gov/MARC21/slim">'
+            + field(tag, [('6', '880-01'), ('a', '  Smith, Ada, '), ('b', ' Jr., '), ('c', ' [Ph.D.]; '), ('d', '1900-1980.')])
+            + field('880', [('6', f'{tag}-01/$1'), ('a', ' スミス、エイダ / ')])
+            + field('880', [('6', f'{tag}-01/$2'), ('a', ' スミス、エイダ / ')])
+            + field('880', [('6', f'{tag}-01/$3'), ('a', ' 艾达·史密斯, ')])
+            + field('880', [('6', '700-02/$1'), ('a', 'Unrelated')])
+            + '</record>'
+        )
+        rec = MarcXml(etree.fromstring(xml))
+        rec.build_fields(['100', '700', '720', '880'])
+        authors = read_authors(rec) if tag == '100' else read_contributions(rec)['authors']
+        assert authors == [{
+            'name': 'Smith, Ada Jr. Ph.D',
+            'personal_name': 'Smith, Ada',
+            'numeration': 'Jr',
+            'title': 'Ph.D',
+            'birth_date': '1900',
+            'death_date': '1980',
+            'entity_type': 'person',
+            'alternate_names': ['スミス、エイダ', '艾达·史密斯'],
+        }]
+
     def test_read_author_person(self):
         xml_author = """
         <datafield xmlns="http://www.loc.gov/MARC21/slim" tag="100" ind1="1" ind2="0">
