+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "canplay", "canplaythrough", "durationchange", "emptied", "ended", "loadeddata", "loadedmetadata",
+    "loadstart", "pause", "play", "playing", "progress", "ratechange", "seeked", "seeking", "suspend",
+    "timeupdate", "volumechange", "waiting",
+]);
+
+/** Listener for audio element events used by legacy calls. */
+export function handleEvent(e: Event): void {
+    const audio = e.currentTarget as HTMLMediaElement | null;
+    const id = audio?.id ?? (e.target as HTMLMediaElement | null)?.id;
+
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call audio event", { id, type: e.type, error: audio?.error });
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call audio event", { id, type: e.type });
+    }
+}
