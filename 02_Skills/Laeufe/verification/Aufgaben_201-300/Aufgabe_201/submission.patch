+func TestSnapshotRuleSegmentFormats(t *testing.T) {
+	doc := `flags:
+- key: flag1
+  name: flag1
+  type: VARIANT_FLAG_TYPE
+  enabled: true
+  rules:
+  - segment: segment1
+  - segment:
+      keys: [segment1]
+      operator: AND_SEGMENT_OPERATOR
+  - segment:
+      keys: [segment1, segment2]
+      operator: AND_SEGMENT_OPERATOR
+segments:
+- key: segment1
+  name: segment1
+- key: segment2
+  name: segment2
+`
