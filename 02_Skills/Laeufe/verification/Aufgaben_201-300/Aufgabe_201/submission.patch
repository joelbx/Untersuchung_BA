diff --git a/internal/ext/common_test.go b/internal/ext/common_test.go
new file mode 100644
index 0000000..e8269cf
--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,52 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	yaml2 "gopkg.in/yaml.v2"
+	yaml3 "gopkg.in/yaml.v3"
+)
+
+func TestRuleSegmentFormats(t *testing.T) {
+	for _, parser := range []struct {
+		name      string
+		unmarshal func([]byte, interface{}) error
+	}{
+		{"yaml2", yaml2.Unmarshal}, {"yaml3", yaml3.Unmarshal},
+	} {
+		t.Run(parser.name, func(t *testing.T) {
+			for _, tc := range []struct {
+				input    string
+				keys     []string
+				operator string
+				invalid  bool
+			}{
+				{"segment: foo", []string{"foo"}, "OR_SEGMENT_OPERATOR", false},
+				{"segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR", []string{"foo"}, "OR_SEGMENT_OPERATOR", false},
+				{"segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR", []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR", false},
+				{"segment: [foo]", nil, "", true},
+				{"segment:\n  key: foo", nil, "", true},
+				{"segment:\n  keys: []\n  operator: AND_SEGMENT_OPERATOR", nil, "", true},
+				{"segment:\n  keys: [foo, bar]", nil, "", true},
+				{"segment: ''", nil, "", true},
+			} {
+				var r Rule
+				err := parser.unmarshal([]byte(tc.input), &r)
+				if tc.invalid {
+					require.Error(t, err, tc.input)
+					continue
+				}
+				require.NoError(t, err, tc.input)
+				keys, operator, err := r.Segment.SegmentValues()
+				require.NoError(t, err)
+				require.Equal(t, tc.keys, keys)
+				require.Equal(t, tc.operator, operator)
+			}
+		})
+	}
+	var r Rule
+	require.NoError(t, yaml2.Unmarshal([]byte("rank: 1"), &r))
+	_, _, err := r.Segment.SegmentValues()
+	require.Error(t, err)
+}
