index 591ea9c..8afcc40 100644
--- a/internal/ext/common.go
+++ b/internal/ext/common.go
@@ -1,5 +1,138 @@
 package ext
 
+import "fmt"
+
+// IsSegment represents a rule's segment selection.
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ Segment IsSegment }
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil {
+		return nil, fmt.Errorf("missing segment")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, fmt.Errorf("empty segment key")
+		}
+		return string(v), nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, err
+		}
+		if len(v.Keys) == 1 {
+			v.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		return v, nil
+	default:
+		return nil, fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		if v == "" {
+			return fmt.Errorf("empty segment key")
+		}
+		s.Segment = SegmentKey(v)
+		return nil
+	case map[interface{}]interface{}:
+		for key := range v {
+			if key != "keys" && key != "operator" {
+				return fmt.Errorf("invalid segment field %v", key)
+			}
+		}
+		if _, ok := v["keys"]; !ok {
+			return fmt.Errorf("segment keys are required")
+		}
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return err
+		}
+		if err := validateSegments(segments); err != nil {
+			return err
+		}
+		s.Segment = segments
+		return nil
+	case map[string]interface{}:
+		for key := range v {
+			if key != "keys" && key != "operator" {
+				return fmt.Errorf("invalid segment field %s", key)
+			}
+		}
+		if _, ok := v["keys"]; !ok {
+			return fmt.Errorf("segment keys are required")
+		}
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return err
+		}
+		if err := validateSegments(segments); err != nil {
+			return err
+		}
+		s.Segment = segments
+		return nil
+	default:
+		return fmt.Errorf("invalid segment format %T", raw)
+	}
+}
+
+func validateSegments(s Segments) error {
+	if len(s.Keys) == 0 {
+		return fmt.Errorf("segment keys are required")
+	}
+	for _, key := range s.Keys {
+		if key == "" {
+			return fmt.Errorf("empty segment key")
+		}
+	}
+	if len(s.Keys) > 1 && s.SegmentOperator != "AND_SEGMENT_OPERATOR" && s.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid segment operator %q", s.SegmentOperator)
+	}
+	return nil
+}
+
+// SegmentValues normalizes both YAML forms for the storage boundary.
+func (s *SegmentEmbed) SegmentValues() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("missing segment")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, "", fmt.Errorf("empty segment key")
+		}
+		return []string{string(v)}, "OR_SEGMENT_OPERATOR", nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, "", err
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys, "OR_SEGMENT_OPERATOR", nil
+		}
+		return v.Keys, v.SegmentOperator, nil
+	default:
+		return nil, "", fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+}
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
