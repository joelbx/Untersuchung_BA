 'use strict';
 
 const db = require('../database');
+const user = require('../user');
+const coreUtils = require('../utils');
 
 const utils = module.exports;
 
-// internal token management utilities only
+// Internal token management utilities only.
+const tokens = {};
+utils.tokens = tokens;
 
-utils.log = async (token) => {
+tokens.list = async () => {
+	const ids = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await tokens.get(ids);
+};
+
+tokens.getLastSeen = async (ids) => {
+	if (!Array.isArray(ids)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!ids.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', ids);
+	return scores.map(score => (score === null || !Number.isFinite(Number(score)) ? null : Number(score)));
+};
+
+tokens.get = async (input) => {
+	if (input === null || input === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const multiple = Array.isArray(input);
+	const ids = multiple ? input : [input];
+	if (ids.some(id => typeof id !== 'string')) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!ids.length) {
+		return [];
+	}
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(ids.map(id => `token:${id}`)),
+		tokens.getLastSeen(ids),
+	]);
+	const result = objects.map((object, index) => (object ? {
+		token: ids[index],
+		uid: Number(object.uid),
+		description: object.description || '',
+		timestamp: Number(object.timestamp),
+		lastSeen: lastSeen[index],
+	} : null));
+	return multiple ? result : result[0];
+};
+
+tokens.generate = async ({ uid, description = '' }) => {
+	const numericUid = Number(uid);
+	if (uid === null || uid === undefined || !Number.isFinite(numericUid) ||
+		(numericUid !== 0 && !await user.exists(numericUid))) {
+		throw new Error('[[error:no-user]]');
+	}
+	const token = coreUtils.generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, { uid: numericUid, description, timestamp });
+	await db.sortedSetAdd('tokens:createtime', timestamp, token);
+	await db.sortedSetAdd('tokens:uid', numericUid, token);
+	return token;
+};
+
+tokens.update = async (token, { description }) => {
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await tokens.get(token);
+};
+
+tokens.delete = async (token) => {
+	await db.delete(`token:${token}`);
+	await Promise.all([
+		db.sortedSetRemove('tokens:createtime', token),
+		db.sortedSetRemove('tokens:uid', token),
+		db.sortedSetRemove('tokens:lastSeen', token),
+	]);
+};
+
+tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+// Keep the existing internal callers working.
+utils.log = tokens.log;
+utils.getLastSeen = tokens.getLastSeen;
diff --git a/test/api-utils-tokens.js b/test/api-utils-tokens.js
new file mode 100644
index 0000000..dc1dcda
--- /dev/null
+++ b/test/api-utils-tokens.js
@@ -0,0 +1,90 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+describe('API token utilities', () => {
+	const source = fs.readFileSync(path.join(__dirname, '../src/api/utils.js'), 'utf8');
+	let tokens;
+	let objects;
+	let sets;
+
+	beforeEach(() => {
+		objects = new Map();
+		sets = new Map();
+		const sorted = (key) => {
+			if (!sets.has(key)) {
+				sets.set(key, new Map());
+			}
+			return sets.get(key);
+		};
+		const db = {
+			getSortedSetRange: async key => [...sorted(key)]
+				.sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]))
+				.map(item => item[0]),
+			sortedSetScores: async (key, ids) => ids.map(id => (sorted(key).has(id) ? sorted(key).get(id) : null)),
+			sortedSetAdd: async (key, score, id) => sorted(key).set(id, score),
+			sortedSetRemove: async (key, id) => sorted(key).delete(id),
+			getObjects: async keys => keys.map(key => objects.get(key) || null),
+			setObject: async (key, object) => objects.set(key, { ...object }),
+			setObjectField: async (key, field, value) => { objects.get(key)[field] = value; },
+			delete: async key => objects.delete(key),
+		};
+		const module = { exports: {} };
+		vm.runInNewContext(source, {
+			module,
+			require: name => ({
+				'../database': db,
+				'../user': { exists: async uid => uid === 1 },
+				'../utils': { generateUUID: () => `generated-${objects.size}` },
+			})[name],
+			Date,
+			Number,
+			Promise,
+			Error,
+		});
+		tokens = module.exports.tokens;
+	});
+
+	it('creates, lists, hydrates, updates, logs and deletes token data', async () => {
+		assert.deepStrictEqual(Array.from(await tokens.list()), []);
+		assert.deepStrictEqual(Array.from(await tokens.get([])), []);
+		const first = await tokens.generate({ uid: 1, description: 'first' });
+		const second = await tokens.generate({ uid: 0 });
+		const stored = objects.get(`token:${first}`);
+		assert.strictEqual(stored.uid, 1);
+		assert.strictEqual(stored.description, 'first');
+		assert(Number.isFinite(stored.timestamp));
+		assert(Math.abs(Date.now() - stored.timestamp) < 1000);
+		assert.strictEqual(sets.get('tokens:createtime').get(first), stored.timestamp);
+		assert.strictEqual(sets.get('tokens:uid').get(first), 1);
+		assert.strictEqual(sets.get('tokens:uid').get(second), 0);
+		assert.strictEqual((await tokens.get(first)).lastSeen, null);
+		assert.deepStrictEqual(Array.from(await tokens.list(), item => item.token), [first, second]);
+		assert.deepStrictEqual(Array.from(await tokens.get([second, first]), item => item.token), [second, first]);
+		await tokens.log(first);
+		const seen = await tokens.getLastSeen([second, first]);
+		assert.strictEqual(seen[0], null);
+		assert(Number.isFinite(seen[1]));
+		const updated = await tokens.update(first, { description: 'updated' });
+		assert.strictEqual(updated.description, 'updated');
+		assert.strictEqual(updated.uid, stored.uid);
+		assert.strictEqual(updated.timestamp, stored.timestamp);
+		assert.strictEqual(updated.lastSeen, seen[1]);
+		await tokens.delete(first);
+		assert.strictEqual(await tokens.get(first), null);
+		for (const key of ['tokens:createtime', 'tokens:uid', 'tokens:lastSeen']) {
+			assert.strictEqual(sets.get(key).has(first), false);
+		}
+	});
+
+	it('rejects missing data and nonexistent users', async () => {
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get(undefined), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.generate({ uid: 2 }), /\[\[error:no-user\]\]/);
+		await assert.rejects(tokens.generate({ uid: null }), /\[\[error:no-user\]\]/);
+		assert.strictEqual(objects.size, 0);
+	});
+});
