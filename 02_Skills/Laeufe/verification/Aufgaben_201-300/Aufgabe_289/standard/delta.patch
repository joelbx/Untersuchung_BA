diff --git a/internal/config/default_config_test.go b/internal/config/default_config_test.go
new file mode 100644
index 0000000..74f7da1
--- /dev/null
+++ b/internal/config/default_config_test.go
@@ -0,0 +1,40 @@
+package config
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"github.com/mitchellh/mapstructure"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDefaultConfigAndDecodeHooks(t *testing.T) {
+	defaults := DefaultConfig()
+	require.Equal(t, time.Minute, defaults.Cache.TTL)
+	require.Equal(t, 2*time.Minute, defaults.Audit.Buffer.FlushPeriod)
+
+	var decoded Config
+	decoder, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+		Result:     &decoded,
+		TagName:    "mapstructure",
+	})
+	require.NoError(t, err)
+	require.NoError(t, decoder.Decode(map[string]any{
+		"cache": map[string]any{"ttl": "60s"},
+		"audit": map[string]any{"buffer": map[string]any{"flush_period": "2m"}},
+	}))
+	require.Equal(t, defaults.Cache.TTL, decoded.Cache.TTL)
+	require.Equal(t, defaults.Audit.Buffer.FlushPeriod, decoded.Audit.Buffer.FlushPeriod)
+}
+
+func TestCUESchemaCompiles(t *testing.T) {
+	data, err := os.ReadFile("../../config/flipt.schema.cue")
+	require.NoError(t, err)
+	schema := cuecontext.New().CompileBytes(data)
+	require.NoError(t, schema.Err())
+	require.NoError(t, schema.LookupPath(cue.ParsePath("#FliptSpec")).Err())
+}
