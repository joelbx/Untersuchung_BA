+func TestWithTxUsesSuppliedConnection(t *testing.T) {
+	conn, err := sql.Open(db.Driver, "file:withtx-supplied?mode=memory&cache=shared")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if _, err := conn.Exec("CREATE TABLE marker (value TEXT)"); err != nil {
+		t.Fatal(err)
+	}
+	store := New(conn)
+	rollback := errors.New("rollback")
+	err = store.WithTx(func(tx model.DataStore) error {
+		_, err := tx.(*SQLStore).db.NewQuery("INSERT INTO marker (value) VALUES ('test')").Execute()
+		if err != nil {
+			return err
+		}
+		return rollback
+	})
+	if !errors.Is(err, rollback) {
+		t.Fatalf("WithTx error = %v, want %v", err, rollback)
+	}
+	var count int
+	if err := conn.QueryRow("SELECT COUNT(*) FROM marker").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Fatalf("rollback left %d rows", count)
+	}
+}
