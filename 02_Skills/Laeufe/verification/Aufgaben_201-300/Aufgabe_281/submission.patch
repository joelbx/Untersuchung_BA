index 0000000..fbe6d48
--- /dev/null
+++ b/src/database/increment-bulk.js
@@ -0,0 +1,37 @@
+'use strict';
+
+const { fieldToString } = require('./mongo/helpers');
+
+module.exports = function normalizeBulkIncrements(data) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const byKey = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			![Object.prototype, null].includes(Object.getPrototypeOf(item[1]))) {
+			throw new TypeError('Bulk increments must contain [key, increments] tuples');
+		}
+		const [key, fields] = item;
+		if (!byKey.has(key)) {
+			byKey.set(key, Object.create(null));
+		}
+		const increments = byKey.get(key);
+		Object.entries(fields).forEach(([name, value]) => {
+			const field = fieldToString(name);
+			if (!field || /[.$\0]/.test(name) || ['__proto__', 'constructor', 'prototype'].includes(field)) {
+				throw new TypeError(`Invalid increment field: ${name}`);
+			}
+			if (!Number.isSafeInteger(value)) {
+				throw new TypeError(`Increment for ${field} must be a safe integer`);
+			}
+			const total = (increments[field] || 0) + value;
+			if (!Number.isSafeInteger(total)) {
+				throw new RangeError(`Increment for ${field} exceeds the safe integer range`);
+			}
+			increments[field] = total;
+		});
+	});
+	return [...byKey].filter(([, fields]) => Object.keys(fields).length);
+};
