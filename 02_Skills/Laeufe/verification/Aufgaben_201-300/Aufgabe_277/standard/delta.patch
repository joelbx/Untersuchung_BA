+
+func TestRuleSegments(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		legacy   string
+		keys     []string
+		operator string
+		wantKey  string
+	}{
+		{name: "legacy", legacy: "old", wantKey: "old"},
+		{name: "single", legacy: "old", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple", keys: []string{"first", "second"}, operator: "AND_SEGMENT_OPERATOR", wantKey: "first,second"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			r := &flipt.Rule{SegmentKey: tt.legacy, SegmentKeys: tt.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR}
+			got := NewRule(r)
+			assert.Equal(t, tt.wantKey, got.SegmentKey)
+			assert.Equal(t, tt.operator, got.SegmentOperator)
+			encoded, err := json.Marshal(got)
+			assert.NoError(t, err)
+			var fields map[string]any
+			assert.NoError(t, json.Unmarshal(encoded, &fields))
+			_, present := fields["segment_operator"]
+			assert.Equal(t, tt.operator != "", present)
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		legacy   string
+		keys     []string
+		operator string
+		wantKey  string
+	}{
+		{name: "legacy", legacy: "old", wantKey: "old"},
+		{name: "single", legacy: "old", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple", keys: []string{"first", "second"}, operator: "AND_SEGMENT_OPERATOR", wantKey: "first,second"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			r := &flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+				SegmentKey: tt.legacy, SegmentKeys: tt.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true,
+			}}}
+			got := NewRollout(r)
+			assert.Equal(t, tt.wantKey, got.Segment.Key)
+			assert.True(t, got.Segment.Value)
+			assert.Equal(t, tt.operator, got.Segment.Operator)
+			encoded, err := json.Marshal(got.Segment)
+			assert.NoError(t, err)
+			var fields map[string]any
+			assert.NoError(t, json.Unmarshal(encoded, &fields))
+			_, present := fields["operator"]
+			assert.Equal(t, tt.operator != "", present)
+		})
+	}
+}
