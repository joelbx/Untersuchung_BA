+def test_filesystem_open_category(qtmodeltester, config_stub, info,
+                                  quickmark_manager_stub, bookmark_manager_stub):
+    """Filesystem stays present when empty and obeys category ordering."""
+    config_stub.val.completion.open_categories = ['filesystem', 'quickmarks']
+    config_stub.val.completion.favorite_paths = ['~/site.html', '/tmp/docs']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    _check_completions(model, {
+        'Filesystem': [('~/site.html', None, None),
+                       ('/tmp/docs', None, None)],
+    })
+
+    model.set_pattern('ordinary search')
+    _check_completions(model, {'Filesystem': []})
+
+    config_stub.val.completion.open_categories = ['quickmarks']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    _check_completions(model, {})
+
+
+def test_filepath_category(qtmodeltester, config_stub, tmp_path,
+                           monkeypatch):
+    """Complete absolute, file URL and home paths in sorted order."""
+    root = tmp_path / 'files'
+    root.mkdir()
+    (root / 'alpha.html').write_text('')
+    (root / 'a space.html').write_text('')
+    (root / 'archive').mkdir()
+    (root / 'beta.html').write_text('')
+    (root / 'space dir').mkdir()
+    (root / 'space dir' / 'page.html').write_text('')
+    monkeypatch.setenv('HOME', str(root))
+    category = filepathcategory.FilePathCategory('Filesystem')
+    qtmodeltester.check(category)
+
+    for pattern, expected in [
+        (str(root) + '/a', ['a space.html', 'alpha.html', 'archive/']),
+        ('file://' + str(root) + '/a',
+         ['a%20space.html', 'alpha.html', 'archive/']),
+        ('~/a', ['a space.html', 'alpha.html', 'archive/']),
+    ]:
+        category.set_pattern(pattern)
+        prefix = pattern[:-1]
+        assert [category.data(category.index(i, 0))
+                for i in range(category.rowCount())] == [
+                    prefix + name for name in expected]
+        assert category.data(category.index(0, 1)) is None
+        qtmodeltester.check(category)
+
+    category.set_pattern(str(root) + '/')
+    assert [category.data(category.index(i, 0))
+            for i in range(category.rowCount())] == [
+                str(root / 'a space.html'),
+                str(root / 'alpha.html'),
+                str(root / 'archive') + '/',
+                str(root / 'beta.html'),
+                str(root / 'space dir') + '/',
+            ]
+
+    category.set_pattern('~')
+    assert category.data(category.index(0, 0)) == '~/a space.html'
+
+    category.set_pattern('file://' + str(root) + '/space%20dir/')
+    assert category.data(category.index(0, 0)) == (
+        'file://' + str(root) + '/space%20dir/page.html')
+
+    for pattern in ['relative/path', 'https://example.org',
+                    'file://remote/path', '/missing-directory/file',
+                    'file:///tmp/%ZZ', 'file:///tmp/path?query']:
+        category.set_pattern(pattern)
+        assert category.rowCount() == 0
+
