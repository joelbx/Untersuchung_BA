+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+
+from ansible.modules.storage.netapp.netapp_e_drive_firmware import NetAppESeriesDriveFirmware
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+
+try:
+    from unittest import mock
+except ImportError:
+    import mock
+
+
+REQUEST = 'ansible.modules.storage.netapp.netapp_e_drive_firmware.request'
+
+
+class DriveFirmwareTest(ModuleTestCase):
+    def make_module(self, **options):
+        args = dict(api_username='admin', api_password='password', api_url='http://localhost/devmgr/v2',
+                    ssid='1', firmware=['/tmp/new.dlp'])
+        args.update(options)
+        set_module_args(args)
+        return NetAppESeriesDriveFirmware()
+
+    def test_compatibility_filters_and_caches(self):
+        module = self.make_module()
+        compatibility = [dict(filename='new.dlp', firmwareVersion='NEW', driveRefList=['a', 'b', 'c']),
+                         dict(filename='other.dlp', firmwareVersion='NEW', driveRefList=['d'])]
+        with mock.patch(REQUEST, side_effect=[(200, compatibility),
+                                              (200, dict(firmwareVersion='OLD', available=True)),
+                                              (200, dict(firmwareVersion='NEW', available=True)),
+                                              (200, dict(firmwareVersion='OLD', offline=True))]) as req:
+            module.ignore_inaccessible_drives = True
+            expected = [dict(filename='new.dlp', driveRefList=['a'])]
+            self.assertEqual(module.upgrade_list(), expected)
+            self.assertEqual(module.upgrade_list(), expected)
+            self.assertEqual(req.call_count, 4)
+
+    def test_inaccessible_and_online_capability_fail(self):
+        module = self.make_module()
+        compat = [dict(filename='new.dlp', firmwareVersion='NEW', driveRefList=['a'])]
+        with mock.patch(REQUEST, side_effect=[(200, compat), (200, dict(offline=True, firmwareVersion='OLD'))]):
+            with self.assertRaisesRegex(AnsibleFailJson, 'inaccessible'):
+                module.upgrade_list()
+        module = self.make_module()
+        compat[0]['onlineUpgradeCapable'] = False
+        with mock.patch(REQUEST, side_effect=[(200, compat), (200, dict(firmwareVersion='OLD'))]):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Drive is not capable of online upgrade'):
+                module.upgrade_list()
+
+    def test_apply_check_mode_has_no_writes(self):
+        module = self.make_module(_ansible_check_mode=True)
+        compat = [dict(filename='new.dlp', firmwareVersion='NEW', driveRefList=['a'])]
+        with mock.patch(REQUEST, side_effect=[(200, compat), (200, dict(firmwareVersion='OLD'))]) as req:
+            with self.assertRaises(AnsibleExitJson) as result:
+                module.apply()
+            self.assertTrue(result.exception.args[0]['changed'])
+            self.assertFalse(result.exception.args[0]['upgrade_in_process'])
+            self.assertEqual(req.call_count, 2)
+
+    def test_upgrade_and_wait_only_target_drives(self):
+        module = self.make_module(wait_for_completion=True)
+        module._upgrade_list = [dict(filename='new.dlp', driveRefList=['a'])]
+        with mock.patch(REQUEST, side_effect=[(202, {}),
+                                              (200, [dict(driveRef='a', status='pending'),
+                                                     dict(driveRef='other', status='failed')]),
+                                              (200, [dict(driveRef='a', status='okay')])]) as req:
+            with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.time.sleep'):
+                module.upgrade()
+            self.assertFalse(module.upgrade_in_progress)
+            self.assertEqual(req.call_count, 3)
+
+    def test_poll_failure(self):
+        module = self.make_module()
+        module._upgrade_list = [dict(filename='new.dlp', driveRefList=['a'])]
+        with mock.patch(REQUEST, return_value=(200, [dict(driveRef='a', status='failed')])):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Drive firmware upgrade failed'):
+                module.wait_for_upgrade_completion()
+
+    def test_poll_timeout_and_fetch_failure(self):
+        module = self.make_module()
+        module._upgrade_list = [dict(filename='new.dlp', driveRefList=['a'])]
+        with mock.patch(REQUEST, return_value=(200, [dict(driveRef='a', status='pending')])):
+            with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.time.monotonic',
+                            side_effect=[0, 3601]):
+                with self.assertRaisesRegex(AnsibleFailJson, 'Timed out waiting for drive firmware upgrade'):
+                    module.wait_for_upgrade_completion()
+        with mock.patch(REQUEST, side_effect=Exception('offline')):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Failed to retrieve drive status'):
+                module.wait_for_upgrade_completion()
+
+    def test_compatibility_and_lookup_failures(self):
+        module = self.make_module()
+        with mock.patch(REQUEST, side_effect=Exception('offline')):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Failed to complete compatibility and health check'):
+                module.upgrade_list()
+        compatibility = [dict(filename='new.dlp', firmwareVersion='NEW', driveRefList=['a'])]
+        with mock.patch(REQUEST, side_effect=[(200, compatibility), Exception('lookup failed')]):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Failed to retrieve drive information'):
+                module.upgrade_list()
+
+    def test_upload_failure_has_context(self):
+        module = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.create_multipart_formdata',
+                        return_value=({}, b'data')):
+            with mock.patch(REQUEST, side_effect=Exception('bad file')):
+                with self.assertRaisesRegex(AnsibleFailJson, 'Failed to upload drive firmware') as result:
+                    module.upload_firmware()
+                self.assertIn('new.dlp', str(result.exception))
+                self.assertIn('array 1', str(result.exception))
