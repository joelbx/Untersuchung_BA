@@ -0,0 +1,63 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestGetEOL(t *testing.T) {
+	for _, tc := range []struct{ family, release, standard, extended string }{
+		{Amazon, "2018.03", "2023-06-30", "2023-06-30"},
+		{Amazon, "2 (Karoo)", "2025-06-30", ""},
+		{RedHat, "7", "2024-06-30", ""},
+		{RedHat, "8", "2029-05-31", ""},
+		{RedHat, "6", "2020-11-30", "2024-06-30"},
+		{CentOS, "7", "2024-06-30", ""},
+		{CentOS, "8", "2021-12-31", ""},
+		{CentOS, "6", "2020-11-30", "2020-11-30"},
+		{Oracle, "7", "2024-06-30", ""},
+		{Oracle, "8", "2029-05-31", ""},
+		{Oracle, "6", "2021-03-31", "2022-03-31"},
+		{Ubuntu, "18.04", "2023-05-31", "2028-04-30"},
+		{Ubuntu, "14.04", "2019-04-30", "2024-04-30"},
+		{Ubuntu, "14.10", "2015-07-30", "2015-07-30"},
+		{Ubuntu, "21.04", "2022-01-30", ""},
+		{Debian, "9", "2022-06-30", ""},
+		{Debian, "10", "2024-06-30", ""},
+		{Debian, "8", "2020-06-30", "2020-06-30"},
+		{Alpine, "3.10", "2021-05-30", ""},
+		{Alpine, "3.11", "2021-11-30", ""},
+		{Alpine, "3.12", "2022-05-30", ""},
+		{Alpine, "3.9", "2020-11-30", "2020-11-30"},
+		{FreeBSD, "11", "2021-09-30", "2021-09-30"},
+		{FreeBSD, "12", "2023-12-31", ""},
+		{FreeBSD, "10", "2019-10-30", "2019-10-30"},
+	} {
+		e, found := GetEOL(tc.family, tc.release)
+		if !found || e.StandardSupportUntil.Format("2006-01-02") != tc.standard {
+			t.Errorf("%s %s: standard date = %v, found = %v", tc.family, tc.release, e.StandardSupportUntil, found)
+		}
+		if tc.extended == "" && !e.ExtendedSupportUntil.IsZero() || tc.extended != "" && e.ExtendedSupportUntil.Format("2006-01-02") != tc.extended {
+			t.Errorf("%s %s: extended date = %v", tc.family, tc.release, e.ExtendedSupportUntil)
+		}
+	}
+	for _, tc := range []struct{ family, release string }{{RedHat, "9"}, {CentOS, "9"}, {Oracle, "9"}, {Ubuntu, "12.10"}, {Debian, "11"}, {Alpine, "3.13"}, {Amazon, "2"}, {"unknown", "1"}} {
+		if _, found := GetEOL(tc.family, tc.release); found {
+			t.Errorf("unexpected EOL mapping for %s %s", tc.family, tc.release)
+		}
+	}
+}
+
+func TestEOLBoundaries(t *testing.T) {
+	e, _ := GetEOL(RedHat, "6")
+	if e.IsStandardSupportEnded(e.StandardSupportUntil) || !e.IsStandardSupportEnded(e.StandardSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("standard support boundary is not strict")
+	}
+	if e.IsExtendedSuppportEnded(e.ExtendedSupportUntil) || !e.IsExtendedSuppportEnded(e.ExtendedSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("extended support boundary is not strict")
+	}
+	e, _ = GetEOL(RedHat, "7")
+	if e.IsExtendedSuppportEnded(time.Now()) {
+		t.Fatal("missing extended support must not be considered ended")
+	}
+}
