+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestEOLWarnings(t *testing.T) {
+	date := func(s string) time.Time { d, _ := time.Parse("2006-01-02", s); return d }
+	for _, tc := range []struct {
+		family, release, now string
+		want                 []string
+	}{
+		{config.Ubuntu, "14.10", "2020-01-01", []string{
+			"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+			"Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.",
+		}},
+		{config.Ubuntu, "14.04.5", "2020-01-01", []string{
+			"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+			"Extended support available until 2024-04-30. Check the vendor site.",
+		}},
+		{config.FreeBSD, "11.4-RELEASE", "2021-07-01", []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"}},
+		{config.RedHat, "9", "2020-01-01", []string{"Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: redhat Release: 9'"}},
+		{config.Amazon, "2 (Karoo)", "2025-06-30", []string{"Standard OS support will be end in 3 months. EOL date: 2025-06-30"}},
+		{config.Amazon, "2018.03", "2020-01-01", nil},
+		{config.Raspbian, "10", "2020-01-01", nil},
+		{config.ServerTypePseudo, "1", "2020-01-01", nil},
+	} {
+		got := eolWarnings(tc.family, tc.release, date(tc.now))
+		if !reflect.DeepEqual(got, tc.want) {
+			t.Errorf("%s %s: got %v, want %v", tc.family, tc.release, got, tc.want)
+		}
+	}
+}
+
+func TestConvertToModelIncludesEOLWarnings(t *testing.T) {
+	b := &base{Distro: config.Distro{Family: config.Ubuntu, Release: "14.10"}}
+	r := b.convertToModel()
+	want := []string{
+		"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+		"Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.",
+	}
+	if !reflect.DeepEqual(r.Warnings, want) {
+		t.Fatalf("scan result warnings = %v, want %v", r.Warnings, want)
+	}
+}
