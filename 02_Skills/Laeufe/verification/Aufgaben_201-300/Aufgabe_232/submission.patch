@@ -0,0 +1,14 @@
+package version
+
+import "strings"
+
+// Major extracts the major component after an optional epoch prefix.
+func Major(value string) string {
+	if colon := strings.IndexByte(value, ':'); colon >= 0 {
+		value = value[colon+1:]
+	}
+	if dot := strings.IndexByte(value, '.'); dot >= 0 {
+		return value[:dot]
+	}
+	return value
+}
