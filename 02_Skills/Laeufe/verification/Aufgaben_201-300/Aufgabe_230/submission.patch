+def test_prioritized_identifier_equality_order_and_serialization() -> None:
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    first = PrioritizedIdentifier("B06XYHVXVJ", timestamp=timestamp)
+    duplicate = PrioritizedIdentifier("B06XYHVXVJ", stage_import=False, priority=Priority.HIGH)
+    other = PrioritizedIdentifier("9780747532699", priority=Priority.HIGH)
+
+    assert first == duplicate
+    assert len({first, duplicate, other}) == 2
+    assert other < first
+    assert json.loads(json.dumps(duplicate.to_dict())) == {
+        "identifier": "B06XYHVXVJ",
+        "stage_import": False,
+        "priority": "HIGH",
+        "timestamp": duplicate.timestamp.isoformat(),
+    }
+    assert first.timestamp == timestamp
+    assert PrioritizedISBN(isbn="9780747532699").isbn == "9780747532699"
+    legacy = PrioritizedISBN("9780747532699", Priority.HIGH, timestamp)
+    assert legacy.priority == Priority.HIGH
+    assert legacy.stage_import is True
+    assert legacy.timestamp == timestamp
+
+
+def test_process_amazon_batch_respects_stage_import(monkeypatch) -> None:
+    from scripts import affiliate_server
+
+    products = [
+        {"isbn_13": ["9780747532699"], "isbn_10": ["0747532699"]},
+        {"source_records": ["amazon:B06XYHVXVJ"]},
+    ]
+    api = MagicMock()
+    api.get_products.return_value = products
+    batch = MagicMock()
+    monkeypatch.setattr(affiliate_server.web, "amazon_api", api, raising=False)
+    monkeypatch.setattr(affiliate_server.config, "infobase", {"db_parameters": True})
+    monkeypatch.setattr(affiliate_server.cache, "memcache_cache", MagicMock())
+    monkeypatch.setattr(affiliate_server, "get_current_amazon_batch", lambda: batch)
+    monkeypatch.setattr(
+        affiliate_server,
+        "clean_amazon_metadata_for_load",
+        lambda product: {"source_records": product.get("source_records", ["amazon:0747532699"])},
+    )
+    monkeypatch.setattr(affiliate_server.stats, "increment", MagicMock())
+
+    process_amazon_batch(
+        [
+            PrioritizedIdentifier("0747532699", stage_import=False),
+            PrioritizedIdentifier("B06XYHVXVJ"),
+        ]
+    )
+
