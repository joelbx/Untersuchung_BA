+        assert d['lending_identifier_s'] == 'public'
+        assert set(d['printdisabled_s'].split(';')) == {'OL11M', 'OL13M'}
+        assert set(d['ia']) == {'loan', 'disabled1', 'public', 'disabled2'}
+        assert set(d['ia_collection_s'].split(';')) == {
+            'lendinglibrary', 'inlibrary', 'printdisabled', 'americana', 'opensource'
+        }
