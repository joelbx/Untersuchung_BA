+    @pytest.mark.asyncio
+    async def test_public_edition_precedes_lendinglibrary_and_printdisabled(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w, key='/books/OL10M', ocaid='loan',
+                    _ia_meta={'collection': ['lendinglibrary', 'inlibrary']},
+                ),
+                make_edition(
+                    w, key='/books/OL11M', ocaid='disabled1',
+                    _ia_meta={'collection': ['printdisabled', 'americana']},
+                ),
+                make_edition(
+                    w, key='/books/OL12M', ocaid='public',
+                    _ia_meta={'collection': ['americana', 'opensource']},
+                ),
+                make_edition(
+                    w, key='/books/OL13M', ocaid='disabled2',
+                    _ia_meta={'collection': ['printdisabled', 'inlibrary']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+        assert d['has_fulltext'] is True
