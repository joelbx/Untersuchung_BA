+def _is_child_path(root, path, link_target=None):
+    """Check a path, or a link relative to its location, against a root."""
+    if link_target is not None:
+        path = os.path.join(os.path.dirname(path), link_target)
+    root = os.path.realpath(root)
+    path = os.path.realpath(path)
+    relative = os.path.relpath(path, root)
+    parent = to_bytes(os.pardir) if isinstance(relative, bytes) else os.pardir
+    sep = to_bytes(os.sep) if isinstance(relative, bytes) else os.sep
+    current = to_bytes(os.curdir) if isinstance(relative, bytes) else os.curdir
+    return relative == current or (relative != parent and not relative.startswith(parent + sep))
 
 
