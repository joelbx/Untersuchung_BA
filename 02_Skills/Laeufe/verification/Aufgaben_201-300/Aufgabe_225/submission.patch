+package models
+
+import "testing"
+
+func TestKEVSummaryAndSorting(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"CVE-1": {KEVs: []KEV{{Type: VulnCheckKEVType, VulnerabilityName: "Z"}, {Type: CISAKEVType, VulnerabilityName: "B"}, {Type: CISAKEVType, VulnerabilityName: "A"}}},
+		"CVE-2": {KEVs: []KEV{{Type: CISAKEVType}}},
+		"CVE-3": {},
+	}}
+	if got := r.FormatKEVCveSummary(); got != "2 KEVs" {
+		t.Fatalf("summary = %q", got)
+	}
+	r.SortForJSONOutput()
+	got := r.ScannedCves["CVE-1"].KEVs
+	if got[0].VulnerabilityName != "A" || got[1].VulnerabilityName != "B" || got[2].VulnerabilityName != "Z" {
+		t.Fatalf("sort order = %+v", got)
+	}
+}
