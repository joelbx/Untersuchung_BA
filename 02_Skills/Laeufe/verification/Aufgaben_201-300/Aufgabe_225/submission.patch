+func validDueDate(date time.Time) *time.Time {
+	if date.IsZero() || date.Year() <= 1000 {
+		return nil
+	}
+	return &date
+}
+
+func convertKEVs(response kevulndb.Response) []models.KEV {
+	var kevs []models.KEV
+	for _, c := range response.CISA {
+		kevs = append(kevs, models.KEV{
+			Type: models.CISAKEVType, VendorProject: c.VendorProject,
+			Product: c.Product, VulnerabilityName: c.VulnerabilityName,
+			ShortDescription: c.ShortDescription, RequiredAction: c.RequiredAction,
+			KnownRansomwareCampaignUse: c.KnownRansomwareCampaignUse,
+			DateAdded:                  c.DateAdded, DueDate: validDueDate(c.DueDate),
+			CISA: &models.CISAKEV{Note: c.Notes},
+		})
+	}
+	for _, v := range response.VulnCheck {
+		kev := models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: v.VendorProject,
+			Product: v.Product, VulnerabilityName: v.Name,
+			ShortDescription: v.Description, RequiredAction: v.RequiredAction,
+			KnownRansomwareCampaignUse: v.KnownRansomwareCampaignUse,
+			DateAdded:                  v.DateAdded, VulnCheck: &models.VulnCheckKEV{},
+		}
+		if v.DueDate != nil {
+			kev.DueDate = validDueDate(*v.DueDate)
+		}
+		for _, x := range v.VulnCheckXDB {
+			kev.VulnCheck.XDB = append(kev.VulnCheck.XDB, models.VulnCheckXDB{
+				XDBID: x.XDBID, XDBURL: x.XDBURL, DateAdded: x.DateAdded,
+				ExploitType: x.ExploitType, CloneSSHURL: x.CloneSSHURL,
+			})
+		}
+		for _, e := range v.VulnCheckReportedExploitation {
+			kev.VulnCheck.ReportedExploitation = append(kev.VulnCheck.ReportedExploitation,
+				models.VulnCheckReportedExploitation{URL: e.URL, DateAdded: e.DateAdded})
+		}
+		kevs = append(kevs, kev)
+	}
+	return kevs
+}
+
 type kevulnResponse struct {
 	request kevulnRequest
 	json    string
