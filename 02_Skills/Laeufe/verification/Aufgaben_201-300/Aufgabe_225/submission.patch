+// FormatKEVCveSummary counts CVEs with at least one KEV entry.
+func (r ScanResult) FormatKEVCveSummary() string {
+	count := 0
+	for _, vuln := range r.ScannedCves {
+		if len(vuln.KEVs) > 0 {
+			count++
+		}
+	}
+	return fmt.Sprintf("%d KEVs", count)
+}
