new file mode 100644
index 0000000..1dd4de6
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,37 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestConvertKEVs(t *testing.T) {
+	date := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	response := kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", Product: "product", VulnerabilityName: "CISA issue", Notes: "note", DateAdded: date, DueDate: time.Date(1000, 1, 1, 0, 0, 0, 0, time.UTC)}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "VC vendor", Name: "VC issue", Description: "description", DateAdded: date, DueDate: &date,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "1", XDBURL: "https://example.com/xdb", DateAdded: date, ExploitType: "poc", CloneSSHURL: "ssh://example.com"}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://example.com/report", DateAdded: date}},
+		}},
+	}
+	got := convertKEVs(response)
+	if len(got) != 2 || got[0].Type != models.CISAKEVType || got[0].CISA == nil || got[0].CISA.Note != "note" || got[0].DueDate != nil {
+		t.Fatalf("CISA mapping: %+v", got)
+	}
+	if got[1].Type != models.VulnCheckKEVType || got[1].VendorProject != "VC vendor" || got[1].ShortDescription != "description" || got[1].DueDate == nil || got[1].VulnCheck == nil {
+		t.Fatalf("VulnCheck mapping: %+v", got[1])
+	}
+	if len(got[1].VulnCheck.XDB) != 1 || got[1].VulnCheck.XDB[0].XDBID != "1" || len(got[1].VulnCheck.ReportedExploitation) != 1 || got[1].VulnCheck.ReportedExploitation[0].URL != "https://example.com/report" {
+		t.Fatalf("VulnCheck details: %+v", got[1].VulnCheck)
+	}
+	response.VulnCheck[0].DueDate = new(time.Time)
+	if convertKEVs(response)[1].DueDate != nil {
+		t.Fatal("zero VulnCheck due date was retained")
+	}
+}
