+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Group raw IA ISBNs by length, without validating their contents."""
+    if isinstance(isbns, str):
+        isbns = [isbns]
+
+    isbn_10, isbn_13 = [], []
+    for value in isbns:
+        isbn = value.strip()
+        if len(isbn) == 10:
+            isbn_10.append(isbn)
+        elif len(isbn) == 13:
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
