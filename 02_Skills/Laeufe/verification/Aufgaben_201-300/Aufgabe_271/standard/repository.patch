+def test_get_ia_record_multiple_publish_places_and_isbns() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'publisher': 'London ; New York ; Paris : Berlitz Publishing',
+            'isbn': [' 123456789X ', ' 9781234567890 ', 'bad', '12345678901'],
+        }
+    )
+    assert result['publishers'] == ['Berlitz Publishing']
+    assert result['publish_places'] == ['London', 'New York', 'Paris']
+    assert result['isbn_10'] == ['123456789X']
+    assert result['isbn_13'] == ['9781234567890']
+
+
+def test_get_ia_record_preserves_publisher_names() -> None:
+    names = ['  First Publisher  ', 'Second Publisher']
+    result = code.ia_importapi.get_ia_record({'publisher': names})
+    assert result['publishers'] == names
+    assert 'publish_places' not in result
