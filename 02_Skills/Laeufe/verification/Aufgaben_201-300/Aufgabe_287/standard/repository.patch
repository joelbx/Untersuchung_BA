+++ b/scanner/image_files_test.go
@@ -0,0 +1,48 @@
+package scanner
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestLoadDirImageFiles(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"back.png", "front.jpg", "notes.txt"} {
+		if err := os.WriteFile(filepath.Join(dir, name), nil, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, stats, err := loadDir(context.Background(), dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !stats.HasImages || stats.AudioFilesCount != 0 || stats.HasPlaylist ||
+		strings.Join(stats.ImageFiles, ",") != "back.png,front.jpg" {
+		t.Fatalf("unexpected directory stats: %+v", stats)
+	}
+}
+
+func TestImageFiles(t *testing.T) {
+	mfs := model.MediaFiles{
+		{Path: filepath.Join("music", "b", "2.mp3")},
+		{Path: filepath.Join("music", "a", "1.mp3")},
+		{Path: filepath.Join("music", "b", "1.mp3")},
+	}
+	dirs := dirMap{
+		filepath.Join("music", "a"): {ImageFiles: []string{"front.jpg", "back.png"}},
+		filepath.Join("music", "b"): {ImageFiles: []string{"large.jpg"}},
+	}
+	want := strings.Join([]string{
+		filepath.Join("music", "a", "front.jpg"),
+		filepath.Join("music", "a", "back.png"),
+		filepath.Join("music", "b", "large.jpg"),
+	}, string(filepath.ListSeparator))
+	if got := imageFiles(mfs, dirs); got != want {
+		t.Fatalf("imageFiles() = %q, want %q", got, want)
+	}
+}
