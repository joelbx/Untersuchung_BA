+package model
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestMediaFilesDirs(t *testing.T) {
+	mfs := MediaFiles{
+		{Path: "/music/b/2.mp3"},
+		{Path: "/music/a/1.mp3"},
+		{Path: "/music/b/1.mp3"},
+	}
+	want := []string{"/music/a", "/music/b"}
+	if got := mfs.Dirs(); !reflect.DeepEqual(got, want) {
+		t.Fatalf("Dirs() = %v, want %v", got, want)
+	}
+}
