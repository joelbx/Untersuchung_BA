+func Test_execPortsScanGroupedDest(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	addr, port, err := net.SplitHostPort(listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := (&base{}).execPortsScan(map[string][]string{addr: {port}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{listener.Addr().String()}; !reflect.DeepEqual(got, want) {
+		t.Errorf("base.execPortsScan() = %v, want %v", got, want)
+	}
+}
