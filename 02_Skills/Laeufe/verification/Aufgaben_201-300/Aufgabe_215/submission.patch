+)
+
+func writeConfig(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "config.yml")
+	if err := ioutil.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	cfg, err := configure(writeConfig(t, "# defaults\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults differ: %#v", cfg)
+	}
+
+	cert := writeConfig(t, "certificate")
+	key := writeConfig(t, "key")
+	path := writeConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: "+cert+"\n  cert_key: "+key+"\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server.Host != "127.0.0.1" || cfg.Server.Protocol != HTTPS || cfg.Server.HTTPPort != 8081 || cfg.Server.HTTPSPort != 8080 || cfg.Server.GRPCPort != 9001 || cfg.Server.CertFile != cert || cfg.Server.CertKey != key || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("advanced config differs: %#v", cfg)
+	}
+	if HTTPS.String() != "https" || HTTP.String() != "http" {
+		t.Fatal("incorrect scheme strings")
+	}
+
+	listPath := writeConfig(t, "cors:\n  allowed_origins:\n    - foo.com\n")
+	listCfg, err := configure(listPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(listCfg.Cors.AllowedOrigins, cfg.Cors.AllowedOrigins) {
+		t.Fatal("string and list origins differ")
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	envCfg, err := configure(writeConfig(t, "server:\n  http_port: 8081\n"))
+	if err != nil || envCfg.Server.HTTPPort != 8181 {
+		t.Fatalf("environment override: cfg=%#v err=%v", envCfg, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	cert := writeConfig(t, "cert")
+	key := writeConfig(t, "key")
+	for _, tc := range []struct {
+		cert, key, want string
+	}{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{cert, "", "cert_key cannot be empty when using HTTPS"},
+		{"missing-cert", key, "cannot find TLS cert_file at \"missing-cert\""},
+		{cert, "missing-key", "cannot find TLS cert_key at \"missing-key\""},
+	} {
+		cfg.Server.CertFile, cfg.Server.CertKey = tc.cert, tc.key
+		if err := cfg.validate(); err == nil || err.Error() != tc.want {
+			t.Fatalf("validate(%q, %q) = %v; want %q", tc.cert, tc.key, err, tc.want)
+		}
+	}
+	cfg.Server.Protocol = HTTP
+	cfg.Server.CertFile, cfg.Server.CertKey = "missing-cert", "missing-key"
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []interface {
+		ServeHTTP(w http.ResponseWriter, r *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, httptest.NewRequest("GET", "/", nil))
+		if w.Code != 200 || strings.TrimSpace(w.Body.String()) == "" {
+			t.Fatalf("response: status=%d body=%q", w.Code, w.Body.String())
+		}
+	}
+}
