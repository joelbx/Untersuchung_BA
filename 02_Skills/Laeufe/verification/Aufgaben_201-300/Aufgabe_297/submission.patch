+func TestNestedMapRedaction(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{
+		"config": map[string]interface{}{
+			"token":  "secret-value",
+			"nested": map[string]string{"url": "?jwt=secret-value&x=1"},
+		},
+	}}
+	hook := &Hook{RedactionList: []string{`(?i)token`, `([^\w]jwt=)[^&]+`}}
+	assert.NoError(t, hook.Fire(entry))
+	config := entry.Data["config"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", config["token"])
+	assert.Equal(t, "?jwt=[REDACTED]&x=1", config["nested"].(map[string]string)["url"])
+}
+
+func TestAuthConfigRedaction(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{
+		"appConfig": map[string]interface{}{"auth": map[string]interface{}{"token": "private-token", "username": "alice"}},
+		"json":      `{"auth":{"token":"private-token","username":"alice"}}`,
+	}}
+	assert.NoError(t, redacted.Fire(entry))
+	auth := entry.Data["appConfig"].(map[string]interface{})["auth"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", auth["token"])
+	assert.Equal(t, "alice", auth["username"])
+	assert.NotContains(t, entry.Data["json"], "private-token")
+}
+
+func TestTypedMapKeepsKeys(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{"values": map[string]int{"secret": 42, "public": 7}}}
+	hook := &Hook{RedactionList: []string{`secret`}}
+	assert.NoError(t, hook.Fire(entry))
+	assert.Equal(t, map[string]interface{}{"secret": "[REDACTED]", "public": "7"}, entry.Data["values"])
+}
diff --git a/server/app/reverse_proxy.go b/server/app/reverse_proxy.go
new file mode 100644
index 0000000..29845df
--- /dev/null
+++ b/server/app/reverse_proxy.go
@@ -0,0 +1,123 @@
+package app
+
+import (
+	"crypto/md5"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// validateIPAgainstList checks the connection address, never a forwarded address header.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if strings.TrimSpace(whitelist) == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	remoteIP := remoteAddr
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteIP = host
+	}
+	ip := net.ParseIP(strings.Trim(remoteIP, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if _, cidr, err := net.ParseCIDR(entry); err == nil {
+			if cidr.Contains(ip) {
+				return true
+			}
+			continue
+		}
+		// An individual address (optionally with a port) is a single-host range.
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		if allowed := net.ParseIP(strings.Trim(entry, "[]")); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	username := strings.TrimSpace(r.Header.Get(conf.Server.ReverseProxyUserHeader))
+	if conf.Server.ReverseProxyUserHeader == "" || username == "" {
+		return nil
+	}
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for proxy login", countErr)
+			return nil
+		}
+		password := make([]byte, 32)
+		if _, err = rand.Read(password); err != nil {
+			log.Error(r, "Generating proxy user password", err)
+			return nil
+		}
+		user = &model.User{
+			UserName:    username,
+			Name:        strings.Title(username),
+			NewPassword: hex.EncodeToString(password),
+			IsAdmin:     count == 0,
+		}
+		if err = userRepo.Put(user); err != nil {
+			log.Error(r, "Creating proxy user", err)
+			return nil
+		}
+		user, err = userRepo.FindByUsername(username)
+	}
+	if err != nil || user == nil {
+		log.Error(r, "Finding proxy user", err)
+		return nil
+	}
+	if err = userRepo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating proxy user LastLoginAt", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating proxy login token", err)
+		return nil
+	}
+	saltBytes := make([]byte, 8)
+	if _, err = rand.Read(saltBytes); err != nil {
+		log.Error(r, "Generating Subsonic salt", err)
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	return map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         token,
+		"subsonicSalt":  salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
+}
