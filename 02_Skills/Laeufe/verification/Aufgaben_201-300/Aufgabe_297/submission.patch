@@ -0,0 +1,34 @@
+describe('reverse proxy configuration', () => {
+  afterEach(() => {
+    delete window.__APP_CONFIG__
+    localStorage.clear()
+  })
+
+  it('stores an authenticated session for the frontend', () => {
+    window.__APP_CONFIG__ = JSON.stringify({
+      auth: {
+        id: 'user-id',
+        isAdmin: true,
+        name: 'Alice',
+        username: 'alice',
+        token: 'jwt',
+        subsonicSalt: 'salt',
+        subsonicToken: 'hash',
+      },
+    })
+    jest.resetModules()
+    require('./config')
+    expect(localStorage.getItem('token')).toBe('jwt')
+    expect(localStorage.getItem('userId')).toBe('user-id')
+    expect(localStorage.getItem('role')).toBe('admin')
+    expect(localStorage.getItem('subsonic-salt')).toBe('salt')
+    expect(localStorage.getItem('subsonic-token')).toBe('hash')
+  })
+
+  it('does not initialize a session when auth is absent', () => {
+    window.__APP_CONFIG__ = JSON.stringify({ firstTime: false })
+    jest.resetModules()
+    require('./config')
+    expect(localStorage.getItem('token')).toBeNull()
+  })
+})
