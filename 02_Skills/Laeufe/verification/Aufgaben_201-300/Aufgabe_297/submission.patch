+// redactValue retains map keys while applying redaction to values at every depth.
+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	rv := reflect.ValueOf(value)
+	if rv.Kind() == reflect.Map {
+		outType := rv.Type()
+		if outType.Elem().Kind() != reflect.Interface && outType.Elem().Kind() != reflect.String {
+			outType = reflect.MapOf(outType.Key(), reflect.TypeOf((*interface{})(nil)).Elem())
+		}
+		out := reflect.MakeMapWithSize(outType, rv.Len())
+		for _, key := range rv.MapKeys() {
+			item := rv.MapIndex(key).Interface()
+			var redacted interface{}
+			if re.MatchString(fmt.Sprint(key.Interface())) {
+				redacted = "[REDACTED]"
+			} else {
+				redacted = redactValue(item, re)
+			}
+			v := reflect.ValueOf(redacted)
+			if !v.IsValid() {
+				v = reflect.Zero(outType.Elem())
+			}
+			out.SetMapIndex(key, v)
+		}
+		return out.Interface()
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
