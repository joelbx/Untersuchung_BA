@@ -0,0 +1,77 @@
+package app
+
+import (
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	list := "invalid, 192.0.2.0/24, 2001:db8::/32, 127.0.0.1:4533, @"
+	for _, addr := range []string{"192.0.2.5:1234", "[2001:db8::1]:4533", "127.0.0.1:1234", "@"} {
+		if !validateIPAgainstList(addr, list) {
+			t.Errorf("expected %q to match", addr)
+		}
+	}
+	for _, addr := range []string{"203.0.113.2:1234", "[2001:db9::1]:4533", "malformed"} {
+		if validateIPAgainstList(addr, list) {
+			t.Errorf("expected %q to be denied", addr)
+		}
+	}
+	if validateIPAgainstList("@", "192.0.2.0/24") || validateIPAgainstList("192.0.2.5:1234", "") {
+		t.Fatal("empty list or non-matching socket must be denied")
+	}
+}
+
+func TestServeIndexOnlyIncludesTrustedAuth(t *testing.T) {
+	oldList, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() { conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldList, oldHeader }()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{MockedUser: tests.CreateMockUserRepo()}
+	fs := os.DirFS("tests/fixtures")
+	req := httptest.NewRequest("GET", "/index.html", nil)
+	req.Header.Set("Remote-User", "alice")
+	req.RemoteAddr = "203.0.113.1:9000"
+	w := httptest.NewRecorder()
+	serveIndex(ds, fs)(w, req)
+	if _, ok := extractAppConfig(w.Body.String())["auth"]; ok {
+		t.Fatal("untrusted source received authentication data")
+	}
+	req.RemoteAddr = "192.0.2.1:9000"
+	w = httptest.NewRecorder()
+	serveIndex(ds, fs)(w, req)
+	if _, ok := extractAppConfig(w.Body.String())["auth"]; !ok {
+		t.Fatal("trusted source did not receive authentication data")
+	}
+}
+
+func TestHandleLoginFromHeaders(t *testing.T) {
+	oldList, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() { conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldList, oldHeader }()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	repo := tests.CreateMockUserRepo()
+	ds := &tests.MockDataStore{MockedUser: repo}
+	req := httptest.NewRequest("GET", "/app/", nil)
+	req.RemoteAddr = "203.0.113.1:9000"
+	req.Header.Set("Remote-User", "alice")
+	if got := handleLoginFromHeaders(ds, req); got != nil || len(repo.Data) != 0 {
+		t.Fatal("untrusted source authenticated")
+	}
+	req.RemoteAddr = "192.0.2.8:9000"
+	got := handleLoginFromHeaders(ds, req)
+	if got == nil || got["username"] != "alice" || got["isAdmin"] != true || got["subsonicSalt"] == "" || got["subsonicToken"] == "" {
+		t.Fatalf("unexpected proxy login payload: %v", got)
+	}
+	if _, err := auth.Validate(got["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	if repo.Data["alice"].LastLoginAt == nil {
+		t.Fatal("last login not updated")
+	}
+}
