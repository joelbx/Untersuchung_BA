+        """Build documentation for a role, optionally selecting one entry point.
+
+        :returns: The role name and its documentation, or None for the documentation
+            when no entry points match.
+        """
+        fqcn = '.'.join([collection, role]) if collection else role
+        entry_points = {}
+        for ep in argspec:
