+    def test_play_name_follows_hosts_without_changing_input(self):
+        data = dict(hosts=['first', 'second'])
+        p = Play.load(data)
+        self.assertEqual(data, dict(hosts=['first', 'second']))
+        self.assertEqual(p.get_name(), 'first,second')
+        p.hosts = ('third', 'fourth')
+        self.assertEqual(p.get_name(), 'third,fourth')
+        p.name = 'explicit name'
+        self.assertEqual(p.get_name(), 'explicit name')
+
+        p.name = None
+        p.hosts = [b'binary', 'text']
+        self.assertEqual(p.get_name(), 'binary,text')
+
+    def test_play_name_with_string_hosts(self):
+        p = Play.load(dict(hosts='localhost'))
