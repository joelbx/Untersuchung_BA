+		Expect(repo.Delete("user-a", "setting")).To(Succeed())
+		_, err := repo.Get("user-a", "setting")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(repo.Get("user-b", "setting")).To(Equal("B"))
+	})
+})
