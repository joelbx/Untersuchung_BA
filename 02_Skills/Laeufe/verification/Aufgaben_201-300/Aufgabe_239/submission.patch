+func (s *Router) startLink(w http.ResponseWriter, r *http.Request) {
+	u, ok := request.UserFrom(r.Context())
+	if !ok {
+		_ = rest.RespondWithError(w, http.StatusUnauthorized, "Not authenticated")
+		return
+	}
+	if s.secret == "" {
+		_ = rest.RespondWithError(w, http.StatusInternalServerError, "Last.fm is not configured")
+		return
+	}
+	nonce := make([]byte, 16)
+	if _, err := rand.Read(nonce); err != nil {
+		_ = rest.RespondWithError(w, http.StatusInternalServerError, "Could not start Last.fm authorization")
+		return
+	}
+	payload := fmt.Sprintf("%s:%d:%s", u.ID, time.Now().Add(10*time.Minute).Unix(), base64.RawURLEncoding.EncodeToString(nonce))
+	sig := s.signState(payload)
+	state := base64.RawURLEncoding.EncodeToString([]byte(payload)) + "." + base64.RawURLEncoding.EncodeToString(sig)
+	_ = rest.RespondWithJSON(w, http.StatusOK, map[string]string{"state": state})
+}
+
+func (s *Router) signState(payload string) []byte {
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(payload))
+	return mac.Sum(nil)
+}
+
+func (s *Router) userFromState(state string) (string, bool) {
+	parts := strings.Split(state, ".")
+	if len(parts) != 2 || s.secret == "" {
+		return "", false
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", false
+	}
+	sig, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil || !hmac.Equal(sig, s.signState(string(payload))) {
+		return "", false
+	}
+	fields := strings.Split(string(payload), ":")
+	if len(fields) != 3 || fields[0] == "" || fields[2] == "" {
+		return "", false
+	}
+	expires, err := strconv.ParseInt(fields[1], 10, 64)
+	if err != nil || time.Now().Unix() > expires {
+		return "", false
+	}
+	return fields[0], true
+}
