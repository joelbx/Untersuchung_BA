+		if err != nil || got != tc.want {
+			t.Fatalf("DefaultGet(%q, %q) = %q, %v; want %q", tc.user, tc.key, got, err, tc.want)
+		}
+	}
+	if err := repo.Delete("a_b", "c"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.Get("a_b", "c"); err != model.ErrNotFound {
+		t.Fatalf("deleted property error = %v", err)
+	}
+	if got, err := repo.Get("a", "b_c"); err != nil || got != "B" {
+		t.Fatalf("other user's property = %q, %v", got, err)
+	}
+}
