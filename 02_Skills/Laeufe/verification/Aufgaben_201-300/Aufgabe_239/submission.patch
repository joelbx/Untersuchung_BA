+func TestMockedUserPropsRepoScopesProperties(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("a_b", "c", "A"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("a", "b_c", "B"); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ user, key, want string }{{"a_b", "c", "A"}, {"a", "b_c", "B"}} {
