diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..b2c7179
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,67 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestRouterScopesLinkToAuthenticatedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	s := &Router{sessionKeys: &sessionKeys{ds: ds}, secret: "test-secret"}
+	ctx := request.WithUser(context.Background(), model.User{ID: "user-a"})
+	start := httptest.NewRecorder()
+	s.startLink(start, httptest.NewRequest(http.MethodGet, "/link/start", nil).WithContext(ctx))
+	if start.Code != http.StatusOK {
+		t.Fatalf("start link status = %d: %s", start.Code, start.Body.String())
+	}
+	var response struct{ State string }
+	if err := json.Unmarshal(start.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	if uid, ok := s.userFromState(response.State); !ok || uid != "user-a" {
+		t.Fatalf("signed state returned user %q, valid %v", uid, ok)
+	}
+	if uid, ok := s.userFromState(response.State + "x"); ok || uid != "" {
+		t.Fatal("tampered state was accepted")
+	}
+
+	fake := &tests.FakeHttpClient{Res: http.Response{
+		Body: ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"A-KEY"}}`)), StatusCode: http.StatusOK,
+	}}
+	s.client = NewClient("api-key", s.secret, "en", fake)
+	callback := httptest.NewRecorder()
+	s.callback(callback, httptest.NewRequest(http.MethodGet, "/link/callback?uid=user-b&state="+url.QueryEscape(response.State)+"&token=token", nil))
+	if callback.Code != http.StatusOK {
+		t.Fatalf("callback status = %d: %s", callback.Code, callback.Body.String())
+	}
+	if key, err := s.sessionKeys.get(context.Background(), "user-a"); err != nil || key != "A-KEY" {
+		t.Fatalf("user A key = %q, %v", key, err)
+	}
+	if _, err := s.sessionKeys.get(context.Background(), "user-b"); err != model.ErrNotFound {
+		t.Fatalf("user B key error = %v", err)
+	}
+
+	status := httptest.NewRecorder()
+	s.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(request.WithUser(context.Background(), model.User{ID: "user-b"})))
+	if status.Code != http.StatusOK || !bytes.Contains(status.Body.Bytes(), []byte(`"status":false`)) {
+		t.Fatalf("user B status = %d: %s", status.Code, status.Body.String())
+	}
+	unlink := httptest.NewRecorder()
+	s.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+	if unlink.Code != http.StatusOK {
+		t.Fatalf("unlink status = %d: %s", unlink.Code, unlink.Body.String())
+	}
+	if _, err := s.sessionKeys.get(context.Background(), "user-a"); err != model.ErrNotFound {
+		t.Fatalf("user A key after unlink error = %v", err)
+	}
+}
