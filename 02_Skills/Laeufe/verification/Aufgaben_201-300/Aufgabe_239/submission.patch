+var _ = Describe("UserProps Repository", func() {
+	It("uses the explicit user ID for all operations even when context has another user", func() {
+		ctx := request.WithUser(log.NewContext(context.Background()), model.User{ID: "context-user"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
