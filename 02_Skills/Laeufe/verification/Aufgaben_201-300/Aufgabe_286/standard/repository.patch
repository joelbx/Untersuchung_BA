diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..a42cfff
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,69 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" || version == "dev" {
+		return false
+	}
+
+	core, _, _ := strings.Cut(version, "+")
+	if start := strings.IndexByte(core, '-'); start >= 0 {
+		for _, identifier := range strings.FieldsFunc(core[start+1:], func(r rune) bool { return r == '.' || r == '-' }) {
+			switch identifier {
+			case "dev", "snapshot", "rc":
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Check looks up the latest release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	info, err := check(ctx, version, github.NewClient(nil))
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func check(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	latestRelease, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+
+	latest, err := semver.ParseTolerant(latestRelease.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latestRelease.GetTagName()
+	info.LatestVersionURL = latestRelease.GetHTMLURL()
+	info.UpdateAvailable = current.LT(latest)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..ba7e580
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,76 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+)
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"", false}, {"dev", false}, {"1.2.3-dev", false}, {"1.2.3-dev.2", false},
+		{"1.2.3-snapshot", false}, {"1.2.3-snapshot.2", false},
+		{"1.2.3-rc", false}, {"1.2.3-rc.1", false},
+		{"v1.2.3", true}, {"1.2.3", true}, {"1.2.3+build-rc", true},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			if got := Is(tc.version); got != tc.want {
+				t.Fatalf("Is(%q) = %v, want %v", tc.version, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	for _, tc := range []struct {
+		current, latest string
+		wantUpdate      bool
+	}{
+		{"v1.2.3", "v1.2.3", false},
+		{"v1.2.3", "v1.3.0", true},
+		{"v1.3.0", "v1.2.3", false},
+	} {
+		t.Run(tc.current+"/"+tc.latest, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+					t.Errorf("unexpected path: %s", r.URL.Path)
+				}
+				w.Header().Set("Content-Type", "application/json")
+				fmt.Fprintf(w, `{"tag_name":%q,"html_url":"https://example.com/release"}`, tc.latest)
+			}))
+			defer server.Close()
+			client := github.NewClient(server.Client())
+			base, _ := url.Parse(server.URL + "/")
+			client.BaseURL = base
+			got, err := check(context.Background(), tc.current, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tc.current || got.LatestVersion != tc.latest || got.LatestVersionURL != "https://example.com/release" || got.UpdateAvailable != tc.wantUpdate {
+				t.Fatalf("unexpected info: %+v", got)
+			}
+		})
+	}
+}
+
+func TestCheckFailureRetainsCurrentVersion(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "unavailable", http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+	client := github.NewClient(server.Client())
+	base, _ := url.Parse(server.URL + "/")
+	client.BaseURL = base
+	got, err := check(context.Background(), "v1.2.3", client)
+	if err == nil || got.CurrentVersion != "v1.2.3" || got.UpdateAvailable {
+		t.Fatalf("got %+v, %v", got, err)
+	}
+}
