diff --git a/build/internal/cmd/oci/main.go b/build/internal/cmd/oci/main.go
new file mode 100644
index 0000000..6c8bd70
--- /dev/null
+++ b/build/internal/cmd/oci/main.go
@@ -0,0 +1,35 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"log"
+	"os"
+
+	"go.flipt.io/flipt/internal/oci"
+	"go.uber.org/zap"
+)
+
+func main() {
+	testdataDir := flag.String("testdata-dir", "", "directory of feature files")
+	bundleDir := flag.String("bundle-dir", "", "directory for OCI bundles")
+	flag.Parse()
+
+	if *testdataDir == "" || *bundleDir == "" {
+		log.Fatal("testdata-dir and bundle-dir are required")
+	}
+	if err := os.MkdirAll(*bundleDir, 0755); err != nil {
+		log.Fatal(err)
+	}
+	store, err := oci.NewStore(zap.NewNop(), *bundleDir)
+	if err != nil {
+		log.Fatal(err)
+	}
+	ref, err := oci.ParseReference("flipt://local/testdata:latest")
+	if err != nil {
+		log.Fatal(err)
+	}
+	if _, err := store.Build(context.Background(), os.DirFS(*testdataDir), ref); err != nil {
+		log.Fatal(err)
+	}
+}
