diff --git a/applications/mail/src/app/logic/elements/elementsSlice.test.ts b/applications/mail/src/app/logic/elements/elementsSlice.test.ts
new file mode 100644
index 0000000..812c4c8
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsSlice.test.ts
@@ -0,0 +1,98 @@
+import reducer, { newState } from './elementsSlice';
+import { backendActionFinished, backendActionStarted, load, retry, retryStale, reset } from './elementsActions';
+import { loading, pendingActions, shouldSendRequest } from './elementsSelectors';
+import { RootState } from '../store';
+import { configureStore } from '@reduxjs/toolkit';
+import { Api } from '@proton/shared/lib/interfaces';
+
+describe('elements request state', () => {
+    const makeStore = () =>
+        configureStore({
+            reducer: { elements: reducer },
+            middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+        });
+
+    it('tracks overlapping backend actions across list resets', () => {
+        let state = reducer(newState(), backendActionStarted());
+        state = reducer(state, backendActionStarted());
+        state = reducer(state, reset({}));
+        expect(state.pendingActions).toBe(2);
+        state = reducer(state, backendActionFinished());
+        state = reducer(state, backendActionFinished());
+        expect(pendingActions({ elements: state } as RootState)).toBe(0);
+    });
+
+    it('retries failures and stale responses with separate state', () => {
+        const queryParameters = { Page: 1 };
+        const error = new Error('fetch failed');
+        let state = reducer(newState(), retry({ queryParameters, error }));
+        expect(state.retry).toEqual({ payload: queryParameters, count: 1, error });
+        state = reducer(state, retry({ queryParameters, error }));
+        expect(state.retry.count).toBe(2);
+        state = reducer(state, retryStale({ queryParameters }));
+        expect(state.retry).toEqual({ payload: queryParameters, count: 1, error: undefined });
+        expect(state.pendingRequest).toBe(false);
+    });
+
+    it('reports loading when the current page needs a request', () => {
+        const state = newState({ beforeFirstLoad: false });
+        const rootState = { elements: state } as RootState;
+        const scope = { page: 0, params: state.params };
+        expect(shouldSendRequest(rootState, scope)).toBe(true);
+        expect(loading(rootState, scope)).toBe(true);
+    });
+
+    it('rejects stale data and schedules only the stale retry', async () => {
+        jest.useFakeTimers();
+        try {
+            const store = makeStore();
+            const api = jest.fn().mockResolvedValue({ Total: 1, Conversations: [{ ID: 'stale' }], Stale: 1 });
+            const result = await store.dispatch(
+                load({
+                    api: api as unknown as Api,
+                    abortController: undefined,
+                    conversationMode: true,
+                    page: 0,
+                    params: newState().params,
+                })
+            );
+            expect(result.type).toBe(load.rejected.type);
+            expect(store.getState().elements.elements).toEqual({});
+            jest.advanceTimersByTime(1000);
+            expect(store.getState().elements.retry).toEqual({
+                payload: expect.objectContaining({ Page: 0 }),
+                count: 1,
+                error: undefined,
+            });
+            expect(store.getState().elements.pendingRequest).toBe(false);
+        } finally {
+            jest.useRealTimers();
+        }
+    });
+
+    it('retries fetch failures after two seconds', async () => {
+        jest.useFakeTimers();
+        try {
+            const store = makeStore();
+            const api = jest.fn().mockRejectedValue(new Error('fetch failed'));
+            const result = await store.dispatch(
+                load({
+                    api: api as unknown as Api,
+                    abortController: undefined,
+                    conversationMode: true,
+                    page: 0,
+                    params: newState().params,
+                })
+            );
+            expect(result.type).toBe(load.rejected.type);
+            jest.advanceTimersByTime(1999);
+            expect(store.getState().elements.retry.count).toBe(0);
+            jest.advanceTimersByTime(1);
+            expect(store.getState().elements.retry.count).toBe(1);
+            expect(store.getState().elements.retry.error?.message).toBe('fetch failed');
+            expect(store.getState().elements.pendingRequest).toBe(false);
+        } finally {
+            jest.useRealTimers();
+        }
+    });
+});
