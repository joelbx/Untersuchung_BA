+class bestbook_award(delegate.page):
+    path = r'/works/OL(\d+)W/awards'
+    encoding = 'json'
+
+    def POST(self, work_id):
+        def response(payload):
+            return delegate.RawText(json.dumps(payload), content_type='application/json')
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        i = web.input(op=None, topic=None, comment='', edition_key=None)
+        username = user.key.split('/')[2]
+        if i.op not in ('add', 'remove', 'update'):
+            return response({'errors': 'Invalid operation'})
+
+        edition_id = None
+        if i.edition_key:
+            try:
+                edition_id = int(extract_numeric_id_from_olid(i.edition_key))
+            except (TypeError, ValueError, IndexError):
+                return response({'errors': 'Invalid edition key'})
+
+        try:
+            if i.op == 'remove':
+                return response({'success': True, 'rows': Bestbook.remove(username, work_id=work_id)})
+            if i.op == 'add':
+                award = Bestbook.add(username, work_id, i.topic, i.comment, edition_id)
+            else:
+                award = Bestbook.update(username, work_id, i.topic, i.comment, edition_id)
+            return response({'success': True, 'award': award})
+        except Bestbook.AwardConditionsError as exc:
+            return response({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = '/awards/count'
+    encoding = 'json'
+
+    def GET(self):
+        i = web.input(work_id=None, username=None, topic=None)
+        try:
+            count = Bestbook.get_count(
+                work_id=i.work_id, username=i.username, topic=i.topic
+            )
+        except (ValueError, TypeError):
+            return delegate.RawText(
+                json.dumps({'errors': 'Invalid work ID'}), content_type='application/json'
+            )
+        return delegate.RawText(
+            json.dumps({'count': count}), content_type='application/json'
+        )
+
