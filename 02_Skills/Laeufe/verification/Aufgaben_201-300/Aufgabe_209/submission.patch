diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..03ba9a4
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,96 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+import useGetCalendarActions from '../hooks/useGetCalendarActions';
+import useGetCalendarSetup from '../hooks/useGetCalendarSetup';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ loading: false, error: false })),
+}));
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ handleCreateCalendar: jest.fn() })),
+}));
+
+const mockedSetup = useGetCalendarSetup as jest.Mock;
+const mockedActions = useGetCalendarActions as jest.Mock;
+
+const renderModal = () => {
+    const view = render(<SubscribeCalendarModal isOpen onClose={jest.fn()} />);
+    const input = screen.getByLabelText('Calendar URL') as HTMLInputElement;
+    const submit = screen.getByRole('button', { name: 'Add calendar', hidden: true });
+    return { input, submit, rerender: view.rerender };
+};
+
+describe('SubscribeCalendarModal URL validation', () => {
+    beforeEach(() => {
+        mockedSetup.mockReturnValue({ loading: false, error: false });
+        mockedActions.mockReturnValue({ handleCreateCalendar: jest.fn() });
+    });
+
+    it('trims the URL and allows a valid URL at the length limit', () => {
+        const { input, submit } = renderModal();
+        expect(submit).toBeDisabled();
+
+        const url = `https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - 'https://example.com/'.length)}`;
+        fireEvent.change(input, { target: { value: ` ${url} ` } });
+
+        expect(input.value).toBe(url);
+        expect(submit).toBeEnabled();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+    });
+
+    it('blocks an overlong URL and shows its warning', () => {
+        const { input, submit } = renderModal();
+        fireEvent.change(input, {
+            target: { value: `https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}` },
+        });
+
+        expect(input.value.length).toBeGreaterThan(MAX_LENGTHS_API.CALENDAR_URL);
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+        fireEvent.submit(input.closest('form')!);
+        expect(mockedActions.mock.results[0].value.handleCreateCalendar).not.toHaveBeenCalled();
+    });
+
+    it('rejects malformed URLs and warns about Outlook links without .ics', () => {
+        const { input, submit } = renderModal();
+        fireEvent.change(input, { target: { value: 'not a URL' } });
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('Invalid URL')).toBeInTheDocument();
+
+        fireEvent.change(input, { target: { value: 'https://outlook.live.com/calendar' } });
+        expect(submit).toBeEnabled();
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+    });
+
+    it('prioritizes extension and Google public link warnings over length', () => {
+        const { input, submit } = renderModal();
+        fireEvent.change(input, {
+            target: { value: `https://calendar.google.com/public/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}` },
+        });
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(submit).toBeDisabled();
+
+        fireEvent.change(input, {
+            target: { value: `https://calendar.google.com/public/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}.ics` },
+        });
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(submit).toBeDisabled();
+    });
+
+    it('uses the same disabled state in the error flow', () => {
+        const { input, rerender } = renderModal();
+        fireEvent.change(input, {
+            target: { value: `https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}` },
+        });
+        mockedSetup.mockReturnValue({ loading: false, error: true });
+        rerender(<SubscribeCalendarModal isOpen onClose={jest.fn()} />);
+        expect(screen.getByRole('button', { name: 'Close', hidden: true })).toBeDisabled();
+    });
+});
