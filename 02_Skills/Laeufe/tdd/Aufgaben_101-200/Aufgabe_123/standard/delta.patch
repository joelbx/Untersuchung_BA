diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..edb31d0
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,128 @@
+import { render, screen } from '@testing-library/react';
+import createNotificationManager from './manager';
+import NotificationsContainer from './Container';
+import { NotificationOptions } from './interfaces';
+
+const noop = () => {};
+
+describe('notification content', () => {
+    it('renders sanitized HTML with secure links', () => {
+        render(
+            <NotificationsContainer
+                notifications={[
+                    {
+                        id: 1,
+                        key: 1,
+                        text: '<strong>Read</strong> <a href="https://example.com" target="_self" rel="opener">help</a><a href="javascript:alert(1)">unsafe</a><img src=x onerror=alert(1)>',
+                        type: 'error',
+                        isClosing: false,
+                    },
+                ]}
+                removeNotification={noop}
+                hideNotification={noop}
+            />
+        );
+        expect(screen.getByText('Read').tagName).toBe('STRONG');
+        const links = document.querySelectorAll('a');
+        expect(links[0]).toHaveAttribute('href', 'https://example.com');
+        links.forEach((link) => {
+            expect(link).toHaveAttribute('target', '_blank');
+            expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        });
+        expect(links[1]).not.toHaveAttribute('href');
+        expect(document.querySelector('[onerror]')).toBeNull();
+    });
+
+    it('preserves React element content', () => {
+        render(
+            <NotificationsContainer
+                notifications={[{ id: 1, key: 1, text: <button>Retry</button>, type: 'error', isClosing: false }]}
+                removeNotification={noop}
+                hideNotification={noop}
+            />
+        );
+        expect(screen.getByRole('button', { name: 'Retry' })).toBeInTheDocument();
+    });
+
+    it('secures links supplied as React elements', () => {
+        render(
+            <NotificationsContainer
+                notifications={[
+                    { id: 1, key: 1, text: <a href="https://example.com">Help</a>, type: 'info', isClosing: false },
+                ]}
+                removeNotification={noop}
+                hideNotification={noop}
+            />
+        );
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('target', '_blank');
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('renders repeated success messages without duplicate React keys', () => {
+        const consoleError = jest.spyOn(console, 'error').mockImplementation(() => {});
+        try {
+            render(
+                <NotificationsContainer
+                    notifications={[
+                        { id: 1, key: 'saved', text: 'saved', type: 'success', isClosing: false },
+                        { id: 2, key: 'saved', text: 'saved', type: 'success', isClosing: false },
+                    ]}
+                    removeNotification={noop}
+                    hideNotification={noop}
+                />
+            );
+            expect(screen.getAllByRole('alert')).toHaveLength(2);
+            expect(consoleError).not.toHaveBeenCalled();
+        } finally {
+            consoleError.mockRestore();
+        }
+    });
+});
+
+describe('notification deduplication', () => {
+    let notifications: NotificationOptions[];
+    let manager: ReturnType<typeof createNotificationManager>;
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        notifications = [];
+        manager = createNotificationManager((update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        });
+    });
+
+    afterEach(() => {
+        manager.clearNotifications();
+        jest.useRealTimers();
+    });
+
+    it('deduplicates non-success strings by text when key is omitted', () => {
+        manager.createNotification({ text: 'same', type: 'error' });
+        manager.createNotification({ text: 'same', type: 'info' });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('same');
+        expect(notifications[0].type).toBe('info');
+    });
+
+    it('uses an explicit key to deduplicate different content', () => {
+        manager.createNotification({ text: 'first', key: 'shared', type: 'error' });
+        manager.createNotification({ text: 'second', key: 'shared', type: 'warning' });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].text).toBe('second');
+        expect(notifications[0].key).toBe('shared');
+    });
+
+    it('uses the identifier as the key for React elements without an explicit key', () => {
+        manager.createNotification({ id: 20, text: <b>Same</b>, type: 'error' });
+        manager.createNotification({ id: 21, text: <b>Same</b>, type: 'error' });
+        expect(notifications.map(({ key }) => key)).toEqual([20, 21]);
+    });
+
+    it('allows identical success notifications and keeps them out of error deduplication', () => {
+        manager.createNotification({ text: 'same', type: 'success' });
+        manager.createNotification({ text: 'same', type: 'success' });
+        manager.createNotification({ text: 'same', type: 'error' });
+        expect(notifications).toHaveLength(3);
+        expect(notifications.map(({ type }) => type)).toEqual(['success', 'success', 'error']);
+    });
+});
