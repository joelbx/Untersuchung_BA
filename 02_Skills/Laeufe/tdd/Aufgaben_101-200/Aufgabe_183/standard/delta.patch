+func TestUbuntuLTSLifecycle(t *testing.T) {
+	tests := []struct {
+		name          string
+		release       string
+		standardUntil time.Time
+		extendedUntil time.Time
+		checkAt       time.Time
+		standardEnded bool
+		extendedEnded bool
+	}{
+		{
+			name:          "20.04 remains in extended support after standard support ends",
+			release:       "20.04",
+			standardUntil: time.Date(2025, 4, 1, 23, 59, 59, 0, time.UTC),
+			extendedUntil: time.Date(2030, 4, 1, 23, 59, 59, 0, time.UTC),
+			checkAt:       time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC),
+			standardEnded: true,
+			extendedEnded: false,
+		},
+		{
+			name:          "20.04 extended support ends after April 2030",
+			release:       "20.04",
+			standardUntil: time.Date(2025, 4, 1, 23, 59, 59, 0, time.UTC),
+			extendedUntil: time.Date(2030, 4, 1, 23, 59, 59, 0, time.UTC),
+			checkAt:       time.Date(2030, 4, 2, 0, 0, 0, 0, time.UTC),
+			standardEnded: true,
+			extendedEnded: true,
+		},
+		{
+			name:          "22.04 has standard support through April 2027",
+			release:       "22.04",
+			standardUntil: time.Date(2027, 4, 1, 23, 59, 59, 0, time.UTC),
+			extendedUntil: time.Date(2032, 4, 1, 23, 59, 59, 0, time.UTC),
+			checkAt:       time.Date(2027, 4, 1, 12, 0, 0, 0, time.UTC),
+			standardEnded: false,
+			extendedEnded: false,
+		},
+		{
+			name:          "22.04 remains in extended support after April 2027",
+			release:       "22.04",
+			standardUntil: time.Date(2027, 4, 1, 23, 59, 59, 0, time.UTC),
+			extendedUntil: time.Date(2032, 4, 1, 23, 59, 59, 0, time.UTC),
+			checkAt:       time.Date(2028, 1, 1, 0, 0, 0, 0, time.UTC),
+			standardEnded: true,
+			extendedEnded: false,
+		},
+		{
+			name:          "22.04 extended support ends after April 2032",
+			release:       "22.04",
+			standardUntil: time.Date(2027, 4, 1, 23, 59, 59, 0, time.UTC),
+			extendedUntil: time.Date(2032, 4, 1, 23, 59, 59, 0, time.UTC),
+			checkAt:       time.Date(2032, 4, 2, 0, 0, 0, 0, time.UTC),
+			standardEnded: true,
+			extendedEnded: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			eol, found := GetEOL(Ubuntu, tt.release)
+			if !found {
+				t.Fatalf("Ubuntu %s lifecycle not found", tt.release)
+			}
+			if !eol.StandardSupportUntil.Equal(tt.standardUntil) {
+				t.Errorf("standard support ends %s, want %s", eol.StandardSupportUntil, tt.standardUntil)
+			}
+			if !eol.ExtendedSupportUntil.Equal(tt.extendedUntil) {
+				t.Errorf("extended support ends %s, want %s", eol.ExtendedSupportUntil, tt.extendedUntil)
+			}
+			if got := eol.IsStandardSupportEnded(tt.checkAt); got != tt.standardEnded {
+				t.Errorf("standard support ended = %t, want %t", got, tt.standardEnded)
+			}
+			if got := eol.IsExtendedSuppportEnded(tt.checkAt); got != tt.extendedEnded {
+				t.Errorf("extended support ended = %t, want %t", got, tt.extendedEnded)
+			}
+		})
+	}
+}
