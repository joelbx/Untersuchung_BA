+def test_pending_batch_keeps_files_and_database_state_until_all_uploads_verified(
+    tmp_path, monkeypatch
+):
+    import sqlite3
+    import web
+    from openlibrary.coverstore import schema
+
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    dbfile = tmp_path / "covers.db"
+    with sqlite3.connect(dbfile) as connection:
+        connection.executescript(schema.get_schema("sqlite"))
+    database = web.database(dbn="sqlite", db=str(dbfile))
+    local = tmp_path / "localdisk"
+    local.mkdir()
+    filenames = {
+        "filename": "full.jpg",
+        "filename_s": "small.jpg",
+        "filename_m": "medium.jpg",
+        "filename_l": "large.jpg",
+    }
+    for filename in filenames.values():
+        (local / filename).write_bytes(b"cover")
+    database.insert(
+        "cover", id=8_010_042, archived=True, failed=False, uploaded=False, **filenames
+    )
+    monkeypatch.setattr(archive.db, "getdb", lambda: database)
+    for size in ("", "s", "m", "l"):
+        path = tmp_path / archive.Batch.get_relpath(8, 1, size)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with zipfile.ZipFile(path, "w") as zf:
+            zf.writestr("0008010042.jpg", b"cover")
+
+    class VerifiedUploader:
+        def __init__(self):
+            self.missing = {"m_covers_0008_01.zip"}
+
+        def is_uploaded(self, item, filename):
+            return filename not in self.missing
+
+    uploader = VerifiedUploader()
+    batch = archive.Batch(8, 1)
+    import pytest
+
+    with pytest.raises(RuntimeError, match="not verified"):
+        batch.process_pending(finalize=True, test=False, uploader=uploader)
+    assert database.select("cover")[0].uploaded == 0
+    assert all((local / name).exists() for name in filenames.values())
+    assert all(
+        (tmp_path / archive.Batch.get_relpath(8, 1, size)).exists()
+        for size in ("", "s", "m", "l")
+    )
+    uploader.missing.clear()
+    batch.process_pending(finalize=True, test=False, uploader=uploader)
+    assert database.select("cover")[0].uploaded == 1
+    assert all(not (local / name).exists() for name in filenames.values())
+    assert all(
+        not (tmp_path / archive.Batch.get_relpath(8, 1, size)).exists()
+        for size in ("", "s", "m", "l")
+    )
+
+
+def test_pending_batch_rejects_unarchived_cover_in_same_range(tmp_path, monkeypatch):
+    import sqlite3
+    import web
+    from openlibrary.coverstore import schema
+    import pytest
+
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    dbfile = tmp_path / "covers.db"
+    with sqlite3.connect(dbfile) as connection:
+        connection.executescript(schema.get_schema("sqlite"))
+    database = web.database(dbn="sqlite", db=str(dbfile))
+    database.insert("cover", id=8_010_042, archived=True, failed=False, uploaded=False)
+    database.insert("cover", id=8_010_043, archived=False, failed=False, uploaded=False)
+    monkeypatch.setattr(archive.db, "getdb", lambda: database)
+    path = tmp_path / archive.Batch.get_relpath(8, 1)
+    path.parent.mkdir(parents=True)
+    with zipfile.ZipFile(path, "w") as zf:
+        zf.writestr("0008010042.jpg", b"cover")
+
+    class VerifiedUploader:
+        def is_uploaded(self, item, filename):
+            return True
+
+    with pytest.raises(RuntimeError, match="unarchived"):
+        archive.Batch(8, 1).process_pending(
+            finalize=True, test=False, uploader=VerifiedUploader()
+        )
+    assert path.exists()
+    assert database.select("cover", where="id=8010042")[0].uploaded == 0
