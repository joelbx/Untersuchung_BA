+def archive(test=True):
+    """Stage unarchived covers; retain originals until all ZIPs are verified."""
+    database = db.getdb()
+    covers = database.select(
+        "cover",
+        where="archived=$no AND failed=$no",
+        order="id",
+        vars={"no": False},
+        limit=10_000,
+    )
+    for (item_id, batch_id), rows in groupby(
+        covers, key=lambda row: Cover.id_to_item_and_batch_id(row.id)
+    ):
+        with batch_lock(item_id, batch_id):
+            manager = ZipManager()
+            staged = []
+            try:
+                for row in rows:
+                    cover = Cover(row)
+                    files = []
+                    for size in SIZES:
+                        attr = "filename_" + size if size else "filename"
+                        source = getattr(cover, attr, None)
+                        path = source and os.path.join(
+                            config.data_root, "localdisk", source
+                        )
+                        if not path or not os.path.isfile(path):
+                            break
+                        name = (
+                            f'{int(cover.id):010d}{"-" + size.upper() if size else ""}.{os.path.splitext(source)[1].lstrip(".") or "jpg"}'
+                        )
+                        files.append((name, path))
+                    if len(files) != len(SIZES):
+                        if not test:
+                            database.update(
+                                "cover",
+                                where="id=$id AND archived=$no",
+                                vars={"id": cover.id, "no": False},
+                                failed=True,
+                            )
+                        continue
+                    created = cover.created
+                    if isinstance(created, str):
+                        from infogami.infobase.utils import parse_datetime
+
+                        created = parse_datetime(created)
+                    mtime = time.mktime(created.timetuple())
+                    for name, path in files:
+                        manager.add_file(name, path, mtime)
+                    staged.append(cover.id)
+            finally:
+                manager.close()
+            if not test:
+                for cover_id in staged:
+                    database.update(
+                        "cover",
+                        where="id=$id AND archived=$no",
+                        vars={"id": cover_id, "no": False},
+                        archived=True,
+                    )
