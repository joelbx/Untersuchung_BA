+import zipfile
+
+from openlibrary.coverstore import archive, config
+
+
+def test_cover_url_uses_padded_batch_and_size():
+    assert archive.Cover.id_to_item_and_batch_id(8_010_042) == ("0008", "01")
+    assert (
+        archive.Cover.get_cover_url(8_010_042, "s", protocol="https")
+        == (
+            "https://archive.org/download/s_covers_0008/s_covers_0008_01.zip/0008010042-S.jpg"
+        )
+    )
+
+
+def test_zip_manager_writes_uncompressed_deduplicated_batch(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    source = tmp_path / "image.jpg"
+    source.write_bytes(b"cover")
+    manager = archive.ZipManager()
+    manager.add_file("0008010042-S.jpg", str(source), 123)
+    manager.add_file("0008010042-S.jpg", str(source), 123)
+    manager.close()
+    path = tmp_path / "items/s_covers_0008/s_covers_0008_01.zip"
+    with zipfile.ZipFile(path) as zf:
+        assert zf.namelist() == ["0008010042-S.jpg"]
+        assert zf.read("0008010042-S.jpg") == b"cover"
+        assert zf.getinfo("0008010042-S.jpg").compress_type == zipfile.ZIP_STORED
+
+
+def test_batch_paths_are_zero_padded(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    batch = archive.Batch(8, 1, "m")
+    assert batch._norm_ids() == ("0008", "01")
+    assert batch.get_relpath(8, 1, "m") == "items/m_covers_0008/m_covers_0008_01.zip"
+    assert batch.get_abspath(8, 1, "m") == str(
+        tmp_path / "items/m_covers_0008/m_covers_0008_01.zip"
+    )
+
