+class Cover:
+    def __init__(self, attributes):
+        self.__dict__.update(attributes)
+
+    def local_path(self, size=""):
+        filename = getattr(self, "filename_" + size if size else "filename", None)
+        if (
+            not config.data_root
+            or not filename
+            or filename.startswith(("http://", "https://"))
+        ):
+            return None
+        root = os.path.abspath(os.path.join(config.data_root, "localdisk"))
+        path = os.path.abspath(os.path.join(root, filename))
+        return path if os.path.commonpath((root, path)) == root else None
+
+    def delete_file(self, size=""):
+        path = self.local_path(size)
+        if path and os.path.isfile(path):
+            os.remove(path)
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        number = int(cover_id)
+        if not 0 <= number < 10_000_000_000:
+            raise ValueError("cover ID must fit in ten digits")
+        padded = f"{number:010d}"
+        return padded[:4], padded[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size="", ext="jpg", protocol="https"):
+        size = _size(size)
+        if protocol not in ("http", "https"):
+            raise ValueError("invalid protocol")
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f"{size}_" if size else ""
+        item = f"{prefix}covers_{item_id}"
+        archive_name = f"{item}_{batch_id}.zip"
+        filename = f'{int(cover_id):010d}{f"-{size.upper()}" if size else ""}.{ext}'
+        return f"{protocol}://archive.org/download/{item}/{archive_name}/{filename}"
+
+
+class Batch:
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id = item_id
+        self.batch_id = batch_id
+        self.size = _size(size) if size is not None else None
+
+    def _norm_ids(self):
+        item_id, batch_id = int(self.item_id), int(self.batch_id)
+        if not 0 <= item_id <= 9999 or not 0 <= batch_id <= 99:
+            raise ValueError("item or batch ID outside fixed-width schema")
+        return f"{item_id:04d}", f"{batch_id:02d}"
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size="", ext="zip"):
+        size = _size(size)
+        item_id, batch_id = cls(item_id, batch_id)._norm_ids()
+        prefix = f"{size}_" if size else ""
+        item = f"{prefix}covers_{item_id}"
+        return os.path.join("items", item, f"{item}_{batch_id}.{ext}")
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size="", ext="zip"):
+        return os.path.join(
+            config.data_root, cls.get_relpath(item_id, batch_id, size, ext)
+        )
 
