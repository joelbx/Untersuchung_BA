+def test_completed_batch_updates_only_archived_nonfailed_covers(tmp_path, monkeypatch):
+    import web
+    from openlibrary.coverstore import schema
+
+    database = web.database(dbn="sqlite", db=str(tmp_path / "covers.db"))
+    import sqlite3
+
+    with sqlite3.connect(tmp_path / "covers.db") as connection:
+        connection.executescript(schema.get_schema("sqlite"))
+    for cover_id, archived, failed in [
+        (8_010_042, True, False),
+        (8_010_043, False, False),
+        (8_010_044, True, True),
+    ]:
+        database.insert(
+            "cover",
+            id=cover_id,
+            archived=archived,
+            failed=failed,
+            uploaded=False,
+            filename="local.jpg",
+        )
+    monkeypatch.setattr(archive.db, "getdb", lambda: database)
+    archive.CoverDB.update_completed_batch(8, 1)
+    rows = list(database.select("cover", order="id"))
+    assert rows[0].uploaded == 1
+    assert (
+        rows[0].filename
+        == "https://archive.org/download/covers_0008/covers_0008_01.zip/0008010042.jpg"
+    )
+    assert rows[0].filename_s.endswith("/0008010042-S.jpg")
+    assert rows[1].filename == rows[2].filename == "local.jpg"
+    assert rows[1].uploaded == rows[2].uploaded == 0
+
