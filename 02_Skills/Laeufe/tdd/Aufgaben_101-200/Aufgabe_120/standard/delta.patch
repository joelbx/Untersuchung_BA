+@contextmanager
+def batch_lock(item_id, batch_id):
+    """Serialize writers and finalizers for a batch on this coverserver."""
+    path = Batch.get_abspath(item_id, batch_id, ext="lock")
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "a+b") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock, fcntl.LOCK_UN)
