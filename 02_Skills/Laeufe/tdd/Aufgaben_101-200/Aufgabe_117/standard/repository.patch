+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Work around a QtWebEngine 5.15.3 bug on Linux where a missing locale
+    resource file can crash the network service. When enabled, use a
+    Chromium-compatible fallback locale if the current locale has no resource file.
+
