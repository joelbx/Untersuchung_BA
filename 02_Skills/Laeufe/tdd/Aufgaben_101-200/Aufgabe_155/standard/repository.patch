--- /dev/null
+++ b/config/image_digest_test.go
@@ -0,0 +1,48 @@
+package config
+
+import (
+	"testing"
+)
+
+func TestImageGetFullName(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		image Image
+		want  string
+	}{
+		{"tag", Image{Name: "registry/app", Tag: "v1"}, "registry/app:v1"},
+		{"digest", Image{Name: "registry/app", Digest: "sha256:abc"}, "registry/app@sha256:abc"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := tc.image.GetFullName()
+			if got != tc.want {
+				t.Fatalf("full image reference = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestIsValidImageIdentifier(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		image   Image
+		wantErr string
+	}{
+		{"missing name", Image{Tag: "v1"}, "Invalid arguments : no image name"},
+		{"missing identifier", Image{Name: "app"}, "Invalid arguments : no image tag and digest"},
+		{"ambiguous identifier", Image{Name: "app", Tag: "v1", Digest: "sha256:abc"}, "Invalid arguments : you can either set image tag or digest"},
+		{"tag", Image{Name: "app", Tag: "v1"}, ""},
+		{"digest", Image{Name: "app", Digest: "sha256:abc"}, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := IsValidImage(tc.image)
+			if tc.wantErr == "" {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+			} else if err == nil || err.Error() != tc.wantErr {
+				t.Fatalf("error = %v, want %q", err, tc.wantErr)
+			}
+		})
+	}
+}
