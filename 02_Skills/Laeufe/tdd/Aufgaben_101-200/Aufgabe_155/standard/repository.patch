diff --git a/scan/image_digest_test.go b/scan/image_digest_test.go
new file mode 100644
index 0000000..9262dd4
--- /dev/null
+++ b/scan/image_digest_test.go
@@ -0,0 +1,24 @@
+package scan
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestConvertToModelPreservesImageDigest(t *testing.T) {
+	s := &base{ServerInfo: config.ServerInfo{Image: config.Image{Name: "registry/app", Digest: "sha256:abc"}}}
+	got := s.convertToModel()
+	encoded, err := json.Marshal(got.Image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]string
+	if err := json.Unmarshal(encoded, &fields); err != nil {
+		t.Fatal(err)
+	}
+	if fields["name"] != "registry/app" || fields["digest"] != "sha256:abc" || fields["tag"] != "" {
+		t.Fatalf("converted image = %s", encoded)
+	}
+}
