+    def get_locally_reachable_ips(self, ip_path):
+        """Return the kernel's local routes, including host-scoped prefixes."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, flag, label in (('ipv4', '-4', 'IPv4'), ('ipv6', '-6', 'IPv6')):
+            command = [ip_path, flag, 'route', 'show', 'table', 'local', 'type', 'local']
+            try:
+                rc, output, stderr = self.module.run_command(command, errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Cannot gather locally reachable %s routes' % label)
+                continue
+
+            routes = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                try:
+                    route = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if route.version == (4 if family == 'ipv4' else 6):
+                    routes.add(route)
+            ordered = sorted(routes, key=lambda route: (int(route.network_address), route.prefixlen))
+            reachable[family] = [str(route.network_address) if route.prefixlen == route.max_prefixlen else str(route)
+                                 for route in ordered]
+        return reachable
+
