day, 23, 59, 59, 0, time.UTC)\n+\t\t\tif !eol.StandardSupportUntil.Equal(cutoff) {\n+\t\t\t\tt.Errorf(\"cutoff = %v, want %v\", eol.StandardSupportUntil, cutoff)\n+\t\t\t}\n+\t\t\tif eol.IsStandardSupportEnded(cutoff) || !eol.IsStandardSupportEnded(cutoff.Add(time.Second)) {\n+\t\t\t\tt.Error(\"incorrect support boundary\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestMacOS11EndedAndNewerReleasesFound(t *testing.T) {\n+\tfor _, release := range []string{\"11\", \"12\", \"13\", \"14\", \"15\"} {\n+\t\teol, found := GetEOL(constant.MacOS, release)\n+\t\tif !found {\n+\t\t\tt.Errorf(\"macOS %s not found\", release)\n+\t\t\tcontinue\n+\t\t}\n+\t\tif got, want := eol.IsStandardSupportEnded(time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)), release == \"11\"; got != want {\n+\t\t\tt.Errorf(\"macOS %s ended = %v, want %v\", release, got, want)\n+\t\t}\n+\t}\n+}\ndiff --git a/config/os_test.go b/config/os_test.go\nindex 58c2073..f2f88fe 100644\n--- a/config/os_test.go\n+++ b/config/os_test.go\n@@ -658,15 +658,15 @@ func TestEOL_IsStandardSupportEnded(t *testing.T) {\n \t\t{\n \t\t\tname:     \"Fedora 37 supported\",\n \t\t\tfields:   fields{family: Fedora, release: \"37\"},\n-\t\t\tnow:      time.Date(2023, 12, 15, 23, 59, 59, 0, time.UTC),\n+\t\t\tnow:      time.Date(2023, 12, 5, 23, 59, 59, 0, time.UTC),\n \t\t\tstdEnded: false,\n \t\t\textEnded: false,\n \t\t\tfound:    true,\n \t\t},\n \t\t{\n-\t\t\tname:     \"Fedora 37 eol since 2023-12-16\",\n+\t\t\tname:     \"Fedora 37 eol since 2023-12-06\",\n \t\t\tfields:   fields{family: Fedora, release: \"37\"},\n-\t\t\tnow:      time.Date(2023, 12, 16, 0, 0, 0, 0, time.UTC),\n+\t\t\tnow:      time.Date(2023, 12, 6, 0, 0, 0, 0, time.UTC),\n \t\t\tstdEnded: true,\n \t\t\textEnded: true,\n \t\t\tfound:    true,\n@@ -674,15 +674,15 @@ func TestEOL_IsStandardSupportEnded(t *testing.T) {\n \t\t{\n \t\t\tname:     \"Fedora 38 supported\",\n \t\t\tfields:   fields{family: Fedora, release: \"38\"},\n-\t\t\tnow:      time.Date(2024, 5, 14, 23