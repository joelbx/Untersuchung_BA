diff --git a/lib/utils/parse/ast.go b/lib/utils/parse/ast.go
new file mode 100644
index 0000000..200539c
--- /dev/null
+++ b/lib/utils/parse/ast.go
@@ -0,0 +1,329 @@
+package parse
+
+import (
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+	"github.com/vulcand/predicate"
+)
+
+type Expr interface {
+	String() string
+	Kind() reflect.Kind
+	Evaluate(EvaluateContext) (any, error)
+}
+
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string                        { return strconv.Quote(e.Value) }
+func (StringLitExpr) Kind() reflect.Kind                      { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) { return []string{e.Value}, nil }
+
+type VarExpr struct{ Namespace, Name string }
+
+func (e VarExpr) String() string   { return e.Namespace + "." + e.Name }
+func (VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("variable resolver is unavailable for %s", e.String())
+	}
+	return ctx.VarValue(e)
+}
+
+type EmailLocalExpr struct{ Input Expr }
+
+func (e EmailLocalExpr) String() string   { return "email.local(" + e.Input.String() + ")" }
+func (EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	vals, err := evalStrings(e.Input, ctx)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]string, 0, len(vals))
+	for _, v := range vals {
+		if v == "" {
+			return nil, trace.BadParameter("address is empty")
+		}
+		addr, err := mail.ParseAddress(v)
+		if err != nil {
+			return nil, trace.BadParameter("failed to parse address %q: %v", v, err)
+		}
+		parts := strings.SplitN(addr.Address, "@", 2)
+		if len(parts) != 2 || parts[0] == "" {
+			return nil, trace.BadParameter("could not find local part in %q", v)
+		}
+		out = append(out, parts[0])
+	}
+	return out, nil
+}
+
+type RegexpReplaceExpr struct {
+	Input                Expr
+	Pattern, Replacement string
+	re                   *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return "regexp.replace(" + e.Input.String() + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	vals, err := evalStrings(e.Input, ctx)
+	if err != nil {
+		return nil, err
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegex(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	out := make([]string, 0, len(vals))
+	for _, v := range vals {
+		if re.MatchString(v) {
+			out = append(out, re.ReplaceAllString(v, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string   { return "regexp.match(" + strconv.Quote(e.Pattern) + ")" }
+func (RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	var err error
+	if re == nil {
+		re, err = compileRegex(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	return "regexp.not_match(" + strconv.Quote(e.Pattern) + ")"
+}
+func (RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	v, err := (RegexpMatchExpr{Pattern: e.Pattern, re: e.re}).Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return !v.(bool), nil
+}
+
+func evalStrings(e Expr, ctx EvaluateContext) ([]string, error) {
+	if e.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %s", e.Kind())
+	}
+	v, err := e.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return v.([]string), nil
+}
+func compileRegex(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return re, nil
+}
+
+func buildVarExpr(parts []string) (interface{}, error) {
+	if len(parts) == 1 {
+		if !validNamespace(parts[0]) {
+			return nil, trace.BadParameter("unsupported namespace %q", parts[0])
+		}
+		return VarExpr{Namespace: parts[0]}, nil
+	}
+	if len(parts) != 2 {
+		return nil, trace.BadParameter("variable must have exactly two components: namespace.name")
+	}
+	if !validNamespace(parts[0]) {
+		return nil, trace.BadParameter("unsupported namespace %q", parts[0])
+	}
+	return VarExpr{Namespace: parts[0], Name: parts[1]}, nil
+}
+func buildVarExprFromProperty(base, key interface{}) (interface{}, error) {
+	v, ok := base.(VarExpr)
+	if !ok || v.Name != "" {
+		return nil, trace.BadParameter("variable must have exactly two components: namespace[\"name\"]")
+	}
+	name, ok := key.(string)
+	if !ok {
+		return nil, trace.BadParameter("variable index must be a quoted string")
+	}
+	v.Name = name
+	return v, nil
+}
+func validNamespace(ns string) bool {
+	return ns == "internal" || ns == "external" || ns == LiteralNamespace
+}
+func validateExpr(e Expr) error {
+	switch v := e.(type) {
+	case VarExpr:
+		if v.Name == "" {
+			return trace.BadParameter("variable %q is incomplete: expected namespace.name", v.Namespace)
+		}
+	case EmailLocalExpr:
+		return validateExpr(v.Input)
+	case RegexpReplaceExpr:
+		return validateExpr(v.Input)
+	}
+	return nil
+}
+func asExpr(v interface{}) (Expr, error) {
+	if e, ok := v.(Expr); ok {
+		return e, nil
+	}
+	if s, ok := v.(string); ok {
+		return StringLitExpr{Value: s}, nil
+	}
+	return nil, trace.BadParameter("expected string expression, got %T", v)
+}
+func stringArg(v interface{}) (Expr, error) {
+	e, err := asExpr(v)
+	if err != nil {
+		return nil, err
+	}
+	if e.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %s", e.Kind())
+	}
+	return e, nil
+}
+func constString(v interface{}) (string, error) {
+	s, ok := v.(string)
+	if !ok {
+		return "", trace.BadParameter("expected quoted constant string, got %T", v)
+	}
+	return s, nil
+}
+func parse(exprStr string) (Expr, error) {
+	if len(exprStr) > 16384 {
+		return nil, trace.BadParameter("expression exceeds maximum length")
+	}
+	depth := 0
+	quoted := false
+	escaped := false
+	for _, r := range exprStr {
+		if quoted {
+			if escaped {
+				escaped = false
+			} else if r == '\\' {
+				escaped = true
+			} else if r == '"' {
+				quoted = false
+			}
+			continue
+		}
+		if r == '"' {
+			quoted = true
+		} else if r == '(' || r == '[' {
+			depth++
+			if depth > 128 {
+				return nil, trace.BadParameter("expression exceeds maximum depth")
+			}
+		} else if r == ')' || r == ']' {
+			depth--
+		}
+	}
+	p, err := predicate.NewParser(predicate.Def{GetIdentifier: buildVarExpr, GetProperty: buildVarExprFromProperty, Functions: map[string]interface{}{
+		"email.local": func(args ...interface{}) (interface{}, error) {
+			if len(args) != 1 {
+				return nil, trace.BadParameter("email.local expected 1 argument, got %d", len(args))
+			}
+			e, err := stringArg(args[0])
+			if err != nil {
+				return nil, err
+			}
+			return EmailLocalExpr{Input: e}, nil
+		},
+		"regexp.replace": func(args ...interface{}) (interface{}, error) {
+			if len(args) != 3 {
+				return nil, trace.BadParameter("regexp.replace expected 3 arguments, got %d", len(args))
+			}
+			e, err := stringArg(args[0])
+			if err != nil {
+				return nil, err
+			}
+			pattern, err := constString(args[1])
+			if err != nil {
+				return nil, err
+			}
+			replacement, err := constString(args[2])
+			if err != nil {
+				return nil, err
+			}
+			re, err := compileRegex(pattern)
+			if err != nil {
+				return nil, err
+			}
+			return RegexpReplaceExpr{Input: e, Pattern: pattern, Replacement: replacement, re: re}, nil
+		},
+		"regexp.match": func(args ...interface{}) (interface{}, error) {
+			if len(args) != 1 {
+				return nil, trace.BadParameter("regexp.match expected 1 argument, got %d", len(args))
+			}
+			pattern, err := constString(args[0])
+			if err != nil {
+				return nil, err
+			}
+			re, err := compileRegex(pattern)
+			if err != nil {
+				return nil, err
+			}
+			return RegexpMatchExpr{Pattern: pattern, re: re}, nil
+		},
+		"regexp.not_match": func(args ...interface{}) (interface{}, error) {
+			if len(args) != 1 {
+				return nil, trace.BadParameter("regexp.not_match expected 1 argument, got %d", len(args))
+			}
+			pattern, err := constString(args[0])
+			if err != nil {
+				return nil, err
+			}
+			re, err := compileRegex(pattern)
+			if err != nil {
+				return nil, err
+			}
+			return RegexpNotMatchExpr{Pattern: pattern, re: re}, nil
+		},
+	}})
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	v, err := p.Parse(exprStr)
+	if err != nil {
+		return nil, trace.BadParameter("invalid expression %q: %v", exprStr, err)
+	}
+	e, ok := v.(Expr)
+	if !ok {
+		return nil, trace.BadParameter("expected variable or function expression, got %T", v)
+	}
+	if err := validateExpr(e); err != nil {
+		return nil, err
+	}
+	return e, nil
+}
