@@ -0,0 +1,55 @@
+package parse
+
+import (
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestNestedExpressionAndValidation(t *testing.T) {
+	expr, err := NewExpression(`pre-{{regexp.replace(email.local(external.email), "^([^+]+).*$", "$1")}}-post`)
+	require.NoError(t, err)
+	values, err := expr.Interpolate(map[string][]string{"email": {"alice+tag@example.com", "bob@example.com"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"pre-alice-post", "pre-bob-post"}, values)
+}
+
+func TestInvalidVariableShapes(t *testing.T) {
+	for _, input := range []string{`{{internal}}`, `{{internal.foo.bar}}`, `{{internal.foo["bar"]}}`, `{{"asdf"}}`, `{{123}}`, `{{other.foo}}`} {
+		_, err := NewExpression(input)
+		require.True(t, trace.IsBadParameter(err), "%s: %v", input, err)
+	}
+}
+
+func TestConstantReplaceAndMatcher(t *testing.T) {
+	expr, err := NewExpression(`{{regexp.replace("foo-42", "^foo-", "bar-")}}`)
+	require.NoError(t, err)
+	got, err := expr.Interpolate(nil)
+	require.NoError(t, err)
+	require.Equal(t, []string{"bar-42"}, got)
+	matcher, err := NewMatcher(`pre-{{regexp.not_match("bad")}}-post`)
+	require.NoError(t, err)
+	require.True(t, matcher.Match("pre-good-post"))
+	require.False(t, matcher.Match("pre-bad-post"))
+}
+
+func TestQuotedRegexBracesInsideTemplate(t *testing.T) {
+	matcher, err := NewMatcher(`{{regexp.match("^[a-z]{2}$")}}`)
+	require.NoError(t, err)
+	require.True(t, matcher.Match("ab"))
+	require.False(t, matcher.Match("abc"))
+}
+
+func TestFunctionArityErrorNamesFunction(t *testing.T) {
+	_, err := NewExpression(`{{email.local(external.email, "extra")}}`)
+	require.True(t, trace.IsBadParameter(err), "%v", err)
+	require.Contains(t, err.Error(), "email.local")
+	require.Contains(t, err.Error(), "expected 1 argument")
+}
+
+func TestPlainMatcherQuotesSingleBraces(t *testing.T) {
+	matcher, err := NewMatcher("item{one}")
+	require.NoError(t, err)
+	require.True(t, matcher.Match("item{one}"))
+	require.False(t, matcher.Match("itemone"))
+}
