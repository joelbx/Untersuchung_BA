index 0000000..61ae9f7
--- /dev/null
+++ b/lib/backend/dynamo/billing_test.go
@@ -0,0 +1,88 @@
+package dynamo
+
+import (
+	"context"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbiface"
+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type billingTestDynamo struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+}
+
+func (f *billingTestDynamo) CreateTableWithContext(_ context.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	f.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (f *billingTestDynamo) WaitUntilTableExistsWithContext(context.Context, *dynamodb.DescribeTableInput, ...request.WaiterOption) error {
+	return nil
+}
+
+func (f *billingTestDynamo) DescribeTableWithContext(context.Context, *dynamodb.DescribeTableInput, ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return f.describeOutput, nil
+}
+
+func TestCreateTableUsesOnDemandByDefault(t *testing.T) {
+	cfg := Config{TableName: "test", ReadCapacityUnits: 12, WriteCapacityUnits: 34}
+	require.NoError(t, cfg.CheckAndSetDefaults())
+	fake := &billingTestDynamo{}
+	b := &Backend{Entry: log.NewEntry(log.New()), Config: cfg, svc: fake}
+	require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+	require.Equal(t, aws.String(dynamodb.BillingModePayPerRequest), fake.createInput.BillingMode)
+	require.Nil(t, fake.createInput.ProvisionedThroughput)
+}
+
+func TestCreateTableUsesProvisionedCapacity(t *testing.T) {
+	cfg := Config{TableName: "test", BillingMode: "provisioned", ReadCapacityUnits: 12, WriteCapacityUnits: 34, EnableAutoScaling: true}
+	require.NoError(t, cfg.CheckAndSetDefaults())
+	fake := &billingTestDynamo{}
+	b := &Backend{Entry: log.NewEntry(log.New()), Config: cfg, svc: fake}
+	require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+	require.Equal(t, aws.String(dynamodb.BillingModeProvisioned), fake.createInput.BillingMode)
+	require.Equal(t, int64(12), aws.Int64Value(fake.createInput.ProvisionedThroughput.ReadCapacityUnits))
+	require.Equal(t, int64(34), aws.Int64Value(fake.createInput.ProvisionedThroughput.WriteCapacityUnits))
+	require.True(t, b.EnableAutoScaling)
+}
+
+func TestBillingModeRejectsUnknownValue(t *testing.T) {
+	cfg := Config{TableName: "test", BillingMode: "unknown"}
+	require.Error(t, cfg.CheckAndSetDefaults())
+}
+
+func TestTableStatusReturnsBillingMode(t *testing.T) {
+	fake := &billingTestDynamo{describeOutput: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+		BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+	}}}
+	b := &Backend{svc: fake}
+	status, billingMode, err := b.getTableStatus(context.Background(), "test")
+	require.NoError(t, err)
+	require.Equal(t, tableStatus(tableStatusOK), status)
+	require.Equal(t, dynamodb.BillingModePayPerRequest, billingMode)
+}
+
+func TestOnDemandTableDisablesAutoScaling(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		status      tableStatus
+		billingMode string
+		configured  string
+	}{
+		{name: "existing", status: tableStatusOK, billingMode: dynamodb.BillingModePayPerRequest, configured: "provisioned"},
+		{name: "missing", status: tableStatusMissing, configured: "pay_per_request"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{BillingMode: tc.configured, EnableAutoScaling: true}}
+			b.disableAutoScalingForOnDemand(tc.status, tc.billingMode)
+			require.False(t, b.EnableAutoScaling)
+		})
+	}
+}
