--- a/lib/ansible/module_utils/facts/hardware/linux.py
+++ b/lib/ansible/module_utils/facts/hardware/linux.py
@@ -408,8 +408,36 @@ class LinuxHardware(Hardware):
                 else:
                     dmi_facts[k] = 'NA'
 
+        dmi_facts.update(self.get_sysinfo_facts())
         return dmi_facts
 
+    def get_sysinfo_facts(self):
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer:': 'system_vendor',
+            'Type:': 'product_name',
+            'Sequence Code:': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            for prefix, fact in fields.items():
+                if line.startswith(prefix):
+                    value = line[len(prefix):].strip()
+                    if fact == 'product_serial':
+                        value = value.lstrip('0') or '0'
+                    sysinfo_facts[fact] = value
+                    break
+
+        return sysinfo_facts
+
     def _run_lsblk(self, lsblk_path):
