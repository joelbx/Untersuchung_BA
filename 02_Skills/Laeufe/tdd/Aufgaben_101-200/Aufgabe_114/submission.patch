+func commonDirectory(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	common := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		for {
+			rel, err := filepath.Rel(common, dir)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			parent := filepath.Dir(common)
+			if parent == common {
+				return ""
+			}
+			common = parent
+		}
+	}
+	return common
+}
+
+func fromArtistFolder(folders ...string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		previous := ""
+		for _, folder := range folders {
+			if folder == "" || folder == previous {
+				continue
+			}
+			previous = folder
+			files, err := filepath.Glob(filepath.Join(folder, "artist.*"))
+			if err != nil {
+				return nil, "", err
+			}
+			for _, file := range files {
+				f, err := os.Open(file)
+				if err != nil {
+					continue
+				}
+				info, err := f.Stat()
+				if err == nil && info.Mode().IsRegular() {
+					return f, file, nil
+				}
+				f.Close()
+			}
+		}
+		return nil, "", nil
+	}
+}
