@@ -0,0 +1,63 @@
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+describe('assistant markdown conversion', () => {
+    it('moves a sibling nested list inside the preceding list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+        fixNestedLists(dom);
+        expect(dom.body.innerHTML).toBe('<ul><li>Parent<ul><li>Child</li></ul></li></ul>');
+    });
+
+    it('moves an adjacent list inside a list item even when the parent is not a list', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<li>Parent</li><ol><li>Child</li></ol>';
+        fixNestedLists(dom);
+        expect(dom.body.innerHTML).toBe('<li>Parent<ol><li>Child</li></ol></li>');
+    });
+
+    it('keeps nested and numbered list markers in markdown', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First<ul><li>Child</li></ul></li><li>Second</li></ol>';
+        const markdown = htmlToMarkdown(dom);
+        expect(markdown).toMatch(/1\. First/);
+        expect(markdown).toMatch(/\n\s+- Child/);
+        expect(markdown).toMatch(/2\. Second/);
+    });
+
+    it('renders markdown lists as nested HTML lists', () => {
+        const html = markdownToHTML('1. First\n   - Child\n2. Second');
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = html;
+        expect(dom.querySelector('ol > li > ul > li')?.textContent).toBe('Child');
+    });
+
+    it('keeps following ordered items outside the nested list on round trip', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First<ul><li>Child</li></ul></li><li>Second</li></ol>';
+        const html = markdownToHTML(htmlToMarkdown(dom));
+        const output = document.implementation.createHTMLDocument();
+        output.body.innerHTML = html;
+        expect(output.querySelectorAll('body > ol > li')).toHaveLength(2);
+        expect(output.querySelector('body > ol > li:nth-child(2)')?.textContent).toBe('Second');
+    });
+
+    it('keeps class and style on links and images through conversion', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<a href="#1" class="accent" style="color: red">Link</a><img src="#2" class="photo" style="width: 20px">';
+        const html = markdownToHTML(htmlToMarkdown(dom));
+        const output = document.implementation.createHTMLDocument();
+        output.body.innerHTML = html;
+        expect(output.querySelector('a')?.getAttribute('class')).toBe('accent');
+        expect(output.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(output.querySelector('img')?.getAttribute('class')).toBe('photo');
+        expect(output.querySelector('img')?.getAttribute('style')).toBe('width: 20px');
+    });
+
+    it('renders fenced code without changing its internal indentation', () => {
+        const html = markdownToHTML('```\n  indented\n```');
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = html;
+        expect(dom.querySelector('pre > code')?.textContent).toBe('  indented\n');
+    });
+});
