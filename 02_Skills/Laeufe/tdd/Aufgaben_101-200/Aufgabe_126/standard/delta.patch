+import { prepareContentToModel } from './input';
+import { parseModelResult } from './result';
+
+describe('assistant content round trip', () => {
+    it('retains formatted links and images for their originating message', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://example.com" class="accent" style="color: red">Link</a><img src="https://example.com/a.png" class="photo" style="width: 20px">',
+            'uid',
+            'message-1'
+        );
+        const html = parseModelResult(markdown, 'message-1');
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = html;
+        expect(dom.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+        expect(dom.querySelector('a')?.getAttribute('class')).toBe('accent');
+        expect(dom.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(dom.querySelector('img')?.getAttribute('src')).toBe('https://example.com/a.png');
+        expect(dom.querySelector('img')?.getAttribute('class')).toBe('photo');
+        expect(dom.querySelector('img')?.getAttribute('style')).toBe('width: 20px');
+    });
+
+    it('keeps link text but drops embedded content when rendered for another message', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://example.com">Link</a><img src="https://example.com/a.png">',
+            'uid',
+            'message-1'
+        );
+        const html = parseModelResult(markdown, 'message-2');
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = html;
+        expect(dom.querySelectorAll('a, img')).toHaveLength(0);
+        expect(dom.body.textContent).toContain('Link');
+    });
+});
