+import { renderHook } from '@testing-library/react-hooks';
+import { createElement } from 'react';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+import { EventManager } from '@proton/shared/lib/eventManager/eventManager';
+
+import EventManagerContext from '../../containers/eventManager/context';
+import { usePollEvents } from './usePollEvents';
+
+const setup = () => {
+    const call = jest.fn().mockResolvedValue(undefined);
+    const unsubscribe = jest.fn();
+    let handler: (event: any) => void = () => {};
+    const subscribe = jest.fn((listener) => {
+        handler = listener;
+        return unsubscribe;
+    });
+    const manager = { call, subscribe } as unknown as EventManager;
+    const { result } = renderHook(() => usePollEvents(), {
+        wrapper: (props: any) => createElement(EventManagerContext.Provider, { value: manager }, props.children),
+    });
+    return { poll: result.current, call, subscribe, unsubscribe, emit: (event: any) => handler(event) };
+};
+
+beforeEach(() => jest.useFakeTimers());
+afterEach(() => {
+    jest.clearAllTimers();
+    jest.useRealTimers();
+});
+
+// Removing the delay or the attempt bound would make this fail.
+it('calls the event manager five times at 5000 ms intervals and completes', async () => {
+    const { poll, call, subscribe } = setup();
+    const done = poll();
+
+    expect(call).toHaveBeenCalledTimes(0);
+    for (let attempt = 1; attempt <= 5; attempt++) {
+        jest.advanceTimersByTime(4999);
+        expect(call).toHaveBeenCalledTimes(attempt - 1);
+        jest.advanceTimersByTime(1);
+        await Promise.resolve();
+        expect(call).toHaveBeenCalledTimes(attempt);
+    }
+    await done;
+    jest.advanceTimersByTime(5000);
+    expect(call).toHaveBeenCalledTimes(5);
+    expect(subscribe).not.toHaveBeenCalled();
+});
+
+// Ignoring the property or action, or failing to clean up, would make this fail.
+it('continues for unrelated events and stops on the matching property and action', async () => {
+    const { poll, call, subscribe, unsubscribe, emit } = setup();
+    const done = poll('PaymentMethods', EVENT_ACTIONS.CREATE);
+    expect(subscribe).toHaveBeenCalledTimes(1);
+
+    emit({ Subscriptions: [{ Action: EVENT_ACTIONS.CREATE }] });
+    emit({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+    jest.advanceTimersByTime(5000);
+    await Promise.resolve();
+    expect(call).toHaveBeenCalledTimes(1);
+
+    emit({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await done;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    emit({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    jest.advanceTimersByTime(20000);
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+// Missing cleanup at the attempt limit would make this fail.
+it('unsubscribes after five attempts and ignores late events', async () => {
+    const { poll, call, unsubscribe, emit } = setup();
+    const done = poll('PaymentMethods', EVENT_ACTIONS.CREATE);
+    for (let attempt = 0; attempt < 5; attempt++) {
+        jest.advanceTimersByTime(5000);
+        await Promise.resolve();
+    }
+    await done;
+    expect(call).toHaveBeenCalledTimes(5);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    emit({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    jest.advanceTimersByTime(5000);
+    expect(call).toHaveBeenCalledTimes(5);
+});
