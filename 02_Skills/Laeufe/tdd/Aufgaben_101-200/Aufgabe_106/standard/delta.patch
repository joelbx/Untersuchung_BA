+func TestFillWordPressUsesServerIgnoreInactiveSetting(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+
+	for _, tt := range []struct {
+		name           string
+		ignoreInactive bool
+		globalIgnore   bool
+		wantInactive   bool
+	}{
+		{"ignore inactive for this server", true, false, false},
+		{"scan inactive for this server", false, true, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf.WpIgnoreInactive = tt.globalIgnore
+			config.Conf.Servers = map[string]config.ServerInfo{
+				"wordpress-test": {WordPress: config.WordPressConf{IgnoreInactive: tt.ignoreInactive}},
+			}
+			r := &models.ScanResult{
+				ServerName: "wordpress-test",
+				WordPressPackages: &models.WordPressPackages{
+					{Name: "core", Type: models.WPCore, Version: "6.0"},
+					{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+					{Name: "inactive-plugin", Type: models.WPPlugin, Status: "inactive", Version: "1.0"},
+					{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0"},
+					{Name: "inactive-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+				},
+				ScannedCves: models.VulnInfos{},
+			}
+			cache := map[string]*string{
+				"60":              cacheValue(`{}`),
+				"active-plugin":   cacheValue(`{"active-plugin":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`),
+				"inactive-plugin": cacheValue(`{"inactive-plugin":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`),
+				"active-theme":    cacheValue(`{"active-theme":{"vulnerabilities":[{"id":3,"fixed_in":"2.0"}]}}`),
+				"inactive-theme":  cacheValue(`{"inactive-theme":{"vulnerabilities":[{"id":4,"fixed_in":"2.0"}]}}`),
+			}
+			count, err := FillWordPress(r, "unused", cache)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantCount := 2
+			if tt.wantInactive {
+				wantCount = 4
+			}
+			if count != wantCount || len(r.ScannedCves) != wantCount {
+				t.Fatalf("got count=%d CVEs=%d, want %d", count, len(r.ScannedCves), wantCount)
+			}
+			for _, id := range []string{"WPVDBID-1", "WPVDBID-3"} {
+				if _, ok := r.ScannedCves[id]; !ok {
+					t.Errorf("active package CVE %s missing", id)
+				}
+			}
+			for _, id := range []string{"WPVDBID-2", "WPVDBID-4"} {
+				_, ok := r.ScannedCves[id]
+				if ok != tt.wantInactive {
+					t.Errorf("inactive package CVE %s presence = %v, want %v", id, ok, tt.wantInactive)
+				}
+			}
+		})
+	}
+}
