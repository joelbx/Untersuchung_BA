+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/package-url/packageurl-go"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestLibraryPackagePURLNameParts(t *testing.T) {
+	tests := []struct {
+		typeName, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"pom", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pip", "My_Package", "", "my-package", ""},
+		{"gomod", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"cargo", "serde", "", "serde", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typeName, func(t *testing.T) {
+			scanner := models.LibraryScanner{
+				Type: ftypes.LangType(tt.typeName), LockfilePath: "lockfile",
+				Libs: []models.Library{{Name: tt.input, Version: "1.0"}},
+			}
+			refs := map[string]map[string]string{"lockfile": {}}
+			components := libpkgToCdxComponents(scanner, refs)
+			got, err := packageurl.FromString(components[1].PackageURL)
+			if err != nil {
+				t.Fatalf("invalid PURL %q: %v", components[1].PackageURL, err)
+			}
+			if got.Namespace != tt.namespace || got.Name != tt.name || got.Subpath != tt.subpath {
+				t.Errorf("PURL parts = (%q, %q, %q), want (%q, %q, %q)", got.Namespace, got.Name, got.Subpath, tt.namespace, tt.name, tt.subpath)
+			}
+			if refs["lockfile"][tt.input] != components[1].PackageURL {
+				t.Errorf("package reference does not match component PURL")
+			}
+		})
+	}
+}
+
+func TestGitHubPackagePURLNameParts(t *testing.T) {
+	manifest := models.DependencyGraphManifest{
+		Filename: "package-lock.json", Repository: "example/repo",
+		Dependencies: []models.Dependency{{PackageName: "@babel/core", Requirements: "= 1.0"}},
+	}
+	refs := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+	components := ghpkgToCdxComponents(manifest, refs)
+	got, err := packageurl.FromString(components[1].PackageURL)
+	if err != nil {
+		t.Fatalf("invalid PURL %q: %v", components[1].PackageURL, err)
+	}
+	if got.Namespace != "@babel" || got.Name != "core" || got.Subpath != "" {
+		t.Errorf("PURL parts = (%q, %q, %q), want (@babel, core, empty)", got.Namespace, got.Name, got.Subpath)
+	}
+}
