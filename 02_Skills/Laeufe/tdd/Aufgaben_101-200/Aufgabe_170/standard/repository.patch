+def add_db_name(rec: dict) -> None:
+    """Add a name with available dates to each author in place."""
+    for author in rec.get('authors') or []:
+        date = author.get('date')
+        if not date and ('birth_date' in author or 'death_date' in author):
+            date = f"{author.get('birth_date') or ''}-{author.get('death_date') or ''}"
+        author['db_name'] = f"{author['name']} {date}" if date else author['name']
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare an imported or existing edition."""
+    title = rec.get('title') or rec.get('full_title') or ''
+    if rec.get('title') and rec.get('subtitle'):
+        title += ' ' + rec['subtitle']
+    if 'title' in rec:
+        rec['full_title'] = title
+    expanded = build_titles(title)
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        expanded['isbn'].extend(rec.get(field) or [])
+    if rec.get('publish_country') not in (None, '   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in (
+        'lccn', 'publishers', 'publish_date', 'number_of_pages', 'authors', 'contribs'
+    ):
+        if field in rec and rec[field] is not None:
+            expanded[field] = rec[field]
+    add_db_name(expanded)
+    if expanded.get('contribs'):
+        add_db_name({'authors': expanded['contribs']})
+    return expanded
+
+
