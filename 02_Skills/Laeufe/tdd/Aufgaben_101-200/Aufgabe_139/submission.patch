+def supplement_rec_with_import_item_metadata(
+    rec: dict[str, Any], identifier: str
+) -> None:
+    """Fill absent metadata from a staged or pending import item in place."""
+    from openlibrary.core.imports import ImportItem
+
+    try:
+        import_item = ImportItem.find_staged_or_pending([identifier]).first()
+        if not import_item:
+            return
+        metadata = json.loads(import_item.get('data', '{}'))
+        for field in (
+            'authors', 'isbn_10', 'isbn_13', 'number_of_pages',
+            'physical_format', 'publish_date', 'publishers', 'title',
+        ):
+            if not rec.get(field) and metadata.get(field):
+                rec[field] = metadata[field]
+    except Exception:
+        logger.exception('Failed to supplement import record for %s', identifier)
+
+
+def augment_incomplete_record(rec: dict[str, Any]) -> None:
+    from openlibrary.catalog.utils import get_non_isbn_asin
+    from openlibrary.plugins.importapi.import_validator import is_complete_record
+
+    if rec.get('publishers') == ['????']:
+        rec.pop('publishers')
+    if rec.get('authors') == [{'name': '????'}]:
+        rec.pop('authors')
+    if rec.get('publish_date') == '????':
+        rec.pop('publish_date')
+    if is_complete_record(rec):
+        return
+    isbn_10 = rec.get('isbn_10') or []
+    identifier = isbn_10[0] if isbn_10 else get_non_isbn_asin(rec)
+    if identifier:
+        supplement_rec_with_import_item_metadata(rec, identifier)
+
