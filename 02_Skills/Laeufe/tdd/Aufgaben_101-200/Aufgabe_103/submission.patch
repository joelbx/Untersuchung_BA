new file mode 100644
index 0000000..131ff74
--- /dev/null
+++ b/scanner/redhatbase_empty_release_test.go
@@ -0,0 +1,109 @@
+package scanner
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/logging"
+	"github.com/future-architect/vuls/models"
+)
+
+// A package with an empty release must keep its architecture and source RPM in place.
+func TestParseInstalledPackagesEmptyRelease(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Alma, Release: "9.0"}, log: logging.NewIODiscardLogger()}}
+	bins, srcs, err := o.parseInstalledPackages("package 0 1.2  x86_64 package-1.2-.src.rpm\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := (models.Package{Name: "package", Version: "1.2", Arch: "x86_64"}); !reflect.DeepEqual(bins["package"], want) {
+		t.Fatalf("binary = %+v, want %+v", bins["package"], want)
+	}
+	if want := (models.SrcPackage{Name: "package", Version: "1.2", Arch: "src", BinaryNames: []string{"package"}}); !reflect.DeepEqual(srcs["package"], want) {
+		t.Fatalf("source = %+v, want %+v", srcs["package"], want)
+	}
+}
+
+func TestParseAmazon2InstalledPackagesEmptyReleaseWithModularity(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2 (Karoo)"}, log: logging.NewIODiscardLogger()}}
+	bins, _, err := o.parseInstalledPackages("package 0 1.2  x86_64 package-1.2-.src.rpm module:stream:1:hash\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := bins["package"]; got.Release != "" || got.ModularityLabel != "module:stream:1:hash" || got.Repository != "" {
+		t.Fatalf("package = %+v", got)
+	}
+}
+
+func TestParseInstalledPackageLinesEmptyRelease(t *testing.T) {
+	for _, tc := range []struct {
+		name, line, version, sourceVersion, repository string
+		repoquery                                      bool
+	}{
+		{"rpm zero epoch", "package 0 1.2  x86_64 package-1.2-.src.rpm", "1.2", "1.2", "", false},
+		{"rpm nonzero epoch", "package 2 1.2  x86_64 package-1.2-.src.rpm", "2:1.2", "2:1.2", "", false},
+		{"repoquery none epoch", "package (none) 1.2  x86_64 package-1.2-.src.rpm @amzn2-core", "1.2", "1.2", "amzn2-core", true},
+		{"repoquery nonzero epoch", "package 2 1.2  x86_64 package-1.2-.src.rpm installed", "2:1.2", "2:1.2", "amzn2-core", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var bin *models.Package
+			var src *models.SrcPackage
+			var err error
+			if tc.repoquery {
+				bin, src, err = o.parseInstalledPackagesLineFromRepoquery(tc.line)
+			} else {
+				bin, src, err = o.parseInstalledPackagesLine(tc.line)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if bin == nil || bin.Name != "package" || bin.Version != tc.version || bin.Release != "" || bin.Arch != "x86_64" || bin.Repository != tc.repository {
+				t.Fatalf("binary = %+v", bin)
+			}
+			if src == nil || src.Name != "package" || src.Version != tc.sourceVersion || src.Arch != "src" {
+				t.Fatalf("source = %+v", src)
+			}
+		})
+	}
+}
+
+func TestSplitFileNameSourceSuffixAndMalformedNames(t *testing.T) {
+	for _, tc := range []struct {
+		filename, name, version, release, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src"},
+		{"package-0--src.rpm", "package", "0", "", "src"},
+		{"package-0-1-extra.src.rpm", "package", "0", "1-extra", "src"},
+	} {
+		t.Run(tc.filename, func(t *testing.T) {
+			name, version, release, _, arch, err := splitFileName(tc.filename)
+			if err != nil || name != tc.name || version != tc.version || release != tc.release || arch != tc.arch {
+				t.Fatalf("got %q %q %q %q, err %v", name, version, release, arch, err)
+			}
+		})
+	}
+	for _, filename := range []string{"-0-1.src.rpm", "package--1.src.rpm", "package-0-1..rpm", "package-0-1.src", "package-0--1.src.rpm", "package--part-0-1.src.rpm"} {
+		t.Run(filename, func(t *testing.T) {
+			if _, _, _, _, _, err := splitFileName(filename); err == nil {
+				t.Fatalf("accepted malformed filename %q", filename)
+			}
+		})
+	}
+}
+
+func TestParseUpdatablePacksLinesEmptyReleaseAndEpoch(t *testing.T) {
+	o := &redhatBase{}
+	got, err := o.parseUpdatablePacksLines("Loading repositories\ncentos (none) 1.2  updates\namazon 3 2.4 5.amzn2 amzn2-core\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := models.NewPackages(
+		models.Package{Name: "centos", NewVersion: "1.2", NewRelease: "", Repository: "updates"},
+		models.Package{Name: "amazon", NewVersion: "3:2.4", NewRelease: "5.amzn2", Repository: "amzn2-core"},
+	)
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("updates = %+v, want %+v", got, want)
+	}
+}
