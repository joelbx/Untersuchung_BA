 var releasePattern = regexp.MustCompile(`(.*) release (\d[\d\.]*)`)
+var emptyReleasePattern = regexp.MustCompile(`^\s*\S+\s+\S+\s+\S+  `)
+
+// rpm's query format prints a space for each separator, even for an empty release.
+func rpmLineFields(line string) []string {
+	fields := strings.Fields(line)
+	if emptyReleasePattern.MatchString(line) && len(fields) >= 3 {
+		fields = append(fields[:3:3], append([]string{""}, fields[3:]...)...)
+	}
+	return fields
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
 
