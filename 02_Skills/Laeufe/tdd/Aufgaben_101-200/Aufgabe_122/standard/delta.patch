+++ b/internal/config/storage_test.go
@@ -0,0 +1,17 @@
+package config
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDatabaseStorageReadOnlyMetadata(t *testing.T) {
+	result, err := Load("./testdata/storage/database_readonly.yml")
+	require.NoError(t, err)
+
+	encoded, err := json.Marshal(result.Config.Storage)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"type":"database","readOnly":true}`, string(encoded))
+}
