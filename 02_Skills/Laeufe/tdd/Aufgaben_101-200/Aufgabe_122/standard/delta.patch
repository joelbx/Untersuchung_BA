diff --git a/internal/cmd/auth_test.go b/internal/cmd/auth_test.go
new file mode 100644
index 0000000..30b1464
--- /dev/null
+++ b/internal/cmd/auth_test.go
@@ -0,0 +1,22 @@
+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+func TestAuthenticationGRPCWithoutDatabaseStorage(t *testing.T) {
+	for _, storageType := range []config.StorageType{config.LocalStorageType, config.GitStorageType, config.ObjectStorageType} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := &config.Config{Storage: config.StorageConfig{Type: storageType}}
+			register, _, shutdown, err := authenticationGRPC(context.Background(), zap.NewNop(), cfg, false)
+			require.NoError(t, err)
+			require.NotEmpty(t, register)
+			require.NoError(t, shutdown(context.Background()))
+		})
+	}
+}
