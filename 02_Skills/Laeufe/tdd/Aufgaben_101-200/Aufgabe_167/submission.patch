diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..23f219d
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,171 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"io/fs"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"gopkg.in/yaml.v3"
+)
+
+// Source builds filesystem snapshots from an OCI repository.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	return s, nil
+}
+
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+func (*Source) String() string { return "oci" }
+
+// Get fetches the current manifest and only rebuilds when its content changes.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	resp, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		return nil, err
+	}
+	if resp.Matched && s.snapshot != nil {
+		return s.snapshot, nil
+	}
+	files := make([]fs.File, 0, len(resp.Files))
+	for _, file := range resp.Files {
+		converted, err := applyNamespace(file)
+		if err != nil {
+			return nil, err
+		}
+		files = append(files, converted)
+	}
+	snapshot, err := storagefs.SnapshotFromFiles(files...)
+	if err != nil {
+		return nil, err
+	}
+	s.snapshot, s.digest = snapshot, resp.Digest
+	s.logger.Debug("fetched OCI snapshot", zap.Stringer("digest", resp.Digest))
+	return snapshot, nil
+}
+
+// Subscribe polls until cancelled and publishes snapshots when the digest changes.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	s.mu.Lock()
+	previous := s.digest
+	s.mu.Unlock()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+				continue
+			}
+			s.mu.Lock()
+			current := s.digest
+			s.mu.Unlock()
+			if current == previous {
+				continue
+			}
+			select {
+			case ch <- snapshot:
+				previous = current
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
+
+// applyNamespace sets each document namespace from its layer annotation.
+func applyNamespace(file fs.File) (fs.File, error) {
+	tagged, ok := file.(interface{ Namespace() string })
+	if !ok || tagged.Namespace() == "" {
+		return file, nil
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	var out bytes.Buffer
+	decoder := yaml.NewDecoder(file)
+	encoder := yaml.NewEncoder(&out)
+	for {
+		var node yaml.Node
+		if err := decoder.Decode(&node); err != nil {
+			if err == io.EOF {
+				break
+			}
+			return nil, err
+		}
+		if len(node.Content) == 0 {
+			continue
+		}
+		mapping := node.Content[0]
+		if mapping.Kind != yaml.MappingNode {
+			return nil, fmt.Errorf("OCI layer %s must contain a mapping", info.Name())
+		}
+		found := false
+		for i := 0; i < len(mapping.Content); i += 2 {
+			if mapping.Content[i].Value == "namespace" {
+				mapping.Content[i+1].Value = tagged.Namespace()
+				mapping.Content[i+1].Tag = "!!str"
+				found = true
+				break
+			}
+		}
+		if !found {
+			mapping.Content = append([]*yaml.Node{{Kind: yaml.ScalarNode, Tag: "!!str", Value: "namespace"}, {Kind: yaml.ScalarNode, Tag: "!!str", Value: tagged.Namespace()}}, mapping.Content...)
+		}
+		if err := encoder.Encode(&node); err != nil {
+			return nil, err
+		}
+	}
+	if err := encoder.Close(); err != nil {
+		return nil, err
+	}
+	return &snapshotFile{Reader: bytes.NewReader(out.Bytes()), info: snapshotFileInfo{FileInfo: info, name: strings.TrimSuffix(info.Name(), ".json") + ".yaml"}}, nil
+}
+
+type snapshotFile struct {
+	*bytes.Reader
+	info fs.FileInfo
+}
+
+func (f *snapshotFile) Stat() (fs.FileInfo, error) { return f.info, nil }
+func (f *snapshotFile) Close() error               { return nil }
+
+type snapshotFileInfo struct {
+	fs.FileInfo
+	name string
+}
+
+func (i snapshotFileInfo) Name() string { return i.name }
