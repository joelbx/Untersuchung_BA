+package cmd
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	"go.uber.org/zap/zaptest"
+	"oras.land/oras-go/v2"
+	ocistore "oras.land/oras-go/v2/content/oci"
+)
+
+// Omitting OCI source wiring prevents a configured OCI store from serving flags.
+func TestNewOCIStoreServesLocalFlag(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	target, err := ocistore.New(filepath.Join(dir, "repo"))
+	require.NoError(t, err)
+	target.AutoSaveIndex = true
+	payload := []byte("namespace: default\nflags:\n  - key: from-oci\n    name: From OCI\n    type: BOOLEAN_FLAG_TYPE\n")
+	layer := v1.Descriptor{Digest: digest.FromBytes(payload), Size: int64(len(payload)), MediaType: fliptoci.MediaTypeFliptFeatures + "+yaml"}
+	require.NoError(t, target.Push(ctx, layer, bytes.NewReader(payload)))
+	desc, err := oras.PackManifest(ctx, target, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{ManifestAnnotations: map[string]string{}, Layers: []v1.Descriptor{layer}})
+	require.NoError(t, err)
+	require.NoError(t, target.Tag(ctx, desc, "latest"))
+	store, err := NewOCIStore(&config.OCI{BundleDirectory: dir, Repository: "flipt://local/repo:latest"}, zaptest.NewLogger(t))
+	require.NoError(t, err)
+	defer store.Close()
+	_, err = store.GetFlag(ctx, "default", "from-oci")
+	require.NoError(t, err)
+}
