diff --git a/packages/drive-store/zustand/share/shareStores.test.ts b/packages/drive-store/zustand/share/shareStores.test.ts
new file mode 100644
index 0000000..d305b59
--- /dev/null
+++ b/packages/drive-store/zustand/share/shareStores.test.ts
@@ -0,0 +1,102 @@
+import { SHARE_MEMBER_PERMISSIONS } from '@proton/shared/lib/drive/permissions';
+
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store/_shares';
+import { getExistingEmails, useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (memberId: string): ShareMember => ({
+    memberId,
+    email: `${memberId}@example.com`,
+    inviterEmail: 'owner@example.com',
+    addressId: 'address',
+    createTime: 1,
+    modifyTime: 1,
+    permissions: SHARE_MEMBER_PERMISSIONS.VIEWER,
+    keyPacketSignature: 'signature',
+    sessionKeySignature: 'signature',
+});
+const invitation = (invitationId: string): ShareInvitation => ({
+    invitationId,
+    inviterEmail: 'owner@example.com',
+    inviteeEmail: `${invitationId}@example.com`,
+    permissions: SHARE_MEMBER_PERMISSIONS.VIEWER,
+    keyPacket: 'packet',
+    keyPacketSignature: 'signature',
+    createTime: 1,
+    state: 1,
+});
+const externalInvitation = (externalInvitationId: string): ShareExternalInvitation => ({
+    externalInvitationId,
+    inviterEmail: 'owner@example.com',
+    inviteeEmail: `${externalInvitationId}@example.com`,
+    createTime: 1,
+    permissions: SHARE_MEMBER_PERMISSIONS.VIEWER,
+    state: 1,
+    externalInvitationSignature: 'signature',
+});
+
+beforeEach(() => {
+    useMembersStore.setState({ members: {} });
+    useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+});
+
+test('members are isolated by share and a new set replaces only that share', () => {
+    const store = useMembersStore.getState();
+    expect(store.getMembers('missing')).toEqual([]);
+    store.setMembers('share-a', [member('a1'), member('a2')]);
+    store.setMembers('share-b', [member('b1')]);
+    store.setMembers('share-a', [member('a3')]);
+    expect(store.getMembers('share-a').map(({ memberId }) => memberId)).toEqual(['a3']);
+    expect(store.getMembers('share-b').map(({ memberId }) => memberId)).toEqual(['b1']);
+});
+
+test('internal and external invitations are isolated by share', () => {
+    const store = useInvitationsStore.getState();
+    expect(store.getInvitations('missing')).toEqual([]);
+    expect(store.getExternalInvitations('missing')).toEqual([]);
+    store.setInvitations('share-a', [invitation('a')]);
+    store.setInvitations('share-b', [invitation('b')]);
+    store.setExternalInvitations('share-a', [externalInvitation('external-a')]);
+    store.setExternalInvitations('share-b', [externalInvitation('external-b')]);
+    expect(store.getInvitations('share-a').map(({ invitationId }) => invitationId)).toEqual(['a']);
+    expect(store.getInvitations('share-b').map(({ invitationId }) => invitationId)).toEqual(['b']);
+    expect(store.getExternalInvitations('share-a').map(({ externalInvitationId }) => externalInvitationId)).toEqual([
+        'external-a',
+    ]);
+    expect(store.getExternalInvitations('share-b').map(({ externalInvitationId }) => externalInvitationId)).toEqual([
+        'external-b',
+    ]);
+});
+
+test('invitation updates, removals, and additions change only the selected share', () => {
+    const store = useInvitationsStore.getState();
+    store.setInvitations('share-a', [invitation('a')]);
+    store.setInvitations('share-b', [invitation('b')]);
+    store.setExternalInvitations('share-a', [externalInvitation('external-a')]);
+    store.setExternalInvitations('share-b', [externalInvitation('external-b')]);
+    store.updateInvitationsPermissions('share-a', [
+        { ...invitation('a'), permissions: SHARE_MEMBER_PERMISSIONS.EDITOR },
+    ]);
+    store.updateExternalInvitations('share-a', [
+        { ...externalInvitation('external-a'), permissions: SHARE_MEMBER_PERMISSIONS.EDITOR },
+    ]);
+    store.removeInvitations('share-a', []);
+    store.removeExternalInvitations('share-a', []);
+    store.addMultipleInvitations('share-a', [invitation('new')], [externalInvitation('external-new')]);
+    expect(store.getInvitations('share-a').map(({ invitationId }) => invitationId)).toEqual(['new']);
+    expect(store.getExternalInvitations('share-a').map(({ externalInvitationId }) => externalInvitationId)).toEqual([
+        'external-new',
+    ]);
+    expect(store.getInvitations('share-b').map(({ invitationId }) => invitationId)).toEqual(['b']);
+    expect(store.getExternalInvitations('share-b').map(({ externalInvitationId }) => externalInvitationId)).toEqual([
+        'external-b',
+    ]);
+});
+
+test('getExistingEmails flattens addresses from members and both invitation types', () => {
+    expect(getExistingEmails([member('member')], [invitation('internal')], [externalInvitation('external')])).toEqual([
+        'member@example.com',
+        'internal@example.com',
+        'external@example.com',
+    ]);
+});
