diff --git a/test/topicBacklinks.js b/test/topicBacklinks.js
new file mode 100644
index 0000000..98df295
--- /dev/null
+++ b/test/topicBacklinks.js
@@ -0,0 +1,76 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+const db = require('./mocks/databasemock');
+const topics = require('../src/topics');
+const posts = require('../src/posts');
+const categories = require('../src/categories');
+const user = require('../src/user');
+const meta = require('../src/meta');
+
+describe('Topic backlinks', () => {
+	let uid;
+	let cid;
+	let target;
+	let source;
+	before(async () => {
+		uid = await user.create({ username: 'backlink-author', password: '123456' });
+		cid = (await categories.create({ name: 'Backlink category' })).cid;
+		target = await topics.post({ uid, cid, title: 'Target topic', content: 'Target body' });
+		source = await topics.post({ uid, cid, title: 'Source topic', content: 'Source body' });
+		meta.config.topicBacklinks = 1;
+	});
+	after(() => { meta.config.topicBacklinks = 0; });
+
+	it('rejects missing post data', async () => {
+		assert.strictEqual(typeof topics.syncBacklinks, 'function');
+		await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+		await assert.rejects(topics.syncBacklinks({ pid: null, tid: 1, uid: 1, content: '' }), { message: '[[error:invalid-data]]' });
+	});
+
+	it('adds one event and association for a topic link, and removes them when edited away', async () => {
+		const post = source.postData;
+		const content = `See ${nconf.get('url')}/topic/${target.topicData.tid}/target-topic and /topic/${target.topicData.tid}`;
+		assert.strictEqual(await topics.syncBacklinks({ ...post, content }), 1);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${post.pid}:backlinks`, 0, -1), [String(target.topicData.tid)]);
+		let events = await topics.events.get(target.topicData.tid, uid);
+		const backlink = events.find(event => event.type === 'backlink');
+		assert(backlink);
+		assert.strictEqual(backlink.href, `/post/${post.pid}`);
+		assert.strictEqual(Number(backlink.uid), uid);
+		assert.strictEqual(backlink.text, '[[topic:backlink]]');
+		assert.strictEqual(await topics.syncBacklinks({ ...post, content }), 0);
+		meta.config.topicBacklinks = 0;
+		assert(!(await topics.events.get(target.topicData.tid, uid)).some(event => event.type === 'backlink'));
+		meta.config.topicBacklinks = 1;
+		await topics.events.log(target.topicData.tid, { type: 'pin', uid });
+		assert.strictEqual(await topics.syncBacklinks({ ...post, content: 'No reference' }), 1);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${post.pid}:backlinks`, 0, -1), []);
+		events = await topics.events.get(target.topicData.tid, uid);
+		assert(!events.some(event => event.type === 'backlink'));
+		assert(events.some(event => event.type === 'pin'));
+	});
+
+	it('preserves unrelated events if the backlink event was already removed', async () => {
+		const post = source.postData;
+		await topics.syncBacklinks({ ...post, content: `/topic/${target.topicData.tid}` });
+		const backlink = (await topics.events.get(target.topicData.tid, uid)).find(event => event.type === 'backlink');
+		await topics.events.purge(target.topicData.tid, [backlink.id]);
+		assert.strictEqual(await topics.syncBacklinks({ ...post, content: 'No reference' }), 1);
+		assert((await topics.events.get(target.topicData.tid, uid)).some(event => event.type === 'pin'));
+	});
+
+	it('ignores self references and missing topics', async () => {
+		const post = source.postData;
+		const content = `/topic/${source.topicData.tid} /topic/999999999`;
+		assert.strictEqual(await topics.syncBacklinks({ ...post, content }), 0);
+	});
+
+	it('creates backlinks from the first post and updates them on edit', async () => {
+		const created = await topics.post({ uid, cid, title: 'Linked topic', content: `See /topic/${target.topicData.tid}` });
+		assert((await topics.events.get(target.topicData.tid, uid)).some(event => event.href === `/post/${created.postData.pid}`));
+		await posts.edit({ pid: created.postData.pid, uid, content: 'Reference removed', title: 'Linked topic' });
+		assert(!(await topics.events.get(target.topicData.tid, uid)).some(event => event.href === `/post/${created.postData.pid}`));
+	});
+});
