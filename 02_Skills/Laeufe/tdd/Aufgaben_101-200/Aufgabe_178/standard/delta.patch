+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_filter_passlib(ident):
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib not available')
+    result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+
+
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+def test_bcrypt_ident_filter_crypt(ident):
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+
+
+def test_ident_does_not_change_non_bcrypt_hash():
+    expected = get_encrypted_password('123', 'sha256', salt='12345678', rounds=5000)
+    assert get_encrypted_password('123', 'sha256', salt='12345678', rounds=5000, ident='2a') == expected
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+def test_legacy_bcrypt_ident_with_crypt():
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident='2')
+    assert result == '$2$04$123456789012345678901u5SHP3NGAr4BMCYm9BSilJIuiMhAPm3e'
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
