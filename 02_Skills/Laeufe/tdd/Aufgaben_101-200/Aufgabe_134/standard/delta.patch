diff --git a/openlibrary/tests/test_book_providers_runeberg.py b/openlibrary/tests/test_book_providers_runeberg.py
new file mode 100644
index 0000000..a79eb7f
--- /dev/null
+++ b/openlibrary/tests/test_book_providers_runeberg.py
@@ -0,0 +1,55 @@
+from pathlib import Path
+
+from web.template import Template
+
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+    is_non_ia_ocaid,
+)
+
+TEMPLATE_DIR = Path(__file__).parents[1] / 'templates' / 'book_providers'
+
+
+def render_runeberg_template(name, *args):
+    template = Template(
+        (TEMPLATE_DIR / name).read_text(),
+        globals={'_': lambda text: text, 'render_once': lambda key: True},
+    )
+    return str(template(*args))
+
+
+def test_runeberg_provider_recognizes_archive_identifiers():
+    provider = ProjectRunebergProvider()
+    assert provider.is_own_ocaid('runeberg_nordic1')
+    assert not provider.is_own_ocaid('unrelated_archive')
+    assert is_non_ia_ocaid('runeberg_nordic1')
+
+
+def test_runeberg_provider_offers_open_access_from_best_identifier():
+    provider = get_book_provider_by_name('runeberg')
+    assert provider is not None
+    acquisitions = provider.get_acquisitions(
+        {'identifiers': {'project_runeberg': ['nordic1', 'nordic2']}}
+    )
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].url == 'https://runeberg.org/nordic1/'
+    assert acquisitions[0].provider_name == 'runeberg'
+
+
+def test_runeberg_read_button_links_to_edition_and_supports_optional_analytics():
+    html = render_runeberg_template('runeberg_read_button.html', 'nordic1')
+    assert 'href="https://runeberg.org/nordic1/"' in html
+    assert 'trusted source for Nordic literature' in html
+    tracked = render_runeberg_template(
+        'runeberg_read_button.html', 'nordic1', lambda event: 'data-event="Read"'
+    )
+    assert 'data-event="Read"' in tracked
+
+
+def test_runeberg_download_options_include_each_format():
+    html = render_runeberg_template('runeberg_download_options.html', 'nordic1')
+    for suffix in ('index2.html', 'index3.html', 'index.html', 'index.txt', 'index.xml'):
+        assert f'href="https://runeberg.org/nordic1/{suffix}"' in html
