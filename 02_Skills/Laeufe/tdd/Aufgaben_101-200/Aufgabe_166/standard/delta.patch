diff --git a/test/units/parsing/test_dataloader.py b/test/units/parsing/test_dataloader.py
index 188d149..50a0872 100644
--- a/test/units/parsing/test_dataloader.py
+++ b/test/units/parsing/test_dataloader.py
@@ -18,6 +18,8 @@
 from __future__ import annotations
 
 import os
+import shutil
+import tempfile
 
 import unittest
 from unittest.mock import patch, mock_open
@@ -201,6 +203,36 @@ class TestDataLoaderWithVault(unittest.TestCase):
     def tearDown(self):
         pass
 
+    def test_cache_none_reloads_vault_file_without_storing_it(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, 'vars.yml')
+            shutil.copyfile(self.test_vault_data_path, path)
+            self.assertEqual(self._loader.load_from_file(path, cache='none'), {'foo': 'bar'})
+            self.assertEqual(self._loader._FILE_CACHE, {})
+
+            with open(path, 'w') as stream:
+                stream.write('foo: changed\n')
+            self.assertEqual(self._loader.load_from_file(path, cache='none'), {'foo': 'changed'})
+            self.assertEqual(self._loader._FILE_CACHE, {})
+
+    def test_cache_vaulted_reuses_parsed_vault_file(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, 'vars.yml')
+            shutil.copyfile(self.test_vault_data_path, path)
+            self.assertEqual(self._loader.load_from_file(path, cache='vaulted'), {'foo': 'bar'})
+            self.assertIn(path, self._loader._FILE_CACHE)
+
+            os.unlink(path)
+            self.assertEqual(self._loader.load_from_file(path, cache='vaulted'), {'foo': 'bar'})
+
+    def test_cache_vaulted_does_not_store_plain_file(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, 'vars.yml')
+            with open(path, 'w') as stream:
+                stream.write('foo: plain\n')
+            self.assertEqual(self._loader.load_from_file(path, cache='vaulted'), {'foo': 'plain'})
+            self.assertEqual(self._loader._FILE_CACHE, {})
+
     def test_get_real_file_vault(self):
         real_file_path = self._loader.get_real_file(self.test_vault_data_path)
         self.assertTrue(os.path.exists(real_file_path))
