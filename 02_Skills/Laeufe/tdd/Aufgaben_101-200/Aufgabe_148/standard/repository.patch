diff --git a/lib/multiplexer/teleport_proxy_test.go b/lib/multiplexer/teleport_proxy_test.go
new file mode 100644
index 0000000..008a47c
--- /dev/null
+++ b/lib/multiplexer/teleport_proxy_test.go
@@ -0,0 +1,38 @@
+package multiplexer
+
+import (
+	"io"
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Dropping SSH classification, client address forwarding, or the handshake bytes breaks proxy connections.
+func TestDetectTeleportProxySSH(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		hello    string
+		wantAddr string
+	}{
+		{"client address", "Teleport-Proxy{\"clientAddr\":\"192.0.2.10:4567\"}\x00", "192.0.2.10:4567"},
+		{"client hostname", "Teleport-Proxy{\"clientAddr\":\"client.example:4567\"}\x00", "client.example:4567"},
+		{"no client address", "Teleport-Proxy{\"tracingContext\":{\"traceparent\":\"test\"}}\x00", "pipe"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			server, client := net.Pipe()
+			defer server.Close()
+			defer client.Close()
+			go func() { _, _ = io.WriteString(client, tt.hello) }()
+
+			conn, err := detect(server, false)
+			require.NoError(t, err)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			require.Equal(t, tt.wantAddr, conn.RemoteAddr().String())
+			got := make([]byte, len(tt.hello))
+			_, err = io.ReadFull(conn, got)
+			require.NoError(t, err)
+			require.Equal(t, tt.hello, string(got))
+		})
+	}
+}
