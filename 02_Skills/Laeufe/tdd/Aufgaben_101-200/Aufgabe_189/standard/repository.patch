+@pytest.mark.parametrize("version_results", [(False, False), (True, True)])
+def test_suffixes_workaround_skips_mime_lookup_outside_affected_qt(
+    monkeypatch, version_results,
+):
+    def version(string):
+        return version_results[0] if string == "6.2.3" else version_results[1]
+
+    def unexpected_lookup(_mime):
+        pytest.fail("MIME lookup happened outside the affected Qt versions")
+
+    monkeypatch.setattr(qtutils, "version_check", version)
+    monkeypatch.setattr(mimetypes, "guess_all_extensions", unexpected_lookup)
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == set()
+
