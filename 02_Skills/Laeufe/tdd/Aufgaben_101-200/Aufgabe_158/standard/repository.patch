+    def test_existing_zip_member_with_invalid_timestamp_is_compared(self, tmp_path, fake_ansible_module):
+        destination = tmp_path / 'dest'
+        destination.mkdir()
+        (destination / 'foo.txt').write_bytes(b'data')
+        source = tmp_path / 'source.zip'
+        with ZipFile(source, 'w') as archive_file:
+            archive_file.writestr('foo.txt', b'data')
+
+        fake_ansible_module.params = {
+            'extra_opts': [], 'exclude': [], 'include': [], 'io_buffer_size': 65536,
+            'keep_newer': False,
+        }
+        fake_ansible_module.debug = lambda message: None
+        fake_ansible_module.run_command = lambda command: (
+            0, '-rw-r--r--  3.0 unx 4 bx stor 19800000.000000 foo.txt\n', '',
+        )
+        zip_archive = ZipArchive(
+            src=str(source), b_dest=bytes(destination),
+            file_args={'owner': None, 'group': None, 'mode': None},
+            module=fake_ansible_module,
+        )
+
+        result = zip_archive.is_unarchived()
+
+        assert result['unarchived'] is False
+        assert zip_archive.includes == ['foo.txt']
+        assert 'differs in mtime' in result['err']
+
