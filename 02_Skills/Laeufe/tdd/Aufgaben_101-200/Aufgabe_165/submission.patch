+
+import { MatrixClient, Preset } from "matrix-js-sdk/src/matrix";
+
+import { shouldForceDisableEncryption } from "../../../src/utils/room/shouldForceDisableEncryption";
+import { privateShouldBeEncrypted } from "../../../src/utils/rooms";
+import { checkUserIsAllowedToChangeEncryption } from "../../../src/createRoom";
+
+describe("new room encryption policy", () => {
+    const clientWithPolicy = (e2ee: unknown, serverForces = false): MatrixClient =>
+        ({
+            getClientWellKnown: () => (e2ee === undefined ? undefined : { "io.element.e2ee": e2ee }),
+            doesServerForceEncryptionForPreset: async () => serverForces,
+        } as unknown as MatrixClient);
+
+    it.each([undefined, {}, { force_disable: false }, { force_disable: "true" }, { default: false }])(
+        "does not treat %p as a forced-off policy",
+        (e2ee) => expect(shouldForceDisableEncryption(clientWithPolicy(e2ee))).toBe(false),
+    );
+
+    it("forces the private-room default off when force_disable is true", () => {
+        const client = clientWithPolicy({ default: true, force_disable: true });
+        expect(shouldForceDisableEncryption(client)).toBe(true);
+        expect(privateShouldBeEncrypted(client)).toBe(false);
+    });
+
+    it("allows changes when neither policy mandates a value", async () => {
+        expect(
+            await checkUserIsAllowedToChangeEncryption(clientWithPolicy({ default: false }), Preset.PrivateChat),
+        ).toEqual({ allowChange: true });
+    });
+
+    it("locks encryption off when well-known mandates it", async () => {
+        expect(
+            await checkUserIsAllowedToChangeEncryption(clientWithPolicy({ force_disable: true }), Preset.PrivateChat),
+        ).toEqual({ allowChange: false, forcedValue: false });
+    });
+
+    it("prefers server encryption when policies conflict", async () => {
+        const warn = jest.spyOn(console, "warn").mockImplementation();
+        try {
+            expect(
+                await checkUserIsAllowedToChangeEncryption(
+                    clientWithPolicy({ force_disable: true }, true),
+                    Preset.PrivateChat,
+                ),
+            ).toEqual({ allowChange: false, forcedValue: true });
+            expect(warn).toHaveBeenCalledTimes(1);
+        } finally {
+            warn.mockRestore();
+        }
+    });
+
+    it("locks encryption on when the server mandates it", async () => {
+        expect(
+            await checkUserIsAllowedToChangeEncryption(clientWithPolicy(undefined, true), Preset.PrivateChat),
+        ).toEqual({ allowChange: false, forcedValue: true });
+    });
+});
