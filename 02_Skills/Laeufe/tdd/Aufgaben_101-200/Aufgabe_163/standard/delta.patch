diff --git a/storage/db/config_modes_test.go b/storage/db/config_modes_test.go
new file mode 100644
index 0000000..954c543
--- /dev/null
+++ b/storage/db/config_modes_test.go
@@ -0,0 +1,48 @@
+package db
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOpenDiscretePostgres(t *testing.T) {
+	cfg := config.Config{Database: config.DatabaseConfig{Protocol: config.Postgres, Host: "localhost", User: "alice", Password: "secret", Name: "flags", MaxOpenConn: 7}}
+	conn, driver, err := openConfig(cfg, false)
+	require.NoError(t, err)
+	defer conn.Close()
+	require.Equal(t, Postgres, driver)
+	require.Equal(t, 7, conn.Stats().MaxOpenConnections)
+}
+
+func TestOpenURLTakesPrecedenceOverInvalidFields(t *testing.T) {
+	cfg := config.Config{Database: config.DatabaseConfig{URL: "file:flags.db", Protocol: config.DatabaseProtocol(99), Password: "secret"}}
+	conn, driver, err := openConfig(cfg, false)
+	require.NoError(t, err)
+	defer conn.Close()
+	require.Equal(t, SQLite, driver)
+}
+
+func TestOpenRejectsMissingDiscreteField(t *testing.T) {
+	_, _, err := openConfig(config.Config{Database: config.DatabaseConfig{Protocol: config.MySQL, Host: "localhost"}}, false)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "db.name")
+}
+
+func TestParseDoesNotExposeCredentials(t *testing.T) {
+	_, _, err := parse("postgres://alice:supersecret@bad host/flags", false)
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "parsing"))
+	require.NotContains(t, err.Error(), "supersecret")
+}
+
+func TestMigratorUsesDiscreteSQLiteConfiguration(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Config{Database: config.DatabaseConfig{Protocol: config.SQLite, Path: dir + "/flags.db", Name: "flags", MigrationsPath: "../../config/migrations"}}
+	m, err := NewMigrator(cfg, logrus.New())
+	require.NoError(t, err)
+	defer m.Close()
+}
