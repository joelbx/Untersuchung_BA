+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnknown DatabaseProtocol = iota
+	SQLite
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+func (p DatabaseProtocol) MarshalJSON() ([]byte, error) { return json.Marshal(p.String()) }
+
+// ConnectionURL returns the selected database target, validating discrete settings first.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if err := d.Validate(); err != nil {
+		return "", err
+	}
+	if d.Protocol == SQLite {
+		path := d.Path
+		if path == "" {
+			path = d.Host
+		}
+		return "file:" + path, nil
+	}
+	port := d.Port
+	scheme := d.Protocol.String()
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: scheme, Host: net.JoinHostPort(d.Host, strconv.Itoa(port)), Path: "/" + d.Name}
+	if d.User != "" {
+		if d.Password != "" {
+			u.User = url.UserPassword(d.User, d.Password)
+		} else {
+			u.User = url.User(d.User)
+		}
+	}
+	return u.String(), nil
+}
+
+// Validate checks the active database configuration mode.
+func (d DatabaseConfig) Validate() error {
+	if d.URL != "" {
+		return nil
+	}
+	if d.Protocol != SQLite && d.Protocol != Postgres && d.Protocol != MySQL {
+		return fmt.Errorf("db.protocol %d is invalid; expected sqlite, postgres, or mysql", d.Protocol)
+	}
+	if d.Name == "" {
+		return errors.New("db.name is required")
+	}
+	if d.Protocol == SQLite {
+		if d.Path == "" && d.Host == "" {
+			return errors.New("db.path is required for sqlite")
+		}
+	} else if d.Host == "" {
+		return errors.New("db.host is required")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return errors.New("db.port must be between 1 and 65535")
+	}
+	return nil
 }
 
