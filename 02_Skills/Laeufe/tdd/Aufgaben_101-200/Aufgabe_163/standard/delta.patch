diff --git a/config/database_test.go b/config/database_test.go
new file mode 100644
index 0000000..2a42c40
--- /dev/null
+++ b/config/database_test.go
@@ -0,0 +1,95 @@
+package config
+
+import (
+	"encoding/json"
+	"io/ioutil"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func loadDatabaseYAML(t *testing.T, body string) (*Config, error) {
+	f, err := ioutil.TempFile("", "flipt-db-*.yaml")
+	require.NoError(t, err)
+	defer os.Remove(f.Name())
+	_, err = f.WriteString(body)
+	require.NoError(t, err)
+	require.NoError(t, f.Close())
+	return Load(f.Name())
+}
+
+func TestLoadSeparateDatabaseCredentials(t *testing.T) {
+	cfg, err := loadDatabaseYAML(t, "db:\n  protocol: postgres\n  host: db.internal\n  user: alice\n  password: secret\n  name: flags\n")
+	require.NoError(t, err)
+	require.Empty(t, cfg.Database.URL)
+	b, err := json.Marshal(cfg.Database)
+	require.NoError(t, err)
+	var fields map[string]interface{}
+	require.NoError(t, json.Unmarshal(b, &fields))
+	require.Equal(t, "db.internal", fields["host"])
+	require.Equal(t, "alice", fields["user"])
+	require.Equal(t, "secret", fields["password"])
+	require.Equal(t, "flags", fields["name"])
+	require.Equal(t, "postgres", fields["protocol"])
+}
+
+func TestLoadDatabaseURLPrecedence(t *testing.T) {
+	cfg, err := loadDatabaseYAML(t, "db:\n  url: file:flags.db\n  protocol: invalid\n  password: secret\n")
+	require.NoError(t, err)
+	require.Equal(t, "file:flags.db", cfg.Database.URL)
+}
+
+func TestLoadDatabaseFieldValidation(t *testing.T) {
+	cases := []struct{ name, body, key string }{
+		{"protocol", "db:\n  host: localhost\n  name: flags\n", "db.protocol"},
+		{"invalid protocol", "db:\n  protocol: oracle\n  host: localhost\n  name: flags\n", "db.protocol"},
+		{"host", "db:\n  protocol: postgres\n  name: flags\n", "db.host"},
+		{"name", "db:\n  protocol: mysql\n  host: localhost\n", "db.name"},
+		{"sqlite path", "db:\n  protocol: sqlite\n  name: flags\n", "db.path"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := loadDatabaseYAML(t, tc.body)
+			require.Error(t, err)
+			require.Contains(t, err.Error(), tc.key)
+			if tc.name == "invalid protocol" {
+				require.Contains(t, err.Error(), "oracle")
+				require.True(t, strings.Contains(err.Error(), "postgres") && strings.Contains(err.Error(), "mysql") && strings.Contains(err.Error(), "sqlite"))
+			}
+		})
+	}
+}
+
+func TestDatabaseConnectionURLDefaultsAndEscapesCredentials(t *testing.T) {
+	cases := []struct {
+		name string
+		db   DatabaseConfig
+		want string
+	}{
+		{"postgres", DatabaseConfig{Protocol: Postgres, Host: "localhost", User: "alice", Password: "p@ss word", Name: "flags"}, "postgres://alice:p%40ss%20word@localhost:5432/flags"},
+		{"mysql", DatabaseConfig{Protocol: MySQL, Host: "localhost", User: "alice", Name: "flags"}, "mysql://alice@localhost:3306/flags"},
+		{"sqlite", DatabaseConfig{Protocol: SQLite, Path: "/tmp/flags.db", Name: "flags"}, "file:/tmp/flags.db"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := tc.db.ConnectionURL()
+			require.NoError(t, err)
+			require.Equal(t, tc.want, got)
+		})
+	}
+}
+
+func TestLoadRejectsInvalidDatabasePort(t *testing.T) {
+	_, err := loadDatabaseYAML(t, "db:\n  protocol: postgres\n  host: localhost\n  name: flags\n  port: potatoes\n")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "db.port")
+}
+
+func TestDirectInvalidProtocolReportsItsValue(t *testing.T) {
+	err := (DatabaseConfig{Protocol: DatabaseProtocol(99), Host: "localhost", Name: "flags"}).Validate()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "99")
+	require.Contains(t, err.Error(), "db.protocol")
+}
