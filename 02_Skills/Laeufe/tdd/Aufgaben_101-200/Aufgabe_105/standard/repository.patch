@@ -0,0 +1,49 @@
+package subsonic
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/navidrome/navidrome/server/subsonic/responses"
+)
+
+// Removing the public route or applying credential checks to it must break this test.
+func TestOpenSubsonicExtensionsAllowsAnonymousJSON(t *testing.T) {
+	router := (&Router{}).routes()
+	for _, path := range []string{"/getOpenSubsonicExtensions", "/getOpenSubsonicExtensions.view"} {
+		t.Run(path, func(t *testing.T) {
+			request := httptest.NewRequest(http.MethodGet, path+"?f=json", nil)
+			recorder := httptest.NewRecorder()
+			router.ServeHTTP(recorder, request)
+
+			if recorder.Code != http.StatusOK {
+				t.Fatalf("status = %d, body = %s", recorder.Code, recorder.Body.String())
+			}
+			if got := recorder.Header().Get("Content-Type"); got != "application/json" {
+				t.Fatalf("Content-Type = %q", got)
+			}
+			var body responses.JsonWrapper
+			if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
+				t.Fatalf("decode JSON: %v", err)
+			}
+			if body.Subsonic.Status != responses.StatusOK {
+				t.Fatalf("status = %q, body = %s", body.Subsonic.Status, recorder.Body.String())
+			}
+			if body.Subsonic.OpenSubsonicExtensions == nil {
+				t.Fatal("missing openSubsonicExtensions")
+			}
+			got := *body.Subsonic.OpenSubsonicExtensions
+			want := []string{"transcodeOffset", "formPost", "songLyrics"}
+			if len(got) != len(want) {
+				t.Fatalf("extension count = %d, want %d", len(got), len(want))
+			}
+			for i, name := range want {
+				if got[i].Name != name {
+					t.Errorf("extension %d = %q, want %q", i, got[i].Name, name)
+				}
+			}
+		})
+	}
+}
