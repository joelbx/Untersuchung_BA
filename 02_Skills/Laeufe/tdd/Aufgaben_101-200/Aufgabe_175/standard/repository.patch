+// Catches failure to normalize duration schedules before handing them to cron.
+func TestBackupScheduleDuration(t *testing.T) {
+	old := Server.Backup
+	t.Cleanup(func() { Server.Backup = old })
+	Server.Backup.Schedule = "12h"
+	if err := validateBackupSchedule(); err != nil {
+		t.Fatal(err)
+	}
+	if Server.Backup.Schedule != "@every 12h" {
+		t.Fatalf("schedule = %q", Server.Backup.Schedule)
+	}
+}
+
+// Catches accepting an invalid schedule that would fail later at runtime.
+func TestBackupScheduleRejectsInvalid(t *testing.T) {
+	old := Server.Backup
+	t.Cleanup(func() { Server.Backup = old })
+	Server.Backup.Schedule = "not-a-schedule"
+	if err := validateBackupSchedule(); err == nil {
+		t.Fatal("invalid schedule accepted")
+	}
+}
