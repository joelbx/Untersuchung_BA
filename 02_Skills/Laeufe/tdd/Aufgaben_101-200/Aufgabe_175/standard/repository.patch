+package cmd
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+// Catches accidental deletion when retention is zero and stdin does not confirm.
+func TestBackupPruneRequiresConfirmationForZeroRetention(t *testing.T) {
+	dir := t.TempDir()
+	old := conf.Server.Backup
+	conf.Server.Backup.Path = dir
+	conf.Server.Backup.Count = 0
+	t.Cleanup(func() { conf.Server.Backup = old })
+	path := filepath.Join(dir, "navidrome_backup_20240101000000.db")
+	if err := os.WriteFile(path, []byte("backup"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := runBackupPrune(context.Background(), bytes.NewBufferString("no\n"), &bytes.Buffer{}, false); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatal("backup deleted without confirmation:", err)
+	}
+	if err := runBackupPrune(context.Background(), bytes.NewBuffer(nil), &bytes.Buffer{}, true); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("force did not prune backup: %v", err)
+	}
+}
