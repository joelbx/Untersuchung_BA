@@ -0,0 +1,91 @@
+package cmd
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backup := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	create := &cobra.Command{
+		Use: "create", Short: "Create a database backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, err := db.Db().Backup(cmd.Context())
+			if err == nil {
+				_, err = fmt.Fprintln(cmd.OutOrStdout(), path)
+			}
+			return err
+		},
+	}
+	prune := &cobra.Command{
+		Use: "prune", Short: "Delete old database backups", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, _ := cmd.Flags().GetBool("force")
+			return runBackupPrune(cmd.Context(), cmd.InOrStdin(), cmd.OutOrStdout(), force)
+		},
+	}
+	prune.Flags().Bool("force", false, "skip confirmation when backup.count is zero")
+	restore := &cobra.Command{
+		Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, _ := cmd.Flags().GetString("backup-file")
+			force, _ := cmd.Flags().GetBool("force")
+			if !force {
+				ok, err := confirmBackup(cmd.InOrStdin(), cmd.OutOrStdout(), "Restore database from "+path+"? This replaces the current database [y/N]: ")
+				if err != nil {
+					return err
+				}
+				if !ok {
+					return nil
+				}
+			}
+			if err := db.Db().Restore(cmd.Context(), path); err != nil {
+				return err
+			}
+			_, err := fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+			return err
+		},
+	}
+	restore.Flags().String("backup-file", "", "path to the backup database")
+	_ = restore.MarkFlagRequired("backup-file")
+	restore.Flags().Bool("force", false, "skip confirmation")
+	backup.AddCommand(create, prune, restore)
+	rootCmd.AddCommand(backup)
+}
+
+func runBackupPrune(ctx context.Context, in io.Reader, out io.Writer, force bool) error {
+	if conf.Server.Backup.Count == 0 && !force {
+		ok, err := confirmBackup(in, out, "backup.count is zero; delete all backup files [y/N]: ")
+		if err != nil {
+			return err
+		}
+		if !ok {
+			return nil
+		}
+	}
+	n, err := db.Db().Prune(ctx)
+	if err != nil {
+		return err
+	}
+	_, err = fmt.Fprintf(out, "Pruned %d backup files\n", n)
+	return err
+}
+
+func confirmBackup(in io.Reader, out io.Writer, prompt string) (bool, error) {
+	if _, err := fmt.Fprint(out, prompt); err != nil {
+		return false, err
+	}
+	line, err := bufio.NewReader(in).ReadString('\n')
+	if err != nil && err != io.EOF {
+		return false, err
+	}
+	answer := strings.ToLower(strings.TrimSpace(line))
+	return answer == "y" || answer == "yes", nil
+}
