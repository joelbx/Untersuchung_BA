diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..6e05ba0
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,171 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+
+var backupName = regexp.MustCompile(`^navidrome_backup_[0-9]{14}([0-9]{9})?\.db$`)
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup.path is empty")
+	}
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return "", err
+	}
+	now := time.Now().UTC()
+	path := filepath.Join(dir, backupPrefix+now.Format("20060102150405")+fmt.Sprintf("%09d", now.Nanosecond())+".db")
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	if err = f.Close(); err != nil {
+		os.Remove(path)
+		return "", err
+	}
+	dest, err := sql.Open(Driver, (&url.URL{Scheme: "file", Path: path}).String())
+	if err != nil {
+		os.Remove(path)
+		return "", err
+	}
+	err = copySQLite(ctx, dest, d.writeDB)
+	closeErr := dest.Close()
+	if err != nil {
+		os.Remove(path)
+		return "", err
+	}
+	if closeErr != nil {
+		os.Remove(path)
+		return "", closeErr
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	backupAbs, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	if liveAbs, err := filepath.Abs(conf.Server.DbPath); err == nil && backupAbs == liveAbs {
+		return errors.New("backup file is the live database")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if liveInfo, err := os.Stat(conf.Server.DbPath); err == nil && os.SameFile(info, liveInfo) {
+		return errors.New("backup file is the live database")
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("backup file is not a regular file")
+	}
+	u := &url.URL{Scheme: "file", Path: backupAbs, RawQuery: "mode=ro"}
+	src, err := sql.Open(Driver, u.String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var result string
+	if err := src.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return err
+	}
+	if result != "ok" {
+		return fmt.Errorf("backup integrity check failed: %s", result)
+	}
+	return copySQLite(ctx, d.writeDB, src)
+}
+
+func copySQLite(ctx context.Context, dest, src *sql.DB) error {
+	source, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	target, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer target.Close()
+	return source.Raw(func(s any) error {
+		sc, ok := s.(*sqlite3.SQLiteConn)
+		if !ok {
+			return errors.New("source is not SQLite")
+		}
+		return target.Raw(func(t any) error {
+			tc, ok := t.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("destination is not SQLite")
+			}
+			b, err := tc.Backup("main", sc, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = b.Finish()
+					return err
+				}
+				done, err := b.Step(128)
+				if err != nil {
+					_ = b.Finish()
+					return err
+				}
+				if done {
+					return b.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count must not be negative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if entry.Type().IsRegular() && backupName.MatchString(entry.Name()) {
+			names = append(names, entry.Name())
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
