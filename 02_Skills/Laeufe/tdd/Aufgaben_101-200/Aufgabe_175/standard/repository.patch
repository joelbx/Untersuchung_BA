+package db
+
+import (
+	"context"
+	"database/sql"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+// Catches a backup that copies only the main DB file and loses uncheckpointed WAL writes.
+func TestBackupRestoreRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	old := conf.Server.Backup
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	t.Cleanup(func() { conf.Server.Backup = old })
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "live.db")
+	write, err := sql.Open(Driver, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer write.Close()
+	if _, err = write.Exec("PRAGMA journal_mode=WAL; CREATE TABLE items (name TEXT); INSERT INTO items VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: write, writeDB: write}
+	backup, err := d.Backup(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Dir(backup) != conf.Server.Backup.Path {
+		t.Fatalf("backup path = %s", backup)
+	}
+	if _, err = write.Exec("INSERT INTO items VALUES ('after')"); err != nil {
+		t.Fatal(err)
+	}
+	if err = d.Restore(context.Background(), backup); err != nil {
+		t.Fatal(err)
+	}
+	var names string
+	if err = write.QueryRow("SELECT group_concat(name) FROM items").Scan(&names); err != nil {
+		t.Fatal(err)
+	}
+	if names != "before" {
+		t.Fatalf("restored names = %q", names)
+	}
+}
+
+// Catches pruning by file modification time or deletion of unrelated files.
+func TestPruneKeepsLatestNamedBackups(t *testing.T) {
+	dir := t.TempDir()
+	old := conf.Server.Backup
+	conf.Server.Backup.Path = dir
+	conf.Server.Backup.Count = 1
+	t.Cleanup(func() { conf.Server.Backup = old })
+	for _, name := range []string{"navidrome_backup_20240101000000.db", "navidrome_backup_20250101000000.db", "other.db"} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte("data"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	n, err := (&db{}).Prune(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 1 {
+		t.Fatalf("pruned %d files", n)
+	}
+	for _, name := range []string{"navidrome_backup_20250101000000.db", "other.db"} {
+		if _, err := os.Stat(filepath.Join(dir, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// Catches restore opening a URI with unescaped path characters as another file.
+func TestRestoreFromPathWithQueryCharacter(t *testing.T) {
+	dir := t.TempDir()
+	live, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE items (name TEXT); INSERT INTO items VALUES ('old')"); err != nil {
+		t.Fatal(err)
+	}
+	backupPath := filepath.Join(dir, "backup?special.db")
+	backup, err := sql.Open(Driver, (&url.URL{Scheme: "file", Path: backupPath}).String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := backup.Exec("CREATE TABLE items (name TEXT); INSERT INTO items VALUES ('restored')"); err != nil {
+		t.Fatal(err)
+	}
+	if err := backup.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := (&db{readDB: live, writeDB: live}).Restore(context.Background(), backupPath); err != nil {
+		t.Fatal(err)
+	}
+	var name string
+	if err := live.QueryRow("SELECT name FROM items").Scan(&name); err != nil {
+		t.Fatal(err)
+	}
+	if name != "restored" {
+		t.Fatalf("name = %q", name)
+	}
+}
+
+// Catches a backup path whose URI metacharacter makes SQLite write elsewhere.
+func TestBackupToPathWithQueryCharacter(t *testing.T) {
+	dir := t.TempDir()
+	old := conf.Server.Backup
+	conf.Server.Backup.Path = filepath.Join(dir, "backups?special")
+	t.Cleanup(func() { conf.Server.Backup = old })
+	live, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE items (name TEXT); INSERT INTO items VALUES ('saved')"); err != nil {
+		t.Fatal(err)
+	}
+	path, err := (&db{readDB: live, writeDB: live}).Backup(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	copy, err := sql.Open(Driver, (&url.URL{Scheme: "file", Path: path, RawQuery: "mode=ro"}).String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer copy.Close()
+	var name string
+	if err := copy.QueryRow("SELECT name FROM items").Scan(&name); err != nil {
+		t.Fatal(err)
+	}
+	if name != "saved" {
+		t.Fatalf("name = %q", name)
+	}
+}
+
+// Catches restoring the live database through a symlink alias.
+func TestRestoreRejectsLiveDatabaseAlias(t *testing.T) {
+	dir := t.TempDir()
+	livePath := filepath.Join(dir, "live.db")
+	live, err := sql.Open(Driver, livePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE items (name TEXT)"); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(dir, "alias.db")
+	if err := os.Symlink(livePath, alias); err != nil {
+		t.Fatal(err)
+	}
+	old := conf.Server.DbPath
+	conf.Server.DbPath = livePath
+	t.Cleanup(func() { conf.Server.DbPath = old })
+	if err := (&db{readDB: live, writeDB: live}).Restore(context.Background(), alias); err == nil {
+		t.Fatal("live database alias accepted")
+	}
+}
