+import React from "react";
+// eslint-disable-next-line deprecate/import
+import { mount } from "enzyme";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import getEntryComponentForLoginType, {
+    DEFAULT_PHASE,
+    RegistrationTokenAuthEntry,
+} from "../../../../src/components/views/auth/InteractiveAuthEntryComponents";
+import AccessibleButton from "../../../../src/components/views/elements/AccessibleButton";
+import InteractiveAuthComponent from "../../../../src/components/structures/InteractiveAuth";
+import { flushPromises, getMockClientWithEventEmitter, unmockClientPeg } from "../../../test-utils";
+
+describe("registration token authentication", () => {
+    const types = [AuthType.RegistrationToken, AuthType.UnstableRegistrationToken];
+
+    afterAll(() => unmockClientPeg());
+
+    it.each(types)("shows a token form for %s", (loginType) => {
+        const Stage = getEntryComponentForLoginType(loginType);
+        const onPhaseChange = jest.fn();
+        const container = document.createElement("div");
+        document.body.appendChild(container);
+        const wrapper = mount(
+            <Stage
+                loginType={loginType}
+                matrixClient={null}
+                authSessionId="session"
+                onPhaseChange={onPhaseChange}
+                submitAuthDict={jest.fn()}
+            />,
+            { attachTo: container },
+        );
+
+        expect(wrapper.find(RegistrationTokenAuthEntry)).toHaveLength(1);
+        expect(wrapper.find('input[name="registrationTokenField"]')).toHaveLength(1);
+        expect(wrapper.text()).toContain("Registration token");
+        expect(wrapper.text()).toContain("Enter a registration token provided by the homeserver administrator.");
+        expect(document.activeElement).toBe(wrapper.find('input[name="registrationTokenField"]').getDOMNode());
+        expect(onPhaseChange).toHaveBeenCalledWith(DEFAULT_PHASE);
+        expect(wrapper.find(AccessibleButton).prop("kind")).toBe("primary");
+        expect(wrapper.find(AccessibleButton).prop("disabled")).toBe(true);
+        wrapper.unmount();
+        container.remove();
+    });
+
+    it.each(types)("submits only the advertised %s type and entered token", (loginType) => {
+        const submitAuthDict = jest.fn();
+        const wrapper = mount(
+            <RegistrationTokenAuthEntry
+                loginType={loginType}
+                matrixClient={null}
+                authSessionId="session"
+                onPhaseChange={jest.fn()}
+                submitAuthDict={submitAuthDict}
+            />,
+        );
+        wrapper.find('input[name="registrationTokenField"]').simulate("change", { target: { value: "token-123" } });
+        expect(wrapper.find(AccessibleButton).prop("disabled")).toBe(false);
+        wrapper.find("form").simulate("submit");
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: loginType, token: "token-123" });
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+        wrapper.find(AccessibleButton).simulate("click");
+        expect(submitAuthDict).toHaveBeenCalledTimes(2);
+        wrapper.unmount();
+    });
+
+    it("shows an error and prevents submission while busy", () => {
+        const submitAuthDict = jest.fn();
+        const wrapper = mount(
+            <RegistrationTokenAuthEntry
+                loginType={AuthType.RegistrationToken}
+                matrixClient={null}
+                authSessionId="session"
+                onPhaseChange={jest.fn()}
+                submitAuthDict={submitAuthDict}
+                busy={true}
+                errorText="Invalid token"
+            />,
+        );
+        expect(wrapper.find('[role="alert"].error').text()).toBe("Invalid token");
+        expect(wrapper.find(AccessibleButton)).toHaveLength(0);
+        expect(wrapper.find("Spinner")).toHaveLength(1);
+        wrapper.find("form").simulate("submit");
+        expect(submitAuthDict).not.toHaveBeenCalled();
+        wrapper.unmount();
+    });
+
+    it.each(types)("completes %s and preserves the callback metadata", async (loginType) => {
+        const client = getMockClientWithEventEmitter({ generateClientSecret: () => "client-secret" });
+        const response = { user_id: "@new:example.org", access_token: "access-token" };
+        const makeRequest = jest.fn().mockResolvedValue(response);
+        const onAuthFinished = jest.fn();
+        const wrapper = mount(
+            <InteractiveAuthComponent
+                matrixClient={client}
+                authData={{
+                    session: "server-session",
+                    flows: [{ stages: [loginType] }],
+                }}
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />,
+        );
+        wrapper.find('input[name="registrationTokenField"]').simulate("change", { target: { value: "token-123" } });
+        wrapper.find("form").simulate("submit");
+        await flushPromises();
+
+        expect(makeRequest).toHaveBeenCalledWith({
+            session: "server-session",
+            type: loginType,
+            token: "token-123",
+        });
+        expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+            clientSecret: "client-secret",
+            emailSid: undefined,
+        });
+        wrapper.unmount();
+    });
+});
