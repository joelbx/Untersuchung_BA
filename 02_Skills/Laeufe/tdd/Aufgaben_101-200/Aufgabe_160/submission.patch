+func TestSSHHeartbeatUsesPeerHostForLocalAddress(t *testing.T) {
+	tests := []struct {
+		name     string
+		addr     string
+		peerAddr string
+		want     string
+	}{
+		{name: "IPv6 wildcard", addr: "[::]:3022", peerAddr: "192.0.2.10:50123", want: "192.0.2.10:3022"},
+		{name: "IPv4 wildcard", addr: "0.0.0.0:3022", peerAddr: "[2001:db8::10]:50123", want: "[2001:db8::10]:3022"},
+		{name: "loopback", addr: "127.0.0.1:3022", peerAddr: "192.0.2.10:50123", want: "192.0.2.10:3022"},
+		{name: "routable address", addr: "198.51.100.7:3022", peerAddr: "192.0.2.10:50123", want: "198.51.100.7:3022"},
+		{name: "missing peer", addr: "[::]:3022", want: "[::]:3022"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
+			defer controller.Close()
+			upstream, downstream := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peerAddr))
+			defer downstream.Close()
+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{
+				ServerID: "test-server",
+				Services: []types.SystemRole{types.RoleNode},
+			})
+			server := &types.ServerV2{Metadata: types.Metadata{Name: "test-server"}}
+			server.SetAddr(tt.addr)
+			require.NoError(t, controller.handleSSHServerHB(handle, server))
+			require.Equal(t, tt.want, auth.upsertAddr)
+		})
+	}
+}
