+// A pipe configured with a peer address must expose it to the controller.
+func TestInventoryControlStreamPipePeerAddr(t *testing.T) {
+	upstream, downstream := InventoryControlStreamPipe(ICSPipePeerAddr("192.0.2.10:50123"))
+	defer downstream.Close()
+	require.Equal(t, "192.0.2.10:50123", upstream.PeerAddr())
+
+	plain, plainDownstream := InventoryControlStreamPipe()
+	defer plainDownstream.Close()
+	require.Empty(t, plain.PeerAddr())
+}
