+type AdminActionLock = {
+    pending: boolean;
+    run: (action: () => Promise<void>, errorTitle: string) => Promise<void>;
+};
+
+const AdminActionContext = React.createContext<AdminActionLock | null>(null);
+
+function useAdminActionLock(): AdminActionLock {
+    const active = useRef(false);
+    const [pending, setPending] = useState(false);
+    const run = async (action: () => Promise<void>, errorTitle: string): Promise<void> => {
+        if (active.current) return;
+        active.current = true;
+        setPending(true);
+        try {
+            await action();
+        } catch (err) {
+            logger.error("Admin action failed", err);
+            Modal.createDialog(ErrorDialog, {
+                title: errorTitle,
+                description: err instanceof Error ? err.message : _t("Operation failed"),
+            });
+        } finally {
+            active.current = false;
+            setPending(false);
+        }
+    };
+    return { pending, run };
+}
+
+function useMemberAdminAction(): AdminActionLock {
+    const shared = useContext(AdminActionContext);
+    const local = useAdminActionLock();
+    return shared ?? local;
+}
