+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	tests := []struct {
+		name string
+		enc  Encoding
+		data string
+	}{
+		{"yaml", EncodingYAML, `version: "1.4"
+namespace:
+  key: team
+  name: Team
+  description: Team flags
+flags:
+  - key: feature
+    name: Feature
+    enabled: true
+    metadata:
+      owner:
+        team: platform
+        contacts:
+          - alice
+          - bob
+      active: true
+    variants:
+      - key: on
+        attachment:
+          nested:
+            values: [one, two]
+`},
+		{"json", EncodingJSON, `{"version":"1.4","namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","name":"Feature","enabled":true,"metadata":{"owner":{"team":"platform","contacts":["alice","bob"]},"active":true},"variants":[{"key":"on","attachment":{"nested":{"values":["one","two"]}}}]}]}`},
+		{"json with header", EncodingJSON, "# exported flags\n" + `{"version":"1.4","namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","name":"Feature","enabled":true,"metadata":{"owner":{"team":"platform","contacts":["alice","bob"]},"active":true},"variants":[{"key":"on","attachment":{"nested":{"values":["one","two"]}}}]}]}`},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tt.enc, strings.NewReader(tt.data), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team", Description: "Team flags"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			flag := creator.createflagReqs[0]
+			assert.Equal(t, "team", flag.NamespaceKey)
+			assert.Equal(t, map[string]any{"owner": map[string]any{"team": "platform", "contacts": []any{"alice", "bob"}}, "active": true}, flag.Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			var attachment any
+			require.NoError(t, json.Unmarshal([]byte(creator.variantReqs[0].Attachment), &attachment))
+			assert.Equal(t, map[string]any{"nested": map[string]any{"values": []any{"one", "two"}}}, attachment)
+		})
+	}
+}
+
+func TestImport_JSONHeaderOnlyAtStart(t *testing.T) {
+	for _, data := range []string{
+		"# one\n# two\n{}",
+		" # one\n{}",
+	} {
+		t.Run(data, func(t *testing.T) {
+			err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(data), false)
+			require.Error(t, err)
+			assert.ErrorContains(t, err, "unmarshalling document")
+		})
+	}
+}
