diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..dd5f7c7
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,26 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate chat allow lists',
+	timestamp: Date.UTC(2025, 4, 1),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const keys = uids.map(uid => `user:${uid}:settings`);
+			const settings = await db.getObjects(keys, ['restrictChat', 'chatAllowList']);
+			const selected = uids.filter((uid, index) =>
+				settings[index] && parseInt(settings[index].restrictChat, 10) === 1 &&
+				settings[index].chatAllowList == null);
+			const follows = await db.getSortedSetsMembers(selected.map(uid => `following:${uid}`));
+			await db.setObjectBulk(selected.map((uid, index) => [
+				`user:${uid}:settings`, { chatAllowList: JSON.stringify(follows[index].map(String)) },
+			]));
+			await Promise.all(uids.map(uid => db.deleteObjectField(`user:${uid}:settings`, 'restrictChat')));
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
