+    @pytest.mark.parametrize('enable_from_commandline', [True, False])
+    def test_enabled_and_disabled_features_from_both_sources(
+            self, config_stub, monkeypatch, parser, enable_from_commandline):
+        """Keep disabled features separate while merging enabled features."""
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+
+        enable = 'enable-features=First,Second'
+        disable = 'disable-features=Third,Fourth'
+        commandline = enable if enable_from_commandline else disable
+        configured = disable if enable_from_commandline else enable
+        config_stub.val.qt.args = [configured]
+
+        parsed = parser.parse_args(['--qt-flag', commandline])
+        args = qtargs.qt_args(parsed)
+
+        assert getattr(qtargs, 'ENABLE_FEATURES_PREFIX', None) == '--enable-features='
+        assert getattr(qtargs, 'DISABLE_FEATURES_PREFIX', None) == '--disable-features='
+        enabled = [arg for arg in args
+                   if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        disabled = [arg for arg in args
+                    if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)]
+        assert enabled == ['--enable-features=First,Second,OverlayScrollbar']
+        assert disabled == ['--disable-features=Third,Fourth']
+
