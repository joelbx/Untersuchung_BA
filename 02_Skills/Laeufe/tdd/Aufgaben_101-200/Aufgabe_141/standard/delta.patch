--- /dev/null
+++ b/commands/wp_ignore_inactive_test.go
@@ -0,0 +1,22 @@
+package commands
+
+import (
+	"flag"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestReportFlagEnablesIgnoringInactiveWordPressPackages(t *testing.T) {
+	old := config.Conf
+	defer func() { config.Conf = old }()
+	config.Conf = config.Config{}
+	flags := flag.NewFlagSet("report", flag.ContinueOnError)
+	new(ReportCmd).SetFlags(flags)
+	if err := flags.Parse([]string{"-wp-ignore-inactive"}); err != nil {
+		t.Fatal(err)
+	}
+	if !config.Conf.WpIgnoreInactive {
+		t.Fatal("report flag did not enable ignoring inactive WordPress packages")
+	}
+}
