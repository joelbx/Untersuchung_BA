diff --git a/config/wp_ignore_inactive_test.go b/config/wp_ignore_inactive_test.go
new file mode 100644
index 0000000..325581c
--- /dev/null
+++ b/config/wp_ignore_inactive_test.go
@@ -0,0 +1,23 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestTOMLLoaderEnablesIgnoringInactiveWordPressPackages(t *testing.T) {
+	old := Conf
+	defer func() { Conf = old }()
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	if err := os.WriteFile(path, []byte("WpIgnoreInactive = true\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !Conf.WpIgnoreInactive {
+		t.Fatal("TOML configuration did not enable ignoring inactive WordPress packages")
+	}
+}
