diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..c4c9640
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,73 @@
+package wordpress
+
+import (
+	"io"
+	"net/http"
+	"reflect"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactivesKeepsCoreAndActivePackages(t *testing.T) {
+	packages := models.WordPressPackages{
+		{Name: "core", Type: models.WPCore, Version: "5.0"},
+		{Name: "disabled-theme", Type: models.WPTheme, Status: models.Inactive},
+		{Name: "enabled-theme", Type: models.WPTheme, Status: "active"},
+		{Name: "disabled-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+	}
+	want := models.WordPressPackages{packages[0], packages[2], packages[4]}
+	if got := removeInactives(packages); !reflect.DeepEqual(got, want) {
+		t.Fatalf("removeInactives() = %#v, want %#v", got, want)
+	}
+	if !reflect.DeepEqual(packages[1], models.WpPackage{Name: "disabled-theme", Type: models.WPTheme, Status: models.Inactive}) {
+		t.Fatal("removeInactives changed the input")
+	}
+}
+
+func TestRemoveInactivesReturnsNilWhenAllInactive(t *testing.T) {
+	packages := models.WordPressPackages{{Name: "disabled", Type: models.WPPlugin, Status: models.Inactive}}
+	if got := removeInactives(packages); got != nil {
+		t.Fatalf("removeInactives() = %#v, want nil", got)
+	}
+}
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestFillWordPressSkipsInactivePackageRequestsWhenConfigured(t *testing.T) {
+	oldConf := config.Conf
+	oldTransport := http.DefaultTransport
+	defer func() {
+		config.Conf = oldConf
+		http.DefaultTransport = oldTransport
+	}()
+	config.Conf.WpIgnoreInactive = true
+	var paths []string
+	http.DefaultTransport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		paths = append(paths, req.URL.Path)
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader("{}")), Header: make(http.Header)}, nil
+	})
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Type: models.WPCore, Version: "5.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+	}
+	result := &models.ScanResult{WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+	if _, err := FillWordPress(result, "token"); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"/api/v3/wordpresses/50", "/api/v3/themes/active-theme", "/api/v3/plugins/active-plugin"}
+	if !reflect.DeepEqual(paths, want) {
+		t.Fatalf("requested paths = %#v, want %#v", paths, want)
+	}
+}
