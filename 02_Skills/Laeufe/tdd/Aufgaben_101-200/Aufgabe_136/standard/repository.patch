diff --git a/tests/unit/browser/webengine/test_certificate_wrappers.py b/tests/unit/browser/webengine/test_certificate_wrappers.py
new file mode 100644
index 0000000..e812e07
--- /dev/null
+++ b/tests/unit/browser/webengine/test_certificate_wrappers.py
@@ -0,0 +1,113 @@
+import pytest
+from types import SimpleNamespace
+
+from qutebrowser.qt import machinery
+from qutebrowser.qt.core import QUrl
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.browser.webengine import webview
+from qutebrowser.browser.webengine import webenginetab
+
+
+class FakeError:
+
+    def __init__(self):
+        self.calls = []
+
+    def errorDescription(self):
+        return '<expired> & unsafe'
+
+    def isOverridable(self):
+        return True
+
+    def url(self):
+        return QUrl('https://example.org/')
+
+    def defer(self):
+        self.calls.append('defer')
+
+    def acceptCertificate(self):
+        self.calls.append('accept')
+
+    def rejectCertificate(self):
+        self.calls.append('reject')
+
+
+@pytest.mark.parametrize('qt6', [False, True])
+def test_create_chooses_qt_version(monkeypatch, qt6):
+    monkeypatch.setattr(machinery, 'USE_PYQT6', qt6)
+    monkeypatch.setattr(machinery, 'USE_PYSIDE6', False)
+    wrapper = certificateerror.create(FakeError())
+    expected = (certificateerror.CertificateErrorWrapperQt6 if qt6 else
+                certificateerror.CertificateErrorWrapperQt5)
+    assert isinstance(wrapper, expected)
+
+
+def test_qt5_decision_updates_legacy_ignore():
+    wrapper = certificateerror.CertificateErrorWrapperQt5(FakeError())
+    assert wrapper.ignore is False
+    wrapper.accept_certificate()
+    assert wrapper.ignore is True
+    assert wrapper.certificate_was_accepted() is True
+    wrapper.reject_certificate()
+    assert wrapper.ignore is False
+    assert wrapper.certificate_was_accepted() is False
+    with pytest.raises(certificateerror.usertypes.UndeferrableError):
+        wrapper.defer()
+
+
+def test_qt6_decisions_use_error_methods():
+    error = FakeError()
+    wrapper = certificateerror.CertificateErrorWrapperQt6(error)
+    wrapper.defer()
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted() is True
+    wrapper.reject_certificate()
+    assert wrapper.certificate_was_accepted() is False
+    assert error.calls == ['defer', 'accept', 'reject']
+
+
+def test_page_certificate_callback_uses_version_wrapper():
+    class Signal:
+        def emit(self, wrapper):
+            assert isinstance(wrapper, certificateerror.CertificateErrorWrapperQt5)
+            wrapper.accept_certificate()
+
+    class Page:
+        certificate_error = Signal()
+
+    assert webview.WebEnginePage.certificateError(Page(), FakeError()) is True
+
+
+def test_page_certificate_callback_reports_qt6_decision(monkeypatch):
+    monkeypatch.setattr(machinery, 'USE_PYQT6', True)
+
+    class Signal:
+        def emit(self, wrapper):
+            wrapper.accept_certificate()
+
+    class Page:
+        certificate_error = Signal()
+
+    error = FakeError()
+    assert webview.WebEnginePage.certificateError(Page(), error) is True
+    assert error.calls == ['accept']
+
+
+@pytest.mark.parametrize('accepted', [False, True])
+def test_tab_applies_certificate_decision(monkeypatch, accepted):
+    monkeypatch.setattr(webenginetab.shared, 'ignore_certificate_error',
+                        lambda **kwargs: accepted)
+
+    class Tab:
+        _insecure_hosts = set()
+        data = SimpleNamespace(last_navigation=SimpleNamespace(url=QUrl('https://example.org/')))
+
+        def abort_questions(self):
+            pass
+
+        def url(self, requested=False):
+            return QUrl('https://example.org/')
+
+    wrapper = certificateerror.CertificateErrorWrapperQt5(FakeError())
+    webenginetab.WebEngineTab._on_ssl_errors(Tab(), wrapper)
+    assert wrapper.certificate_was_accepted() is accepted
diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..1b7276d 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -71,3 +71,37 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+@pytest.mark.parametrize('messages, expected', [
+    (["<bad> & 'quoted' \"text\""],
+     '<p>&lt;bad&gt; &amp; &#x27;quoted&#x27; &quot;text&quot;</p>'),
+    (["<first> &", "'second' \"value\""],
+     '<ul><li>&lt;first&gt; &amp;</li>'
+     '<li>&#39;second&#39; &#34;value&#34;</li></ul>'),
+])
+def test_named_reply_and_errors_render_escaped_html(messages, expected):
+    """The wrapper can carry a reply without using it during construction."""
+    class UnusedReply:
+        def __getattr__(self, name):
+            raise AssertionError(f'unexpected reply access: {name}')
+
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=UnusedReply(), errors=[FakeError(msg) for msg in messages])
+    assert ''.join(wrapper.html().split()) == ''.join(expected.split())
+
+
+def test_accept_certificate_ignores_reply_errors():
+    class Reply:
+        ignored = False
+
+        def ignoreSslErrors(self):
+            self.ignored = True
+
+    reply = Reply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('expired')])
+    assert reply.ignored is False
+    wrapper.accept_certificate()
+    assert reply.ignored is True
+    assert wrapper.certificate_was_accepted() is True
diff --git a/tests/unit/utils/usertypes/test_certificate_decisions.py b/tests/unit/utils/usertypes/test_certificate_decisions.py
new file mode 100644
index 0000000..1d9cea8
--- /dev/null
+++ b/tests/unit/utils/usertypes/test_certificate_decisions.py
@@ -0,0 +1,23 @@
+import pytest
+
+from qutebrowser.utils import usertypes
+
+
+class CertificateError(usertypes.AbstractCertificateErrorWrapper):
+
+    def __str__(self):
+        return 'certificate error'
+
+
+def test_certificate_decision_state():
+    error = CertificateError()
+    assert error.certificate_was_accepted() is False
+    error.accept_certificate()
+    assert error.certificate_was_accepted() is True
+    error.reject_certificate()
+    assert error.certificate_was_accepted() is False
+
+
+def test_default_defer_is_undeferrable():
+    with pytest.raises(usertypes.UndeferrableError):
+        CertificateError().defer()
