+func TestStoreBuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		option       bool
+		wantArtifact bool
+	}{
+		{name: "default version 1.1", wantArtifact: true},
+		{name: "configured version 1.0", option: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var opts []containers.Option[StoreOptions]
+			if tc.option {
+				opts = append(opts, WithManifestVersion(oras.PackManifestVersion1_0))
+			}
+			store, err := NewStore(zaptest.NewLogger(t), t.TempDir(), opts...)
+			require.NoError(t, err)
+			ref, err := ParseReference("bundle:latest")
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			_, err = store.Build(context.Background(), src, ref)
+			require.NoError(t, err)
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(context.Background(), "latest")
+			require.NoError(t, err)
+			blob, err := content.FetchAll(context.Background(), target, desc)
+			require.NoError(t, err)
+			var manifest struct {
+				ArtifactType string `json:"artifactType"`
+			}
+			require.NoError(t, json.Unmarshal(blob, &manifest))
+			assert.Equal(t, tc.wantArtifact, manifest.ArtifactType == MediaTypeFliptFeatures)
+		})
+	}
+}
