+func TestLoadOCIManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name, version, want, wantErr string
+	}{
+		{name: "default", want: "1.1"},
+		{name: "version 1.0", version: "1.0", want: "1.0"},
+		{name: "invalid version", version: "1.2", wantErr: "wrong manifest version, it should be 1.0 or 1.1"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			body := "storage:\n  type: oci\n  oci:\n    repository: bundle:latest\n"
+			if tc.version != "" {
+				body += "    manifest_version: \"" + tc.version + "\"\n"
+			}
+			require.NoError(t, os.WriteFile(path, []byte(body), 0600))
+			result, err := Load(path)
+			if tc.wantErr != "" {
+				require.EqualError(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, result.Config.Storage.OCI.ManifestVersion)
+		})
+	}
+}
