+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_pip_uses_current_interpreter_when_library_available(mocker):
+    module = mocker.Mock()
+    mocker.patch.object(pip, '_have_pip_module', return_value=True, create=True)
+
+    assert pip._get_pip(module) == [sys.executable, '-m', 'pip']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_pip_normalizes_explicit_executable(mocker):
+    module = mocker.Mock()
+
+    assert pip._get_pip(module, executable='/usr/bin/pip3') == ['/usr/bin/pip3']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_packages_falls_back_to_freeze_for_interpreter_launcher(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(2, '', 'unsupported option'), (0, 'six==1.0\n', '')]
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    assert pip._get_packages(module, [sys.executable, '-m', 'pip'], '/tmp') == (
+        '%s -m pip freeze' % sys.executable, 'six==1.0\n', '')
+    assert module.run_command.call_args_list[0][0][0] == [sys.executable, '-m', 'pip', 'list', '--format=freeze']
+    assert module.run_command.call_args_list[1][0][0] == [sys.executable, '-m', 'pip', 'freeze']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
