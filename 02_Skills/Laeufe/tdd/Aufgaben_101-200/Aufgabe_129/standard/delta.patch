new file mode 100644
index 0000000..4c7a060
--- /dev/null
+++ b/res/css/views/context_menus/_KebabContextMenu.pcss
@@ -0,0 +1,42 @@
+/*
+Copyright 2022 The Matrix.org Foundation C.I.C.
+SPDX-License-Identifier: Apache-2.0
+*/
+
+.mx_KebabContextMenu {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 32px;
+    height: 32px;
+    border: 0;
+    border-radius: 8px;
+    background: transparent;
+    cursor: pointer;
+    color: $secondary-content;
+
+    &:hover, &:focus-visible {
+        background-color: $quinary-content;
+    }
+
+    &:disabled {
+        opacity: 0.5;
+        cursor: default;
+    }
+}
+
+.mx_KebabContextMenu_icon {
+    display: block;
+    width: 20px;
+    height: 20px;
+    mask: url('$(res)/img/element-icons/room/ellipsis.svg') center / contain no-repeat;
+    background-color: currentColor;
+}
+
+.mx_KebabContextMenu_menu .mx_IconizedContextMenu_optionList_red .mx_IconizedContextMenu_item {
+    &:hover, &:focus-visible {
+        color: $alert;
+        outline: 2px solid $alert;
+        outline-offset: -2px;
+    }
+}
