+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain error\r\n', b'plain error\r\n'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">oops</S></Objs>', b'oops'),
+    (b'before\r\n#< CLIXML\r\n<Objs Version="1">\r\n<S S="Error">oops</S>\r\n</Objs>tail\r\nafter',
+     b'before\r\noopstail\r\nafter'),
+    (b'first\r\n#< CLIXML\r\n<Objs Version="1"><S S="Error">one</S></Objs> middle\r\n'
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">two</S></Objs>end',
+     b'first\r\none middle\r\ntwoend'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">caf\x82</S></Objs>', 'café'.encode()),
+    (b'lead\r\nCLIXML\r\n<Objs Version="1"><S S="Error">text</S></Objs>tail',
+     b'lead\r\ntexttail'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">one</S></Objs>'
+     b'<Objs Version="1"><S S="Error">two</S></Objs>tail',
+     b'one\r\ntwotail'),
+    (b'#< CLIXML\r\n#< CLIXML\r\n<Objs Version="1"><S S="Error">nested</S></Objs>',
+     b'nested'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken</S>\r\n'
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">good</S></Objs>',
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken</S>\r\ngood'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken</S>',
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken</S>'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken</Objs>',
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken</Objs>'),
+])
+def test_replace_stderr_clixml_preserves_surrounding_bytes(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_exec_command_decodes_embedded_windows_clixml():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn._shell = MagicMock(_IS_WINDOWS=True)
+    conn.get_option = MagicMock(return_value='host')
+    conn._build_command = MagicMock(return_value='ssh host')
+    conn._run = MagicMock(return_value=(1, b'', b'before\r\n#< CLIXML\r\n<Objs Version="1"><S S="Error">oops</S></Objs>tail'))
+
+    assert conn.exec_command('command')[2] == b'before\r\noopstail'
+
+
