+_CLIXML_HEADER = re.compile(rb'(?:#< |<# |(?<=\r\n)|^)CLIXML\r\n')
+
+
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML elements in stderr, preserving other bytes."""
+    output = bytearray()
+    cursor = 0
+
+    while header := _CLIXML_HEADER.search(stderr, cursor):
+        start = stderr.find(b'<Objs', header.end())
+        next_header = _CLIXML_HEADER.search(stderr, header.end())
+        content_start = header.end()
+        while (next_header and start != -1 and next_header.start() < start
+               and not stderr[content_start:next_header.start()].strip()):
+            content_start = next_header.end()
+            next_header = _CLIXML_HEADER.search(stderr, content_start)
+        if start == -1 or (next_header and next_header.start() < start):
+            cursor_end = next_header.start() if next_header else len(stderr)
+            output.extend(stderr[cursor:cursor_end])
+            cursor = cursor_end
+            continue
+
+        # The header may be followed by a line break, but unrelated text is
+        # not part of a CLIXML block.
+        if stderr[content_start:start].strip():
+            output.extend(stderr[cursor:header.end()])
+            cursor = header.end()
+            continue
+
+        end = stderr.find(b'</Objs>', start)
+        if end == -1 or (next_header and next_header.start() < end):
+            cursor_end = next_header.start() if next_header else len(stderr)
+            output.extend(stderr[cursor:cursor_end])
+            cursor = cursor_end
+            continue
+
+        end += len(b'</Objs>')
+        # PowerShell can emit several adjacent objects under one header.
+        while more := re.match(rb'\s*<Objs\b', stderr[end:]):
+            following = end + more.end() - len(b'<Objs')
+            close = stderr.find(b'</Objs>', following)
+            if close == -1 or (next_header and next_header.start() < close):
+                break
+            end = close + len(b'</Objs>')
+        block = stderr[header.start():end]
+        try:
+            try:
+                decoded = block.decode('utf-8')
+            except UnicodeDecodeError:
+                decoded = block.decode('cp437')
+            replacement = _parse_clixml(decoded.encode('utf-8'))
+        except (ET.ParseError, ValueError, UnicodeError):
+            replacement = None
+
+        output.extend(stderr[cursor:header.start()])
+        output.extend(block if replacement is None else replacement)
+        cursor = end
+
+    output.extend(stderr[cursor:])
+    return bytes(output)
+
