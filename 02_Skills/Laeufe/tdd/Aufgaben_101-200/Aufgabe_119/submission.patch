+
+import React from "react";
+import { render } from "@testing-library/react";
+
+import { Pill, PillType, pillRoomNotifLen, pillRoomNotifPos } from "../../../../src/components/views/elements/Pill";
+import { stubClient } from "../../../test-utils";
+
+describe("Pill", () => {
+    beforeEach(() => stubClient());
+
+    it("keeps a message permalink verbatim and renders no pill for an unknown target", () => {
+        const url = "https://matrix.to/#/!unknown:example.org?via=example.org";
+        const { container, rerender } = render(<Pill url={url} inMessage />);
+        const link = container.querySelector("bdi > a.mx_Pill.mx_RoomPill");
+        expect(link?.getAttribute("href")).toBe(url);
+        expect(link?.querySelector(".mx_Pill_linkText")?.textContent).toBe("My room");
+
+        rerender(<Pill url="https://example.org/unrelated" inMessage />);
+        expect(container.querySelector("bdi")).toBeNull();
+    });
+
+    it("renders an explicit room mention without a link", () => {
+        const { container } = render(<Pill type={PillType.AtRoomMention} />);
+        expect(container.querySelector("bdi > span.mx_Pill.mx_AtRoomPill .mx_Pill_linkText")?.textContent).toBe(
+            "@room",
+        );
+    });
+
+    it("finds the first room mention token", () => {
+        expect(pillRoomNotifPos("hello @room and @room")).toBe(6);
+        expect(pillRoomNotifPos("hello room")).toBe(-1);
+        expect(pillRoomNotifLen()).toBe(5);
+    });
+});
