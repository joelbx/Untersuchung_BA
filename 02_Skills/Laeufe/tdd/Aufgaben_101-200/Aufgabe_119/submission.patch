+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { ReactElement, useEffect, useState } from "react";
+import { Room } from "matrix-js-sdk/src/models/room";
+import { RoomMember } from "matrix-js-sdk/src/models/room-member";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { MatrixClientPeg } from "../MatrixClientPeg";
+import { getPrimaryPermalinkEntity } from "../utils/permalinks/Permalinks";
+import dis from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+import RoomAvatar from "../components/views/avatars/RoomAvatar";
+import MemberAvatar from "../components/views/avatars/MemberAvatar";
+import { ButtonEvent } from "../components/views/elements/AccessibleButton";
+import { PillType } from "../components/views/elements/Pill";
+
+interface Args {
+    room?: Room;
+    type?: PillType;
+    url?: string;
+}
+
+interface HookResult {
+    avatar: ReactElement | null;
+    text: string | null;
+    onClick: ((e: ButtonEvent) => void) | null;
+    resourceId: string | null;
+    type: PillType | "space" | null;
+}
+
+export function usePermalink({ room, type, url }: Args): HookResult {
+    const resourceId = url ? getPrimaryPermalinkEntity(url) : null;
+    const effectiveType =
+        type ||
+        ({
+            "@": PillType.UserMention,
+            "!": PillType.RoomMention,
+            "#": PillType.RoomMention,
+        }[resourceId?.[0]] as PillType | undefined);
+    const [profile, setProfile] = useState<RoomMember | null>(null);
+    const localMember = effectiveType === PillType.UserMention && resourceId ? room?.getMember(resourceId) : null;
+
+    useEffect(() => {
+        setProfile(null);
+        if (effectiveType !== PillType.UserMention || !resourceId || localMember) return;
+        let active = true;
+        const member = new RoomMember(null, resourceId);
+        MatrixClientPeg.get()
+            .getProfileInfo(resourceId)
+            .then((resp) => {
+                if (!active) return;
+                member.name = resp.displayname;
+                member.rawDisplayName = resp.displayname;
+                member.events.member = {
+                    getContent: () => ({ avatar_url: resp.avatar_url }),
+                    getDirectionalContent: () => ({ avatar_url: resp.avatar_url }),
+                } as MatrixEvent;
+                setProfile(member);
+            })
+            .catch((err) => logger.error("Could not retrieve profile data for " + resourceId + ":", err));
+        return () => {
+            active = false;
+        };
+    }, [effectiveType, resourceId, localMember]);
+
+    const empty: HookResult = { avatar: null, text: null, onClick: null, resourceId: null, type: null };
+    if (effectiveType === PillType.AtRoomMention) {
+        return {
+            avatar: room?.getMxcAvatarUrl() ? (
+                <RoomAvatar room={room} width={16} height={16} aria-hidden="true" />
+            ) : null,
+            text: "@room",
+            onClick: null,
+            resourceId: room?.roomId || null,
+            type: PillType.AtRoomMention,
+        };
+    }
+    if (!resourceId) return empty;
+    if (effectiveType === PillType.RoomMention && (resourceId[0] === "!" || resourceId[0] === "#")) {
+        const client = MatrixClientPeg.get();
+        const target =
+            resourceId[0] === "#"
+                ? client
+                      .getRooms()
+                      .find((r) => r.getCanonicalAlias() === resourceId || r.getAltAliases().includes(resourceId))
+                : client.getRoom(resourceId);
+        return {
+            avatar: target?.getMxcAvatarUrl() ? (
+                <RoomAvatar room={target} width={16} height={16} aria-hidden="true" />
+            ) : null,
+            text: target?.name || resourceId,
+            onClick: null,
+            resourceId,
+            type: target?.isSpaceRoom() ? "space" : PillType.RoomMention,
+        };
+    }
+    if (effectiveType === PillType.UserMention && resourceId[0] === "@") {
+        const member = localMember || profile || new RoomMember(null, resourceId);
+        return {
+            avatar: member.getMxcAvatarUrl() ? (
+                <MemberAvatar member={member} width={16} height={16} aria-hidden="true" hideTitle />
+            ) : null,
+            text: member.rawDisplayName || resourceId,
+            onClick: (e: ButtonEvent) => {
+                e.preventDefault();
+                dis.dispatch({ action: Action.ViewUser, member });
+            },
+            resourceId,
+            type: PillType.UserMention,
+        };
+    }
+    return empty;
+}
