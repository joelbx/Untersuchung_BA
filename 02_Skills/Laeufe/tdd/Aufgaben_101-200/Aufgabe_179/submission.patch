+// TestUpdateRemoteClusterPersistsStatus catches updates that lose status,
+// heartbeat, or expiry when the resource is stored again.
+func (s *PresenceSuite) TestUpdateRemoteClusterPersistsStatus(c *check.C) {
+	ctx := context.Background()
+	service := NewPresenceService(s.bk)
+	rc, err := services.NewRemoteCluster("remote.example")
+	c.Assert(err, check.IsNil)
+	c.Assert(service.CreateRemoteCluster(rc), check.IsNil)
+
+	heartbeat := time.Date(2020, 1, 2, 3, 4, 5, 0, time.UTC)
+	expiry := time.Now().UTC().Add(time.Hour).Truncate(time.Second)
+	rc.SetConnectionStatus(teleport.RemoteClusterStatusOnline)
+	rc.SetLastHeartbeat(heartbeat)
+	rc.SetExpiry(expiry)
+	c.Assert(service.UpdateRemoteCluster(ctx, rc), check.IsNil)
+
+	got, err := service.GetRemoteCluster(rc.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOnline)
+	c.Assert(got.GetLastHeartbeat().Equal(heartbeat), check.Equals, true)
+	item, err := s.bk.Get(ctx, backend.Key(remoteClustersPrefix, rc.GetName()))
+	c.Assert(err, check.IsNil)
+	c.Assert(item.Expires.Equal(expiry), check.Equals, true)
+}
