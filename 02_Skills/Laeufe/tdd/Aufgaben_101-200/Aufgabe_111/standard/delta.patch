+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/constant"
+)
+
+func TestGetAmazonLinuxVersion(t *testing.T) {
+	tests := []struct {
+		release string
+		want    string
+	}{
+		{"2018.03", "1"},
+		{"2018.03.1", "unknown"},
+		{"1", "1"},
+		{"2", "2"},
+		{"2 (Karoo)", "2"},
+		{"2022 (Amazon Linux)", "2022"},
+		{"2023", "2023"},
+		{"2023 (Amazon Linux)", "2023"},
+		{"2025", "2025"},
+		{"2027", "2027"},
+		{"2029", "2029"},
+		{"2024 (Amazon Linux)", "unknown"},
+		{"", "unknown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.want {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAmazonLinuxEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		until   time.Time
+	}{
+		{"2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2025", time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2027", time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2029", time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(constant.Amazon, tt.release+" (Amazon Linux)")
+			if !found {
+				t.Fatal("expected EOL information")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("standard support ends at %s, want %s", eol.StandardSupportUntil, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSuppportEnded(tt.until) {
+				t.Error("support ended before its end date")
+			}
+			after := tt.until.Add(time.Second)
+			if !eol.IsStandardSupportEnded(after) || !eol.IsExtendedSuppportEnded(after) {
+				t.Error("support remains active after its end date")
+			}
+		})
+	}
+	if _, found := GetEOL(constant.Amazon, "2024 (Amazon Linux)"); found {
+		t.Error("unrecognized Amazon Linux release has EOL information")
+	}
+}
