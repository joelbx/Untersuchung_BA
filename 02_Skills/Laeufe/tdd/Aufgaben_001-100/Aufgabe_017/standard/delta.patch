+package conntest
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/gravitational/teleport/lib/client/conntest/database"
+	"github.com/gravitational/teleport/lib/defaults"
+)
+
+func TestSQLServerDatabaseConnTester(t *testing.T) {
+	p, err := getDatabaseConnTester(defaults.ProtocolSQLServer)
+	require.NoError(t, err)
+	require.IsType(t, &database.SQLServerPinger{}, p)
+
+	p, err = getDatabaseConnTester("unsupported")
+	require.Error(t, err)
+	require.Nil(t, p)
+}
