+def _expand_module_util_redirect(redirect):
+    if redirect.startswith(('ansible_collections.', 'ansible.module_utils.')):
+        return redirect
+    parts = redirect.split('.')
+    if len(parts) < 3:
+        raise AnsibleError('Invalid module_utils redirect %s' % redirect)
+    return '.'.join(('ansible_collections', parts[0], parts[1], 'plugins', 'module_utils') + tuple(parts[2:]))
