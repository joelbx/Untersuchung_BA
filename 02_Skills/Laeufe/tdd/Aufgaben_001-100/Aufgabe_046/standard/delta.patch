+import zipfile
+from io import BytesIO
+
+import pytest
+
+from ansible.errors import AnsibleError
+from ansible.executor import module_common
+
+
+def payload(source, files, routing=None, monkeypatch=None):
+    def get_data(collection, path):
+        return files.get((collection, path))
+
+    monkeypatch.setattr(module_common.pkgutil, 'get_data', get_data)
+    monkeypatch.setattr(module_common, '_get_collection_metadata',
+                        lambda collection: {'plugin_routing': {'module_utils': (routing or {}).get(collection, {})}})
+    output = BytesIO()
+    with zipfile.ZipFile(output, 'w') as archive:
+        module_common.recursive_finder('sample', 'ansible_collections.ns.coll.plugins.modules.sample',
+                                       source, set(), {}, archive)
+    with zipfile.ZipFile(BytesIO(output.getvalue())) as archive:
+        return {name: archive.read(name) for name in archive.namelist()}
+
+
+def test_package_initializer_relative_imports_are_bundled(monkeypatch):
+    files = {
+        ('ansible_collections.ns.coll', 'plugins/module_utils/pkg/__init__.py'): b'from .sub import X\nfrom ..cousin.leaf import Y\n',
+        ('ansible_collections.ns.coll', 'plugins/module_utils/pkg/sub.py'): b'X = 1\n',
+        ('ansible_collections.ns.coll', 'plugins/module_utils/cousin/leaf.py'): b'Y = 2\n',
+    }
+    result = payload(b'import ansible_collections.ns.coll.plugins.module_utils.pkg\n', files, monkeypatch=monkeypatch)
+    assert result['ansible_collections/ns/coll/plugins/module_utils/pkg/__init__.py'] == files[('ansible_collections.ns.coll', 'plugins/module_utils/pkg/__init__.py')]
+    assert result['ansible_collections/ns/coll/plugins/module_utils/pkg/sub.py'] == b'X = 1\n'
+    assert result['ansible_collections/ns/coll/plugins/module_utils/cousin/leaf.py'] == b'Y = 2\n'
+    assert result['ansible_collections/ns/coll/plugins/module_utils/cousin/__init__.py'] == b''
+    for directory in ('ansible_collections', 'ansible_collections/ns',
+                      'ansible_collections/ns/coll', 'ansible_collections/ns/coll/plugins',
+                      'ansible_collections/ns/coll/plugins/module_utils'):
+        assert result[directory + '/__init__.py'] == b''
+
+
+def test_redirected_module_shim_and_target_are_bundled(monkeypatch):
+    files = {('ansible_collections.other.place', 'plugins/module_utils/target.py'): b'VALUE = 42\n'}
+    routing = {'ns.coll': {'alias': {'redirect': 'other.place.target'}}}
+    result = payload(b'import ansible_collections.ns.coll.plugins.module_utils.alias\n', files, routing, monkeypatch)
+    assert b'ansible_collections.other.place.plugins.module_utils.target' in result['ansible_collections/ns/coll/plugins/module_utils/alias.py']
+    assert result['ansible_collections/other/place/plugins/module_utils/target.py'] == b'VALUE = 42\n'
+
+
+def test_missing_collection_reports_collection_name(monkeypatch):
+    def missing(collection):
+        raise ValueError('unable to locate collection ' + collection)
+    monkeypatch.setattr(module_common, '_get_collection_metadata', missing)
+    with pytest.raises(AnsibleError, match='unable to locate collection ns.coll'):
+        module_common.CollectionModuleUtilLocator(('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'missing'))
+
+
+def test_missing_dependency_lists_attempted_names(monkeypatch):
+    with pytest.raises(AnsibleError, match=r'Looked for \(ansible_collections.ns.coll.plugins.module_utils.pkg.missing, ansible_collections.ns.coll.plugins.module_utils.pkg\)'):
+        payload(b'from ansible_collections.ns.coll.plugins.module_utils.pkg import missing\n', {}, monkeypatch=monkeypatch)
+
+
+def test_legacy_metadata_redirect_bundles_collection_target(monkeypatch):
+    files = {('ansible_collections.other.place', 'plugins/module_utils/target.py'): b'VALUE = 42\n'}
+    routing = {'ansible.builtin': {'unique_missing_util_for_test': {'redirect': 'other.place.target'}}}
+    result = payload(b'import ansible.module_utils.unique_missing_util_for_test\n', files, routing, monkeypatch)
+    assert b'ansible_collections.other.place.plugins.module_utils.target' in result['ansible/module_utils/unique_missing_util_for_test.py']
+    assert result['ansible_collections/other/place/plugins/module_utils/target.py'] == b'VALUE = 42\n'
+
+
+def test_nested_legacy_metadata_redirect_uses_full_route_name(monkeypatch):
+    files = {('ansible_collections.other.place', 'plugins/module_utils/target.py'): b'VALUE = 42\n'}
+    routing = {'ansible.builtin': {'nested.unique_missing_util_for_test': {'redirect': 'other.place.target'}}}
+    result = payload(b'import ansible.module_utils.nested.unique_missing_util_for_test\n', files, routing, monkeypatch)
+    assert b'ansible_collections.other.place.plugins.module_utils.target' in result['ansible/module_utils/nested/unique_missing_util_for_test.py']
+
+
+def test_redirected_package_child_is_bundled(monkeypatch):
+    files = {
+        ('ansible_collections.other.place', 'plugins/module_utils/target/__init__.py'): b'from .sub import VALUE\n',
+        ('ansible_collections.other.place', 'plugins/module_utils/target/sub.py'): b'VALUE = 42\n',
+    }
+    routing = {'ns.coll': {'alias': {'redirect': 'other.place.target'}}}
+    result = payload(b'import ansible_collections.ns.coll.plugins.module_utils.alias.sub\n', files, routing, monkeypatch)
+    assert b'ansible_collections.other.place.plugins.module_utils.target' in result['ansible_collections/ns/coll/plugins/module_utils/alias/__init__.py']
+    assert result['ansible_collections/other/place/plugins/module_utils/target/sub.py'] == b'VALUE = 42\n'
+
+
+def test_redirect_deprecation_is_emitted_when_resolved(monkeypatch):
+    monkeypatch.setattr(module_common.C, 'DEPRECATION_WARNINGS', True)
+    files = {('ansible_collections.other.place', 'plugins/module_utils/target.py'): b'VALUE = 42\n'}
+    routing = {'ns.coll': {'old': {'redirect': 'other.place.target',
+                                  'deprecation': {'warning_text': 'use target', 'removal_version': '3.0',
+                                                  'removal_date': '2028-01-01'}}}}
+    payload(b'import ansible_collections.ns.coll.plugins.module_utils.old\n', files, routing, monkeypatch)
+    warning = '\n'.join(module_common.display._deprecations)
+    assert 'use target' in warning
+    assert '3.0' in warning
+    assert '2028-01-01' in warning
+
+
+def test_tombstone_reports_removal_and_collection(monkeypatch):
+    routing = {'ns.coll': {'old': {'tombstone': {'warning_text': 'old util removed',
+                                               'removal_version': '3.0', 'removal_date': '2028-01-01'}}}}
+    with pytest.raises(AnsibleError) as exc:
+        payload(b'import ansible_collections.ns.coll.plugins.module_utils.old\n', {}, routing, monkeypatch)
+    message = str(exc.value)
+    assert 'old util removed' in message
+    assert '3.0' in message
+    assert '2028-01-01' in message
+    assert 'ns.coll' in message
