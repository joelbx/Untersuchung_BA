+def _emit_routing_deprecation(details, collection, removed=False):
+    warning = details.get('warning_text', '')
+    version = details.get('removal_version')
+    date = details.get('removal_date')
+    if version and date:
+        warning += ' (removal version %s)' % version
+    display.deprecated(warning, version=version, date=date, collection_name=collection, removed=removed)
