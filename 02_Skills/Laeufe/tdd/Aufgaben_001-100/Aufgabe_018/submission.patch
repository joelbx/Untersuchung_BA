+func TestLoadCorsAllowedOriginsWhitespace(t *testing.T) {
+	cases := []struct {
+		name  string
+		value string
+		want  []string
+	}{
+		{"repeated spaces", "foo.com bar.com  baz.com", []string{"foo.com", "bar.com", "baz.com"}},
+		{"mixed whitespace", " \tfoo.com\nbar.com\t \nbaz.com \t", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty string", "", []string{}},
+		{"whitespace only", " \t\n ", []string{}},
+	}
+
+	for _, tt := range cases {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: "+fmt.Sprintf("%q", tt.value)+"\n"), 0600))
+
+			t.Run("YAML", func(t *testing.T) {
+				cfg, err := Load(path)
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+			})
+
+			t.Run("ENV", func(t *testing.T) {
+				t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", tt.value)
+				cfg, err := Load("./testdata/default.yml")
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+			})
+		})
+	}
+}
+
+func TestLoadCorsAllowedOriginsSequence(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: [foo.com, bar.com]\n"), 0600))
+
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"foo.com", "bar.com"}, cfg.Cors.AllowedOrigins)
+}
+
+func TestSliceDecodeHookLeavesOtherTypesUnchanged(t *testing.T) {
+	cases := []struct {
+		name   string
+		value  any
+		target any
+	}{
+		{"string to other slice", "foo bar", []int{}},
+		{"slice to string slice", []string{"foo bar"}, []string{}},
+		{"integer to string slice", 42, []string{}},
+	}
+
+	for _, tt := range cases {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := mapstructure.DecodeHookExec(decodeHooks, reflect.ValueOf(tt.value), reflect.ValueOf(tt.target))
+			require.NoError(t, err)
+			assert.Equal(t, tt.value, got)
+		})
+	}
+}
