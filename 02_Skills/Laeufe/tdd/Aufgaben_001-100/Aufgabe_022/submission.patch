+func TestParseInstalledPackagesLineKeepsBinaryWhenSourceFilenameIsMalformed(t *testing.T) {
+	o := &redhatBase{}
+	bp, sp, err := o.parseInstalledPackagesLine("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)")
+	if err != nil {
+		t.Fatalf("parseInstalledPackagesLine() error = %v", err)
+	}
+	want := &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"}
+	if !reflect.DeepEqual(bp, want) || sp != nil {
+		t.Errorf("packages = (%#v, %#v), want (%#v, nil)", bp, sp, want)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("warnings = %v, want source filename warning", o.warns)
+	}
+}
+
+func TestParseInstalledPackagesLineUsesEpochInSourceFilename(t *testing.T) {
+	o := &redhatBase{}
+	bp, sp, err := o.parseInstalledPackagesLine("bar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatalf("parseInstalledPackagesLine() error = %v", err)
+	}
+	wantBP := &models.Package{Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64"}
+	wantSP := &models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}}
+	if !reflect.DeepEqual(bp, wantBP) || !reflect.DeepEqual(sp, wantSP) {
+		t.Errorf("packages = (%#v, %#v), want (%#v, %#v)", bp, sp, wantBP, wantSP)
+	}
+}
+
+func TestSplitFileNameRemovesEpochFromSourceName(t *testing.T) {
+	name, version, release, err := splitFileName("1:bar-9-123a.src.rpm")
+	if err != nil || name != "bar" || version != "9" || release != "123a" {
+		t.Errorf("splitFileName() = (%q, %q, %q, %v), want (bar, 9, 123a, nil)", name, version, release, err)
+	}
+}
+
+func TestParseInstalledPackagesContinuesAfterMalformedSourceFilename(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Alma, Release: "9.0"}}}
+	bps, sps, err := o.parseInstalledPackages("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatalf("parseInstalledPackages() error = %v", err)
+	}
+	if len(bps) != 2 || bps["elasticsearch"].Version != "8.17.0" || bps["bar"].Version != "1:9" {
+		t.Errorf("binary packages = %#v", bps)
+	}
+	wantSP := models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}}
+	if len(sps) != 1 || !reflect.DeepEqual(sps["bar"], wantSP) {
+		t.Errorf("source packages = %#v, want bar %#v", sps, wantSP)
+	}
+	if len(o.warns) != 1 {
+		t.Errorf("warnings = %v, want one", o.warns)
+	}
+}
