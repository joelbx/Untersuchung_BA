diff --git a/test/ansible_test/validate-modules-unit/test_deprecation_dates.py b/test/ansible_test/validate-modules-unit/test_deprecation_dates.py
new file mode 100644
index 0000000..842548f
--- /dev/null
+++ b/test/ansible_test/validate-modules-unit/test_deprecation_dates.py
@@ -0,0 +1,27 @@
+"""Argument spec date validation."""
+
+import pytest
+from voluptuous import Invalid
+
+from validate_modules.schema import argument_spec_schema
+
+
+def test_argument_spec_accepts_date_deprecations():
+    spec = {'old': {'type': 'str', 'removed_at_date': '2030-12-31',
+                    'aliases': ['alias'], 'deprecated_aliases': [{'name': 'alias', 'date': '2030-12-31'}]}}
+    assert argument_spec_schema()(spec) == spec
+
+
+@pytest.mark.parametrize('deprecation', [
+    {'name': 'alias'},
+    {'name': 'alias', 'version': '2.14', 'date': '2030-12-31'},
+])
+def test_argument_spec_requires_one_alias_removal_target(deprecation):
+    with pytest.raises(Invalid):
+        argument_spec_schema()({'old': {'deprecated_aliases': [deprecation]}})
+
+
+@pytest.mark.parametrize('date', ['2030-02-30', '2030/12/31'])
+def test_argument_spec_rejects_invalid_removal_date(date):
+    with pytest.raises(Invalid):
+        argument_spec_schema()({'old': {'removed_at_date': date}})
