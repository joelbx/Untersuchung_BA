--- a/tests/unit/misc/test_earlyinit.py
+++ b/tests/unit/misc/test_earlyinit.py
@@ -20,10 +20,64 @@
 """Test qutebrowser.misc.earlyinit."""
 
 import sys
+import argparse
 
 import pytest
 
 from qutebrowser.misc import earlyinit
+from qutebrowser.qt import machinery
+
+
+def test_check_qt_available_rejects_missing_wrapper():
+    info = machinery.SelectionInfo(
+        reason=machinery.SelectionReason.auto,
+        pyqt5="ImportError: missing PyQt5", pyqt6="ImportError: missing PyQt6",
+    )
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        earlyinit.check_qt_available(info)
+    assert excinfo.value.info is info
+    assert str(excinfo.value).startswith("No Qt wrapper was importable.\n\n\n")
+
+
+def test_check_qt_available_error_has_trailing_blank_lines(monkeypatch, capsys):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.cli,
+    )
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+
+    def missing(name):
+        raise ImportError(f"missing {name}")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", missing)
+    with pytest.raises(SystemExit):
+        earlyinit.check_qt_available(info)
+    error = capsys.readouterr().err
+    assert "missing PyQt5.QtCore" in error
+    assert error.endswith("\n\n\n")
+
+
+def test_early_init_checks_selected_info(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    monkeypatch.setattr(machinery, "init", lambda args: info)
+    monkeypatch.setattr(earlyinit, "init_faulthandler", lambda: None)
+    monkeypatch.setattr(earlyinit, "init_log", lambda args: None)
+    monkeypatch.setattr(earlyinit, "check_libraries", lambda: None)
+    monkeypatch.setattr(earlyinit, "check_qt_version", lambda: None)
+    monkeypatch.setattr(earlyinit, "configure_pyqt", lambda: None)
+    monkeypatch.setattr(earlyinit, "check_ssl_support", lambda: None)
+    monkeypatch.setattr(earlyinit, "check_optimize_flag", lambda: None)
+    monkeypatch.setattr(earlyinit, "webengine_early_import", lambda: None)
+
+    class CheckedInfo(Exception):
+        pass
+
+    def check(received):
+        assert received is info
+        raise CheckedInfo
+
+    monkeypatch.setattr(earlyinit, "check_qt_available", check, raising=False)
+    with pytest.raises(CheckedInfo):
+        earlyinit.early_init(argparse.Namespace(qt_wrapper="PyQt5"))
 
 
 @pytest.mark.parametrize('attr', ['stderr', '__stderr__'])
