+package info
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestFliptServesJSON(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	Flipt{Version: "1.2.3"}.ServeHTTP(recorder, httptest.NewRequest("GET", "/info", nil))
+	var got map[string]interface{}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["version"] != "1.2.3" {
+		t.Fatalf("version=%v", got["version"])
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..a559984
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,207 @@
+// Package telemetry reports anonymous installation usage.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const schemaVersion = "1.0"
+const interval = 4 * time.Hour
+
+// FliptVersion is set by the executable from its build version.
+var FliptVersion = "dev"
+
+// endpoint is kept private so only anonymous payloads can be sent by this package.
+var endpoint = "https://telemetry.flipt.io/v1/track"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter stores a stable anonymous identifier and reports periodic pings.
+type Reporter struct {
+	mu     sync.Mutex
+	state  state
+	path   string
+	client *http.Client
+	logger logrus.FieldLogger
+}
+
+// NewReporter initializes telemetry when enabled. An unusable state path disables telemetry.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding telemetry state directory: %w", err)
+		}
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		if logger != nil {
+			logger.Warnf("telemetry disabled: creating state directory: %v", err)
+		}
+		return nil, nil
+	}
+	path := filepath.Join(dir, "telemetry.json")
+	r := &Reporter{path: path, client: &http.Client{Timeout: 10 * time.Second}, logger: logger}
+	data, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if e := json.Unmarshal(data, &r.state); e != nil && logger != nil {
+			logger.Warnf("invalid telemetry state: %v", e)
+		}
+	}
+	parsedID, parseErr := uuid.FromString(r.state.UUID)
+	if parseErr != nil || parsedID == uuid.Nil {
+		id, e := uuid.NewV4()
+		if e != nil {
+			return nil, fmt.Errorf("generating telemetry identifier: %w", e)
+		}
+		r.state.UUID = id.String()
+	}
+	r.state.Version = schemaVersion
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		r.state.LastTimestamp = time.Time{}.UTC().Format(time.RFC3339)
+	}
+	if err := r.save(); err != nil {
+		return nil, fmt.Errorf("writing telemetry state: %w", err)
+	}
+	return r, nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.Marshal(r.state)
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(r.path)
+	file, err := os.CreateTemp(dir, ".telemetry-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	if err := file.Chmod(0600); err != nil {
+		file.Close()
+		return err
+	}
+	if _, err := file.Write(data); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	return os.Rename(file.Name(), r.path)
+}
+
+// Report sends one anonymous ping and persists the successful report time.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	payload := struct {
+		Event       string `json:"event"`
+		AnonymousID string `json:"anonymousId"`
+		Properties  struct {
+			UUID    string `json:"uuid"`
+			Version string `json:"version"`
+			Flipt   struct {
+				Version string `json:"version"`
+			} `json:"flipt"`
+		} `json:"properties"`
+	}{Event: "flipt.ping", AnonymousID: r.state.UUID}
+	payload.Properties.UUID = r.state.UUID
+	payload.Properties.Version = r.state.Version
+	payload.Properties.Flipt.Version = FliptVersion
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return r.logError(err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(data))
+	if err != nil {
+		return r.logError(err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return r.logError(fmt.Errorf("sending telemetry: %w", err))
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return r.logError(fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode))
+	}
+	previous := r.state.LastTimestamp
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.save(); err != nil {
+		r.state.LastTimestamp = previous
+		return r.logError(fmt.Errorf("writing telemetry state: %w", err))
+	}
+	return nil
+}
+
+func (r *Reporter) logError(err error) error {
+	if r.logger != nil {
+		r.logger.Warnf("telemetry: %v", err)
+	}
+	return err
+}
+
+// Start begins the background reporting loop. Cancellation stops the loop.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			wait := time.Until(last.Add(interval))
+			if wait > 0 {
+				timer := time.NewTimer(wait)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if err := r.Report(ctx); err != nil {
+				timer := time.NewTimer(interval)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+		}
+	}()
+}
