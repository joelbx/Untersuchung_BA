+func TestTelemetryDefaultsAndEnvironmentOverrides(t *testing.T) {
+	cfg, err := Load("./testdata/default.yml")
+	require.NoError(t, err)
+	assert.True(t, cfg.Meta.TelemetryEnabled)
+
+	oldEnabled, hadEnabled := os.LookupEnv("FLIPT_META_TELEMETRY_ENABLED")
+	oldDirectory, hadDirectory := os.LookupEnv("FLIPT_META_STATE_DIRECTORY")
+	t.Cleanup(func() {
+		if hadEnabled {
+			_ = os.Setenv("FLIPT_META_TELEMETRY_ENABLED", oldEnabled)
+		} else {
+			_ = os.Unsetenv("FLIPT_META_TELEMETRY_ENABLED")
+		}
+		if hadDirectory {
+			_ = os.Setenv("FLIPT_META_STATE_DIRECTORY", oldDirectory)
+		} else {
+			_ = os.Unsetenv("FLIPT_META_STATE_DIRECTORY")
+		}
+	})
+	require.NoError(t, os.Setenv("FLIPT_META_TELEMETRY_ENABLED", "false"))
+	require.NoError(t, os.Setenv("FLIPT_META_STATE_DIRECTORY", t.TempDir()))
+	cfg, err = Load("./testdata/default.yml")
+	require.NoError(t, err)
+	assert.False(t, cfg.Meta.TelemetryEnabled)
+	assert.Equal(t, os.Getenv("FLIPT_META_STATE_DIRECTORY"), cfg.Meta.StateDirectory)
+}
