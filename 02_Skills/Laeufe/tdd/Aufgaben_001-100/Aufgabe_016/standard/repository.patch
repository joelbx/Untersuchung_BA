@@ -0,0 +1,111 @@
+import io
+from unittest.mock import patch
+
+import pytest
+from apscheduler.schedulers.asyncio import AsyncIOScheduler
+
+from scripts.monitoring import utils
+
+
+def test_async_scheduler_keeps_function_name_for_decorated_job(monkeypatch):
+    monkeypatch.setenv("HOSTNAME", "ol-web0.us.archive.org")
+    assert hasattr(utils, "OlAsyncIOScheduler")
+    scheduler = utils.OlAsyncIOScheduler()
+
+    @utils.limit_server(["ol-web*"], scheduler)
+    @scheduler.scheduled_job("interval", seconds=60)
+    async def collect():
+        pass
+
+    assert isinstance(scheduler, AsyncIOScheduler)
+    assert scheduler.get_job("collect").func is collect
+
+
+@pytest.mark.parametrize("hostname", ["ol-web1", "other-server", "ol-web0.evil.org"])
+def test_limiter_skips_unmatched_hosts(monkeypatch, hostname):
+    monkeypatch.setenv("HOSTNAME", hostname)
+    assert hasattr(utils, "OlAsyncIOScheduler")
+    scheduler = utils.OlAsyncIOScheduler()
+
+    @utils.limit_server(["ol-web0"], scheduler)
+    @scheduler.scheduled_job("interval", seconds=60)
+    async def collect():
+        pass
+
+    assert scheduler.get_job("collect") is None
+
+
+def test_service_ip_uses_docker_inspect():
+    with patch("subprocess.check_output", return_value=b"172.18.0.4\n") as inspect:
+        assert utils.get_service_ip("web_haproxy") == "172.18.0.4"
+    assert inspect.call_args.args[0][-1] == "openlibrary-web_haproxy-1"
+
+
+def test_haproxy_capture_produces_numeric_graphite_event():
+    from scripts.monitoring.haproxy_monitor import HaproxyCapture
+
+    capture = HaproxyCapture(r"^frontend$", r"^FRONTEND$", ["scur", "rate"])
+    row = {"pxname": "frontend", "svname": "FRONTEND", "scur": "12", "rate": "3"}
+    events = list(capture.to_graphite_events("stats.ol.haproxy", row, 100.5))
+    assert [event.serialize() for event in events] == [
+        ("stats.ol.haproxy.frontend.FRONTEND.scur", (100, 12.0)),
+        ("stats.ol.haproxy.frontend.FRONTEND.rate", (100, 3.0)),
+    ]
+
+
+def test_fetch_events_parses_haproxy_csv(monkeypatch):
+    from scripts.monitoring import haproxy_monitor
+
+    csv = b"# pxname,svname,scur,rate,qcur\nweb,FRONTEND,5,2,0\n"
+    monkeypatch.setattr(haproxy_monitor, "TO_CAPTURE", [haproxy_monitor.HaproxyCapture("web", "FRONTEND", ["scur", "rate", "qcur"])])
+    with patch("urllib.request.urlopen", return_value=io.BytesIO(csv)) as urlopen:
+        events = list(haproxy_monitor.fetch_events("http://example/admin?stats", "test", 120))
+    urlopen.assert_called_once_with("http://example/admin?stats;csv")
+    assert [event.serialize() for event in events] == [
+        ("test.web.FRONTEND.scur", (120, 5.0)),
+        ("test.web.FRONTEND.rate", (120, 2.0)),
+        ("test.web.FRONTEND.qcur", (120, 0.0)),
+    ]
+
+
+def test_monitor_registers_haproxy_job_on_web_host(monkeypatch):
+    import importlib
+    import sys
+
+    monkeypatch.setenv("HOSTNAME", "ol-web0.us.archive.org")
+    monkeypatch.setattr("apscheduler.schedulers.blocking.BlockingScheduler.start", lambda self: None)
+    sys.modules.pop("scripts.monitoring.monitor", None)
+    monitor = importlib.import_module("scripts.monitoring.monitor")
+    assert isinstance(monitor.scheduler, AsyncIOScheduler)
+    assert monitor.scheduler.get_job("monitor_haproxy") is not None
+
+
+def test_limiter_skips_job_when_hostname_is_absent(monkeypatch):
+    monkeypatch.delenv("HOSTNAME", raising=False)
+    scheduler = utils.OlAsyncIOScheduler()
+
+    @utils.limit_server(["ol-web0"], scheduler)
+    @scheduler.scheduled_job("interval", seconds=60)
+    async def collect():
+        pass
+
+    assert scheduler.get_job("collect") is None
+
+
+@pytest.mark.asyncio
+async def test_monitor_haproxy_uses_container_admin_port(monkeypatch):
+    import importlib
+    import sys
+
+    monkeypatch.setenv("HOSTNAME", "ol-web0")
+    sys.modules.pop("scripts.monitoring.monitor", None)
+    monitor = importlib.import_module("scripts.monitoring.monitor")
+    monkeypatch.setattr(monitor, "get_service_ip", lambda name: "172.18.0.4")
+    calls = []
+
+    async def collect(**kwargs):
+        calls.append(kwargs)
+
+    monkeypatch.setattr(monitor.haproxy_monitor, "main", collect)
+    await monitor.monitor_haproxy()
+    assert calls == [{"haproxy_url": "http://172.18.0.4:7072/admin?stats", "dry_run": False}]
