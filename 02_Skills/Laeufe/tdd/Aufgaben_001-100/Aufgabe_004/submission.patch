+import type { PassBridge, PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { ItemState } from '@proton/pass/types';
+import { UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+
+import { fetchPassAliases, filterPassAliases } from './PassAliasesProvider.helpers';
+import type { PassAliasesVault } from './interface';
+
+const alias = (state: ItemState, revisionTime: number, lastUseTime?: number): PassBridgeAliasItem =>
+    ({ item: { state, revisionTime, lastUseTime } }) as PassBridgeAliasItem;
+
+it('excludes trashed aliases and orders active aliases by last use or revision time', () => {
+    const old = alias(ItemState.Active, 10);
+    const used = alias(ItemState.Active, 5, 30);
+    const recent = alias(ItemState.Active, 20);
+    const trashed = alias(ItemState.Trashed, 40);
+
+    expect(filterPassAliases([old, trashed, recent, used])).toEqual([used, recent, old]);
+});
+
+it('fetches aliases and access with a five minute TTL and returns the filtered list', async () => {
+    const active = alias(ItemState.Active, 10);
+    const trashed = alias(ItemState.Trashed, 20);
+    const getAllByShareId = jest.fn().mockResolvedValue([trashed, active]);
+    const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 7 } });
+    const bridge = { alias: { getAllByShareId }, user: { getUserAccess } } as unknown as PassBridge;
+    const vault = { shareId: 'vault' } as PassAliasesVault;
+
+    await expect(fetchPassAliases(bridge, vault)).resolves.toEqual({
+        aliasesCountLimit: 7,
+        filteredAliases: [active],
+        aliases: [trashed, active],
+    });
+    expect(getAllByShareId).toHaveBeenCalledWith('vault', { maxAge: UNIX_MINUTE * 5 });
+    expect(getUserAccess).toHaveBeenCalledWith({ maxAge: UNIX_MINUTE * 5 });
+});
