+jest.mock('@proton/pass/lib/crypto', () => ({ exposePassCrypto: jest.fn(() => ({})) }));
+jest.mock('@proton/pass/lib/crypto/pass-crypto', () => ({ createPassCrypto: jest.fn() }));
+jest.mock('@proton/pass/lib/shares/share.requests', () => ({ requestShares: jest.fn() }));
+jest.mock('@proton/pass/lib/vaults/vault.requests', () => ({ createVault: jest.fn() }));
+
+it('returns no default vault without creating one, then creates it explicitly', async () => {
+    (requestShares as jest.Mock).mockResolvedValue([]);
+    const vault = { shareId: 'created' } as any;
+    (createVault as jest.Mock).mockResolvedValue(vault);
+    const bridge = createPassBridge(jest.fn() as any);
+
+    await expect(bridge.vault.getDefault({ maxAge: 0 })).resolves.toBeUndefined();
+    expect(createVault).not.toHaveBeenCalled();
+    await expect(bridge.vault.createDefaultVault()).resolves.toBe(vault);
+    expect(createVault).toHaveBeenCalledWith({
+        content: { name: 'Personal', description: 'Personal vault (created from Mail)', display: {} },
+    });
+});
