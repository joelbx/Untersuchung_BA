+
+import React from 'react';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'DEVICE', display_name: 'Old name', isVerified: false };
+
+    it('shows the device ID when the display name is undefined', () => {
+        render(<DeviceDetailHeading device={{ ...device, display_name: undefined }} saveDeviceName={jest.fn()} />);
+        expect(screen.getByTestId('device-detail-heading').textContent).toContain('DEVICE');
+    });
+
+    it('saves a changed name and returns to the read view', async () => {
+        let finish: () => void;
+        const saveDeviceName = jest.fn(() => new Promise<void>(resolve => { finish = resolve; }));
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        expect(screen.getByTestId('device-detail-name-input').getAttribute('maxLength')).toBe('100');
+        expect(screen.getByTestId('device-detail-name-edit').textContent).toContain('visible to others');
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        expect(saveDeviceName).toHaveBeenCalledWith('DEVICE', 'Work Laptop');
+        expect(screen.getByTestId('device-detail-name-saving')).toBeTruthy();
+        finish!();
+        await waitFor(() => expect(screen.getByTestId('device-detail-heading').textContent).toContain('Work Laptop'));
+        expect(screen.queryByTestId('device-detail-name-edit')).toBeNull();
+    });
+
+    it('accepts an empty name and skips saving an unchanged name', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: '' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(screen.getByTestId('device-detail-heading')).toBeTruthy());
+        expect(saveDeviceName).toHaveBeenCalledWith('DEVICE', '');
+    });
+
+    it('cancels without saving', () => {
+        const saveDeviceName = jest.fn();
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Other' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-cancel'));
+        expect(screen.getByTestId('device-detail-heading').textContent).toContain('Old name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('shows a failed save without changing the visible name', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('Network unavailable'));
+        render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(screen.getByTestId('device-detail-rename'));
+        fireEvent.change(screen.getByTestId('device-detail-name-input'), { target: { value: 'Other' } });
+        fireEvent.click(screen.getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(screen.getByRole('alert').textContent).toBe('Failed to set display name.'));
+        fireEvent.click(screen.getByTestId('device-detail-name-cancel'));
+        expect(screen.getByTestId('device-detail-heading').textContent).toContain('Old name');
+    });
+});
