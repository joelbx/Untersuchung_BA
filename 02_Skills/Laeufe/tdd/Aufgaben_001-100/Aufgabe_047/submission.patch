diff --git a/utils/hasher/hasher.go b/utils/hasher/hasher.go
index 7856691..5d01141 100644
--- a/utils/hasher/hasher.go
+++ b/utils/hasher/hasher.go
@@ -1,6 +1,12 @@
 package hasher
 
-import "hash/maphash"
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"hash/maphash"
+	"sync"
+)
 
 var instance = NewHasher()
 
@@ -8,37 +14,62 @@ func Reseed(id string) {
 	instance.Reseed(id)
 }
 
+func SetSeed(id, seed string) {
+	instance.SetSeed(id, seed)
+}
+
 func HashFunc() func(id, str string) uint64 {
 	return instance.HashFunc()
 }
 
-type hasher struct {
-	seeds map[string]maphash.Seed
+type Hasher struct {
+	mu    sync.Mutex
+	seeds map[string]string
+	seed  maphash.Seed
 }
 
-func NewHasher() *hasher {
-	h := new(hasher)
-	h.seeds = make(map[string]maphash.Seed)
-	return h
+func NewHasher() *Hasher {
+	return &Hasher{seeds: make(map[string]string), seed: maphash.MakeSeed()}
 }
 
 // Reseed generates a new seed for the given id
-func (h *hasher) Reseed(id string) {
-	h.seeds[id] = maphash.MakeSeed()
+func (h *Hasher) Reseed(id string) {
+	h.SetSeed(id, randomSeed())
+}
+
+// SetSeed assigns a reproducible seed to the given id.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.seeds[id] = seed
 }
 
 // HashFunc returns a function that hashes a string using the seed for the given id
-func (h *hasher) HashFunc() func(id, str string) uint64 {
+func (h *Hasher) HashFunc() func(id, str string) uint64 {
 	return func(id, str string) uint64 {
-		var hash maphash.Hash
-		var seed maphash.Seed
-		var ok bool
-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
+		h.mu.Lock()
+		seed, ok := h.seeds[id]
+		if !ok {
+			seed = randomSeed()
 			h.seeds[id] = seed
 		}
-		hash.SetSeed(seed)
+		h.mu.Unlock()
+
+		var hash maphash.Hash
+		hash.SetSeed(h.seed)
+		var length [binary.MaxVarintLen64]byte
+		n := binary.PutUvarint(length[:], uint64(len(seed)))
+		_, _ = hash.Write(length[:n])
+		_, _ = hash.WriteString(seed)
 		_, _ = hash.WriteString(str)
 		return hash.Sum64()
 	}
 }
+
+func randomSeed() string {
+	var random [16]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		panic(err)
+	}
+	return hex.EncodeToString(random[:])
+}
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..b5494ff 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,28 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the same hash when a prior seed is set again", func() {
+		h := hasher.NewHasher()
+		hash := h.HashFunc()
+		h.SetSeed("playlist", "original")
+		original := hash("playlist", input)
+
+		h.SetSeed("playlist", "replacement")
+		Expect(hash("playlist", input)).NotTo(Equal(original))
+
+		h.SetSeed("playlist", "original")
+		Expect(hash("playlist", input)).To(Equal(original))
+		Expect(hash("playlist", input)).To(Equal(original))
+	})
+
+	It("uses a seed set through the package function", func() {
+		hash := hasher.HashFunc()
+		hasher.SetSeed("global-seed-test", "first")
+		original := hash("global-seed-test", input)
+		hasher.SetSeed("global-seed-test", "second")
+		Expect(hash("global-seed-test", input)).NotTo(Equal(original))
+		hasher.SetSeed("global-seed-test", "first")
+		Expect(hash("global-seed-test", input)).To(Equal(original))
+	})
 })
