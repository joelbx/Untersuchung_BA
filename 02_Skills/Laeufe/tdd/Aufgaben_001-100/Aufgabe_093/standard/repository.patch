+import { renderHook } from '@testing-library/react-hooks';
+
+import usePopper from './usePopper';
+
+jest.mock('@floating-ui/react-dom', () => ({
+    ...jest.requireActual('@floating-ui/react-dom'),
+    useFloating: () => ({
+        reference: () => {},
+        floating: () => {},
+        x: 0,
+        y: 0,
+        placement: 'top-start',
+        middlewareData: { rtlPlacement: { placement: 'top-end' } },
+    }),
+}));
+
+test('reports the placement adjusted by RTL middleware', () => {
+    const { result } = renderHook(() => usePopper({ isOpen: true, originalPlacement: 'top-start' }));
+    expect(result.current.placement).toBe('top-end');
+});
