+func TestPing_AuditSinks(t *testing.T) {
+	tests := []struct {
+		name    string
+		log     bool
+		webhook bool
+		want    map[string]any
+	}{
+		{name: "no sinks"},
+		{name: "log file", log: true, want: map[string]any{"sinks": []any{"log"}}},
+		{name: "webhook", webhook: true, want: map[string]any{"sinks": []any{"webhook"}}},
+		{name: "both sinks", log: true, webhook: true, want: map[string]any{"sinks": []any{"log", "webhook"}}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			client := &mockAnalytics{}
+			reporter := &Reporter{
+				cfg: config.Config{
+					Meta: config.MetaConfig{TelemetryEnabled: true},
+					Audit: config.AuditConfig{Sinks: config.SinksConfig{
+						LogFile: config.LogFileSinkConfig{Enabled: tt.log},
+						Webhook: config.WebhookSinkConfig{Enabled: tt.webhook},
+					}},
+				},
+				logger: zaptest.NewLogger(t),
+				client: client,
+				info:   info.Flipt{Version: "1.0.0", OS: "linux", Arch: "amd64"},
+			}
+			f := &mockFile{Reader: bytes.NewBuffer(nil), Writer: bytes.NewBuffer(nil)}
+
+			require.NoError(t, reporter.ping(context.Background(), f))
+			msg, ok := client.msg.(analytics.Track)
+			require.True(t, ok)
+			assert.Equal(t, "1.3", msg.Properties["version"])
+			flipt, ok := msg.Properties["flipt"].(map[string]any)
+			require.True(t, ok)
+			assert.Equal(t, "1.0.0", flipt["version"])
+			assert.Equal(t, "linux", flipt["os"])
+			assert.Equal(t, "amd64", flipt["arch"])
+			assert.Contains(t, flipt, "storage")
+			assert.Contains(t, flipt, "experimental")
+			if tt.want == nil {
+				assert.NotContains(t, flipt, "audit")
+			} else {
+				assert.Equal(t, tt.want, flipt["audit"])
+			}
+		})
+	}
+}
