+func TestParseMissingOSName(t *testing.T) {
+	result, err := ParserV2{}.Parse([]byte(`{"ArtifactName":"alpine","ArtifactType":"container_image","Metadata":{"OS":{"Family":"alpine"}},"Results":[{"Target":"alpine","Type":"alpine"}]}`))
