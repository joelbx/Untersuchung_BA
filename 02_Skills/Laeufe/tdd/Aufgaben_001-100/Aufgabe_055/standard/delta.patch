+func TestReuseScannedCvesUsesScannedBy(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		result models.ScanResult
+		want   bool
+	}{
+		{"trivy without optional", models.ScanResult{ScannedBy: "trivy"}, true},
+		{"legacy optional without trivy", models.ScanResult{Optional: map[string]interface{}{"trivy-target": "x"}}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := reuseScannedCves(&tc.result); got != tc.want {
+				t.Fatalf("reuseScannedCves = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestIsPkgCvesDetactable(t *testing.T) {
+	base := models.ScanResult{Family: "debian", Release: "12", Packages: models.Packages{"apt": {Name: "apt"}}}
+	cases := []struct {
+		name   string
+		change func(*models.ScanResult)
+		want   bool
+	}{
+		{"supported", func(*models.ScanResult) {}, true},
+		{"missing family", func(r *models.ScanResult) { r.Family = "" }, false},
+		{"missing release", func(r *models.ScanResult) { r.Release = "" }, false},
+		{"missing packages", func(r *models.ScanResult) { r.Packages = nil }, false},
+		{"trivy", func(r *models.ScanResult) { r.ScannedBy = "trivy" }, false},
+		{"freebsd", func(r *models.ScanResult) { r.Family = "freebsd" }, false},
+		{"raspbian", func(r *models.ScanResult) { r.Family = "raspbian" }, false},
+		{"pseudo", func(r *models.ScanResult) { r.Family = "pseudo" }, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r := base
+			tc.change(&r)
+			if got := isPkgCvesDetactable(&r); got != tc.want {
+				t.Fatalf("isPkgCvesDetactable = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
