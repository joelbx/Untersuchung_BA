diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
new file mode 100644
index 0000000..70b0287
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,28 @@
+import { HTMLAttributes, Ref, forwardRef } from 'react';
+
+interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ children, open, ...rest }, ref: Ref<HTMLDialogElement>) => {
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        const fallbackProps = { ...rest, open: open ? '' : undefined } as unknown as HTMLAttributes<HTMLDivElement> & {
+            open?: string;
+        };
+        return (
+            <div {...fallbackProps} role={rest.role || 'dialog'} ref={ref as Ref<HTMLDivElement>}>
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} open={open} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
