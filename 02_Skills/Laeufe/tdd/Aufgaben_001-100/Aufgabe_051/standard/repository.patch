+// TestReadKubeClusterFromEnvironment catches a missing Kubernetes environment
+// default or one that replaces an explicit CLI selection.
+func TestReadKubeClusterFromEnvironment(t *testing.T) {
+	tests := []struct {
+		name       string
+		cliSite    string
+		cliCluster string
+		envCluster string
+		want       string
+	}{
+		{name: "environment sets Kubernetes cluster", envCluster: "contractors", want: "contractors"},
+		{name: "Teleport CLI cluster does not block Kubernetes environment", cliSite: "root", envCluster: "contractors", want: "contractors"},
+		{name: "CLI Kubernetes cluster takes precedence", cliCluster: "production", envCluster: "contractors", want: "production"},
+		{name: "neither value set", want: ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cf := CLIConf{SiteName: tt.cliSite, KubernetesCluster: tt.cliCluster}
+			readClusterFlag(&cf, func(name string) string {
+				if name == "TELEPORT_KUBE_CLUSTER" {
+					return tt.envCluster
+				}
+				return ""
+			})
+			require.Equal(t, tt.want, cf.KubernetesCluster)
+		})
+	}
+}
