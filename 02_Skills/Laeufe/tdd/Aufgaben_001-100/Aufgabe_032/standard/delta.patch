+        monkeypatch.setattr(async_wrapper.os, 'fork', lambda: next(forks))
+        monkeypatch.setattr(async_wrapper, 'daemonize_self', lambda: None)
+        monkeypatch.setattr(async_wrapper.os, 'setpgid', lambda *args: None)
+        monkeypatch.setattr(async_wrapper.os, 'waitpid', lambda *args: (0, 0))
+        monkeypatch.setattr(async_wrapper.os, 'killpg', lambda *args: None)
+        monkeypatch.setattr(async_wrapper.time, 'sleep', lambda *args: None)
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 0
+        jobs = list(tmp_path.iterdir())
