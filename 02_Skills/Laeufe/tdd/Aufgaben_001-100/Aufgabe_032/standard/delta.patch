+    def test_run_module_records_completion_with_job_id(self, tmp_path, monkeypatch):
+        watcher, notifier = multiprocessing.Pipe()
+        monkeypatch.setattr(async_wrapper, 'ipc_notifier', notifier)
+        script = tmp_path / 'module.py'
+        script.write_text('#!%s\nprint(\'{"rc": 0}\')\n' % sys.executable)
+        job = tmp_path / 'job'
+        async_wrapper._run_module(str(script), 'job.123', str(job))
+        result = json.loads(job.read_text())
+        assert result['ansible_job_id'] == 'job.123'
+        assert result['started'] == 1
+        assert result['finished'] == 1
+        assert result['rc'] == 0
+        watcher.close()
+
+    def test_jwrite_keeps_old_result_visible_until_rename(self, tmp_path, monkeypatch):
+        job = tmp_path / 'job'
+        job.write_text('{"old": true}')
+        monkeypatch.setattr(async_wrapper, 'job_path', str(job), raising=False)
+        rename = os.rename
+
+        def inspect_rename(source, target):
+            assert json.loads(job.read_text()) == {'old': True}
+            assert json.loads(open(source).read()) == {'finished': 1}
+            rename(source, target)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', inspect_rename)
+        async_wrapper.jwrite({'finished': 1})
+        assert json.loads(job.read_text()) == {'finished': 1}
+
+    def test_end_emits_one_json_object(self, capsys):
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.end({'failed': True, 'msg': 'fork failed'}, 1)
+        assert exc.value.code == 1
+        assert json.loads(capsys.readouterr().out) == {'failed': True, 'msg': 'fork failed'}
+
+    def test_first_fork_failure_is_structured(self, monkeypatch, capsys, tmp_path):
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'job', '10', '/tmp/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
+
+        def fail_fork():
+            raise OSError(11, 'try again')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['ansible_job_id'].startswith('job.')
+        assert 'try again' in response['msg']
+
+    def test_timeout_records_failed_completion_with_child_pid(self, monkeypatch, tmp_path):
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'job', '0', '/tmp/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
