diff --git a/test/units/test_python_support_constants.py b/test/units/test_python_support_constants.py
new file mode 100644
index 0000000..5a551b9
--- /dev/null
+++ b/test/units/test_python_support_constants.py
@@ -0,0 +1,17 @@
+"""Controller support changes must preserve managed-node versions."""
+
+import importlib.util
+from pathlib import Path
+
+
+constants_path = Path(__file__).resolve().parents[1] / 'lib/ansible_test/_util/target/common/constants.py'
+spec = importlib.util.spec_from_file_location('ansible_test_python_constants', constants_path)
+constants = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(constants)
+
+
+def test_python_310_and_311_are_managed_node_only():
+    assert '3.10' in constants.REMOTE_ONLY_PYTHON_VERSIONS
+    assert '3.11' in constants.REMOTE_ONLY_PYTHON_VERSIONS
+    assert '3.10' not in constants.CONTROLLER_PYTHON_VERSIONS
+    assert '3.11' not in constants.CONTROLLER_PYTHON_VERSIONS
