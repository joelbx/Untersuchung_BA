diff --git a/test/units/cli/test_python_version.py b/test/units/cli/test_python_version.py
new file mode 100644
index 0000000..34070b0
--- /dev/null
+++ b/test/units/cli/test_python_version.py
@@ -0,0 +1,36 @@
+"""The CLI must reject unsupported controller interpreters before loading Ansible."""
+
+import os
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.skipif(sys.version_info >= (3, 12), reason='requires an unsupported interpreter')
+def test_cli_rejects_python_before_312():
+    env = dict(os.environ, PYTHONPATH=os.path.abspath('lib'))
+    result = subprocess.run(
+        [sys.executable, '-c', 'import ansible.cli'],
+        env=env, capture_output=True, text=True,
+    )
+
+    assert result.returncode != 0
+    assert result.stderr.strip() == (
+        'ERROR: Ansible requires Python 3.12 or newer on the controller. '
+        'Current version: %s' % ''.join(sys.version.splitlines())
+    )
+
+
+@pytest.mark.skipif(sys.version_info >= (3, 12), reason='requires an unsupported interpreter')
+def test_ansible_test_uses_same_version_error():
+    result = subprocess.run(
+        [sys.executable, 'bin/ansible-test', '--version'],
+        capture_output=True, text=True,
+    )
+
+    assert result.returncode != 0
+    assert result.stderr.strip() == (
+        'ERROR: Ansible requires Python 3.12 or newer on the controller. '
+        'Current version: %s' % ''.join(sys.version.splitlines())
+    )
