+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import { mount } from "enzyme";
+
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+
+describe("CancelButton", () => {
+    it("has an accessible name and forwards activation", () => {
+        const onClick = jest.fn();
+        const wrapper = mount(<CancelButton onClick={onClick} aria-label="Cancel reply" size="18" />);
+        const button = wrapper.find(".mx_CancelButton").last();
+        expect(button.prop("aria-label")).toBe("Cancel reply");
+        expect(button.prop("role")).toBe("button");
+        expect(button.prop("style")).toMatchObject({ "--size": "18px" });
+        button.simulate("click");
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+});
