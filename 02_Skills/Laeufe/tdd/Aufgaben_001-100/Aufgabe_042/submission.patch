diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..65c633b
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,39 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const privileges = require('../privileges');
+const user = require('../user');
+
+const wellKnown = module.exports;
+
+wellKnown.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	const prefix = 'acct:';
+	const suffix = `@${hostname}`;
+	if (typeof resource !== 'string' || !resource.startsWith(prefix) ||
+		!resource.endsWith(suffix) || resource.length <= prefix.length + suffix.length ||
+		resource.slice(prefix.length, -suffix.length).includes('@')) {
+		return res.sendStatus(400);
+	}
+
+	const canView = await privileges.global.can('view:users', req.uid > 0 ? req.uid : 0);
+	if (!canView) {
+		return res.sendStatus(403);
+	}
+
+	const userslug = resource.slice(prefix.length, -suffix.length);
+	const uid = await user.getUidByUserslug(userslug);
+	if (!uid) {
+		return res.sendStatus(404);
+	}
+
+	const baseUrl = nconf.get('url');
+	const profileUrl = `${baseUrl}/user/${userslug}`;
+	res.type('application/jrd+json').json({
+		subject: resource,
+		aliases: [`${baseUrl}/uid/${uid}`, profileUrl],
+		links: [{ rel: 'http://webfinger.net/rel/profile-page', type: 'text/html', href: profileUrl }],
+	});
+};
