+'use strict';
+
+const helpers = require('./helpers');
+
+module.exports = function (app, middleware, controllers) {
+	app.get('/.well-known/webfinger', middleware.authenticateRequest, helpers.tryRoute(controllers['well-known'].webfinger));
+};
