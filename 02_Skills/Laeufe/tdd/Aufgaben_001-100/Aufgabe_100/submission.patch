+func TestDefaultGRPCLogLevel(t *testing.T) {
+	data, err := json.Marshal(Default().Log)
+	require.NoError(t, err)
+
+	var log map[string]interface{}
+	require.NoError(t, json.Unmarshal(data, &log))
+	assert.Equal(t, "ERROR", log["grpc_level"])
+	assert.Equal(t, "INFO", log["level"])
+}
+
+func TestLoadGRPCLogLevel(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(path, []byte("log:\n  level: WARN\n  grpc_level: DEBUG\n  file: grpc.log\n  encoding: json\n"), 0600))
+
+	cfg, err := Load(path)
+	require.NoError(t, err)
+
+	data, err := json.Marshal(cfg.Log)
+	require.NoError(t, err)
+	var log map[string]interface{}
+	require.NoError(t, json.Unmarshal(data, &log))
+	assert.Equal(t, "DEBUG", log["grpc_level"])
+	assert.Equal(t, "WARN", cfg.Log.Level)
+	assert.Equal(t, "grpc.log", cfg.Log.File)
+	assert.Equal(t, LogEncodingJSON, cfg.Log.Encoding)
+}
