+func cacheTLS(ctx context.Context, client *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	certificate := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "redis"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		DNSNames:              []string{"redis"},
+		KeyUsage:              x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment | x509.KeyUsageCertSign,
+		ExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, certificate, certificate, &priv.PublicKey, priv)
+	if err != nil {
+		return func() error { return err }
+	}
+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	key := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(priv)})
+
+	redisServer := client.Container().
+		From("redis:alpine").
+		WithNewFile("/tls/server.crt", dagger.ContainerWithNewFileOpts{Contents: string(cert)}).
+		WithNewFile("/tls/server.key", dagger.ContainerWithNewFileOpts{Contents: string(key)}).
+		WithExposedPort(6379).
+		WithExec([]string{"redis-server", "--port", "0", "--tls-port", "6379", "--tls-cert-file", "/tls/server.crt", "--tls-key-file", "/tls/server.key", "--tls-ca-cert-file", "/tls/server.crt", "--tls-auth-clients", "no"})
+
+	flipt = flipt.
+		WithServiceBinding("redis", redisServer.AsService()).
+		WithEnvVariable("FLIPT_CACHE_ENABLED", "true").
+		WithEnvVariable("FLIPT_CACHE_BACKEND", "redis").
+		WithEnvVariable("FLIPT_CACHE_REDIS_HOST", "redis").
+		WithEnvVariable("FLIPT_CACHE_REDIS_REQUIRE_TLS", "true").
+		WithEnvVariable("FLIPT_CACHE_REDIS_CA_CERT_BYTES", string(cert))
+
+	return suite(ctx, "api", base, flipt.WithExec(nil), conf)
+}
