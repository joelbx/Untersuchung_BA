+def remove_author_honorifics(name: str) -> str:
+    """Remove a leading honorific when a personal name follows it."""
+    normalized = re.sub(r"\s+", " ", name.casefold().replace(".", " ")).strip()
+    if normalized in {re.sub(r"\s+", " ", exception.replace(".", " ")).strip() for exception in HONORIFC_NAME_EXECPTIONS}:
+        return name
+    stripped = name.lstrip()
+    for honorific in HONORIFICS:
+        if stripped.casefold().startswith(honorific):
+            rest = stripped[len(honorific) :]
+            if rest and rest[0].isspace() and rest.strip():
+                return rest.lstrip()
+    return name
 
 
