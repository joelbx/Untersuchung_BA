diff --git a/test/hash-field-normalization.js b/test/hash-field-normalization.js
new file mode 100644
index 0000000..a3fd732
--- /dev/null
+++ b/test/hash-field-normalization.js
@@ -0,0 +1,37 @@
+'use strict';
+
+const assert = require('assert');
+
+describe('hash field normalization', () => {
+	it('normalizes Mongo field names before deleting', async () => {
+		let unset;
+		const db = {
+			client: { collection: () => ({ updateOne: async (query, update) => { unset = update.$unset; } }) },
+		};
+		require('../src/database/mongo/hash')(db);
+		await db.deleteObjectFields('field-normalization-test', ['a.b', 0, false]);
+		assert.deepStrictEqual(unset, { 'a．b': '', 0: '', false: '' });
+	});
+
+	it('coerces Redis fields before deleting, including zero and false', async () => {
+		let fields;
+		const db = { client: { hdel: async (key, names) => { fields = names; } } };
+		require('../src/database/redis/hash')(db);
+		await db.deleteObjectFields('field-normalization-test', [0, false, 'field', null]);
+		assert.deepStrictEqual(fields, ['0', 'false', 'field']);
+	});
+
+	it('passes string field names to Redis for existence and increments', async () => {
+		const names = [];
+		const db = {
+			client: {
+				hexists: async (key, field) => { names.push(field); return 1; },
+				hincrby: async (key, field) => { names.push(field); return 2; },
+			},
+		};
+		require('../src/database/redis/hash')(db);
+		assert.strictEqual(await db.isObjectField('field-normalization-test', 0), true);
+		assert.strictEqual(await db.incrObjectFieldBy('field-normalization-test', false, 2), 2);
+		assert.deepStrictEqual(names, ['0', 'false']);
+	});
+});
