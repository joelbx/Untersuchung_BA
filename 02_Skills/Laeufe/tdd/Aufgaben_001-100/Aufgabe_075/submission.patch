+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props (
+    user_id varchar(255) not null references user(id) on delete cascade,
+    key varchar(255) not null,
+    value varchar not null,
+    primary key (user_id, key)
+);
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from user u join property p on p.id = 'LastFMSessionKey_' || u.id;
+delete from property where id glob 'LastFMSessionKey_*';
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`drop table user_props`)
+	return err
+}
diff --git a/db/migration/user_props_test.go b/db/migration/user_props_test.go
new file mode 100644
index 0000000..f5d0965
--- /dev/null
+++ b/db/migration/user_props_test.go
@@ -0,0 +1,47 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`create table user (id text primary key); create table property (id text primary key, value text);
+insert into user values ('user-1');
+insert into property values ('LastFMSessionKey_user-1', 'secret');
+insert into property values ('LastFMSessionKey_missing', 'orphan');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := db.QueryRow(`select value from user_props where user_id = 'user-1' and key = 'LastFMSessionKey'`).Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "secret" {
+		t.Fatalf("session key = %q", value)
+	}
+	var count int
+	if err := db.QueryRow(`select count(*) from property where id = 'LastFMSessionKey_user-1'`).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Fatalf("old session key remains in property")
+	}
+}
