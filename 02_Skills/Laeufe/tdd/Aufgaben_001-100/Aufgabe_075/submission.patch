diff --git a/tests/mock_user_props_repo.go b/tests/mock_user_props_repo.go
new file mode 100644
index 0000000..5cd3601
--- /dev/null
+++ b/tests/mock_user_props_repo.go
@@ -0,0 +1,51 @@
+package tests
+
+import (
+	"errors"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+type mockUserProps struct {
+	all    map[string]map[string]string
+	userID string
+}
+
+func (p *mockUserProps) checkUser() error {
+	if p.userID == "" {
+		return errors.New("user properties require a user in context")
+	}
+	return nil
+}
+
+func (p *mockUserProps) Put(key, value string) error {
+	if err := p.checkUser(); err != nil {
+		return err
+	}
+	if p.all[p.userID] == nil {
+		p.all[p.userID] = make(map[string]string)
+	}
+	p.all[p.userID][key] = value
+	return nil
+}
+
+func (p *mockUserProps) Get(key string) (string, error) {
+	if err := p.checkUser(); err != nil {
+		return "", err
+	}
+	if value, ok := p.all[p.userID][key]; ok {
+		return value, nil
+	}
+	return "", model.ErrNotFound
+}
+
+func (p *mockUserProps) Delete(key string) error {
+	if err := p.checkUser(); err != nil {
+		return err
+	}
+	if _, ok := p.all[p.userID][key]; !ok {
+		return model.ErrNotFound
+	}
+	delete(p.all[p.userID], key)
+	return nil
+}
