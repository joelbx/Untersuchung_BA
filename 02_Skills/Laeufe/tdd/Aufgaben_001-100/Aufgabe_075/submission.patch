@@ -0,0 +1,58 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+	userID string
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	user, _ := request.UserFrom(ctx)
+	return &userPropsRepository{
+		sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"},
+		userID:        user.ID,
+	}
+}
+
+func (r *userPropsRepository) scope(key string) (Eq, error) {
+	if r.userID == "" {
+		return nil, errors.New("user properties require a user in context")
+	}
+	return Eq{"user_id": r.userID, "key": key}, nil
+}
+
+func (r *userPropsRepository) Put(key, value string) error {
+	if _, err := r.scope(key); err != nil {
+		return err
+	}
+	_, err := r.executeSQL(Insert(r.tableName).Columns("user_id", "key", "value").Values(r.userID, key, value).
+		Suffix("ON CONFLICT(user_id, key) DO UPDATE SET value = excluded.value"))
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	scope, err := r.scope(key)
+	if err != nil {
+		return "", err
+	}
+	var row struct{ Value string }
+	err = r.queryOne(Select("value").From(r.tableName).Where(scope), &row)
+	return row.Value, err
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	scope, err := r.scope(key)
+	if err != nil {
+		return err
+	}
+	return r.delete(scope)
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..1126d25
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,56 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("keeps values with the same key isolated by contextual user", func() {
+		o := orm.NewOrm()
+		users := NewUserRepository(context.Background(), o)
+		Expect(users.Put(&model.User{ID: "props-user-a", UserName: "props-user-a"})).To(Succeed())
+		Expect(users.Put(&model.User{ID: "props-user-b", UserName: "props-user-b"})).To(Succeed())
+		first := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-a"}), o)
+		second := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-b"}), o)
+		Expect(first.Put("session", "first")).To(Succeed())
+		Expect(second.Put("session", "second")).To(Succeed())
+		value, err := first.Get("session")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("first"))
+		value, err = second.Get("session")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("second"))
+	})
+
+	It("updates and deletes only the contextual user's value", func() {
+		o := orm.NewOrm()
+		users := NewUserRepository(context.Background(), o)
+		Expect(users.Put(&model.User{ID: "props-update-a", UserName: "props-update-a"})).To(Succeed())
+		Expect(users.Put(&model.User{ID: "props-update-b", UserName: "props-update-b"})).To(Succeed())
+		first := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-update-a"}), o)
+		second := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-update-b"}), o)
+		Expect(first.Put("session", "old")).To(Succeed())
+		Expect(first.Put("session", "new")).To(Succeed())
+		Expect(second.Put("session", "other")).To(Succeed())
+		Expect(first.Delete("session")).To(Succeed())
+		_, err := first.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		value, err := second.Get("session")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("other"))
+	})
+
+	It("rejects property operations without a contextual user", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("session", "secret")).To(HaveOccurred())
+		_, err := repo.Get("session")
+		Expect(err).To(HaveOccurred())
+		Expect(repo.Delete("session")).To(HaveOccurred())
+	})
+})
