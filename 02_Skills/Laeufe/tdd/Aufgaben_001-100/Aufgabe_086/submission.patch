diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 25a157e..70d99ff 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -26,6 +26,43 @@ class TestIptables(ModuleTestCase):
         self.mock_get_iptables_version.start()
         self.addCleanup(self.mock_get_iptables_version.stop)  # ensure that the patching is 'undone'
 
+    def test_destination_ports_builds_multiport_rule_for_supported_protocols(self):
+        for protocol in ('tcp', 'udp', 'udplite', 'dccp', 'sctp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['80', '443', '8081:8083'],
+                'jump': 'ACCEPT',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_args_list[0][0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-p', protocol, '-j', 'ACCEPT', '-m', 'multiport',
+                '--dports', '80,443,8081:8083',
+            ])
+            self.assertEqual(run_command.call_args_list[1][0][0], [
+                '/sbin/iptables', '-t', 'filter', '-A', 'INPUT',
+                '-p', protocol, '-j', 'ACCEPT', '-m', 'multiport',
+                '--dports', '80,443,8081:8083',
+            ])
+
+    def test_destination_ports_rejects_incompatible_protocol(self):
+        for protocol in (None, 'icmp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['80', '443'],
+                'jump': 'ACCEPT',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson) as result:
+                    iptables.main()
+            self.assertEqual(result.exception.args[0]['msg'],
+                             'destination_ports requires one of tcp, udp, udplite, dccp, or sctp protocols.')
+            self.assertEqual(run_command.call_count, 0)
+
