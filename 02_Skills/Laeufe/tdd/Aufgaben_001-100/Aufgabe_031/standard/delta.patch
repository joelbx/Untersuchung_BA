@@ -0,0 +1,25 @@
+package main
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestBuildConfigWithoutFileAppliesEnvironmentOverrides(t *testing.T) {
+	oldCfgPath, oldConfigFile, oldDefaultPath := cfgPath, fliptConfigFile, defaultCfgPath
+	t.Cleanup(func() {
+		cfgPath, fliptConfigFile, defaultCfgPath = oldCfgPath, oldConfigFile, oldDefaultPath
+	})
+	cfgPath = ""
+	fliptConfigFile = filepath.Join(t.TempDir(), "missing.yml")
+	defaultCfgPath = ""
+	t.Setenv("FLIPT_LOG_LEVEL", "DEBUG")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+
+	logger, cfg := buildConfig()
+	t.Cleanup(func() { _ = logger.Sync() })
+	require.Equal(t, "DEBUG", cfg.Log.Level)
+	require.Equal(t, 8181, cfg.Server.HTTPPort)
+}
