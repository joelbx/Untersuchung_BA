+package events
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+// A missing WriterEmitter.EmitAuditEvent or newline must fail this test.
+func TestWriterEmitterWritesNewlineDelimitedEvents(t *testing.T) {
+	var output bytes.Buffer
+	emitter := NewWriterEmitter(utils.NopWriteCloser(&output))
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	lines := strings.Split(strings.TrimSuffix(output.String(), "\n"), "\n")
+	require.Len(t, lines, 2)
+	for _, line := range lines {
+		var got map[string]interface{}
+		require.NoError(t, json.Unmarshal([]byte(line), &got))
+		require.Equal(t, SessionStartEvent, got["event"])
+	}
+}
+
+// A logger without Emitter must be rejected at construction.
+func TestNewMultiLogRejectsNonEmitter(t *testing.T) {
+	_, err := NewMultiLog(NewWriterLog(utils.NopWriteCloser(&bytes.Buffer{})))
+	require.True(t, trace.IsBadParameter(err), "error: %v", err)
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
+
+// Missing fanout or a lost writer must fail this test.
+func TestMultiLogEmitsToEveryWriter(t *testing.T) {
+	var first, second bytes.Buffer
+	log, err := NewMultiLog(NewWriterEmitter(utils.NopWriteCloser(&first)), NewWriterEmitter(utils.NopWriteCloser(&second)))
+	require.NoError(t, err)
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent}}
+	require.NoError(t, log.EmitAuditEvent(context.Background(), event))
+	require.Contains(t, first.String(), `"event":"session.start"`)
+	require.Equal(t, first.String(), second.String())
+}
+
+type failingWriteCloser struct {
+	closeErr error
+	closes   int
+}
+
+func (w *failingWriteCloser) Write([]byte) (int, error) { return 0, errors.New("write failed") }
+func (w *failingWriteCloser) Close() error              { w.closes++; return w.closeErr }
+
+func TestWriterEmitterConvertsWriteError(t *testing.T) {
+	emitter := NewWriterEmitter(&failingWriteCloser{})
+	err := emitter.EmitAuditEvent(context.Background(), &SessionStart{})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "write failed")
+}
+
+func TestWriterEmitterAggregatesCloseErrors(t *testing.T) {
+	writer := &failingWriteCloser{closeErr: errors.New("close failed")}
+	emitter := NewWriterEmitter(writer)
+	err := emitter.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "close failed")
+	require.Equal(t, 2, writer.closes)
+}
+
+type shortWriteCloser struct{}
+
+func (*shortWriteCloser) Write(data []byte) (int, error) { return len(data) - 1, nil }
+func (*shortWriteCloser) Close() error                   { return nil }
+
+func TestWriterEmitterReportsShortWrite(t *testing.T) {
+	err := NewWriterEmitter(&shortWriteCloser{}).EmitAuditEvent(context.Background(), &SessionStart{})
+	require.True(t, errors.Is(err, io.ErrShortWrite), "error: %v", err)
+}
