+// NewWriterEmitter creates an audit log and emitter backed by w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{WriterLog: NewWriterLog(w), writer: w}
+}
+
+// WriterEmitter writes audit events to an external writer.
+type WriterEmitter struct {
+	*WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes one JSON event followed by a newline.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	line, err := json.Marshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	line = append(line, '\n')
+	n, err := w.writer.Write(line)
+	if err == nil && n != len(line) {
+		err = io.ErrShortWrite
+	}
+	return trace.ConvertSystemError(err)
+}
+
+// Close closes the writer and the embedded log.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(w.writer.Close(), w.WriterLog.Close())
+}
