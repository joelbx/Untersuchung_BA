+// Multiple event URIs must produce an audit log that can emit modern events.
+func (s *ServiceTestSuite) TestInitExternalLogMultipleURIs(c *check.C) {
+	logger, err := initExternalLog(services.AuditConfig{
+		AuditEventsURI: []string{"file://" + c.MkDir(), "stdout://"},
+	})
+	c.Assert(err, check.IsNil)
+	emitter, ok := logger.(events.Emitter)
+	c.Assert(ok, check.Equals, true)
+	c.Assert(emitter.EmitAuditEvent(context.Background(), &events.SessionStart{
+		Metadata: events.Metadata{Type: events.SessionStartEvent},
+	}), check.IsNil)
+	c.Assert(logger.Close(), check.IsNil)
+}
