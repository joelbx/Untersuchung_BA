+// pkgPs associates each process with packages owning its executable or mapped files.
+func (l *base) pkgPs(getOwnerPkgs func([]string) ([]models.Package, error)) error {
+	stdout, err := l.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+	pidNames := l.parsePs(stdout)
+	pidLoadedFiles := map[string][]string{}
+	for pid := range pidNames {
+		stdout, err := l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to read /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		path, err := l.parseLsProcExe(stdout)
+		if err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], path)
+		stdout, err = l.grepProcMap(pid)
+		if err != nil {
+			l.log.Debugf("Failed to read /proc/%s/maps: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], l.parseGrepProcMap(stdout)...)
+	}
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = l.lsOfListen()
+	if err != nil {
+		l.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range l.parseLsOf(stdout) {
+		portStat, err := models.NewPortStat(ipPort)
+		if err != nil {
+			l.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+			continue
+		}
+		for _, pid := range pids {
+			pidListenPorts[pid] = append(pidListenPorts[pid], *portStat)
+		}
+	}
+
+	for pid, paths := range pidLoadedFiles {
+		owners, err := getOwnerPkgs(paths)
+		if err != nil {
+			l.log.Debugf("Failed to get package owners for %v: %s", paths, err)
+			continue
+		}
+		associateOwnedProcess(l.Packages, owners, models.AffectedProcess{
+			PID: pid, Name: pidNames[pid], ListenPortStats: pidListenPorts[pid],
+		})
+	}
+	return nil
+}
+
+func associateOwnedProcess(packages models.Packages, owners []models.Package, proc models.AffectedProcess) {
+	seen := map[string]bool{}
+	for _, owner := range owners {
+		if seen[owner.Name] {
+			continue
+		}
+		seen[owner.Name] = true
+		pack, ok := packages[owner.Name]
+		if !ok {
+			continue
+		}
+		pack.AffectedProcs = append(pack.AffectedProcs, proc)
+		packages[owner.Name] = pack
+	}
+}
