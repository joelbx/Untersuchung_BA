diff --git a/scan/pkgps_test.go b/scan/pkgps_test.go
new file mode 100644
index 0000000..7fb96c2
--- /dev/null
+++ b/scan/pkgps_test.go
@@ -0,0 +1,65 @@
+package scan
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+// Dropping an owner whose version or architecture differs from the scanned map entry
+// would lose the process association on systems with multiple installed RPMs.
+func TestAssociateOwnedProcessByPackageName(t *testing.T) {
+	packages := models.Packages{"libgcc": {Name: "libgcc", Version: "4.8.5", Release: "44.el7", Arch: "x86_64"}}
+	owner := models.Package{Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "i686"}
+	proc := models.AffectedProcess{PID: "42", Name: "service"}
+
+	associateOwnedProcess(packages, []models.Package{owner, owner}, proc)
+
+	got := packages["libgcc"].AffectedProcs
+	if len(got) != 1 || got[0].PID != "42" {
+		t.Fatalf("affected processes = %+v, want one process with PID 42", got)
+	}
+}
+
+func TestGetOwnerPkgsKeepsPartialRPMOutput(t *testing.T) {
+	dir := t.TempDir()
+	rpm := filepath.Join(dir, "rpm")
+	if err := os.WriteFile(rpm, []byte("#!/bin/sh\nprintf 'libgcc 0 4.8.5 39.el7 i686\\nfile /tmp/gone is not owned by any package\\n'\nexit 1\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+":"+os.Getenv("PATH"))
+	o := newRHEL(config.ServerInfo{Host: "localhost", Port: "local"})
+	o.setDistro(config.RedHat, "7")
+	got, err := o.getOwnerPkgs([]string{"/usr/lib/libgcc.so", "/tmp/gone"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Name != "libgcc" || got[0].Arch != "i686" {
+		t.Fatalf("owners = %+v, want libgcc i686", got)
+	}
+}
+
+func TestParseRPMOwnersSkipsExpectedFileErrors(t *testing.T) {
+	o := newRHEL(config.ServerInfo{})
+	output := "libgcc 0 4.8.5 39.el7 i686\n" +
+		"error: /proc/42/exe: Permission denied\n" +
+		"file /tmp/missing is not owned by any package\n" +
+		"error: /tmp/gone: No such file or directory\n"
+	got, err := o.parseOwnerPkgs(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Name != "libgcc" || got[0].Arch != "i686" {
+		t.Fatalf("owners = %+v", got)
+	}
+}
+
+func TestParseRPMOwnersRejectsUnknownLine(t *testing.T) {
+	o := newRHEL(config.ServerInfo{})
+	if _, err := o.parseOwnerPkgs("unexpected rpm output"); err == nil {
+		t.Fatal("expected malformed line error")
+	}
+}
