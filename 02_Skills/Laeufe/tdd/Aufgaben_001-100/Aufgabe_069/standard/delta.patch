diff --git a/lib/utils/parse/parse_test.go b/lib/utils/parse/parse_test.go
index dd458ed..243fcad 100644
--- a/lib/utils/parse/parse_test.go
+++ b/lib/utils/parse/parse_test.go
@@ -24,6 +24,69 @@ import (
 	"github.com/stretchr/testify/assert"
 )
 
+func TestMatch(t *testing.T) {
+	tests := []struct {
+		name, expression, input string
+		want                    bool
+	}{
+		{"literal", "foo.bar", "foo.bar", true},
+		{"literal mismatch", "foo.bar", "fooxbar", false},
+		{"wildcard", "foo*bar", "foo-middle-bar", true},
+		{"wildcard anchored", "foo*bar", "xfoo-bar", false},
+		{"star", "*", "anything", true},
+		{"raw regexp", "^foo[0-9]+$", "foo12", true},
+		{"regexp function", `{{regexp.match("bar")}}`, "xxbarxx", true},
+		{"regexp not match", `{{regexp.not_match("bar")}}`, "foo", true},
+		{"regexp not match inversion", `{{regexp.not_match("bar")}}`, "bar", false},
+		{"prefix suffix", `foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz", true},
+		{"prefix mismatch", `foo-{{regexp.match("bar")}}-baz`, "xfoo-bar-baz", false},
+		{"suffix mismatch", `foo-{{regexp.match("bar")}}-baz`, "foo-bar-bazx", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			matcher, err := Match(tt.expression)
+			if assert.NoError(t, err) {
+				assert.Equal(t, tt.want, matcher.Match(tt.input))
+			}
+		})
+	}
+}
+
+func TestMatchInvalid(t *testing.T) {
+	tests := []struct{ expression, message string }{
+		{`foo-{{regexp.match("bar")}`, `"foo-{{regexp.match(\"bar\")}" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, `unsupported function namespace other, supported namespaces are email and regexp`},
+		{`{{regexp.bad("foo")}}`, `unsupported function regexp.bad, supported functions are: regexp.match, regexp.not_match.`},
+		{`{{email.bad("foo")}}`, `unsupported function email.bad, supported functions are: email.local`},
+		{`{{regexp.match("[")}}`, "failed parsing regexp \"[\": error parsing regexp: missing closing ]: `[`"},
+		{`{{regexp.match()}}`, `expected exactly one string literal argument for regexp.match`},
+		{`{{regexp.match("a", "b")}}`, `expected exactly one string literal argument for regexp.match`},
+		{`{{regexp.match(internal.foo)}}`, `expected exactly one string literal argument for regexp.match`},
+		{`{{email.local()}}`, `expected exactly one string literal argument for email.local`},
+		{`{{email.local(internal.foo)}}`, `expected exactly one string literal argument for email.local`},
+		{`{{internal.foo}}`, `"internal.foo" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{email.local("foo@bar.com")}}`, `"email.local(\"foo@bar.com\")" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{regexp.match("a")}}{{regexp.match("b")}}`, `"{{regexp.match(\"a\")}}{{regexp.match(\"b\")}}" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.expression, func(t *testing.T) {
+			_, err := Match(tt.expression)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err), "%v", err)
+				assert.Equal(t, tt.message, err.Error())
+			}
+		})
+	}
+}
+
+func TestVariableRejectsMatcher(t *testing.T) {
+	variable := `prefix-{{regexp.match("foo")}}`
+	_, err := Variable(variable)
+	if assert.Error(t, err) {
+		assert.Equal(t, `matcher functions (like regexp.match) are not allowed here: "prefix-{{regexp.match(\"foo\")}}"`, err.Error())
+	}
+}
