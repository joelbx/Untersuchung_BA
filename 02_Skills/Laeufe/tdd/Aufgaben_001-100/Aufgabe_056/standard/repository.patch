diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts
new file mode 100644
index 0000000..976b07f
--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts
@@ -0,0 +1,43 @@
+import * as browser from '@proton/shared/lib/helpers/browser';
+import { isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+describe('modern image support', () => {
+    afterEach(() => jest.restoreAllMocks());
+
+    const setBrowser = (name: string, version: string, os: string) => {
+        jest.spyOn(browser, 'getBrowser').mockReturnValue({ name, version } as ReturnType<typeof browser.getBrowser>);
+        jest.spyOn(browser, 'getOS').mockReturnValue({ name: os, version: '' });
+    };
+
+    it.each(['image/heic', 'image/heic-sequence', 'image/heif', 'image/heif-sequence', 'image/jxl'])(
+        'supports %s on macOS Safari 17',
+        (type) => {
+            setBrowser('Safari', '17.0', 'Mac OS');
+            expect(isSupportedImage(type)).toBe(true);
+        }
+    );
+
+    it.each(['16.4', '16.9'])('rejects modern images on macOS Safari %s', (version) => {
+        setBrowser('Safari', version, 'Mac OS');
+        expect(isSupportedImage('image/heic')).toBe(false);
+        expect(isSupportedImage('image/jxl')).toBe(false);
+    });
+
+    it('rejects modern images on Chrome 17 on macOS', () => {
+        setBrowser('Chrome', '17', 'Mac OS');
+        expect(isSupportedImage('image/heic')).toBe(false);
+        expect(isSupportedImage('image/jxl')).toBe(false);
+    });
+
+    it('rejects modern images on Windows Safari 17', () => {
+        setBrowser('Safari', '17', 'Windows');
+        expect(isSupportedImage('image/heic')).toBe(false);
+        expect(isSupportedImage('image/jxl')).toBe(false);
+    });
+
+    it('supports modern images on iOS Safari 17', () => {
+        setBrowser('Mobile Safari', '17.0', 'iOS');
+        expect(isSupportedImage('image/heic')).toBe(true);
+        expect(isSupportedImage('image/jxl')).toBe(true);
+    });
+});
