+const isSafari17OnAppleOS = () => {
+    const { name, version } = getBrowser();
+    const os = getOS().name;
+
+    return (
+        (name === 'Safari' || name === 'Mobile Safari') &&
+        (os === 'Mac OS' || os === 'iOS') &&
+        !!version &&
+        new Version(version).isGreaterThanOrEqual('17')
+    );
+};
