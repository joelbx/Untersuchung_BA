@@ -0,0 +1,11 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+it('uses the declared file type for a small file', async () => {
+    const file = new File(['x'], 'photo.jpg', { type: 'image/heic' });
+    expect(await mimeTypeFromFile(file)).toBe('image/heic');
+});
+
+it('uses the extension when a file has no declared type', async () => {
+    const file = new File(['x'], 'photo.JXL');
+    expect(await mimeTypeFromFile(file)).toBe('image/jxl');
+});
