+package teleport
+
+import "testing"
+
+func TestRolesCheck(t *testing.T) {
+	tests := []struct {
+		name    string
+		roles   Roles
+		wantErr bool
+	}{
+		{name: "nil roles"},
+		{name: "empty roles", roles: Roles{}},
+		{name: "unique valid roles", roles: Roles{RoleAuth, RoleProxy}},
+		{name: "duplicate role", roles: Roles{RoleAuth, RoleProxy, RoleAuth}, wantErr: true},
+		{name: "unknown role", roles: Roles{RoleAuth, Role("unknown")}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.roles.Check()
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Check() error = %v, want error = %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestRolesEqualsUsesDistinctRoles(t *testing.T) {
+	tests := []struct {
+		name  string
+		left  Roles
+		right Roles
+		want  bool
+	}{
+		{name: "nil and empty", right: Roles{}, want: true},
+		{name: "same roles in different order", left: Roles{RoleAuth, RoleProxy}, right: Roles{RoleProxy, RoleAuth}, want: true},
+		{name: "duplicate on one side", left: Roles{RoleAuth}, right: Roles{RoleAuth, RoleAuth}, want: true},
+		{name: "same length with different distinct roles", left: Roles{RoleAuth, RoleAuth}, right: Roles{RoleAuth, RoleProxy}},
+		{name: "extra distinct role", left: Roles{RoleAuth, RoleProxy}, right: Roles{RoleAuth}},
+		{name: "different singleton roles", left: Roles{RoleAuth}, right: Roles{RoleProxy}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.left.Equals(tt.right); got != tt.want {
+				t.Errorf("%v.Equals(%v) = %v, want %v", tt.left, tt.right, got, tt.want)
+			}
+			if got := tt.right.Equals(tt.left); got != tt.want {
+				t.Errorf("%v.Equals(%v) = %v, want %v", tt.right, tt.left, got, tt.want)
+			}
+		})
+	}
+}
