+@pytest.mark.parametrize('flag', ['--upgrade', '-U'])
+def test_collection_install_passes_upgrade_for_requirements_file(collection_install, flag):
+    mock_install, _, output_dir = collection_install
+    requirements_file = os.path.join(output_dir, 'upgrade_requirements.yml')
+    with open(requirements_file, 'wb') as req_obj:
+        req_obj.write(b'collections:\n- namespace.coll\n')
+    GalaxyCLI(args=['ansible-galaxy', 'collection', 'install', flag,
+                    '-r', requirements_file, '-p', output_dir]).run()
+    assert mock_install.call_args[1]['upgrade'] is True
