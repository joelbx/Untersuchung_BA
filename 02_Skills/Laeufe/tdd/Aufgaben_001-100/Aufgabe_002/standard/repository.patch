+// A wrong public port or disabled Kubernetes listener must not produce a
+// kubeconfig endpoint. Replacing the Kubernetes port with the web port breaks
+// these cases.
+func TestProxyConfigKubeAddr(t *testing.T) {
+	cases := []struct {
+		name      string
+		config    ProxyConfig
+		want      string
+		wantError bool
+	}{
+		{name: "disabled", config: ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}}}, wantError: true},
+		{name: "kubernetes address takes priority", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			Kube:        KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}}},
+		}, want: "https://kube.example.com:3026"},
+		{name: "web hostname uses Kubernetes port", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			Kube:        KubeProxyConfig{Enabled: true},
+		}, want: "https://web.example.com:3026"},
+		{name: "missing address", config: ProxyConfig{Kube: KubeProxyConfig{Enabled: true}}, wantError: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := tc.config.KubeAddr()
+			if tc.wantError {
+				if err == nil {
+					t.Fatalf("KubeAddr() = %q, want error", got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got != tc.want {
+				t.Fatalf("KubeAddr() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
