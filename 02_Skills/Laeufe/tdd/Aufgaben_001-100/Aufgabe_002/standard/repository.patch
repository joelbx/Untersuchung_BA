+func TestAuthSignSelectsKubernetesProxy(t *testing.T) {
+	cases := []struct {
+		name      string
+		config    *service.Config
+		proxies   []services.Server
+		want      string
+		wantError bool
+	}{
+		{name: "local Kubernetes proxy", config: &service.Config{Proxy: service.ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			Kube:        service.KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}}},
+		}}, want: "https://kube.example.com:3026"},
+		{name: "registered proxy skips invalid address", config: &service.Config{Proxy: service.ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "local.example.com:3080"}},
+		}}, proxies: []services.Server{
+			&services.ServerV2{Spec: services.ServerSpecV2{PublicAddr: "https://bad.example.com:invalid"}},
+			&services.ServerV2{Spec: services.ServerSpecV2{PublicAddr: "remote.example.com:3080"}},
+		}, want: "https://remote.example.com:3026"},
+		{name: "no valid registered proxy", config: &service.Config{}, proxies: []services.Server{
+			&services.ServerV2{Spec: services.ServerSpecV2{PublicAddr: "https://bad.example.com:invalid"}},
+		}, wantError: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			a := &AuthCommand{config: tc.config, outputFormat: identityfile.FormatKubernetes}
+			err := a.checkProxyAddr(mockClient{proxies: tc.proxies})
+			if tc.wantError {
+				if err == nil {
+					t.Fatalf("checkProxyAddr() = %q, want error", a.proxyAddr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if a.proxyAddr != tc.want {
+				t.Fatalf("proxy address = %q, want %q", a.proxyAddr, tc.want)
+			}
+		})
+	}
+}
