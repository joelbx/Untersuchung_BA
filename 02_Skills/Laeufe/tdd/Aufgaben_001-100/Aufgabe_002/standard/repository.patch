+// KubeAddr returns the public HTTPS endpoint for this proxy's Kubernetes service.
+func (p ProxyConfig) KubeAddr() (string, error) {
+	if !p.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	addrs := p.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = p.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+	u, err := url.Parse("https://" + addrs[0].Addr)
+	if err != nil || u.Hostname() == "" || u.Path != "" || u.User != nil {
+		return "", trace.BadParameter("invalid proxy public address %q", addrs[0].Addr)
+	}
+	return (&url.URL{Scheme: "https", Host: net.JoinHostPort(u.Hostname(), strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+}
