+     ('time:y', True), ('subjective:foo', False), ('/subjects/foo', False)],
+)
+def test_is_seed_subject_string_requires_supported_prefix(seed, expected):
+    assert lists.is_seed_subject_string(seed) is expected
+
+
+def test_list_record_preserves_subject_seed_strings():
+    assert ListRecord.normalize_input_seed('place:New_York') == 'place:New_York'
