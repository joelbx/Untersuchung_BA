diff --git a/report/diff_status_test.go b/report/diff_status_test.go
new file mode 100644
index 0000000..6a71403
--- /dev/null
+++ b/report/diff_status_test.go
@@ -0,0 +1,72 @@
+package report
+
+import (
+	"github.com/future-architect/vuls/models"
+	"testing"
+)
+
+func TestDiffFiltersChangesAndUsesPackagesFromMatchingScan(t *testing.T) {
+	previous := models.ScanResult{ServerName: "host", ScannedCves: models.VulnInfos{
+		"old":  {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+		"same": {CveID: "same"},
+	}, Packages: models.Packages{"old-package": {Name: "old-package", Version: "previous"}}}
+	current := models.ScanResult{ServerName: "host", ScannedCves: models.VulnInfos{
+		"new":  {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}},
+		"same": {CveID: "same"},
+	}, Packages: models.Packages{"new-package": {Name: "new-package", Version: "current"}}}
+	cases := []struct {
+		name                string
+		plus, minus         bool
+		wantPlus, wantMinus bool
+	}{
+		{"new only", true, false, true, false},
+		{"resolved only", false, true, false, true},
+		{"both", true, true, true, true},
+		{"neither", false, false, false, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tc.plus, tc.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := results[0]
+			if len(got.ScannedCves) != boolCount(tc.wantPlus)+boolCount(tc.wantMinus) {
+				t.Fatalf("unexpected CVEs: %+v", got.ScannedCves)
+			}
+			if tc.wantPlus {
+				if got.ScannedCves["new"].DiffStatus != models.DiffPlus {
+					t.Errorf("new CVE status = %q", got.ScannedCves["new"].DiffStatus)
+				}
+				if got.Packages["new-package"].Version != "current" {
+					t.Errorf("new package = %+v", got.Packages["new-package"])
+				}
+			}
+			if tc.wantMinus {
+				if got.ScannedCves["old"].DiffStatus != models.DiffMinus {
+					t.Errorf("resolved CVE status = %q", got.ScannedCves["old"].DiffStatus)
+				}
+				if got.Packages["old-package"].Version != "previous" {
+					t.Errorf("resolved package = %+v", got.Packages["old-package"])
+				}
+			}
+		})
+	}
+}
+func boolCount(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+func TestDiffWithoutPreviousScanMarksCurrentCvesAsNew(t *testing.T) {
+	current := models.ScanResult{ServerName: "host", ScannedCves: models.VulnInfos{"new": {CveID: "new"}}}
+	results, err := diff(models.ScanResults{current}, nil, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if results[0].ScannedCves["new"].DiffStatus != models.DiffPlus {
+		t.Fatalf("CVEs = %+v", results[0].ScannedCves)
+	}
+}
