@@ -0,0 +1,23 @@
+package models
+
+import "testing"
+
+func TestDiffStatusDisplayAndCount(t *testing.T) {
+	vulns := VulnInfos{
+		"new":  {CveID: "new", DiffStatus: DiffPlus},
+		"old":  {CveID: "old", DiffStatus: DiffMinus},
+		"same": {CveID: "same"},
+	}
+	plus, minus := vulns.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Errorf("counts = %d, %d", plus, minus)
+	}
+	for _, tc := range []struct{ id, want string }{{"new", "+new"}, {"old", "-old"}, {"same", "same"}} {
+		if got := vulns[tc.id].CveIDDiffFormat(true); got != tc.want {
+			t.Errorf("diff format %s = %q", tc.id, got)
+		}
+		if got := vulns[tc.id].CveIDDiffFormat(false); got != tc.id {
+			t.Errorf("normal format %s = %q", tc.id, got)
+		}
+	}
+}
