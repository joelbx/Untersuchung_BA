diff --git a/lib/config/kube_shorthand_test.go b/lib/config/kube_shorthand_test.go
new file mode 100644
index 0000000..91522df
--- /dev/null
+++ b/lib/config/kube_shorthand_test.go
@@ -0,0 +1,93 @@
+package config
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/service"
+	log "github.com/sirupsen/logrus"
+)
+
+func TestKubeListenAddrShorthand(t *testing.T) {
+	for _, test := range []struct {
+		name, yaml, wantAddr string
+		wantError            bool
+	}{
+		{"explicit port", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"default port", "proxy_service:\n  kube_listen_addr: localhost\n", "localhost:3026", false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n", "0.0.0.0:8080", false},
+		{"enabled legacy conflicts", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", "", true},
+		{"legacy address conflicts", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    listen_addr: 0.0.0.0:3026\n", "", true},
+		{"legacy remains supported", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			fc, err := ReadConfig(bytes.NewBufferString(test.yaml))
+			if err != nil {
+				if test.wantError && strings.Contains(err.Error(), "kube_listen_addr") && strings.Contains(err.Error(), "kubernetes") {
+					return
+				}
+				t.Fatalf("ReadConfig: %v", err)
+			}
+			cfg := service.MakeDefaultConfig()
+			err = ApplyFileConfig(fc, cfg)
+			if test.wantError {
+				if err == nil || !strings.Contains(err.Error(), "kube_listen_addr") || !strings.Contains(err.Error(), "kubernetes") {
+					t.Fatalf("expected conflict error, got %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !cfg.Proxy.Kube.Enabled || cfg.Proxy.Kube.ListenAddr.String() != test.wantAddr {
+				t.Fatalf("Kubernetes proxy: enabled=%v addr=%s, want %s", cfg.Proxy.Kube.Enabled, cfg.Proxy.Kube.ListenAddr.String(), test.wantAddr)
+			}
+		})
+	}
+}
+
+func TestKubeServiceWithoutProxyListenAddressWarns(t *testing.T) {
+	var output bytes.Buffer
+	logger := log.StandardLogger()
+	previous := logger.Out
+	logger.Out = &output
+	defer func() { logger.Out = previous }()
+
+	fc, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  enabled: yes\nkubernetes_service:\n  enabled: yes\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyFileConfig(fc, service.MakeDefaultConfig()); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(output.String(), "kube_listen_addr") {
+		t.Fatalf("expected warning about missing kube_listen_addr, got %q", output.String())
+	}
+}
+
+func TestAbsentKubeServiceDoesNotWarn(t *testing.T) {
+	var output bytes.Buffer
+	logger := log.StandardLogger()
+	previous := logger.Out
+	logger.Out = &output
+	defer func() { logger.Out = previous }()
+
+	fc, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  enabled: yes\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyFileConfig(fc, service.MakeDefaultConfig()); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(output.String(), "kube_listen_addr") {
+		t.Fatalf("unexpected Kubernetes warning: %q", output.String())
+	}
+}
+
+func TestConflictingKubeSettingsRejectedWhenProxyDisabled(t *testing.T) {
+	_, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  enabled: no\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n"))
+	if err == nil || !strings.Contains(err.Error(), "kube_listen_addr") || !strings.Contains(err.Error(), "kubernetes") {
+		t.Fatalf("expected conflicting Kubernetes settings to be rejected during parsing, got %v", err)
+	}
+}
