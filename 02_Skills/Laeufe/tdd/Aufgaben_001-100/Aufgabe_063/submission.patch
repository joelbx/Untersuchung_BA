diff --git a/lib/client/kube_address_test.go b/lib/client/kube_address_test.go
new file mode 100644
index 0000000..37ca0a4
--- /dev/null
+++ b/lib/client/kube_address_test.go
@@ -0,0 +1,20 @@
+package client
+
+import "testing"
+
+func TestKubeProxyAddressUsesRoutableWebHost(t *testing.T) {
+	for _, test := range []struct{ listen, public, want string }{
+		{"0.0.0.0:8080", "", "proxy.example.com:8080"},
+		{"[::]:8080", "", "proxy.example.com:8080"},
+		{"0.0.0.0:8080", "kube.example.com:8443", "kube.example.com:8443"},
+	} {
+		tc := &TeleportClient{Config: Config{WebProxyAddr: "proxy.example.com:3080"}}
+		err := tc.applyProxySettings(ProxySettings{Kube: KubeProxySettings{Enabled: true, ListenAddr: test.listen, PublicAddr: test.public}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if tc.KubeProxyAddr != test.want {
+			t.Errorf("listen=%q public=%q: got %q, want %q", test.listen, test.public, tc.KubeProxyAddr, test.want)
+		}
+	}
+}
