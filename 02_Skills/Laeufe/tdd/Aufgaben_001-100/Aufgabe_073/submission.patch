+def test_serialize_includes_unique_edition_languages_except_original_language(
+    display_values, expected
+):
+    item_info = ItemInfo(
+        classifications=None,
+        content_info=ContentInfo(languages=Languages(display_values=display_values)),
+        by_line_info=None,
+        title='',
+    )
+    product = AmazonAPIReply(item_info=item_info, images='', offers='', asin='')
+
+    result = AmazonAPI.serialize(product)
+
+    if expected is None:
+        assert 'languages' not in result
+    else:
+        assert result['languages'] == expected
+
+
+def test_clean_amazon_metadata_for_load_preserves_languages():
+    metadata = {'title': 'A Book', 'languages': ['English', 'French']}
+
+    result = clean_amazon_metadata_for_load(metadata)
+
+    assert result['languages'] == ['English', 'French']
