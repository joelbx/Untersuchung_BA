+func TestLoadDatabasePoolOptions(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pool.yml")
+	require.NoError(t, os.WriteFile(path, []byte("db:\n  max_idle_conn: 3\n  max_open_conn: 17\n  conn_max_lifetime: 45m\n"), 0600))
+
+	cfg, err := Load(path)
+	require.NoError(t, err)
+
+	fields := []struct {
+		name string
+		want interface{}
+	}{
+		{"MaxIdleConn", 3},
+		{"MaxOpenConn", 17},
+		{"ConnMaxLifetime", 45 * time.Minute},
+	}
+	for _, field := range fields {
+		got := reflect.ValueOf(cfg.Database).FieldByName(field.name)
+		if assert.True(t, got.IsValid(), "database config missing %s", field.name) {
+			assert.Equal(t, field.want, got.Interface())
+		}
+	}
+	assert.Equal(t, Default().Database.URL, cfg.Database.URL)
+	assert.Equal(t, Default().Database.MigrationsPath, cfg.Database.MigrationsPath)
+}
+
+func TestLoadMetaCheckForUpdates(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		yaml string
+		want bool
+	}{
+		{"omitted", "{}\n", false},
+		{"enabled", "meta:\n  check_for_updates: true\n", true},
+		{"disabled", "meta:\n  check_for_updates: false\n", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "meta.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tc.yaml), 0600))
+			cfg, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, cfg.Meta.CheckForUpdates)
+		})
+	}
+}
