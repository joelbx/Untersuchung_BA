+@pytest.mark.parametrize('url, fallback, override, expected', [
+    (QUrl('https://example.com/'), False, None, []),
+    (QUrl('https://example.com/'), True, None,
+     [(b'Accept-Language', b'de, en')]),
+    (None, False, None, [(b'Accept-Language', b'de, en')]),
+    (QUrl('https://example.com/'), False, 'fr',
+     [(b'Accept-Language', b'fr')]),
+])
+def test_custom_headers_accept_language_fallback(config_stub, url, fallback,
+                                                 override, expected):
+    """A URL-specific value wins, while XHR can omit the global value."""
+    config_stub.val.content.headers.do_not_track = None
+    config_stub.val.content.headers.custom = {}
+    config_stub.val.content.headers.accept_language = 'de, en'
+    if override is not None:
+        config_stub.set_obj('content.headers.accept_language', override,
+                            pattern=urlmatch.UrlPattern('https://example.com/'))
+
+    assert shared.custom_headers(
+        url=url, fallback_accept_language=fallback) == expected
+
