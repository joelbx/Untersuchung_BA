+package singleton_test
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/singleton"
+)
+
+func TestGetInstanceReusesValueWithoutCallingLaterConstructor(t *testing.T) {
+	type value struct{ id int }
+	calls := 0
+	first := singleton.GetInstance(func() value {
+		calls++
+		return value{id: 42}
+	})
+	second := singleton.GetInstance(func() value {
+		calls++
+		return value{id: 99}
+	})
+
+	if first.id != 42 || second.id != 42 || calls != 1 {
+		t.Fatalf("got first=%+v, second=%+v, constructor calls=%d; want id 42 both times and one call", first, second, calls)
+	}
+}
+
+func TestGetInstanceKeepsValueAndPointerTypesSeparate(t *testing.T) {
+	type value struct{ id int }
+	valueCalls, pointerCalls := 0, 0
+	v := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 10}
+	})
+	p := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 20}
+	})
+	again := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 30}
+	})
+
+	if v.id != 10 || p.id != 20 || p != again || valueCalls != 1 || pointerCalls != 1 {
+		t.Fatalf("got value=%+v, pointer=%p (%+v), again=%p, calls=(%d,%d); want independent instances and one call each", v, p, p, again, valueCalls, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrentCallsCreateOnlyOneInstance(t *testing.T) {
+	type value struct{ id int32 }
+	const callers = 20000
+	var calls atomic.Int32
+	results := make([]*value, callers)
+	start := make(chan struct{})
+	var ready sync.WaitGroup
+	ready.Add(callers)
+	var done sync.WaitGroup
+	done.Add(callers)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			ready.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *value {
+				return &value{id: calls.Add(1)}
+			})
+		}(i)
+	}
+	ready.Wait()
+	close(start)
+	done.Wait()
+
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("constructor ran %d times; want once", got)
+	}
+	for i, result := range results {
+		if result != results[0] || result == nil || result.id != 1 {
+			t.Fatalf("caller %d received %p (%+v); want the same first instance %p", i, result, result, results[0])
+		}
+	}
+}
