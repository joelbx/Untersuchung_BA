+type genericEntry struct {
+	once  sync.Once
+	value interface{}
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+func GetInstance[T any](constructor func() T) T {
+	typeKey := reflect.TypeOf((*T)(nil)).Elem()
+	entryValue, _ := genericInstances.LoadOrStore(typeKey, &genericEntry{})
+	e := entryValue.(*genericEntry)
+	e.once.Do(func() {
+		value := constructor()
+		e.value = &value
+	})
+	return *e.value.(*T)
+}
+
 type entry struct {
