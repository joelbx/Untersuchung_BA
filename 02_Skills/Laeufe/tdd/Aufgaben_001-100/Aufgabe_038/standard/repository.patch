+def test_fetch_file_writes_decoded_content(server, tmpdir):
+    url, _ = server
+    class FileModule(Module):
+        def add_cleanup_file(self, path):
+            pass
+
+    module = FileModule()
+    module.tmpdir = str(tmpdir)
+    path = urls.fetch_file(module, url + '/gzip')
+    with open(path, 'rb') as stream:
+        assert stream.read() == PAYLOAD
