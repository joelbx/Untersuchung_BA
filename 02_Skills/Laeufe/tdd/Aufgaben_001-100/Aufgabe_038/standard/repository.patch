@@ -0,0 +1,163 @@
+from __future__ import absolute_import, division, print_function
+
+import gzip
+import threading
+from io import BytesIO
+
+try:
+    from http.server import BaseHTTPRequestHandler, HTTPServer
+except ImportError:
+    from BaseHTTPServer import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from ansible.module_utils import urls
+
+
+PAYLOAD = b'{"message":"' + b'x' * 1000 + b'"}'
+
+
+@pytest.fixture
+def server():
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            self.server.accept_encoding = self.headers.get('Accept-Encoding')
+            out = BytesIO()
+            with gzip.GzipFile(fileobj=out, mode='wb') as stream:
+                stream.write(PAYLOAD)
+            compressed = out.getvalue()
+            data = PAYLOAD if self.path == '/plain' else compressed
+            self.send_response(200)
+            self.send_header('Content-Length', str(len(data)))
+            if self.path != '/plain':
+                self.send_header('Content-Encoding', 'gzip')
+            self.end_headers()
+            self.wfile.write(data)
+
+        def log_message(self, *args):
+            pass
+
+    httpd = HTTPServer(('127.0.0.1', 0), Handler)
+    worker = threading.Thread(target=httpd.serve_forever)
+    worker.daemon = True
+    worker.start()
+    try:
+        yield 'http://127.0.0.1:%s' % httpd.server_port, httpd
+    finally:
+        httpd.shutdown()
+        worker.join()
+        httpd.server_close()
+
+
+@pytest.mark.parametrize('decompress', [None, True])
+def test_gzip_response_decodes_past_compressed_content_length(server, decompress):
+    url, httpd = server
+    kwargs = {} if decompress is None else {'decompress': decompress}
+    response = urls.open_url(url + '/gzip', **kwargs)
+    try:
+        assert response.read() == PAYLOAD
+        assert response.info()['Content-Encoding'] == 'gzip'
+        assert httpd.accept_encoding == 'gzip'
+    finally:
+        response.close()
+
+
+def test_gzip_response_stays_compressed_when_disabled(server):
+    url, httpd = server
+    response = urls.open_url(url + '/gzip', decompress=False)
+    try:
+        assert gzip.GzipFile(fileobj=BytesIO(response.read())).read() == PAYLOAD
+        assert httpd.accept_encoding != 'gzip'
+    finally:
+        response.close()
+
+
+@pytest.mark.parametrize('decompress', [False, True])
+def test_plain_response_is_unchanged(server, decompress):
+    url, _ = server
+    response = urls.open_url(url + '/plain', decompress=decompress)
+    try:
+        assert response.read() == PAYLOAD
+    finally:
+        response.close()
+
+
+def test_request_uses_instance_defaults_and_call_override(server):
+    url, httpd = server
+    request = urls.Request(decompress=False, unredirected_headers=['X-Secret'], headers={'X-Secret': 'private'})
+    response = request.get(url + '/gzip')
+    try:
+        assert gzip.GzipFile(fileobj=BytesIO(response.read())).read() == PAYLOAD
+    finally:
+        response.close()
+    response = request.get(url + '/gzip', decompress=True)
+    try:
+        assert response.read() == PAYLOAD
+    finally:
+        response.close()
+
+
+def test_explicit_accept_encoding_is_preserved(server):
+    url, httpd = server
+    response = urls.open_url(url + '/plain', headers={'accept-encoding': 'identity'})
+    response.close()
+    assert httpd.accept_encoding == 'identity'
+
+
+class Module:
+    params = {}
+    tmpdir = None
+
+    def __init__(self):
+        self.deprecations = []
+
+    def deprecate(self, message, version):
+        self.deprecations.append((message, version))
+
+    def fail_json(self, **kwargs):
+        raise AssertionError(kwargs)
+
+
+def test_fetch_url_decodes_and_keeps_header_names_lowercase(server):
+    url, _ = server
+    response, info = urls.fetch_url(Module(), url + '/gzip')
+    try:
+        assert response.read() == PAYLOAD
+        assert info['content-encoding'] == 'gzip'
+        assert 'Content-Encoding' not in info
+        assert info['status'] == 200
+    finally:
+        response.close()
+
+
+def test_fetch_url_disables_decoding_with_deprecation_when_gzip_unavailable(server, monkeypatch):
+    url, _ = server
+    monkeypatch.setattr(urls, 'HAS_GZIP', False)
+    module = Module()
+    response, info = urls.fetch_url(module, url + '/gzip')
+    try:
+        assert gzip.GzipFile(fileobj=BytesIO(response.read())).read() == PAYLOAD
+        assert module.deprecations[0][1] == '2.16'
+    finally:
+        response.close()
+
+
+def test_direct_request_reports_missing_gzip_dependency(server, monkeypatch):
+    url, _ = server
+    monkeypatch.setattr(urls, 'HAS_GZIP', False)
+    with pytest.raises(urls.MissingModuleError, match='gzip') as exc:
+        urls.open_url(url + '/gzip', decompress=True)
+    assert exc.value.module == 'gzip'
+
