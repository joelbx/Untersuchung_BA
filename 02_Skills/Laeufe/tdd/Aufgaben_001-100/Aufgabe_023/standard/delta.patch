diff --git a/internal/config/authentication_database_test.go b/internal/config/authentication_database_test.go
new file mode 100644
index 0000000..f26f267
--- /dev/null
+++ b/internal/config/authentication_database_test.go
@@ -0,0 +1,49 @@
+package config
+
+import "testing"
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	tests := []struct {
+		name   string
+		enable func(*AuthenticationConfig)
+		want   bool
+	}{
+		{"none", func(*AuthenticationConfig) {}, false},
+		{"required without methods", func(c *AuthenticationConfig) { c.Required = true }, false},
+		{"jwt", func(c *AuthenticationConfig) { c.Methods.JWT.Enabled = true }, false},
+		{"token", func(c *AuthenticationConfig) { c.Methods.Token.Enabled = true }, true},
+		{"oidc", func(c *AuthenticationConfig) { c.Methods.OIDC.Enabled = true }, true},
+		{"github", func(c *AuthenticationConfig) { c.Methods.Github.Enabled = true }, true},
+		{"kubernetes", func(c *AuthenticationConfig) { c.Methods.Kubernetes.Enabled = true }, true},
+		{"jwt and token", func(c *AuthenticationConfig) { c.Methods.JWT.Enabled = true; c.Methods.Token.Enabled = true }, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var cfg AuthenticationConfig
+			tt.enable(&cfg)
+			if got := cfg.RequiresDatabase(); got != tt.want {
+				t.Fatalf("RequiresDatabase() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAuthenticationCleanupRequiresDatabase(t *testing.T) {
+	schedule := &AuthenticationCleanupSchedule{}
+	tests := []struct {
+		name string
+		cfg  AuthenticationConfig
+		want bool
+	}{
+		{"disabled token", AuthenticationConfig{Methods: AuthenticationMethods{Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Cleanup: schedule}}}, false},
+		{"jwt", AuthenticationConfig{Methods: AuthenticationMethods{JWT: AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true, Cleanup: schedule}}}, false},
+		{"token", AuthenticationConfig{Methods: AuthenticationMethods{Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Enabled: true, Cleanup: schedule}}}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.cfg.ShouldRunCleanup(); got != tt.want {
+				t.Fatalf("ShouldRunCleanup() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
