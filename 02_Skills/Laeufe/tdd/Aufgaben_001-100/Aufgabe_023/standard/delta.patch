--- /dev/null
+++ b/internal/cmd/authn_database_test.go
@@ -0,0 +1,56 @@
+package cmd
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap/zaptest"
+)
+
+func TestAuthenticationGRPCJWTWithoutDatabase(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyFile := filepath.Join(t.TempDir(), "public.pem")
+	if err := os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der}), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, storage := range []config.StorageType{config.LocalStorageType, config.GitStorageType, config.OCIStorageType} {
+		t.Run(string(storage), func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Storage.Type = storage
+			cfg.Authentication.Required = true
+			cfg.Authentication.Methods.JWT.Enabled = true
+			cfg.Authentication.Methods.JWT.Method.PublicKeyFile = keyFile
+			cfg.Authentication.Methods.JWT.Cleanup = &config.AuthenticationCleanupSchedule{}
+			cfg.Database.URL = "invalid://database-should-not-be-opened"
+
+			register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zaptest.NewLogger(t), cfg, false, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(register) != 2 {
+				t.Fatalf("registered %d services, want 2", len(register))
+			}
+			if len(interceptors) != 3 {
+				t.Fatalf("registered %d interceptors, want JWT, client token, and required-auth interceptors", len(interceptors))
+			}
+			if err := shutdown(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
