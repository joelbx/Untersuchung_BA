diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..1d0e0ba
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,60 @@
+package evaluation
+
+import (
+	"testing"
+
+	"go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/storage"
+)
+
+func TestStringListOperators(t *testing.T) {
+	for _, tt := range []struct {
+		name, operator, list, value string
+		want                        bool
+	}{
+		{"one of matches", "isoneof", `["alpha","beta"]`, "beta", true},
+		{"one of misses", "isoneof", `["alpha","beta"]`, "gamma", false},
+		{"not one of matches absence", "isnotoneof", `["alpha","beta"]`, "gamma", true},
+		{"not one of rejects presence", "isnotoneof", `["alpha","beta"]`, "alpha", false},
+		{"malformed one of misses", "isoneof", `["alpha"`, "alpha", false},
+		{"malformed not one of matches absence", "isnotoneof", `["alpha"`, "alpha", true},
+		{"wrong type one of misses", "isoneof", `[1]`, "1", false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got := matchesString(storage.EvaluationConstraint{Operator: tt.operator, Value: tt.list}, tt.value)
+			if got != tt.want {
+				t.Fatalf("match = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNumberListOperators(t *testing.T) {
+	for _, tt := range []struct {
+		name, operator, list, value string
+		want, invalid               bool
+	}{
+		{"one of matches", "isoneof", `[1,2.5]`, "2.5", true, false},
+		{"one of misses", "isoneof", `[1,2.5]`, "3", false, false},
+		{"not one of matches absence", "isnotoneof", `[1,2.5]`, "3", true, false},
+		{"not one of rejects presence", "isnotoneof", `[1,2.5]`, "1", false, false},
+		{"malformed list", "isoneof", `[1`, "1", false, true},
+		{"wrong element type", "isnotoneof", `[1,"2"]`, "1", false, true},
+		{"malformed list with missing context", "isoneof", `[1`, "", false, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := matchesNumber(storage.EvaluationConstraint{Operator: tt.operator, Value: tt.list}, tt.value)
+			if got != tt.want {
+				t.Fatalf("match = %v, want %v", got, tt.want)
+			}
+			if (err != nil) != tt.invalid {
+				t.Fatalf("error = %v, invalid = %v", err, tt.invalid)
+			}
+			if tt.invalid {
+				if _, ok := err.(errors.ErrInvalid); !ok {
+					t.Fatalf("error type = %T, want ErrInvalid", err)
+				}
+			}
+		})
+	}
+}
diff --git a/rpc/flipt/list_validation_test.go b/rpc/flipt/list_validation_test.go
new file mode 100644
index 0000000..36aaa24
--- /dev/null
+++ b/rpc/flipt/list_validation_test.go
@@ -0,0 +1,43 @@
+package flipt
+
+import (
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/errors"
+)
+
+func TestConstraintListValidation(t *testing.T) {
+	for _, tt := range []struct {
+		name, operator string
+		typ            ComparisonType
+		value          string
+		want           error
+	}{
+		{"string list", "isoneof", ComparisonType_STRING_COMPARISON_TYPE, `["a","b"]`, nil},
+		{"number list", "isnotoneof", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,2.5]`, nil},
+		{"string 100 items", "isoneof", ComparisonType_STRING_COMPARISON_TYPE, `[` + strings.Repeat(`"a",`, 99) + `"a"]`, nil},
+		{"number 100 items", "isnotoneof", ComparisonType_NUMBER_COMPARISON_TYPE, `[` + strings.Repeat(`1,`, 99) + `1]`, nil},
+		{"string 101 items", "isoneof", ComparisonType_STRING_COMPARISON_TYPE, `[` + strings.Repeat(`"a",`, 100) + `"a"]`, errors.ErrInvalid(`too many values provided for property "region" of type string (maximum 100)`)},
+		{"number 101 items", "isnotoneof", ComparisonType_NUMBER_COMPARISON_TYPE, `[` + strings.Repeat(`1,`, 100) + `1]`, errors.ErrInvalid(`too many values provided for property "region" of type number (maximum 100)`)},
+		{"malformed string", "isoneof", ComparisonType_STRING_COMPARISON_TYPE, `["a"`, errors.ErrInvalid(`invalid value provided for property "region" of type string`)},
+		{"wrong string element", "isnotoneof", ComparisonType_STRING_COMPARISON_TYPE, `["a",1]`, errors.ErrInvalid(`invalid value provided for property "region" of type string`)},
+		{"wrong number element", "isoneof", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,"2"]`, errors.ErrInvalid(`invalid value provided for property "region" of type number`)},
+		{"scalar string", "isoneof", ComparisonType_STRING_COMPARISON_TYPE, `"a"`, errors.ErrInvalid(`invalid value provided for property "region" of type string`)},
+		{"null number", "isnotoneof", ComparisonType_NUMBER_COMPARISON_TYPE, `null`, errors.ErrInvalid(`invalid value provided for property "region" of type number`)},
+	} {
+		for _, request := range []string{"create", "update"} {
+			t.Run(request+"/"+tt.name, func(t *testing.T) {
+				var got error
+				if request == "create" {
+					got = (&CreateConstraintRequest{SegmentKey: "segment", Property: "region", Type: tt.typ, Operator: tt.operator, Value: tt.value}).Validate()
+				} else {
+					got = (&UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "region", Type: tt.typ, Operator: tt.operator, Value: tt.value}).Validate()
+				}
+				if got != tt.want && (got == nil || tt.want == nil || got.Error() != tt.want.Error()) {
+					t.Fatalf("error = %v, want %v", got, tt.want)
+				}
+			})
+		}
+	}
+}
