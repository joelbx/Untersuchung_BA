+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { NotificationOptions } from '../containers/notifications/interfaces';
+import createNotificationManager from '../containers/notifications/manager';
+import NotificationsContext from '../containers/notifications/notificationsContext';
+import { useLinkHandler } from './useLinkHandler';
+
+describe('useLinkHandler', () => {
+    const setup = (href?: string) => {
+        let notifications: NotificationOptions[] = [];
+        const manager = createNotificationManager((update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        });
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        if (href !== undefined) {
+            anchor.setAttribute('href', href);
+        }
+        wrapper.appendChild(anchor);
+        const result = renderHook(() => useLinkHandler({ current: wrapper }), {
+            wrapper: ({ children }) => (
+                <NotificationsContext.Provider value={manager}>{children}</NotificationsContext.Provider>
+            ),
+        });
+        return { anchor, manager, notifications: () => notifications, ...result };
+    };
+
+    it('shows the ASCII hostname in the confirmation link', async () => {
+        const { anchor, result } = setup('https://www.аррӏе.com/path?next=https://аррӏе.com#part');
+        await act(async () => {
+            anchor.click();
+        });
+        expect((result.current.modal as JSX.Element).props.link).toBe(
+            'https://www.xn--80ak6aa92e.com/path?next=https://аррӏе.com#part'
+        );
+    });
+
+    it('shows an error notification when an anchor has no URL', async () => {
+        const { anchor, manager, notifications } = setup();
+        await act(async () => {
+            anchor.click();
+        });
+        expect(notifications()).toEqual([expect.objectContaining({ type: 'error' })]);
+        manager.clearNotifications();
+    });
+});
