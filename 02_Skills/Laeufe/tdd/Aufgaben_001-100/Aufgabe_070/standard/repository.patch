-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        normalized = language.casefold()
+        if len(normalized) == 2:
+            matches = web.ctx.site.things(
+                {
+                    'type': '/type/language',
+                    'identifiers.iso_639_1': normalized,
+                    'limit': 2,
+                }
+            )
+            if len(matches) == 1:
+                code = matches[0].rsplit('/', 1)[-1]
+            elif matches:
+                code = None
+            else:
+                code = get_marc21_language(normalized)
+        elif len(normalized) == 3:
+            code = normalized
+        else:
+            try:
+                keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+                available_languages = (
+                    lang
+                    for lang in web.ctx.site.get_many(keys)
+                    if not lang.deprecated
+                )
+                code = get_abbrev_from_full_lang_name(
+                    language, languages=available_languages
+                )
+            except (LanguageNoMatchError, LanguageMultipleMatchError):
+                code = None
+
+        if code is None or web.ctx.site.get(f"/languages/{code}") is None:
+            raise InvalidLanguage(normalized)
+
+        if code not in seen:
+            formatted_languages.append({'key': f'/languages/{code}'})
+            seen.add(code)
 
     return formatted_languages
