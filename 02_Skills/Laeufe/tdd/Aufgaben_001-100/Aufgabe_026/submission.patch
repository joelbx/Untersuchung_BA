+func TestUbuntuAPIDetailsAppearInVulnerability(t *testing.T) {
+	v := VulnInfo{CveContents: NewCveContents(
+		CveContent{Type: Ubuntu, Summary: "oval summary"},
+		CveContent{Type: UbuntuAPI, Title: "api title", Summary: "api summary", Cvss3Score: 7.5, Cvss3Severity: "HIGH"},
+		CveContent{Type: Nvd, Summary: "nvd summary"},
+	)}
+	if got, want := v.Summaries("en", "ubuntu")[:2], []CveContentStr{{Ubuntu, "oval summary"}, {UbuntuAPI, "api summary"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("summaries = %v, want %v", got, want)
+	}
+	titles := v.Titles("en", "ubuntu")
+	if got, want := titles[:2], []CveContentStr{{Nvd, "nvd summary"}, {Ubuntu, "oval summary"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("title priority = %v, want %v", got, want)
+	}
+	if !reflect.DeepEqual(titles[2], CveContentStr{UbuntuAPI, "api summary"}) {
+		t.Errorf("Ubuntu API title missing from %v", titles)
+	}
+	found := false
+	for _, score := range v.Cvss3Scores() {
+		if score.Type == UbuntuAPI && score.Value.Score == 7.5 {
+			found = true
+		}
+	}
+	if !found {
+		t.Errorf("Ubuntu API CVSS score missing from %v", v.Cvss3Scores())
+	}
+}
+
+func TestNegligibleSeverityMapsToLow(t *testing.T) {
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("range = %q", got)
+	}
+	if got := severityToCvssScoreRoughly("negligible"); got != 3.9 {
+		t.Errorf("rough score = %v", got)
+	}
+}
+
+func TestSingleSourceFamilyCVSS3Scores(t *testing.T) {
+	for _, source := range []CveContentType{Oracle, Fedora, Microsoft} {
+		t.Run(string(source), func(t *testing.T) {
+			v := VulnInfo{CveContents: NewCveContents(CveContent{Type: source, Cvss3Score: 6.2, Cvss3Severity: "MEDIUM"})}
+			got := v.Cvss3Scores()
+			if len(got) != 1 || got[0].Type != source || got[0].Value.Score != 6.2 {
+				t.Fatalf("CVSS v3 score for %s = %v, want 6.2", source, got)
+			}
+		})
+	}
+}
