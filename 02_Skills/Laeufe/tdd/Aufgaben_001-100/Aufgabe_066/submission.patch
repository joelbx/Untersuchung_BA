+import { Base64Cache } from '../../../hooks/useBase64Cache';
+import { MessageState } from '../../../logic/messages/messagesTypes';
+import { prepareHtml } from '../transforms';
+
+describe('prepareHtml', () => {
+    it('replaces viewport based inline heights throughout the email while preserving other styles', async () => {
+        const message = {
+            localID: 'viewport-height-email',
+            decryption: {
+                decryptedBody: `
+                    <section id="outer" style="height: 100vh; color: red">
+                        <div id="inner" style="height: calc(50vh - 2px); width: 20px"></div>
+                        <div id="fixed" style="height: 40px; min-height: 20vh"></div>
+                    </section>
+                `,
+            },
+        } as MessageState;
+
+        const { document } = await prepareHtml(
+            message,
+            new Map() as Base64Cache,
+            undefined,
+            async () => [],
+            () => {},
+            () => {},
+            () => {}
+        );
+
+        expect((document?.querySelector('#outer') as HTMLElement).style.height).toBe('auto');
+        expect((document?.querySelector('#outer') as HTMLElement).style.color).toBe('red');
+        expect((document?.querySelector('#inner') as HTMLElement).style.height).toBe('auto');
+        expect((document?.querySelector('#inner') as HTMLElement).style.width).toBe('20px');
+        expect((document?.querySelector('#fixed') as HTMLElement).style.height).toBe('40px');
+        expect((document?.querySelector('#fixed') as HTMLElement).style.minHeight).toBe('20vh');
+    });
+});
diff --git a/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
