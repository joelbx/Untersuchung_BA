@@ -0,0 +1,13 @@
+#ifndef TOUCHID_DIAG_H_
+#define TOUCHID_DIAG_H_
+
+typedef struct {
+  int has_signature;
+  int has_entitlements;
+  int passed_la_policy_test;
+  int passed_secure_enclave_test;
+} TouchIDDiag;
+
+TouchIDDiag TouchIDDiagnostics(void);
+
+#endif // TOUCHID_DIAG_H_
diff --git a/lib/auth/touchid/diag.m b/lib/auth/touchid/diag.m
new file mode 100644
index 0000000..ca013b4
--- /dev/null
+++ b/lib/auth/touchid/diag.m
@@ -0,0 +1,48 @@
+//go:build touchid
+// +build touchid
+
+#include "diag.h"
+
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+
+TouchIDDiag TouchIDDiagnostics(void) {
+  TouchIDDiag result = {0};
+
+  SecCodeRef code = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &code) == errSecSuccess) {
+    result.has_signature =
+        SecCodeCheckValidity(code, kSecCSDefaultFlags, NULL) == errSecSuccess;
+
+    CFDictionaryRef signingInfo = NULL;
+    if (SecCodeCopySigningInformation(code, kSecCSSigningInformation,
+                                      &signingInfo) == errSecSuccess) {
+      NSDictionary *entitlements =
+          [(__bridge NSDictionary *)signingInfo objectForKey:(id)kSecCodeInfoEntitlementsDict];
+      result.has_entitlements =
+          [entitlements[@"keychain-access-groups"] count] > 0;
+      CFRelease(signingInfo);
+    }
+    CFRelease(code);
+  }
+
+  LAContext *context = [[LAContext alloc] init];
+  result.passed_la_policy_test =
+      [context canEvaluatePolicy:LAPolicyDeviceOwnerAuthenticationWithBiometrics
+                          error:NULL];
+
+  NSDictionary *attributes = @{
+    (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+    (id)kSecAttrKeySizeInBits : @256,
+    (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+  };
+  SecKeyRef key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes,
+                                       NULL);
+  if (key) {
+    result.passed_secure_enclave_test = 1;
+    CFRelease(key);
+  }
+
+  return result;
+}
diff --git a/lib/auth/touchid/diag_test.go b/lib/auth/touchid/diag_test.go
new file mode 100644
index 0000000..23888a3
--- /dev/null
+++ b/lib/auth/touchid/diag_test.go
@@ -0,0 +1,23 @@
+//go:build !touchid
+
+package touchid_test
+
+import (
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/touchid"
+	"github.com/stretchr/testify/require"
+)
+
+// A build without the native backend must not report Touch ID as usable.
+func TestDiagWithoutTouchIDSupport(t *testing.T) {
+	result, err := touchid.Diag()
+	require.NoError(t, err)
+	require.NotNil(t, result)
+	require.False(t, result.HasCompileSupport)
+	require.False(t, result.HasSignature)
+	require.False(t, result.HasEntitlements)
+	require.False(t, result.PassedLAPolicyTest)
+	require.False(t, result.PassedSecureEnclaveTest)
+	require.False(t, result.IsAvailable)
+}
