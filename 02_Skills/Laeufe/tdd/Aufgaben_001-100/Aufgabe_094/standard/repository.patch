+// DiagResult contains the results of the Touch ID availability checks.
+type DiagResult struct {
+	HasCompileSupport       bool
+	HasSignature            bool
+	HasEntitlements         bool
+	PassedLAPolicyTest      bool
+	PassedSecureEnclaveTest bool
+	IsAvailable             bool
+}
+
+// Diag runs the Touch ID availability checks and reports each result.
+func Diag() (*DiagResult, error) {
+	result, err := nativeDiag()
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	result.IsAvailable = result.HasCompileSupport && result.HasSignature &&
+		result.HasEntitlements && result.PassedLAPolicyTest && result.PassedSecureEnclaveTest
+	return result, nil
+}
