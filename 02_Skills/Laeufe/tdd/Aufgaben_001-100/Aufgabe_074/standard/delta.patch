+    def test_path_argument_reaches_function_as_path(self):
+        def fn(source: Path):
+            return source
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['data/input.txt'])
+        assert cli.run() == Path('data/input.txt')
+
+    def test_required_typed_list_is_positional(self):
+        def fn(numbers: list[int]):
+            return numbers
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1', '2', '3'])
+        assert cli.run() == [1, 2, 3]
+
+    def test_optional_typed_list_uses_named_option(self):
+        def fn(files: list[Path] | None = None, count: int = 0):
+            return files, count
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--files', 'one.txt', 'two.txt', '--count', '2'])
+        assert cli.run() == ([Path('one.txt'), Path('two.txt')], 2)
+
+    def test_omitted_optional_list_is_none(self):
+        def fn(files: list[Path] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() is None
+
+    def test_async_run_returns_function_result(self):
+        async def fn(value: float):
+            return value * 2
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1.5'])
+        assert cli.run() == 3.0
+
+    def test_optional_list_of_floats_converts_values(self):
+        def fn(values: list[float] | None = None):
+            return values
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--values', '1.5', '2.25'])
+        assert cli.run() == [1.5, 2.25]
 
