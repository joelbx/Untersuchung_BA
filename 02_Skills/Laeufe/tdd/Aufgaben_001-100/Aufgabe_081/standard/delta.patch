new file mode 100644
index 0000000..559c5a0
--- /dev/null
+++ b/internal/config/authentication_domain_test.go
@@ -0,0 +1,35 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAuthenticationValidateNormalizesSessionDomain(t *testing.T) {
+	for _, tc := range []struct {
+		name, domain, want string
+	}{
+		{"scheme and port", "http://localhost:8080", "localhost"},
+		{"https and port", "https://example.com:8443", "example.com"},
+		{"host and port", "example.com:8080", "example.com"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{Session: AuthenticationSession{Domain: tc.domain}}
+			cfg.Methods.OIDC.Enabled = true
+			if err := cfg.validate(); err != nil {
+				t.Fatal(err)
+			}
+			if cfg.Session.Domain != tc.want {
+				t.Fatalf("domain = %q, want %q", cfg.Session.Domain, tc.want)
+			}
+		})
+	}
+}
+
+func TestAuthenticationValidatePropagatesInvalidDomain(t *testing.T) {
+	cfg := AuthenticationConfig{Session: AuthenticationSession{Domain: "http://%"}}
+	cfg.Methods.OIDC.Enabled = true
+	if err := cfg.validate(); err == nil || !strings.Contains(err.Error(), "invalid URL escape") {
+		t.Fatalf("validate error = %v, want URL parsing error", err)
+	}
+}
