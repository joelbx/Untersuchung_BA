+++ b/internal/server/auth/method/oidc/domain_test.go
@@ -0,0 +1,57 @@
+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestStateCookieDomainAndPath(t *testing.T) {
+	for _, tc := range []struct {
+		name, domain, wantDomain string
+	}{
+		{"localhost", "localhost", ""},
+		{"other host", "example.com", "example.com"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			Middleware{Config: config.AuthenticationSession{Domain: tc.domain}}.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(recorder, request)
+			cookies := recorder.Result().Cookies()
+			if len(cookies) != 1 || cookies[0].Name != stateCookieKey {
+				t.Fatalf("cookies = %v, want state cookie", cookies)
+			}
+			if cookies[0].Domain != tc.wantDomain || cookies[0].Path != "/auth/v1/method/oidc/google/callback" {
+				t.Fatalf("cookie domain/path = %q/%q, want %q/callback path", cookies[0].Domain, cookies[0].Path, tc.wantDomain)
+			}
+		})
+	}
+}
+
+func TestCallbackURLRemovesOneTrailingSlash(t *testing.T) {
+	for _, tc := range []struct{ host, want string }{
+		{"http://localhost:8080/", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"https://example.com", "https://example.com/auth/v1/method/oidc/google/callback"},
+		{"https://example.com//", "https://example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		if got := callbackURL(tc.host, "google"); got != tc.want {
+			t.Fatalf("callbackURL(%q) = %q, want %q", tc.host, got, tc.want)
+		}
+	}
+}
+
+func TestTokenCookieOmitsLocalhostDomain(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	err := (Middleware{Config: config.AuthenticationSession{Domain: "localhost"}}).ForwardResponseOption(context.Background(), recorder, &auth.CallbackResponse{ClientToken: "token"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cookies := recorder.Result().Cookies()
+	if len(cookies) != 1 || cookies[0].Name != tokenCookieKey || cookies[0].Domain != "" || cookies[0].Path != "/" {
+		t.Fatalf("cookies = %v, want host-only token cookie at /", cookies)
+	}
+}
