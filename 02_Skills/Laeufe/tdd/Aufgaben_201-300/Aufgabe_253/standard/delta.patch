+
+def test_stderr_is_reported_before_process_exits(proc, qtbot, py_proc,
+                                                 message_mock, caplog):
+    """A process writing to stderr surfaces its error while still running."""
+    proc._output_messages = True
+    cmd, args = py_proc(r"""
+        import sys, time
+        sys.stderr.write('early error\n')
+        sys.stderr.flush()
+        time.sleep(2)
+    """)
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            proc.start(cmd, args)
+            qtbot.wait_until(
+                lambda: any(msg.text == 'early error' and
+                            msg.level == usertypes.MessageLevel.error
+                            for msg in message_mock.messages), timeout=1000)
+            assert proc.outcome.running
+
+    assert [(msg.level, msg.text) for msg in message_mock.messages] == [
+        (usertypes.MessageLevel.error, 'early error'),
+        (usertypes.MessageLevel.error, 'early error'),
+    ]
+
 
