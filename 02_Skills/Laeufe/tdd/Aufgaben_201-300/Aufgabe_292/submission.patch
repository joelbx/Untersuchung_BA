diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..492a1d3
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,55 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+// Removing cancellation or the join from Close must fail this test.
+func TestPollerCloseWaitsForUpdateAndStopsFutureUpdates(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	exited := make(chan struct{})
+	calls := 0
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		calls++
+		close(entered)
+		<-release
+		defer close(exited)
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	p.Poll()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("polling did not begin")
+	}
+	closed := make(chan struct{})
+	go func() { _ = p.Close(); close(closed) }()
+	select {
+	case <-closed:
+		t.Fatal("Close returned while update was running")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not return")
+	}
+	select {
+	case <-exited:
+	default:
+		t.Fatal("Close returned before update exited")
+	}
+	time.Sleep(10 * time.Millisecond)
+	if calls != 1 {
+		t.Fatalf("got %d updates after close, want 1", calls)
+	}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
