+func TestValidateFilesReportsEachInvalidFieldAtItsYAMLPosition(t *testing.T) {
+	// Removing a field path or using a parent position must fail this test.
+	file := filepath.Join(t.TempDir(), "features.yaml")
+	content := "flags:\n- key: example\n  name: Example\n  enabled: true\n  ey: typo\n  nabled: true\n  escription: typo\n  variants: []\n  rules:\n  - segment: users\n    rank: 1\n    distributions:\n    - variant: default\n      rollout: 110\nsegments: []\n"
+	require.NoError(t, os.WriteFile(file, []byte(content), 0600))
+
+	var output bytes.Buffer
+	require.ErrorIs(t, ValidateFiles(&output, []string{file}, "json"), ErrValidationFailed)
+	var result struct {
+		Errors []struct {
+			Path     string   `json:"path"`
+			Message  string   `json:"message"`
+			Location Location `json:"location"`
+		} `json:"errors"`
+	}
+	require.NoError(t, json.Unmarshal(output.Bytes(), &result))
+	require.Len(t, result.Errors, 4)
+	want := map[string]Location{"flags.0.ey": {Line: 5, Column: 4}, "flags.0.nabled": {Line: 6, Column: 4}, "flags.0.escription": {Line: 7, Column: 4}, "flags.0.rules.0.distributions.0.rollout": {Line: 14, Column: 17}}
+	for _, issue := range result.Errors {
+		location, ok := want[issue.Path]
+		require.True(t, ok, "unexpected path %q: %s", issue.Path, issue.Message)
+		require.Equal(t, file, issue.Location.File)
+		require.Equal(t, location.Line, issue.Location.Line, issue.Path)
+		require.Equal(t, location.Column, issue.Location.Column, issue.Path)
+		require.Contains(t, issue.Message, issue.Path)
+		if issue.Path == "flags.0.rules.0.distributions.0.rollout" {
+			require.Contains(t, issue.Message, "<=100")
+		}
+		delete(want, issue.Path)
+	}
+	require.Empty(t, want)
+}
