@@ -0,0 +1,38 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestValidateCommandReportsFailureAlongsideJSON(t *testing.T) {
+	// Dropping the failure message while keeping the exit code must fail.
+	if file := os.Getenv("FLIPT_VALIDATE_SUBPROCESS"); file != "" {
+		command := newValidateCommand()
+		command.SetArgs([]string{"-F", "json", file})
+		_ = command.Execute()
+		return
+	}
+	file := filepath.Join(t.TempDir(), "invalid.yaml")
+	if err := os.WriteFile(file, []byte("flags:\n- key: sample\n  name: Sample\n  enabled: true\n  nabled: true\n  variants: []\n  rules: []\nsegments: []\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^TestValidateCommandReportsFailureAlongsideJSON$")
+	cmd.Env = append(os.Environ(), "FLIPT_VALIDATE_SUBPROCESS="+file)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	err := cmd.Run()
+	if err == nil {
+		t.Fatal("expected nonzero exit status")
+	}
+	if !strings.Contains(stderr.String(), "validation failed") {
+		t.Fatalf("stderr should identify validation failure, got %q", stderr.String())
+	}
+	if !strings.Contains(stdout.String(), `"path":"flags.0.nabled"`) {
+		t.Fatalf("stdout should contain JSON validation result, got %q", stdout.String())
+	}
+}
