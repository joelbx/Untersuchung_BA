+func TestNewClusterSessionUsesUnregisteredLocalCredentials(t *testing.T) {
+	f := newMockForwader(context.Background(), t)
+	creds := &kubeCreds{targetAddr: "local-kube:443", tlsConfig: &tls.Config{}, transportConfig: &transport.Config{}}
+	f.creds = map[string]*kubeCreds{"local-kube": creds}
+	f.cfg.CachingAuthClient = mockAccessPoint{}
+
+	sess, err := f.newClusterSession(authContext{
+		kubeCluster:     "local-kube",
+		teleportCluster: teleportClusterClient{name: "root"},
+	})
+	require.NoError(t, err)
+	require.Same(t, creds, sess.creds)
+	require.Same(t, creds.tlsConfig, sess.tlsConfig)
+	require.Equal(t, "local-kube:443", sess.teleportCluster.targetAddr)
+	require.Zero(t, f.clientCredentials.Len())
+}
+
+func TestNewClusterSessionRequiresKubeCluster(t *testing.T) {
+	f := newMockForwader(context.Background(), t)
+	user, err := types.NewUser("bob")
+	require.NoError(t, err)
+	for _, remote := range []bool{false, true} {
+		_, err := f.newClusterSession(authContext{
+			Context:         auth.Context{User: user, Identity: identity, UnmappedIdentity: unmappedIdentity},
+			teleportCluster: teleportClusterClient{name: "root", isRemote: remote},
+		})
+		require.True(t, trace.IsNotFound(err), "remote=%v: %v", remote, err)
+	}
+}
