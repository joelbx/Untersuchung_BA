diff --git a/internal/config/authentication_validation_test.go b/internal/config/authentication_validation_test.go
new file mode 100644
index 0000000..cb74c5e
--- /dev/null
+++ b/internal/config/authentication_validation_test.go
@@ -0,0 +1,47 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLoadRejectsIncompleteAuthenticationProviders(t *testing.T) {
+	// Removing any required field must make the startup configuration fail.
+	for _, method := range []struct {
+		name     string
+		provider string
+		prefix   string
+		indent   string
+	}{
+		{"github", "github", "", "      "},
+		{"oidc", "foo", "      providers:\n        foo:\n", "          "},
+	} {
+		for _, missing := range []string{"client_id", "client_secret", "redirect_address"} {
+			t.Run(method.name+"/"+missing, func(t *testing.T) {
+				fields := ""
+				for _, field := range []string{"client_id", "client_secret", "redirect_address"} {
+					if field != missing {
+						fields += fmt.Sprintf("%s%s: value\n", method.indent, field)
+					}
+				}
+				content := fmt.Sprintf("authentication:\n  session:\n    domain: localhost\n  methods:\n    %s:\n      enabled: true\n%s%s", method.name, method.prefix, fields)
+				path := filepath.Join(t.TempDir(), "config.yml")
+				require.NoError(t, os.WriteFile(path, []byte(content), 0600))
+				_, err := Load(path)
+				require.EqualError(t, err, fmt.Sprintf("provider %q: field %q: non-empty value is required", method.provider, missing))
+			})
+		}
+	}
+}
+
+func TestLoadRejectsGithubOrganizationsWithoutReadOrgScope(t *testing.T) {
+	content := "authentication:\n  session:\n    domain: localhost\n  methods:\n    github:\n      enabled: true\n      client_id: id\n      client_secret: secret\n      redirect_address: http://localhost/callback\n      allowed_organizations:\n        - flipt-io\n      scopes:\n        - user:email\n"
+	path := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(path, []byte(content), 0600))
+	_, err := Load(path)
+	require.EqualError(t, err, `provider "github": field "scopes": must contain read:org when allowed_organizations is not empty`)
+}
