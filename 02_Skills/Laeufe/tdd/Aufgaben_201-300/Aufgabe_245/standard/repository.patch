+func Test_execPortsScanAcceptsGroupedDestinations(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	port := strconv.Itoa(listener.Addr().(*net.TCPAddr).Port)
+	dest := map[string][]string{"127.0.0.1": {port}}
+	got, err := (&base{}).execPortsScan(dest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{net.JoinHostPort("127.0.0.1", port)}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("execPortsScan() = %v, want %v", got, want)
+	}
+}
