--- /dev/null
+++ b/models/kev_test.go
@@ -0,0 +1,48 @@
+package models
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// Removing the KEV field or counting entries instead of CVEs must fail these tests.
+func TestFormatKEVCveSummaryCountsCVEs(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"one":   {KEVs: []KEV{{Type: CISAKEVType}, {Type: VulnCheckKEVType}}},
+		"two":   {KEVs: []KEV{{Type: CISAKEVType}}},
+		"three": {},
+	}}
+	if got := r.FormatKEVCveSummary(); got != "2 KEVs" {
+		t.Fatalf("got %q, want 2 KEVs", got)
+	}
+}
+
+// Removing either sort key must fail this test.
+func TestSortForJSONOutputOrdersKEVs(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{"one": {KEVs: []KEV{
+		{Type: VulnCheckKEVType, VulnerabilityName: "Zulu"},
+		{Type: CISAKEVType, VulnerabilityName: "Zulu"},
+		{Type: CISAKEVType, VulnerabilityName: "Alpha"},
+		{Type: VulnCheckKEVType, VulnerabilityName: "Alpha"},
+	}}}}
+	r.SortForJSONOutput()
+	got := r.ScannedCves["one"].KEVs
+	want := []string{"cisa/Alpha", "cisa/Zulu", "vulncheck/Alpha", "vulncheck/Zulu"}
+	for i, kev := range got {
+		if string(kev.Type)+"/"+kev.VulnerabilityName != want[i] {
+			t.Fatalf("position %d: got %+v, want %s", i, kev, want[i])
+		}
+	}
+}
+
+func TestKEVJSONHasDedicatedField(t *testing.T) {
+	r := VulnInfo{KEVs: []KEV{{Type: CISAKEVType, CISA: &CISAKEV{Note: "note"}}}}
+	b, err := json.Marshal(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(b), `"kevs":[{"type":"cisa"`) || !strings.Contains(string(b), `"note":"note"`) {
+		t.Fatalf("KEV details missing from vulnerability JSON: %s", b)
+	}
+}
