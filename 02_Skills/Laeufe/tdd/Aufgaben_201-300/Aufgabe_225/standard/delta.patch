+func kevsFromResponse(response kevulndb.Response) []models.KEV {
+	var kevs []models.KEV
+	for _, entry := range response.CISA {
+		var dueDate *time.Time
+		if !entry.DueDate.IsZero() {
+			dueDate = &entry.DueDate
+		}
+		kevs = append(kevs, models.KEV{
+			Type: models.CISAKEVType, VendorProject: entry.VendorProject,
+			Product: entry.Product, VulnerabilityName: entry.VulnerabilityName,
+			ShortDescription: entry.ShortDescription, RequiredAction: entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  entry.DateAdded, DueDate: dueDate,
+			CISA: &models.CISAKEV{Note: entry.Notes},
+		})
+	}
+	for _, entry := range response.VulnCheck {
+		var dueDate *time.Time
+		if entry.DueDate != nil && !entry.DueDate.IsZero() {
+			dueDate = entry.DueDate
+		}
+		details := &models.VulnCheckKEV{}
+		for _, xdb := range entry.VulnCheckXDB {
+			details.XDB = append(details.XDB, models.VulnCheckXDB{
+				XDBID: xdb.XDBID, XDBURL: xdb.XDBURL, DateAdded: xdb.DateAdded,
+				ExploitType: xdb.ExploitType, CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, exploitation := range entry.VulnCheckReportedExploitation {
+			details.ReportedExploitation = append(details.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL: exploitation.URL, DateAdded: exploitation.DateAdded,
+			})
+		}
+		kevs = append(kevs, models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: entry.VendorProject,
+			Product: entry.Product, VulnerabilityName: entry.Name,
+			ShortDescription: entry.Description, RequiredAction: entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  entry.DateAdded, DueDate: dueDate, VulnCheck: details,
+		})
+	}
+	return kevs
+}
+
 type kevulnResponse struct {
 	request kevulnRequest
 	json    string
diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..e201df5
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,42 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+// Omitting either source, its details, or invalid date normalization breaks this test.
+func TestKEVsFromResponseMapsBothSources(t *testing.T) {
+	added := time.Date(2024, 8, 30, 0, 0, 0, 0, time.UTC)
+	zero := time.Time{}
+	response := kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", Product: "CISA product", VulnerabilityName: "CISA name", ShortDescription: "CISA description", RequiredAction: "patch", KnownRansomwareCampaignUse: "Known", DateAdded: added, DueDate: zero, Notes: "CISA note"}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "VC vendor", Product: "VC product", Name: "VC name", Description: "VC description", RequiredAction: "mitigate", KnownRansomwareCampaignUse: "Unknown", DateAdded: added, DueDate: &added,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "123", XDBURL: "https://xdb", DateAdded: added, ExploitType: "poc", CloneSSHURL: "ssh://clone"}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://report", DateAdded: added}},
+		}},
+	}
+	got := kevsFromResponse(response)
+	if len(got) != 2 {
+		t.Fatalf("got %d KEVs, want 2", len(got))
+	}
+	if got[0].Type != models.CISAKEVType || got[0].VendorProject != "CISA vendor" || got[0].Product != "CISA product" || got[0].VulnerabilityName != "CISA name" || got[0].ShortDescription != "CISA description" || got[0].RequiredAction != "patch" || got[0].KnownRansomwareCampaignUse != "Known" || !got[0].DateAdded.Equal(added) || got[0].DueDate != nil || got[0].CISA == nil || got[0].CISA.Note != "CISA note" {
+		t.Fatalf("CISA mapping: %+v", got[0])
+	}
+	vc := got[1]
+	if vc.Type != models.VulnCheckKEVType || vc.VendorProject != "VC vendor" || vc.Product != "VC product" || vc.VulnerabilityName != "VC name" || vc.ShortDescription != "VC description" || vc.RequiredAction != "mitigate" || vc.KnownRansomwareCampaignUse != "Unknown" || !vc.DateAdded.Equal(added) || vc.DueDate == nil || !vc.DueDate.Equal(added) || vc.VulnCheck == nil {
+		t.Fatalf("VulnCheck mapping: %+v", vc)
+	}
+	if len(vc.VulnCheck.XDB) != 1 || vc.VulnCheck.XDB[0].XDBID != "123" || vc.VulnCheck.XDB[0].XDBURL != "https://xdb" || !vc.VulnCheck.XDB[0].DateAdded.Equal(added) || vc.VulnCheck.XDB[0].ExploitType != "poc" || vc.VulnCheck.XDB[0].CloneSSHURL != "ssh://clone" {
+		t.Fatalf("XDB mapping: %+v", vc.VulnCheck.XDB)
+	}
+	if len(vc.VulnCheck.ReportedExploitation) != 1 || vc.VulnCheck.ReportedExploitation[0].URL != "https://report" || !vc.VulnCheck.ReportedExploitation[0].DateAdded.Equal(added) {
+		t.Fatalf("reported exploitation mapping: %+v", vc.VulnCheck.ReportedExploitation)
+	}
+}
