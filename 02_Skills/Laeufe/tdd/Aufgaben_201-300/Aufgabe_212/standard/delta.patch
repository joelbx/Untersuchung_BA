@@ -6,10 +6,62 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosPreservesWPScanFields(t *testing.T) {
+	// A regression in CVE selection, reference ordering, or Enterprise field
+	// mapping changes the resulting vulnerability content.
+	base := `"id":"42","title":"Issue title","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-03:00","vuln_type":"SQLi","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/second","https://example.org/first"]}`
+	tests := []struct {
+		name, extra, summary, fixed string
+		optional                    map[string]string
+		score                       float64
+		vector, severity            string
+	}{
+		{"enterprise", `,"fixed_in":"6.4.3","description":"Detailed summary","poc":"https://example.org/poc","introduced_in":"6.1","cvss":{"score":8.1,"vector":"CVSS:3.1/AV:N","severity":"high"}`, "Detailed summary", "6.4.3", map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.1"}, 8.1, "CVSS:3.1/AV:N", "high"},
+		{"basic", "", "", "", map[string]string{}, 0, "", ""},
+		{"null enterprise fields", `,"fixed_in":null,"description":null,"poc":null,"introduced_in":null,"cvss":null`, "", "", map[string]string{}, 0, "", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"643":{"vulnerabilities":[{` + base + tt.extra + `}]}}`
+			got, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got) != 1 {
+				t.Fatalf("want one record for first CVE, got %d: %+v", len(got), got)
+			}
+			v := got[0]
+			if v.CveID != "CVE-2024-1234" || v.VulnType != "SQLi" {
+				t.Errorf("identity/classification: %#v", v)
+			}
+			if len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0] != (models.WpPackageFixStatus{Name: "core", FixedIn: tt.fixed}) {
+				t.Errorf("fix: %#v", v.WpPackageFixStats)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("want one WPScan content, got %#v", contents)
+			}
+			c := contents[0]
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 7, 5, 6, 0, time.UTC)
+			if c.Type != models.WpScan || c.CveID != "CVE-2024-1234" || c.Title != "Issue title" || !c.Published.Equal(published) || !c.LastModified.Equal(modified) || c.Published.Location() != time.UTC || c.LastModified.Location() != time.UTC {
+				t.Errorf("content identity/times: %#v", c)
+			}
+			if !reflect.DeepEqual(c.References, models.References{{Link: "https://example.org/second"}, {Link: "https://example.org/first"}}) {
+				t.Errorf("references: %#v", c.References)
+			}
+			if c.Summary != tt.summary || !reflect.DeepEqual(c.Optional, tt.optional) || c.Cvss3Score != tt.score || c.Cvss3Vector != tt.vector || c.Cvss3Severity != tt.severity {
+				t.Errorf("Enterprise fields: %#v", c)
+			}
+		})
+	}
+}
