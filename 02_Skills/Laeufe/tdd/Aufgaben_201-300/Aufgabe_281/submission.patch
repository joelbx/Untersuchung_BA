+	const normalizeBulkIncrements = require('../increment-bulk');
 
 	const cache = require('../cache').create('mongo');
 
@@ -261,4 +262,28 @@ module.exports = function (module) {
 			throw err;
 		}
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const entries = normalizeBulkIncrements(data, helpers.fieldToString)
+			.filter(([, increments]) => Object.keys(increments).length);
+		if (!entries.length) {
+			return;
+		}
+		const operations = entries.map(([key, increments]) => ({
+			updateOne: { filter: { _key: key }, update: { $inc: increments }, upsert: true },
+		}));
+		try {
+			await module.client.collection('objects').bulkWrite(operations, { ordered: false });
+			cache.del(entries.map(([key]) => key));
+		} catch (err) {
+			if (Array.isArray(err.writeErrors)) {
+				const failed = new Set(err.writeErrors.map(error => error.index));
+				const succeeded = entries.filter((_, index) => !failed.has(index)).map(([key]) => key);
+				if (succeeded.length) {
+					cache.del(succeeded);
+				}
+			}
+			throw err;
+		}
+	};
 };
