index 0000000..cc8adb4
--- /dev/null
+++ b/src/database/increment-bulk.js
@@ -0,0 +1,31 @@
+'use strict';
+
+module.exports = function normalizeBulkIncrements(data, fieldToString) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const grouped = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			!([Object.prototype, null].includes(Object.getPrototypeOf(item[1])))) {
+			throw new TypeError('Bulk increments must contain [key, increments] tuples');
+		}
+		const increments = grouped.get(item[0]) || Object.create(null);
+		for (const [rawField, value] of Object.entries(item[1])) {
+			const field = fieldToString(rawField);
+			if (!field || ['__proto__', 'constructor', 'prototype'].includes(rawField) || /[.$]/.test(rawField) ||
+				['__proto__', 'constructor', 'prototype'].includes(field) || /[.$]/.test(field) ||
+				!Number.isSafeInteger(value)) {
+				throw new TypeError('Bulk increment fields must be safe integer values with safe field names');
+			}
+			const total = (increments[field] || 0) + value;
+			if (!Number.isSafeInteger(total)) {
+				throw new RangeError('Combined bulk increment is not a safe integer');
+			}
+			increments[field] = total;
+		}
+		grouped.set(item[0], increments);
+	});
+	return Array.from(grouped);
+};
