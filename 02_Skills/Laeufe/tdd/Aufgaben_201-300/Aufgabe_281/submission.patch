@@ -657,4 +657,68 @@ describe('Hash methods', () => {
 			});
 		});
 	});
+
+	describe('incrObjectFieldByBulk()', () => {
+		it('rejects dotted field names before Mongo normalization can hide them', () => {
+			const normalize = require('../../src/database/increment-bulk');
+			const mongoHelpers = require('../../src/database/mongo/helpers');
+			assert.throws(() => normalize([['key', { 'bad.name': 1 }]], mongoHelpers.fieldToString));
+		});
+
+		it('increments multiple fields across existing and missing objects and returns no data', async () => {
+			await db.setObject('bulkIncrementExisting', { age: 7 });
+			await db.getObject('bulkIncrementExisting');
+			const result = await db.incrObjectFieldByBulk([
+				['bulkIncrementExisting', { age: 5, newField: 10 }],
+				['bulkIncrementMissing', { age: -2, newField: 3 }],
+			]);
+			assert.strictEqual(result, undefined);
+			const existing = await db.getObjectFields('bulkIncrementExisting', ['age', 'newField']);
+			const missing = await db.getObjectFields('bulkIncrementMissing', ['age', 'newField']);
+			assert.deepStrictEqual([String(existing.age), String(existing.newField)], ['12', '10']);
+			assert.deepStrictEqual([String(missing.age), String(missing.newField)], ['-2', '3']);
+		});
+
+		it('rejects malformed input and unsafe increments without writing', async () => {
+			await assert.rejects(db.incrObjectFieldByBulk({ key: { count: 1 } }));
+			await assert.rejects(db.incrObjectFieldByBulk([['bulkIncrementInvalid', { count: 1.5 }]]));
+			await assert.rejects(db.incrObjectFieldByBulk([['bulkIncrementInvalid', { ['__proto__']: 1 }]]));
+			assert.strictEqual(await db.getObject('bulkIncrementInvalid'), null);
+		});
+
+		it('leaves all fields of a bad object unchanged while updating other objects', async () => {
+			await db.setObject('bulkIncrementBad', { good: 2, bad: 'text' });
+			await db.getObject('bulkIncrementBad');
+			await assert.rejects(db.incrObjectFieldByBulk([
+				['bulkIncrementBad', { good: 4, bad: 1 }],
+				['bulkIncrementGood', { count: 3 }],
+			]));
+			const bad = await db.getObjectFields('bulkIncrementBad', ['good', 'bad']);
+			assert.deepStrictEqual([String(bad.good), bad.bad], ['2', 'text']);
+			assert.strictEqual(String(await db.getObjectField('bulkIncrementGood', 'count')), '3');
+		});
+
+		it('treats repeated tuples for one key as one atomic update', async () => {
+			await db.setObject('bulkIncrementRepeated', { good: 2, bad: 'text' });
+			await assert.rejects(db.incrObjectFieldByBulk([
+				['bulkIncrementRepeated', { good: 4 }],
+				['bulkIncrementRepeated', { bad: 1 }],
+			]));
+			assert.strictEqual(String(await db.getObjectField('bulkIncrementRepeated', 'good')), '2');
+		});
+
+		it('does not contact the backend or cache for an empty array', async () => {
+			const backendMethod = db.client.pipeline ? 'pipeline' : 'collection';
+			const originalBackend = db.client[backendMethod];
+			const originalDelete = db.objectCache.del;
+			try {
+				db.client[backendMethod] = () => { throw new Error('backend called'); };
+				db.objectCache.del = () => { throw new Error('cache called'); };
+				assert.strictEqual(await db.incrObjectFieldByBulk([]), undefined);
+			} finally {
+				db.client[backendMethod] = originalBackend;
+				db.objectCache.del = originalDelete;
+			}
+		});
+	});
 });
