@@ -219,4 +220,41 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const entries = normalizeBulkIncrements(data, String).filter(([, increments]) => Object.keys(increments).length);
+		if (!entries.length) {
+			return;
+		}
+		const script = `
+			for i = 1, #ARGV, 2 do
+				local current = redis.call('HGET', KEYS[1], ARGV[i])
+				if current then
+					if not string.match(current, '^%-?%d+$') or not tonumber(current) or
+						math.abs(tonumber(current)) > 9007199254740991 or
+						math.abs(tonumber(current) + tonumber(ARGV[i + 1])) > 9007199254740991 then
+						return redis.error_reply('field is not a safe integer: ' .. ARGV[i])
+					end
+				end
+			end
+			for i = 1, #ARGV, 2 do
+				redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+			end
+			return 1
+		`;
+		const batch = module.client.pipeline();
+		entries.forEach(([key, increments]) => {
+			const args = Object.entries(increments).flatMap(([field, value]) => [field, String(value)]);
+			batch.eval(script, 1, key, ...args);
+		});
+		const results = await batch.exec();
+		const succeeded = entries.filter((_, index) => !results[index][0]).map(([key]) => key);
+		if (succeeded.length) {
+			cache.del(succeeded);
+		}
+		const failed = results.find(([err]) => err);
+		if (failed) {
+			throw failed[0];
+		}
+	};
 };
diff --git a/test/database/hash-bulk-mongo.js b/test/database/hash-bulk-mongo.js
new file mode 100644
index 0000000..9f4ae39
--- /dev/null
+++ b/test/database/hash-bulk-mongo.js
@@ -0,0 +1,24 @@
+'use strict';
+
+const assert = require('assert');
+const attachMongoHash = require('../../src/database/mongo/hash');
+
+describe('Mongo bulk hash increments', () => {
+	it('leaves cache untouched when every object update fails', async () => {
+		const failure = new Error('field is not numeric');
+		failure.writeErrors = [{ index: 0 }];
+		const db = {
+			client: { collection: () => ({ bulkWrite: async () => { throw failure; } }) },
+		};
+		attachMongoHash(db);
+		const originalDelete = db.objectCache.del;
+		let deleteCalls = 0;
+		try {
+			db.objectCache.del = () => { deleteCalls += 1; };
+			await assert.rejects(db.incrObjectFieldByBulk([['bad', { value: 1 }]]), failure);
+			assert.strictEqual(deleteCalls, 0);
+		} finally {
+			db.objectCache.del = originalDelete;
+		}
+	});
+});
diff --git a/test/database/hash.js b/test/database/hash.js
