+// TestInstanceMetadataAvailability rejects successful responses that are not EC2 instance IDs.
+func TestInstanceMetadataAvailability(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		want bool
+	}{
+		{name: "short instance ID", body: "i-1a2b3c4d", want: true},
+		{name: "long instance ID", body: "i-1234567890abcdef0", want: true},
+		{name: "captive portal", body: "<!DOCTYPE html><html>Login</html>", want: false},
+		{name: "incorrect length", body: "i-123456789", want: false},
+		{name: "uppercase hex", body: "i-1234567A", want: false},
+		{name: "trailing newline", body: "i-12345678\n", want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch r.URL.Path {
+				case "/latest/api/token":
+					_, _ = io.WriteString(w, "token")
+				case "/latest/meta-data/instance-id":
+					_, _ = io.WriteString(w, tt.body)
+				default:
+					http.NotFound(w, r)
+				}
+			}))
+			defer server.Close()
+			client := &InstanceMetadataClient{c: imds.New(imds.Options{Endpoint: server.URL})}
+			assert.Equal(t, tt.want, client.IsAvailable(context.Background()))
+		})
+	}
+}
+
+func TestNewInstanceMetadataClientAppliesOptions(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/latest/api/token":
+			_, _ = io.WriteString(w, "token")
+		case "/latest/meta-data/instance-id":
+			_, _ = io.WriteString(w, "i-12345678")
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+	client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(imds.New(imds.Options{Endpoint: server.URL})))
+	assert.NoError(t, err)
+	if err == nil {
+		assert.True(t, client.IsAvailable(context.Background()))
+	}
+}
+
+func TestNewInstanceMetadataClientReturnsOptionError(t *testing.T) {
+	want := errors.New("option failed")
+	_, err := NewInstanceMetadataClient(context.Background(), func(*InstanceMetadataClient) error { return want })
+	assert.ErrorIs(t, err, want)
+}
