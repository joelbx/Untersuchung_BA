+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User properties repository", func() {
+	It("uses the explicit user ID for reads, updates and deletes", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
+		Expect(repo.Put("first", "isolation-key", "first-value")).To(Succeed())
+		Expect(repo.Put("second", "isolation-key", "second-value")).To(Succeed())
+		Expect(repo.Get("first", "isolation-key")).To(Equal("first-value"))
+		Expect(repo.Get("second", "isolation-key")).To(Equal("second-value"))
+		Expect(repo.Put("first", "isolation-key", "updated")).To(Succeed())
+		Expect(repo.Get("first", "isolation-key")).To(Equal("updated"))
+		Expect(repo.DefaultGet("third", "isolation-key", "fallback")).To(Equal("fallback"))
+		Expect(repo.Delete("first", "isolation-key")).To(Succeed())
+		_, err := repo.Get("first", "isolation-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(repo.Get("second", "isolation-key")).To(Equal("second-value"))
+	})
+})
