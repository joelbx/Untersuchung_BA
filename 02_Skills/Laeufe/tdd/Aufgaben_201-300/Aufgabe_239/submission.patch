+func (s *Router) callbackState(userId string) string {
+	payload := userId + ":" + strconv.FormatInt(time.Now().Add(10*time.Minute).Unix(), 10)
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(payload))
+	return base64.RawURLEncoding.EncodeToString([]byte(payload)) + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
+
+func (s *Router) userFromCallbackState(state string) (string, bool) {
+	parts := strings.Split(state, ".")
+	if len(parts) != 2 {
+		return "", false
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", false
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", false
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write(payload)
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", false
+	}
+	fields := strings.SplitN(string(payload), ":", 2)
+	if len(fields) != 2 || fields[0] == "" {
+		return "", false
+	}
+	expires, err := strconv.ParseInt(fields[1], 10, 64)
+	return fields[0], err == nil && time.Now().Unix() <= expires
+}
