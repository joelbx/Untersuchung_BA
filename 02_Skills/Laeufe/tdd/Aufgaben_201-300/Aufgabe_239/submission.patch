diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..3f9eaa6
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,100 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestCallbackRejectsUnverifiedUserID(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	router := NewRouter(ds)
+	fake := &tests.FakeHttpClient{Res: http.Response{StatusCode: 200, Body: ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"foreign-key"}}`))}}
+	router.client = NewClient("key", "secret", "en", fake)
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/link/callback?uid=victim&token=valid", nil))
+
+	if recorder.Code != http.StatusBadRequest {
+		t.Fatalf("callback status = %d, want 400", recorder.Code)
+	}
+	if _, err := ds.UserProps(context.Background()).Get("victim", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("victim property error = %v, want not found", err)
+	}
+}
+
+func TestLinkStatusAndUnlinkUseAuthenticatedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	props := ds.UserProps(context.Background())
+	if err := props.Put("owner", sessionKeyProperty, "owner-key"); err != nil {
+		t.Fatal(err)
+	}
+	if err := props.Put("other", sessionKeyProperty, "other-key"); err != nil {
+		t.Fatal(err)
+	}
+	router := NewRouter(ds)
+	ctx := request.WithUser(context.Background(), model.User{ID: "owner"})
+	statusRequest := httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx)
+	status := httptest.NewRecorder()
+	router.getLinkStatus(status, statusRequest)
+	if status.Code != http.StatusOK || !bytes.Contains(status.Body.Bytes(), []byte(`"status":true`)) {
+		t.Fatalf("owner status = %d %s", status.Code, status.Body.String())
+	}
+	unlink := httptest.NewRecorder()
+	router.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+	if unlink.Code != http.StatusOK {
+		t.Fatalf("unlink status = %d", unlink.Code)
+	}
+	if _, err := props.Get("owner", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("owner key error = %v", err)
+	}
+	if key, err := props.Get("other", sessionKeyProperty); err != nil || key != "other-key" {
+		t.Fatalf("other key = %q, %v", key, err)
+	}
+}
+
+func TestCallbackStoresSessionForSignedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	router := NewRouter(ds)
+	fake := &tests.FakeHttpClient{Res: http.Response{StatusCode: 200, Body: ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"own-key"}}`))}}
+	router.client = NewClient("key", "secret", "en", fake)
+	state := router.callbackState("owner")
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/link/callback?state="+state+"&token=valid", nil))
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("callback status = %d, want 200", recorder.Code)
+	}
+	key, err := ds.UserProps(context.Background()).Get("owner", sessionKeyProperty)
+	if err != nil || key != "own-key" {
+		t.Fatalf("owner session = %q, %v", key, err)
+	}
+}
+
+func TestCallbackRejectsChangedStateUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	router := NewRouter(ds)
+	state := router.callbackState("owner")
+	parts := strings.Split(state, ".")
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	parts[0] = base64.RawURLEncoding.EncodeToString(bytes.Replace(payload, []byte("owner"), []byte("other"), 1))
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/link/callback?state="+strings.Join(parts, ".")+"&token=valid", nil))
+	if recorder.Code != http.StatusBadRequest {
+		t.Fatalf("changed state status = %d, want 400", recorder.Code)
+	}
+	if _, err := ds.UserProps(context.Background()).Get("other", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("other property error = %v, want not found", err)
+	}
+}
