 from itertools import chain
 import pytest
+from ansible.module_utils.common.validation import safe_eval
+from ansible.module_utils.common import warnings
 
 
 # Strings that should be converted into a typed value
@@ -33,6 +35,24 @@ INVALID_STRINGS = (
 )
 
 
+def test_safe_eval_reports_deprecation(monkeypatch):
+    monkeypatch.setattr(warnings, '_global_deprecations', [])
+    assert safe_eval('1') == 1
+    assert warnings.get_deprecation_messages() == ({
+        'msg': 'ansible.module_utils.common.validation.safe_eval is deprecated and no longer in use.',
+        'version': '2.21',
+        'collection_name': None,
+    },)
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=True)
+def test_module_safe_eval_reports_deprecation(am, monkeypatch):
+    monkeypatch.setattr(warnings, '_global_deprecations', [])
+    assert am.safe_eval('1') == 1
+    assert len(warnings.get_deprecation_messages()) == 1
+    assert warnings.get_deprecation_messages()[0]['version'] == '2.21'
+
+
 @pytest.mark.parametrize('code, expected, stdin',
