diff --git a/test/units/executor/module_common/test_modify_module.py b/test/units/executor/module_common/test_modify_module.py
index dceef76..788cdb6 100644
--- a/test/units/executor/module_common/test_modify_module.py
+++ b/test/units/executor/module_common/test_modify_module.py
@@ -41,3 +41,52 @@ def test_shebang_task_vars(fake_old_module_open, templar):
 
     (data, style, shebang) = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
     assert shebang == '#!/usr/bin/python3'
+
+
+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/opt/venv/bin/python3.8 -I\nimport ansible.module_utils.basic\n', {}, b'#!/opt/venv/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python3.8 -I\nimport ansible.module_utils.basic\n',
+     {'ansible_python_interpreter': '/usr/bin/python3'}, b'#!/usr/bin/python3 -I'),
+    (b'import ansible.module_utils.basic\n', {}, b'#!/usr/bin/python'),
+])
+def test_new_style_python_wrapper_uses_module_shebang(tmp_path, templar, source, task_vars, expected):
+    module = tmp_path / 'shebang_module.py'
+    module.write_bytes(source)
+    data, style, shebang = modify_module('shebang_module', str(module), {}, templar, task_vars=task_vars)
+    assert style == 'new'
+    assert data.splitlines()[0] == expected
+    assert data.splitlines()[1] == b'# -*- coding: utf-8 -*-'
+    assert shebang == expected.decode()
+
+
+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/usr/bin/ruby -w\nputs 1\n', {}, b'#!/usr/bin/ruby -w'),
+    (b'#!/usr/bin/ruby -w\nputs 1\n', {'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'}, b'#!/opt/ruby/bin/ruby -w'),
+    (b'print(1)\n', {}, b'#!/usr/bin/python'),
+])
+def test_old_style_module_resolves_shebang(tmp_path, templar, source, task_vars, expected):
+    module = tmp_path / 'plain_module'
+    module.write_bytes(source)
+    data, style, shebang = modify_module('plain_module', str(module), {}, templar, task_vars=task_vars)
+    assert style == 'old'
+    assert data.splitlines()[0] == expected
+    assert data.splitlines()[1] == b'# -*- coding: utf-8 -*-'
+    assert shebang == expected.decode()
+
+
+def test_old_style_override_keeps_original_argument_text(tmp_path, templar):
+    module = tmp_path / 'quoted_module'
+    module.write_bytes(b'#!/usr/bin/ruby "a b" -w\nputs 1\n')
+    data, _, shebang = modify_module('quoted_module', str(module), {}, templar,
+                                     task_vars={'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'})
+    assert data.splitlines()[0] == b'#!/opt/ruby/bin/ruby "a b" -w'
+    assert shebang == '#!/opt/ruby/bin/ruby "a b" -w'
+
+
+def test_override_preserves_shebang_spacing_and_arguments(tmp_path, templar):
+    module = tmp_path / 'spaced_module'
+    module.write_bytes(b'#!  /usr/bin/ruby  -w\nputs 1\n')
+    data, _, shebang = modify_module('spaced_module', str(module), {}, templar,
+                                     task_vars={'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'})
+    assert data.splitlines()[0] == b'#!/opt/ruby/bin/ruby  -w'
+    assert shebang == '#!/opt/ruby/bin/ruby  -w'
