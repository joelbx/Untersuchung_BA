+def test_prioritized_identifier_serializes_isbn_and_asin_with_import_flag() -> None:
+    for identifier, stage_import in (("9780747532699", True), ("B06XYHVXVJ", False)):
+        item = affiliate_server.PrioritizedIdentifier(
+            identifier=identifier,
+            stage_import=stage_import,
+            priority=Priority.HIGH,
+            timestamp=datetime(2024, 1, 2, 3, 4, 5),
+        )
+        assert json.loads(json.dumps(item.to_dict())) == {
+            "identifier": identifier,
+            "stage_import": stage_import,
+            "priority": "HIGH",
+            "timestamp": "2024-01-02T03:04:05",
+        }
+
+
+def test_prioritized_identifier_deduplicates_by_identifier_only() -> None:
+    first = affiliate_server.PrioritizedIdentifier(
+        "B06XYHVXVJ", priority=Priority.HIGH, timestamp=datetime(2024, 1, 1)
+    )
+    duplicate = affiliate_server.PrioritizedIdentifier(
+        "B06XYHVXVJ", stage_import=False, timestamp=datetime(2025, 1, 1)
+    )
+    other = affiliate_server.PrioritizedIdentifier("9780747532699")
+    assert len({first, duplicate, other}) == 2
+    assert first == duplicate
+    assert first != other
+
+
+def test_prioritized_identifier_orders_queue_by_priority_then_timestamp() -> None:
+    earlier = affiliate_server.PrioritizedIdentifier(
+        "B06XYHVXVJ", priority=Priority.LOW, timestamp=datetime(2024, 1, 1)
+    )
+    later = affiliate_server.PrioritizedIdentifier(
+        "9780747532699", priority=Priority.LOW, timestamp=datetime(2024, 1, 2)
+    )
+    high = affiliate_server.PrioritizedIdentifier(
+        "B012346789", priority=Priority.HIGH, timestamp=datetime(2024, 1, 3)
+    )
+    assert sorted([later, earlier, high]) == [high, earlier, later]
+
+
