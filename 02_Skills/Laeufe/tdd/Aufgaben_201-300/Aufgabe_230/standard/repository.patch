+    monkeypatch.setattr(affiliate_server.cache, "memcache_cache", memcache)
+    monkeypatch.setattr(affiliate_server.stats, "increment", lambda *args, **kwargs: None)
+    monkeypatch.setattr(affiliate_server.config, "infobase", {"db_parameters": "test"}, raising=False)
+    monkeypatch.setattr(affiliate_server, "get_current_amazon_batch", lambda: batch)
+    monkeypatch.setattr(
+        affiliate_server,
+        "clean_amazon_metadata_for_load",
