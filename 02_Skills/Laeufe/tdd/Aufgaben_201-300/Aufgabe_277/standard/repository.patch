@@ -0,0 +1,81 @@
+package audit
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestNewRuleSegmentAudit(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		rule        *flipt.Rule
+		key         string
+		operator    string
+		hasOperator bool
+	}{
+		{
+			name: "one segment",
+			rule: &flipt.Rule{SegmentKeys: []string{"north"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR},
+			key:  "north",
+		},
+		{
+			name: "multiple segments",
+			rule: &flipt.Rule{SegmentKeys: []string{"north", "south"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR},
+			key:  "north,south", operator: "AND_SEGMENT_OPERATOR", hasOperator: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			encoded, err := json.Marshal(NewRule(tc.rule))
+			require.NoError(t, err)
+			var payload map[string]any
+			require.NoError(t, json.Unmarshal(encoded, &payload))
+			require.Equal(t, tc.key, payload["segment_key"])
+			operator, present := payload["segment_operator"]
+			require.Equal(t, tc.hasOperator, present)
+			if tc.hasOperator {
+				require.Equal(t, tc.operator, operator)
+			}
+		})
+	}
+}
+
+func TestNewRolloutSegmentAudit(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		segment     *flipt.RolloutSegment
+		key         string
+		operator    string
+		hasOperator bool
+	}{
+		{
+			name:    "one segment",
+			segment: &flipt.RolloutSegment{SegmentKeys: []string{"north"}, Value: true, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR},
+			key:     "north",
+		},
+		{
+			name:    "multiple segments",
+			segment: &flipt.RolloutSegment{SegmentKeys: []string{"north", "south"}, Value: true, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR},
+			key:     "north,south", operator: "AND_SEGMENT_OPERATOR", hasOperator: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: tc.segment}})
+			encoded, err := json.Marshal(rollout)
+			require.NoError(t, err)
+			var payload struct {
+				Segment map[string]any `json:"segment"`
+			}
+			require.NoError(t, json.Unmarshal(encoded, &payload))
+			require.Equal(t, tc.key, payload.Segment["key"])
+			require.Equal(t, true, payload.Segment["value"])
+			operator, present := payload.Segment["operator"]
+			require.Equal(t, tc.hasOperator, present)
+			if tc.hasOperator {
+				require.Equal(t, tc.operator, operator)
+			}
+		})
+	}
+}
