+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestAddLibraryVulnPreservesBothLockfiles(t *testing.T) {
+	cves := models.VulnInfos{}
+	addLibraryVuln(cves, models.VulnInfo{CveID: "CVE-1", LibraryFixedIns: models.LibraryFixedIns{{Path: "/first/Pipfile.lock", Name: "requests", FixedIn: "3.0"}}})
+	addLibraryVuln(cves, models.VulnInfo{CveID: "CVE-1", LibraryFixedIns: models.LibraryFixedIns{{Path: "/second/Pipfile.lock", Name: "requests", FixedIn: "3.0"}}})
+	got := cves["CVE-1"].LibraryFixedIns
+	if len(got) != 2 || got[0].Path != "/first/Pipfile.lock" || got[1].Path != "/second/Pipfile.lock" {
+		t.Fatalf("duplicate CVE lost a lockfile: %+v", got)
+	}
+}
