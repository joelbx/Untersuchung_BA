diff --git a/scan/library_test.go b/scan/library_test.go
new file mode 100644
index 0000000..bccdbdd
--- /dev/null
+++ b/scan/library_test.go
@@ -0,0 +1,44 @@
+package scan
+
+import (
+	"testing"
+
+	"github.com/aquasecurity/fanal/types"
+	deplib "github.com/aquasecurity/go-dep-parser/pkg/types"
+)
+
+func TestAnalyzeFileSeparatesSameLibraryAcrossLockfiles(t *testing.T) {
+	first, err := AnalyzeFile("/first/Pipfile.lock", &DummyFileInfo{}, []byte(`{"default":{"requests":{"version":"==1.0"}}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := AnalyzeFile("/second/Pipfile.lock", &DummyFileInfo{}, []byte(`{"default":{"requests":{"version":"==2.0"}}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, err := convertLibWithScanner(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := convertLibWithScanner(second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(a) != 1 || len(b) != 1 || a[0].Path != "/first/Pipfile.lock" || b[0].Path != "/second/Pipfile.lock" || a[0].Libs[0].Version != "1.0" || b[0].Libs[0].Version != "2.0" {
+		t.Fatalf("per-file results: %+v %+v", a, b)
+	}
+}
+
+func TestConvertLibWithScannerKeepsFilePaths(t *testing.T) {
+	apps := []types.Application{
+		{FilePath: "/first/Pipfile.lock", Libraries: []types.LibraryInfo{{Library: deplib.Library{Name: "requests", Version: "1.0"}}}},
+		{FilePath: "/second/Pipfile.lock", Libraries: []types.LibraryInfo{{Library: deplib.Library{Name: "requests", Version: "2.0"}}}},
+	}
+	scanners, err := convertLibWithScanner(apps)
+	if err != nil || len(scanners) != 2 {
+		t.Fatalf("got scanners=%v, err=%v", scanners, err)
+	}
+	if scanners[0].Path != "/first/Pipfile.lock" || scanners[0].Libs[0].Version != "1.0" || scanners[1].Path != "/second/Pipfile.lock" || scanners[1].Libs[0].Version != "2.0" {
+		t.Fatalf("lost per-file versions: %+v", scanners)
+	}
+}
