+// AnalyzeFile analyzes one in-memory lockfile. The pinned fanal API exposes
+// GetLibraries instead of AnalyzeFile, so pass it a single-file map.
+func AnalyzeFile(path string, info os.FileInfo, content []byte) ([]types.Application, error) {
+	if info.IsDir() {
+		return nil, nil
+	}
+	return analyzer.GetLibraries(extractor.FileMap{path: content})
+}
