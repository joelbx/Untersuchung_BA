new file mode 100644
index 0000000..b28c8ad
--- /dev/null
+++ b/cmd/flipt/transport.go
@@ -0,0 +1,58 @@
+package main
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"fmt"
+	"io/ioutil"
+	"net"
+	"net/http"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+)
+
+func (s serverConfig) webPort() int {
+	if s.Protocol == HTTPS {
+		return s.HTTPSPort
+	}
+	return s.HTTPPort
+}
+
+func serveWeb(srv *http.Server, lis net.Listener, cfg serverConfig) error {
+	if cfg.Protocol == HTTPS {
+		return srv.ServeTLS(lis, cfg.CertFile, cfg.CertKey)
+	}
+	return srv.Serve(lis)
+}
+
+func grpcTransportOptions(cfg serverConfig) ([]grpc.ServerOption, []grpc.DialOption, error) {
+	if cfg.Protocol != HTTPS {
+		return nil, []grpc.DialOption{grpc.WithInsecure()}, nil
+	}
+	certificate, err := tls.LoadX509KeyPair(cfg.CertFile, cfg.CertKey)
+	if err != nil {
+		return nil, nil, err
+	}
+	certPEM, err := ioutil.ReadFile(cfg.CertFile)
+	if err != nil {
+		return nil, nil, err
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(certPEM) {
+		return nil, nil, fmt.Errorf("cannot parse TLS cert_file at %q", cfg.CertFile)
+	}
+	leaf, err := x509.ParseCertificate(certificate.Certificate[0])
+	if err != nil {
+		return nil, nil, err
+	}
+	serverName := leaf.Subject.CommonName
+	if len(leaf.DNSNames) > 0 {
+		serverName = leaf.DNSNames[0]
+	} else if len(leaf.IPAddresses) > 0 {
+		serverName = leaf.IPAddresses[0].String()
+	}
+	serverOpts := []grpc.ServerOption{grpc.Creds(credentials.NewTLS(&tls.Config{Certificates: []tls.Certificate{certificate}, MinVersion: tls.VersionTLS12}))}
+	dialOpts := []grpc.DialOption{grpc.WithTransportCredentials(credentials.NewTLS(&tls.Config{RootCAs: roots, ServerName: serverName, MinVersion: tls.VersionTLS12}))}
+	return serverOpts, dialOpts, nil
+}
