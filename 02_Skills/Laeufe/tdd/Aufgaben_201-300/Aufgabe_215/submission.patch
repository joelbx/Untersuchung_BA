new file mode 100644
index 0000000..9fa066a
--- /dev/null
+++ b/cmd/flipt/transport_test.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"crypto/tls"
+	"net"
+	"net/http"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc"
+)
+
+func tlsServerConfig() serverConfig {
+	return serverConfig{Host: "127.0.0.1", Protocol: HTTPS, HTTPPort: 8080, HTTPSPort: 443, GRPCPort: 9000, CertFile: filepath.Join("testdata", "config", "ssl_cert.pem"), CertKey: filepath.Join("testdata", "config", "ssl_key.pem")}
+}
+
+func TestHTTPSListenerServesTLS(t *testing.T) {
+	cfg := tlsServerConfig()
+	if got := cfg.webPort(); got != 443 {
+		t.Fatalf("HTTPS port = %d", got)
+	}
+	cfg.Protocol = HTTP
+	if got := cfg.webPort(); got != 8080 {
+		t.Fatalf("HTTP port = %d", got)
+	}
+	cfg.Protocol = HTTPS
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lis.Close()
+	srv := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("secure")) })}
+	defer srv.Close()
+	done := make(chan error, 1)
+	go func() { done <- serveWeb(srv, lis, cfg) }()
+	client := &http.Client{Transport: &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}, Timeout: 2 * time.Second}
+	resp, err := client.Get("https://" + lis.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 || resp.TLS == nil {
+		t.Fatalf("status %d, TLS %v", resp.StatusCode, resp.TLS)
+	}
+	srv.Close()
+	if err := <-done; err != nil && err != http.ErrServerClosed {
+		t.Fatal(err)
+	}
+}
+
+func TestGRPCTransportUsesTLS(t *testing.T) {
+	cfg := tlsServerConfig()
+	serverOpts, dialOpts, err := grpcTransportOptions(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := grpc.NewServer(serverOpts...)
+	go srv.Serve(lis)
+	defer srv.Stop()
+	defer lis.Close()
+	dialOpts = append(dialOpts, grpc.WithBlock(), grpc.WithTimeout(2*time.Second))
+	conn, err := grpc.Dial(lis.Addr().String(), dialOpts...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+}
