diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..708bb91
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,151 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, body string) string {
+	t.Helper()
+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	t.Cleanup(func() { os.Remove(f.Name()) })
+	if _, err := f.WriteString(body); err != nil {
+		t.Fatal(err)
+	}
+	return f.Name()
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	path := writeConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  http_port: 8081\n  grpc_port: 9001\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server.Host != "127.0.0.1" || cfg.Server.HTTPPort != 8081 || cfg.Server.GRPCPort != 9001 || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("unexpected config: %+v", cfg)
+	}
+	if cfg.Server.Protocol != HTTP || cfg.Server.HTTPSPort != 443 {
+		t.Fatalf("unexpected protocol defaults: %+v", cfg.Server)
+	}
+}
+
+func TestConfigureHTTPSAndEnvironmentOverride(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	if err := ioutil.WriteFile(cert, []byte("cert"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(key, []byte("key"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	path := writeConfig(t, "server:\n  protocol: https\n  https_port: 8080\n  cert_file: "+cert+"\n  cert_key: "+key+"\n")
+	os.Setenv("FLIPT_SERVER_HTTP_PORT", "8081")
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.Protocol != HTTPS || cfg.Server.Protocol.String() != "https" || HTTP.String() != "http" || cfg.Server.HTTPPort != 8081 || cfg.Server.HTTPSPort != 8080 || cfg.Server.CertFile != cert || cfg.Server.CertKey != key {
+		t.Fatalf("unexpected HTTPS config: %+v", cfg.Server)
+	}
+}
+
+func TestValidateHTTPSCredentials(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	if err := ioutil.WriteFile(cert, []byte("cert"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(key, []byte("key"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct{ name, cert, key, want string }{
+		{"missing cert", "", "", "cert_file cannot be empty when using HTTPS"},
+		{"missing key", cert, "", "cert_key cannot be empty when using HTTPS"},
+		{"missing cert file", filepath.Join(dir, "missing.pem"), key, "cannot find TLS cert_file at \"" + filepath.Join(dir, "missing.pem") + "\""},
+		{"missing key file", cert, filepath.Join(dir, "missing.pem"), "cannot find TLS cert_key at \"" + filepath.Join(dir, "missing.pem") + "\""},
+		{"valid", cert, key, ""},
+	}
+	for _, tt := range cases {
+		t.Run(tt.name, func(t *testing.T) {
+			c := defaultConfig()
+			c.Server.Protocol = HTTPS
+			c.Server.CertFile = tt.cert
+			c.Server.CertKey = tt.key
+			err := c.validate()
+			if tt.want == "" {
+				if err != nil {
+					t.Fatal(err)
+				}
+				return
+			}
+			if err == nil || err.Error() != tt.want {
+				t.Fatalf("got %v, want %q", err, tt.want)
+			}
+		})
+	}
+	c := defaultConfig()
+	c.Server.CertFile = "missing"
+	if err := c.validate(); err != nil {
+		t.Fatalf("HTTP rejected TLS fields: %v", err)
+	}
+}
+
+func TestConfigureReturnsValidationError(t *testing.T) {
+	path := writeConfig(t, "server:\n  protocol: https\n")
+	_, err := configure(path)
+	if err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestConfigureCORSOriginsList(t *testing.T) {
+	path := writeConfig(t, "cors:\n  allowed_origins:\n    - foo.com\n")
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("allowed origins = %v", cfg.Cors.AllowedOrigins)
+	}
+}
+
+func TestConfigurationHandlersRespondWithJSON(t *testing.T) {
+	c := defaultConfig()
+	for _, h := range []struct {
+		name  string
+		serve func(*httptest.ResponseRecorder)
+	}{
+		{"config", func(w *httptest.ResponseRecorder) { c.ServeHTTP(w, httptest.NewRequest("GET", "/meta/config", nil)) }},
+		{"info", func(w *httptest.ResponseRecorder) {
+			(info{Version: "test"}).ServeHTTP(w, httptest.NewRequest("GET", "/meta/info", nil))
+		}},
+	} {
+		t.Run(h.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			h.serve(w)
+			if w.Code != 200 || !strings.HasPrefix(w.Body.String(), "{") {
+				t.Fatalf("status %d body %q", w.Code, w.Body.String())
+			}
+		})
+	}
+}
