new file mode 100644
index 0000000..ef21170
--- /dev/null
+++ b/log/redact_proxy_test.go
@@ -0,0 +1,41 @@
+package log
+
+import (
+	"github.com/sirupsen/logrus"
+	"testing"
+)
+
+func TestRedactsNestedMapValuesWithoutChangingKeys(t *testing.T) {
+	hook := &Hook{RedactionList: []string{`(token=)[^ ]+`}}
+	entry := &logrus.Entry{Data: logrus.Fields{"config": map[string]interface{}{"nested": map[string]interface{}{"auth": "token=secret"}, "count": 42}}}
+	if err := hook.Fire(entry); err != nil {
+		t.Fatal(err)
+	}
+	got := entry.Data["config"].(map[string]interface{})
+	nested := got["nested"].(map[string]interface{})
+	if nested["auth"] != "token=[REDACTED]" || got["count"] != "42" {
+		t.Fatalf("unexpected redaction: %#v", got)
+	}
+}
+
+func TestDefaultRedactionProtectsNestedAuthFields(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{"config": map[string]interface{}{"auth": map[string]interface{}{"token": "jwt-secret", "subsonicToken": "sub-secret", "name": "Alice"}}}}
+	if err := redacted.Fire(entry); err != nil {
+		t.Fatal(err)
+	}
+	auth := entry.Data["config"].(map[string]interface{})["auth"].(map[string]interface{})
+	if auth["token"] != "[REDACTED]" || auth["subsonicToken"] != "[REDACTED]" || auth["name"] != "Alice" {
+		t.Fatalf("unexpected fields: %#v", auth)
+	}
+}
+
+func TestDefaultRedactionProtectsJSONAuthFields(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{"config": `{"auth":{"token":"jwt-secret","subsonicSalt":"salt-secret","subsonicToken":"sub-secret"}}`}}
+	if err := redacted.Fire(entry); err != nil {
+		t.Fatal(err)
+	}
+	got := entry.Data["config"].(string)
+	if got != `{"auth":{"token":"[REDACTED]","subsonicSalt":"[REDACTED]","subsonicToken":"[REDACTED]"}}` {
+		t.Fatalf("JSON auth leaked: %s", got)
+	}
+}
