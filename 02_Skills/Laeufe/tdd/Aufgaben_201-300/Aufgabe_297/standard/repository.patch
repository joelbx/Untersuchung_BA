@@ -0,0 +1,61 @@
+package app
+
+import (
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestReverseProxyIndexAuthentication(t *testing.T) {
+	oldList, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() { conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldList, oldHeader }()
+	conf.Server.ReverseProxyWhitelist = "bad, 192.0.2.0/24, 2001:db8::/32"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{}
+	cases := []struct {
+		addr          string
+		header        string
+		authenticated bool
+	}{
+		{"192.0.2.9:1234", "alice", true},
+		{"[2001:db8::9]:1234", "alice", true},
+		{"198.51.100.9:1234", "alice", false},
+		{"@", "alice", false},
+		{"192.0.2.9:1234", "", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.addr+tc.header, func(t *testing.T) {
+			r := httptest.NewRequest("GET", "/index.html", nil)
+			r.RemoteAddr = tc.addr
+			r.Header.Set("Remote-User", tc.header)
+			r.Header.Set("X-Forwarded-For", "192.0.2.9")
+			w := httptest.NewRecorder()
+			serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+			cfg := extractAppConfig(w.Body.String())
+			authData, ok := cfg["auth"].(map[string]interface{})
+			if ok != tc.authenticated {
+				t.Fatalf("auth present = %v, want %v: %v", ok, tc.authenticated, cfg)
+			}
+			if ok {
+				if authData["username"] != "alice" || authData["token"] == "" || authData["subsonicSalt"] == "" || authData["subsonicToken"] == "" {
+					t.Fatalf("incomplete auth: %v", authData)
+				}
+				if authData["isAdmin"] != true {
+					t.Fatalf("first user should be admin: %v", authData)
+				}
+			}
+		})
+	}
+	conf.Server.ReverseProxyWhitelist = "@"
+	r := httptest.NewRequest("GET", "/index.html", nil)
+	r.RemoteAddr = "@"
+	r.Header.Set("Remote-User", "alice")
+	w := httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+	if _, ok := extractAppConfig(w.Body.String())["auth"]; !ok {
+		t.Fatal("whitelisted Unix socket should authenticate")
+	}
+}
