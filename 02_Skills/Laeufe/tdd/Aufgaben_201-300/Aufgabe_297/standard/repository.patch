index 0000000..37be727
--- /dev/null
+++ b/server/app/reverse_proxy.go
@@ -0,0 +1,116 @@
+package app
+
+import (
+	"crypto/md5"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// validateIPAgainstList checks the connection peer, never a forwarded address.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	host := remoteAddr
+	if h, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		host = h
+	}
+	ip := net.ParseIP(strings.Trim(host, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if h, _, err := net.SplitHostPort(entry); err == nil {
+			entry = h
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil {
+			if network.Contains(ip) {
+				return true
+			}
+		} else if allowed := net.ParseIP(strings.Trim(entry, "[]")); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for proxy login", countErr)
+			return nil
+		}
+		secret := make([]byte, 32)
+		if _, err := rand.Read(secret); err != nil {
+			log.Error(r, "Generating proxy user password", err)
+			return nil
+		}
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: username, IsAdmin: count == 0, NewPassword: hex.EncodeToString(secret)}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Creating proxy user", err)
+			return nil
+		}
+		user, err = repo.FindByUsername(username)
+	}
+	if err != nil || user == nil {
+		log.Error(r, "Finding proxy user", err)
+		return nil
+	}
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating proxy token", err)
+		return nil
+	}
+	if err := repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating proxy login time", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	saltBytes := make([]byte, 6)
+	if _, err := rand.Read(saltBytes); err != nil {
+		log.Error(r, "Generating subsonic salt", err)
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	subsonicToken := fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt)))
+	return map[string]interface{}{"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name, "username": user.UserName, "token": token, "subsonicSalt": salt, "subsonicToken": subsonicToken}
+}
