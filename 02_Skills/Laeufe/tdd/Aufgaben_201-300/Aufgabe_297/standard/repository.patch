+++ b/ui/src/authProvider.proxy.test.js
@@ -0,0 +1,23 @@
+import authProvider from './authProvider'
+import config from './config'
+
+test('proxy auth initializes the same local session fields as login', async () => {
+  config.auth = {
+    id: 'user-1',
+    name: 'Alice',
+    username: 'alice',
+    isAdmin: true,
+    token: 'proxy-token',
+    subsonicSalt: 'salt',
+    subsonicToken: 'sub-token',
+  }
+  await authProvider.checkAuth()
+  expect(localStorage.getItem('token')).toBe('proxy-token')
+  expect(localStorage.getItem('userId')).toBe('user-1')
+  expect(localStorage.getItem('name')).toBe('Alice')
+  expect(localStorage.getItem('username')).toBe('alice')
+  expect(localStorage.getItem('role')).toBe('admin')
+  expect(localStorage.getItem('subsonic-salt')).toBe('salt')
+  expect(localStorage.getItem('subsonic-token')).toBe('sub-token')
+  delete config.auth
+})
