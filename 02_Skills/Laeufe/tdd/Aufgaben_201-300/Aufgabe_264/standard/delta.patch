+def response(status, data=None):
+    info = {'status': status, 'msg': 'HTTP %s' % status,
+            'url': 'https://api.meraki.com/api/v0/test', 'body': '{}'}
+    return (BytesIO(json.dumps(data or {}).encode('utf-8')) if status < 400 else None, info)
+
+
+@pytest.mark.parametrize('status', [400, 404, 503])
+def test_request_raises_http_error_immediately(module, mocker, status):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url', return_value=response(status))
+    with pytest.raises(meraki_lib.HTTPError):
+        module.request('/test', method='GET')
+    assert module.status == status
+    assert fetch.call_count == 1
+
+
+def test_request_recovers_from_rate_limit(module, mocker):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         side_effect=[response(429), response(429), response(200, {'id': 'ok'})])
+    mocker.patch('time.sleep')
+    warn = mocker.patch.object(module.module, 'warn')
+    assert module.request('/test', method='GET') == {'id': 'ok'}
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert 'rate limit' in warn.call_args[0][0].lower()
+    assert '2' in warn.call_args[0][0]
+
+
