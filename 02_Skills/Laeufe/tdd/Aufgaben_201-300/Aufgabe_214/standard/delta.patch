+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	cases := []struct {
+		input string
+		want  ScanTechnique
+	}{
+		{"sS", TCPSYN}, {"St", TCPConnect}, {"sa", TCPACK}, {"SW", TCPWindow},
+		{"sm", TCPMaimon}, {"Sn", TCPNull}, {"sf", TCPFIN}, {"SX", TCPXmas}, {"bad", NotSupportTechnique},
+	}
+	for _, tc := range cases {
+		got := (&PortScanConf{ScanTechniques: []string{tc.input}}).GetScanTechniques()
+		if len(got) != 1 || got[0] != tc.want {
+			t.Errorf("%s: got %v, want %v", tc.input, got, tc.want)
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty: %v", got)
+	}
+}
+
+func TestPortScanIsZero(t *testing.T) {
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("empty config is not zero")
+	}
+	for _, c := range []PortScanConf{
+		{ScannerBinPath: "nmap"}, {ScanTechniques: []string{"sT"}}, {SourcePort: "443"}, {HasPrivileged: true},
+	} {
+		if c.IsZero() {
+			t.Errorf("nonempty config is zero: %+v", c)
+		}
+	}
+}
+
+func TestPortScanValidate(t *testing.T) {
+	bin := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(bin, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name      string
+		conf      PortScanConf
+		errorPart string
+	}{
+		{"valid connect", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}}, ""},
+		{"missing binary", PortScanConf{ScannerBinPath: "/no/such/nmap", ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"xyz"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT", "sS"}}, "multiple"},
+		{"unprivileged syn", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sS"}}, "privileg"},
+		{"connect source port", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "sourcePort"},
+		{"invalid source port", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, SourcePort: "65536"}, "sourcePort"},
+		{"zero source port", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, SourcePort: "0"}, "sourcePort"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			if tc.errorPart == "" {
+				if len(errs) > 0 {
+					t.Fatalf("unexpected: %v", errs)
+				}
+				return
+			}
+			for _, err := range errs {
+				if strings.Contains(strings.ToLower(err.Error()), strings.ToLower(tc.errorPart)) {
+					return
+				}
+			}
+			t.Fatalf("wanted %q in %v", tc.errorPart, errs)
+		})
+	}
+}
+
+func TestPortScanDefaultConnectRejectsSourcePort(t *testing.T) {
+	bin := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(bin, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	errs := (PortScanConf{ScannerBinPath: bin, SourcePort: "443"}).Validate()
+	for _, err := range errs {
+		if strings.Contains(err.Error(), "sourcePort") {
+			return
+		}
+	}
+	t.Fatalf("expected sourcePort incompatibility, got %v", errs)
+}
+
+func TestPortScanTOMLLoadEnablesExternalScannerPerServer(t *testing.T) {
+	old := Conf
+	defer func() { Conf = old }()
+	path := filepath.Join(t.TempDir(), "config.toml")
+	data := `[servers]
+[servers.one]
+host = "127.0.0.1"
+port = "local"
+[servers.one.portscan]
+scannerBinPath = "/usr/bin/nmap"
+scanTechniques = ["sT"]
+[servers.two]
+host = "127.0.0.2"
+port = "local"
+`
+	if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	Conf = Config{}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if Conf.Servers["one"].PortScan == nil || !Conf.Servers["one"].PortScan.IsUseExternalScanner {
+		t.Fatal("configured server did not enable external scanner")
+	}
+	if Conf.Servers["two"].PortScan != nil && Conf.Servers["two"].PortScan.IsUseExternalScanner {
+		t.Fatal("other server enabled external scanner")
+	}
+}
