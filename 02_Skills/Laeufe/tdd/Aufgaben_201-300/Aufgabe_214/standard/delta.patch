diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..af5fea1
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,128 @@
+package scanner
+
+import (
+	"bytes"
+	"encoding/xml"
+	"fmt"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(c *config.PortScanConf) ([]string, error) {
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		return nil, fmt.Errorf("multiple scan techniques are unsupported")
+	}
+	if len(techniques) == 0 {
+		if c.HasPrivileged {
+			return []string{"-sS"}, nil
+		}
+		return []string{"-sT"}, nil
+	}
+	if techniques[0] == config.NotSupportTechnique {
+		return nil, fmt.Errorf("unsupported scan technique")
+	}
+	return []string{"-" + techniques[0].String()}, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+type nmapResult struct {
+	Hosts []struct {
+		Status struct {
+			State string `xml:"state,attr"`
+		} `xml:"status"`
+		Addresses []struct {
+			Addr string `xml:"addr,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(dest map[string][]string) ([]string, error) {
+	c := l.ServerInfo.PortScan
+	if c == nil {
+		return nil, fmt.Errorf("portscan configuration is missing")
+	}
+	if errs := c.Validate(); len(errs) > 0 {
+		return nil, errs[0]
+	}
+	technique, err := setScanTechniques(c)
+	if err != nil {
+		return nil, err
+	}
+	var result []string
+	ips := make([]string, 0, len(dest))
+	for ip := range dest {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	for _, ip := range ips {
+		if net.ParseIP(ip) == nil {
+			return nil, fmt.Errorf("invalid scan destination: %s", ip)
+		}
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := dest[ip]
+		if len(ports) == 0 {
+			continue
+		}
+		allowed := map[string]bool{}
+		for _, p := range ports {
+			n, e := strconv.Atoi(p)
+			if e != nil || n < 1 || n > 65535 {
+				return nil, fmt.Errorf("invalid scan port: %s", p)
+			}
+			allowed[p] = true
+		}
+		args := append([]string{}, technique...)
+		args = append(args, "-Pn", "-n", "-oX", "-", "-p", strings.Join(ports, ","))
+		if c.SourcePort != "" {
+			args = append(args, "-g", c.SourcePort)
+		}
+		args = append(args, ip)
+		cmd := osexec.Command(c.ScannerBinPath, args...)
+		var stderr bytes.Buffer
+		cmd.Stderr = &stderr
+		output, err := cmd.Output()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed (%s): %w: %s", ip, formatNmapOptionsToString(args), err, strings.TrimSpace(stderr.String()))
+		}
+		var parsed nmapResult
+		if err := xml.Unmarshal(output, &parsed); err != nil {
+			return nil, fmt.Errorf("invalid nmap XML for %s: %w", ip, err)
+		}
+		for _, host := range parsed.Hosts {
+			if host.Status.State != "up" {
+				continue
+			}
+			matches := false
+			for _, addr := range host.Addresses {
+				if addr.Addr == ip {
+					matches = true
+				}
+			}
+			if !matches {
+				continue
+			}
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.State == "open" && allowed[port.PortID] {
+					result = append(result, net.JoinHostPort(ip, port.PortID))
+				}
+			}
+		}
+	}
+	return result, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..c8f9c60
