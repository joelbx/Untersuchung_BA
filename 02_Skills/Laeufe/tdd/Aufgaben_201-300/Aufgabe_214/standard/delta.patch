diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..c036602
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,118 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures nmap on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	for _, raw := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for _, technique := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(raw, technique.String()) {
+				found = technique
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, found)
+	}
+	return
+}
+
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil || info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("scannerBinPath must name an executable file: %s", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are unsupported"))
+	}
+	for _, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique"))
+		}
+		if !c.HasPrivileged && technique != TCPConnect && technique != NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("scan technique requires privileges"))
+		}
+		if c.SourcePort != "" && technique == TCPConnect {
+			errs = append(errs, fmt.Errorf("sourcePort is incompatible with TCP connect"))
+		}
+	}
+	if c.SourcePort != "" && len(techniques) == 0 && !c.HasPrivileged {
+		errs = append(errs, fmt.Errorf("sourcePort is incompatible with TCP connect"))
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 1 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort must be between 1 and 65535"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("failed to check scanner capabilities: %v: %s", err, strings.TrimSpace(string(output))))
+		} else if !strings.Contains(string(output), "cap_net_raw") || !strings.Contains(string(output), "+ep") {
+			errs = append(errs, fmt.Errorf("scannerBinPath lacks valid cap_net_raw+ep capability data: %s", strings.TrimSpace(string(output))))
+		}
+	}
+	return
+}
