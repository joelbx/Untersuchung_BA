+++ b/scanner/portscan_test.go
@@ -0,0 +1,69 @@
+package scanner
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScanUsesNmapOptionsAndReadsOpenPorts(t *testing.T) {
+	script := filepath.Join(t.TempDir(), "nmap")
+	body := `#!/bin/sh
+case "$*" in *"-sT"*"-oX -"*"-p 443"*"127.0.0.1"*) ;; *) exit 23 ;; esac
+printf '%s\n' '<nmaprun><host><status state="up"/><address addr="127.0.0.1" addrtype="ipv4"/><ports><port protocol="tcp" portid="443"><state state="open"/></port><port protocol="tcp" portid="80"><state state="closed"/></port></ports></host></nmaprun>'
+`
+	if err := os.WriteFile(script, []byte(body), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := base{ServerInfo: config.ServerInfo{Host: "127.0.0.1", Port: "local", PortScan: &config.PortScanConf{ScannerBinPath: script, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {"443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0] != "127.0.0.1:443" {
+		t.Fatalf("open ports: %v", got)
+	}
+}
+
+func TestNativePortScanRemainsAvailable(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	_, port, err := net.SplitHostPort(listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	l := base{ServerInfo: config.ServerInfo{Host: "127.0.0.1", Port: "local"}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {port}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(got, ",") != "127.0.0.1:"+port {
+		t.Fatalf("open ports: %v", got)
+	}
+}
+
+func TestExternalPortScanIgnoresScannerStderrWhenXMLIsValid(t *testing.T) {
+	script := filepath.Join(t.TempDir(), "nmap")
+	body := `#!/bin/sh
+printf '<warning/>\n' >&2
+printf '%s\n' '<nmaprun><host><status state="up"/><address addr="127.0.0.1"/><ports><port protocol="tcp" portid="443"><state state="open"/></port></ports></host></nmaprun>'
+`
+	if err := os.WriteFile(script, []byte(body), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := base{ServerInfo: config.ServerInfo{Host: "127.0.0.1", Port: "local", PortScan: &config.PortScanConf{ScannerBinPath: script, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {"443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(got, ",") != "127.0.0.1:443" {
+		t.Fatalf("open ports: %v", got)
+	}
+}
