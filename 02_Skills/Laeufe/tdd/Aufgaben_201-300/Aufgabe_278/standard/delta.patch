diff --git a/applications/mail/src/app/logic/elements/elementsLoading.test.ts b/applications/mail/src/app/logic/elements/elementsLoading.test.ts
new file mode 100644
index 0000000..2dffc3b
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsLoading.test.ts
@@ -0,0 +1,66 @@
+import { configureStore } from '@reduxjs/toolkit';
+import reducer, { newState } from './elementsSlice';
+import { backendActionStarted, backendActionFinished, load } from './elementsActions';
+import { loading, pendingActions } from './elementsSelectors';
+import { RootState } from '../store';
+
+const makeStore = () =>
+    configureStore({
+        reducer: { elements: reducer },
+        middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+    });
+const asRoot = (state: ReturnType<ReturnType<typeof makeStore>['getState']>) => state as RootState;
+
+describe('elements list loading', () => {
+    it('tracks overlapping backend operations until all have finished', () => {
+        const store = makeStore();
+        store.dispatch(backendActionStarted());
+        store.dispatch(backendActionStarted());
+        expect(pendingActions(asRoot(store.getState()))).toBe(2);
+        store.dispatch(backendActionFinished());
+        expect(pendingActions(asRoot(store.getState()))).toBe(1);
+        store.dispatch(backendActionFinished());
+        expect(pendingActions(asRoot(store.getState()))).toBe(0);
+    });
+
+    it('keeps loading true while a request is needed for the current page', () => {
+        const state = { elements: { ...newState(), beforeFirstLoad: false } } as RootState;
+        const params = state.elements.params;
+        expect(loading(state, { page: 0, params })).toBe(true);
+    });
+
+    it('does not commit stale API data and queues a fresh retry', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const api = jest.fn().mockResolvedValue({ Total: 1, Conversations: [{ ID: 'stale' }], Stale: 1 });
+        const params = newState().params;
+        const result = await store.dispatch(
+            load({ api: api as any, abortController: undefined, conversationMode: true, page: 0, params })
+        );
+        expect(load.rejected.match(result)).toBe(true);
+        expect(store.getState().elements.elements).toEqual({});
+        jest.advanceTimersByTime(1000);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error: undefined });
+        expect(store.getState().elements.retry.payload).toMatchObject({ Page: 0, LabelID: params.labelID });
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        jest.useRealTimers();
+    });
+
+    it('queues a failed request retry after two seconds', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const error = new Error('offline');
+        const api = jest.fn().mockRejectedValue(error);
+        const params = newState().params;
+        const result = await store.dispatch(
+            load({ api: api as any, abortController: undefined, conversationMode: true, page: 0, params })
+        );
+        expect(load.rejected.match(result)).toBe(true);
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().elements.retry.count).toBe(0);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error });
+        expect(store.getState().elements.retry.payload).toMatchObject({ Page: 0, LabelID: params.labelID });
+        jest.useRealTimers();
+    });
+});
