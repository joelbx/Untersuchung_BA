+def test_open_filesystem_favorites_and_category_order(config_stub, quickmarks,
+                                                      bookmarks, info):
+    """Configured favorites appear in an ordered Filesystem category."""
+    config_stub.val.completion.favorite_paths = ['/tmp/start.html', '~/notes']
+    config_stub.val.completion.open_categories = [
+        'filesystem', 'quickmarks', 'bookmarks']
+
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+
+    assert [model.data(model.index(row, 0))
+            for row in range(model.rowCount())] == [
+                'Filesystem', 'Quickmarks', 'Bookmarks']
+    assert model.rowCount(model.index(0, 0)) == 2
+    assert [tuple(model.data(model.index(row, col, model.index(0, 0)))
+                  for col in range(3)) for row in range(2)] == [
+                 ('/tmp/start.html', None, None),
+                 ('~/notes', None, None)]
+
+
+@pytest.mark.parametrize('pattern, expected', [
+    ('path', []),
+    ('https://example.org/', []),
+    ('file://remote/tmp/', []),
+    ('file:///tmp/?query', []),
+])
+def test_open_filesystem_ignores_nonlocal_patterns(config_stub, info, quickmarks,
+                                                    bookmarks, pattern, expected):
+    """Only local path forms can populate Filesystem suggestions."""
+    config_stub.val.completion.open_categories = ['filesystem']
+    model = urlmodel.url(info=info)
+    model.set_pattern(pattern)
+    _check_completions(model, {'Filesystem': expected})
+
+
+@pytest.mark.parametrize('form', ['absolute', 'url', 'tilde'])
+def test_open_filesystem_completes_local_entries(config_stub, info, tmp_path,
+                                                   monkeypatch, quickmarks,
+                                                   bookmarks, form):
+    """A directory prefix lists matching entries in sorted display form."""
+    files = tmp_path / 'files'
+    files.mkdir()
+    (files / 'alpha.html').write_text('a')
+    (files / 'zeta.html').write_text('z')
+    (files / 'beta').mkdir()
+    monkeypatch.setenv('HOME', str(tmp_path))
+    config_stub.val.completion.open_categories = ['filesystem']
+    model = urlmodel.url(info=info)
+    if form == 'absolute':
+        prefix = str(files) + os.sep
+    elif form == 'url':
+        prefix = files.as_uri() + '/'
+    else:
+        prefix = '~/files/'
+    model.set_pattern(prefix)
+    _check_completions(model, {'Filesystem': [
+        (prefix + 'alpha.html', None, None),
+        (prefix + 'beta/', None, None),
+        (prefix + 'zeta.html', None, None),
+    ]})
+
+
+def test_open_filesystem_filters_partial_name(config_stub, info, tmp_path,
+                                               quickmarks, bookmarks):
+    """A partial basename returns only matching siblings."""
+    (tmp_path / 'alpha.html').write_text('a')
+    (tmp_path / 'beta.html').write_text('b')
+    config_stub.val.completion.open_categories = ['filesystem']
+    model = urlmodel.url(info=info)
+    model.set_pattern(str(tmp_path / 'al'))
+    _check_completions(model, {'Filesystem': [
+        (str(tmp_path / 'alpha.html'), None, None),
+    ]})
+
+
+def test_open_filesystem_expands_bare_tilde(config_stub, info, tmp_path,
+                                            monkeypatch, quickmarks, bookmarks):
+    """A bare tilde lists the home directory with contracted paths."""
+    files = tmp_path / 'files'
+    files.mkdir()
+    monkeypatch.setenv('HOME', str(tmp_path))
+    config_stub.val.completion.open_categories = ['filesystem']
+    model = urlmodel.url(info=info)
+    model.set_pattern('~')
+    paths = [model.data(model.index(row, 0, model.index(0, 0)))
+             for row in range(model.rowCount(model.index(0, 0)))]
+    assert '~/files/' in paths
+
+
+def test_open_filesystem_stays_visible_when_empty(config_stub, info,
+                                                  quickmark_manager_stub,
+                                                  bookmark_manager_stub):
+    """The enabled category stays present when no file matches."""
+    config_stub.val.completion.open_categories = ['filesystem', 'quickmarks']
+    model = urlmodel.url(info=info)
+    model.set_pattern('/definitely-missing-qutebrowser-path/')
+    _check_completions(model, {'Filesystem': []})
+
