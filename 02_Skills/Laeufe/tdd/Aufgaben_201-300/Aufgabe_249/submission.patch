+
+@pytest.mark.parametrize(
+    'language, expected',
+    [
+        ('fr', ('https://fr.wikipedia.org/wiki/Douglas_Adams', 'fr')),
+        ('de', ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en')),
+        ('en', ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en')),
+    ],
+)
+def test_wikipedia_link_uses_requested_language_or_english(language, expected):
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'frwiki': {'title': 'Douglas Adams', 'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'},
+        'enwiki': {'title': 'Douglas Adams', 'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+    }
+    assert entity._get_wikipedia_link(language) == expected
+
+
+def test_wikipedia_link_is_absent_without_requested_or_english_page():
+    entity = createWikidataEntity()
+    entity.sitelinks = {'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'}}
+    assert entity._get_wikipedia_link('de') is None
+
+
+@pytest.mark.parametrize(
+    'statements, expected',
+    [
+        ({}, []),
+        ({'P1960': [{'value': {'content': 'one'}}]}, ['one']),
+        ({'P1960': [{'value': {'content': 'one'}}, {'value': {'content': 'two'}}]}, ['one', 'two']),
+        ({'P1960': [{'value': {'content': 'one'}}, {}, {'value': {}}, {'value': {'content': 'two'}}]}, ['one', 'two']),
+    ],
+)
+def test_statement_values_include_only_valid_content(statements, expected):
+    entity = createWikidataEntity()
+    entity.statements = statements
+    assert entity._get_statement_values('P1960') == expected
+
+
+def test_external_profiles_include_localized_wikipedia_wikidata_and_every_scholar_id():
+    entity = createWikidataEntity()
+    entity.sitelinks = {'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'}}
+    entity.statements = {'P1960': [{'value': {'content': 'first'}}, {'value': {'content': 'second'}}]}
+    assert entity.get_external_profiles('fr') == [
+        {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams', 'icon_url': '/static/images/identifier_icons/wikipedia.svg', 'label': 'Wikipedia'},
+        {'url': 'https://www.wikidata.org/wiki/Q42', 'icon_url': '/static/images/identifier_icons/wikidata.svg', 'label': 'Wikidata'},
+        {'url': 'https://scholar.google.com/citations?user=first', 'icon_url': '/static/images/identifier_icons/google_scholar.svg', 'label': 'Google Scholar'},
+        {'url': 'https://scholar.google.com/citations?user=second', 'icon_url': '/static/images/identifier_icons/google_scholar.svg', 'label': 'Google Scholar'},
+    ]
+
+
+def test_external_profiles_without_wikipedia_or_identifiers_include_wikidata():
+    entity = createWikidataEntity()
+    entity.sitelinks = {}
+    entity.statements = {}
+    assert entity.get_external_profiles() == [
+        {'url': 'https://www.wikidata.org/wiki/Q42', 'icon_url': '/static/images/identifier_icons/wikidata.svg', 'label': 'Wikidata'}
+    ]
