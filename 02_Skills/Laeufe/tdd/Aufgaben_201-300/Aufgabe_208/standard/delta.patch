diff --git a/test/user-email-validation.js b/test/user-email-validation.js
new file mode 100644
index 0000000..0b173d7
--- /dev/null
+++ b/test/user-email-validation.js
@@ -0,0 +1,123 @@
+'use strict';
+
+const assert = require('assert');
+const Module = require('module');
+
+function createHarness() {
+	const values = new Map();
+	const expirations = new Map();
+	const config = { sendValidationEmail: 1, emailConfirmExpiry: 2, emailConfirmInterval: 10 };
+	let nextCode = 0;
+	const db = {
+		get: async key => values.get(key),
+		getObject: async key => values.get(key),
+		set: async (key, value) => values.set(key, value),
+		setObject: async (key, value) => values.set(key, value),
+		pexpireAt: async (key, time) => expirations.set(key, time),
+		expireAt: async (key, time) => expirations.set(key, time * 1000),
+		pttl: async key => (values.has(key) ? expirations.get(key) - Date.now() : -2),
+		deleteAll: async keys => keys.forEach((key) => {
+			values.delete(key);
+			expirations.delete(key);
+		}),
+	};
+	const stubs = {
+		nconf: { get: () => 'http://localhost' },
+		winston: { verbose: () => {} },
+		'./index': { getUserField: async (uid, field) => (field === 'email' ? 'person@example.org' : 'person') },
+		'../utils': {
+			generateUUID: () => {
+				nextCode += 1;
+				return `code-${nextCode}`;
+			},
+		},
+		'../plugins': { hooks: { fire: async (hook, data) => data, hasListeners: () => true } },
+		'../database': db,
+		'../meta': { config },
+		'../emailer': {},
+		'../groups': {},
+		'../events': { log: () => {} },
+	};
+	const filename = require.resolve('../src/user/email');
+	const originalLoad = Module._load;
+	delete require.cache[filename];
+	Module._load = function (request, parent, isMain) {
+		if (parent && parent.filename === filename && Object.prototype.hasOwnProperty.call(stubs, request)) {
+			return stubs[request];
+		}
+		return originalLoad.call(this, request, parent, isMain);
+	};
+	let email;
+	try {
+		email = require(filename);
+	} finally {
+		Module._load = originalLoad;
+		delete require.cache[filename];
+	}
+	return { email, db, config, values, expirations };
+}
+
+describe('email confirmation lifetime and resend', () => {
+	it('returns strict pending booleans for the stored email', async () => {
+		const { email } = createHarness();
+		assert.strictEqual(await email.isValidationPending(1), false);
+		assert.strictEqual(await email.isValidationPending(1, 'person@example.org'), false);
+		await email.sendValidationEmail(1);
+		assert.strictEqual(await email.isValidationPending(1), true);
+		assert.strictEqual(await email.isValidationPending(1, 'person@example.org'), true);
+		assert.strictEqual(await email.isValidationPending(1, 'other@example.org'), false);
+	});
+
+	it('returns the live remaining confirmation lifetime in milliseconds', async () => {
+		const { email, db, values, expirations } = createHarness();
+		assert.strictEqual(await email.getValidationExpiry(1), null);
+		const code = await email.sendValidationEmail(1);
+		const ttl = await email.getValidationExpiry(1);
+		assert(ttl > 0 && ttl <= 172800000);
+		assert(values.has(`confirm:${code}`));
+		assert(expirations.get(`confirm:${code}`) - Date.now() <= 172800000);
+		await db.pexpireAt('confirm:byUid:1', Date.now() + 123000);
+		const shorter = await email.getValidationExpiry(1);
+		assert(shorter > 0 && shorter <= 123000);
+	});
+
+	it('blocks resend until the configured interval has elapsed', async () => {
+		const { email, db } = createHarness();
+		assert.strictEqual(await email.canSendValidation(1, 'person@example.org'), true);
+		await email.sendValidationEmail(1);
+		assert.strictEqual(await email.canSendValidation(1, 'person@example.org'), false);
+		await assert.rejects(email.sendValidationEmail(1), /confirm-email-already-sent/);
+		await db.pexpireAt('confirm:byUid:1', Date.now() + 172199000);
+		assert.strictEqual(await email.canSendValidation(1, 'person@example.org'), true);
+		const code = await email.sendValidationEmail(1);
+		assert.strictEqual(code, 'code-3');
+	});
+
+	it('clears both records and allows an immediate resend after explicit expiry', async () => {
+		const { email, values } = createHarness();
+		const code = await email.sendValidationEmail(1);
+		await email.expireValidation(1);
+		assert.strictEqual(values.has('confirm:byUid:1'), false);
+		assert.strictEqual(values.has(`confirm:${code}`), false);
+		assert.strictEqual(await email.isValidationPending(1), false);
+		assert.strictEqual(await email.getValidationExpiry(1), null);
+		assert.strictEqual(await email.canSendValidation(1, 'person@example.org'), true);
+		assert.strictEqual(await email.sendValidationEmail(1), 'code-2');
+	});
+
+	it('does not treat a marker with a missing confirmation record as pending', async () => {
+		const { email, values } = createHarness();
+		const code = await email.sendValidationEmail(1);
+		values.delete(`confirm:${code}`);
+		assert.strictEqual(await email.isValidationPending(1), false);
+		assert.strictEqual(await email.getValidationExpiry(1), null);
+		assert.strictEqual(await email.canSendValidation(1, 'person@example.org'), true);
+	});
+
+	it('caps the reported lifetime at the configured expiry', async () => {
+		const { email, db } = createHarness();
+		await email.sendValidationEmail(1);
+		await db.pexpireAt('confirm:byUid:1', Date.now() + 259200000);
+		assert.strictEqual(await email.getValidationExpiry(1), 172800000);
+	});
+});
