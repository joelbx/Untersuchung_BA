@@ -0,0 +1,21 @@
+import "../../../skinned-sdk";
+import React from 'react';
+import { shallow } from 'enzyme';
+import { User } from 'matrix-js-sdk/src/models/user';
+import { Room } from 'matrix-js-sdk/src/models/room';
+import ShareDialog from '../../../../src/components/views/dialogs/ShareDialog';
+
+describe('ShareDialog links', () => {
+    it('labels the share URL as a link to the room', () => {
+        const room = new Room('!room:example.org', {} as any, '@alice:example.org');
+        const wrapper = shallow(<ShareDialog target={room} onFinished={() => {}} />);
+        const link = wrapper.find('.mx_ShareDialog_matrixto_link');
+        expect(link.prop('title')).toBe('Link to room');
+        expect(link.prop('aria-label')).toBe('Link to room');
+    });
+
+    it('labels a shared user link as a link to the user', () => {
+        const wrapper = shallow(<ShareDialog target={new User('@alice:example.org')} onFinished={() => {}} />);
+        expect(wrapper.find('.mx_ShareDialog_matrixto_link').prop('title')).toBe('Link to user');
+    });
+});
diff --git a/test/components/views/elements/ExternalLink-test.tsx b/test/components/views/elements/ExternalLink-test.tsx
new file mode 100644
index 0000000..d1461a6
--- /dev/null
+++ b/test/components/views/elements/ExternalLink-test.tsx
@@ -0,0 +1,21 @@
+import React from 'react';
+import { mount } from 'enzyme';
+import ExternalLink from '../../../../src/components/views/elements/ExternalLink';
+
+describe('ExternalLink', () => {
+    it('announces a new tab while keeping the icon decorative and forwarding anchor props', () => {
+        const wrapper = mount(<ExternalLink href="https://example.org" className="custom" title="Example site">
+            Example site
+        </ExternalLink>);
+        const anchor = wrapper.find('a');
+
+        expect(anchor.prop('href')).toBe('https://example.org');
+        expect(anchor.prop('target')).toBe('_blank');
+        expect(anchor.prop('rel')).toBe('noreferrer noopener');
+        expect(anchor.prop('title')).toBe('Example site');
+        expect(anchor.hasClass('mx_ExternalLink')).toBe(true);
+        expect(anchor.hasClass('custom')).toBe(true);
+        expect(anchor.text()).toBe('Example site Opens in a new tab');
+        expect(anchor.find('[aria-hidden="true"]')).toHaveLength(1);
+    });
+});
