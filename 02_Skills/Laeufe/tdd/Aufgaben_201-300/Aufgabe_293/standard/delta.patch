+func validateOCIReference(repository string) error {
+	scheme, reference, hasScheme := strings.Cut(repository, "://")
+	if hasScheme && scheme != "http" && scheme != "https" && scheme != "flipt" {
+		return fmt.Errorf("unexpected repository scheme: %q should be one of [http|https|flipt]", scheme)
+	}
+	if !hasScheme {
+		reference = scheme
+		scheme = "https"
+	}
+	if !strings.Contains(reference, "/") {
+		reference = "local/" + reference
+		scheme = "flipt"
+	}
+	ref, err := registry.ParseReference(reference)
+	if err != nil {
+		return err
+	}
+	switch scheme {
+	case "http", "https":
+		return nil
+	case "flipt":
+		if ref.Registry != "local" {
+			return fmt.Errorf("unexpected local reference: %q", ref)
+		}
+		return nil
+	default:
+		return fmt.Errorf("unexpected repository scheme: %q should be one of [http|https|flipt]", scheme)
+	}
+}
