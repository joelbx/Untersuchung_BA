+func oci(ctx context.Context, _ *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	const bundles = "/tmp/oci-bundles"
+	flipt = flipt.
+		WithDirectory("/tmp/testdata", base.Directory(testdataDir)).
+		WithNewFile("/tmp/testdata/.flipt.yml", dagger.ContainerWithNewFileOpts{
+			Contents: "version: \"1.0\"\ninclude:\n- default.yaml\n- production.yaml\n",
+		}).
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", "flipt://local/readonly:latest").
+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", bundles).
+		WithEnvVariable("UNIQUE", uuid.New().String()).
+		WithExec([]string{"mkdir", "-p", bundles}).
+		WithWorkdir("/tmp/testdata").
+		WithExec([]string{"/flipt", "bundle", "build", "readonly:latest"})
+
+	if _, err := flipt.Sync(ctx); err != nil {
+		return func() error { return err }
+	}
+
+	return suite(ctx, "readonly", base, flipt.WithWorkdir("/").WithExec(nil), conf)
+}
