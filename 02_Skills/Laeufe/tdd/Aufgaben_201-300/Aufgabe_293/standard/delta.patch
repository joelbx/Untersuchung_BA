+// DefaultBundleDir returns the default location for OCI bundles.
+func DefaultBundleDir() (string, error) {
+	root, err := defaultDatabaseRoot()
+	if err != nil {
+		return "", err
+	}
+	dir := filepath.Join(root, "flipt", "bundles")
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return "", fmt.Errorf("creating bundles directory: %w", err)
+	}
+	return dir, nil
+}
