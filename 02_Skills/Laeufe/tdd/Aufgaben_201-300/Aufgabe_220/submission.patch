+def qcolor_to_qsscolor(c: QColor) -> str:
+    """Convert a QColor to an RGBA color string for Qt stylesheets."""
+    return 'rgba({}, {}, {}, {})'.format(c.red(), c.green(), c.blue(),
+                                         c.alpha())
