+def test_tabbar_background_stylesheet_uses_configured_alpha(qtbot,
+                                                             config_stub):
+    """Apply a configured translucent tab bar color in QSS."""
+    bar = QTabBar()
+    qtbot.addWidget(bar)
+    bar.STYLESHEET = tabwidget.TabBar.STYLESHEET
+    config_stub.val.colors.tabs.bar.bg = 'rgba(12, 34, 56, 78)'
+
+    tabwidget.TabBar._set_colors(bar)
