     usertypes.JsLogLevel.info: message.info,
@@ -159,6 +159,32 @@ _JS_LOGMAP_MESSAGE: Mapping[usertypes.JsLogLevel, Callable[[str], None]] = {
 }
 
 
+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Show an enabled JavaScript message in the UI, unless excluded."""
+    levels_config = config.cache['content.javascript.log_message.levels'] or {}
+    enabled = any(
+        level.name in levels and fnmatch.fnmatchcase(source, pattern)
+        for pattern, levels in levels_config.items()
+    )
+    if not enabled:
+        return False
+
+    excludes = config.cache['content.javascript.log_message.excludes'] or {}
+    if any(fnmatch.fnmatchcase(source, pattern) and
+           any(fnmatch.fnmatchcase(msg, excluded) for excluded in messages)
+           for pattern, messages in excludes.items()):
+        return False
+
+    func = _JS_LOGMAP_MESSAGE[level]
+    func(f"JS: [{source}:{line}] {msg}")
+    return True
+
+
