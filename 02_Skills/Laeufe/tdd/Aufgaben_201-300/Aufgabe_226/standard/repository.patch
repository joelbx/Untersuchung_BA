+package cmd
+
+import (
+	"mime"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/spf13/viper"
+)
+
+// Changing the runtime MIME configuration must affect extension lookup after startup.
+func TestLoadRegistersConfiguredMIMEType(t *testing.T) {
+	dataFolder := t.TempDir()
+	resourceFolder := filepath.Join(dataFolder, "resources")
+	if err := os.Mkdir(resourceFolder, 0755); err != nil {
+		t.Fatal(err)
+	}
+	content := []byte("types:\n  .customaudio: audio/x-customaudio\nlossless:\n  - .customaudio\n")
+	if err := os.WriteFile(filepath.Join(resourceFolder, "mime_types.yaml"), content, 0644); err != nil {
+		t.Fatal(err)
+	}
+	oldDataFolder := viper.Get("datafolder")
+	oldServer := *conf.Server
+	viper.Set("datafolder", dataFolder)
+	t.Cleanup(func() {
+		viper.Set("datafolder", oldDataFolder)
+		*conf.Server = oldServer
+	})
+
+	conf.Load()
+	if got := mime.TypeByExtension(".customaudio"); got != "audio/x-customaudio" {
+		t.Fatalf("configured MIME type = %q, want audio/x-customaudio", got)
+	}
+}
