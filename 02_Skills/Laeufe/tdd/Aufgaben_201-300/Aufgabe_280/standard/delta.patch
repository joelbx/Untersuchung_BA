+func TestNewWithClientEnvironment(t *testing.T) {
+	tests := []struct {
+		name        string
+		namespace   string
+		replicaName string
+		wantMissing string
+	}{
+		{name: "missing namespace", replicaName: "agent-0", wantMissing: "KUBE_NAMESPACE"},
+		{name: "missing replica name", namespace: "agent-namespace", wantMissing: "TELEPORT_REPLICA_NAME"},
+		{name: "configured backend", namespace: "agent-namespace", replicaName: "agent-0"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv("TELEPORT_REPLICA_NAME", tt.replicaName)
+			t.Setenv(ReleaseNameEnv, "agent-release")
+
+			b, err := NewWithClient(fake.NewSimpleClientset())
+			if tt.wantMissing != "" {
+				require.Nil(t, b)
+				require.EqualError(t, err, fmt.Sprintf("environment variable %q not set or empty", tt.wantMissing))
+				return
+			}
+
+			require.NoError(t, err)
+			require.Equal(t, "agent-namespace", b.Namespace)
+			require.Equal(t, "agent-release", b.ReleaseName)
+			require.Equal(t, "agent-0-state", b.SecretName)
+		})
+	}
+}
