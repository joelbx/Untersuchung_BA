+import errno
+import time
+
 from ansible.module_utils.facts.collector import BaseFactCollector
 
 
@@ -42,6 +45,24 @@ class Hardware:
     def populate(self, collected_facts=None):
         return {}
 
+    def get_uptime_facts(self):
+        sysctl = self.module.get_bin_path('sysctl')
+        if not sysctl:
+            raise ValueError('Unable to find sysctl')
+        try:
+            rc, out, err = self.module.run_command([sysctl, '-n', 'kern.boottime'])
+        except OSError as exc:
+            if exc.errno == errno.ENOENT:
+                raise ValueError('Unable to find sysctl: %s' % exc)
+            return {}
+        if rc != 0:
+            return {}
+        try:
+            boot_time = int(out.strip())
+        except ValueError:
+            return {}
+        return {'uptime_seconds': int(time.time() - boot_time)}
+
 
 class HardwareCollector(BaseFactCollector):
     name = 'hardware'
