diff --git a/detector/vuls2/db_connection_test.go b/detector/vuls2/db_connection_test.go
new file mode 100644
index 0000000..17999df
--- /dev/null
+++ b/detector/vuls2/db_connection_test.go
@@ -0,0 +1,22 @@
+package vuls2
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func Test_newDBConnection_reportsInvalidDatabasePath(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "vuls.db")
+	if err := os.WriteFile(path, []byte("not a bolt database"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	_, err := newDBConnection(config.Vuls2Conf{Path: path, SkipUpdate: true}, true)
+	if err == nil || !strings.Contains(err.Error(), path) {
+		t.Fatalf("newDBConnection() error = %v, want error with path %q", err, path)
+	}
+}
