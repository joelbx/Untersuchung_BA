+++ b/ui/src/dataProvider/httpClient.test.js
@@ -0,0 +1,22 @@
+import { fetchUtils } from 'react-admin'
+import httpClient from './httpClient'
+
+jest.mock('react-admin', () => ({
+  fetchUtils: { fetchJson: jest.fn() },
+}))
+
+it('sends one client UUID on every API request', async () => {
+  fetchUtils.fetchJson.mockResolvedValue({ headers: new Headers() })
+  await httpClient('/first')
+  await httpClient('/second')
+  const first = fetchUtils.fetchJson.mock.calls[0][1].headers.get(
+    'X-ND-Client-Unique-Id'
+  )
+  const second = fetchUtils.fetchJson.mock.calls[1][1].headers.get(
+    'X-ND-Client-Unique-Id'
+  )
+  expect(first).toMatch(
+    /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+  )
+  expect(second).toBe(first)
+})
