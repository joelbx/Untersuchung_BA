diff --git a/server/client_unique_id_test.go b/server/client_unique_id_test.go
new file mode 100644
index 0000000..68016a2
--- /dev/null
+++ b/server/client_unique_id_test.go
@@ -0,0 +1,34 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/navidrome/navidrome/consts"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+func TestClientUniqueIDMiddlewareUsesHeaderThenCookie(t *testing.T) {
+	var got string
+	handler := clientUniqueID(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got, _ = request.ClientUniqueIdFrom(r.Context())
+	}))
+	first := httptest.NewRequest("GET", "/", nil)
+	first.Header.Set(consts.UIClientUniqueIDHeader, "window-a")
+	recorder := httptest.NewRecorder()
+	handler.ServeHTTP(recorder, first)
+	if got != "window-a" {
+		t.Fatalf("context ID = %q", got)
+	}
+	cookies := recorder.Result().Cookies()
+	if len(cookies) != 1 || cookies[0].Value != "window-a" || !cookies[0].HttpOnly || cookies[0].Path != "/" || cookies[0].MaxAge != 365*24*3600 {
+		t.Fatalf("cookie = %#v", cookies)
+	}
+	second := httptest.NewRequest("GET", "/", nil)
+	second.AddCookie(cookies[0])
+	handler.ServeHTTP(httptest.NewRecorder(), second)
+	if got != "window-a" {
+		t.Fatalf("cookie context ID = %q", got)
+	}
+}
