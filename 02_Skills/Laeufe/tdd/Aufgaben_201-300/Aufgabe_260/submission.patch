diff --git a/server/events/sse_delivery_test.go b/server/events/sse_delivery_test.go
new file mode 100644
index 0000000..97e1379
--- /dev/null
+++ b/server/events/sse_delivery_test.go
@@ -0,0 +1,45 @@
+package events
+
+import (
+	"context"
+	"testing"
+
+	"code.cloudfoundry.org/go-diodes"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+func TestBrokerDeliversOnlyToOtherSessionsOfSender(t *testing.T) {
+	b := NewBroker().(*broker)
+	subscribers := []client{
+		{id: "origin", username: "alice", clientUniqueId: "window-a"},
+		{id: "other", username: "alice", clientUniqueId: "window-b"},
+		{id: "foreign", username: "bob", clientUniqueId: "window-c"},
+	}
+	for i := range subscribers {
+		subscribers[i].diode = newDiode(context.Background(), 8, diodes.AlertFunc(func(int) {}))
+		b.subscribing <- subscribers[i]
+		subscribers[i].diode.next() // ServerStart proves registration completed.
+	}
+	sender := request.WithUsername(context.Background(), "alice")
+	sender = request.WithClientUniqueId(sender, "window-a")
+	b.SendMessage(sender, &RefreshResource{})
+	// A second message acts as a barrier for the broker's publish loop.
+	b.SendMessage(context.Background(), &KeepAlive{TS: 1})
+	for _, subscriber := range subscribers {
+		// The broadcast keepalive arrives after the scoped event.
+		first := subscriber.diode.next()
+		if subscriber.id == "other" {
+			if first.event != "refreshResource" {
+				t.Errorf("%s received %q first", subscriber.id, first.event)
+			}
+			first = subscriber.diode.next()
+		}
+		if first.event != "keepAlive" {
+			t.Errorf("%s received %q instead of keepAlive", subscriber.id, first.event)
+		}
+		if _, ok := subscriber.diode.tryNext(); ok {
+			t.Errorf("%s received extra event", subscriber.id)
+		}
+		b.unsubscribing <- subscriber
+	}
+}
