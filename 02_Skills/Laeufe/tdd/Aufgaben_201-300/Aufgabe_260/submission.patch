+package scanner
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/server/events"
+)
+
+type progressBroker struct{ contexts chan context.Context }
+
+func (b *progressBroker) ServeHTTP(http.ResponseWriter, *http.Request) {}
+func (b *progressBroker) SendMessage(ctx context.Context, event events.Event) {
+	if _, ok := event.(*events.ScanStatus); ok {
+		b.contexts <- ctx
+	}
+}
+
+func TestScanProgressRetainsRequestIdentity(t *testing.T) {
+	b := &progressBroker{contexts: make(chan context.Context, 3)}
+	s := &scanner{broker: b, status: map[string]*scanStatus{"music": {}}}
+	ctx := request.WithUsername(context.Background(), "alice")
+	ctx = request.WithClientUniqueId(ctx, "window-a")
+	_, cancel := s.startProgressTracker(ctx, "music")
+	defer cancel()
+	select {
+	case received := <-b.contexts:
+		id, _ := request.ClientUniqueIdFrom(received)
+		username, _ := request.UsernameFrom(received)
+		if id != "window-a" || username != "alice" {
+			t.Fatalf("progress sender = %q, %q", username, id)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("no progress event")
+	}
+}
