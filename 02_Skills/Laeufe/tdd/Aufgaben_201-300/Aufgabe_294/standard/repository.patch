+def _is_child_path(b_root, b_path, b_link_location=None):
+    """Check a path, or a link target relative to its location, against a root."""
+    if b_link_location is not None:
+        b_path = os.path.join(os.path.dirname(b_link_location), b_path)
+    b_relative = os.path.relpath(os.path.realpath(b_path), os.path.realpath(b_root))
+    parent = to_bytes(os.pardir + os.sep) if isinstance(b_relative, bytes) else os.pardir + os.sep
+    return b_relative != parent[:-1] and not b_relative.startswith(parent)
 
 
