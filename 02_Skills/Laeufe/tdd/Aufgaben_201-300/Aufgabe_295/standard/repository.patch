+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { render } from '@testing-library/react';
+
+import DeviceVerificationStatusCard from
+    '../../../../../src/components/views/settings/devices/DeviceVerificationStatusCard';
+
+describe('<DeviceVerificationStatusCard />', () => {
+    it.each([
+        [true, 'Verified', 'Verified session', 'This session is ready for secure messaging.'],
+        [false, 'Unverified', 'Unverified session',
+            'Verify or sign out from this session for best security and reliability.'],
+        [null, 'Unverified', 'Unverified session',
+            'Verify or sign out from this session for best security and reliability.'],
+    ])('renders the correct status when isVerified is %s', (isVerified, variation, heading, description) => {
+        const { container, getByText } = render(<DeviceVerificationStatusCard device={{
+            device_id: 'my-device',
+            isVerified,
+        }} />);
+
+        expect(container.querySelector('.mx_DeviceSecurityCard_icon').classList.contains(variation)).toBe(true);
+        expect(getByText(heading).classList.contains('mx_DeviceSecurityCard_heading')).toBe(true);
+        expect(getByText(description).classList.contains('mx_DeviceSecurityCard_description')).toBe(true);
+    });
+});
