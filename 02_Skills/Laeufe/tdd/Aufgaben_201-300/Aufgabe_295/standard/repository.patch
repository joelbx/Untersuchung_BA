+    it('keeps the status card after expanded details', () => {
+        const { container, getByTestId } = render(getComponent({
+            device: { device_id: deviceId, isVerified: true },
+        }));
+
+        fireEvent.click(getByTestId('current-session-toggle-details'));
+
+        const details = container.querySelector('.mx_DeviceDetails');
+        const cards = container.querySelectorAll('.mx_DeviceSecurityCard');
+        expect(cards).toHaveLength(2);
