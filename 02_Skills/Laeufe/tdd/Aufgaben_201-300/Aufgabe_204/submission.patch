+/** Parse a date from ISO or a common text format. */
+export const guessDateFromText = (text: string): Date | undefined => {
+    const isoDate = parseISO(text);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+
+    // An invalid ISO day must not be silently rolled into the next month by Date.
+    if (/^\d{4}-/.test(text)) {
+        return undefined;
+    }
+
+    const date = new Date(text);
+    if (!isValid(date)) {
+        return undefined;
+    }
+
+    const yearFirst = text.match(/^(\d{4})\/(\d{1,2})\/(\d{1,2})$/);
+    const monthFirst = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
+    if (yearFirst || monthFirst) {
+        const year = yearFirst ? yearFirst[1] : monthFirst![3];
+        const month = yearFirst ? yearFirst[2] : monthFirst![1];
+        const day = yearFirst ? yearFirst[3] : monthFirst![2];
+        if (
+            date.getFullYear() !== Number(year) ||
+            date.getMonth() + 1 !== Number(month) ||
+            date.getDate() !== Number(day)
+        ) {
+            return undefined;
+        }
+    }
+
+    return date;
+};
