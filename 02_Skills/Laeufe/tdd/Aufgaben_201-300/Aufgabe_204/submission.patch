--- /dev/null
+++ b/packages/shared/test/contacts/csvFormat.spec.ts
@@ -0,0 +1,18 @@
+import { combine } from '@proton/shared/lib/contacts/helpers/csvFormat';
+import { serialize } from '@proton/shared/lib/contacts/vcard';
+
+describe('CSV contact dates', () => {
+    it('imports a month-name birthday as a date that serializes to the same calendar day', () => {
+        const value = combine.bday([{ header: 'Birthday', checked: true, field: 'bday', value: 'Jun 9, 2022' }]);
+
+        expect(value.date instanceof Date).toBe(true);
+        expect([value.date.getFullYear(), value.date.getMonth(), value.date.getDate()]).toEqual([2022, 5, 9]);
+        expect(serialize({ bday: { field: 'bday', value, uid: 'birthday' } })).toContain('BDAY:20220609');
+    });
+
+    it('keeps an unparseable birthday as text', () => {
+        expect(combine.bday([{ header: 'Birthday', checked: true, field: 'bday', value: 'unknown' }])).toEqual({
+            text: 'unknown',
+        });
+    });
+});
