+    def test_hosts_derive_name_without_changing_input(self):
+        data = {'hosts': ['web', 'db']}
+        play = Play.load(data)
+
+        self.assertEqual(play.get_name(), 'web,db')
+        self.assertNotIn('name', data)
+        play.hosts = ['other']
+        self.assertEqual(play.get_name(), 'other')
+
+    def test_explicit_name_overrides_hosts(self):
+        play = Play.load({'name': 'deployment', 'hosts': ['web', 'db']})
+        self.assertEqual(play.get_name(), 'deployment')
+
+    def test_invalid_hosts_raise_parser_error(self):
+        cases = (
+            (None, "Hosts list cannot be empty. Please check your playbook"),
+            ([], "Hosts list cannot be empty. Please check your playbook"),
+            ([None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['web', None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['web', {'bad': 'host'}], "Hosts list contains an invalid host value: '{'bad': 'host'}'"),
+            (['web', 3], "Hosts list contains an invalid host value: '3'"),
+            ({'bad': 'host'}, "Hosts list must be a sequence or string. Please check your playbook."),
+            (3, "Hosts list must be a sequence or string. Please check your playbook."),
+        )
+        for hosts, message in cases:
+            with self.subTest(hosts=hosts):
+                with self.assertRaises(AnsibleParserError) as error:
+                    Play.load({'hosts': hosts})
+                self.assertIn(message, str(error.exception))
+
+    def test_hosts_sequence_accepts_tuple(self):
