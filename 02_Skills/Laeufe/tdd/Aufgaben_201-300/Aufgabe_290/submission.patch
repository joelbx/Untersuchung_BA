+import { logger } from 'matrix-js-sdk/src/logger';
+
+import SettingsStore from '../../settings/SettingsStore';
+
+export function handleEvent(e: Event): void {
+    const details = { id: (e.currentTarget as HTMLMediaElement)?.id, type: e.type };
+    switch (e.type) {
+        case 'error':
+        case 'abort':
+        case 'stalled':
+            logger.error('Legacy call audio error', details);
+            break;
+        case 'play':
+        case 'playing':
+        case 'pause':
+        case 'ended':
+        case 'waiting':
+        case 'canplay':
+            if (SettingsStore.getValue('debug_legacy_call_handler')) {
+                logger.debug('Legacy call audio event', details);
+            }
+            break;
+    }
+}
