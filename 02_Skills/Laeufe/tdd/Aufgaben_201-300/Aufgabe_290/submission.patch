+
+import { logger } from 'matrix-js-sdk/src/logger';
+
+import { handleEvent } from '../src/legacy/LegacyCallHandler/handleEvent';
+import SettingsStore from '../src/settings/SettingsStore';
+
+describe('legacy call media event listener', () => {
+    afterEach(() => jest.restoreAllMocks());
+
+    it.each(['error', 'abort', 'stalled'])('logs %s with the media element id', type => {
+        const audio = document.createElement('audio');
+        audio.id = 'ringAudio';
+        const log = jest.spyOn(logger, 'error').mockImplementation(() => {});
+        audio.addEventListener(type, handleEvent);
+
+        audio.dispatchEvent(new Event(type));
+
+        expect(log).toHaveBeenCalledWith(expect.any(String), { id: 'ringAudio', type });
+    });
+
+    it('provides a disabled debug setting for media events', () => {
+        expect(() => SettingsStore.getValue('debug_legacy_call_handler')).not.toThrow();
+        expect(SettingsStore.getValue('debug_legacy_call_handler')).toBe(false);
+    });
+
+    it.each(['play', 'playing', 'pause', 'ended', 'waiting', 'canplay'])(
+        'logs %s when call handler debugging is enabled', type => {
+            const audio = document.createElement('audio');
+            audio.id = 'ringbackAudio';
+            const log = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+            jest.spyOn(SettingsStore, 'getValue').mockReturnValue(true);
+            audio.addEventListener(type, handleEvent);
+
+            audio.dispatchEvent(new Event(type));
+
+            expect(log).toHaveBeenCalledWith(expect.any(String), { id: 'ringbackAudio', type });
+        },
+    );
+
+    it('does not log debug events with debugging disabled', () => {
+        const audio = document.createElement('audio');
+        const log = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+        audio.addEventListener('play', handleEvent);
+
+        audio.dispatchEvent(new Event('play'));
+
+        expect(log).not.toHaveBeenCalled();
+    });
+
+    it('ignores unrelated events', () => {
+        const audio = document.createElement('audio');
+        const logError = jest.spyOn(logger, 'error').mockImplementation(() => {});
+        const logDebug = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+        audio.addEventListener('click', handleEvent);
+
+        audio.dispatchEvent(new Event('click'));
+
+        expect(logError).not.toHaveBeenCalled();
+        expect(logDebug).not.toHaveBeenCalled();
+    });
+});
