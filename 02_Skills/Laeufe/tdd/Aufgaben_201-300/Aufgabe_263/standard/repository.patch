+// migrateFieldsMapWithRetry resumes after transient DynamoDB or backend errors.
+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		if err := l.migrateFieldsMap(ctx); err == nil {
+			return
+		} else {
+			l.WithError(err).Error("FieldsMap migration failed; retrying")
+		}
+		select {
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// migrateFieldsMap converts legacy rows in batches. A consistent scan and the
+// absence filter allow a subsequent run to pick up every unfinished row.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		var startKey map[string]*dynamodb.AttributeValue
+		processed := 0
+		for {
+			if err := ctx.Err(); err != nil {
+				return trace.Wrap(err)
+			}
+			out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName:         aws.String(l.Tablename),
+				ConsistentRead:    aws.Bool(true),
+				ExclusiveStartKey: startKey,
+				Limit:             aws.Int64(DynamoBatchSize),
+				FilterExpression:  aws.String("attribute_exists(Fields) AND attribute_not_exists(FieldsMap)"),
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			batch := make([]*dynamodb.WriteRequest, 0, len(out.Items))
+			for _, item := range out.Items {
+				changed, err := migrateFieldsItem(item)
+				if err != nil {
+					l.WithError(err).WithField("key", map[string]*dynamodb.AttributeValue{keySessionID: item[keySessionID], keyEventIndex: item[keyEventIndex]}).Error("Failed to convert event Fields")
+					return trace.Wrap(err)
+				}
+				if changed {
+					batch = append(batch, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+				}
+			}
+			if len(batch) != 0 {
+				if err := l.uploadBatch(ctx, batch); err != nil {
+					return trace.Wrap(err)
+				}
+				processed += len(batch)
+				if processed%DynamoBatchSize == 0 {
+					l.Infof("Migrated %d events to FieldsMap", processed)
+				}
+			}
+			startKey = out.LastEvaluatedKey
+			if len(startKey) == 0 {
+				l.Infof("FieldsMap migration complete: %d events converted", processed)
+				return nil
+			}
+		}
+	})
+}
