+// fieldsAttribute converts the JSON representation into DynamoDB's native map.
+// UseNumber preserves integers that cannot be represented exactly by float64.
+func fieldsAttribute(data []byte) (*dynamodb.AttributeValue, error) {
+	var fields map[string]interface{}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var trailing interface{}
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		return nil, trace.BadParameter("event fields contain trailing JSON: %v", err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	encoder := dynamodbattribute.NewEncoder(func(e *dynamodbattribute.Encoder) {
+		e.NullEmptyString = false
+	})
+	return encoder.Encode(convertNumbers(fields, true))
+}
+
+func convertNumbers(value interface{}, toDynamo bool) interface{} {
+	switch v := value.(type) {
+	case json.Number:
+		if toDynamo {
+			return dynamodbattribute.Number(v)
+		}
+	case dynamodbattribute.Number:
+		if !toDynamo {
+			return json.Number(v)
+		}
+	case map[string]interface{}:
+		for key, child := range v {
+			v[key] = convertNumbers(child, toDynamo)
+		}
+	case []interface{}:
+		for i, child := range v {
+			v[i] = convertNumbers(child, toDynamo)
+		}
+	}
+	return value
+}
+
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	fields, err := fieldsAttribute([]byte(e.Fields))
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item["FieldsMap"] = fields
+	delete(item, "Fields")
+	return item, nil
+}
+
+// fieldsJSON reads either format while older nodes are still writing Fields.
+func fieldsJSON(item map[string]*dynamodb.AttributeValue) ([]byte, error) {
+	if fields := item["FieldsMap"]; fields != nil {
+		var value map[string]interface{}
+		decoder := dynamodbattribute.NewDecoder(func(d *dynamodbattribute.Decoder) { d.UseNumber = true })
+		if err := decoder.Decode(fields, &value); err != nil {
+			return nil, trace.Wrap(err)
+		}
+		if value == nil {
+			return nil, trace.BadParameter("FieldsMap is not a map")
+		}
+		return json.Marshal(convertNumbers(value, false))
+	}
+	if fields := item["Fields"]; fields != nil && fields.S != nil {
+		return []byte(*fields.S), nil
+	}
+	return nil, trace.BadParameter("event has neither FieldsMap nor Fields")
+}
+
+// migrateFieldsItem changes one legacy record without touching its keys or other metadata.
+func migrateFieldsItem(item map[string]*dynamodb.AttributeValue) (bool, error) {
+	if item["FieldsMap"] != nil {
+		return false, nil
+	}
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return false, trace.BadParameter("event has no legacy Fields string")
+	}
+	fields, err := fieldsAttribute([]byte(*legacy.S))
+	if err != nil {
+		return false, trace.Wrap(err)
+	}
+	// Verify semantic equality before replacing the legacy attribute.
+	converted, err := fieldsJSON(map[string]*dynamodb.AttributeValue{"FieldsMap": fields})
+	if err != nil {
+		return false, trace.Wrap(err)
+	}
+	var before, after interface{}
+	decode := func(data []byte, target *interface{}) error {
+		d := json.NewDecoder(bytes.NewReader(data))
+		d.UseNumber()
+		return d.Decode(target)
+	}
+	if err := decode([]byte(*legacy.S), &before); err != nil {
+		return false, trace.Wrap(err)
+	}
+	if err := decode(converted, &after); err != nil {
+		return false, trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		return false, trace.BadParameter("FieldsMap conversion changed event metadata")
+	}
+	item["FieldsMap"] = fields
+	delete(item, "Fields")
+	return true, nil
+}
