@@ -57,6 +57,61 @@ func TestMain(m *testing.M) {
 
 func TestDynamoevents(t *testing.T) { check.TestingT(t) }
 
+// A write that still serializes Fields as a string breaks DynamoDB field expressions.
+func TestEventFieldsUseDynamoMap(t *testing.T) {
+	e := event{Fields: `{"user":"alice","success":true,"nested":{"count":2}}`}
+	item, err := marshalEvent(e)
+	require.NoError(t, err)
+	require.Nil(t, item["Fields"])
+	require.Equal(t, "alice", aws.StringValue(item["FieldsMap"].M["user"].S))
+	require.Equal(t, "2", aws.StringValue(item["FieldsMap"].M["nested"].M["count"].N))
+}
+
+func TestMigrateFieldsItemPreservesMetadata(t *testing.T) {
+	item := map[string]*dynamodb.AttributeValue{
+		"SessionID": {S: aws.String("session")},
+		"Fields":    {S: aws.String(`{"user":"alice","count":9007199254740993,"nested":[true,null]}`)},
+	}
+	changed, err := migrateFieldsItem(item)
+	require.NoError(t, err)
+	require.True(t, changed)
+	require.Nil(t, item["Fields"])
+	require.Equal(t, "session", aws.StringValue(item["SessionID"].S))
+	require.Equal(t, "9007199254740993", aws.StringValue(item["FieldsMap"].M["count"].N))
+	data, err := fieldsJSON(item)
+	require.NoError(t, err)
+	var got, want interface{}
+	require.NoError(t, json.Unmarshal(data, &got))
+	require.NoError(t, json.Unmarshal([]byte(`{"user":"alice","count":9007199254740993,"nested":[true,null]}`), &want))
+	require.Equal(t, want, got)
+	changed, err = migrateFieldsItem(item)
+	require.NoError(t, err)
+	require.False(t, changed)
+}
+
+func TestMigrateFieldsItemRejectsMalformedJSON(t *testing.T) {
+	item := map[string]*dynamodb.AttributeValue{"Fields": {S: aws.String("{broken")}}
+	_, err := migrateFieldsItem(item)
+	require.Error(t, err)
+	require.Nil(t, item["FieldsMap"])
+}
+
+func TestMigrateFieldsItemRejectsTrailingJSON(t *testing.T) {
+	item := map[string]*dynamodb.AttributeValue{"Fields": {S: aws.String(`{"user":"alice"} {"user":"bob"}`)}}
+	_, err := migrateFieldsItem(item)
+	require.Error(t, err)
+	require.Nil(t, item["FieldsMap"])
+}
+
+func TestMigrateFieldsItemPreservesEmptyString(t *testing.T) {
+	item := map[string]*dynamodb.AttributeValue{"Fields": {S: aws.String(`{"reason":""}`)}}
+	changed, err := migrateFieldsItem(item)
+	require.NoError(t, err)
+	require.True(t, changed)
+	require.Equal(t, "", aws.StringValue(item["FieldsMap"].M["reason"].S))
+	require.Nil(t, item["FieldsMap"].M["reason"].NULL)
+}
