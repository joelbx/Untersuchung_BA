+                <PaymentVerificationModal
+                    mode={mode}
+                    payment={Payment}
+                    token={Token}
+                    onSubmit={resolve}
+                    onClose={reject}
+                    onProcess={() => {
+                        const abort = new AbortController();
+                        return {
+                            promise: process({ Token, api, ApprovalURL, ReturnHost, signal: abort.signal }),
+                            abort,
+                        };
+                    }}
+                />
+            );
+        });
+    return verify;
 };
