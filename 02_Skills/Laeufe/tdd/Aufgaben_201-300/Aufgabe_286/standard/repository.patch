diff --git a/cmd/flipt/main_test.go b/cmd/flipt/main_test.go
new file mode 100644
index 0000000..8fbb9c9
--- /dev/null
+++ b/cmd/flipt/main_test.go
@@ -0,0 +1,36 @@
+package main
+
+import (
+	"testing"
+
+	"go.flipt.io/flipt/internal/release"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+// Choosing the wrong Info field or logging the wrong update branch breaks this test.
+func TestReportUpdateStatusLogsReleaseInfo(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		info    release.Info
+		message string
+		field   string
+		value   string
+	}{
+		{"latest", release.Info{CurrentVersion: "v1.2.3", LatestVersion: "v1.2.3"}, "running latest version", "version", "v1.2.3"},
+		{"update", release.Info{CurrentVersion: "v1.2.3", LatestVersion: "v1.3.0", LatestVersionURL: "https://example.com/v1.3.0", UpdateAvailable: true}, "newer version available", "version", "v1.3.0"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			core, observed := observer.New(zapcore.InfoLevel)
+			reportUpdateStatus(zap.New(core), false, tc.info)
+			entries := observed.All()
+			if len(entries) != 1 || entries[0].Message != tc.message || entries[0].ContextMap()[tc.field] != tc.value {
+				t.Fatalf("status logs = %+v", entries)
+			}
+			if tc.info.UpdateAvailable && entries[0].ContextMap()["url"] != tc.info.LatestVersionURL {
+				t.Fatalf("update URL = %v", entries[0].ContextMap()["url"])
+			}
+		})
+	}
+}
diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..8ad876f
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,64 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Check retrieves the latest release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	info, err := checkWithClient(ctx, version, github.NewClient(nil))
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func checkWithClient(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+	if latest == nil {
+		return info, fmt.Errorf("getting latest release: empty response")
+	}
+	parsed, err := semver.ParseTolerant(latest.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+	info.LatestVersion = latest.GetTagName()
+	info.LatestVersionURL = latest.GetHTMLURL()
+	info.UpdateAvailable = current.LT(parsed)
+	return info, nil
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" || version == "dev" || strings.Contains(version, "-rc") {
+		return false
+	}
+	for _, suffix := range []string{"-dev", "-snapshot"} {
+		if strings.HasSuffix(version, suffix) || strings.Contains(version, suffix+".") {
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..fdc5e6c
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,67 @@
+package release
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+)
+
+// A suffix check that omits rc would make the release-candidate cases fail.
+func TestIsExcludesPrereleaseBuilds(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"dev", false},
+		{"v1.2.3-dev", false},
+		{"v1.2.3-snapshot", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-rc1", false},
+		{"", false},
+		{"v1.2.3", true},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			if got := Is(tc.version); got != tc.want {
+				t.Fatalf("Is(%q) = %t, want %t", tc.version, got, tc.want)
+			}
+		})
+	}
+}
+
+// Comparing against the current version incorrectly would make the older-release case fail.
+func TestCheckWithClientReportsUpdateStatus(t *testing.T) {
+	for _, tc := range []struct {
+		name, current, latest, url string
+		update                     bool
+	}{
+		{"newer", "v1.2.3", "v1.3.0", "https://example.com/v1.3.0", true},
+		{"same", "v1.2.3", "v1.2.3", "https://example.com/v1.2.3", false},
+		{"older", "v1.3.0", "v1.2.3", "https://example.com/v1.2.3", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+					t.Errorf("request path = %q", r.URL.Path)
+				}
+				_ = json.NewEncoder(w).Encode(map[string]string{"tag_name": tc.latest, "html_url": tc.url})
+			}))
+			defer server.Close()
+
+			client := github.NewClient(server.Client())
+			client.BaseURL, _ = url.Parse(server.URL + "/")
+			got, err := checkWithClient(context.Background(), tc.current, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tc.current || got.LatestVersion != tc.latest || got.LatestVersionURL != tc.url || got.UpdateAvailable != tc.update {
+				t.Fatalf("checkWithClient() = %+v", got)
+			}
+		})
+	}
+}
