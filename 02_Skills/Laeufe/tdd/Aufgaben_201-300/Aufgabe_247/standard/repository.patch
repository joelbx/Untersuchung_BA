diff --git a/test/topic-votes-tooltip.js b/test/topic-votes-tooltip.js
new file mode 100644
index 0000000..7957862
--- /dev/null
+++ b/test/topic-votes-tooltip.js
@@ -0,0 +1,50 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+describe('topic upvoter tooltip', () => {
+	it('uses the response cutoff and enables HTML in the tooltip', () => {
+		let enter;
+		let tooltipOptions;
+		let translated = false;
+		const el = {
+			title: '',
+			parent() { return this; },
+			parents() { return { attr: () => '123' }; },
+			attr(name, value) {
+				if (value !== undefined) this[name] = value;
+				return this[name];
+			},
+		};
+		const BootstrapTooltip = function (element, options) {
+			tooltipOptions = options;
+			this.show = () => {};
+		};
+		BootstrapTooltip.getInstance = () => null;
+		const context = {
+			$: value => value,
+			socket: {
+				emit(event, pids, callback) {
+					assert.strictEqual(event, 'posts.getUpvoters');
+					assert.deepStrictEqual(Array.from(pids), ['123']);
+					callback(null, [{ usernames: ['A', 'B', 'C', 'D', 'E'], otherCount: 2, cutoff: 8 }]);
+				},
+			},
+			define(name, dependencies, factory) {
+				const components = { get: () => ({ on(event, selector, fn) { if (event === 'mouseenter') enter = fn; } }) };
+				const translator = { translate: (key, callback) => { translated = true; callback('translated'); } };
+				const votes = factory(components, translator, {}, {}, {}, {}, { Tooltip: BootstrapTooltip });
+				votes.addVoteHandler();
+			},
+		};
+		const source = fs.readFileSync(path.join(__dirname, '../public/src/client/topic/votes.js'), 'utf8');
+		vm.runInNewContext(source, context);
+		enter.call(el);
+		assert.strictEqual(el.title, 'A, B, C, D, E');
+		assert.strictEqual(translated, false);
+		assert.strictEqual(tooltipOptions.html, true);
+	});
+});
