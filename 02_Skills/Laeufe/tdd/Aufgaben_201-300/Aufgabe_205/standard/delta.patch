 'use strict';
 
 const db = require('../database');
+const user = require('../user');
+const coreUtils = require('../utils');
 
 const utils = module.exports;
 
-// internal token management utilities only
+// Internal token management utilities only.
+utils.tokens = {};
 
-utils.log = async (token) => {
+utils.tokens.list = async () => {
+	const tokens = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await utils.tokens.get(tokens);
+};
+
+utils.tokens.get = async (tokens) => {
+	if (tokens === null || tokens === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const isArray = Array.isArray(tokens);
+	const ids = isArray ? tokens : [tokens];
+	if (ids.some(token => typeof token !== 'string' || !token)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!ids.length) {
+		return [];
+	}
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(ids.map(token => `token:${token}`)),
+		utils.tokens.getLastSeen(ids),
+	]);
+	const result = objects.map((object, index) => object && ({
+		uid: Number(object.uid),
+		description: object.description || '',
+		timestamp: Number(object.timestamp),
+		lastSeen: lastSeen[index],
+	}));
+	return isArray ? result : result[0];
+};
+
+utils.tokens.generate = async ({ uid, description } = {}) => {
+	const numericUid = Number(uid);
+	if (uid === null || uid === undefined || uid === '' || !Number.isFinite(numericUid) ||
+		(numericUid !== 0 && !await user.exists(numericUid))) {
+		throw new Error('[[error:no-user]]');
+	}
+	const token = coreUtils.generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, { uid: numericUid, description, timestamp });
+	await Promise.all([
+		db.sortedSetAdd('tokens:createtime', timestamp, token),
+		db.sortedSetAdd('tokens:uid', numericUid, token),
+	]);
+	return token;
+};
+
+utils.tokens.update = async (token, { description }) => {
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await utils.tokens.get(token);
+};
+
+utils.tokens.delete = async (token) => {
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'], token),
+	]);
+};
+
+utils.tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.tokens.getLastSeen = async (tokens) => {
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokens);
+	return scores.map(score => (score === null || !Number.isFinite(Number(score)) ? null : Number(score)));
+};
+
+utils.log = utils.tokens.log;
+utils.getLastSeen = utils.tokens.getLastSeen;
diff --git a/test/api-tokens.js b/test/api-tokens.js
new file mode 100644
index 0000000..f65caee
--- /dev/null
+++ b/test/api-tokens.js
@@ -0,0 +1,89 @@
+'use strict';
+
+const assert = require('assert');
+
+const db = require('./mocks/databasemock');
+const user = require('../src/user');
+const { tokens } = require('../src/api/utils');
+
+describe('API token utilities', () => {
+	const created = [];
+
+	afterEach(async () => {
+		await Promise.all(created.splice(0).map(token => tokens.delete(token)));
+	});
+
+	it('persists and hydrates a token with millisecond timestamps and indexed ownership', async () => {
+		const uid = await user.create({ username: `token-user-${Date.now()}` });
+		const before = Date.now();
+		const token = await tokens.generate({ uid, description: 'first' });
+		created.push(token);
+		const after = Date.now();
+
+		assert.strictEqual(typeof token, 'string');
+		const stored = await db.getObject(`token:${token}`);
+		assert.strictEqual(Number(stored.uid), uid);
+		assert.strictEqual(stored.description, 'first');
+		assert.ok(Number.isFinite(Number(stored.timestamp)));
+		assert.ok(Number(stored.timestamp) >= before && Number(stored.timestamp) <= after);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', token), Number(stored.timestamp));
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', token), uid);
+		assert.deepStrictEqual(await tokens.get(token), {
+			uid, description: 'first', timestamp: Number(stored.timestamp), lastSeen: null,
+		});
+	});
+
+	it('lists tokens by creation time and keeps get result shape aligned to input', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		const first = await tokens.generate({ uid: 0, description: 'earlier' });
+		const second = await tokens.generate({ uid: 0, description: 'later' });
+		created.push(first, second);
+		await db.sortedSetAdd('tokens:createtime', 1, first);
+		await db.sortedSetAdd('tokens:createtime', 2, second);
+
+		const got = await tokens.get([second, first]);
+		assert.strictEqual(got.length, 2);
+		assert.strictEqual(got[0].description, 'later');
+		assert.strictEqual(got[1].description, 'earlier');
+		assert.deepStrictEqual((await tokens.list()).map(item => item.description), ['earlier', 'later']);
+	});
+
+	it('updates description, records usage, and deletes all token state', async () => {
+		const token = await tokens.generate({ uid: 0, description: 'old' });
+		created.push(token);
+		const beforeUpdate = await tokens.get(token);
+		const beforeLog = Date.now();
+		await tokens.log(token);
+		const afterLog = Date.now();
+		const updated = await tokens.update(token, { description: 'new' });
+		assert.strictEqual(updated.description, 'new');
+		assert.strictEqual(updated.uid, beforeUpdate.uid);
+		assert.strictEqual(updated.timestamp, beforeUpdate.timestamp);
+		assert.ok(updated.lastSeen >= beforeLog && updated.lastSeen <= afterLog);
+		assert.deepStrictEqual(await tokens.getLastSeen([token, 'never-seen']), [updated.lastSeen, null]);
+		await tokens.delete(token);
+		created.pop();
+		assert.strictEqual(await db.getObject(`token:${token}`), null);
+		const scores = await Promise.all(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen']
+			.map(key => db.sortedSetScore(key, token)));
+		assert.deepStrictEqual(scores, [null, null, null]);
+	});
+
+	it('rejects token creation for a missing nonzero user', async () => {
+		await assert.rejects(tokens.generate({ uid: 999999999 }), /\[\[error:no-user\]\]/);
+	});
+
+	it('rejects missing or nonnumeric owners without creating a token', async () => {
+		await assert.rejects(tokens.generate({}), /\[\[error:no-user\]\]/);
+		await assert.rejects(tokens.generate({ uid: null }), /\[\[error:no-user\]\]/);
+		await assert.rejects(tokens.generate({ uid: 'not-a-number' }), /\[\[error:no-user\]\]/);
+		assert.deepStrictEqual(await tokens.list(), []);
+	});
+
+	it('rejects token lookup inputs that are not strings or arrays of strings', async () => {
+		await assert.rejects(tokens.get(0), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get(['valid', null]), /\[\[error:invalid-data\]\]/);
+	});
+});
