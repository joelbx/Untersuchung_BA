+	got := getCveContents("CVE-2024-0002", vul)
+	for _, tc := range []struct {
+		source   models.CveContentType
+		severity string
+		score    float64
+	}{{"trivy:debian", "LOW", 3.1}, {"trivy:ubuntu", "MEDIUM", 5.2}} {
