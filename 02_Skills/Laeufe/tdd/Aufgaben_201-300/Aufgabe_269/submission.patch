diff --git a/contrib/trivy/pkg/converter_test.go b/contrib/trivy/pkg/converter_test.go
new file mode 100644
index 0000000..d5c8d38
--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,75 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+// Replacing source keyed contents with one Trivy entry must break this test.
+func TestConvertPreservesSourceScoresAcrossTargets(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	base := dbtypes.Vulnerability{Title: "title", Description: "description", References: []string{"https://example.org/advisory"}, PublishedDate: &published, LastModifiedDate: &modified,
+		VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "ubuntu": dbtypes.SeverityMedium},
+		CVSS:           dbtypes.VendorCVSS{"debian": {V3Score: 3.1, V3Vector: "CVSS:3.1/debian"}, "ubuntu": {V3Score: 5.2, V3Vector: "CVSS:3.1/ubuntu"}},
+	}
+	results := types.Results{
+		{Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-2024-0001", Vulnerability: base}}},
+		{Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-2024-0001", Vulnerability: base}}},
+	}
+	got, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := got.ScannedCves["CVE-2024-0001"].CveContents
+	for _, tc := range []struct {
+		source   models.CveContentType
+		severity string
+		score    float64
+	}{{"trivy:debian", "LOW", 3.1}, {"trivy:ubuntu", "MEDIUM", 5.2}} {
+		entries := contents[tc.source]
+		if len(entries) != 1 {
+			t.Fatalf("%s: entries = %d", tc.source, len(entries))
+		}
+		c := entries[0]
+		if c.Type != tc.source || c.CveID != "CVE-2024-0001" || c.Cvss3Severity != tc.severity || c.Cvss3Score != tc.score || c.Published != published || c.LastModified != modified || len(c.References) != 1 {
+			t.Errorf("%s: content = %+v", tc.source, c)
+		}
+	}
+}
+
+// Assigning the selected vendor severity to a different CVSS source must break this test.
+func TestConvertDoesNotMisattributeSelectedSeverity(t *testing.T) {
+	results := types.Results{{Vulnerabilities: []types.DetectedVulnerability{{
+		VulnerabilityID: "CVE-2024-0003", SeveritySource: "debian",
+		Vulnerability: dbtypes.Vulnerability{Severity: "LOW", VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow}, CVSS: dbtypes.VendorCVSS{"nvd": {V3Score: 7.5}}},
+	}}}}
+	got, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nvd := got.ScannedCves["CVE-2024-0003"].CveContents["trivy:nvd"]
+	if len(nvd) != 1 || nvd[0].Cvss3Severity != "" {
+		t.Errorf("NVD content = %+v", nvd)
+	}
+}
+
+// Dropping the selected severity when only one CVSS source exists must break this test.
+func TestConvertUsesSelectedSeverityForSingleSource(t *testing.T) {
+	results := types.Results{{Vulnerabilities: []types.DetectedVulnerability{{
+		VulnerabilityID: "CVE-2024-0004",
+		Vulnerability:   dbtypes.Vulnerability{Severity: "HIGH", CVSS: dbtypes.VendorCVSS{"nvd": {V3Score: 8.1}}},
+	}}}}
+	got, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nvd := got.ScannedCves["CVE-2024-0004"].CveContents["trivy:nvd"]
+	if len(nvd) != 1 || nvd[0].Cvss3Severity != "HIGH" {
+		t.Errorf("NVD content = %+v", nvd)
+	}
+}
