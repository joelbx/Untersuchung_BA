+// Collapsing the vendor map into one severity must break this test.
+func TestGetCveContentsPreservesVendorSeverity(t *testing.T) {
+	published := time.Date(2024, 2, 3, 0, 0, 0, 0, time.UTC)
+	vul := dbtypes.Vulnerability{Title: "title", Description: "description", References: []string{"https://example.org"}, PublishedDate: &published,
