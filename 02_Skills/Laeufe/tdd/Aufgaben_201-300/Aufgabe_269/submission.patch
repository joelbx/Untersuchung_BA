+package models
+
+import "testing"
+
+// Omitting Trivy source keys from aggregation must break this test.
+func TestTrivySourceMetadataIsAggregated(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		"trivy:debian": {{Type: "trivy:debian", Title: "Debian title", Summary: "Debian summary", Cvss3Severity: "LOW", Cvss3Score: 3.1, Cvss2Score: 2.5}},
+		"trivy:ubuntu": {{Type: "trivy:ubuntu", Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "MEDIUM", Cvss3Score: 5.2}},
+	}}
+	if len(v.Titles("en", "trivy")) != 2 {
+		t.Errorf("titles: %v", v.Titles("en", "trivy"))
+	}
+	if len(v.Summaries("en", "trivy")) != 2 {
+		t.Errorf("summaries: %v", v.Summaries("en", "trivy"))
+	}
+	if len(v.Cvss2Scores()) != 1 || v.Cvss2Scores()[0].Value.Score != 2.5 {
+		t.Errorf("CVSS2: %v", v.Cvss2Scores())
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 || scores[0].Value.Score != 3.1 || scores[1].Value.Score != 5.2 {
+		t.Errorf("CVSS3: %v", scores)
+	}
+}
