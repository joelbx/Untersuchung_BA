+		const urls = await db.getObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url']);
+		const prefix = '/assets/uploads/files/';
+		const relativePrefix = `${nconf.get('relative_path') || ''}${prefix}`;
+		await Promise.all(['cover:url', 'cover:thumb:url'].map(async (field) => {
+			const url = urls[field];
