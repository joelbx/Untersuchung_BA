diff --git a/test/image-cleanup.js b/test/image-cleanup.js
new file mode 100644
index 0000000..d1d75da
--- /dev/null
+++ b/test/image-cleanup.js
@@ -0,0 +1,138 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs').promises;
+const os = require('os');
+const path = require('path');
+const nconf = require('nconf');
+
+if (!nconf.get('database')) {
+	nconf.use('memory');
+	nconf.set('database', 'redis');
+	nconf.set('base_dir', path.resolve(__dirname, '..'));
+	nconf.set('upload_path', path.join(os.tmpdir(), 'image-cleanup-bootstrap'));
+	nconf.set('relative_path', '');
+}
+const db = require('../src/database');
+
+const replaced = ['../src/image', '../src/plugins', '../src/meta'].map((name) => {
+	const id = require.resolve(name);
+	const previous = require.cache[id];
+	let exports = {};
+	if (name.endsWith('plugins')) {
+		exports = { hooks: { hasListeners: () => false } };
+	} else if (name.endsWith('meta')) {
+		exports = { config: {} };
+	}
+	require.cache[id] = { id: id, filename: id, loaded: true, exports: exports };
+	return { id, previous };
+});
+const pictureId = require.resolve('../src/user/picture');
+const groupCoverId = require.resolve('../src/groups/cover');
+const previousPicture = require.cache[pictureId];
+const previousGroupCover = require.cache[groupCoverId];
+const attachPicture = require('../src/user/picture');
+const attachGroupCover = require('../src/groups/cover');
+
+[
+	{ id: pictureId, previous: previousPicture },
+	{ id: groupCoverId, previous: previousGroupCover },
+	...replaced,
+].forEach(({ id, previous }) => {
+	if (previous) {
+		require.cache[id] = previous;
+	} else {
+		delete require.cache[id];
+	}
+});
+
+describe('local image cleanup', () => {
+	let root;
+	let previousUploadPath;
+	let previousRelativePath;
+	let previousDelete;
+	let previousGet;
+	let fields;
+	let user;
+	let groups;
+
+	beforeEach(async () => {
+		root = await fs.mkdtemp(path.join(os.tmpdir(), 'image-cleanup-'));
+		await fs.mkdir(path.join(root, 'profile'));
+		await fs.mkdir(path.join(root, 'files'));
+		previousUploadPath = nconf.get('upload_path');
+		previousRelativePath = nconf.get('relative_path');
+		nconf.set('upload_path', root);
+		nconf.set('relative_path', '/forum');
+		fields = {};
+		previousDelete = db.deleteObjectFields;
+		previousGet = db.getObjectFields;
+		db.deleteObjectFields = async (key, names) => { names.forEach((name) => { delete fields[name]; }); };
+		db.getObjectFields = async () => ({ ...fields });
+		user = {
+			getUserFields: async () => ({ ...fields }),
+			getUserField: async (uid, field) => fields[field],
+			setUserFields: async (uid, values) => { Object.assign(fields, values); },
+		};
+		attachPicture(user);
+		groups = {};
+		attachGroupCover(groups);
+	});
+
+	afterEach(async () => {
+		db.deleteObjectFields = previousDelete;
+		db.getObjectFields = previousGet;
+		nconf.set('upload_path', previousUploadPath);
+		nconf.set('relative_path', previousRelativePath);
+		await fs.rm(root, { recursive: true, force: true });
+	});
+
+	it('removes all uploaded avatar variants and retains an unrelated selected picture', async () => {
+		await Promise.all(['23-profileavatar.png', '23-profileavatar-123.jpeg', '23-profileavatar-456.jpg', '23-profileavatar-789.bmp'].map(
+			name => fs.writeFile(path.join(root, 'profile', name), 'image')
+		));
+		fields.uploadedpicture = '/forum/assets/uploads/profile/23-profileavatar-123.jpeg';
+		fields.picture = '/other.png';
+		const previous = await user.removeProfileImage(23);
+		assert.deepStrictEqual(previous, { uploadedpicture: '/forum/assets/uploads/profile/23-profileavatar-123.jpeg', picture: '/other.png' });
+		assert.deepStrictEqual(await fs.readdir(path.join(root, 'profile')), []);
+		assert.strictEqual(fields.uploadedpicture, '');
+		assert.strictEqual(fields.picture, '/other.png');
+	});
+
+	it('removes an uploaded avatar with a nonstandard local filename', async () => {
+		await fs.writeFile(path.join(root, 'profile', 'custom.jpg'), 'image');
+		fields.uploadedpicture = '/forum/assets/uploads/profile/custom.jpg';
+		fields.picture = fields.uploadedpicture;
+		await user.removeProfileImage(23);
+		assert.deepStrictEqual(await fs.readdir(path.join(root, 'profile')), []);
+		assert.strictEqual(fields.picture, '');
+	});
+
+	it('removes a custom avatar stored with the raw upload URL under a subpath', async () => {
+		await fs.writeFile(path.join(root, 'profile', 'raw.jpg'), 'image');
+		fields.uploadedpicture = '/assets/uploads/profile/raw.jpg';
+		fields.picture = fields.uploadedpicture;
+		await user.removeProfileImage(23);
+		assert.deepStrictEqual(await fs.readdir(path.join(root, 'profile')), []);
+	});
+
+	it('removes a group cover stored with the raw upload URL under a subpath', async () => {
+		await fs.writeFile(path.join(root, 'files', 'raw.png'), 'image');
+		fields['cover:url'] = '/assets/uploads/files/raw.png';
+		await groups.removeCover({ groupName: 'example' });
+		assert.deepStrictEqual(await fs.readdir(path.join(root, 'files')), []);
+	});
+
+	it('removes local group cover and thumb while leaving external paths alone', async () => {
+		await fs.writeFile(path.join(root, 'files', 'cover.png'), 'image');
+		await fs.writeFile(path.join(root, 'files', 'thumb.jpg'), 'image');
+		fields['cover:url'] = '/forum/assets/uploads/files/cover.png';
+		fields['cover:thumb:url'] = '/forum/assets/uploads/files/thumb.jpg';
+		fields['cover:position'] = '50% 50%';
+		await groups.removeCover({ groupName: 'example' });
+		assert.deepStrictEqual(await fs.readdir(path.join(root, 'files')), []);
+		assert.strictEqual(fields['cover:url'], undefined);
+		assert.strictEqual(fields['cover:thumb:url'], undefined);
+	});
+});
