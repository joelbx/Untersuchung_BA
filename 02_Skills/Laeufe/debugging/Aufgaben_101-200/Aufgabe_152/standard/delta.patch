+# Copyright: (c) 2026, Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat.mock import patch
+from units.modules.utils import set_module_args
+from .icx_module import TestICXModule
+from ansible.modules.network.icx import icx_logging
+
+
+class TestICXLogging(TestICXModule):
+    module = icx_logging
+
+    def setUp(self):
+        super(TestICXLogging, self).setUp()
+        self.config_patch = patch.object(icx_logging, 'get_config', return_value='')
+        self.load_patch = patch.object(icx_logging, 'load_config')
+        self.get_config = self.config_patch.start()
+        self.load_config = self.load_patch.start()
+
+    def tearDown(self):
+        self.config_patch.stop()
+        self.load_patch.stop()
+        super(TestICXLogging, self).tearDown()
+
+    def test_aggregate_host_facility(self):
+        self.get_config.return_value = 'logging host ipv6 2001:db8::1 udp-port 514\nlogging facility local7\n'
+        set_module_args({'aggregate': [
+            {'dest': 'host', 'name': '2001:db8::1', 'udp_port': 514, 'facility': 'local7'},
+            {'dest': 'host', 'name': '192.0.2.1', 'udp_port': 5514}]})
+        self.execute_module(changed=True, commands=['logging host 192.0.2.1 udp-port 5514'])
+
+    def test_host_removal_discovers_port(self):
+        self.get_config.return_value = 'logging host ipv6 2001:db8::1 udp-port 5514'
+        set_module_args({'dest': 'host', 'name': '2001:db8::1', 'state': 'absent'})
+        self.execute_module(changed=True, commands=['no logging host ipv6 2001:db8::1 udp-port 5514'])
+
+    def test_buffered_levels(self):
+        self.get_config.return_value = 'logging buffered\nno logging buffered debugging'
+        set_module_args({'dest': 'buffered', 'level': 'debugging'})
+        self.execute_module(changed=True, commands=['logging buffered debugging'])
+
+    def test_global_and_console_absent(self):
+        self.get_config.return_value = 'logging console'
+        set_module_args({'aggregate': [{'dest': 'console'}, {'dest': 'on'}], 'state': 'absent'})
+        self.execute_module(changed=True, commands=['no logging console', 'no logging on'])
+
+    def test_ipv6_add_and_idempotence(self):
+        set_module_args({'dest': 'host', 'name': '2001:db8::2', 'udp_port': 5514})
+        self.execute_module(changed=True, commands=['logging host ipv6 2001:db8::2 udp-port 5514'])
+        self.get_config.return_value = 'logging host ipv6 2001:db8::2 udp-port 5514'
+        self.execute_module(changed=False, commands=[])
+
+    def test_facility_clear_and_idempotence(self):
+        self.get_config.return_value = 'logging facility local7'
+        set_module_args({'facility': 'local7', 'state': 'absent'})
+        self.execute_module(changed=True, commands=['no logging facility'])
+        self.get_config.return_value = ''
+        self.execute_module(changed=False, commands=[])
+
+    def test_buffered_remove_only_enabled_level(self):
+        self.get_config.return_value = 'logging buffered\nno logging buffered debugging'
+        set_module_args({'dest': 'buffered', 'level': 'alerts', 'state': 'absent'})
+        self.execute_module(changed=True, commands=['no logging buffered alerts'])
+        set_module_args({'dest': 'buffered', 'level': 'debugging', 'state': 'absent'})
+        self.execute_module(changed=False, commands=[])
+
+    def test_rfc5424_and_persistence(self):
+        set_module_args({'aggregate': [{'dest': 'rfc5424'}, {'dest': 'persistence'}]})
+        self.execute_module(changed=True, commands=['logging enable rfc5424', 'logging persistence'])
+        self.get_config.return_value = 'logging enable rfc5424\nlogging persistence'
+        self.execute_module(changed=False, commands=[])
+
+    def test_required_parameters(self):
+        set_module_args({'dest': 'host'})
+        self.execute_module(failed=True)
+        set_module_args({'dest': 'buffered'})
+        self.execute_module(failed=True)
+
+    def test_check_mode(self):
+        set_module_args({'dest': 'console', '_ansible_check_mode': True})
+        self.execute_module(changed=True, commands=['logging console'])
+        self.load_config.assert_not_called()
+
+    def test_invalid_ipv6_rejected(self):
+        set_module_args({'dest': 'host', 'name': '2001:db8::invalid'})
+        self.execute_module(failed=True)
