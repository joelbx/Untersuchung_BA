new file mode 100644
index 0000000..c1221d2
--- /dev/null
+++ b/models/legacy_ports_test.go
@@ -0,0 +1,35 @@
+package models
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestLegacyAffectedProcessListenPortsJSON(t *testing.T) {
+	var p Package
+	err := json.Unmarshal([]byte(`{"AffectedProcs":[{"pid":"1","listenPorts":["127.0.0.1:22","*:80"]}]}`), &p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.AffectedProcs) != 1 || !reflect.DeepEqual(p.AffectedProcs[0].ListenPorts, []string{"127.0.0.1:22", "*:80"}) {
+		t.Fatalf("unexpected affected processes: %+v", p.AffectedProcs)
+	}
+	if p.AffectedProcs[0].ListenPortStats != nil {
+		t.Fatalf("legacy data unexpectedly populated port stats: %+v", p.AffectedProcs[0].ListenPortStats)
+	}
+}
+
+func TestPackageHasReachablePort(t *testing.T) {
+	if (Package{}).HasReachablePort() {
+		t.Fatal("empty package has reachable port")
+	}
+	p := Package{AffectedProcs: []AffectedProcess{{ListenPorts: []string{"*:22"}}, {ListenPortStats: []PortStat{{BindAddress: "*", Port: "22"}}}}}
+	if p.HasReachablePort() {
+		t.Fatal("unscanned port is reachable")
+	}
+	p.AffectedProcs[1].ListenPortStats[0].PortReachableTo = []string{"127.0.0.1"}
+	if !p.HasReachablePort() {
+		t.Fatal("reachable port not detected")
+	}
+}
