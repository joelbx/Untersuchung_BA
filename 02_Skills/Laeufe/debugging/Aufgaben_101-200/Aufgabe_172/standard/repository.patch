-// HasPortScanSuccessOn checks if Package.AffectedProcs has PortScanSuccessOn
-func (p Package) HasPortScanSuccessOn() bool {
+// NewPortStat parses an address and port, including bracketed IPv6 addresses.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	addr, port, err := net.SplitHostPort(ipPort)
+	if err != nil || addr == "" || port == "" {
+		return nil, xerrors.Errorf("invalid listening port %q: expected <ip>:<port>", ipPort)
+	}
+	if addr != "*" && net.ParseIP(addr) == nil {
+		return nil, xerrors.Errorf("invalid listening address %q", addr)
+	}
+	n, err := strconv.Atoi(port)
+	if err != nil || n < 0 || strings.HasPrefix(port, "+") {
+		return nil, xerrors.Errorf("invalid listening port %q", port)
+	}
+	if strings.HasPrefix(ipPort, "[") {
+		addr = "[" + addr + "]"
+	}
+	stat.BindAddress, stat.Port = addr, port
+	return stat, nil
+}
+
+// HasReachablePort reports whether any affected process has a reachable port.
