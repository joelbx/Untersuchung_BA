diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..7e33daa
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,113 @@
+package oci
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source builds filesystem snapshots from an OCI repository.
+type Source struct {
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+	logger   *zap.Logger
+	interval time.Duration
+	store    *fliptoci.Store
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+// NewSource constructs an OCI snapshot source.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if logger == nil || store == nil {
+		return nil, errors.New("OCI source requires a logger and store")
+	}
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, errors.New("OCI source poll interval must be positive")
+	}
+	return s, nil
+}
+
+// WithPollInterval configures the polling interval.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+// String identifies this source.
+func (*Source) String() string { return "oci" }
+
+// Get returns the current snapshot, reusing it when the manifest content is unchanged.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	snapshot, _, err := s.get(ctx)
+	return snapshot, err
+}
+
+func (s *Source) get(ctx context.Context) (*storagefs.StoreSnapshot, digest.Digest, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, "", err
+	}
+	if response.Matched && s.snapshot != nil {
+		s.logger.Debug("OCI snapshot unchanged", zap.Stringer("digest", s.digest))
+		return s.snapshot, s.digest, nil
+	}
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, "", err
+	}
+	s.snapshot = snapshot
+	s.digest = response.Digest
+	s.logger.Debug("updated OCI snapshot", zap.Stringer("digest", s.digest))
+	return snapshot, s.digest, nil
+}
+
+// Subscribe sends snapshots when the OCI manifest digest changes.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+
+	s.mu.Lock()
+	previous := s.digest
+	s.mu.Unlock()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snap, current, err := s.get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				continue
+			}
+			if current == previous {
+				continue
+			}
+			select {
+			case ch <- snap:
+				previous = current
+				s.logger.Debug("sent OCI snapshot", zap.Stringer("digest", current))
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
