+func TestMetadataConfiguration(t *testing.T) {
+	assert.True(t, Default().Metadata.CheckForUpdates)
+
+	for _, tt := range []struct {
+		name    string
+		suffix  string
+		content string
+	}{
+		{"yaml", ".yml", "metadata:\n  check_for_updates: false\n"},
+		{"json", ".json", `{"metadata":{"check_for_updates":false}}`},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			file, err := ioutil.TempFile(t.TempDir(), "config-*"+tt.suffix)
+			require.NoError(t, err)
+			_, err = file.WriteString(tt.content)
+			require.NoError(t, err)
+			require.NoError(t, file.Close())
+
+			cfg, err := Load(file.Name())
+			require.NoError(t, err)
+			assert.False(t, cfg.Metadata.CheckForUpdates)
+
+			encoded, err := json.Marshal(cfg)
+			require.NoError(t, err)
+			assert.Contains(t, string(encoded), `"metadata":{"checkForUpdates":false}`)
+
+			defaults, err := Load("./testdata/config/default.yml")
+			require.NoError(t, err)
+			assert.True(t, defaults.Metadata.CheckForUpdates)
+		})
+	}
+}
