+package commands
+
+import (
+	"flag"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestReportWpIgnoreInactiveFlag(t *testing.T) {
+	old := config.Conf
+	defer func() { config.Conf = old }()
+	config.Conf = config.Config{}
+	flags := flag.NewFlagSet("report", flag.ContinueOnError)
+	(&ReportCmd{}).SetFlags(flags)
+	if err := flags.Parse([]string{"-wp-ignore-inactive"}); err != nil {
+		t.Fatal(err)
+	}
+	if !config.Conf.WpIgnoreInactive {
+		t.Fatal("-wp-ignore-inactive did not enable the configuration")
+	}
+}
