diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..d1e3772
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,76 @@
+package wordpress
+
+import (
+	"io/ioutil"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+type requestRecorder struct{ paths []string }
+
+func (rec *requestRecorder) RoundTrip(req *http.Request) (*http.Response, error) {
+	rec.paths = append(rec.paths, req.URL.Path)
+	return &http.Response{StatusCode: http.StatusOK, Body: ioutil.NopCloser(strings.NewReader("{}")), Header: make(http.Header)}, nil
+}
+
+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	oldTransport := http.DefaultTransport
+	oldConf := config.Conf
+	defer func() { http.DefaultTransport = oldTransport; config.Conf = oldConf }()
+
+	for _, tc := range []struct {
+		enabled   bool
+		wantPaths []string
+		wantNames []string
+	}{
+		{false, []string{"/api/v3/wordpresses/60", "/api/v3/themes/active-theme", "/api/v3/themes/inactive-theme", "/api/v3/plugins/active-plugin", "/api/v3/plugins/inactive-plugin"}, []string{"core", "active-theme", "inactive-theme", "active-plugin", "inactive-plugin"}},
+		{true, []string{"/api/v3/wordpresses/60", "/api/v3/themes/active-theme", "/api/v3/plugins/active-plugin"}, []string{"core", "active-theme", "active-plugin"}},
+	} {
+		config.Conf.WpIgnoreInactive = tc.enabled
+		rec := &requestRecorder{}
+		http.DefaultTransport = rec
+		packages := models.WordPressPackages{
+			{Name: "core", Type: models.WPCore, Version: "6.0"},
+			{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+			{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+			{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+			{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		}
+		result := &models.ScanResult{WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+		if _, err := FillWordPress(result, "token"); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(rec.paths, tc.wantPaths) {
+			t.Errorf("enabled=%t paths=%v, want %v", tc.enabled, rec.paths, tc.wantPaths)
+		}
+		var names []string
+		for _, p := range *result.WordPressPackages {
+			names = append(names, p.Name)
+		}
+		if !reflect.DeepEqual(names, tc.wantNames) {
+			t.Errorf("enabled=%t names=%v, want %v", tc.enabled, names, tc.wantNames)
+		}
+	}
+}
+
+func TestRemoveInactives(t *testing.T) {
+	packages := models.WordPressPackages{
+		{Name: "core", Type: models.WPCore},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+	}
+	want := models.WordPressPackages{packages[0], packages[1], packages[3]}
+	if got := removeInactives(packages); !reflect.DeepEqual(got, want) {
+		t.Fatalf("removeInactives() = %#v, want %#v", got, want)
+	}
+	if got := removeInactives(models.WordPressPackages{packages[2], packages[4]}); got != nil {
+		t.Fatalf("removeInactives(all inactive) = %#v, want nil", got)
+	}
+}
