+type AdminActionLock = {
+    pending: boolean;
+    run(action: () => Promise<void>, title: string): Promise<void>;
+};
+
+function useAdminActionLockState(): AdminActionLock {
+    const [pending, setPending] = useState(false);
+    const locked = useRef(false);
+
+    const run = async (action: () => Promise<void>, title: string): Promise<void> => {
+        if (locked.current) return;
+        locked.current = true;
+        setPending(true);
+        try {
+            await action();
+        } catch (err) {
+            logger.error("Admin action failed", err);
+            Modal.createDialog(ErrorDialog, {
+                title,
+                description: err instanceof Error && err.message ? err.message : _t("Operation failed"),
+            });
+        } finally {
+            locked.current = false;
+            setPending(false);
+        }
+    };
+
+    return { pending, run };
+}
+
+const AdminActionLockContext = React.createContext<AdminActionLock | null>(null);
+
+function useAdminActionLock(): AdminActionLock {
+    const local = useAdminActionLockState();
+    return useContext(AdminActionLockContext) ?? local;
+}
