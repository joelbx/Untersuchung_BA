+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct{ typ, input, namespace, name, subpath string }{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"npm", "core", "", "core", ""},
+		{"maven", "artifact", "", "artifact", ""},
+		{"unknown", "raw/name", "", "raw/name", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typ+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typ, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Fatalf("got (%q, %q, %q), want (%q, %q, %q)", namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPURLNameParts(t *testing.T) {
+	tests := []struct {
+		typ         ftypes.LangType
+		input, want string
+	}{
+		{ftypes.Pom, "com.google.guava:guava", "pkg:maven/com.google.guava/guava@1.0?file_path=lock"},
+		{ftypes.Pip, "My_Package", "pkg:pypi/my-package@1.0?file_path=lock"},
+		{ftypes.GoModule, "github.com/protobom/protobom", "pkg:golang/github.com/protobom/protobom@1.0?file_path=lock"},
+		{ftypes.Npm, "@babel/core", "pkg:npm/%40babel/core@1.0?file_path=lock"},
+		{ftypes.Cocoapods, "GoogleUtilities/NSData+zlib", "pkg:cocoapods/GoogleUtilities@1.0?file_path=lock#NSData+zlib"},
+	}
+	for _, tt := range tests {
+		t.Run(string(tt.typ), func(t *testing.T) {
+			scanner := models.LibraryScanner{Type: tt.typ, LockfilePath: "lock", Libs: []models.Library{{Name: tt.input, Version: "1.0"}}}
+			got := libpkgToCdxComponents(scanner, map[string]map[string]string{"lock": {}})[1].PackageURL
+			if got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestDependencyGraphPURLNameParts(t *testing.T) {
+	tests := []struct{ filename, input, want string }{
+		{"pom.xml", "com.google.guava:guava", "pkg:maven/com.google.guava/guava@1.0?file_path=pom.xml&repo_url=repo"},
+		{"go.mod", "github.com/protobom/protobom", "pkg:golang/github.com/protobom/protobom@1.0?file_path=go.mod&repo_url=repo"},
+		{"package.json", "@babel/core", "pkg:npm/%40babel/core@1.0?file_path=package.json&repo_url=repo"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			m := models.DependencyGraphManifest{Filename: tt.filename, Repository: "repo", Dependencies: []models.Dependency{{PackageName: tt.input, Requirements: "= 1.0"}}}
+			got := ghpkgToCdxComponents(m, map[string]map[string]string{m.RepoURLFilename(): {}})[1].PackageURL
+			if got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
