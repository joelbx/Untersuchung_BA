@@ -0,0 +1,59 @@
+import { Message } from '@proton/shared/lib/interfaces/mail/Message';
+
+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { optimisticMarkAs } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+
+describe('optimistic mark-as bypass filter', () => {
+    const message = { ID: 'message', ConversationID: 'conversation' } as Message;
+
+    it.each([
+        [1, MARK_AS_STATUS.UNREAD],
+        [0, MARK_AS_STATUS.READ],
+    ])('removes an existing bypass when filter %s matches %s', (unreadFilter, markAsStatus) => {
+        const state = newState({ params: { filter: { Unread: unreadFilter } } });
+        state.bypassFilter = ['message', 'other'];
+
+        const result = elementsReducer(
+            state,
+            optimisticMarkAs({ elements: [message], bypass: true, markAsStatus, conversationMode: false })
+        );
+
+        expect(result.bypassFilter).toEqual(['other']);
+    });
+
+    it('removes the conversation ID when in conversation mode', () => {
+        const state = newState({ params: { filter: { Unread: 1 } } });
+        state.bypassFilter = ['conversation'];
+
+        const result = elementsReducer(
+            state,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+                conversationMode: true,
+            })
+        );
+
+        expect(result.bypassFilter).toEqual([]);
+    });
+
+    it('adds a bypass once when mark-as status differs from the filter', () => {
+        const state = newState({ params: { filter: { Unread: 1 } } });
+
+        const action = optimisticMarkAs({ elements: [message], bypass: true, markAsStatus: MARK_AS_STATUS.READ });
+        const result = elementsReducer(elementsReducer(state, action), action);
+
+        expect(result.bypassFilter).toEqual(['message']);
+    });
+
+    it('leaves bypass IDs alone when no mark-as status is provided', () => {
+        const state = newState({ params: { filter: { Unread: 1 } } });
+        state.bypassFilter = ['other'];
+
+        const result = elementsReducer(state, optimisticMarkAs({ elements: [message], bypass: true }));
+
+        expect(result.bypassFilter).toEqual(['other']);
+    });
+});
