+@pytest.mark.parametrize('manifest_yaml, expected', [('', Sentinel), ('manifest: {}', {}), ('manifest: null', None)])
+def test_manifest_metadata_preserves_presence(tmp_path, manifest_yaml, expected):
+    galaxy_yml = tmp_path / 'galaxy.yml'
+    galaxy_yml.write_text('namespace: namespace\nname: collection\nauthors: Jordan\n'
+                          'version: 0.1.0\nreadme: README.md\n' + manifest_yaml)
+
+    metadata = collection.concrete_artifact_manager._get_meta_from_src_dir(to_bytes(str(tmp_path)))
+    if expected is Sentinel:
+        assert metadata['manifest'] is Sentinel
+    else:
+        assert metadata['manifest'] == expected
+
+
+def test_manifest_control_sentinel_uses_walk_and_build_ignore(tmp_path):
+    (tmp_path / 'included.txt').write_text('included')
+    (tmp_path / 'ignored.txt').write_text('ignored')
+    manifest = collection._build_files_manifest(to_bytes(str(tmp_path)), 'namespace', 'collection',
+                                                ['ignored.txt'], Sentinel)
+
+    assert manifest['format'] == 1
+    assert [entry['name'] for entry in manifest['files']] == ['.', 'included.txt']
+
+
+def test_manifest_control_sentinel_excludes_external_file_symlink(tmp_path):
+    collection_dir = tmp_path / 'collection'
+    collection_dir.mkdir()
+    outside_file = tmp_path / 'outside.txt'
+    outside_file.write_text('outside')
+    (collection_dir / 'outside-link.txt').symlink_to(outside_file)
+
+    manifest = collection._build_files_manifest(to_bytes(str(collection_dir)), 'namespace', 'collection',
+                                                [], Sentinel)
+
+    assert [entry['name'] for entry in manifest['files']] == ['.']
+
+
+@pytest.mark.parametrize('manifest_control', [{}, None])
+def test_explicit_minimal_manifest_uses_distlib(tmp_path, monkeypatch, manifest_control):
+    expected = {'format': 1, 'files': []}
+    build_distlib = MagicMock(return_value=expected)
+    monkeypatch.setattr(collection, '_build_files_manifest_distlib', build_distlib)
+
+    actual = collection._build_files_manifest(to_bytes(str(tmp_path)), 'namespace', 'collection',
+                                              [], manifest_control)
+
+    assert actual == expected
+    assert build_distlib.call_args.args[-1] == {}
+
+
+@pytest.mark.parametrize('manifest_control', [{}, None])
+def test_explicit_minimal_manifest_conflicts_with_build_ignore(tmp_path, manifest_control):
+    with pytest.raises(AnsibleError, match='mutually exclusive'):
+        collection._build_files_manifest(to_bytes(str(tmp_path)), 'namespace', 'collection',
+                                         ['ignored.txt'], manifest_control)
+
