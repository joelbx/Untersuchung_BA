diff --git a/lib/multiplexer/teleport_proxy_test.go b/lib/multiplexer/teleport_proxy_test.go
new file mode 100644
index 0000000..bc21848
--- /dev/null
+++ b/lib/multiplexer/teleport_proxy_test.go
@@ -0,0 +1,68 @@
+package multiplexer
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestTeleportProxySSH(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		prefix string
+		addr   string
+	}{
+		{name: "client address", prefix: "Teleport-Proxy{\"clientAddr\":\"192.0.2.10:1234\"}\x00", addr: "192.0.2.10:1234"},
+		{name: "no client address", prefix: "Teleport-Proxy{\"tracingContext\":{\"key\":\"value\"}}\x00"},
+		{name: "plain SSH"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			mux, err := New(Config{Listener: listener, Context: context.Background()})
+			require.NoError(t, err)
+			sshListener := mux.SSH()
+			go mux.Serve()
+			defer mux.Close()
+
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			_, err = io.WriteString(client, tt.prefix+"SSH-2.0-test\r\n")
+			require.NoError(t, err)
+
+			accepted := make(chan net.Conn, 1)
+			go func() {
+				conn, err := sshListener.Accept()
+				if err == nil {
+					accepted <- conn
+				}
+			}()
+			select {
+			case conn := <-accepted:
+				defer conn.Close()
+				require.NoError(t, conn.SetReadDeadline(time.Now().Add(time.Second)))
+				require.Equal(t, ProtoSSH, conn.(*Conn).Protocol())
+				want := tt.addr
+				if want == "" {
+					want = client.LocalAddr().String()
+				}
+				require.Equal(t, want, conn.RemoteAddr().String())
+				if tt.addr != "" {
+					_, ok := conn.RemoteAddr().(*net.TCPAddr)
+					require.True(t, ok)
+				}
+				buf := make([]byte, len("SSH-2.0-test\r\n"))
+				_, err = io.ReadFull(conn, buf)
+				require.NoError(t, err)
+				require.Equal(t, "SSH-2.0-test\r\n", string(buf))
+			case <-time.After(time.Second):
+				t.Fatal("SSH connection was not routed")
+			}
+		})
+	}
+}
