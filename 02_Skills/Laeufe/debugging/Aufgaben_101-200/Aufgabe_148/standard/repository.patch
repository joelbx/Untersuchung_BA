+// readTeleportProxyHeader consumes the metadata preceding an SSH version line.
+func readTeleportProxyHeader(reader *bufio.Reader) (*net.TCPAddr, error) {
+	if _, err := reader.Discard(len(teleportProxyPrefix)); err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Bound the metadata so a connection cannot keep the detector reading forever.
+	const maxPayloadSize = 64 * 1024
+	var payload bytes.Buffer
+	for i := 0; i < maxPayloadSize; i++ {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport proxy header")
+		}
+		if b == 0 {
+			var metadata sshutils.HandshakePayload
+			if err := json.Unmarshal(payload.Bytes(), &metadata); err != nil {
+				return nil, trace.Wrap(err, "invalid Teleport proxy header")
+			}
+			if metadata.ClientAddr == "" {
+				return nil, nil
+			}
+			addr, err := net.ResolveTCPAddr("tcp", metadata.ClientAddr)
+			if err != nil {
+				return nil, trace.Wrap(err, "invalid Teleport proxy client address")
+			}
+			return addr, nil
+		}
+		payload.WriteByte(b)
+	}
+	return nil, trace.BadParameter("Teleport proxy header exceeds %d bytes", maxPayloadSize)
+}
