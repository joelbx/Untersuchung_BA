+    def get_sysinfo_facts(self):
+        """Read hardware identifiers from the s390 /proc/sysinfo file."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer': 'system_vendor',
+            'Type': 'product_name',
+            'Sequence Code': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            key, separator, value = line.partition(':')
+            if separator and key in fields:
+                value = value.strip()
+                if key == 'Sequence Code':
+                    value = value.lstrip('0')
+                sysinfo_facts[fields[key]] = value
+
+        return sysinfo_facts
