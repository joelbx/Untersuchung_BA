+func (s *AuthSuite) TestRemoteClusterHeartbeatAfterTunnelRemoval(c *C) {
+	const clusterName = "remote.example.com"
+	rc, err := services.NewRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	expires := time.Now().UTC().Add(time.Hour)
+	rc.SetExpiry(expires)
+	c.Assert(s.a.Presence.CreateRemoteCluster(rc), IsNil)
+
+	assertStatus := func(status string, heartbeat time.Time) {
+		cluster, err := s.a.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(cluster.GetConnectionStatus(), Equals, status)
+		c.Assert(cluster.GetLastHeartbeat().Equal(heartbeat), Equals, true)
+	}
+	assertStatus(teleport.RemoteClusterStatusOffline, time.Time{})
+
+	latest := time.Now().UTC()
+	older := latest.Add(-time.Second)
+	for _, entry := range []struct {
+		name string
+		when time.Time
+	}{
+		{"older", older},
+		{"latest", latest},
+	} {
+		conn, err := services.NewTunnelConnection(entry.name, services.TunnelConnectionSpecV2{
+			ClusterName: clusterName, ProxyName: "proxy", LastHeartbeat: entry.when,
+		})
+		c.Assert(err, IsNil)
+		c.Assert(s.a.Presence.UpsertTunnelConnection(conn), IsNil)
+		assertStatus(teleport.RemoteClusterStatusOnline, entry.when)
+	}
+	latest = latest.Add(time.Second)
+	updated, err := services.NewTunnelConnection("latest", services.TunnelConnectionSpecV2{
+		ClusterName: clusterName, ProxyName: "proxy", LastHeartbeat: latest,
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.Presence.UpsertTunnelConnection(updated), IsNil)
+	assertStatus(teleport.RemoteClusterStatusOnline, latest)
+
+	stored, err := s.a.Presence.GetRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	c.Assert(stored.GetConnectionStatus(), Equals, teleport.RemoteClusterStatusOnline)
+	c.Assert(stored.GetLastHeartbeat().Equal(latest), Equals, true)
+
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, "latest"), IsNil)
+	assertStatus(teleport.RemoteClusterStatusOnline, latest)
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, "older"), IsNil)
+	assertStatus(teleport.RemoteClusterStatusOffline, latest)
+
+	stored, err = s.a.Presence.GetRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	c.Assert(stored.GetConnectionStatus(), Equals, teleport.RemoteClusterStatusOffline)
+	c.Assert(stored.GetLastHeartbeat().Equal(latest), Equals, true)
+	item, err := s.bk.Get(context.Background(), backend.Key("remoteClusters", clusterName))
+	c.Assert(err, IsNil)
+	c.Assert(item.Expires.Equal(expires), Equals, true)
+}
