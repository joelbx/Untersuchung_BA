+func TestLoadExplicitDeprecations(t *testing.T) {
+	for _, tt := range []struct {
+		name, content, warning string
+	}{
+		{"ui false", "ui:\n  enabled: false\n", `"ui.enabled" is deprecated and will be removed in a future version.`},
+		{"ui true", "ui:\n  enabled: true\n", `"ui.enabled" is deprecated and will be removed in a future version.`},
+		{"cache false", "cache:\n  memory:\n    enabled: false\n", `"cache.memory.enabled" is deprecated and will be removed in a future version. Please use 'cache.backend' and 'cache.enabled' instead.`},
+		{"expiration only", "cache:\n  memory:\n    expiration: 10s\n", `"cache.memory.expiration" is deprecated and will be removed in a future version. Please use 'cache.ttl' instead.`},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(tt.content), 0600))
+			result, err := Load(path)
+			require.NoError(t, err)
+			assert.Contains(t, result.Warnings, tt.warning)
+		})
+	}
+}
