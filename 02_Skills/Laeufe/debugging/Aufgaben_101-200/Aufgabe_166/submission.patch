diff --git a/test/units/parsing/test_dataloader.py b/test/units/parsing/test_dataloader.py
index 188d149..c16588e 100644
--- a/test/units/parsing/test_dataloader.py
+++ b/test/units/parsing/test_dataloader.py
@@ -205,6 +205,33 @@ class TestDataLoaderWithVault(unittest.TestCase):
         real_file_path = self._loader.get_real_file(self.test_vault_data_path)
         self.assertTrue(os.path.exists(real_file_path))
 
+    def test_load_from_file_cache_none(self):
+        with patch.object(self._loader, '_get_file_contents', wraps=self._loader._get_file_contents) as read_file:
+            first = self._loader.load_from_file(self.test_vault_data_path, cache='none')
+            second = self._loader.load_from_file(self.test_vault_data_path, cache='none')
+
+        self.assertEqual(first, second)
+        self.assertEqual(read_file.call_count, 2)
+        self.assertEqual(self._loader._FILE_CACHE, {})
+
+    def test_load_from_file_cache_vaulted(self):
+        with patch.object(self._loader, '_get_file_contents', wraps=self._loader._get_file_contents) as read_file:
+            first = self._loader.load_from_file(self.test_vault_data_path, cache='vaulted')
+            second = self._loader.load_from_file(self.test_vault_data_path, cache='vaulted')
+
+        self.assertEqual(first, second)
+        self.assertEqual(read_file.call_count, 1)
+        self.assertIn(self._loader.path_dwim(self.test_vault_data_path), self._loader._FILE_CACHE)
+
+    def test_load_from_file_cache_vaulted_plain_file(self):
+        plain_file = os.path.join(os.path.dirname(__file__), 'fixtures', 'ajson.json')
+        with patch.object(self._loader, '_get_file_contents', wraps=self._loader._get_file_contents) as read_file:
+            self._loader.load_from_file(plain_file, cache='vaulted')
+            self._loader.load_from_file(plain_file, cache='vaulted')
+
+        self.assertEqual(read_file.call_count, 2)
+        self.assertEqual(self._loader._FILE_CACHE, {})
+
     def test_get_real_file_vault_no_vault(self):
         self._loader.set_vault_secrets(None)
         self.assertRaises(AnsibleParserError, self._loader.get_real_file, self.test_vault_data_path)
