+func TestSearchCacheNilValue(t *testing.T) {
+	cache := map[string]*string{"nil-entry": nil}
+	if value, ok := searchCache("nil-entry", cache); value != "" || ok {
+		t.Fatalf("nil cache value: got (%q, %v), want (\"\", false)", value, ok)
+	}
+	empty := ""
+	cache["empty"] = &empty
+	if value, ok := searchCache("empty", cache); value != "" || !ok {
+		t.Fatalf("empty cache value: got (%q, %v), want (\"\", true)", value, ok)
+	}
+}
