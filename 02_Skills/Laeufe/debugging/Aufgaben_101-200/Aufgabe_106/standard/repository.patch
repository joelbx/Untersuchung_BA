+func TestFillWordPressUsesServerIgnoreInactive(t *testing.T) {
+	previous := c.Conf
+	defer func() { c.Conf = previous }()
+	c.Conf.WpIgnoreInactive = false
+	c.Conf.Servers = map[string]c.ServerInfo{
+		"site": {WordPress: c.WordPressConf{IgnoreInactive: true}},
+	}
+	core, inactive, active := "{}", "not JSON", `{"plugin":{"vulnerabilities":[{"id":42,"fixed_in":"2.0"}]}}`
+	cache := map[string]*string{"60": &core, "disabled": &inactive, "enabled": &active, "disabled-theme": &inactive}
+	packages := models.WordPressPackages{
+		{Name: models.WPCore, Type: models.WPCore, Version: "6.0"},
+		{Name: "disabled", Type: models.WPPlugin, Status: "inactive", Version: "1.0"},
+		{Name: "enabled", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "disabled-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+	}
+	r := &models.ScanResult{
+		ServerName:        "site",
+		WordPressPackages: &packages,
+		ScannedCves:       models.VulnInfos{},
+	}
+	count, err := FillWordPress(r, "unused", cache)
+	if err != nil || count != 1 {
+		t.Fatalf("FillWordPress returned count=%d, err=%v; want count=1 with inactive plugin skipped", count, err)
+	}
+}
+
+func TestFillWordPressIncludesInactiveWhenServerSettingDisabled(t *testing.T) {
+	previous := c.Conf
+	defer func() { c.Conf = previous }()
+	c.Conf.WpIgnoreInactive = true
+	c.Conf.Servers = map[string]c.ServerInfo{
+		"site": {WordPress: c.WordPressConf{IgnoreInactive: false}},
+	}
+	core, theme := "{}", `{"theme":{"vulnerabilities":[{"id":43,"fixed_in":"2.0"}]}}`
+	cache := map[string]*string{"60": &core, "inactive-theme": &theme}
+	packages := models.WordPressPackages{
+		{Name: models.WPCore, Type: models.WPCore, Version: "6.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+	}
+	r := &models.ScanResult{
+		ServerName:        "site",
+		WordPressPackages: &packages,
+		ScannedCves:       models.VulnInfos{},
+	}
+	count, err := FillWordPress(r, "unused", cache)
+	if err != nil || count != 1 {
+		t.Fatalf("FillWordPress returned count=%d, err=%v; want inactive theme included", count, err)
+	}
+}
