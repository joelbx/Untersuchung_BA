diff --git a/test/backlinks-offline.js b/test/backlinks-offline.js
new file mode 100644
index 0000000..e69760b
--- /dev/null
+++ b/test/backlinks-offline.js
@@ -0,0 +1,96 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const vm = require('vm');
+const path = require('path');
+
+const sets = new Map();
+const eventLogs = new Map();
+const db = {
+	getSortedSetRange: async key => sets.get(key) || [],
+	getObjects: async keys => keys.map(key => eventLogs.get(key.slice('topicEvent:'.length))),
+	sortedSetAdd: async (key, score, value) => sets.set(key, [...(sets.get(key) || []), String(value)]),
+	sortedSetRemove: async (key, value) => sets.set(key, (sets.get(key) || []).filter(item => item !== String(value))),
+};
+const moduleObj = { exports: {} };
+const dependency = {
+	lodash: require('lodash'),
+	validator: require('validator'),
+	nconf: { get: () => 'https://forum.example' },
+	'../database': db,
+	'../user': {},
+	'../posts': {},
+	'../meta': { config: {} },
+	'../plugins': {},
+	'../../public/src/utils': {},
+};
+vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../src/topics/posts.js'), 'utf8'), {
+	module: moduleObj, require: name => dependency[name],
+});
+const topics = {
+	exists: async tid => ['2', '3'].includes(String(tid)),
+	events: {
+		log: async (tid, payload) => {
+			const id = String(eventLogs.size + 1);
+			eventLogs.set(id, payload);
+			sets.set(`topic:${tid}:events`, [...(sets.get(`topic:${tid}:events`) || []), id]);
+		},
+		purge: async (tid, ids) => {
+			assert(ids.length, 'must not purge an entire topic');
+			sets.set(`topic:${tid}:events`, (sets.get(`topic:${tid}:events`) || []).filter(id => !ids.includes(id)));
+			ids.forEach(id => eventLogs.delete(id));
+		},
+	},
+};
+moduleObj.exports(topics);
+
+(async () => {
+	assert.strictEqual(typeof topics.syncBacklinks, 'function');
+	await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+	await assert.rejects(topics.syncBacklinks({ pid: 1, tid: 2, uid: null, content: 'text' }), { message: '[[error:invalid-data]]' });
+	const post = {
+		pid: 8,
+		uid: 5,
+		tid: 1,
+		content: 'https://forum.example/topic/2/slug /topic/2 again /topic/1 self https://other.example/topic/3 /topic/99',
+	};
+	assert.strictEqual(await topics.syncBacklinks(post), 1);
+	assert.deepStrictEqual(sets.get('pid:8:backlinks'), ['2']);
+	assert.strictEqual(eventLogs.get('1').type, 'backlink');
+	assert.strictEqual(eventLogs.get('1').href, '/post/8');
+	assert.strictEqual(eventLogs.get('1').uid, 5);
+	assert.strictEqual(await topics.syncBacklinks(post), 0);
+	assert.strictEqual(await topics.syncBacklinks({ ...post, content: '/topic/3' }), 2);
+	assert.deepStrictEqual(sets.get('pid:8:backlinks'), ['3']);
+	assert.strictEqual(eventLogs.size, 1);
+	assert.strictEqual(await topics.syncBacklinks({ ...post, content: 'none' }), 1);
+	assert.deepStrictEqual(sets.get('pid:8:backlinks'), []);
+	assert.strictEqual(eventLogs.size, 0);
+
+	const eventsModule = { exports: {} };
+	const config = { topicBacklinks: 1 };
+	const eventDb = {
+		getSortedSetRangeWithScores: async () => [{ value: '1', score: Date.now() }],
+		getObjects: async () => [{ type: 'backlink', href: '/post/8', uid: 5 }],
+	};
+	const eventDependencies = {
+		lodash: require('lodash'),
+		'../database': eventDb,
+		'../user': { isPrivileged: async () => false, getUsersFields: async () => [{ uid: 5 }] },
+		'../posts': {},
+		'../categories': { getCategoriesFields: async () => [] },
+		'../plugins': {},
+		'../meta': { config },
+		'.': { exists: async () => true },
+	};
+	vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../src/topics/events.js'), 'utf8'), {
+		module: eventsModule, require: name => eventDependencies[name],
+	});
+	const events = eventsModule.exports;
+	assert.strictEqual(events._types.backlink.text, '[[topic:backlink]]');
+	assert.strictEqual((await events.get(2))[0].href, '/post/8');
+	config.topicBacklinks = 0;
+	assert.strictEqual((await events.get(2)).length, 0);
+	console.log('offline backlink synchronization passed');
+})().catch((err) => { console.error(err); process.exitCode = 1; });
