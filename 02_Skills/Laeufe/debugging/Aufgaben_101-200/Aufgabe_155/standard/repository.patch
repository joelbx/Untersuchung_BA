diff --git a/config/image_digest_test.go b/config/image_digest_test.go
new file mode 100644
index 0000000..a456bcb
--- /dev/null
+++ b/config/image_digest_test.go
@@ -0,0 +1,26 @@
+package config
+
+import "testing"
+
+func TestImageDigestReference(t *testing.T) {
+	cases := []struct {
+		image Image
+		full  string
+		err   string
+	}{
+		{Image{}, ":", "Invalid arguments : no image name"},
+		{Image{Name: "registry/app"}, "registry/app:", "Invalid arguments : no image tag and digest"},
+		{Image{Name: "registry/app", Tag: "v1"}, "registry/app:v1", ""},
+		{Image{Name: "registry/app", Digest: "sha256:abc"}, "registry/app@sha256:abc", ""},
+		{Image{Name: "registry/app", Tag: "v1", Digest: "sha256:abc"}, "registry/app@sha256:abc", "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tc := range cases {
+		if got := tc.image.GetFullName(); got != tc.full {
+			t.Errorf("GetFullName(%+v) = %q, want %q", tc.image, got, tc.full)
+		}
+		err := IsValidImage(tc.image)
+		if tc.err == "" && err != nil || tc.err != "" && (err == nil || err.Error() != tc.err) {
+			t.Errorf("IsValidImage(%+v) = %v, want %q", tc.image, err, tc.err)
+		}
+	}
+}
