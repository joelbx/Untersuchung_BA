+package scan
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestImageDigestInScanResult(t *testing.T) {
+	b := &base{ServerInfo: config.ServerInfo{
+		Image: config.Image{Name: "registry/app", Digest: "sha256:abc"},
+	}}
+	got := b.convertToModel().Image
+	if got.Name != "registry/app" || got.Tag != "" || got.Digest != "sha256:abc" {
+		t.Fatalf("image conversion lost digest: %+v", got)
+	}
+}
