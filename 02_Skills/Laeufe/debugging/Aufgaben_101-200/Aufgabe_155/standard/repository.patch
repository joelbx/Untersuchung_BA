diff --git a/report/image_digest_test.go b/report/image_digest_test.go
new file mode 100644
index 0000000..0f33e7f
--- /dev/null
+++ b/report/image_digest_test.go
@@ -0,0 +1,38 @@
+package report
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestEnsureUUIDsImageReference(t *testing.T) {
+	original := config.Conf
+	defer func() { config.Conf = original }()
+	for _, tc := range []struct {
+		name  string
+		image models.Image
+		key   string
+	}{
+		{"tag", models.Image{Name: "registry/app", Tag: "v1"}, "registry/app:v1@host"},
+		{"digest", models.Image{Name: "registry/app", Digest: "sha256:abc"}, "registry/app@sha256:abc@host"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config.Conf = config.Config{Servers: map[string]config.ServerInfo{"host": {ServerName: "host"}}}
+			path := filepath.Join(t.TempDir(), "config.toml")
+			if err := os.WriteFile(path, []byte(""), 0600); err != nil {
+				t.Fatal(err)
+			}
+			results := models.ScanResults{{ServerName: "host", Image: tc.image}}
+			if err := EnsureUUIDs(path, results); err != nil {
+				t.Fatal(err)
+			}
+			if config.Conf.Servers["host"].UUIDs[tc.key] == "" {
+				t.Fatalf("missing UUID for %q: %+v", tc.key, config.Conf.Servers["host"].UUIDs)
+			}
+		})
+	}
+}
