@@ -34,6 +34,38 @@ from ansible.plugins.connection import ssh
 from ansible.plugins.loader import connection_loader, become_loader
 
 
+_ERROR_XML = b'<Objs Version="1.1.0.1"><S S="Error">message</S></Objs>'
+
+
+@pytest.mark.parametrize('stderr, expected', [
+    (b'ordinary stderr', b'ordinary stderr'),
+    (b'prefix\r\n#< CLIXML\r\n' + _ERROR_XML + b' suffix', b'prefix\r\nmessage suffix'),
+    (b'#< CLIXML\r\n' + _ERROR_XML + b'\r\nafter', b'message\r\nafter'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken', b'#< CLIXML\r\n<Objs Version="1"><S S="Error">broken'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error"></Objs>', b'#< CLIXML\r\n<Objs Version="1"><S S="Error"></Objs>'),
+    (b'#< CLIXML\r\n<Objs Version="1">\r\n<S S="Error">multi</S>\r\n</Objs>tail', b'multitail'),
+    (b'\r\nCLIXML\r\n' + _ERROR_XML + b'tail', b'messagetail'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">caf\x82</S></Objs>', 'caf\u00e9'.encode()),
+    (b'one#< CLIXML\r\n' + _ERROR_XML + b'two#< CLIXML\r\n' + _ERROR_XML + b'three',
+     b'onemessagetwomessagethree'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error"></Objs>before#< CLIXML\r\n' + _ERROR_XML,
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error"></Objs>beforemessage'),
+    (b'#< CLIXML\r\n#< CLIXML\r\n' + _ERROR_XML, b'message'),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_exec_command_replaces_windows_stderr():
+    conn = ssh.Connection(PlayContext(), StringIO())
+    conn._shell = MagicMock(_IS_WINDOWS=True)
+    conn._build_command = MagicMock(return_value='ssh command')
+    conn._run = MagicMock(return_value=(1, b'', b'noise#< CLIXML\r\n' + _ERROR_XML + b'tail'))
+    conn.get_option = MagicMock(return_value='host')
+
+    assert conn.exec_command('command') == (1, b'', b'noisemessagetail')
+
+
