+_CLIXML_HEADER = re.compile(rb"#< CLIXML\r\n|\r\nCLIXML\r\n")
+
+
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML blocks in stderr, retaining all other bytes."""
+    result: list[bytes] = []
+    consumed = 0
+    search_from = 0
+
+    while header := _CLIXML_HEADER.search(stderr, search_from):
+        xml_start = header.end()
+        # PowerShell can repeat the header before the first XML document.
+        while nested_header := _CLIXML_HEADER.match(stderr, xml_start):
+            xml_start = nested_header.end()
+
+        if not stderr.startswith(b"<Objs ", xml_start):
+            search_from = header.end()
+            continue
+
+        xml_end = stderr.find(b"</Objs>", xml_start)
+        if xml_end == -1:
+            search_from = header.end()
+            continue
+        xml_end += len(b"</Objs>")
+
+        # A single header can precede several adjacent serialized objects.
+        while stderr.startswith(b"<Objs ", xml_end):
+            next_end = stderr.find(b"</Objs>", xml_end)
+            if next_end == -1:
+                break
+            xml_end = next_end + len(b"</Objs>")
+
+        try:
+            block = stderr[xml_start:xml_end]
+            try:
+                block = block.decode("utf-8").encode("utf-8")
+            except UnicodeDecodeError:
+                block = block.decode("cp437").encode("utf-8")
+            replacement = _parse_clixml(block)
+        except (ET.ParseError, UnicodeError, ValueError):
+            search_from = header.end()
+            continue
+
+        result.extend((stderr[consumed:header.start()], replacement))
+        consumed = xml_end
+        search_from = consumed
+
+    if not result:
+        return stderr
+    result.append(stderr[consumed:])
+    return b"".join(result)
+
