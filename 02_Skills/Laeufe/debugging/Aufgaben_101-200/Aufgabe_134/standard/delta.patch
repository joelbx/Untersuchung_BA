diff --git a/openlibrary/tests/test_book_providers_runeberg.py b/openlibrary/tests/test_book_providers_runeberg.py
new file mode 100644
index 0000000..de5af0f
--- /dev/null
+++ b/openlibrary/tests/test_book_providers_runeberg.py
@@ -0,0 +1,51 @@
+from pathlib import Path
+
+from web.template import Template
+
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+    get_solr_keys,
+    is_non_ia_ocaid,
+)
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.solr_key == 'id_project_runeberg'
+    assert 'id_project_runeberg' in get_solr_keys()
+    assert provider.is_own_ocaid('runeberg_example')
+    assert is_non_ia_ocaid('runeberg_example')
+    assert not provider.is_own_ocaid('unrelated_book')
+
+    acquisitions = provider.get_acquisitions(
+        {'identifiers': {'project_runeberg': ['example/1900', 'example/1901']}}
+    )
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].url == 'https://runeberg.org/example/1900/'
+    assert acquisitions[0].provider_name == 'runeberg'
+
+
+def test_project_runeberg_templates():
+    template_dir = Path(__file__).resolve().parents[1] / 'templates' / 'book_providers'
+    globals = {'_': lambda value: value, 'render_once': lambda key: True}
+
+    downloads = Template(
+        (template_dir / 'runeberg_download_options.html').read_text(), globals=globals
+    )
+    download_html = str(downloads('example/1900'))
+    for mode in ('scan', 'color', 'html', 'text', 'ocr'):
+        assert f'https://runeberg.org/download.pl?work=example/1900&mode={mode}' in download_html
+
+    read_button = Template(
+        (template_dir / 'runeberg_read_button.html').read_text(), globals=globals
+    )
+    read_html = str(read_button('example/1900'))
+    assert 'https://runeberg.org/example/1900/' in read_html
+    assert 'trusted provider of Nordic literary works' in read_html
+    assert 'data-analytics' not in read_html
+    tracked_html = str(read_button('example/1900', lambda _: 'data-analytics="read"'))
+    assert 'data-analytics="read"' in tracked_html
