+def add_db_name(rec: dict) -> None:
+    """Add each author's name and available dates as a comparison name."""
+    for author in rec.get('authors') or []:
+        date = author.get('date')
+        if not date and ('birth_date' in author or 'death_date' in author):
+            date = (author.get('birth_date') or '') + '-' + (
+                author.get('death_date') or ''
+            )
+        author['db_name'] = f"{author['name']} {date}" if date else author['name']
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare raw or already expanded editions."""
+    if rec.get('title'):
+        full_title = rec['title']
+        if subtitle := rec.get('subtitle'):
+            full_title += ' ' + subtitle
+        rec['full_title'] = full_title
+    else:
+        full_title = rec.get('full_title') or ''
+
+    expanded = build_titles(full_title)
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        expanded['isbn'].extend(rec.get(field) or [])
+    if rec.get('publish_country') not in (None, '', '   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if rec.get(field) is not None:
+            expanded[field] = rec[field]
+    add_db_name(expanded)
+    if 'contribs' in expanded:
+        add_db_name({'authors': expanded['contribs']})
+    return expanded
+
+
