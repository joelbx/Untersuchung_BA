+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	previous := Server.Backup.Schedule
+	defer func() { Server.Backup.Schedule = previous }()
+	for _, tc := range []struct {
+		input, want string
+		valid       bool
+	}{
+		{"", "", true},
+		{"1h", "@every 1h", true},
+		{"0 3 * * *", "0 3 * * *", true},
+		{"not a schedule", "not a schedule", false},
+	} {
+		Server.Backup.Schedule = tc.input
+		err := validateBackupSchedule()
+		if (err == nil) != tc.valid || Server.Backup.Schedule != tc.want {
+			t.Errorf("schedule %q: normalized %q, err %v", tc.input, Server.Backup.Schedule, err)
+		}
+	}
+}
