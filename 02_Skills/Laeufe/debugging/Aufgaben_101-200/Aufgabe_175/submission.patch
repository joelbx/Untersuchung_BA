diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..3bebe9d
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,190 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupTimeFormat = "20060102T150405.000000000"
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", fmt.Errorf("backup.path is empty")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, os.ModePerm); err != nil {
+		return "", err
+	}
+	var path string
+	for {
+		path = filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format(backupTimeFormat)+".db")
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if os.IsExist(err) {
+			continue
+		}
+		if err != nil {
+			return "", err
+		}
+		if err := f.Close(); err != nil {
+			_ = os.Remove(path)
+			return "", err
+		}
+		break
+	}
+	dest, err := sql.Open(Driver, path)
+	if err == nil {
+		err = copySQLite(ctx, dest, d.writeDB)
+		err = combineClose(err, dest.Close())
+	}
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return fmt.Errorf("backup file is required")
+	}
+	if same, err := sameFile(path, conf.Server.DbPath); err != nil {
+		return err
+	} else if same {
+		return fmt.Errorf("backup file is the live database")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	u := url.URL{Scheme: "file", Path: path, RawQuery: "mode=ro"}
+	src, err := sql.Open(Driver, u.String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var result string
+	if err := src.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&result); err != nil {
+		return err
+	}
+	if result != "ok" {
+		return fmt.Errorf("backup integrity check failed: %s", result)
+	}
+	return copySQLite(ctx, d.writeDB, src)
+}
+
+func sameFile(a, b string) (bool, error) {
+	if b == "" || b == ":memory:" {
+		return false, nil
+	}
+	ai, err := os.Stat(a)
+	if err != nil {
+		return false, err
+	}
+	bi, err := os.Stat(b)
+	if os.IsNotExist(err) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	return os.SameFile(ai, bi), nil
+}
+
+func copySQLite(ctx context.Context, dest, src *sql.DB) error {
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	return srcConn.Raw(func(rawSrc any) error {
+		return destConn.Raw(func(rawDest any) error {
+			backup, err := rawDest.(*sqlite3.SQLiteConn).Backup("main", rawSrc.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(-1)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				select {
+				case <-ctx.Done():
+					_ = backup.Finish()
+					return ctx.Err()
+				case <-time.After(10 * time.Millisecond):
+				}
+			}
+		})
+	})
+}
+
+func combineClose(err, closeErr error) error {
+	if err != nil {
+		return err
+	}
+	return closeErr
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, fmt.Errorf("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, fmt.Errorf("backup.count must be nonnegative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var files []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") {
+			continue
+		}
+		stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), ".db")
+		if _, err := time.Parse(backupTimeFormat, stamp); err == nil {
+			files = append(files, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	removed := 0
+	for _, name := range files[min(conf.Server.Backup.Count, len(files)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
