+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	createCmd := &cobra.Command{
+		Use: "create", Short: "Create a database backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, err := db.Db().Backup(cmd.Context())
+			if err == nil {
+				_, _ = fmt.Fprintln(cmd.OutOrStdout(), path)
+			}
+			return err
+		},
+	}
+	pruneCmd := &cobra.Command{
+		Use: "prune", Short: "Delete old database backups", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, _ := cmd.Flags().GetBool("force")
+			if conf.Server.Backup.Count == 0 && !force {
+				if !confirmBackup(cmd, "Delete all database backups?") {
+					return nil
+				}
+			}
+			n, err := db.Db().Prune(cmd.Context())
+			if err == nil {
+				_, _ = fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backup(s)\n", n)
+			}
+			return err
+		},
+	}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation")
+	restoreCmd := &cobra.Command{
+		Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, _ := cmd.Flags().GetString("backup-file")
+			force, _ := cmd.Flags().GetBool("force")
+			if !force && !confirmBackup(cmd, fmt.Sprintf("Restore database from %s?", path)) {
+				return nil
+			}
+			if err := db.Db().Restore(cmd.Context(), path); err != nil {
+				return err
+			}
+			_, _ = fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+			return nil
+		},
+	}
+	restoreCmd.Flags().String("backup-file", "", "database backup file to restore")
+	_ = restoreCmd.MarkFlagRequired("backup-file")
+	restoreCmd.Flags().Bool("force", false, "skip confirmation")
+	backupCmd.AddCommand(createCmd, pruneCmd, restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackup(cmd *cobra.Command, prompt string) bool {
+	_, _ = fmt.Fprintf(cmd.OutOrStdout(), "%s [y/N] ", prompt)
+	answer, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	answer = strings.TrimSpace(answer)
+	return err == nil && (strings.EqualFold(answer, "y") || strings.EqualFold(answer, "yes"))
+}
