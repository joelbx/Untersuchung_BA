+++ b/db/backup_test.go
@@ -0,0 +1,79 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	dir := t.TempDir()
+	conf.Server.Backup.Path = dir
+	conf.Server.Backup.Count = 1
+	live := filepath.Join(dir, "live.db")
+	w, err := sql.Open(Driver, live)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := sql.Open(Driver, live)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer w.Close()
+	defer r.Close()
+	d := &db{writeDB: w, readDB: r}
+	if _, err := w.Exec("create table items (value text); insert into items values ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := d.Backup(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(first); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := w.Exec("update items set value='changed'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := d.Backup(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup filenames collided")
+	}
+	if err := d.Restore(context.Background(), first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := w.QueryRow("select value from items").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "original" {
+		t.Fatalf("restored value = %q", value)
+	}
+	n, err := d.Prune(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 1 {
+		t.Fatalf("pruned %d, want 1", n)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatal(err)
+	}
+	conf.Server.Backup.Count = 0
+	if n, err := d.Prune(context.Background()); err != nil || n != 1 {
+		t.Fatalf("zero retention pruned %d, error %v", n, err)
+	}
+	if _, err := os.Stat(second); !os.IsNotExist(err) {
+		t.Fatalf("expected backup removed, got %v", err)
+	}
+	if err := d.Restore(context.Background(), filepath.Join(dir, "missing.db")); err == nil {
+		t.Fatal("restored a missing backup")
+	}
+}
