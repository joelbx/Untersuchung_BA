     """Tests for urlutils.incdec_number()."""
 
+    @pytest.mark.parametrize('url, segments, expected', [
+        ('http://localhost/%3A5', {'path'}, 'http://localhost/%3A6'),
+        ('http://localhost/%C3%B6/p1', {'path'},
+         'http://localhost/%C3%B6/p2'),
+        ('http://localhost/p?x=%3A5', {'query'},
+         'http://localhost/p?x=%3A6'),
+        ('http://localhost/p#%3A5', {'anchor'},
+         'http://localhost/p#%3A6'),
+        ('http://localhost/%125', {'path'},
+         'http://localhost/%126'),
+    ])
+    def test_encoded_numbers(self, url, segments, expected):
+        result = urlutils.incdec_number(QUrl(url), 'increment',
+                                        segments=segments)
+        assert bytes(result.toEncoded()).decode('ascii') == expected
+
+    def test_decrement_larger_than_value(self):
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(QUrl('http://example.com/page_1'),
+                                   'decrement', count=2)
+
+    @pytest.mark.parametrize('count', [0, -1, 1.5, '2', True])
+    def test_invalid_count(self, count):
+        with pytest.raises(ValueError):
+            urlutils.incdec_number(QUrl('http://example.com/page_1'),
+                                   'increment', count=count)
+
+    def test_selection_order(self):
+        url = QUrl('http://host4.com:8080/p1/p2?x=3#4')
+        result = urlutils.incdec_number(url, 'increment',
+                                        segments={'host', 'port', 'path',
+                                                  'query', 'anchor'})
+        assert result == QUrl('http://host4.com:8080/p2/p2?x=3#4')
+
+    @pytest.mark.parametrize('url, segment', [
+        ('http://localhost/%3A', 'path'),
+        ('http://localhost/p?x=%3A', 'query'),
+        ('http://localhost/p#%3A', 'anchor'),
+    ])
+    def test_only_encoded_digits(self, url, segment):
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(QUrl(url), 'increment',
+                                   segments={segment})
+
+    def test_preserves_other_encoded_segments_and_original(self):
+        original = QUrl('http://localhost:8080/%C3%B6/p1?x=%3A#%C3%B6')
+        result = urlutils.incdec_number(original, 'increment',
+                                        segments={'path', 'query', 'anchor'})
+        assert bytes(result.toEncoded()).decode('ascii') == (
+            'http://localhost:8080/%C3%B6/p2?x=%3A#%C3%B6')
+        assert bytes(original.toEncoded()).decode('ascii') == (
+            'http://localhost:8080/%C3%B6/p1?x=%3A#%C3%B6')
+
