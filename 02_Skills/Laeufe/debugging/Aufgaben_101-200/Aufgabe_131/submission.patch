diff --git a/packages/components/payments/client-extensions/usePollEvents.test.tsx b/packages/components/payments/client-extensions/usePollEvents.test.tsx
new file mode 100644
index 0000000..b74961b
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.tsx
@@ -0,0 +1,164 @@
+import { ReactNode } from 'react';
+
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+import { EventManager } from '@proton/shared/lib/eventManager/eventManager';
+
+import EventManagerContext from '../../containers/eventManager/context';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+describe('usePollEvents', () => {
+    beforeEach(() => jest.useFakeTimers());
+    afterEach(() => jest.useRealTimers());
+
+    it('stops and unsubscribes when the requested event arrives', async () => {
+        const call = jest.fn().mockResolvedValue(undefined);
+        const unsubscribe = jest.fn();
+        let handler: (event: any) => void = () => {};
+        const subscribe = jest.fn((listener) => {
+            handler = listener;
+            return unsubscribe;
+        });
+        const manager = { call, subscribe } as unknown as EventManager;
+        const wrapper = ({ children }: { children: ReactNode }) => (
+            <EventManagerContext.Provider value={manager}>{children}</EventManagerContext.Provider>
+        );
+        const { result } = renderHook(() => usePollEvents(), { wrapper });
+
+        let polling: Promise<void>;
+        act(() => {
+            polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+        });
+        await act(async () => {
+            jest.advanceTimersByTime(5000);
+            await Promise.resolve();
+        });
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(subscribe).toHaveBeenCalledTimes(1);
+
+        act(() => handler({ Other: [{ Action: EVENT_ACTIONS.CREATE }] }));
+        act(() => handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] }));
+        expect(unsubscribe).not.toHaveBeenCalled();
+        await act(async () => {
+            jest.advanceTimersByTime(interval);
+            await Promise.resolve();
+        });
+        expect(call).toHaveBeenCalledTimes(2);
+
+        act(() => handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] }));
+        await polling!;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        act(() => handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] }));
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        await act(async () => {
+            jest.advanceTimersByTime(30000);
+            await Promise.resolve();
+        });
+        expect(call).toHaveBeenCalledTimes(2);
+    });
+
+    it('makes at most five calls at 5000 ms intervals without a selector', async () => {
+        expect(interval).toBe(5000);
+        expect(maxPollingSteps).toBe(5);
+        const call = jest.fn().mockResolvedValue(undefined);
+        const subscribe = jest.fn();
+        const manager = { call, subscribe } as unknown as EventManager;
+        const wrapper = ({ children }: { children: ReactNode }) => (
+            <EventManagerContext.Provider value={manager}>{children}</EventManagerContext.Provider>
+        );
+        const { result } = renderHook(() => usePollEvents(), { wrapper });
+        const polling = result.current();
+
+        for (let attempt = 1; attempt <= maxPollingSteps; attempt += 1) {
+            await act(async () => {
+                jest.advanceTimersByTime(interval - 1);
+                await Promise.resolve();
+            });
+            expect(call).toHaveBeenCalledTimes(attempt - 1);
+            await act(async () => {
+                jest.advanceTimersByTime(1);
+                await Promise.resolve();
+            });
+            expect(call).toHaveBeenCalledTimes(attempt);
+        }
+
+        await polling;
+        expect(subscribe).not.toHaveBeenCalled();
+        await act(async () => {
+            jest.advanceTimersByTime(interval);
+            await Promise.resolve();
+        });
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    });
+
+    it('unsubscribes after the final attempt and ignores late events', async () => {
+        const call = jest.fn().mockResolvedValue(undefined);
+        const unsubscribe = jest.fn();
+        let handler: (event: any) => void = () => {};
+        const subscribe = jest.fn((listener) => {
+            handler = listener;
+            return unsubscribe;
+        });
+        const manager = { call, subscribe } as unknown as EventManager;
+        const wrapper = ({ children }: { children: ReactNode }) => (
+            <EventManagerContext.Provider value={manager}>{children}</EventManagerContext.Provider>
+        );
+        const { result } = renderHook(() => usePollEvents(), { wrapper });
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        for (let attempt = 0; attempt < maxPollingSteps; attempt += 1) {
+            await act(async () => {
+                jest.advanceTimersByTime(interval);
+                await Promise.resolve();
+            });
+        }
+        await polling;
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        act(() => handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] }));
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        await act(async () => {
+            jest.advanceTimersByTime(interval);
+            await Promise.resolve();
+        });
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    });
+
+    it('does not schedule another call when a matching event arrives during a call', async () => {
+        let resolveCall: () => void = () => {};
+        const call = jest.fn(() => new Promise<void>((resolve) => (resolveCall = resolve)));
+        const unsubscribe = jest.fn();
+        let handler: (event: any) => void = () => {};
+        const subscribe = jest.fn((listener) => {
+            handler = listener;
+            return unsubscribe;
+        });
+        const manager = { call, subscribe } as unknown as EventManager;
+        const wrapper = ({ children }: { children: ReactNode }) => (
+            <EventManagerContext.Provider value={manager}>{children}</EventManagerContext.Provider>
+        );
+        const { result } = renderHook(() => usePollEvents(), { wrapper });
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        await act(async () => {
+            jest.advanceTimersByTime(interval);
+        });
+        expect(call).toHaveBeenCalledTimes(1);
+        act(() => handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] }));
+        await polling;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        await act(async () => {
+            resolveCall();
+            await Promise.resolve();
+            jest.advanceTimersByTime(interval * maxPollingSteps);
+            await Promise.resolve();
+        });
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+    });
+});
