diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..ec93680
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,76 @@
+import { render, screen } from '@testing-library/react';
+import createNotificationManager from './manager';
+import NotificationsContainer from './Container';
+import { NotificationOptions } from './interfaces';
+
+describe('notifications', () => {
+    it('renders safe HTML links from strings and preserves React content', () => {
+        render(
+            <NotificationsContainer
+                notifications={[
+                    {
+                        id: 1,
+                        key: 1,
+                        type: 'error',
+                        text: '<a href="https://example.com" target="_self" rel="opener">Help</a><script>alert(1)</script><a href="javascript:alert(1)">Bad</a>',
+                        isClosing: false,
+                    },
+                    { id: 2, key: 2, type: 'info', text: <a href="https://example.org">React link</a>, isClosing: false },
+                ]}
+                hideNotification={jest.fn()}
+                removeNotification={jest.fn()}
+            />
+        );
+
+        const help = screen.getByRole('link', { name: 'Help' });
+        expect(help).toHaveAttribute('href', 'https://example.com');
+        expect(help).toHaveAttribute('target', '_blank');
+        expect(help).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(screen.queryByText('alert(1)')).not.toBeInTheDocument();
+        expect(screen.getByText('Bad')).not.toHaveAttribute('href');
+        expect(screen.getByRole('link', { name: 'React link' })).toHaveAttribute('target', '_blank');
+        expect(screen.getByRole('link', { name: 'React link' })).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('deduplicates non-success notifications by explicit or derived key', () => {
+        let notifications: NotificationOptions[] = [];
+        const setNotifications = (update: any) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        };
+        const manager = createNotificationManager(setNotifications);
+
+        manager.createNotification({ text: 'same', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'info', expiration: -1 });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('same');
+
+        manager.createNotification({ text: 'first', key: 'shared', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'second', key: 'shared', type: 'warning', expiration: -1 });
+        expect(notifications).toHaveLength(2);
+        expect(notifications[1]).toMatchObject({ key: 'shared', text: 'second' });
+
+        manager.createNotification({ text: 'second', key: 'different', type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(3);
+        manager.createNotification({ text: 'zero', key: 0, type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'updated zero', key: 0, type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(4);
+        expect(notifications[3]).toMatchObject({ key: 0, text: 'updated zero' });
+
+        manager.createNotification({ text: <strong>React</strong>, type: 'error', expiration: -1 });
+        manager.createNotification({ text: <strong>React</strong>, type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(6);
+        expect(notifications[4].key).toBe(notifications[4].id);
+
+        manager.createNotification({ text: <strong>React</strong>, key: 'react', type: 'error', expiration: -1 });
+        manager.createNotification({ text: <em>Updated</em>, key: 'react', type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(7);
+        expect(notifications[6].text).toEqual(<em>Updated</em>);
+
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        expect(notifications).toHaveLength(9);
+        manager.createNotification({ text: 'success only', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'success only', type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(11);
+    });
+});
