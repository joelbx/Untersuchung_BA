diff --git a/applications/drive/src/app/zustand/share/member-isolation.test.ts b/applications/drive/src/app/zustand/share/member-isolation.test.ts
new file mode 100644
index 0000000..ce298c3
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/member-isolation.test.ts
@@ -0,0 +1,61 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ memberId: email, email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ invitationId: inviteeEmail, inviteeEmail }) as ShareInvitation;
+const external = (inviteeEmail: string) =>
+    ({ externalInvitationId: inviteeEmail, inviteeEmail }) as ShareExternalInvitation;
+
+beforeEach(() => {
+    useMembersStore.setState({ members: {} });
+    useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+});
+
+it('keeps members for each share independent and replaces one share at a time', () => {
+    const store = useMembersStore.getState();
+    store.setMembers('a', [member('a@example.com')]);
+    store.setMembers('b', [member('b@example.com')]);
+    expect(store.getMembers('a')).toEqual([member('a@example.com')]);
+    expect(store.getMembers('b')).toEqual([member('b@example.com')]);
+    expect(store.getMembers('missing')).toEqual([]);
+    store.setMembers('a', []);
+    expect(store.getMembers('a')).toEqual([]);
+    expect(store.getMembers('b')).toEqual([member('b@example.com')]);
+});
+
+it('keeps both invitation kinds isolated through updates and removals', () => {
+    const store = useInvitationsStore.getState();
+    store.setInvitations('a', [invitation('a@example.com')]);
+    store.setInvitations('b', [invitation('b@example.com')]);
+    store.setExternalInvitations('a', [external('external-a@example.com')]);
+    store.setExternalInvitations('b', [external('external-b@example.com')]);
+    expect(store.getInvitations('missing')).toEqual([]);
+    expect(store.getExternalInvitations('missing')).toEqual([]);
+    store.updateInvitationsPermissions('a', [invitation('updated@example.com')]);
+    store.removeExternalInvitations('a', []);
+    expect(store.getInvitations('a')).toEqual([invitation('updated@example.com')]);
+    expect(store.getInvitations('b')).toEqual([invitation('b@example.com')]);
+    expect(store.getExternalInvitations('a')).toEqual([]);
+    expect(store.getExternalInvitations('b')).toEqual([external('external-b@example.com')]);
+    store.removeInvitations('a', []);
+    store.updateExternalInvitations('a', [external('updated-external@example.com')]);
+    expect(store.getInvitations('a')).toEqual([]);
+    expect(store.getInvitations('b')).toEqual([invitation('b@example.com')]);
+    expect(store.getExternalInvitations('a')).toEqual([external('updated-external@example.com')]);
+    expect(store.getExternalInvitations('b')).toEqual([external('external-b@example.com')]);
+    store.addMultipleInvitations('a', [invitation('new@example.com')], [external('new-external@example.com')]);
+    expect(store.getInvitations('b')).toEqual([invitation('b@example.com')]);
+    expect(store.getExternalInvitations('b')).toEqual([external('external-b@example.com')]);
+});
+
+it('combines emails from members and both invitation kinds', () => {
+    expect(
+        getExistingEmails(
+            [member('member@example.com')],
+            [invitation('invite@example.com')],
+            [external('external@example.com')]
+        )
+    ).toEqual(['member@example.com', 'invite@example.com', 'external@example.com']);
+});
