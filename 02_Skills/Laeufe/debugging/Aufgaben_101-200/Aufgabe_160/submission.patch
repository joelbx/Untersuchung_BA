+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{
+				ServerID: "test-server", Services: []types.SystemRole{types.RoleNode},
+			})
+			server := &types.ServerV2{Metadata: types.Metadata{Name: "test-server"}}
+			server.SetAddr(tt.address)
+			require.NoError(t, controller.handleSSHServerHB(handle, server))
+			require.Equal(t, tt.want, auth.lastAddr)
+		})
+	}
+}
