+func TestSSHServerHeartbeatPeerAddress(t *testing.T) {
+	tests := []struct {
+		name, address, peer, want string
+	}{
+		{"ipv6 wildcard", "[::]:3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"ipv4 wildcard", "0.0.0.0:3022", "[2001:db8::10]:54321", "[2001:db8::10]:3022"},
+		{"empty host", ":3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"loopback", "127.0.0.1:3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"localhost", "localhost:3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"explicit address", "198.51.100.10:3022", "192.0.2.10:54321", "198.51.100.10:3022"},
+		{"no peer", "[::]:3022", "", "[::]:3022"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
