diff --git a/applications/mail/src/app/helpers/assistant/format.test.ts b/applications/mail/src/app/helpers/assistant/format.test.ts
new file mode 100644
index 0000000..f065c8d
--- /dev/null
+++ b/applications/mail/src/app/helpers/assistant/format.test.ts
@@ -0,0 +1,94 @@
+import { simplifyHTML } from './html';
+import { prepareContentToModel } from './input';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+import { replaceURLs, restoreURLs } from './url';
+
+const domOf = (html: string) => {
+    const dom = document.implementation.createHTMLDocument();
+    dom.body.innerHTML = html;
+    return dom;
+};
+
+describe('assistant formatting', () => {
+    it('keeps link and image class and style when simplifying', () => {
+        const dom = simplifyHTML(
+            domOf(
+                '<a href="https://a" class="link" style="color:red">text</a><img src="https://i" class="image" style="width:10px">'
+            )
+        );
+        expect(dom.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(dom.querySelector('a')?.getAttribute('style')).toBe('color:red');
+        expect(dom.querySelector('img')?.getAttribute('style')).toBe('width:10px');
+    });
+
+    it('moves a sibling nested list into its preceding list item', () => {
+        const dom = fixNestedLists(domOf('<ul><li>parent</li><ul><li>child</li></ul></ul>'));
+        expect(dom.body.querySelector('ul > li > ul > li')?.textContent).toBe('child');
+        expect(dom.body.querySelector('ul > ul')).toBeNull();
+    });
+
+    it('keeps ordered markers and nested indentation in Markdown', () => {
+        const md = htmlToMarkdown(domOf('<ol><li>one<ul><li>child</li></ul></li><li>two</li></ol>'));
+        expect(md).toMatch(/1\. one/);
+        expect(md).toMatch(/\n\s+- child/);
+        expect(md).toMatch(/2\. two/);
+    });
+
+    it('keeps nested ordered list levels and following siblings', () => {
+        const md = htmlToMarkdown(
+            domOf('<ol><li>parent<ol><li>child one</li><li>child two</li></ol></li><li>next parent</li></ol>')
+        );
+        expect(md).toMatch(/^1\. parent/m);
+        expect(md).toMatch(/\n  1\. child one/);
+        expect(md).toMatch(/\n  2\. child two/);
+        expect(md).toMatch(/\n2\. next parent/);
+    });
+
+    it('keeps spacing inside fenced code', () => {
+        const dom = domOf('<pre><code>  # code\n    nested\n</code></pre>');
+        expect(dom.querySelector('code')?.textContent).toBe('  # code\n    nested\n');
+        const md = htmlToMarkdown(dom);
+        expect(md).toContain('```');
+        expect(md.split('\n')[1]).toBe('  # code');
+        expect(md.split('\n')[2]).toBe('    nested');
+    });
+
+    it('renders Markdown lists as HTML lists', () => {
+        expect(markdownToHTML('- one\n  - child')).toContain('<ul>');
+    });
+
+    it('round trips link and image attributes for the same message', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://a" class="custom-link" style="color:red">text</a><img src="https://i" class="custom-image" style="width:10px">',
+            'uid',
+            'roundtrip'
+        );
+        const html = parseModelResult(markdown, 'roundtrip');
+        expect(html).toContain('https://a');
+        expect(html).toContain('custom-link');
+        expect(html).toContain('color:red');
+        expect(html).toContain('https://i');
+        expect(html).toContain('custom-image');
+        expect(html).toContain('width:10px');
+    });
+
+    it('restores only URLs from the current message and drops fabricated URLs', () => {
+        const source = replaceURLs(domOf('<a href="https://a">good</a><img src="https://i">'), 'uid', 'first');
+        const href = source.querySelector('a')!.getAttribute('href');
+        const src = source.querySelector('img')!.getAttribute('src');
+        const other = restoreURLs(
+            domOf(
+                `<a href="${href}">foreign</a><img src="${src}"><a href="https://fake">fake</a><img src="https://fake"><a>empty link</a><img>`
+            ),
+            'second'
+        );
+        expect(other.querySelectorAll('a,img')).toHaveLength(0);
+        expect(other.body.textContent).toContain('foreign');
+        expect(other.body.textContent).toContain('fake');
+        expect(other.body.textContent).toContain('empty link');
+        const own = restoreURLs(source, 'first');
+        expect(own.querySelector('a')?.getAttribute('href')).toBe('https://a');
+        expect(own.querySelector('img')?.getAttribute('src')).toBe('https://i');
+    });
+});
