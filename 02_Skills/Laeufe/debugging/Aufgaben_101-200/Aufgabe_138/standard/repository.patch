+func TestOCIManifestVersionConfig(t *testing.T) {
+	for _, tc := range []struct {
+		name, value, want, wantErr string
+	}{
+		{"default", "", "1.1", ""},
+		{"version 1.0", `manifest_version: "1.0"`, "1.0", ""},
+		{"version 1.1", `manifest_version: "1.1"`, "1.1", ""},
+		{"unsupported", `manifest_version: "1.2"`, "", "wrong manifest version, it should be 1.0 or 1.1"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "flipt.yml")
+			data := "storage:\n  type: oci\n  oci:\n    repository: example.org/bundle:latest\n    " + tc.value + "\n"
+			require.NoError(t, os.WriteFile(path, []byte(data), 0600))
+			result, err := Load(path)
+			if tc.wantErr != "" {
+				require.EqualError(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, result.Config.Storage.OCI.ManifestVersion)
+		})
+	}
+}
