+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name                             string
+		options                          []containers.Option[StoreOptions]
+		wantConfigType, wantArtifactType string
+	}{
+		{"default 1.1", nil, v1.MediaTypeEmptyJSON, MediaTypeFliptFeatures},
+		{"configured 1.0", []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)}, MediaTypeFliptFeatures, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			store, err := NewStore(zaptest.NewLogger(t), t.TempDir(), tc.options...)
+			require.NoError(t, err)
+			ref, err := ParseReference("testrepo:latest")
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			_, err = store.Build(ctx, src, ref)
+			require.NoError(t, err)
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			data, err := content.FetchAll(ctx, target, desc)
+			require.NoError(t, err)
+			var manifest v1.Manifest
+			require.NoError(t, json.Unmarshal(data, &manifest))
+			assert.Equal(t, tc.wantConfigType, manifest.Config.MediaType)
+			assert.Equal(t, tc.wantArtifactType, manifest.ArtifactType)
+		})
+	}
+}
