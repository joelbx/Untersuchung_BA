diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..6c7f5d5 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,74 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_rule(self):
+        for matches in ([], ['set']):
+            for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+                with self.subTest(matches=matches, flags=flags):
+                    set_module_args({
+                        'chain': 'INPUT', 'protocol': 'tcp',
+                        'match': matches, 'match_set': 'admin_hosts',
+                        'match_set_flags': flags, 'destination_port': '22',
+                        'jump': 'ACCEPT', 'comment': 'SSH admins',
+                        '_ansible_check_mode': True,
+                    })
+                    with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                        run_command.return_value = (1, '', '')
+                        with self.assertRaises(AnsibleExitJson):
+                            iptables.main()
+                    self.assertEqual(run_command.call_args[0][0], [
+                        '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                        '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', flags,
+                        '-j', 'ACCEPT', '--destination-port', '22',
+                        '-m', 'comment', '--comment', 'SSH admins',
+                    ])
+
+    def test_match_set_inverted(self):
+        set_module_args({
+            'chain': 'INPUT', 'match_set': '!admin_hosts',
+            'match_set_flags': 'src', 'jump': 'DROP',
+            '_ansible_check_mode': True,
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (1, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'src', '-j', 'DROP',
+        ])
+
+    def test_match_set_requires_flags_and_name(self):
+        for key, value in (('match_set', 'admin_hosts'), ('match_set_flags', 'src')):
+            with self.subTest(key=key):
+                set_module_args({'chain': 'INPUT', key: value})
+                with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                    with self.assertRaises(AnsibleFailJson):
+                        iptables.main()
+                run_command.assert_not_called()
+
+    def test_match_set_rejects_invalid_flags(self):
+        set_module_args({
+            'chain': 'INPUT', 'match_set': 'admin_hosts',
+            'match_set_flags': 'source',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+        run_command.assert_not_called()
+
+    def test_match_set_append_rule(self):
+        set_module_args({
+            'chain': 'INPUT', 'match_set': 'admin_hosts',
+            'match_set_flags': 'src', 'jump': 'ACCEPT',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.side_effect = [(1, '', ''), (0, '', '')]
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertEqual(run_command.call_count, 2)
+        self.assertEqual(run_command.call_args_list[1][0][0], [
+            '/sbin/iptables', '-t', 'filter', '-A', 'INPUT',
+            '-m', 'set', '--match-set', 'admin_hosts', 'src', '-j', 'ACCEPT',
+        ])
