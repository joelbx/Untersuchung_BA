+@pytest.mark.parametrize('duration, expected', [
+    ('5000', 5000),
+    ('2m15s', 135000),
+])
+def test_later_duration(mocker, duration, expected):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer').return_value
+    runner = mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration, 'scroll down', win_id=0)
+
+    timer.setInterval.assert_called_once_with(expected)
+    timer.start.assert_called_once_with()
+    runner.assert_called_once_with(0)
+
+
+def test_later_negative_delay():
+    with pytest.raises(cmdutils.CommandError,
+                       match="I can't run something in the past!"):
+        utilcmds.later('-1', 'scroll down', win_id=0)
