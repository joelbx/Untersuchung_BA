+def parse_duration(duration: str) -> int:
+    """Parse hours, minutes and seconds into milliseconds.
+
+    A bare integer is already in milliseconds. Fractional milliseconds are
+    truncated when converting the result to an integer.
+    """
+    duration = duration.strip()
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    number = r'(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+)'
+    pattern = r'\s*(?:({})h)?\s*(?:({})m)?\s*(?:({})s)?\s*'.format(
+        number, number, number)
+    match = re.fullmatch(pattern, duration)
+    if match is None or not any(match.groups()):
+        raise ValueError('Invalid duration: {!r}'.format(duration))
+
+    factors = (3600000, 60000, 1000)
+    return int(sum(Decimal(value) * factor for value, factor in
+                   zip(match.groups(), factors) if value is not None))
+
+
