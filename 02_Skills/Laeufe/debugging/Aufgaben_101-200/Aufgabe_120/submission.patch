+@contextmanager
+def _batch_lock(item_id, batch_id):
+    directory = os.path.join(config.data_root, 'items', '.locks')
+    os.makedirs(directory, exist_ok=True)
+    path = os.path.join(directory, f'covers_{item_id}_{batch_id}.lock')
+    with open(path, 'a+b') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise RuntimeError(f'Batch {item_id}_{batch_id} is already being processed') from exc
+        try:
+            yield
+        finally:
+            fcntl.flock(lock, fcntl.LOCK_UN)
