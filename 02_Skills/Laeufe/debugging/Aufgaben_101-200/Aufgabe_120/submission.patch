+class CoverDB:
+    def __init__(self):
+        self.db = db.getdb()
+
+    @staticmethod
+    def _get_batch_end_id(start_id):
+        return (int(start_id) // BATCH_SIZE + 1) * BATCH_SIZE - 1
+
+    def get_batch(self, start_id):
+        start_id = int(start_id) // BATCH_SIZE * BATCH_SIZE
+        return self.db.select('cover', where='id >= $start AND id <= $end AND failed=$false AND uploaded=$false',
+                              vars={'start': start_id, 'end': self._get_batch_end_id(start_id), 'false': False}, order='id')
+
+    @staticmethod
+    def update_completed_batch(item_id, batch_id, ext='jpg'):
+        start = int(item_id) * 1_000_000 + int(batch_id) * BATCH_SIZE
+        end = CoverDB._get_batch_end_id(start)
+        database = db.getdb()
+        # One statement makes the four paths and status visible atomically.
+        for row in database.select('cover', where='id >= $start AND id <= $end AND failed=$false AND uploaded=$false',
+                                   vars={'start': start, 'end': end, 'false': False}):
+            paths = {('filename' + (f'_{size}' if size else '')): Cover.get_cover_url(row.id, size, ext)
+                     for size in SIZES}
+            database.update('cover', where='id=$id AND failed=$false AND uploaded=$false',
+                            vars={'id': row.id, 'false': False}, archived=True, uploaded=True, **paths)
