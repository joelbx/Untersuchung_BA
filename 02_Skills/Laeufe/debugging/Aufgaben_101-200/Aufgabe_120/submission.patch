+class Cover:
+    """A cover row and its deterministic archive location."""
+
+    def __init__(self, attributes):
+        self.attributes = attributes
+        self.id = int(attributes['id'])
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        cover_id = int(cover_id)
+        if not 0 <= cover_id < 10_000_000_000:
+            raise ValueError('Cover ID must fit in ten digits')
+        digits = f'{cover_id:010d}'
+        return digits[:4], digits[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        _size(size)
+        if protocol not in ('http', 'https'):
+            raise ValueError('Unsupported protocol')
+        if not re.fullmatch(r'[a-zA-Z0-9]+', ext):
+            raise ValueError('Invalid extension')
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        archive = f'{item}_{batch_id}.zip'
+        suffix = f'-{size.upper()}' if size else ''
+        filename = f'{int(cover_id):010d}{suffix}.{ext}'
+        return f'{protocol}://archive.org/download/{item}/{archive}/{filename}'
+
+    def local_files(self):
+        for size in SIZES:
+            key = 'filename' + (f'_{size}' if size else '')
+            filename = self.attributes.get(key)
+            if filename and not filename.startswith(('http://', 'https://', 'items/')) and ':' not in filename:
+                yield size, os.path.join(config.data_root, 'localdisk', filename)
+
