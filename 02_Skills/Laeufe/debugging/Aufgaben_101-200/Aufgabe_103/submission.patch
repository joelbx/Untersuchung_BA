+// sourceRPMVersion includes only the available epoch and release components.
+func sourceRPMVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
