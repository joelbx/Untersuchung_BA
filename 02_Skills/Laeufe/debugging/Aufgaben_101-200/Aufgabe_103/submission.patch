@@ -0,0 +1,95 @@
+package scanner
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRPMEmptyReleaseRegression(t *testing.T) {
+	cases := []struct {
+		name, line                         string
+		repoquery                          bool
+		version, sourceVersion, repository string
+	}{
+		{"rpm zero", "package 0 1.2  x86_64 package-1.2-.src.rpm", false, "1.2", "1.2", ""},
+		{"rpm none", "package (none) 1.2  x86_64 package-1.2-.src.rpm", false, "1.2", "1.2", ""},
+		{"rpm epoch", "package 3 1.2  x86_64 package-1.2-.src.rpm", false, "3:1.2", "3:1.2", ""},
+		{"repoquery zero", "package 0 1.2  x86_64 package-1.2-.src.rpm @custom", true, "1.2", "1.2", "custom"},
+		{"repoquery none", "package (none) 1.2  x86_64 package-1.2-.src.rpm @custom", true, "1.2", "1.2", "custom"},
+		{"repoquery epoch", "package 3 1.2  x86_64 package-1.2-.src.rpm installed", true, "3:1.2", "3:1.2", "amzn2-core"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var p *models.Package
+			var s *models.SrcPackage
+			var err error
+			if tc.repoquery {
+				p, s, err = o.parseInstalledPackagesLineFromRepoquery(tc.line)
+			} else {
+				p, s, err = o.parseInstalledPackagesLine(tc.line)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if p == nil || p.Name != "package" || p.Version != tc.version || p.Release != "" || p.Arch != "x86_64" || p.Repository != tc.repository {
+				t.Errorf("package: %+v", p)
+			}
+			if s == nil || s.Name != "package" || s.Version != tc.sourceVersion || s.Arch != "src" || !reflect.DeepEqual(s.BinaryNames, []string{"package"}) {
+				t.Errorf("source: %+v", s)
+			}
+		})
+	}
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2"}}}
+	p, s, err := o.parseInstalledPackages("package 0 1.2  x86_64 package-1.2-.src.rpm @custom\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p["package"].Release != "" || p["package"].Repository != "custom" || s["package"].Version != "1.2" {
+		t.Errorf("packages: %+v, sources: %+v", p, s)
+	}
+}
+
+func TestSplitFileNameRegression(t *testing.T) {
+	for _, tc := range []struct{ input, name, version, release, arch string }{
+		{"package-0-1-src.rpm", "package", "0", "1", "src"},
+		{"package-1.2-3-src.rpm", "package", "1.2", "3", "src"},
+		{"package-0--src.rpm", "package", "0", "", "src"},
+		{"package-0-.src.rpm", "package", "0", "", "src"},
+		{"package-0-1-extra-src.rpm", "package", "0", "1-extra", "src"},
+		{"package-0-1-extra.src.rpm", "package", "0", "1-extra", "src"},
+	} {
+		t.Run(tc.input, func(t *testing.T) {
+			n, v, r, _, a, err := splitFileName(tc.input)
+			if err != nil || n != tc.name || v != tc.version || r != tc.release || a != tc.arch {
+				t.Errorf("got %q %q %q %q: %v", n, v, r, a, err)
+			}
+		})
+	}
+	for _, input := range []string{"package-0-1.src", "-0-1.src.rpm", "package--1.src.rpm", "package-0-1..rpm", "package-0-1-.rpm", "package-bar-1.src.rpm"} {
+		t.Run(input, func(t *testing.T) {
+			_, _, _, _, _, err := splitFileName(input)
+			if err == nil {
+				t.Error("expected error")
+			}
+		})
+	}
+}
+
+func TestUpdatablePacksNoneEpochRegression(t *testing.T) {
+	o := &redhatBase{}
+	packs, err := o.parseUpdatablePacksLines("Loading repositories\npackage (none) 1.2 3 updates\nother 2 4.5 6 amzn-main\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if packs["package"].NewVersion != "1.2" || packs["package"].NewRelease != "3" || packs["package"].Repository != "updates" {
+		t.Errorf("package: %+v", packs["package"])
+	}
+	if packs["other"].NewVersion != "2:4.5" || packs["other"].NewRelease != "6" || packs["other"].Repository != "amzn-main" {
+		t.Errorf("other: %+v", packs["other"])
+	}
+}
