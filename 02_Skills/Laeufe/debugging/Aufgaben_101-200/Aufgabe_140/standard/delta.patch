+@pytest.mark.parametrize("source", ["runtime", "config"])
+def test_parent_domain_blocking(config_stub, host_blocker_factory, source):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = ["https://allowed.example.com/*"]
+
+    blocker = host_blocker_factory()
+    blocked = (blocker._blocked_hosts if source == "runtime"
+               else blocker._config_blocked_hosts)
+    blocked.add("example.com")
+
+    for host in ["example.com", "sub.example.com", "a.b.example.com",
+                 "a.b.example.com."]:
+        assert blocker._is_blocked(QUrl("https://" + host + "/path"))
+
+    assert not blocker._is_blocked(QUrl("https://allowed.example.com/path"))
+    assert not blocker._is_blocked(QUrl("https://otherexample.com/path"))
+
+    blocked.remove("example.com")
+    blocked.add("example.com.")
+    assert blocker._is_blocked(QUrl("https://sub.example.com/path"))
+
+
+def test_parent_domain_blocking_per_url_disabled(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = []
+    first_party = QUrl("https://first-party.example/")
+    config_stub.set_obj("content.blocking.enabled", False,
+                        pattern=urlmatch.UrlPattern("first-party.example"))
+    blocker = host_blocker_factory()
+    blocker._blocked_hosts.add("example.com")
+
+    assert not blocker._is_blocked(QUrl("https://sub.example.com/"),
+                                   first_party_url=first_party)
+
+
