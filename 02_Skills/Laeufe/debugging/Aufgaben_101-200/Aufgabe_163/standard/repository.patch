--- /dev/null
+++ b/config/database_test.go
@@ -0,0 +1,43 @@
+package config
+
+import (
+	"io/ioutil"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestDatabaseFields(t *testing.T) {
+	f, err := ioutil.TempFile("", "flipt-db-config-*.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(f.Name())
+	defer f.Close()
+	for _, tc := range []struct{ yaml, target, errorPart string }{
+		{"db:\n  protocol: postgres\n  host: localhost\n  user: me\n  password: secret\n  name: flipt\n", "postgres://me:secret@localhost:5432/flipt", ""},
+		{"db:\n  protocol: mysql\n  host: localhost\n  name: flipt\n", "mysql://localhost:3306/flipt", ""},
+		{"db:\n  protocol: sqlite3\n  host: /tmp\n  name: flipt.db\n", "file:/tmp/flipt.db", ""},
+		{"db:\n  url: file:existing.db\n  protocol: garbage\n", "file:existing.db", ""},
+		{"db:\n  protocol: garbage\n  host: localhost\n  name: flipt\n", "", "db.protocol"},
+		{"db:\n  protocol: postgres\n  name: flipt\n", "", "db.host"},
+		{"db:\n  protocol: postgres\n  host: localhost\n  name: flipt\n  port: banana\n", "", "db.port"},
+	} {
+		if err := ioutil.WriteFile(f.Name(), []byte(tc.yaml), 0600); err != nil {
+			t.Fatal(err)
+		}
+		cfg, err := Load(f.Name())
+		if tc.errorPart != "" {
+			if err == nil || !strings.Contains(err.Error(), tc.errorPart) {
+				t.Fatalf("%q: wanted %s, got %v", tc.yaml, tc.errorPart, err)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatalf("%q: %v", tc.yaml, err)
+		}
+		if got := cfg.Database.ConnectionURL(); got != tc.target {
+			t.Errorf("got %q, want %q", got, tc.target)
+		}
+	}
+}
