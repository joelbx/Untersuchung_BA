+
+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnknown DatabaseProtocol = iota
+	SQLite
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// ConnectionURL returns the chosen connection target. Validate before calling it.
+func (d DatabaseConfig) ConnectionURL() string {
+	if d.URL != "" {
+		return d.URL
+	}
+	if d.Protocol == SQLite {
+		path := d.Path
+		if path == "" {
+			path = d.Host
+		}
+		return "file:" + filepath.Join(path, d.Name)
+	}
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, fmt.Sprint(port)), Path: "/" + d.Name}
+	if d.User != "" {
+		if d.Password != "" {
+			u.User = url.UserPassword(d.User, d.Password)
+		} else {
+			u.User = url.User(d.User)
+		}
+	} else if d.Password != "" {
+		u.User = url.UserPassword("", d.Password)
+	}
+	return u.String()
+}
+
+// Validate checks the active database configuration mode.
+func (d DatabaseConfig) Validate() error {
+	if d.URL != "" {
+		return nil
+	}
+	if d.Protocol != SQLite && d.Protocol != Postgres && d.Protocol != MySQL {
+		return fmt.Errorf("db.protocol: invalid value %d; expected sqlite3, postgres, or mysql", d.Protocol)
+	}
+	if d.Name == "" {
+		return errors.New("db.name cannot be empty")
+	}
+	if d.Protocol == SQLite {
+		if d.Path == "" && d.Host == "" {
+			return errors.New("db.path cannot be empty for sqlite3")
+		}
+	} else if d.Host == "" {
+		return errors.New("db.host cannot be empty")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return errors.New("db.port must be between 0 and 65535")
+	}
+	return nil
 }
 
