@@ -0,0 +1,35 @@
+package parse
+
+import (
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestNestedExpressionRegression(t *testing.T) {
+	e, err := NewExpression(`{{regexp.replace(email.local(external.email), "^(.*)$", "$1-user")}}`)
+	require.NoError(t, err)
+	got, err := e.Interpolate(map[string][]string{"email": {"alice@example.com"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"alice-user"}, got)
+}
+
+func TestASTValidationRegression(t *testing.T) {
+	for _, in := range []string{`{{internal}}`, `{{internal.foo.bar}}`, `{{internal.foo["bar"]}}`, `{{other.foo}}`, `{{"asdf"}}`, `{{123}}`, `{{regexp.replace(external.foo, external.pattern, "x")}}`, `{{regexp.replace(external.foo, "x")}}`, `{{regexp.replace(regexp.match("x"), "x", "y")}}`, `{{regexp.match("x")}}`} {
+		_, err := NewExpression(in)
+		require.Error(t, err, in)
+	}
+	e, err := NewExpression(`{{regexp.replace("foo-bar", "^foo-(.*)$", "$1")}}`)
+	require.NoError(t, err)
+	got, err := e.Interpolate(nil)
+	require.NoError(t, err)
+	require.Equal(t, []string{"bar"}, got)
+	e, err = NewExpression(`{{email.local(external.email)}}`)
+	require.NoError(t, err)
+	_, err = e.Interpolate(map[string][]string{"email": {"alice@example.com"}}, func(ns, name string) error { return trace.BadParameter("blocked %s", ns) })
+	require.True(t, trace.IsBadParameter(err))
+	m, err := NewMatcher(`prefix{{regexp.not_match("bad")}}suffix`)
+	require.NoError(t, err)
+	require.True(t, m.Match("prefixgoodsuffix"))
+	require.False(t, m.Match("prefixbadsuffix"))
+}
