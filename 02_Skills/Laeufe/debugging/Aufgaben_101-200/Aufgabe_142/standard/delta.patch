+++ b/lib/utils/parse/compat.go
@@ -0,0 +1,54 @@
+package parse
+
+import (
+	"github.com/gravitational/trace"
+	"net/mail"
+	"regexp"
+	"strings"
+)
+
+type transformer interface{ transform(string) (string, error) }
+type emailLocalTransformer struct{}
+
+func (emailLocalTransformer) transform(s string) (string, error) {
+	if s == "" {
+		return "", trace.BadParameter("address is empty")
+	}
+	a, e := mail.ParseAddress(s)
+	if e != nil {
+		return "", trace.BadParameter("invalid email: %v", e)
+	}
+	return strings.SplitN(a.Address, "@", 2)[0], nil
+}
+
+type regexpReplaceTransformer struct {
+	re          *regexp.Regexp
+	replacement string
+}
+
+func (r regexpReplaceTransformer) transform(s string) (string, error) {
+	if !r.re.MatchString(s) {
+		return "", nil
+	}
+	return r.re.ReplaceAllString(s, r.replacement), nil
+}
+
+type regexpMatcher struct{ re *regexp.Regexp }
+
+func (m regexpMatcher) Match(s string) bool { return m.re.MatchString(s) }
+
+type prefixSuffixMatcher struct {
+	prefix, suffix string
+	m              Matcher
+}
+
+func (m prefixSuffixMatcher) Match(s string) bool {
+	if !strings.HasPrefix(s, m.prefix) || !strings.HasSuffix(s, m.suffix) || len(s) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.m.Match(s[len(m.prefix) : len(s)-len(m.suffix)])
+}
+
+type notMatcher struct{ m Matcher }
+
+func (m notMatcher) Match(s string) bool { return !m.m.Match(s) }
