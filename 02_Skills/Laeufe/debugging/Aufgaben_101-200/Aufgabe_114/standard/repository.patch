+// commonDirectory finds the deepest directory containing every supplied path.
+func commonDirectory(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	common := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		for common != "." {
+			rel, err := filepath.Rel(common, dir)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			parent := filepath.Dir(common)
+			if parent == common {
+				return ""
+			}
+			common = parent
+		}
+	}
+	return common
+}
+
+func findArtistImage(folder string) (string, string) {
+	if folder == "" {
+		return "", ""
+	}
+	entries, err := os.ReadDir(folder)
+	if err != nil {
+		return "", ""
+	}
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		match, _ := filepath.Match("artist.*", strings.ToLower(entry.Name()))
+		if !match {
+			continue
+		}
+		info, err := entry.Info()
+		if err == nil && info.Mode().IsRegular() {
+			return filepath.Join(folder, entry.Name()), fmt.Sprintf("%s.%d.%d", entry.Name(), info.Size(), info.ModTime().UnixNano())
+		}
+	}
+	return "", ""
+}
+
+func fromArtistFolder(path string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if path == "" {
