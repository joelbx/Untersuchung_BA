 class ZipArchive(object):
 
+    @staticmethod
+    def _valid_time_stamp(value):
+        # ZIP timestamps can contain zero or invalid date fields. Use the
+        # earliest representable ZIP date when the listing cannot be parsed.
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.fullmatch(r'([0-9]{4})([0-9]{2})([0-9]{2})\.([0-9]{2})([0-9]{2})([0-9]{2})', value)
+        if not match:
+            return epoch
+
+        parts = tuple(int(component) for component in match.groups())
+        if not 1980 <= parts[0] <= 2107:
+            return epoch
+        try:
+            return datetime.datetime(*parts).timetuple()
+        except ValueError:
+            return epoch
+
