+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	metadata := map[string]any{
+		"settings": map[string]any{"regions": []any{"us", map[string]any{"enabled": true}}},
+		"count":    float64(2),
+	}
+	for _, tc := range []struct {
+		name, input string
+		enc         Encoding
+	}{
+		{"yaml", "namespace:\n  key: team\n  name: Team\n  description: Team flags\nflags:\n  - key: nested\n    enabled: true\n    metadata:\n      settings:\n        regions: [us, {enabled: true}]\n      count: 2\n    variants:\n      - key: first\n        attachment:\n          nested: [{value: 1}]\n", EncodingYAML},
+		{"json", `{"namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"nested","enabled":true,"metadata":{"settings":{"regions":["us",{"enabled":true}]},"count":2},"variants":[{"key":"first","attachment":{"nested":[{"value":1}]}}]}]}`, EncodingJSON},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team", Description: "Team flags"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, metadata, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":[{"value":1}]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONLeadingComment(t *testing.T) {
+	payload := `{"flags":[{"key":"commented","enabled":true}]}`
+	for _, tc := range []struct {
+		name, input string
+		valid       bool
+	}{
+		{"plain", payload, true},
+		{"header", "# exported flags\n" + payload, true},
+		{"two headers", "# first\n# second\n" + payload, false},
+		{"indented header", " # header\n" + payload, false},
+		{"comment after json", payload + "\n# trailing", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{}
+			err := NewImporter(creator).Import(context.Background(), EncodingJSON, strings.NewReader(tc.input), false)
+			if tc.valid {
+				require.NoError(t, err)
+				assert.Len(t, creator.createflagReqs, 1)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
