diff --git a/tests/unit/browser/webengine/test_webengine_certificateerror.py b/tests/unit/browser/webengine/test_webengine_certificateerror.py
new file mode 100644
index 0000000..7ab5d85
--- /dev/null
+++ b/tests/unit/browser/webengine/test_webengine_certificateerror.py
@@ -0,0 +1,56 @@
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+class FakeError:
+
+    def __init__(self):
+        self.decisions = []
+
+    def errorDescription(self):
+        return '<bad & certificate>'
+
+    def isOverridable(self):
+        return True
+
+    def acceptCertificate(self):
+        self.decisions.append('accept')
+
+    def rejectCertificate(self):
+        self.decisions.append('reject')
+
+    def defer(self):
+        self.decisions.append('defer')
+
+
+class FakeQt6Error(FakeError):
+
+    errorDescription = None
+
+    def description(self):
+        return '<Qt6 & certificate>'
+
+
+def test_factory_and_decisions(monkeypatch):
+    error = FakeError()
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', False)
+    wrapper = certificateerror.create(error)
+    assert isinstance(wrapper, certificateerror.CertificateErrorWrapperQt5)
+    assert wrapper.html() == '<p>&lt;bad &amp; certificate&gt;</p>'
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    assert wrapper.ignore
+
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', True)
+    error = FakeQt6Error()
+    wrapper = certificateerror.create(error)
+    assert isinstance(wrapper, certificateerror.CertificateErrorWrapperQt6)
+    assert wrapper.html() == '<p>&lt;Qt6 &amp; certificate&gt;</p>'
+    wrapper.defer()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    assert error.decisions == ['defer', 'reject']
+
+
+def test_undeferrable():
+    assert issubclass(usertypes.UndeferrableError, Exception)
diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..7b46286 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -71,3 +71,21 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+def test_named_reply_and_decision():
+    class FakeReply:
+        def __init__(self):
+            self.ignored = False
+
+        def ignoreSslErrors(self):
+            self.ignored = True
+
+    reply = FakeReply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('<unsafe & "quoted">')])
+    assert not reply.ignored
+    assert wrapper.html() == '<p>&lt;unsafe &amp; &quot;quoted&quot;&gt;</p>'
+    wrapper.accept_certificate()
+    assert reply.ignored
+    assert wrapper.certificate_was_accepted()
