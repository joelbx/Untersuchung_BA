+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['enable-features=FromConfig',
+                                   'disable-features=BlockedByConfig']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=FromCommandLine',
+            '--qt-flag', 'disable-features=BlockedByCommandLine,AlsoBlocked',
+        ])
+
+        args = qtargs.qt_args(parsed)
+        assert [arg for arg in args if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)] == [
+            '--enable-features=FromCommandLine,FromConfig']
+        assert [arg for arg in args if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)] == [
+            '--disable-features=BlockedByCommandLine,AlsoBlocked',
+            '--disable-features=BlockedByConfig']
