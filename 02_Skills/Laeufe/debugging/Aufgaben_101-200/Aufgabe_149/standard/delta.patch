+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_enabled_and_disabled_features(self, config_stub, monkeypatch,
+                                           parser, via_commandline):
+        """Keep disabled features separate from combined enabled features."""
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+
+        flags = ['enable-features=First,Second',
+                 'disable-features=Blocked,AlsoBlocked',
+                 'enable-features=Third']
+        config_stub.val.qt.args = [] if via_commandline else flags
+        commandline = [arg for flag in flags for arg in ('--qt-flag', flag)]
+        parsed = parser.parse_args(commandline if via_commandline else [])
+
+        args = qtargs.qt_args(parsed)
+        enable = '--enable-features=First,Second,Third,OverlayScrollbar'
+        disable = '--disable-features=Blocked,AlsoBlocked'
+        assert [arg for arg in args if arg.startswith('--enable-features=')] == [enable]
+        assert [arg for arg in args if arg.startswith('--disable-features=')] == [disable]
+        assert args.index(enable) < args.index(disable)
+
+    def test_feature_prefixes(self):
+        assert qtargs.ENABLE_FEATURES_PREFIX == '--enable-features='
+        assert qtargs.DISABLE_FEATURES_PREFIX == '--disable-features='
+
+    def test_features_from_both_sources(self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
