@@ -0,0 +1,55 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestTracingConfiguration(t *testing.T) {
+	defaults := Default().Tracing
+	if defaults.SamplingRatio != 1 {
+		t.Fatalf("default sampling ratio = %v, want 1", defaults.SamplingRatio)
+	}
+	wantPropagators := []TracingPropagator{TracingPropagatorTraceContext, TracingPropagatorBaggage}
+	if !reflect.DeepEqual(defaults.Propagators, wantPropagators) {
+		t.Fatalf("default propagators = %v, want %v", defaults.Propagators, wantPropagators)
+	}
+
+	tests := []struct {
+		name        string
+		contents    string
+		wantRatio   float64
+		wantOptions []TracingPropagator
+		wantErr     string
+	}{
+		{"defaults", "tracing:\n  enabled: true\n", 1, wantPropagators, ""},
+		{"custom", "tracing:\n  samplingRatio: 0.5\n  propagators: [b3, xray]\n", 0.5, []TracingPropagator{TracingPropagatorB3, TracingPropagatorXRay}, ""},
+		{"zero", "tracing:\n  samplingRatio: 0\n", 0, wantPropagators, ""},
+		{"negative", "tracing:\n  samplingRatio: -0.1\n", 0, nil, "sampling ratio should be a number between 0 and 1"},
+		{"above one", "tracing:\n  samplingRatio: 1.1\n", 0, nil, "sampling ratio should be a number between 0 and 1"},
+		{"invalid propagator", "tracing:\n  propagators: [baggage, unknown]\n", 0, nil, "invalid propagator option: unknown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			if err := os.WriteFile(path, []byte(tt.contents), 0600); err != nil {
+				t.Fatal(err)
+			}
+			result, err := Load(path)
+			if tt.wantErr != "" {
+				if err == nil || err.Error() != tt.wantErr {
+					t.Fatalf("Load() error = %v, want %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result.Config.Tracing.SamplingRatio != tt.wantRatio || !reflect.DeepEqual(result.Config.Tracing.Propagators, tt.wantOptions) {
+				t.Fatalf("Load() tracing = %+v, want ratio %v and propagators %v", result.Config.Tracing, tt.wantRatio, tt.wantOptions)
+			}
+		})
+	}
+}
