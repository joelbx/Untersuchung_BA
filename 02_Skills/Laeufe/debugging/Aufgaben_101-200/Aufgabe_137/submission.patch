+func TestNewProviderSamplingRatio(t *testing.T) {
+	for _, tt := range []struct {
+		ratio float64
+		want  bool
+	}{
+		{0, false},
+		{1, true},
+	} {
+		provider, err := NewProvider(context.Background(), "test", tt.ratio)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, span := provider.Tracer("test").Start(context.Background(), "test")
+		if span.IsRecording() != tt.want {
+			t.Errorf("ratio %v: recording = %v, want %v", tt.ratio, span.IsRecording(), tt.want)
+		}
+		span.End()
+		if err := provider.Shutdown(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestNewPropagator(t *testing.T) {
+	for _, tt := range []struct {
+		option config.TracingPropagator
+		field  string
+	}{
+		{config.TracingPropagatorTraceContext, "traceparent"},
+		{config.TracingPropagatorBaggage, "baggage"},
+		{config.TracingPropagatorB3, "x-b3-traceid"},
+		{config.TracingPropagatorB3Multi, "x-b3-traceid"},
+		{config.TracingPropagatorJaeger, "uber-trace-id"},
+		{config.TracingPropagatorXRay, "X-Amzn-Trace-Id"},
+		{config.TracingPropagatorOTTrace, "ot-tracer-traceid"},
+	} {
+		p := NewPropagator([]config.TracingPropagator{tt.option})
+		if !containsField(p.Fields(), tt.field) {
+			t.Errorf("%s fields = %v, want %s", tt.option, p.Fields(), tt.field)
+		}
+	}
+	if fields := NewPropagator([]config.TracingPropagator{config.TracingPropagatorNone}).Fields(); len(fields) != 0 {
+		t.Errorf("none fields = %v, want empty", fields)
+	}
+	spanContext := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    trace.TraceID{1},
+		SpanID:     trace.SpanID{1},
+		TraceFlags: trace.FlagsSampled,
+	})
+	ctx := trace.ContextWithSpanContext(context.Background(), spanContext)
+	for _, tt := range []struct {
+		option config.TracingPropagator
+		field  string
+	}{
+		{config.TracingPropagatorB3, "b3"},
+		{config.TracingPropagatorB3Multi, "x-b3-traceid"},
+	} {
+		carrier := propagation.MapCarrier{}
+		NewPropagator([]config.TracingPropagator{tt.option}).Inject(ctx, carrier)
+		if carrier.Get(tt.field) == "" {
+			t.Errorf("%s injection = %v, want %s", tt.option, carrier, tt.field)
+		}
+	}
+}
+
+func containsField(fields []string, want string) bool {
+	for _, field := range fields {
+		if field == want {
+			return true
+		}
+	}
+	return false
+}
