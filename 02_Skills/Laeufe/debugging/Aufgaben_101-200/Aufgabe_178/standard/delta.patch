+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_filter(ident):
+    result = get_encrypted_password('pw', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+
+
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+def test_bcrypt_ident_crypt(ident):
+    if not encrypt.HAS_CRYPT:
+        pytest.skip('crypt unavailable')
+    result = encrypt.CryptHash('bcrypt').hash('pw', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+
+
+def test_ident_ignored_for_sha256():
+    baseline = get_encrypted_password('pw', 'sha256', salt='12345678')
+    assert get_encrypted_password('pw', 'sha256', salt='12345678', ident='2y') == baseline
+    if encrypt.HAS_CRYPT:
+        baseline = encrypt.CryptHash('sha256_crypt').hash('pw', salt='12345678')
+        assert encrypt.CryptHash('sha256_crypt').hash('pw', salt='12345678', ident='2y') == baseline
+
+
+def test_bcrypt_default_ident_unchanged():
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib unavailable')
+    salt = '123456789012345678901u'
+    assert get_encrypted_password('pw', 'blowfish', salt=salt).startswith('$2b$')
+
+
+def test_invalid_bcrypt_ident():
+    with pytest.raises(AnsibleFilterError):
