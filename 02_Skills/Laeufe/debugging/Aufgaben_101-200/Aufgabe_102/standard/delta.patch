+    def get_locally_reachable_ips(self, ip_path):
+        """Return destinations of Linux local routes with host scope."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, option in (('ipv4', '-4'), ('ipv6', '-6')):
+            command = [ip_path, option, 'route', 'show', 'table', 'local', 'scope', 'host']
+            try:
+                rc, output, err = self.module.run_command(command, errors='surrogate_then_replace')
+            except (IOError, OSError) as exc:
+                self.module.warn('Unable to gather locally reachable %s routes: %s' % (family, exc))
+                continue
+            if rc != 0:
+                reason = err.strip().splitlines()[0] if err.strip() else 'ip route failed'
+                self.module.warn('Unable to gather locally reachable %s routes: %s' % (family, reason))
+                continue
+
+            networks = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if network.version == (4 if family == 'ipv4' else 6):
+                    networks.add(network)
+
+            ordered = sorted(networks, key=lambda item: (int(item.network_address), item.prefixlen))
+            reachable[family] = [str(network.network_address) if network.prefixlen == network.max_prefixlen
+                                 else str(network) for network in ordered]
+        return reachable
+
