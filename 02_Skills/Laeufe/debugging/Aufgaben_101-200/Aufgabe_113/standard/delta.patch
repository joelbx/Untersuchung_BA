+def match_current_rt(rt, direction, current, rt_commands):
+    """Append commands needed for one route-target request in this AF block."""
+    directions = ('import', 'export') if direction == 'both' else (direction,)
+    current_lines = set(line.strip() for line in (current or '').splitlines())
+    for rt_direction in directions:
+        command = 'route-target %s %s' % (rt_direction, rt['rt'])
+        present = command in current_lines
+        if rt['state'] == 'present' and not present:
+            if command not in rt_commands:
+                rt_commands.append(command)
+        elif rt['state'] == 'absent' and present:
+            remove = 'no %s' % command
+            if remove not in rt_commands:
+                rt_commands.append(remove)
+    return rt_commands
