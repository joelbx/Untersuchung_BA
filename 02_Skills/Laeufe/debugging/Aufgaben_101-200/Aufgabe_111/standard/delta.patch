+func TestAmazonEOLDates(t *testing.T) {
+	tests := map[string]time.Time{
+		"2023": time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2025": time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2027": time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2029": time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC),
+	}
+	for release, until := range tests {
+		eol, found := GetEOL(Amazon, release)
+		if !found {
+			t.Errorf("GetEOL(Amazon, %q) not found", release)
+			continue
+		}
+		if !eol.StandardSupportUntil.Equal(until) {
+			t.Errorf("GetEOL(Amazon, %q).StandardSupportUntil = %v, want %v", release, eol.StandardSupportUntil, until)
+		}
+		if eol.IsStandardSupportEnded(until) || eol.IsExtendedSuppportEnded(until) {
+			t.Errorf("Amazon %s ended on its last support day", release)
+		}
+		if !eol.IsStandardSupportEnded(until.Add(time.Second)) || !eol.IsExtendedSuppportEnded(until.Add(time.Second)) {
+			t.Errorf("Amazon %s did not end after its last support day", release)
+		}
+	}
+	if _, found := GetEOL(Amazon, "2024"); found {
+		t.Error("unknown Amazon release found")
+	}
+}
