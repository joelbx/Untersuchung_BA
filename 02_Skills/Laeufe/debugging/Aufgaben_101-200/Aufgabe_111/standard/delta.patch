+func parseAmazonSystemRelease(value string) string {
+	fields := strings.Fields(value)
+	if len(fields) == 5 && fields[0] == "Amazon" && fields[1] == "Linux" && fields[2] == "AMI" && fields[3] == "release" {
+		return fields[4]
+	}
+	if len(fields) >= 3 && fields[0] == "Amazon" && fields[1] == "Linux" {
+		if fields[2] == "release" {
+			if len(fields) >= 4 {
+				return strings.Join(fields[3:], " ")
+			}
+		} else {
+			return strings.Join(fields[2:], " ")
+		}
+	}
+	return "unknown"
+}
