+func TestParseAmazonSystemRelease(t *testing.T) {
+	tests := map[string]string{
+		"Amazon Linux release 2023 (Amazon Linux)":            "2023 (Amazon Linux)",
+		"Amazon Linux release 2023":                           "2023",
+		"Amazon Linux release 2023.9.20251008 (Amazon Linux)": "2023.9.20251008 (Amazon Linux)",
+		"Amazon Linux 2023":                                   "2023",
+		"Amazon Linux release 2 (Karoo)":                      "2 (Karoo)",
+		"Amazon Linux release 2018.03":                        "2018.03",
+		"other release":                                       "unknown",
+	}
+	for input, want := range tests {
+		if got := parseAmazonSystemRelease(input); got != want {
+			t.Errorf("parseAmazonSystemRelease(%q) = %q, want %q", input, got, want)
+		}
+	}
+}
