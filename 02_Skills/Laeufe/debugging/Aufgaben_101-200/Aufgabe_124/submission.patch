@@ -0,0 +1,114 @@
+package dynamo
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/awserr"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbiface"
+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type createTableService struct {
+	dynamodbiface.DynamoDBAPI
+	input *dynamodb.CreateTableInput
+}
+
+type describeTableService struct {
+	dynamodbiface.DynamoDBAPI
+	table *dynamodb.TableDescription
+	err   error
+}
+
+func (s *describeTableService) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	if s.err != nil {
+		return nil, s.err
+	}
+	return &dynamodb.DescribeTableOutput{Table: s.table}, nil
+}
+
+func (s *createTableService) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	s.input = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (s *createTableService) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func TestDefaultBillingModeCreateTable(t *testing.T) {
+	cfg := Config{TableName: "test", ReadCapacityUnits: 17, WriteCapacityUnits: 23}
+	require.NoError(t, cfg.CheckAndSetDefaults())
+	svc := &createTableService{}
+	b := &Backend{Entry: log.NewEntry(log.New()), Config: cfg, svc: svc}
+	require.NoError(t, b.createTable(context.Background(), cfg.TableName, fullPathKey))
+	require.Equal(t, dynamodb.BillingModePayPerRequest, aws.StringValue(svc.input.BillingMode))
+	require.Nil(t, svc.input.ProvisionedThroughput)
+}
+
+func TestProvisionedBillingModeCreateTable(t *testing.T) {
+	cfg := Config{TableName: "test", BillingMode: "provisioned", ReadCapacityUnits: 17, WriteCapacityUnits: 23}
+	require.NoError(t, cfg.CheckAndSetDefaults())
+	svc := &createTableService{}
+	b := &Backend{Entry: log.NewEntry(log.New()), Config: cfg, svc: svc}
+	require.NoError(t, b.createTable(context.Background(), cfg.TableName, fullPathKey))
+	require.Equal(t, dynamodb.BillingModeProvisioned, aws.StringValue(svc.input.BillingMode))
+	require.Equal(t, int64(17), aws.Int64Value(svc.input.ProvisionedThroughput.ReadCapacityUnits))
+	require.Equal(t, int64(23), aws.Int64Value(svc.input.ProvisionedThroughput.WriteCapacityUnits))
+}
+
+func TestBillingModeConfig(t *testing.T) {
+	for _, mode := range []string{"", "pay_per_request", "provisioned"} {
+		cfg := Config{TableName: "test", BillingMode: mode}
+		require.NoError(t, cfg.CheckAndSetDefaults())
+		if mode == "" {
+			require.Equal(t, "pay_per_request", cfg.BillingMode)
+		}
+	}
+	cfg := Config{TableName: "test", BillingMode: "unknown"}
+	require.Error(t, cfg.CheckAndSetDefaults())
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	tests := []struct {
+		name       string
+		svc        *describeTableService
+		wantStatus tableStatus
+		wantMode   string
+	}{
+		{"on demand", &describeTableService{table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"provisioned", &describeTableService{table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)}}}, tableStatusOK, dynamodb.BillingModeProvisioned},
+		{"legacy", &describeTableService{table: &dynamodb.TableDescription{}}, tableStatusOK, ""},
+		{"missing", &describeTableService{err: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)}, tableStatusMissing, ""},
+		{"migration", &describeTableService{table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}}}, tableStatusNeedsMigration, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			b := &Backend{svc: tt.svc}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.NoError(t, err)
+			require.Equal(t, tt.wantStatus, status)
+			require.Equal(t, tt.wantMode, mode)
+		})
+	}
+}
+
+func TestDisableAutoScalingForOnDemand(t *testing.T) {
+	for _, reason := range []string{"the table is on-demand", "the table will be on-demand"} {
+		t.Run(reason, func(t *testing.T) {
+			var output bytes.Buffer
+			logger := log.New()
+			logger.SetOutput(&output)
+			b := &Backend{Entry: log.NewEntry(logger), Config: Config{EnableAutoScaling: true}}
+			b.disableAutoScalingForOnDemand(reason)
+			require.False(t, b.EnableAutoScaling)
+			require.True(t, strings.Contains(output.String(), "auto_scaling is ignored because "+reason))
+		})
+	}
+}
