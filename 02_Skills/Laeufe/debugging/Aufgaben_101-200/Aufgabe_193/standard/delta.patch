diff --git a/test/units/cli/test_galaxy.py b/test/units/cli/test_galaxy.py
index f861846..166f1ee 100644
--- a/test/units/cli/test_galaxy.py
+++ b/test/units/cli/test_galaxy.py
@@ -1215,3 +1215,99 @@ def test_parse_requirements_roles_with_include_missing(requirements_cli, require
 
     with pytest.raises(AnsibleError, match=expected):
         requirements_cli._parse_requirements_file(requirements_file)
+
+
+def test_implicit_install_has_requirements_context():
+    cli = GalaxyCLI(args=['ansible-galaxy', 'install', '-r', 'requirements.yml'])
+    cli.parse()
+    assert context.CLIARGS['requirements'] is None
+    assert cli._implicit_role is True
+
+
+@pytest.mark.parametrize('prefix,custom,roles,collections', [
+    ([], False, True, True),
+    ([], True, True, False),
+    (['role'], False, True, False),
+    (['role'], True, True, False),
+    (['collection'], False, False, True),
+])
+def test_install_mixed_requirements_dispatch(tmp_path, monkeypatch, prefix, custom, roles, collections):
+    requirement = tmp_path / 'requirements.yml'
+    requirement.write_text('roles:\n  - example.role\ncollections:\n  - example.collection\n')
+    role_install = MagicMock()
+    collection_install = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', role_install)
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', collection_install)
+    args = ['ansible-galaxy'] + prefix + ['install', '-r', str(requirement)]
+    if custom:
+        args += ['-p', str(tmp_path / 'roles')]
+    GalaxyCLI(args=args).run()
+    assert role_install.called is roles
+    assert collection_install.called is collections
+    if roles:
+        assert role_install.call_args[0][0][0].name == 'example.role'
+    if collections:
+        assert collection_install.call_args[0][0] == [('example.collection', '*', None)]
+
+
+def test_install_empty_requirements(tmp_path, monkeypatch, capsys):
+    requirement = tmp_path / 'requirements.yml'
+    requirement.write_text('roles: []\ncollections: []\n')
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', MagicMock())
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', MagicMock())
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', str(requirement)]).run()
+    assert 'Skipping install, no requirements found' in capsys.readouterr().out
+    GalaxyCLI._install_roles.assert_not_called()
+    GalaxyCLI._install_collections.assert_not_called()
+
+
+@pytest.mark.parametrize('prefix,custom,expected_warning', [
+    ([], True, True),
+    (['role'], True, False),
+    (['role'], False, False),
+])
+def test_skipped_collections_message(tmp_path, monkeypatch, prefix, custom, expected_warning):
+    requirement = tmp_path / 'requirements.yml'
+    requirement.write_text('collections:\n  - example.collection\n')
+    warnings = MagicMock()
+    verbose = MagicMock()
+    monkeypatch.setattr(ansible.cli.galaxy.display, 'warning', warnings)
+    monkeypatch.setattr(ansible.cli.galaxy.display, 'vvv', verbose)
+    args = ['ansible-galaxy'] + prefix + ['install', '-r', str(requirement)]
+    if custom:
+        args += ['-p', str(tmp_path / 'roles')]
+    GalaxyCLI(args=args).run()
+    assert bool(warnings.call_count) is expected_warning
+    if expected_warning:
+        assert 'Collections cannot be installed to a roles path' in warnings.call_args[0][0]
+    elif custom:
+        assert any('collections which will be ignored' in call[0][0] for call in verbose.call_args_list)
+
+
+def test_invalid_role_requirements_extension(tmp_path):
+    requirement = tmp_path / 'requirements.txt'
+    requirement.write_text('roles: []\n')
+    with pytest.raises(AnsibleError, match='Invalid role requirements file'):
+        GalaxyCLI(args=['ansible-galaxy', 'install', '-r', str(requirement)]).run()
+
+
+def test_collection_install_skips_legacy_roles_file(tmp_path, monkeypatch, capsys):
+    requirement = tmp_path / 'requirements.yml'
+    requirement.write_text('- example.role\n')
+    install = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', install)
+    GalaxyCLI(args=['ansible-galaxy', 'collection', 'install', '-r', str(requirement)]).run()
+    install.assert_not_called()
+    assert 'contains roles which will be ignored' in capsys.readouterr().out
+
+
+def test_implicit_install_uses_default_paths(tmp_path, monkeypatch):
+    requirement = tmp_path / 'requirements.yml'
+    requirement.write_text('roles:\n  - example.role\ncollections:\n  - example.collection\n')
+    role_install = MagicMock()
+    collection_install = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', role_install)
+    monkeypatch.setattr(ansible.cli.galaxy, 'install_collections', collection_install)
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', str(requirement)]).run()
+    assert role_install.call_args[0][0][0].path == os.path.join(C.DEFAULT_ROLES_PATH[0], 'example.role')
+    assert collection_install.call_args[0][1] == os.path.join(C.COLLECTIONS_PATHS[0], 'ansible_collections')
