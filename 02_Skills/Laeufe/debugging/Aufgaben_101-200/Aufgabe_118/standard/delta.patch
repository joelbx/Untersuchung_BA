+def _have_pip_module():
+    """Whether the current Python interpreter can run pip as a module."""
+    try:
+        try:
+            from importlib.util import find_spec
+        except ImportError:
+            from pkgutil import find_loader
+            return find_loader('pip') is not None
+        return find_spec('pip') is not None
+    except Exception:
+        return False
+
