diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..94703b6
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,96 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(conf config.PortScanConf) ([]string, error) {
+	options := []string{}
+	for i, technique := range (&conf).GetScanTechniques() {
+		if technique == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique: %s", conf.ScanTechniques[i])
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+type nmapScan struct {
+	Hosts []struct {
+		Addresses []struct {
+			Addr string `xml:"addr,attr"`
+			Type string `xml:"addrtype,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			ID       string `xml:"portid,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil {
+		return nil, fmt.Errorf("portscan configuration is missing")
+	}
+	if errs := conf.Validate(); len(errs) > 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniques, err := setScanTechniques(*conf)
+	if err != nil {
+		return nil, err
+	}
+	result := []string{}
+	for ip, ports := range scanDestIPPorts {
+		parsedIP := net.ParseIP(ip)
+		if parsedIP == nil {
+			return nil, fmt.Errorf("invalid scan destination IP: %s", ip)
+		}
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && parsedIP.IsLoopback() {
+			continue
+		}
+		if len(ports) == 0 {
+			continue
+		}
+		sortedPorts := append([]string(nil), ports...)
+		sort.Strings(sortedPorts)
+		args := []string{"-oX", "-", "-n", "-Pn"}
+		if conf.HasPrivileged {
+			args = append(args, "--privileged")
+		}
+		args = append(args, techniques...)
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, "-p", strings.Join(sortedPorts, ","), ip)
+		output, err := osExec.Command(conf.ScannerBinPath, args...).Output()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed: %w", ip, err)
+		}
+		var scan nmapScan
+		if err := xml.Unmarshal(output, &scan); err != nil {
+			return nil, fmt.Errorf("parse nmap XML for %s: %w", ip, err)
+		}
+		for _, host := range scan.Hosts {
+			// Use the requested IP: nmap's output can contain additional address types.
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.State == "open" {
+					result = append(result, ip+":"+port.ID)
+				}
+			}
+		}
+	}
+	return result, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
