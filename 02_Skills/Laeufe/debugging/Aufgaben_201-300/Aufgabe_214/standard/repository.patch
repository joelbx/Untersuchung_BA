+package config
+
+import (
+	"os"
+	"testing"
+)
+
+func TestPortScanTechniquesAndZero(t *testing.T) {
+	c := PortScanConf{ScanTechniques: []string{"Ss", "sT", "bad"}}
+	got := c.GetScanTechniques()
+	if len(got) != 3 || got[0] != TCPSYN || got[1] != TCPConnect || got[2] != NotSupportTechnique {
+		t.Fatalf("unexpected techniques: %v", got)
+	}
+	unknown := (&PortScanConf{ScanTechniques: []string{"bad", "worse"}}).GetScanTechniques()
+	if len(unknown) != 1 || unknown[0] != NotSupportTechnique {
+		t.Fatalf("unknown techniques: %v", unknown)
+	}
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("empty configuration must be zero")
+	}
+	if (PortScanConf{SourcePort: "443"}).IsZero() {
+		t.Fatal("source port must make configuration nonzero")
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	dir := t.TempDir()
+	bin := dir + "/nmap"
+	if err := os.WriteFile(bin, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name      string
+		conf      PortScanConf
+		wantError bool
+	}{
+		{"connect", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"ST"}}, false},
+		{"unsupported", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"bad"}}, true},
+		{"multiple", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT", "sS"}}, true},
+		{"unprivileged", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sS"}}, true},
+		{"connect source", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, SourcePort: "443"}, true},
+		{"zero source", PortScanConf{ScannerBinPath: bin, SourcePort: "0"}, true},
+		{"high source", PortScanConf{ScannerBinPath: bin, SourcePort: "65536"}, true},
+		{"missing binary", PortScanConf{ScannerBinPath: dir + "/missing"}, true},
+		{"no binary", PortScanConf{ScanTechniques: []string{"sT"}}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := len(tt.conf.Validate()) != 0; got != tt.wantError {
+				t.Fatalf("Validate error=%v, want %v", tt.conf.Validate(), tt.wantError)
+			}
+		})
+	}
+}
+
+func TestLoadPortScanPerServer(t *testing.T) {
+	old := Conf
+	defer func() { Conf = old }()
+	Conf = Config{}
+	path := t.TempDir() + "/config.toml"
+	data := `[servers]
+[servers.external]
+host = "192.0.2.1"
+user = "test"
+scanModules = ["ospkg", "port"]
+[servers.external.portscan]
+scannerBinPath = "/usr/bin/nmap"
+scanTechniques = ["sT"]
+[servers.native]
+host = "192.0.2.2"
+user = "test"
+scanModules = ["ospkg", "port"]
+`
+	if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	external := Conf.Servers["external"].PortScan
+	if external == nil || !external.IsUseExternalScanner || external.ScannerBinPath != "/usr/bin/nmap" {
+		t.Fatalf("external configuration: %+v", external)
+	}
+	if Conf.Servers["native"].PortScan != nil {
+		t.Fatal("native server gained external scanner")
+	}
+}
