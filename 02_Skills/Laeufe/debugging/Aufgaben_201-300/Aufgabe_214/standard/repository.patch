index 0000000..5920db6
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,37 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	dir := t.TempDir()
+	argsFile := filepath.Join(dir, "args")
+	bin := filepath.Join(dir, "nmap")
+	script := "#!/bin/sh\nprintf '%s\\n' \"$@\" > " + argsFile + "\ncat <<'XML'\n<?xml version=\"1.0\"?><nmaprun><host><address addr=\"192.0.2.1\" addrtype=\"ipv4\"/><ports><port protocol=\"tcp\" portid=\"80\"><state state=\"open\"/></port><port protocol=\"tcp\" portid=\"81\"><state state=\"filtered\"/></port></ports></host></nmaprun>\nXML\n"
+	if err := os.WriteFile(bin, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	b := base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}}
+	got, err := b.execPortsScan(map[string][]string{"192.0.2.1": {"80", "81"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0] != "192.0.2.1:80" {
+		t.Fatalf("ports: %v", got)
+	}
+	args, err := os.ReadFile(argsFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"-oX", "-sT", "-p", "80,81", "192.0.2.1"} {
+		if !strings.Contains(string(args), want+"\n") {
+			t.Fatalf("missing %s in %s", want, args)
+		}
+	}
+}
