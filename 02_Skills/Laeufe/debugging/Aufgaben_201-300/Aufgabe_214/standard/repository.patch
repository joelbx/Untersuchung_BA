new file mode 100644
index 0000000..cc8d97b
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,126 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures a scanner running on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	allUnsupported := len(c.ScanTechniques) > 0
+	for _, name := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for technique := TCPSYN; technique <= TCPXmas; technique++ {
+			if strings.EqualFold(name, technique.String()) {
+				found = technique
+				break
+			}
+		}
+		if found != NotSupportTechnique {
+			allUnsupported = false
+		}
+		scanTechniques = append(scanTechniques, found)
+	}
+	if allUnsupported {
+		return []ScanTechnique{NotSupportTechnique}
+	}
+	return
+}
+
+// Validate checks settings required for external scanning.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath: %w", err))
+	} else if info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is not executable: %s", c.ScannerBinPath))
+	}
+	techniques := (&c).GetScanTechniques()
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan multiple scan techniques are not supported"))
+	}
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan unsupported scan technique: %s", c.ScanTechniques[i]))
+		}
+		if !c.HasPrivileged && technique != TCPConnect && technique != NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan %s requires hasPrivileged", c.ScanTechniques[i]))
+		}
+		if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("portscan sourcePort is incompatible with TCP connect scan"))
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 1 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort must be an integer from 1 to 65535: %s", c.SourcePort))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan capability check failed: %w: %s", err, strings.TrimSpace(string(output))))
+		} else if !regexp.MustCompile(`(?:^|[ ,])cap_net_raw[=+][eip]*e[eip]*(?:$|[ ,])`).Match(output) {
+			errs = append(errs, fmt.Errorf("portscan scannerBinPath lacks cap_net_raw capability or has malformed capability data: %s", strings.TrimSpace(string(output))))
+		}
+	}
+	return
+}
