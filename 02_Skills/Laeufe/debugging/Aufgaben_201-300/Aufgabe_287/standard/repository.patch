+++ b/scanner/image_files_test.go
@@ -0,0 +1,42 @@
+package scanner
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestLoadDirCollectsAllImages(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"cover.jpg", "back.png", "song.mp3"} {
+		if err := os.WriteFile(filepath.Join(dir, name), nil, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, stats, err := loadDir(context.Background(), dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"back.png", "cover.jpg"}; !reflect.DeepEqual(stats.ImageFiles, want) {
+		t.Fatalf("ImageFiles = %v, want %v", stats.ImageFiles, want)
+	}
+	if !stats.HasImages || stats.AudioFilesCount != 1 {
+		t.Fatalf("existing counters changed: %+v", stats)
+	}
+}
+
+func TestAlbumImageFilesAcrossDirectories(t *testing.T) {
+	dirs := dirMap{
+		"/music/a": {ImageFiles: []string{"front.jpg", "back.png"}},
+		"/music/b": {ImageFiles: []string{"cover.jpg"}},
+	}
+	mfs := model.MediaFiles{{Path: "/music/b/one.mp3"}, {Path: "/music/a/two.mp3"}, {Path: "/music/a/three.mp3"}}
+	want := filepath.Join("/music/a", "front.jpg") + string(filepath.ListSeparator) + filepath.Join("/music/a", "back.png") + string(filepath.ListSeparator) + filepath.Join("/music/b", "cover.jpg")
+	if got := albumImageFiles(mfs.Dirs(), dirs); got != want {
+		t.Fatalf("albumImageFiles = %q, want %q", got, want)
+	}
+}
