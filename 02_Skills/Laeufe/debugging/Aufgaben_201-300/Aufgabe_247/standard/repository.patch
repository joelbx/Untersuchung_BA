diff --git a/test/socket-posts-upvoters-unit.js b/test/socket-posts-upvoters-unit.js
new file mode 100644
index 0000000..2f8bd05
--- /dev/null
+++ b/test/socket-posts-upvoters-unit.js
@@ -0,0 +1,70 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+async function main() {
+	const calls = [];
+	let readable = [true, false];
+	const uidLists = [[7, 8, 9, 10, 11, 12, 13], [8, 7]];
+	const names = new Map([[7, 'seven'], [8, 'eight'], [9, 'nine'], [10, 'ten'], [11, 'eleven']]);
+	const user = {
+		isAdministrator: async uid => uid === 1,
+		getUsernamesByUids: async (uids) => {
+			calls.push(['usernames', uids]);
+			return uids.map(uid => names.get(uid));
+		},
+	};
+	const posts = {
+		getCidsByPids: async () => [20, 21],
+		getUpvotedUidsByPids: async () => {
+			calls.push(['votes']);
+			return uidLists;
+		},
+	};
+	const privileges = {
+		categories: {
+			isUserAllowedTo: async (privilege, cids) => {
+				calls.push(['privileges', privilege, cids]);
+				return readable;
+			},
+		},
+	};
+	const mocks = {
+		'../../database': {},
+		'../../user': user,
+		'../../posts': posts,
+		'../../privileges': privileges,
+		'../../meta': {},
+	};
+	const file = path.join(__dirname, '../src/socket.io/posts/votes.js');
+	const context = { module: { exports: {} }, require: id => mocks[id] };
+	vm.runInNewContext(fs.readFileSync(file, 'utf8'), context, { filename: file });
+	const socketPosts = {};
+	context.module.exports(socketPosts);
+
+	await assert.rejects(
+		socketPosts.getUpvoters({ uid: 0 }, [100, 101]),
+		{ message: '[[error:no-privileges]]' }
+	);
+	assert.deepEqual(Array.from(calls.find(call => call[0] === 'privileges')[2]), [20, 21]);
+	assert.equal(calls.some(call => call[0] === 'votes'), false);
+	assert.equal(calls.some(call => call[0] === 'usernames'), false);
+
+	readable = [true, true];
+	const result = await socketPosts.getUpvoters({ uid: 0 }, [100, 101]);
+	assert.equal(result[0].cutoff, 6);
+	assert.equal(result[0].otherCount, 2);
+	assert.deepEqual(Array.from(result[0].usernames), ['seven', 'eight', 'nine', 'ten', 'eleven']);
+	assert.deepEqual(Array.from(result[1].usernames), ['eight', 'seven']);
+	assert.deepEqual(calls.filter(call => call[0] === 'usernames').map(call => Array.from(call[1])), [[7, 8, 9, 10, 11]]);
+	readable = [false, false];
+	assert.equal((await socketPosts.getUpvoters({ uid: 1 }, [100, 101])).length, 2);
+}
+
+main().catch((err) => {
+	console.error(err);
+	process.exitCode = 1;
+});
