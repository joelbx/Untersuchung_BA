 package httplib
 
 import (
+	"errors"
 	"net/http"
 	"net/http/httptest"
 	"testing"
@@ -25,6 +26,56 @@ import (
 	. "gopkg.in/check.v1"
 )
 
+func TestHandlersWithErrorWriter(t *testing.T) {
+	wantErr := errors.New("handler failed")
+	tests := []struct {
+		name        string
+		makeHandler func(func(http.ResponseWriter) (interface{}, error), ErrorWriter) http.HandlerFunc
+	}{
+		{
+			name: "router",
+			makeHandler: func(fn func(http.ResponseWriter) (interface{}, error), writer ErrorWriter) http.HandlerFunc {
+				h := MakeHandlerWithErrorWriter(func(w http.ResponseWriter, _ *http.Request, _ httprouter.Params) (interface{}, error) {
+					return fn(w)
+				}, writer)
+				return func(w http.ResponseWriter, r *http.Request) { h(w, r, nil) }
+			},
+		},
+		{
+			name: "standard",
+			makeHandler: func(fn func(http.ResponseWriter) (interface{}, error), writer ErrorWriter) http.HandlerFunc {
+				return MakeStdHandlerWithErrorWriter(func(w http.ResponseWriter, _ *http.Request) (interface{}, error) {
+					return fn(w)
+				}, writer)
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			called := false
+			writer := func(w http.ResponseWriter, err error) {
+				called = true
+				if err != wantErr {
+					t.Errorf("error writer got %v, want %v", err, wantErr)
+				}
+				w.WriteHeader(http.StatusTeapot)
+			}
+			h := tt.makeHandler(func(http.ResponseWriter) (interface{}, error) { return nil, wantErr }, writer)
+			rw := httptest.NewRecorder()
+			h(rw, httptest.NewRequest(http.MethodGet, "/", nil))
+			if !called || rw.Code != http.StatusTeapot || rw.Header().Get("Cache-Control") == "" {
+				t.Fatalf("writer called=%v, status=%d, headers=%v", called, rw.Code, rw.Header())
+			}
+			h = tt.makeHandler(func(http.ResponseWriter) (interface{}, error) { return map[string]string{"ok": "yes"}, nil }, writer)
+			rw = httptest.NewRecorder()
+			h(rw, httptest.NewRequest(http.MethodGet, "/", nil))
+			if rw.Code != http.StatusOK || rw.Body.String() != "{\"ok\":\"yes\"}" {
+				t.Fatalf("status=%d, body=%q", rw.Code, rw.Body.String())
+			}
+		})
+	}
+}
+
 func TestHTTP(t *testing.T) { TestingT(t) }
 
