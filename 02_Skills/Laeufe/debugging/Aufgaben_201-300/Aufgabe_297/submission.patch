+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestReverseProxyAuthentication(t *testing.T) {
+	oldList, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() { conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldList, oldHeader }()
+	conf.Server.ReverseProxyWhitelist = "bad, 192.0.2.0/24, 2001:db8::/32"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	for _, tc := range []struct {
+		addr    string
+		allowed bool
+	}{
+		{"192.0.2.5:1234", true}, {"[2001:db8::1]:1234", true}, {"198.51.100.5:1234", false}, {"@", false},
+	} {
+		if got := validateIPAgainstList(tc.addr, conf.Server.ReverseProxyWhitelist); got != tc.allowed {
+			t.Errorf("%s: got %v", tc.addr, got)
+		}
+	}
+	if !validateIPAgainstList("@", "192.0.2.0/24,@") || validateIPAgainstList("192.0.2.5:1234", "") {
+		t.Fatal("Unix socket or empty whitelist validation failed")
+	}
+	ds := &tests.MockDataStore{}
+	r := httptest.NewRequest("GET", "/app/", nil)
+	r.RemoteAddr = "192.0.2.5:1234"
+	r.Header.Set("Remote-User", "alice")
+	got := handleLoginFromHeaders(ds, r)
+	if got == nil {
+		t.Fatal("trusted header did not authenticate")
+	}
+	if got["isAdmin"] != true || got["username"] != "alice" || got["subsonicSalt"] == "" || got["subsonicToken"] == "" {
+		t.Fatal("incomplete auth payload")
+	}
+	if _, err := auth.Validate(got["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	u, err := ds.User(r.Context()).FindByUsername("alice")
+	if err != nil || u.LastLoginAt == nil {
+		t.Fatal("user or LastLoginAt missing")
+	}
+	r.RemoteAddr = "198.51.100.5:1234"
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatal("untrusted address authenticated")
+	}
+	r.RemoteAddr = "@"
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatal("untrusted Unix socket authenticated")
+	}
+	conf.Server.ReverseProxyWhitelist = "@"
+	if got := handleLoginFromHeaders(ds, r); got == nil {
+		t.Fatal("trusted Unix socket did not authenticate")
+	}
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	r.RemoteAddr = "192.0.2.5:1234"
+	r.Header.Del("Remote-User")
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatal("missing header authenticated")
+	}
+}
+
+func TestIndexProxyAuthVisibility(t *testing.T) {
+	oldList, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() { conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldList, oldHeader }()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "X-Authenticated-User"
+	ds := &tests.MockDataStore{MockedUser: tests.CreateMockUserRepo()}
+	_ = ds.User(nil).Put(&model.User{ID: "1", UserName: "bob", Name: "Bob", NewPassword: "password"})
+	for _, tc := range []struct {
+		addr          string
+		authenticated bool
+	}{{"192.0.2.2:42", true}, {"198.51.100.2:42", false}} {
+		r := httptest.NewRequest("GET", "/app/", nil)
+		r.RemoteAddr = tc.addr
+		r.Header.Set("X-Authenticated-User", "bob")
+		w := httptest.NewRecorder()
+		serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+		config := extractAppConfig(w.Body.String())
+		payload, ok := config["auth"]
+		if ok != tc.authenticated {
+			t.Errorf("%s: auth present = %v", tc.addr, ok)
+		}
+		if ok {
+			fields := payload.(map[string]interface{})
+			if fields["name"] != "Bob" || fields["isAdmin"] != false {
+				t.Fatal("existing user state lost")
+			}
+		}
+	}
+}
