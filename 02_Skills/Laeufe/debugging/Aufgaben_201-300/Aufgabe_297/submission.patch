+// validateIPAgainstList checks the connection address, never a forwarded address.
+func validateIPAgainstList(address, list string) bool {
+	if strings.TrimSpace(list) == "" {
+		return false
+	}
+	if address == "@" {
+		for _, entry := range strings.Split(list, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	host := address
+	if h, _, err := net.SplitHostPort(address); err == nil {
+		host = h
+	}
+	ip := net.ParseIP(host)
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(list, ",") {
+		entry = strings.TrimSpace(entry)
+		if h, _, err := net.SplitHostPort(entry); err == nil {
+			entry = h
+		}
+		if _, cidr, err := net.ParseCIDR(entry); err == nil {
+			if cidr.Contains(ip) {
+				return true
+			}
+		} else if allowed := net.ParseIP(entry); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	u, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for reverse proxy login", countErr)
+			return nil
+		}
+		u = &model.User{ID: uuid.NewString(), UserName: username, Name: strings.Title(username),
+			NewPassword: uuid.NewString(), IsAdmin: count == 0}
+		if err = repo.Put(u); err != nil {
+			log.Error(r, "Creating reverse proxy user", err)
+			return nil
+		}
+		u.Password = u.NewPassword
+	} else if err != nil {
+		log.Error(r, "Finding reverse proxy user", err)
+		return nil
+	}
+	if err = repo.UpdateLastLoginAt(u.ID); err != nil {
+		log.Error(r, "Updating reverse proxy login time", err)
+		return nil
+	}
+	now := time.Now()
+	u.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(u)
+	if err != nil {
+		log.Error(r, "Creating reverse proxy token", err)
+		return nil
+	}
+	salt := strings.ReplaceAll(uuid.NewString(), "-", "")[:6]
+	subsonicToken := fmt.Sprintf("%x", md5.Sum([]byte(u.Password+salt)))
+	payload := map[string]interface{}{
+		"id": u.ID, "isAdmin": u.IsAdmin, "name": u.Name, "username": u.UserName,
+		"token": token, "subsonicSalt": salt, "subsonicToken": subsonicToken,
+	}
+	if conf.Server.EnableGravatar && u.Email != "" {
+		payload["avatar"] = gravatar.Url(u.Email, 50)
+	}
+	return payload
+}
+
