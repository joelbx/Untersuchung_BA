+func TestNestedMapRedaction(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{"config": map[string]interface{}{
+		"auth":        map[string]interface{}{"token": "secret-token", "name": "Alice"},
+		"description": "Password: hidden",
+	}}}
+	hook := &Hook{RedactionList: []string{`(?i)^token$`, `(Password: ).*`}}
+	if err := hook.Fire(entry); err != nil {
+		t.Fatal(err)
+	}
+	config := entry.Data["config"].(map[string]interface{})
+	auth := config["auth"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", auth["token"])
+	assert.Equal(t, "Alice", auth["name"])
+	assert.Equal(t, "Password: [REDACTED]", config["description"])
+}
+
+func TestDefaultAuthRedaction(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{"appConfig": map[string]interface{}{
+		"auth": map[string]interface{}{"token": "jwt-secret", "subsonicSalt": "salt-secret", "subsonicToken": "subsonic-secret", "username": "alice"},
+	}}}
+	if err := redacted.Fire(entry); err != nil {
+		t.Fatal(err)
+	}
+	auth := entry.Data["appConfig"].(map[string]interface{})["auth"].(map[string]interface{})
