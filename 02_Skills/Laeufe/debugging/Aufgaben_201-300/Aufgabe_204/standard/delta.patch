+/** Parse ISO dates first to preserve local calendar dates, then try common text formats. */
+export const guessDateFromText = (text: string): Date | undefined => {
+    const isoDate = parseISO(text);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+
+    // Do not let Date normalize an invalid ISO calendar date (e.g. February 30).
+    if (/^\d{4}-/.test(text)) {
+        return;
+    }
+
+    const date = new Date(text);
+    return isValid(date) ? date : undefined;
+};
+
+/** Return an existing valid date or parse the text of a birthday or anniversary property. */
 export const getDateFromVCardProperty = ({ value: { date, text } }: VCardProperty<VCardDateOrText>) => {
     if (date && isValid(date)) {
         return date;
-    } else if (text) {
-        // Try to convert the text into a valid date
-        const textToDate = new Date(text);
-        if (isValid(textToDate)) {
-            return textToDate;
-        }
     }
-
-    return new Date();
+    return text ? guessDateFromText(text) : undefined;
 };
