+def response(status):
+    url = 'https://api.meraki.com/api/v0/test'
+    info = {'status': status, 'msg': str(status), 'url': url, 'body': '{}'}
+    if status >= 400:
+        return None, info
+    return mock.Mock(read=mock.Mock(return_value=b'{"ok": true}')), info
+
+
+@pytest.mark.parametrize('status', [400, 404, 503])
+def test_request_raises_http_error_without_retry(module, mocker, status):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url', return_value=response(status))
+    with pytest.raises(HTTPError):
+        module.request('test', method='GET')
+    assert module.status == status
+    assert fetch.call_count == 1
+
+
+def test_request_retries_rate_limit_then_succeeds(module, mocker):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         side_effect=[response(429), response(429), response(200)])
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    warning = mocker.patch.object(module.module, 'warn')
+    assert module.request('test', method='GET') == {'ok': True}
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert sleep.call_count == 2
+    assert '2' in warning.call_args[0][0]
+
+
