+        rate_limit_retries = 0
+        # Three retries give temporary API failures a chance to clear without
+        # allowing a single task to wait indefinitely.
+        for attempt in range(4):
+            resp, info = fetch_url(self.module, self.url,
+                                   headers=self.headers,
+                                   data=payload,
+                                   method=self.method,
+                                   timeout=self.params['timeout'],
+                                   use_proxy=self.params['use_proxy'],
+                                   )
+            self.response = info['msg']
+            self.status = info['status']
+
+            if self.status in (429, 500, 502):
+                if attempt < 3:
+                    if self.status == 429:
+                        rate_limit_retries += 1
+                    time.sleep(1)
+                    continue
+                if rate_limit_retries:
+                    self.module.warn('Meraki rate limiter triggered; performed {0} retries.'.format(rate_limit_retries))
+                message = 'Request failed for {url}: {status} - {msg}'.format(**info)
+                if self.status == 429:
