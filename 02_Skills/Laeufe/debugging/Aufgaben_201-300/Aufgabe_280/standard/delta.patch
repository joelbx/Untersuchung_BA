+func TestNewWithClientEnvironment(t *testing.T) {
+	require.Equal(t, "KUBE_NAMESPACE", NamespaceEnv)
+	require.Equal(t, "RELEASE_NAME", ReleaseNameEnv)
+	client := fake.NewSimpleClientset()
+	for _, tt := range []struct {
+		name, namespace, replica, release, missing string
+	}{
+		{name: "missing namespace", namespace: "", replica: "agent-0", missing: NamespaceEnv},
+		{name: "missing replica", namespace: "test", replica: "", missing: teleportReplicaNameEnv},
+		{name: "configured", namespace: "test", replica: "agent-0", release: "teleport"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv(teleportReplicaNameEnv, tt.replica)
+			t.Setenv(ReleaseNameEnv, tt.release)
+			b, err := NewWithClient(client)
+			if tt.missing != "" {
+				require.EqualError(t, err, "environment variable \""+tt.missing+"\" not set or empty")
+				require.Nil(t, b)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.namespace, b.Namespace)
+			require.Equal(t, tt.replica, b.ReplicaName)
+			require.Equal(t, tt.release, b.ReleaseName)
+			require.Equal(t, "agent-0-state", b.SecretName)
+			require.Equal(t, "teleport", b.genSecretObject().Annotations["meta.helm.sh/release-name"])
+			require.Equal(t, "test", b.genSecretObject().Annotations["meta.helm.sh/release-namespace"])
+		})
+	}
+}
