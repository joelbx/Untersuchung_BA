 )
@@ -82,3 +83,70 @@ func TestRemoveInactive(t *testing.T) {
 		}
 	}
 }
+
+func TestConvertToVinfosEnterpriseAndBasic(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		optional string
+		summary  string
+		metadata map[string]string
+		score    float64
+		vector   string
+		severity string
+		fixedIn  string
+	}{
+		{
+			name:     "enterprise",
+			optional: `,"description":"Detailed summary","poc":"https://example.org/poc","introduced_in":"6.0","cvss":{"score":8.1,"vector":"CVSS:3.1/AV:N","severity":"HIGH"},"fixed_in":"6.2.1"`,
+			summary:  "Detailed summary", metadata: map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.0"},
+			score: 8.1, vector: "CVSS:3.1/AV:N", severity: "HIGH", fixedIn: "6.2.1",
+		},
+		{
+			name:     "basic",
+			optional: `,"description":null,"poc":null,"introduced_in":null,"cvss":null,"fixed_in":null`,
+			metadata: map[string]string{},
+		},
+		{
+			name:     "omitted",
+			metadata: map[string]string{},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := `{"62":{"vulnerabilities":[{"id":"42","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/one","https://example.org/two"]}` + tc.optional + `}]}}`
+			vinfos, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d records, want 1", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2024-1234" || v.VulnType != "XSS" {
+				t.Fatalf("identifier or type: %+v", v)
+			}
+			if len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].FixedIn != tc.fixedIn {
+				t.Fatalf("fix status: %+v", v.WpPackageFixStats)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("WPScan contents: %+v", contents)
+			}
+			c := contents[0]
+			if c.Type != models.WpScan || c.CveID != v.CveID || c.Summary != tc.summary {
+				t.Fatalf("content identity/summary: %+v", c)
+			}
+			if c.Cvss3Score != tc.score || c.Cvss3Vector != tc.vector || c.Cvss3Severity != tc.severity {
+				t.Fatalf("CVSS: %+v", c)
+			}
+			if !reflect.DeepEqual(c.Optional, tc.metadata) {
+				t.Fatalf("optional: got %#v, want %#v", c.Optional, tc.metadata)
+			}
+			if len(c.References) != 2 || c.References[0].Link != "https://example.org/one" || c.References[1].Link != "https://example.org/two" {
+				t.Fatalf("references: %+v", c.References)
+			}
+			if c.Published.Format("2006-01-02T15:04:05Z07:00") != "2024-01-02T01:04:05Z" || c.LastModified.Format("2006-01-02T15:04:05Z07:00") != "2024-02-03T02:05:06Z" || c.Published.Location() != time.UTC || c.LastModified.Location() != time.UTC {
+				t.Fatalf("timestamps: %v, %v", c.Published, c.LastModified)
+			}
+		})
+	}
+}
