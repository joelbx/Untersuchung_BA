+// Result contains every validation error found in a YAML document.
+type Result struct {
+	Errors []Error `json:"errors"`
+}
+
+// FeaturesValidator validates YAML feature definitions against the embedded schema.
+type FeaturesValidator struct {
+	cue *cue.Context
+	v   cue.Value
+}
+
+func NewFeaturesValidator() (*FeaturesValidator, error) {
+	cctx := cuecontext.New()
+	v := cctx.CompileBytes(cueFile)
+	if err := v.Err(); err != nil {
+		return nil, err
+	}
+	return &FeaturesValidator{cue: cctx, v: v}, nil
+}
+
+// Validate checks a YAML document and returns all errors with their source locations.
+func (fv *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	result := Result{Errors: make([]Error, 0)}
+	f, err := yaml.Extract(file, b)
+	if err == nil {
+		yv := fv.v.Unify(fv.cue.BuildFile(f, cue.Scope(fv.v)))
+		err = yv.Validate()
+	}
+	if err == nil {
+		return result, nil
+	}
+
+	for _, e := range cueerror.Errors(err) {
+		pos := e.Position()
+		for _, input := range e.InputPositions() {
+			if input.Filename() == file {
+				pos = input
+				break
+			}
+		}
+		line, column := pos.Line(), pos.Column()
+		if line == 0 {
+			// YAML parser errors carry a line in their text, but no token position.
+			location := strings.TrimPrefix(e.Error(), file+":")
+			if parsed, parseErr := strconv.Atoi(strings.SplitN(location, ":", 2)[0]); parseErr == nil {
+				line, column = parsed, 1
+			}
+		}
+		result.Errors = append(result.Errors, Error{
+			Field:    strings.Join(e.Path(), "."),
+			Message:  e.Error(),
+			Location: Location{File: file, Line: line, Column: column},
+		})
+	}
+	return result, ErrValidationFailed
+}
+
