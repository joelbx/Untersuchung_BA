 )
 
+func TestFeaturesValidatorReportsAllErrors(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	b := []byte("flags:\n- ey: bad\n  name: good\n  nabled: true\n  variants: []\n  rules:\n  - segment: x\n    rank: 1\n    distributions:\n    - variant: a\n      rollout: 110\nsegments: []\n")
+	result, err := validator.Validate("input.yaml", b)
+	require.True(t, errors.Is(err, ErrValidationFailed))
+	require.Len(t, result.Errors, 3)
+	require.Equal(t, "flags.0.ey", result.Errors[0].Field)
+	require.Equal(t, Location{File: "input.yaml", Line: 2, Column: 4}, result.Errors[0].Location)
+	require.Contains(t, result.Errors[0].Message, "ey: field not allowed")
+	require.Equal(t, "flags.0.nabled", result.Errors[1].Field)
+	require.Equal(t, Location{File: "input.yaml", Line: 4, Column: 4}, result.Errors[1].Location)
+	require.Equal(t, "flags.0.rules.0.distributions.0.rollout", result.Errors[2].Field)
+	require.Equal(t, Location{File: "input.yaml", Line: 11, Column: 17}, result.Errors[2].Location)
+	require.Contains(t, result.Errors[2].Message, "rollout: invalid value 110 (out of bound <=100)")
+}
+
+func TestValidateFilesJSON(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "input.yaml")
+	b := []byte("flags:\n- ey: bad\n  name: good\n  variants: []\n  rules: []\nsegments: []\n")
+	require.NoError(t, os.WriteFile(file, b, 0600))
+	var out bytes.Buffer
+	require.ErrorIs(t, ValidateFiles(&out, []string{file}, jsonFormat), ErrValidationFailed)
+	var result Result
+	require.NoError(t, json.Unmarshal(out.Bytes(), &result))
+	require.Len(t, result.Errors, 1)
+	require.Equal(t, "flags.0.ey", result.Errors[0].Field)
+	require.Equal(t, Location{File: file, Line: 2, Column: 4}, result.Errors[0].Location)
+}
+
+func TestFeaturesValidatorYAMLSyntaxError(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	result, err := validator.Validate("broken.yaml", []byte("flags: [\n"))
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.NotEmpty(t, result.Errors)
+	require.Equal(t, "broken.yaml", result.Errors[0].Location.File)
+	require.Greater(t, result.Errors[0].Location.Line, 0)
+	require.NotEmpty(t, result.Errors[0].Message)
+}
+
+func TestValidateFilesReportsFieldsAndSourceLocations(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "input.yaml")
+	b := []byte("flags:\n- ey: bad\n  name: good\n  nabled: true\n  variants: []\n  rules:\n  - segment: x\n    rank: 1\n    distributions:\n    - variant: a\n      rollout: 110\nsegments: []\n")
+	require.NoError(t, os.WriteFile(file, b, 0600))
+	var out bytes.Buffer
+	require.ErrorIs(t, ValidateFiles(&out, []string{file}, textFormat), ErrValidationFailed)
+	for _, expected := range []string{"flags.0.ey", "flags.0.nabled", "flags.0.rules.0.distributions.0.rollout", "Line   : 2", "Line   : 4", "Line   : 11"} {
+		require.True(t, strings.Contains(out.String(), expected), "missing %q in %s", expected, out.String())
+	}
+}
