diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..d0cbc3e
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,97 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+import useGetCalendarSetup from '../hooks/useGetCalendarSetup';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ loading: false, error: false })),
+}));
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ handleCreateCalendar: jest.fn() })),
+}));
+jest.mock('../../../hooks', () => ({ useLoading: () => [false, jest.fn()] }));
+jest.mock('../../error', () => ({ GenericError: () => null }));
+jest.mock('../../../components', () => {
+    const React = require('react');
+    return {
+        BasicModal: ({ children, footer }: any) => (
+            <form>
+                {children}
+                {footer}
+            </form>
+        ),
+        Button: ({ children, disabled, type }: any) => (
+            <button type={type} disabled={disabled}>
+                {children}
+            </button>
+        ),
+        Form: 'form',
+        Href: ({ children }: any) => <a>{children}</a>,
+        InputFieldTwo: ({ value, onChange, warning, error, maxLength }: any) => (
+            <div>
+                <input aria-label="Calendar URL" value={value} onChange={onChange} maxLength={maxLength} />
+                {warning && <span>{warning}</span>}
+                {error && <span>{error}</span>}
+            </div>
+        ),
+        Loader: () => null,
+    };
+});
+
+describe('SubscribeCalendarModal URL validation', () => {
+    const setURL = (value: string) =>
+        fireEvent.change(screen.getByRole('textbox', { name: 'Calendar URL' }), { target: { value } });
+    const submit = () => screen.getByRole('button', { name: 'Add calendar' });
+
+    it('accepts the maximum length and blocks longer URLs with a warning', () => {
+        expect(MAX_LENGTHS_API.CALENDAR_URL).toBe(10000);
+        render(<SubscribeCalendarModal isOpen />);
+        expect(submit()).toBeDisabled();
+        expect(screen.getByRole('textbox', { name: 'Calendar URL' })).not.toHaveAttribute('maxLength');
+        const prefix = 'https://example.com/';
+        setURL(prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length));
+        expect(submit()).toBeEnabled();
+        setURL(prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length + 1));
+        expect(submit()).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+    });
+
+    it('shows the highest priority warning and trims input', () => {
+        render(<SubscribeCalendarModal isOpen />);
+        setURL('  https://calendar.google.com/public/example  ');
+        expect(screen.getByRole('textbox', { name: 'Calendar URL' })).toHaveValue(
+            'https://calendar.google.com/public/example'
+        );
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        setURL('https://calendar.google.com/public/example.ics');
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('This link might be wrong')).not.toBeInTheDocument();
+    });
+
+    it('prioritizes extension and Google public warnings over length', () => {
+        render(<SubscribeCalendarModal isOpen />);
+        const extensionPrefix = 'https://calendar.google.com/public/';
+        setURL(extensionPrefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - extensionPrefix.length + 1));
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(submit()).toBeDisabled();
+
+        const publicPrefix = 'https://calendar.google.com/public/';
+        setURL(publicPrefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - publicPrefix.length) + '.ics');
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(submit()).toBeDisabled();
+    });
+
+    it('uses the same disabled state when calendar setup fails', () => {
+        (useGetCalendarSetup as jest.Mock).mockReturnValueOnce({ loading: false, error: true });
+        render(<SubscribeCalendarModal isOpen />);
+        expect(screen.getByRole('button', { name: 'Close' })).toBeDisabled();
+    });
+});
