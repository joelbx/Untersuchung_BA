+++ b/test/units/executor/module_common/test_modify_module.py
@@ -41,3 +41,46 @@ def test_shebang_task_vars(fake_old_module_open, templar):
 
     (data, style, shebang) = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
     assert shebang == '#!/usr/bin/python3'
+
+
+@pytest.mark.parametrize('source, expected', [
+    (b'#!/usr/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n', '#!/usr/bin/python3.8 -I'),
+    (b'#!/usr/bin/python3.8  -X "dev mode"\nfrom ansible.module_utils.basic import AnsibleModule\n', '#!/usr/bin/python3.8  -X "dev mode"'),
+    (b'from ansible.module_utils.basic import AnsibleModule\n', '#!/usr/bin/python'),
+])
+def test_new_style_source_shebang(tmp_path, templar, source, expected):
+    module_path = tmp_path / 'source_module.py'
+    module_path.write_bytes(source)
+    data, style, shebang = modify_module('source_module', str(module_path), {}, templar)
+    assert style == 'new'
+    assert shebang == expected
+    assert data.startswith((expected + '\n# -*- coding: utf-8 -*-\n').encode())
+
+
+def test_new_style_override_keeps_source_args(tmp_path, templar):
+    module_path = tmp_path / 'source_module.py'
+    module_path.write_bytes(b'#!/opt/venv/bin/python -I\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    data, style, shebang = modify_module('source_module', str(module_path), {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/usr/bin/python3.8'})
+    assert style == 'new'
+    assert shebang == '#!/usr/bin/python3.8 -I'
+    assert data.startswith(b'#!/usr/bin/python3.8 -I\n# -*- coding: utf-8 -*-\n')
+
+
+def test_old_style_keeps_shebang_bytes_when_interpreter_unchanged(tmp_path, templar):
+    module_path = tmp_path / 'source_module'
+    module_path.write_bytes(b'#!/usr/bin/ruby  -w\nputs "hello"\n')
+    data, style, shebang = modify_module('source_module', str(module_path), {}, templar)
+    assert style == 'old'
+    assert shebang == '#!/usr/bin/ruby  -w'
+    assert data.startswith(b'#!/usr/bin/ruby  -w\n# -*- coding: utf-8 -*-\n')
+
+
+def test_old_style_override_preserves_quoted_args(tmp_path, templar):
+    module_path = tmp_path / 'source_module'
+    module_path.write_bytes(b'#!/usr/bin/ruby  -e "puts 1"\nputs "hello"\n')
+    data, style, shebang = modify_module('source_module', str(module_path), {}, templar,
+                                         task_vars={'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'})
+    assert style == 'old'
+    assert shebang == '#!/opt/ruby/bin/ruby  -e "puts 1"'
+    assert data.startswith(b'#!/opt/ruby/bin/ruby  -e "puts 1"\n# -*- coding: utf-8 -*-\n')
