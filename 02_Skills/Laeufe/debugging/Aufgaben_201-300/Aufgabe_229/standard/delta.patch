diff --git a/test/manual/image-cleanup.js b/test/manual/image-cleanup.js
new file mode 100644
index 0000000..0ffb6ca
--- /dev/null
+++ b/test/manual/image-cleanup.js
@@ -0,0 +1,100 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const nconf = require('nconf');
+const Module = require('module');
+
+const data = {};
+const db = {
+	getObjectFields: async (key, fields) => Object.fromEntries(
+		fields.map(field => [field, data[key] && data[key][field]])
+	),
+	deleteObjectFields: async (key, fields) => fields.forEach(field => delete data[key][field]),
+};
+const originalLoad = Module._load;
+Module._load = function (request, parent, isMain) {
+	if (request === '../database' && /src\/(user\/picture|groups\/cover)\.js$/.test(parent.filename)) return db;
+	if (request === '../meta' && /src\/user\/picture\.js$/.test(parent.filename)) return { config: {} };
+	if (request === '../plugins' && /src\/user\/picture\.js$/.test(parent.filename)) return { hooks: { hasListeners: () => false } };
+	if (request === '../image' && /src\/(user\/picture|groups\/cover)\.js$/.test(parent.filename)) return {};
+	return originalLoad.call(this, request, parent, isMain);
+};
+
+nconf.use('memory');
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'image-cleanup-'));
+nconf.set('upload_path', root);
+nconf.set('relative_path', '/forum');
+fs.mkdirSync(path.join(root, 'profile'));
+fs.mkdirSync(path.join(root, 'files'));
+const User = {
+	getUserFields: async (uid, fields) => db.getObjectFields(`user:${uid}`, fields),
+	getUserField: async (uid, field) => (data[`user:${uid}`] || {})[field],
+	setUserFields: async (uid, fields) => Object.assign(data[`user:${uid}`], fields),
+};
+require('../../src/user/picture')(User);
+
+const Groups = {};
+require('../../src/groups/cover')(Groups);
+
+Module._load = originalLoad;
+nconf.set('upload_path', root);
+nconf.set('relative_path', '/forum');
+
+(async () => {
+	try {
+		const uid = 987654;
+		const avatar = `${uid}-profileavatar-123.jpeg`;
+		const cover = `${uid}-profilecover-123.png`;
+		for (const name of [avatar, `${uid}-profileavatar.bmp`, cover, `${uid}-profilecover.jpg`]) {
+			fs.writeFileSync(path.join(root, 'profile', name), 'image');
+		}
+		data[`user:${uid}`] = {
+			uploadedpicture: `/forum/assets/uploads/profile/${avatar}`,
+			picture: `/forum/assets/uploads/profile/${avatar}`,
+			'cover:url': `/forum/assets/uploads/profile/${cover}`,
+			'cover:position': '50% 50%',
+		};
+		assert.strictEqual(await User.getLocalAvatarPath(uid), path.join(root, 'profile', avatar));
+		assert.strictEqual(await User.getLocalCoverPath(uid), path.join(root, 'profile', cover));
+		const old = await User.removeProfileImage(uid);
+		assert.strictEqual(old.uploadedpicture, `/forum/assets/uploads/profile/${avatar}`);
+		assert.strictEqual(old.picture, old.uploadedpicture);
+		assert.deepStrictEqual(fs.readdirSync(path.join(root, 'profile')).sort(), [`${uid}-profilecover.jpg`, cover].sort());
+		await User.removeCoverPicture(uid);
+		assert.deepStrictEqual(fs.readdirSync(path.join(root, 'profile')), []);
+		assert.strictEqual(data[`user:${uid}`]['cover:url'], undefined);
+		const group = 'Cleanup';
+		const names = [`groupCover-${group}.png`, `groupCoverThumb-${group}.png`];
+		for (const name of [...names, `groupCover-${group}.jpeg`, `groupCoverThumb-${group}.bmp`]) {
+			fs.writeFileSync(path.join(root, 'files', name), 'image');
+		}
+		data[`group:${group}`] = {
+			'cover:url': `/forum/assets/uploads/files/${names[0]}`,
+			'cover:thumb:url': `/forum/assets/uploads/files/${names[1]}`,
+			'cover:position': '50% 50%',
+		};
+		await Groups.removeCover({ groupName: group });
+		assert.deepStrictEqual(fs.readdirSync(path.join(root, 'files')), []);
+
+		const other = path.join(root, 'profile', 'another-user.png');
+		fs.writeFileSync(other, 'keep');
+		data[`user:${uid}`].uploadedpicture = '/forum/assets/uploads/profile/../another-user.png';
+		data[`user:${uid}`].picture = '/external/avatar.png';
+		assert.strictEqual(await User.getLocalAvatarPath(uid), false);
+		const previous = await User.removeProfileImage(uid);
+		assert.strictEqual(previous.picture, '/external/avatar.png');
+		assert.strictEqual(data[`user:${uid}`].picture, '/external/avatar.png');
+		assert.strictEqual(fs.readFileSync(other, 'utf8'), 'keep');
+		await User.removeCoverPicture(uid); // Missing files are harmless.
+
+		data[`group:${group}`]['cover:url'] = '/forum/assets/uploads/files/../another-user.png';
+		await Groups.removeCover({ groupName: group });
+		assert.strictEqual(fs.readFileSync(other, 'utf8'), 'keep');
+		console.log('image cleanup test passed');
+	} finally {
+		fs.rmSync(root, { recursive: true, force: true });
+	}
+})().catch((err) => { console.error(err); process.exitCode = 1; });
