 	Groups.removeCover = async function (data) {
-		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
+		const key = `group:${data.groupName}`;
+		const fields = ['cover:url', 'cover:thumb:url', 'cover:position'];
+		const covers = await db.getObjectFields(key, fields);
+		const prefix = `${nconf.get('relative_path') || ''}/assets/uploads/files/`;
+		const filenames = new Set();
+		for (const field of ['cover:url', 'cover:thumb:url']) {
