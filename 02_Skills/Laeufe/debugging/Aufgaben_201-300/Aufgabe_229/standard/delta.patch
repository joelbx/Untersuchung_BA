+					filenames.add(filename);
+					const extension = path.extname(filename).slice(1).toLowerCase();
+					if (['png', 'jpeg', 'jpg', 'bmp'].includes(extension)) {
+						const stem = filename.slice(0, -(extension.length + 1));
+						for (const ext of ['png', 'jpeg', 'jpg', 'bmp']) filenames.add(`${stem}.${ext}`);
+					}
+				}
+			}
+		}
+		await Promise.all([...filenames].map(async (filename) => {
+			try {
+				await fs.promises.unlink(path.join(nconf.get('upload_path'), 'files', filename));
+			} catch (err) {
+				if (err.code !== 'ENOENT') throw err;
+			}
+		}));
+		await db.deleteObjectFields(key, fields);
 	};
 };
