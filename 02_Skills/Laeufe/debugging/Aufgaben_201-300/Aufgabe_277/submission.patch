diff --git a/internal/server/audit/types_segments_test.go b/internal/server/audit/types_segments_test.go
new file mode 100644
index 0000000..347114d
--- /dev/null
+++ b/internal/server/audit/types_segments_test.go
@@ -0,0 +1,68 @@
+package audit
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestRuleAuditSegments(t *testing.T) {
+	for _, tc := range []struct {
+		name, legacyKey       string
+		keys                  []string
+		wantKey, wantOperator string
+	}{
+		{name: "legacy single", legacyKey: "legacy", wantKey: "legacy"},
+		{name: "one key", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple keys", keys: []string{"first", "second"}, wantKey: "first,second", wantOperator: "AND_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := NewRule(&flipt.Rule{SegmentKey: tc.legacyKey, SegmentKeys: tc.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR})
+			require.Equal(t, tc.wantKey, got.SegmentKey)
+			require.Equal(t, tc.wantOperator, got.SegmentOperator)
+			data, err := json.Marshal(got)
+			require.NoError(t, err)
+			var fields map[string]any
+			require.NoError(t, json.Unmarshal(data, &fields))
+			if tc.wantOperator == "" {
+				require.NotContains(t, fields, "segment_operator")
+			} else {
+				require.Equal(t, tc.wantOperator, fields["segment_operator"])
+			}
+		})
+	}
+}
+
+func TestRolloutAuditSegments(t *testing.T) {
+	for _, tc := range []struct {
+		name, legacyKey       string
+		keys                  []string
+		wantKey, wantOperator string
+	}{
+		{name: "legacy single", legacyKey: "legacy", wantKey: "legacy"},
+		{name: "one key", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple keys", keys: []string{"first", "second"}, wantKey: "first,second", wantOperator: "OR_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+				SegmentKey: tc.legacyKey, SegmentKeys: tc.keys, SegmentOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR, Value: true,
+			}}})
+			require.NotNil(t, got.Segment)
+			require.Equal(t, tc.wantKey, got.Segment.Key)
+			require.True(t, got.Segment.Value)
+			require.Equal(t, tc.wantOperator, got.Segment.Operator)
+			data, err := json.Marshal(got)
+			require.NoError(t, err)
+			var fields map[string]any
+			require.NoError(t, json.Unmarshal(data, &fields))
+			segment := fields["segment"].(map[string]any)
+			if tc.wantOperator == "" {
+				require.NotContains(t, segment, "operator")
+			} else {
+				require.Equal(t, tc.wantOperator, segment["operator"])
+			}
+		})
+	}
+}
