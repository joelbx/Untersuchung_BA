+const clientUniqueIDCookie = "nd-client-unique-id"
+
+func clientUniqueID(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		id := r.Header.Get(consts.UIClientUniqueIDHeader)
+		if id != "" {
+			http.SetCookie(w, &http.Cookie{Name: clientUniqueIDCookie, Value: id, Path: "/", MaxAge: consts.CookieExpiry, HttpOnly: true})
+		} else if cookie, err := r.Cookie(clientUniqueIDCookie); err == nil {
+			id = cookie.Value
+		}
+		if id != "" {
+			r = r.WithContext(request.WithClientUniqueId(r.Context(), id))
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func loggerContext(next http.Handler) http.Handler {
