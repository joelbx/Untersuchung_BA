diff --git a/server/events/sse_filter_test.go b/server/events/sse_filter_test.go
new file mode 100644
index 0000000..77e75cf
--- /dev/null
+++ b/server/events/sse_filter_test.go
@@ -0,0 +1,76 @@
+package events
+
+import (
+	"context"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+func TestSelectiveDelivery(t *testing.T) {
+	b := NewBroker().(*broker)
+	makeClient := func(username, id string) client {
+		ctx := request.WithUser(context.Background(), model.User{UserName: username})
+		ctx = request.WithClientUniqueId(ctx, id)
+		return b.subscribe(httptest.NewRequest("GET", "/events", nil).WithContext(ctx))
+	}
+	origin := makeClient("alice", "origin")
+	sameUser := makeClient("alice", "other")
+	otherUser := makeClient("bob", "bob")
+	defer b.unsubscribe(origin)
+	defer b.unsubscribe(sameUser)
+	defer b.unsubscribe(otherUser)
+	for _, c := range []client{origin, sameUser, otherUser} {
+		deadline := time.After(time.Second)
+		for {
+			if _, ok := c.diode.tryNext(); ok {
+				break
+			}
+			select {
+			case <-deadline:
+				t.Fatal("server start not received")
+			default:
+				time.Sleep(time.Millisecond)
+			}
+		}
+	}
+	ctx := request.WithUser(context.Background(), model.User{UserName: "alice"})
+	ctx = request.WithClientUniqueId(ctx, "origin")
+	b.SendMessage(ctx, &RefreshResource{})
+	deadline := time.After(time.Second)
+	for {
+		if _, ok := sameUser.diode.tryNext(); ok {
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("same user did not receive event")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if _, ok := origin.diode.tryNext(); ok {
+		t.Error("origin received its own event")
+	}
+	if _, ok := otherUser.diode.tryNext(); ok {
+		t.Error("other user received event")
+	}
+	b.SendMessage(context.Background(), &KeepAlive{})
+	deadline = time.After(time.Second)
+	for _, c := range []client{origin, sameUser, otherUser} {
+		for {
+			if _, ok := c.diode.tryNext(); ok {
+				break
+			}
+			select {
+			case <-deadline:
+				t.Fatal("background event was not broadcast")
+			default:
+				time.Sleep(time.Millisecond)
+			}
+		}
+	}
+}
