+package models
+
+import "testing"
+
+func TestKEVSummaryAndSort(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"one": {KEVs: []KEV{
+			{Type: VulnCheckKEVType, VulnerabilityName: "Z"},
+			{Type: CISAKEVType, VulnerabilityName: "Z"},
+			{Type: CISAKEVType, VulnerabilityName: "A"},
+		}},
+		"two":   {},
+		"three": {KEVs: []KEV{{Type: CISAKEVType}}},
+	}}
+	if got := r.FormatKEVCveSummary(); got != "2 KEVs" {
+		t.Fatalf("summary = %q", got)
+	}
+	r.SortForJSONOutput()
+	entries := r.ScannedCves["one"].KEVs
+	if entries[0].VulnerabilityName != "A" || entries[1].VulnerabilityName != "Z" || entries[2].Type != VulnCheckKEVType {
+		t.Fatalf("unexpected order: %+v", entries)
+	}
+}
