index 0000000..f4afb2d
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,30 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestKEVMapping(t *testing.T) {
+	added := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	response := kevulndb.Response{
+		CISA:      []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", Product: "c product", VulnerabilityName: "C name", ShortDescription: "C desc", RequiredAction: "C action", KnownRansomwareCampaignUse: "Known", DateAdded: added, Notes: "C note"}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "VC vendor", Product: "v product", Name: "V name", Description: "V desc", RequiredAction: "V action", KnownRansomwareCampaignUse: "Unknown", DateAdded: added, DueDate: &added, VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{XDBID: "xdb", XDBURL: "https://xdb", DateAdded: added, ExploitType: "poc", CloneSSHURL: "git@xdb"}}, VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://report", DateAdded: added}}}},
+	}
+	got := toKEVs(response)
+	if len(got) != 2 {
+		t.Fatalf("got %d KEVs", len(got))
+	}
+	if got[0].Type != models.CISAKEVType || got[0].VendorProject != "CISA vendor" || got[0].Product != "c product" || got[0].VulnerabilityName != "C name" || got[0].ShortDescription != "C desc" || got[0].RequiredAction != "C action" || got[0].KnownRansomwareCampaignUse != "Known" || !got[0].DateAdded.Equal(added) || got[0].DueDate != nil || got[0].CISA == nil || got[0].CISA.Note != "C note" {
+		t.Errorf("CISA mapping: %+v", got[0])
+	}
+	if got[1].Type != models.VulnCheckKEVType || got[1].VendorProject != "VC vendor" || got[1].Product != "v product" || got[1].VulnerabilityName != "V name" || got[1].ShortDescription != "V desc" || got[1].RequiredAction != "V action" || got[1].KnownRansomwareCampaignUse != "Unknown" || !got[1].DateAdded.Equal(added) || got[1].DueDate == nil || !got[1].DueDate.Equal(added) || got[1].VulnCheck == nil || len(got[1].VulnCheck.XDB) != 1 || got[1].VulnCheck.XDB[0].CloneSSHURL != "git@xdb" || len(got[1].VulnCheck.ReportedExploitation) != 1 {
+		t.Errorf("VulnCheck mapping: %+v", got[1])
+	}
+}
