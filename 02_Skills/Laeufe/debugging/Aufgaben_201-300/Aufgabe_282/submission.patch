@@ -45,3 +46,64 @@ def test_custom_headers(config_stub, dnt, accept_language, custom_headers,
 
     expected_items = sorted(expected.items())
     assert shared.custom_headers(url=None) == expected_items
+
+
+@pytest.mark.parametrize('level, source, msg, expected', [
+    (usertypes.JsLogLevel.error, 'userscript:style', 'ordinary error', True),
+    (usertypes.JsLogLevel.error, 'userscript:style',
+     'Refused to apply inline style because of CSP', False),
+    (usertypes.JsLogLevel.error, 'qute:internal',
+     'Refused to apply inline style because of CSP', True),
+    (usertypes.JsLogLevel.warning, 'userscript:style', 'ordinary warning', False),
+    (usertypes.JsLogLevel.unknown, 'userscript:style', 'ordinary error', False),
+])
+def test_js_log_to_ui(monkeypatch, level, source, msg, expected):
+    shown = []
+    monkeypatch.setattr(shared.config, 'cache', {
+        'content.javascript.log_message.levels': {
+            'userscript:*': ['error'], 'qute:*': ['error']},
+        'content.javascript.log_message.excludes': {
+            '*': ['Unrelated*'],
+            'userscript:*': ['Refused to apply inline style*']},
+    })
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, usertypes.JsLogLevel.error,
+                        shown.append)
+
+    assert shared._js_log_to_ui(level, source, 66, msg) is expected
+    assert shown == ([f'JS: [{source}:66] {msg}'] if expected else [])
+
+
+@pytest.mark.parametrize('level', [usertypes.JsLogLevel.info,
+                                   usertypes.JsLogLevel.warning])
+def test_js_log_to_ui_message_level(monkeypatch, level):
+    shown = []
+    monkeypatch.setattr(shared.config, 'cache', {
+        'content.javascript.log_message.levels': {'qute:*': [level.name]},
+        'content.javascript.log_message.excludes': {},
+    })
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, level, shown.append)
+
+    assert shared._js_log_to_ui(level, 'qute:script', 2, 'notice')
+    assert shown == ['JS: [qute:script:2] notice']
+
+
+def test_javascript_log_message_excluded_goes_to_logger(monkeypatch):
+    shown = []
+    logged = []
+    monkeypatch.setattr(shared.config, 'cache', {
+        'content.javascript.log_message.levels': {'userscript:*': ['error']},
+        'content.javascript.log_message.excludes': {
+            'userscript:*': ['Refused*']},
+        'content.javascript.log': {'error': 'error'},
+    })
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, usertypes.JsLogLevel.error,
+                        shown.append)
+    monkeypatch.setitem(shared._JS_LOGMAP, 'error', logged.append)
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:style', 66, 'Refused CSP')
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:style', 67, 'ordinary error')
+
+    assert shown == ['JS: [userscript:style:67] ordinary error']
+    assert logged == ['[userscript:style:66] Refused CSP']
