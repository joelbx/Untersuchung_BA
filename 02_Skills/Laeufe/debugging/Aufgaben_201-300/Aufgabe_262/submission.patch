+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('https://M.MEDIA-AMAZON.COM/cover.jpg', 'https://M.MEDIA-AMAZON.COM/cover.jpg'),
+        ('http://m.media-amazon.com/cover.jpg', 'http://m.media-amazon.com/cover.jpg'),
+        ('https://unsupported.example/cover.jpg', None),
+        ('https://m.media-amazon.com.unsupported.example/cover.jpg', None),
+        ('ftp://m.media-amazon.com/cover.jpg', None),
+        ('not a url', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'Test', 'cover': cover}
+    result, updated = process_cover_url(edition, ['m.media-amazon.com'])
+    assert result == expected
+    assert updated == {'title': 'Test'}
+    assert edition == {'title': 'Test'}
+
+
+def test_process_cover_url_missing():
+    edition = {'title': 'Test'}
+    assert process_cover_url(edition) == (None, edition)
+
+
+def test_process_cover_url_uses_default_hosts_case_insensitively():
+    url = 'HTTPS://ARCHIVE.ORG/services/img/test'
+    edition = {'cover': url}
+    assert process_cover_url(edition) == (url, {})
+
