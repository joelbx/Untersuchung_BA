diff --git a/applications/mail/src/app/logic/elements/elementsReload.test.ts b/applications/mail/src/app/logic/elements/elementsReload.test.ts
new file mode 100644
index 0000000..15656f8
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsReload.test.ts
@@ -0,0 +1,76 @@
+import reducer, { newState } from './elementsSlice';
+import { backendActionStarted, backendActionFinished, retryStale } from './elementsActions';
+import { loading, pendingActions } from './elementsSelectors';
+import { RootState } from '../store';
+import { configureStore } from '@reduxjs/toolkit';
+import { load } from './elementsActions';
+
+const createStore = () =>
+    configureStore({ reducer: { elements: reducer }, middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }) });
+
+describe('element reload state', () => {
+    it('waits for every backend action and retries stale responses', () => {
+        let state = newState();
+        state = reducer(state, backendActionStarted());
+        state = reducer(state, backendActionStarted());
+        expect(pendingActions({ elements: state } as RootState)).toBe(2);
+        state = reducer(state, backendActionFinished());
+        expect(pendingActions({ elements: state } as RootState)).toBe(1);
+        state = reducer(state, retryStale({ queryParameters: { Page: 0 } }));
+        expect(state.retry).toEqual({ payload: { Page: 0 }, count: 1, error: undefined });
+        expect(state.pendingRequest).toBe(false);
+    });
+
+    it('reports loading when the current page requires a request', () => {
+        const state = newState({ beforeFirstLoad: false });
+        expect(loading({ elements: state } as RootState, { page: 0, params: state.params })).toBe(true);
+    });
+
+    it('does not commit stale results and schedules the stale retry after one second', async () => {
+        jest.useFakeTimers();
+        try {
+            const store = createStore();
+            const api = jest.fn().mockResolvedValue({ Total: 1, Conversations: [{ ID: 'stale' }], Stale: 1 });
+            const result = await store.dispatch(load({
+                api: api as any,
+                abortController: undefined,
+                conversationMode: true,
+                page: 0,
+                params: store.getState().elements.params,
+            }));
+            expect(result.type).toBe('elements/load/rejected');
+            expect(store.getState().elements.elements).toEqual({});
+            jest.advanceTimersByTime(999);
+            expect(store.getState().elements.retry.count).toBe(0);
+            jest.advanceTimersByTime(1);
+            expect(store.getState().elements.retry.count).toBe(1);
+            expect(store.getState().elements.retry.error).toBeUndefined();
+        } finally {
+            jest.useRealTimers();
+        }
+    });
+
+    it('schedules failed requests for retry after two seconds', async () => {
+        jest.useFakeTimers();
+        try {
+            const store = createStore();
+            const error = new Error('fetch failed');
+            const api = jest.fn().mockRejectedValue(error);
+            const result = await store.dispatch(load({
+                api: api as any,
+                abortController: undefined,
+                conversationMode: true,
+                page: 0,
+                params: store.getState().elements.params,
+            }));
+            expect(result.type).toBe('elements/load/rejected');
+            jest.advanceTimersByTime(1999);
+            expect(store.getState().elements.retry.count).toBe(0);
+            jest.advanceTimersByTime(1);
+            expect(store.getState().elements.retry.count).toBe(1);
+            expect(store.getState().elements.retry.error).toBe(error);
+        } finally {
+            jest.useRealTimers();
+        }
+    });
+});
