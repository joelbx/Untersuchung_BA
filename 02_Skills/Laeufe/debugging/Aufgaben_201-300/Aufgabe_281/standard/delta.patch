 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const prepareBulkIncrements = require('../hash-increment-bulk');
+	const bulkIncrementScript = `
+local function normalize(value)
+  if not string.match(value, '^%-?%d+$') then return nil end
+  local negative = string.sub(value, 1, 1) == '-'
+  local digits = string.gsub(value, '^%-?0*', '')
+  if digits == '' then digits = '0' end
+  return (negative and digits ~= '0') and '-' .. digits or digits
+end
+local function compare(a, b)
+  if #a ~= #b then return #a < #b and -1 or 1 end
+  if a == b then return 0 end
+  return a < b and -1 or 1
+end
+local function addMagnitude(a, b)
+  local result, carry = '', 0
+  for i = 0, math.max(#a, #b) - 1 do
+    local n = (tonumber(string.sub(a, #a - i, #a - i)) or 0) +
+      (tonumber(string.sub(b, #b - i, #b - i)) or 0) + carry
+    result = tostring(n % 10) .. result
+    carry = math.floor(n / 10)
+  end
+  if carry > 0 then result = tostring(carry) .. result end
+  return result
+end
+local function subtractMagnitude(a, b)
+  local result, borrow = '', 0
+  for i = 0, #a - 1 do
+    local n = tonumber(string.sub(a, #a - i, #a - i)) -
+      (tonumber(string.sub(b, #b - i, #b - i)) or 0) - borrow
+    borrow = n < 0 and 1 or 0
+    result = tostring((n + 10) % 10) .. result
+  end
+  return string.gsub(result, '^0*(%d)', '%1')
+end
+local function sum(a, b)
+  local an, bn = string.sub(a, 1, 1) == '-', string.sub(b, 1, 1) == '-'
+  if an then a = string.sub(a, 2) end
+  if bn then b = string.sub(b, 2) end
+  if an == bn then
+    local result = addMagnitude(a, b)
+    return an and '-' .. result or result
+  end
+  local order = compare(a, b)
+  if order == 0 then return '0' end
+  if order > 0 then
+    local result = subtractMagnitude(a, b)
+    return an and '-' .. result or result
+  end
+  local result = subtractMagnitude(b, a)
+  return bn and '-' .. result or result
+end
+for i = 1, #ARGV, 2 do
+  local old = redis.call('HGET', KEYS[1], ARGV[i]) or '0'
+  local normalized = normalize(old)
+  if not normalized then return redis.error_reply('ERR hash value is not an integer') end
+  local result = sum(normalized, ARGV[i + 1])
+  local negative = string.sub(result, 1, 1) == '-'
+  local magnitude = negative and string.sub(result, 2) or result
+  local limit = negative and '9223372036854775808' or '9223372036854775807'
+  if compare(magnitude, limit) > 0 then
+    return redis.error_reply('ERR increment or decrement would overflow')
+  end
+end
+for i = 1, #ARGV, 2 do
+  redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+end
+return 1`;
 
