+'use strict';
+
+module.exports = function prepareBulkIncrements(data, fieldToString) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const byKey = new Map();
+	for (const item of data) {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must be [key, increments] tuples');
+		}
+		let fields = byKey.get(item[0]);
+		if (!fields) {
+			fields = Object.create(null);
+			byKey.set(item[0], fields);
+		}
+		for (const [rawField, increment] of Object.entries(item[1])) {
+			const field = fieldToString(rawField);
+			if (!field || rawField.includes('.') || rawField.includes('$') ||
+				field === '__proto__' || field === 'constructor' || field === 'prototype' ||
+				field === '_key' || field === '_id') {
+				throw new TypeError(`Invalid increment field: ${rawField}`);
+			}
+			if (!Number.isSafeInteger(increment)) {
+				throw new TypeError(`Increment for ${rawField} must be a safe integer`);
+			}
+			const sum = (fields[field] || 0) + increment;
+			if (!Number.isSafeInteger(sum)) {
+				throw new RangeError(`Combined increment for ${rawField} exceeds safe integer range`);
+			}
+			fields[field] = sum;
+		}
+	}
+	return [...byKey].filter(([, fields]) => Object.keys(fields).length);
+};
