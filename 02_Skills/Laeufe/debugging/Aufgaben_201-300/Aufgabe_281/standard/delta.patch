diff --git a/test/database/hash-bulk-unit.js b/test/database/hash-bulk-unit.js
new file mode 100644
index 0000000..67de1a5
--- /dev/null
+++ b/test/database/hash-bulk-unit.js
@@ -0,0 +1,54 @@
+'use strict';
+
+const assert = require('assert');
+
+describe('bulk hash increments', () => {
+	for (const backend of ['mongo', 'redis']) {
+		it(`${backend} validates input before contacting the backend`, async () => {
+			let calls = 0;
+			const module = { client: new Proxy({}, { get() { calls += 1; throw new Error('backend called'); } }) };
+			require(`../../src/database/${backend}/hash`)(module);
+			const originalDel = module.objectCache.del;
+			module.objectCache.del = () => { calls += 1; };
+			assert.strictEqual(await module.incrObjectFieldByBulk([]), undefined);
+			const protoField = JSON.parse('{"__proto__":1}');
+			const invalid = [
+				null, {}, ['key'], [['key', { a: 1.5 }]], [['key', { a: Number.MAX_SAFE_INTEGER + 1 }]],
+				[['key', { 'a.b': 1 }]], [['key', { $a: 1 }]], [['key', { constructor: 1 }]],
+				[['key', protoField]],
+			];
+			await Promise.all(invalid.map(data => assert.rejects(module.incrObjectFieldByBulk(data))));
+			assert.strictEqual(calls, 0);
+			module.objectCache.del = originalDel;
+		});
+	}
+
+	it('mongo applies all fields per key and invalidates successful keys only', async () => {
+		const docs = new Map([['good', { age: 3 }], ['bad', { age: 4, text: 'x' }]]);
+		const updateOne = async (query, update, options) => {
+			const before = docs.get(query._key) || {};
+			if (Object.keys(update.$inc).some(field => before[field] !== undefined && typeof before[field] !== 'number')) {
+				throw new Error('non numeric field');
+			}
+			assert.strictEqual(options.upsert, true);
+			const updated = Object.fromEntries(Object.entries(update.$inc).map(
+				([field, value]) => [field, (before[field] || 0) + value]
+			));
+			docs.set(query._key, { ...before, ...updated });
+		};
+		const module = { client: { collection: () => ({ updateOne }) } };
+		require('../../src/database/mongo/hash')(module);
+		module.objectCache.set('good', { age: 3 });
+		module.objectCache.set('bad', { age: 4, text: 'x' });
+		await assert.rejects(module.incrObjectFieldByBulk([
+			['good', { age: 5, newField: 10 }],
+			['bad', { age: 2, text: 1 }],
+			['created', { age: -2 }],
+		]));
+		assert.deepStrictEqual(docs.get('good'), { age: 8, newField: 10 });
+		assert.deepStrictEqual(docs.get('bad'), { age: 4, text: 'x' });
+		assert.deepStrictEqual(docs.get('created'), { age: -2 });
+		assert.strictEqual(module.objectCache.get('good'), undefined);
+		assert.deepStrictEqual(module.objectCache.get('bad'), { age: 4, text: 'x' });
+	});
+});
