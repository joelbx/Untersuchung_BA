+func TestLoadAuthenticationProviderValidation(t *testing.T) {
+	tests := []struct {
+		name, method, provider, field, value, wantErr string
+	}{
+		{"github client id", "github", "", "client_id", "", `provider "github": field "client_id": non-empty value is required`},
+		{"github client secret", "github", "", "client_secret", "", `provider "github": field "client_secret": non-empty value is required`},
+		{"github redirect address", "github", "", "redirect_address", "", `provider "github": field "redirect_address": non-empty value is required`},
+		{"github whitespace client id", "github", "", "client_id", "   ", `provider "github": field "client_id": non-empty value is required`},
+		{"oidc client id", "oidc", "foo", "client_id", "", `provider "foo": field "client_id": non-empty value is required`},
+		{"oidc client secret", "oidc", "foo", "client_secret", "", `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc redirect address", "oidc", "foo", "redirect_address", "", `provider "foo": field "redirect_address": non-empty value is required`},
+		{"github organization scope", "github", "", "scopes", "", `provider "github": field "scopes": must contain read:org when allowed_organizations is not empty`},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fields := map[string]string{
+				"client_id":        "id",
+				"client_secret":    "secret",
+				"redirect_address": "http://localhost/callback",
+			}
+			if tt.field != "scopes" {
+				fields[tt.field] = tt.value
+			}
+			method := fmt.Sprintf("      client_id: %q\n      client_secret: %q\n      redirect_address: %q\n", fields["client_id"], fields["client_secret"], fields["redirect_address"])
+			if tt.field == "scopes" {
+				method += "      allowed_organizations: [flipt-io]\n      scopes: [user:email]\n"
+			}
+			if tt.method == "oidc" {
+				method = fmt.Sprintf("      providers:\n        %s:\n", tt.provider) + strings.ReplaceAll(method, "      ", "          ")
+			}
+			body := fmt.Sprintf("authentication:\n  session:\n    domain: localhost\n  methods:\n    %s:\n      enabled: true\n%s", tt.method, method)
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(body), 0600))
+			_, err := Load(path)
+			require.EqualError(t, err, tt.wantErr)
+		})
+	}
+}
