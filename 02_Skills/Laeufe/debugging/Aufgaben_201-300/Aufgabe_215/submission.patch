diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..51af195
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,146 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestConfigureHTTPS(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := ioutil.WriteFile(path, []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := filepath.Join(dir, "config.yml")
+	yaml := "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: " + cert + "\n  cert_key: " + key + "\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n"
+	if err := ioutil.WriteFile(path, []byte(yaml), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.Protocol != HTTPS || cfg.Server.HTTPSPort != 8080 || cfg.Server.CertFile != cert || cfg.Server.CertKey != key {
+		t.Fatalf("server: %+v", cfg.Server)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("config: %+v", cfg)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	if err := cfg.validate(); err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("cert file: %v", err)
+	}
+	cfg.Server.CertFile = "missing-cert"
+	if err := cfg.validate(); err == nil || err.Error() != "cert_key cannot be empty when using HTTPS" {
+		t.Fatalf("cert key: %v", err)
+	}
+	cfg.Server.CertKey = "missing-key"
+	if err := cfg.validate(); err == nil || !strings.Contains(err.Error(), `cannot find TLS cert_file at "missing-cert"`) {
+		t.Fatalf("missing cert: %v", err)
+	}
+	dir, err := ioutil.TempDir("", "flipt-cert-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cfg.Server.CertFile = filepath.Join(dir, "cert.pem")
+	if err := ioutil.WriteFile(cfg.Server.CertFile, []byte("cert"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := cfg.validate(); err == nil || err.Error() != `cannot find TLS cert_key at "missing-key"` {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatalf("http: %v", err)
+	}
+}
+
+func TestConfigureDefaultsAndOrigins(t *testing.T) {
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("scheme names")
+	}
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "config.yml")
+	if err := ioutil.WriteFile(path, []byte("# defaults\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults: %+v", cfg)
+	}
+	if err := ioutil.WriteFile(path, []byte("cors:\n  allowed_origins:\n    - foo.com\n    - bar.com\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com", "bar.com"}) {
+		t.Fatalf("origins: %v", cfg.Cors.AllowedOrigins)
+	}
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.HTTPPort != 8181 {
+		t.Fatalf("environment override: %d", cfg.Server.HTTPPort)
+	}
+}
+
+func TestConfigAndInfoHandlers(t *testing.T) {
+	for _, handler := range []interface {
+		ServeHTTP(http.ResponseWriter, *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		resp := httptest.NewRecorder()
+		handler.ServeHTTP(resp, httptest.NewRequest("GET", "/", nil))
+		if resp.Code != 200 || resp.Body.Len() == 0 {
+			t.Fatalf("response: %d %q", resp.Code, resp.Body.String())
+		}
+	}
+}
+
+func TestAdvancedHTTPSFixture(t *testing.T) {
+	cfg, err := configure("testdata/config/advanced.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := serverConfig{
+		Host: "127.0.0.1", Protocol: HTTPS, HTTPPort: 8081, HTTPSPort: 8080,
+		GRPCPort: 9001, CertFile: "./testdata/config/ssl_cert.pem", CertKey: "./testdata/config/ssl_key.pem",
+	}
+	if cfg.Server != want {
+		t.Fatalf("server: %+v", cfg.Server)
+	}
+	if cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" {
+		t.Fatalf("database: %s", cfg.Database.URL)
+	}
+}
