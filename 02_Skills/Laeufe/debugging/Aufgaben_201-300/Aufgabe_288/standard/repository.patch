+++ b/applications/mail/src/app/hooks/useShouldMoveOut.test.ts
@@ -0,0 +1,38 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { useShouldMoveOut } from './useShouldMoveOut';
+
+describe('useShouldMoveOut', () => {
+    const onBack = jest.fn();
+
+    beforeEach(() => onBack.mockClear());
+
+    const renderMoveOut = (elementID: string | undefined, elementIDs: string[], loadingElements = false) =>
+        renderHook(
+            ({ id, ids, loading }) =>
+                useShouldMoveOut({ elementID: id, elementIDs: ids, loadingElements: loading, onBack }),
+            { initialProps: { id: elementID, ids: elementIDs, loading: loadingElements } }
+        );
+
+    it.each([
+        [undefined, ['one']],
+        ['', ['one']],
+        ['one', []],
+        ['missing', ['one']],
+    ])('moves out when %s is invalid in %p', (id, ids) => {
+        renderMoveOut(id, ids);
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it('stays when the active ID is present', () => {
+        renderMoveOut('one', ['one', 'two']);
+        expect(onBack).not.toHaveBeenCalled();
+    });
+
+    it('waits until loading completes before checking IDs', () => {
+        const { rerender } = renderMoveOut('missing', ['one'], true);
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ id: 'missing', ids: ['one'], loading: false });
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+});
