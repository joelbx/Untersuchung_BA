+    def _build_doc(self, role, path, collection, argspec, entry_point=None):
+        """Build documentation for a role's selected entry points.
+
+        :returns: The role name (qualified when in a collection) and its doc,
+            or None for the doc when no entry points match.
+        """
+        fqcn = '.'.join([collection, role]) if collection else role
+        entry_points = {}
+        for ep, entry_spec in argspec.items():
+            if entry_point is None or ep == entry_point:
+                entry_points[ep] = entry_spec
+
+        if not entry_points:
+            return (fqcn, None)
+
+        return (fqcn, {'path': path, 'collection': collection, 'entry_points': entry_points})
