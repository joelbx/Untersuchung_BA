new file mode 100644
index 0000000..e5aae43
--- /dev/null
+++ b/lib/client/sso_override_test.go
@@ -0,0 +1,22 @@
+package client
+
+import (
+	"context"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth"
+)
+
+func TestMockSSOLogin(t *testing.T) {
+	want := &auth.SSHLoginResponse{}
+	c := &TeleportClient{Config: Config{MockSSOLogin: func(_ context.Context, id string, pub []byte, protocol string) (*auth.SSHLoginResponse, error) {
+		if id != "connector" || string(pub) != "public" || protocol != "oidc" {
+			t.Fatalf("unexpected SSO arguments: %q %q %q", id, pub, protocol)
+		}
+		return want, nil
+	}}}
+	got, err := c.ssoLogin(context.Background(), "connector", []byte("public"), "oidc")
+	if err != nil || got != want {
+		t.Fatalf("got %p, %v; want %p", got, err, want)
+	}
+}
diff --git a/lib/service/listener_addr_test.go b/lib/service/listener_addr_test.go
new file mode 100644
index 0000000..5c23ad9
--- /dev/null
+++ b/lib/service/listener_addr_test.go
@@ -0,0 +1,39 @@
+package service
+
+import (
+	"net"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/sirupsen/logrus"
+)
+
+func TestProxyWebListenerUsesAssignedPort(t *testing.T) {
+	cfg := MakeDefaultConfig()
+	cfg.Proxy.WebAddr = utils.NetAddr{AddrNetwork: "tcp", Addr: "127.0.0.1:0"}
+	cfg.Proxy.SSHAddr = utils.NetAddr{AddrNetwork: "tcp", Addr: "127.0.0.1:0"}
+	cfg.Proxy.DisableReverseTunnel = true
+	cfg.Proxy.DisableDatabaseProxy = true
+	process := &TeleportProcess{Config: cfg, log: logrus.New()}
+	listeners, err := process.setupProxyListeners()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listeners.Close()
+	if listeners.ssh == nil || listeners.ssh.Addr().String() != cfg.Proxy.SSHAddr.Addr {
+		t.Fatalf("SSH listener = %v, config = %q", listeners.ssh, cfg.Proxy.SSHAddr.Addr)
+	}
+	if _, sshPort, err := net.SplitHostPort(cfg.Proxy.SSHAddr.Addr); err != nil || sshPort == "0" {
+		t.Fatalf("SSH address = %q, err = %v", cfg.Proxy.SSHAddr.Addr, err)
+	}
+	if listeners.web == nil {
+		t.Fatal("web listener was not bound")
+	}
+	_, port, err := net.SplitHostPort(cfg.Proxy.WebAddr.Addr)
+	if err != nil || port == "0" {
+		t.Fatalf("web address = %q, err = %v", cfg.Proxy.WebAddr.Addr, err)
+	}
+	if got := listeners.web.Addr().String(); got != cfg.Proxy.WebAddr.Addr {
+		t.Fatalf("listener = %q, config = %q", got, cfg.Proxy.WebAddr.Addr)
+	}
+}
