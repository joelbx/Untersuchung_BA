--- /dev/null
+++ b/tool/tsh/error_return_test.go
@@ -0,0 +1,39 @@
+package main
+
+import (
+	"context"
+	"github.com/gravitational/teleport/lib/auth"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/client"
+	"github.com/gravitational/trace"
+)
+
+func TestRunReturnsErrorAndAppliesOptions(t *testing.T) {
+	called := false
+	err := Run([]string{"-i", "identity", "login"}, func(cf *CLIConf) {
+		called = true
+		if cf.IdentityFileIn != "identity" {
+			t.Fatalf("options ran before parsing: %q", cf.IdentityFileIn)
+		}
+		cf.mockSSOLogin = client.SSOLoginFunc(nil)
+	})
+	if !called || !trace.IsBadParameter(err) {
+		t.Fatalf("called=%v, err=%v", called, err)
+	}
+	if err := refuseArgs("logout", []string{"logout", "extra"}); !trace.IsBadParameter(err) {
+		t.Fatalf("invalid argument error = %v", err)
+	}
+}
+
+func TestMakeClientPassesSSOOverride(t *testing.T) {
+	mock := func(context.Context, string, []byte, string) (*auth.SSHLoginResponse, error) { return nil, nil }
+	cf := &CLIConf{Proxy: "127.0.0.1:3080", mockSSOLogin: mock}
+	tc, err := makeClient(cf, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tc.MockSSOLogin == nil {
+		t.Fatal("SSO override was not propagated")
+	}
+}
