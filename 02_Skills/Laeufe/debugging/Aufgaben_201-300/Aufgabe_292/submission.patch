diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..70fc969
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,49 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		close(entered)
+		<-ctx.Done()
+		<-release
+		close(finished)
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	p.Poll()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("polling did not start")
+	}
+	closed := make(chan struct{})
+	go func() { _ = p.Close(); close(closed) }()
+	select {
+	case <-closed:
+		t.Fatal("Close returned while update was running")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not wait for polling to stop")
+	}
+	select {
+	case <-finished:
+	default:
+		t.Fatal("update was not finished")
+	}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
