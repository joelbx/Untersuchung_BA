+    @pytest.mark.asyncio
+    async def test_public_scan_before_lending_and_multiple_printdisabled(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w, key='/books/OL11M', ocaid='loan',
+                    _ia_meta={'collection': ['lendinglibrary', 'americana']},
+                ),
+                make_edition(
+                    w, key='/books/OL12M', ocaid='disabled1',
+                    _ia_meta={'collection': ['printdisabled', 'collection1']},
+                ),
+                make_edition(
+                    w, key='/books/OL13M', ocaid='public',
+                    _ia_meta={'collection': ['opensource', 'americana']},
+                ),
+                make_edition(
+                    w, key='/books/OL14M', ocaid='disabled2',
+                    _ia_meta={'collection': ['printdisabled', 'collection2']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+        assert d['has_fulltext'] is True
+        assert d['public_scan_b'] is True
+        assert d['lending_edition_s'] == 'OL13M'
+        assert d['lending_identifier_s'] == 'public'
+        assert set(d['printdisabled_s'].split(';')) == {'OL12M', 'OL14M'}
+        assert set(d['ia']) == {'loan', 'disabled1', 'public', 'disabled2'}
+        assert set(d['ia_collection_s'].split(';')) == {
+            'lendinglibrary', 'americana', 'printdisabled',
+            'collection1', 'opensource', 'collection2',
+        }
+
