diff --git a/tests/unit/config/test_qtargs.py b/tests/unit/config/test_qtargs.py
index b38158f..9f3754f 100644
--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -87,6 +87,59 @@ class TestQtArgs:
         for arg in ['--foo', '--bar']:
             assert arg in args
 
+    @pytest.mark.parametrize('backend, overlay, new_qt, is_mac, expected', [
+        (usertypes.Backend.QtWebEngine, True, True, False,
+         ['--enable-features=First,Second,Third,OverlayScrollbar']),
+        (usertypes.Backend.QtWebEngine, False, True, False,
+         ['--enable-features=First,Second,Third']),
+        (usertypes.Backend.QtWebEngine, True, True, True,
+         ['--enable-features=First,Second,Third']),
+        (usertypes.Backend.QtWebEngine, True, False, False,
+         ['--enable-features=First,Second,Third']),
+        (usertypes.Backend.QtWebKit, True, True, False,
+         ['--enable-features=First,Second', '--enable-features=Third']),
+    ])
+    def test_existing_enabled_features(self, config_stub, monkeypatch, parser,
+                                       backend, overlay, new_qt, is_mac,
+                                       expected):
+        monkeypatch.setattr(qtargs.objects, 'backend', backend)
+        monkeypatch.setattr(qtargs.qtutils, 'version_check',
+                            lambda version, compiled=False: new_qt)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', is_mac)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+        config_stub.val.qt.args = ['enable-features=Third', 'foo']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=First,Second',
+            '--qt-flag', 'bar',
+        ])
+
+        args = qtargs.qt_args(parsed)
+
+        features = [arg for arg in args
+                    if arg.startswith('--enable-features=')]
+        assert features == expected
+        assert '--foo' in args
+        assert '--bar' in args
+        if backend == usertypes.Backend.QtWebKit:
+            assert args == [sys.argv[0], '--enable-features=First,Second',
+                            '--bar', '--enable-features=Third', '--foo']
+
+    def test_enabled_features_helpers(self, config_stub, parser):
+        config_stub.val.scrolling.bar = 'never'
+        flags = ['--enable-features=Alpha,Beta', '--enable-features=Gamma']
+        parsed = parser.parse_args([])
+
+        assert list(qtargs._qtwebengine_enabled_features(flags)) == [
+            'Alpha', 'Beta', 'Gamma']
+        assert [arg for arg in qtargs._qtwebengine_args(parsed, flags)
+                if arg.startswith('--enable-features=')] == [
+                    '--enable-features=Alpha,Beta,Gamma']
+        assert not [arg for arg in qtargs._qtwebengine_args(parsed, [])
+                    if arg.startswith('--enable-features=')]
+        assert not [arg for arg in qtargs._qtwebengine_args(
+            parsed, ['--enable-features='])
+            if arg.startswith('--enable-features=')]
+
     @pytest.mark.parametrize('backend, expected', [
         (usertypes.Backend.QtWebEngine, True),
         (usertypes.Backend.QtWebKit, False),
