+def test_prioritized_identifier_equality_and_json():
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    first = PrioritizedIdentifier("B012346789", stage_import=False, timestamp=timestamp)
+    duplicate = PrioritizedIdentifier("B012346789", priority=Priority.HIGH)
+    isbn = PrioritizedIdentifier("9780123456786")
+
+    assert first == duplicate
+    assert len({first, duplicate, isbn}) == 2
+    assert first != isbn
+    assert json.loads(json.dumps(first.to_dict())) == {
+        "identifier": "B012346789",
+        "stage_import": False,
+        "priority": "LOW",
+        "timestamp": "2024-01-02T03:04:05",
+    }
+    assert PrioritizedISBN(isbn="B012346789").isbn == "B012346789"
+
+
+def test_submit_does_not_queue_duplicate_asin(monkeypatch):
+    amazon_queue = queue.PriorityQueue()
+    amazon_queue.put_nowait(PrioritizedIdentifier("B012346789", stage_import=False))
+    monkeypatch.setattr(affiliate_server.web, "amazon_queue", amazon_queue)
+    monkeypatch.setattr(affiliate_server.web, "amazon_api", object(), raising=False)
+    monkeypatch.setattr(affiliate_server.web, "input", lambda **kwargs: {})
+    monkeypatch.setattr(affiliate_server.cache.memcache_cache, "get", lambda key: None)
+    monkeypatch.setattr(affiliate_server.stats, "put", lambda *args, **kwargs: None)
+
+    assert json.loads(Submit().GET("B012346789"))["status"] == "submitted"
+    assert amazon_queue.qsize() == 1
+    assert amazon_queue.queue[0].stage_import is True
+
+
+def test_process_amazon_batch_respects_stage_import(monkeypatch):
+    products = [
