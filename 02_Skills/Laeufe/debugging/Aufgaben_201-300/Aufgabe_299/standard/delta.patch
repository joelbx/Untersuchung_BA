+def test_url_filesystem_category(config_stub, quickmarks, bookmarks, info,
+                                 qtmodeltester):
+    config_stub.val.completion.favorite_paths = ['/favorite']
+    config_stub.val.completion.open_categories = ['filesystem', 'quickmarks']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    assert model.data(model.index(0, 0)) == 'Filesystem'
+    assert model.data(model.index(0, 0, model.index(0, 0))) == '/favorite'
+    assert model.data(model.index(0, 1, model.index(0, 0))) is None
+    assert model.data(model.index(1, 0)) == 'Quickmarks'
+    config_stub.val.completion.open_categories = ['filesystem', 'bookmarks']
+    bookmarks.marks.clear()
+    model = urlmodel.url(info=info)
+    model.set_pattern('relative')
+    assert model.data(model.index(0, 0)) == 'Filesystem'
+    assert model.rowCount(model.index(0, 0)) == 0
+    assert model.rowCount() == 1
