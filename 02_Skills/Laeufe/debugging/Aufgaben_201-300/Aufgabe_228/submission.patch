 import sys
 
 import pytest
+from PyQt5 import QtCore
+from PyQt5.QtCore import QVersionNumber
 
 from qutebrowser.misc import earlyinit
 
 
+@pytest.mark.parametrize('runtime, compiled, pyqt, invalid', [
+    ('5.12.0', '5.12.0', '5.12.0', False),
+    ('5.11.9', '5.12.0', '5.12.0', True),
+    ('5.12.0', '5.11.9', '5.12.0', True),
+    ('5.12.0', '5.12.0', '5.11.9', True),
+])
+def test_check_qt_version(monkeypatch, runtime, compiled, pyqt, invalid):
+    monkeypatch.setattr(QtCore, 'QLibraryInfo', type('LibraryInfo', (), {
+        'version': staticmethod(
+            lambda: QVersionNumber.fromString(runtime)[0])}))
+    monkeypatch.setattr(QtCore, 'QT_VERSION_STR', compiled)
+    monkeypatch.setattr(QtCore, 'PYQT_VERSION_STR', pyqt)
+    monkeypatch.setattr(earlyinit, 'qt_version', lambda: 'reported Qt version')
+    messages = []
+    monkeypatch.setattr(earlyinit, '_die', messages.append)
+
+    earlyinit.check_qt_version()
+
+    assert bool(messages) is invalid
+    if invalid:
+        assert 'reported Qt version' in messages[0]
+        assert 'PyQt {}'.format(pyqt) in messages[0]
+
+
