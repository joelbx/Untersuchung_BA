@@ -1,10 +1,77 @@
 """py.test tests for addbook"""
+from unittest.mock import Mock, call
+
+import pytest
 import web
 from .. import addbook
 from openlibrary import accounts
 from openlibrary.mocks.mock_infobase import MockSite
 
 
+@pytest.mark.parametrize(
+    'author_fields',
+    [{}, {'author_key': ['OL1A']}, {'author_name': ['Example Author']}],
+)
+def test_make_work_without_complete_author_fields(monkeypatch, author_fields):
+    site = Mock()
+    monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+    doc = {'key': '/works/OL1W', 'title': 'Example Work', **author_fields}
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert work.key == doc['key']
+    assert work.title == doc['title']
+    assert all(work[field] == value for field, value in author_fields.items())
+    assert work.authors == []
+    assert work.cover_url == '/images/icons/avatar_book-sm.png'
+    assert work.ia == []
+    assert work.first_publish_year is None
+    site.new.assert_not_called()
+
+
+def test_make_work_preserves_metadata_and_creates_authors(monkeypatch):
+    site = Mock()
+    authors = [object(), object()]
+    site.new.side_effect = authors
+    monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+    doc = {
+        'title': 'Example Work',
+        'author_key': ['OL1A', 'OL2A'],
+        'author_name': ['First Author', 'Second Author'],
+        'cover_url': '/custom-cover.png',
+        'ia': ['archive-id'],
+        'first_publish_year': 1999,
+    }
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert work.authors == authors
+    assert work.cover_url == doc['cover_url']
+    assert work.ia == doc['ia']
+    assert work.first_publish_year == doc['first_publish_year']
+    assert work.title == doc['title']
+    assert site.new.call_args_list == [
+        call(
+            '/authors/OL1A',
+            {
+                'key': '/authors/OL1A',
+                'type': {'key': '/type/author'},
+                'name': 'First Author',
+            },
+        ),
+        call(
+            '/authors/OL2A',
+            {
+                'key': '/authors/OL2A',
+                'type': {'key': '/type/author'},
+                'name': 'Second Author',
+            },
+        ),
+    ]
+
+
 def strip_nones(d):
     return {k: v for k, v in d.items() if v is not None}
 
