+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("uses the explicit user ID for every operation", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
+		key := "user-props-isolation-test"
+		defer repo.Delete("user-a", key)
+		defer repo.Delete("user-b", key)
+
+		Expect(repo.Put("user-a", key, "A")).To(Succeed())
+		Expect(repo.Put("user-b", key, "B")).To(Succeed())
+		Expect(repo.Get("user-a", key)).To(Equal("A"))
+		Expect(repo.Get("user-b", key)).To(Equal("B"))
+		Expect(repo.DefaultGet("user-b", key, "default")).To(Equal("B"))
+		Expect(repo.Put("user-a", key, "A2")).To(Succeed())
+		Expect(repo.Get("user-a", key)).To(Equal("A2"))
+		Expect(repo.Delete("user-a", key)).To(Succeed())
+		Expect(repo.DefaultGet("user-a", key, "default")).To(Equal("default"))
+		Expect(repo.Get("user-b", key)).To(Equal("B"))
+	})
+	It("rejects an empty user ID", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("", "setting", "value")).To(Equal(model.ErrInvalidAuth))
+		_, err := repo.Get("", "setting")
+		Expect(err).To(Equal(model.ErrInvalidAuth))
+		_, err = repo.DefaultGet("", "setting", "default")
+		Expect(err).To(Equal(model.ErrInvalidAuth))
+		Expect(repo.Delete("", "setting")).To(Equal(model.ErrInvalidAuth))
+	})
+})
