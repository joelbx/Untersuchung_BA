+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,109 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkStateBindsUserAndExpires(t *testing.T) {
+	oldSecret := auth.Secret
+	auth.Secret = []byte("test-link-state-secret")
+	defer func() { auth.Secret = oldSecret }()
+	now := time.Now()
+	state, err := signLinkState("user-a", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	uid, err := verifyLinkState(state, now.Add(time.Minute))
+	if err != nil || uid != "user-a" {
+		t.Fatalf("valid state: %q, %v", uid, err)
+	}
+	modified := []byte(state)
+	if modified[0] == 'A' {
+		modified[0] = 'B'
+	} else {
+		modified[0] = 'A'
+	}
+	if _, err := verifyLinkState(string(modified), now); err == nil {
+		t.Fatal("modified state was accepted")
+	}
+	if _, err := verifyLinkState(state, now.Add(11*time.Minute)); err == nil {
+		t.Fatal("expired state was accepted")
+	}
+}
+
+func TestRouterUserScopedLinkOperations(t *testing.T) {
+	oldSecret := auth.Secret
+	auth.Secret = []byte("test-link-state-secret")
+	defer func() { auth.Secret = oldSecret }()
+	ds := &tests.MockDataStore{}
+	ctx := context.Background()
+	repo := ds.UserProps(ctx)
+	if err := repo.Put("user-a", sessionKeyProperty, "SK-A"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("user-b", sessionKeyProperty, "SK-B"); err != nil {
+		t.Fatal(err)
+	}
+	router := &Router{sessionKeys: &sessionKeys{ds: ds}}
+	userBContext := request.WithUser(ctx, model.User{ID: "user-b"})
+
+	status := httptest.NewRecorder()
+	router.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(userBContext))
+	if status.Code != http.StatusOK {
+		t.Fatalf("link status: %d %s", status.Code, status.Body.String())
+	}
+	var response struct {
+		Status bool   `json:"status"`
+		State  string `json:"state"`
+	}
+	if err := json.Unmarshal(status.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	uid, err := verifyLinkState(response.State, time.Now())
+	if err != nil || uid != "user-b" || !response.Status {
+		t.Fatalf("link status: %+v, uid=%q, err=%v", response, uid, err)
+	}
+
+	unlink := httptest.NewRecorder()
+	router.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(userBContext))
+	if unlink.Code != http.StatusOK {
+		t.Fatalf("unlink: %d %s", unlink.Code, unlink.Body.String())
+	}
+	if _, err := repo.Get("user-b", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("user B key remains: %v", err)
+	}
+	if key, err := repo.Get("user-a", sessionKeyProperty); err != nil || key != "SK-A" {
+		t.Fatalf("user A key: %q, %v", key, err)
+	}
+
+	fake := &tests.FakeHttpClient{Res: http.Response{Body: ioutil.NopCloser(bytes.NewBufferString(`{"session":{"name":"test","key":"SK-B2","subscriber":0}}`)), StatusCode: 200}}
+	router.client = NewClient("API_KEY", "SECRET", "en", fake)
+	unsigned := httptest.NewRecorder()
+	router.callback(unsigned, httptest.NewRequest(http.MethodGet, "/link/callback?token=TOKEN&uid=user-a", nil))
+	if unsigned.Code != http.StatusBadRequest {
+		t.Fatalf("unsigned callback: %d", unsigned.Code)
+	}
+	callback := httptest.NewRecorder()
+	router.callback(callback, httptest.NewRequest(http.MethodGet, "/link/callback?token=TOKEN&uid=user-a&state="+response.State, nil))
+	if callback.Code != http.StatusOK {
+		t.Fatalf("callback: %d %s", callback.Code, callback.Body.String())
+	}
+	if key, err := repo.Get("user-b", sessionKeyProperty); err != nil || key != "SK-B2" {
+		t.Fatalf("saved key for B: %q, %v", key, err)
+	}
+	if key, err := repo.Get("user-a", sessionKeyProperty); err != nil || key != "SK-A" {
+		t.Fatalf("user A key changed: %q, %v", key, err)
+	}
+}
