@@ -0,0 +1,54 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestMockedUserPropsRepoUserIsolation(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("user-a", "setting", "a"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("user-b", "setting", "b"); err != nil {
+		t.Fatal(err)
+	}
+	for user, want := range map[string]string{"user-a": "a", "user-b": "b"} {
+		got, err := repo.Get(user, "setting")
+		if err != nil || got != want {
+			t.Fatalf("Get(%s): %q, %v; want %q", user, got, err, want)
+		}
+		got, err = repo.DefaultGet(user, "setting", "default")
+		if err != nil || got != want {
+			t.Fatalf("DefaultGet(%s): %q, %v; want %q", user, got, err, want)
+		}
+	}
+	if err := repo.Delete("user-a", "setting"); err != nil {
+		t.Fatal(err)
+	}
+	got, err := repo.DefaultGet("user-a", "setting", "default")
+	if err != nil || got != "default" {
+		t.Fatalf("deleted value: %q, %v", got, err)
+	}
+	got, err = repo.Get("user-b", "setting")
+	if err != nil || got != "b" {
+		t.Fatalf("other user's value: %q, %v", got, err)
+	}
+}
+
+func TestMockedUserPropsRepoRequiresUserID(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("", "setting", "value"); err != model.ErrInvalidAuth {
+		t.Fatalf("Put: %v", err)
+	}
+	if _, err := repo.Get("", "setting"); err != model.ErrInvalidAuth {
+		t.Fatalf("Get: %v", err)
+	}
+	if _, err := repo.DefaultGet("", "setting", "default"); err != model.ErrInvalidAuth {
+		t.Fatalf("DefaultGet: %v", err)
+	}
+	if err := repo.Delete("", "setting"); err != model.ErrInvalidAuth {
+		t.Fatalf("Delete: %v", err)
+	}
+}
