+def _is_child_path(path, root, link_target=None):
+    """Check a path, or a link at that path, against a collection root."""
+    if link_target is not None:
+        target = (to_bytes(link_target, errors='surrogate_or_strict') if isinstance(path, bytes)
+                  else to_text(link_target, errors='surrogate_or_strict'))
+        path = os.path.join(os.path.dirname(path), target)
+    path = os.path.realpath(path)
+    root = os.path.realpath(root)
+    separator = to_bytes(os.path.sep) if isinstance(root, bytes) else os.path.sep
+    return path == root or path.startswith(root + separator)
 
 
