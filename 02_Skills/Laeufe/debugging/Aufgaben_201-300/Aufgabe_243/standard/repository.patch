+func TestNewClusterSessionSelectsLocalCredentials(t *testing.T) {
+	f := newMockForwader(context.Background(), t)
+	f.creds = map[string]*kubeCreds{
+		"configured": {
+			targetAddr:      "k8s.example.com:443",
+			tlsConfig:       &tls.Config{},
+			transportConfig: &transport.Config{},
+		},
+	}
+	f.cfg.CachingAuthClient = mockAccessPoint{}
+	user, err := types.NewUser("bob")
+	require.NoError(t, err)
+	ctx := authContext{
+		Context:         auth.Context{User: user},
+		kubeCluster:     "configured",
+		teleportCluster: teleportClusterClient{name: "local"},
+	}
+	sess, err := f.newClusterSession(ctx)
+	require.NoError(t, err)
+	require.Same(t, f.creds["configured"].tlsConfig, sess.tlsConfig)
+	require.Equal(t, "k8s.example.com:443", sess.teleportCluster.targetAddr)
+}
+
+func TestNewClusterSessionRequiresKubeCluster(t *testing.T) {
+	f := newMockForwader(context.Background(), t)
+	_, err := f.newClusterSession(authContext{teleportCluster: teleportClusterClient{name: "remote", isRemote: true}})
+	require.True(t, trace.IsNotFound(err), "error: %v", err)
+	_, err = f.newClusterSession(authContext{teleportCluster: teleportClusterClient{name: "local"}, kubeCluster: "unknown"})
+	require.True(t, trace.IsNotFound(err), "error: %v", err)
+}
+
+func TestClusterSessionDialEndpoint(t *testing.T) {
+	var gotAddr, gotServerID string
+	sess := &clusterSession{authContext: authContext{
+		teleportCluster: teleportClusterClient{dial: func(_ context.Context, _, addr, serverID string) (net.Conn, error) {
+			gotAddr, gotServerID = addr, serverID
+			return &net.TCPConn{}, nil
+		}},
+	}}
+	_, err := sess.dial(context.Background(), "tcp", "ignored")
+	require.True(t, trace.IsBadParameter(err), "error: %v", err)
+
+	sess.teleportClusterEndpoints = []kubeClusterEndpoint{{addr: "k8s.example.com:3026", serverID: "service.local"}}
+	_, err = sess.dial(context.Background(), "tcp", "ignored")
+	require.NoError(t, err)
+	require.Equal(t, "k8s.example.com:3026", gotAddr)
+	require.Equal(t, "service.local", gotServerID)
+	require.Equal(t, gotAddr, sess.kubeAddress)
+}
