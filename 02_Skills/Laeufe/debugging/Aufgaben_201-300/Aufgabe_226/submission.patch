--- /dev/null
+++ b/mime/mime_test.go
@@ -0,0 +1,41 @@
+package mime
+
+import (
+	"mime"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/spf13/viper"
+)
+
+func TestLoadConfiguredMIMETypes(t *testing.T) {
+	dataFolder := t.TempDir()
+	resourceFolder := filepath.Join(dataFolder, "resources")
+	if err := os.Mkdir(resourceFolder, 0755); err != nil {
+		t.Fatal(err)
+	}
+	config := "types:\n  .custom: audio/x-custom\nlossless:\n  - .custom\n"
+	if err := os.WriteFile(filepath.Join(resourceFolder, "mime_types.yaml"), []byte(config), 0644); err != nil {
+		t.Fatal(err)
+	}
+	viper.Set("datafolder", dataFolder)
+	defer viper.Set("datafolder", ".")
+	conf.Load()
+
+	if got := mime.TypeByExtension(".custom"); got != "audio/x-custom" {
+		t.Errorf("custom MIME type = %q, want audio/x-custom", got)
+	}
+	if !reflect.DeepEqual(LosslessFormats, []string{"custom"}) {
+		t.Errorf("lossless formats = %v, want [custom]", LosslessFormats)
+	}
+	if got := mime.TypeByExtension(".js"); !strings.HasPrefix(got, "text/javascript") {
+		t.Errorf("JavaScript MIME type = %q", got)
+	}
+	if got := mime.TypeByExtension(".css"); !strings.HasPrefix(got, "text/css") {
+		t.Errorf("CSS MIME type = %q", got)
+	}
+}
