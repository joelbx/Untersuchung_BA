+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from ansible.modules.storage.netapp.netapp_e_drive_firmware import NetAppESeriesDriveFirmware
+from units.compat import mock
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+
+
+class DriveFirmwareTest(ModuleTestCase):
+    def make_module(self, **options):
+        args = dict(api_username='admin', api_password='password', api_url='http://localhost/devmgr/v2',
+                    ssid='1', firmware=['/tmp/drive.dlp'])
+        args.update(options)
+        set_module_args(args)
+        return NetAppESeriesDriveFirmware()
+
+    def test_upgrade_list_selects_only_needed_healthy_drives(self):
+        firmware = self.make_module()
+        compatibility = [dict(filename='drive.dlp', firmwareVersion='NEW', driveRefList=['a', 'b', 'c']),
+                         dict(filename='other.dlp', firmwareVersion='OTHER', driveRefList=['d'])]
+        drives = {'a': dict(driveRef='a', firmwareVersion='OLD', offline=False, available=True,
+                            onlineUpgradeCapable=True),
+                  'b': dict(driveRef='b', firmwareVersion='NEW', offline=False, available=True,
+                            onlineUpgradeCapable=True),
+                  'c': dict(driveRef='c', firmwareVersion='OLD', offline=True, available=False,
+                            onlineUpgradeCapable=True)}
+
+        def response(url, **kwargs):
+            if url.endswith('/firmware/drives'):
+                return 200, compatibility
+            return 200, drives[url.rsplit('/', 1)[-1]]
+
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', side_effect=response):
+            with self.assertRaises(AnsibleFailJson):
+                firmware.upgrade_list()
+            firmware.ignore_inaccessible_drives = True
+            self.assertEqual(firmware.upgrade_list(), [dict(filename='drive.dlp', driveRefList=['a'])])
+
+    def test_apply_check_mode_reports_change_without_upgrade(self):
+        firmware = self.make_module(_ansible_check_mode=True)
+        with mock.patch.object(firmware, 'upload_firmware') as upload:
+            upgrades = [dict(filename='drive.dlp', driveRefList=['a'])]
+            with mock.patch.object(firmware, 'upgrade_list', return_value=upgrades):
+                with mock.patch.object(firmware, 'upgrade') as upgrade:
+                    with self.assertRaises(AnsibleExitJson) as result:
+                        firmware.apply()
+                    self.assertTrue(result.exception.args[0]['changed'])
+                    self.assertFalse(result.exception.args[0]['upgrade_in_process'])
+                    upgrade.assert_not_called()
+                    upload.assert_called_once_with()
+
+    def test_wait_ignores_unrelated_failure(self):
+        firmware = self.make_module()
+        firmware.upgrade_drives = [dict(filename='drive.dlp', driveRefList=['a'])]
+        firmware.upgrade_in_progress = True
+        states = [dict(driveRef='a', status='okay'), dict(driveRef='other', status='failed')]
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', return_value=(200, states)):
+            firmware.wait_for_upgrade_completion()
+        self.assertFalse(firmware.upgrade_in_progress)
+
+    def test_online_upgrade_rejected_when_drive_cannot_do_it(self):
+        firmware = self.make_module()
+        compatibility = [dict(filename='drive.dlp', firmwareVersion='NEW', driveRef='a',
+                              onlineUpgradeCapable=False)]
+
+        def response(url, **kwargs):
+            if url.endswith('/firmware/drives'):
+                return 200, compatibility
+            return 200, dict(driveRef='a', firmwareVersion='OLD', offline=False, available=True)
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', side_effect=response):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Drive is not capable of online upgrade'):
+                firmware.upgrade_list()
+
+    def test_compatibility_model_must_match_drive(self):
+        firmware = self.make_module()
+        compatibility = [dict(filename='drive.dlp', firmwareVersion='NEW', driveRef='a',
+                              productID='SUPPORTED')]
+
+        def response(url, **kwargs):
+            if url.endswith('/firmware/drives'):
+                return 200, compatibility
+            return 200, dict(driveRef='a', firmwareVersion='OLD', productID='OTHER',
+                             offline=False, available=True)
+
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', side_effect=response):
+            self.assertEqual(firmware.upgrade_list(), [])
+
+    def test_upgrade_sets_progress_and_uses_offline_flag(self):
+        firmware = self.make_module(upgrade_drives_online=False)
+        firmware.upgrade_drives = [dict(filename='drive.dlp', driveRefList=['a'])]
+        request_path = 'ansible.modules.storage.netapp.netapp_e_drive_firmware.request'
+        with mock.patch(request_path, return_value=(202, {})) as req:
+            firmware.upgrade()
+        self.assertTrue(firmware.upgrade_in_progress)
+        self.assertIn('"onlineUpgrade": false', req.call_args[1]['data'])
+
+    def test_wait_rejects_target_failure_and_times_out_on_missing_drive(self):
+        firmware = self.make_module()
+        firmware.upgrade_drives = [dict(filename='drive.dlp', driveRefList=['a'])]
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request',
+                        return_value=(200, [dict(driveRef='a', status='failed')])):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Drive firmware upgrade failed'):
+                firmware.wait_for_upgrade_completion()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', return_value=(200, [])):
+            with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.WAIT_TIMEOUT_SEC', 0):
+                with self.assertRaisesRegex(AnsibleFailJson, 'Timed out waiting for drive firmware upgrade'):
+                    firmware.wait_for_upgrade_completion()
+
+    def test_upload_error_identifies_file_and_array(self):
+        firmware = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.create_multipart_formdata',
+                        side_effect=IOError('missing file')):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Failed to upload drive firmware /tmp/drive.dlp to array 1'):
+                firmware.upload_firmware()
