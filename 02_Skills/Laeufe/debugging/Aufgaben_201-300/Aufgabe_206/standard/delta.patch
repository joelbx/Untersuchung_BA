+++ b/test/controllers-write-topics-lock.js
@@ -0,0 +1,102 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const api = { topics: {} };
+const helpers = {
+	formatApiResponse(status, res, payload) {
+		res.status = status;
+		res.payload = payload;
+	},
+};
+const moduleMock = { exports: {} };
+const source = fs.readFileSync(path.join(__dirname, '../src/controllers/write/topics.js'), 'utf8');
+vm.runInNewContext(source, {
+	module: moduleMock,
+	require(id) {
+		if (id === '../../api') { return api; }
+		if (id === '../helpers') { return helpers; }
+		return {};
+	},
+});
+const controller = moduleMock.exports;
+
+describe('write topic posting lock', () => {
+	let create;
+	let reply;
+	let formatApiResponse;
+
+	beforeEach(() => {
+		create = api.topics.create;
+		reply = api.topics.reply;
+		formatApiResponse = helpers.formatApiResponse;
+		helpers.formatApiResponse = (status, res, payload) => {
+			res.status = status;
+			res.payload = payload;
+		};
+	});
+
+	afterEach(() => {
+		api.topics.create = create;
+		api.topics.reply = reply;
+		helpers.formatApiResponse = formatApiResponse;
+	});
+
+	it('accepts one overlapping create per user and releases the lock afterward', async () => {
+		let finish;
+		let created = 0;
+		api.topics.create = async () => {
+			await new Promise((resolve) => { finish = resolve; });
+			created += 1;
+			return { tid: created };
+		};
+		const req = { uid: 42, body: { cid: 1, title: 'Title', content: 'Content' } };
+		const firstResponse = {};
+		const first = controller.create(req, firstResponse);
+		const overlapping = Array.from({ length: 4 }, () => controller.create(req, {}).then(() => 'accepted', err => err.message));
+		const results = await Promise.all(overlapping.map(promise => Promise.race([promise, new Promise((resolve) => { setImmediate(() => resolve('still pending')); })])));
+		results.forEach(result => assert.match(result, /posting/i));
+		assert.strictEqual(created, 0);
+		finish();
+		await first;
+		assert.strictEqual(firstResponse.status, 200);
+		assert.deepStrictEqual(firstResponse.payload, { tid: 1 });
+		assert.strictEqual(created, 1);
+
+		const next = controller.create(req, {});
+		finish();
+		await next;
+		assert.strictEqual(created, 2);
+	});
+
+	it('shares the lock with replies and releases it after a failed create', async () => {
+		let finish;
+		api.topics.create = async () => {
+			await new Promise((resolve) => { finish = resolve; });
+			throw new Error('create failed');
+		};
+		api.topics.reply = async () => ({ pid: 1 });
+		const req = { uid: 43, body: { cid: 1, title: 'Title', content: 'Content' }, params: { tid: 1 } };
+		const first = controller.create(req, {});
+		await assert.rejects(controller.reply(req, {}), /posting/i);
+		finish();
+		await assert.rejects(first, /create failed/);
+		const response = {};
+		await controller.reply(req, response);
+		assert.strictEqual(response.status, 200);
+	});
+
+	it('uses user or guest session keys and keeps actors independent', () => {
+		const userKey = controller.lockPosting({ uid: 44 }, 'busy');
+		const guestKey = controller.lockPosting({ uid: 0, sessionID: 'guest-a' }, 'busy');
+		assert.strictEqual(userKey, 'posting44');
+		assert.strictEqual(guestKey, 'postingguest-a');
+		assert.throws(() => controller.lockPosting({ uid: 44 }, 'busy'), /busy/);
+		assert.throws(() => controller.lockPosting({ uid: 0, sessionID: 'guest-a' }, 'busy'), /busy/);
+		assert.strictEqual(controller.lockPosting({ uid: 45 }, 'busy'), 'posting45');
+		assert.strictEqual(controller.lockPosting({ uid: 0, sessionID: 'guest-b' }, 'busy'), 'postingguest-b');
+	});
+});
