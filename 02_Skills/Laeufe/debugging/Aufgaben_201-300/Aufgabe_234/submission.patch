diff --git a/core/scrobbler/play_tracker_tx_test.go b/core/scrobbler/play_tracker_tx_test.go
new file mode 100644
index 0000000..e175955
--- /dev/null
+++ b/core/scrobbler/play_tracker_tx_test.go
@@ -0,0 +1,69 @@
+package scrobbler
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+type countingAnnotations struct {
+	model.MediaFileRepository
+	calls *int
+}
+
+func (r countingAnnotations) IncPlayCount(string, time.Time) error {
+	(*r.calls)++
+	return nil
+}
+
+type countingAlbum struct {
+	model.AlbumRepository
+	calls *int
+}
+
+func (r countingAlbum) IncPlayCount(string, time.Time) error {
+	(*r.calls)++
+	return nil
+}
+
+type countingArtist struct {
+	model.ArtistRepository
+	calls *int
+}
+
+func (r countingArtist) IncPlayCount(string, time.Time) error {
+	(*r.calls)++
+	return nil
+}
+
+type txProbeStore struct {
+	model.DataStore
+	calls *int
+	tx    model.DataStore
+}
+
+func (s txProbeStore) MediaFile(context.Context) model.MediaFileRepository {
+	return countingAnnotations{calls: s.calls}
+}
+func (s txProbeStore) Album(context.Context) model.AlbumRepository {
+	return countingAlbum{calls: s.calls}
+}
+func (s txProbeStore) Artist(context.Context) model.ArtistRepository {
+	return countingArtist{calls: s.calls}
+}
+func (s txProbeStore) WithTx(fn func(model.DataStore) error) error { return fn(s.tx) }
+
+func TestIncPlayUsesTransactionStore(t *testing.T) {
+	var outside, inside int
+	tx := txProbeStore{calls: &inside}
+	store := txProbeStore{calls: &outside, tx: tx}
+	p := playTracker{ds: store}
+	if err := p.incPlay(context.Background(), &model.MediaFile{ID: "track", AlbumID: "album", ArtistID: "artist"}, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if outside != 0 || inside != 3 {
+		t.Fatalf("writes outside transaction: %d; inside transaction: %d", outside, inside)
+	}
+}
