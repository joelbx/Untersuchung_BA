+func sqliteDSN(path string) string {
+	if path == ":memory:" {
+		path = "file::memory:"
+	}
+	name, rawQuery, _ := strings.Cut(path, "?")
+	options, err := url.ParseQuery(rawQuery)
+	if err != nil {
+		panic(err)
+	}
+	options.Set("cache", "shared")
+	options.Set("_cache_size", "1000000000")
+	options.Set("_busy_timeout", "5000")
+	options.Set("_journal_mode", "WAL")
+	options.Set("_synchronous", "NORMAL")
+	options.Set("_foreign_keys", "on")
+	options.Set("_txlock", "immediate")
+	return name + "?" + options.Encode()
+}
