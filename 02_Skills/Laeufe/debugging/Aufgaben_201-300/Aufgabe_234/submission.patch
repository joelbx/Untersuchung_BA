+func TestSQLiteDSN(t *testing.T) {
+	for _, path := range []string{"music.db", "file::memory:?mode=memory"} {
+		dsn := sqliteDSN(path)
+		name, rawQuery, _ := strings.Cut(dsn, "?")
+		originalName, originalQuery, _ := strings.Cut(path, "?")
+		options, err := url.ParseQuery(rawQuery)
+		if err != nil {
+			t.Fatal(err)
+		}
+		originalOptions, err := url.ParseQuery(originalQuery)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if name != originalName || options.Get("mode") != originalOptions.Get("mode") {
+			t.Fatalf("DSN %q does not preserve path %q", dsn, path)
+		}
+		for _, option := range []string{"cache=shared", "_cache_size=1000000000", "_busy_timeout=5000", "_journal_mode=WAL", "_synchronous=NORMAL", "_foreign_keys=on", "_txlock=immediate"} {
+			if !strings.Contains(dsn, option) {
+				t.Errorf("DSN %q missing %q", dsn, option)
+			}
+		}
+	}
+}
