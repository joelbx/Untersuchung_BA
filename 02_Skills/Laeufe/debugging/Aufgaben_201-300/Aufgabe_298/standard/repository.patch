+// evictExpired runs a sweep when the earliest known expiration has passed.
+// Callers hold mu, while the atomic deadline avoids unnecessary sweeps.
+func (c *simpleCache[K, V]) evictExpired() {
+	deadline := c.evictionDeadline.Load()
+	if deadline != nil && time.Now().Before(*deadline) {
+		return
+	}
+
+	// Use a distant deadline until the remaining items are scanned for
+	// their next expiration.
+	next := time.Now().Add(24 * time.Hour)
+	if !c.evictionDeadline.CompareAndSwap(deadline, &next) {
+		return
+	}
+	c.data.DeleteExpired()
+	c.data.Range(func(item *ttlcache.Item[K, V]) bool {
+		c.scheduleEviction(item)
+		return true
+	})
+}
+
+func (c *simpleCache[K, V]) scheduleEviction(item *ttlcache.Item[K, V]) {
+	expiresAt := item.ExpiresAt()
+	if expiresAt.IsZero() {
+		return
+	}
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && !expiresAt.Before(*deadline) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(deadline, &expiresAt) {
+			return
+		}
+	}
 }
 
