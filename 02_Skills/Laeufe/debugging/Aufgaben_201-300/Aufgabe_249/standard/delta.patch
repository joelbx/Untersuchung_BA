 import pytest
 from unittest.mock import patch
 from openlibrary.core import wikidata
+from openlibrary.core import models
 from datetime import datetime, timedelta
+from types import SimpleNamespace
 
 EXAMPLE_WIKIDATA_DICT = {
     'id': "Q42",
@@ -75,3 +77,89 @@ def test_get_wikidata_entity(
             mock_get_from_cache.assert_called_once()
         else:
             mock_get_from_cache.assert_not_called()
+
+
+def test_wikipedia_link_language_and_fallback():
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+        'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'},
+    }
+    assert entity._get_wikipedia_link('fr') == (
+        'https://fr.wikipedia.org/wiki/Douglas_Adams', 'fr'
+    )
+    assert entity._get_wikipedia_link('de') == (
+        'https://en.wikipedia.org/wiki/Douglas_Adams', 'en'
+    )
+    entity.sitelinks = {'frwiki': entity.sitelinks['frwiki']}
+    assert entity._get_wikipedia_link('de') is None
+
+
+def test_statement_values_ignores_malformed_entries():
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'scholar-1'}},
+            {'value': {'content': 'scholar-2'}},
+            {'value': {}},
+            {},
+            {'value': None},
+            {'value': {'content': None}},
+        ]
+    }
+    assert entity._get_statement_values('P1960') == ['scholar-1', 'scholar-2']
+    assert entity._get_statement_values('P9999') == []
+    entity.statements['P1960'] = {'value': {'content': 'single'}}
+    assert entity._get_statement_values('P1960') == ['single']
+
+
+def test_external_profiles_include_each_scholar_identifier():
+    entity = createWikidataEntity()
+    entity.sitelinks = {'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'}}
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'scholar-1'}},
+            {'value': {'content': 'scholar-2'}},
+        ]
+    }
+    assert entity.get_external_profiles('de') == [
+        {
+            'url': 'https://en.wikipedia.org/wiki/Douglas_Adams',
+            'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+            'label': 'Wikipedia',
+        },
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=scholar-1',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=scholar-2',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+    ]
+    entity.sitelinks = {}
+    entity.statements = {}
+    assert entity.get_external_profiles() == [
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        }
+    ]
+
+
+def test_author_wikidata_uses_remote_id():
+    author = SimpleNamespace(remote_ids={'wikidata': 'Q42'})
+    entity = createWikidataEntity()
+    with patch.object(models, 'get_wikidata_entity', return_value=entity) as get_entity:
+        assert models.Author.wikidata(author) is entity
+    get_entity.assert_called_once_with(
+        qid='Q42', bust_cache=False, fetch_missing=False
+    )
