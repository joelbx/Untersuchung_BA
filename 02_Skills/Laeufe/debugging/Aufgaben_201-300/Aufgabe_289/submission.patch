diff --git a/internal/config/exported_defaults_test.go b/internal/config/exported_defaults_test.go
new file mode 100644
index 0000000..63b2183
--- /dev/null
+++ b/internal/config/exported_defaults_test.go
@@ -0,0 +1,68 @@
+package config
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	cueerrors "cuelang.org/go/cue/errors"
+	"github.com/mitchellh/mapstructure"
+)
+
+func TestExportedDefaultsDecode(t *testing.T) {
+	defaults := DefaultConfig()
+	if defaults == nil {
+		t.Fatal("DefaultConfig returned nil")
+	}
+
+	var decoded Config
+	decoder, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		Result:     &decoded,
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := decoder.Decode(map[string]interface{}{
+		"cache": map[string]interface{}{"ttl": "1m"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.Cache.TTL != time.Minute {
+		t.Fatalf("cache ttl = %v, want 1m", decoded.Cache.TTL)
+	}
+}
+
+func TestDefaultConfigCUESchema(t *testing.T) {
+	var values map[string]interface{}
+	decoder, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		Result:     &values,
+		TagName:    "mapstructure",
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(DecodeHooks...),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := decoder.Decode(DefaultConfig()); err != nil {
+		t.Fatal(err)
+	}
+
+	schema, err := os.ReadFile("../../config/flipt.schema.cue")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := cuecontext.New()
+	compiled := ctx.CompileBytes(schema)
+	if err := compiled.Err(); err != nil {
+		t.Fatal(err)
+	}
+	spec := compiled.LookupPath(cue.ParsePath("#FliptSpec"))
+	if err := spec.Err(); err != nil {
+		t.Fatal(err)
+	}
+	if err := spec.Unify(ctx.Encode(values)).Validate(); err != nil {
+		t.Fatal(cueerrors.Details(err, nil))
+	}
+}
