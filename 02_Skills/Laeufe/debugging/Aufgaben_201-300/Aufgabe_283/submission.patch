+import { fireEvent, render, screen } from '@testing-library/react';
+
+import VerifiedBadge from './VerifiedBadge';
+
+it('renders a verified message badge with a tooltip', async () => {
+    render(<VerifiedBadge />);
+
+    const badge = screen.getByAltText('Proton verified');
+    fireEvent.mouseOver(badge);
+
+    expect(await screen.findByText('Verified message')).toBeInTheDocument();
+});
