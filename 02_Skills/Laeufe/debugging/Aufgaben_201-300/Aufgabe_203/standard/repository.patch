+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+
+import ExternalLink from "../../../../src/components/views/elements/ExternalLink";
+
+jest.mock("../../../../src/languageHandler", () => ({ _t: (key: string) => key }));
+
+describe("ExternalLink", () => {
+    it("forwards anchor props and includes an accessible new-tab cue", () => {
+        const markup = renderToStaticMarkup(
+            <ExternalLink href="https://example.org" className="custom" title="Example" data-testid="external">
+                Example
+            </ExternalLink>,
+        );
+
+        expect(markup).toContain('href="https://example.org"');
+        expect(markup).toContain('target="_blank"');
+        expect(markup).toContain('rel="noreferrer noopener"');
+        expect(markup).toContain('class="mx_ExternalLink custom"');
+        expect(markup).toContain('title="Example"');
+        expect(markup).toContain('data-testid="external"');
+        expect(markup).toContain('aria-hidden="true"');
+        expect(markup).toContain('Opens in a new tab');
+    });
+});
