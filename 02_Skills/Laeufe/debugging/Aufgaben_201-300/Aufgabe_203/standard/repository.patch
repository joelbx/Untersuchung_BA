+
+import React from "react";
+import classNames from "classnames";
+import { _t } from "../../../languageHandler";
+
+const ExternalLink: React.FC<React.AnchorHTMLAttributes<HTMLAnchorElement>> = ({
+    children, className, target = "_blank", rel = "noreferrer noopener", ...props
+}) => <a {...props} className={classNames("mx_ExternalLink", className)} target={target} rel={rel}>
+    { children }
+    { target === "_blank" && <span className="mx_ExternalLink_newTab"> { _t("Opens in a new tab") }</span> }
+    <span className="mx_ExternalLink_icon" aria-hidden="true" />
+</a>;
+
+export default ExternalLink;
