+@pytest.mark.parametrize(
+    ('query', 'old_value', 'expected_values'),
+    [
+        ('a OR b OR a', 'a', ['z', 'b', 'z']),
+        ('(a)', 'a', ['z']),
+        ('NOT a', 'a', ['z']),
+    ],
+)
+def test_luqum_replace_child(query: str, old_value: str, expected_values: list[str]):
+    parent = luqum_parser(query)
+    old_child = Word(old_value)
+    new_child = Word('z')
+
+    assert luqum_replace_child(parent, old_child, new_child) is None
+    assert [child.value for child in parent.children] == expected_values
+    assert all(child is new_child for child in parent.children if child.value == 'z')
+
+
+def test_luqum_replace_child_missing_child():
+    parent = luqum_parser('a OR b')
+    children = parent.children
+
+    luqum_replace_child(parent, Word('missing'), Word('z'))
+
+    assert parent.children is children
+    assert str(parent) == 'a OR b'
+
+
+def test_luqum_replace_child_rejects_unsupported_parent():
+    parent = luqum_parser('title:a')
+
+    with pytest.raises(ValueError, match='^Not supported for generic class Item$'):
+        luqum_replace_child(parent, Word('a'), Word('z'))
+
+
