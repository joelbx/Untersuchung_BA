+@pytest.mark.parametrize('streams', ['stderr', 'stdout stderr'])
+def test_live_output_and_final_summaries(proc, qtbot, caplog, message_mock,
+                                         py_proc, streams):
+    """Each nonempty stream is shown while running and summarized on exit."""
+    proc._output_messages = True
+    code = ["import sys, time"]
+    if 'stdout' in streams:
+        code.append("print('stdout text', flush=True)")
+    code.extend(["print('stderr text', file=sys.stderr, flush=True)",
+                 "time.sleep(2)"])
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            proc.start(*py_proc('; '.join(code)))
+            qtbot.waitUntil(
+                lambda: any(msg.level == usertypes.MessageLevel.error and
+                            msg.text == 'stderr text'
+                            for msg in message_mock.messages), timeout=1500)
+            assert proc.outcome.running
+
+    expected = ([(usertypes.MessageLevel.info, 'stdout text')]
+                if 'stdout' in streams else [])
+    expected.append((usertypes.MessageLevel.error, 'stderr text'))
+    final_messages = message_mock.messages[-len(expected):]
+    assert [(msg.level, msg.text) for msg in final_messages] == expected
+    assert sum(msg.level == usertypes.MessageLevel.error
+               for msg in message_mock.messages) == 2
+    if 'stdout' not in streams:
+        assert len(message_mock.messages) == 2
+
+
 cr_skip = pytest.mark.skipif(
     utils.is_windows, reason='CR handling not implemented on Windows')
 
