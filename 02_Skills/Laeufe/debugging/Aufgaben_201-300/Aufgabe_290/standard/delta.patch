+describe('call sound playback', () => {
+    it.each([AudioID.Ring, AudioID.Ringback, AudioID.Busy, AudioID.CallEnd])(
+        'unmutes %s before playback', async (id) => {
+            const audio = document.createElement('audio');
+            audio.id = id;
+            audio.muted = true;
+            const play = jest.spyOn(audio, 'play').mockImplementation(() => {
+                expect(audio.muted).toBe(false);
+                return Promise.resolve();
+            });
+            document.body.appendChild(audio);
+
+            try {
+                new LegacyCallHandler().play(id);
+                await Promise.resolve();
+                expect(play).toHaveBeenCalledTimes(1);
+                expect(audio.muted).toBe(false);
+            } finally {
+                audio.remove();
+            }
+        },
+    );
+
+    it('plays an already unmuted element without changing its mute state', async () => {
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ring;
+        const mutedSetter = jest.spyOn(audio, 'muted', 'set');
+        const play = jest.spyOn(audio, 'play').mockResolvedValue(undefined);
+        document.body.appendChild(audio);
+
+        try {
+            new LegacyCallHandler().play(AudioID.Ring);
+            await Promise.resolve();
+            expect(play).toHaveBeenCalledTimes(1);
+            expect(mutedSetter).not.toHaveBeenCalled();
+        } finally {
+            audio.remove();
+        }
+    });
+
+    it('unmutes again when a queued replay finds the element muted', async () => {
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ringback;
+        const play = jest.spyOn(audio, 'play').mockImplementation(() => {
+            expect(audio.muted).toBe(false);
+            return Promise.resolve();
+        });
+        jest.spyOn(audio, 'load').mockImplementation(() => {});
+        document.body.appendChild(audio);
+
+        try {
+            const handler = new LegacyCallHandler();
+            handler.play(AudioID.Ringback);
+            audio.muted = true;
+            handler.play(AudioID.Ringback);
+            await new Promise(resolve => setTimeout(resolve, 0));
+            expect(play).toHaveBeenCalledTimes(2);
+            expect(audio.muted).toBe(false);
+        } finally {
+            audio.remove();
+        }
+    });
+});
