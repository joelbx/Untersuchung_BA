+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Classify unvalidated IA ISBN strings by their trimmed length."""
+    if isinstance(isbns, str):
+        isbns = [isbns]
+
+    isbn_10 = []
+    isbn_13 = []
+    for value in isbns:
+        value = value.strip()
+        if len(value) == 10:
+            isbn_10.append(value)
+        elif len(value) == 13:
+            isbn_13.append(value)
+    return isbn_10, isbn_13
+
