+def get_location_and_publisher(loc_pub: str) -> tuple[list[str], list[str]]:
+    """Extract ordered places and publishers from IA publisher metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub:
+        return [], []
+
+    loc_pub = loc_pub.replace('Place of publication not identified', '')
+
+    def clean(value: str) -> str:
+        return value.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+
+    if ':' not in loc_pub:
+        publisher = loc_pub.split(',', 1)[1] if ',' in loc_pub else loc_pub
+        publisher = clean(publisher)
+        return [], [publisher] if publisher else []
+
+    locations: list[str] = []
+    publishers: list[str] = []
+    seen_publisher = False
+    for segment in loc_pub.split(';'):
+        if segment.count(':') > 1:
+            segment = ':'.join(segment.split(':', 2)[:2])
+            stop = True
+        else:
+            stop = False
+
+        if ':' in segment:
+            location, publisher = get_colon_only_loc_pub(segment)
+            if location := clean(location):
+                locations.append(location)
+            if publisher := clean(publisher):
+                publishers.append(publisher)
+            seen_publisher = True
+        elif value := clean(segment):
+            (publishers if seen_publisher else locations).append(value)
+        if stop:
+            break
+
+    return locations, publishers
 
 
