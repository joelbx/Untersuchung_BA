diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..508e374
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,70 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running version and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version represents a proper release build.
+func Is(version string) bool {
+	if version == "" || version == "dev" {
+		return false
+	}
+
+	// Pre-release labels may have a sequence number, such as rc.1 or rc1.
+	for _, label := range []string{"dev", "snapshot", "rc"} {
+		if i := strings.Index(version, "-"+label); i >= 0 {
+			rest := version[i+len(label)+1:]
+			if rest == "" || rest[0] == '.' || rest[0] == '-' || rest[0] == '+' || (rest[0] >= '0' && rest[0] <= '9') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Check fetches the latest release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	return check(ctx, version, github.NewClient(nil))
+}
+
+func check(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, checkError(fmt.Errorf("parsing current version: %w", err))
+	}
+
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, checkError(fmt.Errorf("getting latest release: %w", err))
+	}
+
+	info.LatestVersion = latest.GetTagName()
+	info.LatestVersionURL = latest.GetHTMLURL()
+	parsedLatest, err := semver.ParseTolerant(info.LatestVersion)
+	if err != nil {
+		return info, checkError(fmt.Errorf("parsing latest version: %w", err))
+	}
+
+	info.UpdateAvailable = current.Compare(parsedLatest) < 0
+	return info, nil
+}
+
+func checkError(err error) error {
+	zap.L().Warn("checking for updates", zap.Error(err))
+	return err
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..e0f133d
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,72 @@
+package release
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+)
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3-dev", false},
+		{"v1.2.3-snapshot", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-rc1", false},
+		{"v1.2.3-rc-candidate", false},
+		{"v1.2.3-snapshot.2", false},
+		{"v1.2.3", true},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			if got := Is(tc.version); got != tc.want {
+				t.Errorf("Is(%q) = %t, want %t", tc.version, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+			t.Errorf("unexpected path: %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"tag_name":"v1.3.0","html_url":"https://example.com/release"}`))
+	}))
+	defer server.Close()
+
+	client := github.NewClient(server.Client())
+	baseURL, err := url.Parse(server.URL + "/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.BaseURL = baseURL
+
+	for _, tc := range []struct {
+		version string
+		update  bool
+	}{
+		{"v1.2.0", true},
+		{"v1.3.0", false},
+		{"v1.4.0", false},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			got, err := check(context.Background(), tc.version, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tc.version || got.LatestVersion != "v1.3.0" || got.LatestVersionURL != "https://example.com/release" || got.UpdateAvailable != tc.update {
+				t.Errorf("unexpected release info: %+v", got)
+			}
+		})
+	}
+}
