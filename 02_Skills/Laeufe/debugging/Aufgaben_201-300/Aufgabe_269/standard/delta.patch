+package models
+
+import "testing"
+
+func TestTrivySourceAggregation(t *testing.T) {
+	info := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, Title: "Debian title", Summary: "Debian summary", Cvss3Severity: "LOW"}},
+		TrivyUbuntu: {{Type: TrivyUbuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "MEDIUM"}},
+		TrivyNVD:    {{Type: TrivyNVD, Summary: "NVD summary", Cvss2Score: 4.3, Cvss3Score: 8.1, Cvss3Severity: "HIGH"}},
+	}}
+	if got := info.Titles("en", "debian"); len(got) < 3 || got[0].Type != TrivyDebian {
+		t.Errorf("titles: %+v", got)
+	}
+	if got := info.Summaries("en", "debian"); len(got) < 3 {
+		t.Errorf("summaries: %+v", got)
+	}
+	if got := info.Cvss2Scores(); len(got) != 1 || got[0].Type != TrivyNVD || got[0].Value.Score != 4.3 {
+		t.Errorf("CVSS2: %+v", got)
+	}
+	scores := info.Cvss3Scores()
+	if len(scores) != 3 {
+		t.Fatalf("CVSS3: %+v", scores)
+	}
+	severities := map[CveContentType]string{}
+	for _, score := range scores {
+		severities[score.Type] = score.Value.Severity
+	}
+	if severities[TrivyDebian] != "LOW" || severities[TrivyUbuntu] != "MEDIUM" || severities[TrivyNVD] != "HIGH" {
+		t.Errorf("severities: %+v", severities)
+	}
+}
