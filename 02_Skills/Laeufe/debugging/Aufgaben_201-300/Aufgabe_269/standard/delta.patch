new file mode 100644
index 0000000..e1de425
--- /dev/null
+++ b/detector/library_trivy_test.go
@@ -0,0 +1,36 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsPreservesVendorData(t *testing.T) {
+	published := time.Date(2024, 4, 5, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	vul := trivydbTypes.Vulnerability{
+		Title: "title", Description: "summary", Severity: "HIGH",
+		VendorSeverity: trivydbTypes.VendorSeverity{"debian": trivydbTypes.SeverityLow, "ubuntu": trivydbTypes.SeverityMedium},
+		CVSS:           trivydbTypes.VendorCVSS{"nvd": {V2Score: 4.3, V2Vector: "AV:N", V3Score: 8.1, V3Vector: "CVSS:3.1/test"}},
+		References:     []string{"https://example.com/ref"}, PublishedDate: &published, LastModifiedDate: &modified,
+	}
+	got := getCveContents("CVE-2024-1234", vul)
+	if len(got) != 3 {
+		t.Fatalf("expected three source entries, got %+v", got)
+	}
+	for typ, severity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM"} {
+		c := got[typ][0]
+		if c.Type != typ || c.CveID != "CVE-2024-1234" || c.Title != "title" || c.Summary != "summary" || c.Cvss3Severity != severity || len(c.References) != 1 || !c.Published.Equal(published) || !c.LastModified.Equal(modified) {
+			t.Errorf("%s: %+v", typ, c)
+		}
+	}
+	nvd := got[models.TrivyNVD][0]
+	if nvd.Cvss2Score != 4.3 || nvd.Cvss2Vector != "AV:N" || nvd.Cvss3Score != 8.1 || nvd.Cvss3Vector != "CVSS:3.1/test" {
+		t.Errorf("NVD: %+v", nvd)
+	}
+}
