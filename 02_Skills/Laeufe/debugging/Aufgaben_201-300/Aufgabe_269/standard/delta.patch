@@ -0,0 +1,36 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	results := types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-2024-1234", Vulnerability: dbtypes.Vulnerability{Title: "title", Description: "summary", VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "nvd": dbtypes.SeverityHigh}, CVSS: dbtypes.VendorCVSS{"nvd": {V3Score: 8.1, V3Vector: "CVSS:3.1/test"}}, References: []string{"https://example.com/ref"}, PublishedDate: &published, LastModifiedDate: &modified}}}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-2024-1234", Vulnerability: dbtypes.Vulnerability{VendorSeverity: dbtypes.VendorSeverity{"ubuntu": dbtypes.SeverityMedium}}}}},
+	}
+	got, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := got.ScannedCves["CVE-2024-1234"].CveContents
+	for typ, severity := range map[models.CveContentType]string{models.CveContentType("trivy:debian"): "LOW", models.CveContentType("trivy:nvd"): "HIGH", models.CveContentType("trivy:ubuntu"): "MEDIUM"} {
+		if len(contents[typ]) != 1 || contents[typ][0].Cvss3Severity != severity || contents[typ][0].Type != typ || contents[typ][0].CveID != "CVE-2024-1234" {
+			t.Errorf("%s: %+v", typ, contents[typ])
+		}
+	}
+	if contents[models.CveContentType("trivy:nvd")][0].Cvss3Score != 8.1 || contents[models.CveContentType("trivy:nvd")][0].Cvss3Vector != "CVSS:3.1/test" {
+		t.Errorf("NVD CVSS: %+v", contents[models.CveContentType("trivy:nvd")])
+	}
+	if !contents[models.CveContentType("trivy:debian")][0].Published.Equal(published) || !contents[models.CveContentType("trivy:debian")][0].LastModified.Equal(modified) {
+		t.Errorf("dates: %+v", contents[models.CveContentType("trivy:debian")])
+	}
+}
