new file mode 100644
index 0000000..cfcfc8c
--- /dev/null
+++ b/models/trivy.go
@@ -0,0 +1,56 @@
+package models
+
+import (
+	"sort"
+	"strings"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+)
+
+// NewTrivyCveContents keeps each Trivy database source's severity and CVSS together.
+func NewTrivyCveContents(cveID string, vul trivydbTypes.Vulnerability) CveContents {
+	refs := make(References, 0, len(vul.References))
+	for _, url := range vul.References {
+		refs = append(refs, Reference{Source: "trivy", Link: url})
+	}
+	sort.Slice(refs, func(i, j int) bool { return refs[i].Link < refs[j].Link })
+
+	base := CveContent{CveID: cveID, Title: vul.Title, Summary: vul.Description, References: refs}
+	if vul.PublishedDate != nil {
+		base.Published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		base.LastModified = *vul.LastModifiedDate
+	}
+
+	sources := map[trivydbTypes.SourceID]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[source] = struct{}{}
+	}
+	contents := CveContents{}
+	if len(sources) == 0 {
+		base.Type = Trivy
+		base.Cvss3Severity = vul.Severity
+		contents[Trivy] = []CveContent{base}
+		return contents
+	}
+	for source := range sources {
+		typ := CveContentType("trivy:" + strings.ToLower(string(source)))
+		content := base
+		content.Type = typ
+		if severity, ok := vul.VendorSeverity[source]; ok {
+			content.Cvss3Severity = severity.String()
+		}
+		if cvss, ok := vul.CVSS[source]; ok {
+			content.Cvss2Score = cvss.V2Score
+			content.Cvss2Vector = cvss.V2Vector
+			content.Cvss3Score = cvss.V3Score
+			content.Cvss3Vector = cvss.V3Vector
+		}
+		contents[typ] = []CveContent{content}
+	}
+	return contents
+}
