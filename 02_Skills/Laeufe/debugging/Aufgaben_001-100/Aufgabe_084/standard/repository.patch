@@ -131,6 +131,30 @@ export function haveSameId(entity1: SomeEntity, entity2: SomeEntity): boolean {
 	return isSameId(entity1._id, entity2._id)
 }
 
+/** Removes update metadata from a cloned entity before it is used as a new instance. */
+export function removeTechnicalFields<E extends SomeEntity>(entity: E): void {
+	const visited = new WeakSet<object>()
+
+	function removeFromObject(value: object): void {
+		if (visited.has(value)) return
+		visited.add(value)
+
+		for (const key of Object.keys(value)) {
+			const fields = value as Record<string, unknown>
+			if (key.startsWith("_finalEncrypted") || key.startsWith("_defaultEncrypted") || key.startsWith("_errors")) {
+				delete fields[key]
+			} else {
+				const nested = fields[key]
+				if (nested !== null && typeof nested === "object") {
+					removeFromObject(nested)
+				}
+			}
+		}
+	}
+
+	removeFromObject(entity)
+}
+
 export function containsId(ids: ReadonlyArray<Id | IdTuple>, id: Id | IdTuple): boolean {
 	return ids.find((idInArray) => isSameId(idInArray, id)) != null
 }
