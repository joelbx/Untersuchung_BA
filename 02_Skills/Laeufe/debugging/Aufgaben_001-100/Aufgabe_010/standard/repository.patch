+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import { mount } from "enzyme";
+
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import SenderProfile from "../../../../src/components/views/messages/SenderProfile";
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+import RoomContext from "../../../../src/contexts/RoomContext";
+import dis from "../../../../src/dispatcher/dispatcher";
+import { mkEvent, stubClient } from "../../../test-utils";
+
+describe("ReplyPreview", () => {
+    stubClient();
+
+    it("identifies the sender and offers a labeled cancel action", () => {
+        const event = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:server",
+            user: "@alice:server",
+            content: { msgtype: "m.text", body: "Hello" },
+            ts: Date.now(),
+        });
+        const dispatch = jest.spyOn(dis, "dispatch").mockImplementation(() => undefined);
+        const wrapper = mount(<RoomContext.Provider value={{ timelineRenderingType: "Room" } as any}>
+            <ReplyPreview replyToEvent={event} permalinkCreator={null} />
+        </RoomContext.Provider>);
+
+        expect(wrapper.find(".mx_ReplyPreview_replyingTo").text()).toContain("Replying to");
+        expect(wrapper.find(SenderProfile).first().prop("mxEvent")).toBe(event);
+        expect(wrapper.find(SenderProfile).first().prop("as")).toBe("span");
+        expect(wrapper.find("span.mx_DisambiguatedProfile")).toHaveLength(1);
+        const cancel = wrapper.find(CancelButton);
+        expect(cancel.prop("aria-label")).toBe("Cancel reply");
+        cancel.find("button").simulate("click");
+        expect(dispatch).toHaveBeenCalledWith(expect.objectContaining({ action: "reply_to_event", event: null }));
+
+        wrapper.unmount();
+        dispatch.mockRestore();
+    });
+});
