+    def test_first_fork_failure_is_json(self, monkeypatch, tmp_path, capsys):
+        def fail_fork():
+            raise OSError(11, 'fork unavailable')
+
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'job', '10', '/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        monkeypatch.setattr(async_wrapper, 'ipc_notifier', MagicMock())
+        monkeypatch.setattr(async_wrapper, 'ipc_watcher', MagicMock())
+
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+
+        output = capsys.readouterr()
+        result = json.loads(output.out)
+        assert exc.value.code == 1
+        assert output.err == ''
+        assert result['failed'] is True
+        assert result['ansible_job_id'] == 'job.%s' % os.getpid()
+        assert 'fork' in result['msg']
+        with open(str(tmp_path / result['ansible_job_id'])) as jobfile:
+            assert json.load(jobfile) == result
+
+    def test_job_writer_replaces_complete_record(self, monkeypatch, tmp_path):
+        jobpath = str(tmp_path / 'job')
+        monkeypatch.setattr(async_wrapper, 'job_path', jobpath, raising=False)
+        async_wrapper.jwrite({'started': 1, 'finished': 0, 'ansible_job_id': 'job'})
+        assert json.loads((tmp_path / 'job').read_text())['finished'] == 0
+        assert not (tmp_path / 'job.tmp').exists()
+
