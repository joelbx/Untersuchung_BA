diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..359ca11
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,49 @@
+package evaluation
+
+import (
+	"errors"
+	"testing"
+
+	ferrors "go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/storage"
+)
+
+func TestListOperators(t *testing.T) {
+	for _, tc := range []struct {
+		op, list, input string
+		want            bool
+		invalid         bool
+	}{
+		{"isoneof", `["a","b"]`, "b", true, false},
+		{"isoneof", `["a","b"]`, "c", false, false},
+		{"isnotoneof", `["a","b"]`, "c", true, false},
+		{"isnotoneof", `["a","b"]`, "a", false, false},
+		{"isoneof", `["", "a"]`, "", true, false},
+		{"isoneof", `bad`, "a", false, false},
+		{"isnotoneof", `bad`, "a", true, false},
+	} {
+		got := matchesString(storage.EvaluationConstraint{Operator: tc.op, Value: tc.list}, tc.input)
+		if got != tc.want {
+			t.Errorf("string %s %s %q: got %v want %v", tc.op, tc.list, tc.input, got, tc.want)
+		}
+	}
+	for _, tc := range []struct {
+		op, list, input string
+		want            bool
+		invalid         bool
+	}{
+		{"isoneof", `[1,2.5]`, "2.5", true, false},
+		{"isoneof", `[1,2.5]`, "3", false, false},
+		{"isnotoneof", `[1,2.5]`, "3", true, false},
+		{"isnotoneof", `[1,2.5]`, "1", false, false},
+		{"isoneof", `bad`, "1", false, true},
+		{"isoneof", `bad`, "", false, true},
+		{"isnotoneof", `[1,"x"]`, "1", false, true},
+	} {
+		got, err := matchesNumber(storage.EvaluationConstraint{Operator: tc.op, Value: tc.list}, tc.input)
+		var invalid ferrors.ErrInvalid
+		if got != tc.want || errors.As(err, &invalid) != tc.invalid {
+			t.Errorf("number %s %s %q: got %v, %v; want %v, invalid=%v", tc.op, tc.list, tc.input, got, err, tc.want, tc.invalid)
+		}
+	}
+}
diff --git a/rpc/flipt/list_validation_test.go b/rpc/flipt/list_validation_test.go
new file mode 100644
index 0000000..a4ee1ac
--- /dev/null
+++ b/rpc/flipt/list_validation_test.go
@@ -0,0 +1,55 @@
+package flipt
+
+import (
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/errors"
+)
+
+func TestListConstraintValidation(t *testing.T) {
+	for _, typ := range []ComparisonType{ComparisonType_STRING_COMPARISON_TYPE, ComparisonType_NUMBER_COMPARISON_TYPE} {
+		valid := `["a","b"]`
+		wrong := `[1,"b"]`
+		kind := "string"
+		item := `"a"`
+		if typ == ComparisonType_NUMBER_COMPARISON_TYPE {
+			valid = `[1,2]`
+			wrong = `[1,"b"]`
+			kind = "number"
+			item = `1`
+		}
+		array := func(n int) string { return `[` + strings.TrimSuffix(strings.Repeat(item+`,`, n), `,`) + `]` }
+		for _, op := range []string{"isoneof", "isnotoneof"} {
+			for _, tc := range []struct {
+				value string
+				want  error
+			}{
+				{valid, nil},
+				{`[]`, nil},
+				{array(100), nil},
+				{wrong, errors.ErrInvalid(`invalid value provided for property "p" of type ` + kind)},
+				{`bad`, errors.ErrInvalid(`invalid value provided for property "p" of type ` + kind)},
+				{`null`, errors.ErrInvalid(`invalid value provided for property "p" of type ` + kind)},
+				{array(101), errors.ErrInvalid(`too many values provided for property "p" of type ` + kind + ` (maximum 100)`)},
+			} {
+				create := (&CreateConstraintRequest{SegmentKey: "s", Property: "p", Operator: op, Type: typ, Value: tc.value}).Validate()
+				update := (&UpdateConstraintRequest{Id: "i", SegmentKey: "s", Property: "p", Operator: op, Type: typ, Value: tc.value}).Validate()
+				if create != tc.want || update != tc.want {
+					t.Errorf("%s %s %s: create=%v update=%v want=%v", kind, op, tc.value, create, update, tc.want)
+				}
+			}
+		}
+	}
+}
+
+func TestListOperatorsRejectDateTime(t *testing.T) {
+	for _, op := range []string{OpIsOneOf, OpIsNotOneOf} {
+		want := errors.ErrInvalid(`constraint operator "` + op + `" is not valid for type datetime`)
+		create := (&CreateConstraintRequest{SegmentKey: "s", Property: "p", Operator: op, Type: ComparisonType_DATETIME_COMPARISON_TYPE, Value: `[1]`}).Validate()
+		update := (&UpdateConstraintRequest{Id: "i", SegmentKey: "s", Property: "p", Operator: op, Type: ComparisonType_DATETIME_COMPARISON_TYPE, Value: `[1]`}).Validate()
+		if create != want || update != want {
+			t.Errorf("%s: create=%v update=%v want=%v", op, create, update, want)
+		}
+	}
+}
