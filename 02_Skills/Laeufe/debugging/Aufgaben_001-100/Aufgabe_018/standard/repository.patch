+func TestLoadAllowedOriginsFromScalar(t *testing.T) {
+	tests := []struct {
+		name  string
+		value string
+		want  []string
+	}{
+		{"spaces", "foo.com bar.com  baz.com", []string{"foo.com", "bar.com", "baz.com"}},
+		{"mixed whitespace", " \tfoo.com\tbar.com\n baz.com \r\n", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "", []string{}},
+		{"only whitespace", " \t\n ", []string{}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(fmt.Sprintf("cors:\n  allowed_origins: %q\n", tt.value)), 0600))
+
+			cfg, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+
+			if tt.value != "" {
+				t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", tt.value)
+				cfg, err = Load("./testdata/default.yml")
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+			}
+		})
+	}
+}
