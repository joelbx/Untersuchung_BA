+func TestStringSliceDecodeHookOnlyConvertsStringsToStringSlices(t *testing.T) {
+	tests := []struct {
+		name   string
+		input  interface{}
+		target interface{}
+	}{
+		{"sequence", []string{"foo.com", "bar.com"}, []string{}},
+		{"non-string input", 42, []string{}},
+		{"other slice target", "foo.com bar.com", []int{}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := mapstructure.DecodeHookExec(decodeHooks, reflect.ValueOf(tt.input), reflect.ValueOf(tt.target))
+			require.NoError(t, err)
+			assert.Equal(t, tt.input, got)
+		})
+	}
+}
