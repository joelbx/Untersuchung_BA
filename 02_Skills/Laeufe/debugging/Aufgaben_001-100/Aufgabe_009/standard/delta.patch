+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'DEVICE', display_name: 'Original', isVerified: false };
+
+    it('saves a changed name and returns to the read view', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId, queryByTestId } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+
+        await waitFor(() => expect(getByTestId('device-detail-heading').textContent).toContain('Work Laptop'));
+        expect(queryByTestId('device-detail-name-edit')).toBeNull();
+        expect(saveDeviceName).toHaveBeenCalledWith('DEVICE', 'Work Laptop');
+    });
+
+    it('shows the device ID when the name is undefined and accepts an empty name', async () => {
+        const unnamed = { ...device, display_name: undefined };
+        const { getByTestId: getUnnamedByTestId, unmount } = render(
+            <DeviceDetailHeading device={unnamed} saveDeviceName={jest.fn()} />,
+        );
+        expect(getUnnamedByTestId('device-detail-heading').textContent).toContain('DEVICE');
+        unmount();
+
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(saveDeviceName).toHaveBeenCalledWith('DEVICE', ''));
+        await waitFor(() => expect(getByTestId('device-detail-heading')).toBeTruthy());
+        expect(getByTestId('device-detail-heading').querySelector('h3')?.textContent).toBe('');
+    });
+
+    it('cancels without saving and skips an unchanged name', async () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Other' } });
+        fireEvent.click(getByTestId('device-detail-name-cancel'));
+        expect(getByTestId('device-detail-heading').textContent).toContain('Original');
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading')).toBeTruthy());
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('keeps the form open and shows a save error', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('network error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Other' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-name-error').textContent)
+            .toBe('Failed to set display name.'));
+        expect(getByTestId('device-detail-name-edit')).toBeTruthy();
+        expect(getByTestId('device-detail-name-input').getAttribute('maxLength')).toBe('100');
+    });
+});
