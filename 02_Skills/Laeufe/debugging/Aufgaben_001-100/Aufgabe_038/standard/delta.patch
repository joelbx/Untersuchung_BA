+        # HTTPResponse implements the file interface itself.
+        fileobj = fp.fp if PY2 and hasattr(fp, 'fp') else fp
+        super(GzipDecodedReader, self).__init__(fileobj=fileobj, mode='rb')
+        # HTTP consumers (including uri) inspect fp on the returned response.
+        self.fp = fp
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    def close(self):
+        try:
+            super(GzipDecodedReader, self).close()
+        finally:
+            self._response.close()
+
+    @staticmethod
+    def missing_gzip_error():
+        return missing_required_lib('gzip', reason='to decompress gzip-encoded HTTP responses')
 
 
