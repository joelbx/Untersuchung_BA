--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,21 @@
+import { DialogHTMLAttributes, HTMLAttributes, Ref, forwardRef } from 'react';
+
+interface Props extends DialogHTMLAttributes<HTMLDialogElement> {}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props, ref): JSX.Element => {
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        return (
+            <div
+                role="dialog"
+                {...(props as unknown as HTMLAttributes<HTMLDivElement>)}
+                ref={ref as unknown as Ref<HTMLDivElement>}
+            />
+        );
+    }
+
+    return <dialog {...props} ref={ref} />;
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
