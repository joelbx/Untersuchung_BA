new file mode 100644
index 0000000..9c63e58
--- /dev/null
+++ b/internal/server/auth/method/oidc/http_domain_test.go
@@ -0,0 +1,69 @@
+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestStateCookieDomainAndPath(t *testing.T) {
+	for _, tt := range []struct {
+		domain string
+		want   string
+	}{
+		{"localhost", ""},
+		{"example.com", "example.com"},
+	} {
+		t.Run(tt.domain, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{Domain: tt.domain})
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			m.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(recorder, request)
+			cookies := recorder.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, stateCookieKey, cookies[0].Name)
+			require.Equal(t, tt.want, cookies[0].Domain)
+			require.Equal(t, "/auth/v1/method/oidc/google/callback", cookies[0].Path)
+		})
+	}
+}
+
+func TestTokenCookieDomain(t *testing.T) {
+	for _, tt := range []struct {
+		domain string
+		want   string
+	}{
+		{"localhost", ""},
+		{"example.com", "example.com"},
+	} {
+		t.Run(tt.domain, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{Domain: tt.domain})
+			recorder := httptest.NewRecorder()
+			require.NoError(t, m.ForwardResponseOption(context.Background(), recorder, &auth.CallbackResponse{ClientToken: "token"}))
+			cookies := recorder.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, tokenCookieKey, cookies[0].Name)
+			require.Equal(t, tt.want, cookies[0].Domain)
+		})
+	}
+}
+
+func TestCallbackURLTrailingSlash(t *testing.T) {
+	for _, tt := range []struct {
+		host string
+		want string
+	}{
+		{"http://localhost:8080/", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"https://example.com", "https://example.com/auth/v1/method/oidc/google/callback"},
+		{"https://example.com//", "https://example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		t.Run(tt.host, func(t *testing.T) {
+			require.Equal(t, tt.want, callbackURL(tt.host, "google"))
+		})
+	}
+}
