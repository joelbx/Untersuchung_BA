+func Test_redhatBase_nonstandardSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	line := "elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)"
+	want := &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"}
+	bp, sp, err := o.parseInstalledPackagesLine(line)
+	if err != nil || !reflect.DeepEqual(bp, want) || sp != nil {
+		t.Fatalf("parseInstalledPackagesLine() = (%v, %v, %v), want (%v, nil, nil)", bp, sp, err, want)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Fatalf("warnings = %v, want filename warning", o.warns)
+	}
+
+	o.warns = nil
+	bins, srcs, err := o.parseInstalledPackages(line + "\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil || !reflect.DeepEqual(bins["elasticsearch"], *want) || bins["bar"].Version != "1:9" || srcs["bar"].Name != "bar" {
+		t.Fatalf("parseInstalledPackages() = (%v, %v, %v)", bins, srcs, err)
+	}
+	if len(o.warns) != 1 {
+		t.Fatalf("warnings = %v, want one warning", o.warns)
+	}
+}
+
+func Test_redhatBase_repoquerySourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Amazon, Release: "2 (Karoo)"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm installed\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm installed")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bins["elasticsearch"].Version != "8.17.0" || bins["bar"].Version != "1:9" || srcs["bar"].Name != "bar" || srcs["bar"].Version != "1:9-123a" {
+		t.Fatalf("unexpected packages: bins=%v, srcs=%v", bins, srcs)
+	}
+	if _, ok := srcs["elasticsearch"]; ok || len(o.warns) != 1 {
+		t.Fatalf("unexpected source package or warnings: srcs=%v, warns=%v", srcs, o.warns)
+	}
+}
