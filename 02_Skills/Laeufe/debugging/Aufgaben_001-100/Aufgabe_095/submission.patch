+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Format a check-in date to the precision supplied by its components."""
+    result = f'{year:04d}'
+    if month is not None:
+        result += f'-{month:02d}'
+        if day is not None:
+            result += f'-{day:02d}'
+    return result
+
