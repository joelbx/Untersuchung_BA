+package authz
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestFormatNamespaces(t *testing.T) {
+	got, err := FormatNamespaces([]any{"local", "staging"})
+	require.NoError(t, err)
+	require.Equal(t, []string{"local", "staging"}, got)
+	got, err = FormatNamespaces([]any{})
+	require.NoError(t, err)
+	require.Empty(t, got)
+	for _, value := range []any{nil, true, []any{"local", 1}} {
+		_, err := FormatNamespaces(value)
+		require.Error(t, err)
+	}
+}
