+    ns := data.role_namespaces[role][_]
+}`
+	data := `{"role_namespaces":{"devs":["local","staging"],"ops":["production"]}}`
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	engine, err := newEngine(ctx, zaptest.NewLogger(t), withPolicySource(policySource(policy)), withDataSource(dataSource(data), time.Hour))
+	require.NoError(t, err)
+	for _, tc := range []struct {
+		roles []string
+		want  []string
+	}{
+		{nil, []string{}},
+		{[]string{"devs"}, []string{"local", "staging"}},
+		{[]string{"ops"}, []string{"production"}},
+		{[]string{"devs", "ops"}, []string{"local", "staging", "production"}},
+	} {
+		input := map[string]any{}
+		if tc.roles != nil {
+			input["roles"] = tc.roles
+		}
+		got, err := engine.Namespaces(ctx, input)
+		require.NoError(t, err)
+		require.ElementsMatch(t, tc.want, got)
+	}
+}
