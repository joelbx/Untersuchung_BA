 import isTruthy from '@proton/utils/isTruthy';
 
@@ -17,6 +19,20 @@ export const getHostname = (url: string) => {
     return parser.hostname;
 };
 
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(/^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^@/?#]+@)?(?:www\.)?([^./:?#]+)(?:\.[^/:?#]+)+/i);
+    return match?.[1] || '';
+};
+
+export const punycodeUrl = (url: string): string => {
+    const parsed = new URL(url);
+    parsed.hostname = punycode.toASCII(parsed.hostname);
+
+    const credentials = parsed.username ? `${parsed.username}${parsed.password ? `:${parsed.password}` : ''}@` : '';
+    const pathname = parsed.pathname.replace(/\/$/, '');
+    return `${parsed.protocol}//${credentials}${parsed.host}${pathname}${parsed.search}${parsed.hash}`;
+};
+
 export const isMailTo = (url: string): boolean => {
     return url.toLowerCase().startsWith('mailto:');
 };
