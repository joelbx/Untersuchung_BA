@@ -0,0 +1,58 @@
+import { createRef, isValidElement } from 'react';
+
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { useNotifications } from './index';
+import { useLinkHandler } from './useLinkHandler';
+
+jest.mock('../components', () => ({ useModalState: () => [{ open: false }, jest.fn()] }));
+jest.mock('../components/notifications/LinkConfirmationModal', () => jest.fn(() => null));
+jest.mock('./index', () => ({
+    useHandler: (handler: unknown) => handler,
+    useNotifications: jest.fn(),
+}));
+
+describe('useLinkHandler', () => {
+    const createNotification = jest.fn();
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+        (useNotifications as jest.Mock).mockReturnValue({ createNotification });
+    });
+
+    it('passes an external IDN as punycode to the confirmation modal', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        anchor.href = 'https://www.аррӏе.com/path/?q=1#part';
+        wrapper.appendChild(anchor);
+        const ref = createRef<HTMLDivElement>();
+        Object.defineProperty(ref, 'current', { value: wrapper });
+
+        const { result } = renderHook(() => useLinkHandler(ref));
+        act(() => anchor.click());
+
+        const { modal } = result.current;
+        expect(isValidElement(modal)).toBe(true);
+        if (!isValidElement(modal)) {
+            throw new Error('Expected a confirmation modal');
+        }
+        expect(modal.props.link).toBe('https://www.xn--80ak6aa92e.com/path?q=1#part');
+    });
+
+    it('notifies and cancels a link whose URL cannot be extracted', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        wrapper.appendChild(anchor);
+        const ref = createRef<HTMLDivElement>();
+        Object.defineProperty(ref, 'current', { value: wrapper });
+
+        renderHook(() => useLinkHandler(ref));
+        const event = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(event);
+        });
+
+        expect(event.defaultPrevented).toBe(true);
+        expect(createNotification).toHaveBeenCalledWith(expect.objectContaining({ type: 'error' }));
+    });
+});
