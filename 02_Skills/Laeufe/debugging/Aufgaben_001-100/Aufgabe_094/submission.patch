+// limitations under the License.
+
+#include "diag.h"
+
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+
+void TouchIDDiagnostics(TouchIDDiag *result) {
+  *result = (TouchIDDiag){0};
+
+  SecCodeRef code = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &code) == errSecSuccess) {
+    result->has_signature =
+        SecCodeCheckValidity(code, kSecCSDefaultFlags, NULL) == errSecSuccess;
+
+    CFDictionaryRef signingInfo = NULL;
+    if (SecCodeCopySigningInformation(code, kSecCSSigningInformation,
+                                      &signingInfo) == errSecSuccess) {
+      NSDictionary *info = (__bridge NSDictionary *)signingInfo;
+      NSDictionary *entitlements = info[(__bridge NSString *)kSecCodeInfoEntitlementsDict];
+      NSString *appID = entitlements[@"com.apple.application-identifier"];
+      NSArray *groups = entitlements[@"keychain-access-groups"];
+      result->has_entitlements =
+          [appID isKindOfClass:[NSString class]] &&
+          [groups isKindOfClass:[NSArray class]] &&
+          [groups containsObject:appID];
+      CFRelease(signingInfo);
+    }
+    CFRelease(code);
+  }
+
+  LAContext *context = [[LAContext alloc] init];
+  NSError *policyError = nil;
+  result->passed_la_policy_test =
+      [context canEvaluatePolicy:LAPolicyDeviceOwnerAuthenticationWithBiometrics
+                           error:&policyError];
+
+  // Creating a key exercises Secure Enclave access using the same access
+  // control as registration. Remove the probe key immediately afterward.
+  CFErrorRef accessError = NULL;
+  SecAccessControlRef access = SecAccessControlCreateWithFlags(
+      kCFAllocatorDefault, kSecAttrAccessibleWhenUnlockedThisDeviceOnly,
+      kSecAccessControlPrivateKeyUsage | kSecAccessControlBiometryAny,
+      &accessError);
+  if (accessError) {
+    CFRelease(accessError);
+  }
+  if (!access) {
+    return;
+  }
+
+  NSDictionary *attributes = @{
+    (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+    (id)kSecAttrKeySizeInBits : @256,
+    (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+    (id)kSecPrivateKeyAttrs : @{
+      (id)kSecAttrIsPermanent : @YES,
+      (id)kSecAttrAccessControl : (__bridge id)access,
+      (id)kSecAttrLabel : @"Teleport Touch ID diagnostic",
+    },
+  };
+  CFErrorRef keyError = NULL;
+  SecKeyRef key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes,
+                                       &keyError);
+  result->passed_secure_enclave_test = key != NULL;
+  if (key) {
+    NSDictionary *query = @{
+      (id)kSecClass : (id)kSecClassKey,
+      (id)kSecValueRef : (__bridge id)key,
+    };
+    SecItemDelete((__bridge CFDictionaryRef)query);
+    CFRelease(key);
+  }
+  if (keyError) {
+    CFRelease(keyError);
+  }
+  CFRelease(access);
+}
