diff --git a/scripts/solr_builder/tests/test_fn_to_cli.py b/scripts/solr_builder/tests/test_fn_to_cli.py
index 1399523..53ba216 100644
--- a/scripts/solr_builder/tests/test_fn_to_cli.py
+++ b/scripts/solr_builder/tests/test_fn_to_cli.py
@@ -1,4 +1,5 @@
 from argparse import BooleanOptionalAction
+from pathlib import Path
 import typing
 from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
 
@@ -47,3 +48,47 @@ class TestFnToCLI:
     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    def test_required_typed_lists_and_path(self):
+        def fn(numbers: list[int], output: Path):
+            return numbers, output
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1', '2', '3', 'result.txt'])
+        assert cli.run() == ([1, 2, 3], Path('result.txt'))
+
+    def test_optional_typed_lists_and_names(self):
+        def fn(files: list[Path] | None = None, float_values: list[float] | None = None):
+            return files, float_values
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() == (None, None)
+        cli.parse_args(['--files', 'one.txt', 'two.txt', '--float_values', '1.5', '2'])
+        assert cli.run() == ([Path('one.txt'), Path('two.txt')], [1.5, 2.0])
+
+    def test_optional_list_annotation_without_default(self):
+        def fn(files: list[Path] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() is None
+        cli.parse_args(['--files', 'one.txt'])
+        assert cli.run() == [Path('one.txt')]
+
+    def test_string_list_and_optional_int_list(self):
+        def fn(names: list[str], numbers: list[int] | None = None):
+            return names, numbers
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['alice', 'bob', '--numbers', '4', '5'])
+        assert cli.run() == (['alice', 'bob'], [4, 5])
+
+    def test_async_result(self):
+        async def fn(paths: list[Path]):
+            return paths
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['one.txt', 'two.txt'])
+        assert cli.run() == [Path('one.txt'), Path('two.txt')]
