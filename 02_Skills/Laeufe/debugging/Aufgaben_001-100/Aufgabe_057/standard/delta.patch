@@ -0,0 +1,116 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type exportStore struct{ storage.Store }
+
+func (exportStore) ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error) {
+	return []*flipt.Flag{{Key: "flag", Name: "Flag", Enabled: true, Variants: []*flipt.Variant{{Id: "id", Key: "variant", Attachment: `{"nested":{"items":[1,null,true,{"name":"x"}]}}`}}}}, nil
+}
+func (exportStore) ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return []*flipt.Rule{{SegmentKey: "segment", Rank: 1, Distributions: []*flipt.Distribution{{VariantId: "id", Rollout: 100}}}}, nil
+}
+func (exportStore) ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error) {
+	return []*flipt.Segment{{Key: "segment", Name: "Segment"}}, nil
+}
+
+type importStore struct {
+	storage.Store
+	attachments                                        []string
+	flags, segments, constraints, rules, distributions int
+}
+
+func (s *importStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	s.flags++
+	return &flipt.Flag{Key: r.Key}, nil
+}
+func (s *importStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.attachments = append(s.attachments, r.Attachment)
+	return &flipt.Variant{Id: r.Key, Key: r.Key}, nil
+}
+func (s *importStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s.segments++
+	return &flipt.Segment{Key: r.Key}, nil
+}
+func (s *importStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.constraints++
+	return &flipt.Constraint{}, nil
+}
+func (s *importStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	s.rules++
+	return &flipt.Rule{Id: "rule"}, nil
+}
+func (s *importStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.distributions++
+	return &flipt.Distribution{}, nil
+}
+
+func TestAttachmentRoundTrip(t *testing.T) {
+	var buf bytes.Buffer
+	if err := NewExporter(exportStore{}).Export(context.Background(), &buf); err != nil {
+		t.Fatal(err)
+	}
+	var doc struct {
+		Flags []struct {
+			Variants []struct {
+				Attachment interface{} `yaml:"attachment"`
+			} `yaml:"variants"`
+		} `yaml:"flags"`
+	}
+	if err := yaml.Unmarshal(buf.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := doc.Flags[0].Variants[0].Attachment.(map[interface{}]interface{}); !ok {
+		t.Fatalf("attachment is not YAML map: %s", buf.String())
+	}
+	s := &importStore{}
+	if err := NewImporter(s).Import(context.Background(), strings.NewReader(buf.String())); err != nil {
+		t.Fatal(err)
+	}
+	var got interface{}
+	if err := json.Unmarshal([]byte(s.attachments[0]), &got); err != nil {
+		t.Fatal(err)
+	}
+	var want interface{}
+	if err := json.Unmarshal([]byte(`{"nested":{"items":[1,null,true,{"name":"x"}]}}`), &want); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("attachment = %#v, want %#v", got, want)
+	}
+	if s.flags != 1 || s.segments != 1 || s.rules != 1 || s.distributions != 1 {
+		t.Fatalf("entity counts: flags=%d segments=%d rules=%d distributions=%d", s.flags, s.segments, s.rules, s.distributions)
+	}
+}
+
+func TestImportWithoutAttachment(t *testing.T) {
+	s := &importStore{}
+	if err := NewImporter(s).Import(context.Background(), strings.NewReader("flags:\n- key: f\n  variants:\n  - key: v\n")); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.attachments) != 1 || s.attachments[0] != "" {
+		t.Fatalf("attachments = %#v", s.attachments)
+	}
+}
+
+func TestConvertNestedMaps(t *testing.T) {
+	got := convert(map[interface{}]interface{}{"list": []interface{}{map[interface{}]interface{}{1: "one", "nil": nil}}})
+	encoded, err := json.Marshal(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(encoded) != `{"list":[{"1":"one","nil":null}]}` {
+		t.Fatalf("converted JSON = %s", encoded)
+	}
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..abe92d7
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,111 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+// Importer creates store entities from a YAML document.
+type Importer struct{ store creator }
+
+func NewImporter(store creator) *Importer { return &Importer{store: store} }
+
+// convert recursively changes YAML's interface-keyed maps into JSON-compatible maps.
+func convert(v interface{}) interface{} {
+	switch value := v.(type) {
+	case map[interface{}]interface{}:
+		out := make(map[string]interface{}, len(value))
+		for k, item := range value {
+			out[fmt.Sprint(k)] = convert(item)
+		}
+		return out
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(value))
+		for k, item := range value {
+			out[k] = convert(item)
+		}
+		return out
+	case []interface{}:
+		out := make([]interface{}, len(value))
+		for i, item := range value {
+			out[i] = convert(item)
+		}
+		return out
+	default:
+		return v
+	}
+}
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	doc := new(Document)
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+	variants := make(map[string]*flipt.Variant)
+	for _, f := range doc.Flags {
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+		for _, v := range f.Variants {
+			attachment := ""
+			if v.Attachment != nil {
+				if raw, ok := v.Attachment.(string); ok && json.Valid([]byte(raw)) {
+					attachment = raw
+				} else {
+					encoded, err := json.Marshal(convert(v.Attachment))
+					if err != nil {
+						return fmt.Errorf("encoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+					attachment = string(encoded)
+				}
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{FlagKey: f.Key, Key: v.Key, Name: v.Name, Description: v.Description, Attachment: attachment})
+			if err != nil {
+				return fmt.Errorf("importing variant %q: %w", v.Key, err)
+			}
+			variants[f.Key+":"+v.Key] = variant
+		}
+	}
+	for _, s := range doc.Segments {
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: s.Key, Name: s.Name, Description: s.Description}); err != nil {
