--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -13,6 +13,45 @@ func TestHasher(t *testing.T) {
 	RunSpecs(t, "Hasher Suite")
 }
 
+func TestExplicitSeedCanBeRestored(t *testing.T) {
+	h := hasher.NewHasher()
+	hash := h.HashFunc()
+	const id, input = "user-1", "item-1"
+
+	h.SetSeed(id, "original")
+	original := hash(id, input)
+	if got := hash(id, input); got != original {
+		t.Fatalf("same seed and input: got %d, want %d", got, original)
+	}
+
+	h.Reseed(id)
+	if got := hash(id, input); got == original {
+		t.Fatalf("reseed did not change hash: %d", got)
+	}
+
+	h.SetSeed(id, "original")
+	if got := hash(id, input); got != original {
+		t.Fatalf("restored seed: got %d, want %d", got, original)
+	}
+
+	h.SetSeed(id, "different")
+	if got := hash(id, input); got == original {
+		t.Fatalf("different seed did not change hash: %d", got)
+	}
+}
+
+func TestGlobalSetSeed(t *testing.T) {
+	const id, input = "global-user", "item-1"
+	hasher.SetSeed(id, "original")
+	hash := hasher.HashFunc()
+	original := hash(id, input)
+	hasher.Reseed(id)
+	hasher.SetSeed(id, "original")
+	if got := hash(id, input); got != original {
+		t.Fatalf("restored global seed: got %d, want %d", got, original)
+	}
+}
