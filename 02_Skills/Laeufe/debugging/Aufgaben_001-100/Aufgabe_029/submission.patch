@@ -0,0 +1,167 @@
+#!/usr/bin/python
+# Copyright (c) 2018 Red Hat, Inc.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1',
+                    'status': ['preview'],
+                    'supported_by': 'certified'}
+
+DOCUMENTATION = '''
+---
+module: nios_fixed_address
+version_added: "2.9"
+short_description: Manage Infoblox NIOS DHCP fixed addresses
+description:
+  - Create, update, and remove IPv4 or IPv6 DHCP fixed addresses using Infoblox WAPI.
+requirements:
+  - infoblox-client
+extends_documentation_fragment: nios
+options:
+  name:
+    description: Name of the fixed address.
+    required: true
+  ipaddr:
+    description: IPv4 or IPv6 address to reserve.
+    required: true
+  mac:
+    description: Hardware MAC address associated with the fixed address.
+    required: true
+  network:
+    description: Network containing the address, in CIDR notation.
+    required: true
+  network_view:
+    description: Network view containing the address.
+    default: default
+  options:
+    description: DHCP options to set on the fixed address. Each item requires a value and a name or number.
+    suboptions:
+      name:
+        description: DHCP option name.
+      num:
+        description: DHCP option number.
+        type: int
+      value:
+        description: DHCP option value.
+        required: true
+      use_option:
+        description: Whether to use this option.
+        type: bool
+        default: true
+      vendor_class:
+        description: DHCP option space.
+        default: DHCP
+  extattrs:
+    description: Extensible attributes as key and value pairs.
+    type: dict
+  comment:
+    description: Comment on the fixed address.
+  state:
+    description: Desired state of the fixed address.
+    choices: [present, absent]
+    default: present
+'''
+
+EXAMPLES = '''
+- name: Reserve an IPv4 address
+  nios_fixed_address:
+    name: printer
+    ipaddr: 192.0.2.10
+    mac: 00:11:22:33:44:55
+    network: 192.0.2.0/24
+    options:
+      - name: router
+        value: 192.0.2.1
+    provider:
+      host: nios.example.com
+      username: admin
+      password: secret
+
+- name: Remove an IPv6 reservation
+  nios_fixed_address:
+    name: printer
+    ipaddr: 2001:db8::10
+    mac: 00:11:22:33:44:55
+    network: 2001:db8::/64
+    state: absent
+    provider:
+      host: nios.example.com
+      username: admin
+      password: secret
+'''
+
+RETURN = ''' # '''
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.six import iteritems
+from ansible.module_utils.network.common.utils import validate_ip_address, validate_ip_v6_address
+from ansible.module_utils.net_tools.nios.api import WapiModule
+from ansible.module_utils.net_tools.nios.api import NIOS_IPV4_FIXED_ADDRESS, NIOS_IPV6_FIXED_ADDRESS
+
+
+def options(module):
+    '''Convert DHCP options to the WAPI structure, omitting unset fields.'''
+    result = []
+    for item in module.params['options'] or []:
+        option = dict((key, value) for key, value in iteritems(item) if value is not None)
+        if 'name' not in option and 'num' not in option:
+            module.fail_json(msg='one of `name` or `num` is required for option value')
+        if 'value' not in option:
+            module.fail_json(msg='`value` is required for option value')
+        option.setdefault('use_option', True)
+        option.setdefault('vendor_class', 'DHCP')
+        result.append(option)
+    return result
+
+
+def validate_ip_addr_type(ip, arg_spec, module):
+    '''Map a validated address to the matching WAPI fixed address field.'''
+    if validate_ip_address(ip):
+        obj_type, address_key = NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'
+    elif validate_ip_v6_address(ip):
+        obj_type, address_key = NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr'
+    else:
+        module.fail_json(msg='ipaddr must be a valid IPv4 or IPv6 address')
+        return None, arg_spec, module
+
+    arg_spec[address_key] = arg_spec.pop('ipaddr')
+    module.params[address_key] = module.params.pop('ipaddr')
+    return obj_type, arg_spec, module
+
+
+def main():
+    option_spec = dict(
+        name=dict(),
+        num=dict(type='int'),
+        value=dict(required=True),
+        use_option=dict(type='bool', default=True),
+        vendor_class=dict(default='DHCP')
+    )
+    ib_spec = dict(
+        name=dict(required=True),
+        ipaddr=dict(required=True, ib_req=True),
+        mac=dict(required=True, ib_req=True),
+        network=dict(required=True, ib_req=True),
+        network_view=dict(default='default', ib_req=True),
+        options=dict(type='list', elements='dict', options=option_spec, transform=options),
+        extattrs=dict(type='dict'),
+        comment=dict()
+    )
+    argument_spec = dict(provider=dict(required=True),
+                         state=dict(default='present', choices=['present', 'absent']))
+    argument_spec.update(ib_spec)
+    argument_spec.update(WapiModule.provider_spec)
+    argument_spec['provider'] = dict(argument_spec['provider'], required=True)
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+
+    obj_filter = dict((key, module.params[key]) for key, value in iteritems(ib_spec)
+                      if value.get('ib_req'))
+    obj_type, ib_spec, module = validate_ip_addr_type(obj_filter['ipaddr'], ib_spec, module)
+    result = WapiModule(module).run(obj_type, ib_spec)
+    module.exit_json(**result)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/test/units/modules/net_tools/nios/test_nios_fixed_address.py b/test/units/modules/net_tools/nios/test_nios_fixed_address.py
new file mode 100644
index 0000000..9f6e304
--- /dev/null
+++ b/test/units/modules/net_tools/nios/test_nios_fixed_address.py
@@ -0,0 +1,101 @@
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat import unittest
+from units.compat.mock import patch, MagicMock
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+
+
+class TestNiosFixedAddress(unittest.TestCase):
+
+    def test_main_remaps_address_before_wapi(self):
+        for address, obj_type, key in [('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                                       ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')]:
+            module = MagicMock()
+            module.params = dict(provider={}, state='present', name='host', ipaddr=address,
+                                 mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                                 network_view='default', options=None, extattrs=None, comment=None)
+            with patch.object(nios_fixed_address, 'AnsibleModule', return_value=module), \
+                    patch.object(nios_fixed_address, 'WapiModule') as wapi_class:
+                nios_fixed_address.main()
+                self.assertTrue(nios_fixed_address.AnsibleModule.call_args[1]['argument_spec']['provider']['required'])
+                self.assertTrue(nios_fixed_address.AnsibleModule.call_args[1]['supports_check_mode'])
+                self.assertEqual(wapi_class.return_value.run.call_args[0][0], obj_type)
+                self.assertIn(key, wapi_class.return_value.run.call_args[0][1])
+                self.assertEqual(module.params[key], address)
+                self.assertNotIn('ipaddr', module.params)
+                self.assertTrue(module.exit_json.called)
+
+    def test_wapi_idempotence_update_delete_and_check_mode(self):
+        address = '192.0.2.10'
+        params = dict(provider={}, state='present', name='host', ipv4addr=address,
+                      mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                      network_view='default', options=None, extattrs=None, comment=None)
+        spec = dict(name={}, ipv4addr={'ib_req': True}, mac={'ib_req': True},
+                    network={'ib_req': True}, network_view={'ib_req': True},
+                    options={}, extattrs={}, comment={})
+        module = MagicMock()
+        module.params = params
+        module.check_mode = False
+        with patch.object(api, 'get_connector'):
+            wapi = api.WapiModule(module)
+            wapi.get_object = MagicMock(return_value=None)
+            wapi.create_object = MagicMock()
+            wapi.update_object = MagicMock()
+            wapi.delete_object = MagicMock()
+            self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+            expected_filter = dict(ipv4addr=address, mac=params['mac'],
+                                   network=params['network'], network_view='default')
+            self.assertEqual(wapi.get_object.call_args[0],
+                             (api.NIOS_IPV4_FIXED_ADDRESS, expected_filter))
+            wapi.create_object.assert_called_once()
+            existing = dict(params, _ref='fixedaddress/ref')
+            existing.pop('provider')
+            existing.pop('state')
+            existing.pop('options')
+            existing.pop('extattrs')
+            existing.pop('comment')
+            wapi.get_object.return_value = [existing]
+            self.assertFalse(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+            params['comment'] = 'updated'
+            wapi.get_object.return_value = [dict(existing, _ref='fixedaddress/ref')]
+            module.check_mode = True
+            self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+            wapi.update_object.assert_not_called()
+            params['state'] = 'absent'
+            wapi.get_object.return_value = [dict(existing, _ref='fixedaddress/ref')]
+            self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+            wapi.delete_object.assert_not_called()
+
+    def test_address_types(self):
+        for address, expected, key in [('192.0.2.10', 'fixedaddress', 'ipv4addr'),
+                                       ('2001:db8::10', 'ipv6fixedaddress', 'ipv6addr')]:
+            module = MagicMock()
+            module.params = {'ipaddr': address}
+            spec = {'ipaddr': {'ib_req': True}}
+            obj_type, spec, module = nios_fixed_address.validate_ip_addr_type(address, spec, module)
+            self.assertEqual(obj_type, expected)
+            self.assertIn(key, spec)
+            self.assertEqual(module.params[key], address)
+            self.assertNotIn('ipaddr', spec)
+
+    def test_invalid_address(self):
+        module = MagicMock()
+        nios_fixed_address.validate_ip_addr_type('bad address', {}, module)
+        module.fail_json.assert_called_once()
+
+    def test_options(self):
+        module = MagicMock()
+        module.params = {'options': [dict(name='router', num=None, value='192.0.2.1',
+                                          use_option=True, vendor_class='DHCP')]}
+        self.assertEqual(nios_fixed_address.options(module),
+                         [dict(name='router', value='192.0.2.1',
+                               use_option=True, vendor_class='DHCP')])
+        module.params['options'] = [dict(num=6, value='192.0.2.53', name=None)]
+        self.assertEqual(nios_fixed_address.options(module),
+                         [dict(num=6, value='192.0.2.53', use_option=True,
+                               vendor_class='DHCP')])
+        module.params['options'] = [dict(name=None, num=None, value='bad')]
+        nios_fixed_address.options(module)
+        module.fail_json.assert_called_once()
