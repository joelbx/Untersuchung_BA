+func TestUbuntuAPIContentUpdate(t *testing.T) {
+	previous := models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{
+		"CVE-1": {CveContents: models.NewCveContents(models.CveContent{Type: models.UbuntuAPI, LastModified: time.Unix(1, 0)})},
+	}}
+	current := models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{
+		"CVE-1": {CveContents: models.NewCveContents(models.CveContent{Type: models.UbuntuAPI, LastModified: time.Unix(2, 0)})},
+	}}
+	if !isCveInfoUpdated("CVE-1", previous, current) {
+		t.Fatal("Ubuntu API content update was ignored")
+	}
+}
