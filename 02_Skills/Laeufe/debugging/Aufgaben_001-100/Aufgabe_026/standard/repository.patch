--- /dev/null
+++ b/models/family_sources_test.go
@@ -0,0 +1,74 @@
+package models
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestFamilyContentSources(t *testing.T) {
+	for _, tc := range []struct {
+		family string
+		want   []CveContentType
+	}{
+		{"redhat", []CveContentType{RedHat, RedHatAPI}},
+		{"centos", []CveContentType{RedHat, RedHatAPI}},
+		{"alma", []CveContentType{RedHat, RedHatAPI}},
+		{"rocky", []CveContentType{RedHat, RedHatAPI}},
+		{"debian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"raspbian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"ubuntu", []CveContentType{Ubuntu, UbuntuAPI}},
+		{"unsupported", nil},
+	} {
+		if got := GetCveContentTypes(tc.family); !reflect.DeepEqual(got, tc.want) {
+			t.Errorf("%s: got %v, want %v", tc.family, got, tc.want)
+		}
+	}
+	if NewCveContentType("redhat") != RedHat || NewCveContentType("centos") != RedHat || NewCveContentType("unsupported") != Unknown {
+		t.Fatal("single-content mapping changed")
+	}
+}
+
+func TestUbuntuContentSourcesInReports(t *testing.T) {
+	contents := NewCveContents(
+		CveContent{Type: Ubuntu, SourceLink: "ubuntu", Cpes: []Cpe{{URI: "ubuntu"}}, References: References{{Link: "ubuntu"}}, CweIDs: []string{"CWE-1"}, Summary: "ubuntu summary"},
+		CveContent{Type: UbuntuAPI, SourceLink: "ubuntu-api", Cpes: []Cpe{{URI: "ubuntu-api"}}, References: References{{Link: "ubuntu-api"}}, CweIDs: []string{"CWE-2"}, Summary: "api summary", Cvss3Score: 7.5, Cvss3Severity: "HIGH"},
+		CveContent{Type: Nvd, SourceLink: "nvd", Cpes: []Cpe{{URI: "nvd"}}, References: References{{Link: "nvd"}}, CweIDs: []string{"CWE-3"}, Summary: "nvd summary"},
+	)
+	if got := contents.PrimarySrcURLs("en", "ubuntu", "CVE-1", nil); !reflect.DeepEqual(got, []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "ubuntu"}, {UbuntuAPI, "ubuntu-api"}}) {
+		t.Errorf("URLs: %v", got)
+	}
+	if got := contents.Cpes("ubuntu"); len(got) != 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI {
+		t.Errorf("CPE priority: %v", got)
+	}
+	if got := contents.References("ubuntu"); len(got) != 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI {
+		t.Errorf("reference priority: %v", got)
+	}
+	if got := contents.CweIDs("ubuntu"); len(got) != 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI {
+		t.Errorf("CWE priority: %v", got)
+	}
+	v := VulnInfo{CveContents: contents}
+	if got := v.Titles("en", "ubuntu"); len(got) != 3 || got[0].Type != Nvd || got[1].Type != Ubuntu || got[2].Type != UbuntuAPI {
+		t.Errorf("title priority: %v", got)
+	}
+	if got := v.Summaries("en", "ubuntu"); len(got) != 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI {
+		t.Errorf("summary priority: %v", got)
+	}
+	found := false
+	for _, score := range v.Cvss3Scores() {
+		if score.Type == UbuntuAPI && score.Value.Score == 7.5 {
+			found = true
+		}
+	}
+	if !found {
+		t.Error("Ubuntu API CVSS v3 score missing")
+	}
+}
+
+func TestNegligibleSeverity(t *testing.T) {
+	if got := severityToCvssScoreRange("negligible"); got != "0.1-3.9" {
+		t.Errorf("range: %s", got)
+	}
+	if got := severityToCvssScoreRoughly("NEGLIGIBLE"); got != 3.9 {
+		t.Errorf("rough score: %v", got)
+	}
+}
