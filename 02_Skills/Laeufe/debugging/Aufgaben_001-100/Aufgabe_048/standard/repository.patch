diff --git a/test/units/plugins/test_resolution_context.py b/test/units/plugins/test_resolution_context.py
new file mode 100644
index 0000000..f2fae31
--- /dev/null
+++ b/test/units/plugins/test_resolution_context.py
@@ -0,0 +1,35 @@
+from ansible.errors import AnsiblePluginRemovedError
+from ansible.plugins.loader import PluginLoader, PluginLoadContext
+
+
+def test_missing_plugin_returns_context():
+    loader = PluginLoader('FilterModule', 'ansible.plugins.filter', None, 'filter_plugins')
+    result = loader.get_with_context('definitely_missing_plugin_for_context_test')
+    assert result.object is None
+    assert result.plugin_load_context.original_name == 'definitely_missing_plugin_for_context_test'
+    assert not result.plugin_load_context.resolved
+
+
+def test_tombstone_raises_with_context(mocker):
+    loader = PluginLoader('FilterModule', 'ansible.plugins.filter', None, 'filter_plugins')
+    mocker.patch.object(loader, '_query_collection_routing_meta', return_value={
+        'tombstone': {'removal_version': '2.0'}})
+    context = PluginLoadContext()
+    try:
+        loader._find_fq_plugin('ansible.builtin.removed_filter', '.py', context)
+    except AnsiblePluginRemovedError as exc:
+        assert exc.plugin_load_context is context
+        assert context.removal_version == '2.0'
+    else:
+        assert False, 'expected a removed plugin error'
+
+
+def test_tombstone_get_with_context(mocker):
+    loader = PluginLoader('FilterModule', 'ansible.plugins.filter', None, 'filter_plugins')
+    mocker.patch.object(loader, '_query_collection_routing_meta', return_value={
+        'tombstone': {'removal_date': '2027-01-01'}})
+    result = loader.get_with_context('ansible.builtin.removed_filter')
+    assert result.object is None
+    assert result.plugin_load_context.tombstone
+    assert result.plugin_load_context.removal_date == '2027-01-01'
+    assert '2027-01-01' in result.plugin_load_context.exit_reason
