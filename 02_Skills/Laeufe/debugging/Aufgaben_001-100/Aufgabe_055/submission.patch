+package v2
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestSetScanResultMeta(t *testing.T) {
+	for _, tc := range []struct {
+		name, artifact, artifactType, family, osName, wantName, wantRelease string
+		withOS                                                              bool
+	}{
+		{"os image", "redis", "container_image", "debian", "10.10", "redis:latest", "10.10", true},
+		{"tagged image", "registry:5000/app:v1", "container_image", "debian", "12", "registry:5000/app:v1", "12", true},
+		{"missing version", "host", "filesystem", "debian", "", "host", "", true},
+		{"library only", "/data/lib", "filesystem", "", "", "/data/lib", "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := &types.Report{ArtifactName: tc.artifact, ArtifactType: ftypes.ArtifactType(tc.artifactType)}
+			if tc.withOS {
+				r.Metadata.OS = &ftypes.OS{Family: tc.family, Name: tc.osName}
+				r.Results = types.Results{{Type: tc.family}}
+			} else {
+				r.Results = types.Results{{Type: "jar"}}
+			}
+			result := &models.ScanResult{}
+			if err := setScanResultMeta(result, r); err != nil {
+				t.Fatal(err)
+			}
+			if result.ServerName != tc.wantName || result.Release != tc.wantRelease || result.Optional != nil {
+				t.Fatalf("metadata: name=%q release=%q optional=%v", result.ServerName, result.Release, result.Optional)
+			}
+		})
+	}
+}
