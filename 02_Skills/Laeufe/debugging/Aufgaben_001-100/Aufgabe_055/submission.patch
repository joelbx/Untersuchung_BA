diff --git a/detector/trivy_meta_test.go b/detector/trivy_meta_test.go
new file mode 100644
index 0000000..333d03d
--- /dev/null
+++ b/detector/trivy_meta_test.go
@@ -0,0 +1,34 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestTrivyDetectionGate(t *testing.T) {
+	trivy := &models.ScanResult{Family: "debian", Release: "12", Packages: models.Packages{"a": {Name: "a"}}, ScannedBy: "trivy"}
+	if !reuseScannedCves(trivy) {
+		t.Fatal("Trivy CVEs must be reused without Optional metadata")
+	}
+	if isPkgCvesDetactable(trivy) {
+		t.Fatal("Trivy packages must not be detected again")
+	}
+	for _, r := range []*models.ScanResult{
+		{Release: "12", Packages: trivy.Packages},
+		{Family: "debian", Packages: trivy.Packages},
+		{Family: "debian", Release: "12"},
+		{Family: "freebsd", Release: "13", Packages: trivy.Packages},
+		{Family: "raspbian", Release: "12", Packages: trivy.Packages},
+		{Family: "pseudo", Release: "12", Packages: trivy.Packages},
+	} {
+		if isPkgCvesDetactable(r) {
+			t.Fatalf("unexpected detection for %+v", r)
+		}
+	}
+	if !isPkgCvesDetactable(&models.ScanResult{Family: "debian", Release: "12", Packages: trivy.Packages}) {
+		t.Fatal("regular OS package result must be detectable")
+	}
+}
