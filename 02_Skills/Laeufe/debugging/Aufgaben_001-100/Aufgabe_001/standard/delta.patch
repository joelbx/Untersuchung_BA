diff --git a/config/syslog/syslogconf_test.go b/config/syslog/syslogconf_test.go
new file mode 100644
index 0000000..d54809c
--- /dev/null
+++ b/config/syslog/syslogconf_test.go
@@ -0,0 +1,34 @@
+//go:build !windows
+
+package syslog_test
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/config/syslog"
+)
+
+func TestConfValidate(t *testing.T) {
+	tests := []struct {
+		name string
+		conf syslog.Conf
+		want int
+	}{
+		{name: "disabled invalid values", conf: syslog.Conf{Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}, want: 0},
+		{name: "valid tcp", conf: syslog.Conf{Enabled: true, Protocol: "tcp", Port: "5140"}, want: 0},
+		{name: "valid udp", conf: syslog.Conf{Enabled: true, Protocol: "udp", Port: "12345", Severity: "emerg", Facility: "user"}, want: 0},
+		{name: "defaults", conf: syslog.Conf{Enabled: true}, want: 0},
+		{name: "invalid protocol", conf: syslog.Conf{Enabled: true, Protocol: "bad"}, want: 1},
+		{name: "invalid port", conf: syslog.Conf{Enabled: true, Port: "-1"}, want: 1},
+		{name: "invalid severity", conf: syslog.Conf{Enabled: true, Severity: "bad"}, want: 1},
+		{name: "invalid facility", conf: syslog.Conf{Enabled: true, Facility: "bad"}, want: 1},
+		{name: "all invalid fields", conf: syslog.Conf{Enabled: true, Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}, want: 4},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := len(tt.conf.Validate()); got != tt.want {
+				t.Errorf("Validate() returned %d errors, want %d", got, tt.want)
+			}
+		})
+	}
+}
diff --git a/config/syslog/syslogconf_windows.go b/config/syslog/syslogconf_windows.go
new file mode 100644
index 0000000..b369f9c
--- /dev/null
+++ b/config/syslog/syslogconf_windows.go
@@ -0,0 +1,13 @@
+//go:build windows
+
+package syslog
+
+import "golang.org/x/xerrors"
+
+// Validate rejects enabled syslog configuration on Windows.
+func (c *Conf) Validate() []error {
+	if !c.Enabled {
+		return nil
+	}
+	return []error{xerrors.New("windows not support syslog")}
+}
diff --git a/config/syslog/syslogconf_windows_test.go b/config/syslog/syslogconf_windows_test.go
new file mode 100644
index 0000000..184db72
--- /dev/null
+++ b/config/syslog/syslogconf_windows_test.go
@@ -0,0 +1,21 @@
+//go:build windows
+
+package syslog_test
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/config/syslog"
+)
+
+func TestConfValidateWindows(t *testing.T) {
+	conf := syslog.Conf{Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}
+	if got := conf.Validate(); got != nil {
+		t.Errorf("disabled syslog returned %v, want nil", got)
+	}
+	conf.Enabled = true
+	errs := conf.Validate()
+	if len(errs) != 1 || errs[0].Error() != "windows not support syslog" {
+		t.Errorf("enabled syslog returned %v, want one Windows error", errs)
+	}
+}
