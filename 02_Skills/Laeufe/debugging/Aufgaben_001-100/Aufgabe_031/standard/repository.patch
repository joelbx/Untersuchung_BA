+func TestLoadEnvironmentPrecedence(t *testing.T) {
+	t.Run("defaults without overrides", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "")
+		result, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, "INFO", result.Config.Log.Level)
+		assert.Equal(t, 8080, result.Config.Server.HTTPPort)
+	})
+
+	t.Run("defaults with overrides", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+		result, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, "debug", result.Config.Log.Level)
+		assert.Equal(t, 8181, result.Config.Server.HTTPPort)
+	})
+
+	t.Run("file with overrides", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+		result, err := Load("./testdata/advanced.yml")
+		require.NoError(t, err)
+		assert.Equal(t, "debug", result.Config.Log.Level)
+		assert.Equal(t, 8181, result.Config.Server.HTTPPort)
+	})
+}
