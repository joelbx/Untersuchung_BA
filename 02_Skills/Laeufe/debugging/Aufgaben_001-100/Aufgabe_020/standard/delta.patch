+func TestNewClientTLS(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379, RequireTLS: true})
+	require.NoError(t, err)
+	defer client.Close()
+	require.NotNil(t, client.Options().TLSConfig)
+	assert.Equal(t, uint16(0x0303), client.Options().TLSConfig.MinVersion)
+	assert.Nil(t, client.Options().TLSConfig.RootCAs)
+	assert.False(t, client.Options().TLSConfig.InsecureSkipVerify)
+}
+
+func TestNewClientTLSOptions(t *testing.T) {
+	server := httptest.NewTLSServer(nil)
+	defer server.Close()
+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw})
+	path := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(path, cert, 0600))
+
+	for _, tc := range []struct {
+		name string
+		cfg  config.RedisCacheConfig
+	}{
+		{"inline", config.RedisCacheConfig{RequireTLS: true, CaCertBytes: string(cert)}},
+		{"file", config.RedisCacheConfig{RequireTLS: true, CaCertPath: path}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, err := NewClient(tc.cfg)
+			require.NoError(t, err)
+			defer client.Close()
+			require.NotNil(t, client.Options().TLSConfig.RootCAs)
+			assert.Contains(t, client.Options().TLSConfig.RootCAs.Subjects(), server.Certificate().RawSubject)
+			conn, err := tls.Dial("tcp", strings.TrimPrefix(server.URL, "https://"), client.Options().TLSConfig)
+			require.NoError(t, err)
+			require.NoError(t, conn.Close())
+		})
+	}
+
+	client, err := NewClient(config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true})
+	require.NoError(t, err)
+	defer client.Close()
+	assert.True(t, client.Options().TLSConfig.InsecureSkipVerify)
+	conn, err := tls.Dial("tcp", strings.TrimPrefix(server.URL, "https://"), client.Options().TLSConfig)
+	require.NoError(t, err)
+	require.NoError(t, conn.Close())
+
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertPath: path, CaCertBytes: string(cert)})
+	require.EqualError(t, err, "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertPath: filepath.Join(t.TempDir(), "missing")})
+	require.ErrorContains(t, err, "reading redis CA certificate")
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertBytes: "invalid"})
+	require.EqualError(t, err, "invalid redis CA certificate PEM")
+}
diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 0000000..0af97bb
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,57 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a Redis client from the cache connection configuration.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertPath != "" && cfg.CaCertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{MinVersion: tls.VersionTLS12, InsecureSkipVerify: cfg.InsecureSkipTLS}
+		cert := []byte(cfg.CaCertBytes)
+		if cfg.CaCertPath != "" {
+			var err error
+			cert, err = os.ReadFile(cfg.CaCertPath)
+			if err != nil {
+				return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+			}
+		}
+		if len(cert) > 0 {
+			pool, err := x509.SystemCertPool()
+			if err != nil {
+				return nil, fmt.Errorf("loading system CAs: %w", err)
+			}
+			if !pool.AppendCertsFromPEM(cert) {
+				return nil, errors.New("invalid redis CA certificate PEM")
+			}
+			tlsConfig.RootCAs = pool
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
