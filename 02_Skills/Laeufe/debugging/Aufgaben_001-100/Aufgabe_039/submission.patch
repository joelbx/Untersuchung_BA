+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        cls.db = get_db()
+        cls.db.query("""
+            CREATE TABLE booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL,
+                notes text NOT NULL,
+                primary key (username, work_id, edition_id)
+            );
+        """)
+
+    def setup_method(self):
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source")
+        self.db.insert("booknotes", username="reader", work_id=2,
+                       edition_id=-1, notes="target")
+        self.db.insert("booknotes", username="other", work_id=1,
+                       edition_id=3, notes="another source")
+
+    def teardown_method(self):
+        self.db.query("DELETE FROM booknotes")
+
+    def test_collision_preserves_all_notes(self):
+        before = [dict(row) for row in self.db.select("booknotes", order="username, work_id")]
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 0,
+            "rows_deleted": 0,
+            "failed_deletes": 1,
+        }
+        assert [dict(row) for row in self.db.select(
+            "booknotes", order="username, work_id"
+        )] == before
+
+    def test_update_without_collision(self):
+        result = Booknotes.update_work_id(1, 3)
+
+        assert result == {
+            "rows_changed": 2,
+            "rows_deleted": 0,
+            "failed_deletes": 0,
+        }
+        assert not list(self.db.select("booknotes", where="work_id=1"))
+        assert len(list(self.db.select("booknotes", where="work_id=3"))) == 2
+
+    def test_dry_run_preserves_notes(self):
+        before = [dict(row) for row in self.db.select("booknotes", order="username, work_id")]
+
+        result = Booknotes.update_work_id(1, 3, _test=True)
+
+        assert result == {
+            "rows_changed": 2,
+            "rows_deleted": 0,
+            "failed_deletes": 0,
+        }
+        assert [dict(row) for row in self.db.select(
+            "booknotes", order="username, work_id"
+        )] == before
