diff --git a/packages/shared/test/mail/recipient.spec.ts b/packages/shared/test/mail/recipient.spec.ts
new file mode 100644
index 0000000..cd519a9
--- /dev/null
+++ b/packages/shared/test/mail/recipient.spec.ts
@@ -0,0 +1,28 @@
+import { inputToRecipient, splitBySeparator } from '@proton/shared/lib/mail/recipient';
+
+describe('address input parsing', () => {
+    it('splits and normalizes comma and semicolon separated addresses', () => {
+        expect(
+            splitBySeparator(',plus@debye.proton.black, visionary@debye.proton.black; pro@debye.proton.black,')
+        ).toEqual(['plus@debye.proton.black', 'visionary@debye.proton.black', 'pro@debye.proton.black']);
+        expect(splitBySeparator(' ; <first@example.com> ,, <second@example.com>; <> ; ')).toEqual([
+            'first@example.com',
+            'second@example.com',
+        ]);
+    });
+
+    it('uses the bare email for both recipient fields', () => {
+        expect(inputToRecipient('plain@example.com')).toEqual({
+            Name: 'plain@example.com',
+            Address: 'plain@example.com',
+        });
+        expect(inputToRecipient(' <bracketed@example.com> ')).toEqual({
+            Name: 'bracketed@example.com',
+            Address: 'bracketed@example.com',
+        });
+        expect(inputToRecipient('Someone <named@example.com>')).toEqual({
+            Name: 'named@example.com',
+            Address: 'named@example.com',
+        });
+    });
+});
