+	genericInstances sync.Map // map[reflect.Type]*genericEntry[T] for each type T
 )
 
+type genericEntry[T any] struct {
+	once     sync.Once
+	instance T
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// Calls with T and *T use separate instances.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	entryValue, _ := genericInstances.LoadOrStore(typeOfT, &genericEntry[T]{})
+	entry := entryValue.(*genericEntry[T])
+	entry.once.Do(func() {
+		entry.instance = constructor()
+	})
+	return entry.instance
+}
+
