+package singleton_test
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/singleton"
+)
+
+type genericValue struct{ id int }
+
+func TestGetInstanceNilInterface(t *testing.T) {
+	type service interface{ Run() }
+	var calls int
+	constructor := func() service {
+		calls++
+		return nil
+	}
+	if singleton.GetInstance(constructor) != nil || singleton.GetInstance(constructor) != nil || calls != 1 {
+		t.Fatalf("nil interface singleton constructor called %d times, want 1", calls)
+	}
+}
+
+func TestGetInstanceValueAndPointerAreIndependent(t *testing.T) {
+	var valueCalls, pointerCalls int
+	value := singleton.GetInstance(func() genericValue {
+		valueCalls++
+		return genericValue{id: 42}
+	})
+	valueAgain := singleton.GetInstance(func() genericValue {
+		valueCalls++
+		return genericValue{id: 99}
+	})
+	pointer := singleton.GetInstance(func() *genericValue {
+		pointerCalls++
+		return &genericValue{id: 7}
+	})
+	pointerAgain := singleton.GetInstance(func() *genericValue {
+		pointerCalls++
+		return &genericValue{id: 8}
+	})
+	if value != (genericValue{id: 42}) || valueAgain != value || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", value, valueAgain, valueCalls)
+	}
+	if pointer != pointerAgain || pointer.id != 7 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", pointer, pointerAgain, pointerCalls)
+	}
+}
+
+type concurrentInstance struct{ id int }
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	const callers = 20000
+	var constructorCalls atomic.Int32
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	instances := make([]*concurrentInstance, callers)
+	wg.Add(callers)
+	for i := range instances {
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			instances[i] = singleton.GetInstance(func() *concurrentInstance {
+				constructorCalls.Add(1)
+				return &concurrentInstance{id: 1}
+			})
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+	if got := constructorCalls.Load(); got != 1 {
+		t.Fatalf("constructor called %d times, want 1", got)
+	}
+	for i, instance := range instances {
+		if instance == nil || instance != instances[0] {
+			t.Fatalf("call %d returned %p, want %p", i, instance, instances[0])
+		}
+	}
+}
