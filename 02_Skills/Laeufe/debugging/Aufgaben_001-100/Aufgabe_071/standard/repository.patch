+def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
     """
     Takes a byte string like '#< CLIXML\r\n<Objs...' and extracts the stream
     message encoded in the XML data. CLIXML is used by PowerShell to encode
     multiple objects in stderr.
     """
-    lines = []
+    blocks = []
+
+    def decode_text(value: str) -> str:
+        def decode_escape(match: re.Match[str]) -> str:
+            code_unit = int(match.group()[2:6], 16)
+            # PowerShell escapes an underscore before text that resembles an escape.
+            if code_unit == 0x005F and not _clixml_escape.match(value, match.end()):
+                return match.group()
+            return chr(code_unit)
+
+        decoded = _clixml_escape.sub(decode_escape, value)
+        # Reassemble adjacent UTF-16 surrogate code units into scalar values.
+        return decoded.encode('utf-16-le', 'surrogatepass').decode('utf-16-le', 'surrogatepass')
 
     # There are some scenarios where the stderr contains a nested CLIXML element like
     # '<# CLIXML\r\n<# CLIXML\r\n<Objs>...</Objs><Objs>...</Objs>'.
     # Parse each individual <Objs> element and add the error strings to our stderr list.
     # https://github.com/ansible/ansible/issues/69550
-    while data:
+    while b'<Objs ' in data:
         end_idx = data.find(b"</Objs>") + 7
         current_element = data[data.find(b"<Objs "):end_idx]
         data = data[end_idx:]
@@ -50,10 +63,11 @@ def _parse_clixml(data, stream="Error"):
         namespace_match = re.match(r'{(.*)}', clixml.tag)
         namespace = "{%s}" % namespace_match.group(1) if namespace_match else ""
 
-        strings = clixml.findall("./%sS" % namespace)
-        lines.extend([e.text.replace('_x000D__x000A_', '') for e in strings if e.attrib.get('S') == stream])
+        strings = [e for e in clixml.findall("./%sS" % namespace) if e.attrib.get('S') == stream]
+        if strings:
+            blocks.append(''.join(decode_text(e.text or '') for e in strings))
 
-    return to_bytes('\r\n'.join(lines))
+    return to_bytes('\r\n'.join(blocks) if any(blocks) else '', errors='surrogatepass')
 
 
