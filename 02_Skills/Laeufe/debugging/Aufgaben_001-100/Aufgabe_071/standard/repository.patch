@@ -74,6 +76,32 @@ def test_parse_clixml_multiple_elements():
     assert actual == expected
 
 
+@pytest.mark.parametrize(('body', 'expected'), [
+    (b'<S S="Error">_x263A__xD83D__xDE00_</S>', '☺😀'.encode()),
+    (b'<S S="Error">_x000D__x000A__x005f_</S>', b'\r\n_x005f_'),
+    (b'<S S="Error">_x005F__x000A_ _x005F_ _x005G_</S>', b'_\n _x005F_ _x005G_'),
+    (b'<S S="Error">_xD800_</S>', '\ud800'.encode('utf-8', 'surrogatepass')),
+    (b'<S S="Error">_x263a_</S>', '☺'.encode()),
+    (b'<S S="Info">ignored</S><S S="Error"/><S S="Error">a</S><S S="Error">b</S>', b'ab'),
+    (b'<S S="Info">ignored</S><S S="Error"/>', b''),
+])
+def test_parse_clixml_decoding(body, expected):
+    data = b'#< CLIXML\r\n<Objs Version="1.1.0.1">' + body + b'</Objs>'
+    assert _parse_clixml(data) == expected
+
+
+def test_parse_clixml_block_boundaries():
+    data = (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">a</S><S S="Error">b</S></Objs>'
+            b'<Objs Version="1"><S S="Error">c</S></Objs>')
+    assert _parse_clixml(data) == b'ab\r\nc'
+
+
+def test_parse_clixml_multiple_empty_blocks():
+    data = (b'<Objs Version="1"><S S="Info">ignored</S></Objs>'
+            b'<Objs Version="1"><S S="Error"/></Objs>')
+    assert _parse_clixml(data) == b''
+
