diff --git a/tests/unit/misc/test_earlyinit.py b/tests/unit/misc/test_earlyinit.py
index e29cc0a..0065c63 100644
--- a/tests/unit/misc/test_earlyinit.py
+++ b/tests/unit/misc/test_earlyinit.py
@@ -48,3 +48,58 @@ def test_qt_version(same):
 def test_qt_version_no_args():
     """Make sure qt_version without arguments at least works."""
     earlyinit.qt_version()
+
+
+def test_check_qt_available_reports_all_failures(stubs, monkeypatch):
+    from qutebrowser.qt import machinery
+    stubs.ImportFake(dict.fromkeys(machinery.WRAPPERS, False), monkeypatch).patch()
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        earlyinit.check_qt_available(info)
+    assert excinfo.value.info is info
+    assert info.pyqt5 is not None and info.pyqt6 is not None
+    assert str(excinfo.value).startswith("No Qt wrapper was importable.\n\n\n")
+
+
+def test_check_qt_available_stops_after_success(stubs, monkeypatch):
+    from qutebrowser.qt import machinery
+    stubs.ImportFake({"PyQt5": True, "PyQt6": False}, monkeypatch).patch()
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+
+    earlyinit.check_qt_available(info)
+
+    assert info.pyqt5 == "success"
+    assert info.pyqt6 is None
+
+
+def test_check_pyqt_error_has_trailing_blank_lines(monkeypatch, capsys):
+    from qutebrowser.qt import machinery
+    monkeypatch.setattr(machinery, "INFO", machinery.SelectionInfo(wrapper="PyQt5"))
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+    monkeypatch.setattr(sys, "argv", ["qutebrowser"])
+
+    def fail_import(name):
+        raise ImportError(f"missing {name}")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", fail_import)
+    with pytest.raises(SystemExit) as excinfo:
+        earlyinit.check_pyqt()
+
+    assert excinfo.value.code == 1
+    assert capsys.readouterr().err.endswith("\n\n\n")
+
+
+def test_early_init_passes_selection_info(monkeypatch):
+    from qutebrowser.qt import machinery
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    calls = []
+    monkeypatch.setattr(machinery, "init", lambda args: info)
+    monkeypatch.setattr(earlyinit, "check_qt_available", calls.append)
+    for name in ("init_faulthandler", "check_pyqt", "init_log", "check_libraries",
+                 "check_qt_version", "configure_pyqt", "check_ssl_support",
+                 "check_optimize_flag", "webengine_early_import"):
+        monkeypatch.setattr(earlyinit, name, lambda *args: None)
+
+    earlyinit.early_init(object())
+
+    assert calls == [info]
