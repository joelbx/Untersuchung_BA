+def check_qt_available(info: 'SelectionInfo') -> None:
+    """Check whether any supported Qt wrapper can be imported."""
+    from qutebrowser.qt import machinery
+
+    wrappers = [info.wrapper] if info.wrapper in machinery.WRAPPERS else []
+    wrappers += [name for name in machinery.WRAPPERS if name not in wrappers]
+    for wrapper in wrappers:
+        if any(getattr(info, name.lower()) == "success"
+               for name in machinery.WRAPPERS):
+            break
+        if getattr(info, wrapper.lower()) is not None:
+            continue
+        try:
+            importlib.import_module(wrapper)
+        except ImportError as e:
+            info.set_module(wrapper, f"{type(e).__name__}: {e}")
+        else:
+            info.set_module(wrapper, "success")
+
+    if not any(getattr(info, name.lower()) == "success"
+               for name in machinery.WRAPPERS):
+        raise machinery.NoWrapperAvailableError(info)
+
+
 def check_pyqt():
