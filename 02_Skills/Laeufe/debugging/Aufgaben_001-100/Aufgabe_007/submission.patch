+    @pytest.mark.parametrize('use_pexpect', [False, True])
+    def test_kinit_uses_distinct_cache_per_attempt(self, monkeypatch, use_pexpect):
+        if use_pexpect:
+            pytest.importorskip('pexpect')
+            mock_runner = MagicMock()
+            mock_runner.return_value.exitstatus = 0
+            monkeypatch.setattr('pexpect.spawn', mock_runner)
+        else:
+            mock_runner = MagicMock()
+            mock_runner.return_value.returncode = 0
+            mock_runner.return_value.communicate.return_value = (b'', b'')
+            monkeypatch.setattr('subprocess.Popen', mock_runner)
+
+        winrm.HAS_PEXPECT = use_pexpect
+        conn = connection_loader.get('winrm', PlayContext(), StringIO())
+        conn.set_options(var_options={'_extras': {}, 'ansible_winrm_kinit_args': '-V'})
+        conn._build_winrm_kwargs()
+
+        conn._kerb_auth('user@domain', 'pass')
+        first_cache = conn._kerb_ccache
+        conn._kerb_auth('user@domain', 'pass')
+
+        calls = [c[1:] for c in mock_runner.mock_calls if c[0] == '']
+        assert len(calls) == 2
+        assert calls[0][0][0] == ('kinit' if use_pexpect else ['kinit', '-V', 'user@domain'])
+        assert calls[1][0][0] == ('kinit' if use_pexpect else ['kinit', '-V', 'user@domain'])
+        if use_pexpect:
+            assert calls[0][0][1] == ['-V', 'user@domain']
+            assert calls[1][0][1] == ['-V', 'user@domain']
+        assert calls[0][1]['env']['KRB5CCNAME'] == 'FILE:' + first_cache.name
+        assert calls[1][1]['env']['KRB5CCNAME'] == 'FILE:' + conn._kerb_ccache.name
+        assert first_cache.name != conn._kerb_ccache.name
