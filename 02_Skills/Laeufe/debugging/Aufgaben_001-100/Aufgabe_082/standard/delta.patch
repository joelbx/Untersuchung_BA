+// NewWriterEmitter returns an audit log that emits events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{WriterLog: NewWriterLog(w), writer: w}
+}
+
+// WriterEmitter combines the legacy writer log with typed event emission.
+type WriterEmitter struct {
+	*WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes one JSON event per line.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	line, err := json.Marshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	line = append(line, '\n')
+	n, err := w.writer.Write(line)
+	if n != len(line) && err == nil {
+		err = io.ErrShortWrite
+	}
+	return trace.ConvertSystemError(err)
+}
+
+// Close releases the writer and legacy log resources.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(trace.ConvertSystemError(w.writer.Close()), trace.ConvertSystemError(w.WriterLog.Close()))
+}
+
 // CheckingEmitterConfig provides parameters for emitter
 type CheckingEmitterConfig struct {
 	// Inner emits events to the underlying store
