 // NewMultiLog returns a new instance of a multi logger
-func NewMultiLog(loggers ...IAuditLog) *MultiLog {
-	return &MultiLog{
-		loggers: loggers,
+func NewMultiLog(loggers ...IAuditLog) (*MultiLog, error) {
+	emitters := make([]Emitter, 0, len(loggers))
+	for _, logger := range loggers {
+		emitter, ok := logger.(Emitter)
+		if !ok {
+			return nil, trace.BadParameter("expected emitter, but %T does not emit", logger)
+		}
+		emitters = append(emitters, emitter)
 	}
+	return &MultiLog{MultiEmitter: NewMultiEmitter(emitters...), loggers: loggers}, nil
 }
 
 // MultiLog is a logger that fan outs write operations
 // to all loggers, and performs all read and search operations
 // on the first logger that implements the operation
 type MultiLog struct {
+	*MultiEmitter
 	loggers []IAuditLog
 }
 
diff --git a/lib/events/multilog_regression_test.go b/lib/events/multilog_regression_test.go
new file mode 100644
index 0000000..ab26339
--- /dev/null
+++ b/lib/events/multilog_regression_test.go
@@ -0,0 +1,72 @@
+package events
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type recordingWriter struct {
+	data       []byte
+	closes     int
+	closeError error
+}
+
+func (w *recordingWriter) Write(p []byte) (int, error) {
+	w.data = append(w.data, p...)
+	return len(p), nil
+}
+
+func (w *recordingWriter) Close() error {
+	w.closes++
+	return w.closeError
+}
+
+func TestMultiLogEmitterRegression(t *testing.T) {
+	first, second := &recordingWriter{}, &recordingWriter{}
+	log, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+	var emitter Emitter = log
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent, Code: UserLocalLoginCode}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	want, err := json.Marshal(event)
+	require.NoError(t, err)
+	want = append(want, '\n')
+	require.Equal(t, want, first.data)
+	require.Equal(t, want, second.data)
+	require.NoError(t, log.Close())
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
+
+func TestMultiLogRejectsNonEmitter(t *testing.T) {
+	log, err := NewMultiLog(NewWriterLog(&recordingWriter{}))
+	require.Nil(t, log)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
+
+func TestWriterEmitterCloseErrors(t *testing.T) {
+	w := &recordingWriter{closeError: errors.New("close failed")}
+	err := NewWriterEmitter(w).Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "close failed")
+	require.Equal(t, 2, w.closes)
+}
+
+func TestMultiLogCloseErrors(t *testing.T) {
+	first := &recordingWriter{closeError: errors.New("first failed")}
+	second := &recordingWriter{closeError: errors.New("second failed")}
+	log, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+	err = log.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "first failed")
+	require.Contains(t, err.Error(), "second failed")
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
