+import { act, renderHook, waitFor } from '@testing-library/react';
+
+import { usePassBridge } from '@proton/pass/lib/bridge/PassBridgeProvider';
+import type { PassBridge } from '@proton/pass/lib/bridge/types';
+
+import { usePassAliasesSetup } from './usePassAliasesProviderSetup';
+
+jest.mock('@proton/pass/lib/bridge/PassBridgeProvider', () => ({ usePassBridge: jest.fn() }));
+jest.mock('@proton/components/hooks/useAddresses', () => {
+    const addresses: never[] = [];
+    return jest.fn(() => [addresses, false]);
+});
+jest.mock('@proton/components/hooks/useAuthentication', () => jest.fn(() => ({})));
+jest.mock('@proton/components/hooks/useUser', () => {
+    const user = {};
+    return jest.fn(() => [user, false]);
+});
+jest.mock('@proton/components/hooks/useNotifications', () => jest.fn(() => ({ createNotification: jest.fn() })));
+
+it('shows an empty state without creating a vault, then creates one when options are requested', async () => {
+    const vault = { shareId: 'new-vault', content: { name: 'Personal' } } as any;
+    const getDefault = jest.fn().mockResolvedValue(undefined);
+    const createDefaultVault = jest.fn().mockResolvedValue(vault);
+    const getAllByShareId = jest.fn().mockResolvedValue([]);
+    const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 10 } });
+    const getAliasOptions = jest.fn().mockResolvedValue({ mailboxes: [], suffixes: [] });
+    (usePassBridge as jest.Mock).mockReturnValue({
+        init: jest.fn().mockResolvedValue(true),
+        vault: { getDefault, createDefaultVault },
+        alias: { getAllByShareId, getAliasOptions },
+        user: { getUserAccess },
+    } as unknown as PassBridge);
+
+    const { result } = renderHook(() => usePassAliasesSetup());
+    await waitFor(() => expect(result.current.loading).toBe(false));
+    expect(getDefault).toHaveBeenCalledWith({ maxAge: 86400 });
+    expect(createDefaultVault).not.toHaveBeenCalled();
+    expect(getAllByShareId).not.toHaveBeenCalled();
+    expect(result.current.hasAliases).toBe(false);
+
+    await act(async () => {
+        await result.current.getAliasOptions();
+    });
+    expect(createDefaultVault).toHaveBeenCalledTimes(1);
+    expect(getAllByShareId).toHaveBeenCalledWith('new-vault', { maxAge: 300 });
+    expect(getAliasOptions).toHaveBeenCalledWith('new-vault');
+    expect(result.current.passAliasesVaultName).toBe('Personal');
+});
+
+it('loads aliases from an existing vault and applies the alias limit', async () => {
+    const vault = { shareId: 'existing-vault', content: { name: 'Existing' } } as any;
+    const alias = { item: { state: 1, revisionTime: 10, aliasEmail: 'alias@example.com' } } as any;
+    const getDefault = jest.fn().mockResolvedValue(vault);
+    const createDefaultVault = jest.fn();
+    const getAllByShareId = jest.fn().mockResolvedValue([alias]);
+    const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 1 } });
+    (usePassBridge as jest.Mock).mockReturnValue({
+        init: jest.fn().mockResolvedValue(true),
+        vault: { getDefault, createDefaultVault },
+        alias: { getAllByShareId },
+        user: { getUserAccess },
+    } as unknown as PassBridge);
+
+    const { result } = renderHook(() => usePassAliasesSetup());
+    await waitFor(() => expect(result.current.loading).toBe(false));
+
+    expect(result.current.passAliasesItems).toEqual([alias]);
+    expect(result.current.hasAliases).toBe(true);
+    expect(result.current.hasUsedProtonPassApp).toBe(true);
+    expect(result.current.hasReachedAliasesCountLimit).toBe(true);
+    expect(getAllByShareId).toHaveBeenCalledWith('existing-vault', { maxAge: 300 });
+    expect(createDefaultVault).not.toHaveBeenCalled();
+});
