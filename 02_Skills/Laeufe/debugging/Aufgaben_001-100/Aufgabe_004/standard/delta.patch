+import type { PassBridge } from '@proton/pass/lib/bridge/types';
+
+import { fetchPassAliases } from './PassAliasesProvider.helpers';
+
+it('fetches aliases and the limit with a five minute TTL', async () => {
+    const aliases = [{ item: { revisionTime: 1 } }] as any;
+    const getAllByShareId = jest.fn().mockResolvedValue(aliases);
+    const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 10 } });
+    const bridge = { alias: { getAllByShareId }, user: { getUserAccess } } as unknown as PassBridge;
+
+    const result = await fetchPassAliases(bridge, { shareId: 'vault' } as any);
+
+    expect(getAllByShareId).toHaveBeenCalledWith('vault', { maxAge: 300 });
