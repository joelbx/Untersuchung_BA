diff --git a/report/diff_status_test.go b/report/diff_status_test.go
new file mode 100644
index 0000000..cd2fa6c
--- /dev/null
+++ b/report/diff_status_test.go
@@ -0,0 +1,74 @@
+package report
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestDiffStatusesAndPackageSources(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"new":  {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+			"same": {CveID: "same", AffectedPackages: models.PackageFixStatuses{{Name: "changed-metadata"}}},
+		},
+		Packages: models.Packages{"new-pkg": {Name: "new-pkg", Version: "current"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"old":  {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"old-pkg": {Name: "old-pkg", Version: "previous"}},
+	}
+	for _, tt := range []struct {
+		name        string
+		plus, minus bool
+		want        map[string]models.DiffStatus
+	}{
+		{"both", true, true, map[string]models.DiffStatus{"new": models.DiffPlus, "old": models.DiffMinus}},
+		{"plus", true, false, map[string]models.DiffStatus{"new": models.DiffPlus}},
+		{"minus", false, true, map[string]models.DiffStatus{"old": models.DiffMinus}},
+		{"neither", false, false, map[string]models.DiffStatus{}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tt.plus, tt.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got) != 1 {
+				t.Fatalf("got %d scan results", len(got))
+			}
+			if len(got[0].ScannedCves) != len(tt.want) {
+				t.Fatalf("got CVEs %#v, want %#v", got[0].ScannedCves, tt.want)
+			}
+			for id, status := range tt.want {
+				if got[0].ScannedCves[id].DiffStatus != status {
+					t.Errorf("%s status: %q, want %q", id, got[0].ScannedCves[id].DiffStatus, status)
+				}
+			}
+			if tt.plus && got[0].Packages["new-pkg"].Version != "current" {
+				t.Errorf("new package: %#v", got[0].Packages["new-pkg"])
+			}
+			if tt.minus && got[0].Packages["old-pkg"].Version != "previous" {
+				t.Errorf("resolved package: %#v", got[0].Packages["old-pkg"])
+			}
+			if len(got[0].Packages) != len(tt.want) {
+				t.Errorf("packages: %#v", got[0].Packages)
+			}
+		})
+	}
+}
+
+func TestDiffWithoutPreviousScan(t *testing.T) {
+	current := models.ScanResult{ServerName: "new-host", ScannedCves: models.VulnInfos{"new": {CveID: "new"}}}
+	got, err := diff(models.ScanResults{current}, nil, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got[0].ScannedCves["new"].DiffStatus != models.DiffPlus {
+		t.Errorf("new host CVE was not marked as added: %#v", got[0].ScannedCves)
+	}
+}
