@@ -0,0 +1,24 @@
+package models
+
+import "testing"
+
+func TestDiffFormattingAndCounts(t *testing.T) {
+	vulns := VulnInfos{
+		"new":  {CveID: "new", DiffStatus: DiffPlus},
+		"old":  {CveID: "old", DiffStatus: DiffMinus},
+		"same": {CveID: "same"},
+	}
+	plus, minus := vulns.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Errorf("counts = %d, %d", plus, minus)
+	}
+	for id, want := range map[string]string{"new": "+new", "old": "-old", "same": "same"} {
+		v := vulns[id]
+		if got := v.CveIDDiffFormat(true); got != want {
+			t.Errorf("%s formatted = %q, want %q", id, got, want)
+		}
+		if got := v.CveIDDiffFormat(false); got != id {
+			t.Errorf("%s plain = %q", id, got)
+		}
+	}
+}
