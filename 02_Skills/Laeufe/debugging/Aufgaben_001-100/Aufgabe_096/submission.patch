+@pytest.mark.parametrize('stdin, am', [({}, {'mode': dict(type='raw')})], indirect=['stdin', 'am'])
+def test_new_file_default_mode_warns_at_exit(am, atomic_mocks, mocker, capfd):
+    mocker.patch('ansible.module_utils.common.warnings._global_warnings', [])
+    am.selinux_enabled = mocker.MagicMock(return_value=False)
+    atomic_mocks['path_exists'].return_value = False
+
+    am.atomic_move('/path/to/src', '/path/to/dest')
+
+    atomic_mocks['chmod'].assert_called_once_with(b'/path/to/dest', 0o600)
+    assert '/path/to/dest' in am._created_files
+    with pytest.raises(SystemExit):
+        am.exit_json()
+    result = json.loads(capfd.readouterr()[0])
+    assert "File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." in result['warnings']
+
+
+@pytest.mark.parametrize('stdin, am', [({}, {'mode': dict(type='raw')})], indirect=['stdin', 'am'])
+def test_explicit_mode_clears_created_file_warning(am, atomic_mocks, mocker, capfd):
+    mocker.patch('ansible.module_utils.common.warnings._global_warnings', [])
+    am.selinux_enabled = mocker.MagicMock(return_value=False)
+    atomic_mocks['path_exists'].return_value = False
+    am.atomic_move('/path/to/src', '/path/to/dest')
+    mocker.patch('os.lstat', return_value=mocker.Mock(st_mode=0o600))
+
+    am.set_mode_if_different('/path/to/dest', '0600', False)
+
+    assert '/path/to/dest' not in am._created_files
+    with pytest.raises(SystemExit):
+        am.exit_json()
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_real_new_file_uses_private_mode_without_mode_argument(am, tmp_path, mocker):
+    am.selinux_enabled = mocker.MagicMock(return_value=False)
+    src = tmp_path / 'src'
+    dest = tmp_path / 'dest'
+    src.write_text('private contents')
+    src.chmod(0o644)
+    previous_umask = os.umask(0o022)
+    try:
+        am.atomic_move(str(src), str(dest))
+    finally:
+        os.umask(previous_umask)
+
+    assert stat.S_IMODE(dest.stat().st_mode) == 0o600
+    assert not am._created_files
+
+
