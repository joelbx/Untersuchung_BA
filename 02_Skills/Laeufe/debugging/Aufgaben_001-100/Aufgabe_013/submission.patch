 import textwrap
 import traceback
 import yaml
@@ -71,6 +72,28 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    _TTY_TOKEN = re.compile(r'(?<!\w)(?:([IBMUC])\(([^)]+)\)|([LR])\(([^,()]+), *([^)]+)\)|HORIZONTALLINE\b)')
+
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            kind, value, link_kind, link_text, target = match.groups()
+            if kind in ('I', 'C'):
+                return "`%s'" % value
+            if kind == 'B':
+                return '*%s*' % value
+            if kind == 'M':
+                return '[%s]' % value
+            if kind == 'U':
+                return value
+            if link_kind == 'L':
+                return '%s <%s>' % (link_text, target)
+            if link_kind == 'R':
+                return link_text
+            return '\n-------------\n'
+
+        return cls._TTY_TOKEN.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
