@@ -0,0 +1,24 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import pytest
+
+from ansible.cli.doc import DocCLI
+
+
+@pytest.mark.parametrize('source, expected', [
+    ('L(Ansible docs,https://example.com)', 'Ansible docs <https://example.com>'),
+    ('L(Ansible docs, https://example.com)', 'Ansible docs <https://example.com>'),
+    ('R(Ansible docs,reference)', 'Ansible docs'),
+    ('R(Ansible docs, reference)', 'Ansible docs'),
+    ('HORIZONTALLINE', '\n-------------\n'),
+    ('IBM(International Business Machines)', 'IBM(International Business Machines)'),
+    ('plain IBM(International Business Machines) text', 'plain IBM(International Business Machines) text'),
+    ('Q(unknown) wordL(label,url) prefixHORIZONTALLINE',
+     'Q(unknown) wordL(label,url) prefixHORIZONTALLINE'),
+    ('I(italics) B(bold) M(module) U(url) C(constant)', "`italics' *bold* [module] url `constant'"),
+    ('Use M(name), B(text), C(value), R(title,ref) and L(site, url).',
+     "Use [name], *text*, `value', title and site <url>."),
+])
+def test_tty_ify(source, expected):
+    assert DocCLI.tty_ify(source) == expected
