+func TestLoadPoolAndUpdateSettings(t *testing.T) {
+	cfg, err := Load("./testdata/config/pool.yml")
+	require.NoError(t, err)
+
+	assert.Equal(t, 3, cfg.Database.MaxIdleConn)
+	assert.Equal(t, 17, cfg.Database.MaxOpenConn)
+	assert.Equal(t, 45*time.Minute, cfg.Database.ConnMaxLifetime)
+	assert.Equal(t, Default().Database.URL, cfg.Database.URL)
+	assert.Equal(t, Default().Database.MigrationsPath, cfg.Database.MigrationsPath)
+	assert.False(t, cfg.Meta.CheckForUpdates)
+
+	cfg, err = Load("./testdata/config/default.yml")
+	require.NoError(t, err)
+	assert.False(t, cfg.Meta.CheckForUpdates)
+}
