+// KubeAddr returns the public Kubernetes proxy URL.
+func (p ProxyConfig) KubeAddr() (string, error) {
+	if !p.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	var addr utils.NetAddr
+	switch {
+	case len(p.Kube.PublicAddrs) > 0:
+		addr = p.Kube.PublicAddrs[0]
+	case len(p.PublicAddrs) > 0:
+		addr = p.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+
+	host, port, err := net.SplitHostPort(addr.Addr)
+	if err == nil {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 {
+			return "", trace.BadParameter("invalid public address %q", addr.Addr)
+		}
+	} else {
+		host = addr.Addr
+		if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+			host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+		}
+		if strings.Contains(host, ":") && net.ParseIP(host) == nil {
+			return "", trace.BadParameter("invalid public address %q", addr.Addr)
+		}
+	}
+	if host == "" || strings.ContainsAny(host, " \t\r\n/?#@[]") {
+		return "", trace.BadParameter("invalid public address %q", addr.Addr)
+	}
+	return "https://" + net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)), nil
+}
