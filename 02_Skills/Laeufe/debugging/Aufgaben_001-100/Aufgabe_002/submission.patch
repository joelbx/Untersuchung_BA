+++ b/lib/service/kube_addr_test.go
@@ -0,0 +1,32 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/gravitational/teleport/lib/utils"
+)
+
+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name      string
+		cfg       ProxyConfig
+		want      string
+		wantError bool
+	}{
+		{"disabled", ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, "", true},
+		{"kube public address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}}}, PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, "https://kube.example.com:3026", false},
+		{"proxy public address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, "https://proxy.example.com:3026", false},
+		{"custom listen port", ProxyConfig{Kube: KubeProxyConfig{Enabled: true, ListenAddr: utils.NetAddr{Addr: "0.0.0.0:4443"}}, PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, "https://proxy.example.com:3026", false},
+		{"ipv6", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "[2001:db8::1]:3080"}}}, "https://[2001:db8::1]:3026", false},
+		{"invalid", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "bad:port"}}}, "", true},
+		{"missing", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}}, "", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.KubeAddr()
+			if (err != nil) != tt.wantError || got != tt.want {
+				t.Fatalf("KubeAddr() = %q, %v; want %q, error=%v", got, err, tt.want, tt.wantError)
+			}
+		})
+	}
+}
