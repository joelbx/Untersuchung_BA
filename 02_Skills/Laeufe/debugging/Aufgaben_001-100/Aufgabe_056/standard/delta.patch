@@ -0,0 +1,17 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('detects a small JXL file by extension', async () => {
+        expect(await mimeTypeFromFile(new File(['x'], 'photo.jxl'))).toBe('image/jxl');
+    });
+
+    it('prefers a meaningful file type', async () => {
+        expect(await mimeTypeFromFile(new File(['x'], 'photo.jxl', { type: 'image/png' }))).toBe('image/png');
+    });
+
+    it('uses the extension when the file type is generic', async () => {
+        expect(await mimeTypeFromFile(new File(['x'], 'photo.jxl', { type: 'application/octet-stream' }))).toBe(
+            'image/jxl'
+        );
+    });
+});
