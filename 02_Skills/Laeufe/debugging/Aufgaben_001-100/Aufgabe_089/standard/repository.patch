--- /dev/null
+++ b/cmd/flipt/import_test.go
@@ -0,0 +1,22 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/spf13/cobra"
+	"github.com/stretchr/testify/require"
+)
+
+func TestImportRejectsInvalidReferencesEveryTime(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "features.yaml")
+	contents := []byte("flags:\n- key: demo\n  name: Demo\n  rules:\n  - segment: missing\n    distributions:\n    - variant: absent\n      rollout: 100\nsegments: []\n")
+	require.NoError(t, os.WriteFile(file, contents, 0600))
+	importer := &importCommand{}
+	for i := 0; i < 2; i++ {
+		err := importer.run(&cobra.Command{}, []string{file})
+		require.ErrorContains(t, err, `references unknown segment "missing"`)
+		require.ErrorContains(t, err, `references unknown variant "absent"`)
+	}
+}
