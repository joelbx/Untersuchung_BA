diff --git a/internal/cue/reference_repro_test.go b/internal/cue/reference_repro_test.go
new file mode 100644
index 0000000..48000ec
--- /dev/null
+++ b/internal/cue/reference_repro_test.go
@@ -0,0 +1,29 @@
+package cue
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestReferenceReproduction(t *testing.T) {
+	v, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	b := []byte("namespace: default\nflags:\n- key: demo\n  name: Demo\n  variants:\n  - key: known\n    name: Known\n  rules:\n  - segment: missing\n    distributions:\n    - variant: absent\n      rollout: 100\nsegments: []\n")
+	err = v.Validate("config.yaml", b)
+	issues, ok := Unwrap(err)
+	require.True(t, ok)
+	require.Len(t, issues, 2)
+	require.EqualError(t, issues[0], `flag default/demo rule 1 references unknown segment "missing" (config.yaml 9:14)`)
+	require.EqualError(t, issues[1], `flag default/demo rule 1 references unknown variant "absent" (config.yaml 11:16)`)
+}
+
+func TestBooleanRuleUnknownSegment(t *testing.T) {
+	v, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	b := []byte("version: \"1.2\"\nflags:\n- key: boolean\n  name: Boolean\n  type: BOOLEAN_FLAG_TYPE\n  rules:\n  - segment: absent\n    distributions: []\nsegments: []\n")
+	err = v.Validate("boolean.yaml", b)
+	issues, ok := Unwrap(err)
+	require.True(t, ok)
+	require.Len(t, issues, 1)
+	require.EqualError(t, issues[0], `flag default/boolean rule 1 references unknown segment "absent" (boolean.yaml 7:14)`)
+}
