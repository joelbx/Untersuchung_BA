new file mode 100644
index 0000000..e32090e
--- /dev/null
+++ b/internal/storage/fs/validation_test.go
@@ -0,0 +1,28 @@
+package fs
+
+import (
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/cue"
+	"go.uber.org/zap"
+	"testing"
+	"testing/fstest"
+)
+
+func TestSnapshotValidation(t *testing.T) {
+	files := fstest.MapFS{"features.yml": &fstest.MapFile{Data: []byte("namespace: default\nflags:\n- key: demo\n  name: Demo\n  variants:\n  - key: known\n    name: Known\n  rules:\n  - segment: missing\n    distributions:\n    - variant: absent\n      rollout: 100\nsegments: []\n")}}
+	for _, build := range []struct {
+		name string
+		run  func() (*StoreSnapshot, error)
+	}{
+		{"paths", func() (*StoreSnapshot, error) { return SnapshotFromPaths(files, "features.yml") }},
+		{"fs", func() (*StoreSnapshot, error) { return SnapshotFromFS(zap.NewNop(), files) }},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			snapshot, err := build.run()
+			require.Nil(t, snapshot)
+			issues, ok := cue.Unwrap(err)
+			require.True(t, ok)
+			require.Len(t, issues, 2)
+		})
+	}
+}
