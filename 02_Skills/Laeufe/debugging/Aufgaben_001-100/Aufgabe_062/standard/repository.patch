+func TestContextReader_CanceledPasswordRestoresTerminal(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr, started: make(chan struct{})}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+	defer cr.Close()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	go func() {
+		<-term.started
+		cancel()
+	}()
+	got, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Empty(t, got)
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClean, cr.state)
+
+	go func() { _, _ = pw.Write([]byte("next")) }()
+	got, err = cr.ReadContext(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, "next", string(got))
+}
+
+func TestContextReader_PasswordDeadlineRestoresTerminal(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+	defer cr.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	got, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, got)
+	require.True(t, term.restoreCalled)
+}
+
+func TestContextReader_CloseRestoresPasswordTerminal(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr, started: make(chan struct{})}
