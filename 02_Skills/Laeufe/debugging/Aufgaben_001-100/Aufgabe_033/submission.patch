diff --git a/lib/auth/u2f_challenge_test.go b/lib/auth/u2f_challenge_test.go
new file mode 100644
index 0000000..8ad9826
--- /dev/null
+++ b/lib/auth/u2f_challenge_test.go
@@ -0,0 +1,30 @@
+package auth
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/u2f"
+	"github.com/stretchr/testify/require"
+)
+
+func TestU2FAuthenticateChallengeCompatibility(t *testing.T) {
+	first := u2f.AuthenticateChallenge{Version: "U2F_V2", Challenge: "first", KeyHandle: "key-one", AppID: "https://example.com"}
+	second := u2f.AuthenticateChallenge{Version: "U2F_V2", Challenge: "second", KeyHandle: "key-two", AppID: "https://example.com"}
+
+	multi := U2FAuthenticateChallenge{AuthenticateChallenge: &first, Challenges: []u2f.AuthenticateChallenge{first, second}}
+	raw, err := json.Marshal(multi)
+	require.NoError(t, err)
+	var legacy u2f.AuthenticateChallenge
+	require.NoError(t, json.Unmarshal(raw, &legacy))
+	require.Equal(t, first, legacy)
+	var decoded U2FAuthenticateChallenge
+	require.NoError(t, json.Unmarshal(raw, &decoded))
+	require.Equal(t, []u2f.AuthenticateChallenge{first, second}, decoded.GetChallenges())
+
+	legacyRaw, err := json.Marshal(first)
+	require.NoError(t, err)
+	var fromOldServer U2FAuthenticateChallenge
+	require.NoError(t, json.Unmarshal(legacyRaw, &fromOldServer))
+	require.Equal(t, []u2f.AuthenticateChallenge{first}, fromOldServer.GetChallenges())
+}
