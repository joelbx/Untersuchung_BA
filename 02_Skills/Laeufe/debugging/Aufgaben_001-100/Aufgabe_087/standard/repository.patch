+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,122 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+func TestDisabled(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "absent")
+	cfg := config.Default()
+	cfg.Meta.TelemetryEnabled = false
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter = %v, %v", r, err)
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatalf("state directory created: %v", err)
+	}
+}
+
+func TestStateAndReport(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := r.state.UUID
+	if original == "" {
+		t.Fatal("missing UUID")
+	}
+	restored, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if restored.state.UUID != original {
+		t.Fatal("UUID changed on restart")
+	}
+	oldVersion := info.Version
+	info.Version = "test-version"
+	defer func() { info.Version = oldVersion }()
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		calls++
+		var event struct {
+			AnonymousID string                 `json:"anonymousId"`
+			Event       string                 `json:"event"`
+			Properties  map[string]interface{} `json:"properties"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&event); err != nil {
+			t.Error(err)
+		}
+		if event.AnonymousID != original || event.Event != "flipt.ping" || event.Properties["uuid"] != original || event.Properties["version"] != schemaVersion {
+			t.Errorf("unexpected event: %+v", event)
+		}
+		if event.Properties["flipt.version"] != "test-version" {
+			t.Errorf("unexpected version: %+v", event.Properties)
+		}
+		if calls == 1 {
+			w.WriteHeader(http.StatusServiceUnavailable)
+		}
+	}))
+	defer server.Close()
+	restored.endpoint = server.URL
+	if err := restored.Report(context.Background()); err == nil {
+		t.Fatal("expected send error")
+	}
+	if restored.state.LastTimestamp != "" {
+		t.Fatal("failed send updated timestamp")
+	}
+	if err := restored.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	timestamp, err := time.Parse(time.RFC3339, restored.state.LastTimestamp)
+	if err != nil || time.Since(timestamp) > time.Minute {
+		t.Fatalf("bad timestamp %q: %v", restored.state.LastTimestamp, err)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "telemetry.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved state
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.UUID != original || saved.Version != schemaVersion || saved.LastTimestamp != restored.state.LastTimestamp {
+		t.Fatalf("unexpected saved state: %+v", saved)
+	}
+}
+
+func TestMalformedStateAndInvalidDirectory(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "telemetry.json")
+	if err := os.WriteFile(path, []byte(`{"uuid":"bad","version":"0"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID == "bad" || r.state.UUID == "" {
+		t.Fatalf("invalid new UUID: %q", r.state.UUID)
+	}
+	cfg.Meta.StateDirectory = path
+	if _, err := NewReporter(cfg, logrus.New()); err == nil {
+		t.Fatal("expected file-as-directory error")
+	}
+}
