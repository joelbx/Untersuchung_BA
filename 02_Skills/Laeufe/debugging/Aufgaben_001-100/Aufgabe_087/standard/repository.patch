--- /dev/null
+++ b/internal/info/flipt_test.go
@@ -0,0 +1,23 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestFliptServeHTTP(t *testing.T) {
+	w := httptest.NewRecorder()
+	(Flipt{Version: "1.2.3"}).ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+	if w.Code != http.StatusOK {
+		t.Fatalf("status = %d", w.Code)
+	}
+	var result Flipt
+	if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Version != "1.2.3" {
+		t.Fatalf("version = %q", result.Version)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..c978fb5
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,198 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	endpoint      = "https://telemetry.flipt.io/v1/track"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter sends anonymous usage pings and stores only their last successful time.
+type Reporter struct {
+	logger   logrus.FieldLogger
+	path     string
+	state    state
+	client   *http.Client
+	endpoint string
+	mu       sync.Mutex
+}
+
+// NewReporter initializes local telemetry state when telemetry is enabled.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil {
+		return nil, errors.New("telemetry: nil config")
+	}
+	if !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	directory := cfg.Meta.StateDirectory
+	if directory == "" {
+		var err error
+		directory, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("telemetry state directory: %w", err)
+		}
+		directory = filepath.Join(directory, "flipt")
+	}
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+	r := &Reporter{logger: logger, path: filepath.Join(directory, "telemetry.json"), client: &http.Client{Timeout: 10 * time.Second}, endpoint: endpoint}
+	data, err := os.ReadFile(r.path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.Warnf("reading telemetry state: %v", err)
+		}
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry ID: %w", err)
+		}
+		r.state.UUID = id.String()
+		r.state.LastTimestamp = ""
+	}
+	r.state.Version = schemaVersion
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.Marshal(r.state)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(r.path), ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	defer os.Remove(tmp.Name())
+	if err := tmp.Chmod(0600); err != nil {
+		tmp.Close()
+		return fmt.Errorf("setting telemetry state permissions: %w", err)
+	}
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(tmp.Name(), r.path); err != nil {
+		return fmt.Errorf("saving telemetry state: %w", err)
+	}
+	return nil
+}
+
+// Start reports when due, then waits until the next report is due.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		r.mu.Lock()
+		last, err := time.Parse(time.RFC3339, r.state.LastTimestamp)
+		r.mu.Unlock()
+		wait := time.Duration(0)
+		if err == nil {
+			wait = time.Until(last.Add(interval))
+		}
+		if wait > 0 {
+			timer := time.NewTimer(wait)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+		if err := r.Report(ctx); err != nil {
+			r.logger.Warnf("reporting telemetry: %v", err)
+			// Retry on the next interval, without a busy loop on persistent failures.
+			timer := time.NewTimer(interval)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+	}
+}
+
+// Report sends one flipt.ping event and records a successful delivery.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	payload := struct {
+		AnonymousID string                 `json:"anonymousId"`
+		Event       string                 `json:"event"`
+		Properties  map[string]interface{} `json:"properties"`
+	}{
+		AnonymousID: r.state.UUID,
+		Event:       "flipt.ping",
+		Properties: map[string]interface{}{
+			"uuid":          r.state.UUID,
+			"version":       schemaVersion,
+			"flipt.version": info.Version,
+		},
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode)
+	}
+	previous := r.state.LastTimestamp
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.save(); err != nil {
+		r.state.LastTimestamp = previous
+		return err
+	}
+	return nil
+}
