-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        token = language.casefold()
+        key = f'/languages/{token}'
+        if web.ctx.site.get(key) is None:
+            code = get_marc21_language(token)
+            if code is None:
+                try:
+                    code = get_abbrev_from_full_lang_name(token)
+                except (LanguageNoMatchError, LanguageMultipleMatchError) as exc:
+                    raise InvalidLanguage(token) from exc
+            key = f'/languages/{code}'
+            if web.ctx.site.get(key) is None:
+                raise InvalidLanguage(token)
+
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
