diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..991b1d5
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,40 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+
+exports.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	if (typeof resource !== 'string' || !resource.startsWith('acct:')) {
+		return res.status(400).json({ error: 'Invalid resource' });
+	}
+
+	const account = resource.slice('acct:'.length);
+	const separator = account.indexOf('@');
+	if (separator <= 0 || account.indexOf('@', separator + 1) !== -1 || account.slice(separator + 1) !== hostname) {
+		return res.status(400).json({ error: 'Invalid resource' });
+	}
+
+	const canView = await privileges.global.can('view:users', req.uid || 0);
+	if (!canView) {
+		return res.status(403).json({ error: 'Forbidden' });
+	}
+
+	const uid = await user.getUidByUserslug(account.slice(0, separator));
+	if (!uid) {
+		return res.status(404).json({ error: 'User not found' });
+	}
+
+	const userslug = await user.getUserField(uid, 'userslug');
+	const baseUrl = nconf.get('url').replace(/\/$/, '');
+	const profileUrl = `${baseUrl}/user/${encodeURIComponent(userslug)}`;
+	res.type('application/jrd+json');
+	return res.json({
+		subject: resource,
+		aliases: [`${baseUrl}/uid/${uid}`, profileUrl],
+		links: [{ rel: 'http://webfinger.net/rel/profile-page', type: 'text/html', href: profileUrl }],
+	});
+};
