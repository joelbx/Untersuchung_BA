diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..be9e9a9
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,98 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+function load(relativePath, dependencies) {
+	const filename = path.join(__dirname, '..', relativePath);
+	const module = { exports: {} };
+	vm.runInNewContext(fs.readFileSync(filename, 'utf8'), {
+		module,
+		exports: module.exports,
+		require: name => dependencies[name],
+	}, { filename });
+	return module.exports;
+}
+
+describe('WebFinger', () => {
+	const hostname = 'forum.example';
+	const baseUrl = `https://${hostname}`;
+	const resource = `acct:alice@${hostname}`;
+	let permission;
+	let requestedPrivilege;
+	let requestedUid;
+	let handler;
+
+	before(() => {
+		const user = {
+			getUidByUserslug: async slug => (slug === 'alice' ? 42 : 0),
+			getUserField: async (uid, field) => (uid === 42 && field === 'userslug' ? 'alice' : null),
+		};
+		const privileges = {
+			global: {
+				can: async (privilege, uid) => {
+					requestedPrivilege = privilege;
+					requestedUid = uid;
+					return permission;
+				},
+			},
+		};
+		handler = load('src/controllers/well-known.js', {
+			nconf: { get: key => ({ url_parsed: { hostname }, url: baseUrl })[key] },
+			'../user': user,
+			'../privileges': privileges,
+		}).webfinger;
+	});
+
+	async function call(query, uid) {
+		const result = { statusCode: 200 };
+		const res = {
+			status(code) { result.statusCode = code; return this; },
+			json(body) { result.body = body; return this; },
+			send(body) { result.body = body; return this; },
+			type() { return this; },
+		};
+		await handler({ query, uid }, res);
+		return result;
+	}
+
+	beforeEach(() => { permission = true; requestedPrivilege = null; requestedUid = null; });
+
+	it('registers GET /.well-known/webfinger', () => {
+		const calls = [];
+		const routes = load('src/routes/well-known.js', { './helpers': { tryRoute: controller => controller } });
+		routes({ get: (...args) => calls.push(args) }, {}, { 'well-known': { webfinger: handler } });
+		assert(calls.some(args => args[0] === '/.well-known/webfinger' && args.includes(handler)));
+		assert(fs.readFileSync(path.join(__dirname, '../src/routes/index.js'), 'utf8').includes("require('./well-known')"));
+	});
+
+	it('returns user identity metadata for a valid resource', async () => {
+		const result = await call({ resource }, undefined);
+		assert.strictEqual(result.statusCode, 200);
+		assert.strictEqual(result.body.subject, resource);
+		assert.deepStrictEqual(Array.from(result.body.aliases), [`${baseUrl}/uid/42`, `${baseUrl}/user/alice`]);
+		assert(result.body.links.some(link => link.href === `${baseUrl}/user/alice`));
+		assert.strictEqual(requestedPrivilege, 'view:users');
+		assert.strictEqual(requestedUid, 0);
+	});
+
+	it('rejects missing, malformed, and foreign resources', async () => {
+		const queries = [{}, { resource: 'alice@forum.example' }, { resource: 'acct:alice@elsewhere.example' }, { resource: 'acct:alice@forum.example.evil' }, { resource: 'acct:@forum.example' }, { resource: ['acct:alice@forum.example'] }];
+		const results = await Promise.all(queries.map(query => call(query, 0)));
+		results.forEach(result => assert.strictEqual(result.statusCode, 400));
+	});
+
+	it('returns 404 for an unknown slug', async () => {
+		assert.strictEqual((await call({ resource: `acct:missing@${hostname}` }, 0)).statusCode, 404);
+	});
+
+	it('gates anonymous and authenticated requests on view:users', async () => {
+		permission = false;
+		assert.strictEqual((await call({ resource }, undefined)).statusCode, 403);
+		assert.strictEqual(requestedUid, 0);
+		assert.strictEqual((await call({ resource }, 7)).statusCode, 403);
+		assert.strictEqual(requestedUid, 7);
+	});
+});
