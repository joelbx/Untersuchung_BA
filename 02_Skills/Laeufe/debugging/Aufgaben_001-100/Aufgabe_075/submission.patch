@@ -0,0 +1,42 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("rejects operations without a contextual user", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("key", "value")).To(HaveOccurred())
+		_, err := repo.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(repo.Delete("key")).To(HaveOccurred())
+	})
+
+	It("scopes reads, writes, updates, and deletes to the contextual user", func() {
+		o := orm.NewOrm()
+		_, err := o.Raw("insert into user (id, user_name, created_at, updated_at) values (?, ?, datetime('now'), datetime('now'))", "user-props-1", "user-props-1").Exec()
+		Expect(err).ToNot(HaveOccurred())
+		_, err = o.Raw("insert into user (id, user_name, created_at, updated_at) values (?, ?, datetime('now'), datetime('now'))", "user-props-2", "user-props-2").Exec()
+		Expect(err).ToNot(HaveOccurred())
+		first := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-props-1"}), o)
+		second := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-props-2"}), o)
+		Expect(first.Put("shared", "first")).To(Succeed())
+		_, err = second.Get("shared")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Put("shared", "second")).To(Succeed())
+		Expect(first.Put("shared", "updated")).To(Succeed())
+		Expect(first.Get("shared")).To(Equal("updated"))
+		Expect(second.Get("shared")).To(Equal("second"))
+		Expect(first.Delete("shared")).To(Succeed())
+		_, err = first.Get("shared")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Get("shared")).To(Equal("second"))
+	})
+})
