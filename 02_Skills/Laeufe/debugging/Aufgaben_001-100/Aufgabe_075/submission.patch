+++ b/db/migration/20210619231717_create_user_props_table_test.go
@@ -0,0 +1,48 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMigratesSessionKeys(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`create table user (id text primary key); create table property (id text primary key, value text);
+ insert into user values ('u1'), ('u2');
+ insert into property values ('LastFMSessionKey_u1', 'key1'), ('LastFMSessionKey_u2', 'key2'), ('global', 'keep');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	for uid, expected := range map[string]string{"u1": "key1", "u2": "key2"} {
+		var got string
+		if err := db.QueryRow("select value from user_props where user_id=? and key='LastFMSessionKey'", uid).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != expected {
+			t.Fatalf("%s: got %q, want %q", uid, got, expected)
+		}
+	}
+	var count int
+	if err := db.QueryRow("select count(*) from property").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 {
+		t.Fatalf("global properties: got %d, want 1", count)
+	}
+}
