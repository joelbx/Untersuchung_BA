diff --git a/scan/ownerpkgs_test.go b/scan/ownerpkgs_test.go
new file mode 100644
index 0000000..aa75dcd
--- /dev/null
+++ b/scan/ownerpkgs_test.go
@@ -0,0 +1,53 @@
+package scan
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParseOwnerPkgs(t *testing.T) {
+	o := &redhatBase{}
+	tests := []struct {
+		name    string
+		output  string
+		want    []string
+		wantErr bool
+	}{
+		{"mixed versions and architectures", "libgcc 0 4.8.5 39.el7 x86_64\nlibgcc 0 4.8.5 39.el7 i686\nlibgcc 0 4.8.5 40.el7 x86_64\n", []string{"libgcc"}, false},
+		{"ignorable RPM diagnostics", "error: file /a: Permission denied\nfile /b is not owned by any package\nerror: /c: No such file or directory\nlibgcc 0 4.8.5 39.el7 x86_64\n", []string{"libgcc"}, false},
+		{"malformed line", "libgcc 0 4.8.5 39.el7 x86_64\nunexpected output\n", nil, true},
+		{"malformed five field line", "error: cannot stat /file unknown failure\n", nil, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := o.parseOwnerPkgs(tt.output)
+			if (err != nil) != tt.wantErr || !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("parseOwnerPkgs() = %v, %v; want %v, error %v", got, err, tt.want, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestAssociatePkgProcs(t *testing.T) {
+	o := newRHEL(config.ServerInfo{})
+	o.Packages = models.NewPackages(models.Package{Name: "libgcc", Version: "4.8.5", Release: "40.el7"})
+	paths := []string{"/usr/bin/example", "/lib/libgcc.so"}
+	lookup := func(got []string) ([]string, error) {
+		if !reflect.DeepEqual(got, paths) {
+			t.Errorf("owner paths = %v, want %v", got, paths)
+		}
+		return []string{"libgcc", "libgcc", "missing"}, nil
+	}
+	err := o.associatePkgProcs(map[string]string{"42": "example"}, map[string][]string{"42": paths}, nil, lookup)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := o.Packages["libgcc"].AffectedProcs
+	want := []models.AffectedProcess{{PID: "42", Name: "example"}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("affected processes = %v, want %v", got, want)
+	}
+}
diff --git a/scan/pkgps.go b/scan/pkgps.go
new file mode 100644
index 0000000..7e0bdc6
--- /dev/null
+++ b/scan/pkgps.go
@@ -0,0 +1,85 @@
+package scan
+
+import (
+	"github.com/future-architect/vuls/models"
+	"golang.org/x/xerrors"
+)
+
+// pkgPs associates each process with the installed packages that own its
+// executable or mapped files. ownerPkgs returns package names, which are the
+// keys used by Packages.
+func (o *base) pkgPs(ownerPkgs func([]string) ([]string, error)) error {
+	stdout, err := o.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+	pidNames := o.parsePs(stdout)
+	pidLoadedFiles := map[string][]string{}
+	for pid := range pidNames {
+		stdout, err := o.lsProcExe(pid)
+		if err != nil {
+			o.log.Debugf("Failed to exec /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		path, err := o.parseLsProcExe(stdout)
+		if err != nil {
+			o.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], path)
+
+		stdout, err = o.grepProcMap(pid)
+		if err != nil {
+			o.log.Debugf("Failed to exec /proc/%s/maps: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], o.parseGrepProcMap(stdout)...)
+	}
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = o.lsOfListen()
+	if err != nil {
+		o.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range o.parseLsOf(stdout) {
+		for _, pid := range pids {
+			portStat, err := models.NewPortStat(ipPort)
+			if err != nil {
+				o.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+				continue
+			}
+			pidListenPorts[pid] = append(pidListenPorts[pid], *portStat)
+		}
+	}
+	return o.associatePkgProcs(pidNames, pidLoadedFiles, pidListenPorts, ownerPkgs)
+}
+
+func (o *base) associatePkgProcs(pidNames map[string]string, pidLoadedFiles map[string][]string, pidListenPorts map[string][]models.PortStat, ownerPkgs func([]string) ([]string, error)) error {
+	for pid, files := range pidLoadedFiles {
+		pkgNames, err := ownerPkgs(files)
+		if err != nil {
+			o.log.Debugf("Failed to get package names for files %v: %s", files, err)
+			continue
+		}
+		proc := models.AffectedProcess{
+			PID:             pid,
+			Name:            pidNames[pid],
+			ListenPortStats: pidListenPorts[pid],
+		}
+		seen := map[string]bool{}
+		for _, name := range pkgNames {
+			if seen[name] {
+				continue
+			}
+			seen[name] = true
+			pack, ok := o.Packages[name]
+			if !ok {
+				o.log.Debugf("Owner package %s is not in installed packages", name)
+				continue
+			}
+			pack.AffectedProcs = append(pack.AffectedProcs, proc)
+			o.Packages[name] = pack
+		}
+	}
+	return nil
+}
