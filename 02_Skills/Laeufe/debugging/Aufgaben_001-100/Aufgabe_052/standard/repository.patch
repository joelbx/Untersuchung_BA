diff --git a/lib/ai/model/tokencount.go b/lib/ai/model/tokencount.go
new file mode 100644
index 0000000..0d99920
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,129 @@
+package model
+
+import (
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// TokenCounter reports the number of tokens used by one prompt or completion.
+type TokenCounter interface{ TokenCount() int }
+
+// TokenCounters is a collection of counters for one side of an invocation.
+type TokenCounters []TokenCounter
+
+// CountAll sums all counters in the collection.
+func (c TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range c {
+		if counter != nil {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount records prompt and completion usage across agent steps.
+type TokenCount struct {
+	Prompt     TokenCounters
+	Completion TokenCounters
+}
+
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+func (c *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt != nil {
+		c.Prompt = append(c.Prompt, prompt)
+	}
+}
+func (c *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion != nil {
+		c.Completion = append(c.Completion, completion)
+	}
+}
+func (c *TokenCount) CountAll() (int, int) { return c.Prompt.CountAll(), c.Completion.CountAll() }
+
+// StaticTokenCounter holds a completed count.
+type StaticTokenCounter struct{ count int }
+
+func (c *StaticTokenCounter) TokenCount() int { return c.count }
+
+func countTokens(s string) (int, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(s)
+	if err != nil {
+		return 0, trace.Wrap(err)
+	}
+	return len(tokens), nil
+}
+
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	count := 0
+	for _, message := range messages {
+		n, err := countTokens(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + n
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	n, err := countTokens(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + n}, nil
+}
+
+// AsynchronousTokenCounter tracks a completion while its stream is received.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+	text     string
+}
+
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	n, err := countTokens(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: n, text: start}, nil
+}
+
+func (c *AsynchronousTokenCounter) Add() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count++
+	return nil
+}
+
+// appendFragment retokenizes the full completion so token boundaries spanning
+// separate stream chunks are accounted for correctly.
+func (c *AsynchronousTokenCounter) appendFragment(fragment string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	text := c.text + fragment
+	n, err := countTokens(text)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	c.text = text
+	c.count = n
+	return nil
+}
+
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
