diff --git a/lib/config/kube_shorthand_test.go b/lib/config/kube_shorthand_test.go
new file mode 100644
index 0000000..237074b
--- /dev/null
+++ b/lib/config/kube_shorthand_test.go
@@ -0,0 +1,66 @@
+package config
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/service"
+	log "github.com/sirupsen/logrus"
+)
+
+func TestKubeListenAddrShorthand(t *testing.T) {
+	for _, tt := range []struct {
+		name, yaml, addr string
+		wantErr          bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"default port", "proxy_service:\n  kube_listen_addr: example.com\n", "example.com:3026", false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:3026\n", "0.0.0.0:8080", false},
+		{"enabled legacy conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:3026\n", "", true},
+		{"legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:8080\n", "127.0.0.1:8080", false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			fc, err := ReadConfig(strings.NewReader(tt.yaml))
+			if tt.wantErr {
+				if err == nil || !strings.Contains(err.Error(), "kube_listen_addr") || !strings.Contains(err.Error(), "kubernetes") {
+					t.Fatalf("want conflict naming both settings, got %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("read config: %v", err)
+			}
+			cfg := service.MakeDefaultConfig()
+			err = ApplyFileConfig(fc, cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !cfg.Proxy.Kube.Enabled {
+				t.Fatal("Kubernetes proxy disabled")
+			}
+			if got := cfg.Proxy.Kube.ListenAddr.Addr; got != tt.addr {
+				t.Fatalf("listen address = %q, want %q", got, tt.addr)
+			}
+		})
+	}
+}
+
+func TestKubeListenAddrWarning(t *testing.T) {
+	var output bytes.Buffer
+	logger := log.StandardLogger()
+	previous := logger.Out
+	logger.Out = &output
+	defer func() { logger.Out = previous }()
+
+	fc, err := ReadConfig(strings.NewReader("proxy_service:\n  enabled: yes\nkubernetes_service:\n  enabled: yes\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyFileConfig(fc, service.MakeDefaultConfig()); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(output.String(), "proxy_service.kube_listen_addr") {
+		t.Fatalf("missing Kubernetes proxy listen address warning: %s", output.String())
+	}
+}
