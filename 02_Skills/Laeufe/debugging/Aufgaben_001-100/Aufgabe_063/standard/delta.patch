@@ -0,0 +1,41 @@
+package client
+
+import "testing"
+
+func TestKubeProxyHostPortUnspecified(t *testing.T) {
+	for _, tt := range []struct {
+		kube, host string
+		port       int
+	}{
+		{"0.0.0.0:8080", "proxy.example.com", 8080},
+		{"[::]:8081", "proxy.example.com", 8081},
+		{"kube.example.com:8082", "kube.example.com", 8082},
+	} {
+		c := &Config{WebProxyAddr: "proxy.example.com:3080", KubeProxyAddr: tt.kube}
+		host, port := c.KubeProxyHostPort()
+		if host != tt.host || port != tt.port {
+			t.Errorf("%q: got %s:%d, want %s:%d", tt.kube, host, port, tt.host, tt.port)
+		}
+	}
+}
+
+func TestKubeProxyPublicAddressPriority(t *testing.T) {
+	tc := &TeleportClient{Config: Config{WebProxyAddr: "proxy.example.com:3080"}}
+	err := tc.applyProxySettings(ProxySettings{Kube: KubeProxySettings{
+		Enabled: true, PublicAddr: "public.example.com:8443", ListenAddr: "0.0.0.0:8080",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	host, port := tc.KubeProxyHostPort()
+	if host != "public.example.com" || port != 8443 {
+		t.Fatalf("got %s:%d, want public.example.com:8443", host, port)
+	}
+}
+
+func TestKubeClusterAddrIPv6WebHost(t *testing.T) {
+	c := &Config{WebProxyAddr: "[2001:db8::1]:3080", KubeProxyAddr: "[::]:8080"}
+	if got := c.KubeClusterAddr(); got != "https://[2001:db8::1]:8080" {
+		t.Fatalf("got %q", got)
+	}
+}
