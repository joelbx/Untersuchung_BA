diff --git a/lib/utils/parse/parse_test.go b/lib/utils/parse/parse_test.go
index dd458ed..d5bb045 100644
--- a/lib/utils/parse/parse_test.go
+++ b/lib/utils/parse/parse_test.go
@@ -24,6 +24,71 @@ import (
 	"github.com/stretchr/testify/assert"
 )
 
+func TestMatchers(t *testing.T) {
+	tests := []struct {
+		pattern string
+		input   string
+		want    bool
+	}{
+		{"foo", "foo", true},
+		{"foo", "foobar", false},
+		{"foo*bar", "foo-middle-bar", true},
+		{"foo*bar", "xfoo-middle-bar", false},
+		{"*", "anything", true},
+		{"a.b", "a-b", false},
+		{"^foo$", "foo", true},
+		{"^foo$", "foobar", false},
+		{`{{regexp.match("bar")}}`, "bar", true},
+		{`{{regexp.match("bar")}}`, "foobar", true},
+		{`{{regexp.not_match("bar")}}`, "foo", true},
+		{`{{regexp.not_match("bar")}}`, "bar", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz", true},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz-extra", false},
+		{`{{"foo"}}`, "foo", true},
+		{`foo-{{regexp.not_match("bar")}}-baz`, "foo-qux-baz", true},
+		{`foo-{{regexp.not_match("bar")}}-baz`, "foo-bar-baz", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern+"/"+tt.input, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if assert.NoError(t, err) {
+				assert.Equal(t, tt.want, matcher.Match(tt.input))
+			}
+		})
+	}
+}
+
+func TestMatcherErrors(t *testing.T) {
+	tests := []struct {
+		input string
+		want  string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("x")}}`, `unsupported function namespace other, supported namespaces are email and regexp`},
+		{`{{regexp.bad("x")}}`, `unsupported function regexp.bad, supported functions are: regexp.match, regexp.not_match.`},
+		{`{{email.bad("x")}}`, `unsupported function email.bad, supported functions are: email.local`},
+		{`{{regexp.match("[")}}`, "failed parsing regexp \"[\": error parsing regexp: missing closing ]: `[`"},
+		{`{{regexp.match()}}`, `regexp.match requires exactly one string literal argument`},
+		{`{{regexp.match("a", "b")}}`, `regexp.match requires exactly one string literal argument`},
+		{`{{regexp.match(internal.foo)}}`, `regexp.match requires exactly one string literal argument`},
+		{`{{regexp.match(42)}}`, `regexp.match requires exactly one string literal argument`},
+		{`{{internal.foo}}`, `"internal.foo" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{internal.foo + internal.bar}}`, `"internal.foo + internal.bar" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{email.local("foo")}}`, `"email.local(\"foo\")" is not a valid matcher expression - no variables and transformations are allowed.`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			_, err := Match(tt.input)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err), "%v", err)
+				assert.Equal(t, tt.want, err.Error())
+			}
+		})
+	}
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+}
