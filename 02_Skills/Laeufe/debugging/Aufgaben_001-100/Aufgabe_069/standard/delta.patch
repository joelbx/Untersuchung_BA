--- a/lib/utils/parse/parse.go
+++ b/lib/utils/parse/parse.go
@@ -26,9 +26,133 @@ import (
 	"strings"
 	"unicode"
 
+	"github.com/gravitational/teleport/lib/utils"
 	"github.com/gravitational/trace"
 )
 
+// Matcher tests whether a string satisfies a pattern.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct {
+	re *regexp.Regexp
+}
+
+func (m regexpMatcher) Match(in string) bool { return m.re.MatchString(in) }
+
+type prefixSuffixMatcher struct {
+	prefix  string
+	suffix  string
+	matcher Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct{ matcher Matcher }
+
+func (m notMatcher) Match(in string) bool { return !m.matcher.Match(in) }
+
+// Match parses a literal, glob, regexp, or matcher expression.
+func Match(value string) (Matcher, error) {
+	match := reVariable.FindStringSubmatch(value)
+	if len(match) == 0 {
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+		}
+		return patternMatcher(value)
+	}
+
+	expression := strings.TrimSpace(match[2])
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed.", expression)
+	}
+	inner, err := expressionMatcher(expr, expression)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return prefixSuffixMatcher{prefix: match[1], suffix: match[3], matcher: inner}, nil
+}
+
+func patternMatcher(pattern string) (Matcher, error) {
+	if !strings.HasPrefix(pattern, "^") || !strings.HasSuffix(pattern, "$") {
+		pattern = "^" + utils.GlobToRegexp(pattern) + "$"
+	}
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return regexpMatcher{re: re}, nil
+}
+
+func expressionMatcher(expr ast.Expr, expression string) (Matcher, error) {
+	invalid := func() (Matcher, error) {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed.", expression)
+	}
+	switch n := expr.(type) {
+	case *ast.BasicLit:
+		if n.Kind != token.STRING {
+			return invalid()
+		}
+		value, err := strconv.Unquote(n.Value)
+		if err != nil {
+			return nil, trace.BadParameter("invalid string literal: %v", err)
+		}
+		return patternMatcher(value)
+	case *ast.CallExpr:
+		call, ok := n.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return invalid()
+		}
+		namespace, ok := call.X.(*ast.Ident)
+		if !ok {
+			return invalid()
+		}
+		if namespace.Name != "regexp" && namespace.Name != EmailNamespace {
+			return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+		}
+		name := namespace.Name + "." + call.Sel.Name
+		if namespace.Name == EmailNamespace {
+			if call.Sel.Name != EmailLocalFnName {
+				return nil, trace.BadParameter("unsupported function %s, supported functions are: email.local", name)
+			}
+		} else if call.Sel.Name != "match" && call.Sel.Name != "not_match" {
+			return nil, trace.BadParameter("unsupported function %s, supported functions are: regexp.match, regexp.not_match.", name)
+		}
+		if len(n.Args) != 1 {
+			return nil, trace.BadParameter("%s requires exactly one string literal argument", name)
+		}
+		arg, ok := n.Args[0].(*ast.BasicLit)
+		if !ok || arg.Kind != token.STRING {
+			return nil, trace.BadParameter("%s requires exactly one string literal argument", name)
+		}
+		value, err := strconv.Unquote(arg.Value)
+		if err != nil {
+			return nil, trace.BadParameter("%s requires exactly one string literal argument", name)
+		}
+		if namespace.Name == EmailNamespace {
+			return invalid()
+		}
+		re, err := regexp.Compile(value)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+		}
+		matcher := Matcher(regexpMatcher{re: re})
+		if call.Sel.Name == "not_match" {
+			matcher = notMatcher{matcher: matcher}
+		}
+		return matcher, nil
+	default:
+		return invalid()
+	}
+}
