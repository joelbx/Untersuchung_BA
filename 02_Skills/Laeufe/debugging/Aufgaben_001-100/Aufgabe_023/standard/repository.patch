diff --git a/internal/cmd/authn_test.go b/internal/cmd/authn_test.go
new file mode 100644
index 0000000..67a7479
--- /dev/null
+++ b/internal/cmd/authn_test.go
@@ -0,0 +1,55 @@
+package cmd
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap/zaptest"
+)
+
+func TestAuthenticationGRPCJWTWithoutDatabase(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyPath := filepath.Join(t.TempDir(), "public.pem")
+	publicKey, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(keyPath, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: publicKey}), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, storageType := range []config.StorageType{config.LocalStorageType, config.GitStorageType, config.OCIStorageType} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Storage.Type = storageType
+			cfg.Database.URL = "invalid-database-url"
+			cfg.Authentication.Required = true
+			cfg.Authentication.Methods.JWT.Enabled = true
+			cfg.Authentication.Methods.JWT.Method.PublicKeyFile = keyPath
+
+			register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zaptest.NewLogger(t), cfg, false, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(register) != 2 {
+				t.Errorf("got %d registerers, want 2", len(register))
+			}
+			if len(interceptors) == 0 {
+				t.Error("JWT authentication middleware was not installed")
+			}
+			if err := shutdown(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
