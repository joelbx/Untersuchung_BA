diff --git a/internal/config/authentication_database_test.go b/internal/config/authentication_database_test.go
new file mode 100644
index 0000000..5118f92
--- /dev/null
+++ b/internal/config/authentication_database_test.go
@@ -0,0 +1,47 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	schedule := &AuthenticationCleanupSchedule{Interval: time.Hour, GracePeriod: time.Minute}
+	cfg := AuthenticationConfig{}
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("disabled authentication should not require a database or cleanup")
+	}
+	for _, method := range cfg.Methods.AllMethods() {
+		if method.RequiresDatabase != (method.Name() != "jwt") {
+			t.Errorf("%s: unexpected database requirement", method.Name())
+		}
+		t.Run(method.Name(), func(t *testing.T) {
+			methodCfg := AuthenticationConfig{}
+			for _, candidate := range methodCfg.Methods.AllMethods() {
+				if candidate.Method == method.Method {
+					candidate.Enable(t)
+					candidate.SetCleanup(t, *schedule)
+				}
+			}
+			if got := methodCfg.RequiresDatabase(); got != method.RequiresDatabase {
+				t.Errorf("RequiresDatabase() = %t, want %t", got, method.RequiresDatabase)
+			}
+			if got := methodCfg.ShouldRunCleanup(); got != method.RequiresDatabase {
+				t.Errorf("ShouldRunCleanup() = %t, want %t", got, method.RequiresDatabase)
+			}
+		})
+	}
+	cfg.Methods.JWT.Enabled = true
+	cfg.Methods.JWT.Cleanup = schedule
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("JWT alone should not require a database or cleanup")
+	}
+	cfg.Methods.Token.Cleanup = schedule
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("disabled token method should not require a database or cleanup")
+	}
+	cfg.Methods.Token.Enabled = true
+	if !cfg.RequiresDatabase() || !cfg.ShouldRunCleanup() {
+		t.Fatal("enabled token method with cleanup should require database and cleanup")
+	}
+}
