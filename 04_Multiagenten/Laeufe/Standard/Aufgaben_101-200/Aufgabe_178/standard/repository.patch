diff --git a/test/units/utils/test_encrypt.py b/test/units/utils/test_encrypt.py
index abf2683..46f8be7 100644
--- a/test/units/utils/test_encrypt.py
+++ b/test/units/utils/test_encrypt.py
@@ -210,3 +210,39 @@ def test_passlib_bcrypt_salt(recwarn):
 
     result = p.hash(secret, salt=repaired_salt)
     assert result == expected
+
+
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_passlib(ident):
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib not available')
+    result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+    assert encrypt.do_encrypt('foo', 'bcrypt', salt='123456789012345678901u', ident=ident).startswith('$%s$' % ident)
+
+
+def test_bcrypt_default_ident_passlib():
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib not available')
+    assert get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4).startswith('$2b$04$')
+
+
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+def test_bcrypt_ident_crypt(ident):
+    if not encrypt.HAS_CRYPT:
+        pytest.skip('crypt not available')
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$123456789012345678901u' % ident)
+
+
+def test_ident_ignored_for_other_algorithms():
+    expected = get_encrypted_password('123', 'sha256', salt='12345678')
+    assert get_encrypted_password('123', 'sha256', salt='12345678', ident='2y') == expected
+
+
+def test_crypt_bcrypt_legacy_ident(mocker):
+    crypt_hash = encrypt.CryptHash('bcrypt')
+    crypt_call = mocker.patch('ansible.utils.encrypt.crypt.crypt', return_value='$2$04$hash')
+    assert crypt_hash.hash('foo', salt='123456789012345678901u', rounds=4, ident='2') == '$2$04$hash'
+    crypt_call.assert_called_once_with('foo', '$2$04$123456789012345678901u')
