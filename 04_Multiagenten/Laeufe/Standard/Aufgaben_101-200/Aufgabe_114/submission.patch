+// ArtistFolder returns the common parent of the album directories.
+func (als Albums) ArtistFolder() string {
+	var folders []string
+	for _, al := range als {
+		dirs := al.Dirs()
+		if len(dirs) == 0 {
+			continue
+		}
+		base := commonDirectory(dirs)
+		if base == "" {
+			return ""
+		}
+		folders = append(folders, filepath.Dir(base))
+	}
+	return commonDirectory(folders)
+}
+
+func commonDirectory(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	common := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		dir = filepath.Clean(dir)
+		for common != dir && !strings.HasPrefix(dir, common+string(filepath.Separator)) {
+			parent := filepath.Dir(common)
+			if parent == common {
+				return ""
+			}
+			common = parent
+		}
+	}
+	return common
+}
