+@pytest.mark.posix
+@pytest.mark.parametrize('verbose', [False, True])
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, caplog, verbose):
+    proc.verbose = verbose
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc(
+                "import os, signal; os.kill(os.getpid(), signal.SIGTERM)"))
+
+    assert proc.outcome.code == signal.SIGTERM
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.was_sigterm()
+    assert not proc.outcome.was_successful()
+    assert str(proc.outcome) == 'Testprocess terminated with SIGTERM.'
+    assert proc.outcome.state_str() == 'terminated'
+    finished_messages = [msg for msg in message_mock.messages
+                         if not msg.text.startswith('Executing:')]
+    if verbose:
+        assert len(finished_messages) == 1
+        assert finished_messages[0].level == usertypes.MessageLevel.info
+        assert finished_messages[0].text == (
+            f'Testprocess terminated with SIGTERM. See :process {proc.pid} '
+            'for details.')
+    else:
+        assert not finished_messages
 
 
