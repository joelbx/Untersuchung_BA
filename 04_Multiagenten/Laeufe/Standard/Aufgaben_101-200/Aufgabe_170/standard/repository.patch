+def add_db_name(rec: dict) -> None:
+    """Add a comparable name, including available dates, to each author."""
+    for author in rec.get('authors') or []:
+        date = author.get('date')
+        if not date and ('birth_date' in author or 'death_date' in author):
+            date = f"{author.get('birth_date') or ''}-{author.get('death_date') or ''}"
+        author['db_name'] = f"{author['name']} {date}" if date else author['name']
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare an imported or existing edition."""
+    title = rec.get('title')
+    if title is not None:
+        full_title = title
+        if rec.get('subtitle'):
+            full_title += ' ' + rec['subtitle']
+    else:
+        full_title = rec.get('full_title', '')
+
+    expanded = build_titles(full_title)
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        if isinstance(values, str):
+            values = [values]
+        for value in values:
+            if value not in expanded['isbn']:
+                expanded['isbn'].append(value)
+
+    if rec.get('publish_country') not in (None, '   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+    ):
+        if field in rec:
+            expanded[field] = rec[field]
+    for field in ('authors', 'contribs'):
+        if field in rec:
+            expanded[field] = [author.copy() for author in rec[field] or []]
+            add_db_name({'authors': expanded[field]})
+    return expanded
+
