+import React from "react";
+import { act } from "react-dom/test-utils";
+// eslint-disable-next-line deprecate/import
+import { mount } from "enzyme";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+import {
+    DEFAULT_PHASE,
+    RegistrationTokenAuthEntry,
+} from "../../../src/components/views/auth/InteractiveAuthEntryComponents";
+import AccessibleButton from "../../../src/components/views/elements/AccessibleButton";
+import Spinner from "../../../src/components/views/elements/Spinner";
+import { flushPromises, getMockClientWithEventEmitter, unmockClientPeg } from "../../test-utils";
+
+describe("registration token authentication", () => {
+    const matrixClient = getMockClientWithEventEmitter({
+        generateClientSecret: jest.fn().mockReturnValue("secret"),
+    });
+
+    afterAll(() => unmockClientPeg());
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits the advertised type and completes %s",
+        async (type) => {
+            const response = { user_id: "@new:example.org" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+            const wrapper = mount(
+                <InteractiveAuth
+                    matrixClient={matrixClient}
+                    authData={{ session: "session", flows: [{ stages: [type] }] }}
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+            );
+
+            expect(wrapper.find(RegistrationTokenAuthEntry).exists()).toBe(true);
+            expect(onStagePhaseChange).toHaveBeenCalledWith(type, DEFAULT_PHASE);
+            expect(wrapper.find('input[name="registrationTokenField"]').prop("autoFocus")).toBe(true);
+            expect(wrapper.text()).toContain("Enter a registration token provided by the homeserver administrator.");
+            expect(wrapper.find(AccessibleButton).prop("disabled")).toBe(true);
+
+            act(() => {
+                wrapper
+                    .find('input[name="registrationTokenField"]')
+                    .simulate("change", { target: { value: "token-123" } });
+            });
+            wrapper.update();
+            expect(wrapper.find(AccessibleButton).prop("disabled")).toBe(false);
+
+            act(() => {
+                wrapper.find("form").simulate("submit");
+            });
+            await flushPromises();
+
+            expect(makeRequest).toHaveBeenCalledTimes(1);
+            expect(makeRequest).toHaveBeenCalledWith({ session: "session", type, token: "token-123" });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "secret",
+                emailSid: undefined,
+            });
+            wrapper.unmount();
+        },
+    );
+
+    it("uses the same submission for the button and guards busy and empty forms", () => {
+        const submitAuthDict = jest.fn();
+        const onPhaseChange = jest.fn();
+        const props = {
+            matrixClient,
+            authSessionId: "session",
+            loginType: AuthType.UnstableRegistrationToken,
+            submitAuthDict,
+            onPhaseChange,
+        };
+        const wrapper = mount(<RegistrationTokenAuthEntry {...props} />);
+        expect(onPhaseChange).toHaveBeenCalledWith(DEFAULT_PHASE);
+        expect(wrapper.find('input[name="registrationTokenField"]').exists()).toBe(true);
+        expect(wrapper.text()).toContain("Registration token");
+
+        wrapper.find("form").simulate("submit");
+        expect(submitAuthDict).not.toHaveBeenCalled();
+
+        wrapper.find('input[name="registrationTokenField"]').simulate("change", { target: { value: "abc" } });
+        wrapper.find(AccessibleButton).simulate("click");
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: props.loginType, token: "abc" });
+
+        wrapper.setProps({ busy: true, errorText: "Invalid token" });
+        expect(wrapper.find(Spinner).exists()).toBe(true);
+        expect(wrapper.find(AccessibleButton).exists()).toBe(false);
+        expect(wrapper.find('[role="alert"].error').text()).toBe("Invalid token");
+        wrapper.find("form").simulate("submit");
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+        wrapper.unmount();
+    });
+});
