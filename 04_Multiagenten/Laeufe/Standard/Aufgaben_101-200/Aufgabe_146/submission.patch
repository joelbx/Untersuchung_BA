+class TestFactsLinuxHardwareGetSysinfoFacts(unittest.TestCase):
+
+    def setUp(self):
+        self.hardware = linux.LinuxHardware(module=Mock(), load_on_init=False)
+
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False)
+    def test_absent_sysinfo(self, mock_exists):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {})
+        mock_exists.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM',
+        'Type: 3906',
+        'Sequence Code: 00001234',
+        'Model: 742',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_sysinfo_fields(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '1234',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+        mock_lines.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=['Type: 8561'])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_missing_fields(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'NA',
+            'product_name': '8561',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_best_parsable_locale', return_value='C')
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM', 'Type: 3906', 'Sequence Code: 00001234',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_sysinfo_overrides_dmi_facts_in_populate(self, mock_exists, mock_lines, mock_locale):
+        empty_methods = {name: Mock(return_value={}) for name in (
+            'get_cpu_facts', 'get_memory_facts', 'get_device_facts',
+            'get_uptime_facts', 'get_lvm_facts', 'get_mount_facts',
+        )}
+        with patch.multiple(self.hardware, **empty_methods), patch.object(
+            self.hardware, 'get_dmi_facts', return_value={'system_vendor': 'NA', 'product_name': 'NA'}
+        ):
+            facts = self.hardware.populate()
+
+        self.assertEqual(facts['system_vendor'], 'IBM')
+        self.assertEqual(facts['product_name'], '3906')
+        self.assertEqual(facts['product_serial'], '1234')
+
+
