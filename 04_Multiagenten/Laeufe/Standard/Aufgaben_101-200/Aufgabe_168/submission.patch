+type AdminActionLock = {
+    pending: boolean;
+    run(action: () => Promise<void>, failureMessage: string): Promise<void>;
+};
+
+const AdminActionLockContext = React.createContext<AdminActionLock | undefined>(undefined);
+
+function useLocalAdminActionLock(): AdminActionLock {
+    const pendingRef = useRef(false);
+    const [pending, setPending] = useState(false);
+    const run = useCallback(async (action: () => Promise<void>, failureMessage: string): Promise<void> => {
+        // The ref closes the gap before React renders the disabled buttons.
+        if (pendingRef.current) return;
+        pendingRef.current = true;
+        setPending(true);
+        try {
+            await action();
+        } catch (err) {
+            logger.error(failureMessage, err);
+            Modal.createDialog(ErrorDialog, { title: _t("Error"), description: failureMessage });
+        } finally {
+            pendingRef.current = false;
+            setPending(false);
+        }
+    }, []);
+    return { pending, run };
+}
+
+function useAdminActionLock(): AdminActionLock {
+    const shared = useContext(AdminActionLockContext);
+    const local = useLocalAdminActionLock();
+    return shared ?? local;
+}
+
+const AdminActionLockProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
+    const lock = useLocalAdminActionLock();
+    return <AdminActionLockContext.Provider value={lock}>{children}</AdminActionLockContext.Provider>;
+};
