diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..8ae1afb
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,171 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupTimeFormat = "20060102T150405.000000000"
+
+// copySQLite uses SQLite's online backup API so committed data in WAL files is included.
+// The destination connection must remain open until the backup is finished.
+func copySQLite(ctx context.Context, dst, src *sql.DB) error {
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	dstConn, err := dst.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dstConn.Close()
+	return dstConn.Raw(func(dstDriver any) error {
+		return srcConn.Raw(func(srcDriver any) error {
+			backup, err := dstDriver.(*sqlite3.SQLiteConn).Backup("main", srcDriver.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, stepErr := backup.Step(128)
+				if stepErr != nil {
+					_ = backup.Finish()
+					return stepErr
+				}
+				if done {
+					return backup.Finish()
+				}
+				// SQLite reports busy and locked pages without an error. Retry while
+				// allowing other connections to make progress.
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", errors.New("backup.path is empty")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		return "", err
+	}
+	path := filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format(backupTimeFormat)+".db")
+	// A new file avoids overwriting a backup if a clock repeats a timestamp.
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	if err := f.Close(); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	uri := url.URL{Scheme: "file", Path: absPath}
+	destination, err := sql.Open(Driver, uri.String())
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	err = copySQLite(ctx, destination, d.writeDB)
+	closeErr := destination.Close()
+	if err != nil || closeErr != nil {
+		_ = os.Remove(path)
+		return "", errors.Join(err, closeErr)
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	if absBackup, err := filepath.Abs(path); err == nil {
+		if absDB, err := filepath.Abs(strings.SplitN(Path, "?", 2)[0]); err == nil && absBackup == absDB {
+			return errors.New("backup file is the active database")
+		}
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	uri := url.URL{Scheme: "file", Path: absPath, RawQuery: "mode=ro"}
+	source, err := sql.Open(Driver, uri.String())
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var result string
+	if err := source.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("invalid backup database: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("invalid backup database: integrity check returned %s", result)
+	}
+	return copySQLite(ctx, d.writeDB, source)
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count cannot be negative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var files []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") {
+			continue
+		}
+		stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), ".db")
+		if _, err := time.Parse(backupTimeFormat, stamp); err == nil {
+			files = append(files, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	removed := 0
+	for _, name := range files[min(conf.Server.Backup.Count, len(files)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
new file mode 100644
index 0000000..c544307
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,85 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	previous := conf.Server.Backup
+	t.Cleanup(func() { conf.Server.Backup = previous })
+	dir := t.TempDir()
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 1
+	database, err := sql.Open(Driver, filepath.Join(dir, "live.db")+"?_journal_mode=WAL")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = database.Close() })
+	_, err = database.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('before')")
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := &db{writeDB: database}
+	first, err := d.Backup(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(first); err != nil {
+		t.Fatal(err)
+	}
+	_, err = database.Exec("UPDATE items SET value = 'after'")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(context.Background(), first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := database.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "before" {
+		t.Fatalf("restored value = %q, error = %v", value, err)
+	}
+	second, err := d.Backup(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second == first {
+		t.Fatal("backup filenames collided")
+	}
+	removed, err := d.Prune(context.Background())
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned %d files, error = %v", removed, err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("older backup still exists: %v", err)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatal(err)
+	}
+	conf.Server.Backup.Count = 0
+	removed, err = prune(context.Background())
+	if err != nil || removed != 1 {
+		t.Fatalf("zero retention pruned %d files, error = %v", removed, err)
+	}
+}
+
+func TestRestoreRejectsInvalidBackup(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "invalid.db")
+	if err := os.WriteFile(file, []byte("not sqlite"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	database, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+	if err := (&db{writeDB: database}).Restore(context.Background(), file); err == nil {
+		t.Fatal("expected invalid backup to be rejected")
+	}
+}
