+
+func TestConfirmBackupAction(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  bool
+	}{
+		{"yes\n", true},
+		{"yes", true},
+		{"no\n", false},
+		{"", false},
+	} {
+		cmd := &cobra.Command{}
+		cmd.SetIn(bytes.NewBufferString(tc.input))
+		cmd.SetErr(&bytes.Buffer{})
+		if got := confirmBackupAction(cmd, "Confirm?"); got != tc.want {
+			t.Errorf("input %q: got %v, want %v", tc.input, got, tc.want)
+		}
+	}
+}
