+    def _valid_time_stamp(self, timestamp):
+        """Return a valid ZIP timestamp as a time tuple, or the ZIP epoch."""
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.fullmatch(r'(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})', timestamp, flags=re.ASCII)
+        if not match:
+            return epoch
+
+        year, month, day, hour, minute, second = (int(part) for part in match.groups())
+        if not 1980 <= year <= 2107 or hour > 23 or minute > 59 or second > 59:
+            return epoch
+        try:
+            datetime.date(year, month, day)
+        except ValueError:
+            return epoch
+        return (year, month, day, hour, minute, second, 0, 0, -1)
+
