+    def get_locally_reachable_ips(self, ip_path):
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, flag in (('ipv4', '-4'), ('ipv6', '-6')):
+            if family == 'ipv6' and not socket.has_ipv6:
+                continue
+            rc, output, err = self.module.run_command(
+                [ip_path, flag, 'route', 'show', 'table', 'local', 'scope', 'host'],
+                errors='surrogate_then_replace')
+            if rc != 0:
+                self.module.warn('Unable to gather locally reachable %s routes' % family)
+                continue
+
+            destinations = set()
+            invalid = False
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    invalid = True
+                    continue
+                if network.version != (4 if family == 'ipv4' else 6):
+                    invalid = True
+                    continue
+                destinations.add(network)
+            if invalid:
+                self.module.warn('Ignored invalid locally reachable %s route' % family)
+            ordered = sorted(destinations, key=lambda net: (int(net.network_address), net.prefixlen))
+            reachable[family] = [str(net.network_address) if net.prefixlen == net.max_prefixlen else str(net)
+                                 for net in ordered]
+        return reachable
