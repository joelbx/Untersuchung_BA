diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..3db0d58
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,27 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chats to chat allow lists',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const keys = uids.map(uid => `user:${uid}:settings`);
+			const settings = await db.getObjects(keys);
+			const eligible = uids.map((uid, i) => ({ uid, settings: settings[i] }))
+				.filter(({ settings }) => settings && parseInt(settings.restrictChat, 10) === 1 &&
+					!Object.prototype.hasOwnProperty.call(settings, 'chatAllowList'));
+			const followLists = await Promise.all(eligible.map(({ uid }) =>
+				db.getSortedSetRange(`following:${uid}`, 0, -1)));
+			await db.setObjectBulk(eligible.map(({ uid }, i) => [
+				`user:${uid}:settings`, { chatAllowList: JSON.stringify(followLists[i].map(String)) },
+			]));
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
