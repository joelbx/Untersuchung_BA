+// TestProxyRetriesOfflineDatabaseTunnel verifies that an offline instance of a
+// same-name service does not prevent connections through a healthy instance.
+func TestProxyRetriesOfflineDatabaseTunnel(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	go testCtx.startHandlingConnections()
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+	offline := testCtx.postgres["postgres"].server.Copy().(*types.DatabaseServerV3)
+	offline.Spec.HostID = "offline-host"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, offline)
+	require.NoError(t, err)
+
+	site := testCtx.proxyServer.cfg.Tunnel.(*reversetunnel.FakeServer).Sites[0].(*reversetunnel.FakeRemoteSite)
+	site.OfflineTunnels = map[string]bool{
+		fmt.Sprintf("%s.%s", offline.GetHostID(), testCtx.clusterName): true,
+	}
+	var sawBothCandidates int32
+	testCtx.proxyServer.cfg.Shuffle = func(servers []types.DatabaseServer) []types.DatabaseServer {
+		if len(servers) == 2 {
+			atomic.StoreInt32(&sawBothCandidates, 1)
+		}
+		ordered := append([]types.DatabaseServer(nil), servers...)
+		for i, server := range ordered {
+			if server.GetHostID() == offline.GetHostID() {
+				ordered[0], ordered[i] = ordered[i], ordered[0]
+				break
+			}
+		}
+		return ordered
+	}
+
+	conn, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.NoError(t, err)
+	require.Equal(t, int32(1), atomic.LoadInt32(&sawBothCandidates))
+	require.NoError(t, conn.Close(ctx))
+}
+
+func TestProxyReportsUnreachableDatabaseService(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	go testCtx.startHandlingConnections()
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+	site := testCtx.proxyServer.cfg.Tunnel.(*reversetunnel.FakeServer).Sites[0].(*reversetunnel.FakeRemoteSite)
+	site.OfflineTunnels = map[string]bool{
+		fmt.Sprintf("%s.%s", testCtx.hostID, testCtx.clusterName): true,
+	}
+	_, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "no database service for \"postgres\" could be reached")
+}
