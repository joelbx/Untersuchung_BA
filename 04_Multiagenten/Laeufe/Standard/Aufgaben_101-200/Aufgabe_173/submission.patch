+
+package types
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDatabaseServerOrderingAndDeduplication(t *testing.T) {
+	servers := []DatabaseServer{
+		NewDatabaseServerV3("z", nil, DatabaseServerSpecV3{HostID: "host-2"}),
+		NewDatabaseServerV3("a", nil, DatabaseServerSpecV3{HostID: "host-2"}),
+		NewDatabaseServerV3("a", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+	}
+	deduplicated := DeduplicateDatabaseServers(servers)
+	if len(deduplicated) != 2 || deduplicated[0] != servers[0] || deduplicated[1] != servers[1] {
+		t.Fatalf("unexpected deduplication result: %v", deduplicated)
+	}
+	if len(servers) != 3 {
+		t.Fatal("deduplication changed the input slice")
+	}
+	sort.Sort(SortedDatabaseServers(servers))
+	if servers[0].GetHostID() != "host-1" || servers[1].GetHostID() != "host-2" || servers[2].GetName() != "z" {
+		t.Fatalf("unexpected order: %v", servers)
+	}
+	if got := servers[0].String(); !strings.Contains(got, "HostID=host-1") {
+		t.Fatalf("server string omits host ID: %s", got)
+	}
+}
