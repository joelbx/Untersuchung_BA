diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..622509e 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,64 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_rule(self):
+        """An ipset match is added once and used for checking and adding a rule."""
+        for match in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT', 'protocol': 'tcp', 'match': match,
+                'match_set': 'admin_hosts', 'match_set_flags': 'src',
+                'destination_port': '22', 'jump': 'ACCEPT',
+                'comment': 'SSH from admins',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.side_effect = [(1, '', ''), (0, '', '')]
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            expected_rule = [
+                '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', 'src',
+                '-j', 'ACCEPT', '--destination-port', '22',
+                '-m', 'comment', '--comment', 'SSH from admins',
+            ]
+            self.assertEqual(run_command.call_count, 2)
+            self.assertEqual(run_command.call_args_list[0][0][0],
+                             ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'] + expected_rule)
+            self.assertEqual(run_command.call_args_list[1][0][0],
+                             ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'] + expected_rule)
+
+    def test_match_set_flags_and_inversion(self):
+        """All supported directions and inverted set names form valid clauses."""
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            set_module_args({
+                'chain': 'INPUT', 'match_set': '!admin_hosts',
+                'match_set_flags': flags, 'jump': 'DROP',
+                '_ansible_check_mode': True,
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (1, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_args[0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-m', 'set', '!', '--match-set', 'admin_hosts', flags,
+                '-j', 'DROP',
+            ])
+
+    def test_match_set_parameters_required_together(self):
+        for lone_parameter in ({'match_set': 'admin_hosts'},
+                               {'match_set_flags': 'src'}):
+            set_module_args(dict({'chain': 'INPUT'}, **lone_parameter))
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_count, 0)
+
+    def test_match_set_flags_reject_invalid_value(self):
+        set_module_args({'chain': 'INPUT', 'match_set': 'admin_hosts',
+                         'match_set_flags': 'source'})
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+        self.assertEqual(run_command.call_count, 0)
