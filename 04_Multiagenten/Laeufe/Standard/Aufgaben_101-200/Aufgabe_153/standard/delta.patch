diff --git a/packages/drive-store/zustand/share/shareStores.test.ts b/packages/drive-store/zustand/share/shareStores.test.ts
new file mode 100644
index 0000000..4f53c2c
--- /dev/null
+++ b/packages/drive-store/zustand/share/shareStores.test.ts
@@ -0,0 +1,69 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from './getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareInvitation;
+const externalInvitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareExternalInvitation;
+
+describe('share member and invitation stores', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('keeps members for each share separate and replaces only the selected share', () => {
+        const store = useMembersStore.getState();
+        expect(store.getMembers('missing')).toEqual([]);
+
+        store.setMembers('first', [member('old@example.com')]);
+        store.setMembers('second', [member('second@example.com')]);
+        store.setMembers('first', [member('new@example.com')]);
+
+        expect(store.getMembers('first').map(({ email }) => email)).toEqual(['new@example.com']);
+        expect(store.getMembers('second').map(({ email }) => email)).toEqual(['second@example.com']);
+    });
+
+    it('keeps internal and external invitations scoped through set, update and remove', () => {
+        const store = useInvitationsStore.getState();
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+
+        store.setInvitations('first', [invitation('first@example.com')]);
+        store.setExternalInvitations('first', [externalInvitation('external-first@example.com')]);
+        store.setInvitations('second', [invitation('second@example.com')]);
+        store.setExternalInvitations('second', [externalInvitation('external-second@example.com')]);
+
+        store.updateInvitationsPermissions('first', [invitation('updated@example.com')]);
+        store.updateExternalInvitations('first', [externalInvitation('updated-external@example.com')]);
+        expect(store.getInvitations('second')[0].inviteeEmail).toBe('second@example.com');
+        expect(store.getExternalInvitations('second')[0].inviteeEmail).toBe('external-second@example.com');
+
+        store.removeInvitations('first', []);
+        store.removeExternalInvitations('first', []);
+        expect(store.getInvitations('first')).toEqual([]);
+        expect(store.getExternalInvitations('first')).toEqual([]);
+        expect(store.getInvitations('second')).toHaveLength(1);
+        expect(store.getExternalInvitations('second')).toHaveLength(1);
+
+        store.addMultipleInvitations(
+            'first',
+            [invitation('new@example.com')],
+            [externalInvitation('new-external@example.com')]
+        );
+        expect(store.getInvitations('first')[0].inviteeEmail).toBe('new@example.com');
+        expect(store.getExternalInvitations('first')[0].inviteeEmail).toBe('new-external@example.com');
+        expect(store.getInvitations('second')).toHaveLength(1);
+    });
+
+    it('combines addresses from members and both invitation types', () => {
+        expect(
+            getExistingEmails(
+                [member('member@example.com')],
+                [invitation('internal@example.com')],
+                [externalInvitation('external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'internal@example.com', 'external@example.com']);
+    });
+});
