+        assert metadata['manifest'] is None
+    else:
+        assert metadata['manifest'] == {}
+
+    manifest_builder = MagicMock(return_value={'format': 1, 'files': []})
+    monkeypatch.setattr(collection, '_build_files_manifest_distlib', manifest_builder)
+    actual = collection._build_files_manifest(galaxy_yml_dir, 'namespace', 'collection', [], metadata['manifest'])
+    assert actual == {'format': 1, 'files': []}
+    manifest_builder.assert_called_once_with(galaxy_yml_dir, 'namespace', 'collection', {})
