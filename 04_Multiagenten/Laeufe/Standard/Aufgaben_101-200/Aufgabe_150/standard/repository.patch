+def test_explicit_minimal_manifest(galaxy_yml_dir, manifest_value, monkeypatch):
+    galaxy_yml = os.path.join(galaxy_yml_dir, b'galaxy.yml')
+    with open(galaxy_yml, 'ab') as galaxy_obj:
