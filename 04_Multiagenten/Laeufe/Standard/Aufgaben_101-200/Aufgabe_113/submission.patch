+
+    def test_route_targets_create_context_with_defaults(self):
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[{'rt': '65000:1000'}]))
+        self.execute_module(changed=True, commands=[
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'route-target import 65000:1000', 'route-target export 65000:1000'], sort=False)
+
+    def test_route_targets_mixed_and_scoped(self):
+        self.get_config.return_value = '''vrf context other
+  address-family ipv4 unicast
+    route-target import 1:1
+vrf context ntc
+  address-family ipv6 unicast
+    route-target import 2:2
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 2:2
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4',
+                             route_target_both_auto_evpn=False,
+                             route_targets=[{'rt': '1:1', 'direction': 'import'},
+                                            {'rt': '1:1', 'direction': 'export'},
+                                            {'rt': '2:2', 'direction': 'export', 'state': 'absent'},
+                                            {'rt': '3:3', 'state': 'absent'},
+                                            {'rt': '4:4'}]))
+        self.execute_module(changed=True, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target both auto evpn', 'route-target export 1:1',
+            'no route-target export 2:2', 'route-target import 4:4',
+            'route-target export 4:4'], sort=False)
+
+    def test_route_targets_idempotent(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=True,
+                             route_targets=[{'rt': '1:1'},
+                                            {'rt': '2:2', 'state': 'absent'}]))
+        self.execute_module(changed=False, commands=[])
+
