+func TestAmazonLinuxVersionAndEOL(t *testing.T) {
+	for _, tt := range []struct {
+		release string
+		version string
+		until   time.Time
+	}{
+		{"2018.03", "1", time.Date(2023, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2023.01", "1", time.Date(2023, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2 (Karoo)", "2", time.Date(2024, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2022 (Amazon Linux)", "2022", time.Date(2026, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2023 (Amazon Linux 2023)", "2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2023.6.20241010 (Amazon Linux)", "2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2025", "2025", time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2027", "2027", time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2029", "2029", time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC)},
+	} {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.version {
+				t.Fatalf("version = %q, want %q", got, tt.version)
+			}
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found || !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Fatalf("EOL = %+v, found = %v, want %v", eol, found, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSupportEnded(tt.until) {
+				t.Error("support ended at end-of-day boundary")
+			}
+			if !eol.IsStandardSupportEnded(tt.until.Add(time.Second)) || !eol.IsExtendedSupportEnded(tt.until.Add(time.Second)) {
+				t.Error("support still active after end-of-day boundary")
+			}
+		})
+	}
+	for _, release := range []string{"", "2024", "2024 (Amazon Linux)", "garbage"} {
+		if got := getAmazonLinuxVersion(release); got != "unknown" {
+			t.Errorf("version of %q = %q, want unknown", release, got)
+		}
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("unexpected EOL for %q", release)
+		}
+	}
+}
+
+func TestEOLWithExtendedSupport(t *testing.T) {
+	eol := EOL{
+		StandardSupportUntil: time.Date(2024, 6, 30, 23, 59, 59, 0, time.UTC),
+		ExtendedSupportUntil: time.Date(2026, 6, 30, 23, 59, 59, 0, time.UTC),
+	}
+	if eol.IsStandardSupportEnded(eol.StandardSupportUntil) || eol.IsExtendedSupportEnded(eol.StandardSupportUntil) {
+		t.Fatal("support should be active at standard boundary")
+	}
+	if !eol.IsStandardSupportEnded(eol.StandardSupportUntil.Add(time.Second)) || eol.IsExtendedSupportEnded(eol.StandardSupportUntil.Add(time.Second)) {
+		t.Fatal("only extended support should be active after standard boundary")
+	}
+	if !eol.IsExtendedSupportEnded(eol.ExtendedSupportUntil.Add(time.Second)) {
+		t.Fatal("extended support should end after extended boundary")
+	}
+}
