+func TestAmazonDependenciesByRelease(t *testing.T) {
+	for _, tt := range []struct {
+		release string
+		want    []string
+	}{
+		{"2 (Karoo)", []string{"yum-utils"}},
+		{"2023 (Amazon Linux 2023)", []string{}},
+		{"2023.6.20241010 (Amazon Linux)", []string{}},
+	} {
+		a := newAmazon(config.ServerInfo{})
+		a.setDistro(constant.Amazon, tt.release)
+		if got := a.depsFast(); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("depsFast(%q) = %v, want %v", tt.release, got, tt.want)
+		}
+		if got := a.depsFastRoot(); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("depsFastRoot(%q) = %v, want %v", tt.release, got, tt.want)
+		}
+	}
+}
