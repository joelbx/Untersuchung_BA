+func amazonOvalRelease(release string) string {
+	fields := strings.Fields(release)
+	if len(fields) == 0 {
+		return "unknown"
+	}
+	switch fields[0] {
+	case "2", "2022", "2023", "2025", "2027", "2029":
+		return fields[0]
+	case "1":
+		return "1"
+	}
+	if len(fields[0]) == 7 && fields[0][4] == '.' &&
+		strings.Trim(fields[0], "0123456789.") == "" {
+		return "1"
+	}
+	parts := strings.Split(fields[0], ".")
+	if len(parts) >= 3 && strings.Trim(fields[0], "0123456789.") == "" {
+		switch parts[0] {
+		case "2023", "2025", "2027", "2029":
+			return parts[0]
+		}
+	}
+	return "unknown"
+}
