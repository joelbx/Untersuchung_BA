+func TestImageReference(t *testing.T) {
+	tests := []struct {
+		name, tag, digest, fullName, errorText string
+	}{
+		{name: "alpine", tag: "3.12", fullName: "alpine:3.12"},
+		{name: "alpine", digest: "sha256:abc", fullName: "alpine@sha256:abc"},
+		{tag: "latest", errorText: "Invalid arguments : no image name"},
+		{name: "alpine", errorText: "Invalid arguments : no image tag and digest"},
+		{name: "alpine", tag: "latest", digest: "sha256:abc", errorText: "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tt := range tests {
+		image := Image{Name: tt.name, Tag: tt.tag, Digest: tt.digest}
+		err := IsValidImage(image)
+		if tt.errorText == "" {
+			if err != nil {
+				t.Errorf("%+v: unexpected error: %v", image, err)
+			}
+			if got := image.GetFullName(); got != tt.fullName {
+				t.Errorf("%+v: full name = %q, want %q", image, got, tt.fullName)
+			}
+		} else if err == nil || err.Error() != tt.errorText {
+			t.Errorf("%+v: error = %v, want %q", image, err, tt.errorText)
+		}
+	}
+}
