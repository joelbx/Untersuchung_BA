+		image Image
+		want  string
+	}{
+		{Image{Name: "alpine", Tag: "3.12"}, "alpine:3.12@host"},
+		{Image{Name: "alpine", Digest: "sha256:abc"}, "alpine@sha256:abc@host"},
+	} {
+		r := ScanResult{ServerName: "host", Image: tt.image, ScannedAt: time.Date(2020, 1, 2, 0, 0, 0, 0, time.UTC)}
+		if got := r.ReportFileName(); got != tt.want {
+			t.Errorf("ReportFileName() = %q, want %q", got, tt.want)
