index 0000000..8ccbb04
--- /dev/null
+++ b/lib/backend/dynamo/billing_test.go
@@ -0,0 +1,109 @@
+package dynamo
+
+import (
+	"context"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/awserr"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbiface"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type billingTestClient struct {
+	dynamodbiface.DynamoDBAPI
+	created     *dynamodb.CreateTableInput
+	described   *dynamodb.DescribeTableOutput
+	describeErr error
+}
+
+func (c *billingTestClient) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	c.created = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (c *billingTestClient) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (c *billingTestClient) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return c.described, c.describeErr
+}
+
+func TestBillingModeDefaultsAndValidation(t *testing.T) {
+	for _, tc := range []struct {
+		mode  string
+		want  string
+		valid bool
+	}{
+		{"", billingModePayPerRequest, true},
+		{billingModePayPerRequest, billingModePayPerRequest, true},
+		{billingModeProvisioned, billingModeProvisioned, true},
+		{"invalid", "invalid", false},
+	} {
+		cfg := Config{TableName: "test-table", BillingMode: tc.mode}
+		err := cfg.CheckAndSetDefaults()
+		if tc.valid {
+			require.NoError(t, err)
+			require.Equal(t, tc.want, cfg.BillingMode)
+		} else {
+			require.Error(t, err)
+		}
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		mode       string
+		awsMode    string
+		throughput bool
+	}{
+		{billingModePayPerRequest, dynamodb.BillingModePayPerRequest, false},
+		{billingModeProvisioned, dynamodb.BillingModeProvisioned, true},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			client := &billingTestClient{}
+			b := &Backend{Entry: logrus.NewEntry(logrus.New()), Config: Config{
+				BillingMode: tc.mode, ReadCapacityUnits: 17, WriteCapacityUnits: 23,
+			}, svc: client}
+			require.NoError(t, b.createTable(context.Background(), "test-table", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(client.created.BillingMode))
+			if tc.throughput {
+				require.Equal(t, int64(17), aws.Int64Value(client.created.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(23), aws.Int64Value(client.created.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
+				require.Nil(t, client.created.ProvisionedThroughput)
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		client billingTestClient
+		status tableStatus
+		mode   string
+	}{
+		{"on demand", billingTestClient{described: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+		}}}, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"legacy provisioned", billingTestClient{described: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}}, tableStatusOK, ""},
+		{"missing", billingTestClient{describeErr: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)}, tableStatusMissing, ""},
+		{"migration", billingTestClient{described: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}},
+			BillingModeSummary:   &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+		}}}, tableStatusNeedsMigration, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &tc.client}
+			status, mode, err := b.getTableStatus(context.Background(), "test-table")
+			require.NoError(t, err)
+			require.Equal(t, tc.status, status)
+			require.Equal(t, tc.mode, mode)
+		})
+	}
+}
