diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..80e7bd3
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,82 @@
+import { render } from '@testing-library/react';
+import { SetStateAction } from 'react';
+
+import Notification from './Notification';
+import createNotificationManager from './manager';
+import { NotificationOptions } from './interfaces';
+
+describe('Notification', () => {
+    const renderNotification = (children: React.ReactNode) =>
+        render(
+            <Notification type="error" isClosing={false} onExit={() => {}}>
+                {children}
+            </Notification>
+        );
+
+    it('renders sanitized HTML and secures links', () => {
+        const { container } = renderNotification(
+            '<a href="https://example.com" target="_self" onclick="alert(1)">Help</a><strong>now</strong><script>alert(1)</script><a href="javascript:alert(1)">bad</a>'
+        );
+        const links = container.querySelectorAll('a');
+
+        expect(links).toHaveLength(2);
+        expect(links[0]).toHaveAttribute('href', 'https://example.com');
+        expect(links[0]).toHaveAttribute('target', '_blank');
+        expect(links[0]).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(links[0]).not.toHaveAttribute('onclick');
+        expect(links[1]).not.toHaveAttribute('href');
+        expect(container.querySelector('strong')).toHaveTextContent('now');
+        expect(container.querySelector('script')).toBeNull();
+    });
+
+    it('keeps React elements and secures their links', () => {
+        const { getByRole } = renderNotification(<a href="https://example.com">Help</a>);
+
+        expect(getByRole('link')).toHaveAttribute('target', '_blank');
+        expect(getByRole('link')).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+});
+
+describe('notification manager', () => {
+    let notifications: NotificationOptions[];
+    let manager: ReturnType<typeof createNotificationManager>;
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        notifications = [];
+        manager = createNotificationManager((update: SetStateAction<NotificationOptions[]>) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        });
+    });
+
+    afterEach(() => {
+        manager.clearNotifications();
+        jest.useRealTimers();
+    });
+
+    it('deduplicates non-success strings using their text as the key', () => {
+        manager.createNotification({ type: 'error', text: 'Same' });
+        manager.createNotification({ type: 'info', text: 'Same' });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ key: 'Same', type: 'info' });
+    });
+
+    it('uses explicit keys for React elements and falls back to the id', () => {
+        manager.createNotification({ type: 'error', text: <span>First</span>, key: 'shared' });
+        manager.createNotification({ type: 'warning', text: <span>Second</span>, key: 'shared' });
+        manager.createNotification({ type: 'error', text: <span>Third</span> });
+
+        expect(notifications).toHaveLength(2);
+        expect(notifications[0]).toMatchObject({ key: 'shared', type: 'warning' });
+        expect(notifications[1].key).toBe(notifications[1].id);
+    });
+
+    it('allows repeated success notifications even with matching keys', () => {
+        manager.createNotification({ type: 'success', text: 'Done', key: 'shared' });
+        manager.createNotification({ type: 'success', text: 'Done', key: 'shared' });
+        manager.createNotification({ type: 'error', text: 'Failed', key: 'shared' });
+
+        expect(notifications).toHaveLength(3);
+    });
+});
