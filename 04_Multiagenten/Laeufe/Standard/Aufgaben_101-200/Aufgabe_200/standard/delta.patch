+@pytest.mark.parametrize('duration, milliseconds', [
+    ('5000', 5000),
+    ('2m30s', 150000),
+])
+def test_later_duration(mocker, duration, milliseconds):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration, 'message-info done', win_id=0)
+
+    timer.return_value.setInterval.assert_called_once_with(milliseconds)
+    timer.return_value.start.assert_called_once_with()
+
+
+@pytest.mark.parametrize('duration', ['', 'invalid', '-1s'])
