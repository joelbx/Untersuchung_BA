+func TestInstalledPackagesEmptyRelease(t *testing.T) {
+	for _, tc := range []struct {
+		name, line, wantVersion, wantSourceVersion string
+		repoquery                                  bool
+	}{
+		{"zero epoch", "example 0 1.2  x86_64 example-1.2-.src.rpm", "1.2", "1.2", false},
+		{"none epoch", "example (none) 1.2  x86_64 example-1.2--src.rpm", "1.2", "1.2", false},
+		{"nonzero epoch", "example 2 1.2  x86_64 example-1.2-.src.rpm", "2:1.2", "2:1.2", false},
+		{"modular", "example 0 1.2  x86_64 example-1.2-.src.rpm (none)", "1.2", "1.2", false},
+		{"repoquery zero epoch", "example 0 1.2  x86_64 example-1.2-.src.rpm @updates", "1.2", "1.2", true},
+		{"repoquery nonzero epoch", "example 2 1.2  x86_64 example-1.2-.src.rpm @updates", "2:1.2", "2:1.2", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var bp *models.Package
+			var sp *models.SrcPackage
+			var err error
+			if tc.repoquery {
+				bp, sp, err = o.parseInstalledPackagesLineFromRepoquery(tc.line)
+			} else {
+				bp, sp, err = o.parseInstalledPackagesLine(tc.line)
+			}
+			if err != nil || bp == nil || sp == nil {
+				t.Fatalf("parse: package=%v source=%v err=%v", bp, sp, err)
+			}
+			if bp.Name != "example" || bp.Version != tc.wantVersion || bp.Release != "" || bp.Arch != "x86_64" || sp.Name != "example" || sp.Version != tc.wantSourceVersion {
+				t.Errorf("unexpected package=%+v source=%+v", bp, sp)
+			}
+			if tc.repoquery && bp.Repository != "updates" {
+				t.Errorf("repository = %q", bp.Repository)
+			}
+		})
+	}
+
+	for _, tc := range []struct {
+		name, family, release, line, wantRepo string
+	}{
+		{"rpm", constant.CentOS, "8", "example 0 1.2  x86_64 example-1.2-.src.rpm", ""},
+		{"amazon rpm", constant.Amazon, "2", "example 0 1.2  x86_64 example-1.2-.src.rpm", ""},
+		{"amazon repoquery", constant.Amazon, "2", "example 0 1.2  x86_64 example-1.2-.src.rpm @updates", "updates"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := &redhatBase{base: base{Distro: config.Distro{Family: tc.family, Release: tc.release}, log: logging.NewIODiscardLogger()}}
+			bins, srcs, err := o.parseInstalledPackages(tc.line)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(bins) != 1 || len(srcs) != 1 || bins["example"].Release != "" || bins["example"].Version != "1.2" || bins["example"].Repository != tc.wantRepo || srcs["example"].Version != "1.2" {
+				t.Errorf("bins=%+v srcs=%+v", bins, srcs)
+			}
+		})
+	}
+}
+
+func TestSplitFileNameValidation(t *testing.T) {
+	for _, tc := range []struct {
+		filename, name, version, release, epoch, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "", "src"},
+		{"package-0--src.rpm", "package", "0", "", "", "src"},
+		{"package-0-.src.rpm", "package", "0", "", "", "src"},
+		{"1:multi-part-9-123a.ia64.rpm", "multi-part", "9", "123a", "1", "ia64"},
+	} {
+		t.Run(tc.filename, func(t *testing.T) {
+			name, version, release, epoch, arch, err := splitFileName(tc.filename)
+			if err != nil || name != tc.name || version != tc.version || release != tc.release || epoch != tc.epoch || arch != tc.arch {
+				t.Errorf("got %q %q %q %q %q, err=%v", name, version, release, epoch, arch, err)
+			}
+		})
+	}
+	for _, filename := range []string{"package-0-1-src", "package-0-src.rpm", "-0-1.src.rpm", "package--1.src.rpm", "package-0-1..rpm", "bad:package-0-1.src.rpm"} {
+		if _, _, _, _, _, err := splitFileName(filename); err == nil {
+			t.Errorf("accepted malformed filename %q", filename)
+		}
+	}
+}
+
+func TestParseUpdatablePacksLinesNoneEpoch(t *testing.T) {
+	o := &redhatBase{}
+	packages, err := o.parseUpdatablePacksLines("pkg (none) 1.2 3 updates\npkg2 4 5.6 7 @CentOS 8\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(packages) != 2 || packages["pkg"].NewVersion != "1.2" || packages["pkg"].NewRelease != "3" || packages["pkg"].Repository != "updates" || packages["pkg2"].NewVersion != "4:5.6" || packages["pkg2"].NewRelease != "7" || packages["pkg2"].Repository != "@CentOS 8" {
+		t.Errorf("packages = %+v", packages)
+	}
+}
