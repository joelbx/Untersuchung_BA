+    @pytest.mark.parametrize('commandline_flags, config_flags', [
+        (['enable-features=First,Second', 'disable-features=Blocked,Other',
+          'enable-features=Third'], []),
+        ([], ['enable-features=First,Second',
+              'disable-features=Blocked,Other', 'enable-features=Third']),
+        (['enable-features=First,Second', 'disable-features=Blocked,Other'],
+         ['enable-features=Third']),
+    ])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch,
+                                         parser, commandline_flags,
+                                         config_flags):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+        config_stub.val.qt.args = config_flags
+
+        cli_args = []
+        for flag in commandline_flags:
+            cli_args.extend(['--qt-flag', flag])
+        args = qtargs.qt_args(parser.parse_args(cli_args))
+
+        assert qtargs.ENABLE_FEATURES_PREFIX == '--enable-features='
+        assert qtargs.DISABLE_FEATURES_PREFIX == '--disable-features='
+        assert [arg for arg in args if arg.startswith(
+            qtargs.ENABLE_FEATURES_PREFIX)] == [
+                '--enable-features=First,Second,Third,OverlayScrollbar']
+        assert [arg for arg in args if arg.startswith(
+            qtargs.DISABLE_FEATURES_PREFIX)] == [
+                '--disable-features=Blocked,Other']
+
+    def test_disable_features_only(self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['disable-features=FromConfig,Another']
+
+        parsed = parser.parse_args([
+            '--qt-flag', 'disable-features=FromCommandLine'])
+        args = qtargs.qt_args(parsed)
+
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+        assert [arg for arg in args if arg.startswith(
+            qtargs.DISABLE_FEATURES_PREFIX)] == [
+                '--disable-features=FromCommandLine',
+                '--disable-features=FromConfig,Another']
+
