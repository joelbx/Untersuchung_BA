+func TestFillWordPressIgnoreInactivePerServer(t *testing.T) {
+	previousConf := config.Conf
+	defer func() { config.Conf = previousConf }()
+
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Type: models.WPCore, Version: "6.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: "inactive", Version: "1.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+	}
+	cache := map[string]*string{
+		"60":              stringPtr(""),
+		"active-plugin":   stringPtr(`{"plugin":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`),
+		"inactive-plugin": stringPtr(`{"plugin":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`),
+		"inactive-theme":  stringPtr(`{"theme":{"vulnerabilities":[{"id":3,"fixed_in":"2.0"}]}}`),
+	}
+
+	for _, tt := range []struct {
+		ignoreInactive bool
+		want           int
+	}{
+		{ignoreInactive: true, want: 1},
+		{ignoreInactive: false, want: 3},
+	} {
+		config.Conf.Servers = map[string]config.ServerInfo{
+			"target": {WordPress: config.WordPressConf{IgnoreInactive: tt.ignoreInactive}},
+		}
+		config.Conf.WpIgnoreInactive = !tt.ignoreInactive
+		r := &models.ScanResult{
+			ServerName:        "target",
+			WordPressPackages: &packages,
+			ScannedCves:       models.VulnInfos{},
+		}
+		got, err := FillWordPress(r, "unused", cache)
+		if err != nil {
+			t.Fatalf("ignoreInactive=%t: %v", tt.ignoreInactive, err)
+		}
+		if got != tt.want || len(r.ScannedCves) != tt.want {
+			t.Errorf("ignoreInactive=%t: got %d vulnerabilities and %d CVEs, want %d", tt.ignoreInactive, got, len(r.ScannedCves), tt.want)
+		}
+	}
+}
