diff --git a/openlibrary/tests/test_book_providers_runeberg.py b/openlibrary/tests/test_book_providers_runeberg.py
new file mode 100644
index 0000000..7d96c6f
--- /dev/null
+++ b/openlibrary/tests/test_book_providers_runeberg.py
@@ -0,0 +1,24 @@
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider,
+    get_solr_keys,
+    is_non_ia_ocaid,
+)
+
+
+def test_project_runeberg_provider():
+    provider = ProjectRunebergProvider()
+    edition = {'key': '/books/OL1M', 'identifiers': {'project_runeberg': ['nordic/book']}}
+
+    assert get_book_provider(edition).short_name == 'runeberg'
+    assert 'id_project_runeberg' in get_solr_keys()
+    assert provider.is_own_ocaid('ProjectRunebergNordic')
+    assert is_non_ia_ocaid('ProjectRunebergNordic')
+    assert not provider.is_own_ocaid('unrelated-book')
+
+    acquisition = provider.get_acquisitions(edition)[0]
+    assert acquisition.access == 'open-access'
+    assert acquisition.format == 'web'
+    assert acquisition.price is None
+    assert acquisition.url == 'https://runeberg.org/nordic/book/'
+    assert acquisition.provider_name == 'runeberg'
