+def supplement_rec_with_import_item_metadata(
+    rec: dict[str, Any], identifier: str
+) -> None:
+    """Fill empty fields from a staged or pending import item, in place."""
+    if not is_incomplete_record(rec):
+        return
+    try:
+        item = ImportItem.find_staged_or_pending([identifier]).first()
+        if not item:
+            return
+        metadata = json.loads(item.get('data') or '{}')
+        for field in (
+            'authors', 'isbn_10', 'isbn_13', 'number_of_pages',
+            'physical_format', 'publish_date', 'publishers', 'title',
+        ):
+            if not rec.get(field) and metadata.get(field):
+                rec[field] = metadata[field]
+    except Exception:
+        logger.exception('Failed to supplement import record for %s', identifier)
+
+
+def augment_incomplete_promise_record(rec: dict[str, Any]) -> None:
+    if not is_promise_item(rec):
+        return
+    for field, placeholder in (
+        ('authors', [{'name': '????'}]),
+        ('publish_date', '????'),
+        ('publishers', ['????']),
+    ):
+        if rec.get(field) == placeholder:
+            rec.pop(field)
+    if is_incomplete_record(rec):
+        identifier = (rec.get('isbn_10') or [None])[0] or get_non_isbn_asin(rec)
+        if identifier:
+            supplement_rec_with_import_item_metadata(rec, identifier)
+
+
