+
+var _ = Describe("getOpenSubsonicExtensions", func() {
+	It("returns the JSON extension list without credentials", func() {
+		router := (&Router{}).routes()
+		request := httptest.NewRequest(http.MethodGet, "/getOpenSubsonicExtensions.view?f=json", nil)
+		response := httptest.NewRecorder()
+
+		router.ServeHTTP(response, request)
+
+		Expect(response.Code).To(Equal(http.StatusOK))
+		Expect(response.Header().Get("Content-Type")).To(Equal("application/json"))
+
+		var body responses.JsonWrapper
+		Expect(json.Unmarshal(response.Body.Bytes(), &body)).To(Succeed())
+		Expect(body.Subsonic.Status).To(Equal(responses.StatusOK))
+		Expect(body.Subsonic.OpenSubsonicExtensions).NotTo(BeNil())
+		Expect(*body.Subsonic.OpenSubsonicExtensions).To(Equal(responses.OpenSubsonicExtensions{
+			{Name: "transcodeOffset", Versions: []int32{1}},
+			{Name: "formPost", Versions: []int32{1}},
+			{Name: "songLyrics", Versions: []int32{1}},
+		}))
+	})
+})
