+func (s *AuthSuite) TestRemoteClusterHeartbeatSurvivesTunnelRemoval(c *C) {
+	const clusterName = "remote.example"
+	rc, err := services.NewRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	c.Assert(s.a.CreateRemoteCluster(rc), IsNil)
+
+	checkCluster := func(status string, heartbeat time.Time) {
+		cluster, err := s.a.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(cluster.GetConnectionStatus(), Equals, status)
+		c.Assert(cluster.GetLastHeartbeat(), DeepEquals, heartbeat)
+		stored, err := s.a.Presence.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(stored.GetConnectionStatus(), Equals, status)
+		c.Assert(stored.GetLastHeartbeat(), DeepEquals, heartbeat)
+	}
+
+	checkCluster(teleport.RemoteClusterStatusOffline, time.Time{})
+	first := time.Now().UTC().Add(-time.Second)
+	second := first.Add(500 * time.Millisecond).In(time.FixedZone("later", 2*60*60))
+	for _, entry := range []struct {
+		name      string
+		heartbeat time.Time
+	}{{"first", first}, {"second", second}} {
+		conn, err := services.NewTunnelConnection(entry.name, services.TunnelConnectionSpecV2{
+			ClusterName:   clusterName,
+			ProxyName:     "proxy",
+			LastHeartbeat: entry.heartbeat,
+		})
+		c.Assert(err, IsNil)
+		c.Assert(s.a.UpsertTunnelConnection(conn), IsNil)
+		checkCluster(teleport.RemoteClusterStatusOnline, entry.heartbeat.UTC())
+	}
+
+	c.Assert(s.a.DeleteTunnelConnection(clusterName, "second"), IsNil)
+	checkCluster(teleport.RemoteClusterStatusOnline, second.UTC())
+	c.Assert(s.a.DeleteTunnelConnection(clusterName, "first"), IsNil)
+	checkCluster(teleport.RemoteClusterStatusOffline, second.UTC())
+}
