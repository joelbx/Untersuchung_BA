+describe("Pill", () => {
+    beforeEach(() => stubClient());
+
+    it("exposes the @room token helpers", () => {
+        expect(pillRoomNotifPos("hello @room @room")).toBe(6);
+        expect(pillRoomNotifPos("hello")).toBe(-1);
+        expect(pillRoomNotifLen()).toBe(5);
+    });
+
+    it("renders nothing for an unknown target", () => {
+        const { container } = render(<Pill url="https://example.org/ordinary" inMessage />);
+        expect(container.querySelector("bdi")).toBeNull();
+    });
+
+    it("renders @room as a span with its room ID on hover", () => {
+        const client = stubClient();
+        const room = new Room("!room:example.org", client, client.getUserId()!);
+        const { container, getByTestId } = render(<Pill type={PillType.AtRoomMention} room={room} inMessage />);
+        const pill = container.querySelector("bdi > span.mx_Pill.mx_AtRoomPill")!;
+        expect(pill.querySelector(".mx_Pill_linkText")?.textContent).toBe("@room");
+        expect(pill.querySelector(".mx_BaseAvatar")).toBeNull();
+        fireEvent.mouseOver(pill);
+        expect(getByTestId("tooltip").textContent).toBe(room.roomId);
+        fireEvent.mouseLeave(pill);
+        expect(container.querySelector("[data-testid=tooltip]")).toBeNull();
+    });
+
+    it("preserves the user permalink and dispatches ViewUser when clicked in a message", () => {
+        const url = "https://matrix.to/#/@alice:example.org?via=example.org";
+        const client = stubClient();
+        const room = new Room("!room:example.org", client, client.getUserId()!);
+        const member = new RoomMember(room.roomId, "@alice:example.org");
+        jest.spyOn(room, "getMember").mockReturnValue(member);
+        const dispatch = jest.spyOn(dis, "dispatch").mockImplementation(() => undefined);
+        const { container } = render(<Pill url={url} room={room} inMessage />);
+        const pill = container.querySelector("bdi > a.mx_Pill.mx_UserPill") as HTMLAnchorElement;
+        expect(pill.getAttribute("href")).toBe(url);
+        expect(pill.querySelector(".mx_Pill_linkText")?.textContent).toBe("@alice:example.org");
+        fireEvent.click(pill);
+        expect(dispatch).toHaveBeenCalledWith(expect.objectContaining({ action: Action.ViewUser }));
+        dispatch.mockRestore();
+    });
+
+    it("uses the room name and Space class for a known alias", () => {
+        const client = stubClient();
+        const room = new Room("!space:example.org", client, client.getUserId()!);
+        room.name = "The Space";
+        jest.spyOn(room, "getCanonicalAlias").mockReturnValue("#space:example.org");
+        jest.spyOn(room, "isSpaceRoom").mockReturnValue(true);
+        (client.getRooms as jest.Mock).mockReturnValue([room]);
+        const { container } = render(<Pill url="https://matrix.to/#/#space:example.org" />);
+        const pill = container.querySelector("bdi > span.mx_Pill.mx_SpacePill");
+        expect(pill?.querySelector(".mx_Pill_linkText")?.textContent).toBe("The Space");
+    });
