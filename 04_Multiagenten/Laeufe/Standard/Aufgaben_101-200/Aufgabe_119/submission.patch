+export const Pill = ({ type, url, inMessage, room, shouldShowPillAvatar }: PillProps): JSX.Element | null => {
+    const [hover, setHover] = useState(false);
+    const permalink = usePermalink({ type, url, room });
+    if (!permalink.type || permalink.text === null) return null;
+
+    const classes = classNames("mx_Pill", {
+        mx_UserPill: permalink.type === PillType.UserMention,
+        mx_UserPill_me:
+            permalink.type === PillType.UserMention && permalink.resourceId === MatrixClientPeg.get().getUserId(),
+        mx_RoomPill: permalink.type === PillType.RoomMention,
+        mx_AtRoomPill: permalink.type === PillType.AtRoomMention,
+        mx_SpacePill: permalink.type === "space",
+    });
+    const content = (
+        <>
+            {shouldShowPillAvatar === true && permalink.avatar}
+            <span className="mx_Pill_linkText">{permalink.text}</span>
+            {hover && permalink.resourceId && <Tooltip label={permalink.resourceId} alignment={Alignment.Right} />}
+        </>
+    );
+    const handlers = { onMouseOver: () => setHover(true), onMouseLeave: () => setHover(false) };
+
+    return (
+        <bdi>
+            <MatrixClientContext.Provider value={MatrixClientPeg.get()}>
+                {inMessage && url ? (
+                    <a className={classes} href={url} onClick={permalink.onClick || undefined} {...handlers}>
+                        {content}
+                    </a>
+                ) : (
+                    <span className={classes} {...handlers}>
+                        {content}
+                    </span>
+                )}
+            </MatrixClientContext.Provider>
+        </bdi>
+    );
+};
