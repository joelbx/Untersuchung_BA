+
+import React, { ReactElement, useEffect, useState } from "react";
+import { Room } from "matrix-js-sdk/src/models/room";
+import { RoomMember } from "matrix-js-sdk/src/models/room-member";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { MatrixClientPeg } from "../MatrixClientPeg";
+import { getPrimaryPermalinkEntity } from "../utils/permalinks/Permalinks";
+import dis from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+import RoomAvatar from "../components/views/avatars/RoomAvatar";
+import MemberAvatar from "../components/views/avatars/MemberAvatar";
+import { ButtonEvent } from "../components/views/elements/AccessibleButton";
+
+export enum PillType {
+    UserMention = "TYPE_USER_MENTION",
+    RoomMention = "TYPE_ROOM_MENTION",
+    AtRoomMention = "TYPE_AT_ROOM_MENTION",
+}
+
+interface Args {
+    room?: Room;
+    type?: PillType;
+    url?: string;
+}
+
+interface HookResult {
+    avatar: ReactElement | null;
+    text: string | null;
+    onClick: ((e: ButtonEvent) => void) | null;
+    resourceId: string | null;
+    type: PillType | "space" | null;
+}
+
+export function usePermalink({ room, type, url }: Args): HookResult {
+    const resourceId = url ? getPrimaryPermalinkEntity(url)?.split("?")[0] : null;
+    const resolvedType =
+        type ||
+        ({
+            "@": PillType.UserMention,
+            "#": PillType.RoomMention,
+            "!": PillType.RoomMention,
+        }[resourceId?.[0]] as PillType | undefined);
+    const [profile, setProfile] = useState<{ userId: string; member: RoomMember } | null>(null);
+    const localMember = resolvedType === PillType.UserMention && resourceId ? room?.getMember(resourceId) : null;
+
+    useEffect(() => {
+        if (resolvedType !== PillType.UserMention || !resourceId || localMember) return;
+
+        let active = true;
+        MatrixClientPeg.get()
+            .getProfileInfo(resourceId)
+            .then((resp) => {
+                if (!active) return;
+                const member = new RoomMember(null, resourceId);
+                member.name = resp.displayname;
+                member.rawDisplayName = resp.displayname;
+                member.events.member = {
+                    getContent: () => ({ avatar_url: resp.avatar_url }),
+                    getDirectionalContent: () => ({ avatar_url: resp.avatar_url }),
+                } as MatrixEvent;
+                setProfile({ userId: resourceId, member });
+            })
+            .catch((err) => logger.error("Could not retrieve profile data for " + resourceId + ":", err));
+        return () => {
+            active = false;
+        };
+    }, [resourceId, resolvedType, localMember]);
+
+    if (resolvedType === PillType.AtRoomMention) {
+        return {
+            avatar: room ? <RoomAvatar room={room} width={16} height={16} aria-hidden="true" /> : null,
+            text: "@room",
+            onClick: null,
+            resourceId: room?.roomId ?? null,
+            type: resolvedType,
+        };
+    }
+
+    if (!resourceId) return { avatar: null, text: null, onClick: null, resourceId: null, type: null };
+
+    if (resolvedType === PillType.UserMention) {
+        const member =
+            localMember || (profile?.userId === resourceId ? profile.member : new RoomMember(null, resourceId));
+        return {
+            avatar: <MemberAvatar member={member} width={16} height={16} aria-hidden="true" hideTitle />,
+            text: member.rawDisplayName || resourceId,
+            onClick: (e: ButtonEvent) => {
+                e.preventDefault();
+                dis.dispatch({ action: Action.ViewUser, member });
+            },
+            resourceId,
+            type: resolvedType,
+        };
+    }
+
+    if (resolvedType === PillType.RoomMention) {
+        const client = MatrixClientPeg.get();
+        const resolvedRoom =
+            resourceId[0] === "#"
+                ? client
+                      .getRooms()
+                      .find((r) => r.getCanonicalAlias() === resourceId || r.getAltAliases().includes(resourceId))
+                : client.getRoom(resourceId);
+        return {
+            avatar: resolvedRoom ? <RoomAvatar room={resolvedRoom} width={16} height={16} aria-hidden="true" /> : null,
+            text: resolvedRoom?.name || resourceId,
+            onClick: null,
+            resourceId,
+            type: resolvedRoom?.isSpaceRoom() ? "space" : resolvedType,
+        };
+    }
+
+    return { avatar: null, text: null, onClick: null, resourceId: null, type: null };
+}
