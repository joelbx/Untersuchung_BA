--- /dev/null
+++ b/lib/services/trait_expression_test.go
@@ -0,0 +1,22 @@
+package services
+
+import (
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+func TestApplyValueTraitsNestedExpression(t *testing.T) {
+	values, err := ApplyValueTraits(`{{regexp.replace(email.local(external.mail), "^alice$", "admin")}}`, map[string][]string{"mail": {"alice@example.com", "bob@example.com"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"admin"}, values)
+
+	_, err = ApplyValueTraits(`{{regexp.replace(internal.unsupported, "x", "y")}}`, map[string][]string{"unsupported": {"x"}})
+	require.True(t, trace.IsBadParameter(err), "%v", err)
+	require.Contains(t, err.Error(), `unsupported variable "unsupported"`)
+
+	_, err = ApplyValueTraits(`{{regexp.replace(external.mail, "^nomatch$", "x")}}`, map[string][]string{"mail": {"alice@example.com"}})
+	require.True(t, trace.IsNotFound(err), "%v", err)
+	require.Contains(t, err.Error(), "variable interpolation result is empty")
+}
