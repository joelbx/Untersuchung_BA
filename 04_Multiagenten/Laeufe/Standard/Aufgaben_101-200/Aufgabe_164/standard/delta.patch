+func TestImportNestedMetadataAndNamespace(t *testing.T) {
+	tests := []struct {
+		name     string
+		encoding Encoding
+		input    string
+	}{
+		{
+			name:     "YAML",
+			encoding: EncodingYAML,
+			input: `# exported flags
+namespace:
+  key: team
+  name: Team
+  description: Team flags
+flags:
+  - key: feature
+    metadata:
+      owner:
+        name: Alice
+        groups:
+          - core
+          - ops
+      active: true
+    variants:
+      - key: on
+        attachment:
+          nested:
+            items:
+              - name: first
+`,
+		},
+		{
+			name:     "JSON with header",
+			encoding: EncodingJSON,
+			input:    "# exported flags\n" + `{"namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","metadata":{"owner":{"name":"Alice","groups":["core","ops"]},"active":true},"variants":[{"key":"on","attachment":{"nested":{"items":[{"name":"first"}]}}}]}]}`,
+		},
+		{
+			name:     "JSON without header",
+			encoding: EncodingJSON,
+			input:    `{"namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","metadata":{"owner":{"name":"Alice","groups":["core","ops"]},"active":true},"variants":[{"key":"on","attachment":{"nested":{"items":[{"name":"first"}]}}}]}]}`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.encoding, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team", Description: "Team flags"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{"owner": map[string]any{"name": "Alice", "groups": []any{"core", "ops"}}, "active": true}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":{"items":[{"name":"first"}]}}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImportJSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		"# one\n# two\n{}",
+		" # one\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.Error(t, err)
+	}
+}
