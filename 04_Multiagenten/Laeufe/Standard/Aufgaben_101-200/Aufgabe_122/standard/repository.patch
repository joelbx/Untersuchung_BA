diff --git a/internal/cmd/auth_test.go b/internal/cmd/auth_test.go
new file mode 100644
index 0000000..4da9543
--- /dev/null
+++ b/internal/cmd/auth_test.go
@@ -0,0 +1,23 @@
+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+func TestAuthenticationGRPCWithObjectStorageAndAuthenticationDisabled(t *testing.T) {
+	cfg := &config.Config{
+		Storage:  config.StorageConfig{Type: config.ObjectStorageType},
+		Database: config.DatabaseConfig{URL: "invalid database URL"},
+	}
+
+	register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zap.NewNop(), cfg, false)
+	require.NoError(t, err)
+	require.Len(t, register, 2)
+	require.Empty(t, interceptors)
+	require.NoError(t, shutdown(context.Background()))
+}
