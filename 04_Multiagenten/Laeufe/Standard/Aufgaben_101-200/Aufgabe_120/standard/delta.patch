+    @contextmanager
+    def lock(self):
+        # The lock file survives zip deletion and serializes writers on shared storage.
+        path = self.get_abspath(self.item_id, self.batch_id, ext='lock')
+        os.makedirs(os.path.dirname(path), exist_ok=True)
