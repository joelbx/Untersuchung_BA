@@ -0,0 +1,61 @@
+import os
+import zipfile
+
+import pytest
+
+from openlibrary.coverstore import archive, config, coverlib
+
+
+def test_ids_paths_and_urls(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    assert archive.Cover.id_to_item_and_batch_id(8_819_999) == ('0008', '81')
+    assert archive.Batch._norm_ids(8, 81) == ('0008', '81')
+    assert archive.Batch.get_relpath(8, 81, 's') == 'items/s_covers_0008/s_covers_0008_81.zip'
+    assert archive.Cover.get_cover_url(8_819_999, 'm', protocol='http') == (
+        'http://archive.org/download/m_covers_0008/m_covers_0008_81.zip/0008819999-M.jpg'
+    )
+    assert archive.CoverDB._get_batch_end_id(8_810_001) == 8_819_999
+
+
+def test_zip_staging_and_retry(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    image = tmp_path / 'image.jpg'
+    image.write_bytes(b'jpeg bytes')
+    manager = archive.ZipManager()
+    entry = manager.add_file('0008819999-S.jpg', str(image), 1_700_000_000)
+    manager.add_file('0008819999-S.jpg', str(image), 1_700_000_000)
+    manager.close()
+    assert entry == 's_covers_0008_81.zip/0008819999-S.jpg'
+    path = archive.Batch.get_abspath(8, 81, 's')
+    with zipfile.ZipFile(path) as zf:
+        assert zf.namelist() == ['0008819999-S.jpg']
+        assert zf.getinfo(zf.namelist()[0]).compress_type == zipfile.ZIP_STORED
+    assert coverlib.read_file(coverlib.find_image_path(entry)) == b'jpeg bytes'
+    assert archive.count_files_in_zip(path) == 1
+
+
+def test_batch_finalizes_only_after_all_uploads(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    for size in archive.SIZES:
+        path = archive.Batch.get_abspath(8, 81, size)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with zipfile.ZipFile(path, 'w') as zf:
+            zf.writestr('0008810000.jpg', b'data')
+
+    class FakeUploader:
+        present = False
+
+        def is_uploaded(self, item, name):
+            return self.present
+
+    finalized = []
+    monkeypatch.setattr(archive.CoverDB, 'update_completed_batch', lambda *args: finalized.append(args))
+    batch = archive.Batch(8, 81)
+    uploader = FakeUploader()
+    with pytest.raises(RuntimeError, match='not fully uploaded'):
+        batch.process_pending(finalize=True, uploader=uploader)
+    assert not finalized
+    uploader.present = True
+    batch.process_pending(finalize=True, uploader=uploader)
+    assert finalized == [('0008', '81')]
+    assert all(not os.path.exists(archive.Batch.get_abspath(8, 81, size)) for size in archive.SIZES)
