+func TestUbuntuLTSSupportDates(t *testing.T) {
+	tests := []struct {
+		release       string
+		standardUntil time.Time
+		extendedUntil time.Time
+	}{
+		{"20.04", time.Date(2025, 4, 1, 23, 59, 59, 0, time.UTC), time.Date(2030, 4, 1, 23, 59, 59, 0, time.UTC)},
+		{"22.04", time.Date(2027, 4, 1, 23, 59, 59, 0, time.UTC), time.Date(2032, 4, 1, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Ubuntu, tt.release)
+			if !found {
+				t.Fatal("Ubuntu release was not found")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.standardUntil) || !eol.ExtendedSupportUntil.Equal(tt.extendedUntil) {
+				t.Errorf("support dates = %v, %v; want %v, %v", eol.StandardSupportUntil, eol.ExtendedSupportUntil, tt.standardUntil, tt.extendedUntil)
+			}
+			if eol.IsExtendedSuppportEnded(tt.extendedUntil) {
+				t.Error("extended support ended before its end date")
+			}
+			if !eol.IsExtendedSuppportEnded(tt.extendedUntil.Add(time.Second)) {
+				t.Error("extended support did not end after its end date")
+			}
+			if !eol.IsStandardSupportEnded(tt.standardUntil.Add(time.Second)) {
+				t.Error("standard support did not end after its end date")
+			}
+		})
+	}
+}
