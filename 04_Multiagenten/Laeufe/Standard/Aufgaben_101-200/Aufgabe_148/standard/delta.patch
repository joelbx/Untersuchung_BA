+func TestTeleportProxySSH(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		hello      string
+		clientAddr string
+	}{
+		{name: "standard", hello: "SSH-2.0-test\r\n"},
+		{name: "prefixed with address", hello: apisshutils.ProxyHelloSignature + `{"clientAddr":"192.0.2.10:1234"}` + "\x00SSH-2.0-test\r\n", clientAddr: "192.0.2.10:1234"},
+		{name: "prefixed without address", hello: apisshutils.ProxyHelloSignature + `{"tracingContext":{"traceparent":"test"}}` + "\x00SSH-2.0-test\r\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			mux, err := New(Config{Listener: listener})
+			require.NoError(t, err)
+			sshListener := mux.SSH()
+			go mux.Serve()
+			defer mux.Close()
+
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			_, err = io.WriteString(client, tc.hello)
+			require.NoError(t, err)
+
+			accepted := make(chan net.Conn, 1)
+			go func() {
+				conn, _ := sshListener.Accept()
+				accepted <- conn
+			}()
+			select {
+			case conn := <-accepted:
+				require.NotNil(t, conn)
+				defer conn.Close()
+				expectedAddr := client.LocalAddr().String()
+				if tc.clientAddr != "" {
+					expectedAddr = tc.clientAddr
+				}
+				require.Equal(t, expectedAddr, conn.RemoteAddr().String())
+				if tc.clientAddr != "" {
+					_, ok := conn.RemoteAddr().(*net.TCPAddr)
+					require.True(t, ok)
+				}
+				got := make([]byte, len(tc.hello))
+				_, err := io.ReadFull(conn, got)
+				require.NoError(t, err)
+				require.Equal(t, tc.hello, string(got))
+			case <-time.After(5 * time.Second):
+				t.Fatal("SSH connection was not routed")
+			}
+		})
+	}
+}
+
+func TestTeleportProxyInvalidPayload(t *testing.T) {
+	reader := bufio.NewReader(bytes.NewBufferString(apisshutils.ProxyHelloSignature + "{bad}\x00SSH-2.0-test\r\n"))
+	proto, err := detectProto(reader)
+	require.NoError(t, err)
+	require.Equal(t, ProtoSSH, proto)
+	_, _, err = readTeleportProxyHeader(reader)
+	require.Error(t, err)
+}
