+// readTeleportProxyHeader extracts the client address while replaying the
+// entire hello to the SSH server, which also uses its tracing context.
+func readTeleportProxyHeader(reader *bufio.Reader) (net.Addr, *bufio.Reader, error) {
+	const maxHeaderSize = 16 * 1024
+	first, err := reader.Peek(8)
+	if err != nil || !bytes.Equal(first, []byte(apisshutils.ProxyHelloSignature[:8])) {
+		return nil, reader, nil
+	}
+
+	header := make([]byte, 0, len(apisshutils.ProxyHelloSignature)+256)
+	for len(header) < maxHeaderSize {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err, "failed to read Teleport proxy header")
+		}
+		header = append(header, b)
+		if b == 0 {
+			break
+		}
+	}
+	if len(header) == maxHeaderSize && header[len(header)-1] != 0 {
+		return nil, nil, trace.BadParameter("Teleport proxy header is too long")
+	}
+	if !bytes.HasPrefix(header, []byte(apisshutils.ProxyHelloSignature)) {
+		return nil, nil, trace.BadParameter("invalid Teleport proxy header")
+	}
+	var payload apisshutils.HandshakePayload
+	if err := json.Unmarshal(header[len(apisshutils.ProxyHelloSignature):len(header)-1], &payload); err != nil {
+		return nil, nil, trace.Wrap(err, "invalid Teleport proxy payload")
+	}
+
+	var clientAddr net.Addr
+	if payload.ClientAddr != "" {
+		if addr, err := utils.ParseAddr(payload.ClientAddr); err == nil {
+			clientAddr = addr
+			if addr.AddrNetwork == "tcp" {
+				clientAddr = &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}
+			}
+		}
+	}
+	return clientAddr, bufio.NewReader(io.MultiReader(bytes.NewReader(header), reader)), nil
+}
