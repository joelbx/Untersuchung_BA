+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+
+describe('optimistic mark-as bypass filter', () => {
+    const message = { ID: 'message-1', ConversationID: 'conversation-1' } as Element;
+
+    it.each([
+        [1, MARK_AS_STATUS.READ, MARK_AS_STATUS.UNREAD],
+        [0, MARK_AS_STATUS.UNREAD, MARK_AS_STATUS.READ],
+    ])('removes stale bypass IDs for filter %s in message mode', (unreadFilter, bypassStatus, matchingStatus) => {
+        const initial = newState({ params: { filter: { Unread: unreadFilter } } });
+        const action = (status: MARK_AS_STATUS) =>
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: false, markAsStatus: status });
+
+        const bypassed = elementsReducer(initial, action(bypassStatus));
+        expect(bypassed.bypassFilter).toEqual(['message-1']);
+        expect(elementsReducer(bypassed, action(bypassStatus)).bypassFilter).toEqual(['message-1']);
+        expect(elementsReducer(bypassed, action(matchingStatus)).bypassFilter).toEqual([]);
+    });
+
+    it('uses conversation IDs when marking messages in conversation mode', () => {
+        const initial = newState({ params: { filter: { Unread: 1 } } });
+        const action = (status: MARK_AS_STATUS) =>
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: true, markAsStatus: status });
+
+        const bypassed = elementsReducer(initial, action(MARK_AS_STATUS.READ));
+        expect(bypassed.bypassFilter).toEqual(['conversation-1']);
+        expect(elementsReducer(bypassed, action(MARK_AS_STATUS.UNREAD)).bypassFilter).toEqual([]);
+    });
+});
