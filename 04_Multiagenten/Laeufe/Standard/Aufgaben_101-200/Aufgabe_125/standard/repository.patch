+	Topics.syncBacklinks = async function (postData) {
+		if (!postData || !Number.isInteger(Number(postData.pid)) || Number(postData.pid) <= 0 ||
+			!Number.isInteger(Number(postData.tid)) || Number(postData.tid) <= 0 ||
+			!Number.isInteger(Number(postData.uid)) || typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const key = `pid:${postData.pid}:backlinks`;
+		const previous = await db.getSortedSetRange(key, 0, -1);
+		const base = String(nconf.get('url') || '').replace(/\/+$/, '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+		const pattern = new RegExp(`(?:${base ? `${base}|` : ''}(?<![\\w/.:]))/topic/([1-9]\\d*)(?=/|[?#\\s)<>\\]"']|$)`, 'g');
+		const referenced = [...postData.content.matchAll(pattern)].map(match => match[1]);
+		const unique = [...new Set(referenced)].filter(tid => Number(tid) !== Number(postData.tid));
+		const exists = await Promise.all(unique.map(tid => Topics.exists(tid)));
+		const current = unique.filter((tid, index) => exists[index]);
+		const removed = previous.filter(tid => !current.includes(tid));
+		const added = current.filter(tid => !previous.includes(tid));
+
+		for (const tid of removed) {
+			// Event ids are stored with their topics; locate only this post's events.
+			/* eslint-disable no-await-in-loop */
+			const eventIds = await db.getSortedSetRange(`topic:${tid}:events`, 0, -1);
+			const events = await db.getObjects(eventIds.map(id => `topicEvent:${id}`));
+			await Topics.events.purge(tid, eventIds.filter((id, index) => (
+				events[index] && events[index].type === 'backlink' && events[index].href === `/post/${postData.pid}`)));
+			await db.sortedSetRemove(key, tid);
+		}
+		for (const tid of added) {
+			/* eslint-disable no-await-in-loop */
+			await Topics.events.log(tid, { type: 'backlink', href: `/post/${postData.pid}`, uid: postData.uid });
+			await db.sortedSetAdd(key, Date.now(), tid);
+		}
+		return added.length + removed.length;
 	};
 
 	Topics.getTopicPosts = async function (tid, set, start, stop, uid, reverse) {
