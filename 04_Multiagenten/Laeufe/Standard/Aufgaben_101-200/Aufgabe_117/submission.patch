 _BLINK_SETTINGS = '--blink-settings='
 
 
+def _get_locale_pak_path(locales_dir: pathlib.Path, locale: str) -> pathlib.Path:
+    """Return the QtWebEngine resource file for a locale name."""
+    return pathlib.Path(locales_dir) / (locale.replace('_', '-') + '.pak')
+
+
+def _get_lang_override(
+        versions: version.WebEngineVersions, locale: str,
+) -> Optional[str]:
+    """Choose a Chromium locale when QtWebEngine 5.15.3 lacks its resource file."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    locale = locale.replace('_', '-').split('.', maxsplit=1)[0]
+    locales_dir = (pathlib.Path(QLibraryInfo.location(QLibraryInfo.TranslationsPath)) /
+                   'qtwebengine_locales')
+    if _get_locale_pak_path(locales_dir, locale).is_file():
+        return None
+
+    language, _, region = locale.partition('-')
+    # Chromium ships English, Spanish, Portuguese and Chinese resources under
+    # these names rather than under every system locale's name.
+    if language == 'en':
+        alternatives = ['en-US' if region in ('', 'US', 'LR', 'PH') else 'en-GB']
+    elif language == 'es':
+        alternatives = ['es' if region in ('', 'ES') else 'es-419']
+    elif language == 'pt':
+        alternatives = ['pt-PT' if region == 'PT' else 'pt-BR']
+    elif language == 'zh':
+        alternatives = ['zh-TW' if region in ('TW', 'HK', 'MO') else 'zh-CN']
+    else:
+        alternatives = []
+
+    # A language-only resource is useful when Chromium's regional choice is
+    # absent (for example es-419.pak on a smaller Qt installation).
+    alternatives.append(language)
+    for candidate in alternatives:
+        if _get_locale_pak_path(locales_dir, candidate).is_file():
+            return candidate
+    return 'en-US'
+
+
