+    (True, True, '5.15.4'),
+])
+def test_lang_override_conditions(monkeypatch, config_stub, enabled, linux,
+                                  qt_version):
+    monkeypatch.setattr(qtargs.utils, 'is_linux', linux)
+    config_stub.val.qt.workarounds.locale = enabled
+    versions = version.WebEngineVersions.from_pyqt(qt_version)
+    assert qtargs._get_lang_override(versions, 'es-MX') is None
+
