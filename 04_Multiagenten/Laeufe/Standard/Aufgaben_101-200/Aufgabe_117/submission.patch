+
+@pytest.mark.parametrize('locale, files, expected', [
+    ('de-DE', ['de-DE'], None),
+    ('de-CH', ['de'], 'de'),
+    ('de-CH', [], 'en-US'),
+    ('en', ['en-US'], 'en-US'),
+    ('en-LR', ['en-US'], 'en-US'),
+    ('en-PH', ['en-US'], 'en-US'),
+    ('en-AU', ['en-GB'], 'en-GB'),
+    ('en-CA', ['en-GB'], 'en-GB'),
+    ('en-IE', ['en-GB'], 'en-GB'),
+    ('en-IN', ['en-GB'], 'en-GB'),
+    ('en-NZ', ['en-GB'], 'en-GB'),
+    ('en-ZA', ['en-GB'], 'en-GB'),
+    ('en-ZW', ['en-GB'], 'en-GB'),
+    ('es', ['es'], None),
+    ('es-ES', ['es'], 'es'),
+    ('es_MX.UTF-8', ['es-419', 'es'], 'es-419'),
+    ('es-MX', ['es'], 'es'),
+    ('pt', ['pt-BR'], 'pt-BR'),
+    ('pt-BR', ['pt-BR'], None),
+    ('pt-PT', ['pt-PT'], None),
+    ('pt-PT', ['pt-BR'], 'en-US'),
+    ('zh', ['zh-CN'], 'zh-CN'),
+    ('zh-CN', ['zh-CN'], None),
+    ('zh-TW', ['zh-TW'], None),
+    ('zh-HK', ['zh-TW'], 'zh-TW'),
+    ('zh-MO', ['zh-TW'], 'zh-TW'),
+    ('zh-HK', ['zh'], 'zh'),
+])
+def test_lang_override(monkeypatch, config_stub, tmp_path, locale, files, expected):
+    locales_dir = tmp_path / 'qtwebengine_locales'
+    locales_dir.mkdir()
+    for name in files:
+        (locales_dir / (name + '.pak')).touch()
+    monkeypatch.setattr(qtargs.QLibraryInfo, 'location', lambda _: str(tmp_path))
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    config_stub.val.qt.workarounds.locale = True
+    versions = version.WebEngineVersions.from_pyqt('5.15.3')
+    assert qtargs._get_lang_override(versions, locale) == expected
+
+
+@pytest.mark.parametrize('enabled, linux, qt_version', [
+    (False, True, '5.15.3'),
+    (True, False, '5.15.3'),
