+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnknown DatabaseProtocol = iota
+	DatabaseProtocolSQLite
+	DatabaseProtocolPostgres
+	DatabaseProtocolMySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseProtocolSQLite:
+		return "sqlite3"
+	case DatabaseProtocolPostgres:
+		return "postgres"
+	case DatabaseProtocolMySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// Validate checks the selected database configuration mode.
+func (d DatabaseConfig) Validate() error {
+	if d.URL != "" {
+		return nil
+	}
+	if d.Protocol == DatabaseProtocolUnknown {
+		return errors.New("db.protocol is required (sqlite3, postgres, mysql)")
+	}
+	if d.Protocol != DatabaseProtocolSQLite && d.Protocol != DatabaseProtocolPostgres && d.Protocol != DatabaseProtocolMySQL {
+		return fmt.Errorf("db.protocol value %d is invalid (expected sqlite3, postgres, mysql)", d.Protocol)
+	}
+	if d.Name == "" {
+		return errors.New("db.name is required")
+	}
+	if d.Protocol == DatabaseProtocolSQLite {
+		if d.Path == "" && d.Host == "" {
+			return errors.New("db.path (or db.host) is required for sqlite3")
+		}
+	} else if d.Host == "" {
+		return errors.New("db.host is required")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return errors.New("db.port must be between 1 and 65535")
+	}
+	return nil
 }
 
