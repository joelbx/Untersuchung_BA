new file mode 100644
index 0000000..ad11472
--- /dev/null
+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,89 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/content/oci"
+)
+
+func TestSourceLocalRefreshAndSubscribe(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "features")
+	writeFeatures(t, path, "first")
+
+	store, err := fliptoci.NewStore(&config.OCI{
+		BundleDirectory: dir,
+		Repository:      "flipt://local/features:latest",
+	})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, WithPollInterval(10*time.Millisecond))
+	require.NoError(t, err)
+	ctx := context.Background()
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "other", "first")
+	require.NoError(t, err)
+	again, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, again)
+
+	watchCtx, cancel := context.WithCancel(ctx)
+	updates := make(chan *storagefs.StoreSnapshot)
+	go source.Subscribe(watchCtx, updates)
+	defer func() {
+		cancel()
+		<-updates
+	}()
+	select {
+	case <-updates:
+		t.Fatal("unchanged OCI source sent a snapshot")
+	case <-time.After(30 * time.Millisecond):
+	}
+
+	writeFeatures(t, path, "second")
+	select {
+	case update := <-updates:
+		require.NotSame(t, first, update)
+		_, err = update.GetFlag(ctx, "other", "second")
+		require.NoError(t, err)
+		refreshed, err := source.Get(ctx)
+		require.NoError(t, err)
+		require.Same(t, update, refreshed)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for OCI update")
+	}
+}
+
+func writeFeatures(t *testing.T, path, key string) {
+	t.Helper()
+	store, err := oci.New(path)
+	require.NoError(t, err)
+	store.AutoSaveIndex = true
+	ctx := context.Background()
+	payload := fmt.Sprintf("flags:\n- key: %s\n  name: %s\n  enabled: true\n", key, key)
+	layer := v1.Descriptor{
+		MediaType: fliptoci.MediaTypeFliptNamespace + "+yaml",
+		Digest:    digest.FromString(payload),
+		Size:      int64(len(payload)),
+		Annotations: map[string]string{
+			fliptoci.AnnotationFliptNamespace: "other",
+		},
+	}
+	require.NoError(t, store.Push(ctx, layer, bytes.NewReader([]byte(payload))))
+	manifest, err := oras.PackManifest(ctx, store, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{Layers: []v1.Descriptor{layer}})
+	require.NoError(t, err)
+	require.NoError(t, store.Tag(ctx, manifest, "latest"))
+}
