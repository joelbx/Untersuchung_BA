+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+
+import UIStore from "../../../stores/UIStore";
+import { ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+
+interface Props extends Omit<
+    React.ComponentProps<typeof ContextMenuButton>, "label" | "isExpanded" | "onClick" | "children"
+> {
+    title: string;
+    options: React.ReactNode[];
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ title, options, disabled, ...props }) => {
+    const [isOpen, button, open, close] = useContextMenu<Element>();
+    const rect = button.current?.getBoundingClientRect();
+    const onOpen = (ev: React.SyntheticEvent) => {
+        (button.current as HTMLElement)?.focus();
+        open(ev);
+    };
+    const menuOptions = options.map((option) => {
+        if (!React.isValidElement<{ onClick?: (ev: React.SyntheticEvent) => void }>(option)) return option;
+        return React.cloneElement(option, {
+            onClick: (ev: React.SyntheticEvent) => {
+                option.props.onClick?.(ev);
+                close();
+            },
+        });
+    });
+
+    return <>
+        <ContextMenuButton
+            {...props}
+            inputRef={button}
+            label={title}
+            isExpanded={isOpen}
+            disabled={disabled}
+            aria-disabled={!!disabled}
+            className="mx_KebabContextMenu_button"
+            onClick={onOpen}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { isOpen && rect && <IconizedContextMenu
+            className="mx_KebabContextMenu"
+            top={rect.bottom + window.scrollY}
+            right={UIStore.instance.windowWidth - rect.right - window.scrollX}
+            onFinished={close}
+        >
+            <IconizedContextMenuOptionList first red>
+                { menuOptions }
+            </IconizedContextMenuOptionList>
+        </IconizedContextMenu> }
+    </>;
+};
