+def process_cover_url(
+    edition: dict, allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS
+) -> tuple[str | None, dict]:
+    """Remove the cover field and return its URL only for an allowed HTTP host."""
+    cover_url = edition.pop('cover', None)
+    if not isinstance(cover_url, str):
+        return None, edition
+    try:
+        parsed = urlsplit(cover_url)
+        hostname = parsed.hostname
+    except ValueError:
+        return None, edition
+    if parsed.scheme.lower() not in ('http', 'https') or not hostname:
+        return None, edition
+    allowed_hosts = {host.lower() for host in allowed_cover_hosts}
+    return (cover_url if hostname.lower() in allowed_hosts else None), edition
+
