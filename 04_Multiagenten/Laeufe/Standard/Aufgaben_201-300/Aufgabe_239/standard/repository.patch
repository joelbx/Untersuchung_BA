diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..7bd4593
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,40 @@
+package lastfm
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkStateBindsAuthenticatedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	auth.Init(ds)
+	router := &Router{ds: ds}
+	start := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/link/start", nil)
+	req = req.WithContext(request.WithUser(req.Context(), model.User{ID: "user-a"}))
+	router.startLink(start, req)
+	if start.Code != http.StatusOK {
+		t.Fatalf("start status: %d", start.Code)
+	}
+	var response struct{ State string }
+	if err := json.Unmarshal(start.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	claims, err := auth.Validate(response.State)
+	if err != nil || claims["uid"] != "user-a" {
+		t.Fatalf("state user: %v, %v", claims, err)
+	}
+
+	callback := httptest.NewRecorder()
+	router.callback(callback, httptest.NewRequest(http.MethodGet, "/link/callback?uid=user-b&token=token", nil))
+	if callback.Code != http.StatusBadRequest {
+		t.Fatalf("unsigned uid accepted: %d", callback.Code)
+	}
+}
