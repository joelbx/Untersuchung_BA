+)
+
+var _ = Describe("User Props Repository", func() {
+	It("uses the explicit user ID for every operation", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
+		Expect(repo.Put("user-a", "setting", "a")).To(Succeed())
+		Expect(repo.Put("user-b", "setting", "b")).To(Succeed())
+		Expect(repo.Get("user-a", "setting")).To(Equal("a"))
+		Expect(repo.Get("user-b", "setting")).To(Equal("b"))
