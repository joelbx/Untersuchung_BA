@@ -0,0 +1,32 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestMockedUserPropsRepoIsolatesUsers(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("user-a", "key", "a"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("user-b", "key", "b"); err != nil {
+		t.Fatal(err)
+	}
+	for user, want := range map[string]string{"user-a": "a", "user-b": "b"} {
+		got, err := repo.Get(user, "key")
+		if err != nil || got != want {
+			t.Fatalf("Get(%q): got %q, %v; want %q", user, got, err, want)
+		}
+	}
+	if err := repo.Delete("user-a", "key"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.Get("user-a", "key"); err != model.ErrNotFound {
+		t.Fatalf("deleted user's key: %v", err)
+	}
+	if got, err := repo.DefaultGet("user-b", "key", "default"); err != nil || got != "b" {
+		t.Fatalf("other user's key: %q, %v", got, err)
+	}
+}
