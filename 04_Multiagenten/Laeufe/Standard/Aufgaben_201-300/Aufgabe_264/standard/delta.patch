+def response(status, mocker):
+    body = mocker.Mock()
+    body.read.return_value = '{"ok": true}'
+    return body, {'status': status, 'msg': str(status)}
+
+
+@pytest.mark.parametrize('status', [400, 404, 503])
+def test_fetch_url_http_error(module, mocker, status):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         return_value=response(status, mocker))
+    with pytest.raises(HTTPError):
+        module.request(str(status), method='GET')
+    assert module.status == status
+    assert fetch.call_count == 1
+
+
+@pytest.mark.parametrize('status,exception', [(429, RateLimitException),
+                                              (500, InternalErrorException),
+                                              (502, InternalErrorException)])
+def test_fetch_url_retry_exhausted(module, mocker, status, exception):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         return_value=response(status, mocker))
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    warn = mocker.patch.object(module.module, 'warn')
+    with pytest.raises(exception):
+        module.request(str(status), method='GET')
+    assert module.status == status
+    assert fetch.call_count == 4
+    assert [call[0][0] for call in sleep.call_args_list] == [1, 2, 4]
+    if status == 429:
+        assert '3 retries' in warn.call_args[0][0]
+    else:
+        warn.assert_not_called()
+
+
+def test_fetch_url_rate_limit_then_success(module, mocker):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         side_effect=[response(429, mocker), response(429, mocker), response(200, mocker)])
+    mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    warn = mocker.patch.object(module.module, 'warn')
+    assert module.request('organizations', method='GET') == {'ok': True}
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert '2 retries' in warn.call_args[0][0]
+
+
