+func kevEntries(response kevulndb.Response) []models.KEV {
+	var entries []models.KEV
+	for _, c := range response.CISA {
+		var dueDate *time.Time
+		if !c.DueDate.IsZero() {
+			dueDate = &c.DueDate
+		}
+		entries = append(entries, models.KEV{
+			Type: models.CISAKEVType, VendorProject: c.VendorProject, Product: c.Product,
+			VulnerabilityName: c.VulnerabilityName, ShortDescription: c.ShortDescription,
+			RequiredAction: c.RequiredAction, KnownRansomwareCampaignUse: c.KnownRansomwareCampaignUse,
+			DateAdded: c.DateAdded, DueDate: dueDate, CISA: &models.CISAKEV{Note: c.Notes},
+		})
+	}
+	for _, v := range response.VulnCheck {
+		var dueDate *time.Time
+		if v.DueDate != nil && !v.DueDate.IsZero() {
+			dueDate = v.DueDate
+		}
+		details := &models.VulnCheckKEV{}
+		for _, x := range v.VulnCheckXDB {
+			details.XDB = append(details.XDB, models.VulnCheckXDB{
+				XDBID: x.XDBID, XDBURL: x.XDBURL, DateAdded: x.DateAdded,
+				ExploitType: x.ExploitType, CloneSSHURL: x.CloneSSHURL,
+			})
+		}
+		for _, e := range v.VulnCheckReportedExploitation {
+			details.ReportedExploitation = append(details.ReportedExploitation,
+				models.VulnCheckReportedExploitation{URL: e.URL, DateAdded: e.DateAdded})
+		}
+		entries = append(entries, models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: v.VendorProject, Product: v.Product,
+			VulnerabilityName: v.Name, ShortDescription: v.Description,
+			RequiredAction: v.RequiredAction, KnownRansomwareCampaignUse: v.KnownRansomwareCampaignUse,
+			DateAdded: v.DateAdded, DueDate: dueDate, VulnCheck: details,
+		})
+	}
+	return entries
+}
