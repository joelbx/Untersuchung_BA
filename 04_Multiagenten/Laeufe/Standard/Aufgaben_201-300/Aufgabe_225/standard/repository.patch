new file mode 100644
index 0000000..2aa5937
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,34 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestKEVEntries(t *testing.T) {
+	added := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	zero := time.Time{}
+	entries := kevEntries(kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", Product: "CISA product", VulnerabilityName: "CISA name", Notes: "note", DateAdded: added, DueDate: zero}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "VC vendor", Product: "VC product", Name: "VC name", Description: "description", RequiredAction: "patch", KnownRansomwareCampaignUse: "Known", DateAdded: added, DueDate: &zero,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "123", XDBURL: "https://example.com/xdb", DateAdded: added, ExploitType: "poc", CloneSSHURL: "ssh://example.com"}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://example.com/report", DateAdded: added}},
+		}},
+	})
+	if len(entries) != 2 || entries[0].Type != models.CISAKEVType || entries[0].CISA.Note != "note" || entries[0].DueDate != nil {
+		t.Fatalf("unexpected CISA entry: %+v", entries)
+	}
+	v := entries[1]
+	if v.Type != models.VulnCheckKEVType || v.VulnCheck == nil || v.DueDate != nil || v.ShortDescription != "description" || v.RequiredAction != "patch" || v.KnownRansomwareCampaignUse != "Known" || v.DateAdded != added {
+		t.Fatalf("unexpected VulnCheck entry: %+v", v)
+	}
+	if len(v.VulnCheck.XDB) != 1 || v.VulnCheck.XDB[0].XDBID != "123" || v.VulnCheck.XDB[0].CloneSSHURL != "ssh://example.com" || len(v.VulnCheck.ReportedExploitation) != 1 || v.VulnCheck.ReportedExploitation[0].URL != "https://example.com/report" {
+		t.Fatalf("missing VulnCheck details: %+v", v.VulnCheck)
+	}
+}
