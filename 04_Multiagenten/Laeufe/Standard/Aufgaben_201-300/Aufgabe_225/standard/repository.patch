+package models
+
+import "testing"
+
+func TestKEVSummaryAndJSONSort(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"CVE-1": {KEVs: []KEV{
+			{Type: VulnCheckKEVType, VulnerabilityName: "Z"},
+			{Type: CISAKEVType, VulnerabilityName: "B"},
+			{Type: CISAKEVType, VulnerabilityName: "A"},
+		}},
+		"CVE-2": {},
+	}}
+	if got := r.FormatKEVCveSummary(); got != "1 KEVs" {
+		t.Fatalf("summary = %q", got)
+	}
+	r.SortForJSONOutput()
+	got := r.ScannedCves["CVE-1"].KEVs
+	if got[0].Type != CISAKEVType || got[0].VulnerabilityName != "A" || got[1].VulnerabilityName != "B" || got[2].Type != VulnCheckKEVType {
+		t.Fatalf("unexpected order: %+v", got)
+	}
+}
