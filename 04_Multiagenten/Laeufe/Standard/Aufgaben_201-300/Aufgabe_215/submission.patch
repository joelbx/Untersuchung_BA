index 0000000..8272ef9
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"fmt"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func configFile(t *testing.T, body string) string {
+	t.Helper()
+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if _, err := f.WriteString(body); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Remove(f.Name()) })
+	return f.Name()
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	cfg, err := configure(configFile(t, "{}\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults differ: %#v", cfg)
+	}
+
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := ioutil.WriteFile(path, []byte("test"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	body := fmt.Sprintf(`log:
+  level: WARN
+ui:
+  enabled: false
+cors:
+  enabled: true
+  allowed_origins: foo.com
+cache:
+  memory:
+    enabled: true
+    items: 5000
+server:
+  host: 127.0.0.1
+  protocol: https
+  http_port: 8081
+  https_port: 8080
+  grpc_port: 9001
+  cert_file: %q
+  cert_key: %q
+db:
+  url: postgres://postgres@localhost:5432/flipt?sslmode=disable
+  migrations:
+    path: ./config/migrations
+`, cert, key)
+	cfg, err = configure(configFile(t, body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled ||
+		!reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) ||
+		!cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 ||
+		cfg.Server != (serverConfig{"127.0.0.1", HTTPS, 8081, 8080, 9001, cert, key}) ||
+		cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" ||
+		cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("advanced config: %#v", cfg)
+	}
+
+	list := strings.Replace(body, "allowed_origins: foo.com", "allowed_origins: [foo.com]", 1)
+	listCfg, err := configure(configFile(t, list))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(listCfg.Cors.AllowedOrigins, cfg.Cors.AllowedOrigins) {
+		t.Fatalf("list origins: %#v, %v", listCfg, err)
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTPS_PORT", "8443"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTPS_PORT")
+	cfg, err = configure(configFile(t, body))
+	if err != nil || cfg.Server.HTTPSPort != 8443 {
+		t.Fatalf("environment override: %#v, %v", cfg, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	checks := []struct {
+		cert, key, want string
+	}{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{"missing", "", "cert_key cannot be empty when using HTTPS"},
+		{"missing", "missing", `cannot find TLS cert_file at "missing"`},
+	}
+	for _, check := range checks {
+		cfg.Server.CertFile, cfg.Server.CertKey = check.cert, check.key
+		if err := cfg.validate(); err == nil || err.Error() != check.want {
+			t.Fatalf("validate(%q, %q): %v", check.cert, check.key, err)
+		}
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("unexpected scheme string")
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []interface {
+		ServeHTTP(http.ResponseWriter, *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		r := httptest.NewRecorder()
+		handler.ServeHTTP(r, httptest.NewRequest("GET", "/", nil))
+		if r.Code != 200 || r.Body.Len() == 0 {
+			t.Fatalf("response: %d, %q", r.Code, r.Body.String())
+		}
+	}
+}
