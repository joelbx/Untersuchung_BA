+// migrateFieldsWithRetry converts legacy JSON fields after the index migration has
+// finished. A backend flag avoids rescanning a completed table on every startup.
+func (l *Log) migrateFieldsWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		if err := l.migrateFields(ctx); err == nil {
+			return
+		} else {
+			l.WithError(err).Error("FieldsMap migration failed; retrying")
+		}
+		select {
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+func (l *Log) migrateFields(ctx context.Context) error {
+	if l.backend == nil {
+		return trace.BadParameter("backend required for FieldsMap migration")
+	}
+	flag := backend.FlagKey("dynamoEvents", l.Tablename, "fieldsMap")
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMigrationLock+"/"+l.Tablename, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		_, err := l.backend.Get(ctx, flag)
+		if err == nil {
+			return nil
+		}
+		if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+		l.Info("Starting DynamoDB FieldsMap migration")
+		var startKey map[string]*dynamodb.AttributeValue
+		total := 0
+		for {
+			scan, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName: aws.String(l.Tablename), ExclusiveStartKey: startKey,
+				ConsistentRead: aws.Bool(true), Limit: aws.Int64(DynamoBatchSize),
+				FilterExpression: aws.String("attribute_exists(Fields) AND attribute_not_exists(FieldsMap)"),
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			requests := make([]*dynamodb.WriteRequest, 0, len(scan.Items))
+			for _, item := range scan.Items {
+				legacy := item["Fields"]
+				if legacy == nil || legacy.S == nil {
+					return trace.BadParameter("event %v/%v has invalid Fields attribute", item[keySessionID], item[keyEventIndex])
+				}
+				av, err := fieldsAttribute([]byte(*legacy.S))
+				if err != nil {
+					return trace.WrapWithMessage(err, "converting event %v/%v", item[keySessionID], item[keyEventIndex])
+				}
+				var before, after interface{}
+				decoder := json.NewDecoder(strings.NewReader(*legacy.S))
+				decoder.UseNumber()
+				if err := decoder.Decode(&before); err != nil {
+					return trace.Wrap(err)
+				}
+				attrDecoder := dynamodbattribute.NewDecoder(func(d *dynamodbattribute.Decoder) { d.UseNumber = true })
+				if err := attrDecoder.Decode(av, &after); err != nil {
+					return trace.Wrap(err)
+				}
+				after = normalizeNumbers(after)
+				if !reflect.DeepEqual(before, after) {
+					return trace.BadParameter("FieldsMap validation failed for event %v/%v", item[keySessionID], item[keyEventIndex])
+				}
+				item["FieldsMap"] = av
+				delete(item, "Fields")
+				requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+			}
+			if len(requests) != 0 {
+				if err := l.uploadMigrationBatch(ctx, requests); err != nil {
+					return trace.Wrap(err)
+				}
+				total += len(requests)
+				l.Infof("Migrated %d DynamoDB events to FieldsMap", total)
+			}
+			startKey = scan.LastEvaluatedKey
+			if len(startKey) == 0 {
+				break
+			}
+			if err := ctx.Err(); err != nil {
+				return trace.Wrap(err)
+			}
+		}
+		if _, err := l.backend.Put(ctx, backend.Item{Key: flag, Value: []byte("complete")}); err != nil {
+			return trace.Wrap(err)
+		}
+		l.Infof("Completed DynamoDB FieldsMap migration (%d events)", total)
+		return nil
+	})
+}
+
+// uploadMigrationBatch retries unprocessed writes with backoff and observes cancellation.
+func (l *Log) uploadMigrationBatch(ctx context.Context, requests []*dynamodb.WriteRequest) error {
+	delay := 100 * time.Millisecond
+	for len(requests) != 0 {
+		out, err := l.svc.BatchWriteItemWithContext(ctx, &dynamodb.BatchWriteItemInput{
+			RequestItems: map[string][]*dynamodb.WriteRequest{l.Tablename: requests},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		requests = out.UnprocessedItems[l.Tablename]
+		if len(requests) == 0 {
+			return nil
+		}
+		select {
+		case <-time.After(delay):
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		}
+		if delay < 2*time.Second {
+			delay *= 2
+		}
+	}
+	return nil
+}
