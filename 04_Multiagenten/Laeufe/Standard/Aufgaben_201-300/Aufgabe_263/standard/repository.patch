+// decodeFields preserves JSON numbers and empty strings when storing event metadata.
+func decodeFields(data []byte) (map[string]interface{}, error) {
+	var fields map[string]interface{}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	return fields, nil
+}
+
+func fieldAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch v := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(v)}, nil
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(v)}, nil
+	case json.Number:
+		if _, err := strconv.ParseFloat(string(v), 64); err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return &dynamodb.AttributeValue{N: aws.String(string(v))}, nil
+	case []interface{}:
+		out := make([]*dynamodb.AttributeValue, 0, len(v))
+		for _, entry := range v {
+			av, err := fieldAttribute(entry)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out = append(out, av)
+		}
+		return &dynamodb.AttributeValue{L: out}, nil
+	case map[string]interface{}:
+		out := make(map[string]*dynamodb.AttributeValue, len(v))
+		for key, entry := range v {
+			av, err := fieldAttribute(entry)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out[key] = av
+		}
+		return &dynamodb.AttributeValue{M: out}, nil
+	default:
+		return nil, trace.BadParameter("unsupported event field type %T", value)
+	}
+}
+
+func fieldsAttribute(data []byte) (*dynamodb.AttributeValue, error) {
+	fields, err := decodeFields(data)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return fieldAttribute(fields)
+}
+
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	fields := e.FieldsMap
+	e.FieldsMap = nil
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields != nil {
+		av, err := fieldAttribute(fields)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		item["FieldsMap"] = av
+	}
+	return item, nil
+}
+
+func normalizeNumbers(value interface{}) interface{} {
+	switch v := value.(type) {
+	case dynamodbattribute.Number:
+		return json.Number(v)
+	case map[string]interface{}:
+		for key, entry := range v {
+			v[key] = normalizeNumbers(entry)
+		}
+	case []interface{}:
+		for i, entry := range v {
+			v[i] = normalizeNumbers(entry)
+		}
+	}
+	return value
+}
+
+func unmarshalEvent(item map[string]*dynamodb.AttributeValue, e *event) error {
+	metadata := make(map[string]*dynamodb.AttributeValue, len(item))
+	for key, av := range item {
+		if key != "FieldsMap" {
+			metadata[key] = av
+		}
+	}
+	if err := dynamodbattribute.UnmarshalMap(metadata, e); err != nil {
+		return trace.Wrap(err)
+	}
+	if av := item["FieldsMap"]; av != nil {
+		if av.M == nil {
+			return trace.BadParameter("event FieldsMap is not a map")
+		}
+		var fields map[string]interface{}
+		decoder := dynamodbattribute.NewDecoder(func(d *dynamodbattribute.Decoder) { d.UseNumber = true })
+		if err := decoder.Decode(av, &fields); err != nil {
+			return trace.Wrap(err)
+		}
+		fields = normalizeNumbers(fields).(map[string]interface{})
+		data, err := json.Marshal(fields)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		e.FieldsMap = fields
+		e.Fields = string(data)
+	}
+	return nil
+}
