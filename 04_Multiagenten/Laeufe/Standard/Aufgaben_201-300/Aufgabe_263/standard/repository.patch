+func TestFieldsMapConversion(t *testing.T) {
+	original := []byte(`{"large":9007199254740993,"empty":"","nested":{"list":[true,null,3.25,[],{}]}}`)
+	fields, err := decodeFields(original)
+	require.NoError(t, err)
+	item, err := marshalEvent(event{SessionID: "session", EventIndex: 1, FieldsMap: fields})
+	require.NoError(t, err)
+	require.NotContains(t, item, "Fields")
+	require.Equal(t, "9007199254740993", aws.StringValue(item["FieldsMap"].M["large"].N))
+	require.Equal(t, "", aws.StringValue(item["FieldsMap"].M["empty"].S))
+	var got event
+	require.NoError(t, unmarshalEvent(item, &got))
+	expected, err := decodeFields(original)
+	require.NoError(t, err)
+	actual, err := decodeFields([]byte(got.Fields))
+	require.NoError(t, err)
+	require.Equal(t, expected, actual)
+
+	legacy := event{SessionID: "session", EventIndex: 2, Fields: string(original)}
+	legacyItem, err := dynamodbattribute.MarshalMap(legacy)
+	require.NoError(t, err)
+	require.NoError(t, unmarshalEvent(legacyItem, &got))
+	require.Equal(t, string(original), got.Fields)
