@@ -402,7 +402,32 @@ func (a AuthenticationMethodOIDCConfig) info() AuthenticationMethodInfo {
 	return info
 }
 
-func (a AuthenticationMethodOIDCConfig) validate() error { return nil }
+func (a AuthenticationMethodOIDCConfig) validate() error {
+	for provider, config := range a.Providers {
+		if err := validateOAuthCredentials(provider, config.ClientID, config.ClientSecret, config.RedirectAddress); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+func validateOAuthCredentials(provider, clientID, clientSecret, redirectAddress string) error {
+	for _, field := range []struct {
+		name  string
+		value string
+	}{
+		{"client_id", clientID},
+		{"client_secret", clientSecret},
+		{"redirect_address", redirectAddress},
+	} {
+		if strings.TrimSpace(field.value) == "" {
+			return fmt.Errorf("provider %q: %w", provider, errFieldRequired(field.name))
+		}
+	}
+
+	return nil
+}
 
