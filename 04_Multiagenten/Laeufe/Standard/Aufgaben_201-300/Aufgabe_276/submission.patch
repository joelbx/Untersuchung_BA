diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..805e70c
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,49 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLoadOAuthAuthenticationValidation(t *testing.T) {
+	tests := []struct {
+		name    string
+		method  string
+		wantErr string
+	}{
+		{"github missing client id", "github:\n      enabled: true\n      client_secret: secret\n      redirect_address: http://localhost/callback", `provider "github": field "client_id": non-empty value is required`},
+		{"github missing client secret", "github:\n      enabled: true\n      client_id: id\n      redirect_address: http://localhost/callback", `provider "github": field "client_secret": non-empty value is required`},
+		{"github missing redirect address", "github:\n      enabled: true\n      client_id: id\n      client_secret: secret", `provider "github": field "redirect_address": non-empty value is required`},
+		{"github whitespace client id", "github:\n      enabled: true\n      client_id: '   '\n      client_secret: secret\n      redirect_address: http://localhost/callback", `provider "github": field "client_id": non-empty value is required`},
+		{"github missing org scope", "github:\n      enabled: true\n      client_id: id\n      client_secret: secret\n      redirect_address: http://localhost/callback\n      allowed_organizations: [flipt]", `provider "github": field "scopes": must contain read:org when allowed_organizations is not empty`},
+		{"github valid org scope", "github:\n      enabled: true\n      client_id: id\n      client_secret: secret\n      redirect_address: http://localhost/callback\n      allowed_organizations: [flipt]\n      scopes: [read:org]", ""},
+		{"github disabled", "github:\n      enabled: false", ""},
+		{"oidc missing client id", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_secret: secret\n          redirect_address: http://localhost/callback", `provider "foo": field "client_id": non-empty value is required`},
+		{"oidc missing client secret", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          redirect_address: http://localhost/callback", `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc missing redirect address", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          client_secret: secret", `provider "foo": field "redirect_address": non-empty value is required`},
+		{"oidc whitespace client secret", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          client_secret: '  '\n          redirect_address: http://localhost/callback", `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc valid", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          client_secret: secret\n          redirect_address: http://localhost/callback", ""},
+		{"oidc disabled", "oidc:\n      enabled: false\n      providers:\n        foo: {}", ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			config := fmt.Sprintf("authentication:\n  session:\n    domain: localhost\n  methods:\n    %s\n", tt.method)
+			require.NoError(t, os.WriteFile(path, []byte(config), 0600))
+
+			result, err := Load(path)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				require.Nil(t, result)
+				return
+			}
+			require.NoError(t, err)
+			require.NotNil(t, result)
+		})
+	}
+}
