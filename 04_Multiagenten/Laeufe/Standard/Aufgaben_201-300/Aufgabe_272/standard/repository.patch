+@pytest.mark.parametrize('ciphers', [
+    'ECDHE-RSA-AES128-SHA256',
+    ['ECDHE-RSA-AES128-SHA256', 'ECDHE-RSA-AES256-SHA384'],
+])
+def test_make_context_ciphers(ciphers, mocker):
+    context = mocker.Mock()
+    create = mocker.patch.object(urls, 'create_default_context', return_value=context)
+    urls.make_context(ciphers=ciphers)
+    create.assert_called_once_with(cafile=None)
+    expected = ':'.join(ciphers) if isinstance(ciphers, list) else ciphers
+    context.set_ciphers.assert_called_once_with(expected)
+
+
+@pytest.mark.parametrize('ciphers', ['', [], [42], 42, 'INVALID-CIPHER'])
+def test_make_context_invalid_ciphers(ciphers):
+    with pytest.raises(ValueError, match='ciphers|TLS ciphers'):
+        urls.make_context(ciphers=ciphers)
+
+
+def test_make_context_without_verification_preserves_protocol_options():
+    context = urls.make_context(ciphers='ECDHE-RSA-AES128-SHA256', validate_certs=False)
+    assert context.verify_mode == urls.ssl.CERT_NONE
+    assert context.options & urls.ssl.OP_NO_SSLv3
+    if urls.ssl.OP_NO_SSLv2:
+        assert context.options & urls.ssl.OP_NO_SSLv2
