+def test_Request_ciphers_context_on_https_handlers(urlopen_mock, install_opener_mock, url, options):
+    cipher = 'ECDHE-RSA-AES128-SHA256'
+    Request().open('GET', url, ciphers=[cipher], **options)
+    opener = install_opener_mock.call_args[0][0]
+    handlers = [handler for handler in opener.handlers if isinstance(handler, urllib_request.HTTPSHandler)]
