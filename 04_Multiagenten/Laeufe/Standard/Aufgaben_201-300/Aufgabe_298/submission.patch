+// evictExpired limits full cache sweeps while allowing a newly inserted item
+// to bring the next sweep forward to its expiration time.
+func (c *simpleCache[K, V]) evictExpired() {
+	now := time.Now()
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && now.Before(*deadline) {
+			return
+		}
+		next := now.Add(time.Second)
+		if c.evictionDeadline.CompareAndSwap(deadline, &next) {
+			c.data.DeleteExpired()
+			return
+		}
+	}
+}
+
+func (c *simpleCache[K, V]) scheduleExpiration(item *ttlcache.Item[K, V]) {
+	expiresAt := item.ExpiresAt()
+	if expiresAt.IsZero() {
+		return
+	}
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && !expiresAt.Before(*deadline) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(deadline, &expiresAt) {
+			return
+		}
+	}
 }
 
