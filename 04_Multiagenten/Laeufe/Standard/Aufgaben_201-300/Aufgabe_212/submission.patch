@@ -6,10 +6,84 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	for _, tt := range []struct {
+		name         string
+		optional     string
+		wantSummary  string
+		wantOptional map[string]string
+		wantScore    float64
+		wantVector   string
+		wantSeverity string
+		wantFix      string
+	}{
+		{
+			name:         "enterprise",
+			optional:     `,"description":"A detailed summary","poc":"https://example.org/poc","introduced_in":"6.0","cvss":{"score":8.8,"vector":"CVSS:3.1/AV:N/AC:L","severity":"high"},"fixed_in":"6.2.1"`,
+			wantSummary:  "A detailed summary",
+			wantOptional: map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.0"},
+			wantScore:    8.8,
+			wantVector:   "CVSS:3.1/AV:N/AC:L",
+			wantSeverity: "high",
+			wantFix:      "6.2.1",
+		},
+		{
+			name:         "null optional fields",
+			optional:     `,"description":null,"poc":null,"introduced_in":null,"cvss":null,"fixed_in":null`,
+			wantOptional: map[string]string{},
+		},
+		{
+			name:         "omitted optional fields",
+			wantOptional: map[string]string{},
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"6.2":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2023-01-02T03:04:05+02:00","updated_at":"2023-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2023-1234","2023-5678"],"url":["https://example.org/first","https://example.org/second"]}` + tt.optional + `}]}}`
+			vinfos, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d records, want one", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2023-1234" || v.VulnType != "XSS" {
+				t.Fatalf("identity or type: %+v", v)
+			}
+			if len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].FixedIn != tt.wantFix {
+				t.Fatalf("fix: %+v", v.WpPackageFixStats)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("WPScan contents: %+v", contents)
+			}
+			c := contents[0]
+			if c.Type != models.WpScan || c.CveID != v.CveID || c.Title != "Example" || c.Summary != tt.wantSummary {
+				t.Fatalf("content: %+v", c)
+			}
+			published := time.Date(2023, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2023, 2, 3, 2, 5, 6, 0, time.UTC)
+			if !c.Published.Equal(published) || c.Published.Location() != time.UTC || !c.LastModified.Equal(modified) || c.LastModified.Location() != time.UTC {
+				t.Fatalf("times: %v %v", c.Published, c.LastModified)
+			}
+			if !reflect.DeepEqual(c.References, models.References{{Link: "https://example.org/first"}, {Link: "https://example.org/second"}}) {
+				t.Fatalf("references: %+v", c.References)
+			}
+			if !reflect.DeepEqual(c.Optional, tt.wantOptional) {
+				t.Fatalf("optional: %+v", c.Optional)
+			}
+			if c.Cvss3Score != tt.wantScore || c.Cvss3Vector != tt.wantVector || c.Cvss3Severity != tt.wantSeverity {
+				t.Fatalf("CVSS: %+v", c)
+			}
+		})
+	}
+}
