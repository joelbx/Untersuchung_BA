+func TestFeaturesValidator_MultipleErrors(t *testing.T) {
+	v, err := NewFeaturesValidator()
+	require.NoError(t, err)
+
+	input := []byte(`flags:
+- ey: bad
+  nabled: true
+  escription: bad
+  key: example
+  name: Example
+  enabled: true
+  variants: []
+  rules:
+  - segment: users
+    rank: 1
+    distributions:
+    - variant: example
+      rollout: 110
+segments: []
+`)
+	result, err := v.Validate("features.yaml", input)
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.Len(t, result.Errors, 4)
+	for i, want := range []struct {
+		path string
+		line int
+		col  int
+	}{
+		{"flags.0.ey", 2, 4},
+		{"flags.0.nabled", 3, 4},
+		{"flags.0.escription", 4, 4},
+		{"flags.0.rules.0.distributions.0.rollout", 14, 17},
+	} {
+		require.Equal(t, want.path, result.Errors[i].Path)
+		require.Equal(t, Location{File: "features.yaml", Line: want.line, Column: want.col}, result.Errors[i].Location)
+	}
+	require.Contains(t, result.Errors[3].Message, "out of bound <=100")
+
+	var output bytes.Buffer
+	require.NoError(t, writeErrorDetails(jsonFormat, result, &output))
+	var decoded Result
+	require.NoError(t, json.Unmarshal(output.Bytes(), &decoded))
+	require.Equal(t, result, decoded)
+
+	output.Reset()
+	require.NoError(t, writeErrorDetails(textFormat, result, &output))
+	require.Contains(t, output.String(), "features.yaml:2:4: flags.0.ey: field not allowed")
+}
+
+func TestValidateFiles_ReportsFailure(t *testing.T) {
+	var output bytes.Buffer
+	err := ValidateFiles(&output, []string{"fixtures/invalid.yaml"}, jsonFormat)
+	require.True(t, errors.Is(err, ErrValidationFailed))
+	require.True(t, strings.Contains(output.String(), "rollout"))
+	require.True(t, strings.Contains(output.String(), "fixtures/invalid.yaml"))
+}
+
+func TestValidateFiles_JSONSuccess(t *testing.T) {
+	var output bytes.Buffer
+	require.NoError(t, ValidateFiles(&output, []string{"fixtures/valid.yaml"}, jsonFormat))
+	require.JSONEq(t, `{"errors":[]}`, output.String())
+}
+
+func TestFeaturesValidator_InvalidYAMLLocation(t *testing.T) {
+	v, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	result, err := v.Validate("broken.yaml", []byte("flags: [\n"))
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.NotEmpty(t, result.Errors)
+	require.Equal(t, "broken.yaml", result.Errors[0].Location.File)
+	require.Positive(t, result.Errors[0].Location.Line)
+	require.Positive(t, result.Errors[0].Location.Column)
+}
