index 0000000..e500a9c
--- /dev/null
+++ b/applications/mail/src/app/hooks/useShouldMoveOut.test.ts
@@ -0,0 +1,42 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { useShouldMoveOut } from './useShouldMoveOut';
+
+describe('useShouldMoveOut', () => {
+    const onBack = jest.fn();
+
+    beforeEach(() => onBack.mockClear());
+
+    it('waits for the elements list before evaluating the active ID', () => {
+        const { rerender } = renderHook(
+            ({ elementID, elementIDs, loadingElements }) =>
+                useShouldMoveOut({ elementID, elementIDs, loadingElements, onBack }),
+            { initialProps: { elementID: 'message', elementIDs: [] as string[], loadingElements: true } }
+        );
+
+        expect(onBack).not.toHaveBeenCalled();
+
+        rerender({ elementID: 'message', elementIDs: ['message'], loadingElements: false });
+        expect(onBack).not.toHaveBeenCalled();
+
+        rerender({ elementID: 'message', elementIDs: [], loadingElements: false });
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([
+        [undefined, ['message']],
+        ['', ['message']],
+        ['message', []],
+        ['message', ['other']],
+    ])('moves back when %s is absent from %j', (elementID, elementIDs) => {
+        renderHook(() => useShouldMoveOut({ elementID, elementIDs, loadingElements: false, onBack }));
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it('stays when the active ID belongs to the current list', () => {
+        renderHook(() =>
+            useShouldMoveOut({ elementID: 'message', elementIDs: ['other', 'message'], loadingElements: false, onBack })
+        );
+        expect(onBack).not.toHaveBeenCalled();
+    });
+});
