+		return "[REDACTED]"
+	}
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		redacted := make(map[string]interface{}, v.Len())
+		for _, mapKey := range v.MapKeys() {
+			k := fmt.Sprint(mapKey.Interface())
+			redacted[k] = redactValue(k, v.MapIndex(mapKey).Interface(), re)
+		}
+		return redacted
+	}
+	if str, ok := value.(string); ok {
+		return re.ReplaceAllString(str, "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
