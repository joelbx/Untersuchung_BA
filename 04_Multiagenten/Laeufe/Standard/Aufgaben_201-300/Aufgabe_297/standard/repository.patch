+	}}
+	hook := &Hook{RedactionList: []string{`(?i)^(token|secret)$`}}
+	assert.NoError(t, hook.Fire(entry))
+	config := entry.Data["config"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", config["auth"].(map[string]interface{})["token"])
+	assert.Equal(t, "alice", config["auth"].(map[string]interface{})["username"])
+	assert.Equal(t, "[REDACTED]", config["metadata"].(map[string]interface{})["secret"])
+	assert.Equal(t, "public", config["metadata"].(map[string]interface{})["name"])
+}
