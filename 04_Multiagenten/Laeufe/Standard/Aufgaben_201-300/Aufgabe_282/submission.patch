+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Display a JavaScript log message in the UI if enabled and not excluded."""
+    levels_config = config.cache['content.javascript.log_message.levels'] or {}
+    if not any(fnmatch.fnmatchcase(source, pattern) and level.name in levels
+               for pattern, levels in levels_config.items()):
+        return False
+
+    excludes = config.cache['content.javascript.log_message.excludes'] or {}
+    if any(fnmatch.fnmatchcase(source, pattern) and
+           any(fnmatch.fnmatchcase(msg, excluded) for excluded in patterns)
+           for pattern, patterns in excludes.items()):
+        return False
+
+    _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+    return True
+
