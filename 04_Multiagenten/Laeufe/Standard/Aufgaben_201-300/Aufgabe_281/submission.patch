 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const normalizeBulkIncrements = require('../bulk-increments');
+	const bulkIncrementScript = `
+for i = 1, #ARGV, 2 do
+	local current = redis.call('HGET', KEYS[1], ARGV[i])
+	if current then
+		local number = tonumber(current)
+		local increment = tonumber(ARGV[i + 1])
+		if not number or not string.match(current, '^%-?%d+$') or
+			math.abs(number + increment) > 9007199254740991 then
+			return redis.error_reply('Invalid existing value for increment field')
+		end
+	end
+end
+for i = 1, #ARGV, 2 do
+	redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+end
+return 1`;
 
 	const cache = require('../cache').create('redis');
 
@@ -199,6 +216,27 @@ module.exports = function (module) {
