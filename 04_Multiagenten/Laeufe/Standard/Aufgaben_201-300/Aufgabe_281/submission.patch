+	module.incrObjectFieldByBulk = async function (data) {
+		const entries = normalizeBulkIncrements(data, helpers.fieldToString);
+		if (!entries.length) {
+			return;
+		}
+		const bulk = module.client.collection('objects').initializeUnorderedBulkOp();
+		entries.forEach(([key, increments]) => {
+			bulk.find({ _key: key }).upsert().updateOne({ $inc: increments });
+		});
+		try {
+			await bulk.execute();
+			cache.del(entries.map(([key]) => key));
+		} catch (err) {
+			// Unordered bulk writes continue after a field error. Evict only keys whose
+			// writes succeeded; a failed key has not changed any of its fields.
+			const writeErrors = err.writeErrors || (err.result && err.result.getWriteErrors && err.result.getWriteErrors());
+			if (Array.isArray(writeErrors)) {
+				const failed = new Set(writeErrors.map(error => error.index));
+				const duplicates = writeErrors.filter(error => error.code === 11000);
+				const retries = await Promise.allSettled(duplicates.map((error) => {
+					const [key, increments] = entries[error.index];
+					return module.client.collection('objects').updateOne(
+						{ _key: key }, { $inc: increments }, { upsert: true }
+					);
+				}));
+				retries.forEach((result, index) => {
+					if (result.status === 'fulfilled') {
+						failed.delete(duplicates[index].index);
+					}
+				});
+				const succeeded = entries.filter((entry, index) => !failed.has(index)).map(([key]) => key);
+				if (succeeded.length) {
+					cache.del(succeeded);
+				}
+				if (!failed.size) {
+					return;
+				}
+			}
+			throw err;
+		}
+	};
+
 	module.decrObjectField = async function (key, field) {
 		return await module.incrObjectFieldBy(key, field, -1);
 	};
