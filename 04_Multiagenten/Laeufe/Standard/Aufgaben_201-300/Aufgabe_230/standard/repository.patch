+def test_prioritized_identifier_equality_and_json() -> None:
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    first = PrioritizedIdentifier("B06XYHVXVJ", False, Priority.HIGH, timestamp)
+    duplicate = PrioritizedIdentifier(
+        "B06XYHVXVJ", True, Priority.LOW, timestamp + timedelta(seconds=1)
+    )
+    isbn = PrioritizedIdentifier("9780747532699")
+
+    assert first == duplicate
+    assert len({first, duplicate, isbn}) == 2
+    assert first != isbn
+    assert json.loads(json.dumps(first.to_dict())) == {
+        "identifier": "B06XYHVXVJ",
+        "stage_import": False,
+        "priority": "HIGH",
+        "timestamp": "2024-01-02T03:04:05",
+    }
+    assert PrioritizedISBN(isbn="B06XYHVXVJ") == first
+
+
+def test_process_amazon_batch_only_stages_requested_identifiers(monkeypatch) -> None:
+    products = [
