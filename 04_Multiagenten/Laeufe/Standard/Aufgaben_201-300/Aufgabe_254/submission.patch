+func TestInstanceMetadataClientIsAvailable(t *testing.T) {
+	tests := []struct {
+		name      string
+		body      string
+		status    int
+		available bool
+	}{
+		{name: "short instance ID", body: "i-1a2b3c4d", available: true},
+		{name: "long instance ID", body: "i-1234567890abcdef0", available: true},
+		{name: "captive portal", body: "<!DOCTYPE html><html>Login</html>", available: false},
+		{name: "invalid length", body: "i-123456789", available: false},
+		{name: "uppercase hex", body: "i-1A2B3C4D", available: false},
+		{name: "trailing newline", body: "i-1a2b3c4d\n", available: false},
+		{name: "metadata error", status: http.StatusNotFound, available: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/latest/meta-data/instance-id" {
+					http.NotFound(w, r)
+					return
+				}
+				if tt.status != 0 {
+					w.WriteHeader(tt.status)
+				}
+				_, _ = w.Write([]byte(tt.body))
+			}))
+			defer server.Close()
+
+			imdsClient := imds.New(imds.Options{Endpoint: server.URL})
+			client := &InstanceMetadataClient{}
+			require.NoError(t, WithIMDSClient(imdsClient)(client))
+			assert.Equal(t, tt.available, client.IsAvailable(context.Background()))
+		})
+	}
+}
+
+func TestInstanceMetadataClientIsAvailableTimeout(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	client := &InstanceMetadataClient{c: imds.New(imds.Options{Endpoint: server.URL})}
+	start := time.Now()
+	assert.False(t, client.IsAvailable(context.Background()))
+	assert.Less(t, time.Since(start), time.Second)
+}
+
+func TestNewInstanceMetadataClientOptions(t *testing.T) {
+	// Keep the default config loader away from local AWS configuration files.
+	t.Setenv("AWS_CONFIG_FILE", t.TempDir()+"/config")
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", t.TempDir()+"/credentials")
+	imdsClient := imds.New(imds.Options{})
+	client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(imdsClient))
+	require.NoError(t, err)
+	assert.Same(t, imdsClient, client.c)
+
+	wantErr := errors.New("option failed")
+	_, err = NewInstanceMetadataClient(context.Background(), func(*InstanceMetadataClient) error {
+		return wantErr
+	})
+	require.ErrorIs(t, err, wantErr)
+}
