+def _validate_extract_path(filename, b_dest):
+    b_dest_filepath = os.path.abspath(os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict')))
+    b_root = os.path.abspath(b_dest)
+    if os.path.commonpath((b_dest_filepath, b_root)) != b_root or not _is_child_path(os.path.dirname(b_dest_filepath), b_root):
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % to_native(filename, errors='surrogate_or_strict'))
+    return b_dest_filepath
+
+
+def _extract_tar_dir(tar, filename, b_dest):
+    b_dest_filepath = _validate_extract_path(filename, b_dest)
+    member = tar.getmember(to_native(filename, errors='surrogate_or_strict'))
+    if member.issym():
+        b_linkname = to_bytes(member.linkname, errors='surrogate_or_strict')
+        if not _is_child_path(b_dest_filepath, b_dest, b_linkname):
+            raise AnsibleError("Cannot extract tar entry '%s' as its link target is outside the collection directory"
+                               % to_native(filename, errors='surrogate_or_strict'))
+        b_parent_dir = os.path.dirname(b_dest_filepath)
+        if not os.path.exists(b_parent_dir):
+            os.makedirs(b_parent_dir, mode=0o0755)
+        os.symlink(b_linkname, b_dest_filepath)
+    elif member.isdir():
+        if not os.path.exists(b_dest_filepath):
+            os.makedirs(b_dest_filepath, mode=0o0755)
+    else:
+        raise AnsibleError("Cannot extract tar entry '%s' as a directory" % to_native(filename, errors='surrogate_or_strict'))
+
+
