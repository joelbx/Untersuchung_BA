+def test_build_and_install_symlinks(collection_input):
+    input_dir, output_dir = collection_input
+    os.symlink(os.path.join(input_dir, 'roles', 'common'), os.path.join(input_dir, 'roles', 'alias'))
+    os.symlink(os.path.join(input_dir, 'README.md'), os.path.join(input_dir, 'docs', 'readme-link'))
+
+    collection.build_collection(input_dir, output_dir, False)
+    artifact = os.path.join(output_dir, 'ansible_namespace-collection-0.1.0.tar.gz')
+    requirement = collection.CollectionRequirement.__new__(collection.CollectionRequirement)
+    requirement.b_path = artifact
+    destination = to_bytes(os.path.join(output_dir, 'installed', 'collection'))
+    os.mkdir(os.path.dirname(destination))
+    requirement.install_artifact(destination, to_bytes(output_dir))
+
+    assert os.path.islink(os.path.join(destination, b'roles', b'alias'))
+    assert os.readlink(os.path.join(destination, b'roles', b'alias')) == b'common'
+    assert os.path.islink(os.path.join(destination, b'docs', b'readme-link'))
+    assert os.readlink(os.path.join(destination, b'docs', b'readme-link')) == b'../README.md'
+
+
+def test_build_external_file_symlink_is_regular(collection_input):
+    input_dir, output_dir = collection_input
+    external_file = os.path.join(output_dir, 'external.txt')
+    with open(external_file, 'w') as stream:
+        stream.write('external content')
+    os.symlink(external_file, os.path.join(input_dir, 'docs', 'external.txt'))
+
+    collection.build_collection(input_dir, output_dir, False)
+    artifact = os.path.join(output_dir, 'ansible_namespace-collection-0.1.0.tar.gz')
+    with tarfile.open(artifact) as archive:
+        member = archive.getmember('docs/external.txt')
+        assert member.isreg()
+        assert archive.extractfile(member).read() == b'external content'
+
+
+def test_is_child_path_rejects_sibling_and_escaping_link(tmp_path):
+    root = to_bytes(tmp_path / 'collection')
+    sibling = to_bytes(tmp_path / 'collection-other')
+    os.mkdir(root)
+    os.mkdir(sibling)
+    assert collection._is_child_path(os.path.join(root, b'file'), root)
+    assert not collection._is_child_path(os.path.join(sibling, b'file'), root)
+    assert not collection._is_child_path(os.path.join(root, b'link'), root, b'../collection-other/file')
+
+
+def test_extract_tar_dir_rejects_escaping_symlink(tmp_path):
+    archive_path = to_bytes(tmp_path / 'collection.tar')
+    destination = to_bytes(tmp_path / 'collection')
+    os.mkdir(destination)
+    with tarfile.open(archive_path, 'w') as archive:
+        member = tarfile.TarInfo('roles/escape')
+        member.type = tarfile.SYMTYPE
+        member.linkname = '../../outside'
+        archive.addfile(member)
+
+    with tarfile.open(archive_path) as archive:
+        with pytest.raises(AnsibleError, match='link target is outside the collection directory'):
+            collection._extract_tar_dir(archive, 'roles/escape', destination)
+    assert not os.path.lexists(os.path.join(destination, b'roles', b'escape'))
+
+
