@@ -0,0 +1,106 @@
+package config
+
+import (
+	"strings"
+	"time"
+)
+
+// OS family identifiers used by scan results and lifecycle lookup.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// Major removes an optional epoch and returns the first version component.
+func Major(version string) string {
+	if i := strings.IndexByte(version, ':'); i >= 0 {
+		version = version[i+1:]
+	}
+	return strings.SplitN(version, ".", 2)[0]
+}
+
+// EOL describes the end of standard and optional extended OS support.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support has passed its end date.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether applicable extended support has passed its end date.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+func eol(standard, extended string) EOL {
+	s, _ := time.Parse("2006-01-02", standard)
+	e := EOL{StandardSupportUntil: s}
+	if extended != "" {
+		e.ExtendedSupportUntil, _ = time.Parse("2006-01-02", extended)
+		e.Ended = standard == extended
+	}
+	return e
+}
+
+var osEOL = map[string]map[string]EOL{
+	Amazon: {
+		"2018.03":   eol("2023-06-30", "2023-06-30"),
+		"2 (Karoo)": eol("2025-06-30", ""),
+	},
+	RedHat: {
+		"7": eol("2024-06-30", ""), "8": eol("2029-05-31", ""),
+		"6": eol("2020-11-30", "2024-06-30"),
+	},
+	CentOS: {
+		"7": eol("2024-06-30", ""), "8": eol("2021-12-31", ""),
+		"6": eol("2020-11-30", "2020-11-30"),
+	},
+	Oracle: {
+		"7": eol("2024-06-30", ""), "8": eol("2029-05-31", ""),
+		"6": eol("2021-03-31", "2022-03-31"),
+	},
+	Ubuntu: {
+		"18.04": eol("2023-05-31", "2028-04-30"),
+		"14.04": eol("2019-04-30", "2024-04-30"),
+		"14.10": eol("2015-07-30", "2015-07-30"),
+		"21.04": eol("2022-01-30", ""),
+	},
+	Debian: {
+		"9": eol("2022-06-30", ""), "10": eol("2024-06-30", ""),
+		"8": eol("2020-06-30", "2020-06-30"),
+	},
+	Alpine: {
+		"3.10": eol("2021-05-30", ""), "3.11": eol("2021-11-30", ""),
+		"3.12": eol("2022-05-30", ""), "3.9": eol("2020-11-30", "2020-11-30"),
+	},
+	FreeBSD: {
+		"11": eol("2021-09-30", "2021-09-30"),
+		"12": eol("2023-12-31", ""),
+		"10": eol("2019-10-30", "2019-10-30"),
+	},
+}
+
+// GetEOL looks up the exact OS family and release identifier.
+func GetEOL(family string, release string) (EOL, bool) {
+	e, found := osEOL[family][release]
+	return e, found
+}
