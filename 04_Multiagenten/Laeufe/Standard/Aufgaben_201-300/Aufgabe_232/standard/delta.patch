diff --git a/scan/eol.go b/scan/eol.go
new file mode 100644
index 0000000..85462f6
--- /dev/null
+++ b/scan/eol.go
@@ -0,0 +1,49 @@
+package scan
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+// eolWarnings evaluates a target at the supplied time, retaining message order.
+func eolWarnings(family, release string, now time.Time) []string {
+	if family == config.ServerTypePseudo || family == config.Raspbian {
+		return nil
+	}
+	key := release
+	switch family {
+	case config.RedHat, config.CentOS, config.Oracle, config.Debian, config.FreeBSD:
+		key = config.Major(release)
+	case config.Ubuntu, config.Alpine:
+		parts := strings.Split(release, ".")
+		if len(parts) > 1 {
+			key = parts[0] + "." + parts[1]
+		}
+	case config.Amazon:
+		if fields := strings.Fields(release); len(fields) > 1 && fields[0] == "2" {
+			key = "2 (Karoo)"
+		}
+	}
+	e, found := config.GetEOL(family, key)
+	if !found {
+		return []string{fmt.Sprintf("Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: %s Release: %s'", family, release)}
+	}
+	if e.IsStandardSupportEnded(now) {
+		warnings := []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended."}
+		if !e.ExtendedSupportUntil.IsZero() {
+			if e.IsExtendedSuppportEnded(now) {
+				warnings = append(warnings, "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.")
+			} else {
+				warnings = append(warnings, fmt.Sprintf("Extended support available until %s. Check the vendor site.", e.ExtendedSupportUntil.Format("2006-01-02")))
+			}
+		}
+		return warnings
+	}
+	if !now.AddDate(0, 3, 0).Before(e.StandardSupportUntil) {
+		return []string{fmt.Sprintf("Standard OS support will be end in 3 months. EOL date: %s", e.StandardSupportUntil.Format("2006-01-02"))}
+	}
+	return nil
+}
diff --git a/scan/eol_test.go b/scan/eol_test.go
new file mode 100644
index 0000000..eaa9910
--- /dev/null
+++ b/scan/eol_test.go
@@ -0,0 +1,29 @@
+package scan
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestEOLWarnings(t *testing.T) {
+	date := func(s string) time.Time { d, _ := time.Parse("2006-01-02", s); return d }
+	tests := []struct {
+		family, release, now string
+		want                 []string
+	}{
+		{config.Ubuntu, "14.10", "2016-01-01", []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.", "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended."}},
+		{config.Ubuntu, "18.04", "2023-06-01", []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.", "Extended support available until 2028-04-30. Check the vendor site."}},
+		{config.FreeBSD, "11", "2021-07-01", []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"}},
+		{config.Ubuntu, "12.10", "2021-07-01", []string{"Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: ubuntu Release: 12.10'"}},
+		{config.ServerTypePseudo, "", "2021-07-01", nil},
+	}
+	for _, tt := range tests {
+		got := eolWarnings(tt.family, tt.release, date(tt.now))
+		if strings.Join(got, "\n") != strings.Join(tt.want, "\n") {
+			t.Errorf("%s %s: got %q, want %q", tt.family, tt.release, got, tt.want)
+		}
+	}
+}
