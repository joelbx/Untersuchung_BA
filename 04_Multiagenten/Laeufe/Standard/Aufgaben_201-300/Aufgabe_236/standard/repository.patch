+def test_check_type_dict_does_not_evaluate(monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError('safe_eval called')
+
+    monkeypatch.setattr('ansible.module_utils.common.validation.safe_eval', forbidden)
