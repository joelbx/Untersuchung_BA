+        (usertypes.Backend.QtWebKit, True, None),
+    ])
+    def test_existing_enabled_features(self, config_stub, monkeypatch, parser,
+                                       backend, overlay, expected):
+        monkeypatch.setattr(qtargs.objects, 'backend', backend)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+        config_stub.val.qt.args = [
+            'enable-features=ConfigOne,ConfigTwo', 'other-flag']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CliOne,CliTwo'])
+
+        args = qtargs.qt_args(parsed)
+        features = [arg for arg in args if arg.startswith('--enable-features=')]
+        if expected is None:
+            assert features == [
+                '--enable-features=CliOne,CliTwo',
+                '--enable-features=ConfigOne,ConfigTwo']
+        else:
+            assert features == [expected]
+        assert '--other-flag' in args
