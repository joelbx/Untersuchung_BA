new file mode 100644
index 0000000..f7d3b7e
--- /dev/null
+++ b/libmanager/libManager_test.go
@@ -0,0 +1,27 @@
+package libmanager
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestMergeLibraryVulnPreservesLockfiles(t *testing.T) {
+	vulns := models.VulnInfos{}
+	mergeLibraryVuln(vulns, models.VulnInfo{
+		CveID: "CVE-1",
+		LibraryFixedIns: models.LibraryFixedIns{
+			{Path: "/a/Pipfile.lock", Name: "example", FixedIn: "2.0"},
+		},
+	})
+	mergeLibraryVuln(vulns, models.VulnInfo{
+		CveID: "CVE-1",
+		LibraryFixedIns: models.LibraryFixedIns{
+			{Path: "/b/Pipfile.lock", Name: "example", FixedIn: "3.0"},
+		},
+	})
+	got := vulns["CVE-1"].LibraryFixedIns
+	if len(got) != 2 || got[0].Path != "/a/Pipfile.lock" || got[1].Path != "/b/Pipfile.lock" {
+		t.Fatalf("library findings lost their lockfile paths: %+v", got)
+	}
+}
