+
+func TestAnalyzeFileKeepsLockfilesSeparate(t *testing.T) {
+	files := []struct {
+		path    string
+		version string
+	}{
+		{"/a/Pipfile.lock", "1.0.0"},
+		{"/b/Pipfile.lock", "2.0.0"},
+	}
+	var scanners models.LibraryScanners
+	for _, file := range files {
+		content := []byte(`{"default":{"example":{"version":"==` + file.version + `"}},"develop":{}}`)
+		apps, err := AnalyzeFile(file.path, &DummyFileInfo{}, func() ([]byte, error) { return content, nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		scanners = append(scanners, convertLibWithScanner(apps)...)
+	}
+	if len(scanners) != 2 {
+		t.Fatalf("got %d scanners, want one per lockfile", len(scanners))
+	}
+	for _, file := range files {
+		got := scanners.Find(file.path, "example")
+		if got[file.path].Version != file.version {
+			t.Errorf("%s: got %+v, want version %s", file.path, got, file.version)
+		}
+	}
+}
