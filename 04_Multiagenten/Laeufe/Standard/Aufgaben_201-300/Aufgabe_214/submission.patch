+++ b/scanner/portscan_test.go
@@ -0,0 +1,43 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScanParsesOpenPorts(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	script := `#!/bin/sh
+printf '%s\n' "$@" > "` + filepath.Join(filepath.Dir(path), "args") + `"
+cat <<'XML'
+<?xml version="1.0"?>
+<nmaprun><host><ports><port protocol="tcp" portid="22"><state state="open"/></port><port protocol="tcp" portid="80"><state state="closed"/></port></ports></host></nmaprun>
+XML
+`
+	if err := os.WriteFile(path, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{Host: "192.0.2.1", Port: "22", PortScan: &config.PortScanConf{
+		ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true,
+	}}}
+	open, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"22", "80"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(open) != 1 || open[0] != "192.0.2.1:22" {
+		t.Fatalf("open ports: %v", open)
+	}
+	args, err := os.ReadFile(filepath.Join(filepath.Dir(path), "args"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"-sT", "-p", "22,80", "192.0.2.1"} {
+		if !strings.Contains(string(args), want+"\n") {
+			t.Errorf("nmap arguments %q missing %s", args, want)
+		}
+	}
+}
