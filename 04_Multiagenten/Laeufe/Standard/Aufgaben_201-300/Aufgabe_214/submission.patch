diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..3a99860
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,156 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// PortScanConf controls scanning from the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+// ScanTechnique is an nmap TCP scan option.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	if c == nil {
+		return nil
+	}
+	for _, input := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for technique := TCPSYN; technique <= TCPXmas; technique++ {
+			if strings.EqualFold(input, technique.String()) {
+				found = technique
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, found)
+	}
+	if len(scanTechniques) > 1 {
+		allUnsupported := true
+		for _, technique := range scanTechniques {
+			if technique != NotSupportTechnique {
+				allUnsupported = false
+				break
+			}
+		}
+		if allUnsupported {
+			return []ScanTechnique{NotSupportTechnique}
+		}
+	}
+	return scanTechniques
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required for external port scanning"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q: %w", c.ScannerBinPath, err))
+	} else if !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q is not executable", c.ScannerBinPath))
+	}
+	techniques := (&c).GetScanTechniques()
+	if len(techniques) == 0 {
+		if c.HasPrivileged {
+			techniques = []ScanTechnique{TCPSYN}
+		} else {
+			techniques = []ScanTechnique{TCPConnect}
+		}
+	}
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported"))
+	}
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique %q", c.ScanTechniques[i]))
+		} else if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("scan technique %s requires hasPrivileged", technique.String()))
+		}
+		if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("sourcePort cannot be used with TCPConnect"))
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort must be an integer in [0,65535]"))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort 0 is not usable"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).Output()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("cannot check scannerBinPath capabilities: %w", err))
+		} else if !hasRawCapability(string(output)) {
+			errs = append(errs, fmt.Errorf("scannerBinPath has missing or malformed cap_net_raw capability data"))
+		}
+	}
+	return errs
+}
+
+func hasRawCapability(output string) bool {
+	fields := strings.Fields(output)
+	if len(fields) < 2 {
+		return false
+	}
+	parts := strings.SplitN(fields[1], "=", 2)
+	if len(parts) == 2 && strings.Contains(parts[1], "e") && strings.Contains(parts[1], "p") {
+		for _, name := range strings.Split(parts[0], ",") {
+			if name == "cap_net_raw" {
+				return true
+			}
+		}
+	}
+	return false
+}
