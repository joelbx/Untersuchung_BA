diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..c177ee4
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,95 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(conf *config.PortScanConf) ([]string, error) {
+	techniques := conf.GetScanTechniques()
+	if len(conf.ScanTechniques) > 1 {
+		return nil, fmt.Errorf("multiple scan techniques are not supported")
+	}
+	if len(techniques) == 0 {
+		if conf.HasPrivileged {
+			return []string{"-sS"}, nil
+		}
+		return []string{"-sT"}, nil
+	}
+	if techniques[0] == config.NotSupportTechnique {
+		return nil, fmt.Errorf("unsupported scan technique %q", conf.ScanTechniques[0])
+	}
+	return []string{"-" + techniques[0].String()}, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+type nmapResult struct {
+	Hosts []struct {
+		Ports []struct {
+			PortID string `xml:"portid,attr"`
+			State  struct {
+				Value string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if errs := conf.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniques, err := setScanTechniques(conf)
+	if err != nil {
+		return nil, err
+	}
+	acceptOpenFiltered := techniques[0] == "-sN" || techniques[0] == "-sF" || techniques[0] == "-sX" || techniques[0] == "-sM"
+	var open []string
+	for ip, ports := range scanDestIPPorts {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		if len(ports) == 0 {
+			continue
+		}
+		args := []string{"-Pn", "-n", "-oX", "-"}
+		if net.ParseIP(ip) != nil && net.ParseIP(ip).To4() == nil {
+			args = append(args, "-6")
+		}
+		args = append(args, techniques...)
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		orderedPorts := append([]string(nil), ports...)
+		sort.Strings(orderedPorts)
+		args = append(args, "-p", strings.Join(orderedPorts, ","), ip)
+		output, err := osexec.Command(conf.ScannerBinPath, args...).Output()
+		if err != nil {
+			if exitErr, ok := err.(*osexec.ExitError); ok {
+				return nil, fmt.Errorf("nmap scan (%s) failed: %w: %s", formatNmapOptionsToString(args), err, string(exitErr.Stderr))
+			}
+			return nil, fmt.Errorf("nmap scan (%s) failed: %w", formatNmapOptionsToString(args), err)
+		}
+		var result nmapResult
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("invalid nmap XML for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			for _, port := range host.Ports {
+				if port.State.Value == "open" || (acceptOpenFiltered && port.State.Value == "open|filtered") {
+					open = append(open, ip+":"+port.PortID)
+				}
+			}
+		}
+	}
+	return open, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
