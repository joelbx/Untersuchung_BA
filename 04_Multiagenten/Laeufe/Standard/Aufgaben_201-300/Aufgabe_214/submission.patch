@@ -0,0 +1,112 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniquesAndValidation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	for input, want := range map[string]ScanTechnique{
+		"Ss": TCPSYN, "st": TCPConnect, "SA": TCPACK, "sw": TCPWindow,
+		"sM": TCPMaimon, "Sn": TCPNull, "sf": TCPFIN, "SX": TCPXmas,
+		"invalid": NotSupportTechnique,
+	} {
+		conf := PortScanConf{ScannerBinPath: path, ScanTechniques: []string{input}}
+		got := conf.GetScanTechniques()
+		if len(got) != 1 || got[0] != want {
+			t.Errorf("%q: got %v, want %v", input, got, want)
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty techniques: %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad", "unknown"}}).GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Errorf("unknown techniques: %v", got)
+	}
+	for _, tc := range []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, ""},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sS"}}, "multiple"},
+		{"privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, "requires hasPrivileged"},
+		{"source and connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "sourcePort cannot"},
+		{"port range", PortScanConf{ScannerBinPath: path, SourcePort: "65536"}, "sourcePort must"},
+		{"port zero", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, "sourcePort 0"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			if tc.want == "" && len(errs) != 0 {
+				t.Fatal(errs)
+			}
+			if tc.want != "" && !strings.Contains(errorsText(errs), tc.want) {
+				t.Fatalf("errors %v do not contain %q", errs, tc.want)
+			}
+		})
+	}
+}
+
+func TestPortScanIsZero(t *testing.T) {
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("empty configuration should be zero")
+	}
+	for _, conf := range []PortScanConf{
+		{ScannerBinPath: "nmap"}, {ScanTechniques: []string{"sT"}},
+		{HasPrivileged: true}, {SourcePort: "443"},
+	} {
+		if conf.IsZero() {
+			t.Errorf("configuration %+v should not be zero", conf)
+		}
+	}
+}
+
+func TestPortScanTOMLLoader(t *testing.T) {
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	content := `[default.portscan]
+scannerBinPath = "/usr/bin/nmap"
+scanTechniques = ["sT"]
+[servers.one]
+host = "192.0.2.1"
+port = "local"
+[servers.two]
+host = "192.0.2.2"
+port = "local"
+[servers.two.portscan]
+scannerBinPath = "/custom/nmap"
+scanTechniques = ["sS"]
+hasPrivileged = true
+sourcePort = "443"
+`
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	for name, want := range map[string]string{"one": "/usr/bin/nmap", "two": "/custom/nmap"} {
+		conf := Conf.Servers[name].PortScan
+		if conf == nil || !conf.IsUseExternalScanner || conf.ScannerBinPath != want {
+			t.Errorf("server %s: %+v", name, conf)
+		}
+	}
+}
+
+func errorsText(errs []error) string {
+	var parts []string
+	for _, err := range errs {
+		parts = append(parts, err.Error())
+	}
+	return strings.Join(parts, "; ")
+}
