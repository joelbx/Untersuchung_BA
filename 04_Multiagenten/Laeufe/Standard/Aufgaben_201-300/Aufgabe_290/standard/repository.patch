+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "stalled"]);
+const debugEvents = new Set([
+    "abort", "canplay", "canplaythrough", "durationchange", "emptied", "ended", "loadeddata",
+    "loadedmetadata", "loadstart", "pause", "play", "playing", "progress", "ratechange", "seeked",
+    "seeking", "suspend", "timeupdate", "volumechange", "waiting",
+]);
+
+export function handleEvent(e: Event): void {
+    const media = (e.currentTarget || e.target) as HTMLMediaElement | null;
+    const id = media?.id;
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call media event", {
+            id,
+            type: e.type,
+            error: media?.error,
+        });
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call media event", { id, type: e.type });
+    }
+}
