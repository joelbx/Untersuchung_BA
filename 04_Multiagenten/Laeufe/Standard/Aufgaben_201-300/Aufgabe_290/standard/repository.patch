 import { getFunctionalMembers } from "../src/utils/room/getFunctionalMembers";
 import SettingsStore from '../src/settings/SettingsStore';
 import { UIFeature } from '../src/settings/UIFeature';
+import { AudioID } from '../src/LegacyCallHandler';
 
 jest.mock("../src/utils/room/getFunctionalMembers", () => ({
     getFunctionalMembers: jest.fn(),
 }));
 
+describe('call sound playback', () => {
+    it.each([
+        [AudioID.Ring, 'ringAudio'],
+        [AudioID.Ringback, 'ringbackAudio'],
+        [AudioID.Busy, 'busyAudio'],
+        [AudioID.CallEnd, 'callendAudio'],
+    ])('unmutes %s before playing', async (audioId, expectedId) => {
+        expect(audioId).toBe(expectedId);
+        const audio = document.createElement('audio');
+        audio.id = audioId;
+        audio.muted = true;
+        const play = jest.spyOn(audio, 'play').mockImplementation(() => {
+            expect(audio.muted).toBe(false);
+            return Promise.resolve();
+        });
+        jest.spyOn(audio, 'load').mockImplementation();
+        document.body.appendChild(audio);
+        try {
+            const handler = new LegacyCallHandler();
+            handler.play(audioId);
+            await (handler as any).audioPromises.get(audioId);
+            expect(play).toHaveBeenCalledTimes(1);
+
+            audio.muted = true;
+            handler.play(audioId);
+            await (handler as any).audioPromises.get(audioId);
+            expect(play).toHaveBeenCalledTimes(2);
+
+            handler.play(audioId);
+            await (handler as any).audioPromises.get(audioId);
+            expect(play).toHaveBeenCalledTimes(3);
+            expect(audio.muted).toBe(false);
+        } finally {
+            audio.remove();
+        }
+    });
+});
