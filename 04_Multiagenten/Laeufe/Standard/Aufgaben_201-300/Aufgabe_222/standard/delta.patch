+    def _build_doc(self, role, path, collection, argspec, entry_point=None):
+        """Build documentation for a role, optionally limited to one entry point.
+
+        :returns: The role name and its documentation, or None when no entry points match.
+        """
+        fqcn = '.'.join([collection, role]) if collection else role
+        entry_points = {}
+        for ep in argspec:
+            if entry_point is None or ep == entry_point:
+                entry_points[ep] = argspec[ep] or {}
+
+        if not entry_points:
+            return (fqcn, None)
+
+        doc = {'path': path, 'collection': collection, 'entry_points': entry_points}
+        return (fqcn, doc)
