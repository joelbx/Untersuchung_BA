+
+
+@pytest.mark.parametrize('collection, expected_name', [
+    (None, 'my_role'),
+    ('', 'my_role'),
+    ('example.collection', 'example.collection.my_role'),
+])
+def test_build_role_doc(collection, expected_name):
+    main_spec = {'short_description': 'Main entry point', 'options': {'name': {'type': 'str'}}}
+    alternate_spec = {'short_description': 'Alternate entry point'}
+    argspec = {'main': main_spec, 'alternate': alternate_spec}
+    role = RoleMixin()
+
+    fqcn, doc = role._build_doc('my_role', '/roles/my_role', collection, argspec)
+    assert fqcn == expected_name
+    assert doc == {'path': '/roles/my_role', 'collection': collection, 'entry_points': argspec}
+    assert doc['entry_points']['main'] is main_spec
+
+    fqcn, doc = role._build_doc('my_role', '/roles/my_role', collection, argspec, 'alternate')
+    assert fqcn == expected_name
+    assert doc['entry_points'] == {'alternate': alternate_spec}
+    assert doc['entry_points']['alternate'] is alternate_spec
+
+    assert role._build_doc('my_role', '/roles/my_role', collection, argspec, 'missing') == (expected_name, None)
+    assert role._build_doc('my_role', '/roles/my_role', collection, {}) == (expected_name, None)
