diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..ec80a2b
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,102 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ loading: false, error: false })),
+}));
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ handleCreateCalendar: jest.fn() })),
+}));
+jest.mock('../../../components', () => ({
+    Href: ({ children }: any) => <a>{children}</a>,
+    InputFieldTwo: ({ label, value, onChange, warning, error }: any) => (
+        <div>
+            <label htmlFor="calendar-url">{label}</label>
+            <input id="calendar-url" value={value} onChange={onChange} />
+            {warning && <span>{warning}</span>}
+            {error && <span>{error}</span>}
+        </div>
+    ),
+    Loader: () => null,
+    Button: ({ children, disabled, type, onClick }: any) => (
+        <button type={type} disabled={disabled} onClick={onClick}>
+            {children}
+        </button>
+    ),
+    BasicModal: ({ children, footer, onSubmit }: any) => (
+        <form
+            onSubmit={(event) => {
+                event.preventDefault();
+                onSubmit();
+            }}
+        >
+            {children}
+            {footer}
+        </form>
+    ),
+    Form: 'form',
+}));
+
+describe('SubscribeCalendarModal URL validation', () => {
+    const setup = () => {
+        render(<SubscribeCalendarModal isOpen />);
+        const input = screen.getByLabelText('Calendar URL');
+        const submit = screen.getByRole('button', { name: 'Add calendar' });
+        return { input, submit };
+    };
+
+    it('requires a valid URL at or below the API limit and trims input', () => {
+        const { input, submit } = setup();
+        expect(submit).toBeDisabled();
+
+        fireEvent.change(input, { target: { value: ' https://example.com/calendar.ics ' } });
+        expect(input).toHaveValue('https://example.com/calendar.ics');
+        expect(submit).toBeEnabled();
+
+        fireEvent.change(input, { target: { value: 'invalid' } });
+        expect(submit).toBeDisabled();
+
+        const prefix = 'https://example.com/';
+        fireEvent.change(input, {
+            target: { value: prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length) },
+        });
+        expect(submit).toBeEnabled();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        fireEvent.change(input, {
+            target: { value: prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length + 1) },
+        });
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+    });
+
+    it('shows only the highest priority warning', () => {
+        const { input } = setup();
+        const google = 'https://calendar.google.com/public/';
+
+        fireEvent.change(input, { target: { value: google + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL) } });
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        fireEvent.change(input, { target: { value: `${google}name.ics` } });
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('This link might be wrong')).not.toBeInTheDocument();
+
+        fireEvent.change(input, {
+            target: { value: google + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL) + '.ics' },
+        });
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        fireEvent.change(input, { target: { value: 'https://outlook.live.com/calendar' } });
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+    });
+});
