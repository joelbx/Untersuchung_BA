+class bestbook_award(delegate.page):
+    path = r'/works/OL(\d+)W/awards'
+    encoding = 'json'
+
+    def POST(self, work_id):
+        def response(value):
+            return delegate.RawText(json.dumps(value), content_type='application/json')
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        data = web.input(op=None, topic=None, comment='', edition_key=None)
+        if web.ctx.env.get('CONTENT_TYPE', '').startswith('application/json'):
+            try:
+                data = json.loads(web.data())
+            except (ValueError, TypeError):
+                return response({'errors': 'Invalid JSON'})
+            if not isinstance(data, dict):
+                return response({'errors': 'Invalid JSON'})
+
+        username = user.key.split('/')[2]
+        op = data.get('op')
+        if op not in ('add', 'remove', 'update'):
+            return response({'errors': 'Invalid operation'})
+
+        try:
+            if op == 'remove':
+                return response({
+                    'success': True,
+                    'rows': Bestbook.remove(username, work_id=work_id),
+                })
+
+            topic = data.get('topic')
+            if not topic or not isinstance(topic, str):
+                raise Bestbook.AwardConditionsError('A topic is required')
+            edition_key = data.get('edition_key')
+            edition_id = (
+                int(extract_numeric_id_from_olid(edition_key)) if edition_key else None
+            )
+            comment = data.get('comment') or ''
+            if not isinstance(comment, str):
+                raise Bestbook.AwardConditionsError('Invalid comment')
+
+            if op == 'update':
+                if not Bestbook.get_count(username=username, work_id=work_id):
+                    raise Bestbook.AwardConditionsError('No award exists for this book')
+                transaction = db.get_db().transaction()
+                try:
+                    Bestbook.remove(username, work_id=work_id)
+                    award = Bestbook.add(username, work_id, topic, comment, edition_id)
+                except Exception:
+                    transaction.rollback()
+                    raise
+                else:
+                    transaction.commit()
+            else:
+                award = Bestbook.add(username, work_id, topic, comment, edition_id)
+            return response({'success': True, 'award': award})
+        except (Bestbook.AwardConditionsError, ValueError, TypeError) as exc:
+            return response({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = '/awards/count'
+    encoding = 'json'
+
+    @jsonapi
+    def GET(self):
+        data = web.input(work_id=None, username=None, topic=None)
+        try:
+            return json.dumps({'count': Bestbook.get_count(
+                work_id=data.work_id or None,
+                username=data.username or None,
+                topic=data.topic or None,
+            )})
+        except (ValueError, TypeError) as exc:
+            return json.dumps({'errors': str(exc)})
+
+
