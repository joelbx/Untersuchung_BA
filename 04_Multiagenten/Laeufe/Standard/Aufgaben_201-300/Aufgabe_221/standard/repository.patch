diff --git a/openlibrary/tests/core/test_bestbook.py b/openlibrary/tests/core/test_bestbook.py
new file mode 100644
index 0000000..afc62b5
--- /dev/null
+++ b/openlibrary/tests/core/test_bestbook.py
@@ -0,0 +1,113 @@
+import json
+
+import pytest
+import web
+
+from openlibrary.core import db
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.core.bookshelves import Bookshelves
+from openlibrary.core.models import Work
+from openlibrary.plugins.openlibrary import api
+
+
+@pytest.fixture
+def awards_db(monkeypatch):
+    database = web.database(dbn="sqlite", db=":memory:")
+    database.query("""
+        CREATE TABLE bookshelves_books (
+            username text NOT NULL, work_id integer NOT NULL, bookshelf_id integer NOT NULL
+        )
+    """)
+    database.query("""
+        CREATE TABLE bestbook_awards (
+            id integer PRIMARY KEY AUTOINCREMENT,
+            username text NOT NULL, work_id integer NOT NULL, topic text NOT NULL,
+            comment text NOT NULL DEFAULT '', edition_id integer,
+            UNIQUE (username, work_id), UNIQUE (username, topic)
+        )
+    """)
+    monkeypatch.setattr(db, "get_db", lambda: database)
+    return database
+
+
+def test_award_read_prerequisite_and_uniqueness(awards_db):
+    with pytest.raises(Bestbook.AwardConditionsError, match="Only books which have been marked as read"):
+        Bestbook.add("reader", "1", "fiction")
+
+    awards_db.insert("bookshelves_books", username="reader", work_id=1, bookshelf_id=3)
+    awards_db.insert("bookshelves_books", username="reader", work_id=2, bookshelf_id=3)
+    assert Bookshelves.user_has_read_work("reader", "1")
+    assert Bestbook.add("reader", "1", "fiction", comment="Favorite", edition_id=10)
+    assert Bestbook.get_count(work_id="1", username="reader", topic="fiction") == 1
+    assert Bestbook.get_awards(work_id="1")[0].comment == "Favorite"
+
+    with pytest.raises(Bestbook.AwardConditionsError, match="already awarded this book"):
+        Bestbook.add("reader", "1", "history")
+    with pytest.raises(Bestbook.AwardConditionsError, match="this topic"):
+        Bestbook.add("reader", "2", "fiction")
+    assert Bestbook.remove("reader", work_id="1") == 1
+    assert Bestbook.get_count(username="reader") == 0
+
+
+def test_award_aggregation_and_references(awards_db):
+    for username, work_id, topic in [("one", 1, "fiction"), ("two", 1, "fiction"), ("one", 2, "history")]:
+        awards_db.insert("bookshelves_books", username=username, work_id=work_id, bookshelf_id=3)
+        Bestbook.add(username, str(work_id), topic)
+
+    assert Bestbook.get_count(topic="fiction") == 2
+    assert Bestbook.get_leaderboard() == [{"work_id": 1, "count": 2}, {"work_id": 2, "count": 1}]
+    assert Bestbook.update_username("two", "anonymous") == 1
+    assert Bestbook.get_count(username="anonymous") == 1
+    assert Bestbook.update_work_id(2, 1)["rows_deleted"] == 1
+    assert Bestbook.get_count(work_id="1") == 2
+
+
+def test_award_api_update_rollback_and_authentication(awards_db, monkeypatch):
+    monkeypatch.setattr(web.ctx, "env", {}, raising=False)
+    request = {"op": "add", "topic": "fiction"}
+    monkeypatch.setattr(web, "input", lambda **defaults: web.storage({**defaults, **request}))
+    monkeypatch.setattr(api.accounts, "get_current_user", lambda: None)
+    endpoint = api.bestbook_award()
+    assert json.loads(endpoint.POST("1").rawtext) == {"errors": "Authentication failed"}
+
+    monkeypatch.setattr(
+        api.accounts,
+        "get_current_user",
+        lambda: web.storage(key="/people/reader"),
+    )
+    response = json.loads(endpoint.POST("1").rawtext)
+    assert response["errors"].startswith("Only books which have been marked as read")
+
+    for work_id in (1, 2):
+        awards_db.insert("bookshelves_books", username="reader", work_id=work_id, bookshelf_id=3)
+    assert json.loads(endpoint.POST("1").rawtext)["success"]
+    request.update(op="add", topic="history")
+    assert json.loads(endpoint.POST("2").rawtext)["success"]
+
+    request.update(op="update", topic="history")
+    assert "errors" in json.loads(endpoint.POST("1").rawtext)
+    assert Bestbook.get_awards(work_id="1")[0].topic == "fiction"
+
+    request.update(topic="poetry")
+    assert json.loads(endpoint.POST("1").rawtext)["success"]
+    assert Bestbook.get_awards(work_id="1")[0].topic == "poetry"
+
+    request.update(op="remove")
+    assert json.loads(endpoint.POST("1").rawtext) == {"success": True, "rows": 1}
+
+
+def test_work_accessors_and_count_api(awards_db, monkeypatch):
+    awards_db.insert("bookshelves_books", username="reader", work_id=1, bookshelf_id=3)
+    Bestbook.add("reader", "1", "fiction")
+    work = Work(None, "/works/OL1W", data={"key": "/works/OL1W"})
+    assert len(work.get_awards()) == 1
+    assert work.check_if_user_awarded("reader")
+    assert work.get_award_by_username("reader").topic == "fiction"
+    assert not work.check_if_user_awarded("other")
+
+    monkeypatch.setattr(
+        web,
+        "input",
+        lambda **defaults: web.storage({**defaults, "work_id": "1", "topic": "fiction"}),
+    )
+    assert json.loads(api.bestbook_count().GET().rawtext) == {"count": 1}
