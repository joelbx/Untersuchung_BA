@@ -0,0 +1,93 @@
+"""Persistent nominations for Best Book Awards."""
+
+from sqlite3 import IntegrityError
+
+from psycopg2.errors import UniqueViolation
+
+from . import db
+from .bookshelves import Bookshelves
+
+
+class AwardConditionsError(ValueError):
+    """A nomination does not meet the award rules."""
+
+
+class Bestbook(db.CommonExtras):
+    TABLENAME = "bestbook_awards"
+    PRIMARY_KEY = ("id",)
+    ALLOW_DELETE_ON_CONFLICT = True
+    AwardConditionsError = AwardConditionsError
+
+    @classmethod
+    def get_awards(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> list:
+        filters = {"work_id": int(work_id) if work_id is not None else None, "username": username, "topic": topic}
+        conditions = [f"{key}=${key}" for key, value in filters.items() if value is not None]
+        where = " AND ".join(conditions) if conditions else "1=1"
+        return list(db.get_db().select(cls.TABLENAME, where=where, vars=filters))
+
+    @classmethod
+    def get_count(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        filters = {"work_id": int(work_id) if work_id is not None else None, "username": username, "topic": topic}
+        conditions = [f"{key}=${key}" for key, value in filters.items() if value is not None]
+        where = " WHERE " + " AND ".join(conditions) if conditions else ""
+        return db.get_db().query(f"SELECT count(*) AS count FROM {cls.TABLENAME}{where}", vars=filters)[0].count
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        query = (
+            f'SELECT work_id, count(*) AS count FROM {cls.TABLENAME} '
+            'GROUP BY work_id ORDER BY count DESC, work_id'
+        )
+        return [dict(row) for row in db.get_db().query(query)]
+
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: int | None = None,
+    ) -> int | None:
+        work_id = int(work_id)
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise AwardConditionsError("Only books which have been marked as read may be given awards")
+        if not topic:
+            raise AwardConditionsError("A topic is required")
+        if cls.get_count(username=username, work_id=work_id):
+            raise AwardConditionsError("You have already awarded this book")
+        if cls.get_count(username=username, topic=topic):
+            raise AwardConditionsError("You have already awarded a book for this topic")
+        try:
+            return db.get_db().insert(
+                cls.TABLENAME,
+                username=username,
+                work_id=work_id,
+                topic=topic,
+                comment=comment,
+                edition_id=edition_id,
+            )
+        except (UniqueViolation, IntegrityError) as exc:
+            raise AwardConditionsError("You have already awarded this book or topic") from exc
+
+    @classmethod
+    def remove(cls, username: str, work_id: str | None = None, topic: str | None = None) -> int:
+        if work_id is None and topic is None:
+            raise AwardConditionsError("A work or topic is required")
+        filters = {"username": username}
+        if work_id is not None:
+            filters["work_id"] = int(work_id)
+        if topic is not None:
+            filters["topic"] = topic
+        where = " AND ".join(f"{key}=${key}" for key in filters)
+        return db.get_db().delete(cls.TABLENAME, where=where, vars=filters)
