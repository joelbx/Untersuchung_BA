+
+describe('upload cleanup on purge', () => {
+	const uploadDir = path.join(nconf.get('upload_path'), 'files');
+	let uid;
+	let cid;
+	let oldPreserveSetting;
+
+	before(async () => {
+		oldPreserveSetting = meta.config.preserveOrphanedUploads;
+		uid = await user.create({ username: 'upload cleanup user', password: 'password' });
+		({ cid } = await categories.create({ name: 'Upload cleanup category' }));
+	});
+
+	after(() => {
+		meta.config.preserveOrphanedUploads = oldPreserveSetting;
+	});
+
+	async function makeTopic(filename) {
+		return await topics.post({
+			uid,
+			cid,
+			title: `Upload cleanup ${filename}`,
+			content: `[file](/assets/uploads/files/${filename})`,
+		});
+	}
+
+	it('deletes an exclusive upload when its topic is purged', async () => {
+		const filename = 'purge-exclusive-upload.txt';
+		const fullPath = path.join(uploadDir, filename);
+		await fs.promises.writeFile(fullPath, 'exclusive');
+		meta.config.preserveOrphanedUploads = 0;
+		const topic = await makeTopic(filename);
+		await topics.purgePostsAndTopic(topic.topicData.tid, uid);
+		assert.strictEqual(fs.existsSync(fullPath), false);
+	});
+
+	it('keeps an upload referenced by another post', async () => {
+		const filename = 'purge-shared-upload.txt';
+		const fullPath = path.join(uploadDir, filename);
+		await fs.promises.writeFile(fullPath, 'shared');
+		meta.config.preserveOrphanedUploads = 0;
+		const first = await makeTopic(filename);
+		const second = await makeTopic(filename);
+		await topics.purgePostsAndTopic(first.topicData.tid, uid);
+		assert.strictEqual(fs.existsSync(fullPath), true);
+		await topics.purgePostsAndTopic(second.topicData.tid, uid);
+		assert.strictEqual(fs.existsSync(fullPath), false);
+	});
+
+	it('keeps orphaned uploads when preservation is enabled', async () => {
+		const filename = 'purge-preserved-upload.txt';
+		const fullPath = path.join(uploadDir, filename);
+		await fs.promises.writeFile(fullPath, 'preserved');
+		meta.config.preserveOrphanedUploads = 1;
+		const topic = await makeTopic(filename);
+		await topics.purgePostsAndTopic(topic.topicData.tid, uid);
+		assert.strictEqual(fs.existsSync(fullPath), true);
+		await fs.promises.unlink(fullPath);
+	});
+
+	it('deletes single and multiple paths and ignores unsafe paths', async () => {
+		const first = path.join(uploadDir, 'delete-one.txt');
+		const second = path.join(uploadDir, 'delete-two.txt');
+		const outside = path.join(nconf.get('upload_path'), 'outside-upload.txt');
+		const link = path.join(uploadDir, 'cleanup-link');
+		await Promise.all([first, second, outside].map(name => fs.promises.writeFile(name, 'test')));
+		await fs.promises.symlink(nconf.get('upload_path'), link);
+		await posts.uploads.deleteFromDisk('delete-one.txt');
+		assert.strictEqual(fs.existsSync(first), false);
+		await posts.uploads.deleteFromDisk([
+			'delete-two.txt', '../outside-upload.txt', outside, 'cleanup-link/outside-upload.txt', null, 'missing.txt',
+		]);
+		assert.strictEqual(fs.existsSync(second), false);
+		assert.strictEqual(fs.existsSync(outside), true);
+		await fs.promises.unlink(outside);
+		await fs.promises.unlink(link);
+		await assert.rejects(posts.uploads.deleteFromDisk(123), TypeError);
+	});
+});
