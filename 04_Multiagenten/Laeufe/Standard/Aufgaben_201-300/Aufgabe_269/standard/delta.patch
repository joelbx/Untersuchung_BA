+package pkg
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2023, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.AddDate(0, 1, 0)
+	makeVuln := func(source trivydbTypes.SourceID, severity trivydbTypes.Severity) types.DetectedVulnerability {
+		vuln := types.DetectedVulnerability{
+			VulnerabilityID: "CVE-2023-0001", PkgName: string(source), SeveritySource: source,
+			Vulnerability: trivydbTypes.Vulnerability{
+				Title: "title", Description: "summary", Severity: severity.String(),
+				VendorSeverity: trivydbTypes.VendorSeverity{source: severity},
+				CVSS: trivydbTypes.VendorCVSS{
+					"nvd": {V2Score: 4.3, V2Vector: "AV:N", V3Score: 7.5, V3Vector: "CVSS:3.1"},
+				},
+				References:    []string{"https://example.org/advisory"},
+				PublishedDate: &published, LastModifiedDate: &modified,
+			},
+		}
+		if source == "debian" {
+			vuln.VendorSeverity["nvd"] = trivydbTypes.SeverityHigh
+		}
+		return vuln
+	}
+	result, err := Convert(types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{makeVuln("debian", trivydbTypes.SeverityLow)}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{makeVuln("ubuntu", trivydbTypes.SeverityMedium)}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-2023-0001"].CveContents
+	for source, want := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM"} {
+		if len(contents[source]) != 1 || contents[source][0].Cvss3Severity != want {
+			t.Fatalf("%s: %#v", source, contents[source])
+		}
+		got := contents[source][0]
+		if got.Type != source || got.CveID != "CVE-2023-0001" || got.Title != "title" || got.Summary != "summary" ||
+			!got.Published.Equal(published) || !got.LastModified.Equal(modified) || len(got.References) != 1 {
+			t.Fatalf("incomplete %s content: %#v", source, got)
+		}
+	}
+	nvd := contents[models.TrivyNVD][0]
+	if nvd.Cvss3Score != 7.5 || nvd.Cvss3Vector != "CVSS:3.1" || nvd.Cvss2Score != 4.3 || nvd.Cvss2Vector != "AV:N" || nvd.Cvss3Severity != "HIGH" {
+		t.Fatalf("NVD CVSS lost: %#v", nvd)
+	}
+}
