diff --git a/contrib/trivy/pkg/cvecontents.go b/contrib/trivy/pkg/cvecontents.go
new file mode 100644
index 0000000..dcfa1d3
--- /dev/null
+++ b/contrib/trivy/pkg/cvecontents.go
@@ -0,0 +1,111 @@
+package pkg
+
+import (
+	"sort"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+// CveContents preserves the severity and CVSS reported by each Trivy source.
+func CveContents(cveID string, vul trivydbTypes.Vulnerability, severitySource trivydbTypes.SourceID) models.CveContents {
+	contents := models.CveContents{}
+	refs := make(models.References, 0, len(vul.References))
+	for _, link := range vul.References {
+		refs = append(refs, models.Reference{Source: "trivy", Link: link})
+	}
+	sort.Slice(refs, func(i, j int) bool { return refs[i].Link < refs[j].Link })
+
+	var published, modified time.Time
+	if vul.PublishedDate != nil {
+		published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		modified = *vul.LastModifiedDate
+	}
+
+	sources := map[trivydbTypes.SourceID]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[source] = struct{}{}
+	}
+	if severitySource != "" {
+		sources[severitySource] = struct{}{}
+	}
+	if len(sources) == 0 {
+		sources[""] = struct{}{}
+	}
+	for source := range sources {
+		ctype := models.Trivy
+		if source != "" {
+			ctype = models.CveContentType("trivy:" + source)
+		}
+		cvss := vul.CVSS[source]
+		severity := ""
+		if vendorSeverity, ok := vul.VendorSeverity[source]; ok {
+			severity = vendorSeverity.String()
+		} else if source == severitySource || len(sources) == 1 {
+			severity = vul.Severity
+		}
+		contents[ctype] = []models.CveContent{{
+			Type: ctype, CveID: cveID, Title: vul.Title, Summary: vul.Description,
+			Cvss2Score: cvss.V2Score, Cvss2Vector: cvss.V2Vector,
+			Cvss3Score: cvss.V3Score, Cvss3Vector: cvss.V3Vector,
+			Cvss3Severity: severity, References: refs,
+			Published: published, LastModified: modified,
+		}}
+	}
+	return contents
+}
+
+// MergeCveContents adds source entries without dropping values absent from a
+// later scan target's copy of the same vulnerability.
+func MergeCveContents(dst, src models.CveContents) {
+	for source, incoming := range src {
+		if len(incoming) == 0 {
+			continue
+		}
+		content := incoming[0]
+		if existing := dst[source]; len(existing) != 0 {
+			old := existing[0]
+			if content.Cvss3Severity == "" {
+				content.Cvss3Severity = old.Cvss3Severity
+			}
+			if content.Cvss2Score == 0 {
+				content.Cvss2Score = old.Cvss2Score
+				content.Cvss2Vector = old.Cvss2Vector
+			}
+			if content.Cvss3Score == 0 {
+				content.Cvss3Score = old.Cvss3Score
+				content.Cvss3Vector = old.Cvss3Vector
+			}
+			if content.Title == "" {
+				content.Title = old.Title
+			}
+			if content.Summary == "" {
+				content.Summary = old.Summary
+			}
+			if content.Published.IsZero() {
+				content.Published = old.Published
+			}
+			if content.LastModified.IsZero() {
+				content.LastModified = old.LastModified
+			}
+			seen := map[string]bool{}
+			for _, ref := range content.References {
+				seen[ref.Link] = true
+			}
+			for _, ref := range old.References {
+				if !seen[ref.Link] {
+					content.References = append(content.References, ref)
+				}
+			}
+			sort.Slice(content.References, func(i, j int) bool { return content.References[i].Link < content.References[j].Link })
+		}
+		dst[source] = []models.CveContent{content}
+	}
+}
