+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsBySource(t *testing.T) {
+	published := time.Date(2024, 2, 3, 0, 0, 0, 0, time.UTC)
+	modified := published.AddDate(0, 0, 1)
+	contents := getCveContents("CVE-2024-0001", trivydbTypes.Vulnerability{
+		Title: "title", Description: "summary",
+		VendorSeverity: trivydbTypes.VendorSeverity{"debian": trivydbTypes.SeverityLow, "ubuntu": trivydbTypes.SeverityMedium},
+		CVSS:           trivydbTypes.VendorCVSS{"nvd": {V2Score: 5, V3Score: 8, V3Vector: "CVSS:3.1"}},
+		References:     []string{"https://example.org"}, PublishedDate: &published, LastModifiedDate: &modified,
+	})
+	if len(contents) != 3 {
+		t.Fatalf("sources: %#v", contents)
+	}
+	for source, severity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM"} {
+		got := contents[source][0]
+		if got.Type != source || got.CveID != "CVE-2024-0001" || got.Cvss3Severity != severity ||
+			got.Title != "title" || got.Summary != "summary" || !got.Published.Equal(published) ||
+			!got.LastModified.Equal(modified) || len(got.References) != 1 {
+			t.Fatalf("%s: %#v", source, got)
+		}
+	}
+	if nvd := contents[models.TrivyNVD][0]; nvd.Cvss2Score != 5 || nvd.Cvss3Score != 8 || nvd.Cvss3Vector != "CVSS:3.1" {
+		t.Fatalf("NVD scoring: %#v", nvd)
+	}
+}
