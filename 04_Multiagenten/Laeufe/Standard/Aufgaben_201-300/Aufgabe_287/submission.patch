@@ -0,0 +1,24 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("album image paths", func() {
+	It("joins images from each media directory in stable order", func() {
+		dirs := dirMap{
+			"b": {ImageFiles: []string{"back.png", "front.jpg"}},
+			"a": {ImageFiles: []string{"cover.jpg"}},
+		}
+		Expect(imageFiles([]string{"a", "b"}, dirs)).To(Equal(strings.Join([]string{
+			filepath.Join("a", "cover.jpg"),
+			filepath.Join("b", "back.png"),
+			filepath.Join("b", "front.jpg"),
+		}, string(filepath.ListSeparator))))
+		Expect(imageFiles([]string{"deleted"}, dirs)).To(BeEmpty())
+	})
+})
