+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Classify IA ISBN metadata by trimmed length, without validating ISBNs."""
+    isbn_10 = []
+    isbn_13 = []
+    for isbn in [isbns] if isinstance(isbns, str) else isbns:
+        isbn = isbn.strip()
+        if len(isbn) == 10:
+            isbn_10.append(isbn)
+        elif len(isbn) == 13:
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
