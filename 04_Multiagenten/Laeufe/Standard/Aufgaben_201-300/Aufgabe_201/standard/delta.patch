+++ b/internal/ext/common_test.go
@@ -0,0 +1,63 @@
+package ext
+
+import (
+	"context"
+	"go.flipt.io/flipt/rpc/flipt"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+)
+
+func TestRuleSegmentYAML(t *testing.T) {
+	for _, tc := range []struct {
+		input    string
+		keys     []string
+		operator string
+		valid    bool
+	}{
+		{`segment: foo`, []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{`segment: {keys: [foo], operator: AND_SEGMENT_OPERATOR}`, []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{`segment: {keys: [foo], operator: UNRECOGNIZED}`, []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{`segment: {keys: [foo, bar], operator: AND_SEGMENT_OPERATOR}`, []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR", true},
+		{`segment: {keys: [foo, bar], operator: BAD}`, nil, "", false},
+		{`segment: {keys: [], operator: OR_SEGMENT_OPERATOR}`, nil, "", false},
+		{`segment: {keys: [foo]}`, nil, "", false},
+		{`segment: [foo]`, nil, "", false},
+		{`segment: 42`, nil, "", false},
+		{`segment: ""`, nil, "", false},
+		{`segment: {key: foo, operator: OR_SEGMENT_OPERATOR}`, nil, "", false},
+	} {
+		var rule Rule
+		err := yaml.UnmarshalStrict([]byte(tc.input), &rule)
+		if !tc.valid {
+			require.Error(t, err, tc.input)
+			continue
+		}
+		require.NoError(t, err, tc.input)
+		keys, op, err := rule.Segment.Values()
+		require.NoError(t, err)
+		require.Equal(t, tc.keys, keys)
+		require.Equal(t, tc.operator, op)
+		out, err := yaml.Marshal(&rule)
+		require.NoError(t, err)
+		require.True(t, strings.Contains(string(out), "segment:"))
+	}
+	var empty Rule
+	_, _, err := empty.Segment.Values()
+	require.Error(t, err)
+}
+
+func TestImportRuleWithObjectSegment(t *testing.T) {
+	creator := &mockCreator{}
+	importer := NewImporter(creator)
+	input, err := os.Open("testdata/import_rule_multiple_segments.yml")
+	require.NoError(t, err)
+	defer input.Close()
+	require.NoError(t, importer.Import(context.Background(), input))
+	require.Len(t, creator.ruleReqs, 1)
+	require.Equal(t, "segment1", creator.ruleReqs[0].SegmentKey)
+	require.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, creator.ruleReqs[0].SegmentOperator)
+}
