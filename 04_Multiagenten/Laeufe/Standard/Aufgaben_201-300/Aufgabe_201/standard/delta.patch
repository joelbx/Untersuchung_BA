+// IsSegment is implemented by the supported rule segment forms.
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct {
+	Segment IsSegment `yaml:"-"`
+}
+
+func (s *SegmentEmbed) Values() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("segment is required")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, "", fmt.Errorf("segment key is required")
+		}
+		return []string{string(v)}, "OR_SEGMENT_OPERATOR", nil
+	case Segments:
+		if len(v.Keys) == 0 {
+			return nil, "", fmt.Errorf("segment keys are required")
+		}
+		for _, key := range v.Keys {
+			if key == "" {
+				return nil, "", fmt.Errorf("segment key is required")
+			}
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys, "OR_SEGMENT_OPERATOR", nil
+		}
+		if v.SegmentOperator != "AND_SEGMENT_OPERATOR" && v.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+			return nil, "", fmt.Errorf("invalid segment operator %q", v.SegmentOperator)
+		}
+		return v.Keys, v.SegmentOperator, nil
+	default:
+		return nil, "", fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if _, _, err := s.Values(); err != nil {
+		return nil, err
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		return string(v), nil
+	case Segments:
+		return v, nil
+	default:
+		return nil, fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		s.Segment = SegmentKey(v)
+	case map[interface{}]interface{}:
+		if len(v) != 2 {
+			return fmt.Errorf("segment object requires keys and operator")
+		}
+		keysRaw, hasKeys := v["keys"]
+		opRaw, hasOp := v["operator"]
+		if !hasKeys || !hasOp {
+			return fmt.Errorf("segment object requires keys and operator")
+		}
+		list, ok := keysRaw.([]interface{})
+		if !ok {
+			return fmt.Errorf("segment keys must be a list")
+		}
+		keys := make([]string, 0, len(list))
+		for _, item := range list {
+			key, ok := item.(string)
+			if !ok {
+				return fmt.Errorf("segment keys must be strings")
+			}
+			keys = append(keys, key)
+		}
+		op, ok := opRaw.(string)
+		if !ok {
+			return fmt.Errorf("segment operator must be a string")
+		}
+		s.Segment = Segments{Keys: keys, SegmentOperator: op}
+	default:
+		return fmt.Errorf("unsupported segment format %T", raw)
+	}
+	_, _, err := s.Values()
+	return err
+}
