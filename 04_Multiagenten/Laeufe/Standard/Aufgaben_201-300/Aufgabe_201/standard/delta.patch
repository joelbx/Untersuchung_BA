+// convertAttachment makes YAML decoded maps safe for JSON encoding.
+func convertAttachment(value interface{}) interface{} {
+	switch v := value.(type) {
+	case map[interface{}]interface{}:
+		out := make(map[string]interface{}, len(v))
+		for key, item := range v {
+			if name, ok := key.(string); ok {
+				out[name] = convertAttachment(item)
+			}
+		}
+		return out
+	case []interface{}:
+		for i, item := range v {
+			v[i] = convertAttachment(item)
+		}
+	}
+	return value
+}
