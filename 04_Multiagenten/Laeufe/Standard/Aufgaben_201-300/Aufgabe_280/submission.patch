+func TestNewWithClientEnvironment(t *testing.T) {
+	tests := []struct {
+		name        string
+		namespace   string
+		replicaName string
+		missingEnv  string
+	}{
+		{name: "configured", namespace: "test", replicaName: "agent-0"},
+		{name: "missing namespace", replicaName: "agent-0", missingEnv: NamespaceEnv},
+		{name: "missing replica name", namespace: "test", missingEnv: teleportReplicaNameEnv},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv(teleportReplicaNameEnv, tt.replicaName)
+			t.Setenv(ReleaseNameEnv, "test-release")
+
+			client := fake.NewSimpleClientset()
+			b, err := NewWithClient(client)
+			if tt.missingEnv != "" {
+				require.Nil(t, b)
+				require.EqualError(t, err, fmt.Sprintf("environment variable %q not set or empty", tt.missingEnv))
+				return
+			}
+
+			require.NoError(t, err)
+			require.Equal(t, tt.namespace, b.Namespace)
+			require.Equal(t, tt.replicaName, b.ReplicaName)
+			require.Equal(t, "agent-0-state", b.SecretName)
+			require.Equal(t, "test-release", b.ReleaseName)
+			require.Same(t, client, b.KubeClient)
+		})
+	}
+}
