+@pytest.mark.parametrize('module, expected', (
+    (b'#!/usr/bin/python3.8 -I\nprint(1)\n', '#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python\nprint(1)\n', '#!/opt/venv/bin/python'),
+    (b'#!/usr/bin/ruby -w\nputs 1\n', '#!/usr/bin/ruby -w'),
+    (b'print(1)\n', '#!/usr/bin/python'),
+))
+def test_declared_or_default_shebang(mocker, templar, module, expected):
+    mocker.patch('builtins.open', mocker.mock_open(read_data=module))
+    data, style, shebang = modify_module('fake_module', 'fake_path', {}, templar)
+    assert shebang == expected
+    assert data.startswith(expected.encode() + b'\n' + b_ENCODING_STRING + b'\n')
+
+
