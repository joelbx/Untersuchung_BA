--- a/lib/events/emitter_test.go
+++ b/lib/events/emitter_test.go
@@ -20,13 +20,69 @@ import (
 	"bytes"
 	"context"
 	"fmt"
+	"io"
+	"strings"
 	"testing"
 
 	"github.com/gravitational/teleport/lib/session"
 
+	"github.com/gravitational/trace"
 	"github.com/stretchr/testify/require"
 )
 
+type testAuditWriter struct {
+	bytes.Buffer
+	closeCalls int
+	writeErr   error
+}
+
+func (w *testAuditWriter) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	return w.Buffer.Write(p)
+}
+
+func (w *testAuditWriter) Close() error {
+	w.closeCalls++
+	return nil
+}
+
+func TestWriterEmitter(t *testing.T) {
+	w := &testAuditWriter{}
+	emitter := NewWriterEmitter(w)
+	var _ Emitter = emitter
+	var _ IAuditLog = emitter
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.True(t, strings.HasSuffix(w.String(), "\n"))
+	require.Contains(t, w.String(), `"event":"session.start"`)
+
+	w.writeErr = io.ErrClosedPipe
+	require.Error(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 2, w.closeCalls)
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	w1, w2 := &testAuditWriter{}, &testAuditWriter{}
+	first, second := NewWriterEmitter(w1), NewWriterEmitter(w2)
+	multi, err := NewMultiLog(first, second)
+	require.NoError(t, err)
+	var _ Emitter = multi
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent}}
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, w1.String(), w2.String())
+	require.NoError(t, multi.Close())
+	require.Equal(t, 2, w1.closeCalls)
+	require.Equal(t, 2, w2.closeCalls)
+
+	invalid, err := NewMultiLog(NewWriterLog(&testAuditWriter{}))
+	require.Nil(t, invalid)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
