@@ -0,0 +1,47 @@
+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes and its host ref in a limited DOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole } = render(
+            <Dialog ref={ref} open aria-label="Example" data-testid="host" title="Example title">
+                <button type="button">Continue</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(host.tagName).toBe('DIV');
+        expect(host).toHaveAttribute('open');
+        expect(host).toHaveAttribute('data-testid', 'host');
+        expect(host).toHaveAttribute('title', 'Example title');
+        expect(ref.current).toBe(host);
+        expect(getByRole('button', { name: 'Continue' })).toBeInTheDocument();
+    });
+
+    it('uses a native dialog when its modal API is available', () => {
+        const originalShowModal = HTMLDialogElement.prototype.showModal;
+        HTMLDialogElement.prototype.showModal = jest.fn();
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByRole } = render(
+                <Dialog ref={ref} open aria-label="Native" data-testid="native">
+                    <button type="button">Continue</button>
+                </Dialog>
+            );
+
+            const host = getByRole('dialog', { name: 'Native' });
+            expect(host.tagName).toBe('DIALOG');
+            expect(host).toHaveAttribute('open');
+            expect(host).toHaveAttribute('data-testid', 'native');
+            expect(ref.current).toBe(host);
+            expect(getByRole('button', { name: 'Continue' })).toBeInTheDocument();
+        } finally {
+            HTMLDialogElement.prototype.showModal = originalShowModal;
+        }
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
new file mode 100644
index 0000000..6211fd7
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,18 @@
+import { HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props, ref) => {
+    // JSDOM exposes HTMLDialogElement but does not implement its modal API.
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        return <div role="dialog" {...(props as HTMLAttributes<HTMLDivElement>)} ref={ref as unknown as Ref<HTMLDivElement>} />;
+    }
+
+    return <dialog {...props} ref={ref} />;
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
