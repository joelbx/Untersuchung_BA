+func TestDiffDisplayAndCount(t *testing.T) {
+	infos := VulnInfos{
+		"new":  {CveID: "new", DiffStatus: DiffPlus},
+		"old":  {CveID: "old", DiffStatus: DiffMinus},
+		"same": {CveID: "same"},
+	}
+	plus, minus := infos.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Fatalf("CountDiff() = %d, %d", plus, minus)
+	}
+	for _, tc := range []struct {
+		id, diff, plain string
+	}{
+		{"new", "+new", "new"},
+		{"old", "-old", "old"},
+		{"same", "same", "same"},
+	} {
+		if got := infos[tc.id].CveIDDiffFormat(true); got != tc.diff {
+			t.Errorf("diff format %s: got %q, want %q", tc.id, got, tc.diff)
+		}
+		if got := infos[tc.id].CveIDDiffFormat(false); got != tc.plain {
+			t.Errorf("plain format %s: got %q, want %q", tc.id, got, tc.plain)
+		}
+	}
+}
