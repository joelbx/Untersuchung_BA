+func TestDiffDirections(t *testing.T) {
+	current := models.ScanResults{{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"new":  {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "current-pkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"current-pkg": {Name: "current-pkg", Version: "2"}},
+	}}
+	previous := models.ScanResults{{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"old":  {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "previous-pkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"previous-pkg": {Name: "previous-pkg", Version: "1"}},
+	}}
+	for _, tc := range []struct {
+		name        string
+		plus, minus bool
+		want        models.VulnInfos
+	}{
+		{"plus", true, false, models.VulnInfos{"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "current-pkg"}}}}},
+		{"minus", false, true, models.VulnInfos{"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "previous-pkg"}}}}},
+		{"both", true, true, models.VulnInfos{
+			"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "current-pkg"}}},
+			"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "previous-pkg"}}},
+		}},
+		{"neither", false, false, models.VulnInfos{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			results, err := diff(current, previous, tc.plus, tc.minus)
+			if err != nil || len(results) != 1 {
+				t.Fatalf("diff returned %v, %v", results, err)
+			}
+			got := results[0]
+			if !reflect.DeepEqual(got.ScannedCves, tc.want) {
+				t.Errorf("CVEs: got %#v, want %#v", got.ScannedCves, tc.want)
+			}
+			for id, v := range tc.want {
+				name := v.AffectedPackages[0].Name
+				wantVersion := "2"
+				if v.DiffStatus == models.DiffMinus {
+					wantVersion = "1"
+				}
+				if got.Packages[name].Version != wantVersion {
+					t.Errorf("%s package: got %#v, want version %s", id, got.Packages[name], wantVersion)
+				}
+			}
+			plus, minus := got.ScannedCves.CountDiff()
+			if plus+minus != len(tc.want) {
+				t.Errorf("CountDiff: %d plus, %d minus", plus, minus)
+			}
+		})
+	}
+}
