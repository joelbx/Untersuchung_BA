 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey struct{}
+
+// NamespacesKey carries the namespaces visible to the authenticated requester.
+var NamespacesKey contextKey
+
+// NamespacesFromContext returns the evaluated namespaces and whether an evaluation was stored.
+func NamespacesFromContext(ctx context.Context) ([]string, bool) {
+	namespaces, ok := ctx.Value(NamespacesKey).([]string)
+	return namespaces, ok
+}
+
+// FormatNamespaces validates a policy's namespace decision.
+func FormatNamespaces(value any) ([]string, error) {
+	if value == nil {
+		return nil, fmt.Errorf("viewable namespaces are not defined")
+	}
+	switch values := value.(type) {
+	case []string:
+		return values, nil
+	case []any:
+		namespaces := make([]string, 0, len(values))
+		for _, value := range values {
+			name, ok := value.(string)
+			if !ok {
+				return nil, fmt.Errorf("viewable namespaces must contain only strings: %T", value)
+			}
+			namespaces = append(namespaces, name)
+		}
+		return namespaces, nil
+	default:
+		return nil, fmt.Errorf("viewable namespaces must be a list: %T", value)
+	}
+}
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
