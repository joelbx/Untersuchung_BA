 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances        = make(map[string]interface{})
+	getOrCreateC     = make(chan *entry, 1)
+	genericInstances sync.Map
 )
 
+type genericEntry struct {
+	once  sync.Once
+	value interface{}
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// Each distinct type, including pointer and value types, has its own instance.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	stored, _ := genericInstances.LoadOrStore(typeOfT, &genericEntry{})
+	e := stored.(*genericEntry)
+	e.once.Do(func() {
+		value := constructor()
+		e.value = &value
+	})
+	return *e.value.(*T)
+}
+
 type entry struct {
