@@ -17,6 +17,79 @@ func TestSingleton(t *testing.T) {
 	RunSpecs(t, "Singleton Suite")
 }
 
+func TestGetInstance(t *testing.T) {
+	type value struct{ id int }
+	var valueCalls, pointerCalls int
+	valueConstructor := func() value {
+		valueCalls++
+		return value{id: 42}
+	}
+	pointerConstructor := func() *value {
+		pointerCalls++
+		return &value{id: 99}
+	}
+
+	first := singleton.GetInstance(valueConstructor)
+	second := singleton.GetInstance(func() value {
+		t.Fatal("constructor ran for an existing value singleton")
+		return value{}
+	})
+	if first != (value{id: 42}) || second != first || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", first, second, valueCalls)
+	}
+
+	pointer := singleton.GetInstance(pointerConstructor)
+	again := singleton.GetInstance(func() *value {
+		t.Fatal("constructor ran for an existing pointer singleton")
+		return nil
+	})
+	if pointer == nil || pointer.id != 99 || again != pointer || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", pointer, again, pointerCalls)
+	}
+}
+
+func TestGetInstanceNilInterface(t *testing.T) {
+	type service interface{ Serve() }
+	var calls int
+	constructor := func() service {
+		calls++
+		return nil
+	}
+	if singleton.GetInstance(constructor) != nil || singleton.GetInstance(constructor) != nil || calls != 1 {
+		t.Fatalf("nil interface singleton: constructor calls=%d", calls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type instance struct{ id int }
+	const maxCalls = 20000
+	var constructorCalls int32
+	results := make([]*instance, maxCalls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(maxCalls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *instance {
+				atomic.AddInt32(&constructorCalls, 1)
+				return &instance{id: 42}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+	if constructorCalls != 1 {
+		t.Fatalf("constructor called %d times, want 1", constructorCalls)
+	}
+	for i, result := range results {
+		if result == nil || result != results[0] || result.id != 42 {
+			t.Fatalf("call %d returned %p, want %p", i, result, results[0])
+		}
+	}
+}
