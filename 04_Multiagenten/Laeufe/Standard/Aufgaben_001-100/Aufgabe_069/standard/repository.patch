+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		matches []string
+		misses  []string
+	}{
+		{"foo", []string{"foo"}, []string{"foobar", "bar"}},
+		{"*", []string{"", "anything"}, nil},
+		{"foo*bar", []string{"foobar", "foo-baz-bar"}, []string{"xfoobar", "foobarx"}},
+		{"^fo+$", []string{"fo", "foo"}, []string{"xfoo", "foo!"}},
+		{`{{regexp.match("fo+")}}`, []string{"fo", "xfoo!"}, []string{"bar"}},
+		{`{{regexp.not_match("fo+")}}`, []string{"bar"}, []string{"foo", "xfoo!"}},
+		{`foo-{{regexp.match("^bar$")}}-baz`, []string{"foo-bar-baz"}, []string{"foo-xbar-baz", "foo-bar-bazx", "bar"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, in := range tt.matches {
+				assert.True(t, matcher.Match(in), "pattern %q should match %q", tt.pattern, in)
+			}
+			for _, in := range tt.misses {
+				assert.False(t, matcher.Match(in), "pattern %q should not match %q", tt.pattern, in)
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		value   string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`regexp.match("foo")}}`, `is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, `unsupported function namespace other, supported namespaces are email and regexp`},
+		{`{{regexp.unknown("foo")}}`, `unsupported function regexp.unknown, supported functions are: regexp.match, regexp.not_match.`},
+		{`{{email.unknown("foo")}}`, `unsupported function email.unknown, supported functions are: email.local`},
+		{`{{regexp.match("[")}}`, `failed parsing regexp "[":`},
+		{`{{regexp.not_match("[")}}`, `failed parsing regexp "[":`},
+		{`{{regexp.match()}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match("a", "b")}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match(internal.foo)}}`, `expects exactly one string literal argument`},
+		{`{{email.local("foo")}}`, `is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{internal.foo}}`, `is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("foo")}}{{regexp.match("bar")}}`, `is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.value, func(t *testing.T) {
+			_, err := Match(tt.value)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err), "%v", err)
+				assert.True(t, strings.Contains(err.Error(), tt.message), "%v does not contain %q", err, tt.message)
+			}
+		})
+	}
+
+	_, err := Variable(`prefix-{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "prefix-{{regexp.match(\"foo\")}}"`)
+}
