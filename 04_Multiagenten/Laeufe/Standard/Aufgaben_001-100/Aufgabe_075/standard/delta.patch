@@ -0,0 +1,28 @@
+package tests
+
+import "github.com/navidrome/navidrome/model"
+
+type mockUserPropsRepo struct {
+	props  map[string]map[string]string
+	userID string
+}
+
+func (r *mockUserPropsRepo) Put(key, value string) error {
+	if r.props[r.userID] == nil {
+		r.props[r.userID] = make(map[string]string)
+	}
+	r.props[r.userID][key] = value
+	return nil
+}
+
+func (r *mockUserPropsRepo) Get(key string) (string, error) {
+	if value, ok := r.props[r.userID][key]; ok {
+		return value, nil
+	}
+	return "", model.ErrNotFound
+}
+
+func (r *mockUserPropsRepo) Delete(key string) error {
+	delete(r.props[r.userID], key)
+	return nil
+}
