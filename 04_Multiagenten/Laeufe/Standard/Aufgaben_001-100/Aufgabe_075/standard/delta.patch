diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..ac1917f
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,66 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r *userPropsRepository) Put(key, value string) error {
+	owner, err := r.userID()
+	if err != nil {
+		return err
+	}
+	update := Update(r.tableName).Set("value", value).Where(Eq{"user_id": owner, "key": key})
+	count, err := r.executeSQL(update)
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").Values(owner, key, value)
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	owner, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	sel := Select("value").From(r.tableName).Where(Eq{"user_id": owner, "key": key})
+	var resp struct{ Value string }
+	if err := r.queryOne(sel, &resp); err != nil {
+		return "", err
+	}
+	return resp.Value, nil
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	owner, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": owner, "key": key})
+}
+
+func (r *userPropsRepository) userID() (string, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return "", errors.New("user is missing from context")
+	}
+	return u.ID, nil
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..d350c4a
