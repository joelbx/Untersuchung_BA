+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,40 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	It("keeps keys scoped to the contextual user and supports updates and deletes", func() {
+		o := orm.NewOrm()
+		for _, id := range []string{"props-user-a", "props-user-b"} {
+			_, err := o.Raw(`insert into user (id, user_name, email, created_at, updated_at) values (?, ?, ?, datetime('now'), datetime('now'))`, id, id, id+"@example.test").Exec()
+			Expect(err).To(BeNil())
+		}
+		defer func() {
+			_, _ = o.Raw(`delete from user where id in (?, ?)`, "props-user-a", "props-user-b").Exec()
+		}()
+
+		ctx := log.NewContext(context.Background())
+		a := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "props-user-a"}), o)
+		b := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "props-user-b"}), o)
+		Expect(a.Put("key", "first")).To(Succeed())
+		_, err := b.Get("key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(b.Put("key", "second")).To(Succeed())
+		Expect(a.Put("key", "updated")).To(Succeed())
+		Expect(a.Get("key")).To(Equal("updated"))
+		Expect(b.Get("key")).To(Equal("second"))
+		Expect(a.Delete("key")).To(Succeed())
+		_, err = a.Get("key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(b.Get("key")).To(Equal("second"))
+	})
+})
