+func TestStringToStringSliceHookFunc(t *testing.T) {
+	hook := stringToStringSliceHookFunc().(func(reflect.Type, reflect.Type, interface{}) (interface{}, error))
+
+	tests := []struct {
+		name   string
+		input  interface{}
+		target reflect.Type
+		want   interface{}
+	}{
+		{"whitespace", "  foo.com\tbar.com \n baz.com  ", reflect.TypeOf([]string{}), []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "", reflect.TypeOf([]string{}), []string{}},
+		{"only whitespace", " \t\n ", reflect.TypeOf([]string{}), []string{}},
+		{"existing slice", []string{"foo.com bar.com"}, reflect.TypeOf([]string{}), []string{"foo.com bar.com"}},
+		{"existing sequence", []interface{}{"foo.com", "bar.com"}, reflect.TypeOf([]string{}), []interface{}{"foo.com", "bar.com"}},
+		{"other target", "foo.com bar.com", reflect.TypeOf([]interface{}{}), "foo.com bar.com"},
+		{"non-string", 42, reflect.TypeOf([]string{}), 42},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(reflect.TypeOf(tt.input), tt.target, tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadEmptyAllowedOrigins(t *testing.T) {
+	path := t.TempDir() + "/empty-origins.yml"
+	require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: \"\"\n"), 0600))
+
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, []string{}, cfg.Cors.AllowedOrigins)
+}
