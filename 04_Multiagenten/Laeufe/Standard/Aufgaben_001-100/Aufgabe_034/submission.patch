+def test_get_ia_record_normalizes_mixed_and_empty_identification_fields() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'isbn': [' 1451654685 ', ' 978-1-4516-5468-4 ', 'invalid', ''],
+            'publisher': [' Plain Publisher ', ' New York : Simon & Schuster ', ' '],
+        }
+    )
+    assert result['isbn_10'] == ['1451654685']
+    assert result['isbn_13'] == ['9781451654684']
+    assert result['publishers'] == ['Plain Publisher', 'Simon & Schuster']
+    assert result['publish_places'] == ['New York']
+    assert 'isbn' not in result and 'publisher' not in result
+
+    result = code.ia_importapi.get_ia_record(
+        {'isbn': [' ', 'invalid'], 'publisher': ['', ' : ']}
+    )
+    assert not any(
+        field in result
+        for field in ('isbn', 'isbn_10', 'isbn_13', 'publisher', 'publishers', 'publish_places')
+    )
+
