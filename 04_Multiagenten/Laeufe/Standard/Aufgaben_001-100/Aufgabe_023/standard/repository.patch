diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..d5c1f77
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,43 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	var cfg AuthenticationConfig
+	assert.False(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+
+	for _, info := range cfg.Methods.AllMethods() {
+		info := info
+		t.Run(info.Name(), func(t *testing.T) {
+			var cfg AuthenticationConfig
+			for _, method := range cfg.Methods.AllMethods() {
+				if method.Method == info.Method {
+					assert.Equal(t, info.Name() != "jwt", method.RequiresDatabase)
+					method.SetCleanup(t, AuthenticationCleanupSchedule{Interval: time.Hour})
+					assert.False(t, cfg.RequiresDatabase(), "disabled method")
+					assert.False(t, cfg.ShouldRunCleanup(), "disabled method")
+					method.Enable(t)
+				}
+			}
+
+			assert.Equal(t, info.RequiresDatabase, cfg.RequiresDatabase())
+			assert.Equal(t, info.RequiresDatabase, cfg.ShouldRunCleanup())
+		})
+	}
+
+	cfg.Methods.JWT.Enabled = true
+	cfg.Methods.JWT.Cleanup = &AuthenticationCleanupSchedule{}
+	assert.False(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+	cfg.Methods.Token.Enabled = true
+	assert.True(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+	cfg.Methods.Token.Cleanup = &AuthenticationCleanupSchedule{}
+	assert.True(t, cfg.ShouldRunCleanup())
+}
