+        'reuses API error %s for the same link and retries after backoff',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequst.mockRejectedValueOnce(error);
+            const { result } = renderHook(() => useLink());
+
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', `missing-${code}`, {})).rejects.toBe(
+                error
+            );
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', `missing-${code}`, {})).rejects.toBe(
+                error
+            );
+            expect(mockRequst).toHaveBeenCalledTimes(1);
+
+            jest.advanceTimersByTime(10_000);
+            mockRequst.mockRejectedValueOnce(error);
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', `missing-${code}`, {})).rejects.toBe(
+                error
+            );
+            expect(mockRequst).toHaveBeenCalledTimes(2);
+        }
