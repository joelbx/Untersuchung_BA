+        await expect(result.current.setSignatureIssues(abortSignal, 'share', 'missing-isolation', {})).rejects.toBe(
+            error
+        );
+        await result.current.setSignatureIssues(abortSignal, 'share', 'valid', {});
+        await result.current.setSignatureIssues(abortSignal, 'other-share', 'missing-isolation', {});
+
+        expect(mockRequst).toHaveBeenCalledTimes(3);
+        expect(state.setLinks).toHaveBeenCalledWith('share', [
+            { encrypted: expect.objectContaining({ linkId: 'valid' }) },
+        ]);
+    });
+
+    it('does not cache other API errors', async () => {
