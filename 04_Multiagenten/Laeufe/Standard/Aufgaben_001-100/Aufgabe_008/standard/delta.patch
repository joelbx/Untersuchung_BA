+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.setSignatureIssues(abortSignal, 'share', 'other-error', {})).rejects.toBe(error);
+        await expect(result.current.setSignatureIssues(abortSignal, 'share', 'other-error', {})).rejects.toBe(error);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
