+    def test_jwrite_replaces_complete_record(self, tmp_path, monkeypatch):
+        path = str(tmp_path / 'job')
+        with open(path, 'w') as f:
+            json.dump({'old': True}, f)
+        monkeypatch.setattr(async_wrapper, 'job_path', path)
+        rename = os.rename
+
+        def check_rename(src, dst):
+            with open(dst) as f:
+                assert json.load(f) == {'old': True}
+            with open(src) as f:
+                assert json.load(f) == {'new': True}
+            rename(src, dst)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', check_rename)
+        async_wrapper.jwrite({'new': True})
+        with open(path) as f:
+            assert json.load(f) == {'new': True}
+
+    def test_first_fork_failure(self, tmp_path, monkeypatch, capsys):
+        def fail_fork():
+            raise OSError(11, 'temporarily unavailable')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', '123', '5', '/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['ansible_job_id'].startswith('123.')
+        with open(str(tmp_path / response['ansible_job_id'])) as f:
+            assert json.load(f) == response
+
+    def test_directory_failure_is_structured(self, tmp_path, monkeypatch, capsys):
+        jobdir = tmp_path / 'file'
+        jobdir.write_text('not a directory')
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', '123', '5', '/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(jobdir))
+        with pytest.raises(SystemExit):
+            async_wrapper.main()
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['started'] == 0
+        assert response['finished'] == 1
+        assert response['ansible_job_id'].startswith('123.')
+
+    @pytest.mark.parametrize('script,limit,failed', [
+        ("print('{\"rc\": 0}')", 5, False),
+        ('import time; time.sleep(10)', 1, True),
+    ])
+    def test_process_lifecycle(self, tmp_path, script, limit, failed):
+        module = tmp_path / 'module.py'
+        module.write_text('#!%s\n%s\n' % (sys.executable, script))
+        jobdir = tmp_path / 'jobs'
+        env = os.environ.copy()
+        env['ANSIBLE_ASYNC_DIR'] = str(jobdir)
+        env['PYTHONPATH'] = os.path.join(os.getcwd(), 'lib')
+        proc = subprocess.Popen([sys.executable, '-m', 'ansible.modules.async_wrapper',
+                                 '123', str(limit), str(module), '_'],
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+        stdout, stderr = proc.communicate(timeout=10)
+        assert proc.returncode == 0, stderr
+        assert len(stdout.splitlines()) == 1
+        immediate = json.loads(stdout)
+        assert immediate['started'] == 1
+        assert immediate['finished'] == 0
+        deadline = time.time() + 8
+        while time.time() < deadline:
+            with open(immediate['results_file']) as f:
+                result = json.load(f)
+            if result['finished']:
+                break
+            time.sleep(0.1)
+        assert result['finished'] == 1
+        assert result['failed'] is failed
+        assert result['ansible_job_id'] == immediate['ansible_job_id']
+        if failed:
+            assert result['child_pid'] > 0
