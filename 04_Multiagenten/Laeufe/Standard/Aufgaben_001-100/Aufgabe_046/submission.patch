+class ModuleUtilLocatorBase:
+    """Resolve one import without executing module_utils code on the controller."""
+    prefix_length = 0
+    redirect_first = False
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False):
+        self.fq_name_parts = tuple(fq_name_parts)
+        self.is_ambiguous = is_ambiguous and len(self.fq_name_parts) > self.prefix_length + 1
+        self.child_is_redirected = child_is_redirected
+        self.found = False
+        self.redirected = False
+        self.is_package = False
+        self.name_parts = self.fq_name_parts
+        self.output_path = None
+        self.source = None
+        self.path = None
+        self.redirect_target = None
+
+    def candidate_names_joined(self):
+        candidates = [self.fq_name_parts]
+        if self.is_ambiguous:
+            candidates.append(self.fq_name_parts[:-1])
+        return ['.'.join(parts) for parts in candidates]
+
+    def _set_source(self, parts, source, path, is_package=False):
+        self.found = True
+        self.name_parts = parts
+        self.source = source
+        self.path = path
+        self.is_package = is_package
+        self.output_path = '/'.join(parts) + ('/__init__.py' if is_package else '.py')
+
+    def _set_redirect(self, parts, target):
+        self.redirected = self.found = True
+        self.name_parts = parts
+        self.redirect_target = target
+        self.is_package = False
+        self.output_path = '/'.join(parts) + '.py'
+        self.path = self.output_path
+        self.source = ("import sys\nimport %s as mod\nsys.modules[%r] = mod\n" %
+                       ('.'.join(target), '.'.join(parts))).encode('utf-8')
+
+    def resolve(self):
+        for candidate in (self.fq_name_parts, self.fq_name_parts[:-1]) if self.is_ambiguous else (self.fq_name_parts,):
+            methods = (self._redirect, self._local) if self.redirect_first else (self._local, self._redirect)
+            for method in methods:
+                if method(candidate):
+                    return self
+        return self
+
+
+class LegacyModuleUtilLocator(ModuleUtilLocatorBase):
