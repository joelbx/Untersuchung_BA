+    def _redirect(self, parts):
+        collection = '.'.join(parts[1:3])
+        name = '.'.join(parts[5:])
+        entry = self._metadata(parts).get('plugin_routing', {}).get('module_utils', {}).get(name, {})
+        if not entry:
