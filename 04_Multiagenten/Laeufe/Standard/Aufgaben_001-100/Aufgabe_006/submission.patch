--- /dev/null
+++ b/lib/utils/fanoutbuffer/buffer.go
@@ -0,0 +1,291 @@
+// Package fanoutbuffer provides an ordered, concurrent buffer with independent
+// cursors for each consumer.
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+var (
+	ErrGracePeriodExceeded = errors.New("fanout buffer grace period exceeded")
+	ErrUseOfClosedCursor   = errors.New("use of closed fanout buffer cursor")
+	ErrBufferClosed        = errors.New("fanout buffer closed")
+)
+
+// Config controls the buffer's capacity and how long lagging cursors may use
+// the overflow backlog.
+type Config struct {
+	Capacity    uint64
+	GracePeriod time.Duration
+	Clock       clockwork.Clock
+}
+
+// SetDefaults fills in unset configuration values.
+func (c *Config) SetDefaults() {
+	if c.Capacity == 0 {
+		c.Capacity = 64
+	}
+	if c.GracePeriod == 0 {
+		c.GracePeriod = 5 * time.Minute
+	}
+	if c.Clock == nil {
+		c.Clock = clockwork.NewRealClock()
+	}
+}
+
+// Buffer distributes appended items to all cursors that were present when
+// those items were appended. All fields are protected by mu.
+type Buffer[T any] struct {
+	mu        sync.Mutex
+	cfg       Config
+	ring      []T
+	start     uint64 // first sequence number in ring
+	next      uint64 // sequence number assigned to the next append
+	overflow  []T    // items immediately preceding start
+	overStart uint64
+	cursors   map[*Cursor[T]]struct{}
+	notify    chan struct{}
+	closed    bool
+}
+
+// NewBuffer creates a buffer using cfg.
+func NewBuffer[T any](cfg Config) *Buffer[T] {
+	cfg.SetDefaults()
+	return &Buffer[T]{
+		cfg:     cfg,
+		ring:    make([]T, cfg.Capacity),
+		cursors: make(map[*Cursor[T]]struct{}),
+		notify:  make(chan struct{}),
+	}
+}
+
+// Append adds items in order and wakes blocked readers. Appends after Close
+// have no effect.
+func (b *Buffer[T]) Append(items ...T) {
+	if len(items) == 0 {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed || len(b.cursors) == 0 {
+		return
+	}
+	for _, item := range items {
+		b.expireLocked()
+		if len(b.cursors) == 0 {
+			b.clearLocked()
+			break
+		}
+		if b.next-b.start == uint64(len(b.ring)) {
+			oldest := b.start
+			if len(b.overflow) == 0 {
+				b.overStart = oldest
+			}
+			b.overflow = append(b.overflow, b.ring[oldest%uint64(len(b.ring))])
+			b.start++
+			now := b.cfg.Clock.Now()
+			for c := range b.cursors {
+				if c.pos < b.start && c.lagSince.IsZero() {
+					c.lagSince = now
+				}
+			}
+		}
+		b.ring[b.next%uint64(len(b.ring))] = item
+		b.next++
+	}
+	b.cleanupLocked()
+	close(b.notify)
+	b.notify = make(chan struct{})
+}
+
+// Cursor reads items appended after it was created.
+type Cursor[T any] struct {
+	buffer   *Buffer[T]
+	pos      uint64
+	lagSince time.Time
+	err      error
+	closed   bool
+	done     chan struct{}
+}
+
+// NewCursor subscribes to future appends. A cursor created on a closed buffer
+// reports ErrBufferClosed when read.
+func (b *Buffer[T]) NewCursor() *Cursor[T] {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	c := &Cursor[T]{buffer: b, pos: b.next, done: make(chan struct{})}
+	if b.closed {
+		c.err = ErrBufferClosed
+	} else {
+		b.cursors[c] = struct{}{}
+	}
+	return c
+}
+
+// Close closes the buffer, wakes readers, and releases retained items.
+func (b *Buffer[T]) Close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.closed = true
+	for c := range b.cursors {
+		c.err = ErrBufferClosed
+		delete(b.cursors, c)
+	}
+	b.clearLocked()
+	b.ring = nil
+	close(b.notify)
+}
+
+// TryRead copies available items into out without waiting.
+func (c *Cursor[T]) TryRead(out []T) (int, error) {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return c.tryReadLocked(out)
+}
+
+func (c *Cursor[T]) tryReadLocked(out []T) (int, error) {
+	b := c.buffer
+	if c.closed {
+		return 0, ErrUseOfClosedCursor
+	}
+	if c.err != nil {
+		return 0, c.err
+	}
+	if b.closed {
+		return 0, ErrBufferClosed
+	}
+	if c.pos < b.start && !c.lagSince.IsZero() &&
+		!b.cfg.Clock.Now().Before(c.lagSince.Add(b.cfg.GracePeriod)) {
+		c.err = ErrGracePeriodExceeded
+		delete(b.cursors, c)
+		b.cleanupLocked()
+		return 0, c.err
+	}
+	if len(out) == 0 || c.pos == b.next {
+		return 0, nil
+	}
+	n := 0
+	for n < len(out) && c.pos < b.start {
+		out[n] = b.overflow[c.pos-b.overStart]
+		c.pos++
+		n++
+	}
+	for n < len(out) && c.pos < b.next {
+		remaining := len(out) - n
+		contiguous := len(b.ring) - int(c.pos%uint64(len(b.ring)))
+		available := int(b.next - c.pos)
+		if remaining > contiguous {
+			remaining = contiguous
+		}
+		if remaining > available {
+			remaining = available
+		}
+		copy(out[n:n+remaining], b.ring[c.pos%uint64(len(b.ring)):])
+		c.pos += uint64(remaining)
+		n += remaining
+	}
+	if c.pos >= b.start {
+		c.lagSince = time.Time{}
+	}
+	b.cleanupLocked()
+	return n, nil
+}
+
+// Read waits for at least one item, cancellation, or closure. A zero-length
+// output slice returns immediately.
+func (c *Cursor[T]) Read(ctx context.Context, out []T) (int, error) {
+	for {
+		b := c.buffer
+		b.mu.Lock()
+		n, err := c.tryReadLocked(out)
+		if n != 0 || err != nil || len(out) == 0 {
+			b.mu.Unlock()
+			return n, err
+		}
+		notify := b.notify
+		b.mu.Unlock()
+		select {
+		case <-notify:
+		case <-c.done:
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		}
+	}
+}
+
+// Close releases the cursor and wakes any blocked reads. It is idempotent.
+func (c *Cursor[T]) Close() error {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	close(c.done)
+	delete(b.cursors, c)
+	b.cleanupLocked()
+	return nil
+}
+
+func (b *Buffer[T]) expireLocked() {
+	now := b.cfg.Clock.Now()
+	for c := range b.cursors {
+		if c.pos < b.start && !c.lagSince.IsZero() &&
+			!now.Before(c.lagSince.Add(b.cfg.GracePeriod)) {
+			c.err = ErrGracePeriodExceeded
+			delete(b.cursors, c)
+		}
+	}
+	b.cleanupLocked()
+}
+
+func (b *Buffer[T]) cleanupLocked() {
+	min := b.next
+	for c := range b.cursors {
+		if c.pos < min {
+			min = c.pos
+		}
+	}
+	if min > b.overStart && len(b.overflow) != 0 {
+		drop := min - b.overStart
+		if drop > uint64(len(b.overflow)) {
+			drop = uint64(len(b.overflow))
+		}
+		clear(b.overflow[:drop])
+		b.overflow = b.overflow[drop:]
+		b.overStart += drop
+		if len(b.overflow) == 0 {
+			b.overflow = nil
+		} else if len(b.overflow)*2 < cap(b.overflow) {
+			b.overflow = append([]T(nil), b.overflow...)
+		}
+	}
+	if min > b.start {
+		end := min
+		if end > b.next {
+			end = b.next
+		}
+		for seq := b.start; seq < end; seq++ {
+			var zero T
+			b.ring[seq%uint64(len(b.ring))] = zero
+		}
+		b.start = end
+	}
+}
+
+func (b *Buffer[T]) clearLocked() {
+	clear(b.ring)
+	b.overflow = nil
+	b.start = b.next
+	b.overStart = b.next
+}
diff --git a/lib/utils/fanoutbuffer/buffer_test.go b/lib/utils/fanoutbuffer/buffer_test.go
new file mode 100644
index 0000000..d71cc86
--- /dev/null
+++ b/lib/utils/fanoutbuffer/buffer_test.go
@@ -0,0 +1,153 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestOrderAcrossOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	slow := b.NewCursor()
+	fast := b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	first := make([]int, 2)
+	n, err := fast.TryRead(first)
+	if err != nil || n != 2 || !reflect.DeepEqual(first, []int{1, 2}) {
+		t.Fatalf("fast first read: %v, %v, %v", first, n, err)
+	}
+	b.Append(6, 7)
+	out := make([]int, 7)
+	n, err = slow.TryRead(out)
+	if err != nil || n != 7 || !reflect.DeepEqual(out, []int{1, 2, 3, 4, 5, 6, 7}) {
+		t.Fatalf("slow read: %v, %v, %v", out, n, err)
+	}
+	out = make([]int, 5)
+	n, err = fast.TryRead(out)
+	if err != nil || n != 5 || !reflect.DeepEqual(out, []int{3, 4, 5, 6, 7}) {
+		t.Fatalf("fast second read: %v, %v, %v", out, n, err)
+	}
+	late := b.NewCursor()
+	if n, err := late.TryRead(make([]int, 1)); n != 0 || err != nil {
+		t.Fatalf("late cursor received old items: %d, %v", n, err)
+	}
+}
+
+func TestGracePeriodAndCleanup(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[*int](Config{Capacity: 1, GracePeriod: time.Minute, Clock: clock})
+	slow := b.NewCursor()
+	fast := b.NewCursor()
+	a, value := 1, 2
+	b.Append(&a, &value)
+	out := make([]*int, 2)
+	if n, err := fast.TryRead(out); n != 2 || err != nil || out[0] != &a || out[1] != &value {
+		t.Fatalf("fast read: %d, %v, %v", n, err, out)
+	}
+	clock.Advance(time.Minute)
+	if n, err := slow.TryRead(make([]*int, 2)); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("expired read: %d, %v", n, err)
+	}
+	if len(b.overflow) != 0 || b.ring[0] != nil {
+		t.Fatal("consumed items retained")
+	}
+	if err := slow.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := slow.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := slow.TryRead(out); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+}
+
+func TestBlockedReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	b.Close()
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("read after buffer close: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read did not wake")
+	}
+	if _, err := b.NewCursor().TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("new cursor after close: %v", err)
+	}
+}
+
+func TestReadCancellationAndCursorClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	defer b.Close()
+	c := b.NewCursor()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled read: %v", err)
+	}
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrUseOfClosedCursor) {
+			t.Fatalf("read after cursor close: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read did not wake")
+	}
+}
+
+func TestConcurrentCursors(t *testing.T) {
+	const consumers, count = 8, 1000
+	b := NewBuffer[int](Config{Capacity: 16})
+	defer b.Close()
+	var wg sync.WaitGroup
+	for i := 0; i < consumers; i++ {
+		c := b.NewCursor()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer c.Close()
+			out := make([]int, 37)
+			seen := 0
+			for seen < count {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, item := range out[:n] {
+					if item != seen {
+						t.Errorf("item %d: got %d", seen, item)
+						return
+					}
+					seen++
+				}
+			}
+		}()
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
