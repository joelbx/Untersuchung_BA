+def _normalized_language_name(name: str) -> str:
+    return ''.join(
+        char for char in normalize('NFD', name.casefold()) if not 0x300 <= ord(char) <= 0x36F
+    )
+
+
+@cache
+def _language_name_codes() -> dict[str, str | None]:
+    """Map English and native language names to Open Library's MARC codes."""
+    from openlibrary.plugins.upstream.utils import get_marc21_language
+
+    names: dict[str, str | None] = {}
+    for iso_code, english_name in Locale('en').languages.items():
+        if len(iso_code) != 2 or not (marc_code := get_marc21_language(iso_code)):
+            continue
+
+        try:
+            native_name = Locale.parse(iso_code).languages.get(iso_code)
+        except (ValueError, UnknownLocaleError):
+            native_name = None
+
+        for name in (english_name, native_name):
+            if name:
+                normalized = _normalized_language_name(name)
+                if normalized in names and names[normalized] != marc_code:
+                    names[normalized] = None  # Ambiguous names must not resolve arbitrarily.
+                else:
+                    names[normalized] = marc_code
+    return names
+
