+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        get_db().query("""
+            CREATE TABLE booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL DEFAULT -1,
+                notes text NOT NULL,
+                PRIMARY KEY (username, work_id, edition_id)
+            );
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.insert("booknotes", username="alice", work_id=1,
+                       edition_id=-1, notes="source")
+
+    def teardown_method(self):
+        self.db.query("DELETE FROM booknotes")
+
+    def test_conflict_preserves_all_records(self):
+        self.db.insert("booknotes", username="alice", work_id=1,
+                       edition_id=3, notes="another source note")
+        self.db.insert("booknotes", username="alice", work_id=2,
+                       edition_id=-1, notes="destination")
+        before = list(self.db.select("booknotes", order="work_id, edition_id"))
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert list(self.db.select("booknotes", order="work_id, edition_id")) == before
+
+    def test_existing_destination_for_another_user_is_a_conflict(self):
+        self.db.insert("booknotes", username="bob", work_id=2,
+                       edition_id=-1, notes="another user's note")
+        before = list(self.db.select("booknotes", order="work_id"))
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert list(self.db.select("booknotes", order="work_id")) == before
+
+    def test_success_and_dry_run(self):
+        assert Booknotes.update_work_id(1, 2, _test=True) == {
+            "rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert list(self.db.select("booknotes"))[0].work_id == 1
+
+        assert Booknotes.update_work_id(1, 2) == {
+            "rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert list(self.db.select("booknotes"))[0].work_id == 2
