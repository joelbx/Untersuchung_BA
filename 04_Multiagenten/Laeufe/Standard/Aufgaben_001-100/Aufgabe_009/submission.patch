+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-1', display_name: 'Old name', isVerified: false };
+
+    it('shows the device ID when the name is undefined', () => {
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ ...device, display_name: undefined }}
+            saveDeviceName={jest.fn()}
+        />);
+        expect(getByTestId('device-name-read').textContent).toBe('device-1');
+    });
+
+    it('saves a changed name and returns to the read view', async () => {
+        let resolveSave: () => void;
+        const saveDeviceName = jest.fn().mockImplementation(() => new Promise<void>(resolve => {
+            resolveSave = resolve;
+        }));
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+        fireEvent.click(getByTestId('device-name-rename'));
+        expect(getByTestId('device-name-input').getAttribute('maxLength')).toBe('100');
+        expect(getByTestId('device-name-edit').textContent).toContain('Session names may be visible');
+        fireEvent.change(getByTestId('device-name-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(getByTestId('device-name-save'));
+        expect(saveDeviceName).toHaveBeenCalledWith('device-1', 'Work Laptop');
+        expect(getByTestId('device-name-saving')).toBeTruthy();
+        resolveSave();
+        await waitFor(() => expect(getByTestId('device-detail-heading').textContent).toContain('Work Laptop'));
+        expect(queryByTestId('device-name-edit')).toBeNull();
+    });
+
+    it('accepts an empty name and skips an unchanged name', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-name-rename'));
+        fireEvent.click(getByTestId('device-name-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        fireEvent.click(getByTestId('device-name-rename'));
+        fireEvent.change(getByTestId('device-name-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading')).toBeTruthy());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-1', '');
+        expect(getByTestId('device-name-read').textContent).toBe('');
+    });
+
+    it('cancels without saving and shows a failed save error', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('network error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-name-rename'));
+        fireEvent.change(getByTestId('device-name-input'), { target: { value: 'New name' } });
+        fireEvent.click(getByTestId('device-name-save'));
+        await waitFor(() => expect(getByTestId('device-name-error').textContent).toBe('Failed to set display name.'));
+        fireEvent.click(getByTestId('device-name-cancel'));
+        expect(getByTestId('device-detail-heading').textContent).toContain('Old name');
+        expect(saveDeviceName).toHaveBeenCalledTimes(1);
+    });
+});
