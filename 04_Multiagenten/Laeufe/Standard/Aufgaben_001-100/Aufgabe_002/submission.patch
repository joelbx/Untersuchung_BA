+// KubeAddr returns the public HTTPS address of this proxy's Kubernetes endpoint.
+func (p ProxyConfig) KubeAddr() (string, error) {
+	if !p.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	var addr utils.NetAddr
+	switch {
+	case len(p.Kube.PublicAddrs) > 0:
+		addr = p.Kube.PublicAddrs[0]
+	case len(p.PublicAddrs) > 0:
+		addr = p.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("no public proxy address configured")
+	}
+	if addr.Path != "" || addr.AddrNetwork == "unix" {
+		return "", trace.BadParameter("invalid public proxy address %q", addr.String())
+	}
+	value := addr.String()
+	host, port, err := net.SplitHostPort(value)
+	if err == nil {
+		n, parseErr := strconv.Atoi(port)
+		if parseErr != nil || n < 1 || n > 65535 {
+			return "", trace.BadParameter("invalid public proxy address %q", value)
+		}
+	} else {
+		host = value
+		if strings.Contains(value, ":") && net.ParseIP(strings.Trim(value, "[]")) == nil {
+			return "", trace.BadParameter("invalid public proxy address %q", value)
+		}
+		host = strings.Trim(host, "[]")
+	}
+	if host == "" || strings.ContainsAny(host, " \t\r\n/?#@%\\") ||
+		(strings.Contains(host, ":") && net.ParseIP(host) == nil) {
+		return "", trace.BadParameter("invalid public proxy address %q", value)
+	}
+	return (&url.URL{Scheme: "https", Host: net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+}
