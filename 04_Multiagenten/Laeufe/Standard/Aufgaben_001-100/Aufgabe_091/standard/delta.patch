diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..b2cf1b3
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,62 @@
+package evaluation
+
+import (
+	"errors"
+	"testing"
+
+	ferrors "go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/storage"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestListOperatorsString(t *testing.T) {
+	tests := []struct {
+		name, operator, list, input string
+		want                        bool
+	}{
+		{"member", flipt.OpIsOneOf, `["a","b"]`, "b", true},
+		{"nonmember", flipt.OpIsOneOf, `["a","b"]`, "c", false},
+		{"excluded member", flipt.OpIsNotOneOf, `["a","b"]`, "b", false},
+		{"excluded nonmember", flipt.OpIsNotOneOf, `["a","b"]`, "c", true},
+		{"empty member", flipt.OpIsOneOf, `[""]`, "", true},
+		{"empty nonmember", flipt.OpIsNotOneOf, `["a"]`, "", true},
+		{"invalid", flipt.OpIsNotOneOf, `[1]`, "a", false},
+		{"null", flipt.OpIsOneOf, `null`, "a", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := matchesString(storage.EvaluationConstraint{Operator: tt.operator, Value: tt.list}, tt.input)
+			if got != tt.want {
+				t.Fatalf("matchesString() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestListOperatorsNumber(t *testing.T) {
+	tests := []struct {
+		name, operator, list, input string
+		want                        bool
+		wantErr                     bool
+	}{
+		{"member", flipt.OpIsOneOf, `[1,2.5]`, "2.5", true, false},
+		{"nonmember", flipt.OpIsOneOf, `[1,2.5]`, "3", false, false},
+		{"excluded member", flipt.OpIsNotOneOf, `[1,2.5]`, "1", false, false},
+		{"excluded nonmember", flipt.OpIsNotOneOf, `[1,2.5]`, "3", true, false},
+		{"invalid JSON", flipt.OpIsOneOf, `[1,`, "1", false, true},
+		{"mixed types", flipt.OpIsNotOneOf, `[1,"2"]`, "1", false, true},
+		{"null", flipt.OpIsOneOf, `null`, "1", false, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := matchesNumber(storage.EvaluationConstraint{Property: "age", Operator: tt.operator, Value: tt.list}, tt.input)
+			if got != tt.want {
+				t.Fatalf("matchesNumber() = %v, want %v", got, tt.want)
+			}
+			var invalid ferrors.ErrInvalid
+			if errors.As(err, &invalid) != tt.wantErr {
+				t.Fatalf("matchesNumber() error = %v, want ErrInvalid = %v", err, tt.wantErr)
+			}
+		})
+	}
+}
diff --git a/rpc/flipt/list_operators_test.go b/rpc/flipt/list_operators_test.go
new file mode 100644
index 0000000..353f700
--- /dev/null
+++ b/rpc/flipt/list_operators_test.go
@@ -0,0 +1,51 @@
+package flipt
+
+import (
+	stderrors "errors"
+	"strings"
+	"testing"
+
+	ferrors "go.flipt.io/flipt/errors"
+)
+
+func TestValidateListOperators(t *testing.T) {
+	for _, operation := range []string{"create", "update"} {
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			for _, tt := range []struct {
+				name, value, wantErr string
+				typ                  ComparisonType
+			}{
+				{"strings", `["a","b"]`, "", ComparisonType_STRING_COMPARISON_TYPE},
+				{"numbers", `[1,2.5]`, "", ComparisonType_NUMBER_COMPARISON_TYPE},
+				{"empty array", `[]`, "", ComparisonType_STRING_COMPARISON_TYPE},
+				{"100 strings", `[` + strings.Repeat(`"a",`, 99) + `"a"]`, "", ComparisonType_STRING_COMPARISON_TYPE},
+				{"101 strings", `[` + strings.Repeat(`"a",`, 100) + `"a"]`, `too many values provided for property "age" of type string (maximum 100)`, ComparisonType_STRING_COMPARISON_TYPE},
+				{"101 numbers", `[` + strings.Repeat(`1,`, 100) + `1]`, `too many values provided for property "age" of type number (maximum 100)`, ComparisonType_NUMBER_COMPARISON_TYPE},
+				{"mixed strings", `["a",1]`, `invalid value provided for property "age" of type string`, ComparisonType_STRING_COMPARISON_TYPE},
+				{"mixed numbers", `[1,"2"]`, `invalid value provided for property "age" of type number`, ComparisonType_NUMBER_COMPARISON_TYPE},
+				{"malformed", `[`, `invalid value provided for property "age" of type string`, ComparisonType_STRING_COMPARISON_TYPE},
+				{"null", `null`, `invalid value provided for property "age" of type number`, ComparisonType_NUMBER_COMPARISON_TYPE},
+				{"object", `{}`, `invalid value provided for property "age" of type string`, ComparisonType_STRING_COMPARISON_TYPE},
+			} {
+				t.Run(operation+"/"+operator+"/"+tt.name, func(t *testing.T) {
+					var err error
+					if operation == "create" {
+						err = (&CreateConstraintRequest{SegmentKey: "segment", Property: "age", Operator: operator, Type: tt.typ, Value: tt.value}).Validate()
+					} else {
+						err = (&UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "age", Operator: operator, Type: tt.typ, Value: tt.value}).Validate()
+					}
+					if tt.wantErr == "" {
+						if err != nil {
+							t.Fatalf("Validate() = %v, want nil", err)
+						}
+						return
+					}
+					var invalid ferrors.ErrInvalid
+					if !stderrors.As(err, &invalid) || err.Error() != tt.wantErr {
+						t.Fatalf("Validate() = %v, want ErrInvalid %q", err, tt.wantErr)
+					}
+				})
+			}
+		}
+	}
+}
