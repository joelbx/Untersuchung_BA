+import punycode from 'punycode.js';
+
 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
 
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(
+        /^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^/?#@]*@)?(?:[^./:?#]+\.)*([^./:?#]+)\.[^./:?#]+(?::\d+)?(?:[/?#]|$)/i
+    );
+    return match?.[1] || '';
+};
+
+export const punycodeUrl = (url: string): string => {
+    const parsed = new URL(url);
+    const match = url.match(/^([a-z][a-z\d+.-]*:\/\/)([^/?#]*)([^?#]*)(\?[^#]*)?(#.*)?$/i);
+    if (!match || !parsed.hostname) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const [, protocol, authority, path, search = '', hash = ''] = match;
+    const credentialsEnd = authority.lastIndexOf('@') + 1;
+    const hostAndPort = authority.slice(credentialsEnd);
+    const hostnameEnd = hostAndPort.startsWith('[')
+        ? hostAndPort.indexOf(']') + 1
+        : hostAndPort.indexOf(':') === -1
+        ? hostAndPort.length
+        : hostAndPort.indexOf(':');
+    const encodedAuthority = `${authority.slice(0, credentialsEnd)}${punycode.toASCII(
+        parsed.hostname
+    )}${hostAndPort.slice(hostnameEnd)}`;
+
+    return `${protocol}${encodedAuthority}${path.replace(/\/+$/, '')}${search}${hash}`;
+};
