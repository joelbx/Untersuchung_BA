@@ -1,9 +1,19 @@
 package hasher
 
-import "hash/maphash"
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"hash/maphash"
+	"strconv"
+	"sync"
+)
 
 var instance = NewHasher()
 
+func SetSeed(id, seed string) {
+	instance.SetSeed(id, seed)
+}
+
 func Reseed(id string) {
 	instance.Reseed(id)
 }
@@ -12,33 +22,45 @@ func HashFunc() func(id, str string) uint64 {
 	return instance.HashFunc()
 }
 
-type hasher struct {
-	seeds map[string]maphash.Seed
+type Hasher struct {
+	mu         sync.Mutex
+	seeds      map[string]string
+	globalSeed maphash.Seed
+}
+
+func NewHasher() *Hasher {
+	return &Hasher{
+		seeds:      make(map[string]string),
+		globalSeed: maphash.MakeSeed(),
+	}
 }
 
-func NewHasher() *hasher {
-	h := new(hasher)
-	h.seeds = make(map[string]maphash.Seed)
-	return h
+// SetSeed assigns a reproducible seed to the given id.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	h.seeds[id] = seed
+	h.mu.Unlock()
 }
 
-// Reseed generates a new seed for the given id
-func (h *hasher) Reseed(id string) {
-	h.seeds[id] = maphash.MakeSeed()
+// Reseed generates a new seed for the given id.
+func (h *Hasher) Reseed(id string) {
+	h.SetSeed(id, strconv.FormatUint(maphash.String(maphash.MakeSeed(), id), 16))
 }
 
-// HashFunc returns a function that hashes a string using the seed for the given id
-func (h *hasher) HashFunc() func(id, str string) uint64 {
+// HashFunc returns a function that hashes a string using the seed for the given id.
+func (h *Hasher) HashFunc() func(id, str string) uint64 {
 	return func(id, str string) uint64 {
-		var hash maphash.Hash
-		var seed maphash.Seed
-		var ok bool
-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
+		h.mu.Lock()
+		seed, ok := h.seeds[id]
+		if !ok {
+			seed = strconv.FormatUint(maphash.String(h.globalSeed, id), 16)
 			h.seeds[id] = seed
 		}
-		hash.SetSeed(seed)
-		_, _ = hash.WriteString(str)
-		return hash.Sum64()
+		h.mu.Unlock()
+
+		// Length-prefix the seed so distinct seed/input pairs cannot share an encoding.
+		data := strconv.Itoa(len(seed)) + ":" + seed + str
+		sum := sha256.Sum256([]byte(data))
+		return binary.BigEndian.Uint64(sum[:8])
 	}
 }
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..c9cc87f 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,31 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores a prior seed after reseeding", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("id", "original")
+		original := hashFunc("id", input)
+		Expect(hashFunc("id", input)).To(Equal(original))
+
+		h.Reseed("id")
+		Expect(hashFunc("id", input)).NotTo(Equal(original))
+
+		h.SetSeed("id", "original")
+		Expect(hashFunc("id", input)).To(Equal(original))
+		other := hasher.NewHasher()
+		other.SetSeed("id", "original")
+		Expect(other.HashFunc()("id", input)).To(Equal(original))
+	})
+
+	It("uses the global SetSeed for existing hash functions", func() {
+		hashFunc := hasher.HashFunc()
+		hasher.SetSeed("global-test-id", "first")
+		first := hashFunc("global-test-id", input)
+		hasher.SetSeed("global-test-id", "second")
+		Expect(hashFunc("global-test-id", input)).NotTo(Equal(first))
+		hasher.SetSeed("global-test-id", "first")
+		Expect(hashFunc("global-test-id", input)).To(Equal(first))
+	})
 })
