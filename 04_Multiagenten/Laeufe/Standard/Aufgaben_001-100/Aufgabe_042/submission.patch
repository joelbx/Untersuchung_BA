diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..8349a75
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,108 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+describe('WebFinger', () => {
+	const baseUrl = 'https://example.org/forum';
+	let allowed;
+	let uid;
+	let checkedUid;
+	let lookupSlug;
+	let webfinger;
+
+	before(() => {
+		const source = fs.readFileSync(path.join(__dirname, '../src/controllers/well-known.js'), 'utf8');
+		const module = { exports: {} };
+		vm.runInNewContext(source, {
+			module,
+			require(name) {
+				if (name === 'nconf') {
+					return { get: key => (key === 'url_parsed' ? { hostname: 'example.org' } : baseUrl) };
+				}
+				if (name === '../privileges') {
+					return {
+						global: {
+							can: async (privilege, requesterUid) => {
+								assert.strictEqual(privilege, 'view:users');
+								checkedUid = requesterUid;
+								return allowed;
+							},
+						},
+					};
+				}
+				if (name === '../user') {
+					return {
+						getUidByUserslug: async (slug) => { lookupSlug = slug; return uid; },
+						getUserField: async (foundUid, field) => {
+							assert.strictEqual(foundUid, uid);
+							assert.strictEqual(field, 'userslug');
+							return 'alice';
+						},
+					};
+				}
+				throw new Error(`Unexpected dependency: ${name}`);
+			},
+		});
+		webfinger = module.exports.webfinger;
+	});
+
+	beforeEach(() => {
+		allowed = true;
+		uid = 42;
+		checkedUid = undefined;
+		lookupSlug = undefined;
+	});
+
+	async function request(resource, requesterUid) {
+		const result = { status: 200 };
+		const res = {
+			sendStatus(status) { result.status = status; return this; },
+			type(type) { result.type = type; return this; },
+			json(body) { result.body = body; return this; },
+		};
+		await webfinger({ query: resource === undefined ? {} : { resource }, uid: requesterUid }, res);
+		return result;
+	}
+
+	it('rejects missing and malformed account resources', async () => {
+		const resources = [undefined, 'alice@example.org', 'acct:alice@elsewhere.org', 'acct:@example.org', 'acct:alice@example.org.evil', ['acct:alice@example.org']];
+		const results = await Promise.all(resources.map(resource => request(resource)));
+		results.forEach(result => assert.strictEqual(result.status, 400));
+		assert.strictEqual(checkedUid, undefined);
+	});
+
+	it('checks Guest permission for anonymous requests', async () => {
+		allowed = false;
+		const result = await request('acct:alice@example.org');
+		assert.strictEqual(checkedUid, 0);
+		assert.strictEqual(result.status, 403);
+		assert.strictEqual(lookupSlug, undefined);
+	});
+
+	it('checks the signed in user permission', async () => {
+		allowed = false;
+		const result = await request('acct:alice@example.org', 12);
+		assert.strictEqual(checkedUid, 12);
+		assert.strictEqual(result.status, 403);
+	});
+
+	it('returns 404 when the slug cannot be resolved', async () => {
+		uid = 0;
+		const result = await request('acct:missing@example.org');
+		assert.strictEqual(lookupSlug, 'missing');
+		assert.strictEqual(result.status, 404);
+	});
+
+	it('returns a JRD with both profile aliases and an HTML link', async () => {
+		const resource = 'acct:alice@example.org';
+		const result = await request(resource);
+		assert.strictEqual(result.status, 200);
+		assert.strictEqual(result.type, 'application/jrd+json');
+		assert.strictEqual(result.body.subject, resource);
+		assert.deepStrictEqual(Array.from(result.body.aliases), [`${baseUrl}/uid/42`, `${baseUrl}/user/alice`]);
+		assert(result.body.links.some(link => link.href === `${baseUrl}/user/alice` && link.type === 'text/html'));
+	});
+});
