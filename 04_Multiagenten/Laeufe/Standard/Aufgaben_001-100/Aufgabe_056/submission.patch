@@ -0,0 +1,48 @@
+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    getBrowser: jest.fn(),
+    getOS: jest.fn(),
+    isAndroid: jest.fn(),
+    isDesktop: jest.fn(),
+    isIos: jest.fn(),
+    isMobile: jest.fn(),
+}));
+
+const mockBrowser = getBrowser as jest.Mock;
+const mockOS = getOS as jest.Mock;
+
+describe('modern image support', () => {
+    const modernTypes = [
+        SupportedMimeTypes.heic,
+        SupportedMimeTypes.heics,
+        SupportedMimeTypes.heif,
+        SupportedMimeTypes.heifs,
+        SupportedMimeTypes.jxl,
+    ];
+
+    it.each(['Mac OS', 'iOS'])('allows HEIC and JXL on %s Safari 17+', (os) => {
+        mockOS.mockReturnValue({ name: os });
+        mockBrowser.mockReturnValue({ name: os === 'iOS' ? 'Mobile Safari' : 'Safari', version: '17.0' });
+
+        expect(isHEICSupported()).toBe(true);
+        expect(isJXLSupported()).toBe(true);
+        modernTypes.forEach((type) => expect(isSupportedImage(type)).toBe(true));
+    });
+
+    it.each([
+        ['Mac OS', 'Safari', '16.6'],
+        ['iOS', 'Mobile Safari', '16.6'],
+        ['Windows', 'Safari', '17.0'],
+        ['Mac OS', 'Chrome', '17.0'],
+    ])('rejects HEIC and JXL on %s %s %s', (os, browser, version) => {
+        mockOS.mockReturnValue({ name: os });
+        mockBrowser.mockReturnValue({ name: browser, version });
+
+        expect(isHEICSupported()).toBe(false);
+        expect(isJXLSupported()).toBe(false);
+        modernTypes.forEach((type) => expect(isSupportedImage(type)).toBe(false));
+    });
+});
