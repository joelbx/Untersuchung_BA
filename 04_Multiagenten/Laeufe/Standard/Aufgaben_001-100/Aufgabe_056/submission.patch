@@ -0,0 +1,21 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('uses a specific browser MIME type', async () => {
+        const file = new File([], 'photo.jpg', { type: 'image/heic' });
+
+        expect(await mimeTypeFromFile(file)).toBe('image/heic');
+    });
+
+    it('uses the extension when the browser type is missing or generic', async () => {
+        expect(await mimeTypeFromFile(new File([], 'photo.jxl'))).toBe('image/jxl');
+        expect(await mimeTypeFromFile(new File([], 'photo.jxl', { type: 'application/octet-stream' }))).toBe(
+            'image/jxl'
+        );
+        expect(await mimeTypeFromFile(new File([], 'photo.heic'))).toBe('image/heic');
+    });
+
+    it('uses the generic MIME type for an unknown extension', async () => {
+        expect(await mimeTypeFromFile(new File([], 'photo.unknown-extension'))).toBe('application/octet-stream');
+    });
+});
