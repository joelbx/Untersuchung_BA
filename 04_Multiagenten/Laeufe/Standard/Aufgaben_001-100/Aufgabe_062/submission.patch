+func TestContextReaderPasswordTimeoutAndExit(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+
+	term := &fakeTerm{reader: pr}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	got, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, got)
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClean, cr.state)
+
+	// The abandoned background read can still be reclaimed by a clean read.
+	go func() { _, _ = pw.Write([]byte("next")) }()
+	got, err = cr.ReadContext(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, "next", string(got))
+
+	term.restoreCalled = false
+	ctx, cancel = context.WithCancel(context.Background())
+	defer cancel()
+	// Start a password read and close it while the background read is blocked.
+	go func() {
+		<-ctx.Done()
+		NotifyExit()
+	}()
+	stdinMU.Lock()
+	previous := stdin
+	stdin = cr
+	stdinMU.Unlock()
+	t.Cleanup(func() {
+		stdinMU.Lock()
+		stdin = previous
+		stdinMU.Unlock()
+	})
+	go func() {
+		time.Sleep(time.Millisecond)
+		cancel()
+	}()
+	_, _ = cr.ReadPassword(context.Background())
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+}
+
+func TestContextReaderMaybeRestoreTerm(t *testing.T) {
+	fake := &fakeTerm{restoreErr: errors.New("restore failed")}
+	cr := &ContextReader{term: fake, state: readerStatePassword, previousTermState: &term.State{}}
+	require.ErrorIs(t, cr.maybeRestoreTerm(), fake.restoreErr)
+	require.NotNil(t, cr.previousTermState)
+	cr.state = readerStateClean
+	require.NoError(t, cr.maybeRestoreTerm())
+	cr.previousTermState = nil
+	cr.state = readerStatePassword
+	require.NoError(t, cr.maybeRestoreTerm())
+}
