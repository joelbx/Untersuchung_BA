+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,103 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDisabledDoesNotCreateState(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.TelemetryEnabled = false
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	require.Nil(t, r)
+	_, err = os.Stat(dir)
+	require.True(t, os.IsNotExist(err))
+}
+
+func TestStateAndReport(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	require.NotNil(t, r)
+	first := r.state.UUID
+	require.NotEmpty(t, first)
+	require.Equal(t, neverReported, r.state.LastTimestamp)
+
+	r2, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	require.Equal(t, first, r2.state.UUID)
+
+	requests := make(chan map[string]interface{}, 1)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		var event map[string]interface{}
+		if json.NewDecoder(req.Body).Decode(&event) == nil {
+			requests <- event
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+	r2.url = srv.URL
+	require.NoError(t, r2.Report(context.Background()))
+	event := <-requests
+	require.Equal(t, "flipt.ping", event["event"])
+	require.Equal(t, first, event["anonymousId"])
+	properties := event["properties"].(map[string]interface{})
+	require.Equal(t, first, properties["uuid"])
+	require.Equal(t, schemaVersion, properties["version"])
+	require.Equal(t, FliptVersion, properties["flipt.version"])
+	_, err = time.Parse(time.RFC3339, r2.state.LastTimestamp)
+	require.NoError(t, err)
+}
+
+func TestFileAsStateDirectory(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "file")
+	require.NoError(t, os.WriteFile(path, []byte("x"), 0600))
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = path
+	r, err := NewReporter(cfg, logrus.New())
+	require.Error(t, err)
+	require.Nil(t, r)
+}
+
+func TestMalformedUUIDRegenerated(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "telemetry.json"), []byte(`{"version":"1.0","uuid":"broken"}`), 0600))
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	require.NotEqual(t, "broken", r.state.UUID)
+}
+
+func TestFailedReportDoesNotAdvanceTimestamp(t *testing.T) {
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = t.TempDir()
+	r, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer srv.Close()
+	r.url = srv.URL
+	require.Error(t, r.Report(context.Background()))
+	data, err := os.ReadFile(filepath.Join(cfg.Meta.StateDirectory, "telemetry.json"))
+	require.NoError(t, err)
+	var saved state
+	require.NoError(t, json.Unmarshal(data, &saved))
+	require.Equal(t, neverReported, saved.LastTimestamp)
+}
