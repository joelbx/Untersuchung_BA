new file mode 100644
index 0000000..78b0ffb
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,29 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt describes the running server and implements http.Handler.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+func (f Flipt) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	out, err := json.Marshal(f)
+	if err != nil {
+		http.Error(w, "encoding server information", http.StatusInternalServerError)
+		return
+	}
+	if _, err := w.Write(out); err != nil {
+		http.Error(w, "writing server information", http.StatusInternalServerError)
+		return
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..12ca71a
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,194 @@
+// Package telemetry reports anonymous Flipt usage from a running host.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	endpoint      = "https://telemetry.flipt.io/v1/track"
+	neverReported = "1970-01-01T00:00:00Z"
+)
+
+// FliptVersion is set by the application at startup to its build version.
+var FliptVersion = "dev"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter owns the persistent anonymous identifier and its report schedule.
+type Reporter struct {
+	mu           sync.Mutex
+	state        state
+	path         string
+	client       *http.Client
+	logger       logrus.FieldLogger
+	url          string
+	fliptVersion string
+}
+
+// NewReporter initializes the state and HTTP client for enabled telemetry.
+// A nil reporter means telemetry is disabled or cannot safely be initialized.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding telemetry state directory: %w", err)
+		}
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+	path := filepath.Join(dir, "telemetry.json")
+	r := &Reporter{path: path, client: &http.Client{Timeout: 10 * time.Second}, logger: logger, url: endpoint, fliptVersion: FliptVersion}
+	data, err := os.ReadFile(path)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if len(data) > 0 {
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.Warnf("reading malformed telemetry state: %v", err)
+			r.state = state{}
+		}
+	}
+	id, parseErr := uuid.FromString(r.state.UUID)
+	if parseErr != nil || id == uuid.Nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry UUID: %w", err)
+		}
+		r.state.UUID = id.String()
+	}
+	r.state.Version = schemaVersion
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		r.state.LastTimestamp = neverReported
+	}
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+// Start launches a loop that reports when four hours have elapsed since the
+// last successful report. Cancellation stops the loop.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			wait := time.Until(last.Add(interval))
+			if wait > 0 {
+				timer := time.NewTimer(wait)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if err := r.Report(ctx); err != nil {
+				r.logger.Warnf("reporting telemetry: %v", err)
+				// Retry transient failures without a busy loop.
+				select {
+				case <-ctx.Done():
+					return
+				case <-time.After(interval):
+				}
+			}
+		}
+	}()
+}
+
+// Report sends one anonymous ping and persists the time of a successful send.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	payload := struct {
+		AnonymousID string            `json:"anonymousId"`
+		Event       string            `json:"event"`
+		Properties  map[string]string `json:"properties"`
+	}{r.state.UUID, "flipt.ping", map[string]string{
+		"uuid":          r.state.UUID,
+		"version":       schemaVersion,
+		"flipt.version": r.fliptVersion,
+	}}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.url, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	return r.save()
+}
+
+func (r *Reporter) save() error {
+	data, err := json.Marshal(r.state)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(r.path), ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	defer os.Remove(tmp.Name())
+	if err := tmp.Chmod(0600); err != nil {
+		tmp.Close()
+		return fmt.Errorf("setting telemetry state permissions: %w", err)
+	}
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(tmp.Name(), r.path); err != nil {
+		return fmt.Errorf("saving telemetry state: %w", err)
+	}
+	return nil
+}
