+func TestGetCveContentTypes(t *testing.T) {
+	tests := []struct {
+		family string
+		want   []CveContentType
+	}{
+		{"redhat", []CveContentType{RedHat, RedHatAPI}},
+		{"centos", []CveContentType{RedHat, RedHatAPI}},
+		{"alma", []CveContentType{RedHat, RedHatAPI}},
+		{"rocky", []CveContentType{RedHat, RedHatAPI}},
+		{"debian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"raspbian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"ubuntu", []CveContentType{Ubuntu, UbuntuAPI}},
+		{"unsupported", nil},
+	}
+	for _, tt := range tests {
+		if got := GetCveContentTypes(tt.family); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("%s: got %v, want %v", tt.family, got, tt.want)
+		}
+	}
+}
+
+func TestUbuntuContentSources(t *testing.T) {
+	contents := NewCveContents(
+		CveContent{Type: Ubuntu, SourceLink: "oval", Cpes: []Cpe{{URI: "oval"}}, References: References{{Link: "oval"}}, CweIDs: []string{"CWE-1"}},
+		CveContent{Type: UbuntuAPI, SourceLink: "api", Cpes: []Cpe{{URI: "api"}}, References: References{{Link: "api"}}, CweIDs: []string{"CWE-2"}},
+		CveContent{Type: Nvd, SourceLink: "nvd", Cpes: []Cpe{{URI: "nvd"}}, References: References{{Link: "nvd"}}, CweIDs: []string{"CWE-3"}},
+	)
+	if got := contents.PrimarySrcURLs("en", "ubuntu", "CVE-2024-0001", nil); !reflect.DeepEqual(got, []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "oval"}, {UbuntuAPI, "api"}}) {
+		t.Errorf("source URLs: %v", got)
+	}
+	if got := contents.Cpes("ubuntu"); len(got) < 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI || got[2].Type != Nvd {
+		t.Errorf("CPE order: %v", got)
+	}
+	if got := contents.References("ubuntu"); len(got) < 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI || got[2].Type != Nvd {
+		t.Errorf("reference order: %v", got)
+	}
+	if got := contents.CweIDs("ubuntu"); len(got) < 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI || got[2].Type != Nvd {
+		t.Errorf("CWE order: %v", got)
+	}
+}
+
+func TestNewCveContentTypeSingleMapping(t *testing.T) {
+	for _, family := range []string{"redhat", "centos"} {
+		if got := NewCveContentType(family); got != RedHat {
+			t.Errorf("%s: got %s, want %s", family, got, RedHat)
+		}
+	}
+	if got := NewCveContentType("unrecognized"); got != Unknown {
+		t.Errorf("unrecognized: got %s, want %s", got, Unknown)
+	}
+}
