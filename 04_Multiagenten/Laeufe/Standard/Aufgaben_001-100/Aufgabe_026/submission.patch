+func TestUbuntuAPIContentPresentation(t *testing.T) {
+	v := VulnInfo{CveContents: NewCveContents(
+		CveContent{Type: Ubuntu, Summary: "oval summary", Cvss3Severity: "NEGLIGIBLE"},
+		CveContent{Type: UbuntuAPI, Summary: "api summary", Cvss3Score: 7.2, Cvss3Severity: "HIGH"},
+		CveContent{Type: Nvd, Summary: "nvd summary"},
+	)}
+	if got := v.Titles("en", "ubuntu"); len(got) < 3 || got[1].Type != Ubuntu || got[2].Type != UbuntuAPI {
+		t.Errorf("title order: %v", got)
+	}
+	if got := v.Summaries("en", "ubuntu"); len(got) < 3 || got[0].Type != Ubuntu || got[1].Type != UbuntuAPI || got[2].Type != Nvd {
+		t.Errorf("summary order: %v", got)
+	}
+	if got := v.Cvss3Scores(); len(got) != 2 || got[0].Type != UbuntuAPI || got[0].Value.Score != 7.2 || got[1].Type != Ubuntu || got[1].Value.Score != 3.9 {
+		t.Errorf("CVSS scores: %v", got)
+	}
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("NEGLIGIBLE range: %s", got)
+	}
+}
