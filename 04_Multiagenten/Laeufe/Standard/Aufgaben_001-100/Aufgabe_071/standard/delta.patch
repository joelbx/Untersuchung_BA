+def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
     """
     Takes a byte string like '#< CLIXML\r\n<Objs...' and extracts the stream
     message encoded in the XML data. CLIXML is used by PowerShell to encode
     multiple objects in stderr.
     """
-    lines = []
+    blocks = []
+    escape = re.compile(r'_x([0-9a-fA-F]{4})_')
+
+    def decode_escapes(value: str) -> str:
+        result = []
+        position = 0
+        while match := escape.search(value, position):
+            result.append(value[position:match.start()])
+            code_unit = int(match.group(1), 16)
+            following = escape.match(value, match.end())
+
+            if 0xD800 <= code_unit <= 0xDBFF and following:
+                low = int(following.group(1), 16)
+                if 0xDC00 <= low <= 0xDFFF:
+                    result.append(chr(0x10000 + ((code_unit - 0xD800) << 10) + low - 0xDC00))
+                    position = following.end()
+                    continue
+
+            if match.group() == '_x005F_' and not following:
+                result.append(match.group())
+            else:
+                result.append(chr(code_unit))
+            position = match.end()
+
+        result.append(value[position:])
+        return ''.join(result)
 
     # There are some scenarios where the stderr contains a nested CLIXML element like
     # '<# CLIXML\r\n<# CLIXML\r\n<Objs>...</Objs><Objs>...</Objs>'.
-    # Parse each individual <Objs> element and add the error strings to our stderr list.
+    # Parse each individual <Objs> element and keep its matching stream text together.
     # https://github.com/ansible/ansible/issues/69550
-    while data:
-        end_idx = data.find(b"</Objs>") + 7
-        current_element = data[data.find(b"<Objs "):end_idx]
-        data = data[end_idx:]
-
-        clixml = ET.fromstring(current_element)
+    for element in re.finditer(rb'<Objs(?:\s[^>]*)?>.*?</Objs>', data, re.DOTALL):
+        clixml = ET.fromstring(element.group())
         namespace_match = re.match(r'{(.*)}', clixml.tag)
         namespace = "{%s}" % namespace_match.group(1) if namespace_match else ""
 
         strings = clixml.findall("./%sS" % namespace)
-        lines.extend([e.text.replace('_x000D__x000A_', '') for e in strings if e.attrib.get('S') == stream])
+        block = decode_escapes(''.join(e.text or '' for e in strings if e.attrib.get('S') == stream))
+        if block:
+            blocks.append(block)
 
-    return to_bytes('\r\n'.join(lines))
+    return to_bytes('\r\n'.join(blocks), errors='surrogatepass')
 
 
