+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	tests := []struct {
+		listen, public, want string
+	}{
+		{"0.0.0.0:8080", "", "proxy.example:8080"},
+		{"[::]:8080", "", "proxy.example:8080"},
+		{"0.0.0.0:8080", "kube.example:8443", "kube.example:8443"},
+		{"", "", "proxy.example:3026"},
+	}
+	for _, tt := range tests {
+		tc := &TeleportClient{}
+		tc.WebProxyAddr = "proxy.example:3080"
+		err := tc.applyProxySettings(ProxySettings{Kube: KubeProxySettings{
+			Enabled: true, ListenAddr: tt.listen, PublicAddr: tt.public,
+		}})
+		c.Assert(err, check.IsNil)
+		c.Assert(tc.KubeProxyAddr, check.Equals, tt.want)
+	}
+}
