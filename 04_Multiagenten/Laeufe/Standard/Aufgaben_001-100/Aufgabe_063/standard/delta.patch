+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	tests := []struct {
+		name, yaml, wantAddr, wantError string
+		wantEnabled                     bool
+	}{
+		{"shorthand", "kube_listen_addr: 0.0.0.0:8080", "0.0.0.0:8080", "", true},
+		{"default port", "kube_listen_addr: 0.0.0.0", "0.0.0.0:3026", "", true},
+		{"disabled legacy", "kube_listen_addr: '[::]:8080'\n  kubernetes:\n    enabled: no", "[::]:8080", "", true},
+		{"legacy", "kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:8080", "127.0.0.1:8080", "", true},
+		{"conflict", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes", "", "proxy_service.kube_listen_addr conflicts", false},
+		{"bad address", "kube_listen_addr: 'udp://bad:8080'", "", "invalid proxy_service.kube_listen_addr", false},
+	}
+	for _, tt := range tests {
+		conf, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  " + tt.yaml + "\n"))
+		c.Assert(err, check.IsNil, check.Commentf(tt.name))
+		cfg := service.MakeDefaultConfig()
+		err = ApplyFileConfig(conf, cfg)
+		if tt.wantError != "" {
+			c.Assert(err, check.NotNil, check.Commentf(tt.name))
+			c.Assert(strings.Contains(err.Error(), tt.wantError), check.Equals, true, check.Commentf(tt.name))
+			continue
+		}
+		c.Assert(err, check.IsNil, check.Commentf(tt.name))
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, tt.wantEnabled, check.Commentf(tt.name))
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, tt.wantAddr, check.Commentf(tt.name))
+	}
+}
