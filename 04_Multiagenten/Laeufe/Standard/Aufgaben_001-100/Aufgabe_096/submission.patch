+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_warns_when_mode_available_but_omitted(atomic_am, atomic_mocks, monkeypatch, capfd):
+    monkeypatch.setattr(warnings, '_global_warnings', [])
+    atomic_am.argument_spec['mode'] = dict(type='raw')
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert atomic_am._created_files == {'/path/to/dest'}
+    atomic_am._return_formatted({})
+
+    result = json.loads(capfd.readouterr()[0])
+    assert result['warnings'] == [
+        "File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning."
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_explicit_mode_clears_atomic_move_warning(atomic_am, atomic_mocks, fake_stat, monkeypatch, capfd):
+    monkeypatch.setattr(warnings, '_global_warnings', [])
+    atomic_am.argument_spec['mode'] = dict(type='raw')
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    atomic_mocks['stat'].return_value = fake_stat
+    monkeypatch.setattr(os, 'lstat', lambda path: fake_stat)
+    atomic_am.set_mode_if_different('/path/to/dest', '0600', False)
+    assert atomic_am._created_files == set()
+    atomic_am._return_formatted({})
+
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
+
+
+@pytest.mark.parametrize('stdin, supports_mode, mode', [({}, False, None), ({}, True, '0640')], indirect=['stdin'])
+def test_no_warning_without_omitted_mode(atomic_am, atomic_mocks, supports_mode, mode):
+    if supports_mode:
+        atomic_am.argument_spec['mode'] = dict(type='raw')
+        atomic_am.params['mode'] = mode
