+
+func TestRuleSegmentAudit(t *testing.T) {
+	tests := []struct {
+		name     string
+		rule     *flipt.Rule
+		key      string
+		operator string
+	}{
+		{"legacy", &flipt.Rule{SegmentKey: "legacy"}, "legacy", ""},
+		{"single", &flipt.Rule{SegmentKey: "legacy", SegmentKeys: []string{"one"}}, "one", ""},
+		{"multiple", &flipt.Rule{SegmentKeys: []string{"one", "two"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR}, "one,two", "AND_SEGMENT_OPERATOR"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := NewRule(tt.rule)
+			assert.Equal(t, tt.key, got.SegmentKey)
+			assert.Equal(t, tt.operator, got.SegmentOperator)
+
+			encoded, err := json.Marshal(got)
+			assert.NoError(t, err)
+			var fields map[string]any
+			assert.NoError(t, json.Unmarshal(encoded, &fields))
+			if tt.operator == "" {
+				assert.NotContains(t, fields, "segment_operator")
+			} else {
+				assert.Equal(t, tt.operator, fields["segment_operator"])
+			}
+		})
+	}
+}
+
+func TestRolloutSegmentAudit(t *testing.T) {
+	tests := []struct {
+		name     string
+		segment  *flipt.RolloutSegment
+		key      string
+		operator string
+	}{
+		{"legacy", &flipt.RolloutSegment{SegmentKey: "legacy", Value: true}, "legacy", ""},
+		{"single", &flipt.RolloutSegment{SegmentKey: "legacy", SegmentKeys: []string{"one"}, Value: true}, "one", ""},
+		{"multiple", &flipt.RolloutSegment{SegmentKeys: []string{"one", "two"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true}, "one,two", "AND_SEGMENT_OPERATOR"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: tt.segment}})
+			assert.Equal(t, tt.key, got.Segment.Key)
+			assert.True(t, got.Segment.Value)
+			assert.Equal(t, tt.operator, got.Segment.Operator)
+
+			encoded, err := json.Marshal(got.Segment)
+			assert.NoError(t, err)
+			var fields map[string]any
+			assert.NoError(t, json.Unmarshal(encoded, &fields))
+			if tt.operator == "" {
+				assert.NotContains(t, fields, "operator")
+			} else {
+				assert.Equal(t, tt.operator, fields["operator"])
+			}
+		})
+	}
+}
