diff --git a/openlibrary/tests/core/test_bestbook.py b/openlibrary/tests/core/test_bestbook.py
new file mode 100644
index 0000000..1b335ab
--- /dev/null
+++ b/openlibrary/tests/core/test_bestbook.py
@@ -0,0 +1,92 @@
+import json
+
+import pytest
+import web
+
+from openlibrary import accounts
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.core.bookshelves import Bookshelves
+from openlibrary.core.db import get_db
+from openlibrary.plugins.openlibrary.api import bestbook_award, bestbook_count
+
+
+@pytest.fixture
+def awards_db(monkeypatch):
+    web.config.db_parameters = {'dbn': 'sqlite', 'db': ':memory:'}
+    database = get_db()
+    database.query('''
+        CREATE TABLE bestbook_awards (
+            id INTEGER PRIMARY KEY,
+            username TEXT NOT NULL,
+            work_id INTEGER NOT NULL,
+            topic TEXT NOT NULL,
+            comment TEXT NOT NULL DEFAULT '',
+            edition_id INTEGER,
+            UNIQUE(username, work_id),
+            UNIQUE(username, topic)
+        )
+    ''')
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: True)
+    yield database
+    database.query('DROP TABLE bestbook_awards')
+
+
+def test_award_lifecycle_and_uniqueness(awards_db):
+    award_id = Bestbook.add('reader', '1', 'fiction', comment='Great', edition_id=2)
+    assert award_id
+    assert Bestbook.get_count(work_id='1') == 1
+    assert Bestbook.get_awards(username='reader')[0].comment == 'Great'
+    with pytest.raises(Bestbook.AwardConditionsError):
+        Bestbook.add('reader', '1', 'poetry')
+    with pytest.raises(Bestbook.AwardConditionsError):
+        Bestbook.add('reader', '2', 'fiction')
+
+    assert Bestbook.update('reader', '1', 'poetry', comment='Updated') == award_id
+    assert Bestbook.get_count(topic='fiction') == 0
+    assert Bestbook.get_count(topic='poetry') == 1
+    assert Bestbook.get_awards(work_id='1')[0].edition_id == 2
+    assert Bestbook.get_leaderboard()[0].count == 1
+    assert Bestbook.remove('reader', work_id='1') == 1
+    assert Bestbook.get_count() == 0
+
+
+def test_read_prerequisite_and_work_redirect(awards_db, monkeypatch):
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: False)
+    with pytest.raises(Bestbook.AwardConditionsError, match='Only books which have been marked as read'):
+        Bestbook.add('reader', '1', 'fiction')
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: True)
+    Bestbook.add('reader', '1', 'fiction')
+    assert Bestbook.update_work_id('1', '2')['rows_changed'] == 1
+    assert Bestbook.get_count(work_id='2') == 1
+    assert Bestbook.update_username('reader', 'anonymous') == 1
+    assert Bestbook.get_count(username='anonymous') == 1
+
+
+def test_redirect_conflict_keeps_existing_nomination(awards_db):
+    Bestbook.add('reader', '1', 'fiction')
+    Bestbook.add('reader', '2', 'poetry')
+    result = Bestbook.update_work_id('1', '2')
+    assert result == {'rows_changed': 0, 'rows_deleted': 1, 'failed_deletes': 0}
+    assert Bestbook.get_count(username='reader') == 1
+    assert Bestbook.get_awards(username='reader')[0].topic == 'poetry'
+
+
+def test_award_api_and_count(awards_db, monkeypatch):
+    monkeypatch.setattr(web.ctx, 'env', {}, raising=False)
+    monkeypatch.setattr(accounts, 'get_current_user', lambda: None)
+    monkeypatch.setattr(web, 'input', lambda **defaults: web.storage(defaults))
+    post = bestbook_award().POST.__wrapped__
+    assert json.loads(post(bestbook_award(), '1')) == {'errors': 'Authentication failed'}
+
+    monkeypatch.setattr(accounts, 'get_current_user', lambda: web.storage(key='/people/reader'))
+    monkeypatch.setattr(web, 'input', lambda **defaults: web.storage({**defaults, 'op': 'add', 'topic': 'fiction'}))
+    added = json.loads(post(bestbook_award(), '1'))
+    assert added['success'] is True
+    assert added['award']
+
+    monkeypatch.setattr(web, 'input', lambda **defaults: web.storage({**defaults, 'work_id': '1'}))
+    count = json.loads(bestbook_count().GET.__wrapped__(bestbook_count()))
+    assert count == {'count': 1}
+
+    monkeypatch.setattr(web, 'input', lambda **defaults: web.storage({**defaults, 'op': 'remove'}))
+    assert json.loads(post(bestbook_award(), '1')) == {'success': True, 'rows': 1}
