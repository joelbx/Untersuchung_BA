+class bestbook_award(delegate.page):
+    path = r'/works/OL(\d+)W/awards'
+    encoding = 'json'
+
+    @jsonapi
+    def POST(self, work_id):
+        user = accounts.get_current_user()
+        if not user:
+            return json.dumps({'errors': 'Authentication failed'})
+
+        i = web.input(op=None, topic=None, comment='', edition_key=None)
+        if web.ctx.env.get('CONTENT_TYPE', '').startswith('application/json'):
+            try:
+                i = json.loads(web.data())
+            except (ValueError, TypeError):
+                return json.dumps({'errors': 'Invalid JSON'})
+
+        op = i.get('op')
+        topic = i.get('topic')
+        comment = i.get('comment') or ''
+        username = user.key.split('/')[2]
+        try:
+            if op == 'remove':
+                return json.dumps({'success': True, 'rows': Bestbook.remove(username, work_id=work_id)})
+            if op not in ('add', 'update'):
+                return json.dumps({'errors': 'Invalid operation'})
+            if not topic:
+                return json.dumps({'errors': 'A topic is required'})
+            edition_key = i.get('edition_key')
+            edition_id = (
+                int(extract_numeric_id_from_olid(edition_key)) if edition_key else None
+            )
+            method = Bestbook.add if op == 'add' else Bestbook.update
+            award = method(username, work_id, topic, comment=comment, edition_id=edition_id)
+            return json.dumps({'success': True, 'award': award})
+        except (Bestbook.AwardConditionsError, ValueError, TypeError) as exc:
+            return json.dumps({'errors': str(exc)})
+
+
