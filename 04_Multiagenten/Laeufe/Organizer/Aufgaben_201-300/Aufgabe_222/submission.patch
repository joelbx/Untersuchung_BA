+@pytest.mark.parametrize('collection, expected_name', [
+    (None, 'example'),
+    ('', 'example'),
+    ('namespace.collection', 'namespace.collection.example'),
+])
+def test_build_role_doc(collection, expected_name):
+    main_spec = {'short_description': 'Main entry point', 'options': {'foo': {'type': 'str'}}}
+    alternate_spec = {'short_description': 'Alternate entry point'}
+    argspec = {'main': main_spec, 'alternate': alternate_spec}
+
+    fqcn, doc = RoleMixin()._build_doc('example', '/roles/example', collection, argspec)
+
+    assert fqcn == expected_name
+    assert doc == {
+        'path': '/roles/example',
+        'collection': collection,
+        'entry_points': argspec,
+    }
+    assert doc['entry_points']['main'] is main_spec
+
+    fqcn, doc = RoleMixin()._build_doc('example', '/roles/example', collection, argspec, 'alternate')
+    assert fqcn == expected_name
+    assert doc['entry_points'] == {'alternate': alternate_spec}
+    assert doc['entry_points']['alternate'] is alternate_spec
+
+
+@pytest.mark.parametrize('argspec, entry_point', [
+    ({}, None),
+    ({'main': {'short_description': 'Main'}}, 'missing'),
+])
+def test_build_role_doc_without_matching_entry_points(argspec, entry_point):
+    assert RoleMixin()._build_doc('example', '/roles/example', '', argspec, entry_point) == ('example', None)
+
+
+def test_create_role_doc_omits_roles_without_matching_entry_points(monkeypatch):
+    mixin = RoleMixin()
+    monkeypatch.setattr(mixin, '_find_all_normal_roles', lambda *args, **kwargs: {('local', '/roles/local')})
+    monkeypatch.setattr(mixin, '_find_all_collection_roles', lambda *args, **kwargs: {('remote', 'ns.coll', '/collections/ns/coll')})
+    monkeypatch.setattr(mixin, '_load_argspec', lambda role, **kwargs: {
+        'local': {'main': {'short_description': 'Local'}},
+        'remote': {'alternate': {'short_description': 'Remote'}},
+    }[role])
+
+    assert mixin._create_role_doc(('local', 'remote'), ('/roles',), entry_point='alternate') == {
+        'ns.coll.remote': {
+            'path': '/collections/ns/coll',
+            'collection': 'ns.coll',
+            'entry_points': {'alternate': {'short_description': 'Remote'}},
+        },
+    }
