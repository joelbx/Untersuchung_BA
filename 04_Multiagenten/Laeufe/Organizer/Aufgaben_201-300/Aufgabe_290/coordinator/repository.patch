+
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { handleEvent } from "../src/legacy/LegacyCallHandler/handleEvent";
+import SettingsStore from "../src/settings/SettingsStore";
+
+describe("LegacyCallHandler media events", () => {
+    afterEach(() => jest.restoreAllMocks());
+
+    it("logs errors with the sound element ID", () => {
+        const error = jest.spyOn(logger, "error").mockImplementation();
+        const audio = document.createElement("audio");
+        audio.id = "ringAudio";
+        audio.addEventListener("error", handleEvent);
+
+        audio.dispatchEvent(new Event("error"));
+
+        expect(error).toHaveBeenCalledWith("Legacy call audio event", expect.objectContaining({
+            event: "error", id: "ringAudio",
+        }));
+    });
+
+    it("logs debug events only when enabled and ignores unrelated events", () => {
+        const debug = jest.spyOn(logger, "debug").mockImplementation();
+        const getValue = jest.spyOn(SettingsStore, "getValue").mockReturnValue(false);
+        const audio = document.createElement("audio");
+        audio.id = "busyAudio";
+        audio.addEventListener("playing", handleEvent);
+        audio.addEventListener("volumechange", handleEvent);
+
+        audio.dispatchEvent(new Event("playing"));
+        expect(debug).not.toHaveBeenCalled();
+
+        getValue.mockReturnValue(true);
+        audio.dispatchEvent(new Event("playing"));
+        audio.dispatchEvent(new Event("volumechange"));
+
+        expect(getValue).toHaveBeenCalledWith("debug_legacy_call_handler");
+        expect(debug).toHaveBeenCalledTimes(1);
+        expect(debug).toHaveBeenCalledWith("Legacy call audio event", expect.objectContaining({
+            event: "playing", id: "busyAudio",
+        }));
+    });
+});
