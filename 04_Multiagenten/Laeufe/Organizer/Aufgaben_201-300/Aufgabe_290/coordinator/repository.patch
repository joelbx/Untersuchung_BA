+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "loadstart", "loadedmetadata", "loadeddata", "canplay", "canplaythrough",
+    "play", "playing", "pause", "ended", "waiting", "suspend", "emptied",
+]);
+
+/** Logs media element events from call sounds. Can be attached directly as an event listener. */
+export function handleEvent(e: Event): void {
+    if (!errorEvents.has(e.type) && !debugEvents.has(e.type)) return;
+
+    const element = e.currentTarget as HTMLMediaElement | null;
+    const details = { event: e.type, id: element?.id, error: element?.error };
+
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call audio event", details);
+    } else if (SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call audio event", details);
+    }
+}
