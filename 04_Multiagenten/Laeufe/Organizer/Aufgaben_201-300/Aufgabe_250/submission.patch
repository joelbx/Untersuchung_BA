         raise ValueError("Not supported for generic class Item")
 
 
+def luqum_replace_child(parent: Item, old_child: Item, new_child: Item) -> None:
+    """Replace every child equal to ``old_child`` in a supported parent node."""
+    if not isinstance(parent, (BaseOperation, Group, Unary)):
+        raise ValueError("Not supported for generic class Item")
+    if old_child not in parent.children:
+        return
+    parent.children = type(parent.children)(
+        new_child if child == old_child else child for child in parent.children
+    )
+
+
