+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('https://COVERS.EXAMPLE/cover.jpg', 'https://COVERS.EXAMPLE/cover.jpg'),
+        ('http://covers.example/cover.jpg', 'http://covers.example/cover.jpg'),
+        ('https://covers.example.evil/cover.jpg', None),
+        ('https://covers.example@evil.example/cover.jpg', None),
+        ('ftp://covers.example/cover.jpg', None),
+        ('https://[broken/cover.jpg', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'Book', 'cover': cover}
+    url, updated_edition = process_cover_url(edition, ['Covers.Example'])
+    assert url == expected
+    assert updated_edition is edition
+    assert edition == {'title': 'Book'}
+
+
+def test_process_cover_url_missing():
+    edition = {'title': 'Book'}
+    assert process_cover_url(edition, ['covers.example']) == (None, edition)
+    assert edition == {'title': 'Book'}
+
+
