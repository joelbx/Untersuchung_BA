 'use strict';
 
 const db = require('../database');
+const user = require('../user');
+const { generateUUID } = require('../utils');
 
 const utils = module.exports;
 
-// internal token management utilities only
+// Internal token management utilities. Keep the direct methods for callers
+// which already use api.utils.log and api.utils.getLastSeen.
+utils.list = async () => {
+	const tokens = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await utils.get(tokens);
+};
+
+utils.getLastSeen = async (tokens) => {
+	if (!Array.isArray(tokens)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokens.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokens);
+	return scores.map((score) => {
+		const value = Number(score);
+		return score === null || score === undefined || !Number.isFinite(value) ? null : value;
+	});
+};
+
+utils.get = async (tokens) => {
+	if (tokens === null || tokens === undefined ||
+		(!Array.isArray(tokens) && typeof tokens !== 'string') ||
+		(Array.isArray(tokens) && tokens.some(token => typeof token !== 'string'))) {
+		throw new Error('[[error:invalid-data]]');
+	}
+
+	const multiple = Array.isArray(tokens);
+	const ids = multiple ? tokens : [tokens];
+	if (!ids.length) {
+		return [];
+	}
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(ids.map(token => `token:${token}`)),
+		utils.getLastSeen(ids),
+	]);
+	const result = objects.map((object, index) => object && ({
+		token: ids[index],
+		uid: Number(object.uid),
+		description: object.description || '',
+		timestamp: Number(object.timestamp),
+		lastSeen: lastSeen[index],
+	}));
+	return multiple ? result : result[0];
+};
+
+utils.generate = async ({ uid, description = '' } = {}) => {
+	const numericUid = Number(uid);
+	if ((typeof uid !== 'number' && (typeof uid !== 'string' || !uid.trim())) ||
+		!Number.isInteger(numericUid) || numericUid < 0) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !(await user.exists(numericUid))) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, { uid: numericUid, description: description == null ? '' : description, timestamp });
+	await db.sortedSetAdd('tokens:createtime', timestamp, token);
+	await db.sortedSetAdd('tokens:uid', numericUid, token);
+	return token;
+};
+
+utils.update = async (token, { description } = {}) => {
+	if (typeof token !== 'string' || description === undefined || !(await db.getObject(`token:${token}`))) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await utils.get(token);
+};
+
+utils.delete = async (token) => {
+	await db.delete(`token:${token}`);
+	await db.sortedSetRemove('tokens:createtime', token);
+	await db.sortedSetRemove('tokens:uid', token);
+	await db.sortedSetRemove('tokens:lastSeen', token);
+};
 
 utils.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.tokens = {
+	list: utils.list,
+	get: utils.get,
+	generate: utils.generate,
+	update: utils.update,
+	delete: utils.delete,
+	log: utils.log,
+	getLastSeen: utils.getLastSeen,
+};
