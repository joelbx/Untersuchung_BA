diff --git a/test/api-utils-tokens-unit.js b/test/api-utils-tokens-unit.js
new file mode 100644
index 0000000..18be7dd
--- /dev/null
+++ b/test/api-utils-tokens-unit.js
@@ -0,0 +1,99 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const Module = require('module');
+const path = require('path');
+
+describe('API token utilities', () => {
+	let tokens;
+	let db;
+	let objects;
+	let indexes;
+	let userExists;
+	let nextToken;
+
+	beforeEach(() => {
+		objects = new Map();
+		indexes = new Map();
+		userExists = false;
+		nextToken = 0;
+		const index = (key) => {
+			if (!indexes.has(key)) {
+				indexes.set(key, new Map());
+			}
+			return indexes.get(key);
+		};
+		db = {
+			getSortedSetRange: async key => [...index(key)].sort((a, b) => a[1] - b[1]).map(item => item[0]),
+			sortedSetScores: async (key, ids) => ids.map(id => (index(key).has(id) ? index(key).get(id) : null)),
+			sortedSetScore: async (key, id) => (index(key).has(id) ? index(key).get(id) : null),
+			sortedSetAdd: async (key, score, id) => index(key).set(id, score),
+			sortedSetRemove: async (key, id) => index(key).delete(id),
+			setObject: async (key, object) => objects.set(key, { ...object }),
+			getObject: async key => objects.get(key) || null,
+			getObjects: async keys => keys.map(key => objects.get(key) || null),
+			setObjectField: async (key, field, value) => { objects.get(key)[field] = value; },
+			delete: async key => objects.delete(key),
+		};
+
+		// Load just this module with an in-memory database; the integration test
+		// database setup is not needed to exercise the token storage contract.
+		const filename = path.resolve(__dirname, '../src/api/utils.js');
+		const tokenModule = new Module(filename, module);
+		tokenModule.filename = filename;
+		tokenModule.require = (id) => {
+			if (id === '../database') { return db; }
+			if (id === '../user') { return { exists: async () => userExists }; }
+			if (id === '../utils') {
+				return {
+					generateUUID: () => {
+						nextToken += 1;
+						return `generated-${nextToken}`;
+					},
+				};
+			}
+			throw new Error(`Unexpected import: ${id}`);
+		};
+		tokenModule._compile(fs.readFileSync(filename, 'utf8'), filename);
+		tokens = tokenModule.exports.tokens;
+	});
+
+	it('creates indexed tokens, hydrates metadata in creation order, and removes every entry', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.generate({ uid: 2 }), /\[\[error:no-user\]\]/);
+
+		const first = await tokens.generate({ uid: 0, description: 'master' });
+		userExists = true;
+		const second = await tokens.generate({ uid: '2' });
+		const created = objects.get(`token:${second}`);
+		assert.strictEqual(created.uid, 2);
+		assert.strictEqual(created.description, '');
+		assert(Number.isFinite(created.timestamp));
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', second), 2);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', second), created.timestamp);
+
+		const listed = await tokens.list();
+		assert.deepStrictEqual(listed.map(item => item.token), [first, second]);
+		assert.strictEqual(listed[0].lastSeen, null);
+		await tokens.log(second);
+		const seen = await tokens.getLastSeen([first, second]);
+		assert.strictEqual(seen[0], null);
+		assert(Number.isFinite(seen[1]));
+		const updated = await tokens.update(second, { description: 'new description' });
+		assert.strictEqual(updated.description, 'new description');
+		assert.strictEqual(updated.timestamp, created.timestamp);
+		assert.strictEqual(updated.lastSeen, seen[1]);
+		assert.strictEqual((await tokens.get(second)).uid, 2);
+		assert.strictEqual((await tokens.get([second, first]))[1].token, first);
+
+		await tokens.delete(second);
+		assert.strictEqual(await tokens.get(second), null);
+		const scores = await Promise.all(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen']
+			.map(key => db.sortedSetScore(key, second)));
+		assert.deepStrictEqual(scores, [null, null, null]);
+	});
+});
