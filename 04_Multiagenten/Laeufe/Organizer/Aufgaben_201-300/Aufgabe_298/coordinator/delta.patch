 func (c *simpleCache[K, V]) Keys() []K {
-	return c.data.Keys()
+	c.evictExpired()
+	items := c.data.Items()
+	keys := make([]K, 0, len(items))
+	for key, item := range items {
+		if !item.IsExpired() {
