@@ -0,0 +1,52 @@
+package lastfm
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("LastFM link", func() {
+	It("issues a signed state for the authenticated user and rejects tampering", func() {
+		router := &Router{secret: "test-secret"}
+		ctx := request.WithUser(context.Background(), model.User{ID: "user-a"})
+		recorder := httptest.NewRecorder()
+		router.getLinkState(recorder, httptest.NewRequest(http.MethodGet, "/link/state", nil).WithContext(ctx))
+		Expect(recorder.Code).To(Equal(http.StatusOK))
+		var response struct{ State string }
+		Expect(json.Unmarshal(recorder.Body.Bytes(), &response)).To(Succeed())
+		Expect(router.userFromLinkState(response.State)).To(Equal("user-a"))
+		_, err := router.userFromLinkState(response.State + "x")
+		Expect(err).To(HaveOccurred())
+	})
+
+	It("scopes link status and unlink to the authenticated user", func() {
+		ds := &tests.MockDataStore{}
+		router := &Router{sessionKeys: &sessionKeys{ds: ds}}
+		Expect(ds.UserProps(context.Background()).Put("user-a", sessionKeyProperty, "SK-A")).To(Succeed())
+		Expect(ds.UserProps(context.Background()).Put("user-b", sessionKeyProperty, "SK-B")).To(Succeed())
+		ctx := request.WithUser(context.Background(), model.User{ID: "user-b"})
+		recorder := httptest.NewRecorder()
+		router.getLinkStatus(recorder, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx))
+		Expect(recorder.Body.String()).To(ContainSubstring("true"))
+		router.unlink(httptest.NewRecorder(), httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+		Expect(ds.UserProps(ctx).Get("user-a", sessionKeyProperty)).To(Equal("SK-A"))
+		_, err := ds.UserProps(ctx).Get("user-b", sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+	})
+
+	It("rejects an unsigned callback user ID", func() {
+		router := &Router{secret: "test-secret"}
+		recorder := httptest.NewRecorder()
+		router.callback(recorder, httptest.NewRequest(http.MethodGet, "/link/callback?uid=user-b&token=test", strings.NewReader("")))
+		Expect(recorder.Code).To(Equal(http.StatusBadRequest))
+	})
+})
