+type linkState struct {
+	UserID  string `json:"userId"`
+	Expires int64  `json:"expires"`
+}
+
+func (s *Router) getLinkState(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	payload, err := json.Marshal(linkState{UserID: user.ID, Expires: time.Now().Add(10 * time.Minute).Unix()})
+	if err != nil {
+		_ = rest.RespondWithError(w, http.StatusInternalServerError, err.Error())
+		return
+	}
+	data := base64.RawURLEncoding.EncodeToString(payload)
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(data))
+	state := data + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+	_ = rest.RespondWithJSON(w, http.StatusOK, map[string]string{"state": state})
+}
+
+func (s *Router) userFromLinkState(encoded string) (string, error) {
+	parts := strings.Split(encoded, ".")
+	if len(parts) != 2 {
+		return "", errors.New("invalid link state")
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", errors.New("invalid link state")
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(parts[0]))
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", errors.New("invalid link state")
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", errors.New("invalid link state")
+	}
+	var state linkState
+	if err = json.Unmarshal(payload, &state); err != nil || state.UserID == "" || time.Now().Unix() >= state.Expires {
+		return "", errors.New("invalid link state")
+	}
+	return state.UserID, nil
+}
