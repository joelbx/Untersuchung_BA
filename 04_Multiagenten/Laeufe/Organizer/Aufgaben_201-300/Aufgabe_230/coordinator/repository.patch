+def test_prioritized_identifier_equality_and_json() -> None:
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    isbn = PrioritizedIdentifier("9780123456786", timestamp=timestamp)
+    duplicate = PrioritizedIdentifier(
+        "9780123456786", stage_import=False, priority=Priority.HIGH
+    )
+    asin = PrioritizedIdentifier("B012346789", stage_import=False)
+
+    assert len({isbn, duplicate, asin}) == 2
+    assert isbn == duplicate
+    assert isbn != asin
+    assert json.loads(json.dumps(asin.to_dict())) == {
+        "identifier": "B012346789",
+        "stage_import": False,
+        "priority": "LOW",
+        "timestamp": asin.timestamp.isoformat(),
+    }
+    assert isbn.to_dict()["timestamp"] == "2024-01-02T03:04:05"
+    assert PrioritizedISBN(isbn="9780123456786").identifier == isbn.identifier
+    legacy = PrioritizedISBN("9780123456786", Priority.HIGH, timestamp)
+    assert legacy.priority == Priority.HIGH
+    assert legacy.timestamp == timestamp
+
+
