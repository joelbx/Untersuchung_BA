+#!/usr/bin/python
+
+# Copyright: (c) 2020, NetApp, Inc.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1', 'status': ['preview'], 'supported_by': 'community'}
+
+DOCUMENTATION = '''
+---
+module: netapp_e_drive_firmware
+short_description: Manage NetApp E-Series drive firmware
+description:
+  - Upload drive firmware and upgrade compatible drives that are not already at the supplied version.
+version_added: '2.10'
+author: NetApp
+extends_documentation_fragment:
+  - netapp.eseries
+options:
+  firmware:
+    description: Local paths to NetApp E-Series drive firmware files.
+    type: list
+    elements: path
+    required: true
+  wait_for_completion:
+    description: Wait until all selected drives finish upgrading.
+    type: bool
+    default: no
+  ignore_inaccessible_drives:
+    description: Skip offline or unavailable drives instead of failing.
+    type: bool
+    default: no
+  upgrade_drives_online:
+    description: Upgrade drives while they continue to accept I/O.
+    type: bool
+    default: yes
+notes:
+  - Check mode uploads the firmware so the controller can report compatibility, but does not initiate an upgrade.
+'''
+
+EXAMPLES = '''
+- name: Upgrade compatible drives
+  netapp_e_drive_firmware:
+    api_url: https://array.example.com/devmgr/v2
+    api_username: admin
+    api_password: "{{ password }}"
+    ssid: '1'
+    firmware:
+      - /tmp/drive_firmware.dlp
+    wait_for_completion: yes
+'''
+
+RETURN = '''
+upgrade_in_process:
+  description: Whether the requested upgrade is still running when the module exits.
+  returned: always
+  type: bool
+'''
+
+import json
+import os
+import time
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.netapp import create_multipart_formdata, eseries_host_argument_spec, request
+from ansible.module_utils._text import to_native
+
+
+class NetAppESeriesDriveFirmware(object):
+    WAIT_TIMEOUT_SEC = 3600
+    POLL_INTERVAL_SEC = 5
+    HEADERS = {'Content-Type': 'application/json', 'Accept': 'application/json'}
+
+    def __init__(self):
+        argument_spec = eseries_host_argument_spec()
+        argument_spec.update(dict(
+            firmware=dict(type='list', elements='path', required=True),
+            wait_for_completion=dict(type='bool', default=False),
+            ignore_inaccessible_drives=dict(type='bool', default=False),
+            upgrade_drives_online=dict(type='bool', default=True),
+        ))
+        self.module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+        params = self.module.params
+        self.firmware_list = params['firmware']
+        self.wait_for_completion = params['wait_for_completion']
+        self.ignore_inaccessible_drives = params['ignore_inaccessible_drives']
+        self.upgrade_drives_online = params['upgrade_drives_online']
+        self.ssid = params['ssid']
+        self.api_url = params['api_url'].rstrip('/') + '/'
+        self.url = self.api_url + 'storage-systems/%s/' % self.ssid
+        self.creds = dict(url_username=params['api_username'], url_password=params['api_password'],
+                          validate_certs=params['validate_certs'])
+        self.upgrade_in_progress = False
+        self._upgrade_list = None
+
+    def _request(self, path, method='GET', data=None, headers=None):
+        url = self.api_url + path if path.startswith('files/') else self.url + path
+        status, response = request(url, method=method, data=data, headers=headers or self.HEADERS,
+                                   **self.creds)
+        if status >= 400:
+            raise ValueError('HTTP %s: %s' % (status, response))
+        return status, response
+
+    @staticmethod
+    def _value(record, *names):
+        for name in names:
+            if name in record:
+                return record[name]
+        return None
+
+    def upload_firmware(self):
+        for path in self.firmware_list:
+            try:
+                headers, body = create_multipart_formdata([('file', os.path.basename(path), path)])
+                headers['Accept'] = 'application/json'
+                self._request('files/drive', method='POST', data=body, headers=headers)
+            except Exception as error:
+                self.module.fail_json(msg='Failed to upload drive firmware %s to array %s: %s' %
+                                      (path, self.ssid, to_native(error)))
+
+    def upgrade_list(self):
+        if self._upgrade_list is not None:
+            return self._upgrade_list
+        try:
+            unused, compatibility = self._request('firmware/drives')
+            if isinstance(compatibility, dict):
+                compatibility = self._value(compatibility, 'compatibility', 'firmwareCompatibility',
+                                            'firmware', 'driveFirmware')
+            if not isinstance(compatibility, list):
+                raise ValueError('Unexpected compatibility response')
+        except Exception as error:
+            self.module.fail_json(msg='Failed to complete compatibility and health check. Array %s: %s' %
+                                  (self.ssid, to_native(error)))
+
+        filenames = set(os.path.basename(path) for path in self.firmware_list)
+        upgrades = dict((name, []) for name in filenames)
+        for item in compatibility:
+            if not isinstance(item, dict):
+                continue
+            filename = self._value(item, 'filename', 'fileName', 'firmwareFileName')
+            if filename not in filenames:
+                continue
+            target = self._value(item, 'targetVersion', 'newVersion', 'firmwareVersion', 'version')
+            candidates = self._value(item, 'compatibleDrives', 'drives', 'driveRefList', 'driveReferences')
+            if candidates is None:
+                candidates = [item] if self._value(item, 'driveRef', 'driveReference') else []
+            if isinstance(candidates, dict):
+                candidates = self._value(candidates, 'driveRef', 'drives') or []
+            for candidate in candidates:
+                if isinstance(candidate, dict) and self._value(candidate, 'compatible', 'isCompatible', 'supported') is False:
+                    continue
+                drive_ref = candidate if isinstance(candidate, str) else self._value(candidate, 'driveRef', 'driveReference', 'id')
+                if not drive_ref:
+                    continue
+                try:
+                    unused, drive = self._request('drives/%s' % drive_ref)
+                    if not isinstance(drive, dict):
+                        raise ValueError('Unexpected drive response')
+                except Exception as error:
+                    self.module.fail_json(msg='Failed to retrieve drive information. Array %s, drive %s: %s' %
+                                          (self.ssid, drive_ref, to_native(error)))
+                if drive.get('offline') or drive.get('available') is False or drive.get('status') in ('offline', 'unavailable'):
+                    if self.ignore_inaccessible_drives:
+                        continue
+                    self.module.fail_json(msg='Drive %s is inaccessible on array %s.' % (drive_ref, self.ssid))
+                drive_target = self._value(candidate, 'targetVersion', 'newVersion', 'firmwareVersion', 'version') if isinstance(candidate, dict) else None
+                desired = drive_target or target
+                if desired is None:
+                    self.module.fail_json(msg='Firmware %s has no target version in compatibility data on array %s.' %
+                                          (filename, self.ssid))
+                current = self._value(drive, 'firmwareVersion', 'softwareVersion')
+                if current == desired:
+                    continue
+                capable = self._value(candidate, 'onlineUpgradeCapable', 'onlineUpgradeSupported', 'isOnlineUpgradeCapable') if isinstance(candidate, dict) else None
+                if capable is None:
+                    capable = self._value(item, 'onlineUpgradeCapable', 'onlineUpgradeSupported', 'isOnlineUpgradeCapable')
+                if self.upgrade_drives_online and capable is False:
+                    self.module.fail_json(msg='Drive is not capable of online upgrade. Array %s, drive %s.' %
+                                          (self.ssid, drive_ref))
+                if drive_ref not in upgrades[filename]:
+                    upgrades[filename].append(drive_ref)
+        self._upgrade_list = [dict(filename=os.path.basename(path), driveRefList=upgrades[os.path.basename(path)])
+                              for path in self.firmware_list if upgrades[os.path.basename(path)]]
+        return self._upgrade_list
+
+    def wait_for_upgrade_completion(self):
+        targets = set(ref for item in self.upgrade_list() for ref in item['driveRefList'])
+        deadline = time.time() + self.WAIT_TIMEOUT_SEC
+        while targets:
+            try:
+                unused, states = self._request('firmware/drives/state')
+                if isinstance(states, dict):
+                    states = self._value(states, 'driveStates', 'drives', 'state')
+                if not isinstance(states, list):
+                    raise ValueError('Unexpected drive-state response')
+            except Exception as error:
+                self.module.fail_json(msg='Failed to retrieve drive status. Array %s: %s' %
+                                      (self.ssid, to_native(error)))
+            for state in states:
+                ref = self._value(state, 'driveRef', 'driveReference', 'id')
+                if ref not in targets:
+                    continue
+                status = self._value(state, 'status', 'state')
+                if status == 'okay':
+                    targets.remove(ref)
+                elif status not in ('inProgress', 'inProgressRecon', 'pending', 'notAttempted'):
+                    self.module.fail_json(msg='Drive firmware upgrade failed. Array %s, drive %s, status %s.' %
+                                          (self.ssid, ref, status))
+            if not targets:
+                break
+            if time.time() >= deadline:
+                self.module.fail_json(msg='Timed out waiting for drive firmware upgrade. Array %s, drives %s.' %
+                                      (self.ssid, ', '.join(sorted(targets))))
+            time.sleep(min(self.POLL_INTERVAL_SEC, max(0, deadline - time.time())))
+        self.upgrade_in_progress = False
+
+    def upgrade(self):
+        upgrades = self.upgrade_list()
+        if not upgrades:
+            return
+        try:
+            self._request('firmware/drives/initiate-upgrade', method='POST',
+                          data=json.dumps(dict(driveFirmware=upgrades, onlineUpgrade=self.upgrade_drives_online)))
+        except Exception as error:
+            self.module.fail_json(msg='Failed to upgrade drive firmware. Array %s: %s' %
+                                  (self.ssid, to_native(error)))
+        self.upgrade_in_progress = True
+        if self.wait_for_completion:
+            self.wait_for_upgrade_completion()
+
+    def apply(self):
+        self.upload_firmware()
+        upgrades = self.upgrade_list()
+        if upgrades and not self.module.check_mode:
+            self.upgrade()
+        self.module.exit_json(changed=bool(upgrades), upgrade_in_process=self.upgrade_in_progress)
+
+
+def main():
+    NetAppESeriesDriveFirmware().apply()
+
+
+if __name__ == '__main__':
+    main()
