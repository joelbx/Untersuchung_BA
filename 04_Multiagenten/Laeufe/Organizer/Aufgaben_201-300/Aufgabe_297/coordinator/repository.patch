+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		result := reflect.MakeMapWithSize(v.Type(), v.Len())
+		for _, key := range v.MapKeys() {
+			entry := v.MapIndex(key).Interface()
+			var replacement interface{}
+			if re.MatchString(fmt.Sprint(key.Interface())) {
+				replacement = "[REDACTED]"
+			} else {
+				replacement = redactValue(entry, re)
+			}
+			rv := reflect.ValueOf(replacement)
+			if !rv.IsValid() {
+				rv = reflect.Zero(v.Type().Elem())
+			}
+			if rv.Type().AssignableTo(v.Type().Elem()) {
+				result.SetMapIndex(key, rv)
+			} else {
+				// A map with a concrete value type cannot hold a redacted string.
+				// Preserve its keys in an interface-valued map instead.
+				converted := make(map[interface{}]interface{}, v.Len())
+				for _, k := range v.MapKeys() {
+					if re.MatchString(fmt.Sprint(k.Interface())) {
+						converted[k.Interface()] = "[REDACTED]"
+					} else {
+						converted[k.Interface()] = redactValue(v.MapIndex(k).Interface(), re)
+					}
+				}
+				return converted
+			}
+		}
+		return result.Interface()
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
