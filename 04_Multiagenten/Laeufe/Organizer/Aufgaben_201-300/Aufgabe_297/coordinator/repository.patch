+// validateIPAgainstList checks the actual connection address, never a forwarded header.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if strings.TrimSpace(whitelist) == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteAddr = host
+	}
+	ip, err := netip.ParseAddr(strings.Trim(remoteAddr, "[]"))
+	if err != nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		if prefix, err := netip.ParsePrefix(entry); err == nil {
+			if prefix.Contains(ip) {
+				return true
+			}
+			continue
+		}
+		if addr, err := netip.ParseAddr(entry); err == nil && addr == ip {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for reverse proxy login", countErr)
+			return nil
+		}
+		password := make([]byte, 32)
+		if _, err = rand.Read(password); err != nil {
+			log.Error(r, "Generating reverse proxy user password", err)
+			return nil
+		}
+		user = &model.User{UserName: username, Name: strings.Title(username), NewPassword: fmt.Sprintf("%x", password), IsAdmin: count == 0}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Creating reverse proxy user", err)
+			return nil
+		}
+		// Read the stored user so the response reflects database defaults and password.
+		user, err = repo.FindByUsername(username)
+	}
+	if err != nil || user == nil {
+		log.Error(r, "Finding reverse proxy user", err)
+		return nil
+	}
+	if err = repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating reverse proxy user login", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating reverse proxy user token", err)
+		return nil
+	}
+	salt := make([]byte, 6)
+	if _, err = rand.Read(salt); err != nil {
+		log.Error(r, "Generating reverse proxy subsonic salt", err)
+		return nil
+	}
+	subsonicSalt := fmt.Sprintf("%x", salt)
+	return map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         token,
+		"subsonicSalt":  subsonicSalt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+subsonicSalt))),
+	}
+}
+
