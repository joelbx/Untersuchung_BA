+func TestNestedMapRedaction(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{
+		"request": map[string]interface{}{
+			"token":  "abc123",
+			"nested": map[string]interface{}{"secret": 12345, "safe": "value"},
+		},
+	}}
+	hook := &Hook{RedactionList: []string{"(?i)token|secret"}}
+	assert.NoError(t, hook.Fire(entry))
+	request := entry.Data["request"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", request["token"])
+	nested := request["nested"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", nested["secret"])
+	assert.Equal(t, "value", nested["safe"])
+	assert.Equal(t, "the [REDACTED] is here", redactValue("the secret is here", hook.redactionKeys[0]))
+}
+
+func TestDefaultRedactionOfAuthPayload(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{
