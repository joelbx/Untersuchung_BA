@@ -0,0 +1,99 @@
+package app
+
+import (
+	"crypto/md5"
+	"fmt"
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	list := "bad, 192.0.2.0/24, 2001:db8::/32, @"
+	for _, tc := range []struct {
+		address string
+		want    bool
+	}{
+		{"192.0.2.4:1234", true},
+		{"192.0.3.4:1234", false},
+		{"[2001:db8::4]:1234", true},
+		{"[2001:db9::4]:1234", false},
+		{"@", true},
+		{"/tmp/navidrome.sock", false},
+	} {
+		if got := validateIPAgainstList(tc.address, list); got != tc.want {
+			t.Errorf("address %q: got %v, want %v", tc.address, got, tc.want)
+		}
+	}
+	if validateIPAgainstList("192.0.2.4:1234", "") {
+		t.Fatal("empty whitelist must disable proxy authentication")
+	}
+	if !validateIPAgainstList("192.0.2.4:1234", "192.0.2.4:4533") {
+		t.Fatal("IP:port whitelist entry should match its IP")
+	}
+}
+
+func TestReverseProxyIndexAuthentication(t *testing.T) {
+	previous := *conf.Server
+	defer func() { *conf.Server = previous }()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "X-Proxy-User"
+	conf.Server.ReverseProxyDefaultUser = ""
+	ds := &tests.MockDataStore{}
+	index := serveIndex(ds, os.DirFS("tests/fixtures"))
+
+	request := func(address, username string) (map[string]interface{}, string) {
+		r := httptest.NewRequest("GET", "/", nil)
+		r.RemoteAddr = address
+		r.Header.Set("X-Proxy-User", username)
+		w := httptest.NewRecorder()
+		index(w, r)
+		return extractAppConfig(w.Body.String()), w.Header().Get("Cache-Control")
+	}
+	if config, _ := request("198.51.100.1:1234", "alice"); config["auth"] != nil {
+		t.Fatal("untrusted request received authentication")
+	}
+	if count, _ := ds.User(httptest.NewRequest("GET", "/", nil).Context()).CountAll(); count != 0 {
+		t.Fatal("untrusted request created a user")
+	}
+	if config, _ := request("192.0.2.1:1234", ""); config["auth"] != nil {
+		t.Fatal("request without a username received authentication")
+	}
+	config, cache := request("192.0.2.1:1234", "alice")
+	if cache != "private, no-store" {
+		t.Fatalf("authenticated index should not be cached: %q", cache)
+	}
+	data, ok := config["auth"].(map[string]interface{})
+	if !ok || data["username"] != "alice" || data["name"] != "Alice" || data["isAdmin"] != true {
+		t.Fatalf("unexpected auth payload: %#v", config["auth"])
+	}
+	if _, err := auth.Validate(data["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	user, err := ds.User(httptest.NewRequest("GET", "/", nil).Context()).FindByUsername("alice")
+	if err != nil || user.LastLoginAt == nil || user.ID != data["id"] {
+		t.Fatalf("user state was not updated: %#v, %v", user, err)
+	}
+	salt := data["subsonicSalt"].(string)
+	wantSubsonic := fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt)))
+	if data["subsonicToken"] != wantSubsonic {
+		t.Fatal("invalid subsonic token")
+	}
+	config, _ = request("192.0.2.1:1234", "bob")
+	if config["auth"].(map[string]interface{})["isAdmin"] != false {
+		t.Fatal("subsequent user must not be admin")
+	}
+	conf.Server.ReverseProxyDefaultUser = "guest"
+	config, _ = request("192.0.2.1:1234", "")
+	if config["auth"].(map[string]interface{})["username"] != "guest" {
+		t.Fatal("configured default user was not used")
+	}
+	config, _ = request("@", "alice")
+	if config["auth"] != nil {
+		t.Fatal("Unix socket must be explicitly whitelisted")
+	}
+}
