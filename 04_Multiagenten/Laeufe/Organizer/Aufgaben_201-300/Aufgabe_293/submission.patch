+func validateOCIReference(repository string) error {
+	scheme, name, explicit := strings.Cut(repository, "://")
+	if explicit {
+		switch scheme {
+		case "http", "https", "flipt":
+		default:
+			return fmt.Errorf("unexpected repository scheme: %q should be one of [http|https|flipt]", scheme)
+		}
+	} else {
+		name = scheme
+	}
+
+	if !strings.Contains(name, "/") {
+		name = "local/" + name
+	}
+	ref, err := registry.ParseReference(name)
+	if err != nil {
+		return err
+	}
+	if explicit && scheme == "flipt" && ref.Registry != "local" {
+		return fmt.Errorf("unexpected local reference: %q", ref)
+	}
+	return nil
+}
+
+// DefaultBundleDir returns the default directory for local OCI bundles.
+func DefaultBundleDir() (string, error) {
+	dir, err := Dir()
+	if err != nil {
+		return "", err
+	}
+	bundlesDir := filepath.Join(dir, "bundles")
+	if err := os.MkdirAll(bundlesDir, 0755); err != nil {
+		return "", fmt.Errorf("creating bundles directory: %w", err)
+	}
+	return bundlesDir, nil
+}
