+func oci(ctx context.Context, _ *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	const bundlesDir = "/tmp/flipt-oci-bundles"
+	built, err := flipt.
+		WithDirectory("/tmp/oci-input", base.Directory(testdataDir)).
+		WithWorkdir("/tmp/oci-input").
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", "features:latest").
+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", bundlesDir).
+		WithExec([]string{"/flipt", "bundle", "build", "features:latest"}).
+		Sync(ctx)
+	if err != nil {
+		return func() error { return err }
+	}
+
+	flipt = flipt.
+		WithDirectory(bundlesDir, built.Directory(bundlesDir)).
+		WithEnvVariable("FLIPT_LOG_LEVEL", "DEBUG").
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", "features:latest").
+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", bundlesDir).
+		WithEnvVariable("UNIQUE", uuid.New().String())
+
+	return suite(ctx, "readonly", base, flipt.WithExec(nil), conf)
+}
