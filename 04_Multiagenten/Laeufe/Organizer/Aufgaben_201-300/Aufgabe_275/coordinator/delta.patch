+++ b/lib/httplib/httplib_test.go
@@ -17,6 +17,7 @@ limitations under the License.
 package httplib
 
 import (
+	"errors"
 	"net/http"
 	"net/http/httptest"
 	"testing"
@@ -25,6 +26,49 @@ import (
 	. "gopkg.in/check.v1"
 )
 
+func TestHandlersWithErrorWriter(t *testing.T) {
+	wantErr := errors.New("handler failed")
+	for _, tt := range []struct {
+		name        string
+		makeHandler func(func(http.ResponseWriter, *http.Request) (interface{}, error), ErrorWriter) http.HandlerFunc
+	}{
+		{
+			name: "router",
+			makeHandler: func(fn func(http.ResponseWriter, *http.Request) (interface{}, error), writeErr ErrorWriter) http.HandlerFunc {
+				return func(w http.ResponseWriter, r *http.Request) {
+					MakeHandlerWithErrorWriter(func(w http.ResponseWriter, r *http.Request, _ httprouter.Params) (interface{}, error) {
+						return fn(w, r)
+					}, writeErr)(w, r, nil)
+				}
+			},
+		},
+		{
+			name: "standard",
+			makeHandler: func(fn func(http.ResponseWriter, *http.Request) (interface{}, error), writeErr ErrorWriter) http.HandlerFunc {
+				return MakeStdHandlerWithErrorWriter(fn, writeErr)
+			},
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			var gotErr error
+			handler := tt.makeHandler(func(http.ResponseWriter, *http.Request) (interface{}, error) {
+				return nil, wantErr
+			}, func(w http.ResponseWriter, err error) {
+				gotErr = err
+				w.WriteHeader(http.StatusTeapot)
+			})
+			response := httptest.NewRecorder()
+			handler(response, httptest.NewRequest(http.MethodGet, "/", nil))
+			if gotErr != wantErr || response.Code != http.StatusTeapot {
+				t.Fatalf("error writer: got error %v, status %d", gotErr, response.Code)
+			}
+			if response.Header().Get("Cache-Control") == "" {
+				t.Fatal("missing no-cache header")
+			}
+		})
+	}
+}
+
 func TestHTTP(t *testing.T) { TestingT(t) }
 
