+func sourcePositions(b []byte) map[string]sourcePosition {
+	var doc yamlv3.Node
+	if err := yamlv3.Unmarshal(b, &doc); err != nil {
+		return nil
+	}
+	positions := make(map[string]sourcePosition)
+	var walk func(*yamlv3.Node, string)
+	walk = func(node *yamlv3.Node, path string) {
+		switch node.Kind {
+		case yamlv3.DocumentNode:
+			if len(node.Content) > 0 {
+				walk(node.Content[0], path)
+			}
+		case yamlv3.MappingNode:
+			for i := 0; i+1 < len(node.Content); i += 2 {
+				key, value := node.Content[i], node.Content[i+1]
+				child := key.Value
+				if path != "" {
+					child = path + "." + child
+				}
+				positions[child] = sourcePosition{
+					key:   Location{Line: key.Line, Column: key.Column},
+					value: Location{Line: value.Line, Column: value.Column},
+				}
+				walk(value, child)
+			}
+		case yamlv3.SequenceNode:
+			for i, value := range node.Content {
+				child := fmt.Sprintf("%s.%d", path, i)
+				positions[child] = sourcePosition{value: Location{Line: value.Line, Column: value.Column}}
+				walk(value, child)
+			}
 		}
 	}
+	walk(&doc, "")
