diff --git a/src/database/incrementBulk.js b/src/database/incrementBulk.js
new file mode 100644
index 0000000..5637e53
--- /dev/null
+++ b/src/database/incrementBulk.js
@@ -0,0 +1,37 @@
+'use strict';
+
+module.exports = function normalizeIncrements(data, fieldToString = String) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+
+	const byKey = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must contain [key, increments] tuples');
+		}
+
+		const increments = byKey.get(item[0]) || Object.create(null);
+		Object.entries(item[1]).forEach(([name, value]) => {
+			const field = fieldToString(name);
+			if (!field || field === '__proto__' || field === 'constructor' || field === 'prototype' ||
+				field === '_key' || field === '_id' || /[.$\uff0e]/.test(field)) {
+				throw new TypeError(`Invalid increment field: ${field}`);
+			}
+			if (!Number.isSafeInteger(value)) {
+				throw new TypeError(`Increment for ${field} must be a safe integer`);
+			}
+			const sum = (increments[field] || 0) + value;
+			if (!Number.isSafeInteger(sum)) {
+				throw new RangeError(`Combined increment for ${field} exceeds the safe integer range`);
+			}
+			increments[field] = sum;
+		});
+		if (Object.keys(increments).length) {
+			byKey.set(item[0], increments);
+		}
+	});
+	return byKey;
+};
