@@ -261,4 +262,32 @@ module.exports = function (module) {
 			throw err;
 		}
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const increments = normalizeIncrements(data, helpers.fieldToString);
+		if (!increments.size) {
+			return;
+		}
+
+		const collection = module.client.collection('objects');
+		const entries = Array.from(increments);
+		const results = await Promise.allSettled(entries.map(async ([key, fields]) => {
+			try {
+				await collection.updateOne({ _key: key }, { $inc: fields }, { upsert: true });
+			} catch (err) {
+				if (!err || !err.message || !err.message.startsWith('E11000 duplicate key error')) {
+					throw err;
+				}
+				await collection.updateOne({ _key: key }, { $inc: fields });
+			}
+		}));
+		const successfulKeys = entries.filter((entry, index) => results[index].status === 'fulfilled').map(entry => entry[0]);
+		if (successfulKeys.length) {
+			cache.del(successfulKeys);
+		}
+		const failure = results.find(result => result.status === 'rejected');
+		if (failure) {
+			throw failure.reason;
+		}
+	};
 };
diff --git a/src/database/redis/hash.js b/src/database/redis/hash.js
