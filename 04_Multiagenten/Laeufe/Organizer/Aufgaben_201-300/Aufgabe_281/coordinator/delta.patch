--- a/src/database/redis/hash.js
+++ b/src/database/redis/hash.js
@@ -2,6 +2,30 @@
 
 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const normalizeIncrements = require('../incrementBulk');
+
+	// Preflight every field before writing: a Lua error after HINCRBY would not roll back earlier fields.
+	const bulkIncrementScript = `
+local fields = {}
+for i = 1, #ARGV, 2 do
+	fields[#fields + 1] = ARGV[i]
+end
+local values = redis.call('HMGET', KEYS[1], unpack(fields))
+for i = 1, #fields do
+	local value = values[i]
+	local increment = tonumber(ARGV[2 * i])
+	if value then
+		if not string.match(value, '^%-?%d+$') or not tonumber(value) or
+			math.abs(tonumber(value)) > 9007199254740991 or
+			math.abs(tonumber(value) + increment) > 9007199254740991 then
+			return redis.error_reply('Invalid or out-of-range increment field: ' .. fields[i])
+		end
+	end
+end
+for i = 1, #fields do
+	redis.call('HINCRBY', KEYS[1], fields[i], ARGV[2 * i])
+end
+return 1`;
 
 	const cache = require('../cache').create('redis');
 
@@ -219,4 +243,27 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const increments = normalizeIncrements(data);
+		if (!increments.size) {
+			return;
+		}
+
+		const batch = module.client.batch();
+		const entries = Array.from(increments);
+		entries.forEach(([key, fields]) => {
+			const args = Object.entries(fields).flatMap(([field, value]) => [field, String(value)]);
+			batch.eval(bulkIncrementScript, 1, key, ...args);
+		});
+		const results = await batch.exec();
+		const successfulKeys = entries.filter((entry, index) => !results[index][0]).map(entry => entry[0]);
+		if (successfulKeys.length) {
+			cache.del(successfulKeys);
+		}
+		const failure = results.find(result => result[0]);
+		if (failure) {
+			throw failure[0];
+		}
+	};
 };
