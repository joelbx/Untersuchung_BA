     if rc != 0:
-        return dict()
+        module.warn('Unable to read sysctl: %s' % err)
+        return {}
 
-    sysctl = dict()
+    sysctl = {}
+    last_key = None
     for line in out.splitlines():
         if not line:
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
-        sysctl[key] = value.strip()
+        if line[0].isspace() and last_key is not None:
+            sysctl[last_key] += '\n' + line
+            continue
+        try:
+            match = re.match(r'^([^\s=:]+)(?:\s*=\s*|:\s*|\s+)(.*)$', line)
+            if match is None:
+                raise ValueError('no key/value delimiter')
+            key, value = match.groups()
+            sysctl[key] = value.strip()
+            last_key = key
+        except ValueError as error:
+            module.warn('Unable to split sysctl line (%s): %s' % (line, error))
 
     return sysctl
+
+
+def get_uptime_facts(module):
+    """Read a numeric boot timestamp from sysctl and calculate uptime."""
+    command = _sysctl_command(module)
+    try:
+        rc, out, err = module.run_command([command, '-n', 'kern.boottime'])
+    except (IOError, OSError) as error:
+        if getattr(error, 'errno', None) == errno.ENOENT:
+            raise ValueError('sysctl command not found')
+        module.warn('Unable to read sysctl: %s' % error)
+        return {}
+    if rc != 0:
+        module.warn('Unable to read sysctl: %s' % err)
+        return {}
+    boot_time = out.strip()
+    if not re.match(r'^\d+(?:\.\d+)?$', boot_time):
+        return {}
+    return {'uptime_seconds': int(time.time() - float(boot_time))}
diff --git a/test/units/module_utils/facts/test_sysctl.py b/test/units/module_utils/facts/test_sysctl.py
new file mode 100644
index 0000000..ddf1516
--- /dev/null
+++ b/test/units/module_utils/facts/test_sysctl.py
@@ -0,0 +1,105 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import errno
+
+import pytest
+
+from units.compat.mock import Mock, patch
+
+from ansible.module_utils.facts.sysctl import get_sysctl, get_uptime_facts
+from ansible.module_utils.facts.hardware.openbsd import OpenBSDHardware
+
+
+@pytest.mark.parametrize('line', [
+    'kern.osrelease=7.6',
+    'kern.osrelease: 7.6',
+    'kern.osrelease 7.6',
+])
+def test_sysctl_delimiters(line):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, line, '')
+
+    assert get_sysctl(module, ['kern']) == {'kern.osrelease': '7.6'}
+
+
+def test_sysctl_multiline_and_malformed_lines():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, 'kern.first: one\n  two\nbroken\nkern.last = three', '')
+
+    assert get_sysctl(module, ['kern']) == {
+        'kern.first': 'one\n  two',
+        'kern.last': 'three',
+    }
+    module.warn.assert_called_once_with('Unable to split sysctl line (broken): no key/value delimiter')
+
+
+@pytest.mark.parametrize('failure', ['exit', 'error'])
+def test_sysctl_command_failure(failure):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    if failure == 'exit':
+        module.run_command.return_value = (1, '', 'permission denied')
+    else:
+        module.run_command.side_effect = OSError(errno.EACCES, 'permission denied')
+
+    assert get_sysctl(module, ['kern']) == {}
+    assert module.warn.call_count == 1
+    assert module.warn.call_args[0][0].startswith('Unable to read sysctl: ')
+
+
+def test_uptime_from_numeric_boot_time():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, '100\n', '')
+
+    with patch('ansible.module_utils.facts.sysctl.time.time', return_value=160):
+        assert get_uptime_facts(module) == {'uptime_seconds': 60}
+    module.run_command.assert_called_once_with(['/sbin/sysctl', '-n', 'kern.boottime'])
+
+
+@pytest.mark.parametrize('result', [(0, '', ''), (0, '{ sec = 100 }', ''), (1, '', 'failed')])
+def test_uptime_omitted_without_numeric_boot_time(result):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = result
+
+    assert get_uptime_facts(module) == {}
+
+
+def test_missing_sysctl_raises_value_error():
+    module = Mock()
+    module.get_bin_path.return_value = None
+
+    with pytest.raises(ValueError):
+        get_uptime_facts(module)
+
+
+def test_missing_sysctl_executable_raises_value_error():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.side_effect = OSError(errno.ENOENT, 'No such file or directory')
+
+    with pytest.raises(ValueError):
+        get_uptime_facts(module)
+
+
+def test_openbsd_populate_keeps_all_fact_sources():
+    hardware = OpenBSDHardware(Mock())
+    sources = {
+        'get_processor_facts': {'processor': ['cpu']},
+        'get_memory_facts': {'memtotal_mb': 1024},
+        'get_device_facts': {'devices': ['sd0']},
+        'get_dmi_facts': {'product_name': 'machine'},
+        'get_mount_facts': {'mounts': ['/']},
+        'get_uptime_facts': {'uptime_seconds': 60},
+    }
+    with patch('ansible.module_utils.facts.hardware.openbsd.get_sysctl', return_value={}):
+        for method, result in sources.items():
+            setattr(hardware, method, Mock(return_value=result))
+        facts = hardware.populate()
+
+    for result in sources.values():
+        assert all(facts[key] == value for key, value in result.items())
