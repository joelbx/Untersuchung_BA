@@ -0,0 +1,113 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http/httptest"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, contents string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "config.yml")
+	if err := ioutil.WriteFile(path, []byte(contents), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	defaults, err := configure(writeConfig(t, "# defaults\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(defaults, defaultConfig()) {
+		t.Fatalf("defaults differ: %#v", defaults)
+	}
+
+	cert := filepath.Join(t.TempDir(), "cert.pem")
+	key := filepath.Join(t.TempDir(), "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := ioutil.WriteFile(path, []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := writeConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: [foo.com]\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: "+cert+"\n  cert_key: "+key+"\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server != (serverConfig{"127.0.0.1", HTTPS, 8081, 8080, 9001, cert, key}) || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("unexpected config: %#v", cfg)
+	}
+
+	t.Setenv("FLIPT_SERVER_PROTOCOL", "http")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+	t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", "bar.com")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.Protocol != HTTP || cfg.Server.HTTPPort != 8181 || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"bar.com"}) {
+		t.Fatalf("environment override failed: %#v", cfg)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	if err := cfg.validate(); err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("cert file: %v", err)
+	}
+	cfg.Server.CertFile = "missing-cert"
+	if err := cfg.validate(); err == nil || err.Error() != "cert_key cannot be empty when using HTTPS" {
+		t.Fatalf("cert key: %v", err)
+	}
+	cfg.Server.CertKey = "missing-key"
+	if err := cfg.validate(); err == nil || err.Error() != `cannot find TLS cert_file at "missing-cert"` {
+		t.Fatalf("missing cert: %v", err)
+	}
+	file := filepath.Join(t.TempDir(), "cert")
+	if err := ioutil.WriteFile(file, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Server.CertFile = file
+	if err := cfg.validate(); err == nil || err.Error() != `cannot find TLS cert_key at "missing-key"` {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []struct {
+		name  string
+		serve func(*httptest.ResponseRecorder)
+	}{
+		{"config", func(w *httptest.ResponseRecorder) { defaultConfig().ServeHTTP(w, httptest.NewRequest("GET", "/", nil)) }},
+		{"info", func(w *httptest.ResponseRecorder) {
+			(info{Version: "test"}).ServeHTTP(w, httptest.NewRequest("GET", "/", nil))
+		}},
+	} {
+		t.Run(handler.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			handler.serve(w)
+			if w.Code != 200 || strings.TrimSpace(w.Body.String()) == "" {
+				t.Fatalf("status %d body %q", w.Code, w.Body.String())
+			}
+			if handler.name == "config" && !strings.Contains(w.Body.String(), `"protocol":"http"`) {
+				t.Fatalf("protocol missing from config response: %q", w.Body.String())
+			}
+		})
+	}
+}
+
+func TestSchemeString(t *testing.T) {
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("unexpected scheme strings")
+	}
+}
