 import pytest
 
+from ansible.executor import module_common as amc
 from ansible.executor.module_common import modify_module
 from ansible.module_utils.six import PY2
 
@@ -41,3 +42,35 @@ def test_shebang_task_vars(fake_old_module_open, templar):
 
     (data, style, shebang) = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
     assert shebang == '#!/usr/bin/python3'
+
+
+@pytest.mark.parametrize('first_line, task_vars, expected', [
+    (b'#!/usr/bin/python3.8 -I', {}, b'#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -B', {'ansible_python_interpreter': '/usr/bin/python3'}, b'#!/usr/bin/python3 -B'),
+    (b'#!/usr/bin/ruby -w "two words"', {}, b'#!/usr/bin/ruby -w "two words"'),
+    (b'#!/usr/bin/ruby -w', {'ansible_ruby_interpreter': '/opt/ruby'}, b'#!/opt/ruby -w'),
+    (b'#!/usr/bin/ruby -w "two words"', {'ansible_ruby_interpreter': '/opt/ruby'}, b'#!/opt/ruby -w "two words"'),
+])
+def test_old_style_shebang(tmp_path, templar, first_line, task_vars, expected):
+    module_path = tmp_path / 'old_module'
+    module_path.write_bytes(first_line + b'\nprint(1)\n')
+    data, style, shebang = modify_module('old_module', str(module_path), {}, templar, task_vars=task_vars)
+    assert style == 'old'
+    assert data.split(b'\n')[:2] == [expected, amc.b_ENCODING_STRING]
+    assert shebang == expected.decode('utf-8')
+
+
+@pytest.mark.parametrize('first_line, task_vars, expected', [
+    (b'#!/usr/bin/python3.8 -I', {}, b'#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -B', {'ansible_python_interpreter': '/usr/bin/python3'}, b'#!/usr/bin/python3 -B'),
+    (b'#!/opt/venv/bin/python -B "two words"', {'ansible_python_interpreter': '/usr/bin/python3'}, b'#!/usr/bin/python3 -B "two words"'),
+    (b'', {}, b'#!/usr/bin/python'),
+])
+def test_new_style_shebang(tmp_path, monkeypatch, templar, first_line, task_vars, expected):
+    monkeypatch.setattr(amc.C, 'DEFAULT_LOCAL_TMP', str(tmp_path))
+    module_path = tmp_path / 'new_module.py'
+    module_path.write_bytes(first_line + b'\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    data, style, shebang = modify_module('new_module', str(module_path), {}, templar, task_vars=task_vars)
+    assert style == 'new'
+    assert data.split(b'\n')[:2] == [expected, amc.b_ENCODING_STRING]
+    assert shebang == expected.decode('utf-8')
