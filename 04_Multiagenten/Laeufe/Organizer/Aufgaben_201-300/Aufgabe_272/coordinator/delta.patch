+@pytest.mark.skipif(not HAS_SSLCONTEXT, reason='requires SSLContext')
+def test_ciphers_on_http_redirect_and_unix_socket(urlopen_mock, install_opener_mock):
+    from ansible.module_utils.urls import CustomHTTPSHandler
+
+    cipher = 'ECDHE-RSA-AES128-SHA256'
+    Request(ciphers=[cipher]).open('GET', 'http://ansible.com/')
+    opener = install_opener_mock.call_args[0][0]
+    https_handler = next(h for h in opener.handlers if isinstance(h, CustomHTTPSHandler))
+    assert cipher in [item['name'] for item in https_handler._context.get_ciphers()]
+
+    Request(ciphers=cipher).open('GET', 'https://ansible.com/', unix_socket='/tmp/test.sock')
+    opener = install_opener_mock.call_args[0][0]
+    unix_handler = next(h for h in opener.handlers if isinstance(h, HTTPSClientAuthHandler))
+    assert cipher in [item['name'] for item in unix_handler._context.get_ciphers()]
+
+
+@pytest.mark.skipif(not HAS_SSLCONTEXT, reason='requires SSLContext')
+def test_invalid_ciphers_fail_without_echoing_value(urlopen_mock, install_opener_mock):
+    bad_cipher = 'NOT_A_REAL_CIPHER_SECRET'
+    with pytest.raises(ValueError, match='Unsupported SSL/TLS cipher configuration') as exc:
+        Request().open('GET', 'http://ansible.com/', ciphers=bad_cipher)
+    assert bad_cipher not in str(exc.value)
