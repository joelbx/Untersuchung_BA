+def _is_child_path(path, parent, link_target=None):
+    """Whether a path, or a link at that path, resolves inside parent."""
+    if link_target is not None:
+        path = os.path.join(os.path.dirname(path), link_target)
+    path = os.path.realpath(path)
+    parent = os.path.realpath(parent)
+    separator = to_bytes(os.path.sep) if isinstance(parent, bytes) else os.path.sep
+    return path == parent or path.startswith(parent + separator)
 
 
