+def test_importapi_post_override_validation(monkeypatch, query_value, expected):
+    query = {} if query_value is None else {'override-validation': query_value}
+    calls = []
+    monkeypatch.setattr(code, 'can_write', lambda: True)
+    monkeypatch.setattr(web, 'header', lambda *args: None)
+    monkeypatch.setattr(web, 'input', lambda: query)
