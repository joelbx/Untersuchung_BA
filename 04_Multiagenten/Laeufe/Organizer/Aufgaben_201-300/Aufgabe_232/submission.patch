+++ b/internal/version/major.go
@@ -0,0 +1,14 @@
+package version
+
+import "strings"
+
+// Major returns the major component after an optional epoch.
+func Major(value string) string {
+	if i := strings.IndexByte(value, ':'); i >= 0 {
+		value = value[i+1:]
+	}
+	if i := strings.IndexByte(value, '.'); i >= 0 {
+		value = value[:i]
+	}
+	return value
+}
