@@ -0,0 +1,49 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestGetEOL(t *testing.T) {
+	tests := []struct {
+		family, release, standard, extended string
+	}{
+		{Amazon, "2018.03", "2023-06-30", "2023-06-30"},
+		{Amazon, "2 (Karoo)", "2025-06-30", ""},
+		{RedHat, "6", "2020-11-30", "2024-06-30"},
+		{CentOS, "8", "2021-12-31", ""},
+		{Oracle, "6", "2021-03-31", "2022-03-31"},
+		{Ubuntu, "14.10", "2015-07-30", "2015-07-30"},
+		{Debian, "10", "2024-06-30", ""},
+		{Alpine, "3.12", "2022-05-30", ""},
+		{FreeBSD, "11", "2021-09-30", "2021-09-30"},
+	}
+	for _, tt := range tests {
+		eol, found := GetEOL(tt.family, tt.release)
+		if !found || eol.StandardSupportUntil.Format("2006-01-02") != tt.standard {
+			t.Errorf("GetEOL(%q, %q) = %v, %v", tt.family, tt.release, eol, found)
+		}
+		if tt.extended == "" && !eol.ExtendedSupportUntil.IsZero() || tt.extended != "" && eol.ExtendedSupportUntil.Format("2006-01-02") != tt.extended {
+			t.Errorf("GetEOL(%q, %q) extended = %v", tt.family, tt.release, eol.ExtendedSupportUntil)
+		}
+	}
+	for _, tt := range []struct{ family, release string }{
+		{RedHat, "9"}, {RedHat, "7.1"}, {CentOS, "9"}, {Oracle, "9"},
+		{Ubuntu, "12.10"}, {Debian, "11"}, {Alpine, "3.13"},
+	} {
+		if _, found := GetEOL(tt.family, tt.release); found {
+			t.Errorf("unexpected lifecycle for %s %s", tt.family, tt.release)
+		}
+	}
+}
+
+func TestEOLBoundaries(t *testing.T) {
+	eol, _ := GetEOL(Ubuntu, "18.04")
+	if eol.IsStandardSupportEnded(eol.StandardSupportUntil) || !eol.IsStandardSupportEnded(eol.StandardSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("standard support boundary is not strict")
+	}
+	if eol.IsExtendedSuppportEnded(eol.ExtendedSupportUntil) || !eol.IsExtendedSuppportEnded(eol.ExtendedSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("extended support boundary is not strict")
+	}
+}
