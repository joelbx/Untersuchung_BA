diff --git a/scan/eol_test.go b/scan/eol_test.go
new file mode 100644
index 0000000..2de5cad
--- /dev/null
+++ b/scan/eol_test.go
@@ -0,0 +1,37 @@
+package scan
+
+import (
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestEOLWarnings(t *testing.T) {
+	date := func(s string) time.Time {
+		value, err := time.Parse("2006-01-02", s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return value
+	}
+	tests := []struct {
+		name, family, release, now string
+		want                       []string
+	}{
+		{"before window", "freebsd", "11", "2021-06-29", nil},
+		{"three month boundary", "freebsd", "11", "2021-06-30", []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"}},
+		{"end date", "freebsd", "11", "2021-09-30", []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"}},
+		{"extended available", "ubuntu", "18.04", "2023-06-01", []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.", "Extended support available until 2028-04-30. Check the vendor site."}},
+		{"fully ended", "ubuntu", "14.10", "2015-07-31", []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.", "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended."}},
+		{"unknown", "debian", "11", "2021-01-01", []string{"Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: debian Release: 11'"}},
+		{"pseudo", "pseudo", "", "2021-01-01", nil},
+		{"raspbian", "raspbian", "11", "2021-01-01", nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := eolWarnings(tt.family, tt.release, date(tt.now)); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("warnings = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
