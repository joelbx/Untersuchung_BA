index 0000000..be6fec9
--- /dev/null
+++ b/config/os.go
@@ -0,0 +1,106 @@
+package config
+
+import (
+	"time"
+)
+
+// OS family identifiers.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// EOL describes the support dates for an OS release. Ended marks releases
+// whose extended support ends on the same date as standard support.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support has ended.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether extended support has ended.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+type supportDates struct {
+	standard string
+	extended string
+}
+
+// eolDates is the canonical set of supported OS release lifecycles.
+var eolDates = map[string]map[string]supportDates{
+	Amazon: {
+		"2018.03":   {"2023-06-30", "2023-06-30"},
+		"2 (Karoo)": {"2025-06-30", ""},
+	},
+	RedHat: {
+		"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""},
+		"6": {"2020-11-30", "2024-06-30"},
+	},
+	CentOS: {
+		"7": {"2024-06-30", ""}, "8": {"2021-12-31", ""},
+		"6": {"2020-11-30", "2020-11-30"},
+	},
+	Oracle: {
+		"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""},
+		"6": {"2021-03-31", "2022-03-31"},
+	},
+	Ubuntu: {
+		"18.04": {"2023-05-31", "2028-04-30"},
+		"14.04": {"2019-04-30", "2024-04-30"},
+		"14.10": {"2015-07-30", "2015-07-30"},
+		"21.04": {"2022-01-30", ""},
+	},
+	Debian: {
+		"9": {"2022-06-30", ""}, "10": {"2024-06-30", ""},
+		"8": {"2020-06-30", "2020-06-30"},
+	},
+	Alpine: {
+		"3.10": {"2021-05-30", ""}, "3.11": {"2021-11-30", ""},
+		"3.12": {"2022-05-30", ""}, "3.9": {"2020-11-30", "2020-11-30"},
+	},
+	FreeBSD: {
+		"11": {"2021-09-30", "2021-09-30"},
+		"12": {"2023-12-31", ""},
+		"10": {"2019-10-30", "2019-10-30"},
+	},
+}
+
+// GetEOL returns lifecycle dates for an OS family and release.
+func GetEOL(family string, release string) (EOL, bool) {
+	byRelease, ok := eolDates[family]
+	if !ok {
+		return EOL{}, false
+	}
+	dates, ok := byRelease[release]
+	if !ok {
+		return EOL{}, false
+	}
+	standard, _ := time.Parse("2006-01-02", dates.standard)
+	var extended time.Time
+	if dates.extended != "" {
+		extended, _ = time.Parse("2006-01-02", dates.extended)
+	}
+	return EOL{standard, extended, dates.extended != "" && dates.extended == dates.standard}, true
+}
