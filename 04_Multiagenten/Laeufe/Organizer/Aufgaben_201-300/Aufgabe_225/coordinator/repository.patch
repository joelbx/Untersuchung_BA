diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..3b31987
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,34 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestConvertKEVs(t *testing.T) {
+	date := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	zero := time.Time{}
+	entries := convertKEVs(kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", VulnerabilityName: "CISA name", Notes: "note", DateAdded: date, DueDate: zero}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "VC vendor", Name: "VC name", Description: "description", DueDate: &date,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "123", XDBURL: "https://xdb", ExploitType: "poc", CloneSSHURL: "ssh://clone", DateAdded: date}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://report", DateAdded: date}},
+		}},
+	})
+	if len(entries) != 2 || entries[0].Type != models.CISAKEVType || entries[0].DueDate != nil || entries[0].CISA.Note != "note" {
+		t.Fatalf("incorrect CISA entry: %+v", entries)
+	}
+	vc := entries[1]
+	if vc.Type != models.VulnCheckKEVType || vc.VendorProject != "VC vendor" || vc.ShortDescription != "description" || vc.DueDate == nil || !vc.DueDate.Equal(date) {
+		t.Fatalf("incorrect VulnCheck entry: %+v", vc)
+	}
+	if len(vc.VulnCheck.XDB) != 1 || vc.VulnCheck.XDB[0].XDBID != "123" || vc.VulnCheck.XDB[0].CloneSSHURL != "ssh://clone" || len(vc.VulnCheck.ReportedExploitation) != 1 || vc.VulnCheck.ReportedExploitation[0].URL != "https://report" {
+		t.Fatalf("missing VulnCheck details: %+v", vc.VulnCheck)
+	}
+}
