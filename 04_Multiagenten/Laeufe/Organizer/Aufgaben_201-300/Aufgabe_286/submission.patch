diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..382deaf
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,63 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running version and, when checked, the latest release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+var prereleaseIdentifier = regexp.MustCompile(`(?:^|[-.])(?:dev|snapshot|rc\d*)(?:[-.]|$)`)
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" {
+		return false
+	}
+	version = strings.ToLower(strings.SplitN(version, "+", 2)[0])
+	return !prereleaseIdentifier.MatchString(version)
+}
+
+// Check compares version with the latest published release.
+func Check(ctx context.Context, version string) (Info, error) {
+	info, err := check(ctx, version, github.NewClient(nil))
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func check(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+
+	latestVersion, err := semver.ParseTolerant(latest.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latestVersion.String()
+	info.LatestVersionURL = latest.GetHTMLURL()
+	info.UpdateAvailable = current.LT(latestVersion)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..efeab8d
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,83 @@
+package release
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"1.2.3-dev", false},
+		{"1.2.3-dev.4", false},
+		{"1.2.3-snapshot", false},
+		{"1.2.3-rc", false},
+		{"1.2.3-rc.2", false},
+		{"1.2.3-rc2", false},
+		{"v1.2.3", true},
+		{"1.2.3+build.4", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			if got := Is(tt.version); got != tt.want {
+				t.Errorf("Is(%q) = %t, want %t", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCheckReleaseInfo(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"tag_name":"v1.3.0","html_url":"https://example.com/releases/v1.3.0"}`))
+	}))
+	defer server.Close()
+
+	client := github.NewClient(server.Client())
+	baseURL, err := url.Parse(server.URL + "/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.BaseURL = baseURL
+
+	for _, tt := range []struct {
+		version string
+		update  bool
+	}{
+		{"1.2.0", true},
+		{"1.3.0", false},
+		{"1.4.0", false},
+	} {
+		t.Run(tt.version, func(t *testing.T) {
+			info, err := check(context.Background(), tt.version, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if info.CurrentVersion != tt.version || info.LatestVersion != "1.3.0" || info.LatestVersionURL != "https://example.com/releases/v1.3.0" || info.UpdateAvailable != tt.update {
+				t.Errorf("unexpected release info: %+v", info)
+			}
+		})
+	}
+}
+
+func TestCheckInvalidVersion(t *testing.T) {
+	info, err := Check(context.Background(), "invalid")
+	if err == nil {
+		t.Fatal("expected version parse error")
+	}
+	if info.CurrentVersion != "invalid" || info.UpdateAvailable {
+		t.Errorf("unexpected release info: %+v", info)
+	}
+}
