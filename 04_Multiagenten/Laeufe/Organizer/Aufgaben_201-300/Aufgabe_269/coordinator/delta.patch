diff --git a/models/trivycontents.go b/models/trivycontents.go
new file mode 100644
index 0000000..08b68f7
--- /dev/null
+++ b/models/trivycontents.go
@@ -0,0 +1,58 @@
+package models
+
+import (
+	"sort"
+	"time"
+
+	trivytypes "github.com/aquasecurity/trivy-db/pkg/types"
+)
+
+// TrivyCveContents keeps each vendor's severity and CVSS values under its own source.
+func TrivyCveContents(cveID string, vul trivytypes.Vulnerability) CveContents {
+	contents := CveContents{}
+	refs := make(References, 0, len(vul.References))
+	for _, url := range vul.References {
+		refs = append(refs, Reference{Source: "trivy", Link: url})
+	}
+	sort.Slice(refs, func(i, j int) bool { return refs[i].Link < refs[j].Link })
+
+	var published, modified time.Time
+	if vul.PublishedDate != nil {
+		published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		modified = *vul.LastModifiedDate
+	}
+
+	sources := map[trivytypes.SourceID]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[source] = struct{}{}
+	}
+	if len(sources) == 0 {
+		sources[""] = struct{}{}
+	}
+	for source := range sources {
+		ctype := Trivy
+		if source != "" {
+			ctype = CveContentType("trivy:" + string(source))
+		}
+		severity := ""
+		if s, ok := vul.VendorSeverity[source]; ok {
+			severity = s.String()
+		} else if len(vul.VendorSeverity) == 0 {
+			severity = vul.Severity
+		}
+		cvss := vul.CVSS[source]
+		contents[ctype] = []CveContent{{
+			Type: ctype, CveID: cveID, Title: vul.Title, Summary: vul.Description,
+			Cvss2Score: cvss.V2Score, Cvss2Vector: cvss.V2Vector,
+			Cvss3Score: cvss.V3Score, Cvss3Vector: cvss.V3Vector,
+			Cvss3Severity: severity, References: refs,
+			Published: published, LastModified: modified,
+		}}
+	}
+	return contents
+}
diff --git a/models/trivycontents_test.go b/models/trivycontents_test.go
new file mode 100644
index 0000000..b412a72
--- /dev/null
+++ b/models/trivycontents_test.go
@@ -0,0 +1,40 @@
+package models
+
+import (
+	"testing"
+	"time"
+
+	trivytypes "github.com/aquasecurity/trivy-db/pkg/types"
+)
+
+func TestTrivyCveContentsBySource(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	contents := TrivyCveContents("CVE-2024-1234", trivytypes.Vulnerability{
+		Title: "title", Description: "summary", Severity: "HIGH",
+		VendorSeverity: trivytypes.VendorSeverity{"debian": trivytypes.SeverityLow, "ubuntu": trivytypes.SeverityMedium},
+		CVSS: trivytypes.VendorCVSS{
+			"debian": {V2Score: 3.1, V2Vector: "AV:N", V3Score: 4.2, V3Vector: "CVSS:3.1/AV:N"},
+			"nvd":    {V3Score: 9.8, V3Vector: "CVSS:3.1/AV:A"},
+		},
+		References:    []string{"https://example.test/reference"},
+		PublishedDate: &published, LastModifiedDate: &modified,
+	})
+	if len(contents) != 3 {
+		t.Fatalf("got %d sources, want 3", len(contents))
+	}
+	debian := contents[TrivyDebian][0]
+	if debian.Type != TrivyDebian || debian.CveID != "CVE-2024-1234" || debian.Title != "title" || debian.Summary != "summary" || debian.Cvss3Severity != "LOW" || debian.Cvss2Score != 3.1 || debian.Cvss2Vector != "AV:N" || debian.Cvss3Score != 4.2 || debian.Cvss3Vector != "CVSS:3.1/AV:N" || len(debian.References) != 1 || !debian.Published.Equal(published) || !debian.LastModified.Equal(modified) {
+		t.Fatalf("Debian content lost metadata: %+v", debian)
+	}
+	if contents[TrivyUbuntu][0].Cvss3Severity != "MEDIUM" {
+		t.Fatalf("Ubuntu severity: %+v", contents[TrivyUbuntu])
+	}
+	if contents[TrivyNVD][0].Cvss3Score != 9.8 {
+		t.Fatalf("NVD score: %+v", contents[TrivyNVD])
+	}
+	v := VulnInfo{CveContents: contents}
+	if len(v.Titles("en", "debian")) < 3 || len(v.Summaries("en", "debian")) < 3 || len(v.Cvss2Scores()) != 1 || len(v.Cvss3Scores()) != 3 {
+		t.Fatalf("Trivy content missing from aggregation: titles=%v summaries=%v cvss2=%v cvss3=%v", v.Titles("en", "debian"), v.Summaries("en", "debian"), v.Cvss2Scores(), v.Cvss3Scores())
+	}
+}
