@@ -0,0 +1,37 @@
+package pkg
+
+import (
+	"testing"
+
+	trivydbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesSourcesAcrossTargets(t *testing.T) {
+	results := types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{{
+			VulnerabilityID: "CVE-2024-1234", PkgName: "a",
+			Vulnerability: trivydbtypes.Vulnerability{
+				VendorSeverity: trivydbtypes.VendorSeverity{"debian": trivydbtypes.SeverityLow},
+			},
+		}}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{{
+			VulnerabilityID: "CVE-2024-1234", PkgName: "b",
+			Vulnerability: trivydbtypes.Vulnerability{
+				VendorSeverity: trivydbtypes.VendorSeverity{"ubuntu": trivydbtypes.SeverityMedium},
+				CVSS:           trivydbtypes.VendorCVSS{"nvd": {V3Score: 9.8}},
+			},
+		}}},
+	}
+	scan, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := scan.ScannedCves["CVE-2024-1234"].CveContents
+	if len(contents) != 3 || contents[models.TrivyDebian][0].Cvss3Severity != "LOW" || contents[models.TrivyUbuntu][0].Cvss3Severity != "MEDIUM" || contents[models.TrivyNVD][0].Cvss3Score != 9.8 {
+		t.Fatalf("source content lost across targets: %+v", contents)
+	}
+}
