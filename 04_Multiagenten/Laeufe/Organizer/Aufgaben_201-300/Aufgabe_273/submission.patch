 """py.test tests for addbook"""
+import pytest
 import web
 from .. import addbook
 from openlibrary import accounts
@@ -21,6 +22,45 @@ def mock_user():
     )()
 
 
+@pytest.mark.parametrize(
+    'author_fields',
+    [{}, {'author_key': ['OL1A']}, {'author_name': ['An Author']}],
+)
+def test_make_work_without_author_pairs(author_fields):
+    doc = {'title': 'A Work', **author_fields}
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert work.authors == []
+    assert work.title == 'A Work'
+    assert all(work[field] == value for field, value in author_fields.items())
+    assert work.cover_url == '/images/icons/avatar_book-sm.png'
+    assert work.ia == []
+    assert work.first_publish_year is None
+
+
+def test_make_work_with_authors_and_optional_metadata():
+    web.ctx.site = MockSite()
+    doc = {
+        'title': 'A Work',
+        'author_key': ['OL1A'],
+        'author_name': ['An Author'],
+        'cover_url': '/covers/123.jpg',
+        'ia': ['archive-id'],
+        'first_publish_year': 2000,
+    }
+
+    work = addbook.make_work(doc)
+
+    assert work.authors[0].key == '/authors/OL1A'
+    assert work.authors[0].name == 'An Author'
+    assert work.authors[0].type.key == '/type/author'
+    assert work.cover_url == '/covers/123.jpg'
+    assert work.ia == ['archive-id']
+    assert work.first_publish_year == 2000
+
+
 class TestSaveBookHelper:
