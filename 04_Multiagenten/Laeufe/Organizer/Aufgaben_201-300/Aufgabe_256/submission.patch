+        for hosts, expected in cases:
+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load({'hosts': hosts, 'name': 'explicit name'})
+            self.assertIn(expected, str(error.exception))
+
+    def test_hosts_accept_binary_values(self):
