+    def test_hosts_derive_name_without_changing_input(self):
+        play_data = {'hosts': ['first', 'second']}
+        p = Play.load(play_data)
+        self.assertEqual(play_data, {'hosts': ['first', 'second']})
+        self.assertEqual(p.get_name(), 'first,second')
+        p.hosts = ['third']
+        self.assertEqual(p.get_name(), 'third')
+        p.hosts = ('fourth', 'fifth')
+        self.assertEqual(p.get_name(), 'fourth,fifth')
+        p.name = 'explicit name'
+        self.assertEqual(p.get_name(), 'explicit name')
+
+    def test_hosts_name_for_string_and_missing_hosts(self):
+        self.assertEqual(Play.load({'hosts': 'all'}).get_name(), 'all')
