diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..7d0e7e2
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,63 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	exited := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		close(started)
+		<-ctx.Done()
+		<-release
+		close(exited)
+		return false, ctx.Err()
+	}, WithInterval(time.Millisecond))
+	p.Start()
+
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("update did not start")
+	}
+
+	closed := make(chan struct{})
+	go func() {
+		_ = p.Close()
+		close(closed)
+	}()
+	select {
+	case <-closed:
+		t.Fatal("Close returned before update exited")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not return")
+	}
+	select {
+	case <-exited:
+	default:
+		t.Fatal("update still running after Close")
+	}
+	require.NoError(t, p.Close())
+}
+
+func TestPollerCloseWithoutStart(t *testing.T) {
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		t.Fatal("update called after Close")
+		return false, nil
+	})
+	require.NoError(t, p.Close())
+	p.Start()
+	p.Poll()
+}
