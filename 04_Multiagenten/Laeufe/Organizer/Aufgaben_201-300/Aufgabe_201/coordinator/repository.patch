@@ -1,5 +1,7 @@
 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,157 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment is implemented by both supported rule segment representations.
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct {
+	IsSegment IsSegment
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil {
+		return nil, fmt.Errorf("rule requires a segment")
+	}
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, fmt.Errorf("segment key must not be empty")
+		}
+		return string(v), nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, err
+		}
+		if len(v.Keys) == 1 {
+			v.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		return v, nil
+	default:
+		return nil, fmt.Errorf("invalid segment format %T", s.IsSegment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		if v == "" {
+			return fmt.Errorf("segment key must not be empty")
+		}
+		s.IsSegment = SegmentKey(v)
+	case map[interface{}]interface{}:
+		group, err := parseSegmentMap(v)
+		if err != nil {
+			return err
+		}
+		s.IsSegment = group
+	case map[string]interface{}:
+		fields := make(map[interface{}]interface{}, len(v))
+		for key, value := range v {
+			fields[key] = value
+		}
+		group, err := parseSegmentMap(fields)
+		if err != nil {
+			return err
+		}
+		s.IsSegment = group
+	default:
+		return fmt.Errorf("invalid segment format %T", raw)
+	}
+	return nil
+}
+
+func parseSegmentMap(fields map[interface{}]interface{}) (Segments, error) {
+	var group Segments
+	for key, value := range fields {
+		switch key {
+		case "keys":
+			items, ok := value.([]interface{})
+			if !ok {
+				return group, fmt.Errorf("segment keys must be a list")
+			}
+			for _, item := range items {
+				str, ok := item.(string)
+				if !ok {
+					return group, fmt.Errorf("segment keys must be strings")
+				}
+				group.Keys = append(group.Keys, str)
+			}
+		case "operator":
+			str, ok := value.(string)
+			if !ok {
+				return group, fmt.Errorf("segment operator must be a string")
+			}
+			group.SegmentOperator = str
+		default:
+			return group, fmt.Errorf("invalid segment field %v", key)
+		}
+	}
+	if err := validateSegments(group); err != nil {
+		return group, err
+	}
+	if len(group.Keys) == 1 {
+		group.SegmentOperator = "OR_SEGMENT_OPERATOR"
+	}
+	return group, nil
+}
+
+func validateSegments(s Segments) error {
+	if len(s.Keys) == 0 {
+		return fmt.Errorf("segment keys must not be empty")
+	}
+	for _, key := range s.Keys {
+		if key == "" {
+			return fmt.Errorf("segment keys must not be empty")
+		}
+	}
+	if len(s.Keys) > 1 && s.SegmentOperator != "OR_SEGMENT_OPERATOR" && s.SegmentOperator != "AND_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid segment operator %q", s.SegmentOperator)
+	}
+	return nil
+}
+
+// RuleSegment resolves the YAML representation to the RPC fields.
+func RuleSegment(s *SegmentEmbed) (string, []string, string, error) {
+	if s == nil {
+		return "", nil, "", fmt.Errorf("rule requires a segment")
+	}
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return "", nil, "", fmt.Errorf("segment key must not be empty")
+		}
+		return string(v), nil, "OR_SEGMENT_OPERATOR", nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return "", nil, "", err
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys[0], nil, "OR_SEGMENT_OPERATOR", nil
+		}
+		return "", v.Keys, v.SegmentOperator, nil
+	default:
+		return "", nil, "", fmt.Errorf("rule requires a segment")
+	}
 }
 
