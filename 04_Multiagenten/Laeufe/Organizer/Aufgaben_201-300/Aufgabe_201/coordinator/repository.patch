--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,70 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	yamlv2 "gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestRuleSegmentFormats(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		input    string
+		key      string
+		keys     []string
+		operator string
+	}{
+		{"string", "segment: foo\n", "foo", nil, "OR_SEGMENT_OPERATOR"},
+		{"object", "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n", "", []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR"},
+		{"single object", "segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR\n", "foo", nil, "OR_SEGMENT_OPERATOR"},
+		{"single object invalid operator", "segment:\n  keys: [foo]\n  operator: ignored\n", "foo", nil, "OR_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, decode := range []func([]byte, interface{}) error{yamlv2.Unmarshal, yamlv3.Unmarshal} {
+				var rule Rule
+				require.NoError(t, decode([]byte(tc.input), &rule))
+				key, keys, operator, err := RuleSegment(rule.Segment)
+				require.NoError(t, err)
+				require.Equal(t, tc.key, key)
+				require.Equal(t, tc.keys, keys)
+				require.Equal(t, tc.operator, operator)
+			}
+		})
+	}
+}
+
+func TestRuleSegmentInvalid(t *testing.T) {
+	for _, input := range []string{
+		"segment: []\n",
+		"segment: 42\n",
+		"segment: ''\n",
+		"segment:\n  keys: []\n  operator: AND_SEGMENT_OPERATOR\n",
+		"segment:\n  keys: [foo, bar]\n",
+		"segment:\n  keys: [foo, bar]\n  operator: INVALID\n",
+		"segment:\n  keys: [foo]\n  extra: value\n",
+	} {
+		for _, decode := range []func([]byte, interface{}) error{yamlv2.Unmarshal, yamlv3.Unmarshal} {
+			var rule Rule
+			require.Error(t, decode([]byte(input), &rule), input)
+		}
+	}
+	_, _, _, err := RuleSegment(Rule{}.Segment)
+	require.Error(t, err)
+}
+
+func TestRuleSegmentMarshal(t *testing.T) {
+	for _, segment := range []*SegmentEmbed{
+		{IsSegment: SegmentKey("foo")},
+		{IsSegment: Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}},
+	} {
+		for _, marshal := range []func(interface{}) ([]byte, error){yamlv2.Marshal, yamlv3.Marshal} {
+			data, err := marshal(&Rule{Segment: segment})
+			require.NoError(t, err)
+			var rule Rule
+			require.NoError(t, yamlv2.Unmarshal(data, &rule))
+			require.Equal(t, segment.IsSegment, rule.Segment.IsSegment)
+		}
+	}
+}
