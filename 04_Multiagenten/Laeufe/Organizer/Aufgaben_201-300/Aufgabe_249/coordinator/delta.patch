diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index cbf68a2..40c30e5 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -75,3 +75,76 @@ def test_get_wikidata_entity(
             mock_get_from_cache.assert_called_once()
         else:
             mock_get_from_cache.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    'language, expected',
+    [
+        ('fr', ('https://fr.wikipedia.org/wiki/Douglas_Adams', 'fr')),
+        ('de', ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en')),
+        ('en', ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en')),
+    ],
+)
+def test_get_wikipedia_link(language, expected):
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'},
+        'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+    }
+    assert entity._get_wikipedia_link(language) == expected
+    entity.sitelinks.pop('enwiki')
+    assert entity._get_wikipedia_link('de') is None
+
+
+def test_get_statement_values_ignores_malformed_entries():
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'first'}},
+            {'value': {'content': 'second'}},
+            {'value': {}},
+            {},
+            {'value': None},
+            None,
+        ]
+    }
+    assert entity._get_statement_values('P1960') == ['first', 'second']
+    assert entity._get_statement_values('P123') == []
+    entity.statements['P1960'] = {'value': {'content': 'single'}}
+    assert entity._get_statement_values('P1960') == ['single']
+
+
+def test_get_external_profiles():
+    entity = createWikidataEntity()
+    entity.sitelinks = {'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'}}
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'scholar-one'}},
+            {'value': {'content': 'scholar-two'}},
+            {'value': {}},
+        ]
+    }
+    assert entity.get_external_profiles('fr') == [
+        {
+            'url': 'https://en.wikipedia.org/wiki/Douglas_Adams',
+            'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+            'label': 'Wikipedia',
+        },
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=scholar-one',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=scholar-two',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+    ]
+    entity.sitelinks = {}
+    assert entity.get_external_profiles()[0]['label'] == 'Wikidata'
