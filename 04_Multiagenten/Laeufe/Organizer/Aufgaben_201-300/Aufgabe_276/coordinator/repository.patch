+func TestLoadAuthenticationProviderValidation(t *testing.T) {
+	tests := []struct {
+		name, method, wantErr string
+	}{
+		{"github client_id", "github:\n      enabled: true\n      client_secret: secret\n      redirect_address: https://example.com/callback", `provider "github": field "client_id": non-empty value is required`},
+		{"github client_secret", "github:\n      enabled: true\n      client_id: id\n      redirect_address: https://example.com/callback", `provider "github": field "client_secret": non-empty value is required`},
+		{"github redirect_address", "github:\n      enabled: true\n      client_id: id\n      client_secret: secret", `provider "github": field "redirect_address": non-empty value is required`},
+		{"github whitespace", "github:\n      enabled: true\n      client_id: '  '\n      client_secret: secret\n      redirect_address: https://example.com/callback", `provider "github": field "client_id": non-empty value is required`},
+		{"github scopes", "github:\n      enabled: true\n      client_id: id\n      client_secret: secret\n      redirect_address: https://example.com/callback\n      allowed_organizations: [flipt]", `provider "github": field "scopes": must contain read:org when allowed_organizations is not empty`},
+		{"oidc client_id", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_secret: secret\n          redirect_address: https://example.com/callback", `provider "foo": field "client_id": non-empty value is required`},
+		{"oidc client_secret", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          redirect_address: https://example.com/callback", `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc redirect_address", "oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          client_secret: secret", `provider "foo": field "redirect_address": non-empty value is required`},
+		{"oidc second provider", "oidc:\n      enabled: true\n      providers:\n        valid:\n          client_id: id\n          client_secret: secret\n          redirect_address: https://example.com/callback\n        foo:\n          client_id: id\n          client_secret: secret", `provider "foo": field "redirect_address": non-empty value is required`},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "flipt.yml")
+			contents := "authentication:\n  session:\n    domain: example.com\n  methods:\n    " + tt.method + "\n"
+			require.NoError(t, os.WriteFile(path, []byte(contents), 0600))
+			_, err := Load(path)
+			require.EqualError(t, err, tt.wantErr)
+		})
+	}
+}
