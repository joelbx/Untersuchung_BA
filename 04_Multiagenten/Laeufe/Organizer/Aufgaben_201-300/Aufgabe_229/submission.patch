+	function localProfilePath(url, uid, type) {
+		const prefix = '/assets/uploads/profile/';
+		const relativePath = nconf.get('relative_path') || '';
+		const localUrl = typeof url === 'string' && url.startsWith(`${relativePath}${prefix}`) ? url.slice(relativePath.length) : url;
