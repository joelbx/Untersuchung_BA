diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..3909fb9
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,36 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	scanner := filepath.Join(t.TempDir(), "nmap")
+	script := "#!/bin/sh\nprintf 'Host: 127.0.0.1 () Ports: 80/open/tcp//http///, 443/closed/tcp//https///\\n'\n"
+	if err := os.WriteFile(scanner, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{Port: "local", Host: "127.0.0.1", PortScan: &config.PortScanConf{ScannerBinPath: scanner, IsUseExternalScanner: true, ScanTechniques: []string{"sT"}}}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {"80", "443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"127.0.0.1:80"}) {
+		t.Fatalf("open ports: %v", got)
+	}
+}
+
+func TestSetScanTechniques(t *testing.T) {
+	got, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{"sX"}})
+	if err != nil || !reflect.DeepEqual(got, []string{"-sX"}) {
+		t.Fatalf("options: %v, %v", got, err)
+	}
+	if _, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{"unknown"}}); err == nil {
+		t.Fatal("unsupported technique accepted")
+	}
+}
