+// setScanTechniques converts validated configuration codes into nmap flags.
+func setScanTechniques(c config.PortScanConf) ([]string, error) {
+	options := []string{}
+	for i, t := range c.GetScanTechniques() {
+		if t == config.NotSupportTechnique {
+			return nil, xerrors.Errorf("unsupported scan technique: %q", c.ScanTechniques[i])
+		}
+		options = append(options, "-"+t.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	c := l.ServerInfo.PortScan
+	if errs := c.Validate(); len(errs) != 0 {
+		return nil, xerrors.Errorf("invalid portscan config: %v", errs)
+	}
+	options, err := setScanTechniques(*c)
+	if err != nil {
+		return nil, err
+	}
+	if len(options) == 0 {
+		if c.HasPrivileged {
+			options = append(options, "-sS")
+		} else {
+			options = append(options, "-sT")
+		}
+	}
+	if c.SourcePort != "" {
+		options = append(options, "-g", c.SourcePort)
+	}
+	options = append(options, "-Pn", "-n", "-oG", "-")
+	listen := []string{}
+	ips := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := scanDestIPPorts[ip]
+		if len(ports) == 0 {
+			continue
+		}
+		args := append(append([]string{}, options...), "-p", strings.Join(ports, ","), ip)
+		output, err := osexec.Command(c.ScannerBinPath, args...).CombinedOutput()
+		if err != nil {
+			return nil, xerrors.Errorf("nmap scan %s failed: %w: %s", ip, err, strings.TrimSpace(string(output)))
+		}
+		for _, line := range strings.Split(string(output), "\n") {
+			if !strings.HasPrefix(line, "Host: ") || !strings.Contains(line, "Ports: ") {
+				continue
+			}
+			fields := strings.SplitN(line, "Ports: ", 2)
+			for _, entry := range strings.Split(fields[1], ",") {
+				parts := strings.Split(strings.TrimSpace(entry), "/")
+				if len(parts) >= 3 && parts[1] == "open" && parts[2] == "tcp" {
+					listen = append(listen, ip+":"+parts[0])
+				}
+			}
+		}
+	}
+	return listen, nil
+}
