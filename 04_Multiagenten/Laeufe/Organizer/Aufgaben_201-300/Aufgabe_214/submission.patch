diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..14b3937
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,113 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan type.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+var techniqueCodes = map[ScanTechnique]string{
+	TCPSYN: "sS", TCPConnect: "sT", TCPACK: "sA", TCPWindow: "sW",
+	TCPMaimon: "sM", TCPNull: "sN", TCPFIN: "sF", TCPXmas: "sX",
+}
+
+func (t ScanTechnique) String() string { return techniqueCodes[t] }
+
+// PortScanConf configures the scanner running on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	for _, code := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for technique, canonical := range techniqueCodes {
+			if strings.EqualFold(code, canonical) {
+				found = technique
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, found)
+	}
+	return
+}
+
+// Validate reports all invalid external scanner settings.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath: %w", err))
+	} else if info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is not executable: %s", c.ScannerBinPath))
+	}
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan multiple scan techniques are not supported"))
+	}
+	techniques := c.GetScanTechniques()
+	for i, t := range techniques {
+		if t == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan unsupported scan technique: %q", c.ScanTechniques[i]))
+		}
+	}
+	// nmap defaults to a privileged SYN scan or an unprivileged connect scan.
+	if !c.HasPrivileged {
+		for _, t := range techniques {
+			if t != NotSupportTechnique && t != TCPConnect {
+				errs = append(errs, fmt.Errorf("portscan %s requires privileges", t))
+			}
+		}
+	} else if os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		out, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan capability check failed: %v: %s", err, strings.TrimSpace(string(out))))
+		} else if !strings.Contains(string(out), "cap_net_raw") || !strings.Contains(string(out), "=ep") && !strings.Contains(string(out), "+ep") {
+			errs = append(errs, fmt.Errorf("portscan scannerBinPath lacks usable cap_net_raw capability: %s", strings.TrimSpace(string(out))))
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort must be an integer in [0,65535]: %q", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort 0 is not usable"))
+		}
+		if len(techniques) == 0 && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan sourcePort cannot be used with default TCPConnect scan"))
+		}
+		for _, t := range techniques {
+			if t == TCPConnect {
+				errs = append(errs, fmt.Errorf("portscan sourcePort cannot be used with TCPConnect"))
+			}
+		}
+	}
+	return
+}
