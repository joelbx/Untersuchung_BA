@@ -0,0 +1,88 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	codes := []string{"SS", "st", "Sa", "sw", "Sm", "sn", "sf", "sx", "invalid"}
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas, NotSupportTechnique}
+	c := PortScanConf{ScanTechniques: codes}
+	got := c.GetScanTechniques()
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("%q: got %v, want %v", codes[i], got[i], want[i])
+		}
+	}
+	if len((&PortScanConf{}).GetScanTechniques()) != 0 {
+		t.Fatal("empty techniques should stay empty")
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad"}}).GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Fatalf("unsupported: %v", got)
+	}
+}
+
+func TestPortScanValidate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "scanner")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name  string
+		c     PortScanConf
+		valid bool
+	}{
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, true},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, false},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"bad"}}, false},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sT"}}, false},
+		{"privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, false},
+		{"source connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, false},
+		{"source range", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "65536"}, false},
+		{"source zero", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "0"}, false},
+	}
+	for _, tt := range cases {
+		t.Run(tt.name, func(t *testing.T) {
+			if valid := len(tt.c.Validate()) == 0; valid != tt.valid {
+				t.Errorf("valid=%v, errors=%v", valid, tt.c.Validate())
+			}
+		})
+	}
+	if !(&PortScanConf{}).IsZero() {
+		t.Fatal("empty config")
+	}
+	for _, c := range []PortScanConf{{ScannerBinPath: path}, {ScanTechniques: []string{"sT"}}, {SourcePort: "1"}, {HasPrivileged: true}} {
+		if c.IsZero() {
+			t.Fatalf("nonempty config: %+v", c)
+		}
+	}
+}
+
+func TestPortScanTOMLLoad(t *testing.T) {
+	old := Conf
+	defer func() { Conf = old }()
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	contents := `[servers.sample]
+host = "127.0.0.1"
+port = "local"
+scanModules = ["ospkg", "port"]
+[servers.sample.portscan]
+scannerBinPath = "/usr/bin/nmap"
+hasPrivileged = true
+scanTechniques = ["sS"]
+sourcePort = "443"
+`
+	if err := os.WriteFile(path, []byte(contents), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	c := Conf.Servers["sample"].PortScan
+	if c == nil || !c.IsUseExternalScanner || c.ScannerBinPath != "/usr/bin/nmap" || c.SourcePort != "443" || !c.HasPrivileged || len(c.ScanTechniques) != 1 || c.ScanTechniques[0] != "sS" {
+		t.Fatalf("loaded config: %+v", c)
+	}
+}
