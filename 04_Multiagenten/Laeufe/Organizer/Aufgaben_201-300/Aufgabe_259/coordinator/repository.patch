+    @pytest.mark.asyncio
+    async def test_public_edition_preferred_over_lending_and_printdisabled(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w, key='/books/OL1M', ocaid='loan',
+                    _ia_meta={'collection': ['lendinglibrary', 'americana']},
+                ),
+                make_edition(
+                    w, key='/books/OL2M', ocaid='disabled1',
+                    _ia_meta={'collection': ['printdisabled', 'americana']},
+                ),
+                make_edition(
+                    w, key='/books/OL3M', ocaid='disabled2',
+                    _ia_meta={'collection': ['printdisabled', 'inlibrary']},
+                ),
+                make_edition(
+                    w, key='/books/OL4M', ocaid='public',
+                    _ia_meta={'collection': ['internetarchivebooks']},
+                ),
+            ]
+        )
