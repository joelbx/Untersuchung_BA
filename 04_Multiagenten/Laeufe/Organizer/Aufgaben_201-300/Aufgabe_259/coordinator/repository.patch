+        assert d['lending_identifier_s'] == 'public'
+        assert sss(d['printdisabled_s']) == ['OL2M', 'OL3M']
+        assert set(d['ia']) == {'loan', 'disabled1', 'disabled2', 'public'}
+        assert set(d['ia_collection_s'].split(';')) == {
+            'lendinglibrary', 'americana', 'printdisabled', 'inlibrary',
+            'internetarchivebooks',
+        }
+
