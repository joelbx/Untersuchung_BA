+def test_filesystem_completion(qtmodeltester, config_stub, quickmark_manager_stub,
+                               bookmark_manager_stub, info, tmp_path,
+                               monkeypatch):
+    """Filesystem paths respect category order and input representation."""
+    root = tmp_path / 'files'
+    root.mkdir()
+    (root / 'b.html').touch()
+    (root / 'a page.html').touch()
+    (root / 'directory').mkdir()
+    monkeypatch.setenv('HOME', str(tmp_path))
+    config_stub.val.completion.open_categories = ['filesystem']
+    config_stub.val.completion.favorite_paths = ['~/files', '/other/path']
+    model = urlmodel.url(info=info)
+    qtmodeltester.check(model)
+
+    model.set_pattern('')
+    _check_completions(model, {'Filesystem': [
+        ('~/files', None, None), ('/other/path', None, None)]})
+
+    names = ['a page.html', 'b.html', 'directory']
+    model.set_pattern(str(root) + '/')
+    _check_completions(model, {'Filesystem': [
+        (str(root / name), None, None) for name in names]})
+
+    model.set_pattern(root.as_uri() + '/')
+    _check_completions(model, {'Filesystem': [
+        ((root / name).as_uri(), None, None) for name in names]})
+
+    model.set_pattern('~/files/')
+    _check_completions(model, {'Filesystem': [
+        ('~/files/' + name, None, None) for name in names]})
+
+    for pattern in ('relative/path', 'https://example.com', 'file://host/path',
+                    str(root / 'missing') + '/', '/missing\0path'):
+        model.set_pattern(pattern)
+        _check_completions(model, {'Filesystem': []})
+
+
+def test_filesystem_category_order(config_stub, quickmark_manager_stub,
+                                   bookmark_manager_stub, info):
+    config_stub.val.url.searchengines = {
+        'DEFAULT': 'https://duckduckgo.com/?q={}',
+        'google': 'https://google.com/?q={}',
+    }
+    config_stub.val.completion.open_categories = ['filesystem', 'searchengines']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    assert [model.data(model.index(row, 0)) for row in range(model.rowCount())] == [
+        'Filesystem', 'Search engines']
+
+    config_stub.val.completion.open_categories = ['searchengines']
+    model = urlmodel.url(info=info)
+    assert [model.data(model.index(row, 0)) for row in range(model.rowCount())] == [
+        'Search engines']
+
+
