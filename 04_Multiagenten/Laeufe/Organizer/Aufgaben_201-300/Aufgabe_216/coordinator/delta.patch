+@pytest.mark.parametrize('check_status,expected_calls', [(1, 1), (0, 2)])
+def test_ssh_reset_checks_active_socket(tmp_path, check_status, expected_calls):
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.set_options(direct={'ssh_args': '-o ControlMaster=auto -o ControlPersist=60s',
+                             'control_path': '%(directory)s/test-socket',
+                             'control_path_dir': str(tmp_path),
+                             'ssh_executable': '/custom/ssh'})
+    process = MagicMock()
+    process.wait.side_effect = [check_status, 0]
+    process.communicate.return_value = (b"", b"")
+    with patch('ansible.plugins.connection.ssh.subprocess.Popen', return_value=process) as popen:
+        conn.reset()
+
+    assert popen.call_count == expected_calls
+    first = popen.call_args_list[0][0][0]
+    assert first[0] == b'/custom/ssh'
+    assert first[-3:] == [b'-O', b'check', to_bytes(conn.host)]
+    assert b'ControlPath=' + to_bytes(str(tmp_path / 'test-socket')) in first
+    if expected_calls == 2:
+        second = popen.call_args_list[1][0][0]
+        assert second[-3:] == [b'-O', b'stop', to_bytes(conn.host)]
+        assert b'ControlPath=' + to_bytes(str(tmp_path / 'test-socket')) in second
+
