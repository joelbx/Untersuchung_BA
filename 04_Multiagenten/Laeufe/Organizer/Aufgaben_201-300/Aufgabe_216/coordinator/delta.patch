+def test_ssh_option_precedence_and_cli_args(tmp_path, monkeypatch):
+    config = tmp_path / 'ansible.cfg'
+    config.write_text('[ssh_connection]\nssh_common_args = -o FromConfig=yes\n'
+                      'transfer_method = scp\nretries = 4\n'
+                      'remote_user = config-user\nprivate_key_file = /config/key\n'
+                      'timeout = 29\n')
+    monkeypatch.setattr(C.config, '_config_file', str(config))
+    monkeypatch.setenv('ANSIBLE_SSH_COMMON_ARGS', '-o FromEnv=yes')
+
+    pc = PlayContext()
+    pc.ssh_common_args = '-o FromCli=yes'
+    pc.remote_user = 'cli-user'
+    pc.private_key_file = '/cli/key'
+    conn = connection_loader.get('ssh', pc, StringIO())
+    conn.set_options(task_keys={'remote_user': None, 'private_key_file': None,
+                                'timeout': C.DEFAULT_TIMEOUT}, var_options={})
+    assert conn.get_option('ssh_common_args') == '-o FromCli=yes'
+    assert conn.get_option('remote_user') == 'cli-user'
+    assert conn.get_option('private_key_file') == '/cli/key'
+    assert conn.get_option('timeout') == 29
+    assert conn.get_option('transfer_method') == 'scp'
+    assert conn.get_option('retries') == 4
+
+    conn.set_options(task_keys={}, var_options={'ansible_ssh_common_args': '-o FromInventory=yes'})
+    assert conn.get_option('ssh_common_args') == '-o FromInventory=yes'
+
+    pc.ssh_common_args = None
+    pc.remote_user = C.DEFAULT_REMOTE_USER
+    pc.private_key_file = C.DEFAULT_PRIVATE_KEY_FILE
+    conn.set_options(task_keys={}, var_options={})
+    assert conn.get_option('ssh_common_args') == '-o FromEnv=yes'
+    assert conn.get_option('remote_user') == 'config-user'
+    assert conn.get_option('private_key_file') == '/config/key'
+    monkeypatch.delenv('ANSIBLE_SSH_COMMON_ARGS')
+    conn.set_options(task_keys={}, var_options={})
+    assert conn.get_option('ssh_common_args') == '-o FromConfig=yes'
+
+
+def test_ssh_command_uses_resolved_options(tmp_path):
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.host = 'example.org'
+    conn.set_options(direct={'ssh_args': '-o ControlMaster=auto -o ControlPersist=60s',
+                             'ssh_common_args': '-o Common=yes',
+                             'ssh_extra_args': '-o Extra=yes',
+                             'remote_user': 'configured-user',
+                             'private_key_file': '/configured/key',
+                             'timeout': 23,
+                             'control_path': '%(directory)s/socket',
+                             'control_path_dir': str(tmp_path)})
+    command = conn._build_command('ssh', 'ssh', 'example.org')
+    assert b'Common=yes' in command
+    assert b'Extra=yes' in command
+    assert b'User="configured-user"' in command
+    assert b'IdentityFile="/configured/key"' in command
+    assert b'ConnectTimeout=23' in command
+    assert b'ControlPath=' + to_bytes(str(tmp_path / 'socket')) in command
+
+
+def test_ssh_transfer_method_overrides_legacy_selection():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.host = 'example.org'
+    conn.set_options(direct={'transfer_method': 'scp', 'scp_if_ssh': False})
+    conn._build_command = MagicMock(return_value='scp command')
+    conn._bare_run = MagicMock(return_value=(0, b'', b''))
+    conn._file_transport_command('/source', '/dest', 'put')
+    assert conn._build_command.call_args[0][1] == 'scp'
+    conn._bare_run.assert_called_once_with('scp command', None, checkrc=False)
+
