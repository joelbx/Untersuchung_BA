@@ -6,10 +6,81 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	tests := []struct {
+		name       string
+		fields     string
+		summary    string
+		fixedIn    string
+		optional   map[string]string
+		cvssScore  float64
+		cvssVector string
+		cvssLevel  string
+	}{
+		{
+			name:    "enterprise",
+			fields:  `"description":"A detailed summary","fixed_in":"6.4.2","poc":"https://example.com/poc","introduced_in":"6.0","cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N/AC:L","severity":"HIGH"}`,
+			summary: "A detailed summary", fixedIn: "6.4.2",
+			optional:  map[string]string{"poc": "https://example.com/poc", "introduced_in": "6.0"},
+			cvssScore: 7.5, cvssVector: "CVSS:3.1/AV:N/AC:L", cvssLevel: "HIGH",
+		},
+		{
+			name:     "absent",
+			optional: map[string]string{},
+		},
+		{
+			name:     "null",
+			fields:   `"description":null,"fixed_in":null,"poc":null,"introduced_in":null,"cvss":null`,
+			optional: map[string]string{},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"63":{"vulnerabilities":[{"id":"42","title":"Issue","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-03:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.com/first","https://example.com/second"]}`
+			if tt.fields != "" {
+				body += `,` + tt.fields
+			}
+			body += `}]}}`
+
+			got, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got) != 1 {
+				t.Fatalf("want one vulnerability, got %d", len(got))
+			}
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 7, 5, 6, 0, time.UTC)
+			want := models.VulnInfo{
+				CveID: "CVE-2024-1234",
+				CveContents: models.NewCveContents(models.CveContent{
+					Type: models.WpScan, CveID: "CVE-2024-1234", Title: "Issue",
+					Summary: tt.summary, Cvss3Score: tt.cvssScore,
+					Cvss3Vector: tt.cvssVector, Cvss3Severity: tt.cvssLevel,
+					Published: published, LastModified: modified,
+					References: models.References{
+						{Link: "https://example.com/first"},
+						{Link: "https://example.com/second"},
+					},
+					Optional: tt.optional,
+				}),
+				VulnType:          "XSS",
+				Confidences:       []models.Confidence{models.WpScanMatch},
+				WpPackageFixStats: []models.WpPackageFixStatus{{Name: "core", FixedIn: tt.fixedIn}},
+			}
+			if !reflect.DeepEqual(got[0], want) {
+				t.Errorf("record mismatch:\ngot:  %#v\nwant: %#v", got[0], want)
+			}
+		})
+	}
+}
