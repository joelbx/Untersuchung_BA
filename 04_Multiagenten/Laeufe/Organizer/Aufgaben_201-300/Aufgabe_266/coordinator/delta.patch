@@ -96,6 +96,29 @@ def import_item_db_staged(setup_item_db):
 
 
 class TestImportItem:
+    def test_find_staged_or_pending(self, import_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'id': 4, 'batch_id': 1, 'ia_id': 'amazon:123', 'status': 'staged'},
+                {'id': 5, 'batch_id': 1, 'ia_id': 'idb:456', 'status': 'pending'},
+                {'id': 6, 'batch_id': 1, 'ia_id': 'amazon:456', 'status': 'created'},
+                {'id': 7, 'batch_id': 1, 'ia_id': 'other:123', 'status': 'pending'},
+                {'id': 8, 'batch_id': 1, 'ia_id': 'idb:789', 'status': 'staged'},
+            ],
+        )
+
+        rows = ImportItem.find_staged_or_pending(['123', '456'])
+        assert isinstance(rows, web.db.BaseResultSet)
+        assert {(row.ia_id, row.status) for row in rows} == {
+            ('amazon:123', 'staged'),
+            ('idb:456', 'pending'),
+        }
+        assert [row.ia_id for row in ImportItem.find_staged_or_pending(['123'], ['other'])] == [
+            'other:123'
+        ]
+
