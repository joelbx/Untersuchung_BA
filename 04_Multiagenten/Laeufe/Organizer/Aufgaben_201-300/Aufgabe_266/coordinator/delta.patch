+import web
+
 from openlibrary.core import models
 
 
@@ -20,6 +22,35 @@ class MockPrivateEdition(models.Edition):
 
 
 class TestEdition:
+    def test_from_isbn_imports_staged_isbn10(self, monkeypatch):
+        isbn10 = '0306406152'
+        isbn13 = '9780306406157'
+        imported = False
+        item = web.storage(ia_id=f'amazon:{isbn10}', status='staged')
+
+        class Site:
+            def things(self, query):
+                return ['/books/OL1M'] if imported and query.get('isbn_10') == isbn10 else []
+
+            def get(self, key):
+                return key
+
+        def find_staged(identifiers):
+            assert identifiers == [isbn13, isbn10]
+            return [item]
+
+        def import_item(item):
+            nonlocal imported
+            assert item.ia_id == f'amazon:{isbn10}'
+            imported = True
+
+        monkeypatch.setattr(models.web.ctx, 'site', Site(), raising=False)
+        monkeypatch.setattr(models.ImportItem, 'find_staged_or_pending', find_staged)
+        monkeypatch.setattr(models, 'do_import', import_item)
+
+        assert models.Edition.from_isbn(isbn13) == '/books/OL1M'
+        assert imported
+
     def mock_edition(self, edition_class):
         data = {"key": "/books/OL1M", "type": {"key": "/type/edition"}, "title": "foo"}
         return edition_class(MockSite(), "/books/OL1M", data=data)
