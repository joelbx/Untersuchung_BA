+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Group raw ISBN metadata by trimmed length, without validating it."""
+    values = [isbns] if isinstance(isbns, str) else isbns
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    for value in values:
+        isbn = value.strip()
+        if len(isbn) == 10:
+            isbn_10.append(isbn)
+        elif len(isbn) == 13:
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
