@@ -20,6 +20,7 @@
 import pytest
 
 from qutebrowser.browser import shared
+from qutebrowser.utils import usertypes
 
 
 @pytest.mark.parametrize('dnt, accept_language, custom_headers, expected', [
@@ -45,3 +46,58 @@ def test_custom_headers(config_stub, dnt, accept_language, custom_headers,
 
     expected_items = sorted(expected.items())
     assert shared.custom_headers(url=None) == expected_items
+
+
+@pytest.mark.parametrize('level, source, msg, levels, excludes, shown', [
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP blocked',
+     {'userscript:*': ['error']}, {}, True),
+    (usertypes.JsLogLevel.warning, 'userscript:style', 'Other warning',
+     {'userscript:*': ['error']}, {}, False),
+    (usertypes.JsLogLevel.error, 'website:style', 'Other error',
+     {'userscript:*': ['error']}, {}, False),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP blocked',
+     {'userscript:*': ['error']}, {'userscript:*': ['*CSP*']}, False),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'Other error',
+     {'userscript:*': ['error']}, {'userscript:*': ['*CSP*']}, True),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP blocked',
+     {'userscript:*': ['error']}, {'website:*': ['*CSP*']}, True),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP blocked',
+     None, None, False),
+])
+def test_js_log_to_ui(config_stub, monkeypatch, level, source, msg, levels,
+                      excludes, shown):
+    ui_messages = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, level, ui_messages.append)
+    config_stub.val.content.javascript.log_message.levels = levels
+    config_stub.val.content.javascript.log_message.excludes = excludes
+
+    assert shared._js_log_to_ui(level, source, 66, msg) is shown
+    if shown:
+        assert ui_messages == [f'JS: [{source}:66] {msg}']
+    else:
+        assert not ui_messages
+
+
+def test_javascript_log_message_fallback(config_stub, monkeypatch):
+    logged = []
+    ui_messages = []
+    monkeypatch.setitem(shared._JS_LOGMAP, 'error', logged.append)
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE,
+                        usertypes.JsLogLevel.error, ui_messages.append)
+    config_stub.val.content.javascript.log = {
+        'unknown': 'debug', 'info': 'debug',
+        'warning': 'debug', 'error': 'error'}
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:*': ['*CSP*']}
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:style', 66, 'CSP blocked')
+    assert logged == ['[userscript:style:66] CSP blocked']
+    assert not ui_messages
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:style', 67, 'Other error')
+    assert logged == ['[userscript:style:66] CSP blocked']
+    assert ui_messages == ['JS: [userscript:style:67] Other error']
