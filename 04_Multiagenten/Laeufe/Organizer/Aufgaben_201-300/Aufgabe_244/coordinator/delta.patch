--- a/tests/unit/config/test_config.py
+++ b/tests/unit/config/test_config.py
@@ -381,6 +381,25 @@ class TestConfig:
     def conf(self, config_stub):
         return config_stub
 
+    def test_legacy_darkmode_foreground_threshold(self, conf):
+        old = 'colors.webpage.darkmode.threshold.text'
+        new = 'colors.webpage.darkmode.threshold.foreground'
+
+        conf.set_obj(old, 100)
+        assert conf.get(new) == 100
+        assert conf.get(old) == 100
+
+        conf.set_str(old, '150')
+        assert conf.get_str(new) == '150'
+        assert conf.get_str(old) == '150'
+
+        container = config.ConfigContainer(conf)
+        container.colors.webpage.darkmode.threshold.text = 100
+        assert container.colors.webpage.darkmode.threshold.foreground == 100
+
+        assert conf.unset(old)
+        assert conf.get(new) == 256
+
     @pytest.fixture
     def yaml_value(self, conf):
         """Fixture which provides a getter for a YAML value."""
