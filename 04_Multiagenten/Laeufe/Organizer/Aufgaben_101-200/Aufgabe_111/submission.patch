+func TestAmazonLinuxEOL(t *testing.T) {
+	for _, tt := range []struct {
+		release string
+		year    int
+	}{
+		{"2023 (Amazon Linux)", 2028},
+		{"2025", 2030},
+		{"2027", 2032},
+		{"2029", 2034},
+	} {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("Amazon Linux release not found")
+			}
+			want := time.Date(tt.year, 6, 30, 23, 59, 59, 0, time.UTC)
+			if !eol.StandardSupportUntil.Equal(want) {
+				t.Errorf("StandardSupportUntil = %s, want %s", eol.StandardSupportUntil, want)
+			}
+			if eol.IsStandardSupportEnded(want) || eol.IsExtendedSupportEnded(want) {
+				t.Error("support ended before its deadline")
+			}
+			if !eol.IsStandardSupportEnded(want.Add(time.Second)) || !eol.IsExtendedSupportEnded(want.Add(time.Second)) {
+				t.Error("support remains active after its deadline")
+			}
+		})
+	}
+	if _, found := GetEOL(Amazon, "2024"); found {
+		t.Error("unrecognized Amazon Linux release found")
+	}
+}
