+func parseAmazonSystemRelease(systemRelease string) string {
+	fields := strings.Fields(systemRelease)
+	if len(fields) >= 3 && fields[0] == "Amazon" && fields[1] == "Linux" {
+		versionIndex := 2
+		if len(fields) >= 5 && fields[2] == "AMI" && fields[3] == "release" {
+			versionIndex = 4
+		} else if fields[2] == "release" {
+			versionIndex = 3
+		}
+		if len(fields) > versionIndex {
+			return strings.Join(fields[versionIndex:], " ")
+		}
+	}
+	return "unknown"
+}
