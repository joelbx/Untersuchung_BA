-	PortScanSuccessOn []string `json:"portScanSuccessOn"`
+// UnmarshalJSON accepts both legacy string ports and the object ports written
+// by older releases of the structured port scanner.
+func (p *AffectedProcess) UnmarshalJSON(data []byte) error {
+	var raw struct {
+		PID             string          `json:"pid"`
+		Name            string          `json:"name"`
+		ListenPorts     json.RawMessage `json:"listenPorts"`
+		ListenPortStats []PortStat      `json:"listenPortStats"`
+	}
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return err
+	}
+	*p = AffectedProcess{PID: raw.PID, Name: raw.Name, ListenPortStats: raw.ListenPortStats}
+	if len(raw.ListenPorts) == 0 || string(raw.ListenPorts) == "null" {
+		return nil
+	}
+	if err := json.Unmarshal(raw.ListenPorts, &p.ListenPorts); err == nil {
+		return nil
+	}
+	p.ListenPorts = nil
+	var old []struct {
+		Address           string   `json:"address"`
+		Port              string   `json:"port"`
+		PortScanSuccessOn []string `json:"portScanSuccessOn"`
+	}
+	if err := json.Unmarshal(raw.ListenPorts, &old); err != nil {
+		return err
+	}
+	for _, port := range old {
+		p.ListenPortStats = append(p.ListenPortStats, PortStat{
+			BindAddress: port.Address, Port: port.Port, PortReachableTo: port.PortScanSuccessOn,
+		})
+	}
+	return nil
+}
+
+// PortStat describes a listening port and the addresses from which it was reachable.
+type PortStat struct {
+	BindAddress     string   `json:"bindAddress"`
+	Port            string   `json:"port"`
+	PortReachableTo []string `json:"portReachableTo"`
+}
+
+// NewPortStat parses an IP address and port. Brackets are retained for IPv6 addresses.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	addr, port, err := net.SplitHostPort(ipPort)
+	if err != nil || addr == "" || port == "" {
+		return nil, xerrors.Errorf("invalid listening port %q", ipPort)
+	}
+	if addr != "*" && net.ParseIP(addr) == nil {
+		return nil, xerrors.Errorf("invalid listening address %q", addr)
+	}
+	n, err := strconv.Atoi(port)
+	if err != nil || n < 1 || n > 65535 {
+		return nil, xerrors.Errorf("invalid listening port %q", port)
+	}
+	if strings.HasPrefix(ipPort, "[") {
+		addr = "[" + addr + "]"
+	}
+	stat.BindAddress, stat.Port = addr, port
+	return stat, nil
 }
 
