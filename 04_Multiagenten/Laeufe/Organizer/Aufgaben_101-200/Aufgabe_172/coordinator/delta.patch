diff --git a/models/portstat_test.go b/models/portstat_test.go
new file mode 100644
index 0000000..1afd229
--- /dev/null
+++ b/models/portstat_test.go
@@ -0,0 +1,41 @@
+package models
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestAffectedProcessPortFormats(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		ports []string
+		stats []PortStat
+	}{
+		{"legacy", `{"pid":"1","listenPorts":["127.0.0.1:22","*:80"]}`, []string{"127.0.0.1:22", "*:80"}, nil},
+		{"object", `{"listenPorts":[{"address":"127.0.0.1","port":"22","portScanSuccessOn":["127.0.0.1"]}]}`, nil, []PortStat{{BindAddress: "127.0.0.1", Port: "22", PortReachableTo: []string{"127.0.0.1"}}}},
+		{"current", `{"listenPortStats":[{"bindAddress":"*","port":"80","portReachableTo":["192.0.2.1"]}]}`, nil, []PortStat{{BindAddress: "*", Port: "80", PortReachableTo: []string{"192.0.2.1"}}}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got AffectedProcess
+			if err := json.Unmarshal([]byte(tt.input), &got); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got.ListenPorts, tt.ports) || !reflect.DeepEqual(got.ListenPortStats, tt.stats) {
+				t.Errorf("ports = %#v, stats = %#v", got.ListenPorts, got.ListenPortStats)
+			}
+		})
+	}
+}
+
+func TestHasReachablePort(t *testing.T) {
+	if (Package{}).HasReachablePort() {
+		t.Fatal("empty package has reachable port")
+	}
+	p := Package{AffectedProcs: []AffectedProcess{{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1"}}}}}}
+	if !p.HasReachablePort() {
+		t.Fatal("reachable port not found")
+	}
+}
