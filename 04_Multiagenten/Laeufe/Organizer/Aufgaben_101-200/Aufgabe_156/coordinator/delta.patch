+    def test_scalars_and_container_types(self):
+        import datetime
+        day = datetime.date(2020, 1, 1)
+        value = ({'key': ('secret', day, 12, True, None)}, frozenset(['secret']))
+        result = remove_values(value, ['secret'])
+        self.assertIsInstance(result, tuple)
+        self.assertIsInstance(result[1], frozenset)
+        self.assertEqual(result, ({'key': ('********', day, 12, True, None)}, frozenset(['********'])))
+        self.assertIs(remove_values(day, ['2020']), day)
+
+    def test_deeply_nested(self):
+        value = []
+        inner = value
+        for _ in range(10000):
+            child = []
+            inner.append(child)
+            inner = child
+        inner.append('secret')
+        result = remove_values(value, ['secret'])
+        for _ in range(10000):
+            result = result[0]
+        self.assertEqual(result, ['********'])
