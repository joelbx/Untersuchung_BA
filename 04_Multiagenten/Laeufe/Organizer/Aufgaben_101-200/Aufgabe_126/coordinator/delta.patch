+import { prepareContentToModel } from './input';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+
+describe('assistant lists', () => {
+    it('moves an invalid nested list into its preceding item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+        fixNestedLists(dom);
+        expect(dom.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    });
+
+    it('keeps nested and ordered list markers through Markdown conversion', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>One<ul><li>Child</li></ul></li><li>Two</li></ol>';
+        const markdown = htmlToMarkdown(dom);
+        expect(markdown).toMatch(/1\. One/);
+        expect(markdown).toMatch(/\n\s+- Child/);
+        const result = document.implementation.createHTMLDocument();
+        result.body.innerHTML = markdownToHTML(markdown);
+        expect(result.querySelector('ol > li > ul > li')?.textContent).toBe('Child');
+    });
+});
+
+describe('assistant formatting round trip', () => {
+    it('preserves link and image class and style', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://example.com" class="link" style="color: red">Text</a><img src="https://example.com/image.png" class="image" style="width: 10px">',
+            'uid',
+            'round-trip'
+        );
+        const html = parseModelResult(markdown, 'round-trip');
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = html;
+        expect(dom.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+        expect(dom.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(dom.querySelector('a')?.getAttribute('style')).toContain('color');
+        expect(dom.querySelector('img')?.getAttribute('src')).toBe('https://example.com/image.png');
+        expect(dom.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(dom.querySelector('img')?.getAttribute('style')).toContain('width');
+    });
+});
