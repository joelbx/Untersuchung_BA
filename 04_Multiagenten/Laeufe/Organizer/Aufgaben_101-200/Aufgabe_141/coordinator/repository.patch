diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..cf1fa8f
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,21 @@
+package wordpress
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactives(t *testing.T) {
+	active := models.WpPackage{Name: "active", Status: "active", Type: models.WPPlugin}
+	inactive := models.WpPackage{Name: "inactive", Status: models.Inactive, Type: models.WPTheme}
+	core := models.WpPackage{Name: models.WPCore, Type: models.WPCore}
+
+	got := removeInactives(models.WordPressPackages{active, inactive, core})
+	if len(got) != 2 || got[0] != active || got[1] != core {
+		t.Fatalf("removeInactives returned %v, want active plugin and core", got)
+	}
+	if got := removeInactives(models.WordPressPackages{inactive}); got != nil {
+		t.Fatalf("removeInactives returned %v, want nil", got)
+	}
+}
