+// removeInactives excludes inactive WordPress packages from vulnerability lookups.
+func removeInactives(packages models.WordPressPackages) (filtered models.WordPressPackages) {
+	for _, p := range packages {
+		if p.Status != models.Inactive {
+			filtered = append(filtered, p)
+		}
+	}
+	return filtered
+}
