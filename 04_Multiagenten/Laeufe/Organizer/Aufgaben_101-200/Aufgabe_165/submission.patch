 import { waitForMember } from "./utils/membership";
 import { PreferredRoomVersions } from "./utils/PreferredRoomVersions";
 import SettingsStore from "./settings/SettingsStore";
+import { shouldForceDisableEncryption } from "./utils/room/shouldForceDisableEncryption";
+
+export interface AllowedEncryptionSetting {
+    /** Whether the user may choose the encryption setting. */
+    allowChange: boolean;
+    /** Effective encryption value when policy forbids changes. */
+    forcedValue?: boolean;
+}
+
+/** Resolve room encryption policy before allowing a user to change the creation setting. */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const serverForcesEncryption = await client.doesServerForceEncryptionForPreset(chatPreset);
+    const wellKnownForcesEncryptionOff = shouldForceDisableEncryption(client);
+
+    if (serverForcesEncryption) {
+        if (wellKnownForcesEncryptionOff) {
+            console.warn("Conflicting encryption policies: server requires encryption, .well-known disables it.");
+        }
+        return { allowChange: false, forcedValue: true };
+    }
+    if (wellKnownForcesEncryptionOff) return { allowChange: false, forcedValue: false };
+    return { allowChange: true };
+}
 
 // we define a number of interfaces which take their names from the js-sdk
 /* eslint-disable camelcase */
