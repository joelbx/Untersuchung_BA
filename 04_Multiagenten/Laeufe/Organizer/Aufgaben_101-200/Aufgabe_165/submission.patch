+
+import { MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import { shouldForceDisableEncryption } from "../../../src/utils/room/shouldForceDisableEncryption";
+import { privateShouldBeEncrypted } from "../../../src/utils/rooms";
+
+describe(".well-known encryption policy", () => {
+    const getClientWellKnown = jest.fn();
+    const client = { getClientWellKnown } as unknown as MatrixClient;
+
+    it.each([undefined, {}, { "io.element.e2ee": {} }, { "io.element.e2ee": { force_disable: "true" } }])(
+        "does not force encryption off for %p",
+        (wellKnown) => {
+            getClientWellKnown.mockReturnValue(wellKnown);
+            expect(shouldForceDisableEncryption(client)).toBe(false);
+        },
+    );
+
+    it("forces encryption off ahead of an enabled default", () => {
+        getClientWellKnown.mockReturnValue({ "io.element.e2ee": { default: true, force_disable: true } });
+        expect(shouldForceDisableEncryption(client)).toBe(true);
+        expect(privateShouldBeEncrypted(client)).toBe(false);
+    });
+
+    it("keeps the explicitly disabled default without a force policy", () => {
+        getClientWellKnown.mockReturnValue({ "io.element.e2ee": { default: false } });
+        expect(privateShouldBeEncrypted(client)).toBe(false);
+    });
+});
