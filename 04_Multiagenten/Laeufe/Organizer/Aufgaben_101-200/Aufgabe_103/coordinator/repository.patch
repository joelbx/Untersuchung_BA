+// rpmQueryFields keeps the empty release column emitted by RPM as two spaces.
+func rpmQueryFields(line string) []string {
+	return strings.Split(strings.TrimSpace(strings.ReplaceAll(line, "\t", " ")), " ")
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
