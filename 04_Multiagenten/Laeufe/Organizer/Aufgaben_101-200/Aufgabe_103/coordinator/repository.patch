+func TestRPMEmptyRelease(t *testing.T) {
+	for _, tc := range []struct {
+		name, line, binaryVersion, sourceVersion string
+		repoquery                                bool
+	}{
+		{"rpm epoch zero", "package 0 1  x86_64 package-1-.src.rpm", "1", "1", false},
+		{"rpm with epoch", "package 2 1  x86_64 package-1-.src.rpm", "2:1", "2:1", false},
+		{"repoquery epoch none", "package (none) 1  x86_64 package-1--src.rpm @updates", "1", "1", true},
+		{"repoquery with epoch", "package 2 1  x86_64 package-1--src.rpm @updates", "2:1", "2:1", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := &redhatBase{}
+			var bp *models.Package
+			var sp *models.SrcPackage
+			var err error
+			if tc.repoquery {
+				bp, sp, err = r.parseInstalledPackagesLineFromRepoquery(tc.line)
+			} else {
+				bp, sp, err = r.parseInstalledPackagesLine(tc.line)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if bp.Name != "package" || bp.Version != tc.binaryVersion || bp.Release != "" || bp.Arch != "x86_64" {
+				t.Errorf("binary package: %+v", bp)
+			}
+			if sp == nil || sp.Name != "package" || sp.Version != tc.sourceVersion || sp.Arch != "src" {
+				t.Errorf("source package: %+v", sp)
+			}
+		})
+	}
+}
+
+func TestSplitFileNameValidation(t *testing.T) {
+	for _, tc := range []struct {
+		filename, name, version, release, epoch, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "", "src"},
+		{"package-0--src.rpm", "package", "0", "", "", "src"},
+		{"1:package-name-0-1.src.rpm", "package-name", "0", "1", "1", "src"},
+	} {
+		n, v, r, e, a, err := splitFileName(tc.filename)
+		if err != nil || n != tc.name || v != tc.version || r != tc.release || e != tc.epoch || a != tc.arch {
+			t.Errorf("splitFileName(%q) = %q, %q, %q, %q, %q, %v", tc.filename, n, v, r, e, a, err)
+		}
+	}
+	for _, filename := range []string{"package-0-1.src", "-0-1.src.rpm", "package--1.src.rpm", "package--0-1.src.rpm", "package-0-1..rpm", "package-0-1-src.rpm.bak"} {
+		if _, _, _, _, _, err := splitFileName(filename); err == nil {
+			t.Errorf("splitFileName(%q) accepted malformed filename", filename)
+		}
+	}
+}
+
+func TestParseInstalledPackagesEmptyRelease(t *testing.T) {
+	r := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2"}, log: logging.NewIODiscardLogger()}}
+	for _, line := range []string{
+		"package 0 1  x86_64 package-1-.src.rpm",
+		"package 0 1  x86_64 package-1-.src.rpm @updates",
+	} {
+		bins, srcs, err := r.parseInstalledPackages(line)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if bins["package"].Version != "1" || bins["package"].Release != "" || srcs["package"].Version != "1" {
+			t.Errorf("line %q parsed as %+v, %+v", line, bins, srcs)
+		}
+	}
+}
