+"""Cover archive layout and verified finalization."""
+import datetime
+import os
+import zipfile
+
+import web
+
+from openlibrary.coverstore import archive, config, db, schema
+
+
+def test_cover_layout_and_zip_dedup(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    assert archive.Cover.id_to_item_and_batch_id(8_012_345) == ('0008', '01')
+    assert archive.Cover.get_cover_url(8_012_345, 's') == (
+        'https://archive.org/download/s_covers_0008/'
+        's_covers_0008_01.zip/0008012345-S.jpg')
+    assert archive.Batch(8, 1)._norm_ids() == ('0008', '01')
+    assert archive.Batch.get_relpath(8, 1, 's') == os.path.join(
+        'items', 's_covers_0008', 's_covers_0008_01.zip')
+    source = tmp_path / 'source.jpg'
+    source.write_bytes(b'JPEG')
+    manager = archive.ZipManager()
+    for _ in range(2):
+        manager.add_file('0008012345-S.jpg', str(source), 1_700_000_000)
+    manager.close()
+    with zipfile.ZipFile(archive.Batch.get_abspath(8, 1, 's')) as z:
+        assert z.namelist() == ['0008012345-S.jpg']
+        assert z.read('0008012345-S.jpg') == b'JPEG'
+        assert z.getinfo('0008012345-S.jpg').compress_type == zipfile.ZIP_STORED
+
+
+def test_archive_and_verified_batch(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    database = web.database(dbn='sqlite', db=':memory:')
+    for statement in schema.get_schema('sqlite').split(';'):
+        if statement.strip():
+            database.query(statement)
+    monkeypatch.setattr(db, 'getdb', lambda: database)
+    local = tmp_path / 'localdisk'
+    local.mkdir()
+    names = {}
+    for size in archive.SIZES:
+        field = 'filename' + ('_' + size if size else '')
+        name = f'cover{"-" + size.upper() if size else ""}.jpg'
+        (local / name).write_bytes(size.encode() or b'original')
+        names[field] = name
+    database.insert('cover', id=8_012_345, created=datetime.datetime(2020, 1, 1),
+                    archived=False, failed=False, uploaded=False, **names)
+    archive.archive(test=False)
+    row = db.details(8_012_345)
+    assert row.archived and not row.uploaded and row.filename == 'cover.jpg'
+    for size in archive.SIZES:
+        path = archive.Batch.get_abspath(8, 1, size)
+        assert os.path.isfile(path)
+    class FakeUploader:
+        uploaded = set()
+        def is_uploaded(self, item, filename):
+            return (item, filename) in self.uploaded
+        def upload(self, item, paths):
+            self.uploaded.add((item, os.path.basename(paths[0])))
+    uploader = FakeUploader()
+    batch = archive.Batch(8, 1)
+    assert not batch.process_pending(finalize=True, uploader=uploader)
+    assert not db.details(8_012_345).uploaded
+    database.insert('cover', id=8_012_344, archived=True, failed=False,
+                    uploaded=False, filename='covers_0008_01.tar:1:2')
+    assert not batch.process_pending(upload=True, finalize=True, uploader=uploader)
+    assert not db.details(8_012_345).uploaded
+    database.delete('cover', where='id=$cover_id', vars={'cover_id': 8_012_344})
+    assert batch.process_pending(upload=True, finalize=True, uploader=uploader)
+    row = db.details(8_012_345)
+    assert row.uploaded
+    assert row.filename == archive.Cover.get_cover_url(8_012_345)
+    assert row.filename_s == archive.Cover.get_cover_url(8_012_345, 's')
+    assert not (local / 'cover.jpg').exists()
+    assert not os.path.exists(archive.Batch.get_abspath(8, 1))
