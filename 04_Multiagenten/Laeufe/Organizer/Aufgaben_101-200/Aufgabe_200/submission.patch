index 31ff5bf..0bfdc99 100644
--- a/qutebrowser/utils/utils.py
+++ b/qutebrowser/utils/utils.py
@@ -36,6 +36,7 @@ import glob
 import mimetypes
 import ctypes
 import ctypes.util
+from decimal import Decimal
 from typing import (Any, Callable, IO, Iterator, Optional, Sequence, Tuple, Type, Union,
                     TYPE_CHECKING, cast)
 
@@ -114,6 +115,40 @@ class SelectionUnsupportedError(ClipboardError):
                          "platform!")
 
 
+_DURATION_NUMBER = r'(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+)'
+_DURATION_RE = re.compile(
+    rf'\s*(?:(?P<hours>{_DURATION_NUMBER})h)?\s*'
+    rf'(?:(?P<minutes>{_DURATION_NUMBER})m)?\s*'
+    rf'(?:(?P<seconds>{_DURATION_NUMBER})s)?\s*')
+
+
+def parse_duration(duration: str) -> int:
+    """Convert a duration with h, m, and s units to milliseconds.
+
+    Components can be decimal and must appear in that order. Bare integers
+    are interpreted as milliseconds for compatibility with :later.
+
+    Raises:
+        ValueError: If the duration has no valid time components.
+    """
+    duration = duration.strip()
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    match = _DURATION_RE.fullmatch(duration)
+    if match is None or not any(match.groupdict().values()):
+        raise ValueError("Invalid duration: {!r}".format(duration))
+
+    milliseconds = sum(
+        Decimal(value) * multiplier
+        for value, multiplier in (
+            (match.group('hours') or '0', 3600000),
+            (match.group('minutes') or '0', 60000),
+            (match.group('seconds') or '0', 1000),
+        ))
+    return int(milliseconds)
+
+
