@@ -27,6 +27,32 @@ from qutebrowser.api import cmdutils
 from qutebrowser.utils import objreg
 
 
+@pytest.mark.parametrize('duration, expected', [
+    ('5000', 5000),
+    ('2m15s', 135000),
+    ('1.5h', 5400000),
+])
+def test_later_duration(mocker, qapp, duration, expected):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration=duration, command='message-info hello', win_id=0)
+
+    timer.return_value.setInterval.assert_called_once_with(expected)
+    timer.return_value.start.assert_called_once_with()
+
+
+@pytest.mark.parametrize('duration', ['', '-1s', 'nonsense'])
+def test_later_invalid_duration(mocker, duration):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+
+    with pytest.raises(cmdutils.CommandError):
+        utilcmds.later(duration=duration, command='message-info hello',
+                       win_id=0)
+
+    timer.assert_not_called()
+
