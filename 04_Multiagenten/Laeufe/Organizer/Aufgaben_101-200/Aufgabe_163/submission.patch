diff --git a/config/database.go b/config/database.go
new file mode 100644
index 0000000..6d21873
--- /dev/null
+++ b/config/database.go
@@ -0,0 +1,94 @@
+package config
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseUnknown DatabaseProtocol = iota
+	SQLite
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+func parseDatabaseProtocol(value string) (DatabaseProtocol, error) {
+	switch strings.ToLower(value) {
+	case "sqlite", "sqlite3":
+		return SQLite, nil
+	case "postgres", "postgresql":
+		return Postgres, nil
+	case "mysql":
+		return MySQL, nil
+	default:
+		return DatabaseUnknown, fmt.Errorf("db.protocol: invalid value %q (expected sqlite or sqlite3, postgres or postgresql, or mysql)", value)
+	}
+}
+
+// ConnectionURL returns the selected database target. A supplied URL always wins.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.URL != "" {
+		return d.URL, nil
+	}
+
+	if d.Protocol != SQLite && d.Protocol != Postgres && d.Protocol != MySQL {
+		if d.Protocol == DatabaseUnknown {
+			return "", fmt.Errorf("db.protocol: required (expected sqlite or sqlite3, postgres or postgresql, or mysql)")
+		}
+		return "", fmt.Errorf("db.protocol: invalid value %d (expected sqlite or sqlite3, postgres or postgresql, or mysql)", d.Protocol)
+	}
+	if d.Host == "" {
+		return "", fmt.Errorf("db.host: required for %s", d.Protocol)
+	}
+	if d.Name == "" {
+		return "", fmt.Errorf("db.name: required for %s", d.Protocol)
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return "", fmt.Errorf("db.port: must be between 0 and 65535")
+	}
+
+	if d.Protocol == SQLite {
+		if d.Port != 0 {
+			return "", fmt.Errorf("db.port: not supported for sqlite3")
+		}
+		return "file:" + filepath.ToSlash(filepath.Join(d.Host, d.Name)), nil
+	}
+
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, strconv.Itoa(port)), Path: "/" + d.Name}
+	if d.User != "" || d.Password != "" {
+		if d.Password != "" {
+			u.User = url.UserPassword(d.User, d.Password)
+		} else {
+			u.User = url.User(d.User)
+		}
+	}
+	return u.String(), nil
+}
diff --git a/config/database_test.go b/config/database_test.go
new file mode 100644
index 0000000..4d6656d
--- /dev/null
+++ b/config/database_test.go
@@ -0,0 +1,72 @@
+package config
+
+import (
+	"io/ioutil"
+	"os"
+	"testing"
+
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDatabaseConnectionURL(t *testing.T) {
+	tests := []struct {
+		name string
+		db   DatabaseConfig
+		want string
+		err  string
+	}{
+		{"url precedence", DatabaseConfig{URL: "file:legacy.db", Protocol: DatabaseProtocol(99)}, "file:legacy.db", ""},
+		{"postgres defaults", DatabaseConfig{Protocol: Postgres, Host: "db.example", Name: "flipt", User: "alice", Password: "secret"}, "postgres://alice:secret@db.example:5432/flipt", ""},
+		{"mysql defaults", DatabaseConfig{Protocol: MySQL, Host: "db.example", Name: "flipt"}, "mysql://db.example:3306/flipt", ""},
+		{"sqlite path", DatabaseConfig{Protocol: SQLite, Host: "/var/lib/flipt", Name: "flipt.db"}, "file:/var/lib/flipt/flipt.db", ""},
+		{"missing protocol", DatabaseConfig{Host: "localhost", Name: "flipt"}, "", "db.protocol"},
+		{"missing host", DatabaseConfig{Protocol: Postgres, Name: "flipt"}, "", "db.host"},
+		{"missing name", DatabaseConfig{Protocol: MySQL, Host: "localhost"}, "", "db.name"},
+		{"invalid protocol", DatabaseConfig{Protocol: DatabaseProtocol(44), Host: "localhost", Name: "flipt"}, "", "db.protocol: invalid value 44"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.db.ConnectionURL()
+			if tt.err != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadDatabaseFields(t *testing.T) {
+	tests := []struct{ name, yaml, wantURL, wantErr string }{
+		{"fields", "db:\n  protocol: postgres\n  host: db.example\n  name: flipt\n  user: alice\n  password: secret\n", "postgres://alice:secret@db.example:5432/flipt", ""},
+		{"url wins", "db:\n  url: file:old.db\n  protocol: unknown\n  host: db.example\n", "file:old.db", ""},
+		{"bad protocol", "db:\n  protocol: mongodb\n  host: db.example\n  name: flipt\n", "", "db.protocol: invalid value \"mongodb\""},
+		{"bad port", "db:\n  protocol: mysql\n  host: db.example\n  name: flipt\n  port: nonsense\n", "", "db.port: invalid value"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			viper.Reset()
+			f, err := ioutil.TempFile("", "flipt-config-*.yaml")
+			require.NoError(t, err)
+			defer os.Remove(f.Name())
+			_, err = f.WriteString(tt.yaml)
+			require.NoError(t, err)
+			require.NoError(t, f.Close())
+			cfg, err := Load(f.Name())
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			got, err := cfg.Database.ConnectionURL()
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantURL, got)
+		})
+	}
+	viper.Reset()
+}
