 const tableName = "teleport.dynamo.test"
 
+type tableAPI struct {
+	dynamodbiface.DynamoDBAPI
+	describe func() (*dynamodb.DescribeTableOutput, error)
+	create   func(*dynamodb.CreateTableInput)
+}
+
+func (api *tableAPI) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return api.describe()
+}
+
+func (api *tableAPI) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	api.create(input)
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (api *tableAPI) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
