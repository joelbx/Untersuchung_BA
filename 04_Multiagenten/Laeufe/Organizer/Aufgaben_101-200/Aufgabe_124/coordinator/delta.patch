+func TestBillingModeDefaults(t *testing.T) {
+	for _, tt := range []struct {
+		mode  string
+		want  string
+		valid bool
+	}{
+		{"", billingModePayPerRequest, true},
+		{billingModePayPerRequest, billingModePayPerRequest, true},
+		{billingModeProvisioned, billingModeProvisioned, true},
+		{"invalid", "", false},
+	} {
+		cfg := Config{TableName: tableName, BillingMode: tt.mode}
+		err := cfg.CheckAndSetDefaults()
+		if !tt.valid {
+			require.Error(t, err)
+			continue
+		}
+		require.NoError(t, err)
+		require.Equal(t, tt.want, cfg.BillingMode)
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tt := range []struct {
+		mode       string
+		want       string
+		throughput bool
+	}{
+		{billingModePayPerRequest, dynamodb.BillingModePayPerRequest, false},
+		{billingModeProvisioned, dynamodb.BillingModeProvisioned, true},
+	} {
+		var input *dynamodb.CreateTableInput
+		b := &Backend{Config: Config{BillingMode: tt.mode, ReadCapacityUnits: 12, WriteCapacityUnits: 34}, Entry: log.NewEntry(log.New())}
+		b.svc = &tableAPI{create: func(c *dynamodb.CreateTableInput) { input = c }}
+		require.NoError(t, b.createTable(context.Background(), tableName, fullPathKey))
+		require.Equal(t, tt.want, aws.StringValue(input.BillingMode))
+		if tt.throughput {
+			require.Equal(t, int64(12), aws.Int64Value(input.ProvisionedThroughput.ReadCapacityUnits))
+			require.Equal(t, int64(34), aws.Int64Value(input.ProvisionedThroughput.WriteCapacityUnits))
+		} else {
+			require.Nil(t, input.ProvisionedThroughput)
+		}
+	}
+}
+
+func TestTableStatusBillingMode(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		output     *dynamodb.DescribeTableOutput
+		err        error
+		wantStatus tableStatus
+		wantMode   string
+	}{
+		{"on-demand", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, nil, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"provisioned", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)}}}, nil, tableStatusOK, dynamodb.BillingModeProvisioned},
+		{"missing", nil, awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), tableStatusMissing, ""},
+		{"migration", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}}}, nil, tableStatusNeedsMigration, ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			b := &Backend{svc: &tableAPI{describe: func() (*dynamodb.DescribeTableOutput, error) { return tt.output, tt.err }}}
+			status, mode, err := b.getTableStatus(context.Background(), tableName)
+			require.NoError(t, err)
+			require.Equal(t, tt.wantStatus, status)
+			require.Equal(t, tt.wantMode, mode)
+		})
+	}
+}
