diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..f5b0b97
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,167 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupTimeFormat = "20060102T150405.000000000Z"
+
+var backupName = regexp.MustCompile(`^navidrome_backup_[0-9]{8}T[0-9]{6}\.[0-9]{9}Z\.db$`)
+
+// Backup creates a consistent online snapshot without applying the retention limit.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", fmt.Errorf("backup.path is not configured")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", fmt.Errorf("create backup directory: %w", err)
+	}
+	path := filepath.Join(dir, "navidrome_backup_"+time.Now().UTC().Format(backupTimeFormat)+".db")
+	// Keep incomplete snapshots out of the set eligible for pruning.
+	tmp, err := os.CreateTemp(dir, ".navidrome_backup_*.db")
+	if err != nil {
+		return "", err
+	}
+	tmpPath := tmp.Name()
+	if err := tmp.Close(); err != nil {
+		_ = os.Remove(tmpPath)
+		return "", err
+	}
+	defer os.Remove(tmpPath)
+	dest, err := sql.Open(Driver, tmpPath)
+	if err != nil {
+		return "", err
+	}
+	err = copySQLite(ctx, dest, d.writeDB)
+	closeErr := dest.Close()
+	if err != nil {
+		return "", fmt.Errorf("backup database: %w", err)
+	}
+	if closeErr != nil {
+		return "", closeErr
+	}
+	if err := os.Rename(tmpPath, path); err != nil {
+		return "", fmt.Errorf("publish backup: %w", err)
+	}
+	return path, nil
+}
+
+// Restore copies a verified SQLite backup into the currently open database.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return fmt.Errorf("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	if live, err := os.Stat(conf.Server.DbPath); err == nil && os.SameFile(info, live) {
+		return fmt.Errorf("backup file is the live database")
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	uri := url.URL{Scheme: "file", Path: absPath, RawQuery: "mode=ro"}
+	src, err := sql.Open(Driver, uri.String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var result string
+	if err := src.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("check backup integrity: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("backup integrity check failed: %s", result)
+	}
+	if err := copySQLite(ctx, d.writeDB, src); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+// copySQLite uses SQLite's online backup API for both backup and restore.
+func copySQLite(ctx context.Context, dest, src *sql.DB) error {
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	return srcConn.Raw(func(srcDriver any) error {
+		return destConn.Raw(func(destDriver any) error {
+			backup, err := destDriver.(*sqlite3.SQLiteConn).Backup("main", srcDriver.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, fmt.Errorf("backup.path is not configured")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, fmt.Errorf("backup.count must be nonnegative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if !entry.IsDir() && backupName.MatchString(entry.Name()) {
+			names = append(names, entry.Name())
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	count := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return count, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return count, err
+		}
+		count++
+	}
+	return count, nil
+}
