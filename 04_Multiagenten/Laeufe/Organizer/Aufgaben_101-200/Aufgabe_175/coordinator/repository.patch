+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	old := Server.Backup
+	t.Cleanup(func() { Server.Backup = old })
+	for _, tc := range []struct {
+		input, normalized string
+		valid             bool
+	}{
+		{"", "", true},
+		{"1h", "@every 1h", true},
+		{"0 2 * * *", "0 2 * * *", true},
+		{"invalid", "invalid", false},
+	} {
+		Server.Backup.Schedule = tc.input
+		Server.Backup.Count = 2
+		err := validateBackupSchedule()
+		if (err == nil) != tc.valid || Server.Backup.Schedule != tc.normalized {
+			t.Errorf("schedule %q: normalized %q, error %v", tc.input, Server.Backup.Schedule, err)
+		}
+	}
+}
