index 0000000..97ee822
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,77 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	dir := t.TempDir()
+	oldBackup, oldDBPath := conf.Server.Backup, conf.Server.DbPath
+	t.Cleanup(func() { conf.Server.Backup, conf.Server.DbPath = oldBackup, oldDBPath })
+	conf.Server.Backup.Path = dir
+	conf.Server.Backup.Count = 1
+	conf.Server.DbPath = filepath.Join(dir, "live.db")
+
+	read, err := sql.Open(Driver, conf.Server.DbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	write, err := sql.Open(Driver, conf.Server.DbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { read.Close(); write.Close() })
+	database := &db{readDB: read, writeDB: write}
+	ctx := context.Background()
+	if _, err := write.Exec("CREATE TABLE item (value TEXT); INSERT INTO item VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	backupPath, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(backupPath); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := write.Exec("UPDATE item SET value='after'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := database.Restore(ctx, backupPath); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := write.QueryRow("SELECT value FROM item").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "before" {
+		t.Fatalf("restored value = %q", value)
+	}
+
+	older := filepath.Join(dir, "navidrome_backup_20000101T000000.000000000Z.db")
+	if err := os.WriteFile(older, []byte("old"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	other := filepath.Join(dir, "unrelated.db")
+	if err := os.WriteFile(other, []byte("leave"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	count, err := database.Prune(ctx)
+	if err != nil || count != 1 {
+		t.Fatalf("prune = %d, %v", count, err)
+	}
+	if _, err := os.Stat(older); !os.IsNotExist(err) {
+		t.Fatalf("old backup remains: %v", err)
+	}
+	if _, err := os.Stat(other); err != nil {
+		t.Fatalf("unrelated file removed: %v", err)
+	}
+	if _, err := os.Stat(backupPath); err != nil {
+		t.Fatalf("latest backup removed: %v", err)
+	}
+}
