+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+	config.Conf = config.Config{
+		Servers: map[string]config.ServerInfo{
+			"server": {WordPress: config.WordPressConf{IgnoreInactive: true}},
+		},
+	}
+
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Type: models.WPCore, Version: "5.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Version: "1.0", Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Version: "1.0", Status: "inactive"},
+		{Name: "active-theme", Type: models.WPTheme, Version: "1.0", Status: "active"},
+		{Name: "inactive-theme", Type: models.WPTheme, Version: "1.0", Status: "inactive"},
+	}
+	cache := map[string]*string{
+		"50":              stringPtr(`{}`),
+		"active-plugin":   stringPtr(`{"active-plugin":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`),
+		"inactive-plugin": stringPtr(`{"inactive-plugin":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`),
+		"active-theme":    stringPtr(`{"active-theme":{"vulnerabilities":[{"id":3,"fixed_in":"2.0"}]}}`),
+		"inactive-theme":  stringPtr(`{"inactive-theme":{"vulnerabilities":[{"id":4,"fixed_in":"2.0"}]}}`),
+	}
+	r := &models.ScanResult{
+		ServerName:        "server",
+		WordPressPackages: &packages,
+		ScannedCves:       models.VulnInfos{},
+	}
+	n, err := FillWordPress(r, "", cache)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 2 {
+		t.Fatalf("expected two active package vulnerabilities, got %d", n)
+	}
+	for _, id := range []string{"WPVDBID-1", "WPVDBID-3"} {
+		if _, ok := r.ScannedCves[id]; !ok {
+			t.Errorf("missing vulnerability %s", id)
+		}
+	}
+	for _, id := range []string{"WPVDBID-2", "WPVDBID-4"} {
+		if _, ok := r.ScannedCves[id]; ok {
+			t.Errorf("unexpected inactive package vulnerability %s", id)
+		}
+	}
+
+	config.Conf.Servers["server"] = config.ServerInfo{}
+	r.ScannedCves = models.VulnInfos{}
+	n, err = FillWordPress(r, "", cache)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 4 {
+		t.Fatalf("expected all package vulnerabilities with filtering disabled, got %d", n)
+	}
+}
