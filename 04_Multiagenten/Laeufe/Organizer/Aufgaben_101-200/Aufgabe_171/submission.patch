+func TestFliptAcceptServerVersionFromContext(t *testing.T) {
+	assert.Equal(t, semver.Version{Major: 1}, FliptAcceptServerVersionFromContext(context.Background()))
+
+	version := semver.Version{Major: 2, Minor: 3, Patch: 4}
+	ctx := WithFliptAcceptServerVersion(context.Background(), version)
+	assert.Equal(t, version, FliptAcceptServerVersionFromContext(ctx))
+}
+
+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name    string
+		header  []string
+		version semver.Version
+	}{
+		{name: "missing", version: semver.Version{Major: 1}},
+		{name: "empty", header: []string{""}, version: semver.Version{Major: 1}},
+		{name: "invalid", header: []string{"not-a-version"}, version: semver.Version{Major: 1}},
+		{name: "prefixed", header: []string{"v2.3.4"}, version: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+		{name: "unprefixed", header: []string{"2.3.4"}, version: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.header != nil {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.header[0]))
+			}
+
+			called := false
+			_, err := FliptAcceptServerVersionUnaryInterceptor(zaptest.NewLogger(t))(ctx, nil, nil,
+				func(ctx context.Context, _ interface{}) (interface{}, error) {
+					called = true
+					assert.Equal(t, tt.version, FliptAcceptServerVersionFromContext(ctx))
+					return nil, nil
+				})
+			require.NoError(t, err)
+			assert.True(t, called)
+		})
+	}
+}
