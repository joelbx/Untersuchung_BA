+
+export type DownloadMechanism = 'memory' | 'sw' | 'memory_fallback';
+
+let serviceWorkerUnavailable = false;
+
+export const selectMechanismForDownload = (size?: number): DownloadMechanism => {
+    if (size !== undefined && size < MEMORY_DOWNLOAD_LIMIT) {
+        return 'memory';
+    }
+    return serviceWorkerUnavailable || isUnsupported() ? 'memory_fallback' : 'sw';
+};
 
