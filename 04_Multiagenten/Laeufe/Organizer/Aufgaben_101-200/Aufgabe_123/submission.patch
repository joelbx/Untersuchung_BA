diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..e8ebaea
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,87 @@
+import { render, screen } from '@testing-library/react';
+import { Dispatch, SetStateAction } from 'react';
+import createNotificationManager from './manager';
+import Notification from './Notification';
+import { NotificationOptions } from './interfaces';
+
+const makeManager = () => {
+    let notifications: NotificationOptions[] = [];
+    const setNotifications: Dispatch<SetStateAction<NotificationOptions[]>> = (update) => {
+        notifications = typeof update === 'function' ? update(notifications) : update;
+    };
+    const manager = createNotificationManager(setNotifications);
+    return { manager, getNotifications: () => notifications };
+};
+
+describe('notifications', () => {
+    it('renders sanitized HTML and secures links', () => {
+        const { container } = render(
+            <Notification type="error" isClosing={false} onExit={() => {}}>
+                {
+                    'Please <b>retry</b> <a href="https://example.com" target="_self" rel="opener">here</a><script>alert(1)</script><a href="javascript:alert(1)">bad</a>'
+                }
+            </Notification>
+        );
+
+        expect(screen.getByText('retry').tagName).toBe('B');
+        expect(container.querySelector('script')).toBeNull();
+        const links = container.querySelectorAll('a');
+        expect(links).toHaveLength(2);
+        expect(links[0]).toHaveAttribute('href', 'https://example.com');
+        expect(links[1]).not.toHaveAttribute('href');
+        links.forEach((link) => {
+            expect(link).toHaveAttribute('target', '_blank');
+            expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        });
+    });
+
+    it('preserves React content and secures its links', () => {
+        render(
+            <Notification type="info" isClosing={false} onExit={() => {}}>
+                <a href="https://example.com">React link</a>
+            </Notification>
+        );
+        expect(screen.getByText('React link')).toHaveAttribute('target', '_blank');
+        expect(screen.getByText('React link')).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('deduplicates non-success notifications by their derived string key', () => {
+        const { manager, getNotifications } = makeManager();
+        manager.createNotification({ text: 'same', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'info', expiration: -1 });
+        expect(getNotifications()).toHaveLength(1);
+        expect(getNotifications()[0]).toMatchObject({ key: 'same', type: 'info' });
+        manager.clearNotifications();
+    });
+
+    it('uses explicit keys for React content and IDs otherwise', () => {
+        const { manager, getNotifications } = makeManager();
+        manager.createNotification({ text: <b>first</b>, type: 'error', key: 'shared', expiration: -1 });
+        manager.createNotification({ text: <b>second</b>, type: 'error', key: 'shared', expiration: -1 });
+        expect(getNotifications()).toHaveLength(1);
+        expect(getNotifications()[0].key).toBe('shared');
+        manager.createNotification({ text: <b>third</b>, type: 'error', expiration: -1 });
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications()[1].key).toBe(getNotifications()[1].id);
+        manager.clearNotifications();
+    });
+
+    it('uses an explicit key instead of string text and keeps success separate', () => {
+        const { manager, getNotifications } = makeManager();
+        manager.createNotification({ text: 'first', type: 'error', key: 'shared', expiration: -1 });
+        manager.createNotification({ text: 'second', type: 'warning', key: 'shared', expiration: -1 });
+        manager.createNotification({ text: 'success', type: 'success', key: 'shared', expiration: -1 });
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications()[0]).toMatchObject({ text: 'second', type: 'warning', key: 'shared' });
+        expect(getNotifications()[1]).toMatchObject({ text: 'success', type: 'success', key: 'shared' });
+        manager.clearNotifications();
+    });
+
+    it('allows repeated success notifications with identical content', () => {
+        const { manager, getNotifications } = makeManager();
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        expect(getNotifications()).toHaveLength(2);
+        manager.clearNotifications();
+    });
+});
