diff --git a/internal/server/authz/engine/rego/engine_auth_method_test.go b/internal/server/authz/engine/rego/engine_auth_method_test.go
new file mode 100644
index 0000000..e21942a
--- /dev/null
+++ b/internal/server/authz/engine/rego/engine_auth_method_test.go
@@ -0,0 +1,45 @@
+package rego
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+	"go.uber.org/zap/zaptest"
+)
+
+func TestEngine_IsAuthMethodBuiltin(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	engine, err := newEngine(ctx, zaptest.NewLogger(t), withPolicySource(policySource(`
+package flipt.authz.v1
+import rego.v1
+
+default allow := false
+allow if { flipt.is_auth_method(input, "k8s") }
+`)))
+	require.NoError(t, err)
+
+	allowed, err := engine.IsAllowed(ctx, map[string]interface{}{
+		"authentication": map[string]interface{}{"method": 3},
+	})
+	require.NoError(t, err)
+	require.True(t, allowed)
+
+	allowed, err = engine.IsAllowed(ctx, map[string]interface{}{
+		"authentication": map[string]interface{}{"method": 1},
+	})
+	require.NoError(t, err)
+	require.False(t, allowed)
+
+	allowed, err = engine.IsAllowed(ctx, map[string]interface{}{
+		"authentication": &auth.Authentication{Method: auth.Method_METHOD_KUBERNETES},
+	})
+	require.NoError(t, err)
+	require.True(t, allowed)
+
+	_, err = engine.IsAllowed(ctx, map[string]interface{}{})
+	require.ErrorContains(t, err, "no authentication found")
+}
