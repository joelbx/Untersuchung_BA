@@ -0,0 +1,56 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/rego"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestIsAuthMethod(t *testing.T) {
+	methods := []struct {
+		name string
+		code auth.Method
+	}{
+		{"token", auth.Method_METHOD_TOKEN},
+		{"oidc", auth.Method_METHOD_OIDC},
+		{"kubernetes", auth.Method_METHOD_KUBERNETES},
+		{"k8s", auth.Method_METHOD_KUBERNETES},
+		{"github", auth.Method_METHOD_GITHUB},
+		{"jwt", auth.Method_METHOD_JWT},
+		{"cloud", auth.Method_METHOD_CLOUD},
+	}
+
+	for _, method := range methods {
+		t.Run(method.name, func(t *testing.T) {
+			input := ast.ObjectTerm(
+				ast.Item(ast.StringTerm("authentication"), ast.ObjectTerm(
+					ast.Item(ast.StringTerm("method"), ast.IntNumberTerm(int(method.code))),
+				)),
+			)
+			matched, err := isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm(method.name))
+			require.NoError(t, err)
+			require.Equal(t, ast.BooleanTerm(true), matched)
+
+			input = ast.ObjectTerm(
+				ast.Item(ast.StringTerm("authentication"), ast.ObjectTerm(
+					ast.Item(ast.StringTerm("method"), ast.IntNumberTerm(int(auth.Method_METHOD_NONE))),
+				)),
+			)
+			matched, err = isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm(method.name))
+			require.NoError(t, err)
+			require.Equal(t, ast.BooleanTerm(false), matched)
+		})
+	}
+}
+
+func TestIsAuthMethodErrors(t *testing.T) {
+	_, err := isAuthMethod(rego.BuiltinContext{}, ast.ObjectTerm(), ast.StringTerm("token"))
+	require.EqualError(t, err, "no authentication found")
+
+	input := ast.ObjectTerm(ast.Item(ast.StringTerm("authentication"), ast.ObjectTerm()))
+	_, err = isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm("password"))
+	require.EqualError(t, err, "unsupported auth method: password")
+}
