diff --git a/tests/unit/browser/webengine/test_webengine_certificateerror.py b/tests/unit/browser/webengine/test_webengine_certificateerror.py
new file mode 100644
index 0000000..20572d4
--- /dev/null
+++ b/tests/unit/browser/webengine/test_webengine_certificateerror.py
@@ -0,0 +1,50 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+import pytest
+
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+@pytest.mark.parametrize('qt6, expected', [
+    (False, certificateerror.CertificateErrorWrapperQt5),
+    (True, certificateerror.CertificateErrorWrapperQt6),
+])
+def test_create(mocker, qt6, expected):
+    mocker.patch.object(certificateerror.machinery, 'IS_QT6', qt6)
+    error = mocker.Mock()
+
+    wrapper = certificateerror.create(error)
+
+    assert isinstance(wrapper, expected)
+    assert wrapper._error is error
+    assert not wrapper.certificate_was_accepted()
+    assert error.method_calls == []
+
+
+def test_qt5_decision(mocker):
+    error = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapperQt5(error)
+
+    wrapper.accept_certificate()
+    assert wrapper.ignore
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.ignore
+    assert not wrapper.certificate_was_accepted()
+    with pytest.raises(usertypes.UndeferrableError):
+        wrapper.defer()
+    assert error.method_calls == []
+
+
+def test_qt6_decision(mocker):
+    error = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapperQt6(error)
+
+    wrapper.defer()
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    assert [call[0] for call in error.method_calls] == [
+        'defer', 'acceptCertificate', 'rejectCertificate']
diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..e9ccdbe 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -71,3 +71,30 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+@pytest.mark.parametrize('messages, expected', [
+    (['<&"\' >'], '<p>&lt;&amp;&quot;&#x27; &gt;</p>'),
+    (['<&"\' >', 'a & b'],
+     '<ul>\n                <li>&lt;&amp;&#34;&#39; &gt;</li>\n'
+     '                <li>a &amp; b</li>\n            </ul>'),
+])
+def test_html_escapes_special_characters(messages, expected):
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=None, errors=[FakeError(message) for message in messages])
+    if len(messages) == 1:
+        assert wrapper.html() == expected
+    else:
+        assert [line.strip() for line in wrapper.html().splitlines()
+                if line.strip()] == [line.strip() for line in expected.splitlines()]
+
+
+def test_reply_is_not_used_during_construction(mocker):
+    reply = mocker.Mock()
+    errors = [FakeError('certificate error')]
+    wrapper = certificateerror.CertificateErrorWrapper(reply=reply, errors=errors)
+
+    assert wrapper._reply is reply
+    assert str(wrapper) == 'certificate error'
+    reply.assert_not_called()
+    assert reply.method_calls == []
