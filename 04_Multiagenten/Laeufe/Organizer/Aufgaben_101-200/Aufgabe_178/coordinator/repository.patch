diff --git a/test/units/utils/test_encrypt.py b/test/units/utils/test_encrypt.py
index abf2683..9df4342 100644
--- a/test/units/utils/test_encrypt.py
+++ b/test/units/utils/test_encrypt.py
@@ -210,3 +210,38 @@ def test_passlib_bcrypt_salt(recwarn):
 
     result = p.hash(secret, salt=repaired_salt)
     assert result == expected
+
+
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_passlib(ident):
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib not available')
+    salt = '123456789012345678901u'
+    result = get_encrypted_password('123', 'blowfish', salt=salt, rounds=12, ident=ident)
+    assert result.startswith('$%s$12$%s' % (ident, salt))
+    assert encrypt.do_encrypt('123', 'bcrypt', salt=salt, ident=ident).startswith('$%s$' % ident)
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+def test_bcrypt_ident_crypt(ident):
+    with passlib_off():
+        result = get_encrypted_password('123', 'bcrypt', salt='123456789012345678901u', rounds=12, ident=ident)
+        assert result.startswith('$%s$12$123456789012345678901u' % ident)
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+def test_bcrypt_legacy_ident_crypt(monkeypatch):
+    # libc support for $2$ varies; verify the salt passed to crypt includes it.
+    monkeypatch.setattr(encrypt.crypt, 'crypt', lambda secret, salt: salt + 'hash')
+    assert encrypt.CryptHash('bcrypt').hash('123', salt='123456789012345678901u', rounds=12, ident='2').startswith('$2$12$')
+
+
+def test_ident_ignored_for_other_algorithms():
+    expected = get_encrypted_password('123', 'sha256', salt='12345678')
+    assert get_encrypted_password('123', 'sha256', salt='12345678', ident='not-bcrypt') == expected
+
+
+def test_invalid_bcrypt_ident():
+    with pytest.raises(AnsibleFilterError):
+        get_encrypted_password('123', 'bcrypt', ident='invalid')
