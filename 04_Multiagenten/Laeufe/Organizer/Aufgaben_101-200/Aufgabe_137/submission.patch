+func TestNewProviderSamplingRatio(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		ratio   float64
+		sampled bool
+	}{
+		{name: "none", ratio: 0, sampled: false},
+		{name: "all", ratio: 1, sampled: true},
