new file mode 100644
index 0000000..3cc4f66
--- /dev/null
+++ b/internal/config/tracing_test.go
@@ -0,0 +1,38 @@
+package config
+
+import (
+	"math"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestTracingDefaults(t *testing.T) {
+	tracing := Default().Tracing
+	require.Equal(t, float64(1), tracing.SamplingRatio)
+	require.Equal(t, []TracingPropagator{TracingPropagatorTraceContext, TracingPropagatorBaggage}, tracing.Propagators)
+	require.NoError(t, tracing.validate())
+}
+
+func TestTracingValidation(t *testing.T) {
+	for _, ratio := range []float64{0, 0.5, 1} {
+		t.Run("valid ratio", func(t *testing.T) {
+			cfg := TracingConfig{SamplingRatio: ratio}
+			require.NoError(t, cfg.validate())
+		})
+	}
+	for _, ratio := range []float64{-0.1, 1.1, math.NaN()} {
+		t.Run("invalid ratio", func(t *testing.T) {
+			cfg := TracingConfig{SamplingRatio: ratio}
+			require.EqualError(t, cfg.validate(), "sampling ratio should be a number between 0 and 1")
+		})
+	}
+
+	all := []TracingPropagator{
+		TracingPropagatorTraceContext, TracingPropagatorBaggage,
+		TracingPropagatorB3, TracingPropagatorB3Multi, TracingPropagatorJaeger,
+		TracingPropagatorXRay, TracingPropagatorOTTrace, TracingPropagatorNone,
+	}
+	require.NoError(t, (&TracingConfig{SamplingRatio: 1, Propagators: all}).validate())
+	require.EqualError(t, (&TracingConfig{SamplingRatio: 1, Propagators: []TracingPropagator{"unknown"}}).validate(), "invalid propagator option: unknown")
+}
