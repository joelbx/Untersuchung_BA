+func TestConvertToDistroAdvisory(t *testing.T) {
+	tests := []struct {
+		family, title, want string
+	}{
+		{constant.RedHat, "RHSA-2024:1234: Important update", "RHSA-2024:1234"},
+		{constant.CentOS, "RHBA-2024:1234: Bug fix", "RHBA-2024:1234"},
+		{constant.Alma, "RHSA-2024:1234: Important update", "RHSA-2024:1234"},
+		{constant.Rocky, "RHBA-2024:1234: Bug fix", "RHBA-2024:1234"},
+		{constant.Oracle, "ELSA-2024-1234: Important update", "ELSA-2024-1234"},
+		{constant.Amazon, "ALAS2-2024-1234: Important update", "ALAS2-2024-1234"},
+		{constant.Fedora, "FEDORA-2024-1234: Important update", "FEDORA-2024-1234"},
+		{constant.RedHat, "CVE-2024-1234: Vulnerability", ""},
+		{constant.Oracle, "RHSA-2024:1234: Update", ""},
+		{constant.Amazon, "", ""},
+		{constant.Fedora, " ", ""},
+	}
+	for _, tt := range tests {
+		got := (RedHatBase{Base{family: tt.family}}).convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
+		if tt.want == "" {
+			if got != nil {
+				t.Errorf("%s %q: expected no advisory, got %#v", tt.family, tt.title, got)
+			}
+		} else if got == nil || got.AdvisoryID != tt.want {
+			t.Errorf("%s %q: expected %q, got %#v", tt.family, tt.title, tt.want, got)
+		}
+	}
+}
