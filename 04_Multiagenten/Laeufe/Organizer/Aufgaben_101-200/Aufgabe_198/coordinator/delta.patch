+func TestIsOvalDefAffectedResolution(t *testing.T) {
+	for _, tt := range []struct {
+		state string
+		want  bool
+	}{
+		{"Will not fix", false},
+		{"Under investigation", false},
+		{"Fix deferred", true},
+		{"Affected", true},
+		{"Out of support scope", true},
+		{"", true},
+	} {
+		def := ovalmodels.Definition{
+			AffectedPacks: []ovalmodels.Package{{Name: "pkg", NotFixedYet: true}},
+		}
+		if tt.state != "" {
+			def.Advisory.AffectedResolution = []ovalmodels.Resolution{{
+				State:      tt.state,
+				Components: []ovalmodels.Component{{Component: "other"}, {Component: "pkg"}},
+			}}
+		}
+		affected, notFixedYet, fixState, _ := isOvalDefAffected(def, request{packName: "pkg"}, constant.RedHat, "9", models.Kernel{}, nil)
+		if affected != tt.want || !notFixedYet || fixState != tt.state {
+			t.Errorf("%q: affected=%t notFixedYet=%t fixState=%q", tt.state, affected, notFixedYet, fixState)
+		}
+	}
+}
