+func TestUpdatePreservesFixStateWithoutAdvisory(t *testing.T) {
+	r := models.ScanResult{ScannedCves: models.VulnInfos{}}
+	def := defPacks{
+		def: ovalmodels.Definition{
+			Title:    "CVE-2024-1234: Vulnerability",
+			Advisory: ovalmodels.Advisory{Cves: []ovalmodels.Cve{{CveID: "CVE-2024-1234"}}},
+		},
+		binpkgFixstat: map[string]fixStat{"pkg": {notFixedYet: true, fixState: "Fix deferred", fixedIn: "2.0"}},
+	}
+	(RedHatBase{Base{family: constant.RedHat}}).update(&r, def)
+	v := r.ScannedCves["CVE-2024-1234"]
+	if len(v.DistroAdvisories) != 0 {
+		t.Errorf("unexpected advisory: %#v", v.DistroAdvisories)
+	}
+	want := models.PackageFixStatuses{{Name: "pkg", NotFixedYet: true, FixState: "Fix deferred", FixedIn: "2.0"}}
+	if !reflect.DeepEqual(v.AffectedPackages, want) {
+		t.Errorf("expected %#v, got %#v", want, v.AffectedPackages)
+	}
+}
