+import React from "react";
+
+import AccessibleButton from "../elements/AccessibleButton";
+import { useContextMenu } from "../../structures/ContextMenu";
+import UIStore from "../../../stores/UIStore";
+import IconizedContextMenu from "./IconizedContextMenu";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "onClick" | "children"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...props }) => {
+    const [isOpen, buttonRef, open, close] = useContextMenu<HTMLElement>();
+    const rect = buttonRef.current?.getBoundingClientRect();
+
+    return <>
+        <AccessibleButton
+            {...props}
+            inputRef={buttonRef}
+            className="mx_KebabContextMenu"
+            title={title}
+            aria-label={title}
+            aria-haspopup="true"
+            aria-expanded={isOpen}
+            aria-disabled={!!disabled}
+            disabled={disabled}
+            onClick={ev => {
+                buttonRef.current?.focus();
+                open(ev);
+            }}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </AccessibleButton>
+        { isOpen && rect && <IconizedContextMenu
+            top={rect.bottom + window.scrollY}
+            right={UIStore.instance.windowWidth - rect.right - window.scrollX}
+            onFinished={close}
+        >
+            { options }
+        </IconizedContextMenu> }
+    </>;
+};
