+def _get_incdec_value(value, incdec, url, count):
+    """Change the first number outside percent-encoded triplets in a component."""
+    encoded = {index for match in re.finditer(r'%[0-9A-Fa-f]{2}', value)
+               for index in range(match.start(), match.end())}
+    for match in re.finditer(r'[0-9]+', value):
+        # A digit run can start in a triplet and continue beyond it. Only
+        # consider digits after the encoded triplet in that case.
+        start, end = match.span()
+        while start < end and start in encoded:
+            start += 1
+        if start == end:
+            continue
+        number = value[start:end]
+        current = int(number)
+        if incdec == 'decrement':
+            if current < count:
+                raise IncDecError("Can't decrement {} by {}!".format(
+                    current, count), url)
+            result = current - count
+        else:
+            result = current + count
+        replacement = str(result)
+        if len(number) > 1 and number.startswith('0'):
+            replacement = replacement.zfill(len(number))
+        return value[:start] + replacement + value[end:]
+    return None
 
 
