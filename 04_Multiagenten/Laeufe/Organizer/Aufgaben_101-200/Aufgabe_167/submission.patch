+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,72 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	layout "oras.land/oras-go/v2/content/oci"
+)
+
+func TestSourceLocalExternalUpdate(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	write := func(payload string) {
+		t.Helper()
+		target, err := layout.New(filepath.Join(dir, "flags"))
+		require.NoError(t, err)
+		target.AutoSaveIndex = true
+		layer := v1.Descriptor{
+			MediaType: fliptoci.MediaTypeFliptNamespace + "+yaml",
+			Digest:    digest.FromString(payload), Size: int64(len(payload)),
+			Annotations: map[string]string{fliptoci.AnnotationFliptNamespace: "production"},
+		}
+		require.NoError(t, target.Push(ctx, layer, bytes.NewBufferString(payload)))
+		manifest, err := oras.PackManifest(ctx, target, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{Layers: []v1.Descriptor{layer}})
+		require.NoError(t, err)
+		require.NoError(t, target.Tag(ctx, manifest, "latest"))
+	}
+	write("flags:\n  - key: first\n    name: First\n    enabled: true\n")
+	store, err := fliptoci.NewStore(&config.OCI{BundleDirectory: dir, Repository: "flipt://local/flags:latest"})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, WithPollInterval(10*time.Millisecond))
+	require.NoError(t, err)
+	require.Equal(t, "oci", source.String())
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "production", "first")
+	require.NoError(t, err)
+	same, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, same)
+
+	subctx, cancel := context.WithCancel(ctx)
+	snapshots := make(chan *storagefs.StoreSnapshot)
+	go source.Subscribe(subctx, snapshots)
+	write("flags:\n  - key: second\n    name: Second\n    enabled: true\n")
+	select {
+	case updated := <-snapshots:
+		require.NotSame(t, first, updated)
+		_, err = updated.GetFlag(ctx, "production", "second")
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("source did not publish changed OCI manifest")
+	}
+	cancel()
+	select {
+	case _, ok := <-snapshots:
+		require.False(t, ok)
+	case <-time.After(time.Second):
+		t.Fatal("subscription did not stop")
+	}
+}
