+	stat, err := response.Files[0].Stat()
+	require.NoError(t, err)
+	require.Equal(t, ".yaml", path.Ext(stat.Name()))
+	content, err := io.ReadAll(response.Files[0])
+	require.NoError(t, err)
+	require.Contains(t, string(content), "namespace: production")
+	require.Contains(t, string(content), "key: compressed")
+}
