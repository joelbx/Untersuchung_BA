+#!/usr/bin/python
+# -*- coding: utf-8 -*-
+# Copyright: (c) 2026, Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1', 'status': ['preview'], 'supported_by': 'community'}
+
+DOCUMENTATION = '''
+---
+module: icx_logging
+version_added: '2.9'
+short_description: Manage logging on Ruckus ICX 7000 series switches
+description:
+  - Configure logging destinations, buffered severity levels, and the syslog facility.
+author: Ansible Project
+options:
+  dest:
+    description: Logging destination or global logging switch.
+    type: str
+    choices: [on, host, console, buffered, persistence, rfc5424]
+  name:
+    description: Host name or IPv4/IPv6 address for a host destination.
+    type: str
+  udp_port:
+    description: UDP port for a host destination.
+    type: int
+  facility:
+    description: Syslog facility to configure or clear.
+    type: str
+  level:
+    description: Severity level for buffered logging.
+    type: str
+    choices: [emergencies, alerts, critical, errors, warnings, notifications, informational, debugging]
+  aggregate:
+    description: List of logging settings. Each entry can also specify a state.
+    type: list
+    elements: dict
+    suboptions:
+      dest:
+        type: str
+        choices: [on, host, console, buffered, persistence, rfc5424]
+      name:
+        type: str
+      udp_port:
+        type: int
+      facility:
+        type: str
+      level:
+        type: str
+        choices: [emergencies, alerts, critical, errors, warnings, notifications, informational, debugging]
+      state:
+        type: str
+        choices: [present, absent]
+  state:
+    description: Desired state.
+    type: str
+    choices: [present, absent]
+    default: present
+  check_running_config:
+    description: Compare with the running configuration before sending commands.
+    type: bool
+    default: true
+    env:
+      - name: ANSIBLE_CHECK_ICX_RUNNING_CONFIG
+'''
+
+EXAMPLES = '''
+- name: Add IPv6 syslog host and set facility
+  icx_logging:
+    dest: host
+    name: '2001:db8::10'
+    udp_port: 514
+    facility: local7
+
+- name: Disable buffered debugging and console logging
+  icx_logging:
+    aggregate:
+      - {dest: buffered, level: debugging, state: absent}
+      - {dest: console, state: absent}
+'''
+
+RETURN = '''
+commands:
+  description: Configuration commands sent to the device.
+  returned: always
+  type: list
+'''
+
+import re
+
+from ansible.module_utils.basic import AnsibleModule, env_fallback
+from ansible.module_utils.network.common.utils import validate_ip_v6_address
+from ansible.module_utils.network.icx.icx import get_config, load_config
+
+LEVELS = ('emergencies', 'alerts', 'critical', 'errors', 'warnings',
+          'notifications', 'informational', 'debugging')
+DESTINATIONS = ('on', 'host', 'console', 'buffered', 'persistence', 'rfc5424')
+
+
+def count_terms(check, param=None):
+    if param is None:
+        param = check
+        check = param.keys()
+    return sum(1 for key in check if param.get(key) is not None)
+
+
+def check_required_if(module, spec, param):
+    for field, value, required in spec or []:
+        if param.get(field) == value:
+            missing = [key for key in required if param.get(key) is None]
+            if missing:
+                module.fail_json(msg='%s is required when %s is %s' %
+                                 (', '.join(missing), field, value))
+
+
+def search_obj_in_list(name, lst):
+    for item in lst:
+        if item.get('name') == name:
+            return item
+    return None
+
+
+def diff_in_list(want, have):
+    return set(want) - set(have), set(have) - set(want)
+
+
+def parse_port(line, dest):
+    if dest == 'host':
+        match = re.search(r'\budp-port\s+(\d+)\b', line)
+        if match:
+            return match.group(1)
+    return None
+
+
+def parse_name(line, dest):
+    if dest == 'host':
+        match = re.match(r'^logging host (?:ipv6 )?(\S+)', line.strip())
+        if match:
+            return match.group(1)
+    return None
+
+
+def parse_address(line, dest):
+    return dest == 'host' and re.match(r'^logging host ipv6\s+\S+', line.strip()) is not None
+
+
+def map_params_to_obj(module, required_if=None):
+    params = module.params
+    entries = params.get('aggregate')
+    if entries is None:
+        entries = [params]
+    result = []
+    for entry in entries:
+        item = {key: entry.get(key) if entry.get(key) is not None else params.get(key)
+                for key in ('dest', 'name', 'udp_port', 'facility', 'level', 'state')}
+        check_required_if(module, required_if, item)
+        if item['dest'] is None and item['facility'] is None:
+            module.fail_json(msg='dest or facility is required')
+        if item['dest'] != 'host':
+            item['name'] = None
+            item['udp_port'] = None
+        else:
+            item['addr6'] = bool(validate_ip_v6_address(item['name']))
+            if ':' in item['name'] and not item['addr6']:
+                module.fail_json(msg='invalid IPv6 address: %s' % item['name'])
+            if item['udp_port'] is not None:
+                if not 1 <= item['udp_port'] <= 65535:
+                    module.fail_json(msg='udp_port must be between 1 and 65535')
+                item['udp_port'] = str(item['udp_port'])
+        if item['dest'] == 'buffered':
+            item['level'] = set([item['level']])
+        else:
+            item['level'] = None
+        item.setdefault('addr6', False)
+        if item['facility'] is not None:
+            result.append(dict(dest='facility', name=None, udp_port=None,
+                               addr6=False, facility=item['facility'], level=None,
+                               state=item['state']))
+        if item['dest'] is not None:
+            item['facility'] = None
+            result.append(item)
+    return result
+
+
+def map_config_to_obj(module):
+    data = get_config(module, None, compare=module.params.get('check_running_config')) or ''
+    result = []
+    facility = 'user'
+    buffered = set()
+    buffered_seen = False
+    disabled = set()
+    global_off = False
+    for raw in data.splitlines():
+        line = raw.strip()
+        if line == 'no logging on':
+            global_off = True
+        elif line.startswith('logging host '):
+            result.append(dict(dest='host', name=parse_name(line, 'host'),
+                               udp_port=parse_port(line, 'host'),
+                               addr6=parse_address(line, 'host'), facility=None, level=None))
+        elif line.startswith('logging facility '):
+            facility = line.split(None, 2)[2]
+        elif line == 'no logging facility':
+            facility = 'user'
+        elif line == 'logging buffered':
+            buffered_seen = True
+            buffered.update(LEVELS)
+        elif line.startswith('logging buffered '):
+            level = line.split(None, 2)[2]
+            if level in LEVELS:
+                buffered_seen = True
+                buffered.add(level)
+        elif line.startswith('no logging buffered '):
+            level = line.split(None, 3)[3]
+            if level in LEVELS:
+                disabled.add(level)
+        elif line == 'no logging buffered':
+            buffered_seen = False
+            buffered.clear()
+            disabled.clear()
+        elif line in ('logging console', 'logging persistence', 'logging enable rfc5424', 'logging on'):
+            dest = 'rfc5424' if line == 'logging enable rfc5424' else line.split()[1]
+            result.append(dict(dest=dest, name=None, udp_port=None,
+                               addr6=False, facility=None, level=None))
+        elif line in ('no logging console', 'no logging persistence', 'no logging enable rfc5424'):
+            dest = 'rfc5424' if line == 'no logging enable rfc5424' else line.split()[2]
+            result[:] = [item for item in result if item['dest'] != dest]
+    if buffered_seen or disabled:
+        # A disabled severity line describes an exception to the enabled set.
+        if not buffered_seen:
+            buffered.update(LEVELS)
+        buffered.difference_update(disabled)
+        result.append(dict(dest='buffered', name=None, udp_port=None,
+                           addr6=False, facility=None, level=buffered))
+    result.append(dict(dest='facility', name=None, udp_port=None,
+                       addr6=False, facility=facility, level=None))
+    if not global_off:
+        result.append(dict(dest='on', name=None, udp_port=None,
+                           addr6=False, facility=None, level=None))
+    return result
+
+
+def map_obj_to_commands(updates):
+    want, have = updates
+    commands = []
+    for item in want:
+        dest = item['dest']
+        state = item.get('state', 'present')
+        current = [entry for entry in have if entry['dest'] == dest]
+        if dest == 'facility':
+            existing = current[0]['facility'] if current else 'user'
+            if state == 'present' and existing != item['facility']:
+                commands.append('logging facility %s' % item['facility'])
+            elif state == 'absent' and existing != 'user' and existing == item['facility']:
+                commands.append('no logging facility')
+        elif dest == 'host':
+            matches = [entry for entry in current if entry['name'] == item['name'] and
+                       entry['addr6'] == item['addr6']]
+            exact = [entry for entry in matches if entry['udp_port'] == item['udp_port']]
+            prefix = 'logging host %s%s' % ('ipv6 ' if item['addr6'] else '', item['name'])
+            if state == 'present' and not (exact or (item['udp_port'] is None and matches)):
+                commands.append(prefix + (' udp-port %s' % item['udp_port'] if item['udp_port'] else ''))
+            elif state == 'absent':
+                for entry in (exact if item['udp_port'] is not None else matches):
+                    command = 'no ' + prefix
+                    if entry['udp_port'] is not None:
+                        command += ' udp-port %s' % entry['udp_port']
+                    commands.append(command)
+        elif dest == 'buffered':
+            existing = current[0]['level'] if current else set()
+            levels = item['level']
+            adds, removes = diff_in_list(levels, existing)
+            if state == 'present':
+                commands.extend('logging buffered %s' % level for level in LEVELS if level in adds)
+            else:
+                commands.extend('no logging buffered %s' % level for level in LEVELS if level in levels and level in existing)
+        else:
+            command = 'logging enable rfc5424' if dest == 'rfc5424' else 'logging %s' % dest
+            present = bool(current)
+            if state == 'present' and not present:
+                commands.append(command)
+            elif state == 'absent' and present:
+                commands.append('no ' + command)
+    return commands
+
+
+def main():
+    element_spec = dict(
+        dest=dict(type='str', choices=DESTINATIONS),
+        name=dict(type='str'), udp_port=dict(type='int'), facility=dict(type='str'),
+        level=dict(type='str', choices=LEVELS),
+        state=dict(type='str', choices=['present', 'absent'], default='present'))
+    aggregate_spec = {key: value.copy() for key, value in element_spec.items()}
+    aggregate_spec['state'].pop('default')
+    argument_spec = element_spec.copy()
+    argument_spec.update(
+        aggregate=dict(type='list', elements='dict', options=aggregate_spec),
+        check_running_config=dict(type='bool', default=True,
+                                  fallback=(env_fallback, ['ANSIBLE_CHECK_ICX_RUNNING_CONFIG'])))
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+    want = map_params_to_obj(module, [('dest', 'host', ['name']),
+                                      ('dest', 'buffered', ['level'])])
+    have = map_config_to_obj(module)
+    commands = map_obj_to_commands((want, have))
+    if commands and not module.check_mode:
+        load_config(module, commands)
+    module.exit_json(changed=bool(commands), commands=commands)
+
+
+if __name__ == '__main__':
+    main()
