+// commonDirectory returns the deepest directory shared by all paths.
+func commonDirectory(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	base := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		parent := filepath.Clean(dir)
+		for {
+			rel, err := filepath.Rel(base, parent)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			next := filepath.Dir(base)
+			if next == base {
+				return ""
+			}
+			base = next
+		}
+	}
+	return base
+}
+
+// artistFolder is the common parent of the directories holding an artist's albums.
+func artistFolder(albumDirs []string) string {
+	if len(albumDirs) == 0 {
+		return ""
+	}
+	parents := make([]string, len(albumDirs))
+	for i, dir := range albumDirs {
+		parents[i] = filepath.Dir(dir)
+	}
+	return commonDirectory(parents)
+}
+
+func fromArtistFolder(folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		entries, err := os.ReadDir(folder)
+		if err != nil {
+			return nil, "", err
+		}
+		for _, entry := range entries {
+			if entry.IsDir() {
+				continue
+			}
+			matched, err := filepath.Match("artist.*", strings.ToLower(entry.Name()))
+			if err != nil || !matched {
+				continue
+			}
+			path := filepath.Join(folder, entry.Name())
+			f, err := os.Open(path)
+			if err == nil {
+				return f, path, nil
+			}
+		}
+		return nil, "", nil
+	}
+}
