+// packageType maps scanner and manifest ecosystem names to PURL types.
+func packageType(t string) string {
+	switch t {
+	case "gomod":
+		return "golang"
+	case "pip", "pipenv", "poetry", "uv":
+		return "pypi"
+	case "pom", "jar", "gradle":
+		return "maven"
+	case "yarn", "pnpm":
+		return "npm"
+	default:
+		return t
+	}
+}
+
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch t {
+	case "maven":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			return group, artifact, ""
+		}
+	case "pypi":
+		return "", strings.ReplaceAll(strings.ToLower(n), "_", "-"), ""
+	case "golang":
+		if i := strings.LastIndex(n, "/"); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				return scope, pkg, ""
+			}
+		}
+	case "cocoapods":
+		if pod, part, ok := strings.Cut(n, "/"); ok {
+			return "", pod, part
+		}
+	}
+	return "", name, ""
+}
