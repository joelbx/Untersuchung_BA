@@ -0,0 +1,73 @@
+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		pkgType, input           string
+		namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"unknown", "unchanged/name", "", "unchanged/name", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pkgType+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.pkgType, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.pkgType, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPURLSubpath(t *testing.T) {
+	scanner := models.LibraryScanner{
+		Type: ftypes.LangType("cocoapods"),
+		Libs: []models.Library{{Name: "GoogleUtilities/NSData+zlib", Version: "1.0.0"}},
+	}
+	purls := map[string]map[string]string{"": {}}
+	libpkgToCdxComponents(scanner, purls)
+	got := purls[""]["GoogleUtilities/NSData+zlib"]
+	want := "pkg:cocoapods/GoogleUtilities@1.0.0?file_path=#NSData+zlib"
+	if got != want {
+		t.Errorf("PURL = %q, want %q", got, want)
+	}
+}
+
+func TestDependencyGraphPURLNameParsing(t *testing.T) {
+	tests := []struct {
+		filename, pkgName, want string
+	}{
+		{"pom.xml", "com.google.guava:guava", "pkg:maven/com.google.guava/guava"},
+		{"go.mod", "github.com/protobom/protobom", "pkg:golang/github.com/protobom/protobom"},
+		{"requirements.txt", "My_Package", "pkg:pypi/my-package"},
+		{"package-lock.json", "@babel/core", "pkg:npm/%40babel/core"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			m := models.DependencyGraphManifest{
+				Filename:     tt.filename,
+				Dependencies: []models.Dependency{{PackageName: tt.pkgName}},
+			}
+			purls := map[string]map[string]string{m.RepoURLFilename(): {}}
+			ghpkgToCdxComponents(m, purls)
+			got := purls[m.RepoURLFilename()][tt.pkgName]
+			if len(got) < len(tt.want) || got[:len(tt.want)] != tt.want {
+				t.Errorf("PURL = %q, want prefix %q", got, tt.want)
+			}
+		})
+	}
+}
