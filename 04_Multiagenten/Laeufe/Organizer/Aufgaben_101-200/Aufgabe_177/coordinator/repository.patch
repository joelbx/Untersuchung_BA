diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..efd363e
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,29 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Seed chat allow lists from followed users',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const keys = uids.map(uid => `user:${uid}:settings`);
+			const settings = await db.getObjects(keys, ['restrictChat', 'chatAllowList']);
+			const eligible = uids.filter((uid, index) =>
+				settings[index] && parseInt(settings[index].restrictChat, 10) === 1 &&
+				(settings[index].chatAllowList === null || settings[index].chatAllowList === undefined));
+			const following = await Promise.all(eligible.map(uid => db.getSortedSetMembers(`following:${uid}`)));
+			await db.setObjectBulk(eligible.map((uid, index) => [
+				`user:${uid}:settings`, {
+					chatAllowList: JSON.stringify(following[index].map(String)),
+					...(following[index].length ? {} : { disableIncomingMessages: 1 }),
+				},
+			]));
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
