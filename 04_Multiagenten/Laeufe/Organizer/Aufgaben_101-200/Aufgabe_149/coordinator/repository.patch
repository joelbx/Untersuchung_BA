@@ -383,6 +383,50 @@ class TestQtArgs:
         assert combined_flag in args
         assert overlay_flag not in args
 
+    @pytest.mark.parametrize('commandline_flags, config_flags', [
+        (['enable-features=First,Second', 'disable-features=Third,Fourth'], []),
+        ([], ['enable-features=First,Second',
+              'disable-features=Third,Fourth']),
+        (['enable-features=First', 'disable-features=Third,Fourth'],
+         ['enable-features=Second', 'disable-features=Fifth']),
+    ])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch, parser,
+                                         commandline_flags, config_flags):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+        config_stub.val.qt.args = config_flags
+
+        commandline_args = [arg for flag in commandline_flags
+                            for arg in ('--qt-flag', flag)]
+        args = qtargs.qt_args(parser.parse_args(commandline_args))
+
+        enabled = [arg for arg in args
+                   if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        disabled = [arg for arg in args
+                    if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)]
+        assert enabled == ['--enable-features=First,Second,OverlayScrollbar']
+        expected_disabled = ['--' + flag for flag in
+                             commandline_flags + config_flags
+                             if flag.startswith('disable-features=')]
+        assert disabled == expected_disabled
+
+    def test_disable_features_without_enabled_features(self, config_stub,
+                                                       monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['disable-features=First,Second']
+
+        args = qtargs.qt_args(parser.parse_args([]))
+
+        assert '--disable-features=First,Second' in args
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+
