+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		enc   Encoding
+		input string
+	}{
+		{
+			name: "YAML",
+			enc:  EncodingYAML,
+			input: `version: "1.4"
+namespace:
+  key: team
+  name: Team
+  description: Team namespace
+flags:
+  - key: nested
+    name: Nested
+    enabled: true
+    metadata:
+      settings:
+        groups:
+          - name: editors
+            permissions: [read, write]
+          - name: viewers
+            permissions: [read]
+      active: true
+    variants:
+      - key: first
+        attachment:
+          nested:
+            - key: value
+`,
+		},
+		{
+			name:  "JSON with header",
+			enc:   EncodingJSON,
+			input: "# exported by Flipt\n" + `{"version":"1.4","namespace":{"key":"team","name":"Team","description":"Team namespace"},"flags":[{"key":"nested","name":"Nested","enabled":true,"metadata":{"settings":{"groups":[{"name":"editors","permissions":["read","write"]},{"name":"viewers","permissions":["read"]}]},"active":true},"variants":[{"key":"first","attachment":{"nested":[{"key":"value"}]}}]}]}`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team", Description: "Team namespace"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{
+				"settings": map[string]any{"groups": []any{
+					map[string]any{"name": "editors", "permissions": []any{"read", "write"}},
+					map[string]any{"name": "viewers", "permissions": []any{"read"}},
+				}},
+				"active": true,
+			}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":[{"key":"value"}]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		"# first\n# second\n{}",
+		" \n# header\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.ErrorContains(t, err, "unmarshalling document")
+	}
+}
