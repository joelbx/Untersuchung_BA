diff --git a/test/units/plugins/connection/test_ssh.py b/test/units/plugins/connection/test_ssh.py
index 0bba41b..f442521 100644
--- a/test/units/plugins/connection/test_ssh.py
+++ b/test/units/plugins/connection/test_ssh.py
@@ -34,6 +34,33 @@ from ansible.plugins.connection import ssh
 from ansible.plugins.loader import connection_loader, become_loader
 
 
+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain stderr\r\n', b'plain stderr\r\n'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">error</S></Objs>', b'error'),
+    (b'before\r\n#< CLIXML\r\n<Objs>\r\n<S S="Error">error</S>\r\n</Objs> after', b'before\r\nerror after'),
+    (b'one\r\nCLIXML\r\n<Objs><S S="Error">error</S></Objs> tail', b'oneerror tail'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">caf\x82</S></Objs>', b'caf\xc3\xa9'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">caf\xc3\xa9</S></Objs>', b'caf\xc3\xa9'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">bad</Objs>', b'#< CLIXML\r\n<Objs><S S="Error">bad</Objs>'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">incomplete</S>', b'#< CLIXML\r\n<Objs><S S="Error">incomplete</S>'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">first</S></Objs>\r\n<Objs><S S="Error">second</S></Objs>', b'first\r\nsecond'),
+    (b'#< CLIXML\r\n<Objs><S S="Error">broken</Objs>\r\n#< CLIXML\r\n<Objs><S S="Error">good</S></Objs>',
+     b'#< CLIXML\r\n<Objs><S S="Error">broken</Objs>\r\ngood'),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_windows_exec_command_replaces_embedded_clixml():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn._shell = MagicMock(_IS_WINDOWS=True)
+    conn._build_command = MagicMock(return_value='ssh command')
+    conn._run = MagicMock(return_value=(1, b'', b'before\r\n#< CLIXML\r\n<Objs><S S="Error">error</S></Objs> after'))
+    conn.get_option = MagicMock(return_value='host')
+
+    assert conn.exec_command('command') == (1, b'', b'before\r\nerror after')
+
+
