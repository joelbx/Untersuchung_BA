+_CLIXML_HEADER = re.compile(rb"(?:#< CLIXML|\r\nCLIXML)\r\n")
+_CLIXML_OPEN = re.compile(rb"<Objs(?:\s|>)")
+_CLIXML_NEWLINES = re.compile(rb"[\r\n]*")
+
+
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML blocks in Windows SSH stderr."""
+    if b"CLIXML" not in stderr:
+        return stderr
+
+    parts: list[bytes] = []
+    cursor = 0
+    for header in _CLIXML_HEADER.finditer(stderr):
+        if header.start() < cursor:
+            continue
+
+        start = header.start()
+        xml_start = header.end()
+        # PowerShell can repeat the header before the first XML element.
+        while stderr.startswith(b"#< CLIXML\r\n", xml_start):
+            xml_start += len(b"#< CLIXML\r\n")
+
+        xml_start = _CLIXML_NEWLINES.match(stderr, xml_start).end()
+        if not _CLIXML_OPEN.match(stderr, xml_start):
+            continue
+
+        end = xml_start
+        while True:
+            close = stderr.find(b"</Objs>", end)
+            if close == -1:
+                end = -1
+                break
+            end = close + len(b"</Objs>")
+            next_start = _CLIXML_NEWLINES.match(stderr, end).end()
+            if not _CLIXML_OPEN.match(stderr, next_start):
+                break
+            end = next_start
+
+        if end == -1:
+            continue
+
+        try:
+            block = stderr[start:end]
+            try:
+                block = block.decode("utf-8").encode("utf-8")
+            except UnicodeDecodeError:
+                block = block.decode("cp437").encode("utf-8")
+            decoded = _parse_clixml(block)
+        except (UnicodeError, ValueError, ET.ParseError):
+            continue
+
+        parts.append(stderr[cursor:start])
+        parts.append(decoded)
+        cursor = end
+
+    if not parts:
+        return stderr
+    parts.append(stderr[cursor:])
+    return b"".join(parts)
+
+
