+++ b/test/units/utils/display/test_display.py
@@ -5,6 +5,10 @@
 from __future__ import absolute_import, division, print_function
 __metaclass__ = type
 
+import os
+import threading
+
+import pytest
 
 from ansible.utils.display import Display
 
@@ -18,3 +22,34 @@ def test_display_basic_message(capsys, mocker):
     out, err = capsys.readouterr()
     assert out == 'Some displayed message\n'
     assert err == ''
+
+
+def test_display_queue_only_in_fork(monkeypatch, mocker):
+    display = Display()
+    queue = mocker.Mock()
+    parent_pid = os.getpid()
+
+    with pytest.raises(RuntimeError):
+        display.set_queue(queue)
+
+    with monkeypatch.context() as fork:
+        fork.setattr('ansible.utils.display.os.getpid', lambda: parent_pid + 1)
+        fork.setattr(display, '_final_q', None)
+        display.set_queue(queue)
+        display.display(u'forked output', color='blue', stderr=True,
+                        screen_only=True, log_only=False, newline=False)
+        queue.send_display.assert_called_once_with(
+            u'forked output', 'blue', True, True, False, False)
+
+
+def test_display_parent_uses_lock(mocker):
+    display = Display()
+    lock = threading.Lock()
+    mocker.patch.object(display, '_lock', lock)
+    render = mocker.patch.object(display, '_display')
+    render.side_effect = lambda *args, **kwargs: lock.locked() or pytest.fail('display lock was not held')
+
+    display.display(u'parent output')
+
+    render.assert_called_once()
+    assert not lock.locked()
