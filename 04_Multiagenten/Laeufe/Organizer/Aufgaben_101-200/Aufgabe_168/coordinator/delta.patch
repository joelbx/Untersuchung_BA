 }
 
+interface IAdminActionLock {
+    pending: boolean;
+    run(action: () => Promise<void>): Promise<void>;
+}
+
+// The ref closes the gap between activation and React rendering the disabled buttons.
+// Keep locks by member so a pending request for a previous panel target cannot lock a new target.
+const useAdminActionLock = (member: RoomMember): IAdminActionLock => {
+    const key = `${member.roomId}\0${member.userId}`;
+    const pendingKeys = useRef(new Set<string>());
+    const [, update] = useState(0);
+
+    return {
+        pending: pendingKeys.current.has(key),
+        run: async (action): Promise<void> => {
+            if (pendingKeys.current.has(key)) return;
+            pendingKeys.current.add(key);
+            update((value) => value + 1);
+            try {
+                await action();
+            } finally {
+                pendingKeys.current.delete(key);
+                update((value) => value + 1);
+            }
+        },
+    };
+};
