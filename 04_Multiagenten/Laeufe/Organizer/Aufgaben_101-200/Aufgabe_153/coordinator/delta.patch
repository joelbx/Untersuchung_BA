diff --git a/packages/drive-store/zustand/share/share.stores.test.ts b/packages/drive-store/zustand/share/share.stores.test.ts
new file mode 100644
index 0000000..9811237
--- /dev/null
+++ b/packages/drive-store/zustand/share/share.stores.test.ts
@@ -0,0 +1,54 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store/_shares';
+import { getExistingEmails } from '../../store/_views/utils/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const invitation = (invitationId: string): ShareInvitation =>
+    ({ invitationId, inviteeEmail: `${invitationId}@example.test` }) as ShareInvitation;
+const externalInvitation = (externalInvitationId: string): ShareExternalInvitation =>
+    ({ externalInvitationId, inviteeEmail: `${externalInvitationId}@example.test` }) as ShareExternalInvitation;
+const member = (memberId: string): ShareMember => ({ memberId, email: `${memberId}@example.test` }) as ShareMember;
+
+describe('share stores', () => {
+    beforeEach(() => {
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+        useMembersStore.setState({ members: {} });
+    });
+
+    it('keeps members isolated and replaces only the selected share', () => {
+        const store = useMembersStore.getState();
+        expect(store.getMembers('missing')).toEqual([]);
+        store.setMembers('a', [member('a1')]);
+        store.setMembers('b', [member('b1')]);
+        store.setMembers('a', [member('a2')]);
+        expect(store.getMembers('a')).toEqual([member('a2')]);
+        expect(store.getMembers('b')).toEqual([member('b1')]);
+    });
+
+    it('keeps internal and external invitations isolated through set, update, add, and remove', () => {
+        const store = useInvitationsStore.getState();
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+        store.setInvitations('a', [invitation('a1')]);
+        store.setInvitations('b', [invitation('b1')]);
+        store.setExternalInvitations('a', [externalInvitation('ea1')]);
+        store.setExternalInvitations('b', [externalInvitation('eb1')]);
+        store.updateInvitationsPermissions('a', [invitation('a2')]);
+        store.updateExternalInvitations('a', [externalInvitation('ea2')]);
+        store.addMultipleInvitations('a', [invitation('a2'), invitation('a3')], [externalInvitation('ea3')]);
+        store.removeInvitations('a', []);
+        store.removeExternalInvitations('a', []);
+        expect(store.getInvitations('a')).toEqual([]);
+        expect(store.getExternalInvitations('a')).toEqual([]);
+        expect(store.getInvitations('b')).toEqual([invitation('b1')]);
+        expect(store.getExternalInvitations('b')).toEqual([externalInvitation('eb1')]);
+    });
+
+    it('combines member and invitation emails', () => {
+        expect(getExistingEmails([member('m')], [invitation('i')], [externalInvitation('e')])).toEqual([
+            'm@example.test',
+            'i@example.test',
+            'e@example.test',
+        ]);
+    });
+});
