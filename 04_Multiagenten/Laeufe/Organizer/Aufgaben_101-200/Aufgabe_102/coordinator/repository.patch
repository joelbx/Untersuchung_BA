+    def get_locally_reachable_ips(self, ip_path):
+        """Return local routes with host scope for each supported IP family."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, option in (('ipv4', '-4'), ('ipv6', '-6')):
+            if family == 'ipv6' and not socket.has_ipv6:
+                self.module.warn('Unable to gather locally reachable ipv6 IPs: IPv6 is unavailable')
+                continue
+
+            command = [ip_path, option, 'route', 'show', 'table', 'local', 'scope', 'host']
+            rc, output, err = self.module.run_command(command, errors='surrogate_then_replace')
+            if rc != 0:
+                self.module.warn('Unable to gather locally reachable %s IPs' % family)
+                continue
+
+            routes = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                try:
+                    route = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if route.version != (4 if family == 'ipv4' else 6):
+                    continue
+                routes.add(route)
+
+            ordered_routes = sorted(routes, key=lambda route: (int(route.network_address), route.prefixlen))
+            reachable[family] = [str(route.network_address) if route.prefixlen == route.max_prefixlen
+                                 else str(route) for route in ordered_routes]
+        return reachable
+
