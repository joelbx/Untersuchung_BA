diff --git a/lib/multiplexer/multiplexer_test.go b/lib/multiplexer/multiplexer_test.go
index 843b37b..f6a9c80 100644
--- a/lib/multiplexer/multiplexer_test.go
+++ b/lib/multiplexer/multiplexer_test.go
@@ -792,3 +792,36 @@ func (noopListener) Close() error {
 func (l noopListener) Addr() net.Addr {
 	return l.addr
 }
+
+func TestTeleportProxyHello(t *testing.T) {
+	for _, tc := range []struct {
+		name, hello, wantAddr string
+	}{
+		{name: "client address", hello: `Teleport-Proxy{"clientAddr":"192.0.2.4:3022"}` + "\x00", wantAddr: "192.0.2.4:3022"},
+		{name: "no client address", hello: `Teleport-Proxy{}` + "\x00", wantAddr: "pipe"},
+		{name: "ordinary SSH", hello: "SSH-2.0-client\r\n", wantAddr: "pipe"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server, client := net.Pipe()
+			defer server.Close()
+			defer client.Close()
+			result := make(chan *Conn, 1)
+			errors := make(chan error, 1)
+			go func() {
+				conn, err := detect(server, false)
+				result <- conn
+				errors <- err
+			}()
+			_, err := io.WriteString(client, tc.hello)
+			require.NoError(t, err)
+			conn := <-result
+			require.NoError(t, <-errors)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			require.Equal(t, tc.wantAddr, conn.RemoteAddr().String())
+			got := make([]byte, len(tc.hello))
+			_, err = io.ReadFull(conn, got)
+			require.NoError(t, err)
+			require.Equal(t, tc.hello, string(got))
+		})
+	}
+}
