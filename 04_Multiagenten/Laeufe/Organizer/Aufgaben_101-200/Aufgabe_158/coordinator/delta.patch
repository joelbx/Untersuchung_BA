+    def _valid_time_stamp(self, timestamp):
+        # ZIP timestamps are limited to 1980 through 2107. Some archives
+        # contain zeroed or otherwise invalid date fields in zipinfo output.
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.fullmatch(r'(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})', timestamp)
+        if match is None:
+            return epoch
+
+        year, month, day, hour, minute, second = (int(component) for component in match.groups())
+        if not 1980 <= year <= 2107:
+            return epoch
+        try:
+            return datetime.datetime(year, month, day, hour, minute, second).timetuple()
+        except ValueError:
+            return epoch
+
