+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name    string
+		config  ProxyConfig
+		want    string
+		wantErr bool
+	}{
+		{name: "disabled", config: ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, wantErr: true},
+		{name: "kubernetes address", config: ProxyConfig{Kube: KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}}}, PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, want: "https://kube.example.com:3026"},
+		{name: "generic address", config: ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, want: "https://proxy.example.com:3026"},
+		{name: "IPv6 address", config: ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "[::1]:3080"}}}, want: "https://[::1]:3026"},
+		{name: "invalid address", config: ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:bad"}}}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.config.KubeAddr()
+			if (err != nil) != tt.wantErr || got != tt.want {
+				t.Fatalf("KubeAddr() = %q, %v; want %q, error=%v", got, err, tt.want, tt.wantErr)
+			}
+		})
+	}
+}
