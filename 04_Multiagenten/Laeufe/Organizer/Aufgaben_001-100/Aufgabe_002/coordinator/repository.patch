+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	var addr utils.NetAddr
+	switch {
+	case len(c.Kube.PublicAddrs) > 0:
+		addr = c.Kube.PublicAddrs[0]
+	case len(c.PublicAddrs) > 0:
+		addr = c.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+
+	// NetAddr.Host accepts malformed host:port values, so validate the source
+	// before using its host in the URL.
+	raw := addr.Addr
+	if raw == "" || strings.ContainsAny(raw, "/?#@ ") {
+		return "", trace.BadParameter("invalid proxy public address %q", raw)
+	}
+	if strings.Contains(raw, ":") && net.ParseIP(raw) == nil {
+		if strings.HasPrefix(raw, "[") && strings.HasSuffix(raw, "]") {
+			if net.ParseIP(strings.Trim(raw, "[]")) == nil {
+				return "", trace.BadParameter("invalid proxy public address %q", raw)
+			}
+		} else {
+			host, port, err := net.SplitHostPort(raw)
+			if err != nil || host == "" {
+				return "", trace.BadParameter("invalid proxy public address %q", raw)
+			}
+			portNumber, err := strconv.Atoi(port)
+			if err != nil || portNumber < 1 || portNumber > 65535 {
+				return "", trace.BadParameter("invalid proxy public address %q", raw)
+			}
+		}
+	}
+	host := addr.Host()
+	if host == "" || strings.ContainsAny(host, "[]:") && net.ParseIP(host) == nil {
+		return "", trace.BadParameter("invalid proxy public address %q", raw)
+	}
+	return (&url.URL{Scheme: "https", Host: net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+}
