+func TestStringToSliceHook(t *testing.T) {
+	hook := stringToSliceHookFunc()
+	stringType := reflect.TypeOf("")
+	sliceType := reflect.TypeOf([]string{})
+
+	tests := []struct {
+		name string
+		from reflect.Type
+		to   reflect.Type
+		data interface{}
+		want interface{}
+	}{
+		{"whitespace", stringType, sliceType, " \tfoo.com  bar.com\n baz.com \r\n", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", stringType, sliceType, "", []string{}},
+		{"only whitespace", stringType, sliceType, " \t\n ", []string{}},
+		{"sequence", sliceType, sliceType, []string{"foo.com", "bar.com"}, []string{"foo.com", "bar.com"}},
+		{"other target", stringType, reflect.TypeOf([]int{}), "1 2", "1 2"},
+		{"other source", reflect.TypeOf(0), sliceType, 42, 42},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(tt.from, tt.to, tt.data)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadEmptyAllowedOrigins(t *testing.T) {
+	t.Run("YAML", func(t *testing.T) {
+		path := t.TempDir() + "/config.yml"
+		require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: \"\"\n"), 0600))
+
+		cfg, err := Load(path)
+		require.NoError(t, err)
+		assert.Equal(t, []string{}, cfg.Cors.AllowedOrigins)
+	})
+
+	t.Run("ENV", func(t *testing.T) {
+		t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", "")
+		cfg, err := Load("./testdata/default.yml")
+		require.NoError(t, err)
+		assert.Equal(t, []string{}, cfg.Cors.AllowedOrigins)
+	})
+}
+
+func TestLoadWhitespaceAllowedOriginsFromEnv(t *testing.T) {
+	t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", " \tfoo.com  bar.com\n baz.com ")
+	cfg, err := Load("./testdata/default.yml")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"foo.com", "bar.com", "baz.com"}, cfg.Cors.AllowedOrigins)
+}
