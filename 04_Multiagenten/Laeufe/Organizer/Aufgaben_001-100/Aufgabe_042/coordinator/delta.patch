diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..08c9a6e
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,65 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+const request = require('request-promise-native');
+
+require('./mocks/databasemock');
+
+const privileges = require('../src/privileges');
+const user = require('../src/user');
+
+describe('WebFinger', () => {
+	let uid;
+	let userslug;
+	let resource;
+
+	before(async () => {
+		uid = await user.create({ username: 'webfinger-user', password: 'password' });
+		userslug = await user.getUserField(uid, 'userslug');
+		resource = `acct:${userslug}@${nconf.get('url_parsed').hostname}`;
+	});
+
+	async function getWebfinger(value) {
+		return await request({
+			url: `${nconf.get('url')}/.well-known/webfinger`,
+			qs: value === undefined ? {} : { resource: value },
+			json: true,
+			simple: false,
+			resolveWithFullResponse: true,
+		});
+	}
+
+	it('returns a JRD with UID and profile aliases for a guest', async () => {
+		const response = await getWebfinger(resource);
+		const profileUrl = `${nconf.get('url')}/user/${userslug}`;
+		assert.strictEqual(response.statusCode, 200);
+		assert.match(response.headers['content-type'], /application\/jrd\+json/);
+		assert.strictEqual(response.body.subject, resource);
+		assert.deepStrictEqual(response.body.aliases, [`${nconf.get('url')}/uid/${uid}`, profileUrl]);
+		assert(response.body.links.some(link => link.href === profileUrl && link.type === 'text/html'));
+	});
+
+	it('rejects missing and invalid resources', async () => {
+		for (const value of [undefined, `user@${nconf.get('url_parsed').hostname}`, 'acct:webfinger-user@other.example', `acct:a@b@${nconf.get('url_parsed').hostname}`]) {
+			// eslint-disable-next-line no-await-in-loop
+			const response = await getWebfinger(value);
+			assert.strictEqual(response.statusCode, 400);
+		}
+	});
+
+	it('returns 404 for an unknown user', async () => {
+		const response = await getWebfinger(`acct:no-such-webfinger-user@${nconf.get('url_parsed').hostname}`);
+		assert.strictEqual(response.statusCode, 404);
+	});
+
+	it('uses Guest privileges for anonymous requests', async () => {
+		await privileges.global.rescind(['groups:view:users'], 'guests');
+		try {
+			const response = await getWebfinger(resource);
+			assert.strictEqual(response.statusCode, 403);
+		} finally {
+			await privileges.global.give(['groups:view:users'], 'guests');
+		}
+	});
+});
