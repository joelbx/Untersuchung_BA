+import punycode from 'punycode.js';
+
 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
 
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(/^(?:(?:[a-z][a-z\d+.-]*:)?\/\/)?(?:www\.)?([^./:?#]+)/i);
+    return match?.[1] || '';
+};
+
+export const punycodeUrl = (url: string): string => {
+    const match = url.match(/^((?:[a-z][a-z\d+.-]*:)?\/\/)([^/?#]+)([^?#]*)(\?[^#]*)?(#.*)?$/i);
+    if (!match) {
+        return url;
+    }
+
+    const [, protocol, authority, pathname, search = '', hash = ''] = match;
+    const userInfoEnd = authority.lastIndexOf('@') + 1;
+    const userInfo = authority.slice(0, userInfoEnd);
+    const hostAndPort = authority.slice(userInfoEnd);
+    // Bracketed IPv6 addresses are already ASCII and their colons are not port separators.
+    const hostnameEnd = hostAndPort.startsWith('[') ? hostAndPort.indexOf(']') + 1 : hostAndPort.lastIndexOf(':');
+    const hostname = hostnameEnd > 0 ? hostAndPort.slice(0, hostnameEnd) : hostAndPort;
+    const port = hostnameEnd > 0 ? hostAndPort.slice(hostnameEnd) : '';
+
+    const asciiHostname = hostname.startsWith('[') ? hostname : punycode.toASCII(hostname);
+    return `${protocol}${userInfo}${asciiHostname}${port}${pathname.replace(/\/$/, '')}${search}${hash}`;
+};
