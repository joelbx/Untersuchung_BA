+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,50 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	It("isolates properties by contextual user and supports updates and deletion", func() {
+		base := log.NewContext(context.Background())
+		o := orm.NewOrm()
+		for _, id := range []string{"props-user-one", "props-user-two"} {
+			_, err := o.Raw("insert into user (id, user_name, created_at, updated_at) values (?, ?, current_timestamp, current_timestamp)", id, id).Exec()
+			Expect(err).To(Succeed())
+		}
+		defer func() {
+			for _, id := range []string{"props-user-one", "props-user-two"} {
+				_, _ = o.Raw("delete from user where id = ?", id).Exec()
+			}
+		}()
+		one := NewUserPropsRepository(request.WithUser(base, model.User{ID: "props-user-one"}), o)
+		two := NewUserPropsRepository(request.WithUser(base, model.User{ID: "props-user-two"}), o)
+
+		Expect(one.Put("test-key", "one")).To(Succeed())
+		Expect(two.Put("test-key", "two")).To(Succeed())
+		Expect(one.Get("test-key")).To(Equal("one"))
+		Expect(two.Get("test-key")).To(Equal("two"))
+		Expect(one.Put("test-key", "updated")).To(Succeed())
+		Expect(one.Get("test-key")).To(Equal("updated"))
+		Expect(one.Delete("test-key")).To(Succeed())
+		_, err := one.Get("test-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(two.Get("test-key")).To(Equal("two"))
+		Expect(two.Delete("test-key")).To(Succeed())
+	})
+
+	It("rejects operations without a contextual user", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("key", "value")).To(HaveOccurred())
+		_, err := repo.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(repo.Delete("key")).To(HaveOccurred())
+	})
+})
