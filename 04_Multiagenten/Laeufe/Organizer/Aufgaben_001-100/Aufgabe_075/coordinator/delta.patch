+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props (
+    user_id varchar(255) not null references user (id) on update cascade on delete cascade,
+    key varchar(255) not null,
+    value varchar not null,
+    primary key (user_id, key)
+);
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from property p join user u on p.id = 'LastFMSessionKey_' || u.id;
+delete from property
+where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_';
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec("drop table user_props")
+	return err
+}
diff --git a/db/migration/20210619231717_create_user_props_table_test.go b/db/migration/20210619231717_create_user_props_table_test.go
new file mode 100644
index 0000000..01db243
--- /dev/null
+++ b/db/migration/20210619231717_create_user_props_table_test.go
@@ -0,0 +1,64 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMovesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	_, err = db.Exec(`
+create table user (id varchar(255) primary key);
+create table property (id varchar(255) primary key, value varchar not null);
+insert into user (id) values ('user-1'), ('user-2');
+insert into property (id, value) values
+  ('LastFMSessionKey_user-1', 'session-1'),
+  ('LastFMSessionKey_user-2', 'session-2'),
+  ('LastFMSessionKey_removed-user', 'stale'),
+  ('Unrelated', 'keep');
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err = tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, tc := range []struct{ userID, want string }{{"user-1", "session-1"}, {"user-2", "session-2"}} {
+		var got string
+		if err := db.QueryRow("select value from user_props where user_id = ? and key = ?", tc.userID, "LastFMSessionKey").Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != tc.want {
+			t.Fatalf("session for %s: got %q, want %q", tc.userID, got, tc.want)
+		}
+	}
+	var remaining int
+	if err := db.QueryRow("select count(*) from property where id like 'LastFMSessionKey_%'").Scan(&remaining); err != nil {
+		t.Fatal(err)
+	}
+	if remaining != 0 {
+		t.Fatalf("%d migrated properties remain in global table", remaining)
+	}
+	if err := db.QueryRow("select count(*) from property where id = 'Unrelated'").Scan(&remaining); err != nil {
+		t.Fatal(err)
+	}
+	if remaining != 1 {
+		t.Fatal("unrelated property was removed")
+	}
+}
