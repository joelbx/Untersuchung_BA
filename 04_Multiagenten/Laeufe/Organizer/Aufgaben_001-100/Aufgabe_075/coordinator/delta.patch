diff --git a/tests/mock_user_props_repo.go b/tests/mock_user_props_repo.go
new file mode 100644
index 0000000..fe383f4
--- /dev/null
+++ b/tests/mock_user_props_repo.go
@@ -0,0 +1,68 @@
+package tests
+
+import (
+	"context"
+	"errors"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type mockUserPropKey struct{ userID, key string }
+
+type MockedUserPropsRepo struct {
+	data map[mockUserPropKey]string
+}
+
+type contextualUserPropsRepo struct {
+	owner *MockedUserPropsRepo
+	ctx   context.Context
+}
+
+func (r *MockedUserPropsRepo) ForContext(ctx context.Context) model.UserPropsRepository {
+	return &contextualUserPropsRepo{owner: r, ctx: ctx}
+}
+
+func (r *contextualUserPropsRepo) propKey(key string) (mockUserPropKey, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return mockUserPropKey{}, errors.New("user not found in context")
+	}
+	return mockUserPropKey{u.ID, key}, nil
+}
+
+func (r *contextualUserPropsRepo) Put(key, value string) error {
+	k, err := r.propKey(key)
+	if err != nil {
+		return err
+	}
+	if r.owner.data == nil {
+		r.owner.data = make(map[mockUserPropKey]string)
+	}
+	r.owner.data[k] = value
+	return nil
+}
+
+func (r *contextualUserPropsRepo) Get(key string) (string, error) {
+	k, err := r.propKey(key)
+	if err != nil {
+		return "", err
+	}
+	v, ok := r.owner.data[k]
+	if !ok {
+		return "", model.ErrNotFound
+	}
+	return v, nil
+}
+
+func (r *contextualUserPropsRepo) Delete(key string) error {
+	k, err := r.propKey(key)
+	if err != nil {
+		return err
+	}
+	if _, ok := r.owner.data[k]; !ok {
+		return model.ErrNotFound
+	}
+	delete(r.owner.data, k)
+	return nil
+}
