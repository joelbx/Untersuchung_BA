+
+
+@pytest.mark.parametrize('filter_name, filter_func', [('to_yaml', to_yaml), ('to_nice_yaml', to_nice_yaml)])
+def test_yaml_filters_undefined(filter_name, filter_func):
+    with pytest.raises(AnsibleFilterError) as result:
+        filter_func({'environment': AnsibleUndefined(name='MYSVC_ENV')})
+    assert filter_name in to_native(result.value)
+    assert 'MYSVC_ENV' in to_native(result.value)
+    assert isinstance(result.value.__cause__, UndefinedError)
+
+
+@pytest.mark.parametrize('filter_name, filter_func', [('to_yaml', to_yaml), ('to_nice_yaml', to_nice_yaml)])
+def test_yaml_filters_other_dump_failure(filter_name, filter_func):
+    with pytest.raises(AnsibleFilterError) as result:
+        filter_func(object())
+    assert filter_name in to_native(result.value)
+    assert isinstance(result.value.__cause__, yaml.representer.RepresenterError)
+
+
+@pytest.mark.parametrize('filter_name', ['to_yaml', 'to_nice_yaml'])
+def test_yaml_filters_templating_undefined(filter_name):
+    templar = Templar(loader=DataLoader(), variables={})
+    with pytest.raises(AnsibleFilterError) as result:
+        templar.template('{{ MYSVC_ENV | %s }}' % filter_name)
+    assert filter_name in to_native(result.value)
+    assert 'MYSVC_ENV' in to_native(result.value)
+    assert isinstance(result.value.__cause__, UndefinedError)
