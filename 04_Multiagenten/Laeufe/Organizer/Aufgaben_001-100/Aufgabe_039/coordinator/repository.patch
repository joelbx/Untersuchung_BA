+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        db = get_db()
+        db.query("""
+            CREATE TABLE booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL,
+                notes text NOT NULL,
+                PRIMARY KEY (username, work_id, edition_id)
+            )
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.insert("booknotes", username="alice", work_id=1, edition_id=1, notes="first")
+        self.db.insert("booknotes", username="alice", work_id=1, edition_id=2, notes="second")
+
+    def teardown_method(self):
+        self.db.delete("booknotes", where="1=1")
+
+    def rows(self):
+        return [dict(row) for row in self.db.select("booknotes", order="username, work_id, edition_id")]
+
+    def test_conflict_preserves_every_record(self):
+        self.db.insert("booknotes", username="alice", work_id=2, edition_id=1, notes="existing")
+        before = self.rows()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.rows() == before
+
+    def test_existing_target_work_preserves_every_record(self):
+        self.db.insert("booknotes", username="bob", work_id=2, edition_id=3, notes="existing")
+        before = self.rows()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.rows() == before
+
+    def test_success_and_dry_run(self):
+        before = self.rows()
+        assert Booknotes.update_work_id(1, 2, _test=True) == {
+            "rows_changed": 2, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert self.rows() == before
+
+        assert Booknotes.update_work_id(1, 2) == {
+            "rows_changed": 2, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert [row["work_id"] for row in self.rows()] == [2, 2]
+
+    def test_same_work_id_is_a_no_op(self):
+        before = self.rows()
+
+        assert Booknotes.update_work_id(1, 1) == {
+            "rows_changed": 0, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert self.rows() == before
