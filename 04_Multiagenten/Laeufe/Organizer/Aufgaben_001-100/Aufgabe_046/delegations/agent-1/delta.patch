+def recursive_finder(name, module_fqn, data, py_module_names, py_module_cache, zf):
+    """Add the module's module_utils dependency closure to the payload."""
+    module_utils_paths = [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)]
+    module_utils_paths.append(_MODULE_UTILS_PATH)
+    pending = deque([(name, module_fqn, data)])
+    queued = set(py_module_names)
 
+    def add_module(module_name, source, path):
+        if module_name in queued:
+            return
+        queued.add(module_name)
+        py_module_cache[module_name] = (source, path)
+        py_module_names.add(module_name)
+        zf.writestr(os.path.join(*module_name) + '.py', source)
+        display.vvvvv('Using module_utils file %s' % to_text(path, errors='surrogate_or_strict'))
+        pending.append((module_name[-1], '.'.join(module_name), source))
+
+    def add_parents(module_name):
+        # The caller normally supplies the ansible base packages.  Collection
+        # namespaces and missing package files need synthetic initializers.
+        for length in range(1, len(module_name)):
+            parent = module_name[:length]
+            init_name = parent + ('__init__',)
+            if init_name in queued:
+                continue
+            if parent == ('ansible',):
+                source = (b'from pkgutil import extend_path\n'
+                          b'__path__=extend_path(__path__,__name__)\n'
+                          b'__version__="' + to_bytes(__version__) +
+                          b'"\n__author__="' + to_bytes(__author__) + b'"\n')
+            elif parent == ('ansible', 'module_utils'):
+                source = b'from pkgutil import extend_path\n__path__=extend_path(__path__,__name__)\n'
+            elif parent[:2] == ('ansible', 'module_utils') and length > 2:
+                relative = parent[2:]
+                paths = [os.path.join(p, *relative[:-1]) for p in module_utils_paths]
+                try:
+                    info = ModuleInfo(relative[-1], paths)
+                    source = info.get_source() if info.pkg_dir else b''
+                except ImportError:
+                    source = b''
+            elif parent[0] == 'ansible_collections' and length >= 6:
+                try:
+                    info = CollectionModuleInfo(parent[-1], '.'.join(parent[:-1]))
+                    source = info.get_source() if info.pkg_dir else b''
+                except ImportError:
+                    source = b''
+            else:
+                source = b''
+            add_module(init_name, source, os.path.join(*init_name) + '.py')
+
+    # The wrapper always imports basic to inject the module arguments.
+    basic = ('ansible', 'module_utils', 'basic')
+    if basic not in queued:
+        info = ModuleInfo('basic', module_utils_paths)
+        add_parents(basic)
+        add_module(basic, info.get_source(), info.path)
+
+    while pending:
+        current_name, current_fqn, source = pending.popleft()
+        try:
+            tree = compile(source, '<unknown>', 'exec', ast.PyCF_ONLY_AST)
+        except (SyntaxError, IndentationError) as exc:
+            raise AnsibleError('Unable to import %s due to %s' % (current_name, exc.msg))
+        finder = ModuleDepFinder(current_fqn)
+        finder.visit(tree)
+        for requested in sorted(finder.submodules):
+            if requested[:3] == ('ansible', 'module_utils', 'six'):
+                requested = ('ansible', 'module_utils', 'six')
+            elif requested[:3] == ('ansible', 'module_utils', '_six') or requested == ('_six',):
+                requested = ('ansible', 'module_utils', 'six', '_six')
+            if requested in queued or requested + ('__init__',) in queued:
+                continue
+            if requested[:2] == ('ansible', 'module_utils'):
+                if requested == ('ansible', 'module_utils', 'six', '_six'):
+                    info = ModuleInfo('_six', [os.path.join(p, 'six') for p in module_utils_paths])
+                    resolved = requested
+                else:
+                    resolved, info = LegacyModuleUtilLocator(requested, module_utils_paths).locate()
+            elif requested[0] == 'ansible_collections':
+                resolved, info = CollectionModuleUtilLocator(requested).locate()
+            else:
+                display.warning('ModuleDepFinder improperly found a non-module_utils import %s' % (requested,))
+                continue
+            if info is None:
+                choices = ('either %s.py or %s.py' % (requested[-1], requested[-2])
+                           if len(requested) > (5 if requested[0] == 'ansible_collections' else 2)
+                           else requested[-1])
+                message = 'Could not find imported module support code for %s.  Looked for %s' % (current_name, choices)
+                if requested[0] == 'ansible_collections':
+                    message += ' (unable to load collection-hosted module_util %s)' % '.'.join(requested)
+                raise AnsibleError(message)
+            if not info.pkg_dir and not info.py_src:
+                raise AnsibleError('Could not find python source for imported module support code for %s.  Looked for %s'
+                                   % (current_name, resolved[-1]))
+            add_parents(resolved)
+            normalized = resolved + ('__init__',) if info.pkg_dir else resolved
+            add_module(normalized, info.get_source(), info.path if hasattr(info, 'path') else os.path.join(*normalized) + '.py')
