+func TestContextReader_PasswordDeadline(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+	cr := NewContextReader(pr)
+	term := &fakeTerm{reader: pr}
+	cr.term = term
+	cr.fd = 1
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+	defer cancel()
+	got, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, got)
+	require.True(t, term.restoreCalled)
+
+	go func() { _, _ = pw.Write([]byte("next")) }()
+	got, err = cr.ReadContext(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, "next", string(got))
+	require.NoError(t, cr.Close())
+}
+
+func TestContextReader_CloseRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+	cr := NewContextReader(pr)
+	term := &fakeTerm{reader: pr}
+	cr.term = term
+	cr.fd = 1
+	require.NoError(t, cr.firePasswordRead())
+	require.NoError(t, cr.Close())
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+}
+
+func TestContextReader_CloseReturnsRestoreError(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+	cr := NewContextReader(pr)
+	wantErr := io.ErrClosedPipe
+	cr.term = &fakeTerm{reader: pr, restoreErr: wantErr}
+	cr.fd = 1
+	require.NoError(t, cr.firePasswordRead())
+	require.ErrorIs(t, cr.Close(), wantErr)
+	require.Equal(t, readerStateClosed, cr.state)
+}
+
+func TestNotifyExitRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+	cr := NewContextReader(pr)
+	term := &fakeTerm{reader: pr}
+	cr.term = term
+	cr.fd = 1
+	require.NoError(t, cr.firePasswordRead())
+	oldStdin := Stdin()
+	SetStdin(cr)
+	t.Cleanup(func() { SetStdin(oldStdin) })
+	NotifyExit()
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+}
