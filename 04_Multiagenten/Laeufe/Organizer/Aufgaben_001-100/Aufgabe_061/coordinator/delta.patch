+// pkgPs associates running processes with packages owning their executable or mapped files.
+func (l *base) pkgPs(getOwnerPkgs func([]string) ([]string, error)) error {
+	stdout, err := l.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+	pidNames := l.parsePs(stdout)
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = l.lsOfListen()
+	if err != nil {
+		l.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range l.parseLsOf(stdout) {
+		port, err := models.NewPortStat(ipPort)
+		if err != nil {
+			l.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+			continue
+		}
+		for _, pid := range pids {
+			pidListenPorts[pid] = append(pidListenPorts[pid], *port)
+		}
+	}
+
+	for pid, name := range pidNames {
+		stdout, err := l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		exe, err := l.parseLsProcExe(stdout)
+		if err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		paths := []string{exe}
+		stdout, err = l.grepProcMap(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/maps: %s", pid, err)
+		} else {
+			paths = append(paths, l.parseGrepProcMap(stdout)...)
+		}
+		owners, err := getOwnerPkgs(paths)
+		if err != nil {
+			l.log.Debugf("Failed to get package owners for pid %s: %s", pid, err)
+			continue
+		}
+		proc := models.AffectedProcess{PID: pid, Name: name, ListenPortStats: pidListenPorts[pid]}
+		seen := map[string]bool{}
+		for _, owner := range owners {
+			if seen[owner] {
+				continue
+			}
+			seen[owner] = true
+			pack, ok := l.Packages[owner]
+			if !ok {
+				l.log.Debugf("Package owning process file is not installed: %s", owner)
+				continue
+			}
+			pack.AffectedProcs = append(pack.AffectedProcs, proc)
+			l.Packages[owner] = pack
+		}
+	}
+	return nil
+}
