+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	stdout := `libgcc 0 4.8.5 39.el7 i686
+error: file /private/lib.so: Permission denied
+libgcc 0 4.8.5 44.el7 x86_64
+file /missing: is not owned by any package
+error: file /gone: No such file or directory`
+	names, err := r.parseOwnerPkgs(stdout)
+	if err != nil {
+		t.Fatalf("parseOwnerPkgs returned an error: %v", err)
+	}
+	if want := []string{"libgcc", "libgcc"}; !reflect.DeepEqual(names, want) {
+		t.Fatalf("owners = %v, want %v", names, want)
+	}
+	if _, err := r.parseOwnerPkgs(stdout + "\nunrecognized rpm output"); err == nil {
+		t.Fatal("expected an error for an unrecognized line")
+	}
+	if _, err := r.parseOwnerPkgs("invalid epoch version release arch"); err == nil {
+		t.Fatal("expected an error for an invalid RPM epoch")
+	}
+}
