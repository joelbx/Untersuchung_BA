+@pytest.mark.parametrize('resource_type, expect_accept_language', [
+    (QWebEngineUrlRequestInfo.ResourceType.ResourceTypeXhr, False),
+    (QWebEngineUrlRequestInfo.ResourceType.ResourceTypeMainFrame, True),
+])
+def test_accept_language_for_xhr(config_stub, mocker, resource_type,
+                                 expect_accept_language):
+    config_stub.val.content.headers.accept_language = 'global-language'
+    info = mocker.Mock(spec=QWebEngineUrlRequestInfo)
+    info.requestUrl.return_value = QUrl('https://example.com/')
+    info.firstPartyUrl.return_value = QUrl('https://example.com/')
+    info.resourceType.return_value = resource_type
+    mocker.patch.object(interceptor.interceptors, 'run')
+    mocker.patch.object(interceptor.websettings, 'user_agent',
+                        return_value='test-agent')
+
+    interceptor.RequestInterceptor().interceptRequest(info)
+
+    accept_language_calls = [call for call in info.setHttpHeader.call_args_list
+                             if call.args[0] == b'Accept-Language']
+    assert bool(accept_language_calls) == expect_accept_language
+    if expect_accept_language:
+        assert accept_language_calls[0].args[1] == b'global-language'
+
+
