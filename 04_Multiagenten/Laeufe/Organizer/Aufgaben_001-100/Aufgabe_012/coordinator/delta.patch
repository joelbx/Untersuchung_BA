+def test_custom_headers_accept_language_fallback(config_stub):
+    config_stub.val.content.headers.accept_language = 'global-language'
+    url = QUrl('https://example.com/')
+    other_url = QUrl('https://other.example/')
+    header = (b'Accept-Language', b'global-language')
+
+    assert header in shared.custom_headers(url=url)
+    assert header in shared.custom_headers(
+        url=url, fallback_accept_language=True)
+    assert header in shared.custom_headers(
+        url=None, fallback_accept_language=False)
+    assert not any(name == b'Accept-Language' for name, _ in
+                   shared.custom_headers(
+                       url=url, fallback_accept_language=False))
+
+    config_stub.set_obj('content.headers.accept_language', 'domain-language',
+                        pattern=urlmatch.UrlPattern('https://example.com/*'))
+    domain_header = (b'Accept-Language', b'domain-language')
+    assert domain_header in shared.custom_headers(
+        url=url, fallback_accept_language=False)
+    assert not any(name == b'Accept-Language' for name, _ in
+                   shared.custom_headers(url=other_url,
+                                         fallback_accept_language=False))
+
