+package authz
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestFormatNamespaces(t *testing.T) {
+	for _, input := range []any{nil, true, "local", []any{"local", 1}} {
+		_, err := FormatNamespaces(input)
+		require.Error(t, err)
+	}
+	got, err := FormatNamespaces([]any{})
+	require.NoError(t, err)
+	require.Empty(t, got)
+	got, err = FormatNamespaces([]any{"local", "staging"})
+	require.NoError(t, err)
+	require.Equal(t, []string{"local", "staging"}, got)
+}
