+++ b/openlibrary/catalog/utils/__init__.py
@@ -454,11 +454,62 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     if not languages:
         return []
 
+    from openlibrary.plugins.upstream.utils import (
+        LanguageMultipleMatchError,
+        LanguageNoMatchError,
+        get_abbrev_from_full_lang_name,
+        get_marc21_language,
+    )
+
     formatted_languages = []
+    seen = set()
+    language_records = None
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
+        token = language.strip().casefold()
+        code = (
+            token
+            if len(token) == 3 and web.ctx.site.get(f'/languages/{token}')
+            else None
+        )
 
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        if code is None and len(token) == 2:
+            if language_records is None:
+                keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+                language_records = web.ctx.site.get_many(keys)
+            matches = {
+                record.code
+                for record in language_records
+                if token in (record.get('identifiers', {}) or {}).get(
+                    'iso_639_1', []
+                )
+            }
+            if len(matches) == 1:
+                code = matches.pop()
+            elif len(matches) > 1:
+                raise InvalidLanguage(token)
+
+        if code is None:
+            mapped = get_marc21_language(token)
+            if mapped and web.ctx.site.get(f'/languages/{mapped}'):
+                code = mapped
+
+        if code is None:
+            if language_records is None:
+                keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+                language_records = web.ctx.site.get_many(keys)
+            try:
+                code = get_abbrev_from_full_lang_name(
+                    token, languages=language_records
+                )
+            except (LanguageNoMatchError, LanguageMultipleMatchError):
+                raise InvalidLanguage(token) from None
+
+        key = f'/languages/{code}'
+        if web.ctx.site.get(key) is None:
+            raise InvalidLanguage(token)
+
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
