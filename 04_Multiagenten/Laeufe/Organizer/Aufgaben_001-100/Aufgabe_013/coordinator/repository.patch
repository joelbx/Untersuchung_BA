@@ -8,6 +8,7 @@ __metaclass__ = type
 import datetime
 import json
 import os
+import re
 import textwrap
 import traceback
 import yaml
@@ -71,6 +72,33 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    _TTY_MACRO = re.compile(r'(?<!\w)(?:(?P<kind>[IBMUCRL])\((?P<body>[^()]+)\)|(?P<rule>HORIZONTALLINE))(?!\w)')
+
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            if match.group('rule'):
+                return '\n-------------\n'
+
+            kind = match.group('kind')
+            body = match.group('body')
+            if kind in ('L', 'R'):
+                if ',' not in body:
+                    return match.group(0)
+                label, target = body.split(',', 1)
+                if kind == 'R':
+                    return label
+                return '%s <%s>' % (label, target.lstrip(' '))
+            if kind == 'B':
+                return '*%s*' % body
+            if kind == 'M':
+                return '[%s]' % body
+            if kind == 'U':
+                return body
+            return "`%s'" % body
+
+        return cls._TTY_MACRO.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
