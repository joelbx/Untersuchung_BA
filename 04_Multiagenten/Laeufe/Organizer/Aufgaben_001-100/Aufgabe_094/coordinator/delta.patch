+//go:build !touchid
+// +build !touchid
+
+package touchid_test
+
+import (
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/touchid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDiagWithoutCompileSupport(t *testing.T) {
+	result, err := touchid.Diag()
+	require.NoError(t, err)
+	require.False(t, result.HasCompileSupport)
+	require.False(t, result.HasSignature)
+	require.False(t, result.HasEntitlements)
+	require.False(t, result.PassedLAPolicyTest)
+	require.False(t, result.PassedSecureEnclaveTest)
+	require.False(t, result.IsAvailable)
+}
