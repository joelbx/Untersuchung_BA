diff --git a/internal/info/flipt.go b/internal/info/flipt.go
new file mode 100644
index 0000000..534c7a6
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,35 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Version is the version of the running Flipt binary. The main package sets it
+// from its release metadata before starting background services.
+var Version = "dev"
+
+// Flipt describes the running server's build and update status.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the Flipt metadata as JSON.
+func (f Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(f)
+	if err != nil {
+		http.Error(w, "encoding server info", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := w.Write(out); err != nil {
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..14b6c16
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,191 @@
+// Package telemetry reports anonymous installation usage.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	endpoint      = "https://telemetry.flipt.io/v1/track"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter sends a periodic anonymous ping and persists its last successful report.
+type Reporter struct {
+	mu       sync.Mutex
+	state    state
+	path     string
+	client   *http.Client
+	endpoint string
+	logger   logrus.FieldLogger
+}
+
+// NewReporter initializes persistent telemetry state. Disabled telemetry never
+// touches the filesystem.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding telemetry state directory: %w", err)
+		}
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+	path := filepath.Join(dir, "telemetry.json")
+	s := state{Version: schemaVersion, LastTimestamp: time.Time{}.UTC().Format(time.RFC3339)}
+	data, err := os.ReadFile(path)
+	if err == nil {
+		if err = json.Unmarshal(data, &s); err != nil {
+			logger.Warnf("reading telemetry state: %v", err)
+			s = state{Version: schemaVersion, LastTimestamp: time.Time{}.UTC().Format(time.RFC3339)}
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if _, err := uuid.FromString(s.UUID); err != nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry identifier: %w", err)
+		}
+		s.UUID = id.String()
+	}
+	s.Version = schemaVersion
+	if _, err := time.Parse(time.RFC3339, s.LastTimestamp); err != nil {
+		s.LastTimestamp = time.Time{}.UTC().Format(time.RFC3339)
+	}
+	r := &Reporter{state: s, path: path, client: &http.Client{Timeout: 10 * time.Second}, endpoint: endpoint, logger: logger}
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	f, err := os.CreateTemp(filepath.Dir(r.path), ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	defer os.Remove(f.Name())
+	defer f.Close()
+	if err := f.Chmod(0600); err != nil {
+		return fmt.Errorf("setting telemetry state permissions: %w", err)
+	}
+	if _, err := f.Write(data); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(f.Name(), r.path); err != nil {
+		return fmt.Errorf("replacing telemetry state: %w", err)
+	}
+	return nil
+}
+
+// Start begins reporting in the background until ctx is canceled.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			wait := time.Until(last.Add(interval))
+			if wait > 0 {
+				timer := time.NewTimer(wait)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if err := r.Report(ctx); err != nil {
+				r.logger.Warnf("reporting telemetry: %v", err)
+				select {
+				case <-ctx.Done():
+					return
+				case <-time.After(interval):
+				}
+			}
+		}
+	}()
+}
+
+// Report sends one anonymous usage event and records its successful delivery.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	event := struct {
+		Event       string            `json:"event"`
+		AnonymousID string            `json:"anonymousId"`
+		Properties  map[string]string `json:"properties"`
+	}{
+		Event:       "flipt.ping",
+		AnonymousID: r.state.UUID,
+		Properties: map[string]string{
+			"uuid":          r.state.UUID,
+			"version":       schemaVersion,
+			"flipt.version": info.Version,
+		},
+	}
+	data, err := json.Marshal(event)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	return r.save()
+}
diff --git a/telemetry/telemetry_test.go b/telemetry/telemetry_test.go
new file mode 100644
index 0000000..8933c8f
--- /dev/null
+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,131 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+func TestReporter(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = filepath.Join(dir, "new")
+	logger := logrus.New()
+	r, err := NewReporter(cfg, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	initial := readState(t, r.path)
+	if _, err := time.Parse(time.RFC3339, initial.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+	if initial.UUID == "" || initial.Version != schemaVersion {
+		t.Fatalf("invalid initial state: %+v", initial)
+	}
+
+	oldVersion := info.Version
+	info.Version = "test-version"
+	defer func() { info.Version = oldVersion }()
+	requests := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		requests++
+		var event struct {
+			Event       string            `json:"event"`
+			AnonymousID string            `json:"anonymousId"`
+			Properties  map[string]string `json:"properties"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&event); err != nil {
+			t.Error(err)
+		}
+		if event.Event != "flipt.ping" || event.AnonymousID != initial.UUID || event.Properties["uuid"] != initial.UUID || event.Properties["version"] != schemaVersion || event.Properties["flipt.version"] != "test-version" {
+			t.Errorf("unexpected event: %+v", event)
+		}
+		if requests == 1 {
+			w.WriteHeader(http.StatusInternalServerError)
+		}
+	}))
+	defer srv.Close()
+	r.endpoint = srv.URL
+	if err := r.Report(context.Background()); err == nil {
+		t.Fatal("expected failed report")
+	}
+	if got := readState(t, r.path).LastTimestamp; got != initial.LastTimestamp {
+		t.Fatalf("timestamp changed after failure: %q", got)
+	}
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if got := readState(t, r.path).LastTimestamp; got == initial.LastTimestamp {
+		t.Fatal("timestamp was not updated")
+	}
+	r2, err := NewReporter(cfg, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r2.state.UUID != initial.UUID {
+		t.Fatal("identifier changed on restart")
+	}
+}
+
+func TestReporterDisabledAndInvalidDirectory(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = filepath.Join(dir, "state")
+	cfg.Meta.TelemetryEnabled = false
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter: %v, %v", r, err)
+	}
+	if _, err := os.Stat(cfg.Meta.StateDirectory); !os.IsNotExist(err) {
+		t.Fatalf("state directory created: %v", err)
+	}
+	if err := os.WriteFile(cfg.Meta.StateDirectory, []byte("file"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Meta.TelemetryEnabled = true
+	if r, err := NewReporter(cfg, logrus.New()); err == nil || r != nil {
+		t.Fatalf("expected directory error: %v, %v", r, err)
+	}
+}
+
+func TestMalformedStateRegeneratesUUID(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "telemetry.json")
+	if err := os.WriteFile(path, []byte(`{"version":"old","uuid":"invalid","lastTimestamp":"bad"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID == "invalid" || r.state.UUID == "" || r.state.Version != schemaVersion {
+		t.Fatalf("invalid repaired state: %+v", r.state)
+	}
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func readState(t *testing.T, path string) state {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var s state
+	if err := json.Unmarshal(data, &s); err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
