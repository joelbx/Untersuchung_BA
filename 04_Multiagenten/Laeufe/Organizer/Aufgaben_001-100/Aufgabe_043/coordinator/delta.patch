+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+func TestNewResource(t *testing.T) {
+	ctx := context.Background()
+	for _, tc := range []struct {
+		name       string
+		serviceEnv string
+		attributes string
+		wantName   string
+	}{
+		{"default", "", "", "flipt"},
+		{"service name", "custom", "region=west", "custom"},
+		{"resource attribute", "", "service.name=other,region=west", "other"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("OTEL_SERVICE_NAME", tc.serviceEnv)
+			t.Setenv("OTEL_RESOURCE_ATTRIBUTES", tc.attributes)
+			r, err := newResource(ctx, "1.2.3")
+			if err != nil {
+				t.Fatal(err)
+			}
+			attrs := make(map[attribute.Key]string)
+			for _, a := range r.Attributes() {
+				attrs[a.Key] = a.Value.AsString()
+			}
+			if got := attrs["service.name"]; got != tc.wantName {
+				t.Errorf("service.name = %q, want %q", got, tc.wantName)
+			}
+			if got := attrs["service.version"]; got != "1.2.3" {
+				t.Errorf("service.version = %q", got)
+			}
+			if tc.attributes != "" && attrs["region"] != "west" {
+				t.Errorf("region = %q", attrs["region"])
+			}
+		})
+	}
+}
+
+func TestNewProviderSamples(t *testing.T) {
+	p, err := NewProvider(context.Background(), "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = p.Shutdown(context.Background()) })
+	_, span := p.Tracer("test").Start(context.Background(), "operation")
+	defer span.End()
+	if !span.SpanContext().TraceFlags().IsSampled() || !span.IsRecording() {
+		t.Fatal("provider did not sample the span")
+	}
+}
+
+func TestGetExporter(t *testing.T) {
+	cases := []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"otlp http", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"otlp https", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318"}}},
+		{"otlp grpc", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317"}}},
+		{"otlp host port", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317"}}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			for i := 0; i < 2; i++ {
+				exp, shutdown, err := GetExporter(context.Background(), &tc.cfg)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if exp == nil || shutdown == nil {
+					t.Fatal("missing exporter or shutdown")
+				}
+				if err := shutdown(context.Background()); err != nil {
+					t.Fatal(err)
+				}
+				if err := shutdown(context.Background()); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
+
+func TestGetExporterErrors(t *testing.T) {
+	for _, tc := range []struct {
+		cfg  config.TracingConfig
+		want string
+	}{
+		{config.TracingConfig{}, "unsupported tracing exporter:"},
+		{config.TracingConfig{Exporter: config.TracingExporter(42)}, "unsupported tracing exporter: 42"},
+		{config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://"}}, "parsing otlp endpoint:"},
+		{config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "bogus://localhost:4317"}}, "parsing otlp endpoint:"},
+		{config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost"}}, "parsing otlp endpoint:"},
+	} {
+		_, _, err := GetExporter(context.Background(), &tc.cfg)
+		if err == nil || !strings.HasPrefix(err.Error(), tc.want) {
+			t.Errorf("GetExporter(%+v) error = %v, want prefix %q", tc.cfg, err, tc.want)
+		}
+	}
+}
+
+func TestOTLPHTTPHeadersAndPath(t *testing.T) {
+	requests := make(chan *http.Request, 1)
+	collector := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer collector.Close()
+
+	cfg := &config.TracingConfig{
+		Exporter: config.TracingOTLP,
+		OTLP: config.OTLPTracingConfig{
+			Endpoint: collector.URL + "/custom/traces",
+			Headers:  map[string]string{"X-Trace-Key": "secret"},
+		},
+	}
+	exporter, shutdown, err := GetExporter(context.Background(), cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = shutdown(context.Background()) }()
+
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSyncer(exporter))
+	_, span := provider.Tracer("test").Start(context.Background(), "operation")
+	span.End()
+	if err := provider.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case req := <-requests:
+		if req.URL.Path != "/custom/traces" || req.Header.Get("X-Trace-Key") != "secret" {
+			t.Errorf("path = %q, header = %q", req.URL.Path, req.Header.Get("X-Trace-Key"))
+		}
+	default:
+		t.Fatal("collector did not receive a request")
+	}
+}
