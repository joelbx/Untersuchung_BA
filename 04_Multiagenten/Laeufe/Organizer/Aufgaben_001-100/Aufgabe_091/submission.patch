+func TestValidate_ConstraintListOperators(t *testing.T) {
+	for _, comparisonType := range []ComparisonType{ComparisonType_STRING_COMPARISON_TYPE, ComparisonType_NUMBER_COMPARISON_TYPE} {
+		typeName := comparisonTypeName(comparisonType)
+		valid := `["a","b"]`
+		wrong := `["a",1]`
+		item := `"a"`
+		if comparisonType == ComparisonType_NUMBER_COMPARISON_TYPE {
+			valid, wrong, item = `[1,2.5]`, `[1,"2"]`, `1`
+		}
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			for _, tc := range []struct {
+				name, value, want string
+			}{
+				{"valid", valid, ""},
+				{"maximum", "[" + strings.Join(repeatItems(item, MAX_JSON_ARRAY_ITEMS), ",") + "]", ""},
+				{"too many", "[" + strings.Join(repeatItems(item, MAX_JSON_ARRAY_ITEMS+1), ",") + "]", fmt.Sprintf("too many values provided for property %q of type %s (maximum 100)", "field", typeName)},
+				{"wrong type", wrong, fmt.Sprintf("invalid value provided for property %q of type %s", "field", typeName)},
+				{"invalid JSON", "[", fmt.Sprintf("invalid value provided for property %q of type %s", "field", typeName)},
+				{"empty value", "", fmt.Sprintf("invalid value provided for property %q of type %s", "field", typeName)},
+				{"null list", "null", fmt.Sprintf("invalid value provided for property %q of type %s", "field", typeName)},
+				{"null item", "[null]", fmt.Sprintf("invalid value provided for property %q of type %s", "field", typeName)},
+			} {
+				t.Run(typeName+"/"+operator+"/"+tc.name, func(t *testing.T) {
+					create := &CreateConstraintRequest{SegmentKey: "segment", Property: "field", Type: comparisonType, Operator: operator, Value: tc.value}
+					update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "field", Type: comparisonType, Operator: operator, Value: tc.value}
+					for _, err := range []error{create.Validate(), update.Validate()} {
+						if tc.want == "" {
+							assert.NoError(t, err)
+						} else {
+							assert.Equal(t, errors.ErrInvalid(tc.want), err)
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+func repeatItems(item string, n int) []string {
+	items := make([]string, n)
+	for i := range items {
+		items[i] = item
+	}
+	return items
+}
