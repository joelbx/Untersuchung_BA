+		{flipt.OpIsNotOneOf, `["red","blue"]`, "green", true},
+		{flipt.OpIsNotOneOf, `["red","blue"]`, "red", false},
+		{flipt.OpIsOneOf, `[""]`, "", true},
+		{flipt.OpIsNotOneOf, `[]`, "red", true},
+		{flipt.OpIsOneOf, `["red",1]`, "red", false},
+		{flipt.OpIsNotOneOf, `["red",null]`, "green", false},
