+func TestLoadDefaultsAndEnvironment(t *testing.T) {
+	t.Run("defaults without a file", func(t *testing.T) {
+		for _, key := range []string{"FLIPT_LOG_LEVEL", "FLIPT_SERVER_HTTP_PORT"} {
+			value, present := os.LookupEnv(key)
+			require.NoError(t, os.Unsetenv(key))
+			t.Cleanup(func() {
+				if present {
+					os.Setenv(key, value)
+				}
+			})
+		}
+
+		res, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, Default(), res.Config)
+	})
+
+	t.Run("environment overrides defaults", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+
+		res, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, "debug", res.Config.Log.Level)
+		assert.Equal(t, 8181, res.Config.Server.HTTPPort)
+	})
+
+	t.Run("environment overrides file", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "flipt.yml")
+		require.NoError(t, os.WriteFile(path, []byte("log:\n  level: warn\nserver:\n  host: 127.0.0.1\n  http_port: 8182\n"), 0600))
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+
+		res, err := Load(path)
+		require.NoError(t, err)
+		assert.Equal(t, "debug", res.Config.Log.Level)
+		assert.Equal(t, 8181, res.Config.Server.HTTPPort)
+		assert.Equal(t, "127.0.0.1", res.Config.Server.Host)
+	})
+}
