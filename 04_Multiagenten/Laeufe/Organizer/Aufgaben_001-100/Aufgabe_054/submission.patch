--- a/utils/singleton/singleton.go
+++ b/utils/singleton/singleton.go
@@ -3,15 +3,35 @@ package singleton
 import (
 	"reflect"
 	"strings"
+	"sync"
 
 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances        = make(map[string]interface{})
+	getOrCreateC     = make(chan *entry, 1)
+	genericInstances sync.Map // map[reflect.Type]*genericEntry
 )
 
+type genericEntry struct {
+	once  sync.Once
+	value interface{} // *T, so even a nil interface value can be cached
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// Calls for T and *T use separate instances.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	entryValue, _ := genericInstances.LoadOrStore(typeOfT, &genericEntry{})
+	e := entryValue.(*genericEntry)
+	e.once.Do(func() {
+		instance := constructor()
+		e.value = &instance
+	})
+	return *e.value.(*T)
+}
+
 type entry struct {
 	constructor func() interface{}
 	object      interface{}
