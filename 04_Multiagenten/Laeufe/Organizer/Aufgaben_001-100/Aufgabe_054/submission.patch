 	RunSpecs(t, "Singleton Suite")
 }
 
+func TestGetInstanceValueAndPointer(t *testing.T) {
+	type instance struct{ id int }
+	var valueCalls, pointerCalls int
+	valueConstructor := func() instance {
+		valueCalls++
+		return instance{id: 1}
+	}
+	pointerConstructor := func() *instance {
+		pointerCalls++
+		return &instance{id: 2}
+	}
+
+	value := singleton.GetInstance(valueConstructor)
+	if value.id != 1 || singleton.GetInstance(func() instance {
+		t.Fatal("value constructor called again")
+		return instance{}
+	}) != value || valueCalls != 1 {
+		t.Fatalf("value singleton was not reused: value=%v, constructor calls=%d", value, valueCalls)
+	}
+
+	pointer := singleton.GetInstance(pointerConstructor)
+	if pointer == nil || pointer.id != 2 || singleton.GetInstance(func() *instance {
+		t.Fatal("pointer constructor called again")
+		return nil
+	}) != pointer || pointerCalls != 1 {
+		t.Fatalf("pointer singleton was not reused: pointer=%v, constructor calls=%d", pointer, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type instance struct{ id int }
+	const callers = 20000
+	var creations int32
+	constructor := func() *instance {
+		atomic.AddInt32(&creations, 1)
+		return &instance{id: 42}
+	}
+	results := make([]*instance, callers)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(callers)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(constructor)
+		}(i)
+	}
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&creations); got != 1 {
+		t.Fatalf("constructor called %d times, want 1", got)
+	}
+	for i, result := range results {
+		if result != results[0] || result.id != 42 {
+			t.Fatalf("call %d received %p (%v), want %p", i, result, result, results[0])
+		}
+	}
+}
