index 0000000..2bdd3a8
--- /dev/null
+++ b/applications/drive/src/app/utils/type/DeepPartial.ts
@@ -0,0 +1,6 @@
+/** Makes every property optional, including properties of nested objects and arrays. */
+export type DeepPartial<T> = T extends readonly (infer Item)[]
+    ? DeepPartial<Item>[]
+    : T extends object
+    ? { [Key in keyof T]?: DeepPartial<T[Key]> }
+    : T;
