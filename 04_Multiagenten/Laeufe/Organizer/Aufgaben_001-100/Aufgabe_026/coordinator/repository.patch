@@ -0,0 +1,82 @@
+package models
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestGetCveContentTypes(t *testing.T) {
+	tests := []struct {
+		family string
+		want   []CveContentType
+	}{
+		{"redhat", []CveContentType{RedHat, RedHatAPI}},
+		{"centos", []CveContentType{RedHat, RedHatAPI}},
+		{"alma", []CveContentType{RedHat, RedHatAPI}},
+		{"rocky", []CveContentType{RedHat, RedHatAPI}},
+		{"debian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"raspbian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"ubuntu", []CveContentType{Ubuntu, UbuntuAPI}},
+		{"unsupported", nil},
+	}
+	for _, tt := range tests {
+		if got := GetCveContentTypes(tt.family); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("GetCveContentTypes(%q) = %v, want %v", tt.family, got, tt.want)
+		}
+	}
+	if NewCveContentType("redhat") != RedHat || NewCveContentType("centos") != RedHat || NewCveContentType("unsupported") != Unknown {
+		t.Fatal("single-source mapping changed")
+	}
+}
+
+func TestUbuntuContentSources(t *testing.T) {
+	contents := CveContents{
+		Ubuntu:    {{Type: Ubuntu, SourceLink: "oval", Summary: "OVAL", Cpes: []Cpe{{URI: "oval"}}, References: References{{Link: "oval"}}, CweIDs: []string{"CWE-1"}}},
+		UbuntuAPI: {{Type: UbuntuAPI, SourceLink: "api", Summary: "API", Cvss3Severity: "NEGLIGIBLE", Cpes: []Cpe{{URI: "api"}}, References: References{{Link: "api"}}, CweIDs: []string{"CWE-2"}}},
+		Nvd:       {{Type: Nvd, SourceLink: "nvd", Summary: "NVD", Cpes: []Cpe{{URI: "nvd"}}, References: References{{Link: "nvd"}}, CweIDs: []string{"CWE-3"}}},
+	}
+	if got, want := contents.PrimarySrcURLs("en", "ubuntu", "CVE-1", nil), []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "oval"}, {UbuntuAPI, "api"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("source URLs = %v, want %v", got, want)
+	}
+	for name, got := range map[string][]CveContentType{
+		"CPEs":       typesOfCpes(contents.Cpes("ubuntu")),
+		"references": typesOfRefs(contents.References("ubuntu")),
+		"CWEs":       typesOfStrs(contents.CweIDs("ubuntu")),
+	} {
+		if want := []CveContentType{Ubuntu, UbuntuAPI, Nvd}; !reflect.DeepEqual(got, want) {
+			t.Errorf("%s order = %v, want %v", name, got, want)
+		}
+	}
+	v := VulnInfo{CveContents: contents}
+	if got, want := typesOfStrs(v.Titles("en", "ubuntu")), []CveContentType{Nvd, Ubuntu, UbuntuAPI}; !reflect.DeepEqual(got, want) {
+		t.Errorf("titles order = %v, want %v", got, want)
+	}
+	if got, want := typesOfStrs(v.Summaries("en", "ubuntu")), []CveContentType{Ubuntu, UbuntuAPI, Nvd}; !reflect.DeepEqual(got, want) {
+		t.Errorf("summaries order = %v, want %v", got, want)
+	}
+	if got := v.Cvss3Scores(); len(got) != 1 || got[0].Type != UbuntuAPI || got[0].Value.Score != 3.9 {
+		t.Errorf("Ubuntu API severity score = %v", got)
+	}
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("negligible range = %q", got)
+	}
+}
+
+func typesOfCpes(values []CveContentCpes) (types []CveContentType) {
+	for _, value := range values {
+		types = append(types, value.Type)
+	}
+	return
+}
+func typesOfRefs(values []CveContentRefs) (types []CveContentType) {
+	for _, value := range values {
+		types = append(types, value.Type)
+	}
+	return
+}
+func typesOfStrs(values []CveContentStr) (types []CveContentType) {
+	for _, value := range values {
+		types = append(types, value.Type)
+	}
+	return
+}
