-	return &MultiLog{
-		loggers: loggers,
+func NewMultiLog(loggers ...IAuditLog) (*MultiLog, error) {
+	emitters := make([]Emitter, 0, len(loggers))
+	for _, logger := range loggers {
+		emitter, ok := logger.(Emitter)
+		if !ok {
+			return nil, trace.BadParameter("expected emitter, but %T does not emit", logger)
+		}
+		emitters = append(emitters, emitter)
 	}
+	return &MultiLog{
+		MultiEmitter: NewMultiEmitter(emitters...),
+		loggers:      loggers,
+	}, nil
 }
 
 // MultiLog is a logger that fan outs write operations
 // to all loggers, and performs all read and search operations
 // on the first logger that implements the operation
 type MultiLog struct {
+	*MultiEmitter
 	loggers []IAuditLog
 }
 
diff --git a/lib/events/writer_emitter_test.go b/lib/events/writer_emitter_test.go
new file mode 100644
index 0000000..bfb274f
--- /dev/null
+++ b/lib/events/writer_emitter_test.go
@@ -0,0 +1,65 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type recordingWriteCloser struct {
+	bytes.Buffer
+	closes int
+}
+
+func (w *recordingWriteCloser) Close() error {
+	w.closes++
+	return nil
+}
+
+func TestWriterEmitterAndMultiLog(t *testing.T) {
+	first := &recordingWriteCloser{}
+	second := &recordingWriteCloser{}
+	firstEmitter := NewWriterEmitter(first)
+	secondEmitter := NewWriterEmitter(second)
+
+	_, err := NewMultiLog(firstEmitter, NewWriterLog(&recordingWriteCloser{}))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+
+	log, err := NewMultiLog(firstEmitter, secondEmitter)
+	require.NoError(t, err)
+	var emitter Emitter = log
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, first.String(), second.String())
+	require.Equal(t, 1, bytes.Count(first.Bytes(), []byte{'\n'}))
+	require.Contains(t, first.String(), `"event":"user.login"`)
+	require.NoError(t, log.Close())
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
+
+type errorWriteCloser struct {
+	closeCount int
+}
+
+func (w *errorWriteCloser) Write([]byte) (int, error) { return 0, errors.New("write failed") }
+func (w *errorWriteCloser) Close() error {
+	w.closeCount++
+	return errors.New("close failed")
+}
+
+func TestWriterEmitterErrors(t *testing.T) {
+	w := &errorWriteCloser{}
+	emitter := NewWriterEmitter(w)
+	err := emitter.EmitAuditEvent(context.Background(), &UserLogin{})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "write failed")
+	err = emitter.Close()
+	require.Error(t, err)
+	require.Equal(t, 2, w.closeCount)
+}
