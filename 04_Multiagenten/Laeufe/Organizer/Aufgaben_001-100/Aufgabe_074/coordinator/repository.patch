diff --git a/scripts/solr_builder/tests/test_fn_to_cli.py b/scripts/solr_builder/tests/test_fn_to_cli.py
index 1399523..b946810 100644
--- a/scripts/solr_builder/tests/test_fn_to_cli.py
+++ b/scripts/solr_builder/tests/test_fn_to_cli.py
@@ -1,5 +1,9 @@
 from argparse import BooleanOptionalAction
 import typing
+from pathlib import Path
+
+import pytest
+
 from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
 
 
@@ -47,3 +51,59 @@ class TestFnToCLI:
     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    @pytest.mark.parametrize(
+        ('annotation', 'tokens', 'expected'),
+        [
+            (list[int], ['1', '2', '3'], [1, 2, 3]),
+            (list[str], ['a', 'b'], ['a', 'b']),
+            (list[float], ['1.5', '2.5'], [1.5, 2.5]),
+            (list[Path], ['a.txt', 'b.txt'], [Path('a.txt'), Path('b.txt')]),
+        ],
+    )
+    def test_required_typed_lists(self, annotation, tokens, expected):
+        def fn(values):
+            return values
+
+        fn.__annotations__['values'] = annotation
+        cli = FnToCLI(fn)
+        cli.parse_args(tokens)
+        assert cli.run() == expected
+
+    def test_path_argument(self):
+        def fn(source: Path):
+            return source
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['book.txt'])
+        assert cli.run() == Path('book.txt')
+
+    def test_optional_list_option_and_none(self):
+        def fn(files: list[Path] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() is None
+        cli.parse_args(['--files', 'a.txt', 'b.txt'])
+        assert cli.run() == [Path('a.txt'), Path('b.txt')]
+        cli.parse_args(['--files'])
+        assert cli.run() == []
+
+    def test_list_with_default_and_following_option(self):
+        def fn(file_paths: list[int] | None = None, count: int = 0):
+            return file_paths, count
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--file_paths', '1', '2', '--count', '3'])
+        assert cli.run() == ([1, 2], 3)
+        cli.parse_args(['--file-paths', '4'])
+        assert cli.run() == ([4], 0)
+
+    def test_async_run_returns_result(self):
+        async def fn(path: Path):
+            return path
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['example.txt'])
+        assert cli.run() == Path('example.txt')
