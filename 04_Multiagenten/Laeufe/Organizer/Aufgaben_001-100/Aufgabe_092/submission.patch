+def test_upgrade_resolution_keeps_compatible_dependencies(monkeypatch, tmp_path):
+    versions = {
+        'example.parent': ['1.0.0', '2.0.0'],
+        'example.child': ['1.0.0', '2.0.0', '3.0.0'],
+    }
+    dependencies = {
+        ('example.parent', '1.0.0'): {'example.child': '>=1.0.0'},
+        ('example.parent', '2.0.0'): {'example.child': '>=2.0.0,<3.0.0'},
+    }
+    proxy = MagicMock()
+    proxy.get_collection_versions.side_effect = lambda req: [(ver, None) for ver in versions[req.fqcn]]
+    proxy.get_collection_dependencies.side_effect = lambda candidate: dependencies.get(
+        (candidate.fqcn, candidate.ver), {})
+    monkeypatch.setattr(dependency_resolution, 'MultiGalaxyAPIProxy', lambda *args: proxy)
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(
+        to_bytes(str(tmp_path)), validate_certs=False)
+    installed = {
+        Candidate('example.parent', '1.0.0', str(tmp_path / 'parent'), 'dir'),
+        Candidate('example.child', '2.0.0', str(tmp_path / 'child'), 'dir'),
+    }
+    requested = [Requirement('example.parent', '*', None, 'galaxy')]
+
+    result = collection._resolve_depenency_map(requested, [], manager, installed, False, False, upgrade=True)
+    assert result['example.parent'].ver == '2.0.0'
+    assert result['example.child'].ver == '2.0.0'
+
+    installed.remove(Candidate('example.child', '2.0.0', str(tmp_path / 'child'), 'dir'))
+    installed.add(Candidate('example.child', '1.0.0', str(tmp_path / 'child'), 'dir'))
+    result = collection._resolve_depenency_map(requested, [], manager, installed, False, False, upgrade=True)
+    assert result['example.child'].ver == '2.0.0'
+
+    with pytest.raises(AnsibleError, match='Remove --no-deps'):
+        collection._resolve_depenency_map(requested, [], manager, installed, True, False, upgrade=True)
+
+
+@pytest.mark.parametrize('upgrade,allow_pre_release,expected', [
+    (False, False, '1.0.0'),
+    (True, False, '2.0.0'),
+    (True, True, '3.0.0-beta.1'),
+])
+def test_upgrade_resolution_versions(monkeypatch, tmp_path, upgrade, allow_pre_release, expected):
+    proxy = MagicMock()
+    proxy.get_collection_versions.return_value = [
+        ('1.0.0', None), ('2.0.0', None), ('3.0.0-beta.1', None)]
+    proxy.get_collection_dependencies.return_value = {}
+    monkeypatch.setattr(dependency_resolution, 'MultiGalaxyAPIProxy', lambda *args: proxy)
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(
+        to_bytes(str(tmp_path)), validate_certs=False)
+    installed = {Candidate('example.parent', '1.0.0', str(tmp_path / 'parent'), 'dir')}
+    requested = [Requirement('example.parent', '*', None, 'galaxy')]
+
+    result = collection._resolve_depenency_map(
+        requested, [], manager, installed, True, allow_pre_release, upgrade=upgrade)
+    assert result['example.parent'].ver == expected
+
+    constrained = [Requirement('example.parent', '<2.0.0', None, 'galaxy')]
+    result = collection._resolve_depenency_map(
+        constrained, [], manager, installed, True, allow_pre_release, upgrade=True)
+    assert result['example.parent'].ver == '1.0.0'
+
+
