+def test_install_collections_upgrade_is_idempotent(monkeypatch, tmp_path):
+    proxy = MagicMock()
+    proxy.get_collection_versions.return_value = [('1.0.0', None), ('2.0.0', None)]
+    proxy.get_collection_dependencies.return_value = {}
+    monkeypatch.setattr(dependency_resolution, 'MultiGalaxyAPIProxy', lambda *args: proxy)
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(
+        to_bytes(str(tmp_path)), validate_certs=False)
+    installed = [Candidate('example.parent', '1.0.0', str(tmp_path / 'parent'), 'dir')]
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: installed)
+    mock_install = MagicMock()
+    monkeypatch.setattr(collection, 'install', mock_install)
+    requested = [Requirement('example.parent', '*', None, 'galaxy')]
+
+    def run(upgrade):
+        collection.install_collections(
+            requested, str(tmp_path), [], False, False, False, False,
+            False, manager, upgrade=upgrade)
+
+    run(False)
+    mock_install.assert_not_called()
+    run(True)
+    assert mock_install.call_count == 1
+    assert mock_install.call_args[0][0].ver == '2.0.0'
+
+    installed[:] = [Candidate('example.parent', '2.0.0', str(tmp_path / 'parent'), 'dir')]
+    mock_install.reset_mock()
+    run(True)
+    mock_install.assert_not_called()
+
