diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..ac97929
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,86 @@
+---
+- name: create isolated upgrade collection path
+  file:
+    path: '{{ galaxy_dir }}/upgrade_collections'
+    state: directory
+
+- name: install older collection version
+  command: ansible-galaxy collection install namespace1.name1:1.0.0 -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+
+- name: upgrade collection to latest stable version
+  command: ansible-galaxy collection install --upgrade namespace1.name1 -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+  register: upgrade_result
+
+- name: check upgraded collection version
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade_collections/ansible_collections/namespace1/name1/MANIFEST.json'
+  register: upgrade_manifest
+
+- name: assert upgrade chose latest stable version
+  assert:
+    that:
+    - "'namespace1.name1:1.0.9 was installed successfully' in upgrade_result.stdout"
+    - (upgrade_manifest.content | b64decode | from_json).collection_info.version == '1.0.9'
+
+- name: run upgrade again
+  command: ansible-galaxy collection install -U namespace1.name1 -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+  register: upgrade_again
+
+- name: assert upgrade is idempotent
+  assert:
+    that:
+    - "'Skipping' in upgrade_again.stdout"
+    - "'was installed successfully' not in upgrade_again.stdout"
+
+- name: upgrade with pre-release enabled
+  command: ansible-galaxy collection install --upgrade --pre namespace1.name1 -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+  register: upgrade_pre
+
+- name: assert pre-release was selected
+  assert:
+    that:
+    - "'namespace1.name1:1.1.0-beta.1 was installed successfully' in upgrade_pre.stdout"
+
+- name: create upgrade requirements file
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade-requirements.yml'
+    content: |
+      collections:
+        - name: namespace1.name1
+          version: '>=1.0.0,<1.1.0'
+
+- name: upgrade with requirements file and version limit
+  command: ansible-galaxy collection install --upgrade -r '{{ galaxy_dir }}/upgrade-requirements.yml' -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+  register: upgrade_requirements
+
+- name: assert requirements file constraint was applied
+  assert:
+    that:
+    - "'namespace1.name1:1.0.9 was installed successfully' in upgrade_requirements.stdout"
+
+- name: install an older dependency
+  command: ansible-galaxy collection install child_dep.child_collection:0.4.0 -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+
+- name: reject upgrade with an incompatible installed dependency and no-deps
+  command: ansible-galaxy collection install --upgrade --no-deps parent_dep.parent_collection -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+  register: upgrade_no_deps
+  failed_when: false
+
+- name: assert no-deps reports the incompatible dependency
+  assert:
+    that:
+    - upgrade_no_deps.rc != 0
+    - "'Remove --no-deps to update it' in upgrade_no_deps.stderr"
+
+- name: upgrade parent and its required dependency
+  command: ansible-galaxy collection install --upgrade parent_dep.parent_collection -p '{{ galaxy_dir }}/upgrade_collections' -s galaxy_ng
+
+- name: inspect upgraded dependency
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade_collections/ansible_collections/child_dep/child_collection/MANIFEST.json'
+  register: upgraded_child_manifest
+
+- name: assert dependency was upgraded to the latest compatible version
+  assert:
+    that:
+    - (upgraded_child_manifest.content | b64decode | from_json).collection_info.version == '0.9.9'
