diff --git a/tests/unit/misc/test_earlyinit.py b/tests/unit/misc/test_earlyinit.py
index e29cc0a..7538a18 100644
--- a/tests/unit/misc/test_earlyinit.py
+++ b/tests/unit/misc/test_earlyinit.py
@@ -24,6 +24,32 @@ import sys
 import pytest
 
 from qutebrowser.misc import earlyinit
+from qutebrowser.qt import machinery
+
+
+def test_check_qt_available_without_wrapper():
+    info = machinery.SelectionInfo(
+        pyqt5='ImportError: missing PyQt5',
+        pyqt6='ImportError: missing PyQt6',
+        reason=machinery.SelectionReason.auto,
+    )
+    with pytest.raises(machinery.NoWrapperAvailableError) as exc_info:
+        earlyinit.check_qt_available(info)
+    assert exc_info.value.info is info
+    assert str(exc_info.value) == f'No Qt wrapper was importable.\n\n\n{info}'
+
+
+def test_check_qt_available_error_spacing(monkeypatch, capsys):
+    def missing(_name):
+        raise ImportError('missing QtCore')
+
+    monkeypatch.setattr(earlyinit.importlib, 'import_module', missing)
+    monkeypatch.setattr(earlyinit, 'tkinter', None)
+    info = machinery.SelectionInfo(wrapper='PyQt5')
+    with pytest.raises(SystemExit) as exc_info:
+        earlyinit.check_qt_available(info)
+    assert exc_info.value.code == 1
+    assert capsys.readouterr().err.endswith('\n\n\n')
 
 
 @pytest.mark.parametrize('attr', ['stderr', '__stderr__'])
