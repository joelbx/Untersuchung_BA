+def test_parse_clixml_decodes_utf16_escapes():
+    xml = (b'<Objs><S S="Info">ignored</S><S S="Error">'
+           b'A_x000D__x000A__x263A__xD83D__xDE00__x005f_'
+           b'_x005F__x000A__x005F_ _x005G_ _xD800_'
+           b'</S><S S="Error" /></Objs>')
+    expected = 'A\r\n\u263a\U0001f600__\n_x005F_ _x005G_ \ud800'.encode('utf-8', 'surrogatepass')
+    assert _parse_clixml(xml) == expected
+
+
+def test_parse_clixml_concatenates_entries_and_separates_blocks():
+    xml = (b'<Objs><S S="Info">ignored</S></Objs>'
+           b'<Objs><S S="Error">one</S><S S="Error" /><S S="Error">two</S></Objs>'
+           b'<Objs><S S="Error">three</S></Objs>')
+    assert _parse_clixml(xml) == b'onetwo\r\nthree'
+
+
+def test_parse_clixml_empty_matching_entries():
+    assert _parse_clixml(b'<Objs><S S="Error" /><S S="Error"></S></Objs>') == b''
+
+
