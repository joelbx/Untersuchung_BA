 _common_args = ['PowerShell', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Unrestricted']
 
 
-def _parse_clixml(data, stream="Error"):
+_CLIXML_ESCAPE = re.compile(r'_x([0-9a-fA-F]{4})_')
+_CLIXML_BLOCK = re.compile(rb'<Objs(?:\s[^>]*)?>.*?</Objs>', re.DOTALL)
+
+
+def _decode_clixml_text(value: str) -> str:
+    parts = []
+    position = 0
+    tokens = list(_CLIXML_ESCAPE.finditer(value))
+    index = 0
+
+    while index < len(tokens):
+        token = tokens[index]
+        parts.append(value[position:token.start()])
+        code_unit = int(token.group(1), 16)
+        next_token = tokens[index + 1] if index + 1 < len(tokens) else None
+        adjacent = next_token is not None and next_token.start() == token.end()
+
+        if 0xD800 <= code_unit <= 0xDBFF and adjacent:
+            low = int(next_token.group(1), 16)
+            if 0xDC00 <= low <= 0xDFFF:
+                parts.append(chr(0x10000 + ((code_unit - 0xD800) << 10) + low - 0xDC00))
+                position = next_token.end()
+                index += 2
+                continue
+
+        # PowerShell escapes a literal escape prefix as _x005F_.  A lone
+        # uppercase prefix is kept as text; the lowercase spelling is an
+        # ordinary hexadecimal escape.
+        if token.group() == '_x005F_' and not adjacent:
+            parts.append(token.group())
+        else:
+            parts.append(chr(code_unit))
+
+        position = token.end()
+        index += 1
+
+    parts.append(value[position:])
+    return ''.join(parts)
+
+
+def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
     """
     Takes a byte string like '#< CLIXML\r\n<Objs...' and extracts the stream
     message encoded in the XML data. CLIXML is used by PowerShell to encode
     multiple objects in stderr.
     """
-    lines = []
+    blocks = []
 
     # There are some scenarios where the stderr contains a nested CLIXML element like
     # '<# CLIXML\r\n<# CLIXML\r\n<Objs>...</Objs><Objs>...</Objs>'.
-    # Parse each individual <Objs> element and add the error strings to our stderr list.
+    # Parse each individual <Objs> element in its original order.
     # https://github.com/ansible/ansible/issues/69550
-    while data:
-        end_idx = data.find(b"</Objs>") + 7
-        current_element = data[data.find(b"<Objs "):end_idx]
-        data = data[end_idx:]
-
-        clixml = ET.fromstring(current_element)
+    for match in _CLIXML_BLOCK.finditer(data):
+        clixml = ET.fromstring(match.group())
         namespace_match = re.match(r'{(.*)}', clixml.tag)
         namespace = "{%s}" % namespace_match.group(1) if namespace_match else ""
 
         strings = clixml.findall("./%sS" % namespace)
-        lines.extend([e.text.replace('_x000D__x000A_', '') for e in strings if e.attrib.get('S') == stream])
+        block_text = ''.join(e.text or '' for e in strings if e.attrib.get('S') == stream)
+        if block_text:
+            blocks.append(_decode_clixml_text(block_text))
 
-    return to_bytes('\r\n'.join(lines))
+    return to_bytes('\r\n'.join(blocks), errors='surrogatepass')
 
 
