 class TestList:
+    def test_seed_formats_and_export(self):
+        list_model.register_models()
+        site = MockSite()
+        work = site.quicksave('/works/OL1W', '/type/work', title='Work')
+        author = site.quicksave('/authors/OL1A', '/type/author', name='Author')
+        site.quicksave('/books/OL1M', '/type/edition', title='Edition')
+        lst = site.quicksave('/lists/OL1L', '/type/list', name='List', seeds=[])
+
+        assert lst.add_seed(work)
+        assert not lst.add_seed({'key': work.key})
+        assert lst.add_seed({'key': author.key})
+        assert lst.add_seed('subject:history')
+        assert lst.add_seed({'key': '/books/OL1M'})
+        assert not lst.add_seed('subject:history')
+        assert lst.has_seed(work)
+        assert lst.has_seed({'key': work.key})
+        assert [seed.key for seed in lst.get_seeds()] == [
+            work.key, author.key, 'subject:history', '/books/OL1M'
+        ]
+        assert isinstance(lst.get_seeds()[0].value, list_model.client.Thing)
+        assert isinstance(lst.get_seeds()[2].value, str)
+
+        exported = lst.get_export_list()
+        assert set(exported) == {'authors', 'works', 'editions'}
+        assert {doc['key'] for doc in exported['authors']} == {author.key}
+        assert {doc['key'] for doc in exported['works']} == {work.key}
+        assert {doc['key'] for doc in exported['editions']} == {'/books/OL1M'}
+
+        assert lst.remove_seed(work)
+        assert not lst.remove_seed({'key': work.key})
+        assert lst.remove_seed('subject:history')
+
+    def test_export_filters_loaded_types(self):
+        list_model.register_models()
+        site = MockSite()
+        site.quicksave('/works/OL1W', '/type/edition', title='Wrong type')
+        lst = site.quicksave(
+            '/lists/OL2L', '/type/list', name='List',
+            seeds=[{'key': '/works/OL1W'}, 'subject:history'],
+        )
+        assert lst.get_export_list() == {'authors': [], 'works': [], 'editions': []}
+
