 from openlibrary.plugins.openlibrary.lists import ListRecord
 
 
+@pytest.mark.parametrize(
+    'key,expected',
+    [
+        ('/subjects/ancient__history,', 'subject:ancient_history_'),
+        ('/subjects/place:new__york', 'place:new_york'),
+        ('/subjects/person:ada,lovelace', 'person:ada_lovelace'),
+        ('/subjects/time:1900s', 'time:1900s'),
+    ],
+)
+def test_subject_key_to_seed(key, expected):
+    assert lists.subject_key_to_seed(key) == expected
+    assert lists.is_seed_subject_string(expected)
+
+
+def test_is_seed_subject_string_rejects_other_strings():
+    assert not lists.is_seed_subject_string('/subjects/history')
+    assert not lists.is_seed_subject_string('subjective:history')
+    assert not lists.is_seed_subject_string('work:history')
+
+
+def test_normalize_input_subject_seed():
+    assert ListRecord.normalize_input_seed({'key': '/subjects/place:new__york'}) == 'place:new_york'
+    assert ListRecord.normalize_input_seed('/subjects/history') == 'subject:history'
+
+
 def test_process_seeds():
     process_seeds = lists.lists_json().process_seeds
 
