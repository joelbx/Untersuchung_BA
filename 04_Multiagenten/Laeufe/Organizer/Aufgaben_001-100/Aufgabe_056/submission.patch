@@ -0,0 +1,21 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('prefers a specific file type', async () => {
+        const file = new File([], 'photo.jxl', { type: 'image/png' });
+
+        expect(await mimeTypeFromFile(file)).toBe('image/png');
+    });
+
+    it('recognizes JXL by extension even for an empty file', async () => {
+        const file = new File([], 'photo.JXL');
+
+        expect(await mimeTypeFromFile(file)).toBe('image/jxl');
+    });
+
+    it('uses the extension when the file type is generic', async () => {
+        const file = new File([], 'photo.heic', { type: 'application/octet-stream' });
+
+        expect(await mimeTypeFromFile(file)).toBe('image/heic');
+    });
+});
