diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts
new file mode 100644
index 0000000..565c48e
--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts
@@ -0,0 +1,49 @@
+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    ...jest.requireActual('@proton/shared/lib/helpers/browser'),
+    getBrowser: jest.fn(),
+    getOS: jest.fn(),
+}));
+
+const setPlatform = (browser: string, version: string, os: string) => {
+    jest.mocked(getBrowser).mockReturnValue({ name: browser, version });
+    jest.mocked(getOS).mockReturnValue({ name: os, version: '' });
+};
+
+describe('modern image support', () => {
+    it('accepts HEIC variants and JXL on macOS Safari 17', () => {
+        setPlatform('Safari', '17.0', 'Mac OS');
+
+        expect(isHEICSupported()).toBe(true);
+        expect(isJXLSupported()).toBe(true);
+        [
+            SupportedMimeTypes.heic,
+            SupportedMimeTypes.heics,
+            SupportedMimeTypes.heif,
+            SupportedMimeTypes.heifs,
+            SupportedMimeTypes.jxl,
+        ].forEach((type) => expect(isSupportedImage(type)).toBe(true));
+    });
+
+    it('accepts Mobile Safari 17 on iOS', () => {
+        setPlatform('Mobile Safari', '17.1', 'iOS');
+
+        expect(isSupportedImage(SupportedMimeTypes.heic)).toBe(true);
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(true);
+    });
+
+    it.each([
+        ['Safari', '16.6', 'Mac OS'],
+        ['Chrome', '17.0', 'Mac OS'],
+        ['Safari', '17.0', 'Windows'],
+        ['Safari', '', 'Mac OS'],
+    ])('rejects modern images on %s %s / %s', (browser, version, os) => {
+        setPlatform(browser, version, os);
+
+        expect(isSupportedImage(SupportedMimeTypes.heic)).toBe(false);
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(false);
+    });
+});
diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
