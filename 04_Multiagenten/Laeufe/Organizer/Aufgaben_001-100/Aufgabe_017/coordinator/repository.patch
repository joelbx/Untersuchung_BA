+package database
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/gravitational/teleport/lib/srv/db/common"
+	"github.com/gravitational/teleport/lib/srv/db/sqlserver"
+)
+
+func TestSQLServerErrors(t *testing.T) {
+	p := SQLServerPinger{}
+	for _, tt := range []struct {
+		name                    string
+		err                     error
+		refused, user, database bool
+	}{
+		{name: "refused", err: fmt.Errorf("dial: %w", syscall.ECONNREFUSED), refused: true},
+		{name: "refused message", err: errors.New("dial tcp: connection refused"), refused: true},
+		{name: "invalid user", err: fmt.Errorf("login: %w", mssql.Error{Number: 18456}), user: true},
+		{name: "invalid user pointer", err: &mssql.Error{Number: 18452}, user: true},
+		{name: "invalid database", err: fmt.Errorf("login: %w", mssql.Error{Number: 4060}), database: true},
+		{name: "missing database", err: mssql.Error{Number: 911}, database: true},
+		{name: "other", err: mssql.Error{Number: 12345}},
+		{name: "nil"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.refused, p.IsConnectionRefusedError(tt.err))
+			require.Equal(t, tt.user, p.IsInvalidDatabaseUserError(tt.err))
+			require.Equal(t, tt.database, p.IsInvalidDatabaseNameError(tt.err))
+		})
+	}
+}
+
+func TestSQLServerPing(t *testing.T) {
+	server, err := sqlserver.NewTestServer(common.TestServerConfig{AuthClient: setupMockClient(t)})
+	require.NoError(t, err)
+	go func() { _ = server.Serve() }()
+	t.Cleanup(func() { _ = server.Close() })
+
+	port, err := strconv.Atoi(server.Port())
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	p := SQLServerPinger{}
+	params := PingParams{
+		Host: "localhost", Port: port, Username: "someuser", DatabaseName: "somedb",
+	}
+	require.NoError(t, p.Ping(ctx, params))
+
+	expiredCtx, expiredCancel := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer expiredCancel()
+	require.ErrorIs(t, p.Ping(expiredCtx, params), context.DeadlineExceeded)
+
+	require.Error(t, p.Ping(ctx, PingParams{Host: "localhost", Port: port, Username: "someuser"}))
+	require.Error(t, p.Ping(ctx, PingParams{Host: "localhost", Port: -1, Username: "someuser", DatabaseName: "somedb"}))
+}
