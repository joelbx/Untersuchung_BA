+func TestMatch(t *testing.T) {
+	tests := []struct {
+		expression string
+		accepted   []string
+		rejected   []string
+	}{
+		{expression: "foo", accepted: []string{"foo"}, rejected: []string{"foobar", "bar"}},
+		{expression: "*", accepted: []string{"", "anything"}},
+		{expression: "foo*bar", accepted: []string{"foobar", "foo-middle-bar"}, rejected: []string{"xfoobar", "foobarbaz"}},
+		{expression: "^foo+$", accepted: []string{"foo", "fooo"}, rejected: []string{"xfoo", "fo"}},
+		{expression: `{{regexp.match("^foo+$")}}`, accepted: []string{"foo", "fooo"}, rejected: []string{"bar"}},
+		{expression: `{{regexp.not_match("^foo+$")}}`, accepted: []string{"bar"}, rejected: []string{"foo", "fooo"}},
+		{expression: `foo-{{regexp.match("^bar$")}}-baz`, accepted: []string{"foo-bar-baz"}, rejected: []string{"foo-bar-baz-extra", "foo-xbar-baz", "foo-barx-baz"}},
+	}
+	for _, test := range tests {
+		t.Run(test.expression, func(t *testing.T) {
+			matcher, err := Match(test.expression)
+			assert.NoError(t, err)
+			for _, input := range test.accepted {
+				assert.True(t, matcher.Match(input), "input %q", input)
+			}
+			for _, input := range test.rejected {
+				assert.False(t, matcher.Match(input), "input %q", input)
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		value, message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{external.foo}}`, `"external.foo" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{email.local(internal.foo)}}`, `"email.local(internal.foo)" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{other.match("foo")}}`, `unsupported function namespace other, supported namespaces are email and regexp`},
+		{`{{regexp.other("foo")}}`, `unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match.`},
+		{`{{email.other("foo")}}`, `unsupported function email.other, supported functions are: email.local`},
+		{`{{regexp.match()}}`, `regexp.match expects exactly one string literal argument`},
+		{`{{regexp.match("foo", "bar")}}`, `regexp.match expects exactly one string literal argument`},
+		{`{{regexp.match(external.foo)}}`, `regexp.match expects exactly one string literal argument`},
+		{`{{regexp.match(regexp.match("foo"))}}`, `"regexp.match(regexp.match(\"foo\"))" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("foo")}}{{regexp.match("bar")}}`, `"{{regexp.match(\"foo\")}}{{regexp.match(\"bar\")}}" is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, test := range tests {
+		t.Run(test.value, func(t *testing.T) {
+			_, err := Match(test.value)
+			assert.True(t, trace.IsBadParameter(err), "error: %v", err)
+			assert.Equal(t, test.message, err.Error())
+		})
+	}
+	_, err := Match(`{{regexp.match("[")}}`)
+	assert.True(t, trace.IsBadParameter(err))
+	assert.True(t, strings.HasPrefix(err.Error(), `failed parsing regexp "[": `), "error: %v", err)
+
+	_, err = Variable(`{{regexp.match("foo")}}`)
+	assert.True(t, trace.IsBadParameter(err))
+	assert.Equal(t, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`, err.Error())
+}
