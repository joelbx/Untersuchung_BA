 }
 
+func (s *WebSuite) TestU2FLoginWithMultipleDevices(c *C) {
+	cap, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  "https://" + s.server.ClusterName(),
+			Facets: []string{"https://" + s.server.ClusterName()},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.server.Auth().SetAuthPreference(cap), IsNil)
+	s.createUser(c, "bob", "root", "password", "")
+
+	keys := []*mocku2f.Key{s.mockU2F}
+	secondKey, err := mocku2f.Create()
+	c.Assert(err, IsNil)
+	keys = append(keys, secondKey)
+	for i, key := range keys {
+		dev, err := u2f.NewDevice(fmt.Sprintf("key-%d", i), &u2f.Registration{
+			KeyHandle: key.KeyHandle,
+			PubKey:    key.PrivateKey.PublicKey,
+		}, s.clock.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.server.Auth().UpsertMFADevice(context.Background(), "bob", dev), IsNil)
+	}
+
+	clt := s.client()
+	re, err := clt.PostJSON(context.Background(), clt.Endpoint("webapi", "u2f", "signrequest"), client.U2fSignRequestReq{
+		User: "bob",
+		Pass: "password",
+	})
+	c.Assert(err, IsNil)
+	var challenge auth.U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &challenge), IsNil)
+	c.Assert(challenge.AuthenticateChallenge, NotNil)
+	c.Assert(challenge.Challenges, HasLen, 2)
+	c.Assert(*challenge.AuthenticateChallenge, DeepEquals, challenge.Challenges[0])
+
+	// The second token can complete login through the web endpoint.
+	var secondChallenge u2f.AuthenticateChallenge
+	var signingKey *mocku2f.Key
+	for _, candidate := range challenge.Challenges {
+		if candidate.KeyHandle != challenge.AuthenticateChallenge.KeyHandle {
+			secondChallenge = candidate
+			for _, key := range keys {
+				if candidate.KeyHandle == base64.RawURLEncoding.EncodeToString(key.KeyHandle) {
+					signingKey = key
+				}
+			}
+		}
+	}
+	c.Assert(secondChallenge.KeyHandle, Not(Equals), "")
+	c.Assert(signingKey, NotNil)
+	response, err := signingKey.SignResponse(&secondChallenge)
+	c.Assert(err, IsNil)
+	_, err = clt.PostJSON(context.Background(), clt.Endpoint("webapi", "u2f", "sessions"), u2fSignResponseReq{
+		User: "bob", U2FSignResponse: *response,
+	})
+	c.Assert(err, IsNil)
+
+	// Auth API clients receive the same two challenges.
+	authChallenge, err := s.proxyClient.GetU2FSignRequest("bob", []byte("password"))
+	c.Assert(err, IsNil)
+	c.Assert(authChallenge.Challenges, HasLen, 2)
+}
