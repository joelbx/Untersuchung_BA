@@ -0,0 +1,174 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestDefaults(t *testing.T) {
+	var cfg Config
+	cfg.SetDefaults()
+	if cfg.Capacity != 64 || cfg.GracePeriod != 5*time.Minute || cfg.Clock == nil {
+		t.Fatalf("unexpected defaults: %+v", cfg)
+	}
+}
+
+func TestOverflowOrderAndCleanup(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	fast, slow := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	got := make([]int, 5)
+	if n, err := fast.TryRead(got); n != 5 || err != nil || !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+		t.Fatalf("fast read: %v, %v, %v", n, err, got)
+	}
+	for i := 1; i <= 5; i++ {
+		var out [1]int
+		if n, err := slow.TryRead(out[:]); n != 1 || err != nil || out[0] != i {
+			t.Fatalf("slow read %d: %v, %v, %v", i, n, err, out)
+		}
+	}
+	if b.base != b.next || b.length != 0 || len(b.overflow) != 0 {
+		t.Fatalf("items retained after all cursors read: base=%d next=%d length=%d overflow=%d", b.base, b.next, b.length, len(b.overflow))
+	}
+	b.Append(6, 7)
+	late := b.NewCursor()
+	b.Append(8)
+	var out [3]int
+	if n, err := late.TryRead(out[:]); n != 1 || err != nil || out[0] != 8 {
+		t.Fatalf("late cursor read: %v, %v, %v", n, err, out)
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3)
+	var out [3]int
+	if n, err := fast.TryRead(out[:]); n != 3 || err != nil {
+		t.Fatalf("fast read: %d, %v", n, err)
+	}
+	clock.Advance(time.Minute)
+	if n, err := slow.TryRead(out[:]); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("expired cursor: %d, %v", n, err)
+	}
+	if n, err := slow.TryRead(out[:]); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("repeated expired read: %d, %v", n, err)
+	}
+	b.Append(4)
+	if n, err := fast.TryRead(out[:]); n != 1 || err != nil || out[0] != 4 {
+		t.Fatalf("fast cursor after expiry: %d, %v, %v", n, err, out)
+	}
+}
+
+func TestAppendEvictsExpiredCursor(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	slow := b.NewCursor()
+	b.Append(1, 2, 3)
+	clock.Advance(time.Minute)
+	b.Append(4)
+	if _, err := slow.TryRead(make([]int, 4)); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("expired cursor: %v", err)
+	}
+	if b.base != b.next || b.length != 0 || len(b.overflow) != 0 {
+		t.Fatalf("expired cursor retained items: base=%d next=%d length=%d overflow=%d", b.base, b.next, b.length, len(b.overflow))
+	}
+}
+
+func TestBlockingAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	type result struct {
+		n    int
+		err  error
+		item int
+	}
+	results := make(chan result, 1)
+	go func() {
+		var out [1]int
+		n, err := c.Read(context.Background(), out[:])
+		results <- result{n, err, out[0]}
+	}()
+	b.Append(7)
+	select {
+	case r := <-results:
+		if r.n != 1 || r.err != nil || r.item != 7 {
+			t.Fatalf("read: %+v", r)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("read did not wake")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read: %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+	other := b.NewCursor()
+	blocked := make(chan error, 1)
+	go func() {
+		_, err := other.Read(context.Background(), make([]int, 1))
+		blocked <- err
+	}()
+	b.Close()
+	select {
+	case err := <-blocked:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("blocked read after close: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not wake reader")
+	}
+	if _, err := other.TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("closed buffer: %v", err)
+	}
+}
+
+func TestConcurrentReaders(t *testing.T) {
+	const count = 1000
+	b := NewBuffer[int](Config{Capacity: count + 1})
+	defer b.Close()
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		c := b.NewCursor()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer c.Close()
+			for want := 0; want < count; {
+				var out [17]int
+				n, err := c.Read(context.Background(), out[:])
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, item := range out[:n] {
+					if item != want {
+						t.Errorf("got %d, want %d", item, want)
+						return
+					}
+					want++
+				}
+			}
+		}()
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
