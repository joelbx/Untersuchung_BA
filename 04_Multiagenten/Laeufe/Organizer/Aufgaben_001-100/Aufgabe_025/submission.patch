+func TestEnvSubstitutionHook(t *testing.T) {
+	t.Setenv("FLIPT_TEST_REFERENCE", "resolved")
+	t.Setenv("FLIPT_TEST_EMPTY_REFERENCE", "")
+
+	tests := []struct {
+		name string
+		data interface{}
+		want interface{}
+	}{
+		{"match", "${FLIPT_TEST_REFERENCE}", "resolved"},
+		{"empty value", "${FLIPT_TEST_EMPTY_REFERENCE}", ""},
+		{"missing variable", "${FLIPT_TEST_MISSING_REFERENCE}", "${FLIPT_TEST_MISSING_REFERENCE}"},
+		{"embedded reference", "prefix-${FLIPT_TEST_REFERENCE}", "prefix-${FLIPT_TEST_REFERENCE}"},
+		{"trailing text", "${FLIPT_TEST_REFERENCE}-suffix", "${FLIPT_TEST_REFERENCE}-suffix"},
+		{"invalid first character", "${1FLIPT_TEST_REFERENCE}", "${1FLIPT_TEST_REFERENCE}"},
+		{"invalid character", "${FLIPT-TEST-REFERENCE}", "${FLIPT-TEST-REFERENCE}"},
+		{"non-string", 42, 42},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := envSubstitutionHookFunc().(func(reflect.Type, reflect.Type, interface{}) (interface{}, error))(reflect.TypeOf(tt.data), reflect.TypeOf(""), tt.data)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
