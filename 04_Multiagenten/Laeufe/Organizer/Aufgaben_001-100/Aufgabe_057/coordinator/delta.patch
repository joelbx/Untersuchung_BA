@@ -0,0 +1,114 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+)
+
+type exportStore struct{ lister }
+
+func (exportStore) ListFlags(_ context.Context, _ ...storage.QueryOption) ([]*flipt.Flag, error) {
+	return []*flipt.Flag{{Key: "flag", Name: "Flag", Enabled: true, Variants: []*flipt.Variant{
+		{Id: "v1", Key: "nested", Attachment: `{"list":[true,2,null,{"child":"value"}],"empty":null}`},
+		{Id: "v2", Key: "empty"},
+	}}}, nil
+}
+func (exportStore) ListRules(_ context.Context, _ string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return []*flipt.Rule{{SegmentKey: "segment", Rank: 1, Distributions: []*flipt.Distribution{{VariantId: "v1", Rollout: 100}}}}, nil
+}
+func (exportStore) ListSegments(_ context.Context, _ ...storage.QueryOption) ([]*flipt.Segment, error) {
+	return []*flipt.Segment{{Key: "segment", Name: "Segment", Constraints: []*flipt.Constraint{{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "team", Operator: "eq", Value: "a"}}}}, nil
+}
+
+func TestExportNativeAttachment(t *testing.T) {
+	var out bytes.Buffer
+	require.NoError(t, NewExporter(exportStore{}).Export(context.Background(), &out))
+	var doc Document
+	require.NoError(t, yaml.Unmarshal(out.Bytes(), &doc))
+	require.Contains(t, out.String(), "attachment:\n")
+	require.NotContains(t, out.String(), `attachment: '{`)
+	require.Nil(t, doc.Flags[0].Variants[1].Attachment)
+	require.Len(t, doc.Flags[0].Rules[0].Distributions, 1)
+	require.Len(t, doc.Segments[0].Constraints, 1)
+	attachment := convert(doc.Flags[0].Variants[0].Attachment)
+	data, err := json.Marshal(attachment)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"list":[true,2,null,{"child":"value"}],"empty":null}`, string(data))
+}
+
+type importStore struct {
+	creator
+	attachments                                        map[string]string
+	flags, segments, constraints, rules, distributions int
+}
+
+func (s *importStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	s.flags++
+	return &flipt.Flag{Key: r.Key}, nil
+}
+func (s *importStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.attachments[r.Key] = r.Attachment
+	return &flipt.Variant{Id: r.Key, Key: r.Key}, nil
+}
+func (s *importStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s.segments++
+	return &flipt.Segment{Key: r.Key}, nil
+}
+func (s *importStore) CreateConstraint(_ context.Context, _ *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.constraints++
+	return &flipt.Constraint{}, nil
+}
+func (s *importStore) CreateRule(_ context.Context, _ *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	s.rules++
+	return &flipt.Rule{Id: "rule"}, nil
+}
+func (s *importStore) CreateDistribution(_ context.Context, _ *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.distributions++
+	return &flipt.Distribution{}, nil
+}
+
+func TestImportNativeAndMissingAttachment(t *testing.T) {
+	input := `flags:
+- key: flag
+  name: Flag
+  enabled: true
+  variants:
+  - key: nested
+    attachment:
+      list: [true, 2, null, {child: value}]
+      empty: null
+      5: numeric-key
+  - key: empty
+  rules:
+  - segment: segment
+    rank: 1
+    distributions:
+    - variant: nested
+      rollout: 100
+segments:
+- key: segment
+  name: Segment
+  constraints:
+  - type: STRING_COMPARISON_TYPE
+    property: team
+    operator: eq
+    value: a
+`
+	s := &importStore{attachments: map[string]string{}}
+	require.NoError(t, NewImporter(s).Import(context.Background(), strings.NewReader(input)))
+	require.Equal(t, 1, s.flags)
+	require.Equal(t, 1, s.segments)
+	require.Equal(t, 1, s.constraints)
+	require.Equal(t, 1, s.rules)
+	require.Equal(t, 1, s.distributions)
+	require.Equal(t, "", s.attachments["empty"])
+	require.JSONEq(t, `{"list":[true,2,null,{"child":"value"}],"empty":null,"5":"numeric-key"}`, s.attachments["nested"])
+}
