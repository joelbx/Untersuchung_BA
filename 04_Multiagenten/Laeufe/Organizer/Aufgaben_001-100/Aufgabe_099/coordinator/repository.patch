+func TestBatchEvaluate_DisabledFlag(t *testing.T) {
+	store := &storeMock{}
+	s := &Server{logger: logger, store: store}
+
+	store.On("GetFlag", mock.Anything, "enabled").Return(&flipt.Flag{Key: "enabled", Enabled: true}, nil)
+	store.On("GetFlag", mock.Anything, "disabled").Return(&flipt.Flag{Key: "disabled", Enabled: false}, nil)
+	store.On("GetEvaluationRules", mock.Anything, "enabled").Return([]*storage.EvaluationRule{}, nil)
+
+	resp, err := s.BatchEvaluate(context.TODO(), &flipt.BatchEvaluationRequest{
+		RequestId: "batch-id",
+		Requests: []*flipt.EvaluationRequest{
+			{FlagKey: "enabled", EntityId: "first"},
+			{FlagKey: "disabled", EntityId: "second"},
+			{FlagKey: "enabled", EntityId: "third"},
+		},
+	})
+
+	require.NoError(t, err)
+	require.Len(t, resp.Responses, 3)
+	assert.Equal(t, "batch-id", resp.RequestId)
+	assert.Greater(t, resp.RequestDurationMillis, float64(0))
+	assert.Equal(t, []string{"first", "second", "third"}, []string{
+		resp.Responses[0].EntityId, resp.Responses[1].EntityId, resp.Responses[2].EntityId,
+	})
+	for _, result := range resp.Responses {
+		assert.NotNil(t, result.Timestamp)
+		assert.Greater(t, result.RequestDurationMillis, float64(0))
+		assert.Empty(t, result.RequestId)
+	}
+	assert.Equal(t, "disabled", resp.Responses[1].FlagKey)
+	assert.False(t, resp.Responses[1].Match)
+	assert.Empty(t, resp.Responses[1].Value)
+	assert.Empty(t, resp.Responses[1].SegmentKey)
+	store.AssertNotCalled(t, "GetEvaluationRules", mock.Anything, "disabled")
+}
+
+func TestBatchEvaluate_OtherError(t *testing.T) {
+	store := &storeMock{}
+	s := &Server{logger: logger, store: store}
+	store.On("GetFlag", mock.Anything, "missing").Return(&flipt.Flag{}, errors.ErrNotFoundf("flag %q", "missing"))
+
+	resp, err := s.BatchEvaluate(context.TODO(), &flipt.BatchEvaluationRequest{
+		Requests: []*flipt.EvaluationRequest{{FlagKey: "missing", EntityId: "first"}},
+	})
+
+	require.Error(t, err)
+	assert.Nil(t, resp)
+	assert.EqualError(t, err, "flag \"missing\" not found")
+}
