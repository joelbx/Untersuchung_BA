+func (s *APITestSuite) TestKubeProxySettingsAddress(c *check.C) {
+	for _, test := range []struct {
+		listen string
+		public string
+		want   string
+	}{
+		{"0.0.0.0:8080", "", "proxy.example.com:8080"},
+		{"[::]:8081", "", "proxy.example.com:8081"},
+		{"kube.example.com:8082", "", "kube.example.com:8082"},
+		{"0.0.0.0:8080", "public.example.com:443", "public.example.com:443"},
+	} {
+		tc := &TeleportClient{Config: Config{WebProxyAddr: "proxy.example.com:3080"}}
+		err := tc.applyProxySettings(ProxySettings{Kube: KubeProxySettings{
+			Enabled: true, ListenAddr: test.listen, PublicAddr: test.public,
+		}})
+		c.Assert(err, check.IsNil)
+		c.Assert(tc.KubeProxyAddr, check.Equals, test.want)
+	}
+	tc := &TeleportClient{Config: Config{WebProxyAddr: "internal.example.com:3080"}}
+	err := tc.applyProxySettings(ProxySettings{
+		Kube: KubeProxySettings{Enabled: true, ListenAddr: "[::]:3026"},
+		SSH:  SSHProxySettings{PublicAddr: "public.example.com:443"},
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(tc.KubeProxyAddr, check.Equals, "public.example.com:3026")
+	conf := Config{WebProxyAddr: "proxy.example.com:3080", KubeProxyAddr: "[::]:8080"}
+	host, port := conf.KubeProxyHostPort()
+	c.Assert(host, check.Equals, "proxy.example.com")
+	c.Assert(port, check.Equals, 8080)
+}
