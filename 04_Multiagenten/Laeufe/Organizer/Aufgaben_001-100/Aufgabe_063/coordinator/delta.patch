+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	for _, test := range []struct {
+		name      string
+		yaml      string
+		wantAddr  string
+		wantError bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"default port", "proxy_service:\n  kube_listen_addr: proxy.example.com\n", "proxy.example.com:3026", false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:3026\n", "0.0.0.0:8080", false},
+		{"enabled legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", "", true},
+		{"conflicting listens", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    listen_addr: 127.0.0.1:3026\n", "", true},
+	} {
+		fc, err := ReadConfig(bytes.NewBufferString(test.yaml))
+		if test.wantError {
+			c.Assert(err, check.ErrorMatches, ".*kube_listen_addr conflicts.*", check.Commentf(test.name))
+			continue
+		}
+		c.Assert(err, check.IsNil, check.Commentf(test.name))
+		cfg := service.MakeDefaultConfig()
+		c.Assert(ApplyFileConfig(fc, cfg), check.IsNil, check.Commentf(test.name))
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true, check.Commentf(test.name))
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, test.wantAddr, check.Commentf(test.name))
+	}
+}
