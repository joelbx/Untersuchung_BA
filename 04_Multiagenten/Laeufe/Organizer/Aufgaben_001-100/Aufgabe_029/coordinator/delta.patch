+
+    def test_fixed_address_create_update_delete_and_check_mode(self):
+        for object_type, address_key, address in (
+                (api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr', '192.0.2.10'),
+                (api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr', '2001:db8::10')):
+            self.module.params = dict(provider=None, state='present', name='printer',
+                                      mac='00:11:22:33:44:55', network_view='default',
+                                      network='192.0.2.0/24', comment='new',
+                                      extattrs=None, options=None)
+            self.module.params[address_key] = address
+            spec = dict(name={}, mac={'ib_req': True}, network={'ib_req': True},
+                        network_view={'ib_req': True}, comment={}, extattrs={}, options={})
+            spec[address_key] = {'ib_req': True}
+            wapi = self._get_wapi(None)
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            lookup = wapi.get_object.call_args[0][1]
+            self.assertEqual(lookup, dict(mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                                          network_view='default', **{address_key: address}))
+            wapi.create_object.assert_called_once()
+
+            current = dict(lookup, name='printer', comment='old', _ref='fixed/ref')
+            wapi = self._get_wapi([current])
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            wapi.update_object.assert_called_once()
+
+            self.module.check_mode = True
+            wapi = self._get_wapi([dict(lookup, name='printer', comment='old', _ref='fixed/ref')])
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            wapi.update_object.assert_not_called()
+            self.module.check_mode = False
+
+            self.module.params['state'] = 'absent'
+            wapi = self._get_wapi([dict(lookup, name='printer', comment='new', _ref='fixed/ref')])
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            wapi.delete_object.assert_called_once_with('fixed/ref')
+
+    def test_fixed_address_removed_dhcp_option_is_a_change(self):
+        self.module.params = dict(provider=None, state='present', name='printer',
+                                  ipv4addr='192.0.2.10', mac='00:11:22:33:44:55',
+                                  network='192.0.2.0/24', network_view='default',
+                                  options=[dict(name='domain-name', value='example.com')])
+        spec = dict(name={}, ipv4addr={'ib_req': True}, mac={'ib_req': True},
+                    network={'ib_req': True}, network_view={'ib_req': True}, options={})
+        current = dict(name='printer', ipv4addr='192.0.2.10', mac='00:11:22:33:44:55',
+                       network='192.0.2.0/24', network_view='default', _ref='fixed/ref',
+                       options=[dict(name='domain-name', value='example.com'),
+                                dict(name='routers', value='192.0.2.1')])
+        wapi = self._get_wapi([current])
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.update_object.assert_called_once()
