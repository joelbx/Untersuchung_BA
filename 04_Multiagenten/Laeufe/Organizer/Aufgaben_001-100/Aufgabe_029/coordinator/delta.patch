@@ -0,0 +1,60 @@
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat import unittest
+from units.compat.mock import MagicMock, patch
+from ansible.modules.net_tools.nios import nios_fixed_address
+from ansible.module_utils.net_tools.nios import api
+
+
+class TestNiosFixedAddress(unittest.TestCase):
+
+    def test_options(self):
+        module = MagicMock()
+        module.params = {'options': [dict(name='domain-name', num=None, value='example.com',
+                                          use_option=True, vendor_class='DHCP')]}
+        self.assertEqual(nios_fixed_address.options(module),
+                         [dict(name='domain-name', value='example.com',
+                               use_option=True, vendor_class='DHCP')])
+        module.params['options'] = [dict(name=None, num=None, value='x')]
+        nios_fixed_address.options(module)
+        module.fail_json.assert_called_once()
+
+    def test_address_mapping(self):
+        for address, object_type, key in (
+                ('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')):
+            module = MagicMock()
+            module.params = {'ipaddr': address}
+            spec = {'ipaddr': {'ib_req': True}}
+            result_type, result_spec, result_module = nios_fixed_address.validate_ip_addr_type(
+                address, spec, module)
+            self.assertEqual(result_type, object_type)
+            self.assertEqual(result_spec, {key: {'ib_req': True}})
+            self.assertEqual(result_module.params, {key: address})
+
+    def test_main_uses_address_network_and_mac(self):
+        for address, object_type, key in (
+                ('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')):
+            module = MagicMock()
+            module.params = dict(name='printer', ipaddr=address, mac='00:11:22:33:44:55',
+                                 network='192.0.2.0/24', network_view='default',
+                                 options=None, extattrs=None, comment=None,
+                                 state='present', provider={})
+            with patch.object(nios_fixed_address, 'AnsibleModule', return_value=module) as constructor:
+                with patch.object(nios_fixed_address, 'WapiModule') as wapi:
+                    nios_fixed_address.main()
+            self.assertTrue(constructor.call_args[1]['argument_spec']['provider']['required'])
+            self.assertTrue(constructor.call_args[1]['supports_check_mode'])
+            self.assertEqual(wapi.return_value.run.call_args[0][0], object_type)
+            spec = wapi.return_value.run.call_args[0][1]
+            self.assertIn(key, spec)
+            self.assertNotIn('ipaddr', spec)
+            self.assertEqual(module.params[key], address)
+
+    def test_invalid_address(self):
+        module = MagicMock()
+        module.params = {'ipaddr': 'bad-address'}
+        nios_fixed_address.validate_ip_addr_type('bad-address', {'ipaddr': {}}, module)
+        module.fail_json.assert_called_once()
