+@pytest.mark.parametrize('am, stdin', [({'mode': {}}, {})], indirect=['am', 'stdin'])
+def test_new_files_warn_when_mode_omitted(atomic_am, atomic_mocks, isolated_warnings, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_mocks['umask'].side_effect = [0o022, 0, 0o022, 0]
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src1', '/path/to/dest1')
+    atomic_am.atomic_move('/path/to/src2', '/path/to/dest2')
+
+    assert atomic_am._created_files == {'/path/to/dest1', '/path/to/dest2'}
+    with pytest.raises(SystemExit):
+        atomic_am.exit_json()
+    result = json.loads(capfd.readouterr()[0])
+    assert result['warnings'] == [
+        "File '/path/to/dest1' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning.",
+        "File '/path/to/dest2' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning.",
+    ]
+
+
+@pytest.mark.parametrize('am, stdin', [({'mode': {}}, {'mode': '0600'}), ({}, {})], indirect=['am', 'stdin'])
+def test_new_file_without_omitted_mode_does_not_warn(atomic_am, atomic_mocks, isolated_warnings, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+
+    assert not atomic_am._created_files
+    with pytest.raises(SystemExit):
+        atomic_am.exit_json()
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
+
+
+@pytest.mark.parametrize('am, stdin', [({'mode': {}}, {})], indirect=['am', 'stdin'])
+def test_setting_mode_clears_atomic_move_warning(atomic_am, atomic_mocks, isolated_warnings, mocker, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert atomic_am._created_files == {'/path/to/dest'}
+
+    file_stat = mocker.MagicMock()
+    file_stat.st_mode = 0o600
+    mocker.patch('os.lstat', return_value=file_stat)
+    atomic_am.set_mode_if_different(b'/path/to/dest', '0600', False)
+
+    assert not atomic_am._created_files
+    with pytest.raises(SystemExit):
+        atomic_am.exit_json()
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
