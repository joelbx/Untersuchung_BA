+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport-based inline heights on the root and descendants', () => {
+        const root = document.createElement('div');
+        root.innerHTML =
+            '<section style="height: 50vh; color: red"><p style="height: calc(100vh - 2px) !important; width: 20px">Content</p></section>';
+        root.setAttribute('style', 'height: 25vh; margin: 4px');
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.margin).toBe('4px');
+        const section = root.querySelector('section') as HTMLElement;
+        const paragraph = root.querySelector('p') as HTMLElement;
+        expect(section.style.height).toBe('auto');
+        expect(section.style.color).toBe('red');
+        expect(paragraph.style.height).toBe('auto');
+        expect(paragraph.style.getPropertyPriority('height')).toBe('important');
+        expect(paragraph.style.width).toBe('20px');
+    });
+
+    it('leaves other height units and unrelated styles unchanged', () => {
+        const root = document.createElement('div');
+        root.innerHTML =
+            '<div style="height: 50%; width: 20vh"></div><div style="height: 10px"></div><div style="color: blue"></div>';
+
+        transformStyleAttributes(root);
+
+        const elements = root.querySelectorAll('div');
+        expect((elements[0] as HTMLElement).style.height).toBe('50%');
+        expect((elements[0] as HTMLElement).style.width).toBe('20vh');
+        expect((elements[1] as HTMLElement).style.height).toBe('10px');
+        expect((elements[2] as HTMLElement).style.color).toBe('blue');
+    });
+});
diff --git a/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
