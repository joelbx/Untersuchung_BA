+def test_get_ia_record_normalizes_mixed_and_empty_metadata() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'publisher': [' Plain Press ', ' Boston : Beacon Press ', '', ' : '],
+            'isbn': [' 0-12345678-9 ', ' 978 1234567890 ', 'invalid', ''],
+        }
+    )
+    assert result['publishers'] == ['Plain Press', 'Beacon Press']
+    assert result['publish_places'] == ['Boston']
+    assert result['isbn_10'] == ['0123456789']
+    assert result['isbn_13'] == ['9781234567890']
+    assert 'isbn' not in result
+    assert 'publisher' not in result
+
+    empty_result = code.ia_importapi.get_ia_record(
+        {'publisher': ['  ', ' : '], 'isbn': ['', 'unknown']}
+    )
+    assert not {'publishers', 'publish_places', 'isbn_10', 'isbn_13'} & empty_result.keys()
