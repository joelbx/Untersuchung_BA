+    def test_jwrite_is_atomic(self, tmpdir, monkeypatch):
+        path = str(tmpdir.join('job'))
+        monkeypatch.setattr(async_wrapper, 'job_path', path, raising=False)
+        async_wrapper.jwrite({'ansible_job_id': 'job.1', 'finished': 0})
+
+        original_rename = async_wrapper.os.rename
+
+        def check_before_rename(source, target):
+            with open(target) as stream:
+                assert json.load(stream)['finished'] == 0
+            with open(source) as stream:
+                assert json.load(stream)['finished'] == 1
+            original_rename(source, target)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', check_before_rename)
+        async_wrapper.jwrite({'ansible_job_id': 'job.1', 'finished': 1})
+        with open(path) as stream:
+            assert json.load(stream)['finished'] == 1
+        assert not os.path.exists(path + '.tmp')
+
+    def test_initial_fork_failure(self, tmpdir, monkeypatch, capsys):
+        monkeypatch.setattr(async_wrapper.sys, 'argv',
+                            ['async_wrapper', 'job', '10', '/tmp/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmpdir))
+
+        def fail_fork():
+            raise OSError(11, 'temporarily unavailable')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['finished'] == 1
+        assert response['ansible_job_id'].startswith('job.')
+        with open(str(tmpdir.join(response['ansible_job_id']))) as stream:
+            assert json.load(stream)['ansible_job_id'] == response['ansible_job_id']
+
+    def test_bad_arguments(self, monkeypatch, capsys):
+        monkeypatch.setattr(async_wrapper.sys, 'argv', ['async_wrapper'])
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['finished'] == 1
+        assert response['msg'].startswith('usage:')
+
+    def test_directory_failure_is_json(self, tmpdir, monkeypatch, capsys):
+        monkeypatch.setattr(async_wrapper.sys, 'argv',
+                            ['async_wrapper', 'job', '10', '/tmp/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmpdir.join('jobs')))
+
+        def fail_directory(path):
+            raise OSError(13, 'permission denied')
+
+        monkeypatch.setattr(async_wrapper, '_make_temp_dir', fail_directory)
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['finished'] == 1
+        assert response['ansible_job_id'].startswith('job.')
+        assert 'could not create' in response['msg']
+
+    def test_timeout_writes_finished_result(self, tmpdir):
+        module = tmpdir.join('slow-module.py')
+        module.write('#!%s\nimport time\ntime.sleep(20)\n' % sys.executable)
+        os.chmod(str(module), 0o755)
+        jobdir = tmpdir.mkdir('jobs')
+        env = os.environ.copy()
+        env['ANSIBLE_ASYNC_DIR'] = str(jobdir)
+        env['PYTHONPATH'] = os.path.join(os.path.dirname(async_wrapper.__file__), '..', '..')
+        output = subprocess.check_output(
+            [sys.executable, '-m', 'ansible.modules.async_wrapper',
+             'timeout', '1', str(module), '_', '-preserve_tmp'],
+            env=env)
+        response = json.loads(output)
+        assert response['started'] == 1
+        assert response['finished'] == 0
+        assert response['_ansible_suppress_tmpdir_delete'] is True
+
+        deadline = time.time() + 8
+        while time.time() < deadline:
+            with open(response['results_file']) as stream:
+                result = json.load(stream)
+            if result['finished']:
+                break
+            time.sleep(0.1)
+        assert result['failed'] is True
+        assert result['ansible_job_id'] == response['ansible_job_id']
+        assert result['child_pid'] > 0
+        assert 'time limit' in result['msg']
