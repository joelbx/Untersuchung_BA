+def remove_author_honorifics(name: str) -> str:
+    """Remove a leading honorific when another name follows it."""
+    if _normalized_name(name) in {
+        _normalized_name(exception) for exception in HONORIFC_NAME_EXECPTIONS
+    }:
+        return name
+    for honorific in HONORIFICS:
+        match = re.match(r'^\s*' + re.escape(honorific) + r'(?=\s|$)', name, re.I)
+        if match and name[match.end() :].strip():
+            return name[match.end() :].lstrip()
+    return name
 
 
