index 0000000..70bb981
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,35 @@
+import { HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ children, open, role, ...rest }, ref) => {
+    const supportsDialog =
+        typeof HTMLDialogElement !== 'undefined' &&
+        typeof HTMLDialogElement.prototype.showModal === 'function' &&
+        typeof HTMLDialogElement.prototype.close === 'function';
+
+    if (!supportsDialog) {
+        return (
+            <div
+                {...(rest as HTMLAttributes<HTMLDivElement>)}
+                role={role || 'dialog'}
+                hidden={!open}
+                ref={ref as Ref<HTMLDivElement>}
+            >
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} role={role} open={open} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
