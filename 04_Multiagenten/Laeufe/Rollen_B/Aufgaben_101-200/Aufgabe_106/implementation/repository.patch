+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+
+	packages := models.WordPressPackages{
+		{Name: "core", Type: models.WPCore, Version: "5.0"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: "inactive", Version: "1.0"},
+	}
+	coreBody := "{}"
+	cache := map[string]*string{"50": &coreBody}
+	for name, id := range map[string]string{
+		"active-theme": "1", "inactive-theme": "2",
+		"active-plugin": "3", "inactive-plugin": "4",
+	} {
+		body := `{"package":{"vulnerabilities":[{"id":` + id + `,"fixed_in":"2.0"}]}}`
+		cache[name] = &body
+	}
+
+	for _, tc := range []struct {
+		ignoreInactive bool
+		wantCount      int
+	}{
+		{ignoreInactive: true, wantCount: 2},
+		{ignoreInactive: false, wantCount: 4},
+	} {
+		config.Conf.WpIgnoreInactive = !tc.ignoreInactive
+		config.Conf.Servers = map[string]config.ServerInfo{
+			"wordpress-test": {WordPress: config.WordPressConf{IgnoreInactive: tc.ignoreInactive}},
+		}
+		r := &models.ScanResult{
+			ServerName:        "wordpress-test",
+			WordPressPackages: &packages,
+			ScannedCves:       models.VulnInfos{},
+		}
+		count, err := FillWordPress(r, "unused", cache)
+		if err != nil {
+			t.Fatalf("ignoreInactive=%v: %v", tc.ignoreInactive, err)
+		}
+		if count != tc.wantCount || len(r.ScannedCves) != tc.wantCount {
+			t.Errorf("ignoreInactive=%v: got %d matches and %d CVEs, want %d", tc.ignoreInactive, count, len(r.ScannedCves), tc.wantCount)
+		}
+	}
+}
