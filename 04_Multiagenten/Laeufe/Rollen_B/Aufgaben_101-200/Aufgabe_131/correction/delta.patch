+it('starts attempts on fixed intervals even when calls take time', async () => {
+    const call = jest.fn(() => new Promise<void>((resolve) => setTimeout(resolve, 2000)));
+    mockUseEventManager.mockReturnValue({ call, subscribe: jest.fn() });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current();
+
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(1);
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(2);
+    await jest.advanceTimersByTimeAsync(interval * (maxPollingSteps - 2));
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    await jest.advanceTimersByTimeAsync(2000);
+    await polling;
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
+it('skips ticks while a call is pending without overlapping or exceeding the maximum', async () => {
+    let releaseCall: () => void = () => {};
+    const call = jest.fn(
+        () =>
+            new Promise<void>((resolve) => {
+                releaseCall = resolve;
+            })
+    );
+    mockUseEventManager.mockReturnValue({ call, subscribe: jest.fn() });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current();
+
+    await jest.advanceTimersByTimeAsync(interval * 2);
+    expect(call).toHaveBeenCalledTimes(1);
+    releaseCall();
+    await Promise.resolve();
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(2);
+    releaseCall();
+    await Promise.resolve();
+    for (let attempt = 3; attempt <= maxPollingSteps; attempt += 1) {
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(attempt);
+        releaseCall();
+        await Promise.resolve();
+    }
+    await polling;
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
