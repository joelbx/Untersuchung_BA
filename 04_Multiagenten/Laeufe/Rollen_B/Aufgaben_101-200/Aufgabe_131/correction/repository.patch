diff --git a/packages/components/payments/client-extensions/usePollEvents.test.ts b/packages/components/payments/client-extensions/usePollEvents.test.ts
new file mode 100644
index 0000000..2e331bc
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.ts
@@ -0,0 +1,183 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+
+import { useEventManager } from '../../hooks';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+jest.mock('../../hooks', () => ({ useEventManager: jest.fn() }));
+
+const mockUseEventManager = useEventManager as jest.Mock;
+
+beforeEach(() => {
+    jest.useFakeTimers();
+    jest.clearAllMocks();
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+it('calls once per interval and stops after five attempts without a subscription', async () => {
+    const call = jest.fn().mockResolvedValue(undefined);
+    const subscribe = jest.fn();
+    mockUseEventManager.mockReturnValue({ call, subscribe });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current();
+
+    expect(interval).toBe(5000);
+    expect(maxPollingSteps).toBe(5);
+    expect(call).not.toHaveBeenCalled();
+    await jest.advanceTimersByTimeAsync(interval - 1);
+    expect(call).not.toHaveBeenCalled();
+    await jest.advanceTimersByTimeAsync(1);
+    expect(call).toHaveBeenCalledTimes(1);
+    await jest.advanceTimersByTimeAsync(interval * (maxPollingSteps - 1));
+    await polling;
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(subscribe).not.toHaveBeenCalled();
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
+it('starts attempts on fixed intervals even when calls take time', async () => {
+    const call = jest.fn(() => new Promise<void>((resolve) => setTimeout(resolve, 2000)));
+    mockUseEventManager.mockReturnValue({ call, subscribe: jest.fn() });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current();
+
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(1);
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(2);
+    await jest.advanceTimersByTimeAsync(interval * (maxPollingSteps - 2));
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    await jest.advanceTimersByTimeAsync(2000);
+    await polling;
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
+it('skips ticks while a call is pending without overlapping or exceeding the maximum', async () => {
+    let releaseCall: () => void = () => {};
+    const call = jest.fn(
+        () =>
+            new Promise<void>((resolve) => {
+                releaseCall = resolve;
+            })
+    );
+    mockUseEventManager.mockReturnValue({ call, subscribe: jest.fn() });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current();
+
+    await jest.advanceTimersByTimeAsync(interval * 2);
+    expect(call).toHaveBeenCalledTimes(1);
+    releaseCall();
+    await Promise.resolve();
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(2);
+    releaseCall();
+    await Promise.resolve();
+    for (let attempt = 3; attempt <= maxPollingSteps; attempt += 1) {
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(attempt);
+        releaseCall();
+        await Promise.resolve();
+    }
+    await polling;
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
+it('continues after unrelated events, then unsubscribes on a matching action', async () => {
+    const call = jest.fn().mockResolvedValue(undefined);
+    const unsubscribe = jest.fn();
+    let handler: (events: Record<string, { Action: EVENT_ACTIONS }[]>) => void = () => {};
+    const subscribe = jest.fn((listener) => {
+        handler = listener;
+        return unsubscribe;
+    });
+    mockUseEventManager.mockReturnValue({ call, subscribe });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    handler({ Credits: [{ Action: EVENT_ACTIONS.CREATE }] });
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(1);
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }, { Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes after exhausting attempts and ignores late events', async () => {
+    const call = jest.fn().mockResolvedValue(undefined);
+    const unsubscribe = jest.fn();
+    let handler: (events: Record<string, { Action: EVENT_ACTIONS }[]>) => void = () => {};
+    mockUseEventManager.mockReturnValue({
+        call,
+        subscribe: (listener: typeof handler) => {
+            handler = listener;
+            return unsubscribe;
+        },
+    });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    await polling;
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('cleans up when a matching event arrives during a pending call', async () => {
+    let releaseCall: () => void = () => {};
+    const call = jest.fn(
+        () =>
+            new Promise<void>((resolve) => {
+                releaseCall = resolve;
+            })
+    );
+    const unsubscribe = jest.fn();
+    let handler: (events: Record<string, { Action: EVENT_ACTIONS }[]>) => void = () => {};
+    mockUseEventManager.mockReturnValue({
+        call,
+        subscribe: (listener: typeof handler) => {
+            handler = listener;
+            return unsubscribe;
+        },
+    });
+    const { result } = renderHook(usePollEvents);
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    await jest.advanceTimersByTimeAsync(interval);
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    releaseCall();
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('cleans up a match delivered before subscribe returns', async () => {
+    const call = jest.fn().mockResolvedValue(undefined);
+    const unsubscribe = jest.fn();
+    mockUseEventManager.mockReturnValue({
+        call,
+        subscribe: (handler: (events: Record<string, { Action: EVENT_ACTIONS }[]>) => void) => {
+            handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+            return unsubscribe;
+        },
+    });
+    const { result } = renderHook(usePollEvents);
+    await result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    expect(call).not.toHaveBeenCalled();
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
