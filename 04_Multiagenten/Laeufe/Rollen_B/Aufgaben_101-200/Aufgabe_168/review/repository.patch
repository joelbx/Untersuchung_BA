@@ -609,6 +609,42 @@ interface IBaseProps {
     stopUpdating(): void;
 }
 
+type AdminActionLock = {
+    isPending(member: RoomMember): boolean;
+    run(member: RoomMember, action: () => Promise<void>, errorTitle: string): Promise<void>;
+};
+
+const AdminActionContext = React.createContext<AdminActionLock | null>(null);
+
+function useAdminActionLock(): AdminActionLock {
+    const active = useRef(new Set<string>());
+    const [pending, setPending] = useState(new Set<string>());
+    const keyFor = (member: RoomMember): string => `${member.roomId}\0${member.userId}`;
+
+    return {
+        isPending: (member) => pending.has(keyFor(member)),
+        run: async (member, action, errorTitle) => {
+            const key = keyFor(member);
+            // The ref closes the gap before React commits the disabled state.
+            if (active.current.has(key)) return;
+            active.current.add(key);
+            setPending(new Set(active.current));
+            try {
+                await action();
+            } catch (err) {
+                logger.error("Admin action failed: ", err);
+                Modal.createDialog(ErrorDialog, {
+                    title: errorTitle,
+                    description: err instanceof Error ? err.message : _t("Operation failed"),
+                });
+            } finally {
+                active.current.delete(key);
+                setPending(new Set(active.current));
+            }
+        },
+    };
+}
