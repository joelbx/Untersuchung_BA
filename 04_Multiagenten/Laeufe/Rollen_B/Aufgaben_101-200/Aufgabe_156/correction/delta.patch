     if isinstance(value, Mapping):
-        pairs = zip(keys, children)
+        # Distinct keys can acquire the same redacted name. Keep every value
+        # under that name instead of silently overwriting the earlier ones.
+        pairs = []
+        positions = {}
+        collisions = set()
+        for key, child in zip(keys, children):
+            if key in positions:
+                position = positions[key]
+                if key in collisions:
+                    pairs[position][1].append(child)
+                else:
+                    pairs[position] = (key, [pairs[position][1], child])
+                    collisions.add(key)
+            else:
+                positions[key] = len(pairs)
+                pairs.append((key, child))
