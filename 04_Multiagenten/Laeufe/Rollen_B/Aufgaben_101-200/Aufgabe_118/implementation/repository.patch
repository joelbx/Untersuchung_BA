+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_uses_current_interpreter(mocker):
+    module = mocker.Mock()
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+
+    assert pip._get_pip(module) == [pip.sys.executable, '-m', 'pip']
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_uses_explicit_executable(mocker):
+    module = mocker.Mock()
+    module.get_bin_path.return_value = '/usr/bin/custom-pip'
+    have_pip = mocker.patch.object(pip, '_have_pip_module')
+
+    assert pip._get_pip(module, executable='custom-pip') == ['/usr/bin/custom-pip']
+    have_pip.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_have_pip_module_treats_detection_error_as_unavailable(mocker):
+    importlib_util = pytest.importorskip('importlib.util')
+    mocker.patch.object(importlib_util, 'find_spec', side_effect=ValueError('bad spec'))
+
+    assert not pip._have_pip_module()
+
+
+@pytest.mark.parametrize('list_rc, expected_command', [
+    (0, ['python', '-m', 'pip', 'list', '--format=freeze']),
+    (1, ['python', '-m', 'pip', 'freeze']),
+])
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_packages_uses_argv_and_reports_command(mocker, list_rc, expected_command):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(list_rc, 'packages', 'warning'), (0, 'frozen', '')]
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    command, out, err = pip._get_packages(module, ['python', '-m', 'pip'], '/tmp')
+
+    assert command == ' '.join(expected_command)
+    assert (out, err) == (('packages', 'warning') if list_rc == 0 else ('frozen', ''))
+    assert module.run_command.call_args[0][0] == expected_command
+
+
