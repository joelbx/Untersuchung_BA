+// proxyClientAddr reads the optional Teleport SSH metadata without consuming it.
+// The SSH server still needs the original header for tracing propagation.
+func proxyClientAddr(reader *bufio.Reader) net.Addr {
+	if start, err := reader.Peek(8); err != nil || !bytes.HasPrefix(teleportProxyPrefix, start) {
+		return nil
+	}
+	if prefix, err := reader.Peek(len(teleportProxyPrefix)); err != nil || !bytes.Equal(prefix, teleportProxyPrefix) {
+		return nil
+	}
+	// A bound keeps an unterminated header from consuming the connection's
+	// entire read deadline. The SSH server will reject it as invalid SSH.
+	for size := len(teleportProxyPrefix) + 1; size <= reader.Size(); size++ {
+		in, err := reader.Peek(size)
+		if err != nil {
+			return nil
+		}
+		if in[size-1] != 0 {
+			continue
+		}
+		var payload apissshutils.HandshakePayload
+		if json.Unmarshal(in[len(teleportProxyPrefix):size-1], &payload) != nil || payload.ClientAddr == "" {
+			return nil
+		}
+		addr, err := utils.ParseAddr(payload.ClientAddr)
+		if err != nil {
+			return nil
+		}
+		if addr.AddrNetwork == "tcp" {
+			return &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}
+		}
+		return addr
+	}
+	return nil
+}
