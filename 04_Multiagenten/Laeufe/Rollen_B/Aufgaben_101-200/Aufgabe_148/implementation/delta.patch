+func TestDetectTeleportProxySSH(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		header   string
+		wantAddr string
+	}{
+		{"client address", apissshutils.ProxyHelloSignature + `{"clientAddr":"192.0.2.10:1234"}` + "\x00", "192.0.2.10:1234"},
+		{"no client address", apissshutils.ProxyHelloSignature + `{}` + "\x00", "pipe"},
+		{"invalid JSON", apissshutils.ProxyHelloSignature + `{bad}` + "\x00", "pipe"},
+		{"standard SSH", "", "pipe"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server, client := net.Pipe()
+			defer server.Close()
+			defer client.Close()
+			wire := tc.header + "SSH-2.0-test\r\n"
+			go func() {
+				for _, part := range []string{wire[:5], wire[5:]} {
+					if _, err := client.Write([]byte(part)); err != nil {
+						return
+					}
+				}
+			}()
+			conn, err := detect(server, false)
+			require.NoError(t, err)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			require.Equal(t, tc.wantAddr, conn.RemoteAddr().String())
+			got := make([]byte, len(wire))
+			_, err = io.ReadFull(conn, got)
+			require.NoError(t, err)
+			require.Equal(t, wire, string(got))
+		})
+	}
+}
