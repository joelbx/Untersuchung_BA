@@ -0,0 +1,69 @@
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+import { replaceURLs } from './url';
+
+describe('assistant Markdown conversion', () => {
+    it('moves incorrectly nested lists into their preceding list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+
+        fixNestedLists(dom);
+
+        expect(dom.body.innerHTML).toBe('<ul><li>Parent<ul><li>Child</li></ul></li></ul>');
+    });
+
+    it('keeps ordered and nested list markers through conversion', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First<ul><li>Nested</li></ul></li><li>Second</li></ol>';
+
+        const markdown = htmlToMarkdown(dom);
+        const rendered = markdownToHTML(markdown);
+
+        expect(markdown).toContain('1. First');
+        expect(markdown).toContain('2. Second');
+        expect(rendered).toContain('<ol>');
+        expect(rendered).toContain('<ul>');
+    });
+
+    it('does not normalize list-looking lines inside indented code', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<pre><code>-   keep spaces</code></pre><ul><li>List item</li></ul>';
+
+        const markdown = htmlToMarkdown(dom);
+
+        expect(markdown).toContain('    -   keep spaces');
+        expect(markdown).toContain('- List item');
+    });
+
+    it('preserves link and image class and style across conversion', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<p><a href="#1" class="link" style="color: red">Link</a><img src="#2" class="photo" style="width: 10px"></p>';
+
+        const rendered = markdownToHTML(htmlToMarkdown(dom));
+
+        expect(rendered).toContain('class="link"');
+        expect(rendered).toContain('style="color: red"');
+        expect(rendered).toContain('class="photo"');
+        expect(rendered).toContain('style="width: 10px"');
+    });
+
+    it('restores only the originating message in rendered assistant HTML', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<a href="https://example.com" class="link" style="color: red">Link</a><img src="https://example.com/a.png" class="photo" style="width: 10px">';
+        const markdown = htmlToMarkdown(replaceURLs(dom, 'uid', 'message-1'));
+
+        const restored = parseModelResult(markdown, 'message-1');
+        const otherMessage = parseModelResult(markdown, 'message-2');
+
+        expect(restored).toContain('https://example.com');
+        expect(restored).toContain('class="link"');
+        expect(restored).toContain('class="photo"');
+        expect(restored).toContain('color: red');
+        expect(restored).toContain('width: 10px');
+        expect(otherMessage).toContain('Link');
+        expect(otherMessage).not.toContain('<a');
+        expect(otherMessage).not.toContain('<img');
+    });
+});
