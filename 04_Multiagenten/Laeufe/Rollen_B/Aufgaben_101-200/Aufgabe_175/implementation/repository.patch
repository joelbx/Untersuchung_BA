@@ -0,0 +1,63 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	dir := t.TempDir()
+	previous := conf.Server.Backup
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 0
+	t.Cleanup(func() { conf.Server.Backup = previous })
+
+	path := filepath.Join(dir, "live.db")
+	conn, err := sql.Open(Driver, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetMaxOpenConns(1)
+	d := &db{readDB: conn, writeDB: conn}
+	ctx := context.Background()
+	if _, err := conn.Exec("PRAGMA journal_mode=WAL"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	backupPath, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(backupPath); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.Exec("UPDATE items SET value = 'changed'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(ctx, backupPath); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := conn.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "original" {
+		t.Fatalf("restored value = %q, error = %v", value, err)
+	}
+	if _, err := d.Backup(ctx); err != nil {
+		t.Fatal(err)
+	}
+	conf.Server.Backup.Count = 1
+	pruned, err := d.Prune(ctx)
+	if err != nil || pruned != 1 {
+		t.Fatalf("pruned = %d, error = %v", pruned, err)
+	}
+	if _, err := os.Stat(backupPath); !os.IsNotExist(err) {
+		t.Fatalf("old backup should be removed: %v", err)
+	}
+}
