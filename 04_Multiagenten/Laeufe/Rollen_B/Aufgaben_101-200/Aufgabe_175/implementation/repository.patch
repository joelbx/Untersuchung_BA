diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..f690dfe
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,170 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupSuffix = ".db"
+
+// copySQLite uses SQLite's online backup API so the copy includes committed WAL data.
+func copySQLite(ctx context.Context, destination, source *sql.DB) error {
+	destConn, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	srcConn, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	return destConn.Raw(func(destDriver any) error {
+		return srcConn.Raw(func(srcDriver any) error {
+			backup, err := destDriver.(*sqlite3.SQLiteConn).Backup("main", srcDriver.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, os.ModePerm); err != nil {
+		return "", err
+	}
+	// A nanosecond timestamp preserves lexical ordering and avoids collisions.
+	path := filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format("20060102T150405.000000000Z")+backupSuffix)
+	if _, err := os.Stat(path); err == nil {
+		return "", fmt.Errorf("backup already exists: %s", path)
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return "", err
+	}
+	tmp, err := os.CreateTemp(conf.Server.Backup.Path, ".navidrome_backup_*.db")
+	if err != nil {
+		return "", err
+	}
+	tmpPath := tmp.Name()
+	if err := tmp.Close(); err != nil {
+		_ = os.Remove(tmpPath)
+		return "", err
+	}
+	defer os.Remove(tmpPath)
+	dest, err := sql.Open(Driver, tmpPath)
+	if err != nil {
+		return "", err
+	}
+	err = copySQLite(ctx, dest, d.writeDB)
+	closeErr := dest.Close()
+	if err != nil {
+		return "", err
+	}
+	if closeErr != nil {
+		return "", closeErr
+	}
+	if err := os.Rename(tmpPath, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not regular: %s", path)
+	}
+	// SQLite opens missing files by default. Read-only mode prevents an empty
+	// database from being silently created for an invalid backup path.
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	u := url.URL{Scheme: "file", Path: filepath.ToSlash(absPath), RawQuery: "mode=ro"}
+	src, err := sql.Open(Driver, u.String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var result string
+	if err := src.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("invalid backup: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("invalid backup: integrity_check returned %s", result)
+	}
+	return copySQLite(ctx, d.writeDB, src)
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count cannot be negative")
+	}
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is not configured")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var files []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if !entry.Type().IsRegular() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, backupSuffix) {
+			continue
+		}
+		stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), backupSuffix)
+		if _, err := time.Parse("20060102T150405.000000000Z", stamp); err == nil {
+			files = append(files, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	count := 0
+	for _, name := range files[min(conf.Server.Backup.Count, len(files)):] {
+		if err := ctx.Err(); err != nil {
+			return count, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return count, err
+		}
+		count++
+	}
+	return count, nil
+}
