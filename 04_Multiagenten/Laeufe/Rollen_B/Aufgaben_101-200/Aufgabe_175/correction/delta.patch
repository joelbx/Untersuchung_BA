diff --git a/db/backup.go b/db/backup.go
index f690dfe..d03b90b 100644
--- a/db/backup.go
+++ b/db/backup.go
@@ -128,6 +128,27 @@ func (d *db) Restore(ctx context.Context, path string) error {
 	if result != "ok" {
 		return fmt.Errorf("invalid backup: integrity_check returned %s", result)
 	}
+	// A valid SQLite file is not necessarily a Navidrome database. Check the
+	// migration metadata and core tables before replacing the live database.
+	var tableCount int
+	err = src.QueryRowContext(ctx, `SELECT count(*) FROM sqlite_master
+		WHERE type = 'table' AND name IN
+		('goose_db_version', 'album', 'artist', 'media_file', 'property', 'user')`).Scan(&tableCount)
+	if err != nil {
+		return fmt.Errorf("invalid backup: checking Navidrome schema: %w", err)
+	}
+	if tableCount != 6 {
+		return errors.New("invalid backup: Navidrome schema not found")
+	}
+	var hasMigration bool
+	if err := src.QueryRowContext(ctx, `SELECT EXISTS (
+		SELECT 1 FROM goose_db_version WHERE version_id > 0 AND is_applied = 1
+	)`).Scan(&hasMigration); err != nil {
+		return fmt.Errorf("invalid backup: checking Navidrome migrations: %w", err)
+	}
+	if !hasMigration {
+		return errors.New("invalid backup: Navidrome migration history not found")
+	}
 	return copySQLite(ctx, d.writeDB, src)
 }
 
