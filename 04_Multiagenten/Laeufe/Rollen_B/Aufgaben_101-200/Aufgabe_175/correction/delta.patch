+
+func TestRestoreRejectsUnrelatedSQLiteDatabase(t *testing.T) {
+	dir := t.TempDir()
+	live, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	unrelatedPath := filepath.Join(dir, "unrelated.db")
+	unrelated, err := sql.Open(Driver, unrelatedPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := unrelated.Exec("CREATE TABLE other (value TEXT)"); err != nil {
+		t.Fatal(err)
+	}
+	if err := unrelated.Close(); err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: live, writeDB: live}
+	if err := d.Restore(context.Background(), unrelatedPath); err == nil {
+		t.Fatal("expected unrelated SQLite database to be rejected")
+	}
+	var value string
+	if err := live.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "original" {
+		t.Fatalf("live database changed: value = %q, error = %v", value, err)
+	}
+}
