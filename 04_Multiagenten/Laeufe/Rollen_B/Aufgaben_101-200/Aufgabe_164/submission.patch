+func TestImport_NestedMetadataAndJSONHeader(t *testing.T) {
+	metadata := map[string]any{
+		"config": map[string]any{
+			"enabled": true,
+			"items":   []any{map[string]any{"name": "first"}, "second"},
+		},
+	}
+	expectedMetadata, err := structpb.NewStruct(metadata)
+	require.NoError(t, err)
+
+	tests := []struct {
+		name  string
+		enc   Encoding
+		input string
+	}{
+		{
+			name: "yaml",
+			enc:  EncodingYAML,
+			input: `namespace:
+  key: other
+  name: Other
+  description: Other namespace
+flags:
+  - key: flag
+    name: Flag
+    enabled: true
+    metadata:
+      config:
+        enabled: true
+        items:
+          - name: first
+          - second
+    variants:
+      - key: variant
+        attachment:
+          nested:
+            values: [one, two]
+`,
+		},
+		{
+			name:  "json",
+			enc:   EncodingJSON,
+			input: `{"namespace":{"key":"other","name":"Other","description":"Other namespace"},"flags":[{"key":"flag","name":"Flag","enabled":true,"metadata":{"config":{"enabled":true,"items":[{"name":"first"},"second"]}},"variants":[{"key":"variant","attachment":{"nested":{"values":["one","two"]}}}]}]}`,
+		},
+		{
+			name:  "json with export header",
+			enc:   EncodingJSON,
+			input: "# exported by Flipt\n\n" + `{"namespace":{"key":"other","name":"Other","description":"Other namespace"},"flags":[{"key":"flag","name":"Flag","enabled":true,"metadata":{"config":{"enabled":true,"items":[{"name":"first"},"second"]}},"variants":[{"key":"variant","attachment":{"nested":{"values":["one","two"]}}}]}]}`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "other", Name: "Other", Description: "Other namespace"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "other", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, expectedMetadata, creator.createflagReqs[0].Metadata)
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":{"values":["one","two"]}}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		" # header\n{}",
+		"# first\n# second\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.Error(t, err)
+	}
+}
