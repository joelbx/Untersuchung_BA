+func TestIsValidImage(t *testing.T) {
+	tests := []struct {
+		name  string
+		image Image
+		err   string
+	}{
+		{"missing name", Image{Tag: "latest"}, "Invalid arguments : no image name"},
+		{"missing identifier", Image{Name: "alpine"}, "Invalid arguments : no image tag and digest"},
+		{"both identifiers", Image{Name: "alpine", Tag: "latest", Digest: "sha256:abc"}, "Invalid arguments : you can either set image tag or digest"},
+		{"tag", Image{Name: "alpine", Tag: "latest"}, ""},
+		{"digest", Image{Name: "alpine", Digest: "sha256:abc"}, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := IsValidImage(tt.image)
+			if tt.err == "" {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+			} else if err == nil || err.Error() != tt.err {
+				t.Fatalf("expected %q, got %v", tt.err, err)
+			}
+		})
+	}
+}
+
+func TestImageGetFullName(t *testing.T) {
+	for _, tt := range []struct {
+		image Image
+		want  string
+	}{
+		{Image{Name: "alpine", Tag: "latest"}, "alpine:latest"},
+		{Image{Name: "alpine", Digest: "sha256:abc"}, "alpine@sha256:abc"},
+		{Image{Name: "alpine", Tag: "latest", Digest: "sha256:abc"}, "alpine@sha256:abc"},
+	} {
+		if got := tt.image.GetFullName(); got != tt.want {
+			t.Errorf("GetFullName() = %q, want %q", got, tt.want)
+		}
+	}
+}
