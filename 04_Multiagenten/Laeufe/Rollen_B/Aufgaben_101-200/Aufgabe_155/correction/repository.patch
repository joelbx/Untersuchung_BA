+func TestEnsureUUIDsImageDigest(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		serverName string
+	}{
+		{name: "0", serverName: "host"},
+		{name: "team@prod", serverName: "host"},
+		{name: "0", serverName: "region@host"},
+	} {
+		t.Run(tc.name+"@"+tc.serverName, func(t *testing.T) {
+			previous := config.Conf
+			defer func() { config.Conf = previous }()
+			config.Conf = config.Config{Servers: map[string]config.ServerInfo{
+				tc.serverName: {
+					ServerName: tc.serverName,
+					Images: map[string]config.Image{
+						tc.name: {Name: "alpine", Digest: "sha256:abc"},
+					},
+				},
+			}}
+			if tc.name == "team@prod" {
+				config.Conf.Servers["prod@host"] = config.ServerInfo{ServerName: "prod@host"}
+			}
+			dir, err := ioutil.TempDir("", "vuls-image-report-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer os.RemoveAll(dir)
+			configPath := filepath.Join(dir, "config.toml")
+			if err := ioutil.WriteFile(configPath, []byte(""), 0600); err != nil {
+				t.Fatal(err)
+			}
+			imageServerName := tc.name + "@" + tc.serverName
+			results := models.ScanResults{{
+				ServerName: imageServerName,
+				Image:      models.Image{Name: "alpine", Digest: "sha256:abc"},
+			}}
+			if err := EnsureUUIDs(configPath, results); err != nil {
+				t.Fatal(err)
+			}
+			if _, ok := config.Conf.Servers[imageServerName]; ok {
+				t.Fatal("image server created a separate config entry")
+			}
+			if tc.name == "team@prod" && len(config.Conf.Servers["prod@host"].UUIDs) != 0 {
+				t.Fatal("image UUID was assigned to the wrong server")
+			}
+			key := "alpine@sha256:abc@" + imageServerName
+			if got := config.Conf.Servers[tc.serverName].UUIDs[key]; got == "" || got != results[0].ServerUUID {
+				t.Errorf("image UUID key or result UUID missing: %q", got)
+			}
+		})
+	}
+}
