+SIZES = ('', 's', 'm', 'l')
+
+
+def _size(size):
+    size = size.lower()
+    if size not in SIZES:
+        raise ValueError('size must be one of: original, s, m, l')
+    return size
+
+
+@contextmanager
+def _archive_lock():
+    """Serialize archive and finalization work sharing this data root."""
+    folder = os.path.join(config.data_root, 'items')
+    os.makedirs(folder, exist_ok=True)
+    with open(os.path.join(folder, '.archive.lock'), 'a+b') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock, fcntl.LOCK_UN)
