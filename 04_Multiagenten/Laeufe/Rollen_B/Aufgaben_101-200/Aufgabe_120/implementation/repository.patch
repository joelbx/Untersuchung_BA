+class Cover:
+    def __init__(self, attributes):
+        self.__dict__.update(attributes)
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        number = int(cover_id)
+        if not 0 <= number <= 9999999999:
+            raise ValueError('cover ID must fit in ten digits')
+        digits = f'{number:010d}'
+        return digits[:4], digits[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        size = _size(size)
+        if protocol not in ('http', 'https'):
+            raise ValueError('protocol must be http or https')
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        item = Batch.item_name(item_id, size)
+        zip_name = os.path.basename(Batch.get_relpath(item_id, batch_id, size))
+        suffix = f'-{size.upper()}' if size else ''
+        member = f'{int(cover_id):010d}{suffix}.{ext}'
+        return f'{protocol}://archive.org/download/{item}/{zip_name}/{member}'
+
+    def files(self):
+        for size in SIZES:
+            field = 'filename' + (f'_{size}' if size else '')
+            filename = getattr(self, field, None)
+            if not filename:
+                return
+            path = os.path.join(config.data_root, 'localdisk', filename)
+            if not os.path.isfile(path):
+                return
+            suffix = f'-{size.upper()}' if size else ''
+            yield size, path, f'{int(self.id):010d}{suffix}.jpg'
+
+
+class Batch:
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id = self._norm_ids(item_id, batch_id)
+        self.size = None if size is None else _size(size)
+
+    @staticmethod
+    def _norm_ids(item_id, batch_id):
+        item, batch = int(item_id), int(batch_id)
+        if not (0 <= item <= 9999 and 0 <= batch <= 99):
+            raise ValueError('item or batch ID outside its range')
+        return f'{item:04d}', f'{batch:02d}'
+
+    @classmethod
+    def item_name(cls, item_id, size=''):
+        item_id, _ = cls._norm_ids(item_id, 0)
+        return f'{_size(size) + "_" if size else ""}covers_{item_id}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = cls._norm_ids(item_id, batch_id)
+        item = cls.item_name(item_id, size)
+        return os.path.join('items', item, f'{item}_{batch_id}.{ext}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        uploader = uploader or Uploader()
+        with _archive_lock():
+            sizes = SIZES if self.size is None else (self.size,)
+            for size in sizes:
+                path = self.get_abspath(self.item_id, self.batch_id, size)
+                if not os.path.isfile(path):
+                    continue
+                item = self.item_name(self.item_id, size)
+                if upload and not test and not uploader.is_uploaded(item, os.path.basename(path)):
+                    uploader.upload(item, [path])
+            if finalize and not test:
+                # A cover has all four sizes; publish it only after every zip
+                # has been verified remotely. Missing local zips are allowed on
+                # retries after a previously completed upload.
+                if all(
+                    uploader.is_uploaded(
+                        self.item_name(self.item_id, size),
+                        os.path.basename(self.get_abspath(self.item_id, self.batch_id, size)),
+                    )
+                    for size in SIZES
+                ):
+                    CoverDB.update_completed_batch(self.item_id, self.batch_id)
+                    for size in SIZES:
+                        path = self.get_abspath(self.item_id, self.batch_id, size)
+                        if os.path.exists(path):
+                            os.remove(path)
+                    return True
+            return False
+
+    def finalize(self, start_id=None, test=False):
+        return self.process_pending(finalize=True, test=test)
