@@ -1,4 +1,8 @@
 from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
 from zipfile import ZipFile
 
 import pytest
@@ -53,7 +57,7 @@ def test_batch_finalizes_only_when_every_size_uploaded(tmp_path, monkeypatch):
     class StubUploader:
         available = set(archive.SIZES[:-1])
 
-        def is_uploaded(self, item, filename):
+        def is_uploaded(self, item, filename, filepath=None):
             return item[0] in self.available or (item == 'covers_0008' and '' in self.available)
 
     uploader = StubUploader()
@@ -63,3 +67,56 @@ def test_batch_finalizes_only_when_every_size_uploaded(tmp_path, monkeypatch):
     uploader.available.add('l')
     assert batch.process_pending(finalize=True, uploader=uploader) is True
     assert completed == [('0008', '81')]
+
+
+def test_remote_zip_checksum_required_for_finalization(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    completed = []
+    monkeypatch.setattr(archive.CoverDB, 'update_completed_batch',
+                        staticmethod(lambda *args: completed.append(args)))
+    remote_md5 = {}
+    for size in archive.SIZES:
+        path = Path(archive.Batch.get_abspath(8, 81, size))
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(size.encode() or b'original')
+        remote_md5[archive.Batch.item_name(8, size)] = hashlib.md5(path.read_bytes()).hexdigest()
+    remote_md5['m_covers_0008'] = hashlib.md5(b'older zip').hexdigest()
+
+    def metadata(command, **kwargs):
+        item = command[-1]
+        name = Path(archive.Batch.get_abspath(8, 81, item[0] if item[1] == '_' else '')).name
+        return SimpleNamespace(stdout=json.dumps({'files': [{'name': name, 'md5': remote_md5[item]}]}))
+
+    monkeypatch.setattr(archive, 'run', metadata)
+    batch = archive.Batch(8, 81)
+    assert batch.process_pending(finalize=True) is False
+    assert completed == []
+    assert all(Path(archive.Batch.get_abspath(8, 81, size)).exists() for size in archive.SIZES)
+
+    medium = Path(archive.Batch.get_abspath(8, 81, 'm'))
+    medium.unlink()
+    assert batch.process_pending(finalize=True) is False
+    assert completed == []
+    medium.write_bytes(b'm')
+    remote_md5['m_covers_0008'] = hashlib.md5(medium.read_bytes()).hexdigest()
+    assert batch.process_pending(finalize=True) is True
+    assert completed == [('0008', '81')]
+    assert not medium.exists()
+
+
+def test_archive_rejects_new_covers_in_finalized_batch(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+
+    class FakeCoverDB:
+        def get_unarchived(self):
+            return [{'id': 8810000}]
+
+        def batch_has_uploaded_cover(self, item_id, batch_id):
+            assert (item_id, batch_id) == ('0008', '81')
+            return True
+
+    monkeypatch.setattr(archive, 'CoverDB', FakeCoverDB)
+    monkeypatch.setattr(archive.db, 'getdb', lambda: object())
+    with pytest.raises(RuntimeError, match='finalized batch'):
+        archive.archive()
+    assert not Path(archive.Batch.get_abspath(8, 81)).exists()
