+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Work around QtWebEngine 5.15.3 crashes on Linux when the system locale has
+    no matching locale resource file. Uses a Chromium-compatible fallback locale.
+
