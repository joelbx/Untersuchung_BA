+        super().accept_certificate()
+        if self._reply is not None:
+            self._reply.ignoreSslErrors()
+
+    def defer(self) -> None:
+        raise usertypes.UndeferrableError
+
     def __str__(self) -> str:
         return '\n'.join(err.errorString() for err in self._errors)
 
