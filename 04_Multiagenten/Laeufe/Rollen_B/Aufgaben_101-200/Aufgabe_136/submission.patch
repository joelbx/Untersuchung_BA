diff --git a/tests/unit/browser/webengine/test_certificate_decisions.py b/tests/unit/browser/webengine/test_certificate_decisions.py
new file mode 100644
index 0000000..b3daf0f
--- /dev/null
+++ b/tests/unit/browser/webengine/test_certificate_decisions.py
@@ -0,0 +1,49 @@
+"""Tests for WebEngine certificate decision wrappers."""
+
+import pytest
+
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+class FakeError:
+
+    def __init__(self):
+        self.accepted = False
+        self.rejected = False
+        self.deferred = False
+
+    def acceptCertificate(self):
+        self.accepted = True
+
+    def rejectCertificate(self):
+        self.rejected = True
+
+    def defer(self):
+        self.deferred = True
+
+
+@pytest.mark.parametrize('qt6, wrapper_type', [
+    (False, certificateerror.CertificateErrorWrapperQt5),
+    (True, certificateerror.CertificateErrorWrapperQt6),
+])
+def test_factory_and_decisions(monkeypatch, qt6, wrapper_type):
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', qt6)
+    error = FakeError()
+    wrapper = certificateerror.create(error)
+    assert isinstance(wrapper, wrapper_type)
+    assert not wrapper.certificate_was_accepted()
+
+    if qt6:
+        wrapper.defer()
+        assert error.deferred
+    else:
+        with pytest.raises(usertypes.UndeferrableError):
+            wrapper.defer()
+
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    assert error.accepted == qt6
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    assert error.rejected == qt6
diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..6bd5044 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -71,3 +71,32 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+@pytest.mark.parametrize('messages, expected', [
+    (["<bad> & 'quoted' \"text\""],
+     '<p>&lt;bad&gt; &amp; &#x27;quoted&#x27; &quot;text&quot;</p>'),
+    (["<first> &", "'second' \"text\""],
+     '<ul><li>&lt;first&gt; &amp;</li>'
+     '<li>&#39;second&#39; &#34;text&#34;</li></ul>'),
+])
+def test_html_escapes_all_special_characters(messages, expected):
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=None, errors=[FakeError(message) for message in messages])
+    assert ''.join(wrapper.html().split()) == ''.join(expected.split())
+
+
+def test_reply_is_only_used_when_accepted(mocker):
+    reply = mocker.Mock()
+    errors = [QSslError(QSslError.SslError.UnableToGetIssuerCertificate)]
+    wrapper = certificateerror.CertificateErrorWrapper(reply=reply, errors=errors)
+    reply.assert_not_called()
+    reply.ignoreSslErrors.assert_not_called()
+    assert wrapper == certificateerror.CertificateErrorWrapper(errors)
+    assert hash(wrapper) == hash(certificateerror.CertificateErrorWrapper(errors))
+
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
