+        ('20000229.123456', (2000, 2, 29, 12, 34, 56)),
+    ))
+    def test_valid_time_stamp(self, timestamp, expected):
+        result = ZipArchive._valid_time_stamp(None, timestamp)
+        assert result[:6] == expected
+
+    @pytest.mark.parametrize('timestamp', (
