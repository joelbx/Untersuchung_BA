+    def _valid_time_stamp(self, timestamp):
+        default = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.fullmatch(r'([0-9]{4})([0-9]{2})([0-9]{2})\.([0-9]{2})([0-9]{2})([0-9]{2})', timestamp)
+        if not match:
+            return default
+
+        parts = tuple(int(part) for part in match.groups())
+        if not 1980 <= parts[0] <= 2107:
+            return default
+
+        try:
+            return datetime.datetime(*parts).timetuple()
+        except ValueError:
+            return default
