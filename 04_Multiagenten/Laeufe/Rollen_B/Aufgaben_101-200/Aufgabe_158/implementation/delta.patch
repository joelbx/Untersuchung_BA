+        '19800101.000000extra',
+        'not-a-timestamp',
+    ))
+    def test_invalid_time_stamp(self, timestamp):
+        assert ZipArchive._valid_time_stamp(None, timestamp) == (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+
+    def test_existing_file_with_invalid_time_stamp(self, tmp_path, fake_ansible_module, mocker):
