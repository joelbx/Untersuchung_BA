+        )
+        fake_ansible_module.debug = lambda message: None
+        archive = ZipArchive('', bytes(tmp_path), {'owner': None, 'group': None, 'mode': None}, fake_ansible_module)
+        mocker.patch.object(archive, '_crc32', return_value=0)
+
+        result = archive.is_unarchived()
+
+        assert result['unarchived'] is False
+        assert 'entry.txt' in archive.includes
+
