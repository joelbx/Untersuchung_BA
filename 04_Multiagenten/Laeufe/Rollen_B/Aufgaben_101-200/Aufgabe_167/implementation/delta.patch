+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,75 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/content/oci"
+)
+
+func TestLocalSourceRefreshAndSubscribe(t *testing.T) {
+	dir := t.TempDir()
+	ctx := context.Background()
+	write := func(payload string) {
+		t.Helper()
+		layout, err := oci.New(filepath.Join(dir, "repo"))
+		require.NoError(t, err)
+		layout.AutoSaveIndex = true
+		layer := v1.Descriptor{
+			MediaType: fliptoci.MediaTypeFliptNamespace + "+yaml",
+			Digest:    digest.FromString(payload), Size: int64(len(payload)),
+			Annotations: map[string]string{fliptoci.AnnotationFliptNamespace: "team"},
+		}
+		require.NoError(t, layout.Push(ctx, layer, bytes.NewReader([]byte(payload))))
+		manifest, err := oras.PackManifest(ctx, layout, oras.PackManifestVersion1_1_RC4,
+			fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{Layers: []v1.Descriptor{layer}})
+		require.NoError(t, err)
+		require.NoError(t, layout.Tag(ctx, manifest, "latest"))
+	}
+	write("flags: []\n")
+	store, err := fliptoci.NewStore(&config.OCI{BundleDirectory: dir, Repository: "flipt://local/repo:latest"})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, WithPollInterval(10*time.Millisecond))
+	require.NoError(t, err)
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetNamespace(ctx, "team")
+	require.NoError(t, err)
+	again, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, again)
+
+	watchCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	updates := make(chan *storagefs.StoreSnapshot)
+	go source.Subscribe(watchCtx, updates)
+	select {
+	case <-updates:
+		t.Fatal("unchanged snapshot was sent")
+	case <-time.After(40 * time.Millisecond):
+	}
+	write("flags:\n  - key: changed\n    name: Changed\n    type: BOOLEAN_FLAG_TYPE\n")
+	var second *storagefs.StoreSnapshot
+	select {
+	case second = <-updates:
+	case <-time.After(time.Second):
+		t.Fatal("updated snapshot was not sent")
+	}
+	require.NotSame(t, first, second)
+	_, err = second.GetFlag(ctx, "team", "changed")
+	require.NoError(t, err)
+	again, err = source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, second, again)
+}
