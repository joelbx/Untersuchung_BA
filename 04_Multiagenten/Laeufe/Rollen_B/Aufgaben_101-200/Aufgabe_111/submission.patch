+func parseAmazonRelease(systemRelease string) string {
+	fields := strings.Fields(systemRelease)
+	if len(fields) >= 4 && fields[0] == "Amazon" && fields[1] == "Linux" && fields[2] == "release" {
+		return strings.Join(fields[3:], " ")
+	}
+	if len(fields) >= 3 && fields[0] == "Amazon" && fields[1] == "Linux" && fields[2] != "AMI" && fields[2] != "release" {
+		return strings.Join(fields[2:], " ")
+	}
+	if len(fields) == 5 && fields[0] == "Amazon" && fields[1] == "Linux" && fields[2] == "AMI" && fields[3] == "release" {
+		return fields[4]
+	}
+	return "unknown"
+}
