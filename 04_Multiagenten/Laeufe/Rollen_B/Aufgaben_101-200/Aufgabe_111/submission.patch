+func TestAmazonEOLDates(t *testing.T) {
+	tests := map[string]time.Time{
+		"2023": time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2025": time.Date(2030, 6, 30, 23, 59, 59, 0, time.UTC),
+		"2027": time.Date(2032, 6, 30, 23, 59, 59, 0, time.UTC),
+		"2029": time.Date(2034, 6, 30, 23, 59, 59, 0, time.UTC),
+	}
+	for release, want := range tests {
+		eol, found := GetEOL(Amazon, release)
+		if !found || !eol.StandardSupportUntil.Equal(want) {
+			t.Errorf("GetEOL(amazon, %q) = (%v, %v), want standard end %v", release, eol, found, want)
+		}
+		if eol.IsStandardSupportEnded(want) || eol.IsExtendedSuppportEnded(want) {
+			t.Errorf("amazon %s should be supported through %v", release, want)
+		}
+		if !eol.IsStandardSupportEnded(want.Add(time.Second)) || !eol.IsExtendedSuppportEnded(want.Add(time.Second)) {
+			t.Errorf("amazon %s should be out of support after %v", release, want)
+		}
+		buildRelease := release + ".0.1"
+		buildEOL, buildFound := GetEOL(Amazon, buildRelease)
+		if !buildFound || !buildEOL.StandardSupportUntil.Equal(want) {
+			t.Errorf("GetEOL(amazon, %q) = (%v, %v), want standard end %v", buildRelease, buildEOL, buildFound, want)
+		}
+	}
+	for _, release := range []string{"", "unknown", "2024", "2024.0.1", "2031"} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL(amazon, %q) unexpectedly found", release)
+		}
+	}
+}
+
+func TestEOLExtendedSupportBoundary(t *testing.T) {
+	standard := time.Date(2020, 11, 30, 23, 59, 59, 0, time.UTC)
+	extended := time.Date(2024, 6, 30, 23, 59, 59, 0, time.UTC)
+	eol, found := GetEOL(RedHat, "6")
+	if !found || !eol.StandardSupportUntil.Equal(standard) || !eol.ExtendedSupportUntil.Equal(extended) {
+		t.Fatalf("unexpected RHEL 6 EOL: %v, found=%v", eol, found)
+	}
+	if eol.IsStandardSupportEnded(standard) || eol.IsExtendedSuppportEnded(standard) {
+		t.Fatal("support must last through standard end date")
+	}
+	if !eol.IsStandardSupportEnded(standard.Add(time.Second)) || eol.IsExtendedSuppportEnded(standard.Add(time.Second)) {
+		t.Fatal("extended support must remain after standard end date")
+	}
+	if eol.IsExtendedSuppportEnded(extended) || !eol.IsExtendedSuppportEnded(extended.Add(time.Second)) {
+		t.Fatal("extended support boundary is incorrect")
+	}
+}
