+_DURATION_NUMBER = r'(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+)'
+_DURATION_RE = re.compile(
+    r'(?:(?P<hours>' + _DURATION_NUMBER + r')h\s*)?'
+    r'(?:(?P<minutes>' + _DURATION_NUMBER + r')m\s*)?'
+    r'(?:(?P<seconds>' + _DURATION_NUMBER + r')s\s*)?')
+
+
+def parse_duration(duration: str) -> int:
+    """Parse a duration with h, m and s units, returning milliseconds.
+
+    A string containing only digits is interpreted as milliseconds.
+    """
+    duration = duration.strip()
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    match = _DURATION_RE.fullmatch(duration)
+    if match is None or not any(match.groupdict().values()):
+        raise ValueError("Invalid duration: {!r}".format(duration))
+
+    units = (('hours', 3600000), ('minutes', 60000), ('seconds', 1000))
+    milliseconds = sum(Fraction(match.group(unit)) * multiplier
+                       for unit, multiplier in units if match.group(unit))
+    return int(milliseconds)
+
