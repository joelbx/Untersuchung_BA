@@ -0,0 +1,31 @@
+import { MAILBOX_LABEL_IDS } from '@proton/shared/lib/constants';
+import type { MailSettings } from '@proton/shared/lib/interfaces';
+import { MAIL_PAGE_SIZE } from '@proton/shared/lib/mail/mailSettings';
+
+import { getLabelID, getPageSizeString } from './mailMetricsHelper';
+
+describe('getLabelID', () => {
+    it.each(Object.values(MAILBOX_LABEL_IDS))('preserves system label %s', (labelID) => {
+        expect(getLabelID(labelID)).toBe(labelID);
+    });
+
+    it.each(['custom-label-id', 'custom-folder-id', '11'])('normalizes custom label or folder %s', (labelID) => {
+        expect(getLabelID(labelID)).toBe('custom');
+    });
+});
+
+describe('getPageSizeString', () => {
+    it.each([
+        [MAIL_PAGE_SIZE.FIFTY, '50'],
+        [MAIL_PAGE_SIZE.ONE_HUNDRED, '100'],
+        [MAIL_PAGE_SIZE.TWO_HUNDRED, '200'],
+    ])('formats page size %s as %s', (pageSize, expected) => {
+        expect(getPageSizeString({ PageSize: pageSize } as MailSettings)).toBe(expected);
+    });
+
+    it('defaults to 50 when settings are missing or page size is invalid', () => {
+        expect(getPageSizeString(undefined)).toBe('50');
+        expect(getPageSizeString({} as MailSettings)).toBe('50');
+        expect(getPageSizeString({ PageSize: 75 } as MailSettings)).toBe('50');
+    });
+});
diff --git a/applications/mail/src/app/metrics/mailMetricsHelper.ts b/applications/mail/src/app/metrics/mailMetricsHelper.ts
new file mode 100644
index 0000000..fd63396
--- /dev/null
+++ b/applications/mail/src/app/metrics/mailMetricsHelper.ts
@@ -0,0 +1,19 @@
+import type { MAILBOX_LABEL_IDS } from '@proton/shared/lib/constants';
+import type { MailSettings } from '@proton/shared/lib/interfaces';
+import { MAIL_PAGE_SIZE } from '@proton/shared/lib/mail/mailSettings';
+
+import { isCustomLabelOrFolder } from '../helpers/labels';
+
+export const getLabelID = (labelID: string): MAILBOX_LABEL_IDS | 'custom' =>
+    isCustomLabelOrFolder(labelID) ? 'custom' : (labelID as MAILBOX_LABEL_IDS);
+
+export const getPageSizeString = (settings: MailSettings | undefined): string => {
+    switch (settings?.PageSize) {
+        case MAIL_PAGE_SIZE.ONE_HUNDRED:
+            return '100';
+        case MAIL_PAGE_SIZE.TWO_HUNDRED:
+            return '200';
+        default:
+            return '50';
+    }
+};
