+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { TransferState } from '../../../components/TransferManager/transfer';
+import FileSaver from '../fileSaver/fileSaver';
+import useDownloadProvider from './useDownloadProvider';
+import useDownloadQueue from './useDownloadQueue';
+
+jest.mock('../../../utils/errorHandling', () => ({ logError: jest.fn(), sendErrorReport: jest.fn() }));
+jest.mock('@proton/components', () => ({
+    useNotifications: () => ({ createNotification: jest.fn() }),
+    useOnline: () => true,
+    usePreventLeave: () => ({ preventLeave: (promise: Promise<unknown>) => promise }),
+}));
+jest.mock('../../../components/modals/DownloadIsTooBigModal', () => ({
+    useDownloadIsTooBigModal: () => [null, jest.fn()],
+}));
+jest.mock('../../_transfer', () => ({
+    useTransferLog: () => ({ log: jest.fn(), downloadLogs: [], clearLogs: jest.fn() }),
+}));
+jest.mock('../fileSaver/fileSaver', () => ({
+    __esModule: true,
+    default: { saveAsFile: jest.fn() },
+}));
+jest.mock('./useDownloadQueue', () => ({ __esModule: true, default: jest.fn() }));
+jest.mock('./useDownloadControl', () => ({
+    __esModule: true,
+    default: () => ({
+        cancelDownloads: jest.fn(),
+        calculateDownloadBlockLoad: jest.fn(),
+        resumeDownloads: jest.fn(),
+    }),
+}));
+jest.mock('./useDownloadMetrics', () => ({ useDownloadMetrics: () => ({ observe: jest.fn() }) }));
+jest.mock('./useDownloadContainsDocument', () => ({
+    __esModule: true,
+    default: () => ({ handleContainsDocument: jest.fn(), containsDocumentModal: null }),
+}));
+jest.mock('./useDownloadScanIssue', () => ({
+    __esModule: true,
+    default: () => ({ handleScanIssue: jest.fn() }),
+}));
+jest.mock('./useDownloadSignatureIssue', () => ({
+    __esModule: true,
+    default: () => ({ handleSignatureIssue: jest.fn(), signatureIssueModal: null }),
+}));
+
+describe('prebuffered downloads', () => {
+    const mockQueue = jest.mocked(useDownloadQueue);
+    const mockSaveAsFile = jest.mocked(FileSaver.saveAsFile);
+
+    beforeEach(() => jest.clearAllMocks());
+
+    it.each(['resolve', 'reject'] as const)('settles the transfer after the save %ss', async (outcome) => {
+        let resolveSave!: () => void;
+        let rejectSave!: (error: Error) => void;
+        mockSaveAsFile.mockImplementation((_stream, _meta, _log, onMechanism) => {
+            onMechanism?.('memory');
+            return new Promise<void>((resolve, reject) => {
+                resolveSave = resolve;
+                rejectSave = reject;
+            });
+        });
+        const updateState = jest.fn();
+        const updateWithData = jest.fn();
+        mockQueue.mockReturnValue({
+            nextDownload: {
+                id: 'buffered',
+                links: [{ buffer: [new Uint8Array([1])] }],
+                meta: { filename: 'file', mimeType: 'text/plain', size: 1 },
+            },
+            downloads: [],
+            updateState,
+            updateWithData,
+        } as any);
+
+        const { result } = renderHook(() => useDownloadProvider(undefined, jest.fn()));
+        expect(result.error).toBeUndefined();
+        expect(updateWithData).toHaveBeenCalledWith('buffered', TransferState.Progress, { size: 1 });
+        expect(updateState).not.toHaveBeenCalledWith('buffered', TransferState.Done);
+
+        await act(async () => {
+            if (outcome === 'resolve') {
+                resolveSave();
+            } else {
+                rejectSave(new Error('save failed'));
+            }
+        });
+
+        if (outcome === 'resolve') {
+            expect(updateState).toHaveBeenCalledWith('buffered', TransferState.Done);
+        } else {
+            expect(updateState).not.toHaveBeenCalledWith('buffered', TransferState.Done);
+            expect(updateWithData).toHaveBeenCalledWith('buffered', TransferState.Error, {
+                error: expect.objectContaining({ message: 'save failed' }),
+            });
+        }
+    });
+});
