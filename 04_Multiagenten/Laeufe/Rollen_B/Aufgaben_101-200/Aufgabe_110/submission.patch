+import { MEMORY_DOWNLOAD_LIMIT } from '@proton/shared/lib/drive/constants';
+import downloadFile from '@proton/shared/lib/helpers/downloadFile';
+
+import { bufferToStream } from '../../../utils/stream';
+import { initDownloadSW, isUnsupported } from './download';
+import { FileSaver, selectMechanismForDownload } from './fileSaver';
+
+jest.mock('@proton/shared/lib/helpers/downloadFile', () => jest.fn());
+
+jest.mock('./download', () => ({
+    initDownloadSW: jest.fn().mockResolvedValue(undefined),
+    isUnsupported: jest.fn(),
+}));
+
+const mockIsUnsupported = jest.mocked(isUnsupported);
+const mockInitDownloadSW = jest.mocked(initDownloadSW);
+
+describe('selectMechanismForDownload', () => {
+    it('uses memory below the limit when service workers are supported', () => {
+        mockIsUnsupported.mockReturnValue(false);
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT - 1)).toBe('memory');
+        expect(selectMechanismForDownload(0)).toBe('memory');
+    });
+
+    it('uses service workers at and above the limit and for unknown sizes', () => {
+        mockIsUnsupported.mockReturnValue(false);
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT)).toBe('sw');
+        expect(selectMechanismForDownload()).toBe('sw');
+    });
+
+    it('uses the memory fallback when service workers are unsupported', () => {
+        mockIsUnsupported.mockReturnValue(true);
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT)).toBe('memory_fallback');
+        expect(selectMechanismForDownload()).toBe('memory_fallback');
+    });
+});
+
+describe('FileSaver mechanism reporting', () => {
+    it('reports memory fallback after service worker registration fails', async () => {
+        mockIsUnsupported.mockReturnValue(false);
+        mockInitDownloadSW.mockRejectedValueOnce(new Error('registration failed'));
+        const saver = new FileSaver();
+        await Promise.resolve();
+        const onMechanism = jest.fn();
+
+        await saver.saveAsFile(
+            bufferToStream([new Uint8Array([1])]),
+            { filename: 'test', mimeType: 'application/octet-stream', size: MEMORY_DOWNLOAD_LIMIT },
+            jest.fn(),
+            onMechanism
+        );
+
+        expect(onMechanism).toHaveBeenCalledWith('memory_fallback');
+        expect(downloadFile).toHaveBeenCalledTimes(1);
+    });
+});
