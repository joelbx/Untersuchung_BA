+@pytest.mark.skipif(not encrypt.PASSLIB_AVAILABLE or sys.platform.startswith('darwin'), reason='requires passlib and crypt')
+def test_bcrypt_legacy_ident_crypt_backend_unmocked():
+    settings = dict(salt='123456789012345678901u', rounds=4, ident='2')
+    expected = encrypt.PasslibHash('bcrypt').hash('foo', **settings)
