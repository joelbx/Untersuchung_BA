--- a/test/units/utils/test_encrypt.py
+++ b/test/units/utils/test_encrypt.py
@@ -22,6 +22,8 @@ import sys
 
 import pytest
 
+from units.compat.mock import patch
+
 from ansible.errors import AnsibleError, AnsibleFilterError
 from ansible.plugins.filter.core import get_encrypted_password
 from ansible.utils import encrypt
@@ -210,3 +212,39 @@ def test_passlib_bcrypt_salt(recwarn):
 
     result = p.hash(secret, salt=repaired_salt)
     assert result == expected
+
+
+@pytest.mark.skipif(not encrypt.PASSLIB_AVAILABLE, reason='passlib is required')
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_passlib(ident):
+    settings = dict(salt='123456789012345678901u', rounds=4, ident=ident)
+    assert get_encrypted_password('foo', 'blowfish', **settings).startswith('$%s$04$' % ident)
+    assert encrypt.do_encrypt('foo', 'bcrypt', **settings).startswith('$%s$04$' % ident)
+    assert get_encrypted_password('foo', 'sha256', ident=ident, salt='12345678') == get_encrypted_password('foo', 'sha256', salt='12345678')
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+def test_bcrypt_ident_crypt(ident):
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+        assert result.startswith('$%s$04$' % ident)
+        assert get_encrypted_password('foo', 'sha256', salt='12345678', ident=ident) == get_encrypted_password('foo', 'sha256', salt='12345678')
+
+
+def test_bcrypt_crypt_salt_for_legacy_ident():
+    with patch.object(encrypt.crypt, 'crypt', return_value='$2$04$hash') as crypt_mock:
+        result = encrypt.CryptHash('bcrypt').hash('foo', salt='123456789012345678901u', rounds=4, ident='2')
+    assert result.startswith('$2$04$')
+    crypt_mock.assert_called_once_with('foo', '$2$04$123456789012345678901u')
+
+
+@pytest.mark.skipif(not encrypt.PASSLIB_AVAILABLE or sys.platform.startswith('darwin'), reason='requires passlib and crypt')
+def test_bcrypt_legacy_ident_crypt_backend_unmocked():
+    settings = dict(salt='123456789012345678901u', rounds=4, ident='2')
+    expected = encrypt.PasslibHash('bcrypt').hash('foo', **settings)
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', **settings)
+        assert result == expected
+        assert encrypt.CryptHash('bcrypt').hash('foo', **settings) == expected
+    assert result.startswith('$2$04$')
