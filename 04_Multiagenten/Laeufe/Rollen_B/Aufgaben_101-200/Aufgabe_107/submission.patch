index 0000000..639efb0
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.test.ts
@@ -0,0 +1,76 @@
+import { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+import { optimisticMarkAs } from '../elementsActions';
+import reducer, { newState } from '../elementsSlice';
+import { getElementsToBypassFilter } from './elementBypassFilters';
+
+describe('getElementsToBypassFilter', () => {
+    const elements = [{ ID: 'one' }, { ID: 'two' }] as Element[];
+
+    it.each([
+        [1, MARK_AS_STATUS.UNREAD],
+        [0, MARK_AS_STATUS.READ],
+    ])('removes bypass entries when filter %s matches action %s', (unreadFilter, action) => {
+        expect(getElementsToBypassFilter(elements, action, unreadFilter)).toEqual({
+            elementsToBypass: [],
+            elementsToRemove: elements,
+        });
+    });
+
+    it.each([
+        [1, MARK_AS_STATUS.READ],
+        [0, MARK_AS_STATUS.UNREAD],
+        [undefined, MARK_AS_STATUS.READ],
+    ])('adds bypass entries when filter %s does not match action %s', (unreadFilter, action) => {
+        expect(getElementsToBypassFilter(elements, action, unreadFilter)).toEqual({
+            elementsToBypass: elements,
+            elementsToRemove: [],
+        });
+    });
+});
+
+describe('optimistic mark-as bypass filter', () => {
+    const message = { ID: 'message', ConversationID: 'conversation', LabelIDs: [] } as Element;
+
+    it.each([
+        [1, MARK_AS_STATUS.READ, MARK_AS_STATUS.UNREAD],
+        [0, MARK_AS_STATUS.UNREAD, MARK_AS_STATUS.READ],
+    ])('removes stale conversation bypass entries for filter %s', (unreadFilter, addAction, removeAction) => {
+        let state = newState({ params: { filter: { Unread: unreadFilter } } });
+        state = reducer(
+            state,
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: true, markAsStatus: addAction })
+        );
+        expect(state.bypassFilter).toEqual(['conversation']);
+
+        state = reducer(
+            state,
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: true, markAsStatus: removeAction })
+        );
+        expect(state.bypassFilter).toEqual([]);
+    });
+
+    it('uses message IDs outside conversation mode and does not duplicate them', () => {
+        let state = newState({ params: { filter: { Unread: 1 } } });
+        const action = optimisticMarkAs({
+            elements: [message],
+            bypass: true,
+            conversationMode: false,
+            markAsStatus: MARK_AS_STATUS.READ,
+        });
+        state = reducer(state, action);
+        state = reducer(state, action);
+        expect(state.bypassFilter).toEqual(['message']);
+
+        state = reducer(
+            state,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(state.bypassFilter).toEqual([]);
+    });
+});
diff --git a/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
new file mode 100644
index 0000000..0642295
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
@@ -0,0 +1,10 @@
+import type { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import type { Element } from '../../../models/element';
+
+export const getElementsToBypassFilter = (elements: Element[], action: MARK_AS_STATUS, unreadFilter?: number) => {
+    const matchesFilter = (unreadFilter === 1 && action === 'unread') || (unreadFilter === 0 && action === 'read');
+
+    return matchesFilter
+        ? { elementsToBypass: [], elementsToRemove: elements }
+        : { elementsToBypass: elements, elementsToRemove: [] };
+};
