+def test_replace_stderr_clixml_valid_element_before_malformed_neighbor():
+    valid = b'<Objs Version="1"><S S="Error">one</S></Objs>'
+    malformed = b'<Objs Version="1"><S S="Error">broken</Objs>'
+    stderr = b'#< CLIXML\r\n' + valid + malformed + b' trailing'
+
+    assert _replace_stderr_clixml(stderr) == b'one' + malformed + b' trailing'
+
