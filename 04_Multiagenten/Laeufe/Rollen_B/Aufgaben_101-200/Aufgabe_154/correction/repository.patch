+# matches for '_x(a-fA-F0-9){4}_' encoded as utf-16-be.
+_STRING_DESERIAL_FIND = re.compile(rb"\x00_\x00x((?:\x00[a-fA-F0-9]){4})\x00_")
+
+_CLIXML_HEADER = re.compile(rb"(?:#<|<#) CLIXML\r\n|\r\nCLIXML\r\n")
 
 _common_args = ['PowerShell', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Unrestricted']
 
@@ -91,6 +92,65 @@ def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
     return to_bytes(''.join(lines), errors="surrogatepass")
 
 
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML blocks in stderr without disturbing other bytes."""
+    result = bytearray()
+    cursor = 0
+    search_from = 0
+    replaced = False
+
+    while header := _CLIXML_HEADER.search(stderr, search_from):
+        start = header.start()
+        body_start = header.end()
+
+        # PowerShell can emit the header more than once before the XML body.
+        while repeated := _CLIXML_HEADER.match(stderr, body_start):
+            body_start = repeated.end()
+
+        xml_start = body_start if stderr.startswith(b"<Objs ", body_start) else -1
+        next_header = _CLIXML_HEADER.search(stderr, body_start)
+        if xml_start == -1 or (next_header and next_header.start() < xml_start):
+            search_from = body_start
+            continue
+
+        # Parse adjacent elements independently so a malformed one does not
+        # prevent a valid neighbor from being replaced.
+        previous_text = False
+        while stderr.startswith(b"<Objs ", xml_start):
+            end = stderr.find(b"</Objs>", xml_start)
+            if end == -1 or (next_header and next_header.start() < end):
+                break
+            end += len(b"</Objs>")
+
+            block = stderr[start:end]
+            try:
+                try:
+                    decoded = block.decode("utf-8")
+                except UnicodeDecodeError:
+                    decoded = block.decode("cp437")
+                replacement = _parse_clixml(decoded.encode("utf-8"))
+            except (ET.ParseError, UnicodeError, ValueError):
+                previous_text = False
+            else:
+                result.extend(stderr[cursor:start])
+                if previous_text and replacement:
+                    result.extend(b"\r\n")
+                result.extend(replacement)
+                replaced = True
+                cursor = end
+                previous_text = bool(replacement)
+
+            start = end
+            xml_start = end
+
+        search_from = max(body_start, xml_start)
+
+    if not replaced:
+        return stderr
+    result.extend(stderr[cursor:])
+    return bytes(result)
+
+
