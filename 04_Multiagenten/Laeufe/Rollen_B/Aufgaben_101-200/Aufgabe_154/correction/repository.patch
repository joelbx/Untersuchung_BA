+@pytest.mark.parametrize('header', [b'#< CLIXML\r\n', b'<# CLIXML\r\n', b'\r\nCLIXML\r\n'])
+def test_replace_stderr_clixml_with_surrounding_text(header):
+    xml = b'<Objs Version="1"><S S="Error">decoded</S></Objs>'
+    stderr = b'before\r\n' + header + xml + b' trailing\r\nafter'
+
+    assert _replace_stderr_clixml(stderr) == b'before\r\ndecoded trailing\r\nafter'
+
+
+def test_replace_stderr_clixml_multiline_and_multiple_blocks():
+    xml = b'<Objs Version="1">\r\n<S S="Error">first</S>\r\n</Objs>'
+    stderr = b'#< CLIXML\r\n' + xml + b' middle\r\n#< CLIXML\r\n' + xml
+
+    assert _replace_stderr_clixml(stderr) == b'first middle\r\nfirst'
+
+
+def test_replace_stderr_clixml_cp437():
+    stderr = b'#< CLIXML\r\n<Objs Version="1"><S S="Error">caf\x82</S></Objs>'
+
+    assert _replace_stderr_clixml(stderr) == 'caf\u00e9'.encode()
+
+
+def test_replace_stderr_clixml_empty_and_adjacent_elements():
+    empty = b'#< CLIXML\r\n<Objs Version="1"></Objs>'
+    adjacent = (b'<# CLIXML\r\n<# CLIXML\r\n'
+                b'<Objs Version="1"><S S="Error">one</S></Objs>'
+                b'<Objs Version="1"><S S="Error">two</S></Objs>')
+
+    assert _replace_stderr_clixml(empty) == b''
+    assert _replace_stderr_clixml(adjacent) == b'one\r\ntwo'
+
+
+def test_replace_stderr_clixml_valid_element_before_malformed_neighbor():
+    valid = b'<Objs Version="1"><S S="Error">one</S></Objs>'
+    malformed = b'<Objs Version="1"><S S="Error">broken</Objs>'
+    stderr = b'#< CLIXML\r\n' + valid + malformed + b' trailing'
+
+    assert _replace_stderr_clixml(stderr) == b'one' + malformed + b' trailing'
+
+
+@pytest.mark.parametrize('stderr', [
+    b'plain stderr\r\n',
+    b'#< CLIXML\r\n<Objs Version="1"><S S="Error">unfinished',
+    b'#< CLIXML\r\n<Objs Version="1"><S S="Error">bad</Objs>',
+])
+def test_replace_stderr_clixml_leaves_unparseable_data(stderr):
+    assert _replace_stderr_clixml(stderr) == stderr
+
+
+def test_replace_stderr_clixml_recovers_after_incomplete_block():
+    stderr = (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">unfinished\r\n'
+              b'#< CLIXML\r\n<Objs Version="1"><S S="Error">good</S></Objs> end')
+
+    assert _replace_stderr_clixml(stderr) == (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">unfinished\r\n'
+                                               b'good end')
+
