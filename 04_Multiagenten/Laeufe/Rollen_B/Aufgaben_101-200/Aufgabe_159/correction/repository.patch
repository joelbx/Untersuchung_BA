+// purlPkgType maps scanner and manifest ecosystem names to PURL types.
+func purlPkgType(t string) string {
+	switch t {
+	case "pom", "jar", "gradle":
+		return "maven"
+	case "pip", "pipenv", "poetry", "uv", "python-pkg":
+		return "pypi"
+	case "gomod", "gobinary":
+		return "golang"
+	case "yarn", "pnpm", "node-pkg", "javascript":
+		return "npm"
+	default:
+		return t
+	}
+}
+
+// parsePkgName splits an ecosystem package name into PURL fields.
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch t {
+	case "maven":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			return group, artifact, ""
+		}
+	case "pypi":
+		return "", strings.ToLower(strings.ReplaceAll(n, "_", "-")), ""
+	case "golang":
+		if last := strings.LastIndex(n, "/"); last >= 0 {
+			return n[:last], n[last+1:], ""
+		}
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				return scope, pkg, ""
+			}
+		}
+	case "cocoapods":
+		if pod, subspec, ok := strings.Cut(n, "/"); ok {
+			return "", pod, subspec
+		}
+	}
+	return "", name, ""
+}
