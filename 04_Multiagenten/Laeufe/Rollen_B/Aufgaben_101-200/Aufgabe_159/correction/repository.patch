@@ -0,0 +1,77 @@
+package sbom
+
+import (
+	"strings"
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typeName, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "github.com/org/sub/pkg", "github.com/org/sub", "pkg", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"cargo", "serde", "", "serde", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typeName+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typeName, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q); want (%q, %q, %q)", tt.typeName, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestDependencyPURLs(t *testing.T) {
+	scannerTests := []struct {
+		scannerType ftypes.LangType
+		name        string
+		wantPrefix  string
+	}{
+		{ftypes.NodePkg, "@babel/core", "pkg:npm/%40babel/core@1.0?"},
+		{ftypes.JavaScript, "@babel/core", "pkg:npm/%40babel/core@1.0?"},
+		{ftypes.PythonPkg, "My_Package", "pkg:pypi/my-package@1.0?"},
+		{ftypes.GoBinary, "github.com/protobom/protobom", "pkg:golang/github.com/protobom/protobom@1.0?"},
+	}
+	for _, tt := range scannerTests {
+		t.Run(string(tt.scannerType), func(t *testing.T) {
+			purls := map[string]map[string]string{"lockfile": {}}
+			components := libpkgToCdxComponents(models.LibraryScanner{
+				Type: tt.scannerType, LockfilePath: "lockfile",
+				Libs: []models.Library{{Name: tt.name, Version: "1.0"}},
+			}, purls)
+			if got := components[1].PackageURL; !strings.HasPrefix(got, tt.wantPrefix) {
+				t.Errorf("scanner %q PURL = %q; want prefix %q", tt.scannerType, got, tt.wantPrefix)
+			}
+		})
+	}
+
+	libPURLs := map[string]map[string]string{"pom.xml": {}}
+	libComponents := libpkgToCdxComponents(models.LibraryScanner{
+		Type: ftypes.Pom, LockfilePath: "pom.xml",
+		Libs: []models.Library{{Name: "com.google.guava:guava", Version: "1.0"}},
+	}, libPURLs)
+	if got := libComponents[1].PackageURL; !strings.HasPrefix(got, "pkg:maven/com.google.guava/guava@1.0?") {
+		t.Errorf("Maven library PURL = %q", got)
+	}
+
+	ghPURLs := map[string]map[string]string{"owner/repo/requirements.txt": {}}
+	ghComponents := ghpkgToCdxComponents(models.DependencyGraphManifest{
+		Filename: "requirements.txt", Repository: "owner/repo",
+		Dependencies: []models.Dependency{{PackageName: "My_Package", Requirements: "= 1.0"}},
+	}, ghPURLs)
+	if got := ghComponents[1].PackageURL; !strings.HasPrefix(got, "pkg:pypi/my-package@1.0?") {
+		t.Errorf("PyPI GitHub dependency PURL = %q", got)
+	}
+}
