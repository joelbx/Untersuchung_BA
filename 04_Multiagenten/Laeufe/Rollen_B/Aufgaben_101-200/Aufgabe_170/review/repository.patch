+def add_db_name(rec: dict) -> None:
+    """Add a comparable name to each author in an edition, in place."""
+    for author in rec.get('authors') or []:
+        date = author.get('date')
+        if not date and ('birth_date' in author or 'death_date' in author):
+            date = (author.get('birth_date') or '') + '-' + (
+                author.get('death_date') or ''
+            )
+        author['db_name'] = ' '.join((author['name'], date)) if date else author['name']
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the title, ISBN, and author fields used by edition comparison."""
+    full_title = rec.get('title') or rec.get('full_title', '')
+    if rec.get('title') and rec.get('subtitle'):
+        full_title += ' ' + rec['subtitle']
+    rec['full_title'] = full_title
+    expanded = build_titles(full_title)
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        expanded['isbn'].extend([values] if isinstance(values, str) else values)
+    if rec.get('publish_country') not in (None, '   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if field in rec and rec[field] is not None:
+            value = rec[field]
+            if field in ('authors', 'contribs'):
+                value = [author.copy() for author in value]
+            expanded[field] = value
+    add_db_name(expanded)
+    for contributor in expanded.get('contribs') or []:
+        add_db_name({'authors': [contributor]})
+    return expanded
+
+
