--- a/lib/kube/proxy/forwarder.go
+++ b/lib/kube/proxy/forwarder.go
@@ -1317,6 +1317,9 @@ func (f *Forwarder) getCertificate(ctx authContext) (*tls.Config, error) {
 			if err != nil {
 				return nil, trace.Wrap(err)
 			}
+			if !certificateValidForSession(cert, f.Clock.Now()) {
+				return nil, trace.BadParameter("Kubernetes certificate expires in less than one minute")
+			}
 			f.Lock()
 			err = f.credentials.Set(ctx.key(), cert, ctx.sessionTTL)
 			f.Unlock()
@@ -1341,14 +1344,18 @@ func (f *Forwarder) cachedCertificate(ctx authContext) *tls.Config {
 		return nil
 	}
 	config := cert.(*tls.Config)
-	if len(config.Certificates) == 0 || config.Certificates[0].Leaf == nil ||
-		config.Certificates[0].Leaf.NotAfter.Before(f.Clock.Now().Add(time.Minute)) {
+	if !certificateValidForSession(config, f.Clock.Now()) {
 		f.credentials.Remove(ctx.key())
 		return nil
 	}
 	return config
 }
 
+func certificateValidForSession(config *tls.Config, now time.Time) bool {
+	return config != nil && len(config.Certificates) != 0 && config.Certificates[0].Leaf != nil &&
+		!config.Certificates[0].Leaf.NotAfter.Before(now.Add(time.Minute))
+}
