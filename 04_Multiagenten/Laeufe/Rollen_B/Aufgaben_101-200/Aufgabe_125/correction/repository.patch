+		const removed = oldTids.filter(tid => !current.includes(String(tid)));
+		const added = current.filter(tid => !oldTids.includes(tid));
+
+		for (const tid of removed) {
+			/* eslint-disable no-await-in-loop */
+			const eventId = await db.getObjectField(eventKey, tid);
