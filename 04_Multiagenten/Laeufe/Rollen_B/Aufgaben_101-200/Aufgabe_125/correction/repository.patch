+		const escapedBase = base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+		const siteUrl = escapedBase ? `(?:${escapedBase})?` : '';
+		const pattern = new RegExp(`(?:^|[\\s("'<=])${siteUrl}/topic/([1-9]\\d*)(?=$|[/?#.,!;:\\s)"'<>\\]])`, 'g');
