+				await Topics.events.purge(tid, [eventId]);
+				await db.deleteObjectField(eventKey, tid);
+			}
+			await db.sortedSetRemove(key, tid);
+		}
+		for (const tid of added) {
+			const [event] = await Topics.events.log(tid, {
+				type: 'backlink',
+				uid: postData.uid,
+				href: `/post/${postData.pid}`,
+			});
+			await db.setObjectField(eventKey, tid, event.id);
+			await db.sortedSetAdd(key, Date.now(), tid);
+		}
+		return added.length + removed.length;
+	};
