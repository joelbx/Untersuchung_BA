+def test_exit_uses_own_pid(qtbot, proc, message_mock, py_proc, monkeypatch):
+    """A later process must not change the PID suggested by an earlier one."""
+    with qtbot.wait_signal(proc.started, timeout=5000):
+        proc.start(*py_proc('import time, sys; time.sleep(1); sys.exit(1)'))
+    own_pid = proc.pid
+    assert own_pid is not None
+    monkeypatch.setattr(guiprocess, 'last_pid', own_pid + 1)
+
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        pass
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text.endswith(f'See :process {own_pid} for details.')
+
+
+@pytest.mark.posix
+@pytest.mark.parametrize('verbose', [False, True])
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, verbose):
+    proc.verbose = verbose
+    with qtbot.wait_signal(proc.started, timeout=5000):
+        proc.start(*py_proc('import time; time.sleep(10)'))
+
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.terminate()
+
+    assert proc.outcome.was_sigterm()
+    assert proc.outcome.state_str() == 'terminated'
+    assert str(proc.outcome) == 'Testprocess terminated with SIGTERM.'
+    if verbose:
+        msg = message_mock.messages[-1]
+        assert msg.level == usertypes.MessageLevel.info
+        assert msg.text == ("Testprocess terminated with SIGTERM. "
+                            f"See :process {proc.pid} for details.")
+    else:
+        assert not message_mock.messages
+
+
