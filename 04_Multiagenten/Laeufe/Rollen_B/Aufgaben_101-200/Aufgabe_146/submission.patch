         return dmi_facts
 
+    def get_sysinfo_facts(self):
+        """Read system identification from /proc/sysinfo on IBM Z systems."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        sysinfo_keys = {
+            'Manufacturer': 'system_vendor',
+            'Type': 'product_name',
+            'Sequence Code': 'product_serial',
+        }
+
+        for line in get_file_lines('/proc/sysinfo'):
+            key, separator, value = line.partition(':')
+            if separator and key in sysinfo_keys:
+                value = value.strip()
+                if key == 'Sequence Code':
+                    value = value.lstrip('0')
+                sysinfo_facts[sysinfo_keys[key]] = value
+
+        return sysinfo_facts
+
