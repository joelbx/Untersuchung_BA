+// refreshRemoteCluster records the current tunnel state without losing a
+// heartbeat already observed from a connection that has since disappeared.
+func (s *PresenceService) refreshRemoteCluster(clusterName string) error {
+	ctx := context.TODO()
+	key := backend.Key(remoteClustersPrefix, clusterName)
+	for attempt := 0; attempt < 10; attempt++ {
+		item, err := s.Get(ctx, key)
+		if trace.IsNotFound(err) {
+			return nil // A tunnel can be registered before its cluster resource.
+		}
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		cluster, err := services.UnmarshalRemoteCluster(item.Value,
+			services.WithResourceID(item.ID), services.WithExpires(item.Expires))
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		connections, err := s.GetTunnelConnections(clusterName)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		status := teleport.RemoteClusterStatusOffline
+		changed := false
+		latest, err := services.LatestTunnelConnection(connections)
+		if err == nil {
+			status = teleport.RemoteClusterStatusOnline
+			if latest.GetLastHeartbeat().After(cluster.GetLastHeartbeat()) {
+				cluster.SetLastHeartbeat(latest.GetLastHeartbeat().UTC())
+				changed = true
+			}
+		} else if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+		if cluster.GetConnectionStatus() == status && !changed {
+			// A concurrent writer can still change the tunnels; its own refresh
+			// will update the cluster after the tunnel operation completes.
+			return nil
+		}
+		cluster.SetConnectionStatus(status)
+		value, err := json.Marshal(cluster)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		_, err = s.CompareAndSwap(ctx, *item, backend.Item{
+			Key: key, Value: value, Expires: item.Expires, ID: item.ID,
+		})
+		if trace.IsCompareFailed(err) {
+			continue
+		}
+		return trace.Wrap(err)
+	}
+	return trace.CompareFailed("remote cluster %q changed during tunnel update", clusterName)
 }
 
