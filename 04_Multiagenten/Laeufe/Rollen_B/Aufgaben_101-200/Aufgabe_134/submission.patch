diff --git a/openlibrary/tests/core/test_book_providers.py b/openlibrary/tests/core/test_book_providers.py
new file mode 100644
index 0000000..12876ae
--- /dev/null
+++ b/openlibrary/tests/core/test_book_providers.py
@@ -0,0 +1,15 @@
+from openlibrary.book_providers import ProjectRunebergProvider, get_book_provider_by_name
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.is_own_ocaid('Nordic_Runeberg_001')
+    assert not provider.is_own_ocaid('unrelated_001')
+
+    edition = {'identifiers': {'project_runeberg': ['book/first', 'book/second']}}
+    acquisitions = provider.get_acquisitions(edition)
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].url == 'https://runeberg.org/book/first/'
