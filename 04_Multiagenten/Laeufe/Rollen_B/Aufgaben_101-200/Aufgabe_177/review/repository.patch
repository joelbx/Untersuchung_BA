diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..88d3b3a
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,39 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+const meta = require('../../meta');
+
+module.exports = {
+	name: 'Migrate restricted chats to chat allow lists',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settings = await db.getObjects(uids.map(uid => `user:${uid}:settings`));
+			const entries = await Promise.all(uids.map(async (uid, index) => {
+				const current = settings[index] || {};
+				const wasRestricted = current.restrictChat === undefined ? meta.config.restrictChat : current.restrictChat;
+				if (parseInt(wasRestricted, 10) !== 1 || current.chatAllowList !== undefined) {
+					return null;
+				}
+				const [local, remote] = await Promise.all([
+					db.getSortedSetMembers(`following:${uid}`),
+					db.getSortedSetMembers(`followingRemote:${uid}`),
+				]);
+				const allowList = [...new Set([...local, ...remote].map(String))];
+				return [`user:${uid}:settings`, {
+					chatAllowList: JSON.stringify(allowList),
+					...(allowList.length ? {} : { disableIncomingMessages: 1 }),
+				}];
+			}));
+			const updates = entries.filter(Boolean);
+			if (updates.length) {
+				await db.setObjectBulk(updates);
+			}
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
