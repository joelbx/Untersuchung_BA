 package config
 
 import (
+	"io/ioutil"
+	"os"
 	"testing"
 )
 
+func TestWpIgnoreInactiveLoad(t *testing.T) {
+	f, err := ioutil.TempFile("", "vuls-config-*.toml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(f.Name())
+	defer f.Close()
+	if _, err := f.WriteString("wpIgnoreInactive = true\n"); err != nil {
+		t.Fatal(err)
+	}
+
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	if err := (TOMLLoader{}).Load(f.Name(), ""); err != nil {
+		t.Fatal(err)
+	}
+	if !Conf.WpIgnoreInactive {
+		t.Fatal("TOML wpIgnoreInactive was not loaded")
+	}
+
+	if err := f.Truncate(0); err != nil {
+		t.Fatal(err)
+	}
+	Conf = Config{WpIgnoreInactive: true}
+	if err := (TOMLLoader{}).Load(f.Name(), ""); err != nil {
+		t.Fatal(err)
+	}
+	if !Conf.WpIgnoreInactive {
+		t.Fatal("TOML load cleared CLI wp-ignore-inactive")
+	}
+}
