+def test_preview_matched_book_reports_allowed_cover(mock_site, monkeypatch):
+    mock_site.save({
+        'key': '/works/OL902W',
+        'type': {'key': '/type/work'},
+        'title': 'Cover preview',
+    })
+    mock_site.save({
+        'key': '/books/OL902M',
+        'type': {'key': '/type/edition'},
+        'title': 'Cover preview',
+        'source_records': ['ia:cover_preview'],
+        'works': [{'key': '/works/OL902W'}],
+    })
+
+    def unexpected(*args, **kwargs):
+        pytest.fail('preview attempted a write or cover upload')
+
+    monkeypatch.setattr(mock_site, 'save_many', unexpected)
+    monkeypatch.setattr(add_book, 'add_cover', unexpected)
+    reply = load({
+        'title': 'Cover preview',
+        'source_records': ['ia:cover_preview'],
+        'cover': 'https://M.MEDIA-AMAZON.COM/cover.jpg',
+    }, save=False)
+
+    assert reply['cover_accepted'] is True
+    assert reply['edition']['status'] == 'modified'
+    edition_edit = next(e for e in reply['edits'] if e['key'] == '/books/OL902M')
+    assert edition_edit['covers'][0].startswith('/covers/__new__')
+    assert not mock_site.get('/books/OL902M').get('covers')
+
+
+@pytest.mark.parametrize('save', [False, True])
+def test_import_records_modified_existing_author(mock_site, monkeypatch, save):
+    mock_site.save({
+        'key': '/authors/OL903A',
+        'type': {'key': '/type/author'},
+        'name': 'Jane Doe',
+        'remote_ids': {'viaf': '123'},
+    })
+    if not save:
+        monkeypatch.setattr(
+            mock_site, 'save_many',
+            lambda *args, **kwargs: pytest.fail('preview attempted a write'),
+        )
+    reply = load_data({
+        'title': 'Author update',
+        'source_records': ['ia:author_update'],
+        'authors': [{
+            'key': '/authors/OL903A',
+            'name': 'Jane Doe',
+            'remote_ids': {'viaf': '123', 'isni': '456'},
+            'death_date': '2020',
+        }],
+    }, save=save)
+
+    assert reply['authors'][0]['status'] == 'modified'
+    if save:
+        author = mock_site.get('/authors/OL903A')
+        assert author['remote_ids']['isni'] == '456'
+        assert author['death_date'] == '2020'
+    else:
+        author_edit = next(e for e in reply['edits'] if e['key'] == '/authors/OL903A')
+        assert author_edit['remote_ids']['isni'] == '456'
+        assert author_edit['death_date'] == '2020'
+        assert 'isni' not in mock_site.get('/authors/OL903A')['remote_ids']
+
