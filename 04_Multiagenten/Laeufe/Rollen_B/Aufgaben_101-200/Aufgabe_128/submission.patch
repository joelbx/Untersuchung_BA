+    def test_match_set(self):
+        for matches in ([], ['set']):
+            for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+                set_module_args({
+                    'chain': 'INPUT',
+                    'protocol': 'tcp',
+                    'destination_port': '22',
+                    'match': matches,
+                    'match_set': 'admin_hosts',
+                    'match_set_flags': flags,
+                    'jump': 'ACCEPT',
+                    'comment': 'Allow admin SSH',
+                })
+                with patch.object(basic.AnsibleModule, 'run_command', return_value=(0, '', '')) as run_command:
+                    with self.assertRaises(AnsibleExitJson):
+                        iptables.main()
+                self.assertEqual(run_command.call_count, 1)
+                self.assertEqual(run_command.call_args[0][0], [
+                    '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                    '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', flags,
+                    '-j', 'ACCEPT', '--destination-port', '22',
+                    '-m', 'comment', '--comment', 'Allow admin SSH',
+                ])
+
+    def test_inverted_match_set(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': '!admin_hosts',
+            'match_set_flags': 'src',
+            'jump': 'DROP',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command', return_value=(0, '', '')) as run_command:
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'src', '-j', 'DROP',
+        ])
+
+    def test_match_set_with_other_matches(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match': ['set', 'conntrack'],
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'dst',
+            'ctstate': ['NEW'],
+        })
+        with patch.object(basic.AnsibleModule, 'run_command', return_value=(0, '', '')) as run_command:
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '--match-set', 'admin_hosts', 'dst',
+            '-m', 'conntrack', '--ctstate', 'NEW',
+        ])
+
+    def test_match_set_requires_flags_and_name(self):
+        for options in ({'match_set': 'admin_hosts'}, {'match_set_flags': 'src'},
+                        {'match_set': 'admin_hosts', 'match_set_flags': 'invalid'}):
+            set_module_args(dict({'chain': 'INPUT'}, **options))
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_count, 0)
+
