+// NewDowngradedOSSAdminRole creates the restricted admin role used when
+// migrating existing OSS clusters to RBAC. Keeping the admin name preserves
+// role mappings with older trusted clusters.
+func NewDowngradedOSSAdminRole() Role {
+	role := NewOSSUserRole().(*RoleV3)
+	role.SetName(teleport.AdminRoleName)
+	role.Metadata.Labels = map[string]string{teleport.OSSMigratedV6: types.True}
+	return role
+}
