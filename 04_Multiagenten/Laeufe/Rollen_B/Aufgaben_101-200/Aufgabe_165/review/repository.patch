+
+import { MatrixClient } from "matrix-js-sdk/src/client";
+
+import { shouldForceDisableEncryption } from "../../../src/utils/room/shouldForceDisableEncryption";
+import { privateShouldBeEncrypted } from "../../../src/utils/rooms";
+
+describe("forced encryption disable policy", () => {
+    const client = { getClientWellKnown: jest.fn() } as unknown as MatrixClient;
+
+    it.each([undefined, {}, { "io.element.e2ee": {} }, { "io.element.e2ee": { force_disable: "true" } }])(
+        "ignores missing or non-boolean policy in %p",
+        (wellKnown) => {
+            jest.mocked(client.getClientWellKnown).mockReturnValue(wellKnown as any);
+            expect(shouldForceDisableEncryption(client)).toBe(false);
+        },
+    );
+
+    it("forces off encryption even when the default is on", () => {
+        jest.mocked(client.getClientWellKnown).mockReturnValue({
+            "io.element.e2ee": { default: true, force_disable: true },
+        } as any);
+        expect(shouldForceDisableEncryption(client)).toBe(true);
+        expect(privateShouldBeEncrypted(client)).toBe(false);
+    });
+});
