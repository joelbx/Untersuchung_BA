+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type billingTestDynamo struct {
+	dynamodbiface.DynamoDBAPI
+	create      *dynamodb.CreateTableInput
+	describe    *dynamodb.DescribeTableOutput
+	describeErr error
+}
+
+func (m *billingTestDynamo) CreateTableWithContext(_ aws.Context, in *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.create = in
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingTestDynamo) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingTestDynamo) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describe, m.describeErr
+}
+
+func TestBillingModeConfig(t *testing.T) {
+	for _, tc := range []struct {
+		mode  string
+		want  string
+		valid bool
+	}{
+		{"", "pay_per_request", true},
+		{"pay_per_request", "pay_per_request", true},
+		{"provisioned", "provisioned", true},
+		{"invalid", "", false},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: tc.mode}
+			err := cfg.CheckAndSetDefaults()
+			if !tc.valid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.want, cfg.BillingMode)
+		})
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		mode    string
+		awsMode string
+	}{
+		{"pay_per_request", dynamodb.BillingModePayPerRequest},
+		{"provisioned", dynamodb.BillingModeProvisioned},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			mock := &billingTestDynamo{}
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{BillingMode: tc.mode, ReadCapacityUnits: 23, WriteCapacityUnits: 42}, svc: mock}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(mock.create.BillingMode))
+			if tc.mode == "pay_per_request" {
+				require.Nil(t, mock.create.ProvisionedThroughput)
+			} else {
+				require.Equal(t, int64(23), aws.Int64Value(mock.create.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(42), aws.Int64Value(mock.create.ProvisionedThroughput.WriteCapacityUnits))
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		desc   *dynamodb.DescribeTableOutput
+		err    error
+		status tableStatus
+		mode   string
+	}{
+		{"on-demand", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, nil, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"legacy", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}, nil, tableStatusOK, ""},
+		{"missing", nil, awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), tableStatusMissing, ""},
+		{"migration", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}}}, nil, tableStatusNeedsMigration, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &billingTestDynamo{describe: tc.desc, describeErr: tc.err}}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.NoError(t, err)
+			require.Equal(t, tc.status, status)
+			require.Equal(t, tc.mode, mode)
+		})
+	}
+}
