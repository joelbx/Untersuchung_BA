diff --git a/utils/cache/simple_cache.go b/utils/cache/simple_cache.go
new file mode 100644
index 0000000..746ce98
--- /dev/null
+++ b/utils/cache/simple_cache.go
@@ -0,0 +1,117 @@
+package cache
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// SimpleCache stores typed values under string keys.
+type SimpleCache[V any] interface {
+	Add(key string, value V) error
+	AddWithTTL(key string, value V, ttl time.Duration) error
+	Get(key string) (V, error)
+	GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error)
+	Keys() []string
+}
+
+type cacheEntry[V any] struct {
+	value     V
+	expiresAt time.Time
+	order     uint64
+}
+
+type simpleCache[V any] struct {
+	mu      sync.Mutex
+	entries map[string]cacheEntry[V]
+	limit   int
+	next    uint64
+}
+
+// NewSimpleCache returns a cache with no size limit. Values added with Add do
+// not expire; AddWithTTL expires values after the specified duration.
+func NewSimpleCache[V any]() SimpleCache[V] {
+	return newSimpleCacheWithLimit[V](0)
+}
+
+func newSimpleCacheWithLimit[V any](limit int) SimpleCache[V] {
+	return &simpleCache[V]{entries: make(map[string]cacheEntry[V]), limit: limit}
+}
+
+func (c *simpleCache[V]) Add(key string, value V) error {
+	c.store(key, value, time.Time{})
+	return nil
+}
+
+func (c *simpleCache[V]) AddWithTTL(key string, value V, ttl time.Duration) error {
+	c.store(key, value, time.Now().Add(ttl))
+	return nil
+}
+
+func (c *simpleCache[V]) store(key string, value V, expiresAt time.Time) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.removeExpired(time.Now())
+	if c.limit > 0 && len(c.entries) >= c.limit {
+		if _, exists := c.entries[key]; !exists {
+			var oldestKey string
+			var oldestOrder uint64
+			for k, entry := range c.entries {
+				if oldestOrder == 0 || entry.order < oldestOrder {
+					oldestKey, oldestOrder = k, entry.order
+				}
+			}
+			delete(c.entries, oldestKey)
+		}
+	}
+	c.next++
+	c.entries[key] = cacheEntry[V]{value: value, expiresAt: expiresAt, order: c.next}
+}
+
+func (c *simpleCache[V]) Get(key string) (V, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	entry, ok := c.entries[key]
+	if ok && !entry.expiresAt.IsZero() && !time.Now().Before(entry.expiresAt) {
+		delete(c.entries, key)
+		ok = false
+	}
+	if !ok {
+		var zero V
+		return zero, fmt.Errorf("cache key %q not found", key)
+	}
+	return entry.value, nil
+}
+
+func (c *simpleCache[V]) GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error) {
+	value, err := c.Get(key)
+	if err == nil {
+		return value, nil
+	}
+	value, ttl, err := loader(key)
+	if err != nil {
+		var zero V
+		return zero, err
+	}
+	return value, c.AddWithTTL(key, value, ttl)
+}
+
+func (c *simpleCache[V]) Keys() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.removeExpired(time.Now())
+	keys := make([]string, 0, len(c.entries))
+	for key := range c.entries {
+		keys = append(keys, key)
+	}
+	return keys
+}
+
+// removeExpired must be called with the lock held.
+func (c *simpleCache[V]) removeExpired(now time.Time) {
+	for key, entry := range c.entries {
+		if !entry.expiresAt.IsZero() && !now.Before(entry.expiresAt) {
+			delete(c.entries, key)
+		}
+	}
+}
diff --git a/utils/cache/simple_cache_test.go b/utils/cache/simple_cache_test.go
new file mode 100644
index 0000000..9b99d54
--- /dev/null
+++ b/utils/cache/simple_cache_test.go
@@ -0,0 +1,77 @@
+package cache
+
+import (
+	"errors"
+	"slices"
+	"testing"
+	"time"
+)
+
+func TestSimpleCache(t *testing.T) {
+	c := NewSimpleCache[int]()
+	if got, err := c.Get("missing"); got != 0 || err == nil {
+		t.Fatalf("missing key: got %d, %v", got, err)
+	}
+	if err := c.Add("permanent", 12); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := c.Get("permanent"); got != 12 || err != nil {
+		t.Fatalf("permanent key: got %d, %v", got, err)
+	}
+	if err := c.AddWithTTL("temporary", 34, 20*time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := c.Get("temporary"); got != 34 || err != nil {
+		t.Fatalf("temporary key: got %d, %v", got, err)
+	}
+	if keys := c.Keys(); !slices.Contains(keys, "permanent") || !slices.Contains(keys, "temporary") {
+		t.Fatalf("active keys: %v", keys)
+	}
+	time.Sleep(30 * time.Millisecond)
+	if got, err := c.Get("temporary"); got != 0 || err == nil {
+		t.Fatalf("expired key: got %d, %v", got, err)
+	}
+	if keys := c.Keys(); len(keys) != 1 || keys[0] != "permanent" {
+		t.Fatalf("keys after expiry: %v", keys)
+	}
+}
+
+func TestSimpleCacheLoader(t *testing.T) {
+	c := NewSimpleCache[string]()
+	calls := 0
+	loader := func(key string) (string, time.Duration, error) {
+		calls++
+		return key + " value", time.Minute, nil
+	}
+	for range 2 {
+		if got, err := c.GetWithLoader("key", loader); got != "key value" || err != nil {
+			t.Fatalf("loaded value: %q, %v", got, err)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("loader called %d times", calls)
+	}
+	want := errors.New("load failed")
+	got, err := c.GetWithLoader("bad", func(string) (string, time.Duration, error) {
+		return "discard", time.Minute, want
+	})
+	if got != "" || err != want {
+		t.Fatalf("loader error: %q, %v", got, err)
+	}
+	if _, err := c.Get("bad"); err == nil {
+		t.Fatal("failed load was cached")
+	}
+}
+
+func TestSimpleCacheLimit(t *testing.T) {
+	c := newSimpleCacheWithLimit[int](2)
+	_ = c.Add("first", 1)
+	_ = c.Add("second", 2)
+	_ = c.Add("third", 3)
+	if _, err := c.Get("first"); err == nil {
+		t.Fatal("oldest key was not evicted")
+	}
+	if keys := c.Keys(); len(keys) != 2 {
+		t.Fatalf("bounded keys: %v", keys)
+	}
+}
