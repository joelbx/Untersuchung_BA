+    @patch.object(DataLoader, '_get_file_contents')
+    def test_cache_none_bypasses_reads_and_writes(self, mock_contents):
+        mock_contents.side_effect = [(b'foo: first', False), (b'foo: second', False)]
+
+        self.assertEqual(self._loader.load_from_file('vars.yml', cache='none'), {'foo': 'first'})
+        self.assertEqual(self._loader.load_from_file('vars.yml', cache='none'), {'foo': 'second'})
+        self.assertEqual(mock_contents.call_count, 2)
+        self.assertEqual(self._loader._FILE_CACHE, {})
+
+    @patch.object(DataLoader, '_get_file_contents')
+    def test_cache_vaulted_only_caches_vaulted_files(self, mock_contents):
+        mock_contents.side_effect = [(b'foo: plain', True), (b'foo: vaulted', False)]
+
+        self.assertEqual(self._loader.load_from_file('vars.yml', cache='vaulted'), {'foo': 'plain'})
+        self.assertEqual(self._loader._FILE_CACHE, {})
+        self.assertEqual(self._loader.load_from_file('vars.yml', cache='vaulted'), {'foo': 'vaulted'})
+        self.assertEqual(self._loader.load_from_file('vars.yml', cache='vaulted'), {'foo': 'vaulted'})
+        self.assertEqual(mock_contents.call_count, 2)
+        self.assertEqual(len(self._loader._FILE_CACHE), 1)
+
+    @patch.object(DataLoader, '_get_file_contents')
+    def test_cache_none_ignores_existing_entry(self, mock_contents):
+        mock_contents.side_effect = [(b'foo: cached', False), (b'foo: fresh', False)]
+
+        self._loader.load_from_file('vars.yml', cache='vaulted')
+        self.assertEqual(self._loader.load_from_file('vars.yml', cache='none'), {'foo': 'fresh'})
+        self.assertEqual(mock_contents.call_count, 2)
+
