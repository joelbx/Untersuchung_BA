         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_mixed_and_scoped(self):
+        self.get_config.return_value = '''vrf context vrfA
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target import 3:3
+    route-target export 3:3
+    route-target import 4:4
+  address-family ipv6 unicast
+    route-target import 2:2
+vrf context vrfB
+  address-family ipv4 unicast
+    route-target export 2:2
+'''
+        set_module_args(dict(vrf='vrfA', afi='ipv4', route_targets=[
+            dict(rt='1:1'),
+            dict(rt='2:2', direction='export'),
+            dict(rt='3:3', direction='both', state='absent'),
+            dict(rt='4:4', direction='import', state='absent'),
+            dict(rt='5:5', direction='export', state='absent')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context vrfA', 'address-family ipv4 unicast',
+            'route-target export 1:1', 'route-target export 2:2',
+            'no route-target import 3:3', 'no route-target export 3:3',
+            'no route-target import 4:4'])
+
+    def test_route_targets_idempotent(self):
+        self.get_config.return_value = '''vrf context vrfA
+  address-family ipv6 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='vrfA', afi='ipv6',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='1:1'),
+                                            dict(rt='2:2', state='absent')]))
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_route_targets_new_af(self):
+        self.get_config.return_value = 'vrf context vrfA\n'
+        set_module_args(dict(vrf='vrfA', afi='ipv6', route_targets=[
+            dict(rt='65000:1000'), dict(rt='65000:2000', direction='import')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context vrfA', 'address-family ipv6 unicast',
+            'route-target import 65000:1000',
+            'route-target export 65000:1000',
+            'route-target import 65000:2000'])
+
+    def test_route_targets_exact_lines_and_last_entry_wins(self):
+        self.get_config.return_value = '''vrf context vrfA
+  address-family ipv4 unicast
+    route-target import 1:10
+    route-target export 1:1
+'''
+        set_module_args(dict(vrf='vrfA', afi='ipv4', route_targets=[
+            dict(rt='1:1', state='absent'),
+            dict(rt='1:1', direction='import', state='present')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context vrfA', 'address-family ipv4 unicast',
+            'route-target import 1:1', 'no route-target export 1:1'])
+
+    def test_absent_af_ignores_route_targets(self):
+        self.get_config.return_value = '''vrf context vrfA
+  address-family ipv4 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='vrfA', afi='ipv4', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='1:1', state='absent')]))
+        result = self.execute_module(changed=True)
