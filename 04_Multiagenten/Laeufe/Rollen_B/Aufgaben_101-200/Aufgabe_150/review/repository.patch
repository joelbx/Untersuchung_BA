+def test_build_ignore_file_symlink_target_outside_collection(collection_input, monkeypatch):
+    input_dir, outside_dir = collection_input
+    outside_file = os.path.join(outside_dir, 'outside.txt')
+    with open(outside_file, 'w') as file_obj:
+        file_obj.write('outside')
+    link_path = os.path.join(input_dir, 'docs', 'outside.txt')
+    os.symlink(outside_file, link_path)
+
+    mock_display = MagicMock()
+    monkeypatch.setattr(Display, 'warning', mock_display)
+    actual = collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', [], Sentinel)
+
+    assert actual['format'] == 1
+    assert 'docs/outside.txt' not in [entry['name'] for entry in actual['files']]
+    mock_display.assert_called_once_with("Skipping '%s' as it is a symbolic link to a file outside the collection"
+                                         % to_text(link_path))
+
+
+def test_build_file_symlink_target_inside_collection(collection_input):
+    input_dir = collection_input[0]
+    link_path = os.path.join(input_dir, 'docs', 'README.md')
+    os.symlink(os.path.join(input_dir, 'README.md'), link_path)
+
+    actual = collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', [], Sentinel)
+
+    linked_entries = [entry for entry in actual['files'] if entry['name'] == 'docs/README.md']
+    assert len(linked_entries) == 1
+    assert linked_entries[0]['ftype'] == 'file'
+
