+@pytest.mark.parametrize('galaxy_yml_dir, expected', [
+    (b'namespace: namespace\nname: collection\nauthors: Jordan\nversion: 0.1.0\nreadme: README.md\n', Sentinel),
+    (b'namespace: namespace\nname: collection\nauthors: Jordan\nversion: 0.1.0\nreadme: README.md\nmanifest: {}\n', {}),
+    (b'namespace: namespace\nname: collection\nauthors: Jordan\nversion: 0.1.0\nreadme: README.md\nmanifest: null\n', None),
+], indirect=['galaxy_yml_dir'])
+def test_galaxy_yml_manifest_values(galaxy_yml_dir, expected):
+    actual = collection.concrete_artifact_manager._get_meta_from_src_dir(galaxy_yml_dir)
+    if expected is Sentinel:
+        assert actual['manifest'] is Sentinel
+    else:
+        assert actual['manifest'] == expected
+
+
+def test_empty_manifest_uses_directives(collection_input, monkeypatch):
+    input_dir = to_bytes(collection_input[0])
+    mock_distlib = MagicMock(return_value={'format': 1, 'files': []})
+    monkeypatch.setattr(collection, '_build_files_manifest_distlib', mock_distlib)
+
+    assert collection._build_files_manifest(input_dir, 'namespace', 'collection', [], {}) == mock_distlib.return_value
+    mock_distlib.assert_called_once_with(input_dir, 'namespace', 'collection', {})
+
+
+def test_empty_manifest_conflicts_with_build_ignore(collection_input):
+    with pytest.raises(AnsibleError, match='"build_ignore" and "manifest" are mutually exclusive'):
+        collection._build_files_manifest(to_bytes(collection_input[0]), 'namespace', 'collection', ['*.md'], {})
+
+
+def test_null_manifest_uses_walk_and_build_ignore(collection_input):
+    input_dir = collection_input[0]
+    actual = collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', ['*.md'], None)
+
+    assert actual['format'] == 1
+    names = [entry['name'] for entry in actual['files']]
+    assert 'README.md' not in names
+    assert 'plugins' in names
+
