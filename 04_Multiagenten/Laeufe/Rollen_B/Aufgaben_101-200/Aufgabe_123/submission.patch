diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..ae75698
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,119 @@
+import { fireEvent, render, waitFor } from '@testing-library/react';
+import { Dispatch, SetStateAction, useState } from 'react';
+
+import Container from './Container';
+import { NotificationOptions } from './interfaces';
+import createNotificationManager from './manager';
+
+describe('notifications', () => {
+    it('uses distinct React keys when a success ID matches another notification key', () => {
+        const consoleError = jest.spyOn(console, 'error').mockImplementation(() => {});
+        try {
+            const notifications: NotificationOptions[] = [
+                { id: 1, key: 1, type: 'success', text: 'Success', isClosing: false },
+                { id: 2, key: '1', type: 'error', text: '1', isClosing: false },
+            ];
+            const { container } = render(
+                <Container notifications={notifications} removeNotification={() => {}} hideNotification={() => {}} />
+            );
+
+            expect(container.querySelectorAll('.notification')).toHaveLength(2);
+            expect(consoleError.mock.calls.some(([message]) => String(message).includes('same key'))).toBe(false);
+        } finally {
+            consoleError.mockRestore();
+        }
+    });
+
+    it('secures links inserted after a React child updates', async () => {
+        const DelayedLink = () => {
+            const [visible, setVisible] = useState(false);
+            return (
+                <div>
+                    <button onClick={() => setVisible(true)}>Show link</button>
+                    {visible && <a href="https://example.com">New link</a>}
+                </div>
+            );
+        };
+        const notifications: NotificationOptions[] = [
+            { id: 1, key: 1, type: 'info', text: <DelayedLink />, isClosing: false },
+        ];
+        const { container, getByText } = render(
+            <Container notifications={notifications} removeNotification={() => {}} hideNotification={() => {}} />
+        );
+
+        fireEvent.click(getByText('Show link'));
+        await waitFor(() => {
+            const link = container.querySelector('a');
+            expect(link?.getAttribute('rel')).toBe('noopener noreferrer');
+            expect(link?.getAttribute('target')).toBe('_blank');
+        });
+    });
+
+    it('renders safe HTML and forces links to open safely', () => {
+        const notifications: NotificationOptions[] = [
+            {
+                id: 1,
+                key: 1,
+                type: 'error',
+                text: '<b>Try</b> <a href="https://example.com" target="_self" onclick="alert(1)">again</a><script>alert(1)</script>',
+                isClosing: false,
+            },
+            { id: 2, key: 2, type: 'info', text: '<a href="javascript:alert(1)">bad link</a>', isClosing: false },
+            {
+                id: 3,
+                key: 3,
+                type: 'info',
+                text: <a href="https://react.example">React content</a>,
+                isClosing: false,
+            },
+        ];
+        const { container } = render(
+            <Container notifications={notifications} removeNotification={() => {}} hideNotification={() => {}} />
+        );
+
+        expect(container.querySelector('b')?.textContent).toBe('Try');
+        const links = container.querySelectorAll('a');
+        expect(links).toHaveLength(3);
+        links.forEach((link) => {
+            expect(link.getAttribute('rel')).toBe('noopener noreferrer');
+            expect(link.getAttribute('target')).toBe('_blank');
+        });
+        expect(links[0].getAttribute('href')).toBe('https://example.com');
+        expect(links[0].hasAttribute('onclick')).toBe(false);
+        expect(links[1].hasAttribute('href')).toBe(false);
+        expect(container.querySelector('script')).toBeNull();
+        expect(links[2].textContent).toBe('React content');
+    });
+
+    it('deduplicates non-success notifications by resolved key', () => {
+        let notifications: NotificationOptions[] = [];
+        const setNotifications: Dispatch<SetStateAction<NotificationOptions[]>> = (update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        };
+        const manager = createNotificationManager(setNotifications);
+
+        manager.createNotification({ type: 'success', text: 'same', expiration: -1 });
+        manager.createNotification({ type: 'error', text: 'same', expiration: -1 });
+        manager.createNotification({ type: 'info', text: 'same', expiration: -1 });
+        expect(notifications).toHaveLength(2);
+        expect(notifications[0].type).toBe('success');
+        expect(notifications[1].type).toBe('info');
+        expect(notifications[1].key).toBe('same');
+
+        manager.createNotification({ type: 'error', text: 'first', key: 'explicit', expiration: -1 });
+        manager.createNotification({ type: 'warning', text: 'second', key: 'explicit', expiration: -1 });
+        expect(notifications).toHaveLength(3);
+        expect(notifications[2].text).toBe('second');
+        expect(notifications[2].key).toBe('explicit');
+
+        manager.createNotification({ type: 'error', text: <b>one</b>, expiration: -1 });
+        manager.createNotification({ type: 'error', text: <b>one</b>, expiration: -1 });
+        expect(notifications).toHaveLength(5);
+        expect(notifications[3].key).toBe(notifications[3].id);
+        expect(notifications[4].key).toBe(notifications[4].id);
+
+        manager.createNotification({ type: 'success', text: 'same', expiration: -1 });
+        expect(notifications).toHaveLength(6);
+        expect(notifications[5].type).toBe('success');
+    });
+});
