         network_facts['default_ipv6'] = default_ipv6
         network_facts['all_ipv4_addresses'] = ips['all_ipv4_addresses']
         network_facts['all_ipv6_addresses'] = ips['all_ipv6_addresses']
+        network_facts['locally_reachable_ips'] = self.get_locally_reachable_ips(ip_path)
         return network_facts
 
+    def get_locally_reachable_ips(self, ip_path):
+        """Return destinations of host-scope routes for both IP families."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for version, family, width in (('ipv4', socket.AF_INET, 32),
+                                       ('ipv6', socket.AF_INET6, 128)):
+            command = [ip_path, '-4' if width == 32 else '-6',
+                       'route', 'show', 'table', 'all', 'scope', 'host']
+            try:
+                rc, output, stderr = self.module.run_command(command, errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Could not collect locally reachable %s routes' % version)
+                continue
+
+            destinations = set()
+            for line in output.splitlines():
+                words = line.split()
+                if not words:
+                    continue
+                if 'scope' in words:
+                    scope_index = words.index('scope')
+                    if scope_index + 1 >= len(words) or words[scope_index + 1] != 'host':
+                        continue
+                # Typed local routes begin with "local"; ordinary host-scope
+                # prefixes begin directly with their destination.
+                if words[0] == 'local':
+                    if len(words) < 2:
+                        continue
+                    destination = words[1]
+                else:
+                    destination = words[0]
+                address, separator, prefix_text = destination.partition('/')
+                try:
+                    prefix = int(prefix_text) if separator else width
+                    if prefix < 0 or prefix > width:
+                        continue
+                    packed = bytearray(socket.inet_pton(family, address))
+                except (ValueError, socket.error):
+                    continue
+                masked = []
+                for index, value in enumerate(packed):
+                    bits = max(0, min(8, prefix - index * 8))
+                    masked.append(value & (255 << (8 - bits) & 255))
+                masked = tuple(masked)
+                normalized = socket.inet_ntop(family, struct.pack('%dB' % len(masked), *masked))
+                if prefix != width:
+                    normalized += '/%d' % prefix
+                destinations.add((masked, prefix, normalized))
+            reachable[version] = [item[2] for item in sorted(destinations)]
+        return reachable
+
     def get_default_interfaces(self, ip_path, collected_facts=None):
