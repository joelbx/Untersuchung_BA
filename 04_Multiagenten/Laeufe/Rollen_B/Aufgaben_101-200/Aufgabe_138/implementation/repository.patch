+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		option   []containers.Option[StoreOptions]
+		artifact bool
+	}{
+		{name: "default 1.1", artifact: true},
+		{name: "explicit 1.0", option: []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			ref, err := ParseReference("flipt://local/version-test:latest")
+			require.NoError(t, err)
+			store, err := NewStore(zaptest.NewLogger(t), t.TempDir(), tc.option...)
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			_, err = store.Build(ctx, src, ref)
+			require.NoError(t, err)
+
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			data, err := content.FetchAll(ctx, target, desc)
+			require.NoError(t, err)
+			var manifest struct {
+				ArtifactType string `json:"artifactType"`
+				Config       struct {
+					MediaType string `json:"mediaType"`
+				} `json:"config"`
+			}
+			require.NoError(t, json.Unmarshal(data, &manifest))
+			if tc.artifact {
+				assert.Equal(t, MediaTypeFliptFeatures, manifest.ArtifactType)
+			} else {
+				assert.Empty(t, manifest.ArtifactType)
+				assert.Equal(t, MediaTypeFliptFeatures, manifest.Config.MediaType)
+			}
+			resp, err := store.Fetch(ctx, ref)
+			require.NoError(t, err)
+			assert.Len(t, resp.Files, 2)
+		})
+	}
+}
