+def test_missing_asin_does_not_interrupt_staging(monkeypatch):
+    calls = []
+    monkeypatch.setattr(promise, 'get_amazon_metadata', lambda **kwargs: calls.append(kwargs))
+    books = [
+        {'BookSKUB': 'first', 'ISBN': '', 'ProductJSON': {'Title': 'First'}},
+        {'BookSKUB': 'second', 'ASIN': 'B123456789', 'ProductJSON': {'Title': 'Second'}},
+    ]
+    mapped = [promise.map_book_to_olbook(book, 'batch') for book in books]
+    assert 'identifiers' not in mapped[0] or 'amazon' not in mapped[0]['identifiers']
+    promise.stage_b_asins_for_import(mapped)
+    assert calls == [{'id_': 'B123456789', 'id_type': 'asin'}]
+
+
+def test_stage_skips_invalid_identifiers(monkeypatch):
+    calls = []
+    monkeypatch.setattr(promise, 'get_amazon_metadata', lambda **kwargs: calls.append(kwargs))
+    promise.stage_b_asins_for_import([
+        {'isbn_10': [None, 123], 'identifiers': {'amazon': [None, 456, 'B123456789']}},
+        {'isbn_10': [None, '0123456789'], 'identifiers': {'amazon': ['B987654321']}},
+    ])
+    assert calls == [
+        {'id_': 'B123456789', 'id_type': 'asin'},
+        {'id_': '0123456789', 'id_type': 'isbn'},
+    ]
+
+
