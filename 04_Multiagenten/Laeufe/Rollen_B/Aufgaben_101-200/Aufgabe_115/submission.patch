+def test_new_work_preserves_author_roles(mock_site):
+    edition = {
+        'authors': [
+            {'key': '/authors/OL1A'},
+            {'key': '/authors/OL2A'},
+            {'key': '/authors/OL3A'},
+        ]
+    }
+    record = {
+        'title': 'Example',
+        'authors': [
+            {'key': '/authors/OL1A', 'name': 'First', 'role': 'Editor'},
+            {'key': '/authors/OL2A', 'name': 'Second'},
+            {'key': '/authors/OL3A', 'name': 'Third', 'role': 'Translator'},
+        ],
+    }
+    assert new_work(edition, record)['authors'] == [
+        {
+            'type': {'key': '/type/author_role'},
+            'author': {'key': '/authors/OL1A'},
+            'role': 'Editor',
+        },
+        {'type': {'key': '/type/author_role'}, 'author': {'key': '/authors/OL2A'}},
+        {
+            'type': {'key': '/type/author_role'},
+            'author': {'key': '/authors/OL3A'},
+            'role': 'Translator',
+        },
+    ]
+
+
+def test_new_work_matches_roles_when_edition_authors_are_reordered(mock_site):
+    for key, name in (('/authors/OL1A', 'First'), ('/authors/OL2A', 'Second')):
+        mock_site.save({'key': key, 'name': name, 'type': {'key': '/type/author'}})
+
+    work = new_work(
+        {'authors': [{'key': '/authors/OL2A'}, {'key': '/authors/OL1A'}]},
+        {
+            'title': 'Example',
+            'authors': [
+                {'name': 'First', 'role': 'Editor'},
+                {'name': 'Second', 'role': 'Translator'},
+            ],
+        },
+    )
+    assert [author['role'] for author in work['authors']] == [
+        'Translator',
+        'Editor',
+    ]
+
+
+def test_load_data_keeps_roles_with_existing_edition_author_order(mock_site):
+    for key, name in (('/authors/OL1A', 'First'), ('/authors/OL2A', 'Second')):
+        mock_site.save({'key': key, 'name': name, 'type': {'key': '/type/author'}})
+    mock_site.save(
+        {
+            'key': '/books/OL1M',
+            'title': 'Example',
+            'type': {'key': '/type/edition'},
+            'authors': [{'key': '/authors/OL2A'}, {'key': '/authors/OL1A'}],
+            'source_records': [],
+        }
+    )
+    reply = load_data(
+        {
+            'title': 'Example',
+            'source_records': ['marc:test'],
+            'authors': [
+                {'name': 'First', 'role': 'Editor'},
+                {'name': 'Second', 'role': 'Translator'},
+            ],
+        },
+        existing_edition=mock_site.get('/books/OL1M'),
+    )
+    work = mock_site.get(reply['work']['key'])
+    assert [author['role'] for author in work['authors']] == [
+        'Translator',
+        'Editor',
+    ]
+
+
+def test_update_work_with_rec_data_preserves_author_roles(mock_site):
+    mock_site.save(
+        {'key': '/authors/OL1A', 'name': 'First', 'type': {'key': '/type/author'}}
+    )
+    mock_site.save(
+        {'key': '/books/OL1M', 'title': 'Example', 'type': {'key': '/type/edition'}}
+    )
+    work = {}
+    assert update_work_with_rec_data(
+        {'authors': [{'name': 'First', 'role': 'Editor'}]},
+        mock_site.get('/books/OL1M'),
+        work,
+        False,
+    )
+    assert work['authors'] == [
+        {
+            'type': {'key': '/type/author_role'},
+            'author': '/authors/OL1A',
+            'role': 'Editor',
+        }
+    ]
+
+
+def test_new_work_rejects_mismatched_author_counts(mock_site):
+    with pytest.raises(Exception, match='author counts do not match'):
+        new_work(
+            {'authors': [{'key': '/authors/OL1A'}]},
+            {'title': 'Example', 'authors': []},
+        )
