+@pytest.mark.parametrize("blocked_set", ["_blocked_hosts", "_config_blocked_hosts"])
+def test_parent_domain_blocking(config_stub, host_blocker_factory, blocked_set):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.whitelist = ["https://allowed.example.com/*"]
+
+    host_blocker = host_blocker_factory()
+    getattr(host_blocker, blocked_set).add("example.com")
+
+    for hostname in ("example.com", "sub.example.com", "a.b.example.com"):
+        assert host_blocker._is_blocked(QUrl("https://{}/path".format(hostname)))
+        assert host_blocker._is_blocked(QUrl("https://{}./path".format(hostname)))
+
+    assert not host_blocker._is_blocked(QUrl("https://allowed.example.com/path"))
+    assert not host_blocker._is_blocked(QUrl("https://otherexample.com/path"))
+
+
