+@pytest.mark.parametrize("blocked_set", ["_blocked_hosts", "_config_blocked_hosts"])
+def test_trailing_dot_blocklist_entry(
+    config_stub, data_tmpdir, config_tmpdir, host_blocker_factory, blocked_set
+):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.hosts.lists = []
+
+    host_blocker = host_blocker_factory()
+    directory = data_tmpdir if blocked_set == "_blocked_hosts" else config_tmpdir
+    create_blocklist(directory, blocked_hosts=["example.com."], name="blocked-hosts")
+    host_blocker.read_hosts()
+    assert getattr(host_blocker, blocked_set) == {"example.com"}
+
+    for hostname in ("example.com", "example.com.", "sub.example.com", "sub.example.com."):
+        assert host_blocker._is_blocked(QUrl("https://{}/path".format(hostname)))
+
