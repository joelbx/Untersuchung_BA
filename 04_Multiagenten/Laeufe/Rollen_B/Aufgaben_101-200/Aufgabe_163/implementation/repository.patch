+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseSQLite:
+		return "sqlite3"
+	case DatabasePostgres:
+		return "postgres"
+	case DatabaseMySQL:
+		return "mysql"
+	default:
+		return ""
+	}
+}
+
+// ValidateDatabase checks the selected database configuration mode.
+func (c DatabaseConfig) ValidateDatabase() error {
+	if c.Protocol != 0 && c.Protocol.String() == "" {
+		return fmt.Errorf("db.protocol: invalid value %d (expected sqlite3, postgres, or mysql)", c.Protocol)
+	}
+	if c.URL != "" {
+		return nil
+	}
+	if c.Protocol == 0 {
+		return errors.New("db.protocol is required when db.url is empty (expected sqlite3, postgres, or mysql)")
+	}
+	if c.Host == "" {
+		return errors.New("db.host is required when db.url is empty (directory path for sqlite3)")
+	}
+	if c.Name == "" {
+		return errors.New("db.name is required when db.url is empty")
+	}
+	if c.Port < 0 || c.Port > 65535 {
+		return fmt.Errorf("db.port: invalid value %d (expected 0 through 65535)", c.Port)
+	}
+	return nil
 }
 
