+func openConfig(cfg config.Config, migrate bool) (*sql.DB, Driver, error) {
+	raw, err := connectionTarget(cfg.Database)
+	if err != nil {
+		return nil, 0, fmt.Errorf("validating database configuration: %w", err)
+	}
+	return open(raw, migrate)
+}
+
+func connectionTarget(c config.DatabaseConfig) (string, error) {
+	if err := c.ValidateDatabase(); err != nil {
+		return "", err
+	}
+	if c.URL != "" {
+		return c.URL, nil
+	}
+	if c.Protocol == config.DatabaseSQLite {
+		return "file:" + filepath.Join(c.Host, c.Name), nil
+	}
+	port := c.Port
+	if port == 0 {
+		if c.Protocol == config.DatabasePostgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: c.Protocol.String(), Host: net.JoinHostPort(c.Host, strconv.Itoa(port)), Path: "/" + c.Name}
+	if c.Password != "" {
+		u.User = url.UserPassword(c.User, c.Password)
+	} else if c.User != "" {
+		u.User = url.User(c.User)
+	}
+	return u.String(), nil
+}
