+func TestDatabasePortLoad(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	for _, tt := range []struct {
+		port    string
+		wantErr bool
+	}{
+		{port: "5432"},
+		{port: "not-a-port", wantErr: true},
+		{port: "5432.5", wantErr: true},
+		{port: "65536", wantErr: true},
+	} {
+		t.Run(tt.port, func(t *testing.T) {
+			require.NoError(t, ioutil.WriteFile(path, []byte("db:\n  protocol: postgres\n  host: localhost\n  name: flipt\n  port: "+tt.port+"\n"), 0600))
+			cfg, err := Load(path)
+			if tt.wantErr {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "db.port")
+				assert.Contains(t, err.Error(), tt.port)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, 5432, cfg.Database.Port)
+		})
+	}
+}
