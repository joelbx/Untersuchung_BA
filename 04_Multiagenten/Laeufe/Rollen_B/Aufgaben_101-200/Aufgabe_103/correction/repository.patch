+		if err != nil {
+			t.Fatal(err)
+		}
+		if bins["example"].Version != "2.1" || bins["example"].Release != "" || bins["example"].Repository != tc.repository || srcs["example"].Version != "2.1" {
+			t.Errorf("line=%q bins=%+v srcs=%+v", tc.line, bins, srcs)
+		}
+	}
+}
