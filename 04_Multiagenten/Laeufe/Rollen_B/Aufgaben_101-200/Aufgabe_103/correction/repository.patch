+func TestSplitFileNameSourceAndMalformed(t *testing.T) {
+	for _, tc := range []struct {
+		file, name, version, release, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src"},
+		{"package-0-1-extra-src.rpm", "package", "0", "1-extra", "src"},
+		{"package-0-1-extra.src.rpm", "package", "0", "1-extra", "src"},
+		{"package-0--src.rpm", "package", "0", "", "src"},
+		{"package-0-1.src.rpm", "package", "0", "1", "src"},
+	} {
+		name, version, release, _, arch, err := splitFileName(tc.file)
+		if err != nil || name != tc.name || version != tc.version || release != tc.release || arch != tc.arch {
+			t.Errorf("%s: got %q %q %q %q, err=%v", tc.file, name, version, release, arch, err)
+		}
+	}
+	for _, file := range []string{"package-0-1", "-0-1.src.rpm", "package--1.src.rpm", "package-0-1..rpm", "package-0-1-.rpm", "package-0-1.x86_64.zip", "package-2-foo-0-1-extra.src.rpm", "package-1-0-1-extra.src.rpm"} {
+		if _, _, _, _, _, err := splitFileName(file); err == nil {
+			t.Errorf("expected error for %q", file)
+		}
+	}
+}
