+// The query format uses literal spaces between fields. Splitting on those
+// spaces retains an empty release between two adjacent separators.
+func installedPackageFields(line string) []string {
+	return strings.Split(strings.TrimSpace(line), " ")
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
