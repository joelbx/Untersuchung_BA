+func TestInstalledPackagesEmptyRelease(t *testing.T) {
+	for _, tc := range []struct {
+		name, epoch, wantVersion string
+	}{
+		{"zero", "0", "2.1"},
+		{"none", "(none)", "2.1"},
+		{"nonzero", "3", "3:2.1"},
+	} {
+		for _, repoquery := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/repoquery=%t", tc.name, repoquery), func(t *testing.T) {
+				line := "example " + tc.epoch + " 2.1  x86_64 example-2.1-.src.rpm"
+				var pkg *models.Package
+				var src *models.SrcPackage
+				var err error
+				o := &redhatBase{}
+				if repoquery {
+					pkg, src, err = o.parseInstalledPackagesLineFromRepoquery(line + " installed")
+				} else {
+					pkg, src, err = o.parseInstalledPackagesLine(line)
+				}
+				if err != nil || pkg == nil || src == nil {
+					t.Fatalf("pkg=%v src=%v err=%v", pkg, src, err)
+				}
+				if pkg.Name != "example" || pkg.Version != tc.wantVersion || pkg.Release != "" || pkg.Arch != "x86_64" || src.Name != "example" || src.Version != tc.wantVersion {
+					t.Errorf("pkg=%+v src=%+v", pkg, src)
+				}
+				if repoquery && pkg.Repository != "amzn2-core" {
+					t.Errorf("repository=%q", pkg.Repository)
+				}
+			})
+		}
+	}
+}
+
+func TestParseInstalledPackagesEmptyReleaseAmazon2(t *testing.T) {
+	for _, tc := range []struct {
