diff --git a/scanner/redhatbase.go b/scanner/redhatbase.go
index a51112a..ae46c48 100644
--- a/scanner/redhatbase.go
+++ b/scanner/redhatbase.go
@@ -714,17 +714,45 @@ func splitFileName(filename string) (name, ver, rel, epoch, arch string, err err
 	if verIndex == -1 {
 		return invalid()
 	}
-	// In the -src spelling the release can contain hyphens. Choose the
-	// rightmost numeric version after a name component and retain the rest
-	// as the release.
-	if basename[archIndex] == '-' {
+	// A source release may contain hyphens with either .src or -src.
+	// Find the first numeric component in the final numeric run. A second
+	// numeric run makes the name/version boundary ambiguous.
+	if arch == "src" {
 		parts := strings.Split(basename[:archIndex], "-")
-		for i := len(parts) - 2; i > 0; i-- {
-			if parts[i] != "" && parts[i][0] >= '0' && parts[i][0] <= '9' && (parts[i-1] == "" || parts[i-1][0] < '0' || parts[i-1][0] > '9') {
-				verIndex = len(strings.Join(parts[:i], "-"))
-				relIndex = verIndex + 1 + len(parts[i])
-				break
+		isNumericPart := func(part string) bool {
+			return len(part) > 0 && part[0] >= '0' && part[0] <= '9' && !strings.Contains(part, ":")
+		}
+		numericRun := 0
+		for _, part := range parts {
+			if isNumericPart(part) {
+				numericRun++
+				if numericRun > 2 {
+					return invalid()
+				}
+			} else {
+				numericRun = 0
+			}
+		}
+		candidates := []int{}
+		for i := 1; i < len(parts)-1; i++ {
+			if !isNumericPart(parts[i]) {
+				continue
+			}
+			if isNumericPart(parts[i-1]) {
+				continue
+			}
+			candidates = append(candidates, i)
+		}
+		standardVersion := parts[len(parts)-2]
+		standardPredecessor := parts[len(parts)-3]
+		standardBoundary := isNumericPart(standardVersion) && !isNumericPart(standardPredecessor)
+		if !standardBoundary {
+			if len(candidates) != 1 {
+				return invalid()
 			}
+			candidate := candidates[0]
+			verIndex = len(strings.Join(parts[:candidate], "-"))
+			relIndex = verIndex + 1 + len(parts[candidate])
 		}
 	}
 	ver = basename[verIndex+1 : relIndex]
