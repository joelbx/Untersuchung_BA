+// UnmarshalJSON accepts both string listenPorts from older scans and the
+// structured listenPorts written by the previous scan result schema.
+func (p *AffectedProcess) UnmarshalJSON(data []byte) error {
+	type process AffectedProcess
+	var saved struct {
+		*process
+		ListenPorts json.RawMessage `json:"listenPorts"`
+	}
+	saved.process = new(process)
+	if err := json.Unmarshal(data, &saved); err != nil {
+		return err
+	}
+	if len(saved.ListenPorts) != 0 && string(saved.ListenPorts) != "null" {
+		var entries []json.RawMessage
+		if err := json.Unmarshal(saved.ListenPorts, &entries); err != nil {
+			return fmt.Errorf("decode listenPorts: %w", err)
+		}
+		for _, entry := range entries {
+			var port string
+			if err := json.Unmarshal(entry, &port); err == nil {
+				saved.process.ListenPorts = append(saved.process.ListenPorts, port)
+				continue
+			}
+			var old struct {
+				Address           string   `json:"address"`
+				BindAddress       string   `json:"bindAddress"`
+				Port              string   `json:"port"`
+				PortScanSuccessOn []string `json:"portScanSuccessOn"`
+				PortReachableTo   []string `json:"portReachableTo"`
+			}
+			if err := json.Unmarshal(entry, &old); err != nil {
+				return fmt.Errorf("decode listenPorts entry: %w", err)
+			}
+			address := old.BindAddress
+			if address == "" {
+				address = old.Address
+			}
+			reachable := old.PortReachableTo
+			if reachable == nil {
+				reachable = old.PortScanSuccessOn
+			}
+			saved.process.ListenPortStats = append(saved.process.ListenPortStats, PortStat{
+				BindAddress: address, Port: old.Port, PortReachableTo: reachable,
+			})
+		}
+	}
+	*p = AffectedProcess(*saved.process)
+	return nil
+}
