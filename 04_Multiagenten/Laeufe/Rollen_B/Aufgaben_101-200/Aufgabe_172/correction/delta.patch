+func TestAffectedProcessStructuredListenPorts(t *testing.T) {
+	var pack Package
+	data := []byte(`{"affectedProcs":[{"pid":"75","listenPorts":[{"address":"*","port":"22","portScanSuccessOn":["127.0.0.1","192.168.1.1"]},{"address":"127.0.0.1","port":"80"}]}]}`)
+	if err := json.Unmarshal(data, &pack); err != nil {
+		t.Fatal(err)
+	}
+	proc := pack.AffectedProcs[0]
+	if proc.PID != "75" || proc.ListenPorts != nil {
+		t.Errorf("unexpected process fields: %+v", proc)
+	}
+	want := []PortStat{
+		{BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1", "192.168.1.1"}},
+		{BindAddress: "127.0.0.1", Port: "80"},
+	}
+	if !reflect.DeepEqual(proc.ListenPortStats, want) {
+		t.Errorf("port stats = %#v, want %#v", proc.ListenPortStats, want)
+	}
+	if !pack.HasReachablePort() {
+		t.Fatal("saved reachability was lost")
+	}
+}
+
+func TestAffectedProcessMixedListenPorts(t *testing.T) {
+	var proc AffectedProcess
+	data := []byte(`{"listenPorts":["*:22",{"address":"127.0.0.1","port":"80","portScanSuccessOn":["127.0.0.1"]}],"listenPortStats":[{"bindAddress":"[::1]","port":"443","portReachableTo":["[::1]"]}]}`)
+	if err := json.Unmarshal(data, &proc); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(proc.ListenPorts, []string{"*:22"}) {
+		t.Errorf("listen ports = %v", proc.ListenPorts)
+	}
+	want := []PortStat{
+		{BindAddress: "[::1]", Port: "443", PortReachableTo: []string{"[::1]"}},
+		{BindAddress: "127.0.0.1", Port: "80", PortReachableTo: []string{"127.0.0.1"}},
+	}
+	if !reflect.DeepEqual(proc.ListenPortStats, want) {
+		t.Errorf("port stats = %#v, want %#v", proc.ListenPortStats, want)
+	}
+}
