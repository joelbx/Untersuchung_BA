diff --git a/packages/drive-store/zustand/share/shareStores.test.ts b/packages/drive-store/zustand/share/shareStores.test.ts
new file mode 100644
index 0000000..c1cbb01
--- /dev/null
+++ b/packages/drive-store/zustand/share/shareStores.test.ts
@@ -0,0 +1,84 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareInvitation;
+const externalInvitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareExternalInvitation;
+
+describe('share member stores', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('returns empty arrays for share IDs matching inherited object properties', () => {
+        const members = useMembersStore.getState();
+        const invitations = useInvitationsStore.getState();
+
+        for (const shareId of ['toString', '__proto__', 'constructor']) {
+            expect(members.getMembers(shareId)).toEqual([]);
+            expect(invitations.getInvitations(shareId)).toEqual([]);
+            expect(invitations.getExternalInvitations(shareId)).toEqual([]);
+        }
+
+        members.setMembers('toString', [member('member@example.com')]);
+        invitations.setInvitations('toString', [invitation('invitee@example.com')]);
+        invitations.setExternalInvitations('toString', [externalInvitation('external@example.com')]);
+        expect(members.getMembers('toString').map(({ email }) => email)).toEqual(['member@example.com']);
+        expect(invitations.getInvitations('toString').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+            'invitee@example.com',
+        ]);
+        expect(invitations.getExternalInvitations('toString').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+            'external@example.com',
+        ]);
+    });
+
+    it('replaces members only for the selected share', () => {
+        const store = useMembersStore.getState();
+        expect(store.getMembers('missing')).toEqual([]);
+
+        store.setMembers('a', [member('a@example.com')]);
+        store.setMembers('b', [member('b@example.com')]);
+        store.setMembers('a', [member('new@example.com')]);
+
+        expect(store.getMembers('a').map(({ email }) => email)).toEqual(['new@example.com']);
+        expect(store.getMembers('b').map(({ email }) => email)).toEqual(['b@example.com']);
+    });
+
+    it('keeps internal and external invitations isolated by share', () => {
+        const store = useInvitationsStore.getState();
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+
+        store.setInvitations('a', [invitation('a@example.com')]);
+        store.setExternalInvitations('a', [externalInvitation('external-a@example.com')]);
+        store.setInvitations('b', [invitation('b@example.com')]);
+        store.setExternalInvitations('b', [externalInvitation('external-b@example.com')]);
+
+        store.updateInvitationsPermissions('a', [invitation('updated-a@example.com')]);
+        store.removeExternalInvitations('a', []);
+        expect(store.getInvitations('a').map(({ inviteeEmail }) => inviteeEmail)).toEqual(['updated-a@example.com']);
+        expect(store.getExternalInvitations('a')).toEqual([]);
+        expect(store.getInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual(['b@example.com']);
+        expect(store.getExternalInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+            'external-b@example.com',
+        ]);
+
+        store.addMultipleInvitations(
+            'a',
+            [invitation('added-a@example.com')],
+            [externalInvitation('added-external-a@example.com')]
+        );
+        store.removeInvitations('b', []);
+        store.updateExternalInvitations('b', [externalInvitation('updated-external-b@example.com')]);
+        expect(store.getInvitations('a').map(({ inviteeEmail }) => inviteeEmail)).toEqual(['added-a@example.com']);
+        expect(store.getExternalInvitations('a').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+            'added-external-a@example.com',
+        ]);
+        expect(store.getInvitations('b')).toEqual([]);
+        expect(store.getExternalInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+            'updated-external-b@example.com',
+        ]);
+    });
+});
