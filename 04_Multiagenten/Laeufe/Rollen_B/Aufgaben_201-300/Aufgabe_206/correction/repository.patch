 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const crypto = require('crypto');
+	const postingLockClients = new Map();
+
+	function postingLockIds(key) {
+		const hash = crypto.createHash('sha256').update(key).digest();
+		return [hash.readInt32BE(0), hash.readInt32BE(4)];
+	}
+
+	module.acquirePostingLock = async function (key, token) {
+		const client = await module.pool.connect();
+		try {
+			const ids = postingLockIds(key);
+			const result = await client.query('SELECT pg_try_advisory_lock($1, $2) AS acquired', ids);
+			if (!result.rows[0].acquired) {
+				client.release();
+				return false;
+			}
+			postingLockClients.set(token, { client, ids });
+			return true;
+		} catch (err) {
+			client.release();
+			throw err;
+		}
+	};
+
+	module.releasePostingLock = async function (key, token) {
+		const lock = postingLockClients.get(token);
+		if (!lock) {
+			return;
+		}
+		postingLockClients.delete(token);
+		try {
+			await lock.client.query('SELECT pg_advisory_unlock($1, $2)', lock.ids);
+		} finally {
+			lock.client.release();
+		}
+	};
 
 	module.flushdb = async function () {
 		await module.pool.query(`DROP SCHEMA "public" CASCADE`);
