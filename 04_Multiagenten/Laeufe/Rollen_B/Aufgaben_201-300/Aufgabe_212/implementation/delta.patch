diff --git a/detector/wordpress_test.go b/detector/wordpress_test.go
index 47ddca1..ff6995e 100644
--- a/detector/wordpress_test.go
+++ b/detector/wordpress_test.go
@@ -6,10 +6,84 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosEnterpriseAndBasic(t *testing.T) {
+	const enriched = `{"611":{"vulnerabilities":[{"id":"42","title":"Example","description":"Detailed summary","poc":"https://example.org/poc","introduced_in":"6.0","cvss":{"score":8.1,"vector":"CVSS:3.1/AV:N","severity":"HIGH"},"created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","fixed_in":"6.1.2","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/first","https://example.org/second"]}}]}}`
+	const basic = `{"611":{"vulnerabilities":[{"id":"42","title":"Example","description":null,"poc":null,"introduced_in":null,"cvss":null,"created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","fixed_in":null,"references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/first","https://example.org/second"]}}]}}`
+	const absent = `{"611":{"vulnerabilities":[{"id":"42","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/first","https://example.org/second"]}}]}}`
+	for _, tc := range []struct {
+		name, body, summary, fixedIn string
+		score                        float64
+		optional                     map[string]string
+	}{
+		{"enterprise", enriched, "Detailed summary", "6.1.2", 8.1, map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.0"}},
+		{"basic", basic, "", "", 0, map[string]string{}},
+		{"absent", absent, "", "", 0, map[string]string{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			vinfos, err := convertToVinfos("core", tc.body, "611")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d records, want 1", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2024-1234" || v.VulnType != "XSS" || len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].FixedIn != tc.fixedIn {
+				t.Fatalf("unexpected vulnerability: %+v", v)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("got %d WPScan contents", len(contents))
+			}
+			c := contents[0]
+			if c.Type != models.WpScan || c.CveID != v.CveID || c.Summary != tc.summary || c.Cvss3Score != tc.score || !reflect.DeepEqual(c.Optional, tc.optional) {
+				t.Fatalf("unexpected content: %+v", c)
+			}
+			if tc.score != 0 && (c.Cvss3Vector != "CVSS:3.1/AV:N" || c.Cvss3Severity != "HIGH") {
+				t.Fatalf("unexpected CVSS: %+v", c)
+			}
+			if tc.score == 0 && (c.Cvss3Vector != "" || c.Cvss3Severity != "") {
+				t.Fatalf("unexpected CVSS: %+v", c)
+			}
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 2, 5, 6, 0, time.UTC)
+			if !c.Published.Equal(published) || c.Published.Location() != time.UTC || !c.LastModified.Equal(modified) || c.LastModified.Location() != time.UTC {
+				t.Fatalf("unexpected timestamps: %s, %s", c.Published, c.LastModified)
+			}
+			if len(c.References) != 2 || c.References[0].Link != "https://example.org/first" || c.References[1].Link != "https://example.org/second" {
+				t.Fatalf("unexpected references: %+v", c.References)
+			}
+		})
+	}
+}
+
+func TestConvertToVinfosSelectsVersion(t *testing.T) {
+	body := `{"611":{"vulnerabilities":[{"id":"1","references":{"cve":["2024-1"]}}]},"612":{"vulnerabilities":[{"id":"2","references":{"cve":["2024-2"]}}]}}`
+	vinfos, err := convertToVinfos("core", body, "611")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(vinfos) != 1 || vinfos[0].CveID != "CVE-2024-1" {
+		t.Fatalf("unexpected records: %+v", vinfos)
+	}
+}
+
+func TestDetectWordPressWithoutFix(t *testing.T) {
+	vinfos, err := convertToVinfos("example", `{"example":{"vulnerabilities":[{"id":"1","references":{"cve":["2024-1"]},"fixed_in":null}]}}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := detect(models.WpPackage{Name: "example", Version: "1.0"}, vinfos)
+	if len(got) != 1 || got[0].CveID != "CVE-2024-1" {
+		t.Fatalf("unexpected records: %+v", got)
+	}
+}
