+def test_submit_stages_cached_product(monkeypatch) -> None:
+    from scripts import affiliate_server
+
+    product = {"source_records": ["amazon:B06XYHVXVJ"]}
+    batch = MagicMock()
+    monkeypatch.setattr(affiliate_server.web, "amazon_api", MagicMock(), raising=False)
+    monkeypatch.setattr(affiliate_server.web, "input", lambda **kwargs: {"stage_import": "true"})
+    monkeypatch.setattr(affiliate_server.cache.memcache_cache, "get", lambda key: product)
+    monkeypatch.setattr(affiliate_server.config, "infobase", {"db_parameters": True}, raising=False)
+    monkeypatch.setattr(affiliate_server, "clean_amazon_metadata_for_load", lambda value: value)
+    monkeypatch.setattr(affiliate_server, "get_current_amazon_batch", lambda: batch)
+
+    assert json.loads(Submit().GET("B06XYHVXVJ"))["status"] == "success"
+    batch.add_items.assert_called_once_with([
+        {"ia_id": "amazon:B06XYHVXVJ", "status": "staged", "data": product}
+    ])
+
+
+def test_submit_upgrades_queued_priority(monkeypatch) -> None:
+    from scripts import affiliate_server
+
+    amazon_queue = queue.PriorityQueue()
+    amazon_queue.put(PrioritizedIdentifier("B06XYHVXVJ", stage_import=False))
+    amazon_queue.put(PrioritizedIdentifier("B06OTHER01"))
+    monkeypatch.setattr(affiliate_server.web, "amazon_queue", amazon_queue, raising=False)
+    monkeypatch.setattr(affiliate_server.web, "amazon_api", MagicMock(), raising=False)
+    monkeypatch.setattr(affiliate_server.web, "input", lambda **kwargs: {"high_priority": "true", "stage_import": "true"})
+    monkeypatch.setattr(affiliate_server.cache.memcache_cache, "get", lambda key: None)
+    monkeypatch.setattr(affiliate_server.time, "sleep", lambda seconds: None)
+
+    Submit().GET("B06XYHVXVJ")
+
+    assert amazon_queue.qsize() == 2
+    first = amazon_queue.get_nowait()
+    assert first.identifier == "B06XYHVXVJ"
+    assert first.priority == Priority.HIGH
+    assert first.stage_import is True
+
