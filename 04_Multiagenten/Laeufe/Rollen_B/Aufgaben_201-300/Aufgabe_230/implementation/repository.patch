+def test_prioritized_identifier_equality_order_and_json() -> None:
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    first = PrioritizedIdentifier("B06XYHVXVJ", False, Priority.LOW, timestamp)
+    duplicate = PrioritizedIdentifier("B06XYHVXVJ", True, Priority.HIGH)
+    other = PrioritizedIdentifier("0747532699", priority=Priority.HIGH)
+
+    assert len({first, duplicate, other}) == 2
+    assert first == duplicate
+    assert other < first
+    assert json.loads(json.dumps(first.to_dict())) == {
+        "identifier": "B06XYHVXVJ",
+        "stage_import": False,
+        "priority": "LOW",
+        "timestamp": "2024-01-02T03:04:05",
+    }
+    assert PrioritizedISBN(isbn="0747532699").identifier == "0747532699"
+    assert PrioritizedISBN("0747532699", Priority.HIGH, timestamp).priority == Priority.HIGH
+
+
+def test_process_amazon_batch_stages_only_requested_items(monkeypatch) -> None:
+    from scripts import affiliate_server
+
+    products = [
+        {"isbn_10": ["0747532699"], "isbn_13": ["9780747532699"], "source_records": ["amazon:0747532699"]},
+        {"source_records": ["amazon:B06XYHVXVJ"]},
+    ]
+    api = MagicMock()
+    api.get_products.return_value = products
+    cache = MagicMock()
+    batch = MagicMock()
+    monkeypatch.setattr(affiliate_server.web, "amazon_api", api, raising=False)
+    monkeypatch.setattr(affiliate_server.cache, "memcache_cache", cache)
+    monkeypatch.setattr(affiliate_server.config, "infobase", {"db_parameters": True}, raising=False)
+    monkeypatch.setattr(affiliate_server, "get_current_amazon_batch", lambda: batch)
+    monkeypatch.setattr(affiliate_server, "clean_amazon_metadata_for_load", lambda product: product)
+
+    process_amazon_batch([
+        PrioritizedIdentifier("0747532699", stage_import=False),
+        PrioritizedIdentifier("B06XYHVXVJ", stage_import=True),
+    ])
+
+    api.get_products.assert_called_once_with(["0747532699", "B06XYHVXVJ"], serialize=True)
+    assert cache.set.call_count == 2
+    batch.add_items.assert_called_once_with([
+        {"ia_id": "amazon:B06XYHVXVJ", "status": "staged", "data": products[1]}
+    ])
+
