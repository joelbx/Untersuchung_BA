@@ -0,0 +1,26 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("imageFilesForAlbum", func() {
+	It("joins every image from the album's directories in order", func() {
+		dirs := dirMap{
+			"a": {ImageFiles: []string{"front.jpg", "back.png"}},
+			"b": {ImageFiles: []string{"large.jpg"}},
+			"c": {ImageFiles: []string{"unrelated.jpg"}},
+		}
+		want := strings.Join([]string{
+			filepath.Join("a", "front.jpg"),
+			filepath.Join("a", "back.png"),
+			filepath.Join("b", "large.jpg"),
+		}, string(filepath.ListSeparator))
+		Expect(imageFilesForAlbum([]string{"a", "b"}, dirs)).To(Equal(want))
+		Expect(imageFilesForAlbum([]string{"b"}, dirMap{})).To(BeEmpty())
+	})
+})
