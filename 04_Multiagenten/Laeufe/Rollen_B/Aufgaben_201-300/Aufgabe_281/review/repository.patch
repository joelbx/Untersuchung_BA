@@ -261,4 +262,31 @@ module.exports = function (module) {
 			throw err;
 		}
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const updates = prepareIncrements(data, helpers.fieldToString);
+		if (!updates.size) {
+			return;
+		}
+		const collection = module.client.collection('objects');
+		const results = await Promise.allSettled(Array.from(updates, async ([key, increment]) => {
+			try {
+				await collection.updateOne({ _key: key }, { $inc: increment }, { upsert: true });
+			} catch (err) {
+				if (!err || !err.message || !err.message.startsWith('E11000 duplicate key error')) {
+					throw err;
+				}
+				// A concurrent upsert may have created the object first.
+				await collection.updateOne({ _key: key }, { $inc: increment });
+			}
+		}));
+		const changed = Array.from(updates.keys()).filter((key, index) => results[index].status === 'fulfilled');
+		if (changed.length) {
+			cache.del(changed);
+		}
+		const failure = results.find(result => result.status === 'rejected');
+		if (failure) {
+			throw failure.reason;
+		}
+	};
 };
diff --git a/src/database/redis/hash.js b/src/database/redis/hash.js
index 1afdccd..ac0a3a5 100644
--- a/src/database/redis/hash.js
+++ b/src/database/redis/hash.js
@@ -2,6 +2,25 @@
 
 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const prepareIncrements = require('../increment');
+	const bulkIncrementScript = `
+for i = 1, #ARGV, 2 do
+  local current = redis.call('HGET', KEYS[1], ARGV[i])
+  if current then
+    if not string.match(current, '^%-?%d+$') then
+      return redis.error_reply('hash field is not an integer')
+    end
+    local number = tonumber(current)
+    if not number or math.abs(number) > 9007199254740991 or
+       math.abs(number + tonumber(ARGV[i + 1])) > 9007199254740991 then
+      return redis.error_reply('hash increment exceeds safe integer range')
+    end
+  end
+end
+for i = 1, #ARGV, 2 do
+  redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+end
+return 1`;
 
 	const cache = require('../cache').create('redis');
 
@@ -219,4 +238,33 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const updates = prepareIncrements(data);
+		if (!updates.size) {
+			return;
+		}
+		const batch = module.client.batch();
+		for (const [key, increments] of updates) {
+			const args = Object.entries(increments).flatMap(([field, value]) => [field, String(value)]);
+			batch.eval(bulkIncrementScript, 1, key, ...args);
+		}
+		const results = await batch.exec();
+		const changed = [];
+		let failure;
+		Array.from(updates.keys()).forEach((key, index) => {
+			const [err] = results[index];
+			if (err) {
+				failure = failure || err;
+			} else {
+				changed.push(key);
+			}
+		});
+		if (changed.length) {
+			cache.del(changed);
+		}
+		if (failure) {
+			throw failure;
+		}
+	};
 };
