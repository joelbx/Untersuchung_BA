diff --git a/src/database/increment.js b/src/database/increment.js
new file mode 100644
index 0000000..9f13a3c
--- /dev/null
+++ b/src/database/increment.js
@@ -0,0 +1,34 @@
+'use strict';
+
+// Validate the entire request before issuing any writes. Merge repeated keys so that
+// every object's fields are updated together, even if it occurs twice in the input.
+module.exports = function (data, normalizeField = String) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const updates = new Map();
+	for (const item of data) {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must be [key, increments] tuples');
+		}
+		const increments = updates.get(item[0]) || Object.create(null);
+		for (const [field, value] of Object.entries(item[1])) {
+			const name = normalizeField(field);
+			if (!name || name === '__proto__' || name === 'constructor' || name === 'prototype' || /[.$]/.test(name) ||
+				!Number.isSafeInteger(value)) {
+				throw new TypeError('Invalid bulk increment field or value');
+			}
+			const total = (increments[name] || 0) + value;
+			if (!Number.isSafeInteger(total)) {
+				throw new TypeError('Bulk increment exceeds safe integer range');
+			}
+			increments[name] = total;
+		}
+		if (Object.keys(increments).length) {
+			updates.set(item[0], increments);
+		}
+	}
+	return updates;
+};
