+	describe('incrObjectFieldByBulk()', () => {
+		it('increments several fields on existing and missing objects', async () => {
+			await db.setObject('bulkIncrementExisting', { age: 4, label: 'kept' });
+			await db.getObject('bulkIncrementExisting');
+			const result = await db.incrObjectFieldByBulk([
+				['bulkIncrementExisting', { age: 5, newField: 10 }],
+				['bulkIncrementMissing', { age: -2, newField: 3 }],
+			]);
+			assert.strictEqual(result, undefined);
+			const existing = await db.getObject('bulkIncrementExisting');
+			const missing = await db.getObject('bulkIncrementMissing');
+			assert.strictEqual(Number(existing.age), 9);
+			assert.strictEqual(Number(existing.newField), 10);
+			assert.strictEqual(existing.label, 'kept');
+			assert.strictEqual(Number(missing.age), -2);
+			assert.strictEqual(Number(missing.newField), 3);
+		});
+
+		it('keeps a failed key unchanged and increments other keys', async () => {
+			await db.setObject('bulkIncrementBad', { age: 2, label: 'text' });
+			await db.getObject('bulkIncrementBad');
+			await assert.rejects(db.incrObjectFieldByBulk([
+				['bulkIncrementBad', { age: 3, label: 1 }],
+				['bulkIncrementGood', { age: 7 }],
+			]));
+			const bad = await db.getObject('bulkIncrementBad');
+			assert.strictEqual(Number(bad.age), 2);
+			assert.strictEqual(bad.label, 'text');
+			assert.strictEqual(Number((await db.getObject('bulkIncrementGood')).age), 7);
+		});
+
+		it('rejects invalid input before writing', async () => {
+			const invalidInputs = [
+				{ key: { age: 1 } }, [['bulkIncrementInvalid', { age: 1.5 }]],
+				[['bulkIncrementInvalid', { age: Number.MAX_SAFE_INTEGER + 1 }]],
+				[['bulkIncrementInvalid', { age: 1, 'bad.field': 2 }]],
+				[['bulkIncrementInvalid', { age: 1, constructor: 2 }]],
+			];
+			await Promise.all(invalidInputs.map(input => assert.rejects(db.incrObjectFieldByBulk(input))));
+			assert.strictEqual(await db.getObject('bulkIncrementInvalid'), null);
+			assert.strictEqual(await db.incrObjectFieldByBulk([]), undefined);
+		});
+
+		it('combines repeated keys into one atomic update', async () => {
+			await db.incrObjectFieldByBulk([
+				['bulkIncrementRepeat', { age: 2 }],
+				['bulkIncrementRepeat', { age: -3, other: 4 }],
+			]);
+			const result = await db.getObject('bulkIncrementRepeat');
+			assert.strictEqual(Number(result.age), -1);
+			assert.strictEqual(Number(result.other), 4);
+		});
