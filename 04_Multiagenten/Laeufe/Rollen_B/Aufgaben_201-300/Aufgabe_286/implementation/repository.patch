diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..8889d97
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,57 @@
+package release
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release.
+func Is(version string) bool {
+	v, err := semver.ParseTolerant(version)
+	return err == nil && len(v.Pre) == 0
+}
+
+// Check looks up the latest release and compares it with version. A failed
+// check is logged and returned so callers can continue without update status.
+func Check(ctx context.Context, version string) (Info, error) {
+	info, err := check(ctx, version, github.NewClient(nil))
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func check(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	latestRelease, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+
+	latest, err := semver.ParseTolerant(latestRelease.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latestRelease.GetTagName()
+	info.LatestVersionURL = latestRelease.GetHTMLURL()
+	info.UpdateAvailable = current.LT(latest)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..8c7f98e
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,94 @@
+package release
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3-dev", false},
+		{"1.2.3-snapshot", false},
+		{"1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"1.2.3-beta.1", false},
+		{"1.2.3", true},
+		{"v1.2.3", true},
+		{"1.2.3+build.4", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			if got := Is(tt.version); got != tt.want {
+				t.Errorf("Is(%q) = %t, want %t", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+			t.Errorf("unexpected path: %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"tag_name":"v1.2.4","html_url":"https://example.com/release"}`))
+	}))
+	defer server.Close()
+
+	client := github.NewClient(server.Client())
+	baseURL, err := url.Parse(server.URL + "/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.BaseURL = baseURL
+
+	for _, tt := range []struct {
+		version string
+		update  bool
+	}{
+		{"v1.2.3", true},
+		{"v1.2.4", false},
+		{"v1.2.5", false},
+	} {
+		t.Run(tt.version, func(t *testing.T) {
+			info, err := check(context.Background(), tt.version, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if info.CurrentVersion != tt.version || info.LatestVersion != "v1.2.4" || info.LatestVersionURL != "https://example.com/release" || info.UpdateAvailable != tt.update {
+				t.Errorf("unexpected release info: %+v", info)
+			}
+		})
+	}
+}
+
+func TestCheckLogsFailure(t *testing.T) {
+	core, logs := observer.New(zapcore.WarnLevel)
+	undo := zap.ReplaceGlobals(zap.New(core))
+	defer undo()
+
+	info, err := Check(context.Background(), "invalid")
+	if err == nil {
+		t.Fatal("expected invalid version error")
+	}
+	if info.CurrentVersion != "invalid" {
+		t.Errorf("current version = %q", info.CurrentVersion)
+	}
+	entries := logs.All()
+	if len(entries) != 1 || entries[0].Message != "checking for updates" || entries[0].ContextMap()["error"] == nil {
+		t.Errorf("expected warning with error, got %+v", entries)
+	}
+}
