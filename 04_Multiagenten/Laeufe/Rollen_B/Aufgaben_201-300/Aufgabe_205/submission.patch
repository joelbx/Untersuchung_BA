diff --git a/src/socket.io/admin/settings.js b/src/socket.io/admin/settings.js
index 89208af..98ba7e9 100644
--- a/src/socket.io/admin/settings.js
+++ b/src/socket.io/admin/settings.js
@@ -2,14 +2,48 @@
 
 const meta = require('../../meta');
 const events = require('../../events');
+const { tokens } = require('../../api/utils');
 
 const Settings = module.exports;
 
 Settings.get = async function (socket, data) {
-	return await meta.settings.get(data.hash);
+	const values = await meta.settings.get(data.hash);
+	if (data.hash === 'core.api') {
+		values.tokens = await tokens.list();
+		values.tokens.forEach((item) => {
+			item.timestampISO = new Date(item.timestamp).toISOString();
+		});
+	}
+	return values;
 };
 
 Settings.set = async function (socket, data) {
+	if (data.hash === 'core.api' && Array.isArray(data.values.tokens)) {
+		const previous = await tokens.list();
+		const incoming = data.values.tokens;
+		const retained = new Set(incoming.filter(item => item.token).map(item => item.token));
+		for (const item of previous) {
+			if (!retained.has(item.token)) {
+				// Each deletion also removes the matching legacy settings entry.
+				/* eslint-disable-next-line no-await-in-loop */
+				await tokens.delete(item.token);
+			}
+		}
+		for (const item of incoming) {
+			if (!item.token) {
+				/* eslint-disable-next-line no-await-in-loop */
+				item.token = await tokens.generate({ uid: item.uid, description: item.description });
+			} else {
+				const old = previous.find(entry => entry.token === item.token);
+				if (old && old.description !== item.description) {
+					/* eslint-disable-next-line no-await-in-loop */
+					await tokens.update(item.token, { description: item.description });
+				}
+			}
+		}
+		// Clear the old settings list once its tokens have been imported.
+		data.values.tokens = [];
+	}
 	await meta.settings.set(data.hash, data.values);
 	const eventData = data.values;
 	eventData.type = 'settings-change';
