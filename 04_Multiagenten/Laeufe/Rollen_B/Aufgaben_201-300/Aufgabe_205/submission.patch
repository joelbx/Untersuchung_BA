+const meta = require('../meta');
+const { generateUUID } = require('../utils');
 
 const utils = module.exports;
+const tokens = {};
+utils.tokens = tokens;
 
-// internal token management utilities only
+// Internal token management utilities only.
+tokens.list = async () => {
+	await tokens.importLegacy();
+	const ids = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await tokens.get(ids);
+};
+
+// Move tokens created by older releases into the indexed store without changing their IDs.
+tokens.importLegacy = async () => {
+	const { tokens: legacy = [] } = await meta.settings.get('core.api');
+	await Promise.all(legacy.map(async (item) => {
+		if (!item || !item.token || await db.getObject(`token:${item.token}`)) {
+			return;
+		}
+		const uid = Number(item.uid);
+		const oldTimestamp = Number(item.timestamp);
+		const timestamp = Number.isFinite(oldTimestamp) && oldTimestamp > 0 ? oldTimestamp : Date.now();
+		if (!Number.isInteger(uid) || uid < 0) {
+			return;
+		}
+		await db.setObject(`token:${item.token}`, {
+			uid, description: item.description || '', timestamp,
+		});
+		await Promise.all([
+			db.sortedSetAdd('tokens:createtime', timestamp, item.token),
+			db.sortedSetAdd('tokens:uid', uid, item.token),
+		]);
+	}));
+};
+
+tokens.generate = async ({ uid, description } = {}) => {
+	const numericUid = Number(uid);
+	if (uid === null || uid === undefined || !Number.isInteger(numericUid) || numericUid < 0) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.exists(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, {
+		uid: numericUid,
+		description: description === undefined || description === null ? '' : description,
+		timestamp,
+	});
+	await Promise.all([
+		db.sortedSetAdd('tokens:createtime', timestamp, token),
+		db.sortedSetAdd('tokens:uid', numericUid, token),
+	]);
+	return token;
+};
+
+tokens.get = async (ids) => {
+	if (ids === null || ids === undefined || (!Array.isArray(ids) && typeof ids !== 'string')) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const single = !Array.isArray(ids);
+	const tokenIds = single ? [ids] : ids;
+	if (!tokenIds.length) {
+		return [];
+	}
+	if (tokenIds.some(id => typeof id !== 'string')) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	let [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenIds.map(id => `token:${id}`)),
+		tokens.getLastSeen(tokenIds),
+	]);
+	if (objects.some(obj => !obj)) {
+		await tokens.importLegacy();
+		objects = await db.getObjects(tokenIds.map(id => `token:${id}`));
+	}
+	const result = objects.map((obj, index) => (obj ? {
+		...obj,
+		token: tokenIds[index],
+		uid: Number(obj.uid),
+		timestamp: Number(obj.timestamp),
+		lastSeen: lastSeen[index],
+	} : null));
+	return single ? result[0] : result;
+};
+
+tokens.update = async (token, { description } = {}) => {
+	if (description === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!await tokens.get(token)) {
+		return null;
+	}
+	await db.setObjectField(`token:${token}`, 'description', description === null ? '' : description);
+	return await tokens.get(token);
+};
 
-utils.log = async (token) => {
+tokens.delete = async (token) => {
+	const settings = await meta.settings.get('core.api');
+	if (Array.isArray(settings.tokens) && settings.tokens.some(item => item.token === token)) {
+		settings.tokens = settings.tokens.filter(item => item.token !== token);
+		await meta.settings.set('core.api', settings);
+	}
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove('tokens:createtime', token),
+		db.sortedSetRemove('tokens:uid', token),
+		db.sortedSetRemove('tokens:lastSeen', token),
+	]);
+};
+
+tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+tokens.getLastSeen = async (ids) => {
+	if (!ids.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', ids);
+	return scores.map((score) => {
+		const numericScore = Number(score);
+		return score === null || score === undefined || !Number.isFinite(numericScore) ? null : numericScore;
+	});
+};
+
+// Keep existing callers working while they move to the token namespace.
+utils.log = tokens.log;
+utils.getLastSeen = tokens.getLastSeen;
