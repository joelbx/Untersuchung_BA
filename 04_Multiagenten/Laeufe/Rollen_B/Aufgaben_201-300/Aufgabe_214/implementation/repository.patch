diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..71567c1
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,123 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures the scanner running on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	for _, name := range c.ScanTechniques {
+		technique := NotSupportTechnique
+		for _, candidate := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(name, candidate.String()) {
+				technique = candidate
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, technique)
+	}
+	return scanTechniques
+}
+
+// Validate checks settings used by the external scanner.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath is required for external scanning"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath: %w", err))
+	} else if !info.Mode().IsRegular() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath must be an executable file: %s", c.ScannerBinPath))
+	}
+
+	techniques := (&c).GetScanTechniques()
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan: multiple scan techniques are not supported"))
+	}
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan: unsupported scan technique %q", c.ScanTechniques[i]))
+		} else if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan: %s requires privileges", technique))
+		}
+	}
+	if len(techniques) == 0 && !c.HasPrivileged {
+		// nmap defaults to a connect scan when run without privileges.
+		techniques = []ScanTechnique{TCPConnect}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 1 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort must be an integer in [1,65535]: %q", c.SourcePort))
+		}
+		if len(techniques) == 1 && techniques[0] == TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort is incompatible with TCP connect scanning"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		out, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan: cannot check scanner capabilities: %w", err))
+		} else if match := regexp.MustCompile(`(?:^|[, ])cap_net_raw(?:,[a-z_]+)*[=+]([eip]+)(?:\s|$)`).FindSubmatch(out); len(match) != 2 || !strings.Contains(string(match[1]), "e") || !strings.Contains(string(match[1]), "p") {
+			errs = append(errs, fmt.Errorf("portscan: scanner is missing or has malformed cap_net_raw capability data: %s", strings.TrimSpace(string(out))))
+		}
+	}
+	return errs
+}
