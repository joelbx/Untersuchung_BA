@@ -0,0 +1,90 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas}
+	for _, technique := range want {
+		conf := PortScanConf{ScanTechniques: []string{strings.ToUpper(technique.String())}}
+		got := conf.GetScanTechniques()
+		if len(got) != 1 || got[0] != technique {
+			t.Errorf("%s: got %v", technique, got)
+		}
+	}
+	for _, input := range [][]string{nil, {}} {
+		conf := PortScanConf{ScanTechniques: input}
+		if len(conf.GetScanTechniques()) != 0 {
+			t.Errorf("empty input: got %v", conf.GetScanTechniques())
+		}
+	}
+	conf := PortScanConf{ScanTechniques: []string{"invalid"}}
+	got := conf.GetScanTechniques()
+	if len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Errorf("unknown input: got %v", got)
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	checks := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"missing binary", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: exe, ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: exe, ScanTechniques: []string{"sT", "sS"}}, "multiple"},
+		{"unprivileged", PortScanConf{ScannerBinPath: exe, ScanTechniques: []string{"sS"}}, "requires privileges"},
+		{"connect source", PortScanConf{ScannerBinPath: exe, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "incompatible"},
+		{"zero source", PortScanConf{ScannerBinPath: exe, SourcePort: "0"}, "[1,65535]"},
+		{"large source", PortScanConf{ScannerBinPath: exe, SourcePort: "65536"}, "[1,65535]"},
+	}
+	for _, check := range checks {
+		t.Run(check.name, func(t *testing.T) {
+			found := false
+			for _, err := range check.conf.Validate() {
+				found = found || strings.Contains(err.Error(), check.want)
+			}
+			if !found {
+				t.Errorf("missing %q in %v", check.want, check.conf.Validate())
+			}
+		})
+	}
+	if errs := (PortScanConf{ScannerBinPath: exe, ScanTechniques: []string{"sT"}}).Validate(); len(errs) != 0 {
+		t.Errorf("valid connect scan: %v", errs)
+	}
+	if !(PortScanConf{}).IsZero() || (PortScanConf{HasPrivileged: true}).IsZero() || (PortScanConf{SourcePort: "1"}).IsZero() {
+		t.Error("IsZero ignored a configured field")
+	}
+}
+
+func TestPortScanTOMLLoader(t *testing.T) {
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	data := "[servers.example]\nhost = '127.0.0.1'\nuser = 'test'\n[servers.example.portscan]\nscannerBinPath = '/usr/bin/nmap'\nscanTechniques = ['sT']\n"
+	if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if conf := Conf.Servers["example"].PortScan; conf == nil || !conf.IsUseExternalScanner {
+		t.Errorf("external scanner not enabled: %+v", conf)
+	}
+	server := Conf.Servers["example"]
+	server.PortScan.ScanTechniques = []string{"unsupported"}
+	Conf.Servers["example"] = server
+	if errs := Conf.checkPortScan(); len(errs) == 0 || !strings.Contains(errs[0].Error(), "example") {
+		t.Errorf("server port scan settings were not validated: %v", errs)
+	}
+}
