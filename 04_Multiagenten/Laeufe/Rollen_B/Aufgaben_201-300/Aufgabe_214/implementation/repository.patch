diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..1492690
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,101 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+type nmapRun struct {
+	Hosts []struct {
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			ID       int    `xml:"portid,attr"`
+			State    struct {
+				Value string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func setScanTechniques(c config.PortScanConf) ([]string, error) {
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		return nil, fmt.Errorf("multiple scan techniques are not supported")
+	}
+	if len(techniques) == 0 {
+		if c.HasPrivileged {
+			return []string{"-sS"}, nil
+		}
+		return []string{"-sT"}, nil
+	}
+	if techniques[0] == config.NotSupportTechnique {
+		return nil, fmt.Errorf("unsupported scan technique %q", c.ScanTechniques[0])
+	}
+	return []string{"-" + techniques[0].String()}, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	c := *l.ServerInfo.PortScan
+	if errs := c.Validate(); len(errs) != 0 {
+		return nil, errs[0]
+	}
+	technique, err := setScanTechniques(c)
+	if err != nil {
+		return nil, err
+	}
+	var ips []string
+	for ip := range scanDestIPPorts {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	var open []string
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		var ports []string
+		for _, p := range scanDestIPPorts[ip] {
+			n, err := strconv.Atoi(p)
+			if err != nil || n < 1 || n > 65535 {
+				return nil, fmt.Errorf("invalid scan port %q for %s", p, ip)
+			}
+			ports = append(ports, p)
+		}
+		if len(ports) == 0 {
+			continue
+		}
+		options := append([]string{}, technique...)
+		options = append(options, "-n", "-Pn", "-oX", "-", "-p", strings.Join(ports, ","))
+		if c.SourcePort != "" {
+			options = append(options, "-g", c.SourcePort)
+		}
+		options = append(options, "--", ip)
+		output, err := osExec.Command(c.ScannerBinPath, options...).CombinedOutput()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan %s failed: %w: %s", ip, err, strings.TrimSpace(string(output)))
+		}
+		var result nmapRun
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("nmap scan %s returned invalid XML: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.Value == "open" {
+					open = append(open, ip+":"+strconv.Itoa(port.ID))
+				}
+			}
+		}
+	}
+	return open, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..98881af
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,50 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScanDispatch(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "scanner")
+	script := "#!/bin/sh\n" +
+		"printf '%s\\n' \"$*\" > " + filepath.Join(filepath.Dir(path), "args") + "\n" +
+		"printf '%s\\n' '<nmaprun><host><ports><port protocol=\"tcp\" portid=\"443\"><state state=\"open\"/></port><port protocol=\"tcp\" portid=\"80\"><state state=\"closed\"/></port></ports></host></nmaprun>'\n"
+	if err := os.WriteFile(path, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{
+		ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true,
+	}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"443", "80"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.1:443"}) {
+		t.Errorf("open ports: %v", got)
+	}
+	args, err := os.ReadFile(filepath.Join(filepath.Dir(path), "args"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, option := range []string{"-sT", "-oX -", "-p 443,80", "192.0.2.1"} {
+		if !strings.Contains(string(args), option) {
+			t.Errorf("missing %q from %q", option, args)
+		}
+	}
+}
+
+func TestSetScanTechniques(t *testing.T) {
+	if _, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{"unknown"}}); err == nil {
+		t.Fatal("unsupported technique accepted")
+	}
+	got, err := setScanTechniques(config.PortScanConf{ScanTechniques: []string{"SX"}})
+	if err != nil || !reflect.DeepEqual(got, []string{"-sX"}) {
+		t.Errorf("got %v, %v", got, err)
+	}
+}
