+func TestExternalPortScanCommandErrorIncludesStderr(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "scanner")
+	script := "#!/bin/sh\nprintf '%s\\n' 'scan failed on stderr' >&2\nexit 1\n"
+	if err := os.WriteFile(path, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{
+		ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true,
+	}}}
+	_, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"443"}})
+	if err == nil || !strings.Contains(err.Error(), "scan failed on stderr") {
+		t.Errorf("expected command stderr in error, got %v", err)
+	}
+}
