@@ -96,6 +96,32 @@ def import_item_db_staged(setup_item_db):
 
 
 class TestImportItem:
+    def test_find_staged_or_pending(self, setup_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        rows = [
+            {'batch_id': 1, 'ia_id': 'amazon:9781234567897', 'status': 'staged'},
+            {'batch_id': 1, 'ia_id': 'idb:123456789X', 'status': 'pending'},
+            {'batch_id': 1, 'ia_id': 'amazon:other', 'status': 'staged'},
+            {'batch_id': 1, 'ia_id': 'idb:9781234567897', 'status': 'failed'},
+            {'batch_id': 1, 'ia_id': 'other:9781234567897', 'status': 'pending'},
+        ]
+        setup_item_db.multiple_insert('import_item', rows)
+        try:
+            result = ImportItem.find_staged_or_pending(
+                ['9781234567897', '123456789X']
+            )
+            assert isinstance(result, web.db.SqliteResultSet)
+            assert {(row.ia_id, row.status) for row in result} == {
+                ('amazon:9781234567897', 'staged'),
+                ('idb:123456789X', 'pending'),
+            }
+            assert [row.ia_id for row in ImportItem.find_staged_or_pending(
+                ['9781234567897'], sources=['other']
+            )] == ['other:9781234567897']
+            assert list(ImportItem.find_staged_or_pending([])) == []
+        finally:
+            setup_item_db.query('DELETE FROM import_item')
+
