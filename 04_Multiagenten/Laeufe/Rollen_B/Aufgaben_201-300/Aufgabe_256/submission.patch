+    def test_play_name_is_derived_without_changing_input(self):
+        data = dict(hosts=['one', 'two'])
+        play = Play.load(data)
+        self.assertNotIn('name', data)
+        self.assertEqual(play.get_name(), 'one,two')
+        play.hosts = ['three']
+        self.assertEqual(play.get_name(), 'three')
+        play.name = 'explicit name'
+        self.assertEqual(play.get_name(), 'explicit name')
+        self.assertEqual(Play.load(dict(hosts='one')).get_name(), 'one')
+        self.assertEqual(Play.load(dict()).get_name(), '')
+
+    def test_invalid_hosts(self):
+        cases = (
+            (None, 'Hosts list cannot be empty. Please check your playbook'),
+            ('', 'Hosts list cannot be empty. Please check your playbook'),
+            ([], 'Hosts list cannot be empty. Please check your playbook'),
+            (['one', None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['one', {'test': 'bad'}], "Hosts list contains an invalid host value: '{'test': 'bad'}'"),
+            ({'test': 'bad'}, 'Hosts list must be a sequence or string. Please check your playbook.'),
+            (42, 'Hosts list must be a sequence or string. Please check your playbook.'),
+        )
+        for hosts, message in cases:
+            for name in (None, 'explicit name'):
+                with self.assertRaises(AnsibleParserError) as error:
+                    Play.load(dict(hosts=hosts, name=name))
+                self.assertIn(message, str(error.exception))
+
+    def test_hosts_sequence_accepts_binary_strings(self):
+        play = Play.load(dict(hosts=('one', b'two')))
+        self.assertEqual(play.get_name(), 'one,two')
+
