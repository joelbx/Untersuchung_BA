+@pytest.mark.parametrize('is_directory', [False, True])
+def test_extract_tar_entry_rejects_link_via_external_parent(tmp_path, is_directory):
+    root = tmp_path / 'collection'
+    root.mkdir()
+    outside = tmp_path / 'outside'
+    outside.mkdir()
+    (root / 'escape').symlink_to(outside, target_is_directory=True)
+    archive_path = tmp_path / 'artifact.tar'
+    filename = 'escape/new/dir' if is_directory else 'escape/new/file.txt'
+    with tarfile.open(str(archive_path), 'w') as archive:
+        member = tarfile.TarInfo(filename)
+        if is_directory:
+            member.type = tarfile.DIRTYPE
+            archive.addfile(member)
+        else:
+            member.size = 4
+            archive.addfile(member, BytesIO(b'data'))
+
+    with tarfile.open(str(archive_path), 'r') as archive:
+        with pytest.raises(AnsibleError, match='outside the collection directory'):
+            if is_directory:
+                collection._extract_tar_dir(archive, filename, to_bytes(str(root)))
+            else:
+                collection._extract_tar_file(archive, filename, to_bytes(str(root)), to_bytes(str(tmp_path)))
+    assert not (outside / 'new').exists()
+
