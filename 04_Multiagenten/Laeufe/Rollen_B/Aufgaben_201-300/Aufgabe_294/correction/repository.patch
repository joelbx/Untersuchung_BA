+def _is_child_path(path, root, link_location=None):
+    """Whether a path, or a link target relative to its link, resolves within root."""
+    if link_location is not None:
+        path = os.path.join(os.path.dirname(link_location), path)
+    root = os.path.realpath(root)
+    path = os.path.realpath(path)
+    separator = to_bytes(os.path.sep) if isinstance(root, bytes) else os.path.sep
+    return path == root or path.startswith(root.rstrip(separator) + separator)
 
 
