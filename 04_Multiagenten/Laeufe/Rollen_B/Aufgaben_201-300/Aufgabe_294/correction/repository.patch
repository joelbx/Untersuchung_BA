+def _tar_destination(filename, b_dest):
+    b_dest = os.path.abspath(b_dest)
+    b_filepath = os.path.abspath(os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict')))
+    if b_filepath == b_dest or not b_filepath.startswith(b_dest + to_bytes(os.path.sep)):
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % to_native(filename, errors='surrogate_or_strict'))
+    return b_filepath
+
+
+def _validate_tar_parent(b_parent_dir, b_dest, filename):
+    if not _is_child_path(b_parent_dir, b_dest):
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % to_native(filename, errors='surrogate_or_strict'))
+
+
+def _extract_tar_dir(tar, filename, b_dest):
+    b_dest_filepath = _tar_destination(filename, b_dest)
+    tar_member = tar.getmember(to_native(filename, errors='surrogate_or_strict'))
+    b_parent_dir = os.path.dirname(b_dest_filepath)
+    _validate_tar_parent(b_parent_dir, b_dest, filename)
+    if not os.path.exists(b_parent_dir):
+        os.makedirs(b_parent_dir, mode=0o0755)
+    _validate_tar_parent(b_parent_dir, b_dest, filename)
+    if tar_member.issym() and _is_child_path(to_bytes(tar_member.linkname, errors='surrogate_or_strict'),
+                                             b_dest, b_dest_filepath):
+        os.symlink(to_bytes(tar_member.linkname, errors='surrogate_or_strict'), b_dest_filepath)
+    elif tar_member.isdir() or tar_member.issym():
+        os.makedirs(b_dest_filepath, mode=0o0755)
+    else:
+        raise AnsibleError("Cannot extract tar entry '%s' as a directory" % to_native(filename))
 
 
