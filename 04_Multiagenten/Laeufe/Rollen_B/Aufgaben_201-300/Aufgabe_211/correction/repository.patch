@@ -294,3 +295,79 @@ describe('post uploads management', () => {
 		});
 	});
 });
+
+describe('upload cleanup on purge', () => {
+	let uid;
+	let cid;
+	const uploadDir = path.join(nconf.get('upload_path'), 'files');
+
+	before(async () => {
+		uid = await user.create({ username: 'upload cleanup user', password: 'abracadabra' });
+		({ cid } = await categories.create({ name: 'Upload cleanup category' }));
+	});
+
+	after(() => {
+		meta.config.preserveOrphanedUploads = 0;
+	});
+
+	async function createPostWithUpload(filename) {
+		const { postData } = await topics.post({
+			uid,
+			cid,
+			title: `Upload cleanup ${filename}`,
+			content: `[file](/assets/uploads/files/${filename})`,
+		});
+		return postData.pid;
+	}
+
+	it('deletes one or multiple valid paths and ignores paths outside uploads', async () => {
+		const names = ['cleanup-one.txt', 'cleanup-two.txt'];
+		const outsidePath = path.join(nconf.get('upload_path'), 'outside-upload-cleanup.txt');
+		names.forEach(name => fs.writeFileSync(path.join(uploadDir, name), 'test'));
+		fs.writeFileSync(outsidePath, 'keep');
+		await posts.uploads.deleteFromDisk(names[0]);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, names[0])), false);
+		await posts.uploads.deleteFromDisk([names[1], '../outside-upload-cleanup.txt', 1]);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, names[1])), false);
+		assert.strictEqual(fs.existsSync(outsidePath), true);
+		await assert.rejects(posts.uploads.deleteFromDisk(1));
+		fs.unlinkSync(outsidePath);
+	});
+
+	it('deletes files exclusive to a purged post', async () => {
+		const filename = 'cleanup-exclusive.txt';
+		fs.writeFileSync(path.join(uploadDir, filename), 'test');
+		const postPid = await createPostWithUpload(filename);
+		await posts.purge(postPid, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, filename)), false);
+	});
+
+	it('keeps files referenced by another post', async () => {
+		const filename = 'cleanup-shared.png';
+		const resized = 'cleanup-shared-resized.png';
+		fs.writeFileSync(path.join(uploadDir, filename), 'test');
+		fs.writeFileSync(path.join(uploadDir, resized), 'test');
+		const firstPid = await createPostWithUpload(resized);
+		const secondPid = await createPostWithUpload(resized);
+		await posts.purge(firstPid, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, filename)), true);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, resized)), true);
+		await posts.purge(secondPid, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, filename)), false);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, resized)), false);
+	});
+
+	it('keeps files when preservation is enabled', async () => {
+		const filename = 'cleanup-preserved.txt';
+		fs.writeFileSync(path.join(uploadDir, filename), 'test');
+		const postPid = await createPostWithUpload(filename);
+		meta.config.preserveOrphanedUploads = 1;
+		try {
+			await posts.purge(postPid, uid);
+			assert.strictEqual(fs.existsSync(path.join(uploadDir, filename)), true);
+		} finally {
+			meta.config.preserveOrphanedUploads = 0;
+			fs.unlinkSync(path.join(uploadDir, filename));
+		}
+	});
+});
