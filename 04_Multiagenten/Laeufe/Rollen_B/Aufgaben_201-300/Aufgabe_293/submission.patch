+func oci(ctx context.Context, _ *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	seed := base.WithExec([]string{"go", "run", "./build/internal/cmd/ocibundle/...", "-testdata-dir", testdataDir, "-bundles-dir", "/tmp/oci-bundles"})
+	if _, err := seed.Sync(ctx); err != nil {
+		return func() error { return err }
+	}
+
+	flipt = flipt.
+		WithDirectory("/tmp/oci-bundles", seed.Directory("/tmp/oci-bundles")).
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", "flipt://local/features:latest").
+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", "/tmp/oci-bundles").
+		WithEnvVariable("UNIQUE", uuid.New().String())
+
+	return suite(ctx, "readonly", base, flipt.WithExec(nil), conf)
+}
