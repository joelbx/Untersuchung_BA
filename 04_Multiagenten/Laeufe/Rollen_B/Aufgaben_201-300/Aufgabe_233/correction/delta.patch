+// fileOnlyFS exposes only the methods required by fs.FS and fs.File.
+type fileOnlyFS struct{ mapFS fstest.MapFS }
+
+func (f fileOnlyFS) Open(name string) (fs.File, error) {
+	file, err := f.mapFS.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	return struct{ fs.File }{file}, nil
+}
+
+type readDirOnlyFS struct{ fileOnlyFS }
+
+func (f readDirOnlyFS) ReadDir(name string) ([]fs.DirEntry, error) {
+	return fs.ReadDir(f.mapFS, name)
+}
