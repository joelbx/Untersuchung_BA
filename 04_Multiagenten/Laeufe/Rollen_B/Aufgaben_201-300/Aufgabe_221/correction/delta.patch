diff --git a/scripts/migrations/2026-10-21-bestbook.sql b/scripts/migrations/2026-10-21-bestbook.sql
new file mode 100644
index 0000000..d1c8e78
--- /dev/null
+++ b/scripts/migrations/2026-10-21-bestbook.sql
@@ -0,0 +1,22 @@
+-- Apply to an existing Open Library application database before deploying
+-- Best Book Awards code:
+-- psql -X -v ON_ERROR_STOP=1 -d openlibrary -f scripts/migrations/2026-10-21-bestbook.sql
+-- Safe to rerun after the table has been created by core/schema.sql.
+BEGIN;
+
+CREATE TABLE IF NOT EXISTS bestbook (
+    id serial primary key,
+    username text NOT NULL,
+    work_id integer NOT NULL,
+    topic text NOT NULL,
+    comment text NOT NULL DEFAULT '',
+    edition_id integer DEFAULT NULL,
+    updated timestamp without time zone default (current_timestamp at time zone 'utc'),
+    created timestamp without time zone default (current_timestamp at time zone 'utc'),
+    UNIQUE (username, work_id),
+    UNIQUE (username, topic)
+);
+CREATE INDEX IF NOT EXISTS bestbook_work_id_idx ON bestbook (work_id);
+CREATE INDEX IF NOT EXISTS bestbook_topic_idx ON bestbook (topic);
+
+COMMIT;
