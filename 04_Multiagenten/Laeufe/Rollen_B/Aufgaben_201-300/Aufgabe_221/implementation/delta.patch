+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = "json"
+
+    def POST(self, work_id):
+        def response(value):
+            return delegate.RawText(json.dumps(value), content_type='application/json')
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        i = web.input(op=None, topic=None, comment='', edition_key=None)
+        username = user.key.split('/')[2]
+        if i.op not in ('add', 'remove', 'update'):
+            return response({'errors': 'Invalid operation'})
+        try:
+            if i.op == 'remove':
+                rows = Bestbook.remove(username, work_id=work_id)
+                return response({'success': True, 'rows': rows})
+            if not i.topic:
+                return response({'errors': 'An award topic is required'})
+            edition_id = (
+                int(extract_numeric_id_from_olid(i.edition_key))
+                if i.edition_key else None
+            )
+            if i.op == 'update':
+                transaction = core_db.get_db().transaction()
+                try:
+                    Bestbook.remove(username, work_id=work_id)
+                    award = Bestbook.add(
+                        username, work_id, i.topic, i.comment, edition_id
+                    )
+                except Exception:
+                    transaction.rollback()
+                    raise
+                else:
+                    transaction.commit()
+            else:
+                award = Bestbook.add(
+                    username, work_id, i.topic, i.comment, edition_id
+                )
+            return response({'success': True, 'award': award})
+        except (Bestbook.AwardConditionsError, ValueError) as exc:
+            return response({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = '/awards/count'
+    encoding = 'json'
+
+    def GET(self):
+        i = web.input(work_id=None, username=None, topic=None)
+        try:
+            count = Bestbook.get_count(
+                work_id=i.work_id, username=i.username, topic=i.topic
+            )
+        except ValueError as exc:
+            value = {'errors': str(exc)}
+        else:
+            value = {'count': count}
+        return delegate.RawText(json.dumps(value), content_type='application/json')
+
