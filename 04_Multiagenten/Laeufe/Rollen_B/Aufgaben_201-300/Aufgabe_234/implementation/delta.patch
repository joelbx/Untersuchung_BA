@@ -34,3 +36,21 @@ var _ = Describe("isSchemaEmpty", func() {
 		Expect(isSchemaEmpty(db)).To(BeTrue())
 	})
 })
+
+var _ = Describe("sqliteDSN", func() {
+	It("applies the shared connection settings to custom paths", func() {
+		path := sqliteDSN("file:custom.db?_busy_timeout=15000&mode=rw")
+		_, rawQuery, found := strings.Cut(path, "?")
+		Expect(found).To(BeTrue())
+		query, err := url.ParseQuery(rawQuery)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(query.Get("mode")).To(Equal("rw"))
+		Expect(query.Get("cache")).To(Equal("shared"))
+		Expect(query.Get("_cache_size")).To(Equal("1000000000"))
+		Expect(query.Get("_busy_timeout")).To(Equal("5000"))
+		Expect(query.Get("_journal_mode")).To(Equal("WAL"))
+		Expect(query.Get("_synchronous")).To(Equal("NORMAL"))
+		Expect(query.Get("_foreign_keys")).To(Equal("on"))
+		Expect(query.Get("_txlock")).To(Equal("immediate"))
+	})
+})
