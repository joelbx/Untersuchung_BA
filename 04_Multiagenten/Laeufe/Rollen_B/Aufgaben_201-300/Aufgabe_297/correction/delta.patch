+func TestMapRedactionPreservesKeyTypes(t *testing.T) {
+	entry := &logrus.Entry{Data: logrus.Fields{
+		"values": map[interface{}]interface{}{
+			1:        "secret-token",
+			"1":      "plain",
+			"token":  "anything",
+			"nested": map[int]string{2: "secret-token"},
+		},
+	}}
+	hook := &Hook{RedactionList: []string{`^token$`, `secret-token`}}
+	assert.NoError(t, hook.Fire(entry))
+	values := entry.Data["values"].(map[interface{}]interface{})
+	assert.Len(t, values, 4)
+	assert.Equal(t, "[REDACTED]", values[1])
+	assert.Equal(t, "plain", values["1"])
+	assert.Equal(t, "[REDACTED]", values["token"])
+	assert.Equal(t, "[REDACTED]", values["nested"].(map[int]interface{})[2])
+}
