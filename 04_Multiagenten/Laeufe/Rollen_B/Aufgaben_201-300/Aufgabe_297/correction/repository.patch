+// redactValue keeps map keys intact while redacting their values recursively.
+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		redacted := reflect.MakeMapWithSize(reflect.MapOf(v.Type().Key(), reflect.TypeOf((*interface{})(nil)).Elem()), v.Len())
+		for _, key := range v.MapKeys() {
+			name := fmt.Sprint(key.Interface())
+			var replacement interface{}
+			if re.MatchString(name) {
+				replacement = "[REDACTED]"
+			} else {
+				replacement = redactValue(v.MapIndex(key).Interface(), re)
+			}
+			redacted.SetMapIndex(key, reflect.ValueOf(&replacement).Elem())
+		}
+		return redacted.Interface()
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
