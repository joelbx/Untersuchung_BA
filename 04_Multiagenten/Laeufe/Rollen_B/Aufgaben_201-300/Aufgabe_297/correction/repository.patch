+// validateIPAgainstList checks a connection address against configured CIDRs.
+// A Unix socket peer is represented by @ in the whitelist.
+func validateIPAgainstList(address, list string) bool {
+	if strings.TrimSpace(list) == "" {
+		return false
+	}
+	if address == "@" {
+		for _, entry := range strings.Split(list, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(address); err == nil {
+		address = host
+	}
+	ip := net.ParseIP(strings.Trim(address, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(list, ",") {
+		entry = strings.TrimSpace(entry)
+		if _, cidr, err := net.ParseCIDR(entry); err == nil && cidr.Contains(ip) {
+			return true
+		}
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		if entryIP := net.ParseIP(strings.Trim(entry, "[]")); entryIP != nil && entryIP.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	peer, ok := request.PeerAddressFrom(r.Context())
+	if !ok {
+		peer = r.RemoteAddr
+	}
+	if !validateIPAgainstList(peer, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" {
+		return nil
+	}
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for proxy login", countErr)
+			return nil
+		}
+		password := uuid.NewString()
+		user = &model.User{UserName: username, Name: strings.Title(username), NewPassword: password, Password: password, IsAdmin: count == 0}
+		if err = userRepo.Put(user); err != nil {
+			log.Error(r, "Creating proxy user", err)
+			return nil
+		}
+	} else if err != nil {
+		log.Error(r, "Finding proxy user", err)
+		return nil
+	}
+	if !strings.EqualFold(user.UserName, username) {
+		return nil
+	}
+	if err = userRepo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating proxy user login", err)
+		return nil
+	}
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating proxy token", err)
+		return nil
+	}
+	salt := uuid.NewString()[:6]
+	payload := map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token, "subsonicSalt": salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
