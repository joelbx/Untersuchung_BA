+func TestValidateIPAgainstList(t *testing.T) {
+	list := "bad CIDR, 192.0.2.0/24, 2001:db8::/32, @"
+	for _, address := range []string{"192.0.2.1:4533", "[2001:db8::1]:4533", "@"} {
