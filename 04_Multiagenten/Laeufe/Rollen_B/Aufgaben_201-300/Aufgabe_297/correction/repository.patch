+func TestHandleLoginFromHeaders(t *testing.T) {
+	previous := *conf.Server
+	defer func() { *conf.Server = previous }()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{}
+	r := httptest.NewRequest("GET", "/app/", nil)
+	r.RemoteAddr = "203.0.113.1:5555"
+	r.Header.Set("Remote-User", "alice")
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatal("untrusted peer received auth data")
+	}
+	r = r.WithContext(request.WithPeerAddress(r.Context(), "192.0.2.1:5555"))
+	payload := handleLoginFromHeaders(ds, r)
+	if payload == nil || payload["username"] != "alice" || payload["isAdmin"] != true {
+		t.Fatalf("unexpected first login payload: %v", payload)
+	}
+	for _, key := range []string{"id", "name", "token", "subsonicSalt", "subsonicToken"} {
+		if payload[key] == "" || payload[key] == nil {
+			t.Errorf("missing %s", key)
+		}
+	}
+	if _, err := auth.Validate(payload["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	user, err := ds.User(context.Background()).FindByUsername("alice")
+	if err != nil || !user.IsAdmin {
+		t.Fatalf("user was not created: %v", err)
+	}
+	if handleLoginFromHeaders(ds, r) == nil {
+		t.Fatal("existing user should authenticate")
+	}
