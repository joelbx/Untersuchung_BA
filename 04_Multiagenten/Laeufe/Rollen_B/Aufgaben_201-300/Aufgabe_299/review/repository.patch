+def test_filesystem_category(qtmodeltester, config_stub, quickmarks, bookmarks,
+                             web_history, info, tmp_path, monkeypatch):
+    """Filesystem rows follow category order and preserve their input form."""
+    directory = tmp_path / 'files'
+    directory.mkdir()
+    (directory / 'b.html').touch()
+    (directory / 'a.html').touch()
+    (directory / 'other.txt').touch()
+    (directory / 'a space.html').touch()
+    favorite = str(directory / 'missing.html')
+    config_stub.val.completion.favorite_paths = [favorite, '~/favorite.html']
+    config_stub.val.completion.open_categories = ['filesystem']
+    monkeypatch.setenv('HOME', str(tmp_path))
+
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    _check_completions(model, {
+        'Filesystem': [(favorite, None, None), ('~/favorite.html', None, None)],
+    })
+    assert model.data(model.index(0, 0)) == 'Filesystem'
+
+    model.set_pattern(str(directory) + '/')
+    _check_completions(model, {
+        'Filesystem': [(str(directory / name), None, None)
+                       for name in ('a space.html', 'a.html', 'b.html',
+                                    'other.txt')],
+    })
+
+    model.set_pattern('file://' + str(directory) + '/a.')
+    _check_completions(model, {
+        'Filesystem': [('file://' + str(directory / 'a.html'), None, None)],
+    })
+
+    model.set_pattern('file://' + str(directory) + '/a%20')
+    _check_completions(model, {
+        'Filesystem': [('file://' + str(directory) + '/a%20space.html',
+                        None, None)],
+    })
+
+    model.set_pattern('~/files/b')
+    _check_completions(model, {
+        'Filesystem': [('~/files/b.html', None, None)],
+    })
+
+    for invalid in ('files/a', 'https://example.org/', 'file://remote/tmp/',
+                    'file:////remote/tmp/',
+                    str(directory / 'absent')):
+        model.set_pattern(invalid)
+        _check_completions(model, {'Filesystem': []})
+
+    config_stub.val.completion.open_categories = ['quickmarks', 'filesystem']
+    model = urlmodel.url(info=info)
+    assert [model.data(model.index(i, 0)) for i in range(model.rowCount())] == [
+        'Quickmarks', 'Filesystem']
+
+    quickmarks.marks.clear()
+    model = urlmodel.url(info=info)
+    model.set_pattern(str(directory / 'absent'))
+    _check_completions(model, {'Filesystem': []})
+
+    config_stub.val.completion.open_categories = []
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    _check_completions(model, {})
+
+
