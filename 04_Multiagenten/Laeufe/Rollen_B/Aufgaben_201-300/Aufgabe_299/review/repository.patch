diff --git a/qutebrowser/completion/models/filepathcategory.py b/qutebrowser/completion/models/filepathcategory.py
new file mode 100644
index 0000000..508a8af
--- /dev/null
+++ b/qutebrowser/completion/models/filepathcategory.py
@@ -0,0 +1,83 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Completion category for local filesystem paths."""
+
+import os
+from urllib.parse import quote, unquote, urlsplit
+
+from PyQt5.QtCore import QAbstractListModel, QModelIndex, Qt, QObject
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractListModel):
+
+    """Suggest local files and directories for the open command."""
+
+    def __init__(self, name: str, parent: QObject = None):
+        super().__init__(parent)
+        self.name = name
+        self.columns_to_filter = [0]
+        self.delete_func = None
+        self._paths = []
+
+    def set_pattern(self, val: str) -> None:
+        """Replace suggestions with paths matching the typed prefix."""
+        if not val:
+            paths = list(config.val.completion.favorite_paths)
+        else:
+            paths = self._matches(val)
+        self.beginResetModel()
+        self._paths = paths
+        self.endResetModel()
+
+    def _matches(self, val):
+        if val.startswith('file:'):
+            try:
+                parsed = urlsplit(val)
+            except ValueError:
+                return []
+            if (parsed.scheme != 'file' or parsed.netloc or
+                    parsed.query or parsed.fragment or
+                    not val.startswith('file:///') or
+                    parsed.path.startswith('//')):
+                return []
+            path = unquote(parsed.path)
+            display = lambda match: 'file://' + quote(match, safe='/')
+        elif val.startswith('~'):
+            path = os.path.expanduser(val)
+            if path.startswith('~'):
+                return []
+            # Keep the spelling the user entered, including ~user.
+            display = lambda match: val + match[len(path):]
+        elif os.path.isabs(val):
+            path = val
+            display = lambda match: match
+        else:
+            return []
+
+        directory, prefix = os.path.split(path)
+        if path.endswith(os.sep):
+            directory, prefix = path, ''
+        elif val.startswith('~'):
+            # A bare ~ or ~user refers to the home directory itself.
+            if os.sep not in val:
+                directory, prefix = path, ''
+                display = lambda match: val + os.sep + os.path.basename(match)
+
+        try:
+            with os.scandir(directory) as entries:
+                matches = sorted(entry.path for entry in entries
+                                 if entry.name.startswith(prefix))
+        except (OSError, ValueError):
+            return []
+        return [display(match) for match in matches]
+
+    def data(self, index, role=Qt.DisplayRole):
+        if (role != Qt.DisplayRole or not index.isValid() or
+                index.column() != 0 or not 0 <= index.row() < len(self._paths)):
+            return None
+        return self._paths[index.row()]
+
+    def rowCount(self, parent=QModelIndex()):
+        return 0 if parent.isValid() else len(self._paths)
