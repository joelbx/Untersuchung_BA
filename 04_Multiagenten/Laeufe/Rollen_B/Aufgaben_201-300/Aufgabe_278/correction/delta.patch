diff --git a/applications/mail/src/app/logic/elements/elementsSlice.test.ts b/applications/mail/src/app/logic/elements/elementsSlice.test.ts
new file mode 100644
index 0000000..d5a073f
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsSlice.test.ts
@@ -0,0 +1,39 @@
+import elementsReducer, { newState } from './elementsSlice';
+import { backendActionFinished, backendActionStarted, load } from './elementsActions';
+import { QueryParams, QueryResults } from './elementsTypes';
+
+describe('elements requests during backend actions', () => {
+    const queryParams = { page: 0, params: newState().params } as QueryParams;
+    const result = { Total: 1, Elements: [{ ID: 'old' }], Stale: 0 } as QueryResults;
+
+    it('discards a fetch that finishes while an action is active', () => {
+        let state = elementsReducer(newState(), load.pending('request', queryParams));
+        state = elementsReducer(state, backendActionStarted());
+        state = elementsReducer(state, load.fulfilled(result, 'request', queryParams));
+
+        expect(state.pendingRequest).toBe(false);
+        expect(state.invalidated).toBe(true);
+        expect(state.pages).toEqual([]);
+        expect(state.elements).toEqual({});
+
+        state = elementsReducer(state, backendActionFinished());
+        expect(state.pendingActions).toBe(0);
+        expect(state.invalidated).toBe(true);
+    });
+
+    it('discards a fetch that finishes after the action ends, then accepts a fresh fetch', () => {
+        let state = elementsReducer(newState(), load.pending('old-request', queryParams));
+        state = elementsReducer(state, backendActionStarted());
+        state = elementsReducer(state, backendActionFinished());
+        state = elementsReducer(state, load.fulfilled(result, 'old-request', queryParams));
+
+        expect(state.invalidated).toBe(true);
+        expect(state.pages).toEqual([]);
+
+        state = elementsReducer(state, load.pending('fresh-request', queryParams));
+        state = elementsReducer(state, load.fulfilled(result, 'fresh-request', queryParams));
+        expect(state.invalidated).toBe(false);
+        expect(state.pages).toEqual([0]);
+        expect(state.elements.old).toEqual(result.Elements[0]);
+    });
+});
