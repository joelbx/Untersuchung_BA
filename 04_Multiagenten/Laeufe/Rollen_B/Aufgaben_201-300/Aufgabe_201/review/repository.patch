+++ b/internal/ext/common.go
@@ -1,5 +1,7 @@
 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,106 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+// SegmentEmbed accepts either a segment key or a keys/operator mapping.
+type SegmentEmbed struct{ IsSegment }
+
+func (s *SegmentEmbed) Values() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("segment is required")
+	}
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		if v != "" {
+			return []string{string(v)}, "OR_SEGMENT_OPERATOR", nil
+		}
+	case Segments:
+		if len(v.Keys) > 0 {
+			for _, key := range v.Keys {
+				if key == "" {
+					return nil, "", fmt.Errorf("segment keys must not be empty")
+				}
+			}
+			if len(v.Keys) == 1 {
+				return v.Keys, "OR_SEGMENT_OPERATOR", nil
+			}
+			if v.SegmentOperator == "AND_SEGMENT_OPERATOR" || v.SegmentOperator == "OR_SEGMENT_OPERATOR" {
+				return v.Keys, v.SegmentOperator, nil
+			}
+		}
+	}
+	return nil, "", fmt.Errorf("segment must be a nonempty key or a keys/operator object")
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	_, operator, err := s.Values()
+	if err != nil {
+		return nil, err
+	}
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		return string(v), nil
+	case Segments:
+		v.SegmentOperator = operator
+		return v, nil
+	}
+	return nil, fmt.Errorf("unsupported segment type %T", s.IsSegment)
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		s.IsSegment = SegmentKey(v)
+	case map[interface{}]interface{}:
+		if len(v) != 2 {
+			return fmt.Errorf("segment object requires keys and operator")
+		}
+		if _, ok := v["keys"]; !ok {
+			return fmt.Errorf("segment object requires keys")
+		}
+		if _, ok := v["operator"]; !ok {
+			return fmt.Errorf("segment object requires operator")
+		}
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return err
+		}
+		s.IsSegment = segments
+	case map[string]interface{}:
+		if len(v) != 2 || v["keys"] == nil || v["operator"] == nil {
+			return fmt.Errorf("segment object requires keys and operator")
+		}
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return err
+		}
+		s.IsSegment = segments
+	default:
+		return fmt.Errorf("unsupported segment format %T", raw)
+	}
+	_, _, err := s.Values()
+	return err
 }
 
 type Distribution struct {
