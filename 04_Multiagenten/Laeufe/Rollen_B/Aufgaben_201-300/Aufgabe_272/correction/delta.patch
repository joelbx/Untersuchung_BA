@@ -11,6 +11,7 @@ import os
 from ansible.module_utils.urls import (Request, open_url, urllib_request, HAS_SSLCONTEXT, cookiejar, RequestWithMethod,
                                        UnixHTTPHandler, UnixHTTPSConnection, httplib)
 from ansible.module_utils.urls import SSLValidationHandler, HTTPSClientAuthHandler, RedirectHandlerFactory
+from ansible.module_utils import urls
 
 import pytest
 from units.compat.mock import call
@@ -474,3 +475,38 @@ def test_Request_ciphers_reach_https_handler(urlopen_mock, install_opener_mock,
     else:
         handler = next(h for h in handlers if hasattr(h, '_context') and isinstance(h, urllib_request.HTTPSHandler))
     assert any(c['name'] == 'ECDHE-RSA-AES128-SHA256' for c in handler._context.get_ciphers())
+
+
+@pytest.mark.parametrize('client_cert,unix_socket', [('/tmp/client.pem', None), (None, '/tmp/ansible.sock')])
+def test_pyopenssl_ciphers_reach_client_auth_connection(urlopen_mock, install_opener_mock, mocker, client_cert, unix_socket):
+    mocker.patch.object(urls, 'HAS_SSLCONTEXT', False)
+    mocker.patch.object(urls, 'HAS_URLLIB3_PYOPENSSLCONTEXT', True)
+    mocker.patch.object(urls, 'PyOpenSSLContext', create=True)
+    mocker.patch.object(urls, 'get_ca_certs', return_value=(None, bytearray(), []))
+    context = mocker.Mock()
+    mocker.patch.object(urls, 'make_context', return_value=context)
+    build_opener = mocker.patch.object(urls.urllib_request, 'build_opener')
+
+    Request().open('GET', 'https://ansible.com/', ciphers=['ECDHE-RSA-AES128-SHA256'],
+                   client_cert=client_cert, unix_socket=unix_socket)
+
+    def fallback_connection_init(connection, host, **kwargs):
+        connection.host = host
+        connection.cert_file = kwargs.get('cert_file')
+        connection.key_file = kwargs.get('key_file')
+        connection._tunnel_host = None
+
+    mocker.patch.object(urls.httplib.HTTPSConnection, '__init__', autospec=True,
+                        side_effect=fallback_connection_init)
+    handler = next(h for h in build_opener.call_args[0] if isinstance(h, HTTPSClientAuthHandler))
+    connection = handler._build_https_connection('ansible.com')
+    if unix_socket:
+        assert isinstance(connection, UnixHTTPSConnection)
+        mocker.patch.object(urls.UnixHTTPConnection, 'connect')
+        connection.sock = mocker.sentinel.socket
+        connection.connect()
+        context.wrap_socket.assert_called_once_with(mocker.sentinel.socket, server_hostname='ansible.com')
+    else:
+        assert isinstance(connection, urls.CustomHTTPSConnection)
+        assert connection.context is context
+        context.load_cert_chain.assert_called_once_with(client_cert, None)
