+def test_Request_ciphers_reach_https_handler(urlopen_mock, install_opener_mock, mocker, url, unix_socket):
+    build_opener = mocker.patch('ansible.module_utils.urls.urllib_request.build_opener')
+    mocker.patch('ansible.module_utils.urls.get_ca_certs', return_value=(None, bytearray(), []))
+    Request().open('GET', url, ciphers='ECDHE-RSA-AES128-SHA256', unix_socket=unix_socket)
+    handlers = build_opener.call_args[0]
+    if unix_socket:
+        handler = next(h for h in handlers if isinstance(h, HTTPSClientAuthHandler))
+    else:
+        handler = next(h for h in handlers if hasattr(h, '_context') and isinstance(h, urllib_request.HTTPSHandler))
+    assert any(c['name'] == 'ECDHE-RSA-AES128-SHA256' for c in handler._context.get_ciphers())
+
+
