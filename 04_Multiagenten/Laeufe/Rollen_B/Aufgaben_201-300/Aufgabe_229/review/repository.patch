+const nconf = require('nconf');
 
 const db = require('../database');
 const image = require('../image');
@@ -62,6 +64,43 @@ module.exports = function (Groups) {
 	};
 
 	Groups.removeCover = async function (data) {
+		const urls = await db.getObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url']);
+		const relativePath = nconf.get('relative_path') || '';
+		const prefix = `${relativePath}/assets/uploads/files/`;
+		const folder = path.join(nconf.get('upload_path'), 'files');
+		await Promise.all(Object.values(urls).map(async (url) => {
+			if (typeof url === 'string' && url.startsWith('/assets/uploads/files/')) {
+				url = relativePath + url;
+			}
+			if (typeof url !== 'string' || !url.startsWith(prefix)) {
+				return;
+			}
+			const name = url.slice(prefix.length);
+			if (!name || name === '.' || name === '..' || path.basename(name) !== name || name.includes('\\')) {
+				return;
+			}
+			let names;
+			try {
+				names = await fs.promises.readdir(folder);
+			} catch (err) {
+				if (err.code === 'ENOENT') {
+					return;
+				}
+				throw err;
+			}
+			const stem = path.parse(name).name;
+			const variants = names.filter(filename => path.parse(filename).name === stem &&
+				/\.(?:png|jpeg|jpg|bmp)$/i.test(filename));
+			await Promise.all(variants.map(async (filename) => {
+				try {
+					await fs.promises.unlink(path.join(folder, filename));
+				} catch (err) {
+					if (err.code !== 'ENOENT') {
+						throw err;
+					}
+				}
+			}));
+		}));
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
 	};
 };
