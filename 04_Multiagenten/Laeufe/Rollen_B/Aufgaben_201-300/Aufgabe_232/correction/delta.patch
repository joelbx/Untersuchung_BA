+func TestParseAmazonRelease(t *testing.T) {
+	for _, tt := range []struct{ input, want string }{
+		{"Amazon Linux 2", "2"},
+		{"Amazon Linux 2 (Karoo)", "2 (Karoo)"},
+		{"Amazon Linux release 2 (Karoo)", "2 (Karoo)"},
+		{"Amazon Linux AMI release 2018.03", "2018.03"},
+		{"Amazon Linux", "unknown"},
+	} {
+		if got := parseAmazonRelease(tt.input); got != tt.want {
+			t.Errorf("parseAmazonRelease(%q) = %q, want %q", tt.input, got, tt.want)
+		}
+	}
+}
