+package report
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestScanSummaryWarningOrder(t *testing.T) {
+	r := models.ScanResult{ServerName: "server", Family: "ubuntu", Release: "14.10", Warnings: []string{"first EOL warning", "second EOL warning"}}
+	got := formatScanSummary(r)
+	first := strings.Index(got, "Warning: first EOL warning (server: server)")
+	second := strings.Index(got, "Warning: second EOL warning (server: server)")
+	if first < 0 || second <= first || strings.Contains(got, "Warning for server:") {
+		t.Fatalf("warning lines missing or out of order: %q", got)
+	}
+}
+
+func TestSummaryWarningsIdentifyTargets(t *testing.T) {
+	results := []models.ScanResult{
+		{ServerName: "first", Warnings: []string{"standard support ended"}},
+		{ServerName: "second", Warnings: []string{"extended support ended"}},
+	}
+	for _, summary := range []struct {
+		name   string
+		format func(...models.ScanResult) string
+	}{
+		{"scan", formatScanSummary},
+		{"one line", formatOneLineSummary},
+	} {
+		t.Run(summary.name, func(t *testing.T) {
+			got := summary.format(results...)
+			for _, want := range []string{
+				"Warning: standard support ended (server: first)",
+				"Warning: extended support ended (server: second)",
+			} {
+				if !strings.Contains(got, want) {
+					t.Errorf("summary missing %q: %q", want, got)
+				}
+			}
+		})
+	}
+}
