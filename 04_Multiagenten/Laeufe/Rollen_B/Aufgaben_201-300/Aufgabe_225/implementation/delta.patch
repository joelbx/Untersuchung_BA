new file mode 100644
index 0000000..d4c2d3e
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,54 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestKEVEntries(t *testing.T) {
+	added := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	xdbAdded := added.AddDate(0, 0, 1)
+	dueDate := time.Date(2024, 9, 1, 0, 0, 0, 0, time.UTC)
+	placeholder := time.Time{}
+	entries := kevEntries(kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{
+			VendorProject: "CISA vendor", Product: "CISA product", VulnerabilityName: "CISA name",
+			ShortDescription: "CISA description", RequiredAction: "CISA action",
+			KnownRansomwareCampaignUse: "Known", DateAdded: added, DueDate: placeholder, Notes: "CISA note",
+		}},
+		VulnCheck: []kevulnmodels.VulnCheck{{
+			VendorProject: "VC vendor", Product: "VC product", Name: "VC name",
+			Description: "VC description", RequiredAction: "VC action",
+			KnownRansomwareCampaignUse: "Unknown", DateAdded: added, DueDate: &dueDate,
+			VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{
+				XDBID: "XDB-1", XDBURL: "https://example.org/xdb", DateAdded: xdbAdded,
+				ExploitType: "poc", CloneSSHURL: "git@example.org:xdb.git",
+			}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{
+				URL: "https://example.org/report", DateAdded: xdbAdded,
+			}},
+		}},
+	})
+	if len(entries) != 2 {
+		t.Fatalf("got %d entries, want 2", len(entries))
+	}
+	if cisa := entries[0]; cisa.Type != models.CISAKEVType || cisa.VendorProject != "CISA vendor" || cisa.Product != "CISA product" || cisa.VulnerabilityName != "CISA name" || cisa.ShortDescription != "CISA description" || cisa.RequiredAction != "CISA action" || cisa.KnownRansomwareCampaignUse != "Known" || !cisa.DateAdded.Equal(added) || cisa.DueDate != nil || cisa.CISA == nil || cisa.CISA.Note != "CISA note" || cisa.VulnCheck != nil {
+		t.Errorf("incorrect CISA entry: %+v", cisa)
+	}
+	vc := entries[1]
+	if vc.Type != models.VulnCheckKEVType || vc.VendorProject != "VC vendor" || vc.Product != "VC product" || vc.VulnerabilityName != "VC name" || vc.ShortDescription != "VC description" || vc.RequiredAction != "VC action" || vc.KnownRansomwareCampaignUse != "Unknown" || !vc.DateAdded.Equal(added) || vc.DueDate == nil || !vc.DueDate.Equal(dueDate) || vc.CISA != nil || vc.VulnCheck == nil {
+		t.Fatalf("incorrect VulnCheck entry: %+v", vc)
+	}
+	if xdb := vc.VulnCheck.XDB; len(xdb) != 1 || xdb[0].XDBID != "XDB-1" || xdb[0].XDBURL != "https://example.org/xdb" || !xdb[0].DateAdded.Equal(xdbAdded) || xdb[0].ExploitType != "poc" || xdb[0].CloneSSHURL != "git@example.org:xdb.git" {
+		t.Errorf("incorrect XDB details: %+v", xdb)
+	}
+	if reports := vc.VulnCheck.ReportedExploitation; len(reports) != 1 || reports[0].URL != "https://example.org/report" || !reports[0].DateAdded.Equal(xdbAdded) {
+		t.Errorf("incorrect exploitation reports: %+v", reports)
+	}
+}
