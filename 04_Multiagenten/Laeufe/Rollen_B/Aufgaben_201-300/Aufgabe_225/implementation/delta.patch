+// kevEntries maps the two catalog formats to the public vulnerability model.
+func kevEntries(response kevulndb.Response) []models.KEV {
+	var entries []models.KEV
+	for _, cisa := range response.CISA {
+		entries = append(entries, models.KEV{
+			Type: models.CISAKEVType, VendorProject: cisa.VendorProject,
+			Product: cisa.Product, VulnerabilityName: cisa.VulnerabilityName,
+			ShortDescription: cisa.ShortDescription, RequiredAction: cisa.RequiredAction,
+			KnownRansomwareCampaignUse: cisa.KnownRansomwareCampaignUse,
+			DateAdded:                  cisa.DateAdded, DueDate: validKEVDueDate(&cisa.DueDate),
+			CISA: &models.CISAKEV{Note: cisa.Notes},
+		})
+	}
+	for _, vc := range response.VulnCheck {
+		details := &models.VulnCheckKEV{}
+		for _, xdb := range vc.VulnCheckXDB {
+			details.XDB = append(details.XDB, models.VulnCheckXDB{
+				XDBID: xdb.XDBID, XDBURL: xdb.XDBURL, DateAdded: xdb.DateAdded,
+				ExploitType: xdb.ExploitType, CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, report := range vc.VulnCheckReportedExploitation {
+			details.ReportedExploitation = append(details.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL: report.URL, DateAdded: report.DateAdded,
+			})
+		}
+		entries = append(entries, models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: vc.VendorProject,
+			Product: vc.Product, VulnerabilityName: vc.Name,
+			ShortDescription: vc.Description, RequiredAction: vc.RequiredAction,
+			KnownRansomwareCampaignUse: vc.KnownRansomwareCampaignUse,
+			DateAdded:                  vc.DateAdded, DueDate: validKEVDueDate(vc.DueDate),
+			VulnCheck: details,
+		})
+	}
+	return entries
+}
+
+func validKEVDueDate(dueDate *time.Time) *time.Time {
+	if dueDate == nil || dueDate.IsZero() || dueDate.Year() <= 1 {
+		return nil
+	}
+	return dueDate
+}
+
 type kevulnResponse struct {
 	request kevulnRequest
 	json    string
