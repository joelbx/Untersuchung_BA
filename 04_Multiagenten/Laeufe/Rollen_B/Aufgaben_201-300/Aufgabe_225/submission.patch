-// AlertDict has target cve JPCERT, USCERT and CISA alert data
+// KEVType identifies the source of a known exploited vulnerability.
+type KEVType string
+
+const (
+	CISAKEVType      KEVType = "cisa"
+	VulnCheckKEVType KEVType = "vulncheck"
+)
+
+// KEV is a known exploited vulnerability from a KEV catalog.
+type KEV struct {
+	Type                       KEVType       `json:"type"`
+	VendorProject              string        `json:"vendorProject"`
+	Product                    string        `json:"product"`
+	VulnerabilityName          string        `json:"vulnerabilityName"`
+	ShortDescription           string        `json:"shortDescription"`
+	RequiredAction             string        `json:"requiredAction"`
+	KnownRansomwareCampaignUse string        `json:"knownRansomwareCampaignUse"`
+	DateAdded                  time.Time     `json:"dateAdded"`
+	DueDate                    *time.Time    `json:"dueDate,omitempty"`
+	CISA                       *CISAKEV      `json:"cisa,omitempty"`
+	VulnCheck                  *VulnCheckKEV `json:"vulncheck,omitempty"`
+}
+
+// CISAKEV contains details specific to CISA's catalog.
+type CISAKEV struct {
+	Note string `json:"note"`
+}
+
+// VulnCheckKEV contains details specific to VulnCheck's catalog.
+type VulnCheckKEV struct {
+	XDB                  []VulnCheckXDB                  `json:"xdb,omitempty"`
+	ReportedExploitation []VulnCheckReportedExploitation `json:"reportedExploitation,omitempty"`
+}
+
+// VulnCheckXDB describes an exploit in VulnCheck's database.
+type VulnCheckXDB struct {
+	XDBID       string    `json:"xdbID"`
+	XDBURL      string    `json:"xdbURL"`
+	DateAdded   time.Time `json:"dateAdded"`
+	ExploitType string    `json:"exploitType"`
+	CloneSSHURL string    `json:"cloneSSHURL"`
+}
+
+// VulnCheckReportedExploitation describes a report of exploitation.
+type VulnCheckReportedExploitation struct {
+	URL       string    `json:"url"`
+	DateAdded time.Time `json:"dateAdded"`
+}
+
+// AlertDict has target cve JPCERT, USCERT and legacy CISA alert data.
 type AlertDict struct {
 	CISA   []Alert `json:"cisa"`
 	JPCERT []Alert `json:"jpcert"`
 	USCERT []Alert `json:"uscert"`
 }
 
+// FormatAlertSource lists the KEV catalogs and CERT alerts for a vulnerability.
+func (v VulnInfo) FormatAlertSource() string {
+	var sources []string
+	cisa := len(v.AlertDict.CISA) > 0
+	vulncheck := false
+	for _, kev := range v.KEVs {
+		switch kev.Type {
+		case CISAKEVType:
+			cisa = true
+		case VulnCheckKEVType:
+			vulncheck = true
+		}
+	}
+	if cisa {
+		sources = append(sources, "CISA")
+	}
+	if vulncheck {
+		sources = append(sources, "VulnCheck")
+	}
+	if len(v.AlertDict.USCERT) > 0 || len(v.AlertDict.JPCERT) > 0 {
+		sources = append(sources, "CERT")
+	}
+	return strings.Join(sources, "/")
+}
+
 // IsEmpty checks if the content of AlertDict is empty
 func (a AlertDict) IsEmpty() bool {
 	return len(a.CISA) == 0 && len(a.JPCERT) == 0 && len(a.USCERT) == 0
