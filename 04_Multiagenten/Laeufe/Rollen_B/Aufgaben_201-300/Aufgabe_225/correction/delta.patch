@@ -967,6 +967,31 @@ type AlertDict struct {
 	USCERT []Alert `json:"uscert"`
 }
 
+// FormatAlertSource lists the KEV catalogs and CERT alerts for a vulnerability.
+func (v VulnInfo) FormatAlertSource() string {
+	var sources []string
+	cisa := len(v.AlertDict.CISA) > 0
+	vulncheck := false
+	for _, kev := range v.KEVs {
+		switch kev.Type {
+		case CISAKEVType:
+			cisa = true
+		case VulnCheckKEVType:
+			vulncheck = true
+		}
+	}
+	if cisa {
+		sources = append(sources, "CISA")
+	}
+	if vulncheck {
+		sources = append(sources, "VulnCheck")
+	}
+	if len(v.AlertDict.USCERT) > 0 || len(v.AlertDict.JPCERT) > 0 {
+		sources = append(sources, "CERT")
+	}
+	return strings.Join(sources, "/")
+}
+
 // IsEmpty checks if the content of AlertDict is empty
 func (a AlertDict) IsEmpty() bool {
 	return len(a.CISA) == 0 && len(a.JPCERT) == 0 && len(a.USCERT) == 0
