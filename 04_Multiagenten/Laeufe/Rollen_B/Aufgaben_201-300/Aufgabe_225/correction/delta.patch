+func TestKEVAndLegacyAlertSummary(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"new-cisa": {KEVs: []KEV{{Type: CISAKEVType, VulnerabilityName: "CISA entry"}}},
+		"new-vc":   {KEVs: []KEV{{Type: VulnCheckKEVType, VulnerabilityName: "VulnCheck entry"}}},
+		"legacy":   {AlertDict: AlertDict{CISA: []Alert{{Title: "Old alert"}}}},
+		"both":     {KEVs: []KEV{{Type: CISAKEVType}}, AlertDict: AlertDict{CISA: []Alert{{Title: "Old alert"}}}},
+	}}
+	if got := r.FormatAlertSummary(); got != "cisa: 3, uscert: 0, jpcert: 0 alerts" {
+		t.Errorf("alert summary = %q", got)
+	}
+	if got := r.FormatKEVCveSummary(); got != "3 KEVs" {
+		t.Errorf("KEV summary = %q", got)
+	}
+	if got := r.ScannedCves["new-cisa"].FormatAlertSource(); got != "CISA" {
+		t.Errorf("CISA source = %q", got)
+	}
+	if got := r.ScannedCves["new-vc"].FormatAlertSource(); got != "VulnCheck" {
+		t.Errorf("VulnCheck source = %q", got)
+	}
+	if got := r.ScannedCves["legacy"].FormatAlertSource(); got != "CISA" {
+		t.Errorf("legacy source = %q", got)
+	}
+}
