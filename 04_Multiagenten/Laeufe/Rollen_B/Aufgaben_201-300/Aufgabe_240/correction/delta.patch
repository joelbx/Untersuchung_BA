@@ -38,6 +38,23 @@ class DriveFirmwareTest(ModuleTestCase):
             with self.assertRaisesRegex(AnsibleFailJson, 'inaccessible'):
                 self.firmware.upgrade_list()
 
+    def test_inaccessible_drive_flags_fail_by_default(self):
+        compatibility = [dict(filename='a.dlp', targetVersion='NEW', driveRefList=['one'])]
+        for flag in (dict(offline=True), dict(available=False)):
+            drive = dict(status='optimal', firmwareVersion='OLD', **flag)
+            with mock.patch.object(self.firmware, 'request', side_effect=[(200, compatibility), (200, drive)]):
+                with self.assertRaisesRegex(AnsibleFailJson, 'inaccessible'):
+                    self.firmware.upgrade_list()
+
+    def test_inaccessible_drive_flags_can_be_ignored(self):
+        compatibility = [dict(filename='a.dlp', targetVersion='NEW', driveRefList=['one'])]
+        self.firmware.ignore_inaccessible_drives = True
+        for flag in (dict(offline=True), dict(available=False)):
+            self.firmware.upgrades = None
+            drive = dict(status='optimal', firmwareVersion='OLD', **flag)
+            with mock.patch.object(self.firmware, 'request', side_effect=[(200, compatibility), (200, drive)]):
+                self.assertEqual(self.firmware.upgrade_list(), [])
+
     def test_wait_only_considers_targeted_drives(self):
