+// fieldsMapFromJSON converts JSON without passing through the SDK's generic
+// encoder, which turns empty strings and collections into NULL values.
+func fieldsMapFromJSON(data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var value interface{}
+	if err := decoder.Decode(&value); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if decoder.Decode(new(interface{})) != io.EOF {
+		return nil, trace.BadParameter("trailing data in event fields")
+	}
+	object, ok := value.(map[string]interface{})
+	if !ok {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	return jsonObjectToAttributes(object), nil
+}
+
+func jsonObjectToAttributes(object map[string]interface{}) map[string]*dynamodb.AttributeValue {
+	out := make(map[string]*dynamodb.AttributeValue, len(object))
+	for key, value := range object {
+		out[key] = jsonValueToAttribute(value)
+	}
+	return out
+}
+
+func jsonValueToAttribute(value interface{}) *dynamodb.AttributeValue {
+	switch v := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(v)}
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(v))}
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(v)}
+	case map[string]interface{}:
+		return &dynamodb.AttributeValue{M: jsonObjectToAttributes(v)}
+	case []interface{}:
+		list := make([]*dynamodb.AttributeValue, len(v))
+		for i, child := range v {
+			list[i] = jsonValueToAttribute(child)
+		}
+		return &dynamodb.AttributeValue{L: list}
+	default:
+		panic("unexpected JSON value")
+	}
+}
+
+func attributeToJSONValue(value *dynamodb.AttributeValue) (interface{}, error) {
+	if value == nil {
+		return nil, trace.BadParameter("nil event field attribute")
+	}
+	switch {
+	case value.NULL != nil && *value.NULL:
+		return nil, nil
+	case value.S != nil:
+		return *value.S, nil
+	case value.N != nil:
+		if !json.Valid([]byte(*value.N)) {
+			return nil, trace.BadParameter("invalid event field number")
+		}
+		return json.Number(*value.N), nil
+	case value.BOOL != nil:
+		return *value.BOOL, nil
+	case value.M != nil:
+		out := make(map[string]interface{}, len(value.M))
+		for key, child := range value.M {
+			converted, err := attributeToJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out[key] = converted
+		}
+		return out, nil
+	case value.L != nil:
+		out := make([]interface{}, len(value.L))
+		for i, child := range value.L {
+			converted, err := attributeToJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out[i] = converted
+		}
+		return out, nil
+	default:
+		return nil, trace.BadParameter("unsupported event field attribute")
+	}
+}
+
+func fieldsMapJSON(fields map[string]*dynamodb.AttributeValue) ([]byte, error) {
+	value, err := attributeToJSONValue(&dynamodb.AttributeValue{M: fields})
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	data, err := json.Marshal(value)
+	return data, trace.Wrap(err)
+}
+
+func eventJSON(e *event) ([]byte, error) {
+	if e.FieldsMap != nil {
+		return fieldsMapJSON(e.FieldsMap)
+	}
+	return []byte(e.Fields), nil
+}
+
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if e.FieldsMap != nil {
+		item["FieldsMap"] = &dynamodb.AttributeValue{M: e.FieldsMap}
+	}
+	return item, nil
+}
+
+func unmarshalEvent(item map[string]*dynamodb.AttributeValue, e *event) error {
+	*e = event{}
+	if err := dynamodbattribute.UnmarshalMap(item, e); err != nil {
+		return trace.Wrap(err)
+	}
+	if field, ok := item["FieldsMap"]; ok {
+		if field.M == nil {
+			return trace.BadParameter("event FieldsMap is not a map")
+		}
+		e.FieldsMap = field.M
+	}
+	return nil
+}
+
+func sameEventJSON(original []byte, fields map[string]*dynamodb.AttributeValue) error {
+	converted, err := fieldsMapJSON(fields)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	decode := func(data []byte) (interface{}, error) {
+		decoder := json.NewDecoder(bytes.NewReader(data))
+		decoder.UseNumber()
+		var value interface{}
+		err := decoder.Decode(&value)
+		return value, err
+	}
+	before, err := decode(original)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	after, err := decode(converted)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		return trace.BadParameter("event fields changed during conversion")
+	}
+	return nil
+}
+
+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		if err := l.migrateFieldsMap(ctx); err != nil && ctx.Err() == nil {
+			l.WithError(err).Error("FieldsMap migration failed; retrying")
+		}
+		// Old nodes can still write events without FieldsMap. Repeat the scan
+		// throughout the rolling upgrade; a single completed scan is not final.
+		select {
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		cursorKey := backend.FlagKey("dynamoEvents", "fieldsMapMigrationCursor")
+		var startKey map[string]*dynamodb.AttributeValue
+		if cursor, err := l.backend.Get(ctx, cursorKey); err == nil {
+			if err := json.Unmarshal(cursor.Value, &startKey); err != nil {
+				return trace.WrapWithMessage(err, "decoding FieldsMap migration cursor")
+			}
+		} else if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+		l.Info("Starting FieldsMap event migration")
+		var migrated int
+		for {
+			out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName: aws.String(l.Tablename), ConsistentRead: aws.Bool(true),
+				ExclusiveStartKey: startKey, Limit: aws.Int64(DynamoBatchSize),
+				FilterExpression: aws.String("attribute_exists(#fields) AND attribute_not_exists(#fieldsMap)"),
+				ExpressionAttributeNames: map[string]*string{
+					"#fields": aws.String("Fields"), "#fieldsMap": aws.String("FieldsMap"),
+				},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			// Conditional updates cannot use BatchWriteItem. Process one scan
+			// page concurrently while keeping the cursor on this page until all
+			// updates succeed.
+			type result struct {
+				updated bool
+				err     error
+			}
+			results := make(chan result, len(out.Items))
+			for _, item := range out.Items {
+				go func(item map[string]*dynamodb.AttributeValue) {
+					updated, err := l.migrateFieldsMapItem(ctx, item)
+					results <- result{updated: updated, err: err}
+				}(item)
+			}
+			var pageErr error
+			for range out.Items {
+				result := <-results
+				if result.err != nil && pageErr == nil {
+					pageErr = result.err
+				}
+				if result.updated {
+					migrated++
+				}
+			}
+			if pageErr != nil {
+				return trace.Wrap(pageErr)
+			}
+			startKey = out.LastEvaluatedKey
+			if len(startKey) == 0 {
+				break
+			}
+			cursor, err := json.Marshal(startKey)
+			if err != nil {
+				return trace.Wrap(err)
+			}
+			if _, err := l.backend.Put(ctx, backend.Item{Key: cursorKey, Value: cursor}); err != nil {
+				return trace.Wrap(err)
+			}
+			l.Infof("Migrated %d events to FieldsMap", migrated)
+		}
+		if err := l.backend.Delete(ctx, cursorKey); err != nil && !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+		l.Infof("FieldsMap migration scan complete: %d events converted", migrated)
+		return nil
+	})
+}
+
+func (l *Log) migrateFieldsMapItem(ctx context.Context, item map[string]*dynamodb.AttributeValue) (bool, error) {
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return false, trace.BadParameter("legacy Fields is not a string for event %v/%v", item[keySessionID], item[keyEventIndex])
+	}
+	fields, err := fieldsMapFromJSON([]byte(*legacy.S))
+	if err == nil {
+		err = sameEventJSON([]byte(*legacy.S), fields)
+	}
+	if err != nil {
+		return false, trace.WrapWithMessage(err, "converting event %v/%v", item[keySessionID], item[keyEventIndex])
+	}
+	// Only add the map when the legacy payload still matches the scanned
+	// value. UpdateItem leaves concurrent changes to other attributes intact.
+	_, err = l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+		TableName: aws.String(l.Tablename),
+		Key: map[string]*dynamodb.AttributeValue{
+			keySessionID: item[keySessionID], keyEventIndex: item[keyEventIndex],
+		},
+		UpdateExpression:    aws.String("SET #fieldsMap = :fieldsMap"),
+		ConditionExpression: aws.String("#fields = :legacy AND attribute_not_exists(#fieldsMap)"),
+		ExpressionAttributeNames: map[string]*string{
+			"#fields": aws.String("Fields"), "#fieldsMap": aws.String("FieldsMap"),
+		},
+		ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+			":legacy":    legacy,
+			":fieldsMap": {M: fields},
+		},
+	})
+	if aerr, ok := err.(awserr.Error); ok && aerr.Code() == dynamodb.ErrCodeConditionalCheckFailedException {
+		return false, nil // A writer changed or removed this event since the scan.
+	}
+	if err != nil {
+		return false, trace.WrapWithMessage(err, "updating event %v/%v", item[keySessionID], item[keyEventIndex])
+	}
+	return true, nil
+}
