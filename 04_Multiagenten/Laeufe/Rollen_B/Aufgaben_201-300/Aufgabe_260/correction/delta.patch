diff --git a/server/events/sse.go b/server/events/sse.go
index c0bd739..a96c441 100644
--- a/server/events/sse.go
+++ b/server/events/sse.go
@@ -174,6 +174,11 @@ func (b *broker) subscribe(r *http.Request) client {
 		userAgent: r.UserAgent(),
 	}
 	c.clientUniqueId, _ = request.ClientUniqueIdFrom(r.Context())
+	// EventSource cannot send custom headers. Its URL carries the tab's ID so a
+	// cookie last written by another tab cannot change this subscription's ID.
+	if id := r.URL.Query().Get("clientUniqueId"); id != "" {
+		c.clientUniqueId = id
+	}
 	c.diode = newDiode(r.Context(), 1024, diodes.AlertFunc(func(missed int) {
 		log.Trace("Dropped SSE events", "client", c.String(), "missed", missed)
 	}))
