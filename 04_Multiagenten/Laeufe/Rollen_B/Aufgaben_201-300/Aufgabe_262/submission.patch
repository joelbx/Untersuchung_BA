+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('http://ARCHIVE.ORG/image.jpg', 'http://ARCHIVE.ORG/image.jpg'),
+        ('https://archive.org/image.jpg', 'https://archive.org/image.jpg'),
+        ('https://archive.org.evil.test/image.jpg', None),
+        ('ftp://archive.org/image.jpg', None),
+        ('https://other.test/image.jpg', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'A book', 'cover': cover}
+    url, updated = process_cover_url(edition, ['ArChIvE.OrG'])
+    assert url == expected
+    assert updated is edition
+    assert edition == {'title': 'A book'}
+
+
+def test_process_cover_url_without_cover():
+    edition = {'title': 'A book'}
+    assert process_cover_url(edition) == (None, edition)
+    assert edition == {'title': 'A book'}
+
+
