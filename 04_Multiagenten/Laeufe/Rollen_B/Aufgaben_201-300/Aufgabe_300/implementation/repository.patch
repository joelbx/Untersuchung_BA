+@pytest.mark.parametrize(
+    'fields,error',
+    [
+        ({'publish_date': '1499'}, add_book.PublicationYearTooOld),
+        ({'publish_date': '3000'}, add_book.PublishedInFutureYear),
+        ({'publishers': ['Independently Published']}, add_book.IndependentlyPublished),
+        ({'source_records': ['amazon:test']}, add_book.SourceNeedsISBN),
+    ],
+)
+def test_validate_record_override(fields, error):
+    rec = {'title': 'Test book', 'source_records': ['test:record'], **fields}
+    with pytest.raises(error):
+        add_book.validate_record(rec)
+    add_book.validate_record(rec, override_validation=True)
+
+
+def test_validate_record_override_still_requires_fields():
+    with pytest.raises(RequiredField):
+        add_book.validate_record({'source_records': ['test:record']}, True)
+
+
+def test_load_forwards_override_validation(monkeypatch):
+    rec = {'title': 'Test book', 'source_records': ['test:record']}
+
+    def validate_record(record, override_validation=False):
+        assert record is rec
+        assert override_validation is True
+        raise RuntimeError('validation reached')
+
+    monkeypatch.setattr(add_book, 'validate_record', validate_record)
+    with pytest.raises(RuntimeError, match='validation reached'):
+        load(rec, override_validation=True)
