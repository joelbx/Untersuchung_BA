+func mergeLibraryVuln(cves models.VulnInfos, vinfo models.VulnInfo) {
+	if existing, ok := cves[vinfo.CveID]; ok {
+		existing.LibraryFixedIns = append(existing.LibraryFixedIns, vinfo.LibraryFixedIns...)
+		existing.Confidences.AppendIfMissing(models.TrivyMatch)
+		cves[vinfo.CveID] = existing
+		return
+	}
+	vinfo.Confidences.AppendIfMissing(models.TrivyMatch)
+	cves[vinfo.CveID] = vinfo
+}
