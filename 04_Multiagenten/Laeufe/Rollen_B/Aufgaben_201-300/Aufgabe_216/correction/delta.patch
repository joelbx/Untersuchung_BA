+def test_smart_connection_uses_configured_ssh_executable(mocker, parser, reset_cli_args):
+    context._init_global_context(parser.parse_args([]))
+    play_context = PlayContext()
+    play_context.connection = 'smart'
+    mocker.patch.object(C.config, 'get_config_value', return_value='configured-ssh')
+    probe = mocker.patch('ansible.playbook.play_context.check_for_controlpersist', return_value=True)
+
+    assert play_context.connection == 'ssh'
+    probe.assert_called_once_with('configured-ssh')
