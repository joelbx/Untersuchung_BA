+def test_ssh_explicit_cli_timeout_equal_to_default(tmp_path, monkeypatch):
+    config_file = tmp_path / 'ansible.cfg'
+    config_file.write_text('[ssh_connection]\ntimeout = 17\n')
+    monkeypatch.setattr(C.config, '_config_file', str(config_file))
+    parser = opt_help.create_base_parser('testparser')
+    opt_help.add_connect_options(parser)
+    monkeypatch.setattr(context, 'CLIARGS', context.CLIArgs(vars(parser.parse_args(['--timeout', str(C.DEFAULT_TIMEOUT)]))))
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.set_options(task_keys={'timeout': C.DEFAULT_TIMEOUT})
+
+    assert conn.get_option('timeout') == C.DEFAULT_TIMEOUT
+    assert b'ConnectTimeout=10' in conn._build_command('ssh', 'ssh', 'host')
