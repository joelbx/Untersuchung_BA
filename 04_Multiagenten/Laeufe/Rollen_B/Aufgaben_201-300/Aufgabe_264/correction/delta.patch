+def test_rate_limit_failure_has_warning_in_module_output(module, mocker, capsys):
+    module.module._warnings = []
+    mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                 return_value=(None, {'status': 429, 'msg': 'Rate limit hit', 'url': 'url'}))
+    mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+
+    with pytest.raises(SystemExit) as exit_info:
+        handle_meraki_errors(lambda: module.request('429', method='GET'))()
+
+    output = json.loads(capsys.readouterr().out)
+    assert exit_info.value.code == 1
+    assert output['failed'] is True
+    assert output['status'] == 429
+    assert output['warnings'] == ['Meraki API rate limiter triggered; performed 3 retries.']
+
