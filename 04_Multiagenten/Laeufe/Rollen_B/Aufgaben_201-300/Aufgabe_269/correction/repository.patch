+
+func TestTrivySourceMetadata(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, Summary: "Debian summary", Cvss3Severity: "LOW"}},
+		TrivyNVD:    {{Type: TrivyNVD, Summary: "NVD summary", Cvss2Score: 4.3, Cvss3Score: 7.5, Cvss3Severity: "HIGH"}},
+	}}
+	if len(v.Titles("en", "debian")) < 2 || len(v.Summaries("en", "debian")) < 2 {
+		t.Fatal("Trivy source summaries missing")
+	}
+	if scores := v.Cvss2Scores(); len(scores) != 1 || scores[0].Type != TrivyNVD || scores[0].Value.Score != 4.3 {
+		t.Errorf("CVSS v2: %#v", scores)
+	}
+	if scores := v.Cvss3Scores(); len(scores) != 2 || scores[0].Type != TrivyDebian || scores[0].Value.Severity != "LOW" || !scores[0].Value.CalculatedBySeverity || scores[1].Type != TrivyNVD || scores[1].Value.Score != 7.5 {
+		t.Errorf("CVSS v3: %#v", scores)
+	}
+}
+
+func TestAdditionalTrivySourcesInMetadata(t *testing.T) {
+	const alpine CveContentType = "trivy:alpine"
+	const wolfi CveContentType = "trivy:wolfi"
+	v := VulnInfo{CveContents: CveContents{
+		wolfi:  {{Type: wolfi, Summary: "Wolfi summary", Cvss3Severity: "HIGH"}},
+		alpine: {{Type: alpine, Summary: "Alpine summary", Cvss2Score: 4.3, Cvss3Score: 5.5, Cvss3Severity: "MEDIUM"}},
+	}}
+	types := v.CveContents.TrivySourceTypes()
+	if len(types) != 2 || types[0] != alpine || types[1] != wolfi {
+		t.Fatalf("Trivy source order: %v", types)
+	}
+	for _, values := range [][]CveContentStr{v.Titles("en", "debian"), v.Summaries("en", "debian")} {
+		if len(values) != 2 || values[0].Type != alpine || values[1].Type != wolfi {
+			t.Errorf("missing Trivy source metadata: %#v", values)
+		}
+	}
+	if scores := v.Cvss2Scores(); len(scores) != 1 || scores[0].Type != alpine || scores[0].Value.Score != 4.3 {
+		t.Errorf("CVSS v2: %#v", scores)
+	}
+	if scores := v.Cvss3Scores(); len(scores) != 2 || scores[0].Type != alpine || scores[0].Value.Score != 5.5 || scores[1].Type != wolfi || scores[1].Value.Severity != "HIGH" {
+		t.Errorf("CVSS v3: %#v", scores)
+	}
+}
