+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertSourceContentsAcrossTargets(t *testing.T) {
+	published := time.Date(2020, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	first := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2020-1234", PkgName: "a", SeveritySource: "debian",
+		Vulnerability: dbtypes.Vulnerability{
+			Title: "title", Description: "summary", Severity: "LOW", References: []string{"https://example.com/ref"},
+			PublishedDate: &published, LastModifiedDate: &modified,
+			VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "ubuntu": dbtypes.SeverityMedium},
+			CVSS:           dbtypes.VendorCVSS{"nvd": {V2Score: 4.3, V2Vector: "AV:N", V3Score: 7.5, V3Vector: "CVSS:3.1/AV:N"}},
+		},
+	}
+	second := types.DetectedVulnerability{
+		VulnerabilityID: first.VulnerabilityID, PkgName: "b", SeveritySource: "redhat",
+		Vulnerability: dbtypes.Vulnerability{Severity: "HIGH", VendorSeverity: dbtypes.VendorSeverity{"redhat": dbtypes.SeverityHigh}},
+	}
+	third := types.DetectedVulnerability{
+		VulnerabilityID: first.VulnerabilityID, PkgName: "c", SeveritySource: "nvd",
+	}
+	result, err := Convert(types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{first}},
+		{Type: ftypes.RedHat, Vulnerabilities: []types.DetectedVulnerability{second}},
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{third}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves[first.VulnerabilityID].CveContents
+	if len(contents) != 4 {
+		t.Fatalf("sources: %#v", contents)
+	}
+	for source, want := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyRedHat: "HIGH",
+	} {
+		got := contents[source][0]
+		if got.Type != source || got.CveID != first.VulnerabilityID || got.Cvss3Severity != want {
+			t.Errorf("%s: %#v", source, got)
+		}
+	}
+	nvd := contents[models.TrivyNVD][0]
+	if nvd.Cvss2Score != 4.3 || nvd.Cvss2Vector != "AV:N" || nvd.Cvss3Score != 7.5 || nvd.Cvss3Vector != "CVSS:3.1/AV:N" || nvd.Title != "title" || nvd.Summary != "summary" || len(nvd.References) != 1 || !nvd.Published.Equal(published) || !nvd.LastModified.Equal(modified) {
+		t.Errorf("nvd: %#v", nvd)
+	}
+}
