+// TrivySourceTypes returns the Trivy sources present in these contents.
+// Declared sources keep their usual order; additional sources follow by name.
+func (v CveContents) TrivySourceTypes() (types CveContentTypes) {
+	known := GetCveContentTypes("trivy")
+	for _, ctype := range known {
+		if _, ok := v[ctype]; ok {
+			types = append(types, ctype)
+		}
+	}
+	var additional CveContentTypes
+	for ctype := range v {
+		if !strings.HasPrefix(string(ctype), "trivy:") {
+			continue
+		}
+		found := false
+		for _, declared := range known {
+			if ctype == declared {
+				found = true
+				break
+			}
+		}
+		if !found {
+			additional = append(additional, ctype)
+		}
+	}
+	sort.Slice(additional, func(i, j int) bool { return additional[i] < additional[j] })
+	return append(types, additional...)
+}
