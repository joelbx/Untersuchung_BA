+// appendTrivyContent retains metadata from repeated findings of the same CVE.
+func appendTrivyContent(contents []models.CveContent, content models.CveContent) []models.CveContent {
+	if len(contents) == 0 {
+		return []models.CveContent{content}
+	}
+	previous := contents[len(contents)-1]
+	if content.Title == "" {
+		content.Title = previous.Title
+	}
+	if content.Summary == "" {
+		content.Summary = previous.Summary
+	}
+	if content.Cvss2Score == 0 {
+		content.Cvss2Score = previous.Cvss2Score
+	}
+	if content.Cvss2Vector == "" {
+		content.Cvss2Vector = previous.Cvss2Vector
+	}
+	if content.Cvss3Score == 0 {
+		content.Cvss3Score = previous.Cvss3Score
+	}
+	if content.Cvss3Vector == "" {
+		content.Cvss3Vector = previous.Cvss3Vector
+	}
+	if content.Cvss3Severity == "" {
+		content.Cvss3Severity = previous.Cvss3Severity
+	}
+	if len(content.References) == 0 {
+		content.References = previous.References
+	}
+	if content.Published.IsZero() {
+		content.Published = previous.Published
+	}
+	if content.LastModified.IsZero() {
+		content.LastModified = previous.LastModified
+	}
+	if content.Cvss3Severity == previous.Cvss3Severity && content.Cvss3Score == previous.Cvss3Score && content.Cvss2Score == previous.Cvss2Score {
+		contents[len(contents)-1] = content
+		return contents
+	}
+	return append(contents, content)
+}
