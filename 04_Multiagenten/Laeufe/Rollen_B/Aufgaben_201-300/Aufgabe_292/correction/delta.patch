 	}
 	p.running = true
 	p.mu.Unlock()
+	p.poll()
+}
+
+func (p *Poller) poll() {
 	defer close(p.done)
 
 	ticker := time.NewTicker(p.interval)
@@ -104,10 +121,11 @@ func (p *Poller) Close() error {
 	p.mu.Lock()
 	p.closed = true
 	p.cancel()
+	done := p.done
