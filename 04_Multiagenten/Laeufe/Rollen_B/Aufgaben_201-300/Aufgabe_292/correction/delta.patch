+// Start registers and launches polling so Close can wait even if the goroutine
+// has not yet been scheduled.
+func (p *Poller) Start() {
+	p.mu.Lock()
+	if p.closed || p.running {
+		p.mu.Unlock()
+		return
+	}
+	p.running = true
+	p.mu.Unlock()
+	go p.poll()
+}
+
 // Poll runs the common polling strategy until the poller is closed or its parent context ends.
 func (p *Poller) Poll() {
 	p.mu.Lock()
