+// Close stops polling and waits for any in-flight update to finish.
+func (p *Poller) Close() error {
+	p.mu.Lock()
+	p.closed = true
+	p.cancel()
+	running := p.running
+	p.mu.Unlock()
+	if running {
+		<-p.done
+	}
+	return nil
+}
diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..dda4d02
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,71 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan context.Context, 1)
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		started <- ctx
+		<-release
+		close(finished)
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	go p.Poll()
+
+	var updateCtx context.Context
+	select {
+	case updateCtx = <-started:
+	case <-time.After(time.Second):
+		t.Fatal("polling did not start")
+	}
+
+	closed := make(chan error, 1)
+	go func() { closed <- p.Close() }()
+	select {
+	case <-updateCtx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("polling context was not cancelled")
+	}
+	select {
+	case <-closed:
+		t.Fatal("Close returned before the update finished")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case err := <-closed:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("Close did not return after the update finished")
+	}
+	select {
+	case <-finished:
+	default:
+		t.Fatal("update was still running after Close")
+	}
+	require.NoError(t, p.Close())
+}
+
+func TestPollerCloseBeforePoll(t *testing.T) {
+	called := make(chan struct{}, 1)
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		called <- struct{}{}
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	require.NoError(t, p.Close())
+	p.Poll()
+	select {
+	case <-called:
+		t.Fatal("update ran after Close")
+	default:
+	}
+}
