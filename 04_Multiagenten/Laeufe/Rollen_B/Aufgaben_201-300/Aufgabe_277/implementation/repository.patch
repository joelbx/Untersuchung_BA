+
+func TestRuleSegments(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		keys    []string
+		wantKey string
+		wantOp  string
+	}{
+		{name: "single", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple", keys: []string{"first", "second"}, wantKey: "first,second", wantOp: "AND_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{
+				SegmentKey:      "legacy",
+				SegmentKeys:     tc.keys,
+				SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+			})
+			assert.Equal(t, tc.wantKey, rule.SegmentKey)
+			assert.Equal(t, tc.wantOp, rule.SegmentOperator)
+			encoded, err := json.Marshal(rule)
+			assert.NoError(t, err)
+			if tc.wantOp == "" {
+				assert.NotContains(t, string(encoded), `"segment_operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"segment_operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		keys    []string
+		wantKey string
+		wantOp  string
+	}{
+		{name: "legacy", wantKey: "legacy"},
+		{name: "single", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple", keys: []string{"first", "second"}, wantKey: "first,second", wantOp: "OR_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{
+				Segment: &flipt.RolloutSegment{
+					SegmentKey:      "legacy",
+					SegmentKeys:     tc.keys,
+					SegmentOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR,
+					Value:           true,
+				},
+			}})
+			assert.Equal(t, tc.wantKey, rollout.Segment.Key)
+			assert.Equal(t, tc.wantOp, rollout.Segment.Operator)
+			assert.True(t, rollout.Segment.Value)
+			encoded, err := json.Marshal(rollout)
+			assert.NoError(t, err)
+			if tc.wantOp == "" {
+				assert.NotContains(t, string(encoded), `"operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"operator":"OR_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
