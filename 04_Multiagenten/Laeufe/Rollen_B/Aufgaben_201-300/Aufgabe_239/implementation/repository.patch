+		Expect(props.Delete("props-user-a", "setting")).To(Succeed())
+		_, err := props.Get("props-user-a", "setting")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(props.Get("props-user-b", "setting")).To(Equal("b"))
+	})
+})
