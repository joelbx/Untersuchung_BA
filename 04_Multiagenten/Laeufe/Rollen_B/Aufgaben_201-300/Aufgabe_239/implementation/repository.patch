+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User properties", func() {
+	It("uses the explicit user ID even when the context belongs to another user", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		props := NewUserPropsRepository(ctx, orm.NewOrm())
+		Expect(props.Put("props-user-a", "setting", "a")).To(Succeed())
+		Expect(props.Put("props-user-b", "setting", "b")).To(Succeed())
+		Expect(props.Get("props-user-a", "setting")).To(Equal("a"))
+		Expect(props.Get("props-user-b", "setting")).To(Equal("b"))
