+
+
+@pytest.mark.parametrize('task_vars, expected', [
+    ({}, b'#!/usr/bin/python'),
+    ({'ansible_python_interpreter': '/opt/venv/bin/python3'}, b'#!/opt/venv/bin/python3'),
+])
+def test_old_style_without_shebang(tmp_path, templar, task_vars, expected):
+    module_path = tmp_path / 'sample.py'
+    source = b'print("hello")\n'
+    module_path.write_bytes(source)
+    data, style, shebang = modify_module('sample', str(module_path), {}, templar, task_vars=task_vars)
+    assert style == 'old'
+    assert shebang == expected.decode('utf-8')
+    assert data == expected + b'\n# -*- coding: utf-8 -*-\n' + source
+
+
+def test_old_style_interpreter_override_preserves_quoted_args(tmp_path, templar):
+    module_path = tmp_path / 'sample.py'
+    module_path.write_bytes(b'#!/usr/bin/python3 -X "dev mode"\nprint("hello")\n')
+    data, style, shebang = modify_module('sample', str(module_path), {}, templar,
