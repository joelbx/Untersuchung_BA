+def test_new_style_interpreter_override_preserves_quoted_args(tmp_path, templar):
+    module_path = tmp_path / 'sample.py'
+    module_path.write_bytes(b'#!/opt/venv/bin/python3.8 -X "dev mode"\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    data, style, shebang = modify_module('sample', str(module_path), {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/usr/bin/python3'})
+    assert style == 'new'
+    assert shebang == "#!/usr/bin/python3 -X 'dev mode'"
+    assert data.startswith(b"#!/usr/bin/python3 -X 'dev mode'\n# -*- coding: utf-8 -*-\n")
