+def test_get_ia_record_splits_compound_publishers() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'title': 'A book',
+            'publisher': [
+                'London ; New York ; Paris : Berlitz Publishing',
+                '[Berlin]:[Second Publisher]',
+                'Publisher, Inc.',
+            ],
+            'isbn': [' 123456789X ', ' 1234567890123 ', 'invalid'],
+        }
+    )
+    assert result['publish_places'] == ['London', 'New York', 'Paris', 'Berlin']
+    assert result['publishers'] == [
+        'Berlitz Publishing',
+        'Second Publisher',
+        'Publisher, Inc.',
+    ]
+    assert result['isbn_10'] == ['123456789X']
+    assert result['isbn_13'] == ['1234567890123']
+
+    result = code.ia_importapi.get_ia_record(
+        {'publisher': 'London;New York;Paris:Berlitz Publishing'}
+    )
+    assert result['publish_places'] == ['London', 'New York', 'Paris']
+    assert result['publishers'] == ['Berlitz Publishing']
+
