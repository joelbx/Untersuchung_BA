diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..f6530a4
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"fmt"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, contents string) (string, func()) {
+	t.Helper()
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cleanup := func() { os.RemoveAll(dir) }
+	path := filepath.Join(dir, "config.yml")
+	if err := ioutil.WriteFile(path, []byte(contents), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path, cleanup
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	cfg, err := configure("../../config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("default configuration differs: %#v", cfg)
+	}
+
+	path, cleanup := writeConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: ./testdata/config/ssl_cert.pem\n  cert_key: ./testdata/config/ssl_key.pem\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	defer cleanup()
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server.Host != "127.0.0.1" || cfg.Server.Protocol != HTTPS || cfg.Server.HTTPPort != 8081 || cfg.Server.HTTPSPort != 8080 || cfg.Server.GRPCPort != 9001 || cfg.Server.CertFile != "./testdata/config/ssl_cert.pem" || cfg.Server.CertKey != "./testdata/config/ssl_key.pem" || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("unexpected configuration: %#v", cfg)
+	}
+
+	path, cleanup = writeConfig(t, "cors:\n  allowed_origins:\n    - foo.com\n")
+	defer cleanup()
+	cfg, err = configure(path)
+	if err != nil || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("list origins: %#v, %v", cfg, err)
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	cfg, err = configure(path)
+	if err != nil || cfg.Server.HTTPPort != 8181 {
+		t.Fatalf("environment override: %#v, %v", cfg, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	for _, tc := range []struct {
+		cert, key, want string
+	}{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{"cert.pem", "", "cert_key cannot be empty when using HTTPS"},
+		{"missing.pem", "missing.key", "cannot find TLS cert_file at \"missing.pem\""},
+	} {
+		cfg.Server.CertFile, cfg.Server.CertKey = tc.cert, tc.key
+		if err := cfg.validate(); err == nil || err.Error() != tc.want {
+			t.Fatalf("validate(%q, %q) = %v; want %q", tc.cert, tc.key, err, tc.want)
+		}
+	}
+
+	cert, cleanup := writeConfig(t, "certificate")
+	defer cleanup()
+	cfg.Server.CertFile, cfg.Server.CertKey = cert, "missing.key"
+	if err := cfg.validate(); err == nil || err.Error() != "cannot find TLS cert_key at \"missing.key\"" {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg.Server.CertKey = cert
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+	path, cleanup := writeConfig(t, fmt.Sprintf("server:\n  protocol: https\n  https_port: 8080\n  cert_file: %q\n  cert_key: %q\n", cert, cert))
+	defer cleanup()
+	loaded, err := configure(path)
+	if err != nil || loaded.Server.Protocol != HTTPS || loaded.Server.HTTPSPort != 8080 || loaded.Server.CertFile != cert || loaded.Server.CertKey != cert {
+		t.Fatalf("HTTPS configuration: %#v, %v", loaded, err)
+	}
+	cfg.Server.Protocol = HTTP
+	cfg.Server.CertFile = ""
+	cfg.Server.CertKey = ""
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+
+	path, cleanup = writeConfig(t, "server:\n  protocol: https\n")
+	defer cleanup()
+	if _, err := configure(path); err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("configure validation: %v", err)
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []http.Handler{defaultConfig(), info{Version: "test"}} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/", nil))
+		if recorder.Code != http.StatusOK || strings.TrimSpace(recorder.Body.String()) == "" {
+			t.Fatalf("response: %d %q", recorder.Code, recorder.Body.String())
+		}
+	}
+	if HTTPS.String() != "https" || HTTP.String() != "http" {
+		t.Fatal("unexpected scheme strings")
+	}
+}
