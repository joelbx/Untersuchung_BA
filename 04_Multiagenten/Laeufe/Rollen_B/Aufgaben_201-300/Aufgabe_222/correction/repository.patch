diff --git a/test/units/cli/test_doc.py b/test/units/cli/test_doc.py
index d93b5aa..d1a5a2d 100644
--- a/test/units/cli/test_doc.py
+++ b/test/units/cli/test_doc.py
@@ -4,7 +4,7 @@ __metaclass__ = type
 
 import pytest
 
-from ansible.cli.doc import DocCLI
+from ansible.cli.doc import DocCLI, RoleMixin
 
 
 TTY_IFY_DATA = {
@@ -33,3 +33,56 @@ TTY_IFY_DATA = {
 @pytest.mark.parametrize('text, expected', sorted(TTY_IFY_DATA.items()))
 def test_ttyify(text, expected):
     assert DocCLI.tty_ify(text) == expected
+
+
+@pytest.mark.parametrize('collection, expected_name', [(None, 'example'), ('', 'example'), ('ns.coll', 'ns.coll.example')])
+def test_build_role_doc(collection, expected_name):
+    argspec = {'main': {'short_description': 'Main'}, 'alternate': None}
+
+    fqcn, doc = RoleMixin()._build_doc('example', '/role/path', collection, argspec)
+
+    assert fqcn == expected_name
+    assert doc == {'path': '/role/path', 'collection': collection, 'entry_points': argspec}
+    assert doc['entry_points']['main'] is argspec['main']
+    assert doc['entry_points']['alternate'] is None
+
+
+@pytest.mark.parametrize('argspec, entry_point, expected_entry_points', [
+    ({'main': {'short_description': 'Main'}, 'alternate': {'short_description': 'Other'}}, 'alternate',
+     {'alternate': {'short_description': 'Other'}}),
+    ({'main': {}}, 'missing', None),
+    ({}, None, None),
+])
+def test_build_role_doc_entry_point_filter(argspec, entry_point, expected_entry_points):
+    fqcn, doc = RoleMixin()._build_doc('example', '/role/path', 'ns.coll', argspec, entry_point)
+
+    assert fqcn == 'ns.coll.example'
+    if expected_entry_points is None:
+        assert doc is None
+    else:
+        assert doc == {'path': '/role/path', 'collection': 'ns.coll',
+                       'entry_points': expected_entry_points}
+
+
+def test_create_role_doc_omits_roles_without_matching_entry_point(monkeypatch):
+    mixin = RoleMixin()
+    monkeypatch.setattr(mixin, '_find_all_normal_roles', lambda *args, **kwargs: {('plain', '/plain')})
+    monkeypatch.setattr(mixin, '_find_all_collection_roles',
+                        lambda *args, **kwargs: {('included', 'ns.coll', '/collection')})
+    monkeypatch.setattr(mixin, '_load_argspec',
+                        lambda role, **kwargs: {'main': {}} if role == 'plain' else {'alternate': {'options': {}}})
+
+    assert mixin._create_role_doc(('plain', 'included'), ('/roles',), 'alternate') == {
+        'ns.coll.included': {'path': '/collection', 'collection': 'ns.coll',
+                             'entry_points': {'alternate': {'options': {}}}},
+    }
+
+
+def test_render_role_doc_with_null_entry_point():
+    argspec = {'main': None}
+    fqcn, role_doc = RoleMixin()._build_doc('example', '/role/path', None, argspec)
+
+    rendered = DocCLI.get_role_man_text(None, fqcn, role_doc)
+
+    assert 'ENTRY POINT: main\n' in rendered
+    assert role_doc['entry_points']['main'] is None
