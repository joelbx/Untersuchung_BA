+    def _build_doc(self, role, path, collection, argspec, entry_point=None):
+        """Build documentation for a role and its selected entry points.
+
+        Return the role name and None when no entry points are included.
+        """
+        fqcn = '.'.join([collection, role]) if collection else role
+        entry_points = {}
+        for ep, entry_spec in argspec.items():
+            if entry_point is None or ep == entry_point:
+                entry_points[ep] = entry_spec
+
+        if not entry_points:
+            return fqcn, None
+
+        doc = {'path': path, 'collection': collection, 'entry_points': entry_points}
+        return fqcn, doc
