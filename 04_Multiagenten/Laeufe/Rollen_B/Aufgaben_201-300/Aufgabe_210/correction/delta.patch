+        task.loop = None
+        task.evaluate_conditional_with_result.return_value = (False, 'False')
+        manager = MagicMock()
+        manager.get_delegated_vars_and_hostname.side_effect = AnsibleUndefinedVariable('missing_delegate is undefined')
+        executor = TaskExecutor(MagicMock(), task, {}, MagicMock(), None,
+                                DictDataLoader({}), MagicMock(), MagicMock(), variable_manager=manager)
+        executor._get_loop_items = MagicMock(return_value=None)
+
+        result = executor.run()
+
+        self.assertTrue(result['skipped'])
+        manager.get_delegated_vars_and_hostname.assert_called_once()
+        task.evaluate_conditional_with_result.assert_called_once()
