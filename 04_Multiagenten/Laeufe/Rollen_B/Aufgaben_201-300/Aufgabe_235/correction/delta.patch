index 7bf48e0..869f22a 100644
--- a/openlibrary/catalog/marc/parse.py
+++ b/openlibrary/catalog/marc/parse.py
@@ -382,7 +382,12 @@ def read_publisher(rec):
 
 def name_from_list(name_parts: list[str]) -> str:
     """Build a display name from MARC name subfields."""
-    parts = [strip_foc(value.strip()).strip(' /,;:[]') for value in name_parts]
+    parts = []
+    for value in name_parts:
+        part = value.strip()
+        if part.endswith('[from old catalog].'):
+            part = part[:-1]
+        parts.append(strip_foc(part).strip(' /,;:[]'))
     return ' '.join(part for part in parts if part).removesuffix('.').strip(' /,;:[]')
 
 
