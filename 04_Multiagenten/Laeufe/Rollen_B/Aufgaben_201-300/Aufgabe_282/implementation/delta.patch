 @pytest.mark.parametrize('dnt, accept_language, custom_headers, expected', [
@@ -45,3 +48,69 @@ def test_custom_headers(config_stub, dnt, accept_language, custom_headers,
 
     expected_items = sorted(expected.items())
     assert shared.custom_headers(url=None) == expected_items
+
+
+@pytest.mark.parametrize('level, source, msg, expected', [
+    (usertypes.JsLogLevel.error, 'userscript:style', 'Unexpected error', True),
+    (usertypes.JsLogLevel.warning, 'userscript:style', 'Unexpected error', False),
+    (usertypes.JsLogLevel.error, 'page:style', 'Unexpected error', False),
+    (usertypes.JsLogLevel.error, 'userscript:style',
+     'Refused to apply inline style because of CSP', False),
+    (usertypes.JsLogLevel.error, 'userscript:other',
+     'Refused to apply inline style because of CSP', False),
+    (usertypes.JsLogLevel.error, 'qute:style',
+     'Refused to apply inline style because of CSP', True),
+])
+def test_js_log_to_ui(config_stub, message_mock, caplog,
+                      level, source, msg, expected):
+    settings = config_stub.val.content.javascript.log_message
+    settings.levels = {'userscript:*': ['error'], 'qute:*': ['error']}
+    settings.excludes = {'userscript:style': ['Refused to apply inline style*'],
+                         'userscript:*': ['*because of CSP']}
+
+    with caplog.at_level(logging.ERROR):
+        assert shared._js_log_to_ui(level, source, 66, msg) is expected
+    if expected:
+        ui_msg = message_mock.getmsg(usertypes.MessageLevel.error)
+        assert ui_msg.text == f'JS: [{source}:66] {msg}'
+    else:
+        assert not message_mock.messages
+
+
+@pytest.mark.parametrize('level, ui_level', [
+    (usertypes.JsLogLevel.info, usertypes.MessageLevel.info),
+    (usertypes.JsLogLevel.warning, usertypes.MessageLevel.warning),
+    (usertypes.JsLogLevel.error, usertypes.MessageLevel.error),
+])
+def test_js_log_ui_level(config_stub, message_mock, caplog, level, ui_level):
+    settings = config_stub.val.content.javascript.log_message
+    settings.levels = {'userscript:*': [level.name]}
+    settings.excludes = None
+
+    with caplog.at_level(getattr(logging, level.name.upper())):
+        assert shared._js_log_to_ui(level, 'userscript:style', 66, 'Unexpected')
+    assert message_mock.getmsg(ui_level).text == (
+        'JS: [userscript:style:66] Unexpected')
+
+
+@pytest.mark.parametrize('excluded', [False, True])
+def test_javascript_log_message_fallback(config_stub, message_mock,
+                                         monkeypatch, caplog, excluded):
+    settings = config_stub.val.content.javascript.log_message
+    settings.levels = {'userscript:*': ['error']}
+    settings.excludes = {'userscript:*': ['Refused*']} if excluded else {}
+    logged = []
+    monkeypatch.setitem(shared._JS_LOGMAP, 'debug', logged.append)
+
+    msg = 'Refused to apply inline style'
+    with caplog.at_level(logging.ERROR):
+        shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                      'userscript:style', 66, msg)
+
+    if excluded:
+        assert not message_mock.messages
+        assert logged == [f'[userscript:style:66] {msg}']
+    else:
+        assert message_mock.getmsg(usertypes.MessageLevel.error).text == (
+            f'JS: [userscript:style:66] {msg}')
+        assert not logged
