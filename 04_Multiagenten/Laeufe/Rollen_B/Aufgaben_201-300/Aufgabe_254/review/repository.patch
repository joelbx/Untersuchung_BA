 )
 
+type imdsHTTPClientFunc func(*http.Request) (*http.Response, error)
+
+func (f imdsHTTPClientFunc) Do(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestInstanceMetadataClientIsAvailable(t *testing.T) {
+	tests := []struct {
+		name     string
+		metadata string
+		fetchErr error
+		want     bool
+	}{
+		{name: "short ID", metadata: "i-1a2b3c4d", want: true},
+		{name: "long ID", metadata: "i-1234567890abcdef0", want: true},
+		{name: "HTML", metadata: "<!DOCTYPE html><html>login</html>"},
+		{name: "missing prefix", metadata: "12345678"},
+		{name: "wrong length", metadata: "i-123456789"},
+		{name: "uppercase hex", metadata: "i-1A2B3C4D"},
+		{name: "trailing data", metadata: "i-12345678\n"},
+		{name: "retrieval error", fetchErr: errors.New("metadata unavailable")},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			metadataRequested := false
+			internal := imds.New(imds.Options{
+				Endpoint: "http://169.254.169.254",
+				HTTPClient: imdsHTTPClientFunc(func(req *http.Request) (*http.Response, error) {
+					if req.Method == http.MethodPut && req.URL.Path == "/latest/api/token" {
+						return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader("token")), Header: make(http.Header)}, nil
+					}
+					require.Equal(t, http.MethodGet, req.Method)
+					require.Equal(t, "/latest/meta-data/instance-id", req.URL.Path)
+					metadataRequested = true
+					if tt.fetchErr != nil {
+						return nil, tt.fetchErr
+					}
+					return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(tt.metadata)), Header: make(http.Header)}, nil
+				}),
+			})
+			client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(internal))
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, client.IsAvailable(context.Background()))
+			assert.True(t, metadataRequested)
+		})
+	}
+}
+
+func TestInstanceMetadataClientIsAvailableTimeout(t *testing.T) {
+	internal := imds.New(imds.Options{
+		Endpoint: "http://169.254.169.254",
+		HTTPClient: imdsHTTPClientFunc(func(req *http.Request) (*http.Response, error) {
+			if req.Method == http.MethodPut {
+				return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader("token")), Header: make(http.Header)}, nil
+			}
+			require.Equal(t, "/latest/meta-data/instance-id", req.URL.Path)
+			<-req.Context().Done()
+			return nil, req.Context().Err()
+		}),
+	})
+	client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(internal))
+	require.NoError(t, err)
+	start := time.Now()
+	assert.False(t, client.IsAvailable(context.Background()))
+	assert.Less(t, time.Since(start), time.Second)
+}
+
+func TestNewInstanceMetadataClientOptionError(t *testing.T) {
+	wantErr := errors.New("option failed")
+	client, err := NewInstanceMetadataClient(context.Background(), func(*InstanceMetadataClient) error {
+		return wantErr
+	})
+	assert.Nil(t, client)
+	assert.ErrorIs(t, err, wantErr)
+}
