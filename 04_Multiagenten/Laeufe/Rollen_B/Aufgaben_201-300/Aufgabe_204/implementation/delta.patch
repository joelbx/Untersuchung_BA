+/** Parse a text date, preserving the local calendar day for dates without a timezone. */
+export const guessDateFromText = (text: string): Date | undefined => {
+    const value = text.trim();
+    if (!value) {
+        return undefined;
+    }
+
+    // parseISO handles ISO calendar dates in local time, so date-only values retain their calendar day.
+    const isoDate = parseISO(value);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+    if (/^\d{4}-/.test(value)) {
+        return undefined;
+    }
+
+    const slashDate = /^(\d{1,4})\/(\d{1,2})\/(\d{1,4})$/.exec(value);
+    if (slashDate) {
+        const format = slashDate[1].length === 4 ? 'yyyy/M/d' : 'M/d/yyyy';
+        const date = parse(value, format, new Date());
+        return isValid(date) ? date : undefined;
+    }
+
+    if (/^[A-Za-z]+ \d{1,2}, \d{4}$/.test(value)) {
+        const date = parse(value, 'MMMM d, yyyy', new Date());
+        return isValid(date) ? date : undefined;
+    }
+
+    const date = new Date(value);
+    return isValid(date) ? date : undefined;
+};
