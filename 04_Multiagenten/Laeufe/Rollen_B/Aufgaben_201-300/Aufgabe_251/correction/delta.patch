 func (validator *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
 	result := Result{Errors: []Error{}}
 	f, err := yaml.Extract(file, b)
-	if err == nil {
-		value := validator.v.Unify(validator.cue.BuildFile(f, cue.Scope(validator.v)))
-		err = value.Validate()
+	if err != nil {
+		// YAML parser errors are ordinary Go errors. Converting them through
+		// cue/errors loses their message and source line.
+		location := Location{File: file, Line: 1, Column: 1}
+		if source := strings.TrimPrefix(err.Error(), file+":"); source != err.Error() {
+			if line, rest, ok := strings.Cut(source, ":"); ok {
+				if n, parseErr := strconv.Atoi(line); parseErr == nil {
+					location.Line = n
+					if column, _, ok := strings.Cut(rest, ":"); ok {
+						if n, parseErr := strconv.Atoi(column); parseErr == nil {
+							location.Column = n
+						}
+					}
+				}
+			}
+		}
+		result.Errors = append(result.Errors, Error{Path: "$", Message: err.Error(), Location: location})
+		return result, ErrValidationFailed
 	}
+	value := validator.v.Unify(validator.cue.BuildFile(f, cue.Scope(validator.v)))
+	err = value.Validate(cue.Concrete(true))
 	if err == nil {
 		return result, nil
 	}
