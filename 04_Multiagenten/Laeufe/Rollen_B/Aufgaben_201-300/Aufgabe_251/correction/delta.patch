+func TestFeaturesValidator_MalformedYAML(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+
+	result, err := validator.Validate("input.yaml", []byte("flags:\n  - key: [\n"))
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.Len(t, result.Errors, 1)
+	require.Equal(t, "$", result.Errors[0].Path)
+	require.Contains(t, result.Errors[0].Message, "did not find expected node content")
+	require.Equal(t, Location{File: "input.yaml", Line: 2, Column: 1}, result.Errors[0].Location)
+}
+
+func TestFeaturesValidator_MissingRequiredKey(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+
+	result, err := validator.Validate("input.yaml", []byte("flags:\n  - name: example\n    variants: []\n    rules: []\nsegments: []\n"))
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.Len(t, result.Errors, 1)
+	require.Equal(t, "flags.0.key", result.Errors[0].Path)
+	require.Contains(t, result.Errors[0].Message, "key")
+	require.Equal(t, Location{File: "input.yaml", Line: 2, Column: 5}, result.Errors[0].Location)
+}
+
