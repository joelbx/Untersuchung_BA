+// Validate checks a YAML document and returns all of its validation errors.
+func (validator *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	result := Result{Errors: []Error{}}
+	f, err := yaml.Extract(file, b)
+	if err == nil {
+		value := validator.v.Unify(validator.cue.BuildFile(f, cue.Scope(validator.v)))
+		err = value.Validate()
+	}
+	if err == nil {
+		return result, nil
+	}
+
+	positions := yamlPositions(b, file)
+	for _, issue := range cueerror.Errors(err) {
+		path := strings.Join(issue.Path(), ".")
+		message, args := issue.Msg()
+		message = fmt.Sprintf(message, args...)
+		if path != "" {
+			message = path + ": " + message
+		}
+		location := Location{File: file}
+		if entry, ok := positions[path]; ok {
+			location = entry.value
+			if strings.Contains(message, "field not allowed") {
+				location = entry.key
+			}
+		} else {
+			// Missing fields have no node of their own. Point to the closest
+			// enclosing YAML value when one is available.
+			for parent := path; parent != ""; {
+				index := strings.LastIndex(parent, ".")
+				if index < 0 {
+					break
+				}
+				parent = parent[:index]
+				if entry, ok := positions[parent]; ok {
+					location = entry.value
+					break
+				}
+			}
+			for _, pos := range issue.InputPositions() {
+				if location.Line == 0 && pos.IsValid() && pos.Filename() == file {
+					location.Line, location.Column = pos.Line(), pos.Column()
+					break
+				}
+			}
+		}
+		result.Errors = append(result.Errors, Error{Path: path, Message: message, Location: location})
+	}
+	if len(result.Errors) == 0 {
+		result.Errors = append(result.Errors, Error{Message: err.Error(), Location: Location{File: file}})
+	}
+	return result, ErrValidationFailed
+}
+
+type fieldPositions struct {
+	key   Location
+	value Location
+}
+
+// yamlPositions uses the original YAML nodes because CUE's unified errors can
+// point at a parent schema node when an unknown field is rejected.
+func yamlPositions(b []byte, file string) map[string]fieldPositions {
+	positions := make(map[string]fieldPositions)
+	var root yamlv3.Node
+	if err := yamlv3.Unmarshal(b, &root); err != nil {
+		return positions
+	}
+	var walk func(*yamlv3.Node, string)
+	walk = func(node *yamlv3.Node, path string) {
+		switch node.Kind {
+		case yamlv3.DocumentNode:
+			for _, child := range node.Content {
+				walk(child, path)
+			}
+		case yamlv3.MappingNode:
+			for i := 0; i+1 < len(node.Content); i += 2 {
+				key, value := node.Content[i], node.Content[i+1]
+				childPath := key.Value
+				if path != "" {
+					childPath = path + "." + childPath
+				}
+				positions[childPath] = fieldPositions{
+					key:   Location{File: file, Line: key.Line, Column: key.Column},
+					value: Location{File: file, Line: value.Line, Column: value.Column},
+				}
+				walk(value, childPath)
+			}
+		case yamlv3.SequenceNode:
+			for i, child := range node.Content {
+				childPath := strconv.Itoa(i)
+				if path != "" {
+					childPath = path + "." + childPath
+				}
+				positions[childPath] = fieldPositions{key: Location{File: file, Line: child.Line, Column: child.Column}, value: Location{File: file, Line: child.Line, Column: child.Column}}
+				walk(child, childPath)
+			}
+		}
+	}
+	walk(&root, "")
+	return positions
+}
