-    sysctl = dict()
+    sysctl = {}
+    last_key = None
     for line in out.splitlines():
         if not line:
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
+        if line[0].isspace() and last_key is not None:
+            sysctl[last_key] += '\n' + line
+            continue
+        try:
+            key, value = re.split(r'\s*=\s*|:\s*|\s+', line, maxsplit=1)
+            if not key:
+                raise ValueError('empty sysctl key')
+        except ValueError as e:
+            module.warn('Unable to split sysctl line (%s): %s' % (line, e))
+            last_key = None
+            continue
         sysctl[key] = value.strip()
+        last_key = key
 
     return sysctl
+
+
+def get_uptime_facts(module):
+    try:
+        sysctl_cmd = module.get_bin_path('sysctl')
+    except (IOError, OSError) as e:
+        if getattr(e, 'errno', None) == errno.ENOENT:
+            raise ValueError('Unable to find sysctl: %s' % e)
+        return {}
+    if not sysctl_cmd:
+        raise ValueError('Unable to find sysctl')
+    try:
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'])
+    except (IOError, OSError) as e:
+        if getattr(e, 'errno', None) == errno.ENOENT:
+            raise ValueError('Unable to find sysctl: %s' % e)
+        return {}
+    if rc != 0:
+        return {}
+    try:
+        boot_time = float(out.strip())
+        if math.isnan(boot_time) or math.isinf(boot_time):
+            return {}
+    except (ValueError, TypeError):
+        return {}
+    return {'uptime_seconds': int(time.time() - boot_time)}
diff --git a/test/units/module_utils/facts/test_sysctl.py b/test/units/module_utils/facts/test_sysctl.py
new file mode 100644
index 0000000..5bc59a8
--- /dev/null
+++ b/test/units/module_utils/facts/test_sysctl.py
@@ -0,0 +1,97 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import errno
+
+import pytest
+
+from units.compat.mock import Mock, patch
+
+from ansible.module_utils.facts.sysctl import get_sysctl
+from ansible.module_utils.facts.hardware.freebsd import FreeBSDHardware
+from ansible.module_utils.facts.hardware.netbsd import NetBSDHardware
+from ansible.module_utils.facts.hardware.openbsd import OpenBSDHardware
+
+
+def test_get_sysctl_parses_formats_and_continuations():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, 'hw.ncpu=4\nhw.model: CPU name\n'
+                                       'kern.message first line\n  second line\n'
+                                       'malformed\nhw.usermem = 1024\n', '')
+
+    result = get_sysctl(module, ['hw', 'kern'])
+
+    assert result == {'hw.ncpu': '4', 'hw.model': 'CPU name',
+                      'kern.message': 'first line\n  second line', 'hw.usermem': '1024'}
+    module.warn.assert_called_once()
+    assert module.warn.call_args[0][0].startswith('Unable to split sysctl line (malformed): ')
+
+
+@pytest.mark.parametrize('failure', [(1, '', 'permission denied'), OSError('failed')])
+def test_get_sysctl_command_failure_warns(failure):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    if isinstance(failure, tuple):
+        module.run_command.return_value = failure
+    else:
+        module.run_command.side_effect = failure
+
+    assert get_sysctl(module, ['hw']) == {}
+    assert module.warn.call_args[0][0].startswith('Unable to read sysctl: ')
+
+
+@pytest.mark.parametrize('hardware_class', [FreeBSDHardware, NetBSDHardware, OpenBSDHardware])
+def test_bsd_uptime(hardware_class):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, '1000\n', '')
+    with patch('ansible.module_utils.facts.sysctl.time.time', return_value=1300):
+        assert hardware_class(module).get_uptime_facts() == {'uptime_seconds': 300}
+    module.run_command.assert_called_once_with(['/sbin/sysctl', '-n', 'kern.boottime'])
+
+
+@pytest.mark.parametrize('output', ['', 'not a number', '{ sec = 1000 }', 'nan'])
+def test_bsd_uptime_omitted_for_invalid_output(output):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, output, '')
+    assert FreeBSDHardware(module).get_uptime_facts() == {}
+
+
+def test_bsd_uptime_omitted_for_command_error():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (1, '', 'failure')
+    assert FreeBSDHardware(module).get_uptime_facts() == {}
+
+
+def test_bsd_uptime_missing_binary_raises_value_error():
+    module = Mock()
+    module.get_bin_path.return_value = None
+    with pytest.raises(ValueError):
+        FreeBSDHardware(module).get_uptime_facts()
+
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.side_effect = OSError(errno.ENOENT, 'missing')
+    with pytest.raises(ValueError):
+        FreeBSDHardware(module).get_uptime_facts()
+
+
+@pytest.mark.parametrize('hardware_class', [FreeBSDHardware, NetBSDHardware, OpenBSDHardware])
+def test_bsd_populate_merges_uptime(hardware_class):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, '1000', '')
+    hardware = hardware_class(module)
+    for name in ('get_cpu_facts', 'get_processor_facts', 'get_memory_facts',
+                 'get_dmi_facts', 'get_device_facts', 'get_mount_facts'):
+        if hasattr(hardware, name):
+            setattr(hardware, name, Mock(return_value={name: True}))
+    with patch('ansible.module_utils.facts.sysctl.time.time', return_value=1300), \
+            patch('ansible.module_utils.facts.hardware.netbsd.get_sysctl', return_value={}), \
+            patch('ansible.module_utils.facts.hardware.openbsd.get_sysctl', return_value={}):
+        result = hardware.populate()
+    assert result['uptime_seconds'] == 300
+    assert result['get_memory_facts'] is True
+    assert result['get_mount_facts'] is True
