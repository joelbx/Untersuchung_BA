+func TestLoadOAuthCredentials(t *testing.T) {
+	tests := []struct {
+		name    string
+		method  string
+		fields  string
+		wantErr string
+	}{
+		{"github client id", "github", "client_id: ''\nclient_secret: secret\nredirect_address: http://localhost/callback", `provider "github": field "client_id": non-empty value is required`},
+		{"github client secret", "github", "client_id: client\nclient_secret: ''\nredirect_address: http://localhost/callback", `provider "github": field "client_secret": non-empty value is required`},
+		{"github redirect address", "github", "client_id: client\nclient_secret: secret\nredirect_address: ''", `provider "github": field "redirect_address": non-empty value is required`},
+		{"oidc client id", "oidc", "client_id: ''\nclient_secret: secret\nredirect_address: http://localhost/callback", `provider "foo": field "client_id": non-empty value is required`},
+		{"oidc client secret", "oidc", "client_id: client\nclient_secret: ''\nredirect_address: http://localhost/callback", `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc redirect address", "oidc", "client_id: client\nclient_secret: secret\nredirect_address: ''", `provider "foo": field "redirect_address": non-empty value is required`},
+		{"github valid", "github", "client_id: client\nclient_secret: secret\nredirect_address: http://localhost/callback", ""},
+		{"oidc valid", "oidc", "client_id: client\nclient_secret: secret\nredirect_address: http://localhost/callback", ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fields := strings.ReplaceAll(tt.fields, "\n", "\n      ")
+			if tt.method == "oidc" {
+				fields = "providers:\n        foo:\n          " + strings.ReplaceAll(tt.fields, "\n", "\n          ")
+			}
+			content := fmt.Sprintf("authentication:\n  session:\n    domain: localhost\n  methods:\n    %s:\n      enabled: true\n      %s\n", tt.method, fields)
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(content), 0600))
+			_, err := Load(path)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
