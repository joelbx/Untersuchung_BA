+    def test_public_edition_selected_after_loanable_editions(self):
+        editions = [
+            {
+                'key': '/books/OL1M',
+                'ocaid': 'loan1',
+                'ia_collection': ['lendinglibrary'],
+            },
+            {
+                'key': '/books/OL2M',
+                'ocaid': 'loan2',
+                'ia_collection': ['inlibrary'],
+            },
+            {
+                'key': '/books/OL3M',
+                'ocaid': 'open',
+                'ia_collection': ['americana'],
+            },
+            {
+                'key': '/books/OL4M',
+                'ocaid': 'pd1',
+                'ia_collection': ['printdisabled'],
+            },
+            {
+                'key': '/books/OL5M',
+                'ocaid': 'pd2',
+                'ia_collection': ['printdisabled'],
+            },
+        ]
+        doc = {}
+        SolrProcessor.add_ebook_info(doc, editions)
+
+        assert doc['public_scan_b'] is True
+        assert doc['lending_edition_s'] == 'OL3M'
+        assert doc['lending_identifier_s'] == 'open'
+        assert sss(doc['printdisabled_s']) == ['OL4M', 'OL5M']
+        assert set(doc['ia']) == {'loan1', 'loan2', 'open', 'pd1', 'pd2'}
+        assert sss(doc['ia_collection_s']) == [
+            'americana', 'inlibrary', 'lendinglibrary', 'printdisabled'
+        ]
+
+        doc = {}
+        SolrProcessor.add_ebook_info(doc, editions[:2])
+        assert doc['public_scan_b'] is False
+        assert doc['lending_edition_s'] == 'OL1M'
+        assert doc['lending_identifier_s'] == 'loan1'
+
     @pytest.mark.asyncio
     async def test_subjects(self):
         w = make_work(subjects=["a", "b c"])
