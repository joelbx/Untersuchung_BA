+class TestPatronCheckIns:
+    def setup_method(self):
+        self.checkins = patron_check_ins()
+
+    def test_update_requires_id_and_content(self):
+        assert self.checkins.is_valid({'id': 1, 'year': 2020})
+        assert self.checkins.is_valid({'id': 1, 'data': {}})
+        assert not self.checkins.is_valid({'id': 1, 'month': 2})
+        assert not self.checkins.is_valid({'year': 2020})
+        assert not self.checkins.is_valid({'data': {}})
+        assert not self.checkins.is_valid(None)
+
+    def test_post_updates_owned_event(self, monkeypatch):
+        calls = []
+        monkeypatch.setattr(checkins, 'get_current_user', lambda: {'key': '/people/alice'})
+        monkeypatch.setattr(
+            checkins.web,
+            'data',
+            lambda: json.dumps(
+                {
+                    'id': 3,
+                    'year': 2020,
+                    'month': 2,
+                    'day': 9,
+                    'data': {'note': 'read'},
+                }
+            ),
+        )
+        monkeypatch.setattr(
+            checkins.BookshelvesEvents,
+            'select_all_by_username',
+            lambda username: [{'id': 3, 'username': username}],
+        )
+        monkeypatch.setattr(
+            checkins.BookshelvesEvents,
+            'update_event_date',
+            lambda event_id, date: calls.append(('date', event_id, date)),
+        )
+        monkeypatch.setattr(
+            checkins.BookshelvesEvents,
+            'update_event_data',
+            lambda event_id, data: calls.append(('data', event_id, data)),
+        )
+
+        self.checkins.POST('alice')
+
+        assert calls == [
+            ('date', 3, '2020-02-09'),
+            ('data', 3, '{"note": "read"}'),
+        ]
+
+    def test_post_rejects_missing_content_before_lookup(self, monkeypatch):
+        monkeypatch.setattr(checkins, 'get_current_user', lambda: {'key': '/people/alice'})
+        monkeypatch.setattr(checkins.web, 'data', lambda: '{"id": 3, "month": 2}')
+        monkeypatch.setattr(
+            checkins.BookshelvesEvents,
+            'select_all_by_username',
+            lambda username: (_ for _ in ()).throw(AssertionError('unexpected lookup')),
+        )
+        monkeypatch.setattr(
+            checkins.web, 'badrequest', lambda **kwargs: kwargs['message']
+        )
+
+        assert self.checkins.POST('alice') == 'Invalid request'
