+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_restricted_before_rename(atomic_am, tmp_path, mocker):
+    src = str(tmp_path / 'source')
+    dest = str(tmp_path / 'destination')
+    with open(src, 'wb') as source:
+        source.write(b'secret')
+    os.chmod(src, 0o644)
+    atomic_am.selinux_enabled.return_value = False
+    real_rename = os.rename
+
+    def check_rename(source, destination):
+        assert stat.S_IMODE(os.stat(source).st_mode) == 0o600
+        real_rename(source, destination)
+
+    mocker.patch('os.rename', side_effect=check_rename)
+    atomic_am.atomic_move(src, dest)
+    assert stat.S_IMODE(os.stat(dest).st_mode) == 0o600
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_unsafe_new_file_restricted_before_copy(atomic_am, tmp_path, mocker):
+    src = str(tmp_path / 'source')
+    dest = str(tmp_path / 'destination')
+    with open(src, 'wb') as source:
+        source.write(b'secret')
+    real_copy = shutil.copyfileobj
+
+    def check_copy(source, destination):
+        assert stat.S_IMODE(os.stat(dest).st_mode) == 0o600
+        real_copy(source, destination)
+
+    mocker.patch('shutil.copyfileobj', side_effect=check_copy)
+    atomic_am._unsafe_writes(src, dest, creating=True)
+    with open(dest, 'rb') as destination:
+        assert destination.read() == b'secret'
+
