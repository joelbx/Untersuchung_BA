+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_default_mode_warning(atomic_am, atomic_mocks, mocker, monkeypatch, capfd):
+    monkeypatch.setattr(warnings, '_global_warnings', [])
+    atomic_am.argument_spec['mode'] = {'type': 'raw'}
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_mocks['umask'].side_effect = [18, 0, 18, 0]
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    atomic_am.atomic_move('/path/to/src', b'/path/to/other')
+
+    assert basic.DEFAULT_PERM == 0o600
+    assert atomic_mocks['chmod'].call_args_list == [mocker.call(b'/path/to/src', 0o600),
+                                                   mocker.call(b'/path/to/dest', 0o600),
+                                                   mocker.call(b'/path/to/src', 0o600),
+                                                   mocker.call(b'/path/to/other', 0o600)]
+    assert atomic_am._created_files == {b'/path/to/dest', b'/path/to/other'}
+
+    atomic_am._return_formatted({})
+    result = json.loads(capfd.readouterr()[0])
+    assert "File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." in result['warnings']
+    assert "File '/path/to/other' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." in result['warnings']
+    assert not atomic_am._created_files
+
