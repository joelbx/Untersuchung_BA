+func TestRedhatParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages = models.NewPackages(models.Package{Name: "libgcc", Version: "4.8.5", Release: "44.el7", Arch: "x86_64"})
+	out := `libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 44.el7 x86_64
+error: file /root/secret: Permission denied
+file /tmp/gone is not owned by any package
+error: file /tmp/gone: No such file or directory`
+	got, err := r.parseOwnerPkgs(out)
+	if err != nil || !reflect.DeepEqual(got, []string{"libgcc"}) {
+		t.Fatalf("parseOwnerPkgs() = %v, %v; want [libgcc], nil", got, err)
+	}
+	for _, line := range []string{"unrecognized output", "error: file unexpected output here"} {
+		if _, err := r.parseOwnerPkgs(line); err == nil {
+			t.Errorf("parseOwnerPkgs(%q) accepted malformed output", line)
+		}
+	}
+}
