+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationSessionDomain(t *testing.T) {
+	for _, tc := range []struct {
+		name, domain, want string
+	}{
+		{"scheme and port", "http://localhost:8080", "localhost"},
+		{"https and port", "https://example.com:8443", "example.com"},
+		{"host and port", "example.com:8080", "example.com"},
+		{"host", "localhost", "localhost"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tc.domain},
+				Methods: AuthenticationMethods{OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true}},
+			}
+			require.NoError(t, c.validate())
+			require.Equal(t, tc.want, c.Session.Domain)
+		})
+	}
+}
+
+func TestAuthenticationSessionDomainParseError(t *testing.T) {
+	c := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: "http://%"},
+		Methods: AuthenticationMethods{OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true}},
+	}
+	require.Error(t, c.validate())
+}
