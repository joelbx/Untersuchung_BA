diff --git a/internal/server/auth/method/oidc/http_internal_test.go b/internal/server/auth/method/oidc/http_internal_test.go
new file mode 100644
index 0000000..10bde65
--- /dev/null
+++ b/internal/server/auth/method/oidc/http_internal_test.go
@@ -0,0 +1,57 @@
+package oidc
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestStateCookieDomainAndPath(t *testing.T) {
+	for _, tc := range []struct {
+		domain, wantDomain string
+	}{
+		{"localhost", ""},
+		{"example.com", "example.com"},
+	} {
+		t.Run(tc.domain, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{Domain: tc.domain})
+			w := httptest.NewRecorder()
+			r := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			m.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(w, r)
+
+			cookies := w.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, stateCookieKey, cookies[0].Name)
+			require.Equal(t, tc.wantDomain, cookies[0].Domain)
+			require.Equal(t, "/auth/v1/method/oidc/google/callback", cookies[0].Path)
+		})
+	}
+}
+
+func TestTokenCookieLocalhost(t *testing.T) {
+	m := NewHTTPMiddleware(config.AuthenticationSession{Domain: "localhost"})
+	w := httptest.NewRecorder()
+	require.NoError(t, m.ForwardResponseOption(nil, w, &auth.CallbackResponse{ClientToken: "token"}))
+	cookies := w.Result().Cookies()
+	require.Len(t, cookies, 1)
+	require.Equal(t, tokenCookieKey, cookies[0].Name)
+	require.Empty(t, cookies[0].Domain)
+}
+
+func TestCallbackURL(t *testing.T) {
+	for _, tc := range []struct {
+		host, want string
+	}{
+		{"http://localhost:8080", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"https://example.com:8443/", "https://example.com:8443/auth/v1/method/oidc/google/callback"},
+		{"https://example.com//", "https://example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		t.Run(tc.host, func(t *testing.T) {
+			require.Equal(t, tc.want, callbackURL(tc.host, "google"))
+		})
+	}
+}
