diff --git a/lib/ai/model/tokencount.go b/lib/ai/model/tokencount.go
new file mode 100644
index 0000000..91e7560
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,164 @@
+package model
+
+import (
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// Ref: https://github.com/openai/openai-cookbook/blob/594fc6c952425810e9ea5bd1a275c8ca5f32e8f9/examples/How_to_count_tokens_with_tiktoken.ipynb
+const (
+	perMessage = 3
+	perRequest = 3
+	perRole    = 1
+)
+
+// TokenCounter reports a token count.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of counters.
+type TokenCounters []TokenCounter
+
+// CountAll sums the counters.
+func (c TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range c {
+		if !nilCounter(counter) {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount tracks prompt and completion tokens for an agent invocation.
+type TokenCount struct {
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount returns an empty token count.
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+
+// AddPromptCounter adds a prompt counter.
+func (c *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if !nilCounter(prompt) {
+		c.prompt = append(c.prompt, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion counter.
+func (c *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if !nilCounter(completion) {
+		c.completion = append(c.completion, completion)
+	}
+}
+
+func nilCounter(counter TokenCounter) bool {
+	switch c := counter.(type) {
+	case nil:
+		return true
+	case *StaticTokenCounter:
+		return c == nil
+	case *AsynchronousTokenCounter:
+		return c == nil
+	default:
+		return false
+	}
+}
+
+// CountAll returns the prompt and completion totals, in that order.
+func (c *TokenCount) CountAll() (int, int) {
+	return c.prompt.CountAll(), c.completion.CountAll()
+}
+
+// StaticTokenCounter holds a fixed count.
+type StaticTokenCounter struct{ count int }
+
+// TokenCount returns the fixed count.
+func (c *StaticTokenCounter) TokenCount() int { return c.count }
+
+// NewPromptTokenCounter counts the content and overhead of each prompt message.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	encoder := codec.NewCl100kBase()
+	counter := &StaticTokenCounter{}
+	for _, message := range messages {
+		tokens, _, err := encoder.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		counter.count += perMessage + perRole + len(tokens)
+	}
+	return counter, nil
+}
+
+// NewSynchronousTokenCounter counts a complete response and request overhead.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter counts a response while it is streamed.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter counts the starting fragment of a stream.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add records one streamed token.
+func (c *AsynchronousTokenCounter) Add() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count++
+	return nil
+}
+
+// setText counts the entire stream so token boundaries across chunks are handled correctly.
+func (c *AsynchronousTokenCounter) setText(text string) error {
+	tokens, _, err := codec.NewCl100kBase().Encode(text)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.finished {
+		c.count = len(tokens)
+	}
+	return nil
+}
+
+// streamingTokenCounter exposes the current count without ending the stream.
+// The receiver finalizes the underlying counter after its last update.
+type streamingTokenCounter struct{ counter *AsynchronousTokenCounter }
+
+func (c streamingTokenCounter) TokenCount() int {
+	c.counter.mu.Lock()
+	defer c.counter.mu.Unlock()
+	return perRequest + c.counter.count
+}
+
+// TokenCount finalizes the counter and returns its current total.
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
diff --git a/lib/ai/model/tokencount_test.go b/lib/ai/model/tokencount_test.go
new file mode 100644
index 0000000..f0ec148
--- /dev/null
+++ b/lib/ai/model/tokencount_test.go
@@ -0,0 +1,44 @@
+package model
+
+import (
+	"testing"
+
+	"github.com/sashabaranov/go-openai"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTokenCounters(t *testing.T) {
+	prompt, err := NewPromptTokenCounter([]openai.ChatCompletionMessage{
+		{Role: openai.ChatMessageRoleUser, Content: "Hello"},
+		{Role: openai.ChatMessageRoleAssistant, Content: "world"},
+	})
+	require.NoError(t, err)
+	require.Equal(t, 2*(perMessage+perRole)+2, prompt.TokenCount())
+
+	completion, err := NewSynchronousTokenCounter("Hello world")
+	require.NoError(t, err)
+	require.Equal(t, perRequest+2, completion.TokenCount())
+
+	counts := NewTokenCount()
+	counts.AddPromptCounter(nil)
+	counts.AddCompletionCounter(nil)
+	var nilStatic *StaticTokenCounter
+	counts.AddPromptCounter(nilStatic)
+	counts.AddCompletionCounter(nilStatic)
+	counts.AddPromptCounter(prompt)
+	counts.AddPromptCounter(prompt)
+	counts.AddCompletionCounter(completion)
+	require.Equal(t, 2*prompt.TokenCount(), counts.prompt.CountAll())
+	p, c := counts.CountAll()
+	require.Equal(t, 2*prompt.TokenCount(), p)
+	require.Equal(t, completion.TokenCount(), c)
+}
+
+func TestAsynchronousTokenCounter(t *testing.T) {
+	counter, err := NewAsynchronousTokenCounter("Hello")
+	require.NoError(t, err)
+	require.NoError(t, counter.Add())
+	require.Equal(t, perRequest+2, counter.TokenCount())
+	require.Equal(t, perRequest+2, counter.TokenCount())
+	require.Error(t, counter.Add())
+}
