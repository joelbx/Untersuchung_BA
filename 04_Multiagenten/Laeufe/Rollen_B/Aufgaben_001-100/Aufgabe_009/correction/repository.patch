+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-id', display_name: 'Work laptop', isVerified: false };
+
+    it('saves a changed name, including an empty string, and returns to read mode', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId, queryByTestId } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        const input = getByTestId('device-detail-heading-input') as HTMLInputElement;
+        expect(input.maxLength).toBe(100);
+        fireEvent.change(input, { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+
+        await waitFor(() => expect(getByTestId('device-detail-heading-read')).toBeTruthy());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', '');
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+    });
+
+    it('does not save an unchanged name or a cancelled edit', async () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-read').textContent).toContain('Work laptop'));
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Home PC' } });
+        fireEvent.click(getByTestId('device-detail-heading-cancel'));
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Work laptop');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('keeps the editor open and shows the required error when saving fails', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('network error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Home PC' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-error').textContent)
+            .toBe('Failed to set display name.'));
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+    });
+
+    it('shows progress while the save is pending', async () => {
+        let finishSave: () => void;
+        const saveDeviceName = jest.fn().mockImplementation(() => new Promise<void>(resolve => {
+            finishSave = resolve;
+        }));
+        const { getByTestId, container } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Home PC' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(container.getElementsByClassName('mx_Spinner').length).toBe(1);
+        expect((getByTestId('device-detail-heading-save') as HTMLButtonElement).disabled).toBe(true);
+        finishSave();
+        await waitFor(() => expect(getByTestId('device-detail-heading-read').textContent).toContain('Home PC'));
+    });
+
+    it('uses the device ID when the name is missing', () => {
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ device_id: 'device-id', isVerified: false }}
+            saveDeviceName={jest.fn()}
+        />);
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('device-id');
+    });
+
+    it('persists the device ID when it is entered as the name of an unnamed device', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ device_id: 'device-id', isVerified: false }}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        expect((getByTestId('device-detail-heading-input') as HTMLInputElement).value).toBe('device-id');
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+
+        await waitFor(() => expect(getByTestId('device-detail-heading-read')).toBeTruthy());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', 'device-id');
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(saveDeviceName).toHaveBeenCalledTimes(1);
+    });
+});
