new file mode 100644
index 0000000..684cc60
--- /dev/null
+++ b/src/components/views/settings/devices/DeviceDetailHeading.tsx
@@ -0,0 +1,108 @@
+/*
+Copyright 2022 The Matrix.org Foundation C.I.C.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { FormEvent, useEffect, useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [name, setName] = useState(device.display_name);
+    const [draft, setDraft] = useState('');
+    const [isEditing, setIsEditing] = useState(false);
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    useEffect(() => {
+        setName(device.display_name);
+    }, [device.device_id, device.display_name]);
+
+    const visibleName = name ?? device.device_id;
+
+    const startEditing = () => {
+        setDraft(visibleName);
+        setError(undefined);
+        setIsEditing(true);
+    };
+
+    const cancelEditing = () => {
+        setError(undefined);
+        setIsEditing(false);
+    };
+
+    const save = async (event: FormEvent<HTMLFormElement>) => {
+        event.preventDefault();
+        if (isSaving) return;
+        if (draft === name) {
+            setIsEditing(false);
+            return;
+        }
+
+        setIsSaving(true);
+        setError(undefined);
+        try {
+            await saveDeviceName(device.device_id, draft);
+            setName(draft);
+            setIsEditing(false);
+        } catch (error) {
+            setError('Failed to set display name.');
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (isEditing) {
+        return <form className='mx_DeviceDetailHeading_edit' data-testid='device-detail-heading-edit' onSubmit={save}>
+            <label htmlFor={`device-name-${device.device_id}`}>{ _t('Session name') }</label>
+            <input
+                id={`device-name-${device.device_id}`}
+                data-testid='device-detail-heading-input'
+                type='text'
+                value={draft}
+                maxLength={100}
+                onChange={event => setDraft(event.target.value)}
+                disabled={isSaving}
+                autoFocus
+            />
+            <p>{ _t("A device's name is visible to people you communicate with.") }</p>
+            { error && <p role='alert' data-testid='device-detail-heading-error'>{ error }</p> }
+            <div className='mx_DeviceDetailHeading_actions'>
+                <button type='submit' data-testid='device-detail-heading-save' disabled={isSaving}>
+                    { _t('Save') }
+                </button>
+                <button type='button' data-testid='device-detail-heading-cancel' onClick={cancelEditing} disabled={isSaving}>
+                    { _t('Cancel') }
+                </button>
+                { isSaving && <Spinner w={16} h={16} /> }
+            </div>
+        </form>;
+    }
+
+    return <div className='mx_DeviceDetailHeading' data-testid='device-detail-heading-read'>
+        <Heading size='h3'>{ visibleName }</Heading>
+        <AccessibleButton kind='link_inline' onClick={startEditing} data-testid='device-detail-heading-rename'>
+            { _t('Rename') }
+        </AccessibleButton>
+    </div>;
+};
