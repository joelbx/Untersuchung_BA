+import punycode from 'punycode.js';
+
 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
 
+/** Return the domain label immediately before the top-level domain. */
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(
+        /^(?:(?:[a-z][a-z\d+.-]*:)?\/\/)?(?:[^/?#@]*@)?(?:[^/?#.:]+\.)*([^/?#.:]+)\.[^/?#.:]+(?::\d+)?(?:[/?#]|$)/i
+    );
+    return match?.[1] || '';
+};
+
+/** Encode only the hostname, leaving the rest of the URL as it was supplied. */
+export const punycodeUrl = (url: string): string => {
+    const match = url.match(/^((?:[a-z][a-z\d+.-]*:)?\/\/)([^/?#]+)([\s\S]*)$/i);
+    if (!match) {
+        return url;
+    }
+
+    const [, protocol, authority, remainder] = match;
+    const userInfoEnd = authority.lastIndexOf('@') + 1;
+    const userInfo = authority.slice(0, userInfoEnd);
+    const hostAndPort = authority.slice(userInfoEnd);
+    const hostMatch = hostAndPort.match(/^(\[[^\]]+\]|[^:]+)(:\d+)?$/);
+    if (!hostMatch) {
+        return url;
+    }
+
+    const [, hostname, port = ''] = hostMatch;
+    return `${protocol}${userInfo}${
+        hostname.startsWith('[') ? hostname : punycode.toASCII(hostname)
+    }${port}${remainder}`;
+};
