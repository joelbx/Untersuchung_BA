+import { createRef } from 'react';
+
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { MailSettings } from '@proton/shared/lib/interfaces';
+
+import { useLinkHandler } from './useLinkHandler';
+
+const mockCreateNotification = jest.fn();
+
+jest.mock('../components', () => ({ useModalState: () => [{ open: false }, jest.fn()] }));
+jest.mock('../components/notifications/LinkConfirmationModal', () => () => null);
+jest.mock('./index', () => ({
+    useHandler: (handler: unknown) => handler,
+    useNotifications: () => ({ createNotification: mockCreateNotification }),
+}));
+
+describe('useLinkHandler', () => {
+    beforeEach(() => {
+        mockCreateNotification.mockClear();
+    });
+
+    it('encodes an external link before navigation when confirmation is disabled', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        anchor.setAttribute('href', 'https://www.аррӏе.com/путь?q=кошка#я');
+        wrapper.appendChild(anchor);
+        const ref = createRef<HTMLDivElement>();
+        Object.defineProperty(ref, 'current', { value: wrapper });
+
+        renderHook(() => useLinkHandler(ref, { ConfirmLink: 0 } as MailSettings));
+        act(() => {
+            anchor.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
+        });
+
+        expect(anchor.getAttribute('href')).toBe('https://www.xn--80ak6aa92e.com/путь?q=кошка#я');
+    });
+
+    it('reports a link without an extractable URL', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        wrapper.appendChild(anchor);
+        const ref = createRef<HTMLDivElement>();
+        Object.defineProperty(ref, 'current', { value: wrapper });
+
+        renderHook(() => useLinkHandler(ref));
+        const event = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(event);
+        });
+
+        expect(event.defaultPrevented).toBe(true);
+        expect(mockCreateNotification).toHaveBeenCalledWith(expect.objectContaining({ type: 'error' }));
+    });
+});
