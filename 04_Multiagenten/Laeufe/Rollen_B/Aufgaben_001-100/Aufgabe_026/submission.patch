+func TestUbuntuContentPriority(t *testing.T) {
+	contents := NewCveContents(
+		CveContent{Type: Nvd, SourceLink: "nvd", Cpes: []Cpe{{}}, References: References{{Link: "nvd"}}, CweIDs: []string{"NVD"}},
