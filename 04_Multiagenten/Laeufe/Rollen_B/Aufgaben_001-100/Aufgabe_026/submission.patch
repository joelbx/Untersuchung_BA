+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestIsCveInfoUpdatedUbuntuAPI(t *testing.T) {
+	cveID := "CVE-2024-0001"
+	result := func(modified time.Time) models.ScanResult {
+		return models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{
+			cveID: {CveContents: models.NewCveContents(models.CveContent{Type: models.UbuntuAPI, LastModified: modified})},
+		}}
+	}
+	previous := result(time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC))
+	current := result(time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC))
+	if !isCveInfoUpdated(cveID, previous, current) {
+		t.Fatal("UbuntuAPI modification was not detected")
+	}
+}
