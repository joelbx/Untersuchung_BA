+func TestUbuntuGostDetails(t *testing.T) {
+	v := VulnInfo{CveContents: NewCveContents(
+		CveContent{Type: Ubuntu, Summary: "OVAL summary"},
+		CveContent{Type: UbuntuAPI, Summary: "Gost summary", Cvss3Severity: "NEGLIGIBLE"},
+		CveContent{Type: Nvd, Summary: "NVD summary"},
+	)}
+	if got, want := v.Summaries("en", "ubuntu"), []CveContentStr{{Ubuntu, "OVAL summary"}, {UbuntuAPI, "Gost summary"}, {Nvd, "NVD summary"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("summaries: got %v, want %v", got, want)
+	}
+	if got := v.Titles("en", "ubuntu"); len(got) < 3 || got[1].Type != Ubuntu || got[2].Type != UbuntuAPI {
+		t.Errorf("titles: got %v", got)
+	}
+	if got, want := v.Cvss3Scores(), []CveContentCvss{{Type: UbuntuAPI, Value: Cvss{Type: CVSS3, Score: 3.9, CalculatedBySeverity: true, Severity: "NEGLIGIBLE"}}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("CVSS: got %v, want %v", got, want)
+	}
+	if got := severityToCvssScoreRange("negligible"); got != "0.1-3.9" {
+		t.Errorf("range: got %s", got)
+	}
+}
