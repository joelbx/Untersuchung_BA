+	)
+	if got, want := contents.PrimarySrcURLs("en", "ubuntu", "CVE-1", nil), []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "oval"}, {UbuntuAPI, "gost"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("URLs: got %v, want %v", got, want)
+	}
+	for name, got := range map[string][]CveContentType{
