+func referenceErrors(file string, root *yamlv3.Node) []error {
+	var issues []error
+	namespace := value(field(root, "namespace"))
+	if namespace == "" {
+		namespace = "default"
+	}
+	segments := map[string]bool{}
+	for _, s := range items(field(root, "segments")) {
+		segments[value(field(s, "key"))] = true
+	}
+	add := func(flag string, index int, kind string, n *yamlv3.Node) {
+		if n == nil || n.Kind != yamlv3.ScalarNode || n.Value == "" {
+			return
+		}
+		issues = append(issues, Error{
+			Message:  fmt.Sprintf("flag %s/%s rule %d references unknown %s %q", namespace, flag, index, kind, n.Value),
+			Location: Location{File: file, Line: n.Line, Column: n.Column},
+		})
 	}
+	checkSegment := func(flag string, index int, segment *yamlv3.Node) {
+		if segment == nil {
+			return
+		}
+		if segment.Kind == yamlv3.MappingNode {
+			if key := field(segment, "key"); key != nil && !segments[key.Value] {
+				add(flag, index, "segment", key)
+			}
+			for _, key := range items(field(segment, "keys")) {
+				if !segments[key.Value] {
