+				}
+			}
+		} else if !segments[segment.Value] {
+			add(flag, index, "segment", segment)
+		}
+	}
+	for _, f := range items(field(root, "flags")) {
+		flag := value(field(f, "key"))
+		variants := map[string]bool{}
+		for _, variant := range items(field(f, "variants")) {
+			variants[value(field(variant, "key"))] = true
+		}
+		for i, rule := range items(field(f, "rules")) {
+			checkSegment(flag, i+1, field(rule, "segment"))
+			for _, dist := range items(field(rule, "distributions")) {
+				variant := field(dist, "variant")
+				if variant != nil && !variants[variant.Value] {
+					add(flag, i+1, "variant", variant)
+				}
+			}
+		}
+		for i, rollout := range items(field(f, "rollouts")) {
+			checkSegment(flag, i+1, field(rollout, "segment"))
+		}
+	}
+	return issues
+}
 
