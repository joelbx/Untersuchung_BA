new file mode 100644
index 0000000..9ad0605
--- /dev/null
+++ b/internal/storage/fs/snapshot_validation_test.go
@@ -0,0 +1,49 @@
+package fs
+
+import (
+	"testing"
+	"testing/fstest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/cue"
+	"go.uber.org/zap"
+)
+
+func TestSnapshotRejectsUnknownReferences(t *testing.T) {
+	data := []byte("namespace: default\nflags:\n- key: flag\n  name: Flag\n  variants: []\n  rules:\n  - segment: missing-segment\n    distributions:\n    - variant: missing-variant\n      rollout: 100\nsegments: []\n")
+	files := fstest.MapFS{"features.yaml": &fstest.MapFile{Data: data}}
+	for _, build := range []struct {
+		name string
+		fn   func() error
+	}{
+		{"paths", func() error { _, err := SnapshotFromPaths(files, "features.yaml"); return err }},
+		{"fs", func() error { _, err := SnapshotFromFS(zap.NewNop(), files); return err }},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			issues, ok := cue.Unwrap(build.fn())
+			require.True(t, ok)
+			require.Len(t, issues, 2)
+			assert.EqualError(t, issues[0], "flag default/flag rule 1 references unknown segment \"missing-segment\" (features.yaml 7:14)")
+			assert.EqualError(t, issues[1], "flag default/flag rule 1 references unknown variant \"missing-variant\" (features.yaml 9:16)")
+		})
+	}
+}
+
+func TestSnapshotRejectsInvalidSchema(t *testing.T) {
+	files := fstest.MapFS{"features.yaml": &fstest.MapFile{Data: []byte("flags: []\nsegments: []\nversion: 'invalid'\n")}}
+	for _, build := range []struct {
+		name string
+		fn   func() error
+	}{
+		{"paths", func() error { _, err := SnapshotFromPaths(files, "features.yaml"); return err }},
+		{"fs", func() error { _, err := SnapshotFromFS(zap.NewNop(), files); return err }},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			issues, ok := cue.Unwrap(build.fn())
+			require.True(t, ok)
+			require.NotEmpty(t, issues)
+			assert.Contains(t, issues[0].Error(), "version")
+		})
+	}
+}
