+func TestSnapshotRejectsInvalidSchema(t *testing.T) {
+	files := fstest.MapFS{"features.yaml": &fstest.MapFile{Data: []byte("flags: []\nsegments: []\nversion: 'invalid'\n")}}
+	for _, build := range []struct {
+		name string
+		fn   func() error
+	}{
+		{"paths", func() error { _, err := SnapshotFromPaths(files, "features.yaml"); return err }},
+		{"fs", func() error { _, err := SnapshotFromFS(zap.NewNop(), files); return err }},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			issues, ok := cue.Unwrap(build.fn())
+			require.True(t, ok)
+			require.NotEmpty(t, issues)
+			assert.Contains(t, issues[0].Error(), "version")
+		})
+	}
+}
