@@ -51,3 +51,28 @@ func TestValidateBooleanRuleSegment(t *testing.T) {
 	require.True(t, ok)
 	assert.Contains(t, fmt.Sprint(issues), "flag default/enabled rule 1 references unknown segment \"absent\"")
 }
+
+func TestValidateBooleanRolloutSegments(t *testing.T) {
+	data := []byte("version: '1.2'\nflags:\n- key: enabled\n  name: Enabled\n  type: BOOLEAN_FLAG_TYPE\n  variants: []\n  rules: []\n  rollouts:\n  - segment:\n      key: missing\n      value: true\n  - segment:\n      keys: [known, absent]\n      value: false\nsegments:\n- key: known\n  name: Known\n  match_type: ALL_MATCH_TYPE\n")
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	issues, ok := Unwrap(validator.Validate("boolean.yaml", data))
+	require.True(t, ok)
+	require.Len(t, issues, 2)
+	assert.EqualError(t, issues[0], "flag default/enabled rule 1 references unknown segment \"missing\" (boolean.yaml 10:12)")
+	assert.EqualError(t, issues[1], "flag default/enabled rule 2 references unknown segment \"absent\" (boolean.yaml 13:21)")
+}
+
+func TestValidateMalformedYAML(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	issues, ok := Unwrap(validator.Validate("broken.yaml", []byte("flags:\n  - key: [\n")))
+	require.True(t, ok)
+	require.NotEmpty(t, issues)
+	var issue Error
+	require.ErrorAs(t, issues[0], &issue)
+	assert.Equal(t, "broken.yaml", issue.Location.File)
+	assert.Positive(t, issue.Location.Line)
+	assert.Positive(t, issue.Location.Column)
+	assert.Contains(t, issue.Error(), "(broken.yaml ")
+}
