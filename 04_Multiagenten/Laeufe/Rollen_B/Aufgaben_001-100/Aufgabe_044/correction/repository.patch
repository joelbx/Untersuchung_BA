+++ b/internal/server/authz/authz.go
@@ -1,8 +1,35 @@
 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey string
+
+// NamespacesKey holds the namespaces visible to the authenticated caller.
+const NamespacesKey contextKey = "namespaces"
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
+
+// FormatNamespaces validates the result of a viewable_namespaces decision.
+func FormatNamespaces(result any) ([]string, error) {
+	values, ok := result.([]any)
+	if !ok {
+		return nil, fmt.Errorf("invalid viewable_namespaces result: expected array, got %T", result)
+	}
+
+	namespaces := make([]string, 0, len(values))
+	for _, value := range values {
+		name, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("invalid viewable_namespaces entry: expected string, got %T", value)
+		}
+		namespaces = append(namespaces, name)
+	}
+	return namespaces, nil
+}
