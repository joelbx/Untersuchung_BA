+    def test_timeout_writes_final_result(self, tmp_path):
+        module = tmp_path / 'slow_module.py'
+        module.write_text('#!/usr/bin/env python\nimport time\ntime.sleep(10)\nprint("{}")\n')
+        jobdir = tmp_path / 'jobs'
+        env = os.environ.copy()
+        env['PYTHONPATH'] = os.path.join(os.getcwd(), 'lib')
+        env['ANSIBLE_ASYNC_DIR'] = str(jobdir)
+
+        completed = subprocess.run(
+            [sys.executable, '-m', 'ansible.modules.async_wrapper', 'testjob', '1', str(module), '_'],
+            env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=8,
+        )
+        assert completed.returncode == 0
+        assert not completed.stderr
+        immediate = json.loads(completed.stdout)
+        assert immediate['started'] == 1
+        assert immediate['finished'] == 0
+
+        deadline = time.time() + 5
+        while time.time() < deadline:
+            with open(immediate['results_file']) as f:
+                result = json.load(f)
+            if result['finished']:
+                break
+            time.sleep(0.1)
+        else:
+            pytest.fail('async job did not finish after timeout')
+
+        assert result['failed'] == 1
+        assert result['ansible_job_id'] == immediate['ansible_job_id']
+        assert result['started'] == 1
+        assert result['finished'] == 1
+        assert result['child_pid'] > 0
+
