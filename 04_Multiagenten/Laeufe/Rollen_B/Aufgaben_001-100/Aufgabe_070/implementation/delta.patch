@@ -450,15 +458,47 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     Format language data to match Open Library's expected format.
     For an input of ["eng", "fre"], return:
     [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+
+    Accept MARC codes, ISO 639-1 codes, and language names. Return each
+    resolved language once, in the order it first appears.
     """
     if not languages:
         return []
 
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        identifier = language.strip().casefold()
+        # Existing MARC keys take precedence over names and alternate codes.
+        code = identifier if web.ctx.site.get(f'/languages/{identifier}') else None
+        records = None
+        if code is None and len(identifier) == 2:
+            records = get_languages().values()
+            iso_matches = {
+                record.code
+                for record in records
+                if record.get('identifiers', {}).get('iso_639_1', [None])[0]
+                == identifier
+            }
+            if len(iso_matches) > 1:
+                raise InvalidLanguage(identifier)
+            code = next(iter(iso_matches), None)
+        if code is None:
+            code = get_marc21_language(identifier)
+        if code is None:
+            # Language records include native and translated names.
+            try:
+                code = get_abbrev_from_full_lang_name(
+                    language, records or get_languages().values()
+                )
+            except (LanguageNoMatchError, LanguageMultipleMatchError):
+                raise InvalidLanguage(identifier) from None
+
+        key = f'/languages/{code}'
+        if web.ctx.site.get(key) is None:
+            raise InvalidLanguage(identifier)
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
