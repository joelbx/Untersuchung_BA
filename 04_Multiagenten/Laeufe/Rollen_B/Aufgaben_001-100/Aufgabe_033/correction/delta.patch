+// The current webassets bundle passes the whole sign request as one key in
+// both login and password change flows. Expand the list after it loads.
+const u2fMultiDeviceScript = `<script>
+(function () {
+  if (!window.u2f || !window.u2f.sign) return;
+  var sign = window.u2f.sign;
+  window.u2f.sign = function (appId, challenge, keys, callback, timeout) {
+    if (keys && keys.length === 1 && Array.isArray(keys[0].challenges) && keys[0].challenges.length) {
+      keys = keys[0].challenges;
+    }
+    return sign.call(this, appId, challenge, keys, callback, timeout);
+  };
+}());
+</script>`
+
 // Handler is HTTP web proxy handler
