 // TestErrorResponse verifies writing error response.
 func TestErrorResponse(t *testing.T) {
-	b := &bytes.Buffer{}
-
-	err := WriteErrorResponse(b, trace.AccessDenied("access denied"))
-	require.NoError(t, err)
+	for _, tt := range []struct {
+		name   string
+		err    error
+		number uint32
+	}{
+		{name: "agent error", err: trace.AccessDenied("access denied"), number: errorNumber},
+		{name: "invalid user", err: trace.Wrap(mssql.Error{Number: 18456}), number: 18456},
+		{name: "invalid database", err: trace.Wrap(mssql.Error{Number: 4060}), number: 4060},
+		{name: "missing database", err: trace.Wrap(mssql.Error{Number: 911}), number: 911},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			b := &bytes.Buffer{}
+			require.NoError(t, WriteErrorResponse(b, tt.err))
+			packet, err := ReadPacket(b)
+			require.NoError(t, err)
+			require.Equal(t, PacketTypeResponse, packet.Type())
+			require.GreaterOrEqual(t, len(packet.Data()), 7)
+			require.Equal(t, byte(0xaa), packet.Data()[0]) // TDS ERROR token.
+			require.Equal(t, tt.number, binary.LittleEndian.Uint32(packet.Data()[3:7]))
+		})
+	}
 }
 
