+func TestLoadEnvReferences(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(path, []byte(`server:
+  http_port: ${CONFIG_PORT}
+log:
+  encoding: ${CONFIG_ENCODING}
+  file: ${CONFIG_FILE}
+`), 0600))
+	t.Setenv("CONFIG_PORT", "8081")
+	t.Setenv("CONFIG_ENCODING", "json")
+	t.Setenv("CONFIG_FILE", "events.log")
+
+	res, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8081, res.Config.Server.HTTPPort)
+	assert.Equal(t, LogEncodingJSON, res.Config.Log.Encoding)
+	assert.Equal(t, "events.log", res.Config.Log.File)
+
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "9090")
+	t.Setenv("FLIPT_LOG_ENCODING", "console")
+	res, err = Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 9090, res.Config.Server.HTTPPort)
+	assert.Equal(t, LogEncodingConsole, res.Config.Log.Encoding)
+}
