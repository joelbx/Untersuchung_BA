+func TestEnvSubstitutionHook(t *testing.T) {
+	t.Setenv("CONFIG_VALUE", "resolved")
+	t.Setenv("_CONFIG_2", "")
+
+	hook := envSubstitutionHookFunc().(func(reflect.Kind, reflect.Kind, interface{}) (interface{}, error))
+	for _, tt := range []struct {
+		name  string
+		from  reflect.Kind
+		input interface{}
+		want  interface{}
+	}{
+		{"set variable", reflect.String, "${CONFIG_VALUE}", "resolved"},
+		{"empty variable", reflect.String, "${_CONFIG_2}", ""},
+		{"unset variable", reflect.String, "${CONFIG_MISSING}", "${CONFIG_MISSING}"},
+		{"embedded reference", reflect.String, "prefix-${CONFIG_VALUE}", "prefix-${CONFIG_VALUE}"},
+		{"trailing text", reflect.String, "${CONFIG_VALUE}-suffix", "${CONFIG_VALUE}-suffix"},
+		{"invalid first character", reflect.String, "${1CONFIG}", "${1CONFIG}"},
+		{"invalid character", reflect.String, "${CONFIG-VALUE}", "${CONFIG-VALUE}"},
+		{"named string", reflect.String, LogEncodingJSON, LogEncodingJSON},
+		{"non-string", reflect.Int, 42, 42},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(tt.from, reflect.String, tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
