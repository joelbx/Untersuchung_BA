+var envReference = regexp.MustCompile(`^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$`)
+
+// envSubstitutionHookFunc resolves YAML values that reference an environment variable.
+func envSubstitutionHookFunc() mapstructure.DecodeHookFunc {
+	return func(from reflect.Kind, to reflect.Kind, data interface{}) (interface{}, error) {
+		if from != reflect.String {
+			return data, nil
+		}
+
+		return resolveEnvReference(data), nil
+	}
+}
+
+func resolveEnvReference(data interface{}) interface{} {
+	value, ok := data.(string)
+	if !ok {
+		return data
+	}
+	if matches := envReference.FindStringSubmatch(value); matches != nil {
+		if replacement, ok := os.LookupEnv(matches[1]); ok {
+			return replacement
+		}
+	}
+	return data
+}
+
+// resolveConfigEnvReferences updates parsed file values before defaults and
+// experimental flags are read from Viper.
+func resolveConfigEnvReferences(data interface{}) interface{} {
+	switch value := data.(type) {
+	case map[string]interface{}:
+		for key, item := range value {
+			value[key] = resolveConfigEnvReferences(item)
+		}
+	case []interface{}:
+		for i, item := range value {
+			value[i] = resolveConfigEnvReferences(item)
+		}
+	default:
+		return resolveEnvReference(data)
+	}
+	return data
+}
