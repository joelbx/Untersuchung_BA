     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    @pytest.mark.parametrize(
+        ('annotation', 'tokens', 'expected'),
+        [
+            (list[int], ['1', '2', '3'], [1, 2, 3]),
+            (list[str], ['a', 'b'], ['a', 'b']),
+            (list[float], ['1.5', '2.25'], [1.5, 2.25]),
+            (list[Path], ['a.txt', 'b.txt'], [Path('a.txt'), Path('b.txt')]),
+        ],
+    )
+    def test_required_typed_list(self, annotation, tokens, expected):
+        def fn(values):
+            return values
+
+        fn.__annotations__['values'] = annotation
+        cli = FnToCLI(fn)
+        assert cli.parse_args(tokens).values == expected
+        assert cli.run() == expected
+
+    def test_path_and_named_list_option(self):
+        def fn(source: Path, files: list[Path] | None = None):
+            return source, files
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args(['source.txt', '--files', 'one.txt', 'two.txt']).files == [
+            Path('one.txt'),
+            Path('two.txt'),
+        ]
+        assert cli.run() == (
+            Path('source.txt'),
+            [Path('one.txt'), Path('two.txt')],
+        )
+        assert cli.parse_args(['source.txt']).files is None
+        assert cli.run() == (Path('source.txt'), None)
+
+    def test_optional_list_without_python_default(self):
+        def fn(files: list[int] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args([]).files is None
+        assert cli.run() is None
+        assert cli.parse_args(['--files', '1', '2']).files == [1, 2]
+        assert cli.run() == [1, 2]
+
+    def test_option_name_matches_parameter(self):
+        def fn(x: int = 1, file_paths: list[str] | None = None):
+            return x, file_paths
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args(['--x', '3', '--file_paths', 'a', 'b']).x == 3
+        assert cli.run() == (3, ['a', 'b'])
+        assert cli.parse_args(['--file_paths', 'a', 'b', '--x', '4']).file_paths == [
+            'a',
+            'b',
+        ]
+        assert cli.run() == (4, ['a', 'b'])
+
+    def test_async_result(self):
+        async def fn(path: Path):
+            return path
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['file.txt'])
+        assert cli.run() == Path('file.txt')
+
+    def test_list_with_default(self):
+        def fn(numbers: list[int] = [1]):  # noqa: B006 - exercise a list default
+            return numbers
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args(()).numbers == [1]
+        assert cli.parse_args(['--numbers', '2', '3']).numbers == [2, 3]
+        assert cli.run() == [2, 3]
