+func Test_redhatBase_sourceRPMFilename(t *testing.T) {
+	tests := []struct {
+		name       string
+		line       string
+		repoquery  bool
+		wantBin    *models.Package
+		wantSource *models.SrcPackage
+		wantWarn   bool
+	}{
+		{
+			name:     "nonstandard source filename",
+			line:     "elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)",
+			wantBin:  &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"},
+			wantWarn: true,
+		},
+		{
+			name:     "nonstandard filename with hyphenated name",
+			line:     "some-plugin 0 8.17.0 1 x86_64 some-plugin-8.17.0-1-src.rpm",
+			wantBin:  &models.Package{Name: "some-plugin", Version: "8.17.0", Release: "1", Arch: "x86_64"},
+			wantWarn: true,
+		},
+		{
+			name:       "source filename with epoch",
+			line:       "bar 1 9 123a ia64 1:bar-9-123a.src.rpm",
+			wantBin:    &models.Package{Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64"},
+			wantSource: &models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}},
+		},
+		{
+			name:       "source filename epoch with zero binary epoch",
+			line:       "bar 0 9 123a ia64 1:bar-9-123a.src.rpm",
+			wantBin:    &models.Package{Name: "bar", Version: "9", Release: "123a", Arch: "ia64"},
+			wantSource: &models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}},
+		},
+		{
+			name:      "repoquery nonstandard source filename",
+			line:      "elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm @custom",
+			repoquery: true,
+			wantBin:   &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64", Repository: "custom"},
+			wantWarn:  true,
+		},
+		{
+			name:       "repoquery source filename with epoch",
+			line:       "bar 1 9 123a ia64 1:bar-9-123a.src.rpm @custom",
+			repoquery:  true,
+			wantBin:    &models.Package{Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64", Repository: "custom"},
+			wantSource: &models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}},
+		},
+		{
+			name:       "repoquery source filename epoch differs from binary epoch",
+			line:       "bar 2 9 123a ia64 1:bar-9-123a.src.rpm @custom",
+			repoquery:  true,
+			wantBin:    &models.Package{Name: "bar", Version: "2:9", Release: "123a", Arch: "ia64", Repository: "custom"},
+			wantSource: &models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var bin *models.Package
+			var source *models.SrcPackage
+			var err error
+			if tt.repoquery {
+				bin, source, err = o.parseInstalledPackagesLineFromRepoquery(tt.line)
+			} else {
+				bin, source, err = o.parseInstalledPackagesLine(tt.line)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(bin, tt.wantBin) || !reflect.DeepEqual(source, tt.wantSource) {
+				t.Errorf("got binary %v, source %v; want binary %v, source %v", bin, source, tt.wantBin, tt.wantSource)
+			}
+			if tt.wantWarn {
+				if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "unexpected file name") {
+					t.Errorf("warnings = %v; want source filename warning", o.warns)
+				}
+			} else if len(o.warns) != 0 {
+				t.Errorf("unexpected warnings: %v", o.warns)
+			}
+		})
+	}
+}
+
+func Test_redhatBase_parseInstalledPackagesContinuesAfterSourceFilenameWarning(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Alma, Release: "9.0"}}}
+	bins, sources, err := o.parseInstalledPackages("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(bins) != 2 || bins["elasticsearch"].Version != "8.17.0" || bins["bar"].Version != "1:9" {
+		t.Errorf("binary packages = %v", bins)
+	}
+	if len(sources) != 1 || sources["bar"].Name != "bar" || !reflect.DeepEqual(sources["bar"].BinaryNames, []string{"bar"}) {
+		t.Errorf("source packages = %v", sources)
+	}
+	if len(o.warns) != 1 {
+		t.Errorf("warnings = %v; want one", o.warns)
+	}
+}
