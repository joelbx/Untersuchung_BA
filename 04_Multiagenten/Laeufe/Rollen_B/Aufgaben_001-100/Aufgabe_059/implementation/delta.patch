+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes and the ref to a supported native dialog', () => {
+        const prototype = HTMLDialogElement.prototype;
+        const showModal = Object.getOwnPropertyDescriptor(prototype, 'showModal');
+        const close = Object.getOwnPropertyDescriptor(prototype, 'close');
+        Object.defineProperty(prototype, 'showModal', { configurable: true, value: jest.fn() });
+        Object.defineProperty(prototype, 'close', { configurable: true, value: jest.fn() });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByRole } = render(
+                <Dialog ref={ref} open aria-label="Native example" data-testid="native-host">
+                    <button type="button">Hello</button>
+                </Dialog>
+            );
+
+            const host = getByRole('dialog', { name: 'Native example' });
+            expect(host.tagName).toBe('DIALOG');
+            expect(host).toHaveAttribute('open');
+            expect(host).toHaveAttribute('data-testid', 'native-host');
+            expect(ref.current).toBe(host);
+            expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+        } finally {
+            if (showModal) {
+                Object.defineProperty(prototype, 'showModal', showModal);
+            } else {
+                Reflect.deleteProperty(prototype, 'showModal');
+            }
+            if (close) {
+                Object.defineProperty(prototype, 'close', close);
+            } else {
+                Reflect.deleteProperty(prototype, 'close');
+            }
+        }
+    });
+
+    it('uses an accessible fallback when dialog methods are unavailable', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole } = render(
+            <Dialog ref={ref} open aria-label="Example" data-testid="host" className="example">
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(host.tagName).toBe('DIV');
+        expect(host).toHaveAttribute('data-testid', 'host');
+        expect(host).toHaveClass('example');
+        expect(ref.current).toBe(host);
+        expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
new file mode 100644
index 0000000..93328fa
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,31 @@
+import { HTMLAttributes, Ref, forwardRef } from 'react';
+
+interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props, ref): JSX.Element => {
+    const supportsDialog =
+        typeof HTMLDialogElement !== 'undefined' &&
+        typeof HTMLDialogElement.prototype.showModal === 'function' &&
+        typeof HTMLDialogElement.prototype.close === 'function';
+
+    if (supportsDialog) {
+        return <dialog {...props} ref={ref} />;
+    }
+
+    const { open, hidden, ...rest } = props;
+
+    return (
+        <div
+            role="dialog"
+            {...(rest as unknown as HTMLAttributes<HTMLDivElement>)}
+            hidden={hidden || !open}
+            ref={ref as Ref<HTMLDivElement>}
+        />
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
