+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import * as React from "react";
+import { shallow } from "enzyme";
+
+import { mkEvent } from "../../../test-utils";
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import DisambiguatedProfile from "../../../../src/components/views/messages/DisambiguatedProfile";
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+
+describe("ReplyPreview", () => {
+    it("identifies the reply target and offers a named cancel action", () => {
+        const event = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:server",
+            user: "@alice:server",
+            content: { msgtype: "m.text", body: "Hello" },
+            ts: Date.now(),
+        });
+        const wrapper = shallow(<ReplyPreview replyToEvent={event} permalinkCreator={null} />);
+
+        expect(wrapper.find(".mx_ReplyPreview_header").text()).toContain("Replying to");
+        expect(wrapper.find(DisambiguatedProfile).prop("fallbackName")).toBe("@alice:server");
+        expect(wrapper.find(DisambiguatedProfile).prop("element")).toBe("span");
+        expect(wrapper.find(CancelButton).prop("aria-label")).toBe("Cancel reply");
+    });
+});
