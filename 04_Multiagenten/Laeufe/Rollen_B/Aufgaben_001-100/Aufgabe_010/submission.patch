+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import * as React from "react";
+import { shallow } from "enzyme";
+
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+import AccessibleButton from "../../../../src/components/views/elements/AccessibleButton";
+
+describe("CancelButton", () => {
+    it("uses a named, configurable AccessibleButton", () => {
+        const onClick = jest.fn();
+        const wrapper = shallow(<CancelButton onClick={onClick} />);
+
+        expect(wrapper.find(AccessibleButton).prop("aria-label")).toBe("Cancel");
+        expect(wrapper.find(AccessibleButton).prop("style")).toEqual({ "--cancel-button-size": "16px" });
+
+        wrapper.setProps({ "size": "24", "aria-label": "Cancel reply" });
+        expect(wrapper.find(AccessibleButton).prop("aria-label")).toBe("Cancel reply");
+        expect(wrapper.find(AccessibleButton).prop("style")).toEqual({ "--cancel-button-size": "24px" });
+        wrapper.find(AccessibleButton).prop("onClick")();
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+});
