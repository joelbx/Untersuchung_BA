+def test_check_qt_available_error_spacing(monkeypatch, capsys):
+    """The missing-module diagnostic ends with two blank lines."""
+    info = machinery.SelectionInfo(wrapper='PyQt5')
+
+    def import_module(name):
+        if name == 'PyQt5.QtCore':
+            raise ImportError('QtCore unavailable')
+
+    monkeypatch.setattr(earlyinit.importlib, 'import_module', import_module)
+    monkeypatch.setattr(earlyinit, 'tkinter', None)
+    monkeypatch.setattr(sys, 'argv', ['qutebrowser'])
+
+    with pytest.raises(SystemExit):
+        earlyinit.check_qt_available(info)
+
+    assert capsys.readouterr().err.endswith('\n\n\n')
