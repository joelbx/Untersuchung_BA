+
+
+def test_selection_info_strings():
+    info = machinery.SelectionInfo(wrapper="PyQt5", reason=machinery.SelectionReason.cli)
+    assert str(info) == "Qt wrapper: PyQt5 (via --qt-wrapper)"
+    info.pyqt5 = "success"
+    info.pyqt6 = "ImportError: missing"
+    assert str(info) == ("Qt wrapper info:\nPyQt5: success\n"
+                         "PyQt6: ImportError: missing\n"
+                         "selected: PyQt5 (via --qt-wrapper)")
+
+
+def test_implicit_init_no_wrapper(stubs, modules, monkeypatch):
+    for wrapper in machinery.WRAPPERS:
+        monkeypatch.delitem(sys.modules, wrapper, raising=False)
+    monkeypatch.setattr(machinery, "_initialized", False)
+    stubs.ImportFake(modules, monkeypatch).patch()
+
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        machinery.init()
+    assert excinfo.value.info.wrapper is None
+    assert machinery._initialized is False
+
+
+def test_implicit_init_returns_info(stubs, modules, monkeypatch):
+    for wrapper in machinery.WRAPPERS:
+        monkeypatch.delitem(sys.modules, wrapper, raising=False)
+    monkeypatch.setattr(machinery, "_initialized", False)
+    modules["PyQt5"] = True
+    stubs.ImportFake(modules, monkeypatch).patch()
+
+    info = machinery.init()
+    assert info is machinery.INFO
+    assert info.wrapper == "PyQt5"
+    assert machinery.init() is info
+
+
+def test_check_qt_available_no_wrapper(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5",
+                                   reason=machinery.SelectionReason.default)
+
+    def missing(name):
+        raise ModuleNotFoundError(f"No module named '{name}'")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", missing)
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        earlyinit.check_qt_available(info)
+
+    assert excinfo.value.info is info
+    assert info.pyqt5 == "ModuleNotFoundError: No module named 'PyQt5'"
+    assert info.pyqt6 == "ModuleNotFoundError: No module named 'PyQt6'"
+    assert str(excinfo.value) == f"No Qt wrapper was importable.\n\n\n{info}"
 
 
