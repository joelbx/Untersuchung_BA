+func TestImportStringAttachments(t *testing.T) {
+	store := new(memoryStore)
+	input := "flags:\n- key: f\n  variants:\n  - key: number\n    attachment: '123'\n  - key: boolean\n    attachment: 'true'\n  - key: object\n    attachment: '{\"x\":1}'\n"
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	for index, want := range []string{`"123"`, `"true"`, `"{\"x\":1}"`} {
+		if got := store.variants[index].Attachment; got != want {
+			t.Errorf("variant %d attachment = %q, want %q", index, got, want)
+		}
+	}
+}
