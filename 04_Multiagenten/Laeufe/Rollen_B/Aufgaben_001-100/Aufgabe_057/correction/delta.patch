+// YAML's encoder treats json.Number as a string. Convert integral values to
+// integer types before encoding so large integers remain exact YAML numbers.
+func normalizeJSONNumbers(value interface{}) interface{} {
+	switch v := value.(type) {
+	case json.Number:
+		if n, err := strconv.ParseInt(string(v), 10, 64); err == nil {
+			return n
+		}
+		if n, err := strconv.ParseUint(string(v), 10, 64); err == nil {
+			return n
+		}
+		// A larger integer cannot be represented by Go's YAML numeric types.
+		// Keep its exact digits instead of rounding it through float64.
+		if !strings.ContainsAny(string(v), ".eE") {
+			return v
+		}
+		if n, err := strconv.ParseFloat(string(v), 64); err == nil {
+			return n
+		}
+		return v
+	case map[string]interface{}:
+		for key, item := range v {
+			v[key] = normalizeJSONNumbers(item)
+		}
+	case []interface{}:
+		for index, item := range v {
+			v[index] = normalizeJSONNumbers(item)
+		}
+	}
+	return value
+}
