+func TestExportLargeIntegerAttachment(t *testing.T) {
+	store := &memoryStore{flags: []*flipt.Flag{{Key: "f", Variants: []*flipt.Variant{{Key: "v", Attachment: `{"nested":[9007199254740993,18446744073709551615]}`}}}}}
+	var out bytes.Buffer
+	if err := NewExporter(store).Export(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), "9007199254740993") || !strings.Contains(out.String(), "18446744073709551615") {
+		t.Fatalf("large integers changed: %s", out.String())
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	attachment := doc.Flags[0].Variants[0].Attachment.(map[interface{}]interface{})
+	numbers := attachment["nested"].([]interface{})
+	if _, ok := numbers[0].(string); ok || fmt.Sprint(numbers[0]) != "9007199254740993" {
+		t.Fatalf("large integer became %T(%v)", numbers[0], numbers[0])
+	}
+	if _, ok := numbers[1].(string); ok || fmt.Sprint(numbers[1]) != "18446744073709551615" {
+		t.Fatalf("unsigned integer became %T(%v)", numbers[1], numbers[1])
+	}
+	imported := new(memoryStore)
+	if err := NewImporter(imported).Import(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if imported.variants[0].Attachment != store.flags[0].Variants[0].Attachment {
+		t.Fatalf("round trip attachment = %q", imported.variants[0].Attachment)
+	}
+}
