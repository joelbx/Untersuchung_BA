index 0000000..0e8b293
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,184 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type memoryStore struct {
+	flags         []*flipt.Flag
+	segments      []*flipt.Segment
+	rules         []*flipt.Rule
+	variants      []*flipt.CreateVariantRequest
+	distributions []*flipt.CreateDistributionRequest
+}
+
+func (m *memoryStore) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	start, end := pageBounds(len(m.flags), opts...)
+	return m.flags[start:end], nil
+}
+func (m *memoryStore) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	start, end := pageBounds(len(m.segments), opts...)
+	return m.segments[start:end], nil
+}
+func (m *memoryStore) ListRules(_ context.Context, _ string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return m.rules, nil
+}
+func pageBounds(length int, opts ...storage.QueryOption) (int, int) {
+	var p storage.QueryParams
+	for _, opt := range opts {
+		opt(&p)
+	}
+	if p.Offset >= uint64(length) {
+		return length, length
+	}
+	end := p.Offset + p.Limit
+	if end > uint64(length) {
+		end = uint64(length)
+	}
+	return int(p.Offset), int(end)
+}
+func (m *memoryStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	f := &flipt.Flag{Key: r.Key, Name: r.Name, Description: r.Description, Enabled: r.Enabled}
+	m.flags = append(m.flags, f)
+	return f, nil
+}
+func (m *memoryStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	m.variants = append(m.variants, r)
+	v := &flipt.Variant{Id: r.Key + "-id", Key: r.Key, Name: r.Name, Description: r.Description, Attachment: r.Attachment}
+	for _, f := range m.flags {
+		if f.Key == r.FlagKey {
+			f.Variants = append(f.Variants, v)
+		}
+	}
+	return v, nil
+}
+func (m *memoryStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s := &flipt.Segment{Key: r.Key, Name: r.Name, Description: r.Description, MatchType: r.MatchType}
+	m.segments = append(m.segments, s)
+	return s, nil
+}
+func (m *memoryStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	c := &flipt.Constraint{Type: r.Type, Property: r.Property, Operator: r.Operator, Value: r.Value}
+	for _, s := range m.segments {
+		if s.Key == r.SegmentKey {
+			s.Constraints = append(s.Constraints, c)
+		}
+	}
+	return c, nil
+}
+func (m *memoryStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	rule := &flipt.Rule{Id: "rule-id", FlagKey: r.FlagKey, SegmentKey: r.SegmentKey, Rank: r.Rank}
+	m.rules = append(m.rules, rule)
+	return rule, nil
+}
+func (m *memoryStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	m.distributions = append(m.distributions, r)
+	d := &flipt.Distribution{VariantId: r.VariantId, Rollout: r.Rollout}
+	m.rules[len(m.rules)-1].Distributions = append(m.rules[len(m.rules)-1].Distributions, d)
+	return d, nil
+}
+
+func TestImportExportNativeAttachments(t *testing.T) {
+	input := `flags:
+- key: feature
+  name: Feature
+  enabled: true
+  variants:
+  - key: first
+    attachment:
+      items:
+      - 1
+      - false
+      - null
+      - nested: [text, 2.5]
+      7: [true, {deep: null}]
+  - key: empty
+  rules:
+  - segment: users
+    rank: 1
+    distributions:
+    - variant: first
+      rollout: 50
+segments:
+- key: users
+  match_type: ANY_MATCH_TYPE
+  constraints:
+  - type: STRING_COMPARISON_TYPE
+    property: country
+    operator: eq
+    value: US
+`
+	ctx := context.Background()
+	store := new(memoryStore)
+	if err := NewImporter(store).Import(ctx, strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if len(store.flags) != 1 || len(store.variants) != 2 || len(store.segments) != 1 || len(store.rules) != 1 || len(store.distributions) != 1 || len(store.segments[0].Constraints) != 1 {
+		t.Fatalf("incomplete import: %+v", store)
+	}
+	if store.variants[1].Attachment != "" {
+		t.Fatalf("missing attachment became %q", store.variants[1].Attachment)
+	}
+	var attachment interface{}
+	if err := json.Unmarshal([]byte(store.variants[0].Attachment), &attachment); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]interface{}{"items": []interface{}{float64(1), false, nil, map[string]interface{}{"nested": []interface{}{"text", 2.5}}}, "7": []interface{}{true, map[string]interface{}{"deep": nil}}}
+	if !reflect.DeepEqual(attachment, want) {
+		t.Fatalf("attachment = %#v", attachment)
+	}
+	var out bytes.Buffer
+	if err := NewExporter(store).Export(ctx, &out); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := doc.Flags[0].Variants[0].Attachment.(map[interface{}]interface{}); !ok {
+		t.Fatalf("exported attachment is not a YAML map: %s", out.String())
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil {
+		t.Fatalf("empty attachment included: %s", out.String())
+	}
+	if !strings.Contains(out.String(), "match_type: ANY_MATCH_TYPE") {
+		t.Fatalf("segment metadata lost: %s", out.String())
+	}
+}
+
+func TestImportLegacyJSONAttachment(t *testing.T) {
+	store := new(memoryStore)
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader("flags:\n- key: f\n  variants:\n  - key: v\n    attachment: '{\"x\":1}'\n")); err != nil {
+		t.Fatal(err)
+	}
+	if store.variants[0].Attachment != `{"x":1}` {
+		t.Fatalf("legacy JSON changed: %q", store.variants[0].Attachment)
+	}
+}
+
+func TestExplicitNullAttachment(t *testing.T) {
+	store := new(memoryStore)
+	input := "flags:\n- key: f\n  variants:\n  - key: null-value\n    attachment: null\n  - key: absent\n"
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if store.variants[0].Attachment != "null" || store.variants[1].Attachment != "" {
+		t.Fatalf("attachments: %q, %q", store.variants[0].Attachment, store.variants[1].Attachment)
+	}
+	var out bytes.Buffer
+	if err := NewExporter(store).Export(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), "attachment: null") || strings.Count(out.String(), "attachment:") != 1 {
+		t.Fatalf("null/absent attachments changed: %s", out.String())
+	}
+}
