diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..a4fd252
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,34 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const privileges = require('../privileges');
+const user = require('../user');
+
+exports.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	const match = typeof resource === 'string' && /^acct:([^@]+)@([^@]+)$/.exec(resource);
+	if (!match || match[2].toLowerCase() !== hostname.toLowerCase()) {
+		return res.sendStatus(400);
+	}
+
+	const canViewUsers = await privileges.global.can('view:users', req.uid || 0);
+	if (!canViewUsers) {
+		return res.sendStatus(403);
+	}
+
+	const uid = await user.getUidByUserslug(match[1]);
+	if (!uid) {
+		return res.sendStatus(404);
+	}
+
+	const userslug = await user.getUserField(uid, 'userslug');
+	const baseUrl = nconf.get('url');
+	const profileUrl = `${baseUrl}/user/${userslug}`;
+	res.type('application/jrd+json').json({
+		subject: resource,
+		aliases: [`${baseUrl}/uid/${uid}`, profileUrl],
+		links: [{ rel: 'http://webfinger.net/rel/profile-page', type: 'text/html', href: profileUrl }],
+	});
+};
