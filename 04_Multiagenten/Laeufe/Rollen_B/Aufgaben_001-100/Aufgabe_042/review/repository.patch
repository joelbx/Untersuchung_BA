+};
diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..86c9016
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,112 @@
+'use strict';
+
+const assert = require('assert');
+const Module = require('module');
+const nconf = require('nconf');
+
+const privileges = { global: {} };
+const user = {};
+const originalLoad = Module._load;
+Module._load = function (name, ...args) {
+	if (name === '../privileges') {
+		return privileges;
+	}
+	if (name === '../user') {
+		return user;
+	}
+	return originalLoad.call(this, name, ...args);
+};
+
+const controller = require('../src/controllers/well-known');
+
+Module._load = originalLoad;
+
+describe('WebFinger', () => {
+	const originalGet = nconf.get;
+	let checkedUid;
+
+	beforeEach(() => {
+		nconf.get = function (key, ...args) {
+			if (key === 'url') {
+				return 'https://example.com/forum';
+			}
+			if (key === 'url_parsed') {
+				return { hostname: 'example.com' };
+			}
+			return originalGet.call(this, key, ...args);
+		};
+		checkedUid = undefined;
+		privileges.global.can = async (privilege, uid) => {
+			assert.strictEqual(privilege, 'view:users');
+			checkedUid = uid;
+			return true;
+		};
+		user.getUidByUserslug = async slug => (slug === 'alice' ? 42 : 0);
+		user.getUserField = async (uid, field) => {
+			assert.strictEqual(uid, 42);
+			assert.strictEqual(field, 'userslug');
+			return 'alice';
+		};
+	});
+
+	afterEach(() => {
+		nconf.get = originalGet;
+	});
+
+	async function request(resource, uid) {
+		const response = {
+			sendStatus(status) {
+				this.status = status;
+				return this;
+			},
+			type(value) {
+				this.contentType = value;
+				return this;
+			},
+			json(body) {
+				this.status = 200;
+				this.body = body;
+				return this;
+			},
+		};
+		await controller.webfinger({ query: { resource }, uid }, response);
+		return response;
+	}
+
+	it('rejects missing and malformed resources', async () => {
+		const resources = [undefined, '', 'alice@example.com', 'acct:@example.com', 'acct:alice@other.example.com', 'acct:alice@example.com.evil', 'acct:alice@example.com@evil', ['acct:alice@example.com']];
+		const responses = await Promise.all(resources.map(resource => request(resource)));
+		responses.forEach(response => assert.strictEqual(response.status, 400));
+	});
+
+	it('evaluates anonymous access as Guest', async () => {
+		privileges.global.can = async (privilege, uid) => {
+			assert.strictEqual(privilege, 'view:users');
+			checkedUid = uid;
+			return false;
+		};
+		const response = await request('acct:alice@example.com');
+		assert.strictEqual(checkedUid, 0);
+		assert.strictEqual(response.status, 403);
+	});
+
+	it('returns 404 when the slug cannot be resolved', async () => {
+		const response = await request('acct:missing@example.com', 10);
+		assert.strictEqual(checkedUid, 10);
+		assert.strictEqual(response.status, 404);
+	});
+
+	it('returns a WebFinger document with both profile aliases', async () => {
+		const resource = 'acct:alice@example.com';
+		const response = await request(resource);
+		assert.strictEqual(checkedUid, 0);
+		assert.strictEqual(response.status, 200);
+		assert.strictEqual(response.contentType, 'application/jrd+json');
+		assert.strictEqual(response.body.subject, resource);
+		assert.deepStrictEqual(response.body.aliases, [
+			'https://example.com/forum/uid/42',
+			'https://example.com/forum/user/alice',
+		]);
+		assert(response.body.links.some(link => link.href === 'https://example.com/forum/user/alice' && link.type === 'text/html'));
+	});
+});
