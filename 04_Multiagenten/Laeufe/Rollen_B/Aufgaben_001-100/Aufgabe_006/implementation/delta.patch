+// Package fanoutbuffer provides a concurrent buffer with independent readers.
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+var (
+	// ErrGracePeriodExceeded means a cursor remained more than Capacity items behind
+	// for longer than the configured grace period.
+	ErrGracePeriodExceeded = errors.New("fanout buffer grace period exceeded")
+	// ErrUseOfClosedCursor means a cursor was used after Close.
+	ErrUseOfClosedCursor = errors.New("use of closed fanout buffer cursor")
+	// ErrBufferClosed means the buffer has been closed.
+	ErrBufferClosed = errors.New("fanout buffer closed")
+)
+
+// Config configures a Buffer.
+type Config struct {
+	Capacity    uint64
+	GracePeriod time.Duration
+	Clock       clockwork.Clock
+}
+
+// SetDefaults fills unset configuration fields.
+func (c *Config) SetDefaults() {
+	if c.Capacity == 0 {
+		c.Capacity = 64
+	}
+	if c.GracePeriod == 0 {
+		c.GracePeriod = 5 * time.Minute
+	}
+	if c.Clock == nil {
+		c.Clock = clockwork.NewRealClock()
+	}
+}
+
+// Buffer distributes appended items to all cursors present at append time.
+// All mutable state, including cursor state, is protected by mu.
+type Buffer[T any] struct {
+	mu      sync.Mutex
+	cfg     Config
+	closed  bool
+	notify  chan struct{}
+	cursors map[*Cursor[T]]struct{}
+
+	// [base, end) is retained. The oldest items are in the ring; newer
+	// items that do not fit are in overflow.
+	base, end     uint64
+	ring          []T
+	head, ringLen int
+	overflow      []T
+}
+
+// NewBuffer constructs a fanout buffer.
+func NewBuffer[T any](cfg Config) *Buffer[T] {
+	cfg.SetDefaults()
+	return &Buffer[T]{
+		cfg:     cfg,
+		notify:  make(chan struct{}),
+		cursors: make(map[*Cursor[T]]struct{}),
+		ring:    make([]T, cfg.Capacity),
+	}
+}
+
+// Cursor reads items appended after it was created.
+type Cursor[T any] struct {
+	buffer          *Buffer[T]
+	next            uint64
+	behindSince     time.Time
+	closed, expired bool
+}
+
+// NewCursor subscribes to future items. A cursor created on a closed buffer
+// reports ErrBufferClosed when read.
+func (b *Buffer[T]) NewCursor() *Cursor[T] {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	c := &Cursor[T]{buffer: b, next: b.end}
+	if !b.closed {
+		b.cursors[c] = struct{}{}
+	}
+	return c
+}
+
+// Append adds items and wakes blocked readers. Appends after Close are ignored.
+func (b *Buffer[T]) Append(items ...T) {
+	if len(items) == 0 {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed || len(b.cursors) == 0 {
+		return
+	}
+	b.expireLocked()
+	if len(b.cursors) == 0 {
+		return
+	}
+	for _, item := range items {
+		if uint64(b.ringLen) < b.cfg.Capacity {
+			b.ring[(b.head+b.ringLen)%len(b.ring)] = item
+			b.ringLen++
+		} else {
+			b.overflow = append(b.overflow, item)
+		}
+		b.end++
+	}
+	b.expireLocked()
+	b.reclaimLocked()
+	b.wakeLocked()
+}
+
+// Close terminates all cursors and releases retained items. It is idempotent.
+func (b *Buffer[T]) Close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.closed = true
+	b.ring = nil
+	b.overflow = nil
+	b.ringLen = 0
+	b.cursors = nil
+	b.wakeLocked()
+}
+
+// TryRead copies currently available items without waiting.
+func (c *Cursor[T]) TryRead(out []T) (int, error) {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return c.readLocked(out)
+}
+
+// Read waits for at least one item, closure, expiry, or context cancellation.
+func (c *Cursor[T]) Read(ctx context.Context, out []T) (int, error) {
+	for {
+		b := c.buffer
+		b.mu.Lock()
+		n, err := c.readLocked(out)
+		if n != 0 || err != nil || len(out) == 0 {
+			b.mu.Unlock()
+			return n, err
+		}
+		ch := b.notify
+		b.mu.Unlock()
+		select {
+		case <-ch:
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		}
+	}
+}
+
+func (c *Cursor[T]) readLocked(out []T) (int, error) {
+	b := c.buffer
+	if c.closed {
+		return 0, ErrUseOfClosedCursor
+	}
+	if c.expired {
+		return 0, ErrGracePeriodExceeded
+	}
+	if b.closed {
+		return 0, ErrBufferClosed
+	}
+	b.expireLocked()
+	if c.expired {
+		return 0, ErrGracePeriodExceeded
+	}
+	if len(out) == 0 || c.next == b.end {
+		return 0, nil
+	}
+	n := int(min(uint64(len(out)), b.end-c.next))
+	offset := int(c.next - b.base)
+	copied := 0
+	for copied < n && offset < b.ringLen {
+		chunk := min(n-copied, b.ringLen-offset, len(b.ring)-(b.head+offset)%len(b.ring))
+		copy(out[copied:copied+chunk], b.ring[(b.head+offset)%len(b.ring):][:chunk])
+		offset += chunk
+		copied += chunk
+	}
+	if copied < n {
+		copy(out[copied:n], b.overflow[offset-b.ringLen:])
+	}
+	c.next += uint64(n)
+	b.updateLagLocked(c, b.cfg.Clock.Now())
+	b.reclaimLocked()
+	return n, nil
+}
+
+// Close releases the cursor's claim on retained items. It is idempotent.
+func (c *Cursor[T]) Close() error {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	delete(b.cursors, c)
+	if !b.closed {
+		b.reclaimLocked()
+	}
+	b.wakeLocked()
+	return nil
+}
+
+func (b *Buffer[T]) wakeLocked() {
+	close(b.notify)
+	b.notify = make(chan struct{})
+}
+
+func (b *Buffer[T]) expireLocked() {
+	now := b.cfg.Clock.Now()
+	changed := false
+	for c := range b.cursors {
+		b.updateLagLocked(c, now)
+		if !c.behindSince.IsZero() && now.Sub(c.behindSince) >= b.cfg.GracePeriod {
+			c.expired = true
+			delete(b.cursors, c)
+			changed = true
+		}
+	}
+	if changed {
+		b.reclaimLocked()
+		b.wakeLocked()
+	}
+}
+
+func (b *Buffer[T]) updateLagLocked(c *Cursor[T], now time.Time) {
+	if b.end-c.next > b.cfg.Capacity {
+		if c.behindSince.IsZero() {
+			c.behindSince = now
+		}
+	} else {
+		c.behindSince = time.Time{}
+	}
+}
+
+func (b *Buffer[T]) reclaimLocked() {
+	oldest := b.end
+	for c := range b.cursors {
+		if c.next < oldest {
+			oldest = c.next
+		}
+	}
+	drop := oldest - b.base
+	if drop == 0 {
+		return
+	}
+	var zero T
+	for i := uint64(0); i < drop; i++ {
+		if b.ringLen > 0 {
+			b.ring[b.head] = zero
+			b.head = (b.head + 1) % len(b.ring)
+			b.ringLen--
+		} else {
+			b.overflow[0] = zero
+			b.overflow = b.overflow[1:]
+		}
+		if len(b.overflow) > 0 {
+			pos := (b.head + b.ringLen) % len(b.ring)
+			b.ring[pos] = b.overflow[0]
+			b.ringLen++
+			b.overflow[0] = zero
+			b.overflow = b.overflow[1:]
+		}
+	}
+	b.base = oldest
+	// Slicing keeps the old backing array alive. Compact once its unused
+	// prefix is large enough; clearing consumed elements releases references.
+	if len(b.overflow) == 0 {
+		b.overflow = nil
+	} else if cap(b.overflow) > 2*len(b.overflow) {
+		b.overflow = append([]T(nil), b.overflow...)
+	}
+}
