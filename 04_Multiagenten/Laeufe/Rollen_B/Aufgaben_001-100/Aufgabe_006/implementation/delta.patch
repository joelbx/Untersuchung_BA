@@ -0,0 +1,148 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestFanoutAndOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	a, c := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	out := make([]int, 5)
+	if n, err := a.TryRead(out[:3]); n != 3 || err != nil || !reflect.DeepEqual(out[:3], []int{1, 2, 3}) {
+		t.Fatalf("first read: %d %v %v", n, err, out[:3])
+	}
+	b.Append(6, 7)
+	if n, err := a.TryRead(out); n != 4 || err != nil || !reflect.DeepEqual(out[:4], []int{4, 5, 6, 7}) {
+		t.Fatalf("second read: %d %v %v", n, err, out[:4])
+	}
+	all := make([]int, 7)
+	if n, err := c.TryRead(all); n != 7 || err != nil || !reflect.DeepEqual(all, []int{1, 2, 3, 4, 5, 6, 7}) {
+		t.Fatalf("slow cursor: %d %v %v", n, err, all)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(out); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3)
+	clock.Advance(time.Minute)
+	if _, err := slow.TryRead(make([]int, 3)); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow cursor: %v", err)
+	}
+	if _, err := fast.TryRead(make([]int, 3)); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("fast cursor that did not advance: %v", err)
+	}
+	newCursor := b.NewCursor()
+	b.Append(4)
+	out := make([]int, 1)
+	if n, err := newCursor.TryRead(out); n != 1 || err != nil || out[0] != 4 {
+		t.Fatalf("new cursor: %d %v %v", n, err, out)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]int, 1)
+		_, err := c.Read(context.Background(), out)
+		result <- err
+	}()
+	b.Close()
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("read: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read was not woken")
+	}
+	if _, err := b.NewCursor().TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("cursor after close: %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	other := NewBuffer[int](Config{})
+	defer other.Close()
+	if _, err := other.NewCursor().Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read: %v", err)
+	}
+}
+
+func TestCursorCloseWakesRead(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	defer b.Close()
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrUseOfClosedCursor) {
+			t.Fatalf("read: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read was not woken")
+	}
+}
+
+func TestConcurrentReaders(t *testing.T) {
+	const count = 1000
+	b := NewBuffer[int](Config{Capacity: 8})
+	defer b.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	results := make(chan error, 4)
+	for i := 0; i < cap(results); i++ {
+		c := b.NewCursor()
+		go func() {
+			defer c.Close()
+			out := make([]int, 7)
+			for expected := 0; expected < count; {
+				n, err := c.Read(ctx, out)
+				if err != nil {
+					results <- err
+					return
+				}
+				for _, item := range out[:n] {
+					if item != expected {
+						results <- errors.New("out of order item")
+						return
+					}
+					expected++
+				}
+			}
+			results <- nil
+		}()
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	for i := 0; i < cap(results); i++ {
+		if err := <-results; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
