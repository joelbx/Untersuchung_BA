+class GzipDecodedReader(gzip.GzipFile if gzip is not None else object):
+    """A readable gzip stream retaining the response's HTTP metadata."""
+
+    def __init__(self, fp):
+        if gzip is None:
+            raise MissingModuleError(self.missing_gzip_error(), None, module='gzip')
+        self._response = fp
+        # Python 2's addinfourl exposes the actual stream through fp.
+        fileobj = fp.fp if PY2 and hasattr(fp, 'fp') else fp
+        super(GzipDecodedReader, self).__init__(fileobj=fileobj, mode='rb')
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    def close(self):
+        try:
+            super(GzipDecodedReader, self).close()
+        finally:
+            self._response.close()
+
+    @staticmethod
+    def missing_gzip_error():
+        return missing_required_lib('gzip', reason='for decompress=True')
 
 
