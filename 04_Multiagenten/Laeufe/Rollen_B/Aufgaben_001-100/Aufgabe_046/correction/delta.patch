 class TestRecursiveFinder(object):
+    def test_nested_legacy_redirect(self, monkeypatch):
+        import ansible.executor.module_common as module_common
+
+        metadata = {'plugin_routing': {'module_utils': {
+            'sub1.sub2.formerly_core': {'redirect': 'testns.testcoll.base'}}}}
+        monkeypatch.setattr(module_common, '_get_collection_metadata', lambda collection: metadata)
+        monkeypatch.setattr(module_common.CollectionModuleUtilLocator, '_get_data', staticmethod(lambda *args: None))
+
+        locator = module_common.LegacyModuleUtilLocator(
+            ('ansible', 'module_utils', 'sub1', 'sub2', 'formerly_core'), mu_paths=[])
+        assert locator.found and locator.redirected
+        assert locator.redirect_target == ('ansible_collections', 'testns', 'testcoll', 'plugins', 'module_utils', 'base')
+        assert locator.output_path == 'ansible/module_utils/sub1/sub2/formerly_core.py'
+
+    def test_redirect_to_missing_collection(self, monkeypatch):
+        import ansible.executor.module_common as module_common
+
+        metadata = {'plugin_routing': {'module_utils': {'old': {'redirect': 'missing.coll.target'}}}}
+        monkeypatch.setattr(module_common, '_get_collection_metadata', lambda collection: metadata)
+
+        def missing_collection(package, resource):
+            raise ImportError('No module named %s' % package)
+
+        monkeypatch.setattr(module_common.pkgutil, 'get_data', missing_collection)
+        with pytest.raises(ansible.errors.AnsibleError, match='unable to locate collection missing.coll'):
+            module_common.CollectionModuleUtilLocator(
+                ('ansible_collections', 'example', 'coll', 'plugins', 'module_utils', 'old'))
+
