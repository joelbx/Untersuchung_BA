@@ -2,12 +2,53 @@ package flipt
 
 import (
 	"fmt"
+	"strings"
 	"testing"
 
 	"github.com/stretchr/testify/assert"
 	"go.flipt.io/flipt/errors"
 )
 
+func TestValidate_ListConstraintValues(t *testing.T) {
+	tests := []struct {
+		name  string
+		type_ ComparisonType
+		value string
+		want  error
+	}{
+		{"string valid", ComparisonType_STRING_COMPARISON_TYPE, `["a","b"]`, nil},
+		{"string 100", ComparisonType_STRING_COMPARISON_TYPE, `[` + strings.TrimSuffix(strings.Repeat(`"a",`, 100), ",") + `]`, nil},
+		{"string 101", ComparisonType_STRING_COMPARISON_TYPE, `[` + strings.TrimSuffix(strings.Repeat(`"a",`, 101), ",") + `]`, errors.ErrInvalid(`too many values provided for property "foo" of type string (maximum 100)`)},
+		{"string mixed", ComparisonType_STRING_COMPARISON_TYPE, `["a",1]`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"string malformed", ComparisonType_STRING_COMPARISON_TYPE, `[`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"string null", ComparisonType_STRING_COMPARISON_TYPE, `null`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"string null element", ComparisonType_STRING_COMPARISON_TYPE, `[null]`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"number valid", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,2.5]`, nil},
+		{"number 100", ComparisonType_NUMBER_COMPARISON_TYPE, `[` + strings.TrimSuffix(strings.Repeat("1,", 100), ",") + `]`, nil},
+		{"number 101", ComparisonType_NUMBER_COMPARISON_TYPE, `[` + strings.TrimSuffix(strings.Repeat("1,", 101), ",") + `]`, errors.ErrInvalid(`too many values provided for property "foo" of type number (maximum 100)`)},
+		{"number mixed", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,"2"]`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+		{"number malformed", ComparisonType_NUMBER_COMPARISON_TYPE, `[`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+		{"number null", ComparisonType_NUMBER_COMPARISON_TYPE, `null`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+		{"number null element", ComparisonType_NUMBER_COMPARISON_TYPE, `[null]`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+	}
+	for _, tt := range tests {
+		for _, op := range []string{OpIsOneOf, OpIsNotOneOf} {
+			t.Run(tt.name+"/"+op, func(t *testing.T) {
+				create := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: tt.type_, Operator: op, Value: tt.value}
+				update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "foo", Type: tt.type_, Operator: op, Value: tt.value}
+				assert.Equal(t, tt.want, create.Validate())
+				assert.Equal(t, tt.want, update.Validate())
+			})
+		}
+	}
+	for _, op := range []string{OpIsOneOf, OpIsNotOneOf} {
+		t.Run("datetime/"+op, func(t *testing.T) {
+			req := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: ComparisonType_DATETIME_COMPARISON_TYPE, Operator: op, Value: `[1]`}
+			assert.Equal(t, errors.ErrInvalidf("constraint operator %q is not valid for type datetime", op), req.Validate())
+		})
+	}
+}
