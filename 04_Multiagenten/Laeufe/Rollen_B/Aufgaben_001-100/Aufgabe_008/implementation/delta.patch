+describe('useLink failed fetches', () => {
+    const abortSignal = new AbortController().signal;
+
+    beforeEach(() => {
+        jest.resetAllMocks();
+        jest.useFakeTimers();
+    });
+
+    afterEach(() => {
+        jest.runOnlyPendingTimers();
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses API error %s for the same link, then retries after backoff',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequst.mockRejectedValue(error);
+            const { result } = renderHook(() => useLink());
+            const { result: otherHook } = renderHook(() => useLink());
+
+            await expect(result.current.loadFreshLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+            await expect(otherHook.current.loadFreshLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+            expect(mockRequst).toHaveBeenCalledTimes(1);
+
+            await expect(result.current.loadFreshLink(abortSignal, 'share', 'other')).rejects.toBe(error);
+            await expect(result.current.loadFreshLink(abortSignal, 'other-share', 'missing')).rejects.toBe(error);
+            expect(mockRequst).toHaveBeenCalledTimes(3);
+
+            act(() => {
+                jest.advanceTimersByTime(10_000);
+            });
+            await expect(result.current.loadFreshLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+            expect(mockRequst).toHaveBeenCalledTimes(4);
+        }
+    );
+
+    it('does not reuse errors with other codes', async () => {
+        const error = { data: { Code: 12345 } };
+        mockRequst.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.loadFreshLink(abortSignal, 'share', 'link')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(abortSignal, 'share', 'link')).rejects.toBe(error);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+    });
+
+    it('keeps colliding plain concatenations separate', async () => {
+        const error = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequst.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.loadFreshLink(abortSignal, 'ab', 'c')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(abortSignal, 'a', 'bc')).rejects.toBe(error);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+    });
+});
