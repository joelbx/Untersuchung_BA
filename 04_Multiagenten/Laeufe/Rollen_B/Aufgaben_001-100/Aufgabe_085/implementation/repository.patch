+func TestDiffSelectionsAndPackages(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"new":    {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+			"shared": {CveID: "shared"},
+		},
+		Packages: models.Packages{"new-pkg": {Name: "new-pkg", Version: "current"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"old":    {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+			"shared": {CveID: "shared", VulnType: "previous metadata"},
+		},
+		Packages: models.Packages{"old-pkg": {Name: "old-pkg", Version: "previous"}},
+	}
+	for _, tc := range []struct {
+		name        string
+		plus, minus bool
+		want        models.VulnInfos
+		packages    models.Packages
+	}{
+		{"both", true, true, models.VulnInfos{
+			"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+			"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+		}, models.Packages{"new-pkg": current.Packages["new-pkg"], "old-pkg": previous.Packages["old-pkg"]}},
+		{"plus", true, false, models.VulnInfos{
+			"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+		}, models.Packages{"new-pkg": current.Packages["new-pkg"]}},
+		{"minus", false, true, models.VulnInfos{
+			"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+		}, models.Packages{"old-pkg": previous.Packages["old-pkg"]}},
+		{"neither", false, false, models.VulnInfos{}, models.Packages{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tc.plus, tc.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(results[0].ScannedCves, tc.want) || !reflect.DeepEqual(results[0].Packages, tc.packages) {
+				t.Errorf("got CVEs %#v, packages %#v; want CVEs %#v, packages %#v", results[0].ScannedCves, results[0].Packages, tc.want, tc.packages)
+			}
+		})
+	}
+}
