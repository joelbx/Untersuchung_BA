+func TestSyslogDiffStatus(t *testing.T) {
+	before := config.Conf.Diff
+	config.Conf.Diff = true
+	defer func() { config.Conf.Diff = before }()
+	r := models.ScanResult{ScannedCves: models.VulnInfos{
+		"CVE-new": {CveID: "CVE-new", DiffStatus: models.DiffPlus},
+		"CVE-old": {CveID: "CVE-old", DiffStatus: models.DiffMinus},
+	}}
+	messages := SyslogWriter{}.encodeSyslog(r)
+	if len(messages) != 2 {
+		t.Fatalf("got %d messages, want 2", len(messages))
+	}
+	joined := strings.Join(messages, "\n")
+	for _, id := range []string{`cve_id="+CVE-new"`, `cve_id="-CVE-old"`} {
+		if !strings.Contains(joined, id) {
+			t.Errorf("missing %s in %s", id, joined)
+		}
+	}
+}
