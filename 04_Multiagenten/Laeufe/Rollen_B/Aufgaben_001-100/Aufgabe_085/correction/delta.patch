+func TestDiffSharedPackageKeepsBothVersions(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"new": {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "shared"}}},
+		},
+		Packages: models.Packages{"shared": {Name: "shared", Version: "current"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"old": {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "shared"}}},
+		},
+		Packages: models.Packages{"shared": {Name: "shared", Version: "previous"}},
+	}
+	results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ id, version string }{{"new", "current"}, {"old", "previous"}} {
+		vuln := results[0].ScannedCves[tc.id]
+		if got := vuln.PackageVersions(results[0].Packages)["shared"].Version; got != tc.version {
+			t.Errorf("%s package version = %q, want %q", tc.id, got, tc.version)
+		}
+	}
