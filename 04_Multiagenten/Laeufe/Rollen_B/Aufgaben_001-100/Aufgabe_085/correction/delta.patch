+func TestSlackDiffAttachmentPackageVersions(t *testing.T) {
+	before := config.Conf.Diff
+	config.Conf.Diff = true
+	defer func() { config.Conf.Diff = before }()
+	r := models.ScanResult{
+		ScannedCves: models.VulnInfos{
+			"CVE-new": {CveID: "CVE-new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "shared"}}, Packages: models.Packages{"shared": {Name: "shared", Version: "current"}}},
+			"CVE-old": {CveID: "CVE-old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "shared"}}, Packages: models.Packages{"shared": {Name: "shared", Version: "previous"}}},
+		},
+		Packages: models.Packages{"shared": {Name: "shared", Version: "current"}},
+	}
+	attachments := toSlackAttachments(r)
+	if len(attachments) != 2 {
+		t.Fatalf("got %d attachments, want 2", len(attachments))
+	}
+	for _, a := range attachments {
+		want := "shared-current"
+		if a.Title == "-CVE-old" {
+			want = "shared-previous"
+		} else if a.Title != "+CVE-new" {
+			t.Errorf("unexpected title %q", a.Title)
+		}
+		if got := a.Fields[0].Value; got != want {
+			t.Errorf("%s installed = %q, want %q", a.Title, got, want)
+		}
+	}
+}
