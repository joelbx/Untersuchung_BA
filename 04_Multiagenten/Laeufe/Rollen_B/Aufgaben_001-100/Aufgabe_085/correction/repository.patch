+func TestDiffFormattingAndCount(t *testing.T) {
+	infos := VulnInfos{
+		"new":  {CveID: "new", DiffStatus: DiffPlus},
+		"old":  {CveID: "old", DiffStatus: DiffMinus},
+		"same": {CveID: "same"},
+	}
+	plus, minus := infos.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Errorf("CountDiff() = (%d, %d), want (1, 1)", plus, minus)
+	}
+	for _, tc := range []struct {
+		id, want string
+	}{
+		{"new", "+new"}, {"old", "-old"}, {"same", "same"},
+	} {
+		if got := infos[tc.id].CveIDDiffFormat(true); got != tc.want {
+			t.Errorf("CveIDDiffFormat(true) = %q, want %q", got, tc.want)
+		}
+		if got := infos[tc.id].CveIDDiffFormat(false); got != tc.id {
+			t.Errorf("CveIDDiffFormat(false) = %q, want %q", got, tc.id)
+		}
+	}
+}
