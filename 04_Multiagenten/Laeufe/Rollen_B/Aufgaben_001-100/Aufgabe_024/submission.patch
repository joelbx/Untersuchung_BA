+def remove_author_honorifics(name: str) -> str:
+    """Remove a leading honorific while preserving honorific-only names."""
+    normalized = re.sub(r'[^\w\s]', '', name).casefold()
+    if normalized in {re.sub(r'[^\w\s]', '', n) for n in HONORIFC_NAME_EXECPTIONS}:
+        return name
+    for honorific in HONORIFICS:
+        if name[: len(honorific)].casefold() != honorific:
+            continue
+        remainder = name[len(honorific) :]
+        if remainder and (remainder[0].isspace() or remainder[0] == '.'):
+            stripped = remainder.lstrip('. \t\n')
+            return stripped or name
+        if not remainder:
+            return name
+    return name
 
 
