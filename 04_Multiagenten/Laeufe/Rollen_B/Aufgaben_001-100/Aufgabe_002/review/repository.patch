+// KubeAddr returns the public URL of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	addrs := c.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = c.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("no public proxy address configured")
+	}
+
+	parsed, err := url.Parse("https://" + addrs[0].Addr)
+	if err != nil || parsed.Hostname() == "" || parsed.User != nil || parsed.Path != "" || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return "", trace.BadParameter("invalid public proxy address %q", addrs[0].Addr)
+	}
+	if port := parsed.Port(); port != "" {
+		n, err := strconv.Atoi(port)
+		if err != nil || n < 1 || n > 65535 {
+			return "", trace.BadParameter("invalid public proxy address %q", addrs[0].Addr)
+		}
+	}
+	return (&url.URL{Scheme: "https", Host: net.JoinHostPort(parsed.Hostname(), strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+}
