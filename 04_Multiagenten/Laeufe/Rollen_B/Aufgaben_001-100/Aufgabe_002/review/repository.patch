+	"github.com/gravitational/teleport/lib/utils"
 )
 
+func TestCheckProxyAddr(t *testing.T) {
+	proxy := func(addr string) services.Server {
+		p := &services.ServerV2{}
+		p.SetPublicAddr(addr)
+		return p
+	}
+	tests := []struct {
+		name     string
+		config   *service.Config
+		proxies  []services.Server
+		override string
+		want     string
+		wantErr  bool
+	}{
+		{
+			name: "local Kubernetes address",
+			config: &service.Config{Proxy: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube:        service.KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:443"}}},
+			}},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name:    "registered proxy after invalid address",
+			config:  &service.Config{},
+			proxies: []services.Server{proxy("bad host:3080"), proxy("proxy.example.com:99999"), proxy("proxy.example.com:3080")},
+			want:    "https://proxy.example.com:3026",
+		},
+		{
+			name:    "no valid registered proxy",
+			config:  &service.Config{},
+			proxies: []services.Server{proxy("bad host:3080")},
+			wantErr: true,
+		},
+		{
+			name:     "explicit override",
+			config:   &service.Config{Proxy: service.ProxyConfig{Kube: service.KubeProxyConfig{Enabled: true}}},
+			override: "custom.example.com:1234",
+			want:     "custom.example.com:1234",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ac := &AuthCommand{config: tt.config, outputFormat: identityfile.FormatKubernetes, proxyAddr: tt.override}
+			err := ac.checkProxyAddr(mockClient{proxies: tt.proxies})
+			if tt.wantErr {
+				if err == nil {
+					t.Fatal("expected error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if ac.proxyAddr != tt.want {
+				t.Fatalf("got %q, want %q", ac.proxyAddr, tt.want)
+			}
+		})
+	}
+}
