 func TestConfig(t *testing.T) { check.TestingT(t) }
 
+func TestProxyKubeAddr(t *testing.T) {
+	tests := []struct {
+		name    string
+		cfg     ProxyConfig
+		want    string
+		wantErr bool
+	}{
+		{
+			name:    "disabled",
+			cfg:     ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}},
+			wantErr: true,
+		},
+		{
+			name: "kubernetes public address takes precedence",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:443"}}},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "web public address fallback",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://proxy.example.com:3026",
+		},
+		{
+			name: "IPv6",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "[::1]:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://[::1]:3026",
+		},
+		{
+			name:    "missing address",
+			cfg:     ProxyConfig{Kube: KubeProxyConfig{Enabled: true}},
+			wantErr: true,
+		},
+		{
+			name:    "invalid address",
+			cfg:     ProxyConfig{Kube: KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "bad host:3080"}}}},
+			wantErr: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.KubeAddr()
+			if tt.wantErr {
+				assert.Error(t, err)
+			} else {
+				assert.NoError(t, err)
+				assert.Equal(t, tt.want, got)
+			}
+		})
+	}
+}
