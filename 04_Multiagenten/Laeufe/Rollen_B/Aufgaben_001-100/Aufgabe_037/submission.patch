+@pytest.mark.parametrize('filter_func', (to_yaml, to_nice_yaml))
+@pytest.mark.parametrize('nested', (False, True))
+def test_yaml_filter_undefined(filter_func, nested):
+    undefined = AnsibleUndefined(name='MYSVC_ENV')
+    value = {'environment': [undefined]} if nested else undefined
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(value)
+    assert filter_func.__name__ in to_native(error.value)
+    assert 'MYSVC_ENV' in to_native(error.value)
+    assert isinstance(error.value.orig_exc, UndefinedError)
+
+
+@pytest.mark.parametrize('filter_func', (to_yaml, to_nice_yaml))
+def test_yaml_filter_other_dump_failure(filter_func):
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(object())
+    assert filter_func.__name__ in to_native(error.value)
+    assert isinstance(error.value.orig_exc, RepresenterError)
+
+
+@pytest.mark.parametrize('filter_name', ('to_yaml', 'to_nice_yaml'))
+def test_yaml_filter_template_undefined(filter_name):
+    templar = Templar(loader=DataLoader())
+    template = '{{ MYSVC_ENV | %s }}' % filter_name
+    with pytest.raises(AnsibleUndefinedVariable) as error:
+        templar.template(template)
+    assert 'MYSVC_ENV' in to_native(error.value)
+    assert filter_name in to_native(error.value)
+    assert isinstance(error.value.orig_exc, UndefinedError)
+    assert templar.template(template, fail_on_undefined=False) == template
