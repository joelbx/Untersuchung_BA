diff --git a/internal/config/authentication_database_test.go b/internal/config/authentication_database_test.go
new file mode 100644
index 0000000..663ba7a
--- /dev/null
+++ b/internal/config/authentication_database_test.go
@@ -0,0 +1,47 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	methods := AuthenticationMethods{}
+	wantsDatabase := map[string]bool{
+		"token": true, "oidc": true, "github": true, "kubernetes": true, "jwt": false,
+	}
+	for _, info := range methods.AllMethods() {
+		t.Run(info.Name(), func(t *testing.T) {
+			assert.Equal(t, wantsDatabase[info.Name()], info.RequiresDatabase)
+			config := AuthenticationConfig{}
+			assert.False(t, config.RequiresDatabase())
+			assert.False(t, config.ShouldRunCleanup())
+
+			for _, method := range config.Methods.AllMethods() {
+				if method.Method == info.Method {
+					method.SetCleanup(t, AuthenticationCleanupSchedule{})
+					// A disabled method must not trigger a connection or cleanup.
+					assert.False(t, config.RequiresDatabase())
+					assert.False(t, config.ShouldRunCleanup())
+					method.Enable(t)
+					break
+				}
+			}
+
+			assert.Equal(t, info.RequiresDatabase, config.RequiresDatabase())
+			assert.Equal(t, info.RequiresDatabase, config.ShouldRunCleanup())
+		})
+	}
+}
+
+func TestAuthenticationMixedMethodsRequireDatabase(t *testing.T) {
+	config := AuthenticationConfig{}
+	config.Methods.JWT.Enabled = true
+	assert.False(t, config.RequiresDatabase())
+	config.Methods.Token.Enabled = true
+	assert.True(t, config.RequiresDatabase())
+	assert.False(t, config.ShouldRunCleanup())
+	config.Methods.Token.Cleanup = &AuthenticationCleanupSchedule{}
+	assert.True(t, config.ShouldRunCleanup())
+}
