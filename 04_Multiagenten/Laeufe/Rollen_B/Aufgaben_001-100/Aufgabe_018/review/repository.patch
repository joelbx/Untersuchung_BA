+func TestStringToSliceHook(t *testing.T) {
+	hook := stringToSliceHookFunc()
+	stringType := reflect.TypeOf("")
+	sliceType := reflect.TypeOf([]string{})
+
+	tests := []struct {
+		name  string
+		from  reflect.Type
+		to    reflect.Type
+		input interface{}
+		want  interface{}
+	}{
+		{"whitespace", stringType, sliceType, "  foo.com\tbar.com\n baz.com  ", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", stringType, sliceType, "", []string{}},
+		{"only whitespace", stringType, sliceType, " \t\n ", []string{}},
+		{"sequence", sliceType, sliceType, []string{"foo.com", "bar.com"}, []string{"foo.com", "bar.com"}},
+		{"other target", stringType, reflect.TypeOf([]int{}), "1 2", "1 2"},
+		{"other source", reflect.TypeOf(123), sliceType, 123, 123},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(tt.from, tt.to, tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadCorsAllowedOrigins(t *testing.T) {
+	tests := []struct {
+		name   string
+		yaml   string
+		env    string
+		hasEnv bool
+		want   []string
+	}{
+		{"whitespace scalar", "cors:\n  allowed_origins: \" foo.com\\tbar.com\\nbaz.com  \"\n", " foo.com\tbar.com\nbaz.com  ", true, []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty scalar", "cors:\n  allowed_origins: \"\"\n", "", true, []string{}},
+		{"sequence", "cors:\n  allowed_origins: [foo.com, bar.com]\n", "", false, []string{"foo.com", "bar.com"}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.yaml), 0600))
+			cfg, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+
+			if tt.hasEnv {
+				t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", tt.env)
+				cfg, err = Load("./testdata/default.yml")
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+			}
+		})
+	}
+}
