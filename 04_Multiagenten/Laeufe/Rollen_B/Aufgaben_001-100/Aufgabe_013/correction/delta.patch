+    @staticmethod
+    def _wrap_text(text, width, **kwargs):
+        separator = '\n-------------\n'
+        if separator not in text:
+            return textwrap.fill(text, width, **kwargs)
+
+        continuation = dict(kwargs)
+        continuation['initial_indent'] = kwargs.get('subsequent_indent', '')
+        return separator.join(
+            textwrap.fill(part.strip(), width, **(kwargs if index == 0 else continuation))
+            for index, part in enumerate(text.split(separator))
+        )
