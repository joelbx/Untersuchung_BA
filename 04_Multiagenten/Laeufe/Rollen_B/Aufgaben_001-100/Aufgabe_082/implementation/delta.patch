 )
 
+type testEventWriter struct {
+	bytes.Buffer
+	closes   int
+	closeErr error
+}
+
+func (w *testEventWriter) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+type testAuditEmitter struct {
+	IAuditLog
+	events []AuditEvent
+	closes int
+}
+
+func (e *testAuditEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	e.events = append(e.events, event)
+	return nil
+}
+
+func (e *testAuditEmitter) Close() error {
+	e.closes++
+	return nil
+}
+
+func TestWriterEmitter(t *testing.T) {
+	w := &testEventWriter{}
+	emitter := NewWriterEmitter(w)
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.True(t, bytes.HasSuffix(w.Bytes(), []byte("\n")))
+	var fields map[string]interface{}
+	require.NoError(t, json.Unmarshal(bytes.TrimSuffix(w.Bytes(), []byte("\n")), &fields))
+	require.Equal(t, UserLoginEvent, fields["event"])
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 1, w.closes)
+
+	w.closeErr = errors.New("close failed")
+	require.Error(t, NewWriterEmitter(w).Close())
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	first, second := &testAuditEmitter{}, &testAuditEmitter{}
+	_, err := NewMultiLog(first, NewWriterLog(&testEventWriter{}))
+	require.Error(t, err)
+
+	log, err := NewMultiLog(first, second)
+	require.NoError(t, err)
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent}}
+	require.NoError(t, log.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, []AuditEvent{event}, first.events)
+	require.Equal(t, []AuditEvent{event}, second.events)
+	require.NoError(t, log.Close())
+	require.Equal(t, 1, first.closes)
+	require.Equal(t, 1, second.closes)
+}
