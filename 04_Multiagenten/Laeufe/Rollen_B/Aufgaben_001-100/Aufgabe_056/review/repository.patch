--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
@@ -0,0 +1,21 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('uses the file type when the browser supplies one', async () => {
+        const file = new File(['x'], 'photo.jxl', { type: 'image/png' });
+        await expect(mimeTypeFromFile(file)).resolves.toBe('image/png');
+    });
+
+    it('uses the extension for empty files and generic browser types', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.jxl'))).resolves.toBe('image/jxl');
+        await expect(
+            mimeTypeFromFile(new File(['x'], 'photo.jxl', { type: 'application/octet-stream' }))
+        ).resolves.toBe('image/jxl');
+    });
+
+    it('falls back to the generic type for unknown extensions', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.unknown-extension'))).resolves.toBe(
+            'application/octet-stream'
+        );
+    });
+});
