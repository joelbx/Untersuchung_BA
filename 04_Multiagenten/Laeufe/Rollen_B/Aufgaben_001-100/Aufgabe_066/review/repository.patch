+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and descendants without changing other styles', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 100vh; color: red');
+        root.innerHTML = `
+            <section style="height: calc(50vh + 10px) !important; background: proton-url(https://example.com/a.png)">
+                <div style="height: 20px; min-height: 25vh; width: 30vh"></div>
+            </section>
+        `;
+
+        transformStyleAttributes(root);
+
+        const section = root.querySelector('section') as HTMLElement;
+        const child = root.querySelector('section div') as HTMLElement;
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+        expect(section.style.height).toBe('auto');
+        expect(section.style.getPropertyPriority('height')).toBe('important');
+        expect(section.getAttribute('style')).toContain('proton-url');
+        expect(child.style.height).toBe('20px');
+        expect(child.style.minHeight).toBe('25vh');
+        expect(child.style.width).toBe('30vh');
+    });
+
+    it('does not treat semicolons inside other values as declaration boundaries', () => {
+        const root = document.createElement('div');
+        root.setAttribute(
+            'style',
+            'background: proton-url("https://example.com/a;v=1"); height: 40VH; content: ";height: 60vh"'
+        );
+
+        transformStyleAttributes(root);
+
+        expect(root.getAttribute('style')).toBe(
+            'background: proton-url("https://example.com/a;v=1"); height: auto; content: ";height: 60vh"'
+        );
+    });
+});
