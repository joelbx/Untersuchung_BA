+++ b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
@@ -0,0 +1,69 @@
+const replaceHeight = (declaration: string): string => {
+    const match = declaration.match(/^(\s*height\s*:\s*)([\s\S]*)$/i);
+
+    if (!match || !/vh/i.test(match[2])) {
+        return declaration;
+    }
+
+    const important = match[2].match(/\s*!important\s*$/i)?.[0] || '';
+    return `${match[1]}auto${important}`;
+};
+
+const replaceViewportHeights = (style: string): string => {
+    let result = '';
+    let start = 0;
+    let quote = '';
+    let depth = 0;
+    let inComment = false;
+
+    for (let index = 0; index < style.length; index++) {
+        const character = style[index];
+        const next = style[index + 1];
+
+        if (character === ';' && !quote && !inComment && depth === 0) {
+            result += replaceHeight(style.slice(start, index));
+            result += ';';
+            start = index + 1;
+        } else if (inComment) {
+            if (character === '*' && next === '/') {
+                inComment = false;
+                index++;
+            }
+        } else if (quote) {
+            if (character === '\\') {
+                index++;
+            } else if (character === quote) {
+                quote = '';
+            }
+        } else if (character === '/' && next === '*') {
+            inComment = true;
+            index++;
+        } else if (character === '"' || character === "'") {
+            quote = character;
+        } else if (character === '(') {
+            depth++;
+        } else if (character === ')' && depth > 0) {
+            depth--;
+        }
+    }
+
+    return result + replaceHeight(style.slice(start));
+};
+
+export const transformStyleAttributes = (document: Element): void => {
+    const elements = [document, ...document.querySelectorAll('[style]')];
+
+    elements.forEach((element) => {
+        const style = element.getAttribute('style');
+
+        if (style === null) {
+            return;
+        }
+
+        const nextStyle = replaceViewportHeights(style);
+
+        if (nextStyle !== style) {
+            element.setAttribute('style', nextStyle);
+        }
+    });
+};
