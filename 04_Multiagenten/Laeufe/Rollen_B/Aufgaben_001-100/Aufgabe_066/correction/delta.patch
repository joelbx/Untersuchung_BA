+const hasViewportHeightUnit = (value: string): boolean => {
+    let unquotedValue = '';
+    let quote = '';
+    let inComment = false;
+
+    for (let index = 0; index < value.length; index++) {
+        const character = value[index];
+        const next = value[index + 1];
+
+        if (inComment) {
+            if (character === '*' && next === '/') {
+                inComment = false;
+                index++;
+            }
+        } else if (quote) {
+            if (character === '\\') {
+                index++;
+            } else if (character === quote) {
+                quote = '';
+            }
+        } else if (character === '/' && next === '*') {
+            inComment = true;
+            index++;
+            unquotedValue += ' ';
+        } else if (character === '"' || character === "'") {
+            quote = character;
+            unquotedValue += ' ';
+        } else {
+            unquotedValue += character;
+        }
+    }
+
+    return /(^|[^\w.])[+-]?(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?vh(?![\w-])/i.test(unquotedValue);
+};
+
 const replaceHeight = (declaration: string): string => {
