+def test_upgrade_no_deps_selects_compatible_parent(monkeypatch, tmp_path, galaxy_server):
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(to_bytes(tmp_path), validate_certs=False)
+    installed = Candidate('child.collection', '1.0.0', None, 'dir')
+    monkeypatch.setattr(galaxy_server, 'get_collection_versions',
+                        lambda namespace, name: ['1.0.0', '2.0.0'])
+    monkeypatch.setattr(collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_dependencies',
+                        lambda self, candidate: {
+                            'child.collection': '>=2.0.0' if candidate.ver == '2.0.0' else '>=1.0.0'
+                        } if candidate.fqcn == 'parent.collection' else {})
+    requirement = Requirement('parent.collection', '*', None, 'galaxy')
+    result = collection._resolve_depenency_map([requirement], [galaxy_server], manager, {installed},
+                                                True, False, upgrade=True)
+    assert result['parent.collection'].ver == '1.0.0'
+    assert result['child.collection'].ver == '1.0.0'
