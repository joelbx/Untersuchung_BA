+def test_serialize_languages(language_entries, expected):
+    languages = SimpleNamespace(
+        display_values=[
+            SimpleNamespace(display_value=name, type=language_type)
+            for name, language_type in language_entries
+        ]
+    )
+    item_info = ItemInfo(
+        classifications=None,
+        content_info=SimpleNamespace(
+            languages=languages,
+            publication_date=None,
+            pages_count=None,
+            edition=None,
+        ),
+        by_line_info=None,
+        title='',
+    )
+    product = AmazonAPIReply(item_info=item_info, images='', offers='', asin='')
+
+    result = AmazonAPI.serialize(product)
+
+    if expected is None:
+        assert 'languages' not in result
+    else:
+        assert result['languages'] == expected
