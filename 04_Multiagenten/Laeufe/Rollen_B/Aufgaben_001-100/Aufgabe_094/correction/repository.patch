@@ -79,9 +80,23 @@ var native nativeTID = &touchIDImpl{}
 type touchIDImpl struct{}
 
 func (touchIDImpl) IsAvailable() bool {
-	// TODO(codingllama): Write a deeper check that looks at binary
-	//  signature/entitlements/etc.
-	return true
+	diag, err := Diag()
+	return err == nil && diag.IsAvailable
+}
+
+// Diag checks the binary and the local authentication hardware for Touch ID.
+func Diag() (*DiagResult, error) {
+	nativeResult := C.DiagnoseTouchID()
+	result := &DiagResult{
+		HasCompileSupport:       true,
+		HasSignature:            nativeResult.has_signature != 0,
+		HasEntitlements:         nativeResult.has_entitlements != 0,
+		PassedLAPolicyTest:      nativeResult.passed_la_policy_test != 0,
+		PassedSecureEnclaveTest: nativeResult.passed_secure_enclave_test != 0,
+	}
+	result.IsAvailable = result.HasCompileSupport && result.HasSignature &&
+		result.HasEntitlements && result.PassedLAPolicyTest && result.PassedSecureEnclaveTest
+	return result, nil
 }
 
