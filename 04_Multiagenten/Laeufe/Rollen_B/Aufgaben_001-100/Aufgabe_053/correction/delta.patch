+// DetectPkgCves detects CVEs affecting the scanned OS packages.
+func DetectPkgCves(dbclient DBClient, r *models.ScanResult) error {
+	if _, err := DetectPkgsCvesWithOval(dbclient.OvalDB, r); err != nil {
+		return xerrors.Errorf("Failed to fill with OVAL: %w", err)
+	}
+	if _, err := DetectPkgsCvesWithGost(dbclient.GostDB, r, true); err != nil {
+		return xerrors.Errorf("Failed to fill with gost: %w", err)
+	}
+	return nil
+}
+
+// DetectGitHubCves detects CVEs from configured GitHub Security Alerts.
+func DetectGitHubCves(r *models.ScanResult) error {
+	return GithubSecurityAlerts(c.Conf.Servers[r.ServerName].GitHubRepos).apply(r, &integrationResults{})
+}
+
+// DetectWordPressCves detects CVEs from the configured WPVulnDB integration.
+func DetectWordPressCves(r *models.ScanResult) error {
+	cache := map[string]string{}
+	option := WordPressOption{
+		token:        c.Conf.Servers[r.ServerName].WordPress.WPVulnDBToken,
+		wpVulnCaches: &cache,
+	}
+	return option.apply(r, &integrationResults{})
+}
