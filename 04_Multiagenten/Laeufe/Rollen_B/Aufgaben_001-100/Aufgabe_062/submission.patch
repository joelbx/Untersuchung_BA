+// NotifyExit closes the stdin reader so an active password prompt can restore
+// the terminal before the process exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(io.Closer); ok {
+		_ = closer.Close()
+	}
+}
