+func TestContextReader_AbandonedPasswordRestoresTerminal(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ctx  func() context.Context
+		err  error
+	}{
+		{"canceled", func() context.Context {
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			return ctx
+		}, context.Canceled},
+		{"deadline", func() context.Context {
+			ctx, cancel := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+			t.Cleanup(cancel)
+			return ctx
+		}, context.DeadlineExceeded},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pr, pw := io.Pipe()
+			t.Cleanup(func() { pr.Close(); pw.Close() })
+			term := &fakeTerm{reader: pr}
+			cr := NewContextReader(pr)
+			cr.term, cr.fd = term, 0
+			t.Cleanup(func() { cr.Close() })
+
+			got, err := cr.ReadPassword(tc.ctx())
+			require.ErrorIs(t, err, tc.err)
+			require.Empty(t, got)
+			require.True(t, term.restoreCalled)
+			require.Equal(t, readerStateClean, cr.state)
+
+			go func() { _, _ = pw.Write([]byte("next")) }()
+			got, err = cr.ReadContext(context.Background())
+			require.NoError(t, err)
+			require.Equal(t, "next", string(got))
+		})
+	}
+}
+
+func TestContextReader_CloseRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr}
+	cr := NewContextReader(pr)
+	cr.term, cr.fd = term, 0
+
+	require.NoError(t, cr.firePasswordRead())
+	require.NoError(t, cr.Close())
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+	require.NoError(t, cr.Close())
+}
+
+func TestContextReader_RestoreError(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	restoreErr := errors.New("restore failed")
+	term := &fakeTerm{reader: pr, restoreErr: restoreErr}
+	cr := NewContextReader(pr)
+	cr.term, cr.fd = term, 0
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	got, err := cr.ReadPassword(ctx)
+	require.Empty(t, got)
+	require.ErrorIs(t, err, restoreErr)
+	require.Equal(t, readerStatePassword, cr.state)
+
+	require.ErrorIs(t, cr.Close(), restoreErr)
+	require.Equal(t, readerStateClosed, cr.state)
+}
