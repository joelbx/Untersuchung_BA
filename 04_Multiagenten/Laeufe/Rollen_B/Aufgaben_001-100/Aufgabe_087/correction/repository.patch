+func TestTelemetryEnvironment(t *testing.T) {
+	oldEnabled, hadEnabled := os.LookupEnv("FLIPT_META_TELEMETRY_ENABLED")
+	oldDirectory, hadDirectory := os.LookupEnv("FLIPT_META_STATE_DIRECTORY")
+	t.Cleanup(func() {
+		if hadEnabled {
+			os.Setenv("FLIPT_META_TELEMETRY_ENABLED", oldEnabled)
+		} else {
+			os.Unsetenv("FLIPT_META_TELEMETRY_ENABLED")
+		}
+		if hadDirectory {
+			os.Setenv("FLIPT_META_STATE_DIRECTORY", oldDirectory)
+		} else {
+			os.Unsetenv("FLIPT_META_STATE_DIRECTORY")
+		}
+	})
+	os.Setenv("FLIPT_META_TELEMETRY_ENABLED", "false")
+	os.Setenv("FLIPT_META_STATE_DIRECTORY", t.TempDir())
+	cfg, err := Load("./testdata/default.yml")
+	require.NoError(t, err)
+	assert.False(t, cfg.Meta.TelemetryEnabled)
+	assert.Equal(t, os.Getenv("FLIPT_META_STATE_DIRECTORY"), cfg.Meta.StateDirectory)
+}
