+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,136 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+func TestDisabled(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "missing")
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	cfg.Meta.TelemetryEnabled = false
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter = %v, %v", r, err)
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatalf("state directory created: %v", err)
+	}
+}
+
+func TestReporterStateAndDelivery(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	FliptVersion = "v1.2.3"
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	initial := r.state.UUID
+	if initial == "" || r.state.Version != schemaVersion {
+		t.Fatalf("bad initial state: %+v", r.state)
+	}
+	if r.state.LastTimestamp != initialTimestamp {
+		t.Fatalf("initial timestamp = %q", r.state.LastTimestamp)
+	}
+	r2, err := NewReporter(cfg, logrus.New())
+	if err != nil || r2.state.UUID != initial {
+		t.Fatalf("identity changed: %+v, %v", r2, err)
+	}
+	var got event
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if err := json.NewDecoder(req.Body).Decode(&got); err != nil {
+			t.Error(err)
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	r.endpoint = server.URL
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if got.Event != "flipt.ping" || got.AnonymousID != initial || got.Properties.UUID != initial || got.Properties.Version != schemaVersion || got.Properties.Flipt.Version != "v1.2.3" {
+		t.Fatalf("wrong event: %+v", got)
+	}
+	data, err := os.ReadFile(r.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var persisted state
+	if err := json.Unmarshal(data, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := time.Parse(time.RFC3339, persisted.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+	before := persisted.LastTimestamp
+	failure := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) { w.WriteHeader(http.StatusInternalServerError) }))
+	defer failure.Close()
+	r.endpoint = failure.URL
+	if err := r.Report(context.Background()); err == nil {
+		t.Fatal("expected delivery error")
+	}
+	data, _ = os.ReadFile(r.path)
+	if err := json.Unmarshal(data, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if persisted.LastTimestamp != before {
+		t.Fatalf("timestamp changed after failed report")
+	}
+}
+
+func TestMalformedStateAndDirectoryFile(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "telemetry.json")
+	if err := os.WriteFile(path, []byte(`{"version":"1.0","uuid":"invalid","lastTimestamp":"9999-01-01T00:00:00Z"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r.state.UUID == "invalid" {
+		t.Fatalf("invalid identity retained: %+v, %v", r, err)
+	}
+	if r.state.LastTimestamp != initialTimestamp {
+		t.Fatalf("repaired timestamp = %q", r.state.LastTimestamp)
+	}
+	cfg.Meta.StateDirectory = path
+	if _, err := NewReporter(cfg, logrus.New()); err == nil {
+		t.Fatal("file accepted as state directory")
+	}
+}
+
+func TestMalformedJSONIsLoggedAndRepaired(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "telemetry.json")
+	if err := os.WriteFile(path, []byte(`{invalid`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	logger := logrus.New()
+	var logs bytes.Buffer
+	logger.SetOutput(&logs)
+	r, err := NewReporter(cfg, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID == "" || r.state.LastTimestamp != initialTimestamp {
+		t.Fatalf("bad repaired state: %+v", r.state)
+	}
+	if !bytes.Contains(logs.Bytes(), []byte("reading telemetry state")) {
+		t.Fatalf("malformed state was not logged: %q", logs.String())
+	}
+}
