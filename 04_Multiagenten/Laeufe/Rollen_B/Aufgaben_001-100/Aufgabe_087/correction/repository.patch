+++ b/internal/info/flipt.go
@@ -0,0 +1,30 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt describes the running build and latest available release.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the build metadata as JSON.
+func (i Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(i)
+	if err != nil {
+		http.Error(w, "failed to serialize build info", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := w.Write(out); err != nil {
+		http.Error(w, "failed to write build info", http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..0904ab2
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,218 @@
+// Package telemetry reports anonymous installation usage.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion    = "1.0"
+	reportInterval   = 4 * time.Hour
+	telemetryURL     = "https://telemetry.flipt.io/v1/track"
+	initialTimestamp = "1970-01-01T00:00:00Z"
+)
+
+// FliptVersion is set by the server at startup from its build version.
+var FliptVersion = "dev"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type event struct {
+	Event       string `json:"event"`
+	AnonymousID string `json:"anonymousId"`
+	Properties  struct {
+		UUID    string `json:"uuid"`
+		Version string `json:"version"`
+		Flipt   struct {
+			Version string `json:"version"`
+		} `json:"flipt"`
+	} `json:"properties"`
+}
+
+// Reporter holds the persisted installation identity and sends usage events.
+type Reporter struct {
+	mu       sync.Mutex
+	path     string
+	state    state
+	version  string
+	logger   logrus.FieldLogger
+	client   *http.Client
+	endpoint string
+}
+
+// NewReporter initializes telemetry state. A disabled configuration never touches the filesystem.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding telemetry state directory: %w", err)
+		}
+		// Use the OS-specific user configuration directory directly.
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+	path := filepath.Join(dir, "telemetry.json")
+	r := &Reporter{path: path, version: FliptVersion, logger: logger, client: &http.Client{Timeout: 10 * time.Second}, endpoint: telemetryURL}
+	data, err := os.ReadFile(path)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.Warnf("reading telemetry state: %v", err)
+			r.state = state{}
+		}
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry UUID: %w", err)
+		}
+		r.state.UUID = id.String()
+		r.state.LastTimestamp = initialTimestamp
+	}
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		r.state.LastTimestamp = initialTimestamp
+	}
+	r.state.Version = schemaVersion
+	if err := r.writeState(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *Reporter) writeState() error {
+	data, err := json.Marshal(r.state)
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(r.path)
+	file, err := os.CreateTemp(dir, ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("creating telemetry state: %w", err)
+	}
+	defer os.Remove(file.Name())
+	if err := file.Chmod(0600); err != nil {
+		file.Close()
+		return err
+	}
+	if _, err := file.Write(data); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(file.Name(), r.path); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	return nil
+}
+
+// Report sends one anonymous ping and persists the time only after delivery succeeds.
+func (r *Reporter) Report(ctx context.Context) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	e := event{Event: "flipt.ping", AnonymousID: r.state.UUID}
+	e.Properties.UUID = r.state.UUID
+	e.Properties.Version = schemaVersion
+	e.Properties.Flipt.Version = r.version
+	data, err := json.Marshal(e)
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(data))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode)
+	}
+	previous := r.state.LastTimestamp
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.writeState(); err != nil {
+		r.state.LastTimestamp = previous
+		return err
+	}
+	return nil
+}
+
+// Start begins a context-bound reporting loop. It returns without blocking the caller.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, err := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			delay := time.Duration(0)
+			if err == nil {
+				delay = time.Until(last.Add(reportInterval))
+			}
+			if delay > 0 {
+				timer := time.NewTimer(delay)
+				select {
+				case <-ctx.Done():
+					if !timer.Stop() {
+						select {
+						case <-timer.C:
+						default:
+						}
+					}
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if err := r.Report(ctx); err != nil {
+				r.logger.Warnf("reporting telemetry: %v", err)
+			}
+			// A failed report should not spin. Retry on the next interval.
+			timer := time.NewTimer(reportInterval)
+			select {
+			case <-ctx.Done():
+				if !timer.Stop() {
+					select {
+					case <-timer.C:
+					default:
+					}
+				}
+				return
+			case <-timer.C:
+			}
+		}
+	}()
+}
