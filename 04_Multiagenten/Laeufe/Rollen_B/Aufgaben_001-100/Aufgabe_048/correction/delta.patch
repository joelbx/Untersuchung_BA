--- a/test/units/plugins/test_loader_context.py
+++ b/test/units/plugins/test_loader_context.py
@@ -55,6 +55,20 @@ def test_deprecation_is_recorded_without_warning(mocker):
     warning.assert_not_called()
 
 
+def test_get_with_context_emits_routed_deprecation(mocker):
+    loader = PluginLoader('ActionModule', 'ansible.plugins.action', [], 'action')
+    context = PluginLoadContext().record_deprecation(
+        'example.collection.old', {'warning_text': 'use new', 'removal_version': '2.0'}, 'example.collection')
+    mocker.patch.object(loader, 'find_plugin_with_context', return_value=context)
+    deprecated = mocker.patch('ansible.plugins.loader.display.deprecated')
+
+    result = loader.get_with_context('example.collection.old')
+
+    assert result.object is None
+    assert result.plugin_load_context is context
+    deprecated.assert_called_once_with(msg='use new', version='2.0', date=None, collection_name='example.collection')
+
