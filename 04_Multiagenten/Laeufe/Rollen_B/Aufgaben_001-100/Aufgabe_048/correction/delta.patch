 # These are internal utility functions only needed for templating.  They're
 # algorithmic so good candidates for unittesting by themselves
 
 
+def test_removed_filter_without_file_raises_template_error(mocker):
+    loader = Jinja2Loader('FilterModule', 'ansible.plugins.filter', [], 'filter_plugins')
+    mocker.patch.object(loader, '_query_collection_routing_meta', return_value={
+        'tombstone': {'removal_version': '2.0'},
+    })
+    enumerate_files = mocker.patch('ansible.template.pkgutil.iter_modules')
+
+    filters = JinjaPluginIntercept({}, loader)
+    with unittest.TestCase().assertRaisesRegex(TemplateSyntaxError, 'example.collection.old was removed'):
+        filters['example.collection.old']
+
+    enumerate_files.assert_not_called()
+
+
+def test_deprecated_filter_without_matching_file_warns(mocker):
+    loader = mocker.Mock(class_name='FilterModule')
+    context = PluginLoadContext().record_deprecation(
+        'example.collection.old', {'warning_text': 'use new'}, 'example.collection')
+    loader.find_plugin_with_context.return_value = context
+    mocker.patch('ansible.template.import_module', return_value=mocker.Mock(__path__=[]))
+    mocker.patch('ansible.template.pkgutil.iter_modules', return_value=[])
+    deprecated = mocker.patch('ansible.template.display.deprecated')
+
+    with unittest.TestCase().assertRaises(KeyError):
+        JinjaPluginIntercept({}, loader)['example.collection.old']
+
+    deprecated.assert_called_once_with(msg='use new', version=None, date=None, collection_name='example.collection')
+
