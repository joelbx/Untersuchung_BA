+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+func TestResource(t *testing.T) {
+	t.Setenv("OTEL_SERVICE_NAME", "environment-service")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "deployment.environment=test,custom.key=value")
+	res, err := newResource(context.Background(), "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	attrs := map[attribute.Key]string{}
+	for _, attr := range res.Attributes() {
+		attrs[attr.Key] = attr.Value.AsString()
+	}
+	for key, want := range map[attribute.Key]string{
+		"service.name": "environment-service", "service.version": "1.2.3",
+		"deployment.environment": "test", "custom.key": "value",
+	} {
+		if got := attrs[key]; got != want {
+			t.Errorf("%s = %q, want %q", key, got, want)
+		}
+	}
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "")
+	res, err = newResource(context.Background(), "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	attrs = map[attribute.Key]string{}
+	for _, attr := range res.Attributes() {
+		attrs[attr.Key] = attr.Value.AsString()
+	}
+	if attrs["service.name"] != "flipt" {
+		t.Errorf("default service name = %q", attrs["service.name"])
+	}
+}
+
+func TestProviderSamples(t *testing.T) {
+	provider, err := NewProvider(context.Background(), "1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer provider.Shutdown(context.Background())
+	_, span := provider.Tracer("test").Start(context.Background(), "sample")
+	defer span.End()
+	if !span.IsRecording() || !span.SpanContext().IsSampled() {
+		t.Fatal("provider did not sample span")
+	}
+}
+
+func TestGetExporter(t *testing.T) {
+	ctx := context.Background()
+	cases := []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"otlp-http", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"otlp-https", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"otlp-grpc", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317", Headers: map[string]string{"key": "value"}}}},
+		{"otlp-bare", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317", Headers: map[string]string{"key": "value"}}}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			exp, shutdown, err := GetExporter(ctx, &tc.cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if exp == nil || shutdown == nil {
+				t.Fatal("missing exporter or shutdown")
+			}
+			if err := shutdown(ctx); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	// A failed call must not poison a later configuration, and successful calls
+	// must each own their own exporter and shutdown callback.
+	for _, endpoint := range []string{"", "http://", "ftp://localhost:4318", "grpc://localhost:4317/path", "http://[invalid"} {
+		_, _, err := GetExporter(ctx, &config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: endpoint}})
+		if err == nil || !strings.Contains(err.Error(), "parsing otlp endpoint") {
+			t.Errorf("%q: expected endpoint error, got %v", endpoint, err)
+		}
+	}
+	_, _, err := GetExporter(ctx, &config.TracingConfig{Exporter: config.TracingExporter(99)})
+	if err == nil || err.Error() != "unsupported tracing exporter: 99" {
+		t.Errorf("unsupported exporter error = %v", err)
+	}
+	first, firstShutdown, err := GetExporter(ctx, &cases[0].cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, secondShutdown, err := GetExporter(ctx, &cases[1].cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("different configurations shared exporter")
+	}
+	if err := firstShutdown(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := secondShutdown(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestOTLPHTTPTransport(t *testing.T) {
+	requests := make(chan *http.Request, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	ctx := context.Background()
+	exporter, shutdown, err := GetExporter(ctx, &config.TracingConfig{
+		Exporter: config.TracingOTLP,
+		OTLP: config.OTLPTracingConfig{
+			Endpoint: server.URL + "/custom/traces",
+			Headers:  map[string]string{"X-Trace-Test": "configured"},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSpanProcessor(tracesdk.NewSimpleSpanProcessor(exporter)))
+	_, span := provider.Tracer("transport-test").Start(ctx, "sample")
+	span.End()
+	if err := provider.Shutdown(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := shutdown(ctx); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case request := <-requests:
+		if request.URL.Path != "/custom/traces" || request.Header.Get("X-Trace-Test") != "configured" {
+			t.Errorf("request path = %q, header = %q", request.URL.Path, request.Header.Get("X-Trace-Test"))
+		}
+	default:
+		t.Fatal("exporter did not send trace")
+	}
+}
