 func (m notMatcher) Match(in string) bool { return !m.matcher.Match(in) }
 
+// templateEnd finds a closing delimiter outside of quoted Go literals.
+func templateEnd(value string, start int) int {
+	var quote byte
+	for i := start + 2; i < len(value); i++ {
+		c := value[i]
+		if quote != 0 {
+			if c == '\\' && quote != '`' {
+				i++
+			} else if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' || c == '\'' || c == '`' {
+			quote = c
+		} else if c == '}' && i+1 < len(value) && value[i+1] == '}' {
+			return i
+		}
+	}
+	return -1
+}
