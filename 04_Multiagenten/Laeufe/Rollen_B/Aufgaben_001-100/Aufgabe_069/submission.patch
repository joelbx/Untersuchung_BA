+// Matcher tests whether a string satisfies a match expression.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct{ regexp *regexp.Regexp }
+
+func (m regexpMatcher) Match(in string) bool { return m.regexp.MatchString(in) }
+
+type prefixSuffixMatcher struct {
+	prefix, suffix string
+	matcher        Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct{ matcher Matcher }
+
+func (m notMatcher) Match(in string) bool { return !m.matcher.Match(in) }
+
+// templateEnd finds a closing delimiter outside of quoted Go literals.
+func templateEnd(value string, start int) int {
+	var quote byte
+	for i := start + 2; i < len(value); i++ {
+		c := value[i]
+		if quote != 0 {
+			if c == '\\' && quote != '`' {
+				i++
+			} else if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' || c == '\'' || c == '`' {
+			quote = c
+		} else if c == '}' && i+1 < len(value) && value[i+1] == '}' {
+			return i
+		}
+	}
+	return -1
+}
+
+// Match parses a literal, glob, regexp, or a single matcher function in a template.
+func Match(value string) (Matcher, error) {
+	start := strings.Index(value, "{{")
+	if start < 0 && !strings.Contains(value, "}}") {
+		pattern := value
+		if !strings.HasPrefix(pattern, "^") || !strings.HasSuffix(pattern, "$") {
+			pattern = "^" + utils.GlobToRegexp(pattern) + "$"
+		}
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+		}
+		return regexpMatcher{regexp: re}, nil
+	}
+	end := -1
+	if start >= 0 {
+		end = templateEnd(value, start)
+	}
+	if start < 0 || end < start+2 || strings.ContainsAny(value[:start], "{}") || strings.ContainsAny(value[end+2:], "{}") {
+		return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+	}
+
+	expression := value[start+2 : end]
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	matcher, err := matcherExpression(expr, expression)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return prefixSuffixMatcher{prefix: value[:start], suffix: value[end+2:], matcher: matcher}, nil
+}
+
+func matcherExpression(expr ast.Expr, expression string) (Matcher, error) {
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	namespace, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	if namespace.Name != "regexp" && namespace.Name != EmailNamespace {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+	name := namespace.Name + "." + selector.Sel.Name
+	if namespace.Name == EmailNamespace {
+		if selector.Sel.Name != EmailLocalFnName {
+			return nil, trace.BadParameter("unsupported function %s, supported functions are: email.local", name)
+		}
+	} else if selector.Sel.Name != "match" && selector.Sel.Name != "not_match" {
+		return nil, trace.BadParameter("unsupported function %s, supported functions are: regexp.match, regexp.not_match.", name)
+	}
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("%s requires exactly one string literal argument", name)
+	}
+	arg, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || arg.Kind != token.STRING {
+		return nil, trace.BadParameter("%s requires exactly one string literal argument", name)
+	}
+	raw, err := strconv.Unquote(arg.Value)
+	if err != nil {
+		return nil, trace.BadParameter("invalid string literal in %s: %v", name, err)
+	}
+	if namespace.Name == EmailNamespace {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	re, err := regexp.Compile(raw)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", raw, err)
+	}
+	var matcher Matcher = regexpMatcher{regexp: re}
+	if selector.Sel.Name == "not_match" {
+		matcher = notMatcher{matcher: matcher}
+	}
+	return matcher, nil
+}
+
+func containsMatcherFunction(expr ast.Expr) bool {
+	found := false
+	ast.Inspect(expr, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		namespace, ok := selector.X.(*ast.Ident)
+		if ok && namespace.Name == "regexp" && (selector.Sel.Name == "match" || selector.Sel.Name == "not_match") {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
