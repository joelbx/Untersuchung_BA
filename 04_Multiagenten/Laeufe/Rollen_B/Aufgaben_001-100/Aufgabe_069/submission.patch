+func TestMatch(t *testing.T) {
+	tests := []struct {
+		name, expression string
+		matches          []string
+		misses           []string
+	}{
+		{"literal", "foo.bar", []string{"foo.bar"}, []string{"fooXbar", "xfoo.bar"}},
+		{"wildcard", "foo*bar", []string{"foobar", "foo-middle-bar"}, []string{"xfoobar", "foobars"}},
+		{"all", "*", []string{"", "anything"}, nil},
+		{"raw regexp", "^foo[0-9]+$", []string{"foo12"}, []string{"xfoo12", "foo"}},
+		{"regexp match", `{{regexp.match("foo")}}`, []string{"foo", "before foo after"}, []string{"bar"}},
+		{"regexp quantifier", `{{regexp.match("^a{2}$")}}`, []string{"aa"}, []string{"a", "aaa"}},
+		{"quoted delimiter", `{{regexp.match("}}")}}`, []string{"}}", "before }} after"}, []string{"other"}},
+		{"regexp not match", `{{regexp.not_match("foo")}}`, []string{"bar"}, []string{"foo", "before foo after"}},
+		{"prefix suffix", `foo-{{regexp.match("bar")}}-baz`, []string{"foo-bar-baz", "foo-xxbarxx-baz"}, []string{"bar", "foo-bar", "foo-bar-baz-extra"}},
+		{"overlapping prefix suffix", `ab{{regexp.match(".*")}}bc`, []string{"abbc"}, []string{"abc"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			matcher, err := Match(tt.expression)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, in := range tt.matches {
+				assert.True(t, matcher.Match(in), "input %q", in)
+			}
+			for _, in := range tt.misses {
+				assert.False(t, matcher.Match(in), "input %q", in)
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		input, message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{regexp.match("}}")`, `"{{regexp.match(\"}}\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, "unsupported function namespace other, supported namespaces are email and regexp"},
+		{`{{regexp.other("foo")}}`, "unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match."},
+		{`{{email.other("foo")}}`, "unsupported function email.other, supported functions are: email.local"},
+		{`{{regexp.match("[")}}`, `failed parsing regexp "[": error parsing regexp: missing closing ]: `},
+		{`{{regexp.match()}}`, "regexp.match requires exactly one string literal argument"},
+		{`{{regexp.match("a", "b")}}`, "regexp.match requires exactly one string literal argument"},
+		{`{{regexp.match(external.foo)}}`, "regexp.match requires exactly one string literal argument"},
+		{`{{email.local("foo")}}`, `"email.local(\"foo\")" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{external.foo}}`, `"external.foo" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("a") + regexp.match("b")}}`, `"regexp.match(\"a\") + regexp.match(\"b\")" is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			_, err := Match(tt.input)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err))
+				assert.True(t, strings.HasPrefix(err.Error(), tt.message), "got %q", err)
+			}
+		})
+	}
+
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	if assert.Error(t, err) {
+		assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+	}
+	_, err = Variable(`{{regexp.match("^a{2}$")}}`)
+	if assert.Error(t, err) {
+		assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"^a{2}$\")}}"`)
+	}
+}
