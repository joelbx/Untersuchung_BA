diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..6ccbac0
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,57 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+// NewUserPropsRepository returns a repository scoped to the user in ctx.
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r *userPropsRepository) scope(key string) (Eq, error) {
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return nil, errors.New("user properties require a user in context")
+	}
+	return Eq{"user_id": user.ID, "key": key}, nil
+}
+
+func (r *userPropsRepository) Put(key, value string) error {
+	scope, err := r.scope(key)
+	if err != nil {
+		return err
+	}
+	_, err = r.executeSQL(Insert(r.tableName).Columns("user_id", "key", "value").
+		Values(scope["user_id"], key, value).
+		Suffix("ON CONFLICT(user_id, key) DO UPDATE SET value = excluded.value"))
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	scope, err := r.scope(key)
+	if err != nil {
+		return "", err
+	}
+	var result struct{ Value string }
+	err = r.queryOne(Select("value").From(r.tableName).Where(scope), &result)
+	return result.Value, err
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	scope, err := r.scope(key)
+	if err != nil {
+		return err
+	}
+	return r.delete(scope)
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..f2dcfd9
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,44 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("scopes reads, updates, and deletes to the contextual user", func() {
+		o := orm.NewOrm()
+		for _, id := range []string{"props-user-a", "props-user-b"} {
+			_, err := o.Raw(`insert into user (id, user_name, email, created_at, updated_at)
+				values (?, ?, ?, current_timestamp, current_timestamp)`, id, id, id+"@example.com").Exec()
+			Expect(err).NotTo(HaveOccurred())
+		}
+
+		first := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-a"}), o)
+		second := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-b"}), o)
+		Expect(first.Put("session", "first")).To(Succeed())
+		_, err := second.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Put("session", "second")).To(Succeed())
+		Expect(first.Put("session", "updated")).To(Succeed())
+		Expect(first.Get("session")).To(Equal("updated"))
+		Expect(second.Get("session")).To(Equal("second"))
+		Expect(first.Delete("session")).To(Succeed())
+		_, err = first.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Get("session")).To(Equal("second"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("key", "value")).To(HaveOccurred())
+		_, err := repo.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(repo.Delete("key")).To(HaveOccurred())
+	})
+})
