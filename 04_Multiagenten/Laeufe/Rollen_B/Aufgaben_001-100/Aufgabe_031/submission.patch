+func TestLoadEnvironmentOverrides(t *testing.T) {
+	for _, key := range []string{"FLIPT_LOG_LEVEL", "FLIPT_SERVER_HTTP_PORT"} {
+		value, present := os.LookupEnv(key)
+		require.NoError(t, os.Unsetenv(key))
+		t.Cleanup(func() {
+			if present {
+				_ = os.Setenv(key, value)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		})
+	}
+
+	t.Run("defaults without a file", func(t *testing.T) {
+		res, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, Default().Log.Level, res.Config.Log.Level)
+		assert.Equal(t, Default().Server.HTTPPort, res.Config.Server.HTTPPort)
+	})
+
+	t.Run("environment overrides without a file", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8081")
+
+		res, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, "debug", res.Config.Log.Level)
+		assert.Equal(t, 8081, res.Config.Server.HTTPPort)
+	})
+
+	t.Run("environment overrides file values", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "9090")
+
+		res, err := Load("./testdata/advanced.yml")
+		require.NoError(t, err)
+		assert.Equal(t, "debug", res.Config.Log.Level)
+		assert.Equal(t, 9090, res.Config.Server.HTTPPort)
+	})
+}
