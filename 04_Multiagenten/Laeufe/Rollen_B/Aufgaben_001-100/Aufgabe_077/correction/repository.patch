diff --git a/test/units/module_utils/basic/test_deprecate_warn.py b/test/units/module_utils/basic/test_deprecate_warn.py
index 4d6999d..9069805 100644
--- a/test/units/module_utils/basic/test_deprecate_warn.py
+++ b/test/units/module_utils/basic/test_deprecate_warn.py
@@ -6,6 +6,7 @@
 import json
 
 import pytest
+import ansible.module_utils.common.warnings as warnings
 
 
 @pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
@@ -49,3 +50,22 @@ def test_deprecate_without_list(am, capfd):
     assert output['deprecations'] == [
         {u'msg': u'Simple deprecation warning', u'version': None},
     ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_with_date(am, capfd, monkeypatch):
+    monkeypatch.setattr(warnings, '_global_deprecations', [])
+    am.deprecate('dated', date='2030-01-02')
+    with pytest.raises(SystemExit):
+        am.exit_json(deprecations=[{'msg': 'later', 'date': '2031-02-03'}])
+    out, err = capfd.readouterr()
+    assert json.loads(out)['deprecations'] == [
+        {'msg': 'dated', 'date': '2030-01-02'},
+        {'msg': 'later', 'date': '2031-02-03'},
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_rejects_version_and_date(am):
+    with pytest.raises(AssertionError, match='^implementation error -- version and date must not both be set$'):
+        am.deprecate('invalid', version='2.0', date='2030-01-02')
