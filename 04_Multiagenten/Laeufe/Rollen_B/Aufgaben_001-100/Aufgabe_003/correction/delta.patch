@@ -74,6 +74,19 @@ func (ms *mediaStreamer) DoStream(ctx context.Context, mf *model.MediaFile, reqF
 	s := &Stream{ctx: ctx, mf: mf, format: format, bitRate: bitRate}
 
 	if format == "raw" {
+		if timeOffset > 0 {
+			// A file's byte position does not reliably identify a playback time (in
+			// particular for variable bitrate audio). Let FFmpeg seek by timestamp.
+			command, outputFormat := rawOffsetCommand(mf.Suffix)
+			r, err := ms.transcoder.Transcode(ctx, command, mf.Path, mf.BitRate, timeOffset)
+			if err != nil {
+				return nil, err
+			}
+			s.ReadCloser = r
+			s.format = outputFormat
+			s.bitRate = mf.BitRate
+			return s, nil
+		}
 		log.Debug(ctx, "Streaming RAW file", "id", mf.ID, "path", mf.Path,
 			"requestBitrate", reqBitRate, "requestFormat", reqFormat,
 			"originalBitrate", mf.BitRate, "originalFormat", mf.Suffix,
@@ -113,6 +126,22 @@ func (ms *mediaStreamer) DoStream(ctx context.Context, mf *model.MediaFile, reqF
 	return s, nil
 }
 
+// rawOffsetCommand copies audio into its original container when that container
+// can be written to a pipe. Other formats are encoded as MP3 for streaming.
+func rawOffsetCommand(suffix string) (command, outputFormat string) {
+	muxer := map[string]string{
+		"mp3": "mp3", "flac": "flac", "ogg": "ogg", "opus": "opus",
+		"aac": "adts", "wav": "wav", "aiff": "aiff", "wma": "asf", "wv": "wv",
+	}[suffix]
+	if muxer != "" {
+		return "ffmpeg -i %s -ss %t -map 0:a:0 -c:a copy -f " + muxer + " -", suffix
+	}
+	if suffix == "m4a" || suffix == "mp4" {
+		return "ffmpeg -i %s -ss %t -map 0:a:0 -c:a copy -movflags frag_keyframe+empty_moov -f mp4 -", suffix
+	}
+	return "ffmpeg -i %s -ss %t -map 0:a:0 -b:a %bk -f mp3 -", "mp3"
+}
+
 type Stream struct {
 	ctx     context.Context
 	mf      *model.MediaFile
