+func TestSetScanResultMeta(t *testing.T) {
+	cases := []struct {
+		name, artifact, artifactType, resultType, wantServer, wantRelease, wantFamily string
+		os                                                                            *ftypes.OS
+	}{
+		{"image without tag", "redis", "container_image", "debian", "redis:latest", "10.10", "debian", &ftypes.OS{Name: "10.10"}},
+		{"image with tag", "redis:7", "container_image", "debian", "redis:7", "", "debian", &ftypes.OS{}},
+		{"library only", "/data/lib", "filesystem", "jar", "/data/lib", "", "pseudo", nil},
+		{"library image", "example/lib", "container_image", "jar", "example/lib:latest", "", "pseudo", nil},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			report := &types.Report{
+				ArtifactName: tc.artifact,
+				ArtifactType: ftypes.ArtifactType(tc.artifactType),
+				Metadata:     types.Metadata{OS: tc.os},
+				Results:      types.Results{{Type: tc.resultType}},
+			}
+			result := &models.ScanResult{Optional: map[string]interface{}{"trivy-target": "old"}}
+			if err := setScanResultMeta(result, report); err != nil {
+				t.Fatal(err)
+			}
+			if result.ServerName != tc.wantServer || result.Release != tc.wantRelease || result.Family != tc.wantFamily || result.Optional != nil {
+				t.Errorf("metadata = (%q, %q, %q, %v), want (%q, %q, %q, nil)", result.ServerName, result.Release, result.Family, result.Optional, tc.wantServer, tc.wantRelease, tc.wantFamily)
+			}
+		})
+	}
