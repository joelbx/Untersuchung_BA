@@ -0,0 +1,74 @@
+package singleton_test
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/singleton"
+)
+
+func TestGetInstanceReusesConcreteType(t *testing.T) {
+	type instance struct{ id int }
+	calls := 0
+	first := singleton.GetInstance(func() *instance {
+		calls++
+		return &instance{id: 42}
+	})
+	second := singleton.GetInstance(func() *instance {
+		calls++
+		return &instance{id: 99}
+	})
+	if first != second || first.id != 42 || calls != 1 {
+		t.Fatalf("got first=%p second=%p calls=%d; want one instance and one constructor call", first, second, calls)
+	}
+}
+
+func TestGetInstanceSeparatesValueAndPointerTypes(t *testing.T) {
+	type instance struct{ id int }
+	valueCalls, pointerCalls := 0, 0
+	value := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 1}
+	})
+	pointer := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 2}
+	})
+	otherValue := singleton.GetInstance(func() instance { valueCalls++; return instance{id: 3} })
+	otherPointer := singleton.GetInstance(func() *instance { pointerCalls++; return &instance{id: 4} })
+	if value.id != 1 || otherValue != value || pointer.id != 2 || otherPointer != pointer || valueCalls != 1 || pointerCalls != 1 {
+		t.Fatalf("got value=%v otherValue=%v pointer=%p otherPointer=%p calls=%d,%d", value, otherValue, pointer, otherPointer, valueCalls, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type instance struct{ id int }
+	const workers = 20000
+	var calls int32
+	var start sync.WaitGroup
+	start.Add(1)
+	var done sync.WaitGroup
+	done.Add(workers)
+	results := make([]*instance, workers)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			start.Wait()
+			results[i] = singleton.GetInstance(func() *instance {
+				atomic.AddInt32(&calls, 1)
+				return &instance{id: 7}
+			})
+		}(i)
+	}
+	start.Done()
+	done.Wait()
+	if atomic.LoadInt32(&calls) != 1 {
+		t.Fatalf("constructor called %d times; want 1", atomic.LoadInt32(&calls))
+	}
+	for i, result := range results {
+		if result == nil || result != results[0] || result.id != 7 {
+			t.Fatalf("result %d does not match the singleton", i)
+		}
+	}
+}
