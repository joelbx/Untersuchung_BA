+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	for _, test := range []struct {
+		name, proxyConfig, wantAddr string
+		wantEnabled                 bool
+		wantError                   bool
+	}{
+		{"shorthand", "kube_listen_addr: 0.0.0.0:8080", "0.0.0.0:8080", true, false},
+		{"default port", "kube_listen_addr: example.com", "example.com:3026", true, false},
+		{"disabled legacy", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no", "0.0.0.0:8080", true, false},
+		{"enabled legacy", "kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8081", "0.0.0.0:8081", true, false},
+		{"conflict", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes", "", false, true},
+	} {
+		c.Log(test.name)
+		conf, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  " + test.proxyConfig + "\n"))
+		c.Assert(err, check.IsNil)
+		cfg := service.MakeDefaultConfig()
+		err = ApplyFileConfig(conf, cfg)
+		if test.wantError {
+			c.Assert(err, check.NotNil)
+			c.Assert(err.Error(), check.Matches, ".*kube_listen_addr.*kubernetes.*")
+			continue
+		}
+		c.Assert(err, check.IsNil)
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, test.wantEnabled)
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, test.wantAddr)
+	}
+}
+
+func (s *ConfigTestSuite) TestKubeServiceListenAddress(c *check.C) {
+	conf, err := ReadConfig(bytes.NewBufferString(`proxy_service:
+  listen_addr: 0.0.0.0:3023
+kubernetes_service:
+  enabled: yes
+  listen_addr: 0.0.0.0:8080
+`))
+	c.Assert(err, check.IsNil)
+	cfg := service.MakeDefaultConfig()
+	c.Assert(ApplyFileConfig(conf, cfg), check.IsNil)
+	c.Assert(cfg.Kube.ListenAddr.Addr, check.Equals, "0.0.0.0:8080")
+}
