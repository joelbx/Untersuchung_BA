+func TestDiffChangesAndPackages(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"new":    {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}},
+			"shared": {CveID: "shared"},
+		},
+		Packages: models.Packages{"new-package": {Name: "new-package", Version: "current"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"resolved": {CveID: "resolved", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+			"shared":   {CveID: "shared"},
+		},
+		Packages: models.Packages{"old-package": {Name: "old-package", Version: "previous"}},
+	}
+	for _, tc := range []struct {
+		name        string
+		plus, minus bool
+		statuses    map[string]models.DiffStatus
+		packages    models.Packages
+	}{
+		{"plus", true, false, map[string]models.DiffStatus{"new": models.DiffPlus}, current.Packages},
+		{"minus", false, true, map[string]models.DiffStatus{"resolved": models.DiffMinus}, previous.Packages},
+		{"both", true, true, map[string]models.DiffStatus{"new": models.DiffPlus, "resolved": models.DiffMinus}, models.Packages{"new-package": current.Packages["new-package"], "old-package": previous.Packages["old-package"]}},
+		{"neither", false, false, map[string]models.DiffStatus{}, models.Packages{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tc.plus, tc.minus)
+			if err != nil || len(results) != 1 {
+				t.Fatalf("diff results: %v, %v", results, err)
+			}
+			got := results[0]
+			if len(got.ScannedCves) != len(tc.statuses) {
+				t.Errorf("CVEs: got %v, want %v", got.ScannedCves, tc.statuses)
+			}
+			for id, status := range tc.statuses {
+				if got.ScannedCves[id].DiffStatus != status {
+					t.Errorf("%s status: got %q, want %q", id, got.ScannedCves[id].DiffStatus, status)
+				}
+			}
+			if !reflect.DeepEqual(got.Packages, tc.packages) {
+				t.Errorf("packages: got %v, want %v", got.Packages, tc.packages)
+			}
+		})
+	}
+}
