--- /dev/null
+++ b/models/diff_test.go
@@ -0,0 +1,29 @@
+package models
+
+import "testing"
+
+func TestCveIDDiffFormatAndCount(t *testing.T) {
+	infos := VulnInfos{
+		"new":      {CveID: "new", DiffStatus: DiffPlus},
+		"resolved": {CveID: "resolved", DiffStatus: DiffMinus},
+		"same":     {CveID: "same"},
+	}
+	plus, minus := infos.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Fatalf("CountDiff() = (%d, %d), want (1, 1)", plus, minus)
+	}
+	for _, tc := range []struct {
+		id, want string
+	}{
+		{"new", "+new"},
+		{"resolved", "-resolved"},
+		{"same", "same"},
+	} {
+		if got := infos[tc.id].CveIDDiffFormat(true); got != tc.want {
+			t.Errorf("diff format for %s = %q, want %q", tc.id, got, tc.want)
+		}
+		if got := infos[tc.id].CveIDDiffFormat(false); got != tc.id {
+			t.Errorf("plain format for %s = %q", tc.id, got)
+		}
+	}
+}
