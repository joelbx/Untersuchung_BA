diff --git a/lib/ai/model/tokencount.go b/lib/ai/model/tokencount.go
new file mode 100644
index 0000000..3d852d0
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,138 @@
+package model
+
+import (
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// TokenCounter reports a token count.
+type TokenCounter interface{ TokenCount() int }
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll sums all counters.
+func (c TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range c {
+		if counter != nil {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount tracks prompt and completion usage across requests.
+type TokenCount struct {
+	mu         sync.RWMutex
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+func (c *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.prompt = append(c.prompt, prompt)
+}
+func (c *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion == nil {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.completion = append(c.completion, completion)
+}
+
+// CountAll returns prompt tokens, then completion tokens.
+func (c *TokenCount) CountAll() (int, int) {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.prompt.CountAll(), c.completion.CountAll()
+}
+
+// StaticTokenCounter holds a fixed token count.
+type StaticTokenCounter struct{ count int }
+
+func (c *StaticTokenCounter) TokenCount() int { return c.count }
+
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	encoding := codec.NewCl100kBase()
+	count := 0
+	for _, message := range messages {
+		tokens, _, err := encoding.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter counts streaming tokens and can be finalized once.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+func (c *AsynchronousTokenCounter) Add() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count++
+	return nil
+}
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
+
+// streamingTokenCounter tracks the full stream so token boundaries across deltas
+// are counted correctly. Reading it does not stop the stream.
+type streamingTokenCounter struct {
+	mu    sync.RWMutex
+	text  string
+	count int
+}
+
+func (c *streamingTokenCounter) append(delta string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.text += delta
+	tokens, _, err := codec.NewCl100kBase().Encode(c.text)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	c.count = perRequest + len(tokens)
+	return nil
+}
+func (c *streamingTokenCounter) TokenCount() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.count
+}
diff --git a/lib/ai/model/tokencount_test.go b/lib/ai/model/tokencount_test.go
new file mode 100644
index 0000000..bd5f552
--- /dev/null
+++ b/lib/ai/model/tokencount_test.go
@@ -0,0 +1,34 @@
+package model
+
+import (
+	"testing"
+
+	"github.com/sashabaranov/go-openai"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTokenCounters(t *testing.T) {
+	prompt, err := NewPromptTokenCounter([]openai.ChatCompletionMessage{{Role: openai.ChatMessageRoleUser, Content: "Hello"}})
+	require.NoError(t, err)
+	require.Equal(t, perMessage+perRole+1, prompt.TokenCount())
+	completion, err := NewSynchronousTokenCounter("Hello")
+	require.NoError(t, err)
+	require.Equal(t, perRequest+1, completion.TokenCount())
+	count := NewTokenCount()
+	count.AddPromptCounter(nil)
+	count.AddCompletionCounter(nil)
+	count.AddPromptCounter(prompt)
+	count.AddCompletionCounter(completion)
+	p, c := count.CountAll()
+	require.Equal(t, prompt.TokenCount(), p)
+	require.Equal(t, completion.TokenCount(), c)
+}
+
+func TestAsynchronousTokenCounter(t *testing.T) {
+	counter, err := NewAsynchronousTokenCounter("Hello")
+	require.NoError(t, err)
+	require.NoError(t, counter.Add())
+	require.Equal(t, perRequest+2, counter.TokenCount())
+	require.Equal(t, perRequest+2, counter.TokenCount())
+	require.Error(t, counter.Add())
+}
