+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages = models.NewPackages(models.Package{
+		Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64",
+	})
+	stdout := `libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 40.el7 x86_64
+libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 39.el7 x86_64
+error: file /root/private: Permission denied
+file /tmp/unowned is not owned by any package
+error: file /tmp/gone: No such file or directory
+`
+	packs, err := r.parseOwnerPkgs(stdout)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(packs) != 1 || packs[0].Arch != "x86_64" {
+		t.Fatalf("unexpected owners: %+v", packs)
+	}
+	if _, err := r.parseOwnerPkgs(stdout + "unexpected rpm output\n"); err == nil {
+		t.Fatal("expected malformed RPM output to return an error")
+	}
+}
