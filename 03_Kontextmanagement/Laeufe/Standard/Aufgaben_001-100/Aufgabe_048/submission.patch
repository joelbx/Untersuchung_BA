+    def test_tombstone_retains_context(self):
+        loader = PluginLoader('FilterModule', 'ansible.plugins.filter', None, 'filter_plugins')
+        routing = {'tombstone': {'removal_version': '2.0'}}
+        with patch.object(loader, '_query_collection_routing_meta', return_value=routing):
+            with self.assertRaises(AnsiblePluginRemovedError) as raised:
+                loader.find_plugin_with_context('ansible.builtin.removed_filter')
+            context = raised.exception.plugin_load_context
