+            result = loader.get_with_context('missing')
+            self.assertIsNone(result.object)
+            self.assertIsInstance(result.plugin_load_context, PluginLoadContext)
+            self.assertIsNone(loader.get('missing'))
+            self.assertEqual(finder.call_count, 2)
