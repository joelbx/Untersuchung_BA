diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 0000000..e225e0c
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,61 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a Redis client from the cache configuration.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertPath != "" && cfg.CaCertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{
+			MinVersion:         tls.VersionTLS12,
+			InsecureSkipVerify: cfg.InsecureSkipTLS, //nolint:gosec // explicitly requested by the operator
+		}
+
+		var caBytes []byte
+		if cfg.CaCertPath != "" {
+			var err error
+			caBytes, err = os.ReadFile(cfg.CaCertPath)
+			if err != nil {
+				return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+			}
+		} else if cfg.CaCertBytes != "" {
+			caBytes = []byte(cfg.CaCertBytes)
+		}
+
+		if len(caBytes) > 0 {
+			roots := x509.NewCertPool()
+			if !roots.AppendCertsFromPEM(caBytes) {
+				return nil, errors.New("invalid redis CA certificate")
+			}
+			tlsConfig.RootCAs = roots
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 0000000..0c3517d
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,75 @@
+package redis
+
+import (
+	"crypto/tls"
+	"encoding/pem"
+	"net"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestNewClientTLS(t *testing.T) {
+	server := httptest.NewTLSServer(nil)
+	defer server.Close()
+	address := strings.TrimPrefix(server.URL, "https://")
+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.TLS.Certificates[0].Certificate[0]})
+	path := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(path, cert, 0600))
+
+	for _, tc := range []struct {
+		name string
+		cfg  config.RedisCacheConfig
+		root bool
+	}{
+		{"system CAs", config.RedisCacheConfig{RequireTLS: true}, false},
+		{"inline CA", config.RedisCacheConfig{RequireTLS: true, CaCertBytes: string(cert)}, true},
+		{"CA path", config.RedisCacheConfig{RequireTLS: true, CaCertPath: path}, true},
+		{"skip verification", config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, err := NewClient(tc.cfg)
+			require.NoError(t, err)
+			defer client.Close()
+			options := client.Options()
+			require.Equal(t, uint16(tls.VersionTLS12), options.TLSConfig.MinVersion)
+			require.Equal(t, tc.cfg.InsecureSkipTLS, options.TLSConfig.InsecureSkipVerify)
+			if tc.root {
+				require.NotNil(t, options.TLSConfig.RootCAs)
+				require.NotEmpty(t, options.TLSConfig.RootCAs.Subjects())
+			} else {
+				require.Nil(t, options.TLSConfig.RootCAs)
+			}
+			conn, err := tls.DialWithDialer(&net.Dialer{Timeout: time.Second}, "tcp", address, options.TLSConfig)
+			if tc.root || tc.cfg.InsecureSkipTLS {
+				require.NoError(t, err)
+				require.NoError(t, conn.Close())
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+
+	client, err := NewClient(config.RedisCacheConfig{})
+	require.NoError(t, err)
+	defer client.Close()
+	require.Nil(t, client.Options().TLSConfig)
+}
+
+func TestNewClientInvalidCA(t *testing.T) {
+	for _, cfg := range []config.RedisCacheConfig{
+		{RequireTLS: true, CaCertBytes: "invalid"},
+		{RequireTLS: true, CaCertPath: filepath.Join(t.TempDir(), "missing.pem")},
+		{RequireTLS: true, CaCertPath: "path", CaCertBytes: "bytes"},
+	} {
+		client, err := NewClient(cfg)
+		require.Error(t, err)
+		require.Nil(t, client)
+	}
+}
