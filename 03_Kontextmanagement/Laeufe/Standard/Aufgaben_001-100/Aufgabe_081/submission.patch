@@ -0,0 +1,55 @@
+package oidc
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestStateCookieDomainAndPath(t *testing.T) {
+	for _, tt := range []struct {
+		domain, wantDomain string
+	}{
+		{"localhost", ""},
+		{"example.com", "example.com"},
+	} {
+		t.Run(tt.domain, func(t *testing.T) {
+			middleware := NewHTTPMiddleware(config.AuthenticationSession{Domain: tt.domain})
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			middleware.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(recorder, request)
+
+			cookies := recorder.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, stateCookieKey, cookies[0].Name)
+			require.Equal(t, tt.wantDomain, cookies[0].Domain)
+			require.Equal(t, "/auth/v1/method/oidc/google/callback", cookies[0].Path)
+			require.NotEmpty(t, cookies[0].Value)
+			if tt.domain == "localhost" {
+				require.NotContains(t, recorder.Header().Get("Set-Cookie"), "Domain=")
+			}
+		})
+	}
+}
+
+func TestTokenCookieLocalhost(t *testing.T) {
+	middleware := NewHTTPMiddleware(config.AuthenticationSession{Domain: "localhost"})
+	recorder := httptest.NewRecorder()
+	require.NoError(t, middleware.ForwardResponseOption(nil, recorder, &auth.CallbackResponse{ClientToken: "token"}))
+	require.NotContains(t, recorder.Header().Get("Set-Cookie"), "Domain=")
+}
+
+func TestCallbackURL(t *testing.T) {
+	for _, host := range []string{"http://localhost:8080", "https://example.com:8443"} {
+		want := host + "/auth/v1/method/oidc/google/callback"
+		require.Equal(t, want, callbackURL(host, "google"))
+		require.Equal(t, want, callbackURL(host+"/", "google"))
+		require.Equal(t, host+"//auth/v1/method/oidc/google/callback", callbackURL(host+"//", "google"))
+		require.False(t, strings.Contains(callbackURL(host+"/", "google"), "//auth"))
+	}
+}
