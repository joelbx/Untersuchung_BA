+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationSessionDomainValidation(t *testing.T) {
+	for _, tt := range []struct {
+		name, domain, want string
+	}{
+		{"scheme and port", "http://localhost:8080", "localhost"},
+		{"https", "https://example.com:8443", "example.com"},
+		{"host and port", "example.com:8080", "example.com"},
+		{"host", "localhost", "localhost"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tt.domain},
+				Methods: AuthenticationMethods{OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true}},
+			}
+			require.NoError(t, cfg.validate())
+			require.Equal(t, tt.want, cfg.Session.Domain)
+		})
+	}
+
+	cfg := AuthenticationConfig{Session: AuthenticationSession{Domain: "http://%"}}
+	require.Error(t, cfg.validate())
+}
