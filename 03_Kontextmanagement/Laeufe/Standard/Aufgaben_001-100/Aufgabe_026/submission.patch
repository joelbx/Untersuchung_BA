+func TestUbuntuAPIVulnerabilityDetails(t *testing.T) {
+	v := VulnInfo{CveContents: NewCveContents(
+		CveContent{Type: Ubuntu, Summary: "Ubuntu summary"},
+		CveContent{Type: UbuntuAPI, Summary: "API summary", Cvss3Score: 8.1, Cvss3Severity: "HIGH"},
+		CveContent{Type: Nvd, Summary: "NVD summary"},
+	)}
+	if got := v.Titles("en", "ubuntu"); !reflect.DeepEqual(got, []CveContentStr{{Nvd, "NVD summary"}, {Ubuntu, "Ubuntu summary"}, {UbuntuAPI, "API summary"}}) {
+		t.Errorf("titles = %v", got)
+	}
+	if got := v.Summaries("en", "ubuntu"); !reflect.DeepEqual(got, []CveContentStr{{Ubuntu, "Ubuntu summary"}, {UbuntuAPI, "API summary"}, {Nvd, "NVD summary"}}) {
+		t.Errorf("summaries = %v", got)
+	}
+	if got := v.MaxCvss3Score(); got.Type != UbuntuAPI || got.Value.Score != 8.1 {
+		t.Errorf("CVSS v3 = %v", got)
+	}
+	if got := severityToCvssScoreRange("negligible"); got != "0.1-3.9" {
+		t.Errorf("negligible range = %q", got)
+	}
+	if got := severityToCvssScoreRoughly("negligible"); got != 3.9 {
+		t.Errorf("negligible score = %v", got)
+	}
+}
