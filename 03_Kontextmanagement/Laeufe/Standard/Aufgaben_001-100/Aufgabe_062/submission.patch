+
+func TestNotifyExitRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+	cr := NewContextReader(pr)
+	fake := &fakeTerm{reader: pr}
+	cr.term = fake
+	cr.fd = 0
+	cr.mu.Lock()
+	cr.state = readerStatePassword
+	cr.previousTermState = &term.State{}
+	cr.mu.Unlock()
+
+	stdinMU.Lock()
+	previous := stdin
+	stdin = cr
+	stdinMU.Unlock()
+	t.Cleanup(func() { SetStdin(previous) })
+
+	NotifyExit()
+	require.True(t, fake.restoreCalled)
+	_, err := cr.ReadPassword(context.Background())
+	require.ErrorIs(t, err, ErrReaderClosed)
+}
