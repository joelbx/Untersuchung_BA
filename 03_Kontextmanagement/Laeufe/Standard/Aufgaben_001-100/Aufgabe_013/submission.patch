+
 
 def jdump(text):
     try:
@@ -71,6 +74,29 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            macro = match.group(1)
+            if macro:
+                value = match.group(2)
+                if macro in ('I', 'C'):
+                    return "`%s'" % value
+                if macro == 'B':
+                    return '*%s*' % value
+                if macro == 'M':
+                    return '[%s]' % value
+                return value  # U()
+
+            macro = match.group(3)
+            if macro == 'L':
+                return '%s <%s>' % (match.group(4), match.group(5))
+            if macro == 'R':
+                return match.group(4)
+            return '\n-------------\n'
+
+        return _DOC_MACRO.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
