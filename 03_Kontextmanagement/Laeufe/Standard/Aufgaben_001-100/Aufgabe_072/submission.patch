 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
+import punycode from 'punycode.js';
+
+/** Extract the label immediately before the top-level domain without relying on browser URL parsing. */
+export const getHostnameWithRegex = (url: string): string => {
+    const match = /^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^/?#@]*@)?(?:[^./:?#]+\.)*([^./:?#]+)\.[^./:?#]+(?::\d+)?(?:[/?#]|$)/i.exec(url);
+    return match?.[1] || '';
+};
+
+/** Encode only the hostname, leaving the rest of the URL as written. */
+export const punycodeUrl = (url: string): string => {
+    const match = /^([a-z][a-z\d+.-]*:\/\/)([^/?#]+)([^?#]*)(\?[^#]*)?(#.*)?$/i.exec(url);
+    if (!match) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const parsed = new URL(url);
+    const [, protocol, authority, pathname, search = '', hash = ''] = match;
+    const hostStart = authority.lastIndexOf('@') + 1;
+    const hostAndPort = authority.slice(hostStart);
+    const hostMatch = /^(\[[^\]]+\]|[^:]+)(:\d*)?$/.exec(hostAndPort);
+    if (!hostMatch || !parsed.hostname) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const asciiHostname = punycode.toASCII(parsed.hostname);
+    const asciiAuthority = `${authority.slice(0, hostStart)}${asciiHostname}${hostMatch[2] || ''}`;
+    return `${protocol}${asciiAuthority}${pathname.replace(/\/+$/, '')}${search}${hash}`;
+};
 
