+    def test_jwrite_replaces_complete_record(self, monkeypatch, tmpdir):
+        jobpath = str(tmpdir.join('job'))
+        monkeypatch.setattr(async_wrapper, 'job_path', jobpath, raising=False)
+        async_wrapper.jwrite({'started': 1, 'finished': 0, 'ansible_job_id': 'job'})
+        async_wrapper.jwrite({'started': 1, 'finished': 1, 'ansible_job_id': 'job'})
+        with open(jobpath) as f:
+            assert json.load(f)['finished'] == 1
+        assert not os.path.exists(jobpath + '.tmp')
+
+    def test_module_exception_is_finished_failure(self, monkeypatch, tmpdir):
+        monkeypatch.setattr(async_wrapper, 'ipc_notifier', MagicMock())
+        jobpath = str(tmpdir.join('job'))
+        async_wrapper._run_module(str(tmpdir.join('missing_module')), 'job-id', jobpath)
+        with open(jobpath) as f:
+            record = json.load(f)
+        assert record['ansible_job_id'] == 'job-id'
+        assert record['started'] == 1
+        assert record['finished'] == 1
+        assert record['failed'] == 1
+        assert record['msg']
