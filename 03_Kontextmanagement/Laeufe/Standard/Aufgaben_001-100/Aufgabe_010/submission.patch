+
+import React from "react";
+import { shallow } from "enzyme";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import SenderProfile from "../../../../src/components/views/messages/SenderProfile";
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+import { RoomPermalinkCreator } from "../../../../src/utils/permalinks/Permalinks";
+
+describe("ReplyPreview", () => {
+    it("shows the recipient inline and names the cancel action", () => {
+        const replyToEvent = {} as MatrixEvent;
+        const wrapper = shallow(<ReplyPreview
+            replyToEvent={replyToEvent}
+            permalinkCreator={{} as RoomPermalinkCreator}
+        />);
+
+        expect(wrapper.find(".mx_ReplyPreview_header").text()).toContain("Replying to");
+        expect(wrapper.find(SenderProfile).prop("mxEvent")).toBe(replyToEvent);
+        expect(wrapper.find(SenderProfile).prop("element")).toBe("span");
+        expect(wrapper.find(CancelButton).prop("aria-label")).toBe("Cancel replying to a message");
+    });
+});
