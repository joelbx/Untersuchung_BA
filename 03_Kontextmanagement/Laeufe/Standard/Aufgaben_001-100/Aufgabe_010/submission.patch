+limitations under the License.
+*/
+
+import React from "react";
+import { mount } from "enzyme";
+
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+
+describe("CancelButton", () => {
+    it("renders a named, sized button and invokes the cancel action", () => {
+        const onClick = jest.fn();
+        const wrapper = mount(<CancelButton onClick={onClick} size="18" aria-label="Cancel reply" />);
+        const button = wrapper.find("button");
+
+        expect(button.prop("type")).toBe("button");
+        expect(button.prop("aria-label")).toBe("Cancel reply");
+        expect(button.prop("style")["--size"]).toBe("18px");
+
+        button.simulate("click");
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+});
