+class GzipDecodedReader(gzip.GzipFile if HAS_GZIP else object):
+    """Read a gzip HTTP response while preserving its response metadata."""
+
+    def __init__(self, fp):
+        if not HAS_GZIP:
+            raise MissingModuleError(self.missing_gzip_error(), None, module='gzip')
+        self._response = fp
+        # Python 2's addinfourl and Python 3's HTTPResponse both provide read().
+        super(GzipDecodedReader, self).__init__(fileobj=fp, mode='rb')
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    def close(self):
+        try:
+            super(GzipDecodedReader, self).close()
+        finally:
+            self._response.close()
+
+    @staticmethod
+    def missing_gzip_error():
+        return missing_required_lib('gzip', reason='to decompress gzip encoded HTTP responses')
 
 
