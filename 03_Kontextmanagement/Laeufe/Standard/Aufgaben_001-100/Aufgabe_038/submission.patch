+    body = b'{"error": "unavailable"}'
+    compressed = io.BytesIO()
+    with gzip.GzipFile(fileobj=compressed, mode='wb') as writer:
+        writer.write(body)
+    payload = compressed.getvalue()
+    open_url_mock.side_effect = urllib_error.HTTPError(
+        'http://ansible.com/', 500, 'Internal Server Error',
+        {'Content-Encoding': 'gzip'}, io.BytesIO(payload)
+    )
+
+    _, info = fetch_url(fake_ansible_module, 'http://ansible.com/', decompress=decompress)
+    assert info['body'] == (body if decompress else payload)
+    assert info['content-encoding'] == 'gzip'
+
