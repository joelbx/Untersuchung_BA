+// Package fanoutbuffer provides an ordered, concurrent buffer with independent readers.
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+var (
+	ErrGracePeriodExceeded = errors.New("fanout buffer grace period exceeded")
+	ErrUseOfClosedCursor   = errors.New("use of closed fanout buffer cursor")
+	ErrBufferClosed        = errors.New("fanout buffer closed")
+)
+
+// Config controls the size and time limits of a Buffer.
+type Config struct {
+	Capacity    uint64
+	GracePeriod time.Duration
+	Clock       clockwork.Clock
+}
+
+// SetDefaults fills in unset configuration fields.
+func (c *Config) SetDefaults() {
+	if c.Capacity == 0 {
+		c.Capacity = 64
+	}
+	if c.GracePeriod == 0 {
+		c.GracePeriod = 5 * time.Minute
+	}
+	if c.Clock == nil {
+		c.Clock = clockwork.NewRealClock()
+	}
+}
+
+// Buffer distributes appended items to all cursors that were present when they
+// were appended. Its fixed ring holds recent items; overflow holds items still
+// needed by readers that have fallen behind the ring.
+type Buffer[T any] struct {
+	mu            sync.Mutex
+	cfg           Config
+	ring          []T
+	ringStart     uint64
+	end           uint64
+	overflow      []T
+	overflowStart uint64
+	cursors       map[*Cursor[T]]struct{}
+	changed       chan struct{}
+	closed        bool
+}
+
+// NewBuffer creates a buffer with the given configuration.
+func NewBuffer[T any](cfg Config) *Buffer[T] {
+	cfg.SetDefaults()
+	return &Buffer[T]{
+		cfg:     cfg,
+		ring:    make([]T, int(cfg.Capacity)),
+		cursors: make(map[*Cursor[T]]struct{}),
+		changed: make(chan struct{}),
+	}
+}
+
+// signal wakes readers waiting for a change. The caller holds b.mu.
+func (b *Buffer[T]) signal() {
+	close(b.changed)
+	b.changed = make(chan struct{})
+}
+
+// NewCursor starts a reader at the next item appended to the buffer. A cursor
+// created after Close reports ErrBufferClosed on reads.
+func (b *Buffer[T]) NewCursor() *Cursor[T] {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	c := &Cursor[T]{buffer: b, next: b.end}
+	if !b.closed {
+		b.cursors[c] = struct{}{}
+	}
+	return c
+}
+
+// Append adds items in order. Appends after Close are ignored.
+func (b *Buffer[T]) Append(items ...T) {
+	if len(items) == 0 {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.expire()
+	if len(b.cursors) == 0 {
+		b.clear()
+		b.end += uint64(len(items))
+		b.ringStart = b.end
+		b.overflowStart = b.end
+		return
+	}
+	capacity := uint64(len(b.ring))
+	for _, item := range items {
+		if b.end-b.ringStart == capacity {
+			if len(b.overflow) == 0 {
+				b.overflowStart = b.ringStart
+			}
+			b.overflow = append(b.overflow, b.ring[b.ringStart%capacity])
+			var zero T
+			b.ring[b.ringStart%capacity] = zero
+			b.ringStart++
+		}
+		b.ring[b.end%capacity] = item
+		b.end++
+	}
+	if len(b.overflow) != 0 {
+		now := b.cfg.Clock.Now()
+		for c := range b.cursors {
+			if c.next < b.ringStart && !c.graceActive {
+				c.graceStart = now
+				c.graceActive = true
+			}
+		}
+	}
+	b.signal()
+}
+
+// Close releases buffered items and wakes all readers. It is safe to call more
+// than once.
+func (b *Buffer[T]) Close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.closed = true
+	b.clear()
+	b.cursors = nil
+	b.signal()
+}
+
+// Cursor reads the items appended after its creation in append order.
+type Cursor[T any] struct {
+	buffer      *Buffer[T]
+	next        uint64
+	graceStart  time.Time
+	graceActive bool
+	err         error
+	closed      bool
+}
+
+// TryRead copies available items into out without waiting. A zero length out
+// returns immediately and does not consume data.
+func (c *Cursor[T]) TryRead(out []T) (int, error) {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return c.tryRead(out)
+}
+
+// tryRead requires b.mu.
+func (c *Cursor[T]) tryRead(out []T) (int, error) {
+	b := c.buffer
+	if c.closed {
+		return 0, ErrUseOfClosedCursor
+	}
+	if b.closed {
+		return 0, ErrBufferClosed
+	}
+	if c.err != nil {
+		return 0, c.err
+	}
+	if c.expired() {
+		c.err = ErrGracePeriodExceeded
+		delete(b.cursors, c)
+		b.cleanup()
+		return 0, c.err
+	}
+	if len(out) == 0 || c.next == b.end {
+		return 0, nil
+	}
+	n := 0
+	if c.next < b.ringStart {
+		count := min(len(out), int(b.ringStart-c.next))
+		copy(out, b.overflow[c.next-b.overflowStart:c.next-b.overflowStart+uint64(count)])
+		c.next += uint64(count)
+		n += count
+	}
+	capacity := uint64(len(b.ring))
+	for n < len(out) && c.next < b.end {
+		count := min(len(out)-n, int(b.end-c.next), int(capacity-c.next%capacity))
+		copy(out[n:], b.ring[c.next%capacity:c.next%capacity+uint64(count)])
+		c.next += uint64(count)
+		n += count
+	}
+	if c.next >= b.ringStart {
+		c.graceActive = false
+	}
+	b.cleanup()
+	return n, nil
+}
+
+// Read waits for at least one item, a context cancellation, or a terminal error.
+func (c *Cursor[T]) Read(ctx context.Context, out []T) (int, error) {
+	if len(out) == 0 {
+		return c.TryRead(out)
+	}
+	b := c.buffer
+	for {
+		b.mu.Lock()
+		n, err := c.tryRead(out)
+		if n != 0 || err != nil {
+			b.mu.Unlock()
+			return n, err
+		}
+		changed := b.changed
+		var deadline <-chan time.Time
+		if c.graceActive {
+			remaining := c.graceStart.Add(b.cfg.GracePeriod).Sub(b.cfg.Clock.Now())
+			deadline = b.cfg.Clock.After(remaining)
+		}
+		b.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		case <-changed:
+		case <-deadline:
+		}
+	}
+}
+
+// Close releases a cursor's claim on unread items. Repeated calls are safe.
+func (c *Cursor[T]) Close() error {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	delete(b.cursors, c)
+	b.cleanup()
+	b.signal()
+	return nil
+}
+
+func (c *Cursor[T]) expired() bool {
+	return c.graceActive && !c.buffer.cfg.Clock.Now().Before(c.graceStart.Add(c.buffer.cfg.GracePeriod))
+}
+
+// expire removes readers whose grace period has elapsed before accepting more
+// items, so abandoned readers cannot retain the overflow indefinitely.
+func (b *Buffer[T]) expire() {
+	for c := range b.cursors {
+		if c.expired() {
+			c.err = ErrGracePeriodExceeded
+			delete(b.cursors, c)
+		}
+	}
+	b.cleanup()
+}
+
+// cleanup drops every item already seen by all live cursors.
+func (b *Buffer[T]) cleanup() {
+	if len(b.cursors) == 0 {
+		b.clear()
+		return
+	}
+	oldest := b.end
+	for c := range b.cursors {
+		if c.next < oldest {
+			oldest = c.next
+		}
+	}
+	if oldest > b.overflowStart && len(b.overflow) != 0 {
+		count := min(oldest-b.overflowStart, uint64(len(b.overflow)))
+		var zero T
+		for i := uint64(0); i < count; i++ {
+			b.overflow[i] = zero
+		}
+		b.overflow = b.overflow[count:]
+		b.overflowStart += count
+		if len(b.overflow) == 0 {
+			b.overflow = nil
+		}
+		if len(b.overflow) > 0 && cap(b.overflow) > 2*len(b.overflow) {
+			b.overflow = append([]T(nil), b.overflow...)
+		}
+	}
+	if oldest > b.ringStart {
+		capacity := uint64(len(b.ring))
+		var zero T
+		for i := b.ringStart; i < oldest; i++ {
+			b.ring[i%capacity] = zero
+		}
+		b.ringStart = oldest
+	}
+	if len(b.overflow) == 0 {
+		b.overflowStart = b.ringStart
+	}
+}
+
+func (b *Buffer[T]) clear() {
+	var zero T
+	capacity := uint64(len(b.ring))
+	for i := b.ringStart; i < b.end; i++ {
+		b.ring[i%capacity] = zero
+	}
+	b.overflow = nil
+	b.ringStart = b.end
+	b.overflowStart = b.end
+}
