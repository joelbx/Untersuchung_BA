+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestFanoutOverflowAndCleanup(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	got := make([]int, 5)
+	for _, c := range []*Cursor[int]{slow, fast} {
+		n, err := c.TryRead(got)
+		if err != nil || n != 5 || !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+			t.Fatalf("read: n=%d err=%v items=%v", n, err, got)
+		}
+	}
+	if len(b.overflow) != 0 || b.ringStart != b.end {
+		t.Fatalf("consumed items retained: overflow=%d ring=%d", len(b.overflow), b.end-b.ringStart)
+	}
+	b.Append(6)
+	n, err := fast.TryRead(got[:1])
+	if err != nil || n != 1 || got[0] != 6 {
+		t.Fatalf("next read: %d %v %v", n, err, got[0])
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 1, GracePeriod: time.Second, Clock: clock})
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2)
+	got := make([]int, 2)
+	if n, err := fast.TryRead(got); n != 2 || err != nil {
+		t.Fatalf("fast read: %d %v", n, err)
+	}
+	clock.Advance(time.Second)
+	if n, err := slow.TryRead(got); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow read: %d %v", n, err)
+	}
+	if len(b.overflow) != 0 {
+		t.Fatalf("overflow retained: %d", len(b.overflow))
+	}
+	b.Append(3)
+	if n, err := fast.TryRead(got); n != 1 || err != nil || got[0] != 3 {
+		t.Fatalf("fast after expiry: %d %v %v", n, err, got[0])
+	}
+}
+
+func TestReadWakeAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]int, 1)
+		n, err := c.Read(context.Background(), out)
+		if err == nil && (n != 1 || out[0] != 7) {
+			err = errors.New("wrong item")
+		}
+		result <- err
+	}()
+	b.Append(7)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	b.Close()
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("closed buffer: %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+}
+
+func TestBlockedReadStops(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read: %v", err)
+	}
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrUseOfClosedCursor) {
+			t.Fatalf("closed cursor: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read did not wake after cursor close")
+	}
+}
+
+func TestConcurrentReaders(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 8})
+	const readers, items = 8, 1000
+	cursors := make([]*Cursor[int], readers)
+	for i := range cursors {
+		cursors[i] = b.NewCursor()
+	}
+	var wg sync.WaitGroup
+	for _, c := range cursors {
+		wg.Add(1)
+		go func(c *Cursor[int]) {
+			defer wg.Done()
+			defer c.Close()
+			out := make([]int, 17)
+			for expected := 0; expected < items; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, v := range out[:n] {
+					if v != expected {
+						t.Errorf("got %d want %d", v, expected)
+						return
+					}
+					expected++
+				}
+			}
+		}(c)
+	}
+	for i := 0; i < items; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
