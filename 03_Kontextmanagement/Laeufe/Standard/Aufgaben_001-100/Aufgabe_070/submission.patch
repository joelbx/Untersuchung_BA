@@ -6,6 +6,12 @@ from unicodedata import normalize
 
 import web
 
+from openlibrary.plugins.upstream.utils import (
+    get_languages,
+    get_marc21_language,
+    strip_accents,
+)
+
 if TYPE_CHECKING:
     from openlibrary.plugins.upstream.models import Author
 
@@ -455,10 +461,36 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
         return []
 
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        token = language.strip().casefold()
+        code = get_marc21_language(token) or token
+        key = f'/languages/{code}'
+
+        if web.ctx.site.get(key) is None:
+            # Language records also carry ISO codes and names in multiple languages.
+            # Only accept a name when it identifies exactly one language.
+            normalized = strip_accents(token)
+            matches = set()
+            for record in get_languages().values():
+                data = record.dict()
+                identifiers = data.get('identifiers') or {}
+                names = [data['name']]
+                names.extend(
+                    name
+                    for translations in (data.get('name_translated') or {}).values()
+                    for name in translations
+                )
+                if token in identifiers.get('iso_639_1', []) or any(
+                    strip_accents(name.casefold()) == normalized for name in names
+                ):
+                    matches.add(record.key)
+            if len(matches) != 1:
+                raise InvalidLanguage(token)
+            key = matches.pop()
+
+        if key not in seen:
+            seen.add(key)
+            formatted_languages.append({'key': key})
 
     return formatted_languages
