diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..dee6512
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,64 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+const request = require('request-promise-native');
+
+require('./mocks/databasemock');
+
+const privileges = require('../src/privileges');
+const user = require('../src/user');
+const helpers = require('./helpers');
+
+describe('webfinger', () => {
+	let uid;
+	const hostname = () => nconf.get('url_parsed').hostname;
+	const endpoint = () => `${nconf.get('url')}/.well-known/webfinger`;
+	const get = async (resource, jar) => await request({
+		url: endpoint(),
+		qs: resource === undefined ? {} : { resource },
+		jar,
+		json: true,
+		simple: false,
+		resolveWithFullResponse: true,
+	});
+
+	before(async () => {
+		uid = await user.create({ username: 'webfinger-user', password: 'barbar' });
+	});
+
+	it('returns a JRD with both profile aliases', async () => {
+		const resource = `acct:webfinger-user@${hostname()}`;
+		const response = await get(resource);
+		const profileUrl = `${nconf.get('url')}/user/webfinger-user`;
+		assert.strictEqual(response.statusCode, 200);
+		assert.match(response.headers['content-type'], /^application\/jrd\+json/);
+		assert.strictEqual(response.body.subject, resource);
+		assert.deepStrictEqual(response.body.aliases, [
+			`${nconf.get('url')}/uid/${uid}`,
+			profileUrl,
+		]);
+		assert(response.body.links.some(link => link.href === profileUrl && link.type === 'text/html'));
+	});
+
+	it('rejects invalid resources', async () => {
+		const resources = [undefined, 'webfinger-user', `acct:webfinger-user@other.${hostname()}`, `acct:@${hostname()}`];
+		const responses = await Promise.all(resources.map(resource => get(resource)));
+		responses.forEach(response => assert.strictEqual(response.statusCode, 400));
+	});
+
+	it('returns 404 for an unknown user', async () => {
+		assert.strictEqual((await get(`acct:missing-webfinger-user@${hostname()}`)).statusCode, 404);
+	});
+
+	it('uses the Guest view users permission for anonymous requests', async () => {
+		await privileges.global.rescind(['groups:view:users'], 'guests');
+		try {
+			assert.strictEqual((await get(`acct:webfinger-user@${hostname()}`)).statusCode, 403);
+			const { jar } = await helpers.loginUser('webfinger-user', 'barbar');
+			assert.strictEqual((await get(`acct:webfinger-user@${hostname()}`, jar)).statusCode, 200);
+		} finally {
+			await privileges.global.give(['groups:view:users'], 'guests');
+		}
+	});
+});
