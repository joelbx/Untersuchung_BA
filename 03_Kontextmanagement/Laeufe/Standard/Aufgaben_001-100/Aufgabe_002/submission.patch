+// KubeAddr returns the public URL of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	addrs := c.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = c.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("no public proxy address configured")
+	}
+	// The public address may advertise the web proxy port. Kubernetes clients
+	// always need the Kubernetes proxy port.
+	for _, addr := range addrs {
+		if kubeAddr, err := kubePublicURL(addr.String()); err == nil {
+			return kubeAddr, nil
+		}
+	}
+	return "", trace.BadParameter("no valid public proxy address configured")
+}
+
+// kubePublicURL replaces the port of a public proxy address with the Kubernetes port.
+func kubePublicURL(addr string) (string, error) {
+	u, err := url.Parse("https://" + addr)
+	if err != nil || u.Hostname() == "" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" {
+		return "", trace.BadParameter("invalid public proxy address %q", addr)
+	}
+	if port := u.Port(); port != "" {
+		n, err := strconv.Atoi(port)
+		if err != nil || n < 1 || n > 65535 {
+			return "", trace.BadParameter("invalid public proxy address %q", addr)
+		}
+	}
+	u.Host = net.JoinHostPort(u.Hostname(), strconv.Itoa(defaults.KubeProxyListenPort))
+	return u.String(), nil
+}
