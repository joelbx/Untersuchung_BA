+func Test_redhatBase_parseInstalledPackagesLineFromRepoqueryBadSourceRPM(t *testing.T) {
+	o := &redhatBase{}
+	bp, sp, err := o.parseInstalledPackagesLineFromRepoquery("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm @custom")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64", Repository: "custom"}
+	if !reflect.DeepEqual(bp, want) || sp != nil || len(o.warns) != 1 {
+		t.Errorf("got binary=%+v, source=%+v, warnings=%v", bp, sp, o.warns)
+	}
+}
