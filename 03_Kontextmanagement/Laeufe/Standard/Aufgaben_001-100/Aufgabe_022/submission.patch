+func Test_redhatBase_parseInstalledPackagesContinuesAfterBadSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := bins["elasticsearch"]; !reflect.DeepEqual(got, models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"}) {
+		t.Errorf("elasticsearch binary = %+v", got)
+	}
+	if got := bins["bar"]; !reflect.DeepEqual(got, models.Package{Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64"}) {
+		t.Errorf("bar binary = %+v", got)
+	}
+	if len(srcs) != 1 || !reflect.DeepEqual(srcs["bar"], models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}}) {
+		t.Errorf("source packages = %+v", srcs)
+	}
+	if len(o.warns) != 1 {
+		t.Errorf("warnings = %v, want one", o.warns)
+	}
+}
