+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [displayName, setDisplayName] = useState(device.display_name);
+    const [isEditing, setIsEditing] = useState(false);
+    const [name, setName] = useState(device.display_name ?? '');
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    useEffect(() => setDisplayName(device.display_name), [device.display_name]);
+
+    const onSave = async (event: React.FormEvent): Promise<void> => {
+        event.preventDefault();
+        if (name === displayName) {
+            setIsEditing(false);
+            return;
+        }
+        setIsSaving(true);
+        setError(undefined);
+        try {
+            await saveDeviceName(device.device_id, name);
+            setDisplayName(name);
+            setIsEditing(false);
+        } catch {
+            setError('Failed to set display name.');
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (isEditing) {
+        return <form data-testid='device-detail-heading-edit' onSubmit={onSave}>
+            <label htmlFor={`device-name-${device.device_id}`}>{ _t('Session name') }</label>
+            <input
+                id={`device-name-${device.device_id}`}
+                data-testid='device-detail-heading-input'
+                type='text'
+                maxLength={100}
+                value={name}
+                disabled={isSaving}
+                onChange={event => setName(event.target.value)}
+            />
+            <p>{ _t('Session names may be visible to people you communicate with.') }</p>
+            { error && <p role='alert' data-testid='device-detail-heading-error'>{ error }</p> }
+            <button
+                type='submit'
+                className='mx_AccessibleButton mx_AccessibleButton_hasKind mx_AccessibleButton_kind_primary'
+                disabled={isSaving}
+                data-testid='device-detail-heading-save'
+            >
+                { _t('Save') }
+            </button>
+            <AccessibleButton
+                kind='link_inline'
+                onClick={() => { setIsEditing(false); setError(undefined); }}
+                disabled={isSaving}
+                data-testid='device-detail-heading-cancel'
+            >
+                { _t('Cancel') }
+            </AccessibleButton>
+            { isSaving && <Spinner w={16} h={16} /> }
+        </form>;
+    }
+
+    return <div data-testid='device-detail-heading-read'>
+        <Heading size='h3'>{ displayName ?? device.device_id }</Heading>
+        <AccessibleButton
+            kind='link_inline'
+            data-testid='device-detail-heading-rename'
+            onClick={() => { setName(displayName ?? ''); setError(undefined); setIsEditing(true); }}
+        >
+            { _t('Rename') }
+        </AccessibleButton>
+    </div>;
+};
