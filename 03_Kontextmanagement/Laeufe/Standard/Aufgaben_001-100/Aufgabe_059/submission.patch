@@ -0,0 +1,40 @@
+import { DialogHTMLAttributes, HTMLAttributes, MutableRefObject, Ref, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: DialogHTMLAttributes<HTMLDialogElement>['open'];
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ children, open, ...rest }, ref: Ref<HTMLDialogElement>) => {
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        const fallbackProps = rest as unknown as HTMLAttributes<HTMLDivElement>;
+        const setFallbackRef = (node: HTMLDivElement | null) => {
+            if (node) {
+                if (open) {
+                    node.setAttribute('open', '');
+                } else {
+                    node.removeAttribute('open');
+                }
+            }
+            if (typeof ref === 'function') {
+                ref(node as HTMLDialogElement | null);
+            } else if (ref) {
+                (ref as MutableRefObject<HTMLDialogElement | null>).current = node as HTMLDialogElement | null;
+            }
+        };
+        return (
+            <div {...fallbackProps} role={rest.role || 'dialog'} hidden={!open || rest.hidden} ref={setFallbackRef}>
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} open={open} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
