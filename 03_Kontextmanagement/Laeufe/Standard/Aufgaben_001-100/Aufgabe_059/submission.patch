+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes, children, and the host ref in a limited DOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole } = render(
+            <Dialog ref={ref} open aria-label="Example" data-testid="dialog">
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const dialog = getByRole('dialog', { name: 'Example' });
+        expect(ref.current).toBe(dialog);
+        expect(dialog).toHaveAttribute('data-testid', 'dialog');
+        expect(dialog).toHaveAttribute('open');
+        expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+    });
+});
