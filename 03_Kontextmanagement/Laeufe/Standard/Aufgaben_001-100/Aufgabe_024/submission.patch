+def remove_author_honorifics(name: str) -> str:
+    """Remove a leading honorific when another name follows it."""
+    normalized = re.sub(r'[^\w]', '', name.casefold())
+    if normalized in {
+        re.sub(r'[^\w]', '', exception) for exception in HONORIFC_NAME_EXECPTIONS
+    }:
+        return name
+    for honorific in HONORIFICS:
+        if name.casefold().startswith(honorific):
+            remainder = name[len(honorific) :]
+            if remainder and remainder[0] not in ' \t.,':
+                continue
+            remainder = remainder.lstrip(' \t.,')
+            if remainder:
+                return remainder
+    return name
 
 
