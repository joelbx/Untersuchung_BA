 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey string
+
+// NamespacesKey carries the namespaces visible to the authenticated caller.
+const NamespacesKey contextKey = "namespaces"
+
+// NamespacesFromContext returns the evaluated namespace list, if present.
+func NamespacesFromContext(ctx context.Context) ([]string, bool) {
+	namespaces, ok := ctx.Value(NamespacesKey).([]string)
+	return namespaces, ok
+}
+
+// FormatNamespaces converts an OPA decision into a namespace list.
+func FormatNamespaces(value any) ([]string, error) {
+	if namespaces, ok := value.([]string); ok {
+		return namespaces, nil
+	}
+	items, ok := value.([]any)
+	if !ok {
+		return nil, fmt.Errorf("viewable_namespaces decision must be a list: %T", value)
+	}
+	namespaces := make([]string, 0, len(items))
+	for _, item := range items {
+		name, ok := item.(string)
+		if !ok {
+			return nil, fmt.Errorf("viewable_namespaces entry must be a string: %T", item)
+		}
+		namespaces = append(namespaces, name)
+	}
+	return namespaces, nil
+}
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
