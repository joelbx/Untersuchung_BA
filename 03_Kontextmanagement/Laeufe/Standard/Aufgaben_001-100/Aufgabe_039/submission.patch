 import web
 from openlibrary.core.db import get_db
 from openlibrary.core.bookshelves import Bookshelves
+from openlibrary.core.booknotes import Booknotes
 
 class TestUpdateWorkID:
 
@@ -67,3 +68,60 @@ class TestUpdateWorkID:
             "work_id": "1",
             "edition_id": "1"
         }))), "old value 1 present"
+
+
+class TestBooknotesUpdateWorkID:
+
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        cls.db = get_db()
+        cls.db.query("""
+            CREATE TABLE booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL default -1,
+                notes text NOT NULL,
+                primary key (username, work_id, edition_id)
+            );
+        """)
+
+    def setup_method(self):
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source note")
+        self.db.insert("booknotes", username="reader", work_id=2,
+                       edition_id=-1, notes="target note")
+        self.db.insert("booknotes", username="other", work_id=1,
+                       edition_id=-1, notes="another source note")
+
+    def teardown_method(self):
+        self.db.delete("booknotes", where="1=1")
+
+    def test_conflict_preserves_every_booknote(self):
+        before = list(self.db.select("booknotes", order="username, work_id"))
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1
+        }
+        assert list(self.db.select("booknotes", order="username, work_id")) == before
+
+    def test_conflict_dry_run_preserves_every_booknote(self):
+        before = list(self.db.select("booknotes", order="username, work_id"))
+
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {
+            "rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1
+        }
+        assert list(self.db.select("booknotes", order="username, work_id")) == before
+
+    def test_update_without_conflict(self):
+        result = Booknotes.update_work_id(1, 3)
+
+        assert result == {
+            "rows_changed": 2, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert not list(self.db.select("booknotes", where="work_id=1"))
+        assert len(list(self.db.select("booknotes", where="work_id=3"))) == 2
