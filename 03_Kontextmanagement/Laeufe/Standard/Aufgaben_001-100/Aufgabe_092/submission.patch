diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..ff1b913
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,55 @@
+---
+- name: create upgrade test directory
+  file:
+    path: '{{ galaxy_dir }}/upgrade_collections'
+    state: directory
+
+- name: install an older collection
+  command: ansible-galaxy collection install 'namespace1.name1:1.0.0' -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+
+- name: upgrade within a version constraint
+  command: ansible-galaxy collection install 'namespace1.name1:<1.1.0' --upgrade -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+  register: upgrade_constrained
+
+- name: check constrained upgrade
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:1.0.9'' to" in upgrade_constrained.stdout'
+
+- name: repeat constrained upgrade
+  command: ansible-galaxy collection install 'namespace1.name1:<1.1.0' -U -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+  register: upgrade_repeat
+
+- name: check upgrade is idempotent
+  assert:
+    that:
+    - '"Installing" not in upgrade_repeat.stdout'
+
+- name: upgrade with prereleases enabled
+  command: ansible-galaxy collection install namespace1.name1 --upgrade --pre -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+  register: upgrade_prerelease
+
+- name: check prerelease upgrade
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:1.1.0-beta.1'' to" in upgrade_prerelease.stdout'
+
+- name: write upgrade requirements
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade_requirements.yml'
+    content: |
+      collections:
+        - name: namespace1.name1
+          version: '<1.1.0'
+        - name: namespace2.name
+          version: '*'
+
+- name: upgrade collections from requirements
+  command: ansible-galaxy collection install -r '{{ galaxy_dir }}/upgrade_requirements.yml' --upgrade -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+  register: upgrade_requirements
+
+- name: check requirements constraints and collection installation
+  assert:
+    that:
+    - '"Installing ''namespace1.name1:1.0.9'' to" in upgrade_requirements.stdout'
+    - '"Installing ''namespace2.name:1.0.0'' to" in upgrade_requirements.stdout'
diff --git a/test/units/galaxy/test_collection_install.py b/test/units/galaxy/test_collection_install.py
index a4f5c35..ca42d90 100644
--- a/test/units/galaxy/test_collection_install.py
+++ b/test/units/galaxy/test_collection_install.py
@@ -722,6 +722,50 @@ def test_install_installed_collection(monkeypatch, tmp_path_factory, galaxy_serv
     assert mock_display.mock_calls[1][1][0] == expected
 
 
+@pytest.mark.parametrize('upgrade,expected', [
+    (False, {'example.parent': '1.0.0', 'example.child': '1.0.0'}),
+    (True, {'example.parent': '2.0.0', 'example.child': '2.0.0'}),
+])
+def test_upgrade_resolves_changed_transitive_constraint(monkeypatch, tmp_path_factory, upgrade, expected):
+    versions = {
+        'example.parent': ['1.0.0', '2.0.0'],
+        'example.child': ['1.0.0', '2.0.0'],
+    }
+    dependencies = {
+        ('example.parent', '1.0.0'): {'example.child': '>=1.0.0'},
+        ('example.parent', '2.0.0'): {'example.child': '>=2.0.0'},
+        ('example.child', '1.0.0'): {},
+        ('example.child', '2.0.0'): {},
+    }
+    proxy = MagicMock()
+    proxy.get_collection_versions.side_effect = lambda req: [(ver, None) for ver in versions[req.fqcn]]
+    proxy.get_collection_dependencies.side_effect = lambda candidate: dependencies[(candidate.fqcn, candidate.ver)]
+    monkeypatch.setattr(dependency_resolution, 'MultiGalaxyAPIProxy', lambda *args: proxy)
+
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(
+        to_text(tmp_path_factory.mktemp('upgrade-artifacts')), validate_certs=False)
+    requested = [Requirement('example.parent', '*', None, 'galaxy')]
+    installed = {
+        Candidate('example.parent', '1.0.0', None, 'galaxy'),
+        Candidate('example.child', '1.0.0', None, 'galaxy'),
+    }
+    resolved = collection._resolve_depenency_map(requested, [], manager, installed, False, False, upgrade=upgrade)
+    assert {name: candidate.ver for name, candidate in resolved.items()} == expected
+
+
+def test_upgrade_filters_installed_version_outside_constraint(monkeypatch, tmp_path_factory):
+    proxy = MagicMock()
+    proxy.get_collection_versions.return_value = [('2.0.0', None)]
+    proxy.get_collection_dependencies.return_value = {}
+    monkeypatch.setattr(dependency_resolution, 'MultiGalaxyAPIProxy', lambda *args: proxy)
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(
+        to_text(tmp_path_factory.mktemp('upgrade-constraints')), validate_certs=False)
+    requested = [Requirement('example.parent', '>=2.0.0', None, 'galaxy')]
+    installed = {Candidate('example.parent', '1.0.0', None, 'galaxy')}
+    resolved = collection._resolve_depenency_map(requested, [], manager, installed, False, False)
+    assert resolved['example.parent'].ver == '2.0.0'
+
+
 def test_install_collection(collection_artifact, monkeypatch):
     mock_display = MagicMock()
     monkeypatch.setattr(Display, 'display', mock_display)
