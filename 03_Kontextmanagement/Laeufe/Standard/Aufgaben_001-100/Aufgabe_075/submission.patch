@@ -0,0 +1,34 @@
+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props (
+    user_id varchar(255) not null references user(id) on update cascade on delete cascade,
+    key varchar(255) not null,
+    value varchar(255) not null default '',
+    primary key (user_id, key)
+);
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from property p join user u on p.id = 'LastFMSessionKey_' || u.id;
+delete from property where id in (
+    select 'LastFMSessionKey_' || user_id from user_props where key = 'LastFMSessionKey'
+);
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`drop table user_props`)
+	return err
+}
diff --git a/db/migration/user_props_test.go b/db/migration/user_props_test.go
new file mode 100644
index 0000000..046f71e
--- /dev/null
+++ b/db/migration/user_props_test.go
@@ -0,0 +1,46 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`
+create table user (id varchar(255) primary key);
+create table property (id varchar(255) primary key, value varchar(255));
+insert into user (id) values ('user-1');
+insert into property (id, value) values ('LastFMSessionKey_user-1', 'session'), ('GlobalKey', 'global');
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := db.QueryRow(`select value from user_props where user_id = ? and key = ?`, "user-1", "LastFMSessionKey").Scan(&value); err != nil || value != "session" {
+		t.Fatalf("migrated session = %q, error = %v", value, err)
+	}
+	if err := db.QueryRow(`select value from property where id = ?`, "GlobalKey").Scan(&value); err != nil || value != "global" {
+		t.Fatalf("global property = %q, error = %v", value, err)
+	}
+	if err := db.QueryRow(`select value from property where id = ?`, "LastFMSessionKey_user-1").Scan(&value); err != sql.ErrNoRows {
+		t.Fatalf("legacy session remains: %v", err)
+	}
+}
