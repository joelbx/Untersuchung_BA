diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..0d40ace
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,65 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+// NewUserPropsRepository creates a repository scoped to the user in ctx.
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{
+		ctx: ctx, ormer: o, tableName: "user_props",
+	}}
+}
+
+func (r userPropsRepository) userID() (string, error) {
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return "", errors.New("user properties require a user in context")
+	}
+	return user.ID, nil
+}
+
+func (r userPropsRepository) Put(key, value string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	update := Update(r.tableName).Set("value", value).Where(Eq{"user_id": uid, "key": key})
+	count, err := r.executeSQL(update)
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	_, err = r.executeSQL(Insert(r.tableName).Columns("user_id", "key", "value").Values(uid, key, value))
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	var resp struct{ Value string }
+	err = r.queryOne(Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key}), &resp)
+	return resp.Value, err
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..cb739de
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,46 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("scopes reads, updates and deletes to the contextual user", func() {
+		o := orm.NewOrm()
+		for _, id := range []string{"props-user-a", "props-user-b"} {
+			_, err := o.Raw(`insert into user (id, user_name, email, created_at, updated_at) values (?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`, id, id, id+"@example.com").Exec()
+			Expect(err).NotTo(HaveOccurred())
+		}
+		defer func() {
+			_, _ = o.Raw(`delete from user where id in (?, ?)`, "props-user-a", "props-user-b").Exec()
+		}()
+
+		a := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-a"}), o)
+		b := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "props-user-b"}), o)
+		_, err := a.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(a.Put("session", "first")).To(Succeed())
+		Expect(b.Put("session", "second")).To(Succeed())
+		Expect(a.Put("session", "updated")).To(Succeed())
+		Expect(a.Get("session")).To(Equal("updated"))
+		Expect(b.Get("session")).To(Equal("second"))
+		Expect(a.Delete("session")).To(Succeed())
+		_, err = a.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(b.Get("session")).To(Equal("second"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		r := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(r.Put("session", "value")).To(HaveOccurred())
+		_, err := r.Get("session")
+		Expect(err).To(HaveOccurred())
+		Expect(r.Delete("session")).To(HaveOccurred())
+	})
+})
