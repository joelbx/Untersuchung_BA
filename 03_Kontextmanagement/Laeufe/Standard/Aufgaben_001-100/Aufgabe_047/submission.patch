diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..4951750 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,39 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores a previously assigned seed after reseeding", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("user", "first")
+		original := hashFunc("user", input)
+		Expect(hashFunc("user", input)).To(Equal(original))
+
+		h.Reseed("user")
+		Expect(hashFunc("user", input)).NotTo(Equal(original))
+
+		h.SetSeed("user", "first")
+		Expect(hashFunc("user", input)).To(Equal(original))
+	})
+
+	It("sets seeds independently for each identifier", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		original := hashFunc("other", input) // Initializes a missing seed.
+		h.SetSeed("user", "first")
+		first := hashFunc("user", input)
+		h.SetSeed("user", "second")
+		Expect(hashFunc("user", input)).NotTo(Equal(first))
+		Expect(hashFunc("other", input)).To(Equal(original))
+	})
+
+	It("supports setting a seed on the global hasher", func() {
+		hasher.SetSeed("global-user", "saved")
+		hashFunc := hasher.HashFunc()
+		original := hashFunc("global-user", input)
+		hasher.Reseed("global-user")
+		Expect(hashFunc("global-user", input)).NotTo(Equal(original))
+		hasher.SetSeed("global-user", "saved")
+		Expect(hashFunc("global-user", input)).To(Equal(original))
+	})
 })
