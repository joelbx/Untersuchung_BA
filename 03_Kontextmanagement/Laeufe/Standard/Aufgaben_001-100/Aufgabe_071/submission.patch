+def test_parse_clixml_decodes_utf16_escapes_and_preserves_whitespace():
+    data = (b'<Objs><S S="Error">_x263A__xD83D__xDE00__x000D__x000A_'
+            b'_x000D__x000A__x005f__x005F__x000A_</S>'
+            b'<S S="Info">ignored</S><S S="Error">_x005F_ _x005G_ _xD800_</S></Objs>')
+    expected = '\u263a\U0001f600\r\n\r\n_\u005f\n_x005F_ _x005G_ \ud800'.encode('utf-8', 'surrogatepass')
+
+    assert _parse_clixml(data) == expected
+
+
+def test_parse_clixml_concatenates_entries_and_separates_nonempty_blocks():
+    data = (b'<Objs><S S="Error">first</S><S S="Info">skip</S>'
+            b'<S S="Error">second</S><S S="Error" /></Objs>'
+            b'<Objs><S S="Info">skip</S></Objs>'
+            b'<Objs><S S="Error">third</S></Objs>')
+
+    assert _parse_clixml(data) == b'firstsecond\r\nthird'
+    assert _parse_clixml(b'<Objs><S S="Error" /></Objs>') == b''
+    assert _parse_clixml(b'<Objs><S S="Info">skip</S></Objs>') == b''
+
