+    def decode_text(value: str) -> str:
+        tokens = list(re.finditer(r'_x([0-9a-fA-F]{4})_', value))
+        decoded = []
+        position = 0
+        index = 0
+
+        while index < len(tokens):
+            token = tokens[index]
+            decoded.append(value[position:token.start()])
+            code_unit = int(token.group(1), 16)
+            next_token = tokens[index + 1] if index + 1 < len(tokens) else None
+            adjacent = next_token is not None and next_token.start() == token.end()
+
+            if token.group() == '_x005F_' and not adjacent:
+                decoded.append(token.group())
+            elif (0xD800 <= code_unit <= 0xDBFF and adjacent and
+                  0xDC00 <= int(next_token.group(1), 16) <= 0xDFFF):
+                low = int(next_token.group(1), 16)
+                decoded.append(chr(0x10000 + (code_unit - 0xD800) * 0x400 + low - 0xDC00))
+                token = next_token
+                index += 1
+            else:
+                decoded.append(chr(code_unit))
+
+            position = token.end()
+            index += 1
+
+        decoded.append(value[position:])
+        return ''.join(decoded)
+
