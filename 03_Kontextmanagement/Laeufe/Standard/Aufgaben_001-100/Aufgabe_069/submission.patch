+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		input   string
+		want    bool
+	}{
+		{"hello", "hello", true},
+		{"hello", "hello!", false},
+		{"*", "anything", true},
+		{"foo*bar", "foo--bar", true},
+		{"foo*bar", "foo--baz", false},
+		{"a.b", "axb", false},
+		{"^foo$", "foo", true},
+		{"^foo$", "foobar", false},
+		{`{{regexp.match("foo")}}`, "prefixfoosuffix", true},
+		{`{{regexp.not_match("foo")}}`, "bar", true},
+		{`{{regexp.not_match("foo")}}`, "foobar", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz", true},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz-extra", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-baz", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern+"/"+tt.input, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			assert.NoError(t, err)
+			if assert.NotNil(t, matcher) {
+				assert.Equal(t, tt.want, matcher.Match(tt.input))
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		value string
+		want  string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, "unsupported function namespace other, supported namespaces are email and regexp"},
+		{`{{regexp.other("foo")}}`, "unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match."},
+		{`{{email.other("foo")}}`, "unsupported function email.other, supported functions are: email.local"},
+		{`{{regexp.match("[")}}`, "failed parsing regexp \"[\": error parsing regexp: missing closing ]: `[`"},
+		{`{{regexp.match()}}`, "expected 1 argument for regexp.match got 0"},
+		{`{{regexp.match("a", "b")}}`, "expected 1 argument for regexp.match got 2"},
+		{`{{regexp.match(internal.foo)}}`, `"regexp.match(internal.foo)" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{email.local("foo")}}`, `"email.local(\"foo\")" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("a")}}{{regexp.match("b")}}`, `"{{regexp.match(\"a\")}}{{regexp.match(\"b\")}}" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match({{regexp.match("a")}})}}`, `"{{regexp.match({{regexp.match(\"a\")}})}}" is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.value, func(t *testing.T) {
+			_, err := Match(tt.value)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err))
+				assert.Equal(t, tt.want, err.Error())
+			}
+		})
+	}
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+	_, err = Variable(`{{regexp.not_match("foo")}}`)
+	assert.True(t, strings.Contains(err.Error(), "matcher functions (like regexp.match) are not allowed here"))
+}
