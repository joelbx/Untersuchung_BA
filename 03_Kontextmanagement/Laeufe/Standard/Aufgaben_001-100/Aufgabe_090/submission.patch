diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..86ee020 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,4 +1,6 @@
 from openlibrary.plugins.openlibrary import lists
+from openlibrary.plugins.upstream import utils
+import web
 
 
 def test_process_seeds():
@@ -11,3 +13,43 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_uses_form_body_without_query_parameters(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'name=From+body&name=Ignored&description=Body+description&seeds--0--key=%2Fbooks%2FOL1M&seeds--1--other=ignored&seeds--2--key=%2Fworks%2FOL2W',
+    )
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: (_ for _ in ()).throw(AssertionError('query string was read')),
+    )
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'From body'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/books/OL1M'}, {'key': '/works/OL2W'}]
+
+
+def test_list_record_uses_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+
+    def query_input(**defaults):
+        assert defaults == {'key': None, 'name': '', 'description': '', 'seeds': []}
+        return web.storage({**defaults, 'name': 'From query'})
+
+    monkeypatch.setattr(web, 'input', query_input)
+    record = lists.ListRecord.from_input()
+    assert record.name == 'From query'
+
+
+def test_unflatten_last_simple_assignment_wins():
+    class RepeatedItems:
+        def items(self):
+            return [('name', 'old'), ('name', 'new'), ('item--name', 'first'), ('item--name', 'last')]
+
+    assert utils.unflatten(RepeatedItems()) == {'name': 'new', 'item': {'name': 'last'}}
