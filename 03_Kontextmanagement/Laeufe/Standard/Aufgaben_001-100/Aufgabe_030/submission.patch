+++ b/test/units/module_utils/facts/hardware/test_aix_get_cpu_facts.py
@@ -0,0 +1,43 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import pytest
+
+from ansible.module_utils.facts.hardware.aix import AIXHardware
+
+
+@pytest.mark.parametrize('smt_output, threads_per_core', [
+    ('smt_threads 4 SMT threads True\n', 4),
+    ('', 1),
+])
+def test_aix_get_cpu_facts(mocker, smt_output, threads_per_core):
+    module = mocker.Mock()
+    lsdev_output = ''.join('proc%d Available 00-00 Processor\n' % i for i in range(12))
+    module.run_command.side_effect = [
+        (0, lsdev_output, ''),
+        (0, 'type PowerPC_POWER7 Processor type False\n', ''),
+        (0, smt_output, ''),
+    ]
+
+    assert AIXHardware(module).get_cpu_facts() == {
+        'processor': ['PowerPC_POWER7'],
+        'processor_count': 1,
+        'processor_cores': 12,
+        'processor_threads_per_core': threads_per_core,
+        'processor_vcpus': 12 * threads_per_core,
+    }
+    assert module.run_command.call_count == 3
+
+
+def test_aix_get_cpu_facts_without_available_processors(mocker):
+    module = mocker.Mock()
+    module.run_command.return_value = (0, 'proc0 Defined 00-00 Processor\n', '')
+
+    assert AIXHardware(module).get_cpu_facts() == {
+        'processor': [],
+        'processor_count': 1,
+        'processor_cores': 0,
+        'processor_threads_per_core': 1,
+        'processor_vcpus': 0,
+    }
+    module.run_command.assert_called_once_with('/usr/sbin/lsdev -Cc processor')
