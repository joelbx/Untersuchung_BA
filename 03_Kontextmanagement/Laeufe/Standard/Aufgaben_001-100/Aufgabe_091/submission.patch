+func validateArrayValue(property, value string, comparisonType ComparisonType) error {
+	typeName := "string"
+	if comparisonType == ComparisonType_NUMBER_COMPARISON_TYPE {
+		typeName = "number"
+	}
+
+	invalid := func() error {
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+	}
+	var size int
+	if comparisonType == ComparisonType_NUMBER_COMPARISON_TYPE {
+		var values []float64
+		if err := json.Unmarshal([]byte(value), &values); err != nil || values == nil {
+			return invalid()
+		}
+		size = len(values)
+	} else {
+		var values []string
+		if err := json.Unmarshal([]byte(value), &values); err != nil || values == nil {
+			return invalid()
+		}
+		size = len(values)
+	}
+	if size > MAX_JSON_ARRAY_ITEMS {
+		return errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", property, typeName, MAX_JSON_ARRAY_ITEMS)
+	}
+	// JSON null decodes as the zero value of a string or float64; reject it explicitly.
+	var items []json.RawMessage
+	_ = json.Unmarshal([]byte(value), &items)
+	for _, item := range items {
+		if string(item) == "null" {
+			return invalid()
+		}
+	}
+	return nil
+}
