+		{"not one of match", flipt.OpIsNotOneOf, `[1,2.5]`, "3", true, false},
+		{"not one of miss", flipt.OpIsNotOneOf, `[1,2.5]`, "1", false, false},
+		{"invalid JSON", flipt.OpIsOneOf, `[1,`, "1", false, true},
+		{"invalid JSON without context", flipt.OpIsOneOf, `[1,`, "", false, true},
+		{"wrong element type", flipt.OpIsNotOneOf, `[1,"2"]`, "1", false, true},
+		{"null element", flipt.OpIsOneOf, `[1,null]`, "1", false, true},
+	} {
