@@ -0,0 +1,129 @@
+"""Collect HAProxy CSV statistics and publish them to Graphite."""
+
+import asyncio
+import csv
+import io
+import pickle
+import re
+import struct
+import time
+from collections.abc import Iterable, Iterator
+from dataclasses import dataclass
+from typing import Literal
+from urllib.request import urlopen
+
+
+@dataclass(frozen=True)
+class GraphiteEvent:
+    path: str
+    value: float
+    timestamp: int
+
+    def serialize(self) -> tuple[str, tuple[int, float]]:
+        return self.path, (self.timestamp, self.value)
+
+
+@dataclass(frozen=True)
+class HaproxyCapture:
+    pxname: str
+    svname: str
+    field: list[str]
+
+    def matches(self, row: dict) -> bool:
+        return (
+            re.fullmatch(self.pxname, row.get("pxname", "")) is not None
+            and re.fullmatch(self.svname, row.get("svname", "")) is not None
+            and any(row.get(name) not in (None, "") for name in self.field)
+        )
+
+    def to_graphite_events(
+        self, prefix: str, row: dict, ts: float
+    ) -> Iterator[GraphiteEvent]:
+        if not self.matches(row):
+            return
+        for name in self.field:
+            value = row.get(name)
+            if value not in (None, ""):
+                try:
+                    number = float(value)
+                except ValueError:
+                    continue
+                yield GraphiteEvent(
+                    f"{prefix}.{row['pxname']}.{row['svname']}.{name}", number, int(ts)
+                )
+
+
+TO_CAPTURE = [HaproxyCapture(r".*", r".*", ["scur", "rate", "qcur"])]
+
+
+def fetch_events(haproxy_url: str, prefix: str, ts: float) -> Iterable[GraphiteEvent]:
+    """Read the HAProxy admin CSV endpoint and yield selected numeric metrics."""
+    with urlopen(haproxy_url, timeout=10) as response:
+        body = response.read().decode("utf-8")
+    # HAProxy marks the CSV header with '# '. Other comment lines are ignored.
+    lines = (line.removeprefix("# ") for line in io.StringIO(body) if line.strip())
+    for row in csv.DictReader(lines):
+        if not row.get("pxname"):
+            continue
+        for capture in TO_CAPTURE:
+            yield from capture.to_graphite_events(prefix, row, ts)
+
+
+async def _send_events(address: str, events: list[GraphiteEvent]) -> None:
+    host, port = address.rsplit(":", 1)
+    reader, writer = await asyncio.open_connection(host, int(port))
+    try:
+        payload = pickle.dumps([event.serialize() for event in events], protocol=2)
+        writer.write(struct.pack("!L", len(payload)) + payload)
+        await writer.drain()
+    finally:
+        writer.close()
+        await writer.wait_closed()
+
+
+async def main(
+    haproxy_url: str = "http://openlibrary.org/admin?stats",
+    graphite_address: str = "graphite.us.archive.org:2004",
+    prefix: str = "stats.ol.haproxy",
+    dry_run: bool = True,
+    fetch_freq: int = 10,
+    commit_freq: int = 30,
+    agg: Literal["max", "min", "sum", None] = None,
+) -> None:
+    """Collect metrics every fetch_freq seconds and publish every commit_freq seconds."""
+    if fetch_freq <= 0 or commit_freq <= 0:
+        raise ValueError("fetch_freq and commit_freq must be positive")
+    if agg not in (None, "max", "min", "sum"):
+        raise ValueError(f"Unsupported aggregation: {agg}")
+
+    pending: list[GraphiteEvent] = []
+    last_commit = time.monotonic()
+    while True:
+        pending.extend(await asyncio.to_thread(lambda: list(fetch_events(haproxy_url, prefix, time.time()))))
+        now = time.monotonic()
+        if now - last_commit >= commit_freq:
+            events = pending
+            if agg is not None:
+                combined: dict[str, GraphiteEvent] = {}
+                for event in pending:
+                    previous = combined.get(event.path)
+                    if previous is None:
+                        combined[event.path] = event
+                    else:
+                        values = (previous.value, event.value)
+                        value = {"max": max, "min": min, "sum": sum}[agg](values)
+                        combined[event.path] = GraphiteEvent(event.path, value, event.timestamp)
+                events = list(combined.values())
+            if events:
+                if dry_run:
+                    for event in events:
+                        print(f"{event.path} {event.value} {event.timestamp}", flush=True)
+                else:
+                    await _send_events(graphite_address, events)
+            pending = []
+            last_commit = now
+        await asyncio.sleep(fetch_freq)
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
