index 0000000..fa168b7
--- /dev/null
+++ b/scripts/monitoring/tests/test_haproxy_monitor.py
@@ -0,0 +1,35 @@
+from io import BytesIO
+from unittest.mock import patch
+
+from scripts.monitoring.haproxy_monitor import (
+    GraphiteEvent,
+    HaproxyCapture,
+    fetch_events,
+)
+
+
+def test_graphite_event_and_capture():
+    event = GraphiteEvent("stats.ol.haproxy.web.FRONTEND.scur", 3.0, 123)
+    assert event.serialize() == (event.path, (123, 3.0))
+
+    capture = HaproxyCapture(r"web", r"FRONTEND", ["scur", "rate", "qcur"])
+    row = {"pxname": "web", "svname": "FRONTEND", "scur": "3", "rate": "2", "qcur": ""}
+    assert capture.matches(row)
+    assert list(capture.to_graphite_events("stats.ol.haproxy", row, 123.9)) == [
+        event,
+        GraphiteEvent("stats.ol.haproxy.web.FRONTEND.rate", 2.0, 123),
+    ]
+    assert not capture.matches({**row, "pxname": "other"})
+
+
+def test_fetch_events_parses_haproxy_csv():
+    csv = b"# pxname,svname,scur,rate,qcur,\nweb,FRONTEND,3,2,,\nweb,BACKEND,4,,1,\n"
+    with patch("scripts.monitoring.haproxy_monitor.urlopen") as open_url:
+        open_url.return_value.__enter__.return_value = BytesIO(csv)
+        events = list(fetch_events("http://haproxy/admin?stats;csv", "stats.ol.haproxy", 123.9))
+    assert [event.serialize() for event in events] == [
+        ("stats.ol.haproxy.web.FRONTEND.scur", (123, 3.0)),
+        ("stats.ol.haproxy.web.FRONTEND.rate", (123, 2.0)),
+        ("stats.ol.haproxy.web.BACKEND.scur", (123, 4.0)),
+        ("stats.ol.haproxy.web.BACKEND.qcur", (123, 1.0)),
+    ]
