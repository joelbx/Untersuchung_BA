 // bootstrap check
 func TestConfig(t *testing.T) { check.TestingT(t) }
 
+func TestKubeListenAddrShorthand(t *testing.T) {
+	tests := []struct {
+		name, yaml, wantAddr string
+		wantErr              bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"default port", "proxy_service:\n  kube_listen_addr: kube.example.com\n", "kube.example.com:3026", false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n", "0.0.0.0:8080", false},
+		{"enabled legacy conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", "", true},
+		{"legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fc, err := ReadConfig(bytes.NewBufferString(tt.yaml))
+			if tt.wantErr {
+				if err == nil || !strings.Contains(err.Error(), "kube_listen_addr") || !strings.Contains(err.Error(), "kubernetes") {
+					t.Fatalf("expected clear conflict error, got %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			cfg := service.MakeDefaultConfig()
+			if err := applyProxyConfig(fc, cfg); err != nil {
+				t.Fatal(err)
+			}
+			if !cfg.Proxy.Kube.Enabled || cfg.Proxy.Kube.ListenAddr.Addr != tt.wantAddr {
+				t.Fatalf("Kubernetes proxy: enabled=%v, addr=%q; want %q", cfg.Proxy.Kube.Enabled, cfg.Proxy.Kube.ListenAddr.Addr, tt.wantAddr)
+			}
+		})
+	}
+}
