+def test_module_level_make_date_string():
+    assert make_date_string(2000, None, None) == '2000'
+    assert make_date_string(2000, None, 9) == '2000'
+    assert make_date_string(2000, 2, None) == '2000-02'
+    assert make_date_string(2000, 2, 9) == '2000-02-09'
+
+
+def test_patron_check_ins_validation():
+    checkins = patron_check_ins()
+    assert checkins.is_valid({'id': 123, 'year': 2000})
+    assert checkins.is_valid({'id': 123, 'data': {'note': 'read'}})
+    assert not checkins.is_valid({'year': 2000})
+    assert not checkins.is_valid({'id': 123, 'month': 2, 'day': 9})
+    assert not checkins.is_valid({'id': 123})
+    assert not checkins.is_valid({'id': None, 'data': {'note': 'read'}})
 
 
