+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.modules.net_tools.nios import nios_fixed_address
+from ansible.module_utils.net_tools.nios import api
+from units.compat import unittest
+from units.compat.mock import MagicMock, Mock, patch
+from units.modules.utils import set_module_args
+
+
+class TestNiosFixedAddress(unittest.TestCase):
+
+    def test_main_maps_both_address_families(self):
+        for address, object_type, field in (
+                ('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')):
+            set_module_args(dict(name='printer', ipaddr=address, mac='00:11:22:33:44:55',
+                                 network='192.0.2.0/24' if field == 'ipv4addr' else '2001:db8::/64',
+                                 provider={'host': 'nios.example.com'}))
+            with patch.object(nios_fixed_address, 'WapiModule') as wapi:
+                wapi.provider_spec = api.WapiModule.provider_spec
+                wapi.return_value.run.return_value = {'changed': False}
+                with self.assertRaises(SystemExit):
+                    nios_fixed_address.main()
+                module = wapi.call_args[0][0]
+                self.assertEqual(module.params[field], address)
+                self.assertNotIn('ipaddr', module.params)
+                self.assertEqual(module.params['network_view'], 'default')
+                self.assertEqual(module.params['state'], 'present')
+                args = wapi.return_value.run.call_args[0]
+                self.assertEqual(args[0], object_type)
+                self.assertTrue(args[1][field]['ib_req'])
+
+    def test_invalid_address(self):
+        module = MagicMock()
+        module.fail_json.side_effect = ValueError('invalid address')
+        with self.assertRaises(ValueError):
+            nios_fixed_address.validate_ip_addr_type('invalid', {'ipaddr': {}}, module)
+
+    def test_options_validation_and_defaults(self):
+        set_module_args(dict(name='printer', ipaddr='192.0.2.10', mac='00:11:22:33:44:55',
+                             network='192.0.2.0/24', provider={'host': 'nios.example.com'},
+                             options=[{'num': 15, 'value': 'example.com'}]))
+        with patch.object(nios_fixed_address, 'WapiModule') as wapi:
+            wapi.provider_spec = api.WapiModule.provider_spec
+            wapi.return_value.run.return_value = {'changed': False}
+            with self.assertRaises(SystemExit):
+                nios_fixed_address.main()
+            module = wapi.call_args[0][0]
+            self.assertEqual(nios_fixed_address.options(module),
+                             [{'num': 15, 'value': 'example.com', 'use_option': True,
+                               'vendor_class': 'DHCP'}])
+
+        module = MagicMock()
+        module.params = {'options': [{'value': 'example.com', 'name': None, 'num': None}]}
+        module.fail_json.side_effect = ValueError('missing name or num')
+        with self.assertRaises(ValueError):
+            nios_fixed_address.options(module)
+
+    def test_wapi_lifecycle_and_check_mode(self):
+        for object_type, field, address in (
+                (api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr', '192.0.2.10'),
+                (api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr', '2001:db8::10')):
+            module = MagicMock()
+            module.check_mode = False
+            module.params = dict(provider=None, state='present', name='printer',
+                                 mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                                 network_view='default', options=None, extattrs=None,
+                                 comment=None)
+            module.params[field] = address
+            spec = dict(name={}, mac={'ib_req': True}, network={'ib_req': True},
+                        network_view={'ib_req': True}, options={}, extattrs={}, comment={})
+            spec[field] = {'ib_req': True}
+            with patch.object(api, 'get_connector'):
+                wapi = api.WapiModule(module)
+            wapi.get_object = Mock(return_value=None)
+            wapi.create_object = Mock()
+            wapi.update_object = Mock()
+            wapi.delete_object = Mock()
+
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            lookup = wapi.get_object.call_args[0][1]
+            self.assertEqual(lookup[field], address)
+            self.assertEqual(lookup['mac'], module.params['mac'])
+            self.assertEqual(lookup['network_view'], 'default')
+            self.assertNotIn('name', lookup)
+            wapi.create_object.assert_called_once()
+
+            current = dict(module.params)
+            current['_ref'] = 'fixed/ref'
+            current.pop('provider')
+            current.pop('state')
+            current.pop('extattrs')
+            current.pop('comment')
+            current.pop('options')
+            wapi.get_object.side_effect = lambda *args, **kwargs: [dict(current)]
+            self.assertFalse(wapi.run(object_type, spec)['changed'])
+            module.params['comment'] = 'updated'
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            wapi.update_object.assert_called_once()
+
+            module.check_mode = True
+            module.params['state'] = 'absent'
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            wapi.delete_object.assert_not_called()
+            module.check_mode = False
+            self.assertTrue(wapi.run(object_type, spec)['changed'])
+            wapi.delete_object.assert_called_once_with('fixed/ref')
+
+    def test_empty_options_clear_existing_options(self):
+        module = MagicMock()
+        module.check_mode = True
+        module.params = dict(provider=None, state='present', name='printer',
+                             ipv4addr='192.0.2.10', mac='00:11:22:33:44:55',
+                             network='192.0.2.0/24', network_view='default', options=[],
+                             extattrs=None, comment=None)
+        spec = dict(name={}, ipv4addr={'ib_req': True}, mac={'ib_req': True},
+                    network={'ib_req': True}, network_view={'ib_req': True},
+                    options={}, extattrs={}, comment={})
+        current = dict(name='printer', ipv4addr='192.0.2.10', mac='00:11:22:33:44:55',
+                       network='192.0.2.0/24', network_view='default',
+                       options=[{'name': 'domain-name', 'value': 'old.example.com'}],
+                       _ref='fixed/ref')
+        with patch.object(api, 'get_connector'):
+            wapi = api.WapiModule(module)
+        wapi.get_object = Mock(return_value=[current])
+        wapi.update_object = Mock()
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.update_object.assert_not_called()
