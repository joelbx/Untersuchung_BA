+        if candidates:
+            # Prefer the author sharing the most identifiers, then the oldest
+            # OL identifier. A conflict on the selected author is an error.
+            ranked = []
+            for candidate in candidates.values():
+                matches = sum(
+                    candidate.get('remote_ids', {}).get(k) == v
+                    for k, v in incoming_ids.items()
+                )
+                ranked.append((matches, candidate))
+            best_score = max(score for score, _ in ranked)
+            return min(
+                (candidate for score, candidate in ranked if score == best_score),
