index 64d0395..10de47d 100644
--- a/lib/events/emitter_test.go
+++ b/lib/events/emitter_test.go
@@ -23,10 +23,48 @@ import (
 	"testing"
 
 	"github.com/gravitational/teleport/lib/session"
+	"github.com/gravitational/teleport/lib/utils"
 
+	"github.com/gravitational/trace"
 	"github.com/stretchr/testify/require"
 )
 
+type testWriteCloser struct {
+	bytes.Buffer
+	closes int
+}
+
+func (w *testWriteCloser) Close() error {
+	w.closes++
+	return nil
+}
+
+func TestWriterEmitterAndMultiLog(t *testing.T) {
+	first, second := &testWriteCloser{}, &testWriteCloser{}
+	firstLog, secondLog := NewWriterEmitter(first), NewWriterEmitter(second)
+	multi, err := NewMultiLog(firstLog, secondLog)
+	require.NoError(t, err)
+
+	event := GenerateTestSession(SessionParams{PrintEvents: 0})[0]
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	require.JSONEq(t, first.String(), second.String())
+	encoded, err := utils.FastMarshal(event)
+	require.NoError(t, err)
+	require.True(t, bytes.HasSuffix(first.Bytes(), []byte("\n")))
+	require.JSONEq(t, string(encoded), first.String())
+
+	require.NoError(t, multi.Close())
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
+
+func TestMultiLogRejectsNonEmitter(t *testing.T) {
+	multi, err := NewMultiLog(NewWriterLog(&testWriteCloser{}))
+	require.Nil(t, multi)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
