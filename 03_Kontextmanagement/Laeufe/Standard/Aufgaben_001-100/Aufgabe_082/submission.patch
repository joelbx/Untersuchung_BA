+// NewWriterEmitter returns an audit log that writes events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		WriterLog: NewWriterLog(w),
+		w:         w,
+	}
+}
+
+// WriterEmitter writes audit events to an external writer.
+type WriterEmitter struct {
+	*WriterLog
+	w io.WriteCloser
+}
+
+// EmitAuditEvent writes a JSON event followed by a newline.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	line, err := utils.FastMarshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	line = append(line, '\n')
+	n, err := w.w.Write(line)
+	if err == nil && n != len(line) {
+		err = io.ErrShortWrite
+	}
+	return trace.ConvertSystemError(err)
+}
+
+// Close releases the writer and the embedded audit log.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(
+		trace.ConvertSystemError(w.w.Close()),
+		trace.ConvertSystemError(w.WriterLog.Close()),
+	)
+}
