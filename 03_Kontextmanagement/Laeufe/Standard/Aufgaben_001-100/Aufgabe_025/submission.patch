+func TestLoadEnvReferences(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte(`server:
+  http_port: ${FLIPT_TEST_REFERENCE_PORT}
+log:
+  level: ${FLIPT_TEST_REFERENCE_LEVEL}
+  encoding: ${FLIPT_TEST_REFERENCE_ENCODING}
+cache:
+  ttl: ${FLIPT_TEST_REFERENCE_TTL}
+`), 0600))
+
+	t.Setenv("FLIPT_TEST_REFERENCE_PORT", "8087")
+	t.Setenv("FLIPT_TEST_REFERENCE_LEVEL", "DEBUG")
+	t.Setenv("FLIPT_TEST_REFERENCE_ENCODING", "json")
+	t.Setenv("FLIPT_TEST_REFERENCE_TTL", "5m")
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8087, result.Config.Server.HTTPPort)
+	assert.Equal(t, "DEBUG", result.Config.Log.Level)
+	assert.Equal(t, LogEncodingJSON, result.Config.Log.Encoding)
+	assert.Equal(t, 5*time.Minute, result.Config.Cache.TTL)
+
+	// The configuration key's own environment variable still takes precedence.
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8099")
+	t.Setenv("FLIPT_LOG_ENCODING", "console")
+	result, err = Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8099, result.Config.Server.HTTPPort)
+	assert.Equal(t, LogEncodingConsole, result.Config.Log.Encoding)
+}
