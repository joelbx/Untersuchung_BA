+var envReference = regexp.MustCompile(`^\$\{[A-Za-z_][A-Za-z0-9_]*\}$`)
+
+// envSubstitutionHookFunc replaces a whole string reference with its environment value.
+// It runs before type conversion hooks so the replacement can be decoded normally.
+func envSubstitutionHookFunc() mapstructure.DecodeHookFunc {
+	return func(from reflect.Kind, _ reflect.Kind, data interface{}) (interface{}, error) {
+		if from != reflect.String {
+			return data, nil
+		}
+
+		value, ok := data.(string)
+		if !ok || !envReference.MatchString(value) {
+			return data, nil
+		}
+
+		if replacement, ok := os.LookupEnv(value[2 : len(value)-1]); ok {
+			return replacement, nil
+		}
+
+		return data, nil
+	}
+}
