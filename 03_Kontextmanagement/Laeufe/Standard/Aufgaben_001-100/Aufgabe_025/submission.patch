+func TestEnvSubstitutionHookFunc(t *testing.T) {
+	t.Setenv("FLIPT_TEST_REFERENCE_1", "replacement")
+	t.Setenv("_FLIPT_TEST_REFERENCE", "underscore")
+	t.Setenv("FLIPT_TEST_EMPTY_REFERENCE", "")
+	t.Setenv("FLIPT_TEST_MISSING_REFERENCE", "temporary")
+	require.NoError(t, os.Unsetenv("FLIPT_TEST_MISSING_REFERENCE"))
+
+	tests := []struct {
+		name  string
+		input any
+		want  any
+	}{
+		{"valid name", "${FLIPT_TEST_REFERENCE_1}", "replacement"},
+		{"leading underscore", "${_FLIPT_TEST_REFERENCE}", "underscore"},
+		{"empty environment value", "${FLIPT_TEST_EMPTY_REFERENCE}", ""},
+		{"missing environment value", "${FLIPT_TEST_MISSING_REFERENCE}", "${FLIPT_TEST_MISSING_REFERENCE}"},
+		{"embedded reference", "prefix-${FLIPT_TEST_REFERENCE_1}", "prefix-${FLIPT_TEST_REFERENCE_1}"},
+		{"trailing text", "${FLIPT_TEST_REFERENCE_1}-suffix", "${FLIPT_TEST_REFERENCE_1}-suffix"},
+		{"invalid first character", "${1FLIPT_TEST_REFERENCE}", "${1FLIPT_TEST_REFERENCE}"},
+		{"invalid punctuation", "${FLIPT-TEST}", "${FLIPT-TEST}"},
+		{"non-string value", 42, 42},
+		{"named string value", LogEncoding("${FLIPT_TEST_REFERENCE_1}"), LogEncoding("${FLIPT_TEST_REFERENCE_1}")},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := mapstructure.DecodeHookExec(envSubstitutionHookFunc(), reflect.ValueOf(tt.input), reflect.ValueOf(tt.want))
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
