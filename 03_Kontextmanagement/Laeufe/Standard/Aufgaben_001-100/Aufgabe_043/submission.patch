@@ -0,0 +1,140 @@
+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+func TestNewResource(t *testing.T) {
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "deployment.environment=test")
+	res, err := newResource(context.Background(), "1.2.3")
+	require.NoError(t, err)
+	require.Equal(t, "flipt", attributeValue(t, res.Set().ToSlice(), "service.name"))
+	require.Equal(t, "1.2.3", attributeValue(t, res.Set().ToSlice(), "service.version"))
+	require.Equal(t, "test", attributeValue(t, res.Set().ToSlice(), "deployment.environment"))
+
+	t.Setenv("OTEL_SERVICE_NAME", "custom-flipt")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "service.name=resource-name,service.version=env-version,region=local")
+	res, err = newResource(context.Background(), "2.0.0")
+	require.NoError(t, err)
+	require.Equal(t, "custom-flipt", attributeValue(t, res.Set().ToSlice(), "service.name"))
+	require.Equal(t, "2.0.0", attributeValue(t, res.Set().ToSlice(), "service.version"))
+	require.Equal(t, "local", attributeValue(t, res.Set().ToSlice(), "region"))
+
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	res, err = newResource(context.Background(), "2.0.0")
+	require.NoError(t, err)
+	require.Equal(t, "resource-name", attributeValue(t, res.Set().ToSlice(), "service.name"))
+}
+
+func attributeValue(t *testing.T, attrs []attribute.KeyValue, key attribute.Key) string {
+	t.Helper()
+	for _, attr := range attrs {
+		if attr.Key == key {
+			return attr.Value.AsString()
+		}
+	}
+	t.Fatalf("missing resource attribute %s", key)
+	return ""
+}
+
+func TestNewProvider(t *testing.T) {
+	provider, err := NewProvider(context.Background(), "1.2.3")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, provider.Shutdown(context.Background())) })
+	_, span := provider.Tracer("test").Start(context.Background(), "sampled")
+	require.True(t, span.SpanContext().IsSampled())
+	span.End()
+}
+
+func TestGetExporter(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"otlp http", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318"}}},
+		{"otlp https", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318"}}},
+		{"otlp grpc", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317"}}},
+		{"otlp host port", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317"}}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			exp, shutdown, err := GetExporter(context.Background(), &tc.cfg)
+			require.NoError(t, err)
+			require.NotNil(t, exp)
+			require.NotNil(t, shutdown)
+			require.NoError(t, shutdown(context.Background()))
+			require.NoError(t, shutdown(context.Background()))
+		})
+	}
+
+	bad := config.TracingConfig{Exporter: 255}
+	_, _, err := GetExporter(context.Background(), &bad)
+	require.ErrorContains(t, err, "unsupported tracing exporter:")
+	_, _, err = GetExporter(context.Background(), nil)
+	require.ErrorContains(t, err, "tracing config is nil")
+}
+
+func TestGetExporterInvalidEndpoint(t *testing.T) {
+	for _, endpoint := range []string{"", "http://", "http://localhost:bad", "grpc://localhost:4317/path", "localhost:notaport", "ftp://localhost:4317"} {
+		t.Run(endpoint, func(t *testing.T) {
+			cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: endpoint}}
+			_, _, err := GetExporter(context.Background(), &cfg)
+			require.ErrorContains(t, err, "parsing otlp endpoint:")
+		})
+	}
+}
+
+func TestGetExporterOTLPHTTPHeaders(t *testing.T) {
+	got := make(chan http.Header, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got <- r.Header.Clone()
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{
+		Endpoint: server.URL + "/custom/traces",
+		Headers:  map[string]string{"X-Test-Header": "configured"},
+	}}
+	exp, shutdown, err := GetExporter(context.Background(), &cfg)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, shutdown(context.Background())) }()
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSyncer(exp))
+	_, span := provider.Tracer("test").Start(context.Background(), "header-test")
+	span.End()
+	select {
+	case headers := <-got:
+		require.Equal(t, "configured", headers.Get("X-Test-Header"))
+	case <-time.After(5 * time.Second):
+		t.Fatal("export did not reach HTTP server")
+	}
+	require.NoError(t, provider.Shutdown(context.Background()))
+}
+
+func TestGetExporterMultipleConfigurations(t *testing.T) {
+	zipkinCfg := config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}
+	first, firstShutdown, err := GetExporter(context.Background(), &zipkinCfg)
+	require.NoError(t, err)
+	second, secondShutdown, err := GetExporter(context.Background(), &zipkinCfg)
+	require.NoError(t, err)
+	require.NotSame(t, first, second)
+	require.NoError(t, firstShutdown(context.Background()))
+	require.NoError(t, secondShutdown(context.Background()))
+
+	bad := config.TracingConfig{Exporter: 255}
+	_, _, err = GetExporter(context.Background(), &bad)
+	require.True(t, strings.HasPrefix(err.Error(), "unsupported tracing exporter:"))
+}
