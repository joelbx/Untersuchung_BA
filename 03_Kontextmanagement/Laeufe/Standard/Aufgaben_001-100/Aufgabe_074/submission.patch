diff --git a/scripts/solr_builder/tests/test_fn_to_cli.py b/scripts/solr_builder/tests/test_fn_to_cli.py
index 1399523..14b50a1 100644
--- a/scripts/solr_builder/tests/test_fn_to_cli.py
+++ b/scripts/solr_builder/tests/test_fn_to_cli.py
@@ -1,5 +1,9 @@
 from argparse import BooleanOptionalAction
+from pathlib import Path
 import typing
+
+import pytest
+
 from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
 
 
@@ -47,3 +51,60 @@ class TestFnToCLI:
     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    @pytest.mark.parametrize(
+        ('annotation', 'tokens', 'expected'),
+        [
+            (list[int], ['1', '2', '3'], [1, 2, 3]),
+            (list[str], ['a', 'b'], ['a', 'b']),
+            (list[float], ['1.5', '2.5'], [1.5, 2.5]),
+            (list[Path], ['a.txt', 'b.txt'], [Path('a.txt'), Path('b.txt')]),
+        ],
+    )
+    def test_required_typed_list(self, annotation, tokens, expected):
+        def fn(values):
+            return values
+
+        fn.__annotations__['values'] = annotation
+        cli = FnToCLI(fn)
+        cli.parse_args(tokens)
+        assert cli.run() == expected
+
+    def test_path_and_optional_list_flags(self):
+        def fn(source: Path, files: list[Path] | None = None, count: int = 0):
+            return source, files, count
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['source.txt', '--files', 'a.txt', 'b.txt', '--count', '2'])
+        assert cli.run() == (Path('source.txt'), [Path('a.txt'), Path('b.txt')], 2)
+
+        cli.parse_args(['source.txt'])
+        assert cli.run() == (Path('source.txt'), None, 0)
+
+    def test_option_name_matches_parameter(self):
+        def fn(file_names: list[str] | None = None):
+            return file_names
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--file_names', 'one', 'two'])
+        assert cli.run() == ['one', 'two']
+        cli.parse_args(['--file-names', 'three'])
+        assert cli.run() == ['three']
+
+    def test_nullable_list_without_default(self):
+        def fn(files: list[int] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() is None
+        cli.parse_args(['--files', '1', '2'])
+        assert cli.run() == [1, 2]
+
+    def test_async_run_returns_result(self):
+        async def fn(path: Path):
+            return path
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['a.txt'])
+        assert cli.run() == Path('a.txt')
