+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'str'}})], indirect=['stdin', 'am'])
+def test_new_file_with_omitted_mode_warns_on_return(atomic_am, atomic_mocks, mocker, capfd):
+    mocker.patch('ansible.module_utils.common.warnings._global_warnings', [])
+    atomic_mocks['path_exists'].return_value = False
+    atomic_mocks['umask'].side_effect = [18, 0, 18, 0]
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    atomic_am.atomic_move('/path/to/src2', '/path/to/dest2')
+    assert atomic_am._created_files == {'/path/to/dest', '/path/to/dest2'}
+    assert atomic_mocks['chmod'].call_args_list == [mocker.call(b'/path/to/dest', 0o600),
+                                                    mocker.call(b'/path/to/dest2', 0o600)]
+
+    atomic_am._return_formatted({})
+    result = json.loads(capfd.readouterr()[0])
+    assert result['warnings'] == [
+        "File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning.",
+        "File '/path/to/dest2' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning.",
+    ]
+    assert not atomic_am._created_files
+
+
+@pytest.mark.parametrize('stdin, am', [({'mode': '0640'}, {'mode': {'type': 'str'}})], indirect=['stdin', 'am'])
+def test_new_file_with_explicit_mode_is_not_recorded(atomic_am, atomic_mocks):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert not atomic_am._created_files
+
+
+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'str'}})], indirect=['stdin', 'am'])
+def test_setting_mode_removes_created_file_warning(atomic_am, atomic_mocks, mocker, capfd):
+    mocker.patch('ansible.module_utils.common.warnings._global_warnings', [])
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert atomic_am._created_files == {'/path/to/dest'}
+    assert not atomic_am.set_mode_if_different('/path/to/dest', None, False)
+    assert atomic_am._created_files == {'/path/to/dest'}
+
+    mocker.patch('os.lstat', return_value=os.stat_result((0o100600,) + (0,) * 9))
+    assert not atomic_am.set_mode_if_different(b'/path/to/dest', '0600', False)
+    assert not atomic_am._created_files
+
+    atomic_am._return_formatted({})
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
