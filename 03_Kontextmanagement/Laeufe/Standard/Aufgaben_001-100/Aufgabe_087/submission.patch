new file mode 100644
index 0000000..8705ef2
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,33 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Version is the version of the running Flipt binary. The command sets it at startup.
+var Version = "dev"
+
+// Flipt describes the running Flipt build.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes build information as JSON.
+func (f Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(f)
+	if err != nil {
+		http.Error(w, "encoding build information", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := w.Write(out); err != nil {
+		http.Error(w, "writing build information", http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..40bd60e
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,204 @@
+// Package telemetry reports anonymous installation usage.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	endpoint      = "https://telemetry.flipt.io/v1/track"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter maintains an anonymous installation ID and periodically reports it.
+type Reporter struct {
+	mu     sync.Mutex
+	state  state
+	path   string
+	logger logrus.FieldLogger
+	client *http.Client
+}
+
+// NewReporter initializes persistent state when telemetry is enabled.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil {
+		return nil, errors.New("nil config")
+	}
+	if !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	if logger == nil {
+		logger = logrus.StandardLogger()
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding telemetry state directory: %w", err)
+		}
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+	r := &Reporter{path: filepath.Join(dir, "telemetry.json"), logger: logger, client: &http.Client{Timeout: 5 * time.Second}}
+	data, err := os.ReadFile(r.path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if json.Unmarshal(data, &r.state) != nil {
+			r.state = state{}
+		}
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry ID: %w", err)
+		}
+		r.state.UUID = id.String()
+	}
+	r.state.Version = schemaVersion
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		r.state.LastTimestamp = ""
+	}
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.Marshal(r.state)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	f, err := os.CreateTemp(filepath.Dir(r.path), ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("creating telemetry state: %w", err)
+	}
+	defer os.Remove(f.Name())
+	defer f.Close()
+	if err := f.Chmod(0600); err != nil {
+		return fmt.Errorf("securing telemetry state: %w", err)
+	}
+	if _, err := f.Write(data); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(f.Name(), r.path); err != nil {
+		return fmt.Errorf("saving telemetry state: %w", err)
+	}
+	return nil
+}
+
+// Start launches the periodic reporting loop. It stops when ctx is cancelled.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			delay := time.Until(last.Add(interval))
+			if delay > 0 {
+				timer := time.NewTimer(delay)
+				select {
+				case <-ctx.Done():
+					if !timer.Stop() {
+						select {
+						case <-timer.C:
+						default:
+						}
+					}
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			if err := r.Report(ctx); err != nil {
+				r.logger.WithError(err).Warn("reporting anonymous telemetry")
+			}
+			timer := time.NewTimer(interval)
+			select {
+			case <-ctx.Done():
+				if !timer.Stop() {
+					select {
+					case <-timer.C:
+					default:
+					}
+				}
+				return
+			case <-timer.C:
+			}
+		}
+	}()
+}
+
+// Report sends one anonymous ping and saves its successful timestamp.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	payload := struct {
+		Event       string                 `json:"event"`
+		AnonymousId string                 `json:"anonymousId"`
+		Properties  map[string]interface{} `json:"properties"`
+	}{
+		Event: "flipt.ping", AnonymousId: r.state.UUID,
+		Properties: map[string]interface{}{
+			"uuid": r.state.UUID, "version": schemaVersion,
+			"flipt.version": info.Version,
+		},
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry event: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("telemetry endpoint returned %s", resp.Status)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	return r.save()
+}
