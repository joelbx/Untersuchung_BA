+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,136 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+type transportFunc func(*http.Request) (*http.Response, error)
+
+func (f transportFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestReporter(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	reporter, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := reporter.state.UUID
+	if _, err := uuid.FromString(original); err != nil {
+		t.Fatal(err)
+	}
+	if reporter.state.Version != schemaVersion {
+		t.Fatalf("schema version: %q", reporter.state.Version)
+	}
+	info.Version = "test-version"
+	reporter.client.Transport = transportFunc(func(req *http.Request) (*http.Response, error) {
+		if req.Method != http.MethodPost {
+			t.Errorf("method: %s", req.Method)
+		}
+		var event struct {
+			Event       string `json:"event"`
+			AnonymousId string `json:"anonymousId"`
+			Properties  struct {
+				UUID         string `json:"uuid"`
+				Version      string `json:"version"`
+				FliptVersion string `json:"flipt.version"`
+			} `json:"properties"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&event); err != nil {
+			t.Fatal(err)
+		}
+		if event.Event != "flipt.ping" || event.AnonymousId != original || event.Properties.UUID != original || event.Properties.Version != schemaVersion || event.Properties.FliptVersion != "test-version" {
+			t.Errorf("unexpected event: %+v", event)
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(""))}, nil
+	})
+	if err := reporter.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "telemetry.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved state
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.UUID != original {
+		t.Fatal("UUID changed")
+	}
+	if _, err := time.Parse(time.RFC3339, saved.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+	reopened, err := NewReporter(cfg, logrus.New())
+	if err != nil || reopened.state.UUID != original {
+		t.Fatalf("UUID did not persist: %v", err)
+	}
+}
+
+func TestReporterFailuresAndOptOut(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	cfg.Meta.TelemetryEnabled = false
+	reporter, err := NewReporter(cfg, logrus.New())
+	if err != nil || reporter != nil {
+		t.Fatalf("disabled reporter: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "telemetry.json")); !os.IsNotExist(err) {
+		t.Fatalf("disabled state file: %v", err)
+	}
+	cfg.Meta.TelemetryEnabled = true
+	reporter, err = NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	reporter.client.Transport = transportFunc(func(*http.Request) (*http.Response, error) { return nil, errors.New("offline") })
+	if err := reporter.Report(context.Background()); err == nil {
+		t.Fatal("expected send error")
+	}
+	if reporter.state.LastTimestamp != "" {
+		t.Fatal("failed send updated timestamp")
+	}
+	file := filepath.Join(dir, "file")
+	if err := os.WriteFile(file, []byte("x"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Meta.StateDirectory = file
+	if _, err := NewReporter(cfg, logrus.New()); err == nil {
+		t.Fatal("expected directory error")
+	}
+}
+
+func TestMalformedStateRegeneratesUUID(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "telemetry.json"), []byte(`{"uuid":"bad","lastTimestamp":"bad"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	reporter, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := uuid.FromString(reporter.state.UUID); err != nil {
+		t.Fatal(err)
+	}
+	if reporter.state.LastTimestamp != "" {
+		t.Fatal("invalid timestamp retained")
+	}
+}
