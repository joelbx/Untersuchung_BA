@@ -3,15 +3,34 @@ package singleton
 import (
 	"reflect"
 	"strings"
+	"sync"
 
 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances        = make(map[string]interface{})
+	getOrCreateC     = make(chan *entry, 1)
+	genericInstances sync.Map // reflect.Type -> *genericEntry[T]
 )
 
+type genericEntry[T any] struct {
+	once  sync.Once
+	value T
+}
+
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// The type T is inferred from the constructor's return type.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	stored, _ := genericInstances.LoadOrStore(typeOfT, &genericEntry[T]{})
+	instance := stored.(*genericEntry[T])
+	instance.once.Do(func() {
+		instance.value = constructor()
+	})
+	return instance.value
+}
+
 type entry struct {
 	constructor func() interface{}
 	object      interface{}
diff --git a/utils/singleton/singleton_test.go b/utils/singleton/singleton_test.go
index 9014e4e..e82b5e7 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -17,6 +17,68 @@ func TestSingleton(t *testing.T) {
 	RunSpecs(t, "Singleton Suite")
 }
 
+func TestGetInstance(t *testing.T) {
+	type item struct{ id int }
+	valueCalls, pointerCalls := 0, 0
+	valueConstructor := func() item {
+		valueCalls++
+		return item{id: 1}
+	}
+	pointerConstructor := func() *item {
+		pointerCalls++
+		return &item{id: 2}
+	}
+
+	firstValue := singleton.GetInstance(valueConstructor)
+	secondValue := singleton.GetInstance(func() item {
+		t.Fatal("value constructor called again")
+		return item{}
+	})
+	if firstValue != secondValue || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", firstValue, secondValue, valueCalls)
+	}
+
+	firstPointer := singleton.GetInstance(pointerConstructor)
+	secondPointer := singleton.GetInstance(func() *item {
+		t.Fatal("pointer constructor called again")
+		return nil
+	})
+	if firstPointer != secondPointer || pointerCalls != 1 || firstPointer.id != 2 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", firstPointer, secondPointer, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type item struct{ id int }
+	const calls = 20_000
+	var created int32
+	results := make([]*item, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *item {
+				atomic.AddInt32(&created, 1)
+				return &item{id: 42}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&created); got != 1 {
+		t.Fatalf("constructor called %d times, want 1", got)
+	}
+	for i, result := range results {
+		if result != results[0] || result.id != 42 {
+			t.Fatalf("call %d returned %p, want %p", i, result, results[0])
+		}
+	}
+}
+
