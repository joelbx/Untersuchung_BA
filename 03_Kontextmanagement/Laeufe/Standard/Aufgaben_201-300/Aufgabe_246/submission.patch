+package scan
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestAnalyzeFileKeepsLockfilePaths(t *testing.T) {
+	var scanners models.LibraryScanners
+	for _, file := range []struct {
+		path, version string
+	}{
+		{"/project/a/Pipfile.lock", "1.0.0"},
+		{"/project/b/Pipfile.lock", "2.0.0"},
+	} {
+		content := []byte(`{"default":{"example":{"version":"==` + file.version + `"}}}`)
+		apps, err := AnalyzeFile(file.path, &DummyFileInfo{}, func() ([]byte, error) {
+			return content, nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		scanners = append(scanners, convertLibWithScanner(apps)...)
+	}
+	if len(scanners) != 2 {
+		t.Fatalf("got %d scanners, want 2", len(scanners))
+	}
+	for _, want := range []struct{ path, version string }{
+		{"/project/a/Pipfile.lock", "1.0.0"},
+		{"/project/b/Pipfile.lock", "2.0.0"},
+	} {
+		libs := scanners.Find(want.path, "example")
+		lib, ok := libs[want.path]
+		if len(libs) != 1 || !ok || lib.Version != want.version {
+			t.Fatalf("wrong library for %s: %#v", want.path, libs)
+		}
+	}
+}
+
+func TestLibraryScannerUnknownFile(t *testing.T) {
+	if _, err := (models.LibraryScanner{Path: "/tmp/unknown.lock"}).Scan(); err == nil {
+		t.Fatal("expected an error for an unknown lockfile")
+	}
+}
