index 0000000..8f21506
--- /dev/null
+++ b/src/database/bulkIncrement.js
@@ -0,0 +1,35 @@
+'use strict';
+
+module.exports = function normalizeBulkIncrements(data, fieldToString = String) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const byKey = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			![Object.prototype, null].includes(Object.getPrototypeOf(item[1]))) {
+			throw new TypeError('Bulk increments must contain [key, increments] tuples');
+		}
+		const increments = byKey.get(item[0]) || new Map();
+		Object.entries(item[1]).forEach(([rawField, value]) => {
+			const field = fieldToString(rawField);
+			if (!field || ['__proto__', 'constructor', 'prototype', '_key'].includes(field) ||
+				/[.$]/.test(rawField) || /[.$]/.test(field)) {
+				throw new TypeError(`Invalid increment field: ${rawField}`);
+			}
+			if (!Number.isSafeInteger(value)) {
+				throw new TypeError(`Increment for ${field} must be a safe integer`);
+			}
+			const sum = (increments.get(field) || 0) + value;
+			if (!Number.isSafeInteger(sum)) {
+				throw new RangeError(`Combined increment for ${field} is not a safe integer`);
+			}
+			increments.set(field, sum);
+		});
+		if (increments.size) {
+			byKey.set(item[0], increments);
+		}
+	});
+	return Array.from(byKey, ([key, fields]) => [key, Object.fromEntries(fields)]);
+};
