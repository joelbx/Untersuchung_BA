+	module.incrObjectFieldByBulk = async function (data) {
+		const updates = normalizeBulkIncrements(data, helpers.fieldToString);
+		if (!updates.length) {
+			return;
+		}
+
+		const bulk = module.client.collection('objects').initializeUnorderedBulkOp();
+		updates.forEach(([key, increments]) => {
+			bulk.find({ _key: key }).upsert().updateOne({ $inc: increments });
+		});
+		try {
+			await bulk.execute();
+			cache.del(updates.map(([key]) => key));
+		} catch (err) {
+			// An unordered bulk can commit other keys even when one key fails.
+			const writeErrors = err && (err.writeErrors || (err.result && err.result.writeErrors));
+			if (Array.isArray(writeErrors)) {
+				const failed = new Set(writeErrors.map(error => error.index));
+				cache.del(updates.filter((item, index) => !failed.has(index)).map(([key]) => key));
+			}
+			throw err;
+		}
+	};
+
