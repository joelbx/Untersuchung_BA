+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "loadstart", "progress", "suspend", "emptied", "loadedmetadata", "loadeddata",
+    "canplay", "canplaythrough", "playing", "waiting", "seeking", "seeked",
+    "ended", "durationchange", "timeupdate", "play", "pause", "ratechange", "volumechange",
+]);
+
+/** Listener for events from a call sound media element. */
+export function handleEvent(e: Event): void {
+    const id = (e.currentTarget as HTMLMediaElement | null)?.id;
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call audio event", { id, type: e.type });
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call audio event", { id, type: e.type });
+    }
+}
