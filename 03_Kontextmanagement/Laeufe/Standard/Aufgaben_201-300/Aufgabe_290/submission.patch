+describe('call sound playback', () => {
+    it.each(Object.values(AudioID))('unmutes %s before playing', (id) => {
+        const handler = new LegacyCallHandler();
+        const audio = document.createElement('audio');
+        audio.id = id;
+        audio.muted = true;
+        const play = jest.spyOn(audio, 'play').mockImplementation(() => {
+            expect(audio.muted).toBe(false);
+            return Promise.resolve();
+        });
+        document.body.appendChild(audio);
+
+        handler.play(id);
+
+        expect(play).toHaveBeenCalledTimes(1);
+        audio.remove();
+    });
+
+    it('plays an already unmuted element without changing its muted state', () => {
+        const handler = new LegacyCallHandler();
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ring;
+        const play = jest.spyOn(audio, 'play').mockResolvedValue(undefined);
+        document.body.appendChild(audio);
+
+        handler.play(AudioID.Ring);
+
+        expect(audio.muted).toBe(false);
+        expect(play).toHaveBeenCalledTimes(1);
+        audio.remove();
+    });
+});
+
+describe('call sound media events', () => {
+    it('logs errors with the element id, and gates debug events by setting', () => {
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ring;
+        audio.addEventListener('error', handleEvent);
+        audio.addEventListener('playing', handleEvent);
+        audio.addEventListener('click', handleEvent);
+        const error = jest.spyOn(logger, 'error').mockImplementation(() => {});
+        const debug = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+        const getValue = jest.spyOn(SettingsStore, 'getValue').mockReturnValue(false);
+
+        audio.dispatchEvent(new Event('error'));
+        audio.dispatchEvent(new Event('playing'));
+        audio.dispatchEvent(new Event('click'));
+        expect(error).toHaveBeenCalledWith('Legacy call audio event', { id: AudioID.Ring, type: 'error' });
+        expect(debug).not.toHaveBeenCalled();
+
+        getValue.mockReturnValue(true);
+        audio.dispatchEvent(new Event('playing'));
+        expect(debug).toHaveBeenCalledWith('Legacy call audio event', { id: AudioID.Ring, type: 'playing' });
+
+        error.mockRestore();
+        debug.mockRestore();
+        getValue.mockRestore();
+    });
+});
