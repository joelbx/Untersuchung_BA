+func TestFeaturesValidator_MultipleErrors(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	source := []byte("namespace: default\nflags:\n- ey: wrong\n  name: test\n  nabled: true\n  description: test\n  variants: []\n  rules:\n  - segment: all\n    rank: 1\n    distributions:\n    - variant: a\n      rollout: 110\nsegments: []\n")
+	result, err := validator.Validate("input.yaml", source)
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.Len(t, result.Errors, 3)
+	require.Equal(t, "flags.0.ey", result.Errors[0].Path)
+	require.Equal(t, Location{File: "input.yaml", Line: 3, Column: 3}, result.Errors[0].Location)
+	require.Equal(t, "field \"ey\" not allowed", result.Errors[0].Message)
+	require.Equal(t, "flags.0.nabled", result.Errors[1].Path)
+	require.Equal(t, Location{File: "input.yaml", Line: 5, Column: 3}, result.Errors[1].Location)
+	require.Equal(t, "flags.0.rules.0.distributions.0.rollout", result.Errors[2].Path)
+	require.Equal(t, Location{File: "input.yaml", Line: 13, Column: 16}, result.Errors[2].Location)
+	require.Contains(t, result.Errors[2].Message, "out of bound <=100")
+}
+
+func TestValidateFiles_JSON(t *testing.T) {
+	file := filepath.Join("fixtures", "invalid.yaml")
+	var output bytes.Buffer
+	err := ValidateFiles(&output, []string{file, file}, "json")
+	require.True(t, errors.Is(err, ErrValidationFailed))
+	var result Result
+	require.NoError(t, json.Unmarshal(output.Bytes(), &result))
+	require.Len(t, result.Errors, 2)
+	require.Equal(t, file, result.Errors[0].Location.File)
+	require.Equal(t, "flags.0.rules.0.distributions.0.rollout", result.Errors[0].Path)
+}
+
+func TestValidateFiles_Text(t *testing.T) {
+	var output bytes.Buffer
+	err := ValidateFiles(&output, []string{filepath.Join("fixtures", "invalid.yaml")}, "text")
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.Contains(t, output.String(), "fixtures/invalid.yaml:17:16: flags.0.rules.0.distributions.0.rollout")
+	require.Contains(t, output.String(), "rollout: invalid value 110 (out of bound <=100)")
+}
+
+func TestFeaturesValidator_InvalidYAML(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	result, err := validator.Validate("broken.yaml", []byte("flags: [\n"))
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.NotEmpty(t, result.Errors)
+	require.Equal(t, "broken.yaml", result.Errors[0].Location.File)
+	require.NotZero(t, result.Errors[0].Location.Line)
+}
