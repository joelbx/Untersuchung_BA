diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..cee37a1
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, contents string) string {
+	t.Helper()
+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := f.Name()
+	if _, err := f.WriteString(contents); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	path := writeConfig(t, "server:\n  host: 127.0.0.1\n")
+	defer os.Remove(path)
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := defaultConfig()
+	want.Server.Host = "127.0.0.1"
+	if !reflect.DeepEqual(cfg, want) {
+		t.Fatalf("config mismatch: got %+v, want %+v", cfg, want)
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8081"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	path = writeConfig(t, "server:\n  http_port: 8082\n")
+	defer os.Remove(path)
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.HTTPPort != 8081 {
+		t.Fatalf("environment override: got %d", cfg.Server.HTTPPort)
+	}
+}
+
+func TestConfigureHTTPSAndOrigins(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := ioutil.WriteFile(path, []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, origins := range []string{"foo.com", "[foo.com]"} {
+		path := writeConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: "+origins+"\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: "+cert+"\n  cert_key: "+key+"\n")
+		defer os.Remove(path)
+		cfg, err := configure(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server.Protocol != HTTPS || cfg.Server.HTTPPort != 8081 || cfg.Server.HTTPSPort != 8080 || cfg.Server.GRPCPort != 9001 || cfg.Server.CertFile != cert || cfg.Server.CertKey != key {
+			t.Fatalf("unexpected HTTPS config: %+v", cfg)
+		}
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	for _, tc := range []struct {
+		cert, key, want string
+	}{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{"cert.pem", "", "cert_key cannot be empty when using HTTPS"},
+		{"missing-cert.pem", "key.pem", `cannot find TLS cert_file at "missing-cert.pem"`},
+	} {
+		cfg := defaultConfig()
+		cfg.Server.Protocol = HTTPS
+		cfg.Server.CertFile, cfg.Server.CertKey = tc.cert, tc.key
+		if err := cfg.validate(); err == nil || err.Error() != tc.want {
+			t.Fatalf("got %v, want %q", err, tc.want)
+		}
+	}
+	dir, err := ioutil.TempDir("", "flipt-cert-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	if err := ioutil.WriteFile(cert, []byte("fixture"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	cfg.Server.CertFile = cert
+	cfg.Server.CertKey = filepath.Join(dir, "missing-key.pem")
+	if err := cfg.validate(); err == nil || err.Error() != "cannot find TLS cert_key at \""+cfg.Server.CertKey+"\"" {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg = defaultConfig()
+	cfg.Server.CertFile = "missing-cert.pem"
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestConfigAndInfoHandlers(t *testing.T) {
+	for _, handler := range []interface {
+		ServeHTTP(http.ResponseWriter, *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest("GET", "/", nil))
+		if recorder.Code != 200 || strings.TrimSpace(recorder.Body.String()) == "" {
+			t.Fatalf("status %d, body %q", recorder.Code, recorder.Body.String())
+		}
+	}
+}
