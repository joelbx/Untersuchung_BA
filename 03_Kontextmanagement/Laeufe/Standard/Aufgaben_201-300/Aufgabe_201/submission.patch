 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,141 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ Segment IsSegment }
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v != "" {
+			return string(v), nil
+		}
+	case Segments:
+		if err := validateSegments(v); err == nil {
+			if len(v.Keys) == 1 {
+				v.SegmentOperator = "OR_SEGMENT_OPERATOR"
+			}
+			return v, nil
+		}
+	case *Segments:
+		if v != nil && validateSegments(*v) == nil {
+			copy := *v
+			if len(copy.Keys) == 1 {
+				copy.SegmentOperator = "OR_SEGMENT_OPERATOR"
+			}
+			return copy, nil
+		}
+	}
+	return nil, fmt.Errorf("invalid rule segment")
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		if v == "" {
+			return fmt.Errorf("segment key cannot be empty")
+		}
+		s.Segment = SegmentKey(v)
+	case map[interface{}]interface{}:
+		return s.unmarshalObject(v)
+	case map[string]interface{}:
+		object := make(map[interface{}]interface{}, len(v))
+		for key, value := range v {
+			object[key] = value
+		}
+		return s.unmarshalObject(object)
+	default:
+		return fmt.Errorf("segment must be a string or keys/operator object")
+	}
+	return nil
+}
+
+func (s *SegmentEmbed) unmarshalObject(v map[interface{}]interface{}) error {
+	if len(v) != 2 {
+		return fmt.Errorf("segment object requires keys and operator")
+	}
+	keys, ok := v["keys"].([]interface{})
+	if !ok {
+		return fmt.Errorf("segment keys must be a list")
+	}
+	operator, ok := v["operator"].(string)
+	if !ok {
+		return fmt.Errorf("segment operator must be a string")
+	}
+	segments := Segments{SegmentOperator: operator}
+	for _, key := range keys {
+		k, ok := key.(string)
+		if !ok || k == "" {
+			return fmt.Errorf("segment keys must be nonempty strings")
+		}
+		segments.Keys = append(segments.Keys, k)
+	}
+	if err := validateSegments(segments); err != nil {
+		return err
+	}
+	if len(segments.Keys) == 1 {
+		segments.SegmentOperator = "OR_SEGMENT_OPERATOR"
+	}
+	s.Segment = segments
+	return nil
+}
+
+func validateSegments(s Segments) error {
+	if len(s.Keys) == 0 {
+		return fmt.Errorf("segment keys cannot be empty")
+	}
+	for _, key := range s.Keys {
+		if key == "" {
+			return fmt.Errorf("segment keys cannot be empty")
+		}
+	}
+	if len(s.Keys) > 1 && s.SegmentOperator != "AND_SEGMENT_OPERATOR" && s.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid segment operator %q", s.SegmentOperator)
+	}
+	return nil
+}
+
+func (s SegmentEmbed) KeysAndOperator() ([]string, string, error) {
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v != "" {
+			return []string{string(v)}, "OR_SEGMENT_OPERATOR", nil
+		}
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, "", err
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys, "OR_SEGMENT_OPERATOR", nil
+		}
+		return v.Keys, v.SegmentOperator, nil
+	case *Segments:
+		if v != nil {
+			return (SegmentEmbed{Segment: *v}).KeysAndOperator()
+		}
+	}
+	return nil, "", fmt.Errorf("rule requires a segment key or keys/operator object")
 }
 
 type Distribution struct {
