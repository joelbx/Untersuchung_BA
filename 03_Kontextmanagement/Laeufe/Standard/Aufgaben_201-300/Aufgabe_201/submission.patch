--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,42 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+)
+
+func TestRuleSegmentYAML(t *testing.T) {
+	for _, tc := range []struct {
+		name, input string
+		keys        []string
+		operator    string
+		valid       bool
+	}{
+		{"string", "segment: foo", []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{"one key override", "segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR", []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{"multiple keys", "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR", []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR", true},
+		{"missing", "rank: 1", nil, "", false},
+		{"wrong type", "segment: [foo]", nil, "", false},
+		{"empty keys", "segment:\n  keys: []\n  operator: OR_SEGMENT_OPERATOR", nil, "", false},
+		{"missing operator", "segment:\n  keys: [foo, bar]", nil, "", false},
+		{"bad operator", "segment:\n  keys: [foo, bar]\n  operator: BAD", nil, "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var rule Rule
+			err := yaml.Unmarshal([]byte(tc.input), &rule)
+			if tc.valid {
+				require.NoError(t, err)
+				keys, operator, err := rule.Segment.KeysAndOperator()
+				require.NoError(t, err)
+				require.Equal(t, tc.keys, keys)
+				require.Equal(t, tc.operator, operator)
+				_, err = yaml.Marshal(&rule)
+				require.NoError(t, err)
+			} else if err == nil {
+				require.Nil(t, rule.Segment)
+			}
+		})
+	}
+}
