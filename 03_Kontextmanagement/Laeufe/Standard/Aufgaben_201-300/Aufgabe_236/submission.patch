+def test_safe_eval_deprecation():
+    before = len(get_deprecation_messages())
+    assert safe_eval('{}') == {}
+    messages = get_deprecation_messages()[before:]
+    assert len(messages) == 1
+    assert messages[0]['version'] == '2.21'
+    assert 'safe_eval' in messages[0]['msg']
+
