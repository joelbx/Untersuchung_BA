+def _parse_key_value_dict(value):
+    fields = []
+    field_buffer = []
+    quote = None
+    escaped = False
+    quoted = False
+    after_comma = False
+
+    for char in value.strip():
+        if escaped:
+            field_buffer.append(char)
+            escaped = False
+        elif char == '\\':
+            escaped = True
+        elif quote:
+            if char == quote:
+                quote = None
+            else:
+                field_buffer.append(char)
+        elif char in ('\'', '"'):
+            quote = char
+            quoted = True
+        elif char in (',', ' ', '\t', '\n'):
+            if field_buffer:
+                fields.append((''.join(field_buffer), quoted))
+                field_buffer = []
+                quoted = False
+                after_comma = False
+            if char == ',':
+                if after_comma or not fields:
+                    raise TypeError('dictionary key=value pairs contain an empty entry')
+                after_comma = True
+        else:
+            field_buffer.append(char)
+
+    if quote or escaped:
+        raise TypeError('dictionary key=value pairs contain an unterminated quote or escape')
+    if field_buffer:
+        fields.append((''.join(field_buffer), quoted))
+    elif after_comma:
+        raise TypeError('dictionary key=value pairs contain an empty entry')
+
+    result = {}
+    for field, was_quoted in fields:
+        if '=' not in field:
+            raise TypeError('dictionary key=value pair %r is missing an equals sign' % field)
+        key, item = field.split('=', 1)
+        if not key or (not item and not was_quoted):
+            raise TypeError('dictionary key=value pair %r has an empty key or value' % field)
+        if any(char in key for char in '{}[]:'):
+            raise TypeError('dictionary key=value pair %r has an invalid key' % field)
+        result[key] = item
+    return result
+
