+def test_check_type_dict_does_not_call_safe_eval(monkeypatch):
+    def fail(*args, **kwargs):
+        pytest.fail('check_type_dict called safe_eval')
+
+    monkeypatch.setattr('ansible.module_utils.common.validation.safe_eval', fail)
+    assert check_type_dict("{'key': 'value'}") == {'key': 'value'}
+
