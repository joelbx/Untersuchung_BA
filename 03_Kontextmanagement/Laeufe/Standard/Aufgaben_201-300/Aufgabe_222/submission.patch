+@pytest.mark.parametrize('collection, expected_name', [('', 'example'), ('ns.coll', 'ns.coll.example')])
+def test_build_role_doc_preserves_entry_specs(collection, expected_name):
+    main_spec = {'options': {'value': {'type': 'str'}}}
+    alternate_spec = {'short_description': 'Alternate entry point'}
+    argspec = {'main': main_spec, 'alternate': alternate_spec}
+
+    fqcn, doc = RoleMixin()._build_doc('example', '/roles/example', collection, argspec, entry_point='main')
+
+    assert fqcn == expected_name
+    assert doc == {'path': '/roles/example', 'collection': collection, 'entry_points': {'main': main_spec}}
+    assert doc['entry_points']['main'] is main_spec
+    assert argspec == {'main': main_spec, 'alternate': alternate_spec}
+
+
+@pytest.mark.parametrize('argspec, entry_point', [({}, None), ({'main': {'options': {}}}, 'missing')])
+def test_build_role_doc_omits_unmatched_entry_points(argspec, entry_point):
+    assert RoleMixin()._build_doc('example', '/roles/example', 'ns.coll', argspec, entry_point) == ('ns.coll.example', None)
+
+
+def test_build_role_doc_includes_all_entry_points_without_filter():
+    argspec = {'main': {'options': {'value': {'type': 'str'}}}, 'alternate': None}
+
+    fqcn, doc = RoleMixin()._build_doc('example', '/roles/example', None, argspec)
+
+    assert fqcn == 'example'
+    assert doc == {'path': '/roles/example', 'collection': None, 'entry_points': argspec}
+    assert doc['entry_points'] is not argspec
