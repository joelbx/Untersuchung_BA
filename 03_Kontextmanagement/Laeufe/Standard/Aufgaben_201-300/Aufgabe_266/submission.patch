 class TestImportItem:
+    def test_find_staged_or_pending(self, import_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'ia_id': 'amazon:123', 'status': 'staged'},
+                {'ia_id': 'amazon:456', 'status': 'pending'},
+                {'ia_id': 'idb:123', 'status': 'pending'},
+                {'ia_id': 'idb:456', 'status': 'staged'},
+                {'ia_id': 'other:123', 'status': 'staged'},
+                {'ia_id': 'amazon:789', 'status': 'staged'},
+                {'ia_id': 'idb:123', 'status': 'created'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['123', '456'])
+        assert isinstance(result, web.db.SqliteResultSet)
+        assert {(row.ia_id, row.status) for row in result} == {
+            ('amazon:123', 'staged'),
+            ('amazon:456', 'pending'),
+            ('idb:123', 'pending'),
+            ('idb:456', 'staged'),
+        }
+
+        custom = ImportItem.find_staged_or_pending(['123'], sources=iter(['other']))
+        assert [(row.ia_id, row.status) for row in custom] == [
+            ('other:123', 'staged')
+        ]
+
+        assert list(ImportItem.find_staged_or_pending([])) == []
+
     def test_delete(self, import_item_db):
