 class ImportItem(web.storage):
+    @staticmethod
+    def find_staged_or_pending(
+        identifiers: list[str], sources: Iterable[str] = STAGED_SOURCES
+    ):
+        """Find local import items for the given source identifiers."""
+        ia_ids = [
+            f'{source}:{identifier}'
+            for source in sources
+            for identifier in identifiers
+        ]
+        return db.select(
+            'import_item',
+            where="ia_id IN $ia_ids AND status IN ('staged', 'pending')",
+            vars={'ia_ids': ia_ids},
+        )
