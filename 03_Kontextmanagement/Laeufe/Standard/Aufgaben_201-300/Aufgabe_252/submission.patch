diff --git a/test/units/module_utils/facts/test_sysctl.py b/test/units/module_utils/facts/test_sysctl.py
new file mode 100644
index 0000000..5c9a5b1
--- /dev/null
+++ b/test/units/module_utils/facts/test_sysctl.py
@@ -0,0 +1,93 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import pytest
+
+from units.compat.mock import Mock
+
+from ansible.module_utils.facts.sysctl import get_sysctl
+from ansible.module_utils.facts.hardware.freebsd import FreeBSDHardware
+from ansible.module_utils.facts.hardware.netbsd import NetBSDHardware
+from ansible.module_utils.facts.hardware.openbsd import OpenBSDHardware
+
+
+def test_get_sysctl_parses_platform_formats_and_continuations():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, 'hw.ncpu=4\nkern.name: OpenBSD\nvm.test value\n'
+                                       '  continued value\nbroken\nhw.model = CPU\n', '')
+
+    result = get_sysctl(module, ['hw', 'kern'])
+
+    assert result == {'hw.ncpu': '4', 'kern.name': 'OpenBSD',
+                      'vm.test': 'value\n  continued value', 'hw.model': 'CPU'}
+    module.warn.assert_called_once_with(
+        'Unable to split sysctl line (broken): not enough values to unpack (expected 2, got 1)')
+
+
+@pytest.mark.parametrize('failure', [(1, '', 'denied'), OSError('missing sysctl'), IOError('unavailable')])
+def test_get_sysctl_command_failure(failure):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    if isinstance(failure, tuple):
+        module.run_command.return_value = failure
+        message = failure[2]
+    else:
+        module.run_command.side_effect = failure
+        message = str(failure)
+
+    assert get_sysctl(module, ['hw']) == {}
+    module.warn.assert_called_once_with('Unable to read sysctl: %s' % message)
+
+
+@pytest.mark.parametrize('hardware_class', [FreeBSDHardware, NetBSDHardware, OpenBSDHardware])
+def test_bsd_uptime(hardware_class, mocker):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, '100\n', '')
+    mocker.patch('ansible.module_utils.facts.sysctl.time.time', return_value=150)
+
+    assert hardware_class(module).get_uptime_facts() == {'uptime_seconds': 50}
+    module.run_command.assert_called_once_with(['/sbin/sysctl', '-n', 'kern.boottime'])
+
+
+@pytest.mark.parametrize('output', ['', 'not a number', '{ sec = 100 }'])
+def test_bsd_uptime_omits_invalid_output(output):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, output, '')
+    assert FreeBSDHardware(module).get_uptime_facts() == {}
+
+
+def test_bsd_uptime_omits_command_error():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (1, '', 'error')
+    assert FreeBSDHardware(module).get_uptime_facts() == {}
+
+
+@pytest.mark.parametrize('missing', [None, OSError('missing sysctl')])
+def test_bsd_uptime_missing_binary_raises(missing):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl' if missing else None
+    if missing:
+        module.run_command.side_effect = missing
+    with pytest.raises(ValueError):
+        OpenBSDHardware(module).get_uptime_facts()
+
+
+def test_openbsd_populate_includes_every_fact_source(mocker):
+    mocker.patch('ansible.module_utils.facts.hardware.openbsd.get_sysctl', return_value={})
+    hardware = OpenBSDHardware(Mock())
+    sources = {'get_processor_facts': {'processor': ['CPU']},
+               'get_memory_facts': {'memtotal_mb': 1024},
+               'get_device_facts': {'devices': ['sd0']},
+               'get_dmi_facts': {'product_name': 'machine'},
+               'get_mount_facts': {'mounts': []},
+               'get_uptime_facts': {'uptime_seconds': 50}}
+    for method, facts in sources.items():
+        mocker.patch.object(hardware, method, return_value=facts)
+
+    result = hardware.populate()
+
+    assert result == dict(item for facts in sources.values() for item in facts.items())
