+func TestClusterSessionDialEndpoint(t *testing.T) {
+	ctx := context.Background()
+	sess := &clusterSession{}
+	_, err := sess.dial(ctx, "tcp", "ignored")
+	require.True(t, trace.IsBadParameter(err))
+
+	endpoint := kubeClusterEndpoint{addr: "kube.example.com:3026", serverID: "server.local"}
+	sess.kubeEndpoint = endpoint
+	sess.kubeAddress = endpoint.addr
+	sess.teleportCluster.dial = func(_ context.Context, network, addr, serverID string) (net.Conn, error) {
+		require.Equal(t, "tcp", network)
+		require.Equal(t, endpoint.addr, addr)
+		require.Equal(t, endpoint.serverID, serverID)
+		return &net.TCPConn{}, nil
+	}
+	for i := 0; i < 2; i++ {
+		_, err := sess.dial(ctx, "tcp", "ignored")
+		require.NoError(t, err)
+		require.Equal(t, endpoint.addr, sess.kubeAddress)
+	}
+}
