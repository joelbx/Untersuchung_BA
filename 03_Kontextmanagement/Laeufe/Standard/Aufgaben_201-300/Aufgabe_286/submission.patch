new file mode 100644
index 0000000..2444cbc
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,88 @@
+package release
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+)
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"dev", false},
+		{"", false},
+		{"v1.2.3-snapshot", false},
+		{"v1.2.3-snapshot.4", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-rc1", false},
+		{"v1.2.3-dev", false},
+		{"v1.2.3-beta.1", false},
+		{"v1.2.3", true},
+		{"1.2.3", true},
+		{"invalid", false},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			if got := Is(tc.version); got != tc.want {
+				t.Fatalf("Is(%q) = %v, want %v", tc.version, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"tag_name":"v1.2.3","html_url":"https://example.com/v1.2.3"}`))
+	}))
+	defer server.Close()
+
+	client := github.NewClient(server.Client())
+	client.BaseURL, _ = url.Parse(server.URL + "/")
+
+	for _, tc := range []struct {
+		current string
+		update  bool
+	}{
+		{"v1.2.2", true},
+		{"v1.2.3", false},
+		{"v1.2.4", false},
+	} {
+		t.Run(tc.current, func(t *testing.T) {
+			got, err := check(context.Background(), tc.current, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tc.current || got.LatestVersion != "v1.2.3" || got.LatestVersionURL != "https://example.com/v1.2.3" || got.UpdateAvailable != tc.update {
+				t.Fatalf("unexpected release info: %+v", got)
+			}
+		})
+	}
+}
+
+func TestCheckFailurePreservesCurrentVersion(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		http.Error(w, "unavailable", http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+
+	client := github.NewClient(server.Client())
+	client.BaseURL, _ = url.Parse(server.URL + "/")
+
+	got, err := check(context.Background(), "v1.2.3", client)
+	if err == nil {
+		t.Fatal("expected update check error")
+	}
+	if got.CurrentVersion != "v1.2.3" || got.LatestVersion != "" || got.UpdateAvailable {
+		t.Fatalf("unexpected release info after failure: %+v", got)
+	}
+}
