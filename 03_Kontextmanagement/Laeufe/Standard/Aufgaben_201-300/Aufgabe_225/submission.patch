+func fillKEVs(vuln *models.VulnInfo, response kevulndb.Response) {
+	vuln.KEVs = nil
+	vuln.AlertDict.CISA = nil
+	for _, entry := range response.CISA {
+		var dueDate *time.Time
+		if entry.DueDate.Year() > 1000 {
+			due := entry.DueDate
+			dueDate = &due
+		}
+		vuln.KEVs = append(vuln.KEVs, models.KEV{
+			Type: models.CISAKEVType, VendorProject: entry.VendorProject,
+			Product: entry.Product, VulnerabilityName: entry.VulnerabilityName,
+			ShortDescription: entry.ShortDescription, RequiredAction: entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  entry.DateAdded, DueDate: dueDate,
+			CISA: &models.CISAKEV{Note: entry.Notes},
+		})
+	}
+	if len(response.CISA) > 0 {
+		vuln.AlertDict.CISA = []models.Alert{{
+			Title: "Known Exploited Vulnerabilities Catalog",
+			URL:   "https://www.cisa.gov/known-exploited-vulnerabilities-catalog",
+			Team:  "cisa",
+		}}
+	}
+	for _, entry := range response.VulnCheck {
+		var dueDate *time.Time
+		if entry.DueDate != nil && entry.DueDate.Year() > 1000 {
+			dueDate = entry.DueDate
+		}
+		v := models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: entry.VendorProject,
+			Product: entry.Product, VulnerabilityName: entry.Name,
+			ShortDescription: entry.Description, RequiredAction: entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  entry.DateAdded, DueDate: dueDate,
+			VulnCheck: &models.VulnCheckKEV{},
+		}
+		for _, xdb := range entry.VulnCheckXDB {
+			v.VulnCheck.XDB = append(v.VulnCheck.XDB, models.VulnCheckXDB{
+				XDBID: xdb.XDBID, XDBURL: xdb.XDBURL, DateAdded: xdb.DateAdded,
+				ExploitType: xdb.ExploitType, CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, report := range entry.VulnCheckReportedExploitation {
+			v.VulnCheck.ReportedExploitation = append(v.VulnCheck.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL: report.URL, DateAdded: report.DateAdded,
+			})
+		}
+		vuln.KEVs = append(vuln.KEVs, v)
+	}
+}
+
 type kevulnResponse struct {
 	request kevulnRequest
 	json    string
diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..d3dce2a
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,44 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestFillKEVs(t *testing.T) {
+	date := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	placeholder := time.Date(1000, 1, 1, 0, 0, 0, 0, time.UTC)
+	vuln := models.VulnInfo{}
+	fillKEVs(&vuln, kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{
+			VendorProject: "CISA vendor", Product: "CISA product", VulnerabilityName: "CISA name",
+			ShortDescription: "CISA description", RequiredAction: "patch", Notes: "note",
+			DateAdded: date, DueDate: placeholder,
+		}},
+		VulnCheck: []kevulnmodels.VulnCheck{{
+			VendorProject: "VC vendor", Product: "VC product", Name: "VC name",
+			Description: "VC description", RequiredAction: "mitigate", DateAdded: date, DueDate: &placeholder,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "1", XDBURL: "xdb-url", DateAdded: date, ExploitType: "poc", CloneSSHURL: "ssh-url"}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "report-url", DateAdded: date}},
+		}},
+	})
+	if len(vuln.KEVs) != 2 || vuln.KEVs[0].Type != models.CISAKEVType || vuln.KEVs[1].Type != models.VulnCheckKEVType {
+		t.Fatalf("unexpected KEVs: %+v", vuln.KEVs)
+	}
+	if vuln.KEVs[0].DueDate != nil || vuln.KEVs[1].DueDate != nil || vuln.KEVs[0].CISA.Note != "note" {
+		t.Fatalf("invalid CISA or due date mapping: %+v", vuln.KEVs)
+	}
+	vc := vuln.KEVs[1].VulnCheck
+	if vc == nil || len(vc.XDB) != 1 || vc.XDB[0].CloneSSHURL != "ssh-url" || len(vc.ReportedExploitation) != 1 || vc.ReportedExploitation[0].URL != "report-url" {
+		t.Fatalf("invalid VulnCheck mapping: %+v", vc)
+	}
+	if len(vuln.AlertDict.CISA) != 1 {
+		t.Fatalf("legacy CISA alert missing: %+v", vuln.AlertDict)
+	}
+}
