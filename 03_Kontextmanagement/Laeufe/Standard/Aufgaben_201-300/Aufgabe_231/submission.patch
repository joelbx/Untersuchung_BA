diff --git a/detector/vuls2/db_internal_test.go b/detector/vuls2/db_internal_test.go
new file mode 100644
index 0000000..73256af
--- /dev/null
+++ b/detector/vuls2/db_internal_test.go
@@ -0,0 +1,27 @@
+package vuls2
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	bolt "go.etcd.io/bbolt"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestNewDBConnectionMetadataErrorIncludesPath(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "vuls.db")
+	dbc, err := bolt.Open(path, 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dbc.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	_, err = newDBConnection(config.Vuls2Conf{Path: path, SkipUpdate: true}, true)
+	if err == nil || !strings.Contains(err.Error(), path) || !strings.Contains(err.Error(), "metadata") {
+		t.Fatalf("newDBConnection() error = %v, want metadata error with path %q", err, path)
+	}
+}
