+@pytest.mark.parametrize('webengine_version, expected_key', [
+    ('5.15.3', 'TextBrightnessThreshold'),
+    ('6.2.0', 'TextBrightnessThreshold'),
+    ('6.3.0', 'TextBrightnessThreshold'),
+    ('6.4.0', 'ForegroundBrightnessThreshold'),
+    ('6.5.0', 'ForegroundBrightnessThreshold'),
+])
+def test_foreground_threshold(config_stub, webengine_version, expected_key):
+    config_stub.val.colors.webpage.darkmode.enabled = True
+    config_stub.val.colors.webpage.darkmode.threshold.foreground = 100
+
+    versions = version.WebEngineVersions.from_pyqt(webengine_version)
+    settings = darkmode.settings(versions=versions, special_flags=[])
+    assert (expected_key, '100') in settings['dark-mode-settings']
+
+
+def test_legacy_text_threshold(config_stub):
+    old = 'colors.webpage.darkmode.threshold.text'
+    new = 'colors.webpage.darkmode.threshold.foreground'
+    assert configdata.MIGRATIONS.renamed[old] == new
+
+    config_stub.set_obj(old, 100)
+    assert config_stub.get(new) == 100
+
+    config_stub.val.colors.webpage.darkmode.enabled = True
+    versions = version.WebEngineVersions.from_pyqt('6.4.0')
+    settings = darkmode.settings(versions=versions, special_flags=[])
+    assert ('ForegroundBrightnessThreshold', '100') in settings['dark-mode-settings']
+
+
+def test_foreground_threshold_option(configdata_init):
+    option = configdata.DATA['colors.webpage.darkmode.threshold.foreground']
+    assert isinstance(option.typ, configtypes.Int)
+    assert option.default == 256
+
+
