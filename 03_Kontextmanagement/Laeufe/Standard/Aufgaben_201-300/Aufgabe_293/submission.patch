+func validateOCIReference(repository string) error {
+	scheme, reference, explicit := strings.Cut(repository, "://")
+	if !explicit {
+		reference = scheme
+		scheme = "https"
+	}
+	if !strings.Contains(reference, "/") && !explicit {
+		reference = "local/" + reference
+		scheme = "flipt"
+	}
+	switch scheme {
+	case "http", "https", "flipt":
+	default:
+		return fmt.Errorf("unexpected repository scheme: %q should be one of [http|https|flipt]", scheme)
+	}
+	ref, err := registry.ParseReference(reference)
+	if err != nil {
+		return err
+	}
+	switch scheme {
+	case "http", "https":
+	case "flipt":
+		if ref.Registry != "local" {
+			return fmt.Errorf("unexpected local reference: %q", ref)
+		}
+	}
+	return nil
+}
+
+// DefaultBundleDir returns the default directory for locally stored OCI bundles.
+func DefaultBundleDir() (string, error) {
+	dir, err := defaultDatabaseRoot()
+	if err != nil {
+		return "", err
+	}
+	bundlesDir := filepath.Join(dir, "flipt", "bundles")
+	if err := os.MkdirAll(bundlesDir, 0755); err != nil {
+		return "", fmt.Errorf("creating bundles directory: %w", err)
+	}
+	return bundlesDir, nil
+}
