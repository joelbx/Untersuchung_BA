+			keySessionID:  {S: aws.String(legacy.SessionID)},
+			keyEventIndex: {N: aws.String("1")},
+		},
+		ConsistentRead: aws.Bool(true),
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(out.Item["Fields"], check.IsNil)
+	c.Assert(out.Item[keyFieldsMap].M["nested"].M["count"].N, check.DeepEquals, aws.String("42"))
