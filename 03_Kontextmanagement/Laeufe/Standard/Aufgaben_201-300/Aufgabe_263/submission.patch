diff --git a/lib/events/dynamoevents/fieldsmap.go b/lib/events/dynamoevents/fieldsmap.go
new file mode 100644
index 0000000..dda05b9
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap.go
@@ -0,0 +1,266 @@
+package dynamoevents
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"reflect"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/gravitational/trace"
+)
+
+const keyFieldsMap = "FieldsMap"
+
+// jsonFieldsMap retains JSON number precision and nested JSON types in DynamoDB.
+func jsonFieldsMap(data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	var trailing interface{}
+	if err := decoder.Decode(&trailing); err == nil {
+		return nil, trace.BadParameter("unexpected data after event fields")
+	} else if err != io.EOF {
+		return nil, trace.Wrap(err)
+	}
+	out := make(map[string]*dynamodb.AttributeValue, len(fields))
+	for key, value := range fields {
+		av, err := jsonAttribute(value)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		out[key] = av
+	}
+	return out, nil
+}
+
+func jsonAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch value := value.(type) {
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(value))}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(value)}, nil
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(value)}, nil
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}, nil
+	case map[string]interface{}:
+		out := make(map[string]*dynamodb.AttributeValue, len(value))
+		for key, element := range value {
+			av, err := jsonAttribute(element)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out[key] = av
+		}
+		return &dynamodb.AttributeValue{M: out}, nil
+	case []interface{}:
+		out := make([]*dynamodb.AttributeValue, 0, len(value))
+		for _, element := range value {
+			av, err := jsonAttribute(element)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out = append(out, av)
+		}
+		return &dynamodb.AttributeValue{L: out}, nil
+	default:
+		return dynamodbattribute.Marshal(value)
+	}
+}
+
+func setFieldsMap(item map[string]*dynamodb.AttributeValue, data []byte) error {
+	fields, err := jsonFieldsMap(data)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	delete(item, "Fields")
+	item[keyFieldsMap] = &dynamodb.AttributeValue{M: fields}
+	return nil
+}
+
+// restoreFields supplies the legacy in-memory representation used by event readers.
+func restoreFields(item map[string]*dynamodb.AttributeValue) error {
+	av := item[keyFieldsMap]
+	if av == nil {
+		return nil
+	}
+	if av.M == nil {
+		return trace.BadParameter("FieldsMap is not a map")
+	}
+	var fields map[string]interface{}
+	decoder := dynamodbattribute.NewDecoder(func(d *dynamodbattribute.Decoder) { d.UseNumber = true })
+	if err := decoder.Decode(av, &fields); err != nil {
+		return trace.Wrap(err)
+	}
+	data, err := json.Marshal(normalizeNumbers(fields))
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	item["Fields"] = &dynamodb.AttributeValue{S: aws.String(string(data))}
+	return nil
+}
+
+func normalizeNumbers(value interface{}) interface{} {
+	switch value := value.(type) {
+	case dynamodbattribute.Number:
+		return json.Number(value)
+	case map[string]interface{}:
+		for key, element := range value {
+			value[key] = normalizeNumbers(element)
+		}
+	case []interface{}:
+		for index, element := range value {
+			value[index] = normalizeNumbers(element)
+		}
+	}
+	return value
+}
+
+func (l *Log) fieldsFlagKey() []byte {
+	return backend.FlagKey("dynamoEvents", l.Tablename, "fieldsMap")
+}
+
+func (l *Log) migrateFieldsWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		if err := l.migrateFields(ctx); err == nil {
+			return
+		} else {
+			l.WithError(err).Error("FieldsMap migration failed; retrying")
+		}
+		select {
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+func (l *Log) migrateFields(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMigrationLock+"/"+l.Tablename, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		flag := l.fieldsFlagKey()
+		if _, err := l.backend.Get(ctx, flag); err == nil {
+			return nil
+		} else if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+		l.Info("Starting FieldsMap event migration")
+		var startKey map[string]*dynamodb.AttributeValue
+		var migrated int64
+		for {
+			out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName:                aws.String(l.Tablename),
+				ExclusiveStartKey:        startKey,
+				ConsistentRead:           aws.Bool(true),
+				Limit:                    aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+				FilterExpression:         aws.String("attribute_exists(#fields) AND attribute_not_exists(#map)"),
+				ExpressionAttributeNames: map[string]*string{"#fields": aws.String("Fields"), "#map": aws.String(keyFieldsMap)},
+				ProjectionExpression:     aws.String("SessionID, EventIndex, #fields"),
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			// DynamoDB has no batch update operation. Process each scan page with a
+			// bounded set of conditional updates, preserving concurrent writes.
+			sem := make(chan struct{}, maxMigrationWorkers)
+			var wg sync.WaitGroup
+			var firstErr error
+			var errorMu sync.Mutex
+			for _, item := range out.Items {
+				if ctx.Err() != nil {
+					break
+				}
+				sem <- struct{}{}
+				wg.Add(1)
+				go func(item map[string]*dynamodb.AttributeValue) {
+					defer wg.Done()
+					defer func() { <-sem }()
+					if err := l.migrateFieldsItem(ctx, item); err != nil {
+						errorMu.Lock()
+						if firstErr == nil {
+							firstErr = err
+						}
+						errorMu.Unlock()
+					} else {
+						errorMu.Lock()
+						migrated++
+						errorMu.Unlock()
+					}
+				}(item)
+			}
+			wg.Wait()
+			if firstErr != nil {
+				return trace.Wrap(firstErr)
+			}
+			if err := ctx.Err(); err != nil {
+				return trace.Wrap(err)
+			}
+			l.Infof("FieldsMap migration processed %d events", migrated)
+			startKey = out.LastEvaluatedKey
+			if startKey == nil {
+				break
+			}
+		}
+		_, err := l.backend.Put(ctx, backend.Item{Key: flag, Value: []byte("complete")})
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		l.Infof("FieldsMap migration complete: %d events", migrated)
+		return nil
+	})
+}
+
+func (l *Log) migrateFieldsItem(ctx context.Context, item map[string]*dynamodb.AttributeValue) error {
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return trace.BadParameter("event %v/%v has invalid legacy Fields", item[keySessionID], item[keyEventIndex])
+	}
+	fields, err := jsonFieldsMap([]byte(*legacy.S))
+	if err != nil {
+		return trace.WrapWithMessage(err, "event %v/%v has invalid Fields", item[keySessionID], item[keyEventIndex])
+	}
+	// Verify the map can be reconstructed as equivalent JSON before removing Fields.
+	check := map[string]*dynamodb.AttributeValue{keyFieldsMap: {M: fields}}
+	if err := restoreFields(check); err != nil {
+		return trace.Wrap(err)
+	}
+	var original, converted interface{}
+	before := json.NewDecoder(bytes.NewReader([]byte(*legacy.S)))
+	before.UseNumber()
+	if err := before.Decode(&original); err != nil {
+		return trace.Wrap(err)
+	}
+	after := json.NewDecoder(bytes.NewReader([]byte(*check["Fields"].S)))
+	after.UseNumber()
+	if err := after.Decode(&converted); err != nil {
+		return trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(original, converted) {
+		return trace.BadParameter("event %v/%v failed FieldsMap validation", item[keySessionID], item[keyEventIndex])
+	}
+	_, err = l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+		TableName:                 aws.String(l.Tablename),
+		Key:                       map[string]*dynamodb.AttributeValue{keySessionID: item[keySessionID], keyEventIndex: item[keyEventIndex]},
+		UpdateExpression:          aws.String("SET #map = :map REMOVE #fields"),
+		ConditionExpression:       aws.String("#fields = :old AND attribute_not_exists(#map)"),
+		ExpressionAttributeNames:  map[string]*string{"#fields": aws.String("Fields"), "#map": aws.String(keyFieldsMap)},
+		ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{":map": {M: fields}, ":old": legacy},
+	})
+	if err != nil && trace.IsAlreadyExists(convertError(err)) {
+		return nil
+	}
+	return trace.Wrap(convertError(err))
+}
