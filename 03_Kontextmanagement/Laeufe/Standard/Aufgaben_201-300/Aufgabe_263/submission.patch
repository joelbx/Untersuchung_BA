+func (s *DynamoeventsSuite) TestFieldsMapMigration(c *check.C) {
+	ctx := context.Background()
+	legacy := preRFD24event{
+		SessionID:      uuid.New(),
+		EventIndex:     1,
+		EventType:      "test.event",
+		CreatedAt:      time.Now().Unix(),
+		Fields:         `{"user":"alice","nested":{"count":42}}`,
+		EventNamespace: apidefaults.Namespace,
+	}
+	c.Assert(s.log.emitTestAuditEventPreRFD24(ctx, legacy), check.IsNil)
+	// The background migrator may already have completed before this test writes.
+	if err := s.log.backend.Delete(ctx, s.log.fieldsFlagKey()); err != nil && !trace.IsNotFound(err) {
+		c.Fatal(err)
+	}
+	c.Assert(s.log.migrateFields(ctx), check.IsNil)
+	out, err := s.log.svc.GetItem(&dynamodb.GetItemInput{
+		TableName: aws.String(s.log.Tablename),
