diff --git a/openlibrary/tests/core/test_bestbook.py b/openlibrary/tests/core/test_bestbook.py
new file mode 100644
index 0000000..5f5922e
--- /dev/null
+++ b/openlibrary/tests/core/test_bestbook.py
@@ -0,0 +1,100 @@
+import json
+
+import pytest
+import web
+
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.core.bookshelves import Bookshelves
+from openlibrary.plugins.openlibrary import api
+
+
+@pytest.fixture
+def awards_db(monkeypatch):
+    database = web.database(dbn="sqlite", db=":memory:")
+    monkeypatch.setattr("openlibrary.core.db.get_db", lambda: database)
+    database.query("""
+        CREATE TABLE bestbook_awards (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            username TEXT NOT NULL,
+            work_id INTEGER NOT NULL,
+            topic TEXT NOT NULL,
+            comment TEXT NOT NULL DEFAULT '',
+            edition_id INTEGER,
+            UNIQUE (username, work_id),
+            UNIQUE (username, topic)
+        )
+    """)
+    monkeypatch.setattr(Bookshelves, "user_has_read_work", lambda user, work: True)
+    return database
+
+
+def test_awards_constraints_and_counts(awards_db, monkeypatch):
+    assert Bestbook.add("alice", "1", "fiction", comment="Favorite")
+    assert Bestbook.get_count(work_id=1) == 1
+    assert Bestbook.get_count(username="alice", topic="fiction") == 1
+    assert Bestbook.get_awards(work_id=1)[0].comment == "Favorite"
+
+    with pytest.raises(Bestbook.AwardConditionsError):
+        Bestbook.add("alice", "1", "poetry")
+    with pytest.raises(Bestbook.AwardConditionsError):
+        Bestbook.add("alice", "2", "fiction")
+
+    award = Bestbook.update("alice", "1", "poetry", comment="Updated")
+    assert award.topic == "poetry"
+    assert award.comment == "Updated"
+    assert Bestbook.get_count(topic="fiction") == 0
+
+    monkeypatch.setattr(Bookshelves, "user_has_read_work", lambda user, work: False)
+    with pytest.raises(Bestbook.AwardConditionsError, match="Only books which have been marked as read"):
+        Bestbook.add("bob", "1", "fiction")
+    with pytest.raises(Bestbook.AwardConditionsError, match="Only books which have been marked as read"):
+        Bestbook.update("alice", "1", "fiction")
+    assert Bestbook.remove("alice", work_id="1") == 1
+    assert Bestbook.get_count() == 0
+
+
+def test_award_redirect_and_anonymization(awards_db):
+    Bestbook.add("alice", "1", "fiction")
+    Bestbook.add("bob", "2", "poetry")
+    Bestbook.add("alice", "3", "history")
+    Bestbook.add("bob", "1", "fiction")
+
+    changes = Bestbook.update_work_id(1, 2)
+    assert changes["rows_changed"] == 1
+    assert changes["rows_deleted"] == 1
+    assert Bestbook.get_count(work_id=2) == 2
+    assert Bestbook.update_username("alice", "anonymous") == 2
+    assert Bestbook.get_count(username="anonymous") == 2
+    assert Bestbook.get_leaderboard()[0].work_id == 2
+
+
+def test_awards_api(awards_db, monkeypatch):
+    class User:
+        key = '/people/alice'
+
+    user = None
+    data = {'op': 'add', 'topic': 'fiction', 'comment': 'Favorite'}
+    monkeypatch.setattr(api.accounts, 'get_current_user', lambda: user)
+    monkeypatch.setattr(api.web, 'input', lambda **defaults: web.storage({**defaults, **data}))
+    monkeypatch.setattr(api.web, 'data', lambda: b'')
+
+    award_api = api.bestbook_award()
+    assert json.loads(award_api.POST('1').rawtext) == {'errors': 'Authentication failed'}
+
+    user = User()
+    added = json.loads(award_api.POST('1').rawtext)
+    assert added['success'] is True
+    assert added['award']['topic'] == 'fiction'
+
+    data['op'] = 'update'
+    data['topic'] = 'poetry'
+    updated = json.loads(award_api.POST('1').rawtext)
+    assert updated['award']['topic'] == 'poetry'
+
+    data.clear()
+    data['work_id'] = '1'
+    assert json.loads(api.bestbook_count().GET().rawtext) == {'count': 1}
+
+    data.clear()
+    data['op'] = 'remove'
+    assert json.loads(award_api.POST('1').rawtext) == {'success': True, 'rows': 1}
