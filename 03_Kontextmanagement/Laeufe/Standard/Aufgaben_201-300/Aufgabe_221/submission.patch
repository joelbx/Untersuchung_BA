+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = 'json'
+
+    def POST(self, work_id):
+        def response(value):
+            return delegate.RawText(
+                json.dumps(value, default=str), content_type='application/json'
+            )
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        data = dict(web.input(op=None, topic=None, comment='', edition_key=None))
+        if web.data() and web.ctx.env.get('CONTENT_TYPE', '').startswith('application/json'):
+            try:
+                data.update(json.loads(web.data()))
+            except (ValueError, TypeError):
+                return response({'errors': 'Invalid JSON'})
+
+        username = user.key.split('/')[2]
+        op = data.get('op')
+        if op not in ('add', 'update', 'remove'):
+            return response({'errors': 'Invalid operation'})
+
+        try:
+            if op == 'remove':
+                return response({'success': True, 'rows': Bestbook.remove(username, work_id)})
+
+            edition_key = data.get('edition_key')
+            edition_id = (
+                int(extract_numeric_id_from_olid(edition_key)) if edition_key else None
+            )
+            if op == 'add':
+                Bestbook.add(
+                    username, work_id, data.get('topic'),
+                    comment=data.get('comment') or '', edition_id=edition_id,
+                )
+            else:
+                Bestbook.update(
+                    username, work_id, data.get('topic'),
+                    comment=data.get('comment') or '', edition_id=edition_id,
+                )
+            award = Bestbook.get_awards(username=username, work_id=work_id)[0]
+            return response({'success': True, 'award': dict(award)})
+        except (Bestbook.AwardConditionsError, ValueError, TypeError) as exc:
+            return response({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = '/awards/count'
+    encoding = 'json'
+
+    def GET(self):
+        data = web.input(work_id=None, username=None, topic=None)
+        try:
+            count = Bestbook.get_count(
+                work_id=data.work_id, username=data.username, topic=data.topic
+            )
+        except (ValueError, TypeError) as exc:
+            return delegate.RawText(
+                json.dumps({'errors': str(exc)}), content_type='application/json'
+            )
+        return delegate.RawText(
+            json.dumps({'count': count}), content_type='application/json'
+        )
+
+
