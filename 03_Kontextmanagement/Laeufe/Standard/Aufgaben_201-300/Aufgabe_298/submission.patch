+}
+
+func (c *simpleCache[K, V]) Values() []V {
+	c.evictExpired()
+	items := c.activeItems()
+	values := make([]V, 0, len(items))
+	for _, item := range items {
+		values = append(values, item.Value())
+	}
+	return values
+}
+
+func (c *simpleCache[K, V]) activeItems() map[K]*ttlcache.Item[K, V] {
+	// ttlcache.Items updates its LRU list while holding a read lock, so
