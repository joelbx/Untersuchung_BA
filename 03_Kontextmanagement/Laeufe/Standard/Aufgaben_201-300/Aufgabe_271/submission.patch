+def test_get_ia_record_handles_multiple_places_and_isbn_lengths() -> None:
+    metadata = {
+        'publisher': 'London ; New York ; Paris : Berlitz Publishing',
+        'isbn': [' 1234567890 ', ' 9781234567890 ', 'too short'],
+    }
+    record = code.ia_importapi.get_ia_record(metadata)
+    assert record['publishers'] == ['Berlitz Publishing']
+    assert record['publish_places'] == ['London', 'New York', 'Paris']
+    assert record['isbn_10'] == ['1234567890']
+    assert record['isbn_13'] == ['9781234567890']
+
+
+def test_get_ia_record_preserves_plain_publisher_names() -> None:
+    metadata = {'publisher': ['Publisher One', 'Paris : Publisher Two', 'Publisher Three']}
+    record = code.ia_importapi.get_ia_record(metadata)
+    assert record['publishers'] == ['Publisher One', 'Publisher Two', 'Publisher Three']
+    assert record['publish_places'] == ['Paris']
