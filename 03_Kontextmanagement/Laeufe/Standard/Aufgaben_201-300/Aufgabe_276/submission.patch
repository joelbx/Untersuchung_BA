+func TestLoadOAuthRequiredFields(t *testing.T) {
+	tests := []struct {
+		name     string
+		method   string
+		provider string
+		field    string
+	}{
+		{"github client ID", "github", "github", "client_id"},
+		{"github client secret", "github", "github", "client_secret"},
+		{"github redirect address", "github", "github", "redirect_address"},
+		{"OIDC client ID", "oidc", "foo", "client_id"},
+		{"OIDC client secret", "oidc", "foo", "client_secret"},
+		{"OIDC redirect address", "oidc", "foo", "redirect_address"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			values := map[string]string{
+				"client_id":        "client-id",
+				"client_secret":    "client-secret",
+				"redirect_address": "http://localhost/callback",
+			}
+			method := "github:\n      enabled: true\n"
+			indent := "      "
+			if tt.method == "oidc" {
+				method = fmt.Sprintf("oidc:\n      enabled: true\n      providers:\n        bar:\n          client_id: %q\n          client_secret: %q\n          redirect_address: %q\n        %s:\n",
+					values["client_id"], values["client_secret"], values["redirect_address"], tt.provider)
+				indent = "          "
+			}
+			for _, field := range []string{"client_id", "client_secret", "redirect_address"} {
+				if field != tt.field {
+					method += fmt.Sprintf("%s%s: %q\n", indent, field, values[field])
+				}
+			}
+
+			path := fmt.Sprintf("%s/config.yml", t.TempDir())
+			config := fmt.Sprintf("authentication:\n  session:\n    domain: localhost\n  methods:\n    %s\n", method)
+			require.NoError(t, os.WriteFile(path, []byte(config), 0600))
+
+			result, err := Load(path)
+			require.Nil(t, result)
+			require.EqualError(t, err, fmt.Sprintf("provider %q: field %q: non-empty value is required", tt.provider, tt.field))
+		})
+	}
+}
