+    def test_play_name_comes_from_hosts_without_mutating_input(self):
+        play_data = dict(hosts=['foo', 'bar'])
+        p = Play.load(play_data)
+        self.assertNotIn('name', play_data)
+        self.assertEqual(p.get_name(), 'foo,bar')
+        p.hosts = ['baz']
+        self.assertEqual(p.get_name(), 'baz')
+        p.name = 'explicit name'
+        self.assertEqual(p.get_name(), 'explicit name')
+
+    def test_play_name_from_other_host_values(self):
+        p = Play()
+        self.assertEqual(p.get_name(), '')
+        p.hosts = 'localhost'
+        self.assertEqual(p.get_name(), 'localhost')
+        p.hosts = None
+        self.assertEqual(p.get_name(), '')
+        p.hosts = {'group': 'localhost'}
+        self.assertEqual(p.get_name(), {'group': 'localhost'})
+
+    def test_invalid_hosts(self):
+        invalid_hosts = (
+            (None, "Hosts list cannot be empty. Please check your playbook"),
+            ([], "Hosts list cannot be empty. Please check your playbook"),
