+            ([None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['foo', None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['foo', {'bad': 'host'}], "Hosts list contains an invalid host value: '{'bad': 'host'}'"),
+            ({'bad': 'host'}, "Hosts list must be a sequence or string. Please check your playbook."),
+            (42, "Hosts list must be a sequence or string. Please check your playbook."),
+        )
+        for hosts, message in invalid_hosts:
+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load(dict(hosts=hosts))
+            self.assertIn(message, str(error.exception))
+
+    def test_hosts_sequence_and_binary_values(self):
