+
+
+@pytest.mark.parametrize('first_line,expected', [
+    (b'#!/usr/bin/python3.8 -I', '#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -B', '#!/opt/venv/bin/python -B'),
+    (b'#!/usr/bin/ruby  -w', '#!/usr/bin/ruby  -w'),
+])
+def test_existing_shebang_preserved(tmp_path, templar, first_line, expected):
+    module = tmp_path / 'module'
+    module.write_bytes(first_line + b'\nprint(1)\n')
+
+    data, style, shebang = modify_module('module', str(module), {}, templar)
+
+    assert shebang == expected
+    assert data.startswith(first_line + b'\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_existing_shebang_override(tmp_path, templar):
+    module = tmp_path / 'module'
+    module.write_bytes(b'#!/usr/bin/python3.8 -I\nprint(1)\n')
+
+    data, style, shebang = modify_module('module', str(module), {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/opt/venv/bin/python'})
+
+    assert shebang == '#!/opt/venv/bin/python -I'
+    assert data.startswith(b'#!/opt/venv/bin/python -I\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_non_python_shebang_override(tmp_path, templar):
+    module = tmp_path / 'module'
+    module.write_bytes(b'#!/usr/bin/ruby -w\nputs 1\n')
+
+    data, style, shebang = modify_module('module', str(module), {}, templar,
+                                         task_vars={'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'})
+
+    assert shebang == '#!/opt/ruby/bin/ruby -w'
+    assert data.startswith(b'#!/opt/ruby/bin/ruby -w\n' + b_ENCODING_STRING + b'\n')
+
+
+@pytest.mark.parametrize('first_line,expected', [
+    (b'#!/usr/bin/python3.8 -I', b'#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -B', b'#!/opt/venv/bin/python -B'),
+    (b'', b'#!/usr/bin/python'),
+])
+def test_new_style_python_shebang(tmp_path, templar, first_line, expected):
+    module = tmp_path / 'module.py'
+    module.write_bytes(first_line + b'\nfrom ansible.module_utils.basic import AnsibleModule\n')
+
+    data, style, shebang = modify_module('module', str(module), {}, templar)
+
+    assert style == 'new'
+    assert shebang == expected.decode('ascii')
+    assert data.startswith(expected + b'\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_new_style_python_override(tmp_path, templar):
+    module = tmp_path / 'module.py'
+    module.write_bytes(b'#!/usr/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n')
+
+    data, style, shebang = modify_module('module', str(module), {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/opt/venv/bin/python'})
+
+    assert style == 'new'
+    assert shebang == '#!/opt/venv/bin/python -I'
+    assert data.startswith(b'#!/opt/venv/bin/python -I\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_new_style_python_config_override(tmp_path, templar, mocker):
+    module = tmp_path / 'module.py'
+    module.write_bytes(b'#!/usr/bin/python3.8\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    original = module_common.C.config.get_config_value_and_origin
+
+    def configured_interpreter(key, **kwargs):
+        if key == 'INTERPRETER_PYTHON':
+            return '/opt/venv/bin/python', '/tmp/ansible.cfg'
+        return original(key, **kwargs)
+
+    mocker.patch.object(module_common.C.config, 'get_config_value_and_origin', side_effect=configured_interpreter)
+
+    data, style, shebang = modify_module('module', str(module), {}, templar)
+
+    assert shebang == '#!/opt/venv/bin/python'
+    assert data.startswith(b'#!/opt/venv/bin/python\n' + b_ENCODING_STRING + b'\n')
