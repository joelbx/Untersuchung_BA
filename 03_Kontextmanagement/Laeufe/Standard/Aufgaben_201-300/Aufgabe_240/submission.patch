+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+
+import json
+
+from ansible.modules.storage.netapp.netapp_e_drive_firmware import NetAppESeriesDriveFirmware
+from units.compat import mock
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+
+
+class DriveFirmwareTest(ModuleTestCase):
+    PARAMS = dict(api_url='http://localhost/devmgr/v2', api_username='admin', api_password='secret',
+                  ssid='array1', firmware=['/tmp/new.dlp'])
+    COMPAT = [{'filename': 'new.dlp', 'firmwareVersion': 'NEW', 'onlineUpgradeCapable': True,
+               'driveRefList': ['drive1', 'drive2']}]
+
+    def make_module(self, **params):
+        args = self.PARAMS.copy()
+        args.update(params)
+        set_module_args(args)
+        return NetAppESeriesDriveFirmware()
+
+    @staticmethod
+    def response(url, **kwargs):
+        if url.endswith('/firmware/drives'):
+            return 200, DriveFirmwareTest.COMPAT
+        if url.endswith('/drives/drive1'):
+            return 200, dict(driveRef='drive1', firmwareVersion='OLD', status='optimal', available=True)
+        if url.endswith('/drives/drive2'):
+            return 200, dict(driveRef='drive2', firmwareVersion='NEW', status='optimal', available=True)
+        raise AssertionError(url)
+
+    def test_selects_only_outdated_compatible_drives(self):
+        firmware = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', side_effect=self.response):
+            self.assertEqual(firmware.upgrade_list(), [{'filename': 'new.dlp', 'driveRefList': ['drive1']}])
+            self.assertEqual(firmware.upgrade_list(), [{'filename': 'new.dlp', 'driveRefList': ['drive1']}])
+
+    def test_check_mode_does_not_upload_or_upgrade(self):
+        firmware = self.make_module(_ansible_check_mode=True)
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', side_effect=self.response) as req:
+            with self.assertRaises(AnsibleExitJson) as result:
+                firmware.apply()
+        self.assertTrue(result.exception.args[0]['changed'])
+        self.assertFalse(result.exception.args[0]['upgrade_in_process'])
+        self.assertTrue(all(call[0][0].endswith(('/firmware/drives', '/drives/drive1', '/drives/drive2'))
+                            for call in req.call_args_list))
+
+    def test_upgrade_posts_online_flag_and_marks_progress(self):
+        firmware = self.make_module(upgrade_drives_online=False)
+        firmware.upgrade_candidates = [{'filename': 'new.dlp', 'driveRefList': ['drive1']}]
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', return_value=(202, None)) as req:
+            firmware.upgrade()
+        self.assertTrue(firmware.upgrade_in_progress)
+        self.assertFalse(json.loads(req.call_args[1]['data'])['upgradeDrivesOnline'])
+
+    def test_wait_ignores_unrelated_drives(self):
+        firmware = self.make_module()
+        firmware.upgrade_candidates = [{'filename': 'new.dlp', 'driveRefList': ['drive1']}]
+        firmware.upgrade_in_progress = True
+        states = [{'driveRef': 'drive1', 'status': 'okay'}, {'driveRef': 'other', 'status': 'failed'}]
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', return_value=(200, states)):
+            firmware.wait_for_upgrade_completion()
+        self.assertFalse(firmware.upgrade_in_progress)
+
+    def test_wait_fails_for_targeted_drive(self):
+        firmware = self.make_module()
+        firmware.upgrade_candidates = [{'filename': 'new.dlp', 'driveRefList': ['drive1']}]
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request',
+                        return_value=(200, [{'driveRef': 'drive1', 'status': 'failed'}])):
+            with self.assertRaises(AnsibleFailJson):
+                firmware.wait_for_upgrade_completion()
+
+    def test_upload_failure_identifies_file_and_array(self):
+        firmware = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.create_multipart_formdata',
+                        side_effect=IOError('invalid file')):
+            with self.assertRaises(AnsibleFailJson) as result:
+                firmware.upload_firmware()
+        self.assertIn('Failed to upload drive firmware', result.exception.args[0]['msg'])
+        self.assertIn('/tmp/new.dlp', result.exception.args[0]['msg'])
+        self.assertIn('array1', result.exception.args[0]['msg'])
+
+    def test_unknown_firmware_fails(self):
+        firmware = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request', return_value=(200, [])):
+            with self.assertRaises(AnsibleFailJson) as result:
+                firmware.upgrade_list()
+        self.assertIn('new.dlp', result.exception.args[0]['msg'])
