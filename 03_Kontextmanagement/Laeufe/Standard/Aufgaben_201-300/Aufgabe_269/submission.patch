--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,52 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	base := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-1234", PkgName: "example",
+		Vulnerability: dbtypes.Vulnerability{
+			Title: "title", Description: "description", References: []string{"https://example.com/advisory"},
+			PublishedDate: &published, LastModifiedDate: &modified,
+		},
+	}
+	debian := base
+	debian.VendorSeverity = dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow}
+	debian.CVSS = dbtypes.VendorCVSS{"debian": {V3Score: 3.1, V3Vector: "debian-vector"}}
+	ubuntu := base
+	ubuntu.VendorSeverity = dbtypes.VendorSeverity{"ubuntu": dbtypes.SeverityMedium}
+	ubuntu.CVSS = dbtypes.VendorCVSS{"ubuntu": {V3Score: 5.2, V3Vector: "ubuntu-vector"}, "nvd": {V2Score: 4.0, V2Vector: "nvd-vector"}}
+	result, err := Convert(types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{debian}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{ubuntu}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves[base.VulnerabilityID].CveContents
+	for _, tc := range []struct {
+		source   models.CveContentType
+		severity string
+		v3       float64
+		v2       float64
+	}{
+		{models.TrivyDebian, "LOW", 3.1, 0},
+		{models.TrivyUbuntu, "MEDIUM", 5.2, 0},
+		{models.TrivyNVD, "", 0, 4.0},
+	} {
+		got := contents[tc.source]
+		if len(got) != 1 || got[0].Type != tc.source || got[0].CveID != base.VulnerabilityID || got[0].Cvss3Severity != tc.severity || got[0].Cvss3Score != tc.v3 || got[0].Cvss2Score != tc.v2 || !got[0].Published.Equal(published) || !got[0].LastModified.Equal(modified) || len(got[0].References) != 1 {
+			t.Errorf("%s: unexpected content: %+v", tc.source, got)
+		}
+	}
+}
