+func TestTrivySourceMetadataAggregation(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, CveID: "CVE-2024-1234", Title: "Debian title", Summary: "Debian summary", Cvss2Score: 2.1, Cvss3Severity: "LOW"}},
+		TrivyUbuntu: {{Type: TrivyUbuntu, CveID: "CVE-2024-1234", Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Score: 5.2, Cvss3Severity: "MEDIUM"}},
+	}}
+	if len(v.Titles("en", "ubuntu")) != 2 || len(v.Summaries("en", "ubuntu")) != 2 {
+		t.Fatalf("Trivy source titles or summaries missing")
+	}
+	if got := v.Cvss2Scores(); len(got) != 1 || got[0].Type != TrivyDebian || got[0].Value.Score != 2.1 {
+		t.Fatalf("Trivy CVSS2 missing: %+v", got)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 {
+		t.Fatalf("expected two source severities, got %+v", scores)
+	}
+	for _, score := range scores {
+		switch score.Type {
+		case TrivyDebian:
+			if score.Value.Severity != "LOW" {
+				t.Errorf("Debian severity: %+v", score)
+			}
+		case TrivyUbuntu:
+			if score.Value.Severity != "MEDIUM" || score.Value.Score != 5.2 {
+				t.Errorf("Ubuntu score: %+v", score)
+			}
+		default:
+			t.Errorf("unexpected source: %+v", score)
+		}
+	}
+}
