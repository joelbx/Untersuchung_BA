+	"time"
+)
+
+func TestGetCveContentsByTrivySource(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	contents := getCveContents("CVE-2024-1234", dbtypes.Vulnerability{
+		Title: "title", Description: "summary", References: []string{"https://example.com"},
+		PublishedDate: &published, LastModifiedDate: &modified,
+		VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "ubuntu": dbtypes.SeverityMedium},
+		CVSS:           dbtypes.VendorCVSS{"debian": {V3Score: 3.1, V3Vector: "debian-vector"}, "ubuntu": {V3Score: 5.2, V3Vector: "ubuntu-vector"}},
+	})
+	for _, tc := range []struct {
+		source   models.CveContentType
+		severity string
+		score    float64
+	}{
+		{models.TrivyDebian, "LOW", 3.1}, {models.TrivyUbuntu, "MEDIUM", 5.2},
+	} {
+		got := contents[tc.source]
+		if len(got) != 1 || got[0].Type != tc.source || got[0].CveID != "CVE-2024-1234" || got[0].Cvss3Severity != tc.severity || got[0].Cvss3Score != tc.score || !got[0].Published.Equal(published) || !got[0].LastModified.Equal(modified) || len(got[0].References) != 1 {
+			t.Errorf("%s: unexpected content: %+v", tc.source, got)
+		}
+	}
+}
