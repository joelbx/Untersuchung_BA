+func trivySources(v trivydbTypes.Vulnerability) map[trivydbTypes.SourceID]struct{} {
+	sources := map[trivydbTypes.SourceID]struct{}{}
+	for source := range v.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range v.CVSS {
+		sources[source] = struct{}{}
+	}
+	return sources
+}
+
+func trivyContent(ctype models.CveContentType, cveID string, v trivydbTypes.Vulnerability, refs models.References, published, modified time.Time) models.CveContent {
+	content := models.CveContent{
+		Type: ctype, CveID: cveID, Title: v.Title, Summary: v.Description,
+		References: refs, Published: published, LastModified: modified,
+	}
+	if ctype == models.Trivy {
+		content.Cvss3Severity = v.Severity
+		return content
+	}
+	source := trivydbTypes.SourceID(string(ctype)[len("trivy:"):])
+	if severity, ok := v.VendorSeverity[source]; ok {
+		content.Cvss3Severity = severity.String()
+	}
+	if cvss, ok := v.CVSS[source]; ok {
+		content.Cvss2Score, content.Cvss2Vector = cvss.V2Score, cvss.V2Vector
+		content.Cvss3Score, content.Cvss3Vector = cvss.V3Score, cvss.V3Vector
+	}
+	return content
+}
