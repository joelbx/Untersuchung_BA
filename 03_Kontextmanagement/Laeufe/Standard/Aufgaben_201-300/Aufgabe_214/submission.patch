diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..0d55955
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,134 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan type.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+var techniqueOptions = map[ScanTechnique]string{
+	TCPSYN: "sS", TCPConnect: "sT", TCPACK: "sA", TCPWindow: "sW",
+	TCPMaimon: "sM", TCPNull: "sN", TCPFIN: "sF", TCPXmas: "sX",
+}
+
+func (t ScanTechnique) String() string { return techniqueOptions[t] }
+
+// PortScanConf controls scanning from the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (techniques []ScanTechnique) {
+	for _, input := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for technique, option := range techniqueOptions {
+			if strings.EqualFold(input, option) {
+				found = technique
+				break
+			}
+		}
+		if found == NotSupportTechnique {
+			for _, existing := range techniques {
+				if existing == NotSupportTechnique {
+					found = -1
+					break
+				}
+			}
+		}
+		if found != -1 {
+			techniques = append(techniques, found)
+		}
+	}
+	return techniques
+}
+
+// Validate reports all invalid external scanner settings.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() && !c.IsUseExternalScanner {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan: scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan: scannerBinPath: %w", err))
+	} else if info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan: scannerBinPath must be an executable file"))
+	}
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan: multiple scan techniques are not supported"))
+	}
+	techniques := c.GetScanTechniques()
+	for _, input := range c.ScanTechniques {
+		supported := false
+		for _, option := range techniqueOptions {
+			if strings.EqualFold(input, option) {
+				supported = true
+				break
+			}
+		}
+		if !supported {
+			errs = append(errs, fmt.Errorf("portscan: unsupported scan technique %q", input))
+		}
+	}
+	if !c.HasPrivileged {
+		for _, t := range techniques {
+			if t != TCPConnect && t != NotSupportTechnique {
+				errs = append(errs, fmt.Errorf("portscan: %s requires privileges; only sT is allowed without privileges", t))
+			}
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan: sourcePort must be an integer in [0,65535]"))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan: sourcePort 0 is not usable"))
+		}
+		if len(techniques) == 0 && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan: sourcePort cannot be used with TCP connect scan"))
+		}
+		for _, t := range techniques {
+			if t == TCPConnect {
+				errs = append(errs, fmt.Errorf("portscan: sourcePort cannot be used with TCP connect scan"))
+			}
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan: cannot check scanner capabilities: %w: %s", err, strings.TrimSpace(string(output))))
+		} else {
+			capText := strings.TrimSpace(string(output))
+			if !strings.Contains(capText, "cap_net_raw") || !strings.Contains(capText, "cap_net_admin") || !regexp.MustCompile(`[=+][eip]+$`).MatchString(capText) {
+				errs = append(errs, fmt.Errorf("portscan: missing or malformed scanner capabilities: %q", capText))
+			}
+		}
+	}
+	return errs
+}
