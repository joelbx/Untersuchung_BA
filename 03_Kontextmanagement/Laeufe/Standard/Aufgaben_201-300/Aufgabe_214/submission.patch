+++ b/scanner/portscan_test.go
@@ -0,0 +1,27 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "fake-nmap")
+	script := `#!/bin/sh
+printf '%s' '<?xml version="1.0"?><nmaprun><host><address addr="127.0.0.1" addrtype="ipv4"/><ports><port protocol="tcp" portid="80"><state state="open"/></port><port protocol="tcp" portid="81"><state state="closed"/></port></ports></host></nmaprun>'
+`
+	if err := os.WriteFile(path, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{Port: "local", Host: "127.0.0.1", PortScan: &config.PortScanConf{ScannerBinPath: path, IsUseExternalScanner: true, ScanTechniques: []string{"sT"}}}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {"80", "81"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0] != "127.0.0.1:80" {
+		t.Fatalf("open ports: %v", got)
+	}
+}
