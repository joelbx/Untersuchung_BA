new file mode 100644
index 0000000..b76f6de
--- /dev/null
+++ b/config/portscan_test.go
@@ -0,0 +1,79 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniquesAndValidation(t *testing.T) {
+	expected := map[string]ScanTechnique{"sS": TCPSYN, "sT": TCPConnect, "sA": TCPACK, "sW": TCPWindow, "sM": TCPMaimon, "sN": TCPNull, "sF": TCPFIN, "sX": TCPXmas}
+	for input, technique := range expected {
+		c := PortScanConf{ScanTechniques: []string{strings.ToUpper(input)}}
+		got := c.GetScanTechniques()
+		if len(got) != 1 || got[0] != technique || technique.String() != input {
+			t.Errorf("%s: got %v", input, got)
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty: %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad", "unknown"}}).GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Errorf("unsupported: %v", got)
+	}
+	if !(&PortScanConf{}).IsZero() || (&PortScanConf{SourcePort: "443"}).IsZero() || (&PortScanConf{HasPrivileged: true}).IsZero() {
+		t.Fatal("IsZero mismatch")
+	}
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name      string
+		conf      PortScanConf
+		wantError bool
+	}{
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, false},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, true},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"bad"}}, true},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sT"}}, true},
+		{"privileges", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, true},
+		{"source connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, true},
+		{"source zero", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, true},
+		{"source range", PortScanConf{ScannerBinPath: path, SourcePort: "65536"}, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := len(tc.conf.Validate()) > 0; got != tc.wantError {
+				t.Errorf("errors: %v", tc.conf.Validate())
+			}
+		})
+	}
+}
+
+func TestPortScanTOMLLoad(t *testing.T) {
+	old := Conf
+	defer func() { Conf = old }()
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	body := `[servers.example]
+host = "127.0.0.1"
+port = "local"
+[servers.example.portscan]
+scannerBinPath = "/usr/bin/nmap"
+hasPrivileged = false
+scanTechniques = ["sT"]
+sourcePort = ""
+`
+	if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	c := Conf.Servers["example"].PortScan
+	if c == nil || !c.IsUseExternalScanner || c.ScannerBinPath != "/usr/bin/nmap" || len(c.GetScanTechniques()) != 1 || c.GetScanTechniques()[0] != TCPConnect {
+		t.Fatalf("portscan not loaded: %+v", c)
+	}
+}
