diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..7fdce0f
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,111 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(conf *config.PortScanConf) ([]string, error) {
+	options := []string{}
+	for _, t := range conf.GetScanTechniques() {
+		if t == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+t.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+type nmapRun struct {
+	Hosts []struct {
+		Addresses []struct {
+			Addr string `xml:"addr,attr"`
+			Type string `xml:"addrtype,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Number   string `xml:"portid,attr"`
+			Protocol string `xml:"protocol,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(destinations map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if errs := conf.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniques, err := setScanTechniques(conf)
+	if err != nil {
+		return nil, err
+	}
+	if len(techniques) == 0 {
+		// The connect scan works for unprivileged users; privileged users default to SYN.
+		if conf.HasPrivileged {
+			techniques = []string{"-sS"}
+		} else {
+			techniques = []string{"-sT"}
+		}
+	}
+	ips := make([]string, 0, len(destinations))
+	for ip := range destinations {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	open := []string{}
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := append([]string(nil), destinations[ip]...)
+		if len(ports) == 0 {
+			continue
+		}
+		sort.Strings(ports)
+		args := append([]string{}, techniques...)
+		if parsed := net.ParseIP(ip); parsed != nil && parsed.To4() == nil {
+			args = append(args, "-6")
+		}
+		args = append(args, "-Pn", "-n", "-oX", "-", "-p", strings.Join(ports, ","))
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, "--", ip)
+		output, err := osexec.Command(conf.ScannerBinPath, args...).Output()
+		if err != nil {
+			return nil, fmt.Errorf("nmap %s: %w", formatNmapOptionsToString(args), err)
+		}
+		var result nmapRun
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("parse nmap output for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			matched := false
+			for _, address := range host.Addresses {
+				if address.Addr == ip {
+					matched = true
+					break
+				}
+			}
+			if !matched {
+				continue
+			}
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.State == "open" {
+					open = append(open, ip+":"+port.Number)
+				}
+			}
+		}
+	}
+	return open, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..5f78a77
