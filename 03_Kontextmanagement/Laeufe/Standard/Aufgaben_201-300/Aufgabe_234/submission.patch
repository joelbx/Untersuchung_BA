+func sqliteDSN(path string) string {
+	name, query, _ := strings.Cut(path, "?")
+	params, err := url.ParseQuery(query)
+	if err != nil {
+		panic(fmt.Errorf("invalid database connection string: %w", err))
+	}
+	params.Set("cache", "shared")
+	params.Set("_cache_size", "1000000000")
+	params.Set("_busy_timeout", "5000")
+	params.Set("_journal_mode", "WAL")
+	params.Set("_synchronous", "NORMAL")
+	params.Set("_foreign_keys", "on")
+	params.Set("_txlock", "immediate")
+	return name + "?" + params.Encode()
+}
+
 func Close() error {
 	log.Info("Closing Database")
 	return Db().Close()
diff --git a/db/db_test.go b/db/db_test.go
index d367984..adc32a3 100644
--- a/db/db_test.go
+++ b/db/db_test.go
@@ -2,6 +2,8 @@ package db
 
 import (
 	"database/sql"
+	"net/url"
+	"strings"
 	"testing"
 
 	"github.com/navidrome/navidrome/log"
@@ -34,3 +36,23 @@ var _ = Describe("isSchemaEmpty", func() {
 		Expect(isSchemaEmpty(db)).To(BeTrue())
 	})
 })
+
+var _ = Describe("sqliteDSN", func() {
+	It("applies the shared connection settings while preserving other options", func() {
+		dsn := sqliteDSN("music.db?cache=private&_busy_timeout=15000&mode=rwc")
+		name, query, found := strings.Cut(dsn, "?")
+		Expect(found).To(BeTrue())
+		Expect(name).To(Equal("music.db"))
+
+		params, err := url.ParseQuery(query)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(params.Get("mode")).To(Equal("rwc"))
+		Expect(params.Get("cache")).To(Equal("shared"))
+		Expect(params.Get("_cache_size")).To(Equal("1000000000"))
+		Expect(params.Get("_busy_timeout")).To(Equal("5000"))
+		Expect(params.Get("_journal_mode")).To(Equal("WAL"))
+		Expect(params.Get("_synchronous")).To(Equal("NORMAL"))
+		Expect(params.Get("_foreign_keys")).To(Equal("on"))
+		Expect(params.Get("_txlock")).To(Equal("immediate"))
+	})
+})
