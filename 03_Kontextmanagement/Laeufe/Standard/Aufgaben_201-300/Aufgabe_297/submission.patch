+// Keep the socket peer before RealIP applies forwarded headers. Proxy trust must
+// never be decided from an address supplied by the client.
+func preserveRemoteAddress(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ctx := context.WithValue(r.Context(), request.RemoteAddress, r.RemoteAddr)
+		next.ServeHTTP(w, r.WithContext(ctx))
+	})
+}
