@@ -0,0 +1,94 @@
+package app
+
+import (
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	list := "bad-cidr, 10.20.0.0/16, 2001:db8::/32, [::1]:1234, @"
+	for _, address := range []string{"10.20.1.2:9876", "[2001:db8::1]:4567", "[::1]:99", "@"} {
+		assert.True(t, validateIPAgainstList(address, list), address)
+	}
+	for _, address := range []string{"10.21.1.2:9876", "[2001:db9::1]:4567", "garbage"} {
+		assert.False(t, validateIPAgainstList(address, list), address)
+	}
+	assert.False(t, validateIPAgainstList("10.20.1.2:9876", ""))
+}
+
+type proxyUserRepo struct {
+	model.UserRepository
+	user        *model.User
+	lastLoginID string
+}
+
+func (p *proxyUserRepo) CountAll(...model.QueryOptions) (int64, error) {
+	if p.user == nil {
+		return 0, nil
+	}
+	return 1, nil
+}
+func (p *proxyUserRepo) FindByUsername(name string) (*model.User, error) {
+	if p.user == nil || p.user.UserName != name {
+		return nil, model.ErrNotFound
+	}
+	return p.user, nil
+}
+func (p *proxyUserRepo) Put(u *model.User) error           { p.user = u; return nil }
+func (p *proxyUserRepo) UpdateLastLoginAt(id string) error { p.lastLoginID = id; return nil }
+
+func TestReverseProxyConfig(t *testing.T) {
+	oldWhitelist, oldHeader, oldDefault := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader, conf.Server.ReverseProxyDefaultUser
+	defer func() {
+		conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader, conf.Server.ReverseProxyDefaultUser = oldWhitelist, oldHeader, oldDefault
+	}()
+	conf.Server.ReverseProxyWhitelist = "10.0.0.0/8, @"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	conf.Server.ReverseProxyDefaultUser = ""
+	repo := &proxyUserRepo{}
+	ds := &tests.MockDataStore{MockedUser: repo}
+	fs := os.DirFS("tests/fixtures")
+	request := func(peer, username string) map[string]interface{} {
+		r := httptest.NewRequest("GET", "/index.html", nil)
+		r.RemoteAddr = peer
+		r.Header.Set("Remote-User", username)
+		w := httptest.NewRecorder()
+		serveIndex(ds, fs)(w, r)
+		return extractAppConfig(w.Body.String())
+	}
+	assert.NotContains(t, request("192.168.1.2:80", "alice"), "auth")
+	assert.Nil(t, repo.user)
+	assert.NotContains(t, request("10.1.2.3:80", ""), "auth")
+	config := request("10.1.2.3:80", "alice")
+	payload := config["auth"].(map[string]interface{})
+	assert.Equal(t, "alice", payload["username"])
+	assert.Equal(t, true, payload["isAdmin"])
+	assert.Equal(t, repo.user.ID, payload["id"])
+	assert.Equal(t, repo.user.ID, repo.lastLoginID)
+	assert.NotEmpty(t, payload["subsonicSalt"])
+	assert.NotEmpty(t, payload["subsonicToken"])
+	assert.NotEmpty(t, payload["token"])
+	assert.WithinDuration(t, time.Now(), *repo.user.LastLoginAt, time.Second)
+	claims, err := auth.Validate(payload["token"].(string))
+	assert.NoError(t, err)
+	assert.Equal(t, "alice", claims["sub"])
+	assert.NotContains(t, request("192.168.1.2:80", "alice"), "auth")
+	assert.Contains(t, request("@", "alice"), "auth")
+	repo.user.Name = "Alice Updated"
+	repo.user.IsAdmin = false
+	current := request("10.1.2.3:80", "alice")["auth"].(map[string]interface{})
+	assert.Equal(t, "Alice Updated", current["name"])
+	assert.Equal(t, false, current["isAdmin"])
+	conf.Server.ReverseProxyDefaultUser = "alice"
+	assert.Contains(t, request("10.1.2.3:80", ""), "auth")
+	conf.Server.ReverseProxyWhitelist = ""
+	assert.NotContains(t, request("@", "alice"), "auth")
+}
