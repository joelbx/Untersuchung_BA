+)
+
+// validateIPAgainstList checks the socket peer against comma-separated CIDRs.
+// A bare address denotes one host; malformed entries are skipped.
+func validateIPAgainstList(address, list string) bool {
+	if strings.TrimSpace(list) == "" {
+		return false
+	}
+	if address == "@" {
+		for _, entry := range strings.Split(list, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(address); err == nil {
+		address = host
+	}
+	ip := net.ParseIP(strings.Trim(address, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(list, ",") {
+		entry = strings.TrimSpace(entry)
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil {
+			if network.Contains(ip) {
+				return true
+			}
+		} else if peer := net.ParseIP(strings.Trim(entry, "[]")); peer != nil && peer.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	address := r.RemoteAddr
+	if peer, ok := r.Context().Value(request.RemoteAddress).(string); ok {
+		address = peer
+	}
+	if !validateIPAgainstList(address, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" || strings.ContainsAny(username, "\r\n,") {
+		return nil
+	}
+
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for proxy login", countErr)
+			return nil
+		}
+		user = &model.User{
+			ID: uuid.NewString(), UserName: username, Name: username,
+			NewPassword: uuid.NewString(), IsAdmin: count == 0,
+		}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Creating proxy user", err)
+			return nil
+		}
+		// Put stores the password but does not necessarily populate the model.
+		user.Password = user.NewPassword
+	} else if err != nil {
+		log.Error(r, "Finding proxy user", err)
+		return nil
+	}
+	if err := repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating proxy user login time", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating proxy login token", err)
+		return nil
+	}
+	salt := strings.ReplaceAll(uuid.NewString(), "-", "")[:6]
+	return map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token,
+		"subsonicSalt":  salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
+}
