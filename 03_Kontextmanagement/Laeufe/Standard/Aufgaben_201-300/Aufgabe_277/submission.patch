diff --git a/internal/server/audit/types_test.go b/internal/server/audit/types_test.go
index 218d657..87b0465 100644
--- a/internal/server/audit/types_test.go
+++ b/internal/server/audit/types_test.go
@@ -1,6 +1,7 @@
 package audit
 
 import (
+	"encoding/json"
 	"testing"
 
 	"github.com/stretchr/testify/assert"
@@ -171,3 +172,55 @@ func TestRule(t *testing.T) {
 		testDistributionHelper(t, d)
 	}
 }
+
+func TestRuleSegments(t *testing.T) {
+	for _, tc := range []struct {
+		name, legacyKey, wantKey, wantOperator string
+		keys                                   []string
+	}{
+		{name: "legacy", legacyKey: "old", wantKey: "old"},
+		{name: "single", legacyKey: "old", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple", keys: []string{"first", "second"}, wantKey: "first,second", wantOperator: "AND_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{SegmentKey: tc.legacyKey, SegmentKeys: tc.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR})
+			assert.Equal(t, tc.wantKey, rule.SegmentKey)
+			assert.Equal(t, tc.wantOperator, rule.SegmentOperator)
+			data, err := json.Marshal(rule)
+			assert.NoError(t, err)
+			assert.Equal(t, tc.wantOperator != "", containsJSONField(data, "segment_operator"))
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	for _, tc := range []struct {
+		name, legacyKey, wantKey, wantOperator string
+		keys                                   []string
+	}{
+		{name: "legacy", legacyKey: "old", wantKey: "old"},
+		{name: "single", legacyKey: "old", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple", keys: []string{"first", "second"}, wantKey: "first,second", wantOperator: "OR_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+				SegmentKey: tc.legacyKey, SegmentKeys: tc.keys, Value: true,
+			}}})
+			assert.Equal(t, tc.wantKey, rollout.Segment.Key)
+			assert.True(t, rollout.Segment.Value)
+			assert.Equal(t, tc.wantOperator, rollout.Segment.Operator)
+			data, err := json.Marshal(rollout.Segment)
+			assert.NoError(t, err)
+			assert.Equal(t, tc.wantOperator != "", containsJSONField(data, "operator"))
+		})
+	}
+}
+
+func containsJSONField(data []byte, field string) bool {
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return false
+	}
+	_, ok := fields[field]
+	return ok
+}
