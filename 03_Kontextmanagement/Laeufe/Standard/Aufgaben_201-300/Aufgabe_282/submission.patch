--- a/qutebrowser/browser/shared.py
+++ b/qutebrowser/browser/shared.py
@@ -159,23 +159,43 @@ _JS_LOGMAP_MESSAGE: Mapping[usertypes.JsLogLevel, Callable[[str], None]] = {
 }
 
 
+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Show a JavaScript message in the UI if enabled and not excluded."""
+    levels_config = config.cache['content.javascript.log_message.levels'] or {}
+    enabled = any(
+        level.name in levels and fnmatch.fnmatchcase(source, pattern)
+        for pattern, levels in levels_config.items()
+    )
+    if not enabled:
+        return False
+
+    excludes = config.cache['content.javascript.log_message.excludes'] or {}
+    for pattern, messages in excludes.items():
+        if fnmatch.fnmatchcase(source, pattern):
+            if any(fnmatch.fnmatchcase(msg, excluded) for excluded in messages):
+                return False
+
+    _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+    return True
+
+
