+@pytest.mark.parametrize('level, source, msg, levels, excludes, shown', [
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP violation',
+     {'userscript:*': ['error']}, {}, True),
+    (usertypes.JsLogLevel.warning, 'userscript:style', 'CSP violation',
+     {'userscript:*': ['error']}, {}, False),
+    (usertypes.JsLogLevel.error, 'website:style', 'CSP violation',
+     {'userscript:*': ['error']}, {}, False),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP violation',
+     {'userscript:*': ['error']}, {'userscript:*': ['*CSP*']}, False),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'Unexpected error',
+     {'userscript:*': ['error']}, {'userscript:*': ['*CSP*']}, True),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP violation',
+     {'userscript:*': ['error']}, {'qute:*': ['*CSP*']}, True),
+    (usertypes.JsLogLevel.error, 'userscript:style', 'CSP violation',
+     {'userscript:*': ['error']},
+     {'userscript:other': ['*'], 'userscript:*': ['*CSP*']}, False),
+    (usertypes.JsLogLevel.info, 'qute:script', 'A message',
+     {'qute:*': ['info']}, {}, True),
+    (usertypes.JsLogLevel.warning, 'qute:script', 'A warning',
+     {'qute:*': ['warning']}, {}, True),
+])
+def test_js_log_to_ui(config_stub, monkeypatch, level, source, msg, levels,
+                      excludes, shown):
+    config_stub.val.content.javascript.log_message.levels = levels
+    config_stub.val.content.javascript.log_message.excludes = excludes
+    displayed = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, level, displayed.append)
+
+    assert shared._js_log_to_ui(level, source, 66, msg) is shown
+    assert displayed == ([f'JS: [{source}:66] {msg}'] if shown else [])
+
+
+def test_javascript_log_message_fallback(config_stub, monkeypatch):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:*': ['*CSP*']}
+    config_stub.val.content.javascript.log = {'unknown': 'debug',
+                                               'info': 'debug',
+                                               'warning': 'debug',
+                                               'error': 'error'}
+    displayed = []
+    logged = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, usertypes.JsLogLevel.error,
+                        displayed.append)
+    monkeypatch.setitem(shared._JS_LOGMAP, 'error', logged.append)
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error, 'userscript:x',
+                                  66, 'CSP violation')
+    shared.javascript_log_message(usertypes.JsLogLevel.error, 'userscript:x',
+                                  67, 'Unexpected error')
+
+    assert logged == ['[userscript:x:66] CSP violation']
+    assert displayed == ['JS: [userscript:x:67] Unexpected error']
