+@pytest.mark.parametrize('ciphers', ['ECDHE-RSA-AES128-SHA256', ['ECDHE-RSA-AES128-SHA256']])
+def test_make_context_ciphers(ciphers):
+    context = urls.make_context(ciphers=ciphers)
+    assert 'ECDHE-RSA-AES128-SHA256' in [item['name'] for item in context.get_ciphers()]
+    assert context.verify_mode == urls.ssl.CERT_REQUIRED
+
+
+@pytest.mark.parametrize('ciphers', [[], '', [1], 42, 'not-a-real-cipher'])
+def test_make_context_rejects_invalid_ciphers(ciphers):
+    with pytest.raises(ValueError, match='cipher') as error:
+        urls.make_context(ciphers=ciphers)
+    if ciphers:
+        assert str(ciphers) not in str(error.value)
+
+
+def test_make_context_without_validation_excludes_old_ssl():
+    context = urls.make_context(ciphers=['ECDHE-RSA-AES128-SHA256'], validate_certs=False)
+    assert context.verify_mode == urls.ssl.CERT_NONE
+    assert context.options & urls.ssl.OP_NO_SSLv3
