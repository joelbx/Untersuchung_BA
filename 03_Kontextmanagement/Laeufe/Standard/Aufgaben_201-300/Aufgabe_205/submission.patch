diff --git a/test/api-utils.js b/test/api-utils.js
new file mode 100644
index 0000000..6a3cf3a
--- /dev/null
+++ b/test/api-utils.js
@@ -0,0 +1,74 @@
+'use strict';
+
+const assert = require('assert');
+const db = require('./mocks/databasemock');
+const api = require('../src/api');
+
+describe('API token utilities', () => {
+	it('manages token metadata, indexes, usage, and deletion', async () => {
+		const { tokens } = api.utils;
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get(undefined), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.generate({ uid: 99999999 }), /\[\[error:no-user\]\]/);
+
+		const before = Date.now();
+		const first = await tokens.generate({ uid: 0, description: 'first' });
+		await new Promise((resolve) => { setTimeout(resolve, 2); });
+		const second = await tokens.generate({ uid: 0 });
+		const after = Date.now();
+		try {
+			const raw = await db.getObject(`token:${first}`);
+			assert.strictEqual(Number(raw.uid), 0);
+			assert.strictEqual(raw.description, 'first');
+			assert(Number.isFinite(Number(raw.timestamp)));
+			assert(Number(raw.timestamp) >= before && Number(raw.timestamp) <= after);
+			assert.strictEqual(await db.sortedSetScore('tokens:createtime', first), Number(raw.timestamp));
+			assert.strictEqual(await db.sortedSetScore('tokens:uid', first), 0);
+
+			const one = await tokens.get(first);
+			assert.strictEqual(one.token, first);
+			assert.strictEqual(one.timestamp, Number(raw.timestamp));
+			assert.strictEqual(one.lastSeen, null);
+			assert.deepStrictEqual(await tokens.get([second, first]), [await tokens.get(second), one]);
+			assert.deepStrictEqual((await tokens.list()).map(item => item.token), [first, second]);
+			assert.deepStrictEqual(await tokens.getLastSeen([second, first]), [null, null]);
+
+			await tokens.log(first);
+			const seen = await tokens.getLastSeen([second, first]);
+			assert.strictEqual(seen[0], null);
+			assert(Number.isFinite(seen[1]) && seen[1] >= before && seen[1] <= Date.now());
+			const updated = await tokens.update(first, { description: 'updated' });
+			assert.strictEqual(updated.description, 'updated');
+			assert.strictEqual(updated.timestamp, one.timestamp);
+			assert.strictEqual(updated.uid, one.uid);
+			assert.strictEqual(updated.lastSeen, seen[1]);
+		} finally {
+			await tokens.delete(first);
+			await tokens.delete(second);
+		}
+		assert.strictEqual(await db.getObject(`token:${first}`), null);
+		const scores = await Promise.all(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen']
+			.map(key => db.sortedSetScore(key, first)));
+		assert.deepStrictEqual(scores, [null, null, null]);
+		assert.deepStrictEqual(await tokens.list(), []);
+	});
+
+	it('accepts an existing nonzero uid', async () => {
+		const uid = 4321000;
+		await db.sortedSetAdd('users:joindate', Date.now(), uid);
+		let token;
+		try {
+			token = await api.utils.tokens.generate({ uid: String(uid), description: 'owned' });
+			assert.strictEqual((await api.utils.tokens.get(token)).uid, uid);
+			assert.strictEqual(await db.sortedSetScore('tokens:uid', token), uid);
+		} finally {
+			if (token) {
+				await api.utils.tokens.delete(token);
+			}
+			await db.sortedSetRemove('users:joindate', uid);
+		}
+	});
+});
