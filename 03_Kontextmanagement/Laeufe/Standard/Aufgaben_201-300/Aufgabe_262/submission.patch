+        ('http://example.com/cover.jpg', 'http://example.com/cover.jpg'),
+        ('https://other.example/cover.jpg', None),
+        ('https://example.com.evil.test/cover.jpg', None),
+        ('ftp://example.com/cover.jpg', None),
+        ('https://[invalid/cover.jpg', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'Test', 'cover': cover}
+    url, updated = process_cover_url(edition, ['Example.Com'])
+    assert url == expected
+    assert updated is edition
+    assert edition == {'title': 'Test'}
+
+
+def test_process_cover_url_missing():
+    edition = {'title': 'Test'}
+    assert process_cover_url(edition, ['example.com']) == (None, edition)
