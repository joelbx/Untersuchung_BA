+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("uses the explicit user ID for reads, writes, defaults, and deletes", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
+		key := "user-scope-test"
+		Expect(repo.Put("user-a", key, "A")).To(Succeed())
+		Expect(repo.Put("user-b", key, "B")).To(Succeed())
+		Expect(repo.Put("user-a", key, "A2")).To(Succeed())
+
+		value, err := repo.Get("user-a", key)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("A2"))
+		value, err = repo.Get("user-b", key)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("B"))
+		value, err = repo.DefaultGet("context-user", key, "missing")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("missing"))
+
+		Expect(repo.Delete("user-a", key)).To(Succeed())
+		_, err = repo.Get("user-a", key)
+		Expect(err).To(Equal(model.ErrNotFound))
+		value, err = repo.Get("user-b", key)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("B"))
+		Expect(repo.Delete("user-b", key)).To(Succeed())
+	})
+})
