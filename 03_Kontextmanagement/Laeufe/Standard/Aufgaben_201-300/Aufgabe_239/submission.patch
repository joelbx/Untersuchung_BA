diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..d4baf48
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,43 @@
+package lastfm
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkStateBelongsToAuthenticatedUser(t *testing.T) {
+	router := NewRouter(&tests.MockDataStore{})
+	req := httptest.NewRequest(http.MethodPost, "/link/start", nil)
+	req = req.WithContext(request.WithUser(context.Background(), model.User{ID: "user-a"}))
+	response := httptest.NewRecorder()
+	router.startLink(response, req)
+	if response.Code != http.StatusOK {
+		t.Fatalf("start link returned %d", response.Code)
+	}
+	var body struct{ State string }
+	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	if body.State == "" {
+		t.Fatal("missing link state")
+	}
+	if got := router.consumeState(body.State); got != "user-a" {
+		t.Fatalf("state belongs to %q", got)
+	}
+	if got := router.consumeState(body.State); got != "" {
+		t.Fatalf("reused state belongs to %q", got)
+	}
+	callback := httptest.NewRequest(http.MethodGet, "/link/callback?uid=user-b&token=token", nil)
+	response = httptest.NewRecorder()
+	router.callback(response, callback)
+	if response.Code != http.StatusBadRequest {
+		t.Fatalf("untrusted uid callback returned %d", response.Code)
+	}
+}
