@@ -0,0 +1,38 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestMockedUserPropsRepoScopesCompositeKeys(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("a_b", "c", "first"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("a", "b_c", "second"); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ userId, key, want string }{
+		{"a_b", "c", "first"},
+		{"a", "b_c", "second"},
+	} {
+		got, err := repo.Get(tc.userId, tc.key)
+		if err != nil || got != tc.want {
+			t.Fatalf("Get(%q, %q) = %q, %v; want %q", tc.userId, tc.key, got, err, tc.want)
+		}
+	}
+	if got, err := repo.DefaultGet("missing", "c", "default"); err != nil || got != "default" {
+		t.Fatalf("DefaultGet = %q, %v", got, err)
+	}
+	if err := repo.Delete("a_b", "c"); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := repo.Get("a", "b_c"); err != nil || got != "second" {
+		t.Fatalf("other user's value = %q, %v", got, err)
+	}
+	if err := repo.Put("", "key", "value"); err != model.ErrInvalidAuth {
+		t.Fatalf("Put with empty user ID = %v", err)
+	}
+}
