diff --git a/qutebrowser/completion/models/filepathcategory.py b/qutebrowser/completion/models/filepathcategory.py
new file mode 100644
index 0000000..6d5adaf
--- /dev/null
+++ b/qutebrowser/completion/models/filepathcategory.py
@@ -0,0 +1,73 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Completion category for local filesystem paths."""
+
+import glob
+import os
+from urllib import parse
+
+from PyQt5.QtCore import QAbstractListModel, QModelIndex, Qt, QObject
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractListModel):
+
+    """Expose matching local paths as an :open completion category."""
+
+    def __init__(self, name: str, parent: QObject = None) -> None:
+        super().__init__(parent)
+        self.name = name
+        self.columns_to_filter = [0]
+        self.delete_func = None
+        self._paths = []
+
+    def set_pattern(self, val: str) -> None:
+        """Update suggestions for a local path or file URL."""
+        paths = []
+        if not val:
+            paths = list(config.val.completion.favorite_paths)
+        else:
+            prefix = ''
+            path = val
+            if val.startswith('file:///'):
+                url = parse.urlsplit(val)
+                if url.netloc or url.query or url.fragment:
+                    path = ''
+                else:
+                    path = parse.unquote(url.path)
+                    prefix = 'file://'
+            elif val.startswith('~'):
+                user = val.split('/', 1)[0]
+                expanded_user = os.path.expanduser(user)
+                if expanded_user == user:
+                    path = ''
+                else:
+                    path = expanded_user + val[len(user):]
+                    if val == user:
+                        path += os.sep
+                    prefix = user
+            elif not os.path.isabs(val):
+                path = ''
+
+            if path and os.path.isabs(path):
+                for match in sorted(glob.glob(glob.escape(path) + '*')):
+                    if val.startswith('~'):
+                        paths.append(prefix + match[len(expanded_user):])
+                    else:
+                        paths.append(prefix + match)
+
+        self.beginResetModel()
+        self._paths = paths
+        self.endResetModel()
+
+    def data(self, index: QModelIndex, role: int = Qt.DisplayRole):
+        """Return a path in the first display column."""
+        if (role == Qt.DisplayRole and index.isValid() and
+                index.column() == 0 and 0 <= index.row() < len(self._paths)):
+            return self._paths[index.row()]
+        return None
+
+    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        """Return the number of available paths."""
+        return 0 if parent.isValid() else len(self._paths)
