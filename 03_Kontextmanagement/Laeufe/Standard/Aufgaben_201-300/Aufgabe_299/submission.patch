+def test_filesystem_category(qtmodeltester, config_stub, quickmarks,
+                             bookmarks, info, tmp_path):
+    """Filesystem stays visible and follows the configured category order."""
+    config_stub.val.completion.open_categories = ['filesystem', 'quickmarks']
+    config_stub.val.completion.favorite_paths = ['/favorite', '~/pages']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    _check_completions(model, {
+        'Filesystem': [('/favorite', None, None), ('~/pages', None, None)],
+        'Quickmarks': [
+            ('https://wiki.archlinux.org', 'aw', None),
+            ('https://wikipedia.org', 'wiki', None),
+            ('https://duckduckgo.com', 'ddg', None),
+        ],
+    })
+    assert [model.data(model.index(row, 0)) for row in range(model.rowCount())] == [
+        'Filesystem', 'Quickmarks']
+
+    config_stub.val.completion.open_categories = ['filesystem']
+    empty_model = urlmodel.url(info=info)
+    empty_model.set_pattern(str(tmp_path / 'missing') + '/')
+    qtmodeltester.check(empty_model)
+    _check_completions(empty_model, {'Filesystem': []})
+
+
+def test_filepath_category(qtmodeltester, config_stub, tmp_path, monkeypatch):
+    """Local path forms produce ordered suggestions; other URLs do not."""
+    root = tmp_path / 'home'
+    root.mkdir()
+    (root / 'alpha.html').touch()
+    (root / 'beta.html').touch()
+    (root / 'pages').mkdir()
+    monkeypatch.setenv('HOME', str(root))
+    category = filepathcategory.FilePathCategory('Filesystem')
+
+    expected = ['alpha.html', 'beta.html', 'pages']
+    for pattern, prefix in [(str(root) + '/', str(root) + '/'),
+                            ('file://' + str(root) + '/',
+                             'file://' + str(root) + '/'),
+                            ('~/', '~/')]:
+        category.set_pattern(pattern)
+        qtmodeltester.check(category)
+        assert [category.data(category.index(row, 0))
+                for row in range(category.rowCount())] == [
+                    prefix + name for name in expected]
+        assert category.data(category.index(0, 1)) is None
+
+    for pattern in ['relative/path', 'https://example.org', 'file://remote/x',
+                    'file:///missing/path/']:
+        category.set_pattern(pattern)
+        qtmodeltester.check(category)
+        assert category.rowCount() == 0
+
+
