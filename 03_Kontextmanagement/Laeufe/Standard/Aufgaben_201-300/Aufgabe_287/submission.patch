+func upAddAlbumImageFiles(tx *sql.Tx) error {
+	if _, err := tx.Exec(`alter table album add image_files text not null default '';`); err != nil {
+		return err
+	}
+	notice(tx, "A full rescan needs to be performed to collect album image files")
+	return forceFullRescan(tx)
+}
+
+func downAddAlbumImageFiles(tx *sql.Tx) error {
+	return nil
+}
