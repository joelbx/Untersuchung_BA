@@ -0,0 +1,24 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("album image files", func() {
+	It("joins every image in each media directory in directory order", func() {
+		dirs := dirMap{
+			"a": {ImageFiles: []string{"cover.jpg", "back.png"}},
+			"b": {ImageFiles: []string{"highres.jpg"}},
+		}
+		want := strings.Join([]string{
+			filepath.Join("a", "cover.jpg"),
+			filepath.Join("a", "back.png"),
+			filepath.Join("b", "highres.jpg"),
+		}, string(filepath.ListSeparator))
+		Expect(imageFiles([]string{"a", "b"}, dirs)).To(Equal(want))
+	})
+})
