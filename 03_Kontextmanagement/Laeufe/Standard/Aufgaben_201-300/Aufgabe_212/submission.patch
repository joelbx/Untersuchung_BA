diff --git a/detector/wordpress_test.go b/detector/wordpress_test.go
index 47ddca1..2819a12 100644
--- a/detector/wordpress_test.go
+++ b/detector/wordpress_test.go
@@ -6,10 +6,94 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	tests := []struct {
+		name     string
+		body     string
+		summary  string
+		optional map[string]string
+		score    float64
+		vector   string
+		severity string
+		fixedIn  string
+	}{
+		{
+			name:     "enterprise",
+			body:     `{"631":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"SQL Injection","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.com/one","https://example.com/two"]},"fixed_in":"6.3.2","description":"A descriptive summary","poc":"https://example.com/poc","introduced_in":"6.0","cvss":{"score":8.1,"vector":"CVSS:3.1/AV:N/AC:L","severity":"high"}}]}}`,
+			summary:  "A descriptive summary",
+			optional: map[string]string{"poc": "https://example.com/poc", "introduced_in": "6.0"},
+			score:    8.1, vector: "CVSS:3.1/AV:N/AC:L", severity: "high", fixedIn: "6.3.2",
+		},
+		{
+			name:     "basic with null fields",
+			body:     `{"631":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"SQL Injection","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.com/one","https://example.com/two"]},"fixed_in":null,"description":null,"poc":null,"introduced_in":null,"cvss":null}]}}`,
+			optional: map[string]string{},
+		},
+		{
+			name:     "basic with omitted fields",
+			body:     `{"631":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"SQL Injection","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.com/one","https://example.com/two"]}}]}}`,
+			optional: map[string]string{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			vinfos, err := convertToVinfos("core", tt.body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d records, want 1", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2024-1234" || v.VulnType != "SQL Injection" {
+				t.Fatalf("unexpected identity or classification: %+v", v)
+			}
+			if len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].Name != "core" || v.WpPackageFixStats[0].FixedIn != tt.fixedIn {
+				t.Fatalf("unexpected fix status: %+v", v.WpPackageFixStats)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("got %d WPScan contents, want 1", len(contents))
+			}
+			c := contents[0]
+			if c.Type != models.WpScan || c.CveID != v.CveID || c.Title != "Example" || c.Summary != tt.summary {
+				t.Fatalf("unexpected content: %+v", c)
+			}
+			links := []string{}
+			for _, ref := range c.References {
+				links = append(links, ref.Link)
+			}
+			if !reflect.DeepEqual(links, []string{"https://example.com/one", "https://example.com/two"}) {
+				t.Errorf("unexpected reference order: %v", links)
+			}
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 9, 5, 6, 0, time.UTC)
+			if !c.Published.Equal(published) || c.Published.Location() != time.UTC || !c.LastModified.Equal(modified) || c.LastModified.Location() != time.UTC {
+				t.Errorf("unexpected timestamps: %v, %v", c.Published, c.LastModified)
+			}
+			if !reflect.DeepEqual(c.Optional, tt.optional) {
+				t.Errorf("optional = %v, want %v", c.Optional, tt.optional)
+			}
+			if c.Cvss3Score != tt.score || c.Cvss3Vector != tt.vector || c.Cvss3Severity != tt.severity {
+				t.Errorf("unexpected CVSS: %+v", c)
+			}
+		})
+	}
+}
+
+func TestConvertToVinfosWithoutCVE(t *testing.T) {
+	body := `{"631":{"vulnerabilities":[{"id":"123","references":{}}]}}`
+	vinfos, err := convertToVinfos("core", body)
+	if err != nil || len(vinfos) != 1 || vinfos[0].CveID != "WPVDBID-123" {
+		t.Fatalf("unexpected WPScan fallback: %v, %v", vinfos, err)
+	}
+}
