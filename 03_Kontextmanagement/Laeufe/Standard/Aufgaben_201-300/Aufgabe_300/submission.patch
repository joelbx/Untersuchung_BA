+        received.append(override_validation)
+        raise RuntimeError('stop after validation')
+
+    monkeypatch.setattr(add_book, 'validate_record', validate)
+    with pytest.raises(RuntimeError, match='stop after validation'):
+        load({'title': 'A book'}, override_validation=True)
+    assert received == [True]
