+func TestAmazonLinuxVersionAndEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		version string
+		eolYear int
+	}{
+		{"2018.03", "1", 2023},
+		{"1", "1", 2023},
+		{"2 (Karoo)", "2", 2024},
+		{"2022 (Amazon Linux)", "2022", 2026},
+		{"2023", "2023", 2028},
+		{"2023 (Amazon Linux)", "2023", 2028},
+		{"2025", "2025", 2030},
+		{"2027", "2027", 2032},
+		{"2029", "2029", 2034},
+		{"2024", "unknown", 0},
+		{"", "unknown", 0},
+		{"garbage", "unknown", 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.version {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.version)
+			}
+			eol, found := GetEOL(Amazon, tt.release)
+			if found != (tt.eolYear != 0) {
+				t.Fatalf("GetEOL(%q) found = %v", tt.release, found)
+			}
+			if !found {
+				return
+			}
+			until := time.Date(tt.eolYear, 6, 30, 23, 59, 59, 0, time.UTC)
+			if !eol.StandardSupportUntil.Equal(until) {
+				t.Errorf("standard support until = %v, want %v", eol.StandardSupportUntil, until)
+			}
+			if eol.IsStandardSupportEnded(until) || eol.IsExtendedSuppportEnded(until) {
+				t.Error("support ended before the EOL boundary")
+			}
+			if !eol.IsStandardSupportEnded(until.Add(time.Second)) || !eol.IsExtendedSuppportEnded(until.Add(time.Second)) {
+				t.Error("support did not end after the EOL boundary")
+			}
+		})
+	}
+}
