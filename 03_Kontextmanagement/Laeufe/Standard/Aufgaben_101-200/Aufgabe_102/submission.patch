+    def get_locally_reachable_ips(self, ip_path):
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, flag in (('ipv4', '-4'), ('ipv6', '-6')):
+            if family == 'ipv6' and not socket.has_ipv6:
+                continue
+
+            args = [ip_path, flag, 'route', 'show', 'table', 'local', 'scope', 'host']
+            rc, output, stderr = self.module.run_command(args, errors='surrogate_then_replace')
+            if rc != 0:
+                self.module.warn('Cannot gather locally reachable %s routes' % family)
+                continue
+
+            networks = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                # IPv6 route output may omit the scope even when the query filters it.
+                if 'scope' in words:
+                    scope_index = words.index('scope')
+                    if words[scope_index + 1:scope_index + 2] != ['host']:
+                        continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if network.version == (4 if family == 'ipv4' else 6):
+                    networks.add(network)
+
+            reachable[family] = [
+                str(network.network_address) if network.num_addresses == 1 else str(network)
+                for network in sorted(networks, key=lambda network: (int(network.network_address), network.prefixlen))
+            ]
+        return reachable
+
