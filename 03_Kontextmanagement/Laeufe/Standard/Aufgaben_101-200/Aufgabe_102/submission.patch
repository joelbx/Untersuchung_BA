diff --git a/test/units/module_utils/facts/network/test_linux.py b/test/units/module_utils/facts/network/test_linux.py
new file mode 100644
index 0000000..eb7baf1
--- /dev/null
+++ b/test/units/module_utils/facts/network/test_linux.py
@@ -0,0 +1,89 @@
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat.mock import Mock
+
+from ansible.module_utils.facts.network import linux
+
+
+def test_locally_reachable_ips(mocker):
+    module = Mock()
+    mocker.patch.object(linux.socket, 'has_ipv6', True)
+    module.run_command.side_effect = [
+        (0, '''local 192.168.1.99/24 dev lo scope host
+local 127.0.0.1 dev lo scope host
+local 192.168.1.0/24 dev lo scope host
+broadcast 192.168.1.255 dev eth0 scope link
+local 192.168.0.1/32 dev lo scope host
+local not-an-address dev lo scope host
+''', ''),
+        (0, '''local 2001:db8::2/128 dev lo proto kernel
+local ::1 dev lo scope host
+local 2001:db8::f/64 dev lo scope host
+local 2001:db8::/64 dev lo scope host
+''', ''),
+    ]
+
+    result = linux.LinuxNetwork(module).get_locally_reachable_ips('/sbin/ip')
+
+    assert result == {
+        'ipv4': ['127.0.0.1', '192.168.0.1', '192.168.1.0/24'],
+        'ipv6': ['::1', '2001:db8::/64', '2001:db8::2'],
+    }
+    assert module.run_command.call_args_list[0][0][0] == [
+        '/sbin/ip', '-4', 'route', 'show', 'table', 'local', 'scope', 'host'
+    ]
+    assert module.run_command.call_args_list[1][0][0] == [
+        '/sbin/ip', '-6', 'route', 'show', 'table', 'local', 'scope', 'host'
+    ]
+
+
+def test_locally_reachable_ips_query_failure(mocker):
+    module = Mock()
+    mocker.patch.object(linux.socket, 'has_ipv6', True)
+    module.run_command.side_effect = [
+        (1, '', 'unsupported'),
+        (0, 'local ::1 dev lo scope host\n', ''),
+    ]
+
+    result = linux.LinuxNetwork(module).get_locally_reachable_ips('/sbin/ip')
+
+    assert result == {'ipv4': [], 'ipv6': ['::1']}
+    module.warn.assert_called_once_with('Cannot gather locally reachable ipv4 routes')
+
+
+def test_locally_reachable_ips_without_ip():
+    module = Mock()
+    module.get_bin_path.return_value = None
+
+    result = linux.LinuxNetwork(module).populate()
+
+    assert result == {'locally_reachable_ips': {'ipv4': [], 'ipv6': []}}
+    module.warn.assert_called_once_with('Cannot gather locally reachable IPs: ip command not found')
+
+
+def test_populate_exposes_locally_reachable_ips(mocker):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/ip'
+    network = linux.LinuxNetwork(module)
+    mocker.patch.object(network, 'get_default_interfaces', return_value=({}, {}))
+    mocker.patch.object(network, 'get_interfaces_info', return_value=(
+        {'lo': {'device': 'lo'}},
+        {'all_ipv4_addresses': [], 'all_ipv6_addresses': []},
+    ))
+    mocker.patch.object(network, 'get_locally_reachable_ips', return_value={
+        'ipv4': ['127.0.0.1'], 'ipv6': ['::1'],
+    })
+
+    result = network.populate()
+
+    assert result['locally_reachable_ips'] == {'ipv4': ['127.0.0.1'], 'ipv6': ['::1']}
+    assert list(result['interfaces']) == ['lo']
+    network.get_locally_reachable_ips.assert_called_once_with('/sbin/ip')
+
+
+def test_collector_registers_locally_reachable_ips():
+    assert 'locally_reachable_ips' in linux.LinuxNetworkCollector().fact_ids
+    assert 'all_ipv4_addresses' in linux.LinuxNetworkCollector().fact_ids
