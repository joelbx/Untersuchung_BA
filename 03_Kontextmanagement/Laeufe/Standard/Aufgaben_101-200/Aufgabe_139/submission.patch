+def supplement_rec_with_import_item_metadata(rec: dict[str, Any], identifier: str) -> None:
+    """Fill empty fields from a staged or pending import item."""
+    from openlibrary.core.imports import ImportItem
+
+    try:
+        items = ImportItem.find_staged_or_pending([identifier])
+        if not items:
+            return
+        staged = items[0]['data']
+        if isinstance(staged, str):
+            staged = json.loads(staged)
+        for field in (
+            'authors', 'isbn_10', 'isbn_13', 'number_of_pages',
+            'physical_format', 'publish_date', 'publishers', 'title',
+        ):
+            if not rec.get(field) and staged.get(field):
+                rec[field] = staged[field]
+    except Exception:
+        logger.exception('Failed to augment import item for %s', identifier)
+
+
