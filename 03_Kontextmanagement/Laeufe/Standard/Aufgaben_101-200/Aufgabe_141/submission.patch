+func TestWpIgnoreInactiveFromTOML(t *testing.T) {
+	file, err := ioutil.TempFile("", "vuls-wp-config-*.toml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(file.Name())
+	if _, err := file.WriteString("wpIgnoreInactive = true\n"); err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	if err := (TOMLLoader{}).Load(file.Name(), ""); err != nil {
+		t.Fatal(err)
+	}
+	if !Conf.WpIgnoreInactive {
+		t.Fatal("wpIgnoreInactive was not loaded from TOML")
+	}
+}
