new file mode 100644
index 0000000..adbf372
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,32 @@
+package wordpress
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactives(t *testing.T) {
+	core := models.WpPackage{Name: models.WPCore, Type: models.WPCore}
+	activePlugin := models.WpPackage{Name: "active-plugin", Type: models.WPPlugin, Status: "active"}
+	inactivePlugin := models.WpPackage{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive}
+	inactiveTheme := models.WpPackage{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive}
+
+	tests := []struct {
+		name  string
+		input models.WordPressPackages
+		want  models.WordPressPackages
+	}{
+		{"mixed", models.WordPressPackages{core, activePlugin, inactivePlugin, inactiveTheme}, models.WordPressPackages{core, activePlugin}},
+		{"all inactive", models.WordPressPackages{inactivePlugin, inactiveTheme}, nil},
+		{"empty", nil, nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := removeInactives(tt.input); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("removeInactives() = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
