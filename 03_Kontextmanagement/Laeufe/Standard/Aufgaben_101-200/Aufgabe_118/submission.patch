+def _have_pip_module():
+    """Whether pip can be imported by this Python interpreter."""
+    try:
+        try:
+            from importlib.util import find_spec
+        except ImportError:
+            # importlib.util is unavailable on older Python versions.
+            import imp
+            file_handle, _, _ = imp.find_module('pip')
+            if file_handle is not None:
+                file_handle.close()
+            return True
+        return find_spec('pip') is not None
+    except Exception:
+        return False
 
 
