+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_uses_current_interpreter(mocker):
+    module = mocker.Mock()
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+
+    assert pip._get_pip(module) == [sys.executable, '-m', 'pip']
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{'name': 'six', '_ansible_check_mode': True}], indirect=['patch_ansible_module'])
+def test_main_uses_pip_module_without_binary(mocker, capfd):
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+    get_bin_path = mocker.patch('ansible.module_utils.basic.AnsibleModule.get_bin_path', return_value=None)
+    run_command = mocker.patch('ansible.module_utils.basic.AnsibleModule.run_command', return_value=(0, 'six==1.0\n', ''))
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    with pytest.raises(SystemExit):
+        pip.main()
+
+    results = json.loads(capfd.readouterr()[0])
+    assert results['cmd'] == '%s -m pip list --format=freeze' % sys.executable
+    assert results['changed'] is False
+    assert run_command.call_args[0][0] == [sys.executable, '-m', 'pip', 'list', '--format=freeze']
+    get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_uses_requested_executable(mocker):
+    module = mocker.Mock()
+    module.get_bin_path.return_value = '/usr/bin/pip-custom'
+
+    assert pip._get_pip(module, executable='pip-custom') == ['/usr/bin/pip-custom']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_packages_falls_back_to_freeze(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(1, '', 'unsupported option'), (0, 'six==1.0\n', '')]
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+    launcher = [sys.executable, '-m', 'pip']
+
+    command, out, err = pip._get_packages(module, launcher, '/tmp')
+
+    assert module.run_command.call_args_list[0][0][0] == launcher + ['list', '--format=freeze']
+    assert module.run_command.call_args_list[1][0][0] == launcher + ['freeze']
+    assert command == '%s -m pip freeze' % sys.executable
+    assert (out, err) == ('six==1.0\n', '')
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_have_pip_module_returns_false_on_detection_error(mocker):
+    mocker.patch('importlib.util.find_spec', side_effect=RuntimeError('unavailable'))
+    assert pip._have_pip_module() is False
+
+
