@@ -0,0 +1,20 @@
+package services
+
+import (
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+func TestApplyValueTraitsNestedValidation(t *testing.T) {
+	_, err := ApplyValueTraits(`{{email.local(internal.unsupported)}}`, map[string][]string{"unsupported": {"a@example.com"}})
+	require.True(t, trace.IsBadParameter(err), "%v", err)
+	require.Contains(t, err.Error(), `unsupported variable "unsupported"`)
+	values, err := ApplyValueTraits(`{{regexp.replace("abc","a","z")}}`, nil)
+	require.NoError(t, err)
+	require.Equal(t, []string{"zbc"}, values)
+	_, err = ApplyValueTraits(`{{regexp.replace(internal.logins,"z","x")}}`, map[string][]string{"logins": {"abc"}})
+	require.True(t, trace.IsNotFound(err), "%v", err)
+	require.Contains(t, err.Error(), "variable interpolation result is empty")
+}
