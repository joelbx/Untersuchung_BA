+func splitTemplate(input string) (string, string, string, bool, error) {
+	trimmed := strings.TrimSpace(input)
+	start := strings.Index(trimmed, "{{")
+	if start >= 0 {
+		quoted, escaped := byte(0), false
+		for i := start + 2; i < len(trimmed)-1; i++ {
+			c := trimmed[i]
+			if quoted != 0 {
+				if escaped {
+					escaped = false
+				} else if c == '\\' {
+					escaped = true
+				} else if c == quoted {
+					quoted = 0
+				}
+				continue
+			}
+			if c == '"' || c == '`' {
+				quoted = c
+				continue
+			}
+			if c == '}' && trimmed[i+1] == '}' {
+				prefix, suffix := trimmed[:start], trimmed[i+2:]
+				if !strings.ContainsAny(prefix+suffix, "{}") {
+					return prefix, strings.TrimSpace(trimmed[start+2 : i]), suffix, true, nil
+				}
+				break
+			}
+			if c == '{' || c == '}' {
+				break
+			}
+		}
