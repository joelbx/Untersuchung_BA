+class TestFactsLinuxHardwareGetSysinfoFacts(unittest.TestCase):
+
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False)
+    def test_absent_sysinfo(self, mock_exists):
+        lh = linux.LinuxHardware(module=Mock())
+        self.assertEqual(lh.get_sysinfo_facts(), {})
+        mock_exists.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM',
+        'Type: 3906',
+        'Sequence Code: 0000123456',
+        'Unrelated: ignored',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_sysinfo_values(self, mock_exists, mock_lines):
+        lh = linux.LinuxHardware(module=Mock())
+        self.assertEqual(lh.get_sysinfo_facts(), {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '123456',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+        mock_lines.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=['Type: 3907'])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_missing_sysinfo_values(self, mock_exists, mock_lines):
+        lh = linux.LinuxHardware(module=Mock())
+        self.assertEqual(lh.get_sysinfo_facts(), {
+            'system_vendor': 'NA',
+            'product_name': '3907',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_best_parsable_locale', return_value='C')
+    def test_populate_uses_sysinfo_identity(self, mock_locale):
+        lh = linux.LinuxHardware(module=Mock())
+        for method in ('get_cpu_facts', 'get_memory_facts', 'get_device_facts',
+                       'get_uptime_facts', 'get_lvm_facts', 'get_mount_facts'):
+            setattr(lh, method, Mock(return_value={}))
+        lh.get_dmi_facts = Mock(return_value={'system_vendor': 'NA', 'product_serial': 'NA'})
+        lh.get_sysinfo_facts = Mock(return_value={'system_vendor': 'IBM', 'product_serial': '123456'})
+
+        facts = lh.populate()
+
+        self.assertEqual(facts['system_vendor'], 'IBM')
+        self.assertEqual(facts['product_serial'], '123456')
+
