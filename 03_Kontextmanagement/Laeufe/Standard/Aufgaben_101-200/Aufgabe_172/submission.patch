+func TestNewPortStat(t *testing.T) {
+	tests := []struct {
+		input string
+		want  PortStat
+		valid bool
+	}{
+		{"", PortStat{}, true},
+		{"127.0.0.1:22", PortStat{BindAddress: "127.0.0.1", Port: "22"}, true},
+		{"*:22", PortStat{BindAddress: "*", Port: "22"}, true},
+		{"[::1]:22", PortStat{BindAddress: "[::1]", Port: "22"}, true},
+		{"missing-port", PortStat{}, false},
+		{"127.0.0.1:", PortStat{}, false},
+		{":22", PortStat{}, false},
+		{"::1:22", PortStat{}, false},
+		{"hostname:22", PortStat{}, false},
+		{"127.0.0.1:service", PortStat{}, false},
+	}
+	for _, tt := range tests {
+		got, err := NewPortStat(tt.input)
+		if (err == nil) != tt.valid {
+			t.Errorf("NewPortStat(%q) error = %v", tt.input, err)
+		} else if tt.valid && (got == nil || !reflect.DeepEqual(*got, tt.want)) {
+			t.Errorf("NewPortStat(%q) = %v, want %v", tt.input, got, tt.want)
+		}
+	}
+}
+
+func TestAffectedProcessLegacyPorts(t *testing.T) {
+	var process AffectedProcess
+	if err := json.Unmarshal([]byte(`{"pid":"7","listenPorts":["127.0.0.1:22","*:80"]}`), &process); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(process.ListenPorts, []string{"127.0.0.1:22", "*:80"}) {
+		t.Fatalf("legacy ports = %v", process.ListenPorts)
+	}
+	if process.ListenPortStats != nil {
+		t.Fatalf("unexpected port stats = %v", process.ListenPortStats)
+	}
+}
+
+func TestHasReachablePort(t *testing.T) {
+	p := Package{AffectedProcs: []AffectedProcess{{ListenPorts: []string{"127.0.0.1:22"}}, {ListenPortStats: []PortStat{{BindAddress: "*", Port: "80"}}}}}
+	if p.HasReachablePort() {
+		t.Fatal("port should not yet be reachable")
+	}
+	p.AffectedProcs[1].ListenPortStats[0].PortReachableTo = []string{"127.0.0.1"}
+	if !p.HasReachablePort() {
+		t.Fatal("expected reachable port")
+	}
+}
