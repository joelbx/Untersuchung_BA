+// NewPortStat parses an address and port into a PortStat.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	address, port, err := net.SplitHostPort(ipPort)
+	if err != nil || address == "" || port == "" {
+		return nil, fmt.Errorf("invalid listening port %q: expected <ip>:<port>", ipPort)
+	}
+	if _, err := strconv.ParseUint(port, 10, 16); err != nil {
+		return nil, fmt.Errorf("invalid listening port %q: %w", ipPort, err)
+	}
+	if strings.HasPrefix(ipPort, "[") {
+		if ip := net.ParseIP(address); ip == nil || ip.To4() != nil {
+			return nil, fmt.Errorf("invalid listening address %q", address)
+		}
+		address = "[" + address + "]"
+	} else if address != "*" && net.ParseIP(address) == nil {
+		return nil, fmt.Errorf("invalid listening address %q", address)
+	}
+	stat.BindAddress, stat.Port = address, port
+	return stat, nil
+}
