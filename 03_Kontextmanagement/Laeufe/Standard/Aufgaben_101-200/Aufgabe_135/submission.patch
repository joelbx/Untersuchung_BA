+@pytest.mark.parametrize('name, expected', [('min', 1), ('max', 3)])
+@pytest.mark.skipif(not ms.HAS_MIN_MAX, reason='Jinja2 does not provide do_min and do_max')
+def test_min_max_attribute(name, expected):
+    values = [{'block_total': 2}, {'block_total': expected}, {'block_total': 3 if name == 'min' else 1}]
+    assert getattr(ms, name)(env, values, attribute='block_total')['block_total'] == expected
+
+
+@pytest.mark.parametrize('name, expected', [('min', 'B'), ('max', 'a')])
+@pytest.mark.skipif(not ms.HAS_MIN_MAX, reason='Jinja2 does not provide do_min and do_max')
+def test_min_max_case_sensitive(name, expected):
+    assert getattr(ms, name)(env, ['a', 'B'], case_sensitive=True) == expected
+
+
+@pytest.mark.parametrize('name', ['min', 'max'])
+def test_min_max_forwards_all_kwargs(name, monkeypatch):
+    received = []
+
+    def jinja_filter(environment, values, **kwargs):
+        received.append((environment, values, kwargs))
+        return 'sentinel'
+
+    monkeypatch.setattr(ms, 'HAS_MIN_MAX', True)
+    monkeypatch.setattr(ms, 'do_' + name, jinja_filter, raising=False)
+    values = [1, 2]
+    assert getattr(ms, name)(env, values, attribute='size', case_sensitive=True, extra='value') == 'sentinel'
+    assert received == [(env, values, {'attribute': 'size', 'case_sensitive': True, 'extra': 'value'})]
+
+
+@pytest.mark.parametrize('name, expected', [('min', 1), ('max', 3)])
+def test_min_max_fallback(name, expected, monkeypatch):
+    monkeypatch.setattr(ms, 'HAS_MIN_MAX', False)
+    filter_func = getattr(ms, name)
+    assert filter_func(env, [3, 1, 2]) == expected
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(env, [3, 1, 2], attribute='size')
+    assert error.value.message == ("Ansible's %s filter does not support any keyword arguments. "
+                                   "You need Jinja2 2.10 or later that provides their version of the filter." % name)
+
+
+@pytest.mark.skipif(not ms.HAS_MIN_MAX, reason='Jinja2 does not provide do_min and do_max')
+def test_min_max_in_template():
+    template_env = Environment()
+    template_env.filters.update(ms.FilterModule().filters())
+    template = template_env.from_string("{{ (mounts | max(attribute='block_total'))['mount'] }}")
+    mounts = [{'mount': '/', 'block_total': 10}, {'mount': '/data', 'block_total': 20}]
+    assert template.render(mounts=mounts) == '/data'
 
 
