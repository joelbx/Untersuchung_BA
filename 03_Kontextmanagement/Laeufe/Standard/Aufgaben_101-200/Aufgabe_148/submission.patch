+// readSSHProxyHello reads the metadata and puts it back for the SSH server,
+// which also uses the payload to retrieve tracing context.
+func readSSHProxyHello(reader *bufio.Reader) (net.Addr, *bufio.Reader, error) {
+	const maxHelloSize = 64 * 1024
+	hello := make([]byte, 0, 256)
+	for len(hello) < maxHelloSize {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err, "failed to read SSH proxy hello")
+		}
+		hello = append(hello, b)
+		if b == 0 {
+			var payload sshutils.HandshakePayload
+			if err := json.Unmarshal(hello[len(sshutils.ProxyHelloSignature):len(hello)-1], &payload); err != nil {
+				return nil, nil, trace.BadParameter("invalid SSH proxy hello: %v", err)
+			}
+			var remoteAddr net.Addr
+			if payload.ClientAddr != "" {
+				addr, err := utils.ParseAddr(payload.ClientAddr)
+				if err != nil {
+					return nil, nil, trace.Wrap(err, "invalid SSH proxy client address")
+				}
+				remoteAddr = addr
+				if addr.AddrNetwork == "tcp" {
+					remoteAddr = &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}
+				}
+			}
+			return remoteAddr, bufio.NewReader(io.MultiReader(bytes.NewReader(hello), reader)), nil
+		}
+	}
+	return nil, nil, trace.BadParameter("SSH proxy hello exceeds maximum size")
+}
