+func TestSSHProxyHello(t *testing.T) {
+	for _, tc := range []struct {
+		name, hello, addr string
+	}{
+		{"client address", "Teleport-Proxy{\"clientAddr\":\"192.0.2.10:1234\",\"tracingContext\":{\"traceparent\":\"value\"}}\x00", "192.0.2.10:1234"},
+		{"no client address", "Teleport-Proxy{\"tracingContext\":{}}\x00", "pipe"},
+		{"standard SSH", "SSH-2.0-client\r\n", "pipe"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, server := net.Pipe()
+			defer client.Close()
+			defer server.Close()
+			go func() {
+				fmt.Fprint(client, tc.hello+"SSH-2.0-rest\r\n")
+			}()
+			conn, err := detect(server, false)
+			require.NoError(t, err)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			require.Equal(t, tc.addr, conn.RemoteAddr().String())
+			got := make([]byte, len(tc.hello))
+			_, err = io.ReadFull(conn, got)
+			require.NoError(t, err)
+			require.Equal(t, tc.hello, string(got))
+		})
+	}
+}
+
+func TestSSHProxyHelloRouting(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener})
+	require.NoError(t, err)
+	sshListener := mux.SSH()
+	go mux.Serve()
+	defer mux.Close()
+
+	client, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer client.Close()
+	_, err = io.WriteString(client, "Teleport-Proxy{\"clientAddr\":\"192.0.2.11:4321\"}\x00SSH-2.0-client\r\n")
+	require.NoError(t, err)
+	sshConn, err := sshListener.Accept()
+	require.NoError(t, err)
+	defer sshConn.Close()
+	require.Equal(t, "192.0.2.11:4321", sshConn.RemoteAddr().String())
+	buf := make([]byte, len("Teleport-Proxy{\"clientAddr\":\"192.0.2.11:4321\"}\x00SSH-2.0-client\r\n"))
+	_, err = io.ReadFull(sshConn, buf)
+	require.NoError(t, err)
+	require.True(t, strings.HasSuffix(string(buf), "SSH-2.0-client\r\n"))
+}
