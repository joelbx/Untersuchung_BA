+func TestGetEOLUbuntuLTS(t *testing.T) {
+	tests := []struct {
+		release       string
+		standardUntil time.Time
+		extendedUntil time.Time
+	}{
+		{"20.04", time.Date(2025, 4, 1, 23, 59, 59, 0, time.UTC), time.Date(2030, 4, 1, 23, 59, 59, 0, time.UTC)},
+		{"22.04", time.Date(2027, 4, 1, 23, 59, 59, 0, time.UTC), time.Date(2032, 4, 1, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Ubuntu, tt.release)
+			if !found {
+				t.Fatal("Ubuntu release not found")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.standardUntil) {
+				t.Errorf("standard support ends %v, want %v", eol.StandardSupportUntil, tt.standardUntil)
+			}
+			if !eol.ExtendedSupportUntil.Equal(tt.extendedUntil) {
+				t.Errorf("extended support ends %v, want %v", eol.ExtendedSupportUntil, tt.extendedUntil)
+			}
+			if eol.IsExtendedSuppportEnded(tt.standardUntil.Add(time.Second)) {
+				t.Error("extended support ended at the standard support boundary")
+			}
+			if !eol.IsExtendedSuppportEnded(tt.extendedUntil.Add(time.Second)) {
+				t.Error("extended support remains active after its end date")
+			}
+		})
+	}
+}
