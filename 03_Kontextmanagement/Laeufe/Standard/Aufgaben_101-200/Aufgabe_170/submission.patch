+def add_db_name(rec: dict) -> None:
+    """Add an author's name and available dates to each author in place."""
+    for author in rec.get('authors') or []:
+        name = author.get('name') or author.get('db_name', '')
+        date = author.get('date')
+        if not date and (author.get('birth_date') or author.get('death_date')):
+            date = f"{author.get('birth_date') or ''}-{author.get('death_date') or ''}"
+        author['db_name'] = f'{name} {date}' if date else name
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare an imported or existing edition."""
+    full_title = rec.get('full_title')
+    if not full_title:
+        full_title = rec.get('title') or ''
+        if rec.get('subtitle'):
+            full_title = f"{full_title} {rec['subtitle']}".strip()
+    expanded = build_titles(full_title)
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        expanded['isbn'].extend([values] if isinstance(values, str) else values)
+    if rec.get('publish_country') not in (None, '   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if rec.get(field) is not None:
+            value = rec[field]
+            expanded[field] = (
+                [dict(a) for a in value]
+                if field in ('authors', 'contribs')
+                else value
+            )
+    add_db_name(expanded)
+    if 'contribs' in expanded:
+        add_db_name({'authors': expanded['contribs']})
+    return expanded
+
+
