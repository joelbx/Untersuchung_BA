diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..7674ebd
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,173 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+
+// Backup takes a consistent online snapshot of the database.
+func (d *db) Backup(ctx context.Context) (path string, err error) {
+	if conf.Server.Backup.Path == "" {
+		return "", fmt.Errorf("backup.path is empty")
+	}
+	if err = os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		return "", err
+	}
+	path = filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format("20060102T150405.000000000Z")+".db")
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	if err = f.Close(); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	defer func() {
+		if err != nil {
+			_ = os.Remove(path)
+			path = ""
+		}
+	}()
+	dest, err := sql.Open(Driver, path)
+	if err != nil {
+		return path, err
+	}
+	defer dest.Close()
+	return path, copyDatabase(ctx, dest, d.writeDB)
+}
+
+// Restore copies a validated backup into the live database. Call only while the
+// server is stopped, so other connections cannot keep stale database state.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return fmt.Errorf("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	if info.Size() < 100 {
+		return fmt.Errorf("invalid backup: file is too small")
+	}
+	if live, statErr := os.Stat(conf.Server.DbPath); statErr == nil && os.SameFile(info, live) {
+		return fmt.Errorf("backup file is the live database")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	header := make([]byte, 16)
+	_, readErr := io.ReadFull(file, header)
+	_ = file.Close()
+	if readErr != nil || string(header) != "SQLite format 3\x00" {
+		return fmt.Errorf("invalid backup: missing SQLite header")
+	}
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	source, err := sql.Open(Driver, (&url.URL{Scheme: "file", Path: abs, RawQuery: "mode=ro"}).String())
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var result string
+	if err := source.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("invalid backup: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("invalid backup: integrity_check returned %s", result)
+	}
+	return copyDatabase(ctx, d.writeDB, source)
+}
+
+func copyDatabase(ctx context.Context, destination, source *sql.DB) error {
+	src, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	dst, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dst.Close()
+	return dst.Raw(func(dstDriver any) error {
+		return src.Raw(func(srcDriver any) error {
+			d, ok := dstDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("destination is not SQLite")
+			}
+			s, ok := srcDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("source is not SQLite")
+			}
+			backup, err := d.Backup("main", s, "main")
+			if err != nil {
+				return err
+			}
+			_, stepErr := backup.Step(-1)
+			finishErr := backup.Finish()
+			if stepErr != nil {
+				return stepErr
+			}
+			return finishErr
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, fmt.Errorf("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, fmt.Errorf("backup.count cannot be negative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var files []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.Type().IsRegular() && strings.HasPrefix(name, backupPrefix) && strings.HasSuffix(name, ".db") && validBackupName(name) {
+			files = append(files, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	count := 0
+	for _, name := range files[min(conf.Server.Backup.Count, len(files)):] {
+		if err := ctx.Err(); err != nil {
+			return count, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return count, err
+		}
+		count++
+	}
+	return count, nil
+}
+
+func validBackupName(name string) bool {
+	timestamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), ".db")
+	_, err := time.Parse("20060102T150405.000000000Z", timestamp)
+	return err == nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
new file mode 100644
index 0000000..22ae1e3
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,66 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	previous := conf.Server.Backup
+	t.Cleanup(func() { conf.Server.Backup = previous })
+	dir := t.TempDir()
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 1
+	conn, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	database := &db{writeDB: conn}
+	ctx := context.Background()
+	if _, err := conn.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(first); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.Exec("UPDATE items SET value = 'changed'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup filenames must be unique")
+	}
+	removed, err := database.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned %d: %v", removed, err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("old backup remains: %v", err)
+	}
+	if _, err := conn.Exec("UPDATE items SET value = 'later'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := database.Restore(ctx, second); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := conn.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "changed" {
+		t.Fatalf("restored value %q: %v", value, err)
+	}
+	if err := database.Restore(ctx, filepath.Join(dir, "missing.db")); err == nil {
+		t.Fatal("missing backup accepted")
+	}
+}
