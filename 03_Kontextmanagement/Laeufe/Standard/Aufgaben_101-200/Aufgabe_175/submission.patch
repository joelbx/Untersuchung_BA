+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	group := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	create := &cobra.Command{Use: "create", Short: "Create a database backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		database := db.Db()
+		defer database.Close()
+		path, err := database.Backup(cmd.Context())
+		if err == nil {
+			fmt.Fprintln(cmd.OutOrStdout(), path)
+		}
+		return err
+	}}
+	prune := &cobra.Command{Use: "prune", Short: "Delete old database backups", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		force, _ := cmd.Flags().GetBool("force")
+		if conf.Server.Backup.Count == 0 && !force && !confirmBackup(cmd, "Delete all backups?") {
+			return fmt.Errorf("backup pruning cancelled")
+		}
+		count, err := db.Db().Prune(cmd.Context())
+		if err == nil {
+			fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backups\n", count)
+		}
+		return err
+	}}
+	prune.Flags().Bool("force", false, "skip confirmation")
+	restore := &cobra.Command{Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		path, _ := cmd.Flags().GetString("backup-file")
+		if path == "" {
+			return fmt.Errorf("--backup-file is required")
+		}
+		force, _ := cmd.Flags().GetBool("force")
+		if !force && !confirmBackup(cmd, "Replace the current database with this backup?") {
+			return fmt.Errorf("database restore cancelled")
+		}
+		database := db.Db()
+		defer database.Close()
+		if err := database.Restore(cmd.Context(), path); err != nil {
+			return err
+		}
+		fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+		return nil
+	}}
+	restore.Flags().String("backup-file", "", "backup database file to restore")
+	restore.Flags().Bool("force", false, "skip confirmation")
+	group.AddCommand(create, prune, restore)
+	rootCmd.AddCommand(group)
+}
+
+func confirmBackup(cmd *cobra.Command, prompt string) bool {
+	fmt.Fprintf(cmd.OutOrStdout(), "%s Type yes to continue: ", prompt)
+	answer, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	return err == nil && strings.TrimSpace(answer) == "yes"
+}
