+def _get_locale_pak_path(locales_dir: Path, locale: str) -> Path:
+    """Return the QtWebEngine resource file for a Chromium locale name."""
+    return Path(locales_dir) / (locale.replace('_', '-') + '.pak')
+
+
+def _get_lang_override(
+        versions: version.WebEngineVersions, locale: str) -> Optional[str]:
+    """Find an installed Chromium locale for the QtWebEngine 5.15.3 workaround."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    locale = locale.replace('_', '-')
+    locales_dir = (Path(QLibraryInfo.location(QLibraryInfo.TranslationsPath)) /
+                   'qtwebengine_locales')
+    if _get_locale_pak_path(locales_dir, locale).is_file():
+        return None
+
+    language = locale.split('-', 1)[0]
+    if language == 'en':
+        mapped = 'en-US' if locale in ('en', 'en-LR', 'en-PH') else 'en-GB'
+    elif language == 'es':
+        mapped = 'es' if locale == 'es-ES' else 'es-419'
+    elif language == 'pt':
+        mapped = 'pt-PT' if locale == 'pt-PT' else 'pt-BR'
+    elif language == 'zh':
+        mapped = 'zh-TW' if locale in ('zh-TW', 'zh-HK', 'zh-MO') else 'zh-CN'
+    else:
+        mapped = language
+
+    for candidate in (mapped, language):
+        if _get_locale_pak_path(locales_dir, candidate).is_file():
+            return candidate
+    return 'en-US'
+
