@@ -0,0 +1,92 @@
+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/package-url/packageurl-go"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		pkgType, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"maven", "guava", "", "guava", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"cargo", "serde", "", "serde", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pkgType+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.pkgType, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)",
+					tt.pkgType, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPackagePURL(t *testing.T) {
+	tests := []struct {
+		scannerType ftypes.LangType
+		input       string
+		wantType    string
+		wantNS      string
+		wantName    string
+		wantSubpath string
+	}{
+		{ftypes.Pom, "com.google.guava:guava", "maven", "com.google.guava", "guava", ""},
+		{ftypes.Pip, "My_Package", "pypi", "", "my-package", ""},
+		{ftypes.GoModule, "github.com/protobom/protobom", "golang", "github.com/protobom", "protobom", ""},
+		{ftypes.Npm, "@babel/core", "npm", "@babel", "core", ""},
+		{ftypes.Cocoapods, "GoogleUtilities/NSData+zlib", "cocoapods", "", "GoogleUtilities", "NSData+zlib"},
+	}
+	for _, tt := range tests {
+		t.Run(string(tt.scannerType), func(t *testing.T) {
+			scanner := models.LibraryScanner{
+				Type:         tt.scannerType,
+				LockfilePath: "lockfile",
+				Libs:         []models.Library{{Name: tt.input, Version: "1.0"}},
+			}
+			got := libpkgToCdxComponents(scanner, map[string]map[string]string{"lockfile": {}})
+			purl, err := packageurl.FromString(got[1].PackageURL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if purl.Type != tt.wantType || purl.Namespace != tt.wantNS || purl.Name != tt.wantName || purl.Subpath != tt.wantSubpath {
+				t.Errorf("PURL fields = (%q, %q, %q, %q), want (%q, %q, %q, %q)",
+					purl.Type, purl.Namespace, purl.Name, purl.Subpath,
+					tt.wantType, tt.wantNS, tt.wantName, tt.wantSubpath)
+			}
+		})
+	}
+}
+
+func TestGitHubManifestPackagePURL(t *testing.T) {
+	manifest := models.DependencyGraphManifest{
+		Filename:   "pom.xml",
+		Repository: "example/repo",
+		Dependencies: []models.Dependency{{
+			PackageName:  "com.google.guava:guava",
+			Requirements: "= 1.0",
+		}},
+	}
+	purls := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+	components := ghpkgToCdxComponents(manifest, purls)
+	purl, err := packageurl.FromString(components[1].PackageURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if purl.Type != "maven" || purl.Namespace != "com.google.guava" || purl.Name != "guava" || purl.Version != "1.0" {
+		t.Errorf("unexpected PURL: %s", components[1].PackageURL)
+	}
+}
