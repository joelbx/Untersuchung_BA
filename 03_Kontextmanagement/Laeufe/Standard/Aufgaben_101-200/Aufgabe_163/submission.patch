+func TestDatabaseConnectionURL(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  DatabaseConfig
+		want string
+		err  string
+	}{
+		{"URL precedence", DatabaseConfig{URL: "file:existing.db", Protocol: DatabasePostgres, Password: "secret"}, "file:existing.db", ""},
+		{"postgres defaults", DatabaseConfig{Protocol: DatabasePostgres, Host: "localhost", User: "alice", Password: "p@ss", Name: "flipt"}, "postgres://alice:p%40ss@localhost:5432/flipt", ""},
+		{"mysql defaults", DatabaseConfig{Protocol: DatabaseMySQL, Host: "localhost", Name: "flipt"}, "mysql://localhost:3306/flipt", ""},
+		{"sqlite path", DatabaseConfig{Protocol: DatabaseSQLite, Path: "/tmp", Name: "flipt.db"}, "file:/tmp/flipt.db", ""},
+		{"missing protocol", DatabaseConfig{Name: "flipt"}, "", "db.protocol"},
+		{"missing name", DatabaseConfig{Protocol: DatabasePostgres, Host: "localhost"}, "", "db.name"},
+		{"missing host", DatabaseConfig{Protocol: DatabasePostgres, Name: "flipt"}, "", "db.host"},
+		{"missing sqlite path", DatabaseConfig{Protocol: DatabaseSQLite, Name: "flipt.db"}, "", "db.path"},
+		{"invalid protocol", DatabaseConfig{Protocol: 99, Name: "flipt", Host: "localhost"}, "", "invalid db.protocol 99"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.ConnectionURL()
+			if tt.err != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadDiscreteDatabase(t *testing.T) {
+	file, err := ioutil.TempFile("", "flipt-config-*.yml")
+	require.NoError(t, err)
+	defer func() { file.Close(); _ = os.Remove(file.Name()) }()
+	_, err = file.WriteString("db:\n  protocol: postgres\n  host: localhost\n  name: flipt\n  user: alice\n  password: secret\n")
+	require.NoError(t, err)
+	cfg, err := Load(file.Name())
+	require.NoError(t, err)
+	assert.Empty(t, cfg.Database.URL)
+	assert.Equal(t, DatabasePostgres, cfg.Database.Protocol)
+	assert.Equal(t, "secret", cfg.Database.Password)
+	target, err := cfg.Database.ConnectionURL()
+	require.NoError(t, err)
+	assert.Equal(t, "postgres://alice:secret@localhost:5432/flipt", target)
+	encoded, err := json.Marshal(cfg)
+	require.NoError(t, err)
+	assert.False(t, strings.Contains(string(encoded), "secret"))
+}
+
