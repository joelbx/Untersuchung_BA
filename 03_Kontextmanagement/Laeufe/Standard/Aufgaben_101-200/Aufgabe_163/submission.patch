+
+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnset DatabaseProtocol = iota
+	DatabaseSQLite
+	DatabasePostgres
+	DatabaseMySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseSQLite:
+		return "sqlite3"
+	case DatabasePostgres:
+		return "postgres"
+	case DatabaseMySQL:
+		return "mysql"
+	default:
+		return ""
+	}
+}
+
+// ConnectionURL returns the selected connection target after validating the
+// discrete settings. A configured URL always takes precedence.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if d.Protocol == DatabaseProtocolUnset {
+		return "", fmt.Errorf("db.protocol is required (sqlite3, postgres, mysql)")
+	}
+	if d.Protocol.String() == "" {
+		return "", fmt.Errorf("invalid db.protocol %d: expected sqlite3, postgres, or mysql", d.Protocol)
+	}
+	if d.Name == "" {
+		return "", fmt.Errorf("db.name is required")
+	}
+	if d.Protocol == DatabaseSQLite {
+		path := d.Path
+		if path == "" {
+			path = d.Host
+		}
+		if path == "" {
+			return "", fmt.Errorf("db.path is required for sqlite3")
+		}
+		return "file:" + filepath.Join(path, d.Name), nil
+	}
+	if d.Host == "" {
+		return "", fmt.Errorf("db.host is required")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return "", fmt.Errorf("db.port must be between 1 and 65535")
+	}
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == DatabasePostgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, strconv.Itoa(port)), Path: "/" + d.Name}
+	if d.Password != "" {
+		u.User = url.UserPassword(d.User, d.Password)
+	} else if d.User != "" {
+		u.User = url.User(d.User)
+	}
+	return u.String(), nil
 }
 
