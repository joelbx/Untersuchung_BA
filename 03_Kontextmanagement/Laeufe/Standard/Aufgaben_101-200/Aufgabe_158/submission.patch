 class TestCaseZipArchive:
+    @pytest.mark.parametrize('timestamp, expected', (
+        ('19800101.000000', (1980, 1, 1, 0, 0, 0)),
+        ('20000229.235959', (2000, 2, 29, 23, 59, 59)),
+        ('21071231.235959', (2107, 12, 31, 23, 59, 59)),
+    ))
+    def test_valid_time_stamp(self, timestamp, expected):
+        assert ZipArchive._valid_time_stamp(timestamp)[:6] == expected
+
+    @pytest.mark.parametrize('timestamp', (
+        '19800000.000000', '19791231.235959', '21080101.000000',
+        '20010229.120000', '20001301.120000', '20000101.246000',
+        '20000101.006060', '20000101.00000', '20000101.000000x',
+    ))
+    def test_invalid_time_stamp_uses_zip_epoch(self, timestamp):
+        assert ZipArchive._valid_time_stamp(timestamp) == (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+
+    def test_is_unarchived_handles_invalid_timestamp(self, mocker, tmp_path):
+        target = tmp_path / 'file.txt'
+        target.write_text('data')
+        module = mocker.Mock()
+        module.params = {
+            'extra_opts': [], 'exclude': [], 'include': [],
+            'io_buffer_size': 65536, 'keep_newer': False,
+        }
+        module.run_command.return_value = (0, '-rw-r--r--  3.0 unx  4 tx defN 19800000.000000 file.txt\n', '')
+        archive = ZipArchive(src='archive.zip', b_dest=bytes(tmp_path), file_args={'owner': None, 'group': None, 'mode': None}, module=module)
+        archive._crc32 = mocker.Mock(return_value=0)
+        archive.zipinfo_cmd_path = 'zipinfo'
+
+        result = archive.is_unarchived()
+
+        assert result['unarchived'] is False
+        assert 'file.txt' in archive.includes
+        assert 'mtime' in result['err']
+
