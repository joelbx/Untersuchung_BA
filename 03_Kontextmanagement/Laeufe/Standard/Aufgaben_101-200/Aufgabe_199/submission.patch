@@ -1,6 +1,8 @@
 from __future__ import print_function
 import os
+from types import SimpleNamespace
 import pytest
+import requests
 from openlibrary.catalog import get_ia
 from openlibrary.core import ia
 from openlibrary.catalog.marc.marc_xml import MarcXml
@@ -18,7 +20,83 @@ def return_test_marc_data(url, test_data_subdir="xml_input"):
     filename = url.split('/')[-1]
     test_data_dir = "/../../catalog/marc/tests/test_data/%s/" % test_data_subdir
     path = os.path.dirname(__file__) + test_data_dir + filename
-    return open(path, mode='rb')
+    with open(path, mode='rb') as source:
+        return SimpleNamespace(content=source.read())
+
+
+def test_urlopen_keep_trying_uses_requests(monkeypatch):
+    response = requests.Response()
+    response.status_code = 200
+    response._content = 'café'.encode('utf-8')
+    response.headers['Content-Type'] = 'text/plain'
+    calls = []
+
+    def get(url, **kwargs):
+        calls.append((url, kwargs))
+        return response
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    assert get_ia.urlopen_keep_trying('https://example.org', headers={'X-Test': 'yes'}, timeout=3).text == 'café'
+    assert calls == [('https://example.org', {'headers': {'X-Test': 'yes'}, 'timeout': 3})]
+    assert response.encoding == 'utf-8'
+
+
+def test_urlopen_keep_trying_preserves_declared_encoding(monkeypatch):
+    response = requests.Response()
+    response.status_code = 200
+    response._content = 'café'.encode('iso-8859-1')
+    response.headers['Content-Type'] = 'text/plain; charset=iso-8859-1'
+    monkeypatch.setattr(get_ia.requests, 'get', lambda url, **kwargs: response)
+    assert get_ia.urlopen_keep_trying('https://example.org').text == 'café'
+
+
+def test_urlopen_keep_trying_retries_server_error(monkeypatch):
+    responses = []
+    for status in (500, 200):
+        response = requests.Response()
+        response.status_code = status
+        responses.append(response)
+    calls = []
+
+    def get(url, **kwargs):
+        calls.append(url)
+        return responses.pop(0)
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    monkeypatch.setattr(get_ia, 'sleep', lambda seconds: None)
+    assert get_ia.urlopen_keep_trying('https://example.org').status_code == 200
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize('status', [403, 404, 416])
+def test_urlopen_keep_trying_does_not_retry_terminal_http_errors(monkeypatch, status):
+    response = requests.Response()
+    response.status_code = status
+    calls = []
+
+    def get(url, **kwargs):
+        calls.append(url)
+        return response
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    with pytest.raises(requests.HTTPError) as error:
+        get_ia.urlopen_keep_trying('https://example.org')
+    assert error.value.response.status_code == status
+    assert len(calls) == 1
+
+
+def test_get_from_archive_bulk_uses_range(monkeypatch):
+    calls = []
+
+    def get(url, headers=None):
+        calls.append((url, headers))
+        return SimpleNamespace(content=b'00010abcde00020')
+
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', get)
+    data, next_offset, next_length = get_ia.get_from_archive_bulk('item/file:0:10')
+    assert data == b'00010abcde'
+    assert (next_offset, next_length) == (10, 20)
+    assert calls == [(get_ia.IA_DOWNLOAD_URL + 'item/file', {'Range': 'bytes=0-14'})]
 
