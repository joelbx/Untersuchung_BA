+import { Message } from '@proton/shared/lib/interfaces/mail/Message';
+
+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { optimisticMarkAs } from './elementsActions';
+import reducer, { newState } from './elementsSlice';
+
+describe('optimistic mark-as bypass filtering', () => {
+    const message = { ID: 'message', ConversationID: 'conversation' } as Message;
+
+    it.each([
+        [MARK_AS_STATUS.READ, MARK_AS_STATUS.UNREAD, 1],
+        [MARK_AS_STATUS.UNREAD, MARK_AS_STATUS.READ, 0],
+    ])('removes stale conversation bypass after marking %s then %s', (firstStatus, secondStatus, unreadFilter) => {
+        const initialState = newState({ params: { filter: { Unread: unreadFilter } } });
+        const first = reducer(
+            initialState,
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: true, markAsStatus: firstStatus })
+        );
+        expect(first.bypassFilter).toEqual(['conversation']);
+
+        const second = reducer(
+            first,
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: true, markAsStatus: secondStatus })
+        );
+        expect(second.bypassFilter).toEqual([]);
+    });
+
+    it('uses message IDs in message mode and does not duplicate bypass entries', () => {
+        const state = newState({ params: { filter: { Unread: 1 } } });
+        const action = optimisticMarkAs({
+            elements: [message],
+            bypass: true,
+            conversationMode: false,
+            markAsStatus: MARK_AS_STATUS.READ,
+        });
+        const first = reducer(state, action);
+        expect(reducer(first, action).bypassFilter).toEqual(['message']);
+    });
+});
