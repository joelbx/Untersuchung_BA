+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_bcrypt_ident_filter(ident):
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib is needed for all bcrypt variants')
+    result = get_encrypted_password('123', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert result.startswith('$%s$04$' % ident)
+    assert get_encrypted_password('123', 'sha256', salt='12345678', ident=ident).startswith('$5$')
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+@pytest.mark.parametrize('ident', ('2a', '2y', '2b'))
+def test_bcrypt_ident_crypt(ident):
+    with passlib_off():
+        result = get_encrypted_password('123', 'blowfish', salt='123456789012345678901u', rounds=4, ident=ident)
+        assert result.startswith('$%s$04$' % ident)
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+def test_bcrypt_default_crypt():
+    with passlib_off():
+        result = get_encrypted_password('123', 'blowfish', salt='123456789012345678901u')
