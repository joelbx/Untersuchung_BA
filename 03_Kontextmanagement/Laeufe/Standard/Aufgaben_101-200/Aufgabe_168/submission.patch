+// The ref closes the gap between activation and React's next render. The context
+// shares the lock across the three controls for the member shown in this panel.
+const AdminActionLockContext = React.createContext<ReturnType<typeof useAdminActionLockState> | null>(null);
+
+function useAdminActionLockState(): {
+    pending: boolean;
+    run: (action: () => Promise<void>, errorTitle: string, errorDescription: string) => Promise<void>;
+} {
+    const locked = useRef(false);
+    const [pending, setPending] = useState(false);
+    const run = useCallback(async (action: () => Promise<void>, errorTitle: string, errorDescription: string) => {
+        if (locked.current) return;
+        locked.current = true;
+        setPending(true);
+        try {
+            await action();
+        } catch (err) {
+            logger.error("Admin action failed", err);
+            Modal.createDialog(ErrorDialog, {
+                title: errorTitle,
+                description: err instanceof Error && err.message ? err.message : errorDescription,
+            });
+        } finally {
+            locked.current = false;
+            setPending(false);
+        }
+    }, []);
+    return { pending, run };
+}
+
+function useAdminActionLock(): ReturnType<typeof useAdminActionLockState> {
+    const shared = useContext(AdminActionLockContext);
+    const local = useAdminActionLockState();
+    return shared ?? local;
+}
