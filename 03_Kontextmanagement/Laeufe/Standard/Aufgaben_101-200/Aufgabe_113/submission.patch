@@ -62,3 +62,88 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_create_address_family_with_defaults(self):
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[{'rt': '65000:1000'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc',
+                                             'address-family ipv6 unicast',
+                                             'route-target import 65000:1000',
+                                             'route-target export 65000:1000'])
+
+    def test_route_targets_mixed_changes_and_idempotence(self):
+        self.get_config.return_value = '''vrf context other
+  address-family ipv4 unicast
+    route-target import 1:1
+vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target import 2:2
+    route-target export 2:2
+    route-target both auto evpn
+  address-family ipv6 unicast
+    route-target export 3:3
+'''
+        args = dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False,
+                    route_targets=[{'rt': '1:1', 'direction': 'import'},
+                                   {'rt': '2:2', 'state': 'absent'},
+                                   {'rt': '3:3', 'direction': 'export'},
+                                   {'rt': '1:10', 'direction': 'import', 'state': 'absent'}])
+        set_module_args(args)
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc',
+                                             'address-family ipv4 unicast',
+                                             'no route-target both auto evpn',
+                                             'no route-target import 2:2',
+                                             'no route-target export 2:2',
+                                             'route-target export 3:3'])
+
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 3:3
+'''
+        set_module_args(args)
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_route_targets_absent_address_family_ignores_targets(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[{'rt': '1:1', 'state': 'absent'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc',
+                                             'no address-family ipv4 unicast'])
+
+    def test_route_targets_other_address_family_does_not_match(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[{'rt': '1:1', 'direction': 'import'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc',
+                                             'address-family ipv4 unicast',
+                                             'route-target import 1:1'])
+
+    def test_route_targets_require_rt(self):
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[{'direction': 'import'}]))
+        self.execute_module(failed=True)
+
+    def test_route_target_auto_evpn_idempotence(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=True))
+        self.assertEqual(self.execute_module(changed=False)['commands'], [])
+
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False))
+        self.assertEqual(self.execute_module(changed=False)['commands'], [])
