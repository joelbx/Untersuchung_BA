+func TestEmptyReleaseInstalledPackages(t *testing.T) {
+	for _, tt := range []struct {
+		name, line, version, sourceVersion string
+		parse                              func(*redhatBase, string) (*models.Package, *models.SrcPackage, error)
+	}{
+		{"rpm zero epoch", "package 0 1  x86_64 package-1-.src.rpm", "1", "1", (*redhatBase).parseInstalledPackagesLine},
+		{"rpm nonzero epoch", "package 2 1  x86_64 package-1-.src.rpm", "2:1", "2:1", (*redhatBase).parseInstalledPackagesLine},
+		{"repoquery none epoch", "package (none) 1  x86_64 package-1-.src.rpm installed", "1", "1", (*redhatBase).parseInstalledPackagesLineFromRepoquery},
+		{"repoquery nonzero epoch", "package 2 1  x86_64 package-1-.src.rpm @extras", "2:1", "2:1", (*redhatBase).parseInstalledPackagesLineFromRepoquery},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			pkg, src, err := tt.parse(&redhatBase{}, tt.line)
+			if err != nil || pkg == nil || src == nil {
+				t.Fatalf("parse result: package=%v source=%v error=%v", pkg, src, err)
+			}
+			if pkg.Version != tt.version || pkg.Release != "" || pkg.Arch != "x86_64" || src.Version != tt.sourceVersion {
+				t.Errorf("unexpected package=%+v source=%+v", pkg, src)
+			}
+		})
+	}
+	base := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2"}, log: logging.NewIODiscardLogger()}}
+	bins, srcs, err := base.parseInstalledPackages("package 0 1  x86_64 package-1-.src.rpm\npackage2 0 1  x86_64 package2-1-.src.rpm installed")
+	if err != nil || bins["package"].Release != "" || bins["package2"].Repository != "amzn2-core" || srcs["package"].Version != "1" {
+		t.Errorf("unexpected packages: bins=%v srcs=%v err=%v", bins, srcs, err)
+	}
+}
+
+func TestSplitFileNameValidation(t *testing.T) {
+	for _, tt := range []struct {
+		file, name, version, release, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src"},
+		{"package-0--src.rpm", "package", "0", "", "src"},
+		{"name-with-hyphens-0-1.src.rpm", "name-with-hyphens", "0", "1", "src"},
+	} {
+		name, version, release, _, arch, err := splitFileName(tt.file)
+		if err != nil || name != tt.name || version != tt.version || release != tt.release || arch != tt.arch {
+			t.Errorf("splitFileName(%q) = %q, %q, %q, %q, %v", tt.file, name, version, release, arch, err)
+		}
+	}
+	for _, file := range []string{"-0-1.src.rpm", "package--1.src.rpm", "package-0-1.rpm", "package-0-1..rpm", "package-0-1.src", "package-0.src.rpm"} {
+		if _, _, _, _, _, err := splitFileName(file); err == nil {
+			t.Errorf("splitFileName(%q) accepted malformed filename", file)
+		}
+	}
+}
