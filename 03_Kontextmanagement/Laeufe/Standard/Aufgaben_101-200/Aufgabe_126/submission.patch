+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+describe('assistant Markdown', () => {
+    it('moves sibling nested lists inside their preceding list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+        fixNestedLists(dom);
+        expect(dom.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+        const markdown = htmlToMarkdown(dom);
+        const result = document.implementation.createHTMLDocument();
+        result.body.innerHTML = markdownToHTML(markdown);
+        expect(result.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    });
+
+    it('keeps ordered list markers and styled link and image attributes', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<ol><li>First</li><li>Second</li></ol><a href="#1" class="link" style="color: red">Link</a><img src="#2" class="image" style="width: 10px">';
+        const markdown = htmlToMarkdown(dom);
+        expect(markdown).toContain('1. First');
+        expect(markdown).toContain('2. Second');
+        const html = markdownToHTML(markdown);
+        expect(html).toContain('<ol>');
+        expect(html).toContain('class="link"');
+        expect(html).toContain('class="image"');
+        expect(html).toContain('style="color: red"');
+    });
+});
