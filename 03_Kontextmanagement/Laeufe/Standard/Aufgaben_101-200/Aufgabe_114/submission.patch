+// artistFolder finds the shared parent of the albums' media directories.
+func artistFolder(albums model.Albums) string {
+	var folder string
+	for _, album := range albums {
+		for _, dir := range album.Dirs() {
+			if folder == "" {
+				folder = filepath.Dir(dir)
+			}
+			for folder != "" && folder != filepath.Dir(folder) {
+				rel, err := filepath.Rel(folder, dir)
+				if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+					break
+				}
+				folder = filepath.Dir(folder)
+			}
+		}
+	}
+	return folder
+}
+
+func findArtistImage(folder string) (string, string) {
+	if folder == "" {
+		return "", ""
+	}
+	files, err := filepath.Glob(filepath.Join(folder, "artist.*"))
+	if err != nil {
+		return "", ""
+	}
+	for _, file := range files {
+		info, err := os.Stat(file)
+		if err == nil && info.Mode().IsRegular() {
+			return file, fmt.Sprintf("%s:%d:%d", file, info.ModTime().UnixNano(), info.Size())
+		}
+	}
+	return "", ""
+}
+
+func fromArtistFolder(file string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if file == "" {
+			return nil, "", nil
+		}
+		f, err := os.Open(file)
+		if err != nil {
+			return nil, "", err
+		}
+		return f, file, nil
+	}
+}
