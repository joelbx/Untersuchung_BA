diff --git a/applications/drive/src/app/zustand/share/member-invitation-stores.test.ts b/applications/drive/src/app/zustand/share/member-invitation-stores.test.ts
new file mode 100644
index 0000000..97eecd4
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/member-invitation-stores.test.ts
@@ -0,0 +1,64 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareInvitation;
+const externalInvitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareExternalInvitation;
+
+beforeEach(() => {
+    useMembersStore.setState({ members: {} });
+    useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+});
+
+test('members are replaced per share and missing shares are empty', () => {
+    const store = useMembersStore.getState();
+    expect(store.getMembers('missing')).toEqual([]);
+    store.setMembers('a', [member('a@example.com')]);
+    store.setMembers('b', [member('b@example.com')]);
+    store.setMembers('a', [member('new@example.com')]);
+    expect(store.getMembers('a').map(({ email }) => email)).toEqual(['new@example.com']);
+    expect(store.getMembers('b').map(({ email }) => email)).toEqual(['b@example.com']);
+});
+
+test('internal and external invitations are managed independently per share', () => {
+    const store = useInvitationsStore.getState();
+    expect(store.getInvitations('missing')).toEqual([]);
+    expect(store.getExternalInvitations('missing')).toEqual([]);
+    store.setInvitations('a', [invitation('a@example.com')]);
+    store.setInvitations('b', [invitation('b@example.com')]);
+    store.setExternalInvitations('a', [externalInvitation('external-a@example.com')]);
+    store.setExternalInvitations('b', [externalInvitation('external-b@example.com')]);
+    store.updateInvitationsPermissions('a', [invitation('updated-a@example.com')]);
+    store.removeExternalInvitations('a', []);
+    expect(store.getInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual(['b@example.com']);
+    expect(store.getExternalInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+        'external-b@example.com',
+    ]);
+    store.addMultipleInvitations(
+        'a',
+        [invitation('new-a@example.com')],
+        [externalInvitation('new-external-a@example.com')]
+    );
+    store.removeInvitations('a', []);
+    store.updateExternalInvitations('a', [externalInvitation('updated-external-a@example.com')]);
+    expect(store.getInvitations('a')).toEqual([]);
+    expect(store.getExternalInvitations('a').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+        'updated-external-a@example.com',
+    ]);
+    expect(store.getInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual(['b@example.com']);
+    expect(store.getExternalInvitations('b').map(({ inviteeEmail }) => inviteeEmail)).toEqual([
+        'external-b@example.com',
+    ]);
+});
+
+test('getExistingEmails flattens members and both invitation types', () => {
+    expect(
+        getExistingEmails(
+            [member('member@example.com')],
+            [invitation('internal@example.com')],
+            [externalInvitation('external@example.com')]
+        )
+    ).toEqual(['member@example.com', 'internal@example.com', 'external@example.com']);
+});
