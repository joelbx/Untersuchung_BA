diff --git a/test/units/plugins/connection/test_ssh.py b/test/units/plugins/connection/test_ssh.py
index 0bba41b..0bcb87a 100644
--- a/test/units/plugins/connection/test_ssh.py
+++ b/test/units/plugins/connection/test_ssh.py
@@ -34,6 +34,45 @@ from ansible.plugins.connection import ssh
 from ansible.plugins.loader import connection_loader, become_loader
 
 
+_CLIXML_ERROR = b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">bad_x000D__x000A_</S></Objs>'
+
+
+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain stderr\r\n', b'plain stderr\r\n'),
+    (_CLIXML_ERROR, b'bad\r\n'),
+    (b'before\r\n' + _CLIXML_ERROR + b'after\r\n', b'before\r\nbad\r\nafter\r\n'),
+    (b'before ' + _CLIXML_ERROR + b' trailing', b'before bad\r\n trailing'),
+    (_CLIXML_ERROR.replace(b'<S', b'\r\n<S') + b' tail', b'bad\r\n tail'),
+    (b'before\r\nCLIXML\r\n' + _CLIXML_ERROR.split(b'\r\n', 1)[1], b'beforebad\r\n'),
+    (_CLIXML_ERROR + b'\r\n' + _CLIXML_ERROR, b'bad\r\n\r\nbad\r\n'),
+    (_CLIXML_ERROR + b'\r\n<Objs Version="1.1.0.1"><S S="Error">more</S></Objs> tail',
+     b'bad\r\n\r\nmore tail'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken',
+     b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken</Objs>',
+     b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken</Objs>'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">\x82</S></Objs>',
+     'é'.encode()),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_replace_stderr_clixml_keeps_invalid_before_valid():
+    invalid = b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken'
+    assert ssh._replace_stderr_clixml(invalid + b'\r\n' + _CLIXML_ERROR) == invalid + b'\r\nbad\r\n'
+
+
+def test_exec_command_replaces_windows_clixml():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn._shell = MagicMock(_IS_WINDOWS=True)
+    conn._build_command = MagicMock(return_value='ssh')
+    conn._run = MagicMock(return_value=(1, b'', b'prefix ' + _CLIXML_ERROR + b' suffix'))
+    conn.get_option = MagicMock(return_value='ssh')
+
+    assert conn.exec_command('cmd') == (1, b'', b'prefix bad\r\n suffix')
+
+
