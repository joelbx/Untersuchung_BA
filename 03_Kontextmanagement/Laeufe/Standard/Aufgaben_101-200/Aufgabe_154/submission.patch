+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML records in stderr, retaining all other bytes."""
+    header = b"#< CLIXML\r\n"
+    closing_tag = b"</Objs>"
+    result: list[bytes] = []
+    copied_to = 0
+    offset = 0
+
+    for line in stderr.splitlines(keepends=True):
+        starts = []
+        position = line.find(header)
+        while position != -1:
+            starts.append((offset + position, offset + position + len(header)))
+            position = line.find(header, position + len(header))
+        if line == b"CLIXML\r\n" and offset >= 2 and stderr[offset - 2:offset] == b"\r\n":
+            starts.append((offset - 2, offset + len(line)))
+
+        for start, xml_start in starts:
+            if start < copied_to:
+                continue
+
+            # PowerShell may repeat the header before one or more XML elements.
+            while stderr.startswith(header, xml_start):
+                xml_start += len(header)
+
+            element_end = xml_start
+            xml_parts = []
+            next_element = element_end
+            while stderr.startswith(b"<Objs ", next_element):
+                close = stderr.find(closing_tag, next_element)
+                if close == -1:
+                    break
+                candidate_end = close + len(closing_tag)
+                try:
+                    xml = stderr[next_element:candidate_end].decode("utf-8")
+                except UnicodeDecodeError:
+                    xml = stderr[next_element:candidate_end].decode("cp437")
+                try:
+                    ET.fromstring(xml)
+                except ET.ParseError:
+                    break
+                xml_parts.append(xml)
+                element_end = candidate_end
+                next_element = element_end
+                while next_element < len(stderr) and stderr[next_element] in b" \t\r\n":
+                    next_element += 1
+                if not stderr.startswith(b"<Objs ", next_element):
+                    break
+
+            if element_end == xml_start:
+                continue
+
+            try:
+                decoded = _parse_clixml("".join(xml_parts).encode("utf-8"))
+            except (ET.ParseError, UnicodeError, ValueError):
+                continue
+
+            result.extend((stderr[copied_to:start], decoded))
+            copied_to = element_end
+
+        offset += len(line)
+
+    if not result:
+        return stderr
+    result.append(stderr[copied_to:])
+    return b"".join(result)
+
