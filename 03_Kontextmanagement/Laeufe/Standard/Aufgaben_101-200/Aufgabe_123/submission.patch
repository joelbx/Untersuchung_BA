diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..3442291
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,84 @@
+import { render, screen } from '@testing-library/react';
+import { NotificationOptions } from './interfaces';
+import Notification from './Notification';
+import createNotificationManager from './manager';
+
+describe('Notification', () => {
+    const props = { type: 'error' as const, isClosing: false, onExit: jest.fn() };
+
+    it('renders safe HTML and secures links', () => {
+        const { container } = render(
+            <Notification {...props}>
+                {
+                    'Read <strong>details</strong> <a href="https://example.com" target="_self">here</a><script>alert(1)</script><a href="javascript:alert(1)">bad link</a>'
+                }
+            </Notification>
+        );
+
+        expect(screen.getByText('details').tagName).toBe('STRONG');
+        expect(container.querySelector('script')).toBeNull();
+        const links = container.querySelectorAll('a');
+        expect(links).toHaveLength(2);
+        expect(links[0]).toHaveAttribute('href', 'https://example.com');
+        expect(links[1]).not.toHaveAttribute('href');
+        links.forEach((link) => {
+            expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+            expect(link).toHaveAttribute('target', '_blank');
+        });
+    });
+
+    it('preserves React content and secures its links', () => {
+        render(
+            <Notification {...props}>
+                <a href="https://example.com" target="_self">
+                    React link
+                </a>
+            </Notification>
+        );
+
+        expect(screen.getByRole('link')).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(screen.getByRole('link')).toHaveAttribute('target', '_blank');
+    });
+});
+
+describe('notification manager', () => {
+    let notifications: NotificationOptions[];
+    let manager: ReturnType<typeof createNotificationManager>;
+
+    beforeEach(() => {
+        notifications = [];
+        manager = createNotificationManager((update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        });
+    });
+
+    afterEach(() => manager.clearNotifications());
+
+    it('deduplicates non-success notifications using string text as the default key', () => {
+        manager.createNotification({ text: 'same', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'info', expiration: -1 });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ key: 'same', type: 'info' });
+    });
+
+    it('uses explicit keys for React content and identifiers when no key is given', () => {
+        manager.createNotification({ text: <span>first</span>, key: 'shared', type: 'error', expiration: -1 });
+        manager.createNotification({ text: <span>second</span>, key: 'shared', type: 'warning', expiration: -1 });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ key: 'shared', type: 'warning' });
+
+        const id = manager.createNotification({ text: <span>third</span>, type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(2);
+        expect(notifications[1].key).toBe(id);
+    });
+
+    it('allows identical success notifications alongside other notifications', () => {
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'error', expiration: -1 });
+
+        expect(notifications).toHaveLength(3);
+        expect(notifications.map(({ type }) => type)).toEqual(['success', 'success', 'error']);
+    });
+});
