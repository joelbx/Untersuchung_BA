new file mode 100644
index 0000000..df03a59
--- /dev/null
+++ b/models/utils_fortinet_test.go
@@ -0,0 +1,55 @@
+//go:build !scanner
+
+package models
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertFortinetToModel(t *testing.T) {
+	published := time.Date(2023, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	got := ConvertFortinetToModel("CVE-2023-0001", []cvedict.Fortinet{{
+		AdvisoryID: "FG-IR-23-001", AdvisoryURL: "https://fortiguard.example/advisory",
+		Title: "FortiOS issue", Summary: "Affected FortiOS versions",
+		Cvss3:         cvedict.FortinetCvss3{Cvss3: cvedict.Cvss3{BaseScore: 8.1, VectorString: "CVSS:3.1/test"}},
+		Cwes:          []cvedict.FortinetCwe{{CweID: "CWE-79"}},
+		References:    []cvedict.FortinetReference{{Reference: cvedict.Reference{Link: "https://example.com/ref", Source: "Fortinet"}}},
+		PublishedDate: published, LastModifiedDate: modified,
+	}})
+	want := []CveContent{{
+		Type: Fortinet, CveID: "CVE-2023-0001", Title: "FortiOS issue", Summary: "Affected FortiOS versions",
+		Cvss3Score: 8.1, Cvss3Vector: "CVSS:3.1/test", SourceLink: "https://fortiguard.example/advisory",
+		CweIDs: []string{"CWE-79"}, References: []Reference{{Link: "https://example.com/ref", Source: "Fortinet"}},
+		Published: published, LastModified: modified,
+	}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("ConvertFortinetToModel() = %#v, want %#v", got, want)
+	}
+}
+
+func TestFortinetContentSelectionOrder(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Trivy:    {{Summary: "trivy"}},
+		Fortinet: {{Summary: "fortinet", Cvss3Score: 8.1}},
+		Nvd:      {{Summary: "nvd", Cvss3Score: 7.0}},
+		Jvn:      {{Cvss3Score: 6.0}},
+	}}
+	for i, typ := range []CveContentType{Trivy, Fortinet, Nvd} {
+		if got := v.Titles("en", "")[i].Type; got != typ {
+			t.Errorf("Titles()[%d].Type = %s, want %s", i, got, typ)
+		}
+		if got := v.Summaries("en", "")[i].Type; got != typ {
+			t.Errorf("Summaries()[%d].Type = %s, want %s", i, got, typ)
+		}
+	}
+	for i, typ := range []CveContentType{Fortinet, Nvd, Jvn} {
+		if got := v.Cvss3Scores()[i].Type; got != typ {
+			t.Errorf("Cvss3Scores()[%d].Type = %s, want %s", i, got, typ)
+		}
+	}
+}
