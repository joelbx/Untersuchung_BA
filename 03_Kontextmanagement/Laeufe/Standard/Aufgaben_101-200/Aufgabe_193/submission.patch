+@pytest.mark.parametrize('command, install_roles, install_collections_expected, warning_expected', [
+    (['install'], True, True, False),
+    (['install', '-p', 'custom_roles'], True, False, True),
+    (['role', 'install'], True, False, False),
+    (['role', 'install', '-p', 'custom_roles'], True, False, False),
+    (['collection', 'install'], False, True, False),
+])
+def test_install_mixed_requirements(tmp_path, monkeypatch, command, install_roles,
+                                    install_collections_expected, warning_expected):
+    requirements_file = str(tmp_path / 'requirements.yml')
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles:\n- name: namespace.role\ncollections:\n- namespace.collection\n')
+
+    role_install = MagicMock()
+    collection_install = MagicMock()
+    warnings = MagicMock()
+    messages = MagicMock()
+    verbose = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_execute_role_install', role_install)
+    monkeypatch.setattr(GalaxyCLI, '_execute_collection_install', collection_install)
+    monkeypatch.setattr(ansible.utils.display.Display, 'warning', warnings)
+    monkeypatch.setattr(ansible.utils.display.Display, 'display', messages)
+    monkeypatch.setattr(ansible.utils.display.Display, 'vvv', verbose)
+
+    args = ['ansible-galaxy'] + command + ['-r', requirements_file]
+    GalaxyCLI(args=args).run()
+
+    assert bool(role_install.called) == install_roles
+    assert bool(collection_install.called) == install_collections_expected
+    assert any('Starting galaxy role install process' in call[0][0] for call in messages.call_args_list) == install_roles
+    assert any('Starting galaxy collection install process' in call[0][0] for call in messages.call_args_list) == install_collections_expected
+    assert any('cannot be installed to a roles path' in call[0][0] for call in warnings.call_args_list) == warning_expected
+    if command[:2] == ['role', 'install'] and '-p' in command:
+        assert any('contains collections which will be ignored' in call[0][0] for call in verbose.call_args_list)
+
+
+def test_install_empty_requirements(tmp_path, monkeypatch):
+    requirements_file = str(tmp_path / 'requirements.yml')
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles: []\ncollections: []\n')
+    role_install = MagicMock()
+    collection_install = MagicMock()
+    messages = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_execute_role_install', role_install)
+    monkeypatch.setattr(GalaxyCLI, '_execute_collection_install', collection_install)
+    monkeypatch.setattr(ansible.utils.display.Display, 'display', messages)
+
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+    role_install.assert_not_called()
+    collection_install.assert_not_called()
+    assert any('Skipping install, no requirements found' in call[0][0] for call in messages.call_args_list)
+
+
+def test_role_install_rejects_invalid_requirements_extension(tmp_path):
+    requirements_file = str(tmp_path / 'requirements.txt')
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles: []\n')
+
+    with pytest.raises(AnsibleError, match='Invalid role requirements file'):
+        GalaxyCLI(args=['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+
 def test_collection_install_with_relative_path(collection_install, monkeypatch):
     mock_install = collection_install[0]
 
