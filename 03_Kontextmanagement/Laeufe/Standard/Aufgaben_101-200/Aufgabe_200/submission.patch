+@pytest.mark.parametrize('duration, milliseconds', [
+    ('5000', 5000),
+    ('2m30s', 150000),
+    ('1.5h', 5400000),
+])
+def test_later_duration(mocker, duration, milliseconds):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer').return_value
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration=duration, command='scroll down', win_id=0)
+
+    timer.setInterval.assert_called_once_with(milliseconds)
+    timer.start.assert_called_once_with()
+
+
+@pytest.mark.parametrize('duration, error', [
+    ('-1', "I can't run something in the past!"),
+    ('nonsense', 'Invalid duration'),
+])
+def test_later_invalid_duration(duration, error):
+    with pytest.raises(cmdutils.CommandError, match=error):
+        utilcmds.later(duration=duration, command='scroll down', win_id=0)
+
