diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..0f9c7a6 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -32,6 +32,59 @@ class TestIptables(ModuleTestCase):
             set_module_args({})
             iptables.main()
 
+    def test_match_set_rule_with_and_without_explicit_match(self):
+        for match in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'match': match,
+                'match_set': 'admin_hosts',
+                'match_set_flags': 'src',
+                'destination_port': '22',
+                'jump': 'ACCEPT',
+                'comment': 'SSH from admins',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.side_effect = [(1, '', ''), (0, '', '')]
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_count, 2)
+            expected_rule = [
+                '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', 'src',
+                '-j', 'ACCEPT', '--destination-port', '22',
+                '-m', 'comment', '--comment', 'SSH from admins',
+            ]
+            self.assertEqual(run_command.call_args_list[0][0][0],
+                             ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'] + expected_rule)
+            self.assertEqual(run_command.call_args_list[1][0][0],
+                             ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'] + expected_rule)
+
+    def test_match_set_inversion_and_flag_choices(self):
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            set_module_args({
+                'chain': 'INPUT',
+                'match_set': '!admin_hosts',
+                'match_set_flags': flags,
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_args[0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-m', 'set', '!', '--match-set', 'admin_hosts', flags,
+            ])
+
+    def test_match_set_requires_both_parameters(self):
+        for options in ({'match_set': 'admin_hosts'}, {'match_set_flags': 'src'},
+                        {'match_set': 'admin_hosts', 'match_set_flags': 'invalid'}):
+            set_module_args(dict({'chain': 'INPUT'}, **options))
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            run_command.assert_not_called()
+
