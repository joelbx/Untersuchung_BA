diff --git a/openlibrary/tests/test_book_providers.py b/openlibrary/tests/test_book_providers.py
new file mode 100644
index 0000000..4ff0693
--- /dev/null
+++ b/openlibrary/tests/test_book_providers.py
@@ -0,0 +1,21 @@
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+)
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.is_own_ocaid('Nordic_Runeberg_01')
+    assert not provider.is_own_ocaid('unrelated_01')
+
+    edition = {'identifiers': {'project_runeberg': ['book/volume', 'other']}}
+    assert provider.get_identifiers(edition) == ['book/volume', 'other']
+    assert provider.get_acquisitions(edition)[0].url == (
+        'https://runeberg.org/book/volume/'
+    )
+    acquisition = provider.get_acquisitions(edition)[0]
+    assert acquisition.access == 'open-access'
+    assert acquisition.format == 'web'
+    assert acquisition.provider_name == 'runeberg'
