+
+	describe('backlinks', () => {
+		let target;
+		let source;
+		let previousSetting;
+
+		before(async () => {
+			previousSetting = meta.config.topicBacklinks;
+			meta.config.topicBacklinks = 1;
+			target = await topics.post({ uid: adminUid, cid: categoryObj.cid, title: 'Backlink target', content: 'Target content' });
+			source = await topics.post({
+				uid: fooUid,
+				cid: categoryObj.cid,
+				title: 'Backlink source',
+				content: `See ${nconf.get('url')}/topic/${target.topicData.tid}/backlink-target and /topic/${target.topicData.tid}`,
+			});
+		});
+
+		after(() => {
+			meta.config.topicBacklinks = previousSetting;
+		});
+
+		it('adds one event for a referenced topic and links to the source post', async () => {
+			const key = `pid:${source.postData.pid}:backlinks`;
+			assert.deepStrictEqual(await db.getSortedSetRange(key, 0, -1), [String(target.topicData.tid)]);
+			const events = await topics.events.get(target.topicData.tid, adminUid);
+			const backlink = events.find(event => event.type === 'backlink');
+			assert.strictEqual(backlink.href, `/post/${source.postData.pid}`);
+			assert.strictEqual(backlink.uid, fooUid);
+			assert.strictEqual(backlink.text, '[[topic:backlink]]');
+			assert.strictEqual(await topics.syncBacklinks(source.postData), 0);
+		});
+
+		it('hides events when disabled and removes them when the link is edited away', async () => {
+			meta.config.topicBacklinks = 0;
+			assert(!(await topics.events.get(target.topicData.tid, adminUid)).some(event => event.type === 'backlink'));
+			meta.config.topicBacklinks = 1;
+			await posts.edit({ pid: source.postData.pid, uid: fooUid, title: 'Backlink source', content: 'Link removed from this post' });
+			assert.deepStrictEqual(await db.getSortedSetRange(`pid:${source.postData.pid}:backlinks`, 0, -1), []);
+			assert(!(await topics.events.get(target.topicData.tid, adminUid)).some(event => event.type === 'backlink'));
+		});
+
+		it('rejects invalid data and ignores self-links and missing topics', async () => {
+			await assert.rejects(topics.syncBacklinks(), /\[\[error:invalid-data\]\]/);
+			const changes = await topics.syncBacklinks({
+				...source.postData,
+				content: `/topic/${source.topicData.tid} /topic/999999999`,
+			});
+			assert.strictEqual(changes, 0);
+		});
+
+		it('reports the number of added and removed references', async () => {
+			const linked = { ...source.postData, content: `/topic/${target.topicData.tid}` };
+			assert.strictEqual(await topics.syncBacklinks(linked), 1);
+			assert.strictEqual(await topics.syncBacklinks(linked), 0);
+			assert.strictEqual(await topics.syncBacklinks({ ...linked, content: 'No links here' }), 1);
+		});
+	});
 });
