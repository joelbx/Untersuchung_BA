 const db = require('../database');
 const user = require('../user');
@@ -15,6 +16,62 @@ module.exports = function (Topics) {
 	Topics.onNewPostMade = async function (postData) {
 		await Topics.updateLastPostTime(postData.tid, postData.timestamp);
 		await Topics.addPostToTopic(postData.tid, postData);
+		await Topics.syncBacklinks(postData);
+	};
+
+	Topics.syncBacklinks = async function (postData) {
+		if (!postData || !Number.isInteger(Number(postData.pid)) || Number(postData.pid) < 1 ||
+			!Number.isInteger(Number(postData.tid)) || Number(postData.tid) < 1 ||
+			!Number.isInteger(Number(postData.uid)) || Number(postData.uid) < 0 ||
+			typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const key = `pid:${postData.pid}:backlinks`;
+		const oldTids = await db.getSortedSetRange(key, 0, -1);
+		const base = String(nconf.get('url') || '').replace(/\/$/, '');
+		const escapedBase = base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+		const prefix = base ? `${escapedBase}|` : '';
+		const pattern = new RegExp(`(?:${prefix}(?<![\\w./:]))/topic/(\\d+)(?=[/\\s?#)\\]>'".,;:!]|$)`, 'g');
+		const candidates = new Set();
+		for (const match of postData.content.matchAll(pattern)) {
+			if (Number(match[1]) !== Number(postData.tid)) {
+				candidates.add(match[1]);
+			}
+		}
+		const tids = [];
+		for (const tid of candidates) {
+			// Topic existence can change between edits; skip stale links.
+			// eslint-disable-next-line no-await-in-loop
+			if (await Topics.exists(tid)) {
+				tids.push(tid);
+			}
+		}
+		const removed = oldTids.filter(tid => !tids.includes(tid));
+		const added = tids.filter(tid => !oldTids.includes(tid));
+		for (const tid of removed) {
+			// Remove only events created by this post.
+			// eslint-disable-next-line no-await-in-loop
+			const ids = await db.getSortedSetRange(`topic:${tid}:events`, 0, -1);
+			// eslint-disable-next-line no-await-in-loop
+			const events = await db.getObjects(ids.map(id => `topicEvent:${id}`));
+			const backlinkIds = ids.filter((id, idx) => events[idx] && events[idx].type === 'backlink' &&
+				events[idx].href === `/post/${postData.pid}`);
+			// eslint-disable-next-line no-await-in-loop
+			if (backlinkIds.length) {
+				// eslint-disable-next-line no-await-in-loop
+				await Topics.events.purge(tid, backlinkIds);
+			}
+			// eslint-disable-next-line no-await-in-loop
+			await db.sortedSetRemove(key, tid);
+		}
+		for (const tid of added) {
+			// eslint-disable-next-line no-await-in-loop
+			await Topics.events.log(tid, { type: 'backlink', href: `/post/${postData.pid}`, uid: postData.uid });
+			// eslint-disable-next-line no-await-in-loop
+			await db.sortedSetAdd(key, Date.now(), tid);
+		}
+		return added.length + removed.length;
 	};
 
 	Topics.getTopicPosts = async function (tid, set, start, stop, uid, reverse) {
