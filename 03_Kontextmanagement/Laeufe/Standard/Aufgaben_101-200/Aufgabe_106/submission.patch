+func TestFillWordPressIgnoresInactiveFromServerConfig(t *testing.T) {
+	oldConf := c.Conf
+	defer func() { c.Conf = oldConf }()
+
+	activeBody := `{"active":{"vulnerabilities":[{"id":123,"fixed_in":"2.0","title":"active vulnerability"}]}}`
+	inactiveBody := `{"inactive":{"vulnerabilities":[{"id":456,"fixed_in":"2.0","title":"inactive vulnerability"}]}}`
+	caches := map[string]*string{
+		"60":             stringPtr(`{}`),
+		"active-plugin":   &activeBody,
+		"inactive-plugin": &inactiveBody,
+		"active-theme":    &activeBody,
+		"inactive-theme":  &inactiveBody,
+	}
+	packages := models.WordPressPackages{
+		{Type: models.WPCore, Version: "6.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: "inactive", Version: "1.0"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+	}
+	c.Conf.WpIgnoreInactive = false
+	c.Conf.Servers = map[string]c.ServerInfo{
+		"site": {WordPress: c.WordPressConf{IgnoreInactive: true}},
+	}
+	r := &models.ScanResult{ServerName: "site", WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+	count, err := FillWordPress(r, "unused", caches)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Fatalf("got %d vulnerabilities, want 2", count)
+	}
+	if len(r.ScannedCves) != 1 {
+		t.Fatalf("got %d distinct vulnerabilities, want 1", len(r.ScannedCves))
+	}
+	if _, ok := r.ScannedCves["WPVDBID-456"]; ok {
+		t.Fatal("inactive vulnerability included")
+	}
+}
