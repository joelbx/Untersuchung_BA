diff --git a/openlibrary/catalog/add_book/tests/test_preview.py b/openlibrary/catalog/add_book/tests/test_preview.py
new file mode 100644
index 0000000..798e600
--- /dev/null
+++ b/openlibrary/catalog/add_book/tests/test_preview.py
@@ -0,0 +1,76 @@
+from copy import deepcopy
+
+from openlibrary.catalog import add_book
+
+
+def test_preview_new_book_has_records_without_writes(mock_site, monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError('preview attempted an external write')
+
+    monkeypatch.setattr(mock_site, 'save_many', forbidden)
+    monkeypatch.setattr(mock_site, 'new_key', forbidden)
+    monkeypatch.setattr(add_book, 'add_cover', forbidden)
+    monkeypatch.setattr(add_book, 'update_ia_metadata_for_ol_edition', forbidden)
+
+    reply = add_book.load(
+        {
+            'title': 'Preview title',
+            'source_records': ['ia:preview'],
+            'ocaid': 'preview',
+            'authors': [{'name': 'Dr. Ada Example'}],
+            'cover': 'https://M.MEDIA-AMAZON.COM/cover.jpg',
+        },
+        save=False,
+    )
+    assert reply['preview'] is True
+    assert reply['cover_accepted'] is True
+    assert [record['type']['key'] for record in reply['edits']] == ['/type/author', '/type/work', '/type/edition']
+    author, work, edition = reply['edits']
+    assert author['name'] == 'Ada Example'
+    assert author['key'].startswith('/authors/__new__')
+    assert work['key'].startswith('/works/__new__')
+    assert edition['key'].startswith('/books/__new__')
+    assert edition['authors'] == [{'key': author['key']}]
+    assert edition['works'] == [{'key': work['key']}]
+    assert mock_site.get(edition['key']) is None
+
+
+def test_preview_matched_edition_reports_changes_without_saving(mock_site, monkeypatch, add_languages):
+    rec = {'title': 'Preview match', 'source_records': ['ia:match'], 'languages': ['eng']}
+    created = add_book.load(deepcopy(rec))
+    edition_key = created['edition']['key']
+    original = deepcopy(mock_site.get(edition_key).dict())
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError('preview attempted a write')
+
+    monkeypatch.setattr(mock_site, 'save_many', forbidden)
+    monkeypatch.setattr(add_book, 'update_ia_metadata_for_ol_edition', forbidden)
+    reply = add_book.load({**rec, 'languages': ['eng', 'fre']}, save=False)
+    assert reply['preview'] is True
+    assert reply['edition'] == {'key': edition_key, 'status': 'modified'}
+    assert reply['edits'][0]['languages'] == [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+    assert mock_site.get(edition_key).dict() == original
+
+
+def test_cover_host_allowlist():
+    allowed = ('m.media-amazon.com',)
+    assert add_book.check_cover_url_host('https://M.MEDIA-AMAZON.COM/a.jpg', allowed)
+    assert not add_book.check_cover_url_host('https://m.media-amazon.com.evil/a.jpg', allowed)
+    assert not add_book.check_cover_url_host(None, allowed)
+    assert not add_book.check_cover_url_host('not-a-url', allowed)
+
+
+def test_disallowed_cover_is_never_uploaded(mock_site, monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError('disallowed cover was uploaded')
+
+    monkeypatch.setattr(add_book, 'add_cover', forbidden)
+    reply = add_book.load(
+        {
+            'title': 'No cover upload',
+            'source_records': ['test:no-cover-upload'],
+            'cover': 'https://m.media-amazon.com.evil/cover.jpg',
+        }
+    )
+    assert 'covers' not in mock_site.get(reply['edition']['key'])
