+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type billingModeDynamoDB struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+	describeErr    error
+}
+
+func (m *billingModeDynamoDB) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingModeDynamoDB) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingModeDynamoDB) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describeOutput, m.describeErr
+}
+
+func TestBillingModeDefaultsAndValidation(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  string
+		valid bool
+	}{
+		{"", billingModePayPerRequest, true},
+		{billingModePayPerRequest, billingModePayPerRequest, true},
+		{billingModeProvisioned, billingModeProvisioned, true},
+		{"invalid", "", false},
+	} {
+		cfg := Config{TableName: "test", BillingMode: tc.input}
+		err := cfg.CheckAndSetDefaults()
+		if !tc.valid {
+			require.Error(t, err)
+			continue
+		}
+		require.NoError(t, err)
+		require.Equal(t, tc.want, cfg.BillingMode)
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		mode       string
+		awsMode    string
+		throughput bool
+	}{
+		{billingModePayPerRequest, dynamodb.BillingModePayPerRequest, false},
+		{billingModeProvisioned, dynamodb.BillingModeProvisioned, true},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			mock := &billingModeDynamoDB{}
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{
+				BillingMode: tc.mode, ReadCapacityUnits: 7, WriteCapacityUnits: 9,
+			}, svc: mock}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(mock.createInput.BillingMode))
+			if tc.throughput {
+				require.NotNil(t, mock.createInput.ProvisionedThroughput)
+				require.Equal(t, int64(7), aws.Int64Value(mock.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(9), aws.Int64Value(mock.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
+				require.Nil(t, mock.createInput.ProvisionedThroughput)
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		attrs      []*dynamodb.AttributeDefinition
+		mode       *dynamodb.BillingModeSummary
+		wantStatus tableStatus
+		wantMode   string
+	}{
+		{"on demand", nil, &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}, tableStatusOK, dynamodb.BillingModePayPerRequest},
+		{"legacy provisioned", nil, nil, tableStatusOK, ""},
+		{"migration", []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}, &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}, tableStatusNeedsMigration, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &billingModeDynamoDB{describeOutput: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+				AttributeDefinitions: tc.attrs, BillingModeSummary: tc.mode,
+			}}}}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.NoError(t, err)
+			require.Equal(t, tc.wantStatus, status)
+			require.Equal(t, tc.wantMode, mode)
+		})
+	}
+	t.Run("missing", func(t *testing.T) {
+		b := &Backend{svc: &billingModeDynamoDB{describeErr: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)}}
+		status, mode, err := b.getTableStatus(context.Background(), "test")
+		require.NoError(t, err)
+		require.Equal(t, tableStatus(tableStatusMissing), status)
+		require.Empty(t, mode)
+	})
+}
