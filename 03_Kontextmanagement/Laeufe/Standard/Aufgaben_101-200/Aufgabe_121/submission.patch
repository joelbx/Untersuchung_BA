@@ -0,0 +1,84 @@
+package ext
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/rego"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestIsAuthMethod(t *testing.T) {
+	methods := []struct {
+		name   string
+		method auth.Method
+	}{
+		{"token", auth.Method_METHOD_TOKEN},
+		{"oidc", auth.Method_METHOD_OIDC},
+		{"kubernetes", auth.Method_METHOD_KUBERNETES},
+		{"k8s", auth.Method_METHOD_KUBERNETES},
+		{"github", auth.Method_METHOD_GITHUB},
+		{"jwt", auth.Method_METHOD_JWT},
+		{"cloud", auth.Method_METHOD_CLOUD},
+	}
+
+	for _, tt := range methods {
+		t.Run(tt.name, func(t *testing.T) {
+			input := ast.MustParseTerm(fmt.Sprintf(`{"authentication": {"method": %d}}`, tt.method))
+			result, err := isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm(tt.name))
+			require.NoError(t, err)
+			require.Equal(t, ast.BooleanTerm(true), result)
+
+			other := ast.MustParseTerm(`{"authentication": {"method": 0}}`)
+			result, err = isAuthMethod(rego.BuiltinContext{}, other, ast.StringTerm(tt.name))
+			require.NoError(t, err)
+			require.Equal(t, ast.BooleanTerm(false), result)
+		})
+	}
+
+	_, err := isAuthMethod(rego.BuiltinContext{}, ast.MustParseTerm(`{}`), ast.StringTerm("token"))
+	require.EqualError(t, err, "no authentication found")
+
+	_, err = isAuthMethod(rego.BuiltinContext{}, ast.MustParseTerm(`{"authentication": {"method": 1}}`), ast.StringTerm("unknown"))
+	require.EqualError(t, err, `unsupported auth method: "unknown"`)
+
+	result, err := isAuthMethod(rego.BuiltinContext{}, ast.MustParseTerm(`{"authentication": {}}`), ast.StringTerm("token"))
+	require.NoError(t, err)
+	require.Equal(t, ast.BooleanTerm(false), result)
+}
+
+func TestIsAuthMethodInPolicy(t *testing.T) {
+	query, err := rego.New(
+		rego.Query(`data.flipt.authz.v1.allow`),
+		rego.Module("policy.rego", `package flipt.authz.v1
+import rego.v1
+default allow = false
+allow if { flipt.is_auth_method(input, "k8s") }`),
+	).PrepareForEval(context.Background())
+	require.NoError(t, err)
+
+	for _, tt := range []struct {
+		method   int
+		expected bool
+	}{{3, true}, {1, false}} {
+		result, err := query.Eval(context.Background(), rego.EvalInput(map[string]any{
+			"authentication": map[string]any{"method": tt.method},
+		}))
+		require.NoError(t, err)
+		require.Equal(t, tt.expected, result[0].Expressions[0].Value)
+	}
+}
+
+func TestIsAuthMethodSignature(t *testing.T) {
+	for _, query := range []string{
+		`flipt.is_auth_method(input)`,
+		`flipt.is_auth_method(input, "token", "extra")`,
+		`flipt.is_auth_method(input, 1)`,
+	} {
+		_, err := rego.New(rego.Query(query)).PrepareForEval(context.Background())
+		require.Error(t, err, query)
+	}
+}
