+@pytest.mark.parametrize('method,args,kwargs', [
+    ('display', ('foo',), {}),
+    ('display', ('foo', 'red'), {'stderr': True}),
+    ('warning', ('foo',), {}),
+    ('warning', ('foo',), {'formatted': True}),
+    ('deprecated', ('foo',), {}),
+    ('deprecated', ('foo',), {'version': '2.18'}),
+])
+def test_Display_proxy_preserves_method_and_arguments(monkeypatch, method, args, kwargs):
+    display = Display()
+    final_q = MagicMock()
+    monkeypatch.setattr(display, '_final_q', final_q)
+
+    getattr(display, method)(*args, **kwargs)
+
+    final_q.send_display.assert_called_once_with(method, *args, **kwargs)
+
+
+def test_FinalQueue_send_display_preserves_method_and_arguments():
+    final_q = MagicMock()
+
+    FinalQueue.send_display(final_q, 'warning', 'foo', formatted=True)
+
+    result = final_q.put.call_args.args[0]
+    assert isinstance(result, DisplaySend)
+    assert result.method == 'warning'
+    assert result.args == ('foo',)
+    assert result.kwargs == {'formatted': True}
+
+
+def test_results_thread_deduplicates_display_messages(monkeypatch):
+    display = Display()
+    output = MagicMock()
+    monkeypatch.setattr(display, '_final_q', None)
+    monkeypatch.setattr(display, '_warns', {})
+    monkeypatch.setattr(display, '_deprecations', {})
+    monkeypatch.setattr(display, 'display', output)
+    final_q = queue.Queue()
+    for _ in range(2):
+        final_q.put(DisplaySend('warning', 'same warning'))
+        final_q.put(DisplaySend('deprecated', 'same deprecation', version='2.18'))
+    final_q.put(StrategySentinel())
+
+    results_thread_main(SimpleNamespace(_final_q=final_q))
+
+    assert output.call_count == 2
+    assert output.call_args_list[0].args[0].startswith('[WARNING]: same warning')
+    assert output.call_args_list[1].args[0].startswith('[DEPRECATION WARNING]: same deprecation')
+
+
+def test_results_thread_dispatches_display(monkeypatch):
+    display = Display()
+    output = MagicMock()
+    monkeypatch.setattr(display, 'display', output)
+    final_q = queue.Queue()
+    final_q.put(DisplaySend('display', 'foo', color='red'))
+    final_q.put(StrategySentinel())
+
+    results_thread_main(SimpleNamespace(_final_q=final_q))
+
+    output.assert_called_once_with('foo', color='red')
+
