+import React from "react";
+import { act } from "react-dom/test-utils";
+// eslint-disable-next-line deprecate/import
+import { mount } from "enzyme";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+import {
+    DEFAULT_PHASE,
+    RegistrationTokenAuthEntry,
+} from "../../../src/components/views/auth/InteractiveAuthEntryComponents";
+import AccessibleButton from "../../../src/components/views/elements/AccessibleButton";
+import Spinner from "../../../src/components/views/elements/Spinner";
+import { flushPromises, getMockClientWithEventEmitter, unmockClientPeg } from "../../test-utils";
+
+describe("registration token interactive auth", () => {
+    const matrixClient = getMockClientWithEventEmitter({
+        generateClientSecret: jest.fn().mockReturnValue("client-secret"),
+    });
+
+    afterAll(() => unmockClientPeg());
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits the advertised %s stage and finishes authentication",
+        async (loginType) => {
+            const response = { user_id: "@user:example.org" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+            const container = document.createElement("div");
+            document.body.appendChild(container);
+            const wrapper = mount(
+                <InteractiveAuth
+                    matrixClient={matrixClient}
+                    authData={{ session: "session-id", flows: [{ stages: [loginType] }] }}
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+                { attachTo: container },
+            );
+
+            expect(wrapper.find(RegistrationTokenAuthEntry)).toHaveLength(1);
+            expect(onStagePhaseChange).toHaveBeenCalledWith(loginType, DEFAULT_PHASE);
+            expect(wrapper.text()).toContain("Enter a registration token provided by the homeserver administrator.");
+            const field = wrapper.find('input[name="registrationTokenField"]');
+            expect(field).toHaveLength(1);
+            expect(wrapper.text()).toContain("Registration token");
+            expect(document.activeElement).toBe(field.getDOMNode());
+            expect(
+                wrapper
+                    .find(AccessibleButton)
+                    .filterWhere((button) => button.prop("kind") === "primary")
+                    .prop("disabled"),
+            ).toBe(true);
+
+            act(() => {
+                field.simulate("change", { target: { value: "my-token" } });
+            });
+            wrapper.update();
+            const button = wrapper.find(AccessibleButton).filterWhere((entry) => entry.prop("kind") === "primary");
+            expect(button.prop("disabled")).toBe(false);
+
+            act(() => {
+                if (loginType === AuthType.RegistrationToken) {
+                    wrapper.find("form").simulate("submit");
+                } else {
+                    button.simulate("click");
+                }
+            });
+            wrapper.update();
+            expect(wrapper.find(Spinner)).toHaveLength(1);
+            expect(
+                wrapper.find(AccessibleButton).filterWhere((entry) => entry.prop("kind") === "primary"),
+            ).toHaveLength(0);
+
+            await flushPromises();
+
+            expect(makeRequest).toHaveBeenCalledTimes(1);
+            expect(makeRequest).toHaveBeenCalledWith({ session: "session-id", type: loginType, token: "my-token" });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            });
+            wrapper.unmount();
+            container.remove();
+        },
+    );
+
+    it("shows errors and prevents submission while busy", () => {
+        const submitAuthDict = jest.fn();
+        const onPhaseChange = jest.fn();
+        const wrapper = mount(
+            <RegistrationTokenAuthEntry
+                matrixClient={matrixClient}
+                loginType={AuthType.RegistrationToken}
+                authSessionId="session-id"
+                busy={false}
+                errorText="Invalid token"
+                onPhaseChange={onPhaseChange}
+                submitAuthDict={submitAuthDict}
+            />,
+        );
+
+        expect(onPhaseChange).toHaveBeenCalledWith(DEFAULT_PHASE);
+        expect(wrapper.find('[role="alert"]').text()).toBe("Invalid token");
+        expect(wrapper.find('[role="alert"]').hasClass("error")).toBe(true);
+
+        act(() => {
+            wrapper.find('input[name="registrationTokenField"]').simulate("change", { target: { value: "my-token" } });
+        });
+        wrapper.setProps({ busy: true });
+        expect(wrapper.find(Spinner)).toHaveLength(1);
+        expect(wrapper.find(AccessibleButton)).toHaveLength(0);
+        wrapper.find("form").simulate("submit");
+        expect(submitAuthDict).not.toHaveBeenCalled();
+        wrapper.unmount();
+    });
+});
