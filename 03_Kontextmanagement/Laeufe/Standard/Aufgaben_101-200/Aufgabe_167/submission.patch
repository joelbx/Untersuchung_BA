diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..79b3db4
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,109 @@
+package oci
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source builds snapshots from a tagged OCI artifact.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if logger == nil || store == nil {
+		return nil, fmt.Errorf("OCI source requires a logger and store")
+	}
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, fmt.Errorf("OCI source poll interval must be positive")
+	}
+	return s, nil
+}
+
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+func (*Source) String() string { return "oci" }
+
+// Get returns the cached snapshot when the manifest content has not changed.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.logger.Debug("fetching OCI snapshot")
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	if response.Matched && s.snapshot != nil {
+		return s.snapshot, nil
+	}
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	s.snapshot = snapshot
+	s.digest = response.Digest
+	return snapshot, nil
+}
+
+// Subscribe sends a snapshot whenever the manifest digest changes.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+
+	s.mu.Lock()
+	previous := s.digest
+	s.mu.Unlock()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				s.logger.Error("failed polling OCI source", zap.Error(err))
+				continue
+			}
+			s.mu.Lock()
+			current := s.digest
+			s.mu.Unlock()
+			if current == previous {
+				continue
+			}
+			select {
+			case ch <- snapshot:
+				previous = current
+				s.logger.Debug("sent OCI snapshot", zap.String("digest", current.String()))
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
