diff --git a/tests/unit/browser/webengine/test_webengine_certificateerror.py b/tests/unit/browser/webengine/test_webengine_certificateerror.py
new file mode 100644
index 0000000..82a6860
--- /dev/null
+++ b/tests/unit/browser/webengine/test_webengine_certificateerror.py
@@ -0,0 +1,40 @@
+"""Tests for WebEngine certificate error wrappers."""
+
+import pytest
+
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+@pytest.mark.parametrize('is_qt6, wrapper_class', [
+    (False, certificateerror.CertificateErrorWrapperQt5),
+    (True, certificateerror.CertificateErrorWrapperQt6),
+])
+def test_factory_and_decisions(mocker, monkeypatch, is_qt6, wrapper_class):
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', is_qt6)
+    error = mocker.Mock()
+    error.errorDescription.return_value = 'certificate <error>'
+    wrapper = certificateerror.create(error)
+
+    assert isinstance(wrapper, wrapper_class)
+    assert wrapper.html() == '<p>certificate &lt;error&gt;</p>'
+    assert not wrapper.certificate_was_accepted()
+
+    if is_qt6:
+        wrapper.defer()
+        error.defer.assert_called_once_with()
+    else:
+        with pytest.raises(usertypes.UndeferrableError):
+            wrapper.defer()
+
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+
+    if is_qt6:
+        error.acceptCertificate.assert_called_once_with()
+        error.rejectCertificate.assert_called_once_with()
+    else:
+        error.acceptCertificate.assert_not_called()
+        error.rejectCertificate.assert_not_called()
diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..f4e915d 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -71,3 +71,35 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+def test_named_reply_and_decision(mocker):
+    reply = mocker.Mock()
+    error = FakeError('A&B "quoted" <tag>')
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[error])
+
+    reply.assert_not_called()
+    reply.ignoreSslErrors.assert_not_called()
+    assert wrapper.html() == '<p>A&amp;B &quot;quoted&quot; &lt;tag&gt;</p>'
+    assert not wrapper.certificate_was_accepted()
+
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
+    assert wrapper.certificate_was_accepted()
+
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+
+
+def test_multiple_errors_escape_ampersand_and_quotes():
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=None, errors=[FakeError('A&B'), FakeError('"quoted"')])
+    lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
+    assert lines == ['<ul>', '<li>A&amp;B</li>',
+                     '<li>&#34;quoted&#34;</li>', '</ul>']
+
+
+def test_errors_keyword_without_reply():
+    wrapper = certificateerror.CertificateErrorWrapper(errors=[FakeError('ok')])
+    assert wrapper.html() == '<p>ok</p>'
