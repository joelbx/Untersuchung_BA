diff --git a/openlibrary/coverstore/tests/test_archive.py b/openlibrary/coverstore/tests/test_archive.py
new file mode 100644
index 0000000..283dcdb
--- /dev/null
+++ b/openlibrary/coverstore/tests/test_archive.py
@@ -0,0 +1,69 @@
+from pathlib import Path
+import zipfile
+
+import pytest
+
+from .. import archive, config, coverlib
+
+
+def test_archive_paths_and_url():
+    assert archive.Cover.id_to_item_and_batch_id(8_819_999) == ('0008', '81')
+    assert archive.Batch(8, 81)._norm_ids() == ('0008', '81')
+    assert archive.Batch.get_relpath(8, 81, 's') == (
+        'items/s_covers_0008/s_covers_0008_81.zip'
+    )
+    assert archive.Cover.get_cover_url(8_819_999, 'm') == (
+        'https://archive.org/download/m_covers_0008/'
+        'm_covers_0008_81.zip/0008819999-M.jpg'
+    )
+    assert archive.CoverDB._get_batch_end_id(8_810_001) == 8_819_999
+
+
+def test_zip_manager_deduplicates_and_staged_cover_is_readable(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    source = tmp_path / 'image.jpg'
+    source.write_bytes(b'image')
+    manager = archive.ZipManager()
+    reference = manager.add_file('0008819999-S.jpg', str(source), 1_700_000_000)
+    assert manager.add_file('0008819999-S.jpg', str(source), 1_700_000_000) == reference
+    manager.close()
+    with zipfile.ZipFile(archive.Batch.get_abspath(8, 81, 's')) as z:
+        assert z.namelist() == ['0008819999-S.jpg']
+        assert z.getinfo('0008819999-S.jpg').compress_type == zipfile.ZIP_STORED
+    assert archive.count_files_in_zip(archive.Batch.get_abspath(8, 81, 's')) == 1
+    assert coverlib.read_file(coverlib.find_image_path(reference)) == b'image'
+
+
+def test_finalize_requires_all_remote_sizes(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+
+    class Uploader:
+        def is_uploaded(self, item, filename):
+            return not item.startswith('m_')
+
+    with pytest.raises(RuntimeError, match='upload not verified'):
+        archive.Batch(8, 81).process_pending(finalize=True, uploader=Uploader())
+
+
+def test_verified_batch_finalizes_and_removes_staged_zips(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    completed = []
+    monkeypatch.setattr(
+        archive.CoverDB, 'update_completed_batch',
+        lambda item, batch: completed.append((item, batch)),
+    )
+    for size in archive.SIZES:
+        path = archive.Batch.get_abspath(8, 81, size)
+        Path(path).parent.mkdir(parents=True, exist_ok=True)
+        Path(path).write_bytes(b'zip')
+
+    class Uploader:
+        def is_uploaded(self, item, filename):
+            return True
+
+    archive.Batch(8, 81).process_pending(finalize=True, uploader=Uploader())
+    assert completed == [('0008', '81')]
+    assert all(
+        not Path(archive.Batch.get_abspath(8, 81, size)).exists()
+        for size in archive.SIZES
+    )
