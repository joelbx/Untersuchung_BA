+class Cover:
+    def __init__(self, attributes):
+        self.__dict__.update(dict(attributes))
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        cover_id = int(cover_id)
+        if not 0 <= cover_id < 10**10:
+            raise ValueError('cover ID must fit in ten digits')
+        digits = f'{cover_id:010d}'
+        return digits[:4], digits[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        size = _size(size)
+        if protocol not in ('http', 'https'):
+            raise ValueError('protocol must be http or https')
+        ext = ext.lstrip('.')
+        if not re.fullmatch(r'[a-zA-Z0-9]+', ext):
+            raise ValueError('invalid extension')
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f'{size}_' if size else ''
+        suffix = f'-{size.upper()}' if size else ''
+        digits = f'{int(cover_id):010d}'
+        return (f'{protocol}://archive.org/download/{prefix}covers_{item_id}/'
+                f'{prefix}covers_{item_id}_{batch_id}.zip/{digits}{suffix}.{ext}')
+
+    def files(self):
+        for size in SIZES:
+            field = f'filename_{size}' if size else 'filename'
+            filename = getattr(self, field, None)
+            if filename:
+                yield size, field, os.path.join(config.data_root, 'localdisk', filename)
+
+    def valid_files(self):
+        files = list(self.files())
+        return len(files) == len(SIZES) and all(os.path.isfile(p) for _, _, p in files)
+
+    def delete_files(self):
+        for _, _, path in self.files():
+            os.remove(path)
