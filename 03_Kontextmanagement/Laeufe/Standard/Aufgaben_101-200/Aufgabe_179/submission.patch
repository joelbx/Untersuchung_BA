+func (s *TLSSuite) TestRemoteClusterHeartbeatAfterTunnelRemoval(c *check.C) {
+	auth := s.server.Auth()
+	name := "heartbeat.example.com"
+	rc, err := services.NewRemoteCluster(name)
+	c.Assert(err, check.IsNil)
+	c.Assert(auth.Presence.CreateRemoteCluster(rc), check.IsNil)
+
+	checkCluster := func(status string, heartbeat time.Time) {
+		cluster, err := auth.GetRemoteCluster(name)
+		c.Assert(err, check.IsNil)
+		c.Assert(cluster.GetConnectionStatus(), check.Equals, status)
+		c.Assert(cluster.GetLastHeartbeat().Equal(heartbeat), check.Equals, true)
+		stored, err := auth.Presence.GetRemoteCluster(name)
+		c.Assert(err, check.IsNil)
+		c.Assert(stored.GetConnectionStatus(), check.Equals, status)
+		c.Assert(stored.GetLastHeartbeat().Equal(heartbeat), check.Equals, true)
+	}
+
+	checkCluster(teleport.RemoteClusterStatusOffline, time.Time{})
+	firstHeartbeat := s.server.Clock().Now().Add(-2 * time.Second).UTC()
+	first, err := services.NewTunnelConnection("first", services.TunnelConnectionSpecV2{
+		ClusterName: name, ProxyName: "proxy", LastHeartbeat: firstHeartbeat,
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(auth.Presence.UpsertTunnelConnection(first), check.IsNil)
+	checkCluster(teleport.RemoteClusterStatusOnline, firstHeartbeat)
+	firstHeartbeat = firstHeartbeat.Add(time.Second)
+	first.SetLastHeartbeat(firstHeartbeat)
+	c.Assert(auth.Presence.UpsertTunnelConnection(first), check.IsNil)
+	checkCluster(teleport.RemoteClusterStatusOnline, firstHeartbeat)
+
+	latestHeartbeat := s.server.Clock().Now().UTC()
+	latest, err := services.NewTunnelConnection("latest", services.TunnelConnectionSpecV2{
+		ClusterName: name, ProxyName: "proxy", LastHeartbeat: latestHeartbeat,
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(auth.Presence.UpsertTunnelConnection(latest), check.IsNil)
+	checkCluster(teleport.RemoteClusterStatusOnline, latestHeartbeat)
+
+	c.Assert(auth.Presence.DeleteTunnelConnection(name, latest.GetName()), check.IsNil)
+	checkCluster(teleport.RemoteClusterStatusOnline, latestHeartbeat)
+	c.Assert(auth.Presence.DeleteTunnelConnection(name, first.GetName()), check.IsNil)
+	checkCluster(teleport.RemoteClusterStatusOffline, latestHeartbeat)
+	clusters, err := auth.GetRemoteClusters()
+	c.Assert(err, check.IsNil)
+	c.Assert(clusters, check.HasLen, 1)
+	c.Assert(clusters[0].GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOffline)
+	c.Assert(clusters[0].GetLastHeartbeat().Equal(latestHeartbeat), check.Equals, true)
+}
