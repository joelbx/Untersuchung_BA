+class TestSanitizeKeys(unittest.TestCase):
+    def test_nested_keys_and_ignored_keys(self):
+        from collections import OrderedDict
+        import datetime
+        stamp = datetime.datetime(2020, 1, 1)
+        original = OrderedDict((('password', [{'db-password': 'secret', 'changed': 1}]),
+                                ('_ansible_password', {'x-password': stamp}),
+                                ('password_hint', 'password')))
+        result = sanitize_keys(original, (b'password',), frozenset(('changed',)))
+        self.assertIsInstance(result, OrderedDict)
+        self.assertEqual(result['VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'][0]['db-********'], 'secret')
+        self.assertEqual(result['_ansible_password']['x-********'], stamp)
+        self.assertEqual(result['********_hint'], 'password')
+        self.assertEqual(list(original), ['password', '_ansible_password', 'password_hint'])
+
+    def test_non_mapping_is_unchanged(self):
+        for value in ('password', ['password'], {'password'}, None, True):
+            self.assertIs(sanitize_keys(value, ('password',)), value)
+
+    def test_ignore_is_exact_and_binary_terms_work(self):
+        source = {'changed': 'unchanged', 'changed-password': b'password',
+                  b'password': 4, '_ansible_password': 5}
+        result = sanitize_keys(source, (term for term in (b'password', b'changed')),
+                               frozenset(('changed',)))
+        self.assertEqual(result['changed'], 'unchanged')
+        self.assertEqual(result['********-********'], b'password')
+        self.assertEqual(result['VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'], 4)
+        self.assertEqual(result['_ansible_password'], 5)
+
+    def test_deep_mapping(self):
+        value = {'password': 1}
+        for _ in range(1200):
+            value = {'nested': [value]}
+        result = sanitize_keys(value, ('password',))
+        for _ in range(1200):
+            result = result['nested'][0]
+        self.assertEqual(result, {'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 1})
+
+    def test_remove_values_keeps_types_and_scalars(self):
+        import datetime
+        from collections import defaultdict
+        stamp = datetime.date(2020, 1, 1)
+        value = defaultdict(list, {'password': ('password-password', stamp, 123, None)})
+        result = remove_values(value, (b'password',))
+        self.assertIsInstance(result, defaultdict)
+        self.assertIs(result.default_factory, list)
+        self.assertEqual(result['password'], ('********-********', stamp, 123, None))
