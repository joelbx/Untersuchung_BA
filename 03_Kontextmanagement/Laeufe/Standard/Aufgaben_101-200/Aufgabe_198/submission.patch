+		{constant.Amazon, "ALAS", ""},
+		{constant.Fedora, "FEDORA", ""},
+		{constant.RedHat, "", ""},
+	}
+	for _, tt := range tests {
+		advisory := (RedHatBase{Base: Base{family: tt.family}}).convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
