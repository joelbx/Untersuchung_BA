+func TestImportNestedMetadataAndNamespace(t *testing.T) {
+	const yamlInput = `# exported flags
+version: "1.4"
+namespace:
+  key: team
+  name: Team Flags
+  description: Team namespace
+flags:
+  - key: feature
+    enabled: true
+    metadata:
+      config:
+        regions: [east, west]
+        options:
+          active: true
+      count: 3
+    variants:
+      - key: variant
+        default: true
+        attachment:
+          config:
+            regions: [east, west]
+`
+	const jsonInput = `{"version":"1.4","namespace":{"key":"team","name":"Team Flags","description":"Team namespace"},"flags":[{"key":"feature","enabled":true,"metadata":{"config":{"regions":["east","west"],"options":{"active":true}},"count":3},"variants":[{"key":"variant","default":true,"attachment":{"config":{"regions":["east","west"]}}}]}]}`
+
+	for _, tc := range []struct {
+		name     string
+		encoding Encoding
+		input    string
+	}{
+		{"yaml", EncodingYAML, yamlInput},
+		{"yml", EncodingYML, yamlInput},
+		{"json", EncodingJSON, jsonInput},
+		{"json with header", EncodingJSON, "# exported flags\n" + jsonInput},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.encoding, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team Flags", Description: "Team namespace"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{
+				"config": map[string]any{
+					"regions": []any{"east", "west"},
+					"options": map[string]any{"active": true},
+				},
+				"count": float64(3),
+			}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"config":{"regions":["east","west"]}}`, creator.variantReqs[0].Attachment)
+			require.Len(t, creator.updateFlagReqs, 1)
+			assert.Equal(t, creator.createflagReqs[0].Metadata, creator.updateFlagReqs[0].Metadata)
+		})
+	}
+}
+
+func TestImportJSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		"# first\n# second\n{}",
+		"  # first\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.Error(t, err)
+	}
+}
