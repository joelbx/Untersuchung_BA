+@pytest.mark.parametrize('am, stdin', [({'mode': {'type': 'raw'}}, {})], indirect=['am', 'stdin'])
+def test_created_files_warn_when_mode_omitted(atomic_am, atomic_mocks, isolated_warnings, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_mocks['umask'].side_effect = [18, 0, 18, 0]
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src1', '/path/to/dest1')
+    atomic_am.atomic_move('/path/to/src2', '/path/to/dest2')
+
+    assert atomic_am._created_files == {'/path/to/dest1', '/path/to/dest2'}
+    with pytest.raises(SystemExit):
+        atomic_am.exit_json()
+    output = json.loads(capfd.readouterr()[0])
+    assert output['warnings'] == [
+        "File '%s' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." % path
+        for path in ('/path/to/dest1', '/path/to/dest2')
+    ]
+
+
+@pytest.mark.parametrize('am, stdin', [({'mode': {'type': 'raw'}}, {})], indirect=['am', 'stdin'])
+def test_setting_mode_removes_created_file_warning(atomic_am, atomic_mocks, isolated_warnings, mocker, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    mocker.patch('os.lstat', return_value=mocker.Mock(st_mode=0o600))
+
+    atomic_am.set_mode_if_different(b'/path/to/dest', '0600', False)
+
+    assert not atomic_am._created_files
+    with pytest.raises(SystemExit):
+        atomic_am.exit_json()
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
+
+
+@pytest.mark.parametrize('am, stdin', [({'mode': {'type': 'raw'}}, {'mode': '0640'})], indirect=['am', 'stdin'])
+def test_explicit_mode_does_not_warn(atomic_am, atomic_mocks, isolated_warnings, capfd):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+
+    assert not atomic_am._created_files
+    with pytest.raises(SystemExit):
+        atomic_am.exit_json()
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
+
