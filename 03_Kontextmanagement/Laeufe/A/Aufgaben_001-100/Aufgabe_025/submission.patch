+func TestLoadEnvironmentReferences(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yml")
+	err := os.WriteFile(path, []byte(`log:
+  level: "${FLIPT_TEST_LOG_LEVEL}"
+  encoding: "${FLIPT_TEST_LOG_ENCODING}"
+server:
+  http_port: "${FLIPT_TEST_HTTP_PORT}"
+  grpc_port: 9001
+`), 0600)
+	require.NoError(t, err)
+
+	t.Setenv("FLIPT_TEST_LOG_LEVEL", "DEBUG")
+	t.Setenv("FLIPT_TEST_LOG_ENCODING", "json")
+	t.Setenv("FLIPT_TEST_HTTP_PORT", "8180")
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, "DEBUG", result.Config.Log.Level)
+	assert.Equal(t, LogEncodingJSON, result.Config.Log.Encoding)
+	assert.Equal(t, 8180, result.Config.Server.HTTPPort)
+	assert.Equal(t, 9001, result.Config.Server.GRPCPort)
+
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+	t.Setenv("FLIPT_LOG_ENCODING", "console")
+	result, err = Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8181, result.Config.Server.HTTPPort)
+	assert.Equal(t, LogEncodingConsole, result.Config.Log.Encoding)
+}
+
+func TestLoadEnvironmentReferencesLeaveOtherValuesUnchanged(t *testing.T) {
+	const missing = "FLIPT_TEST_UNSET_REFERENCE_790B4D"
+	previous, existed := os.LookupEnv(missing)
+	require.NoError(t, os.Unsetenv(missing))
+	t.Cleanup(func() {
+		if existed {
+			_ = os.Setenv(missing, previous)
+		}
+	})
+
+	path := filepath.Join(t.TempDir(), "config.yml")
+	err := os.WriteFile(path, []byte(`log:
+  level: "prefix${FLIPT_TEST_LOG_LEVEL}"
+  grpc_level: "${9INVALID}"
+  file: "${FLIPT_TEST_UNSET_REFERENCE_790B4D}"
+server:
+  grpc_port: 9001
+`), 0600)
+	require.NoError(t, err)
+	t.Setenv("FLIPT_TEST_LOG_LEVEL", "DEBUG")
+	t.Setenv("9INVALID", "ERROR")
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, "prefix${FLIPT_TEST_LOG_LEVEL}", result.Config.Log.Level)
+	assert.Equal(t, "${9INVALID}", result.Config.Log.GRPCLevel)
+	assert.Equal(t, "${FLIPT_TEST_UNSET_REFERENCE_790B4D}", result.Config.Log.File)
+	assert.Equal(t, 9001, result.Config.Server.GRPCPort)
+}
