diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..b3f5671 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,4 +1,5 @@
 from openlibrary.plugins.openlibrary import lists
+import web
 
 
 def test_process_seeds():
@@ -11,3 +12,44 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_post_body_ignores_query(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'name=Body+name&description=Body+description&seeds--0--key=%2Fbooks%2FOL1M&seeds--1--other=ignored&seeds--2--key=',
+    )
+    monkeypatch.setattr(web, 'input', lambda **kwargs: (_ for _ in ()).throw(AssertionError('query read')))
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'Body name'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/books/OL1M'}]
+
+
+def test_list_record_post_first_value_and_defaults(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'name=first&name=second&seeds=OL1M%2COL2M')
+    monkeypatch.setattr(web, 'input', lambda **kwargs: (_ for _ in ()).throw(AssertionError('query read')))
+
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'first'
+    assert record.description == ''
+    assert record.seeds == [{'key': '/books/OL1M'}, {'key': '/books/OL2M'}]
+
+
+def test_list_record_query_when_body_empty(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: web.storage({**defaults, 'name': 'Query name', 'seeds--0--key': '/books/OL1M'}),
+    )
+
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'Query name'
+    assert record.seeds == [{'key': '/books/OL1M'}]
