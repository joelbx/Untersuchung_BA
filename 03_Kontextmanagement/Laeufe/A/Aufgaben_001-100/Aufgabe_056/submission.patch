+const getAppleSafariVersion = () => {
+    const { name, version } = getBrowser();
+    const { name: osName } = getOS();
+
+    if ((osName === 'Mac OS' || osName === 'iOS') && (name === 'Safari' || name === 'Mobile Safari')) {
+        return version;
+    }
+};
+
+export const isHEICSupported = () => {
+    const version = getAppleSafariVersion();
+    return !!version && new Version(version).isGreaterThanOrEqual('17');
+};
+
+export const isJXLSupported = () => {
+    const version = getAppleSafariVersion();
+    return !!version && new Version(version).isGreaterThanOrEqual('17');
+};
