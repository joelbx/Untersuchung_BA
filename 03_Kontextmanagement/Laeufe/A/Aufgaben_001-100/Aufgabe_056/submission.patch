diff --git a/packages/shared/test/helpers/mimetype.spec.ts b/packages/shared/test/helpers/mimetype.spec.ts
new file mode 100644
index 0000000..95a217d
--- /dev/null
+++ b/packages/shared/test/helpers/mimetype.spec.ts
@@ -0,0 +1,50 @@
+import { SupportedMimeTypes } from '../../lib/drive/constants';
+import * as browser from '../../lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '../../lib/helpers/mimetype';
+
+describe('modern image support', () => {
+    const heicTypes = [
+        SupportedMimeTypes.heic,
+        SupportedMimeTypes.heics,
+        SupportedMimeTypes.heif,
+        SupportedMimeTypes.heifs,
+    ];
+
+    const checkSupport = (supported: boolean) => {
+        expect(isHEICSupported()).toBe(supported);
+        expect(isJXLSupported()).toBe(supported);
+        heicTypes.forEach((type) => expect(isSupportedImage(type)).toBe(supported));
+        expect(isSupportedImage(SupportedMimeTypes.jxl)).toBe(supported);
+    };
+
+    it('supports Safari 17 and newer on macOS and iOS', () => {
+        const currentBrowser = spyOn(browser, 'getBrowser').and.returnValue({
+            name: 'Safari',
+            version: '17.0',
+            major: '17',
+        });
+        const os = spyOn(browser, 'getOS').and.returnValue({ name: 'Mac OS', version: '14.0' });
+        checkSupport(true);
+
+        os.and.returnValue({ name: 'iOS', version: '17.0' });
+        currentBrowser.and.returnValue({ name: 'Mobile Safari', version: '17.0', major: '17' });
+        checkSupport(true);
+    });
+
+    it('does not support older Safari or other browsers and operating systems', () => {
+        const currentBrowser = spyOn(browser, 'getBrowser').and.returnValue({
+            name: 'Safari',
+            version: '16.6',
+            major: '16',
+        });
+        const os = spyOn(browser, 'getOS').and.returnValue({ name: 'Mac OS', version: '14.0' });
+        checkSupport(false);
+
+        currentBrowser.and.returnValue({ name: 'Chrome', version: '120', major: '120' });
+        checkSupport(false);
+
+        currentBrowser.and.returnValue({ name: 'Safari', version: '17.0', major: '17' });
+        os.and.returnValue({ name: 'Windows', version: '11' });
+        checkSupport(false);
+    });
+});
