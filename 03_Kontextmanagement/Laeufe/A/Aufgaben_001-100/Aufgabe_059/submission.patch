+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes and its host ref while keeping children accessible', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole, getByTestId } = render(
+            <Dialog ref={ref} open aria-label="Example dialog" data-testid="dialog-host" data-example="value">
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example dialog' });
+        expect(host).toBe(getByTestId('dialog-host'));
+        expect(host).toHaveAttribute('data-example', 'value');
+        expect(host).toHaveAttribute('open');
+        expect(ref.current).toBe(host);
+        expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
new file mode 100644
index 0000000..7231219
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,31 @@
+import { HTMLAttributes, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ open, ...rest }, ref) => {
+    const nativeDialogSupported =
+        typeof HTMLDialogElement !== 'undefined' &&
+        typeof HTMLDialogElement.prototype.showModal === 'function' &&
+        typeof HTMLDialogElement.prototype.close === 'function';
+
+    if (nativeDialogSupported) {
+        return <dialog {...rest} open={open} ref={ref} />;
+    }
+
+    const fallbackProps = rest as unknown as HTMLAttributes<HTMLDivElement>;
+
+    return (
+        <div
+            role="dialog"
+            {...fallbackProps}
+            {...(open ? { open: true } : {})}
+            ref={ref as React.Ref<HTMLDivElement>}
+        />
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
