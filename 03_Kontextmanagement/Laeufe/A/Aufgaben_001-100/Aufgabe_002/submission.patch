+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  ProxyConfig
+		want string
+	}{
+		{"kube public address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:8443"}}}, PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}}}, "https://kube.example.com:3026"},
+		{"generic public address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}}}, "https://web.example.com:3026"},
+		{"skip invalid address", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "bad host:3080"}, {Addr: "good.example.com:3080"}}}, "https://good.example.com:3026"},
+		{"IPv6", ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "[::1]:3080"}}}, "https://[::1]:3026"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.KubeAddr()
+			if err != nil || got != tt.want {
+				t.Fatalf("KubeAddr() = %q, %v; want %q", got, err, tt.want)
+			}
+		})
+	}
+	if _, err := (ProxyConfig{}).KubeAddr(); err == nil {
+		t.Fatal("disabled Kubernetes proxy should return an error")
+	}
+	if _, err := (ProxyConfig{Kube: KubeProxyConfig{Enabled: true}, PublicAddrs: []utils.NetAddr{{Addr: "bad host:3080"}}}).KubeAddr(); err == nil {
+		t.Fatal("invalid public address should return an error")
+	}
