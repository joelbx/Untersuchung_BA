@@ -347,6 +351,37 @@ type ProxyConfig struct {
 	Kube KubeProxyConfig
 }
 
+// KubeAddr returns the public Kubernetes proxy URL.
+func (p ProxyConfig) KubeAddr() (string, error) {
+	if !p.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	for _, addrs := range [][]utils.NetAddr{p.Kube.PublicAddrs, p.PublicAddrs} {
+		for _, addr := range addrs {
+			publicAddr := addr.String()
+			if !strings.Contains(publicAddr, "://") {
+				publicAddr = "https://" + publicAddr
+			}
+			u, err := url.Parse(publicAddr)
+			if err != nil || u.Hostname() == "" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" {
+				continue
+			}
+			if port := u.Port(); port != "" {
+				n, err := strconv.Atoi(port)
+				if err != nil || n < 1 || n > 65535 {
+					continue
+				}
+			}
+			host := u.Hostname()
+			if strings.ContainsAny(host, " \t\r\n") {
+				continue
+			}
+			return (&url.URL{Scheme: "https", Host: net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+		}
+	}
+	return "", trace.BadParameter("no valid public Kubernetes proxy address")
+}
