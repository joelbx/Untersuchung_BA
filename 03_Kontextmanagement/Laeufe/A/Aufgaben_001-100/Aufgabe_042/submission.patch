diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..91656a0
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,44 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+
+const wellKnownController = module.exports;
+
+wellKnownController.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	const suffix = `@${hostname}`;
+	if (typeof resource !== 'string' || !resource.startsWith('acct:') || !resource.endsWith(suffix)) {
+		return res.status(400).json('invalid-resource');
+	}
+
+	const userslug = resource.slice('acct:'.length, -suffix.length);
+	if (!userslug || userslug.includes('@')) {
+		return res.status(400).json('invalid-resource');
+	}
+
+	const canViewUsers = await privileges.global.can('view:users', req.uid || 0);
+	if (!canViewUsers) {
+		return res.status(403).json('not-authorized');
+	}
+
+	const uid = await user.getUidByUserslug(userslug);
+	if (!uid) {
+		return res.status(404).json('not-found');
+	}
+
+	const canonicalSlug = await user.getUserField(uid, 'userslug');
+	const baseUrl = nconf.get('url').replace(/\/$/, '');
+	const profileUrl = `${baseUrl}/user/${encodeURIComponent(canonicalSlug)}`;
+	res.type('application/jrd+json').json({
+		subject: resource,
+		aliases: [
+			`${baseUrl}/uid/${uid}`,
+			profileUrl,
+		],
+		links: [{ rel: 'http://webfinger.net/rel/profile-page', type: 'text/html', href: profileUrl }],
+	});
+};
