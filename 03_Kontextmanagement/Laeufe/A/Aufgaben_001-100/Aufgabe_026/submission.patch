+func TestUbuntuAPIReportDetails(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Ubuntu:    {{Type: Ubuntu, Summary: "Ubuntu summary", Cvss3Severity: "NEGLIGIBLE"}},
+		UbuntuAPI: {{Type: UbuntuAPI, Title: "API title", Summary: "API summary", Cvss3Score: 7.5, Cvss3Severity: "HIGH"}},
+		Nvd:       {{Type: Nvd, Summary: "NVD summary"}},
+	}}
+	if got := v.Titles("en", "ubuntu"); !reflect.DeepEqual(got, []CveContentStr{{Nvd, "NVD summary"}, {Ubuntu, "Ubuntu summary"}, {UbuntuAPI, "API summary"}}) {
+		t.Errorf("titles = %v", got)
+	}
+	if got := v.Summaries("en", "ubuntu"); !reflect.DeepEqual(got, []CveContentStr{{Ubuntu, "Ubuntu summary"}, {UbuntuAPI, "API summary"}, {Nvd, "NVD summary"}}) {
+		t.Errorf("summaries = %v", got)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 || scores[0].Type != UbuntuAPI || scores[0].Value.Score != 7.5 || scores[1].Type != Ubuntu || scores[1].Value.Score != 3.9 {
+		t.Errorf("CVSS v3 scores = %v", scores)
+	}
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("negligible CVSS range = %q", got)
+	}
+}
