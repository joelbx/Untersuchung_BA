+// Package fanoutbuffer provides an ordered, concurrent event buffer with independent cursors.
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+var (
+	// ErrGracePeriodExceeded means an overflow outlived the grace period.
+	ErrGracePeriodExceeded = errors.New("fanout buffer grace period exceeded")
+	// ErrUseOfClosedCursor means the cursor was explicitly closed.
+	ErrUseOfClosedCursor = errors.New("use of closed fanout buffer cursor")
+	// ErrBufferClosed means the owning buffer was closed.
+	ErrBufferClosed = errors.New("fanout buffer closed")
+)
+
+// Config controls the amount of buffered data and how long an overflow is kept.
+type Config struct {
+	Capacity    uint64
+	GracePeriod time.Duration
+	Clock       clockwork.Clock
+}
+
+// SetDefaults fills in unset configuration fields.
+func (c *Config) SetDefaults() {
+	if c.Capacity == 0 {
+		c.Capacity = 64
+	}
+	if c.GracePeriod == 0 {
+		c.GracePeriod = 5 * time.Minute
+	}
+	if c.Clock == nil {
+		c.Clock = clockwork.NewRealClock()
+	}
+}
+
+// Buffer distributes each appended item to every cursor that was active when it was appended.
+// All state, including cursor positions, is protected by mu.
+type Buffer[T any] struct {
+	mu            sync.Mutex
+	cfg           Config
+	ring          []T
+	start         int    // physical index of the oldest ring item
+	used          int    // number of ring items
+	first         uint64 // sequence of the oldest item
+	next          uint64 // sequence assigned to the next append
+	overflow      []T    // items following the ring
+	overflowSince time.Time
+	cursors       map[*Cursor[T]]struct{}
+	changed       chan struct{}
+	closed        bool
+}
+
+// NewBuffer creates a fanout buffer with the provided configuration.
+func NewBuffer[T any](cfg Config) *Buffer[T] {
+	cfg.SetDefaults()
+	return &Buffer[T]{
+		cfg:     cfg,
+		cursors: make(map[*Cursor[T]]struct{}),
+		changed: make(chan struct{}),
+	}
+}
+
+// notify wakes readers. Call while holding mu.
+func (b *Buffer[T]) notify() {
+	close(b.changed)
+	b.changed = make(chan struct{})
+}
+
+// Append adds items in order. Appends to a closed buffer are ignored.
+func (b *Buffer[T]) Append(items ...T) {
+	if len(items) == 0 {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.expireSlow()
+	if len(b.cursors) == 0 {
+		// No cursor can observe these items.
+		b.next += uint64(len(items))
+		b.first = b.next
+		b.clearData()
+		return
+	}
+	for _, item := range items {
+		if b.used < b.capacity() && len(b.overflow) == 0 {
+			if b.ring == nil {
+				b.ring = make([]T, b.capacity())
+			}
+			b.ring[(b.start+b.used)%len(b.ring)] = item
+			b.used++
+		} else {
+			if len(b.overflow) == 0 {
+				b.overflowSince = b.cfg.Clock.Now()
+			}
+			b.overflow = append(b.overflow, item)
+		}
+		b.next++
+	}
+	b.notify()
+}
+
+func (b *Buffer[T]) capacity() int {
+	const maxInt = int(^uint(0) >> 1)
+	if b.cfg.Capacity > uint64(maxInt) {
+		return maxInt
+	}
+	return int(b.cfg.Capacity)
+}
+
+// NewCursor subscribes to items appended from this point onward.
+func (b *Buffer[T]) NewCursor() *Cursor[T] {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	c := &Cursor[T]{buffer: b, next: b.next}
+	if !b.closed {
+		b.cursors[c] = struct{}{}
+	}
+	return c
+}
+
+// Close permanently closes the buffer and wakes all blocked readers.
+func (b *Buffer[T]) Close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.closed = true
+	b.clearData()
+	b.cursors = nil
+	b.notify()
+}
+
+func (b *Buffer[T]) clearData() {
+	clear(b.ring)
+	b.ring = nil
+	b.start, b.used = 0, 0
+	clear(b.overflow)
+	b.overflow = nil
+	b.overflowSince = time.Time{}
+}
+
+// discardSeen releases items consumed by every live cursor, then moves overflow
+// into the ring when space becomes available.
+func (b *Buffer[T]) discardSeen() {
+	minimum := b.next
+	for c := range b.cursors {
+		if c.next < minimum {
+			minimum = c.next
+		}
+	}
+	if minimum > b.first {
+		drop := int(minimum - b.first)
+		if drop > b.used {
+			drop = b.used
+		}
+		for i := 0; i < drop; i++ {
+			var zero T
+			b.ring[(b.start+i)%len(b.ring)] = zero
+		}
+		if b.ring != nil {
+			b.start = (b.start + drop) % len(b.ring)
+		}
+		b.used -= drop
+		b.first += uint64(drop)
+		// The minimum can move beyond the ring in one read. Discard that
+		// already-consumed prefix of overflow before refilling the ring.
+		if minOverflow := int(minimum - b.first); minOverflow > 0 {
+			b.dropOverflow(minOverflow)
+			b.first = minimum
+		}
+	}
+	if len(b.overflow) > 0 && b.used < b.capacity() {
+		move := min(len(b.overflow), b.capacity()-b.used)
+		for i := 0; i < move; i++ {
+			b.ring[(b.start+b.used+i)%len(b.ring)] = b.overflow[i]
+		}
+		b.used += move
+		b.dropOverflow(move)
+	}
+	if len(b.cursors) == 0 {
+		b.clearData()
+		b.first = b.next
+	}
+}
+
+// dropOverflow clears references without repeatedly copying the remaining backlog.
+func (b *Buffer[T]) dropOverflow(n int) {
+	clear(b.overflow[:n])
+	b.overflow = b.overflow[n:]
+	if len(b.overflow) == 0 {
+		b.overflow = nil
+		b.overflowSince = time.Time{}
+	} else if cap(b.overflow) > 4*len(b.overflow) && cap(b.overflow) > 256 {
+		// Release an oversized backing array after most of it has drained.
+		b.overflow = append([]T(nil), b.overflow...)
+	}
+}
+
+// expireSlow removes only cursors that still hold the oldest item after the
+// overflow grace period. Their next read reports the reason for removal.
+func (b *Buffer[T]) expireSlow() {
+	if len(b.overflow) == 0 || b.cfg.Clock.Now().Before(b.overflowSince.Add(b.cfg.GracePeriod)) {
+		return
+	}
+	for len(b.overflow) > 0 && len(b.cursors) > 0 {
+		minimum := b.next
+		for c := range b.cursors {
+			if c.next < minimum {
+				minimum = c.next
+			}
+		}
+		for c := range b.cursors {
+			if c.next == minimum {
+				c.expired = true
+				delete(b.cursors, c)
+			}
+		}
+		b.discardSeen()
+	}
+	b.notify()
+}
+
+// Cursor reads the items appended after its creation at its own pace.
+type Cursor[T any] struct {
+	buffer  *Buffer[T]
+	next    uint64
+	closed  bool
+	expired bool
+}
+
+// TryRead copies available items into out without waiting.
+func (c *Cursor[T]) TryRead(out []T) (int, error) {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return c.tryRead(out)
+}
+
+func (c *Cursor[T]) tryRead(out []T) (int, error) {
+	b := c.buffer
+	if c.closed {
+		return 0, ErrUseOfClosedCursor
+	}
+	if b.closed {
+		return 0, ErrBufferClosed
+	}
+	b.expireSlow()
+	if c.expired {
+		return 0, ErrGracePeriodExceeded
+	}
+	if len(out) == 0 || c.next == b.next {
+		return 0, nil
+	}
+	n := min(len(out), int(b.next-c.next))
+	for i := 0; i < n; i++ {
+		index := c.next - b.first + uint64(i)
+		if index < uint64(b.used) {
+			out[i] = b.ring[(b.start+int(index))%len(b.ring)]
+		} else {
+			out[i] = b.overflow[int(index)-b.used]
+		}
+	}
+	c.next += uint64(n)
+	b.discardSeen()
+	return n, nil
+}
+
+// Read waits for at least one item, cancellation, or closure.
+func (c *Cursor[T]) Read(ctx context.Context, out []T) (int, error) {
+	for {
+		b := c.buffer
+		b.mu.Lock()
+		n, err := c.tryRead(out)
+		if n != 0 || err != nil || len(out) == 0 {
+			b.mu.Unlock()
+			return n, err
+		}
+		changed := b.changed
+		b.mu.Unlock()
+		select {
+		case <-changed:
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		}
+	}
+}
+
+// Close releases the cursor. It is safe to call more than once.
+func (c *Cursor[T]) Close() error {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	delete(b.cursors, c)
+	if !b.closed {
+		b.discardSeen()
+	}
+	b.notify()
+	return nil
+}
diff --git a/lib/fanoutbuffer/buffer_test.go b/lib/fanoutbuffer/buffer_test.go
new file mode 100644
index 0000000..00be951
--- /dev/null
+++ b/lib/fanoutbuffer/buffer_test.go
@@ -0,0 +1,165 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestFanoutAndOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	fast, slow := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	out := make([]int, 3)
+	var got []int
+	for len(got) < 5 {
+		n, err := fast.TryRead(out)
+		if err != nil || n == 0 {
+			t.Fatalf("fast read = %d, %v", n, err)
+		}
+		got = append(got, out[:n]...)
+	}
+	if !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+		t.Fatalf("fast items = %v", got)
+	}
+	b.Append(6, 7)
+	got = nil
+	for len(got) < 7 {
+		n, err := slow.TryRead(out)
+		if err != nil || n == 0 {
+			t.Fatalf("slow read = %d, %v", n, err)
+		}
+		got = append(got, out[:n]...)
+	}
+	if !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5, 6, 7}) {
+		t.Fatalf("slow items = %v", got)
+	}
+	if n, err := fast.TryRead(out); n != 2 || err != nil {
+		t.Fatalf("fast final read = %d, %v", n, err)
+	}
+	if b.used != 0 || len(b.overflow) != 0 {
+		t.Fatalf("consumed items retained: ring=%d overflow=%d", b.used, len(b.overflow))
+	}
+	fast.Close()
+	slow.Close()
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 1, GracePeriod: time.Second, Clock: clock})
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2)
+	out := make([]int, 2)
+	if n, err := fast.TryRead(out); n != 2 || err != nil {
+		t.Fatalf("fast read = %d, %v", n, err)
+	}
+	clock.Advance(time.Second)
+	if _, err := slow.TryRead(out); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow cursor error = %v", err)
+	}
+	b.Append(3)
+	if n, err := fast.TryRead(out); n != 1 || err != nil || out[0] != 3 {
+		t.Fatalf("fast cursor after expiration = %d, %v, %v", n, err, out)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[string](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]string, 1)
+		n, err := c.Read(context.Background(), out)
+		if err == nil && (n != 1 || out[0] != "event") {
+			err = errors.New("unexpected read result")
+		}
+		result <- err
+	}()
+	b.Append("event")
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	b.Close()
+	if _, err := c.TryRead(make([]string, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("read after buffer close = %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(make([]string, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("read after cursor close = %v", err)
+	}
+}
+
+func TestReadCancellationAndCursorClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read = %v", err)
+	}
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-result; !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("blocked read after close = %v", err)
+	}
+}
+
+func TestConcurrentReaders(t *testing.T) {
+	const count = 500
+	b := NewBuffer[int](Config{Capacity: count})
+	var wg sync.WaitGroup
+	for i := 0; i < 6; i++ {
+		c := b.NewCursor()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer c.Close()
+			out := make([]int, 7)
+			for expected := 0; expected < count; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, item := range out[:n] {
+					if item != expected {
+						t.Errorf("item = %d, want %d", item, expected)
+						return
+					}
+					expected++
+				}
+			}
+		}()
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
+
+func TestBufferCloseWakesRead(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	b.Close()
+	if err := <-result; !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("blocked read after buffer close = %v", err)
+	}
+}
