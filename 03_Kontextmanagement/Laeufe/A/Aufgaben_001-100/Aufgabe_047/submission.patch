diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..e49c4c3 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,45 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the same hash when a previous seed is set again", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("id", "first")
+		original := hashFunc("id", input)
+		Expect(hashFunc("id", input)).To(Equal(original))
+
+		h.SetSeed("id", "second")
+		Expect(hashFunc("id", input)).NotTo(Equal(original))
+
+		h.SetSeed("id", "first")
+		Expect(hashFunc("id", input)).To(Equal(original))
+	})
+
+	It("initializes a seed for an unseen id and keeps it stable", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		original := hashFunc("new", input)
+		Expect(hashFunc("new", input)).To(Equal(original))
+		h.Reseed("new")
+		Expect(hashFunc("new", input)).NotTo(Equal(original))
+	})
+
+	It("sets a seed through the package function", func() {
+		const id = "set-seed-test"
+		hasher.SetSeed(id, "first")
+		original := hasher.HashFunc()(id, input)
+		hasher.SetSeed(id, "second")
+		Expect(hasher.HashFunc()(id, input)).NotTo(Equal(original))
+		hasher.SetSeed(id, "first")
+		Expect(hasher.HashFunc()(id, input)).To(Equal(original))
+	})
+
+	It("uses the same hash for the same id and seed in separate hashers", func() {
+		first := hasher.NewHasher()
+		second := hasher.NewHasher()
+		first.SetSeed("id", "shared")
+		second.SetSeed("id", "shared")
+		Expect(first.HashFunc()("id", input)).To(Equal(second.HashFunc()("id", input)))
+	})
 })
