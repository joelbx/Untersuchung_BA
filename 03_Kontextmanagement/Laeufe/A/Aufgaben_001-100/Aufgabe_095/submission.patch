+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Format a check-in date at the precision supplied by the caller."""
+    result = f'{year:04d}'
+    if month is not None:
+        result += f'-{month:02d}'
+        if day is not None:
+            result += f'-{day:02d}'
+    return result
+
