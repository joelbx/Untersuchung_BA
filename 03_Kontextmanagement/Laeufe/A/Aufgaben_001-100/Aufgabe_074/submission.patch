+    )
+    def test_optional_typed_list_option(self, annotation, values, expected):
+        def fn(files=None, count: int = 0):
+            return files, count
+
+        fn.__annotations__['files'] = annotation
+        cli = FnToCLI(fn)
+        cli.parse_args(['--files', *values, '--count', '3'])
+        assert cli.run() == (expected, 3)
