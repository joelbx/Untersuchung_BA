diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..292e01a
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,63 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r *userPropsRepository) currentUserID() (string, error) {
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return "", errors.New("user is missing from context")
+	}
+	return user.ID, nil
+}
+
+func (r *userPropsRepository) Put(key, value string) error {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	update := Update(r.tableName).Set("value", value).Where(Eq{"user_id": uid, "key": key})
+	count, err := r.executeSQL(update)
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").Values(uid, key, value)
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return "", err
+	}
+	var result struct{ Value string }
+	err = r.queryOne(Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key}), &result)
+	return result.Value, err
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..491ba31
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,51 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserProps Repository", func() {
+	It("keeps keys separate by contextual user and supports updates and deletion", func() {
+		o := orm.NewOrm()
+		_, err := o.Raw(`insert into user (id, user_name, name, email, password, created_at, updated_at)
+			values ('props-user-a', 'props-user-a', '', '', '', datetime('now'), datetime('now')),
+			       ('props-user-b', 'props-user-b', '', '', '', datetime('now'), datetime('now'))`).Exec()
+		Expect(err).ToNot(HaveOccurred())
+
+		ctx := log.NewContext(context.Background())
+		a := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "props-user-a"}), o)
+		b := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "props-user-b"}), o)
+		Expect(a.Put("shared-key", "a")).To(Succeed())
+		_, err = b.Get("shared-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(b.Put("shared-key", "b")).To(Succeed())
+		Expect(a.Put("shared-key", "a-updated")).To(Succeed())
+		value, err := a.Get("shared-key")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("a-updated"))
+		value, err = b.Get("shared-key")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("b"))
+		Expect(a.Delete("shared-key")).To(Succeed())
+		_, err = a.Get("shared-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		value, err = b.Get("shared-key")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("b"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("key", "value")).ToNot(Succeed())
+		_, err := repo.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(repo.Delete("key")).ToNot(Succeed())
+	})
+})
