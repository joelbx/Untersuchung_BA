 from __future__ import absolute_import, division, print_function
 __metaclass__ = type
 
+import gzip
+import io
+from email.message import Message
+
 from ansible.module_utils import urls
 from ansible.module_utils._text import to_native
 
 import pytest
 
 
+@pytest.mark.parametrize('encoded,decompress', [(True, True), (True, False), (False, True), (False, False)])
+def test_open_url_gzip_response(mocker, encoded, decompress):
+    content = b'hello world ' * 100
+    compressed = io.BytesIO()
+    with gzip.GzipFile(fileobj=compressed, mode='wb') as stream:
+        stream.write(content)
+    payload = compressed.getvalue() if encoded else content
+    headers = Message()
+    headers['Content-Length'] = str(len(payload))
+    if encoded:
+        headers['Content-Encoding'] = 'gzip'
+
+    class Response(io.BytesIO):
+        code = 200
+
+        def __init__(self):
+            super(Response, self).__init__(payload)
+            self.headers = headers
+
+        def info(self):
+            return self.headers
+
+        def geturl(self):
+            return 'http://example.com/'
+
+    urlopen = mocker.patch.object(urls.urllib_request, 'urlopen', side_effect=lambda *args: Response())
+    response = urls.open_url('http://example.com/', decompress=decompress)
+    assert response.read() == (content if encoded and decompress else payload)
+    assert response.code == 200
+    assert response.info()['Content-Length'] == str(len(payload))
+    assert urlopen.call_args[0][0].get_header('Accept-encoding') == ('gzip' if decompress else 'identity')
+    response.close()
+
+
+def test_open_url_requires_gzip_when_response_is_encoded(mocker):
+    headers = Message()
+    headers['Content-Encoding'] = 'gzip'
+    response = mocker.Mock(headers=headers)
+    mocker.patch.object(urls.urllib_request, 'urlopen', return_value=response)
+    mocker.patch.object(urls, 'gzip', None)
+    with pytest.raises(urls.MissingModuleError, match='gzip'):
+        urls.open_url('http://example.com/')
+    response.close.assert_called_once_with()
+
+
+def test_request_decompression_and_header_defaults(mocker):
+    headers = Message()
+    headers['Content-Encoding'] = 'gzip'
+    response = mocker.Mock(headers=headers)
+    mocker.patch.object(urls.urllib_request, 'urlopen', return_value=response)
+    request = urls.Request(decompress=False, unredirected_headers=['Authorization'])
+    request.open('GET', 'http://example.com/', headers={'Authorization': 'token', 'Accept-Encoding': 'br'})
+    sent = urls.urllib_request.urlopen.call_args[0][0]
+    assert sent.unredirected_hdrs['Authorization'] == 'token'
+    assert sent.get_header('Accept-encoding') == 'br'
+    assert response.read.call_count == 0
+    assert request.open('GET', 'http://example.com/', decompress=False) is response
+
+
