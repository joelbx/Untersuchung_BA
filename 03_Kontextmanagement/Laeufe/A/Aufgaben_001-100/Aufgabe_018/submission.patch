+func TestStringToStringSliceHookFunc(t *testing.T) {
+	tests := []struct {
+		name string
+		from reflect.Type
+		to   reflect.Type
+		data interface{}
+	}{
+		{"non-string source", reflect.TypeOf([]string{}), reflect.TypeOf([]string{}), []string{"foo.com", "bar.com"}},
+		{"non-string scalar", reflect.TypeOf(42), reflect.TypeOf([]string{}), 42},
+		{"different target", reflect.TypeOf(""), reflect.TypeOf(""), "foo.com bar.com"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := stringToStringSliceHookFunc(tt.from, tt.to, tt.data)
+			require.NoError(t, err)
+			assert.Equal(t, tt.data, got)
+		})
+	}
+
+	got, err := stringToStringSliceHookFunc(reflect.TypeOf(""), reflect.TypeOf([]string{}), "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{}, got)
+}
