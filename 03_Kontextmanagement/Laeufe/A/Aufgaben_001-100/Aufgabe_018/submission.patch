+// stringToStringSliceHookFunc splits scalar string values on whitespace.
+func stringToStringSliceHookFunc(from reflect.Type, to reflect.Type, data interface{}) (interface{}, error) {
+	if from.Kind() != reflect.String || to != reflect.TypeOf([]string{}) {
+		return data, nil
+	}
+
+	return strings.Fields(data.(string)), nil
+}
