 _common_args = ['PowerShell', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Unrestricted']
+_clixml_escape = re.compile(r'_x([0-9a-fA-F]{4})_')
+_clixml_block = re.compile(rb'<Objs(?:\s[^>]*)?>.*?</Objs>', re.DOTALL)
+
+
+def _decode_clixml_text(value: str) -> str:
+    """Decode PowerShell's escaped UTF-16 code units in an S element."""
+    tokens = list(_clixml_escape.finditer(value))
+    result = []
+    position = 0
+    index = 0
+
+    while index < len(tokens):
+        token = tokens[index]
+        result.append(value[position:token.start()])
+        code_unit = int(token.group(1), 16)
+        next_token = tokens[index + 1] if index + 1 < len(tokens) else None
+        adjacent = next_token is not None and token.end() == next_token.start()
+
+        if code_unit == 0x005F and not adjacent:
+            result.append(token.group())
+        elif 0xD800 <= code_unit <= 0xDBFF and adjacent and 0xDC00 <= int(next_token.group(1), 16) <= 0xDFFF:
+            low = int(next_token.group(1), 16)
+            result.append(chr(0x10000 + ((code_unit - 0xD800) << 10) + low - 0xDC00))
+            token = next_token
+            index += 1
+        else:
+            result.append(chr(code_unit))
+
+        position = token.end()
+        index += 1
 
+    result.append(value[position:])
+    return ''.join(result)
 
