+def test_parse_clixml_decodes_utf16_escapes():
+    data = (b'<Objs><S S="Error">_x263A_ _xD83D__xDE00_ _x000D__x000A_'
+            b'_x005f__x000A_ _x005F_ _x005G_ _xD800_</S></Objs>')
+    expected = '☺ 😀 \r\n_\n _x005F_ _x005G_ \ud800'.encode('utf-8', 'surrogatepass')
+    assert _parse_clixml(data) == expected
+
+
+def test_parse_clixml_joins_matching_elements_without_separators():
+    data = (b'<Objs><S S="Error">first</S><S S="Info">skip</S>'
+            b'<S S="Error"/><S S="Error">second</S></Objs>')
+    assert _parse_clixml(data) == b'firstsecond'
+    assert _parse_clixml(data, stream='Info') == b'skip'
+    assert _parse_clixml(data, stream='Warning') == b''
+
+
+def test_parse_clixml_multiple_blocks_ignore_empty_results():
+    data = (b'<Objs><S S="Error"/></Objs><Objs><S S="Error">one</S></Objs>'
+            b'<Objs><S S="Info">skip</S></Objs><Objs><S S="Error">two</S></Objs>')
+    assert _parse_clixml(data) == b'one\r\ntwo'
+    assert _parse_clixml(b'<Objs><S S="Error"/></Objs><Objs/>') == b''
+
