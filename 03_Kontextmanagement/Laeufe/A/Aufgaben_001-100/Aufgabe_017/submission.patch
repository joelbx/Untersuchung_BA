+package database
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/gravitational/trace"
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/gravitational/teleport/lib/srv/db/common"
+	"github.com/gravitational/teleport/lib/srv/db/sqlserver"
+)
+
+func TestSQLServerPing(t *testing.T) {
+	server, err := sqlserver.NewTestServer(common.TestServerConfig{AuthClient: setupMockClient(t)})
+	require.NoError(t, err)
+	go func() { _ = server.Serve() }()
+	t.Cleanup(func() { _ = server.Close() })
+
+	port, err := strconv.Atoi(server.Port())
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	p := &SQLServerPinger{}
+	require.NoError(t, p.Ping(ctx, PingParams{Host: "localhost", Port: port, Username: "someuser", DatabaseName: "somedb"}))
+}
+
+func TestSQLServerPingValidation(t *testing.T) {
+	p := &SQLServerPinger{}
+	for _, params := range []PingParams{
+		{Port: 1433, DatabaseName: "db"},
+		{Port: 1433, Username: "user"},
+		{Port: -1, Username: "user", DatabaseName: "db"},
+	} {
+		require.True(t, trace.IsBadParameter(p.Ping(context.Background(), params)))
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err := p.Ping(ctx, PingParams{Host: "localhost", Port: 1433, Username: "user", DatabaseName: "db"})
+	require.Error(t, err)
+
+	deadlineCtx, cancelDeadline := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer cancelDeadline()
+	err = p.Ping(deadlineCtx, PingParams{Host: "localhost", Port: 1433, Username: "user", DatabaseName: "db"})
+	require.Error(t, err)
+}
+
+func TestSQLServerErrorCategories(t *testing.T) {
+	p := &SQLServerPinger{}
+	for _, tt := range []struct {
+		err                     error
+		refused, userDB, nameDB bool
+	}{
+		{err: nil},
+		{err: trace.Wrap(syscall.ECONNREFUSED), refused: true},
+		{err: trace.Wrap(mssql.Error{Number: 18456}), userDB: true},
+		{err: trace.Wrap(mssql.Error{Number: 4060}), nameDB: true},
+		{err: trace.Wrap(mssql.Error{Number: 911}), nameDB: true},
+		{err: trace.Wrap(mssql.Error{Number: 1234})},
+	} {
+		require.Equal(t, tt.refused, p.IsConnectionRefusedError(tt.err))
+		require.Equal(t, tt.userDB, p.IsInvalidDatabaseUserError(tt.err))
+		require.Equal(t, tt.nameDB, p.IsInvalidDatabaseNameError(tt.err))
+	}
+	require.False(t, p.IsInvalidDatabaseUserError(errors.New("unrelated")))
+}
