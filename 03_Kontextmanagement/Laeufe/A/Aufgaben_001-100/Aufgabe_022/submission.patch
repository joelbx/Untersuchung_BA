 func splitFileName(filename string) (name, ver, rel string, err error) {
+	// An epoch in the source RPM belongs to the version, not the source name.
+	// The package line supplies the epoch separately when building the version.
+	if epoch, rest, ok := strings.Cut(filename, ":"); ok {
+		if n, err := strconv.Atoi(epoch); err == nil && n >= 0 {
+			filename = rest
+		}
+	}
 	filename = strings.TrimSuffix(filename, ".rpm")
 
 	archIndex := strings.LastIndex(filename, ".")
