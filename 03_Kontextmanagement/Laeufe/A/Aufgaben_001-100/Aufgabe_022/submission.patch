+func Test_redhatBase_parseInstalledPackagesContinuesAfterBadSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := bins["elasticsearch"]; got.Name != "elasticsearch" || got.Version != "8.17.0" {
+		t.Errorf("elasticsearch binary package = %+v", got)
+	}
+	if got := bins["bar"]; got.Version != "1:9" {
+		t.Errorf("bar binary package = %+v", got)
+	}
+	if len(srcs) != 1 || srcs["bar"].Version != "1:9-123a" || !reflect.DeepEqual(srcs["bar"].BinaryNames, []string{"bar"}) {
+		t.Errorf("source packages = %+v", srcs)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("warnings = %v", o.warns)
+	}
+}
