@@ -0,0 +1,115 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+type transportFunc func(*http.Request) (*http.Response, error)
+
+func (f transportFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestReporterStateAndReport(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		t.Fatal(err)
+	}
+	firstID := r.state.UUID
+	r, err = NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID != firstID {
+		t.Fatal("host ID changed")
+	}
+	info.Version = "test-version"
+	r.client.Transport = transportFunc(func(req *http.Request) (*http.Response, error) {
+		var got struct {
+			Event       string                 `json:"event"`
+			AnonymousID string                 `json:"anonymousId"`
+			Properties  map[string]interface{} `json:"properties"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got.Event != "flipt.ping" || got.AnonymousID != firstID || got.Properties["uuid"] != firstID || got.Properties["version"] != schemaVersion {
+			t.Fatalf("unexpected event: %+v", got)
+		}
+		flipt, ok := got.Properties["flipt"].(map[string]interface{})
+		if !ok || flipt["version"] != "test-version" {
+			t.Fatalf("unexpected version: %+v", got.Properties)
+		}
+		return &http.Response{StatusCode: http.StatusAccepted, Body: io.NopCloser(strings.NewReader(""))}, nil
+	})
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "telemetry.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved state
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.LastTimestamp == "" || saved.UUID != firstID {
+		t.Fatalf("unexpected state: %+v", saved)
+	}
+	before := saved.LastTimestamp
+	r.client.Transport = transportFunc(func(*http.Request) (*http.Response, error) { return nil, errors.New("offline") })
+	if err := r.Report(context.Background()); err == nil {
+		t.Fatal("expected send error")
+	}
+	data, err = os.ReadFile(filepath.Join(dir, "telemetry.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.LastTimestamp != before {
+		t.Fatal("failed report updated timestamp")
+	}
+}
+
+func TestReporterDisabledAndInvalidDirectory(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	cfg.Meta.TelemetryEnabled = false
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter: %v, %v", r, err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "telemetry.json")); !os.IsNotExist(err) {
+		t.Fatalf("state was created: %v", err)
+	}
+	cfg.Meta.TelemetryEnabled = true
+	path := filepath.Join(dir, "file")
+	if err := os.WriteFile(path, []byte("x"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Meta.StateDirectory = path
+	r, err = NewReporter(cfg, logrus.New())
+	if err == nil || r != nil {
+		t.Fatal("file path should disable reporter")
+	}
+}
