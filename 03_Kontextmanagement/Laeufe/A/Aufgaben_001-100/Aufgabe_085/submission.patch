+func TestDiffStatusesAndPackages(t *testing.T) {
+	current := models.ScanResults{{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"new":  {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"new-pkg": {Name: "new-pkg", Version: "current"}},
+	}}
+	previous := models.ScanResults{{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"old":  {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"old-pkg": {Name: "old-pkg", Version: "previous"}},
+	}}
+	for _, tc := range []struct {
+		plus, minus         bool
+		wantPlus, wantMinus int
+	}{
+		{true, true, 1, 1},
+		{true, false, 1, 0},
+		{false, true, 0, 1},
+		{false, false, 0, 0},
+	} {
+		results, err := diff(current, previous, tc.plus, tc.minus)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := results[0]
+		plus, minus := got.ScannedCves.CountDiff()
+		if plus != tc.wantPlus || minus != tc.wantMinus || len(got.ScannedCves) != plus+minus {
+			t.Errorf("filters (%t, %t): got %d plus, %d minus, %d total", tc.plus, tc.minus, plus, minus, len(got.ScannedCves))
+		}
+		if tc.plus {
+			if got.ScannedCves["new"].DiffStatus != models.DiffPlus || got.Packages["new-pkg"].Version != "current" {
+				t.Errorf("plus entry or package incorrect: %+v", got)
+			}
+		}
+		if tc.minus {
+			if got.ScannedCves["old"].DiffStatus != models.DiffMinus || got.Packages["old-pkg"].Version != "previous" {
+				t.Errorf("minus entry or package incorrect: %+v", got)
+			}
+		}
+	}
+	withoutPrevious, err := diff(current, nil, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if plus, minus := withoutPrevious[0].ScannedCves.CountDiff(); plus != 2 || minus != 0 {
+		t.Errorf("missing previous scan: got %d plus, %d minus", plus, minus)
+	}
+}
