+func TestDiffFormattingAndCount(t *testing.T) {
+	infos := VulnInfos{
+		"new":  {CveID: "new", DiffStatus: DiffPlus},
+		"old":  {CveID: "old", DiffStatus: DiffMinus},
+		"same": {CveID: "same"},
+	}
+	plus, minus := infos.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Errorf("CountDiff() = (%d, %d)", plus, minus)
+	}
+	if got := infos["new"].CveIDDiffFormat(true); got != "+new" {
+		t.Errorf("diff format = %q", got)
+	}
+	if got := infos["old"].CveIDDiffFormat(true); got != "-old" {
+		t.Errorf("diff format = %q", got)
+	}
+	if got := infos["new"].CveIDDiffFormat(false); got != "new" {
+		t.Errorf("plain format = %q", got)
+	}
+}
