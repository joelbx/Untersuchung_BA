+
+// CountDiff counts newly detected and resolved CVEs.
+func (v VulnInfos) CountDiff() (nPlus int, nMinus int) {
+	for _, vuln := range v {
+		switch vuln.DiffStatus {
+		case DiffPlus:
+			nPlus++
+		case DiffMinus:
+			nMinus++
+		}
+	}
+	return
+}
