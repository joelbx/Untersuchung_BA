@@ -0,0 +1,62 @@
+package oidc
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestCallbackURL(t *testing.T) {
+	for _, tc := range []struct{ host, want string }{
+		{"http://localhost:8080", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"http://localhost:8080/", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"https://auth.example.com:8443/", "https://auth.example.com:8443/auth/v1/method/oidc/google/callback"},
+		{"https://auth.example.com//", "https://auth.example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		t.Run(tc.host, func(t *testing.T) {
+			if got := callbackURL(tc.host, "google"); got != tc.want {
+				t.Fatalf("callbackURL() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestMiddlewareCookies(t *testing.T) {
+	for _, tc := range []struct {
+		domain, wantDomain string
+	}{
+		{"localhost", ""},
+		{"auth.example.com", "auth.example.com"},
+	} {
+		t.Run(tc.domain, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{
+				Domain: tc.domain, StateLifetime: time.Minute, TokenLifetime: time.Hour,
+			})
+			w := httptest.NewRecorder()
+			r := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			m.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(w, r)
+			checkCookie(t, w.Result().Cookies(), stateCookieKey, tc.wantDomain, "/auth/v1/method/oidc/google/callback")
+
+			w = httptest.NewRecorder()
+			if err := m.ForwardResponseOption(nil, w, &auth.CallbackResponse{ClientToken: "token"}); err != nil {
+				t.Fatal(err)
+			}
+			checkCookie(t, w.Result().Cookies(), tokenCookieKey, tc.wantDomain, "/")
+		})
+	}
+}
+
+func checkCookie(t *testing.T, cookies []*http.Cookie, name, domain, path string) {
+	t.Helper()
+	if len(cookies) != 1 {
+		t.Fatalf("cookies = %v, want one", cookies)
+	}
+	c := cookies[0]
+	if c.Name != name || c.Domain != domain || c.Path != path {
+		t.Fatalf("cookie = %+v, want name %q, domain %q, path %q", c, name, domain, path)
+	}
+}
