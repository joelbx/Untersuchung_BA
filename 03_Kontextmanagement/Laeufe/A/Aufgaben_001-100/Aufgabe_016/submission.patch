@@ -0,0 +1,116 @@
+"""Collect HAProxy CSV statistics and publish them as Graphite events."""
+
+import asyncio
+import csv
+from dataclasses import dataclass
+import io
+import pickle
+import re
+import socket
+import struct
+import time
+from typing import Iterable, Iterator, Literal
+from urllib.request import urlopen
+
+
+@dataclass(frozen=True)
+class GraphiteEvent:
+    path: str
+    value: float
+    timestamp: int
+
+    def serialize(self) -> tuple[str, tuple[int, float]]:
+        return self.path, (self.timestamp, self.value)
+
+
+@dataclass(frozen=True)
+class HaproxyCapture:
+    pxname: str
+    svname: str
+    field: list[str]
+
+    def matches(self, row: dict) -> bool:
+        return bool(
+            re.fullmatch(self.pxname, row.get("pxname", ""))
+            and re.fullmatch(self.svname, row.get("svname", ""))
+            and any(row.get(field) not in (None, "") for field in self.field)
+        )
+
+    def to_graphite_events(self, prefix: str, row: dict, ts: float) -> Iterator[GraphiteEvent]:
+        if not self.matches(row):
+            return
+        for field in self.field:
+            value = row.get(field)
+            if value not in (None, ""):
+                try:
+                    number = float(value)
+                except (TypeError, ValueError):
+                    continue
+                yield GraphiteEvent(
+                    f"{prefix}.{row['pxname']}.{row['svname']}.{field}", number, int(ts)
+                )
+
+
+TO_CAPTURE = [HaproxyCapture(r".*", r".*", ["scur", "rate", "qcur"])]
+
+
+def fetch_events(haproxy_url: str, prefix: str, ts: float) -> Iterable[GraphiteEvent]:
+    url = haproxy_url if haproxy_url.endswith(";csv") else f"{haproxy_url};csv"
+    with urlopen(url, timeout=10) as response:
+        body = response.read().decode("utf-8")
+    # HAProxy prefixes the header with '# '.
+    if body.startswith("# "):
+        body = body[2:]
+    for row in csv.DictReader(io.StringIO(body)):
+        for capture in TO_CAPTURE:
+            yield from capture.to_graphite_events(prefix, row, ts)
+
+
+def _send_events(address: str, events: list[GraphiteEvent]) -> None:
+    host, port = address.rsplit(":", 1)
+    payload = pickle.dumps([event.serialize() for event in events], protocol=2)
+    with socket.create_connection((host, int(port)), timeout=10) as connection:
+        connection.sendall(struct.pack("!L", len(payload)) + payload)
+
+
+async def main(
+    haproxy_url: str = "http://openlibrary.org/admin?stats",
+    graphite_address: str = "graphite.us.archive.org:2004",
+    prefix: str = "stats.ol.haproxy",
+    dry_run: bool = True,
+    fetch_freq: int = 10,
+    commit_freq: int = 30,
+    agg: Literal["max", "min", "sum", None] = None,
+) -> None:
+    if fetch_freq <= 0 or commit_freq <= 0:
+        raise ValueError("fetch_freq and commit_freq must be positive")
+    if agg not in (None, "max", "min", "sum"):
+        raise ValueError("Unsupported aggregation")
+
+    buffer: list[GraphiteEvent] = []
+    last_commit = time.monotonic()
+    while True:
+        timestamp = time.time()
+        buffer.extend(await asyncio.to_thread(lambda: list(fetch_events(haproxy_url, prefix, timestamp))))
+        if time.monotonic() - last_commit >= commit_freq:
+            if agg is not None:
+                combined: dict[str, GraphiteEvent] = {}
+                for event in buffer:
+                    prior = combined.get(event.path)
+                    if prior is None:
+                        combined[event.path] = event
+                    else:
+                        value = {"max": max, "min": min, "sum": lambda a, b: a + b}[agg](
+                            prior.value, event.value
+                        )
+                        combined[event.path] = GraphiteEvent(event.path, value, event.timestamp)
+                buffer = list(combined.values())
+            if buffer:
+                if dry_run:
+                    for event in buffer:
+                        print(f"{event.path} {event.value} {event.timestamp}", flush=True)
+                else:
+                    await asyncio.to_thread(_send_events, graphite_address, buffer)
+            buffer = []
+            last_commit = time.monotonic()
+        await asyncio.sleep(fetch_freq)
