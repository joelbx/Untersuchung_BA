+def get_service_ip(image_name: str) -> str:
+    """Return the IP address of a running Docker container."""
+    container = image_name.removeprefix("/")
+    if not container.startswith("openlibrary-"):
+        container = f"openlibrary-{container}-1"
+    result = subprocess.run(
+        [
+            "docker", "inspect", "--format",
+            "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}", container,
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    ip = result.stdout.strip()
+    if not ip:
+        raise ValueError(f"No IP address found for {container}")
+    return ip
+
