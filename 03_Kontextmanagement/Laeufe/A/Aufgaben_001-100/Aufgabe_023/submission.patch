diff --git a/internal/config/authentication_database_test.go b/internal/config/authentication_database_test.go
new file mode 100644
index 0000000..5c3eaea
--- /dev/null
+++ b/internal/config/authentication_database_test.go
@@ -0,0 +1,41 @@
+package config
+
+import "testing"
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	schedule := &AuthenticationCleanupSchedule{}
+	var cfg AuthenticationConfig
+
+	for _, info := range cfg.Methods.AllMethods() {
+		want := info.Name() != "jwt"
+		if info.RequiresDatabase != want {
+			t.Errorf("%s RequiresDatabase = %t, want %t", info.Name(), info.RequiresDatabase, want)
+		}
+	}
+
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("disabled authentication methods require neither database nor cleanup")
+	}
+
+	cfg.Required = true
+	cfg.Methods.JWT.Enabled = true
+	cfg.Methods.JWT.Cleanup = schedule
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("JWT-only authentication requires neither database nor cleanup")
+	}
+
+	cfg.Methods.Token.Cleanup = schedule
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("disabled token authentication requires neither database nor cleanup")
+	}
+
+	cfg.Methods.Token.Enabled = true
+	if !cfg.RequiresDatabase() || !cfg.ShouldRunCleanup() {
+		t.Fatal("enabled token authentication requires database and configured cleanup")
+	}
+
+	cfg.Methods.Token.Cleanup = nil
+	if !cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("enabled token authentication requires database but no unconfigured cleanup")
+	}
+}
