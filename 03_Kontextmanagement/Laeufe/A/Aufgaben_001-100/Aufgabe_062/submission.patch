+func TestContextReaderMaybeRestoreTerm(t *testing.T) {
+	cr := NewContextReader(strings.NewReader(""))
+	defer cr.Close()
+	restoreErr := errors.New("restore failed")
+	fake := &fakeTerm{restoreErr: restoreErr}
+	cr.term = fake
+	cr.previousTermState = &term.State{}
+
+	cr.mu.Lock()
+	defer cr.mu.Unlock()
+	require.NoError(t, cr.maybeRestoreTerm()) // Idle readers must not restore.
+	cr.state = readerStatePassword
+	require.ErrorIs(t, cr.maybeRestoreTerm(), restoreErr)
+	require.NotNil(t, cr.previousTermState) // Failed restores can be retried.
+	fake.restoreErr = nil
+	require.NoError(t, cr.maybeRestoreTerm())
+	require.Nil(t, cr.previousTermState)
+	require.NoError(t, cr.maybeRestoreTerm()) // No state to restore twice.
+	require.True(t, fake.restoreCalled)
+}
