 	"sync"
 )
@@ -52,3 +53,13 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so it can restore the terminal
+// if a password read is still active.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(io.Closer); ok {
+		_ = closer.Close()
+	}
+}
