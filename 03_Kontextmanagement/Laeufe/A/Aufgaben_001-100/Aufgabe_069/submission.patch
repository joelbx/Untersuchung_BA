+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		matches []string
+		misses  []string
+	}{
+		{pattern: "foo", matches: []string{"foo"}, misses: []string{"bar", "foobar"}},
+		{pattern: "*", matches: []string{"", "anything"}},
+		{pattern: "foo*bar", matches: []string{"foobar", "foo-middle-bar"}, misses: []string{"foo-bar-extra"}},
+		{pattern: "^fo+$", matches: []string{"fo", "foo"}, misses: []string{"bar", "xfoo"}},
+		{pattern: `{{regexp.match("^fo+$")}}`, matches: []string{"fo", "foo"}, misses: []string{"bar"}},
+		{pattern: `{{regexp.not_match("^fo+$")}}`, matches: []string{"bar"}, misses: []string{"fo", "foo"}},
+		{pattern: `foo-{{regexp.match("bar")}}-baz`, matches: []string{"foo-bar-baz", "foo-xbar-baz"}, misses: []string{"bar", "foo-qux-baz", "foo-bar-baz-extra"}},
+		{pattern: `foo-{{regexp.not_match("^bar$")}}-baz`, matches: []string{"foo-qux-baz"}, misses: []string{"foo-bar-baz", "foo-qux-baz-extra"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, in := range tt.matches {
+				assert.True(t, matcher.Match(in), "pattern %q, input %q", tt.pattern, in)
+			}
+			for _, in := range tt.misses {
+				assert.False(t, matcher.Match(in), "pattern %q, input %q", tt.pattern, in)
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		pattern string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, "unsupported function namespace other, supported namespaces are email and regexp"},
+		{`{{regexp.other("foo")}}`, "unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match."},
+		{`{{email.other("foo")}}`, "unsupported function email.other, supported functions are: email.local"},
+		{`{{regexp.match("[")}}`, "failed parsing regexp \"[\": error parsing regexp: missing closing ]: `[`"},
+		{`{{regexp.match()}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{regexp.match("a", "b")}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{regexp.match(external.foo)}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{email.local()}}`, "email.local expects exactly one string literal argument"},
+		{`{{regexp.match("foo") + regexp.match("bar")}}`, `"regexp.match(\"foo\") + regexp.match(\"bar\")" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{regexp.match("foo")}}{{regexp.match("bar")}}`, `"{{regexp.match(\"foo\")}}{{regexp.match(\"bar\")}}" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{external.foo}}`, `"external.foo" is not a valid matcher expression - no variables and transformations are allowed.`},
+		{`{{email.local(external.foo)}}`, "email.local expects exactly one string literal argument"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			_, err := Match(tt.pattern)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err))
+				assert.Equal(t, tt.message, err.Error())
+			}
+		})
+	}
+	for _, in := range []string{`{{regexp.match("foo")}}`, `prefix-{{regexp.not_match("bar")}}-suffix`} {
+		_, err := Variable(in)
+		if assert.Error(t, err) {
+			assert.Equal(t, "matcher functions (like regexp.match) are not allowed here: "+strconv.Quote(in), err.Error())
+		}
+	}
+}
