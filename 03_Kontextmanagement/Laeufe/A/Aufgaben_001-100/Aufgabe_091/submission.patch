+		var numbers []float64
+		if err := json.Unmarshal([]byte(value), &numbers); err != nil {
+			return invalid()
+		}
+	} else {
+		var strings []string
+		if err := json.Unmarshal([]byte(value), &strings); err != nil {
+			return invalid()
+		}
+	}
+	return nil
