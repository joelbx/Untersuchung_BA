+func TestValidate_ListConstraintValues(t *testing.T) {
+	string100 := "[" + strings.TrimSuffix(strings.Repeat(`"x",`, MAX_JSON_ARRAY_ITEMS), ",") + "]"
+	string101 := "[" + strings.TrimSuffix(strings.Repeat(`"x",`, MAX_JSON_ARRAY_ITEMS+1), ",") + "]"
+	number100 := "[" + strings.TrimSuffix(strings.Repeat("1,", MAX_JSON_ARRAY_ITEMS), ",") + "]"
+	number101 := "[" + strings.TrimSuffix(strings.Repeat("1,", MAX_JSON_ARRAY_ITEMS+1), ",") + "]"
+
+	tests := []struct {
+		name     string
+		typeName ComparisonType
+		value    string
+		wantErr  error
+	}{
+		{"strings valid", ComparisonType_STRING_COMPARISON_TYPE, string100, nil},
+		{"strings too many", ComparisonType_STRING_COMPARISON_TYPE, string101, errors.ErrInvalid(`too many values provided for property "foo" of type string (maximum 100)`)},
+		{"strings wrong type", ComparisonType_STRING_COMPARISON_TYPE, `["x",1]`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"strings null element", ComparisonType_STRING_COMPARISON_TYPE, `[null]`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"strings invalid JSON", ComparisonType_STRING_COMPARISON_TYPE, `oops`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"numbers valid", ComparisonType_NUMBER_COMPARISON_TYPE, number100, nil},
+		{"numbers too many", ComparisonType_NUMBER_COMPARISON_TYPE, number101, errors.ErrInvalid(`too many values provided for property "foo" of type number (maximum 100)`)},
+		{"numbers wrong type", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,"2"]`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+		{"numbers null element", ComparisonType_NUMBER_COMPARISON_TYPE, `[null]`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+		{"numbers invalid JSON", ComparisonType_NUMBER_COMPARISON_TYPE, `oops`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+		{"numbers null array", ComparisonType_NUMBER_COMPARISON_TYPE, `null`, errors.ErrInvalid(`invalid value provided for property "foo" of type number`)},
+	}
+	for _, tc := range tests {
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			t.Run(tc.name+"/"+operator, func(t *testing.T) {
+				create := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: tc.typeName, Operator: operator, Value: tc.value}
+				update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "foo", Type: tc.typeName, Operator: operator, Value: tc.value}
+				assert.Equal(t, tc.wantErr, create.Validate())
+				assert.Equal(t, tc.wantErr, update.Validate())
+			})
+		}
+	}
+	for _, comparisonType := range []ComparisonType{ComparisonType_BOOLEAN_COMPARISON_TYPE, ComparisonType_DATETIME_COMPARISON_TYPE} {
+		create := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: comparisonType, Operator: OpIsOneOf, Value: `[1]`}
+		update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "foo", Type: comparisonType, Operator: OpIsNotOneOf, Value: `[1]`}
+		assert.Error(t, create.Validate())
+		assert.Error(t, update.Validate())
+	}
+}
