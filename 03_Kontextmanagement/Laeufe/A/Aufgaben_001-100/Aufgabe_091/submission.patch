+	invalid := func() error {
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+	}
+
+	var raw []json.RawMessage
+	if err := json.Unmarshal([]byte(value), &raw); err != nil || raw == nil {
+		return invalid()
+	}
+	if len(raw) > MAX_JSON_ARRAY_ITEMS {
