+++ b/internal/ext/ext_test.go
@@ -0,0 +1,139 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type testLister struct{}
+
+func (testLister) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	params := &storage.QueryParams{}
+	for _, opt := range opts {
+		opt(params)
+	}
+	if params.Offset > 0 {
+		return nil, nil
+	}
+	return []*flipt.Flag{{Key: "flag", Name: "Flag", Enabled: true, Variants: []*flipt.Variant{
+		{Id: "variant-id", Key: "complex", Attachment: `{"array":[1,true,null,{"nested":["text",2.5]}],"empty":{}}`},
+		{Id: "other-id", Key: "empty"},
+	}}}, nil
+}
+func (testLister) ListRules(_ context.Context, _ string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return []*flipt.Rule{{Id: "rule-id", SegmentKey: "segment", Rank: 1, Distributions: []*flipt.Distribution{{VariantId: "variant-id", Rollout: 100}}}}, nil
+}
+func (testLister) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	params := &storage.QueryParams{}
+	for _, opt := range opts {
+		opt(params)
+	}
+	if params.Offset > 0 {
+		return nil, nil
+	}
+	return []*flipt.Segment{{Key: "segment", MatchType: flipt.MatchType_ANY_MATCH_TYPE, Constraints: []*flipt.Constraint{{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "region", Operator: "eq", Value: "west"}}}}, nil
+}
+
+type testCreator struct {
+	variants      []*flipt.CreateVariantRequest
+	flags         int
+	segments      int
+	constraints   int
+	rules         int
+	distributions int
+}
+
+func (s *testCreator) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	s.flags++
+	return &flipt.Flag{Key: r.Key}, nil
+}
+func (s *testCreator) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.variants = append(s.variants, r)
+	return &flipt.Variant{Id: r.Key + "-id", Key: r.Key}, nil
+}
+func (s *testCreator) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s.segments++
+	return &flipt.Segment{Key: r.Key}, nil
+}
+func (s *testCreator) CreateConstraint(_ context.Context, _ *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.constraints++
+	return &flipt.Constraint{}, nil
+}
+func (s *testCreator) CreateRule(_ context.Context, _ *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	s.rules++
+	return &flipt.Rule{Id: "rule-id"}, nil
+}
+func (s *testCreator) CreateDistribution(_ context.Context, _ *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.distributions++
+	return &flipt.Distribution{}, nil
+}
+
+func TestExportImportAttachments(t *testing.T) {
+	ctx := context.Background()
+	var out bytes.Buffer
+	if err := NewExporter(testLister{}).Export(ctx, &out); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if len(doc.Flags) != 1 || len(doc.Flags[0].Variants) != 2 || len(doc.Segments) != 1 || doc.Segments[0].MatchType != "ANY_MATCH_TYPE" {
+		t.Fatalf("incomplete export: %s", out.String())
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil {
+		t.Fatalf("empty attachment exported: %s", out.String())
+	}
+	if strings.Contains(out.String(), `attachment: '{`) {
+		t.Fatalf("attachment was quoted JSON: %s", out.String())
+	}
+
+	creator := &testCreator{}
+	if err := NewImporter(creator).Import(ctx, &out); err != nil {
+		t.Fatal(err)
+	}
+	if creator.flags != 1 || creator.segments != 1 || creator.constraints != 1 || creator.rules != 1 || creator.distributions != 1 || len(creator.variants) != 2 {
+		t.Fatalf("incomplete import: %+v", creator)
+	}
+	if creator.variants[1].Attachment != "" {
+		t.Fatalf("missing attachment became %q", creator.variants[1].Attachment)
+	}
+	var attachment interface{}
+	if err := json.Unmarshal([]byte(creator.variants[0].Attachment), &attachment); err != nil {
+		t.Fatal(err)
+	}
+	value := attachment.(map[string]interface{})["array"].([]interface{})
+	if len(value) != 4 || value[2] != nil || value[3].(map[string]interface{})["nested"].([]interface{})[0] != "text" {
+		t.Fatalf("attachment changed: %#v", attachment)
+	}
+}
+
+func TestImportYAMLMapKeysAndNoAttachment(t *testing.T) {
+	creator := &testCreator{}
+	input := `flags:
+- key: flag
+  enabled: true
+  variants:
+  - key: with-map
+    attachment:
+      7:
+      - false
+      - null
+  - key: absent
+segments:
+- key: segment
+`
+	if err := NewImporter(creator).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if creator.variants[0].Attachment != `{"7":[false,null]}` || creator.variants[1].Attachment != "" {
+		t.Fatalf("attachments: %+v", creator.variants)
+	}
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..5421852
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,120 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"strings"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+type Importer struct {
+	store creator
+}
+
+func NewImporter(store creator) *Importer {
+	return &Importer{store: store}
+}
+
+// convert makes YAML maps compatible with encoding/json, including maps nested in arrays.
+func convert(value interface{}) interface{} {
+	switch value := value.(type) {
+	case map[interface{}]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			converted[fmt.Sprint(key)] = convert(item)
+		}
+		return converted
+	case map[string]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			converted[key] = convert(item)
+		}
+		return converted
+	case []interface{}:
+		converted := make([]interface{}, len(value))
+		for i, item := range value {
+			converted[i] = convert(item)
+		}
+		return converted
+	default:
+		return value
+	}
+}
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	var doc Document
+	if err := yaml.NewDecoder(r).Decode(&doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+
+	createdVariants := make(map[string]*flipt.Variant)
+	for _, f := range doc.Flags {
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+		for _, v := range f.Variants {
+			attachment := ""
+			if v.Attachment != nil {
+				// Existing exports used JSON strings; accept those alongside YAML values.
+				if raw, ok := v.Attachment.(string); ok && (strings.HasPrefix(strings.TrimSpace(raw), "{") || strings.HasPrefix(strings.TrimSpace(raw), "[")) && json.Valid([]byte(raw)) {
+					attachment = raw
+				} else {
+					encoded, err := json.Marshal(convert(v.Attachment))
+					if err != nil {
+						return fmt.Errorf("encoding attachment for variant %q: %w", v.Key, err)
+					}
+					attachment = string(encoded)
+				}
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{FlagKey: f.Key, Key: v.Key, Name: v.Name, Description: v.Description, Attachment: attachment})
+			if err != nil {
+				return fmt.Errorf("importing variant %q: %w", v.Key, err)
+			}
+			createdVariants[f.Key+":"+v.Key] = variant
+		}
+	}
+
+	for _, s := range doc.Segments {
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: s.Key, Name: s.Name, Description: s.Description, MatchType: flipt.MatchType(flipt.MatchType_value[s.MatchType])}); err != nil {
+			return fmt.Errorf("importing segment %q: %w", s.Key, err)
+		}
+		for _, c := range s.Constraints {
+			_, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{SegmentKey: s.Key, Type: flipt.ComparisonType(flipt.ComparisonType_value[c.Type]), Property: c.Property, Operator: c.Operator, Value: c.Value})
+			if err != nil {
+				return fmt.Errorf("importing constraint for segment %q: %w", s.Key, err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{FlagKey: f.Key, SegmentKey: r.SegmentKey, Rank: int32(r.Rank)})
+			if err != nil {
+				return fmt.Errorf("importing rule for flag %q: %w", f.Key, err)
+			}
+			for _, d := range r.Distributions {
+				variant, found := createdVariants[f.Key+":"+d.VariantKey]
+				if !found {
+					return fmt.Errorf("finding variant %q for flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{FlagKey: f.Key, RuleId: rule.Id, VariantId: variant.Id, Rollout: d.Rollout}); err != nil {
+					return fmt.Errorf("importing distribution for flag %q: %w", f.Key, err)
+				}
+			}
+		}
+	}
+	return nil
+}
