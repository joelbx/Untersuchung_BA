+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        db = get_db()
+        db.query("""
+            CREATE TABLE booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL,
+                notes text NOT NULL,
+                PRIMARY KEY (username, work_id, edition_id)
+            );
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.insert("booknotes", username="alice", work_id=1, edition_id=-1, notes="source")
+        self.db.insert("booknotes", username="alice", work_id=1, edition_id=3, notes="edition")
+
+    def teardown_method(self):
+        self.db.query("DELETE FROM booknotes")
+
+    def booknotes(self):
+        return [tuple(row.values()) for row in self.db.select("booknotes", order="username, work_id, edition_id")]
+
+    def test_conflict_preserves_all_booknotes(self):
+        self.db.insert("booknotes", username="alice", work_id=2, edition_id=-1, notes="target")
+        self.db.insert("booknotes", username="bob", work_id=3, edition_id=-1, notes="other")
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.booknotes() == before
+
+    def test_target_work_id_used_by_another_patron_is_a_conflict(self):
+        self.db.insert("booknotes", username="bob", work_id=2, edition_id=4, notes="target")
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.booknotes() == before
+
+    def test_update_without_conflict(self):
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 2, "rows_deleted": 0, "failed_deletes": 0}
+        assert sorted(row.work_id for row in self.db.select("booknotes")) == [2, 2]
+
+    def test_dry_run_keeps_booknotes(self):
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {"rows_changed": 2, "rows_deleted": 0, "failed_deletes": 0}
+        assert self.booknotes() == before
