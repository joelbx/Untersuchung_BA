 import textwrap
 import traceback
 import yaml
@@ -71,6 +72,32 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    _TTY_MACRO = re.compile(
+        r'(?<!\w)(?:(?P<simple>[IBMUC])\((?P<simple_text>[^)]+)\)'
+        r'|(?P<link>[LR])\((?P<link_text>[^,()]+), *(?P<link_target>[^()]+)\)'
+        r'|HORIZONTALLINE(?!\w))'
+    )
+
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            macro = match.group('simple')
+            if macro == 'I' or macro == 'C':
+                return "`%s'" % match.group('simple_text')
+            if macro == 'B':
+                return '*%s*' % match.group('simple_text')
+            if macro == 'M':
+                return '[%s]' % match.group('simple_text')
+            if macro == 'U':
+                return match.group('simple_text')
+            if match.group('link') == 'L':
+                return '%s <%s>' % (match.group('link_text'), match.group('link_target'))
+            if match.group('link') == 'R':
+                return match.group('link_text')
+            return '\n-------------\n'
+
+        return cls._TTY_MACRO.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
diff --git a/test/units/cli/test_doc.py b/test/units/cli/test_doc.py
