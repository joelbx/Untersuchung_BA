index 0000000..337b7d8
--- /dev/null
+++ b/test/units/cli/test_doc.py
@@ -0,0 +1,21 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from ansible.cli.doc import DocCLI
+
+
+def test_tty_ify_documentation_macros():
+    text = 'I(italics) B(bold) M(module) U(url) C(value) L(link, https://example.org) R(see, reference)'
+    assert DocCLI.tty_ify(text) == "`italics' *bold* [module] url `value' link <https://example.org> see"
+    assert DocCLI.tty_ify('L(link,https://example.org) R(see,reference)') == 'link <https://example.org> see'
+
+
+def test_tty_ify_preserves_plain_words_and_renders_multiple_macros():
+    text = 'IBM(International Business Machines) uses M(name), B(text), C(value), and R(text, ref).'
+    assert DocCLI.tty_ify(text) == "IBM(International Business Machines) uses [name], *text*, `value', and text."
+    assert DocCLI.tty_ify('X(value) preHORIZONTALLINEpost') == 'X(value) preHORIZONTALLINEpost'
+
+
+def test_tty_ify_horizontal_line():
+    assert DocCLI.tty_ify('HORIZONTALLINE') == '\n-------------\n'
+    assert DocCLI.tty_ify('before HORIZONTALLINE after') == 'before \n-------------\n after'
