+package authz
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFormatNamespaces(t *testing.T) {
+	got, err := FormatNamespaces([]any{"local", "staging"})
+	require.NoError(t, err)
+	assert.Equal(t, []string{"local", "staging"}, got)
+
+	got, err = FormatNamespaces([]any{})
+	require.NoError(t, err)
+	assert.Empty(t, got)
+
+	for _, value := range []any{nil, true, []any{"local", 12}, []any{""}} {
+		_, err := FormatNamespaces(value)
+		require.Error(t, err)
+	}
+}
