+++ b/internal/server/authz/authz.go
@@ -1,8 +1,45 @@
 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
+
+type contextKey struct{}
+
+// NamespacesKey holds the namespaces accessible to the authenticated requester.
+var NamespacesKey contextKey
+
+// FormatNamespaces validates a policy decision and converts it to namespace keys.
+func FormatNamespaces(value any) ([]string, error) {
+	if value == nil {
+		return nil, fmt.Errorf("viewable namespaces are not defined")
+	}
+	var items []any
+	switch v := value.(type) {
+	case []any:
+		items = v
+	case []string:
+		items = make([]any, len(v))
+		for i, name := range v {
+			items[i] = name
+		}
+	default:
+		return nil, fmt.Errorf("invalid viewable namespaces result: %T", value)
+	}
+	namespaces := make([]string, 0, len(items))
+	for _, item := range items {
+		name, ok := item.(string)
+		if !ok || name == "" {
+			return nil, fmt.Errorf("invalid viewable namespace: %v", item)
+		}
+		namespaces = append(namespaces, name)
+	}
+	return namespaces, nil
+}
