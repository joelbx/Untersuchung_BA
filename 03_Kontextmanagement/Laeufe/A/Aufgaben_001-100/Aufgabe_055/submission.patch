+		t.Fatal("Trivy scan CVEs should be reused")
+	}
+	r.ScannedBy = ""
+	r.Optional = map[string]interface{}{"trivy-target": "old marker"}
+	if reuseScannedCves(&r) {
+		t.Fatal("Optional marker must not identify a Trivy scan")
+	}
+}
