+func TestIsPkgCvesDetactable(t *testing.T) {
+	base := models.ScanResult{Family: constant.Debian, Release: "10", Packages: models.Packages{"pkg": {Name: "pkg"}}}
+	cases := []struct {
+		name string
+		edit func(*models.ScanResult)
+		want bool
+	}{
+		{"supported", func(*models.ScanResult) {}, true},
+		{"missing family", func(r *models.ScanResult) { r.Family = "" }, false},
+		{"missing release", func(r *models.ScanResult) { r.Release = "" }, false},
+		{"no packages", func(r *models.ScanResult) { r.Packages = nil }, false},
+		{"trivy", func(r *models.ScanResult) { r.ScannedBy = "trivy" }, false},
+		{"freebsd", func(r *models.ScanResult) { r.Family = constant.FreeBSD }, false},
+		{"raspbian", func(r *models.ScanResult) { r.Family = constant.Raspbian }, false},
+		{"pseudo", func(r *models.ScanResult) { r.Family = constant.ServerTypePseudo }, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r := base
+			tc.edit(&r)
+			if got := isPkgCvesDetactable(&r); got != tc.want {
+				t.Fatalf("isPkgCvesDetactable() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
