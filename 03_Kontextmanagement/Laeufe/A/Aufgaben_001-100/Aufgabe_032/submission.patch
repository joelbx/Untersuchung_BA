@@ -19,6 +19,41 @@ from pprint import pprint
 
 class TestAsyncWrapper:
 
+    def test_jwrite_replaces_complete_record(self, tmp_path, monkeypatch):
+        path = tmp_path / 'job'
+        path.write_text(json.dumps({'started': 1, 'finished': 0}))
+        monkeypatch.setattr(async_wrapper, 'job_path', str(path))
+        original_rename = async_wrapper.os.rename
+
+        def check_before_rename(source, destination):
+            assert json.loads(path.read_text()) == {'started': 1, 'finished': 0}
+            assert json.loads((tmp_path / 'job.tmp').read_text()) == {'finished': 1}
+            original_rename(source, destination)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', check_before_rename)
+        async_wrapper.jwrite({'finished': 1})
+        assert json.loads(path.read_text()) == {'finished': 1}
+
+    def test_fork_failure_is_structured(self, tmp_path, monkeypatch, capsys):
+        monkeypatch.setattr(async_wrapper.sys, 'argv',
+                            ['async_wrapper', 'job', '10', '/tmp/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
+
+        def fail_fork():
+            raise OSError('fork failed')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        with pytest.raises(SystemExit) as exit_info:
+            async_wrapper.main()
+        assert exit_info.value.code == 1
+        output = json.loads(capsys.readouterr().out)
+        assert output['failed'] is True
+        assert output['ansible_job_id'].startswith('job.')
+        assert 'fork failed' in output['msg']
+        with open(str(tmp_path / output['ansible_job_id'])) as jobfile:
+            assert json.load(jobfile) == output
+
+
     def test_run_module(self, monkeypatch):
 
