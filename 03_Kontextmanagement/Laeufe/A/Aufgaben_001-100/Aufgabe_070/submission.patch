+++ b/openlibrary/catalog/utils/__init__.py
@@ -454,11 +454,47 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     if not languages:
         return []
 
+    from openlibrary.plugins.upstream.utils import get_marc21_language, strip_accents
+
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        token = language.strip().casefold()
+        key = f'/languages/{token}'
+        if len(token) != 3 or web.ctx.site.get(key) is None:
+            matches = set()
+            if len(token) == 2:
+                keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+                for record in web.ctx.site.get_many(keys):
+                    identifiers = record.dict().get('identifiers') or {}
+                    if token in identifiers.get('iso_639_1', []):
+                        matches.add(record.key)
+            if len(matches) == 1:
+                key = matches.pop()
+            elif len(matches) > 1:
+                raise InvalidLanguage(token)
+            else:
+                code = get_marc21_language(token)
+                key = f'/languages/{code}' if code else ''
+                if not code or web.ctx.site.get(key) is None:
+                    name = strip_accents(token)
+                    keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+                    for record in web.ctx.site.get_many(keys):
+                        data = record.dict()
+                        names = [data['name']]
+                        for translations in (data.get('name_translated') or {}).values():
+                            names.extend(translations)
+                        if any(
+                            strip_accents(candidate).casefold() == name
+                            for candidate in names
+                        ):
+                            matches.add(record.key)
+                    if len(matches) != 1:
+                        raise InvalidLanguage(token)
+                    key = matches.pop()
+
+        if key not in seen:
+            seen.add(key)
+            formatted_languages.append({'key': key})
 
     return formatted_languages
