+func (s *RolesTestSuite) TestRoleSetValidation(c *check.C) {
+	for _, roles := range []teleport.Roles{
+		nil,
+		{},
+		{teleport.RoleAuth, teleport.RoleRemoteProxy},
+	} {
+		c.Assert(roles.Check(), check.IsNil)
+	}
+	c.Assert(teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}.Check(),
+		check.ErrorMatches, "role Auth is duplicated")
+	c.Assert(teleport.Roles{teleport.RoleAuth, teleport.Role("unknown")}.Check(),
+		check.ErrorMatches, "role unknown is not registered")
+}
