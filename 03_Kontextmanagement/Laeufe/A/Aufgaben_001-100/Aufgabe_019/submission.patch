 		teleport.RoleNode,
@@ -68,3 +82,22 @@ func (s *RolesTestSuite) TestEquivalence(c *check.C) {
 	c.Assert(authRole.Equals(teleport.Roles{teleport.RoleAuth, teleport.RoleAdmin}),
 		check.Equals, true)
 }
+
+func (s *RolesTestSuite) TestSetEquivalence(c *check.C) {
+	tests := []struct {
+		left, right teleport.Roles
+		equal       bool
+	}{
+		{nil, teleport.Roles{}, true},
+		{teleport.Roles{teleport.RoleAuth}, teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}, true},
+		{teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}, teleport.Roles{teleport.RoleAuth}, true},
+		{teleport.Roles{teleport.RoleAuth, teleport.RoleNode}, teleport.Roles{teleport.RoleNode, teleport.RoleAuth}, true},
+		{teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}, teleport.Roles{teleport.RoleAuth, teleport.RoleNode}, false},
+		{teleport.Roles{teleport.RoleAuth, teleport.RoleNode}, teleport.Roles{teleport.RoleAuth, teleport.RoleProxy}, false},
+		{teleport.Roles{teleport.RoleAuth}, teleport.Roles{teleport.RoleAuth, teleport.RoleNode}, false},
+	}
+	for _, test := range tests {
+		c.Assert(test.left.Equals(test.right), check.Equals, test.equal)
+		c.Assert(test.right.Equals(test.left), check.Equals, test.equal)
+	}
+}
