+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import copy
+
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+from units.compat.mock import MagicMock, Mock, patch
+from units.modules.utils import set_module_args
+from .test_nios_module import TestNiosModule
+
+
+class TestNiosFixedAddress(TestNiosModule):
+    module = nios_fixed_address
+
+    def test_main_routes_address_and_requires_provider(self):
+        for address, object_type, field in (
+                ('192.0.2.10', api.NIOS_IPV4_FIXED_ADDRESS, 'ipv4addr'),
+                ('2001:db8::10', api.NIOS_IPV6_FIXED_ADDRESS, 'ipv6addr')):
+            set_module_args(dict(name='printer', ipaddr=address, mac='00:11:22:33:44:55',
+                                 network='192.0.2.0/24', provider={}))
+            with patch.object(nios_fixed_address, 'WapiModule') as wapi_class:
+                wapi_class.return_value.run.return_value = {'changed': False}
+                self.changed(False)
+                module = wapi_class.call_args[0][0]
+                self.assertEqual(module.params[field], address)
+                called_type, spec = wapi_class.return_value.run.call_args[0]
+                self.assertEqual(called_type, object_type)
+                self.assertIn(field, spec)
+                self.assertNotIn('ipaddr', spec)
+
+        set_module_args(dict(name='printer', ipaddr='192.0.2.10', mac='00:11:22:33:44:55',
+                             network='192.0.2.0/24'))
+        self.failed()
+
+    def test_invalid_address(self):
+        set_module_args(dict(name='printer', ipaddr='invalid', mac='00:11:22:33:44:55',
+                             network='192.0.2.0/24', provider={}))
+        self.assertIn('ipaddr', self.failed()['msg'])
+
+    def test_options(self):
+        module = MagicMock()
+        module.params = {'options': [{'num': 3, 'name': None, 'value': '192.0.2.1',
+                                      'use_option': None, 'vendor_class': None}]}
+        self.assertEqual(nios_fixed_address.options(module),
+                         [{'num': 3, 'value': '192.0.2.1',
+                           'use_option': True, 'vendor_class': 'DHCP'}])
+        module.params = {'options': [{'value': 'x'}]}
+        nios_fixed_address.options(module)
+        module.fail_json.assert_called_once()
+
+    def test_wapi_lifecycle_and_check_mode(self):
+        params = dict(provider={}, state='present', name='printer', ipv4addr='192.0.2.10',
+                      mac='00:11:22:33:44:55', network='192.0.2.0/24',
+                      network_view='default', options=None, extattrs=None, comment=None)
+        spec = dict(name={}, ipv4addr={'ib_req': True, 'update': False},
+                    mac={'ib_req': True, 'update': False},
+                    network={'ib_req': True, 'update': False},
+                    network_view={'ib_req': True, 'update': False},
+                    options={}, extattrs={}, comment={})
+        module = MagicMock()
+        module.params = params
+        module.check_mode = True
+        with patch.object(api, 'get_connector'):
+            wapi = api.WapiModule(module)
+        wapi.get_object = Mock(return_value=None)
+        wapi.create_object = Mock()
+        wapi.update_object = Mock()
+        wapi.delete_object = Mock()
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.create_object.assert_not_called()
+        self.assertEqual(wapi.get_object.call_args[0][1],
+                         {'ipv4addr': '192.0.2.10', 'mac': '00:11:22:33:44:55',
+                          'network': '192.0.2.0/24', 'network_view': 'default'})
+
+        module.check_mode = False
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.create_object.assert_called_once()
+        current = dict(params)
+        current.pop('provider')
+        current.pop('state')
+        current = dict((k, v) for k, v in current.items() if v is not None)
+        current['_ref'] = 'fixedaddress/ref'
+        wapi.get_object.side_effect = lambda *args, **kwargs: [copy.deepcopy(current)]
+        self.assertFalse(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        module.params['comment'] = 'updated'
+        module.check_mode = True
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.update_object.assert_not_called()
+        module.check_mode = False
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.update_object.assert_called_once()
+        module.params['state'] = 'absent'
+        module.check_mode = True
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.delete_object.assert_not_called()
+        module.check_mode = False
+        self.assertTrue(wapi.run(api.NIOS_IPV4_FIXED_ADDRESS, spec)['changed'])
+        wapi.delete_object.assert_called_once_with('fixedaddress/ref')
+
+    def test_ipv6_reference_uses_mac_and_network_context(self):
+        module = MagicMock()
+        module.params = {'provider': {}}
+        with patch.object(api, 'get_connector'):
+            wapi = api.WapiModule(module)
+        wapi.get_object = Mock(return_value=[])
+        spec = {'ipv6addr': {}, 'mac': {}, 'network': {}, 'network_view': {}, 'name': {}}
+        identity = {'ipv6addr': '2001:db8::10', 'mac': '00:11:22:33:44:55',
+                    'network': '2001:db8::/64', 'network_view': 'default'}
+        self.assertEqual(wapi.get_object_ref(module, api.NIOS_IPV6_FIXED_ADDRESS,
+                                             identity, spec), ([], False, None))
+        wapi.get_object.assert_called_once_with(api.NIOS_IPV6_FIXED_ADDRESS, identity,
+                                                 return_fields=spec.keys())
