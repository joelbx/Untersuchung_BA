+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	for _, tt := range []struct {
+		listen string
+		public string
+		want   string
+	}{
+		{"0.0.0.0:8080", "", "proxy.example.com:8080"},
+		{"[::]:8080", "", "proxy.example.com:8080"},
+		{"kube.example.com:8080", "", "kube.example.com:8080"},
+		{"0.0.0.0:8080", "public.example.com:444", "public.example.com:444"},
+	} {
+		tc := &TeleportClient{}
+		err := tc.applyProxySettings(ProxySettings{
+			SSH:  SSHProxySettings{PublicAddr: "proxy.example.com:443"},
+			Kube: KubeProxySettings{Enabled: true, ListenAddr: tt.listen, PublicAddr: tt.public},
+		})
+		c.Assert(err, check.IsNil)
+		c.Assert(tc.KubeProxyAddr, check.Equals, tt.want)
+	}
+}
