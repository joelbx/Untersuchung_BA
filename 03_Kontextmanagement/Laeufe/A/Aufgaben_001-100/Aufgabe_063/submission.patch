+func (s *ConfigTestSuite) TestProxyKubeListenShorthand(c *check.C) {
+	tests := []struct {
+		name    string
+		config  string
+		address string
+		wantErr bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"default port", "proxy_service:\n  kube_listen_addr: 0.0.0.0\n", "0.0.0.0:3026", false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n", "0.0.0.0:8080", false},
+		{"enabled legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", "", true},
+	}
+	for _, tt := range tests {
+		fc, err := ReadConfig(bytes.NewBufferString(tt.config))
+		c.Assert(err, check.IsNil, check.Commentf("%s", tt.name))
+		cfg := service.MakeDefaultConfig()
+		err = ApplyFileConfig(fc, cfg)
+		if tt.wantErr {
+			c.Assert(err, check.NotNil, check.Commentf("%s", tt.name))
+			c.Assert(err.Error(), check.Matches, ".*kube_listen_addr conflicts.*")
+			continue
+		}
+		c.Assert(err, check.IsNil, check.Commentf("%s", tt.name))
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true)
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, tt.address)
+	}
+}
