+// streamingCompletionCounter counts the full text after each delta. BPE tokens
+// can merge across delta boundaries, so summing each delta's tokens is inaccurate.
+type streamingCompletionCounter struct {
+	mu   sync.Mutex
+	text strings.Builder
+}
+
+func (counter *streamingCompletionCounter) add(delta string) {
+	counter.mu.Lock()
+	counter.text.WriteString(delta)
+	counter.mu.Unlock()
+}
+
+func (counter *streamingCompletionCounter) TokenCount() int {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	tokens, _, err := codec.NewCl100kBase().Encode(counter.text.String())
+	if err != nil {
+		log.WithError(err).Trace("failed to count streamed tokens")
+		return perRequest
+	}
+	return perRequest + len(tokens)
 }
 
