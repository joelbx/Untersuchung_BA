+++ b/lib/ai/model/tokencount_test.go
@@ -0,0 +1,51 @@
+package model
+
+import (
+	"testing"
+
+	"github.com/sashabaranov/go-openai"
+	"github.com/stretchr/testify/require"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+func TestTokenCounters(t *testing.T) {
+	messages := []openai.ChatCompletionMessage{
+		{Role: openai.ChatMessageRoleSystem, Content: "Hello"},
+		{Role: openai.ChatMessageRoleUser, Content: "How are you?"},
+	}
+	prompt, err := NewPromptTokenCounter(messages)
+	require.NoError(t, err)
+	first, _, err := codec.NewCl100kBase().Encode(messages[0].Content)
+	require.NoError(t, err)
+	second, _, err := codec.NewCl100kBase().Encode(messages[1].Content)
+	require.NoError(t, err)
+	require.Equal(t, 2*(perMessage+perRole)+len(first)+len(second), prompt.TokenCount())
+
+	completion, err := NewSynchronousTokenCounter("I am fine.")
+	require.NoError(t, err)
+	completionTokens, _, err := codec.NewCl100kBase().Encode("I am fine.")
+	require.NoError(t, err)
+	require.Equal(t, perRequest+len(completionTokens), completion.TokenCount())
+
+	count := NewTokenCount()
+	count.AddPromptCounter(nil)
+	count.AddPromptCounter(prompt)
+	count.AddCompletionCounter(nil)
+	count.AddCompletionCounter(completion)
+	p, c := count.CountAll()
+	require.Equal(t, prompt.TokenCount(), p)
+	require.Equal(t, completion.TokenCount(), c)
+}
+
+func TestAsynchronousTokenCounter(t *testing.T) {
+	start := "Hello world"
+	counter, err := NewAsynchronousTokenCounter(start)
+	require.NoError(t, err)
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	require.NoError(t, err)
+	require.NoError(t, counter.Add())
+	want := perRequest + len(tokens) + 1
+	require.Equal(t, want, counter.TokenCount())
+	require.Equal(t, want, counter.TokenCount())
+	require.Error(t, counter.Add())
+}
