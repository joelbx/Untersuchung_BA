diff --git a/lib/ai/model/tokencount.go b/lib/ai/model/tokencount.go
new file mode 100644
index 0000000..926db32
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,121 @@
+package model
+
+import (
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// TokenCounter reports a token total.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of counters.
+type TokenCounters []TokenCounter
+
+// CountAll sums the counters.
+func (counters TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range counters {
+		if counter != nil {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount holds the prompt and completion usage of an invocation.
+type TokenCount struct {
+	mu          sync.Mutex
+	prompts     TokenCounters
+	completions TokenCounters
+}
+
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+
+func (count *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt == nil {
+		return
+	}
+	count.mu.Lock()
+	defer count.mu.Unlock()
+	count.prompts = append(count.prompts, prompt)
+}
+
+func (count *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion == nil {
+		return
+	}
+	count.mu.Lock()
+	defer count.mu.Unlock()
+	count.completions = append(count.completions, completion)
+}
+
+// CountAll returns prompt and completion totals, in that order.
+func (count *TokenCount) CountAll() (int, int) {
+	count.mu.Lock()
+	defer count.mu.Unlock()
+	return count.prompts.CountAll(), count.completions.CountAll()
+}
+
+// StaticTokenCounter holds a fixed total.
+type StaticTokenCounter struct{ count int }
+
+func (counter *StaticTokenCounter) TokenCount() int { return counter.count }
+
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	var total int
+	for _, message := range messages {
+		tokens, _, err := tokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		total += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: total}, nil
+}
+
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter tracks tokens produced by a stream.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+func (counter *AsynchronousTokenCounter) Add() error {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	if counter.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	counter.count++
+	return nil
+}
+
+// TokenCount returns the current total and closes the counter to further additions.
+func (counter *AsynchronousTokenCounter) TokenCount() int {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.finished = true
+	return perRequest + counter.count
+}
