+def recursive_finder(name, module_fqn, data, py_module_names, py_module_cache, zf):
+    """Collect transitive module_utils dependencies with a work queue."""
+    module_utils_paths = [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)]
+    module_utils_paths.append(_MODULE_UTILS_PATH)
+    work = deque([(module_fqn, data)])
+    queued = set(py_module_names)
 
+    def add(name_parts, source, path):
+        if name_parts in queued:
+            return
+        queued.add(name_parts)
+        py_module_cache[name_parts] = (source, path)
+        work.append(('.'.join(name_parts), source))
+        zf.writestr('/'.join(name_parts) + '.py', source)
+        py_module_names.add(name_parts)
+        display.vvvvv('Using module_utils file %s' % to_text(path, errors='surrogate_or_strict'))
+
+    # AnsiballZ always patches basic, even when the module does not import it.
+    first = True
+    while work:
+        current_fqn, current_data = work.popleft()
+        try:
+            tree = compile(current_data, '<unknown>', 'exec', ast.PyCF_ONLY_AST)
+        except (SyntaxError, IndentationError) as exc:
+            raise AnsibleError('Unable to import %s due to %s' % (name if first else current_fqn, exc.msg))
+        finder = ModuleDepFinder(current_fqn)
+        finder.visit(tree)
+        if first:
+            first = False
+            basic = LegacyModuleUtilLocator(('ansible', 'module_utils', 'basic'), mu_paths=module_utils_paths)
+            add(basic.normalized_name_parts, basic.source, basic.path)
+        for parts in sorted(finder.submodules):
+            if parts[0:3] == ('ansible', 'module_utils', 'six'):
+                parts = parts[:3]
+            if parts[0:2] == ('ansible', 'module_utils'):
+                locator = LegacyModuleUtilLocator(parts, parts in finder.ambiguous_submodules, module_utils_paths)
+            elif parts[0] == 'ansible_collections':
+                locator = CollectionModuleUtilLocator(parts, parts in finder.ambiguous_submodules)
+            else:
+                continue
+            if not locator.found:
+                raise AnsibleError('Could not find imported module support code for {0}. Looked for ({1})'.format(
+                    current_fqn, ', '.join(locator.candidate_names_joined())))
+            normalized = locator.normalized_name_parts
+            key = normalized + (('__init__',) if locator.is_package else ())
+            add(key, locator.source, locator.path)
+            if locator.redirected:
+                target = locator.source.decode('utf-8').splitlines()[1].split(' as mod', 1)[0][len('import '):]
+                target_parts = tuple(target.split('.'))
+                if target_parts[0] == 'ansible_collections':
+                    target_locator = CollectionModuleUtilLocator(target_parts)
+                else:
+                    target_locator = LegacyModuleUtilLocator(target_parts, mu_paths=module_utils_paths)
+                if not target_locator.found:
+                    raise AnsibleError('Could not find imported module support code for {0}. Looked for ({1})'.format(
+                        current_fqn, ', '.join(target_locator.candidate_names_joined())))
+                target_key = target_locator.normalized_name_parts + (('__init__',) if target_locator.is_package else ())
+                add(target_key, target_locator.source, target_locator.path)
+                normalized = target_locator.normalized_name_parts
+            for length in range(1, len(normalized)):
+                prefix = normalized[:length]
+                init_key = prefix + ('__init__',)
+                if init_key in queued:
+                    continue
+                if prefix[0] == 'ansible_collections':
+                    if length > 5:
+                        pkg_locator = CollectionModuleUtilLocator(prefix)
+                        source = pkg_locator.source if pkg_locator.found and pkg_locator.is_package else b''
+                        path = pkg_locator.path if pkg_locator.found and pkg_locator.is_package else '/'.join(prefix) + '/__init__.py'
+                    else:
+                        source, path = b'', '/'.join(prefix) + '/__init__.py'
+                elif length > 2:
+                    pkg_locator = LegacyModuleUtilLocator(prefix, mu_paths=module_utils_paths)
+                    source = pkg_locator.source if pkg_locator.found and pkg_locator.is_package else b''
+                    path = pkg_locator.path if pkg_locator.found and pkg_locator.is_package else '/'.join(prefix) + '/__init__.py'
+                else:
+                    continue
+                add(init_key, source, path)
+        if current_fqn != module_fqn:
+            py_module_cache.pop(tuple(current_fqn.split('.')), None)
 
