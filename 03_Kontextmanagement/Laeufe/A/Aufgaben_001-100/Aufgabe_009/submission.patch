+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-1', display_name: 'Old name', isVerified: false };
+
+    it('saves a changed name and shows it immediately', async () => {
+        let finishSave: () => void;
+        const saveDeviceName = jest.fn().mockImplementation(() => new Promise<void>(resolve => {
+            finishSave = resolve;
+        }));
+        const { getByTestId, queryByTestId } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        const input = getByTestId('device-detail-heading-input') as HTMLInputElement;
+        expect(input.maxLength).toBe(100);
+        expect(getByTestId('device-detail-heading-edit').textContent).toContain('visible to people');
+        fireEvent.change(input, { target: { value: 'Work laptop' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(saveDeviceName).toHaveBeenCalledWith('device-1', 'Work laptop');
+        expect(getByTestId('device-detail-heading-save').getAttribute('disabled')).not.toBeNull();
+        expect(getByTestId('device-detail-heading-edit').querySelector('.mx_Spinner')).not.toBeNull();
+
+        finishSave();
+        await waitFor(() => expect(getByTestId('device-detail-heading-read').textContent).toContain('Work laptop'));
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+    });
+
+    it('allows empty names and skips unchanged names', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(getByTestId('device-detail-heading-read')).not.toBeNull();
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-read')).not.toBeNull());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-1', '');
+        expect(getByTestId('device-detail-heading-read').querySelector('h3')?.textContent).toBe('');
+    });
+
+    it('cancels without saving', () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Discard me' } });
+        fireEvent.click(getByTestId('device-detail-heading-cancel'));
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Old name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('shows the required error and keeps the editor open when saving fails', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('Network failure'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'New name' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-error').textContent)
+            .toBe('Failed to set display name.'));
+        expect(getByTestId('device-detail-heading-edit')).not.toBeNull();
+    });
+
+    it('falls back to the device ID when no name is set', () => {
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ device_id: 'device-1', isVerified: false }}
+            saveDeviceName={jest.fn()}
+        />);
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('device-1');
+    });
+});
