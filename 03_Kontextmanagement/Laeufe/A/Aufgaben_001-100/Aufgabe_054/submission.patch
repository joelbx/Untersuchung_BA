@@ -3,15 +3,38 @@ package singleton
 import (
 	"reflect"
 	"strings"
+	"sync"
 
 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances      = make(map[string]interface{})
+	getOrCreateC   = make(chan *entry, 1)
+	typedInstances sync.Map
 )
 
+type typedEntry struct {
+	once  sync.Once
+	value interface{}
+}
+
+type typedValue[T any] struct {
+	value T
+}
+
+// GetInstance returns the singleton for T. The first call's constructor creates
+// the instance; later calls for the same exact type reuse it.
+func GetInstance[T any](constructor func() T) T {
+	typ := reflect.TypeOf((*T)(nil)).Elem()
+	entry, _ := typedInstances.LoadOrStore(typ, &typedEntry{})
+	e := entry.(*typedEntry)
+	e.once.Do(func() {
+		e.value = &typedValue[T]{value: constructor()}
+	})
+	return e.value.(*typedValue[T]).value
+}
