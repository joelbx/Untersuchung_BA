+func TestGetInstanceValueAndPointerTypes(t *testing.T) {
+	type item struct{ id int }
+	var valueCalls, pointerCalls int
+	value := singleton.GetInstance(func() item {
+		valueCalls++
+		return item{id: 1}
+	})
+	pointer := singleton.GetInstance(func() *item {
+		pointerCalls++
+		return &item{id: 2}
+	})
+
+	if value.id != 1 || pointer.id != 2 {
+		t.Fatalf("unexpected instances: value=%v, pointer=%v", value, pointer)
+	}
+	if got := singleton.GetInstance(func() item {
+		valueCalls++
+		return item{id: 3}
+	}); got != value {
+		t.Fatalf("value instance changed: got %v, want %v", got, value)
+	}
+	if got := singleton.GetInstance(func() *item {
+		pointerCalls++
+		return &item{id: 4}
+	}); got != pointer {
+		t.Fatalf("pointer instance changed: got %p, want %p", got, pointer)
+	}
+	if valueCalls != 1 || pointerCalls != 1 {
+		t.Fatalf("constructors called %d and %d times, want once each", valueCalls, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type item struct{ id int }
+	const calls = 20_000
+	var created int32
+	var ready sync.WaitGroup
+	ready.Add(calls)
+	start := make(chan struct{})
+	results := make([]*item, calls)
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			ready.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *item {
+				return &item{id: int(atomic.AddInt32(&created, 1))}
+			})
+		}(i)
+	}
+	ready.Wait()
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&created); got != 1 {
+		t.Fatalf("constructor called %d times, want once", got)
+	}
+	for i, result := range results {
+		if result != results[0] || result.id != 1 {
+			t.Fatalf("call %d returned %p (%v), want %p", i, result, result, results[0])
+		}
+	}
+}
