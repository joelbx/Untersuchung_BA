+def test_get_ia_record_normalizes_mixed_ia_fields() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            "creator": "First Author;Second Author",
+            "isbn": [" 0-7432-7356-7 ", "978 1451654684", "unknown", ""],
+            "publisher": ["  New York : Simon & Schuster  ", "  Another Press  "],
+        }
+    )
+    assert result['authors'] == [
+        {'name': 'First Author'},
+        {'name': 'Second Author'},
+    ]
+    assert result['isbn_10'] == ['0743273567']
+    assert result['isbn_13'] == ['9781451654684']
+    assert result['publishers'] == ['Simon & Schuster', 'Another Press']
+    assert result['publish_places'] == ['New York']
+    assert 'isbn' not in result
+    assert 'publisher' not in result
+
+
+@pytest.mark.parametrize('value', [None, '', [], [' ', None]])
+def test_get_ia_record_omits_empty_identification_fields(value) -> None:
+    result = code.ia_importapi.get_ia_record({'isbn': value, 'publisher': value})
+    assert not {
+        'isbn', 'isbn_10', 'isbn_13', 'publisher', 'publishers', 'publish_places'
+    } & result.keys()
