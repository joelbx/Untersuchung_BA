 import (
 	"bytes"
 	"context"
+	"encoding/json"
+	"errors"
 	"fmt"
 	"testing"
 
 	"github.com/gravitational/teleport/lib/session"
+	"github.com/gravitational/trace"
 
 	"github.com/stretchr/testify/require"
 )
 
+type testEventWriter struct {
+	bytes.Buffer
+	closes   int
+	closeErr error
+}
+
+func (w *testEventWriter) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+func TestWriterEmitterAndMultiLog(t *testing.T) {
+	first, second := &testEventWriter{}, &testEventWriter{}
+	a, b := NewWriterEmitter(first), NewWriterEmitter(second)
+	var _ Emitter = a
+
+	_, err := NewMultiLog(NewWriterLog(&testEventWriter{}))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+
+	multi, err := NewMultiLog(a, b)
+	require.NoError(t, err)
+	var _ Emitter = multi
+	event := &UserLogin{}
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	want, err := json.Marshal(event)
+	require.NoError(t, err)
+	want = append(want, '\n')
+	require.Equal(t, want, first.Bytes())
+	require.Equal(t, want, second.Bytes())
+	require.NoError(t, multi.Close())
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
+
+func TestWriterEmitterCloseErrors(t *testing.T) {
+	w := &testEventWriter{closeErr: errors.New("close failed")}
+	err := NewWriterEmitter(w).Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "close failed")
+	require.Equal(t, 2, w.closes)
+}
