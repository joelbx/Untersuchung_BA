+@pytest.mark.parametrize('query', ['foo OR bar', '(foo)', 'NOT foo'])
+def test_luqum_replace_child(query: str):
+    parent = parser.parse(query)
+    original_type = type(parent.children)
+    original_children = tuple(parent.children)
+    replacement = Word('baz')
+
+    assert luqum_replace_child(parent, original_children[0], replacement) is None
+    assert type(parent.children) is original_type
+    assert parent.children[0] is replacement
+    assert tuple(parent.children[1:]) == original_children[1:]
+
+
+def test_luqum_replace_child_replaces_equal_occurrences():
+    parent = parser.parse('foo OR foo')
+    replacement = Word('baz')
+
+    luqum_replace_child(parent, Word('foo'), replacement)
+
+    assert all(child is replacement for child in parent.children)
+
+
+def test_luqum_replace_child_missing_child():
+    parent = parser.parse('foo OR bar')
+    original_children = tuple(parent.children)
+
+    luqum_replace_child(parent, Word('missing'), Word('baz'))
+
+    assert tuple(parent.children) == original_children
+
+
+def test_luqum_replace_child_unsupported_parent():
+    with pytest.raises(ValueError, match='^Not supported for generic class Item$'):
+        luqum_replace_child(Word('foo'), Word('foo'), Word('bar'))
+
+
