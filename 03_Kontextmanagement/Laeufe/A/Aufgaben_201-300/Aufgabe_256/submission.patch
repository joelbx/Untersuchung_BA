+    def test_play_name_derived_from_hosts(self):
+        play_data = dict(hosts=['foo', 'bar'])
+        p = Play.load(play_data)
+        self.assertNotIn('name', play_data)
+        self.assertEqual(p.name, '')
+        self.assertEqual(p.get_name(), 'foo,bar')
+        p.hosts = ['baz']
+        self.assertEqual(p.get_name(), 'baz')
+        p.name = 'named play'
+        self.assertEqual(p.get_name(), 'named play')
+        p.name = ''
+        p.hosts = ('foo', b'bar')
+        self.assertEqual(p.get_name(), 'foo,bar')
+        p.hosts = None
+        self.assertEqual(p.get_name(), '')
+
+    def test_play_name_with_scalar_hosts(self):
+        p = Play.load(dict(hosts='foo'))
+        self.assertEqual(p.get_name(), 'foo')
