+func TestNestedMapRedaction(t *testing.T) {
+	hook := &Hook{RedactionList: []string{`(jwt=)[^&]+`}}
+	entry := &logrus.Entry{Data: logrus.Fields{
+		"config": map[string]interface{}{
+			"auth": map[string]interface{}{"token": "abc", "name": "Alice"},
+			"url":  "stream?jwt=secret&f=json",
+		},
+	}}
+	assert.NoError(t, hook.Fire(entry))
+	config := entry.Data["config"].(map[string]interface{})
+	assert.Equal(t, "[REDACTED]", config["auth"].(map[string]interface{})["token"])
+	assert.Equal(t, "Alice", config["auth"].(map[string]interface{})["name"])
+	assert.Equal(t, "stream?jwt=[REDACTED]&f=json", config["url"])
+}
