+// validateIPAgainstList checks the actual connection peer, never a forwarded header.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if strings.TrimSpace(whitelist) == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	address := remoteAddr
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		address = host
+	}
+	ip := net.ParseIP(address)
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil && network.Contains(ip) {
+			return true
+		}
+		if allowed := net.ParseIP(entry); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+		if username == "" {
+			return nil
+		}
+	}
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for proxy login", countErr)
+			return nil
+		}
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: username, IsAdmin: count == 0, NewPassword: uuid.NewString()}
+		if err = userRepo.Put(user); err != nil {
+			log.Error(r, "Could not create proxy user", err)
+			return nil
+		}
+		user, err = userRepo.FindByUsername(username)
+	}
+	if err != nil || user == nil {
+		if err != nil {
+			log.Error(r, "Could not find proxy user", err)
+		}
+		return nil
+	}
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create proxy token", err)
+		return nil
+	}
+	if err := userRepo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update proxy user LastLoginAt", err)
+	}
+	salt := uuid.NewString()
+	return map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token,
+		"subsonicSalt": salt, "subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
+}
+
