+func (h *Hook) redactValue(key string, value interface{}) interface{} {
+	if sensitiveField.MatchString(key) {
+		return "[REDACTED]"
+	}
+	for _, re := range h.redactionKeys {
+		if re.MatchString(key) {
+			return "[REDACTED]"
+		}
+	}
+	if value == nil {
+		return nil
+	}
+	rv := reflect.ValueOf(value)
+	if rv.Kind() == reflect.Map {
+		// Preserve the original key type and map shape while redacting values.
+		redacted := reflect.MakeMapWithSize(rv.Type(), rv.Len())
+		for _, mapKey := range rv.MapKeys() {
+			original := rv.MapIndex(mapKey)
+			item := h.redactValue(fmt.Sprint(mapKey.Interface()), original.Interface())
+			newValue := reflect.ValueOf(item)
+			if !newValue.IsValid() {
+				newValue = reflect.Zero(rv.Type().Elem())
+			} else if !newValue.Type().AssignableTo(rv.Type().Elem()) {
+				// A concrete map value type cannot hold a redacted string.
+				// Keep every key by widening the map's value type.
+				wide := make(map[interface{}]interface{}, rv.Len())
+				for _, key := range rv.MapKeys() {
+					wide[key.Interface()] = h.redactValue(fmt.Sprint(key.Interface()), rv.MapIndex(key).Interface())
+				}
+				return wide
 			}
+			redacted.SetMapIndex(mapKey, newValue)
 		}
-
