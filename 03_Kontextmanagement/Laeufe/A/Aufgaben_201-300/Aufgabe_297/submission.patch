@@ -0,0 +1,85 @@
+package app
+
+import (
+	"crypto/md5"
+	"fmt"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	for _, tc := range []struct {
+		addr, list string
+		want       bool
+	}{
+		{"192.0.2.4:1234", "invalid, 192.0.2.0/24, 2001:db8::/32", true},
+		{"[2001:db8::1]:1234", "invalid, 192.0.2.0/24, 2001:db8::/32", true},
+		{"192.0.3.4:1234", "192.0.2.0/24", false},
+		{"192.0.2.4:1234", "", false},
+		{"@", "@", true},
+		{"@", "192.0.2.0/24", false},
+		{"192.0.2.4:1234", "@", false},
+		{"192.0.2.4:1234", "192.0.2.4:4321", true},
+	} {
+		if got := validateIPAgainstList(tc.addr, tc.list); got != tc.want {
+			t.Errorf("validateIPAgainstList(%q, %q) = %v, want %v", tc.addr, tc.list, got, tc.want)
+		}
+	}
+}
+
+func TestHandleLoginFromHeaders(t *testing.T) {
+	previousWhitelist, previousHeader, previousDefault := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader, conf.Server.ReverseProxyDefaultUser
+	t.Cleanup(func() {
+		conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader, conf.Server.ReverseProxyDefaultUser = previousWhitelist, previousHeader, previousDefault
+	})
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "X-Proxy-User"
+	conf.Server.ReverseProxyDefaultUser = ""
+	repo := tests.CreateMockUserRepo()
+	ds := &tests.MockDataStore{MockedUser: repo}
+	r := httptest.NewRequest("GET", "/app/", nil)
+	r.RemoteAddr = "192.0.3.1:1234"
+	r.Header.Set("X-Proxy-User", "alice")
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatalf("untrusted peer received auth: %v", got)
+	}
+	if len(repo.Data) != 0 {
+		t.Fatal("untrusted peer created a user")
+	}
+	r.RemoteAddr = "192.0.2.1:1234"
+	payload := handleLoginFromHeaders(ds, r)
+	if payload == nil || payload["username"] != "alice" || payload["isAdmin"] != true {
+		t.Fatalf("unexpected first login payload: %v", payload)
+	}
+	if _, err := auth.Validate(payload["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	user, err := repo.FindByUsername("alice")
+	if err != nil {
+		t.Fatal(err)
+	}
+	salt := payload["subsonicSalt"].(string)
+	if payload["subsonicToken"] != fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))) {
+		t.Fatal("invalid Subsonic token")
+	}
+	if err := repo.Put(&model.User{UserName: "bob", Name: "Bob", NewPassword: "secret"}); err != nil {
+		t.Fatal(err)
+	}
+	r.Header.Set("X-Proxy-User", "bob")
+	if got := handleLoginFromHeaders(ds, r); got["isAdmin"] != false || got["name"] != "Bob" {
+		t.Fatalf("existing user state lost: %v", got)
+	}
+	r.Header.Del("X-Proxy-User")
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatalf("missing header authenticated without default user: %v", got)
+	}
+	conf.Server.ReverseProxyDefaultUser = "bob"
+	if got := handleLoginFromHeaders(ds, r); got["username"] != "bob" {
+		t.Fatalf("default user login failed: %v", got)
+	}
+}
