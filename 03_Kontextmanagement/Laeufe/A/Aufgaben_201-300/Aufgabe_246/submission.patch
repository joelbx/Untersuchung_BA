@@ -0,0 +1,26 @@
+package scan
+
+import "testing"
+
+func TestAnalyzeFileKeepsLockfileSource(t *testing.T) {
+	for _, tc := range []struct {
+		path    string
+		version string
+	}{
+		{path: "/a/Pipfile.lock", version: "1.0"},
+		{path: "/b/Pipfile.lock", version: "2.0"},
+	} {
+		content := []byte(`{"default":{"shared":{"version":"==` + tc.version + `"}}}`)
+		apps, err := AnalyzeFile(tc.path, &DummyFileInfo{}, func() ([]byte, error) { return content, nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		scanners, err := convertLibWithScanner(apps)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(scanners) != 1 || scanners[0].Path != tc.path || len(scanners[0].Libs) != 1 || scanners[0].Libs[0].Version != tc.version {
+			t.Fatalf("lockfile %s: scanners = %#v", tc.path, scanners)
+		}
+	}
+}
