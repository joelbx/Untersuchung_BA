+// AnalyzeFile analyzes one in-memory lockfile. The pinned fanal version exposes
+// GetLibraries, so this adapter provides file-by-file analysis to scanLibraries.
+func AnalyzeFile(path string, info os.FileInfo, opener func() ([]byte, error)) ([]types.Application, error) {
+	if info.IsDir() {
+		return nil, nil
+	}
+	content, err := opener()
+	if err != nil {
+		return nil, err
+	}
+	return analyzer.GetLibraries(extractor.FileMap{path: content})
+}
