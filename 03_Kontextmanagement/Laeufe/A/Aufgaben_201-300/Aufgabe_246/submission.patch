+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestMergeLibraryVulnKeepsSources(t *testing.T) {
+	cves := models.VulnInfos{}
+	mergeLibraryVuln(cves, models.VulnInfo{
+		CveID:           "CVE-1",
+		LibraryFixedIns: models.LibraryFixedIns{{Path: "/a/Pipfile.lock", Name: "shared", FixedIn: "2"}},
+	})
+	mergeLibraryVuln(cves, models.VulnInfo{
+		CveID:           "CVE-1",
+		LibraryFixedIns: models.LibraryFixedIns{{Path: "/b/Pipfile.lock", Name: "shared", FixedIn: "3"}},
+	})
+	got := cves["CVE-1"].LibraryFixedIns
+	if len(got) != 2 || got[0].Path != "/a/Pipfile.lock" || got[1].Path != "/b/Pipfile.lock" {
+		t.Fatalf("merged findings = %#v", got)
+	}
+}
