@@ -0,0 +1,29 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	script := "#!/bin/sh\n[ \"$5\" = -sT ] || exit 7\n[ \"$6\" = -p ] || exit 8\n[ \"$7\" = 80,443 ] || exit 9\nprintf 'Host: 192.0.2.1 ()\\tPorts: 80/open/tcp//http///, 443/closed/tcp//https///\\n'\n"
+	if err := os.WriteFile(path, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{ScannerBinPath: path, IsUseExternalScanner: true}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"80", "443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"192.0.2.1:80"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.NotSupportTechnique}); err == nil {
+		t.Fatal("unsupported technique accepted")
+	}
+}
