diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..35e1dcf
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,94 @@
+package scanner
+
+import (
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		if technique.String() == "" {
+			return nil, fmt.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if errs := conf.Validate(); len(errs) > 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniques := conf.GetScanTechniques()
+	if len(techniques) == 0 {
+		if conf.HasPrivileged {
+			techniques = []config.ScanTechnique{config.TCPSYN}
+		} else {
+			techniques = []config.ScanTechnique{config.TCPConnect}
+		}
+	}
+	techniqueOptions, err := setScanTechniques(techniques)
+	if err != nil {
+		return nil, err
+	}
+	open := []string{}
+	addresses := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		addresses = append(addresses, ip)
+	}
+	sort.Strings(addresses)
+	for _, ip := range addresses {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := scanDestIPPorts[ip]
+		if len(ports) == 0 {
+			continue
+		}
+		for _, port := range ports {
+			p, err := strconv.Atoi(port)
+			if err != nil || p < 1 || p > 65535 {
+				return nil, fmt.Errorf("invalid scan destination port: %q", port)
+			}
+		}
+		args := append([]string{"-Pn", "-n", "-oG", "-"}, techniqueOptions...)
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, "-p", strings.Join(ports, ","), ip)
+		output, err := osExec.Command(conf.ScannerBinPath, args...).CombinedOutput()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed: %w: %s", ip, err, strings.TrimSpace(string(output)))
+		}
+		for _, line := range strings.Split(string(output), "\n") {
+			if !strings.HasPrefix(line, "Host: ") || !strings.Contains(line, "Ports: ") {
+				continue
+			}
+			fields := strings.Fields(line)
+			if len(fields) < 2 || fields[1] != ip {
+				continue
+			}
+			segment := strings.SplitN(line, "Ports: ", 2)[1]
+			segment = strings.SplitN(segment, "\t", 2)[0]
+			for _, entry := range strings.Split(segment, ",") {
+				parts := strings.Split(strings.TrimSpace(entry), "/")
+				if len(parts) >= 3 && parts[1] == "open" && parts[2] == "tcp" {
+					open = append(open, ip+":"+parts[0])
+				}
+			}
+		}
+	}
+	return open, nil
+}
