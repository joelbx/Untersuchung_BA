+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	conf := &PortScanConf{ScanTechniques: []string{"SS", "st", "Sa", "sw", "SM", "sn", "SF", "sx", "unknown"}}
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas, NotSupportTechnique}
+	got := conf.GetScanTechniques()
+	for i, expected := range want {
+		if got[i] != expected {
+			t.Errorf("technique %d: got %v, want %v", i, got[i], expected)
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Fatalf("empty techniques: %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad"}}).GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Fatalf("unsupported technique: %v", got)
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "scanner")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"valid connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, ""},
+		{"missing scanner", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sT"}}, "multiple"},
+		{"privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, "privileges"},
+		{"source with connect", PortScanConf{ScannerBinPath: path, SourcePort: "443"}, "incompatible"},
+		{"source zero", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, "sourcePort must"},
+		{"source high", PortScanConf{ScannerBinPath: path, SourcePort: "65536"}, "sourcePort must"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			errs := tt.conf.Validate()
+			if tt.want == "" && len(errs) != 0 {
+				t.Fatalf("unexpected errors: %v", errs)
+			}
+			if tt.want != "" && !strings.Contains(strings.TrimSpace(errorsString(errs)), tt.want) {
+				t.Fatalf("expected %q in errors: %v", tt.want, errs)
+			}
+		})
+	}
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("empty configuration must be zero")
+	}
+	for _, conf := range []PortScanConf{{ScannerBinPath: path}, {ScanTechniques: []string{"sT"}}, {SourcePort: "1"}, {HasPrivileged: true}} {
+		if conf.IsZero() {
+			t.Fatalf("nonempty configuration marked zero: %+v", conf)
+		}
+	}
+}
+
+func TestNetRawCapability(t *testing.T) {
+	for _, test := range []struct {
+		output string
+		valid  bool
+	}{
+		{"/usr/bin/nmap cap_net_raw=ep", true},
+		{"/usr/bin/nmap cap_net_admin,cap_net_raw=ep", true},
+		{"", false},
+		{"/usr/bin/nmap cap_net_raw=garbage", false},
+		{"/usr/bin/nmap cap_net_raw_extra=ep", false},
+	} {
+		if got := hasNetRawCapability(test.output); got != test.valid {
+			t.Errorf("%q: got %t, want %t", test.output, got, test.valid)
+		}
+	}
+}
+
+func errorsString(errs []error) string {
+	var parts []string
+	for _, err := range errs {
+		parts = append(parts, err.Error())
+	}
+	return strings.Join(parts, "; ")
+}
