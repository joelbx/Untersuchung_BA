+++ b/config/portscan.go
@@ -0,0 +1,138 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf controls the optional scanner installed on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	for _, configured := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for _, technique := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(configured, technique.String()) {
+				found = technique
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, found)
+	}
+	return scanTechniques
+}
+
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil || info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("scannerBinPath must be an executable file: %s", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported"))
+	}
+	for _, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique"))
+		}
+	}
+	selected := TCPConnect
+	if c.HasPrivileged {
+		selected = TCPSYN
+	}
+	if len(techniques) > 0 {
+		selected = techniques[0]
+	}
+	if !c.HasPrivileged && selected != TCPConnect && selected != NotSupportTechnique {
+		errs = append(errs, fmt.Errorf("only TCPConnect is allowed without privileges"))
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 1 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort must be an integer from 1 to 65535"))
+		}
+		if selected == TCPConnect {
+			errs = append(errs, fmt.Errorf("sourcePort is incompatible with TCPConnect"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil || !hasNetRawCapability(string(output)) {
+			errs = append(errs, fmt.Errorf("scannerBinPath lacks cap_net_raw capability or capability data is unavailable: %s", strings.TrimSpace(string(output))))
+		}
+	}
+	return errs
+}
+
+func hasNetRawCapability(output string) bool {
+	fields := strings.Fields(output)
+	if len(fields) < 2 {
+		return false
+	}
+	capabilities := fields[len(fields)-1]
+	assignment := strings.SplitN(capabilities, "=", 2)
+	if len(assignment) != 2 || !strings.Contains(assignment[1], "e") || !strings.Contains(assignment[1], "p") {
+		return false
+	}
+	for _, name := range strings.Split(assignment[0], ",") {
+		if name == "cap_net_raw" {
+			return true
+		}
+	}
+	return false
+}
