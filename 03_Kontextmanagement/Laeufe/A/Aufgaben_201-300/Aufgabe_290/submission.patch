+
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { handleEvent } from "../src/legacy/LegacyCallHandler/handleEvent";
+import SettingsStore from "../src/settings/SettingsStore";
+
+describe("handleEvent", () => {
+    const audio = document.createElement("audio");
+    audio.id = "ringAudio";
+
+    afterEach(() => jest.restoreAllMocks());
+
+    it("logs errors with the media element id", () => {
+        const error = jest.spyOn(logger, "error").mockImplementation();
+        audio.addEventListener("error", handleEvent);
+        audio.dispatchEvent(new Event("error"));
+        audio.removeEventListener("error", handleEvent);
+
+        expect(error).toHaveBeenCalledWith("LegacyCallHandler audio error", {
+            eventType: "error", elementId: "ringAudio",
+        });
+    });
+
+    it("logs debug events only when enabled and ignores other events", () => {
+        const debug = jest.spyOn(logger, "debug").mockImplementation();
+        jest.spyOn(SettingsStore, "getValue").mockReturnValue(false);
+        audio.addEventListener("playing", handleEvent);
+        audio.addEventListener("click", handleEvent);
+        audio.dispatchEvent(new Event("playing"));
+        expect(debug).not.toHaveBeenCalled();
+
+        jest.spyOn(SettingsStore, "getValue").mockReturnValue(true);
+        audio.dispatchEvent(new Event("playing"));
+        audio.dispatchEvent(new Event("click"));
+        audio.removeEventListener("playing", handleEvent);
+        audio.removeEventListener("click", handleEvent);
+
+        expect(debug).toHaveBeenCalledTimes(1);
+        expect(debug).toHaveBeenCalledWith("LegacyCallHandler audio event", {
+            eventType: "playing", elementId: "ringAudio",
+        });
+    });
+});
