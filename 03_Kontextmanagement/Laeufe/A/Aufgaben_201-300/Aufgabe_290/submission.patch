+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const ERROR_EVENTS = new Set(["error", "abort", "stalled"]);
+const DEBUG_EVENTS = new Set([
+    "loadstart", "loadedmetadata", "loadeddata", "canplay", "canplaythrough",
+    "play", "playing", "pause", "ended", "waiting", "seeking", "seeked",
+    "suspend", "volumechange", "durationchange", "progress", "timeupdate", "ratechange",
+]);
+
+/** Listener for call audio element events. */
+export function handleEvent(e: Event): void {
+    const audio = e.currentTarget as HTMLMediaElement || e.target as HTMLMediaElement;
+    const details = { eventType: e.type, elementId: audio?.id };
+
+    if (ERROR_EVENTS.has(e.type)) {
+        logger.error("LegacyCallHandler audio error", details);
+    } else if (DEBUG_EVENTS.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("LegacyCallHandler audio event", details);
+    }
+}
