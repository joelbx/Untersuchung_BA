diff --git a/openlibrary/plugins/upstream/tests/test_addbook.py b/openlibrary/plugins/upstream/tests/test_addbook.py
index a644a09..61ecbc9 100644
--- a/openlibrary/plugins/upstream/tests/test_addbook.py
+++ b/openlibrary/plugins/upstream/tests/test_addbook.py
@@ -1,10 +1,65 @@
 """py.test tests for addbook"""
+from unittest.mock import Mock, sentinel
+
+import pytest
 import web
 from .. import addbook
 from openlibrary import accounts
 from openlibrary.mocks.mock_infobase import MockSite
 
 
+@pytest.mark.parametrize(
+    'author_fields',
+    [{}, {'author_key': ['OL1A']}, {'author_name': ['An Author']}],
+)
+def test_make_work_without_complete_author_info(author_fields, monkeypatch):
+    site = Mock()
+    monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+    doc = {'title': 'A Work', **author_fields}
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert work.title == 'A Work'
+    assert work.authors == []
+    assert work.cover_url == '/images/icons/avatar_book-sm.png'
+    assert work.ia == []
+    assert work.first_publish_year is None
+    assert all(work[field] == value for field, value in doc.items())
+    site.new.assert_not_called()
+
+
+def test_make_work_preserves_metadata_and_creates_authors(monkeypatch):
+    site = Mock()
+    site.new.side_effect = [sentinel.first_author, sentinel.second_author]
+    monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+    doc = {
+        'title': 'A Work',
+        'author_key': ['OL1A', 'OL2A'],
+        'author_name': ['First', 'Second'],
+        'cover_url': '/custom/cover.png',
+        'ia': ['archive-id'],
+        'first_publish_year': 2001,
+    }
+
+    work = addbook.make_work(doc)
+
+    assert work.authors == [sentinel.first_author, sentinel.second_author]
+    assert work.cover_url == '/custom/cover.png'
+    assert work.ia == ['archive-id']
+    assert work.first_publish_year == 2001
+    assert all(work[field] == value for field, value in doc.items())
+    assert site.new.call_count == 2
+    site.new.assert_any_call(
+        '/authors/OL1A',
+        {'key': '/authors/OL1A', 'type': {'key': '/type/author'}, 'name': 'First'},
+    )
+    site.new.assert_any_call(
+        '/authors/OL2A',
+        {'key': '/authors/OL2A', 'type': {'key': '/type/author'}, 'name': 'Second'},
+    )
+
+
 def strip_nones(d):
     return {k: v for k, v in d.items() if v is not None}
 
