index 0000000..1844428
--- /dev/null
+++ b/applications/mail/src/app/hooks/useShouldMoveOut.test.ts
@@ -0,0 +1,35 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { useShouldMoveOut } from './useShouldMoveOut';
+
+describe('useShouldMoveOut', () => {
+    const onBack = jest.fn();
+    const elementIDs = ['present'];
+
+    beforeEach(() => onBack.mockClear());
+
+    it('waits for elements to finish loading before evaluating the active ID', () => {
+        const { rerender } = renderHook((props) => useShouldMoveOut(props), {
+            initialProps: { elementID: 'missing', elementIDs, loadingElements: true, onBack },
+        });
+
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ elementID: 'missing', elementIDs, loadingElements: false, onBack });
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([undefined, '', 'missing'])('moves out for an invalid active ID (%s)', (elementID) => {
+        renderHook(() => useShouldMoveOut({ elementID, elementIDs, loadingElements: false, onBack }));
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it('moves out when the available IDs become empty', () => {
+        const { rerender } = renderHook((props) => useShouldMoveOut(props), {
+            initialProps: { elementID: 'present', elementIDs, loadingElements: false, onBack },
+        });
+
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ elementID: 'present', elementIDs: [], loadingElements: false, onBack });
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+});
