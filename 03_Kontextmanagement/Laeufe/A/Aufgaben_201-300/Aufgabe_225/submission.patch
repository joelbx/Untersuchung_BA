new file mode 100644
index 0000000..193b1f9
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,36 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestToKEVs(t *testing.T) {
+	date := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	zero := time.Time{}
+	entries := toKEVs(kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{VendorProject: "vendor", Product: "product", VulnerabilityName: "cisa name", ShortDescription: "description", RequiredAction: "patch", KnownRansomwareCampaignUse: "Known", DateAdded: date, Notes: "note"}},
+		VulnCheck: []kevulnmodels.VulnCheck{{VendorProject: "other", Product: "product", Name: "vulncheck name", Description: "description", RequiredAction: "patch", KnownRansomwareCampaignUse: "Unknown", DateAdded: date, DueDate: &zero,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "xdb-1", XDBURL: "https://example.com/xdb", DateAdded: date, ExploitType: "poc", CloneSSHURL: "ssh://example.com"}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://example.com/report", DateAdded: date}},
+		}},
+	})
+	if len(entries) != 2 {
+		t.Fatalf("got %d entries, want 2", len(entries))
+	}
+	if entries[0].Type != models.CISAKEVType || entries[0].CISA == nil || entries[0].CISA.Note != "note" || entries[0].DueDate != nil {
+		t.Errorf("unexpected CISA entry: %+v", entries[0])
+	}
+	if entries[1].Type != models.VulnCheckKEVType || entries[1].VendorProject != "other" || entries[1].VulnCheck == nil || entries[1].DueDate != nil {
+		t.Errorf("unexpected VulnCheck entry: %+v", entries[1])
+	}
+	if len(entries[1].VulnCheck.XDB) != 1 || entries[1].VulnCheck.XDB[0].XDBID != "xdb-1" || len(entries[1].VulnCheck.ReportedExploitation) != 1 || entries[1].VulnCheck.ReportedExploitation[0].URL != "https://example.com/report" {
+		t.Errorf("missing VulnCheck details: %+v", entries[1].VulnCheck)
+	}
+}
