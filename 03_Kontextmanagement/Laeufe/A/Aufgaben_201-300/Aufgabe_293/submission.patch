+func validateOCIReference(repository string) error {
+	scheme, target, hasScheme := strings.Cut(repository, "://")
+	if !hasScheme {
+		target = scheme
+		scheme = "https"
+	}
+	if !strings.Contains(target, "/") {
+		target = "local/" + target
+		scheme = "flipt"
+	}
+	ref, err := registry.ParseReference(target)
+	if err != nil {
+		return err
+	}
+	switch scheme {
+	case "http", "https":
+	case "flipt":
+		if ref.Registry != "local" {
+			return fmt.Errorf("unexpected local reference: %q", ref)
+		}
+	default:
+		return fmt.Errorf("unexpected repository scheme: %q should be one of [http|https|flipt]", scheme)
+	}
+	return nil
+}
+
+// DefaultBundleDir returns the directory used to store local OCI bundles.
+func DefaultBundleDir() (string, error) {
+	dir, err := Dir()
+	if err != nil {
+		return "", err
+	}
+	bundlesDir := filepath.Join(dir, "bundles")
+	if err := os.MkdirAll(bundlesDir, 0755); err != nil {
+		return "", fmt.Errorf("creating bundles directory: %w", err)
+	}
+	return bundlesDir, nil
+}
