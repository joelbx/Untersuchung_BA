new file mode 100644
index 0000000..717f697
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,52 @@
+package release
+
+import (
+	"context"
+	"testing"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3-dev", false},
+		{"v1.2.3-snapshot", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-rc1", false},
+		{"v1.2.3", true},
+		{"1.2.3+build", true},
+	}
+
+	for _, test := range tests {
+		t.Run(test.version, func(t *testing.T) {
+			if got := Is(test.version); got != test.want {
+				t.Errorf("Is(%q) = %t, want %t", test.version, got, test.want)
+			}
+		})
+	}
+}
+
+func TestCheckInvalidVersionLogsWarning(t *testing.T) {
+	core, logs := observer.New(zap.WarnLevel)
+	restore := zap.ReplaceGlobals(zap.New(core))
+	defer restore()
+
+	info, err := Check(context.Background(), "invalid")
+	if err == nil {
+		t.Fatal("expected invalid version error")
+	}
+	if info.CurrentVersion != "invalid" {
+		t.Fatalf("current version = %q, want invalid", info.CurrentVersion)
+	}
+	entries := logs.FilterMessage("checking for updates").All()
+	if len(entries) != 1 || entries[0].ContextMap()["error"] == nil {
+		t.Fatalf("expected one warning with error, got %v", logs.All())
+	}
+}
