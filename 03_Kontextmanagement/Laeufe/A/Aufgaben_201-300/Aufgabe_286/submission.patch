diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..d0ef2b5
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,70 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running version and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" || strings.EqualFold(version, "dev") {
+		return false
+	}
+
+	base := strings.SplitN(strings.ToLower(version), "+", 2)[0]
+	parts := strings.SplitN(base, "-", 2)
+	if len(parts) == 2 {
+		for _, identifier := range strings.Split(parts[1], ".") {
+			if identifier == "dev" || identifier == "snapshot" || identifier == "rc" ||
+				strings.HasPrefix(identifier, "rc") && len(identifier) > 2 && identifier[2] >= '0' && identifier[2] <= '9' {
+				return false
+			}
+		}
+	}
+
+	_, err := semver.ParseTolerant(version)
+	return err == nil
+}
+
+// Check looks up the latest release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		err = fmt.Errorf("parsing current version: %w", err)
+		zap.L().Warn("checking for updates", zap.Error(err))
+		return info, err
+	}
+
+	latest, _, err := github.NewClient(nil).Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		err = fmt.Errorf("getting latest release: %w", err)
+		zap.L().Warn("checking for updates", zap.Error(err))
+		return info, err
+	}
+
+	latestVersion, err := semver.ParseTolerant(latest.GetTagName())
+	if err != nil {
+		err = fmt.Errorf("parsing latest version: %w", err)
+		zap.L().Warn("checking for updates", zap.Error(err))
+		return info, err
+	}
+
+	info.LatestVersion = latestVersion.String()
+	info.LatestVersionURL = latest.GetHTMLURL()
+	info.UpdateAvailable = current.Compare(latestVersion) < 0
+	return info, nil
+}
