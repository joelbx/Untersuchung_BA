+func TestLoadAuthenticationRequiresProviderCredentials(t *testing.T) {
+	configs := []struct {
+		name     string
+		provider string
+		indent   string
+		content  string
+	}{
+		{
+			name:     "github",
+			provider: "github",
+			indent:   "      ",
+			content:  "authentication:\n  session:\n    domain: localhost\n  methods:\n    github:\n      enabled: true\n      client_id: id\n      client_secret: secret\n      redirect_address: http://localhost/callback\n",
+		},
+		{
+			name:     "oidc",
+			provider: "foo",
+			indent:   "          ",
+			content:  "authentication:\n  session:\n    domain: localhost\n  methods:\n    oidc:\n      enabled: true\n      providers:\n        foo:\n          client_id: id\n          client_secret: secret\n          redirect_address: http://localhost/callback\n",
+		},
+	}
+
+	for _, cfg := range configs {
+		for _, field := range []struct {
+			name  string
+			value string
+		}{
+			{"client_id", "id"},
+			{"client_secret", "secret"},
+			{"redirect_address", "http://localhost/callback"},
+		} {
+			t.Run(cfg.name+" missing "+field.name, func(t *testing.T) {
+				content := strings.Replace(cfg.content, cfg.indent+field.name+": "+field.value+"\n", "", 1)
+				if field.name == "client_id" {
+					// A missing provider field takes precedence over a missing session domain.
+					content = strings.Replace(content, "  session:\n    domain: localhost\n", "", 1)
+				}
+				path := t.TempDir() + "/config.yml"
+				require.NoError(t, os.WriteFile(path, []byte(content), 0600))
+
+				_, err := Load(path)
+				require.EqualError(t, err, fmt.Sprintf("provider %q: field %q: non-empty value is required", cfg.provider, field.name))
+			})
+		}
+	}
+}
