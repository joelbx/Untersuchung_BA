@@ -0,0 +1,20 @@
+//go:build !scanner
+
+package models
+
+import "testing"
+
+func TestNvdCvss40Metrics(t *testing.T) {
+	type metric struct {
+		Source       string
+		BaseScore    float64
+		VectorString string
+		BaseSeverity string
+	}
+	got := nvdCvss40Metrics(struct{ Cvss40 []metric }{
+		Cvss40: []metric{{Source: "nvd@nist.gov", BaseScore: 8.7, VectorString: "CVSS:4.0/AV:N", BaseSeverity: "HIGH"}},
+	})
+	if len(got) != 1 || got[0].Source != "nvd@nist.gov" || got[0].BaseScore != 8.7 || got[0].VectorString != "CVSS:4.0/AV:N" || got[0].BaseSeverity != "HIGH" {
+		t.Fatalf("unexpected CVSS v4 metrics: %+v", got)
+	}
+}
