+// nvdCvss40Metrics reads CVSS v4 metrics when the dictionary model provides
+// them. The currently pinned dictionary version does not declare Cvss40.
+func nvdCvss40Metrics(nvd any) []struct {
+	Source, VectorString, BaseSeverity string
+	BaseScore                          float64
+} {
+	v := reflect.ValueOf(nvd)
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	metrics := v.FieldByName("Cvss40")
+	if !metrics.IsValid() || metrics.Kind() != reflect.Slice {
+		return nil
+	}
+	var result []struct {
+		Source, VectorString, BaseSeverity string
+		BaseScore                          float64
+	}
+	for i := 0; i < metrics.Len(); i++ {
+		metric := metrics.Index(i)
+		if metric.Kind() != reflect.Struct {
+			continue
+		}
+		source := metric.FieldByName("Source")
+		vector := metric.FieldByName("VectorString")
+		severity := metric.FieldByName("BaseSeverity")
+		score := metric.FieldByName("BaseScore")
+		if !source.IsValid() || !vector.IsValid() || !severity.IsValid() || !score.IsValid() ||
+			source.Kind() != reflect.String || vector.Kind() != reflect.String || severity.Kind() != reflect.String || score.Kind() != reflect.Float64 {
+			continue
+		}
+		result = append(result, struct {
+			Source, VectorString, BaseSeverity string
+			BaseScore                          float64
+		}{source.String(), vector.String(), severity.String(), score.Float()})
+	}
+	return result
+}
