+def test_live_output_from_both_streams(proc, qtbot, caplog, message_mock,
+                                       py_proc):
+    proc._output_messages = True
+    cmd, args = py_proc("""
+        import sys, time
+        print('stdout text', flush=True)
+        print('stderr text', file=sys.stderr, flush=True)
+        time.sleep(1)
+    """)
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            proc.start(cmd, args)
+            qtbot.wait_until(lambda: len(message_mock.messages) >= 2,
+                             timeout=500)
+            assert proc.outcome.running
+            live = {(msg.level, msg.text) for msg in message_mock.messages}
+            assert live == {
+                (usertypes.MessageLevel.info, 'stdout text'),
+                (usertypes.MessageLevel.error, 'stderr text'),
+            }
+
+    assert [(msg.level, msg.text) for msg in message_mock.messages[-2:]] == [
+        (usertypes.MessageLevel.info, 'stdout text'),
+        (usertypes.MessageLevel.error, 'stderr text'),
+    ]
 
 
