+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = "json"
+
+    def POST(self, work_id):
+        def response(value):
+            return delegate.RawText(json.dumps(value), content_type='application/json')
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        if web.ctx.env.get('CONTENT_TYPE', '').lower().startswith('application/json'):
+            try:
+                i = json.loads(web.data())
+                if not isinstance(i, dict):
+                    raise ValueError
+            except (ValueError, TypeError):
+                return response({'errors': 'Invalid JSON request'})
+        else:
+            i = web.input(op=None, topic=None, comment='', edition_key=None)
+        username = user.key.split('/')[2]
+        try:
+            op = i.get('op')
+            if op == 'remove':
+                return response({'success': True, 'rows': Bestbook.remove(username, work_id=work_id)})
+            if op not in ('add', 'update'):
+                return response({'errors': 'Invalid operation'})
+            topic = i.get('topic')
+            if not topic:
+                return response({'errors': 'A topic is required'})
+            edition_key = i.get('edition_key')
+            edition_id = (
+                int(extract_numeric_id_from_olid(edition_key))
+                if edition_key else None
+            )
+            method = Bestbook.add if op == 'add' else Bestbook.update
+            award = method(
+                username, work_id, topic, comment=i.get('comment') or '', edition_id=edition_id
+            )
+            return response({'success': True, 'award': award})
+        except (Bestbook.AwardConditionsError, ValueError, TypeError) as exc:
+            return response({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = '/awards/count'
+    encoding = 'json'
+
