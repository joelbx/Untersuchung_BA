diff --git a/test/units/module_utils/facts/hardware/test_bsd_uptime.py b/test/units/module_utils/facts/hardware/test_bsd_uptime.py
new file mode 100644
index 0000000..77728b8
--- /dev/null
+++ b/test/units/module_utils/facts/hardware/test_bsd_uptime.py
@@ -0,0 +1,58 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import errno
+
+import pytest
+
+from units.compat.mock import Mock, patch
+
+from ansible.module_utils.facts.hardware import freebsd, netbsd, openbsd
+
+
+@pytest.mark.parametrize('hardware_module, hardware_class', [
+    (freebsd, freebsd.FreeBSDHardware),
+    (netbsd, netbsd.NetBSDHardware),
+    (openbsd, openbsd.OpenBSDHardware),
+])
+def test_bsd_uptime_seconds(hardware_module, hardware_class):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, '100\n', '')
+    with patch.object(hardware_module.time, 'time', return_value=150.9):
+        assert hardware_class(module).get_uptime_facts() == {'uptime_seconds': 50}
+    module.run_command.assert_called_once_with(['/sbin/sysctl', '-n', 'kern.boottime'])
+
+
+@pytest.mark.parametrize('hardware_class', [freebsd.FreeBSDHardware, netbsd.NetBSDHardware, openbsd.OpenBSDHardware])
+def test_bsd_uptime_omitted_for_bad_output_or_command_error(hardware_class):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    hardware = hardware_class(module)
+    for response in [(0, '', ''), (0, '{ sec = 100 }', ''), (0, '²', ''), (1, '100', 'error')]:
+        module.run_command.return_value = response
+        assert hardware.get_uptime_facts() == {}
+
+
+@pytest.mark.parametrize('hardware_class', [freebsd.FreeBSDHardware, netbsd.NetBSDHardware, openbsd.OpenBSDHardware])
+def test_bsd_uptime_missing_binary_raises_value_error(hardware_class):
+    module = Mock()
+    module.get_bin_path.return_value = None
+    with pytest.raises(ValueError):
+        hardware_class(module).get_uptime_facts()
+
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.side_effect = OSError(errno.ENOENT, 'No such file or directory')
+    with pytest.raises(ValueError):
+        hardware_class(module).get_uptime_facts()
+
+
+def test_openbsd_populate_keeps_all_fact_sources():
+    module = Mock()
+    with patch.object(openbsd, 'get_sysctl', return_value={}):
+        hardware = openbsd.OpenBSDHardware(module)
+        for name in ('processor', 'memory', 'device', 'dmi', 'mount', 'uptime'):
+            setattr(hardware, 'get_%s_facts' % name, Mock(return_value={name: name}))
+        result = hardware.populate()
+
+    assert result == {name: name for name in ('processor', 'memory', 'device', 'dmi', 'mount', 'uptime')}
diff --git a/test/units/module_utils/facts/test_sysctl.py b/test/units/module_utils/facts/test_sysctl.py
new file mode 100644
index 0000000..e1cd10f
--- /dev/null
+++ b/test/units/module_utils/facts/test_sysctl.py
@@ -0,0 +1,35 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat.mock import Mock
+
+from ansible.module_utils.facts.sysctl import get_sysctl
+
+
+def test_sysctl_parses_platform_delimiters_and_continuations():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.return_value = (0, 'hw.ncpu=4\nkern.osrelease: 7.4\nvm.pages 100\nmalformed\n'
+                                          'hw.model: first line\n second line\n\tthird line\n', '')
+
+    result = get_sysctl(module, ['hw', 'kern'])
+
+    assert result == {'hw.ncpu': '4', 'kern.osrelease': '7.4', 'vm.pages': '100',
+                      'hw.model': 'first line\n second line\n\tthird line'}
+    module.warn.assert_called_once()
+    assert module.warn.call_args[0][0].startswith('Unable to split sysctl line (malformed): ')
+
+
+def test_sysctl_command_errors_warn_and_return_empty():
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/sysctl'
+    module.run_command.side_effect = OSError('failed to run')
+
+    assert get_sysctl(module, ['hw']) == {}
+    module.warn.assert_called_once_with('Unable to read sysctl: failed to run')
+
+    module.warn.reset_mock()
+    module.run_command.side_effect = None
+    module.run_command.return_value = (1, '', 'bad prefix')
+    assert get_sysctl(module, ['hw']) == {}
+    module.warn.assert_called_once_with('Unable to read sysctl: bad prefix')
