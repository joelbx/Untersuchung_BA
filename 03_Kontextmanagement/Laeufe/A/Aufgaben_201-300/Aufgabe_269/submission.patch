+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	trivytypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsKeepsVendorData(t *testing.T) {
+	published := time.Date(2024, 2, 3, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	contents := getCveContents("CVE-1", trivytypes.Vulnerability{
+		Title: "title", Description: "summary",
+		VendorSeverity: trivytypes.VendorSeverity{"debian": trivytypes.SeverityLow, "ubuntu": trivytypes.SeverityMedium},
+		CVSS:           trivytypes.VendorCVSS{"nvd": {V3Score: 8.1, V3Vector: "CVSS:3.1/test"}},
+		References:     []string{"https://example.com"}, PublishedDate: &published, LastModifiedDate: &modified,
+	})
+	for source, severity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyNVD: "HIGH",
+	} {
+		c := contents[source][0]
+		if c.Type != source || c.CveID != "CVE-1" || c.Cvss3Severity != severity || !c.Published.Equal(published) || !c.LastModified.Equal(modified) || len(c.References) != 1 {
+			t.Errorf("%s: %+v", source, c)
+		}
+	}
+	if c := contents[models.TrivyNVD][0]; c.Cvss3Score != 8.1 || c.Cvss3Vector != "CVSS:3.1/test" {
+		t.Errorf("NVD score lost: %+v", c)
+	}
+}
+
+func TestGetCveContentsKeepsSelectedSourceSeverity(t *testing.T) {
+	contents := getCveContents("CVE-2", trivytypes.Vulnerability{Severity: "CRITICAL"}, "ghsa")
+	if got := contents[models.TrivyGHSA][0].Cvss3Severity; got != "CRITICAL" {
+		t.Errorf("GHSA severity: %q", got)
+	}
+}
