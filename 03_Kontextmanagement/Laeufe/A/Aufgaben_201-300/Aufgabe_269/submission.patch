@@ -0,0 +1,40 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	trivytypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	vul := trivytypes.Vulnerability{
+		Title: "title", Description: "summary", Severity: "LOW",
+		VendorSeverity: trivytypes.VendorSeverity{"debian": trivytypes.SeverityLow, "ubuntu": trivytypes.SeverityMedium},
+		CVSS:           trivytypes.VendorCVSS{"nvd": {V2Score: 4.3, V2Vector: "v2", V3Score: 7.5, V3Vector: "v3"}},
+		References:     []string{"https://example.com/advisory"}, PublishedDate: &published, LastModifiedDate: &modified,
+	}
+	result, err := Convert(types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-1", SeveritySource: "debian", Vulnerability: vul}}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-1", SeveritySource: "ubuntu", Vulnerability: vul}}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-1"].CveContents
+	for source, severity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyNVD: "HIGH"} {
+		c := contents[source][0]
+		if c.Type != source || c.CveID != "CVE-1" || c.Title != "title" || c.Summary != "summary" || c.Cvss3Severity != severity || !c.Published.Equal(published) || !c.LastModified.Equal(modified) || len(c.References) != 1 {
+			t.Errorf("%s: unexpected content: %+v", source, c)
+		}
+	}
+	if c := contents[models.TrivyNVD][0]; c.Cvss2Score != 4.3 || c.Cvss2Vector != "v2" || c.Cvss3Score != 7.5 || c.Cvss3Vector != "v3" {
+		t.Errorf("NVD CVSS lost: %+v", c)
+	}
+}
