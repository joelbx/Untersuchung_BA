diff --git a/contrib/trivy/pkg/cvecontents.go b/contrib/trivy/pkg/cvecontents.go
new file mode 100644
index 0000000..9e2d23e
--- /dev/null
+++ b/contrib/trivy/pkg/cvecontents.go
@@ -0,0 +1,76 @@
+package pkg
+
+import (
+	"sort"
+	"strings"
+	"time"
+
+	trivytypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+// CveContentsFromVulnerability keeps each Trivy database's score and severity separate.
+func CveContentsFromVulnerability(cveID string, vul trivytypes.Vulnerability, severitySource trivytypes.SourceID) models.CveContents {
+	contents := models.CveContents{}
+	sources := map[trivytypes.SourceID]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[source] = struct{}{}
+	}
+	if severitySource != "" {
+		sources[severitySource] = struct{}{}
+	}
+	if len(sources) == 0 {
+		sources["unknown"] = struct{}{}
+		severitySource = "unknown"
+	}
+
+	var published, lastModified time.Time
+	if vul.PublishedDate != nil {
+		published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		lastModified = *vul.LastModifiedDate
+	}
+	for source := range sources {
+		ctype := models.CveContentType("trivy:" + strings.ToLower(string(source)))
+		severity := ""
+		if vendorSeverity, ok := vul.VendorSeverity[source]; ok {
+			severity = vendorSeverity.String()
+		} else if source == severitySource {
+			severity = vul.Severity
+		}
+		cvss := vul.CVSS[source]
+		if severity == "" && len(sources) == 1 {
+			severity = vul.Severity
+		}
+		if severity == "" && cvss.V3Score > 0 {
+			switch {
+			case cvss.V3Score >= 9:
+				severity = "CRITICAL"
+			case cvss.V3Score >= 7:
+				severity = "HIGH"
+			case cvss.V3Score >= 4:
+				severity = "MEDIUM"
+			default:
+				severity = "LOW"
+			}
+		}
+		refs := make(models.References, 0, len(vul.References))
+		for _, url := range vul.References {
+			refs = append(refs, models.Reference{Source: string(ctype), Link: url})
+		}
+		sort.Slice(refs, func(i, j int) bool { return refs[i].Link < refs[j].Link })
+		contents[ctype] = []models.CveContent{{
+			Type: ctype, CveID: cveID, Title: vul.Title, Summary: vul.Description,
+			Cvss2Score: cvss.V2Score, Cvss2Vector: cvss.V2Vector,
+			Cvss3Score: cvss.V3Score, Cvss3Vector: cvss.V3Vector,
+			Cvss3Severity: severity, References: refs,
+			Published: published, LastModified: lastModified,
+		}}
+	}
+	return contents
+}
