@@ -6,10 +6,67 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	tests := []struct {
+		name, body, wantID, wantFix, wantSummary string
+		wantOptional                             map[string]string
+		wantScore                                float64
+		wantVector, wantSeverity                 string
+	}{
+		{
+			name:   "enterprise",
+			body:   `{"wordpresses":{"vulnerabilities":[{"id":"42","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.com/one","https://example.com/two"]},"fixed_in":"6.4.2","description":"Detailed summary","poc":"https://example.com/poc","introduced_in":"6.0","cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N","severity":"High"}}]}}`,
+			wantID: "CVE-2024-1234", wantFix: "6.4.2", wantSummary: "Detailed summary",
+			wantOptional: map[string]string{"poc": "https://example.com/poc", "introduced_in": "6.0"},
+			wantScore:    7.5, wantVector: "CVSS:3.1/AV:N", wantSeverity: "High",
+		},
+		{
+			name:   "basic with null enrichment",
+			body:   `{"wordpresses":{"vulnerabilities":[{"id":"42","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234"],"url":["https://example.com/one","https://example.com/two"]},"fixed_in":null,"description":null,"poc":null,"introduced_in":null,"cvss":null}]}}`,
+			wantID: "CVE-2024-1234", wantOptional: map[string]string{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			vinfos, err := convertToVinfos("core", tt.body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d records, want 1", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != tt.wantID || v.VulnType != "XSS" {
+				t.Fatalf("unexpected vulnerability: %+v", v)
+			}
+			if len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].Name != "core" || v.WpPackageFixStats[0].FixedIn != tt.wantFix {
+				t.Fatalf("unexpected fix status: %+v", v.WpPackageFixStats)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("unexpected contents: %+v", contents)
+			}
+			c := contents[0]
+			if c.Type != models.WpScan || c.CveID != tt.wantID || c.Summary != tt.wantSummary || c.Cvss3Score != tt.wantScore || c.Cvss3Vector != tt.wantVector || c.Cvss3Severity != tt.wantSeverity || !reflect.DeepEqual(c.Optional, tt.wantOptional) {
+				t.Fatalf("unexpected content: %+v", c)
+			}
+			wantPublished := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			wantModified := time.Date(2024, 2, 3, 2, 5, 6, 0, time.UTC)
+			if !c.Published.Equal(wantPublished) || c.Published.Location() != time.UTC || !c.LastModified.Equal(wantModified) || c.LastModified.Location() != time.UTC {
+				t.Fatalf("unexpected timestamps: %v %v", c.Published, c.LastModified)
+			}
+			if len(c.References) != 2 || c.References[0].Link != "https://example.com/one" || c.References[1].Link != "https://example.com/two" {
+				t.Fatalf("unexpected references: %+v", c.References)
+			}
+		})
+	}
+}
