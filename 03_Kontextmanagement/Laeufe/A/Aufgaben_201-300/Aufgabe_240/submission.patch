+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from ansible.modules.storage.netapp.netapp_e_drive_firmware import NetAppESeriesDriveFirmware
+from units.compat import mock
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+
+
+class DriveFirmwareTests(ModuleTestCase):
+    def firmware(self, **kwargs):
+        args = dict(api_url='https://array/devmgr/v2', api_username='admin', api_password='password',
+                    ssid='1', firmware=['/tmp/model.dlp'])
+        args.update(kwargs)
+        set_module_args(args)
+        return NetAppESeriesDriveFirmware()
+
+    def test_selects_only_outdated_compatible_drives(self):
+        firmware = self.firmware()
+        compatibility = [{'filename': 'model.dlp', 'firmwareVersion': '2',
+                          'compatibleDrives': ['one', 'two']},
+                         {'filename': 'unprovided.dlp', 'firmwareVersion': '2',
+                          'compatibleDrives': ['three']}]
+        with mock.patch.object(firmware, '_request', side_effect=[
+                (200, compatibility), (200, {'firmwareVersion': '1', 'status': 'optimal'}),
+                (200, {'firmwareVersion': '2', 'status': 'optimal'})]) as req:
+            self.assertEqual(firmware.upgrade_list(), [{'filename': 'model.dlp', 'driveRefList': ['one']}])
+            self.assertEqual(firmware.upgrade_list(), [{'filename': 'model.dlp', 'driveRefList': ['one']}])
+            self.assertEqual(req.call_count, 3)
+
+    def test_check_mode_reports_change_without_upgrade(self):
+        firmware = self.firmware(_ansible_check_mode=True)
+        with mock.patch.object(firmware, 'upload_firmware') as upload, \
+                mock.patch.object(firmware, 'upgrade_list', return_value=[{'filename': 'model.dlp', 'driveRefList': ['one']}]), \
+                mock.patch.object(firmware, 'upgrade') as upgrade:
+            with self.assertRaises(AnsibleExitJson) as result:
+                firmware.apply()
+        upload.assert_called_once_with()
+        upgrade.assert_not_called()
+        self.assertTrue(result.exception.args[0]['changed'])
+        self.assertFalse(result.exception.args[0]['upgrade_in_process'])
+
+    def test_wait_fails_for_targeted_drive_error(self):
+        firmware = self.firmware()
+        firmware._upgrade_list = [{'filename': 'model.dlp', 'driveRefList': ['one']}]
+        with mock.patch.object(firmware, '_request', return_value=(200, [
+                {'driveRef': 'other', 'status': 'failed'}, {'driveRef': 'one', 'status': 'failed'}])):
+            with self.assertRaisesRegex(AnsibleFailJson, 'Drive firmware upgrade failed.'):
+                firmware.wait_for_upgrade_completion()
