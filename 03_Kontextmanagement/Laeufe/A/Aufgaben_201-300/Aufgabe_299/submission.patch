diff --git a/qutebrowser/completion/models/filepathcategory.py b/qutebrowser/completion/models/filepathcategory.py
new file mode 100644
index 0000000..c538e59
--- /dev/null
+++ b/qutebrowser/completion/models/filepathcategory.py
@@ -0,0 +1,75 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Completion category for local filesystem paths."""
+
+import os
+from urllib import parse
+
+from PyQt5.QtCore import QAbstractListModel, QModelIndex, QObject, Qt
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractListModel):
+
+    """Expose matching local files and directories as completion entries."""
+
+    def __init__(self, name: str, parent: QObject = None):
+        super().__init__(parent)
+        self.name = name
+        self.columns_to_filter = [0]
+        self.delete_func = None
+        self._paths = []
+
+    def set_pattern(self, val: str) -> None:
+        """Update suggestions for a local path or file URL."""
+        if not val:
+            paths = list(config.val.completion.favorite_paths or [])
+        else:
+            is_url = val.startswith('file:///')
+            if is_url:
+                url = parse.urlsplit(val)
+                if url.netloc or url.query or url.fragment:
+                    paths = []
+                else:
+                    paths = self._matches(parse.unquote(url.path), is_url=True)
+            elif val.startswith('/') or val.startswith('~'):
+                paths = self._matches(val, is_url=False)
+            else:
+                paths = []
+        self.beginResetModel()
+        self._paths = paths
+        self.endResetModel()
+
+    @staticmethod
+    def _matches(path: str, *, is_url: bool):
+        expanded = os.path.expanduser(path)
+        if not os.path.isabs(expanded):
+            return []
+        directory, prefix = os.path.split(expanded)
+        if path.endswith('/'):
+            directory, prefix = expanded, ''
+        try:
+            with os.scandir(directory) as entries:
+                matches = sorted((entry.name, entry.is_dir()) for entry in entries
+                                 if entry.name.startswith(prefix))
+        except (OSError, ValueError):
+            return []
+
+        display_dir = path if path.endswith('/') else path[:-len(prefix)]
+        paths = []
+        for name, is_dir in matches:
+            result = display_dir + name + ('/' if is_dir else '')
+            if is_url:
+                result = 'file://' + parse.quote(result, safe='/')
+            paths.append(result)
+        return paths
+
+    def data(self, index: QModelIndex, role: int = Qt.DisplayRole):
+        if (role != Qt.DisplayRole or not index.isValid() or
+                index.column() != 0 or not 0 <= index.row() < len(self._paths)):
+            return None
+        return self._paths[index.row()]
+
+    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        return 0 if parent.isValid() else len(self._paths)
