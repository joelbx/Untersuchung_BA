+def test_filesystem_completion(qtmodeltester, config_stub, info, tmp_path,
+                               monkeypatch, quickmark_manager_stub,
+                               bookmark_manager_stub):
+    """Filesystem entries follow the configured order and retain input form."""
+    browse = tmp_path / 'browse'
+    browse.mkdir()
+    (browse / 'alpha.html').write_text('')
+    (browse / 'alpha dir').mkdir()
+    (browse / 'alpha dir' / 'inside.html').write_text('')
+    (browse / 'other').write_text('')
+    monkeypatch.setenv('HOME', str(tmp_path))
+    config_stub.val.completion.favorite_paths = ['~/alpha.html', '/favorite']
+    config_stub.val.completion.open_categories = ['filesystem', 'quickmarks']
+    model = urlmodel.url(info=info)
+
+    def check(pattern, paths):
+        model.set_pattern(pattern)
+        qtmodeltester.check(model)
+        _check_completions(model, {
+            'Filesystem': [(path, None, None) for path in paths],
+        })
+
+    check('', ['~/alpha.html', '/favorite'])
+    check(str(browse) + '/alpha', [str(browse / 'alpha dir') + '/',
+                                  str(browse / 'alpha.html')])
+    check(str(browse) + '/', [str(browse / 'alpha dir') + '/',
+                              str(browse / 'alpha.html'),
+                              str(browse / 'other')])
+    check('file://' + str(browse) + '/alpha',
+          ['file://' + str(browse / 'alpha dir').replace(' ', '%20') + '/',
+           'file://' + str(browse / 'alpha.html')])
+    check('file://' + str(browse) + '/alpha%20dir/',
+          ['file://' + str(browse) + '/alpha%20dir/inside.html'])
+    check('~/browse/alpha', ['~/browse/alpha dir/', '~/browse/alpha.html'])
+    for invalid in ('alpha', 'https://example.org/', 'file://remote/path',
+                    'file://' + str(browse) + '/?query',
+                    'file:///%00',
+                    str(tmp_path / 'missing') + '/'):
+        check(invalid, [])
+
+    config_stub.val.completion.open_categories = []
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    _check_completions(model, {})
+
+
