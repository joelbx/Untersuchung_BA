+def _is_child_path(path, root, link_path=None):
+    """Return whether path resolves inside root, relative to link_path when supplied."""
+    if link_path is not None:
+        path = os.path.join(os.path.dirname(link_path), path)
+    b_root = os.path.realpath(root)
+    b_path = os.path.realpath(path)
+    return b_path == b_root or b_path.startswith(b_root + to_bytes(os.path.sep) if isinstance(b_root, bytes)
+                                                   else b_root + os.path.sep)
 
 
