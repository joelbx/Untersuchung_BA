diff --git a/scanner/refresher_test.go b/scanner/refresher_test.go
new file mode 100644
index 0000000..a620db0
--- /dev/null
+++ b/scanner/refresher_test.go
@@ -0,0 +1,23 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestImageFiles(t *testing.T) {
+	dirs := []string{filepath.Join("music", "disc1"), filepath.Join("music", "disc2")}
+	all := dirMap{
+		dirs[0]: {ImageFiles: []string{"back.jpg", "front.png"}},
+		dirs[1]: {ImageFiles: []string{"cover.jpg"}},
+	}
+	want := strings.Join([]string{
+		filepath.Join(dirs[0], "back.jpg"),
+		filepath.Join(dirs[0], "front.png"),
+		filepath.Join(dirs[1], "cover.jpg"),
+	}, string(filepath.ListSeparator))
+	if got := imageFiles(dirs, all); got != want {
+		t.Fatalf("imageFiles() = %q, want %q", got, want)
+	}
+}
