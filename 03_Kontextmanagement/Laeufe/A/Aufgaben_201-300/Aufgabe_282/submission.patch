@@ -20,6 +20,7 @@
 import pytest
 
 from qutebrowser.browser import shared
+from qutebrowser.utils import usertypes
 
 
 @pytest.mark.parametrize('dnt, accept_language, custom_headers, expected', [
@@ -45,3 +46,63 @@ def test_custom_headers(config_stub, dnt, accept_language, custom_headers,
 
     expected_items = sorted(expected.items())
     assert shared.custom_headers(url=None) == expected_items
+
+
+@pytest.mark.parametrize('level, source, msg, shown', [
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Refused to apply inline style because of CSP', False),
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Unexpected failure', True),
+    (usertypes.JsLogLevel.warning, 'userscript:_qute_stylesheet',
+     'Unexpected failure', False),
+    (usertypes.JsLogLevel.error, 'qute:internal',
+     'Refused to apply inline style because of CSP', True),
+    (usertypes.JsLogLevel.error, 'website:script',
+     'Unexpected failure', False),
+])
+def test_js_log_to_ui(config_stub, monkeypatch, level, source, msg, shown):
+    ui_messages = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, level, ui_messages.append)
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:_qute_*': ['Refused to apply inline style*'],
+    }
+
+    assert shared._js_log_to_ui(level, source, 66, msg) is shown
+    assert ui_messages == ([f'JS: [{source}:66] {msg}'] if shown else [])
+
+
+@pytest.mark.parametrize('msg, shown', [
+    ('Refused to apply inline style', False),
+    ('Other error', True),
+])
+def test_javascript_log_message_fallback(config_stub, monkeypatch, msg, shown):
+    ui_messages = []
+    logger_messages = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, usertypes.JsLogLevel.error,
+                        ui_messages.append)
+    monkeypatch.setitem(shared._JS_LOGMAP, 'debug', logger_messages.append)
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:*': ['Refused to apply inline style*'],
+    }
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:_qute_stylesheet', 66, msg)
+
+    assert ui_messages == ([f'JS: [userscript:_qute_stylesheet:66] {msg}']
+                           if shown else [])
+    assert logger_messages == ([] if shown else
+                               [f'[userscript:_qute_stylesheet:66] {msg}'])
+
+
+@pytest.mark.parametrize('level', [usertypes.JsLogLevel.info,
+                                   usertypes.JsLogLevel.warning,
+                                   usertypes.JsLogLevel.error])
+def test_js_log_to_ui_level(config_stub, monkeypatch, level):
+    ui_messages = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, level, ui_messages.append)
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['info', 'warning', 'error'],
+    }
+
+    assert shared._js_log_to_ui(level, 'userscript:example', 7, 'Problem')
+    assert ui_messages == ['JS: [userscript:example:7] Problem']
