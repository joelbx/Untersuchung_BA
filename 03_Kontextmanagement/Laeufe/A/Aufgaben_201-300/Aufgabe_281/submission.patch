 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const prepareBulkIncrements = require('../bulk-increments');
+	const bulkIncrementScript = `
+		for i = 1, #ARGV, 2 do
+			local value = redis.call('HGET', KEYS[1], ARGV[i])
+			if value and not string.match(value, '^%-?%d+$') then
+				return redis.error_reply('Field is not an integer: ' .. ARGV[i])
+			end
+			if value then
+				local current = tonumber(value)
+				local increment = tonumber(ARGV[i + 1])
+				if not current or not increment or math.abs(current + increment) > 9007199254740991 then
+					return redis.error_reply('Increment result is out of range: ' .. ARGV[i])
+				end
+			end
+		end
+		for i = 1, #ARGV, 2 do
+			redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+		end
+		return 1
+	`;
 
 	const cache = require('../cache').create('redis');
 
@@ -219,4 +239,22 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const updates = prepareBulkIncrements(data);
+		if (!updates.length) {
+			return;
+		}
+		const batch = module.client.batch();
+		updates.forEach(([key, increments]) => {
+			const args = Object.entries(increments).flatMap(([field, value]) => [field, String(value)]);
+			batch.eval(bulkIncrementScript, 1, key, ...args);
+		});
+		const results = await batch.exec();
+		cache.del(updates.filter((item, index) => !results[index][0]).map(([key]) => key));
+		const failure = results.find(([err]) => err);
+		if (failure) {
+			throw failure[0];
+		}
+	};
 };
