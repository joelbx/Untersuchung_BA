diff --git a/src/database/bulk-increments.js b/src/database/bulk-increments.js
new file mode 100644
index 0000000..cea7f56
--- /dev/null
+++ b/src/database/bulk-increments.js
@@ -0,0 +1,36 @@
+'use strict';
+
+module.exports = function (data, fieldToString = String) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const byKey = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must be [key, increments] tuples');
+		}
+		const [key, increments] = item;
+		if (!byKey.has(key)) {
+			byKey.set(key, {});
+		}
+		const fields = byKey.get(key);
+		Object.entries(increments).forEach(([field, value]) => {
+			const normalized = fieldToString(field);
+			if (typeof normalized !== 'string' || !normalized ||
+				['__proto__', 'constructor', 'prototype'].includes(normalized) || /[.$]/.test(field) || /[.$]/.test(normalized)) {
+				throw new TypeError(`Invalid increment field: ${field}`);
+			}
+			if (!Number.isSafeInteger(value)) {
+				throw new TypeError(`Increment for ${field} must be a safe integer`);
+			}
+			const total = (fields[normalized] || 0) + value;
+			if (!Number.isSafeInteger(total)) {
+				throw new TypeError(`Combined increment for ${field} must be a safe integer`);
+			}
+			fields[normalized] = total;
+		});
+	});
+	return [...byKey].filter(([, fields]) => Object.keys(fields).length);
+};
