+
+	module.incrObjectFieldByBulk = async function (data) {
+		const updates = prepareBulkIncrements(data, helpers.fieldToString);
+		if (!updates.length) {
+			return;
+		}
+		const operations = updates.map(([key, increments]) => ({
+			updateOne: {
+				filter: { _key: key },
+				update: { $inc: increments },
+				upsert: true,
+			},
+		}));
+		try {
+			await module.client.collection('objects').bulkWrite(operations, { ordered: false });
+			cache.del(updates.map(([key]) => key));
+		} catch (err) {
+			// Unordered writes can succeed for other keys even when one update fails.
+			const writeErrors = err.writeErrors || (err.result && err.result.writeErrors);
+			if (Array.isArray(writeErrors)) {
+				const failed = new Set(writeErrors.map(error => error.index));
+				cache.del(updates.filter((item, index) => !failed.has(index)).map(([key]) => key));
+			}
+			throw err;
+		}
+	};
 };
