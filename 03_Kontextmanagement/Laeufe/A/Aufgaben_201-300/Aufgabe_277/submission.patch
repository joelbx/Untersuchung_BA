+
+func TestRuleSegmentKeys(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		keys      []string
+		legacyKey string
+		wantKey   string
+		wantOp    string
+	}{
+		{"legacy", nil, "old", "old", ""},
+		{"single", []string{"first"}, "old", "first", ""},
+		{"multiple", []string{"first", "second"}, "old", "first,second", "AND_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{
+				SegmentKey: tc.legacyKey, SegmentKeys: tc.keys,
+				SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+			})
+			assert.Equal(t, tc.wantKey, rule.SegmentKey)
+			assert.Equal(t, tc.wantOp, rule.SegmentOperator)
+			encoded, err := json.Marshal(rule)
+			assert.NoError(t, err)
+			if tc.wantOp == "" {
+				assert.NotContains(t, string(encoded), `"segment_operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"segment_operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
+
+func TestRolloutSegmentKeys(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		keys      []string
+		legacyKey string
+		wantKey   string
+		wantOp    string
+	}{
+		{"legacy", nil, "old", "old", ""},
+		{"single", []string{"first"}, "old", "first", ""},
+		{"multiple", []string{"first", "second"}, "old", "first,second", "AND_SEGMENT_OPERATOR"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{
+				Segment: &flipt.RolloutSegment{
+					SegmentKey: tc.legacyKey, SegmentKeys: tc.keys, Value: true,
+					SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+				},
+			}})
+			if assert.NotNil(t, rollout.Segment) {
+				assert.Equal(t, tc.wantKey, rollout.Segment.Key)
+				assert.True(t, rollout.Segment.Value)
+				assert.Equal(t, tc.wantOp, rollout.Segment.Operator)
+			}
+			encoded, err := json.Marshal(rollout)
+			assert.NoError(t, err)
+			if tc.wantOp == "" {
+				assert.NotContains(t, string(encoded), `"operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
