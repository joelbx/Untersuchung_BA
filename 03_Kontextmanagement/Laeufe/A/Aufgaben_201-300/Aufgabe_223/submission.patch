@@ -41,3 +42,55 @@ def test_shebang_task_vars(fake_old_module_open, templar):
 
     (data, style, shebang) = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
     assert shebang == '#!/usr/bin/python3'
+
+
+@pytest.mark.parametrize('source, expected', [
+    (b'#!/usr/bin/python3.8 -I\nprint("hello")\n', '#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -OO\nprint("hello")\n', '#!/opt/venv/bin/python -OO'),
+    (b'#!/usr/bin/ruby -w\nputs "hello"\n', '#!/usr/bin/ruby -w'),
+    (b'#!/usr/bin/ruby  -w "two words"\nputs "hello"\n', '#!/usr/bin/ruby  -w "two words"'),
+    (b'print("hello")\n', '#!/usr/bin/python'),
+])
+def test_source_shebang(tmp_path, templar, source, expected):
+    module_path = tmp_path / 'module'
+    module_path.write_bytes(source)
+    data, style, shebang = modify_module('module', str(module_path), {}, templar)
+    assert shebang == expected
+    assert data.startswith(expected.encode() + b'\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_source_shebang_override(tmp_path, templar):
+    module_path = tmp_path / 'module'
+    module_path.write_bytes(b'#!/usr/bin/python3.8 -I\nprint("hello")\n')
+    data, style, shebang = modify_module('module', str(module_path), {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/opt/python/bin/python'})
+    assert shebang == '#!/opt/python/bin/python -I'
+    assert data.startswith(b'#!/opt/python/bin/python -I\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_new_style_source_shebang(tmp_path, templar):
+    module_path = tmp_path / 'module.py'
+    module_path.write_bytes(b'#!/opt/venv/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    data, style, shebang = modify_module('module', str(module_path), {}, templar)
+    assert style == 'new'
+    assert shebang == '#!/opt/venv/bin/python3.8 -I'
+    assert data.startswith(b'#!/opt/venv/bin/python3.8 -I\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_new_style_source_shebang_override(tmp_path, templar):
+    module_path = tmp_path / 'module.py'
+    module_path.write_bytes(b'#!/opt/venv/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    data, style, shebang = modify_module('module', str(module_path), {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/usr/bin/python3'})
+    assert style == 'new'
+    assert shebang == '#!/usr/bin/python3 -I'
+    assert data.startswith(b'#!/usr/bin/python3 -I\n' + b_ENCODING_STRING + b'\n')
+
+
+def test_new_style_without_shebang(tmp_path, templar):
+    module_path = tmp_path / 'module.py'
+    module_path.write_bytes(b'from ansible.module_utils.basic import AnsibleModule\n')
+    data, style, shebang = modify_module('module', str(module_path), {}, templar)
+    assert style == 'new'
+    assert shebang == '#!/usr/bin/python'
+    assert data.startswith(b'#!/usr/bin/python\n' + b_ENCODING_STRING + b'\n')
