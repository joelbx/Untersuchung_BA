diff --git a/applications/mail/src/app/logic/elements/elementsSlice.test.ts b/applications/mail/src/app/logic/elements/elementsSlice.test.ts
new file mode 100644
index 0000000..67f2f43
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsSlice.test.ts
@@ -0,0 +1,92 @@
+import { configureStore } from '@reduxjs/toolkit';
+import { Api } from '@proton/shared/lib/interfaces';
+import elementsReducer, { newState } from './elementsSlice';
+import { backendActionFinished, backendActionStarted, load } from './elementsActions';
+import { QueryResults } from './elementsTypes';
+import * as elementQuery from './helpers/elementQuery';
+
+describe('elements list request state', () => {
+    afterEach(() => {
+        jest.useRealTimers();
+        jest.restoreAllMocks();
+    });
+
+    const createStore = () =>
+        configureStore({
+            reducer: { elements: elementsReducer },
+            middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+        });
+    const queryParams = () => ({
+        api: jest.fn() as unknown as Api,
+        abortController: undefined,
+        conversationMode: true,
+        page: 0,
+        params: newState().params,
+    });
+
+    it('tracks overlapping backend actions', () => {
+        const store = createStore();
+        store.dispatch(backendActionStarted());
+        store.dispatch(backendActionStarted());
+        expect(store.getState().elements.pendingActions).toBe(2);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(1);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(0);
+    });
+
+    it('rejects stale data and retries after one second without committing it', async () => {
+        jest.useFakeTimers();
+        const store = createStore();
+        jest.spyOn(elementQuery, 'queryElements').mockResolvedValue({
+            abortController: new AbortController(),
+            Total: 1,
+            Elements: [{ ID: 'stale' }],
+            Stale: 1,
+        });
+
+        const result = await store.dispatch(load(queryParams()));
+        expect(load.rejected.match(result)).toBe(true);
+        expect(store.getState().elements.pages).toEqual([]);
+        expect(store.getState().elements.elements).toEqual({});
+
+        jest.advanceTimersByTime(1000);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error: undefined });
+    });
+
+    it('discards a response received while a backend action is pending', async () => {
+        jest.useFakeTimers();
+        const store = createStore();
+        let resolveQuery!: (result: QueryResults) => void;
+        jest.spyOn(elementQuery, 'queryElements').mockImplementation(
+            () => new Promise((resolve) => (resolveQuery = resolve))
+        );
+
+        const request = store.dispatch(load(queryParams()));
+        store.dispatch(backendActionStarted());
+        resolveQuery({ abortController: new AbortController(), Total: 1, Elements: [{ ID: 'old' }], Stale: 0 });
+        expect(load.rejected.match(await request)).toBe(true);
+        expect(store.getState().elements.elements).toEqual({});
+
+        jest.advanceTimersByTime(1000);
+        expect(store.getState().elements.retry.count).toBe(1);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(0);
+    });
+
+    it('retries failed requests after two seconds', async () => {
+        jest.useFakeTimers();
+        const store = createStore();
+        const error = new Error('fetch failed');
+        jest.spyOn(elementQuery, 'queryElements').mockRejectedValue(error);
+
+        const result = await store.dispatch(load(queryParams()));
+        expect(load.rejected.match(result)).toBe(true);
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error });
+    });
+});
