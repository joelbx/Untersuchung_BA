+package util
+
+import "testing"
+
+func TestMajorWithEpoch(t *testing.T) {
+	for input, want := range map[string]string{"": "", "4.1": "4", "0:4.1": "4", "0:4": "4"} {
+		if got := Major(input); got != want {
+			t.Errorf("Major(%q) = %q, want %q", input, got, want)
+		}
+	}
+}
