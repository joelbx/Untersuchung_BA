diff --git a/config/os.go b/config/os.go
new file mode 100644
index 0000000..1948c25
--- /dev/null
+++ b/config/os.go
@@ -0,0 +1,110 @@
+package config
+
+import (
+	"strings"
+	"time"
+)
+
+// OS families used by scan results and lifecycle lookups.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// EOL describes the end of the standard and optional extended support phases.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support ended before now.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether an applicable extended phase ended before now.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+type supportDates struct{ standard, extended string }
+
+var eolDates = map[string]map[string]supportDates{
+	Amazon: {
+		"2018.03":   {"2023-06-30", "2023-06-30"},
+		"2 (Karoo)": {"2025-06-30", ""},
+	},
+	RedHat: {
+		"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""},
+		"6": {"2020-11-30", "2024-06-30"},
+	},
+	CentOS: {
+		"7": {"2024-06-30", ""}, "8": {"2021-12-31", ""},
+		"6": {"2020-11-30", "2020-11-30"},
+	},
+	Oracle: {
+		"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""},
+		"6": {"2021-03-31", "2022-03-31"},
+	},
+	Ubuntu: {
+		"18.04": {"2023-05-31", "2028-04-30"},
+		"14.04": {"2019-04-30", "2024-04-30"},
+		"14.10": {"2015-07-30", "2015-07-30"},
+		"21.04": {"2022-01-30", ""},
+	},
+	Debian: {
+		"9": {"2022-06-30", ""}, "10": {"2024-06-30", ""},
+		"8": {"2020-06-30", "2020-06-30"},
+	},
+	Alpine: {
+		"3.10": {"2021-05-30", ""}, "3.11": {"2021-11-30", ""},
+		"3.12": {"2022-05-30", ""}, "3.9": {"2020-11-30", "2020-11-30"},
+	},
+	FreeBSD: {
+		"11": {"2021-09-30", "2021-09-30"},
+		"12": {"2023-12-31", ""},
+		"10": {"2019-10-30", "2019-10-30"},
+	},
+}
+
+// GetEOL looks up a modeled OS family and release. Unknown releases are absent.
+func GetEOL(family, release string) (EOL, bool) {
+	date, found := eolDates[family][release]
+	if !found {
+		return EOL{}, false
+	}
+	standard, _ := time.Parse("2006-01-02", date.standard)
+	var extended time.Time
+	if date.extended != "" {
+		extended, _ = time.Parse("2006-01-02", date.extended)
+	}
+	return EOL{StandardSupportUntil: standard, ExtendedSupportUntil: extended}, true
+}
+
+// Major extracts the first version component after an optional epoch.
+// It lives here so config can use it without importing util (which imports config).
+func Major(version string) string {
+	if i := strings.IndexByte(version, ':'); i >= 0 {
+		version = version[i+1:]
+	}
+	if i := strings.IndexByte(version, '.'); i >= 0 {
+		return version[:i]
+	}
+	return version
+}
diff --git a/config/os_test.go b/config/os_test.go
new file mode 100644
index 0000000..a7ea562
--- /dev/null
+++ b/config/os_test.go
@@ -0,0 +1,26 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestEOLBoundariesAndUnknown(t *testing.T) {
+	e, found := GetEOL(Ubuntu, "14.04")
+	if !found || e.StandardSupportUntil.Format("2006-01-02") != "2019-04-30" || e.ExtendedSupportUntil.Format("2006-01-02") != "2024-04-30" {
+		t.Fatalf("unexpected lifecycle: %+v, found=%t", e, found)
+	}
+	if e.IsStandardSupportEnded(e.StandardSupportUntil) || !e.IsStandardSupportEnded(e.StandardSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("standard support boundary incorrect")
+	}
+	if e.IsExtendedSuppportEnded(e.ExtendedSupportUntil) || !e.IsExtendedSuppportEnded(e.ExtendedSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("extended support boundary incorrect")
+	}
+	noExtended, found := GetEOL(Debian, "9")
+	if !found || noExtended.IsExtendedSuppportEnded(time.Now()) {
+		t.Fatal("absent extended support must not count as ended")
+	}
+	if _, found := GetEOL(Ubuntu, "12.10"); found {
+		t.Fatal("unmodeled release was found")
+	}
+}
