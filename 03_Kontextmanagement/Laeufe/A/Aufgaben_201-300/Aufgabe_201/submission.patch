+
+// A single referenced segment always uses OR semantics, regardless of the
+// operator supplied by a caller or stored by an older version.
+func singleSegmentOperator(keys []string, operator flipt.SegmentOperator) flipt.SegmentOperator {
+	if len(keys) == 1 {
+		return flipt.SegmentOperator_OR_SEGMENT_OPERATOR
+	}
+	return operator
