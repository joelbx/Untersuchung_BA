+	snapshot, err := snapshotFromReaders(strings.NewReader(document))
+	require.NoError(t, err)
+	rules, err := snapshot.ListRules(context.Background(), flipt.DefaultNamespace, "flag1")
+	require.NoError(t, err)
+	require.Len(t, rules.Results, 3)
+	assert.Equal(t, "first", rules.Results[0].SegmentKey)
+	assert.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rules.Results[0].SegmentOperator)
+	assert.Equal(t, []string{"first", "second"}, rules.Results[1].SegmentKeys)
+	assert.Equal(t, flipt.SegmentOperator_AND_SEGMENT_OPERATOR, rules.Results[1].SegmentOperator)
+	assert.Equal(t, "second", rules.Results[2].SegmentKey)
+	assert.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rules.Results[2].SegmentOperator)
+}
