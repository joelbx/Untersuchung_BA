index 0000000..ca70b3e
--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,72 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestRuleSegmentFormats(t *testing.T) {
+	for _, tc := range []struct {
+		name, input string
+		keys        []string
+		operator    flipt.SegmentOperator
+	}{
+		{"string", "segment: foo\n", []string{"foo"}, flipt.SegmentOperator_OR_SEGMENT_OPERATOR},
+		{"object", "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n", []string{"foo", "bar"}, flipt.SegmentOperator_AND_SEGMENT_OPERATOR},
+		{"single object falls back", "segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR\n", []string{"foo"}, flipt.SegmentOperator_OR_SEGMENT_OPERATOR},
+		{"single object ignores operator", "segment:\n  keys: [foo]\n  operator: arbitrary\n", []string{"foo"}, flipt.SegmentOperator_OR_SEGMENT_OPERATOR},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var rule Rule
+			require.NoError(t, yaml.Unmarshal([]byte(tc.input), &rule))
+			keys, operator, err := rule.Segment.KeysAndOperator()
+			require.NoError(t, err)
+			require.Equal(t, tc.keys, keys)
+			require.Equal(t, tc.operator, operator)
+		})
+	}
+	var v3 Rule
+	require.NoError(t, yamlv3.Unmarshal([]byte("segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n"), &v3))
+	keys, operator, err := v3.Segment.KeysAndOperator()
+	require.NoError(t, err)
+	require.Equal(t, []string{"foo", "bar"}, keys)
+	require.Equal(t, flipt.SegmentOperator_AND_SEGMENT_OPERATOR, operator)
+}
+
+func TestRuleSegmentRejectsInvalidShapes(t *testing.T) {
+	for _, input := range []string{
+		"segment: []\n", "segment: 42\n", "segment: ''\n",
+		"segment:\n  keys: []\n  operator: AND_SEGMENT_OPERATOR\n",
+		"segment:\n  keys: [foo, bar]\n  operator: invalid\n",
+		"segment:\n  keys: [foo]\n",
+		"segment:\n  keys: [foo]\n  operator: OR_SEGMENT_OPERATOR\n  extra: value\n",
+	} {
+		var rule Rule
+		require.Error(t, yaml.Unmarshal([]byte(input), &rule), input)
+	}
+	var rule Rule
+	require.NoError(t, yaml.Unmarshal([]byte("distributions: []\n"), &rule))
+	_, _, err := rule.Segment.KeysAndOperator()
+	require.Error(t, err)
+}
+
+func TestSegmentEmbedMarshalYAML(t *testing.T) {
+	for _, tc := range []struct {
+		segment  IsSegment
+		expected string
+	}{
+		{SegmentKey("foo"), "foo\n"},
+		{Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}, "keys:\n- foo\n- bar\noperator: AND_SEGMENT_OPERATOR\n"},
+		{Segments{Keys: []string{"foo"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}, "keys:\n- foo\noperator: OR_SEGMENT_OPERATOR\n"},
+	} {
+		output, err := yaml.Marshal(&SegmentEmbed{Segment: tc.segment})
+		require.NoError(t, err)
+		require.YAMLEq(t, tc.expected, string(output))
+	}
+	_, err := yaml.Marshal(&SegmentEmbed{})
+	require.Error(t, err)
+}
