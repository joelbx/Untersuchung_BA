-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct {
+	Segment IsSegment `yaml:"-"`
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil {
+		return nil, fmt.Errorf("segment is missing")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, fmt.Errorf("segment key is empty")
+		}
+		return string(v), nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, err
+		}
+		if len(v.Keys) == 1 {
+			v.SegmentOperator = flipt.SegmentOperator_OR_SEGMENT_OPERATOR.String()
+		}
+		return v, nil
+	default:
+		return nil, fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		if v == "" {
+			return fmt.Errorf("segment key is empty")
+		}
+		s.Segment = SegmentKey(v)
+	case map[string]interface{}:
+		converted := make(map[interface{}]interface{}, len(v))
+		for key, value := range v {
+			converted[key] = value
+		}
+		return s.unmarshalObject(converted)
+	case map[interface{}]interface{}:
+		return s.unmarshalObject(v)
+	default:
+		return fmt.Errorf("segment must be a string or keys/operator object")
+	}
+	return nil
+}
+
+func (s *SegmentEmbed) unmarshalObject(v map[interface{}]interface{}) error {
+	if len(v) != 2 {
+		return fmt.Errorf("segment object requires keys and operator")
+	}
+	keysRaw, ok := v["keys"].([]interface{})
+	if !ok {
+		return fmt.Errorf("segment keys must be a list")
+	}
+	op, ok := v["operator"].(string)
+	if !ok {
+		return fmt.Errorf("segment operator must be a string")
+	}
+	keys := make([]string, 0, len(keysRaw))
+	for _, key := range keysRaw {
+		value, ok := key.(string)
+		if !ok || value == "" {
+			return fmt.Errorf("segment keys must be nonempty strings")
+		}
+		keys = append(keys, value)
+	}
+	segments := Segments{Keys: keys, SegmentOperator: op}
+	if err := validateSegments(segments); err != nil {
+		return err
+	}
+	s.Segment = segments
+	return nil
+}
+
+func validateSegments(s Segments) error {
+	if len(s.Keys) == 0 {
+		return fmt.Errorf("segment keys are required")
+	}
+	for _, key := range s.Keys {
+		if key == "" {
+			return fmt.Errorf("segment keys must be nonempty strings")
+		}
+	}
+	if len(s.Keys) > 1 && s.SegmentOperator != flipt.SegmentOperator_AND_SEGMENT_OPERATOR.String() && s.SegmentOperator != flipt.SegmentOperator_OR_SEGMENT_OPERATOR.String() {
+		return fmt.Errorf("invalid segment operator %q", s.SegmentOperator)
+	}
+	return nil
+}
+
+func (s *SegmentEmbed) KeysAndOperator() ([]string, flipt.SegmentOperator, error) {
+	if s == nil {
+		return nil, 0, fmt.Errorf("segment is required")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, 0, fmt.Errorf("segment key is empty")
+		}
+		return []string{string(v)}, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, 0, err
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, nil
+		}
+		return v.Keys, flipt.SegmentOperator(flipt.SegmentOperator_value[v.SegmentOperator]), nil
+	default:
+		return nil, 0, fmt.Errorf("invalid segment type %T", s.Segment)
+	}
 }
 
