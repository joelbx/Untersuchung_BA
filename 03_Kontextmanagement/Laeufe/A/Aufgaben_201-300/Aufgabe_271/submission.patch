+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Sort raw ISBN metadata by length without validating its contents."""
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    for value in [isbns] if isinstance(isbns, str) else isbns:
+        value = value.strip()
+        if len(value) == 10:
+            isbn_10.append(value)
+        elif len(value) == 13:
+            isbn_13.append(value)
+    return isbn_10, isbn_13
+
