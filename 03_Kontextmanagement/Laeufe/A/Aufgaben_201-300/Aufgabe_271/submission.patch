+def get_location_and_publisher(loc_pub: str) -> tuple[list[str], list[str]]:
+    """Extract ordered publication places and publishers from IA metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub:
+        return [], []
+
+    loc_pub = loc_pub.replace(UNIDENTIFIED_PLACE, '')
+
+    def clean(part: str) -> str:
+        return part.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+
+    if ':' not in loc_pub:
+        publisher = clean(loc_pub.split(',', 1)[1] if ',' in loc_pub else loc_pub)
+        return [], [publisher] if publisher else []
+
+    locations: list[str] = []
+    publishers: list[str] = []
+    pending_locations: list[str] = []
+    for segment in loc_pub.split(';'):
+        if ':' not in segment:
+            location = clean(segment)
+            if location:
+                pending_locations.append(location)
+            continue
+
+        # Text after a second colon cannot be interpreted as another pair.
+        location, publisher, *_ = segment.split(':', 2)
+        location, publisher = get_colon_only_loc_pub(location + ':' + publisher)
+        locations.extend(pending_locations)
+        pending_locations = []
+        if location := clean(location):
+            locations.append(location)
+        if publisher := clean(publisher):
+            publishers.append(publisher)
+
+    return locations, publishers
 
 
