diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..e4c678c
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,58 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		close(started)
+		<-release
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	p.Poll()
+
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("update did not start")
+	}
+
+	closed := make(chan struct{})
+	go func() {
+		_ = p.Close()
+		close(closed)
+	}()
+	<-p.ctx.Done()
+	select {
+	case <-closed:
+		t.Fatal("Close returned while update was running")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not wait for polling to stop")
+	}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPollerCloseBeforePoll(t *testing.T) {
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		t.Fatal("update called after Close")
+		return false, nil
+	})
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+	p.Poll()
+}
