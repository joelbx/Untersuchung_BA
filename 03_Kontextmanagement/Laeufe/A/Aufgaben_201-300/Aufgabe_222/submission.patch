+@pytest.mark.parametrize('collection, expected_name', [('', 'sample'), ('namespace.collection', 'namespace.collection.sample')])
+def test_role_build_doc(collection, expected_name):
+    main = {'short_description': 'Main', 'options': {'value': {'type': 'str'}}}
+    alternate = {'short_description': 'Alternate'}
+    argspec = {'main': main, 'alternate': alternate}
+    mixin = RoleMixin()
+
+    assert mixin._build_doc('sample', '/roles/sample', collection, argspec) == (
+        expected_name,
+        {'path': '/roles/sample', 'collection': collection, 'entry_points': argspec},
+    )
+    assert mixin._build_doc('sample', '/roles/sample', collection, argspec, 'main') == (
+        expected_name,
+        {'path': '/roles/sample', 'collection': collection, 'entry_points': {'main': main}},
+    )
+    assert mixin._build_doc('sample', '/roles/sample', collection, argspec, 'missing') == (expected_name, None)
+    assert mixin._build_doc('sample', '/roles/sample', collection, {}) == (expected_name, None)
+
+
+def test_create_role_doc_filters_entry_points(monkeypatch):
+    mixin = RoleMixin()
+    main = {'short_description': 'Main', 'options': {'value': {'type': 'str'}}}
+    monkeypatch.setattr(mixin, '_find_all_normal_roles', lambda *args, **kwargs: {('sample', '/roles/sample')})
+    monkeypatch.setattr(mixin, '_find_all_collection_roles', lambda *args, **kwargs: {('other', 'namespace.collection', '/collections/path')})
+    monkeypatch.setattr(mixin, '_load_argspec', lambda role, **kwargs: {'main': main} if role == 'sample' else {'alternate': {}})
+
+    assert mixin._create_role_doc(('sample', 'other'), ('/roles',), entry_point='main') == {
+        'sample': {'path': '/roles/sample', 'collection': '', 'entry_points': {'main': main}},
+    }
