+// gatewayTLSCredentials trusts the configured server certificate and uses one
+// of its subject alternative names for hostname verification. The gateway may
+// dial a wildcard listener through loopback, which is not normally in the cert.
+func gatewayTLSCredentials(certFile string) (credentials.TransportCredentials, error) {
+	data, err := ioutil.ReadFile(certFile)
+	if err != nil {
+		return nil, err
+	}
+	block, _ := pem.Decode(data)
+	if block == nil {
+		return nil, fmt.Errorf("invalid TLS certificate at %q", certFile)
+	}
+	cert, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	serverName := ""
+	if len(cert.DNSNames) > 0 {
+		serverName = cert.DNSNames[0]
+	} else if len(cert.IPAddresses) > 0 {
+		serverName = cert.IPAddresses[0].String()
+	}
+	return credentials.NewClientTLSFromFile(certFile, serverName)
+}
