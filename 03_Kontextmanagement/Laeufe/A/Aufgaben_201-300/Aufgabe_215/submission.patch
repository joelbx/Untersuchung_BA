+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, contents string) string {
+	t.Helper()
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "config.yml")
+	if err := ioutil.WriteFile(path, []byte(contents), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	path := writeConfig(t, "server:\n  protocol: http\n")
+	defer os.RemoveAll(filepath.Dir(path))
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults differ: %#v", cfg)
+	}
+
+	os.Setenv("FLIPT_SERVER_HTTP_PORT", "8081")
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.HTTPPort != 8081 {
+		t.Fatalf("http port = %d", cfg.Server.HTTPPort)
+	}
+}
+
+func TestConfigureHTTPSAndOrigins(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert, key := filepath.Join(dir, "cert.pem"), filepath.Join(dir, "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := ioutil.WriteFile(path, []byte("test"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	yaml := "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins:\n    - foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: " + cert + "\n  cert_key: " + key + "\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n"
+	path := writeConfig(t, yaml)
+	defer os.RemoveAll(filepath.Dir(path))
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server.Host != "127.0.0.1" || cfg.Server.Protocol != HTTPS || cfg.Server.HTTPPort != 8081 || cfg.Server.HTTPSPort != 8080 || cfg.Server.GRPCPort != 9001 || cfg.Server.CertFile != cert || cfg.Server.CertKey != key || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("advanced config: %#v", cfg)
+	}
+	yaml = strings.Replace(yaml, "  allowed_origins:\n    - foo.com", "  allowed_origins: foo.com", 1)
+	singlePath := writeConfig(t, yaml)
+	defer os.RemoveAll(filepath.Dir(singlePath))
+	single, err := configure(singlePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(single.Cors.AllowedOrigins, cfg.Cors.AllowedOrigins) {
+		t.Fatalf("origins differ: %v", single.Cors.AllowedOrigins)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	cases := []struct{ cert, key, want string }{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{"cert", "", "cert_key cannot be empty when using HTTPS"},
+		{"missing-cert", "key", "cannot find TLS cert_file at \"missing-cert\""},
+	}
+	for _, tc := range cases {
+		cfg.Server.CertFile, cfg.Server.CertKey = tc.cert, tc.key
+		if err := cfg.validate(); err == nil || err.Error() != tc.want {
+			t.Fatalf("validation = %v, want %s", err, tc.want)
+		}
+	}
+	cert := writeConfig(t, "certificate")
+	defer os.RemoveAll(filepath.Dir(cert))
+	cfg.Server.CertFile, cfg.Server.CertKey = cert, "missing-key"
+	if err := cfg.validate(); err == nil || err.Error() != "cannot find TLS cert_key at \"missing-key\"" {
+		t.Fatalf("missing key validation = %v", err)
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSchemeAndHandlers(t *testing.T) {
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("scheme strings")
+	}
+	for _, handler := range []interface {
+		ServeHTTP(w http.ResponseWriter, r *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, httptest.NewRequest("GET", "/", nil))
+		if w.Code != 200 || w.Body.Len() == 0 {
+			t.Fatalf("response: %d %q", w.Code, w.Body.String())
+		}
+	}
+}
