+def process_cover_url(
+    edition: dict, allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS
+) -> tuple[str | None, dict]:
+    """Extract an HTTP(S) cover URL from an allowed host, removing the cover field."""
+    cover_url = edition.pop('cover', None)
+    if not isinstance(cover_url, str):
+        return None, edition
+
+    try:
+        parsed = urlsplit(cover_url)
+        host = parsed.hostname
+    except ValueError:
+        return None, edition
+
+    if parsed.scheme.lower() in ('http', 'https') and host and host.casefold() in {
+        allowed_host.casefold() for allowed_host in allowed_cover_hosts
+    }:
+        return cover_url, edition
+    return None, edition
+
