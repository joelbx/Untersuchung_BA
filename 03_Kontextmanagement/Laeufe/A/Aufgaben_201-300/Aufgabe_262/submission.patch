+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('https://EXAMPLE.ORG/cover.jpg', 'https://EXAMPLE.ORG/cover.jpg'),
+        ('http://example.org/cover.jpg', 'http://example.org/cover.jpg'),
+        ('https://other.org/cover.jpg', None),
+        ('https://example.org.evil/cover.jpg', None),
+        ('ftp://example.org/cover.jpg', None),
+        ('https://[invalid/cover.jpg', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'Example', 'cover': cover}
+    url, updated = add_book.process_cover_url(edition, ['Example.Org'])
+    assert url == expected
+    assert updated is edition
+    assert updated == {'title': 'Example'}
+
+
+def test_process_cover_url_without_cover():
+    edition = {'title': 'Example'}
+    assert add_book.process_cover_url(edition) == (None, edition)
+
