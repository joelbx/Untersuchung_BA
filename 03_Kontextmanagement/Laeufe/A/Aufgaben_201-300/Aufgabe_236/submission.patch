+def test_safe_eval_deprecation():
+    before = len(get_deprecation_messages())
+    assert safe_eval("{'key': 'value'}") == {'key': 'value'}
+    notice, = get_deprecation_messages()[before:]
+    assert notice['version'] == '2.21'
+    assert 'safe_eval' in notice['msg']
+
+
+def test_check_type_dict_does_not_deprecate():
+    before = len(get_deprecation_messages())
+    assert check_type_dict("{'key': 'value'}") == {'key': 'value'}
+    assert len(get_deprecation_messages()) == before
+
+
+def test_check_type_dict_never_executes_input(monkeypatch):
+    def fail_if_called(command):
+        raise AssertionError('input was executed')
+
+    monkeypatch.setattr(os, 'system', fail_if_called)
+    with pytest.raises(TypeError, match='could not parse JSON'):
+        check_type_dict("{'key': __import__('os').system('echo unexpected')}")
+
+
+def test_check_type_dict_reports_non_dictionary():
+    with pytest.raises(TypeError, match='JSON value is a list'):
+        check_type_dict('[1, 2]')
+    with pytest.raises(TypeError, match='literal is a list'):
+        check_type_dict("['one', 'two']")
+    with pytest.raises(TypeError, match='key and value must be nonempty'):
+        check_type_dict('key=')
