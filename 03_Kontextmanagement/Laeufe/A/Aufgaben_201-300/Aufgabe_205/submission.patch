 'use strict';
 
+const crypto = require('crypto');
 const db = require('../database');
+const user = require('../user');
 
 const utils = module.exports;
 
-// internal token management utilities only
+// Internal token management utilities only.
+utils.tokens = {};
 
-utils.log = async (token) => {
+utils.tokens.list = async () => {
+	const tokens = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await utils.tokens.get(tokens);
+};
+
+utils.tokens.generate = async ({ uid, description = '' } = {}) => {
+	const numericUid = Number(uid);
+	if (uid === undefined || uid === null || !Number.isFinite(numericUid) ||
+		!Number.isInteger(numericUid) || numericUid < 0) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.exists(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = crypto.randomBytes(32).toString('hex');
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, {
+		uid: numericUid,
+		description: description,
+		timestamp: timestamp,
+	});
+	await db.sortedSetsAdd(['tokens:createtime', 'tokens:uid'], [timestamp, numericUid], token);
+	return token;
+};
+
+utils.tokens.get = async (tokens) => {
+	if (tokens === null || tokens === undefined ||
+		(!Array.isArray(tokens) && typeof tokens !== 'string')) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const isArray = Array.isArray(tokens);
+	const tokenList = isArray ? tokens : [tokens];
+	if (!tokenList.every(token => typeof token === 'string')) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokenList.length) {
+		return [];
+	}
+
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenList.map(token => `token:${token}`)),
+		utils.tokens.getLastSeen(tokenList),
+	]);
+	const results = objects.map((data, index) => data && ({
+		token: tokenList[index],
+		uid: Number(data.uid),
+		description: data.description === undefined ? '' : data.description,
+		timestamp: Number(data.timestamp),
+		lastSeen: lastSeen[index],
+	}));
+	return isArray ? results : results[0];
+};
+
+utils.tokens.update = async (token, { description } = {}) => {
+	if (typeof token !== 'string' || description === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await utils.tokens.get(token);
+};
+
+utils.tokens.delete = async (token) => {
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'], token),
+	]);
+};
+
+utils.tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.tokens.getLastSeen = async (tokens) => {
+	if (!Array.isArray(tokens)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokens.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokens);
+	return scores.map((score) => {
+		const numericScore = Number(score);
+		return score === null || score === undefined || !Number.isFinite(numericScore) ? null : numericScore;
+	});
+};
+
+// Existing authentication and admin callers use these names.
+utils.log = utils.tokens.log;
+utils.getLastSeen = utils.tokens.getLastSeen;
