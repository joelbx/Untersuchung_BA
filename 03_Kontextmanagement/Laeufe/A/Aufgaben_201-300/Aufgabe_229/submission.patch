diff --git a/test/image-cleanup.js b/test/image-cleanup.js
new file mode 100644
index 0000000..f56d79f
--- /dev/null
+++ b/test/image-cleanup.js
@@ -0,0 +1,74 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const nconf = require('nconf');
+
+const db = require('./mocks/databasemock');
+const User = require('../src/user');
+const Groups = require('../src/groups');
+const socketUser = require('../src/socket.io/user');
+
+describe('local image cleanup', () => {
+	const folder = path.join(nconf.get('upload_path'), 'profile');
+	const extensions = ['png', 'jpeg', 'jpg', 'bmp'];
+
+	async function createImages(uid) {
+		await fs.promises.mkdir(folder, { recursive: true });
+		const names = ['cover', 'avatar'].flatMap(type => extensions.map((ext, index) => `${uid}-profile${type}${index % 2 ? '-123456' : ''}.${ext}`));
+		await Promise.all(names.map(name => fs.promises.writeFile(path.join(folder, name), 'image')));
+		return names;
+	}
+
+	it('removes every user cover and avatar variant through the socket handlers', async () => {
+		const uid = await User.create({ username: 'imagecleanup1' });
+		const names = await createImages(uid);
+		const coverUrl = `${nconf.get('relative_path')}/assets/uploads/profile/${uid}-profilecover.png`;
+		const avatarUrl = `${nconf.get('relative_path')}/assets/uploads/profile/${uid}-profileavatar.png`;
+		await User.setUserFields(uid, {
+			'cover:url': coverUrl,
+			'cover:position': '50% 50%',
+			uploadedpicture: avatarUrl,
+			picture: avatarUrl,
+		});
+		assert(await User.getLocalCoverPath(uid));
+		assert(await User.getLocalAvatarPath(uid));
+		await socketUser.removeCover({ uid }, { uid });
+		await socketUser.removeUploadedPicture({ uid }, { uid });
+		assert.strictEqual(await User.getLocalCoverPath(uid), false);
+		assert.strictEqual(await User.getLocalAvatarPath(uid), false);
+		const fields = await User.getUserFields(uid, ['cover:url', 'cover:position', 'uploadedpicture', 'picture']);
+		assert(!fields['cover:url']);
+		assert(!fields['cover:position']);
+		assert.strictEqual(fields.uploadedpicture, '');
+		assert.strictEqual(fields.picture, '');
+		assert(names.every(name => !fs.existsSync(path.join(folder, name))));
+		await socketUser.removeCover({ uid }, { uid });
+		await socketUser.removeUploadedPicture({ uid }, { uid });
+	});
+
+	it('removes all profile variants on account deletion', async () => {
+		const uid = await User.create({ username: 'imagecleanup2' });
+		const names = await createImages(uid);
+		await User.deleteAccount(uid);
+		assert(names.every(name => !fs.existsSync(path.join(folder, name))));
+	});
+
+	it('removes local group cover and thumbnail files', async () => {
+		const groupName = 'ImageCleanupGroup';
+		await Groups.create({ name: groupName });
+		const filesFolder = path.join(nconf.get('upload_path'), 'files');
+		await fs.promises.mkdir(filesFolder, { recursive: true });
+		const names = ['groupCover-ImageCleanupGroup.png', 'groupCoverThumb-ImageCleanupGroup.png'];
+		await Promise.all(names.map(name => fs.promises.writeFile(path.join(filesFolder, name), 'image')));
+		await Groups.setGroupField(groupName, 'cover:url', `${nconf.get('relative_path')}/assets/uploads/files/${names[0]}`);
+		await Groups.setGroupField(groupName, 'cover:thumb:url', `${nconf.get('relative_path')}/assets/uploads/files/${names[1]}`);
+		await Groups.setGroupField(groupName, 'cover:position', '50% 50%');
+		await Groups.removeCover({ groupName });
+		const fields = await db.getObjectFields(`group:${groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
+		assert(!fields['cover:url'] && !fields['cover:thumb:url'] && !fields['cover:position']);
+		assert(names.every(name => !fs.existsSync(path.join(filesFolder, name))));
+		await Groups.removeCover({ groupName });
+	});
+});
