+func (s *Router) signLinkState(userId string) string {
+	payload, _ := json.Marshal(linkState{UserID: userId, Expires: time.Now().Add(10 * time.Minute).Unix()})
+	mac := hmac.New(sha256.New, s.linkStateSecret())
+	_, _ = mac.Write(payload)
+	return base64.RawURLEncoding.EncodeToString(payload) + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
+
+func (s *Router) parseLinkState(value string) (string, error) {
+	parts := bytes.Split([]byte(value), []byte("."))
+	if len(parts) != 2 {
+		return "", errors.New("invalid link state")
+	}
+	if len(s.linkStateSecret()) == 0 {
+		return "", errors.New("link state unavailable")
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(string(parts[0]))
+	if err != nil {
+		return "", errors.New("invalid link state")
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(string(parts[1]))
+	if err != nil {
+		return "", errors.New("invalid link state")
+	}
+	mac := hmac.New(sha256.New, s.linkStateSecret())
+	_, _ = mac.Write(payload)
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", errors.New("invalid link state")
+	}
+	var state linkState
+	if json.Unmarshal(payload, &state) != nil || state.UserID == "" || time.Now().Unix() >= state.Expires {
+		return "", errors.New("invalid link state")
+	}
+	return state.UserID, nil
