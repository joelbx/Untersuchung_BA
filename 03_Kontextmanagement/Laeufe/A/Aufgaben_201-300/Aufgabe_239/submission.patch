@@ -0,0 +1,48 @@
+package lastfm
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("LastFM link state", func() {
+	It("accepts a signed state for its user and rejects tampering", func() {
+		router := &Router{stateSecret: []byte("secret")}
+		state := router.signLinkState("user-a")
+		Expect(router.parseLinkState(state)).To(Equal("user-a"))
+		parts := strings.Split(state, ".")
+		tampered := "A" + parts[0][1:] + "." + parts[1]
+		_, err := router.parseLinkState(tampered)
+		Expect(err).To(HaveOccurred())
+	})
+
+	It("scopes link status and unlink to the authenticated user", func() {
+		ds := &tests.MockDataStore{}
+		keys := &sessionKeys{ds: ds}
+		Expect(keys.put(context.Background(), "user-a", "key-a")).To(Succeed())
+		Expect(keys.put(context.Background(), "user-b", "key-b")).To(Succeed())
+		router := &Router{sessionKeys: keys}
+		ctx := request.WithUser(context.Background(), model.User{ID: "user-a"})
+
+		status := httptest.NewRecorder()
+		router.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx))
+		Expect(status.Code).To(Equal(http.StatusOK))
+		Expect(status.Body.String()).To(ContainSubstring(`"status":true`))
+
+		unlink := httptest.NewRecorder()
+		router.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+		Expect(unlink.Code).To(Equal(http.StatusOK))
+		_, err := keys.get(context.Background(), "user-a")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(keys.get(context.Background(), "user-b")).To(Equal("key-b"))
+	})
+})
