@@ -4,6 +4,36 @@ import (
 	"testing"
 )
 
+func TestImageReference(t *testing.T) {
+	cases := []struct {
+		name     string
+		image    Image
+		fullName string
+		err      string
+	}{
+		{"tag", Image{Name: "registry/app", Tag: "latest"}, "registry/app:latest", ""},
+		{"digest", Image{Name: "registry/app", Digest: "sha256:abc"}, "registry/app@sha256:abc", ""},
+		{"missing name", Image{Tag: "latest"}, "", "Invalid arguments : no image name"},
+		{"missing identifier", Image{Name: "registry/app"}, "", "Invalid arguments : no image tag and digest"},
+		{"conflicting identifiers", Image{Name: "registry/app", Tag: "latest", Digest: "sha256:abc"}, "", "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := IsValidImage(tc.image)
+			if tc.err == "" {
+				if err != nil {
+					t.Fatalf("unexpected validation error: %v", err)
+				}
+				if got := tc.image.GetFullName(); got != tc.fullName {
+					t.Errorf("full name = %q, want %q", got, tc.fullName)
+				}
+			} else if err == nil || err.Error() != tc.err {
+				t.Errorf("validation error = %v, want %q", err, tc.err)
+			}
+		})
+	}
+}
