+		image Image
+		want  string
+	}{
+		{Image{Name: "registry/app", Tag: "v1"}, "registry/app:v1@0@host"},
+		{Image{Name: "registry/app", Digest: "sha256:abc"}, "registry/app@sha256:abc@0@host"},
+	} {
+		r := ScanResult{ServerName: "0@host", Image: tc.image}
+		if got := r.ReportFileName(); got != tc.want {
+			t.Errorf("report filename = %q, want %q", got, tc.want)
+		}
+		if got := r.FormatServerName(); got != tc.want {
+			t.Errorf("formatted name = %q, want %q", got, tc.want)
+		}
