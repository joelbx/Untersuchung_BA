+def add_db_name(rec: dict) -> None:
+    """Add each author's name and available dates as a comparison identifier."""
+    for author in rec.get('authors') or []:
+        birth_date = author.get('birth_date') or ''
+        death_date = author.get('death_date') or ''
+        if birth_date or death_date:
+            date = birth_date + '-' + death_date
+        else:
+            date = author.get('date') or ''
+        author['db_name'] = f"{author['name']} {date}" if date else author['name']
+
+
