@@ -814,6 +814,69 @@ collections:
     assert mock_install.call_args[0][7] is False
 
 
+@pytest.mark.parametrize('command, role_installed, collection_installed, skipped', [
+    ([], True, True, None),
+    (['-p', 'roles'], True, False, 'Collections cannot be installed to a roles path'),
+    (['role'], True, False, 'contains collections which will be ignored'),
+    (['collection'], False, True, 'contains roles which will be ignored'),
+])
+def test_mixed_requirements_install(reset_cli_args, tmp_path, monkeypatch, command,
+                                    role_installed, collection_installed, skipped):
+    requirements_file = to_text(tmp_path / 'requirements.yml')
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles:\n- test.role\ncollections:\n- test.collection\n')
+
+    role = MagicMock()
+    role.name = 'test.role'
+    role.install_info = None
+    role.install.return_value = True
+    monkeypatch.setattr(GalaxyCLI, '_parse_requirements_file', MagicMock(return_value={
+        'roles': [role], 'collections': [('test.collection', '*', None)],
+    }))
+    mock_install_collections = MagicMock()
+    monkeypatch.setattr(ansible.cli.galaxy, 'install_collections', mock_install_collections)
+    mock_warning = MagicMock()
+    mock_display = MagicMock()
+    monkeypatch.setattr(ansible.utils.display.Display, 'warning', mock_warning)
+    monkeypatch.setattr(ansible.utils.display.Display, 'display', mock_display)
+    monkeypatch.setattr(C, 'COLLECTIONS_PATHS', [to_text(tmp_path / 'collections')])
+
+    args = ['ansible-galaxy'] + command + ['install', '-r', requirements_file, '--no-deps'] if command[:1] in (['role'], ['collection']) else \
+        ['ansible-galaxy', 'install', '-r', requirements_file, '--no-deps'] + command
+    GalaxyCLI(args=args).run()
+
+    assert role.install.called is role_installed
+    assert mock_install_collections.called is collection_installed
+    if collection_installed:
+        assert mock_install_collections.call_args[0][0] == [('test.collection', '*', None)]
+        assert mock_install_collections.call_args[0][1] == to_text(tmp_path / 'collections' / 'ansible_collections')
+    if skipped:
+        messages = [str(call[0][0]) for call in mock_display.call_args_list + mock_warning.call_args_list]
+        assert any(skipped in message for message in messages)
+
+
+def test_empty_requirements_skip_install(reset_cli_args, tmp_path, monkeypatch, capsys):
+    requirements_file = to_text(tmp_path / 'requirements.yml')
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles: []\ncollections: []\n')
+    mock_install = MagicMock()
+    monkeypatch.setattr(ansible.cli.galaxy, 'install_collections', mock_install)
+
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+    assert 'Skipping install, no requirements found' in capsys.readouterr().out
+    assert not mock_install.called
+
+
+def test_invalid_role_requirements_extension(reset_cli_args, tmp_path):
+    requirements_file = to_text(tmp_path / 'requirements.txt')
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles: []\n')
+
+    with pytest.raises(AnsibleError, match='Invalid role requirements file'):
+        GalaxyCLI(args=['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+
