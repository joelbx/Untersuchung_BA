+func TestOvalResolutionFixStates(t *testing.T) {
+	states := []struct {
+		state    string
+		affected bool
+	}{
+		{"Will not fix", false}, {"Under investigation", false},
+		{"Fix deferred", true}, {"Affected", true}, {"Out of support scope", true}, {"", true},
+	}
+	for _, tc := range states {
+		def := ovalmodels.Definition{AffectedPacks: []ovalmodels.Package{{Name: "pkg", NotFixedYet: true}}}
+		if tc.state != "" {
+			def.Advisory.AffectedResolution = []ovalmodels.Resolution{{State: tc.state, Components: []ovalmodels.Component{{Component: "pkg"}}}}
+		}
+		affected, notFixedYet, state, _, err := isOvalDefAffected(def, request{packName: "pkg"}, constant.RedHat, "8", models.Kernel{}, nil)
+		if err != nil || affected != tc.affected || !notFixedYet || state != tc.state {
+			t.Errorf("%q: affected=%v notFixedYet=%v state=%q err=%v", tc.state, affected, notFixedYet, state, err)
+		}
+	}
+}
