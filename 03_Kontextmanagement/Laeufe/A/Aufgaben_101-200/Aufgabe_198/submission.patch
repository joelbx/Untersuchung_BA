+func TestOvalModularResolutionStatus(t *testing.T) {
+	def := ovalmodels.Definition{
+		AffectedPacks: []ovalmodels.Package{{Name: "nginx", NotFixedYet: true, ModularityLabel: "nginx:1.16:1234:context:x86_64"}},
+		Advisory: ovalmodels.Advisory{AffectedResolution: []ovalmodels.Resolution{
+			{State: "Will not fix", Components: []ovalmodels.Component{{Component: "nginx"}}},
+			{State: "Fix deferred", Components: []ovalmodels.Component{{Component: "nginx:1.16::nginx"}}},
+		}},
+	}
+	pack := request{packName: "nginx", versionRelease: "1.0-1.module+el8.1", arch: "x86_64"}
+	affected, unfixed, state, _, err := isOvalDefAffected(def, pack, constant.RedHat, "8", models.Kernel{}, []string{"nginx:1.16"})
+	if err != nil || !affected || !unfixed || state != "Fix deferred" {
+		t.Fatalf("got %v %v %q %v", affected, unfixed, state, err)
+	}
+	statuses := (defPacks{binpkgFixstat: map[string]fixStat{"nginx": {notFixedYet: unfixed, fixState: state}}}).toPackStatuses()
+	if len(statuses) != 1 || statuses[0].FixState != "Fix deferred" || !statuses[0].NotFixedYet {
+		t.Fatalf("statuses: %+v", statuses)
+	}
+}
