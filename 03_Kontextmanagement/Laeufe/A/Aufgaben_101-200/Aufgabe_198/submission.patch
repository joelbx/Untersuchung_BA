+func TestConvertToDistroAdvisoryIdentifier(t *testing.T) {
+	cases := []struct{ family, title, want string }{
+		{"redhat", "RHSA-2024:1234 Important", "RHSA-2024:1234"},
+		{"centos", "RHBA-2024:1234: bug fix", "RHBA-2024:1234"},
+		{"alma", "RHSA-2024:1234", "RHSA-2024:1234"},
+		{"rocky", "RHSA-2024:1234", "RHSA-2024:1234"},
+		{"oracle", "ELSA-2024-1234: security", "ELSA-2024-1234"},
+		{"amazon", "ALAS2023-2024-1234: security", "ALAS2023-2024-1234"},
+		{"fedora", "FEDORA-2024-1234: security", "FEDORA-2024-1234"},
+		{"redhat", "ELSA-2024-1234", ""},
+		{"oracle", "RHSA-2024:1234", ""},
+		{"fedora", "", ""},
+		{"redhat", "RHSA-", ""},
+		{"amazon", "ALAS", ""},
+		{"redhat", "CVE-2024-1234", ""},
+	}
+	for _, tc := range cases {
+		got := (RedHatBase{Base: Base{family: tc.family}}).convertToDistroAdvisory(&ovalmodels.Definition{Title: tc.title})
+		if tc.want == "" {
+			if got != nil {
+				t.Errorf("%s %q: expected nil, got %v", tc.family, tc.title, got)
+			}
+		} else if got == nil || got.AdvisoryID != tc.want {
+			t.Errorf("%s %q: expected %q, got %v", tc.family, tc.title, tc.want, got)
+		}
+	}
+}
