+    def test_match_set_requires_name_and_flags(self):
+        for incomplete in ({'match_set': 'admin_hosts'}, {'match_set_flags': 'src'}):
+            set_module_args(dict({'chain': 'INPUT'}, **incomplete))
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+                run_command.assert_not_called()
+
+    def test_match_set_flags_choices(self):
+        set_module_args({'chain': 'INPUT', 'match_set': 'admin_hosts', 'match_set_flags': 'source'})
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+            run_command.assert_not_called()
+
+    def test_match_set_name_is_not_empty(self):
+        for name in ('', '!'):
+            set_module_args({'chain': 'INPUT', 'match_set': name, 'match_set_flags': 'src'})
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+                run_command.assert_not_called()
+
+    def test_match_set_rule(self):
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            for match in ([], ['set']):
+                set_module_args({
+                    'chain': 'INPUT',
+                    'protocol': 'tcp',
+                    'destination_port': '22',
+                    'match': match,
+                    'match_set': 'admin_hosts',
+                    'match_set_flags': flags,
+                    'jump': 'ACCEPT',
+                    'comment': 'SSH from ipset',
+                })
+                with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                    run_command.side_effect = [(1, '', ''), (0, '', '')]
+                    with self.assertRaises(AnsibleExitJson) as result:
+                        iptables.main()
+                    self.assertTrue(result.exception.args[0]['changed'])
+
+                expected_rule = [
+                    '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', flags,
+                    '-j', 'ACCEPT', '--destination-port', '22',
+                    '-m', 'comment', '--comment', 'SSH from ipset',
+                ]
+                self.assertEqual(run_command.call_count, 2)
+                self.assertEqual(run_command.call_args_list[0][0][0],
+                                 ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'] + expected_rule)
+                self.assertEqual(run_command.call_args_list[1][0][0],
+                                 ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'] + expected_rule)
+
+    def test_match_set_inverted(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': '!admin_hosts',
+            'match_set_flags': 'src',
+            'jump': 'DROP',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args_list[0][0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'src', '-j', 'DROP',
+        ])
+
