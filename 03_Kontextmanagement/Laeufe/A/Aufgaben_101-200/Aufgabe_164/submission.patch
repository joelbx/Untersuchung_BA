+func TestImportNestedMetadataAndNamespace(t *testing.T) {
+	const yamlInput = `namespace:
+  key: production
+  name: Production
+  description: Live flags
+flags:
+  - key: nested
+    name: Nested
+    enabled: true
+    metadata:
+      settings:
+        regions:
+          - name: west
+            enabled: true
+          - name: east
+            enabled: false
+      labels: [blue, green]
+    variants:
+      - key: variant
+        attachment:
+          settings:
+            regions:
+              - name: west
+                enabled: true
+`
+	const jsonInput = `{"namespace":{"key":"production","name":"Production","description":"Live flags"},"flags":[{"key":"nested","name":"Nested","enabled":true,"metadata":{"settings":{"regions":[{"name":"west","enabled":true},{"name":"east","enabled":false}]},"labels":["blue","green"]},"variants":[{"key":"variant","attachment":{"settings":{"regions":[{"name":"west","enabled":true}]}}}]}]}`
+
+	tests := []struct {
+		name  string
+		enc   Encoding
+		input string
+	}{
+		{"yml", EncodingYML, yamlInput},
+		{"yaml", EncodingYAML, yamlInput},
+		{"json", EncodingJSON, jsonInput},
+		{"json with header", EncodingJSON, "# exported flags\n" + jsonInput},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "production", Name: "Production", Description: "Live flags"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "production", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{
+				"settings": map[string]any{"regions": []any{
+					map[string]any{"name": "west", "enabled": true},
+					map[string]any{"name": "east", "enabled": false},
+				}},
+				"labels": []any{"blue", "green"},
+			}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.Equal(t, "production", creator.variantReqs[0].NamespaceKey)
+			assert.JSONEq(t, `{"settings":{"regions":[{"name":"west","enabled":true}]}}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
