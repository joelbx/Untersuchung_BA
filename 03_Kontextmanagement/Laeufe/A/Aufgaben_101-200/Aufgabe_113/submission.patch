@@ -62,3 +62,86 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_mixed_and_scoped(self):
+        self.get_config.return_value = '''vrf context other
+  address-family ipv4 unicast
+    route-target import 1:1
+vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 2:2
+  address-family ipv6 unicast
+    route-target import 3:3
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='1:1', direction='import', state='absent'),
+            dict(rt='2:2', direction='export', state='absent'),
+            dict(rt='3:3'),
+        ]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target import 1:1', 'no route-target export 2:2',
+            'route-target import 3:3', 'route-target export 3:3',
+        ])
+
+    def test_route_targets_idempotent(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='1:1'), dict(rt='2:2', state='absent')]))
+        self.execute_module(changed=False, commands=[])
+
+    def test_route_targets_create_address_family(self):
+        self.get_config.return_value = 'vrf context ntc\n'
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[dict(rt='1:1')]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'route-target import 1:1', 'route-target export 1:1',
+        ])
+
+    def test_absent_ignores_route_targets(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='2:2')]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'no address-family ipv4 unicast',
+        ])
+
+    def test_auto_evpn_disable_with_route_target(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False,
+                             route_targets=[dict(rt='1:1', direction='export')]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target both auto evpn', 'route-target export 1:1',
+        ])
+
+    def test_route_target_requires_value(self):
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[dict(direction='import')]))
+        self.execute_module(failed=True)
+
+    def test_route_target_exact_match(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 11:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='1:1', direction='import'),
+            dict(rt='11:1', direction='import', state='absent'),
+        ]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'route-target import 1:1', 'no route-target import 11:1',
+        ])
