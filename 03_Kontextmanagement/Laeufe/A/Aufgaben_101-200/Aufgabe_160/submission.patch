+func TestSSHHeartbeatPeerAddress(t *testing.T) {
+	for _, tt := range []struct {
+		name, nodeAddr, peerAddr, want string
+	}{
+		{"IPv6 wildcard", "[::]:3022", "192.0.2.10:45678", "192.0.2.10:3022"},
+		{"IPv4 wildcard", "0.0.0.0:3022", "[2001:db8::1]:45678", "[2001:db8::1]:3022"},
+		{"loopback", "127.0.0.1:3022", "192.0.2.10:45678", "192.0.2.10:3022"},
+		{"routable", "192.0.2.20:3022", "192.0.2.10:45678", "192.0.2.20:3022"},
+		{"no peer", "[::]:3022", "", "[::]:3022"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
+			defer controller.Close()
+			upstream, _ := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peerAddr))
+			defer upstream.Close()
+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{
+				ServerID: "test-server",
+				Services: []types.SystemRole{types.RoleNode},
+			})
+			node := &types.ServerV2{Metadata: types.Metadata{Name: "test-server"}}
+			node.SetAddr(tt.nodeAddr)
+			require.NoError(t, controller.handleSSHServerHB(handle, node))
+			require.Equal(t, tt.want, auth.lastNodeAddr)
+		})
+	}
+}
