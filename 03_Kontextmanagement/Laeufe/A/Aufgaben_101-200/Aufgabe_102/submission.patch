+    def get_locally_reachable_ips(self, ip_path):
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, key in (('-4', 'ipv4'), ('-6', 'ipv6')):
+            if family == '-6' and not socket.has_ipv6:
+                continue
+
+            command = [ip_path, family, 'route', 'show', 'table', 'all', 'scope', 'host']
+            try:
+                rc, output, stderr = self.module.run_command(command, errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Unable to gather locally reachable %s routes' % key)
+                continue
+
+            networks = set()
+            for line in output.splitlines():
+                words = line.split()
+                if not words:
+                    continue
+                # Route types without local delivery cannot represent reachable IPs.
+                if words[0] in ('broadcast', 'blackhole', 'unreachable', 'prohibit', 'throw', 'nat'):
+                    continue
+                address = words[1] if words[0] in ('local', 'anycast', 'unicast') and len(words) > 1 else words[0]
+                try:
+                    network = ipaddress.ip_network(address, strict=False)
+                except ValueError:
+                    continue
+                if network.version != (4 if family == '-4' else 6):
+                    continue
+                networks.add(network)
+
+            reachable[key] = [
+                str(network.network_address) if network.prefixlen == network.max_prefixlen else str(network)
+                for network in sorted(networks, key=lambda network: (int(network.network_address), network.prefixlen))
+            ]
+        return reachable
