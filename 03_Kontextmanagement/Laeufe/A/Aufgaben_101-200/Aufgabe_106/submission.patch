+func TestFillWordPressIgnoreInactivePerServer(t *testing.T) {
+	oldConf := config.Conf
+	defer func() { config.Conf = oldConf }()
+	config.Conf.Servers = map[string]config.ServerInfo{
+		"wordpress-test": {WordPress: config.WordPressConf{IgnoreInactive: true}},
+	}
+	config.Conf.WpIgnoreInactive = false
+
+	packages := models.WordPressPackages{
+		{Name: "core", Type: models.WPCore, Version: "5.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Version: "1.0", Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Version: "1.0", Status: "inactive"},
+		{Name: "active-theme", Type: models.WPTheme, Version: "1.0", Status: "active"},
+		{Name: "inactive-theme", Type: models.WPTheme, Version: "1.0", Status: "inactive"},
+	}
+	pluginBody := `{"plugin":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`
+	themeBody := `{"theme":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`
+	cache := map[string]*string{
+		"50":              new(string),
+		"active-plugin":   &pluginBody,
+		"inactive-plugin": &pluginBody,
+		"active-theme":    &themeBody,
+		"inactive-theme":  &themeBody,
+	}
+	r := models.ScanResult{ServerName: "wordpress-test", WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+	n, err := FillWordPress(&r, "", cache)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 2 || len(r.ScannedCves) != 2 {
+		t.Fatalf("expected two active package vulnerabilities, got count %d and %d CVEs", n, len(r.ScannedCves))
+	}
+}
