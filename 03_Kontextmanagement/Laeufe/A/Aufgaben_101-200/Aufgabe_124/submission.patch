+
+type billingModeService struct {
+	dynamodbiface.DynamoDBAPI
+	create   *dynamodb.CreateTableInput
+	describe *dynamodb.DescribeTableOutput
+	err      error
+}
+
+func (s *billingModeService) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	s.create = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (s *billingModeService) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (s *billingModeService) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return s.describe, s.err
+}
+
+func TestBillingModeDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		mode  string
+		want  string
+		valid bool
+	}{
+		{"", "pay_per_request", true},
+		{"pay_per_request", "pay_per_request", true},
+		{"provisioned", "provisioned", true},
+		{"invalid", "invalid", false},
+	} {
+		cfg := Config{TableName: "test", BillingMode: tc.mode}
+		err := cfg.CheckAndSetDefaults()
+		if tc.valid {
+			require.NoError(t, err)
+		} else {
+			require.Error(t, err)
+		}
+		require.Equal(t, tc.want, cfg.BillingMode)
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		mode    string
+		awsMode string
+	}{
+		{"pay_per_request", dynamodb.BillingModePayPerRequest},
+		{"provisioned", dynamodb.BillingModeProvisioned},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			svc := &billingModeService{}
+			b := &Backend{Config: Config{BillingMode: tc.mode, ReadCapacityUnits: 12, WriteCapacityUnits: 34}}
+			b.svc = svc
+			b.Entry = logrus.NewEntry(logrus.New())
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(svc.create.BillingMode))
+			if tc.mode == "pay_per_request" {
+				require.Nil(t, svc.create.ProvisionedThroughput)
+			} else {
+				require.Equal(t, int64(12), aws.Int64Value(svc.create.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(34), aws.Int64Value(svc.create.ProvisionedThroughput.WriteCapacityUnits))
+			}
+		})
+	}
+}
+
+func TestTableStatusBillingMode(t *testing.T) {
+	svc := &billingModeService{describe: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+		BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+	}}}
+	b := &Backend{svc: svc}
+	status, mode, err := b.getTableStatus(context.Background(), "test")
+	require.NoError(t, err)
+	require.Equal(t, tableStatus(tableStatusOK), status)
+	require.Equal(t, dynamodb.BillingModePayPerRequest, mode)
+	svc.describe.Table.BillingModeSummary = nil
+	status, mode, err = b.getTableStatus(context.Background(), "test")
+	require.NoError(t, err)
+	require.Equal(t, tableStatus(tableStatusOK), status)
+	require.Equal(t, dynamodb.BillingModeProvisioned, mode)
+
+	svc.describe.Table.AttributeDefinitions = []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}
+	status, mode, err = b.getTableStatus(context.Background(), "test")
+	require.NoError(t, err)
+	require.Equal(t, tableStatus(tableStatusNeedsMigration), status)
+	require.Empty(t, mode)
+
+	svc.err = awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)
+	status, mode, err = b.getTableStatus(context.Background(), "test")
+	require.NoError(t, err)
+	require.Equal(t, tableStatus(tableStatusMissing), status)
+	require.Empty(t, mode)
+}
+
+func TestDisableAutoScaling(t *testing.T) {
+	b := &Backend{Config: Config{EnableAutoScaling: true}, Entry: logrus.NewEntry(logrus.New())}
+	b.disableAutoScaling("the table is on-demand")
+	require.False(t, b.EnableAutoScaling)
+}
