diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..2781e9e
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,189 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"io/fs"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"gopkg.in/yaml.v3"
+)
+
+// Source reads feature state from an OCI repository.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if logger == nil || store == nil {
+		return nil, fmt.Errorf("OCI source requires a logger and store")
+	}
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, fmt.Errorf("OCI polling interval must be positive")
+	}
+	return s, nil
+}
+
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+func (*Source) String() string { return "oci" }
+
+// Get fetches the current manifest and rebuilds the snapshot only when its digest changes.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.logger.Debug("fetching OCI snapshot")
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed to fetch OCI manifest", zap.Error(err))
+		return nil, err
+	}
+	if response.Matched && s.snapshot != nil {
+		return s.snapshot, nil
+	}
+	files := make([]fs.File, 0, len(response.Files))
+	for i, file := range response.Files {
+		if named, ok := file.(interface{ Namespace() string }); ok && named.Namespace() != "" {
+			converted, err := withNamespace(file, named.Namespace())
+			if err != nil {
+				s.logger.Error("failed to read OCI layer", zap.Error(err))
+				for _, remaining := range response.Files[i+1:] {
+					remaining.Close()
+				}
+				for _, opened := range files {
+					opened.Close()
+				}
+				return nil, err
+			}
+			files = append(files, converted)
+		} else {
+			files = append(files, file)
+		}
+	}
+	snapshot, err := storagefs.SnapshotFromFiles(files...)
+	if err != nil {
+		s.logger.Error("failed to build OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	s.snapshot, s.digest = snapshot, response.Digest
+	s.logger.Debug("updated OCI snapshot", zap.String("digest", string(s.digest)))
+	return snapshot, nil
+}
+
+// Subscribe polls until cancellation, delivering only changed snapshots.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	s.mu.Lock()
+	previous := s.digest
+	s.mu.Unlock()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				s.logger.Error("failed to fetch OCI snapshot", zap.Error(err))
+				continue
+			}
+			s.mu.Lock()
+			current := s.digest
+			s.mu.Unlock()
+			if current == previous {
+				continue
+			}
+			select {
+			case <-ctx.Done():
+				return
+			case ch <- snapshot:
+				previous = current
+			}
+		}
+	}
+}
+
+type snapshotFile struct {
+	*bytes.Reader
+	info fs.FileInfo
+}
+
+func (*snapshotFile) Close() error                 { return nil }
+func (f *snapshotFile) Stat() (fs.FileInfo, error) { return f.info, nil }
+
+func withNamespace(file fs.File, namespace string) (fs.File, error) {
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	data, err := io.ReadAll(file)
+	if err != nil {
+		return nil, err
+	}
+	var output []byte
+	if strings.HasSuffix(info.Name(), ".json") {
+		var doc map[string]any
+		if err := json.Unmarshal(data, &doc); err != nil {
+			return nil, err
+		}
+		if doc == nil {
+			return nil, fmt.Errorf("OCI layer %s: empty document", info.Name())
+		}
+		doc["namespace"] = namespace
+		output, err = json.Marshal(doc)
+	} else {
+		decoder := yaml.NewDecoder(bytes.NewReader(data))
+		var buf bytes.Buffer
+		encoder := yaml.NewEncoder(&buf)
+		for {
+			var doc map[string]any
+			if decodeErr := decoder.Decode(&doc); decodeErr != nil {
+				if decodeErr == io.EOF {
+					break
+				}
+				return nil, decodeErr
+			}
+			if doc == nil {
+				continue
+			}
+			doc["namespace"] = namespace
+			if err := encoder.Encode(doc); err != nil {
+				return nil, err
+			}
+		}
+		if err := encoder.Close(); err != nil {
+			return nil, err
+		}
+		output = buf.Bytes()
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &snapshotFile{Reader: bytes.NewReader(output), info: info}, nil
+}
