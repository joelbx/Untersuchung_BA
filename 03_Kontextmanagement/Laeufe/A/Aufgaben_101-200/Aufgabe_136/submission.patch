 def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+def test_reply_is_not_used_during_construction(mocker):
+    reply = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('certificate error')])
+
+    reply.assert_not_called()
+    reply.ignoreSslErrors.assert_not_called()
+    assert wrapper.html() == '<p>certificate error</p>'
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
+    assert wrapper.certificate_was_accepted()
