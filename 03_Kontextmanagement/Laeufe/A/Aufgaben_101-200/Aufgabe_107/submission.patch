+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+
+describe('optimistic mark-as bypass filter', () => {
+    const message = { ID: 'message', ConversationID: 'conversation' } as Element;
+
+    it('adds and removes message IDs as the unread filter changes status', () => {
+        const initial = newState({ params: { filter: { Unread: 1 } } });
+        const markedRead = elementsReducer(
+            initial,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.READ,
+            })
+        );
+        expect(markedRead.bypassFilter).toEqual(['message']);
+
+        const markedUnread = elementsReducer(
+            markedRead,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(markedUnread.bypassFilter).toEqual([]);
+    });
+
+    it('removes a conversation ID when read status matches the read filter', () => {
+        const initial = newState({ params: { filter: { Unread: 0 } } });
+        const markedUnread = elementsReducer(
+            initial,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: true,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(markedUnread.bypassFilter).toEqual(['conversation']);
+
+        const markedRead = elementsReducer(
+            markedUnread,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: true,
+                markAsStatus: MARK_AS_STATUS.READ,
+            })
+        );
+        expect(markedRead.bypassFilter).toEqual([]);
+    });
+
+    it('leaves bypasses unchanged when the status is absent', () => {
+        const initial = { ...newState(), bypassFilter: ['existing'] };
+        const updated = elementsReducer(initial, optimisticMarkAs({ elements: [message], bypass: true }));
+        expect(updated.bypassFilter).toEqual(['existing']);
+    });
+});
