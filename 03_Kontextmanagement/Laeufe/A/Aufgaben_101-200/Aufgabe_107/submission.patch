@@ -0,0 +1,14 @@
+import type { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import type { Element } from '../../../models/element';
+
+export const getElementsToBypassFilter = (
+    elements: Element[],
+    action: MARK_AS_STATUS,
+    unreadFilter?: number
+): { elementsToBypass: Element[]; elementsToRemove: Element[] } => {
+    const matchesFilter = unreadFilter === (action === 'unread' ? 1 : 0);
+
+    return matchesFilter
+        ? { elementsToBypass: [], elementsToRemove: elements }
+        : { elementsToBypass: elements, elementsToRemove: [] };
+};
