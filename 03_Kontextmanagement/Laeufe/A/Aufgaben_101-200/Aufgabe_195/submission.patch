+
+func TestLoadDeprecationsRequireFileKeys(t *testing.T) {
+	tests := []struct {
+		name     string
+		contents string
+		warnings []string
+	}{
+		{
+			name:     "explicit false values",
+			contents: "ui:\n  enabled: false\ncache:\n  memory:\n    enabled: false\n",
+			warnings: []string{
+				`"ui.enabled" is deprecated and will be removed in a future version.`,
+				`"cache.memory.enabled" is deprecated and will be removed in a future version. Please use 'cache.backend' and 'cache.enabled' instead.`,
+			},
+		},
+		{
+			name:     "expiration alone",
+			contents: "cache:\n  memory:\n    expiration: 1s\n",
+			warnings: []string{`"cache.memory.expiration" is deprecated and will be removed in a future version. Please use 'cache.ttl' instead.`},
+		},
+		{
+			name:     "omitted keys",
+			contents: "ui: {}\ncache: {}\ndb: {}\n",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.contents), 0600))
+			result, err := Load(path)
+			require.NoError(t, err)
+			require.NotNil(t, result.Config)
+			assert.Equal(t, tt.warnings, result.Warnings)
 		})
 	}
 }
