+class TestFactsLinuxHardwareSysinfo(unittest.TestCase):
+
+    def setUp(self):
+        self.hardware = linux.LinuxHardware(module=Mock(), load_on_init=False)
+
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False)
+    def test_absent_sysinfo(self, mock_exists):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {})
+        mock_exists.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM',
+        'Type: 3906',
+        'Sequence Code: 0000123456',
+        'Other: ignored',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_sysinfo_facts_and_dmi_fallback(self, mock_exists, mock_lines):
+        expected = {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '123456',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        self.assertEqual(self.hardware.get_sysinfo_facts(), expected)
+        self.assertEqual(self.hardware.get_dmi_facts(), expected)
+        self.hardware.module.get_bin_path.assert_not_called()
+        mock_lines.assert_called_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=['Manufacturer: IBM'])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_missing_fields_remain_na(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'IBM',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
