+    def get_sysinfo_facts(self):
+        """Read hardware identity from /proc/sysinfo on IBM Z systems."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer:': 'system_vendor',
+            'Type:': 'product_name',
+            'Sequence Code:': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            for prefix, fact in fields.items():
+                if line.startswith(prefix):
+                    value = line[len(prefix):].strip()
+                    if value:
+                        sysinfo_facts[fact] = value.lstrip('0') if fact == 'product_serial' else value
+                    break
+
+        return sysinfo_facts
+
