+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// Validate checks the selected database configuration mode.
+func (d DatabaseConfig) Validate() error {
+	if d.URL != "" {
+		return nil
+	}
+	if d.Protocol < SQLite || d.Protocol > MySQL {
+		return fmt.Errorf("db.protocol must be one of sqlite3, sqlite, postgres, postgresql, mysql (got %d)", d.Protocol)
+	}
+	if d.Name == "" {
+		return errors.New("db.name cannot be empty")
+	}
+	if d.Protocol == SQLite {
+		if d.Path == "" && d.Host == "" {
+			return errors.New("db.path (or db.host) cannot be empty for sqlite3")
+		}
+	} else if d.Host == "" {
+		return errors.New("db.host cannot be empty")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return errors.New("db.port must be between 1 and 65535 when set")
+	}
+	return nil
 }
 
