+		return (&url.URL{Scheme: "file", Opaque: filepath.Join(dir, cfg.Name)}).String()
+	}
+	port := cfg.Port
+	protocol := cfg.Protocol.String()
+	if port == 0 {
+		if cfg.Protocol == config.Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: protocol, Host: net.JoinHostPort(cfg.Host, strconv.Itoa(port)), Path: "/" + cfg.Name}
+	if cfg.User != "" || cfg.Password != "" {
+		u.User = url.UserPassword(cfg.User, cfg.Password)
+	}
+	return u.String()
