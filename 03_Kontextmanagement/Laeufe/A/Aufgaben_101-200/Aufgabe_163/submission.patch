+func TestDiscreteConnection(t *testing.T) {
+	cases := []struct {
+		name   string
+		cfg    config.DatabaseConfig
+		driver Driver
+		dsn    string
+	}{
+		{"postgres defaults", config.DatabaseConfig{Protocol: config.Postgres, Host: "localhost", Name: "flipt", User: "alice", Password: "secret"}, Postgres, "dbname=flipt host=localhost password=secret port=5432 user=alice"},
+		{"mysql defaults", config.DatabaseConfig{Protocol: config.MySQL, Host: "localhost", Name: "flipt", User: "alice", Password: "secret"}, MySQL, "alice:secret@tcp(localhost:3306)/flipt?multiStatements=true&parseTime=true&sql_mode=ANSI"},
+		{"sqlite path", config.DatabaseConfig{Protocol: config.SQLite, Path: t.TempDir(), Name: "flipt.db"}, SQLite, ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			require.NoError(t, tc.cfg.Validate())
+			d, parsed, err := parse(connectionURL(tc.cfg), false)
+			require.NoError(t, err)
+			assert.Equal(t, tc.driver, d)
+			if tc.dsn != "" {
+				assert.Equal(t, tc.dsn, parsed.DSN)
+			}
+			sql, actual, err := openConfig(config.Config{Database: tc.cfg}, false)
+			require.NoError(t, err)
+			defer sql.Close()
+			assert.Equal(t, tc.driver, actual)
+		})
+	}
+}
+
+func TestURLPrecedenceAndRedaction(t *testing.T) {
+	cfg := config.Config{Database: config.DatabaseConfig{
+		URL: "file:flipt.db", Protocol: config.DatabaseProtocol(99), Password: "secret",
+	}}
+	sql, driver, err := openConfig(cfg, false)
+	require.NoError(t, err)
+	defer sql.Close()
+	assert.Equal(t, SQLite, driver)
+
+	cfg.Database.URL = "postgres://alice:secret@bad host/flipt"
+	_, _, err = openConfig(cfg, false)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "parsing db.url")
+	assert.NotContains(t, err.Error(), "secret")
+}
