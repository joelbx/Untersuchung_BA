+type AdminActionLock = {
+    pending: boolean;
+    run: (action: () => Promise<void>, errorMessage: string) => void;
+};
+
+const AdminActionLockContext = React.createContext<AdminActionLock | null>(null);
+
+function useLocalAdminActionLock(member: RoomMember): AdminActionLock {
+    const active = useRef(new Set<string>());
+    const [, update] = useState(0);
+    const memberKey = `${member.roomId}|${member.userId}`;
+    const pending = active.current.has(memberKey);
+
+    const run = (action: () => Promise<void>, errorMessage: string): void => {
+        // The ref closes the gap before React has rendered the disabled buttons.
+        if (active.current.has(memberKey)) return;
+        active.current.add(memberKey);
+        update((value) => value + 1);
+
+        void (async () => {
+            try {
+                await action();
+            } catch (err) {
+                logger.error(errorMessage, err);
+                Modal.createDialog(ErrorDialog, { title: _t("Error"), description: errorMessage });
+            } finally {
+                active.current.delete(memberKey);
+                update((value) => value + 1);
+            }
+        })();
+    };
+
+    return { pending, run };
+}
+
+function useAdminActionLock(member: RoomMember): AdminActionLock {
+    const shared = useContext(AdminActionLockContext);
+    const local = useLocalAdminActionLock(member);
+    return shared ?? local;
+}
