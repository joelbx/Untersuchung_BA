+_CLIXML_HEADER = re.compile(rb"(?:#< |<# |\r\n)CLIXML\r\n")
+
+
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML objects in stderr, preserving all other bytes."""
+    if b"CLIXML\r\n" not in stderr:
+        return stderr
+
+    result = bytearray()
+    position = 0
+
+    while header := _CLIXML_HEADER.search(stderr, position):
+        result.extend(stderr[position:header.start()])
+        xml_match = re.search(rb"<Objs(?:\s|>)", stderr[header.end():])
+        xml_start = header.end() + xml_match.start() if xml_match else -1
+        xml_end = stderr.find(b"</Objs>", header.end())
+        next_header = _CLIXML_HEADER.search(stderr, header.end())
+
+        if next_header and xml_start != -1 and next_header.start() > xml_start and (xml_end == -1 or next_header.start() < xml_end):
+            # The current object never closed before another block began.
+            result.extend(stderr[header.start():next_header.start()])
+            position = next_header.start()
+            continue
+
+        if (xml_start == -1 or xml_end == -1 or xml_start > xml_end or
+                not re.fullmatch(rb"(?:\s|#< CLIXML\r\n|<# CLIXML\r\n)*", stderr[header.end():xml_start])):
+            # No complete object follows this header. A later header may still
+            # introduce a valid block, so continue scanning without dropping data.
+            result.extend(stderr[header.start():header.end()])
+            position = header.end()
+            continue
+
+        xml_end += len(b"</Objs>")
+        while re.match(rb"<Objs(?:\s|>)", stderr[xml_end:]):
+            following_end = stderr.find(b"</Objs>", xml_end)
+            if following_end == -1:
+                break
+            xml_end = following_end + len(b"</Objs>")
+
+        block = stderr[header.start():xml_end]
+        try:
+            try:
+                decoded = block.decode("utf-8")
+            except UnicodeDecodeError:
+                decoded = block.decode("cp437")
+            replacement = _parse_clixml(decoded.encode("utf-8"))
+        except (ValueError, UnicodeError, ET.ParseError):
+            result.extend(block)
+        else:
+            result.extend(replacement)
+        position = xml_end
+
+    if position == 0:
+        return stderr
+    result.extend(stderr[position:])
+    return bytes(result)
+
