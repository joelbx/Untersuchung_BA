diff --git a/applications/drive/src/app/zustand/share/shareMembersIsolation.test.ts b/applications/drive/src/app/zustand/share/shareMembersIsolation.test.ts
new file mode 100644
index 0000000..8a78aea
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/shareMembersIsolation.test.ts
@@ -0,0 +1,76 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (memberId: string, email: string) => ({ memberId, email }) as ShareMember;
+const invitation = (invitationId: string, inviteeEmail: string) => ({ invitationId, inviteeEmail }) as ShareInvitation;
+const externalInvitation = (externalInvitationId: string, inviteeEmail: string) =>
+    ({ externalInvitationId, inviteeEmail }) as ShareExternalInvitation;
+
+describe('share member data isolation', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('keeps members separate and replaces only the selected share', () => {
+        const first = member('first', 'first@example.com');
+        const second = member('second', 'second@example.com');
+        const replacement = member('replacement', 'replacement@example.com');
+        const store = useMembersStore.getState();
+
+        expect(store.getMembers('missing')).toEqual([]);
+        store.setMembers('share-a', [first]);
+        store.setMembers('share-b', [second]);
+        store.setMembers('share-a', [replacement]);
+
+        expect(store.getMembers('share-a')).toEqual([replacement]);
+        expect(store.getMembers('share-b')).toEqual([second]);
+    });
+
+    it('keeps both invitation kinds separate through updates and removals', () => {
+        const first = invitation('first', 'first@example.com');
+        const second = invitation('second', 'second@example.com');
+        const externalFirst = externalInvitation('external-first', 'external-first@example.com');
+        const externalSecond = externalInvitation('external-second', 'external-second@example.com');
+        const store = useInvitationsStore.getState();
+
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+        store.setInvitations('share-a', [first]);
+        store.setExternalInvitations('share-a', [externalFirst]);
+        store.setInvitations('share-b', [second]);
+        store.setExternalInvitations('share-b', [externalSecond]);
+
+        const updated = { ...first, inviteeEmail: 'updated@example.com' };
+        store.updateInvitationsPermissions('share-a', [updated]);
+        store.updateExternalInvitations('share-a', []);
+        expect(store.getInvitations('share-a')).toEqual([updated]);
+        expect(store.getExternalInvitations('share-a')).toEqual([]);
+
+        store.removeInvitations('share-a', []);
+        store.removeExternalInvitations('share-b', []);
+        expect(store.getInvitations('share-a')).toEqual([]);
+        expect(store.getInvitations('share-b')).toEqual([second]);
+        expect(store.getExternalInvitations('share-b')).toEqual([]);
+        expect(store.getExternalInvitations('share-a')).toEqual([]);
+
+        store.addMultipleInvitations('share-a', [first], [externalFirst]);
+        expect(store.getInvitations('share-a')).toEqual([first]);
+        expect(store.getExternalInvitations('share-a')).toEqual([externalFirst]);
+        expect(store.getInvitations('share-b')).toEqual([second]);
+    });
+
+    it('combines email addresses from all three collections', () => {
+        expect(
+            getExistingEmails(
+                [member('member', 'member@example.com')],
+                [invitation('invitation', 'invitee@example.com')],
+                [externalInvitation('external', 'external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'invitee@example.com', 'external@example.com']);
+    });
+});
