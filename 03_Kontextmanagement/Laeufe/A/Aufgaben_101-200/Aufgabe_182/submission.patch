+def test_Display_warning_and_deprecated_fork():
+    def test():
+        queue = MagicMock()
+        display = Display()
+        display.set_queue(queue)
+
+        display.warning('warning', formatted=True)
+        queue.send_display.assert_called_once_with('warning', 'warning', formatted=True)
+        queue.send_display.reset_mock()
+
+        display.deprecated('deprecated', version='2.18')
+        queue.send_display.assert_called_once_with('deprecated', 'deprecated', version='2.18')
+
+    p = multiprocessing_context.Process(target=test)
+    p.start()
+    p.join()
+    assert p.exitcode == 0
+
+
+def test_Display_warning_deduplicated_from_forks(monkeypatch, capsys):
+    from ansible.executor.task_queue_manager import DisplaySend
+    from ansible.plugins.strategy import StrategySentinel, results_thread_main
+
+    display = Display()
+    monkeypatch.setattr(display, '_warns', {})
+    strategy = MagicMock()
+    strategy._final_q.get.side_effect = [
+        DisplaySend('warning', 'same warning'),
+        DisplaySend('warning', 'same warning'),
+        StrategySentinel(),
+    ]
+
+    results_thread_main(strategy)
+
+    assert capsys.readouterr().err == '[WARNING]: same warning\n'
+
+
+def test_Display_deprecated_deduplicated_from_forks(monkeypatch, capsys):
+    from ansible import constants as C
+    from ansible.executor.task_queue_manager import DisplaySend
+    from ansible.plugins.strategy import StrategySentinel, results_thread_main
+
+    monkeypatch.setattr(C, 'DEPRECATION_WARNINGS', True)
+    display = Display()
+    monkeypatch.setattr(display, '_deprecations', {})
+    strategy = MagicMock()
+    strategy._final_q.get.side_effect = [
+        DisplaySend('deprecated', 'same deprecation', version='2.18'),
+        DisplaySend('deprecated', 'same deprecation', version='2.18'),
+        StrategySentinel(),
+    ]
+
+    results_thread_main(strategy)
+
+    assert capsys.readouterr().err.count('[DEPRECATION WARNING]: same deprecation.') == 1
+
+
