diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..51df59a
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,183 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupTimeFormat = "20060102T150405.000000000"
+
+var backupNamePattern = regexp.MustCompile(`^navidrome_backup_[0-9]{8}T[0-9]{6}\.[0-9]{9}\.db$`)
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	folder := conf.Server.Backup.Path
+	if folder == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := os.MkdirAll(folder, 0700); err != nil {
+		return "", fmt.Errorf("create backup directory: %w", err)
+	}
+	path := filepath.Join(folder, backupPrefix+time.Now().UTC().Format(backupTimeFormat)+".db")
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", fmt.Errorf("create backup file: %w", err)
+	}
+	_ = file.Close()
+	u := url.URL{Scheme: "file", Path: path}
+	out, err := sql.Open(Driver, u.String())
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	defer out.Close()
+	if err := copySQLite(ctx, out, d.writeDB); err != nil {
+		_ = out.Close()
+		_ = os.Remove(path)
+		return "", fmt.Errorf("backup database: %w", err)
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	backupPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	if currentPath, err := filepath.Abs(conf.Server.DbPath); err == nil && backupPath == currentPath {
+		return errors.New("backup file is the active database")
+	}
+	info, err := os.Stat(backupPath)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("backup file is not a regular file")
+	}
+	if active, err := os.Stat(conf.Server.DbPath); err == nil && os.SameFile(info, active) {
+		return errors.New("backup file is the active database")
+	}
+	// Open read-only so a mistyped path cannot create an empty source database.
+	u := url.URL{Scheme: "file", Path: backupPath, RawQuery: "mode=ro"}
+	source, err := sql.Open(Driver, u.String())
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var result string
+	if err := source.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("check backup integrity: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("backup integrity check failed: %s", result)
+	}
+	var schemaCount int
+	if err := source.QueryRowContext(ctx, "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='goose_db_version'").Scan(&schemaCount); err != nil {
+		return fmt.Errorf("check backup schema: %w", err)
+	}
+	if schemaCount == 0 {
+		return errors.New("backup is not a Navidrome database")
+	}
+	if err := copySQLite(ctx, d.writeDB, source); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+// copySQLite uses SQLite's online backup API, including committed WAL pages.
+func copySQLite(ctx context.Context, destination, source *sql.DB) error {
+	src, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	dst, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dst.Close()
+	return dst.Raw(func(dstDriver any) error {
+		return src.Raw(func(srcDriver any) error {
+			d, ok := dstDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("destination is not SQLite")
+			}
+			s, ok := srcDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("source is not SQLite")
+			}
+			backup, err := d.Backup("main", s, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+// prune removes only files generated by Navidrome, newest first.
+func prune(ctx context.Context) (int, error) {
+	folder := conf.Server.Backup.Path
+	if folder == "" {
+		return 0, errors.New("backup.path is not configured")
+	}
+	entries, err := os.ReadDir(folder)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if !entry.IsDir() && backupNamePattern.MatchString(entry.Name()) {
+			names = append(names, entry.Name())
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	count := conf.Server.Backup.Count
+	if count < 0 {
+		return 0, errors.New("backup.count must be non-negative")
+	}
+	if count >= len(names) {
+		return 0, nil
+	}
+	removed := 0
+	for _, name := range names[count:] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(folder, name)); err != nil {
+			return removed, fmt.Errorf("remove backup %s: %w", name, err)
+		}
+		removed++
+	}
+	return removed, nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
new file mode 100644
index 0000000..06d8f78
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,69 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	ctx := context.Background()
+	folder := t.TempDir()
+	oldBackup := conf.Server.Backup
+	oldPath := conf.Server.DbPath
+	t.Cleanup(func() {
+		conf.Server.Backup = oldBackup
+		conf.Server.DbPath = oldPath
+	})
+	conf.Server.Backup.Path = filepath.Join(folder, "backups")
+	conf.Server.Backup.Count = 1
+	conf.Server.DbPath = filepath.Join(folder, "active.db")
+
+	live, err := sql.Open(Driver, conf.Server.DbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE goose_db_version (id INTEGER); CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: live, writeDB: live}
+	first, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Dir(first) != conf.Server.Backup.Path {
+		t.Fatalf("backup written to %s", first)
+	}
+	if _, err := live.Exec("UPDATE items SET value='changed'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := live.QueryRow("SELECT value FROM items").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "original" {
+		t.Fatalf("restored value = %q", value)
+	}
+	removed, err := d.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned %d backups: %v", removed, err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("old backup still present: %v", err)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatal(err)
+	}
+}
