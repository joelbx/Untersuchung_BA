+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	old := Server.Backup
+	t.Cleanup(func() { Server.Backup = old })
+	Server.Backup.Schedule = "2h"
+	Server.Backup.Count = 2
+	if err := validateBackupSchedule(); err != nil {
+		t.Fatal(err)
+	}
+	if Server.Backup.Schedule != "@every 2h" {
+		t.Fatalf("schedule = %q", Server.Backup.Schedule)
+	}
+	Server.Backup.Schedule = "invalid schedule"
+	if err := validateBackupSchedule(); err == nil {
+		t.Fatal("invalid schedule accepted")
+	}
+}
