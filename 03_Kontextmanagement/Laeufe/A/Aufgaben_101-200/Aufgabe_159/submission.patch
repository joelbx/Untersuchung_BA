@@ -0,0 +1,85 @@
+package sbom
+
+import (
+	"testing"
+
+	"github.com/package-url/packageurl-go"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		pkgType, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"maven", "guava", "", "guava", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"other", "package", "", "package", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pkgType+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.pkgType, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)",
+					tt.pkgType, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestPurlPkgType(t *testing.T) {
+	tests := map[string]string{
+		"pom": "maven", "pip": "pypi", "gomod": "golang", "npm": "npm",
+		"cocoapods": "cocoapods", "cargo": "cargo",
+	}
+	for input, want := range tests {
+		if got := purlPkgType(input); got != want {
+			t.Errorf("purlPkgType(%q) = %q, want %q", input, got, want)
+		}
+	}
+}
+
+func TestDependencyPURLsUseParsedNames(t *testing.T) {
+	library := models.LibraryScanner{
+		Type:         "pom",
+		LockfilePath: "pom.xml",
+		Libs:         []models.Library{{Name: "com.google.guava:guava", Version: "1.0"}},
+	}
+	libRefs := map[string]map[string]string{"pom.xml": {}}
+	libComponents := libpkgToCdxComponents(library, libRefs)
+	checkPURLParts(t, libComponents[1].PackageURL, "maven", "com.google.guava", "guava", "")
+	if libRefs["pom.xml"]["com.google.guava:guava"] != libComponents[1].PackageURL {
+		t.Fatal("library lookup does not use the generated PURL")
+	}
+
+	manifest := models.DependencyGraphManifest{
+		Filename:     "package.json",
+		Repository:   "example/repo",
+		Dependencies: []models.Dependency{{PackageName: "@babel/core", Requirements: "= 1.0"}},
+	}
+	ghRefs := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+	ghComponents := ghpkgToCdxComponents(manifest, ghRefs)
+	checkPURLParts(t, ghComponents[1].PackageURL, "npm", "@babel", "core", "")
+	if ghRefs[manifest.RepoURLFilename()]["@babel/core"] != ghComponents[1].PackageURL {
+		t.Fatal("manifest lookup does not use the generated PURL")
+	}
+}
+
+func checkPURLParts(t *testing.T, raw, pkgType, namespace, name, subpath string) {
+	t.Helper()
+	p, err := packageurl.FromString(raw)
+	if err != nil {
+		t.Fatalf("invalid PURL %q: %v", raw, err)
+	}
+	if p.Type != pkgType || p.Namespace != namespace || p.Name != name || p.Subpath != subpath {
+		t.Errorf("PURL %q has (%q, %q, %q, %q), want (%q, %q, %q, %q)",
+			raw, p.Type, p.Namespace, p.Name, p.Subpath, pkgType, namespace, name, subpath)
+	}
+}
