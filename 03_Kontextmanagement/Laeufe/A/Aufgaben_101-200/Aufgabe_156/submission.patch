+
+    def test_nested_keys_and_ignore(self):
+        value = {'password': 'plain', 'my-password-end': [{'password': 1}],
+                 'changed': {'x-password': 2}, '_ansible_password': 3,
+                 'status': 4, 'password-status': 5}
+        result = sanitize_keys(value, (b'password', b'status'),
+                               frozenset(['status']))
+        self.assertEqual(result, {
+            'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 'plain',
+            'my-********-end': [{'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 1}],
+            'changed': {'x-********': 2}, '_ansible_password': 3,
+            'status': 4, '********-********': 5})
+        self.assertEqual(value['password'], 'plain')
+
+    def test_deep_mappings(self):
+        root = {}
+        current = root
+        for _ in range(10000):
+            child = {}
+            current['next'] = child
+            current = child
+        current['my-password'] = 1
+        result = sanitize_keys(root, ('password',))
+        for _ in range(10000):
+            result = result['next']
+        self.assertEqual(result, {'my-********': 1})
