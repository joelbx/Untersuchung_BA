+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+
+import { useContextMenu } from "../../structures/ContextMenu";
+import AccessibleButton from "../elements/AccessibleButton";
+import UIStore from "../../../stores/UIStore";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "onClick" | "children"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...buttonProps }) => {
+    const [isOpen, buttonRef, open, close] = useContextMenu<HTMLDivElement>();
+    const rect = buttonRef.current?.getBoundingClientRect();
+    const onOpen = (event: React.SyntheticEvent<Element>) => {
+        buttonRef.current?.focus();
+        open(event);
+    };
+    const menuOptions = options.map((option, index) => {
+        if (!React.isValidElement(option)) return option;
+        const originalClick = option.props.onClick;
+        return React.cloneElement(option, {
+            key: option.key ?? index,
+            onClick: (event) => {
+                originalClick?.(event);
+                close();
+            },
+        });
+    });
+
+    return <>
+        <AccessibleButton
+            {...buttonProps}
+            inputRef={buttonRef}
+            className={["mx_KebabContextMenu", buttonProps.className].filter(Boolean).join(" ")}
+            title={title}
+            aria-label={title}
+            aria-haspopup="true"
+            aria-expanded={isOpen}
+            aria-disabled={disabled}
+            disabled={disabled}
+            onClick={onOpen}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </AccessibleButton>
+        { isOpen && rect && <IconizedContextMenu
+            right={UIStore.instance.windowWidth - rect.right - window.scrollX}
+            top={rect.bottom + window.scrollY + 8}
+            onFinished={close}
+            wrapperClassName="mx_KebabContextMenu_wrapper"
+        >
+            <IconizedContextMenuOptionList red>
+                { menuOptions }
+            </IconizedContextMenuOptionList>
+        </IconizedContextMenu> }
+    </>;
+};
