+# Copyright: Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat.mock import patch
+from units.modules.utils import set_module_args
+from ansible.modules.network.icx import icx_logging
+from .icx_module import TestICXModule
+
+
+class TestICXLoggingModule(TestICXModule):
+    module = icx_logging
+
+    def setUp(self):
+        super(TestICXLoggingModule, self).setUp()
+        self.mock_get_config = patch('ansible.modules.network.icx.icx_logging.get_config')
+        self.get_config = self.mock_get_config.start()
+        self.mock_load_config = patch('ansible.modules.network.icx.icx_logging.load_config')
+        self.load_config = self.mock_load_config.start()
+        self.get_config.return_value = ''
+
+    def tearDown(self):
+        self.mock_get_config.stop()
+        self.mock_load_config.stop()
+        super(TestICXLoggingModule, self).tearDown()
+
+    def test_aggregate_host_facility_and_ipv6(self):
+        self.get_config.return_value = 'logging host 192.0.2.1 udp-port 514\nlogging facility local1'
+        set_module_args({'aggregate': [
+            {'dest': 'host', 'name': '2001:db8::1', 'udp_port': 1514},
+            {'dest': 'host', 'name': '192.0.2.1', 'state': 'absent'},
+            {'facility': 'local7'}]})
+        self.execute_module(changed=True, commands=[
+            'logging host ipv6 2001:db8::1 udp-port 1514',
+            'no logging host 192.0.2.1 udp-port 514',
+            'logging facility local7'])
+
+    def test_idempotent_ipv6_and_facility(self):
+        self.get_config.return_value = 'logging host ipv6 2001:db8::1 udp-port 1514\nlogging facility local7'
+        set_module_args({'aggregate': [
+            {'dest': 'host', 'name': '2001:db8::1', 'udp_port': 1514},
+            {'facility': 'local7'}]})
+        self.execute_module(changed=False, commands=[])
+        self.load_config.assert_not_called()
+
+    def test_host_port_change_and_removal(self):
+        self.get_config.return_value = 'logging host ipv6 2001:db8::1 udp-port 514'
+        set_module_args({'dest': 'host', 'name': '2001:db8::1', 'udp_port': 1514})
+        self.execute_module(changed=True, commands=[
+            'no logging host ipv6 2001:db8::1 udp-port 514',
+            'logging host ipv6 2001:db8::1 udp-port 1514'])
+
+    def test_absent_settings_are_idempotent(self):
+        self.get_config.return_value = ('no logging on\nno logging buffered alerts\n'
+                                        'no logging facility')
+        set_module_args({'aggregate': [
+            {'dest': 'on', 'state': 'absent'},
+            {'dest': 'console', 'state': 'absent'},
+            {'dest': 'buffered', 'level': 'alerts', 'state': 'absent'},
+            {'facility': 'local7', 'state': 'absent'}]})
+        self.execute_module(changed=False, commands=[])
+
+    def test_buffered_levels(self):
+        self.get_config.return_value = 'logging buffered\nno logging buffered alerts'
+        set_module_args({'aggregate': [
+            {'dest': 'buffered', 'level': 'alerts'},
+            {'dest': 'buffered', 'level': 'errors', 'state': 'absent'}]})
+        self.execute_module(changed=True, commands=[
+            'logging buffered alerts', 'no logging buffered errors'])
+
+    def test_disable_settings(self):
+        self.get_config.return_value = ('logging console\nlogging persistence\n'
+                                        'logging enable rfc5424\nlogging facility local7')
+        set_module_args({'aggregate': [
+            {'dest': 'console', 'state': 'absent'},
+            {'dest': 'on', 'state': 'absent'},
+            {'dest': 'persistence', 'state': 'absent'},
+            {'dest': 'rfc5424', 'state': 'absent'},
+            {'facility': 'local7', 'state': 'absent'}]})
+        self.execute_module(changed=True, commands=[
+            'no logging console', 'no logging on', 'no logging persistence',
+            'no logging enable rfc5424', 'no logging facility'])
+
+    def test_check_mode(self):
+        set_module_args({'dest': 'host', 'name': '192.0.2.1', '_ansible_check_mode': True})
+        self.execute_module(changed=True, commands=['logging host 192.0.2.1'])
+        self.load_config.assert_not_called()
+
+    def test_required_parameters(self):
+        set_module_args({'dest': 'host'})
+        self.execute_module(failed=True)
+        set_module_args({'dest': 'buffered'})
+        self.execute_module(failed=True)
