+#!/usr/bin/python
+# Copyright: Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+ANSIBLE_METADATA = {'metadata_version': '1.1', 'status': ['preview'],
+                    'supported_by': 'community'}
+
+DOCUMENTATION = '''
+---
+module: icx_logging
+version_added: "2.9"
+short_description: Manage logging on Ruckus ICX 7000 series switches
+description:
+  - Configure logging destinations, facilities, and severity levels on ICX switches.
+options:
+  dest:
+    description: Logging destination or global logging switch.
+    type: str
+    choices: [host, console, buffered, persistence, rfc5424, on]
+  name:
+    description: Hostname or IPv4/IPv6 address when C(dest=host).
+    type: str
+  udp_port:
+    description: UDP port for a syslog host.
+    type: int
+  facility:
+    description: Syslog facility. Use C(state=absent) to clear it.
+    type: str
+  level:
+    description: Severity level for buffered logging.
+    type: str
+    choices: [emergencies, alerts, critical, errors, warnings, notifications, informational, debugging]
+  aggregate:
+    description: List of logging settings to manage together.
+    type: list
+    elements: dict
+  state:
+    description: Whether the setting should exist.
+    type: str
+    choices: [present, absent]
+    default: present
+  check_running_config:
+    description: Compare the requested setting with the running configuration.
+    type: bool
+    default: true
+author: Ansible Project
+'''
+
+EXAMPLES = '''
+- name: Configure IPv6 syslog and facility
+  icx_logging:
+    aggregate:
+      - {dest: host, name: '2001:db8::1', udp_port: 514}
+      - {facility: local7}
+
+- name: Disable buffered alerts
+  icx_logging:
+    dest: buffered
+    level: alerts
+    state: absent
+'''
+
+RETURN = '''
+commands:
+  description: Configuration commands sent to the switch.
+  returned: always
+  type: list
+  sample: ['logging host ipv6 2001:db8::1 udp-port 514']
+'''
+
+import re
+from copy import deepcopy
+
+from ansible.module_utils.basic import AnsibleModule, env_fallback
+from ansible.module_utils.network.common.utils import remove_default_spec
+from ansible.module_utils.network.icx.icx import get_config, load_config
+
+try:
+    from ipaddress import ip_address
+except ImportError:
+    ip_address = None
+
+
+LEVELS = ('emergencies', 'alerts', 'critical', 'errors', 'warnings',
+          'notifications', 'informational', 'debugging')
+DESTINATIONS = ('host', 'console', 'buffered', 'persistence', 'rfc5424', 'on')
+
+
+def count_terms(check, param=None):
+    if param is None:
+        param = check
+    if isinstance(param, str):
+        param = [param]
+    return sum(check.get(key) is not None for key in param)
+
+
+def search_obj_in_list(name, lst):
+    for item in lst:
+        if item.get('name') == name:
+            return item
+    return None
+
+
+def diff_in_list(want, have):
+    return set(want) - set(have), set(have) - set(want)
+
+
+def check_required_if(module, spec, param):
+    for key, value, required in spec or []:
+        if param.get(key) == value:
+            for field in required:
+                if param.get(field) is None or param.get(field) == '':
+                    module.fail_json(msg="%s is required when %s is %s" % (field, key, value))
+
+
+def parse_port(line, dest):
+    if dest == 'host':
+        match = re.search(r'\budp-port\s+(\d+)\b', line)
+        if match:
+            return match.group(1)
+    return None
+
+
+def parse_name(line, dest):
+    if dest == 'host':
+        match = re.match(r'^\s*logging host (?:ipv6 )?(\S+)', line)
+        if match:
+            return match.group(1)
+    return None
+
+
+def parse_address(line, dest):
+    return dest == 'host' and bool(re.match(r'^\s*logging host ipv6 \S+', line))
+
+
+def map_params_to_obj(module, required_if=None):
+    params = module.params
+    entries = params.get('aggregate')
+    if entries is None:
+        entries = [params]
+    objects = []
+    for item in entries:
+        entry = {key: item.get(key) if item.get(key) is not None else params.get(key)
+                 for key in ('dest', 'name', 'udp_port', 'facility', 'level', 'state')}
+        check_required_if(module, required_if, entry)
+        if count_terms(entry, ('dest', 'facility')) == 0:
+            module.fail_json(msg='dest or facility is required')
+        if entry['dest'] not in DESTINATIONS and entry['dest'] is not None:
+            module.fail_json(msg='unsupported logging destination: %s' % entry['dest'])
+        if entry['state'] not in ('present', 'absent'):
+            module.fail_json(msg='state must be present or absent')
+        if entry['level'] is not None and entry['level'] not in LEVELS:
+            module.fail_json(msg='unsupported logging level: %s' % entry['level'])
+        if entry['dest'] == 'host':
+            name = entry['name']
+            entry['addr6'] = False
+            if ':' in name:
+                if ip_address is None:
+                    module.fail_json(msg='ipaddress is required for IPv6 hosts')
+                try:
+                    entry['addr6'] = ip_address(name).version == 6
+                except ValueError:
+                    module.fail_json(msg='invalid IPv6 address: %s' % name)
+            if entry['udp_port'] is not None:
+                try:
+                    port = int(entry['udp_port'])
+                except (TypeError, ValueError):
+                    module.fail_json(msg='udp_port must be an integer')
+                if not 1 <= port <= 65535:
+                    module.fail_json(msg='udp_port must be between 1 and 65535')
+                entry['udp_port'] = str(port)
+        else:
+            entry['name'] = None
+            entry['udp_port'] = None
+            entry['addr6'] = False
+        if entry['dest'] == 'buffered':
+            entry['level'] = set([entry['level']])
+        elif entry['dest'] != 'console':
+            entry['level'] = None
+        objects.append(entry)
+    return objects
+
+
+def map_config_to_obj(module):
+    data = get_config(module, flags='| include logging',
+                      compare=module.params.get('check_running_config', True))
+    objects = []
+    facility = 'user'
+    explicit_facility = False
+    buffered = set()
+    buffered_seen = False
+    logging_off = False
+    for raw in data.splitlines():
+        line = raw.strip()
+        if line == 'no logging on':
+            logging_off = True
+        elif line.startswith('logging facility '):
+            facility = line.split(None, 2)[2]
+            explicit_facility = True
+        elif line == 'no logging facility':
+            facility = 'user'
+            explicit_facility = False
+        elif line.startswith('logging host '):
+            objects.append({'dest': 'host', 'name': parse_name(line, 'host'),
+                            'udp_port': parse_port(line, 'host'),
+                            'addr6': parse_address(line, 'host')})
+        elif line == 'logging buffered':
+            buffered_seen = True
+            buffered = set(LEVELS)
+        elif line.startswith('logging buffered '):
+            level = line.split()[2]
+            if level in LEVELS:
+                buffered_seen = True
+                buffered.add(level)
+        elif line.startswith('no logging buffered '):
+            level = line.split()[3]
+            if level in LEVELS:
+                if not buffered_seen:
+                    buffered = set(LEVELS)
+                buffered_seen = True
+                buffered.discard(level)
+        elif line == 'no logging buffered':
+            buffered_seen = False
+            buffered.clear()
+        elif line == 'logging console' or line.startswith('logging console '):
+            parts = line.split()
+            objects.append({'dest': 'console',
+                            'level': parts[2] if len(parts) == 3 else None})
+        elif line == 'logging persistence':
+            objects.append({'dest': 'persistence'})
+        elif line == 'logging enable rfc5424':
+            objects.append({'dest': 'rfc5424'})
+    if buffered_seen:
+        objects.append({'dest': 'buffered', 'level': buffered})
+    objects.append({'dest': None, 'facility': facility,
+                    'facility_configured': explicit_facility})
+    if not logging_off:
+        objects.append({'dest': 'on'})
+    return objects
+
+
+def _host_command(obj):
+    command = 'logging host '
+    if obj.get('addr6'):
+        command += 'ipv6 '
+    command += obj['name']
+    if obj.get('udp_port') is not None:
+        command += ' udp-port %s' % obj['udp_port']
+    return command
+
+
+def map_obj_to_commands(updates):
+    want, have = updates
+    commands = []
+    for entry in want:
+        dest = entry['dest']
+        state = entry['state']
+        if entry.get('facility') is not None:
+            current = next((obj for obj in have if obj.get('dest') is None), None)
+            if state == 'present':
+                if current is None or current.get('facility') != entry['facility']:
+                    commands.append('logging facility %s' % entry['facility'])
+            elif current and current.get('facility_configured'):
+                commands.append('no logging facility')
+        if dest is None:
+            continue
+        matches = [obj for obj in have if obj.get('dest') == dest]
+        if dest == 'host':
+            same_name = [obj for obj in matches if obj.get('name') == entry['name']
+                         and obj.get('addr6') == entry['addr6']]
+            if state == 'absent':
+                for obj in same_name:
+                    if entry['udp_port'] is None or entry['udp_port'] == obj.get('udp_port'):
+                        commands.append('no ' + _host_command(obj))
+            elif entry['udp_port'] is None:
+                if search_obj_in_list(entry['name'], same_name) is None:
+                    commands.append(_host_command(entry))
+            elif not any(obj.get('udp_port') == entry['udp_port'] for obj in same_name):
+                for obj in same_name:
+                    commands.append('no ' + _host_command(obj))
+                commands.append(_host_command(entry))
+        elif dest == 'buffered':
+            current = matches[0].get('level', set()) if matches else set()
+            requested = entry['level']
+            if state == 'present':
+                adds, _ = diff_in_list(requested, current)
+                commands.extend('logging buffered %s' % level for level in LEVELS if level in adds)
+            else:
+                commands.extend('no logging buffered %s' % level
+                                for level in LEVELS if level in current & requested)
+        elif dest == 'console':
+            if state == 'absent':
+                if matches:
+                    commands.append('no logging console' +
+                                    (' %s' % entry['level'] if entry['level'] else ''))
+            elif not matches or (entry['level'] is not None and
+                                 not any(obj.get('level') == entry['level'] for obj in matches)):
+                commands.append('logging console' +
+                                (' %s' % entry['level'] if entry['level'] else ''))
+        else:
+            command = 'logging enable rfc5424' if dest == 'rfc5424' else 'logging %s' % dest
+            if state == 'present' and not matches:
+                commands.append(command)
+            elif state == 'absent' and matches:
+                commands.append('no ' + command)
+    return list(dict.fromkeys(commands))
+
+
+def main():
+    element_spec = dict(
+        dest=dict(type='str', choices=DESTINATIONS),
+        name=dict(type='str'), udp_port=dict(type='int'),
+        facility=dict(type='str'), level=dict(type='str', choices=LEVELS),
+        state=dict(type='str', default='present', choices=['present', 'absent']))
+    aggregate_spec = deepcopy(element_spec)
+    remove_default_spec(aggregate_spec)
+    argument_spec = dict(
+        aggregate=dict(type='list', elements='dict', options=aggregate_spec),
+        check_running_config=dict(type='bool', default=True,
+                                  fallback=(env_fallback, ['ANSIBLE_CHECK_ICX_RUNNING_CONFIG'])))
+    argument_spec.update(element_spec)
+    module = AnsibleModule(argument_spec=argument_spec, supports_check_mode=True)
+    required_if = [('dest', 'host', ['name']), ('dest', 'buffered', ['level'])]
+    want = map_params_to_obj(module, required_if)
+    have = map_config_to_obj(module)
+    commands = map_obj_to_commands((want, have))
+    if commands and not module.check_mode:
+        load_config(module, commands)
+    module.exit_json(changed=bool(commands), commands=commands)
+
+
+if __name__ == '__main__':
+    main()
