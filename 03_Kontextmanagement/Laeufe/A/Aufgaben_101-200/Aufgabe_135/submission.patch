+@pytest.mark.parametrize('filter_name, expected', [('min', 'B'), ('max', 'a')])
+def test_min_max_keyword_arguments(filter_name, expected):
+    data = [{'name': 'a'}, {'name': 'B'}]
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, data, attribute='name', case_sensitive=True)['name'] == expected
+
+    template_env = Environment()
+    template_env.filters[filter_name] = filter_func
+    assert template_env.from_string('{{ (data | %s(attribute="name", case_sensitive=True))["name"] }}' % filter_name).render(data=data) == expected
+
+
+@pytest.mark.parametrize('filter_name, availability_flag, expected',
+                         [('min', 'HAS_MIN', 1), ('max', 'HAS_MAX', 3)])
+def test_min_max_fallback(monkeypatch, filter_name, availability_flag, expected):
+    monkeypatch.setattr(ms, availability_flag, False)
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, [1, 3]) == expected
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(env, [1, 3], attribute='value')
+    assert error.value.message == ("Ansible's %s filter does not support any keyword arguments. "
+                                   "You need Jinja2 2.10 or later that provides their version of the filter." % filter_name)
+
+
+@pytest.mark.parametrize('filter_name, jinja_filter_name', [('min', 'do_min'), ('max', 'do_max')])
+def test_min_max_forwards_all_keywords(monkeypatch, filter_name, jinja_filter_name):
+    received = {}
+
+    def fake_filter(environment, values, **kwargs):
+        received.update(environment=environment, values=values, kwargs=kwargs)
+        return 'result'
+
+    monkeypatch.setattr(ms, jinja_filter_name, fake_filter)
+    values = [1, 2]
+    assert getattr(ms, filter_name)(env, values, custom_option='sentinel') == 'result'
+    assert received == {'environment': env, 'values': values, 'kwargs': {'custom_option': 'sentinel'}}
 
 
