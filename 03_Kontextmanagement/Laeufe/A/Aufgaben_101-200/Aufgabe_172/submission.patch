+// NewPortStat parses a listening address in <ip>:<port> form.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	host, port, err := net.SplitHostPort(ipPort)
+	if err != nil || host == "" || port == "" {
+		return nil, xerrors.Errorf("invalid listening port: %q", ipPort)
+	}
+	if host != "*" && net.ParseIP(host) == nil {
+		return nil, xerrors.Errorf("invalid listening address: %q", host)
+	}
+	if n, err := strconv.Atoi(port); err != nil || n < 0 || n > 65535 {
+		return nil, xerrors.Errorf("invalid port: %q", port)
+	}
+	if strings.Contains(host, ":") {
+		host = "[" + host + "]"
+	}
+	stat.BindAddress, stat.Port = host, port
+	return stat, nil
+}
+
+// HasReachablePort reports whether a package has a reachable listening port.
+func (p Package) HasReachablePort() bool {
+	for _, proc := range p.AffectedProcs {
+		for _, stat := range proc.ListenPortStats {
+			if len(stat.PortReachableTo) > 0 {
 				return true
 			}
 		}
 	}
-
 	return false
 }
 
diff --git a/models/portstat_test.go b/models/portstat_test.go
new file mode 100644
index 0000000..624f77f
--- /dev/null
+++ b/models/portstat_test.go
@@ -0,0 +1,53 @@
+package models
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestNewPortStat(t *testing.T) {
+	for _, tc := range []struct {
+		input   string
+		want    PortStat
+		invalid bool
+	}{
+		{"", PortStat{}, false},
+		{"127.0.0.1:22", PortStat{BindAddress: "127.0.0.1", Port: "22"}, false},
+		{"*:22", PortStat{BindAddress: "*", Port: "22"}, false},
+		{"[::1]:22", PortStat{BindAddress: "[::1]", Port: "22"}, false},
+		{"127.0.0.1", PortStat{}, true},
+		{"127.0.0.1:", PortStat{}, true},
+		{"[::1]", PortStat{}, true},
+		{"invalid:22", PortStat{}, true},
+		{"127.0.0.1:abc", PortStat{}, true},
+	} {
+		got, err := NewPortStat(tc.input)
+		if tc.invalid {
+			if err == nil {
+				t.Errorf("NewPortStat(%q): expected error", tc.input)
+			}
+			continue
+		}
+		if err != nil || got == nil || !reflect.DeepEqual(*got, tc.want) {
+			t.Errorf("NewPortStat(%q) = %v, %v; want %+v", tc.input, got, err, tc.want)
+		}
+	}
+}
+
+func TestLegacyListenPortsJSON(t *testing.T) {
+	var p Package
+	if err := json.Unmarshal([]byte(`{"affectedProcs":[{"pid":"1","listenPorts":["127.0.0.1:22","*:80"]}]}`), &p); err != nil {
+		t.Fatal(err)
+	}
+	if len(p.AffectedProcs) != 1 || !reflect.DeepEqual(p.AffectedProcs[0].ListenPorts, []string{"127.0.0.1:22", "*:80"}) {
+		t.Fatalf("legacy ports were lost: %+v", p.AffectedProcs)
+	}
+	if p.HasReachablePort() {
+		t.Fatal("legacy ports must not imply reachability")
+	}
+	p.AffectedProcs[0].ListenPortStats = []PortStat{{BindAddress: "*", Port: "80", PortReachableTo: []string{"127.0.0.1"}}}
+	if !p.HasReachablePort() {
+		t.Fatal("reachable stat was missed")
+	}
+}
