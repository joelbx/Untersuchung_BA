diff --git a/packages/components/containers/notifications/notifications.spec.tsx b/packages/components/containers/notifications/notifications.spec.tsx
new file mode 100644
index 0000000..b522a90
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.spec.tsx
@@ -0,0 +1,107 @@
+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import createNotificationManager from './manager';
+import Notification from './Notification';
+import NotificationsContainer from './Container';
+import { NotificationOptions } from './interfaces';
+
+describe('notification content', () => {
+    it('sanitizes HTML and opens links safely', () => {
+        render(
+            <Notification type="error" isClosing={false} onExit={jest.fn()}>
+                {'See <a href="https://example.com" onclick="alert(1)">help</a><script>alert(1)</script>'}
+            </Notification>
+        );
+
+        const link = screen.getByRole('link', { name: 'help' });
+        expect(link).toHaveAttribute('href', 'https://example.com');
+        expect(link).toHaveAttribute('target', '_blank');
+        expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(link).not.toHaveAttribute('onclick');
+        expect(screen.getByRole('alert').querySelector('script')).toBeNull();
+    });
+
+    it('preserves React elements and secures their links', () => {
+        render(
+            <Notification type="info" isClosing={false} onExit={jest.fn()}>
+                <a href="https://example.com">help</a>
+            </Notification>
+        );
+
+        expect(screen.getByRole('link', { name: 'help' })).toHaveAttribute('target', '_blank');
+        expect(screen.getByRole('link', { name: 'help' })).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('removes unsafe link URLs', () => {
+        render(
+            <Notification type="error" isClosing={false} onExit={jest.fn()}>
+                {'<a href="javascript:alert(1)">unsafe</a>'}
+            </Notification>
+        );
+
+        expect(screen.getByText('unsafe')).not.toHaveAttribute('href');
+    });
+});
+
+describe('notification deduplication', () => {
+    let notifications: NotificationOptions[];
+    let manager: ReturnType<typeof createNotificationManager>;
+
+    beforeEach(() => {
+        notifications = [];
+        manager = createNotificationManager((update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        });
+    });
+
+    afterEach(() => manager.clearNotifications());
+
+    it('uses string text as the fallback key and replaces duplicate non-success messages', () => {
+        manager.createNotification({ text: 'same', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'info', expiration: -1 });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ key: 'same', type: 'info' });
+    });
+
+    it('uses an explicit key for React element notifications', () => {
+        manager.createNotification({ text: <b>first</b>, key: 'shared', type: 'warning', expiration: -1 });
+        manager.createNotification({ text: <b>second</b>, key: 'shared', type: 'error', expiration: -1 });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ key: 'shared', type: 'error' });
+    });
+
+    it('keeps identical text with distinct explicit keys', () => {
+        manager.createNotification({ text: 'same', key: 'first', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'same', key: 'second', type: 'error', expiration: -1 });
+
+        expect(notifications.map(({ key }) => key)).toEqual(['first', 'second']);
+    });
+
+    it('uses the identifier for React elements without a key', () => {
+        manager.createNotification({ text: <b>same</b>, type: 'error', expiration: -1 });
+        manager.createNotification({ text: <b>same</b>, type: 'error', expiration: -1 });
+
+        expect(notifications).toHaveLength(2);
+        expect(notifications.map(({ key }) => key)).toEqual(notifications.map(({ id }) => id));
+    });
+
+    it('allows repeated success messages', () => {
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'same', type: 'success', expiration: -1 });
+
+        expect(notifications).toHaveLength(2);
+        const errorSpy = jest.spyOn(console, 'error').mockImplementation(() => {});
+        render(
+            <NotificationsContainer
+                notifications={notifications}
+                removeNotification={jest.fn()}
+                hideNotification={jest.fn()}
+            />
+        );
+        expect(screen.getAllByText('same')).toHaveLength(2);
+        expect(errorSpy).not.toHaveBeenCalled();
+        errorSpy.mockRestore();
+    });
+});
