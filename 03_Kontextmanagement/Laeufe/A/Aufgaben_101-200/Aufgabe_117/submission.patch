+def _get_locale_pak_path(locales_dir: Union[str, pathlib.Path],
+                         locale: str) -> pathlib.Path:
+    """Return the QtWebEngine locale resource path for a BCP 47 locale."""
+    return pathlib.Path(locales_dir) / (locale.replace('_', '-') + '.pak')
+
+
+def _get_lang_override(versions: version.WebEngineVersions,
+                       locale: str) -> Optional[str]:
+    """Return a Chromium language fallback for QtWebEngine 5.15.3 if needed."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    locales_dir = pathlib.Path(QLibraryInfo.location(QLibraryInfo.TranslationsPath)) / \
+        'qtwebengine_locales'
+    locale = locale.replace('_', '-')
+    if _get_locale_pak_path(locales_dir, locale).is_file():
+        return None
+
+    language = locale.split('-', maxsplit=1)[0]
+    if locale in ('en', 'en-US', 'en-LR', 'en-PH'):
+        candidates = ('en-US',)
+    elif language == 'en':
+        candidates = ('en-GB', 'en-US')
+    elif language == 'es' and locale != 'es':
+        candidates = ('es-419', 'es') if locale != 'es-ES' else ('es',)
+    elif language == 'pt':
+        candidates = ('pt-BR',) if locale == 'pt' else ('pt-BR', 'pt')
+    elif language == 'zh':
+        if locale in ('zh-HK', 'zh-MO', 'zh-TW') or locale.startswith('zh-Hant'):
+            candidates = ('zh-TW',)
+        else:
+            candidates = ('zh-CN',)
+    else:
+        candidates = (language,)
+
+    for candidate in candidates:
+        if _get_locale_pak_path(locales_dir, candidate).is_file():
+            return candidate
+    return 'en-US'
+
+
