+// ConvertFortinetToModel converts Fortinet advisories to CVE contents.
+func ConvertFortinetToModel(cveID string, fortinets []cvedict.Fortinet) []CveContent {
+	contents := make([]CveContent, 0, len(fortinets))
+	for _, fortinet := range fortinets {
+		cweIDs := make([]string, 0, len(fortinet.Cwes))
+		for _, cwe := range fortinet.Cwes {
+			cweIDs = append(cweIDs, cwe.CweID)
+		}
+		refs := make([]Reference, 0, len(fortinet.References))
+		for _, ref := range fortinet.References {
+			refs = append(refs, Reference{Link: ref.Link, Source: ref.Source})
+		}
+		contents = append(contents, CveContent{
+			Type: Fortinet, CveID: cveID,
+			Title: fortinet.Title, Summary: fortinet.Summary,
+			Cvss3Score:    fortinet.Cvss3.BaseScore,
+			Cvss3Vector:   fortinet.Cvss3.VectorString,
+			Cvss3Severity: fortinet.Cvss3.BaseSeverity,
+			SourceLink:    fortinet.AdvisoryURL,
+			CweIDs:        cweIDs, References: refs,
+			Published:    fortinet.PublishedDate,
+			LastModified: fortinet.LastModifiedDate,
+		})
+	}
+	return contents
+}
