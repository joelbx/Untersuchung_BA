diff --git a/models/utils_test.go b/models/utils_test.go
new file mode 100644
index 0000000..49c25d9
--- /dev/null
+++ b/models/utils_test.go
@@ -0,0 +1,34 @@
+//go:build !scanner
+
+package models
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertFortinetToModel(t *testing.T) {
+	published := time.Date(2023, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	got := ConvertFortinetToModel("CVE-2023-0001", []cvedict.Fortinet{{
+		AdvisoryID: "FG-IR-23-001", Title: "FortiOS issue", Summary: "Affected versions",
+		AdvisoryURL:   "https://www.fortiguard.com/psirt/FG-IR-23-001",
+		Cvss3:         cvedict.FortinetCvss3{Cvss3: cvedict.Cvss3{BaseScore: 8.1, VectorString: "CVSS:3.1/AV:N", BaseSeverity: "HIGH"}},
+		Cwes:          []cvedict.FortinetCwe{{CweID: "CWE-79"}},
+		References:    []cvedict.FortinetReference{{Reference: cvedict.Reference{Link: "https://example.org/ref", Source: "Fortinet"}}},
+		PublishedDate: published, LastModifiedDate: modified,
+	}})
+	want := []CveContent{{
+		Type: Fortinet, CveID: "CVE-2023-0001", Title: "FortiOS issue", Summary: "Affected versions",
+		SourceLink: "https://www.fortiguard.com/psirt/FG-IR-23-001",
+		Cvss3Score: 8.1, Cvss3Vector: "CVSS:3.1/AV:N", Cvss3Severity: "HIGH",
+		CweIDs: []string{"CWE-79"}, References: []Reference{{Link: "https://example.org/ref", Source: "Fortinet"}},
+		Published: published, LastModified: modified,
+	}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ConvertFortinetToModel() = %#v, want %#v", got, want)
+	}
+}
