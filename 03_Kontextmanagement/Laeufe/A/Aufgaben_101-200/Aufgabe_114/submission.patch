 type Albums []Album
 
+// BaseFolder returns the common parent of the albums' media directories.
+func (als Albums) BaseFolder() string {
+	var base string
+	for _, album := range als {
+		for _, dir := range album.Dirs() {
+			parent := filepath.Dir(dir)
+			if base == "" {
+				base = parent
+			} else {
+				for base != parent && !isParentDir(base, parent) {
+					base = filepath.Dir(base)
+					if base == "." || base == string(filepath.Separator) {
+						return ""
+					}
+				}
+			}
+		}
+	}
+	return base
+}
+
+func isParentDir(parent, dir string) bool {
+	rel, err := filepath.Rel(parent, dir)
+	return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
