+func fromArtistFolder(folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		entries, err := os.ReadDir(folder)
+		if err != nil {
+			return nil, "", err
+		}
+		for _, entry := range entries {
+			if entry.IsDir() || !strings.HasPrefix(strings.ToLower(entry.Name()), "artist.") || !model.IsImageFile(entry.Name()) {
+				continue
+			}
+			path := filepath.Join(folder, entry.Name())
+			file, err := os.Open(path)
+			if err == nil {
+				return file, path, nil
+			}
+		}
+		return nil, "", nil
+	}
+}
