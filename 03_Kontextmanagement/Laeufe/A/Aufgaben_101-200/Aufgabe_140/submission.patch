+@pytest.mark.parametrize('blocked_set', ['_blocked_hosts', '_config_blocked_hosts'])
+@pytest.mark.parametrize('blocked_host', ['example.com', 'example.com.'])
+@pytest.mark.parametrize('request_host', [
+    'example.com', 'sub.example.com', 'a.b.example.com',
+    'example.com.', 'sub.example.com.',
+])
+def test_parent_domain_blocks_subdomains(
+        config_stub, host_blocker_factory, blocked_set, blocked_host, request_host):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = None
+
+    blocker = host_blocker_factory()
+    getattr(blocker, blocked_set).add(blocked_host)
+
+    assert blocker._is_blocked(QUrl('https://' + request_host + '/path'))
+    assert not blocker._is_blocked(QUrl('https://notexample.com/path'))
+
+
+def test_whitelist_overrides_parent_domain(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = ['https://allowed.example.com/*']
+
+    blocker = host_blocker_factory()
+    blocker._blocked_hosts.add('example.com')
+
+    assert not blocker._is_blocked(QUrl('https://allowed.example.com/path'))
+    assert blocker._is_blocked(QUrl('https://other.example.com/path'))
+
