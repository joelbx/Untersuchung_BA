diff --git a/openlibrary/tests/test_book_providers_runeberg.py b/openlibrary/tests/test_book_providers_runeberg.py
new file mode 100644
index 0000000..d5c8274
--- /dev/null
+++ b/openlibrary/tests/test_book_providers_runeberg.py
@@ -0,0 +1,16 @@
+from openlibrary.book_providers import ProjectRunebergProvider, get_book_provider_by_name
+
+
+def test_project_runeberg_provider():
+    provider = ProjectRunebergProvider()
+    assert get_book_provider_by_name('runeberg') is not None
+    assert provider.is_own_ocaid('RUNEberg_nordicbook')
+    assert not provider.is_own_ocaid('unrelated_archive')
+
+    acquisition = provider.get_acquisitions(
+        {'identifiers': {'project_runeberg': ['nordicbook', 'otherbook']}}
+    )
+    assert len(acquisition) == 1
+    assert acquisition[0].access == 'open-access'
+    assert acquisition[0].format == 'web'
+    assert acquisition[0].url == 'https://runeberg.org/nordicbook/'
