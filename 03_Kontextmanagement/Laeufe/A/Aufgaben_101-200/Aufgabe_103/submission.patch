+// The query format separates the release from the version with one space. An
+// empty release therefore leaves two spaces before the architecture.
+func splitInstalledPackageFields(line string) []string {
+	parts := installedPackageFieldsPattern.FindStringSubmatch(strings.TrimSpace(line))
+	if len(parts) != 6 {
+		return nil
+	}
+	return append(parts[1:5], strings.Fields(parts[5])...)
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
