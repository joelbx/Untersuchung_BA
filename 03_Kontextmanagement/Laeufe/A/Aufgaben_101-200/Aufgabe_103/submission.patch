+func TestEmptyReleaseInstalledPackages(t *testing.T) {
+	for _, tt := range []struct {
+		name, line, repo, version, sourceVersion string
+		repoquery                                bool
+	}{
+		{"rpm zero epoch", "package 0 1.2  x86_64 package-1.2--src.rpm", "", "1.2", "1.2", false},
+		{"rpm epoch", "package 3 1.2  x86_64 package-1.2--src.rpm", "", "3:1.2", "3:1.2", false},
+		{"rpm none epoch", "package (none) 1.2  x86_64 package-1.2-.src.rpm", "", "1.2", "1.2", false},
+		{"repoquery zero epoch", "package 0 1.2  x86_64 package-1.2--src.rpm @amzn2-core", "amzn2-core", "1.2", "1.2", true},
+		{"repoquery epoch", "package 3 1.2  x86_64 package-1.2--src.rpm installed", "amzn2-core", "3:1.2", "3:1.2", true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var bp *models.Package
+			var sp *models.SrcPackage
+			var err error
+			if tt.repoquery {
+				bp, sp, err = o.parseInstalledPackagesLineFromRepoquery(tt.line)
+			} else {
+				bp, sp, err = o.parseInstalledPackagesLine(tt.line)
+			}
+			if err != nil || bp == nil || sp == nil {
+				t.Fatalf("parse failed: binary=%v source=%v error=%v", bp, sp, err)
+			}
+			if bp.Name != "package" || bp.Version != tt.version || bp.Release != "" || bp.Arch != "x86_64" || bp.Repository != tt.repo {
+				t.Errorf("binary package = %+v", bp)
+			}
+			if sp.Name != "package" || sp.Version != tt.sourceVersion || sp.Arch != "src" {
+				t.Errorf("source package = %+v", sp)
+			}
+		})
+	}
+}
+
+func TestEmptyReleaseInstalledPackagesAmazonDispatch(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2"}, log: logging.NewIODiscardLogger()}}
+	bins, srcs, err := o.parseInstalledPackages("package 0 1.2  x86_64 package-1.2--src.rpm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bins["package"].Release != "" || bins["package"].Version != "1.2" || srcs["package"].Version != "1.2" {
+		t.Errorf("binary=%+v source=%+v", bins["package"], srcs["package"])
+	}
+}
+
+func TestSplitFileNameSourceAndMalformed(t *testing.T) {
+	for _, tt := range []struct {
+		file, name, version, release, arch string
+		invalid                            bool
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src", false},
+		{"package-0--src.rpm", "package", "0", "", "src", false},
+		{"package-0-1.src.rpm", "package", "0", "1", "src", false},
+		{"package-0-1-src", "", "", "", "", true},
+		{"-0-1.src.rpm", "", "", "", "", true},
+		{"package--1.src.rpm", "", "", "", "", true},
+		{"package-0-1..rpm", "", "", "", "", true},
+	} {
+		t.Run(tt.file, func(t *testing.T) {
+			n, v, r, _, a, err := splitFileName(tt.file)
+			if (err != nil) != tt.invalid {
+				t.Fatalf("error=%v, invalid=%v", err, tt.invalid)
+			}
+			if !tt.invalid && (n != tt.name || v != tt.version || r != tt.release || a != tt.arch) {
+				t.Errorf("got %q %q %q %q", n, v, r, a)
+			}
+		})
+	}
+}
