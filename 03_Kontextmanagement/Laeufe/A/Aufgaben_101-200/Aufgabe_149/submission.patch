diff --git a/tests/unit/config/test_qtargs.py b/tests/unit/config/test_qtargs.py
index b38fab4..b412729 100644
--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -383,6 +383,71 @@ class TestQtArgs:
         assert combined_flag in args
         assert overlay_flag not in args
 
+    @pytest.mark.parametrize('enable_via_commandline', [True, False])
+    @pytest.mark.parametrize('disable_via_commandline', [True, False])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch, parser,
+                                         enable_via_commandline,
+                                         disable_via_commandline):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+
+        enable = 'enable-features=First,Second'
+        disable = 'disable-features=Third,Fourth'
+        commandline = []
+        config_args = []
+        for flag, via_commandline in [(enable, enable_via_commandline),
+                                      (disable, disable_via_commandline)]:
+            if via_commandline:
+                commandline.extend(['--qt-flag', flag])
+            else:
+                config_args.append(flag)
+
+        config_stub.val.qt.args = config_args
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+        enabled = [arg for arg in args
+                   if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        disabled = [arg for arg in args
+                    if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)]
+        assert enabled == ['--enable-features=First,Second,OverlayScrollbar']
+        assert disabled == ['--disable-features=Third,Fourth']
+
+    def test_multiple_disable_features_flags(self, config_stub, monkeypatch,
+                                             parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['disable-features=FromConfig']
+
+        args = qtargs.qt_args(parser.parse_args(
+            ['--qt-flag', 'disable-features=FromCommandline']))
+        assert [arg for arg in args if arg.startswith(
+            qtargs.DISABLE_FEATURES_PREFIX)] == [
+                '--disable-features=FromCommandline',
+                '--disable-features=FromConfig',
+            ]
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+
+    def test_multiple_enable_features_flags(self, config_stub, monkeypatch,
+                                            parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['enable-features=FromConfig,Another']
+
+        args = qtargs.qt_args(parser.parse_args(
+            ['--qt-flag', 'enable-features=FromCommandline']))
+        assert [arg for arg in args if arg.startswith(
+            qtargs.ENABLE_FEATURES_PREFIX)] == [
+                '--enable-features=FromCommandline,FromConfig,Another',
+            ]
+
