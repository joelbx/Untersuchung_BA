+// UpdateRemoteCluster persists the status and last heartbeat of a remote cluster.
+func (s *PresenceService) UpdateRemoteCluster(ctx context.Context, rc services.RemoteCluster) error {
+	value, err := json.Marshal(rc)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	_, err = s.Put(ctx, backend.Item{
+		Key:     backend.Key(remoteClustersPrefix, rc.GetName()),
+		Value:   value,
+		Expires: rc.Expiry(),
+		ID:      rc.GetResourceID(),
+	})
+	return trace.Wrap(err)
+}
+
+func (s *PresenceService) updateRemoteClusterFromTunnel(ctx context.Context, clusterName string, heartbeat time.Time, online bool) error {
+	rc, err := s.GetRemoteCluster(clusterName)
+	if trace.IsNotFound(err) {
+		return nil
+	}
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	status := teleport.RemoteClusterStatusOffline
+	if online {
+		status = teleport.RemoteClusterStatusOnline
+	}
+	if rc.GetConnectionStatus() == status && !heartbeat.After(rc.GetLastHeartbeat()) {
+		return nil
+	}
+	rc.SetConnectionStatus(status)
+	if heartbeat.After(rc.GetLastHeartbeat()) {
+		rc.SetLastHeartbeat(heartbeat.UTC())
+	}
+	return s.UpdateRemoteCluster(ctx, rc)
+}
+
+func (s *PresenceService) refreshRemoteClusterStatus(ctx context.Context, clusterName string) error {
+	conns, err := s.GetTunnelConnections(clusterName)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	return s.updateRemoteClusterFromTunnel(ctx, clusterName, time.Time{}, len(conns) != 0)
+}
