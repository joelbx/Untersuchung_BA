+func (s *PresenceSuite) TestRemoteClusterTunnelStatusAndHeartbeat(c *check.C) {
+	presence := NewPresenceService(s.bk)
+	rc, err := services.NewRemoteCluster("remote.example")
+	c.Assert(err, check.IsNil)
+	expires := time.Now().Add(time.Hour).UTC()
+	rc.SetExpiry(expires)
+	c.Assert(presence.CreateRemoteCluster(rc), check.IsNil)
+
+	cluster, err := presence.GetRemoteCluster(rc.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(cluster.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOffline)
+
+	first := time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)
+	older, err := services.NewTunnelConnection("older", services.TunnelConnectionSpecV2{
+		ClusterName: rc.GetName(), ProxyName: "proxy", LastHeartbeat: first,
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(presence.UpsertTunnelConnection(older), check.IsNil)
+
+	latest := first.Add(time.Hour)
+	newer, err := services.NewTunnelConnection("newer", services.TunnelConnectionSpecV2{
+		ClusterName: rc.GetName(), ProxyName: "proxy", LastHeartbeat: latest,
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(presence.UpsertTunnelConnection(newer), check.IsNil)
+	c.Assert(presence.DeleteTunnelConnection(rc.GetName(), newer.GetName()), check.IsNil)
+
+	cluster, err = presence.GetRemoteCluster(rc.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(cluster.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOnline)
+	c.Assert(cluster.GetLastHeartbeat(), check.Equals, latest)
+	c.Assert(cluster.Expiry(), check.Equals, expires)
+
+	c.Assert(presence.DeleteTunnelConnection(rc.GetName(), older.GetName()), check.IsNil)
+	cluster, err = presence.GetRemoteCluster(rc.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(cluster.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOffline)
+	c.Assert(cluster.GetLastHeartbeat(), check.Equals, latest)
+}
