+test('shows configured database read-only mode and storage type', async ({
+  page
+}) => {
+  await page.route(/\/meta\/config/, async (route) => {
+    const response = await route.fetch();
+    const json = await response.json();
+    json.storage = { type: 'database', readOnly: true };
+    await route.fulfill({ response, json });
+  });
+
+  await page.goto('/');
+  await expect(page.getByLabel('database storage, Read-Only')).toBeVisible();
+  await expect(page.getByText('Read-Only')).toBeVisible();
+});
