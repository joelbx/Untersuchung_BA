+func TestDatabaseReadOnlyConfiguration(t *testing.T) {
+	for _, readOnly := range []bool{true, false} {
+		t.Run(fmt.Sprint(readOnly), func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(fmt.Sprintf("storage:\n  type: database\n  readOnly: %t\n", readOnly)), 0600))
+			result, err := Load(path)
+			require.NoError(t, err)
+			require.NotNil(t, result.Config.Storage.ReadOnly)
+			assert.Equal(t, readOnly, *result.Config.Storage.ReadOnly)
+		})
+	}
