diff --git a/openlibrary/catalog/utils/__init__.py b/openlibrary/catalog/utils/__init__.py
index 0833435..09c8b4b 100644
--- a/openlibrary/catalog/utils/__init__.py
+++ b/openlibrary/catalog/utils/__init__.py
@@ -3,6 +3,70 @@ from re import Match
 import web
 from unicodedata import normalize
 import openlibrary.catalog.merge.normalize as merge
+from openlibrary.catalog.merge.normalize import normalize as normalize_title
+
+
+re_amazon_title_paren = re.compile(r'^(.*) \([^)]+?\)$')
+
+
+def build_titles(title: str) -> dict[str, str | list[str]]:
+    """Build title variants for comparing edition records."""
+    normalized_title = normalize_title(title).lower()
+    titles = [title, normalized_title]
+    if ' & ' in title:
+        alternative = title.replace(' & ', ' and ')
+        titles.extend((alternative, normalize_title(alternative)))
+
+    without_article = []
+    for variant in titles:
+        if variant.lower().startswith('the '):
+            without_article.append(variant[4:])
+        elif variant.lower().startswith('a '):
+            without_article.append(variant[2:])
+    titles += without_article
+
+    if re_amazon_title_paren.match(title):
+        without_parens: list[str] = []
+        for variant in titles:
+            match = re_amazon_title_paren.match(variant)
+            if match:
+                without_parens.extend((match.group(1), normalize_title(match.group(1))))
+        titles += without_parens
+
+    return {
+        'full_title': title,
+        'normalized_title': normalized_title,
+        'titles': titles,
+        'short_title': normalized_title[:25],
+    }
+
+
+def expand_record(rec: dict) -> dict[str, str | list[str]]:
+    """Expand an edition record into title and ISBN variants for matching.
+
+    The input must contain ``full_title``. Other comparison fields are copied
+    when present, except for placeholder publication country codes.
+    """
+    expanded = build_titles(rec['full_title'])
+    isbn: list[str] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        isbn.extend(rec.get(field, []))
+    expanded['isbn'] = isbn
+
+    if 'publish_country' in rec and rec['publish_country'] not in ('   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if field in rec:
+            expanded[field] = rec[field]
+    return expanded
 
 
