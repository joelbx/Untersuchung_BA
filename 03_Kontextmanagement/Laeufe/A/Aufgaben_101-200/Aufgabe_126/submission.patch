+import { parseStringToDOM } from '@proton/shared/lib/helpers/dom';
+
+import { prepareContentToModel } from './input';
+import { parseModelResult } from './result';
+
+it('round trips formatting and restores URLs only for the originating message', () => {
+    const source =
+        '<p><a href="https://example.com" class="link" style="color: red">Click <strong>here</strong></a><img src="https://example.com/a.png" class="image" style="width: 10px"></p>';
+    const markdown = prepareContentToModel(source, 'uid', 'message-1');
+    const same = parseStringToDOM(parseModelResult(markdown, 'message-1'));
+    expect(same.body.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+    expect(same.body.querySelector('a')?.getAttribute('class')).toBe('link');
+    expect(same.body.querySelector('a')?.getAttribute('style')).toBe('color: red');
+    expect(same.body.querySelector('a strong')?.textContent).toBe('here');
+    expect(same.body.querySelector('img')?.getAttribute('src')).toBe('https://example.com/a.png');
+    expect(same.body.querySelector('img')?.getAttribute('class')).toBe('image');
+    expect(same.body.querySelector('img')?.getAttribute('style')).toBe('width: 10px');
+
+    const other = parseStringToDOM(parseModelResult(markdown, 'message-2'));
+    expect(other.body.querySelector('a')).toBeNull();
+    expect(other.body.querySelector('img')).toBeNull();
+    expect(other.body.textContent).toContain('Click here');
+});
