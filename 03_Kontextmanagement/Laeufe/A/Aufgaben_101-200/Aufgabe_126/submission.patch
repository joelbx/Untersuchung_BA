+import { parseStringToDOM } from '@proton/shared/lib/helpers/dom';
+
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+it('moves nested lists into the preceding list item', () => {
+    const dom = parseStringToDOM('<ul><li>Parent</li><ul><li>Child</li></ul></ul>');
+    fixNestedLists(dom);
+    expect(dom.body.querySelector('li > ul > li')?.textContent).toBe('Child');
+    expect(dom.body.querySelector('ul > ul')).toBeNull();
+});
+
+it('preserves ordered and nested list structure across conversion', () => {
+    const dom = parseStringToDOM('<ol><li>First<ul><li>Child</li></ul></li><li>Second</li></ol>');
+    const html = markdownToHTML(htmlToMarkdown(dom));
+    const result = parseStringToDOM(html);
+    expect(result.body.querySelector('ol > li > ul > li')?.textContent).toBe('Child');
+    expect(result.body.querySelectorAll('ol > li')).toHaveLength(2);
+});
+
+it('preserves class and style on links and images', () => {
+    const dom = parseStringToDOM(
+        '<a href="#1" class="link" style="color: red">Text</a><img src="#2" class="image" style="width: 10px">'
+    );
+    const html = markdownToHTML(htmlToMarkdown(dom));
+    const result = parseStringToDOM(html);
+    expect(result.body.querySelector('a')?.getAttribute('class')).toBe('link');
+    expect(result.body.querySelector('a')?.getAttribute('style')).toBe('color: red');
+    expect(result.body.querySelector('img')?.getAttribute('class')).toBe('image');
+    expect(result.body.querySelector('img')?.getAttribute('style')).toBe('width: 10px');
+});
