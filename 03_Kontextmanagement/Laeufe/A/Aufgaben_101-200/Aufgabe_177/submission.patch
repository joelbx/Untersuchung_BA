diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..352c51b
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,31 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chats to an allow list',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const keys = uids.map(uid => `user:${uid}:settings`);
+			const settings = await db.getObjects(keys);
+			const writes = [];
+			await Promise.all(uids.map(async (uid, index) => {
+				const current = settings[index] || {};
+				if (parseInt(current.restrictChat, 10) !== 1 || current.chatAllowList !== undefined) {
+					return;
+				}
+				const following = await db.getSortedSetRange([`following:${uid}`, `followingRemote:${uid}`], 0, -1);
+				writes.push([keys[index], { chatAllowList: JSON.stringify(following.map(String)) }]);
+			}));
+			if (writes.length) {
+				await db.setObjectBulk(writes);
+			}
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
