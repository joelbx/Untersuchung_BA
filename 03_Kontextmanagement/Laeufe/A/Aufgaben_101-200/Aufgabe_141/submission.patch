diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..c399a7f
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,34 @@
+package wordpress
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactives(t *testing.T) {
+	core := models.WpPackage{Name: models.WPCore, Type: models.WPCore}
+	activePlugin := models.WpPackage{Name: "active-plugin", Type: models.WPPlugin, Status: "active"}
+	muPlugin := models.WpPackage{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"}
+	inactivePlugin := models.WpPackage{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive}
+	inactiveTheme := models.WpPackage{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive}
+
+	tests := []struct {
+		name string
+		in   models.WordPressPackages
+		want models.WordPressPackages
+	}{
+		{name: "mixed", in: models.WordPressPackages{core, activePlugin, inactivePlugin, inactiveTheme, muPlugin}, want: models.WordPressPackages{core, activePlugin, muPlugin}},
+		{name: "all inactive", in: models.WordPressPackages{inactivePlugin, inactiveTheme}},
+		{name: "empty"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := removeInactives(tt.in)
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("removeInactives() = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
