+import os
+import zipfile
+
+import pytest
+
+from openlibrary.coverstore import archive, config
+
+
+def test_cover_paths():
+    assert archive.Cover.id_to_item_and_batch_id(8_012_345) == ("0008", "01")
+    assert (
+        archive.Batch.get_relpath(8, 1, "s")
+        == "items/s_covers_0008/s_covers_0008_01.zip"
+    )
+    assert (
+        archive.Cover.get_cover_url(8_012_345, "m")
+        == (
+            "https://archive.org/download/m_covers_0008/m_covers_0008_01.zip/0008012345-M.jpg"
+        )
+    )
+    assert archive.CoverDB._get_batch_end_id(8_012_345) == 8_019_999
+
+
+def test_zip_manager_deduplicates_and_stores_uncompressed(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    image = tmp_path / "image.jpg"
+    image.write_bytes(b"image")
+    manager = archive.ZipManager()
+    manager.add_file("0008012345-S.jpg", str(image), 1_700_000_000)
+    manager.add_file("0008012345-S.jpg", str(image), 1_700_000_000)
+    manager.close()
+    path = archive.Batch.get_abspath(8, 1, "s")
+    with zipfile.ZipFile(path) as zf:
+        assert zf.namelist() == ["0008012345-S.jpg"]
+        assert zf.read("0008012345-S.jpg") == b"image"
+        assert zf.getinfo("0008012345-S.jpg").compress_type == zipfile.ZIP_STORED
+    assert archive.count_files_in_zip(path) == 1
+
+
+def test_pending_requires_all_verified_sizes(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    batch = archive.Batch(8, 1)
+    for size in archive.SIZES:
+        path = archive.Batch.get_abspath(8, 1, size)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with zipfile.ZipFile(path, "w"):
+            pass
+
+    class StubUploader:
+        def __init__(self):
+            self.uploaded = set()
+            self.calls = []
+
+        def is_uploaded(self, item, filename):
+            return (item, filename) in self.uploaded
+
+        def upload(self, item, paths):
+            self.calls.append((item, paths))
+            self.uploaded.add((item, os.path.basename(paths[0])))
+
+    uploader = StubUploader()
+    assert batch.process_pending(uploader=uploader) is False
+    assert batch.process_pending(upload=True, uploader=uploader) is True
+    assert len(uploader.calls) == 4
+    assert batch.process_pending(uploader=uploader) is True
+    assert len(uploader.calls) == 4
+
+
+def test_batch_rejects_overlapping_work(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    with (
+        archive.Batch(8, 1).lock(),
+        pytest.raises(BlockingIOError),
+        archive.Batch(8, 1).lock(),
+    ):
+        pass
+
+
+def test_completed_batch_updates_only_staged_successful_rows(tmp_path, monkeypatch):
+    import web
+    from openlibrary.coverstore import db, schema
+
+    database = web.database(dbn="sqlite", db=str(tmp_path / "covers.db"))
+    for statement in schema.get_schema("sqlite").split(";"):
+        if statement.strip():
+            database.query(statement)
+    monkeypatch.setattr(db, "getdb", lambda: database)
+    for cover_id, archived, failed in (
+        (8_012_345, True, False),
+        (8_012_346, True, True),
+        (8_012_347, False, False),
+    ):
+        database.insert(
+            "cover",
+            id=cover_id,
+            archived=archived,
+            failed=failed,
+            filename="local.jpg",
+            filename_s="local-S.jpg",
+            filename_m="local-M.jpg",
+            filename_l="local-L.jpg",
+        )
+    assert archive.CoverDB().update_completed_batch("0008", "01") == 1
+    row = database.select("cover", where="id=8012345")[0]
+    assert row.uploaded
+    assert row.filename.endswith("/0008012345.jpg")
+    assert row.filename_s.endswith("/0008012345-S.jpg")
+    assert row.filename_m.endswith("/0008012345-M.jpg")
+    assert row.filename_l.endswith("/0008012345-L.jpg")
+    for cover_id in (8_012_346, 8_012_347):
+        row = database.select("cover", where=f"id={cover_id}")[0]
+        assert not row.uploaded
+        assert row.filename == "local.jpg"
+    assert archive.CoverDB().update_completed_batch(8, 1) == 0
+
+
+def test_stage_and_finalize_batch(tmp_path, monkeypatch):
+    import datetime
+    import web
+    from openlibrary.coverstore import db, schema
+
+    monkeypatch.setattr(config, "data_root", str(tmp_path))
+    database = web.database(dbn="sqlite", db=str(tmp_path / "covers.db"))
+    for statement in schema.get_schema("sqlite").split(";"):
+        if statement.strip():
+            database.query(statement)
+    monkeypatch.setattr(db, "getdb", lambda: database)
+    local = tmp_path / "localdisk"
+    local.mkdir()
+    names = ("cover.jpg", "cover-S.jpg", "cover-M.jpg", "cover-L.jpg")
+    for name in names:
+        (local / name).write_bytes(name.encode())
+    database.insert(
+        "cover",
+        id=8_012_345,
+        archived=False,
+        failed=False,
+        filename=names[0],
+        filename_s=names[1],
+        filename_m=names[2],
+        filename_l=names[3],
+        created=datetime.datetime(2020, 1, 1),
+    )
+    assert archive.archive(test=True) == 1
+    assert not list((tmp_path / "items").rglob("*.zip"))
+    assert archive.archive(test=False) == 1
+    row = database.select("cover", where="id=8012345")[0]
+    assert row.archived
+    assert not row.uploaded
+    assert row.filename == names[0]
+    batch = archive.Batch(8, 1)
+    for size in archive.SIZES:
+        path = batch.get_abspath(8, 1, size)
+        with zipfile.ZipFile(path) as zf:
+            suffix = "-" + size.upper() if size else ""
+            assert zf.namelist() == [f"0008012345{suffix}.jpg"]
+
+    class Uploaded:
+        @staticmethod
+        def is_uploaded(item, filename):
+            return True
+
+    assert batch.finalize(uploader=Uploaded()) is True
+    row = database.select("cover", where="id=8012345")[0]
+    assert row.uploaded
+    assert row.filename.startswith("https://archive.org/download/")
+    assert all(not (local / name).exists() for name in names)
+    assert all(
+        not os.path.exists(batch.get_abspath(8, 1, size)) for size in archive.SIZES
+    )
+    assert batch.finalize(uploader=Uploaded()) is True
