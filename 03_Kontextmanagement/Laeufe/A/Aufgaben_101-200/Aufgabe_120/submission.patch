+def archive(test=True):
+    """Stage one 10k batch. Local images remain readable until finalization."""
+    cover_db = CoverDB()
+    candidates = cover_db.get_unarchived(limit=10_000)
+    if not candidates:
+        return 0
+    item_id, batch_id = Cover.id_to_item_and_batch_id(candidates[0].id)
+    batch = Batch(item_id, batch_id)
+    manager = ZipManager()
+    staged = 0
+    with batch.lock():
+        staged_ids = []
+        try:
+            rows = cover_db.get_batch(batch.start_id, archived=False)
+            for row in rows:
+                cover = Cover(row)
+                if not cover.valid_files():
+                    if test:
+                        continue
+                    cover_db.db.update(
+                        "cover", where="id=$id", vars={"id": row.id}, failed=True
+                    )
+                    continue
+                created = row.created
+                if isinstance(created, str):
+                    from infogami.infobase import utils
+
+                    created = utils.parse_datetime(created)
+                mtime = time.mktime(created.timetuple())
+                if test:
+                    staged += 1
+                    continue
+                for size in SIZES:
+                    key = f"filename_{size}" if size else "filename"
+                    suffix = f"-{size.upper()}" if size else ""
+                    manager.add_file(
+                        f"{row.id:010d}{suffix}.jpg",
+                        os.path.join(config.data_root, "localdisk", row[key]),
+                        mtime,
+                    )
+                staged_ids.append(row.id)
+                staged += 1
+        finally:
+            manager.close()
+        for cover_id in staged_ids:
+            cover_db.db.update(
+                "cover",
+                where="id=$id AND archived=$false",
+                vars={"id": cover_id, "false": False},
+                archived=True,
+            )
+    return staged
