+func TestSamplingRatio(t *testing.T) {
+	for _, test := range []struct {
+		ratio   float64
+		sampled bool
+	}{{0, false}, {1, true}} {
+		provider, err := NewProvider(context.Background(), "test", test.ratio)
+		require.NoError(t, err)
+		_, span := provider.Tracer("test").Start(context.Background(), "operation")
+		assert.Equal(t, test.sampled, span.SpanContext().IsSampled())
+		span.End()
+		require.NoError(t, provider.Shutdown(context.Background()))
+	}
+}
+
+func TestConfiguredPropagators(t *testing.T) {
+	spanContext := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID: trace.TraceID{1}, SpanID: trace.SpanID{2}, TraceFlags: trace.FlagsSampled,
+	})
+	ctx := trace.ContextWithSpanContext(context.Background(), spanContext)
+	for _, test := range []struct {
+		option config.TracingPropagator
+		field  string
+	}{
+		{config.TracingPropagatorTraceContext, "traceparent"},
+		{config.TracingPropagatorB3, "b3"},
+		{config.TracingPropagatorB3Multi, "x-b3-traceid"},
+		{config.TracingPropagatorJaeger, "uber-trace-id"},
+		{config.TracingPropagatorXRay, "X-Amzn-Trace-Id"},
+		{config.TracingPropagatorOTTrace, "ot-tracer-traceid"},
+	} {
+		t.Run(string(test.option), func(t *testing.T) {
+			carrier := propagation.MapCarrier{}
+			NewPropagator([]config.TracingPropagator{test.option}).Inject(ctx, carrier)
+			assert.NotEmpty(t, carrier.Get(test.field))
+		})
+	}
+	carrier := propagation.MapCarrier{}
+	NewPropagator([]config.TracingPropagator{config.TracingPropagatorNone}).Inject(ctx, carrier)
+	assert.Empty(t, carrier)
+}
