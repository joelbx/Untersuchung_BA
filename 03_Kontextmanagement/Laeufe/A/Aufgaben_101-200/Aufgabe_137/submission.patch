--- /dev/null
+++ b/internal/config/tracing_test.go
@@ -0,0 +1,43 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestTracingConfiguration(t *testing.T) {
+	defaults := Default().Tracing
+	require.Equal(t, float64(1), defaults.SamplingRatio)
+	require.Equal(t, []TracingPropagator{TracingPropagatorTraceContext, TracingPropagatorBaggage}, defaults.Propagators)
+
+	for _, test := range []struct {
+		name    string
+		content string
+		ratio   float64
+		props   []TracingPropagator
+		err     string
+	}{
+		{name: "defaults", content: "tracing:\n  enabled: true\n", ratio: 1, props: defaults.Propagators},
+		{name: "custom", content: "tracing:\n  samplingRatio: 0.5\n  propagators: [b3, b3multi, none]\n", ratio: 0.5, props: []TracingPropagator{TracingPropagatorB3, TracingPropagatorB3Multi, TracingPropagatorNone}},
+		{name: "zero", content: "tracing:\n  samplingRatio: 0\n", ratio: 0, props: defaults.Propagators},
+		{name: "negative", content: "tracing:\n  samplingRatio: -0.1\n", err: "sampling ratio should be a number between 0 and 1"},
+		{name: "above one", content: "tracing:\n  samplingRatio: 1.1\n", err: "sampling ratio should be a number between 0 and 1"},
+		{name: "invalid propagator", content: "tracing:\n  propagators: [tracecontext, unknown]\n", err: "invalid propagator option: unknown"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			require.NoError(t, os.WriteFile(path, []byte(test.content), 0600))
+			result, err := Load(path)
+			if test.err != "" {
+				require.EqualError(t, err, test.err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, test.ratio, result.Config.Tracing.SamplingRatio)
+			require.Equal(t, test.props, result.Config.Tracing.Propagators)
+		})
+	}
+}
