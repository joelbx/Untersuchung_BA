+func TestAmazonLinuxEOLDates(t *testing.T) {
+	for _, tt := range []struct {
+		release string
+		year    int
+	}{
+		{"2023", 2028},
+		{"2023.4.20240416", 2028},
+		{"2025", 2030},
+		{"2027", 2032},
+		{"2029", 2034},
+	} {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release+" (Amazon Linux)")
+			if !found {
+				t.Fatal("release not found")
+			}
+			want := time.Date(tt.year, 6, 30, 23, 59, 59, 0, time.UTC)
+			if !eol.StandardSupportUntil.Equal(want) {
+				t.Errorf("StandardSupportUntil = %s, want %s", eol.StandardSupportUntil, want)
+			}
+			if eol.IsStandardSupportEnded(want) || eol.IsExtendedSuppportEnded(want) {
+				t.Error("support ended before EOL date")
+			}
+			if !eol.IsStandardSupportEnded(want.Add(time.Second)) || !eol.IsExtendedSuppportEnded(want.Add(time.Second)) {
+				t.Error("support did not end after EOL date")
+			}
+		})
+	}
+	if _, found := GetEOL(Amazon, "2024 (Amazon Linux)"); found {
+		t.Error("unknown release found")
+	}
+}
