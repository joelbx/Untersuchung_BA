+func parseAmazonSystemRelease(stdout string) string {
+	fields := strings.Fields(stdout)
+	if len(fields) >= 3 && fields[0] == "Amazon" && fields[1] == "Linux" {
+		if len(fields) == 5 && fields[2] == "AMI" && fields[3] == "release" {
+			return fields[4]
+		}
+		versionIndex := 2
+		if fields[2] == "release" {
+			versionIndex = 3
+		}
+		if len(fields) > versionIndex {
+			switch fields[versionIndex] {
+			case "2", "2022", "2023", "2025", "2027", "2029":
+				return strings.Join(fields[versionIndex:], " ")
+			}
+			if strings.Count(fields[versionIndex], ".") == 2 {
+				for _, year := range []string{"2023", "2025", "2027", "2029"} {
+					if strings.HasPrefix(fields[versionIndex], year+".") {
+						return strings.Join(fields[versionIndex:], " ")
+					}
+				}
+			}
+		}
+	} else if len(fields) == 5 {
+		return fields[4]
+	}
+	return "unknown"
+}
