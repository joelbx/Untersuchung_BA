+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_uses_current_interpreter(mocker):
+    module = mocker.Mock()
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+
+    assert pip._get_pip(module) == [pip.sys.executable, '-m', 'pip']
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_respects_executable(mocker):
+    module = mocker.Mock()
+    module.get_bin_path.return_value = '/usr/bin/custom-pip'
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+
+    assert pip._get_pip(module, executable='custom-pip') == ['/usr/bin/custom-pip']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_packages_falls_back_to_freeze(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(1, '', 'unsupported'), (0, 'six==1.0\n', '')]
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    command, out, err = pip._get_packages(module, ['/path with spaces/python', '-m', 'pip'], '/tmp')
+
+    assert module.run_command.call_args_list[0].args[0] == ['/path with spaces/python', '-m', 'pip', 'list', '--format=freeze']
+    assert module.run_command.call_args_list[1].args[0] == ['/path with spaces/python', '-m', 'pip', 'freeze']
+    assert command == "'/path with spaces/python' -m pip freeze"
+    assert (out, err) == ('six==1.0\n', '')
+
+
