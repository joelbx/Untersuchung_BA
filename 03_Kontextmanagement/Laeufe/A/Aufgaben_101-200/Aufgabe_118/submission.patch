+def _have_pip_module():
+    """Return whether the current Python interpreter can import pip."""
+    try:
+        try:
+            from importlib.util import find_spec
+        except ImportError:
+            from imp import find_module
+            handle, _, _ = find_module('pip')
+            if handle is not None:
+                handle.close()
+            return True
+        return find_spec('pip') is not None
+    except Exception:
+        return False
+
