@@ -0,0 +1,28 @@
+import json
+
+from openlibrary.plugins.importapi import code
+
+
+def test_parse_data_supplements_incomplete_promise_record(monkeypatch):
+    staged = {
+        'title': 'Staged title', 'authors': [{'name': 'Author'}],
+        'publish_date': '2020', 'publishers': ['Publisher'],
+        'number_of_pages': 120,
+    }
+    monkeypatch.setattr(
+        code.ImportItem, 'find_staged_or_pending',
+        lambda identifiers: [{'data': json.dumps(staged)}],
+    )
+    monkeypatch.setattr(code, 'parse_meta_headers', lambda builder: None)
+    rec = {
+        'title': 'Original title', 'source_records': ['promise:1'],
+        'isbn_10': ['123456789X'], 'authors': [], 'publish_date': '',
+        'publishers': ['????'],
+    }
+    parsed, format_ = code.parse_data(json.dumps(rec).encode())
+    assert format_ == 'json'
+    assert parsed['title'] == 'Original title'
+    assert parsed['authors'] == staged['authors']
+    assert parsed['publish_date'] == '2020'
+    assert parsed['publishers'] == ['Publisher']
+    assert parsed['number_of_pages'] == 120
