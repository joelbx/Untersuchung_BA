+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tt := range []struct {
+		name         string
+		option       []containers.Option[StoreOptions]
+		artifactType string
+		configType   string
+	}{
+		{
+			name:         "default 1.1",
+			configType:   v1.MediaTypeEmptyJSON,
+			artifactType: MediaTypeFliptFeatures,
+		},
+		{
+			name:         "configured 1.1",
+			option:       []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_1)},
+			configType:   v1.MediaTypeEmptyJSON,
+			artifactType: MediaTypeFliptFeatures,
+		},
+		{
+			name:       "configured 1.0",
+			option:     []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)},
+			configType: MediaTypeFliptFeatures,
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			dir := testRepository(t)
+			ref, err := ParseReference(repo + ":latest")
+			require.NoError(t, err)
+			store, err := NewStore(zaptest.NewLogger(t), dir, tt.option...)
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			_, err = store.Build(ctx, src, ref)
+			require.NoError(t, err)
+
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			data, err := content.FetchAll(ctx, target, desc)
+			require.NoError(t, err)
+			var manifest v1.Manifest
+			require.NoError(t, json.Unmarshal(data, &manifest))
+			assert.Equal(t, tt.artifactType, manifest.ArtifactType)
+			assert.Equal(t, tt.configType, manifest.Config.MediaType)
+			resp, err := store.Fetch(ctx, ref)
+			require.NoError(t, err)
+			assert.Len(t, resp.Files, 2)
+			for _, file := range resp.Files {
+				require.NoError(t, file.Close())
+			}
+		})
+	}
+}
