+// readTeleportProxyHeader extracts the client address without hiding the
+// header from the SSH server, which also uses its tracing metadata.
+func readTeleportProxyHeader(reader *bufio.Reader) (net.Addr, *bufio.Reader, error) {
+	const maxHeaderBytes = 64 * 1024
+	header := make([]byte, 0, maxHeaderBytes)
+	for len(header) < maxHeaderBytes {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err)
+		}
+		header = append(header, b)
+		if b == 0 {
+			var payload apisshutils.HandshakePayload
+			if err := json.Unmarshal(header[len(teleportProxyPrefix):len(header)-1], &payload); err != nil {
+				return nil, nil, trace.Wrap(err)
+			}
+			var clientAddr net.Addr
+			if payload.ClientAddr != "" {
+				addr, err := utils.ParseAddr(payload.ClientAddr)
+				if err != nil {
+					return nil, nil, trace.Wrap(err)
+				}
+				clientAddr = addr
+				if addr.AddrNetwork == "tcp" {
+					if ip := net.ParseIP(addr.Host()); ip != nil {
+						clientAddr = &net.TCPAddr{IP: ip, Port: addr.Port(0)}
+					}
+				}
+			}
+			return clientAddr, bufio.NewReader(io.MultiReader(bytes.NewReader(header), reader)), nil
+		}
+	}
+	return nil, nil, trace.BadParameter("Teleport-Proxy header exceeds %d bytes", maxHeaderBytes)
+}
