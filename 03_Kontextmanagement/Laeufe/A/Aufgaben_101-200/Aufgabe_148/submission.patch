 )
 
+func TestDetectTeleportProxySSH(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		message    string
+		clientAddr string
+	}{
+		{name: "standard SSH", message: "SSH-2.0-test\r\n"},
+		{name: "proxy with client address", message: "Teleport-Proxy{\"ClientAddr\":\"192.0.2.10:1234\"}\x00SSH-2.0-test\r\n", clientAddr: "192.0.2.10:1234"},
+		{name: "proxy without client address", message: "Teleport-Proxy{}\x00SSH-2.0-test\r\n"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			client, server := net.Pipe()
+			defer server.Close()
+			go func() {
+				defer client.Close()
+				_, _ = io.Copy(client, bytes.NewBufferString(test.message))
+			}()
+
+			conn, err := detect(server, false)
+			require.NoError(t, err)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			if test.clientAddr == "" {
+				require.Equal(t, server.RemoteAddr(), conn.RemoteAddr())
+			} else {
+				require.Equal(t, test.clientAddr, conn.RemoteAddr().String())
+				_, ok := conn.RemoteAddr().(*net.TCPAddr)
+				require.True(t, ok)
+			}
+			got, err := io.ReadAll(conn)
+			require.NoError(t, err)
+			require.Equal(t, test.message, string(got))
+		})
+	}
+}
+
+func TestMuxTeleportProxySSH(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener})
+	require.NoError(t, err)
+	sshListener := mux.SSH()
+	go mux.Serve()
+	defer mux.Close()
+
+	client, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer client.Close()
+	message := "Teleport-Proxy{\"clientAddr\":\"192.0.2.20:2222\"}\x00SSH-2.0-test\r\n"
+	_, err = io.WriteString(client, message)
+	require.NoError(t, err)
+
+	server, err := sshListener.Accept()
+	require.NoError(t, err)
+	defer server.Close()
+	require.Equal(t, "192.0.2.20:2222", server.RemoteAddr().String())
+	got := make([]byte, len(message))
+	_, err = io.ReadFull(server, got)
+	require.NoError(t, err)
+	require.Equal(t, message, string(got))
+}
+
 func TestMain(m *testing.M) {
 	utils.InitLoggerForTests()
 	os.Exit(m.Run())
