+@pytest.mark.posix
+@pytest.mark.parametrize('verbose', [False, True])
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, verbose):
+    proc.verbose = verbose
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        proc.start(*py_proc("""
+            import os, signal
+            os.kill(os.getpid(), signal.SIGTERM)
+        """))
+
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.code == signal.SIGTERM
+    assert proc.outcome.was_sigterm()
+    assert not proc.outcome.was_successful()
+    assert proc.outcome.state_str() == 'terminated'
+    assert str(proc.outcome) == 'Testprocess terminated with SIGTERM.'
+    finish_messages = [msg for msg in message_mock.messages
+                       if 'terminated with SIGTERM' in msg.text]
+    if verbose:
+        assert len(finish_messages) == 1
+        assert finish_messages[0].level == usertypes.MessageLevel.info
+        assert finish_messages[0].text == (
+            'Testprocess terminated with SIGTERM. '
+            f'See :process {proc.pid} for details.')
+    else:
+        assert not message_mock.messages
 
 
