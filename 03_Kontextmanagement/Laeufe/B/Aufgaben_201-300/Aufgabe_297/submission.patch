+// validateIPAgainstList checks the connection address against configured proxy
+// networks. Invalid entries are skipped so they cannot disable valid entries.
+func validateIPAgainstList(remoteAddr, list string) bool {
+	if strings.TrimSpace(list) == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(list, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteAddr = host
+	}
+	addr, err := netip.ParseAddr(remoteAddr)
+	if err != nil {
+		return false
+	}
+	addr = addr.Unmap()
+	for _, entry := range strings.Split(list, ",") {
+		entry = strings.TrimSpace(entry)
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		if prefix, err := netip.ParsePrefix(entry); err == nil && prefix.Contains(addr) {
+			return true
+		}
+		if ip, err := netip.ParseAddr(entry); err == nil && ip.Unmap() == addr {
+			return true
+		}
+	}
+	return false
+}
+
+// handleLoginFromHeaders authenticates only requests arriving from a trusted
+// proxy. An unknown header user is created on first use.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	remoteAddr, ok := request.RemoteAddrFrom(r.Context())
+	if !ok {
+		remoteAddr = r.RemoteAddr
+	}
+	if !validateIPAgainstList(remoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" {
+		return nil
+	}
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for proxy login", countErr)
+			return nil
+		}
+		user = &model.User{
+			ID: uuid.NewString(), UserName: username, Name: strings.Title(username),
+			IsAdmin: count == 0, NewPassword: uuid.NewString(),
+		}
+		if err = userRepo.Put(user); err != nil {
+			log.Error(r, "Could not create proxy user", err)
+			return nil
+		}
+		user, err = userRepo.FindByUsername(username)
+		if err != nil || user == nil {
+			log.Error(r, "Could not reload proxy user", err)
+			return nil
+		}
+	} else if err != nil || user == nil {
+		if err != nil {
+			log.Error(r, "Could not find proxy user", err)
+		}
+		return nil
+	}
+	if err = userRepo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update proxy user's LastLoginAt", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create proxy login token", err)
+		return nil
+	}
+	saltBytes := make([]byte, 8)
+	if _, err = rand.Read(saltBytes); err != nil {
+		log.Error(r, "Could not create Subsonic salt", err)
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	result := map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token, "subsonicSalt": salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		result["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return result
+}
