+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	for _, tc := range []struct {
+		name, addr, list string
+		want             bool
+	}{
+		{"disabled", "127.0.0.1:1234", "", false},
+		{"IPv4 and invalid entry", "192.168.1.2:1234", "bad, 192.168.0.0/16", true},
+		{"IPv6", "[2001:db8::2]:1234", "192.168.0.0/16, 2001:db8::/32", true},
+		{"IPv6 bare", "2001:db8::2", "2001:db8::/32", true},
+		{"entry with port", "[::1]:1234", "[::1]:8080", true},
+		{"outside range", "192.169.1.2:1234", "192.168.0.0/16", false},
+		{"unix socket", "@", "127.0.0.1/8, @", true},
+		{"unix socket untrusted", "@", "127.0.0.1/8", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := validateIPAgainstList(tc.addr, tc.list); got != tc.want {
+				t.Fatalf("validateIPAgainstList(%q, %q) = %v, want %v", tc.addr, tc.list, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestProxyLoginAndIndexPayload(t *testing.T) {
+	old := *conf.Server
+	t.Cleanup(func() { *conf.Server = old })
+	conf.Server.ReverseProxyWhitelist = "127.0.0.0/8"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	conf.Server.ReverseProxyDefaultUser = ""
+	ds := &tests.MockDataStore{}
+
+	r := httptest.NewRequest("GET", "/index.html", nil)
+	r.RemoteAddr = "127.0.0.1:1234"
+	r.Header.Set("Remote-User", "alice")
+	a := handleLoginFromHeaders(ds, r)
+	if a == nil || a["username"] != "alice" || a["isAdmin"] != true {
+		t.Fatalf("expected first proxy user to become admin: %v", a)
+	}
+	for _, key := range []string{"id", "name", "token", "subsonicSalt", "subsonicToken"} {
+		if a[key] == "" || a[key] == nil {
+			t.Fatalf("missing %s in proxy auth", key)
+		}
+	}
+	claims, err := auth.Validate(a["token"].(string))
+	if err != nil || claims["sub"] != "alice" {
+		t.Fatalf("invalid proxy token: %v, %v", claims, err)
+	}
+	u, err := ds.User(context.Background()).FindByUsername("alice")
+	if err != nil || u.LastLoginAt == nil {
+		t.Fatalf("proxy user login time not updated: %v, %v", u, err)
+	}
+	wantSubsonic := fmt.Sprintf("%x", md5.Sum([]byte(u.Password+a["subsonicSalt"].(string))))
+	if a["subsonicToken"] != wantSubsonic {
+		t.Fatal("invalid Subsonic token")
+	}
+
+	r.Header.Set("Remote-User", "bob")
+	if b := handleLoginFromHeaders(ds, r); b == nil || b["isAdmin"] != false {
+		t.Fatalf("expected second proxy user to be regular: %v", b)
+	}
+
+	w := httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+	if got := extractAppConfig(w.Body.String()); got["auth"] == nil || got["firstTime"] != false {
+		t.Fatalf("expected auth in frontend config: %v", got)
+	}
+
+	// A spoofed forwarding header cannot override the connection's peer.
+	untrusted := httptest.NewRequest("GET", "/index.html", nil)
+	untrusted.RemoteAddr = "127.0.0.1:1234"
+	untrusted.Header.Set("Remote-User", "alice")
+	untrusted.Header.Set("X-Forwarded-For", "127.0.0.1")
+	untrusted = untrusted.WithContext(request.WithRemoteAddr(untrusted.Context(), "203.0.113.9:1234"))
+	if got := handleLoginFromHeaders(ds, untrusted); got != nil {
+		t.Fatalf("untrusted peer received auth: %v", got)
+	}
+	w = httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(w, untrusted)
+	if got := extractAppConfig(w.Body.String()); got["auth"] != nil {
+		t.Fatalf("untrusted peer received frontend auth: %v", got["auth"])
+	}
+}
