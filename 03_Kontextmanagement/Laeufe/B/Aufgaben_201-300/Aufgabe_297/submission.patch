+jest.mock('jwt-decode', () => jest.fn(() => ({})))
+jest.mock('./config', () => ({
+  __esModule: true,
+  default: {
+    auth: {
+      id: 'user-1',
+      isAdmin: true,
+      name: 'Alice',
+      username: 'alice',
+      token: 'signed-token',
+      subsonicSalt: 'random-salt',
+      subsonicToken: 'subsonic-token',
+    },
+    firstTime: true,
+  },
+}))
+
+test('stores every field needed for a reverse proxy session', async () => {
+  expect(await authProvider.checkAuth()).toBeUndefined()
+  expect(localStorage.getItem('token')).toBe('signed-token')
+  expect(localStorage.getItem('userId')).toBe('user-1')
+  expect(localStorage.getItem('name')).toBe('Alice')
+  expect(localStorage.getItem('username')).toBe('alice')
+  expect(localStorage.getItem('role')).toBe('admin')
+  expect(localStorage.getItem('subsonic-salt')).toBe('random-salt')
+  expect(localStorage.getItem('subsonic-token')).toBe('subsonic-token')
+})
