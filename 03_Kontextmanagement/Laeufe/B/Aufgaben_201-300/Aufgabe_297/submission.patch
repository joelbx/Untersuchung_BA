+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		// Keep the original key type and keys while allowing redacted values
+		// to become strings even when the source map had another value type.
+		out := reflect.MakeMapWithSize(reflect.MapOf(v.Type().Key(), reflect.TypeOf((*interface{})(nil)).Elem()), v.Len())
+		for _, key := range v.MapKeys() {
+			var redacted interface{}
+			if re.MatchString(fmt.Sprint(key.Interface())) || sensitiveField.MatchString(fmt.Sprint(key.Interface())) {
+				redacted = "[REDACTED]"
+			} else {
+				redacted = redactValue(v.MapIndex(key).Interface(), re)
+			}
+			out.SetMapIndex(key, reflect.ValueOf(&redacted).Elem())
+		}
+		return out.Interface()
+	}
+	if s, ok := value.(string); ok {
+		return re.ReplaceAllString(s, "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
