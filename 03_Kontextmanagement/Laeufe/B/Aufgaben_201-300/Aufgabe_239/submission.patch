diff --git a/core/agents/lastfm/link_state.go b/core/agents/lastfm/link_state.go
new file mode 100644
index 0000000..bc08690
--- /dev/null
+++ b/core/agents/lastfm/link_state.go
@@ -0,0 +1,63 @@
+package lastfm
+
+import (
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+)
+
+type linkState struct {
+	UserID  string `json:"userId"`
+	Expires int64  `json:"expires"`
+	Nonce   string `json:"nonce"`
+}
+
+var errInvalidLinkState = errors.New("invalid Last.fm link state")
+
+func (s *Router) newLinkState(userId string) (string, error) {
+	if s.secret == "" || userId == "" {
+		return "", errInvalidLinkState
+	}
+	nonce := make([]byte, 16)
+	if _, err := rand.Read(nonce); err != nil {
+		return "", err
+	}
+	payload, err := json.Marshal(linkState{userId, time.Now().Add(10 * time.Minute).Unix(), base64.RawURLEncoding.EncodeToString(nonce)})
+	if err != nil {
+		return "", err
+	}
+	encoded := base64.RawURLEncoding.EncodeToString(payload)
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(encoded))
+	return encoded + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil)), nil
+}
+
+func (s *Router) userIdFromLinkState(state string) (string, error) {
+	parts := strings.Split(state, ".")
+	if s.secret == "" || len(parts) != 2 {
+		return "", errInvalidLinkState
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", errInvalidLinkState
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(parts[0]))
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", errInvalidLinkState
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", errInvalidLinkState
+	}
+	var decoded linkState
+	if err := json.Unmarshal(payload, &decoded); err != nil || decoded.UserID == "" || decoded.Nonce == "" || decoded.Expires <= time.Now().Unix() {
+		return "", errInvalidLinkState
+	}
+	return decoded.UserID, nil
+}
diff --git a/core/agents/lastfm/link_state_test.go b/core/agents/lastfm/link_state_test.go
new file mode 100644
index 0000000..aac906f
--- /dev/null
+++ b/core/agents/lastfm/link_state_test.go
@@ -0,0 +1,101 @@
+package lastfm
+
+import (
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkStateIsSignedForAuthenticatedUser(t *testing.T) {
+	router := &Router{secret: "test-secret"}
+	state, err := router.newLinkState("user-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	userId, err := router.userIdFromLinkState(state)
+	if err != nil || userId != "user-a" {
+		t.Fatalf("valid state: got %q, %v", userId, err)
+	}
+	if _, err := router.userIdFromLinkState(state + "x"); err == nil {
+		t.Fatal("modified state was accepted")
+	}
+	if _, err := router.userIdFromLinkState(""); err == nil {
+		t.Fatal("missing state was accepted")
+	}
+}
+
+func TestLinkStatusAndUnlinkAreScopedToAuthenticatedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	repo := ds.UserProps(nil)
+	if err := repo.Put("user-a", sessionKeyProperty, "SK-A"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("user-b", sessionKeyProperty, "SK-B"); err != nil {
+		t.Fatal(err)
+	}
+	router := &Router{sessionKeys: &sessionKeys{ds: ds}}
+	req := httptest.NewRequest(http.MethodDelete, "/link", nil)
+	req = req.WithContext(request.WithUser(req.Context(), model.User{ID: "user-a"}))
+	resp := httptest.NewRecorder()
+	router.unlink(resp, req)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("unlink status: %d", resp.Code)
+	}
+	if _, err := repo.Get("user-a", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("user A key after unlink: %v", err)
+	}
+	if key, err := repo.Get("user-b", sessionKeyProperty); err != nil || key != "SK-B" {
+		t.Fatalf("user B key after unlink: %q, %v", key, err)
+	}
+	statusReq := httptest.NewRequest(http.MethodGet, "/link", nil)
+	statusReq = statusReq.WithContext(request.WithUser(statusReq.Context(), model.User{ID: "user-b"}))
+	statusResp := httptest.NewRecorder()
+	router.getLinkStatus(statusResp, statusReq)
+	var status struct{ Status bool }
+	if err := json.Unmarshal(statusResp.Body.Bytes(), &status); err != nil {
+		t.Fatal(err)
+	}
+	if statusResp.Code != http.StatusOK || !status.Status {
+		t.Fatalf("user B link status: %d %s", statusResp.Code, statusResp.Body.String())
+	}
+}
+
+func TestCallbackStoresSessionForSignedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	httpClient := &tests.FakeHttpClient{Res: http.Response{
+		Body:       ioutil.NopCloser(strings.NewReader(`{"session":{"key":"SK-A"}}`)),
+		StatusCode: http.StatusOK,
+	}}
+	router := &Router{secret: "test-secret", sessionKeys: &sessionKeys{ds: ds}}
+	router.client = NewClient("API_KEY", router.secret, "en", httpClient)
+	state, err := router.newLinkState("user-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodGet, "/link/callback?token=token&state="+state, nil)
+	resp := httptest.NewRecorder()
+	router.callback(resp, req)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("callback status: %d", resp.Code)
+	}
+	key, err := ds.UserProps(req.Context()).Get("user-a", sessionKeyProperty)
+	if err != nil || key != "SK-A" {
+		t.Fatalf("user A key: %q, %v", key, err)
+	}
+	if _, err := ds.UserProps(req.Context()).Get("user-b", sessionKeyProperty); err == nil {
+		t.Fatal("user B received user A's session key")
+	}
+
+	bad := httptest.NewRecorder()
+	router.callback(bad, httptest.NewRequest(http.MethodGet, "/link/callback?token=token&uid=user-b", nil))
+	if bad.Code != http.StatusBadRequest {
+		t.Fatalf("unsigned callback status: %d", bad.Code)
+	}
+}
