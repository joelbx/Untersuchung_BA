+describe('post upload cleanup', () => {
+	const filesDir = path.join(nconf.get('upload_path'), 'files');
+
+	it('deletes a single path or a list, while ignoring invalid paths', async () => {
+		const names = ['cleanup-one.txt', 'cleanup-two.txt'];
+		await Promise.all(names.map(name => fs.promises.writeFile(path.join(filesDir, name), 'test')));
+		const outside = path.join(nconf.get('upload_path'), 'cleanup-outside.txt');
+		const link = path.join(filesDir, 'cleanup-link');
+		await fs.promises.writeFile(outside, 'test');
+		await fs.promises.symlink(nconf.get('upload_path'), link, 'dir');
+		try {
+			await posts.uploads.deleteFromDisk(names[0]);
+			await posts.uploads.deleteFromDisk([names[1], '../cleanup-outside.txt', 'cleanup-link/cleanup-outside.txt', null, 5, '/tmp/cleanup-outside.txt']);
+			assert.strictEqual(fs.existsSync(path.join(filesDir, names[0])), false);
+			assert.strictEqual(fs.existsSync(path.join(filesDir, names[1])), false);
+			assert.strictEqual(fs.existsSync(outside), true);
+			await assert.rejects(posts.uploads.deleteFromDisk(5), TypeError);
+		} finally {
+			await fs.promises.unlink(link);
+			await fs.promises.unlink(outside);
+		}
+	});
+
+	it('deletes only uploads no longer referenced by another post', async () => {
+		const [shared, exclusive] = ['cleanup-shared.txt', 'cleanup-exclusive.txt'];
+		await Promise.all([shared, exclusive].map(name => fs.promises.writeFile(path.join(filesDir, name), 'test')));
+		const uid = await user.create({ username: 'cleanup user', password: 'test-password' });
+		const { cid } = await categories.create({ name: 'Cleanup Category' });
+		const first = await topics.post({ uid, cid, title: 'first cleanup topic', content: 'first cleanup content' });
+		const second = await topics.post({ uid, cid, title: 'second cleanup topic', content: 'second cleanup content' });
+		const firstPid = first.postData.pid;
+		const secondPid = second.postData.pid;
+		await posts.uploads.associate(firstPid, [shared, exclusive]);
+		await posts.uploads.associate(secondPid, shared);
+		const original = meta.config.preserveOrphanedUploads;
+		meta.config.preserveOrphanedUploads = 0;
+		try {
+			await posts.purge(firstPid, uid);
+			assert.strictEqual(fs.existsSync(path.join(filesDir, exclusive)), false);
+			assert.strictEqual(fs.existsSync(path.join(filesDir, shared)), true);
+			await posts.purge(secondPid, uid);
+			assert.strictEqual(fs.existsSync(path.join(filesDir, shared)), false);
+		} finally {
+			meta.config.preserveOrphanedUploads = original;
+		}
+	});
+
+	it('preserves orphaned uploads when configured', async () => {
+		const name = 'cleanup-preserved.txt';
+		const fullPath = path.join(filesDir, name);
+		await fs.promises.writeFile(fullPath, 'test');
+		const uid = await user.create({ username: 'preserve user', password: 'test-password' });
+		const { cid } = await categories.create({ name: 'Preserve Category' });
+		const topic = await topics.post({ uid, cid, title: 'preserved upload topic', content: 'preserved upload content' });
+		await posts.uploads.associate(topic.postData.pid, name);
+		const original = meta.config.preserveOrphanedUploads;
+		meta.config.preserveOrphanedUploads = 1;
+		try {
+			await posts.purge(topic.postData.pid, uid);
+			assert.strictEqual(fs.existsSync(fullPath), true);
+		} finally {
+			meta.config.preserveOrphanedUploads = original;
+			await posts.uploads.deleteFromDisk(name);
+		}
+	});
+
+	it('deletes an orphaned upload when its topic is purged', async () => {
+		const name = 'cleanup-topic.txt';
+		const fullPath = path.join(filesDir, name);
+		await fs.promises.writeFile(fullPath, 'test');
+		const uid = await user.create({ username: 'topic cleanup user', password: 'test-password' });
+		const { cid } = await categories.create({ name: 'Topic Cleanup Category' });
+		const topic = await topics.post({
+			uid,
+			cid,
+			title: 'topic with upload to purge',
+			content: `[file](/assets/uploads/files/${name})`,
+		});
+		const original = meta.config.preserveOrphanedUploads;
+		meta.config.preserveOrphanedUploads = 0;
+		try {
+			await topics.purgePostsAndTopic(topic.topicData.tid, uid);
+			assert.strictEqual(fs.existsSync(fullPath), false);
+		} finally {
+			meta.config.preserveOrphanedUploads = original;
+		}
+	});
+});
