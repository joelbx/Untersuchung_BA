@@ -0,0 +1,70 @@
+package models
+
+import (
+	"sort"
+	"strings"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+)
+
+// NewTrivyCveContents preserves the severity and CVSS reported by each Trivy source.
+func NewTrivyCveContents(cveID string, vul trivydbTypes.Vulnerability, severitySource string) CveContents {
+	sources := map[string]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[string(source)] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[string(source)] = struct{}{}
+	}
+	if severitySource != "" {
+		sources[severitySource] = struct{}{}
+	}
+	if len(sources) == 0 {
+		sources[""] = struct{}{}
+	}
+
+	refs := make(References, 0, len(vul.References))
+	for _, url := range vul.References {
+		refs = append(refs, Reference{Source: "trivy", Link: url})
+	}
+	sort.Slice(refs, func(i, j int) bool { return refs[i].Link < refs[j].Link })
+
+	var published, lastModified time.Time
+	if vul.PublishedDate != nil {
+		published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		lastModified = *vul.LastModifiedDate
+	}
+
+	contents := CveContents{}
+	for source := range sources {
+		ctype := Trivy
+		if source != "" {
+			ctype = CveContentType("trivy:" + strings.ToLower(source))
+		}
+		cvss := vul.CVSS[trivydbTypes.SourceID(source)]
+		severity := ""
+		if vendorSeverity, ok := vul.VendorSeverity[trivydbTypes.SourceID(source)]; ok {
+			severity = vendorSeverity.String()
+		} else if source == severitySource || source == "" || len(sources) == 1 {
+			severity = vul.Severity
+		}
+		contents[ctype] = []CveContent{{
+			Type:          ctype,
+			CveID:         cveID,
+			Title:         vul.Title,
+			Summary:       vul.Description,
+			Cvss2Score:    cvss.V2Score,
+			Cvss2Vector:   cvss.V2Vector,
+			Cvss3Score:    cvss.V3Score,
+			Cvss3Vector:   cvss.V3Vector,
+			Cvss3Severity: severity,
+			References:    refs,
+			Published:     published,
+			LastModified:  lastModified,
+		}}
+	}
+	return contents
+}
