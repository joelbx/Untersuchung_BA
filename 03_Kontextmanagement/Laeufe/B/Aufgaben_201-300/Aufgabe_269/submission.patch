+package models
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+)
+
+func TestTrivyCveContentsPreserveSources(t *testing.T) {
+	low, err := trivydbTypes.NewSeverity("LOW")
+	if err != nil {
+		t.Fatal(err)
+	}
+	medium, err := trivydbTypes.NewSeverity("MEDIUM")
+	if err != nil {
+		t.Fatal(err)
+	}
+	published := time.Date(2020, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	vul := trivydbTypes.Vulnerability{
+		Title: "title", Description: "summary",
+		VendorSeverity: trivydbTypes.VendorSeverity{
+			"debian": low, "ubuntu": medium,
+		},
+		CVSS: trivydbTypes.VendorCVSS{
+			"nvd": {V2Score: 4.3, V2Vector: "AV:N", V3Score: 7.5, V3Vector: "CVSS:3.1/AV:N"},
+		},
+		References:    []string{"https://example.com/advisory"},
+		PublishedDate: &published, LastModifiedDate: &modified,
+	}
+	contents := NewTrivyCveContents("CVE-2020-0001", vul, "")
+	if len(contents) != 3 {
+		t.Fatalf("got %d sources, want 3", len(contents))
+	}
+	if contents[TrivyDebian][0].Cvss3Severity != "LOW" || contents[TrivyUbuntu][0].Cvss3Severity != "MEDIUM" {
+		t.Fatalf("vendor severities were lost: %#v", contents)
+	}
+	nvd := contents[TrivyNVD][0]
+	if nvd.Type != TrivyNVD || nvd.CveID != "CVE-2020-0001" || nvd.Title != "title" || nvd.Summary != "summary" ||
+		nvd.Cvss2Score != 4.3 || nvd.Cvss2Vector != "AV:N" || nvd.Cvss3Score != 7.5 || nvd.Cvss3Vector != "CVSS:3.1/AV:N" ||
+		!nvd.Published.Equal(published) || !nvd.LastModified.Equal(modified) || len(nvd.References) != 1 {
+		t.Fatalf("source metadata was lost: %#v", nvd)
+	}
+	vinfo := VulnInfo{CveContents: contents}
+	if len(vinfo.Titles("en", "debian")) == 0 || len(vinfo.Summaries("en", "debian")) == 0 ||
+		len(vinfo.Cvss2Scores()) != 1 || len(vinfo.Cvss3Scores()) != 3 {
+		t.Fatalf("Trivy contents were not aggregated: %#v", vinfo)
+	}
+}
