+def test_validate_record_override(record_changes, error) -> None:
+    record = {'title': 'A Book', 'source_records': ['other:123']}
+    record.update(record_changes)
+
+    with pytest.raises(error):
+        validate_record(record)
+    with pytest.raises(error):
