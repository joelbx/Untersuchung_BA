@@ -6,10 +6,82 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	tests := []struct {
+		name         string
+		body         string
+		summary      string
+		fixedIn      string
+		optional     map[string]string
+		cvssScore    float64
+		cvssVector   string
+		cvssSeverity string
+	}{
+		{
+			name:         "enterprise",
+			body:         `{"604":{"vulnerabilities":[{"id":"42","title":"Issue","description":"Detailed summary","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"XSS","references":{"cve":["2024-1111","2024-2222"],"url":["https://example.com/first","https://example.com/second"]},"fixed_in":"6.0.5","poc":"https://example.com/poc","introduced_in":"6.0.0","cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N/AC:L","severity":"high"}}]}}`,
+			summary:      "Detailed summary",
+			fixedIn:      "6.0.5",
+			optional:     map[string]string{"poc": "https://example.com/poc", "introduced_in": "6.0.0"},
+			cvssScore:    7.5,
+			cvssVector:   "CVSS:3.1/AV:N/AC:L",
+			cvssSeverity: "high",
+		},
+		{
+			name:     "basic",
+			body:     `{"604":{"vulnerabilities":[{"id":"42","title":"Issue","description":null,"created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"XSS","references":{"cve":["2024-1111","2024-2222"],"url":["https://example.com/first","https://example.com/second"]},"fixed_in":null,"poc":null,"introduced_in":null,"cvss":null}]}}`,
+			optional: map[string]string{},
+		},
+		{
+			name:     "omitted enterprise fields",
+			body:     `{"604":{"vulnerabilities":[{"id":"42","title":"Issue","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"XSS","references":{"cve":["2024-1111","2024-2222"],"url":["https://example.com/first","https://example.com/second"]}}]}}`,
+			optional: map[string]string{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			vinfos, err := convertToVinfos("core", tt.body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d records, want 1", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2024-1111" || v.VulnType != "XSS" {
+				t.Fatalf("unexpected vulnerability identity or type: %+v", v)
+			}
+			if len(v.WpPackageFixStats) != 1 || v.WpPackageFixStats[0].Name != "core" || v.WpPackageFixStats[0].FixedIn != tt.fixedIn {
+				t.Fatalf("unexpected fix status: %+v", v.WpPackageFixStats)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("got %d WPScan contents, want 1", len(contents))
+			}
+			c := contents[0]
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 9, 5, 6, 0, time.UTC)
+			if c.Type != models.WpScan || c.CveID != v.CveID || c.Summary != tt.summary || !c.Published.Equal(published) || !c.LastModified.Equal(modified) || c.Published.Location() != time.UTC || c.LastModified.Location() != time.UTC {
+				t.Fatalf("unexpected WPScan content: %+v", c)
+			}
+			if len(c.References) != 2 || c.References[0].Link != "https://example.com/first" || c.References[1].Link != "https://example.com/second" {
+				t.Fatalf("unexpected references: %+v", c.References)
+			}
+			if c.Optional == nil || !reflect.DeepEqual(c.Optional, tt.optional) {
+				t.Fatalf("unexpected optional metadata: %+v", c.Optional)
+			}
+			if c.Cvss3Score != tt.cvssScore || c.Cvss3Vector != tt.cvssVector || c.Cvss3Severity != tt.cvssSeverity {
+				t.Fatalf("unexpected CVSS metrics: %+v", c)
+			}
+		})
+	}
+}
