+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniquesAndValidation(t *testing.T) {
+	names := []string{"SS", "st", "Sa", "sW", "Sm", "SN", "sf", "SX", "unknown"}
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas, NotSupportTechnique}
+	c := PortScanConf{ScanTechniques: names}
+	got := c.GetScanTechniques()
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("technique %q: got %q, want %q", names[i], got[i], want[i])
+		}
+	}
+	if len((&PortScanConf{}).GetScanTechniques()) != 0 {
+		t.Fatal("empty techniques should yield empty slice")
+	}
+	c.ScanTechniques = []string{"invalid", "also-invalid"}
+	if got := c.GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Fatalf("unknown technique: %v", got)
+	}
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("zero config not zero")
+	}
+	if (PortScanConf{HasPrivileged: true}).IsZero() {
+		t.Fatal("privilege flag should make config nonzero")
+	}
+
+	bin := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(bin, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"connect", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}}, ""},
+		{"unsupported", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT", "sT"}}, "multiple"},
+		{"privilege", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sS"}}, "hasPrivileged"},
+		{"connect source", PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "incompatible"},
+		{"default connect source", PortScanConf{ScannerBinPath: bin, SourcePort: "443"}, "incompatible"},
+		{"port range", PortScanConf{ScannerBinPath: bin, SourcePort: "65536"}, "[0,65535]"},
+		{"port zero", PortScanConf{ScannerBinPath: bin, SourcePort: "0"}, "sourcePort 0"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			if tc.want == "" {
+				if len(errs) != 0 {
+					t.Fatalf("unexpected errors: %v", errs)
+				}
+				return
+			}
+			for _, err := range errs {
+				if strings.Contains(err.Error(), tc.want) {
+					return
+				}
+			}
+			t.Fatalf("expected %q in %v", tc.want, errs)
+		})
+	}
+}
