+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPortScanTOMLLoading(t *testing.T) {
+	previous := Conf
+	t.Cleanup(func() { Conf = previous })
+	Conf = Config{}
+	path := filepath.Join(t.TempDir(), "config.toml")
+	contents := `[servers.demo]
+host = "192.0.2.1"
+user = "tester"
+scanModules = ["ospkg", "port"]
+[servers.demo.portscan]
+scannerBinPath = "/usr/bin/nmap"
+hasPrivileged = true
+scanTechniques = ["sS"]
+sourcePort = "443"
+`
+	if err := os.WriteFile(path, []byte(contents), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	conf := Conf.Servers["demo"].PortScan
+	if conf == nil || !conf.IsUseExternalScanner || conf.ScannerBinPath != "/usr/bin/nmap" || conf.SourcePort != "443" || !conf.HasPrivileged || len(conf.ScanTechniques) != 1 || conf.ScanTechniques[0] != "sS" {
+		t.Fatalf("port scan configuration not loaded: %+v", conf)
+	}
+}
