+++ b/config/portscan.go
@@ -0,0 +1,125 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is a supported nmap TCP scan type.
+type ScanTechnique string
+
+const (
+	NotSupportTechnique ScanTechnique = ""
+	TCPSYN              ScanTechnique = "sS"
+	TCPConnect          ScanTechnique = "sT"
+	TCPACK              ScanTechnique = "sA"
+	TCPWindow           ScanTechnique = "sW"
+	TCPMaimon           ScanTechnique = "sM"
+	TCPNull             ScanTechnique = "sN"
+	TCPFIN              ScanTechnique = "sF"
+	TCPXmas             ScanTechnique = "sX"
+)
+
+func (t ScanTechnique) String() string { return string(t) }
+
+// PortScanConf configures an external scanner running on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	if c == nil {
+		return nil
+	}
+	unknownSeen := false
+	for _, raw := range c.ScanTechniques {
+		switch strings.ToLower(strings.TrimSpace(raw)) {
+		case "ss":
+			scanTechniques = append(scanTechniques, TCPSYN)
+		case "st":
+			scanTechniques = append(scanTechniques, TCPConnect)
+		case "sa":
+			scanTechniques = append(scanTechniques, TCPACK)
+		case "sw":
+			scanTechniques = append(scanTechniques, TCPWindow)
+		case "sm":
+			scanTechniques = append(scanTechniques, TCPMaimon)
+		case "sn":
+			scanTechniques = append(scanTechniques, TCPNull)
+		case "sf":
+			scanTechniques = append(scanTechniques, TCPFIN)
+		case "sx":
+			scanTechniques = append(scanTechniques, TCPXmas)
+		default:
+			if !unknownSeen {
+				scanTechniques = append(scanTechniques, NotSupportTechnique)
+				unknownSeen = true
+			}
+		}
+	}
+	return
+}
+
+// Validate reports every invalid external scan setting.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required for external port scanning"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q: %w", c.ScannerBinPath, err))
+	} else if !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q is not an executable file", c.ScannerBinPath))
+	}
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported"))
+	}
+	techniques := c.GetScanTechniques()
+	if len(techniques) == 0 && c.SourcePort != "" && !c.HasPrivileged {
+		errs = append(errs, fmt.Errorf("sourcePort is incompatible with TCPConnect"))
+	}
+	for _, raw := range c.ScanTechniques {
+		technique := (&PortScanConf{ScanTechniques: []string{raw}}).GetScanTechniques()[0]
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique %q", raw))
+		} else if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("scan technique %s requires hasPrivileged", technique))
+		} else if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("sourcePort is incompatible with TCPConnect"))
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort %q must be an integer in [0,65535]", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort 0 is not a usable source port"))
+		}
+	}
+	if c.HasPrivileged && c.ScannerBinPath != "" && os.Geteuid() != 0 {
+		output, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("cannot check scannerBinPath capabilities: %w: %s", err, strings.TrimSpace(string(output))))
+		} else {
+			fields := strings.Fields(string(output))
+			if len(fields) < 2 || !strings.Contains(string(output), "=") {
+				errs = append(errs, fmt.Errorf("missing or malformed scannerBinPath capability data"))
+			} else if !strings.Contains(string(output), "cap_net_raw") || !strings.Contains(string(output), "cap_net_admin") {
+				errs = append(errs, fmt.Errorf("scannerBinPath requires cap_net_raw and cap_net_admin capabilities"))
+			}
+		}
+	}
+	return
+}
