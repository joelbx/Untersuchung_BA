@@ -0,0 +1,33 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	bin := filepath.Join(t.TempDir(), "scanner")
+	script := "#!/bin/sh\nprintf 'Host: 192.0.2.1 ()\\tPorts: 22/open/tcp//ssh///, 80/closed/tcp//http///\\n'\n"
+	if err := os.WriteFile(bin, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	l := base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{ScannerBinPath: bin, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"22", "80"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.1:22"}) {
+		t.Fatalf("reachable ports: %v", got)
+	}
+	options, err := setScanTechniques([]config.ScanTechnique{config.TCPSYN, config.TCPXmas})
+	if err != nil || !reflect.DeepEqual(options, []string{"-sS", "-sX"}) {
+		t.Fatalf("options %v, %v", options, err)
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.NotSupportTechnique}); err == nil {
+		t.Fatal("unsupported technique accepted")
+	}
+}
