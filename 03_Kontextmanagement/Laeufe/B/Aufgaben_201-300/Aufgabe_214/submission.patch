diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..3e2670c
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,108 @@
+package scanner
+
+import (
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		if technique == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique")
+		}
+		switch technique {
+		case config.TCPSYN, config.TCPConnect, config.TCPACK, config.TCPWindow,
+			config.TCPMaimon, config.TCPNull, config.TCPFIN, config.TCPXmas:
+			options = append(options, "-"+technique.String())
+		default:
+			return nil, fmt.Errorf("unsupported scan technique %q", technique)
+		}
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil || conf.ScannerBinPath == "" {
+		return nil, fmt.Errorf("scannerBinPath is required for external port scanning")
+	}
+	if errs := conf.Validate(); len(errs) != 0 {
+		return nil, errs[0]
+	}
+	techniques := conf.GetScanTechniques()
+	if len(techniques) == 0 {
+		if conf.HasPrivileged {
+			techniques = []config.ScanTechnique{config.TCPSYN}
+		} else {
+			techniques = []config.ScanTechnique{config.TCPConnect}
+		}
+	}
+	techniqueOptions, err := setScanTechniques(techniques)
+	if err != nil {
+		return nil, err
+	}
+	ips := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	var reachable []string
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := scanDestIPPorts[ip]
+		if len(ports) == 0 {
+			continue
+		}
+		args := []string{"-n", "-Pn", "-oG", "-"}
+		if net.ParseIP(ip) != nil && strings.Contains(ip, ":") {
+			args = append(args, "-6")
+		}
+		args = append(args, techniqueOptions...)
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, "-p", strings.Join(ports, ","), ip)
+		output, err := osExec.Command(conf.ScannerBinPath, args...).CombinedOutput()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan %s failed: %w: %s", ip, err, strings.TrimSpace(string(output)))
+		}
+		reachable = append(reachable, parseNmapGrepableOpenPorts(ip, string(output))...)
+	}
+	return reachable, nil
+}
+
+func parseNmapGrepableOpenPorts(ip, output string) []string {
+	var reachable []string
+	for _, line := range strings.Split(output, "\n") {
+		if !strings.HasPrefix(line, "Host: "+ip+" ") {
+			continue
+		}
+		idx := strings.Index(line, "Ports: ")
+		if idx < 0 {
+			continue
+		}
+		portText := line[idx+len("Ports: "):]
+		if end := strings.IndexByte(portText, '\t'); end >= 0 {
+			portText = portText[:end]
+		}
+		for _, entry := range strings.Split(portText, ", ") {
+			parts := strings.Split(entry, "/")
+			if len(parts) >= 3 && parts[1] == "open" && parts[2] == "tcp" {
+				reachable = append(reachable, net.JoinHostPort(ip, parts[0]))
+			}
+		}
+	}
+	return reachable
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
