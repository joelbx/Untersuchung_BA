+type nvdCvss40Metric struct {
+	Source       string
+	BaseScore    float64
+	VectorString string
+	BaseSeverity string
+}
+
+// The pinned go-cve-dictionary version predates Nvd.Cvss40. Read the field
+// when it is available so this conversion also works with newer versions.
+func nvdCvss40Metrics(nvd any) []nvdCvss40Metric {
+	field := reflect.ValueOf(nvd).FieldByName("Cvss40")
+	if !field.IsValid() || field.Kind() != reflect.Slice {
+		return nil
+	}
+	metrics := make([]nvdCvss40Metric, 0, field.Len())
+	for i := 0; i < field.Len(); i++ {
+		metric := field.Index(i)
+		metrics = append(metrics, nvdCvss40Metric{
+			Source:       metric.FieldByName("Source").String(),
+			BaseScore:    metric.FieldByName("BaseScore").Float(),
+			VectorString: metric.FieldByName("VectorString").String(),
+			BaseSeverity: metric.FieldByName("BaseSeverity").String(),
+		})
+	}
+	return metrics
+}
