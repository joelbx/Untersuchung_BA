 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       SegmentEmbed    `yaml:"segment"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment is implemented by the two supported rule segment representations.
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ IsSegment }
+
+// Values returns the API representation of a rule segment. A single key always
+// uses OR, including when it was written as a one-key object.
+func (s SegmentEmbed) Values() (string, []string, string, error) {
+	switch value := s.IsSegment.(type) {
+	case SegmentKey:
+		if value != "" {
+			return string(value), nil, "OR_SEGMENT_OPERATOR", nil
+		}
+	case *SegmentKey:
+		if value != nil {
+			return SegmentEmbed{IsSegment: *value}.Values()
+		}
+	case Segments:
+		if len(value.Keys) == 0 {
+			break
+		}
+		for _, key := range value.Keys {
+			if key == "" {
+				return "", nil, "", fmt.Errorf("segment key cannot be empty")
+			}
+		}
+		if len(value.Keys) == 1 {
+			return value.Keys[0], nil, "OR_SEGMENT_OPERATOR", nil
+		}
+		if value.SegmentOperator == "AND_SEGMENT_OPERATOR" || value.SegmentOperator == "OR_SEGMENT_OPERATOR" {
+			return "", value.Keys, value.SegmentOperator, nil
+		}
+		return "", nil, "", fmt.Errorf("invalid segment operator %q", value.SegmentOperator)
+	case *Segments:
+		if value != nil {
+			return SegmentEmbed{IsSegment: *value}.Values()
+		}
+	}
+	return "", nil, "", fmt.Errorf("segment must be a nonempty key or a keys/operator object")
+}
+
+func (s SegmentEmbed) MarshalYAML() (interface{}, error) {
+	_, _, operator, err := s.Values()
+	if err != nil {
+		return nil, err
+	}
+	switch value := s.IsSegment.(type) {
+	case SegmentKey:
+		return string(value), nil
+	case *SegmentKey:
+		return string(*value), nil
+	case Segments:
+		value.SegmentOperator = operator
+		return value, nil
+	case *Segments:
+		return Segments{Keys: value.Keys, SegmentOperator: operator}, nil
+	}
+	return nil, fmt.Errorf("invalid segment value %T", s.IsSegment)
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch value := raw.(type) {
+	case string:
+		s.IsSegment = SegmentKey(value)
+	case map[interface{}]interface{}:
+		segment, err := segmentFromMap(value)
+		if err != nil {
+			return err
+		}
+		if len(segment.Keys) == 1 {
+			segment.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		s.IsSegment = segment
+	case map[string]interface{}:
+		converted := make(map[interface{}]interface{}, len(value))
+		for key, item := range value {
+			converted[key] = item
+		}
+		segment, err := segmentFromMap(converted)
+		if err != nil {
+			return err
+		}
+		if len(segment.Keys) == 1 {
+			segment.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		s.IsSegment = segment
+	default:
+		return fmt.Errorf("invalid segment format %T", raw)
+	}
+	_, _, _, err := s.Values()
+	return err
+}
+
+func segmentFromMap(raw map[interface{}]interface{}) (Segments, error) {
+	segment := Segments{}
+	var hasKeys, hasOperator bool
+	for key, value := range raw {
+		switch key {
+		case "keys":
+			hasKeys = true
+			items, ok := value.([]interface{})
+			if !ok {
+				return segment, fmt.Errorf("segment keys must be a list of strings")
+			}
+			for _, item := range items {
+				key, ok := item.(string)
+				if !ok || key == "" {
+					return segment, fmt.Errorf("segment keys must be nonempty strings")
+				}
+				segment.Keys = append(segment.Keys, key)
+			}
+		case "operator":
+			hasOperator = true
+			operator, ok := value.(string)
+			if !ok {
+				return segment, fmt.Errorf("segment operator must be a string")
+			}
+			segment.SegmentOperator = operator
+		default:
+			return segment, fmt.Errorf("unsupported segment field %v", key)
+		}
+	}
+	if !hasKeys || !hasOperator {
+		return segment, fmt.Errorf("segment requires keys and operator")
+	}
+	return segment, nil
 }
 
