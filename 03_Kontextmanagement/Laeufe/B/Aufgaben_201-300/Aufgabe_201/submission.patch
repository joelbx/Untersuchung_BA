index 0000000..ce0d2fd
--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,57 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+)
+
+func TestRuleSegmentYAML(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		key      string
+		keys     []string
+		operator string
+		output   string
+	}{
+		{"string", "segment: foo\n", "foo", nil, "OR_SEGMENT_OPERATOR", "segment: foo\n"},
+		{"multiple keys", "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n", "", []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR", "segment:\n  keys:\n  - foo\n  - bar\n  operator: AND_SEGMENT_OPERATOR\n"},
+		{"one key forces OR", "segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR\n", "foo", nil, "OR_SEGMENT_OPERATOR", "segment:\n  keys:\n  - foo\n  operator: OR_SEGMENT_OPERATOR\n"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var rule Rule
+			require.NoError(t, yaml.UnmarshalStrict([]byte(tc.input), &rule))
+			key, keys, operator, err := rule.Segment.Values()
+			require.NoError(t, err)
+			require.Equal(t, tc.key, key)
+			require.Equal(t, tc.keys, keys)
+			require.Equal(t, tc.operator, operator)
+			out, err := yaml.Marshal(&rule)
+			require.NoError(t, err)
+			require.Equal(t, tc.output, string(out))
+		})
+	}
+}
+
+func TestRuleSegmentYAMLRejectsInvalid(t *testing.T) {
+	for _, input := range []string{
+		"segment: []\n",
+		"segment: 42\n",
+		"segment: ''\n",
+		"segment: {keys: [foo]}\n",
+		"segment: {operator: AND_SEGMENT_OPERATOR}\n",
+		"segment: {keys: [], operator: AND_SEGMENT_OPERATOR}\n",
+		"segment: {keys: [foo, bar], operator: UNKNOWN}\n",
+		"segment: {keys: [foo], operator: OR_SEGMENT_OPERATOR, extra: true}\n",
+	} {
+		var rule Rule
+		require.Error(t, yaml.Unmarshal([]byte(input), &rule), input)
+	}
+	var rule Rule
+	require.NoError(t, yaml.Unmarshal([]byte("{}\n"), &rule))
+	_, _, _, err := rule.Segment.Values()
+	require.Error(t, err)
+}
