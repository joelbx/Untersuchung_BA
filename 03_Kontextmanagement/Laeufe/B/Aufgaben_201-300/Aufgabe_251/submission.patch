+func TestFeaturesValidatorReportsEveryFieldAtSourcePosition(t *testing.T) {
+	file := "features.yaml"
+	content := []byte("flags:\n  - key: x\n    ey: bad\n    name: x\n    nabled: true\n    enabled: true\n    variants: []\n    rules:\n      - segment: x\n        rank: 1\n        distributions:\n          - variant: x\n            rollout: 110\nsegments: []\n")
+	fv, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	result, err := fv.Validate(file, content)
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.Len(t, result.Errors, 3)
+	issues := make(map[string]Error)
+	for _, issue := range result.Errors {
+		issues[issue.Path] = issue
+		require.Equal(t, file, issue.Location.File)
+	}
+	require.Equal(t, Location{File: file, Line: 3, Column: 5}, issues["flags.0.ey"].Location)
+	require.Contains(t, issues["flags.0.ey"].Message, "ey: field not allowed")
+	require.Equal(t, Location{File: file, Line: 5, Column: 5}, issues["flags.0.nabled"].Location)
+	require.Contains(t, issues["flags.0.nabled"].Message, "nabled: field not allowed")
+	require.Equal(t, Location{File: file, Line: 13, Column: 22}, issues["flags.0.rules.0.distributions.0.rollout"].Location)
+	require.Contains(t, issues["flags.0.rules.0.distributions.0.rollout"].Message, "<=100")
+}
+
+func TestValidateFilesFormats(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "invalid.yaml")
+	require.NoError(t, os.WriteFile(file, []byte("flags:\n  - key: x\n    name: x\n    enabled: true\n    variants: []\n    rules: []\n    ey: bad\nsegments: []\n"), 0600))
+	var out bytes.Buffer
+	err := ValidateFiles(&out, []string{file}, jsonFormat)
+	require.ErrorIs(t, err, ErrValidationFailed)
+	var result Result
+	require.NoError(t, json.Unmarshal(out.Bytes(), &result))
+	require.Len(t, result.Errors, 1)
+	require.Equal(t, "flags.0.ey", result.Errors[0].Path)
+	require.Equal(t, Location{File: file, Line: 7, Column: 5}, result.Errors[0].Location)
+	out.Reset()
+	err = ValidateFiles(&out, []string{file}, textFormat)
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.True(t, strings.Contains(out.String(), "ey: field not allowed"))
+	require.True(t, strings.Contains(out.String(), "Line   : 7"))
+}
