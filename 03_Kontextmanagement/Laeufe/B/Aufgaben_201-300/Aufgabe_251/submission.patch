+	v   cue.Value
+}
+
+func NewFeaturesValidator() (*FeaturesValidator, error) {
+	cctx := cuecontext.New()
+	v := cctx.CompileBytes(cueFile)
+	if err := v.Err(); err != nil {
+		return nil, err
+	}
+	return &FeaturesValidator{cue: cctx, v: v}, nil
+}
+
+// sourceLocation walks the original YAML tree, including sequence indices. A
+// missing field has no node of its own, so its nearest existing parent is used.
+func sourceLocation(root *yamlv3.Node, path []string, key bool) (int, int) {
+	n := root
+	if n.Kind == yamlv3.DocumentNode && len(n.Content) > 0 {
+		n = n.Content[0]
+	}
+	var label *yamlv3.Node
+	for _, part := range path {
+		switch n.Kind {
+		case yamlv3.MappingNode:
+			found := false
+			for i := 0; i+1 < len(n.Content); i += 2 {
+				if n.Content[i].Value == part {
+					label, n, found = n.Content[i], n.Content[i+1], true
+					break
+				}
+			}
+			if !found {
+				return n.Line, n.Column
+			}
+		case yamlv3.SequenceNode:
+			i, err := strconv.Atoi(part)
+			if err != nil || i < 0 || i >= len(n.Content) {
+				return n.Line, n.Column
+			}
+			n = n.Content[i]
+			label = nil
+		default:
+			return n.Line, n.Column
+		}
+	}
+	if key && label != nil {
+		return label.Line, label.Column
+	}
+	return n.Line, n.Column
+}
+
+func syntaxError(file string, err error) Error {
+	issue := Error{Message: err.Error(), Location: Location{File: file}}
+	for _, ce := range cueerror.Errors(err) {
+		for _, pos := range ce.InputPositions() {
+			if pos.Line() > 0 && (pos.Filename() == file || pos.Filename() == "") {
+				issue.Location.Line, issue.Location.Column = pos.Line(), pos.Column()
+				return issue
+			}
+		}
+	}
+	if match := yamlLinePattern.FindStringSubmatch(err.Error()); len(match) == 2 {
+		issue.Location.Line, _ = strconv.Atoi(match[1])
+		issue.Location.Column = 1
+	}
+	return issue
+}
+
+// Validate checks YAML content and returns all schema errors with source locations.
+func (fv *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	result := Result{Errors: []Error{}}
+	f, err := yaml.Extract(file, b)
+	if err != nil {
+		result.Errors = append(result.Errors, syntaxError(file, err))
+		return result, ErrValidationFailed
+	}
+	var root yamlv3.Node
+	if err := yamlv3.Unmarshal(b, &root); err != nil {
+		result.Errors = append(result.Errors, syntaxError(file, err))
+		return result, ErrValidationFailed
+	}
+	yv := fv.v.Unify(fv.cue.BuildFile(f, cue.Scope(fv.v)))
+	if err := yv.Validate(); err != nil {
+		for _, ce := range cueerror.Errors(err) {
+			path := ce.Path()
+			message, args := ce.Msg()
+			message = fmt.Sprintf(message, args...)
+			line, column := sourceLocation(&root, path, strings.Contains(message, "field not allowed"))
+			if len(path) > 0 {
+				message = path[len(path)-1] + ": " + message
+			}
+			result.Errors = append(result.Errors, Error{
+				Path: strings.Join(path, "."), Message: message,
+				Location: Location{File: file, Line: line, Column: column},
+			})
+		}
+		return result, ErrValidationFailed
+	}
+	return result, nil
+}
