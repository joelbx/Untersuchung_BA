+    metadata = {
+        'publisher': ['[London] ; New York ; Paris : [Berlitz Publishing]', ' Exact Name '],
+        'isbn': [' 1234567890 ', 'ABCDEFGHIJKLM ', 'bad'],
+    }
+    result = code.ia_importapi.get_ia_record(metadata)
+    assert result['publish_places'] == ['London', 'New York', 'Paris']
+    assert result['publishers'] == ['Berlitz Publishing', ' Exact Name ']
+    assert result['isbn_10'] == ['1234567890']
+    assert result['isbn_13'] == ['ABCDEFGHIJKLM']
+
+
