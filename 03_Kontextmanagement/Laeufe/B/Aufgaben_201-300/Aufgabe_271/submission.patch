+def get_location_and_publisher(loc_pub: str) -> tuple[list[str], list[str]]:
+    """Extract ordered locations and publishers from IA publication metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub:
+        return [], []
+
+    loc_pub = loc_pub.replace(UNIDENTIFIED_PLACE, '')
+
+    def clean(value: str) -> str:
+        return value.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+
+    if ':' not in loc_pub:
+        publisher = loc_pub.split(',', 1)[1] if ',' in loc_pub else loc_pub
+        publisher = clean(publisher)
+        return [], [publisher] if publisher else []
+
+    locations: list[str] = []
+    publishers: list[str] = []
+    pending_locations: list[str] = []
+    for segment in loc_pub.split(';'):
+        if ':' not in segment:
+            value = clean(segment)
+            if value:
+                if publishers:
+                    publishers[-1] += ' ; ' + value
+                else:
+                    pending_locations.append(value)
+            continue
+
+        # A third field after a second colon is not part of the pair.
+        pair = segment.split(':', 2)
+        location, publisher = get_colon_only_loc_pub(':'.join(pair[:2]))
+        locations.extend(pending_locations)
+        pending_locations.clear()
+        if location := clean(location):
+            locations.append(location)
+        if publisher := clean(publisher):
+            publishers.append(publisher)
+        if len(pair) == 3:
+            break
+
+    return locations, publishers
 
 
