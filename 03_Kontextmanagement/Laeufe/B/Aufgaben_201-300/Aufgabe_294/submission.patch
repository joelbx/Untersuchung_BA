+def _extract_tar_dir(tar, filename, b_dest, b_temp_path):
+    b_dest_dir = os.path.abspath(os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict')))
+    if not _is_child_path(b_dest_dir, b_dest):
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % to_native(filename, errors='surrogate_or_strict'))
+
+    member = tar.getmember(to_native(filename, errors='surrogate_or_strict'))
+    if member.issym():
+        b_linkname = to_bytes(member.linkname, errors='surrogate_or_strict')
+        if _is_child_path(b_linkname, b_dest, b_dest_dir):
+            b_parent_dir = os.path.dirname(b_dest_dir)
+            if not os.path.exists(b_parent_dir):
+                os.makedirs(b_parent_dir, mode=0o0755)
+            os.symlink(b_linkname, b_dest_dir)
+        else:
+            _extract_tar_file(tar, filename, b_dest, b_temp_path)
+    elif member.isdir():
+        if not os.path.exists(b_dest_dir):
+            os.makedirs(b_dest_dir, mode=0o0755)
+    else:
+        raise AnsibleError("Cannot extract tar entry '%s' as a directory" % to_native(filename))
+
