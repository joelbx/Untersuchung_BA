+utils.tokens.list = async () => {
+	const tokens = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await utils.tokens.get(tokens);
+};
+
+utils.tokens.generate = async ({ uid, description = '' } = {}) => {
+	const numericUid = Number(uid);
+	if (uid === null || uid === undefined || uid === '' || !Number.isFinite(numericUid)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.exists(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, {
+		uid: numericUid,
+		description: description,
+		timestamp: timestamp,
+	});
+	await Promise.all([
+		db.sortedSetAdd('tokens:createtime', timestamp, token),
+		db.sortedSetAdd('tokens:uid', numericUid, token),
+	]);
+	return token;
+};
+
+utils.tokens.get = async (tokens) => {
+	if (tokens === null || tokens === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const single = !Array.isArray(tokens);
+	const tokenIds = single ? [tokens] : tokens;
+	if (tokenIds.some(token => typeof token !== 'string' || !token)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokenIds.length) {
+		return [];
+	}
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenIds.map(token => `token:${token}`)),
+		utils.tokens.getLastSeen(tokenIds),
+	]);
+	const result = objects.map((data, index) => {
+		if (!data) {
+			return null;
+		}
+		const uid = Number(data.uid);
+		const timestamp = Number(data.timestamp);
+		if (!Number.isFinite(uid) || !Number.isFinite(timestamp)) {
+			throw new Error('[[error:invalid-data]]');
+		}
+		return {
+			uid: uid,
+			description: data.description || '',
+			timestamp: timestamp,
+			lastSeen: lastSeen[index],
+		};
+	});
+	return single ? result[0] : result;
+};
+
+utils.tokens.update = async (token, { description } = {}) => {
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await utils.tokens.get(token);
+};
+
+utils.tokens.delete = async (token) => {
+	await Promise.all([
+		db.deleteAll([`token:${token}`]),
+		db.sortedSetRemove('tokens:createtime', token),
+		db.sortedSetRemove('tokens:uid', token),
+		db.sortedSetRemove('tokens:lastSeen', token),
+	]);
+};
+
+utils.tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.tokens.getLastSeen = async (tokens) => {
+	if (!tokens.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokens);
+	return scores.map(score => (score === null || !Number.isFinite(Number(score)) ? null : Number(score)));
+};
+
+// Keep existing authentication and admin callers working.
+utils.log = utils.tokens.log;
+utils.getLastSeen = utils.tokens.getLastSeen;
