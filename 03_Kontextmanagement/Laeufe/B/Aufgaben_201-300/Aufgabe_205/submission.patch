diff --git a/test/api-utils-tokens.js b/test/api-utils-tokens.js
new file mode 100644
index 0000000..48c06d2
--- /dev/null
+++ b/test/api-utils-tokens.js
@@ -0,0 +1,104 @@
+'use strict';
+
+const assert = require('assert');
+const Module = require('module');
+
+const objects = new Map();
+const indexes = new Map();
+let nextToken = 0;
+const db = {
+	setObject: async (key, value) => objects.set(key, { ...value }),
+	setObjectField: async (key, field, value) => objects.set(key, { ...objects.get(key), [field]: value }),
+	getObjects: async keys => keys.map(key => objects.get(key) || null),
+	deleteAll: async keys => keys.forEach(key => objects.delete(key)),
+	sortedSetAdd: async (key, score, member) => {
+		if (!indexes.has(key)) {
+			indexes.set(key, new Map());
+		}
+		indexes.get(key).set(member, score);
+	},
+	sortedSetRemove: async (key, member) => {
+		if (indexes.has(key)) {
+			indexes.get(key).delete(member);
+		}
+	},
+	sortedSetScores: async (key, members) => members.map((member) => {
+		const score = indexes.has(key) ? indexes.get(key).get(member) : undefined;
+		return score === undefined ? null : score;
+	}),
+	getSortedSetRange: async key => Array.from(indexes.get(key) || [])
+		.sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]))
+		.map(([member]) => member),
+};
+
+const originalLoad = Module._load;
+Module._load = function (request, parent, isMain) {
+	if (parent && parent.filename.endsWith('/src/api/utils.js')) {
+		if (request === '../database') {
+			return db;
+		}
+		if (request === '../user') {
+			return { exists: async uid => uid === 2 };
+		}
+		if (request === '../utils') {
+			return {
+				generateUUID: () => {
+					nextToken += 1;
+					return `test-token-${nextToken}`;
+				},
+			};
+		}
+	}
+	return originalLoad.call(this, request, parent, isMain);
+};
+const { tokens } = require('../src/api/utils');
+
+Module._load = originalLoad;
+
+describe('internal API token utilities', () => {
+	beforeEach(() => {
+		objects.clear();
+		indexes.clear();
+	});
+
+	it('handles empty collections and rejects missing input', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), { message: '[[error:invalid-data]]' });
+		await assert.rejects(tokens.get(undefined), { message: '[[error:invalid-data]]' });
+		await assert.rejects(tokens.generate({ uid: 3 }), { message: '[[error:no-user]]' });
+	});
+
+	it('creates, hydrates, updates, logs and completely deletes tokens', async () => {
+		const first = await tokens.generate({ uid: '2', description: 'first' });
+		const second = await tokens.generate({ uid: 0 });
+		const created = objects.get(`token:${first}`);
+		assert.strictEqual(created.uid, 2);
+		assert.strictEqual(created.description, 'first');
+		assert(Number.isFinite(created.timestamp));
+		assert(Math.abs(created.timestamp - Date.now()) < 1000);
+		assert.strictEqual(indexes.get('tokens:createtime').get(first), created.timestamp);
+		assert.strictEqual(indexes.get('tokens:uid').get(first), 2);
+		assert.strictEqual(indexes.get('tokens:uid').get(second), 0);
+		assert.deepStrictEqual(await tokens.get([second, first]), [await tokens.get(second), await tokens.get(first)]);
+		assert.strictEqual((await tokens.get(first)).lastSeen, null);
+		await tokens.log(first);
+		const seen = (await tokens.getLastSeen([second, first]))[1];
+		assert(Number.isFinite(seen));
+		assert.strictEqual((await tokens.get(first)).lastSeen, seen);
+		assert.deepStrictEqual((await tokens.list()).map(item => item.description), ['first', '']);
+		const updated = await tokens.update(first, { description: 'renamed' });
+		assert.strictEqual(updated.description, 'renamed');
+		assert.strictEqual(updated.uid, 2);
+		assert.strictEqual(updated.timestamp, created.timestamp);
+		assert.strictEqual(updated.lastSeen, seen);
+		await tokens.delete(first);
+		assert.strictEqual(await tokens.get(first), null);
+		for (const key of ['tokens:createtime', 'tokens:uid', 'tokens:lastSeen']) {
+			assert.strictEqual(indexes.get(key).get(first), undefined);
+		}
+		assert.deepStrictEqual(await tokens.getLastSeen([first]), [null]);
+		assert.strictEqual(objects.has(`token:${first}`), false);
+	});
+});
