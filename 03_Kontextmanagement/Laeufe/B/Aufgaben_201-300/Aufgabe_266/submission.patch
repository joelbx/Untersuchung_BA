+    def test_find_staged_or_pending(self, import_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'id': 4, 'batch_id': 1, 'ia_id': 'amazon:978', 'status': 'staged'},
+                {'id': 5, 'batch_id': 1, 'ia_id': 'idb:978', 'status': 'pending'},
+                {'id': 6, 'batch_id': 1, 'ia_id': 'amazon:123', 'status': 'failed'},
+                {'id': 7, 'batch_id': 1, 'ia_id': 'idb:123', 'status': 'staged'},
