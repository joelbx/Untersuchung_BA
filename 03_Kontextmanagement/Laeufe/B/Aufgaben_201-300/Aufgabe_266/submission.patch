+                {'id': 9, 'batch_id': 1, 'ia_id': 'amazon:999', 'status': 'staged'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['978', '123'])
+        assert isinstance(result, type(import_item_db.select('import_item', limit=1)))
+        assert {row.ia_id for row in result} == {
+            'amazon:978',
+            'idb:978',
+            'idb:123',
+        }
+        custom_result = ImportItem.find_staged_or_pending(
+            ['978'], sources=iter(['other'])
