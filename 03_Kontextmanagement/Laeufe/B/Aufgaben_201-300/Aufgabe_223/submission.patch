+    (b'#!/opt/venv/bin/python3.8 -X "dev mode"\n', {}, '#!/opt/venv/bin/python3.8 -X "dev mode"'),
+    (b'#!/opt/venv/bin/python3.8 -X "dev mode"\n', {'ansible_python_interpreter': '/usr/bin/python3'}, '#!/usr/bin/python3 -X "dev mode"'),
+    (b'', {}, '#!/usr/bin/python'),
+])
+def test_new_python_module_shebang(tmp_path, mocker, templar, source, task_vars, expected):
+    module_path = tmp_path / 'custom_module.py'
+    module_path.write_bytes(source + b'from ansible.module_utils.basic import AnsibleModule\n')
+    mocker.patch.object(module_common.C, 'DEFAULT_LOCAL_TMP', str(tmp_path))
+    mocker.patch.object(module_common, 'recursive_finder')
+
+    data, style, shebang = modify_module('custom_module', str(module_path), {}, templar, task_vars=task_vars)
+
+    assert style == 'new'
+    assert shebang == expected
+    assert data.startswith(expected.encode('utf-8') + b'\n' + module_common.b_ENCODING_STRING + b'\n')
+
+
+def test_non_python_shebang_and_args_are_preserved(tmp_path, templar):
+    module_path = tmp_path / 'custom_module'
+    source = b'#!/usr/bin/env -S "ruby -w"\nputs "hello"\n'
+    module_path.write_bytes(source)
+
+    data, style, shebang = modify_module('custom_module', str(module_path), {}, templar)
+
+    assert style == 'old'
+    assert shebang == '#!/usr/bin/env -S "ruby -w"'
+    assert data.startswith(source.split(b'\n', 1)[0] + b'\n' + module_common.b_ENCODING_STRING + b'\n')
+
+
+def test_non_python_override_preserves_quoted_args(tmp_path, templar):
+    module_path = tmp_path / 'custom_module'
+    module_path.write_bytes(b'#!/usr/bin/ruby -e "puts 1"\nputs "hello"\n')
+
+    data, style, shebang = modify_module('custom_module', str(module_path), {}, templar,
+                                         task_vars={'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'})
+
+    assert style == 'old'
+    assert shebang == '#!/opt/ruby/bin/ruby -e "puts 1"'
+    assert data.startswith(shebang.encode('utf-8') + b'\n' + module_common.b_ENCODING_STRING + b'\n')
