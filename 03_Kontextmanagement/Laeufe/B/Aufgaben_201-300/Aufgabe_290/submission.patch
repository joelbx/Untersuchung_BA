+
+describe('legacy call audio playback', () => {
+    afterEach(() => jest.restoreAllMocks());
+
+    it.each(Object.values(AudioID))('unmutes %s before playback', (audioId) => {
+        const audio = {
+            id: audioId,
+            muted: true,
+            play: jest.fn().mockImplementation(function() {
+                expect(audio.muted).toBe(false);
+                return Promise.resolve();
+            }),
+        } as unknown as HTMLMediaElement;
+        jest.spyOn(document, 'getElementById').mockReturnValue(audio);
+
+        new LegacyCallHandler().play(audioId);
+
+        expect(audio.muted).toBe(false);
+        expect(audio.play).toHaveBeenCalledTimes(1);
+    });
+
+    it('leaves an unmuted element unchanged before playback', () => {
+        let muted = false;
+        const setMuted = jest.fn((value: boolean) => { muted = value; });
+        const audio = {
+            get muted() { return muted; },
+            set muted(value: boolean) { setMuted(value); },
+            play: jest.fn().mockResolvedValue(undefined),
+        } as unknown as HTMLMediaElement;
+        jest.spyOn(document, 'getElementById').mockReturnValue(audio);
+
+        new LegacyCallHandler().play(AudioID.Ring);
+
+        expect(setMuted).not.toHaveBeenCalled();
+        expect(audio.play).toHaveBeenCalledTimes(1);
+    });
+});
+
+describe('legacy call audio events', () => {
+    afterEach(() => jest.restoreAllMocks());
+
+    it('logs errors with the media element id', () => {
+        const log = jest.spyOn(logger, 'error').mockImplementation();
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ring;
+        audio.addEventListener('error', handleEvent);
+
+        audio.dispatchEvent(new Event('error'));
+
+        expect(log).toHaveBeenCalledWith('Legacy call audio event', expect.objectContaining({
+            elementId: AudioID.Ring,
+            eventType: 'error',
+        }));
+    });
+
+    it('logs debug events only with the debug setting enabled', () => {
+        const log = jest.spyOn(logger, 'debug').mockImplementation();
+        const setting = jest.spyOn(SettingsStore, 'getValue').mockReturnValue(false);
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ringback;
+        audio.addEventListener('playing', handleEvent);
+
+        audio.dispatchEvent(new Event('playing'));
+        expect(log).not.toHaveBeenCalled();
+        setting.mockReturnValue(true);
+        audio.dispatchEvent(new Event('playing'));
+        expect(log).toHaveBeenCalledWith('Legacy call audio event', {
+            elementId: AudioID.Ringback,
+            eventType: 'playing',
+        });
+        expect(setting).toHaveBeenCalledWith('debug_legacy_call_handler');
+    });
+});
