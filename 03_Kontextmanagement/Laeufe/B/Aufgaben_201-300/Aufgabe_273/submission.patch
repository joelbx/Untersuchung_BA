@@ -5,6 +5,55 @@ from openlibrary import accounts
 from openlibrary.mocks.mock_infobase import MockSite
 
 
+def test_make_work_without_author_fields():
+    for author_fields in ({}, {'author_key': ['OL1A']}, {'author_name': ['Author']}):
+        doc = {'title': 'Untitled work', **author_fields}
+        work = addbook.make_work(doc)
+
+        assert isinstance(work, web.Storage)
+        assert all(work[key] == value for key, value in doc.items())
+        assert work.authors == []
+        assert work.cover_url == '/images/icons/avatar_book-sm.png'
+        assert work.ia == []
+        assert work.first_publish_year is None
+
+
+def test_make_work_preserves_metadata_and_creates_authors(monkeypatch):
+    calls = []
+    created = [object(), object()]
+
+    def new(path, data):
+        calls.append((path, data))
+        return created[len(calls) - 1]
+
+    monkeypatch.setattr(web.ctx, 'site', web.storage(new=new), raising=False)
+    doc = {
+        'title': 'A work',
+        'author_key': ['OL1A', 'OL2A'],
+        'author_name': ['First', 'Second'],
+        'cover_url': '/custom-cover.png',
+        'ia': ['archive-id'],
+        'first_publish_year': 1990,
+    }
+    work = addbook.make_work(doc)
+
+    assert len(work.authors) == len(created)
+    assert all(author is expected for author, expected in zip(work.authors, created))
+    assert calls == [
+        (
+            '/authors/OL1A',
+            {'key': '/authors/OL1A', 'type': {'key': '/type/author'}, 'name': 'First'},
+        ),
+        (
+            '/authors/OL2A',
+            {'key': '/authors/OL2A', 'type': {'key': '/type/author'}, 'name': 'Second'},
+        ),
+    ]
+    assert work.cover_url == doc['cover_url']
+    assert work.ia == doc['ia']
+    assert work.first_publish_year == doc['first_publish_year']
+
+
 def strip_nones(d):
     return {k: v for k, v in d.items() if v is not None}
 
