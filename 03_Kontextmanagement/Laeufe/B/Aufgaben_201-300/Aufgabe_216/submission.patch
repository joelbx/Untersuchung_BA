+from __future__ import (absolute_import, division, print_function)
+
+from io import StringIO
+from units.compat.mock import MagicMock
+
+from ansible import constants as C, context
+from ansible.config.manager import ConfigManager
+from ansible.playbook.play_context import PlayContext
+from ansible.plugins.connection import ssh
+from ansible.plugins.loader import connection_loader
+from ansible.utils.context_objects import CLIArgs
+
+
+def test_ssh_option_sources(tmp_path, monkeypatch):
+    connection_loader.get('ssh', class_only=True)
+    definitions = C.config.get_configuration_definitions('connection', 'ssh')
+    required = ('ssh_common_args', 'sftp_extra_args', 'scp_extra_args',
+                'ssh_extra_args', 'ssh_args', 'ssh_executable', 'control_path',
+                'control_path_dir', 'timeout', 'private_key_file', 'remote_user',
+                'retries', 'transfer_method', 'scp_if_ssh', 'sftp_batch_mode')
+    assert all(option in definitions for option in required)
+
+    config_file = tmp_path / 'ansible.cfg'
+    config_file.write_text('[ssh_connection]\nssh_args = -o ControlPersist=7s\n'
+                           'transfer_method = scp\nretries = 2\n'
+                           'ssh_executable = /cfg/ssh\n')
+    manager = ConfigManager(conf_file=str(config_file))
+    manager.initialize_plugin_configuration_definitions('connection', 'ssh', definitions)
+    monkeypatch.setattr(C, 'config', manager)
+    monkeypatch.setattr(context, 'CLIARGS', CLIArgs({}))
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.set_options()
+    assert conn.get_option('ssh_args') == '-o ControlPersist=7s'
+    assert conn.get_option('ssh_executable') == '/cfg/ssh'
+    assert conn.get_option('transfer_method') == 'scp'
+
+    monkeypatch.setenv('ANSIBLE_SSH_EXECUTABLE', '/env/ssh')
+    conn.set_options()
+    assert conn.get_option('ssh_executable') == '/env/ssh'
+
+    monkeypatch.setattr(context, 'CLIARGS', CLIArgs({'ssh_common_args': '-F /cli/config', 'retries': 4}))
+    conn.set_options()
+    assert conn.get_option('ssh_common_args') == '-F /cli/config'
+    assert conn.get_option('retries') == 4
+    assert b'/cli/config' in conn._build_command('ssh', 'ssh')
+
+    conn.set_options(var_options={'ansible_ssh_common_args': '-F /inventory/config',
+                                  'ansible_ssh_transfer_method': 'sftp'})
+    assert conn.get_option('ssh_common_args') == '-F /inventory/config'
+    assert conn.get_option('transfer_method') == 'sftp'
+
+
+def test_reset_checks_effective_socket_before_stopping(monkeypatch):
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.set_options()
+    conn.set_option('ssh_executable', '/custom/ssh')
+    conn.set_option('ssh_args', '-o ControlPersist=60s -o ControlPath=/tmp/custom-socket')
+
+    popen = MagicMock()
+    check = MagicMock()
+    check.wait.return_value = 1
+    check.communicate.return_value = (b'', b'')
+    popen.return_value = check
+    monkeypatch.setattr(ssh.subprocess, 'Popen', popen)
+    debug = MagicMock()
+    monkeypatch.setattr(ssh.display, 'debug', debug)
+
+    conn.reset()
+    assert popen.call_count == 1
+    check_cmd = popen.call_args[0][0]
+    assert check_cmd[0] == b'/custom/ssh'
+    assert b'ControlPath=/tmp/custom-socket' in check_cmd
+    assert b'check' in check_cmd
+    assert debug.called
+
+    check.wait.return_value = 0
+    popen.reset_mock()
+    conn.reset()
+    assert popen.call_count == 2
+    stop_cmd = popen.call_args[0][0]
+    assert b'stop' in stop_cmd
+    assert b'ControlPath=/tmp/custom-socket' in stop_cmd
+
+
+def test_transfer_method_controls_fallback(tmp_path):
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.set_options()
+    conn.host = 'example'
+    source = tmp_path / 'source'
+    source.write_text('data')
+    conn._build_command = MagicMock(return_value=[b'ssh'])
+    conn._bare_run = MagicMock(side_effect=[(1, b'', b'sftp failed'), (0, b'', b'')])
+
+    conn.set_option('transfer_method', 'smart')
+    conn.put_file(str(source), '/remote/file')
+    assert conn._bare_run.call_count == 2
+    assert conn._bare_run.call_args_list[0][0][1].startswith(b'put ')
+    assert conn._bare_run.call_args_list[1][0][1] is None
+
+    conn._bare_run.reset_mock(side_effect=True)
+    conn._bare_run.return_value = (0, b'', b'')
+    conn.set_option('transfer_method', 'scp')
+    conn.put_file(str(source), '/remote/file')
+    conn._bare_run.assert_called_once_with([b'ssh'], None, checkrc=False)
