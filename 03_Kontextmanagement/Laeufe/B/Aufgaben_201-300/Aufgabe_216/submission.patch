@@ -51,6 +52,16 @@ def check_for_controlpersist(ssh_executable):
     return has_cp
 
 
+def get_ssh_executable():
+    cli_executable = context.CLIARGS.get('ssh_executable')
+    if cli_executable is not None:
+        return cli_executable
+    # Register the SSH plugin's configuration before reading its options.
+    from ansible.plugins.loader import connection_loader
+    connection_loader.get('ssh', class_only=True)
+    return C.config.get_config_value('ssh_executable', plugin_type='connection', plugin_name='ssh')
+
+
