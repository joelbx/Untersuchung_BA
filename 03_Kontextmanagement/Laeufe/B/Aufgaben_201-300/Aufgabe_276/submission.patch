diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..a0f663b
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,66 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationProviderValidationOnLoad(t *testing.T) {
+	const github = `authentication:
+  session:
+    domain: localhost
+  methods:
+    github:
+      enabled: true
+      client_id: id
+      client_secret: secret
+      redirect_address: http://localhost/callback
+      scopes: [read:org]
+`
+	const oidc = `authentication:
+  session:
+    domain: localhost
+  methods:
+    oidc:
+      enabled: true
+      providers:
+        foo:
+          client_id: id
+          client_secret: secret
+          redirect_address: http://localhost/callback
+`
+
+	tests := []struct {
+		name    string
+		config  string
+		wantErr string
+	}{
+		{name: "github valid", config: github},
+		{name: "github missing client id", config: strings.Replace(github, "      client_id: id\n", "", 1), wantErr: `provider "github": field "client_id": non-empty value is required`},
+		{name: "github blank client secret", config: strings.Replace(github, "client_secret: secret", `client_secret: "   "`, 1), wantErr: `provider "github": field "client_secret": non-empty value is required`},
+		{name: "github missing redirect address", config: strings.Replace(github, "      redirect_address: http://localhost/callback\n", "", 1), wantErr: `provider "github": field "redirect_address": non-empty value is required`},
+		{name: "github missing org scope", config: strings.Replace(github, "scopes: [read:org]", "allowed_organizations: [flipt-io]", 1), wantErr: `provider "github": field "scopes": must contain read:org when allowed_organizations is not empty`},
+		{name: "oidc valid", config: oidc},
+		{name: "oidc missing client id", config: strings.Replace(oidc, "          client_id: id\n", "", 1), wantErr: `provider "foo": field "client_id": non-empty value is required`},
+		{name: "oidc missing client secret", config: strings.Replace(oidc, "          client_secret: secret\n", "", 1), wantErr: `provider "foo": field "client_secret": non-empty value is required`},
+		{name: "oidc blank redirect address", config: strings.Replace(oidc, "redirect_address: http://localhost/callback", `redirect_address: "   "`, 1), wantErr: `provider "foo": field "redirect_address": non-empty value is required`},
+		{name: "oidc disabled", config: strings.Replace(oidc, "enabled: true", "enabled: false", 1) + "        bar: {}\n"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.config), 0600))
+			_, err := Load(path)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+}
