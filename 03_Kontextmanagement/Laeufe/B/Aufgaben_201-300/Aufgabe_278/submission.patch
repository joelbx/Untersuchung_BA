diff --git a/applications/mail/src/app/logic/elements/elementsActions.test.ts b/applications/mail/src/app/logic/elements/elementsActions.test.ts
new file mode 100644
index 0000000..e146b7c
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elementsActions.test.ts
@@ -0,0 +1,78 @@
+import { configureStore } from '@reduxjs/toolkit';
+import { backendActionFinished, backendActionStarted, load } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+import { queryElements } from './helpers/elementQuery';
+import { QueryParams } from './elementsTypes';
+
+jest.mock('./helpers/elementQuery', () => ({
+    ...jest.requireActual('./helpers/elementQuery'),
+    queryElements: jest.fn(),
+}));
+
+describe('elements load retries', () => {
+    const query = queryElements as jest.Mock;
+    const args: QueryParams = {
+        api: jest.fn() as QueryParams['api'],
+        abortController: undefined,
+        conversationMode: true,
+        page: 0,
+        params: newState().params,
+    };
+    const makeStore = () =>
+        configureStore({
+            reducer: { elements: elementsReducer },
+            middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+        });
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        query.mockReset();
+    });
+
+    afterEach(() => {
+        jest.clearAllTimers();
+        jest.useRealTimers();
+    });
+
+    it('does not commit stale data and schedules a stale retry after one second', async () => {
+        const store = makeStore();
+        query.mockResolvedValue({ Total: 1, Elements: [{ ID: 'stale' }], Stale: 1 });
+
+        const result = await store.dispatch(load(args));
+        expect(load.rejected.match(result)).toBe(true);
+        expect(store.getState().elements.elements).toEqual({});
+        expect(store.getState().elements.pendingRequest).toBe(true);
+
+        jest.advanceTimersByTime(999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error: undefined });
+    });
+
+    it('retries a failed request after two seconds', async () => {
+        const store = makeStore();
+        const error = new Error('request failed');
+        query.mockRejectedValue(error);
+
+        const result = await store.dispatch(load(args));
+        expect(load.rejected.match(result)).toBe(true);
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toMatchObject({ count: 1, error });
+    });
+
+    it('discards an in-flight response while a backend action is pending', async () => {
+        const store = makeStore();
+        query.mockResolvedValue({ Total: 1, Elements: [{ ID: 'outdated' }], Stale: 0 });
+        store.dispatch(backendActionStarted());
+
+        await store.dispatch(load(args));
+        expect(store.getState().elements.elements).toEqual({});
+        expect(store.getState().elements.invalidated).toBe(true);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(0);
+    });
+});
