+def test_stderr_live(proc, qtbot, caplog, message_mock, py_proc):
+    proc._output_messages = True
+    cmd, args = py_proc("""
+        import sys, time
+        sys.stderr.write('stderr text')
+        sys.stderr.flush()
+        time.sleep(1)
+    """)
+    with caplog.at_level(logging.ERROR, 'message'):
+        proc.start(cmd, args)
+
+        qtbot.wait_until(lambda: bool(message_mock.messages), timeout=5000)
+        assert proc.outcome.running
+        assert message_mock.messages[0].level == usertypes.MessageLevel.error
+        assert message_mock.messages[0].text == 'stderr text'
+
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            pass
+    assert message_mock.messages[-1].text == 'Process stderr:\nstderr text'
