+
+package dynamoevents
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"reflect"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/trace"
+)
+
+const fieldsMapKey = "FieldsMap"
+
+// decodeFieldsJSON uses json.Number so large integers survive the conversion.
+func decodeFieldsJSON(data []byte) (map[string]interface{}, error) {
+	var fields map[string]interface{}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var extra interface{}
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return nil, trace.BadParameter("event fields contain multiple JSON values")
+		}
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	return fields, nil
+}
+
+func attributeJSONValue(attribute *dynamodb.AttributeValue) (interface{}, error) {
+	if attribute == nil {
+		return nil, trace.BadParameter("nil event field")
+	}
+	switch {
+	case attribute.NULL != nil && *attribute.NULL:
+		return nil, nil
+	case attribute.S != nil:
+		return *attribute.S, nil
+	case attribute.N != nil:
+		return json.Number(*attribute.N), nil
+	case attribute.BOOL != nil:
+		return *attribute.BOOL, nil
+	case attribute.M != nil:
+		value := make(map[string]interface{}, len(attribute.M))
+		for key, child := range attribute.M {
+			converted, err := attributeJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			value[key] = converted
+		}
+		return value, nil
+	case attribute.L != nil:
+		value := make([]interface{}, 0, len(attribute.L))
+		for _, child := range attribute.L {
+			converted, err := attributeJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			value = append(value, converted)
+		}
+		return value, nil
+	default:
+		return nil, trace.BadParameter("unsupported event field attribute")
+	}
+}
+
+func jsonValueAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch value := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(value)}, nil
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(value))}, nil
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(value)}, nil
+	case map[string]interface{}:
+		attributes := make(map[string]*dynamodb.AttributeValue, len(value))
+		for key, child := range value {
+			if key == "" {
+				return nil, trace.BadParameter("event field name cannot be empty")
+			}
+			attribute, err := jsonValueAttribute(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			attributes[key] = attribute
+		}
+		return &dynamodb.AttributeValue{M: attributes}, nil
+	case []interface{}:
+		attributes := make([]*dynamodb.AttributeValue, 0, len(value))
+		for _, child := range value {
+			attribute, err := jsonValueAttribute(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			attributes = append(attributes, attribute)
+		}
+		return &dynamodb.AttributeValue{L: attributes}, nil
+	default:
+		return nil, trace.BadParameter("unsupported JSON event field %T", value)
+	}
+}
+
+func fieldsMapAttribute(data []byte) (*dynamodb.AttributeValue, error) {
+	fields, err := decodeFieldsJSON(data)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	attribute, err := jsonValueAttribute(fields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	converted, err := fieldsMapJSON(attribute)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	decoded, err := decodeFieldsJSON(converted)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(fields, decoded) {
+		return nil, trace.BadParameter("event fields changed during DynamoDB map conversion")
+	}
+	return attribute, nil
+}
+
+func fieldsMapJSON(attribute *dynamodb.AttributeValue) ([]byte, error) {
+	if attribute == nil || attribute.M == nil {
+		return nil, trace.BadParameter("FieldsMap is not a DynamoDB map")
+	}
+	fields, err := attributeJSONValue(attribute)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return json.Marshal(fields)
+}
+
+func marshalEventItem(e event, data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	e.Fields = ""
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	attribute, err := fieldsMapAttribute(data)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item[fieldsMapKey] = attribute
+	delete(item, "Fields")
+	return item, nil
+}
+
+func eventFieldsJSON(item map[string]*dynamodb.AttributeValue, legacy string) ([]byte, error) {
+	if attribute, ok := item[fieldsMapKey]; ok {
+		return fieldsMapJSON(attribute)
+	}
+	if legacy == "" {
+		return nil, trace.BadParameter("event has neither FieldsMap nor Fields")
+	}
+	return []byte(legacy), nil
+}
+
+// migrateFieldsMap converts legacy items page by page. Each completed page is
+// checkpointed in the backend, so a failed or interrupted run can resume.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		flagKey := backend.FlagKey("dynamoEvents", "fieldsMap", l.Tablename)
+		var startKey map[string]*dynamodb.AttributeValue
+		if flag, err := l.backend.Get(ctx, flagKey); err == nil {
+			if string(flag.Value) == "done" {
+				return nil
+			}
+			if err := json.Unmarshal(flag.Value, &startKey); err != nil {
+				return trace.Wrap(err)
+			}
+		} else if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+		var migrated int
+		for {
+			if err := ctx.Err(); err != nil {
+				return trace.Wrap(err)
+			}
+			out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName: aws.String(l.Tablename), ExclusiveStartKey: startKey,
+				ConsistentRead: aws.Bool(true), Limit: aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+				FilterExpression: aws.String("attribute_exists(Fields) AND attribute_not_exists(FieldsMap)"),
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			requests := make([]*dynamodb.WriteRequest, 0, DynamoBatchSize)
+			for _, item := range out.Items {
+				legacy := item["Fields"]
+				if legacy == nil || legacy.S == nil {
+					return trace.BadParameter("legacy event has no JSON Fields string")
+				}
+				attribute, err := fieldsMapAttribute([]byte(*legacy.S))
+				if err != nil {
+					l.WithError(err).Errorf("Failed to convert event %v/%v", item[keySessionID], item[keyEventIndex])
+					return trace.Wrap(err)
+				}
+				item[fieldsMapKey] = attribute
+				delete(item, "Fields")
+				requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+				if len(requests) == DynamoBatchSize {
+					if err := l.uploadBatch(requests); err != nil {
+						return trace.Wrap(err)
+					}
+					migrated += len(requests)
+					requests = nil
+				}
+			}
+			if len(requests) > 0 {
+				if err := l.uploadBatch(requests); err != nil {
+					return trace.Wrap(err)
+				}
+				migrated += len(requests)
+			}
+			l.Infof("FieldsMap migration: converted %d events", migrated)
+			if len(out.LastEvaluatedKey) == 0 {
+				_, err = l.backend.Put(ctx, backend.Item{Key: flagKey, Value: []byte("done")})
+				return trace.Wrap(err)
+			}
+			checkpoint, err := json.Marshal(out.LastEvaluatedKey)
+			if err != nil {
+				return trace.Wrap(err)
+			}
+			if _, err := l.backend.Put(ctx, backend.Item{Key: flagKey, Value: checkpoint}); err != nil {
+				return trace.Wrap(err)
+			}
+			startKey = out.LastEvaluatedKey
+		}
+	})
+}
