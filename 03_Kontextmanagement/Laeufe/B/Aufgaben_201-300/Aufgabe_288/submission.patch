@@ -0,0 +1,35 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { useShouldMoveOut } from './useShouldMoveOut';
+
+describe('useShouldMoveOut', () => {
+    const onBack = jest.fn();
+
+    beforeEach(() => onBack.mockClear());
+
+    it('waits for the elements to load before checking the active ID', () => {
+        const { rerender } = renderHook(
+            ({ loadingElements, elementIDs }) =>
+                useShouldMoveOut({ elementID: 'active', elementIDs, loadingElements, onBack }),
+            { initialProps: { loadingElements: true, elementIDs: [] as string[] } }
+        );
+
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ loadingElements: false, elementIDs: ['active'] });
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ loadingElements: false, elementIDs: ['other'] });
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([undefined, '', 'missing'] as const)('moves back when the active ID is %s', (elementID) => {
+        renderHook(() => useShouldMoveOut({ elementID, elementIDs: ['valid'], loadingElements: false, onBack }));
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it('moves back when the element list is empty', () => {
+        renderHook(() =>
+            useShouldMoveOut({ elementID: 'active', elementIDs: [], loadingElements: false, onBack })
+        );
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+});
