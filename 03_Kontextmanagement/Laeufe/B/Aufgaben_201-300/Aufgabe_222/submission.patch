+@pytest.mark.parametrize('collection, expected_name', [('', 'sample'), ('namespace.collection', 'namespace.collection.sample')])
+def test_role_build_doc_preserves_specs(collection, expected_name):
+    main = {'short_description': 'Main', 'options': {'value': {'type': 'str'}}}
+    alternate = {'short_description': 'Alternate'}
+    argspec = {'main': main, 'alternate': alternate}
+    path = '/roles/sample'
+
+    fqcn, doc = RoleMixin()._build_doc('sample', path, collection, argspec)
+
+    assert fqcn == expected_name
+    assert doc['path'] == path
+    assert doc['collection'] == collection
+    assert doc['entry_points'] == argspec
+    assert doc['entry_points']['main'] is main
+
+    _, filtered = RoleMixin()._build_doc('sample', path, collection, argspec, entry_point='alternate')
+    assert filtered['entry_points'] == {'alternate': alternate}
+    assert filtered['entry_points']['alternate'] is alternate
+    assert argspec == {'main': main, 'alternate': alternate}
+
+
+@pytest.mark.parametrize('argspec, entry_point', [({}, None), ({'main': {'short_description': 'Main'}}, 'missing')])
+def test_role_build_doc_omits_unmatched_entry_points(argspec, entry_point):
+    assert RoleMixin()._build_doc('sample', '/roles/sample', '', argspec, entry_point) == ('sample', None)
+
+
+def test_create_role_doc_uses_filtered_builder(monkeypatch):
+    mixin = RoleMixin()
+    main = {'options': {'value': {'type': 'str'}}}
+    monkeypatch.setattr(mixin, '_find_all_normal_roles', lambda *args, **kwargs: {('plain', '/roles/plain')})
+    monkeypatch.setattr(mixin, '_find_all_collection_roles', lambda *args, **kwargs: {('collected', 'namespace.collection', '/collections/root')})
+    monkeypatch.setattr(mixin, '_load_argspec', lambda *args, **kwargs: {'main': main})
+
+    result = mixin._create_role_doc(('plain', 'namespace.collection.collected'), ('/roles',), entry_point='main')
+
+    assert result['plain'] == {'path': '/roles/plain', 'collection': '', 'entry_points': {'main': main}}
+    assert result['namespace.collection.collected'] == {
+        'path': '/collections/root', 'collection': 'namespace.collection', 'entry_points': {'main': main},
+    }
+    assert mixin._create_role_doc(('plain',), ('/roles',), entry_point='missing') == {}
