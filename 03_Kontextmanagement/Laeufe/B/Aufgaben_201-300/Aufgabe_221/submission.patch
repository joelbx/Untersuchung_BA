+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = "json"
+
+    def POST(self, work_id):
+        def response(data):
+            web.header('Content-Type', 'application/json')
+            return json.dumps(data)
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        if web.ctx.get('env', {}).get('CONTENT_TYPE', '').lower().startswith('application/json'):
+            try:
+                i = web.storage(json.loads(web.data()))
+            except (ValueError, TypeError):
+                return response({'errors': 'Invalid JSON'})
+        else:
+            i = web.input(op=None, topic=None, comment='', edition_key=None)
+        i.setdefault('op', None)
+        i.setdefault('topic', None)
+        i.setdefault('comment', '')
+        i.setdefault('edition_key', None)
+        if i.op not in ('add', 'remove', 'update'):
+            return response({'errors': 'Invalid operation'})
+        if i.op in ('add', 'update') and not i.topic:
+            return response({'errors': 'An award topic is required'})
+
+        edition_id = None
+        if i.edition_key:
+            try:
+                edition_id = int(extract_numeric_id_from_olid(i.edition_key))
+            except (TypeError, ValueError):
+                return response({'errors': 'Invalid edition key'})
+
+        username = user.key.split('/')[2]
+        try:
+            if i.op == 'remove':
+                return response({
+                    'success': True,
+                    'rows': Bestbook.remove(username=username, work_id=work_id),
+                })
+            if i.op == 'add':
+                award = Bestbook.add(
+                    username=username, work_id=work_id, topic=i.topic,
+                    comment=i.comment, edition_id=edition_id,
+                )
+            else:
+                award = Bestbook.update(
+                    username=username, work_id=work_id, topic=i.topic,
+                    comment=i.comment, edition_id=edition_id,
+                )
+            return response({'success': True, 'award': award})
+        except Bestbook.AwardConditionsError as exc:
+            return response({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = "/awards/count"
+    encoding = "json"
+
+    def GET(self):
+        i = web.input(work_id=None, username=None, topic=None)
+        try:
+            count = Bestbook.get_count(
+                work_id=i.work_id, username=i.username, topic=i.topic
+            )
+        except (TypeError, ValueError):
+            web.header('Content-Type', 'application/json')
+            return json.dumps({'errors': 'Invalid work ID'})
+        web.header('Content-Type', 'application/json')
+        return json.dumps({'count': count})
+
