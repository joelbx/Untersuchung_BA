@@ -0,0 +1,111 @@
+import pytest
+import web
+
+from openlibrary.core import db, models
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.core.bookshelves import Bookshelves
+
+
+@pytest.fixture
+def awards_db(monkeypatch):
+    database = web.database(dbn='sqlite', db=':memory:')
+    database.query('''
+        CREATE TABLE bestbook_awards (
+            id integer PRIMARY KEY,
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            topic text NOT NULL,
+            comment text NOT NULL DEFAULT '',
+            edition_id integer,
+            UNIQUE (username, work_id),
+            UNIQUE (username, topic)
+        )
+    ''')
+    monkeypatch.setattr(db, 'get_db', lambda: database)
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: True)
+    return database
+
+
+def test_award_conditions_and_counts(awards_db, monkeypatch):
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: False)
+    with pytest.raises(Bestbook.AwardConditionsError, match='Only books which have been marked as read'):
+        Bestbook.add('alice', '1', 'fiction')
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: True)
+
+    award_id = Bestbook.add('alice', '1', 'fiction', 'Favorite', 10)
+    Bestbook.add('bob', '1', 'fiction')
+    assert award_id is not None
+    assert Bestbook.get_count() == 2
+    assert Bestbook.get_count(work_id='1', username='alice', topic='fiction') == 1
+    assert Bestbook.get_count(username='alice', topic='history') == 0
+    assert len(Bestbook.get_awards(work_id='1')) == 2
+    assert Bestbook.get_leaderboard() == [{'work_id': 1, 'count': 2}]
+
+    with pytest.raises(Bestbook.AwardConditionsError, match='already awarded this book'):
+        Bestbook.add('alice', '1', 'history')
+    with pytest.raises(Bestbook.AwardConditionsError, match='already awarded a book for this topic'):
+        Bestbook.add('alice', '2', 'fiction')
+
+    assert Bestbook.update('alice', '1', 'history', 'Revised', 11) == award_id
+    assert Bestbook.get_awards(username='alice')[0]['topic'] == 'history'
+    assert Bestbook.remove('alice', topic='history') == 1
+    assert Bestbook.get_count() == 1
+
+
+def test_award_update_and_reference_changes(awards_db, monkeypatch):
+    Bestbook.add('alice', '1', 'fiction')
+    Bestbook.add('alice', '2', 'history')
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: False)
+    with pytest.raises(Bestbook.AwardConditionsError, match='Only books which have been marked as read'):
+        Bestbook.update('alice', '1', 'fiction')
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: True)
+    with pytest.raises(Bestbook.AwardConditionsError, match='already awarded a book for this topic'):
+        Bestbook.update('alice', '1', 'history')
+    assert Bestbook.get_awards(username='alice', work_id='1')[0]['topic'] == 'fiction'
+
+    assert Bestbook.update_username('alice', 'anonymous') == 2
+    assert Bestbook.get_count(username='anonymous') == 2
+    assert Bestbook.update_work_id('1', '3')['rows_changed'] == 1
+    assert Bestbook.get_count(work_id='3') == 1
+    assert Bestbook.remove('anonymous', work_id='3') == 1
+
+
+def test_work_award_helpers(monkeypatch):
+    work = models.Work(None, '/works/OL1W')
+    award = {'id': 5, 'username': 'alice', 'work_id': 1, 'topic': 'fiction'}
+    monkeypatch.setattr(
+        Bestbook, 'get_awards',
+        lambda **filters: [award] if filters.get('username') in (None, 'alice') else [],
+    )
+    assert work.get_awards() == [award]
+    assert work.check_if_user_awarded('alice')
+    assert not work.check_if_user_awarded('bob')
+    assert work.get_award_by_username('alice') == award
+
+
+def test_redirect_summary_includes_awards(monkeypatch):
+    chain = [
+        web.storage(key='/works/OL1W'),
+        web.storage(key='/works/OL2W'),
+    ]
+    monkeypatch.setattr(models.Work, 'get_redirect_chain', lambda key: chain)
+    for model, count_method in (
+        (models.Bookshelves, 'get_works_shelves'),
+        (models.Ratings, 'get_all_works_ratings'),
+        (models.Booknotes, 'get_booknotes_for_work'),
+        (models.Observations, 'get_observations_for_work'),
+    ):
+        monkeypatch.setattr(model, count_method, lambda key: [])
+        monkeypatch.setattr(
+            model, 'update_work_id',
+            lambda *args, **kwargs: {'rows_changed': 0, 'rows_deleted': 0, 'failed_deletes': 0},
+        )
+    monkeypatch.setattr(Bestbook, 'get_count', lambda **filters: 1 if filters['work_id'] == '1' else 0)
+    monkeypatch.setattr(
+        Bestbook, 'update_work_id',
+        lambda *args, **kwargs: {'rows_changed': 1, 'rows_deleted': 0, 'failed_deletes': 0},
+    )
+    summary = models.Work.resolve_redirect_chain('/works/OL1W')
+    assert summary['redirect_chain'][0]['occurrences']['bestbook'] == 1
+    assert summary['redirect_chain'][0]['updates']['bestbook']['rows_changed'] == 1
+    assert summary['modified']
