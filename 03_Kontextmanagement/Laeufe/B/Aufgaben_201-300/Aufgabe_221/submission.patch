+"""Best Book Award nominations stored in the Open Library database."""
+
+from sqlite3 import IntegrityError
+
+from psycopg2.errors import UniqueViolation
+
+from . import db
+from .bookshelves import Bookshelves
+
+
+class Bestbook(db.CommonExtras):
+    TABLENAME = 'bestbook_awards'
+    PRIMARY_KEY = ('username', 'work_id')
+    ALLOW_DELETE_ON_CONFLICT = True
+
+    class AwardConditionsError(ValueError):
+        """A nomination does not meet the award conditions."""
+
+    @classmethod
+    def get_awards(
+        cls, work_id: str | None = None, username: str | None = None,
+        topic: str | None = None,
+    ) -> list:
+        filters = []
+        values = {}
+        if work_id is not None:
+            filters.append('work_id=$work_id')
+            values['work_id'] = int(work_id)
+        if username is not None:
+            filters.append('username=$username')
+            values['username'] = username
+        if topic is not None:
+            filters.append('topic=$topic')
+            values['topic'] = topic
+        where = ' WHERE ' + ' AND '.join(filters) if filters else ''
+        return list(db.get_db().query(f'SELECT * FROM {cls.TABLENAME}{where}', vars=values))
+
+    @classmethod
+    def get_count(
+        cls, work_id: str | None = None, username: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        filters = []
+        values = {}
+        if work_id is not None:
+            filters.append('work_id=$work_id')
+            values['work_id'] = int(work_id)
+        if username is not None:
+            filters.append('username=$username')
+            values['username'] = username
+        if topic is not None:
+            filters.append('topic=$topic')
+            values['topic'] = topic
+        where = ' WHERE ' + ' AND '.join(filters) if filters else ''
+        result = db.get_db().query(
+            f'SELECT count(*) AS count FROM {cls.TABLENAME}{where}', vars=values
+        )
+        return result[0]['count']
+
+    @classmethod
+    def _check_conditions(cls, username: str, work_id: str, topic: str, updating=False):
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise cls.AwardConditionsError(
+                'Only books which have been marked as read may be given awards'
+            )
+        if not topic:
+            raise cls.AwardConditionsError('An award topic is required')
+        if not updating and cls.get_count(username=username, work_id=work_id):
+            raise cls.AwardConditionsError('You have already awarded this book')
+        for award in cls.get_awards(username=username, topic=topic):
+            if int(award['work_id']) != int(work_id):
+                raise cls.AwardConditionsError('You have already awarded a book for this topic')
+
+    @classmethod
+    def add(
+        cls, username: str, work_id: str, topic: str,
+        comment: str = '', edition_id: int | None = None,
+    ) -> int | None:
+        cls._check_conditions(username, work_id, topic)
+        try:
+            return db.get_db().insert(
+                cls.TABLENAME, username=username, work_id=int(work_id),
+                topic=topic, comment=comment, edition_id=edition_id,
+            )
+        except (UniqueViolation, IntegrityError) as exc:
+            raise cls.AwardConditionsError('You have already awarded this book or topic') from exc
+
+    @classmethod
+    def update(
+        cls, username: str, work_id: str, topic: str,
+        comment: str = '', edition_id: int | None = None,
+    ) -> int:
+        cls._check_conditions(username, work_id, topic, updating=True)
+        if not cls.get_count(username=username, work_id=work_id):
+            raise cls.AwardConditionsError('You have not awarded this book')
+        try:
+            db.get_db().update(
+                cls.TABLENAME, where='username=$username AND work_id=$work_id',
+                vars={'username': username, 'work_id': int(work_id)},
+                topic=topic, comment=comment, edition_id=edition_id,
+            )
+        except (UniqueViolation, IntegrityError) as exc:
+            raise cls.AwardConditionsError('You have already awarded a book for this topic') from exc
+        return cls.get_awards(username=username, work_id=work_id)[0]['id']
+
+    @classmethod
+    def remove(
+        cls, username: str, work_id: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        if work_id is None and topic is None:
+            raise ValueError('work_id or topic is required')
+        values = {'username': username}
+        where = 'username=$username'
+        if work_id is not None:
+            values['work_id'] = int(work_id)
+            where += ' AND work_id=$work_id'
+        if topic is not None:
+            values['topic'] = topic
+            where += ' AND topic=$topic'
+        return db.get_db().delete(cls.TABLENAME, where=where, vars=values)
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        rows = db.get_db().query(
+            f'SELECT work_id, count(*) AS count FROM {cls.TABLENAME} '
+            'GROUP BY work_id ORDER BY count DESC, work_id'
+        )
+        return [dict(row) for row in rows]
