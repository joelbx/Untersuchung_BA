+import json
+
+import web
+
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.core.bookshelves import Bookshelves
+from openlibrary.plugins.openlibrary import api
+
+
+def test_award_api_auth_and_operations(monkeypatch):
+    monkeypatch.setattr(api.web, 'header', lambda *args: None)
+    monkeypatch.setattr(api.accounts, 'get_current_user', lambda: None)
+    monkeypatch.setattr(api.web, 'input', lambda **defaults: web.storage(defaults))
+    endpoint = api.bestbook_award()
+    assert json.loads(endpoint.POST('1')) == {'errors': 'Authentication failed'}
+
+    monkeypatch.setattr(
+        api.accounts, 'get_current_user',
+        lambda: web.storage(key='/people/alice'),
+    )
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: False)
+    monkeypatch.setattr(
+        api.web, 'input',
+        lambda **defaults: web.storage({**defaults, 'op': 'add', 'topic': 'fiction'}),
+    )
+    assert json.loads(endpoint.POST('1')) == {
+        'errors': 'Only books which have been marked as read may be given awards'
+    }
+
+    monkeypatch.setattr(Bookshelves, 'user_has_read_work', lambda user, work: True)
+    monkeypatch.setattr(Bestbook, 'add', lambda **kwargs: 42)
+    assert json.loads(endpoint.POST('1')) == {'success': True, 'award': 42}
+
+    monkeypatch.setattr(
+        api.web, 'input',
+        lambda **defaults: web.storage({**defaults, 'op': 'update', 'topic': 'history'}),
+    )
+    monkeypatch.setattr(Bestbook, 'update', lambda **kwargs: 42)
+    assert json.loads(endpoint.POST('1')) == {'success': True, 'award': 42}
+
+    monkeypatch.setattr(
+        api.web, 'input',
+        lambda **defaults: web.storage({**defaults, 'op': 'remove'}),
+    )
+    monkeypatch.setattr(Bestbook, 'remove', lambda **kwargs: 1)
+    assert json.loads(endpoint.POST('1')) == {'success': True, 'rows': 1}
+
+
+def test_award_count_api(monkeypatch):
+    monkeypatch.setattr(api.web, 'header', lambda *args: None)
+    monkeypatch.setattr(
+        api.web, 'input',
+        lambda **defaults: web.storage({**defaults, 'work_id': '1', 'topic': 'fiction'}),
+    )
+    monkeypatch.setattr(Bestbook, 'get_count', lambda **kwargs: 7)
+    assert json.loads(api.bestbook_count().GET()) == {'count': 7}
