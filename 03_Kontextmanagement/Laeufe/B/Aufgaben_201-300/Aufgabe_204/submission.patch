+/**
+ * Parse an ISO date or a date format supported by JavaScript's standard parser.
+ * Parsing ISO dates first keeps date-only values in the local calendar day.
+ */
+export const guessDateFromText = (text: string): Date | undefined => {
+    const isoDate = parseISO(text);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+
+    const date = new Date(text);
+    return isValid(date) ? date : undefined;
+};
