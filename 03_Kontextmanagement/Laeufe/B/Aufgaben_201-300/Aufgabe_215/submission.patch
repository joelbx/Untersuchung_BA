diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..f4f061e
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,127 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeTestConfig(t *testing.T, body string) string {
+	t.Helper()
+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if _, err := f.WriteString(body); err != nil {
+		t.Fatal(err)
+	}
+	return f.Name()
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("unexpected scheme strings")
+	}
+	cfg, err := configure("../../config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("default config differs: %+v", cfg)
+	}
+
+	path := writeTestConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	defer os.Remove(path)
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server.Host != "127.0.0.1" || cfg.Server.HTTPPort != 8081 || cfg.Server.HTTPSPort != 8080 || cfg.Server.GRPCPort != 9001 || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("unexpected config: %+v", cfg)
+	}
+
+	listPath := writeTestConfig(t, "cors:\n  enabled: true\n  allowed_origins: [foo.com]\n")
+	defer os.Remove(listPath)
+	listCfg, err := configure(listPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg.Cors.AllowedOrigins, listCfg.Cors.AllowedOrigins) {
+		t.Fatalf("string and list origins differ: %v / %v", cfg.Cors.AllowedOrigins, listCfg.Cors.AllowedOrigins)
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	envCfg, err := configure(path)
+	if err != nil || envCfg.Server.HTTPPort != 8181 {
+		t.Fatalf("environment override: cfg=%+v err=%v", envCfg, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	if err := cfg.validate(); err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("missing cert: %v", err)
+	}
+	cfg.Server.CertFile = "missing-cert.pem"
+	if err := cfg.validate(); err == nil || err.Error() != "cert_key cannot be empty when using HTTPS" {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg.Server.CertKey = "missing-key.pem"
+	if err := cfg.validate(); err == nil || err.Error() != "cannot find TLS cert_file at \"missing-cert.pem\"" {
+		t.Fatalf("missing cert file: %v", err)
+	}
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cfg.Server.CertFile = filepath.Join(dir, "cert.pem")
+	if err := ioutil.WriteFile(cfg.Server.CertFile, []byte("test"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := cfg.validate(); err == nil || err.Error() != "cannot find TLS cert_key at \"missing-key.pem\"" {
+		t.Fatalf("missing key file: %v", err)
+	}
+	cfg.Server.CertKey = filepath.Join(dir, "key.pem")
+	if err := ioutil.WriteFile(cfg.Server.CertKey, []byte("test"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	path := writeTestConfig(t, "server:\n  protocol: https\n  cert_file: "+cfg.Server.CertFile+"\n  cert_key: "+cfg.Server.CertKey+"\n")
+	defer os.Remove(path)
+	loaded, err := configure(path)
+	if err != nil || loaded.Server.Protocol != HTTPS || loaded.Server.CertFile != cfg.Server.CertFile || loaded.Server.CertKey != cfg.Server.CertKey {
+		t.Fatalf("https config: cfg=%+v err=%v", loaded, err)
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatalf("http validation: %v", err)
+	}
+
+	missingPath := writeTestConfig(t, "server:\n  protocol: https\n")
+	defer os.Remove(missingPath)
+	if _, err := configure(missingPath); err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("configure validation error: %v", err)
+	}
+}
+
+func TestConfigAndInfoHandlers(t *testing.T) {
+	for _, handler := range []interface {
+		ServeHTTP(http.ResponseWriter, *http.Request)
+	}{defaultConfig(), info{Version: "test"}} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest("GET", "/", nil))
+		if recorder.Code != 200 || strings.TrimSpace(recorder.Body.String()) == "" {
+			t.Fatalf("response: status=%d body=%q", recorder.Code, recorder.Body.String())
+		}
+	}
+}
