+
+// convertKEVulns maps both go-kev sources into the public vulnerability model.
+func convertKEVulns(source []kevulnmodels.KEVuln) ([]models.KEV, error) {
+	data, err := json.Marshal(source)
+	if err != nil {
+		return nil, err
+	}
+	return convertKEVulnJSON(data)
+}
+
+func convertKEVulnJSON(data []byte) ([]models.KEV, error) {
+	var source []map[string]interface{}
+	if err := json.Unmarshal(data, &source); err != nil {
+		return nil, err
+	}
+	var result []models.KEV
+	for _, record := range source {
+		// Older go-kev records are flat CISA entries. Newer records can
+		// contain separate CISA and VulnCheck lists.
+		if kevString(record, "vendorProject", "vulnerabilityName", "product", "shortDescription") != "" {
+			kind := models.CISAKEVType
+			if strings.EqualFold(kevString(record, "type"), string(models.VulnCheckKEVType)) {
+				kind = models.VulnCheckKEVType
+			}
+			result = append(result, sourceKEV(record, kind))
+		}
+		for _, entry := range kevEntries(kevField(record, "cisa")) {
+			result = append(result, sourceKEV(entry, models.CISAKEVType))
+		}
+		for _, entry := range kevEntries(kevField(record, "vulnCheck")) {
+			result = append(result, sourceKEV(entry, models.VulnCheckKEVType))
+		}
+	}
+	return result, nil
+}
+
+func sourceKEV(entry map[string]interface{}, kind models.KEVType) models.KEV {
+	kev := commonKEV(entry, kind)
+	if kind == models.CISAKEVType {
+		kev.CISA = &models.CISAKEV{Note: kevString(entry, "notes", "note")}
+		return kev
+	}
+	details := &models.VulnCheckKEV{}
+	for _, xdb := range kevEntries(kevField(entry, "xdb", "xdbs")) {
+		details.XDB = append(details.XDB, models.VulnCheckXDB{
+			XDBID:       kevString(xdb, "xdbID", "id"),
+			XDBURL:      kevString(xdb, "xdbURL", "url"),
+			DateAdded:   kevDate(xdb, "dateAdded"),
+			ExploitType: kevString(xdb, "exploitType"),
+			CloneSSHURL: kevString(xdb, "cloneSSHURL"),
+		})
+	}
+	for _, report := range kevEntries(kevField(entry, "reportedExploitation")) {
+		details.ReportedExploitation = append(details.ReportedExploitation, models.VulnCheckReportedExploitation{
+			URL:       kevString(report, "url"),
+			DateAdded: kevDate(report, "dateAdded"),
+		})
+	}
+	kev.VulnCheck = details
+	return kev
+}
+
+func commonKEV(entry map[string]interface{}, source models.KEVType) models.KEV {
+	kev := models.KEV{
+		Type:                       source,
+		VendorProject:              kevString(entry, "vendorProject", "vendor"),
+		Product:                    kevString(entry, "product"),
+		VulnerabilityName:          kevString(entry, "vulnerabilityName"),
+		ShortDescription:           kevString(entry, "shortDescription"),
+		RequiredAction:             kevString(entry, "requiredAction"),
+		KnownRansomwareCampaignUse: kevString(entry, "knownRansomwareCampaignUse"),
+		DateAdded:                  kevDate(entry, "dateAdded"),
+	}
+	if due := kevDate(entry, "dueDate"); !due.IsZero() {
+		kev.DueDate = &due
+	}
+	return kev
+}
+
+func kevEntries(value interface{}) []map[string]interface{} {
+	var entries []map[string]interface{}
+	switch v := value.(type) {
+	case []interface{}:
+		for _, item := range v {
+			if entry, ok := item.(map[string]interface{}); ok {
+				entries = append(entries, entry)
+			}
+		}
+	case map[string]interface{}:
+		entries = append(entries, v)
+	}
+	return entries
+}
+
+func kevField(entry map[string]interface{}, names ...string) interface{} {
+	for _, name := range names {
+		for key, value := range entry {
+			if strings.EqualFold(strings.ReplaceAll(key, "_", ""), name) {
+				return value
+			}
+		}
+	}
+	return nil
+}
+
+func kevString(entry map[string]interface{}, names ...string) string {
+	value, _ := kevField(entry, names...).(string)
+	return value
+}
+
+func kevDate(entry map[string]interface{}, names ...string) time.Time {
+	value := kevString(entry, names...)
+	for _, layout := range []string{time.RFC3339Nano, "2006-01-02"} {
+		if date, err := time.Parse(layout, value); err == nil {
+			return date
+		}
+	}
+	return time.Time{}
+}
diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..e2681b5
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,46 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestConvertKEVulns(t *testing.T) {
+	const fixture = `[{"cisa":[{"vendorProject":"Example","product":"Widget","vulnerabilityName":"CISA entry","shortDescription":"CISA description","requiredAction":"Patch","knownRansomwareCampaignUse":"Known","dateAdded":"2024-01-02T00:00:00Z","dueDate":"0001-01-01T00:00:00Z","notes":"CISA note"}],"vulnCheck":[{"vendorProject":"Vendor","product":"Tool","vulnerabilityName":"VulnCheck entry","shortDescription":"VulnCheck description","requiredAction":"Update","knownRansomwareCampaignUse":"Unknown","dateAdded":"2024-02-03T00:00:00Z","dueDate":"2024-03-04T00:00:00Z","xdb":[{"xdbID":"XDB-1","xdbURL":"https://example.test/xdb","dateAdded":"2024-02-04T00:00:00Z","exploitType":"poc","cloneSSHURL":"git@example.test:xdb"}],"reportedExploitation":[{"url":"https://example.test/report","dateAdded":"2024-02-05T00:00:00Z"}]}]}]`
+	got, err := convertKEVulnJSON([]byte(fixture))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("got %d KEVs, want 2", len(got))
+	}
+	if got[0].Type != models.CISAKEVType || got[0].VendorProject != "Example" || got[0].DueDate != nil || got[0].CISA == nil || got[0].CISA.Note != "CISA note" {
+		t.Fatalf("CISA mapping: %+v", got[0])
+	}
+	if got[1].Type != models.VulnCheckKEVType || got[1].VendorProject != "Vendor" || got[1].DueDate == nil || got[1].VulnCheck == nil {
+		t.Fatalf("VulnCheck mapping: %+v", got[1])
+	}
+	if len(got[1].VulnCheck.XDB) != 1 || got[1].VulnCheck.XDB[0].XDBID != "XDB-1" || len(got[1].VulnCheck.ReportedExploitation) != 1 || got[1].VulnCheck.ReportedExploitation[0].URL != "https://example.test/report" {
+		t.Fatalf("VulnCheck details: %+v", got[1].VulnCheck)
+	}
+}
+
+func TestConvertFlatGoKEVuln(t *testing.T) {
+	var source []kevulnmodels.KEVuln
+	const fixture = `[{"cveID":"CVE-2024-1","vendorProject":"Example","product":"Widget","vulnerabilityName":"Flat CISA","dateAdded":"2024-01-02T00:00:00Z","dueDate":"0001-01-01T00:00:00Z","notes":"Legacy note"}]`
+	if err := json.Unmarshal([]byte(fixture), &source); err != nil {
+		t.Fatal(err)
+	}
+	got, err := convertKEVulns(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Type != models.CISAKEVType || got[0].CISA == nil || got[0].CISA.Note != "Legacy note" || got[0].DueDate != nil {
+		t.Fatalf("flat CISA mapping: %+v", got)
+	}
+}
