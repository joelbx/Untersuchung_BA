+
+
+@pytest.mark.parametrize('level, source, msg, shown', [
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Refused to apply inline style because of CSP', False),
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Unexpected script failure', True),
+    (usertypes.JsLogLevel.warning, 'userscript:_qute_stylesheet',
+     'Unexpected script failure', False),
+    (usertypes.JsLogLevel.error, 'qute:internal',
+     'Refused to apply inline style because of CSP', True),
+    (usertypes.JsLogLevel.error, 'website:example',
+     'Unexpected script failure', False),
+])
+def test_js_log_to_ui(config_stub, monkeypatch, level, source, msg, shown):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error'], 'qute:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:_qute_*': ['Refused to apply inline style*']}
+    displayed = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, usertypes.JsLogLevel.error,
+                        displayed.append)
+
+    assert shared._js_log_to_ui(level, source, 66, msg) is shown
+    assert displayed == ([f'JS: [{source}:66] {msg}'] if shown else [])
+
+
+def test_javascript_log_message_fallback(config_stub, monkeypatch):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:*': ['Refused to apply inline style*']}
+    displayed = []
+    logged = []
+    monkeypatch.setitem(shared._JS_LOGMAP_MESSAGE, usertypes.JsLogLevel.error,
+                        displayed.append)
+    monkeypatch.setitem(shared._JS_LOGMAP, 'debug', logged.append)
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:_qute_stylesheet', 66,
+                                  'Unexpected script failure')
+    assert displayed == ['JS: [userscript:_qute_stylesheet:66] '
+                         'Unexpected script failure']
+    assert logged == []
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:_qute_stylesheet', 66,
+                                  'Refused to apply inline style because of CSP')
