 }
 
 
+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Show a JavaScript log message in the UI if configured to do so."""
+    levels_config = config.cache['content.javascript.log_message.levels'] or {}
+    excludes = config.cache['content.javascript.log_message.excludes'] or {}
+
+    for pattern, levels in levels_config.items():
+        if not fnmatch.fnmatchcase(source, pattern) or level.name not in levels:
+            continue
+
+        for source_pattern, messages in excludes.items():
+            if fnmatch.fnmatchcase(source, source_pattern):
+                if any(fnmatch.fnmatchcase(msg, message_pattern)
+                       for message_pattern in messages):
+                    return False
+
+        _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+        return True
+
+    return False
+
