+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", "/tmp/bundles").
+		WithExec([]string{"/flipt", "bundle", "build", "testrepo:latest"}).
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", "flipt://local/testrepo:latest").
