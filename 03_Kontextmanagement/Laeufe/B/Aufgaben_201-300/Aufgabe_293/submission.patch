+// DefaultBundleDir returns the default directory for locally stored OCI bundles.
+func DefaultBundleDir() (string, error) {
+	root, err := defaultDatabaseRoot()
+	if err != nil {
+		return "", fmt.Errorf("getting data directory: %w", err)
+	}
+	dir := filepath.Join(root, "flipt", "bundles")
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return "", fmt.Errorf("creating OCI bundles directory: %w", err)
+	}
+	return dir, nil
+}
