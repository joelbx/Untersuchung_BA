+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.modules.storage.netapp.netapp_e_drive_firmware import NetAppESeriesDriveFirmware
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+from units.compat import mock
+
+
+class DriveFirmwareTests(ModuleTestCase):
+    def make_module(self, **options):
+        args = dict(api_url='https://array.example/devmgr/v2', api_username='admin',
+                    api_password='password', ssid='1', firmware=['/tmp/target.dlp'])
+        args.update(options)
+        set_module_args(args)
+        return NetAppESeriesDriveFirmware()
+
+    def test_upgrade_list_filters_version_health_and_unrelated_firmware(self):
+        firmware = self.make_module(ignore_inaccessible_drives=True)
+        compatibility = [dict(filename='target.dlp', firmwareVersion='2',
+                              driveRefList=['new', 'current', 'offline']),
+                         dict(filename='other.dlp', firmwareVersion='9', driveRefList=['other'])]
+        drives = {'new': dict(status='optimal', firmwareVersion='1'),
+                  'current': dict(status='optimal', firmwareVersion='2'),
+                  'offline': dict(status='offline', firmwareVersion='1')}
+
+        def response(path, **kwargs):
+            if path.endswith('/firmware/drives'):
+                return 200, compatibility
+            return 200, drives[path.rsplit('/', 1)[-1]]
+
+        with mock.patch.object(firmware, 'request', side_effect=response) as request:
+            self.assertEqual(firmware.upgrade_list(), [dict(filename='target.dlp', driveRefList=['new'])])
+            self.assertEqual(firmware.upgrade_list(), [dict(filename='target.dlp', driveRefList=['new'])])
+            self.assertEqual(request.call_count, 4)
+
+    def test_inaccessible_drive_fails_by_default(self):
+        firmware = self.make_module()
+        with mock.patch.object(firmware, 'request', side_effect=[
+                (200, [dict(filename='target.dlp', firmwareVersion='2', driveRefList=['bad'])]),
+                (200, dict(status='unavailable', firmwareVersion='1'))]):
+            with self.assertRaises(AnsibleFailJson) as error:
+                firmware.upgrade_list()
+        self.assertIn('Inaccessible drive', error.exception.args[0]['msg'])
+
+    def test_online_capability_fails(self):
+        firmware = self.make_module()
+        with mock.patch.object(firmware, 'request', side_effect=[
+                (200, [dict(filename='target.dlp', firmwareVersion='2', driveRefList=['drive'],
+                            onlineUpgradeCapable=False)]),
+                (200, dict(status='optimal', firmwareVersion='1'))]):
+            with self.assertRaises(AnsibleFailJson) as error:
+                firmware.upgrade_list()
+        self.assertIn('Drive is not capable of online upgrade.', error.exception.args[0]['msg'])
+
+    def test_check_mode_reports_change_without_initiating_upgrade(self):
+        firmware = self.make_module(_ansible_check_mode=True)
+        with mock.patch.object(firmware, 'upload_firmware'), mock.patch.object(
+                firmware, 'upgrade_list', return_value=[dict(filename='target.dlp', driveRefList=['drive'])]), mock.patch.object(
+                firmware, 'upgrade') as upgrade:
+            with self.assertRaises(AnsibleExitJson) as result:
+                firmware.apply()
+        self.assertEqual(result.exception.args[0]['changed'], True)
+        self.assertEqual(result.exception.args[0]['upgrade_in_process'], False)
+        upgrade.assert_not_called()
+
+    def test_upgrade_waits_for_only_selected_drives(self):
+        firmware = self.make_module(wait_for_completion=True)
+        firmware.upgrade_drives = [dict(filename='target.dlp', driveRefList=['drive'])]
+        responses = [(202, {}),
+                     (200, [dict(driveRef='other', status='failed'), dict(driveRef='drive', status='pending')]),
+                     (200, [dict(driveRef='drive', status='okay')])]
+        with mock.patch.object(firmware, 'request', side_effect=responses) as request:
+            firmware.upgrade()
+        self.assertFalse(firmware.upgrade_in_progress)
+        self.assertEqual(request.call_args_list[0][1]['data']['onlineUpgrade'], True)
+        self.assertEqual(request.call_count, 3)
+
+    def test_upload_failure_identifies_file_and_array(self):
+        firmware = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.create_multipart_formdata',
+                        side_effect=IOError('missing file')):
+            with self.assertRaises(AnsibleFailJson) as error:
+                firmware.upload_firmware()
+        message = error.exception.args[0]['msg']
+        self.assertIn('Failed to upload drive firmware', message)
+        self.assertIn('target.dlp', message)
+        self.assertIn('array [1]', message)
+
+    def test_upload_posts_multipart_to_array(self):
+        firmware = self.make_module()
+        with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.create_multipart_formdata',
+                        return_value=({'Content-Type': 'multipart/form-data'}, b'firmware')) as multipart:
+            with mock.patch('ansible.modules.storage.netapp.netapp_e_drive_firmware.request',
+                            return_value=(200, {})) as post:
+                firmware.upload_firmware()
+        multipart.assert_called_once_with([('file', 'target.dlp', '/tmp/target.dlp')])
+        self.assertTrue(post.call_args[0][0].endswith('/storage-systems/1/files/drive'))
+        self.assertEqual(post.call_args[1]['method'], 'POST')
+        self.assertEqual(post.call_args[1]['data'], b'firmware')
+
+    def test_wait_fails_on_targeted_drive_error(self):
+        firmware = self.make_module()
+        firmware.upgrade_drives = [dict(filename='target.dlp', driveRefList=['drive'])]
+        with mock.patch.object(firmware, 'request', return_value=(200, [dict(driveRef='drive', status='failed')])):
+            with self.assertRaises(AnsibleFailJson) as error:
+                firmware.wait_for_upgrade_completion()
+        self.assertIn('Drive firmware upgrade failed.', error.exception.args[0]['msg'])
+
+    def test_wait_times_out_when_selected_drive_is_missing(self):
+        firmware = self.make_module()
+        firmware.upgrade_drives = [dict(filename='target.dlp', driveRefList=['drive'])]
+        firmware.WAIT_TIMEOUT_SEC = 0
+        with mock.patch.object(firmware, 'request', return_value=(200, [dict(driveRef='other', status='okay')])):
+            with self.assertRaises(AnsibleFailJson) as error:
+                firmware.wait_for_upgrade_completion()
+        self.assertIn('Timed out waiting for drive firmware upgrade.', error.exception.args[0]['msg'])
+
+    def test_no_upgrade_is_idempotent(self):
+        firmware = self.make_module()
+        with mock.patch.object(firmware, 'upload_firmware'), mock.patch.object(
+                firmware, 'upgrade_list', return_value=[]), mock.patch.object(firmware, 'upgrade') as upgrade:
+            with self.assertRaises(AnsibleExitJson) as result:
+                firmware.apply()
+        self.assertFalse(result.exception.args[0]['changed'])
+        self.assertFalse(result.exception.args[0]['upgrade_in_process'])
+        upgrade.assert_not_called()
