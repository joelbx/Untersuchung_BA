+
+func TestCheckerTokenEvents(t *testing.T) {
+	testCases := []struct {
+		name           string
+		events         []string
+		createdEnabled bool
+		deletedEnabled bool
+	}{
+		{name: "token creation", events: []string{"token:created"}, createdEnabled: true},
+		{name: "token deletion", events: []string{"token:deleted"}, deletedEnabled: true},
+		{name: "token wildcard", events: []string{"token:*"}, createdEnabled: true, deletedEnabled: true},
+		{name: "deletion wildcard", events: []string{"*:deleted"}, deletedEnabled: true},
+		{name: "all events", events: []string{"*:*"}, createdEnabled: true, deletedEnabled: true},
+		{name: "other event", events: []string{"flag:deleted"}},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			checker, err := NewChecker(tc.events)
+			assert.NoError(t, err)
+			assert.Equal(t, tc.createdEnabled, checker.Check("token:created"))
+			assert.Equal(t, tc.deletedEnabled, checker.Check("token:deleted"))
+		})
+	}
+}
