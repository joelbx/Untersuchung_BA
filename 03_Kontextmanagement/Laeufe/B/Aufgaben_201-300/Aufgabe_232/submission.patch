@@ -0,0 +1,58 @@
+package scan
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestEOLWarnings(t *testing.T) {
+	date := func(value string) time.Time {
+		result, err := time.Parse("2006-01-02", value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return result
+	}
+	tests := []struct {
+		family, release string
+		now             time.Time
+		want            []string
+	}{
+		{config.Ubuntu, "14.10", date("2015-07-31"), []string{
+			"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+			"Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.",
+		}},
+		{config.Amazon, "2018.03", date("2023-07-01"), []string{
+			"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+			"Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.",
+		}},
+		{config.Amazon, "2 (Karoo)", date("2025-06-01"), []string{
+			"Standard OS support will be end in 3 months. EOL date: 2025-06-30",
+		}},
+		{config.Ubuntu, "14.04", date("2020-01-01"), []string{
+			"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+			"Extended support available until 2024-04-30. Check the vendor site.",
+		}},
+		{config.FreeBSD, "11.4-RELEASE", date("2021-06-30"), []string{
+			"Standard OS support will be end in 3 months. EOL date: 2021-09-30",
+		}},
+		{config.FreeBSD, "11.4-RELEASE", date("2021-06-29"), nil},
+		{config.Debian, "10.9", date("2024-07-01"), []string{
+			"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended.",
+		}},
+		{config.RedHat, "9", date("2024-01-01"), []string{
+			"Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: redhat Release: 9'",
+		}},
+		{config.Raspbian, "10", date("2024-01-01"), nil},
+		{config.ServerTypePseudo, "", date("2024-01-01"), nil},
+	}
+	for _, tt := range tests {
+		got := eolWarnings(tt.family, tt.release, tt.now)
+		if !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("%s %s at %s: got %q, want %q", tt.family, tt.release, tt.now, got, tt.want)
+		}
+	}
+}
