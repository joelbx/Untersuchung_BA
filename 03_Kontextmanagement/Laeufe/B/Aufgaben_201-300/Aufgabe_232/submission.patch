new file mode 100644
index 0000000..3d60849
--- /dev/null
+++ b/config/os.go
@@ -0,0 +1,129 @@
+package config
+
+import (
+	"strings"
+	"time"
+)
+
+// OS family identifiers used throughout scanning and lifecycle lookup.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// Major removes an optional epoch and returns the part before the first dot.
+// Kept here so config.Distro can share the parser without importing util.
+func Major(version string) string {
+	if i := strings.IndexByte(version, ':'); i >= 0 {
+		version = version[i+1:]
+	}
+	if i := strings.IndexByte(version, '.'); i >= 0 {
+		version = version[:i]
+	}
+	return version
+}
+
+// EOL describes the end of standard and optional extended OS support.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support is past its end date.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether applicable extended support has ended.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+// IsExtendedSupportEnded is the correctly spelled alias.
+func (e EOL) IsExtendedSupportEnded(now time.Time) bool {
+	return e.IsExtendedSuppportEnded(now)
+}
+
+func eol(standard, extended string) EOL {
+	parse := func(value string) time.Time {
+		if value == "" {
+			return time.Time{}
+		}
+		date, err := time.Parse("2006-01-02", value)
+		if err != nil {
+			panic(err)
+		}
+		return date
+	}
+	return EOL{StandardSupportUntil: parse(standard), ExtendedSupportUntil: parse(extended)}
+}
+
+var eolByFamily = map[string]map[string]EOL{
+	Amazon: {
+		"2018.03":   eol("2023-06-30", "2023-06-30"),
+		"2 (Karoo)": eol("2025-06-30", ""),
+	},
+	RedHat: {
+		"7": eol("2024-06-30", ""),
+		"8": eol("2029-05-31", ""),
+		"6": eol("2020-11-30", "2024-06-30"),
+	},
+	CentOS: {
+		"7": eol("2024-06-30", ""),
+		"8": eol("2021-12-31", ""),
+		"6": eol("2020-11-30", "2020-11-30"),
+	},
+	Oracle: {
+		"7": eol("2024-06-30", ""),
+		"8": eol("2029-05-31", ""),
+		"6": eol("2021-03-31", "2022-03-31"),
+	},
+	Ubuntu: {
+		"18.04": eol("2023-05-31", "2028-04-30"),
+		"14.04": eol("2019-04-30", "2024-04-30"),
+		"14.10": eol("2015-07-30", "2015-07-30"),
+		"21.04": eol("2022-01-30", ""),
+	},
+	Debian: {
+		"9":  eol("2022-06-30", ""),
+		"10": eol("2024-06-30", ""),
+		"8":  eol("2020-06-30", "2020-06-30"),
+	},
+	Alpine: {
+		"3.10": eol("2021-05-30", ""),
+		"3.11": eol("2021-11-30", ""),
+		"3.12": eol("2022-05-30", ""),
+		"3.9":  eol("2020-11-30", "2020-11-30"),
+	},
+	FreeBSD: {
+		"11": eol("2021-09-30", "2021-09-30"),
+		"12": eol("2023-12-31", ""),
+		"10": eol("2019-10-30", "2019-10-30"),
+	},
+}
+
+// GetEOL returns lifecycle data only for explicitly modeled family and release pairs.
+func GetEOL(family string, release string) (EOL, bool) {
+	releases, ok := eolByFamily[family]
+	if !ok {
+		return EOL{}, false
+	}
+	info, ok := releases[release]
+	return info, ok
+}
