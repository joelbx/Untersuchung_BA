diff --git a/scan/eol.go b/scan/eol.go
new file mode 100644
index 0000000..960f965
--- /dev/null
+++ b/scan/eol.go
@@ -0,0 +1,58 @@
+package scan
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/util"
+)
+
+const eolDateFormat = "2006-01-02"
+
+// eolRelease converts detected patch releases to the identifiers in the
+// lifecycle table. GetEOL itself remains an exact family/release lookup.
+func eolRelease(family, release string) string {
+	switch family {
+	case config.RedHat, config.CentOS, config.Oracle, config.Debian:
+		return util.Major(release)
+	case config.FreeBSD:
+		return util.Major(strings.SplitN(release, "-", 2)[0])
+	case config.Ubuntu, config.Alpine:
+		parts := strings.Split(release, ".")
+		if len(parts) >= 2 {
+			return strings.Join(parts[:2], ".")
+		}
+	}
+	return release
+}
+
+// eolWarnings evaluates one target at the scan's supplied time, in display order.
+func eolWarnings(family, release string, now time.Time) []string {
+	if family == config.ServerTypePseudo || family == config.Raspbian {
+		return nil
+	}
+
+	info, found := config.GetEOL(family, eolRelease(family, release))
+	if !found {
+		return []string{fmt.Sprintf("Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: %s Release: %s'", family, release)}
+	}
+
+	if info.IsStandardSupportEnded(now) {
+		warnings := []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended."}
+		if !info.ExtendedSupportUntil.IsZero() {
+			if info.IsExtendedSuppportEnded(now) {
+				warnings = append(warnings, "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.")
+			} else {
+				warnings = append(warnings, fmt.Sprintf("Extended support available until %s. Check the vendor site.", info.ExtendedSupportUntil.Format(eolDateFormat)))
+			}
+		}
+		return warnings
+	}
+
+	if !now.AddDate(0, 3, 0).Before(info.StandardSupportUntil) {
+		return []string{fmt.Sprintf("Standard OS support will be end in 3 months. EOL date: %s", info.StandardSupportUntil.Format(eolDateFormat))}
+	}
+	return nil
+}
