diff --git a/src/database/bulkIncrement.js b/src/database/bulkIncrement.js
new file mode 100644
index 0000000..372a755
--- /dev/null
+++ b/src/database/bulkIncrement.js
@@ -0,0 +1,28 @@
+'use strict';
+
+module.exports = function (data, fieldToString) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	return data.map((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must be [key, increments] tuples');
+		}
+		const increments = Object.create(null);
+		for (const [field, value] of Object.entries(item[1])) {
+			const normalized = fieldToString(field);
+			if (!field || field === '__proto__' || field === 'constructor' || field === 'prototype' ||
+				field === '_key' || field === '_id' || /[.$]/.test(field) ||
+				!normalized || /[.$]/.test(normalized)) {
+				throw new TypeError(`Invalid bulk increment field: ${field}`);
+			}
+			if (!Number.isSafeInteger(value)) {
+				throw new TypeError(`Bulk increment for ${field} must be a safe integer`);
+			}
+			increments[normalized] = value;
+		}
+		return [item[0], increments];
+	});
+};
