@@ -261,4 +262,32 @@ module.exports = function (module) {
 			throw err;
 		}
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const items = normalizeBulkIncrements(data, helpers.fieldToString)
+			.filter(([, increments]) => Object.keys(increments).length);
+		if (!items.length) {
+			return;
+		}
+
+		const collection = module.client.collection('objects');
+		const results = await Promise.allSettled(items.map(async ([key, increments]) => {
+			try {
+				await collection.updateOne({ _key: key }, { $inc: increments }, { upsert: true });
+			} catch (err) {
+				if (!err || !err.message || !err.message.startsWith('E11000 duplicate key error')) {
+					throw err;
+				}
+				await collection.updateOne({ _key: key }, { $inc: increments }, { upsert: true });
+			}
+		}));
+		const succeeded = items.filter((item, index) => results[index].status === 'fulfilled').map(item => item[0]);
+		if (succeeded.length) {
+			cache.del(succeeded);
+		}
+		const failed = results.find(result => result.status === 'rejected');
+		if (failed) {
+			throw failed.reason;
+		}
+	};
 };
diff --git a/src/database/redis/hash.js b/src/database/redis/hash.js
index 1afdccd..f9088cf 100644
--- a/src/database/redis/hash.js
+++ b/src/database/redis/hash.js
@@ -2,6 +2,26 @@
 
 module.exports = function (module) {
 	const helpers = require('./helpers');
+	const normalizeBulkIncrements = require('../bulkIncrement');
+	const bulkIncrementScript = `
+local maximum = 9007199254740991
+for index = 1, #ARGV, 2 do
+	local previous = redis.call('HGET', KEYS[1], ARGV[index])
+	if previous then
+		if not string.match(previous, '^%-?%d+$') then
+			return redis.error_reply('field is not an integer: ' .. ARGV[index])
+		end
+		local current = tonumber(previous)
+		local updated = current + tonumber(ARGV[index + 1])
+		if math.abs(current) > maximum or math.abs(updated) > maximum then
+			return redis.error_reply('increment exceeds safe integer range: ' .. ARGV[index])
+		end
+	end
+end
+for index = 1, #ARGV, 2 do
+	redis.call('HINCRBY', KEYS[1], ARGV[index], ARGV[index + 1])
+end
+return 1`;
 
 	const cache = require('../cache').create('redis');
 
@@ -219,4 +239,27 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		const items = normalizeBulkIncrements(data, String)
+			.filter(([, increments]) => Object.keys(increments).length);
+		if (!items.length) {
+			return;
+		}
+
+		const batch = module.client.batch();
+		items.forEach(([key, increments]) => {
+			const args = Object.entries(increments).flatMap(([field, value]) => [field, String(value)]);
+			batch.eval(bulkIncrementScript, 1, key, ...args);
+		});
+		const results = await batch.exec();
+		const succeeded = items.filter((item, index) => !results[index][0]).map(item => item[0]);
+		if (succeeded.length) {
+			cache.del(succeeded);
+		}
+		const failed = results.find(([err]) => err);
+		if (failed) {
+			throw failed[0];
+		}
+	};
 };
