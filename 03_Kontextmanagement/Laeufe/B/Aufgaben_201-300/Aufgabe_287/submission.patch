diff --git a/scanner/image_files_test.go b/scanner/image_files_test.go
new file mode 100644
index 0000000..df00ce4
--- /dev/null
+++ b/scanner/image_files_test.go
@@ -0,0 +1,51 @@
+package scanner
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestAlbumImageFilesFromScannedDirectories(t *testing.T) {
+	root := t.TempDir()
+	first := filepath.Join(root, "disc1")
+	second := filepath.Join(root, "disc2")
+	for _, dir := range []string{first, second} {
+		if err := os.Mkdir(dir, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, name := range []string{filepath.Join(first, "back.png"), filepath.Join(first, "front.jpg"), filepath.Join(second, "cover.jpg")} {
+		if err := os.WriteFile(name, nil, 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	dirs := dirMap{}
+	for _, dir := range []string{first, second} {
+		_, stats, err := loadDir(context.Background(), dir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !stats.HasImages {
+			t.Fatalf("expected images in %s", dir)
+		}
+		dirs[dir] = *stats
+	}
+	mfs := model.MediaFiles{
+		{Path: filepath.Join(second, "b.mp3")},
+		{Path: filepath.Join(first, "a.mp3")},
+		{Path: filepath.Join(first, "c.mp3")},
+	}
+	want := strings.Join([]string{
+		filepath.Join(first, "back.png"),
+		filepath.Join(first, "front.jpg"),
+		filepath.Join(second, "cover.jpg"),
+	}, string(filepath.ListSeparator))
+	if got := imageFilesForAlbum(mfs, dirs); got != want {
+		t.Fatalf("imageFilesForAlbum() = %q, want %q", got, want)
+	}
+}
