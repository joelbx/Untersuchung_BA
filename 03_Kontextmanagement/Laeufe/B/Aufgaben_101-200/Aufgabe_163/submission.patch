+		{"missing host", DatabaseConfig{Protocol: DatabaseProtocolMySQL, Name: "flipt"}, "", "db.host"},
+		{"invalid port", DatabaseConfig{Protocol: DatabaseProtocolPostgres, Host: "localhost", Name: "flipt", Port: 70000}, "", "db.port"},
