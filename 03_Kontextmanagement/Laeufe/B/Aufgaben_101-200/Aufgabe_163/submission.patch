+		{"mysql port", DatabaseConfig{Protocol: DatabaseProtocolMySQL, Host: "localhost", Port: 3307, Name: "flipt"}, "mysql://localhost:3307/flipt", ""},
+		{"sqlite path", DatabaseConfig{Protocol: DatabaseProtocolSQLite, Path: "/tmp", Name: "flipt.db"}, "file:/tmp/flipt.db", ""},
+		{"missing protocol", DatabaseConfig{Name: "flipt", Host: "localhost"}, "", "db.protocol"},
