+
+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnknown DatabaseProtocol = iota
+	DatabaseProtocolSQLite
+	DatabaseProtocolPostgres
+	DatabaseProtocolMySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseProtocolSQLite:
+		return "sqlite3"
+	case DatabaseProtocolPostgres:
+		return "postgres"
+	case DatabaseProtocolMySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// ConnectionURL returns the selected connection target after validating it.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.Protocol != DatabaseProtocolUnknown && d.Protocol != DatabaseProtocolSQLite && d.Protocol != DatabaseProtocolPostgres && d.Protocol != DatabaseProtocolMySQL {
+		return "", fmt.Errorf("db.protocol %d is invalid (expected sqlite3, postgres, mysql)", d.Protocol)
+	}
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if d.Protocol == DatabaseProtocolUnknown {
+		return "", errors.New("db.protocol is required (sqlite3, postgres, mysql)")
+	}
+	if strings.TrimSpace(d.Name) == "" {
+		return "", errors.New("db.name is required")
+	}
+	if strings.TrimSpace(d.Host) == "" && (d.Protocol != DatabaseProtocolSQLite || strings.TrimSpace(d.Path) == "") {
+		return "", errors.New("db.host is required (or db.path for sqlite3)")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return "", errors.New("db.port must be between 0 and 65535")
+	}
+	if d.Protocol == DatabaseProtocolSQLite {
+		base := d.Host
+		if d.Path != "" {
+			base = d.Path
+		}
+		return "file:" + filepath.Join(base, d.Name), nil
+	}
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == DatabaseProtocolPostgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, strconv.Itoa(port)), Path: "/" + d.Name}
+	if d.Password != "" {
+		u.User = url.UserPassword(d.User, d.Password)
+	} else if d.User != "" {
+		u.User = url.User(d.User)
+	}
+	return u.String(), nil
 }
 
