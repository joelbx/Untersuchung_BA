+interface IAdminActionLock {
+    pending: boolean;
+    run(action: () => Promise<void>, failureMessage: string): Promise<void>;
+}
+
+const AdminActionLockContext = createContext<IAdminActionLock | null>(null);
+
+function useAdminActionLock(memberId: string): IAdminActionLock {
+    const active = useRef<string | null>(null);
+    const [pendingMemberId, setPendingMemberId] = useState<string | null>(null);
+
+    return {
+        pending: pendingMemberId === memberId,
+        run: async (action, failureMessage) => {
+            if (active.current === memberId) return;
+            active.current = memberId;
+            setPendingMemberId(memberId);
+            try {
+                await action();
+            } catch (err) {
+                logger.error(failureMessage, err);
+                Modal.createDialog(ErrorDialog, {
+                    title: failureMessage,
+                    description: err instanceof Error && err.message ? err.message : _t("Operation failed"),
+                });
+            } finally {
+                if (active.current === memberId) active.current = null;
+                setPendingMemberId((current) => (current === memberId ? null : current));
+            }
+        },
+    };
+}
