+func amazonReleaseFromSystemRelease(systemRelease string) string {
+	line := strings.TrimSpace(systemRelease)
+	if line == "Amazon Linux release" || line == "Amazon Linux AMI release" {
+		return "unknown"
+	}
+	var release string
+	switch {
+	case strings.HasPrefix(line, "Amazon Linux AMI release "):
+		release = strings.TrimPrefix(line, "Amazon Linux AMI release ")
+	case strings.HasPrefix(line, "Amazon Linux release "):
+		release = strings.TrimPrefix(line, "Amazon Linux release ")
+	case strings.HasPrefix(line, "Amazon Linux "):
+		release = strings.TrimPrefix(line, "Amazon Linux ")
+	}
+	if release == "" {
+		return "unknown"
+	}
+	return release
+}
