+func TestAmazonLinuxEOLDates(t *testing.T) {
+	dates := map[string]time.Time{
+		"2023": time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2025": time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2027": time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2029": time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC),
+	}
+	for release, until := range dates {
+		eol, found := GetEOL(Amazon, release+" (Amazon Linux)")
+		if !found || !eol.StandardSupportUntil.Equal(until) {
+			t.Errorf("GetEOL(%q) = (%v, %v), want standard support until %v", release, eol, found, until)
+			continue
+		}
+		if eol.IsStandardSupportEnded(until) || eol.IsExtendedSupportEnded(until) {
+			t.Errorf("%s: support ended at boundary", release)
+		}
+		if !eol.IsStandardSupportEnded(until.Add(time.Second)) || !eol.IsExtendedSupportEnded(until.Add(time.Second)) {
+			t.Errorf("%s: support did not end after boundary", release)
+		}
+	}
+	if _, found := GetEOL(Amazon, "2024 (Amazon Linux)"); found {
+		t.Error("unrecognized Amazon Linux release was found")
+	}
+	withExtended := EOL{StandardSupportUntil: dates["2023"], ExtendedSupportUntil: dates["2023"].AddDate(2, 0, 0)}
+	if !withExtended.IsStandardSupportEnded(dates["2023"].Add(time.Second)) || withExtended.IsExtendedSupportEnded(dates["2023"].Add(time.Second)) {
+		t.Error("extended support should continue after standard support ends")
+	}
+	if !withExtended.IsExtendedSupportEnded(withExtended.ExtendedSupportUntil.Add(time.Second)) {
+		t.Error("extended support should end after its date")
+	}
+}
