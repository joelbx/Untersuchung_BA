+func TestSamplingRatio(t *testing.T) {
+	for _, tt := range []struct {
+		ratio float64
+		want  bool
+	}{
+		{0, false},
+		{1, true},
+	} {
+		provider, err := NewProviderWithSamplingRatio(context.Background(), "test", tt.ratio)
+		require.NoError(t, err)
+		_, span := provider.Tracer("test").Start(context.Background(), "sample")
+		assert.Equal(t, tt.want, span.IsRecording())
+		assert.Equal(t, tt.want, span.SpanContext().IsSampled())
+		span.End()
+		require.NoError(t, provider.Shutdown(context.Background()))
+	}
+}
+
+func TestTextMapPropagators(t *testing.T) {
+	for _, tt := range []struct {
+		option config.TracingPropagator
+		field  string
+	}{
+		{config.TracingPropagatorTraceContext, "traceparent"},
+		{config.TracingPropagatorBaggage, "baggage"},
+		{config.TracingPropagatorB3, "b3"},
+		{config.TracingPropagatorB3Multi, "x-b3-traceid"},
+		{config.TracingPropagatorJaeger, "uber-trace-id"},
+		{config.TracingPropagatorXRay, "X-Amzn-Trace-Id"},
+		{config.TracingPropagatorOTTrace, "ot-tracer-traceid"},
+	} {
+		t.Run(string(tt.option), func(t *testing.T) {
+			propagator := NewTextMapPropagator([]config.TracingPropagator{tt.option})
+			assert.Contains(t, propagator.Fields(), tt.field)
+		})
+	}
+	assert.Empty(t, NewTextMapPropagator([]config.TracingPropagator{config.TracingPropagatorNone}).Fields())
+	assert.ElementsMatch(t, []string{"traceparent", "tracestate", "baggage"}, NewTextMapPropagator([]config.TracingPropagator{
+		config.TracingPropagatorTraceContext, config.TracingPropagatorBaggage,
+	}).Fields())
+}
