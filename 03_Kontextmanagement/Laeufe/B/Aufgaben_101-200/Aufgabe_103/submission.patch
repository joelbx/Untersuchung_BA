+// The query format separates columns with one space. Fields would discard an
+// empty release column and shift every column after it to the left.
+func splitInstalledPackageFields(line string) []string {
+	return strings.Split(strings.ReplaceAll(strings.TrimSpace(line), "\t", " "), " ")
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
