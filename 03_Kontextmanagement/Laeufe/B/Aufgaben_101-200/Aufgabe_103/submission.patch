+func TestInstalledPackageEmptyRelease(t *testing.T) {
+	tests := []struct {
+		name, epoch, release, sourceFile, wantBinaryVersion, wantSourceVersion string
+	}{
+		{"zero epoch, empty release", "0", "", "package-1-.src.rpm", "1", "1"},
+		{"none epoch, empty release", "(none)", "", "package-1-.src.rpm", "1", "1"},
+		{"nonzero epoch, empty release", "2", "", "package-1-.src.rpm", "2:1", "2:1"},
+		{"zero epoch, release", "0", "3", "package-1-3.src.rpm", "1", "1-3"},
+		{"nonzero epoch, release", "2", "3", "package-1-3.src.rpm", "2:1", "2:1-3"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			line := "package " + tt.epoch + " 1 " + tt.release + " x86_64 " + tt.sourceFile
+			for _, parse := range []struct {
+				name string
+				fn   func(string) (*models.Package, *models.SrcPackage, error)
+			}{
+				{"rpm", (&redhatBase{}).parseInstalledPackagesLine},
+				{"repoquery", (&redhatBase{}).parseInstalledPackagesLineFromRepoquery},
+			} {
+				input := line
+				if parse.name == "repoquery" {
+					input += " @amzn2-core"
+				}
+				binary, source, err := parse.fn(input)
+				if err != nil {
+					t.Fatalf("%s: %v", parse.name, err)
+				}
+				if binary.Name != "package" || binary.Version != tt.wantBinaryVersion || binary.Release != tt.release || binary.Arch != "x86_64" {
+					t.Errorf("%s binary = %+v", parse.name, binary)
+				}
+				if source == nil || source.Name != "package" || source.Version != tt.wantSourceVersion || source.Arch != "src" || !reflect.DeepEqual(source.BinaryNames, []string{"package"}) {
+					t.Errorf("%s source = %+v", parse.name, source)
+				}
+			}
+		})
+	}
+
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2 (Karoo)"}, log: logging.NewIODiscardLogger()}}
+	binaries, sources, err := o.parseInstalledPackages("package 0 1  x86_64 package-1-.src.rpm\nother 0 2  noarch other-2-.src.rpm @amzn2-core")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(binaries) != 2 || binaries["package"].Release != "" || binaries["other"].Repository != "amzn2-core" || sources["package"].Version != "1" || sources["other"].Version != "2" {
+		t.Errorf("unexpected installed packages: binaries=%+v sources=%+v", binaries, sources)
+	}
+}
+
+func TestSplitFileNameSourceAndMalformed(t *testing.T) {
+	for _, tt := range []struct {
+		filename, name, version, release, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src"},
+		{"package-0--src.rpm", "package", "0", "", "src"},
+		{"package-name-0-1.src.rpm", "package-name", "0", "1", "src"},
+	} {
+		name, version, release, _, arch, err := splitFileName(tt.filename)
+		if err != nil || name != tt.name || version != tt.version || release != tt.release || arch != tt.arch {
+			t.Errorf("splitFileName(%q) = %q, %q, %q, %q, %v", tt.filename, name, version, release, arch, err)
+		}
+	}
+	for _, filename := range []string{"package-0-1", "-package-0-1.src.rpm", "package--1.src.rpm", "package-0-1..rpm", "package-0-1:bad.src.rpm"} {
+		if _, _, _, _, _, err := splitFileName(filename); err == nil {
+			t.Errorf("splitFileName(%q) accepted malformed filename", filename)
+		}
+	}
+}
