@@ -62,3 +62,79 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_create_address_family_with_default_both(self):
+        self.get_config.return_value = 'vrf context ntc\n'
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[{'rt': '65000:1000'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'route-target import 65000:1000',
+            'route-target export 65000:1000'])
+
+    def test_route_targets_mixed_changes_scoped_to_selected_af(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target import 2:2
+  address-family ipv6 unicast
+    route-target import 3:3
+vrf context other
+  address-family ipv4 unicast
+    route-target import 3:3
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            {'rt': '1:1'},
+            {'rt': '2:2', 'direction': 'import', 'state': 'absent'},
+            {'rt': '3:3', 'direction': 'import'},
+            {'rt': '4:4', 'direction': 'export'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target import 2:2',
+            'route-target import 3:3',
+            'route-target export 4:4'])
+
+    def test_route_targets_already_match(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[{'rt': '1:1'},
+                                            {'rt': '2:2', 'state': 'absent'}]))
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_route_targets_remove_both_and_evpn(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv6',
+                             route_target_both_auto_evpn=False,
+                             route_targets=[{'rt': '1:1', 'state': 'absent'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'no route-target both auto evpn',
+            'no route-target import 1:1',
+            'no route-target export 1:1'])
+
+    def test_absent_ignores_route_target_options(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[{'rt': '2:2'}]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'no address-family ipv4 unicast'])
