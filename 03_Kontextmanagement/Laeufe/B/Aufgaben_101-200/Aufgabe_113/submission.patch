+def match_current_rt(rt, direction, current, rt_commands):
+    """Append the command needed for one route-target direction, if any."""
+    command = 'route-target %s %s' % (direction, rt['rt'])
+    have = any(line.strip() == command for line in current.splitlines())
+    state = rt.get('state', 'present')
+    if state == 'present' and not have:
+        rt_commands.append(command)
+    elif state == 'absent' and have:
+        rt_commands.append('no %s' % command)
