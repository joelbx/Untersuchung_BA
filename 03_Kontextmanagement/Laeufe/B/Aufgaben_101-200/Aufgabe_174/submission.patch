diff --git a/test/units/executor/test_display_queue.py b/test/units/executor/test_display_queue.py
new file mode 100644
index 0000000..2db36e3
--- /dev/null
+++ b/test/units/executor/test_display_queue.py
@@ -0,0 +1,29 @@
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from queue import Queue
+
+from ansible.executor.task_queue_manager import DisplaySend, FinalQueue
+from ansible.plugins.strategy import StrategySentinel, results_thread_main
+
+
+def test_display_event_is_packaged_and_replayed(mocker):
+    put = mocker.patch.object(FinalQueue, 'put')
+    queue = FinalQueue()
+    try:
+        queue.send_display(u'queued message', stderr=True, newline=False)
+        event = put.call_args.args[0]
+        assert isinstance(event, DisplaySend)
+        assert event.args == (u'queued message',)
+        assert event.kwargs == {'stderr': True, 'newline': False}
+        assert put.call_args.kwargs == {'block': False}
+
+        strategy = mocker.Mock()
+        strategy._final_q = Queue()
+        strategy._final_q.put(event)
+        strategy._final_q.put(StrategySentinel())
+        parent_display = mocker.patch('ansible.plugins.strategy.display.display')
+        results_thread_main(strategy)
+        parent_display.assert_called_once_with(u'queued message', stderr=True, newline=False)
+    finally:
+        queue.close()
