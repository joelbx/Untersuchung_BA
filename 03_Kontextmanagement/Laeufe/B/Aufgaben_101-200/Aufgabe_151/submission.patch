+@pytest.mark.parametrize("qt_version, expected", [
+    ("6.2.2", set()),
+    ("6.2.3", {".jpg", ".jpe"}),
+    ("6.6.9", {".jpg", ".jpe"}),
+    ("6.7.0", set()),
+])
+def test_extra_suffixes_workaround_versions(monkeypatch, qt_version, expected):
+    def version_check(version, *, compiled):
+        assert compiled is False
+        return tuple(map(int, qt_version.split("."))) >= tuple(
+            map(int, version.split(".")))
+
+    monkeypatch.setattr(webview.qtutils, "version_check", version_check)
+    monkeypatch.setattr(mimetypes, "guess_all_extensions",
+                        lambda mime: [".jpg", ".jpe"])
+
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == expected
+
+
+def test_extra_suffixes_workaround_mimetypes(monkeypatch):
+    monkeypatch.setattr(webview.qtutils, "version_check",
+                        lambda version, *, compiled: version == "6.2.3")
+    extensions = {
+        "image/jpeg": [".jpg", ".jpe"],
+        "video/mp4": [".m4v", ".mpg4"],
+    }
+    monkeypatch.setattr(mimetypes, "guess_all_extensions",
+                        lambda mime: extensions.get(mime, []))
+    monkeypatch.setattr(mimetypes, "types_map", {
+        ".jpg": "image/jpeg",
+        ".jpe": "image/jpeg",
+        ".png": "image/png",
+        ".mp4": "video/mp4",
+    })
+
+    assert webview.extra_suffixes_workaround(
+        ["image/jpeg", "video/mp4"]) == {".jpg", ".jpe", ".m4v", ".mpg4"}
+    assert webview.extra_suffixes_workaround(
+        ["image/jpeg", ".jpg", ".jpe"]) == set()
+    assert webview.extra_suffixes_workaround([".jpg"]) == set()
+    assert webview.extra_suffixes_workaround(
+        ["image/*", ".jpg"]) == {".jpe", ".png"}
