diff --git a/lib/utils/parse/ast.go b/lib/utils/parse/ast.go
new file mode 100644
index 0000000..2818450
--- /dev/null
+++ b/lib/utils/parse/ast.go
@@ -0,0 +1,164 @@
+package parse
+
+import (
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a typed, evaluable expression.
+type Expr interface {
+	String() string
+	Kind() reflect.Kind
+	Evaluate(EvaluateContext) (any, error)
+}
+
+// EvaluateContext supplies values for variables and the input to a matcher.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string                        { return strconv.Quote(e.Value) }
+func (StringLitExpr) Kind() reflect.Kind                      { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) { return []string{e.Value}, nil }
+
+type VarExpr struct{ Namespace, Name string }
+
+func (e VarExpr) String() string   { return e.Namespace + "." + e.Name }
+func (VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if e.Namespace == LiteralNamespace {
+		return []string{e.Name}, nil
+	}
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("no resolver for variable %s", e.String())
+	}
+	return ctx.VarValue(e)
+}
+
+type EmailLocalExpr struct{ Expr Expr }
+
+func (e EmailLocalExpr) String() string   { return "email.local(" + e.Expr.String() + ")" }
+func (EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Expr, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("address is empty")
+		}
+		addr, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("invalid email address %q: %v", value, err)
+		}
+		at := strings.LastIndex(addr.Address, "@")
+		if at <= 0 {
+			return nil, trace.BadParameter("missing local part in %q", value)
+		}
+		out = append(out, addr.Address[:at])
+	}
+	return out, nil
+}
+
+type RegexpReplaceExpr struct {
+	Expr                 Expr
+	Pattern, Replacement string
+	re                   *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return "regexp.replace(" + e.Expr.String() + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Expr, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	out := make([]string, 0, len(values))
+	for _, v := range values {
+		if re.MatchString(v) {
+			out = append(out, re.ReplaceAllString(v, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string   { return "regexp.match(" + strconv.Quote(e.Pattern) + ")" }
+func (RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	if re == nil {
+		var err error
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	return "regexp.not_match(" + strconv.Quote(e.Pattern) + ")"
+}
+func (RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	if re == nil {
+		var err error
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return !re.MatchString(ctx.MatcherInput), nil
+}
+
+func compileRegexp(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("invalid regexp %q: %v", pattern, err)
+	}
+	return re, nil
+}
+func evaluateStrings(expr Expr, ctx EvaluateContext) ([]string, error) {
+	if expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %s", expr.Kind())
+	}
+	v, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	values, ok := v.([]string)
+	if !ok {
+		return nil, trace.BadParameter("expression %s did not return strings", expr.String())
+	}
+	return values, nil
+}
