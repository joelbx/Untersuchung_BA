+// splitTemplate recognizes a single well-formed {{ expression }} section.
+func splitTemplate(input string) (prefix, body, suffix string, templated bool, err error) {
+	s := strings.TrimSpace(input)
+	start := strings.Index(s, "{{")
+	if start < 0 {
+		if strings.Contains(s, "}}") {
+			return "", "", "", false, trace.BadParameter("malformed template usage in %q: expected one {{ expression }}", input)
+		}
+		return "", s, "", false, nil
+	}
+	if strings.ContainsAny(s[:start], "{}") {
+		return "", "", "", false, trace.BadParameter("malformed template usage in %q", input)
+	}
+	quote := byte(0)
+	escaped := false
+	end := -1
+	for i := start + 2; i < len(s); i++ {
+		c := s[i]
+		if quote != 0 {
+			if escaped {
+				escaped = false
+				continue
+			}
+			if c == '\\' && quote != '`' {
+				escaped = true
+				continue
+			}
+			if c == quote {
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' || c == '`' || c == '\'' {
+			quote = c
+			continue
+		}
+		if c == '}' && i+1 < len(s) && s[i+1] == '}' {
+			end = i
+			break
+		}
+		if c == '{' || c == '}' {
+			return "", "", "", false, trace.BadParameter("malformed template usage in %q", input)
+		}
+	}
+	if end < 0 || strings.ContainsAny(s[end+2:], "{}") {
+		return "", "", "", false, trace.BadParameter("malformed template usage in %q: expected one {{ expression }}", input)
+	}
+	prefix = s[:start]
+	body = strings.TrimSpace(s[start+2 : end])
+	suffix = s[end+2:]
+	if body == "" {
+		return "", "", "", false, trace.BadParameter("malformed template usage in %q: expression is empty", input)
+	}
+	return prefix, body, suffix, true, nil
 }
 
