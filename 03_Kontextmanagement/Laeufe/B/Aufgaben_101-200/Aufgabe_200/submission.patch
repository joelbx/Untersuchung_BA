+def parse_duration(duration: str) -> int:
+    """Parse hours, minutes and seconds into milliseconds.
+
+    Bare integers are interpreted as milliseconds for backwards compatibility.
+    Fractional milliseconds are truncated.
+    """
+    duration = duration.strip()
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    number = r'(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+)'
+    pattern = (r'(?:(?P<hours>' + number + r')h)?\s*'
+               r'(?:(?P<minutes>' + number + r')m)?\s*'
+               r'(?:(?P<seconds>' + number + r')s)?')
+    match = re.fullmatch(pattern, duration)
+    if match is None or not any(match.groupdict().values()):
+        raise ValueError('Invalid duration: {!r}'.format(duration))
+
+    milliseconds = sum(
+        Decimal(value) * factor
+        for value, factor in ((match.group('hours'), 3600000),
+                              (match.group('minutes'), 60000),
+                              (match.group('seconds'), 1000))
+        if value is not None)
+    return int(milliseconds)
+
