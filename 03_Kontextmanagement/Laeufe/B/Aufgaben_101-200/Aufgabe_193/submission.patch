+@pytest.mark.parametrize('command,role_path,install_roles,install_collections', [
+    ([], None, True, True),
+    ([], 'custom_roles', True, False),
+    (['role'], None, True, False),
+    (['role'], 'custom_roles', True, False),
+    (['collection'], None, False, True),
+])
+def test_install_mixed_requirements(tmp_path, monkeypatch, command, role_path, install_roles, install_collections):
+    requirements = tmp_path / 'requirements.yml'
+    requirements.write_text('roles:\n- example.role\ncollections:\n- example.collection\n')
+    role_install = MagicMock()
+    collection_install = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', role_install)
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', collection_install)
+    warning = MagicMock()
+    message = MagicMock()
+    verbose = MagicMock()
+    monkeypatch.setattr(ansible.cli.galaxy.display, 'warning', warning)
+    monkeypatch.setattr(ansible.cli.galaxy.display, 'display', message)
+    monkeypatch.setattr(ansible.cli.galaxy.display, 'vvv', verbose)
+
+    args = ['ansible-galaxy'] + command + ['install', '-r', str(requirements)]
+    if role_path:
+        args += ['-p', str(tmp_path / role_path)]
+    GalaxyCLI(args=args).run()
+
+    assert bool(role_install.called) == install_roles
+    assert bool(collection_install.called) == install_collections
+    if install_roles:
+        expected_path = str(tmp_path / role_path) if role_path else C.DEFAULT_ROLES_PATH[0]
+        assert role_install.call_args[0][0][0].path == os.path.join(expected_path, 'example.role')
+    if install_collections:
+        assert collection_install.call_args[0][1] == C.COLLECTIONS_PATHS[0]
+    if role_path and not command:
+        assert 'Collections cannot be installed to a roles path' in warning.call_args[0][0]
+    elif command == ['role']:
+        assert 'collections which will be ignored' in str(verbose.call_args_list)
+        assert not warning.called
+    elif command == ['collection']:
+        assert 'roles which will be ignored' in str(message.call_args_list)
+
+
+def test_install_empty_requirements_skips(tmp_path, monkeypatch):
+    requirements = tmp_path / 'requirements.yml'
+    requirements.write_text('roles: []\ncollections: []\n')
+    role_install = MagicMock()
+    collection_install = MagicMock()
+    message = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', role_install)
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', collection_install)
+    monkeypatch.setattr(ansible.cli.galaxy.display, 'display', message)
+
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', str(requirements)]).run()
+
+    assert not role_install.called
+    assert not collection_install.called
+    assert 'Skipping install, no requirements found' in str(message.call_args_list)
+
+
+def test_role_install_rejects_non_yaml_requirements(tmp_path):
+    requirements = tmp_path / 'requirements.txt'
+    requirements.write_text('roles: []\n')
+    with pytest.raises(AnsibleError, match='Invalid role requirements file'):
+        GalaxyCLI(args=['ansible-galaxy', 'role', 'install', '-r', str(requirements)]).run()
+
+
+def test_role_install_processes_transitive_dependencies_without_reinstall(monkeypatch):
+    cli = GalaxyCLI(args=['ansible-galaxy', 'role', 'install', '-r', 'requirements.yml'])
+    cli.parse()
+    cli.galaxy = object()
+    cli.api_servers = [object()]
+    installed = []
+
+    class Role(object):
+        def __init__(self, name, dependencies=(), already_installed=False):
+            self.name = name
+            self.version = None
+            self.metadata = {'dependencies': list(dependencies)}
+            self.requirements = []
+            self.install_info = {'version': None} if already_installed else None
+            self.path = '/unused'
+
+        def __eq__(self, other):
+            return self.name == other.name
+
+        def install(self):
+            installed.append(self.name)
+            return True
+
+    roles = {
+        'example.parent': Role('example.parent', ['example.child']),
+        'example.child': Role('example.child', ['example.grandchild']),
+        'example.grandchild': Role('example.grandchild', already_installed=True),
+    }
+    monkeypatch.setattr(ansible.cli.galaxy, 'GalaxyRole',
+                        lambda galaxy, api, name, **kwargs: roles[name])
+
+    cli._install_roles([roles['example.parent']], 'requirements.yml')
+
+    assert installed == ['example.parent', 'example.child']
+
+
