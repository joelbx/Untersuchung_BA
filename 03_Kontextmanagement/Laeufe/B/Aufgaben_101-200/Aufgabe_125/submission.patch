diff --git a/test/topicBacklinks.js b/test/topicBacklinks.js
new file mode 100644
index 0000000..fa72b9b
--- /dev/null
+++ b/test/topicBacklinks.js
@@ -0,0 +1,77 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+
+const db = require('./mocks/databasemock');
+const topics = require('../src/topics');
+const posts = require('../src/posts');
+const categories = require('../src/categories');
+const user = require('../src/user');
+const meta = require('../src/meta');
+
+describe('Topic Backlinks', () => {
+	let uid;
+	let cid;
+	let target;
+	let source;
+	let previousSetting;
+
+	before(async () => {
+		previousSetting = meta.config.topicBacklinks;
+		meta.config.topicBacklinks = 1;
+		uid = await user.create({ username: 'backlink-author', password: '123456' });
+		cid = (await categories.create({ name: 'Backlink Category' })).cid;
+		target = await topics.post({ title: 'Backlink target', content: 'A target topic post', uid, cid });
+	});
+
+	after(() => {
+		meta.config.topicBacklinks = previousSetting;
+	});
+
+	it('rejects invalid post data', async () => {
+		await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+		await assert.rejects(topics.syncBacklinks({ pid: 1, uid: null, tid: 1, content: '' }),
+			{ message: '[[error:invalid-data]]' });
+	});
+
+	it('adds a backlink for a new topic and keeps one association per post', async () => {
+		const { tid } = target.topicData;
+		source = await topics.post({
+			title: 'Backlink source',
+			content: `See ${nconf.get('url')}/topic/${tid}/backlink-target and /topic/${tid}`,
+			uid,
+			cid,
+		});
+		const { pid } = source.postData;
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), [String(tid)]);
+		const events = (await topics.events.get(tid, uid)).filter(event => event.type === 'backlink');
+		assert.strictEqual(events.length, 1);
+		assert.strictEqual(events[0].href, `/post/${pid}`);
+		assert.strictEqual(events[0].uid, uid);
+		assert.strictEqual(events[0].text, '[[topic:backlink]]');
+		assert.strictEqual(await topics.syncBacklinks(source.postData), 0);
+	});
+
+	it('hides events when disabled and removes them after an edit', async () => {
+		const { tid } = target.topicData;
+		meta.config.topicBacklinks = 0;
+		assert.strictEqual((await topics.events.get(tid, uid)).filter(event => event.type === 'backlink').length, 0);
+		meta.config.topicBacklinks = 1;
+		await posts.edit({ pid: source.postData.pid, uid, content: 'This post no longer links to another topic.' });
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${source.postData.pid}:backlinks`, 0, -1), []);
+		assert.strictEqual((await topics.events.get(tid, uid)).filter(event => event.type === 'backlink').length, 0);
+	});
+
+	it('ignores self links, missing topics, and links to another site', async () => {
+		const { pid, tid } = source.postData;
+		const changed = await topics.syncBacklinks({
+			pid,
+			uid,
+			tid,
+			content: `See /topic/${tid} and /topic/99999999, https://other.example/topic/${target.topicData.tid} and /not/topic/${target.topicData.tid}`,
+		});
+		assert.strictEqual(changed, 0);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), []);
+	});
+});
