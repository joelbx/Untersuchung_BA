+// updateRemoteClusterConnection records connection changes when the remote cluster exists.
+func (s *PresenceService) updateRemoteClusterConnection(clusterName string, heartbeat time.Time, upsert bool) error {
+	cluster, err := s.GetRemoteCluster(clusterName)
+	if trace.IsNotFound(err) {
+		return nil
+	}
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if upsert {
+		cluster.SetConnectionStatus(teleport.RemoteClusterStatusOnline)
+		if heartbeat.After(cluster.GetLastHeartbeat()) {
+			cluster.SetLastHeartbeat(heartbeat.UTC())
+		}
+	} else {
+		connections, err := s.GetTunnelConnections(clusterName)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		if len(connections) == 0 {
+			cluster.SetConnectionStatus(teleport.RemoteClusterStatusOffline)
+		} else {
+			cluster.SetConnectionStatus(teleport.RemoteClusterStatusOnline)
+		}
+	}
+	return trace.Wrap(s.UpdateRemoteCluster(context.TODO(), cluster))
 }
 
