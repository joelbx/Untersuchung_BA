+
+func (s *PresenceSuite) TestRemoteClusterConnectionStatus(c *check.C) {
+	ctx := context.Background()
+	presence := NewPresenceService(s.bk)
+	cluster, err := services.NewRemoteCluster("example.com")
+	c.Assert(err, check.IsNil)
+	cluster.SetConnectionStatus(teleport.RemoteClusterStatusOnline)
+	cluster.SetLastHeartbeat(time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC))
+	cluster.SetExpiry(time.Now().UTC().Add(time.Hour))
+	c.Assert(presence.CreateRemoteCluster(cluster), check.IsNil)
+
+	got, err := presence.GetRemoteCluster(cluster.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOffline)
+	c.Assert(got.GetLastHeartbeat(), check.DeepEquals, cluster.GetLastHeartbeat())
+
+	first := time.Date(2020, 1, 2, 0, 0, 0, 0, time.UTC)
+	second := first.Add(time.Hour)
+	conn1, err := services.NewTunnelConnection("first", services.TunnelConnectionSpecV2{
+		ClusterName: cluster.GetName(), ProxyName: "proxy-1", LastHeartbeat: first,
+	})
+	c.Assert(err, check.IsNil)
+	conn2, err := services.NewTunnelConnection("second", services.TunnelConnectionSpecV2{
+		ClusterName: cluster.GetName(), ProxyName: "proxy-2", LastHeartbeat: second,
+	})
+	c.Assert(err, check.IsNil)
+	c.Assert(presence.UpsertTunnelConnection(conn1), check.IsNil)
+	c.Assert(presence.UpsertTunnelConnection(conn2), check.IsNil)
+	got, err = presence.GetRemoteCluster(cluster.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOnline)
+	c.Assert(got.GetLastHeartbeat(), check.DeepEquals, second)
+	c.Assert(got.Expiry(), check.DeepEquals, cluster.Expiry())
+	conn1.SetLastHeartbeat(first.Add(-time.Hour))
+	c.Assert(presence.UpsertTunnelConnection(conn1), check.IsNil)
+	got, err = presence.GetRemoteCluster(cluster.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetLastHeartbeat(), check.DeepEquals, second)
+
+	c.Assert(presence.DeleteTunnelConnection(cluster.GetName(), conn2.GetName()), check.IsNil)
+	got, err = presence.GetRemoteCluster(cluster.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOnline)
+	c.Assert(got.GetLastHeartbeat(), check.DeepEquals, second)
+
+	c.Assert(presence.DeleteTunnelConnection(cluster.GetName(), conn1.GetName()), check.IsNil)
+	got, err = presence.GetRemoteCluster(cluster.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOffline)
+	c.Assert(got.GetLastHeartbeat(), check.DeepEquals, second)
+
+	got.SetConnectionStatus(teleport.RemoteClusterStatusOnline)
+	c.Assert(presence.UpdateRemoteCluster(ctx, got), check.IsNil)
+	got, err = presence.GetRemoteCluster(cluster.GetName())
+	c.Assert(err, check.IsNil)
+	c.Assert(got.GetConnectionStatus(), check.Equals, teleport.RemoteClusterStatusOffline)
+	c.Assert(got.GetLastHeartbeat(), check.DeepEquals, second)
+	c.Assert(got.Expiry(), check.DeepEquals, cluster.Expiry())
+}
