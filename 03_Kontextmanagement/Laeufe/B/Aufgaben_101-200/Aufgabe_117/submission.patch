+def _get_locale_pak_path(locales_dir: Path, locale: str) -> Path:
+    """Return the QtWebEngine resource file for a Chromium locale name."""
+    locale = locale.split('.', 1)[0].replace('_', '-')
+    return Path(locales_dir) / (locale + '.pak')
+
+
+def _get_lang_override(
+        versions: version.WebEngineVersions,
+        locale: str,
+        locales_dir: Optional[Path] = None,
+) -> Optional[str]:
+    """Choose a Chromium locale when QtWebEngine 5.15.3 lacks the system one."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    if locales_dir is None:
+        locales_path = os.environ.get('QTWEBENGINE_LOCALES_PATH')
+        if locales_path is None:
+            locales_path = os.path.join(
+                QLibraryInfo.location(QLibraryInfo.DataPath),
+                'qtwebengine_locales',
+            )
+        locales_dir = Path(locales_path)
+
+    locale = locale.split('.', 1)[0].replace('_', '-')
+    if _get_locale_pak_path(locales_dir, locale).is_file():
+        return None
+
+    language = locale.split('-', 1)[0]
+    if language == 'en':
+        mapped = 'en-US' if locale in ('en', 'en-US', 'en-LR', 'en-PH') else 'en-GB'
+    elif language == 'es':
+        mapped = 'es' if locale in ('es', 'es-ES') else 'es-419'
+    elif language == 'pt':
+        mapped = 'pt-BR' if locale in ('pt', 'pt-BR') else 'pt-PT'
+    elif language == 'zh':
+        mapped = 'zh-TW' if locale in ('zh-TW', 'zh-HK', 'zh-MO') else 'zh-CN'
+    else:
+        mapped = language
+
+    for candidate in (mapped, language):
+        if candidate != locale and _get_locale_pak_path(locales_dir, candidate).is_file():
+            return candidate
+    return 'en-US'
+
+
