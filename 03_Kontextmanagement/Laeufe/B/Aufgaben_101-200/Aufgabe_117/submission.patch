+@pytest.mark.parametrize('locale, available, expected', [
+    ('en', ['en-US'], 'en-US'),
+    ('en-LR', ['en-US', 'en-GB'], 'en-US'),
+    ('en-PH', ['en-US', 'en-GB'], 'en-US'),
+    ('en-AU', ['en-GB'], 'en-GB'),
+    ('en-CA', ['en-GB'], 'en-GB'),
+    ('en-IE', ['en-GB'], 'en-GB'),
+    ('en-IN', ['en-GB'], 'en-GB'),
+    ('en-NZ', ['en-GB'], 'en-GB'),
+    ('en-ZA', ['en-GB'], 'en-GB'),
+    ('en-ZW', ['en-GB'], 'en-GB'),
+    ('es', ['es'], None),
+    ('es_MX.UTF-8', ['es-419', 'es'], 'es-419'),
+    ('es-MX', ['es'], 'es'),
+    ('pt', ['pt-BR'], 'pt-BR'),
+    ('pt-BR', ['pt-BR'], None),
+    ('pt-PT', ['pt-PT'], None),
+    ('pt-AO', ['pt-PT', 'pt-BR'], 'pt-PT'),
+    ('pt-PT', ['pt-BR'], 'en-US'),
+    ('zh', ['zh-CN'], 'zh-CN'),
+    ('zh-CN', ['zh-CN'], None),
+    ('zh-TW', ['zh-TW'], None),
+    ('zh-HK', ['zh-TW', 'zh-CN'], 'zh-TW'),
+    ('zh-MO', ['zh-TW', 'zh-CN'], 'zh-TW'),
+    ('fr-CA', ['fr'], 'fr'),
+    ('fr-CA', [], 'en-US'),
+])
+def test_lang_override(monkeypatch, config_stub, tmp_path, locale, available, expected):
+    config_stub.val.qt.workarounds.locale = True
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    versions = version.WebEngineVersions.from_pyqt('5.15.3')
+    for name in available:
+        qtargs._get_locale_pak_path(tmp_path, name).touch()
+
+    assert qtargs._get_lang_override(versions, locale, tmp_path) == expected
+
+
+@pytest.mark.parametrize('enabled, linux, qt_version', [
+    (False, True, '5.15.3'),
+    (True, False, '5.15.3'),
+    (True, True, '5.15.2'),
+    (True, True, '5.15.4'),
+])
+def test_lang_override_gate(monkeypatch, config_stub, tmp_path,
+                            enabled, linux, qt_version):
+    config_stub.val.qt.workarounds.locale = enabled
+    monkeypatch.setattr(qtargs.utils, 'is_linux', linux)
+    versions = version.WebEngineVersions.from_pyqt(qt_version)
+    assert qtargs._get_lang_override(versions, 'es-MX', tmp_path) is None
+
+
+def test_locale_pak_path(tmp_path):
+    assert qtargs._get_locale_pak_path(tmp_path, 'es_MX.UTF-8') == tmp_path / 'es-MX.pak'
+
+
