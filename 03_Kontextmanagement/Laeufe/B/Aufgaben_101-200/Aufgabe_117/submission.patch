+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Work around a QtWebEngine 5.15.3 bug on Linux where an unsupported system
+    locale can crash the network service. When enabled, use an available
+    Chromium locale fallback if the locale's resource file is missing.
+
 qt.workarounds.remove_service_workers:
   type: Bool
   default: false
