+    def test_values_only_and_scalar_preservation(self):
+        today = date(2020, 1, 2)
+        source = OrderedDict((('secret', 'secret-secret'),
+                              ('key-secret', [12, False, None, today, datetime(2020, 1, 2),
+                                              {'secret': b'prefix-secret-suffix'}])))
+        result = remove_values(source, (b'secret',))
+        self.assertIsInstance(result, OrderedDict)
+        self.assertIsNot(result, source)
+        self.assertEqual(result['secret'], '********-********')
+        self.assertEqual(result['key-secret'][:5], [12, False, None, today, datetime(2020, 1, 2)])
+        self.assertEqual(result['key-secret'][5], {'secret': b'prefix-********-suffix'})
+        self.assertEqual(list(result), ['secret', 'key-secret'])
+
+    def test_container_types_and_binary_token(self):
+        Pair = namedtuple('Pair', 'first second')
+        value = Pair((b'caf\xc3\xa9', 'caf\xe9'), frozenset(['secret', 'safe']))
+        result = remove_values(value, (b'caf\xc3\xa9', 'secret'))
+        self.assertIsInstance(result, Pair)
+        self.assertIsInstance(result.first, tuple)
+        self.assertIsInstance(result.second, frozenset)
+        self.assertEqual(result, Pair((b'********', '********'), frozenset(['********', 'safe'])))
+
+    def test_deep_structure(self):
+        value = 'secret'
+        for _ in range(10000):
+            value = [value]
+        result = remove_values(value, ('secret',))
+        for _ in range(10000):
+            result = result[0]
+        self.assertEqual(result, '********')
