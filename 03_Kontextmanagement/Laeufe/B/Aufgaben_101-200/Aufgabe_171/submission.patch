+package grpc_middleware
+
+import (
+	"context"
+	"testing"
+
+	"github.com/blang/semver/v4"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+)
+
+func TestFliptAcceptServerVersionContext(t *testing.T) {
+	version := semver.Version{Major: 2, Minor: 3, Patch: 4}
+	require.Equal(t, defaultFliptAcceptServerVersion, FliptAcceptServerVersionFromContext(context.Background()))
+	require.Equal(t, version, FliptAcceptServerVersionFromContext(WithFliptAcceptServerVersion(context.Background(), version)))
+}
+
+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name   string
+		values []string
+		want   semver.Version
+	}{
+		{name: "missing", want: defaultFliptAcceptServerVersion},
+		{name: "prefixed", values: []string{"v2.3.4"}, want: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+		{name: "unprefixed", values: []string{"2.3.4"}, want: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+		{name: "invalid", values: []string{"not-a-version"}, want: defaultFliptAcceptServerVersion},
+		{name: "empty", values: []string{""}, want: defaultFliptAcceptServerVersion},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.values != nil {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.values[0]))
+			}
+
+			called := false
+			_, err := FliptAcceptServerVersionUnaryInterceptor(zaptest.NewLogger(t))(ctx, nil, nil, func(ctx context.Context, _ interface{}) (interface{}, error) {
+				called = true
+				require.Equal(t, tt.want, FliptAcceptServerVersionFromContext(ctx))
+				return nil, nil
+			})
+			require.NoError(t, err)
+			require.True(t, called)
+		})
+	}
+}
+
+var _ grpc.UnaryServerInterceptor = FliptAcceptServerVersionUnaryInterceptor(nil)
