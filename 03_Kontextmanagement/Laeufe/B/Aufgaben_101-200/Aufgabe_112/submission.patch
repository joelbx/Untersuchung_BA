+	"time"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertFortinetToModel(t *testing.T) {
+	published := time.Date(2023, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	got := ConvertFortinetToModel("CVE-2023-1234", []cvedict.Fortinet{{
+		AdvisoryID: "FG-IR-23-001", Title: "FortiOS issue", Summary: "Affected versions",
+		AdvisoryURL: "https://www.fortiguard.com/psirt/FG-IR-23-001",
+		Cvss3: cvedict.FortinetCvss3{Cvss3: cvedict.Cvss3{
+			BaseScore: 8.1, VectorString: "CVSS:3.1/AV:N", BaseSeverity: "HIGH",
+		}},
+		Cwes: []cvedict.FortinetCwe{{CweID: "CWE-79"}},
+		References: []cvedict.FortinetReference{{Reference: cvedict.Reference{
+			Link: "https://example.com/reference", Source: "Fortinet",
+		}}},
+		PublishedDate: published, LastModifiedDate: modified,
+	}})
+	want := []CveContent{{
+		Type: Fortinet, CveID: "CVE-2023-1234", Title: "FortiOS issue", Summary: "Affected versions",
+		Cvss3Score: 8.1, Cvss3Vector: "CVSS:3.1/AV:N", Cvss3Severity: "HIGH",
+		SourceLink: "https://www.fortiguard.com/psirt/FG-IR-23-001",
+		CweIDs:     []string{"CWE-79"}, References: []Reference{{Link: "https://example.com/reference", Source: "Fortinet"}},
+		Published: published, LastModified: modified,
+	}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("ConvertFortinetToModel() = %#v, want %#v", got, want)
+	}
+}
+
+func TestFortinetContentSelection(t *testing.T) {
+	contents := NewCveContents(
+		CveContent{Type: Nvd, Title: "NVD title", Summary: "NVD summary", Cvss3Score: 7},
+		CveContent{Type: Fortinet, Title: "Fortinet title", Summary: "Fortinet summary", Cvss3Score: 9, SourceLink: "https://example.com/first"},
+		CveContent{Type: Fortinet, Title: "Second advisory", Summary: "Second summary", SourceLink: "https://example.com/second"},
+	)
+	if len(contents[Fortinet]) != 2 {
+		t.Fatalf("Fortinet advisories = %d, want 2", len(contents[Fortinet]))
+	}
+	v := VulnInfo{CveID: "CVE-2023-1234", CveContents: contents}
+	if got := v.Titles("en", ""); len(got) == 0 || got[0] != (CveContentStr{Type: Fortinet, Value: "Fortinet title"}) {
+		t.Fatalf("first title = %v, want Fortinet title", got)
+	}
+	if got := v.Summaries("en", ""); len(got) == 0 || got[0] != (CveContentStr{Type: Fortinet, Value: "Fortinet summary"}) {
+		t.Fatalf("first summary = %v, want Fortinet summary", got)
+	}
+	if got := v.Cvss3Scores(); len(got) == 0 || got[0].Type != Fortinet || got[0].Value.Score != 9 {
+		t.Fatalf("first CVSS v3 score = %v, want Fortinet 9", got)
+	}
+}
