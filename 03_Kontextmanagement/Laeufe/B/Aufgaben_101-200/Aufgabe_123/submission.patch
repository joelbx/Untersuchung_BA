diff --git a/packages/components/containers/notifications/notifications.spec.tsx b/packages/components/containers/notifications/notifications.spec.tsx
new file mode 100644
index 0000000..907b17a
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.spec.tsx
@@ -0,0 +1,69 @@
+import React, { Dispatch, SetStateAction } from 'react';
+import { render } from '@testing-library/react';
+
+import Notification from './Notification';
+import createNotificationManager from './manager';
+import { NotificationOptions } from './interfaces';
+
+describe('notifications', () => {
+    it('renders safe HTML and opens all links in a new tab', () => {
+        const { container, rerender } = render(
+            <Notification type="error" isClosing={false} onExit={jest.fn()}>
+                {'See <a href="https://example.com" target="_self" rel="opener">help</a><script>alert(1)</script>'}
+            </Notification>
+        );
+
+        const link = container.querySelector('a');
+        expect(link?.getAttribute('href')).toBe('https://example.com');
+        expect(link?.getAttribute('target')).toBe('_blank');
+        expect(link?.getAttribute('rel')).toBe('noopener noreferrer');
+        expect(container.querySelector('script')).toBeNull();
+
+        rerender(
+            <Notification type="error" isClosing={false} onExit={jest.fn()}>
+                {'<a href="javascript:alert(1)">unsafe link</a>'}
+            </Notification>
+        );
+        expect(container.querySelector('a')?.hasAttribute('href')).toBe(false);
+
+        rerender(
+            <Notification type="info" isClosing={false} onExit={jest.fn()}>
+                <a href="https://example.com">React link</a>
+            </Notification>
+        );
+        expect(container.querySelector('a')?.getAttribute('target')).toBe('_blank');
+        expect(container.querySelector('a')?.getAttribute('rel')).toBe('noopener noreferrer');
+    });
+
+    it('deduplicates non-success notifications by explicit or fallback key', () => {
+        jest.useFakeTimers();
+        let notifications: NotificationOptions[] = [];
+        const setNotifications: Dispatch<SetStateAction<NotificationOptions[]>> = (update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        };
+        const manager = createNotificationManager(setNotifications);
+
+        manager.createNotification({ text: 'same', type: 'error' });
+        manager.createNotification({ text: 'same', type: 'info' });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('same');
+
+        manager.createNotification({ text: 'same', key: 'explicit', type: 'info' });
+        expect(notifications).toHaveLength(2);
+        expect(notifications[1].key).toBe('explicit');
+
+        manager.createNotification({ text: <span>one</span>, key: 'shared', type: 'warning' });
+        manager.createNotification({ text: <span>two</span>, key: 'shared', type: 'warning' });
+        expect(notifications).toHaveLength(3);
+        expect(notifications[2].key).toBe('shared');
+
+        manager.createNotification({ text: <span>three</span>, type: 'error' });
+        expect(notifications[3].key).toBe(notifications[3].id);
+
+        manager.createNotification({ text: 'same', type: 'success' });
+        manager.createNotification({ text: 'same', type: 'success' });
+        expect(notifications).toHaveLength(6);
+        manager.clearNotifications();
+        jest.useRealTimers();
+    });
+});
