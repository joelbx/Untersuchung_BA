-class TarManager:
+SIZES = ('', 's', 'm', 'l')
+
+
+def _size(size):
+    size = size.lower()
+    if size not in SIZES:
+        raise ValueError(f'Invalid size: {size}')
+    return size
+
+
+class Cover:
+    def __init__(self, attributes):
+        self.attributes = attributes
+        self.id = int(attributes['id'])
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        number = int(cover_id)
+        if not 0 <= number < 10_000_000_000:
+            raise ValueError('Cover ID must fit in ten digits')
+        padded = f'{number:010d}'
+        return padded[:4], padded[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        if protocol not in ('http', 'https'):
+            raise ValueError('Invalid protocol')
+        size = _size(size)
+        ext = ext.lstrip('.')
+        if not ext or '/' in ext or '\\' in ext:
+            raise ValueError('Invalid extension')
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        suffix = f'-{size.upper()}' if size else ''
+        return (f'{protocol}://archive.org/download/{item}/'
+                f'{item}_{batch_id}.zip/{int(cover_id):010d}{suffix}.{ext}')
+
+    def local_files(self):
+        result = {}
+        for size in SIZES:
+            field = f'filename_{size}' if size else 'filename'
+            filename = self.attributes.get(field)
+            if not filename:
+                return None
+            path = os.path.join(config.data_root, 'localdisk', filename)
+            if not os.path.isfile(path):
+                return None
+            result[size] = path
+        return result
+
+
+class CoverDB:
+    def __init__(self):
+        self.db = db.getdb()
+
+    @staticmethod
+    def _get_batch_end_id(start_id):
+        return (int(start_id) // 10_000 + 1) * 10_000 - 1
+
+    def pending(self, start_id=0):
+        return self.db.select('cover', where='id >= $start_id AND failed=false '
+                              'AND (archived=false OR archived IS NULL)',
+                              vars={'start_id': start_id}, order='id', limit=1)
+
+    def batch_covers(self, item_id, batch_id):
+        start_id = int(item_id) * 1_000_000 + int(batch_id) * 10_000
+        end_id = self._get_batch_end_id(start_id)
+        return self.db.select('cover', where='id >= $start_id AND id <= $end_id '
+                              'AND failed=false AND (archived=false OR archived IS NULL)',
+                              vars={'start_id': start_id, 'end_id': end_id}, order='id')
+
+    @staticmethod
+    def update_completed_batch(item_id, batch_id, ext='jpg'):
+        database = db.getdb()
+        transaction = database.transaction()
+        try:
+            rows = CoverDB().batch_covers(item_id, batch_id)
+            for row in rows:
+                database.update('cover', where='id=$cover_id AND failed=false',
+                    vars={'cover_id': row.id}, archived=True, uploaded=True,
+                    filename=Cover.get_cover_url(row.id, ext=ext),
+                    filename_s=Cover.get_cover_url(row.id, 's', ext),
+                    filename_m=Cover.get_cover_url(row.id, 'm', ext),
+                    filename_l=Cover.get_cover_url(row.id, 'l', ext))
+            transaction.commit()
+        except Exception:
+            transaction.rollback()
+            raise
