+def open_zipfile(name):
+    stem = name.split('.', 1)[0]
+    cover_id = int(stem.split('-', 1)[0])
+    size = stem.split('-', 1)[1].lower() if '-' in stem else ''
+    item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+    path = Batch.get_abspath(item_id, batch_id, size)
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    return zipfile.ZipFile(path, 'a', compression=zipfile.ZIP_STORED)
+
+
+def get_zipfile(name):
+    return open_zipfile(name)
+
+
+def count_files_in_zip(filepath):
+    with zipfile.ZipFile(filepath) as archive:
+        return sum(name.lower().endswith('.jpg') for name in archive.namelist())
+
+
+class Uploader:
+    @staticmethod
+    def upload(itemname: str, filepaths: list[str]):
+        return subprocess.run(['ia', 'upload', itemname, *filepaths, '--retries', '10'],
+                              text=True, capture_output=True, check=True)
+
+    @staticmethod
+    def is_uploaded(item: str, zip_filename: str, verbose=False):
+        result = subprocess.run(['ia', 'list', item], text=True, capture_output=True, check=True)
+        found = zip_filename in result.stdout.splitlines()
+        if verbose:
+            print(item, zip_filename, 'uploaded' if found else 'missing')
+        return found
+
+
+def archive(test=True, start_id=0, limit=10_000):
+    """Stage one batch. Local references remain authoritative until finalization."""
+    coverdb = CoverDB()
+    pending = list(coverdb.pending(start_id))
+    if not pending:
+        return None
+    item_id, batch_id = Cover.id_to_item_and_batch_id(pending[0].id)
+    batch = Batch(item_id, batch_id)
+    with batch.lock():
+        manager = ZipManager()
+        try:
+            for row in list(coverdb.batch_covers(item_id, batch_id))[:limit]:
+                files = Cover(row).local_files()
+                if not files:
+                    if not test:
+                        coverdb.db.update('cover', where='id=$cover_id AND failed=false',
+                                          vars={'cover_id': row.id}, failed=True)
+                    continue
+                created = row.created
+                if isinstance(created, str):
+                    from infogami.infobase import utils
+                    created = utils.parse_datetime(created)
+                mtime = time.mktime(created.timetuple())
+                if not test:
+                    for size, path in files.items():
+                        suffix = f'-{size.upper()}' if size else ''
+                        manager.add_file(f'{row.id:010d}{suffix}.jpg', path, mtime)
+        finally:
+            manager.close()
+    return batch
