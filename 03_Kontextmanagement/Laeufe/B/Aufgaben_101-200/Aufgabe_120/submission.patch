+import os
+import zipfile
+
+import pytest
+import web
+
+from openlibrary.coverstore import archive, config
+
+
+def test_cover_id_and_url():
+    assert archive.Cover.id_to_item_and_batch_id(8_123_456) == ('0008', '12')
+    assert archive.Cover.get_cover_url(8_123_456, 'm') == (
+        'https://archive.org/download/m_covers_0008/'
+        'm_covers_0008_12.zip/0008123456-M.jpg'
+    )
+    assert archive.Cover.get_cover_url(8_123_456, protocol='http', ext='png') == (
+        'http://archive.org/download/covers_0008/'
+        'covers_0008_12.zip/0008123456.png'
+    )
+    with pytest.raises(ValueError):
+        archive.Cover.id_to_item_and_batch_id(10_000_000_000)
+
+
+def test_zip_manager_is_uncompressed_and_idempotent(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    image = tmp_path / 'image.jpg'
+    image.write_bytes(b'image')
+    manager = archive.ZipManager()
+    name = '0008123456-S.jpg'
+    manager.add_file(name, str(image), 1_600_000_000)
+    manager.add_file(name, str(image), 1_600_000_000)
+    manager.close()
+    path = archive.Batch.get_abspath(8, 12, 's')
+    assert path == os.path.join(str(tmp_path), 'items', 's_covers_0008', 's_covers_0008_12.zip')
+    with zipfile.ZipFile(path) as zf:
+        assert zf.namelist() == [name]
+        assert zf.read(name) == b'image'
+        assert zf.getinfo(name).compress_type == zipfile.ZIP_STORED
+    assert archive.count_files_in_zip(path) == 1
+
+
+def test_batch_finalizes_only_after_all_sizes_are_uploaded(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    image = tmp_path / 'image.jpg'
+    image.write_bytes(b'image')
+    manager = archive.ZipManager()
+    for size in archive.SIZES:
+        suffix = f'-{size.upper()}' if size else ''
+        manager.add_file(f'0008123456{suffix}.jpg', str(image), 1_600_000_000)
+    manager.close()
+
+    updated = []
+
+    class FakeDB:
+        def batch_covers(self, item_id, batch_id):
+            return [web.storage(id=8_123_456)]
+
+        @staticmethod
+        def update_completed_batch(item_id, batch_id, ext='jpg'):
+            updated.append((item_id, batch_id))
+
+    class FakeUploader:
+        present = set()
+
+        def is_uploaded(self, item, filename):
+            return filename in self.present
+
+    monkeypatch.setattr(archive, 'CoverDB', FakeDB)
+    uploader = FakeUploader()
+    batch = archive.Batch(8, 12)
+    assert batch.process_pending(finalize=True, uploader=uploader) is False
+    assert updated == []
+    uploader.present = {
+        os.path.basename(batch.get_abspath(8, 12, size)) for size in archive.SIZES
+    }
+    assert batch.process_pending(finalize=True, test=True, uploader=uploader) is True
+    assert updated == []
+    assert batch.process_pending(finalize=True, uploader=uploader) is True
+    assert updated == [('0008', '12')]
