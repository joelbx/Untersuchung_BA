+class Batch:
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id = item_id, batch_id
+        self.size = None if size is None else _size(size)
+        self._norm_ids()
+
+    def _norm_ids(self):
+        item_id, batch_id = int(self.item_id), int(self.batch_id)
+        if not 0 <= item_id <= 9999 or not 0 <= batch_id <= 99:
+            raise ValueError('Invalid item or batch ID')
+        return f'{item_id:04d}', f'{batch_id:02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = cls(item_id, batch_id)._norm_ids()
+        size = _size(size)
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        return os.path.join('items', item, f'{item}_{batch_id}.{ext.lstrip(".")}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    @contextmanager
+    def lock(self):
+        item_id, batch_id = self._norm_ids()
+        lock_dir = os.path.join(config.data_root, 'items', '.locks')
+        os.makedirs(lock_dir, exist_ok=True)
+        with open(os.path.join(lock_dir, f'{item_id}_{batch_id}.lock'), 'a+b') as file:
+            fcntl.flock(file, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            try:
+                yield
+            finally:
+                fcntl.flock(file, fcntl.LOCK_UN)
+
+    def finalize(self, start_id=None, test=False, uploader=None, verified=False):
+        item_id, batch_id = self._norm_ids()
+        paths = {size: self.get_abspath(item_id, batch_id, size) for size in SIZES}
+        if not all(os.path.isfile(path) for path in paths.values()):
+            return False
+        if not verified:
+            uploader = uploader or Uploader()
+            for size, path in paths.items():
+                item = f'{size}_covers_{item_id}' if size else f'covers_{item_id}'
+                if not uploader.is_uploaded(item, os.path.basename(path)):
+                    return False
+        rows = list(CoverDB().batch_covers(item_id, batch_id))
+        if not rows:
+            return True
+        for size, path in paths.items():
+            suffix = f'-{size.upper()}' if size else ''
+            expected = {f'{row.id:010d}{suffix}.jpg' for row in rows}
+            with zipfile.ZipFile(path) as archive:
+                if not expected.issubset(set(archive.namelist())):
+                    return False
+        if not test:
+            CoverDB.update_completed_batch(item_id, batch_id)
+            for row in rows:
+                files = Cover(row).local_files()
+                if files:
+                    for path in files.values():
+                        os.remove(path)
+            for path in paths.values():
+                os.remove(path)
+        return True
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        sizes = SIZES if self.size is None else (self.size,)
+        item_id, batch_id = self._norm_ids()
+        uploader = uploader or Uploader()
+        with self.lock():
+            paths = {size: self.get_abspath(item_id, batch_id, size) for size in sizes}
+            if not all(os.path.isfile(path) for path in paths.values()):
+                return False
+            for size, path in paths.items():
+                item = f'{size}_covers_{item_id}' if size else f'covers_{item_id}'
+                if not uploader.is_uploaded(item, os.path.basename(path)):
+                    if upload and not test:
+                        uploader.upload(item, [path])
+                    if not uploader.is_uploaded(item, os.path.basename(path)):
+                        return False
+            if finalize:
+                return self.size is None and self.finalize(test=test, verified=True)
+            return True
+
