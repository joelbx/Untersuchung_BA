+const maxProxyHelloBytes = 64 * 1024
+
+// readProxyHello reads the null-terminated metadata preceding an SSH handshake.
+// The caller replays the returned bytes to the SSH server.
+func readProxyHello(reader *bufio.Reader) ([]byte, net.Addr, error) {
+	header := make([]byte, 0, len(proxyHelloPrefix)+128)
+	for len(header) < maxProxyHelloBytes {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err, "failed to read Teleport proxy header")
+		}
+		header = append(header, b)
+		if b == 0 {
+			break
+		}
+	}
+	if len(header) == maxProxyHelloBytes && header[len(header)-1] != 0 {
+		return nil, nil, trace.BadParameter("Teleport proxy header exceeds %d bytes", maxProxyHelloBytes)
+	}
+	if !bytes.HasPrefix(header, proxyHelloPrefix) {
+		return nil, nil, trace.BadParameter("invalid Teleport proxy prefix")
+	}
+
+	var payload apiSSHUtils.HandshakePayload
+	if err := json.Unmarshal(header[len(proxyHelloPrefix):len(header)-1], &payload); err != nil {
+		return nil, nil, trace.Wrap(err, "invalid Teleport proxy payload")
+	}
+	if payload.ClientAddr == "" {
+		return header, nil, nil
+	}
+	addr, err := utils.ParseAddr(payload.ClientAddr)
+	if err != nil {
+		return nil, nil, trace.Wrap(err, "invalid Teleport proxy client address")
+	}
+	if addr.AddrNetwork == "tcp" {
+		return header, &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}, nil
+	}
+	return header, addr, nil
+}
