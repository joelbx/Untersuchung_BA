@@ -0,0 +1,20 @@
+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	previous := Server.Backup
+	t.Cleanup(func() { Server.Backup = previous })
+	Server.Backup.Count = 1
+	Server.Backup.Schedule = "1h"
+	if err := validateBackupSchedule(); err != nil {
+		t.Fatal(err)
+	}
+	if Server.Backup.Schedule != "@every 1h" {
+		t.Fatalf("schedule was not normalized: %q", Server.Backup.Schedule)
+	}
+	Server.Backup.Schedule = "invalid schedule"
+	if err := validateBackupSchedule(); err == nil {
+		t.Fatal("invalid schedule was accepted")
+	}
+}
