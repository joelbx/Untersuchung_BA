index 0000000..c3781de
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,178 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+
+var backupName = regexp.MustCompile(`^navidrome_backup_\d{8}T\d{6}\.\d{9}Z\.db$`)
+
+// Backup copies a consistent snapshot of the live database to the configured directory.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", fmt.Errorf("create backup directory: %w", err)
+	}
+	path := filepath.Join(dir, backupPrefix+time.Now().UTC().Format("20060102T150405.000000000Z")+".db")
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", fmt.Errorf("create backup file: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	dest, err := sql.Open(Driver, path)
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	err = copySQLite(ctx, dest, d.readDB)
+	err = errors.Join(err, dest.Close())
+	if err != nil {
+		_ = os.Remove(path)
+		return "", fmt.Errorf("backup database: %w", err)
+	}
+	return path, nil
+}
+
+// Restore replaces the live database using SQLite's online backup API.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	backupPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	info, err := os.Stat(backupPath)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("backup file must be a regular file")
+	}
+	if dbPath, err := filepath.Abs(conf.Server.DbPath); err == nil {
+		if liveInfo, err := os.Stat(dbPath); err == nil && os.SameFile(info, liveInfo) {
+			return errors.New("backup file is the live database")
+		}
+	}
+	u := url.URL{Scheme: "file", Path: backupPath, RawQuery: "mode=ro"}
+	src, err := sql.Open(Driver, u.String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var check string
+	if err := src.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&check); err != nil {
+		return fmt.Errorf("check backup file: %w", err)
+	}
+	if check != "ok" {
+		return fmt.Errorf("backup file failed integrity check: %s", check)
+	}
+	var schemaCount int
+	if err := src.QueryRowContext(ctx, "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='goose_db_version'").Scan(&schemaCount); err != nil {
+		return fmt.Errorf("check backup schema: %w", err)
+	}
+	if schemaCount == 0 {
+		return errors.New("backup file is not a Navidrome database")
+	}
+	if err := copySQLite(ctx, d.writeDB, src); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+func copySQLite(ctx context.Context, dest, src *sql.DB) error {
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	return destConn.Raw(func(destRaw any) error {
+		d, ok := destRaw.(*sqlite3.SQLiteConn)
+		if !ok {
+			return errors.New("destination is not SQLite")
+		}
+		return srcConn.Raw(func(srcRaw any) error {
+			s, ok := srcRaw.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("source is not SQLite")
+			}
+			backup, err := d.Backup("main", s, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					return errors.Join(err, backup.Finish())
+				}
+				done, err := backup.Step(-1)
+				if err != nil {
+					return errors.Join(err, backup.Finish())
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+// prune removes older Navidrome backups, ordered by their timestamped names.
+func prune(ctx context.Context) (int, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return 0, errors.New("backup.path is not configured")
+	}
+	count := conf.Server.Backup.Count
+	if count < 0 {
+		return 0, errors.New("backup.count must be non-negative")
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if entry.Type().IsRegular() && backupName.MatchString(entry.Name()) {
+			names = append(names, entry.Name())
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(dir, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
new file mode 100644
index 0000000..5383e5e
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,95 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	livePath := filepath.Join(dir, "live.db")
+	backupDir := filepath.Join(dir, "backups")
+	if err := os.Mkdir(backupDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	oldBackup := conf.Server.Backup
+	oldDBPath := conf.Server.DbPath
+	t.Cleanup(func() {
+		conf.Server.Backup = oldBackup
+		conf.Server.DbPath = oldDBPath
+	})
+	conf.Server.Backup.Path = backupDir
+	conf.Server.DbPath = livePath
+
+	live, err := sql.Open(Driver, livePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE goose_db_version (id INTEGER); CREATE TABLE items (name TEXT); INSERT INTO items VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	database := &db{readDB: live, writeDB: live}
+	first, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := live.Exec("UPDATE items SET name = 'changed'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backups should have distinct names")
+	}
+	if err := database.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var name string
+	if err := live.QueryRow("SELECT name FROM items").Scan(&name); err != nil || name != "original" {
+		t.Fatalf("restored value = %q, error = %v", name, err)
+	}
+	conf.Server.Backup.Count = 1
+	removed, err := database.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned = %d, error = %v", removed, err)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatalf("latest backup missing: %v", err)
+	}
+	conf.Server.Backup.Count = 0
+	removed, err = database.Prune(ctx)
+	if err != nil || removed != 1 {
+		t.Fatalf("pruned with zero retention = %d, error = %v", removed, err)
+	}
+}
+
+func TestRestoreRejectsNonNavidromeDatabase(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "other.db")
+	source, err := sql.Open(Driver, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := source.Exec("CREATE TABLE other (id INTEGER)"); err != nil {
+		t.Fatal(err)
+	}
+	source.Close()
+	live, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	database := &db{readDB: live, writeDB: live}
+	if err := database.Restore(context.Background(), path); err == nil {
+		t.Fatal("expected invalid backup schema to be rejected")
+	}
+}
