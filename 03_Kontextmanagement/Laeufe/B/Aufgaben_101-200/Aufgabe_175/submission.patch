+package cmd
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Create, prune, or restore database backups"}
+	createCmd := &cobra.Command{
+		Use: "create", Short: "Create a database backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			database := db.Db()
+			defer database.Close()
+			path, err := database.Backup(cmd.Context())
+			if err == nil {
+				_, _ = fmt.Fprintln(cmd.OutOrStdout(), path)
+			}
+			return err
+		},
+	}
+	pruneCmd := &cobra.Command{
+		Use: "prune", Short: "Remove old database backups", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, _ := cmd.Flags().GetBool("force")
+			if conf.Server.Backup.Count == 0 && !force {
+				if !confirmBackupAction(cmd, "backup.count is 0; delete all backups?") {
+					return errors.New("backup pruning cancelled")
+				}
+			}
+			database := db.Db()
+			defer database.Close()
+			removed, err := database.Prune(cmd.Context())
+			if err == nil {
+				_, _ = fmt.Fprintf(cmd.OutOrStdout(), "Removed %d backups\n", removed)
+			}
+			return err
+		},
+	}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation when backup.count is 0")
+	restoreCmd := &cobra.Command{
+		Use: "restore", Short: "Restore a database backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, _ := cmd.Flags().GetString("backup-file")
+			force, _ := cmd.Flags().GetBool("force")
+			if !force && !confirmBackupAction(cmd, "Replace the current database with the backup?") {
+				return errors.New("database restore cancelled")
+			}
+			database := db.Db()
+			defer database.Close()
+			if err := database.Restore(cmd.Context(), path); err != nil {
+				return err
+			}
+			_, _ = fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+			return nil
+		},
+	}
+	restoreCmd.Flags().String("backup-file", "", "path of the backup database to restore")
+	restoreCmd.Flags().Bool("force", false, "skip restore confirmation")
+	_ = restoreCmd.MarkFlagRequired("backup-file")
+	backupCmd.AddCommand(createCmd, pruneCmd, restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackupAction(cmd *cobra.Command, prompt string) bool {
+	_, _ = fmt.Fprintf(cmd.OutOrStdout(), "%s [y/N]: ", prompt)
+	line, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	if err != nil && line == "" {
+		return false
+	}
+	answer := strings.ToLower(strings.TrimSpace(line))
+	return answer == "y" || answer == "yes"
+}
