+@pytest.mark.parametrize('filter_name, expected', [('min', {'size': 1}), ('max', {'size': 3})])
+def test_min_max_attribute(filter_name, expected):
+    values = [{'size': 2}, {'size': 3}, {'size': 1}]
+    assert getattr(ms, filter_name)(env, values, attribute='size') == expected
+
+
+@pytest.mark.parametrize('filter_name, expected', [('min', '1'), ('max', '3')])
+def test_min_max_attribute_in_template(filter_name, expected):
+    template_env = Environment()
+    template_env.filters[filter_name] = getattr(ms, filter_name)
+    template = template_env.from_string("{{ (values | %s(attribute='size')).size }}" % filter_name)
+    values = [{'size': 2}, {'size': 3}, {'size': 1}]
+    assert template.render(values=values) == expected
+
+
+@pytest.mark.parametrize('filter_name, expected', [('min', 'B'), ('max', 'a')])
+def test_min_max_case_sensitive(filter_name, expected):
+    assert getattr(ms, filter_name)(env, ['a', 'B'], case_sensitive=True) == expected
+
+
+@pytest.mark.parametrize('filter_name', ['min', 'max'])
+def test_min_max_forwards_all_keywords(monkeypatch, filter_name):
+    calls = []
+
+    def jinja_filter(environment, values, **kwargs):
+        calls.append((environment, values, kwargs))
+        return 'result'
+
+    monkeypatch.setattr(ms, 'do_' + filter_name, jinja_filter)
+    values = [1, 2]
+    assert getattr(ms, filter_name)(env, values, attribute='size', case_sensitive=True, custom=True) == 'result'
+    assert calls == [(env, values, {'attribute': 'size', 'case_sensitive': True, 'custom': True})]
+
+
+@pytest.mark.parametrize('filter_name, expected', [('min', 1), ('max', 3)])
+def test_min_max_fallback(monkeypatch, filter_name, expected):
+    monkeypatch.setattr(ms, 'do_' + filter_name, None)
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, [2, 3, 1]) == expected
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(env, [2, 3, 1], attribute='size')
+    assert error.value.message == (
+        "Ansible's %s filter does not support any keyword arguments. "
+        "You need Jinja2 2.10 or later that provides their version of the filter." % filter_name
+    )
 
 
