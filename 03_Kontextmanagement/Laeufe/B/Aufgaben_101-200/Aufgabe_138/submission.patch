+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, test := range []struct {
+		name             string
+		options          []containers.Option[StoreOptions]
+		wantArtifactType string
+		wantConfigType   string
+	}{
+		{
+			name:             "default 1.1",
+			wantArtifactType: MediaTypeFliptFeatures,
+			wantConfigType:   v1.MediaTypeEmptyJSON,
+		},
+		{
+			name:           "configured 1.0",
+			options:        []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)},
+			wantConfigType: MediaTypeFliptFeatures,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.Background()
+			ref, err := ParseReference("flipt://local/testrepo:latest")
+			require.NoError(t, err)
+			store, err := NewStore(zaptest.NewLogger(t), t.TempDir(), test.options...)
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			_, err = store.Build(ctx, src, ref)
+			require.NoError(t, err)
+
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			manifestBytes, err := content.FetchAll(ctx, target, desc)
+			require.NoError(t, err)
+			var manifest v1.Manifest
+			require.NoError(t, json.Unmarshal(manifestBytes, &manifest))
+			assert.Equal(t, test.wantArtifactType, manifest.ArtifactType)
+			assert.Equal(t, test.wantConfigType, manifest.Config.MediaType)
+
+			resp, err := store.Fetch(ctx, ref)
+			require.NoError(t, err)
+			assert.Len(t, resp.Files, 2)
+		})
+	}
+}
