+import React from "react";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import InteractiveAuthComponent from "../../../src/components/structures/InteractiveAuth";
+import { RegistrationTokenAuthEntry } from "../../../src/components/views/auth/InteractiveAuthEntryComponents";
+import { getMockClientWithEventEmitter, unmockClientPeg } from "../../test-utils";
+
+describe("registration token interactive authentication", () => {
+    const matrixClient = getMockClientWithEventEmitter({
+        generateClientSecret: jest.fn().mockReturnValue("client-secret"),
+    });
+
+    afterAll(() => unmockClientPeg());
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits the advertised %s stage and finishes the flow",
+        async (stage) => {
+            const response = { user_id: "@user:example.org" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+
+            const { container } = render(
+                <InteractiveAuthComponent
+                    matrixClient={matrixClient}
+                    authData={{ session: "session-id", flows: [{ stages: [stage] }] }}
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+            );
+
+            const field = await screen.findByRole("textbox", { name: "Registration token" });
+            expect(field).toHaveAttribute("name", "registrationTokenField");
+            expect(field).toHaveFocus();
+            expect(
+                screen.getByText("Enter a registration token provided by the homeserver administrator."),
+            ).toBeTruthy();
+            expect(onStagePhaseChange).toHaveBeenCalledWith(stage, 0);
+
+            const button = screen.getByRole("button", { name: "Continue" });
+            expect(button).toBeDisabled();
+            fireEvent.change(field, { target: { value: "my-token" } });
+            expect(button).toBeEnabled();
+            fireEvent.submit(container.querySelector("form"));
+
+            await waitFor(() =>
+                expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                    clientSecret: "client-secret",
+                    emailSid: undefined,
+                }),
+            );
+            expect(makeRequest).toHaveBeenCalledWith({
+                session: "session-id",
+                type: stage,
+                token: "my-token",
+            });
+        },
+    );
+
+    it("shows an error and prevents submissions while busy", () => {
+        const submitAuthDict = jest.fn();
+        const props = {
+            matrixClient,
+            loginType: AuthType.RegistrationToken,
+            authSessionId: "session-id",
+            busy: false,
+            errorText: "Token rejected",
+            onPhaseChange: jest.fn(),
+            submitAuthDict,
+        };
+        const { container, rerender } = render(<RegistrationTokenAuthEntry {...props} />);
+
+        expect(screen.getByRole("alert")).toHaveTextContent("Token rejected");
+        expect(screen.getByRole("alert")).toHaveClass("error");
+        const field = screen.getByRole("textbox", { name: "Registration token" });
+        fireEvent.change(field, { target: { value: "my-token" } });
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: AuthType.RegistrationToken, token: "my-token" });
+
+        submitAuthDict.mockClear();
+        rerender(<RegistrationTokenAuthEntry {...props} busy={true} />);
+        expect(screen.queryByRole("button", { name: "Continue" })).toBeNull();
+        expect(screen.getByLabelText("Loading...")).toBeTruthy();
+        fireEvent.submit(container.querySelector("form"));
+        expect(submitAuthDict).not.toHaveBeenCalled();
+    });
+});
