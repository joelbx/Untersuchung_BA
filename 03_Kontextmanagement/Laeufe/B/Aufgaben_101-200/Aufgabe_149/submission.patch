index b38fab4..8f48167 100644
--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -383,6 +383,51 @@ class TestQtArgs:
         assert combined_flag in args
         assert overlay_flag not in args
 
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    @pytest.mark.parametrize('overlay', [True, False])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch, parser,
+                                         via_commandline, overlay):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+
+        flags = ['enable-features=First,Second',
+                 'disable-features=Blocked,Other',
+                 'enable-features=Third',
+                 'disable-features=Last']
+        config_stub.val.qt.args = [] if via_commandline else flags
+        commandline = [arg for flag in flags for arg in ('--qt-flag', flag)] \
+            if via_commandline else []
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+        expected_enabled = 'First,Second,Third'
+        if overlay:
+            expected_enabled += ',OverlayScrollbar'
+
+        enabled = [arg for arg in args
+                   if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        disabled = [arg for arg in args
+                    if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)]
+        assert enabled == [qtargs.ENABLE_FEATURES_PREFIX + expected_enabled]
+        assert disabled == ['--disable-features=Blocked,Other',
+                            '--disable-features=Last']
+
+    def test_disable_features_without_enabled_features(
+            self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['disable-features=Blocked,Other']
+
+        args = qtargs.qt_args(parser.parse_args([]))
+
+        assert '--disable-features=Blocked,Other' in args
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+
