diff --git a/test/units/executor/test_display_proxy.py b/test/units/executor/test_display_proxy.py
new file mode 100644
index 0000000..6fe1ee8
--- /dev/null
+++ b/test/units/executor/test_display_proxy.py
@@ -0,0 +1,53 @@
+from unittest.mock import MagicMock
+
+from ansible.executor.task_queue_manager import DisplaySend, FinalQueue
+from ansible.plugins.strategy import StrategySentinel, results_thread_main
+
+
+def test_final_queue_preserves_display_method_and_arguments():
+    queue = MagicMock()
+
+    FinalQueue.send_display(queue, 'warning', 'message', formatted=True)
+
+    queue.put.assert_called_once()
+    sent = queue.put.call_args.args[0]
+    assert isinstance(sent, DisplaySend)
+    assert (sent.method, sent.args, sent.kwargs) == ('warning', ('message',), {'formatted': True})
+
+
+def test_results_thread_dispatches_display_methods(monkeypatch):
+    from ansible.plugins import strategy as strategy_module
+
+    warning = MagicMock()
+    deprecated = MagicMock()
+    monkeypatch.setattr(strategy_module.display, 'warning', warning)
+    monkeypatch.setattr(strategy_module.display, 'deprecated', deprecated)
+    strategy = MagicMock()
+    strategy._final_q.get.side_effect = [
+        DisplaySend('warning', 'message'),
+        DisplaySend('deprecated', 'old feature', version='2.0'),
+        StrategySentinel(),
+    ]
+
+    results_thread_main(strategy)
+
+    warning.assert_called_once_with('message')
+    deprecated.assert_called_once_with('old feature', version='2.0')
+
+
+def test_results_thread_deduplicates_warnings_from_multiple_workers(monkeypatch):
+    from ansible.plugins import strategy as strategy_module
+
+    output = MagicMock()
+    monkeypatch.setattr(strategy_module.display, '_warns', {})
+    monkeypatch.setattr(strategy_module.display, 'display', output)
+    strategy = MagicMock()
+    strategy._final_q.get.side_effect = [
+        DisplaySend('warning', 'repeated message'),
+        DisplaySend('warning', 'repeated message'),
+        StrategySentinel(),
+    ]
+
+    results_thread_main(strategy)
+
+    output.assert_called_once()
