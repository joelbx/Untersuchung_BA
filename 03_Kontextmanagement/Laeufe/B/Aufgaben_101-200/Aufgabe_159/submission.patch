+package sbom
+
+import "testing"
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		pkgType, pkgName      string
+		namespace, name, path string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package_Name", "", "my-package-name", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"npm", "unscoped", "", "unscoped", ""},
+		{"maven", "artifact", "", "artifact", ""},
+		{"unknown", "org/example", "", "org/example", ""},
+		{"pom", "org.example:artifact", "org.example", "artifact", ""},
+		{"gomod", "example.com/team/module", "example.com/team", "module", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pkgType+"/"+tt.pkgName, func(t *testing.T) {
+			namespace, name, path := parsePkgName(tt.pkgType, tt.pkgName)
+			if namespace != tt.namespace || name != tt.name || path != tt.path {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.pkgType, tt.pkgName, namespace, name, path, tt.namespace, tt.name, tt.path)
+			}
+		})
+	}
+}
