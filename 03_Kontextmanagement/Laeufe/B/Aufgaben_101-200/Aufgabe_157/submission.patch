index 0000000..7370a4c
--- /dev/null
+++ b/applications/mail/src/app/metrics/mailMetricsHelper.test.ts
@@ -0,0 +1,24 @@
+import { MAILBOX_LABEL_IDS } from '@proton/shared/lib/constants';
+import type { MailSettings } from '@proton/shared/lib/interfaces';
+import { MAIL_PAGE_SIZE } from '@proton/shared/lib/mail/mailSettings';
+
+import { getLabelID, getPageSizeString } from './mailMetricsHelper';
+
+describe('mailMetricsHelper', () => {
+    it('keeps built-in mailbox IDs and groups custom labels and folders', () => {
+        Object.values(MAILBOX_LABEL_IDS).forEach((labelID) => {
+            expect(getLabelID(labelID)).toBe(labelID);
+        });
+        expect(getLabelID('user-label-id')).toBe('custom');
+        expect(getLabelID('user-folder-id')).toBe('custom');
+    });
+
+    it('returns a standard page size string and defaults to 50', () => {
+        expect(getPageSizeString(undefined)).toBe('50');
+        expect(getPageSizeString({} as MailSettings)).toBe('50');
+        expect(getPageSizeString({ PageSize: MAIL_PAGE_SIZE.FIFTY } as MailSettings)).toBe('50');
+        expect(getPageSizeString({ PageSize: MAIL_PAGE_SIZE.ONE_HUNDRED } as MailSettings)).toBe('100');
+        expect(getPageSizeString({ PageSize: MAIL_PAGE_SIZE.TWO_HUNDRED } as MailSettings)).toBe('200');
+        expect(getPageSizeString({ PageSize: 0 as MAIL_PAGE_SIZE } as MailSettings)).toBe('50');
+    });
+});
diff --git a/applications/mail/src/app/metrics/mailMetricsHelper.ts b/applications/mail/src/app/metrics/mailMetricsHelper.ts
new file mode 100644
index 0000000..89bb15a
--- /dev/null
+++ b/applications/mail/src/app/metrics/mailMetricsHelper.ts
@@ -0,0 +1,20 @@
+import { MAILBOX_LABEL_IDS } from '@proton/shared/lib/constants';
+import type { MailSettings } from '@proton/shared/lib/interfaces';
+import { MAIL_PAGE_SIZE } from '@proton/shared/lib/mail/mailSettings';
+
+export const getLabelID = (labelID: string): MAILBOX_LABEL_IDS | 'custom' =>
+    Object.values(MAILBOX_LABEL_IDS).includes(labelID as MAILBOX_LABEL_IDS)
+        ? (labelID as MAILBOX_LABEL_IDS)
+        : 'custom';
+
+export const getPageSizeString = (settings: MailSettings | undefined): string => {
+    switch (settings?.PageSize) {
+        case MAIL_PAGE_SIZE.ONE_HUNDRED:
+            return '100';
+        case MAIL_PAGE_SIZE.TWO_HUNDRED:
+            return '200';
+        case MAIL_PAGE_SIZE.FIFTY:
+        default:
+            return '50';
+    }
+};
