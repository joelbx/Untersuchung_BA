+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML blocks in stderr while retaining other output."""
+    result = bytearray()
+    last = 0
+    headers = []
+    offset = 0
+    previous = b""
+    for line in stderr.splitlines(keepends=True):
+        window = previous + line
+        for header in _CLIXML_HEADER.finditer(window):
+            start = offset - len(previous) + header.start()
+            end = offset - len(previous) + header.end()
+            if end > offset:
+                headers.append((start, end))
+        offset += len(line)
+        previous = line[-10:]
+
+    for start, header_end in headers:
+        if start < last:
+            continue
+
+        xml_start = re.search(rb"<Objs(?:\s|>)", stderr[header_end:])
+        if xml_start is None:
+            continue
+
+        xml_start = header_end + xml_start.start()
+        # A nested header can precede the first XML element. No other text
+        # belongs to the CLIXML block.
+        preamble = _CLIXML_HEADER.sub(b"", stderr[header_end:xml_start])
+        if preamble.strip():
+            continue
+
+        close = stderr.find(b"</Objs>", xml_start)
+        if close == -1:
+            continue
+
+        end = close + len(b"</Objs>")
+        block = stderr[start:end]
+        try:
+            try:
+                block = block.decode("utf-8").encode("utf-8")
+            except UnicodeDecodeError:
+                block = block.decode("cp437").encode("utf-8")
+            decoded = _parse_clixml(block)
+        except (ET.ParseError, UnicodeError, ValueError):
+            continue
+
+        result.extend(stderr[last:start])
+        result.extend(decoded)
+        last = end
+
+    if last == 0:
+        return stderr
+
+    result.extend(stderr[last:])
+    return bytes(result)
+
+
