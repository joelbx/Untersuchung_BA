+func TestImageReference(t *testing.T) {
+	tests := []struct {
+		name     string
+		image    Image
+		fullName string
+		err      string
+	}{
+		{"tag", Image{Name: "example/app", Tag: "stable"}, "example/app:stable", ""},
+		{"digest", Image{Name: "example/app", Digest: "sha256:abc"}, "example/app@sha256:abc", ""},
+		{"no name", Image{Tag: "stable"}, "", "Invalid arguments : no image name"},
+		{"no identifier", Image{Name: "example/app"}, "", "Invalid arguments : no image tag and digest"},
+		{"conflicting identifiers", Image{Name: "example/app", Tag: "stable", Digest: "sha256:abc"}, "", "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := IsValidImage(tt.image)
+			if tt.err != "" {
+				if err == nil || err.Error() != tt.err {
+					t.Fatalf("expected error %q, got %v", tt.err, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if got := tt.image.GetFullName(); got != tt.fullName {
+				t.Errorf("full name = %q, want %q", got, tt.fullName)
+			}
+		})
+	}
+}
