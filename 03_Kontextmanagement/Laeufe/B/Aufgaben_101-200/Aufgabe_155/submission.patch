+func TestConvertToModelImageDigest(t *testing.T) {
+	b := &base{ServerInfo: config.ServerInfo{Image: config.Image{
+		Name: "example/app", Digest: "sha256:abc",
+	}}}
+	result := b.convertToModel()
+	if result.Image.Name != "example/app" || result.Image.Tag != "" || result.Image.Digest != "sha256:abc" {
+		t.Fatalf("image identifiers were not preserved: %+v", result.Image)
+	}
+	if got := result.Image.GetFullName(); got != "example/app@sha256:abc" {
+		t.Errorf("full name = %q", got)
+	}
+	encoded, err := json.Marshal(result.Image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded struct {
+		Digest string `json:"digest"`
+	}
+	if err := json.Unmarshal(encoded, &decoded); err != nil || decoded.Digest != "sha256:abc" {
+		t.Fatalf("digest missing from JSON: %s, err: %v", encoded, err)
+	}
+}
