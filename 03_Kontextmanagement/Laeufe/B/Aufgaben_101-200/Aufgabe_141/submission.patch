diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..2b3f49f
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,25 @@
+package wordpress
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactives(t *testing.T) {
+	pkgs := models.WordPressPackages{
+		{Name: "core", Type: models.WPCore},
+		{Name: "disabled-theme", Type: models.WPTheme, Status: models.Inactive},
+		{Name: "enabled-theme", Type: models.WPTheme, Status: "active"},
+		{Name: "disabled-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+	}
+	want := models.WordPressPackages{pkgs[0], pkgs[2], pkgs[4]}
+	if got := removeInactives(pkgs); !reflect.DeepEqual(got, want) {
+		t.Errorf("removeInactives() = %#v, want %#v", got, want)
+	}
+	if got := removeInactives(models.WordPressPackages{{Status: models.Inactive}}); got != nil {
+		t.Errorf("removeInactives(all inactive) = %#v, want nil", got)
+	}
+}
