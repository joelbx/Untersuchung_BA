+func TestWpIgnoreInactiveFromTOML(t *testing.T) {
+	previous := Conf
+	defer func() { Conf = previous }()
+
+	dir, err := ioutil.TempDir("", "vuls-wp-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "config.toml")
+	if err := ioutil.WriteFile(path, []byte("wpIgnoreInactive = true\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	Conf = Config{}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !Conf.WpIgnoreInactive {
+		t.Fatal("wpIgnoreInactive from config file was not loaded")
+	}
+}
