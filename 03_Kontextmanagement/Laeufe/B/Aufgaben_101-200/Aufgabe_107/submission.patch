--- /dev/null
+++ b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.test.ts
@@ -0,0 +1,81 @@
+import { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+import { optimisticMarkAs } from '../elementsActions';
+import elementsReducer, { newState } from '../elementsSlice';
+import { getElementsToBypassFilter } from './elementBypassFilters';
+
+const message = { ID: 'message-1', ConversationID: 'conversation-1' } as Element;
+
+describe('getElementsToBypassFilter', () => {
+    it.each([
+        [1, MARK_AS_STATUS.UNREAD],
+        [0, MARK_AS_STATUS.READ],
+    ])('removes a stale bypass when filter %s matches %s', (unreadFilter, status) => {
+        expect(getElementsToBypassFilter([message], status, unreadFilter)).toEqual({
+            elementsToBypass: [],
+            elementsToRemove: [message],
+        });
+    });
+
+    it.each([
+        [1, MARK_AS_STATUS.READ],
+        [0, MARK_AS_STATUS.UNREAD],
+        [undefined, MARK_AS_STATUS.READ],
+    ])('bypasses when filter %s does not match %s', (unreadFilter, status) => {
+        expect(getElementsToBypassFilter([message], status, unreadFilter)).toEqual({
+            elementsToBypass: [message],
+            elementsToRemove: [],
+        });
+    });
+});
+
+describe('optimistic mark-as bypass', () => {
+    it('adds, deduplicates, and removes the conversation ID as the status changes', () => {
+        const initialState = newState({ params: { filter: { Unread: 1 } } });
+        const markRead = optimisticMarkAs({
+            elements: [message],
+            bypass: true,
+            conversationMode: true,
+            markAsStatus: MARK_AS_STATUS.READ,
+        });
+        const markUnread = optimisticMarkAs({
+            elements: [message],
+            bypass: true,
+            conversationMode: true,
+            markAsStatus: MARK_AS_STATUS.UNREAD,
+        });
+
+        const bypassed = elementsReducer(initialState, markRead);
+        expect(bypassed.bypassFilter).toEqual(['conversation-1']);
+        expect(elementsReducer(bypassed, markRead).bypassFilter).toEqual(['conversation-1']);
+        expect(elementsReducer(bypassed, markUnread).bypassFilter).toEqual([]);
+    });
+
+    it('uses the message ID in message mode and only changes bypass for mark-as actions', () => {
+        const initialState = newState({ params: { filter: { Unread: 0 } } });
+        const bypassed = elementsReducer(
+            initialState,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(bypassed.bypassFilter).toEqual(['message-1']);
+        expect(elementsReducer(bypassed, optimisticMarkAs({ elements: [message], bypass: true })).bypassFilter).toEqual(
+            ['message-1']
+        );
+        expect(
+            elementsReducer(
+                bypassed,
+                optimisticMarkAs({
+                    elements: [message],
+                    bypass: true,
+                    conversationMode: false,
+                    markAsStatus: MARK_AS_STATUS.READ,
+                })
+            ).bypassFilter
+        ).toEqual([]);
+    });
+});
diff --git a/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
new file mode 100644
index 0000000..953ca37
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/helpers/elementBypassFilters.ts
@@ -0,0 +1,13 @@
+import { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+
+export const getElementsToBypassFilter = (elements: Element[], action: MARK_AS_STATUS, unreadFilter?: number) => {
+    const matchesFilter =
+        (unreadFilter === 1 && action === MARK_AS_STATUS.UNREAD) ||
+        (unreadFilter === 0 && action === MARK_AS_STATUS.READ);
+
+    return {
+        elementsToBypass: matchesFilter ? [] : elements,
+        elementsToRemove: matchesFilter ? elements : [],
+    };
+};
