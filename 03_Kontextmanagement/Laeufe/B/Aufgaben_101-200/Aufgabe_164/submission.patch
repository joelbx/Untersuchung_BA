+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	tests := []struct {
+		name  string
+		enc   Encoding
+		input string
+	}{
+		{
+			name: "YAML",
+			enc:  EncodingYAML,
+			input: `version: "1.4"
+namespace:
+  key: team
+  name: Team Flags
+  description: Team namespace
+flags:
+  - key: feature
+    name: Feature
+    enabled: true
+    metadata:
+      owner:
+        name: Alice
+        labels: [alpha, beta]
+      settings:
+        - threshold: 3
+          enabled: true
+    variants:
+      - key: first
+        attachment:
+          nested:
+            - key: value
+`,
+		},
+		{
+			name:  "JSON with leading comment",
+			enc:   EncodingJSON,
+			input: "# exported by flipt\n" + `{"version":"1.4","namespace":{"key":"team","name":"Team Flags","description":"Team namespace"},"flags":[{"key":"feature","name":"Feature","enabled":true,"metadata":{"owner":{"name":"Alice","labels":["alpha","beta"]},"settings":[{"threshold":3,"enabled":true}]},"variants":[{"key":"first","attachment":{"nested":[{"key":"value"}]}}]}]}`,
+		},
+		{
+			name:  "JSON without comment",
+			enc:   EncodingJSON,
+			input: `{"version":"1.4","namespace":{"key":"team","name":"Team Flags","description":"Team namespace"},"flags":[{"key":"feature","name":"Feature","enabled":true,"metadata":{"owner":{"name":"Alice","labels":["alpha","beta"]},"settings":[{"threshold":3,"enabled":true}]},"variants":[{"key":"first","attachment":{"nested":[{"key":"value"}]}}]}]}`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team Flags", Description: "Team namespace"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			flag := creator.createflagReqs[0]
+			assert.Equal(t, "team", flag.NamespaceKey)
+			require.NotNil(t, flag.Metadata)
+			assert.Equal(t, map[string]any{
+				"owner":    map[string]any{"name": "Alice", "labels": []any{"alpha", "beta"}},
+				"settings": []any{map[string]any{"threshold": float64(3), "enabled": true}},
+			}, flag.Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":[{"key":"value"}]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONSkipsOnlyFirstCommentLine(t *testing.T) {
+	creator := &mockCreator{}
+	err := NewImporter(creator).Import(context.Background(), EncodingJSON, strings.NewReader("# first\n# second\n{}"), false)
+	require.ErrorContains(t, err, "unmarshalling document")
+	assert.Empty(t, creator.createflagReqs)
+}
