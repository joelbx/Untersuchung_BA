+func TestFillWordPressIgnoreInactivePerServer(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+	config.Conf.Servers = map[string]config.ServerInfo{
+		"ignore":  {WordPress: config.WordPressConf{IgnoreInactive: true}},
+		"include": {WordPress: config.WordPressConf{IgnoreInactive: false}},
+	}
+	config.Conf.WpIgnoreInactive = false
+
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Version: "5.0", Type: models.WPCore},
+		{Name: "active-plugin", Status: "active", Type: models.WPPlugin},
+		{Name: "inactive-plugin", Status: "inactive", Type: models.WPPlugin},
+		{Name: "active-theme", Status: "active", Type: models.WPTheme},
+		{Name: "inactive-theme", Status: "inactive", Type: models.WPTheme},
+	}
+	response := "{}"
+	invalid := "not JSON"
+	for _, tt := range []struct {
+		server string
+		cache  map[string]*string
+	}{
+		{"ignore", map[string]*string{"50": &response, "active-plugin": &response, "inactive-plugin": &invalid, "active-theme": &response, "inactive-theme": &invalid}},
+		{"include", map[string]*string{"50": &response, "active-plugin": &response, "inactive-plugin": &response, "active-theme": &response, "inactive-theme": &response}},
+	} {
+		config.Conf.WpIgnoreInactive = tt.server == "include"
+		r := &models.ScanResult{ServerName: tt.server, WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+		if _, err := FillWordPress(r, "", tt.cache); err != nil {
+			t.Fatalf("server %s: %v", tt.server, err)
+		}
+	}
+}
