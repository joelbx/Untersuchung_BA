+func TestUbuntuLTSSupportDates(t *testing.T) {
+	tests := []struct {
+		release  string
+		standard time.Time
+		extended time.Time
+	}{
+		{
+			release:  "20.04",
+			standard: time.Date(2025, 4, 1, 23, 59, 59, 0, time.UTC),
+			extended: time.Date(2030, 4, 1, 23, 59, 59, 0, time.UTC),
+		},
+		{
+			release:  "22.04",
+			standard: time.Date(2027, 4, 1, 23, 59, 59, 0, time.UTC),
+			extended: time.Date(2032, 4, 1, 23, 59, 59, 0, time.UTC),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Ubuntu, tt.release)
+			if !found {
+				t.Fatal("Ubuntu release not found")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.standard) || !eol.ExtendedSupportUntil.Equal(tt.extended) {
+				t.Errorf("support dates = %v, %v; want %v, %v", eol.StandardSupportUntil, eol.ExtendedSupportUntil, tt.standard, tt.extended)
+			}
+			if eol.IsStandardSupportEnded(tt.standard) || !eol.IsStandardSupportEnded(tt.standard.Add(time.Second)) {
+				t.Error("standard support does not end after the configured date")
+			}
+			if eol.IsExtendedSuppportEnded(tt.extended) || !eol.IsExtendedSuppportEnded(tt.extended.Add(time.Second)) {
+				t.Error("extended support does not end after the configured date")
+			}
+			if eol.IsExtendedSuppportEnded(tt.standard.Add(time.Second)) {
+				t.Error("extended support ended with standard support")
+			}
+		})
+	}
+}
