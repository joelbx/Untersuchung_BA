diff --git a/internal/server/authz/engine/ext/extentions.go b/internal/server/authz/engine/ext/extentions.go
new file mode 100644
index 0000000..4337a0d
--- /dev/null
+++ b/internal/server/authz/engine/ext/extentions.go
@@ -0,0 +1,55 @@
+package ext
+
+import (
+	"fmt"
+
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/rego"
+	"github.com/open-policy-agent/opa/types"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func init() {
+	rego.RegisterBuiltin2(&rego.Function{
+		Name: "flipt.is_auth_method",
+		Decl: types.NewFunction(types.Args(types.NewObject(nil, types.NewDynamicProperty(types.S, types.A)), types.S), types.B),
+	}, isAuthMethod)
+}
+
+func isAuthMethod(_ rego.BuiltinContext, input, key *ast.Term) (*ast.Term, error) {
+	object, ok := input.Value.(ast.Object)
+	if !ok {
+		return nil, fmt.Errorf("no authentication found")
+	}
+
+	authentication := object.Get(ast.StringTerm("authentication"))
+	if authentication == nil {
+		return nil, fmt.Errorf("no authentication found")
+	}
+
+	methodName, ok := key.Value.(ast.String)
+	if !ok {
+		return nil, fmt.Errorf("unsupported auth method %v", key.Value)
+	}
+
+	methods := map[ast.String]auth.Method{
+		"token":      auth.Method_METHOD_TOKEN,
+		"oidc":       auth.Method_METHOD_OIDC,
+		"kubernetes": auth.Method_METHOD_KUBERNETES,
+		"k8s":        auth.Method_METHOD_KUBERNETES,
+		"github":     auth.Method_METHOD_GITHUB,
+		"jwt":        auth.Method_METHOD_JWT,
+		"cloud":      auth.Method_METHOD_CLOUD,
+	}
+	method, ok := methods[methodName]
+	if !ok {
+		return nil, fmt.Errorf("unsupported auth method %q", methodName)
+	}
+
+	authenticationObject, ok := authentication.Value.(ast.Object)
+	if !ok {
+		return ast.BooleanTerm(false), nil
+	}
+	actual := authenticationObject.Get(ast.StringTerm("method"))
+	return ast.BooleanTerm(actual != nil && actual.Value.Compare(ast.IntNumberTerm(int(method)).Value) == 0), nil
+}
diff --git a/internal/server/authz/engine/ext/extentions_test.go b/internal/server/authz/engine/ext/extentions_test.go
new file mode 100644
index 0000000..e509275
--- /dev/null
+++ b/internal/server/authz/engine/ext/extentions_test.go
@@ -0,0 +1,86 @@
+package ext
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/rego"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestIsAuthMethod(t *testing.T) {
+	tests := []struct {
+		name   string
+		method auth.Method
+	}{
+		{"token", auth.Method_METHOD_TOKEN},
+		{"oidc", auth.Method_METHOD_OIDC},
+		{"kubernetes", auth.Method_METHOD_KUBERNETES},
+		{"k8s", auth.Method_METHOD_KUBERNETES},
+		{"github", auth.Method_METHOD_GITHUB},
+		{"jwt", auth.Method_METHOD_JWT},
+		{"cloud", auth.Method_METHOD_CLOUD},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			input := ast.ObjectTerm(ast.Item(ast.StringTerm("authentication"), ast.ObjectTerm(
+				ast.Item(ast.StringTerm("method"), ast.IntNumberTerm(int(tt.method))),
+			)))
+			result, err := isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm(tt.name))
+			if err != nil || result.Value != ast.Boolean(true) {
+				t.Fatalf("matching method: result=%v error=%v", result, err)
+			}
+
+			wrong := ast.ObjectTerm(ast.Item(ast.StringTerm("authentication"), ast.ObjectTerm(
+				ast.Item(ast.StringTerm("method"), ast.IntNumberTerm(0)),
+			)))
+			result, err = isAuthMethod(rego.BuiltinContext{}, wrong, ast.StringTerm(tt.name))
+			if err != nil || result.Value != ast.Boolean(false) {
+				t.Fatalf("different method: result=%v error=%v", result, err)
+			}
+		})
+	}
+}
+
+func TestIsAuthMethodErrors(t *testing.T) {
+	_, err := isAuthMethod(rego.BuiltinContext{}, ast.ObjectTerm(), ast.StringTerm("token"))
+	if err == nil || err.Error() != "no authentication found" {
+		t.Fatalf("missing authentication: %v", err)
+	}
+
+	input := ast.ObjectTerm(ast.Item(ast.StringTerm("authentication"), ast.ObjectTerm()))
+	_, err = isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm("invalid"))
+	if err == nil || !strings.Contains(err.Error(), "unsupported auth method") || !strings.Contains(err.Error(), "invalid") {
+		t.Fatalf("unsupported method: %v", err)
+	}
+}
+
+func TestIsAuthMethodRegistered(t *testing.T) {
+	query := rego.New(rego.Query(`flipt.is_auth_method(input, "k8s")`), rego.Input(map[string]any{
+		"authentication": map[string]any{"method": int(auth.Method_METHOD_KUBERNETES)},
+	}))
+	result, err := query.Eval(context.Background())
+	if err != nil || len(result) != 1 {
+		t.Fatalf("registered built-in: result=%v error=%v", result, err)
+	}
+}
+
+func TestIsAuthMethodSignature(t *testing.T) {
+	for _, query := range []string{
+		`flipt.is_auth_method(input)`,
+		`flipt.is_auth_method(input, "token", "extra")`,
+		`flipt.is_auth_method(input, 1)`,
+	} {
+		t.Run(query, func(t *testing.T) {
+			_, err := rego.New(rego.Query(query), rego.Input(map[string]any{
+				"authentication": map[string]any{"method": 1},
+			})).Eval(context.Background())
+			if err == nil {
+				t.Fatal("expected a policy type or arity error")
+			}
+		})
+	}
+}
