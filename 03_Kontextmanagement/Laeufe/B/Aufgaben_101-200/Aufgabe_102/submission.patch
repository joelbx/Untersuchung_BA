+++ b/test/units/module_utils/facts/network/test_linux_locally_reachable_ips.py
@@ -0,0 +1,90 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat.mock import Mock, patch
+
+from ansible.module_utils.facts.network.linux import LinuxNetwork, LinuxNetworkCollector
+
+
+def test_locally_reachable_ips_normalizes_deduplicates_and_sorts():
+    module = Mock()
+    outputs = {
+        '-4': '''local 192.168.1.42/24 dev lo scope host
+local 127.0.0.1 dev lo scope host
+local 192.168.1.0/24 dev lo scope host
+local 127.0.0.0/8 dev lo scope host
+10.10.0.0/16 dev lo scope host
+broadcast 192.168.1.255 dev lo scope host
+unreachable 10.0.0.0/8 scope host
+local invalid dev lo scope host
+''',
+        '-6': '''local 2001:0DB8:0:0::1/64 dev lo
+local ::1 dev lo
+local 2001:db8::/64 dev lo
+local 2001:db8::abcd dev lo
+multicast ff00::/8 dev lo
+''',
+    }
+    module.run_command.side_effect = lambda command, **kwargs: (0, outputs[command[1]], '')
+
+    with patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', True):
+        result = LinuxNetwork(module).get_locally_reachable_ips('/usr/sbin/ip')
+
+    assert result == {
+        'ipv4': ['10.10.0.0/16', '127.0.0.0/8', '127.0.0.1', '192.168.1.0/24'],
+        'ipv6': ['::1', '2001:db8::/64', '2001:db8::abcd'],
+    }
+    assert module.run_command.call_count == 2
+
+
+def test_locally_reachable_ips_handles_unavailable_query():
+    module = Mock()
+    module.run_command.side_effect = [(0, 'local 127.0.0.1 dev lo scope host\n', ''),
+                                      (1, '', 'IPv6 unavailable')]
+
+    with patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', True):
+        result = LinuxNetwork(module).get_locally_reachable_ips('/usr/sbin/ip')
+
+    assert result == {'ipv4': ['127.0.0.1'], 'ipv6': []}
+    module.warn.assert_called_once_with('Cannot collect locally reachable ipv6 routes: IPv6 unavailable')
+
+
+def test_locally_reachable_ips_handles_empty_routes():
+    module = Mock()
+    module.run_command.return_value = (0, '', '')
+
+    with patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', False):
+        result = LinuxNetwork(module).get_locally_reachable_ips('/usr/sbin/ip')
+
+    assert result == {'ipv4': [], 'ipv6': []}
+    module.warn.assert_called_once_with('No locally reachable ipv4 routes were found')
+    assert module.run_command.call_count == 1
+
+
+def test_populate_exposes_locally_reachable_ips_with_other_network_facts():
+    module = Mock()
+    module.get_bin_path.return_value = '/usr/sbin/ip'
+    network = LinuxNetwork(module)
+    with patch.object(network, 'get_default_interfaces', return_value=({}, {})), \
+            patch.object(network, 'get_interfaces_info', return_value=({'lo': {'device': 'lo'}},
+                                                                       {'all_ipv4_addresses': [],
+                                                                        'all_ipv6_addresses': []})), \
+            patch.object(network, 'get_locally_reachable_ips', return_value={'ipv4': ['127.0.0.1'],
+                                                                            'ipv6': ['::1']}):
+        facts = network.populate()
+
+    assert facts['locally_reachable_ips'] == {'ipv4': ['127.0.0.1'], 'ipv6': ['::1']}
+    assert facts['default_ipv4'] == {}
+    assert facts['all_ipv4_addresses'] == []
+
+
+def test_populate_missing_ip_returns_empty_reachable_fact_and_warning():
+    module = Mock()
+    module.get_bin_path.return_value = None
+
+    assert LinuxNetwork(module).populate() == {'locally_reachable_ips': {'ipv4': [], 'ipv6': []}}
+    module.warn.assert_called_once_with('Cannot collect locally reachable IPs: ip command is unavailable')
+
+
+def test_linux_network_collector_advertises_locally_reachable_fact():
+    assert 'locally_reachable_ips' in LinuxNetworkCollector().fact_ids
