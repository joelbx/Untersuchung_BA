+    def get_locally_reachable_ips(self, ip_path):
+        """Return addresses and prefixes on routes with Linux host scope."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        if not ip_path:
+            self.module.warn('Cannot collect locally reachable IPs: ip command is unavailable')
+            return reachable
+
+        excluded_types = set(('blackhole', 'broadcast', 'multicast', 'prohibit',
+                              'throw', 'unreachable', 'anycast', 'nat'))
+        for family, flag in (('ipv4', '-4'), ('ipv6', '-6')):
+            if family == 'ipv6' and not socket.has_ipv6:
+                continue
+            command = [ip_path, flag, 'route', 'show', 'table', 'all', 'scope', 'host']
+            rc, output, err = self.module.run_command(command, errors='surrogate_then_replace')
+            if rc != 0:
+                self.module.warn('Cannot collect locally reachable %s routes: %s' %
+                                 (family, err.strip() or 'ip command failed'))
+                continue
+
+            routes = set()
+            for line in output.splitlines():
+                words = line.split()
+                if not words or words[0] in excluded_types:
+                    continue
+                destination = words[1] if words[0] == 'local' and len(words) > 1 else words[0]
+                try:
+                    network = ipaddress.ip_network(destination, strict=False)
+                except ValueError:
+                    continue
+                if network.version != (4 if family == 'ipv4' else 6):
+                    continue
+                if network.prefixlen == network.max_prefixlen:
+                    normalized = str(network.network_address)
+                else:
+                    normalized = str(network)
+                routes.add((int(network.network_address), network.prefixlen, normalized))
+            reachable[family] = [route[2] for route in sorted(routes)]
+            if not reachable[family]:
+                self.module.warn('No locally reachable %s routes were found' % family)
+        return reachable
+
