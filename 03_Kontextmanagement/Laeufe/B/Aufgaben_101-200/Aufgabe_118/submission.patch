+])
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_packages_lists_with_legacy_fallback(mocker, results, expected_command):
+    module = mocker.Mock()
+    module.run_command.side_effect = results
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    command, stdout, stderr = pip._get_packages(module, ['python', '-m', 'pip'], '/tmp')
+
+    assert (command, stdout, stderr) == (expected_command, 'six==1.0\n', '')
+    assert module.run_command.call_args_list[0][0][0] == ['python', '-m', 'pip', 'list', '--format=freeze']
+    if len(results) == 2:
+        assert module.run_command.call_args_list[1][0][0] == ['python', '-m', 'pip', 'freeze']
