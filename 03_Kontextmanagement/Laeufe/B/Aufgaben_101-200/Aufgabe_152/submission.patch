+# Copyright: Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat.mock import patch
+from units.modules.utils import set_module_args
+from ansible.modules.network.icx import icx_logging
+from .icx_module import TestICXModule
+
+
+class TestICXLoggingModule(TestICXModule):
+    module = icx_logging
+
+    def setUp(self):
+        super(TestICXLoggingModule, self).setUp()
+        self.config_patch = patch('ansible.modules.network.icx.icx_logging.get_config')
+        self.get_config = self.config_patch.start()
+        self.load_patch = patch('ansible.modules.network.icx.icx_logging.load_config')
+        self.load_config = self.load_patch.start()
+        self.running_config = ''
+
+    def tearDown(self):
+        self.config_patch.stop()
+        self.load_patch.stop()
+        super(TestICXLoggingModule, self).tearDown()
+
+    def load_fixtures(self, commands=None):
+        self.get_config.return_value = self.running_config
+
+    def test_aggregate_ipv4_ipv6_facility_and_idempotency(self):
+        self.running_config = '\n'.join((
+            'logging host 192.0.2.1 udp-port 514',
+            'logging host ipv6 2001:db8::1 udp-port 1514',
+            'logging facility local7'))
+        args = {'aggregate': [
+            {'dest': 'host', 'name': '192.0.2.1', 'udp_port': 514},
+            {'dest': 'host', 'name': '2001:db8::1', 'udp_port': 1514},
+            {'facility': 'local7'}]}
+        set_module_args(args)
+        self.execute_module(changed=False, commands=[])
+        self.load_config.assert_not_called()
+
+    def test_aggregate_add_and_change_host_port(self):
+        self.running_config = 'logging host ipv6 2001:db8::1 udp-port 514'
+        set_module_args({'aggregate': [
+            {'dest': 'host', 'name': '2001:db8::1', 'udp_port': 1514},
+            {'dest': 'host', 'name': '192.0.2.1', 'udp_port': 514},
+            {'facility': 'local7'}]})
+        self.execute_module(changed=True, commands=[
+            'no logging host ipv6 2001:db8::1 udp-port 514',
+            'logging host ipv6 2001:db8::1 udp-port 1514',
+            'logging host 192.0.2.1 udp-port 514',
+            'logging facility local7'])
+
+    def test_absent_uses_discovered_port_and_clears_facility(self):
+        self.running_config = '\n'.join((
+            'logging host ipv6 2001:db8::1 udp-port 1514',
+            'logging facility local7'))
+        set_module_args({'aggregate': [
+            {'dest': 'host', 'name': '2001:db8::1', 'state': 'absent'},
+            {'facility': 'local7', 'state': 'absent'}]})
+        self.execute_module(changed=True, commands=[
+            'no logging host ipv6 2001:db8::1 udp-port 1514',
+            'no logging facility'])
+
+    def test_buffered_levels_and_repeated_run(self):
+        self.running_config = '\n'.join((
+            'logging buffered', 'no logging buffered warnings'))
+        set_module_args({'dest': 'buffered', 'level': 'warnings'})
+        self.execute_module(changed=True, commands=['logging buffered warnings'])
+        self.running_config = 'logging buffered'
+        self.execute_module(changed=False, commands=[])
+        set_module_args({'dest': 'buffered', 'level': 'warnings', 'state': 'absent'})
+        self.execute_module(changed=True, commands=['no logging buffered warnings'])
+        self.running_config = '\n'.join((
+            'logging buffered', 'no logging buffered warnings'))
+        self.execute_module(changed=False, commands=[])
+
+    def test_console_and_global_disable(self):
+        self.running_config = 'logging console'
+        set_module_args({'aggregate': [
+            {'dest': 'console', 'state': 'absent'},
+            {'dest': 'on', 'state': 'absent'}]})
+        self.execute_module(changed=True, commands=['no logging console', 'no logging on'])
+        self.running_config = 'no logging on\nno logging console'
+        self.execute_module(changed=False, commands=[])
+
+    def test_rfc5424_and_persistence(self):
+        self.running_config = 'logging enable rfc5424\nlogging persistence'
+        set_module_args({'aggregate': [
+            {'dest': 'rfc5424'}, {'dest': 'persistence'}]})
+        self.execute_module(changed=False, commands=[])
+        set_module_args({'aggregate': [
+            {'dest': 'rfc5424', 'state': 'absent'},
+            {'dest': 'persistence', 'state': 'absent'}]})
+        self.execute_module(changed=True, commands=[
+            'no logging enable rfc5424', 'no logging persistence'])
+
+    def test_validation(self):
+        set_module_args({'dest': 'host'})
+        self.execute_module(failed=True)
+        set_module_args({'dest': 'buffered'})
+        self.execute_module(failed=True)
+        set_module_args({'dest': 'host', 'name': '2001:invalid::1'})
+        self.execute_module(failed=True)
+
+    def test_check_mode(self):
+        set_module_args({'dest': 'host', 'name': '192.0.2.1', '_ansible_check_mode': True})
+        self.execute_module(changed=True, commands=['logging host 192.0.2.1'])
+        self.load_config.assert_not_called()
+
+    def test_buffered_command_order_and_default_facility(self):
+        self.running_config = '\n'.join((
+            'no logging buffered warnings',
+            'logging buffered warnings',
+            'no logging buffered alerts',
+            'no logging on'))
+        set_module_args({'aggregate': [
+            {'dest': 'buffered', 'level': ['warnings', 'alerts']},
+            {'facility': 'user'},
+            {'dest': 'on', 'state': 'absent'}]})
+        self.execute_module(changed=True, commands=['logging buffered alerts'])
+
+    def test_helper_parsers(self):
+        line = 'logging host ipv6 2001:db8::1 udp-port 1514'
+        self.assertEqual(icx_logging.parse_name(line, 'host'), '2001:db8::1')
+        self.assertEqual(icx_logging.parse_port(line, 'host'), '1514')
+        self.assertTrue(icx_logging.parse_address(line, 'host'))
+        self.assertEqual(icx_logging.diff_in_list({'alerts'}, {'warnings'}),
+                         ({'alerts'}, {'warnings'}))
+        self.assertEqual(icx_logging.count_terms({'name': 'x', 'level': None}), 1)
