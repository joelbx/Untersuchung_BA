@@ -0,0 +1,45 @@
+import { prepareContentToModel } from './input';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+
+const makeDOM = (html: string) => {
+    const dom = document.implementation.createHTMLDocument();
+    dom.body.innerHTML = html;
+    return dom;
+};
+
+describe('assistant Markdown conversion', () => {
+    it('places sibling nested lists inside the preceding list item', () => {
+        const dom = fixNestedLists(makeDOM('<ul><li>Parent</li><ul><li>Child</li></ul></ul>'));
+        expect(dom.body.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+        const markdown = htmlToMarkdown(dom);
+        const rendered = makeDOM(markdownToHTML(markdown));
+        expect(rendered.body.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    });
+
+    it('retains ordered list markers and nested indentation', () => {
+        const markdown = htmlToMarkdown(makeDOM('<ol><li>First<ol><li>Nested</li></ol></li><li>Second</li></ol>'));
+        expect(markdown).toMatch(/1\. First/);
+        expect(markdown).toMatch(/\n\s+1\. Nested/);
+        expect(makeDOM(markdownToHTML(markdown)).body.querySelector('ol > li > ol > li')?.textContent).toBe('Nested');
+    });
+
+    it('preserves link and image styling through model preparation and rendering', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://example.test" class="link" style="color: red">Visible</a><img src="https://example.test/img" class="picture" style="width: 10px">',
+            'uid',
+            'message-1'
+        );
+        const html = parseModelResult(markdown, 'message-1');
+        const dom = makeDOM(html);
+        expect(dom.querySelector('a')?.getAttribute('href')).toBe('https://example.test');
+        expect(dom.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(dom.querySelector('a')?.getAttribute('style')).toContain('color');
+        expect(dom.querySelector('img')?.getAttribute('src')).toBe('https://example.test/img');
+        expect(dom.querySelector('img')?.getAttribute('class')).toBe('picture');
+        expect(dom.querySelector('img')?.getAttribute('style')).toContain('width');
+        const otherMessage = makeDOM(parseModelResult(markdown, 'message-2'));
+        expect(otherMessage.querySelector('a, img')).toBeNull();
+        expect(otherMessage.body.textContent).toContain('Visible');
+    });
+});
