diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..c445f4d 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -71,3 +71,38 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+@pytest.mark.parametrize('messages, expected', [
+    (['<&"\' >'], '<p>&lt;&amp;&quot;&#x27; &gt;</p>'),
+    (['<&"\' >', 'second & <tag>'],
+     '<ul>\n<li>&lt;&amp;&quot;&#x27; &gt;</li>\n'
+     '<li>second &amp; &lt;tag&gt;</li>\n</ul>'),
+])
+def test_named_reply_does_not_access_network_and_escapes(messages, expected):
+    class UnusableReply:
+        def __getattribute__(self, name):
+            raise AssertionError(f'reply accessed: {name}')
+
+    reply = UnusableReply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError(message) for message in messages])
+    assert wrapper.html() == expected
+
+
+def test_accept_certificate_uses_reply_only_on_decision():
+    class FakeReply:
+        ignored = False
+
+        def ignoreSslErrors(self):
+            self.ignored = True
+
+    reply = FakeReply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('certificate error')])
+    assert not reply.ignored
+    assert not wrapper.certificate_was_accepted()
+
+    wrapper.accept_certificate()
+    assert reply.ignored
+    assert wrapper.certificate_was_accepted()
