+func fromArtistFolder(folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		matches, err := filepath.Glob(filepath.Join(folder, "artist.*"))
+		if err != nil {
+			return nil, "", err
+		}
+		for _, path := range matches {
+			f, err := os.Open(path)
+			if err != nil {
+				continue
+			}
+			info, err := f.Stat()
+			if err != nil || !info.Mode().IsRegular() {
+				f.Close()
+				continue
+			}
+			return f, path, nil
+		}
+		return nil, "", nil
+	}
+}
