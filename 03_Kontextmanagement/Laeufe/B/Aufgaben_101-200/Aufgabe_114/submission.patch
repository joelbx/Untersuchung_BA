+func commonDirectory(dirs []string) string {
+	common := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		for {
+			rel, err := filepath.Rel(common, dir)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			parent := filepath.Dir(common)
+			if parent == common {
+				break
+			}
+			common = parent
+		}
+	}
+	return common
+}
+
+func allSameDirectory(dirs []string) bool {
+	for _, dir := range dirs[1:] {
+		if filepath.Clean(dir) != filepath.Clean(dirs[0]) {
+			return false
+		}
+	}
+	return true
+}
