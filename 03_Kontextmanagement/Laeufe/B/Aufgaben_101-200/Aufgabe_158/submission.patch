+    def _valid_time_stamp(self, timestamp):
+        """Return a valid ZIP timestamp tuple, or the ZIP epoch."""
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.match(r'^(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})$', timestamp)
+        if not match:
+            return epoch
+
+        year, month, day, hour, minute, second = (int(value) for value in match.groups())
+        if not 1980 <= year <= 2107 or not 1 <= month <= 12:
+            return epoch
+        if not 1 <= day <= calendar.monthrange(year, month)[1]:
+            return epoch
+        if not (0 <= hour <= 23 and 0 <= minute <= 59 and 0 <= second <= 59):
+            return epoch
+
+        return (year, month, day, hour, minute, second, 0, 0, -1)
