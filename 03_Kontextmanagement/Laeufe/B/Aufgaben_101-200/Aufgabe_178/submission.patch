diff --git a/test/units/utils/test_encrypt.py b/test/units/utils/test_encrypt.py
index abf2683..7b3e835 100644
--- a/test/units/utils/test_encrypt.py
+++ b/test/units/utils/test_encrypt.py
@@ -210,3 +210,52 @@ def test_passlib_bcrypt_salt(recwarn):
 
     result = p.hash(secret, salt=repaired_salt)
     assert result == expected
+
+
+@pytest.mark.parametrize('ident', ['2', '2a', '2y', '2b'])
+def test_bcrypt_ident_passlib(ident):
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib must be installed')
+    salt = '1234567890123456789012'
+    result = get_encrypted_password('foo', 'blowfish', salt=salt, rounds=12, ident=ident)
+    assert result.startswith('$%s$12$' % ident)
+    assert encrypt.PasslibHash('bcrypt').hash('foo', salt=salt, rounds=12, ident=ident) == result
+    assert encrypt.do_encrypt('foo', 'bcrypt', salt=salt, rounds=12, ident=ident) == result
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+@pytest.mark.parametrize('ident', ['2a', '2y', '2b'])
+def test_bcrypt_ident_crypt(ident):
+    salt = '1234567890123456789012'
+    with passlib_off():
+        result = get_encrypted_password('foo', 'blowfish', salt=salt, rounds=12, ident=ident)
+        assert result.startswith('$%s$12$' % ident)
+        assert encrypt.CryptHash('bcrypt').hash('foo', salt=salt, rounds=12, ident=ident) == result
+        assert encrypt.do_encrypt('foo', 'bcrypt', salt=salt, rounds=12, ident=ident) == result
+
+
+def test_crypt_bcrypt_legacy_ident_salt_string(monkeypatch):
+    if not encrypt.HAS_CRYPT:
+        pytest.skip('crypt must be installed')
+    calls = []
+
+    def fake_crypt(secret, saltstring):
+        calls.append((secret, saltstring))
+        return saltstring + 'hash'
+
+    monkeypatch.setattr(encrypt.crypt, 'crypt', fake_crypt)
+    result = encrypt.CryptHash('bcrypt').hash('foo', salt='1234567890123456789012', rounds=12, ident='2')
+    assert result.startswith('$2$12$')
+    assert calls == [('foo', '$2$12$1234567890123456789012')]
+
+
+def test_ident_does_not_affect_other_algorithms():
+    plain = get_encrypted_password('123', 'sha256', salt='12345678')
+    assert get_encrypted_password('123', 'sha256', salt='12345678', ident='2y') == plain
+
+
+def test_bcrypt_default_ident_unchanged():
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip('passlib must be installed')
+    salt = '1234567890123456789012'
+    assert get_encrypted_password('foo', 'blowfish', salt=salt) == encrypt.PasslibHash('bcrypt').hash('foo', salt=salt)
