+def test_files_manifest_file_symlinks(collection_input, tmp_path):
+    input_dir = collection_input[0]
+    outside_file = tmp_path / 'outside.txt'
+    outside_file.write_text('outside')
+
+    outside_link = os.path.join(input_dir, 'docs', 'outside.txt')
+    inside_link = os.path.join(input_dir, 'docs', 'inside.md')
+    os.symlink(to_text(outside_file), outside_link)
+    os.symlink(os.path.join(input_dir, 'README.md'), inside_link)
+
+    actual = collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', [], Sentinel)
+    names = [entry['name'] for entry in actual['files']]
+
+    assert 'docs/outside.txt' not in names
+    assert names.count('docs/inside.md') == 1
