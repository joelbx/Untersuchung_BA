+    def test_project_runeberg_identifier_is_always_an_array(self):
+        work = make_work()
+        editions = [
+            make_edition(
+                work,
+                identifiers={
+                    'project_runeberg': ['runeberg-one', 'runeberg-two'],
+                    'librarything': ['lt-1'],
+                },
+            ),
+            make_edition(work, identifiers={'librarything': ['lt-2']}),
+        ]
+        doc = WorkSolrBuilder(work, editions, [], FakeDataProvider(), {}).build()
+        assert doc['id_project_runeberg'] == ['runeberg-one', 'runeberg-two']
+        assert doc['id_librarything'] == ['lt-1', 'lt-2']
+
+        no_runeberg = WorkSolrBuilder(
+            work, [make_edition(work, identifiers={'librarything': ['lt-1']})],
+            [], FakeDataProvider(), {},
+        ).build()
+        assert no_runeberg['id_project_runeberg'] == []
+        assert no_runeberg['id_librarything'] == ['lt-1']
+
+        no_editions = WorkSolrBuilder(work, [], [], FakeDataProvider(), {}).build()
+        assert no_editions['id_project_runeberg'] == []
