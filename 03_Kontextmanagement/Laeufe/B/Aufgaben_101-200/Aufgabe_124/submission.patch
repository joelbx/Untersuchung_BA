+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbiface"
+	log "github.com/sirupsen/logrus"
+)
+
+type billingModeDynamoAPI struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+	describeErr    error
+}
+
+func (m *billingModeDynamoAPI) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingModeDynamoAPI) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingModeDynamoAPI) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describeOutput, m.describeErr
+}
+
+func TestBillingModeConfig(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		mode    string
+		want    string
+		invalid bool
+	}{
+		{name: "default", want: billingModePayPerRequest},
+		{name: "on demand", mode: billingModePayPerRequest, want: billingModePayPerRequest},
+		{name: "provisioned", mode: billingModeProvisioned, want: billingModeProvisioned},
+		{name: "invalid", mode: "unknown", invalid: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: test.mode}
+			err := cfg.CheckAndSetDefaults()
+			if test.invalid {
+				if err == nil {
+					t.Fatal("expected invalid billing mode error")
+				}
+				return
+			}
+			if err != nil || cfg.BillingMode != test.want {
+				t.Fatalf("billing mode = %q, error = %v; want %q", cfg.BillingMode, err, test.want)
+			}
+		})
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		mode       string
+		awsMode    string
+		throughput bool
+	}{
+		{name: "on demand", mode: billingModePayPerRequest, awsMode: dynamodb.BillingModePayPerRequest},
+		{name: "provisioned", mode: billingModeProvisioned, awsMode: dynamodb.BillingModeProvisioned, throughput: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			mock := &billingModeDynamoAPI{}
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{
+				BillingMode: test.mode, ReadCapacityUnits: 23, WriteCapacityUnits: 37,
+			}}
+			b.svc = mock
+			if err := b.createTable(context.Background(), "test", fullPathKey); err != nil {
+				t.Fatal(err)
+			}
+			if got := aws.StringValue(mock.createInput.BillingMode); got != test.awsMode {
+				t.Fatalf("AWS billing mode = %q; want %q", got, test.awsMode)
+			}
+			p := mock.createInput.ProvisionedThroughput
+			if (p != nil) != test.throughput {
+				t.Fatalf("provisioned throughput = %v; want present = %v", p, test.throughput)
+			}
+			if p != nil && (aws.Int64Value(p.ReadCapacityUnits) != 23 || aws.Int64Value(p.WriteCapacityUnits) != 37) {
+				t.Fatalf("unexpected provisioned throughput: %v", p)
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		output     *dynamodb.DescribeTableOutput
+		err        error
+		wantStatus tableStatus
+		wantMode   string
+	}{
+		{name: "on demand", output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+		}}, wantStatus: tableStatusOK, wantMode: dynamodb.BillingModePayPerRequest},
+		{name: "legacy provisioned", output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}, wantStatus: tableStatusOK},
+		{name: "missing", err: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), wantStatus: tableStatusMissing},
+		{name: "migration", output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+			AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}},
+			BillingModeSummary:   &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+		}}, wantStatus: tableStatusNeedsMigration},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			b := &Backend{svc: &billingModeDynamoAPI{describeOutput: test.output, describeErr: test.err}}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			if err != nil || status != test.wantStatus || mode != test.wantMode {
+				t.Fatalf("status = %v, mode = %q, error = %v; want %v, %q", status, mode, err, test.wantStatus, test.wantMode)
+			}
+		})
+	}
+}
+
+func TestDisableOnDemandAutoScaling(t *testing.T) {
+	for _, test := range []struct {
+		name           string
+		status         tableStatus
+		configuredMode string
+		tableMode      string
+		wantEnabled    bool
+	}{
+		{name: "existing on demand", status: tableStatusOK, configuredMode: billingModeProvisioned, tableMode: dynamodb.BillingModePayPerRequest},
+		{name: "new on demand", status: tableStatusMissing, configuredMode: billingModePayPerRequest},
+		{name: "existing provisioned", status: tableStatusOK, configuredMode: billingModePayPerRequest, tableMode: dynamodb.BillingModeProvisioned, wantEnabled: true},
+		{name: "new provisioned", status: tableStatusMissing, configuredMode: billingModeProvisioned, wantEnabled: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{BillingMode: test.configuredMode, EnableAutoScaling: true}}
+			b.disableOnDemandAutoScaling(test.status, test.tableMode)
+			if b.EnableAutoScaling != test.wantEnabled {
+				t.Fatalf("auto scaling enabled = %v; want %v", b.EnableAutoScaling, test.wantEnabled)
+			}
+		})
+	}
+}
