 def format_languages(languages: Iterable) -> list[dict[str, str]]:
     """
-    Format language data to match Open Library's expected format.
-    For an input of ["eng", "fre"], return:
-    [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+    Resolve MARC codes, ISO 639-1 codes, and language names to Open Library keys.
+    Repeated languages retain only their first occurrence.
     """
     if not languages:
         return []
 
+    from openlibrary.plugins.upstream.utils import (
+        get_languages,
+        get_marc21_language,
+        strip_accents,
+    )
+
     formatted_languages = []
+    seen = set()
+    known_languages = None
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        token = language.strip().casefold()
+        code = token if len(token) == 3 else None
+
+        if code is None or web.ctx.site.get(f'/languages/{code}') is None:
+            if known_languages is None:
+                known_languages = get_languages().values()
+
+            if len(token) == 2:
+                code = next(
+                    (
+                        lang.code
+                        for lang in known_languages
+                        if (
+                            lang.get('identifiers') is not None
+                            and token in lang.get('identifiers').get('iso_639_1', [])
+                        )
+                    ),
+                    None,
+                )
+                code = code or get_marc21_language(token)
+            else:
+                normalized = strip_accents(token)
+                matches = set()
+                for lang in known_languages:
+                    names = [lang.get('name')]
+                    translated = lang.get('name_translated')
+                    if translated is not None:
+                        names.extend(
+                            translated_name
+                            for locale in translated
+                            for translated_name in translated[locale]
+                        )
+                    if any(
+                        name and strip_accents(name.casefold()) == normalized
+                        for name in names
+                    ):
+                        matches.add(lang.code)
+                code = matches.pop() if len(matches) == 1 else None
+                if code is None and not matches:
+                    code = get_marc21_language(token)
+
+        if code is None or web.ctx.site.get(f'/languages/{code}') is None:
+            raise InvalidLanguage(token)
+
+        if code not in seen:
+            seen.add(code)
+            formatted_languages.append({'key': f'/languages/{code}'})
 
     return formatted_languages
