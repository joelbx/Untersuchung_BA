+def test_custom_headers_accept_language_fallback(config_stub):
+    config_stub.val.content.headers.do_not_track = None
+    config_stub.val.content.headers.custom = {}
+    config_stub.val.content.headers.accept_language = 'en-US'
+    config_stub.set_str(
+        'content.headers.accept_language', 'de-DE',
+        pattern=urlmatch.UrlPattern('https://example.com/*'))
+
+    global_url = QUrl('https://other.example.com/')
+    overridden_url = QUrl('https://example.com/')
+    assert shared.custom_headers(global_url) == [(b'Accept-Language', b'en-US')]
+    assert shared.custom_headers(global_url, fallback_accept_language=False) == []
+    assert shared.custom_headers(overridden_url,
+                                 fallback_accept_language=False) == [
+                                     (b'Accept-Language', b'de-DE')]
+    assert shared.custom_headers(None, fallback_accept_language=False) == [
+        (b'Accept-Language', b'en-US')]
+
