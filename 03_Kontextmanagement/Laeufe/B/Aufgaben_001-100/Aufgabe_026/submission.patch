+func TestIsCveInfoUpdatedUbuntuAPI(t *testing.T) {
+	id := "CVE-2024-1"
+	previous := models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{
+		id: {CveID: id, CveContents: models.NewCveContents(models.CveContent{Type: models.UbuntuAPI, LastModified: time.Unix(1, 0)})},
+	}}
+	current := models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{
+		id: {CveID: id, CveContents: models.NewCveContents(models.CveContent{Type: models.UbuntuAPI, LastModified: time.Unix(2, 0)})},
+	}}
+	if !isCveInfoUpdated(id, previous, current) {
+		t.Fatal("Ubuntu API change was missed")
+	}
+}
