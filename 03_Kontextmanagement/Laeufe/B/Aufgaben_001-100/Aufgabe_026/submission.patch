+func TestUbuntuContentPriorityAndCvss(t *testing.T) {
+	v := VulnInfo{CveContents: NewCveContents(
+		CveContent{Type: Nvd, Summary: "NVD summary"},
+		CveContent{Type: Ubuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "NEGLIGIBLE"},
+		CveContent{Type: UbuntuAPI, Title: "API title", Summary: "API summary", Cvss3Score: 7.5, Cvss3Severity: "HIGH"},
+	)}
+	if got, want := v.Summaries("en", "ubuntu"), []CveContentStr{{Ubuntu, "Ubuntu summary"}, {UbuntuAPI, "API summary"}, {Nvd, "NVD summary"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("summaries: got %v, want %v", got, want)
+	}
+	titles := v.Titles("en", "ubuntu")
+	if len(titles) < 2 || titles[0] != (CveContentStr{Ubuntu, "Ubuntu title"}) || titles[1] != (CveContentStr{UbuntuAPI, "API title"}) {
+		t.Errorf("titles: unexpected family source order: %v", titles)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 || scores[0].Type != UbuntuAPI || scores[0].Value.Score != 7.5 || scores[1].Type != Ubuntu || scores[1].Value.Score != 3.9 {
+		t.Errorf("scores: got %v", scores)
+	}
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("negligible range: %s", got)
+	}
+	if got := severityToCvssScoreRoughly("negligible"); got != 3.9 {
+		t.Errorf("negligible score: %v", got)
+	}
+}
