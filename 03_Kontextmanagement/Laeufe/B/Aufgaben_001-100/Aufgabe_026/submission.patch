+		CveContent{Type: UbuntuAPI, SourceLink: "ubuntu-api", Cpes: []Cpe{{URI: "ubuntu-api"}}, References: References{{Link: "ubuntu-api"}}, CweIDs: []string{"CWE-3"}},
+	)
+	if got, want := contents.PrimarySrcURLs("en", "ubuntu", "CVE-1", nil), []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "ubuntu"}, {UbuntuAPI, "ubuntu-api"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("URLs: got %v, want %v", got, want)
+	}
+	if got, want := contents.CweIDs("ubuntu"), []CveContentStr{{Ubuntu, "CWE-2"}, {UbuntuAPI, "CWE-3"}, {Nvd, "CWE-1"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("CWEs: got %v, want %v", got, want)
+	}
+	for name, got := range map[string][]CveContentType{
+		"CPEs": func() (types []CveContentType) {
+			for _, item := range contents.Cpes("ubuntu") {
+				types = append(types, item.Type)
+			}
+			return
+		}(),
+		"references": func() (types []CveContentType) {
+			for _, item := range contents.References("ubuntu") {
+				types = append(types, item.Type)
+			}
+			return
+		}(),
+	} {
+		if want := []CveContentType{Ubuntu, UbuntuAPI, Nvd}; !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: got %v, want %v", name, got, want)
+		}
+	}
+}
