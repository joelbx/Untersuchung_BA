+def test_get_ia_record_normalizes_mixed_identifiers_and_publishers() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'creator': 'Alice;Bob',
+            'isbn': [' 0-441-56959-5 ', '978 1 451654684', 'invalid', ' '],
+            'publisher': [' New York : Simon & Schuster ', ' Penguin ', ' : Vintage '],
+        }
+    )
+
+    assert result['authors'] == [{'name': 'Alice'}, {'name': 'Bob'}]
+    assert result['isbn_10'] == ['0441569595']
+    assert result['isbn_13'] == ['9781451654684']
+    assert result['publishers'] == ['Simon & Schuster', 'Penguin', 'Vintage']
+    assert result['publish_places'] == ['New York']
+    assert 'isbn' not in result and 'publisher' not in result
+
+
+@pytest.mark.parametrize('value', [None, '', [], [' ', None]])
+def test_get_ia_record_omits_empty_normalized_fields(value) -> None:
+    result = code.ia_importapi.get_ia_record({'isbn': value, 'publisher': value})
+    assert 'isbn_10' not in result
+    assert 'isbn_13' not in result
+    assert 'publishers' not in result
+    assert 'publish_places' not in result
