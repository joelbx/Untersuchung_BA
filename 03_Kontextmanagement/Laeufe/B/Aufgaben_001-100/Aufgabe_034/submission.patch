+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Return usable ISBN-10 and ISBN-13 values in separate lists."""
+    if isinstance(isbns, str):
+        isbns = [isbns]
+
+    isbn_10, isbn_13 = [], []
+    for value in isbns or []:
+        if not isinstance(value, str):
+            continue
+        isbn = re.sub(r'[\s-]+', '', value).upper()
+        if re.fullmatch(r'\d{9}[\dX]', isbn):
+            isbn_10.append(isbn)
+        elif re.fullmatch(r'\d{13}', isbn):
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
+
+def get_publisher_and_place(
+    publishers: str | list[str],
+) -> tuple[list[str], list[str]]:
+    """Split IA publisher values of the form ``Place: Publisher``."""
+    if isinstance(publishers, str):
+        publishers = [publishers]
+
+    names, places = [], []
+    for value in publishers or []:
+        if not isinstance(value, str):
+            continue
+        if ':' in value:
+            place, name = (part.strip() for part in value.split(':', 1))
+            if name:
+                names.append(name)
+                if place:
+                    places.append(place)
+        elif name := value.strip():
+            names.append(name)
+    return names, places
+
