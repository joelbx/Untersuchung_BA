new file mode 100644
index 0000000..a9ec5d3
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,34 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Version is the version of the running Flipt binary. The command sets it at startup.
+var Version = "dev"
+
+// Flipt describes the running binary for the /meta/info endpoint.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the build information as JSON.
+func (i Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(i)
+	if err != nil {
+		http.Error(w, "encoding build information", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if _, err = w.Write(out); err != nil {
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..3153281
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,231 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	stateFile     = "telemetry.json"
+)
+
+// The telemetry service accepts only the anonymous event fields constructed here.
+var endpoint = "https://telemetry.flipt.io/v1/track"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter sends anonymous usage events and persists its stable host identifier.
+type Reporter struct {
+	mu     sync.Mutex
+	state  state
+	path   string
+	client *http.Client
+	logger logrus.FieldLogger
+}
+
+// NewReporter initializes telemetry unless it has been disabled.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("telemetry: nil config")
+	}
+	if !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	if logger == nil {
+		logger = logrus.New()
+	}
+
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		base, err := os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("telemetry config directory: %w", err)
+		}
+		dir = filepath.Join(base, "flipt")
+	}
+	if fi, err := os.Stat(dir); err == nil && !fi.IsDir() {
+		logger.Warnf("telemetry disabled: state directory %q is a file", dir)
+		return nil, nil
+	} else if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("telemetry state directory: %w", err)
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+
+	r := &Reporter{path: filepath.Join(dir, stateFile), client: &http.Client{Timeout: 5 * time.Second}, logger: logger}
+	data, err := os.ReadFile(r.path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.Warnf("reading telemetry state: %v", err)
+			r.state = state{}
+		}
+	}
+
+	dirty := os.IsNotExist(err)
+	if err == nil {
+		var fields map[string]json.RawMessage
+		if json.Unmarshal(data, &fields) != nil || fields["lastTimestamp"] == nil {
+			dirty = true
+		}
+	}
+	id, parseErr := uuid.FromString(r.state.UUID)
+	if parseErr != nil || id == uuid.Nil {
+		id, genErr := uuid.NewV4()
+		if genErr != nil {
+			return nil, fmt.Errorf("generating telemetry UUID: %w", genErr)
+		}
+		r.state.UUID = id.String()
+		dirty = true
+	}
+	if r.state.Version != schemaVersion {
+		r.state.Version = schemaVersion
+		dirty = true
+	}
+	if r.state.LastTimestamp != "" {
+		if _, parseErr := time.Parse(time.RFC3339, r.state.LastTimestamp); parseErr != nil {
+			r.state.LastTimestamp = ""
+			dirty = true
+		}
+	}
+	if dirty {
+		if err := r.writeState(); err != nil {
+			return nil, err
+		}
+	}
+	return r, nil
+}
+
+// Start reports when due and then repeats every four hours until canceled.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	for {
+		r.mu.Lock()
+		last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+		r.mu.Unlock()
+		wait := time.Until(last.Add(interval))
+		if !last.IsZero() && wait > 0 {
+			timer := time.NewTimer(wait)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+		if ctx.Err() != nil {
+			return
+		}
+		if err := r.Report(ctx); err != nil {
+			r.logger.Warnf("reporting telemetry: %v", err)
+			// Avoid a busy loop when an endpoint or state file is unavailable.
+			timer := time.NewTimer(interval)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+	}
+}
+
+// Report sends one anonymous flipt.ping and records its successful timestamp.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	event := struct {
+		AnonymousID string `json:"anonymousId"`
+		Event       string `json:"event"`
+		Properties  struct {
+			UUID    string `json:"uuid"`
+			Version string `json:"version"`
+			Flipt   struct {
+				Version string `json:"version"`
+			} `json:"flipt"`
+		} `json:"properties"`
+	}{AnonymousID: r.state.UUID, Event: "flipt.ping"}
+	event.Properties.UUID = r.state.UUID
+	event.Properties.Version = schemaVersion
+	event.Properties.Flipt.Version = info.Version
+	data, err := json.Marshal(event)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: HTTP %d", resp.StatusCode)
+	}
+	previous := r.state.LastTimestamp
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.writeState(); err != nil {
+		r.state.LastTimestamp = previous
+		return err
+	}
+	return nil
+}
+
+func (r *Reporter) writeState() error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encoding telemetry state: %w", err)
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(r.path), ".telemetry-*")
+	if err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	defer os.Remove(tmp.Name())
+	if err := tmp.Chmod(0600); err != nil {
+		tmp.Close()
+		return fmt.Errorf("protecting telemetry state: %w", err)
+	}
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		return fmt.Errorf("closing telemetry state: %w", err)
+	}
+	if err := os.Rename(tmp.Name(), r.path); err != nil {
+		return fmt.Errorf("saving telemetry state: %w", err)
+	}
+	return nil
+}
