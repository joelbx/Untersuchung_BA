@@ -0,0 +1,160 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/markphelps/flipt/internal/info"
+	"github.com/sirupsen/logrus"
+)
+
+func TestDisabledAndInvalidDirectory(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = filepath.Join(dir, "state")
+	cfg.Meta.TelemetryEnabled = false
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter = %v, %v", r, err)
+	}
+	if _, err := os.Stat(cfg.Meta.StateDirectory); !os.IsNotExist(err) {
+		t.Fatalf("disabled telemetry created state directory: %v", err)
+	}
+	if err := os.WriteFile(cfg.Meta.StateDirectory, []byte("file"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Meta.TelemetryEnabled = true
+	r, err = NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("file state directory reporter = %v, %v", r, err)
+	}
+}
+
+func TestReporterStateAndEvent(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "new", "state")
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	logger := logrus.New()
+	r, err := NewReporter(cfg, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		t.Fatalf("invalid UUID: %v", err)
+	}
+	id := r.state.UUID
+	if r.state.Version != schemaVersion || r.state.LastTimestamp != "" {
+		t.Fatalf("initial state: %+v", r.state)
+	}
+	r2, err := NewReporter(cfg, logger)
+	if err != nil || r2.state.UUID != id {
+		t.Fatalf("UUID did not persist: %v, %v", r2, err)
+	}
+
+	oldEndpoint := endpoint
+	oldVersion := info.Version
+	t.Cleanup(func() { endpoint = oldEndpoint; info.Version = oldVersion })
+	info.Version = "v9.8.7"
+	var event map[string]interface{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if req.Method != http.MethodPost {
+			t.Errorf("method = %s", req.Method)
+		}
+		if err := json.NewDecoder(req.Body).Decode(&event); err != nil {
+			t.Errorf("decode event: %v", err)
+		}
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer srv.Close()
+	endpoint = srv.URL
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if event["anonymousId"] != id || event["event"] != "flipt.ping" {
+		t.Fatalf("event identity: %v", event)
+	}
+	properties, ok := event["properties"].(map[string]interface{})
+	if !ok || properties["uuid"] != id || properties["version"] != schemaVersion {
+		t.Fatalf("event properties: %v", event)
+	}
+	flipt, ok := properties["flipt"].(map[string]interface{})
+	if !ok || flipt["version"] != "v9.8.7" {
+		t.Fatalf("Flipt version: %v", properties)
+	}
+	if _, ok := event["ip"]; ok {
+		t.Fatal("event contains IP")
+	}
+	if _, ok := event["hostname"]; ok {
+		t.Fatal("event contains hostname")
+	}
+	data, err := os.ReadFile(filepath.Join(dir, stateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var persisted state
+	if err := json.Unmarshal(data, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if persisted.UUID != id || persisted.Version != schemaVersion {
+		t.Fatalf("persisted state: %+v", persisted)
+	}
+	stamp, err := time.Parse(time.RFC3339, persisted.LastTimestamp)
+	if err != nil || time.Since(stamp) > time.Minute {
+		t.Fatalf("timestamp = %q, %v", persisted.LastTimestamp, err)
+	}
+}
+
+func TestMalformedStateGetsNewUUID(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, stateFile)
+	if err := os.WriteFile(path, []byte(`{"version":"1.0","uuid":"bad","lastTimestamp":"bad"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil || r.state.LastTimestamp != "" {
+		t.Fatalf("unrepaired state: %+v, %v", r.state, err)
+	}
+}
+
+func TestReportFailureDoesNotAdvanceTimestamp(t *testing.T) {
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = t.TempDir()
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldEndpoint := endpoint
+	t.Cleanup(func() { endpoint = oldEndpoint })
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer srv.Close()
+	endpoint = srv.URL
+	if err := r.Report(context.Background()); err == nil {
+		t.Fatal("expected send error")
+	}
+	data, err := os.ReadFile(filepath.Join(cfg.Meta.StateDirectory, stateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var persisted state
+	if err := json.Unmarshal(data, &persisted); err != nil {
+		t.Fatal(err)
+	}
+	if persisted.LastTimestamp != "" || r.state.LastTimestamp != "" {
+		t.Fatalf("failed report advanced timestamp: %+v", persisted)
+	}
+}
