+	legacyOptional := &models.ScanResult{Family: constant.Debian, Optional: map[string]interface{}{"trivy-target": "example"}}
+	if reuseScannedCves(legacyOptional) {
+		t.Fatal("Optional metadata alone should not mark a Trivy scan")
+	}
+}
