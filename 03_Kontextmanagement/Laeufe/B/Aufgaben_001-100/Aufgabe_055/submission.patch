+func TestReuseScannedCvesUsesScannedBy(t *testing.T) {
+	trivy := &models.ScanResult{Family: constant.Debian, ScannedBy: "trivy"}
+	if !reuseScannedCves(trivy) {
+		t.Fatal("Trivy scan should reuse scanned CVEs")
