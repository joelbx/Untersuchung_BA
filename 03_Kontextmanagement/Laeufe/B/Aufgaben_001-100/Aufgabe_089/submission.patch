+func referenceErrors(file string, root *yamlv3.Node) []error {
+	namespace := value(field(root, "namespace"))
+	if namespace == "" {
+		namespace = "default"
+	}
+	segments := map[string]bool{}
+	for _, segment := range items(field(root, "segments")) {
+		segments[value(field(segment, "key"))] = true
+	}
+	var problems []error
+	add := func(message string, node *yamlv3.Node) {
+		if node != nil {
+			problems = append(problems, Error{Message: message, Location: Location{File: file, Line: node.Line, Column: node.Column}})
+		}
+	}
+	checkSegment := func(prefix string, node *yamlv3.Node) {
+		if node == nil {
+			return
+		}
+		if node.Kind == yamlv3.ScalarNode {
+			if !segments[node.Value] {
+				add(fmt.Sprintf("%s references unknown segment %q", prefix, node.Value), node)
+			}
+			return
+		}
+		if key := field(node, "key"); key != nil && !segments[key.Value] {
+			add(fmt.Sprintf("%s references unknown segment %q", prefix, key.Value), key)
+		}
+		for _, key := range items(field(node, "keys")) {
+			if !segments[key.Value] {
+				add(fmt.Sprintf("%s references unknown segment %q", prefix, key.Value), key)
+			}
+		}
+	}
+	for _, flag := range items(field(root, "flags")) {
+		prefix := fmt.Sprintf("flag %s/%s", namespace, value(field(flag, "key")))
+		variants := map[string]bool{}
+		for _, variant := range items(field(flag, "variants")) {
+			variants[value(field(variant, "key"))] = true
+		}
+		for i, rule := range items(field(flag, "rules")) {
+			rulePrefix := fmt.Sprintf("%s rule %d", prefix, i+1)
+			checkSegment(rulePrefix, field(rule, "segment"))
+			for _, distribution := range items(field(rule, "distributions")) {
+				variant := field(distribution, "variant")
+				if variant != nil && !variants[variant.Value] {
+					add(fmt.Sprintf("%s references unknown variant %q", rulePrefix, variant.Value), variant)
+				}
+			}
+		}
+		for i, rollout := range items(field(flag, "rollouts")) {
+			checkSegment(fmt.Sprintf("%s rollout %d", prefix, i+1), field(rollout, "segment"))
+		}
+	}
+	return problems
 }
