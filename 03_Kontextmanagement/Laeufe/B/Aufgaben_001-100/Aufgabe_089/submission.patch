+func validateReferences(doc *Document, namespace string) error {
+	segments := make(map[string]bool, len(doc.Segments))
+	for _, segment := range doc.Segments {
+		if segment != nil {
+			segments[segment.Key] = true
+		}
+	}
+	for _, flag := range doc.Flags {
+		if flag == nil {
+			continue
+		}
+		variants := make(map[string]bool, len(flag.Variants))
+		for _, variant := range flag.Variants {
+			if variant != nil {
+				variants[variant.Key] = true
+			}
+		}
+		for i, rule := range flag.Rules {
+			if rule == nil {
+				continue
+			}
+			prefix := fmt.Sprintf("flag %s/%s rule %d", namespace, flag.Key, i+1)
+			if rule.Segment != nil {
+				switch segment := rule.Segment.IsSegment.(type) {
+				case SegmentKey:
+					if !segments[string(segment)] {
+						return fmt.Errorf("%s references unknown segment %q", prefix, segment)
+					}
+				case *Segments:
+					for _, key := range segment.Keys {
+						if !segments[key] {
+							return fmt.Errorf("%s references unknown segment %q", prefix, key)
+						}
+					}
+				}
+			}
+			for _, distribution := range rule.Distributions {
+				if distribution != nil && !variants[distribution.VariantKey] {
+					return fmt.Errorf("%s references unknown variant %q", prefix, distribution.VariantKey)
+				}
+			}
+		}
+	}
+	return nil
+}
