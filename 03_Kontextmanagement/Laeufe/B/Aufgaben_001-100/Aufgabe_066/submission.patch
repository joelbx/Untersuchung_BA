+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and descendants while preserving other styles', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 100vh; color: red');
+        root.innerHTML = `
+            <section style="height: calc(50vh - 10px) !important; width: 30px"></section>
+            <p style="height: 20px; min-height: 40vh"></p>
+        `;
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+
+        const section = root.querySelector('section') as HTMLElement;
+        expect(section.style.height).toBe('auto');
+        expect(section.style.getPropertyPriority('height')).toBe('important');
+        expect(section.style.width).toBe('30px');
+
+        const paragraph = root.querySelector('p') as HTMLElement;
+        expect(paragraph.style.height).toBe('20px');
+        expect(paragraph.style.minHeight).toBe('40vh');
+    });
+});
diff --git a/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
new file mode 100644
index 0000000..b369a6e
--- /dev/null
+++ b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
@@ -0,0 +1,16 @@
+export const transformStyleAttributes = (document: Element): void => {
+    const elements = [document, ...document.querySelectorAll('[style]')];
+
+    elements.forEach((element) => {
+        if (!element.hasAttribute('style')) {
+            return;
+        }
+
+        const style = (element as HTMLElement).style;
+        const height = style?.getPropertyValue('height');
+
+        if (height?.toLowerCase().includes('vh')) {
+            style.setProperty('height', 'auto', style.getPropertyPriority('height'));
+        }
+    });
+};
