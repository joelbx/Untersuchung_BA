+from __future__ import (absolute_import, division, print_function)
+
+import zipfile
+from io import BytesIO
+
+import pytest
+
+from ansible.errors import AnsibleError
+from ansible.executor import module_common as common
+
+
+def _payload(source):
+    names = {('ansible', '__init__'), ('ansible', 'module_utils', '__init__')}
+    cache = {}
+    output = BytesIO()
+    with zipfile.ZipFile(output, 'w') as archive:
+        common.recursive_finder('example', 'ansible.modules.example', source, names, cache, archive)
+    with zipfile.ZipFile(BytesIO(output.getvalue())) as archive:
+        return {name: archive.read(name) for name in archive.namelist()}
+
+
+def test_collection_initializer_relative_imports_and_missing_parent(mocker):
+    mocker.patch.object(common, '_get_collection_metadata', return_value={})
+    sources = {
+        'plugins/module_utils/pkg/__init__.py': b'from ..cousin import VALUE\n',
+        'plugins/module_utils/pkg/sub/child.py': b'VALUE = 1\n',
+        'plugins/module_utils/cousin.py': b'VALUE = 2\n',
+    }
+    mocker.patch.object(common.pkgutil, 'get_data', side_effect=lambda package, path: sources.get(path))
+    payload = _payload(b'import ansible_collections.ns.coll.plugins.module_utils.pkg.sub.child\n')
+    assert payload['ansible_collections/ns/coll/plugins/module_utils/pkg/__init__.py'] == sources['plugins/module_utils/pkg/__init__.py']
+    assert payload['ansible_collections/ns/coll/plugins/module_utils/pkg/sub/__init__.py'] == b''
+    assert payload['ansible_collections/ns/coll/plugins/module_utils/cousin.py'] == sources['plugins/module_utils/cousin.py']
+    assert payload['ansible_collections/ns/coll/plugins/module_utils/pkg/sub/child.py'] == sources['plugins/module_utils/pkg/sub/child.py']
+
+
+def test_collection_redirect_expands_target_and_warns(mocker):
+    routing = {'plugin_routing': {'module_utils': {'alias': {
+        'redirect': 'other.target.real',
+        'deprecation': {'warning_text': 'use real', 'removal_version': '3.0', 'removal_date': '2030-01-01'},
+    }}}}
+    mocker.patch.object(common, '_get_collection_metadata', side_effect=lambda collection: routing if collection == 'ns.coll' else {})
+    mocker.patch.object(common.pkgutil, 'get_data', side_effect=lambda package, path: b'VALUE = 1\n' if package == 'ansible_collections.other.target' and path == 'plugins/module_utils/real.py' else None)
+    deprecated = mocker.patch.object(common.display, 'deprecated')
+    payload = _payload(b'import ansible_collections.ns.coll.plugins.module_utils.alias\n')
+    assert b'ansible_collections.other.target.plugins.module_utils.real' in payload['ansible_collections/ns/coll/plugins/module_utils/alias.py']
+    assert payload['ansible_collections/other/target/plugins/module_utils/real.py'] == b'VALUE = 1\n'
+    deprecated.assert_called_with('use real (removal version 3.0)', version='3.0', date='2030-01-01', collection_name='ns.coll')
+
+
+def test_redirect_to_package_uses_initializer_shim(mocker):
+    routing = {'plugin_routing': {'module_utils': {'alias': {'redirect': 'other.target.package'}}}}
+    mocker.patch.object(common, '_get_collection_metadata', side_effect=lambda collection: routing if collection == 'ns.coll' else {})
+    mocker.patch.object(common.pkgutil, 'get_data', side_effect=lambda package, path: b'VALUE = 1\n' if package == 'ansible_collections.other.target' and path == 'plugins/module_utils/package/__init__.py' else None)
+    payload = _payload(b'import ansible_collections.ns.coll.plugins.module_utils.alias\n')
+    assert b'other.target.plugins.module_utils.package' in payload['ansible_collections/ns/coll/plugins/module_utils/alias/__init__.py']
+    assert payload['ansible_collections/other/target/plugins/module_utils/package/__init__.py'] == b'VALUE = 1\n'
+
+
+def test_collection_tombstone_reports_collection_and_removal(mocker):
+    routing = {'plugin_routing': {'module_utils': {'gone': {'tombstone': {
+        'warning_text': 'gone for good', 'removal_version': '3.0', 'removal_date': '2030-01-01',
+    }}}}}
+    mocker.patch.object(common, '_get_collection_metadata', return_value=routing)
+    with pytest.raises(AnsibleError) as error:
+        common.CollectionModuleUtilLocator(('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'gone'))
+    assert 'gone for good' in str(error.value)
+    assert 'ns.coll' in str(error.value)
+    assert '3.0' in str(error.value)
+
+
+def test_missing_redirect_collection_has_specific_error(mocker):
+    routing = {'plugin_routing': {'module_utils': {'alias': {'redirect': 'missing.target.real'}}}}
+
+    def metadata(collection):
+        if collection == 'ns.coll':
+            return routing
+        raise ValueError('not installed')
+
+    mocker.patch.object(common, '_get_collection_metadata', side_effect=metadata)
+    with pytest.raises(AnsibleError, match='unable to locate collection missing.target'):
+        _payload(b'import ansible_collections.ns.coll.plugins.module_utils.alias\n')
+
+
+def test_unresolved_import_lists_both_ambiguous_candidates(mocker):
+    mocker.patch.object(common, '_get_collection_metadata', return_value={})
+    mocker.patch.object(common.pkgutil, 'get_data', return_value=None)
+    with pytest.raises(AnsibleError) as error:
+        _payload(b'from ansible_collections.ns.coll.plugins.module_utils.pkg import missing\n')
+    message = str(error.value)
+    assert 'Could not find imported module support code for ansible.modules.example. Looked for (' in message
+    assert 'ansible_collections.ns.coll.plugins.module_utils.pkg.missing' in message
+    assert 'ansible_collections.ns.coll.plugins.module_utils.pkg' in message
+
+
+def test_collection_redirect_precedes_local_file(mocker):
+    routing = {'plugin_routing': {'module_utils': {'alias': {'redirect': 'other.target.real'}}}}
+    mocker.patch.object(common, '_get_collection_metadata', return_value=routing)
+    local = mocker.patch.object(common.pkgutil, 'get_data', return_value=b'LOCAL = True\n')
+    locator = common.CollectionModuleUtilLocator(('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'alias'))
+    assert locator.redirected
+    assert b'other.target.plugins.module_utils.real' in locator.source_code.encode()
+    local.assert_not_called()
+
+
+def test_legacy_local_file_precedes_redirect(mocker):
+    info = mocker.patch.object(common, 'ModuleInfo').return_value
+    info.pkg_dir = False
+    info.py_src = True
+    info.path = '/local/alias.py'
+    info.get_source.return_value = b'LOCAL = True\n'
+    metadata = mocker.patch.object(common, '_get_collection_metadata')
+    locator = common.LegacyModuleUtilLocator(('ansible', 'module_utils', 'alias'), mu_paths=['/local'])
+    assert locator.found and not locator.redirected
+    assert locator.source_code == b'LOCAL = True\n'
+    metadata.assert_not_called()
