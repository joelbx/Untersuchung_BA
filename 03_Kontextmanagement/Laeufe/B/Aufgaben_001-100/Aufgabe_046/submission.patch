+        self.is_package = False
+        self.normalized_name = None
+        self.output_path = None
+        self.source_code = None
+        self.source_path = None
+        self.redirect_target = None
+        self._resolve()
+
+    def candidate_names_joined(self):
+        return ['.'.join(name) for name in self.candidate_names]
+
+    def _resolve(self):
+        """Subclasses supply the lookup strategy."""
+
+    def _set_result(self, name, source, source_path, is_package=False, redirect_target=None):
+        self.found = True
+        self.is_package = is_package
+        self.redirected = redirect_target is not None
+        self.redirect_target = redirect_target
+        self.normalized_name = name + (('__init__',) if is_package else ())
+        self.output_path = '/'.join(self.normalized_name) + '.py'
+        self.source_code = source
+        self.source_path = source_path
+
+    @staticmethod
+    def _redirect_source(original, target):
+        return ("import sys\nimport {target} as mod\n"
+                "sys.modules[{original!r}] = mod\n").format(original='.'.join(original), target='.'.join(target))
+
+    @staticmethod
+    def _routing_action(entry, name, collection):
+        deprecation = entry.get('deprecation')
+        if deprecation:
+            message = deprecation.get('warning_text') or '%s is deprecated.' % '.'.join(name)
+            if deprecation.get('removal_version') and deprecation.get('removal_date'):
+                message += ' (removal version %s)' % deprecation['removal_version']
+            display.deprecated(message,
+                               version=deprecation.get('removal_version'), date=deprecation.get('removal_date'),
+                               collection_name=collection)
+        tombstone = entry.get('tombstone')
+        if tombstone:
+            message = tombstone.get('warning_text') or '%s has been removed.' % '.'.join(name)
+            removed_message = display.get_deprecation_message(
+                message, version=tombstone.get('removal_version'), date=tombstone.get('removal_date'),
+                removed=True, collection_name=collection)
+            if tombstone.get('removal_version') and tombstone.get('removal_date'):
+                removed_message += ' Removal version: %s.' % tombstone['removal_version']
+            raise AnsibleError(removed_message)
+        return entry.get('redirect')
+
+    @staticmethod
+    def _expand_redirect(redirect):
+        parts = tuple(redirect.split('.'))
+        if parts[0] == 'ansible_collections' or parts[:2] == ('ansible', 'module_utils'):
+            return parts
+        if len(parts) < 3:
+            raise AnsibleError('Invalid module_utils redirect %s' % redirect)
+        return ('ansible_collections', parts[0], parts[1], 'plugins', 'module_utils') + parts[2:]
