+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False):
+        self.fq_name_parts = tuple(fq_name_parts)
+        self.is_ambiguous = bool(is_ambiguous and len(self.fq_name_parts) > self.module_utils_depth + 1)
+        self.child_is_redirected = child_is_redirected
+        self.candidate_names = [self.fq_name_parts]
+        if self.is_ambiguous:
+            self.candidate_names.append(self.fq_name_parts[:-1])
+        self.found = False
