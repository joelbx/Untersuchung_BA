+class LegacyModuleUtilLocator(ModuleUtilLocatorBase):
+    module_utils_depth = 2
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, mu_paths=None, child_is_redirected=False):
+        self.mu_paths = mu_paths
+        super(LegacyModuleUtilLocator, self).__init__(fq_name_parts, is_ambiguous, child_is_redirected)
+
+    def _local(self, name):
+        if len(name) <= self.module_utils_depth:
+            return False
+        relative = name[self.module_utils_depth:]
+        paths = self.mu_paths
+        if paths is None:
+            paths = [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)]
+            paths.append(_MODULE_UTILS_PATH)
+        try:
+            info = ModuleInfo(relative[-1], [os.path.join(p, *relative[:-1]) for p in paths])
+        except (ImportError, OSError):
+            return False
+        if not info.pkg_dir and not info.py_src:
+            return False
+        self._set_result(name, info.get_source(), info.path, info.pkg_dir)
+        return True
+
+    def _redirect(self, name):
+        if len(name) <= self.module_utils_depth:
+            return False
+        try:
+            metadata = _get_collection_metadata('ansible.builtin')
+        except ValueError:
+            return False
+        routing = metadata.get('plugin_routing', {}).get('module_utils', {})
+        key = '.'.join(name[self.module_utils_depth:])
+        entry = routing.get(key)
+        if not entry:
+            return False
+        target = self._routing_action(entry, name, 'ansible.builtin')
+        if not target:
+            return False
+        target = self._expand_redirect(target)
+        self._set_result(name, self._redirect_source(name, target), '.'.join(name),
+                         self.child_is_redirected, target)
+        return True
+
+    def _resolve(self):
+        for name in self.candidate_names:
+            if self._local(name) or self._redirect(name):
+                return
