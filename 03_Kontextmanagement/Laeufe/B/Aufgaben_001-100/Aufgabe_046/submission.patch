+class CollectionModuleUtilLocator(ModuleUtilLocatorBase):
+    module_utils_depth = 5
+    redirect_first = True
+
+    def _metadata(self, name):
+        collection = '.'.join(name[1:3])
+        try:
+            return _get_collection_metadata(collection)
+        except (ValueError, ImportError) as exc:
+            raise AnsibleError('unable to locate collection %s: %s' % (collection, to_native(exc)))
+
+    def _redirect(self, name):
+        if len(name) <= self.module_utils_depth:
+            return False
+        routing = self._metadata(name).get('plugin_routing', {}).get('module_utils', {})
+        relative = name[self.module_utils_depth:]
+        for length in range(len(relative), 0, -1):
+            entry = routing.get('.'.join(relative[:length]))
+            if not entry:
+                continue
+            collection = '.'.join(name[1:3])
+            target = self._routing_action(entry, name, collection)
+            if not target:
+                continue
+            target = self._expand_redirect(target) + relative[length:]
+            self._set_result(name, self._redirect_source(name, target), '.'.join(name),
+                             self.child_is_redirected, target)
+            return True
+        return False
+
+    def _local(self, name):
+        if len(name) <= self.module_utils_depth:
+            self._set_result(name, b'', '<generated>', True)
+            return True
+        self._metadata(name)
+        collection_pkg = '.'.join(name[:3])
+        resource = '/'.join(name[3:])
+        for path, is_package in ((resource + '/__init__.py', True), (resource + '.py', False)):
+            try:
+                source = pkgutil.get_data(collection_pkg, path)
+            except (OSError, ImportError):
+                source = None
+            if source is not None:
+                self._set_result(name, source, path, is_package)
+                return True
+        return False
+
+    def _resolve(self):
+        if self.fq_name_parts[:1] != ('ansible_collections',) or len(self.fq_name_parts) < 3:
+            return
+        # Collection and plugin namespace packages are generated for the payload.
+        if len(self.fq_name_parts) <= self.module_utils_depth:
+            self._set_result(self.fq_name_parts, b'', '<generated>', True)
+            return
+        for name in self.candidate_names:
+            if self._redirect(name) or self._local(name):
+                return
 
