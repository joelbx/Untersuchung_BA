index 0000000..3c0bb10
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,143 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type testStore struct {
+	flags         []*flipt.Flag
+	segments      []*flipt.Segment
+	rules         []*flipt.Rule
+	variants      []*flipt.Variant
+	distributions []*flipt.Distribution
+	constraints   []*flipt.Constraint
+}
+
+func (s *testStore) ListFlags(_ context.Context, _ ...storage.QueryOption) ([]*flipt.Flag, error) {
+	return s.flags, nil
+}
+func (s *testStore) ListRules(_ context.Context, _ string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return s.rules, nil
+}
+func (s *testStore) ListSegments(_ context.Context, _ ...storage.QueryOption) ([]*flipt.Segment, error) {
+	return s.segments, nil
+}
+func (s *testStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	f := &flipt.Flag{Key: r.Key, Name: r.Name, Description: r.Description, Enabled: r.Enabled}
+	s.flags = append(s.flags, f)
+	return f, nil
+}
+func (s *testStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	v := &flipt.Variant{Id: r.Key + "-id", FlagKey: r.FlagKey, Key: r.Key, Name: r.Name, Description: r.Description, Attachment: r.Attachment}
+	s.variants = append(s.variants, v)
+	for _, f := range s.flags {
+		if f.Key == r.FlagKey {
+			f.Variants = append(f.Variants, v)
+		}
+	}
+	return v, nil
+}
+func (s *testStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	segment := &flipt.Segment{Key: r.Key, Name: r.Name, Description: r.Description}
+	s.segments = append(s.segments, segment)
+	return segment, nil
+}
+func (s *testStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	c := &flipt.Constraint{SegmentKey: r.SegmentKey, Type: r.Type, Property: r.Property, Operator: r.Operator, Value: r.Value}
+	s.constraints = append(s.constraints, c)
+	for _, segment := range s.segments {
+		if segment.Key == r.SegmentKey {
+			segment.Constraints = append(segment.Constraints, c)
+		}
+	}
+	return c, nil
+}
+func (s *testStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	rule := &flipt.Rule{Id: "rule-id", FlagKey: r.FlagKey, SegmentKey: r.SegmentKey, Rank: r.Rank}
+	s.rules = append(s.rules, rule)
+	return rule, nil
+}
+func (s *testStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	d := &flipt.Distribution{RuleId: r.RuleId, VariantId: r.VariantId, Rollout: r.Rollout}
+	s.distributions = append(s.distributions, d)
+	for _, rule := range s.rules {
+		if rule.Id == r.RuleId {
+			rule.Distributions = append(rule.Distributions, d)
+		}
+	}
+	return d, nil
+}
+
+func TestImportExportAttachments(t *testing.T) {
+	input := `flags:
+- key: feature
+  name: Feature
+  enabled: true
+  variants:
+  - key: treatment
+    attachment:
+      items: [true, 3, null, {nested: [a, 2.5]}]
+      5: value
+  - key: control
+  rules:
+  - segment: audience
+    rank: 1
+    distributions:
+    - variant: treatment
+      rollout: 75
+segments:
+- key: audience
+  constraints:
+  - type: STRING_COMPARISON_TYPE
+    property: country
+    operator: eq
+    value: US
+`
+	store := new(testStore)
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if len(store.flags) != 1 || len(store.variants) != 2 || len(store.segments) != 1 || len(store.constraints) != 1 || len(store.rules) != 1 || len(store.distributions) != 1 {
+		t.Fatal("missing imported entities")
+	}
+	if store.variants[1].Attachment != "" {
+		t.Fatalf("missing attachment became %q", store.variants[1].Attachment)
+	}
+	var attachment interface{}
+	if err := json.Unmarshal([]byte(store.variants[0].Attachment), &attachment); err != nil {
+		t.Fatal(err)
+	}
+	expected := map[string]interface{}{"items": []interface{}{true, float64(3), nil, map[string]interface{}{"nested": []interface{}{"a", float64(2.5)}}}, "5": "value"}
+	if !reflect.DeepEqual(attachment, expected) {
+		t.Fatalf("attachment = %#v", attachment)
+	}
+	var out bytes.Buffer
+	if err := NewExporter(store).Export(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := doc.Flags[0].Variants[0].Attachment.(map[interface{}]interface{}); !ok {
+		t.Fatalf("attachment was not a YAML map: %T", doc.Flags[0].Variants[0].Attachment)
+	}
+	if len(doc.Flags[0].Rules) != 1 || len(doc.Flags[0].Rules[0].Distributions) != 1 || doc.Flags[0].Rules[0].Distributions[0].VariantKey != "treatment" {
+		t.Fatal("rule distribution not exported")
+	}
+	if len(doc.Segments) != 1 || len(doc.Segments[0].Constraints) != 1 {
+		t.Fatal("segment constraint not exported")
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil {
+		t.Fatal("missing attachment appeared in export")
+	}
+}
