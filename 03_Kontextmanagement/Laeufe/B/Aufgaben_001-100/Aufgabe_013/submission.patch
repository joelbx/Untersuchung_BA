 import textwrap
 import traceback
 import yaml
@@ -71,6 +72,33 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    _TTY_MACRO = re.compile(
+        r'(?<!\w)(?:(?P<rule>HORIZONTALLINE)(?!\w)'
+        r'|(?P<basic>[IBMUC])\((?P<value>[^)]+)\)'
+        r'|(?P<crossref>[LR])\((?P<label>[^,()]+), *(?P<target>[^)]+)\))'
+    )
+
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            if match.group('rule'):
+                return '\n-------------\n'
+            if match.group('crossref'):
+                label = match.group('label')
+                return '%s <%s>' % (label, match.group('target')) if match.group('crossref') == 'L' else label
+
+            value = match.group('value')
+            kind = match.group('basic')
+            if kind == 'B':
+                return '*%s*' % value
+            if kind == 'M':
+                return '[%s]' % value
+            if kind in ('I', 'C'):
+                return "`%s'" % value
+            return value
+
+        return cls._TTY_MACRO.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
diff --git a/test/units/cli/test_doc.py b/test/units/cli/test_doc.py
