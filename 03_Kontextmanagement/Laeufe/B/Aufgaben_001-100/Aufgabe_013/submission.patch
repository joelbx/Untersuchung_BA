+++ b/test/units/cli/test_doc.py
@@ -0,0 +1,20 @@
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from ansible.cli.doc import DocCLI
+
+
+def test_tty_ify_links_and_references():
+    assert DocCLI.tty_ify('L(label,https://example.org) R(title,reference)') == 'label <https://example.org> title'
+    assert DocCLI.tty_ify('L(label, https://example.org) R(title, reference)') == 'label <https://example.org> title'
+
+
+def test_tty_ify_rule_and_multiple_macros():
+    text = 'M(name) B(text) C(value) R(title,ref) HORIZONTALLINE I(word) U(url)'
+    expected = "[name] *text* `value' title \n-------------\n `word' url"
+    assert DocCLI.tty_ify(text) == expected
+
+
+def test_tty_ify_preserves_plain_text_and_parenthesized_words():
+    text = 'IBM(International Business Machines) plain X(name) PREHORIZONTALLINEPOST'
+    assert DocCLI.tty_ify(text) == text
