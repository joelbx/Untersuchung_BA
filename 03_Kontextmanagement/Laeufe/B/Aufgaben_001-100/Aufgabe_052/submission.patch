+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package model
+
+import (
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// TokenCounter reports a token count.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll returns the sum of all counters.
+func (c TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range c {
+		if counter != nil {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount holds prompt and completion usage for one agent invocation.
+type TokenCount struct {
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount creates an empty token count.
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+
+// AddPromptCounter adds prompt usage. Nil counters are ignored.
+func (t *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt != nil {
+		t.prompt = append(t.prompt, prompt)
+	}
+}
+
+// AddCompletionCounter adds completion usage. Nil counters are ignored.
+func (t *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion != nil {
+		t.completion = append(t.completion, completion)
+	}
+}
+
+// CountAll returns the prompt and completion totals, in that order.
+func (t *TokenCount) CountAll() (int, int) {
+	return t.prompt.CountAll(), t.completion.CountAll()
+}
+
+// StaticTokenCounter holds a fixed token count.
+type StaticTokenCounter struct{ count int }
+
+// TokenCount returns the fixed count.
+func (c *StaticTokenCounter) TokenCount() int { return c.count }
+
+// NewPromptTokenCounter counts the content and framing of prompt messages.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	count := 0
+	for _, message := range messages {
+		tokens, _, err := tokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter counts a completed response.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter tracks a response while it streams.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter counts the starting fragment of a streamed response.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add records one streamed token.
+func (c *AsynchronousTokenCounter) Add() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count++
+	return nil
+}
+
+// setTextCount reconciles streamed chunks with the tokenization of the full
+// response. Token boundaries can cross chunk boundaries.
+func (c *AsynchronousTokenCounter) setTextCount(text string) error {
+	tokens, _, err := codec.NewCl100kBase().Encode(text)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	c.count = len(tokens)
+	return nil
+}
+
+// TokenCount finalizes the counter and returns its current total.
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
