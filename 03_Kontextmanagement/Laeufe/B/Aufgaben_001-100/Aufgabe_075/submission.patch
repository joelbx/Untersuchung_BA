@@ -0,0 +1,59 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r userPropsRepository) userID() (string, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return "", errors.New("user is missing from context")
+	}
+	return u.ID, nil
+}
+
+func (r userPropsRepository) Put(key, value string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").Values(uid, key, value).
+		Suffix("ON CONFLICT(user_id, key) DO UPDATE SET value = excluded.value")
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	query := Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key})
+	var result struct{ Value string }
+	if err := r.queryOne(query, &result); err != nil {
+		return "", err
+	}
+	return result.Value, nil
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..d2a8647
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,51 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("keeps properties scoped to the contextual user", func() {
+		o := orm.NewOrm()
+		users := NewUserRepository(context.Background(), o)
+		first := model.User{ID: "user-props-first", UserName: "user-props-first", NewPassword: "password"}
+		second := model.User{ID: "user-props-second", UserName: "user-props-second", NewPassword: "password"}
+		Expect(users.Put(&first)).To(Succeed())
+		Expect(users.Put(&second)).To(Succeed())
+
+		store := &SQLStore{orm: o}
+		firstProps := store.UserProps(request.WithUser(context.Background(), first))
+		secondProps := store.UserProps(request.WithUser(context.Background(), second))
+		Expect(firstProps.Put("key", "first")).To(Succeed())
+		_, err := secondProps.Get("key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(secondProps.Put("key", "second")).To(Succeed())
+		Expect(firstProps.Put("key", "updated")).To(Succeed())
+		value, err := firstProps.Get("key")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("updated"))
+		value, err = secondProps.Get("key")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("second"))
+		Expect(firstProps.Delete("key")).To(Succeed())
+		_, err = firstProps.Get("key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		value, err = secondProps.Get("key")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("second"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		props := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(props.Put("key", "value")).To(HaveOccurred())
+		_, err := props.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(props.Delete("key")).To(HaveOccurred())
+	})
+})
