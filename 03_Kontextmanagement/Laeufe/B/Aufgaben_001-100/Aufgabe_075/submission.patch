+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props (
+	user_id varchar(255) not null references user(id) on delete cascade,
+	key varchar(255) not null,
+	value text not null,
+	primary key (user_id, key)
+);
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from property p join user u on u.id = substr(p.id, length('LastFMSessionKey_') + 1)
+where substr(p.id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_';
+delete from property
+where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_'
+  and exists (select 1 from user u where u.id = substr(property.id, length('LastFMSessionKey_') + 1));
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	return nil
+}
diff --git a/db/migration/20210620120000_create_user_props_table_test.go b/db/migration/20210620120000_create_user_props_table_test.go
new file mode 100644
index 0000000..c9d8a2b
--- /dev/null
+++ b/db/migration/20210620120000_create_user_props_table_test.go
@@ -0,0 +1,50 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`
+create table user (id text primary key);
+create table property (id text primary key, value text);
+insert into user (id) values ('alice');
+insert into property (id, value) values
+	('LastFMSessionKey_alice', 'secret'),
+	('LastFMSessionKey_removed-user', 'orphan'),
+	('LastScan', 'unchanged');
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := db.QueryRow("select value from user_props where user_id = ? and key = ?", "alice", "LastFMSessionKey").Scan(&value); err != nil || value != "secret" {
+		t.Fatalf("migrated session: value=%q, err=%v", value, err)
+	}
+	var count int
+	if err := db.QueryRow("select count(*) from property where id = ?", "LastFMSessionKey_alice").Scan(&count); err != nil || count != 0 {
+		t.Fatalf("old session should be removed: count=%d, err=%v", count, err)
+	}
+	if err := db.QueryRow("select count(*) from property where id in (?, ?)", "LastFMSessionKey_removed-user", "LastScan").Scan(&count); err != nil || count != 2 {
+		t.Fatalf("unrelated or orphaned properties should remain: count=%d, err=%v", count, err)
+	}
+}
