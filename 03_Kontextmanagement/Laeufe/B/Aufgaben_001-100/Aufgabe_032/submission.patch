+    def test_jwrite_replaces_complete_file(self, monkeypatch, tmp_path):
+        path = str(tmp_path / 'job')
+        monkeypatch.setattr(async_wrapper, 'job_path', path, raising=False)
+        async_wrapper.jwrite({'started': 1, 'finished': 0})
+        original = open(path).read()
+        real_rename = os.rename
+
+        def check_before_rename(src, dst):
+            assert open(path).read() == original
+            assert json.load(open(src)) == {'started': 1, 'finished': 1}
+            real_rename(src, dst)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', check_before_rename)
+        async_wrapper.jwrite({'started': 1, 'finished': 1})
+        assert json.load(open(path)) == {'started': 1, 'finished': 1}
+
+    def test_run_module_error_has_job_id(self, monkeypatch, tmp_path):
+        path = str(tmp_path / 'job')
+        monkeypatch.setattr(async_wrapper, 'ipc_notifier', MagicMock())
+        async_wrapper._run_module(str(tmp_path / 'missing-module'), 'job-1', path)
+        result = json.load(open(path))
+        assert result['ansible_job_id'] == 'job-1'
+        assert result['started'] == 1
+        assert result['finished'] == 1
+        assert result['failed'] is True
+        assert result['msg']
+
+    def test_setup_error_emits_one_json_response(self, monkeypatch, tmp_path, capsys):
+        jobdir = tmp_path / 'not-a-directory'
+        jobdir.write_text('file')
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(jobdir))
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'jid', '10', '/module', '_'])
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        output = capsys.readouterr().out
+        result = json.loads(output)
+        assert output.count('\n') == 1
+        assert result['ansible_job_id']
+        assert result['failed'] is True
+        assert result['finished'] == 1
+        assert 'could not create async directory' in result['msg']
+
+    def test_fork_error_emits_one_json_response(self, monkeypatch, tmp_path, capsys):
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path / 'jobs'))
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'jid', '10', '/module', '_'])
+
+        def fail_fork():
+            raise OSError(11, 'fork unavailable')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        output = capsys.readouterr().out
+        result = json.loads(output)
+        assert output.count('\n') == 1
+        assert result['failed'] is True
+        assert result['finished'] == 1
+        assert 'fork unavailable' in result['msg']
+        job_path = os.path.join(str(tmp_path / 'jobs'), result['ansible_job_id'])
+        with open(job_path) as jobfile:
+            assert json.load(jobfile)['ansible_job_id'] == result['ansible_job_id']
