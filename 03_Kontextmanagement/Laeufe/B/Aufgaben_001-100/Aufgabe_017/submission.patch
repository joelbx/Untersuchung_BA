+package database
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/gravitational/trace"
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/stretchr/testify/require"
+
+	"github.com/gravitational/teleport/lib/srv/db/common"
+	"github.com/gravitational/teleport/lib/srv/db/sqlserver"
+)
+
+func TestSQLServerErrors(t *testing.T) {
+	p := SQLServerPinger{}
+	for _, tt := range []struct {
+		name        string
+		err         error
+		refused     bool
+		invalidUser bool
+		invalidName bool
+	}{
+		{name: "nil"},
+		{name: "refused", err: trace.Wrap(syscall.ECONNREFUSED), refused: true},
+		{name: "login rejected", err: trace.Wrap(mssql.Error{Number: 18456}), invalidUser: true},
+		{name: "login rejected pointer", err: trace.Wrap(&mssql.Error{Number: 18456}), invalidUser: true},
+		{name: "database rejected", err: trace.Wrap(mssql.Error{Number: 4060}), invalidName: true},
+		{name: "other SQL error", err: mssql.Error{Number: 1234}},
+		{name: "other error", err: errors.New("unexpected error")},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.refused, p.IsConnectionRefusedError(tt.err))
+			require.Equal(t, tt.invalidUser, p.IsInvalidDatabaseUserError(tt.err))
+			require.Equal(t, tt.invalidName, p.IsInvalidDatabaseNameError(tt.err))
+		})
+	}
+}
+
+func TestSQLServerPing(t *testing.T) {
+	testServer, err := sqlserver.NewTestServer(common.TestServerConfig{AuthClient: setupMockClient(t)})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, testServer.Close()) })
+	go func() { require.NoError(t, testServer.Serve()) }()
+
+	port, err := strconv.Atoi(testServer.Port())
+	require.NoError(t, err)
+	params := PingParams{Host: "localhost", Port: port, Username: "someuser", DatabaseName: "somedb"}
+	p := SQLServerPinger{}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	require.NoError(t, p.Ping(ctx, params))
+
+	expired, cancelExpired := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer cancelExpired()
+	require.ErrorIs(t, p.Ping(expired, params), context.DeadlineExceeded)
+
+	for _, invalid := range []PingParams{
+		{Host: "localhost", Port: port, DatabaseName: "somedb"},
+		{Host: "localhost", Port: port, Username: "someuser"},
+		{Host: "localhost", Port: -1, Username: "someuser", DatabaseName: "somedb"},
+	} {
+		require.True(t, trace.IsBadParameter(p.Ping(ctx, invalid)), fmt.Sprintf("params: %+v", invalid))
+	}
+}
