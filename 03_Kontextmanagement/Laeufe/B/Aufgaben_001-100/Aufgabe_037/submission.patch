+@pytest.mark.parametrize('filter_name, filter_func', [('to_yaml', to_yaml), ('to_nice_yaml', to_nice_yaml)])
+def test_yaml_filters_undefined(filter_name, filter_func):
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func({'value': AnsibleUndefined(name='missing_variable')})
+    assert filter_name in str(error.value)
+    assert 'missing_variable' in str(error.value)
+    assert isinstance(error.value.orig_exc, AnsibleUndefinedVariable)
+    assert isinstance(error.value.orig_exc.orig_exc, UndefinedError)
+    assert error.value.__cause__ is error.value.orig_exc.orig_exc
+
+
+@pytest.mark.parametrize('filter_name, filter_func', [('to_yaml', to_yaml), ('to_nice_yaml', to_nice_yaml)])
