+import punycode from 'punycode.js';
+
 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
 
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(/^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^@/?#]+@)?(?:www\.)?([^.:/?#]+)(?:\.[^/?#.:]+)+/i);
+    return match?.[1] || '';
+};
+
+export const punycodeUrl = (url: string): string => {
+    const parts = url.match(/^([a-z][a-z\d+.-]*:\/\/)([^/?#]*)([^?#]*)(\?[^#]*)?(#.*)?$/i);
+    if (!parts) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const parsed = new URL(url);
+    if (!parsed.hostname) {
+        throw new TypeError('Invalid URL hostname');
+    }
+
+    const credentialsEnd = parts[2].lastIndexOf('@');
+    const credentials = credentialsEnd < 0 ? '' : parts[2].slice(0, credentialsEnd + 1);
+    const hostname = parsed.hostname.startsWith('[') ? parsed.hostname : punycode.toASCII(parsed.hostname);
+    const pathname = parts[3].replace(/\/$/, '');
+
+    return `${parts[1]}${credentials}${hostname}${parsed.port ? `:${parsed.port}` : ''}${pathname}${parts[4] || ''}${
+        parts[5] || ''
+    }`;
+};
