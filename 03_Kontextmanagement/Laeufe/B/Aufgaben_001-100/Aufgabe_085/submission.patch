+func TestDiffStatusFormattingAndCounts(t *testing.T) {
+	infos := VulnInfos{
+		"CVE-NEW":  {CveID: "CVE-NEW", DiffStatus: DiffPlus},
+		"CVE-OLD":  {CveID: "CVE-OLD", DiffStatus: DiffMinus},
+		"CVE-SAME": {CveID: "CVE-SAME"},
+	}
+	plus, minus := infos.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Fatalf("CountDiff() = %d, %d; want 1, 1", plus, minus)
+	}
+	for _, tc := range []struct {
+		id   string
+		want string
+	}{
+		{"CVE-NEW", "+CVE-NEW"},
+		{"CVE-OLD", "-CVE-OLD"},
+	} {
+		if got := infos[tc.id].CveIDDiffFormat(true); got != tc.want {
+			t.Errorf("CveIDDiffFormat(true) = %q, want %q", got, tc.want)
+		}
+		if got := infos[tc.id].CveIDDiffFormat(false); got != tc.id {
+			t.Errorf("CveIDDiffFormat(false) = %q, want %q", got, tc.id)
+		}
+	}
+	data, err := json.Marshal(infos["CVE-NEW"])
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded map[string]interface{}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded["diffStatus"] != "+" {
+		t.Fatalf("diff status is absent from JSON: %s", data)
+	}
+}
