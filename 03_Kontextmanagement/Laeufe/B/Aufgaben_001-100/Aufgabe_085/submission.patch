+func TestDiffSelectionsAndPackageSources(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"CVE-NEW":  {CveID: "CVE-NEW", AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}},
+			"CVE-SAME": {CveID: "CVE-SAME", VulnType: "updated metadata"},
+		},
+		Packages: models.Packages{"new-package": {Name: "new-package", Version: "current"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"CVE-OLD":  {CveID: "CVE-OLD", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+			"CVE-SAME": {CveID: "CVE-SAME", VulnType: "old metadata"},
+		},
+		Packages: models.Packages{"old-package": {Name: "old-package", Version: "previous"}},
+	}
+	for _, tc := range []struct {
+		name        string
+		plus, minus bool
+		wantPlus    int
+		wantMinus   int
+	}{
+		{"both", true, true, 1, 1},
+		{"plus", true, false, 1, 0},
+		{"minus", false, true, 0, 1},
+		{"neither", false, false, 0, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tc.plus, tc.minus)
+			if err != nil || len(results) != 1 {
+				t.Fatalf("diff returned %d results, err %v", len(results), err)
+			}
+			got := results[0]
+			p, m := got.ScannedCves.CountDiff()
+			if p != tc.wantPlus || m != tc.wantMinus || len(got.ScannedCves) != p+m {
+				t.Fatalf("unexpected changes: %+v", got.ScannedCves)
+			}
+			if _, ok := got.ScannedCves["CVE-SAME"]; ok {
+				t.Fatal("common CVE appeared in diff")
+			}
+			if tc.plus {
+				if got.ScannedCves["CVE-NEW"].DiffStatus != models.DiffPlus || got.Packages["new-package"].Version != "current" {
+					t.Fatalf("new CVE or package is incorrect: %+v", got)
+				}
+			} else if _, ok := got.Packages["new-package"]; ok {
+				t.Fatal("unrequested new package appeared in diff")
+			}
+			if tc.minus {
+				if got.ScannedCves["CVE-OLD"].DiffStatus != models.DiffMinus || got.Packages["old-package"].Version != "previous" {
+					t.Fatalf("resolved CVE or package is incorrect: %+v", got)
+				}
+			} else if _, ok := got.Packages["old-package"]; ok {
+				t.Fatal("unrequested old package appeared in diff")
+			}
+		})
+	}
+}
