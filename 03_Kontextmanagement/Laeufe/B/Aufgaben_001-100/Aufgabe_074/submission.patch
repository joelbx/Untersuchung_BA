diff --git a/scripts/solr_builder/tests/test_fn_to_cli.py b/scripts/solr_builder/tests/test_fn_to_cli.py
index 1399523..36e971e 100644
--- a/scripts/solr_builder/tests/test_fn_to_cli.py
+++ b/scripts/solr_builder/tests/test_fn_to_cli.py
@@ -1,4 +1,5 @@
 from argparse import BooleanOptionalAction
+from pathlib import Path
 import typing
 from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
 
@@ -47,3 +48,35 @@ class TestFnToCLI:
     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    def test_path_and_required_typed_lists(self):
+        def fn(numbers: list[int], target: Path):
+            return numbers, target
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1', '2', '3', 'output.txt'])
+        assert cli.run() == ([1, 2, 3], Path('output.txt'))
+
+    def test_optional_lists_and_option_names(self):
+        def fn(
+            files: list[Path] | None = None,
+            scores: list[float] | None = None,
+            solr_url: str | None = None,
+        ):
+            return files, scores, solr_url
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--files', 'a.txt', 'b.txt', '--scores', '1.5', '2.5', '--solr_url', 'x'])
+        assert cli.run() == ([Path('a.txt'), Path('b.txt')], [1.5, 2.5], 'x')
+        cli.parse_args([])
+        assert cli.run() == (None, None, None)
+
+    def test_nullable_list_without_default_and_async_result(self):
+        async def fn(files: list[Path] | None):
+            return files
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() is None
+        cli.parse_args(['--files', 'a.txt', 'b.txt'])
+        assert cli.run() == [Path('a.txt'), Path('b.txt')]
