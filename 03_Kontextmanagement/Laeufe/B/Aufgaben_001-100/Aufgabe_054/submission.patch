@@ -17,6 +17,68 @@ func TestSingleton(t *testing.T) {
 	RunSpecs(t, "Singleton Suite")
 }
 
+func TestGetInstance(t *testing.T) {
+	type value struct{ id int }
+	valueCalls := 0
+	first := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 42}
+	})
+	second := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: -1}
+	})
+	if first != second || first.id != 42 || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", first, second, valueCalls)
+	}
+
+	pointerCalls := 0
+	firstPointer := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 99}
+	})
+	secondPointer := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: -1}
+	})
+	if firstPointer != secondPointer || firstPointer.id != 99 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", firstPointer, secondPointer, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type concurrentValue struct{ id int }
+	const calls = 20000
+	var created int32
+	results := make([]*concurrentValue, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *concurrentValue {
+				return &concurrentValue{id: int(atomic.AddInt32(&created, 1))}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+	if got := atomic.LoadInt32(&created); got != 1 {
+		t.Fatalf("constructor called %d times, want 1", got)
+	}
+	first := results[0]
+	if first == nil || first.id != 1 {
+		t.Fatalf("first result = %v, want instance 1", first)
+	}
+	for i, result := range results {
+		if result != first {
+			t.Fatalf("result %d differs from first instance", i)
+		}
+	}
+}
