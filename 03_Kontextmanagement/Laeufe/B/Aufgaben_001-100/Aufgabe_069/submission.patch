+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		input   string
+		want    bool
+	}{
+		{"foo", "foo", true},
+		{"foo", "foobar", false},
+		{"*", "anything", true},
+		{"foo*bar", "fooxbar", true},
+		{"foo*bar", "fooxbarx", false},
+		{"^foo[0-9]+$", "foo42", true},
+		{`{{regexp.match("foo[0-9]+")}}`, "xfoo42x", true},
+		{`{{regexp.match("^a{2}$")}}`, "aa", true},
+		{`{{regexp.not_match("^foo$")}}`, "bar", true},
+		{`{{regexp.not_match("^foo$")}}`, "foo", false},
+		{`foo-{{regexp.match("^bar$")}}-baz`, "foo-bar-baz", true},
+		{`foo-{{regexp.match("^bar$")}}-baz`, "foo-bar-extra-baz", false},
+		{`foo-{{regexp.match("^bar$")}}-baz`, "foo-baz", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern+"/"+tt.input, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if assert.NoError(t, err) {
+				assert.Equal(t, tt.want, matcher.Match(tt.input))
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		pattern string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, "unsupported function namespace other, supported namespaces are email and regexp"},
+		{`{{regexp.other("foo")}}`, "unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match."},
+		{`{{email.other("foo")}}`, "unsupported function email.other, supported functions are: email.local"},
+		{`{{regexp.match("[")}}`, "failed parsing regexp \"[\": error parsing regexp: missing closing ]: `[`"},
+		{`{{regexp.match()}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{regexp.match("a", "b")}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{regexp.match(internal.foo)}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{internal.foo}}`, `"internal.foo" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("a")}}{{regexp.match("b")}}`, `"{{regexp.match(\"a\")}}{{regexp.match(\"b\")}}" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{email.local("foo@example.com")}}`, `"email.local(\"foo@example.com\")" is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			_, err := Match(tt.pattern)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err))
+				assert.Equal(t, tt.message, err.Error())
+			}
+		})
+	}
+}
+
+func TestVariableRejectsMatcher(t *testing.T) {
+	input := `{{regexp.match("foo")}}`
+	_, err := Variable(input)
+	if assert.Error(t, err) {
+		assert.Equal(t, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`, err.Error())
+	}
+}
