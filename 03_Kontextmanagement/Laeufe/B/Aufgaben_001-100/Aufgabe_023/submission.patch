+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	config := AuthenticationConfig{}
+	methods := config.Methods.AllMethods()
+	for _, info := range methods {
+		assert.Equal(t, info.Method != auth.Method_METHOD_JWT, info.RequiresDatabase, info.Name())
+	}
+
+	assert.False(t, config.RequiresDatabase())
+	assert.False(t, config.ShouldRunCleanup())
+
+	config.Required = true
+	config.Methods.JWT.Enabled = true
+	config.Methods.JWT.Cleanup = &AuthenticationCleanupSchedule{Interval: time.Hour}
+	assert.False(t, config.RequiresDatabase())
+	assert.False(t, config.ShouldRunCleanup())
+
+	config.Methods.Token.Cleanup = &AuthenticationCleanupSchedule{Interval: time.Hour}
+	assert.False(t, config.RequiresDatabase(), "disabled methods must not require a database")
+	assert.False(t, config.ShouldRunCleanup(), "disabled methods must not trigger cleanup")
+
+	config.Methods.Token.Enabled = true
+	assert.True(t, config.RequiresDatabase())
+	assert.True(t, config.ShouldRunCleanup())
+
+	config.Methods.Token.Cleanup = nil
+	assert.True(t, config.RequiresDatabase())
+	assert.False(t, config.ShouldRunCleanup())
+}
