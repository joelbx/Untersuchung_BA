+
+func (s *AuthSuite) TestU2FSignRequestMultipleDevices(c *C) {
+	ctx := context.Background()
+	const user = "u2f-user"
+	password := []byte("abc123")
+	appID := "https://me.localhost"
+	pref, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  appID,
+			Facets: []string{appID},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.SetAuthPreference(pref), IsNil)
+	_, _, err = CreateUserAndRole(s.a, user, []string{user})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.UpsertPassword(user, password), IsNil)
+
+	keys := make([]*mocku2f.Key, 2)
+	for i := range keys {
+		keys[i], err = mocku2f.Create()
+		c.Assert(err, IsNil)
+		dev, err := u2f.NewDevice(fmt.Sprintf("key-%d", i), &u2f.Registration{
+			KeyHandle: keys[i].KeyHandle,
+			PubKey:    keys[i].PrivateKey.PublicKey,
+		}, time.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.a.UpsertMFADevice(ctx, user, dev), IsNil)
+	}
+
+	challenge, err := s.a.U2FSignRequest(user, password)
+	c.Assert(err, IsNil)
+	c.Assert(challenge.Challenges, HasLen, 2)
+	c.Assert(challenge.AuthenticateChallenge, NotNil)
+	c.Assert(challenge.AuthenticateChallenge.KeyHandle, Equals, challenge.Challenges[0].KeyHandle)
+
+	raw, err := json.Marshal(challenge)
+	c.Assert(err, IsNil)
+	var legacy u2f.AuthenticateChallenge
+	c.Assert(json.Unmarshal(raw, &legacy), IsNil)
+	c.Assert(legacy.KeyHandle, Equals, challenge.Challenges[0].KeyHandle)
+	var decoded U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(raw, &decoded), IsNil)
+	c.Assert(decoded.GetChallenges(), HasLen, 2)
+	legacyRaw, err := json.Marshal(challenge.AuthenticateChallenge)
+	c.Assert(err, IsNil)
+	var legacyDecoded U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(legacyRaw, &legacyDecoded), IsNil)
+	c.Assert(legacyDecoded.GetChallenges(), HasLen, 1)
+
+	for _, key := range keys {
+		matched := false
+		for _, ch := range challenge.Challenges {
+			resp, err := key.SignResponse(&ch)
+			if err != nil {
+				continue
+			}
+			c.Assert(s.a.CheckU2FSignResponse(ctx, user, resp), IsNil)
+			matched = true
+			break
+		}
+		c.Assert(matched, Equals, true)
+	}
+}
