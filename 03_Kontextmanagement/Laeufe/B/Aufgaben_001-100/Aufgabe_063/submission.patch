+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	tests := []struct {
+		name, yaml, addr, errText string
+		wantEnabled               bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", "", true},
+		{"default port", "proxy_service:\n  kube_listen_addr: proxy.example.com\n", "proxy.example.com:3026", "", true},
+		{"IPv6", "proxy_service:\n  kube_listen_addr: '[::]:8080'\n", "[::]:8080", "", true},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:8081\n", "0.0.0.0:8080", "", true},
+		{"legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:8081\n", "127.0.0.1:8081", "", true},
+		{"enabled conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", "", "kube_listen_addr conflicts with proxy_service.kubernetes", false},
+		{"nested address conflict", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    listen_addr: 127.0.0.1:8081\n", "", "kube_listen_addr conflicts with proxy_service.kubernetes", false},
+	}
+	for _, tt := range tests {
+		fc, err := ReadConfig(bytes.NewBufferString(tt.yaml))
+		c.Assert(err, check.IsNil, check.Commentf(tt.name))
+		cfg := service.MakeDefaultConfig()
+		err = ApplyFileConfig(fc, cfg)
+		if tt.errText != "" {
+			c.Assert(err, check.NotNil, check.Commentf(tt.name))
+			c.Assert(strings.Contains(err.Error(), tt.errText), check.Equals, true, check.Commentf(tt.name))
+			continue
+		}
+		c.Assert(err, check.IsNil, check.Commentf(tt.name))
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, tt.wantEnabled, check.Commentf(tt.name))
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, tt.addr, check.Commentf(tt.name))
+	}
+}
