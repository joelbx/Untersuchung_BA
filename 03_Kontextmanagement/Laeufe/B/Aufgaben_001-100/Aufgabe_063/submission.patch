+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	tc := &TeleportClient{Config: Config{WebProxyAddr: "web.example.com:3080"}}
+	for _, listen := range []string{"0.0.0.0:8080", "[::]:8080"} {
+		err := tc.applyProxySettings(ProxySettings{Kube: KubeProxySettings{Enabled: true, ListenAddr: listen}})
+		c.Assert(err, check.IsNil)
+		c.Assert(tc.KubeClusterAddr(), check.Equals, "https://web.example.com:8080")
+	}
+	err := tc.applyProxySettings(ProxySettings{Kube: KubeProxySettings{
+		Enabled: true, ListenAddr: "0.0.0.0:8080", PublicAddr: "kube.example.com:9443",
+	}})
+	c.Assert(err, check.IsNil)
+	c.Assert(tc.KubeClusterAddr(), check.Equals, "https://kube.example.com:9443")
+
+	tc.WebProxyAddr = "[2001:db8::1]:3080"
+	tc.KubeProxyAddr = "[::]:8080"
+	c.Assert(tc.KubeClusterAddr(), check.Equals, "https://[2001:db8::1]:8080")
+}
