+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_new_file_without_mode_warns_on_return(atomic_am, atomic_mocks, mocker):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+
+    assert atomic_am._created_files == {'/path/to/dest'}
+    warning = mocker.patch.object(atomic_am, 'warn')
+    atomic_am._return_formatted({})
+    warning.assert_called_once_with(
+        "File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning."
+    )
+
+
+@pytest.mark.parametrize('stdin, am', [({'mode': '0640'}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_new_file_with_mode_does_not_track_warning(atomic_am, atomic_mocks):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+
+    assert atomic_am._created_files == set()
+
+
+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_set_mode_clears_atomic_move_warning(atomic_am, atomic_mocks, mocker):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    mocker.patch('os.lstat', return_value=mocker.Mock(st_mode=0o600))
+    mocker.patch.object(atomic_am, 'check_file_absent_if_check_mode', return_value=False)
+
+    atomic_am.set_mode_if_different('/path/to/dest', 0o600, False)
+
+    assert atomic_am._created_files == set()
+    warning = mocker.patch.object(atomic_am, 'warn')
+    atomic_am._return_formatted({})
+    warning.assert_not_called()
+
+
