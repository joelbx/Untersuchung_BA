diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..a29da2b 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,4 +1,7 @@
+import web
+
 from openlibrary.plugins.openlibrary import lists
+from openlibrary.plugins.upstream import utils
 
 
 def test_process_seeds():
@@ -11,3 +14,65 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_post_body_ignores_query_parameters(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: (
+            b'name=From+body&name=Later&description=Body+description'
+            b'&seeds--0--key=%2Fbooks%2FOL1M&seeds--1--key='
+            b'&seeds--2--other=ignored&seeds--3--key=%2Fworks%2FOL2W'
+        ),
+    )
+
+    def unexpected_input(**defaults):
+        raise AssertionError('POST body must not be merged with query parameters')
+
+    monkeypatch.setattr(web, 'input', unexpected_input)
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'From body'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/books/OL1M'}, {'key': '/works/OL2W'}]
+
+
+def test_list_record_query_fallback(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+
+    def query_input(**defaults):
+        return web.storage({**defaults, 'name': 'From query', 'seeds--0--key': '/books/OL1M'})
+
+    monkeypatch.setattr(web, 'input', query_input)
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'From query'
+    assert record.description == ''
+    assert record.seeds == [{'key': '/books/OL1M'}]
+
+
+def test_list_record_post_simple_seeds(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'key=%2Fpeople%2Ftester%2Flists%2FOL1L&seeds=%2Fbooks%2FOL1M%2C',
+    )
+    monkeypatch.setattr(web, 'input', lambda **defaults: None)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key == '/people/tester/lists/OL1L'
+    assert record.name == ''
+    assert record.description == ''
+    assert record.seeds == [{'key': '/books/OL1M'}]
+
+
+def test_unflatten_last_assignment_wins():
+    assert utils.unflatten({'name': 'first', 'name--part': 'nested'}) == {
+        'name': {'part': 'nested'}
+    }
+    assert utils.unflatten({'name--part': 'nested', 'name': 'last'}) == {
+        'name': 'last'
+    }
