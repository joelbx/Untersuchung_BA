+        defaults = {'key': None, 'name': '', 'description': '', 'seeds': []}
+        body = web.data()
+        if body:
+            # Read the form body on its own: web.input() also includes URL parameters.
+            values = {
+                key: entries[0]
+                for key, entries in parse_qs(body.decode('utf-8')).items()
+            }
+            # Reconstruct before adding defaults, so an indexed field such as
+            # seeds--0--key can create its parent list.
+            i = web.storage({**defaults, **utils.unflatten(values)})
