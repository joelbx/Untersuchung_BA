 // NewMultiLog returns a new instance of a multi logger
-func NewMultiLog(loggers ...IAuditLog) *MultiLog {
-	return &MultiLog{
-		loggers: loggers,
+func NewMultiLog(loggers ...IAuditLog) (*MultiLog, error) {
+	emitters := make([]Emitter, 0, len(loggers))
+	for _, logger := range loggers {
+		emitter, ok := logger.(Emitter)
+		if !ok {
+			return nil, trace.BadParameter("expected emitter, but %T does not emit", logger)
+		}
+		emitters = append(emitters, emitter)
 	}
+	return &MultiLog{
+		MultiEmitter: NewMultiEmitter(emitters...),
+		loggers:      loggers,
+	}, nil
 }
 
 // MultiLog is a logger that fan outs write operations
 // to all loggers, and performs all read and search operations
 // on the first logger that implements the operation
 type MultiLog struct {
+	*MultiEmitter
 	loggers []IAuditLog
 }
 
diff --git a/lib/events/writer_emitter_test.go b/lib/events/writer_emitter_test.go
new file mode 100644
index 0000000..dbd6aba
--- /dev/null
+++ b/lib/events/writer_emitter_test.go
@@ -0,0 +1,68 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type testEventWriter struct {
+	bytes.Buffer
+	closeCount int
+	closeErr   error
+}
+
+func (w *testEventWriter) Close() error {
+	w.closeCount++
+	return w.closeErr
+}
+
+func TestWriterEmitter(t *testing.T) {
+	w := &testEventWriter{}
+	emitter := NewWriterEmitter(w)
+	event := &UserLogin{Method: "test"}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	data, err := json.Marshal(event)
+	require.NoError(t, err)
+	require.Equal(t, string(data)+"\n", w.String())
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 2, w.closeCount)
+}
+
+func TestWriterEmitterCloseErrors(t *testing.T) {
+	w := &testEventWriter{closeErr: errors.New("close failed")}
+	err := NewWriterEmitter(w).Close()
+	require.Error(t, err)
+	require.Equal(t, 2, w.closeCount)
+	require.Equal(t, 2, strings.Count(err.Error(), "close failed"))
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	_, err := NewMultiLog(NewWriterLog(&testEventWriter{}))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+
+	first, second := &testEventWriter{}, &testEventWriter{}
+	multi, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+	event := &UserLogin{Method: "test"}
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, first.String(), second.String())
+	require.True(t, strings.HasSuffix(first.String(), "\n"))
+	require.NoError(t, multi.Close())
+	require.Equal(t, 2, first.closeCount)
+	require.Equal(t, 2, second.closeCount)
+}
+
+var _ Emitter = (*WriterEmitter)(nil)
+var _ IAuditLog = (*WriterEmitter)(nil)
+var _ Emitter = (*MultiLog)(nil)
+var _ IAuditLog = (*MultiLog)(nil)
+var _ io.WriteCloser = (*testEventWriter)(nil)
