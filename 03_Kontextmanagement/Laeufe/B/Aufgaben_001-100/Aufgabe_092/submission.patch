--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,106 @@
+---
+- name: install older collections for upgrade tests
+  command: >-
+    ansible-galaxy collection install
+    namespace1.name1:0.0.1 child_dep.child_collection:0.4.0
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_collections/ansible_collections
+
+- name: write upgrade requirements file
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade-requirements.yml'
+    content: |
+      collections:
+        - name: namespace1.name1
+          version: '>=0.0.1,<1.0.0'
+        - name: child_dep.child_collection
+          version: '>=0.4.0,<0.9.9'
+
+- name: upgrade all collections in requirements file within constraints
+  command: >-
+    ansible-galaxy collection install --upgrade
+    -r {{ galaxy_dir }}/upgrade-requirements.yml
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_collections/ansible_collections
+  register: upgrade_from_file
+
+- name: read versions after requirements file upgrade
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade_collections/ansible_collections/{{ item }}/MANIFEST.json'
+  loop:
+    - namespace1/name1
+    - child_dep/child_collection
+  register: requirement_upgrade_manifests
+
+- name: check requirements file upgrade
+  assert:
+    that:
+      - "(requirement_upgrade_manifests.results[0].content | b64decode | from_json).collection_info.version == '0.1.0'"
+      - "(requirement_upgrade_manifests.results[1].content | b64decode | from_json).collection_info.version == '0.5.0'"
+
+- name: upgrade requested collection to latest stable release
+  command: >-
+    ansible-galaxy collection install -U namespace1.name1
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_collections/ansible_collections
+  register: upgrade_to_latest
+
+- name: repeat latest stable upgrade
+  command: >-
+    ansible-galaxy collection install --upgrade namespace1.name1
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_collections/ansible_collections
+  register: upgrade_to_latest_again
+
+- name: check latest stable upgrade is idempotent
+  assert:
+    that:
+      - "'Installing ''namespace1.name1:1.0.9'' to' in upgrade_to_latest.stdout"
+      - "'Skipping ''namespace1.name1:1.0.9'' as it is already installed' in upgrade_to_latest_again.stdout"
+
+- name: opt in to pre-release upgrade
+  command: >-
+    ansible-galaxy collection install -U --pre namespace1.name1
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_collections/ansible_collections
+  register: upgrade_to_prerelease
+
+- name: check pre-release upgrade
+  assert:
+    that:
+      - "'Installing ''namespace1.name1:1.1.0-beta.1'' to' in upgrade_to_prerelease.stdout"
+
+- name: install old dependency for transitive upgrade
+  command: >-
+    ansible-galaxy collection install child_dep.child_collection:0.4.0
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_deps/ansible_collections
+
+- name: upgrade incompatible dependency with parent
+  command: >-
+    ansible-galaxy collection install --upgrade parent_dep.parent_collection
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_deps/ansible_collections
+
+- name: read upgraded dependency version
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade_deps/ansible_collections/child_dep/child_collection/MANIFEST.json'
+  register: upgraded_dependency_manifest
+
+- name: check transitive dependency upgrade
+  assert:
+    that:
+      - "(upgraded_dependency_manifest.content | b64decode | from_json).collection_info.version == '0.9.9'"
+
+- name: install old dependency for no-deps upgrade
+  command: >-
+    ansible-galaxy collection install child_dep.child_collection:0.4.0
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_no_deps/ansible_collections
+
+- name: install parent with upgrade and no-deps
+  command: >-
+    ansible-galaxy collection install --upgrade --no-deps parent_dep.parent_collection
+    -s galaxy_ng -p {{ galaxy_dir }}/upgrade_no_deps/ansible_collections
+
+- name: read unchanged dependency version
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade_no_deps/ansible_collections/child_dep/child_collection/MANIFEST.json'
+  register: unchanged_dependency_manifest
+
+- name: check no-deps leaves installed dependency unchanged
+  assert:
+    that:
+      - "(unchanged_dependency_manifest.content | b64decode | from_json).collection_info.version == '0.4.0'"
