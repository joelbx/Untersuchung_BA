+func TestValidate_ConstraintArrayValues(t *testing.T) {
+	for _, comparisonType := range []ComparisonType{ComparisonType_STRING_COMPARISON_TYPE, ComparisonType_NUMBER_COMPARISON_TYPE} {
+		typeName := "string"
+		item := any("x")
+		valid := `["x"]`
+		wrong := `[1]`
+		if comparisonType == ComparisonType_NUMBER_COMPARISON_TYPE {
+			typeName = "number"
+			item = float64(1)
+			valid = `[1]`
+			wrong = `["x"]`
+		}
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			items := make([]any, MAX_JSON_ARRAY_ITEMS)
+			for i := range items {
+				items[i] = item
+			}
+			atLimit, err := json.Marshal(items)
+			assert.NoError(t, err)
+			overLimit, err := json.Marshal(append(items, item))
+			assert.NoError(t, err)
+			cases := []struct {
+				name, value string
+				wantErr     error
+			}{
+				{"valid", valid, nil},
+				{"at limit", string(atLimit), nil},
+				{"over limit", string(overLimit), errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", "foo", typeName, MAX_JSON_ARRAY_ITEMS)},
+				{"wrong element type", wrong, errors.ErrInvalidf("invalid value provided for property %q of type %s", "foo", typeName)},
+				{"invalid JSON", `[`, errors.ErrInvalidf("invalid value provided for property %q of type %s", "foo", typeName)},
+				{"empty value", ``, errors.ErrInvalidf("invalid value provided for property %q of type %s", "foo", typeName)},
+				{"null", `null`, errors.ErrInvalidf("invalid value provided for property %q of type %s", "foo", typeName)},
+				{"null element", `[null]`, errors.ErrInvalidf("invalid value provided for property %q of type %s", "foo", typeName)},
+				{"object", `{}`, errors.ErrInvalidf("invalid value provided for property %q of type %s", "foo", typeName)},
+			}
+			for _, tc := range cases {
+				t.Run(fmt.Sprintf("%s/%s/%s", typeName, operator, tc.name), func(t *testing.T) {
+					create := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: comparisonType, Operator: operator, Value: tc.value}
+					update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "foo", Type: comparisonType, Operator: operator, Value: tc.value}
+					assert.Equal(t, tc.wantErr, create.Validate())
+					assert.Equal(t, tc.wantErr, update.Validate())
+				})
+			}
+		}
+	}
+	for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+		create := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: ComparisonType_DATETIME_COMPARISON_TYPE, Operator: operator, Value: `["2024-01-01"]`}
+		update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "foo", Type: ComparisonType_DATETIME_COMPARISON_TYPE, Operator: operator, Value: `["2024-01-01"]`}
+		want := errors.ErrInvalidf("constraint operator %q is not valid for type datetime", operator)
+		assert.Equal(t, want, create.Validate())
+		assert.Equal(t, want, update.Validate())
+	}
