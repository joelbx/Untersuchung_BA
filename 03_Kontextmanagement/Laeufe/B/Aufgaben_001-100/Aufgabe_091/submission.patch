+func Test_matchesStringList(t *testing.T) {
+	tests := []struct {
+		name, operator, list, value string
+		want                        bool
+	}{
+		{"member", flipt.OpIsOneOf, `["red","blue"]`, "blue", true},
+		{"absent", flipt.OpIsOneOf, `["red","blue"]`, "green", false},
+		{"not member", flipt.OpIsNotOneOf, `["red","blue"]`, "green", true},
+		{"not member false", flipt.OpIsNotOneOf, `["red","blue"]`, "red", false},
+		{"empty member", flipt.OpIsOneOf, `[""]`, "", true},
+		{"invalid JSON", flipt.OpIsNotOneOf, `["red"`, "green", false},
+		{"wrong type", flipt.OpIsOneOf, `[1]`, "1", false},
+		{"null element", flipt.OpIsOneOf, `[null]`, "", false},
+		{"null", flipt.OpIsNotOneOf, `null`, "green", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			constraint := storage.EvaluationConstraint{Property: "color", Operator: tt.operator, Value: tt.list}
+			assert.Equal(t, tt.want, matchesString(constraint, tt.value))
+		})
+	}
+}
