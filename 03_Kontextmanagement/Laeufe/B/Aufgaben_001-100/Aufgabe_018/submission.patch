+func TestStringToSliceHookFunc(t *testing.T) {
+	hook := stringToSliceHookFunc().(func(reflect.Type, reflect.Type, interface{}) (interface{}, error))
+	stringSlice := reflect.TypeOf([]string{})
+
+	tests := []struct {
+		name   string
+		input  interface{}
+		target reflect.Type
+		want   interface{}
+	}{
+		{name: "whitespace", input: " \tfoo.com  bar.com\n\tbaz.com \r\n", target: stringSlice, want: []string{"foo.com", "bar.com", "baz.com"}},
+		{name: "empty", input: "", target: stringSlice, want: []string{}},
+		{name: "whitespace only", input: " \t\n", target: stringSlice, want: []string{}},
+		{name: "sequence", input: []string{"foo.com", "bar.com"}, target: stringSlice, want: []string{"foo.com", "bar.com"}},
+		{name: "non-string", input: 42, target: stringSlice, want: 42},
+		{name: "nil", input: nil, target: stringSlice, want: nil},
+		{name: "other target", input: "1 2", target: reflect.TypeOf([]int{}), want: "1 2"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(reflect.TypeOf(tt.input), tt.target, tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadEmptyAllowedOrigins(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: \"\"\n"), 0600))
+
+	t.Run("YAML", func(t *testing.T) {
+		cfg, err := Load(path)
+		require.NoError(t, err)
+		assert.Equal(t, []string{}, cfg.Cors.AllowedOrigins)
+	})
+
+	t.Run("ENV", func(t *testing.T) {
+		t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", "")
+		cfg, err := Load("./testdata/default.yml")
+		require.NoError(t, err)
+		assert.Equal(t, []string{}, cfg.Cors.AllowedOrigins)
+	})
+}
+
+func TestLoadAllowedOriginsSequence(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins:\n    - foo.com\n    - bar.com\n"), 0600))
+
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"foo.com", "bar.com"}, cfg.Cors.AllowedOrigins)
+}
