 _common_args = ['PowerShell', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Unrestricted']
+_clixml_escape = re.compile(r'_x([0-9a-fA-F]{4})_')
+
+
+def _decode_clixml_text(value: str) -> str:
+    parts = []
+    position = 0
+    matches = list(_clixml_escape.finditer(value))
+    index = 0
+
+    while index < len(matches):
+        match = matches[index]
+        parts.append(value[position:match.start()])
+        code_unit = int(match.group(1), 16)
+        next_match = matches[index + 1] if index + 1 < len(matches) else None
+        adjacent = next_match is not None and next_match.start() == match.end()
+
+        if code_unit == 0x005F and not adjacent:
+            parts.append(match.group())
+        elif 0xD800 <= code_unit <= 0xDBFF and adjacent and 0xDC00 <= int(next_match.group(1), 16) <= 0xDFFF:
+            low = int(next_match.group(1), 16)
+            parts.append(chr(0x10000 + (code_unit - 0xD800) * 0x400 + low - 0xDC00))
+            match = next_match
+            index += 1
+        else:
+            parts.append(chr(code_unit))
+
+        position = match.end()
+        index += 1
 
+    parts.append(value[position:])
+    return ''.join(parts)
 
