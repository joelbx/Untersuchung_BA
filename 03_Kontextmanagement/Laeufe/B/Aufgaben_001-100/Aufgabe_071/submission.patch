+def test_parse_clixml_escapes_and_surrogates():
+    data = (b'<Objs><S S="Error">_x005f__x000A__x000D__x000A__x263a_'
+            b'_xD83D__xDE00_ _xD83D_ _xDE00_ _x005G_ _x005F_</S></Objs>')
+    expected = '_\n\r\n☺😀 \ud83d \ude00 _x005G_ _x005F_'.encode('utf-8', 'surrogatepass')
+    assert _parse_clixml(data) == expected
+
+
+def test_parse_clixml_filters_and_joins_blocks():
+    data = (b'<Objs><S S="Info">ignored</S><S S="Error">one</S>'
+            b'<S S="Error"/><S S="Error">two</S></Objs>'
+            b'<Objs><S S="Info">ignored</S></Objs>'
+            b'<Objs><S S="Error">three</S></Objs>')
+    assert _parse_clixml(data) == b'onetwo\r\nthree'
+    assert _parse_clixml(data, stream='Info') == b'ignored\r\nignored'
+    assert _parse_clixml(data, stream='Warning') == b''
+    assert _parse_clixml(b'<Objs><S S="Error"/></Objs><Objs><S S="Error"/></Objs>') == b''
+
