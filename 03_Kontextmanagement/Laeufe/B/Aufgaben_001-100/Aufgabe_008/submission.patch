@@ -0,0 +1,81 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { RESPONSE_CODE } from '@proton/shared/lib/drive/constants';
+
+import useLink from './useLink';
+
+const mockRequest = jest.fn();
+const mockGetLink = jest.fn();
+const mockSetLinks = jest.fn();
+const mockIsDecryptedLinkSame = jest.fn();
+
+jest.mock('../_api', () => ({
+    useDebouncedRequest: () => mockRequest,
+    linkMetaToEncryptedLink: (link: unknown) => link,
+}));
+jest.mock('../_crypto', () => ({ useDriveCrypto: () => ({ getVerificationKey: jest.fn() }) }));
+jest.mock('../_shares', () => ({ useShare: () => ({ getSharePrivateKey: jest.fn() }) }));
+jest.mock('../_utils', () => ({
+    useDebouncedFunction: () => (callback: (signal: AbortSignal) => Promise<unknown>) =>
+        callback(new AbortController().signal),
+}));
+jest.mock('./useLinksKeys', () => () => ({}));
+jest.mock('./useLinksState', () => () => ({ getLink: mockGetLink, setLinks: mockSetLinks }));
+jest.mock('./link', () => ({ isDecryptedLinkSame: (...args: unknown[]) => mockIsDecryptedLinkSame(...args) }));
+
+describe('useLink failed fetch backoff', () => {
+    const signal = new AbortController().signal;
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        jest.clearAllMocks();
+        mockGetLink.mockReturnValue({ encrypted: { linkId: 'cached' }, decrypted: { linkId: 'cached' } });
+        mockIsDecryptedLinkSame.mockReturnValue(true);
+    });
+
+    afterEach(() => {
+        jest.clearAllTimers();
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses error code %s for the same link, then retries after backoff',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequest.mockRejectedValue(error);
+            const { result } = renderHook(() => useLink());
+
+            await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+            await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+            expect(mockRequest).toHaveBeenCalledTimes(1);
+
+            jest.runOnlyPendingTimers();
+            await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+            expect(mockRequest).toHaveBeenCalledTimes(2);
+        }
+    );
+
+    it('keeps failures scoped to the share and link, and processes successful fetches', async () => {
+        const error = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequest.mockRejectedValueOnce(error).mockResolvedValue({ Link: { linkId: 'valid' } });
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(signal, 'share', 'valid')).resolves.toEqual({ linkId: 'cached' });
+        expect(mockRequest).toHaveBeenCalledTimes(2);
+        expect(mockSetLinks).toHaveBeenCalledWith('share', [
+            { encrypted: { linkId: 'valid' }, decrypted: undefined },
+        ]);
+    });
+
+    it('does not cache other API errors', async () => {
+        const error = { data: { Code: 9999 } };
+        mockRequest.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+        await expect(result.current.loadFreshLink(signal, 'share', 'missing')).rejects.toBe(error);
+        expect(mockRequest).toHaveBeenCalledTimes(2);
+    });
+});
