+import { createRef } from 'react';
+
+import { fireEvent, render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards attributes, children, and the host ref in a limited DOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const onClick = jest.fn();
+        const { getByRole } = render(
+            <Dialog open aria-label="Example" data-testid="dialog-host" ref={ref}>
+                <button type="button" onClick={onClick}>
+                    Hello
+                </button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(ref.current).toBe(host);
+        expect(host).toHaveAttribute('data-testid', 'dialog-host');
+        expect(host).toHaveAttribute('open');
+
+        fireEvent.click(getByRole('button', { name: 'Hello' }));
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+
+    it('forwards the host ref and attributes when native dialog support is available', () => {
+        const originalShowModal = Object.getOwnPropertyDescriptor(HTMLDialogElement.prototype, 'showModal');
+        Object.defineProperty(HTMLDialogElement.prototype, 'showModal', {
+            configurable: true,
+            value: jest.fn(),
+        });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByRole } = render(
+                <Dialog open aria-label="Native example" data-testid="native-host" ref={ref}>
+                    <button type="button">Hello</button>
+                </Dialog>
+            );
+
+            const host = getByRole('dialog', { name: 'Native example' });
+            expect(host.tagName).toBe('DIALOG');
+            expect(ref.current).toBe(host);
+            expect(host).toHaveAttribute('data-testid', 'native-host');
+            expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+        } finally {
+            if (originalShowModal) {
+                Object.defineProperty(HTMLDialogElement.prototype, 'showModal', originalShowModal);
+            } else {
+                delete (HTMLDialogElement.prototype as Partial<HTMLDialogElement>).showModal;
+            }
+        }
+    });
+});
