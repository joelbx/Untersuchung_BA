--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,28 @@
+import { DialogHTMLAttributes, HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends DialogHTMLAttributes<HTMLDialogElement> {}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props, ref) => {
+    const supportsNativeDialog =
+        typeof HTMLDialogElement !== 'undefined' && typeof HTMLDialogElement.prototype.showModal === 'function';
+
+    if (supportsNativeDialog) {
+        return <dialog {...props} ref={ref} />;
+    }
+
+    // A limited dialog implementation can hide descendants from accessibility queries.
+    // Keep the same content and attributes on an ordinary host in that environment.
+    const fallbackProps = props as HTMLAttributes<HTMLDivElement>;
+    return (
+        <div
+            {...fallbackProps}
+            ref={ref as Ref<HTMLDivElement>}
+            role={props.role || 'dialog'}
+            hidden={props.hidden || !props.open}
+        />
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
