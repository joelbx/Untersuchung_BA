+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages = models.Packages{
+		"libgcc": {Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64"},
+	}
+	owners, err := r.parseOwnerPkgs(`libgcc 0 4.8.5 39.el7 i686
+error: file /run/log/journal/system.journal: Permission denied
+file /tmp/unowned is not owned by any package
+error: /tmp/missing: No such file or directory
+libgcc 0 4.8.5 39.el7 x86_64`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(owners, []string{"libgcc"}) {
+		t.Errorf("owners = %v, want [libgcc]", owners)
+	}
+	for _, line := range []string{"unexpected output", "libgcc invalid 4.8.5 39.el7 x86_64"} {
+		if _, err := r.parseOwnerPkgs(line); err == nil {
+			t.Errorf("expected error for %q", line)
+		}
+	}
+}
