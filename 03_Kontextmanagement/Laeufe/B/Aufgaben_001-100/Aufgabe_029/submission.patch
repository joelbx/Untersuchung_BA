+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat import unittest
+from units.compat.mock import MagicMock, Mock, patch
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+
+
+class TestNiosFixedAddress(unittest.TestCase):
+
+    def setUp(self):
+        self.module = MagicMock()
+        self.module.params = {'provider': None, 'state': 'present', 'name': 'printer',
+                              'ipaddr': '192.0.2.10', 'mac': '00:11:22:33:44:55',
+                              'network': '192.0.2.0/24', 'network_view': 'default',
+                              'options': None, 'extattrs': None, 'comment': None}
+        self.module.check_mode = False
+        self.connector_patch = patch('ansible.module_utils.net_tools.nios.api.get_connector')
+        self.connector_patch.start()
+
+    def tearDown(self):
+        self.connector_patch.stop()
+
+    def _spec(self):
+        return {'name': {}, 'ipaddr': {'ib_req': True}, 'mac': {'ib_req': True},
+                'network': {'ib_req': True}, 'network_view': {'ib_req': True},
+                'options': {'transform': nios_fixed_address.options},
+                'extattrs': {}, 'comment': {}}
+
+    def _wapi(self, existing):
+        wapi = api.WapiModule(self.module)
+        wapi.get_object = Mock(return_value=existing)
+        wapi.create_object = Mock()
+        wapi.update_object = Mock()
+        wapi.delete_object = Mock()
+        return wapi
+
+    def test_ipv4_create_and_repeat(self):
+        obj_type, spec, module = nios_fixed_address.validate_ip_addr_type(
+            self.module.params['ipaddr'], self._spec(), self.module)
+        self.assertEqual(obj_type, api.NIOS_IPV4_FIXED_ADDRESS)
+        self.assertIn('ipv4addr', spec)
+        wapi = self._wapi(None)
+        self.assertTrue(wapi.run(obj_type, spec)['changed'])
+        expected = {'name': 'printer', 'ipv4addr': '192.0.2.10',
+                    'mac': '00:11:22:33:44:55', 'network': '192.0.2.0/24',
+                    'network_view': 'default'}
+        wapi.get_object.assert_called_once_with(obj_type, {
+            'ipv4addr': '192.0.2.10', 'mac': '00:11:22:33:44:55',
+            'network': '192.0.2.0/24', 'network_view': 'default'
+        }, return_fields=spec.keys())
+        wapi.create_object.assert_called_once_with(obj_type, expected)
+        wapi.get_object.return_value = [dict(expected, _ref='fixedaddress/ref')]
+        self.assertFalse(wapi.run(obj_type, spec)['changed'])
+        self.assertEqual(wapi.create_object.call_count, 1)
+
+    def test_ipv6_update_delete_and_check_mode(self):
+        self.module.params['ipaddr'] = '2001:db8::10'
+        self.module.params['network'] = '2001:db8::/64'
+        self.module.params['comment'] = 'updated'
+        obj_type, spec, module = nios_fixed_address.validate_ip_addr_type(
+            self.module.params['ipaddr'], self._spec(), self.module)
+        self.assertEqual(obj_type, api.NIOS_IPV6_FIXED_ADDRESS)
+        existing = {'_ref': 'ipv6fixedaddress/ref', 'name': 'printer',
+                    'ipv6addr': '2001:db8::10', 'mac': '00:11:22:33:44:55',
+                    'network': '2001:db8::/64', 'network_view': 'default',
+                    'comment': 'old'}
+        wapi = self._wapi([dict(existing)])
+        self.module.check_mode = True
+        self.assertTrue(wapi.run(obj_type, spec)['changed'])
+        wapi.update_object.assert_not_called()
+        self.module.check_mode = False
+        wapi.get_object.return_value = [dict(existing)]
+        self.assertTrue(wapi.run(obj_type, spec)['changed'])
+        wapi.update_object.assert_called_once()
+        self.module.params['state'] = 'absent'
+        self.module.check_mode = True
+        wapi.get_object.return_value = [dict(existing)]
+        self.assertTrue(wapi.run(obj_type, spec)['changed'])
+        wapi.delete_object.assert_not_called()
+        self.module.check_mode = False
+        wapi.get_object.return_value = [dict(existing)]
+        self.assertTrue(wapi.run(obj_type, spec)['changed'])
+        wapi.delete_object.assert_called_once_with('ipv6fixedaddress/ref')
+
+    def test_invalid_ip_and_options(self):
+        self.module.fail_json.side_effect = ValueError('invalid argument')
+        with self.assertRaises(ValueError):
+            nios_fixed_address.validate_ip_addr_type('not-an-ip', self._spec(), self.module)
+        self.module.params['options'] = [{'name': None, 'num': None, 'value': 'x'}]
+        with self.assertRaises(ValueError):
+            nios_fixed_address.options(self.module)
+        self.module.params['options'] = [{'num': 42, 'value': 'x', 'name': None,
+                                          'use_option': None, 'vendor_class': None}]
+        self.assertEqual(nios_fixed_address.options(self.module), [
+            {'num': 42, 'value': 'x', 'use_option': True, 'vendor_class': 'DHCP'}])
+
+    def test_main_routes_address_and_requires_provider(self):
+        with patch.object(nios_fixed_address, 'AnsibleModule', return_value=self.module) as make_module:
+            with patch.object(api.WapiModule, 'run', return_value={'changed': True}) as run:
+                nios_fixed_address.main()
+                argument_spec = make_module.call_args[1]['argument_spec']
+                self.assertTrue(argument_spec['provider']['required'])
+                self.assertTrue(make_module.call_args[1]['supports_check_mode'])
+                obj_type, ib_spec = run.call_args[0]
+                self.assertEqual(obj_type, api.NIOS_IPV4_FIXED_ADDRESS)
+                self.assertIn('ipv4addr', ib_spec)
+                self.assertNotIn('ipaddr', ib_spec)
+                self.assertEqual(self.module.params['ipv4addr'], '192.0.2.10')
+                self.module.exit_json.assert_called_once_with(changed=True)
