+"""Collect HAProxy admin CSV metrics and publish them to Graphite."""
+
+import asyncio
+import csv
+import io
+import pickle
+import re
+import struct
+import time
+import urllib.request
+from collections.abc import Iterable, Iterator
+from dataclasses import dataclass
+from typing import Literal
+
+
+@dataclass
+class GraphiteEvent:
+    path: str
+    value: float
+    timestamp: int
+
+    def serialize(self) -> tuple[str, tuple[int, float]]:
+        return self.path, (self.timestamp, self.value)
+
+
+@dataclass
+class HaproxyCapture:
+    pxname: str
+    svname: str
+    field: list[str]
+
+    def matches(self, row: dict) -> bool:
+        return (
+            re.fullmatch(self.pxname, row.get("pxname", "")) is not None
+            and re.fullmatch(self.svname, row.get("svname", "")) is not None
+            and any(row.get(name) not in (None, "") for name in self.field)
+        )
+
+    def to_graphite_events(self, prefix: str, row: dict, ts: float) -> Iterator[GraphiteEvent]:
+        if not self.matches(row):
+            return
+        for name in self.field:
+            value = row.get(name)
+            if value in (None, ""):
+                continue
+            try:
+                number = float(value)
+            except (TypeError, ValueError):
+                continue
+            path = f"{prefix}.{row['pxname']}.{row['svname']}.{name}"
+            yield GraphiteEvent(path, number, int(ts))
+
+
+TO_CAPTURE = (HaproxyCapture(".*", ".*", ["scur", "rate", "qcur"]),)
+
+
+def fetch_events(haproxy_url: str, prefix: str, ts: float) -> Iterable[GraphiteEvent]:
+    """Read HAProxy's CSV endpoint and yield configured metrics."""
+    csv_url = haproxy_url if haproxy_url.endswith(";csv") else f"{haproxy_url};csv"
+    with urllib.request.urlopen(csv_url, timeout=10) as response:
+        body = response.read().decode("utf-8")
+    if body.startswith("# "):
+        body = body[2:]
+    for row in csv.DictReader(io.StringIO(body)):
+        for capture in TO_CAPTURE:
+            yield from capture.to_graphite_events(prefix, row, ts)
+
+
+async def _send_events(address: str, events: list[GraphiteEvent]) -> None:
+    host, port = address.rsplit(":", 1)
+    reader, writer = await asyncio.open_connection(host, int(port))
+    try:
+        payload = pickle.dumps([event.serialize() for event in events], protocol=2)
+        writer.write(struct.pack("!L", len(payload)) + payload)
+        await writer.drain()
+    finally:
+        writer.close()
+        await writer.wait_closed()
+
+
+async def main(
+    haproxy_url: str = "http://openlibrary.org/admin?stats",
+    graphite_address: str = "graphite.us.archive.org:2004",
+    prefix: str = "stats.ol.haproxy",
+    dry_run: bool = True,
+    fetch_freq: int = 10,
+    commit_freq: int = 30,
+    agg: Literal["max", "min", "sum", None] = None,
+) -> None:
+    """Poll HAProxy, buffer metrics, and print or send them at commit intervals."""
+    if fetch_freq <= 0 or commit_freq <= 0:
+        raise ValueError("fetch_freq and commit_freq must be positive")
+    if agg not in (None, "max", "min", "sum"):
+        raise ValueError(f"Unknown aggregation: {agg}")
+
+    pending: list[GraphiteEvent] = []
+    next_commit = time.monotonic() + commit_freq
+    while True:
+        events = await asyncio.to_thread(lambda: list(fetch_events(haproxy_url, prefix, time.time())))
+        pending.extend(events)
+        if time.monotonic() >= next_commit:
+            if agg is not None:
+                grouped: dict[str, GraphiteEvent] = {}
+                for event in pending:
+                    previous = grouped.get(event.path)
+                    if previous is None:
+                        grouped[event.path] = GraphiteEvent(event.path, event.value, event.timestamp)
+                    elif agg == "max":
+                        previous.value = max(previous.value, event.value)
+                        previous.timestamp = event.timestamp
+                    elif agg == "min":
+                        previous.value = min(previous.value, event.value)
+                        previous.timestamp = event.timestamp
+                    else:
+                        previous.value += event.value
+                        previous.timestamp = event.timestamp
+                pending = list(grouped.values())
+            if pending:
+                if dry_run:
+                    for event in pending:
+                        print(f"{event.path} {event.value} {event.timestamp}", flush=True)
+                else:
+                    await _send_events(graphite_address, pending)
+            pending = []
+            next_commit = time.monotonic() + commit_freq
+        await asyncio.sleep(fetch_freq)
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
