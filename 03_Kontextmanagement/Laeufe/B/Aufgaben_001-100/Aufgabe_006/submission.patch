@@ -0,0 +1,138 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestFanoutAndOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	read := func(c *Cursor[int], size int) []int {
+		t.Helper()
+		out := make([]int, size)
+		n, err := c.TryRead(out)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return out[:n]
+	}
+	if got := read(fast, 3); !reflect.DeepEqual(got, []int{1, 2, 3}) {
+		t.Fatalf("fast first read = %v", got)
+	}
+	if got := read(slow, 2); !reflect.DeepEqual(got, []int{1, 2}) {
+		t.Fatalf("slow first read = %v", got)
+	}
+	if got := read(fast, 3); !reflect.DeepEqual(got, []int{4, 5}) {
+		t.Fatalf("fast second read = %v", got)
+	}
+	if got := read(slow, 4); !reflect.DeepEqual(got, []int{3, 4, 5}) {
+		t.Fatalf("slow second read = %v", got)
+	}
+	b.Append(6)
+	if got := read(slow, 1); !reflect.DeepEqual(got, []int{6}) {
+		t.Fatalf("slow subsequent read = %v", got)
+	}
+	if got := read(fast, 1); !reflect.DeepEqual(got, []int{6}) {
+		t.Fatalf("fast subsequent read = %v", got)
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3)
+	if n, err := fast.TryRead(make([]int, 3)); err != nil || n != 3 {
+		t.Fatalf("fast initial read = (%d, %v)", n, err)
+	}
+	clock.Advance(time.Minute)
+	b.Append(4)
+	if _, err := slow.TryRead(make([]int, 4)); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow cursor error = %v", err)
+	}
+	if n, err := fast.TryRead(make([]int, 4)); err != nil || n != 1 {
+		t.Fatalf("fast cursor read = (%d, %v)", n, err)
+	}
+	if err := slow.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := slow.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor error = %v", err)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	var wg sync.WaitGroup
+	wg.Add(1)
+	type readResult struct {
+		n, value int
+		err      error
+	}
+	result := make(chan readResult, 1)
+	go func() {
+		defer wg.Done()
+		out := make([]int, 1)
+		n, err := c.Read(context.Background(), out)
+		result <- readResult{n: n, value: out[0], err: err}
+	}()
+	b.Append(42)
+	wg.Wait()
+	if got := <-result; got.err != nil || got.n != 1 || got.value != 42 {
+		t.Fatalf("read = %+v", got)
+	}
+	b.Close()
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("buffer close error = %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestReadCancellation(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	defer b.Close()
+	c := b.NewCursor()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read error = %v", err)
+	}
+}
+
+func TestReadUnblocksOnCursorClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	defer b.Close()
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, ErrUseOfClosedCursor) {
+			t.Fatalf("closed cursor read error = %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("read did not unblock after cursor close")
+	}
+}
