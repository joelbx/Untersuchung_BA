diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 0000000..ed3fc57
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,61 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a Redis client using the supplied cache configuration.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertPath != "" && cfg.CaCertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{
+			MinVersion:         tls.VersionTLS12,
+			InsecureSkipVerify: cfg.InsecureSkipTLS, //nolint:gosec // explicitly configured by the operator
+		}
+
+		var cert []byte
+		if cfg.CaCertBytes != "" {
+			cert = []byte(cfg.CaCertBytes)
+		} else if cfg.CaCertPath != "" {
+			var err error
+			cert, err = os.ReadFile(cfg.CaCertPath)
+			if err != nil {
+				return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+			}
+		}
+
+		if cfg.CaCertBytes != "" || cfg.CaCertPath != "" {
+			roots := x509.NewCertPool()
+			if !roots.AppendCertsFromPEM(cert) {
+				return nil, errors.New("invalid redis CA certificate")
+			}
+			tlsConfig.RootCAs = roots
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 0000000..cfba175
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,112 @@
+package redis
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func testCertificate(t *testing.T) ([]byte, tls.Certificate) {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	template := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "localhost"},
+		NotBefore:             time.Now().Add(-time.Minute),
+		NotAfter:              time.Now().Add(time.Hour),
+		DNSNames:              []string{"localhost"},
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
+	cert, err := tls.X509KeyPair(certPEM, keyPEM)
+	require.NoError(t, err)
+	return certPEM, cert
+}
+
+func TestNewClientTLS(t *testing.T) {
+	caPEM, serverCert := testCertificate(t)
+	path := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(path, caPEM, 0600))
+
+	for _, tt := range []struct {
+		name      string
+		cfg       config.RedisCacheConfig
+		wantTrust bool
+	}{
+		{name: "system roots", cfg: config.RedisCacheConfig{RequireTLS: true}},
+		{name: "inline CA", cfg: config.RedisCacheConfig{RequireTLS: true, CaCertBytes: string(caPEM)}, wantTrust: true},
+		{name: "CA file", cfg: config.RedisCacheConfig{RequireTLS: true, CaCertPath: path}, wantTrust: true},
+		{name: "skip verification", cfg: config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true}, wantTrust: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			client, err := NewClient(tt.cfg)
+			require.NoError(t, err)
+			defer client.Close()
+			tlsConfig := client.Options().TLSConfig
+			require.NotNil(t, tlsConfig)
+			require.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+			if tt.cfg.CaCertBytes == "" && tt.cfg.CaCertPath == "" {
+				require.Nil(t, tlsConfig.RootCAs)
+			} else {
+				require.NotNil(t, tlsConfig.RootCAs)
+			}
+			require.Equal(t, tt.cfg.InsecureSkipTLS, tlsConfig.InsecureSkipVerify)
+
+			listener, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{serverCert}, MinVersion: tls.VersionTLS12})
+			require.NoError(t, err)
+			defer listener.Close()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				conn, err := listener.Accept()
+				if err == nil {
+					defer conn.Close()
+					_ = conn.(*tls.Conn).Handshake()
+				}
+			}()
+			conn, err := tls.DialWithDialer(&net.Dialer{Timeout: time.Second}, "tcp", listener.Addr().String(), &tls.Config{
+				RootCAs: tlsConfig.RootCAs, ServerName: "localhost", MinVersion: tlsConfig.MinVersion,
+				InsecureSkipVerify: tlsConfig.InsecureSkipVerify, //nolint:gosec // exercises explicit operator setting
+			})
+			if tt.wantTrust {
+				require.NoError(t, err)
+				conn.Close()
+			} else {
+				require.Error(t, err)
+			}
+			<-done
+		})
+	}
+}
+
+func TestNewClientErrors(t *testing.T) {
+	_, err := NewClient(config.RedisCacheConfig{CaCertPath: "ca.pem", CaCertBytes: "cert"})
+	require.EqualError(t, err, "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertPath: filepath.Join(t.TempDir(), "missing.pem")})
+	require.ErrorIs(t, err, os.ErrNotExist)
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CaCertBytes: "invalid"})
+	require.EqualError(t, err, "invalid redis CA certificate")
+	client, err := NewClient(config.RedisCacheConfig{})
+	require.NoError(t, err)
+	require.Nil(t, client.Options().TLSConfig)
+	require.NoError(t, client.Close())
+}
