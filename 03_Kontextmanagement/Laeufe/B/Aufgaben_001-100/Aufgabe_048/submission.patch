@@ -0,0 +1,18 @@
+from __future__ import absolute_import, division, print_function
+
+import pytest
+
+from ansible.errors import AnsibleError
+from ansible.utils.display import Display
+
+
+def test_deprecation_message_includes_collection_version():
+    message = Display().get_deprecation_message('old plugin', version='2.0', collection_name='example.tools')
+    assert '[DEPRECATION WARNING]' in message
+    assert 'version 2.0 of example.tools' in message
+
+
+def test_removed_feature_raises_with_collection_date():
+    with pytest.raises(AnsibleError) as error:
+        Display().deprecated('old plugin', date='2026-01-01', removed=True, collection_name='example.tools')
+    assert 'removed from example.tools on 2026-01-01' in str(error.value)
