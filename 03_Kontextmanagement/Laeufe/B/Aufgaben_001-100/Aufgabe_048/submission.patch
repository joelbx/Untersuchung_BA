--- /dev/null
+++ b/test/units/plugins/test_loader_context.py
@@ -0,0 +1,66 @@
+from __future__ import absolute_import, division, print_function
+
+import pytest
+from types import SimpleNamespace
+
+from jinja2.exceptions import TemplateSyntaxError
+
+from ansible.errors import AnsiblePluginRemovedError
+from ansible.plugins.loader import PluginLoadContext, module_loader, get_with_context_result
+from ansible.plugins.loader import filter_loader
+from ansible.template import JinjaPluginIntercept
+
+
+def test_tombstone_preserves_context(monkeypatch):
+    monkeypatch.setattr(module_loader, '_query_collection_routing_meta',
+                        lambda *args, **kwargs: {'tombstone': {'removal_version': '2.0'}})
+
+    context = PluginLoadContext()
+    with pytest.raises(AnsiblePluginRemovedError) as error:
+        module_loader._find_fq_plugin('ansible.builtin.removed_example', '', context)
+
+    assert error.value.plugin_load_context is context
+    assert context.tombstone
+    assert context.removal_version == '2.0'
+    assert not context.resolved
+    assert '2.0' in str(error.value)
+
+    result = module_loader.get_with_context('ansible.builtin.removed_example')
+    assert isinstance(result, get_with_context_result)
+    assert result.object is None
+    assert result.plugin_load_context.tombstone
+    assert module_loader.get('ansible.builtin.removed_example') is None
+
+
+def test_missing_plugin_returns_resolution_context():
+    result = module_loader.get_with_context('ansible.builtin.no_such_plugin_for_context_test')
+    assert result.object is None
+    assert result.plugin_load_context.original_name == 'ansible.builtin.no_such_plugin_for_context_test'
+    assert not result.plugin_load_context.resolved
+    assert result.plugin_load_context.exit_reason
+
+
+def test_deprecation_context_uses_display(monkeypatch):
+    warnings = []
+    monkeypatch.setattr(module_loader, '_query_collection_routing_meta',
+                        lambda *args, **kwargs: {'deprecation': {'removal_version': '3.0'}})
+    monkeypatch.setattr('ansible.plugins.loader.display.deprecated', lambda **kwargs: warnings.append(kwargs))
+
+    context = module_loader.find_plugin_with_context('ansible.builtin.ping')
+    assert context.deprecated
+    assert context.removal_version == '3.0'
+    assert warnings and warnings[0]['collection_name'] == 'ansible.builtin'
+
+
+def test_removed_filter_is_template_syntax_error(monkeypatch):
+    context = PluginLoadContext()
+    context.tombstone = True
+    context.exit_reason = 'filter was removed from example.tools'
+    monkeypatch.setattr('ansible.template.import_module', lambda name: SimpleNamespace(__path__=[]))
+    monkeypatch.setattr('ansible.template.pkgutil.iter_modules',
+                        lambda path, prefix: [(None, prefix + 'removed_filter', False)])
+    monkeypatch.setattr(filter_loader, 'get_with_context',
+                        lambda name: get_with_context_result(None, context))
+
+    with pytest.raises(TemplateSyntaxError, match='filter was removed from example.tools'):
+        JinjaPluginIntercept({}, filter_loader)['example.tools.removed_filter']
