+func TestContextReaderPasswordCancellation(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ctx  func() (context.Context, context.CancelFunc)
+		err  error
+	}{
+		{"cancel", func() (context.Context, context.CancelFunc) { return context.WithCancel(context.Background()) }, context.Canceled},
+		{"deadline", func() (context.Context, context.CancelFunc) {
+			return context.WithTimeout(context.Background(), 50*time.Millisecond)
+		}, context.DeadlineExceeded},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pr, pw := io.Pipe()
+			defer pr.Close()
+			defer pw.Close()
+			term := &fakeTerm{reader: pr, started: make(chan struct{}, 1)}
+			cr := NewContextReader(pr)
+			cr.term = term
+			cr.fd = 0
+			defer cr.Close()
+
+			require.NoError(t, cr.firePasswordRead())
+			<-term.started
+			ctx, cancel := tc.ctx()
+			defer cancel()
+			if tc.err == context.Canceled {
+				cancel()
+			}
+			value, err := cr.ReadPassword(ctx)
+			require.ErrorIs(t, err, tc.err)
+			require.Empty(t, value)
+			require.True(t, term.restoreCalled)
+			require.Equal(t, readerStateClean, cr.state)
+
+			// The pending password read can be reclaimed as a clean read.
+			go func() { _, _ = pw.Write([]byte("next")) }()
+			value, err = cr.ReadContext(context.Background())
+			require.NoError(t, err)
+			require.Equal(t, "next", string(value))
+		})
+	}
+}
+
+func TestContextReaderCloseRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr, started: make(chan struct{}, 1)}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+	go func() { _, _ = cr.ReadPassword(context.Background()) }()
+	<-term.started
+	require.NoError(t, cr.Close())
+	require.True(t, term.restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+}
+
+func TestContextReaderCloseReturnsRestoreError(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	restoreErr := errors.New("restore failed")
+	term := &fakeTerm{reader: pr, started: make(chan struct{}, 1), restoreErr: restoreErr}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+	go func() { _, _ = cr.ReadPassword(context.Background()) }()
+	<-term.started
+	require.ErrorIs(t, cr.Close(), restoreErr)
+	require.Equal(t, readerStateClosed, cr.state)
+}
+
+func TestNotifyExitRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	term := &fakeTerm{reader: pr, started: make(chan struct{}, 1)}
+	cr := NewContextReader(pr)
