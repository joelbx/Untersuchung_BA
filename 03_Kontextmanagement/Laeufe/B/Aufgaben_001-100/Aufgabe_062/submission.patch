+
+// NotifyExit closes the global stdin reader before the program exits, allowing
+// an active password read to restore the terminal.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(io.Closer); ok {
+		if err := closer.Close(); err != nil {
+			log.Warnf("failed to close stdin prompt reader: %v", err)
+		}
+	}
+}
