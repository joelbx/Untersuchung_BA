@@ -0,0 +1,49 @@
+# This file is part of Ansible
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import pytest
+
+from units.compat.mock import Mock
+
+from ansible.module_utils.facts.hardware.aix import AIXHardware
+
+
+@pytest.mark.parametrize('smt_output, threads', [
+    ('smt_threads 4 SMT threads True\n', 4),
+    ('', 1),
+])
+def test_get_cpu_facts(smt_output, threads):
+    module = Mock()
+    module.run_command.side_effect = [
+        (0, '\n'.join('proc%d Available 00-00 Processor' % n for n in range(12)), ''),
+        (0, 'type PowerPC_POWER7 Processor type False\n', ''),
+        (0, smt_output, ''),
+    ]
+
+    facts = AIXHardware(module).get_cpu_facts()
+
+    assert facts == {
+        'processor': ['PowerPC_POWER7'],
+        'processor_count': 1,
+        'processor_cores': 12,
+        'processor_threads_per_core': threads,
+        'processor_vcpus': 12 * threads,
+    }
+    assert module.run_command.call_count == 3
+
+
+def test_get_cpu_facts_no_available_processors():
+    module = Mock()
+    module.run_command.return_value = (0, 'proc0 Defined 00-00 Processor\n', '')
+
+    assert AIXHardware(module).get_cpu_facts() == {
+        'processor': [],
+        'processor_count': 1,
+        'processor_cores': 0,
+        'processor_threads_per_core': 1,
+        'processor_vcpus': 0,
+    }
+    assert module.run_command.call_count == 1
