diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 25a157e..8fc573f 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -32,6 +32,50 @@ class TestIptables(ModuleTestCase):
             set_module_args({})
             iptables.main()
 
+    def test_destination_ports_multiport(self):
+        for protocol in ('tcp', 'udp', 'udplite', 'dccp', 'sctp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': [80, 443, '8081:8083'],
+                'jump': 'ACCEPT',
+                '_ansible_check_mode': True,
+            })
+            with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            command = run_command.call_args[0][0]
+            self.assertEqual(command.count('-m'), 1)
+            self.assertEqual(command[command.index('-m'):],
+                             ['-m', 'multiport', '--dports', '80,443,8081:8083'])
+
+    def test_destination_ports_rejects_other_protocols(self):
+        for protocol in (None, 'all', 'icmp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['80', '443'],
+            })
+            with self.assertRaises(AnsibleFailJson) as result:
+                iptables.main()
+            self.assertIn('destination_ports requires protocol', result.exception.args[0]['msg'])
+
+    def test_destination_ports_explicit_multiport_match(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'match': ['multiport'],
+            'destination_ports': ['80', '443'],
+            '_ansible_check_mode': True,
+        })
+        with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        command = run_command.call_args[0][0]
+        self.assertEqual(command.count('multiport'), 1)
+        self.assertEqual(command[command.index('-m'):],
+                         ['-m', 'multiport', '--dports', '80,443'])
+
