+class GzipDecodedReader(gzip.GzipFile if HAS_GZIP else object):
+    """Read a gzip response while retaining its HTTP response metadata."""
+
+    def __init__(self, fp):
+        if not HAS_GZIP:
+            raise MissingModuleError(self.missing_gzip_error(), GZIP_IMP_ERR, module='gzip')
+        self._response = fp
+        # The response itself is file-like on both Python 2 and Python 3. Its
+        # read method also observes the encoded Content-Length correctly.
+        super(GzipDecodedReader, self).__init__(fileobj=fp, mode='rb')
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    def close(self):
+        try:
+            super(GzipDecodedReader, self).close()
+        finally:
+            self._response.close()
+
+    @staticmethod
+    def missing_gzip_error():
+        return missing_required_lib('gzip', reason='for decompress=True')
 
 
