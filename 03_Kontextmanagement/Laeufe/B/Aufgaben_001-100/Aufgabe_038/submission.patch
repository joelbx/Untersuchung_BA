diff --git a/test/units/module_utils/urls/test_urls.py b/test/units/module_utils/urls/test_urls.py
index 69c1b82..33d64ab 100644
--- a/test/units/module_utils/urls/test_urls.py
+++ b/test/units/module_utils/urls/test_urls.py
@@ -8,9 +8,83 @@ __metaclass__ = type
 from ansible.module_utils import urls
 from ansible.module_utils._text import to_native
 
+import gzip
+import io
 import pytest
 
 
+class _Response(io.BytesIO):
+    def __init__(self, body, content_encoding=None):
+        super(_Response, self).__init__(body)
+        self.headers = {'Content-Length': str(len(body))}
+        if content_encoding:
+            self.headers['Content-Encoding'] = content_encoding
+        self.code = 200
+
+    def info(self):
+        return self.headers
+
+    def geturl(self):
+        return 'http://example.test/'
+
+
+def _gzip_bytes(data):
+    output = io.BytesIO()
+    with gzip.GzipFile(fileobj=output, mode='wb') as stream:
+        stream.write(data)
+    return output.getvalue()
+
+
+@pytest.mark.parametrize('encoded,decompress', [
+    (True, True), (True, False), (False, True), (False, False),
+])
+def test_request_gzip_response(mocker, encoded, decompress):
+    body = b'ansible gzip response ' * 1000
+    wire_body = _gzip_bytes(body) if encoded else body
+    response = _Response(wire_body, 'gzip' if encoded else None)
+    open_mock = mocker.patch.object(urls.urllib_request, 'urlopen', return_value=response)
+
+    result = urls.Request(decompress=decompress).open('GET', 'http://example.test/')
+    assert result.read() == (body if encoded and decompress else wire_body)
+    assert result.info()['Content-Length'] == str(len(wire_body))
+    assert open_mock.call_args[0][0].get_header('Accept-encoding') == ('gzip' if decompress else 'identity')
+    result.close()
+    assert response.closed
+
+
+def test_request_explicit_decompress_override_and_header(mocker):
+    body = _gzip_bytes(b'payload')
+    mocker.patch.object(urls.urllib_request, 'urlopen', return_value=_Response(body, 'gzip'))
+    result = urls.Request(decompress=False).open('GET', 'http://example.test/', decompress=True,
+                                                    headers={'accept-encoding': 'gzip'})
+    assert result.read() == b'payload'
+    result.close()
+
+
+def test_request_missing_gzip_reports_dependency(mocker):
+    mocker.patch.object(urls, 'HAS_GZIP', False)
+    mocker.patch.object(urls.urllib_request, 'urlopen', return_value=_Response(b'compressed', 'gzip'))
+    with pytest.raises(urls.MissingModuleError) as excinfo:
+        urls.Request().open('GET', 'http://example.test/')
+    assert excinfo.value.module == 'gzip'
+    assert 'gzip' in to_native(excinfo.value)
+
+
+def test_fetch_url_missing_gzip_disables_decompression(mocker, tmpdir):
+    mocker.patch.object(urls, 'HAS_GZIP', False)
+    open_mock = mocker.patch.object(urls, 'open_url', return_value=_Response(b'plain'))
+    module = mocker.Mock()
+    module.params = {}
+    module.tmpdir = str(tmpdir)
+
+    response, info = urls.fetch_url(module, 'http://example.test/')
+    assert response.read() == b'plain'
+    assert info['content-length'] == '5'
+    assert 'Content-Length' not in info
+    assert open_mock.call_args[1]['decompress'] is False
+    module.deprecate.assert_called_once_with(urls.GzipDecodedReader.missing_gzip_error(), version='2.16')
+
+
