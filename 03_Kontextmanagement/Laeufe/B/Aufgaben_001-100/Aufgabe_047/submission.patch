+type Hasher struct {
+	mu         sync.Mutex
+	seeds      map[string]string
+	globalSeed maphash.Seed
+	sequence   uint64
+}
+
+func NewHasher() *Hasher {
+	return &Hasher{
+		seeds:      make(map[string]string),
+		globalSeed: maphash.MakeSeed(),
+	}
 }
 
-func NewHasher() *hasher {
-	h := new(hasher)
-	h.seeds = make(map[string]maphash.Seed)
-	return h
+// SetSeed assigns a reproducible seed to the given id.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.seeds == nil {
+		h.seeds = make(map[string]string)
+	}
+	h.seeds[id] = seed
 }
 
-// Reseed generates a new seed for the given id
-func (h *hasher) Reseed(id string) {
-	h.seeds[id] = maphash.MakeSeed()
+// Reseed generates a new seed for the given id.
+func (h *Hasher) Reseed(id string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.reseed(id)
 }
 
-// HashFunc returns a function that hashes a string using the seed for the given id
-func (h *hasher) HashFunc() func(id, str string) uint64 {
+func (h *Hasher) reseed(id string) {
+	if h.seeds == nil {
+		h.seeds = make(map[string]string)
+	}
+	if h.globalSeed == (maphash.Seed{}) {
+		h.globalSeed = maphash.MakeSeed()
+	}
+	h.sequence++
+	h.seeds[id] = fmt.Sprintf("%016x", maphash.String(h.globalSeed, fmt.Sprintf("%d:%s", h.sequence, id)))
+}
+
+// HashFunc returns a function that hashes a string using the seed for the given id.
+func (h *Hasher) HashFunc() func(id, str string) uint64 {
 	return func(id, str string) uint64 {
-		var hash maphash.Hash
-		var seed maphash.Seed
-		var ok bool
-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
-			h.seeds[id] = seed
+		h.mu.Lock()
+		seed, ok := h.seeds[id]
+		if !ok {
+			h.reseed(id)
+			seed = h.seeds[id]
 		}
-		hash.SetSeed(seed)
-		_, _ = hash.WriteString(str)
-		return hash.Sum64()
+		h.mu.Unlock()
+
+		// Prefix the seed length to distinguish seed/input boundaries.
+		data := make([]byte, 8, 8+len(seed)+len(str))
+		binary.LittleEndian.PutUint64(data, uint64(len(seed)))
+		data = append(data, seed...)
+		data = append(data, str...)
+		sum := sha256.Sum256(data)
+		return binary.LittleEndian.Uint64(sum[:8])
 	}
 }
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..4948684 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,53 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the same hash when an explicit seed is restored", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("item", "first")
+		original := hashFunc("item", input)
+		other := hashFunc("other", input)
+		Expect(hashFunc("item", input)).To(Equal(original))
+
+		h.SetSeed("item", "second")
+		Expect(hashFunc("item", input)).NotTo(Equal(original))
+		Expect(hashFunc("other", input)).To(Equal(other))
+
+		h.Reseed("item")
+		Expect(hashFunc("item", input)).NotTo(Equal(original))
+
+		h.SetSeed("item", "first")
+		Expect(hashFunc("item", input)).To(Equal(original))
+		Expect(hashFunc("other", input)).To(Equal(other))
+	})
+
+	It("uses explicit seeds consistently across hasher instances", func() {
+		first := hasher.NewHasher()
+		second := hasher.NewHasher()
+		first.SetSeed("item", "fixed")
+		second.SetSeed("item", "fixed")
+		Expect(first.HashFunc()("item", input)).To(Equal(second.HashFunc()("item", input)))
+	})
+
+	It("initializes seeds for a zero-value hasher", func() {
+		var h hasher.Hasher
+		hashFunc := h.HashFunc()
+		initial := hashFunc("item", input)
+		Expect(hashFunc("item", input)).To(Equal(initial))
+		h.SetSeed("item", "fixed")
+		other := hasher.NewHasher()
+		other.SetSeed("item", "fixed")
+		Expect(hashFunc("item", input)).To(Equal(other.HashFunc()("item", input)))
+	})
+
+	It("supports explicit seeds through the package function", func() {
+		hashFunc := hasher.HashFunc()
+		hasher.SetSeed("package-seed", "first")
+		original := hashFunc("package-seed", input)
+		hasher.Reseed("package-seed")
+		Expect(hashFunc("package-seed", input)).NotTo(Equal(original))
+		hasher.SetSeed("package-seed", "first")
+		Expect(hashFunc("package-seed", input)).To(Equal(original))
+	})
 })
