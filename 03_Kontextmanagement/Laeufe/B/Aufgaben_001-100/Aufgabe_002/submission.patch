+func TestAuthSignKubeProxyAddress(t *testing.T) {
+	registered := func(addrs ...string) []services.Server {
+		var proxies []services.Server
+		for _, addr := range addrs {
+			proxy := &services.ServerV2{}
+			proxy.SetPublicAddr(addr)
+			proxies = append(proxies, proxy)
+		}
+		return proxies
+	}
+	tests := []struct {
+		name     string
+		config   *service.Config
+		proxies  []services.Server
+		override string
+		want     string
+		wantErr  bool
+	}{
+		{name: "local Kubernetes proxy", config: &service.Config{Proxy: service.ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			Kube:        service.KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:8443"}}},
+		}}, want: "https://kube.example.com:3026"},
+		{name: "registered proxy skips invalid address", config: &service.Config{},
+			proxies: registered("bad/address:3080", "proxy.example.com:invalid", "proxy.example.com:3080"), want: "https://proxy.example.com:3026"},
+		{name: "registered proxy missing valid address", config: &service.Config{},
+			proxies: registered("bad/address:3080"), wantErr: true},
+		{name: "explicit proxy", config: &service.Config{}, override: "https://custom.example.com:9443",
+			want: "https://custom.example.com:9443"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cmd := &AuthCommand{config: tt.config, outputFormat: identityfile.FormatKubernetes, proxyAddr: tt.override}
+			err := cmd.checkProxyAddr(mockClient{proxies: tt.proxies})
+			if (err != nil) != tt.wantErr || cmd.proxyAddr != tt.want {
+				t.Fatalf("checkProxyAddr() = %q, %v; want %q, error=%v", cmd.proxyAddr, err, tt.want, tt.wantErr)
+			}
+		})
+	}
+}
