@@ -31,6 +31,46 @@ import (
 
 func TestConfig(t *testing.T) { check.TestingT(t) }
 
+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name    string
+		config  ProxyConfig
+		want    string
+		wantErr bool
+	}{
+		{name: "disabled", config: ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}}, wantErr: true},
+		{name: "kube public address wins", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+			Kube:        KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:8443"}}},
+		}, want: "https://kube.example.com:3026"},
+		{name: "generic proxy fallback", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+			Kube:        KubeProxyConfig{Enabled: true},
+		}, want: "https://proxy.example.com:3026"},
+		{name: "IPv6", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "[::1]:3080"}},
+			Kube:        KubeProxyConfig{Enabled: true},
+		}, want: "https://[::1]:3026"},
+		{name: "missing public address", config: ProxyConfig{Kube: KubeProxyConfig{Enabled: true}}, wantErr: true},
+		{name: "invalid public address", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "bad/address:3080"}},
+			Kube:        KubeProxyConfig{Enabled: true},
+		}, wantErr: true},
+		{name: "invalid port", config: ProxyConfig{
+			PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:invalid"}},
+			Kube:        KubeProxyConfig{Enabled: true},
+		}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.config.KubeAddr()
+			if (err != nil) != tt.wantErr || got != tt.want {
+				t.Fatalf("KubeAddr() = %q, %v; want %q, error=%v", got, err, tt.want, tt.wantErr)
+			}
+		})
+	}
+}
