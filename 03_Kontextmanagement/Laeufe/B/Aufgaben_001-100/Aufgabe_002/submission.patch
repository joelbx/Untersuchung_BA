+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	var publicAddr utils.NetAddr
+	switch {
+	case len(c.Kube.PublicAddrs) > 0:
+		publicAddr = c.Kube.PublicAddrs[0]
+	case len(c.PublicAddrs) > 0:
+		publicAddr = c.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+
+	host, err := utils.Host(publicAddr.Addr)
+	if err != nil || host == "" || strings.ContainsAny(host, "/?#@ \t\r\n") {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", publicAddr.Addr)
+	}
+	if strings.Contains(publicAddr.Addr, ":") && net.ParseIP(publicAddr.Addr) == nil {
+		_, port, err := net.SplitHostPort(publicAddr.Addr)
+		portNumber, portErr := strconv.Atoi(port)
+		if err != nil || portErr != nil || portNumber < 1 || portNumber > 65535 {
+			return "", trace.BadParameter("invalid Kubernetes proxy public address %q", publicAddr.Addr)
+		}
+	}
+	return "https://" + net.JoinHostPort(host, fmt.Sprint(defaults.KubeProxyListenPort)), nil
+}
