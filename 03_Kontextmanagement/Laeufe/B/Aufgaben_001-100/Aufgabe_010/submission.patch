+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import { shallow } from "enzyme";
+
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import DisambiguatedProfile from "../../../../src/components/views/messages/DisambiguatedProfile";
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+import { mkEvent } from "../../../test-utils";
+
+describe("ReplyPreview", () => {
+    it("identifies the sender and offers a labeled cancel control", () => {
+        const replyToEvent = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:server",
+            user: "@alice:server",
+            content: { msgtype: "m.text", body: "Hello" },
+            ts: Date.now(),
+        });
+        const wrapper = shallow(<ReplyPreview replyToEvent={replyToEvent} permalinkCreator={null} />);
+
+        expect(wrapper.find("p").text()).toContain("Replying to");
+        expect(wrapper.find(DisambiguatedProfile).prop("as")).toBe("span");
+        expect(wrapper.find(DisambiguatedProfile).prop("fallbackName")).toBe("@alice:server");
+        expect(wrapper.find(CancelButton).prop("aria-label")).toBe("Cancel replying to a message");
+    });
+});
