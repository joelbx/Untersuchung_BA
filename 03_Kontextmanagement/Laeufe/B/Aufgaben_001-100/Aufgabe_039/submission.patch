+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        get_db().query("""
+            CREATE TABLE IF NOT EXISTS booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL DEFAULT -1,
+                notes text NOT NULL,
+                PRIMARY KEY (username, work_id, edition_id)
+            )
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.query("DELETE FROM booknotes")
+        self.db.insert(
+            'booknotes', username='reader', work_id=1, edition_id=-1, notes='source'
+        )
+        self.db.insert(
+            'booknotes', username='reader', work_id=1, edition_id=10,
+            notes='another source'
+        )
+
+    def teardown_method(self):
+        self.db.query("DELETE FROM booknotes")
+
+    def snapshot(self):
+        return sorted(
+            (row.username, row.work_id, row.edition_id, row.notes)
+            for row in self.db.select('booknotes')
+        )
+
+    def test_conflict_preserves_every_booknote(self):
+        self.db.insert('booknotes', username='reader', work_id=2, edition_id=-1, notes='target')
+        self.db.insert('booknotes', username='other', work_id=3, edition_id=-1, notes='unrelated')
+        before = self.snapshot()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {'rows_changed': 0, 'rows_deleted': 0, 'failed_deletes': 1}
+        assert self.snapshot() == before
+
+    def test_target_work_with_different_user_is_still_a_conflict(self):
+        self.db.insert('booknotes', username='other', work_id=2, edition_id=-1, notes='target')
+        before = self.snapshot()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {'rows_changed': 0, 'rows_deleted': 0, 'failed_deletes': 1}
+        assert self.snapshot() == before
+
+    def test_update_without_conflict(self):
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {'rows_changed': 2, 'rows_deleted': 0, 'failed_deletes': 0}
+        assert self.snapshot() == [
+            ('reader', 2, -1, 'source'),
+            ('reader', 2, 10, 'another source'),
+        ]
+
+    def test_dry_run_rolls_back_update(self):
+        before = self.snapshot()
+
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {'rows_changed': 2, 'rows_deleted': 0, 'failed_deletes': 0}
+        assert self.snapshot() == before
