diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..43c38be
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,47 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+
+const controller = module.exports;
+
+controller.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	const prefix = 'acct:';
+	if (typeof resource !== 'string' || !resource.startsWith(prefix) || !resource.endsWith(`@${hostname}`)) {
+		return res.sendStatus(400);
+	}
+
+	const username = resource.slice(prefix.length, -(hostname.length + 1));
+	if (!username || username.includes('@')) {
+		return res.sendStatus(400);
+	}
+
+	const allowed = await privileges.global.can('view:users', req.uid || 'guests');
+	if (!allowed) {
+		return res.sendStatus(403);
+	}
+
+	const uid = await user.getUidByUsername(username);
+	if (!uid) {
+		return res.sendStatus(404);
+	}
+
+	const userslug = await user.getUserField(uid, 'userslug');
+	const baseUrl = nconf.get('url').replace(/\/$/, '');
+	return res.json({
+		subject: resource,
+		aliases: [
+			`${baseUrl}/uid/${uid}`,
+			`${baseUrl}/user/${userslug}`,
+		],
+		links: [{
+			rel: 'http://webfinger.net/rel/profile-page',
+			type: 'text/html',
+			href: `${baseUrl}/user/${userslug}`,
+		}],
+	});
+};
