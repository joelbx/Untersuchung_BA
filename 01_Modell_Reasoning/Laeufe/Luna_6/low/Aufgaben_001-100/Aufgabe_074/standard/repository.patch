     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    def test_paths_and_typed_lists(self):
+        def fn(path: Path, numbers: list[int], label: str):
+            return path, numbers, label
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['single', '1', '2', 'last'])
+        assert cli.run() == (Path('single'), [1, 2], 'last')
+
+        def paths_fn(paths: list[Path]):
+            return paths
+
+        paths_cli = FnToCLI(paths_fn)
+        paths_cli.parse_args(['one', 'two'])
+        assert paths_cli.run() == [Path('one'), Path('two')]
+
+    def test_optional_lists_are_flagged_and_none_when_omitted(self):
+        def fn(required: int, files: list[Path] | None = None):
+            return files
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1'])
+        assert cli.run() is None
+
+        cli.parse_args(['1', '--files', 'one', 'two'])
+        assert cli.run() == [Path('one'), Path('two')]
+        assert '--files' in cli.parser.format_usage()
+
+    def test_flag_names_keep_parameter_underscores(self):
+        def fn(file_paths: list[str] | None = None):
+            return file_paths
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--file_paths', 'a', 'b'])
+        assert cli.run() == ['a', 'b']
+
+    def test_run_returns_async_result(self):
+        async def fn(value: int):
+            return value + 1
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['2'])
+        assert cli.run() == 3
