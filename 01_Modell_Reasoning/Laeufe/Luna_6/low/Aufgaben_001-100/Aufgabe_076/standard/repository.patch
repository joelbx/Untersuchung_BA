@@ -0,0 +1,18 @@
+import { inputToRecipient, splitBySeparator } from '@proton/shared/lib/mail/recipient';
+
+describe('splitBySeparator', () => {
+    it('splits, trims, removes brackets, and discards empty tokens', () => {
+        expect(splitBySeparator(',<plus@example.com>, visionary@example.com; pro@example.com,')).toEqual([
+            'plus@example.com',
+            'visionary@example.com',
+            'pro@example.com',
+        ]);
+    });
+});
+
+describe('inputToRecipient', () => {
+    it('uses the email as both name and address for plain and bracketed emails', () => {
+        expect(inputToRecipient('email@domain')).toEqual({ Name: 'email@domain', Address: 'email@domain' });
+        expect(inputToRecipient('<email@domain>')).toEqual({ Name: 'email@domain', Address: 'email@domain' });
+    });
+});
