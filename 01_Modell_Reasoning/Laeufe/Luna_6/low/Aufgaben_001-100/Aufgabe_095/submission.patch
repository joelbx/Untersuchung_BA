+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Format a year and optional month/day as a normalized date string."""
+    result = f'{year:04d}'
+    if month is None:
+        return result
+    result += f'-{month:02d}'
+    if day is not None:
+        result += f'-{day:02d}'
+    return result
+
+
+class patron_check_ins:
+    """Validation for requests that update a patron's check-in."""
+
+    def is_valid(self, data: dict) -> bool:
+        """Require an event identifier and date or event data to update."""
+        return bool(data and data.get('id') and ('year' in data or 'data' in data))
