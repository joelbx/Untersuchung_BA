+		return email;
+	}
+	const code = await db.get(`confirm:byUid:${uid}`);
+	if (!code) {
+		return '';
+	}
+	const confirmation = await db.getObject(`confirm:${code}`);
+	return confirmation && parseInt(confirmation.uid, 10) === parseInt(uid, 10) ? confirmation.email : '';
+};
+
+UserEmail.isValidationPending = async function (uid, email) {
+	const code = await db.get(`confirm:byUid:${uid}`);
+	if (!code) {
+		return false;
+	}
+	const confirmation = await db.getObject(`confirm:${code}`);
+	return !!(confirmation && parseInt(confirmation.uid, 10) === parseInt(uid, 10) &&
+		confirmation.email && (!email || confirmation.email.toLowerCase() === email.toLowerCase()) &&
+		Number(confirmation.expires) > Date.now());
+};
+
