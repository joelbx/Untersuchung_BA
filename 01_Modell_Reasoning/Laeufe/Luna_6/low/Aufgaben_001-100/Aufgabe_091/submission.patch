diff --git a/rpc/flipt/validation.go b/rpc/flipt/validation.go
index b336425..d2ade05 100644
--- a/rpc/flipt/validation.go
+++ b/rpc/flipt/validation.go
@@ -12,6 +12,42 @@ import (
 
 const maxVariantAttachmentSize = 10000
 
+const MAX_JSON_ARRAY_ITEMS = 100
+
+func validateArrayValue(property, value string, comparisonType ComparisonType) error {
+	invalid := func() error {
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, comparisonTypeName(comparisonType))
+	}
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		var values []string
+		if err := json.Unmarshal([]byte(value), &values); err != nil || values == nil {
+			return invalid()
+		}
+		if len(values) > MAX_JSON_ARRAY_ITEMS {
+			return errors.ErrInvalidf("too many values provided for property %q of type string (maximum %d)", property, MAX_JSON_ARRAY_ITEMS)
+		}
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		var values []float64
+		if err := json.Unmarshal([]byte(value), &values); err != nil || values == nil {
+			return invalid()
+		}
+		if len(values) > MAX_JSON_ARRAY_ITEMS {
+			return errors.ErrInvalidf("too many values provided for property %q of type number (maximum %d)", property, MAX_JSON_ARRAY_ITEMS)
+		}
+	default:
+		return invalid()
+	}
+	return nil
+}
+
+func comparisonTypeName(comparisonType ComparisonType) string {
+	if comparisonType == ComparisonType_STRING_COMPARISON_TYPE {
+		return "string"
+	}
+	return "number"
+}
+
 // Validator validates types
 type Validator interface {
 	Validate() error
