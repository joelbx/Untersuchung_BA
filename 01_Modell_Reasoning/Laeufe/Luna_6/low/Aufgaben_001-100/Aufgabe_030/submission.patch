diff --git a/test/units/module_utils/facts/test_facts.py b/test/units/module_utils/facts/test_facts.py
index c794f03..82dbe5f 100644
--- a/test/units/module_utils/facts/test_facts.py
+++ b/test/units/module_utils/facts/test_facts.py
@@ -114,6 +114,33 @@ class TestAIXHardware(BaseTestFactsPlatform):
     fact_class = hardware.aix.AIXHardware
     collector_class = hardware.aix.AIXHardwareCollector
 
+    def test_processor_facts(self):
+        module = Mock()
+        module.run_command.side_effect = [
+            (0, 'proc0 Available 00-00 Processor\nproc1 Available 00-01 Processor\n', ''),
+            (0, 'type PowerPC_POWER7\n', ''),
+            (0, 'smt_threads 4\n', ''),
+        ]
+        facts = self.fact_class(module=module, load_on_init=False).get_cpu_facts()
+        self.assertEqual(facts, {
+            'processor': ['PowerPC_POWER7'],
+            'processor_count': 1,
+            'processor_cores': 2,
+            'processor_threads_per_core': 4,
+            'processor_vcpus': 8,
+        })
+
+    def test_processor_facts_without_smt_value(self):
+        module = Mock()
+        module.run_command.side_effect = [
+            (0, 'proc0 Available 00-00 Processor\n', ''),
+            (0, 'type PowerPC_POWER7\n', ''),
+            (0, '', ''),
+        ]
+        facts = self.fact_class(module=module, load_on_init=False).get_cpu_facts()
+        self.assertEqual(facts['processor_threads_per_core'], 1)
+        self.assertEqual(facts['processor_vcpus'], 1)
+
 
 class TestHPUXHardware(BaseTestFactsPlatform):
