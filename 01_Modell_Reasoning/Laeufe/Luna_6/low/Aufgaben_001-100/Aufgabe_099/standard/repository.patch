 	assert.False(t, resp.Responses[0].Match)
 }
 
+func TestBatchEvaluate_DisabledFlagContinuesInOrder(t *testing.T) {
+	store := &storeMock{}
+	s := &Server{logger: logger, store: store}
+	store.On("GetFlag", mock.Anything, "enabled").Return(enabledFlag, nil)
+	store.On("GetFlag", mock.Anything, "disabled").Return(disabledFlag, nil)
+	store.On("GetEvaluationRules", mock.Anything, "enabled").Return([]*storage.EvaluationRule{}, nil)
+
+	resp, err := s.BatchEvaluate(context.Background(), &flipt.BatchEvaluationRequest{
+		RequestId: "batch",
+		Requests: []*flipt.EvaluationRequest{
+			{FlagKey: "enabled", EntityId: "one"},
+			{FlagKey: "disabled", EntityId: "two"},
+		},
+	})
+
+	require.NoError(t, err)
+	require.Len(t, resp.Responses, 2)
+	assert.Equal(t, "enabled", resp.Responses[0].FlagKey)
+	assert.Equal(t, "disabled", resp.Responses[1].FlagKey)
+	assert.False(t, resp.Responses[1].Match)
+	for _, result := range resp.Responses {
+		assert.NotNil(t, result.Timestamp)
+		assert.GreaterOrEqual(t, result.RequestDurationMillis, float64(0))
+	}
+	assert.GreaterOrEqual(t, resp.RequestDurationMillis, float64(0))
+}
