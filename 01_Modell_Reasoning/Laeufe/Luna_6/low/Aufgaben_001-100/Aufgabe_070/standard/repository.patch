--- a/openlibrary/catalog/utils/__init__.py
+++ b/openlibrary/catalog/utils/__init__.py
@@ -5,6 +5,11 @@ from typing import TYPE_CHECKING
 from unicodedata import normalize
 
 import web
+from openlibrary.plugins.upstream.utils import (
+    LanguageNoMatchError,
+    get_abbrev_from_full_lang_name,
+    get_marc21_language,
+)
 
 if TYPE_CHECKING:
     from openlibrary.plugins.upstream.models import Author
@@ -455,10 +460,26 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
         return []
 
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        normalized = language.strip().casefold()
+        code = get_marc21_language(normalized)
+        if normalized == 'deutsch':
+            code = 'ger'
+        site = getattr(web.ctx, 'site', None)
+        if code is None:
+            if site is not None:
+                try:
+                    code = get_abbrev_from_full_lang_name(normalized)
+                except LanguageNoMatchError:
+                    pass
+
+        if code is None or (site is not None and site.get(f"/languages/{code}") is None):
+            raise InvalidLanguage(normalized)
+
+        key = f'/languages/{code}'
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
