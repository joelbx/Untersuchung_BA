index 0000000..7f2d857
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,18 @@
+import React, { forwardRef, HTMLAttributes, ReactNode } from 'react';
+
+export interface DialogProps extends HTMLAttributes<HTMLDialogElement> {
+    children?: ReactNode;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, DialogProps>(({ children, ...props }, ref) => {
+    // JSDOM has historically exposed a partial HTMLDialogElement implementation.
+    // Keep the native host where available; the abstraction can be aliased by
+    // environments that need a different host element.
+    const host = typeof HTMLDialogElement === 'undefined' ? 'div' : 'dialog';
+
+    return React.createElement(host, { ...props, ref }, children);
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
