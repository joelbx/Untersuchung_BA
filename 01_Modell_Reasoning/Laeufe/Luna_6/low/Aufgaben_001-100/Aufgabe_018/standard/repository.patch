+func TestStringToSliceHook(t *testing.T) {
+	hook := stringToSliceHookFunc().(func(reflect.Type, reflect.Type, interface{}) (interface{}, error))
+	stringType := reflect.TypeOf("")
+	stringSliceType := reflect.TypeOf([]string{})
+
+	tests := []struct {
+		name string
+		from reflect.Type
+		to   reflect.Type
+		data interface{}
+		want interface{}
+	}{
+		{name: "whitespace", from: stringType, to: stringSliceType, data: " \tfoo\nbar  ", want: []string{"foo", "bar"}},
+		{name: "empty string", from: stringType, to: stringSliceType, data: " \t\n", want: []string{}},
+		{name: "sequence", from: stringSliceType, to: stringSliceType, data: []string{"foo", "bar"}, want: []string{"foo", "bar"}},
+		{name: "non string source", from: reflect.TypeOf(42), to: stringSliceType, data: 42, want: 42},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(tt.from, tt.to, tt.data)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
