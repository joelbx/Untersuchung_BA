+// DiffStatus identifies whether a vulnerability was added or removed by a diff.
+type DiffStatus string
+
+const (
+	DiffPlus  DiffStatus = "+"
+	DiffMinus DiffStatus = "-"
+)
+
+// CountDiff returns the number of added and removed vulnerabilities.
+func (v VulnInfos) CountDiff() (nPlus int, nMinus int) {
+	for _, vuln := range v {
+		switch vuln.DiffStatus {
+		case DiffPlus:
+			nPlus++
+		case DiffMinus:
+			nMinus++
+		}
+	}
+	return
+}
