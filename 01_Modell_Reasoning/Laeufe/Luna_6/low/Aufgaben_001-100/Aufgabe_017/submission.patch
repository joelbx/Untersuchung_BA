+package database
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strings"
+
+	"github.com/gravitational/trace"
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/microsoft/go-mssqldb/msdsn"
+	"github.com/sirupsen/logrus"
+
+	"github.com/gravitational/teleport/lib/defaults"
+)
+
+// SQLServerPinger implements the DatabasePinger interface for SQL Server.
+type SQLServerPinger struct{}
+
+// Ping connects to SQL Server and issues a simple query to validate the connection.
+func (p *SQLServerPinger) Ping(ctx context.Context, params PingParams) error {
+	if err := params.CheckAndSetDefaults(defaults.ProtocolSQLServer); err != nil {
+		return trace.Wrap(err)
+	}
+	if params.Port < 1 || params.Port > 65535 {
+		return trace.BadParameter("invalid port %d", params.Port)
+	}
+	port := uint64(params.Port)
+	connector := mssql.NewConnectorConfig(msdsn.Config{
+		Host: params.Host, Port: port, User: params.Username,
+		Database: params.DatabaseName, Encryption: msdsn.EncryptionDisabled,
+		Protocols: []string{"tcp"},
+	}, nil)
+	conn, err := connector.Connect(ctx)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	defer func() {
+		if err := conn.Close(); err != nil {
+			logrus.WithError(err).Info("Failed to close connection in SQLServerPinger.Ping")
+		}
+	}()
+
+	sqlConn, ok := conn.(*mssql.Conn)
+	if !ok {
+		return trace.BadParameter("expected *mssql.Conn, got %T", conn)
+	}
+	return trace.Wrap(sqlConn.Ping(ctx))
+}
+
+func sqlServerErrorNumber(err error) int32 {
+	var numbered interface{ SQLErrorNumber() int32 }
+	if errors.As(err, &numbered) {
+		return numbered.SQLErrorNumber()
+	}
+	return 0
+}
+
+// IsConnectionRefusedError reports errors indicating SQL Server is unreachable.
+func (p *SQLServerPinger) IsConnectionRefusedError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var opErr *net.OpError
+	if errors.As(err, &opErr) && strings.Contains(strings.ToLower(opErr.Error()), "connection refused") {
+		return true
+	}
+	return strings.Contains(strings.ToLower(err.Error()), "connection refused")
+}
+
+// IsInvalidDatabaseUserError reports SQL Server login failures.
+func (p *SQLServerPinger) IsInvalidDatabaseUserError(err error) bool {
+	return err != nil && sqlServerErrorNumber(err) == 18456
+}
+
+// IsInvalidDatabaseNameError reports errors for missing or inaccessible databases.
+func (p *SQLServerPinger) IsInvalidDatabaseNameError(err error) bool {
+	if err == nil {
+		return false
+	}
+	switch sqlServerErrorNumber(err) {
+	case 4060:
+		return true
+	}
+	msg := strings.ToLower(err.Error())
+	return strings.Contains(msg, "cannot open database") && strings.Contains(msg, "requested by the login")
+}
