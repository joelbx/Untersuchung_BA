+// DiagResult contains the results of the individual Touch ID availability
+// checks and their aggregate result.
+type DiagResult struct {
+	HasCompileSupport       bool
+	HasSignature            bool
+	HasEntitlements         bool
+	PassedLAPolicyTest      bool
+	PassedSecureEnclaveTest bool
+	IsAvailable             bool
+}
+
+// Diag reports which Touch ID prerequisites are available. Detailed native
+// diagnostics are only supported by builds that include the Touch ID backend.
+func Diag() (*DiagResult, error) {
+	available := native.IsAvailable()
+	return &DiagResult{
+		HasCompileSupport: hasCompileSupport,
+		IsAvailable:       available,
+	}, nil
+}
+
 // nativeTID represents the native Touch ID interface.
 // Implementors must provide a global variable called `native`.
 type nativeTID interface {
