 // ReadPassword reads a password from the underlying reader, provided that the
 // reader is a terminal.
 // It follows the semantics of ReadContext.
@@ -277,14 +298,17 @@ func (cr *ContextReader) firePasswordRead() error {
 // doesn't guarantee a release of all resources.
 func (cr *ContextReader) Close() error {
 	cr.mu.Lock()
+	defer cr.mu.Unlock()
 	switch cr.state {
 	case readerStateClosed: // OK, already closed.
 	default:
+		if err := cr.maybeRestoreTerm(); err != nil {
+			return trace.Wrap(err)
+		}
 		cr.state = readerStateClosed
 		close(cr.closed) // interrupt blocked sends.
 		cr.cond.Broadcast()
 	}
-	cr.mu.Unlock()
 	return nil
 }
 
diff --git a/lib/utils/prompt/stdin.go b/lib/utils/prompt/stdin.go
index 39d9646..682684a 100644
--- a/lib/utils/prompt/stdin.go
+++ b/lib/utils/prompt/stdin.go
@@ -52,3 +52,17 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so it can restore the terminal
+// state if a password prompt is active.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if stdin == nil {
+		return
+	}
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		_ = closer.Close()
+	}
+	stdin = nil
+}
