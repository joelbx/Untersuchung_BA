+func (e *Engine) Namespaces(ctx context.Context, input map[string]any) ([]string, error) {
+	dec, err := e.opa.Decision(ctx, sdk.DecisionOptions{Path: "flipt/authz/v1/viewable_namespaces", Input: input})
+	if err != nil {
+		return nil, err
+	}
+	return formatNamespaces(dec.Result)
+}
+
+func formatNamespaces(result any) ([]string, error) {
+	values, ok := result.([]any)
+	if !ok {
+		return nil, fmt.Errorf("viewable namespaces result must be an array, got %T", result)
+	}
+	namespaces := make([]string, 0, len(values))
+	for _, value := range values {
+		namespace, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("viewable namespace must be a string, got %T", value)
+		}
+		namespaces = append(namespaces, namespace)
+	}
+	return namespaces, nil
+}
