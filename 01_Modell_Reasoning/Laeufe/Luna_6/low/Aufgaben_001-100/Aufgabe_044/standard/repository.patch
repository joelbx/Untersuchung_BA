+import rego.v1
+viewable_namespaces := namespaces if {
+	role := input.authentication.metadata["io.flipt.auth.role"]
+	role == "devs"
+	namespaces := ["local", "staging"]
+}
+viewable_namespaces := namespaces if {
+	role := input.authentication.metadata["io.flipt.auth.role"]
+	role == "ops"
+	namespaces := ["production"]
+}`
