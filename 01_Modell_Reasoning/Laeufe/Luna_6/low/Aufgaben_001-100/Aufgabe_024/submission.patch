+def remove_author_honorifics(name: str) -> str:
+    """Remove a supported leading honorific while preserving author names."""
+    normalized = re.sub(r'[^\w]+', ' ', name.casefold()).strip()
+    exception_names = {
+        re.sub(r'[^\w]+', ' ', value.casefold()).strip()
+        for value in HONORIFC_NAME_EXECPTIONS
+    }
+    if normalized in exception_names:
+        return name
+    for honorific in HONORIFICS:
+        pattern = re.compile(r'^' + re.escape(honorific) + r'(?=\s|$)', re.IGNORECASE)
+        match = pattern.match(name)
+        if match:
+            if not name[match.end() :].strip():
+                return name
+            remainder = name[match.end():].lstrip(' .\t')
+            return remainder if remainder else name
+    return name
 
 
