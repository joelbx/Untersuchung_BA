@@ -347,6 +349,33 @@ type ProxyConfig struct {
 	Kube KubeProxyConfig
 }
 
+// KubeAddr returns the public Kubernetes proxy address using the default
+// Kubernetes proxy port.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("kubernetes proxy is not enabled")
+	}
+	if len(c.Kube.PublicAddrs) > 0 {
+		addr := c.Kube.PublicAddrs[0].Addr
+		host, _, err := net.SplitHostPort(addr)
+		if err != nil {
+			host = addr
+		}
+		if host == "" {
+			return "", trace.BadParameter("invalid kubernetes public address %q", addr)
+		}
+		return (&url.URL{Scheme: "https", Host: net.JoinHostPort(host, fmt.Sprint(defaults.KubeProxyListenPort))}).String(), nil
+	}
+	if len(c.PublicAddrs) > 0 {
+		host := c.PublicAddrs[0].Host()
+		if host == "" {
+			return "", trace.BadParameter("invalid proxy public address %q", c.PublicAddrs[0].Addr)
+		}
+		return (&url.URL{Scheme: "https", Host: net.JoinHostPort(host, fmt.Sprint(defaults.KubeProxyListenPort))}).String(), nil
+	}
+	return "", trace.BadParameter("no public proxy address configured")
+}
