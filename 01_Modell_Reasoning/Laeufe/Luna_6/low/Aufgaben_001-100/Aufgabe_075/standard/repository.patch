diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..8b79e1d
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,48 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+// NewUserPropsRepository creates a repository scoped to the user in ctx.
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	r := &userPropsRepository{}
+	r.ctx = ctx
+	r.ormer = o
+	r.tableName = "user_props"
+	return r
+}
+
+func (r userPropsRepository) Put(key, value string) error {
+	where := Eq{"user_id": userId(r.ctx), "key": key}
+	count, err := r.executeSQL(Update(r.tableName).Set("value", value).Where(where))
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	_, err = r.executeSQL(Insert(r.tableName).Columns("user_id", "key", "value").Values(userId(r.ctx), key, value))
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	var response struct{ Value string }
+	err := r.queryOne(Select("value").From(r.tableName).Where(Eq{"user_id": userId(r.ctx), "key": key}), &response)
+	if err != nil {
+		return "", err
+	}
+	return response.Value, nil
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	return r.delete(Eq{"user_id": userId(r.ctx), "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..21337aa
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,31 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	It("scopes properties to the user in context", func() {
+		ctx1 := request.WithUser(log.NewContext(context.TODO()), model.User{ID: "user-props-1"})
+		ctx2 := request.WithUser(log.NewContext(context.TODO()), model.User{ID: "user-props-2"})
+		repo1 := NewUserPropsRepository(ctx1, orm.NewOrm())
+		repo2 := NewUserPropsRepository(ctx2, orm.NewOrm())
+
+		Expect(repo1.Put("test-key", "one")).To(Succeed())
+		Expect(repo2.Put("test-key", "two")).To(Succeed())
+		Expect(repo1.Get("test-key")).To(Equal("one"))
+		Expect(repo2.Get("test-key")).To(Equal("two"))
+		Expect(repo1.Delete("test-key")).To(Succeed())
+		value, err := repo1.Get("test-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(value).To(BeEmpty())
+		Expect(repo2.Get("test-key")).To(Equal("two"))
+	})
+})
