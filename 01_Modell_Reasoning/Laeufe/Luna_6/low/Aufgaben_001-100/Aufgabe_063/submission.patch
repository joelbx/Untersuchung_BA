+func (s *ConfigTestSuite) TestKubeListenAddrShorthand(c *check.C) {
+	tests := []struct {
+		name string
+		yaml string
+		want bool
+		addr string
+		bad  bool
+	}{
+		{name: "shorthand enables proxy", yaml: "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", want: true, addr: "0.0.0.0:8080"},
+		{name: "default port", yaml: "proxy_service:\n  kube_listen_addr: 0.0.0.0\n", want: true, addr: "0.0.0.0:3026"},
+		{name: "disabled nested overridden", yaml: "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n", want: true, addr: "0.0.0.0:8080"},
+		{name: "enabled nested conflicts", yaml: "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n", bad: true},
+	}
+	for _, tt := range tests {
+		c.Log(tt.name)
+		fc, err := ReadConfig(bytes.NewBufferString(tt.yaml))
+		if tt.bad {
+			c.Assert(err, check.ErrorMatches, ".*kube_listen_addr conflicts.*")
+			continue
+		}
+		c.Assert(err, check.IsNil)
+		cfg := service.MakeDefaultConfig()
+		c.Assert(ApplyFileConfig(fc, cfg), check.IsNil)
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, tt.want)
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, tt.addr)
+	}
+}
