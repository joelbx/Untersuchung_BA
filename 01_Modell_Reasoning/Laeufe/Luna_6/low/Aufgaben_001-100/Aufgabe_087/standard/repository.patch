diff --git a/internal/info/flipt.go b/internal/info/flipt.go
new file mode 100644
index 0000000..0e3ea04
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,29 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt contains build and update information exposed by the metadata API.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes Flipt metadata as JSON.
+func (f Flipt) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	out, err := json.Marshal(f)
+	if err != nil {
+		http.Error(w, "failed to serialize metadata", http.StatusInternalServerError)
+		return
+	}
+	if _, err := w.Write(out); err != nil {
+		return
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..c7a8cf7
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,181 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	SchemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	endpoint      = "https://telemetry.flipt.io/v1/track"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type event struct {
+	AnonymousID string                 `json:"AnonymousId"`
+	Event       string                 `json:"event"`
+	Properties  map[string]interface{} `json:"Properties"`
+}
+
+// Reporter periodically sends anonymous Flipt usage events.
+type Reporter struct {
+	statePath    string
+	fliptVersion string
+	logger       logrus.FieldLogger
+	client       *http.Client
+	state        state
+}
+
+// NewReporter returns nil when telemetry is disabled.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	envEnabled := os.Getenv("FLIPT_META_TELEMETRY_ENABLED")
+	if cfg == nil || !cfg.Meta.TelemetryEnabled || (envEnabled != "" && strings.EqualFold(envEnabled, "false")) || envEnabled == "0" {
+		return nil, nil
+	}
+	newReporter := func(err error) (*Reporter, error) {
+		if logger != nil {
+			logger.WithError(err).Warn("initializing telemetry")
+		}
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if envDir := os.Getenv("FLIPT_META_STATE_DIRECTORY"); envDir != "" {
+		dir = envDir
+	}
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return newReporter(fmt.Errorf("resolving telemetry state directory: %w", err))
+		}
+		dir = filepath.Join(dir, "flipt")
+	}
+	info, err := os.Stat(dir)
+	if os.IsNotExist(err) {
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			return newReporter(fmt.Errorf("creating telemetry state directory: %w", err))
+		}
+		info, err = os.Stat(dir)
+	}
+	if err != nil {
+		return newReporter(fmt.Errorf("checking telemetry state directory: %w", err))
+	}
+	if !info.IsDir() {
+		return nil, nil
+	}
+	r := &Reporter{statePath: filepath.Join(dir, "telemetry.json"), fliptVersion: buildVersion, logger: logger, client: http.DefaultClient}
+	if err := r.loadState(); err != nil {
+		return newReporter(err)
+	}
+	return r, nil
+}
+
+// buildVersion is set by the application at startup.
+var buildVersion = "dev"
+
+// SetVersion sets the current Flipt version included in telemetry events.
+func SetVersion(version string) { buildVersion = version }
+
+func (r *Reporter) loadState() error {
+	data, err := os.ReadFile(r.statePath)
+	if err == nil {
+		_ = json.Unmarshal(data, &r.state)
+	}
+	if r.state.Version != SchemaVersion {
+		r.state.Version = SchemaVersion
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, genErr := uuid.NewV4()
+		if genErr != nil {
+			return fmt.Errorf("generating telemetry UUID: %w", genErr)
+		}
+		r.state.UUID = id.String()
+	}
+	if err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("reading telemetry state: %w", err)
+	}
+	return r.saveState()
+}
+
+func (r *Reporter) saveState() error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(r.statePath, data, 0600)
+}
+
+// Start sends an event immediately and then every four hours until ctx ends.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		if err := r.Report(ctx); err != nil {
+			r.logger.WithError(err).Warn("reporting telemetry")
+		}
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				if err := r.Report(ctx); err != nil {
+					r.logger.WithError(err).Warn("reporting telemetry")
+				}
+			}
+		}
+	}()
+}
+
+// Report sends one anonymous usage event and persists the successful report time.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	payload := event{AnonymousID: r.state.UUID, Event: "flipt.ping", Properties: map[string]interface{}{
+		"uuid":    r.state.UUID,
+		"version": SchemaVersion,
+		"flipt":   map[string]string{"version": r.fliptVersion},
+	}}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry: unexpected status %s", resp.Status)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.saveState(); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	return nil
+}
