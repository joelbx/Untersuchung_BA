+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        cls.db = get_db()
+        cls.db.query("""
+        CREATE TABLE booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL,
+            notes text,
+            primary key (username, work_id, edition_id)
+        );
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.query("DELETE FROM booknotes")
+        self.db.insert("booknotes", username="reader", work_id=1, edition_id=10, notes="source")
+        self.db.insert("booknotes", username="reader", work_id=2, edition_id=10, notes="target")
+
+    def test_conflict_preserves_all_records_and_reports_failure(self):
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 0,
+            "rows_deleted": 0,
+            "failed_deletes": 1,
+        }
+        rows = list(self.db.select("booknotes", order="work_id"))
+        assert [(row.work_id, row.notes) for row in rows] == [(1, "source"), (2, "target")]
