+def test_serialize_extracts_unique_non_original_languages() -> None:
+    content_info = ContentInfo(
+        languages=Languages(
+            [
+                Language('Published Language', 'Français'),
+                Language('Original Language', 'English'),
+                Language('Published Language', 'Français'),
+                Language('Published Language', '日本語'),
+            ]
+        )
+    )
+    product = AmazonAPIReply(ItemInfo(None, content_info, None, ''), '', '', 'B012345678')
+
+    assert AmazonAPI.serialize(product)['languages'] == ['Français', '日本語']
+
+
+def test_serialize_omits_languages_when_none_are_eligible() -> None:
+    content_info = ContentInfo(
+        languages=Languages([Language('Original Language', 'English')])
+    )
+    product = AmazonAPIReply(ItemInfo(None, content_info, None, ''), '', '', 'B012345678')
+
+    assert 'languages' not in AmazonAPI.serialize(product)
