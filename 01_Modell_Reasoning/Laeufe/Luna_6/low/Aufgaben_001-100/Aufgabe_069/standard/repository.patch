+// Matcher evaluates whether a string satisfies a parsed pattern.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct{ re *regexp.Regexp }
+
+func (m regexpMatcher) Match(in string) bool { return m.re.MatchString(in) }
+
+type notMatcher struct{ matcher Matcher }
+
+func (m notMatcher) Match(in string) bool { return !m.matcher.Match(in) }
+
+type prefixSuffixMatcher struct {
+	prefix, suffix string
+	matcher        Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+// Match parses a literal, glob, regexp, or matcher function expression.
+func Match(value string) (Matcher, error) {
+	match := reVariable.FindStringSubmatch(value)
+	if len(match) == 0 {
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+		}
+		return compileGlob(value)
+	}
+	prefix, expression, suffix := match[1], match[2], match[3]
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	root, ok := expr.(*ast.CallExpr)
+	if !ok {
+		if _, variable := expr.(*ast.Ident); variable {
+			return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+		}
+		return compileGlob(strings.TrimSpace(prefix) + strings.TrimSpace(expression) + strings.TrimSpace(suffix))
+	}
+	call, ok := root.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, trace.BadParameter("unsupported matcher function %v", root.Fun)
+	}
+	ns, ok := call.X.(*ast.Ident)
+	if !ok {
+		return nil, trace.BadParameter("unsupported matcher function namespace")
+	}
+	if ns.Name != "regexp" && ns.Name != EmailNamespace {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", ns.Name)
+	}
+	if ns.Name == EmailNamespace && call.Sel.Name != EmailLocalFnName {
+		return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", call.Sel.Name)
+	}
+	if ns.Name == "regexp" && call.Sel.Name != "match" && call.Sel.Name != "not_match" {
+		return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match", call.Sel.Name)
+	}
+	if len(root.Args) != 1 {
+		return nil, trace.BadParameter("expected 1 argument for %s.%s got %v", ns.Name, call.Sel.Name, len(root.Args))
+	}
+	lit, ok := root.Args[0].(*ast.BasicLit)
+	if !ok || lit.Kind != token.STRING {
+		return nil, trace.BadParameter("argument for %s.%s must be a string literal", ns.Name, call.Sel.Name)
+	}
+	pattern, err := strconv.Unquote(lit.Value)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var inner Matcher
+	if ns.Name == EmailNamespace {
+		inner = emailLocalMatcher{}
+	} else {
+		inner, err = compileRawRegexp(pattern)
+		if err != nil {
+			return nil, err
+		}
+		if call.Sel.Name == "not_match" {
+			inner = notMatcher{matcher: inner}
+		}
+	}
+	if prefix != "" || suffix != "" {
+		inner = prefixSuffixMatcher{prefix: strings.TrimLeftFunc(prefix, unicode.IsSpace), suffix: strings.TrimRightFunc(suffix, unicode.IsSpace), matcher: inner}
+	}
+	return inner, nil
+}
+
+func compileGlob(pattern string) (Matcher, error) {
+	return compileRawRegexp("^" + utils.GlobToRegexp(pattern) + "$")
+}
+
+func compileRawRegexp(pattern string) (Matcher, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return regexpMatcher{re: re}, nil
+}
+
+type emailLocalMatcher struct{}
+
+func (emailLocalMatcher) Match(in string) bool {
+	local, err := (emailLocalTransformer{}).transform(in)
+	return err == nil && local != ""
+}
