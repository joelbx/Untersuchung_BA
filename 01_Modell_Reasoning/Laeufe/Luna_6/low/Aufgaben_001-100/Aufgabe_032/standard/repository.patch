+def jwrite(info, path=None):
+    """Atomically replace the current job status file."""
+    path = path or job_path
+    tmp_job_path = path + ".tmp"
+    try:
+        with open(tmp_job_path, "w") as jobfile:
+            jobfile.write(json.dumps(info))
+            jobfile.flush()
+            os.fsync(jobfile.fileno())
+        os.rename(tmp_job_path, path)
+    except (IOError, OSError) as e:
+        notice("Failed to write async job file %s: %s" % (path, to_text(e)))
+        raise
+
