+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Split ISBN values into ISBN-10 and ISBN-13 lists by normalized length."""
+    if isinstance(isbns, str):
+        isbns = [isbns]
+    isbn_10 = []
+    isbn_13 = []
+    for value in isbns or []:
+        if not isinstance(value, str):
+            continue
+        normalized = re.sub(r"[-\s]", "", value).strip()
+        if len(normalized) == 10 and re.fullmatch(r"[0-9]{9}[0-9Xx]", normalized):
+            isbn_10.append(normalized.upper())
+        elif len(normalized) == 13 and normalized.isdigit():
+            isbn_13.append(normalized)
+    return isbn_10, isbn_13
+
+
+def get_publisher_and_place(
+    publishers: str | list[str],
+) -> tuple[list[str], list[str]]:
+    """Split IA publisher strings into publisher names and publication places."""
+    if isinstance(publishers, str):
+        publishers = [publishers]
+    publisher_names = []
+    publish_places = []
+    for value in publishers or []:
+        if not isinstance(value, str):
+            continue
+        value = value.strip()
+        if not value:
+            continue
+        if ":" in value:
+            place, publisher = value.split(":", 1)
+            place, publisher = place.strip(), publisher.strip()
+            if place and publisher:
+                publish_places.append(place)
+                publisher_names.append(publisher)
+            elif publisher:
+                publisher_names.append(publisher)
+            elif place:
+                publisher_names.append(place)
+        else:
+            publisher_names.append(value)
+    return publisher_names, publish_places
+
+
 class LanguageMultipleMatchError(Exception):
     """Exception raised when more than one possible language match is found."""
 
