+class ModuleUtilLocatorBase:
+    """Resolve one discovered module_utils import to source and payload path."""
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False):
+        self.fq_name_parts = tuple(fq_name_parts)
+        self.is_ambiguous = is_ambiguous
+        self.child_is_redirected = child_is_redirected
+        self.module_info = None
+        self.found = False
+        self.redirected = False
+        self.is_package = False
+        self.output_path = None
+        self.source = None
+
+    def candidate_names_joined(self):
+        names = [self.fq_name_parts]
+        if self.is_ambiguous and len(self.fq_name_parts) > 1:
+            names.append(self.fq_name_parts[:-1])
+        return ['.'.join(name) for name in names]
+
+    def _record(self, parts, info, redirected=False):
+        self.fq_name_parts = tuple(parts)
+        self.module_info = info
+        self.found = True
+        self.redirected = redirected
+        self.is_package = bool(info.pkg_dir)
+        self.output_path = os.path.join(*self.fq_name_parts)
+        self.source = info.get_source()
+        return self
+
+
+class LegacyModuleUtilLocator(ModuleUtilLocatorBase):
+    def __init__(self, fq_name_parts, is_ambiguous=False, mu_paths=None, child_is_redirected=False):
+        super(LegacyModuleUtilLocator, self).__init__(fq_name_parts, is_ambiguous, child_is_redirected)
+        self.mu_paths = mu_paths or []
+
+    def locate(self, redirect_first=False):
+        relative = self.fq_name_parts[2:]
+        attempts = [relative]
+        if self.is_ambiguous and len(relative) > 1:
+            attempts.append(relative[:-1])
+        for candidate in attempts:
+            name = candidate[-1]
+            paths = [os.path.join(path, *candidate[:-1]) for path in self.mu_paths]
+            resolvers = ('redirect', 'local') if redirect_first else ('local', 'redirect')
+            for resolver in resolvers:
+                try:
+                    if resolver == 'local':
+                        info = ModuleInfo(name, paths)
+                    else:
+                        info = InternalRedirectModuleInfo(name, '.'.join(('ansible', 'module_utils') + candidate))
+                    return self._record(('ansible', 'module_utils') + candidate, info, redirected=resolver == 'redirect')
+                except (ImportError, AnsibleError, OSError, ValueError):
+                    pass
+        return self
+
+
+class CollectionModuleUtilLocator(ModuleUtilLocatorBase):
+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False):
+        super(CollectionModuleUtilLocator, self).__init__(fq_name_parts, is_ambiguous, child_is_redirected)
+
+    def locate(self, redirect_first=True):
+        original = self.fq_name_parts
+        # The resource name is the final component; each shorter candidate
+        # handles `from package import member` ambiguity.
+        candidates = [original]
+        if self.is_ambiguous and len(original) > 7:
+            candidates.append(original[:-1])
+        for candidate in candidates:
+            collection = '.'.join(candidate[1:3])
+            subname = candidate[5:]
+            if not subname:
+                continue
+            leaf = subname[-1]
+            try:
+                meta = _get_collection_metadata(collection)
+            except ValueError as e:
+                if 'unable to locate collection' in to_native(e):
+                    raise AnsibleError('unable to locate collection {0}'.format(collection))
+                raise AnsibleError(to_native(e))
+            routing = meta.get('plugin_routing', {}).get('module_utils', {})
+            entry = routing.get('.'.join(subname), routing.get(leaf, {}))
+            if entry.get('tombstone'):
+                tombstone = entry['tombstone']
+                msg = tombstone.get('warning_text') or 'module_utils {0} has been removed'.format('.'.join(candidate))
+                detail = display.get_deprecation_message(msg, version=tombstone.get('removal_version'),
+                                                         date=tombstone.get('removal_date'),
+                                                         collection_name=collection, removed=True)
+                raise AnsibleError(detail)
+            deprecation = entry.get('deprecation')
+            if deprecation:
+                display.deprecated(deprecation.get('warning_text') or 'module_utils {0} is deprecated'.format('.'.join(candidate)),
+                                   version=deprecation.get('removal_version'), date=deprecation.get('removal_date'),
+                                   collection_name=collection)
+            redirect = entry.get('redirect')
+            if redirect and redirect_first:
+                redirect_parts = tuple(redirect.split('.'))
+                if len(redirect_parts) >= 3 and redirect_parts[0] != 'ansible_collections':
+                    redirect_parts = ('ansible_collections',) + redirect_parts[:2] + ('plugins', 'module_utils') + redirect_parts[2:]
+                try:
+                    redirected = CollectionModuleUtilLocator(redirect_parts, self.is_ambiguous).locate(redirect_first=True)
+                except AnsibleError:
+                    raise
+                if not redirected.found:
+                    raise AnsibleError('unable to locate collection {0}'.format('.'.join(redirect.split('.')[:2])))
+                shim = type('RedirectInfo', (), {'pkg_dir': False, 'py_src': True,
+                        'get_source': lambda s: ("import sys\nimport {0} as mod\nsys.modules[{1!r}] = mod\n".format(
+                            '.'.join(redirected.fq_name_parts), '.'.join(original))).encode('utf-8')})()
+                self._record(original, shim, redirected=True)
+                return self
+            try:
+                info = CollectionModuleInfo(leaf, '.'.join(candidate[:-1]))
+                return self._record(candidate, info)
+            except (ImportError, ValueError):
+                if redirect:
+                    # Local resolution is the fallback when explicitly asked
+                    # to use local-first semantics.
+                    continue
+                continue
+        return self
+
