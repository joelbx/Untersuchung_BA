+import React, { ComponentProps } from "react";
+
+import AccessibleButton from "../elements/AccessibleButton";
+
+type Props = ComponentProps<typeof AccessibleButton> & { size?: string };
+
+export default function CancelButton({ size = "16", className, ...props }: Props): JSX.Element {
+    return <AccessibleButton
+        {...props}
+        className={["mx_CancelButton", className].filter(Boolean).join(" ")}
+        style={{
+            "--cancel-button-size": `${size}px`,
+            ...props.style,
+        } as React.CSSProperties}
+        aria-label={props["aria-label"] ?? "Cancel"}
+    />;
+}
