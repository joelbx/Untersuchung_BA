+// U2FAuthenticateChallenge carries authentication challenges for every
+// registered U2F device. AuthenticateChallenge preserves the legacy single
+// challenge JSON representation for older clients.
+type U2FAuthenticateChallenge struct {
+	u2f.AuthenticateChallenge
+	Challenges []u2f.AuthenticateChallenge `json:"challenges,omitempty"`
+}
+
+// UnmarshalJSON accepts both legacy flat challenges and the multi-device
+// challenge list.
+func (c *U2FAuthenticateChallenge) UnmarshalJSON(data []byte) error {
+	type challengeAlias u2f.AuthenticateChallenge
+	var wrapper struct {
+		AuthenticateChallenge *u2f.AuthenticateChallenge  `json:"authenticate_challenge"`
+		Challenges            []u2f.AuthenticateChallenge `json:"challenges"`
+	}
+	if err := json.Unmarshal(data, &wrapper); err != nil {
+		return err
+	}
+	if wrapper.AuthenticateChallenge != nil {
+		c.AuthenticateChallenge = *wrapper.AuthenticateChallenge
+	} else {
+		var legacy challengeAlias
+		if err := json.Unmarshal(data, &legacy); err != nil {
+			return err
+		}
+		c.AuthenticateChallenge = u2f.AuthenticateChallenge(legacy)
+	}
+	c.Challenges = wrapper.Challenges
+	if len(c.Challenges) == 0 && c.KeyHandle != "" {
+		c.Challenges = []u2f.AuthenticateChallenge{c.AuthenticateChallenge}
+	} else if c.KeyHandle == "" && len(c.Challenges) > 0 {
+		c.AuthenticateChallenge = c.Challenges[0]
+	}
+	return nil
+}
+
+// MarshalJSON encodes all challenges and keeps the legacy challenge fields at
+// the top level for existing clients.
+func (c U2FAuthenticateChallenge) MarshalJSON() ([]byte, error) {
+	type challengeAlias u2f.AuthenticateChallenge
+	var legacy map[string]json.RawMessage
+	base, err := json.Marshal(challengeAlias(c.AuthenticateChallenge))
+	if err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(base, &legacy); err != nil {
+		return nil, err
+	}
+	if len(c.Challenges) > 0 {
+		challenges, err := json.Marshal(c.Challenges)
+		if err != nil {
+			return nil, err
+		}
+		legacy["challenges"] = challenges
+	}
+	return json.Marshal(legacy)
+}
+
