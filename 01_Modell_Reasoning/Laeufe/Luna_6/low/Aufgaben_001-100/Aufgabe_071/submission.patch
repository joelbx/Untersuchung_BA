+_CLIXML_ESCAPE = re.compile(r'_x([0-9a-fA-F]{4})_')
+
+
+def _decode_clixml_escapes(text: str) -> str:
+    """Decode CLIXML UTF-16 code-unit escapes, including surrogate pairs."""
+    matches = list(_CLIXML_ESCAPE.finditer(text))
+    if not matches:
+        return text
+
+    result = []
+    position = 0
+    index = 0
+    while index < len(matches):
+        match = matches[index]
+        result.append(text[position:match.start()])
+        code_unit = int(match.group(1), 16)
+
+        # PowerShell uses an escaped underscore to protect text that resembles
+        # another escape. It only decodes when followed by an escape token.
+        if code_unit == 0x005F:
+            if index + 1 < len(matches) and matches[index + 1].start() == match.end():
+                result.append('_')
+                position = match.end()
+                index += 1
+                continue
+            result.append(match.group(0))
+            position = match.end()
+            index += 1
+            continue
+
+        if 0xD800 <= code_unit <= 0xDBFF and index + 1 < len(matches):
+            next_match = matches[index + 1]
+            if next_match.start() == match.end():
+                low = int(next_match.group(1), 16)
+                if 0xDC00 <= low <= 0xDFFF:
+                    scalar = 0x10000 + ((code_unit - 0xD800) << 10) + (low - 0xDC00)
+                    result.append(chr(scalar))
+                    position = next_match.end()
+                    index += 2
+                    continue
+
+        result.append(chr(code_unit))
+        position = match.end()
+        index += 1
+
+    result.append(text[position:])
+    return ''.join(result)
 
 
