+// pkgPs gathers executable and mapped file paths for each process, then
+// resolves those paths to package names using the caller's ownership lookup.
+func (l *base) pkgPs(getOwnerPkgs func([]string) ([]string, error)) (map[string]string, map[string][]string, error) {
+	stdout, err := l.ps()
+	if err != nil {
+		return nil, nil, xerrors.Errorf("Failed to ps: %w", err)
+	}
+	pidNames := l.parsePs(stdout)
+	pidPkgs := make(map[string][]string, len(pidNames))
+	for pid := range pidNames {
+		stdout, err = l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		exe, err := l.parseLsProcExe(stdout)
+		if err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		files := []string{exe}
+		if stdout, err = l.grepProcMap(pid); err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/maps: %s", pid, err)
+		} else {
+			files = append(files, l.parseGrepProcMap(stdout)...)
+		}
+		pkgs, err := getOwnerPkgs(files)
+		if err != nil {
+			l.log.Debugf("Failed to find owning packages for pid %s: %s", pid, err)
+			continue
+		}
+		pidPkgs[pid] = pkgs
+	}
+	return pidNames, pidPkgs, nil
+}
+
 func (l *base) lsProcExe(pid string) (string, error) {
 	cmd := fmt.Sprintf("ls -l /proc/%s/exe", pid)
 	r := l.exec(util.PrependProxyEnv(cmd), sudo)
