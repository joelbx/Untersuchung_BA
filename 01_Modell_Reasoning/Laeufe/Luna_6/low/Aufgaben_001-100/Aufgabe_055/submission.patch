+func TestSetScanResultMetaArtifactMetadata(t *testing.T) {
+	tests := []struct {
+		name         string
+		artifactName string
+		artifactType string
+		osName       string
+		wantName     string
+		wantRelease  string
+	}{
+		{name: "untagged image", artifactName: "example/image", artifactType: "container_image", osName: "22.04", wantName: "example/image:latest", wantRelease: "22.04"},
+		{name: "library scan without OS metadata", artifactName: "./app", artifactType: "filesystem", wantName: "./app", wantRelease: ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			input := `{"ArtifactName":"` + tt.artifactName + `","ArtifactType":"` + tt.artifactType + `","Results":[{"Type":"` + os.Ubuntu + `"}]}`
+			if tt.osName != "" {
+				input = `{"ArtifactName":"` + tt.artifactName + `","ArtifactType":"` + tt.artifactType + `","Metadata":{"OS":{"Family":"ubuntu","Name":"` + tt.osName + `"}},"Results":[{"Type":"ubuntu"}]}`
+			}
+			var report types.Report
+			if err := json.Unmarshal([]byte(input), &report); err != nil {
+				t.Fatal(err)
+			}
+			result := &models.ScanResult{}
+			if err := setScanResultMeta(result, &report); err != nil {
+				t.Fatal(err)
+			}
+			if result.ServerName != tt.wantName || result.Release != tt.wantRelease {
+				t.Errorf("got ServerName=%q Release=%q, want %q %q", result.ServerName, result.Release, tt.wantName, tt.wantRelease)
+			}
+			if result.Optional != nil {
+				t.Errorf("Optional should be nil, got %#v", result.Optional)
+			}
+		})
+	}
+}
