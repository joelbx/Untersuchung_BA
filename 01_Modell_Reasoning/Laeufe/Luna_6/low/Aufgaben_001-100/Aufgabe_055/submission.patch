+		logging.Log.Infof("FreeBSD is not supported. Skip OVAL and gost detection")
+	case r.Family == constant.Raspbian:
+		logging.Log.Infof("Raspbian is not supported. Skip OVAL and gost detection")
+	case r.Family == constant.ServerTypePseudo:
+		logging.Log.Infof("Pseudo type. Skip OVAL and gost detection")
+	case r.Release == "":
+		if reuseScannedCves(r) {
+			logging.Log.Infof("OS version is empty; reusing CVEs scanned by %s", r.ScannedBy)
