 class LookupModule(LookupBase):
+    def _parse_parameters(self, term):
+        """Parse the path and supported key=value parameters from a term."""
+        first_split = term.split(' ', 1)
+        if len(first_split) <= 1:
+            relpath = term
+            params = {}
+        else:
+            relpath = first_split[0]
+            params = parse_kv(first_split[1])
+            if '_raw_params' in params:
+                relpath = u' '.join((relpath, params.pop('_raw_params')))
+                if not term.startswith(relpath):
+                    raise AnsibleError('Unrecognized value after key=value parameters given to password lookup')
+
+        invalid_params = frozenset(params).difference(VALID_PARAMS)
+        if invalid_params:
+            raise AnsibleError('Unrecognized parameter(s) given to password lookup: %s' % ', '.join(invalid_params))
+
+        defaults = {}
+        for name in VALID_PARAMS:
+            try:
+                defaults[name] = self.get_option(name)
+            except KeyError:
+                defaults[name] = None
+        params['length'] = int(params.get('length', defaults.get('length') or DEFAULT_LENGTH))
+        for name in ('encrypt', 'ident', 'seed'):
+            params[name] = params.get(name, defaults.get(name))
+
+        chars = params.get('chars', defaults.get('chars'))
+        if isinstance(chars, str):
+            tmp_chars = [u','] if u',,' in chars else []
+            tmp_chars.extend(c for c in chars.replace(u',,', u',').split(u',') if c)
+            chars = tmp_chars
+        params['chars'] = chars or [u'ascii_letters', u'digits', u".,:-_"]
+        return relpath, params
+
