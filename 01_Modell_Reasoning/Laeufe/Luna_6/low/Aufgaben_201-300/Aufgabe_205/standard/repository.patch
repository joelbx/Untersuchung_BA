-utils.log = async (token) => {
-	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
+utils.get = async (tokens) => {
+	if (tokens === null || tokens === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const singular = !Array.isArray(tokens);
+	const tokenList = singular ? [tokens] : tokens;
+	if (!tokenList.length) {
+		return [];
+	}
+	const [records, lastSeen] = await Promise.all([
+		db.getObjects(tokenList.map(token => `${tokenPrefix}${token}`)),
+		utils.getLastSeen(tokenList),
+	]);
+	const hydrated = records.map((record, i) => {
+		if (!record || !Object.keys(record).length) {
+			return null;
+		}
+		const timestamp = Number(record.timestamp);
+		return {
+			...record,
+			uid: Number(record.uid),
+			timestamp: Number.isFinite(timestamp) ? timestamp : null,
+			lastSeen: lastSeen[i],
+		};
+	});
+	return singular ? hydrated[0] : hydrated;
+};
+
+utils.list = async () => {
+	const tokens = await db.getSortedSetRange(creationIndex, 0, -1);
+	return tokens.length ? utils.get(tokens) : [];
+};
+
+utils.generate = async ({ uid, description } = {}) => {
+	const numericUid = Number(uid);
+	if (uid === undefined || !Number.isFinite(numericUid)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !(await user.exists(numericUid))) {
+		throw new Error('[[error:no-user]]');
+	}
+	const token = require('crypto').randomBytes(32).toString('hex');
+	const timestamp = Date.now();
+	const record = { uid: numericUid, timestamp };
+	if (description !== undefined) {
+		record.description = description;
+	}
+	await Promise.all([
+		db.setObject(`${tokenPrefix}${token}`, record),
+		db.sortedSetAdd(creationIndex, timestamp, token),
+		db.sortedSetAdd(userIndex, numericUid, token),
+	]);
+	return token;
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.update = async (token, data = {}) => {
+	await db.setObjectField(`${tokenPrefix}${token}`, 'description', data.description);
+	return utils.get(token);
+};
+
+utils.delete = async (token) => {
+	await Promise.all([
+		db.delete(`${tokenPrefix}${token}`),
+		db.sortedSetRemove(creationIndex, token),
+		db.sortedSetRemove(userIndex, token),
+		db.sortedSetRemove(lastSeenIndex, token),
+	]);
+};
+
+utils.log = async (token) => {
+	await db.sortedSetAdd(lastSeenIndex, Date.now(), token);
+};
