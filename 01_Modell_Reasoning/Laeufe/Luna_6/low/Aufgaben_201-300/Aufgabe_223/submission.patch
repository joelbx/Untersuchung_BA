+
+
+def test_module_shebang_is_preserved(mocker, templar):
+    module = b'#!/opt/venv/bin/python -O\nprint("ok")\n'
+    m = mocker.mock_open(read_data=module)
+    mocker.patch('builtins.open', m)
+    data, style, shebang = modify_module('fake_module', 'fake_path', {}, templar,
+                                         task_vars={'ansible_python_interpreter': '/opt/venv/bin/python'})
+    assert shebang == '#!/opt/venv/bin/python -O'
+    assert data.startswith(b'#!/opt/venv/bin/python -O\n# -*- coding: utf-8 -*-\n')
