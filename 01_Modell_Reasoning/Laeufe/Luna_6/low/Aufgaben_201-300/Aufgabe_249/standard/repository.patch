--- a/openlibrary/core/wikidata.py
+++ b/openlibrary/core/wikidata.py
@@ -40,6 +40,57 @@ class WikidataEntity:
         """If a description isn't available in the requested language default to English"""
         return self.descriptions.get(language) or self.descriptions.get('en')
 
+    def _get_wikipedia_link(self, language: str) -> tuple[str, str] | None:
+        """Return a Wikipedia URL and the language used, preferring the requested language."""
+        for lang in (language, 'en'):
+            sitelink = self.sitelinks.get(f'{lang}wiki')
+            if isinstance(sitelink, dict):
+                title = sitelink.get('title')
+                if title:
+                    return f'https://{lang}.wikipedia.org/wiki/{title.replace(" ", "_")}', lang
+        return None
+
+    def _get_statement_values(self, property_id: str) -> list:
+        """Extract valid statement value contents for a Wikidata property."""
+        statements = self.statements.get(property_id, [])
+        if isinstance(statements, dict):
+            statements = [statements]
+        if not isinstance(statements, list):
+            return []
+        values = []
+        for statement in statements:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if isinstance(value, dict) and 'content' in value:
+                content = value['content']
+                if content is not None:
+                    values.append(content)
+        return values
+
+    def get_external_profiles(self, language: str = 'en') -> list[dict]:
+        """Return structured links to this entity's Wikipedia and external profiles."""
+        profiles = []
+        if wikipedia := self._get_wikipedia_link(language):
+            profiles.append({
+                'url': wikipedia[0],
+                'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+                'label': 'Wikipedia',
+            })
+        profiles.append({
+            'url': f'https://www.wikidata.org/wiki/{self.id}',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        })
+        for identifier in self._get_statement_values('P1960'):
+            if isinstance(identifier, (str, int)) and str(identifier):
+                profiles.append({
+                    'url': f'https://scholar.google.com/citations?user={identifier}',
+                    'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+                    'label': 'Google Scholar',
+                })
+        return profiles
+
