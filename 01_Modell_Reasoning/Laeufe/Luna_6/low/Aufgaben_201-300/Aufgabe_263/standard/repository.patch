+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for {
+		if err := l.migrateFieldsMap(ctx); err == nil {
+			return
+		} else {
+			log.WithError(err).Error("DynamoDB FieldsMap migration failed; retrying")
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		}
+	}
+}
+
+// migrateFieldsMap converts legacy JSON event fields in bounded batches. Re-scanning
+// from the beginning after interruption is safe because converted items are skipped.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		var startKey map[string]*dynamodb.AttributeValue
+		var migrated int
+		for {
+			select {
+			case <-ctx.Done():
+				return trace.Wrap(ctx.Err())
+			default:
+			}
+			scan, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName: aws.String(l.Tablename), ConsistentRead: aws.Bool(true),
+				ExclusiveStartKey: startKey,
+				FilterExpression:  aws.String("attribute_exists(Fields) AND attribute_not_exists(FieldsMap)"),
+				Limit:             aws.Int64(DynamoBatchSize),
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			for _, item := range scan.Items {
+				legacy := item["Fields"]
+				if legacy == nil || legacy.S == nil {
+					return trace.BadParameter("legacy Fields attribute is not a string")
+				}
+				var fields map[string]interface{}
+				if err := utils.FastUnmarshal([]byte(*legacy.S), &fields); err != nil {
+					log.WithError(err).WithField("session_id", item[keySessionID]).Error("Unable to decode legacy DynamoDB event fields")
+					return trace.Wrap(err)
+				}
+				if fields == nil {
+					fields = make(map[string]interface{})
+				}
+				encoded, err := dynamodbattribute.MarshalMap(map[string]interface{}{"FieldsMap": fields})
+				if err != nil {
+					return trace.Wrap(err)
+				}
+				_, err = l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+					TableName:                 aws.String(l.Tablename),
+					Key:                       map[string]*dynamodb.AttributeValue{keySessionID: item[keySessionID], keyEventIndex: item[keyEventIndex]},
+					UpdateExpression:          aws.String("SET FieldsMap = :fields"),
+					ConditionExpression:       aws.String("attribute_exists(Fields) AND attribute_not_exists(FieldsMap)"),
+					ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{":fields": encoded["FieldsMap"]},
+				})
+				if err != nil {
+					return trace.Wrap(convertError(err))
+				}
+				migrated++
+			}
+			if migrated > 0 && migrated%DynamoBatchSize == 0 {
+				log.Infof("Migrated %d DynamoDB event Fields maps", migrated)
+			}
+			startKey = scan.LastEvaluatedKey
+			if startKey == nil {
+				break
+			}
+		}
+		log.Infof("Completed DynamoDB FieldsMap migration; converted %d events", migrated)
+		return nil
+	})
+}
