+type Scheme uint
+
+const (
+	HTTP Scheme = iota
+	HTTPS
+)
+
+func (s Scheme) String() string {
+	if s == HTTPS {
+		return "https"
+	}
+	return "http"
+}
+
+func (s *Scheme) Set(value string) error {
+	switch strings.ToLower(value) {
+	case "http":
+		*s = HTTP
+	case "https":
+		*s = HTTPS
+	default:
+		return fmt.Errorf("invalid server protocol %q", value)
+	}
+	return nil
+}
