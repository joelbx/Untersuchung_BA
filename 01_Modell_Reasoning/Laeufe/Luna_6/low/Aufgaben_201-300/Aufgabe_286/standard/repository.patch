diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..9f41c9b
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,61 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info contains the release status and the latest version information.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version is a proper release rather than a prerelease build.
+func Is(version string) bool {
+	if version == "" {
+		return false
+	}
+	lower := strings.ToLower(version)
+	if lower == "dev" || strings.HasPrefix(lower, "dev-") {
+		return false
+	}
+	for _, suffix := range []string{"-snapshot", "-rc", "-dev"} {
+		if strings.Contains(lower, suffix) {
+			return false
+		}
+	}
+	return true
+}
+
+// Check queries the latest GitHub release and reports whether it is newer.
+func Check(ctx context.Context, version string) (Info, error) {
+	info := Info{CurrentVersion: version}
+	logger := zap.L()
+	client := github.NewClient(nil)
+	rel, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		logger.Warn("checking for updates", zap.Error(err))
+		return info, fmt.Errorf("checking for updates: %w", err)
+	}
+	info.LatestVersionURL = rel.GetHTMLURL()
+	latest := rel.GetTagName()
+	currentSemver, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+	latestSemver, err := semver.ParseTolerant(latest)
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+	info.LatestVersion = latest
+	info.UpdateAvailable = currentSemver.Compare(latestSemver) < 0
+	return info, nil
+}
