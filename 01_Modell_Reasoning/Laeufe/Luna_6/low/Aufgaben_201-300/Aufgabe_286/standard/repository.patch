+++ b/internal/release/check_test.go
@@ -0,0 +1,16 @@
+package release
+
+import "testing"
+
+func TestIs(t *testing.T) {
+	for _, version := range []string{"", "dev", "dev-abcdef", "v1.2.3-snapshot", "v1.2.3-rc", "v1.2.3-rc.1", "1.2.3-dev.4"} {
+		if Is(version) {
+			t.Errorf("Is(%q) = true, want false", version)
+		}
+	}
+	for _, version := range []string{"v1.2.3", "1.2.3", "v0.0.1"} {
+		if !Is(version) {
+			t.Errorf("Is(%q) = false, want true", version)
+		}
+	}
+}
