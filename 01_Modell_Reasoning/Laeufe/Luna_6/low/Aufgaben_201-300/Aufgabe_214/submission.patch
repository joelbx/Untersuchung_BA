+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	techniques, err := setScanTechniques(conf)
+	if err != nil {
+		return nil, err
+	}
+	var open []string
+	for ip, ports := range scanDestIPPorts {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		for _, port := range ports {
+			args := append([]string{}, techniques...)
+			if conf.SourcePort != "" {
+				args = append(args, "-g", conf.SourcePort)
+			}
+			args = append(args, "-p", port, "-oG", "-", ip)
+			cmd := osExec.Command(conf.ScannerBinPath, args...)
+			out, err := cmd.Output()
+			if err != nil {
+				return nil, xerrors.Errorf("nmap scan failed for %s:%s: %w", ip, port, err)
+			}
+			if strings.Contains(string(out), "open") {
+				open = append(open, net.JoinHostPort(ip, port))
+			}
+		}
+	}
+	return open, nil
+}
+
+func setScanTechniques(conf *config.PortScanConf) ([]string, error) {
+	if conf == nil {
+		return nil, nil
+	}
+	techniques := conf.GetScanTechniques()
+	if len(techniques) > 1 {
+		return nil, xerrors.New("multiple scan techniques are not supported")
+	}
+	if len(techniques) == 0 {
+		return nil, nil
+	}
+	if techniques[0] == config.NotSupportTechnique {
+		return nil, xerrors.Errorf("unsupported scan technique: %s", conf.ScanTechniques[0])
+	}
+	return []string{"-" + techniques[0].String()}, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
