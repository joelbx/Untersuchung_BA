@@ -0,0 +1,106 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies a supported nmap TCP scan.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+var scanTechniqueNames = map[ScanTechnique]string{
+	TCPSYN: "sS", TCPConnect: "sT", TCPACK: "sA", TCPWindow: "sW",
+	TCPMaimon: "sM", TCPNull: "sN", TCPFIN: "sF", TCPXmas: "sX",
+}
+
+func (s ScanTechnique) String() string { return scanTechniqueNames[s] }
+
+// PortScanConf configures optional host-local nmap scanning.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath,omitempty" json:"scannerBinPath,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged,omitempty" json:"hasPrivileged,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques,omitempty" json:"scanTechniques,omitempty"`
+	SourcePort           string   `toml:"sourcePort,omitempty" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c *PortScanConf) GetScanTechniques() []ScanTechnique {
+	if c == nil || len(c.ScanTechniques) == 0 {
+		return []ScanTechnique{}
+	}
+	result := make([]ScanTechnique, 0, len(c.ScanTechniques))
+	for _, input := range c.ScanTechniques {
+		var found ScanTechnique
+		for technique, name := range scanTechniqueNames {
+			if strings.EqualFold(input, name) {
+				found = technique
+				break
+			}
+		}
+		if found == 0 {
+			found = NotSupportTechnique
+		}
+		result = append(result, found)
+	}
+	return result
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required for external port scanning"))
+	} else if _, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q is invalid: %w", c.ScannerBinPath, err))
+	}
+	techniques := c.GetScanTechniques()
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique: %q", c.ScanTechniques[i]))
+		}
+	}
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported"))
+	}
+	if !c.HasPrivileged && len(techniques) > 0 && techniques[0] != TCPConnect && techniques[0] != NotSupportTechnique {
+		errs = append(errs, fmt.Errorf("scan technique %s requires privileges", techniques[0]))
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort must be an integer in [0,65535]"))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort 0 is not valid for evasion"))
+		}
+		if len(techniques) > 0 && techniques[0] == TCPConnect {
+			errs = append(errs, fmt.Errorf("sourcePort cannot be used with TCPConnect"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		out, err := exec.Command("getcap", c.ScannerBinPath).Output()
+		if err != nil || !strings.Contains(string(out), "cap_net_raw") {
+			errs = append(errs, fmt.Errorf("scannerBinPath lacks valid cap_net_raw capability"))
+		}
+	}
+	return errs
+}
