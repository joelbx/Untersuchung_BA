diff --git a/qutebrowser/browser/shared.py b/qutebrowser/browser/shared.py
index 384a69c..f41d998 100644
--- a/qutebrowser/browser/shared.py
+++ b/qutebrowser/browser/shared.py
@@ -167,17 +167,33 @@ def javascript_log_message(
 ) -> None:
     """Display a JavaScript log message."""
     logstring = f"[{source}:{line}] {msg}"
-
-    for pattern, levels in config.cache['content.javascript.log_message'].items():
-        if level.name in levels and fnmatch.fnmatchcase(source, pattern):
-            func = _JS_LOGMAP_MESSAGE[level]
-            func(f"JS: {logstring}")
-            return
+    if _js_log_to_ui(level, source, line, msg):
+        return
 
     logger = _JS_LOGMAP[config.cache['content.javascript.log'][level.name]]
     logger(logstring)
 
 
+def _js_log_to_ui(level: usertypes.JsLogLevel, source: str, line: int,
+                  msg: str) -> bool:
+    """Show an eligible JavaScript message in the UI; return whether shown."""
+    eligible = any(
+        level.name in levels and fnmatch.fnmatchcase(source, pattern)
+        for pattern, levels in
+        config.cache['content.javascript.log_message.levels'].items())
+    if not eligible:
+        return False
+
+    for pattern, messages in config.cache[
+            'content.javascript.log_message.excludes'].items():
+        if (fnmatch.fnmatchcase(source, pattern) and
+                any(fnmatch.fnmatchcase(msg, message) for message in messages)):
+            return False
+
+    _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+    return True
+
+
