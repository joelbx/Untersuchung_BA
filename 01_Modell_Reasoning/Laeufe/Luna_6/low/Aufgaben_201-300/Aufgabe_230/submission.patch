+def test_prioritized_identifier_equality_and_serialization() -> None:
+    from datetime import datetime
+
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    item = PrioritizedIdentifier("B012346789", stage_import=False, priority=Priority.HIGH, timestamp=timestamp)
+    duplicate = PrioritizedIdentifier("B012346789", stage_import=True, priority=Priority.LOW)
+
+    assert item == duplicate
+    assert len({item, duplicate}) == 1
+    assert item.to_dict() == {
+        "identifier": "B012346789",
+        "priority": "HIGH",
+        "timestamp": "2024-01-02T03:04:05",
+        "stage_import": False,
+    }
