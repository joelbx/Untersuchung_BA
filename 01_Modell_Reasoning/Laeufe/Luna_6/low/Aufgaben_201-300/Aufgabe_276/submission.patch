@@ -402,7 +402,30 @@ func (a AuthenticationMethodOIDCConfig) info() AuthenticationMethodInfo {
 	return info
 }
 
-func (a AuthenticationMethodOIDCConfig) validate() error { return nil }
+func (a AuthenticationMethodOIDCConfig) validate() error {
+	for name, provider := range a.Providers {
+		if err := validateOAuthProvider(name, provider.ClientID, provider.ClientSecret, provider.RedirectAddress); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateOAuthProvider(name, clientID, clientSecret, redirectAddress string) error {
+	for _, field := range []struct {
+		name  string
+		value string
+	}{
+		{name: "client_id", value: clientID},
+		{name: "client_secret", value: clientSecret},
+		{name: "redirect_address", value: redirectAddress},
+	} {
+		if strings.TrimSpace(field.value) == "" {
+			return fmt.Errorf("provider %q: field %q: non-empty value is required", name, field.name)
+		}
+	}
+	return nil
+}
 
 // AuthenticationOIDCProvider configures provider credentials
