+func TestAuthenticationOAuthRequiredFields(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  AuthenticationConfig
+		want string
+	}{
+		{
+			name: "github missing client id",
+			cfg:  AuthenticationConfig{Session: AuthenticationSession{Domain: "localhost"}, Methods: AuthenticationMethods{Github: AuthenticationMethod[AuthenticationMethodGithubConfig]{Enabled: true}}},
+			want: `provider "github": field "client_id": non-empty value is required`,
+		},
+		{
+			name: "github missing client secret",
+			cfg:  AuthenticationConfig{Session: AuthenticationSession{Domain: "localhost"}, Methods: AuthenticationMethods{Github: AuthenticationMethod[AuthenticationMethodGithubConfig]{Enabled: true, Method: AuthenticationMethodGithubConfig{ClientId: "id"}}}},
+			want: `provider "github": field "client_secret": non-empty value is required`,
+		},
+		{
+			name: "github missing redirect",
+			cfg:  AuthenticationConfig{Session: AuthenticationSession{Domain: "localhost"}, Methods: AuthenticationMethods{Github: AuthenticationMethod[AuthenticationMethodGithubConfig]{Enabled: true, Method: AuthenticationMethodGithubConfig{ClientId: "id", ClientSecret: "secret"}}}},
+			want: `provider "github": field "redirect_address": non-empty value is required`,
+		},
+		{
+			name: "oidc provider missing client id",
+			cfg:  AuthenticationConfig{Session: AuthenticationSession{Domain: "localhost"}, Methods: AuthenticationMethods{OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true, Method: AuthenticationMethodOIDCConfig{Providers: map[string]AuthenticationMethodOIDCProvider{"foo": {}}}}}},
+			want: `provider "foo": field "client_id": non-empty value is required`,
+		},
+		{
+			name: "oidc provider missing client secret",
+			cfg:  AuthenticationConfig{Session: AuthenticationSession{Domain: "localhost"}, Methods: AuthenticationMethods{OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true, Method: AuthenticationMethodOIDCConfig{Providers: map[string]AuthenticationMethodOIDCProvider{"foo": {ClientID: "id"}}}}}},
+			want: `provider "foo": field "client_secret": non-empty value is required`,
+		},
+		{
+			name: "oidc provider missing redirect",
+			cfg:  AuthenticationConfig{Session: AuthenticationSession{Domain: "localhost"}, Methods: AuthenticationMethods{OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true, Method: AuthenticationMethodOIDCConfig{Providers: map[string]AuthenticationMethodOIDCProvider{"foo": {ClientID: "id", ClientSecret: "secret"}}}}}},
+			want: `provider "foo": field "redirect_address": non-empty value is required`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.cfg.validate()
+			require.EqualError(t, err, tt.want)
+		})
+	}
+}
