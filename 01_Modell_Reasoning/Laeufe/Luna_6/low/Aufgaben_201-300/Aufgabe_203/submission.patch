diff --git a/src/components/views/elements/ExternalLink.tsx b/src/components/views/elements/ExternalLink.tsx
new file mode 100644
index 0000000..73f35fa
--- /dev/null
+++ b/src/components/views/elements/ExternalLink.tsx
@@ -0,0 +1,10 @@
+import React from 'react';
+
+export type ExternalLinkProps = React.AnchorHTMLAttributes<HTMLAnchorElement>;
+
+export default function ExternalLink({ className, target, rel, children, ...props }: ExternalLinkProps): JSX.Element {
+    return <a {...props} className={["mx_ExternalLink", className].filter(Boolean).join(" ")} target={target ?? "_blank"} rel={rel ?? "noreferrer noopener"}>
+        { children }
+        <span className="mx_ExternalLink_icon" aria-hidden="true" />
+    </a>;
+}
