diff --git a/internal/ext/common.go b/internal/ext/common.go
index 591ea9c..e63b24f 100644
--- a/internal/ext/common.go
+++ b/internal/ext/common.go
@@ -1,5 +1,109 @@
 package ext
 
+import (
+	"fmt"
+)
+
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ IsSegment }
+
+func (s SegmentEmbed) MarshalYAML() (interface{}, error) {
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, fmt.Errorf("segment key cannot be empty")
+		}
+		return string(v), nil
+	case Segments:
+		if len(v.Keys) == 0 || v.SegmentOperator == "" {
+			return nil, fmt.Errorf("segment object requires keys and operator")
+		}
+		return v, nil
+	default:
+		return nil, fmt.Errorf("segment is required or has unsupported type %T", s.IsSegment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var key string
+	if err := unmarshal(&key); err == nil {
+		if key == "" {
+			return fmt.Errorf("segment key cannot be empty")
+		}
+		s.IsSegment = SegmentKey(key)
+		return nil
+	}
+	var obj map[interface{}]interface{}
+	if err := unmarshal(&obj); err != nil {
+		return fmt.Errorf("segment must be a string or object: %w", err)
+	}
+	if len(obj) != 2 {
+		return fmt.Errorf("segment object must contain keys and operator")
+	}
+	for k := range obj {
+		if k != "keys" && k != "operator" {
+			return fmt.Errorf("unsupported segment field %v", k)
+		}
+	}
+	var value struct {
+		Keys     []string `yaml:"keys"`
+		Operator string   `yaml:"operator"`
+	}
+	if err := unmarshal(&value); err != nil {
+		return err
+	}
+	if len(value.Keys) == 0 {
+		return fmt.Errorf("segment object requires at least one key")
+	}
+	if len(value.Keys) == 1 {
+		if value.Keys[0] == "" {
+			return fmt.Errorf("segment key cannot be empty")
+		}
+		s.IsSegment = SegmentKey(value.Keys[0])
+		return nil
+	}
+	if value.Operator != "AND_SEGMENT_OPERATOR" && value.Operator != "OR_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid segment operator %q", value.Operator)
+	}
+	s.IsSegment = Segments{Keys: value.Keys, SegmentOperator: value.Operator}
+	return nil
+}
+
+func (s SegmentEmbed) Values() ([]string, string, error) {
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, "", fmt.Errorf("segment key cannot be empty")
+		}
+		return []string{string(v)}, "OR_SEGMENT_OPERATOR", nil
+	case Segments:
+		if len(v.Keys) == 0 || v.SegmentOperator == "" {
+			return nil, "", fmt.Errorf("segment object requires keys and operator")
+		}
+		if v.SegmentOperator != "AND_SEGMENT_OPERATOR" && v.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+			return nil, "", fmt.Errorf("invalid segment operator %q", v.SegmentOperator)
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys, "OR_SEGMENT_OPERATOR", nil
+		}
+		return v.Keys, v.SegmentOperator, nil
+	default:
+		return nil, "", fmt.Errorf("segment is required or has unsupported type %T", s.IsSegment)
+	}
+}
+
