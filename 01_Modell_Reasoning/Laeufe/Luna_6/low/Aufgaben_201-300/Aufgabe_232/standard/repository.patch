diff --git a/config/os.go b/config/os.go
new file mode 100644
index 0000000..e679888
--- /dev/null
+++ b/config/os.go
@@ -0,0 +1,50 @@
+package config
+
+import "time"
+
+// EOL describes the end of an operating system's support phases.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+func eol(standard, extended string) EOL {
+	parse := func(value string) time.Time {
+		if value == "" {
+			return time.Time{}
+		}
+		t, _ := time.Parse("2006-01-02", value)
+		return t
+	}
+	s, x := parse(standard), parse(extended)
+	return EOL{StandardSupportUntil: s, ExtendedSupportUntil: x}
+}
+
+var eolData = map[string]map[string]EOL{
+	Amazon:  {"2018.03": eol("2023-06-30", "2023-06-30"), "2 (Karoo)": eol("2025-06-30", "")},
+	RedHat:  {"7": eol("2024-06-30", ""), "8": eol("2029-05-31", ""), "6": eol("2020-11-30", "2024-06-30")},
+	CentOS:  {"7": eol("2024-06-30", ""), "8": eol("2021-12-31", ""), "6": eol("2020-11-30", "2020-11-30")},
+	Oracle:  {"7": eol("2024-06-30", ""), "8": eol("2029-05-31", ""), "6": eol("2021-03-31", "2022-03-31")},
+	Ubuntu:  {"18.04": eol("2023-05-31", "2028-04-30"), "14.04": eol("2019-04-30", "2024-04-30"), "14.10": eol("2015-07-30", "2015-07-30"), "21.04": eol("2022-01-30", "")},
+	Debian:  {"9": eol("2022-06-30", ""), "10": eol("2024-06-30", ""), "8": eol("2020-06-30", "2020-06-30")},
+	Alpine:  {"3.10": eol("2021-05-30", ""), "3.11": eol("2021-11-30", ""), "3.12": eol("2022-05-30", ""), "3.9": eol("2020-11-30", "2020-11-30")},
+	FreeBSD: {"11": eol("2021-09-30", "2021-09-30"), "12": eol("2023-12-31", ""), "10": eol("2019-10-30", "2019-10-30")},
+}
+
+// GetEOL returns lifecycle information for a supported family and release.
+func GetEOL(family, release string) (EOL, bool) {
+	if releases, ok := eolData[family]; ok {
+		v, found := releases[release]
+		return v, found
+	}
+	return EOL{}, false
+}
