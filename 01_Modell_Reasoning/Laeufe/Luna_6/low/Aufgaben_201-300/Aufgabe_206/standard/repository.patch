 const Topics = module.exports;
 
+Topics.lockPosting = async (req, error) => {
+	const id = req.uid ? req.uid : req.sessionID;
+	if (!id) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const key = `posting${id}`;
+	const count = await db.incrObjectField('locks', key);
+	if (count > 1) {
+		await db.decrObjectField('locks', key);
+		throw new Error(error);
+	}
+	return key;
+};
+
+async function withPostingLock(req, action) {
+	const key = await Topics.lockPosting(req, '[[error:posting-in-progress]]');
+	try {
+		return await action();
+	} finally {
+		await db.deleteObjectField('locks', key);
+	}
+}
