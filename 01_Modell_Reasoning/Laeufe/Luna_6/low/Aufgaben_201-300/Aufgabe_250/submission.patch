+def test_luqum_replace_child():
+    tree = luqum_parser('foo OR bar')
+    old_child, new_child = tree.children[0], luqum_parser('baz')
+    new_child.head = old_child.head
+    new_child.tail = old_child.tail
+
+    luqum_replace_child(tree, old_child, new_child)
+
+    assert str(tree) == 'baz OR bar'
+    assert isinstance(tree.children, tuple)
+
+
+def test_luqum_replace_child_missing_child_leaves_parent_unchanged():
+    tree = luqum_parser('foo OR bar')
+    children = tree.children
+
+    luqum_replace_child(tree, luqum_parser('missing'), luqum_parser('baz'))
+
+    assert tree.children == children
+
+
+def test_luqum_replace_child_unsupported_parent():
+    with pytest.raises(ValueError, match='Not supported for generic class Item'):
+        luqum_replace_child(luqum_parser('foo'), luqum_parser('foo'), luqum_parser('bar'))
+
