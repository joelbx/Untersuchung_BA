@@ -32,6 +32,20 @@ def luqum_remove_child(child: Item, parents: list[Item]):
         raise ValueError("Not supported for generic class Item")
 
 
+def luqum_replace_child(parent: Item, old_child: Item, new_child: Item):
+    """Replace a direct child of a supported luqum node.
+
+    The children sequence keeps its original type and order. If the old child
+    is absent, the parent is left unchanged.
+    """
+    if isinstance(parent, (BaseOperation, Group, Unary)):
+        parent.children = type(parent.children)(
+            new_child if child == old_child else child for child in parent.children
+        )
+    else:
+        raise ValueError("Not supported for generic class Item")
+
+
