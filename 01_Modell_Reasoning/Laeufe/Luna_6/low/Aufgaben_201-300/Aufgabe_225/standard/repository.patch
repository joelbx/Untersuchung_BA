+// FormatKEVCveSummary returns the number of CVEs with known exploited vulnerability records.
+func (r ScanResult) FormatKEVCveSummary() string {
+	n := 0
+	for _, vuln := range r.ScannedCves {
+		if len(vuln.KEVs) > 0 {
+			n++
+		}
+	}
+	return fmt.Sprintf("%d KEVs", n)
+}
