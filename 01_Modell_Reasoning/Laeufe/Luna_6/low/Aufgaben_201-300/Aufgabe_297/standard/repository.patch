+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	if str, ok := value.(string); ok {
+		return re.ReplaceAllString(str, "$1[REDACTED]$2")
+	}
+	rv := reflect.ValueOf(value)
+	if rv.Kind() == reflect.Map && rv.Type().Key().Kind() == reflect.String {
+		copy := reflect.MakeMapWithSize(rv.Type(), rv.Len())
+		iter := rv.MapRange()
+		for iter.Next() {
+			key := iter.Key()
+			val := iter.Value()
+			var redacted interface{}
+			if val.IsValid() && val.CanInterface() {
+				redacted = redactValue(val.Interface(), re)
+			}
+			if redacted == nil {
+				copy.SetMapIndex(key, reflect.Zero(rv.Type().Elem()))
+			} else {
+				converted := reflect.ValueOf(redacted)
+				if converted.Type().AssignableTo(rv.Type().Elem()) {
+					copy.SetMapIndex(key, converted)
+				} else if rv.Type().Elem().Kind() == reflect.Interface {
+					copy.SetMapIndex(key, converted)
+				} else {
+					copy.SetMapIndex(key, reflect.Zero(rv.Type().Elem()))
+				}
+			}
+		}
+		return copy.Interface()
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
