+// validateIPAgainstList checks a remote address against comma-separated IP CIDRs.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if strings.TrimSpace(whitelist) == "" {
+		return false
+	}
+	if remoteAddr == "@" || strings.HasPrefix(remoteAddr, "@") {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	host, _, err := net.SplitHostPort(remoteAddr)
+	if err != nil {
+		host = remoteAddr
+	}
+	ip := net.ParseIP(strings.Trim(host, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+		if _, _, err := net.SplitHostPort(entry); err == nil {
+			entry, _, _ = net.SplitHostPort(entry)
+		}
+		remoteIP, ok := netip.AddrFromSlice(ip)
+		if !ok {
+			return false
+		}
+		remoteIP = remoteIP.Unmap()
+		if cidr, err := netip.ParsePrefix(entry); err == nil && cidr.Contains(remoteIP) {
+			return true
+		}
+		if addr, err := netip.ParseAddr(entry); err == nil && addr.Unmap() == remoteIP {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	auth.Init(ds)
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	username := strings.TrimSpace(r.Header.Get(conf.Server.ReverseProxyUserHeader))
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			return nil
+		}
+		now := time.Now()
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: strings.Title(username), IsAdmin: count == 0, LastLoginAt: &now}
+		if repo.Put(user) != nil {
+			return nil
+		}
+	} else if err != nil {
+		return nil
+	}
+	if repo.UpdateLastLoginAt(user.ID) != nil {
+		log.Error(r, "Could not update LastLoginAt", "user", username)
+	}
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		return nil
+	}
+	salt := uuid.NewString()[:6]
+	digest := md5.Sum([]byte(user.Password + salt))
+	return map[string]interface{}{"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name, "username": user.UserName, "token": token, "subsonicSalt": salt, "subsonicToken": fmt.Sprintf("%x", digest)}
+}
