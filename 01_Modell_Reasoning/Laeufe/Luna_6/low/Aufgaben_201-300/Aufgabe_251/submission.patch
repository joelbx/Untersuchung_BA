+// Result aggregates validation errors for a document.
+type Result struct {
+	Errors []Error `json:"errors"`
+}
+
+// FeaturesValidator validates feature YAML documents against the embedded schema.
+type FeaturesValidator struct {
+	cue *cue.Context
+	v   cue.Value
+}
+
+func NewFeaturesValidator() (*FeaturesValidator, error) {
+	c := cuecontext.New()
+	v := c.CompileBytes(cueFile)
+	if err := v.Err(); err != nil {
+		return nil, err
+	}
+	return &FeaturesValidator{cue: c, v: v}, nil
+}
+
+func (fv *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	result := Result{Errors: []Error{}}
+	f, err := yaml.Extract(file, b)
+	if err != nil {
+		return result, err
+	}
+	yv := fv.cue.BuildFile(f, cue.Scope(fv.v))
+	validationErr := fv.v.Unify(yv).Validate()
+	if validationErr == nil {
+		return result, nil
+	}
+	for _, e := range cueerror.Errors(validationErr) {
+		positions := e.InputPositions()
+		loc := Location{File: file}
+		if len(positions) > 0 {
+			loc.Line = positions[0].Line()
+			loc.Column = positions[0].Column()
+		}
+		path := strings.Join(e.Path(), ".")
+		format, args := e.Msg()
+		message := fmt.Sprintf(format, args...)
+		if path != "" {
+			message = path + ": " + message
+		}
+		result.Errors = append(result.Errors, Error{Message: message, Path: path, Location: loc})
+	}
+	return result, ErrValidationFailed
+}
