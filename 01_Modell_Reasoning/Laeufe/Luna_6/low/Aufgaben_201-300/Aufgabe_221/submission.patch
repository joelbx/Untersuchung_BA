+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards.json"
+    encoding = "json"
+
+    def POST(self, work_id):
+        user = accounts.get_current_user()
+        if not user:
+            return delegate.RawText(json.dumps({"errors": "Authentication failed"}), content_type="application/json")
+        i = web.input(op="", topic=None, comment="", edition_key=None)
+        username = user.key.split("/")[2]
+        try:
+            if i.op == "remove":
+                rows = Bestbook.remove(username=username, work_id=work_id)
+                result = {"success": True, "rows": rows}
+            elif i.op in ("add", "update"):
+                if not i.topic:
+                    raise Bestbook.AwardConditionsError("A topic is required")
+                edition_id = extract_numeric_id_from_olid(i.edition_key) if i.edition_key else None
+                if i.op == "add":
+                    award_id = Bestbook.add(username, work_id, i.topic, i.comment, edition_id)
+                    award = Bestbook.get_awards(work_id=work_id, username=username)[0]
+                else:
+                    award = Bestbook.update(username, work_id, i.topic, i.comment, edition_id)
+                result = {"success": True, "award": dict(award) if not isinstance(award, int) else award}
+            else:
+                raise Bestbook.AwardConditionsError("Invalid operation")
+        except Bestbook.AwardConditionsError as exc:
+            result = {"errors": str(exc)}
+        return delegate.RawText(json.dumps(result), content_type="application/json")
+
+
+class bestbook_count(delegate.page):
