+def _is_child_path(path, parent, link_location=None):
+    """Return whether path resolves inside parent (relative symlinks use link_location)."""
+    path = to_bytes(path, errors='surrogate_or_strict')
+    parent = to_bytes(parent, errors='surrogate_or_strict')
+    if link_location is not None:
+        link_location = to_bytes(link_location, errors='surrogate_or_strict')
+    if link_location is not None and not os.path.isabs(path):
+        path = os.path.join(os.path.dirname(link_location), path)
+    path = os.path.realpath(path)
+    parent = os.path.realpath(parent)
+    try:
+        return os.path.commonpath((path, parent)) == parent
+    except ValueError:  # Different drives on Windows.
+        return False
 
 
