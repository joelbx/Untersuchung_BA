+// parsePkgName splits an ecosystem package name into PURL namespace, name, and subpath.
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	switch t {
+	case "maven":
+		if i := strings.IndexByte(n, ':'); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+		return "", n, ""
+	case "pypi":
+		return "", strings.ToLower(strings.ReplaceAll(n, "_", "-")), ""
+	case "golang":
+		if i := strings.LastIndexByte(n, '/'); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+		return "", n, ""
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if i := strings.IndexByte(n, '/'); i >= 0 {
+				return n[:i], n[i+1:], ""
+			}
+		}
+		return "", n, ""
+	case "cocoapods":
+		if i := strings.IndexByte(n, '/'); i >= 0 {
+			return "", n[:i], n[i+1:]
+		}
+		return "", n, ""
+	default:
+		return "", n, ""
+	}
+}
