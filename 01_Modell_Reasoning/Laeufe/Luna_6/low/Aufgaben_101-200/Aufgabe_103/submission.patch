+func (o *redhatBase) parseInstalledPackagesLinePreserveEmptyRelease(line string) (*models.Package, *models.SrcPackage, error) {
+	fields := strings.Split(line, " ")
+	filtered := make([]string, 0, len(fields))
+	for _, f := range fields { if f != "" { filtered = append(filtered, f) } }
+	if len(filtered) < 5 { return nil, nil, xerrors.Errorf("Failed to parse package line: %s", line) }
+	// RPM query format has a fixed release column. Preserve the empty value by
+	// inserting it after version before delegating to the common formatter.
+	parts := strings.Fields(line)
+	if len(parts) == 5 || len(parts) == 6 || len(parts) == 7 {
+		parts = append(parts[:3], append([]string{""}, parts[3:]...)...)
+		return o.parseInstalledPackagesLine(strings.Join(parts, " "))
+	}
+	return o.parseInstalledPackagesLine(line)
+}
