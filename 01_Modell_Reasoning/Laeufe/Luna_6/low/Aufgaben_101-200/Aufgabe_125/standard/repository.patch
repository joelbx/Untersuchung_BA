+const nconf = require('nconf');
 
 const db = require('../database');
 const user = require('../user');
@@ -12,6 +13,40 @@ const plugins = require('../plugins');
 const utils = require('../../public/src/utils');
 
 module.exports = function (Topics) {
+	Topics.syncBacklinks = async function (postData) {
+		if (!postData || !postData.pid || !postData.uid || !postData.tid || typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+		const baseUrl = String(nconf.get('url') || '').replace(/\/$/, '');
+		const escapedBase = baseUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+		const re = new RegExp(`(?:${escapedBase})?/topic/(\\d+)(?:/[^\\s\\]<>"']*)?`, 'g');
+		const referenced = _.uniq(Array.from(postData.content.matchAll(re), match => match[1]))
+			.filter(tid => String(tid) !== String(postData.tid));
+		const existing = await db.getSortedSetRange(`pid:${postData.pid}:backlinks`, 0, -1);
+		const exists = await Promise.all(referenced.map(tid => Topics.exists(tid)));
+		const valid = referenced.filter((tid, index) => exists[index]).map(String);
+		const removed = existing.filter(tid => !valid.includes(String(tid)));
+		const added = valid.filter(tid => !existing.map(String).includes(tid));
+		if (removed.length) {
+			await db.sortedSetRemove(`pid:${postData.pid}:backlinks`, removed);
+			await Promise.all(removed.map(async (tid) => {
+				const ids = await db.getSortedSetRange(`topic:${tid}:events`, 0, -1);
+				const payloads = await db.getObjects(ids.map(id => `topicEvent:${id}`));
+				const eventIds = ids.filter((id, i) => payloads[i] && payloads[i].type === 'backlink' && String(payloads[i].pid) === String(postData.pid));
+				if (eventIds.length) {
+					await Promise.all([db.sortedSetRemove(`topic:${tid}:events`, eventIds), db.deleteAll(eventIds.map(id => `topicEvent:${id}`))]);
+				}
+			}));
+		}
+		if (valid.length) {
+			await db.sortedSetAdd(`pid:${postData.pid}:backlinks`, Date.now(), valid);
+		}
+		await Promise.all(added.map(tid => Topics.events.log(tid, {
+			type: 'backlink', pid: postData.pid, uid: postData.uid, href: `/post/${postData.pid}`,
+		})));
+		return added.length + removed.length;
+	};
+
 	Topics.onNewPostMade = async function (postData) {
 		await Topics.updateLastPostTime(postData.tid, postData.timestamp);
 		await Topics.addPostToTopic(postData.tid, postData);
