+def supplement_rec_with_import_item_metadata(rec: dict[str, Any], identifier: str) -> None:
+    """Fill missing import fields from a staged or pending import item."""
+    try:
+        rows = ImportItem.find_staged_or_pending([identifier])
+        if not rows:
+            return
+        item = rows[0]
+        data = item.get('data')
+        if isinstance(data, str):
+            data = json.loads(data)
+        if not isinstance(data, dict):
+            return
+        for field in ('authors', 'publish_date', 'publishers', 'number_of_pages',
+                      'physical_format', 'isbn_10', 'isbn_13', 'title'):
+            if _field_missing(rec.get(field)) and not _field_missing(data.get(field)):
+                rec[field] = data[field]
+    except Exception:
+        logger.exception('Failed to supplement import record for %s', identifier)
+
+
+def _incomplete_record(rec: dict[str, Any]) -> bool:
+    return any(_field_missing(rec.get(field)) for field in ('title', 'authors', 'publish_date'))
+
+
+def _augment_incomplete_record(rec: dict[str, Any]) -> None:
+    if not _incomplete_record(rec):
+        return
+    isbn10 = rec.get('isbn_10')
+    identifier = (isbn10[0] if isinstance(isbn10, list) and isbn10 else isbn10)
+    if not identifier:
+        amazon = rec.get('identifiers', {}).get('amazon', [])
+        identifier = amazon[0] if amazon and amazon[0].upper().startswith('B') else None
+    if identifier:
+        supplement_rec_with_import_item_metadata(rec, identifier)
+
