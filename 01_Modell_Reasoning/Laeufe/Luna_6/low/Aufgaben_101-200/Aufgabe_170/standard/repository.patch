+def add_db_name(rec):
+    """Add a comparable name to each author, including available dates."""
+    for author in rec.get('authors') or []:
+        if not isinstance(author, dict):
+            continue
+        name = author.get('name', '')
+        date = author.get('date')
+        if not date and (author.get('birth_date') or author.get('death_date')):
+            date = f"{author.get('birth_date', '')}-{author.get('death_date', '')}"
+        author['db_name'] = ' '.join(part for part in (name, date) if part).strip()
+
+
+def expand_record(rec):
+    """Return a normalized comparison representation of an edition record."""
+    expanded = dict(rec)
+    title = rec.get('full_title') or rec.get('title') or ''
+    if rec.get('subtitle') and rec.get('full_title') is None:
+        title = f"{title} {rec['subtitle']}".strip()
+    expanded.update(build_titles(title))
+    expanded['isbn'] = list(dict.fromkeys(
+        value
+        for field in ('isbn', 'isbn_10', 'isbn_13')
+        for value in (rec.get(field) or [])
+    ))
+    for field in ('isbn_10', 'isbn_13', 'title', 'subtitle'):
+        expanded.pop(field, None)
+    if rec.get('publish_country') in ('   ', '|||'):
+        expanded.pop('publish_country', None)
+    add_db_name(expanded)
+    return expanded
+
