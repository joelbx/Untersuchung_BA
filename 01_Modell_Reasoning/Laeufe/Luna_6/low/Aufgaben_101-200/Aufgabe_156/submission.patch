+def sanitize_keys(obj, no_log_strings, ignore_keys=frozenset()):
+    """Copy mappings recursively, masking sensitive key substrings."""
+    secrets = [to_native(s, errors='surrogate_or_strict') for s in no_log_strings]
+    secrets = [secret for secret in secrets if secret]
+    if not isinstance(obj, Mapping):
+        return obj
+    root = _empty_container(obj)
+    pending = deque([(obj, root)])
+    while pending:
+        source, target = pending.popleft()
+        if isinstance(source, Mapping):
+            pairs = source.items()
+        else:
+            pairs = ((None, item) for item in source)
+        for key, value in pairs:
+            if isinstance(source, Mapping):
+                if key in ignore_keys or (isinstance(key, string_types) and key.startswith('_ansible')):
+                    new_key = key
+                elif isinstance(key, (text_type, binary_type)):
+                    native_key = to_native(key, errors='surrogate_or_strict')
+                    if native_key in secrets:
+                        new_key = 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+                    else:
+                        new_key = native_key
+                        for secret in secrets:
+                            new_key = new_key.replace(secret, '*' * 8)
+                else:
+                    new_key = key
+            if isinstance(value, (Mapping, list, tuple, set, frozenset)):
+                child = _empty_container(value)
+                pending.append((value, child))
+                cleaned = child
+            else:
+                cleaned = value
+            if isinstance(source, Mapping):
+                target[new_key] = cleaned
+            elif isinstance(target, list):
+                target.append(cleaned)
+            elif isinstance(target, set):
+                target.add(cleaned)
+            else:
+                target.append(cleaned)
+    return _freeze_container(root)
 
 
