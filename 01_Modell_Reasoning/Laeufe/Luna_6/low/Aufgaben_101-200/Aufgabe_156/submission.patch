+def _empty_container(value):
+    if isinstance(value, Mapping):
+        try:
+            return type(value)()
+        except Exception:
+            return {}
+    if isinstance(value, list):
+        return _ListBuilder()
+    if isinstance(value, tuple):
+        return _TupleBuilder()
+    if isinstance(value, set):
+        return set()
+    if isinstance(value, frozenset):
+        return set()
+
+
+class _TupleBuilder(list):
+    pass
+
+
+class _ListBuilder(list):
+    pass
+
+
+def _freeze_container(root):
+    """Convert mutable staging containers back to tuple/frozenset shapes iteratively."""
+    # Tuples are staged as lists; nested tuples are converted in-place bottom-up.
+    stack = [(root, False)]
+    built = {}
+    while stack:
+        obj, visited = stack.pop()
+        if isinstance(obj, (list, dict, set)):
+            if not visited:
+                stack.append((obj, True))
+                values = obj.values() if isinstance(obj, dict) else obj
+                for child in values:
+                    if isinstance(child, (list, dict, set)):
+                        stack.append((child, False))
+            else:
+                replacement = obj
+                if isinstance(obj, _TupleBuilder):
+                    replacement = tuple(built.get(id(x), x) for x in obj)
+                elif isinstance(obj, _ListBuilder):
+                    replacement = [built.get(id(x), x) for x in obj]
+                elif isinstance(obj, set):
+                    replacement = frozenset(built.get(id(x), x) for x in obj)
+                elif isinstance(obj, dict):
+                    replacement = type(obj)((k, built.get(id(v), v)) for k, v in obj.items())
+                built[id(obj)] = replacement
+    return built.get(id(root), root)
+
