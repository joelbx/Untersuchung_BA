+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		b := conf.Server.Backup
+		if b.Path == "" || b.Schedule == "" || b.Count == 0 {
+			log.Info("Periodic backup is DISABLED")
+			return nil
+		}
+		if err := os.MkdirAll(b.Path, 0755); err != nil {
+			return err
+		}
+		instance := scheduler.GetInstance()
+		log.Info("Scheduling periodic database backups", "schedule", b.Schedule)
+		return instance.Add(b.Schedule, func() {
+			if _, err := db.Db().Backup(ctx); err != nil {
+				log.Error("Error creating scheduled backup", err)
+				return
+			}
+			if _, err := db.Db().Prune(ctx); err != nil {
+				log.Error("Error pruning scheduled backups", err)
+			}
+		})
+	}
+}
