diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..a2a616c
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,183 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	sqlite3 "github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", fmt.Errorf("backup.path is not configured")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		return "", err
+	}
+	name := backupPrefix + time.Now().UTC().Format("20060102T150405.000000000Z") + ".db"
+	dest := filepath.Join(conf.Server.Backup.Path, name)
+	srcConn, err := d.readDB.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer srcConn.Close()
+	destDB, err := sql.Open(Driver+"_custom", dest)
+	if err != nil {
+		return "", err
+	}
+	defer destDB.Close()
+	destConn, err := destDB.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer destConn.Close()
+	var backupErr error
+	err = destConn.Raw(func(dst any) error {
+		return srcConn.Raw(func(src any) error {
+			d, ok := dst.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected sqlite destination connection")
+			}
+			s, ok := src.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected sqlite source connection")
+			}
+			b, err := d.Backup("main", s, "main")
+			if err != nil {
+				return err
+			}
+			defer b.Close()
+			for {
+				select {
+				case <-ctx.Done():
+					return ctx.Err()
+				default:
+				}
+				done, err := b.Step(128)
+				if err != nil {
+					return err
+				}
+				if done {
+					return nil
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+	backupErr = err
+	if backupErr != nil {
+		_ = os.Remove(dest)
+		return "", backupErr
+	}
+	return dest, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if _, err := os.Stat(path); err != nil {
+		return err
+	}
+	if conf.Server.DbPath == ":memory:" || strings.HasPrefix(conf.Server.DbPath, "file::memory:") {
+		return fmt.Errorf("cannot restore an in-memory database")
+	}
+	if err := d.readDB.Close(); err != nil {
+		return err
+	}
+	if err := d.writeDB.Close(); err != nil {
+		return err
+	}
+	if err := copySQLite(path, conf.Server.DbPath); err != nil {
+		return err
+	}
+	return nil
+}
+
+func copySQLite(src, dst string) error {
+	source, err := sql.Open(Driver+"_custom", src)
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	target, err := sql.Open(Driver+"_custom", dst)
+	if err != nil {
+		return err
+	}
+	defer target.Close()
+	ctx := context.Background()
+	sc, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer sc.Close()
+	dc, err := target.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dc.Close()
+	return dc.Raw(func(dconn any) error {
+		return sc.Raw(func(sconn any) error {
+			d, ok := dconn.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected sqlite connection")
+			}
+			s, ok := sconn.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected sqlite connection")
+			}
+			b, err := d.Backup("main", s, "main")
+			if err != nil {
+				return err
+			}
+			defer b.Close()
+			for {
+				done, err := b.Step(128)
+				if err != nil {
+					return err
+				}
+				if done {
+					return nil
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	files, err := filepath.Glob(filepath.Join(conf.Server.Backup.Path, backupPrefix+"*.db"))
+	if err != nil {
+		return 0, err
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	keep := conf.Server.Backup.Count
+	if keep < 0 {
+		keep = 0
+	}
+	if keep > len(files) {
+		keep = len(files)
+	}
+	removed := 0
+	for _, file := range files[keep:] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(file); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
