+package cmd
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+var backupForce bool
+
+var backupCmd = &cobra.Command{Use: "backup", Short: "Manage database backups"}
+
+func init() {
+	create := &cobra.Command{Use: "create", Short: "Create a database backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		if err := db.InitDBForCommand(); err != nil {
+			return err
+		}
+		path, err := db.Db().Backup(cmd.Context())
+		if err == nil {
+			fmt.Fprintln(cmd.OutOrStdout(), path)
+		}
+		return err
+	}}
+	prune := &cobra.Command{Use: "prune", Short: "Remove old database backups", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		if conf.Server.Backup.Count == 0 && !backupForce {
+			if !confirm(cmd, "backup.count is zero; delete all backups?") {
+				return fmt.Errorf("prune cancelled")
+			}
+		}
+		if err := db.InitDBForCommand(); err != nil {
+			return err
+		}
+		n, err := db.Db().Prune(cmd.Context())
+		if err == nil {
+			fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backups\n", n)
+		}
+		return err
+	}}
+	restore := &cobra.Command{Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		file, _ := cmd.Flags().GetString("backup-file")
+		if strings.TrimSpace(file) == "" {
+			return fmt.Errorf("--backup-file is required")
+		}
+		if !backupForce && !confirm(cmd, "Restore database from "+file+"?") {
+			return fmt.Errorf("restore cancelled")
+		}
+		if err := db.InitDBForCommand(); err != nil {
+			return err
+		}
+		return db.Db().Restore(cmd.Context(), file)
+	}}
+	prune.Flags().BoolVar(&backupForce, "force", false, "skip confirmation")
+	restore.Flags().BoolVar(&backupForce, "force", false, "skip confirmation")
+	restore.Flags().String("backup-file", "", "path to the backup file")
+	backupCmd.AddCommand(create, prune, restore)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirm(cmd *cobra.Command, prompt string) bool {
+	fmt.Fprintf(cmd.OutOrStdout(), "%s [y/N] ", prompt)
+	var answer string
+	if _, err := fmt.Fscan(cmd.InOrStdin(), &answer); err != nil {
+		return false
+	}
+	return strings.EqualFold(answer, "y") || strings.EqualFold(answer, "yes")
+}
