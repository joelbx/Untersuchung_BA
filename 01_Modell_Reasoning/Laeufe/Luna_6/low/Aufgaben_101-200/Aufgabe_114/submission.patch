+// Dirs returns the unique directories containing this album's media files.
+func (a Album) Dirs(mfs MediaFiles) []string {
+	var albumFiles MediaFiles
+	for _, mf := range mfs {
+		if mf.AlbumID == a.ID {
+			albumFiles = append(albumFiles, mf)
+		}
+	}
+	dirs := albumFiles.Dirs()
+	for i := range dirs {
+		dirs[i] = filepath.Clean(dirs[i])
+	}
+	return dirs
+}
