+interface IAdminActionLock {
+    pending: boolean;
+    begin(): boolean;
+    finish(): void;
+}
+
+const useAdminActionLock = (sharedLock?: IAdminActionLock): [boolean, () => boolean, () => void] => {
+    const [localPending, setLocalPending] = useState(false);
+    const localLock = useRef(false);
+    const begin = (): boolean => {
+        if (sharedLock) return sharedLock.begin();
+        if (localLock.current) return false;
+        localLock.current = true;
+        setLocalPending(true);
+        return true;
+    };
+    const finish = (): void => {
+        if (sharedLock) {
+            sharedLock.finish();
+        } else {
+            localLock.current = false;
+            setLocalPending(false);
+        }
+    };
+    return [sharedLock?.pending ?? localPending, begin, finish];
+};
