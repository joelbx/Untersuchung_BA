@@ -62,3 +62,46 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_add_both_directions(self):
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[dict(rt='65000:1000')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc', 'address-family ipv4 unicast',
+                                               'route-target import 65000:1000',
+                                               'route-target export 65000:1000'])
+
+    def test_route_targets_mixed_and_idempotent(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 65000:1000\n'
+                                        '    route-target export 65000:1000\n'
+                                        '    route-target export 65000:2000\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='65000:1000', direction='both', state='absent'),
+            dict(rt='65000:2000', direction='export', state='absent'),
+            dict(rt='65000:3000', direction='import'),
+        ]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc', 'no route-target import 65000:1000',
+                                               'no route-target export 65000:1000',
+                                               'no route-target export 65000:2000',
+                                               'route-target import 65000:3000'])
+
+    def test_route_targets_already_configured(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 65000:1000\n'
+                                        '    route-target export 65000:1000\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[dict(rt='65000:1000')]))
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_absent_af_ignores_route_targets(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 65000:1000\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='absent',
+                             route_targets=[dict(rt='65000:1000', state='absent')],
+                             route_target_both_auto_evpn=False))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], ['vrf context ntc', 'no address-family ipv4 unicast'])
