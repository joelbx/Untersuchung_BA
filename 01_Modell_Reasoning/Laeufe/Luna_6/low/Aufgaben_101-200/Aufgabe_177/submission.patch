diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..e8aa626
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,30 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chat settings to chat allow lists',
+	timestamp: Date.UTC(2025, 9, 1),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settings = await db.getObjects(uids.map(uid => `user:${uid}:settings`));
+			const allowLists = await db.getSortedSetsMembers(uids.map(uid => `following:${uid}`));
+			const writes = [];
+			settings.forEach((userSettings, index) => {
+				if (userSettings && parseInt(userSettings.restrictChat, 10) === 1) {
+					writes.push([`user:${uids[index]}:settings`, {
+						chatAllowList: JSON.stringify((allowLists[index] || []).map(String)),
+					}]);
+				}
+			});
+			if (writes.length) {
+				await db.setObjectBulk(writes);
+			}
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
