+def widened_hostnames(hostname: Optional[str]) -> Iterable[str]:
+    """Yield a hostname and each successive parent domain."""
+    while hostname:
+        yield hostname
+        dot = hostname.find('.')
+        if dot == -1:
+            break
+        hostname = hostname[dot + 1:]
+
