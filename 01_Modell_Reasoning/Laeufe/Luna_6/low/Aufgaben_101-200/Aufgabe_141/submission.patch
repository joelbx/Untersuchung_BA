diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..6855d09
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,30 @@
+package wordpress
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactives(t *testing.T) {
+	packages := models.WordPressPackages{
+		{Name: "core", Type: models.WPCore},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+	}
+
+	got := removeInactives(packages)
+	if len(got) != 2 || got[0].Name != "core" || got[1].Name != "active-plugin" {
+		t.Fatalf("removeInactives() = %#v, want core and active-plugin", got)
+	}
+}
+
+func TestRemoveInactivesReturnsNilWhenEmpty(t *testing.T) {
+	got := removeInactives(models.WordPressPackages{
+		{Name: "inactive-plugin", Status: models.Inactive},
+	})
+	if got != nil {
+		t.Fatalf("removeInactives() = %#v, want nil", got)
+	}
+}
