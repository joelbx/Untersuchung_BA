 }
 
+// HasReachablePort reports whether any affected process has a reachable port.
+func (p Package) HasReachablePort() bool { return p.HasPortScanSuccessOn() }
+
+// HasReachablePort reports whether a PortStat matches any listening endpoint.
+func (p PortStat) HasReachablePort(listenIPPorts []string) []string {
+	addrs := []string{}
+	if p.BindAddress == "" || p.Port == "" {
+		return addrs
+	}
+	for _, ipPort := range listenIPPorts {
+		stat, err := NewPortStat(ipPort)
+		if err != nil {
+			continue
+		}
+		if p.Port == stat.Port && (p.BindAddress == "*" || p.BindAddress == stat.BindAddress) {
+			addrs = append(addrs, stat.BindAddress)
+		}
+	}
+	return addrs
+}
+
