 // AffectedProcess keep a processes information affected by software update
 type AffectedProcess struct {
-	PID         string       `json:"pid,omitempty"`
-	Name        string       `json:"name,omitempty"`
-	ListenPorts []ListenPort `json:"listenPorts,omitempty"`
+	PID             string     `json:"pid,omitempty"`
+	Name            string     `json:"name,omitempty"`
+	ListenPorts     []string   `json:"listenPorts,omitempty"`
+	ListenPortStats []PortStat `json:"listenPortStats,omitempty"`
+}
+
+// PortStat is the structured representation of a listening port.
+type PortStat struct {
+	BindAddress     string   `json:"bindAddress"`
+	Port            string   `json:"port"`
+	PortReachableTo []string `json:"portReachableTo,omitempty"`
+}
+
+// NewPortStats converts legacy scanner port values to structured stats.
+func NewPortStats(ports []ListenPort) []PortStat {
+	stats := make([]PortStat, 0, len(ports))
+	for _, port := range ports {
+		stats = append(stats, PortStat{BindAddress: port.Address, Port: port.Port})
+	}
+	return stats
+}
+
+// NewPortStat parses an ip:port value. Empty input represents an empty stat.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	address, port, err := net.SplitHostPort(ipPort)
+	if err != nil || address == "" || port == "" {
+		return nil, fmt.Errorf("invalid ip:port %q", ipPort)
+	}
+	if address != "*" && net.ParseIP(address) == nil {
+		return nil, fmt.Errorf("invalid IP address in %q", ipPort)
+	}
+	stat.BindAddress, stat.Port = address, port
+	return stat, nil
 }
 
