diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..d596834
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,105 @@
+package oci
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source implements a filesystem snapshot source backed by an OCI artifact.
+type Source struct {
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+	logger   *zap.Logger
+	interval time.Duration
+	store    *fliptoci.Store
+}
+
+// NewSource constructs an OCI snapshot source.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.logger == nil {
+		s.logger = zap.NewNop()
+	}
+	if s.store == nil {
+		return nil, errors.New("oci store must be provided")
+	}
+	if s.interval <= 0 {
+		return nil, errors.New("poll interval must be greater than zero")
+	}
+	return s, nil
+}
+
+// WithPollInterval configures how often the OCI source is checked for updates.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+func (s *Source) String() string { return "oci" }
+
+// Get returns a snapshot for the current manifest, reusing it when unchanged.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	resp, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	if resp.Matched && s.snapshot != nil {
+		s.logger.Debug("OCI snapshot unchanged", zap.String("digest", s.digest.String()))
+		return s.snapshot, nil
+	}
+	snapshot, err := storagefs.SnapshotFromFiles(resp.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	s.snapshot, s.digest = snapshot, resp.Digest
+	s.logger.Debug("updated OCI snapshot", zap.String("digest", resp.Digest.String()))
+	return snapshot, nil
+}
+
+// Subscribe sends snapshots only when the manifest digest changes.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			previous := s.currentDigest()
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				s.logger.Error("failed polling OCI snapshot", zap.Error(err))
+				continue
+			}
+			if s.currentDigest() == previous {
+				continue
+			}
+			select {
+			case ch <- snapshot:
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
+
+func (s *Source) currentDigest() digest.Digest {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.digest
+}
