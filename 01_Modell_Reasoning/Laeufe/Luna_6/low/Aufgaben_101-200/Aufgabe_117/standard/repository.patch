 from qutebrowser.config import config
@@ -34,6 +35,44 @@ _DISABLE_FEATURES = '--disable-features='
 _BLINK_SETTINGS = '--blink-settings='
 
 
+def _get_locale_pak_path(locales_dir: str, locale: str) -> pathlib.Path:
+    """Return the expected Chromium locale resource file path."""
+    return pathlib.Path(locales_dir) / (locale + '.pak')
+
+
+def _get_lang_override(versions: version.WebEngineVersions, locale: str) -> Optional[str]:
+    """Return an available fallback locale for the affected QtWebEngine."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+    from PyQt5.QtCore import QLibraryInfo
+    locales_dir = pathlib.Path(QLibraryInfo.location(QLibraryInfo.DataPath)) / 'qtwebengine_locales'
+    normalized = locale.replace('_', '-').split('.')[0]
+    if _get_locale_pak_path(str(locales_dir), normalized).exists():
+        return None
+    language = normalized.split('-')[0].lower()
+    en_gb = {'en-GB', 'en-AU', 'en-CA', 'en-IE', 'en-IN', 'en-NZ', 'en-ZA', 'en-ZW'}
+    if normalized in en_gb:
+        alternative = 'en-GB'
+    elif language == 'en':
+        alternative = 'en-US'
+    elif language == 'es':
+        alternative = 'es-419'
+    elif language == 'pt':
+        alternative = 'pt-BR'
+    elif normalized in {'zh-HK', 'zh-MO'}:
+        alternative = 'zh-TW'
+    elif language == 'zh':
+        alternative = 'zh-CN'
+    else:
+        alternative = 'en-US'
+    if _get_locale_pak_path(str(locales_dir), alternative).exists():
+        return alternative
+    if _get_locale_pak_path(str(locales_dir), language).exists():
+        return language
+    return 'en-US'
+
+
 def qt_args(namespace: argparse.Namespace) -> List[str]:
