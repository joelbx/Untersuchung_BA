     versions = version.qtwebengine_versions(avoid_init=True)
+    locale = config.val.languages[0] if config.val.languages else 'en-US'
+    lang_override = _get_lang_override(versions, locale)
+    if lang_override:
+        yield '--lang=' + lang_override
 
