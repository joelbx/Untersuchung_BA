+func Test_getAmazonLinuxVersion(t *testing.T) {
+	tests := []struct {
+		release string
+		want    string
+	}{
+		{"2018.03", "1"},
+		{"1", "1"},
+		{"2 (Karoo)", "2"},
+		{"2022 (Amazon Linux)", "2022"},
+		{"2023 (Amazon Linux)", "2023"},
+		{"2025", "2025"},
+		{"2027", "2027"},
+		{"2029", "2029"},
+		{"2024 (Amazon Linux)", "unknown"},
+		{"", "unknown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.want {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.want)
+			}
+		})
+	}
+}
