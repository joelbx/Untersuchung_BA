+// ReadTeleportProxyHello consumes the optional Teleport proxy metadata header.
+// It leaves any following SSH bytes buffered for the SSH server.
+func (c *Conn) ReadTeleportProxyHello() error {
+	prefix := []byte(sshutils.ProxyHelloSignature)
+	peeked, err := c.reader.Peek(len(prefix))
+	if err != nil || !bytes.Equal(peeked, prefix) {
+		return nil
+	}
+	header, err := c.reader.ReadBytes(0)
+	if err != nil {
+		return trace.Wrap(err, "failed to read Teleport proxy hello")
+	}
+	var payload sshutils.HandshakePayload
+	if err := json.Unmarshal(header[len(prefix):len(header)-1], &payload); err != nil {
+		return trace.Wrap(err, "failed to parse Teleport proxy hello")
+	}
+	if payload.ClientAddr != "" {
+		addr, err := utils.ParseAddr(payload.ClientAddr)
+		if err == nil {
+			if addr.AddrNetwork == "tcp" {
+				c.clientAddr = &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}
+			} else {
+				c.clientAddr = addr
+			}
+		}
+	}
+	return nil
+}
