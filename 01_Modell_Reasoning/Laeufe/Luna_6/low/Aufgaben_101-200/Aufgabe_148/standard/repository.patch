+func TestTeleportProxyHello(t *testing.T) {
+	client, server := net.Pipe()
+	wantAddr := "192.0.2.10:3022"
+	go func() {
+		_, _ = fmt.Fprintf(server, "%s{\"clientAddr\":%q}\x00SSH-2.0-test\r\n", apisshutils.ProxyHelloSignature, wantAddr)
+	}()
+
+	conn, err := detect(client, false)
+	require.NoError(t, err)
+	require.Equal(t, ProtoSSH, conn.Protocol())
+	require.NoError(t, conn.ReadTeleportProxyHello())
+	require.Equal(t, wantAddr, conn.RemoteAddr().String())
+
+	version := make([]byte, len("SSH-2.0-test\r\n"))
+	_, err = io.ReadFull(conn, version)
+	require.NoError(t, err)
+	require.Equal(t, "SSH-2.0-test\r\n", string(version))
+	_ = conn.Close()
+	_ = server.Close()
+}
