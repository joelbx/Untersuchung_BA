+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useRef, useState } from "react";
+
+import { aboveLeftOf } from "../../structures/ContextMenu";
+import { ContextMenuButton } from "../../../accessibility/context_menu/ContextMenuButton";
+import AccessibleButton from "../elements/AccessibleButton";
+import IconizedContextMenu from "./IconizedContextMenu";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "children" | "onClick"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...buttonProps }) => {
+    const [open, setOpen] = useState(false);
+    const buttonRef = useRef<HTMLElement>(null);
+    const [position, setPosition] = useState<{ top?: number, bottom?: number, right?: number }>({});
+
+    const close = () => setOpen(false);
+    const toggle = () => {
+        if (disabled) return;
+        if (!open && buttonRef.current) setPosition(aboveLeftOf(buttonRef.current.getBoundingClientRect()));
+        setOpen(!open);
+    };
+
+    return <>
+        <ContextMenuButton
+            {...buttonProps}
+            inputRef={buttonRef}
+            className={`mx_KebabContextMenu ${buttonProps.className || ""}`}
+            data-testid={buttonProps["data-testid"]}
+            label={title}
+            disabled={disabled}
+            isExpanded={open}
+            onClick={toggle}
+        >
+            <span className="mx_KebabContextMenu_icon" />
+        </ContextMenuButton>
+        { open && <IconizedContextMenu
+            {...position}
+            rightAligned
+            chevronFace={undefined}
+            hasBackground
+            compact
+            onFinished={close}
+            className="mx_KebabContextMenu_menu"
+        >
+            { options.map((option, index) => <div key={index} onClick={close}>{ option }</div>) }
+        </IconizedContextMenu> }
+    </>;
+};
+
+export default KebabContextMenu;
