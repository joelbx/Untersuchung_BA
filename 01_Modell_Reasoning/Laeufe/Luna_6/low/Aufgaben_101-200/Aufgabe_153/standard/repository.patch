index 0000000..97bcab1
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/invitations.store.test.ts
@@ -0,0 +1,26 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import { useInvitationsStore } from './invitations.store';
+
+describe('useInvitationsStore', () => {
+    beforeEach(() => {
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('keeps internal and external invitations isolated by share', () => {
+        const invitation = { invitationId: 'invite-a' } as any;
+        const externalInvitation = { externalInvitationId: 'external-a' } as any;
+        const otherInvitation = { invitationId: 'invite-b' } as any;
+        const store = useInvitationsStore.getState();
+
+        store.setInvitations('share-a', [invitation]);
+        store.setExternalInvitations('share-a', [externalInvitation]);
+        store.setInvitations('share-b', [otherInvitation]);
+        store.removeInvitations('share-a', []);
+
+        expect(useInvitationsStore.getState().getInvitations('share-a')).toEqual([]);
+        expect(useInvitationsStore.getState().getInvitations('share-b')).toEqual([otherInvitation]);
+        expect(useInvitationsStore.getState().getExternalInvitations('share-a')).toEqual([externalInvitation]);
+        expect(useInvitationsStore.getState().getExternalInvitations('missing')).toEqual([]);
+    });
+});
