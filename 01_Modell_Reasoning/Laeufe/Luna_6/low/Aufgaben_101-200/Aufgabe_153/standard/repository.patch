--- /dev/null
+++ b/applications/drive/src/app/zustand/share/members.store.test.ts
@@ -0,0 +1,23 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import { useMembersStore } from './members.store';
+
+describe('useMembersStore', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+    });
+
+    it('replaces members for one share without affecting other shares', () => {
+        const memberA = { memberId: 'member-a' } as any;
+        const memberB = { memberId: 'member-b' } as any;
+        const store = useMembersStore.getState();
+
+        store.setMembers('share-a', [memberA]);
+        store.setMembers('share-b', [memberB]);
+        store.setMembers('share-a', []);
+
+        expect(useMembersStore.getState().getMembers('share-a')).toEqual([]);
+        expect(useMembersStore.getState().getMembers('share-b')).toEqual([memberB]);
+        expect(useMembersStore.getState().getMembers('missing')).toEqual([]);
+    });
+});
