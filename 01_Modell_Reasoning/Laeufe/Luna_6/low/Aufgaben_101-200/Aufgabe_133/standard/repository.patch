+// NewDowngradedOSSAdminRole creates a restricted admin role for OSS users
+// migrating from the implicit admin role.
+func NewDowngradedOSSAdminRole() Role {
+	role := NewOSSUserRole()
+	r := role.(*RoleV3)
+	r.Metadata.Name = teleport.AdminRoleName
+	r.Metadata.Labels = map[string]string{teleport.OSSMigratedV6: types.True}
+	return r
+}
