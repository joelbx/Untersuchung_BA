+            {'name': 'A. Author'},
+            {'name': 'B. Author', 'birth_date': '1900'},
+            {'name': 'C. Author', 'death_date': '1980'},
+            {'name': 'D. Author', 'date': '18th century'},
+        ],
+    }
+    expanded = expand_record(rec)
+    assert [author['db_name'] for author in expanded['authors']] == [
+        'A. Author',
+        'B. Author 1900-',
+        'C. Author -1980',
+        'D. Author 18th century',
+    ]
+
+    assert add_db_name({}) is None
+    assert add_db_name({'authors': None}) is None
