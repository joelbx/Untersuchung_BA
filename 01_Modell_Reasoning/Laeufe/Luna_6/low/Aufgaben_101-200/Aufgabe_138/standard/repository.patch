+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		version oras.PackManifestVersion
+		media   string
+	}{
+		{version: oras.PackManifestVersion1_0, media: v1.MediaTypeImageManifest},
+		{version: oras.PackManifestVersion1_1, media: v1.MediaTypeImageManifest},
+	} {
+		t.Run(fmt.Sprint(tc.version), func(t *testing.T) {
+			ctx := context.Background()
+			dir := testRepository(t)
+			ref, err := ParseReference(fmt.Sprintf("flipt://local/%s:latest", repo))
+			require.NoError(t, err)
+			store, err := NewStore(zaptest.NewLogger(t), dir, WithManifestVersion(tc.version))
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			bundle, err := store.Build(ctx, src, ref)
+			require.NoError(t, err)
+			target, err := oci.New(path.Join(dir, repo))
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			assert.Equal(t, tc.media, desc.MediaType)
+			assert.NotEmpty(t, bundle.Digest)
+		})
+	}
+}
