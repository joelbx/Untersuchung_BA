+
+func connectionURL(d config.DatabaseConfig) (string, error) {
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	protocol := d.Protocol
+	if protocol < config.DatabaseProtocolSQLite || protocol > config.DatabaseProtocolMySQL {
+		return "", fmt.Errorf("invalid db.protocol %q: expected one of sqlite, postgres, mysql", protocol.String())
+	}
+	switch protocol {
+	case config.DatabaseProtocolSQLite:
+		if d.Name == "" {
+			return "", fmt.Errorf("db.name (SQLite database path) is required")
+		}
+		if strings.HasPrefix(d.Name, "file:") {
+			return d.Name, nil
+		}
+		return "file:" + d.Name, nil
+	case config.DatabaseProtocolPostgres:
+		if d.Name == "" {
+			return "", fmt.Errorf("db.name is required")
+		}
+		if d.Host == "" {
+			return "", fmt.Errorf("db.host is required")
+		}
+		port := d.Port
+		if port == 0 {
+			port = 5432
+		}
+		u := &url.URL{Scheme: "postgres", Host: fmt.Sprintf("%s:%d", d.Host, port), Path: "/" + d.Name}
+		if d.User != "" {
+			if d.Password != "" {
+				u.User = url.UserPassword(d.User, d.Password)
+			} else {
+				u.User = url.User(d.User)
+			}
+		}
+		return u.String(), nil
+	case config.DatabaseProtocolMySQL:
+		if d.Name == "" {
+			return "", fmt.Errorf("db.name is required")
+		}
+		if d.Host == "" {
+			return "", fmt.Errorf("db.host is required")
+		}
+		port := d.Port
+		if port == 0 {
+			port = 3306
+		}
+		u := &url.URL{Scheme: "mysql", Host: fmt.Sprintf("%s:%d", d.Host, port), Path: "/" + d.Name}
+		if d.User != "" {
+			if d.Password != "" {
+				u.User = url.UserPassword(d.User, d.Password)
+			} else {
+				u.User = url.User(d.User)
+			}
+		}
+		return u.String(), nil
+	}
+	return "", fmt.Errorf("invalid db.protocol: expected one of sqlite, postgres, mysql")
+}
