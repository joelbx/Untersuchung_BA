+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolSQLite DatabaseProtocol = iota + 1
+	DatabaseProtocolPostgres
+	DatabaseProtocolMySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	return map[DatabaseProtocol]string{DatabaseProtocolSQLite: "sqlite", DatabaseProtocolPostgres: "postgres", DatabaseProtocolMySQL: "mysql"}[p]
+}
+
+func ParseDatabaseProtocol(value string) (DatabaseProtocol, error) {
+	switch strings.ToLower(value) {
+	case "sqlite", "sqlite3":
+		return DatabaseProtocolSQLite, nil
+	case "postgres", "postgresql":
+		return DatabaseProtocolPostgres, nil
+	case "mysql":
+		return DatabaseProtocolMySQL, nil
+	default:
+		return 0, fmt.Errorf("invalid db.protocol %q: expected one of sqlite, postgres, mysql", value)
+	}
 }
 
