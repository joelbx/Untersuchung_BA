+
+func TestBillingModeDefaultsAndValidation(t *testing.T) {
+	cfg := Config{TableName: tableName}
+	if err := cfg.CheckAndSetDefaults(); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.BillingMode != dynamodb.BillingModePayPerRequest {
+		t.Fatalf("expected default billing mode %q, got %q", dynamodb.BillingModePayPerRequest, cfg.BillingMode)
+	}
+
+	for _, mode := range []string{dynamodb.BillingModePayPerRequest, dynamodb.BillingModeProvisioned} {
+		cfg := Config{TableName: tableName, BillingMode: mode}
+		if err := cfg.CheckAndSetDefaults(); err != nil {
+			t.Errorf("billing mode %q rejected: %v", mode, err)
+		}
+	}
+	cfg = Config{TableName: tableName, BillingMode: "invalid"}
+	if err := cfg.CheckAndSetDefaults(); err == nil {
+		t.Fatal("expected invalid billing mode to be rejected")
+	}
+}
