+class Cover(dict):
+    """Cover metadata and archive.org addressing helpers."""
+
+    def __init__(self, attributes=None, **kwargs):
+        super().__init__(attributes or {}, **kwargs)
+        self.__dict__ = self
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        identifier = f'{int(cover_id):010d}'
+        return identifier[:4], identifier[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        size = size.lower()
+        prefix = f'{size}_' if size else ''
+        suffix = f'-{size.upper()}' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        archive = f'{item}_{batch_id}.zip'
+        filename = f'{int(cover_id):010d}{suffix}.{ext.lstrip(".")}'
+        return f'{protocol}://archive.org/download/{item}/{archive}/{filename}'
+
+
+class Batch:
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id, self.size = item_id, batch_id, size
+
+    def _norm_ids(self):
+        return f'{int(self.item_id):04d}', f'{int(self.batch_id):02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = f'{int(item_id):04d}', f'{int(batch_id):02d}'
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        return os.path.join('items', item, f'{item}_{batch_id}.{ext.lstrip(".")}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        uploader = uploader or Uploader
+        sizes = (self.size,) if self.size is not None else SIZES
+        item_id, batch_id = self._norm_ids()
+        for size in sizes:
+            path = self.get_abspath(item_id, batch_id, size)
+            if not os.path.isfile(path):
+                continue
+            item = f'{size + "_" if size else ""}covers_{item_id}'
+            filename = os.path.basename(path)
+            if upload and not uploader.is_uploaded(item, filename):
+                uploader.upload(item, [path])
+            if finalize and uploader.is_uploaded(item, filename):
+                CoverDB.update_completed_batch(int(item_id), int(batch_id))
 
 
