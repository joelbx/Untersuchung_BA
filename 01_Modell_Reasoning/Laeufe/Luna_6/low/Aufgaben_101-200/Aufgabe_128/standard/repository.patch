diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..8e8a7f5 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -17,6 +17,35 @@ def get_iptables_version(iptables_path, module):
 
 class TestIptables(ModuleTestCase):
 
+    def test_match_set_rule(self):
+        for matches in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT', 'protocol': 'tcp', 'destination_port': '22',
+                'jump': 'ACCEPT', 'match': matches, 'match_set': 'admin_hosts',
+                'match_set_flags': 'src',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.side_effect = [(1, '', ''), (0, '', '')]
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            rule = run_command.call_args_list[0][0][0]
+            self.assertEqual(rule[5:], [
+                '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', 'src',
+                '-j', 'ACCEPT', '--destination-port', '22',
+            ])
+
+    def test_match_set_inversion(self):
+        set_module_args({
+            'chain': 'INPUT', 'match_set': '!admin_hosts', 'match_set_flags': 'dst,src',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertIn(['!', '--match-set', 'admin_hosts', 'dst,src'],
+                      [run_command.call_args_list[0][0][0][i:i + 4]
+                       for i in range(len(run_command.call_args_list[0][0][0]) - 3)])
+
     def setUp(self):
         super(TestIptables, self).setUp()
         self.mock_get_bin_path = patch.object(basic.AnsibleModule, 'get_bin_path', get_bin_path)
