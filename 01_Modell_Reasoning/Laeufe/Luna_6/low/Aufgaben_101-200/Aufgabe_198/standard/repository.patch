+func affectedResolutionStates(def ovalmodels.Definition) []string {
+	b, err := json.Marshal(def)
+	if err != nil {
+		return nil
+	}
+	var raw struct {
+		Advisory struct {
+			AffectedResolution []struct {
+				State string `json:"State"`
+			} `json:"AffectedResolution"`
+		} `json:"Advisory"`
+	}
+	if err := json.Unmarshal(b, &raw); err != nil {
+		return nil
+	}
+	states := make([]string, 0, len(raw.Advisory.AffectedResolution))
+	for _, resolution := range raw.Advisory.AffectedResolution {
+		states = append(states, resolution.State)
+	}
+	return states
