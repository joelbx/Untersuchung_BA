+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() { rootCmd.AddCommand(backupCmd) }
+
+var backupCmd = &cobra.Command{Use: "backup", Short: "Manage database backups"}
+var backupForce bool
+var backupFile string
+
+func init() {
+	create := &cobra.Command{Use: "create", Short: "Create a database backup", RunE: func(cmd *cobra.Command, args []string) error {
+		defer db.Init()()
+		p, err := db.Db().Backup(cmd.Context())
+		if err == nil {
+			fmt.Fprintln(cmd.OutOrStdout(), p)
+		}
+		return err
+	}}
+	pruneCmd := &cobra.Command{Use: "prune", Short: "Remove old database backups", RunE: func(cmd *cobra.Command, args []string) error {
+		if conf.Server.Backup.Count == 0 && !backupForce && !confirm(cmd, "This will delete all database backups. Continue? [y/N] ") {
+			return nil
+		}
+		defer db.Init()()
+		n, err := db.Db().Prune(cmd.Context())
+		if err == nil {
+			fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backup(s)\n", n)
+		}
+		return err
+	}}
+	restore := &cobra.Command{Use: "restore", Short: "Restore database from a backup", RunE: func(cmd *cobra.Command, args []string) error {
+		if backupFile == "" {
+			return fmt.Errorf("--backup-file is required")
+		}
+		if !backupForce && !confirm(cmd, "This will replace the current database. Continue? [y/N] ") {
+			return nil
+		}
+		defer db.Init()()
+		return db.Db().Restore(cmd.Context(), backupFile)
+	}}
+	pruneCmd.Flags().BoolVar(&backupForce, "force", false, "skip confirmation")
+	restore.Flags().BoolVar(&backupForce, "force", false, "skip confirmation")
+	restore.Flags().StringVar(&backupFile, "backup-file", "", "backup database file to restore")
+	backupCmd.AddCommand(create, pruneCmd, restore)
+}
+
+func confirm(cmd *cobra.Command, prompt string) bool {
+	fmt.Fprint(cmd.OutOrStdout(), prompt)
+	line, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	return err == nil && (strings.EqualFold(strings.TrimSpace(line), "y") || strings.EqualFold(strings.TrimSpace(line), "yes"))
+}
