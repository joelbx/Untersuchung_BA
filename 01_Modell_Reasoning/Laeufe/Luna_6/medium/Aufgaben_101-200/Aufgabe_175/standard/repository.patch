+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		b := conf.Server.Backup
+		if b.Path == "" || b.Schedule == "" || b.Count == 0 {
+			log.Info("Periodic backup is DISABLED")
+			return nil
+		}
+		log.Info("Scheduling periodic database backup", "schedule", b.Schedule)
+		return scheduler.GetInstance().Add(b.Schedule, func() {
+			if _, err := db.Db().Backup(ctx); err != nil {
+				log.Error("Error creating scheduled database backup", err)
+				return
+			}
+			if _, err := db.Db().Prune(ctx); err != nil {
+				log.Error("Error pruning scheduled database backups", err)
+			}
+		})
+	}
+}
