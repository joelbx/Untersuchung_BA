diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..5b9069a
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,203 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupSuffix = ".db"
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", fmt.Errorf("backup.path is not configured")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, os.ModePerm); err != nil {
+		return "", err
+	}
+	name := backupPrefix + time.Now().UTC().Format("20060102T150405.000000000Z") + backupSuffix
+	dst := filepath.Join(conf.Server.Backup.Path, name)
+	dest, err := sql.Open(Driver, dst)
+	if err != nil {
+		return "", err
+	}
+	defer dest.Close()
+	dstConn, err := dest.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer dstConn.Close()
+	srcConn, err := d.readDB.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer srcConn.Close()
+	err = func() error {
+		var sourceErr error
+		err := dstConn.Raw(func(dc interface{}) error {
+			dstSQLite, ok := dc.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected SQLite connection %T", dc)
+			}
+			return srcConn.Raw(func(sc interface{}) error {
+				srcSQLite, ok := sc.(*sqlite3.SQLiteConn)
+				if !ok {
+					return fmt.Errorf("unexpected SQLite connection %T", sc)
+				}
+				b, e := dstSQLite.Backup("main", srcSQLite, "main")
+				if e != nil {
+					return e
+				}
+				defer b.Finish()
+				for {
+					done, e := b.Step(128)
+					if e != nil {
+						return e
+					}
+					if done {
+						return nil
+					}
+					select {
+					case <-ctx.Done():
+						return ctx.Err()
+					case <-time.After(10 * time.Millisecond):
+					}
+				}
+			})
+		})
+		sourceErr = err
+		return sourceErr
+	}()
+	if err != nil {
+		_ = os.Remove(dst)
+		return "", err
+	}
+	return dst, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return fmt.Errorf("backup file path is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if info.IsDir() {
+		return fmt.Errorf("backup file is a directory: %s", path)
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	backupURL := url.URL{Scheme: "file", Path: filepath.ToSlash(absPath)}
+	query := backupURL.Query()
+	query.Set("mode", "ro")
+	backupURL.RawQuery = query.Encode()
+	src, err := sql.Open(Driver, backupURL.String())
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	dstConn, err := d.writeDB.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dstConn.Close()
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	var check string
+	if err := srcConn.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&check); err != nil {
+		return err
+	}
+	if check != "ok" {
+		return fmt.Errorf("invalid SQLite backup: %s", check)
+	}
+	return func() error {
+		return dstConn.Raw(func(dc interface{}) error {
+			dstSQLite, ok := dc.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected SQLite connection %T", dc)
+			}
+			return srcConn.Raw(func(sc interface{}) error {
+				srcSQLite, ok := sc.(*sqlite3.SQLiteConn)
+				if !ok {
+					return fmt.Errorf("unexpected SQLite connection %T", sc)
+				}
+				b, err := dstSQLite.Backup("main", srcSQLite, "main")
+				if err != nil {
+					return err
+				}
+				defer b.Finish()
+				for {
+					done, err := b.Step(128)
+					if err != nil {
+						return err
+					}
+					if done {
+						return nil
+					}
+					select {
+					case <-ctx.Done():
+						return ctx.Err()
+					case <-time.After(10 * time.Millisecond):
+					}
+				}
+			})
+		})
+	}()
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	path := conf.Server.Backup.Path
+	if path == "" {
+		return 0, nil
+	}
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return 0, nil
+		}
+		return 0, err
+	}
+	files := make([]string, 0)
+	for _, e := range entries {
+		if !e.IsDir() && strings.HasPrefix(e.Name(), backupPrefix) && strings.HasSuffix(e.Name(), backupSuffix) {
+			files = append(files, e.Name())
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	count := max(conf.Server.Backup.Count, 0)
+	remove := len(files) - count
+	if remove < 0 {
+		remove = 0
+	}
+	deleted := 0
+	for _, name := range files[:remove] {
+		select {
+		case <-ctx.Done():
+			return deleted, ctx.Err()
+		default:
+		}
+		if err := os.Remove(filepath.Join(path, name)); err != nil {
+			return deleted, err
+		}
+		deleted++
+	}
+	return deleted, nil
+}
