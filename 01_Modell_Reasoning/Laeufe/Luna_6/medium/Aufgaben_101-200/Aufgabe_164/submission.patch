+// Exported JSON files may include a single comment header. JSON itself does
+// not support comments, so consume only that first line when it begins with '#'.
+func stripJSONHeader(r io.Reader) io.Reader {
+	br := bufio.NewReader(r)
+	line, err := br.Peek(1)
+	if err == nil && len(line) == 1 && line[0] == '#' {
+		_, _ = br.ReadString('\n')
+	}
+	return br
+}
