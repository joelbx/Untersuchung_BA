+    const { avatar, text, onClick, resourceId, type: resolvedType } = usePermalink({ type, url, room });
+    const [hover, setHover] = useState(false);
+
+    if (!resolvedType || text === null) return null;
+
+    const classes = classNames("mx_Pill", {
+        mx_UserPill: resolvedType === PillType.UserMention,
+        mx_RoomPill: resolvedType === PillType.RoomMention,
+        mx_AtRoomPill: resolvedType === PillType.AtRoomMention,
+        mx_SpacePill: resolvedType === "space",
+        mx_UserPill_me: resolvedType === PillType.UserMention && resourceId === MatrixClientPeg.get().getUserId(),
+    });
+    const tooltip = hover && resourceId ? <Tooltip label={resourceId} alignment={Alignment.Right} /> : null;
+    const content = (
+        <>
+            {shouldShowPillAvatar === true ? avatar : null}
+            <span className="mx_Pill_linkText">{text}</span>
+            {tooltip}
+        </>
+    );
+    const onMouseOver = (): void => setHover(true);
+    const onMouseLeave = (): void => setHover(false);
+
+    return (
+        <MatrixClientContext.Provider value={MatrixClientPeg.get()}>
+            <bdi>
+                {inMessage === true && url ? (
+                    <a
+                        className={classes}
+                        href={url}
+                        onClick={onClick}
+                        onMouseOver={onMouseOver}
+                        onMouseLeave={onMouseLeave}
+                    >
+                        {content}
+                    </a>
+                ) : (
+                    <span className={classes} onMouseOver={onMouseOver} onMouseLeave={onMouseLeave}>
+                        {content}
+                    </span>
+                )}
+            </bdi>
+        </MatrixClientContext.Provider>
+    );
