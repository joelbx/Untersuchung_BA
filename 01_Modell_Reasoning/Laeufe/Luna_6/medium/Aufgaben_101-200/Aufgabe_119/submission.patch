+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useState } from "react";
+import { Room } from "matrix-js-sdk/src/models/room";
+import { RoomMember } from "matrix-js-sdk/src/models/room-member";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { MatrixClientPeg } from "../MatrixClientPeg";
+import { parsePermalink, getPrimaryPermalinkEntity } from "../utils/permalinks/Permalinks";
+import { PillType } from "../components/views/elements/Pill";
+import RoomAvatar from "../components/views/avatars/RoomAvatar";
+import MemberAvatar from "../components/views/avatars/MemberAvatar";
+import dis from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+import { ButtonEvent } from "../components/views/elements/AccessibleButton";
+
+export interface UsePermalinkArgs {
+    room?: Room;
+    type?: PillType;
+    url?: string;
+}
+
+export interface UsePermalinkResult {
+    avatar: React.ReactElement | null;
+    text: string | null;
+    onClick: ((e: ButtonEvent) => void) | null;
+    resourceId: string | null;
+    type: PillType | "space" | null;
+}
+
+export function usePermalink({ room: contextRoom, type: explicitType, url }: UsePermalinkArgs): UsePermalinkResult {
+    let resourceId: string = null;
+    let sigil: string = null;
+    if (url) {
+        if (url.startsWith("http")) {
+            const parts = parsePermalink(url);
+            resourceId = parts?.primaryEntityId ?? null;
+            sigil = parts?.sigil ?? null;
+        } else {
+            resourceId = getPrimaryPermalinkEntity(url) ?? null;
+            sigil = resourceId?.[0] ?? null;
+        }
+    }
+
+    const type =
+        explicitType ?? { "@": PillType.UserMention, "!": PillType.RoomMention, "#": PillType.RoomMention }[sigil];
+    const [member, setMember] = useState<RoomMember | null>(null);
+
+    useEffect(() => {
+        let active = true;
+        setMember(null);
+        if (type !== PillType.UserMention || !resourceId)
+            return () => {
+                active = false;
+            };
+
+        const localMember = contextRoom?.getMember(resourceId);
+        if (localMember) {
+            setMember(localMember);
+            return () => {
+                active = false;
+            };
+        }
+
+        const newMember = new RoomMember(null, resourceId);
+        setMember(newMember);
+        MatrixClientPeg.get()
+            .getProfileInfo(resourceId)
+            .then((profile) => {
+                if (!active) return;
+                newMember.name = profile.displayname;
+                newMember.rawDisplayName = profile.displayname;
+                newMember.events.member = {
+                    getContent: () => ({ avatar_url: profile.avatar_url }),
+                    getDirectionalContent() {
+                        return this.getContent();
+                    },
+                } as any;
+                setMember(newMember);
+            })
+            .catch((err) => logger.error("Could not retrieve profile data for " + resourceId + ":", err));
+        return () => {
+            active = false;
+        };
+    }, [contextRoom, resourceId, type]);
+
+    if (type === PillType.AtRoomMention) {
+        return {
+            avatar: contextRoom ? <RoomAvatar room={contextRoom} width={16} height={16} aria-hidden="true" /> : null,
+            text: contextRoom ? "@room" : null,
+            onClick: null,
+            resourceId: null,
+            type: contextRoom ? type : null,
+        };
+    }
+
+    if (type === PillType.UserMention && member) {
+        return {
+            avatar: <MemberAvatar member={member} width={16} height={16} aria-hidden="true" hideTitle />,
+            text: member.rawDisplayName || member.name || member.userId,
+            resourceId: member.userId,
+            type,
+            onClick: (e: ButtonEvent) => {
+                e.preventDefault();
+                dis.dispatch({ action: Action.ViewUser, member });
+            },
+        };
+    }
+
+    if (type === PillType.RoomMention && resourceId) {
+        const client = MatrixClientPeg.get();
+        const resolvedRoom = resourceId.startsWith("#")
+            ? client
+                  .getRooms()
+                  .find((r) => r.getCanonicalAlias() === resourceId || r.getAltAliases().includes(resourceId))
+            : client.getRoom(resourceId);
+        if (!resolvedRoom) return { avatar: null, text: resourceId, onClick: null, resourceId, type };
+        const isSpace = resolvedRoom.isSpaceRoom();
+        return {
+            avatar: <RoomAvatar room={resolvedRoom} width={16} height={16} aria-hidden="true" />,
+            text: resolvedRoom.name || resourceId,
+            onClick: null,
+            resourceId,
+            type: isSpace ? "space" : type,
+        };
+    }
+
+    return { avatar: null, text: null, onClick: null, resourceId: null, type: null };
+}
