+def test_parent_domain_blocking(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.whitelist = None
+    blocker = host_blocker_factory()
+    blocker._blocked_hosts = {"example.com"}
+
+    for url in ("https://example.com/path", "https://sub.example.com/path",
+                "https://a.b.example.com/path", "https://a.b.example.com./path"):
+        assert blocker._is_blocked(QUrl(url))
+
+    assert not blocker._is_blocked(QUrl("https://notexample.com/path"))
+
+
+def test_config_parent_domain_blocking(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.whitelist = None
+    blocker = host_blocker_factory()
+    blocker._config_blocked_hosts = {"example.com."}
+    assert blocker._is_blocked(QUrl("https://sub.example.com/path"))
