+def sanitize_keys(obj, no_log_strings, ignore_keys=frozenset()):
+    """Copy mappings while redacting sensitive substrings in their keys."""
+    needles = tuple(to_native(s, errors='surrogate_or_strict') for s in no_log_strings)
+    def clean_key(key):
+        text = to_native(key, errors='surrogate_or_strict') if isinstance(key, (text_type, binary_type)) else key
+        if not isinstance(text, (text_type, binary_type)) or text in ignore_keys or text.startswith('_ansible'):
+            return key
+        if any(text == needle for needle in needles):
+            return 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+        for needle in needles:
+            if needle:
+                text = text.replace(needle, '*' * 8)
+        return text
+
+    if not isinstance(obj, (Mapping, list, tuple, set, frozenset)):
+        return obj
+    root = [None]
+    stack = [('visit', obj, root, 0)]
+    while stack:
+        task = stack.pop()
+        if task[0] == 'finish':
+            _, parent, index, original, keys, slots, kind = task
+            children = [slot[0] for slot in slots]
+            if kind == 'mapping':
+                try:
+                    result = type(original)()
+                except Exception:
+                    result = {}
+                for key, child in zip(keys, children):
+                    result[clean_key(key)] = child
+            elif kind == 'tuple':
+                result = type(original)(children) if type(original) is not tuple else tuple(children)
+            elif kind == 'set':
+                result = type(original)(children)
+            else:
+                result = type(original)(children) if type(original) is not list else children
+            parent[index] = result
+            continue
+        _, item, parent, index = task
+        if isinstance(item, Mapping):
+            entries = list(item.items())
+            keys, vals = [e[0] for e in entries], [e[1] for e in entries]
+            kind = 'mapping'
+        elif isinstance(item, (list, tuple, set, frozenset)):
+            keys, vals = None, list(item)
+            kind = 'tuple' if isinstance(item, tuple) else ('set' if isinstance(item, (set, frozenset)) else 'list')
+        else:
+            parent[index] = item
+            continue
+        slots = [[None] for _ in vals]
+        stack.append(('finish', parent, index, item, keys, slots, kind))
+        for child, slot in reversed(list(zip(vals, slots))):
+            stack.append(('visit', child, slot, 0))
