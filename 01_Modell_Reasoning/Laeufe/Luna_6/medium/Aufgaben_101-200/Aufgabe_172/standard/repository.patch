 // AffectedProcess keep a processes information affected by software update
 type AffectedProcess struct {
-	PID         string       `json:"pid,omitempty"`
-	Name        string       `json:"name,omitempty"`
-	ListenPorts []ListenPort `json:"listenPorts,omitempty"`
+	PID             string     `json:"pid,omitempty"`
+	Name            string     `json:"name,omitempty"`
+	ListenPorts     []string   `json:"listenPorts,omitempty"`
+	ListenPortStats []PortStat `json:"listenPortStats,omitempty"`
+}
+
+// PortStat represents a listening port and the addresses where it is reachable.
+type PortStat struct {
+	BindAddress     string   `json:"bindAddress"`
+	Port            string   `json:"port"`
+	PortReachableTo []string `json:"portReachableTo"`
+}
+
+// NewPortStat parses an ip:port string.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	if ipPort == "" {
+		return &PortStat{}, nil
+	}
+	host, port, err := net.SplitHostPort(ipPort)
+	if err != nil || host == "" || port == "" {
+		return nil, fmt.Errorf("invalid ip:port %q", ipPort)
+	}
+	if host != "*" && net.ParseIP(host) == nil {
+		return nil, fmt.Errorf("invalid IP address %q", host)
+	}
+	return &PortStat{BindAddress: host, Port: port}, nil
+}
+
+// HasReachablePort reports whether an affected process has a reachable port.
+func (p Package) HasReachablePort() bool {
+	for _, ap := range p.AffectedProcs {
+		for _, port := range ap.ListenPortStats {
+			if len(port.PortReachableTo) > 0 {
+				return true
+			}
+		}
+	}
+	return false
 }
 
