 func detect(conn net.Conn, enableProxyProtocol bool) (*Conn, error) {
 	reader := bufio.NewReader(conn)
+	var remoteAddr net.Addr
+	const teleportProxyPrefix = "Teleport-Proxy"
+	if prefix, err := reader.Peek(len(teleportProxyPrefix)); err == nil && string(prefix) == teleportProxyPrefix {
+		_, _ = reader.Discard(len(teleportProxyPrefix))
+		// Accept the prefix followed directly by JSON, or with the optional
+		// colon and whitespace used by some Teleport-Proxy writers.
+		for {
+			b, err := reader.Peek(1)
+			if err != nil {
+				return nil, trace.Wrap(err, "failed to read Teleport-Proxy payload")
+			}
+			if b[0] == ':' || b[0] == ' ' || b[0] == '\t' {
+				_, _ = reader.Discard(1)
+				continue
+			}
+			break
+		}
+		payload, err := reader.ReadBytes(0)
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport-Proxy payload")
+		}
+		var metadata struct{ ClientAddr string }
+		if err := json.Unmarshal(payload[:len(payload)-1], &metadata); err != nil {
+			return nil, trace.Wrap(err, "failed to parse Teleport-Proxy payload")
+		}
+		if metadata.ClientAddr != "" {
+			remoteAddr = teleportProxyAddr(metadata.ClientAddr)
+		}
+	}
 
 	// the first attempt is to parse optional proxy
 	// protocol line that is injected by load balancers
