+def add_db_name(rec):
+    """Add a comparable name, including author dates when available."""
+    for author in rec.get('authors') or []:
+        name = author.get('name', '')
+        if 'date' in author:
+            date = author['date']
+        elif 'birth_date' in author or 'death_date' in author:
+            date = f"{author.get('birth_date', '')}-{author.get('death_date', '')}"
+        else:
+            date = ''
+        author['db_name'] = f'{name} {date}'.strip()
+
+
+def expand_record(rec):
+    """Return fields used by edition comparisons, without changing ``rec``."""
+    title = rec.get('title') or rec.get('full_title') or ''
+    if rec.get('title') and rec.get('subtitle'):
+        title += ' ' + rec['subtitle']
+    expanded = build_titles(title)
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        expanded['isbn'].extend([values] if isinstance(values, str) else values)
+    fields = (
+        'publish_country',
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    )
+    for field in fields:
+        if field in rec and not (field == 'publish_country' and rec[field] in ('   ', '|||')):
+            value = rec[field]
+            if field in ('authors', 'contribs'):
+                value = [dict(person) for person in value or []]
+            expanded[field] = value
+    add_db_name(expanded)
+    return expanded
+
