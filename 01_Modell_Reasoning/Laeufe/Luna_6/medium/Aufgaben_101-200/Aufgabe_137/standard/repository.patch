+func (c *TracingConfig) validate() error {
+	if math.IsNaN(c.SamplingRatio) || c.SamplingRatio < 0 || c.SamplingRatio > 1 {
+		return fmt.Errorf("sampling ratio should be a number between 0 and 1")
+	}
+
+	for _, propagator := range c.Propagators {
+		if _, ok := tracingPropagators[propagator]; !ok {
+			return fmt.Errorf("invalid propagator option: %s", propagator)
+		}
+	}
+
+	return nil
+}
+
+// TracingPropagator represents a supported trace context propagation format.
