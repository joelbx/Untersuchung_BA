+
+import React, { useState } from "react";
+
+import ContextMenu, { ChevronFace } from "../../structures/ContextMenu";
+import AccessibleButton from "../elements/AccessibleButton";
+import UIStore from "../../../stores/UIStore";
+
+type Props = Omit<React.ComponentProps<typeof AccessibleButton>, "onClick" | "children" | "title"> & {
+    options: React.ReactNode[];
+    title: string;
+};
+
+const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...buttonProps }) => {
+    const [isOpen, setIsOpen] = useState(false);
+    const [position, setPosition] = useState<{ top: number, right: number, chevronFace: ChevronFace }>();
+
+    const openMenu = (event: React.MouseEvent | React.KeyboardEvent): void => {
+        if (disabled) return;
+        const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();
+        setPosition({
+            top: rect.bottom + window.scrollY,
+            right: UIStore.instance.windowWidth - rect.right - window.scrollX,
+            chevronFace: ChevronFace.None,
+        });
+        setIsOpen(true);
+    };
+
+    return <>
+        <AccessibleButton
+            {...buttonProps}
+            className={`mx_KebabContextMenu ${buttonProps.className || ""}`}
+            title={title}
+            aria-label={title}
+            aria-haspopup="true"
+            aria-expanded={isOpen}
+            aria-disabled={disabled || undefined}
+            disabled={disabled}
+            onClick={openMenu}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </AccessibleButton>
+        { isOpen && position && <ContextMenu
+            {...position}
+            hasBackground={false}
+            onFinished={() => setIsOpen(false)}
+        >
+            <div className="mx_KebabContextMenu_menu" role="presentation">
+                { options }
+            </div>
+        </ContextMenu> }
+    </>;
+};
+
+export default KebabContextMenu;
