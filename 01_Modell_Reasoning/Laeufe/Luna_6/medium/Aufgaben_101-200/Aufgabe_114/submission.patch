+func fromDirectory(ctx context.Context, dir, pattern string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if dir == "" {
+			return nil, "", nil
+		}
+		entries, err := os.ReadDir(dir)
+		if err != nil {
+			return nil, "", err
+		}
+		for _, entry := range entries {
+			if entry.IsDir() {
+				continue
+			}
+			name := strings.ToLower(entry.Name())
+			match, err := filepath.Match(pattern, name)
+			if err != nil {
+				return nil, "", err
+			}
+			if !match {
+				continue
+			}
+			path := filepath.Join(dir, entry.Name())
+			f, err := os.Open(path)
+			if err != nil {
+				return nil, "", err
+			}
+			return f, path, nil
+		}
+		return nil, "", fmt.Errorf("pattern '%s' not found in %s", pattern, dir)
+	}
+}
