+import { EVENT_ACTIONS } from '../constants';
+import type { EventManager } from './eventManager';
+
+export const interval = 5000;
+export const maxPollingSteps = 5;
+
+type PollableEvent = Record<string, any>;
+
+/** Polls an event manager for a bounded period, optionally stopping on a matching item event. */
+export const pollEvents = (
+    eventManager: Pick<EventManager, 'call' | 'subscribe'>,
+    property?: string,
+    action?: EVENT_ACTIONS
+): Promise<void> => {
+    return new Promise((resolve, reject) => {
+        let finished = false;
+        let steps = 0;
+        let timeout: ReturnType<typeof setTimeout> | undefined;
+        let unsubscribe: (() => void) | undefined;
+        let matchedBeforeSubscribeReturned = false;
+
+        const finish = () => {
+            if (finished) {
+                return;
+            }
+            finished = true;
+            if (timeout !== undefined) {
+                clearTimeout(timeout);
+            }
+            unsubscribe?.();
+            resolve();
+        };
+
+        if (property !== undefined && action !== undefined) {
+            unsubscribe = eventManager.subscribe((event: PollableEvent) => {
+                if (finished || !Array.isArray(event?.[property])) {
+                    return;
+                }
+                const matches = event[property].some((item: PollableEvent) => item?.Action === action);
+                if (matches) {
+                    if (unsubscribe) {
+                        finish();
+                    } else {
+                        matchedBeforeSubscribeReturned = true;
+                    }
+                }
+            });
+            if (matchedBeforeSubscribeReturned) {
+                finish();
+                return;
+            }
+        }
+
+        const poll = async () => {
+            if (finished || steps >= maxPollingSteps) {
+                finish();
+                return;
+            }
+            steps += 1;
+            try {
+                await eventManager.call();
+            } catch (error) {
+                if (!finished) {
+                    finished = true;
+                    unsubscribe?.();
+                    reject(error);
+                }
+                return;
+            }
+            if (finished) {
+                return;
+            }
+            if (steps >= maxPollingSteps) {
+                finish();
+            } else {
+                timeout = setTimeout(poll, interval);
+            }
+        };
+
+        timeout = setTimeout(poll, interval);
+    });
+};
+
+export default pollEvents;
