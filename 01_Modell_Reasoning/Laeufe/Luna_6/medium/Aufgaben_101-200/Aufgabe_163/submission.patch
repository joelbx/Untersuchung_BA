+func TestDatabaseURL(t *testing.T) {
+	tests := []struct {
+		name    string
+		cfg     config.DatabaseConfig
+		want    string
+		wantErr string
+	}{
+		{name: "postgres fields", cfg: config.DatabaseConfig{Protocol: config.Postgres, Host: "db", User: "flipt", Password: "secret", Name: "app"}, want: "postgres://flipt:secret@db:5432/app"},
+		{name: "mysql fields", cfg: config.DatabaseConfig{Protocol: config.MySQL, Host: "db", Name: "app"}, want: "mysql://db:3306/app"},
+		{name: "sqlite fields", cfg: config.DatabaseConfig{Protocol: config.SQLite, Host: "/tmp/app.db", Name: "app"}, want: "file:/tmp/app.db"},
+		{name: "URL precedence", cfg: config.DatabaseConfig{URL: "file:legacy.db", Protocol: config.Postgres, Host: "ignored", Name: "ignored"}, want: "file:legacy.db"},
+		{name: "missing protocol", cfg: config.DatabaseConfig{}, wantErr: "db.protocol"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := databaseURL(tt.cfg)
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
