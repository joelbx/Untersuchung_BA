+func databaseURL(c config.DatabaseConfig) (string, error) {
+	if c.URL != "" {
+		return c.URL, nil
+	}
+	if c.Protocol == 0 {
+		return "", fmt.Errorf("db.protocol is required when db.url is not provided")
+	}
+	if c.Name == "" {
+		return "", fmt.Errorf("db.name is required when db.url is not provided")
+	}
+	switch c.Protocol {
+	case config.SQLite:
+		if c.Host == "" {
+			return "", fmt.Errorf("db.host (SQLite database path) is required when db.url is not provided")
+		}
+		return "file:" + c.Host, nil
+	case config.Postgres, config.MySQL:
+		if c.Host == "" {
+			return "", fmt.Errorf("db.host is required when db.url is not provided")
+		}
+		port := c.Port
+		if port == 0 {
+			if c.Protocol == config.Postgres {
+				port = 5432
+			} else {
+				port = 3306
+			}
+		}
+		u := &url.URL{Scheme: c.Protocol.String(), Host: c.Host + ":" + strconv.Itoa(port), Path: "/" + c.Name}
+		if c.User != "" {
+			if c.Password != "" {
+				u.User = url.UserPassword(c.User, c.Password)
+			} else {
+				u.User = url.User(c.User)
+			}
+		}
+		return u.String(), nil
+	default:
+		return "", fmt.Errorf("db.protocol has invalid value %d; expected one of sqlite, postgres, mysql", c.Protocol)
+	}
+}
