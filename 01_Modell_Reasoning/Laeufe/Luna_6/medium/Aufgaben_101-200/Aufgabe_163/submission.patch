+
+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	SQLite DatabaseProtocol = iota + 1
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return ""
+	}
+}
+
+func parseDatabaseProtocol(value string) (DatabaseProtocol, error) {
+	switch strings.ToLower(value) {
+	case "sqlite", "sqlite3":
+		return SQLite, nil
+	case "postgres", "postgresql":
+		return Postgres, nil
+	case "mysql":
+		return MySQL, nil
+	default:
+		return 0, fmt.Errorf("db.protocol has invalid value %q; expected one of sqlite, postgres, mysql", value)
+	}
 }
 
