+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Work around a QtWebEngine 5.15.3 crash when the system locale resource is missing.
+
+    When enabled on Linux, use a supported Chromium locale as a fallback.
+
