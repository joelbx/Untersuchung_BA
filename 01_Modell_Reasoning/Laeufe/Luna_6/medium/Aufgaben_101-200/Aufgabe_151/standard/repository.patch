+
+def test_extra_suffixes_workaround(monkeypatch):
+    monkeypatch.setattr(webview.qtutils, "version_check",
+                        lambda version, compiled=False: version == "6.2.3")
+    assert webview.extra_suffixes_workaround(["image/jpeg", ".jpg"]) == (
+        set(__import__("mimetypes").guess_all_extensions("image/jpeg")) -
+        {".jpg"})
+    assert webview.extra_suffixes_workaround([".jpg"]) == set()
+
+
+def test_extra_suffixes_workaround_wildcard(monkeypatch):
+    monkeypatch.setattr(webview.qtutils, "version_check",
+                        lambda version, compiled=False: version == "6.2.3")
+    actual = webview.extra_suffixes_workaround(["image/*"])
+    assert ".jpg" in actual
+    assert ".png" in actual
+
+
+def test_extra_suffixes_workaround_version_gate(monkeypatch):
+    monkeypatch.setattr(webview.qtutils, "version_check", lambda *a, **kw: False)
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == set()
