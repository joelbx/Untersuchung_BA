 func getAmazonLinuxVersion(osRelease string) string {
 	ss := strings.Fields(osRelease)
-	if len(ss) == 1 {
-		return "1"
+	if len(ss) == 0 {
+		return "unknown"
+	}
+	switch ss[0] {
+	case "1", "2", "2022", "2023", "2025", "2027", "2029":
+		return ss[0]
+	}
+	// Amazon Linux 1 release strings use YYYY.MM. Newer releases may include
+	// a patch/build component after the release year (for example 2023.4.2024...).
+	if strings.Contains(ss[0], ".") {
+		parts := strings.Split(ss[0], ".")
+		if len(parts) == 2 {
+			return "1"
+		}
+		year := parts[0]
+		switch year {
+		case "2022", "2023", "2025", "2027", "2029":
+			return year
+		default:
+			return "1"
+		}
 	}
-	return ss[0]
+	return "unknown"
 }
