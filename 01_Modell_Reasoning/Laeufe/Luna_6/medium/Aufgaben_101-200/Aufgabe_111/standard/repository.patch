+func TestAmazonLinuxEOLDates(t *testing.T) {
+	tests := map[string]time.Time{
+		"2023": time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2025": time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2027": time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC),
+		"2029": time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC),
+	}
+	for release, want := range tests {
+		eol, found := GetEOL(Amazon, release+" (Amazon Linux)")
+		if !found || !eol.StandardSupportUntil.Equal(want) {
+			t.Errorf("GetEOL(Amazon, %q) = (%+v, %v), want standard support through %s", release, eol, found, want)
+		}
+		before := want.Add(-time.Second)
+		after := want.Add(time.Second)
+		if eol.IsStandardSupportEnded(before) || !eol.IsStandardSupportEnded(after) {
+			t.Errorf("standard support boundary for Amazon Linux %s is incorrect", release)
+		}
+		if eol.IsExtendedSuppportEnded(before) || !eol.IsExtendedSuppportEnded(after) {
+			t.Errorf("extended support boundary for Amazon Linux %s is incorrect", release)
+		}
+	}
+	if _, found := GetEOL(Amazon, "2040 (Amazon Linux)"); found {
+		t.Error("GetEOL found an unsupported Amazon Linux release")
+	}
+}
