+func Test_getAmazonLinuxVersion(t *testing.T) {
+	tests := map[string]string{
+		"1": "1", "2 (Karoo)": "2", "2022 (Amazon Linux)": "2022",
+		"2023 (Amazon Linux)": "2023", "2025 (Amazon Linux)": "2025",
+		"2027 (Amazon Linux)": "2027", "2029 (Amazon Linux)": "2029",
+		"2018.03": "1", "2023.04": "1", "2023.4.20240611": "2023", "unknown": "unknown", "": "unknown",
+	}
+	for input, want := range tests {
+		if got := getAmazonLinuxVersion(input); got != want {
+			t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", input, got, want)
+		}
+	}
+}
