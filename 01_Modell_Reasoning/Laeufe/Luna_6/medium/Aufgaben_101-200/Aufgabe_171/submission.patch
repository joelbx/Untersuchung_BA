+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		value string
+		want  semver.Version
+	}{
+		{name: "prefixed", value: "v1.2.3", want: semver.Version{Major: 1, Minor: 2, Patch: 3}},
+		{name: "unprefixed", value: "1.2.3", want: semver.Version{Major: 1, Minor: 2, Patch: 3}},
+		{name: "missing", want: semver.Version{}},
+		{name: "invalid", value: "nope", want: semver.Version{}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.value != "" {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs("x-flipt-accept-server-version", tt.value))
+			}
+			called := false
+			_, err := FliptAcceptServerVersionUnaryInterceptor(zaptest.NewLogger(t))(ctx, nil, nil, func(ctx context.Context, _ interface{}) (interface{}, error) {
+				called = true
+				assert.Equal(t, tt.want, FliptAcceptServerVersionFromContext(ctx))
+				return nil, nil
+			})
+			require.NoError(t, err)
+			assert.True(t, called)
+		})
+	}
+}
