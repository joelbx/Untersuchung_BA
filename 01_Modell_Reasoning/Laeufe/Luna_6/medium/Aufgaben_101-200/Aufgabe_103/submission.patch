+func rpmQueryFields(line string, count int) []string {
+	// A blank RPM query field is represented by adjacent spaces. Preserve it
+	// while still accepting tabs and runs of whitespace for ordinary fields.
+	fields := strings.SplitN(line, " ", count)
+	if len(fields) == count && strings.Contains(line, "  ") {
+		for i := range fields {
+			fields[i] = strings.TrimSpace(fields[i])
+		}
+		return fields
+	}
+	return strings.Fields(line)
+}
+
+func rpmVersion(epoch, version, release string) string {
+	base := version
+	if epoch != "0" && epoch != "(none)" {
+		base = epoch + ":" + version
+	}
+	if release != "" {
+		base += "-" + release
+	}
+	return base
+}
