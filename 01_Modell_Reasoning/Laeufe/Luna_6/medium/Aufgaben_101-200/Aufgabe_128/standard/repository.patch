diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..99b2312 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,41 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_adds_set_match_and_preserves_option_order(self):
+        set_module_args({
+            'chain': 'INPUT', 'protocol': 'tcp', 'destination_port': '22',
+            'match_set': 'admin_hosts', 'match_set_flags': 'src',
+            'jump': 'ACCEPT', 'comment': 'SSH from admins',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertEqual(run_command.call_args[0][0][5:], [
+            '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', 'src',
+            '-j', 'ACCEPT', '--destination-port', '22',
+            '-m', 'comment', '--comment', 'SSH from admins',
+        ])
+
+    def test_match_set_with_explicit_match_and_inversion(self):
+        set_module_args({
+            'chain': 'INPUT', 'match': ['set'], 'match_set': '!admin_hosts',
+            'match_set_flags': 'dst,src', 'jump': 'DROP',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        self.assertEqual(run_command.call_args[0][0][5:], [
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'dst,src', '-j', 'DROP',
+        ])
+
+    def test_match_set_parameters_must_be_provided_together(self):
+        for params in (
+                {'chain': 'INPUT', 'match_set': 'admin_hosts'},
+                {'chain': 'INPUT', 'match_set_flags': 'src'}):
+            with self.subTest(params=params):
+                set_module_args(params)
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
