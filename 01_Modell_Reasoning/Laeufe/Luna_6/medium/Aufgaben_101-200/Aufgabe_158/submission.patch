+    def _valid_time_stamp(self, timestamp):
+        """Return a valid ZIP timestamp tuple, falling back to the ZIP epoch."""
+        match = re.fullmatch(r'(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})', timestamp)
+        if match:
+            year, month, day, hour, minute, second = (int(value) for value in match.groups())
+            if 1980 <= year <= 2107:
+                try:
+                    return datetime.datetime(year, month, day, hour, minute, second).timetuple()
+                except ValueError:
+                    pass
+        return (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+
