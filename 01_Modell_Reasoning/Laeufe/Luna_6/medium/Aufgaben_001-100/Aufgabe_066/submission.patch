+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces inline heights using vh and preserves other declarations', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 100vh; color: red');
+        root.innerHTML = `
+            <div id="viewport" style="width: 10px; height: calc(50vh + 10px); color: blue"></div>
+            <div id="fixed" style="height: 100px; color: green"></div>
+        `;
+
+        transformStyleAttributes(root);
+
+        expect((root as HTMLElement).style.height).toBe('auto');
+        expect((root.querySelector('#viewport') as HTMLElement).style.height).toBe('auto');
+        expect((root.querySelector('#viewport') as HTMLElement).style.width).toBe('10px');
+        expect((root.querySelector('#viewport') as HTMLElement).style.color).toBe('blue');
+        expect((root.querySelector('#fixed') as HTMLElement).style.height).toBe('100px');
+    });
+});
diff --git a/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
