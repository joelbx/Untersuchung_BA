--- /dev/null
+++ b/applications/mail/src/app/helpers/transforms/transformStyleAttributes.ts
@@ -0,0 +1,13 @@
+export const transformStyleAttributes = (document: Element): void => {
+    const elements = Array.from(document.querySelectorAll<HTMLElement>('[style]'));
+
+    if (document.hasAttribute('style')) {
+        elements.unshift(document as HTMLElement);
+    }
+
+    elements.forEach((element) => {
+        if (/vh/i.test(element.style.height)) {
+            element.style.height = 'auto';
+        }
+    });
+};
