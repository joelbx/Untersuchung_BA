+var environmentVariableReference = regexp.MustCompile(`^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$`)
+
+func environmentVariableSubstitutionHook() mapstructure.DecodeHookFunc {
+	return func(from reflect.Type, to reflect.Type, data any) (any, error) {
+		if from.Kind() != reflect.String {
+			return data, nil
+		}
+
+		value := reflect.ValueOf(data).String()
+		match := environmentVariableReference.FindStringSubmatch(value)
+		if len(match) != 2 {
+			return data, nil
+		}
+
+		if replacement, ok := os.LookupEnv(match[1]); ok {
+			return replacement, nil
+		}
+		return data, nil
+	}
+}
