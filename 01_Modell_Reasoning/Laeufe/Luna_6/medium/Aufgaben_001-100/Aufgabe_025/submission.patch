+func TestLoadEnvironmentVariableSubstitution(t *testing.T) {
+	t.Setenv("CONFIG_HTTP_PORT", "8123")
+	t.Setenv("CONFIG_LOG_LEVEL", "DEBUG")
+	t.Setenv("CONFIG_LOG_FILE", "")
+
+	path := t.TempDir() + "/config.yml"
+	config := []byte("server:\n  http_port: ${CONFIG_HTTP_PORT}\nlog:\n  level: ${CONFIG_LOG_LEVEL}\n  file: ${CONFIG_LOG_FILE}-suffix\n  grpc_level: ${CONFIG_VALUE_MISSING}\n")
+	require.NoError(t, os.WriteFile(path, config, 0600))
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8123, result.Config.Server.HTTPPort)
+	assert.Equal(t, "DEBUG", result.Config.Log.Level)
+	assert.Equal(t, "${CONFIG_LOG_FILE}-suffix", result.Config.Log.File)
+	assert.Equal(t, "${CONFIG_VALUE_MISSING}", result.Config.Log.GRPCLevel)
+}
