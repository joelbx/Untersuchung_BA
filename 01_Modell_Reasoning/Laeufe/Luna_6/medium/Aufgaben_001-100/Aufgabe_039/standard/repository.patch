+    def test_booknotes_update_collision_preserves_rows(self):
+        self.db.query("""
+        CREATE TABLE IF NOT EXISTS booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL,
+            notes text,
+            primary key (username, work_id, edition_id)
+        );
+        """)
+        self.db.query("DELETE FROM booknotes")
+        source = {"username": "@cdrini", "work_id": 1, "edition_id": 1, "notes": "source"}
+        target = {"username": "@cdrini", "work_id": 2, "edition_id": 1, "notes": "target"}
+        self.db.insert("booknotes", **source)
+        self.db.insert("booknotes", **target)
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert list(self.db.select("booknotes", order="work_id")) == [source, target]
+        self.db.query("DELETE FROM booknotes")
