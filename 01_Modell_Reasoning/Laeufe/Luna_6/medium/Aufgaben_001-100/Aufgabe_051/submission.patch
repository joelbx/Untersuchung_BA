+func TestReadKubeCluster(t *testing.T) {
+	for _, tt := range []struct {
+		name      string
+		cliValue  string
+		envValue  string
+		wantValue string
+	}{
+		{name: "unset", wantValue: ""},
+		{name: "environment", envValue: "kube-a", wantValue: "kube-a"},
+		{name: "cli takes precedence", cliValue: "kube-cli", envValue: "kube-env", wantValue: "kube-cli"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			conf := CLIConf{KubernetesCluster: tt.cliValue}
+			readKubeCluster(&conf, func(name string) string {
+				if name == kubeClusterEnvVar {
+					return tt.envValue
+				}
+				return ""
+			})
+			require.Equal(t, tt.wantValue, conf.KubernetesCluster)
+		})
+	}
+}
