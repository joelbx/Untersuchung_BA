+type sourcePosition struct{ Line, Column int }
+func referenceLocations(root *yamlv3.Node) map[string]sourcePosition {
+	out := map[string]sourcePosition{}
+	if root == nil || len(root.Content) == 0 {
+		return out
+	}
+	get := func(n *yamlv3.Node, key string) *yamlv3.Node {
+		if n == nil {
+			return nil
+		}
+		for i := 0; i+1 < len(n.Content); i += 2 {
+			if n.Content[i].Value == key {
+				return n.Content[i+1]
+			}
+		}
+		return nil
+	}
+	flags := get(root.Content[0], "flags")
+	if flags == nil {
+		return out
+	}
+	for _, fn := range flags.Content {
+		key := get(fn, "key")
+		rules := get(fn, "rules")
+		if key == nil || rules == nil {
+			continue
+		}
+		for i, rn := range rules.Content {
+			out[fmt.Sprintf("rule:%s:%d", key.Value, i)] = pos{rn.Line, rn.Column}
+		}
+	}
+	return out
 }
