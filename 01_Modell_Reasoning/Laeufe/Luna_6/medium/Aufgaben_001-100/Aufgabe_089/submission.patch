+type validationError struct {
+	message, file string
+	line, column  int
+}
+
+func (e validationError) Error() string {
+	return fmt.Sprintf("%s (%s %d:%d)", e.message, e.file, e.line, e.column)
+}
+
+type validationErrors []error
+
+func (e validationErrors) Error() string {
+	parts := make([]string, len(e))
+	for i := range e {
+		parts[i] = e[i].Error()
+	}
+	return strings.Join(parts, "\n")
+}
+func (e validationErrors) Unwrap() []error { return []error(e) }
+
+// Unwrap returns individual validation errors when err contains a validation error list.
+func Unwrap(err error) ([]error, bool) {
+	var multi interface{ Unwrap() []error }
+	if !errors.As(err, &multi) {
+		return nil, false
+	}
+	return multi.Unwrap(), true
+}
