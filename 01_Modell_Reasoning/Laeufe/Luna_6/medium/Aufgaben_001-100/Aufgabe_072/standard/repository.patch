+/** Extract the registrable-looking name from URL text, excluding www and the final suffix. */
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(/^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^/@]+@)?(?:www\.)?([^/:?#.]+)(?:\.[^/:?#]+)+/i);
+    return match?.[1] || '';
+};
+
+/** Convert only the hostname to ASCII while retaining the URL's other components. */
+export const punycodeUrl = (url: string): string => {
+    try {
+        const parsed = new URL(url);
+        if (!parsed.hostname) {
+            return url;
+        }
+        parsed.hostname = punycode.toASCII(parsed.hostname);
+        if (parsed.pathname !== '/') {
+            parsed.pathname = parsed.pathname.replace(/\/+$/, '');
+        }
+        // URL serialisation adds a slash to bare origins; preserve the original no-slash form.
+        const result = parsed.toString();
+        return !/[/?#]$/.test(url) && parsed.pathname === '/' && !parsed.search && !parsed.hash
+            ? result.replace(/\/$/, '')
+            : result;
+    } catch {
+        return url;
+    }
+};
+
 export const isMailTo = (url: string): boolean => {
     return url.toLowerCase().startsWith('mailto:');
 };
