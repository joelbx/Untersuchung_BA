@@ -29,6 +31,40 @@ import (
 	log "github.com/sirupsen/logrus"
 )
 
+// NewWriterEmitter returns an emitter that writes JSON audit events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{WriterLog: *NewWriterLog(w), writer: w}
+}
+
+// WriterEmitter writes audit events to an external writer while providing the
+// legacy audit log operations through its embedded WriterLog.
+type WriterEmitter struct {
+	WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes an audit event as a newline-delimited JSON record.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	data, err := json.Marshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	data = append(data, '\n')
+	n, err := w.writer.Write(data)
+	if err != nil {
+		return trace.ConvertSystemError(err)
+	}
+	if n != len(data) {
+		return trace.ConvertSystemError(io.ErrShortWrite)
+	}
+	return nil
+}
+
+// Close closes the writer and its embedded WriterLog, aggregating errors.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(trace.ConvertSystemError(w.writer.Close()), trace.ConvertSystemError(w.WriterLog.Close()))
+}
+
