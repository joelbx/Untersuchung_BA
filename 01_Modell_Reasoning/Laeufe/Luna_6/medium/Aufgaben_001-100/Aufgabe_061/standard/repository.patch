+func isIgnorableRPMOwnerLine(line string) bool {
+	for _, suffix := range []string{"Permission denied", "is not owned by any package", "No such file or directory"} {
+		if strings.HasSuffix(line, suffix) {
+			return true
+		}
+	}
+	return false
+}
