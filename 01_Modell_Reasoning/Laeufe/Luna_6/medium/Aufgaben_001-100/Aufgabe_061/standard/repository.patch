+// getOwnerPkgs resolves RPM ownership output to packages installed in this scan.
+// The package map is keyed by name, so compare the complete package identity
+// before returning an owner to avoid associating a process with another version.
+func (o *redhatBase) getOwnerPkgs(paths []string) ([]*models.Package, error) {
+	fqpns, err := o.getPkgNameVerRels(paths)
+	if err != nil {
+		return nil, err
+	}
+	owners := make([]*models.Package, 0, len(fqpns))
+	seen := map[string]struct{}{}
+	for _, fqpn := range fqpns {
+		for _, installed := range o.Packages {
+			if installed.FQPN() == fqpn {
+				if _, ok := seen[fqpn]; ok {
+					break
+				}
+				p := installed
+				owners = append(owners, &p)
+				seen[fqpn] = struct{}{}
+				break
+			}
+		}
+	}
+	return owners, nil
+}
