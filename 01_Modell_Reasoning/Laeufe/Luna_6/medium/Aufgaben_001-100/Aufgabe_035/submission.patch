@@ -0,0 +1,40 @@
+package server
+
+import (
+	"context"
+	"time"
+
+	"github.com/gofrs/uuid"
+	flipt "github.com/markphelps/flipt/rpc"
+)
+
+// Evaluate evaluates a feature flag for an entity.
+func (s *Server) Evaluate(ctx context.Context, req *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+	if req.FlagKey == "" {
+		return nil, emptyFieldError("flagKey")
+	}
+	if req.EntityId == "" {
+		return nil, emptyFieldError("entityId")
+	}
+	start := time.Now()
+	if req.RequestId == "" {
+		req.RequestId = uuid.Must(uuid.NewV4()).String()
+	}
+	evaluator := s.Evaluator
+	if evaluator == nil && s.RuleStore != nil {
+		// Compatibility for callers constructing Server with a legacy rule store.
+		if legacy, ok := s.RuleStore.(interface {
+			Evaluate(context.Context, *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error)
+		}); ok {
+			evaluator = legacy
+		}
+	}
+	resp, err := evaluator.Evaluate(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	if resp != nil {
+		resp.RequestDurationMillis = float64(time.Since(start)) / float64(time.Millisecond)
+	}
+	return resp, nil
+}
