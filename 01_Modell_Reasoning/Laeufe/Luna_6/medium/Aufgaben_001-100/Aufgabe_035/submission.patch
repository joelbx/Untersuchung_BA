diff --git a/storage/evaluator.go b/storage/evaluator.go
new file mode 100644
index 0000000..19d6f37
--- /dev/null
+++ b/storage/evaluator.go
@@ -0,0 +1,378 @@
+package storage
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"hash/crc32"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	sq "github.com/Masterminds/squirrel"
+	"github.com/golang/protobuf/ptypes"
+	flipt "github.com/markphelps/flipt/rpc"
+	"github.com/sirupsen/logrus"
+)
+
+// Evaluator evaluates feature flag requests.
+type Evaluator interface {
+	Evaluate(ctx context.Context, r *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error)
+}
+
+// EvaluatorStorage evaluates flags using the SQL store.
+type EvaluatorStorage struct {
+	logger  logrus.FieldLogger
+	builder sq.StatementBuilderType
+	db      *sql.DB
+}
+
+var _ Evaluator = (*EvaluatorStorage)(nil)
+
+// NewEvaluatorStorage constructs an SQL evaluator.
+func NewEvaluatorStorage(logger logrus.FieldLogger, builder sq.StatementBuilderType, db *sql.DB) *EvaluatorStorage {
+	return &EvaluatorStorage{logger: logger.WithField("storage", "evaluator"), builder: builder, db: db}
+}
+
+type evalConstraint struct {
+	typeID                    flipt.ComparisonType
+	property, operator, value string
+}
+
+type evalRule struct {
+	id, segmentKey string
+	constraints    []evalConstraint
+}
+
+type evalDistribution struct {
+	variant string
+	rollout float32
+}
+
+const (
+	opEQ         = "eq"
+	opNEQ        = "neq"
+	opLT         = "lt"
+	opLTE        = "lte"
+	opGT         = "gt"
+	opGTE        = "gte"
+	opEmpty      = "empty"
+	opNotEmpty   = "notempty"
+	opTrue       = "true"
+	opFalse      = "false"
+	opPresent    = "present"
+	opNotPresent = "notpresent"
+	opPrefix     = "prefix"
+	opSuffix     = "suffix"
+)
+
+var (
+	validOperators   = map[string]struct{}{opEQ: {}, opNEQ: {}, opLT: {}, opLTE: {}, opGT: {}, opGTE: {}, opEmpty: {}, opNotEmpty: {}, opTrue: {}, opFalse: {}, opPresent: {}, opNotPresent: {}, opPrefix: {}, opSuffix: {}}
+	noValueOperators = map[string]struct{}{opEmpty: {}, opNotEmpty: {}, opTrue: {}, opFalse: {}, opPresent: {}, opNotPresent: {}}
+	stringOperators  = map[string]struct{}{opEQ: {}, opNEQ: {}, opEmpty: {}, opNotEmpty: {}, opPrefix: {}, opSuffix: {}}
+	numberOperators  = map[string]struct{}{opEQ: {}, opNEQ: {}, opLT: {}, opLTE: {}, opGT: {}, opGTE: {}, opPresent: {}, opNotPresent: {}}
+	booleanOperators = map[string]struct{}{opTrue: {}, opFalse: {}, opPresent: {}, opNotPresent: {}}
+)
+
+// Deprecated compatibility representation for existing RuleStore callers.
+type constraint struct {
+	Type                      flipt.ComparisonType
+	Property, Operator, Value string
+}
+type distribution struct {
+	ID, RuleID, VariantID string
+	Rollout               float32
+	VariantKey            string
+}
+
+func (s *RuleStorage) Evaluate(ctx context.Context, r *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+	return NewEvaluatorStorage(s.logger, s.builder, s.db).Evaluate(ctx, r)
+}
+
+func validate(c constraint) error {
+	if c.Property == "" {
+		return errors.New("empty property")
+	}
+	if c.Operator == "" {
+		return errors.New("empty operator")
+	}
+	if _, ok := validOperators[strings.ToLower(c.Operator)]; !ok {
+		return fmt.Errorf("unsupported operator: %q", strings.ToLower(c.Operator))
+	}
+	return nil
+}
+
+func matchesString(c constraint, v string) bool {
+	v, want := strings.TrimSpace(v), strings.TrimSpace(c.Value)
+	switch strings.ToLower(c.Operator) {
+	case opEQ:
+		return v == want
+	case opNEQ:
+		return v != want
+	case opEmpty:
+		return v == ""
+	case opNotEmpty:
+		return v != ""
+	case opPrefix:
+		return strings.HasPrefix(v, want)
+	case opSuffix:
+		return strings.HasSuffix(v, want)
+	}
+	return false
+}
+
+func matchesNumber(c constraint, v string) (bool, error) {
+	if strings.EqualFold(c.Operator, opPresent) {
+		return strings.TrimSpace(v) != "", nil
+	}
+	if strings.EqualFold(c.Operator, opNotPresent) {
+		return strings.TrimSpace(v) == "", nil
+	}
+	if v == "" {
+		return false, nil
+	}
+	n, err := strconv.ParseFloat(v, 64)
+	if err != nil {
+		return false, fmt.Errorf("parsing number from %q", v)
+	}
+	want, err := strconv.ParseFloat(c.Value, 64)
+	if err != nil {
+		return false, fmt.Errorf("parsing number from %q", c.Value)
+	}
+	switch strings.ToLower(c.Operator) {
+	case opEQ:
+		return n == want, nil
+	case opNEQ:
+		return n != want, nil
+	case opLT:
+		return n < want, nil
+	case opLTE:
+		return n <= want, nil
+	case opGT:
+		return n > want, nil
+	case opGTE:
+		return n >= want, nil
+	}
+	return false, nil
+}
+
+func matchesBool(c constraint, v string) (bool, error) {
+	if strings.EqualFold(c.Operator, opPresent) {
+		return strings.TrimSpace(v) != "", nil
+	}
+	if strings.EqualFold(c.Operator, opNotPresent) {
+		return strings.TrimSpace(v) == "", nil
+	}
+	if v == "" {
+		return false, nil
+	}
+	b, err := strconv.ParseBool(v)
+	if err != nil {
+		return false, fmt.Errorf("parsing boolean from %q", v)
+	}
+	switch strings.ToLower(c.Operator) {
+	case opTrue:
+		return b, nil
+	case opFalse:
+		return !b, nil
+	}
+	return false, nil
+}
+
+func crc32Num(entityID, salt string) uint {
+	return uint(crc32.ChecksumIEEE([]byte(salt+entityID))) % 1000
+}
+
+func evaluate(r *flipt.EvaluationRequest, ds []distribution, buckets []int) (bool, distribution) {
+	index := sort.SearchInts(buckets, int(crc32Num(r.EntityId, r.FlagKey))+1)
+	if index >= len(ds) {
+		return false, distribution{}
+	}
+	return true, ds[index]
+}
+
+// Evaluate evaluates a flag for an entity.
+func (s *EvaluatorStorage) Evaluate(ctx context.Context, r *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+	ts, _ := ptypes.TimestampProto(time.Now().UTC())
+	resp := &flipt.EvaluationResponse{RequestId: r.RequestId, EntityId: r.EntityId, RequestContext: r.Context, Timestamp: ts, FlagKey: r.FlagKey}
+	var enabled bool
+	err := s.builder.Select("enabled").From("flags").Where(sq.Eq{"key": r.FlagKey}).QueryRowContext(ctx).Scan(&enabled)
+	if err == sql.ErrNoRows {
+		return resp, ErrNotFoundf("flag %q", r.FlagKey)
+	}
+	if err != nil {
+		return resp, err
+	}
+	if !enabled {
+		return resp, ErrInvalidf("flag %q is disabled", r.FlagKey)
+	}
+
+	rows, err := s.builder.Select("r.id, r.segment_key, c.id, c.type, c.property, c.operator, c.value").
+		From("rules r").LeftJoin("constraints c ON (r.segment_key = c.segment_key)").
+		Where(sq.Eq{"r.flag_key": r.FlagKey}).OrderBy("r.rank ASC, c.id ASC").QueryContext(ctx)
+	if err != nil {
+		return resp, err
+	}
+	rules := make([]*evalRule, 0)
+	byID := make(map[string]*evalRule)
+	for rows.Next() {
+		var id, segment string
+		var cid, property, operator, value sql.NullString
+		var typ sql.NullInt64
+		if err = rows.Scan(&id, &segment, &cid, &typ, &property, &operator, &value); err != nil {
+			rows.Close()
+			return resp, err
+		}
+		rule := byID[id]
+		if rule == nil {
+			rule = &evalRule{id: id, segmentKey: segment}
+			byID[id] = rule
+			rules = append(rules, rule)
+		}
+		if cid.Valid {
+			rule.constraints = append(rule.constraints, evalConstraint{flipt.ComparisonType(typ.Int64), property.String, operator.String, value.String})
+		}
+	}
+	if err = rows.Err(); err != nil {
+		rows.Close()
+		return resp, err
+	}
+	if err = rows.Close(); err != nil {
+		return resp, err
+	}
+
+	for _, rule := range rules {
+		matched := true
+		for _, c := range rule.constraints {
+			ok, e := evalConstraintMatches(c, r.Context)
+			if e != nil {
+				return resp, e
+			}
+			if !ok {
+				matched = false
+				break
+			}
+		}
+		if !matched {
+			continue
+		}
+		resp.Match, resp.SegmentKey = true, rule.segmentKey
+		drows, e := s.builder.Select("v.key, d.rollout").From("distributions d").
+			Join("variants v ON (d.variant_id = v.id)").Where(sq.Eq{"d.rule_id": rule.id}).
+			OrderBy("d.created_at ASC").QueryContext(ctx)
+		if e != nil {
+			return resp, e
+		}
+		var ds []evalDistribution
+		cutoff := 0
+		for drows.Next() {
+			var d evalDistribution
+			if e = drows.Scan(&d.variant, &d.rollout); e != nil {
+				drows.Close()
+				return resp, e
+			}
+			if d.rollout > 0 {
+				cutoff += int(d.rollout * 10)
+				ds = append(ds, d)
+			}
+		}
+		if e = drows.Err(); e != nil {
+			drows.Close()
+			return resp, e
+		}
+		if e = drows.Close(); e != nil {
+			return resp, e
+		}
+		bucket := int(crc32.ChecksumIEEE([]byte(r.FlagKey+r.EntityId)) % 1000)
+		cutoff = 0
+		for _, d := range ds {
+			cutoff += int(d.rollout * 10)
+			if cutoff >= bucket {
+				resp.Value = d.variant
+				break
+			}
+		}
+		return resp, nil
+	}
+	return resp, nil
+}
+
+func evalConstraintMatches(c evalConstraint, context map[string]string) (bool, error) {
+	if c.property == "" {
+		return false, fmt.Errorf("empty property")
+	}
+	op := strings.ToLower(strings.TrimSpace(c.operator))
+	if _, ok := validOperators[op]; !ok {
+		return false, fmt.Errorf("unsupported operator: %q", op)
+	}
+	value, present := context[c.property]
+	trimmed := strings.TrimSpace(value)
+	switch op {
+	case "present":
+		return present && trimmed != "", nil
+	case "notpresent":
+		return !present || trimmed == "", nil
+	case "empty":
+		return strings.TrimSpace(value) == "", nil
+	case "notempty":
+		return strings.TrimSpace(value) != "", nil
+	}
+	if !present {
+		return false, nil
+	}
+	switch c.typeID {
+	case flipt.ComparisonType_STRING_COMPARISON_TYPE:
+		v, want := strings.TrimSpace(value), strings.TrimSpace(c.value)
+		switch op {
+		case "eq":
+			return v == want, nil
+		case "neq":
+			return v != want, nil
+		case "prefix":
+			return strings.HasPrefix(v, want), nil
+		case "suffix":
+			return strings.HasSuffix(v, want), nil
+		case "true":
+			return strings.EqualFold(v, "true"), nil
+		case "false":
+			return strings.EqualFold(v, "false"), nil
+		}
+	case flipt.ComparisonType_NUMBER_COMPARISON_TYPE:
+		n, err := strconv.ParseFloat(strings.TrimSpace(value), 64)
+		if err != nil {
+			return false, fmt.Errorf("parsing number from %q", value)
+		}
+		want, err := strconv.ParseFloat(strings.TrimSpace(c.value), 64)
+		if err != nil {
+			return false, fmt.Errorf("parsing number from %q", c.value)
+		}
+		switch op {
+		case "eq":
+			return n == want, nil
+		case "neq":
+			return n != want, nil
+		case "lt":
+			return n < want, nil
+		case "lte":
+			return n <= want, nil
+		case "gt":
+			return n > want, nil
+		case "gte":
+			return n >= want, nil
+		}
+	case flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE:
+		b, err := strconv.ParseBool(strings.TrimSpace(value))
+		if err != nil {
+			return false, fmt.Errorf("parsing boolean from %q", value)
+		}
+		switch op {
+		case "true":
+			return b, nil
+		case "false":
+			return !b, nil
+		}
+	}
+	return false, fmt.Errorf("unsupported operator %q for comparison type", op)
+}
