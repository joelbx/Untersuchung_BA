+def get_service_ip(image_name: str) -> str:
+    """Return the IP address of a running Docker container by name or image."""
+    result = subprocess.run(
+        ["docker", "inspect", image_name], check=True, capture_output=True, text=True
+    )
+    containers = json.loads(result.stdout)
+    if not containers:
+        raise ValueError(f"No container found for {image_name}")
+    network_settings = containers[0].get("NetworkSettings", {})
+    ip_address = network_settings.get("IPAddress")
+    if not ip_address:
+        ip_address = next(
+            (
+                network.get("IPAddress")
+                for network in network_settings.get("Networks", {}).values()
+                if network.get("IPAddress")
+            ),
+            None,
+        )
+    if not ip_address:
+        raise ValueError(f"No IP address found for container {image_name}")
+    return ip_address
