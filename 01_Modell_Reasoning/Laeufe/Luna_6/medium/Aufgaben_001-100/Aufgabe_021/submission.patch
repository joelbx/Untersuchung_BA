+from typing import Any, TypedDict, TypeGuard
 
 logger = logging.getLogger("openlibrary.lists.model")
 
 
+class SeedDict(TypedDict):
+    key: str
+
+
+SeedSubjectString = str
+SeedValue = Thing | SeedDict | SeedSubjectString
+
+
+def is_seed_subject_string(seed: object) -> TypeGuard[SeedSubjectString]:
+    return isinstance(seed, str) and seed.split(":", 1)[0] in {
+        "subject", "place", "person", "time"
+    } and ":" in seed
+
+
+def _seed_key(seed: SeedValue | web.storage) -> str:
+    if isinstance(seed, str):
+        return seed
+    if isinstance(seed, Thing):
+        return seed.key
+    return seed["key"] if isinstance(seed, dict) else seed.key
+
+
+def _normalized_seed_key(seed: SeedValue | web.storage) -> str:
+    key = _seed_key(seed)
+    if key.startswith("/subjects/"):
+        key = key.rsplit("/", 1)[-1]
+        if key.split(":", 1)[0] not in {"place", "person", "time"}:
+            key = "subject:" + key
+    return key.replace(",", "_").replace("__", "_")
+
