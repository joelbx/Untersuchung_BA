+def test_parse_clixml_decodes_utf16_escapes_and_preserves_empty_streams():
+    data = (b'<Objs><S S="Error">_x263A__xD83D__xDE00__x000D__x000A_</S>'
+            b'<S S="Error"></S><S S="Info">ignored</S></Objs>')
+    assert _parse_clixml(data) == '☺😀\r\n'.encode()
+
+
+def test_parse_clixml_escape_edges_and_blocks():
+    data = (b'<Objs><S S="Error">_x005f_ _x005F_ _x005F__x000A_ _x005G_</S></Objs>'
+            b'<Objs><S S="Error">second</S></Objs>')
+    assert _parse_clixml(data) == b'_ _ _\n _x005G_\r\nsecond'
+
+
+def test_parse_clixml_preserves_unpaired_surrogate():
+    assert _parse_clixml(b'<Objs><S S="Error">_xD800_</S></Objs>') == b'\xed\xa0\x80'
+
