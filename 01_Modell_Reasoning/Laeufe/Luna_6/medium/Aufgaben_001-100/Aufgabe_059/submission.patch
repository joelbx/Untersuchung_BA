@@ -0,0 +1,34 @@
+import { forwardRef, HTMLAttributes } from 'react';
+
+interface Props extends HTMLAttributes<HTMLDialogElement> {
+    children?: React.ReactNode;
+    open?: boolean;
+}
+
+const supportsDialog = () => {
+    if (typeof window === 'undefined') {
+        return false;
+    }
+    const DialogElement = window.HTMLDialogElement;
+    return typeof DialogElement !== 'undefined' && typeof DialogElement.prototype.showModal === 'function';
+};
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ children, ...rest }, ref) => {
+    if (!supportsDialog()) {
+        return (
+            <div {...(rest as HTMLAttributes<HTMLDivElement>)} ref={ref as React.Ref<HTMLDivElement>} role="dialog">
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
