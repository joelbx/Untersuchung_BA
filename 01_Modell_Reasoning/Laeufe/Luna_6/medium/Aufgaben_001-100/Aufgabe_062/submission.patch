diff --git a/lib/utils/prompt/stdin.go b/lib/utils/prompt/stdin.go
index 39d9646..e18d13d 100644
--- a/lib/utils/prompt/stdin.go
+++ b/lib/utils/prompt/stdin.go
@@ -52,3 +52,17 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so an active password read can
+// restore the terminal before the program exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if stdin == nil {
+		return
+	}
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		_ = closer.Close()
+	}
+	stdin = nil
+}
