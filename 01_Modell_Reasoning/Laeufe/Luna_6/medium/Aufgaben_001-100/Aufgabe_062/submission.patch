 	case readerStateClean: // OK, ongoing read.
 	case readerStatePassword: // OK, ongoing read.
 		// Attempt to reset terminal state to non-password.
-		if cr.previousTermState != nil {
-			state := cr.previousTermState
-			cr.previousTermState = nil
-			if err := cr.term.Restore(cr.fd, state); err != nil {
-				return trace.Wrap(err)
-			}
+		if err := cr.maybeRestoreTerm(); err != nil {
+			return err
 		}
 	case readerStateClosed:
 		return ErrReaderClosed
@@ -224,6 +233,21 @@ func (cr *ContextReader) fireCleanRead() error {
 func (cr *ContextReader) waitForRead(ctx context.Context) ([]byte, error) {
 	select {
 	case <-ctx.Done():
+		cr.mu.Lock()
+		if cr.state == readerStatePassword {
+			err := cr.maybeRestoreTerm()
+			cr.state = readerStateIdle
+			cr.cond.Broadcast()
+			cr.mu.Unlock()
+			if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+				return []byte{}, trace.Wrap(context.DeadlineExceeded)
+			}
+			if err != nil {
+				return []byte{}, err
+			}
+			return []byte{}, trace.Wrap(ctx.Err())
+		}
+		cr.mu.Unlock()
 		return nil, trace.Wrap(ctx.Err())
 	case <-cr.closed:
 		return nil, ErrReaderClosed
@@ -280,6 +304,11 @@ func (cr *ContextReader) Close() error {
 	switch cr.state {
 	case readerStateClosed: // OK, already closed.
 	default:
