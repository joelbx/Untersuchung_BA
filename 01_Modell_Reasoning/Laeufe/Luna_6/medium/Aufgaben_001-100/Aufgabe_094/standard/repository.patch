+// DiagResult contains the individual checks used to determine whether Touch ID
+// support can be used by this process.
+type DiagResult struct {
+	HasCompileSupport       bool
+	HasSignature            bool
+	HasEntitlements         bool
+	PassedLAPolicyTest      bool
+	PassedSecureEnclaveTest bool
+	IsAvailable             bool
+}
+
+// Diag reports Touch ID availability. The native implementation currently
+// exposes a single availability check; detailed checks are populated by
+// platform implementations as they become available.
+func Diag() (*DiagResult, error) {
+	available := native.IsAvailable()
+	return &DiagResult{
+		HasCompileSupport:       available,
+		HasSignature:            available,
+		HasEntitlements:         available,
+		PassedLAPolicyTest:      available,
+		PassedSecureEnclaveTest: available,
+		IsAvailable:             available,
+	}, nil
+}
+
 // nativeTID represents the native Touch ID interface.
 // Implementors must provide a global variable called `native`.
 type nativeTID interface {
@@ -80,7 +106,8 @@ type CredentialInfo struct {
 func IsAvailable() bool {
 	// TODO(codingllama): Consider adding more depth to availability checks.
 	//  They are prone to false positives as it stands.
-	return native.IsAvailable()
+	diag, err := Diag()
+	return err == nil && diag.IsAvailable
 }
 
