+    def get_deprecation_message(self, msg, version=None, date=None, removed=False, collection_name=None):
+        '''Return a consistently formatted deprecation or removal message.'''
+        if removed:
+            return "[DEPRECATED]: %s.\nPlease update your playbooks." % msg
+        if date:
+            m = TAGGED_VERSION_RE.match(to_native(date)) if isinstance(date, string_types) else None
+            if m:
+                collection_name, date = m.group(1), m.group(2)
+            if collection_name:
+                return "[DEPRECATION WARNING]: %s. This feature will be removed in a release of %s after %s. Deprecation warnings can be disabled by setting deprecation_warnings=False in ansible.cfg.\n\n" % (msg, collection_name, date)
+            return "[DEPRECATION WARNING]: %s. This feature will be removed in a release after %s. Deprecation warnings can be disabled by setting deprecation_warnings=False in ansible.cfg.\n\n" % (msg, date)
