+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { FormEvent, useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [isEditing, setIsEditing] = useState(false);
+    const [name, setName] = useState(device.display_name ?? device.device_id);
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    const cancel = (): void => {
+        setName(device.display_name ?? device.device_id);
+        setError(undefined);
+        setIsEditing(false);
+    };
+
+    const save = async (event: FormEvent): Promise<void> => {
+        event.preventDefault();
+        const previousName = device.display_name ?? device.device_id;
+        if (name !== previousName) {
+            setIsSaving(true);
+            setError(undefined);
+            try {
+                await saveDeviceName(device.device_id, name);
+            } catch {
+                setError('Failed to set display name.');
+                setIsSaving(false);
+                return;
+            }
+            setIsSaving(false);
+        }
+        setIsEditing(false);
+    };
+
+    if (isEditing) {
+        return <form onSubmit={save} data-testid='device-detail-heading-edit'>
+            <input
+                aria-label={_t('Session name')}
+                data-testid='device-detail-name-input'
+                maxLength={100}
+                value={name}
+                onChange={event => setName(event.target.value)}
+                disabled={isSaving}
+            />
+            <p>{ _t('Session names may be visible to others you communicate with.') }</p>
+            { error && <div role='alert' data-testid='device-detail-name-error'>{ error }</div> }
+            <AccessibleButton
+                element='button'
+                kind='primary'
+                type='submit'
+                onClick={() => undefined}
+                disabled={isSaving}
+                data-testid='device-detail-name-save'
+            >
+                { isSaving ? <><Spinner w={16} h={16} />{ _t('Saving') }</> : _t('Save') }
+            </AccessibleButton>
+            <AccessibleButton
+                element='button'
+                kind='secondary'
+                onClick={cancel}
+                disabled={isSaving}
+                data-testid='device-detail-name-cancel'
+            >
+                { _t('Cancel') }
+            </AccessibleButton>
+        </form>;
+    }
+
+    return <div data-testid='device-detail-heading'>
+        <Heading size='h3'>{ device.display_name ?? device.device_id }</Heading>
+        <AccessibleButton
+            kind='link_inline'
+            onClick={() => {
+                setName(device.display_name ?? device.device_id);
+                setError(undefined);
+                setIsEditing(true);
+            }}
+            data-testid='device-detail-name-rename'
+        >
+            { _t('Rename') }
+        </AccessibleButton>
+    </div>;
+};
+
+export default DeviceDetailHeading;
