+	const code = await db.get(`confirm:byUid:${uid}`);
+	if (!code) {
+		return '';
+	}
+	const pending = await db.getObject(`confirm:${code}`);
+	return pending && pending.uid && parseInt(pending.uid, 10) === parseInt(uid, 10) ? pending.email || '' : '';
+};
+
