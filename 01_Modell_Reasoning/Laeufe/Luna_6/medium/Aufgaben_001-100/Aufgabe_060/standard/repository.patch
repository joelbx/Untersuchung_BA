+    def merge_remote_ids(
+        self, incoming_ids: dict[str, str]
+    ) -> tuple[dict[str, str], int]:
+        """Merge identifiers, rejecting values that conflict with this author."""
+        existing_ids = dict(self.get('remote_ids', {}) or {})
+        conflicts = {
+            name: (existing_ids[name], value)
+            for name, value in incoming_ids.items()
+            if name in existing_ids and existing_ids[name] != value
+        }
+        if conflicts:
+            details = ', '.join(
+                f"{name}: existing {old!r}, incoming {new!r}"
+                for name, (old, new) in sorted(conflicts.items())
+            )
+            raise AuthorRemoteIdConflictError(f"Conflicting author remote IDs: {details}")
+        matching = sum(
+            name in existing_ids and existing_ids[name] == value
+            for name, value in incoming_ids.items()
+        )
+        return {**existing_ids, **incoming_ids}, matching
