+// Hasher hashes strings using a seed maintained for each identifier.
+type Hasher struct {
+	mu       sync.Mutex
+	seeds    map[string]string
+	baseSeed maphash.Seed
+}
+
+func NewHasher() *Hasher {
+	return &Hasher{seeds: make(map[string]string), baseSeed: maphash.MakeSeed()}
+}
+
+// SetSeed assigns a reproducible seed for id.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	h.seeds[id] = seed
+	h.mu.Unlock()
 }
 
