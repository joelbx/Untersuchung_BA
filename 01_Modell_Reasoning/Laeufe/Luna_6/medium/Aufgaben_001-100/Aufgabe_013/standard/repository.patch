diff --git a/lib/ansible/cli/doc.py b/lib/ansible/cli/doc.py
index d20dc6d..751a4ac 100644
--- a/lib/ansible/cli/doc.py
+++ b/lib/ansible/cli/doc.py
@@ -71,6 +71,32 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    @classmethod
+    def tty_ify(cls, text):
+        """Render documentation macros for terminal output."""
+        import re
+
+        macro = re.compile(r'(?<![A-Za-z0-9_])(?:HORIZONTALLINE|([IBMCU])\(([^()]*)\)|([LR])\(([^(),]+),\s*([^()]*)\))')
+
+        def render(match):
+            token = match.group(0)
+            if token == 'HORIZONTALLINE':
+                return '\n-------------\n'
+            kind = match.group(1) or match.group(3)
+            if kind == 'I' or kind == 'C':
+                return "`%s'" % match.group(2)
+            if kind == 'B':
+                return '*%s*' % match.group(2)
+            if kind == 'M':
+                return '[%s]' % match.group(2)
+            if kind == 'U':
+                return match.group(2)
+            if kind == 'R':
+                return match.group(4)
+            return '%s <%s>' % (match.group(4), match.group(5))
+
+        return macro.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
