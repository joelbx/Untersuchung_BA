 var (
 	instances    = make(map[string]interface{})
 	getOrCreateC = make(chan *entry, 1)
+
+	genericInstances sync.Map
 )
 
 type entry struct {
@@ -18,6 +21,24 @@ type entry struct {
 	resultC     chan interface{}
 }
 
+type instance[T any] struct {
+	once  sync.Once
+	value T
+}
+
+// GetInstance returns the singleton instance for T, creating it with
+// constructor on the first call. Each concrete type, including pointer types,
+// has its own instance.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	cached, _ := genericInstances.LoadOrStore(typeOfT, &instance[T]{})
+	entry := cached.(*instance[T])
+	entry.once.Do(func() {
+		entry.value = constructor()
+	})
+	return entry.value
+}
+
 // Get returns an existing instance of object. If it is not yet created, calls `constructor`, stores the
 // result for future calls and return it
 func Get(object interface{}, constructor func() interface{}) interface{} {
diff --git a/utils/singleton/singleton_test.go b/utils/singleton/singleton_test.go
index 9014e4e..13097d8 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -73,3 +73,68 @@ var _ = Describe("Get", func() {
 		Expect(numInstances).To(Equal(1))
 	})
 })
+
+var _ = Describe("GetInstance", func() {
+	type item struct{ id int }
+
+	It("returns the concrete type and preserves separate value and pointer instances", func() {
+		var valueCalls, pointerCalls int
+		value := singleton.GetInstance(func() item {
+			valueCalls++
+			return item{id: 1}
+		})
+		valueAgain := singleton.GetInstance(func() item {
+			valueCalls++
+			return item{id: 2}
+		})
+		pointer := singleton.GetInstance(func() *item {
+			pointerCalls++
+			return &item{id: 3}
+		})
+		pointerAgain := singleton.GetInstance(func() *item {
+			pointerCalls++
+			return &item{id: 4}
+		})
+
+		Expect(valueAgain).To(Equal(value))
+		Expect(pointerAgain).To(BeIdenticalTo(pointer))
+		Expect(value.id).To(Equal(1))
+		Expect(pointer.id).To(Equal(3))
+		Expect(valueCalls).To(Equal(1))
+		Expect(pointerCalls).To(Equal(1))
+	})
+
+	It("runs the constructor once across 20,000 simultaneous calls", func() {
+		type concurrentItem struct{ id int }
+		const callers = 20000
+		var constructorCalls int32
+		var wait sync.WaitGroup
+		start := make(chan struct{})
+		results := make(chan *concurrentItem, callers)
+
+		for i := 0; i < callers; i++ {
+			wait.Add(1)
+			go func() {
+				defer wait.Done()
+				<-start
+				results <- singleton.GetInstance(func() *concurrentItem {
+					atomic.AddInt32(&constructorCalls, 1)
+					return &concurrentItem{id: 5}
+				})
+			}()
+		}
+		close(start)
+		wait.Wait()
+		close(results)
+
+		var first *concurrentItem
+		for result := range results {
+			if first == nil {
+				first = result
+				continue
+			}
+			Expect(result).To(BeIdenticalTo(first))
+		}
+		Expect(atomic.LoadInt32(&constructorCalls)).To(Equal(int32(1)))
+	})
+})
