+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("kubernetes proxy is not enabled")
+	}
+	var addrs []utils.NetAddr
+	if len(c.Kube.PublicAddrs) != 0 {
+		addrs = c.Kube.PublicAddrs
+	} else {
+		addrs = c.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("no public kubernetes proxy address configured")
+	}
+	host, err := kubePublicHost(addrs[0].Addr)
+	if err != nil {
+		return "", trace.BadParameter("invalid kubernetes proxy public address %q", addrs[0].Addr)
+	}
+	return fmt.Sprintf("https://%s", net.JoinHostPort(host, fmt.Sprint(defaults.KubeProxyListenPort))), nil
+}
+
+func kubePublicHost(publicAddr string) (string, error) {
+	addr, err := utils.ParseHostPortAddr(publicAddr, defaults.KubeProxyListenPort)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	host := addr.Host()
+	if host == "" {
+		return "", trace.BadParameter("missing host")
+	}
+	if parsedHost, port, err := net.SplitHostPort(publicAddr); err == nil {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 || parsedHost == "" {
+			return "", trace.BadParameter("invalid host port")
+		}
+	} else if strings.Contains(publicAddr, ":") && net.ParseIP(strings.Trim(publicAddr, "[]")) == nil {
+		return "", trace.BadParameter("invalid host")
+	}
+	return host, nil
+}
+
