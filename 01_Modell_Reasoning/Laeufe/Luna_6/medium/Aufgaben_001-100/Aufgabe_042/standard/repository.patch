diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..50031cc
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,45 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const privileges = require('../privileges');
+const user = require('../user');
+
+exports.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	if (typeof resource !== 'string' || !resource.startsWith('acct:') || !resource.endsWith(`@${hostname}`)) {
+		return res.sendStatus(400);
+	}
+
+	const username = resource.slice('acct:'.length, -(`@${hostname}`).length);
+	if (!username) {
+		return res.sendStatus(400);
+	}
+
+	const uid = req.uid || 0;
+	if (!await privileges.global.can('groups:view:users', uid)) {
+		return res.sendStatus(403);
+	}
+
+	const userUid = await user.getUidByUsername(username);
+	if (!userUid) {
+		return res.sendStatus(404);
+	}
+
+	const userslug = await user.getUserField(userUid, 'userslug');
+	const { url } = nconf.get();
+	const baseUrl = url.replace(/\/$/, '');
+	res.json({
+		subject: resource,
+		aliases: [
+			`${baseUrl}/uid/${userUid}`,
+			`${baseUrl}/user/${userslug}`,
+		],
+		links: [{
+			rel: 'http://webfinger.net/rel/profile-page',
+			type: 'text/html',
+			href: `${baseUrl}/user/${userslug}`,
+		}],
+	});
+};
