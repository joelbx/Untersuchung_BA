+// Matcher evaluates whether an input string satisfies a pattern.
+type Matcher interface{ Match(in string) bool }
+
+type regexpMatcher struct{ re *regexp.Regexp }
+
+func (m regexpMatcher) Match(in string) bool { return m.re.MatchString(in) }
+
+type notMatcher struct{ inner Matcher }
+
+func (m notMatcher) Match(in string) bool { return !m.inner.Match(in) }
+
+type prefixSuffixMatcher struct {
+	prefix, suffix string
+	inner          Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.inner.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+// Match parses a literal, glob, regexp, or matcher template.
+func Match(value string) (Matcher, error) {
+	start, end := strings.Index(value, "{{"), strings.Index(value, "}}")
+	if start < 0 && end < 0 {
+		return compilePattern(value)
+	}
+	bad := func() (Matcher, error) {
+		return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+	}
+	if start < 0 || end < start || strings.Contains(value[start+2:], "{{") || strings.Contains(value[end+2:], "}}") {
+		return bad()
+	}
+	prefix, suffix, exprText := value[:start], value[end+2:], strings.TrimSpace(value[start+2:end])
+	astExpr, err := parser.ParseExpr(exprText)
+	if err != nil {
+		return bad()
+	}
+	call, ok := astExpr.(*ast.CallExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	sel, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	ns, ok := sel.X.(*ast.Ident)
+	if !ok {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", sel.X)
+	}
+	if ns.Name != "regexp" && ns.Name != "email" {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", ns.Name)
+	}
+	if ns.Name == "email" && sel.Sel.Name != "local" {
+		return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", sel.Sel.Name)
+	}
+	if ns.Name == "regexp" && sel.Sel.Name != "match" && sel.Sel.Name != "not_match" {
+		return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match", sel.Sel.Name)
+	}
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("expected exactly one string literal argument for %s.%s", ns.Name, sel.Sel.Name)
+	}
+	lit, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || lit.Kind != token.STRING {
+		return nil, trace.BadParameter("expected exactly one string literal argument for %s.%s", ns.Name, sel.Sel.Name)
+	}
+	pattern, err := strconv.Unquote(lit.Value)
+	if err != nil {
+		return nil, trace.BadParameter("invalid string literal: %v", err)
+	}
+	var inner Matcher
+	if ns.Name == "email" {
+		inner, err = compilePattern(pattern)
+	} else {
+		re, e := regexp.Compile(pattern)
+		if e != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, e)
+		}
+		inner = regexpMatcher{re: re}
+		if sel.Sel.Name == "not_match" {
+			inner = notMatcher{inner: inner}
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	if prefix != "" || suffix != "" {
+		return prefixSuffixMatcher{prefix: prefix, suffix: suffix, inner: inner}, nil
+	}
+	return inner, nil
+}
+
+func compilePattern(pattern string) (Matcher, error) {
+	expr := "^" + utils.GlobToRegexp(pattern) + "$"
+	if strings.HasPrefix(pattern, "^") && strings.HasSuffix(pattern, "$") {
+		expr = pattern
+	}
+	re, err := regexp.Compile(expr)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return regexpMatcher{re: re}, nil
+}
