diff --git a/src/database/mongo/hash.js b/src/database/mongo/hash.js
index 732a3e2..1b2ce8c 100644
--- a/src/database/mongo/hash.js
+++ b/src/database/mongo/hash.js
@@ -261,4 +261,58 @@ module.exports = function (module) {
 			throw err;
 		}
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		if (!Array.isArray(data)) {
+			throw new TypeError('data must be an array of [key, increments] tuples');
+		}
+		if (!data.length) {
+			return;
+		}
+
+		const updates = new Map();
+		data.forEach((entry) => {
+			if (!Array.isArray(entry) || entry.length !== 2 || typeof entry[0] !== 'string' || !entry[0] || !entry[1] || typeof entry[1] !== 'object' || Array.isArray(entry[1])) {
+				throw new TypeError('each item must be a [key, increments] tuple');
+			}
+			const increments = updates.get(entry[0]) || {};
+			const fields = Object.keys(entry[1]);
+			if (!fields.length) {
+				throw new TypeError('increments must contain at least one field');
+			}
+			fields.forEach((field) => {
+				const value = entry[1][field];
+				const normalized = helpers.fieldToString(field);
+				if (!normalized || ['__proto__', 'constructor', 'prototype'].includes(field) || /[.$]/.test(field) || !Number.isSafeInteger(value)) {
+					throw new TypeError('invalid field name or increment');
+				}
+				increments[normalized] = (increments[normalized] || 0) + value;
+				if (!Number.isSafeInteger(increments[normalized])) {
+					throw new TypeError('combined increment must be a safe integer');
+				}
+			});
+			updates.set(entry[0], increments);
+		});
+
+		const collection = module.client.collection('objects');
+		const operations = Array.from(updates, ([key, increments]) => collection.updateOne(
+			{ _key: key }, { $inc: increments }, { upsert: true }
+		));
+		const results = await Promise.allSettled(operations);
+		const succeeded = [];
+		let failure;
+		results.forEach((result, index) => {
+			if (result.status === 'fulfilled') {
+				succeeded.push(Array.from(updates.keys())[index]);
+			} else if (!failure) {
+				failure = result.reason;
+			}
+		});
+		if (succeeded.length) {
+			cache.del(succeeded);
+		}
+		if (failure) {
+			throw failure;
+		}
+	};
 };
diff --git a/src/database/redis/hash.js b/src/database/redis/hash.js
index 1afdccd..c1bb155 100644
--- a/src/database/redis/hash.js
+++ b/src/database/redis/hash.js
@@ -219,4 +219,72 @@ module.exports = function (module) {
 		cache.del(key);
 		return Array.isArray(result) ? result.map(value => parseInt(value, 10)) : parseInt(result, 10);
 	};
+
+	module.incrObjectFieldByBulk = async function (data) {
+		if (!Array.isArray(data)) {
+			throw new TypeError('data must be an array of [key, increments] tuples');
+		}
+		if (!data.length) {
+			return;
+		}
+
+		const updates = new Map();
+		data.forEach((entry) => {
+			if (!Array.isArray(entry) || entry.length !== 2 || typeof entry[0] !== 'string' || !entry[0] || !entry[1] || typeof entry[1] !== 'object' || Array.isArray(entry[1])) {
+				throw new TypeError('each item must be a [key, increments] tuple');
+			}
+			const increments = updates.get(entry[0]) || {};
+			const fields = Object.keys(entry[1]);
+			if (!fields.length) {
+				throw new TypeError('increments must contain at least one field');
+			}
+			fields.forEach((field) => {
+				const value = entry[1][field];
+				if (!field || ['__proto__', 'constructor', 'prototype'].includes(field) || /[.$]/.test(field) || !Number.isSafeInteger(value)) {
+					throw new TypeError('invalid field name or increment');
+				}
+				const name = String(field);
+				increments[name] = (increments[name] || 0) + value;
+				if (!Number.isSafeInteger(increments[name])) {
+					throw new TypeError('combined increment must be a safe integer');
+				}
+			});
+			updates.set(entry[0], increments);
+		});
+
+		const script = `
+			for i = 1, #ARGV, 2 do
+				local value = redis.call('HGET', KEYS[1], ARGV[i])
+				if value and not string.match(value, '^%-?%d+$') then
+					return redis.error_reply('ERR hash field is not an integer')
+				end
+			end
+			for i = 1, #ARGV, 2 do
+				redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+			end
+			return 1
+		`;
+		const results = await Promise.allSettled(Array.from(updates, ([key, increments]) => {
+			const args = Object.entries(increments).flatMap(([field, value]) => [field, String(value)]);
+			return module.client.eval(script, 1, key, ...args);
+		}));
+		const succeeded = [];
+		let failure;
+		let index = 0;
+		results.forEach((result) => {
+			const key = Array.from(updates.keys())[index];
+			index += 1;
+			if (result.status === 'fulfilled') {
+				succeeded.push(key);
+			} else if (!failure) {
+				failure = result.reason;
+			}
+		});
+		if (succeeded.length) {
+			cache.del(succeeded);
+		}
+		if (failure) {
+			throw failure;
+		}
+	};
 };
