+def _is_child_path(b_parent, b_path, b_link_location=None):
+    """Return whether a path (or link target at a location) resolves below parent."""
+    if b_link_location is not None:
+        b_path = os.path.join(os.path.dirname(b_link_location), b_path)
+    parent = os.path.realpath(b_parent)
+    path = os.path.realpath(b_path)
+    try:
+        return os.path.commonpath([parent, path]) == parent
+    except ValueError:
+        return False
+
