diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..64c664c
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,63 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	LatestVersionURL string
+	UpdateAvailable  bool
+}
+
+// Check compares version with the latest published release.
+func Check(ctx context.Context, version string) (Info, error) {
+	info := Info{CurrentVersion: version}
+
+	client := github.NewClient(nil)
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		err = fmt.Errorf("checking for latest version: %w", err)
+		zap.L().Warn("checking for updates", zap.Error(err))
+		return info, err
+	}
+
+	info.LatestVersion = strings.TrimPrefix(latest.GetTagName(), "v")
+	info.LatestVersionURL = latest.GetHTMLURL()
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+	newest, err := semver.ParseTolerant(info.LatestVersion)
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+	info.UpdateAvailable = current.Compare(newest) < 0
+	return info, nil
+}
+
+// Is reports whether version is a stable release build.
+func Is(version string) bool {
+	if version == "" || strings.EqualFold(version, "dev") {
+		return false
+	}
+	parsed, err := semver.ParseTolerant(version)
+	if err != nil {
+		return false
+	}
+	for _, part := range parsed.Pre {
+		identifier := strings.ToLower(part.String())
+		if identifier == "dev" || identifier == "snapshot" || identifier == "rc" || strings.HasPrefix(identifier, "rc.") {
+			return false
+		}
+	}
+	return true
+}
