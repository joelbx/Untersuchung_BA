-content.javascript.log_message:
+content.javascript.log_message.levels:
   type:
     name: Dict
     keytype: String
@@ -963,6 +963,22 @@ content.javascript.log_message:
     By default, errors happening in qutebrowser internally or in userscripts are
     shown to the user.
 
+content.javascript.log_message.excludes:
+  type:
+    name: Dict
+    keytype: String
+    valtype:
+      name: List
+      valtype: String
+    none_ok: true
+  default: {}
+  desc: >-
+    Glob-based exclusions for JavaScript messages shown in the qutebrowser UI.
+
+    The dictionary keys match message sources and the values are lists of glob
+    patterns matched against the message text. Matching messages are not shown
+    in the UI, even when enabled by `content.javascript.log_message.levels`.
+
