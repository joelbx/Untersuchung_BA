diff --git a/qutebrowser/browser/shared.py b/qutebrowser/browser/shared.py
index 384a69c..8f77a03 100644
--- a/qutebrowser/browser/shared.py
+++ b/qutebrowser/browser/shared.py
@@ -159,6 +159,32 @@ _JS_LOGMAP_MESSAGE: Mapping[usertypes.JsLogLevel, Callable[[str], None]] = {
 }
 
 
+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Display a JavaScript log message if it matches the UI filters."""
+    for source_pattern, levels in (config.cache[
+            'content.javascript.log_message.levels'] or {}).items():
+        if not fnmatch.fnmatchcase(source, source_pattern):
+            continue
+        if level.name not in levels:
+            continue
+
+        for exclude_source, patterns in (config.cache[
+                'content.javascript.log_message.excludes'] or {}).items():
+            if (fnmatch.fnmatchcase(source, exclude_source) and
+                    any(fnmatch.fnmatchcase(msg, pattern)
+                        for pattern in patterns)):
+                return False
+
+        _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+        return True
+    return False
+
+
