-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type IsSegment interface{ isSegment() }
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ IsSegment }
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil || s.IsSegment == nil {
+		return nil, fmt.Errorf("invalid segment")
+	}
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		return string(v), nil
+	case Segments:
+		if len(v.Keys) == 0 || v.SegmentOperator == "" {
+			return nil, fmt.Errorf("segment requires keys and operator")
+		}
+		if len(v.Keys) == 1 {
+			return map[string]interface{}{"keys": v.Keys, "operator": "OR_SEGMENT_OPERATOR"}, nil
+		}
+		return map[string]interface{}{"keys": v.Keys, "operator": v.SegmentOperator}, nil
+	default:
+		return nil, fmt.Errorf("invalid segment type %T", v)
+	}
+}
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var str string
+	if err := unmarshal(&str); err == nil {
+		if str == "" {
+			return fmt.Errorf("segment key is empty")
+		}
+		s.IsSegment = SegmentKey(str)
+		return nil
+	}
+	var obj struct {
+		Keys     []string `yaml:"keys"`
+		Operator string   `yaml:"operator"`
+	}
+	if err := unmarshal(&obj); err != nil {
+		return fmt.Errorf("segment must be a string or keys/operator object: %w", err)
+	}
+	if len(obj.Keys) == 1 {
+		s.IsSegment = Segments{Keys: obj.Keys, SegmentOperator: "OR_SEGMENT_OPERATOR"}
+		return nil
+	}
+	if len(obj.Keys) < 2 || strings.TrimSpace(obj.Operator) == "" {
+		return fmt.Errorf("segment object requires keys and operator")
+	}
+	s.IsSegment = Segments{Keys: obj.Keys, SegmentOperator: obj.Operator}
+	return nil
+}
+func (s *SegmentEmbed) Values() ([]string, string) {
+	if s == nil {
+		return nil, ""
+	}
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		return []string{string(v)}, "OR_SEGMENT_OPERATOR"
+	case Segments:
+		op := v.SegmentOperator
+		if len(v.Keys) == 1 {
+			op = "OR_SEGMENT_OPERATOR"
+		}
+		return v.Keys, op
+	}
+	return nil, ""
 }
 
