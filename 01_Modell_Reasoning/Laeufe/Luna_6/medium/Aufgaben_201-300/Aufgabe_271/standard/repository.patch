+def get_location_and_publisher(loc_pub) -> tuple[list[str], list[str]]:
+    """Parse ordered location:publisher pairs from IA publisher metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub.strip():
+        return [], []
+    text = loc_pub.replace("Place of publication not identified", "").strip(STRIP_CHARS)
+    if not text:
+        return [], []
+    if ':' not in text:
+        if ',' in text:
+            text = text.split(',', 1)[1]
+        publisher = text.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+        return ([], [publisher]) if publisher else ([], [])
+
+    locations, publishers = [], []
+    for segment in text.split(';'):
+        segment = segment.strip(STRIP_CHARS)
+        if not segment:
+            continue
+        if segment.count(':') > 1:
+            break
+        if ':' in segment:
+            location, publisher = get_colon_only_loc_pub(segment)
+            location = location.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+            publisher = publisher.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+            if location:
+                locations.append(location)
+            if publisher:
+                publishers.append(publisher)
+    return locations, publishers
 
 
