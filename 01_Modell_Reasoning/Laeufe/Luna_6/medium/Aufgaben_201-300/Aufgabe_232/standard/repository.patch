@@ -0,0 +1,53 @@
+package config
+
+import "time"
+
+// EOL describes the end of standard and extended support for an OS release.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+func lifecycle(standard, extended string) EOL {
+	parse := func(s string) time.Time {
+		if s == "" {
+			return time.Time{}
+		}
+		t, _ := time.Parse("2006-01-02", s)
+		return t
+	}
+	return EOL{StandardSupportUntil: parse(standard), ExtendedSupportUntil: parse(extended)}
+}
+
+var eolByFamily = map[string]map[string]EOL{
+	Amazon:  {"2018.03": lifecycle("2023-06-30", "2023-06-30"), "2 (Karoo)": lifecycle("2025-06-30", "")},
+	RedHat:  {"7": lifecycle("2024-06-30", ""), "8": lifecycle("2029-05-31", ""), "6": lifecycle("2020-11-30", "2024-06-30")},
+	CentOS:  {"7": lifecycle("2024-06-30", ""), "8": lifecycle("2021-12-31", ""), "6": lifecycle("2020-11-30", "2020-11-30")},
+	Oracle:  {"7": lifecycle("2024-06-30", ""), "8": lifecycle("2029-05-31", ""), "6": lifecycle("2021-03-31", "2022-03-31")},
+	Ubuntu:  {"18.04": lifecycle("2023-05-31", "2028-04-30"), "14.04": lifecycle("2019-04-30", "2024-04-30"), "14.10": lifecycle("2015-07-30", "2015-07-30"), "21.04": lifecycle("2022-01-30", "")},
+	Debian:  {"9": lifecycle("2022-06-30", ""), "10": lifecycle("2024-06-30", ""), "8": lifecycle("2020-06-30", "2020-06-30")},
+	Alpine:  {"3.10": lifecycle("2021-05-30", ""), "3.11": lifecycle("2021-11-30", ""), "3.12": lifecycle("2022-05-30", ""), "3.9": lifecycle("2020-11-30", "2020-11-30")},
+	FreeBSD: {"11": lifecycle("2021-09-30", "2021-09-30"), "12": lifecycle("2023-12-31", ""), "10": lifecycle("2019-10-30", "2019-10-30")},
+}
+
+// GetEOL returns lifecycle information for a modeled OS family and release.
+func GetEOL(family, release string) (EOL, bool) {
+	byRelease, ok := eolByFamily[family]
+	if !ok {
+		return EOL{}, false
+	}
+	e, ok := byRelease[release]
+	if ok {
+		e.Ended = e.IsStandardSupportEnded(time.Now())
+	}
+	return e, ok
+}
