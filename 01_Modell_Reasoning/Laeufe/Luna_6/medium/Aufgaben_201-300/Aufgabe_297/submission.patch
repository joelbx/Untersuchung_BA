+// validateIPAgainstList checks remote addresses against configured CIDRs or IPs.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		remoteAddr = "@"
+	} else {
+		host, _, err := net.SplitHostPort(remoteAddr)
+		if err == nil {
+			remoteAddr = host
+		}
+	}
+	if remoteAddr == "@" {
+		for _, item := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(item) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	ip := net.ParseIP(remoteAddr)
+	if ip == nil {
+		return false
+	}
+	for _, item := range strings.Split(whitelist, ",") {
+		item = strings.TrimSpace(item)
+		if item == "" {
+			continue
+		}
+		if strings.Contains(item, "/") {
+			_, network, err := net.ParseCIDR(item)
+			if err == nil && network.Contains(ip) {
+				return true
+			}
+		} else {
+			host, _, err := net.SplitHostPort(item)
+			if err == nil {
+				item = host
+			}
+			if parsed := net.ParseIP(item); parsed != nil && parsed.Equal(ip) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			return nil
+		}
+		now := time.Now()
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: strings.Title(username), IsAdmin: count == 0, LastLoginAt: &now}
+		if repo.Put(user) != nil {
+			return nil
+		}
+	} else if err != nil {
+		return nil
+	}
+	if repo.UpdateLastLoginAt(user.ID) != nil {
+		log.Error(r, "Could not update LastLoginAt", "user", username)
+	}
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		return nil
+	}
+	saltBytes := make([]byte, 16)
+	if _, err = rand.Read(saltBytes); err != nil {
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes[:3])
+	subsonic := md5.Sum([]byte(user.Password + salt))
+	return map[string]interface{}{"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name, "username": user.UserName, "token": token, "subsonicSalt": salt, "subsonicToken": fmt.Sprintf("%x", subsonic)}
+}
+
 var (
 	ErrFirstTime = errors.New("no users created")
 )
