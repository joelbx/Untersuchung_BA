+func redactNested(value interface{}, re *regexp.Regexp) interface{} {
+	switch v := value.(type) {
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(v))
+		for key, item := range v {
+			if re.MatchString(key) {
+				out[key] = "[REDACTED]"
+			} else {
+				out[key] = redactNested(item, re)
+			}
+		}
+		return out
+	case string:
+		return re.ReplaceAllString(v, "$1[REDACTED]$2")
+	}
+	rv := reflect.ValueOf(value)
+	if rv.IsValid() && rv.Kind() == reflect.Map {
+		if rv.Type().Key().Kind() == reflect.String {
+			out := make(map[string]interface{}, rv.Len())
+			iter := rv.MapRange()
+			for iter.Next() {
+				key, item := iter.Key(), iter.Value()
+				if re.MatchString(key.String()) {
+					out[key.String()] = "[REDACTED]"
+				} else {
+					out[key.String()] = redactNested(item.Interface(), re)
+				}
+			}
+			return out
+		}
+		out := make(map[interface{}]interface{}, rv.Len())
+		iter := rv.MapRange()
+		for iter.Next() {
+			key, item := iter.Key(), iter.Value()
+			var redacted interface{}
+			if re.MatchString(fmt.Sprint(key.Interface())) {
+				redacted = "[REDACTED]"
+			} else {
+				redacted = redactNested(item.Interface(), re)
+			}
+			out[key.Interface()] = redacted
+		}
+		return out
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
