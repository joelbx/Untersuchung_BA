+};
 
 utils.log = async (token) => {
-	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
+	await db.sortedSetAdd(lastSeenIndex, Date.now(), token);
+};
+
+utils.get = async (tokens) => {
+	if (tokens === null || tokens === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const isArray = Array.isArray(tokens);
+	const tokenList = isArray ? tokens : [tokens];
+	const [objects, lastSeen] = await Promise.all([
+		Promise.all(tokenList.map(token => db.getObject(`token:${token}`))),
+		utils.getLastSeen(tokenList),
+	]);
+	const hydrated = objects.map((object, index) => {
+		if (!object || !Object.keys(object).length) {
+			return null;
+		}
+		return {
+			uid: Number(object.uid),
+			description: object.description,
+			timestamp: Number(object.timestamp),
+			lastSeen: lastSeen[index],
+		};
+	});
+	return isArray ? hydrated : hydrated[0];
+};
+
+utils.list = async () => {
+	const tokens = await db.getSortedSetRange(creationIndex, 0, -1);
+	return await utils.get(tokens);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+utils.generate = async ({ uid, description } = {}) => {
+	const numericUid = Number(uid);
+	if (!Number.isFinite(numericUid) || uid === null || uid === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.getUserData(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+	const token = nodeUtils.generateUUID();
+	const timestamp = Date.now();
+	const fields = { uid: numericUid, timestamp };
+	if (description !== undefined) {
+		fields.description = description;
+	}
+	await Promise.all([
+		db.setObject(`token:${token}`, fields),
+		db.sortedSetAdd(creationIndex, timestamp, token),
+		db.sortedSetAdd(userIndex, numericUid, token),
+	]);
+	return token;
+};
+
+utils.update = async (token, { description } = {}) => {
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await utils.get(token);
+};
+
+utils.delete = async (token) => {
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove(creationIndex, token),
+		db.sortedSetRemove(userIndex, token),
+		db.sortedSetRemove(lastSeenIndex, token),
+	]);
+};
