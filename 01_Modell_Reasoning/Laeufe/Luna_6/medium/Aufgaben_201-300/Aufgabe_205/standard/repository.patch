 'use strict';
 
 const db = require('../database');
+const user = require('../user');
+const nodeUtils = require('../utils');
 
 const utils = module.exports;
+const creationIndex = 'tokens:createtime';
+const userIndex = 'tokens:uid';
+const lastSeenIndex = 'tokens:lastSeen';
 
-// internal token management utilities only
+utils.getLastSeen = async (tokens) => {
+	if (!Array.isArray(tokens)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokens.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores(lastSeenIndex, tokens);
+	return scores.map((score) => {
+		const value = Number(score);
+		return score !== null && score !== undefined && Number.isFinite(value) ? value : null;
