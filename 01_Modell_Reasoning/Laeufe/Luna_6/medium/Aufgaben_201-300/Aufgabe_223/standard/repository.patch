+def _extract_interpreter(b_module_data):
+    """Return the interpreter and arguments from a module's first-line shebang."""
+    first_line = b_module_data.split(b'\n', 1)[0]
+    if not first_line.startswith(b'#!'):
+        return None, []
+    args = shlex.split(to_native(first_line[2:].strip(), errors='surrogate_or_strict'))
+    if not args:
+        return None, []
+    return args[0], args[1:]
