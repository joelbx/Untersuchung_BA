+# the Free Software Foundation, either version 3 of the License, or
+# (at your option) any later version.
+
+"""Completion category for local filesystem paths."""
+
+import os
+from urllib.parse import urlsplit, unquote
+
+from PyQt5.QtCore import QAbstractTableModel, QModelIndex, Qt
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractTableModel):
+
+    """Expose filesystem paths as a completion category."""
+
+    def __init__(self, name, parent=None):
+        super().__init__(parent)
+        self.name = name
+        self._paths = []
+
+    def set_pattern(self, val):
+        """Update suggestions for a local path pattern."""
+        self.beginResetModel()
+        if not val:
+            self._paths = list(config.val.completion.favorite_paths)
+            self.endResetModel()
+            return
+
+        display_prefix = val
+        path = val
+        if val.startswith('file:///'):
+            try:
+                parsed = urlsplit(val)
+                if parsed.netloc not in ('', 'localhost') or parsed.query or parsed.fragment:
+                    self._paths = []
+                    self.endResetModel()
+                    return
+                path = unquote(parsed.path)
+                display_prefix = path
+            except ValueError:
+                self._paths = []
+                self.endResetModel()
+                return
+        elif not val.startswith('~') and not os.path.isabs(val):
+            self._paths = []
+            self.endResetModel()
+            return
+
+        expanded = os.path.expanduser(path)
+        directory, partial = os.path.split(expanded)
+        if not directory:
+            directory = os.path.sep
+        try:
+            entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
+        except (OSError, ValueError):
+            entries = []
+
+        # Keep the typed prefix for normal paths; for ~ patterns, construct
+        # displayed names from the contracted input while matching expanded.
+        if val.startswith('file:///'):
+            typed = path
+        elif val.startswith('~'):
+            typed = os.path.expanduser('~')
+            typed = display_prefix.replace(os.path.expanduser('~'), typed, 1)
+        else:
+            typed = val
+        typed_dir, typed_partial = os.path.split(typed)
+        if not typed_dir:
+            typed_dir = os.path.sep
+
+        paths = []
+        for entry in entries:
+            if entry.name.startswith(partial):
+                shown = os.path.join(typed_dir, entry.name)
+                if entry.is_dir(follow_symlinks=False):
+                    shown += os.path.sep
+                paths.append(shown)
+        self._paths = paths
+        self.endResetModel()
+
+    def data(self, index, role=Qt.DisplayRole):
+        if (role != Qt.DisplayRole or not index.isValid() or
+                index.row() < 0 or index.row() >= len(self._paths)):
+            return None
+        if index.column() == 0:
+            return self._paths[index.row()]
+        return None
+
+    def rowCount(self, parent=QModelIndex()):
+        return 0 if parent.isValid() else len(self._paths)
+
+    def columnCount(self, parent=QModelIndex()):
+        return 3
