+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	return [...]string{"", "sS", "sT", "sA", "sW", "sM", "sN", "sF", "sX"}[s]
+}
+
+// PortScanConf configures the optional local nmap scanner.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath,omitempty" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques,omitempty" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged,omitempty" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort,omitempty" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c *PortScanConf) GetScanTechniques() []ScanTechnique {
+	if c == nil || len(c.ScanTechniques) == 0 {
+		return []ScanTechnique{}
+	}
+	result := make([]ScanTechnique, 0, len(c.ScanTechniques))
+	for _, raw := range c.ScanTechniques {
+		code := strings.ToLower(strings.TrimPrefix(strings.ToLower(strings.TrimSpace(raw)), "-"))
+		found := NotSupportTechnique
+		for t := TCPSYN; t <= TCPXmas; t++ {
+			if strings.ToLower(t.String()) == code {
+				found = t
+				break
+			}
+		}
+		result = append(result, found)
+	}
+	return result
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required"))
+	} else if st, err := os.Stat(c.ScannerBinPath); err != nil || st.IsDir() {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q does not exist or is not a file", c.ScannerBinPath))
+	}
+	techs := c.GetScanTechniques()
+	for i, t := range techs {
+		if t == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique %q", c.ScanTechniques[i]))
+		}
+	}
+	if len(techs) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported"))
+	}
+	if !c.HasPrivileged && len(techs) == 1 && techs[0] != TCPConnect {
+		errs = append(errs, fmt.Errorf("only TCPConnect is supported without privileges"))
+	}
+	if c.SourcePort != "" {
+		p, err := strconv.Atoi(c.SourcePort)
+		if err != nil || p < 0 || p > 65535 || p == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort must be an integer in [1,65535]"))
+		}
+		if len(techs) == 1 && techs[0] == TCPConnect {
+			errs = append(errs, fmt.Errorf("sourcePort is incompatible with TCPConnect"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		out, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil || !strings.Contains(string(out), "cap_net_raw") {
+			errs = append(errs, fmt.Errorf("missing or malformed capabilities for scannerBinPath %q: %s", c.ScannerBinPath, strings.TrimSpace(string(out))))
+		}
+	}
+	return errs
+}
