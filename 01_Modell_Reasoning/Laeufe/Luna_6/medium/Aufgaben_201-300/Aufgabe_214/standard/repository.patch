+func (l *base) execExternalPortScan(dest map[string][]string) ([]string, error) {
+	c := l.ServerInfo.PortScan
+	techniques := c.GetScanTechniques()
+	args := []string{"-n", "-Pn", "-oG", "-", "-p"}
+	ports := map[string]bool{}
+	for _, ps := range dest {
+		for _, p := range ps {
+			ports[p] = true
+		}
+	}
+	portList := make([]string, 0, len(ports))
+	for p := range ports {
+		portList = append(portList, p)
+	}
+	sort.Strings(portList)
+	args = append(args, strings.Join(portList, ","))
+	if len(techniques) > 0 && techniques[0] != config.NotSupportTechnique {
+		args = append(args, "-"+techniques[0].String())
+	}
+	if c.SourcePort != "" {
+		args = append(args, "-g", c.SourcePort)
+	}
+	hosts := 0
+	for ip := range dest {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		args = append(args, ip)
+		hosts++
+	}
+	if len(portList) == 0 || hosts == 0 {
+		return []string{}, nil
+	}
+	out, err := extExec.Command(c.ScannerBinPath, args...).CombinedOutput()
+	if err != nil {
+		return nil, xerrors.Errorf("nmap scan failed: %w: %s", err, strings.TrimSpace(string(out)))
+	}
+	return findPortScanSuccessOn(string(out), dest), nil
+}
+
+func findPortScanSuccessOn(output string, dest map[string][]string) []string {
+	open := []string{}
+	for _, line := range strings.Split(output, "\n") {
+		if !strings.HasPrefix(line, "Host: ") {
+			continue
+		}
+		fields := strings.Fields(line)
+		if len(fields) < 4 {
+			continue
+		}
+		ip := fields[1]
+		for _, field := range fields {
+			if !strings.HasPrefix(field, "Ports:") {
+				continue
+			}
+			for _, entry := range strings.Split(strings.TrimPrefix(field, "Ports:"), ",") {
+				parts := strings.Split(strings.TrimSpace(entry), "/")
+				if len(parts) > 1 && parts[1] == "open" {
+					open = append(open, ip+":"+parts[0])
+				}
+			}
+		}
+	}
+	return open
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := []string{}
+	for _, t := range techniques {
+		if t == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+t.String())
+	}
+	return options, nil
+}
