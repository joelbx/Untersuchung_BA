+// Result contains every validation error found in a YAML document.
+type Result struct {
+	Errors []Error `json:"errors"`
+}
+
+// FeaturesValidator validates feature YAML against the embedded schema.
+type FeaturesValidator struct {
+	cue *cue.Context
+	v   cue.Value
+}
+
+// NewFeaturesValidator compiles the embedded feature schema.
+func NewFeaturesValidator() (*FeaturesValidator, error) {
+	cctx := cuecontext.New()
+	v := cctx.CompileBytes(cueFile)
+	if err := v.Err(); err != nil {
+		return nil, err
+	}
+	return &FeaturesValidator{cue: cctx, v: v}, nil
+}
+
+// Validate checks a YAML document and returns all schema failures.
+func (v *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	f, err := yaml.Extract(file, b)
+	if err != nil {
+		return Result{}, err
+	}
+	yv := v.cue.BuildFile(f, cue.Scope(v.v))
+	err = v.v.Unify(yv).Validate(cue.All())
+	if err == nil {
+		return Result{}, nil
+	}
+	result := Result{Errors: make([]Error, 0)}
+	for _, failure := range cueerror.Errors(err) {
+		path := strings.Join(failure.Path(), ".")
+		if path == "" {
+			if i := strings.Index(failure.Error(), ":"); i > 0 {
+				path = strings.TrimSpace(failure.Error()[:i])
+			}
+		}
+		format, args := failure.Msg()
+		message := fmt.Sprintf(format, args...)
+		if path != "" {
+			message = path + ": " + message
+		}
+		positions := failure.InputPositions()
+		pos := token.NoPos
+		for _, candidate := range positions {
+			if candidate.IsValid() {
+				pos = candidate
+			}
+		}
+		if !pos.IsValid() {
+			pos = failure.Position()
+		}
+		result.Errors = append(result.Errors, Error{Message: message, Field: path, Location: Location{File: file, Line: pos.Line(), Column: pos.Column()}})
+	}
+	if len(result.Errors) == 0 {
+		return result, err
+	}
+	return result, ErrValidationFailed
+}
