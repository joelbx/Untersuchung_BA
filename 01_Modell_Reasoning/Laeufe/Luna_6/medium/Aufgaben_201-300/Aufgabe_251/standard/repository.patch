+func TestFeaturesValidatorReportsAllErrorsWithSourceLocations(t *testing.T) {
+	validator, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	input := []byte("flags:\n- key: test\n  name: Test\n  nabled: true\n  rules:\n  - segment: users\n    rank: 1\n    distributions:\n    - variant: control\n      rollout: 110\n")
+	result, err := validator.Validate("input.yaml", input)
+	require.ErrorIs(t, err, ErrValidationFailed)
+	require.NotEmpty(t, result.Errors)
+	for _, validationError := range result.Errors {
+		require.Equal(t, "input.yaml", validationError.Location.File)
+		require.Greater(t, validationError.Location.Line, 0)
+		require.NotEmpty(t, validationError.Field)
+	}
+	var output bytes.Buffer
+	require.NoError(t, json.NewEncoder(&output).Encode(result))
+	var decoded Result
+	require.NoError(t, json.Unmarshal(output.Bytes(), &decoded))
+	require.Equal(t, result, decoded)
+}
