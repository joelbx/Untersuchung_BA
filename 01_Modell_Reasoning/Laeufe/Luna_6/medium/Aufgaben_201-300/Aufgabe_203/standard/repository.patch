+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+
+type Props = React.AnchorHTMLAttributes<HTMLAnchorElement>;
+
+export default function ExternalLink({ className, target, rel, children, ...props }: Props): JSX.Element {
+    const classes = ['mx_ExternalLink', className].filter(Boolean).join(' ');
+
+    return <a {...props} className={classes} target={target ?? '_blank'} rel={rel ?? 'noreferrer noopener'}>
+        { children }
+        <span className="mx_ExternalLink_icon" aria-hidden="true" />
+    </a>;
+}
