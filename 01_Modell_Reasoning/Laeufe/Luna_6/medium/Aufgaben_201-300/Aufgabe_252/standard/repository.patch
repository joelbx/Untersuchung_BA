     if rc != 0:
+        module.warn('Unable to read sysctl: %s' % (err or 'sysctl exited with status %s' % rc))
         return dict()
 
     sysctl = dict()
+    current_key = None
     for line in out.splitlines():
         if not line:
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
-        sysctl[key] = value.strip()
+        if line[0].isspace() and current_key:
+            sysctl[current_key] += '\n' + line.strip()
+            continue
+        try:
+            match = re.match(r'^([^:=\s]+)(?:\s*=\s*|:\s*|\s+)(.*)$', line)
+            if not match:
+                raise ValueError('expected key followed by =, :, or whitespace')
+            current_key, value = match.groups()
+            sysctl[current_key] = value.strip()
