     return sysctl
+
+
+def get_sysctl_uptime(module):
+    sysctl_cmd = module.get_bin_path('sysctl')
+    if not sysctl_cmd:
+        raise ValueError('sysctl command not found')
+    try:
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'], check_rc=False)
+    except (IOError, OSError) as e:
+        module.warn('Unable to read sysctl: %s' % e)
+        return {}
+    if rc != 0:
+        module.warn('Unable to read sysctl: %s' % (err or 'sysctl exited with status %s' % rc))
+        return {}
+    value = out.strip()
+    if not re.match(r'^\d+$', value):
+        return {}
+    return {'uptime_seconds': int(time.time() - int(value))}
