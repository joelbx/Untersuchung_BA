+	}
+	if c.Server.CertKey == "" {
+		return errors.New("cert_key cannot be empty when using HTTPS")
+	}
+	if _, err := os.Stat(c.Server.CertFile); err != nil {
+		return errors.Errorf("cannot find TLS cert_file at %q", c.Server.CertFile)
+	}
