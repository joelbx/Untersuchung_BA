+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		err := backend.RunWhileLocked(ctx, l.backend, rfd24MigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+			return l.migrateFieldsMap(ctx)
+		})
+		if err == nil || ctx.Err() != nil {
+			return
+		}
+		l.WithError(err).Warn("Failed to migrate DynamoDB audit event fields; will retry")
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(time.Minute):
+		}
+	}
+}
+
+// migrateFieldsMap is resumable because each successful batch removes its items
+// from the attribute_not_exists(FieldsMap) scan on the next pass.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	var startKey map[string]*dynamodb.AttributeValue
+	var migrated int
+	for {
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName: aws.String(l.Tablename), ConsistentRead: aws.Bool(true),
+			ExclusiveStartKey: startKey, Limit: aws.Int64(DynamoBatchSize),
+			FilterExpression: aws.String("attribute_not_exists(FieldsMap) AND attribute_exists(Fields)"),
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		requests := make([]*dynamodb.WriteRequest, 0, len(out.Items))
+		for _, item := range out.Items {
+			legacy := item["Fields"]
+			if legacy == nil || legacy.S == nil {
+				return trace.BadParameter("event %v has invalid legacy Fields attribute", item[keySessionID])
+			}
+			var original map[string]interface{}
+			if err := json.Unmarshal([]byte(*legacy.S), &original); err != nil {
+				return trace.WrapWithMessage(err, "failed to decode legacy event Fields")
+			}
+			encoded, err := json.Marshal(original)
+			if err != nil {
+				return trace.Wrap(err)
+			}
+			var verified map[string]interface{}
+			if err := json.Unmarshal(encoded, &verified); err != nil || !reflect.DeepEqual(original, verified) {
+				return trace.BadParameter("event Fields conversion failed semantic validation")
+			}
+			fieldMap, err := dynamodbattribute.Marshal(original)
+			if err != nil {
+				return trace.Wrap(err)
+			}
+			item["FieldsMap"] = fieldMap
+			requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+		}
+		if len(requests) != 0 {
+			if err := l.uploadBatch(requests); err != nil {
+				return trace.Wrap(err)
+			}
+			migrated += len(requests)
+			l.Infof("Migrated %d audit events to FieldsMap", migrated)
+		}
+		startKey = out.LastEvaluatedKey
+		if startKey == nil {
+			return nil
+		}
+	}
+}
