+// decodeEventFields converts the canonical event JSON to DynamoDB's native map type.
+func decodeEventFields(data []byte) map[string]interface{} {
+	var fields map[string]interface{}
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return nil
+	}
+	return fields
+}
+
+func unmarshalEventFields(e event, out interface{}) error {
+	if e.FieldsMap != nil {
+		data, err := json.Marshal(e.FieldsMap)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		return json.Unmarshal(data, out)
+	}
+	return json.Unmarshal([]byte(e.Fields), out)
+}
