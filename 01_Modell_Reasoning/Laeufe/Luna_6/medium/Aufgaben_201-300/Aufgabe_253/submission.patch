+def test_live_messages_stderr(qtbot, proc, py_proc, message_mock, caplog):
+    proc._output_messages = True
+    cmd, args = py_proc(r"""
+        import sys, time
+        sys.stderr.write('first line\n')
+        sys.stderr.flush()
+        time.sleep(0.5)
+        sys.stderr.write('second line\n')
+    """)
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.started, timeout=5000):
+            proc.start(cmd, args)
+        qtbot.wait_until(lambda: bool(message_mock.messages), timeout=5000)
+
+    assert proc.outcome.running
+    assert message_mock.messages[0].level == usertypes.MessageLevel.error
+    assert message_mock.messages[0].text == 'first line'
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            pass
+
+    assert message_mock.messages[-1].level == usertypes.MessageLevel.error
+    assert message_mock.messages[-1].text == 'first line\nsecond line'
+
+
