+func cisaKEVs(records []kevulnmodels.KEVuln) []models.KEV {
+	kevs := make([]models.KEV, 0, len(records))
+	for _, record := range records {
+		kev := models.KEV{
+			Type:                       models.CISAKEVType,
+			VendorProject:              record.VendorProject,
+			Product:                    record.Product,
+			VulnerabilityName:          record.VulnerabilityName,
+			ShortDescription:           record.ShortDescription,
+			RequiredAction:             record.RequiredAction,
+			KnownRansomwareCampaignUse: record.KnownRansomwareCampaignUse,
+			DateAdded:                  record.DateAdded,
+			CISA:                       &models.CISAKEV{Note: record.Notes},
+		}
+		if !record.DueDate.IsZero() {
+			dueDate := record.DueDate
+			kev.DueDate = &dueDate
+		}
+		kevs = append(kevs, kev)
+	}
+	return kevs
+}
