-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment represents a segment value accepted by a rule.
+type IsSegment interface {
+	isSegment()
+}
+
+// SegmentKey represents a rule that matches a single segment.
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+// Segments represents segment keys combined with a logical operator.
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+// SegmentEmbed wraps either a single segment key or a group of segment keys.
+type SegmentEmbed struct {
+	IsSegment
+}
+
+// Normalize returns the canonical key/operator representation of a segment.
+// Single-key segments always use OR, regardless of an operator supplied in an
+// object representation.
+func (s *SegmentEmbed) Normalize() (Segments, error) {
+	if s == nil || s.IsSegment == nil {
+		return Segments{}, fmt.Errorf("segment is required")
+	}
+
+	switch segment := s.IsSegment.(type) {
+	case SegmentKey:
+		if segment == "" {
+			return Segments{}, fmt.Errorf("segment key cannot be empty")
+		}
+		return Segments{
+			Keys:            []string{string(segment)},
+			SegmentOperator: "OR_SEGMENT_OPERATOR",
+		}, nil
+	case Segments:
+		if len(segment.Keys) == 0 {
+			return Segments{}, fmt.Errorf("segment keys must contain at least one key")
+		}
+		keys := make([]string, 0, len(segment.Keys))
+		seen := make(map[string]struct{}, len(segment.Keys))
+		for _, key := range segment.Keys {
+			if key == "" {
+				return Segments{}, fmt.Errorf("segment keys cannot contain an empty key")
+			}
+			if _, exists := seen[key]; !exists {
+				keys = append(keys, key)
+				seen[key] = struct{}{}
+			}
+		}
+		segment.Keys = keys
+		if len(keys) == 1 {
+			segment.SegmentOperator = "OR_SEGMENT_OPERATOR"
+			return segment, nil
+		}
+		if segment.SegmentOperator != "OR_SEGMENT_OPERATOR" && segment.SegmentOperator != "AND_SEGMENT_OPERATOR" {
+			return Segments{}, fmt.Errorf("invalid segment operator %q", segment.SegmentOperator)
+		}
+		return segment, nil
+	default:
+		return Segments{}, fmt.Errorf("unsupported segment value %T", s.IsSegment)
+	}
+}
+
+// MarshalYAML writes single keys as scalars and grouped keys as mappings.
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil || s.IsSegment == nil {
+		return nil, fmt.Errorf("segment is required")
+	}
+
+	switch segment := s.IsSegment.(type) {
+	case SegmentKey:
+		if segment == "" {
+			return nil, fmt.Errorf("segment key cannot be empty")
+		}
+		return string(segment), nil
+	case Segments:
+		return s.Normalize()
+	default:
+		return nil, fmt.Errorf("unsupported segment value %T", s.IsSegment)
+	}
+}
+
+// UnmarshalYAML reads either a scalar segment key or a keys/operator mapping.
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	s.IsSegment = nil
+	var value interface{}
+	if err := unmarshal(&value); err != nil {
+		return err
+	}
+
+	switch segment := value.(type) {
+	case string:
+		if segment == "" {
+			return fmt.Errorf("segment key cannot be empty")
+		}
+		s.IsSegment = SegmentKey(segment)
+		return nil
+	case map[interface{}]interface{}:
+		return s.unmarshalSegments(segment)
+	case map[string]interface{}:
+		return s.unmarshalSegments(segment)
+	default:
+		return fmt.Errorf("segment must be a string or an object with keys and operator, got %T", value)
+	}
+}
+
+func (s *SegmentEmbed) unmarshalSegments(values interface{}) error {
+	fields := make(map[string]interface{})
+	switch values := values.(type) {
+	case map[interface{}]interface{}:
+		for key, value := range values {
+			name, ok := key.(string)
+			if !ok {
+				return fmt.Errorf("segment object keys must be strings")
+			}
+			fields[name] = value
+		}
+	case map[string]interface{}:
+		for key, value := range values {
+			fields[key] = value
+		}
+	default:
+		return fmt.Errorf("segment must be an object with keys and operator")
+	}
+
+	if len(fields) != 2 {
+		return fmt.Errorf("segment object must contain only keys and operator")
+	}
+	rawKeys, hasKeys := fields["keys"]
+	rawOperator, hasOperator := fields["operator"]
+	if !hasKeys || !hasOperator {
+		return fmt.Errorf("segment object must contain keys and operator")
+	}
+
+	var keys []string
+	switch rawKeys := rawKeys.(type) {
+	case []interface{}:
+		keys = make([]string, 0, len(rawKeys))
+		for _, rawKey := range rawKeys {
+			key, ok := rawKey.(string)
+			if !ok {
+				return fmt.Errorf("segment keys must be strings")
+			}
+			keys = append(keys, key)
+		}
+	case []string:
+		keys = append(keys, rawKeys...)
+	default:
+		return fmt.Errorf("segment keys must be a list of strings")
+	}
+	if len(keys) == 0 {
+		return fmt.Errorf("segment keys must contain at least one key")
+	}
+
+	operator, ok := rawOperator.(string)
+	if !ok {
+		return fmt.Errorf("segment operator must be a string")
+	}
+
+	segment := Segments{Keys: keys, SegmentOperator: operator}
+	if len(keys) == 1 {
+		if keys[0] == "" {
+			return fmt.Errorf("segment key cannot be empty")
+		}
+		s.IsSegment = SegmentKey(keys[0])
+		return nil
+	}
+	normalized, err := (&SegmentEmbed{IsSegment: segment}).Normalize()
+	if err != nil {
+		return err
+	}
+	if len(normalized.Keys) == 1 {
+		s.IsSegment = SegmentKey(normalized.Keys[0])
+	} else {
+		s.IsSegment = normalized
+	}
+	return nil
+}
+
+// UnmarshalYAML preserves support for the legacy sibling `segments` and
+// `operator` fields while storing the result in the unified Segment field.
+func (r *Rule) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var value struct {
+		Segment        *SegmentEmbed   `yaml:"segment,omitempty"`
+		Rank           uint            `yaml:"rank,omitempty"`
+		Distributions  []*Distribution `yaml:"distributions,omitempty"`
+		LegacyKeys     []string        `yaml:"segments,omitempty"`
+		LegacyOperator string          `yaml:"operator,omitempty"`
+	}
+	if err := unmarshal(&value); err != nil {
+		return err
+	}
+
+	if value.LegacyKeys != nil || value.LegacyOperator != "" {
+		if value.Segment != nil {
+			if value.LegacyKeys == nil {
+				if _, singleKey := value.Segment.IsSegment.(SegmentKey); singleKey {
+					*r = Rule{Segment: value.Segment, Rank: value.Rank, Distributions: value.Distributions}
+					return nil
+				}
+			}
+			return fmt.Errorf("rule cannot contain both segment and legacy segments fields")
+		}
+		if len(value.LegacyKeys) == 0 {
+			return fmt.Errorf("legacy segments must contain at least one key")
+		}
+		operator := value.LegacyOperator
+		if operator == "" {
+			operator = "OR_SEGMENT_OPERATOR"
+		}
+		segment := Segments{Keys: value.LegacyKeys, SegmentOperator: operator}
+		embed := &SegmentEmbed{IsSegment: segment}
+		if _, err := embed.Normalize(); err != nil {
+			return err
+		}
+		value.Segment = embed
+	}
+
+	*r = Rule{Segment: value.Segment, Rank: value.Rank, Distributions: value.Distributions}
+	return nil
 }
 
