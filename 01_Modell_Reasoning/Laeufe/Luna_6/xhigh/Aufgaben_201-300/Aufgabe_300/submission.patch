+def is_promise_item(rec: dict) -> bool:
+    """Return whether any source record identifies a Promise item."""
+    source_records = rec.get("source_records")
+    if not isinstance(source_records, list):
+        return False
+
+    return any(
+        isinstance(source_record, str)
+        and source_record.casefold().startswith("promise:")
+        for source_record in source_records
+    )
