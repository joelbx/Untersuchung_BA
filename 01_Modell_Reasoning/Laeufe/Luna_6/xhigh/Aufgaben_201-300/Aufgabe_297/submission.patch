+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+
+	reflected := reflect.ValueOf(value)
+	switch reflected.Kind() {
+	case reflect.String:
+		return re.ReplaceAllString(reflected.String(), "$1[REDACTED]$2")
+	case reflect.Map:
+		if reflected.Type().Key().Kind() == reflect.String {
+			redacted := make(map[string]interface{}, reflected.Len())
+			iter := reflected.MapRange()
+			for iter.Next() {
+				key := iter.Key().String()
+				if isSensitiveKey(key) || re.MatchString(key) {
+					redacted[key] = "[REDACTED]"
+				} else {
+					redacted[key] = redactValue(iter.Value().Interface(), re)
+				}
+			}
+			return redacted
+		}
+		redacted := make(map[interface{}]interface{}, reflected.Len())
+		iter := reflected.MapRange()
+		for iter.Next() {
+			key := iter.Key().Interface()
+			if isSensitiveKey(fmt.Sprint(key)) || re.MatchString(fmt.Sprint(key)) {
+				redacted[key] = "[REDACTED]"
+			} else {
+				redacted[key] = redactValue(iter.Value().Interface(), re)
+			}
+		}
+		return redacted
+	default:
+		return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+	}
+}
+
+func isSensitiveKey(key string) bool {
+	normalized := strings.ToLower(key)
+	normalized = strings.NewReplacer("-", "", "_", "", ".", "", " ", "").Replace(normalized)
+	for _, sensitive := range []string{"token", "secret", "password", "apikey", "authorization", "cookie"} {
+		if strings.Contains(normalized, sensitive) {
+			return true
+		}
+	}
+	return false
+}
