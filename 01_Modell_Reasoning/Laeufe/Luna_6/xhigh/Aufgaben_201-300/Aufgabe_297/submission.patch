+// handleLoginFromHeaders authenticates a request from a trusted reverse proxy.
+// It returns nil when the peer is not trusted or the configured user header is empty.
+func handleLoginFromHeaders(ds model.DataStore, w http.ResponseWriter, r *http.Request) map[string]interface{} {
+	remoteAddr := r.RemoteAddr
+	if originalAddr, ok := request.RemoteAddrFrom(r.Context()); ok {
+		remoteAddr = originalAddr
+	}
+	if !validateIPAgainstList(remoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+	auth.Init(ds)
+
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for reverse proxy login", countErr)
+			return nil
+		}
+		user, err = createReverseProxyUser(r.Context(), ds, username, count == 0)
+	}
+	if err != nil || user == nil {
+		log.Error(r, "Could not find or create reverse proxy user", "username", username, err)
+		return nil
+	}
+
+	now := time.Now()
+	user.LastLoginAt = &now
+	if err := userRepo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update LastLoginAt", "user", user.UserName, err)
+	}
+
+	tokenString, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create token for reverse proxy user", "username", username, err)
+		return nil
+	}
+
+	saltBytes := make([]byte, 3)
+	if _, err := rand.Read(saltBytes); err != nil {
+		log.Error(r, "Could not create Subsonic salt for reverse proxy user", err)
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	subsonicHash := md5.Sum([]byte(user.Password + salt))
+	payload := map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         tokenString,
+		"subsonicSalt":  salt,
+		"subsonicToken": fmt.Sprintf("%x", subsonicHash),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
+
+func createReverseProxyUser(ctx context.Context, ds model.DataStore, username string, isAdmin bool) (*model.User, error) {
+	user := &model.User{
+		ID:          uuid.NewString(),
+		UserName:    username,
+		Name:        strings.Title(username),
+		NewPassword: uuid.NewString(),
+		IsAdmin:     isAdmin,
+	}
+	user.Password = user.NewPassword
+	now := time.Now()
+	user.LastLoginAt = &now
+	if err := ds.User(ctx).Put(user); err != nil {
+		return nil, err
+	}
+	return user, nil
+}
+
+// validateIPAgainstList checks a peer address against a comma-separated list of
+// IP addresses and CIDR ranges. Invalid entries are ignored.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if strings.TrimSpace(whitelist) == "" || strings.TrimSpace(remoteAddr) == "" {
+		return false
+	}
+
+	if ip := net.ParseIP(remoteAddr); ip != nil {
+		return ipMatchesWhitelist(ip, whitelist)
+	}
+
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		ip := net.ParseIP(strings.Trim(host, "[]"))
+		if ip == nil {
+			return false
+		}
+		return ipMatchesWhitelist(ip, whitelist)
+	}
+
+	// Unix domain sockets have no IP address. The explicit "@" entry opts in.
+	if remoteAddr != "@" && !strings.HasPrefix(remoteAddr, "@") && !strings.HasPrefix(remoteAddr, "/") {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		if strings.TrimSpace(entry) == "@" {
+			return true
+		}
+	}
+	return false
+}
+
+func ipMatchesWhitelist(remoteIP net.IP, whitelist string) bool {
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" || entry == "@" {
+			continue
+		}
+
+		if _, cidr, err := net.ParseCIDR(entry); err == nil {
+			if cidr.Contains(remoteIP) {
+				return true
+			}
+			continue
+		}
+
+		// Bare addresses and IP:port entries are treated as exact IP matches.
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = strings.Trim(host, "[]")
+		}
+		if ip := net.ParseIP(strings.Trim(entry, "[]")); ip != nil && ip.Equal(remoteIP) {
+			return true
+		}
+	}
+	return false
+}
