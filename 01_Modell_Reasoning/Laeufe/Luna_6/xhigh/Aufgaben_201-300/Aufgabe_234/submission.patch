+++ b/db/db.go
@@ -4,6 +4,8 @@ import (
 	"database/sql"
 	"embed"
 	"fmt"
+	"net/url"
+	"strings"
 
 	"github.com/mattn/go-sqlite3"
 	"github.com/navidrome/navidrome/conf"
@@ -34,7 +36,10 @@ func Db() *sql.DB {
 
 		Path = conf.Server.DbPath
 		if Path == ":memory:" {
-			Path = "file::memory:?cache=shared&_foreign_keys=on"
+			Path = "file::memory:"
+		}
+		Path = configureSQLiteDSN(Path)
+		if conf.Server.DbPath == ":memory:" {
 			conf.Server.DbPath = Path
 		}
 		log.Debug("Opening DataBase", "dbPath", Path, "driver", Driver)
@@ -46,6 +51,22 @@ func Db() *sql.DB {
 	})
 }
 
+func configureSQLiteDSN(path string) string {
+	parts := strings.SplitN(path, "?", 2)
+	query := url.Values{}
+	if len(parts) == 2 {
+		query, _ = url.ParseQuery(parts[1])
+	}
+	query.Set("cache", "shared")
+	query.Set("_cache_size", "1000000000")
+	query.Set("_busy_timeout", "5000")
+	query.Set("_journal_mode", "WAL")
+	query.Set("_synchronous", "NORMAL")
+	query.Set("_foreign_keys", "on")
+	query.Set("_txlock", "immediate")
+	return parts[0] + "?" + query.Encode()
+}
+
 func Close() error {
 	log.Info("Closing Database")
 	return Db().Close()
