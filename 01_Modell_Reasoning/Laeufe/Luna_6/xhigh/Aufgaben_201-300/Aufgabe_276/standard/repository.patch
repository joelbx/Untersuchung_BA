+func TestAuthenticationProviderRequiredFields(t *testing.T) {
+	tests := []struct {
+		name     string
+		config   string
+		provider string
+		field    string
+	}{
+		{
+			name: "github client_id",
+			config: `authentication:
+  session:
+    domain: localhost
+  methods:
+    github:
+      enabled: true
+      client_secret: secret
+      redirect_address: http://localhost/callback
+`,
+			provider: "github",
+			field:    "client_id",
+		},
+		{
+			name: "github client_secret",
+			config: `authentication:
+  session:
+    domain: localhost
+  methods:
+    github:
+      enabled: true
+      client_id: client
+      redirect_address: http://localhost/callback
+`,
+			provider: "github",
+			field:    "client_secret",
+		},
+		{
+			name: "github redirect_address",
+			config: `authentication:
+  session:
+    domain: localhost
+  methods:
+    github:
+      enabled: true
+      client_id: client
+      client_secret: secret
+`,
+			provider: "github",
+			field:    "redirect_address",
+		},
+		{
+			name: "oidc client_id",
+			config: `authentication:
+  session:
+    domain: localhost
+  methods:
+    oidc:
+      enabled: true
+      providers:
+        foo:
+          client_secret: secret
+          redirect_address: http://localhost/callback
+`,
+			provider: "foo",
+			field:    "client_id",
+		},
+		{
+			name: "oidc client_secret",
+			config: `authentication:
+  session:
+    domain: localhost
+  methods:
+    oidc:
+      enabled: true
+      providers:
+        foo:
+          client_id: client
+          redirect_address: http://localhost/callback
+`,
+			provider: "foo",
+			field:    "client_secret",
+		},
+		{
+			name: "oidc redirect_address",
+			config: `authentication:
+  session:
+    domain: localhost
+  methods:
+    oidc:
+      enabled: true
+      providers:
+        foo:
+          client_id: client
+          client_secret: secret
+`,
+			provider: "foo",
+			field:    "redirect_address",
+		},
+	}
+
+	backup := os.Environ()
+	os.Clearenv()
+	defer func() {
+		for _, env := range backup {
+			key, value, _ := strings.Cut(env, "=")
+			_ = os.Setenv(key, value)
+		}
+	}()
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.config), 0o600))
+
+			_, err := Load(path)
+			require.EqualError(t, err, fmt.Sprintf("provider %q: field %q: non-empty value is required", tt.provider, tt.field))
+		})
+	}
+}
