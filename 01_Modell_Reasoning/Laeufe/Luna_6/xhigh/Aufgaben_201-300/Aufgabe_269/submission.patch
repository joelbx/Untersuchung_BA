+
+func mergeLibraryCveContents(dst, src models.CveContents) models.CveContents {
+	if dst == nil {
+		dst = models.CveContents{}
+	}
+	for ctype, incomingContents := range src {
+		for _, incoming := range incomingContents {
+			found := false
+			for i, existing := range dst[ctype] {
+				if existing.CveID != incoming.CveID || existing.SourceLink != incoming.SourceLink {
+					continue
+				}
+				if incoming.Title != "" {
+					existing.Title = incoming.Title
+				}
+				if incoming.Summary != "" {
+					existing.Summary = incoming.Summary
+				}
+				if incoming.Cvss2Score != 0 {
+					existing.Cvss2Score = incoming.Cvss2Score
+				}
+				if incoming.Cvss2Vector != "" {
+					existing.Cvss2Vector = incoming.Cvss2Vector
+				}
+				if incoming.Cvss3Score != 0 {
+					existing.Cvss3Score = incoming.Cvss3Score
+				}
+				if incoming.Cvss3Vector != "" {
+					existing.Cvss3Vector = incoming.Cvss3Vector
+				}
+				if incoming.Cvss3Severity != "" {
+					existing.Cvss3Severity = incoming.Cvss3Severity
+				}
+				if !incoming.Published.IsZero() {
+					existing.Published = incoming.Published
+				}
+				if !incoming.LastModified.IsZero() {
+					existing.LastModified = incoming.LastModified
+				}
+				for _, ref := range incoming.References {
+					foundRef := false
+					for _, oldRef := range existing.References {
+						if oldRef.Link == ref.Link {
+							foundRef = true
+							break
+						}
+					}
+					if !foundRef {
+						existing.References = append(existing.References, ref)
+					}
+				}
+				dst[ctype][i] = existing
+				found = true
+				break
+			}
+			if !found {
+				dst[ctype] = append(dst[ctype], incoming)
+			}
+		}
+	}
+	return dst
+}
