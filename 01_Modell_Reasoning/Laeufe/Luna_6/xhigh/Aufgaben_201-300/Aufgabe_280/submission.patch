+func TestNewWithClientEnvironment(t *testing.T) {
+	tests := []struct {
+		name        string
+		namespace   string
+		replicaName string
+		wantError   string
+	}{
+		{
+			name:        "missing namespace",
+			replicaName: "agent-0",
+			wantError:   `environment variable "KUBE_NAMESPACE" not set or empty`,
+		},
+		{
+			name:      "missing replica name",
+			namespace: "test",
+			wantError: `environment variable "TELEPORT_REPLICA_NAME" not set or empty`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv("TELEPORT_REPLICA_NAME", tt.replicaName)
+			t.Setenv(ReleaseNameEnv, "release-1")
+
+			b, err := NewWithClient(fake.NewSimpleClientset())
+			require.EqualError(t, err, tt.wantError)
+			require.Nil(t, b)
+		})
+	}
+
+	t.Run("configuration is derived from environment", func(t *testing.T) {
+		t.Setenv(NamespaceEnv, "test")
+		t.Setenv("TELEPORT_REPLICA_NAME", "agent-0")
+		t.Setenv(ReleaseNameEnv, "release-1")
+
+		b, err := NewWithClient(fake.NewSimpleClientset())
+		require.NoError(t, err)
+		require.Equal(t, "test", b.Namespace)
+		require.Equal(t, "agent-0-state", b.SecretName)
+		require.Equal(t, "agent-0", b.ReplicaName)
+		require.Equal(t, "release-1", b.ReleaseName)
+	})
+}
