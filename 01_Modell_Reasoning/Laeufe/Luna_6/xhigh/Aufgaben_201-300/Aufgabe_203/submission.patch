+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import classNames from "classnames";
+import React from "react";
+import { _t } from "../../../languageHandler";
+
+type IProps = React.AnchorHTMLAttributes<HTMLAnchorElement>;
+
+const ExternalLink: React.FC<IProps> = ({
+    children,
+    className,
+    target = "_blank",
+    rel = "noreferrer noopener",
+    ...props
+}) => <a
+    {...props}
+    className={classNames("mx_ExternalLink", className)}
+    target={target}
+    rel={rel}
+>
+    { children }
+    <span className="mx_ExternalLink_accessibleText">{ " " }{ _t("Opens in a new tab") }</span>
+    <span className="mx_ExternalLink_icon" aria-hidden="true" />
+</a>;
+
+export default ExternalLink;
