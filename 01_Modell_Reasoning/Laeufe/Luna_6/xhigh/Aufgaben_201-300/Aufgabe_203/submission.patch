+    .mx_ExternalLink_accessibleText {
+        position: absolute;
+        width: 1px;
+        height: 1px;
+        padding: 0;
+        margin: -1px;
+        overflow: hidden;
+        clip-path: inset(50%);
+        white-space: nowrap;
+        border: 0;
+    }
+
+    .mx_ExternalLink_icon {
+        display: inline-block;
+        width: $font-11px;
+        height: $font-11px;
+        margin-left: $font-3px;
+        vertical-align: middle;
+        background-color: currentColor;
+        mask-image: url('$(res)/img/external-link.svg');
+        mask-repeat: no-repeat;
+        mask-position: center;
+        mask-size: contain;
+    }
+}
