+func (l *Log) uploadFieldsMapBatch(ctx context.Context, writeRequests []*dynamodb.WriteRequest) error {
+	for len(writeRequests) > 0 {
+		out, err := l.svc.BatchWriteItemWithContext(ctx, &dynamodb.BatchWriteItemInput{
+			RequestItems: map[string][]*dynamodb.WriteRequest{l.Tablename: writeRequests},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		writeRequests = out.UnprocessedItems[l.Tablename]
+		if len(writeRequests) == 0 {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+	return nil
+}
