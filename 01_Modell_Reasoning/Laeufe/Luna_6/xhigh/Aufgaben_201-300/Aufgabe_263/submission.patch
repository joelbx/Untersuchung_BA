+func attributeValueToJSON(attribute *dynamodb.AttributeValue) (interface{}, error) {
+	switch {
+	case attribute == nil:
+		return nil, nil
+	case attribute.BOOL != nil:
+		return aws.BoolValue(attribute.BOOL), nil
+	case attribute.L != nil:
+		values := make([]interface{}, len(attribute.L))
+		for i, entry := range attribute.L {
+			value, err := attributeValueToJSON(entry)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			values[i] = value
+		}
+		return values, nil
+	case attribute.M != nil:
+		values := make(map[string]interface{}, len(attribute.M))
+		for key, entry := range attribute.M {
+			value, err := attributeValueToJSON(entry)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			values[key] = value
+		}
+		return values, nil
+	case attribute.N != nil:
+		return json.Number(aws.StringValue(attribute.N)), nil
+	case attribute.S != nil:
+		return aws.StringValue(attribute.S), nil
+	case attribute.NULL != nil:
