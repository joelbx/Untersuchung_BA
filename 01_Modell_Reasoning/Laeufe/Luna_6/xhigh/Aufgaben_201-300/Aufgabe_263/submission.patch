+	decoder := dynamodbattribute.NewDecoder(func(decoder *dynamodbattribute.Decoder) {
+		decoder.UseNumber = true
+	})
+	if err := decoder.Decode(&dynamodb.AttributeValue{M: item}, &e); err != nil {
+		return event{}, trace.Wrap(err)
+	}
+	return e, nil
+}
