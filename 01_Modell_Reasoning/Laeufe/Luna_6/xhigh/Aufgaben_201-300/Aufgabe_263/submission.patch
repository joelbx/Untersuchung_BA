+func dynamoNumberValues(value interface{}) interface{} {
+	switch value := value.(type) {
+	case json.Number:
+		return dynamodbattribute.Number(value.String())
+	case map[string]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, entry := range value {
+			converted[key] = dynamoNumberValues(entry)
+		}
+		return converted
+	case []interface{}:
+		converted := make([]interface{}, len(value))
+		for i, entry := range value {
