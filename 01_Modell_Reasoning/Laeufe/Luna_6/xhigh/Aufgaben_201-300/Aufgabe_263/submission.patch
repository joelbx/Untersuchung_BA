+
+// canonicalJSONNumber produces an exact canonical decimal form, including
+// equivalent representations such as 1, 1.0, and 10e-1.
+func canonicalJSONNumber(value string) string {
+	sign := ""
+	if strings.HasPrefix(value, "-") {
+		sign = "-"
+		value = value[1:]
+	}
+	exponent := 0
+	if i := strings.IndexAny(value, "eE"); i >= 0 {
+		parsed, err := strconv.Atoi(value[i+1:])
+		if err != nil {
+			return sign + value
+		}
+		exponent = parsed
+		value = value[:i]
+	}
+	decimalPlaces := 0
+	if i := strings.IndexByte(value, '.'); i >= 0 {
+		decimalPlaces = len(value) - i - 1
+		value = value[:i] + value[i+1:]
+	}
+	exponent -= decimalPlaces
+	value = strings.TrimLeft(value, "0")
+	if value == "" {
+		return "0"
+	}
+	for strings.HasSuffix(value, "0") {
+		value = strings.TrimSuffix(value, "0")
+		exponent++
+	}
+	return sign + value + "e" + strconv.Itoa(exponent)
+}
