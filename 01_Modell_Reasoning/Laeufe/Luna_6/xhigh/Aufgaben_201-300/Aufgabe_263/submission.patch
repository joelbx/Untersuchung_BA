+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for {
+		err := backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+			return l.migrateFieldsMap(ctx)
+		})
+		if err == nil {
+			return
+		}
+
+		delay := utils.HalfJitter(time.Minute)
+		log.WithError(err).Errorf("DynamoDB FieldsMap migration failed, retrying in %f seconds", delay.Seconds())
+		select {
+		case <-time.After(delay):
+		case <-ctx.Done():
+			log.WithError(ctx.Err()).Error("DynamoDB FieldsMap migration cancelled")
+			return
+		}
+	}
+}
