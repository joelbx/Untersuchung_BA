+// encodeFieldsMap converts the JSON event representation into a DynamoDB map.
+// UseNumber preserves integer and decimal values while translating JSON values
+// to DynamoDB attributes.
+func encodeFieldsMap(data []byte) (map[string]interface{}, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	var trailing interface{}
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return nil, trace.BadParameter("event fields contain more than one JSON value")
+		}
+		return nil, trace.Wrap(err)
+	}
+
+	dynamoFields := dynamoNumberValues(fields).(map[string]interface{})
+	attributes, err := marshalMapPreservingEmptyCollections(dynamoFields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	decoded := make(map[string]interface{}, len(attributes))
+	for key, attribute := range attributes {
+		value, err := attributeValueToJSON(attribute)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		decoded[key] = value
+	}
+	if !reflect.DeepEqual(normalizeJSONNumbers(fields), normalizeJSONNumbers(decoded)) {
+		return nil, trace.BadParameter("event fields changed during DynamoDB map conversion")
+	}
