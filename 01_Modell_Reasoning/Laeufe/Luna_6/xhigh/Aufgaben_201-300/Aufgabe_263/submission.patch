+// migrateFieldsMap converts legacy JSON Fields strings to the native FieldsMap
+// attribute. Each fully written scan page advances a durable checkpoint, making
+// retries safe after interruption. The caller must hold fieldsMapMigrationLock.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	checkpointKey := l.fieldsMapMigrationFlagKey()
+	checkpoint := fieldsMapMigrationCheckpoint{}
+	checkpointItem, err := l.backend.Get(ctx, checkpointKey)
+	if err != nil && !trace.IsNotFound(err) {
+		return trace.Wrap(err)
+	}
+	if err == nil {
+		if err := json.Unmarshal(checkpointItem.Value, &checkpoint); err != nil {
+			return trace.WrapWithMessage(err, "failed to decode FieldsMap migration checkpoint")
+		}
+	}
+	if checkpoint.Complete {
+		log.Info("DynamoDB FieldsMap migration is already complete")
+		return nil
+	}
+
+	var totalMigrated int64
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+
+		scanOut, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			ExclusiveStartKey: checkpoint.LastEvaluatedKey,
+			ConsistentRead:    aws.Bool(true),
+			Limit:             aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+			TableName:         aws.String(l.Tablename),
+			FilterExpression:  aws.String("attribute_exists(#fields) AND attribute_not_exists(#fieldsMap)"),
+			ExpressionAttributeNames: map[string]*string{
+				"#fields":    aws.String(keyFields),
+				"#fieldsMap": aws.String(keyFieldsMap),
+			},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+
+		writeRequests := make([]*dynamodb.WriteRequest, 0, len(scanOut.Items))
+		for _, item := range scanOut.Items {
+			legacyFields := item[keyFields]
+			if legacyFields == nil || legacyFields.S == nil {
+				err := trace.BadParameter("legacy Fields attribute is missing or is not a string")
+				l.WithFields(log.Fields{
+					"SessionID":  eventSessionIDFromItem(item),
+					"EventIndex": eventIndexFromItem(item),
+				}).WithError(err).Error("Failed to migrate DynamoDB event Fields")
+				return err
+			}
+			fieldsMap, err := encodeFieldsMap([]byte(aws.StringValue(legacyFields.S)))
+			if err != nil {
+				l.WithFields(log.Fields{
+					"SessionID":  eventSessionIDFromItem(item),
+					"EventIndex": eventIndexFromItem(item),
+				}).WithError(err).Error("Failed to convert DynamoDB event Fields to FieldsMap")
+				return trace.WrapWithMessage(err, "failed converting event SessionID=%q EventIndex=%d", eventSessionIDFromItem(item), eventIndexFromItem(item))
+			}
+			attributes, err := marshalMapPreservingEmptyCollections(fieldsMap)
+			if err != nil {
+				l.WithFields(log.Fields{
+					"SessionID":  eventSessionIDFromItem(item),
+					"EventIndex": eventIndexFromItem(item),
+				}).WithError(err).Error("Failed to encode DynamoDB event FieldsMap")
+				return trace.WrapWithMessage(err, "failed encoding FieldsMap for event SessionID=%q EventIndex=%d", eventSessionIDFromItem(item), eventIndexFromItem(item))
+			}
+			item[keyFieldsMap] = &dynamodb.AttributeValue{M: attributes}
+			delete(item, keyFields)
+			writeRequests = append(writeRequests, &dynamodb.WriteRequest{
+				PutRequest: &dynamodb.PutRequest{Item: item},
+			})
+		}
+
+		batches := make([][]*dynamodb.WriteRequest, 0, (len(writeRequests)+DynamoBatchSize-1)/DynamoBatchSize)
+		for len(writeRequests) > 0 {
+			top := DynamoBatchSize
+			if len(writeRequests) < top {
+				top = len(writeRequests)
+			}
+			batches = append(batches, append([]*dynamodb.WriteRequest(nil), writeRequests[:top]...))
+			writeRequests = writeRequests[top:]
+		}
+
+		workerErrors := make(chan error, len(batches))
+		var workers sync.WaitGroup
+		var migrated atomic.Int32
+		for _, batch := range batches {
+			batch := batch
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				if err := l.uploadFieldsMapBatch(ctx, batch); err != nil {
+					first := batch[0].PutRequest.Item
+					workerErrors <- trace.WrapWithMessage(err, "failed writing FieldsMap batch starting at SessionID=%q EventIndex=%d", eventSessionIDFromItem(first), eventIndexFromItem(first))
+					return
+				}
+				current := migrated.Add(int32(len(batch)))
+				l.Infof("Migrated %d events to FieldsMap for table %s", totalMigrated+int64(current), l.Tablename)
+			}()
+		}
+		workers.Wait()
+		close(workerErrors)
+		for err := range workerErrors {
+			return trace.Wrap(err)
+		}
+		totalMigrated += int64(len(scanOut.Items))
+
+		checkpoint.LastEvaluatedKey = scanOut.LastEvaluatedKey
+		checkpoint.Complete = scanOut.LastEvaluatedKey == nil
+		checkpointData, err := json.Marshal(checkpoint)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		if _, err := l.backend.Put(ctx, backend.Item{Key: checkpointKey, Value: checkpointData}); err != nil {
+			return trace.WrapWithMessage(err, "failed to save FieldsMap migration checkpoint")
+		}
+		if checkpoint.Complete {
+			log.Infof("Completed DynamoDB FieldsMap migration for table %s; migrated %d events", l.Tablename, totalMigrated)
+			return nil
+		}
+	}
+}
