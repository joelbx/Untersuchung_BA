+function toFiniteNumber(value) {
+	if (value === null || value === undefined || value === '') {
+		return null;
+	}
+	const number = Number(value);
+	return Number.isFinite(number) ? number : null;
+}
+
+function validateToken(token) {
+	if (typeof token !== 'string' || !token.length) {
+		throw new Error('[[error:invalid-data]]');
+	}
+}
+
+apiUtils.tokens = {};
+
+apiUtils.tokens.list = async function () {
+	const tokens = await db.getSortedSetRange(tokenKeys.creationTime, 0, -1);
+	if (!tokens.length) {
+		return [];
+	}
+	const tokenData = await apiUtils.tokens.get(tokens);
+	return tokenData.filter(Boolean);
+};
+
+apiUtils.tokens.get = async function (tokens) {
+	if (tokens === null || tokens === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const singular = !Array.isArray(tokens);
+	const tokenList = singular ? [tokens] : tokens;
+	tokenList.forEach(validateToken);
+	if (!tokenList.length) {
+		return [];
+	}
+
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenList.map(token => `token:${token}`), ['uid', 'description', 'timestamp']),
+		apiUtils.tokens.getLastSeen(tokenList),
+	]);
+	const hydrated = objects.map((data, index) => {
+		if (!data) {
+			return null;
+		}
+
+		const uid = toFiniteNumber(data.uid);
+		const timestamp = toFiniteNumber(data.timestamp);
+		if (uid === null || timestamp === null) {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		return {
+			token: tokenList[index],
+			uid,
+			description: data.description === undefined ? null : data.description,
+			timestamp,
+			lastSeen: toFiniteNumber(lastSeen[index]),
+		};
+	});
+
+	return singular ? hydrated[0] : hydrated;
+};
+
+apiUtils.tokens.generate = async function (data) {
+	if (!data || !['number', 'string'].includes(typeof data.uid) ||
+		(typeof data.uid === 'string' && !data.uid.trim())) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const uid = Number(data.uid);
+	if (!Number.isSafeInteger(uid)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (data.description !== undefined && data.description !== null && typeof data.description !== 'string') {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (uid !== 0 && !await user.exists(uid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = utils.generateUUID();
+	const timestamp = Date.now();
+	if (!Number.isFinite(timestamp)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+
+	const tokenData = { uid, timestamp };
+	if (data.description !== undefined && data.description !== null) {
+		tokenData.description = data.description;
+	}
+
+	await Promise.all([
+		db.setObject(`token:${token}`, tokenData),
+		db.sortedSetAdd(tokenKeys.creationTime, timestamp, token),
+		db.sortedSetAdd(tokenKeys.uid, uid, token),
+	]);
+	return token;
+};
+
+apiUtils.tokens.update = async function (token, data) {
+	validateToken(token);
+	if (!data || !Object.prototype.hasOwnProperty.call(data, 'description') || typeof data.description !== 'string') {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!await db.getObject(`token:${token}`)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.setObjectField(`token:${token}`, 'description', data.description);
+	return await apiUtils.tokens.get(token);
+};
+
+apiUtils.tokens.delete = async function (token) {
+	validateToken(token);
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove(Object.values(tokenKeys), token),
+	]);
+};
+
+apiUtils.tokens.log = async function (token) {
+	validateToken(token);
+	const timestamp = Date.now();
+	if (!Number.isFinite(timestamp)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.sortedSetAdd(tokenKeys.lastSeen, timestamp, token);
+};
 
