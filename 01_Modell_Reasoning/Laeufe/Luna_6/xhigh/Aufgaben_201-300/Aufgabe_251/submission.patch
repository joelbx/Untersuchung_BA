+// Result contains all validation errors found in a document.
+type Result struct {
+	Errors []Error `json:"errors"`
+}
+
+// FeaturesValidator holds the CUE context and schema used to validate feature files.
+type FeaturesValidator struct {
+	cue *cue.Context
+	v   cue.Value
+}
+
+// NewFeaturesValidator compiles the embedded feature schema.
+func NewFeaturesValidator() (*FeaturesValidator, error) {
+	cctx := cuecontext.New()
+	v := cctx.CompileBytes(cueFile)
+	if err := v.Err(); err != nil {
+		return nil, err
+	}
+
+	return &FeaturesValidator{cue: cctx, v: v}, nil
+}
+
 // Error is a collection of fields that represent positions in files where the user
 // has made some kind of error.
 type Error struct {
 	Message  string   `json:"message"`
+	Path     string   `json:"path,omitempty"`
 	Location Location `json:"location"`
 }
 
+// Validate checks YAML content against the feature schema and returns every
+// validation error with its field path and source location.
+func (fv *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	f, err := yaml.Extract(file, b)
+	if err != nil {
+		return resultFromError(file, err), ErrValidationFailed
+	}
+
+	yv := fv.cue.BuildFile(f, cue.Scope(fv.v))
+	if err := fv.v.Unify(yv).Validate(cue.All()); err != nil {
+		return resultFromError(file, err), ErrValidationFailed
+	}
+
+	return Result{Errors: []Error{}}, nil
+}
+
+func resultFromError(file string, err error) Result {
+	ce := cueerror.Errors(err)
+	result := Result{Errors: make([]Error, 0, len(ce))}
+	for _, m := range ce {
+		path := strings.Join(m.Path(), ".")
+		format, args := m.Msg()
+		message := fmt.Sprintf(format, args...)
+		if path != "" {
+			message = path + ": " + message
+		}
+
+		location := Location{File: file}
+		fallbackLine, fallbackColumn := 0, 0
+		for _, pos := range m.InputPositions() {
+			if pos.Line() == 0 || pos.Filename() == "" {
+				continue
+			}
+			if file == "" || pos.Filename() == file {
+				location.Line = pos.Line()
+				location.Column = pos.Column()
+				break
+			}
+			if fallbackLine == 0 {
+				fallbackLine = pos.Line()
+				fallbackColumn = pos.Column()
+			}
+		}
+		if location.Line == 0 {
+			location.Line = fallbackLine
+			location.Column = fallbackColumn
+		}
+
+		result.Errors = append(result.Errors, Error{
+			Message:  message,
+			Path:     path,
+			Location: location,
+		})
+	}
+
+	if len(result.Errors) == 0 {
+		result.Errors = append(result.Errors, Error{
+			Message:  err.Error(),
+			Location: Location{File: file},
+		})
+	}
+
+	return result
+}
