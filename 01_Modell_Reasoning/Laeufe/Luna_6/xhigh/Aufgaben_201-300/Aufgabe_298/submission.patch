-	data *ttlcache.Cache[K, V]
+	data             *ttlcache.Cache[K, V]
+	evictionDeadline atomic.Pointer[time.Time]
+}
+
+const evictionRetryInterval = time.Second
+
+// evictExpired removes expired items when the next known expiration is due.
+// The deadline makes the check on normal cache operations cheap while ensuring
+// that expiry is actively processed as soon as the cache is used again.
+func (c *simpleCache[K, V]) evictExpired() {
+	deadline := c.evictionDeadline.Load()
+	now := time.Now()
+	if deadline == nil || now.Before(*deadline) {
+		return
+	}
+
+	// Claim this eviction and keep other callers from scanning concurrently.
+	claim := now.Add(evictionRetryInterval)
+	if !c.evictionDeadline.CompareAndSwap(deadline, &claim) {
+		return
+	}
+
+	c.data.DeleteExpired()
+
+	// Schedule the next sweep for the earliest active expiry, or retry
+	// periodically in case an item expires while this sweep is in progress.
+	nextDeadline := time.Now().Add(evictionRetryInterval)
+	for _, item := range c.data.Items() {
+		expiresAt := item.ExpiresAt()
+		if !expiresAt.IsZero() && expiresAt.Before(nextDeadline) {
+			nextDeadline = expiresAt
+		}
+	}
+	c.evictionDeadline.CompareAndSwap(&claim, &nextDeadline)
+}
+
+func (c *simpleCache[K, V]) scheduleEviction(expiresAt time.Time) {
+	if expiresAt.IsZero() {
+		return
+	}
+
+	deadline := expiresAt
+	for {
+		current := c.evictionDeadline.Load()
+		if current != nil && !deadline.Before(*current) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(current, &deadline) {
+			return
+		}
+	}
 }
 
