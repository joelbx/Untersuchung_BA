@@ -80,12 +81,28 @@ class GUIProcess(QObject):
 
     @pyqtSlot(QProcess.ProcessError)
     def _on_error(self, error):
-        """Show a message if there was an error while spawning."""
-        if error == QProcess.Crashed and not utils.is_windows:
-            # Already handled via ExitStatus in _on_finished
-            return
+        """Show a message if there was an error with the process."""
+        error_types = {
+            QProcess.FailedToStart: "failed to start",
+            QProcess.Crashed: "crashed",
+            QProcess.Timedout: "timed out",
+            QProcess.WriteError: "write error",
+            QProcess.ReadError: "read error",
+            QProcess.UnknownError: "unknown error",
+        }
+        error_type = error_types.get(error, "unknown error")
         msg = self._proc.errorString()
-        message.error("Error while spawning {}: {}".format(self._what, msg))
+        error_msg = "{} '{}' {}: {}".format(
+            self._what.capitalize(), self.cmd, error_type, msg)
+
+        if (error == QProcess.FailedToStart and not utils.is_windows and
+                msg.endswith(("No such file or directory",
+                              "Permission denied"))):
+            error_msg += (" (Hint: Make sure '{}' exists and is executable)"
+                          .format(self.cmd))
+
+        self._error_reported = True
+        message.error(error_msg)
 
