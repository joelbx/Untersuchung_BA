+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Classify ISBN strings by their trimmed length, without validating them."""
+    isbn_10 = []
+    isbn_13 = []
+
+    # Internet Archive sometimes stores one ISBN as a string and sometimes
+    # stores multiple ISBNs in a list.
+    values = [isbns] if isinstance(isbns, str) else isbns
+
+    for isbn in values:
+        isbn = isbn.strip()
+        if len(isbn) == 10:
+            isbn_10.append(isbn)
+        elif len(isbn) == 13:
+            isbn_13.append(isbn)
+
+    return isbn_10, isbn_13
