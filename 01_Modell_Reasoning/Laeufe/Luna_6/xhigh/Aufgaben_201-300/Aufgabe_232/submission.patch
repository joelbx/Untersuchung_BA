@@ -0,0 +1,181 @@
+package config
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+const (
+	// RedHat identifies Red Hat Enterprise Linux.
+	RedHat = "redhat"
+	// Debian identifies Debian GNU/Linux.
+	Debian = "debian"
+	// Ubuntu identifies Ubuntu.
+	Ubuntu = "ubuntu"
+	// CentOS identifies CentOS.
+	CentOS = "centos"
+	// Fedora identifies Fedora.
+	Fedora = "fedora"
+	// Amazon identifies Amazon Linux.
+	Amazon = "amazon"
+	// Oracle identifies Oracle Linux.
+	Oracle = "oracle"
+	// FreeBSD identifies FreeBSD.
+	FreeBSD = "freebsd"
+	// Raspbian identifies Raspbian.
+	Raspbian = "raspbian"
+	// Windows identifies Windows.
+	Windows = "windows"
+	// OpenSUSE identifies openSUSE.
+	OpenSUSE = "opensuse"
+	// OpenSUSELeap identifies openSUSE Leap.
+	OpenSUSELeap = "opensuse.leap"
+	// SUSEEnterpriseServer identifies SUSE Linux Enterprise Server.
+	SUSEEnterpriseServer = "suse.linux.enterprise.server"
+	// SUSEEnterpriseDesktop identifies SUSE Linux Enterprise Desktop.
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	// SUSEOpenstackCloud identifies SUSE OpenStack Cloud.
+	SUSEOpenstackCloud = "suse.openstack.cloud"
+	// Alpine identifies Alpine Linux.
+	Alpine = "alpine"
+
+	// Pseudo identifies a host represented by manually supplied data.
+	Pseudo = "pseudo"
+	// ServerTypePseudo is used for ServerInfo.Type and Distro.Family.
+	ServerTypePseudo = Pseudo
+)
+
+// EOL holds the end dates of the standard and extended support phases.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether now is strictly after the standard support end date.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether now is strictly after the extended support end date.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+// IsExtendedSupportEnded is the correctly spelled alias for IsExtendedSuppportEnded.
+func (e EOL) IsExtendedSupportEnded(now time.Time) bool {
+	return e.IsExtendedSuppportEnded(now)
+}
+
+var eolData = map[string]map[string]EOL{
+	Amazon: {
+		"2018.03":   {StandardSupportUntil: eolDate("2023-06-30"), ExtendedSupportUntil: eolDate("2023-06-30")},
+		"2 (Karoo)": {StandardSupportUntil: eolDate("2025-06-30")},
+	},
+	RedHat: {
+		"7": {StandardSupportUntil: eolDate("2024-06-30")},
+		"8": {StandardSupportUntil: eolDate("2029-05-31")},
+		"6": {StandardSupportUntil: eolDate("2020-11-30"), ExtendedSupportUntil: eolDate("2024-06-30")},
+	},
+	CentOS: {
+		"7": {StandardSupportUntil: eolDate("2024-06-30")},
+		"8": {StandardSupportUntil: eolDate("2021-12-31")},
+		"6": {StandardSupportUntil: eolDate("2020-11-30"), ExtendedSupportUntil: eolDate("2020-11-30")},
+	},
+	Oracle: {
+		"7": {StandardSupportUntil: eolDate("2024-06-30")},
+		"8": {StandardSupportUntil: eolDate("2029-05-31")},
+		"6": {StandardSupportUntil: eolDate("2021-03-31"), ExtendedSupportUntil: eolDate("2022-03-31")},
+	},
+	Ubuntu: {
+		"18.04": {StandardSupportUntil: eolDate("2023-05-31"), ExtendedSupportUntil: eolDate("2028-04-30")},
+		"14.04": {StandardSupportUntil: eolDate("2019-04-30"), ExtendedSupportUntil: eolDate("2024-04-30")},
+		"14.10": {StandardSupportUntil: eolDate("2015-07-30"), ExtendedSupportUntil: eolDate("2015-07-30")},
+		"21.04": {StandardSupportUntil: eolDate("2022-01-30")},
+	},
+	Debian: {
+		"9":  {StandardSupportUntil: eolDate("2022-06-30")},
+		"10": {StandardSupportUntil: eolDate("2024-06-30")},
+		"8":  {StandardSupportUntil: eolDate("2020-06-30"), ExtendedSupportUntil: eolDate("2020-06-30")},
+	},
+	Alpine: {
+		"3.10": {StandardSupportUntil: eolDate("2021-05-30")},
+		"3.11": {StandardSupportUntil: eolDate("2021-11-30")},
+		"3.12": {StandardSupportUntil: eolDate("2022-05-30")},
+		"3.9":  {StandardSupportUntil: eolDate("2020-11-30"), ExtendedSupportUntil: eolDate("2020-11-30")},
+	},
+	FreeBSD: {
+		"11": {StandardSupportUntil: eolDate("2021-09-30"), ExtendedSupportUntil: eolDate("2021-09-30")},
+		"12": {StandardSupportUntil: eolDate("2023-12-31")},
+		"10": {StandardSupportUntil: eolDate("2019-10-30"), ExtendedSupportUntil: eolDate("2019-10-30")},
+	},
+}
+
+func eolDate(value string) time.Time {
+	d, err := time.Parse("2006-01-02", value)
+	if err != nil {
+		panic(fmt.Sprintf("invalid EOL date %q: %v", value, err))
+	}
+	return d
+}
+
+// GetEOL returns lifecycle data for a supported OS family and release.
+// Releases with patch or minor suffixes match the corresponding modeled major release.
+func GetEOL(family, release string) (EOL, bool) {
+	releases, ok := eolData[family]
+	if !ok {
+		return EOL{}, false
+	}
+
+	release = strings.TrimSpace(release)
+	eol, ok := releases[release]
+	if !ok {
+		// OS detectors commonly append a patch/minor identifier to a modeled
+		// release (for example, 7.9 or 8.10). Match only on version separators.
+		bestMatch := ""
+		for candidate := range releases {
+			if len(candidate) <= len(bestMatch) || !strings.HasPrefix(release, candidate) {
+				continue
+			}
+			suffix := release[len(candidate):]
+			if strings.HasPrefix(suffix, ".") || strings.HasPrefix(suffix, "-") {
+				bestMatch = candidate
+			}
+		}
+		if bestMatch == "" {
+			return EOL{}, false
+		}
+		eol = releases[bestMatch]
+	}
+	eol.Ended = eol.IsStandardSupportEnded(time.Now())
+	return eol, true
+}
+
+// EOLWarnings evaluates lifecycle data and returns warnings in display order.
+func EOLWarnings(family, release string, now time.Time) []string {
+	if family == ServerTypePseudo || family == Raspbian {
+		return nil
+	}
+	eol, found := GetEOL(family, release)
+	if !found {
+		return []string{fmt.Sprintf("Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: %s Release: %s'", family, release)}
+	}
+
+	if !eol.IsStandardSupportEnded(now) {
+		if !eol.StandardSupportUntil.After(now) || !eol.StandardSupportUntil.After(now.AddDate(0, 3, 0)) {
+			return []string{fmt.Sprintf("Standard OS support will be end in 3 months. EOL date: %s", eol.StandardSupportUntil.Format("2006-01-02"))}
+		}
+		return nil
+	}
+
+	warnings := []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended."}
+	if !eol.ExtendedSupportUntil.IsZero() {
+		if eol.IsExtendedSuppportEnded(now) {
+			warnings = append(warnings, "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.")
+		} else {
+			warnings = append(warnings, fmt.Sprintf("Extended support available until %s. Check the vendor site.", eol.ExtendedSupportUntil.Format("2006-01-02")))
+		}
+	}
+	return warnings
+}
