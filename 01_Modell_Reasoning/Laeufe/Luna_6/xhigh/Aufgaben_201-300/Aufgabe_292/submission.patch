-// Poll is a utility function for a common polling strategy used by lots of declarative
-// store implementations.
-func (p *Poller) Poll(ctx context.Context, update func(context.Context) (bool, error)) {
+// Poll runs the polling loop. Call it in a goroutine to poll in the background.
+func (p *Poller) Poll() {
+	p.mu.Lock()
+	if p.closed || p.started {
+		p.mu.Unlock()
+		return
+	}
+	p.started = true
+	p.mu.Unlock()
+
+	defer close(p.done)
+
