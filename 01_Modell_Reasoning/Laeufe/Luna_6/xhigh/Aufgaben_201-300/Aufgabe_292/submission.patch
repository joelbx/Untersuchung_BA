 		}
 	}
 }
+
+// Close stops polling and waits for its goroutine to terminate.
+func (p *Poller) Close() error {
+	p.mu.Lock()
+	if !p.closed {
+		p.closed = true
+		p.cancel()
+		if !p.started {
+			close(p.done)
+		}
+	}
+	done := p.done
+	p.mu.Unlock()
+	<-done
+	return nil
+}
