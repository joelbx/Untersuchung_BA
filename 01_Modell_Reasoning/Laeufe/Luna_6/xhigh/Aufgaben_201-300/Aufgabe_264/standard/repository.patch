+class HTTPError(Exception):
+    """HTTP response error for statuses that are not retried."""
+
+    def __init__(self, message, status=None):
+        super(HTTPError, self).__init__(message)
+        self.status = status
+
+
+class RateLimitException(HTTPError):
+    """HTTP 429 response, which may be retried."""
+
+
+class InternalErrorException(HTTPError):
+    """HTTP 500 or 502 response, which may be retried."""
+
