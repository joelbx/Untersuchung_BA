+}
+
+func (s *Router) signAuthState(userID string) (string, error) {
+	if userID == "" {
+		return "", errors.New("missing user ID")
+	}
+	nonce := make([]byte, 16)
+	if _, err := rand.Read(nonce); err != nil {
+		return "", err
+	}
+	payload, err := json.Marshal(lastFMAuthState{
+		UserID:    userID,
+		ExpiresAt: time.Now().Add(lastFMAuthStateTTL).Unix(),
+		Nonce:     base64.RawURLEncoding.EncodeToString(nonce),
+	})
+	if err != nil {
+		return "", err
+	}
+	encodedPayload := base64.RawURLEncoding.EncodeToString(payload)
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(encodedPayload))
+	signature := base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+	return encodedPayload + "." + signature, nil
+}
+
+func (s *Router) verifyAuthState(state string) (string, error) {
+	parts := strings.Split(state, ".")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return "", errors.New("malformed LastFM auth state")
+	}
+	providedSignature, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", errors.New("malformed LastFM auth state")
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(parts[0]))
+	if !hmac.Equal(providedSignature, mac.Sum(nil)) {
+		return "", errors.New("invalid LastFM auth state signature")
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", errors.New("malformed LastFM auth state")
+	}
+	var authState lastFMAuthState
+	if err = json.Unmarshal(payload, &authState); err != nil || authState.UserID == "" || authState.Nonce == "" {
+		return "", errors.New("malformed LastFM auth state")
+	}
+	if time.Now().Unix() > authState.ExpiresAt {
+		return "", errors.New("expired LastFM auth state")
+	}
+	return authState.UserID, nil
+}
