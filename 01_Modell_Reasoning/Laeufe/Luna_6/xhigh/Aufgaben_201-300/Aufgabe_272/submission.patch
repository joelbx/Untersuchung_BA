+def get_ca_certs(cafile=None):
+    """Find CA certificates and return their path, data, and search paths."""
+    ca_certs = []
+    cadata = bytearray()
+    paths_checked = []
+
+    if cafile:
+        paths_checked = [cafile]
+        with open(to_bytes(cafile, errors='surrogate_or_strict'), 'rb') as f:
+            if HAS_SSLCONTEXT:
+                for b_pem in extract_pem_certs(f.read()):
+                    cadata.extend(ssl.PEM_cert_to_DER_cert(to_native(b_pem, errors='surrogate_or_strict')))
+        return cafile, cadata, paths_checked
+
+    if not HAS_SSLCONTEXT:
+        paths_checked.append('/etc/ssl/certs')
+
+    system = to_text(platform.system(), errors='surrogate_or_strict')
+    if system == u'Linux':
+        paths_checked.extend(('/etc/pki/ca-trust/extracted/pem', '/etc/pki/tls/certs',
+                              '/usr/share/ca-certificates/cacert.org'))
+    elif system == u'FreeBSD':
+        paths_checked.append('/usr/local/share/certs')
+    elif system == u'OpenBSD':
+        paths_checked.append('/etc/ssl')
+    elif system == u'NetBSD':
+        ca_certs.append('/etc/openssl/certs')
+    elif system == u'SunOS':
+        paths_checked.append('/opt/local/etc/openssl/certs')
+    elif system == u'AIX':
+        paths_checked.extend(('/var/ssl/certs', '/opt/freeware/etc/ssl/certs'))
+
+    paths_checked.append('/etc/ansible')
+
+    tmp_path = None
+    if not HAS_SSLCONTEXT:
+        tmp_fd, tmp_path = tempfile.mkstemp()
+        atexit.register(atexit_remove_file, tmp_path)
+
+    if system == u'Darwin':
+        if HAS_SSLCONTEXT:
+            cadata.extend(ssl.PEM_cert_to_DER_cert(to_native(b_DUMMY_CA_CERT, errors='surrogate_or_strict')))
+        else:
+            os.write(tmp_fd, b_DUMMY_CA_CERT)
+        paths_checked.append('/usr/local/etc/openssl')
+
+    for path in paths_checked:
+        if os.path.exists(path) and os.path.isdir(path):
+            for filename in os.listdir(path):
+                full_path = os.path.join(path, filename)
+                if os.path.isfile(full_path) and os.path.splitext(filename)[1] in ('.crt', '.pem'):
+                    try:
+                        if full_path not in LOADED_VERIFY_LOCATIONS:
+                            with open(full_path, 'rb') as cert_file:
+                                b_cert = cert_file.read()
+                            if HAS_SSLCONTEXT:
+                                try:
+                                    for b_pem in extract_pem_certs(b_cert):
+                                        cadata.extend(ssl.PEM_cert_to_DER_cert(
+                                            to_native(b_pem, errors='surrogate_or_strict')))
+                                except Exception:
+                                    continue
+                            else:
+                                os.write(tmp_fd, b_cert)
+                                os.write(tmp_fd, b'\n')
+                    except (OSError, IOError):
+                        pass
+
+    if HAS_SSLCONTEXT:
+        default_verify_paths = ssl.get_default_verify_paths()
+        paths_checked[:0] = [default_verify_paths.capath]
+    else:
+        os.close(tmp_fd)
+
+    return tmp_path, cadata, paths_checked
+
+
+def make_context(cafile=None, cadata=None, ciphers=None, validate_certs=True):
+    """Create an SSL context with certificate and cipher settings."""
+    if HAS_SSLCONTEXT:
+        if validate_certs:
+            context = create_default_context(cafile=cafile)
+        else:
+            context = SSLContext(ssl.PROTOCOL_SSLv23)
+            if getattr(ssl, 'OP_NO_SSLv2', 0):
+                context.options |= ssl.OP_NO_SSLv2
+            if getattr(ssl, 'OP_NO_SSLv3', 0):
+                context.options |= ssl.OP_NO_SSLv3
+            context.verify_mode = ssl.CERT_NONE
+            context.check_hostname = False
+    elif HAS_URLLIB3_PYOPENSSLCONTEXT:
+        context = PyOpenSSLContext(getattr(ssl, 'PROTOCOL_SSLv23', PROTOCOL))
+        if validate_certs:
+            context.verify_mode = ssl.CERT_REQUIRED
+        else:
+            context.verify_mode = ssl.CERT_NONE
+            options = getattr(context, 'options', 0)
+            options |= getattr(ssl, 'OP_NO_SSLv2', 0) | getattr(ssl, 'OP_NO_SSLv3', 0)
+            context.options = options
+    else:
+        if ciphers is not None:
+            raise CipherValidationError('TLS cipher suites are not supported by this Python SSL implementation')
+        raise NotImplementedError('Host libraries are too old to support creating an sslcontext')
+
+    if validate_certs and (cafile or cadata):
+        try:
+            context.load_verify_locations(cafile=cafile, cadata=bytes(cadata) if cadata else None)
+        except TypeError:
+            # Some older SSLContext implementations only accept text or bytes.
+            context.load_verify_locations(cafile=cafile, cadata=to_bytes(cadata) if cadata else None)
+
+    if ciphers is not None:
+        if isinstance(ciphers, string_types):
+            cipher_string = ciphers
+        elif isinstance(ciphers, (list, tuple)) and all(isinstance(cipher, string_types) for cipher in ciphers):
+            if any(not cipher.strip() for cipher in ciphers):
+                raise CipherValidationError('TLS cipher suite configuration cannot contain empty values')
+            cipher_string = ':'.join(ciphers)
+        else:
+            raise CipherValidationError('TLS ciphers must be a string or a list of strings')
+        if not cipher_string:
+            raise CipherValidationError('TLS cipher suite configuration cannot be empty')
+        try:
+            context.set_ciphers(cipher_string)
+        except Exception:
+            # Do not include the supplied value in errors returned to users.
+            raise CipherValidationError('Invalid or unsupported TLS cipher suite configuration')
+
+    return context
+
