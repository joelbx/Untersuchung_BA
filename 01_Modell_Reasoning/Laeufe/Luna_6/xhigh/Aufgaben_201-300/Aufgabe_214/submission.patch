diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..b875ef4
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,123 @@
+package scanner
+
+import (
+	"bufio"
+	"bytes"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+	"golang.org/x/xerrors"
+)
+
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		code := technique.String()
+		if technique == config.NotSupportTechnique || code == "NotSupportTechnique" {
+			return nil, xerrors.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+code)
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil || conf.ScannerBinPath == "" {
+		return nil, xerrors.Errorf("external port scanner is enabled but scannerBinPath is empty")
+	}
+
+	techniqueOptions, err := setScanTechniques(conf.GetScanTechniques())
+	if err != nil {
+		return nil, err
+	}
+	privilegeOption := "--unprivileged"
+	if conf.HasPrivileged {
+		privilegeOption = "--privileged"
+	}
+
+	ips := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	openPorts := []string{}
+	for _, ip := range ips {
+		if strings.HasPrefix(ip, "-") || (!isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback()) {
+			continue
+		}
+		ports := make([]string, 0, len(scanDestIPPorts[ip]))
+		seen := map[string]struct{}{}
+		for _, rawPort := range scanDestIPPorts[ip] {
+			port, parseErr := strconv.Atoi(rawPort)
+			if parseErr != nil || port < 1 || port > 65535 {
+				continue
+			}
+			if _, ok := seen[rawPort]; !ok {
+				seen[rawPort] = struct{}{}
+				ports = append(ports, rawPort)
+			}
+		}
+		if len(ports) == 0 {
+			continue
+		}
+		sort.Strings(ports)
+		options := []string{"-n", "-Pn", "-p", strings.Join(ports, ","), "-oG", "-", privilegeOption}
+		options = append(options, techniqueOptions...)
+		if conf.SourcePort != "" {
+			options = append(options, "-g", conf.SourcePort)
+		}
+		options = append(options, ip)
+
+		cmd := osexec.Command(conf.ScannerBinPath, options...)
+		var stderr bytes.Buffer
+		cmd.Stderr = &stderr
+		stdout, runErr := cmd.Output()
+		if runErr != nil {
+			return nil, xerrors.Errorf("nmap scan failed for %s (options: %s): %w: %s",
+				ip, formatNmapOptionsToString(options), runErr, strings.TrimSpace(stderr.String()))
+		}
+		openPorts = append(openPorts, parseNmapGrepableOutput(string(stdout))...)
+	}
+	return openPorts, nil
+}
+
+func parseNmapGrepableOutput(output string) []string {
+	openPorts := []string{}
+	scanner := bufio.NewScanner(strings.NewReader(output))
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if !strings.HasPrefix(line, "Host:") {
+			continue
+		}
+		hostFields := strings.Fields(strings.TrimPrefix(line, "Host:"))
+		if len(hostFields) == 0 {
+			continue
+		}
+		host := hostFields[0]
+		portsMarker := strings.Index(line, "Ports:")
+		if portsMarker < 0 {
+			continue
+		}
+		for _, entry := range strings.Split(line[portsMarker+len("Ports:"):], ",") {
+			fields := strings.Split(strings.TrimSpace(entry), "/")
+			if len(fields) < 3 || fields[1] != "open" || fields[2] != "tcp" {
+				continue
+			}
+			port, err := strconv.Atoi(fields[0])
+			if err != nil || port < 1 || port > 65535 {
+				continue
+			}
+			openPorts = append(openPorts, host+":"+fields[0])
+		}
+	}
+	return openPorts
+}
