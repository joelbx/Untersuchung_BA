diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..0d33aa0
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,194 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	osexec "os/exec"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// PortScanConf configures optional port scanning with an external scanner.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath,omitempty" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques,omitempty" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged,omitempty" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort,omitempty" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+// ScanTechnique is a supported nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	TCPSYN ScanTechnique = iota
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+	NotSupportTechnique
+)
+
+// String returns the nmap scan option code for this technique.
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	case NotSupportTechnique:
+		return "NotSupportTechnique"
+	default:
+		return "NotSupportTechnique"
+	}
+}
+
+// GetScanTechniques translates configured nmap option codes to scan types.
+// Unrecognized values are retained as NotSupportTechnique entries so callers
+// can report each invalid configuration value.
+func (c *PortScanConf) GetScanTechniques() []ScanTechnique {
+	if c == nil || len(c.ScanTechniques) == 0 {
+		return []ScanTechnique{}
+	}
+
+	techniques := make([]ScanTechnique, 0, len(c.ScanTechniques))
+	for _, configured := range c.ScanTechniques {
+		switch strings.ToLower(configured) {
+		case "ss":
+			techniques = append(techniques, TCPSYN)
+		case "st":
+			techniques = append(techniques, TCPConnect)
+		case "sa":
+			techniques = append(techniques, TCPACK)
+		case "sw":
+			techniques = append(techniques, TCPWindow)
+		case "sm":
+			techniques = append(techniques, TCPMaimon)
+		case "sn":
+			techniques = append(techniques, TCPNull)
+		case "sf":
+			techniques = append(techniques, TCPFIN)
+		case "sx":
+			techniques = append(techniques, TCPXmas)
+		default:
+			techniques = append(techniques, NotSupportTechnique)
+		}
+	}
+	return techniques
+}
+
+// IsZero reports whether no port scan settings were supplied.
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+// Validate checks the external scanner configuration.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() && !c.IsUseExternalScanner {
+		return nil
+	}
+
+	validScanner := false
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required when portscan options are set"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q does not exist: %w", c.ScannerBinPath, err))
+	} else if !info.Mode().IsRegular() {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q is not a regular file", c.ScannerBinPath))
+	} else if info.Mode().Perm()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q is not executable", c.ScannerBinPath))
+	} else {
+		validScanner = true
+	}
+
+	techniques := c.GetScanTechniques()
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique: %q", c.ScanTechniques[i]))
+		}
+	}
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported; specify at most one"))
+	}
+	if !c.HasPrivileged {
+		for _, technique := range techniques {
+			if technique != NotSupportTechnique && technique != TCPConnect {
+				errs = append(errs, fmt.Errorf("scan technique %q requires hasPrivileged = true", technique.String()))
+				break
+			}
+		}
+	}
+	for _, technique := range techniques {
+		if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("sourcePort cannot be used with TCPConnect"))
+			break
+		}
+	}
+	if len(techniques) == 0 && !c.HasPrivileged && c.SourcePort != "" {
+		errs = append(errs, fmt.Errorf("sourcePort cannot be used with the default unprivileged TCPConnect scan"))
+	}
+
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort must be an integer between 0 and 65535: %q", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort 0 is not a usable source port"))
+		}
+	}
+
+	if validScanner && c.HasPrivileged && os.Geteuid() != 0 {
+		if err := validateScannerCapabilities(c.ScannerBinPath); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errs
+}
+
+var capabilityListPattern = regexp.MustCompile(`^cap_[a-z0-9_]+(?:,cap_[a-z0-9_]+)*[=+][eip]+$`)
+
+func validateScannerCapabilities(scannerPath string) error {
+	getcapPath, err := osexec.LookPath("getcap")
+	if err != nil {
+		return fmt.Errorf("cannot check capabilities for %q: getcap is unavailable: %w", scannerPath, err)
+	}
+	output, err := osexec.Command(getcapPath, scannerPath).Output()
+	if err != nil {
+		return fmt.Errorf("cannot check capabilities for %q: %w", scannerPath, err)
+	}
+	line := strings.TrimSpace(string(output))
+	if line == "" {
+		return fmt.Errorf("scanner %q has no capabilities; cap_net_raw is required when hasPrivileged is true", scannerPath)
+	}
+	fields := strings.Fields(line)
+	if len(fields) == 3 && fields[1] == "=" {
+		fields = []string{fields[0], fields[2]}
+	}
+	if len(fields) != 2 || filepath.Clean(fields[0]) != filepath.Clean(scannerPath) || !capabilityListPattern.MatchString(fields[1]) {
+		return fmt.Errorf("malformed capability data for %q: %q", scannerPath, line)
+	}
+	capabilities := strings.FieldsFunc(fields[1], func(r rune) bool { return r == ',' || r == '=' || r == '+' })
+	for _, capability := range capabilities {
+		if capability == "cap_net_raw" {
+			return nil
+		}
+	}
+	return fmt.Errorf("scanner %q is missing the cap_net_raw capability", scannerPath)
+}
