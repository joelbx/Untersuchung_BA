@@ -1,6 +1,7 @@
 'use strict';
 
 const path = require('path');
+const nconf = require('nconf');
 
 const db = require('../database');
 const image = require('../image');
@@ -62,6 +63,32 @@ module.exports = function (Groups) {
 	};
 
 	Groups.removeCover = async function (data) {
-		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
+		const groupData = await Groups.getGroupFields(data.groupName, ['cover:url', 'cover:thumb:url']) || {};
+		const localPaths = [
+			getLocalCoverPath(groupData['cover:url']),
+			getLocalCoverPath(groupData['cover:thumb:url']),
+		].filter(Boolean);
+
+		await Promise.all([
+			...[...new Set(localPaths)].map(file.delete),
+			db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']),
+		]);
 	};
+
+	function getLocalCoverPath(url) {
+		const relativePath = (nconf.get('relative_path') || '').replace(/\/$/, '');
+		const urlPrefix = `${relativePath}/assets/uploads/files/`;
+		if (typeof url !== 'string' || !url.startsWith(urlPrefix)) {
+			return false;
+		}
+
+		const filename = url.slice(urlPrefix.length);
+		if (!filename || filename !== path.basename(filename) || filename.includes('?') || filename.includes('#')) {
+			return false;
+		}
+
+		const filesPath = path.resolve(nconf.get('upload_path'), 'files');
+		const localPath = path.resolve(filesPath, filename);
+		return path.dirname(localPath) === filesPath ? localPath : false;
+	}
 };
