index 4367914..8bd4eba 100644
--- a/src/user/delete.js
+++ b/src/user/delete.js
@@ -2,6 +2,7 @@
 
 const async = require('async');
 const _ = require('lodash');
+const fs = require('fs');
 const path = require('path');
 const nconf = require('nconf');
 
@@ -217,11 +218,28 @@ module.exports = function (User) {
 	}
 
 	async function deleteImages(uid) {
-		const extensions = User.getAllowedProfileImageExtensions();
-		const folder = path.join(nconf.get('upload_path'), 'profile');
-		await Promise.all(extensions.map(async (ext) => {
-			await file.delete(path.join(folder, `${uid}-profilecover.${ext}`));
-			await file.delete(path.join(folder, `${uid}-profileavatar.${ext}`));
-		}));
+		const folder = path.resolve(nconf.get('upload_path'), 'profile');
+		let filenames;
+		try {
+			filenames = await fs.promises.readdir(folder);
+		} catch (err) {
+			if (err.code === 'ENOENT') {
+				return;
+			}
+			throw err;
+		}
+
+		const uidString = String(uid);
+		if (!/^\d+$/.test(uidString)) {
+			return;
+		}
+		const imagePattern = new RegExp(
+			`^${uidString}-profile(?:cover|avatar)(?:-[^.]+)?\\.(?:png|jpeg|jpg|bmp)$`,
+			'i'
+		);
+		const imagePaths = filenames
+			.filter(filename => imagePattern.test(filename))
+			.map(filename => path.join(folder, filename));
+		await Promise.all(imagePaths.map(file.delete));
 	}
 };
