 class ImportItem(web.storage):
+    @staticmethod
+    def find_staged_or_pending(
+        identifiers: list[str], sources: Iterable[str] = STAGED_SOURCES
+    ):
+        """Find staged or pending import items for the given identifiers."""
+        ia_ids = [
+            f"{source}:{identifier}"
+            for source in sources
+            for identifier in identifiers
+        ]
+        if not ia_ids:
+            return db.query("SELECT * FROM import_item WHERE 1 = 0")
+
+        return db.query(
+            "SELECT * FROM import_item "
+            "WHERE status IN ('staged', 'pending') AND ia_id IN $ia_ids",
+            vars={"ia_ids": ia_ids},
+        )
+
