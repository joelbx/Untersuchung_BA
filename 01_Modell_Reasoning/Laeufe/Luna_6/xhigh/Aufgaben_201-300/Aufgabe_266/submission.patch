 class TestImportItem:
+    def test_find_staged_or_pending(self, import_item_db):
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {
+                    'batch_id': 3,
+                    'ia_id': 'amazon:9780000000001',
+                    'status': 'staged',
+                },
+                {
+                    'batch_id': 3,
+                    'ia_id': 'idb:9780000000001',
+                    'status': 'pending',
+                },
+                {
+                    'batch_id': 3,
+                    'ia_id': 'amazon:9780000000002',
+                    'status': 'failed',
+                },
+                {
+                    'batch_id': 3,
+                    'ia_id': 'other:9780000000001',
+                    'status': 'staged',
+                },
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(
+            ['9780000000001', '9780000000002']
+        )
+
+        assert isinstance(STAGED_SOURCES, tuple)
+        assert set(STAGED_SOURCES) == {'amazon', 'idb'}
+        assert {(item.ia_id, item.status) for item in result} == {
+            ('amazon:9780000000001', 'staged'),
+            ('idb:9780000000001', 'pending'),
+        }
+
+    def test_find_staged_or_pending_accepts_source_iterable(self, import_item_db):
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'batch_id': 3, 'ia_id': 'custom:isbn', 'status': 'staged'},
+                {'batch_id': 3, 'ia_id': 'amazon:isbn', 'status': 'staged'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['isbn'], sources=iter(['custom']))
+
+        assert [item.ia_id for item in result] == ['custom:isbn']
+
+    def test_find_staged_or_pending_with_no_generated_ia_ids(self, import_item_db):
+        assert not ImportItem.find_staged_or_pending([])
+        assert not ImportItem.find_staged_or_pending(['isbn'], sources=[])
+
