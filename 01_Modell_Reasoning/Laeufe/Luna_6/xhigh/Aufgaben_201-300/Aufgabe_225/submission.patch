+type kevJSONEntry struct {
+	Type                       models.KEVType           `json:"type"`
+	VendorProject              string                   `json:"vendorProject"`
+	Vendor                     string                   `json:"vendor"`
+	Product                    string                   `json:"product"`
+	VulnerabilityName          string                   `json:"vulnerabilityName"`
+	ShortDescription           string                   `json:"shortDescription"`
+	RequiredAction             string                   `json:"requiredAction"`
+	KnownRansomwareCampaignUse string                   `json:"knownRansomwareCampaignUse"`
+	DateAdded                  string                   `json:"dateAdded"`
+	DueDate                    string                   `json:"dueDate"`
+	Note                       string                   `json:"note"`
+	Notes                      string                   `json:"notes"`
+	CISA                       *models.CISAKEV          `json:"cisa"`
+	VulnCheck                  *kevJSONVulnCheck        `json:"vulncheck"`
+	XDB                        []kevJSONXDB             `json:"xdb"`
+	ReportedExploitation       []kevJSONReportedExploit `json:"reportedExploitation"`
+}
+
+type kevJSONVulnCheck struct {
+	XDB                  []kevJSONXDB             `json:"xdb"`
+	ReportedExploitation []kevJSONReportedExploit `json:"reportedExploitation"`
+}
+
+type kevJSONXDB struct {
+	XDBID       string `json:"xdbID"`
+	ID          string `json:"id"`
+	XDBURL      string `json:"xdbURL"`
+	URL         string `json:"url"`
+	DateAdded   string `json:"dateAdded"`
+	ExploitType string `json:"exploitType"`
+	CloneSSHURL string `json:"cloneSSHURL"`
+}
+
+type kevJSONReportedExploit struct {
+	URL       string `json:"url"`
+	DateAdded string `json:"dateAdded"`
+}
+
+type kevJSONCatalog struct {
+	CISA      []kevJSONEntry `json:"cisa"`
+	VulnCheck []kevJSONEntry `json:"vulncheck"`
+	KEVs      []kevJSONEntry `json:"kevs"`
+}
+
+func decodeKEVs(data []byte) ([]models.KEV, error) {
+	var entries []kevJSONEntry
+	if err := json.Unmarshal(data, &entries); err != nil {
+		var catalog kevJSONCatalog
+		if catalogErr := json.Unmarshal(data, &catalog); catalogErr != nil {
+			return nil, err
+		}
+		for i := range catalog.CISA {
+			if catalog.CISA[i].Type == "" {
+				catalog.CISA[i].Type = models.CISAKEVType
+			}
+		}
+		for i := range catalog.VulnCheck {
+			if catalog.VulnCheck[i].Type == "" {
+				catalog.VulnCheck[i].Type = models.VulnCheckKEVType
+			}
+		}
+		entries = append(entries, catalog.CISA...)
+		entries = append(entries, catalog.VulnCheck...)
+		entries = append(entries, catalog.KEVs...)
+	}
+
+	kevs := make([]models.KEV, 0, len(entries))
+	for _, entry := range entries {
+		typ := models.KEVType(strings.ToLower(string(entry.Type)))
+		if typ == "" {
+			if entry.VulnCheck != nil || len(entry.XDB) > 0 || len(entry.ReportedExploitation) > 0 {
+				typ = models.VulnCheckKEVType
+			} else {
+				typ = models.CISAKEVType
+			}
+		}
+
+		vendor := entry.VendorProject
+		if vendor == "" {
+			vendor = entry.Vendor
+		}
+		kev := models.KEV{
+			Type:                       typ,
+			VendorProject:              vendor,
+			Product:                    entry.Product,
+			VulnerabilityName:          entry.VulnerabilityName,
+			ShortDescription:           entry.ShortDescription,
+			RequiredAction:             entry.RequiredAction,
+			KnownRansomwareCampaignUse: entry.KnownRansomwareCampaignUse,
+			DateAdded:                  parseKEVDate(entry.DateAdded),
+			DueDate:                    parseOptionalKEVDate(entry.DueDate),
+		}
+
+		switch typ {
+		case models.VulnCheckKEVType:
+			vulnCheck := &models.VulnCheckKEV{}
+			xdb := entry.XDB
+			reported := entry.ReportedExploitation
+			if entry.VulnCheck != nil {
+				xdb = append(xdb, entry.VulnCheck.XDB...)
+				reported = append(reported, entry.VulnCheck.ReportedExploitation...)
+			}
+			for _, x := range xdb {
+				id := x.XDBID
+				if id == "" {
+					id = x.ID
+				}
+				url := x.XDBURL
+				if url == "" {
+					url = x.URL
+				}
+				vulnCheck.XDB = append(vulnCheck.XDB, models.VulnCheckXDB{
+					XDBID:       id,
+					XDBURL:      url,
+					DateAdded:   parseKEVDate(x.DateAdded),
+					ExploitType: x.ExploitType,
+					CloneSSHURL: x.CloneSSHURL,
+				})
+			}
+			for _, exploitation := range reported {
+				vulnCheck.ReportedExploitation = append(vulnCheck.ReportedExploitation, models.VulnCheckReportedExploitation{
+					URL:       exploitation.URL,
+					DateAdded: parseKEVDate(exploitation.DateAdded),
+				})
+			}
+			kev.VulnCheck = vulnCheck
+		default:
+			note := entry.Note
+			if note == "" {
+				note = entry.Notes
+			}
+			if entry.CISA != nil && entry.CISA.Note != "" {
+				note = entry.CISA.Note
+			}
+			kev.Type = models.CISAKEVType
+			kev.CISA = &models.CISAKEV{Note: note}
+		}
+		kevs = append(kevs, kev)
+	}
+	return kevs, nil
+}
+
+func parseOptionalKEVDate(value string) *time.Time {
+	parsed := parseKEVDate(value)
+	if parsed.IsZero() {
+		return nil
+	}
+	return &parsed
+}
+
+func parseKEVDate(value string) time.Time {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return time.Time{}
+	}
+	for _, layout := range []string{time.DateOnly, time.RFC3339, "2006-01-02 15:04:05"} {
+		if parsed, err := time.Parse(layout, value); err == nil {
+			return parsed
+		}
+	}
+	return time.Time{}
+}
