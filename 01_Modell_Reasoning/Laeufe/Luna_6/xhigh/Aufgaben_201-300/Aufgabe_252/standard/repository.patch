 from __future__ import (absolute_import, division, print_function)
 __metaclass__ = type
 
+import errno
 import re
+import time
+
+from ansible.module_utils._text import to_text
+
+
+def _warn_sysctl_failure(module, error):
+    module.warn('Unable to read sysctl: %s' % error)
 
 
 def get_sysctl(module, prefixes):
     sysctl_cmd = module.get_bin_path('sysctl')
+    if not sysctl_cmd:
+        raise ValueError('sysctl command not found')
+
     cmd = [sysctl_cmd]
     cmd.extend(prefixes)
 
-    rc, out, err = module.run_command(cmd)
+    try:
+        rc, out, err = module.run_command(cmd)
+    except (IOError, OSError) as e:
+        _warn_sysctl_failure(module, e)
+        return dict()
+
     if rc != 0:
+        _warn_sysctl_failure(module, to_text(err, errors='surrogate_or_strict').strip())
         return dict()
 
     sysctl = dict()
-    for line in out.splitlines():
-        if not line:
+    current_key = None
+    for line in to_text(out, errors='surrogate_or_strict').splitlines():
+        if not line.strip():
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
-        sysctl[key] = value.strip()
+
+        if line[0].isspace() and current_key is not None:
+            sysctl[current_key] += '\n' + line.strip()
+            continue
+
+        try:
+            key, value = re.split(r'\s*(?:=|:)\s*|\s+', line, maxsplit=1)
+            if not key.strip():
+                raise ValueError('not enough values to unpack (expected 2, got 1)')
+        except ValueError as e:
+            module.warn('Unable to split sysctl line (%s): %s' % (line, e))
+            continue
+
+        current_key = key.strip()
+        sysctl[current_key] = value.strip()
 
     return sysctl
+
+
+def _get_uptime_facts(module):
+    sysctl_cmd = module.get_bin_path('sysctl')
+    if not sysctl_cmd:
+        raise ValueError('sysctl command not found')
+
+    try:
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'])
+    except (IOError, OSError) as e:
+        if getattr(e, 'errno', None) == errno.ENOENT:
+            raise ValueError('sysctl command not found')
+        _warn_sysctl_failure(module, e)
+        return dict()
+
+    if rc != 0:
+        _warn_sysctl_failure(module, to_text(err, errors='surrogate_or_strict').strip())
+        return dict()
+
+    boot_time = to_text(out, errors='surrogate_or_strict').strip()
+    if not re.match(r'^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$', boot_time):
+        return dict()
+
+    return {'uptime_seconds': int(time.time() - float(boot_time))}
