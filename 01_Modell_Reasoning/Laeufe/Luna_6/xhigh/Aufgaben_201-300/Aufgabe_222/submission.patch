+    def _build_doc(self, role, path, collection, argspec, entry_point=None):
+        """Build documentation for a role and its selected entry points.
+
+        :returns: A tuple containing the role FQCN and its documentation, or
+            ``None`` for the documentation when no entry points are included.
+        """
+        if collection:
+            fqcn = '.'.join([collection, role])
+        else:
+            fqcn = role
+
+        doc = {
+            'path': path,
+            'collection': collection,
+            'entry_points': {},
+        }
+        for ep in argspec:
+            if entry_point is None or ep == entry_point:
+                doc['entry_points'][ep] = argspec[ep]
+
+        if not doc['entry_points']:
+            return (fqcn, None)
+        return (fqcn, doc)
+
