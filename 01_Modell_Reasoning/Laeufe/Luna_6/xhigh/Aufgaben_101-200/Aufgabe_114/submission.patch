+func setAlbumDirs(ctx context.Context, ds model.DataStore, albums model.Albums) error {
+	var albumIDs []string
+	for _, album := range albums {
+		if len(album.Dirs) == 0 {
+			albumIDs = append(albumIDs, album.ID)
+		}
+	}
+	if len(albumIDs) == 0 {
+		return nil
+	}
+
+	mfs, err := ds.MediaFile(ctx).GetAll(model.QueryOptions{Filters: squirrel.Eq{"album_id": albumIDs}})
+	if err != nil {
+		return err
+	}
+	dirsByAlbum := make(map[string]model.MediaFiles)
+	for _, mf := range mfs {
+		dirsByAlbum[mf.AlbumID] = append(dirsByAlbum[mf.AlbumID], mf)
+	}
+	for i := range albums {
+		if len(albums[i].Dirs) == 0 {
+			albums[i].Dirs = dirsByAlbum[albums[i].ID].Dirs()
+		}
+	}
+	return nil
+}
+
+func artistFolder(albums model.Albums, artistName string) string {
+	var albumFolders []string
+	for _, album := range albums {
+		dirs := album.Dirs
+		if len(dirs) == 0 && album.EmbedArtPath != "" {
+			dirs = []string{filepath.Dir(album.EmbedArtPath)}
+		}
+		folder := commonDirectory(dirs)
+		if folder == "" {
+			continue
+		}
+		if !strings.EqualFold(filepath.Base(folder), artistName) {
+			folder = filepath.Dir(folder)
+		}
+		albumFolders = append(albumFolders, folder)
+	}
+	return commonDirectory(albumFolders)
+}
+
+func commonDirectory(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	common := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		candidate := filepath.Clean(dir)
+		for common != candidate {
+			rel, err := filepath.Rel(common, candidate)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel) {
+				break
+			}
+			parent := filepath.Dir(common)
+			if parent == common {
+				return ""
+			}
+			common = parent
+		}
+	}
+	if common == "." || filepath.Dir(common) == common {
+		return ""
+	}
+	return common
+}
