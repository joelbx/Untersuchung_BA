+class Batch:
+    """A batch of 10,000 covers within one 1,000,000-cover item."""
+
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id = self._norm_ids(item_id, batch_id)
+        self.size = None if size is None else _normal_size(size)
+
+    def _norm_ids(self, item_id=None, batch_id=None):
+        """Normalize item and batch identifiers to four and two digits."""
+        if item_id is None:
+            item_id = self.item_id
+        if batch_id is None:
+            batch_id = self.batch_id
+        return _normalize_ids(item_id, batch_id)
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = _normalize_ids(item_id, batch_id)
+        size = _normal_size(size)
+        ext = str(ext).lstrip('.')
+        if not ext or not re.fullmatch(r'[a-zA-Z0-9]+', ext):
+            raise ValueError('ext must be a filename extension')
+        size_prefix = f'{size}_' if size else ''
+        item_name = f'{size_prefix}covers_{item_id}'
+        filename = f'{item_name}_{batch_id}.{ext}'
+        return os.path.join('items', item_name, filename)
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    @property
+    def start_id(self):
+        return _batch_start_id(self.item_id, self.batch_id)
+
+    @property
+    def item_name(self):
+        prefix = f'{self.size}_' if self.size else ''
+        return f'{prefix}covers_{self.item_id}'
+
+    def _sizes(self):
+        return SIZES if self.size is None else (self.size,)
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        """Upload local ZIPs and finalize only after all four variants are verified."""
+        uploader = uploader or Uploader
+        statuses = {}
+        with _batch_lock(self.item_id, self.batch_id) as locked:
+            if not locked:
+                log('batch is already being processed', self.item_id, self.batch_id)
+                return statuses
+
+            for size in self._sizes():
+                batch = Batch(self.item_id, self.batch_id, size)
+                filepath = self.get_abspath(self.item_id, self.batch_id, size)
+                zip_filename = os.path.basename(filepath)
+                item = batch.item_name
+                exists = os.path.isfile(filepath)
+                uploaded = None
+
+                if test:
+                    statuses[size] = {'exists': exists, 'uploaded': False}
+                    continue
+
+                if upload or finalize:
+                    uploaded = uploader.is_uploaded(item, zip_filename)
+                if upload and exists and not uploaded:
+                    uploader.upload(item, [filepath])
+                    uploaded = uploader.is_uploaded(item, zip_filename)
+
+                statuses[size] = {'exists': exists, 'uploaded': uploaded}
+
+            if finalize and not test:
+                all_uploaded = all(
+                    uploader.is_uploaded(
+                        Batch(self.item_id, self.batch_id, size).item_name,
+                        os.path.basename(self.get_abspath(self.item_id, self.batch_id, size)),
+                    )
+                    for size in SIZES
+                )
+                if all_uploaded:
+                    self._finalize(self.start_id, test=False)
+
+        return statuses
+
+    @classmethod
+    def finalize(cls, start_id, test=False):
+        """Finalize a batch after confirming its four ZIPs exist remotely."""
+        start_id = int(start_id)
+        item_id, batch_id = Cover.id_to_item_and_batch_id(start_id)
+        batch = cls(item_id, batch_id)
+        if test:
+            return False
+        if not all(
+            Uploader.is_uploaded(
+                cls(item_id, batch_id, size).item_name,
+                os.path.basename(cls.get_abspath(item_id, batch_id, size)),
+            )
+            for size in SIZES
+        ):
+            return False
+
+        with _batch_lock(item_id, batch_id) as locked:
+            if not locked:
+                return False
+            return batch._finalize(start_id, test=False)
+
+    def _finalize(self, start_id, test=False):
+        if test:
+            return False
+        item_id, batch_id = Cover.id_to_item_and_batch_id(start_id)
+        covers_db = CoverDB()
+        covers = covers_db.get_archived_batch(item_id, batch_id)
+        if not covers:
+            return False
+
+        CoverDB.update_completed_batch(item_id, batch_id)
+        for record in covers:
+            Cover(record).delete_files()
+
+        for size in SIZES:
+            filepath = self.get_abspath(item_id, batch_id, size)
+            try:
+                os.remove(filepath)
+            except FileNotFoundError:
+                pass
+        return True
