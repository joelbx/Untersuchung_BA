+class Uploader:
+    """Small wrapper around the Internet Archive command line client."""
+
+    @staticmethod
+    def upload(itemname, filepaths):
+        command = ['ia', 'upload', itemname, *filepaths, '--retries', '10']
+        try:
+            return run(command, text=True, capture_output=True, check=True)
+        except (OSError, CalledProcessError) as exc:
+            log('upload failed', itemname, exc)
+            return None
+
+    @staticmethod
+    def is_uploaded(item, zip_filename, verbose=False):
+        """Check that a named ZIP appears in the Internet Archive item listing."""
+        try:
+            result = run(
+                ['ia', 'list', item], text=True, capture_output=True, check=True
+            )
+        except (OSError, CalledProcessError) as exc:
+            if verbose:
+                log('unable to list archive item', item, exc)
+            return False
+
+        filename = os.path.basename(zip_filename)
+        uploaded = any(
+            token.rstrip('/').rsplit('/', 1)[-1] == filename
+            for line in result.stdout.splitlines()
+            for token in line.split()
+        )
+        if verbose:
+            log(item, filename, 'uploaded' if uploaded else 'missing')
+        return uploaded
 
