+class Cover:
+    """A database cover record and helpers for its archived representation."""
 
+    def __init__(self, attributes):
+        if isinstance(attributes, dict):
+            self.__dict__.update(attributes)
+        else:
+            self.__dict__.update(vars(attributes))
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        """Return the four digit item and two digit batch for a cover ID."""
+        numeric_id = int(cover_id)
+        if not 0 <= numeric_id <= 9_999_999_999:
+            raise ValueError('cover ID must fit in ten digits')
+        padded_id = f'{numeric_id:010d}'
+        return padded_id[:4], padded_id[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        """Build the direct archive.org URL for a cover inside its batch ZIP."""
+        size = _normal_size(size)
+        if protocol not in ('http', 'https'):
+            raise ValueError("protocol must be 'http' or 'https'")
+        ext = str(ext).lstrip('.')
+        if not ext or not re.fullmatch(r'[a-zA-Z0-9]+', ext):
+            raise ValueError('ext must be a filename extension')
+
+        padded_id = f'{int(cover_id):010d}'
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        size_prefix = f'{size}_' if size else ''
+        item_name = f'{size_prefix}covers_{item_id}'
+        zip_name = f'{item_name}_{batch_id}.zip'
+        suffix = f'-{size.upper()}' if size else ''
+        filename = f'{padded_id}{suffix}.{ext}'
+        return f'{protocol}://archive.org/download/{item_name}/{zip_name}/{filename}'
+
+    def has_valid_files(self):
+        """Return whether all four local images for this cover are present."""
+        for field in ('filename', 'filename_s', 'filename_m', 'filename_l'):
+            filename = getattr(self, field, None)
+            if not filename or filename.startswith(('http://', 'https://')) or ':' in filename:
+                return False
+            path = filename if os.path.isabs(filename) else find_image_path(filename)
+            if not os.path.isfile(path):
+                return False
+        return True
+
+    def delete_files(self):
+        """Delete local image variants after the remote batch is verified."""
+        for field in ('filename', 'filename_s', 'filename_m', 'filename_l'):
+            filename = getattr(self, field, None)
+            if not filename or filename.startswith(('http://', 'https://')) or ':' in filename:
+                continue
+            path = filename if os.path.isabs(filename) else find_image_path(filename)
+            try:
+                os.remove(path)
+            except FileNotFoundError:
+                pass
