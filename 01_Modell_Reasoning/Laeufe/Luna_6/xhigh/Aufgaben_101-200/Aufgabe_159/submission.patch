+func canonicalPURLType(t string) string {
+	switch strings.ToLower(t) {
+	case "maven", "pom", "gradle", "jar":
+		return "maven"
+	case "pypi", "pip", "pipenv", "poetry", "uv", "python-pkg":
+		return "pypi"
+	case "golang", "gomod", "go-module", "gobinary", "go-binary":
+		return "golang"
+	case "npm", "yarn", "pnpm", "node-pkg", "javascript":
+		return "npm"
+	case "cocoapods":
+		return "cocoapods"
+	default:
+		return t
+	}
+}
+
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch strings.ToLower(t) {
+	case "maven":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			namespace, name = group, artifact
+		}
+	case "pypi":
+		name = strings.ToLower(strings.ReplaceAll(n, "_", "-"))
+	case "golang":
+		if i := strings.LastIndexByte(n, '/'); i >= 0 {
+			namespace, name = n[:i], n[i+1:]
+		}
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				namespace, name = scope, pkg
+			}
+		}
+	case "cocoapods":
+		if main, nested, ok := strings.Cut(n, "/"); ok {
+			name, subpath = main, nested
+		}
+	}
+	return namespace, name, subpath
+}
