+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, test := range []struct {
+		name            string
+		version         oras.PackManifestVersion
+		wantArtifactTag bool
+	}{
+		{
+			name:            "1.0",
+			version:         oras.PackManifestVersion1_0,
+			wantArtifactTag: false,
+		},
+		{
+			name:            "1.1",
+			version:         oras.PackManifestVersion1_1_RC4,
+			wantArtifactTag: true,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			dir := t.TempDir()
+			ref, err := ParseReference(fmt.Sprintf("flipt://local/%s:latest", repo))
+			require.NoError(t, err)
+
+			store, err := NewStore(zaptest.NewLogger(t), dir, WithManifestVersion(test.version))
+			require.NoError(t, err)
+
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+
+			bundle, err := store.Build(context.Background(), src, ref)
+			require.NoError(t, err)
+
+			manifest, err := os.ReadFile(path.Join(dir, repo, "blobs", "sha256", bundle.Digest.Encoded()))
+			require.NoError(t, err)
+			assert.Equal(t, test.wantArtifactTag, bytes.Contains(manifest, []byte(`"artifactType"`)))
+		})
+	}
+}
