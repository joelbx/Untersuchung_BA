+package parse
+
+import (
+	"fmt"
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a parsed expression node. String expressions evaluate to []string;
+// boolean expressions evaluate to bool.
+type Expr interface {
+	fmt.Stringer
+	Kind() reflect.Kind
+	Evaluate(ctx EvaluateContext) (any, error)
+}
+
+// EvaluateContext supplies values needed while evaluating an expression.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+// StringLitExpr represents a constant string.
+type StringLitExpr struct {
+	Value string
+}
+
+func (e StringLitExpr) String() string                        { return strconv.Quote(e.Value) }
+func (e StringLitExpr) Kind() reflect.Kind                    { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) { return []string{e.Value}, nil }
+
+// VarExpr represents a namespaced variable.
+type VarExpr struct {
+	Namespace string
+	Name      string
+}
+
+func (e VarExpr) String() string     { return e.Namespace + "." + e.Name }
+func (e VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("no resolver is available for variable %q", e.String())
+	}
+	return ctx.VarValue(e)
+}
+
+// EmailLocalExpr extracts the local part from each email address produced by
+// its string expression.
+type EmailLocalExpr struct {
+	Input Expr
+}
+
+func (e EmailLocalExpr) String() string {
+	if e.Input == nil {
+		return "email.local(<nil>)"
+	}
+	return "email.local(" + e.Input.String() + ")"
+}
+func (e EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Input, ctx)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("address is empty")
+		}
+		address, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("failed to parse address %q: %v", value, err)
+		}
+		separator := strings.LastIndexByte(address.Address, '@')
+		if separator <= 0 || separator == len(address.Address)-1 {
+			return nil, trace.BadParameter("could not find local part in %q", address.Address)
+		}
+		out = append(out, address.Address[:separator])
+	}
+	return out, nil
+}
+
+// RegexpReplaceExpr applies a compiled regexp replacement to a string
+// expression. Values that do not match are omitted.
+type RegexpReplaceExpr struct {
+	Input       Expr
+	Pattern     string
+	Replacement string
+	re          *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	input := "<nil>"
+	if e.Input != nil {
+		input = e.Input.String()
+	}
+	return "regexp.replace(" + input + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (e RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Input, ctx)
+	if err != nil {
+		return nil, err
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if re.MatchString(value) {
+			out = append(out, re.ReplaceAllString(value, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+// RegexpMatchExpr tests MatcherInput against a compiled regular expression.
+type RegexpMatchExpr struct {
+	re *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string {
+	pattern := ""
+	if e.re != nil {
+		pattern = e.re.String()
+	}
+	return "regexp.match(" + strconv.Quote(pattern) + ")"
+}
+func (RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if e.re == nil {
+		return nil, trace.BadParameter("regexp.match has no compiled pattern")
+	}
+	return e.re.MatchString(ctx.MatcherInput), nil
+}
+func (e RegexpMatchExpr) Match(in string) bool {
+	matched, err := e.Evaluate(EvaluateContext{MatcherInput: in})
+	return err == nil && matched == true
+}
+
+// RegexpNotMatchExpr negates a boolean expression. Its parser-produced form
+// wraps RegexpMatchExpr, while the general form also supports boolean logic.
+type RegexpNotMatchExpr struct {
+	Expr Expr
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	if e.Expr == nil {
+		return "regexp.not_match(<nil>)"
+	}
+	matcher, ok := e.Expr.(RegexpMatchExpr)
+	if pointer, isPointer := e.Expr.(*RegexpMatchExpr); isPointer {
+		matcher, ok = *pointer, true
+	}
+	if ok {
+		pattern := ""
+		if matcher.re != nil {
+			pattern = matcher.re.String()
+		}
+		return "regexp.not_match(" + strconv.Quote(pattern) + ")"
+	}
+	return "!(" + e.Expr.String() + ")"
+}
+func (RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if e.Expr == nil {
+		return nil, trace.BadParameter("regexp.not_match has no expression")
+	}
+	value, err := e.Expr.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	matched, ok := value.(bool)
+	if !ok {
+		return nil, trace.BadParameter("regexp.not_match requires a boolean expression, got %T", value)
+	}
+	return !matched, nil
+}
+func (e RegexpNotMatchExpr) Match(in string) bool {
+	matched, err := e.Evaluate(EvaluateContext{MatcherInput: in})
+	return err == nil && matched == true
+}
+
+type logicalExpr struct {
+	op          string
+	left, right Expr
+}
+
+func (e logicalExpr) String() string {
+	if e.left == nil || e.right == nil {
+		return "(" + e.op + " <nil>)"
+	}
+	return "(" + e.left.String() + " " + e.op + " " + e.right.String() + ")"
+}
+func (logicalExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e logicalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if e.left == nil || e.right == nil {
+		return nil, trace.BadParameter("boolean operator %s has an empty operand", e.op)
+	}
+	leftValue, err := e.left.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	left, ok := leftValue.(bool)
+	if !ok {
+		return nil, trace.BadParameter("boolean operator %s requires boolean expressions", e.op)
+	}
+	if e.op == "&&" && !left {
+		return false, nil
+	}
+	if e.op == "||" && left {
+		return true, nil
+	}
+	rightValue, err := e.right.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	right, ok := rightValue.(bool)
+	if !ok {
+		return nil, trace.BadParameter("boolean operator %s requires boolean expressions", e.op)
+	}
+	if e.op == "&&" {
+		return left && right, nil
+	}
+	return left || right, nil
+}
+
+func evaluateStrings(expr Expr, ctx EvaluateContext) ([]string, error) {
+	if expr == nil || expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected a string expression")
+	}
+	value, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	values, ok := value.([]string)
+	if !ok {
+		return nil, trace.BadParameter("string expression evaluated to %T, expected []string", value)
+	}
+	return values, nil
+}
