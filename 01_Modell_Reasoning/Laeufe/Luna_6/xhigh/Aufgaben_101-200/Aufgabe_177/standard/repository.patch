diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..7381e8b
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,76 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+function parseList(value) {
+	if (Array.isArray(value)) {
+		return value.every(uid => typeof uid === 'string' || (typeof uid === 'number' && Number.isFinite(uid)));
+	}
+	if (typeof value !== 'string') {
+		return false;
+	}
+	try {
+		const parsed = JSON.parse(value);
+		return Array.isArray(parsed) && parseList(parsed);
+	} catch (err) {
+		return false;
+	}
+}
+
+function isEnabled(value) {
+	return parseInt(value, 10) === 1;
+}
+
+module.exports = {
+	name: 'Migrate chat privacy settings to allow and deny lists',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		const defaultRestrictChat = await db.getObjectField('config', 'restrictChat');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settings = await db.getObjects(uids.map(uid => `user:${uid}:settings`));
+			const listUids = [];
+			const legacySettingUids = [];
+
+			settings.forEach((userSettings, index) => {
+				if (userSettings && Object.prototype.hasOwnProperty.call(userSettings, 'restrictChat')) {
+					legacySettingUids.push(uids[index]);
+				}
+				const oldValue = userSettings && userSettings.restrictChat !== undefined ?
+					userSettings.restrictChat : defaultRestrictChat;
+				if (isEnabled(oldValue) && !(userSettings && parseList(userSettings.chatAllowList))) {
+					listUids.push(uids[index]);
+				}
+			});
+
+			const followSets = listUids.flatMap(uid => [`following:${uid}`, `followingRemote:${uid}`]);
+			const following = followSets.length ? await db.getSortedSetsMembers(followSets) : [];
+			const followListByUid = new Map();
+			listUids.forEach((uid, index) => {
+				followListByUid.set(uid, [...new Set([
+					...(following[index * 2] || []),
+					...(following[(index * 2) + 1] || []),
+				].map(String))]);
+			});
+
+			const writes = listUids.map((uid) => {
+				const chatAllowList = followListByUid.get(uid);
+				const write = { chatAllowList: JSON.stringify(chatAllowList) };
+				if (!chatAllowList.length) {
+					write.disableIncomingMessages = 1;
+				}
+				return [`user:${uid}:settings`, write];
+			});
+			await db.setObjectBulk(writes);
+			await db.deleteObjectFields(legacySettingUids.map(uid => `user:${uid}:settings`), ['restrictChat']);
+			progress.incr(uids.length);
+		}, {
+			batch: 500,
+			progress,
+		});
+
+		await db.deleteObjectField('config', 'restrictChat');
+	},
+};
