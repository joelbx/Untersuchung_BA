diff --git a/utils/cache/simple_cache.go b/utils/cache/simple_cache.go
new file mode 100644
index 0000000..cb37199
--- /dev/null
+++ b/utils/cache/simple_cache.go
@@ -0,0 +1,140 @@
+package cache
+
+import (
+	"errors"
+	"sort"
+	"sync"
+	"time"
+)
+
+// ErrCacheMiss is returned when a key is not present or its value has expired.
+var ErrCacheMiss = errors.New("cache: key not found")
+
+// SimpleCache is a typed cache with optional per-entry expiration.
+type SimpleCache[V any] interface {
+	Add(key string, value V) error
+	AddWithTTL(key string, value V, ttl time.Duration) error
+	Get(key string) (V, error)
+	GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error)
+	Keys() []string
+}
+
+// NewSimpleCache creates an unbounded cache whose entries do not expire unless
+// a TTL is explicitly provided.
+func NewSimpleCache[V any]() SimpleCache[V] {
+	return newSimpleCache[V](0)
+}
+
+type cacheEntry[V any] struct {
+	value     V
+	expiresAt time.Time
+	inserted  uint64
+}
+
+type simpleCache[V any] struct {
+	mu         sync.Mutex
+	entries    map[string]cacheEntry[V]
+	maxEntries int
+	nextInsert uint64
+}
+
+func newSimpleCache[V any](maxEntries int) *simpleCache[V] {
+	return &simpleCache[V]{entries: make(map[string]cacheEntry[V]), maxEntries: maxEntries}
+}
+
+func (c *simpleCache[V]) Add(key string, value V) error {
+	return c.add(key, value, time.Time{})
+}
+
+func (c *simpleCache[V]) AddWithTTL(key string, value V, ttl time.Duration) error {
+	return c.add(key, value, time.Now().Add(ttl))
+}
+
+func (c *simpleCache[V]) add(key string, value V, expiresAt time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.removeExpired(time.Now())
+	c.nextInsert++
+	c.entries[key] = cacheEntry[V]{value: value, expiresAt: expiresAt, inserted: c.nextInsert}
+	c.evictIfFull(key)
+	return nil
+}
+
+func (c *simpleCache[V]) Get(key string) (V, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	entry, ok := c.entries[key]
+	if !ok {
+		var zero V
+		return zero, ErrCacheMiss
+	}
+	if c.expired(entry, time.Now()) {
+		delete(c.entries, key)
+		var zero V
+		return zero, ErrCacheMiss
+	}
+	return entry.value, nil
+}
+
+func (c *simpleCache[V]) GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error) {
+	if value, err := c.Get(key); err == nil {
+		return value, nil
+	}
+
+	value, ttl, err := loader(key)
+	if err != nil {
+		var zero V
+		return zero, err
+	}
+	if err := c.AddWithTTL(key, value, ttl); err != nil {
+		var zero V
+		return zero, err
+	}
+	return value, nil
+}
+
+func (c *simpleCache[V]) Keys() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	now := time.Now()
+	c.removeExpired(now)
+	keys := make([]string, 0, len(c.entries))
+	for key := range c.entries {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func (c *simpleCache[V]) expired(entry cacheEntry[V], now time.Time) bool {
+	return !entry.expiresAt.IsZero() && !now.Before(entry.expiresAt)
+}
+
+func (c *simpleCache[V]) removeExpired(now time.Time) {
+	for key, entry := range c.entries {
+		if c.expired(entry, now) {
+			delete(c.entries, key)
+		}
+	}
+}
+
+func (c *simpleCache[V]) evictIfFull(except string) {
+	if c.maxEntries <= 0 || len(c.entries) <= c.maxEntries {
+		return
+	}
+	var oldestKey string
+	var oldest uint64
+	for key, entry := range c.entries {
+		if key == except {
+			continue
+		}
+		if oldest == 0 || entry.inserted < oldest {
+			oldestKey, oldest = key, entry.inserted
+		}
+	}
+	if oldest != 0 {
+		delete(c.entries, oldestKey)
+	}
+}
