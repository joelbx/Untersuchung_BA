+func TestConvertToDistroAdvisory(t *testing.T) {
+	for _, tt := range []struct {
+		family string
+		title  string
+		wantID string
+	}{
+		{family: constant.RedHat, title: "RHSA-2025:1234: update", wantID: "RHSA-2025:1234"},
+		{family: constant.RedHat, title: "RHBA-2025:1234: update", wantID: "RHBA-2025:1234"},
+		{family: constant.CentOS, title: "RHSA-2025:1234: update", wantID: "RHSA-2025:1234"},
+		{family: constant.Alma, title: "RHBA-2025:1234: update", wantID: "RHBA-2025:1234"},
+		{family: constant.Rocky, title: "RHSA-2025:1234: update", wantID: "RHSA-2025:1234"},
+		{family: constant.Oracle, title: "ELSA-2025-1234", wantID: "ELSA-2025-1234"},
+		{family: constant.Amazon, title: "ALAS2-2025-1234", wantID: "ALAS2-2025-1234"},
+		{family: constant.Fedora, title: "FEDORA-2025-1234", wantID: "FEDORA-2025-1234"},
+		{family: constant.RedHat, title: "CVE-2025-1234", wantID: ""},
+		{family: constant.Oracle, title: "RHSA-2025:1234", wantID: ""},
+		{family: constant.Debian, title: "DSA-2025-1234", wantID: ""},
+	} {
+		client := RedHatBase{Base{family: tt.family}}
+		advisory := client.convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
+		if tt.wantID == "" {
+			if advisory != nil {
+				t.Errorf("family %s title %q: expected nil, got %#v", tt.family, tt.title, advisory)
+			}
+			continue
+		}
+		if advisory == nil || advisory.AdvisoryID != tt.wantID {
+			t.Errorf("family %s title %q: expected advisory %q, got %#v", tt.family, tt.title, tt.wantID, advisory)
+		}
+	}
+}
+
+func TestUpdateOnlyAddsSupportedAdvisories(t *testing.T) {
+	for _, tt := range []struct {
+		title        string
+		wantAdvisory bool
+	}{
+		{title: "RHSA-2025:1234: update", wantAdvisory: true},
+		{title: "CVE-2025-1234", wantAdvisory: false},
+	} {
+		r := models.ScanResult{ScannedCves: models.VulnInfos{}}
+		defpacks := defPacks{def: ovalmodels.Definition{
+			Title:    tt.title,
+			Advisory: ovalmodels.Advisory{Cves: []ovalmodels.Cve{{CveID: "CVE-2025-1234"}}},
+		}}
+		RedHatBase{Base{family: constant.RedHat}}.update(&r, defpacks)
+		advisories := r.ScannedCves["CVE-2025-1234"].DistroAdvisories
+		if (len(advisories) > 0) != tt.wantAdvisory {
+			t.Errorf("title %q: expected advisory present=%t, got %#v", tt.title, tt.wantAdvisory, advisories)
+		}
+	}
+}
