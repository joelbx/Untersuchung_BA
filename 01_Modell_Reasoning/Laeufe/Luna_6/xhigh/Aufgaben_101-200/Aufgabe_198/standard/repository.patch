+func TestIsOvalDefAffectedResolutionStates(t *testing.T) {
+	for _, tt := range []struct {
+		state       string
+		affected    bool
+		notFixedYet bool
+	}{
+		{state: "Will not fix", affected: false, notFixedYet: true},
+		{state: "Under investigation", affected: false, notFixedYet: true},
+		{state: "Fix deferred", affected: true, notFixedYet: true},
+		{state: "Affected", affected: true, notFixedYet: true},
+		{state: "Out of support scope", affected: true, notFixedYet: true},
+	} {
+		def := ovalmodels.Definition{
+			Advisory: ovalmodels.Advisory{
+				AffectedResolution: []ovalmodels.Resolution{{
+					State:      tt.state,
+					Components: []ovalmodels.Component{{Component: "pkg"}},
+				}},
+			},
+			AffectedPacks: []ovalmodels.Package{{Name: "pkg", Version: "1.0", NotFixedYet: true}},
+		}
+		affected, notFixedYet, fixState, fixedIn := isOvalDefAffected(def, request{packName: "pkg", versionRelease: "0.9"}, constant.RedHat, "9", models.Kernel{}, nil)
+		if affected != tt.affected || notFixedYet != tt.notFixedYet || fixState != tt.state || fixedIn != "1.0" {
+			t.Errorf("state %q: got affected=%t notFixedYet=%t fixState=%q fixedIn=%q", tt.state, affected, notFixedYet, fixState, fixedIn)
+		}
+	}
+
+	def := ovalmodels.Definition{AffectedPacks: []ovalmodels.Package{{Name: "pkg", Version: "1.0", NotFixedYet: true}}}
+	affected, notFixedYet, fixState, _ := isOvalDefAffected(def, request{packName: "pkg", versionRelease: "0.9"}, constant.RedHat, "9", models.Kernel{}, nil)
+	if !affected || !notFixedYet || fixState != "" {
+		t.Errorf("no resolution: got affected=%t notFixedYet=%t fixState=%q", affected, notFixedYet, fixState)
+	}
+}
