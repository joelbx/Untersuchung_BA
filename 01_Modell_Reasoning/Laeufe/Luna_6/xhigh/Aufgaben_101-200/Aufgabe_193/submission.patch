+def test_implicit_install_installs_roles_and_collections(requirements_file, monkeypatch):
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('''
+roles:
+- namespace.role
+collections:
+- namespace.collection
+''')
+
+    install_roles = MagicMock()
+    install_collections = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_execute_install_roles', install_roles)
+    monkeypatch.setattr(GalaxyCLI, '_execute_install_collections', install_collections)
+
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+    assert install_roles.call_count == 1
+    assert [role.name for role in install_roles.call_args[0][0]] == ['namespace.role']
+    assert install_collections.call_args[0][0] == [('namespace.collection', '*', None)]
+
+
+def test_implicit_install_custom_roles_path_skips_collections(requirements_file, monkeypatch):
+    with open(requirements_file, 'w') as req_obj:
