+func TestControllerSSHServerHeartbeatUsesPeerAddressForWildcardHost(t *testing.T) {
+	const serverID = "test-server"
+	tests := []struct {
+		name     string
+		peerAddr string
+		addr     string
+		want     string
+	}{
+		{name: "IPv6 wildcard", peerAddr: "192.0.2.10:4444", addr: "[::]:3022", want: "192.0.2.10:3022"},
+		{name: "IPv4 wildcard", peerAddr: "192.0.2.10:4444", addr: "0.0.0.0:3022", want: "192.0.2.10:3022"},
+		{name: "routable host", peerAddr: "192.0.2.10:4444", addr: "198.51.100.5:3022", want: "198.51.100.5:3022"},
+		{name: "wildcard without peer", addr: "[::]:3022", want: "[::]:3022"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+
+			events := make(chan testEvent, 32)
+			auth := &fakeAuth{}
+			controller := NewController(auth,
+				withServerKeepAlive(time.Hour),
+				withTestEventsChannel(events),
+			)
+			defer controller.Close()
+
+			upstream, downstream := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peerAddr))
+			defer downstream.Close()
+			controller.RegisterControlStream(upstream, proto.UpstreamInventoryHello{
+				ServerID: serverID,
+				Services: []types.SystemRole{types.RoleNode},
+			})
+
+			err := downstream.Send(ctx, proto.InventoryHeartbeat{
+				SSHServer: &types.ServerV2{
+					Metadata: types.Metadata{Name: serverID},
+					Spec:     types.ServerSpecV2{Addr: tt.addr},
+				},
+			})
+			require.NoError(t, err)
+			awaitEvents(t, events, expect(sshUpsertOk))
+
+			auth.mu.Lock()
+			defer auth.mu.Unlock()
+			require.Equal(t, []string{tt.want}, auth.upsertAddrs)
+		})
+	}
+}
