diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..30fbf6e 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,61 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set(self):
+        """Test implicit and explicit set matches, including inversion and other rule options."""
+        cases = [
+            ({'match_set': 'admin_hosts', 'match_set_flags': 'src'}, [
+                '-m', 'set', '--match-set', 'admin_hosts', 'src',
+            ]),
+            ({'match': ['set'], 'match_set': 'admin_hosts', 'match_set_flags': 'src,dst'}, [
+                '-m', 'set', '--match-set', 'admin_hosts', 'src,dst',
+            ]),
+            ({'match': ['set'], 'match_set': '!admin_hosts', 'match_set_flags': 'dst,src'}, [
+                '-m', 'set', '!', '--match-set', 'admin_hosts', 'dst,src',
+            ]),
+            ({'match_set': 'admin_hosts', 'match_set_flags': 'dst'}, [
+                '-m', 'set', '--match-set', 'admin_hosts', 'dst',
+            ]),
+        ]
+
+        for set_args, match_args in cases:
+            set_module_args(dict({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'destination_port': '22',
+                'jump': 'ACCEPT',
+                'comment': 'allow admin ssh',
+            }, **set_args))
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_args[0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-p', 'tcp',
+            ] + match_args + [
+                '-j', 'ACCEPT', '--destination-port', '22',
+                '-m', 'comment', '--comment', 'allow admin ssh',
+            ])
+
+    def test_match_set_requires_both_parameters(self):
+        """A set name and its flags must be supplied together."""
+        for args in (
+            {'chain': 'INPUT', 'match_set': 'admin_hosts'},
+            {'chain': 'INPUT', 'match_set_flags': 'src'},
+        ):
+            set_module_args(args)
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+
+    def test_match_set_rejects_invalid_flags(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'source',
+        })
+        with self.assertRaises(AnsibleFailJson):
+            iptables.main()
