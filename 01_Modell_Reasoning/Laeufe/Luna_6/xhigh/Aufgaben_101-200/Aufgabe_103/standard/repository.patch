+func Test_redhatBase_parseInstalledPackagesEmptyRelease(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.CentOS, Release: "9"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages("empty-release 0 1.0  x86_64 empty-release-1.0-.src.rpm\n")
+	if err != nil {
+		t.Fatalf("parseInstalledPackages() error = %v", err)
+	}
+	wantBins := models.Packages{
+		"empty-release": {
+			Name:    "empty-release",
+			Version: "1.0",
+			Release: "",
+			Arch:    "x86_64",
+		},
+	}
+	wantSrcs := models.SrcPackages{
+		"empty-release": {
+			Name:        "empty-release",
+			Version:     "1.0",
+			Arch:        "src",
+			BinaryNames: []string{"empty-release"},
+		},
+	}
+	if !reflect.DeepEqual(bins, wantBins) {
+		t.Errorf("parseInstalledPackages() packages = %#v, want %#v", bins, wantBins)
+	}
+	if !reflect.DeepEqual(srcs, wantSrcs) {
+		t.Errorf("parseInstalledPackages() source packages = %#v, want %#v", srcs, wantSrcs)
+	}
+}
