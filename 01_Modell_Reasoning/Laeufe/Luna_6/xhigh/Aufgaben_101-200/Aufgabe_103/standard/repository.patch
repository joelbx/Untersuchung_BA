+func Test_splitFileName(t *testing.T) {
+	tests := []struct {
+		name        string
+		filename    string
+		wantName    string
+		wantVersion string
+		wantRelease string
+		wantEpoch   string
+		wantArch    string
+		wantErr     bool
+	}{
+		{
+			name:        "standard source RPM",
+			filename:    "community-mysql-8.0.31-1.module.src.rpm",
+			wantName:    "community-mysql",
+			wantVersion: "8.0.31",
+			wantRelease: "1.module",
+			wantArch:    "src",
+		},
+		{
+			name:        "dash source suffix",
+			filename:    "package-0-1-src.rpm",
+			wantName:    "package",
+			wantVersion: "0",
+			wantRelease: "1",
+			wantArch:    "src",
+		},
+		{
+			name:        "empty source release",
+			filename:    "package-0--src.rpm",
+			wantName:    "package",
+			wantVersion: "0",
+			wantRelease: "",
+			wantArch:    "src",
+		},
+		{
+			name:     "missing version",
+			filename: "package--1.src.rpm",
+			wantErr:  true,
+		},
+		{
+			name:     "missing architecture",
+			filename: "package-0-1.rpm",
+			wantErr:  true,
+		},
+		{
+			name:     "wrong extension",
+			filename: "package-0-1.src",
+			wantErr:  true,
+		},
+		{
+			name:     "invalid epoch",
+			filename: "invalid:epoch-package-0-1.src.rpm",
+			wantErr:  true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			name, version, release, epoch, arch, err := splitFileName(tt.filename)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("splitFileName() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if tt.wantErr {
+				return
+			}
+			if name != tt.wantName || version != tt.wantVersion || release != tt.wantRelease || epoch != tt.wantEpoch || arch != tt.wantArch {
+				t.Errorf("splitFileName() = (%q, %q, %q, %q, %q), want (%q, %q, %q, %q, %q)", name, version, release, epoch, arch, tt.wantName, tt.wantVersion, tt.wantRelease, tt.wantEpoch, tt.wantArch)
+			}
+		})
+	}
+}
