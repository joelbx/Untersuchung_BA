+func amazonLinuxOvalRelease(release string) string {
+	fields := strings.Fields(release)
+	if len(fields) == 0 {
+		return "unknown"
+	}
+
+	version := fields[0]
+	parts := strings.Split(version, ".")
+	if len(parts) == 2 && len(parts[0]) == 4 && len(parts[1]) == 2 &&
+		strings.Trim(parts[0]+parts[1], "0123456789") == "" &&
+		parts[1] >= "01" && parts[1] <= "12" {
+		return "1"
+	}
+
+	major := parts[0]
+	switch major {
+	case "1", "2", "2022", "2023", "2025", "2027", "2029":
+		for _, part := range parts[1:] {
+			if part == "" || strings.Trim(part, "0123456789") != "" {
+				return "unknown"
+			}
+		}
+		return major
+	default:
+		return "unknown"
+	}
+}
