+func TestGetAmazonLinuxEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		until   time.Time
+	}{
+		{"2023 (Amazon Linux)", time.Date(2027, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2025 (Amazon Linux)", time.Date(2029, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2027 (Amazon Linux)", time.Date(2031, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2029 (Amazon Linux)", time.Date(2033, 6, 30, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL found = false, want true")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("StandardSupportUntil = %v, want %v", eol.StandardSupportUntil, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSuppportEnded(tt.until) {
+				t.Errorf("support ended on the inclusive end date %v", tt.until)
+			}
+			if !eol.IsStandardSupportEnded(tt.until.Add(time.Second)) ||
+				!eol.IsExtendedSuppportEnded(tt.until.Add(time.Second)) {
+				t.Errorf("support should have ended after %v", tt.until)
+			}
+		})
+	}
+
+	for _, release := range []string{"2024", "2030", "unknown", ""} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL(Amazon, %q) found = true, want false", release)
+		}
+	}
+}
