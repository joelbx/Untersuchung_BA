diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..6964a1a
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,132 @@
+package oci
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source implements fs.SnapshotSource using an OCI repository.
+type Source struct {
+	mu       sync.RWMutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+	logger   *zap.Logger
+	interval time.Duration
+	store    *fliptoci.Store
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+// NewSource constructs and configures an OCI snapshot source.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if store == nil {
+		return nil, fmt.Errorf("OCI store must be provided")
+	}
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	source := &Source{
+		logger:   logger,
+		interval: 30 * time.Second,
+		store:    store,
+	}
+	containers.ApplyAll(source, opts...)
+	if source.interval <= 0 {
+		return nil, fmt.Errorf("poll interval must be greater than zero")
+	}
+
+	return source, nil
+}
+
+// WithPollInterval configures the interval between OCI snapshot checks.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(source *Source) {
+		source.interval = tick
+	}
+}
+
+// String returns an identifier string for the source type.
+func (*Source) String() string {
+	return "oci"
+}
+
+// Get fetches the current OCI manifest and returns its snapshot. It asks the
+// OCI store to skip layer fetching when the manifest digest has not changed.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.logger.Debug("fetching OCI snapshot", zap.String("digest", s.digest.String()))
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+
+	if response.Matched {
+		s.logger.Debug("OCI snapshot is unchanged", zap.String("digest", response.Digest.String()))
+		return s.snapshot, nil
+	}
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building snapshot from OCI files", zap.Error(err))
+		return nil, err
+	}
+
+	s.snapshot = snapshot
+	s.digest = response.Digest
+	s.logger.Debug("updated OCI snapshot", zap.String("digest", s.digest.String()))
+	return s.snapshot, nil
+}
+
+// Subscribe sends snapshots when the OCI manifest digest changes and exits
+// when ctx is cancelled.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+
+	s.mu.RLock()
+	previousDigest := s.digest
+	s.mu.RUnlock()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				s.logger.Error("error polling OCI snapshot", zap.Error(err))
+				continue
+			}
+
+			s.mu.RLock()
+			currentDigest := s.digest
+			s.mu.RUnlock()
+			if currentDigest == previousDigest {
+				s.logger.Debug("OCI snapshot digest has not changed", zap.String("digest", currentDigest.String()))
+				continue
+			}
+
+			s.logger.Debug("sending updated OCI snapshot", zap.String("digest", currentDigest.String()))
+			select {
+			case ch <- snapshot:
+				previousDigest = currentDigest
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
