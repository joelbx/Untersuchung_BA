+interface IRegistrationTokenAuthEntryState {
+    token: string;
+    submitting: boolean;
+}
+
+export class RegistrationTokenAuthEntry extends React.Component<IAuthEntryProps, IRegistrationTokenAuthEntryState> {
+    public static LOGIN_TYPE = AuthType.RegistrationToken;
+    public static UNSTABLE_LOGIN_TYPE = AuthType.UnstableRegistrationToken;
+
+    private submissionPending = false;
+
+    public constructor(props) {
+        super(props);
+
+        this.state = {
+            token: "",
+            submitting: false,
+        };
+    }
+
+    public componentDidMount(): void {
+        this.props.onPhaseChange(DEFAULT_PHASE);
+    }
+
+    public componentDidUpdate(prevProps: IAuthEntryProps): void {
+        if (
+            this.submissionPending &&
+            ((prevProps.busy && !this.props.busy) ||
+                (this.props.errorText && this.props.errorText !== prevProps.errorText))
+        ) {
+            this.submissionPending = false;
+            this.setState({ submitting: false });
+        }
+    }
+
+    private onTokenChange = (event: ChangeEvent<HTMLInputElement>): void => {
+        this.setState({ token: event.target.value });
+    };
+
+    private onSubmit = (event: React.SyntheticEvent): void => {
+        event.preventDefault();
+        if (this.props.busy || this.submissionPending || !this.state.token) return;
+
+        this.submissionPending = true;
+        this.setState({ submitting: true });
+        this.props.submitAuthDict({
+            type: this.props.loginType,
+            token: this.state.token,
+        });
+    };
+
+    public render(): JSX.Element {
+        const isBusy = this.props.busy || this.state.submitting;
+
+        let errorSection;
+        if (this.props.errorText) {
+            errorSection = (
+                <div className="error" role="alert">
+                    {this.props.errorText}
+                </div>
+            );
+        }
+
+        return (
+            <div>
+                <p>{_t("Enter a registration token provided by the homeserver administrator.")}</p>
+                <form onSubmit={this.onSubmit}>
+                    <Field
+                        type="text"
+                        name="registrationTokenField"
+                        label={_t("Registration token")}
+                        autoFocus={true}
+                        value={this.state.token}
+                        onChange={this.onTokenChange}
+                    />
+                    {errorSection}
+                    <div className="mx_button_row">
+                        {isBusy ? (
+                            <Spinner />
+                        ) : (
+                            <AccessibleButton
+                                element="button"
+                                type="submit"
+                                kind="primary"
+                                disabled={!this.state.token}
+                                onClick={this.onSubmit}
+                            >
+                                {_t("Continue")}
+                            </AccessibleButton>
+                        )}
+                    </div>
+                </form>
+            </div>
+        );
+    }
+}
+
