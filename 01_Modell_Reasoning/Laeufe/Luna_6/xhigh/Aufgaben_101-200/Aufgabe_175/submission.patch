+	"github.com/spf13/cobra"
+)
+
+var (
+	backupFile   string
+	pruneForce   bool
+	restoreForce bool
+)
+
+var backupCmd = &cobra.Command{
+	Use:   "backup",
+	Short: "Manage database backups",
+}
+
+var backupCreateCmd = &cobra.Command{
+	Use:   "create",
+	Short: "Create a database backup",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, args []string) error {
+		path, err := db.Db().Backup(commandContext(cmd))
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintln(cmd.OutOrStdout(), path)
+		return err
+	},
+}
+
+var backupPruneCmd = &cobra.Command{
+	Use:   "prune",
+	Short: "Remove old database backups",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, args []string) error {
+		if conf.Server.Backup.Count == 0 && !pruneForce {
+			ok, err := confirm(cmd, "Backup count is zero. Delete all database backups? [y/N]: ")
+			if err != nil {
+				return err
+			}
+			if !ok {
+				_, _ = fmt.Fprintln(cmd.OutOrStdout(), "Cancelled.")
+				return nil
+			}
+		}
+		count, err := db.Db().Prune(commandContext(cmd))
+		if err != nil {
+			return err
+		}
+		fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d database backup(s).\n", count)
+		return nil
+	},
+}
+
+var backupRestoreCmd = &cobra.Command{
+	Use:   "restore",
+	Short: "Restore the database from a backup",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, args []string) error {
+		if !restoreForce {
+			ok, err := confirm(cmd, "Restore the database from the specified backup? This will replace the current database. [y/N]: ")
+			if err != nil {
+				return err
+			}
+			if !ok {
+				_, _ = fmt.Fprintln(cmd.OutOrStdout(), "Cancelled.")
+				return nil
+			}
+		}
+		if err := db.Db().Restore(commandContext(cmd), backupFile); err != nil {
+			return err
+		}
+		log.Info("Restored database from backup", "file", backupFile)
+		return nil
+	},
+}
+
+func commandContext(cmd *cobra.Command) context.Context {
+	if ctx := cmd.Context(); ctx != nil {
+		return ctx
+	}
+	return context.Background()
+}
+
+func confirm(cmd *cobra.Command, prompt string) (bool, error) {
+	if _, err := fmt.Fprint(cmd.OutOrStdout(), prompt); err != nil {
+		return false, err
+	}
+	answer, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	if err != nil && !errors.Is(err, io.EOF) {
+		return false, err
+	}
+	answer = strings.ToLower(strings.TrimSpace(answer))
+	return answer == "y" || answer == "yes", nil
+}
+
+func init() {
+	backupPruneCmd.Flags().BoolVar(&pruneForce, "force", false, "prune without confirmation when backup.count is zero")
+	backupRestoreCmd.Flags().StringVar(&backupFile, "backup-file", "", "path to the database backup file")
+	backupRestoreCmd.Flags().BoolVar(&restoreForce, "force", false, "restore without confirmation")
+	_ = backupRestoreCmd.MarkFlagRequired("backup-file")
+
+	backupCmd.AddCommand(backupCreateCmd, backupPruneCmd, backupRestoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
