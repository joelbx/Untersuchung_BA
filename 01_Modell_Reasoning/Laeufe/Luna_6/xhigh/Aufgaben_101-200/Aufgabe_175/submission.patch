diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..2ba2be4
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,307 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const (
+	backupFilenamePrefix  = "navidrome_backup_"
+	backupFilenameSuffix  = ".db"
+	backupTimestampLayout = "20060102_150405.000000000"
+)
+
+type backupFile struct {
+	path      string
+	timestamp time.Time
+	name      string
+}
+
+// Backup creates an online SQLite backup in the configured backup directory.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup path is not configured")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", fmt.Errorf("create backup directory %q: %w", dir, err)
+	}
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+
+	filename := backupFilenamePrefix + time.Now().UTC().Format(backupTimestampLayout) + backupFilenameSuffix
+	destination := filepath.Join(dir, filename)
+	file, err := os.OpenFile(destination, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", fmt.Errorf("create backup file %q: %w", destination, err)
+	}
+	if err := file.Close(); err != nil {
+		_ = os.Remove(destination)
+		return "", fmt.Errorf("close backup file %q: %w", destination, err)
+	}
+
+	destinationDB, err := sql.Open(Driver, destination)
+	if err != nil {
+		_ = os.Remove(destination)
+		return "", fmt.Errorf("open backup file %q: %w", destination, err)
+	}
+	err = sqliteOnlineBackup(ctx, d.readDB, destinationDB)
+	closeErr := destinationDB.Close()
+	if err != nil {
+		_ = os.Remove(destination)
+		return "", fmt.Errorf("backup database to %q: %w", destination, err)
+	}
+	if closeErr != nil {
+		_ = os.Remove(destination)
+		return "", fmt.Errorf("close backup database %q: %w", destination, closeErr)
+	}
+	return destination, nil
+}
+
+// Restore replaces the live database contents with a validated SQLite backup.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file path is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return fmt.Errorf("open backup file %q: %w", path, err)
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file %q is not a regular file", path)
+	}
+	if isLiveDatabasePath(path) {
+		return errors.New("refusing to restore the live database from itself")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+
+	backupDB, err := sql.Open(Driver, readOnlySQLitePath(path))
+	if err != nil {
+		return fmt.Errorf("open backup database %q: %w", path, err)
+	}
+	defer backupDB.Close()
+	if err := backupDB.PingContext(ctx); err != nil {
+		return fmt.Errorf("open backup database %q: %w", path, err)
+	}
+	var integrity string
+	if err := backupDB.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&integrity); err != nil {
+		return fmt.Errorf("check backup database %q: %w", path, err)
+	}
+	if integrity != "ok" {
+		return fmt.Errorf("backup database %q failed integrity check: %s", path, integrity)
+	}
+	if err := sqliteOnlineBackup(ctx, backupDB, d.writeDB); err != nil {
+		return fmt.Errorf("restore database from %q: %w", path, err)
+	}
+	return nil
+}
+
+// Prune removes old backup files according to backup.count.
+func (d *db) Prune(ctx context.Context) (int, error) {
+	return prune(ctx)
+}
+
+// prune retains the newest configured number of timestamped backup files.
+// A count of zero removes every recognized backup.
+func prune(ctx context.Context) (int, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return 0, nil
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup count must be zero or greater")
+	}
+	entries, err := os.ReadDir(dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return 0, nil
+	}
+	if err != nil {
+		return 0, fmt.Errorf("read backup directory %q: %w", dir, err)
+	}
+
+	backups := make([]backupFile, 0, len(entries))
+	for _, entry := range entries {
+		if err := ctx.Err(); err != nil {
+			return 0, err
+		}
+		if entry.IsDir() {
+			continue
+		}
+		timestamp, ok := parseBackupTimestamp(entry.Name())
+		if !ok {
+			continue
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return 0, fmt.Errorf("inspect backup file %q: %w", entry.Name(), err)
+		}
+		if !info.Mode().IsRegular() {
+			continue
+		}
+		backups = append(backups, backupFile{
+			path:      filepath.Join(dir, entry.Name()),
+			timestamp: timestamp,
+			name:      entry.Name(),
+		})
+	}
+	sort.Slice(backups, func(i, j int) bool {
+		if backups[i].timestamp.Equal(backups[j].timestamp) {
+			return backups[i].name > backups[j].name
+		}
+		return backups[i].timestamp.After(backups[j].timestamp)
+	})
+
+	pruned := 0
+	for _, backup := range backups[min(conf.Server.Backup.Count, len(backups)):] {
+		if err := ctx.Err(); err != nil {
+			return pruned, err
+		}
+		if err := os.Remove(backup.path); err != nil {
+			return pruned, fmt.Errorf("remove old backup %q: %w", backup.path, err)
+		}
+		pruned++
+	}
+	return pruned, nil
+}
+
+func parseBackupTimestamp(filename string) (time.Time, bool) {
+	if !strings.HasPrefix(filename, backupFilenamePrefix) || !strings.HasSuffix(filename, backupFilenameSuffix) {
+		return time.Time{}, false
+	}
+	value := strings.TrimSuffix(strings.TrimPrefix(filename, backupFilenamePrefix), backupFilenameSuffix)
+	for _, layout := range []string{
+		backupTimestampLayout,
+		"20060102_150405",
+		"20060102150405",
+		"20060102-150405",
+		"2006-01-02_15-04-05.000000000",
+		"2006-01-02_15-04-05",
+		time.RFC3339Nano,
+		"20060102T150405.000000000Z",
+		"20060102T150405Z",
+		"2006-01-02T15-04-05.000000000Z",
+		"2006-01-02T15-04-05Z",
+	} {
+		parsed, err := time.Parse(layout, value)
+		if err == nil {
+			return parsed, true
+		}
+	}
+	return time.Time{}, false
+}
+
+func sqliteOnlineBackup(ctx context.Context, source, destination *sql.DB) error {
+	sourceConn, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer sourceConn.Close()
+	destinationConn, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destinationConn.Close()
+
+	return destinationConn.Raw(func(destinationDriverConn any) error {
+		destinationSQLite, ok := destinationDriverConn.(*sqlite3.SQLiteConn)
+		if !ok {
+			return fmt.Errorf("expected SQLite destination connection, got %T", destinationDriverConn)
+		}
+		return sourceConn.Raw(func(sourceDriverConn any) error {
+			sourceSQLite, ok := sourceDriverConn.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("expected SQLite source connection, got %T", sourceDriverConn)
+			}
+			backup, err := destinationSQLite.Backup("main", sourceSQLite, "main")
+			if err != nil {
+				return err
+			}
+			finished := false
+			defer func() {
+				if !finished {
+					_ = backup.Close()
+				}
+			}()
+			for {
+				if err := ctx.Err(); err != nil {
+					return err
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					return err
+				}
+				if done {
+					err := backup.Finish()
+					finished = true
+					return err
+				}
+				select {
+				case <-ctx.Done():
+					return ctx.Err()
+				case <-time.After(5 * time.Millisecond):
+				}
+			}
+		})
+	})
+}
+
+func readOnlySQLitePath(path string) string {
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		absPath = path
+	}
+	uri := url.URL{Scheme: "file", Path: filepath.ToSlash(absPath)}
+	uri.RawQuery = "mode=ro"
+	return uri.String()
+}
+
+func isLiveDatabasePath(candidate string) bool {
+	configured := Path
+	if configured == "" {
+		configured = conf.Server.DbPath
+	}
+	configured = localSQLitePath(configured)
+	candidate = localSQLitePath(candidate)
+	if configured == "" || candidate == "" {
+		return false
+	}
+	configuredAbs, err1 := filepath.Abs(configured)
+	candidateAbs, err2 := filepath.Abs(candidate)
+	if err1 == nil && err2 == nil && filepath.Clean(configuredAbs) == filepath.Clean(candidateAbs) {
+		return true
+	}
+	configuredInfo, err1 := os.Stat(configured)
+	candidateInfo, err2 := os.Stat(candidate)
+	return err1 == nil && err2 == nil && os.SameFile(configuredInfo, candidateInfo)
+}
+
+func localSQLitePath(path string) string {
+	if path == "" || path == ":memory:" || strings.Contains(path, ":memory:") {
+		return ""
+	}
+	if strings.HasPrefix(path, "file:") {
+		parsed, err := url.Parse(path)
+		if err != nil {
+			return ""
+		}
+		path = parsed.Path
+		if path == "" {
+			return ""
+		}
+	}
+	return path
+}
