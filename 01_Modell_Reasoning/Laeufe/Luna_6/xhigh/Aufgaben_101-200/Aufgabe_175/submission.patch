+// schedulePeriodicBackup schedules database backups and retention pruning.
+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		backup := conf.Server.Backup
+		if backup.Path == "" || backup.Schedule == "" || backup.Count == 0 {
+			log.Info("Periodic backups are DISABLED")
+			return nil
+		}
+
+		schedulerInstance := scheduler.GetInstance()
+		log.Info("Scheduling periodic database backups", "schedule", backup.Schedule)
+		if err := schedulerInstance.Add(backup.Schedule, func() {
+			if path, err := db.Db().Backup(ctx); err != nil {
+				log.Error("Error creating scheduled database backup", err)
+			} else {
+				log.Info("Created scheduled database backup", "file", path)
+			}
+			pruned, err := db.Db().Prune(ctx)
+			if err != nil {
+				log.Error("Error pruning scheduled database backups", err)
+			} else if pruned > 0 {
+				log.Info("Pruned old database backups", "count", pruned)
+			}
+		}); err != nil {
+			log.Error("Error scheduling database backups", err)
+		}
+		return nil
+	}
+}
