+import React, { useState } from 'react';
+import { fireEvent, render } from '@testing-library/react';
+
+import ContextMenu from '../../../../src/components/structures/ContextMenu';
+
+describe('<ContextMenu /> interactions', () => {
+    it('closes after a menu item is activated and returns focus to its trigger', () => {
+        const onItemClick = jest.fn();
+
+        const MenuHarness: React.FC = () => {
+            const [isOpen, setIsOpen] = useState(false);
+
+            return <>
+                <button data-testid="trigger" onClick={() => setIsOpen(true)}>Open menu</button>
+                { isOpen && <ContextMenu
+                    top={10}
+                    left={10}
+                    hasBackground={false}
+                    onFinished={() => setIsOpen(false)}
+                >
+                    <button onClick={onItemClick}>Menu action</button>
+                </ContextMenu> }
+            </>;
+        };
+
+        const { getByTestId, getByText, queryByText } = render(<MenuHarness />);
+        const trigger = getByTestId('trigger');
+        trigger.focus();
+        fireEvent.click(trigger);
+
+        fireEvent.click(getByText('Menu action'));
+
+        expect(onItemClick).toHaveBeenCalledTimes(1);
+        expect(queryByText('Menu action')).toBeNull();
+        expect(document.activeElement).toBe(trigger);
+    });
+});
