index abf2683..7b3c4da 100644
--- a/test/units/utils/test_encrypt.py
+++ b/test/units/utils/test_encrypt.py
@@ -135,6 +135,37 @@ def test_password_hash_filter_passlib():
     assert get_encrypted_password("123", "pbkdf2_sha256")
 
 
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_password_hash_filter_bcrypt_ident(ident):
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip("passlib not available")
+
+    hashed = get_encrypted_password("123", "blowfish", salt="1234567890123456789012", rounds=4, ident=ident)
+    assert hashed.startswith('$%s$04$' % ident)
+
+
+def test_password_hash_filter_ident_ignored_for_non_bcrypt():
+    expected = get_encrypted_password("123", "sha256", salt="12345678")
+    assert get_encrypted_password("123", "sha256", salt="12345678", ident='not-a-bcrypt-ident') == expected
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin') or not encrypt.HAS_CRYPT, reason='crypt backend unavailable')
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_crypt_hash_bcrypt_ident(ident, monkeypatch):
+    calls = []
+
+    def crypt(secret, saltstring):
+        calls.append(saltstring)
+        return saltstring + 'checksum'
+
+    monkeypatch.setattr(encrypt.crypt, 'crypt', crypt)
+    with passlib_off():
+        hashed = get_encrypted_password("123", "bcrypt", salt="1234567890123456789012", rounds=4, ident=ident)
+
+    assert hashed.startswith('$%s$04$' % ident)
+    assert calls == ['$%s$04$1234567890123456789012' % ident]
+
+
