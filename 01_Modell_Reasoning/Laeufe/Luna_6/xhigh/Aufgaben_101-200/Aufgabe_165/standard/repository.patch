+/** Whether the user can choose room encryption, and an optional enforced value. */
+export interface AllowedEncryptionSetting {
+    allowChange: boolean;
+    forcedValue?: boolean;
+}
+
+/**
+ * Resolves whether room encryption can be changed by the user for the given preset.
+ * Server policy takes precedence over .well-known policy if both mandate a value.
+ */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const serverForcesEncryption = await client.doesServerForceEncryptionForPreset(chatPreset);
+    const wellKnownForcesDisable = shouldForceDisableEncryption(client);
+
+    if (serverForcesEncryption) {
+        if (wellKnownForcesDisable) {
+            console.warn(
+                "Conflicting encryption policies: the server requires encryption, but .well-known force_disable is true. The server policy takes precedence.",
+            );
+        }
+        return { allowChange: false, forcedValue: true };
+    }
+
+    if (wellKnownForcesDisable) {
+        return { allowChange: false, forcedValue: false };
+    }
+
+    return { allowChange: true };
+}
+
