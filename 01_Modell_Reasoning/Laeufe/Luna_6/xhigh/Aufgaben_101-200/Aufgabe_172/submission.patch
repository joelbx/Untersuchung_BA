+// UnmarshalJSON accepts both legacy string ports and the structured format
+// written by earlier versions of this package.
+func (p *AffectedProcess) UnmarshalJSON(data []byte) error {
+	type affectedProcessJSON struct {
+		PID             string            `json:"pid,omitempty"`
+		Name            string            `json:"name,omitempty"`
+		ListenPorts     []json.RawMessage `json:"listenPorts,omitempty"`
+		ListenPortStats []PortStat        `json:"listenPortStats,omitempty"`
+	}
+	var raw affectedProcessJSON
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return err
+	}
+	p.PID = raw.PID
+	p.Name = raw.Name
+	p.ListenPorts = nil
+	p.ListenPortStats = raw.ListenPortStats
+	for _, item := range raw.ListenPorts {
+		var legacy string
+		if err := json.Unmarshal(item, &legacy); err == nil {
+			p.ListenPorts = append(p.ListenPorts, legacy)
+			continue
+		}
+
+		var structured struct {
+			Address           string   `json:"address"`
+			BindAddress       string   `json:"bindAddress"`
+			Port              string   `json:"port"`
+			PortScanSuccessOn []string `json:"portScanSuccessOn"`
+			PortReachableTo   []string `json:"portReachableTo"`
+		}
+		if err := json.Unmarshal(item, &structured); err != nil {
+			return err
+		}
+		address := structured.BindAddress
+		if address == "" {
+			address = structured.Address
+		}
+		if strings.HasPrefix(address, "[") && strings.HasSuffix(address, "]") {
+			address = strings.TrimSuffix(strings.TrimPrefix(address, "["), "]")
+		}
+		reachableTo := structured.PortReachableTo
+		if reachableTo == nil {
+			reachableTo = structured.PortScanSuccessOn
+		}
+		if address != "" || structured.Port != "" {
+			p.ListenPortStats = append(p.ListenPortStats, PortStat{
+				BindAddress:     address,
+				Port:            structured.Port,
+				PortReachableTo: reachableTo,
+			})
+			p.ListenPorts = append(p.ListenPorts, net.JoinHostPort(address, structured.Port))
+		}
+	}
+	return nil
 }
 
