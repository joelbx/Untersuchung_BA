+// PortStat is the parsed address, port, and reachability information for a listener.
+type PortStat struct {
+	BindAddress     string   `json:"bindAddress"`
+	Port            string   `json:"port"`
+	PortReachableTo []string `json:"portReachableTo,omitempty"`
+}
+
+// NewPortStat parses an IP address and port in host:port form.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+
+	address, port, err := net.SplitHostPort(ipPort)
+	if err != nil {
+		return stat, fmt.Errorf("invalid ip:port %q: %w", ipPort, err)
+	}
+	if address != "*" && net.ParseIP(address) == nil {
+		return stat, fmt.Errorf("invalid IP address %q", address)
+	}
+	portNumber, err := strconv.ParseUint(port, 10, 16)
+	if err != nil || 65535 < portNumber {
+		return stat, fmt.Errorf("invalid port %q", port)
+	}
+	stat.BindAddress = address
+	stat.Port = port
+	return stat, nil
+}
+
+// FindPortReachableTo returns the IPs whose open port matches this listener.
+func (p PortStat) FindPortReachableTo(ipPorts []string) []string {
+	if p.BindAddress == "" || p.Port == "" {
+		return []string{}
+	}
+	addresses := []string{}
+	for _, ipPort := range ipPorts {
+		candidate, err := NewPortStat(ipPort)
+		if err != nil || candidate.Port != p.Port {
+			continue
+		}
+		if p.BindAddress == "*" || p.BindAddress == candidate.BindAddress {
+			addresses = append(addresses, candidate.BindAddress)
+		}
+	}
+	return addresses
+}
