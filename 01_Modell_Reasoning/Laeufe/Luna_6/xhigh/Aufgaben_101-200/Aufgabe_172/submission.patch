+func formatAffectedProcessPorts(p models.AffectedProcess) []string {
+	if len(p.ListenPortStats) == 0 {
+		return append([]string(nil), p.ListenPorts...)
+	}
+	ports := make([]string, 0, len(p.ListenPortStats))
+	for _, stat := range p.ListenPortStats {
+		port := net.JoinHostPort(stat.BindAddress, stat.Port)
+		if len(stat.PortReachableTo) > 0 {
+			port = fmt.Sprintf("%s(◉ Scannable: %s)", port, stat.PortReachableTo)
+		}
+		ports = append(ports, port)
+	}
+	return ports
+}
