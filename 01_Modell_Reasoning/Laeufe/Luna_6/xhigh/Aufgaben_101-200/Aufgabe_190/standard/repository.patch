+def _as_author(record: Any) -> dict[str, Any]:
+    return record.dict() if hasattr(record, 'dict') else record
+
+
+def _dates_match_exactly(author: dict[str, Any], existing: Any) -> bool:
+    """Compare supplied birth/death dates by their four digit year."""
+    existing = _as_author(existing)
+    for field in ('birth_date', 'death_date'):
+        incoming = author.get(field)
+        if not incoming:
+            continue
+        current = existing.get(field)
+        if not current:
+            return False
+        incoming_year = extract_year(str(incoming))
+        current_year = extract_year(str(current))
+        if incoming_year or current_year:
+            if not incoming_year or incoming_year != current_year:
+                return False
+        elif str(incoming).casefold() != str(current).casefold():
+            return False
+    return True
+
+
+def _matches_name(author: dict[str, Any], existing: Any, *, alternate=False) -> bool:
+    existing = _as_author(existing)
+    incoming_name = str(author.get('name', '')).casefold()
+    names = existing.get('alternate_names', []) if alternate else [existing.get('name', '')]
+    if isinstance(names, str):
+        names = [names]
+    return any(str(name).casefold() == incoming_name for name in names)
+
+
+def _best_match(author: dict[str, Any], matches: list["Author"]) -> list["Author"]:
+    matches = [m for m in matches if _dates_match_exactly(author, m)]
+    if not matches:
+        return []
+    return [min(matches, key=key_int)]
+
