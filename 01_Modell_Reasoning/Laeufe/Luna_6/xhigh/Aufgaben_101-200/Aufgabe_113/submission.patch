@@ -62,3 +62,80 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_nxos_vrf_af_route_target_auto_evpn_disable(self):
+        self.get_config.return_value = '\n'.join([
+            'vrf context ntc',
+            '  address-family ipv4 unicast',
+            '    route-target both auto evpn'
+        ])
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False))
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target both auto evpn'
+        ])
+
+    def test_nxos_vrf_af_route_target_auto_evpn_disabled_idempotent(self):
+        self.get_config.return_value = '\n'.join([
+            'vrf context ntc',
+            '  address-family ipv4 unicast'
+        ])
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False))
+        self.execute_module(changed=False, commands=[])
+
+    def test_nxos_vrf_af_route_targets_multiple(self):
+        set_module_args(dict(
+            vrf='ntc', afi='ipv6',
+            route_targets=[{'rt': '1:1'}, {'rt': '2:2', 'direction': 'import'}]
+        ))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted([
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'route-target import 1:1', 'route-target export 1:1',
+            'route-target import 2:2'
+        ]))
+
+    def test_nxos_vrf_af_route_targets_mixed_changes(self):
+        self.get_config.return_value = '\n'.join([
+            'vrf context ntc',
+            '  address-family ipv4 unicast',
+            '    route-target import 1:1',
+            '    route-target export 2:2'
+        ])
+        set_module_args(dict(
+            vrf='ntc', afi='ipv4',
+            route_targets=[
+                {'rt': '1:1', 'direction': 'both'},
+                {'rt': '2:2', 'direction': 'both', 'state': 'absent'}
+            ]
+        ))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted([
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'route-target export 1:1', 'no route-target export 2:2'
+        ]))
+
+    def test_nxos_vrf_af_route_targets_idempotent(self):
+        self.get_config.return_value = '\n'.join([
+            'vrf context ntc',
+            '  address-family ipv4 unicast',
+            '    route-target import 1:1',
+            '    route-target export 1:1'
+        ])
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[{'rt': '1:1'}]))
+        self.execute_module(changed=False, commands=[])
+
+    def test_nxos_vrf_af_absent_ignores_route_targets(self):
+        self.get_config.return_value = '\n'.join([
+            'vrf context ntc',
+            '  address-family ipv4 unicast',
+            '    route-target import 1:1'
+        ])
+        set_module_args(dict(
+            vrf='ntc', afi='ipv4', state='absent',
+            route_target_both_auto_evpn=True,
+            route_targets=[{'rt': '1:1', 'state': 'absent'}]
