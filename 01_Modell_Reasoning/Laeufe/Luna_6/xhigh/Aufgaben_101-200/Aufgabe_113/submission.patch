@@ -76,11 +100,33 @@ from ansible.module_utils.basic import AnsibleModule
 from ansible.module_utils.network.common.config import NetworkConfig
 
 
+def match_current_rt(rt, direction, current, rt_commands):
+    """Append a route-target command when its requested state differs."""
+    command = 'route-target {0} {1}'.format(direction, rt['rt'])
+    current_lines = [line.strip() for line in current.splitlines()]
+    have = command in current_lines
+    state = rt.get('state', 'present')
+
+    if state == 'present' and not have:
+        rt_commands.append(command)
+    elif state == 'absent' and have:
+        rt_commands.append('no {0}'.format(command))
+
+    return rt_commands
+
+
 def main():
+    route_target_spec = dict(
+        rt=dict(required=True, type='str'),
+        direction=dict(choices=['import', 'export', 'both'], default='both'),
+        state=dict(choices=['present', 'absent'], default='present'),
+    )
+
     argument_spec = dict(
         vrf=dict(required=True),
         afi=dict(required=True, choices=['ipv4', 'ipv6']),
         route_target_both_auto_evpn=dict(required=False, type='bool'),
+        route_targets=dict(type='list', elements='dict', options=route_target_spec),
         state=dict(choices=['present', 'absent'], default='present'),
     )
 
