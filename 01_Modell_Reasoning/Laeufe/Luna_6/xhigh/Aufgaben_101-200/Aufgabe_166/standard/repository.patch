-        if cache and file_name in self._FILE_CACHE:
+        use_cache = cache_all or (cache_vaulted and file_name in self._FILE_CACHE_VAULTED)
+        if use_cache and file_name in self._FILE_CACHE:
             parsed_data = self._FILE_CACHE[file_name]
         else:
             # read the file contents and load the data structure from them
@@ -94,8 +102,14 @@ class DataLoader:
             file_data = to_text(b_file_data, errors='surrogate_or_strict')
             parsed_data = self.load(data=file_data, file_name=file_name, show_content=show_content, json_only=json_only)
 
-            # cache the file contents for next time
-            self._FILE_CACHE[file_name] = parsed_data
+            # Cache every file for the default policy, but only vaulted files
+            # when requested by callers loading vars_files.
+            if cache_all or (cache_vaulted and not show_content):
+                self._FILE_CACHE[file_name] = parsed_data
+                if not show_content:
+                    self._FILE_CACHE_VAULTED.add(file_name)
+                else:
+                    self._FILE_CACHE_VAULTED.discard(file_name)
 
         if unsafe:
             return parsed_data
