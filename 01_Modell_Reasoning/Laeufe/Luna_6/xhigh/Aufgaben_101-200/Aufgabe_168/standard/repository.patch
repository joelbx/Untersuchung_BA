+type AdminActionLock = {
+    isPending: boolean;
+    begin: () => boolean;
+    finish: () => void;
+};
+
+const AdminActionLockContext = React.createContext<AdminActionLock | null>(null);
+
+const useAdminActionLock = (roomId: string, userId: string): AdminActionLock => {
+    const pendingMembers = useRef(new Set<string>());
+    const [pendingMemberState, setPendingMemberState] = useState<ReadonlySet<string>>(() => new Set());
+    const memberKey = JSON.stringify([roomId, userId]);
+
+    const begin = useCallback((): boolean => {
+        if (pendingMembers.current.has(memberKey)) return false;
+        pendingMembers.current.add(memberKey);
+        setPendingMemberState(new Set(pendingMembers.current));
+        return true;
+    }, [memberKey]);
+
+    const finish = useCallback((): void => {
+        pendingMembers.current.delete(memberKey);
+        setPendingMemberState(new Set(pendingMembers.current));
+    }, [memberKey]);
+
+    return { isPending: pendingMemberState.has(memberKey), begin, finish };
+};
+
 interface IBaseProps {
     member: RoomMember;
     startUpdating(): void;
