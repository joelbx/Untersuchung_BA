+func Test_windows_detectKBsFromExtendedRollups(t *testing.T) {
+	tests := []struct {
+		name    string
+		release string
+		build   string
+		kbs     []string
+	}{
+		{
+			name:    "Windows 10 22H2",
+			release: "Windows 10 Version 22H2 for x64-based Systems",
+			build:   "19045",
+			kbs:     []string{"5032189", "5032278", "5033372", "5034122", "5034203", "5034763", "5034843", "5035845", "5035941", "5036892", "5036979", "5037768", "5039211"},
+		},
+		{
+			name:    "Windows 11 22H2",
+			release: "Windows 11 Version 22H2 for x64-based Systems",
+			build:   "22621",
+			kbs:     []string{"5032190", "5032288", "5033375", "5034123", "5034204", "5034765", "5034848", "5035853", "5035942", "5036893", "5036980", "5037771", "5037853", "5039212"},
+		},
+		{
+			name:    "Windows 11 23H2",
+			release: "Windows 11 Version 23H2 for x64-based Systems",
+			build:   "22631",
+			kbs:     []string{"5032190", "5032288", "5033375", "5034123", "5034204", "5034765", "5034848", "5035853", "5035942", "5036893", "5036980", "5037771", "5037853", "5039212"},
+		},
+		{
+			name:    "Windows Server 2022",
+			release: "Windows Server 2022",
+			build:   "20348",
+			kbs:     []string{"5032198", "5033118", "5034129", "5034770", "5035857", "5037422", "5036909", "5037782", "5039227"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			below, err := DetectKBsFromKernelVersion(tt.release, "10.0."+tt.build+".1")
+			if err != nil {
+				t.Fatalf("DetectKBsFromKernelVersion() below: %v", err)
+			}
+			above, err := DetectKBsFromKernelVersion(tt.release, "10.0."+tt.build+".9999")
+			if err != nil {
+				t.Fatalf("DetectKBsFromKernelVersion() above: %v", err)
+			}
+			for _, kb := range tt.kbs {
+				if !slices.Contains(below.Unapplied, kb) {
+					t.Errorf("KB%s not reported unapplied below mapped revisions", kb)
+				}
+				if !slices.Contains(above.Applied, kb) {
