+func TestGetEOLUpdatedSupportDates(t *testing.T) {
+	tests := []struct {
+		family  string
+		release string
+		until   time.Time
+	}{
+		{family: Fedora, release: "37", until: time.Date(2023, 12, 5, 23, 59, 59, 0, time.UTC)},
+		{family: Fedora, release: "38", until: time.Date(2024, 5, 21, 23, 59, 59, 0, time.UTC)},
+		{family: Fedora, release: "40", until: time.Date(2025, 5, 13, 23, 59, 59, 0, time.UTC)},
+		{family: FreeBSD, release: "13", until: time.Date(2026, 4, 30, 23, 59, 59, 0, time.UTC)},
+		{family: FreeBSD, release: "14", until: time.Date(2028, 11, 30, 23, 59, 59, 0, time.UTC)},
+		{family: SUSEEnterpriseServer, release: "13", until: time.Date(2026, 4, 30, 23, 59, 59, 0, time.UTC)},
+		{family: SUSEEnterpriseServer, release: "14", until: time.Date(2028, 11, 30, 23, 59, 59, 0, time.UTC)},
+		{family: SUSEEnterpriseDesktop, release: "13", until: time.Date(2026, 4, 30, 23, 59, 59, 0, time.UTC)},
+		{family: SUSEEnterpriseDesktop, release: "14", until: time.Date(2028, 11, 30, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.family+" "+tt.release, func(t *testing.T) {
+			eol, found := GetEOL(tt.family, tt.release)
+			if !found {
+				t.Fatal("GetEOL() did not find the release")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("StandardSupportUntil = %v, want %v", eol.StandardSupportUntil, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until) {
+				t.Errorf("standard support ended on the cutoff date %v", tt.until)
+			}
+			if !eol.IsStandardSupportEnded(tt.until.Add(time.Second)) {
+				t.Errorf("standard support should end after %v", tt.until)
+			}
+		})
+	}
+}
