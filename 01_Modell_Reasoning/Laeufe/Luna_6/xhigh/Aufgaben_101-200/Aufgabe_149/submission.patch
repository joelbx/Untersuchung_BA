+                    '--enable-features=CustomFeature1,CustomFeature2,'
+                    'CustomFeature3,OverlayScrollbar']
+        assert [arg for arg in args
+                if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)] == [
