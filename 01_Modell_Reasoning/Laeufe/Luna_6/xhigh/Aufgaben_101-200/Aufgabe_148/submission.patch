+const maxTeleportProxyPayloadSize = 64 * 1024
+
+// readTeleportProxyHandshake parses the optional Teleport proxy handshake and
+// then restores it to the reader. The SSH server also reads this handshake to
+// extract tracing context, so the multiplexer must leave the bytes available.
+func readTeleportProxyHandshake(reader *bufio.Reader) (*bufio.Reader, net.Addr, error) {
+	firstBytes, err := reader.Peek(8)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	if !bytes.HasPrefix(teleportProxyPrefix, firstBytes) {
+		return reader, nil, nil
+	}
+
+	prefix, err := reader.Peek(len(teleportProxyPrefix))
+	if err != nil {
+		return nil, nil, trace.Wrap(err, "failed to peek Teleport proxy handshake")
+	}
+	if !bytes.Equal(prefix, teleportProxyPrefix) {
+		return nil, nil, trace.BadParameter("malformed Teleport proxy handshake prefix")
+	}
+
+	handshake := make([]byte, 0, len(teleportProxyPrefix)+128)
+	for range teleportProxyPrefix {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err)
+		}
+		handshake = append(handshake, b)
+	}
+
+	payload := make([]byte, 0, 128)
+	for {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err, "failed to read Teleport proxy handshake")
+		}
+		handshake = append(handshake, b)
+		if b == 0 {
+			break
+		}
+		if len(payload) >= maxTeleportProxyPayloadSize {
+			return nil, nil, trace.BadParameter("Teleport proxy handshake payload exceeds %d bytes", maxTeleportProxyPayloadSize)
+		}
+		payload = append(payload, b)
+	}
+
+	var handshakePayload apisshutils.HandshakePayload
+	if err := json.Unmarshal(payload, &handshakePayload); err != nil {
+		return nil, nil, trace.Wrap(err, "failed to parse Teleport proxy handshake payload")
+	}
+
+	var remoteAddr net.Addr
+	if handshakePayload.ClientAddr != "" {
+		if clientAddr, parseErr := utils.ParseAddr(handshakePayload.ClientAddr); parseErr == nil {
+			remoteAddr = clientAddr
+			if clientAddr.AddrNetwork == "tcp" {
+				remoteAddr = &net.TCPAddr{
+					IP:   net.ParseIP(clientAddr.Host()),
+					Port: clientAddr.Port(0),
+				}
+			}
+		}
+	}
+
+	// Put the handshake back so the SSH server can extract any tracing context.
+	reader = bufio.NewReader(io.MultiReader(bytes.NewReader(handshake), reader))
+	return reader, remoteAddr, nil
+}
