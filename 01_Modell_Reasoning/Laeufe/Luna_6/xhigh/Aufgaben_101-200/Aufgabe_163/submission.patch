+
+// Descriptive aliases make the enum constants clear at call sites.
+const (
+	DatabaseProtocolSQLite   = SQLite
+	DatabaseProtocolPostgres = Postgres
+	DatabaseProtocolMySQL    = MySQL
+)
+
