+	SQLite:   "sqlite",
+	Postgres: "postgres",
+	MySQL:    "mysql",
+}
+
+func (p DatabaseProtocol) String() string {
+	return databaseProtocolNames[p]
+}
+
+func parseDatabaseProtocol(value string) (DatabaseProtocol, error) {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "sqlite":
+		return SQLite, nil
+	case "postgres":
+		return Postgres, nil
+	case "mysql":
+		return MySQL, nil
+	default:
+		return DatabaseProtocolUnknown, fmt.Errorf("invalid value %q for db.protocol; expected one of: sqlite, postgres, mysql", value)
+	}
+}
+
+// Validate checks the database configuration when a URL is not in use.
+func (c DatabaseConfig) Validate() error {
+	if strings.TrimSpace(c.URL) != "" {
+		return nil
+	}
+
+	if c.Protocol == DatabaseProtocolUnknown {
+		return errors.New("db.protocol is required when db.url is not set")
+	}
+	if _, ok := databaseProtocolNames[c.Protocol]; !ok {
+		return fmt.Errorf("invalid value %d for db.protocol; expected one of: sqlite, postgres, mysql", c.Protocol)
+	}
+	if c.Port < 0 || c.Port > 65535 {
+		return errors.New("db.port must be between 1 and 65535 when specified")
+	}
+
+	switch c.Protocol {
+	case SQLite:
+		if strings.TrimSpace(c.Path) == "" && strings.TrimSpace(c.Name) == "" {
+			return errors.New("db.path is required for sqlite when db.url is not set")
+		}
+	case Postgres, MySQL:
+		if strings.TrimSpace(c.Host) == "" {
+			return errors.New("db.host is required when db.url is not set")
+		}
+		if strings.TrimSpace(c.Name) == "" {
+			return errors.New("db.name is required when db.url is not set")
+		}
+	}
+
+	return nil
 }
 
