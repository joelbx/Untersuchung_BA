+func redactDatabaseError(err error, cfg config.DatabaseConfig, dsn string) string {
+	message := err.Error()
+	password := cfg.Password
+	if password == "" && cfg.URL != "" {
+		if parsedURL, err := url.Parse(cfg.URL); err == nil && parsedURL.User != nil {
+			password, _ = parsedURL.User.Password()
+		}
+	}
+	if password != "" {
+		for _, passwordValue := range []string{password, url.QueryEscape(password), url.PathEscape(password)} {
+			message = strings.ReplaceAll(message, passwordValue, "[redacted]")
+		}
+	}
+	if cfg.URL != "" {
+		message = strings.ReplaceAll(message, cfg.URL, redactURL(cfg.URL))
+	}
+	if dsn != "" {
+		message = strings.ReplaceAll(message, dsn, "[redacted connection string]")
+	}
+	message = urlCredentials.ReplaceAllString(message, "$1[redacted]@")
+	return message
+}
+
+func redactURL(raw string) string {
+	return urlCredentials.ReplaceAllString(raw, "$1[redacted]@")
+}
