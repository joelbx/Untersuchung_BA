+// updateRemoteClusterStatus refreshes and persists status using the cluster's
+// current tunnel connections. A missing RemoteCluster is expected for legacy
+// tunnel connection records and is ignored.
+func (s *PresenceService) updateRemoteClusterStatus(ctx context.Context, clusterName string) error {
+	if clusterName == "" {
+		return trace.BadParameter("missing cluster name")
+	}
+	item, err := s.Get(ctx, backend.Key(remoteClustersPrefix, clusterName))
+	if err != nil {
+		if trace.IsNotFound(err) {
+			return nil
+		}
+		return trace.Wrap(err)
+	}
+	rc, err := services.UnmarshalRemoteCluster(item.Value,
 		services.WithResourceID(item.ID), services.WithExpires(item.Expires))
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	return trace.Wrap(s.refreshRemoteClusterStatus(ctx, rc))
+}
+
+// refreshRemoteClusterStatus sets the cluster online while tunnel connections
+// exist and records the newest heartbeat seen, retaining it after connections
+// are removed.
+func (s *PresenceService) refreshRemoteClusterStatus(ctx context.Context, rc services.RemoteCluster) error {
+	connections, err := s.GetTunnelConnections(rc.GetName())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+
+	status := teleport.RemoteClusterStatusOffline
+	heartbeat := rc.GetLastHeartbeat().UTC()
+	if len(connections) > 0 {
+		status = teleport.RemoteClusterStatusOnline
+		latest, err := services.LatestTunnelConnection(connections)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		latestHeartbeat := latest.GetLastHeartbeat().UTC()
+		if latestHeartbeat.After(heartbeat) {
+			heartbeat = latestHeartbeat
+		}
+	}
+
+	currentHeartbeat := rc.GetLastHeartbeat()
+	changed := rc.GetConnectionStatus() != status || currentHeartbeat != heartbeat
+	if !changed {
+		return nil
+	}
+	rc.SetConnectionStatus(status)
+	rc.SetLastHeartbeat(heartbeat)
+	return trace.Wrap(s.UpdateRemoteCluster(ctx, rc))
 }
 
