@@ -0,0 +1,42 @@
+import { forwardRef, HTMLAttributes, ReactEventHandler, Ref } from 'react';
+
+export interface DialogProps extends HTMLAttributes<HTMLDialogElement> {
+    [attribute: `aria-${string}`]: string | number | boolean | undefined;
+    [attribute: `data-${string}`]: string | number | boolean | undefined;
+    open?: boolean;
+    onCancel?: ReactEventHandler<HTMLDialogElement>;
+    onClose?: ReactEventHandler<HTMLDialogElement>;
+}
+
+const supportsNativeDialog = () => {
+    return (
+        typeof HTMLDialogElement !== 'undefined' &&
+        typeof HTMLDialogElement.prototype.showModal === 'function' &&
+        typeof HTMLDialogElement.prototype.close === 'function'
+    );
+};
+
+const Dialog = forwardRef<HTMLDialogElement, DialogProps>(({ children, open, role, ...rest }, ref) => {
+    if (!supportsNativeDialog()) {
+        return (
+            <div
+                {...(rest as HTMLAttributes<HTMLDivElement>)}
+                role={role ?? 'dialog'}
+                hidden={!open}
+                ref={ref as Ref<HTMLDivElement>}
+            >
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} open={open} role={role} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
