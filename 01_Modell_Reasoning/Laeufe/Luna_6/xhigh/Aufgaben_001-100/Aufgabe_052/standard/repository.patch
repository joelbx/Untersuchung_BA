diff --git a/lib/ai/model/tokencount.go b/lib/ai/model/tokencount.go
new file mode 100644
index 0000000..0ee5f92
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,201 @@
+/*
+Copyright 2023 Gravitational, Inc.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package model
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer"
+	"github.com/tiktoken-go/tokenizer/codec"
+
+	"github.com/gravitational/trace"
+)
+
+// TokenCounter reports a token count.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll returns the sum of all counters in the collection.
+func (counters TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range counters {
+		if !isNilTokenCounter(counter) {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+func isNilTokenCounter(counter TokenCounter) bool {
+	if counter == nil {
+		return true
+	}
+
+	value := reflect.ValueOf(counter)
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return value.IsNil()
+	default:
+		return false
+	}
+}
+
+// TokenCount aggregates prompt and completion token counters for one invocation.
+type TokenCount struct {
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount creates an empty token count aggregate.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{}
+}
+
+// AddPromptCounter adds a prompt-side counter. Nil counters are ignored.
+func (count *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if !isNilTokenCounter(prompt) {
+		count.prompt = append(count.prompt, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion-side counter. Nil counters are ignored.
+func (count *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if !isNilTokenCounter(completion) {
+		count.completion = append(count.completion, completion)
+	}
+}
+
+// CountAll returns (promptTotal, completionTotal).
+func (count *TokenCount) CountAll() (int, int) {
+	if count == nil {
+		return 0, 0
+	}
+	return count.prompt.CountAll(), count.completion.CountAll()
+}
+
+// StaticTokenCounter reports a fixed token count.
+type StaticTokenCounter struct {
+	count int
+}
+
+// TokenCount returns the fixed token count.
+func (counter *StaticTokenCounter) TokenCount() int {
+	if counter == nil {
+		return 0
+	}
+	return counter.count
+}
+
+// NewPromptTokenCounter counts prompt tokens using the cl100k_base tokenizer.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	var count int
+	for _, message := range messages {
+		tokens, _, err := tokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter counts a complete non-streamed response using cl100k_base.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter tracks a streamed completion.
+type AsynchronousTokenCounter struct {
+	mu        sync.Mutex
+	tokenizer tokenizer.Codec
+	content   string
+	count     int
+	finished  bool
+}
+
+// NewAsynchronousTokenCounter creates a streamed counter initialized with its first fragment.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	tokens, _, err := tokenizer.Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{
+		tokenizer: tokenizer,
+		content:   start,
+		count:     len(tokens),
+	}, nil
+}
+
+// Add increments the streamed token count by one.
+func (counter *AsynchronousTokenCounter) Add() error {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	if counter.finished {
+		return trace.Errorf("cannot add tokens after the counter has been finalized")
+	}
+	counter.count++
+	return nil
+}
+
+// appendText updates the count from the full streamed text so tokenizer boundaries
