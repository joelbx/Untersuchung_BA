+func (counter *AsynchronousTokenCounter) appendText(fragment string) error {
+	counter.mu.Lock()
+	if counter.finished {
+		counter.mu.Unlock()
+		return trace.Errorf("cannot add tokens after the counter has been finalized")
+	}
+	content := counter.content + fragment
+	counter.mu.Unlock()
+
+	tokens, _, err := counter.tokenizer.Encode(content)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	if counter.finished {
+		return trace.Errorf("cannot add tokens after the counter has been finalized")
+	}
+	counter.content = content
+	counter.count = len(tokens)
+	return nil
+}
+
+// TokenCount finalizes the counter and returns its total including perRequest.
+func (counter *AsynchronousTokenCounter) TokenCount() int {
+	if counter == nil {
+		return 0
+	}
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.finished = true
+	return perRequest + counter.count
+}
