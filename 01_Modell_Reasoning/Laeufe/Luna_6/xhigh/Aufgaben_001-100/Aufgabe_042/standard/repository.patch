diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..c472754
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,56 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+
+const wellKnown = module.exports;
+
+wellKnown.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const parsedUrl = nconf.get('url_parsed');
+	const hostname = parsedUrl && parsedUrl.hostname;
+
+	if (typeof resource !== 'string' || !hostname || !resource.startsWith('acct:')) {
+		return res.sendStatus(400);
+	}
+
+	const atIndex = resource.lastIndexOf('@');
+	const username = resource.slice('acct:'.length, atIndex);
+	const resourceHostname = resource.slice(atIndex + 1);
+	if (atIndex <= 'acct:'.length || username.includes('@') || resourceHostname.toLowerCase() !== hostname.toLowerCase()) {
+		return res.sendStatus(400);
+	}
+
+	const uid = req.uid || 0;
+	if (!await privileges.global.can('view:users', uid)) {
+		return res.sendStatus(403);
+	}
+
+	const userUid = await user.getUidByUsername(username) || await user.getUidByUserslug(username);
+	if (!userUid) {
+		return res.sendStatus(404);
+	}
+
+	const userData = await user.getUserFields(userUid, ['userslug']);
+	if (!userData || !userData.uid || !userData.userslug) {
+		return res.sendStatus(404);
+	}
+
+	const profileUrl = `${nconf.get('url')}/user/${userData.userslug}`;
+	const response = {
+		subject: resource,
+		aliases: [
+			`${nconf.get('url')}/uid/${userData.uid}`,
+			profileUrl,
+		],
+		links: [{
+			rel: 'http://webfinger.net/rel/profile-page',
+			type: 'text/html',
+			href: profileUrl,
+		}],
+	};
+
+	return res.type('application/jrd+json').json(response);
+};
