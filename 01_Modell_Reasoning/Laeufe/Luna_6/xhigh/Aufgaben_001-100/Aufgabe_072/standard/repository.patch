+/**
+ * Extract the main hostname label from a URL without relying on the browser's
+ * URL parser. For example, `www.example.com` returns `example`.
+ */
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(
+        /^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^/?#@]*@)?(\[[^\]]+\]|[^:/?#]+)(?::\d+)?(?:[/?#]|$)/i
+    );
+
+    if (!match) {
+        return '';
+    }
+
+    const hostname = match[1].replace(/^www\./i, '');
+    if (hostname.startsWith('[')) {
+        return hostname;
+    }
+    if (/^\d{1,3}(?:\.\d{1,3}){3}$/.test(hostname)) {
+        return hostname;
+    }
+
+    const labels = hostname.split('.');
+    return labels.length > 1 ? labels[labels.length - 2] : labels[0];
+};
+
+/** Convert only the hostname to ASCII Punycode, preserving the rest of the URL. */
+export const punycodeUrl = (url: string): string => {
+    const match = url.match(/^((?:[a-z][a-z\d+.-]*:)?\/\/)([^/?#]*)([\s\S]*)$/i);
+
+    if (!match) {
+        return url;
+    }
+
+    try {
+        const [, protocol, authority, suffix] = match;
+        const hostStart = authority.lastIndexOf('@') + 1;
+        const hostAndPort = authority.slice(hostStart);
+
+        let hostname: string;
+        let port: string;
+
+        // IPv6 literals are already ASCII and must keep their brackets.
+        if (hostAndPort.startsWith('[')) {
+            const hostEnd = hostAndPort.indexOf(']');
+            if (hostEnd === -1) {
+                return url;
+            }
+            hostname = hostAndPort.slice(0, hostEnd + 1);
+            port = hostAndPort.slice(hostEnd + 1);
+            if (port && !/^:\d+$/.test(port)) {
+                return url;
+            }
+        } else {
+            const portSeparator = hostAndPort.lastIndexOf(':');
+            const hasPort = portSeparator !== -1 && /^:\d+$/.test(hostAndPort.slice(portSeparator));
+            hostname = hasPort ? hostAndPort.slice(0, portSeparator) : hostAndPort;
+            port = hasPort ? hostAndPort.slice(portSeparator) : '';
+        }
+
+        if (!hostname) {
+            return url;
+        }
+
+        const asciiHostname = hostname.startsWith('[') ? hostname : punycode.toASCII(hostname);
+
+        // Trim trailing slashes from the pathname while leaving query/hash text intact.
+        const suffixMatch = suffix.match(/^([^?#]*)([\s\S]*)$/)!;
+        const pathname = suffixMatch[1].replace(/\/+$/, '');
+        return `${protocol}${authority.slice(0, hostStart)}${asciiHostname}${port}${pathname}${suffixMatch[2]}`;
+    } catch (e: any) {
+        return url;
+    }
+};
+
 export const isMailTo = (url: string): boolean => {
     return url.toLowerCase().startsWith('mailto:');
 };
