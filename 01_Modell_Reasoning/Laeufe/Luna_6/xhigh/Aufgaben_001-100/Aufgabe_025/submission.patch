+var environmentVariableReferencePattern = regexp.MustCompile(`^\$\{([a-zA-Z_][a-zA-Z0-9_]*)\}$`)
+
+func environmentVariableSubstitutionHookFunc() mapstructure.DecodeHookFunc {
+	return func(from, to reflect.Type, data interface{}) (interface{}, error) {
+		if from.Kind() != reflect.String {
+			return data, nil
+		}
+
+		value, ok := data.(string)
+		if !ok {
+			return data, nil
+		}
+
+		match := environmentVariableReferencePattern.FindStringSubmatch(value)
+		if len(match) != 2 {
+			return data, nil
+		}
+
+		if envValue, exists := os.LookupEnv(match[1]); exists {
+			return envValue, nil
+		}
+
+		return data, nil
+	}
+}
+
