+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	stdout := `libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 39.el7 i686
+error: file /proc/1/map_files/abc: Permission denied
+error: file /tmp/unowned: is not owned by any package
+error: file /tmp/missing: No such file or directory`
+
+	owners, err := r.parseOwnerPkgs(stdout)
+	if err != nil {
+		t.Fatalf("parseOwnerPkgs returned error: %v", err)
+	}
+	if len(owners) != 2 {
+		t.Fatalf("expected both architecture owners, got %#v", owners)
+	}
+	if owners["libgcc|4.8.5|39.el7|x86_64"].Arch != "x86_64" ||
+		owners["libgcc|4.8.5|39.el7|i686"].Arch != "i686" {
+		t.Fatalf("architecture ownership was not preserved: %#v", owners)
+	}
+
+	if _, err := r.parseOwnerPkgs("unexpected rpm output"); err == nil {
+		t.Fatal("expected malformed query output to return an error")
+	}
+}
