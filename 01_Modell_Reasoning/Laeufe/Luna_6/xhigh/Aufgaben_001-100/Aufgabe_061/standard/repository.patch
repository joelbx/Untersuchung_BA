+// pkgPs associates running processes with the installed packages that own
+// their executable or mapped files.
+func (l *base) pkgPs(getOwnerPkgs func([]string) (models.Packages, error)) error {
+	stdout, err := l.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+	pidNames := l.parsePs(stdout)
+	pidLoadedFiles := map[string][]string{}
+	for pid := range pidNames {
+		stdout, err := l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec ls -l /proc/%s/exe err: %s", pid, err)
+			continue
+		}
+		exe, err := l.parseLsProcExe(stdout)
+		if err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], exe)
+
+		stdout, err = l.grepProcMap(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/maps: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], l.parseGrepProcMap(stdout)...)
+	}
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = l.lsOfListen()
+	if err != nil {
+		// Port information is optional; continue with process ownership results.
+		l.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range l.parseLsOf(stdout) {
+		for _, pid := range pids {
+			portStat, err := models.NewPortStat(ipPort)
+			if err != nil {
+				l.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+				continue
+			}
+			pidListenPorts[pid] = append(pidListenPorts[pid], *portStat)
+		}
+	}
+
+	for pid, paths := range pidLoadedFiles {
+		owners, err := getOwnerPkgs(paths)
+		if err != nil {
+			l.log.Debugf("Failed to get package owner by file path: %v, err: %s", paths, err)
+			continue
+		}
+
+		proc := models.AffectedProcess{
+			PID:             pid,
+			Name:            pidNames[pid],
+			ListenPortStats: pidListenPorts[pid],
+		}
+		seen := map[string]struct{}{}
+		for _, owner := range owners {
+			// The package database may list multiple architectures or versions
+			// under one name. Prefer the exact owner record when it is present,
+			// then fall back to the scanned package with the same name.
+			name := owner.Name
+			installedName := ""
+			for key, installed := range l.Packages {
+				if installed.Name != owner.Name || installed.FQPN() != owner.FQPN() {
+					continue
+				}
+				if owner.Arch == "" || installed.Arch == "" || installed.Arch == owner.Arch {
+					installedName = key
+					break
+				}
+			}
+			if installedName == "" {
+				if _, ok := l.Packages[name]; ok {
+					installedName = name
+				}
+			}
+			if installedName == "" {
+				l.log.Debugf("Package owner not found in scanned packages: %+v", owner)
+				continue
+			}
+			if _, ok := seen[installedName]; ok {
+				continue
+			}
+			seen[installedName] = struct{}{}
+			pack := l.Packages[installedName]
+			pack.AffectedProcs = append(pack.AffectedProcs, proc)
+			l.Packages[installedName] = pack
+		}
+	}
+	return nil
+}
