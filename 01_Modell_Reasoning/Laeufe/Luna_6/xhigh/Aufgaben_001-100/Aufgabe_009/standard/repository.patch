+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { FormEvent, useEffect, useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Field from '../../elements/Field';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [isEditing, setIsEditing] = useState(false);
+    const [deviceName, setDeviceName] = useState('');
+    const [savedName, setSavedName] = useState<string>();
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState(false);
+
+    useEffect(() => {
+        setSavedName(undefined);
+    }, [device.device_id, device.display_name]);
+
+    const displayedName = savedName ?? device.display_name ?? device.device_id;
+
+    const onRename = (): void => {
+        setDeviceName(displayedName);
+        setError(false);
+        setIsEditing(true);
+    };
+
+    const onCancel = (): void => {
+        setDeviceName(displayedName);
+        setError(false);
+        setIsEditing(false);
+    };
+
+    const saveName = async (): Promise<void> => {
+        if (isSaving) return;
+
+        setError(false);
+        if (deviceName === displayedName) {
+            setIsEditing(false);
+            return;
+        }
+
+        setIsSaving(true);
+        try {
+            await saveDeviceName(device.device_id, deviceName);
+            setSavedName(deviceName);
+            setIsEditing(false);
+        } catch (error) {
+            setError(true);
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    const onSubmit = (event: FormEvent<HTMLFormElement>): void => {
+        event.preventDefault();
+        void saveName();
+    };
+
+    return <div className='mx_DeviceDetailHeading' data-testid='device-detail-heading'>
+        { isEditing
+            ? <form
+                className='mx_DeviceDetailHeading_editView'
+                data-testid='device-detail-heading-edit'
+                onSubmit={onSubmit}
+            >
+                <Field
+                    label={_t('Session name')}
+                    type='text'
+                    value={deviceName}
+                    maxLength={100}
+                    autoComplete='off'
+                    autoFocus
+                    data-testid='device-detail-heading-input'
+                    onChange={(event) => setDeviceName(event.target.value)}
+                />
+                <p className='mx_DeviceDetailHeading_disclosure'>
+                    { _t('Session names may be visible to people you communicate with.') }
+                </p>
+                { error && <div
+                    className='mx_DeviceDetailHeading_error'
+                    data-testid='device-detail-heading-error'
+                    role='alert'
+                >
+                    Failed to set display name.
+                </div> }
+                <div className='mx_DeviceDetailHeading_actions'>
+                    <AccessibleButton
+                        element='button'
+                        type='submit'
+                        kind='primary'
+                        disabled={isSaving}
+                        data-testid='device-detail-heading-save'
+                        onClick={(event) => {
+                            event?.preventDefault();
+                            void saveName();
+                        }}
+                    >
+                        { _t('Save') }
+                    </AccessibleButton>
+                    <AccessibleButton
+                        element='button'
+                        type='button'
+                        kind='secondary'
+                        disabled={isSaving}
+                        data-testid='device-detail-heading-cancel'
+                        onClick={onCancel}
+                    >
+                        { _t('Cancel') }
+                    </AccessibleButton>
+                    { isSaving && <Spinner w={16} h={16} message={_t('Saving...')} /> }
+                </div>
+            </form>
+            : <div
+                className='mx_DeviceDetailHeading_readView'
+                data-testid='device-detail-heading-read'
+            >
+                <Heading size='h3'>{ displayedName }</Heading>
+                <AccessibleButton
+                    kind='link_inline'
+                    onClick={onRename}
+                    data-testid='device-detail-heading-rename'
+                >
+                    { _t('Rename') }
+                </AccessibleButton>
+            </div>
+        }
+    </div>;
+};
+
+export default DeviceDetailHeading;
