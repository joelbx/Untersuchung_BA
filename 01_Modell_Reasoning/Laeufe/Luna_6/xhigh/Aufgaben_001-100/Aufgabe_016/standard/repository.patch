+def get_service_ip(image_name: str) -> str:
+    """Return a Docker container's IP, accepting a Compose service name too."""
+    service_or_container = image_name.rsplit("/", 1)[-1]
+    candidates = [image_name]
+    if not service_or_container.startswith("openlibrary-"):
+        candidates.append(f"openlibrary-{service_or_container}-1")
+
+    for container_name in dict.fromkeys(candidates):
+        result = subprocess.run(
+            [
+                "docker",
+                "inspect",
+                "--format={{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}",
+                container_name,
+            ],
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+        ip_address = result.stdout.strip()
+        if result.returncode == 0 and ip_address:
+            try:
+                return str(ipaddress.ip_address(ip_address))
+            except ValueError:
+                continue
+
+    raise RuntimeError(f"Could not find an IP address for Docker container {image_name!r}")
