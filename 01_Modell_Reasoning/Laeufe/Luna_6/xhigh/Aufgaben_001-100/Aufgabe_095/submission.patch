+def make_date_string(year: int, month: Optional[int], day: Optional[int]) -> str:
+    """Format a reading-log date using only the supplied date components."""
+    result = f'{year}'
+    if month is None:
+        return result
+
+    result += f'-{month:02}'
+    if day is not None:
+        result += f'-{day:02}'
+    return result
+
+
+class patron_check_ins:
+    def is_valid(self, data: dict) -> bool:
+        """Validate that an event update has an id and content to update."""
+        if not isinstance(data, dict) or data.get('id') in (None, ''):
+            return False
+        return (
+            data.get('year') is not None
+            or ('data' in data and data['data'] is not None)
+        )
+
