 type touchIDImpl struct{}
 
 func (touchIDImpl) IsAvailable() bool {
-	// TODO(codingllama): Write a deeper check that looks at binary
-	//  signature/entitlements/etc.
-	return true
+	diag, err := nativeDiag()
+	return err == nil && diag.IsAvailable
+}
+
+func nativeDiag() (*DiagResult, error) {
+	var hasSignature, hasEntitlements, passedLAPolicyTest, passedSecureEnclaveTest C.int
+	if C.TouchIDDiag(
+		&hasSignature,
+		&hasEntitlements,
+		&passedLAPolicyTest,
+		&passedSecureEnclaveTest,
+	) != 0 {
+		return nil, errors.New("failed to run Touch ID diagnostics")
+	}
+
+	result := &DiagResult{
+		HasCompileSupport:       true,
+		HasSignature:            hasSignature != 0,
+		HasEntitlements:         hasEntitlements != 0,
+		PassedLAPolicyTest:      passedLAPolicyTest != 0,
+		PassedSecureEnclaveTest: passedSecureEnclaveTest != 0,
+	}
+	result.IsAvailable = result.HasCompileSupport && result.HasSignature &&
+		result.HasEntitlements && result.PassedLAPolicyTest && result.PassedSecureEnclaveTest
+	return result, nil
 }
 
