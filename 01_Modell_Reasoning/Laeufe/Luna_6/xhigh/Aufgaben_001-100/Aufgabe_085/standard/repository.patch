+// CountDiff returns the number of newly detected and resolved vulnerabilities.
+func (v VulnInfos) CountDiff() (nPlus int, nMinus int) {
+	for _, vuln := range v {
+		switch vuln.DiffStatus {
+		case DiffPlus:
+			nPlus++
+		case DiffMinus:
+			nMinus++
+		}
+	}
+	return
+}
