diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..d1adee9
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,121 @@
+---
+- name: prepare collection upgrade test directories
+  file:
+    path: '{{ galaxy_dir }}/upgrade-{{ test_name }}'
+    state: absent
+
+- name: install an older collection version before upgrade - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install namespace1.name1:1.0.0
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections'
+  register: collection_upgrade_initial
+
+- name: upgrade collection to the latest allowed version - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade namespace1.name1
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections'
+  register: collection_upgrade_latest
+
+- name: read upgraded collection manifest - {{ test_name }}
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections/namespace1/name1/MANIFEST.json'
+  register: collection_upgrade_manifest
+
+- name: assert collection was upgraded - {{ test_name }}
+  assert:
+    that:
+    - "\"Installing 'namespace1.name1:1.0.9' to\" in collection_upgrade_latest.stdout"
+    - (collection_upgrade_manifest.content | b64decode | from_json).collection_info.version == '1.0.9'
+
+- name: rerun upgrade for an already current collection - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install -U namespace1.name1
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections'
+  register: collection_upgrade_current
+
+- name: assert current collection was not reinstalled - {{ test_name }}
+  assert:
+    that:
+    - "\"Skipping 'namespace1.name1:1.0.9' as version '1.0.9' is already installed\" in collection_upgrade_current.stdout"
+
+- name: reset installed collection before requirements file upgrade - {{ test_name }}
+  file:
+    path: '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections/namespace1/name1'
+    state: absent
+
+- name: install an older collection before requirements file upgrade - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install namespace1.name1:1.0.0
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections'
+
+- name: create requirements file for collection upgrade - {{ test_name }}
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade-{{ test_name }}/requirements.yml'
+    content: |
+      collections:
+      - name: namespace1.name1
+        version: '>=1.0.0,<2.0.0'
+
+- name: upgrade collections listed in a requirements file - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade --requirements-file
+    '{{ galaxy_dir }}/upgrade-{{ test_name }}/requirements.yml'
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-{{ test_name }}/ansible_collections'
+  register: collection_upgrade_requirements
+
+- name: assert requirements file upgrade obeyed its version constraint - {{ test_name }}
+  assert:
+    that:
+    - "\"Installing 'namespace1.name1:1.0.9' to\" in collection_upgrade_requirements.stdout"
+
+- name: prepare dependency upgrade test directory - {{ test_name }}
+  file:
+    path: '{{ galaxy_dir }}/upgrade-dependencies-{{ test_name }}'
+    state: absent
+
+- name: install an old dependency before upgrading its parent - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install child_dep.child_collection:0.4.0
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-dependencies-{{ test_name }}/ansible_collections'
+
+- name: install a parent and upgrade its now incompatible dependency - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade parent_dep.parent_collection
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-dependencies-{{ test_name }}/ansible_collections'
+  register: collection_dependency_upgrade
+
+- name: read upgraded dependency manifest - {{ test_name }}
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade-dependencies-{{ test_name }}/ansible_collections/child_dep/child_collection/MANIFEST.json'
+  register: collection_dependency_upgrade_manifest
+
+- name: assert incompatible dependency was upgraded - {{ test_name }}
+  assert:
+    that:
+    - "\"Installing 'child_dep.child_collection:0.9.9' to\" in collection_dependency_upgrade.stdout"
+    - (collection_dependency_upgrade_manifest.content | b64decode | from_json).collection_info.version == '0.9.9'
+
+- name: prepare no-deps upgrade test directory - {{ test_name }}
+  file:
+    path: '{{ galaxy_dir }}/upgrade-no-deps-{{ test_name }}'
+    state: absent
+
+- name: install dependency that should remain unchanged with no-deps - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install child_dep.child_collection:0.4.0
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-no-deps-{{ test_name }}/ansible_collections'
+
+- name: upgrade parent with dependency resolution disabled - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade --no-deps parent_dep.parent_collection
+    --server '{{ test_name }}' --collections-path '{{ galaxy_dir }}/upgrade-no-deps-{{ test_name }}/ansible_collections'
+
+- name: read dependency manifest after no-deps upgrade - {{ test_name }}
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade-no-deps-{{ test_name }}/ansible_collections/child_dep/child_collection/MANIFEST.json'
+  register: collection_no_deps_manifest
+
+- name: assert no-deps left the installed dependency unchanged - {{ test_name }}
+  assert:
+    that:
+    - (collection_no_deps_manifest.content | b64decode | from_json).collection_info.version == '0.4.0'
