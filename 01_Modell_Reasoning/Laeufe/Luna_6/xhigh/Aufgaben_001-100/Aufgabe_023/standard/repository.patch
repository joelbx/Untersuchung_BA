+func TestAuthenticationGRPCDoesNotConnectDatabaseForJWT(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	publicKey, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyPath := filepath.Join(t.TempDir(), "jwt-public-key.pem")
+	if err := os.WriteFile(keyPath, pem.EncodeToMemory(&pem.Block{
+		Type:  "PUBLIC KEY",
+		Bytes: publicKey,
+	}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg := &config.Config{
+		Authentication: config.AuthenticationConfig{
+			Required: true,
+			Methods: config.AuthenticationMethods{
+				JWT: config.AuthenticationMethod[config.AuthenticationMethodJWTConfig]{
+					Enabled: true,
+					Method: config.AuthenticationMethodJWTConfig{
+						PublicKeyFile: keyPath,
+					},
+				},
+			},
+		},
+		Database: config.DatabaseConfig{URL: "invalid://database-url"},
+		Storage:  config.StorageConfig{Type: config.LocalStorageType},
+	}
+
+	register, interceptors, shutdown, err := authenticationGRPC(
+		context.Background(),
+		zaptest.NewLogger(t),
+		cfg,
+		false,
+		false,
+	)
+	assert.NoError(t, err)
+	assert.NotEmpty(t, register)
+	assert.NotEmpty(t, interceptors, "JWT authentication middleware should still be configured")
+	if shutdown != nil {
+		assert.NoError(t, shutdown(context.Background()))
+	}
+}
