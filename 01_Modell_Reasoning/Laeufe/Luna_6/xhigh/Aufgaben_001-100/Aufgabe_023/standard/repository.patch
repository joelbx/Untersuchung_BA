new file mode 100644
index 0000000..dbf7c7a
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,82 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestAuthenticationRequiresDatabase(t *testing.T) {
+	want := map[string]bool{
+		"token":      true,
+		"oidc":       true,
+		"github":     true,
+		"kubernetes": true,
+		"jwt":        false,
+	}
+
+	for _, method := range (&AuthenticationMethods{}).AllMethods() {
+		method := method
+		t.Run(method.Name(), func(t *testing.T) {
+			if method.RequiresDatabase != want[method.Name()] {
+				t.Fatalf("%s RequiresDatabase = %t, want %t", method.Name(), method.RequiresDatabase, want[method.Name()])
+			}
+
+			cfg := AuthenticationConfig{Required: true}
+			if cfg.RequiresDatabase() {
+				t.Fatal("Required without an enabled database-backed method should not require a database")
+			}
+
+			for _, configuredMethod := range cfg.Methods.AllMethods() {
+				if configuredMethod.Name() != method.Name() {
+					continue
+				}
+
+				configuredMethod.Enable(t)
+				configuredMethod.SetCleanup(t, AuthenticationCleanupSchedule{
+					Interval:    time.Hour,
+					GracePeriod: time.Minute,
+				})
+			}
+
+			if got := cfg.RequiresDatabase(); got != want[method.Name()] {
+				t.Fatalf("RequiresDatabase() = %t, want %t", got, want[method.Name()])
+			}
+
+			if got := cfg.ShouldRunCleanup(); got != want[method.Name()] {
+				t.Fatalf("ShouldRunCleanup() = %t, want %t", got, want[method.Name()])
+			}
+		})
+	}
+}
+
+func TestShouldRunCleanupRequiresEnabledMethod(t *testing.T) {
+	cfg := AuthenticationConfig{}
+	for _, method := range cfg.Methods.AllMethods() {
+		if method.Name() == "token" {
+			method.SetCleanup(t, AuthenticationCleanupSchedule{
+				Interval:    time.Hour,
+				GracePeriod: time.Minute,
+			})
+		}
+	}
+
+	if cfg.ShouldRunCleanup() {
+		t.Fatal("cleanup should not run for a disabled method")
+	}
+}
+
+func TestAuthenticationRequiresDatabaseForAnyEnabledDatabaseMethod(t *testing.T) {
+	cfg := AuthenticationConfig{
+		Methods: AuthenticationMethods{
+			JWT: AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true},
+		},
+	}
+	if cfg.RequiresDatabase() {
+		t.Fatal("JWT alone should not require a database")
+	}
+
+	cfg.Methods.Token.Enabled = true
+	if !cfg.RequiresDatabase() {
+		t.Fatal("an enabled token method should require a database")
+	}
+}
