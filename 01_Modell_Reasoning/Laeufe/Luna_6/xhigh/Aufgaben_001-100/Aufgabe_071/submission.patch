-        clixml = ET.fromstring(current_element)
+    def decode_text(text: str) -> str:
+        tokens = list(re.finditer(r'_x([0-9a-fA-F]{4})_', text))
+        decoded = []
+        position = 0
+        token_index = 0
+
+        while token_index < len(tokens):
+            token = tokens[token_index]
+            decoded.append(text[position:token.start()])
+            code_unit = int(token.group(1), 16)
+            next_token = tokens[token_index + 1] if token_index + 1 < len(tokens) else None
+
+            if token.group(0) == '_x005F_':
+                if next_token is not None and token.end() == next_token.start():
+                    decoded.append('_')
+                else:
+                    decoded.append(token.group(0))
+                position = token.end()
+                token_index += 1
+                continue
+
+            if (0xD800 <= code_unit <= 0xDBFF and next_token is not None and
+                    token.end() == next_token.start()):
+                low_surrogate = int(next_token.group(1), 16)
+                if 0xDC00 <= low_surrogate <= 0xDFFF:
+                    scalar = 0x10000 + ((code_unit - 0xD800) << 10) + (low_surrogate - 0xDC00)
+                    decoded.append(chr(scalar))
+                    position = next_token.end()
+                    token_index += 2
+                    continue
+
+            decoded.append(chr(code_unit))
+            position = token.end()
+            token_index += 1
+
+        decoded.append(text[position:])
+        return ''.join(decoded)
+
+    # CLIXML can contain multiple blocks, each preceded by its own marker.
+    # Keep the blocks in their original order and separate their output only.
+    block_results = []
+    for match in re.finditer(rb'<Objs\b.*?</Objs>', data, re.DOTALL):
+        clixml = ET.fromstring(match.group(0))
         namespace_match = re.match(r'{(.*)}', clixml.tag)
         namespace = "{%s}" % namespace_match.group(1) if namespace_match else ""
 
         strings = clixml.findall("./%sS" % namespace)
-        lines.extend([e.text.replace('_x000D__x000A_', '') for e in strings if e.attrib.get('S') == stream])
+        block_text = decode_text(''.join(element.text or '' for element in strings
+                                         if element.attrib.get('S') == stream))
+        if block_text:
+            block_results.append(block_text)
 
-    return to_bytes('\r\n'.join(lines))
+    return to_bytes('\r\n'.join(block_results), errors='surrogatepass')
 
 
