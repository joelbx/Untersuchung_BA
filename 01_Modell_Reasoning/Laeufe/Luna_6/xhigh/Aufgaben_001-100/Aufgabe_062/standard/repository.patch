+// NotifyExit closes the global stdin reader, allowing it to restore the
+// terminal if a password read is active.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		_ = closer.Close()
+	}
