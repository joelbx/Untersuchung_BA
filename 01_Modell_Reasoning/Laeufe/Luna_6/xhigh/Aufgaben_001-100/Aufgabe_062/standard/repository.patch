+// maybeRestoreTerm restores the saved terminal state when a password read is
+// active. The caller must hold cr.mu.
+func (cr *ContextReader) maybeRestoreTerm() error {
+	if cr.state != readerStatePassword || cr.previousTermState == nil {
+		return nil
+	}
+	if err := cr.term.Restore(cr.fd, cr.previousTermState); err != nil {
+		return trace.Wrap(err)
+	}
+	cr.previousTermState = nil
+	return nil
+}
+
 func (cr *ContextReader) waitForRead(ctx context.Context) ([]byte, error) {
 	select {
 	case <-ctx.Done():
+		if err := cr.abandonPasswordRead(); err != nil {
+			return nil, trace.Wrap(err)
+		}
 		return nil, trace.Wrap(ctx.Err())
 	case <-cr.closed:
 		return nil, ErrReaderClosed
 	case read := <-cr.reads:
+		// If the read and context expiration become ready together, expiration
+		// takes precedence so a timed out password is never returned as a result.
+		if err := ctx.Err(); err != nil {
+			if restoreErr := cr.abandonPasswordRead(); restoreErr != nil {
+				return nil, trace.Wrap(restoreErr)
+			}
+			return nil, trace.Wrap(err)
+		}
 		return read.value, read.err
 	}
 }
 
+func (cr *ContextReader) abandonPasswordRead() error {
+	cr.mu.Lock()
+	defer cr.mu.Unlock()
+
+	if cr.state != readerStatePassword {
+		return nil
+	}
+	if err := cr.maybeRestoreTerm(); err != nil {
+		return err
+	}
+	cr.state = readerStateClean
+	return nil
+}
