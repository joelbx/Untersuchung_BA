+func TestU2FSignRequestMultipleDevices(t *testing.T) {
+	ctx := context.Background()
+	clock := clockwork.NewFakeClock()
+	as, err := NewTestAuthServer(TestAuthServerConfig{
+		Dir:   t.TempDir(),
+		Clock: clock,
+	})
+	require.NoError(t, err)
+
+	authPref, err := services.NewAuthPreference(types.AuthPreferenceSpecV2{
+		Type: teleport.Local,
+		U2F: &types.U2F{
+			AppID:  "teleport",
+			Facets: []string{"teleport"},
+		},
+	})
+	require.NoError(t, err)
+	require.NoError(t, as.AuthServer.SetAuthPreference(authPref))
+
+	const username = "multi-u2f-user"
+	user, _, err := CreateUserAndRole(as.AuthServer, username, []string{"role"})
+	require.NoError(t, err)
+	require.NoError(t, as.AuthServer.UpsertPassword(username, []byte("password")))
+
+	keysByHandle := make(map[string]*mocku2f.Key, 2)
+	for i := 0; i < 2; i++ {
+		key, err := mocku2f.Create()
+		require.NoError(t, err)
+		device, err := u2f.NewDevice(fmt.Sprintf("u2f-%d", i), &u2f.Registration{
+			KeyHandle: key.KeyHandle,
+			PubKey:    key.PrivateKey.PublicKey,
+		}, clock.Now())
+		require.NoError(t, err)
+		require.NoError(t, as.AuthServer.UpsertMFADevice(ctx, username, device))
+		keyHandle := base64.URLEncoding.WithPadding(base64.NoPadding).EncodeToString(key.KeyHandle)
+		keysByHandle[keyHandle] = key
+	}
+
+	challenge, err := as.AuthServer.U2FSignRequest(username, []byte("password"))
+	require.NoError(t, err)
+	require.Len(t, challenge.Challenges, len(keysByHandle))
+	require.NotNil(t, challenge.AuthenticateChallenge)
+	require.Equal(t, challenge.Challenges[0], *challenge.AuthenticateChallenge)
+
+	// The JSON response preserves the legacy top-level challenge fields and
+	// includes the complete challenge list for updated clients.
+	payload, err := json.Marshal(challenge)
+	require.NoError(t, err)
+	var legacy u2f.AuthenticateChallenge
+	require.NoError(t, json.Unmarshal(payload, &legacy))
+	require.Equal(t, *challenge.AuthenticateChallenge, legacy)
+	var decoded *U2FAuthenticateChallenge
+	require.NoError(t, json.Unmarshal(payload, &decoded))
+	require.NotNil(t, decoded)
+	require.Len(t, decoded.GetChallenges(), len(keysByHandle))
+
+	// A legacy server response that contains only one challenge is normalized
+	// into the same challenge list for updated clients.
+	legacyPayload, err := json.Marshal(challenge.AuthenticateChallenge)
+	require.NoError(t, err)
+	var legacyDecoded *U2FAuthenticateChallenge
+	require.NoError(t, json.Unmarshal(legacyPayload, &legacyDecoded))
+	require.NotNil(t, legacyDecoded)
+	require.Equal(t, []u2f.AuthenticateChallenge{*challenge.AuthenticateChallenge}, legacyDecoded.GetChallenges())
+
+	// Each device can answer its own challenge, including a device other than
+	// the one exposed through the legacy single-challenge fields.
+	for _, challenge := range challenge.Challenges {
+		key := keysByHandle[challenge.KeyHandle]
+		require.NotNil(t, key)
+		response, err := key.SignResponse(&challenge)
+		require.NoError(t, err)
+		require.NoError(t, as.AuthServer.CheckU2FSignResponse(ctx, user.GetName(), response))
+	}
+}
