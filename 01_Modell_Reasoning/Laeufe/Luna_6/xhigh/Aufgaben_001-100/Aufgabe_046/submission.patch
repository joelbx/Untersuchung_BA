+class ModuleUtilLocatorBase:
+    """Resolve a module_utils import and describe the files for the payload."""
+
+    module_utils_prefix = ()
+    redirect_first = False
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False,
+                 redirect_first=None):
+        self.fq_name_parts = tuple(fq_name_parts)
+        self.child_is_redirected = child_is_redirected
+        self.redirect_first = self.redirect_first if redirect_first is None else redirect_first
+        self.is_ambiguous = bool(is_ambiguous and self._module_utils_depth() > 1)
+        self.found = False
+        self.redirected = False
+        self.normalized_name_parts = None
+        self.is_package = False
+        self.output_path = None
+        self.source_path = None
+        self.source_code = None
+        self.module_info = None
+        self.resolved_files = []
+        self._resolve()
+
+    def _module_utils_depth(self):
+        if self.fq_name_parts[:len(self.module_utils_prefix)] == self.module_utils_prefix:
+            return len(self.fq_name_parts) - len(self.module_utils_prefix)
+        return 0
+
+    def _candidate_parts(self):
+        candidates = [self.fq_name_parts]
+        if self.is_ambiguous:
+            candidates.append(self.fq_name_parts[:-1])
+        return candidates
+
+    def candidate_names_joined(self):
+        return ['.'.join(parts) for parts in self._candidate_parts()]
+
+    def _resolve(self):
+        raise NotImplementedError
+
+    def _set_result(self, name_parts, source, path, is_package=False, redirected=False, module_info=None):
+        self.found = True
+        self.redirected = redirected
+        self.normalized_name_parts = tuple(name_parts) + (('__init__',) if is_package else ())
+        self.is_package = is_package
+        self.output_path = '/'.join(self.normalized_name_parts) + '.py'
+        self.source_path = path
+        self.source_code = source
+        self.module_info = module_info
+        self.resolved_files = [(self.normalized_name_parts, source, path)]
+
+    def _redirect_candidate(self, candidate, route):
+        matched_depth = route.get('_matched_depth', len(candidate) - len(self.module_utils_prefix))
+        if self.is_ambiguous and matched_depth < len(candidate) - len(self.module_utils_prefix):
+            return candidate[:len(self.module_utils_prefix) + matched_depth]
+        return candidate
+
+
+def _module_utils_route(collection_name, resource_name):
+    try:
+        metadata = _get_collection_metadata(collection_name)
+    except (ImportError, ValueError) as exc:
+        raise AnsibleError(to_native(exc))
+    return metadata.get('plugin_routing', {}).get('module_utils', {}).get(resource_name, {})
+
+
+def _process_module_utils_route(route, fq_name, collection_name):
+    deprecation = route.get('deprecation')
+    if deprecation:
+        warning_text = deprecation.get('warning_text') or '{0} is deprecated'.format(fq_name)
+        display.deprecated(warning_text, version=deprecation.get('removal_version'),
+                           date=deprecation.get('removal_date'), collection_name=collection_name)
+
+    tombstone = route.get('tombstone')
+    if tombstone:
+        warning_text = tombstone.get('warning_text') or '{0} has been removed'.format(fq_name)
+        removal_date = tombstone.get('removal_date')
+        removal_version = tombstone.get('removal_version')
+        message = display.get_deprecation_message(warning_text, version=removal_version,
+                                                  date=removal_date, collection_name=collection_name,
+                                                  removed=True)
+        raise AnsibleError(message)
+
