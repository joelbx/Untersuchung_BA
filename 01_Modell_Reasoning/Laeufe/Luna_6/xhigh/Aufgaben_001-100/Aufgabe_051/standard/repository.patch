+// readKubeClusterFlag gets the Kubernetes cluster from the environment when
+// it was not specified on the command line.
+func readKubeClusterFlag(cf *CLIConf, fn envGetter) {
+	if cf.KubernetesCluster != "" {
+		return
+	}
+
+	cf.KubernetesCluster = fn(kubeClusterEnvVar)
+}
