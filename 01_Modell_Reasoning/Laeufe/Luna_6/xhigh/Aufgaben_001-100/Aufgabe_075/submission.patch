diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..3575693
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,76 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+// NewUserPropsRepository creates a repository scoped to the user in ctx.
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	r := &userPropsRepository{}
+	r.ctx = ctx
+	r.ormer = o
+	r.tableName = "user_props"
+	return r
+}
+
+func (r userPropsRepository) Put(key string, value string) error {
+	userID, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+
+	where := Eq{"user_id": userID, "key": key}
+	update := Update(r.tableName).Set("value", value).Where(where)
+	count, err := r.executeSQL(update)
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").Values(userID, key, value)
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	userID, err := r.currentUserID()
+	if err != nil {
+		return "", err
+	}
+
+	sel := Select("value").From(r.tableName).Where(Eq{"user_id": userID, "key": key})
+	resp := struct {
+		Value string
+	}{}
+	if err := r.queryOne(sel, &resp); err != nil {
+		return "", err
+	}
+	return resp.Value, nil
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	userID, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": userID, "key": key})
+}
+
+func (r userPropsRepository) currentUserID() (string, error) {
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return "", model.ErrNotAuthorized
+	}
+	return user.ID, nil
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..5d4178d
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,67 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	var ctx context.Context
+	var repo model.UserPropsRepository
+
+	BeforeEach(func() {
+		o := orm.NewOrm()
+		for _, id := range []string{"user-props-1", "user-props-2"} {
+			_, err := o.Raw(`insert or ignore into user (id, user_name, name, email, password, is_admin, created_at, updated_at)
+values (?, ?, '', ?, '', false, current_timestamp, current_timestamp)`, id, id, id+"@example.com").Exec()
+			Expect(err).ToNot(HaveOccurred())
+		}
+		ctx = request.WithUser(log.NewContext(context.Background()), model.User{ID: "user-props-1"})
+		repo = NewUserPropsRepository(ctx, o)
+	})
+
+	It("creates, reads, updates, and deletes properties for the contextual user", func() {
+		Expect(repo.Put("language", "en")).To(Succeed())
+		value, err := repo.Get("language")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("en"))
+
+		Expect(repo.Put("language", "pt")).To(Succeed())
+		value, err = repo.Get("language")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("pt"))
+
+		Expect(repo.Delete("language")).To(Succeed())
+		_, err = repo.Get("language")
+		Expect(err).To(Equal(model.ErrNotFound))
+	})
+
+	It("isolates properties by contextual user", func() {
+		Expect(repo.Put("language", "en")).To(Succeed())
+
+		otherCtx := request.WithUser(ctx, model.User{ID: "user-props-2"})
+		otherRepo := NewUserPropsRepository(otherCtx, orm.NewOrm())
+		_, err := otherRepo.Get("language")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(otherRepo.Put("language", "es")).To(Succeed())
+		Expect(otherRepo.Delete("language")).To(Succeed())
+
+		value, err := repo.Get("language")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(value).To(Equal("en"))
+	})
+
+	It("requires a user in the context", func() {
+		noUserRepo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(noUserRepo.Put("language", "en")).To(Equal(model.ErrNotAuthorized))
+		_, err := noUserRepo.Get("language")
+		Expect(err).To(Equal(model.ErrNotAuthorized))
+		Expect(noUserRepo.Delete("language")).To(Equal(model.ErrNotAuthorized))
+	})
+})
