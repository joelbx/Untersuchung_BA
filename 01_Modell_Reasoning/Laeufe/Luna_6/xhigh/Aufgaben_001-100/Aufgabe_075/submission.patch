@@ -0,0 +1,47 @@
+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table if not exists user_props
+(
+	user_id varchar(255) not null
+		references user (id) on update cascade on delete cascade,
+	key varchar(255) not null,
+	value text default '' not null,
+	primary key (user_id, key)
+);
+
+insert or replace into user_props (user_id, key, value)
+select substr(property.id, 18), 'LastFMSessionKey', property.value
+from property
+where substr(property.id, 1, 17) = 'LastFMSessionKey_'
+	and exists (select 1 from user where user.id = substr(property.id, 18));
+
+delete from property
+where substr(id, 1, 17) = 'LastFMSessionKey_'
+	and exists (select 1 from user where user.id = substr(property.id, 18));
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+insert or replace into property (id, value)
+select 'LastFMSessionKey_' || user_id, value
+from user_props
+where key = 'LastFMSessionKey';
+
+drop table user_props;
+`)
+	return err
+}
