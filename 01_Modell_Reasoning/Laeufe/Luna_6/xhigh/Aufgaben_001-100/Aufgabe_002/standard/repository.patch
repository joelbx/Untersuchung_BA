+// KubeAddr returns the public address of the Kubernetes proxy using HTTPS and
+// the default Kubernetes proxy port.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("kubernetes proxy is not enabled")
+	}
+
+	publicAddrs := c.Kube.PublicAddrs
+	if len(publicAddrs) == 0 {
+		publicAddrs = c.PublicAddrs
+	}
+	if len(publicAddrs) == 0 {
+		return "", trace.BadParameter("no public address configured for kubernetes proxy")
+	}
+
+	host, err := kubeProxyPublicHost(publicAddrs[0])
+	if err != nil {
+		return "", trace.Wrap(err, "invalid kubernetes proxy public address %q", publicAddrs[0].String())
+	}
+
+	return (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)),
+	}).String(), nil
+}
+
+func kubeProxyPublicHost(publicAddr utils.NetAddr) (string, error) {
+	if publicAddr.AddrNetwork != "" && publicAddr.AddrNetwork != "tcp" && publicAddr.AddrNetwork != "http" && publicAddr.AddrNetwork != "https" {
+		return "", trace.BadParameter("unsupported network %q", publicAddr.AddrNetwork)
+	}
+
+	parsedAddr, err := utils.ParseAddr(publicAddr.String())
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	if parsedAddr.AddrNetwork == "unix" {
+		return "", trace.BadParameter("unix addresses are not valid public proxy addresses")
+	}
+
+	address := parsedAddr.Addr
+	host, port, err := net.SplitHostPort(address)
+	if err == nil {
+		portNum, err := strconv.Atoi(port)
+		if host == "" || err != nil || portNum < 1 || portNum > 65535 {
+			return "", trace.BadParameter("invalid host or port in address %q", address)
+		}
+	} else if ip := net.ParseIP(strings.Trim(address, "[]")); ip != nil {
+		host = ip.String()
+	} else if address != "" && !strings.Contains(address, ":") {
+		host = address
+	} else {
+		return "", trace.Wrap(err)
+	}
+	if host == "" || strings.TrimSpace(host) != host {
+		return "", trace.BadParameter("invalid host in address %q", address)
+	}
+
+	proxyURL := &url.URL{Scheme: "https", Host: net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort))}
+	parsedURL, err := url.Parse(proxyURL.String())
+	if err != nil || parsedURL.Hostname() != host {
+		return "", trace.BadParameter("invalid host in address %q", address)
+	}
+	return host, nil
+}
