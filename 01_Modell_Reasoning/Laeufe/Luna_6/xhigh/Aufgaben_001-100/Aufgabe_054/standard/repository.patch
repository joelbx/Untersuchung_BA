+// GetInstance returns the singleton instance of T, calling constructor once
+// the first time T is requested.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+
+	instanceMu.Lock()
+	e, ok := instancesByType[typeOfT]
+	if !ok {
+		e = &typedEntry{}
+		instancesByType[typeOfT] = e
+	}
+	instanceMu.Unlock()
+
+	e.once.Do(func() {
+		e.value = &instanceBox[T]{value: constructor()}
+	})
+
+	return e.value.(*instanceBox[T]).value
+}
