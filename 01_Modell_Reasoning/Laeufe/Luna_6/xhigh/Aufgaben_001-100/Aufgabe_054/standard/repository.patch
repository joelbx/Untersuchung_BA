index 9014e4e..9c98cf4 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -17,6 +17,14 @@ func TestSingleton(t *testing.T) {
 	RunSpecs(t, "Singleton Suite")
 }
 
+type genericInstance struct {
+	id int32
+}
+
+type concurrentGenericInstance struct {
+	creation int32
+}
+
 var _ = Describe("Get", func() {
 	type T struct{ id string }
 	var numInstances int
@@ -73,3 +81,55 @@ var _ = Describe("Get", func() {
 		Expect(numInstances).To(Equal(1))
 	})
 })
+
+var _ = Describe("GetInstance", func() {
+	It("returns the same value and pointer singleton while keeping their types separate", func() {
+		var valueCreations int32
+		value := singleton.GetInstance(func() genericInstance {
+			return genericInstance{id: atomic.AddInt32(&valueCreations, 1)}
+		})
+		sameValue := singleton.GetInstance(func() genericInstance {
+			return genericInstance{id: atomic.AddInt32(&valueCreations, 1)}
+		})
+
+		var pointerCreations int32
+		pointer := singleton.GetInstance(func() *genericInstance {
+			return &genericInstance{id: atomic.AddInt32(&pointerCreations, 1)}
+		})
+		samePointer := singleton.GetInstance(func() *genericInstance {
+			return &genericInstance{id: atomic.AddInt32(&pointerCreations, 1)}
+		})
+
+		Expect(sameValue).To(Equal(value))
+		Expect(valueCreations).To(Equal(int32(1)))
+		Expect(samePointer).To(BeIdenticalTo(pointer))
+		Expect(pointerCreations).To(Equal(int32(1)))
+	})
+
+	It("constructs only once across 20,000 concurrent calls", func() {
+		const maxCalls = 20_000
+		var creations int32
+		start := make(chan struct{})
+		results := make([]*concurrentGenericInstance, maxCalls)
+		var done sync.WaitGroup
+		done.Add(maxCalls)
+
+		for i := range results {
+			go func(i int) {
+				defer done.Done()
+				<-start
+				results[i] = singleton.GetInstance(func() *concurrentGenericInstance {
+					return &concurrentGenericInstance{creation: atomic.AddInt32(&creations, 1)}
+				})
+			}(i)
+		}
+		close(start)
+		done.Wait()
+
+		Expect(creations).To(Equal(int32(1)))
+		for _, instance := range results {
+			Expect(instance).To(BeIdenticalTo(results[0]))
+			Expect(instance.creation).To(Equal(int32(1)))
+		}
+	})
+})
