diff --git a/openlibrary/catalog/utils/__init__.py b/openlibrary/catalog/utils/__init__.py
index 36b2e9f..070599c 100644
--- a/openlibrary/catalog/utils/__init__.py
+++ b/openlibrary/catalog/utils/__init__.py
@@ -450,15 +450,49 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     Format language data to match Open Library's expected format.
     For an input of ["eng", "fre"], return:
     [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+
+    ISO 639-1 codes and language names are resolved to their MARC language
+    codes. Repeated references to the same language are only returned once.
     """
     if not languages:
         return []
 
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
+        language = language.strip().casefold()
+        language_code = language
+
+        if web.ctx.site.get(f"/languages/{language_code}") is None:
+            # Import lazily to keep the catalog utilities independent of the
+            # upstream plugin unless an alternate language identifier occurs.
+            from openlibrary.plugins.upstream.utils import (
+                LanguageMultipleMatchError,
+                LanguageNoMatchError,
+                convert_iso_to_marc,
+                get_abbrev_from_full_lang_name,
+                get_marc21_language,
+            )
+
+            language_code = get_marc21_language(language)
+            if language_code is None and len(language) == 2:
+                language_code = convert_iso_to_marc(language)
+            if language_code is None:
+                try:
+                    language_code = get_abbrev_from_full_lang_name(language)
+                except (LanguageMultipleMatchError, LanguageNoMatchError):
+                    language_code = None
+
+        if (
+            language_code is None
+            or web.ctx.site.get(f"/languages/{language_code}") is None
+        ):
+            raise InvalidLanguage(language)
+
+        if language_code in seen:
+            continue
+        seen.add(language_code)
 
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        formatted_languages.append({'key': f'/languages/{language_code}'})
 
     return formatted_languages
