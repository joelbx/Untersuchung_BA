+            f'remote_ids.{identifier_type}': identifier,
+        }
+        for key in web.ctx.site.things(query):
+            matches[key] = web.ctx.site.get(key)
+
+    matches = [a for a in matches.values() if a and a.type.key == '/type/author']
+    if not matches:
+        return None
+
+    def match_rank(existing: "Author") -> tuple[int, int, int | str, str]:
+        existing_ids = existing.get('remote_ids', {}) or {}
+        matching_count = sum(
+            1
+            for identifier_type, identifier in remote_ids.items()
+            if identifier and existing_ids.get(identifier_type) == identifier
+        )
+        return (-matching_count, *author_key_sort_key(existing))
+
+    return min(matches, key=match_rank)
 
 
