+def find_author_by_key(author: dict[str, Any]) -> "Author | None":
+    """Resolve an imported Open Library author key, following redirects."""
+    key = author.get('key')
+    if not isinstance(key, str) or not key:
+        return None
+    if not key.startswith('/'):
+        key = f"/authors/{key}"
+
+    existing = web.ctx.site.get(key)
+    seen = set()
+    while existing and existing.type.key == '/type/redirect':
+        if existing.key in seen:
+            return None
+        seen.add(existing.key)
+        location = existing.get('location')
+        if isinstance(location, dict):
+            location = location.get('key')
+        if not location:
+            return None
+        existing = web.ctx.site.get(location)
+
