+    def merge_remote_ids(
+        self, incoming_ids: dict[str, str]
+    ) -> tuple[dict[str, str], int]:
+        """Merge incoming identifiers and count identifiers already in common.
+
+        An identifier type can only have one value for an author. Empty incoming
+        values do not replace an existing value.
+        """
+        existing_ids = self.get("remote_ids", {}) or {}
+        merged_ids = dict(existing_ids)
+        matching_ids = 0
+        conflicts = []
+
+        for identifier_type, incoming_value in incoming_ids.items():
+            existing_value = existing_ids.get(identifier_type)
+            if existing_value and incoming_value and existing_value != incoming_value:
+                conflicts.append(
+                    f"{identifier_type} (existing {existing_value!r}, "
+                    f"incoming {incoming_value!r})"
+                )
+                continue
+
+            if incoming_value and existing_value == incoming_value:
+                matching_ids += 1
+            elif incoming_value or identifier_type not in merged_ids:
+                merged_ids[identifier_type] = incoming_value
+
+        if conflicts:
+            raise AuthorRemoteIdConflictError(
+                f"Conflicting remote IDs for author {self.key}: "
+                + ", ".join(sorted(conflicts))
+            )
+
+        return merged_ids, matching_ids
+
