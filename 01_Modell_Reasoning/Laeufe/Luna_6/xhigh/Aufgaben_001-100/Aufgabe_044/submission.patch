diff --git a/internal/server/authz/authz.go b/internal/server/authz/authz.go
index 54de449..a03c86d 100644
--- a/internal/server/authz/authz.go
+++ b/internal/server/authz/authz.go
@@ -1,8 +1,67 @@
 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey string
+
+// NamespacesKey is the context key used to pass accessible namespaces from
+// authorization middleware to server methods.
+const NamespacesKey contextKey = "accessible_namespaces"
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
+
+// ContextWithNamespaces stores the namespaces accessible to the request.
+func ContextWithNamespaces(ctx context.Context, namespaces []string) context.Context {
+	copy := append([]string{}, namespaces...)
+	return context.WithValue(ctx, NamespacesKey, copy)
+}
+
+// NamespacesFromContext retrieves the accessible namespaces for a request.
+// It returns nil when no namespace authorization result was stored.
+func NamespacesFromContext(ctx context.Context) []string {
+	namespaces, _ := ctx.Value(NamespacesKey).([]string)
+	return namespaces
+}
+
+// FormatNamespaces validates and converts an authorization result to a list of
+// namespace keys. OPA returns JSON arrays as []interface{} values.
+func FormatNamespaces(result any) ([]string, error) {
+	var values []any
+	switch result := result.(type) {
+	case []string:
+		values = make([]any, len(result))
+		for i := range result {
+			values[i] = result[i]
+		}
+	case []any:
+		values = result
+	default:
+		return nil, fmt.Errorf("viewable namespaces decision returned %T, expected a list of strings", result)
+	}
+
+	namespaces := make([]string, 0, len(values))
+	seen := make(map[string]struct{}, len(values))
+	for i, value := range values {
+		namespace, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("viewable namespaces decision item %d returned %T, expected a string", i, value)
+		}
+		if namespace == "" {
+			return nil, fmt.Errorf("viewable namespaces decision item %d is empty", i)
+		}
+		if _, ok := seen[namespace]; ok {
+			continue
+		}
+		seen[namespace] = struct{}{}
+		namespaces = append(namespaces, namespace)
+	}
+
+	return namespaces, nil
+}
