+func (s *ConfigTestSuite) TestKubeListenAddrShorthand(c *check.C) {
+	readConfig := func(value string) (*service.Config, error) {
+		fc, err := ReadConfig(bytes.NewBufferString(value))
+		if err != nil {
+			return nil, err
+		}
+		cfg := service.MakeDefaultConfig()
+		if err := ApplyFileConfig(fc, cfg); err != nil {
+			return nil, err
+		}
+		return cfg, nil
+	}
+
+	cfg, err := readConfig(`proxy_service:
+  kube_listen_addr: "0.0.0.0:8080"
+`)
+	c.Assert(err, check.IsNil)
+	c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true)
+	c.Assert(cfg.Proxy.Kube.ListenAddr.String(), check.Equals, "0.0.0.0:8080")
+
+	cfg, err = readConfig(`proxy_service:
+  kube_listen_addr: "0.0.0.0"
+`)
+	c.Assert(err, check.IsNil)
+	c.Assert(cfg.Proxy.Kube.ListenAddr.Port(defaults.KubeListenPort), check.Equals, defaults.KubeListenPort)
+
+	cfg, err = readConfig(`proxy_service:
+  kubernetes:
+    enabled: "yes"
+    listen_addr: "127.0.0.1:3031"
+`)
+	c.Assert(err, check.IsNil)
+	c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true)
+	c.Assert(cfg.Proxy.Kube.ListenAddr.String(), check.Equals, "127.0.0.1:3031")
+
+	cfg, err = readConfig(`proxy_service:
+  kubernetes:
+    enabled: "no"
+    listen_addr: "127.0.0.1:3030"
+  kube_listen_addr: "0.0.0.0:8080"
+`)
+	c.Assert(err, check.IsNil)
+	c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true)
+	c.Assert(cfg.Proxy.Kube.ListenAddr.String(), check.Equals, "0.0.0.0:8080")
+
+	_, err = ReadConfig(bytes.NewBufferString(`proxy_service:
+  kubernetes:
+    enabled: "yes"
+  kube_listen_addr: "0.0.0.0:8080"
+`))
+	c.Assert(err, check.NotNil)
+	c.Assert(err, check.ErrorMatches, ".*kube_listen_addr.*proxy_service.kubernetes.enabled.*")
+}
