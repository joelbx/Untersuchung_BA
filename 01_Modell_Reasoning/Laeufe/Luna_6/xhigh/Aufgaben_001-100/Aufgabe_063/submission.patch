+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	tests := []struct {
+		name       string
+		listenAddr string
+		publicAddr string
+		webPublic  string
+		webAddr    string
+		want       string
+	}{
+		{
+			name:       "IPv4 wildcard uses advertised web proxy host",
+			listenAddr: "0.0.0.0:3027",
+			webPublic:  "web.public.example:443",
+			webAddr:    "web.internal.example:3080",
+			want:       "web.public.example:3027",
+		},
+		{
+			name:       "IPv6 wildcard uses configured web proxy host and default port",
+			listenAddr: "[::]",
+			webAddr:    "web.internal.example:3080",
+			want:       "web.internal.example:" + strconv.Itoa(defaults.KubeListenPort),
+		},
+		{
+			name:       "public Kubernetes address takes precedence",
+			listenAddr: "0.0.0.0:3027",
+			publicAddr: "kube.public.example:8443",
+			webAddr:    "web.internal.example:3080",
+			want:       "kube.public.example:8443",
+		},
+	}
+
+	for _, tt := range tests {
+		c.Log(tt.name)
+		tc := TeleportClient{Config: Config{WebProxyAddr: tt.webAddr}}
+		settings := ProxySettings{Kube: KubeProxySettings{
+			Enabled:    true,
+			ListenAddr: tt.listenAddr,
+			PublicAddr: tt.publicAddr,
+		}, SSH: SSHProxySettings{PublicAddr: tt.webPublic}}
+		c.Assert(tc.applyProxySettings(settings), check.IsNil)
+		c.Assert(tc.KubeProxyAddr, check.Equals, tt.want)
+	}
+}
