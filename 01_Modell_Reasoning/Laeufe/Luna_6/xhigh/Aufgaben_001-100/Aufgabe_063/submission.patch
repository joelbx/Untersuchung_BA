+func (s *ConfigTestSuite) TestKubeServiceListenAddressWarning(c *check.C) {
+	previousOutput := log.StandardLogger().Out
+	previousLevel := log.GetLevel()
+	var output bytes.Buffer
+	log.SetOutput(&output)
+	log.SetLevel(log.WarnLevel)
+	defer func() {
+		log.SetOutput(previousOutput)
+		log.SetLevel(previousLevel)
+	}()
+
+	fc, err := ReadConfig(bytes.NewBufferString(`proxy_service:
+  enabled: "yes"
+kubernetes_service:
+  enabled: "yes"
+`))
+	c.Assert(err, check.IsNil)
+	err = ApplyFileConfig(fc, service.MakeDefaultConfig())
+	c.Assert(err, check.IsNil)
+	c.Assert(strings.Contains(output.String(), "proxy_service does not specify a Kubernetes listen address"), check.Equals, true)
+}
