+/**
+ * Removes technical fields from a new entity and its nested objects.
+ * This mutates the entity, which makes it unsuitable for update operations.
+ */
+export function removeTechnicalFields<E extends SomeEntity>(entity: E): void {
+	const technicalFieldPrefixes = ["_finalEncrypted", "_defaultEncrypted", "_errors"]
+	const visited = new WeakSet<object>()
+
+	const removeFromObject = (value: unknown): void => {
+		if (value === null || typeof value !== "object" || visited.has(value)) {
+			return
+		}
+
+		visited.add(value)
+		const object = value as Record<string, unknown>
+
+		for (const key of Object.keys(object)) {
+			if (technicalFieldPrefixes.some((prefix) => key.startsWith(prefix))) {
+				delete object[key]
+			} else {
+				removeFromObject(object[key])
+			}
+		}
+	}
+
+	removeFromObject(entity)
+}
+
 export function containsId(ids: ReadonlyArray<Id | IdTuple>, id: Id | IdTuple): boolean {
 	return ids.find((idInArray) => isSameId(idInArray, id)) != null
 }
