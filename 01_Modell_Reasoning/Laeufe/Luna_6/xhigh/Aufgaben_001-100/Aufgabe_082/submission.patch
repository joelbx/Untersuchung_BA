+// NewWriterEmitter returns an emitter that writes audit events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		WriterLog: *NewWriterLog(writerEmitterLogWriter{Writer: w}),
+		writer:    w,
+	}
+}
+
+// WriterEmitter writes audit events as newline-delimited JSON to an io.WriteCloser.
+// It embeds WriterLog to provide the legacy IAuditLog methods.
+type WriterEmitter struct {
+	WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes event as a newline-delimited JSON record.
+func (w *WriterEmitter) EmitAuditEvent(_ context.Context, event AuditEvent) error {
+	data, err := json.Marshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	data = append(data, '\n')
+	n, err := w.writer.Write(data)
+	if err != nil {
+		return trace.ConvertSystemError(err)
+	}
+	if n != len(data) {
+		return trace.ConvertSystemError(io.ErrShortWrite)
+	}
+	return nil
+}
+
+// Close closes the writer and the embedded WriterLog, and returns any errors.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(w.writer.Close(), w.WriterLog.Close())
+}
+
+// writerEmitterLogWriter lets WriterLog write through the emitter's writer
+// without taking ownership of closing it a second time.
+type writerEmitterLogWriter struct {
+	io.Writer
+}
+
+func (writerEmitterLogWriter) Close() error { return nil }
+
