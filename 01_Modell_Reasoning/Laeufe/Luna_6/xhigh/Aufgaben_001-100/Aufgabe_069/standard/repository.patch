+// Matcher tests whether a string satisfies a matcher expression.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct {
+	re *regexp.Regexp
+}
+
+func (m regexpMatcher) Match(in string) bool {
+	return m.re.MatchString(in)
+}
+
+type prefixSuffixMatcher struct {
+	prefix  string
+	suffix  string
+	matcher Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if len(in) < len(m.prefix)+len(m.suffix) || !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) {
+		return false
+	}
+	end := len(in) - len(m.suffix)
+	return m.matcher.Match(in[len(m.prefix):end])
+}
+
+type notMatcher struct {
+	matcher Matcher
+}
+
+func (m notMatcher) Match(in string) bool {
+	return !m.matcher.Match(in)
+}
+
+// Match parses a string matcher expression. Plain values use literal and glob
+// matching; a fully anchored value is treated as a regular expression. A
+// template can contain regexp.match, regexp.not_match, or email.local calls.
+func Match(value string) (Matcher, error) {
+	match := reVariable.FindStringSubmatch(value)
+	if len(match) == 0 {
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			if strings.Count(value, "{{") > 1 || strings.Count(value, "}}") > 1 || strings.Count(value, "{") > 2 || strings.Count(value, "}") > 2 {
+				return nil, invalidMatcherExpression(value)
+			}
+			return nil, trace.BadParameter(
+				"%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}",
+				value)
+		}
+		return compilePattern(value)
+	}
+
+	prefix, expression, suffix := match[1], match[2], match[3]
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing matcher expression %q: %v", expression, err)
+	}
+
+	inner, err := matcherFromExpr(expr, value)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if prefix == "" && suffix == "" {
+		return inner, nil
+	}
+	return prefixSuffixMatcher{
+		prefix:  prefix,
+		suffix:  suffix,
+		matcher: inner,
+	}, nil
+}
+
+func matcherFromExpr(expr ast.Expr, value string) (Matcher, error) {
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return nil, invalidMatcherExpression(value)
+	}
+
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, invalidMatcherExpression(value)
+	}
+	namespace, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return nil, invalidMatcherExpression(value)
+	}
+	if namespace.Name != EmailNamespace && namespace.Name != "regexp" {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+
+	function := namespace.Name + "." + selector.Sel.Name
+	switch function {
+	case "regexp.match", "regexp.not_match", "email.local":
+	default:
+		if namespace.Name == "regexp" {
+			return nil, trace.BadParameter("unsupported function %s, supported functions are: regexp.match, regexp.not_match", function)
+		}
+		return nil, trace.BadParameter("unsupported function %s, supported functions are: email.local", function)
+	}
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("expected 1 argument for %s got %v", function, len(call.Args))
+	}
+	arg, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || arg.Kind != token.STRING {
+		return nil, invalidMatcherExpression(value)
+	}
+	pattern, err := strconv.Unquote(arg.Value)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing string literal for %s: %v", function, err)
+	}
+
+	var matcher Matcher
+	if function == "regexp.match" || function == "regexp.not_match" {
+		matcher, err = compileRegexp(pattern)
+	} else {
+		matcher, err = compilePattern(pattern)
+		if err == nil {
+			matcher = emailLocalMatcher{matcher: matcher}
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	if function == "regexp.not_match" {
+		matcher = notMatcher{matcher: matcher}
+	}
+	return matcher, nil
+}
+
+type emailLocalMatcher struct {
+	matcher Matcher
+}
+
+func (m emailLocalMatcher) Match(in string) bool {
+	local, err := (emailLocalTransformer{}).transform(in)
+	return err == nil && m.matcher.Match(local)
+}
+
+func compilePattern(pattern string) (Matcher, error) {
+	if strings.HasPrefix(pattern, "^") && strings.HasSuffix(pattern, "$") {
+		return compileRegexp(pattern)
+	}
+	return compileRegexp("^" + utils.GlobToRegexp(pattern) + "$")
+}
+
+func compileRegexp(pattern string) (Matcher, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return regexpMatcher{re: re}, nil
+}
+
+func invalidMatcherExpression(value string) error {
+	return trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+}
+
+func containsMatcherFunction(node ast.Node) bool {
+	found := false
+	ast.Inspect(node, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		namespace, ok := selector.X.(*ast.Ident)
+		if ok && namespace.Name == "regexp" {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
+
