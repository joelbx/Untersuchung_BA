+    @pytest.mark.parametrize('use_pexpect', [False, True])
+    def test_kinit_uses_unique_ccache_per_attempt(self, monkeypatch, use_pexpect):
+        if use_pexpect:
+            pytest.importorskip("pexpect")
+            mock_pexpect = MagicMock()
+            mock_pexpect.return_value.exitstatus = 0
+            monkeypatch.setattr("pexpect.spawn", mock_pexpect)
+        else:
+            mock_popen = MagicMock()
+            mock_popen.return_value.communicate.return_value = (b"", b"")
+            mock_popen.return_value.returncode = 0
+            monkeypatch.setattr("subprocess.Popen", mock_popen)
+
+        monkeypatch.setattr(winrm, "HAS_PEXPECT", use_pexpect)
+        pc = PlayContext()
+        conn = connection_loader.get('winrm', pc, StringIO())
+        conn.set_options(var_options={"_extras": {}})
+        conn._build_winrm_kwargs()
+
+        conn._kerb_auth("user@domain", "pass")
+        conn._kerb_auth("user@domain", "pass")
+
+        if use_pexpect:
+            assert mock_pexpect.call_count == 2
+            envs = [call[1]['env'] for call in mock_pexpect.call_args_list]
+        else:
+            assert mock_popen.call_count == 2
+            envs = [call[1]['env'] for call in mock_popen.call_args_list]
+
+        caches = [env['KRB5CCNAME'] for env in envs]
+        assert caches[0].startswith("FILE:/")
+        assert caches[0] != caches[1]
+
