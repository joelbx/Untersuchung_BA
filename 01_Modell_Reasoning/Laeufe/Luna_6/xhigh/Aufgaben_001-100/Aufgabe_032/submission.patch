+        'msg': msg,
+        'ansible_job_id': jid,
+        'started': 1,
+        'finished': 1,
+    }
+    result.update(kwargs)
+    return result
+
+
+def _with_cleanup_policy(result, preserve_tmp):
+    result['_ansible_suppress_tmpdir_delete'] = not preserve_tmp
+    return result
+
+
+def _cleanup_tmpdir(wrapped_module, preserve_tmp):
+    if not preserve_tmp:
+        shutil.rmtree(os.path.dirname(wrapped_module), True)
