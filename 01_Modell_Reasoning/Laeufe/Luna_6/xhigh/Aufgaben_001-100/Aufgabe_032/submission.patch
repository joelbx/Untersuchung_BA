+def jwrite(info):
+    """Atomically replace the current async job file with ``info``."""
+    tmp_job_path = job_path + '.tmp'
+    try:
+        info = dict(info)
+        if job_id is not None:
+            info['ansible_job_id'] = job_id
+        data = json.dumps(info)
+        with open(tmp_job_path, 'w') as jobfile:
+            jobfile.write(data)
+        os.rename(tmp_job_path, job_path)
+    except (IOError, OSError) as e:
+        notice("failed to write async job file %s: %s" % (job_path, to_text(e)))
+        raise
+
