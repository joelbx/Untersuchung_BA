@@ -255,6 +255,55 @@ class TestIptables(ModuleTestCase):
             'ACCEPT'
         ])
 
+    def test_destination_ports(self):
+        """Test matching multiple destination ports with the multiport extension"""
+        protocols = ['tcp', 'udp', 'udplite', 'dccp', 'sctp']
+        expected_command = [
+            '/sbin/iptables',
+            '-t', 'filter',
+            '-C', 'INPUT',
+        ]
+
+        for protocol in protocols:
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['80', '443', '8081:8083'],
+                'jump': 'ACCEPT',
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_args[0][0], expected_command + [
+                '-p', protocol,
+                '-j', 'ACCEPT',
+                '-m', 'multiport',
+                '--dports', '80,443,8081:8083',
+            ])
+
+    def test_destination_ports_require_supported_protocol(self):
+        """Destination ports require a protocol supported by multiport"""
+        for protocol in (None, 'icmp'):
+            args = {
+                'chain': 'INPUT',
+                'destination_ports': ['80', '443'],
+                'jump': 'ACCEPT',
+            }
+            if protocol is not None:
+                args['protocol'] = protocol
+            set_module_args(args)
+
+            with self.assertRaises(AnsibleFailJson) as result:
+                iptables.main()
+
+            self.assertEqual(
+                result.exception.args[0]['msg'],
+                'destination_ports is only valid with protocol tcp, udp, udplite, dccp or sctp.'
+            )
+
