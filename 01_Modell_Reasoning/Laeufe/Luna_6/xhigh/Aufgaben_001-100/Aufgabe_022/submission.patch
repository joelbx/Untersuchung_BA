+func (o *redhatBase) parseSourcePackage(filename, epoch, binaryName string) *models.SrcPackage {
+	if filename == "(none)" {
+		return nil
+	}
+
+	name, version, release, err := splitFileName(filename)
+	if err != nil {
+		o.warns = append(o.warns, xerrors.Errorf("Failed to parse source rpm file %q: %w", filename, err))
+		return nil
+	}
+	if epoch != "0" && epoch != "(none)" && !strings.Contains(version, ":") {
+		version = fmt.Sprintf("%s:%s", epoch, version)
+	}
+
+	return &models.SrcPackage{
+		Name:        name,
+		Version:     fmt.Sprintf("%s-%s", version, release),
+		Arch:        "src",
+		BinaryNames: []string{binaryName},
+	}
+}
+
