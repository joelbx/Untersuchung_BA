diff --git a/internal/ext/common.go b/internal/ext/common.go
new file mode 100644
index 0000000..37bbbf9
--- /dev/null
+++ b/internal/ext/common.go
@@ -0,0 +1,94 @@
+package ext
+
+// Document is the YAML representation of an exported Flipt configuration.
+type Document struct {
+	Flags    []*Flag    `yaml:"flags,omitempty"`
+	Segments []*Segment `yaml:"segments,omitempty"`
+}
+
+// Flag represents a feature flag and its variants and targeting rules.
+type Flag struct {
+	Key         string     `yaml:"key,omitempty"`
+	Name        string     `yaml:"name,omitempty"`
+	Description string     `yaml:"description,omitempty"`
+	Enabled     bool       `yaml:"enabled"`
+	Variants    []*Variant `yaml:"variants,omitempty"`
+	Rules       []*Rule    `yaml:"rules,omitempty"`
+}
+
+// Variant represents a flag variant. Attachment may contain any YAML value.
+type Variant struct {
+	Key         string      `yaml:"key,omitempty"`
+	Name        string      `yaml:"name,omitempty"`
+	Description string      `yaml:"description,omitempty"`
+	Attachment  interface{} `yaml:"attachment,omitempty"`
+
+	attachmentPresent bool
+}
+
+// MarshalYAML preserves an explicitly supplied null attachment while omitting
+// attachments which were not defined.
+func (v Variant) MarshalYAML() (interface{}, error) {
+	type variantYAML struct {
+		Key         string       `yaml:"key,omitempty"`
+		Name        string       `yaml:"name,omitempty"`
+		Description string       `yaml:"description,omitempty"`
+		Attachment  *interface{} `yaml:"attachment,omitempty"`
+	}
+
+	result := variantYAML{
+		Key:         v.Key,
+		Name:        v.Name,
+		Description: v.Description,
+	}
+	if v.Attachment != nil || v.attachmentPresent {
+		attachment := v.Attachment
+		result.Attachment = &attachment
+	}
+	return result, nil
+}
+
+// UnmarshalYAML records whether attachment was present, including an explicit
+// YAML null, so the importer can preserve it as the JSON value null.
+func (v *Variant) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	type variantYAML Variant
+
+	var fields map[interface{}]interface{}
+	if err := unmarshal(&fields); err != nil {
+		return err
+	}
+	_, v.attachmentPresent = fields["attachment"]
+	if err := unmarshal((*variantYAML)(v)); err != nil {
+		return err
+	}
+	return nil
+}
+
+// Rule represents a targeting rule and its variant distributions.
+type Rule struct {
+	SegmentKey    string          `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// Distribution represents the rollout for a variant within a rule.
+type Distribution struct {
+	VariantKey string  `yaml:"variant,omitempty"`
+	Rollout    float32 `yaml:"rollout,omitempty"`
+}
+
+// Segment represents a user segment and its constraints.
+type Segment struct {
+	Key         string        `yaml:"key,omitempty"`
+	Name        string        `yaml:"name,omitempty"`
+	Description string        `yaml:"description,omitempty"`
+	Constraints []*Constraint `yaml:"constraints,omitempty"`
+}
+
+// Constraint represents one condition in a segment.
+type Constraint struct {
+	Type     string `yaml:"type,omitempty"`
+	Property string `yaml:"property,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+	Value    string `yaml:"value,omitempty"`
+}
diff --git a/internal/ext/exporter.go b/internal/ext/exporter.go
new file mode 100644
index 0000000..251f975
--- /dev/null
+++ b/internal/ext/exporter.go
@@ -0,0 +1,130 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type lister interface {
+	ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error)
+	ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error)
+	ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error)
+}
+
+// Exporter writes a YAML document containing the flags and segments in a store.
+type Exporter struct {
+	store     lister
+	batchSize uint64
+}
+
+const defaultBatchSize uint64 = 25
+
+// NewExporter constructs an exporter for store.
+func NewExporter(store lister) *Exporter {
+	return &Exporter{store: store, batchSize: defaultBatchSize}
+}
+
+// Export writes all flags, variants, rules, distributions, segments, and
+// constraints from the store as a YAML document.
+func (e *Exporter) Export(ctx context.Context, w io.Writer) error {
+	doc := &Document{}
+	batchSize := e.batchSize
+	if batchSize == 0 {
+		batchSize = defaultBatchSize
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		flags, err := e.store.ListFlags(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting flags: %w", err)
+		}
+
+		for _, storedFlag := range flags {
+			flag := &Flag{
+				Key:         storedFlag.Key,
+				Name:        storedFlag.Name,
+				Description: storedFlag.Description,
+				Enabled:     storedFlag.Enabled,
+			}
+
+			variantKeys := make(map[string]string, len(storedFlag.Variants))
+			for _, storedVariant := range storedFlag.Variants {
+				variant := &Variant{
+					Key:         storedVariant.Key,
+					Name:        storedVariant.Name,
+					Description: storedVariant.Description,
+				}
+				if storedVariant.Attachment != "" {
+					if err := json.Unmarshal([]byte(storedVariant.Attachment), &variant.Attachment); err != nil {
+						return fmt.Errorf("decoding attachment for variant %q on flag %q: %w", storedVariant.Key, storedFlag.Key, err)
+					}
+					variant.attachmentPresent = true
+				}
+				flag.Variants = append(flag.Variants, variant)
+				variantKeys[storedVariant.Id] = storedVariant.Key
+			}
+
+			rules, err := e.store.ListRules(ctx, storedFlag.Key)
+			if err != nil {
+				return fmt.Errorf("getting rules for flag %q: %w", storedFlag.Key, err)
+			}
+			for _, storedRule := range rules {
+				rule := &Rule{SegmentKey: storedRule.SegmentKey, Rank: uint(storedRule.Rank)}
+				for _, storedDistribution := range storedRule.Distributions {
+					rule.Distributions = append(rule.Distributions, &Distribution{
+						VariantKey: variantKeys[storedDistribution.VariantId],
+						Rollout:    storedDistribution.Rollout,
+					})
+				}
+				flag.Rules = append(flag.Rules, rule)
+			}
+
+			doc.Flags = append(doc.Flags, flag)
+		}
+		if uint64(len(flags)) < batchSize {
+			break
+		}
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		segments, err := e.store.ListSegments(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting segments: %w", err)
+		}
+
+		for _, storedSegment := range segments {
+			segment := &Segment{
+				Key:         storedSegment.Key,
+				Name:        storedSegment.Name,
+				Description: storedSegment.Description,
+			}
+			for _, storedConstraint := range storedSegment.Constraints {
+				segment.Constraints = append(segment.Constraints, &Constraint{
+					Type:     storedConstraint.Type.String(),
+					Property: storedConstraint.Property,
+					Operator: storedConstraint.Operator,
+					Value:    storedConstraint.Value,
+				})
+			}
+			doc.Segments = append(doc.Segments, segment)
+		}
+		if uint64(len(segments)) < batchSize {
+			break
+		}
+	}
+
+	encoder := yaml.NewEncoder(w)
+	if err := encoder.Encode(doc); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	if err := encoder.Close(); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	return nil
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..c442082
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,182 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"reflect"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+// Importer creates entities in a store from a YAML configuration document.
+type Importer struct {
+	store creator
+}
+
+// NewImporter constructs an importer for store.
+func NewImporter(store creator) *Importer {
+	return &Importer{store: store}
+}
+
+// Import decodes a YAML document and creates all of its entities in the store.
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	doc := new(Document)
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+
+	createdVariants := make(map[string]*flipt.Variant)
+	for _, f := range doc.Flags {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		_, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{
+			Key:         f.Key,
+			Name:        f.Name,
+			Description: f.Description,
+			Enabled:     f.Enabled,
+		})
+		if err != nil {
+			return fmt.Errorf("importing flag: %w", err)
+		}
+
+		for _, v := range f.Variants {
+			attachment := ""
+			if v.Attachment != nil || v.attachmentPresent {
+				value := convert(v.Attachment)
+				// Earlier exports encoded attachments as JSON strings in YAML. Decode
+				// those strings as JSON to keep existing configuration files usable.
+				if raw, ok := value.(string); ok {
+					var decoded interface{}
+					if json.Unmarshal([]byte(raw), &decoded) == nil {
+						value = decoded
+					}
+				}
+				encoded, err := json.Marshal(value)
+				if err != nil {
+					return fmt.Errorf("encoding attachment for variant %q on flag %q: %w", v.Key, f.Key, err)
+				}
+				attachment = string(encoded)
+			}
+
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{
+				FlagKey:     f.Key,
+				Key:         v.Key,
+				Name:        v.Name,
+				Description: v.Description,
+				Attachment:  attachment,
+			})
+			if err != nil {
+				return fmt.Errorf("importing variant: %w", err)
+			}
+			createdVariants[f.Key+":"+v.Key] = variant
+		}
+	}
+
+	for _, s := range doc.Segments {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		_, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{
+			Key:         s.Key,
+			Name:        s.Name,
+			Description: s.Description,
+		})
+		if err != nil {
+			return fmt.Errorf("importing segment: %w", err)
+		}
+		for _, c := range s.Constraints {
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{
+				SegmentKey: s.Key,
+				Type:       flipt.ComparisonType(flipt.ComparisonType_value[c.Type]),
+				Property:   c.Property,
+				Operator:   c.Operator,
+				Value:      c.Value,
+			}); err != nil {
+				return fmt.Errorf("importing constraint: %w", err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{
+				FlagKey:    f.Key,
+				SegmentKey: r.SegmentKey,
+				Rank:       int32(r.Rank),
+			})
+			if err != nil {
+				return fmt.Errorf("importing rule: %w", err)
+			}
+			for _, d := range r.Distributions {
+				variant, ok := createdVariants[f.Key+":"+d.VariantKey]
+				if !ok {
+					return fmt.Errorf("finding variant %q for flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{
+					FlagKey:   f.Key,
+					RuleId:    rule.Id,
+					VariantId: variant.Id,
+					Rollout:   d.Rollout,
+				}); err != nil {
+					return fmt.Errorf("importing distribution: %w", err)
+				}
+			}
+		}
+	}
+
+	return nil
+}
+
+// convert recursively changes YAML's interface-keyed maps into JSON-compatible
+// string-keyed maps while retaining sequence and scalar values.
+func convert(value interface{}) interface{} {
+	if value == nil {
+		return nil
+	}
+
+	rv := reflect.ValueOf(value)
+	switch rv.Kind() {
+	case reflect.Interface, reflect.Ptr:
+		if rv.IsNil() {
+			return nil
+		}
+		return convert(rv.Elem().Interface())
+	case reflect.Map:
+		if rv.IsNil() {
+			return nil
+		}
+		result := make(map[string]interface{}, rv.Len())
+		iter := rv.MapRange()
+		for iter.Next() {
+			result[fmt.Sprint(iter.Key().Interface())] = convert(iter.Value().Interface())
+		}
+		return result
+	case reflect.Slice, reflect.Array:
+		if rv.Kind() == reflect.Slice && rv.IsNil() {
+			return nil
+		}
+		result := make([]interface{}, rv.Len())
+		for index := 0; index < rv.Len(); index++ {
+			result[index] = convert(rv.Index(index).Interface())
+		}
+		return result
+	default:
+		return value
+	}
+}
