diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..bd9963e 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,6 +1,48 @@
 from openlibrary.plugins.openlibrary import lists
 
 
+def test_list_record_from_input_uses_post_body(monkeypatch):
+    monkeypatch.setattr(
+        lists.web,
+        'data',
+        lambda: (
+            b'key=%2Fpeople%2Fbody&name=Body+name&name=Ignored'
+            b'&description=Body+description&seeds--0--key=%2Fworks%2FOL1W'
+            b'&seeds--1--key=&seeds--2--invalid=value'
+        ),
+    )
+    monkeypatch.setattr(
+        lists.web,
+        'input',
+        lambda **defaults: (_ for _ in ()).throw(
+            AssertionError('query parameters must not be read when a body is present')
+        ),
+    )
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key == '/people/body'
+    assert record.name == 'Body name'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/works/OL1W'}]
+
+
+def test_list_record_from_input_uses_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(lists.web, 'data', lambda: b'')
+    monkeypatch.setattr(
+        lists.web,
+        'input',
+        lambda **defaults: {**defaults, 'name': 'Query name'},
+    )
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'Query name'
+    assert record.description == ''
+    assert record.seeds == []
+
+
 def test_process_seeds():
     process_seeds = lists.lists_json().process_seeds
 
