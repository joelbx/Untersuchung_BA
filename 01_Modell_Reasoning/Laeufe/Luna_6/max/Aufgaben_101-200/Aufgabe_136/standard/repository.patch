+class UndeferrableError(NotImplementedError):
+
+    """Raised when a certificate error cannot be deferred."""
+
+
 class AbstractCertificateErrorWrapper:
 
     """A wrapper over an SSL/certificate error."""
 
+    def __init__(self) -> None:
+        self._certificate_accepted = False
+
+    def accept_certificate(self) -> None:
+        """Mark the certificate as accepted."""
+        self._certificate_accepted = True
+
+    def reject_certificate(self) -> None:
+        """Mark the certificate as rejected."""
+        self._certificate_accepted = False
+
+    def defer(self) -> None:
+        """Defer the certificate decision if the backend supports it."""
+        raise UndeferrableError("Certificate decisions cannot be deferred")
+
+    def certificate_was_accepted(self) -> bool:
+        """Return whether the certificate was accepted."""
+        return getattr(self, '_certificate_accepted', False)
+
+    @property
+    def ignore(self) -> bool:
+        """Compatibility alias for the certificate acceptance decision."""
+        return self.certificate_was_accepted()
+
+    @ignore.setter
+    def ignore(self, accepted: bool) -> None:
+        self._certificate_accepted = accepted
+
     def __str__(self) -> str:
         raise NotImplementedError
 
