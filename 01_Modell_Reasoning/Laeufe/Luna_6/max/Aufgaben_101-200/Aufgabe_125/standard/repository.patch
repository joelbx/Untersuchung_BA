+
+		const currentSet = new Set(validReferencedTids);
+		const removedTids = existingTids.filter(referencedTid => !currentSet.has(String(referencedTid)));
+		const addedTids = validReferencedTids.filter(referencedTid => !existingSet.has(referencedTid));
