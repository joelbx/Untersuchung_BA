const getUniqueVolumeIds = (shares: (Share | ShareWithKey)[]) => Array.from(new Set(shares.map(({ volumeId }) => volumeId)));

const isPhotoLink = (link: DecryptedLink) =>
    link.isFile && (link.mimeType.startsWith('image/') || link.mimeType.startsWith('video/'));

const countCachedRecoveryLinks = (
    abortSignal: AbortSignal,
    shares: (Share | ShareWithKey)[],
    {
        getCachedChildren,
        getCachedTrashed,
    }: {
        getCachedChildren: ReturnType<typeof useLinksListing>['getCachedChildren'];
        getCachedTrashed: ReturnType<typeof useLinksListing>['getCachedTrashed'];
    }
) => {
    let count = 0;
    for (const share of shares) {
        try {
            count += getCachedChildren(abortSignal, share.shareId, share.rootLinkId)?.links.length || 0;
        } catch {
            // Preserve counts from any source that was available when another source failed.
        }
    }
    for (const volumeId of getUniqueVolumeIds(shares)) {
        try {
            count += getCachedTrashed(abortSignal, volumeId)?.links.filter(isPhotoLink).length || 0;
        } catch {
            // Preserve counts from any source that was available when another source failed.
        }
    }
    return count;
};
