+func populateAlbumDirs(ctx context.Context, ds model.DataStore, albums model.Albums) error {
+	ids := make([]string, 0, len(albums))
+	needed := make(map[string]struct{}, len(albums))
+	for _, album := range albums {
+		if len(album.Dirs) == 0 {
+			ids = append(ids, album.ID)
+			needed[album.ID] = struct{}{}
+		}
+	}
+	if len(ids) == 0 {
+		return nil
+	}
+
+	mediaFiles, err := ds.MediaFile(ctx).GetAll(model.QueryOptions{Filters: squirrel.Eq{"album_id": ids}})
+	if err != nil {
+		return err
+	}
+	byAlbum := make(map[string]model.MediaFiles, len(ids))
+	for _, mediaFile := range mediaFiles {
+		if _, ok := needed[mediaFile.AlbumID]; ok {
+			byAlbum[mediaFile.AlbumID] = append(byAlbum[mediaFile.AlbumID], mediaFile)
+		}
+	}
+	for i := range albums {
+		if _, ok := needed[albums[i].ID]; ok {
+			albums[i].Dirs = byAlbum[albums[i].ID].Dirs()
+		}
+	}
+	return nil
+}
+
+func artistDirectory(albums model.Albums) string {
+	var albumParents []string
+	for _, album := range albums {
+		albumDir := commonDirectory(album.Dirs)
+		if albumDir == "" {
+			continue
+		}
+		parent := filepath.Dir(albumDir)
+		if parent != albumDir {
+			albumParents = append(albumParents, parent)
+		}
+	}
+	return commonDirectory(albumParents)
+}
+
+func commonDirectory(dirs []string) string {
+	var common string
+	for _, dir := range dirs {
+		if dir == "" {
+			continue
+		}
+		dir = filepath.Clean(dir)
+		if common == "" {
+			common = dir
+			continue
+		}
+		for !isWithinDirectory(common, dir) {
+			parent := filepath.Dir(common)
+			if parent == common {
+				return common
+			}
+			common = parent
+		}
+	}
+	return common
+}
+
+func isWithinDirectory(base, dir string) bool {
+	relative, err := filepath.Rel(base, dir)
+	return err == nil && relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator))
+}
+
+func artistDirectoryCacheInfo(ctx context.Context, dir string) (string, time.Time, []string) {
+	start := time.Now()
+	var fingerprint strings.Builder
+	fingerprint.WriteString(dir)
+	var updatedAt time.Time
+
+	dirInfo, statErr := os.Stat(dir)
+	if statErr != nil {
+		fmt.Fprintf(&fingerprint, "|stat-error:%s", statErr)
+	} else {
+		updatedAt = dirInfo.ModTime()
+		fmt.Fprintf(&fingerprint, "|%d", dirInfo.ModTime().UnixNano())
+	}
+
+	entries, readErr := os.ReadDir(dir)
+	var files []string
+	if readErr == nil {
+		for _, entry := range entries {
+			if entry.IsDir() || !isArtistImageFile(entry.Name()) {
+				continue
+			}
+			path := filepath.Join(dir, entry.Name())
+			info, err := entry.Info()
+			if err != nil {
+				fmt.Fprintf(&fingerprint, "|info-error:%s:%s", path, err)
+				continue
+			}
+			files = append(files, path)
+			fmt.Fprintf(&fingerprint, "|%s:%d", path, info.ModTime().UnixNano())
+			if info.ModTime().After(updatedAt) {
+				updatedAt = info.ModTime()
+			}
+		}
+	} else {
+		fmt.Fprintf(&fingerprint, "|read-error:%s", readErr)
+	}
+	log.Trace(ctx, "Checked local artist image directory", "folder", dir, "files", files,
+		"elapsed", time.Since(start), readErr)
+	return fingerprint.String(), updatedAt, files
+}
