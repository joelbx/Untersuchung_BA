+func fromArtistFiles(ctx context.Context, dir string, files []string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		for _, path := range files {
+			file, err := os.Open(path)
+			if err != nil {
+				log.Warn(ctx, "Could not open artist image file", "file", path, err)
+				continue
+			}
+			return file, path, nil
+		}
+		return nil, "", fmt.Errorf("pattern 'artist.*' not matched by files in %s", dir)
+	}
+}
+
+func isArtistImageFile(name string) bool {
+	if !model.IsImageFile(strings.ToLower(name)) {
+		return false
+	}
+	match, err := filepath.Match("artist.*", strings.ToLower(name))
+	return err == nil && match
+}
