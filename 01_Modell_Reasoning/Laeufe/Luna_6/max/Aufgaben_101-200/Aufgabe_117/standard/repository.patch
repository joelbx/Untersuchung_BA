+qt.workarounds.locale:
+  type: Bool
+  default: false
+  backend: QtWebEngine
+  restart: true
+  desc: >-
+    Work around missing locale files with QtWebEngine 5.15.3 on Linux.
+
+    When enabled, qutebrowser selects an available Chromium locale when the locale
+    configured by the system does not have a matching QtWebEngine resource file.
+
