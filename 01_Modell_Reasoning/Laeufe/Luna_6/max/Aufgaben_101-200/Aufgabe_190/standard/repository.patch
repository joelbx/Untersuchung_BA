+def _resolve_author_redirect(author: "Author") -> "Author":
+    seen = set()
+    while author.type.key == '/type/redirect':
+        if author['key'] in seen or author['location'] in seen:
+            break
+        seen.add(author['key'])
+        author = web.ctx.site.get(author['location'])
+    return author
+
+
+def _author_records_for_query(query: dict[str, Any]) -> list["Author"]:
+    keys = list(web.ctx.site.things(query))
+    records = web.ctx.site.get_many(keys) if keys else []
+    authors = []
+    seen = set()
+    for author in records:
+        author = _resolve_author_redirect(author)
+        if author and author['key'] not in seen:
+            seen.add(author['key'])
+            authors.append(author)
+    return authors
