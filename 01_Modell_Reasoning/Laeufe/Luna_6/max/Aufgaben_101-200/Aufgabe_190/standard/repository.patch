+def check_cover_url_host(
+    cover_url: str | None, allowed_cover_hosts: Iterable[str]
+) -> bool:
+    """Return whether a cover URL's hostname is in the allowed host list."""
+    if not cover_url:
+        return False
+    try:
+        parsed_url = urlparse(cover_url)
+        hostname = parsed_url.hostname
+        _ = parsed_url.port  # Accessing port validates any explicit port value.
+    except (TypeError, ValueError):
+        return False
+    if not hostname:
+        return False
+    hostname = hostname.casefold().rstrip('.')
+    return hostname in {host.casefold().rstrip('.') for host in allowed_cover_hosts}
+
