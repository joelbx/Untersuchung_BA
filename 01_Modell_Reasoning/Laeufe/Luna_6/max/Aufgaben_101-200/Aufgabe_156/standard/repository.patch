+class TestSanitizeKeys(unittest.TestCase):
+    OMIT = 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+
+    def test_nested_keys_and_ignore_list(self):
+        from collections import OrderedDict
+
+        original = OrderedDict((
+            ('key-password', 'keep this value'),
+            ('password', 'exact key'),
+            ('changed-password', 'ignored'),
+            ('_ansible_password', 'internal'),
+            ('nested', [
+                {'api-secret': 'nested value', 'status-secret': 'ignored too'},
+                ({'secret': 'exact nested key'},),
+            ]),
+        ))
+
+        sanitized = sanitize_keys(original, ('password', 'secret'), ignore_keys=frozenset(('changed-password', 'status-secret')))
+
+        self.assertIsNot(sanitized, original)
+        self.assertIsInstance(sanitized, OrderedDict)
+        self.assertEqual(sanitized, OrderedDict((
+            ('key-********', 'keep this value'),
+            (self.OMIT, 'exact key'),
+            ('changed-password', 'ignored'),
+            ('_ansible_password', 'internal'),
+            ('nested', [
+                {'api-********': 'nested value', 'status-secret': 'ignored too'},
+                ({self.OMIT: 'exact nested key'},),
+            ]),
+        )))
+        self.assertEqual(original['key-password'], 'keep this value')
+
+    def test_non_mapping_values_pass_through(self):
