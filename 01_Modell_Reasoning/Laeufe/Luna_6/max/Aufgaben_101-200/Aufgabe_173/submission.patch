+package types
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDeduplicateDatabaseServers(t *testing.T) {
+	first := NewDatabaseServerV3("db-a", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	duplicate := NewDatabaseServerV3("db-a", nil, DatabaseServerSpecV3{HostID: "host-2"})
+	third := NewDatabaseServerV3("db-b", nil, DatabaseServerSpecV3{HostID: "host-3"})
+	servers := []DatabaseServer{first, duplicate, third}
+
+	got := DeduplicateDatabaseServers(servers)
+	if len(got) != 2 {
+		t.Fatalf("got %d servers, want 2", len(got))
+	}
+	if got[0] != first || got[1] != third {
+		t.Fatalf("got servers %v, want first occurrences in input order", got)
+	}
+}
+
+func TestSortedDatabaseServersSortsByNameAndHostID(t *testing.T) {
+	servers := SortedDatabaseServers{
+		NewDatabaseServerV3("db-b", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+		NewDatabaseServerV3("db-a", nil, DatabaseServerSpecV3{HostID: "host-2"}),
+		NewDatabaseServerV3("db-a", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+	}
+
+	sort.Sort(servers)
+	if servers[0].GetHostID() != "host-1" || servers[1].GetHostID() != "host-2" || servers[2].GetName() != "db-b" {
+		t.Fatalf("unexpected sort order: %v", servers)
+	}
+}
+
+func TestDatabaseServerStringIncludesHostID(t *testing.T) {
+	server := NewDatabaseServerV3("db", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	if !strings.Contains(server.String(), "HostID=host-1") {
+		t.Errorf("server string %q does not include host ID", server.String())
+	}
+}
