+// DeduplicateDatabaseServers returns at most one database server per name,
+// preserving the order of the first occurrence of each server.
+func DeduplicateDatabaseServers(servers []DatabaseServer) []DatabaseServer {
+	deduplicated := make([]DatabaseServer, 0, len(servers))
+	seen := make(map[string]struct{}, len(servers))
+	for _, server := range servers {
+		name := server.GetName()
+		if _, ok := seen[name]; ok {
+			continue
+		}
+		seen[name] = struct{}{}
+		deduplicated = append(deduplicated, server)
+	}
+	return deduplicated
+}
+
 // DatabaseServers is a list of database servers.
 type DatabaseServers []DatabaseServer
