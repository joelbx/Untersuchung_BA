+// TestProxyRetriesDatabaseServers verifies that a connectivity problem with
+// one database server falls back to another server with the same service name.
+func TestProxyRetriesDatabaseServers(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	go testCtx.startHandlingConnections()
+
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+	first := testCtx.postgres["postgres"].server
+	second := first.Copy().(*types.DatabaseServerV3)
+	second.Spec.HostID = "second-host"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, second)
+	require.NoError(t, err)
+
+	site, err := testCtx.proxyServer.cfg.Tunnel.GetSite(testCtx.clusterName)
+	require.NoError(t, err)
+	fakeSite := site.(*reversetunnel.FakeRemoteSite)
+	fakeSite.OfflineTunnels = map[string]bool{
+		first.GetHostID() + "." + testCtx.clusterName: true,
+	}
+	testCtx.proxyServer.cfg.Shuffle = func([]types.DatabaseServer) []types.DatabaseServer {
+		return []types.DatabaseServer{first, second}
+	}
+
+	psql, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.NoError(t, err)
+	require.NoError(t, psql.Close(ctx))
+}
+
+// TestProxyReturnsErrorWhenNoDatabaseServerIsReachable verifies the error
+// returned after all candidates fail to dial.
+func TestProxyReturnsErrorWhenNoDatabaseServerIsReachable(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	go testCtx.startHandlingConnections()
+
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+	first := testCtx.postgres["postgres"].server
+	second := first.Copy().(*types.DatabaseServerV3)
+	second.Spec.HostID = "second-host"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, second)
+	require.NoError(t, err)
+
+	site, err := testCtx.proxyServer.cfg.Tunnel.GetSite(testCtx.clusterName)
+	require.NoError(t, err)
+	fakeSite := site.(*reversetunnel.FakeRemoteSite)
+	fakeSite.OfflineTunnels = map[string]bool{
+		first.GetHostID() + "." + testCtx.clusterName:  true,
+		second.GetHostID() + "." + testCtx.clusterName: true,
+	}
+	testCtx.proxyServer.cfg.Shuffle = func([]types.DatabaseServer) []types.DatabaseServer {
+		return []types.DatabaseServer{first, second}
+	}
+
+	_, err = testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "no candidate database service could be reached")
+}
