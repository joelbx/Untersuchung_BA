+@pytest.mark.skipif(not encrypt.PASSLIB_AVAILABLE, reason='passlib not available')
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_password_hash_filter_bcrypt_ident(ident):
+    result = get_encrypted_password(
+        '123', 'blowfish', salt='123456789012345678901u', rounds=5, ident=ident,
+    )
+    assert result.startswith('$%s$' % ident)
+
+
+@pytest.mark.skipif(not encrypt.HAS_CRYPT or sys.platform.startswith('darwin'), reason='crypt unavailable')
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_crypt_hash_bcrypt_ident(monkeypatch, ident):
+    settings = []
+
+    def fake_crypt(secret, setting):
+        settings.append(setting)
+        return setting + 'hash'
+
+    monkeypatch.setattr(encrypt.crypt, 'crypt', fake_crypt)
+    result = encrypt.CryptHash('bcrypt').hash(
+        '123', salt='123456789012345678901u', rounds=5, ident=ident,
+    )
+
+    assert settings == ['$%s$05$123456789012345678901u' % ident]
+    assert result.startswith('$%s$' % ident)
+
