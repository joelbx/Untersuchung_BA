+import React from "react";
+import { fireEvent, render } from "@testing-library/react";
+
+import KebabContextMenu from "../../../../src/components/views/context_menus/KebabContextMenu";
+import { IconizedContextMenuOption } from "../../../../src/components/views/context_menus/IconizedContextMenu";
+import { mockPlatformPeg } from "../../../test-utils";
+
+mockPlatformPeg();
+
+describe("<KebabContextMenu />", () => {
+    it("opens with keyboard, closes on interaction, and returns focus to its trigger", () => {
+        const onSignOut = jest.fn();
+        const { getByLabelText, getByTestId, queryByLabelText } = render(<KebabContextMenu
+            title="Session options"
+            data-testid="session-menu"
+            options={[
+                <IconizedContextMenuOption key="sign-out" label="Sign out" onClick={onSignOut} />,
+                <IconizedContextMenuOption key="other" label="Other action" onClick={jest.fn()} />,
+            ]}
+        />);
+        const trigger = getByTestId("session-menu");
+
+        expect(trigger.getAttribute("aria-haspopup")).toBe("true");
+        expect(trigger.getAttribute("aria-expanded")).toBe("false");
+        expect(trigger.getAttribute("aria-label")).toBe("Session options");
+        expect(trigger.getAttribute("title")).toBe("Session options");
+        expect(trigger.querySelector(".mx_KebabContextMenu_icon")).toBeTruthy();
+
+        fireEvent.keyDown(trigger, { key: "Enter", code: "Enter", keyCode: 13 });
+        expect(trigger.getAttribute("aria-expanded")).toBe("true");
+
+        const signOut = getByLabelText("Sign out");
+        fireEvent.click(signOut);
+
+        expect(onSignOut).toHaveBeenCalledTimes(1);
+        expect(trigger.getAttribute("aria-expanded")).toBe("false");
+        expect(queryByLabelText("Sign out")).toBeFalsy();
+        expect(document.activeElement).toBe(trigger);
+
+        fireEvent.keyDown(trigger, { key: " ", code: "Space", keyCode: 32 });
+        fireEvent.keyUp(trigger, { key: " ", code: "Space", keyCode: 32 });
+        expect(trigger.getAttribute("aria-expanded")).toBe("true");
+        fireEvent.keyDown(getByLabelText("Sign out"), { key: "Enter", code: "Enter", keyCode: 13 });
+        expect(onSignOut).toHaveBeenCalledTimes(2);
+        expect(trigger.getAttribute("aria-expanded")).toBe("false");
+        expect(document.activeElement).toBe(trigger);
+
+        fireEvent.click(trigger);
+        const keyboardSignOut = getByLabelText("Sign out");
+        fireEvent.keyDown(keyboardSignOut, { key: " ", code: "Space", keyCode: 32 });
+        fireEvent.keyUp(keyboardSignOut, { key: " ", code: "Space", keyCode: 32 });
+        expect(onSignOut).toHaveBeenCalledTimes(3);
+        expect(trigger.getAttribute("aria-expanded")).toBe("false");
+        expect(document.activeElement).toBe(trigger);
+    });
+
+    it("closes on Escape and disables the visible trigger accessibly", () => {
+        const { getByLabelText, getByTestId, rerender } = render(<KebabContextMenu
+            title="Session options"
+            data-testid="session-menu"
+            options={[<IconizedContextMenuOption key="sign-out" label="Sign out" onClick={jest.fn()} />]}
+        />);
+        const trigger = getByTestId("session-menu");
+
+        fireEvent.click(trigger);
+        fireEvent.keyDown(getByLabelText("Sign out"), { key: "Escape", code: "Escape", keyCode: 27 });
+        expect(trigger.getAttribute("aria-expanded")).toBe("false");
+        expect(document.activeElement).toBe(trigger);
+
+        rerender(<KebabContextMenu
+            title="Session options"
+            data-testid="session-menu"
+            disabled
+            options={[<IconizedContextMenuOption key="sign-out" label="Sign out" onClick={jest.fn()} />]}
+        />);
+
+        expect(trigger.getAttribute("aria-disabled")).toBe("true");
+        expect(trigger.hasAttribute("disabled")).toBe(true);
+        fireEvent.click(trigger);
+        expect(trigger.getAttribute("aria-expanded")).toBe("false");
+    });
+});
