+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useRef, useState } from "react";
+import classNames from "classnames";
+
+import { ContextMenuButton } from "../../../accessibility/context_menu/ContextMenuButton";
+import { KeyBindingAction } from "../../../accessibility/KeyboardShortcuts";
+import { getKeyBindingsManager } from "../../../KeyBindingsManager";
+import UIStore from "../../../stores/UIStore";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+
+export interface KebabContextMenuProps extends Omit<
+    React.ComponentProps<typeof ContextMenuButton>,
+    "children" | "isExpanded" | "label" | "onClick" | "title"
+> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+/** A right-aligned kebab button which opens a keyboard-navigable context menu. */
+export const KebabContextMenu: React.FC<KebabContextMenuProps> = ({
+    options,
+    title,
+    disabled = false,
+    className,
+    ...buttonProps
+}) => {
+    const [isOpen, setIsOpen] = useState(false);
+    const buttonRef = useRef<HTMLButtonElement>(null);
+
+    useEffect(() => {
+        if (disabled) {
+            setIsOpen(false);
+        }
+    }, [disabled]);
+
+    const closeMenu = (): void => setIsOpen(false);
+    const isMenuItemKeyEvent = (event: React.KeyboardEvent): boolean => {
+        return event.target instanceof HTMLElement && !!event.target.closest('[role^="menuitem"]');
+    };
+    const closeOnEnter = (event: React.KeyboardEvent): void => {
+        if (
+            isMenuItemKeyEvent(event) &&
+            getKeyBindingsManager().getAccessibilityAction(event) === KeyBindingAction.Enter
+        ) {
+            closeMenu();
+        }
+    };
+    const closeOnSpace = (event: React.KeyboardEvent): void => {
+        if (
+            isMenuItemKeyEvent(event) &&
+            getKeyBindingsManager().getAccessibilityAction(event) === KeyBindingAction.Space
+        ) {
+            closeMenu();
+        }
+    };
+
+    const toggleMenu = (): void => {
+        if (disabled) return;
+
+        if (isOpen) {
+            closeMenu();
+        } else {
+            // Ensure ContextMenu captures this button as its return-focus target.
+            buttonRef.current?.focus();
+            setIsOpen(true);
+        }
+    };
+
+    let menu: JSX.Element | null = null;
+    if (isOpen && !disabled && buttonRef.current) {
+        const rect = buttonRef.current.getBoundingClientRect();
+        menu = <IconizedContextMenu
+            top={rect.bottom}
+            right={UIStore.instance.windowWidth - rect.right}
+            rightAligned
+            onFinished={closeMenu}
+            menuClassName="mx_KebabContextMenu_menu"
+        >
+            <div onKeyDownCapture={closeOnEnter} onKeyUpCapture={closeOnSpace}>
+                <IconizedContextMenuOptionList first>
+                    { options.map((option, index) => <React.Fragment key={index}>{ option }</React.Fragment>) }
+                </IconizedContextMenuOptionList>
+            </div>
+        </IconizedContextMenu>;
+    }
+
+    return <>
+        <ContextMenuButton
+            {...buttonProps}
+            element="button"
+            type="button"
+            inputRef={buttonRef}
+            className={classNames("mx_KebabContextMenu_trigger", className)}
+            label={title}
+            disabled={disabled}
+            isExpanded={isOpen && !disabled}
+            onClick={toggleMenu}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { menu }
+    </>;
+};
+
+export default KebabContextMenu;
