diff --git a/internal/tracing/propagators.go b/internal/tracing/propagators.go
new file mode 100644
index 0000000..b176711
--- /dev/null
+++ b/internal/tracing/propagators.go
@@ -0,0 +1,255 @@
+package tracing
+
+import (
+	"context"
+	"strconv"
+	"strings"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/baggage"
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+type textMapPropagator struct {
+	fields    []string
+	injectFn  func(context.Context, propagation.TextMapCarrier)
+	extractFn func(context.Context, propagation.TextMapCarrier) context.Context
+}
+
+func (p textMapPropagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	p.injectFn(ctx, carrier)
+}
+
+func (p textMapPropagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	return p.extractFn(ctx, carrier)
+}
+
+func (p textMapPropagator) Fields() []string {
+	return p.fields
+}
+
+// NewPropagator creates a composite text map propagator from the configured formats.
+func NewPropagator(options []config.TracingPropagator) propagation.TextMapPropagator {
+	if len(options) == 0 {
+		return propagation.NewCompositeTextMapPropagator()
+	}
+
+	propagators := make([]propagation.TextMapPropagator, 0, len(options))
+	for _, option := range options {
+		if option == config.TracingPropagatorNone {
+			return propagation.NewCompositeTextMapPropagator()
+		}
+
+		switch option {
+		case config.TracingPropagatorTraceContext:
+			propagators = append(propagators, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			propagators = append(propagators, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			propagators = append(propagators, b3Propagator(false))
+		case config.TracingPropagatorB3Multi:
+			propagators = append(propagators, b3Propagator(true))
+		case config.TracingPropagatorJaeger:
+			propagators = append(propagators, jaegerPropagator())
+		case config.TracingPropagatorXRay:
+			propagators = append(propagators, xrayPropagator())
+		case config.TracingPropagatorOTTrace:
+			propagators = append(propagators, otTracePropagator())
+		}
+	}
+
+	return propagation.NewCompositeTextMapPropagator(propagators...)
+}
+
+func b3Propagator(multi bool) propagation.TextMapPropagator {
+	if !multi {
+		return textMapPropagator{
+			fields: []string{"b3"},
+			injectFn: func(ctx context.Context, carrier propagation.TextMapCarrier) {
+				sc := trace.SpanContextFromContext(ctx)
+				if !sc.IsValid() {
+					return
+				}
+				sampled := "0"
+				if sc.IsSampled() {
+					sampled = "1"
+				}
+				carrier.Set("b3", sc.TraceID().String()+"-"+sc.SpanID().String()+"-"+sampled)
+			},
+			extractFn: func(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+				parts := strings.Split(carrier.Get("b3"), "-")
+				if len(parts) < 2 {
+					return ctx
+				}
+				return withRemoteSpanContext(ctx, parts[0], parts[1], len(parts) > 2 && isSampled(parts[2]))
+			},
+		}
+	}
+
+	fields := []string{"x-b3-traceid", "x-b3-spanid", "x-b3-sampled", "x-b3-flags"}
+	return textMapPropagator{
+		fields: fields,
+		injectFn: func(ctx context.Context, carrier propagation.TextMapCarrier) {
+			sc := trace.SpanContextFromContext(ctx)
+			if !sc.IsValid() {
+				return
+			}
+			carrier.Set("x-b3-traceid", sc.TraceID().String())
+			carrier.Set("x-b3-spanid", sc.SpanID().String())
+			if sc.IsSampled() {
+				carrier.Set("x-b3-sampled", "1")
+			} else {
+				carrier.Set("x-b3-sampled", "0")
+			}
+		},
+		extractFn: func(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+			sampled := isSampled(carrier.Get("x-b3-sampled")) || carrier.Get("x-b3-flags") == "1"
+			return withRemoteSpanContext(ctx, carrier.Get("x-b3-traceid"), carrier.Get("x-b3-spanid"), sampled)
+		},
+	}
+}
+
+func jaegerPropagator() propagation.TextMapPropagator {
+	return textMapPropagator{
+		fields: []string{"uber-trace-id"},
+		injectFn: func(ctx context.Context, carrier propagation.TextMapCarrier) {
+			sc := trace.SpanContextFromContext(ctx)
+			if !sc.IsValid() {
+				return
+			}
+			flags := "00"
+			if sc.IsSampled() {
+				flags = "01"
+			}
+			carrier.Set("uber-trace-id", sc.TraceID().String()+":"+sc.SpanID().String()+":0000000000000000:"+flags)
+		},
+		extractFn: func(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+			parts := strings.Split(carrier.Get("uber-trace-id"), ":")
+			if len(parts) != 4 {
+				return ctx
+			}
+			flags, _ := strconv.ParseUint(parts[3], 16, 8)
+			return withRemoteSpanContext(ctx, parts[0], parts[1], flags&1 != 0)
+		},
+	}
+}
+
+func xrayPropagator() propagation.TextMapPropagator {
+	return textMapPropagator{
+		fields: []string{"x-amzn-trace-id"},
+		injectFn: func(ctx context.Context, carrier propagation.TextMapCarrier) {
+			sc := trace.SpanContextFromContext(ctx)
+			if !sc.IsValid() {
+				return
+			}
+			traceID := sc.TraceID().String()
+			sampled := "0"
+			if sc.IsSampled() {
+				sampled = "1"
+			}
+			carrier.Set("x-amzn-trace-id", "Root=1-"+traceID[:8]+"-"+traceID[8:]+";Parent="+sc.SpanID().String()+";Sampled="+sampled)
+		},
+		extractFn: func(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+			var root, parent, sampled string
+			for _, part := range strings.Split(carrier.Get("x-amzn-trace-id"), ";") {
+				key, value, ok := strings.Cut(strings.TrimSpace(part), "=")
+				if !ok {
+					continue
+				}
+				switch key {
+				case "Root":
+					root = strings.TrimPrefix(value, "1-")
+					root = strings.ReplaceAll(root, "-", "")
+				case "Parent":
+					parent = value
+				case "Sampled":
+					sampled = value
+				}
+			}
+			return withRemoteSpanContext(ctx, root, parent, isSampled(sampled))
+		},
+	}
+}
+
+func otTracePropagator() propagation.TextMapPropagator {
+	fields := []string{"ot-tracer-traceid", "ot-tracer-spanid", "ot-tracer-sampled", "ot-baggage-"}
+	return textMapPropagator{
+		fields: fields,
+		injectFn: func(ctx context.Context, carrier propagation.TextMapCarrier) {
+			sc := trace.SpanContextFromContext(ctx)
+			if sc.IsValid() {
+				carrier.Set("ot-tracer-traceid", sc.TraceID().String())
+				carrier.Set("ot-tracer-spanid", sc.SpanID().String())
+				if sc.IsSampled() {
+					carrier.Set("ot-tracer-sampled", "true")
+				} else {
+					carrier.Set("ot-tracer-sampled", "false")
+				}
+			}
+			for _, member := range baggage.FromContext(ctx).Members() {
+				carrier.Set("ot-baggage-"+member.Key(), member.Value())
+			}
+		},
+		extractFn: func(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+			ctx = withRemoteSpanContext(ctx, carrier.Get("ot-tracer-traceid"), carrier.Get("ot-tracer-spanid"), isSampled(carrier.Get("ot-tracer-sampled")))
+			var members []baggage.Member
+			for _, key := range carrier.Keys() {
+				if !strings.HasPrefix(key, "ot-baggage-") {
+					continue
+				}
+				member, err := baggage.NewMember(strings.TrimPrefix(key, "ot-baggage-"), carrier.Get(key))
+				if err == nil {
+					members = append(members, member)
+				}
+			}
+			if len(members) > 0 {
+				if value, err := baggage.New(members...); err == nil {
+					ctx = baggage.ContextWithBaggage(ctx, value)
+				}
+			}
+			return ctx
+		},
+	}
+}
+
+func withRemoteSpanContext(ctx context.Context, traceID, spanID string, sampled bool) context.Context {
+	if len(traceID) == 16 {
+		traceID = strings.Repeat("0", 16) + traceID
+	}
+	if len(spanID) < 16 {
+		spanID = strings.Repeat("0", 16-len(spanID)) + spanID
+	}
+
+	id, err := trace.TraceIDFromHex(traceID)
+	if err != nil {
+		return ctx
+	}
+	span, err := trace.SpanIDFromHex(spanID)
+	if err != nil {
+		return ctx
+	}
+	flags := trace.TraceFlags(0)
+	if sampled {
+		flags = trace.FlagsSampled
+	}
+	spanContext := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    id,
+		SpanID:     span,
+		TraceFlags: flags,
+		Remote:     true,
+	})
+	if !spanContext.IsValid() {
+		return ctx
+	}
+	return trace.ContextWithRemoteSpanContext(ctx, spanContext)
+}
+
+func isSampled(value string) bool {
+	switch strings.ToLower(value) {
+	case "1", "true", "d":
+		return true
+	default:
+		return false
+	}
+}
