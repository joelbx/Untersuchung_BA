diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..fdcf134
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,154 @@
+package oci
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+const defaultPollInterval = 30 * time.Second
+
+// Source implements fs.SnapshotSource using manifests from an OCI repository.
+type Source struct {
+	mu sync.Mutex
+
+	current  *storagefs.StoreSnapshot
+	digest   digest.Digest
+	logger   *zap.Logger
+	interval time.Duration
+	store    *fliptoci.Store
+}
+
+// NewSource constructs a source backed by the supplied OCI store.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if store == nil {
+		return nil, errors.New("OCI store is required")
+	}
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	source := &Source{
+		logger:   logger,
+		interval: defaultPollInterval,
+		store:    store,
+	}
+	containers.ApplyAll(source, opts...)
+	if source.interval <= 0 {
+		return nil, fmt.Errorf("OCI poll interval must be positive: %s", source.interval)
+	}
+
+	return source, nil
+}
+
+// WithPollInterval configures how often Subscribe checks the OCI repository.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(source *Source) {
+		source.interval = tick
+	}
+}
+
+// String returns an identifier for this source.
+func (*Source) String() string {
+	return "oci"
+}
+
+// Get returns the current snapshot, fetching and rebuilding it when the
+// manifest digest differs from the previously fetched digest.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+
+	s.logger.Debug("fetching OCI snapshot", zap.String("digest", s.digest.String()))
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	if response.Matched {
+		if s.current == nil {
+			return nil, errors.New("OCI store reported a matching digest before an initial snapshot was built")
+		}
+		s.logger.Debug("OCI snapshot is unchanged", zap.String("digest", response.Digest.String()))
+		return s.current, nil
+	}
+
+	defer func() {
+		for _, file := range response.Files {
+			_ = file.Close()
+		}
+	}()
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building snapshot from OCI layers", zap.Error(err))
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+
+	s.current = snapshot
+	s.digest = response.Digest
+	s.logger.Debug("built OCI snapshot", zap.String("digest", s.digest.String()))
+	return s.current, nil
+}
+
+// Subscribe polls the OCI source and sends a snapshot only when its content
+// digest changes. It closes the channel when the context is cancelled.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	defer func() {
+		s.logger.Debug("OCI snapshot subscription stopped")
+	}()
+
+	s.mu.Lock()
+	lastDigest := s.digest
+	s.mu.Unlock()
+
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				s.logger.Error("failed polling OCI snapshot", zap.Error(err))
+				continue
+			}
+
+			s.mu.Lock()
+			currentDigest := s.digest
+			s.mu.Unlock()
+			if currentDigest == lastDigest {
+				continue
+			}
+
+			s.logger.Debug("sending updated OCI snapshot", zap.String("digest", currentDigest.String()))
+			select {
+			case ch <- snapshot:
+				lastDigest = currentDigest
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
