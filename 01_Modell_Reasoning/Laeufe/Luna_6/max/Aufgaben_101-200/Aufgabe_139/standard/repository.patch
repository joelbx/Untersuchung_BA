+    )
+
+
+def get_import_item_augmentation_identifier(rec: dict[str, Any]) -> str | None:
+    """Prefer an ISBN-10, then find a non-ISBN Amazon B* ASIN."""
+    if isbn_10 := _first_nonempty_identifier(rec.get('isbn_10')):
+        return isbn_10
+
+    identifiers = rec.get('identifiers')
+    amazon_ids = identifiers.get('amazon') if isinstance(identifiers, dict) else None
+    amazon_values = [amazon_ids] if isinstance(amazon_ids, str) else amazon_ids
+    if isinstance(amazon_values, (list, tuple)):
+        if amazon_id := next(
+            (
+                value.strip()
+                for value in amazon_values
+                if isinstance(value, str)
+                and value.strip()
+                and value.strip().upper().startswith('B')
+            ),
+            None,
+        ):
+            return amazon_id
+
+    source_records = rec.get('source_records')
+    if isinstance(source_records, str):
+        source_records = [source_records]
+    if isinstance(source_records, (list, tuple)):
+        for source_record in source_records:
+            if isinstance(source_record, str) and source_record.startswith('amazon:B'):
+                return source_record.split(':', 1)[1]
+    return None
+
+
+def _has_metadata_value(value: Any) -> bool:
+    if isinstance(value, str):
+        return bool(value.strip()) and value.strip() != '????'
+    if isinstance(value, dict):
+        return any(_has_metadata_value(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return any(_has_metadata_value(item) for item in value)
+    return bool(value)
+
+
+def _has_field_value(field: str, value: Any) -> bool:
+    if field == 'authors':
+        authors = value if isinstance(value, list) else [value]
+        return any(
+            _has_metadata_value(author.get('name'))
+            if isinstance(author, dict)
+            else _has_metadata_value(author)
+            for author in authors
+        )
+    return _has_metadata_value(value)
+
+
+def supplement_rec_with_import_item_metadata(
+    rec: dict[str, Any], identifier: str
+) -> None:
+    """Fill empty import fields in place from a staged or pending import item."""
+    from openlibrary.core.imports import ImportItem  # Evade circular import.
+
+    fields = (
+        'authors',
+        'publish_date',
+        'publishers',
+        'number_of_pages',
+        'physical_format',
+        'isbn_10',
+        'isbn_13',
+        'title',
+    )
+    normalize_import_placeholders(rec)
+    if is_complete_record(rec):
+        return
+
+    try:
+        import_item = ImportItem.find_staged_or_pending([identifier]).first()
+        if not import_item:
+            return
+
+        staged_data = import_item.get('data') or {}
+        if isinstance(staged_data, str):
+            staged_data = json.loads(staged_data)
+        if not isinstance(staged_data, dict):
+            return
+
+        for field in fields:
+            staged_value = staged_data.get(field)
+            if not _has_field_value(field, rec.get(field)) and _has_field_value(
+                field, staged_value
+            ):
+                rec[field] = staged_value
+    except Exception:  # noqa: BLE001
+        logger.exception(
+            'Failed to supplement import metadata for identifier %s', identifier
+        )
