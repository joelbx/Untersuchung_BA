+        finishAdminAction,
+    }: Pick<IBaseProps, "isAdminActionPending" | "tryStartAdminAction" | "finishAdminAction">,
+): { pending: boolean; begin(): boolean; finish(): void } => {
+    const memberKey = JSON.stringify([member.roomId, member.userId]);
+    const localPendingMemberKey = useRef<string | null>(null);
+    const [localPending, setLocalPending] = useState<string | null>(null);
+
+    const begin = useCallback(() => {
+        if (localPendingMemberKey.current === memberKey || isAdminActionPending) return false;
+        if (tryStartAdminAction && !tryStartAdminAction()) return false;
+
+        localPendingMemberKey.current = memberKey;
+        setLocalPending(memberKey);
+        return true;
+    }, [isAdminActionPending, memberKey, tryStartAdminAction]);
+
+    const finish = useCallback(() => {
+        if (localPendingMemberKey.current === memberKey) {
+            localPendingMemberKey.current = null;
+            setLocalPending((pending) => (pending === memberKey ? null : pending));
+        }
+        finishAdminAction?.();
+    }, [finishAdminAction, memberKey]);
+
+    return { pending: isAdminActionPending || localPending === memberKey, begin, finish };
+};
