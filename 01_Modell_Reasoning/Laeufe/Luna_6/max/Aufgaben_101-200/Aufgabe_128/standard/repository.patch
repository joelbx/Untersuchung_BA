diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..c8ea02f 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,93 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_is_added_with_or_without_explicit_match(self):
+        expected_command = [
+            '/sbin/iptables',
+            '-t', 'filter',
+            '-C', 'INPUT',
+            '-p', 'tcp',
+            '-m', 'set',
+            '--match-set', 'admin_hosts', 'src,dst',
+            '-j', 'ACCEPT',
+            '--destination-port', '22',
+            '-m', 'comment',
+            '--comment', 'SSH access'
+        ]
+
+        for match in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'match': match,
+                'match_set': 'admin_hosts',
+                'match_set_flags': 'src,dst',
+                'destination_port': '22',
+                'jump': 'ACCEPT',
+                'comment': 'SSH access',
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_args[0][0], expected_command)
+
+    def test_match_set_inversion(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': '!blocked_hosts',
+            'match_set_flags': 'dst,src',
+            'jump': 'ACCEPT',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables',
+            '-t', 'filter',
+            '-C', 'INPUT',
+            '-m', 'set',
+            '!', '--match-set', 'blocked_hosts', 'dst,src',
+            '-j', 'ACCEPT',
+        ])
+
+    def test_match_set_requires_name_and_flags(self):
+        for params in (
+            {'match_set': 'admin_hosts'},
+            {'match_set_flags': 'src'},
+        ):
+            params['chain'] = 'INPUT'
+            set_module_args(params)
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+
+    def test_match_set_flags_choices(self):
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            set_module_args({
+                'chain': 'INPUT',
+                'match_set': 'admin_hosts',
+                'match_set_flags': flags,
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_args[0][0][-3:], [
+                '--match-set', 'admin_hosts', flags
+            ])
+
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'src,dst,src',
+        })
+        with self.assertRaises(AnsibleFailJson):
+            iptables.main()
