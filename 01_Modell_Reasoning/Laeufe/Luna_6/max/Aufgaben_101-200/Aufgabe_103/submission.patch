+// splitInstalledPackageFields preserves the empty RELEASE column emitted by
+// rpm's query format (the empty value appears as two adjacent spaces).
+func splitInstalledPackageFields(line string) []string {
+	fields := strings.Fields(line)
+	if len(fields) < 4 {
+		return fields
+	}
+
+	// Find the separator immediately following NAME, EPOCH, and VERSION.
+	pos := 0
+	for i := 0; i < 3; i++ {
+		for pos < len(line) && isRPMQuerySpace(line[pos]) {
+			pos++
+		}
+		for pos < len(line) && !isRPMQuerySpace(line[pos]) {
+			pos++
+		}
+	}
+	start := pos
+	for pos < len(line) && isRPMQuerySpace(line[pos]) {
+		pos++
+	}
+	separator := line[start:pos]
+	if len(separator) < 2 || strings.Trim(separator, " ") != "" {
+		return fields
+	}
+
+	withEmptyRelease := make([]string, 0, len(fields)+1)
+	withEmptyRelease = append(withEmptyRelease, fields[:3]...)
+	withEmptyRelease = append(withEmptyRelease, "")
+	return append(withEmptyRelease, fields[3:]...)
+}
+
+func isRPMQuerySpace(b byte) bool {
+	return b == ' ' || b == '\t' || b == '\n' || b == '\r'
+}
+
+func formatRPMVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = fmt.Sprintf("%s:%s", epoch, version)
+	}
+	if release != "" {
+		version = fmt.Sprintf("%s-%s", version, release)
+	}
+	return version
+}
+
