+func TestPrintEnrollOutcomeNilDevice(t *testing.T) {
+	readPipe, writePipe, err := os.Pipe()
+	require.NoError(t, err)
+
+	originalStdout := os.Stdout
+	t.Cleanup(func() {
+		os.Stdout = originalStdout
+		_ = readPipe.Close()
+		_ = writePipe.Close()
+	})
+	os.Stdout = writePipe
+
+	printEnrollOutcome(enroll.DeviceRegistered, nil)
+	require.NoError(t, writePipe.Close())
+	os.Stdout = originalStdout
+
+	output, err := io.ReadAll(readPipe)
+	require.NoError(t, err)
+	require.Equal(t, "Device registered (device information unavailable)\n", string(output))
