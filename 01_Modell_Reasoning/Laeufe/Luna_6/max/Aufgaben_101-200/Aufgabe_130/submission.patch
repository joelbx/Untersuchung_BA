+func TestCeremony_RunAdminDeviceLimitReached(t *testing.T) {
+	env := testenv.MustNew()
+	defer env.Close()
+	env.Service.SetDevicesLimitReached(true)
+
+	dev, err := testenv.NewFakeMacOSDevice()
+	require.NoError(t, err, "NewFakeMacOSDevice failed")
+	c := &enroll.Ceremony{
+		GetDeviceOSType:         dev.GetDeviceOSType,
+		EnrollDeviceInit:        dev.EnrollDeviceInit,
+		SignChallenge:           dev.SignChallenge,
+		SolveTPMEnrollChallenge: dev.SolveTPMEnrollChallenge,
+	}
+
+	registered, outcome, err := c.RunAdmin(context.Background(), env.DevicesClient, false /* debug */)
+	require.Error(t, err, "RunAdmin succeeded despite the device limit")
+	assert.ErrorContains(t, err, "cluster has reached its enrolled trusted device limit")
+	assert.ErrorContains(t, err, "device limit")
+	assert.NotNil(t, registered, "RunAdmin returned nil device after registration")
+	assert.Equal(t, enroll.DeviceRegistered, outcome, "RunAdmin outcome mismatch")
+
+	resp, err := env.DevicesClient.FindDevices(context.Background(), &devicepb.FindDevicesRequest{
+		IdOrTag: dev.SerialNumber,
+	})
+	require.NoError(t, err, "FindDevices failed")
+	require.Len(t, resp.Devices, 1, "registered device was not persisted")
+	assert.Equal(t, devicepb.DeviceEnrollStatus_DEVICE_ENROLL_STATUS_NOT_ENROLLED, resp.Devices[0].EnrollStatus)
+}
