new file mode 100644
index 0000000..1bfac20
--- /dev/null
+++ b/reporter/sbom/purl.go
@@ -0,0 +1,32 @@
+package sbom
+
+import (
+	"strings"
+)
+
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch t {
+	case "maven", "pom", "gradle", "jar":
+		if ns, pkg, ok := strings.Cut(n, ":"); ok {
+			namespace, name = ns, pkg
+		}
+	case "pypi", "pip", "pipenv", "poetry", "uv":
+		name = strings.ToLower(strings.ReplaceAll(n, "_", "-"))
+	case "golang", "gomod":
+		if i := strings.LastIndexByte(n, '/'); i >= 0 {
+			namespace, name = n[:i], n[i+1:]
+		}
+	case "npm", "yarn", "pnpm":
+		if strings.HasPrefix(n, "@") {
+			if ns, pkg, ok := strings.Cut(n, "/"); ok {
+				namespace, name = ns, pkg
+			}
+		}
+	case "cocoapods":
+		if i := strings.IndexByte(n, '/'); i >= 0 {
+			name, subpath = n[:i], n[i+1:]
+		}
+	}
+	return namespace, name, subpath
+}
