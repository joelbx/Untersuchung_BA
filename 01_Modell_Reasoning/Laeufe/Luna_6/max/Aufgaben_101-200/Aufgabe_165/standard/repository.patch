+export interface AllowedEncryptionSetting {
+    allowChange: boolean;
+    forcedValue?: boolean;
+}
+
+/**
+ * Determines whether encryption can be changed for a room preset, including server and .well-known policy.
+ */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const [serverForcesEncryption, wellKnownForcesEncryptionOff] = await Promise.all([
+        client.doesServerForceEncryptionForPreset(chatPreset),
+        Promise.resolve(shouldForceDisableEncryption(client)),
+    ]);
+
+    if (serverForcesEncryption && wellKnownForcesEncryptionOff) {
+        console.warn(
+            "Conflicting encryption policies: server requires encryption, while .well-known forces it off. Using server policy.",
+        );
+    }
+
+    if (serverForcesEncryption) return { allowChange: false, forcedValue: true };
+    if (wellKnownForcesEncryptionOff) return { allowChange: false, forcedValue: false };
+    return { allowChange: true };
+}
+
