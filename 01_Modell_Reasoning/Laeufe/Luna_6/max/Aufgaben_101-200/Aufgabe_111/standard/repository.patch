+func parseAmazonLinuxRelease(output string) string {
+	line := strings.TrimSpace(output)
+	if strings.HasPrefix(line, "Amazon Linux AMI release ") {
+		fields := strings.Fields(strings.TrimPrefix(line, "Amazon Linux AMI release "))
+		if len(fields) > 0 {
+			return fields[0]
+		}
+		return "unknown"
+	}
+
+	if strings.HasPrefix(line, "Amazon Linux release ") {
+		return strings.TrimSpace(strings.TrimPrefix(line, "Amazon Linux release "))
+	}
+	if strings.HasPrefix(line, "Amazon Linux ") {
+		return strings.TrimSpace(strings.TrimPrefix(line, "Amazon Linux "))
+	}
+	return "unknown"
+}
