+func Test_getAmazonLinuxVersion(t *testing.T) {
+	tests := []struct {
+		release string
+		want    string
+	}{
+		{release: "1", want: "1"},
+		{release: "2018.03", want: "1"},
+		{release: "2024.01", want: "1"},
+		{release: "2 (Karoo)", want: "2"},
+		{release: "2022 (Amazon Linux)", want: "2022"},
+		{release: "2023 (Amazon Linux)", want: "2023"},
+		{release: "2025", want: "2025"},
+		{release: "2027", want: "2027"},
+		{release: "2029", want: "2029"},
+		{release: "2024 (Amazon Linux)", want: "unknown"},
+		{release: "2024.13", want: "unknown"},
+		{release: "unknown", want: "unknown"},
+		{release: "", want: "unknown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.want {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.want)
+			}
+		})
+	}
+}
