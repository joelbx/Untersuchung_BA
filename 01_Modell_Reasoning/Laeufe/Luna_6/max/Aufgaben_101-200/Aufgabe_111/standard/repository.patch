+func TestGetEOLAmazonLinuxSupportDates(t *testing.T) {
+	tests := []struct {
+		release string
+		until   time.Time
+	}{
+		{release: "2023 (Amazon Linux)", until: time.Date(2028, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{release: "2025 (Amazon Linux)", until: time.Date(2030, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{release: "2027 (Amazon Linux)", until: time.Date(2032, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{release: "2029 (Amazon Linux)", until: time.Date(2034, 6, 30, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL did not find a supported Amazon Linux release")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("StandardSupportUntil = %s, want %s", eol.StandardSupportUntil, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until.Add(-time.Second)) || eol.IsExtendedSuppportEnded(tt.until.Add(-time.Second)) {
+				t.Error("support ended before the configured end date")
+			}
+			if !eol.IsStandardSupportEnded(tt.until.Add(time.Second)) || !eol.IsExtendedSuppportEnded(tt.until.Add(time.Second)) {
+				t.Error("support did not end after the configured end date")
+			}
+		})
+	}
+
+	if _, found := GetEOL(Amazon, "2024 (Amazon Linux)"); found {
+		t.Error("GetEOL found an unrecognized Amazon Linux release")
+	}
+}
