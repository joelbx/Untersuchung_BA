diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..f8782eb
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,297 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const (
+	backupFilenamePrefix  = "navidrome_backup_"
+	backupFilenameSuffix  = ".db"
+	backupTimestampLayout = "20060102T150405.000000000Z"
+)
+
+var backupTimestampLayouts = []string{
+	backupTimestampLayout,
+	"20060102_150405.000000000",
+	"20060102_150405",
+	"20060102150405",
+}
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	backupDir := conf.Server.Backup.Path
+	if backupDir == "" {
+		return "", fmt.Errorf("backup.path is not configured")
+	}
+	if err := os.MkdirAll(backupDir, os.ModePerm); err != nil {
+		return "", fmt.Errorf("create backup directory %q: %w", backupDir, err)
+	}
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+
+	timestamp := time.Now().UTC()
+	var backupPath string
+	for {
+		backupPath = filepath.Join(backupDir, backupFilenamePrefix+timestamp.Format(backupTimestampLayout)+backupFilenameSuffix)
+		file, err := os.OpenFile(backupPath, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if errors.Is(err, os.ErrExist) {
+			timestamp = timestamp.Add(time.Nanosecond)
+			continue
+		}
+		if err != nil {
+			return "", fmt.Errorf("create backup file %q: %w", backupPath, err)
+		}
+		if err = file.Close(); err != nil {
+			_ = os.Remove(backupPath)
+			return "", fmt.Errorf("close backup file %q: %w", backupPath, err)
+		}
+		break
+	}
+
+	destination, err := sql.Open(Driver+"_custom", backupPath)
+	if err == nil {
+		err = copySQLiteDatabase(ctx, destination, d.writeDB)
+		closeErr := destination.Close()
+		if err == nil {
+			err = closeErr
+		}
+	}
+	if err != nil {
+		_ = os.Remove(backupPath)
+		return "", fmt.Errorf("create database backup: %w", err)
+	}
+	return backupPath, nil
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) {
+	return prune(ctx)
+}
+
+func prune(ctx context.Context) (int, error) {
+	backupDir := conf.Server.Backup.Path
+	if backupDir == "" {
+		return 0, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	entries, err := os.ReadDir(backupDir)
+	if err != nil {
+		return 0, fmt.Errorf("read backup directory %q: %w", backupDir, err)
+	}
+
+	type backupFile struct {
+		path      string
+		timestamp time.Time
+	}
+	backups := make([]backupFile, 0, len(entries))
+	for _, entry := range entries {
+		name := entry.Name()
+		if !strings.HasPrefix(name, backupFilenamePrefix) || !strings.HasSuffix(name, backupFilenameSuffix) {
+			continue
+		}
+		timestampText := strings.TrimSuffix(strings.TrimPrefix(name, backupFilenamePrefix), backupFilenameSuffix)
+		timestamp, validTimestamp := parseBackupTimestamp(timestampText)
+		if !validTimestamp {
+			continue
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return 0, fmt.Errorf("inspect backup file %q: %w", filepath.Join(backupDir, name), err)
+		}
+		if !info.Mode().IsRegular() {
+			continue
+		}
+		backups = append(backups, backupFile{path: filepath.Join(backupDir, name), timestamp: timestamp})
+	}
+	sort.Slice(backups, func(i, j int) bool {
+		return backups[i].timestamp.After(backups[j].timestamp)
+	})
+
+	keep := conf.Server.Backup.Count
+	if keep < 0 {
+		keep = 0
+	}
+	if keep >= len(backups) {
+		return 0, nil
+	}
+	removed := 0
+	for _, oldBackup := range backups[keep:] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(oldBackup.path); err != nil {
+			return removed, fmt.Errorf("remove old backup %q: %w", oldBackup.path, err)
+		}
+		removed++
+	}
+	return removed, nil
+}
+
+func parseBackupTimestamp(value string) (time.Time, bool) {
+	for _, layout := range backupTimestampLayouts {
+		timestamp, err := time.Parse(layout, value)
+		if err == nil {
+			return timestamp, true
+		}
+	}
+	return time.Time{}, false
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return fmt.Errorf("backup file path is empty")
+	}
+	backupPath, err := filepath.Abs(path)
+	if err != nil {
+		return fmt.Errorf("resolve backup file path: %w", err)
+	}
+	info, err := os.Stat(backupPath)
+	if err != nil {
+		return fmt.Errorf("open backup file %q: %w", backupPath, err)
+	}
+	if !info.Mode().IsRegular() || info.Size() == 0 {
+		return fmt.Errorf("backup file %q is not a non-empty regular file", backupPath)
+	}
+	if sameDatabaseFile(backupPath, conf.Server.DbPath) {
+		return fmt.Errorf("backup file %q is the live database", backupPath)
+	}
+
+	source, err := sql.Open(Driver+"_custom", backupPath)
+	if err != nil {
+		return fmt.Errorf("open backup database %q: %w", backupPath, err)
+	}
+	defer source.Close()
+	if err := validateSQLiteDatabase(ctx, source); err != nil {
+		return fmt.Errorf("invalid backup database %q: %w", backupPath, err)
+	}
+	if err := copySQLiteDatabase(ctx, d.writeDB, source); err != nil {
+		return fmt.Errorf("restore database from %q: %w", backupPath, err)
+	}
+	return nil
+}
+
+func sameDatabaseFile(path1, path2 string) bool {
+	if path2 == "" {
+		return false
+	}
+	if strings.HasPrefix(path2, "file:") {
+		uri, err := url.Parse(path2)
+		if err != nil {
+			return false
+		}
+		path2 = uri.Path
+		if uri.Opaque != "" {
+			path2, err = url.PathUnescape(uri.Opaque)
+			if err != nil {
+				return false
+			}
+		}
+		if path2 == "" || path2 == ":memory:" {
+			return false
+		}
+	}
+	abs1, err1 := filepath.Abs(path1)
+	abs2, err2 := filepath.Abs(path2)
+	if err1 == nil && err2 == nil && abs1 == abs2 {
+		return true
+	}
+	info1, err1 := os.Stat(path1)
+	info2, err2 := os.Stat(path2)
+	return err1 == nil && err2 == nil && os.SameFile(info1, info2)
+}
+
+func validateSQLiteDatabase(ctx context.Context, source *sql.DB) error {
+	rows, err := source.QueryContext(ctx, "PRAGMA quick_check")
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+
+	foundResult := false
+	for rows.Next() {
+		var result string
+		if err := rows.Scan(&result); err != nil {
+			return err
+		}
+		foundResult = true
+		if result != "ok" {
+			return fmt.Errorf("SQLite integrity check failed: %s", result)
+		}
+	}
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	if !foundResult {
+		return fmt.Errorf("SQLite integrity check returned no result")
+	}
+	return nil
+}
+
+func copySQLiteDatabase(ctx context.Context, destination, source *sql.DB) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	sourceConn, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer sourceConn.Close()
+
+	destinationConn, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destinationConn.Close()
+
+	return sourceConn.Raw(func(sourceDriverConn any) error {
+		sourceSQLiteConn, ok := sourceDriverConn.(*sqlite3.SQLiteConn)
+		if !ok {
+			return fmt.Errorf("unexpected SQLite source connection type %T", sourceDriverConn)
+		}
+		return destinationConn.Raw(func(destinationDriverConn any) error {
+			destinationSQLiteConn, ok := destinationDriverConn.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected SQLite destination connection type %T", destinationDriverConn)
+			}
+			backup, err := destinationSQLiteConn.Backup("main", sourceSQLiteConn, "main")
+			if err != nil {
+				return err
+			}
+			return func() (backupErr error) {
+				defer func() {
+					if finishErr := backup.Finish(); backupErr == nil {
+						backupErr = finishErr
+					}
+				}()
+
+				for {
+					done, err := backup.Step(128)
+					if err != nil {
+						return err
+					}
+					if done {
+						return nil
+					}
+					select {
+					case <-ctx.Done():
+						return ctx.Err()
+					case <-time.After(10 * time.Millisecond):
+					}
+				}
+			}()
+		})
+	})
+}
