+// schedulePeriodicBackup schedules database backups and retention pruning.
+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		backup := conf.Server.Backup
+		if backup.Path == "" || backup.Schedule == "" || backup.Count == 0 {
+			log.Warn("Periodic database backups are DISABLED")
+			return nil
+		}
+
+		database := db.Db()
+		schedulerInstance := scheduler.GetInstance()
+		log.Info("Scheduling periodic database backups", "schedule", backup.Schedule, "retention", backup.Count)
+		err := schedulerInstance.Add(backup.Schedule, func() {
+			path, err := database.Backup(ctx)
+			if err != nil {
+				log.Error("Error creating scheduled database backup", err)
+				return
+			}
+			log.Info("Created scheduled database backup", "path", path)
+			pruned, err := database.Prune(ctx)
+			if err != nil {
+				log.Error("Error pruning scheduled database backups", err)
+				return
+			}
+			if pruned > 0 {
+				log.Info("Pruned old database backups", "count", pruned)
+			}
+		})
+		if err != nil {
+			log.Error("Error scheduling periodic database backups", err)
+		}
+		return nil
+	}
+}
