+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd.AddCommand(newBackupCreateCmd())
+	backupCmd.AddCommand(newBackupPruneCmd())
+	backupCmd.AddCommand(newBackupRestoreCmd())
+	rootCmd.AddCommand(backupCmd)
+}
+
+var backupCmd = &cobra.Command{
+	Use:   "backup",
+	Short: "Manage database backups",
+	Args:  cobra.NoArgs,
+	Run: func(cmd *cobra.Command, _ []string) {
+		_ = cmd.Help()
+	},
+}
+
+func newBackupCreateCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:   "create",
+		Short: "Create a database backup",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			database := db.Db()
+			path, err := database.Backup(cmd.Context())
+			if err != nil {
+				return err
+			}
+			cmd.Printf("Database backup created: %s\n", path)
+			return nil
+		},
+	}
+}
+
+func newBackupPruneCmd() *cobra.Command {
+	var force bool
+	command := &cobra.Command{
+		Use:   "prune",
+		Short: "Delete old database backups",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			if conf.Server.Backup.Count <= 0 && !force {
+				confirmed, err := confirmBackupOperation(cmd, "backup.count is zero; delete all database backups?")
+				if err != nil {
+					return err
+				}
+				if !confirmed {
+					cmd.Println("Backup pruning cancelled.")
+					return nil
+				}
+			}
+			database := db.Db()
+			count, err := database.Prune(cmd.Context())
+			if err != nil {
+				return err
+			}
+			cmd.Printf("Pruned %d database backup(s).\n", count)
+			return nil
+		},
+	}
+	command.Flags().BoolVar(&force, "force", false, "skip confirmation")
+	return command
+}
+
+func newBackupRestoreCmd() *cobra.Command {
+	var backupFile string
+	var force bool
+	command := &cobra.Command{
+		Use:   "restore",
+		Short: "Restore the database from a backup",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			if !force {
+				confirmed, err := confirmBackupOperation(cmd, fmt.Sprintf("Restore the database from %q? This will replace the current database.", backupFile))
+				if err != nil {
+					return err
+				}
+				if !confirmed {
+					cmd.Println("Database restore cancelled.")
+					return nil
+				}
+			}
+			database := db.Db()
+			if err := database.Restore(cmd.Context(), backupFile); err != nil {
+				return err
+			}
+			cmd.Printf("Database restored from: %s\n", backupFile)
+			return nil
+		},
+	}
+	command.Flags().StringVar(&backupFile, "backup-file", "", "path to the database backup file")
+	command.Flags().BoolVar(&force, "force", false, "skip confirmation")
+	_ = command.MarkFlagRequired("backup-file")
+	return command
+}
+
+func confirmBackupOperation(cmd *cobra.Command, prompt string) (bool, error) {
+	if _, err := fmt.Fprintf(cmd.OutOrStdout(), "%s [y/N] ", prompt); err != nil {
+		return false, err
+	}
+	reader := bufio.NewScanner(cmd.InOrStdin())
+	if !reader.Scan() {
+		if err := reader.Err(); err != nil {
+			return false, err
+		}
+		return false, nil
+	}
+	answer := strings.TrimSpace(reader.Text())
+	return strings.EqualFold(answer, "y") || strings.EqualFold(answer, "yes"), nil
+}
