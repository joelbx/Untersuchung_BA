+def match_current_rt(rt, direction, current, rt_commands):
+    """Build a route-target command when it differs from the current config."""
+    if direction == 'both':
+        match_current_rt(rt, 'import', current, rt_commands)
+        return match_current_rt(rt, 'export', current, rt_commands)
+
+    command = 'route-target {0} {1}'.format(direction, rt['rt'])
+    current_commands = [line.strip() for line in current.splitlines()]
+
+    if rt['state'] == 'present':
+        if command not in current_commands and command not in rt_commands:
+            rt_commands.append(command)
+    elif command in current_commands:
+        remove_command = 'no {0}'.format(command)
+        if remove_command not in rt_commands:
+            rt_commands.append(remove_command)
+
+    return rt_commands
+
+
