diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..a310887
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,55 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+function isValidChatList(value) {
+	if (typeof value === 'string') {
+		try {
+			value = JSON.parse(value);
+		} catch (err) {
+			return false;
+		}
+	}
+	return Array.isArray(value) && value.every((uid) => {
+		return typeof uid === 'string' || (typeof uid === 'number' && Number.isFinite(uid));
+	});
+}
+
+module.exports = {
+	name: 'Migrate legacy chat restrictions to allow lists',
+	timestamp: Date.UTC(2025, 4, 1),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settingKeys = uids.map(uid => `user:${uid}:settings`);
+			const [settings, following, followingRemote] = await Promise.all([
+				db.getObjects(settingKeys),
+				db.getSortedSetsMembers(uids.map(uid => `following:${uid}`)),
+				db.getSortedSetsMembers(uids.map(uid => `followingRemote:${uid}`)),
+			]);
+			const bulkSet = [];
+
+			settings.forEach((userSettings, index) => {
+				if (
+					!userSettings ||
+					parseInt(userSettings.restrictChat, 10) !== 1 ||
+					isValidChatList(userSettings.chatAllowList)
+				) {
+					return;
+				}
+
+				const uids = [...(following[index] || []), ...(followingRemote[index] || [])];
+				const chatAllowList = Array.from(new Set(uids.map(String)));
+				bulkSet.push([settingKeys[index], { chatAllowList: JSON.stringify(chatAllowList) }]);
+			});
+
+			await db.setObjectBulk(bulkSet);
+			progress.incr(uids.length);
+		}, {
+			batch: 500,
+		});
+	},
+};
