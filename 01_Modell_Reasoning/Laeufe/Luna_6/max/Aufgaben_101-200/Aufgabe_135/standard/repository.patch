+    def test_min_case_sensitive(self):
+        assert ms.min(env, ['a', 'B'], case_sensitive=True) == 'B'
+
+    def test_min_without_enhanced_jinja_filter(self, monkeypatch):
+        monkeypatch.setattr(ms, 'HAS_MIN', False)
+        assert ms.min(env, (2, 1)) == 1
+
+        message = "Ansible's min filter does not support any keyword arguments. You need Jinja2 2.10 or later that provides their version of the filter."
+        with pytest.raises(AnsibleFilterError) as err:
+            ms.min(env, [{'value': 1}], attribute='value')
+        assert err.value.message == message
 
 
