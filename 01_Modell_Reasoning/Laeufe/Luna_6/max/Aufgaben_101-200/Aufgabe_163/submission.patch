+		}
+		if strings.TrimSpace(d.Name) == "" {
+			return errors.New("db.name is required when db.url is not set")
+		}
+	default:
+		if d.Protocol == DatabaseProtocolUnknown {
+			return errors.New("db.protocol is required when db.url is not set")
+		}
+		return fmt.Errorf("db.protocol has invalid value %d; expected one of sqlite, postgres, mysql", d.Protocol)
+	}
+
+	if d.Port < 0 || d.Port > 65535 {
+		return fmt.Errorf("db.port must be between 1 and 65535 when set; got %d", d.Port)
+	}
