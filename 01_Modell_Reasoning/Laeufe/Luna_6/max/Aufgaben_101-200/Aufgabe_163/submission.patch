+					secrets = append(secrets, password, stdurl.QueryEscape(password))
+				}
+			}
+			for key, values := range parsed.Query() {
+				if isSecretKey(key) {
+					secrets = append(secrets, values...)
+				}
+			}
+		}
+	}
