+
+// ParseDatabaseProtocol parses a database protocol setting.
+func ParseDatabaseProtocol(value string) (DatabaseProtocol, error) {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "sqlite":
+		return DatabaseProtocolSQLite, nil
+	case "postgres":
+		return DatabaseProtocolPostgres, nil
+	case "mysql":
+		return DatabaseProtocolMySQL, nil
+	default:
+		return DatabaseProtocolUnknown, fmt.Errorf("db.protocol has invalid value %q; expected one of sqlite, postgres, mysql", value)
+	}
