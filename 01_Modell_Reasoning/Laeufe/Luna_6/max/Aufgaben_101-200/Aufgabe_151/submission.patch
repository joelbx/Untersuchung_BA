+def extra_suffixes_workaround(upstream_mimetypes: Iterable[str]) -> Set[str]:
+    """Return file suffixes missing from Qt's MIME type handling.
+
+    Qt versions from 6.2.3 up to (but not including) 6.7.0 can omit filename
+    extensions when building file picker filters from MIME types.
+    """
+    if (not qtutils.version_check("6.2.3", compiled=False) or
+            qtutils.version_check("6.7.0", compiled=False)):
+        return set()
+
+    upstream_mimetypes = list(upstream_mimetypes)
+    existing_suffixes = {
+        mime_type for mime_type in upstream_mimetypes
+        if mime_type.startswith(".")
+    }
+    extra_suffixes = set()
+
+    for mime_type in upstream_mimetypes:
+        if mime_type.endswith("/*"):
+            mime_prefix = mime_type[:-1]
+            extra_suffixes.update(
+                suffix for suffix, mapped_mime_type in mimetypes.types_map.items()
+                if mapped_mime_type.startswith(mime_prefix)
+            )
+        elif "/" in mime_type:
+            extra_suffixes.update(mimetypes.guess_all_extensions(mime_type))
+
+    return extra_suffixes - existing_suffixes
 
 
