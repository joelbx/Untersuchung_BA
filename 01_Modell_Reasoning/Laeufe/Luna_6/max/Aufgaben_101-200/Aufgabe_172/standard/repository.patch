+// NewPortStat parses an IP:port value into a PortStat.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	if ipPort == "" {
+		return &PortStat{}, nil
+	}
+
+	address, port, err := net.SplitHostPort(ipPort)
+	if err != nil {
+		return nil, fmt.Errorf("invalid IP:port %q: %w", ipPort, err)
+	}
+	if strings.HasPrefix(ipPort, "[") && !strings.Contains(address, ":") {
+		return nil, fmt.Errorf("brackets are only valid for IPv6 addresses in %q", ipPort)
+	}
+	if address != "*" {
+		ip := net.ParseIP(address)
+		if ip == nil {
+			return nil, fmt.Errorf("invalid IP address %q in %q", address, ipPort)
+		}
+	}
+	if port == "" {
+		return nil, fmt.Errorf("missing port in %q", ipPort)
+	}
+	if strings.Trim(port, "0123456789") != "" {
+		return nil, fmt.Errorf("invalid port in %q", ipPort)
+	}
+	if _, err := strconv.ParseUint(port, 10, 16); err != nil {
+		return nil, fmt.Errorf("invalid port in %q: %w", ipPort, err)
+	}
+
+	bindAddress := address
+	if strings.Contains(address, ":") {
+		bindAddress = "[" + address + "]"
+	}
+	return &PortStat{BindAddress: bindAddress, Port: port}, nil
+}
