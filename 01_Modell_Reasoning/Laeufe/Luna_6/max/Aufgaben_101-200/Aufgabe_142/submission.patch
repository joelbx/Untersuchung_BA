+func newRegexpMatcher(raw string, escape bool) (*regexpMatcher, error) {
+	if escape && (!strings.HasPrefix(raw, "^") || !strings.HasSuffix(raw, "$")) {
+		raw = globPattern(raw)
 	}
+	re, err := compileRegexp(raw)
+	if err != nil {
+		return nil, err
+	}
+	return &regexpMatcher{re: re}, nil
