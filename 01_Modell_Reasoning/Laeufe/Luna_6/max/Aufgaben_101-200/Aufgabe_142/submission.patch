+func TestExpressionASTInterpolation(t *testing.T) {
+	tests := []struct {
+		name    string
+		input   string
+		traits  map[string][]string
+		want    []string
+		wantErr error
+	}{
+		{
+			name:   "nested email and regexp functions",
+			input:  `{{regexp.replace(email.local(external.email), "ali", "x")}}`,
+			traits: map[string][]string{"email": {"Alice <alice@example.com>", "bob@example.com"}},
+			want:   []string{"xce"},
+		},
+		{
+			name:  "constant source expression",
+			input: `{{regexp.replace("prefix-value", "^prefix-", "")}}`,
+			want:  []string{"value"},
+		},
+		{
+			name:  "closing delimiter inside a string literal",
+			input: `{{regexp.replace("foo}}", "}", "x")}}`,
+			want:  []string{"fooxx"},
+		},
+		{
+			name:  "replacement filters values without a match",
+			input: `{{regexp.replace(external.values, "^dev-", "")}}`,
+			traits: map[string][]string{
+				"values": {"dev-alice", "prod-bob"},
+			},
+			want: []string{"alice"},
+		},
+		{
+			name:  "all replacement values filtered",
+			input: `{{regexp.replace(external.values, "^dev-", "")}}`,
+			traits: map[string][]string{
+				"values": {"prod-bob"},
+			},
+			wantErr: trace.NotFound(""),
+		},
+		{
+			name:  "empty replacement does not fabricate a prefix and suffix",
+			input: `pre-{{regexp.replace(external.values, "^dev-", "")}}-post`,
+			traits: map[string][]string{
+				"values": {"dev-"},
+			},
+			wantErr: trace.NotFound(""),
+		},
+		{
+			name:    "missing trait includes variable reference",
+			input:   `{{external.missing}}`,
+			wantErr: trace.NotFound(""),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			expr, err := NewExpression(tt.input)
+			require.NoError(t, err)
+			values, err := expr.Interpolate(tt.traits)
+			if tt.wantErr != nil {
+				require.IsType(t, tt.wantErr, err)
+				if tt.name == "missing trait includes variable reference" {
+					require.ErrorContains(t, err, "external.missing")
+				}
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.want, values)
+		})
+	}
+
+	expr, err := NewExpression(`{{internal.logins}}`)
+	require.NoError(t, err)
+	_, err = expr.Interpolate(map[string][]string{"logins": {"alice"}}, func(namespace, name string) error {
+		if namespace == "internal" && name != "logins" {
+			return trace.BadParameter("unsupported variable %q", name)
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	_, err = expr.Interpolate(map[string][]string{"logins": {"alice"}}, func(namespace, name string) error {
+		return trace.BadParameter("unsupported variable %q", name)
+	})
+	require.True(t, trace.IsBadParameter(err))
+}
