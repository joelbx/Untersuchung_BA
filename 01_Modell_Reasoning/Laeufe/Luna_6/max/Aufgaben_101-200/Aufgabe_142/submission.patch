+func TestExpressionDepthLimit(t *testing.T) {
+	deepSelector := "{{internal" + strings.Repeat(".name", maxExpressionDepth+1) + "}}"
+	_, err := NewExpression(deepSelector)
+	require.True(t, trace.IsBadParameter(err))
+	require.ErrorContains(t, err, "maximum nesting depth")
+
+	deepCalls := "{{" + strings.Repeat("email.local(", maxExpressionDepth+1) + `"a@example.com"` + strings.Repeat(")", maxExpressionDepth+1) + "}}"
+	_, err = NewExpression(deepCalls)
+	require.True(t, trace.IsBadParameter(err))
+	require.ErrorContains(t, err, "maximum nesting depth")
+}
