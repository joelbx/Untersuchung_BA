+package parse
+
+import (
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a parsed expression that evaluates to a string list or a boolean.
+type Expr interface {
+	String() string
+	Kind() reflect.Kind
+	Evaluate(ctx EvaluateContext) (any, error)
+}
+
+// EvaluateContext provides the values and input required to evaluate an expression.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+// StringLitExpr is a constant string expression.
+type StringLitExpr struct {
+	Value string
+}
+
+func (e *StringLitExpr) String() string     { return strconv.Quote(e.Value) }
+func (e *StringLitExpr) Kind() reflect.Kind { return reflect.String }
+func (e *StringLitExpr) Evaluate(EvaluateContext) (any, error) {
+	return []string{e.Value}, nil
+}
+
+// VarExpr refers to a name in a supported namespace.
+type VarExpr struct {
+	Namespace string
+	Name      string
+}
+
+func (e *VarExpr) String() string     { return e.Namespace + "." + e.Name }
+func (e *VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e *VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("no resolver is available for variable %q", e.String())
+	}
+	return ctx.VarValue(*e)
+}
+
+// EmailLocalExpr extracts the local part of each email address produced by Input.
+type EmailLocalExpr struct {
+	Input Expr
+}
+
+func (e *EmailLocalExpr) String() string {
+	return EmailNamespace + "." + EmailLocalFnName + "(" + e.Input.String() + ")"
+}
+func (e *EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e *EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Input, ctx, "email.local argument")
+	if err != nil {
+		return nil, err
+	}
+	locals := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("email.local cannot parse an empty address")
+		}
+		address, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("email.local could not parse address %q: %v", value, err)
+		}
+		separator := strings.LastIndexByte(address.Address, '@')
+		if separator <= 0 || separator == len(address.Address)-1 {
+			return nil, trace.BadParameter("email.local address %q has no local part", value)
+		}
+		locals = append(locals, address.Address[:separator])
+	}
+	return locals, nil
+}
+
+// RegexpReplaceExpr applies a compiled regexp replacement to each source value.
+type RegexpReplaceExpr struct {
+	Source      Expr
+	Pattern     string
+	Replacement string
+	re          *regexp.Regexp
+}
+
+func (e *RegexpReplaceExpr) String() string {
+	return RegexpNamespace + "." + RegexpReplaceFnName + "(" + e.Source.String() + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (e *RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e *RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Source, ctx, "regexp.replace source")
+	if err != nil {
+		return nil, err
+	}
+	re, err := e.compiledRegexp()
+	if err != nil {
+		return nil, err
+	}
+	result := make([]string, 0, len(values))
+	for _, value := range values {
+		// A non-matching source value is intentionally filtered out.
+		if !re.MatchString(value) {
+			continue
+		}
+		result = append(result, re.ReplaceAllString(value, e.Replacement))
+	}
+	return result, nil
+}
+
+func (e *RegexpReplaceExpr) compiledRegexp() (*regexp.Regexp, error) {
+	if e.re != nil {
+		return e.re, nil
+	}
+	return compileRegexp(e.Pattern)
+}
+
+// RegexpMatchExpr tests matcher input against a regexp.
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e *RegexpMatchExpr) String() string {
+	return RegexpNamespace + "." + RegexpMatchFnName + "(" + strconv.Quote(e.Pattern) + ")"
+}
+func (e *RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e *RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re, err := e.compiledRegexp()
+	if err != nil {
+		return nil, err
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+func (e *RegexpMatchExpr) compiledRegexp() (*regexp.Regexp, error) {
+	if e.re != nil {
+		return e.re, nil
+	}
+	return compileRegexp(e.Pattern)
+}
+
+// RegexpNotMatchExpr is the negation of a regexp predicate.
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e *RegexpNotMatchExpr) String() string {
+	return RegexpNamespace + "." + RegexpNotMatchFnName + "(" + strconv.Quote(e.Pattern) + ")"
+}
+func (e *RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e *RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re, err := e.compiledRegexp()
+	if err != nil {
+		return nil, err
+	}
+	return !re.MatchString(ctx.MatcherInput), nil
+}
+func (e *RegexpNotMatchExpr) compiledRegexp() (*regexp.Regexp, error) {
+	if e.re != nil {
+		return e.re, nil
+	}
+	return compileRegexp(e.Pattern)
+}
+
+func evaluateStrings(expr Expr, ctx EvaluateContext, position string) ([]string, error) {
+	if expr == nil {
+		return nil, trace.BadParameter("%s is missing", position)
+	}
+	if expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("%s must be a string expression, got %s", position, expr.Kind())
+	}
+	value, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	values, ok := value.([]string)
+	if !ok {
+		return nil, trace.BadParameter("%s evaluated to %T, expected []string", position, value)
+	}
+	return values, nil
+}
+
+func compileRegexp(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("invalid regexp pattern %q: %v", pattern, err)
+	}
+	return re, nil
+}
+
+// validateExpr verifies variable structure and the kinds of all supported nodes.
+func validateExpr(expr Expr) error {
+	switch node := expr.(type) {
+	case *StringLitExpr:
+		return nil
+	case *VarExpr:
+		if node.Name == "" {
+			return trace.BadParameter("incomplete variable %q: expected namespace.name or namespace[\"name\"]", node.Namespace)
+		}
+		switch node.Namespace {
+		case "internal", "external", LiteralNamespace:
+			return nil
+		default:
+			return trace.BadParameter("unsupported variable namespace %q; supported namespaces are internal, external, and literal", node.Namespace)
+		}
+	case *EmailLocalExpr:
+		if node.Input == nil || node.Input.Kind() != reflect.String {
+			return trace.BadParameter("email.local argument must be a string expression")
+		}
+		return validateExpr(node.Input)
+	case *RegexpReplaceExpr:
+		if node.Source == nil || node.Source.Kind() != reflect.String {
+			return trace.BadParameter("regexp.replace source must be a string expression")
+		}
+		if err := validateExpr(node.Source); err != nil {
+			return err
+		}
+		_, err := node.compiledRegexp()
+		return err
+	case *RegexpMatchExpr:
+		_, err := node.compiledRegexp()
+		return err
+	case *RegexpNotMatchExpr:
+		_, err := node.compiledRegexp()
+		return err
+	default:
+		return trace.BadParameter("unsupported expression node %T", expr)
+	}
+}
