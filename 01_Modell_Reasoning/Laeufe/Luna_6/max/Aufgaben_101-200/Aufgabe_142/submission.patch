+func TestMatcherExpression(t *testing.T) {
+	matcher, err := NewMatcher(`pre-{{regexp.match("value")}}-post`)
+	require.NoError(t, err)
+	require.True(t, matcher.Match("pre-a-value-b-post"))
+	require.False(t, matcher.Match("pre-a-no-b-post"))
+
+	for _, input := range []string{
+		`{{external.allowed}}`,
+		`{{regexp.match(external.allowed)}}`,
+		`{{regexp.match("x", "y")}}`,
+		`{{"not a boolean"}}`,
+	} {
+		_, err := NewMatcher(input)
+		require.True(t, trace.IsBadParameter(err), "input: %s, error: %v", input, err)
+	}
+
+	constant, err := NewExpression(`  {{ email.local("alice@example.com") }}  `)
+	require.NoError(t, err)
+	got, err := constant.Interpolate(nil)
+	require.NoError(t, err)
+	require.Equal(t, []string{"alice"}, got)
+}
