+def _have_pip_module():
+    """Return whether pip can be imported by the current interpreter."""
+    try:
+        try:
+            from importlib.util import find_spec
+        except ImportError:
+            # importlib.util was added after Python 2.7; use the older import
+            # finder when running on interpreters without it.
+            import imp
+            module_file, _, _ = imp.find_module('pip')
+            if module_file:
+                module_file.close()
+            return True
+        return find_spec('pip') is not None
+    except Exception:
