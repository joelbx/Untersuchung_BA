+def _values(value):
+    """Return a field value as a list without splitting strings into chars."""
+    if value is None:
+        return []
+    if isinstance(value, (list, tuple, set)):
+        return list(value)
+    return [value]
+
+
+def _author_records(value):
+    """Return copied author-like records from an optional list field."""
+    return [dict(author) for author in _values(value) if isinstance(author, dict)]
+
+
+def _enrich_people(records):
+    for person in records:
+        name = person.get('name') or ''
+        if not isinstance(name, str):
+            name = str(name)
+
+        date = person.get('date')
+        if not date:
+            birth_date = person.get('birth_date') or ''
+            death_date = person.get('death_date') or ''
+            if birth_date or death_date:
+                date = f'{birth_date}-{death_date}'
+
+        if date:
+            person['db_name'] = f'{name} {date}'.strip()
+        else:
+            person['db_name'] = name
+
+
+def add_db_name(rec: dict) -> None:
+    """Add a database comparison name to each author, in place."""
+    _enrich_people(_values(rec.get('authors')))
+
+
+def expand_record(rec: dict) -> dict:
+    """Build a normalized edition representation suitable for comparison.
+
+    The input may be an import record or a previously expanded edition. The
+    input and its author records are left unchanged.
+    """
+    title = rec.get('title')
+    if title:
+        full_title = str(title)
+        subtitle = rec.get('subtitle')
+        if subtitle:
+            full_title += ' ' + str(subtitle)
+    else:
+        full_title = (
+            rec.get('full_title')
+            or rec.get('normalized_title')
+            or next(iter(_values(rec.get('titles'))), '')
+            or ''
+        )
+        full_title = str(full_title)
+
+    expanded_rec = build_titles(full_title)
+    expanded_rec['isbn'] = list(
+        dict.fromkeys(
+            isbn
+            for field in ('isbn', 'isbn_10', 'isbn_13')
+            for isbn in _values(rec.get(field))
+            if isbn is not None and isbn != ''
+        )
+    )
+
+    country = rec.get('publish_country')
+    if country not in (None, '', '   ', '|||'):
+        expanded_rec['publish_country'] = country
+
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+    ):
+        if field in rec and rec[field] is not None:
+            expanded_rec[field] = rec[field]
+
+    if 'authors' in rec:
+        expanded_rec['authors'] = _author_records(rec.get('authors'))
+        add_db_name(expanded_rec)
+    if 'contribs' in rec:
+        expanded_rec['contribs'] = _author_records(rec.get('contribs'))
+        _enrich_people(expanded_rec['contribs'])
+
+    return expanded_rec
+
