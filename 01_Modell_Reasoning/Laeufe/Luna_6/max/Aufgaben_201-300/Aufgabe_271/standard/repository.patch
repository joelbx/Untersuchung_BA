+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Classify ISBN strings by length after stripping surrounding spaces.
+
+    This intentionally does no ISBN validation or normalization beyond
+    trimming whitespace. Values whose trimmed lengths are neither 10 nor 13
+    are ignored.
+    """
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    values = [isbns] if isinstance(isbns, str) else isbns
+
+    for isbn in values:
+        isbn = isbn.strip()
+        match len(isbn):
+            case 10:
+                isbn_10.append(isbn)
+            case 13:
+                isbn_13.append(isbn)
+
+    return isbn_10, isbn_13
+
