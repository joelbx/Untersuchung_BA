+
+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const ERROR_EVENTS = new Set(["error", "abort", "stalled"]);
+const DEBUG_EVENTS = new Set([
+    "loadstart",
+    "loadedmetadata",
+    "loadeddata",
+    "canplay",
+    "canplaythrough",
+    "play",
+    "playing",
+    "pause",
+    "ended",
+    "waiting",
+]);
+
+/**
+ * Handles diagnostic events from legacy call audio elements.
+ * Safe to pass directly to addEventListener.
+ */
+export function handleEvent(e: Event): void {
+    const element = (e.currentTarget || e.target) as HTMLMediaElement | null;
+    const elementId = element?.id || "(unknown)";
+
+    if (ERROR_EVENTS.has(e.type)) {
+        logger.error("Legacy call audio element error", {
+            elementId,
+            eventType: e.type,
+            error: element?.error,
+        });
+    } else if (DEBUG_EVENTS.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug(`Legacy call audio element ${elementId}: ${e.type}`);
+    }
+}
