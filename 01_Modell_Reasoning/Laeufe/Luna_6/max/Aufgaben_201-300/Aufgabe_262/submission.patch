+def process_cover_url(
+    edition: dict[str, Any],
+    allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS,
+) -> tuple[str | None, dict[str, Any]]:
+    """Remove and return an edition cover URL when its host is allowed."""
+    cover_url = edition.pop('cover', None)
+    if not isinstance(cover_url, str):
+        return None, edition
+
+    try:
+        parsed_url = urlsplit(cover_url)
+        host = parsed_url.hostname
+    except ValueError:
+        return None, edition
+
+    if parsed_url.scheme.lower() not in {'http', 'https'} or not host:
+        return None, edition
+
+    allowed_hosts = {allowed_host.casefold() for allowed_host in allowed_cover_hosts}
+    if host.casefold() in allowed_hosts:
+        return cover_url, edition
+    return None, edition
+
