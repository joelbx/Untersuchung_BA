new file mode 100644
index 0000000..9b24507
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,62 @@
+package release
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the version currently running and the latest published
+// release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Check looks up the latest published release and compares it with version.
+// A lookup or parsing error is returned to the caller, but does not need to
+// prevent the application from starting.
+func Check(ctx context.Context, version string) (Info, error) {
+	info := Info{CurrentVersion: version}
+	checkError := func(err error) (Info, error) {
+		zap.L().Warn("checking for updates", zap.Error(err))
+		return info, err
+	}
+
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return checkError(fmt.Errorf("parsing current version: %w", err))
+	}
+
+	client := github.NewClient(nil)
+	release, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return checkError(fmt.Errorf("getting latest release: %w", err))
+	}
+
+	latest, err := semver.ParseTolerant(release.GetTagName())
+	if err != nil {
+		return checkError(fmt.Errorf("parsing latest version: %w", err))
+	}
+
+	info.LatestVersion = latest.String()
+	info.LatestVersionURL = release.GetHTMLURL()
+	info.UpdateAvailable = current.Compare(latest) < 0
+	return info, nil
+}
+
+// Is reports whether version is a proper release rather than a development,
+// snapshot, release-candidate, or other pre-release build.
+func Is(version string) bool {
+	parsed, err := semver.ParseTolerant(version)
+	if err != nil {
+		return false
+	}
+
+	return len(parsed.Pre) == 0
+}
