+	case uint16:
+		return &dynamodb.AttributeValue{N: aws.String(strconv.FormatUint(uint64(value), 10))}, nil
+	case uint32:
+		return &dynamodb.AttributeValue{N: aws.String(strconv.FormatUint(uint64(value), 10))}, nil
+	case uint64:
+		return &dynamodb.AttributeValue{N: aws.String(strconv.FormatUint(value, 10))}, nil
+	case map[string]interface{}:
+		attribute := &dynamodb.AttributeValue{M: make(map[string]*dynamodb.AttributeValue, len(value))}
+		for key, nested := range value {
+			encoded, err := marshalFieldValue(nested)
+			if err != nil {
+				return nil, trace.WrapWithMessage(err, "failed to encode nested event field %q", key)
+			}
+			attribute.M[key] = encoded
+		}
+		return attribute, nil
+	case []interface{}:
+		attribute := &dynamodb.AttributeValue{L: make([]*dynamodb.AttributeValue, len(value))}
+		for i, nested := range value {
+			encoded, err := marshalFieldValue(nested)
+			if err != nil {
+				return nil, trace.WrapWithMessage(err, "failed to encode event field list item %d", i)
+			}
+			attribute.L[i] = encoded
+		}
+		return attribute, nil
+	default:
+		return nil, fmt.Errorf("unsupported event field type %T", value)
+	}
+}
