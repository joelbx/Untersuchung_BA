+func (l *Log) migrateFieldsMapWithLock(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		return l.migrateFieldsMap(ctx)
+	})
+}
+
+// migrateFieldsMap converts legacy JSON event metadata into native DynamoDB
+// maps. The cursor is saved only after every write in the scanned page has
+// completed, so a failed or interrupted page can safely be retried.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	checkpoint, err := l.getFieldsMapMigrationCheckpoint(ctx)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if checkpoint.Complete {
+		l.Debug("DynamoDB FieldsMap migration is already complete.")
+		return nil
+	}
+
+	l.Info("Starting DynamoDB event FieldsMap migration.")
+	startKey := checkpoint.LastEvaluatedKey
+	for {
+		if err := ctx.Err(); err != nil {
+			return trace.Wrap(err)
+		}
+
+		scanOut, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			ExclusiveStartKey: startKey,
+			ConsistentRead:    aws.Bool(true),
+			Limit:             aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+			TableName:         aws.String(l.Tablename),
+			FilterExpression:  aws.String("attribute_exists(#fields) AND attribute_not_exists(#fieldsMap)"),
+			ExpressionAttributeNames: map[string]*string{
+				"#fields":    aws.String(keyFields),
+				"#fieldsMap": aws.String(keyFieldsMap),
+			},
+		})
+		if err != nil {
+			l.WithError(err).Error("Failed to scan DynamoDB events for FieldsMap migration.")
+			return trace.Wrap(convertError(err))
+		}
+
+		writeRequests := make([]*dynamodb.WriteRequest, 0, len(scanOut.Items))
+		for _, item := range scanOut.Items {
+			if err := convertLegacyFields(item); err != nil {
+				recordFields := log.Fields{}
+				if value := item[keySessionID]; value != nil {
+					recordFields[keySessionID] = aws.StringValue(value.S)
+				}
+				if value := item[keyEventIndex]; value != nil {
+					recordFields[keyEventIndex] = aws.StringValue(value.N)
+				}
+				l.WithFields(recordFields).WithError(err).Error("Failed to convert legacy DynamoDB event Fields to FieldsMap.")
+				return trace.WrapWithMessage(err, "failed to convert legacy DynamoDB event fields")
+			}
+			writeRequests = append(writeRequests, &dynamodb.WriteRequest{
+				PutRequest: &dynamodb.PutRequest{Item: item},
+			})
+		}
+
+		if err := l.uploadMigrationBatches(ctx, writeRequests); err != nil {
+			l.WithError(err).WithField("events", len(writeRequests)).Error("Failed to write DynamoDB FieldsMap migration batch.")
+			return trace.Wrap(err)
+		}
+
+		checkpoint.Processed += int64(len(writeRequests))
+		checkpoint.LastEvaluatedKey = scanOut.LastEvaluatedKey
+		if scanOut.LastEvaluatedKey == nil {
+			checkpoint.Complete = true
+		}
+		if err := l.putFieldsMapMigrationCheckpoint(ctx, checkpoint); err != nil {
+			l.WithError(err).Error("Failed to save DynamoDB FieldsMap migration checkpoint.")
+			return trace.Wrap(err)
+		}
+
+		l.WithFields(log.Fields{
+			"batch_events": len(writeRequests),
+			"total_events": checkpoint.Processed,
+			"complete":     checkpoint.Complete,
+		}).Info("DynamoDB FieldsMap migration progress.")
+
+		if checkpoint.Complete {
+			return nil
+		}
+		startKey = checkpoint.LastEvaluatedKey
+	}
+}
+
+func (l *Log) getFieldsMapMigrationCheckpoint(ctx context.Context) (fieldsMapMigrationCheckpoint, error) {
+	item, err := l.backend.Get(ctx, backend.FlagKey("dynamoEvents", l.Tablename, "fieldsMapMigration"))
+	if err != nil {
+		if trace.IsNotFound(err) {
+			return fieldsMapMigrationCheckpoint{}, nil
+		}
+		return fieldsMapMigrationCheckpoint{}, trace.Wrap(err)
+	}
+	var checkpoint fieldsMapMigrationCheckpoint
+	if err := json.Unmarshal(item.Value, &checkpoint); err != nil {
+		return fieldsMapMigrationCheckpoint{}, trace.WrapWithMessage(err, "failed to decode FieldsMap migration checkpoint")
+	}
+	return checkpoint, nil
+}
+
+func (l *Log) putFieldsMapMigrationCheckpoint(ctx context.Context, checkpoint fieldsMapMigrationCheckpoint) error {
+	value, err := json.Marshal(checkpoint)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	_, err = l.backend.Put(ctx, backend.Item{
+		Key:   backend.FlagKey("dynamoEvents", l.Tablename, "fieldsMapMigration"),
+		Value: value,
+	})
+	return trace.Wrap(err)
+}
+
+func (l *Log) uploadMigrationBatches(ctx context.Context, requests []*dynamodb.WriteRequest) error {
+	if len(requests) == 0 {
+		return nil
+	}
+	batches := make([][]*dynamodb.WriteRequest, 0, (len(requests)+DynamoBatchSize-1)/DynamoBatchSize)
+	for len(requests) > 0 {
+		batchSize := DynamoBatchSize
+		if len(requests) < batchSize {
+			batchSize = len(requests)
+		}
+		batches = append(batches, requests[:batchSize])
+		requests = requests[batchSize:]
+	}
+
+	workerSlots := make(chan struct{}, maxMigrationWorkers)
+	workerErrors := make(chan error, len(batches))
+	var workers sync.WaitGroup
+	for _, batch := range batches {
+		select {
+		case workerSlots <- struct{}{}:
+		case <-ctx.Done():
+			workers.Wait()
+			return trace.Wrap(ctx.Err())
+		}
+		workers.Add(1)
+		go func(batch []*dynamodb.WriteRequest) {
+			defer workers.Done()
+			defer func() { <-workerSlots }()
+			if err := l.uploadBatch(ctx, batch); err != nil {
+				records := make([]log.Fields, 0, len(batch))
+				for _, request := range batch {
+					if request.PutRequest == nil {
+						continue
+					}
+					record := log.Fields{}
+					if value := request.PutRequest.Item[keySessionID]; value != nil {
+						record[keySessionID] = aws.StringValue(value.S)
+					}
+					if value := request.PutRequest.Item[keyEventIndex]; value != nil {
+						record[keyEventIndex] = aws.StringValue(value.N)
+					}
+					records = append(records, record)
+				}
+				l.WithFields(log.Fields{"records": records}).WithError(err).Error("DynamoDB rejected a FieldsMap migration batch.")
+				workerErrors <- trace.Wrap(err)
+			}
+		}(batch)
+	}
+	workers.Wait()
+	select {
+	case err := <-workerErrors:
+		return trace.Wrap(err)
+	default:
+		return nil
+	}
+}
