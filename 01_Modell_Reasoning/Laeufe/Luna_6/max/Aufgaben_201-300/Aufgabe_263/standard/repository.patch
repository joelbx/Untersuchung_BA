+func convertLegacyFields(item map[string]*dynamodb.AttributeValue) error {
+	legacyAttribute, ok := item[keyFields]
+	if !ok {
+		return fmt.Errorf("legacy event has no %q attribute", keyFields)
+	}
+	var legacy string
+	if err := dynamodbattribute.Unmarshal(legacyAttribute, &legacy); err != nil {
+		return trace.Wrap(err)
+	}
+	fields, err := decodeFieldsJSON([]byte(legacy))
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	fieldsAttribute, err := marshalFieldsMap(fields)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	var migratedFields events.EventFields
+	if err := dynamodbattribute.Unmarshal(fieldsAttribute, &migratedFields); err != nil {
+		return trace.Wrap(err)
+	}
+	if err := validateFieldsEquivalent(fields, migratedFields); err != nil {
+		return trace.Wrap(err)
+	}
+	item[keyFieldsMap] = fieldsAttribute
+	delete(item, keyFields)
+	return nil
+}
+
+func validateFieldsEquivalent(original, migrated events.EventFields) error {
+	originalJSON, err := json.Marshal(original)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	migratedJSON, err := json.Marshal(migrated)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	var originalValue, migratedValue interface{}
+	if err := json.Unmarshal(originalJSON, &originalValue); err != nil {
+		return trace.Wrap(err)
+	}
+	if err := json.Unmarshal(migratedJSON, &migratedValue); err != nil {
+		return trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(originalValue, migratedValue) {
+		return fmt.Errorf("migrated FieldsMap does not match legacy Fields content")
+	}
+	return nil
+}
