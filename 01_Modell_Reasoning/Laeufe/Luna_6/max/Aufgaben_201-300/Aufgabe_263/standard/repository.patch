+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	fields := e.FieldsMap
+	e.FieldsMap = nil
+	encoder := dynamodbattribute.NewEncoder(func(encoder *dynamodbattribute.Encoder) {
+		encoder.EnableEmptyCollections = true
+	})
+	item, err := encoder.Encode(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields != nil {
+		fieldsAttribute, err := marshalFieldsMap(fields)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		item.M[keyFieldsMap] = fieldsAttribute
+	}
+	return item.M, nil
+}
