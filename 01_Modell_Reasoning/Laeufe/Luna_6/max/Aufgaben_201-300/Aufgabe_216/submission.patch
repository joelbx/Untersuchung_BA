+            status_code, _stdout, _stderr = self._bare_run(check_cmd, None, sudoable=False, checkrc=False)
+            if status_code == 0:
+                stop_cmd = self._build_command(ssh_executable, 'ssh', '-O', 'stop', self.host)
+                display.vvv(u'sending stop: %s' % to_text(stop_cmd))
+                status_code, _stdout, stderr = self._bare_run(stop_cmd, None, sudoable=False, checkrc=False)
+                if status_code != 0:
+                    display.warning(u"Failed to reset connection:%s" % to_text(stderr))
+            else:
+                display.vvv(u'No persistent SSH connection found for %s; skipping stop' % self.host)
+        else:
+            display.vvv(u'No persistent SSH connection found for %s; skipping stop' % self.host)
 
