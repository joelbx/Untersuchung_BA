+@pytest.mark.parametrize("lower_bound, upper_bound", [
+    (False, False),
+    (True, True),
+])
+def test_suffixes_workaround_outside_version_range(
+    monkeypatch, lower_bound, upper_bound
+):
+    results = {"6.2.3": lower_bound, "6.7.0": upper_bound}
+    checked_versions = []
+
+    def version(version, *, compiled=True):
+        assert compiled is False
+        checked_versions.append(version)
+        return results[version]
+
+    monkeypatch.setattr(qtutils, "version_check", version)
+
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == set()
+    assert checked_versions == ["6.2.3", "6.7.0"]
+
