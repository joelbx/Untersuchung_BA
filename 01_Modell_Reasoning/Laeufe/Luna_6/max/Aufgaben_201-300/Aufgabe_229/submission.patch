--- a/src/groups/cover.js
+++ b/src/groups/cover.js
@@ -1,6 +1,8 @@
 'use strict';
 
+const fs = require('fs');
 const path = require('path');
+const nconf = require('nconf');
 
 const db = require('../database');
 const image = require('../image');
@@ -62,6 +64,64 @@ module.exports = function (Groups) {
 	};
 
 	Groups.removeCover = async function (data) {
+		if (!data || typeof data.groupName !== 'string' || !data.groupName) {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const groupData = await db.getObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url']);
+		const fileStems = new Set([
+			getLocalGroupCoverFilename(groupData['cover:url']),
+			getLocalGroupCoverFilename(groupData['cover:thumb:url']),
+		].filter(Boolean).flatMap(getGroupCoverFileStems));
+		if (fileStems.size) {
+			const filesPath = path.resolve(nconf.get('upload_path'), 'files');
+			try {
+				const filenames = await fs.promises.readdir(filesPath);
+				const stemPattern = [...fileStems].map(stem => stem.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
+				const imagePattern = new RegExp(`^(?:${stemPattern})\\.(?:png|jpeg|jpg|bmp)$`, 'i');
+				const uploadPaths = filenames
+					.filter(filename => imagePattern.test(filename))
+					.map(filename => path.join(filesPath, filename));
+				await Promise.all(uploadPaths.map(file.delete));
+			} catch (err) {
+				if (err.code !== 'ENOENT') {
+					throw err;
+				}
+			}
+		}
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
 	};
+
+	function getLocalGroupCoverFilename(url) {
+		if (typeof url !== 'string') {
+			return false;
+		}
+
+		const relativePath = (nconf.get('relative_path') || '').replace(/\/+$/, '');
+		const prefixes = [...new Set([
+			`${relativePath}/assets/uploads/files/`,
+			'/assets/uploads/files/',
+		])];
+		const prefix = prefixes.find(candidate => url.startsWith(candidate));
+		if (!prefix) {
+			return false;
+		}
+
+		const filename = url.slice(prefix.length);
+		if (!filename || filename.includes('/') || filename.includes('\\') || path.basename(filename) !== filename || !/^groupCover(?:Thumb)?-.+\.(?:png|jpeg|jpg|bmp)$/i.test(filename)) {
+			return false;
+		}
+
+		const filesPath = path.resolve(nconf.get('upload_path'), 'files');
+		const uploadPath = path.resolve(filesPath, filename);
+		return path.dirname(uploadPath) === filesPath ? filename : false;
+	}
+
+	function getGroupCoverFileStems(filename) {
+		const stem = filename.slice(0, filename.lastIndexOf('.'));
+		if (/^groupCoverThumb-/i.test(stem)) {
+			return [stem, stem.replace(/^groupCoverThumb-/i, 'groupCover-')];
+		}
+		return [stem, stem.replace(/^groupCover-/i, 'groupCoverThumb-')];
+	}
 };
