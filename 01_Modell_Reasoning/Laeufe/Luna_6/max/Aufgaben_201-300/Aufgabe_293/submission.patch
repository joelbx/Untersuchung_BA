+func oci(ctx context.Context, _ *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	const (
+		bundleDir  = "/tmp/flipt-oci-bundles"
+		repository = "flipt://local/testdata:latest"
+	)
+
+	seed := base.
+		WithExec([]string{"mkdir", "-p", "/tmp/flipt-oci-config-home/flipt"}).
+		WithNewFile("/tmp/flipt-oci-config-home/flipt/config.yml", dagger.ContainerWithNewFileOpts{
+			Contents: fmt.Sprintf("storage:\n  type: oci\n  oci:\n    repository: %s\n    bundles_directory: %s\n", repository, bundleDir),
+		}).
+		WithEnvVariable("XDG_CONFIG_HOME", "/tmp/flipt-oci-config-home").
+		WithWorkdir(path.Join("/src", testdataDir)).
+		WithExec([]string{"go", "run", "go.flipt.io/flipt/cmd/flipt", "bundle", "build", repository})
+	if _, err := seed.Sync(ctx); err != nil {
+		return func() error { return err }
+	}
+
+	flipt = flipt.
+		WithDirectory(bundleDir, seed.Directory(bundleDir)).
+		WithEnvVariable("FLIPT_LOG_LEVEL", "DEBUG").
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", repository).
+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", bundleDir).
+		WithEnvVariable("UNIQUE", uuid.New().String())
+
+	return suite(ctx, "readonly", base, flipt.WithExec(nil), conf)
+}
