+func setBackendEnv(t *testing.T, namespace, replicaName string) {
+	t.Helper()
+	t.Setenv(NamespaceEnv, namespace)
+	t.Setenv(teleportReplicaNameEnv, replicaName)
+	t.Setenv(ReleaseNameEnv, "")
+}
+
+func TestNewWithClientRequiresEnvironmentVariables(t *testing.T) {
+	tests := []struct {
+		name        string
+		namespace   string
+		replicaName string
+		missingEnv  string
+	}{
+		{
+			name:        "namespace is missing",
+			replicaName: "agent-0",
+			missingEnv:  NamespaceEnv,
+		},
+		{
+			name:       "replica name is missing",
+			namespace:  "test",
+			missingEnv: teleportReplicaNameEnv,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			setBackendEnv(t, tt.namespace, tt.replicaName)
+
+			_, err := NewWithClient(fake.NewSimpleClientset())
+			require.ErrorContains(t, err, fmt.Sprintf("environment variable %q not set or empty", tt.missingEnv))
+		})
+	}
+}
+
+func TestNewWithClientReadsEnvironmentVariables(t *testing.T) {
+	setBackendEnv(t, "test", "agent-0")
+	t.Setenv(ReleaseNameEnv, "test-release")
+
+	b, err := NewWithClient(fake.NewSimpleClientset())
+	require.NoError(t, err)
+	require.Equal(t, "test", b.Namespace)
+	require.Equal(t, "agent-0-state", b.SecretName)
+	require.Equal(t, "agent-0", b.ReplicaName)
+	require.Equal(t, "test-release", b.ReleaseName)
+	require.Equal(t, "test-release", b.genSecretObject().Annotations["meta.helm.sh/release-name"])
+}
