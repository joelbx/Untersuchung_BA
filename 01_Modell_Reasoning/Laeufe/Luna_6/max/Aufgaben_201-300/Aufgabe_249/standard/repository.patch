         """If a description isn't available in the requested language default to English"""
         return self.descriptions.get(language) or self.descriptions.get('en')
 
+    def _get_wikipedia_link(self, language: str) -> tuple[str, str] | None:
+        """Return this entity's Wikipedia URL in the requested language.
+
+        Wikidata uses language-specific keys such as ``enwiki`` and ``frwiki``
+        for its Wikipedia sitelinks. If a regional locale is provided, try its
+        primary language as well.
+        """
+        requested_language = getattr(language, 'language', language)
+        requested_language = str(requested_language).replace('_', '-').lower()
+        languages = [requested_language]
+        primary_language = requested_language.split('-', maxsplit=1)[0]
+        if primary_language and primary_language not in languages:
+            languages.append(primary_language)
+        if 'en' not in languages:
+            languages.append('en')
+
+        if not isinstance(self.sitelinks, dict):
+            return None
+        for sitelink_language in languages:
+            sitelink = self.sitelinks.get(f'{sitelink_language}wiki')
+            if isinstance(sitelink, dict):
+                url = sitelink.get('url')
+                if isinstance(url, str) and url:
+                    return url, sitelink_language
+        return None
+
+    def _get_statement_values(self, property_id: str) -> list[object]:
+        """Extract valid ``value.content`` fields from a property's statements."""
+        if not isinstance(self.statements, dict):
+            return []
+
+        statements = self.statements.get(property_id)
+        if isinstance(statements, list):
+            entries = statements
+        elif isinstance(statements, dict):
+            # Be tolerant of a property containing a single statement directly.
+            entries = [statements]
+        else:
+            return []
+
+        values = []
+        for statement in entries:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if not isinstance(value, dict) or 'content' not in value:
+                continue
+            content = value['content']
+            if content is not None:
+                values.append(content)
+        return values
+
+    def get_external_profiles(self, language: str = 'en') -> list[dict]:
+        """Return Wikipedia, Wikidata, and supported identifier profiles."""
+        profiles = []
+        if wikipedia_link := self._get_wikipedia_link(language):
+            wikipedia_url, _ = wikipedia_link
+            profiles.append(
+                {
+                    'url': wikipedia_url,
+                    'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+                    'label': 'Wikipedia',
+                }
+            )
+
+        profiles.append(
+            {
+                'url': f'https://www.wikidata.org/wiki/{self.id}',
+                'icon_url': '/static/images/identifier_icons/wikidata.svg',
+                'label': 'Wikidata',
+            }
+        )
+
+        for identifier in self._get_statement_values('P1960'):
+            if not isinstance(identifier, str) or not identifier.strip():
+                continue
+            profiles.append(
+                {
+                    'url': f'https://scholar.google.com/citations?user={identifier.strip()}',
+                    'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+                    'label': 'Google Scholar',
+                }
+            )
+        return profiles
+
