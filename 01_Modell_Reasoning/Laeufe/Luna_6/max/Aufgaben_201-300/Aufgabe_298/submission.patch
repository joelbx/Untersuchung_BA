+// evictExpired removes expired items when the next known expiration is due.
+// The deadline avoids scanning the cache on every operation when all items
+// are still active.
+func (c *simpleCache[K, V]) evictExpired() {
+	c.evictionMu.Lock()
+	defer c.evictionMu.Unlock()
+
+	deadline := c.evictionDeadline.Load()
+	if deadline == nil || time.Now().Before(*deadline) {
+		return
+	}
+
+	c.data.DeleteExpired()
+
+	var nextDeadline time.Time
+	c.data.Range(func(item *ttlcache.Item[K, V]) bool {
+		expiresAt := item.ExpiresAt()
+		if !expiresAt.IsZero() && (nextDeadline.IsZero() || expiresAt.Before(nextDeadline)) {
+			nextDeadline = expiresAt
+		}
+		return true
+	})
+
+	if nextDeadline.IsZero() {
+		c.evictionDeadline.Store(nil)
+	} else {
+		c.evictionDeadline.Store(&nextDeadline)
+	}
+}
+
+func (c *simpleCache[K, V]) scheduleEviction(item *ttlcache.Item[K, V]) {
+	if item == nil {
+		return
+	}
+
+	expiresAt := item.ExpiresAt()
+	if expiresAt.IsZero() {
+		return
+	}
+
+	c.evictionMu.Lock()
+	defer c.evictionMu.Unlock()
+
+	deadline := c.evictionDeadline.Load()
+	if deadline == nil || expiresAt.Before(*deadline) {
+		c.evictionDeadline.Store(&expiresAt)
+	}
 }
