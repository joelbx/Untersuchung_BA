+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	portScan := l.ServerInfo.PortScan
+	if portScan == nil || !portScan.IsUseExternalScanner {
+		return nil, xerrors.Errorf("external port scanner is not configured")
+	}
+
+	scanOptions, err := setScanTechniques(portScan.GetScanTechniques())
+	if err != nil {
+		return nil, err
+	}
+
+	listenIPPorts := []string{}
+	for ip, ports := range scanDestIPPorts {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(strings.Trim(ip, "[]")).IsLoopback() {
+			continue
+		}
+		if len(ports) == 0 {
+			continue
+		}
+
+		args := []string{"-n", "-Pn", "-oG", "-", "-p", strings.Join(ports, ",")}
+		args = append(args, scanOptions...)
+		if portScan.SourcePort != "" {
+			args = append(args, "-g", portScan.SourcePort)
+		}
+		args = append(args, strings.Trim(ip, "[]"))
+
+		cmd := osExec.Command(portScan.ScannerBinPath, args...)
+		output, err := cmd.Output()
+		if err != nil {
+			if exitErr, ok := err.(*osExec.ExitError); ok && len(exitErr.Stderr) != 0 {
+				err = xerrors.Errorf("%w: %s", err, strings.TrimSpace(string(exitErr.Stderr)))
+			}
+			return nil, xerrors.Errorf("failed to run external port scanner %s %s: %w",
+				portScan.ScannerBinPath, formatNmapOptionsToString(args), err)
+		}
+		listenIPPorts = append(listenIPPorts, parseNmapGreppableOutput(output)...)
+	}
+
+	return listenIPPorts, nil
+}
+
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		scanCode := technique.String()
+		if scanCode == config.NotSupportTechnique.String() {
+			return nil, xerrors.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+scanCode)
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+func parseNmapGreppableOutput(output []byte) []string {
+	openPorts := []string{}
+	for _, line := range strings.Split(string(output), "\n") {
+		portsIndex := strings.Index(line, "Ports:")
+		if portsIndex == -1 {
+			continue
+		}
+		hostFields := strings.Fields(line[:portsIndex])
+		if len(hostFields) < 2 {
+			continue
+		}
+		host := strings.Trim(hostFields[1], "[]")
+		for _, portInfo := range strings.Split(line[portsIndex+len("Ports:"):], ",") {
+			fields := strings.Split(strings.TrimSpace(portInfo), "/")
+			if len(fields) < 3 || !strings.EqualFold(fields[1], "open") || !strings.EqualFold(fields[2], "tcp") {
+				continue
+			}
+			openPorts = append(openPorts, net.JoinHostPort(host, fields[0]))
+		}
+	}
+	return openPorts
+}
