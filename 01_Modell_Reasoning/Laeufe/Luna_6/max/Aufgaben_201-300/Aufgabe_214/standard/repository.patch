index 0000000..3072fda
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,205 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// PortScanConf configures an optional external port scanner.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath,omitempty" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques,omitempty" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged,omitempty" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort,omitempty" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+// ScanTechnique is an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	// NotSupportTechnique indicates an unknown or unsupported scan technique.
+	NotSupportTechnique ScanTechnique = iota
+	// TCPSYN is a TCP SYN scan (-sS).
+	TCPSYN
+	// TCPConnect is a TCP connect scan (-sT).
+	TCPConnect
+	// TCPACK is a TCP ACK scan (-sA).
+	TCPACK
+	// TCPWindow is a TCP Window scan (-sW).
+	TCPWindow
+	// TCPMaimon is a TCP Maimon scan (-sM).
+	TCPMaimon
+	// TCPNull is a TCP Null scan (-sN).
+	TCPNull
+	// TCPFIN is a TCP FIN scan (-sF).
+	TCPFIN
+	// TCPXmas is a TCP Xmas scan (-sX).
+	TCPXmas
+)
+
+// String returns the nmap scan technique code associated with the enum.
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return "NotSupportTechnique"
+	}
+}
+
+// GetScanTechniques converts configured nmap technique codes to enum values.
+// Unknown values are kept as NotSupportTechnique so Validate can report them.
+func (c *PortScanConf) GetScanTechniques() []ScanTechnique {
+	if c == nil || len(c.ScanTechniques) == 0 {
+		return []ScanTechnique{}
+	}
+
+	techniques := make([]ScanTechnique, 0, len(c.ScanTechniques))
+	hasSupportedTechnique := false
+	for _, configured := range c.ScanTechniques {
+		technique := scanTechniqueFromString(configured)
+		if technique != NotSupportTechnique {
+			hasSupportedTechnique = true
+		}
+		techniques = append(techniques, technique)
+	}
+	if !hasSupportedTechnique {
+		return []ScanTechnique{NotSupportTechnique}
+	}
+	return techniques
+}
+
+func scanTechniqueFromString(configured string) ScanTechnique {
+	switch strings.ToLower(strings.TrimSpace(configured)) {
+	case "ss":
+		return TCPSYN
+	case "st":
+		return TCPConnect
+	case "sa":
+		return TCPACK
+	case "sw":
+		return TCPWindow
+	case "sm":
+		return TCPMaimon
+	case "sn":
+		return TCPNull
+	case "sf":
+		return TCPFIN
+	case "sx":
+		return TCPXmas
+	default:
+		return NotSupportTechnique
+	}
+}
+
+// IsZero reports whether no port scan option was configured.
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+// Validate checks the external scanner settings.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+
+	var scannerExists bool
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required when portscan is configured"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q does not exist: %w", c.ScannerBinPath, err))
+	} else if info.IsDir() {
+		errs = append(errs, fmt.Errorf("scannerBinPath %q must be a file", c.ScannerBinPath))
+	} else {
+		scannerExists = true
+	}
+
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported; configure at most one scan technique"))
+	}
+	hasTCPConnect := false
+	hasNonConnectTechnique := false
+	for _, configured := range c.ScanTechniques {
+		technique := scanTechniqueFromString(configured)
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique %q", configured))
+		} else if technique == TCPConnect {
+			hasTCPConnect = true
+		} else {
+			hasNonConnectTechnique = true
+		}
+	}
+	if !c.HasPrivileged && hasNonConnectTechnique {
+		errs = append(errs, fmt.Errorf("only TCPConnect can be used when hasPrivileged is false"))
+	}
+	if c.SourcePort != "" && hasTCPConnect {
+		errs = append(errs, fmt.Errorf("sourcePort cannot be used with TCPConnect scan technique"))
+	}
+
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort %q must be an integer between 0 and 65535", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort 0 is not allowed; use a port between 1 and 65535"))
+		}
+	}
+
+	if c.HasPrivileged && os.Geteuid() != 0 && scannerExists {
+		if err := validateScannerCapabilities(c.ScannerBinPath); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errs
+}
+
+var capabilityExpression = regexp.MustCompile(`^(cap_[a-z0-9_]+(?:,cap_[a-z0-9_]+)*)(?:=|\+)([eip-]+)$`)
+
+func validateScannerCapabilities(scannerPath string) error {
+	output, err := exec.Command("getcap", scannerPath).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("failed to inspect capabilities for scannerBinPath %q: %w", scannerPath, err)
+	}
+	line := strings.TrimSpace(string(output))
+	if line == "" {
+		return fmt.Errorf("scannerBinPath %q has no file capabilities; expected effective and permitted cap_net_raw", scannerPath)
+	}
+	if !strings.HasPrefix(line, scannerPath) {
+		return fmt.Errorf("malformed capability data for scannerBinPath %q: %q", scannerPath, line)
+	}
+	capabilityData := strings.TrimSpace(strings.TrimPrefix(line, scannerPath))
+	match := capabilityExpression.FindStringSubmatch(capabilityData)
+	if len(match) != 3 {
+		return fmt.Errorf("malformed capability data for scannerBinPath %q: %q", scannerPath, capabilityData)
+	}
+	hasNetRaw := false
+	for _, capability := range strings.Split(match[1], ",") {
+		if capability == "cap_net_raw" {
+			hasNetRaw = true
+			break
+		}
+	}
+	if !hasNetRaw || !strings.Contains(match[2], "e") || !strings.Contains(match[2], "p") {
+		return fmt.Errorf("scannerBinPath %q must have effective and permitted cap_net_raw capability; got %q", scannerPath, capabilityData)
+	}
+	return nil
+}
