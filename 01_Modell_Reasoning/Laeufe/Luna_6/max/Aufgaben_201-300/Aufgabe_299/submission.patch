+# along with qutebrowser.  If not, see <http://www.gnu.org/licenses/>.
+
+"""Completion category which suggests filesystem paths."""
+
+import os
+import re
+import urllib.parse
+from typing import List, Optional, Tuple
+
+from PyQt5.QtCore import QAbstractTableModel, QModelIndex, QObject, Qt
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractTableModel):
+
+    """Expose favorite paths and matching filesystem entries."""
+
+    def __init__(self, name: str, parent: Optional[QObject] = None) -> None:
+        super().__init__(parent)
+        self.name = name
+        self.columns_to_filter = [0]
+        self.delete_func = None
+        self._paths: List[str] = []
+
+    def set_pattern(self, val: str) -> None:
+        """Update suggestions for a command-line path or local file URL."""
+        if not val:
+            paths = list(config.val.completion.favorite_paths)
+        else:
+            path_info = self._path_info(val)
+            paths = self._matching_paths(*path_info) if path_info else []
+
+        self.beginResetModel()
+        self._paths = paths
+        self.endResetModel()
+
+    @staticmethod
+    def _path_info(val: str) -> Optional[Tuple[str, str, Optional[str],
+                                                 Optional[str]]]:
+        """Return path, display mode, tilde prefix and expanded tilde root."""
+        if val.startswith('file:///'):
+            parsed = urllib.parse.urlsplit(val)
+            if (parsed.scheme.lower() != 'file' or parsed.netloc or
+                    parsed.query or parsed.fragment or
+                    re.search(r'%(?![0-9a-fA-F]{2})', parsed.path)):
+                return None
+            path = urllib.parse.unquote(parsed.path)
+            # On Windows, file URLs encode drive paths with a leading slash.
+            if (os.name == 'nt' and len(path) >= 3 and path[0] == '/' and
+                    path[2] == ':'):
+                path = path[1:]
+            if not os.path.isabs(path):
+                return None
+            # Normalize file URLs to paths so they yield the same suggestions
+            # as the equivalent absolute path input.
+            return path, 'path', None, None
+
+        if val.startswith('~'):
+            tilde_prefix = re.split(r'[/\\]', val, maxsplit=1)[0]
+            tilde_root = os.path.expanduser(tilde_prefix)
+            path = os.path.expanduser(val)
+            if (not os.path.isabs(tilde_root) or
+                    not os.path.isabs(path) or path == val):
+                return None
+            return path, 'tilde', tilde_prefix, tilde_root
+
+        if os.path.isabs(val):
+            return val, 'path', None, None
+        return None
+
+    @staticmethod
+    def _matching_paths(path: str, display_mode: str,
+                        tilde_prefix: Optional[str],
+                        tilde_root: Optional[str]) -> List[str]:
+        """List matching files and directories in deterministic order."""
+        # Typing exactly ~ (or ~user) is a convenient way to browse that
+        # user's home directory, just like typing the trailing slash.
+        if display_mode == 'tilde' and path == tilde_root:
+            directory = path
+            prefix = ''
+        elif path.endswith(os.sep):
+            directory = path
+            prefix = ''
+        else:
+            directory, prefix = os.path.split(path)
+            if not directory:
+                directory = os.curdir
+
+        try:
+            with os.scandir(directory) as entries:
+                matches = []
+                for entry in entries:
+                    if not entry.name.startswith(prefix):
+                        continue
+                    candidate = os.path.join(directory, entry.name)
+                    try:
+                        if entry.is_dir():
+                            candidate += os.sep
+                    except (OSError, ValueError):
+                        continue
+                    matches.append(candidate)
+        except (OSError, ValueError):
+            return []
+
+        results = []
+        for candidate in sorted(matches):
+            if (display_mode == 'tilde' and tilde_root is not None and
+                    tilde_prefix is not None):
+                if candidate == tilde_root or candidate.startswith(
+                        tilde_root.rstrip(os.sep) + os.sep):
+                    result = tilde_prefix + candidate[len(tilde_root):]
+                else:
+                    result = candidate
+            else:
+                result = candidate
+            results.append(result)
+        return results
+
+    def data(self, index: QModelIndex,
+             role: int = Qt.DisplayRole) -> Optional[str]:
+        """Return a suggested path in column zero."""
+        if (role != Qt.DisplayRole or not index.isValid() or
+                index.column() != 0 or index.row() < 0 or
+                index.row() >= len(self._paths)):
+            return None
+        return self._paths[index.row()]
+
+    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        """Return the number of path suggestions."""
+        if parent.isValid():
+            return 0
+        return len(self._paths)
+
+    def columnCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        """Return the three columns used by URL completion."""
+        if parent.isValid():
+            return 0
+        return 3
