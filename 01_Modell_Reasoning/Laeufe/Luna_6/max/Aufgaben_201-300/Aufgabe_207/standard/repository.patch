+    @pytest.mark.parametrize('cli_args', [
+        ['--qt-flag', 'enable-features=CliFeature,CliOther'],
+        ['--qt-arg', 'enable-features', 'CliFeature,CliOther'],
+    ])
+    def test_enable_features_combined(self, config_stub, monkeypatch, parser,
+                                      cli_args):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.qt.args = ['enable-features=ConfigFeature']
+        config_stub.val.scrolling.bar = 'overlay'
+
+        parsed = parser.parse_args(cli_args)
+        args = qtargs.qt_args(parsed)
+
+        feature_args = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+        assert feature_args == [
+            '--enable-features=CliFeature,CliOther,ConfigFeature,'
+            'OverlayScrollbar']
+
+    def test_empty_enable_features_are_removed(self, config_stub,
+                                               monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.qt.args = ['enable-features=']
+        config_stub.val.scrolling.bar = 'never'
+
+        args = qtargs.qt_args(parser.parse_args([]))
+
+        assert not any(arg.startswith('--enable-features=') for arg in args)
+
+    def test_enable_features_unchanged_for_other_backend(self, config_stub,
+                                                         monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebKit)
+        config_stub.val.qt.args = ['enable-features=ConfigFeature']
+
+        args = qtargs.qt_args(parser.parse_args([
+            '--qt-flag', 'enable-features=CliFeature']))
+
+        assert args == [sys.argv[0], '--enable-features=CliFeature',
+                        '--enable-features=ConfigFeature']
+
+    def test_enabled_features_split_existing_flags(self):
+        assert list(qtargs._qtwebengine_enabled_features([
+            '--enable-features=FeatureOne,FeatureTwo',
+            '--enable-features=FeatureThree'])) == [
+                'FeatureOne', 'FeatureTwo', 'FeatureThree']
