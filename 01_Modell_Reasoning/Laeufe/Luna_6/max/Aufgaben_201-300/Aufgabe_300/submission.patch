+def is_promise_item(rec: dict) -> bool:
+    """Return whether any source record identifies this as a promise item."""
+    source_records = rec.get('source_records') or []
+    if isinstance(source_records, str):
+        source_records = [source_records]
+    return any(
+        isinstance(source_record, str)
+        and source_record.casefold().startswith('promise:')
+        for source_record in source_records
+    )
