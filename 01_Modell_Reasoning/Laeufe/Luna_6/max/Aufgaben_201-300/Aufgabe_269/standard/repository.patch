+		contentType := models.NewCveContentType("trivy:" + strings.ToLower(source))
+		content := models.CveContent{
+			Type:         contentType,
+			CveID:        cveID,
+			Title:        vul.Title,
+			Summary:      vul.Description,
+			References:   refs,
+			Published:    trivyDate(vul.PublishedDate),
+			LastModified: trivyDate(vul.LastModifiedDate),
+		}
+		if severity, ok := vul.VendorSeverity[sourceID]; ok && severity != trivydbTypes.SeverityUnknown {
+			content.Cvss3Severity = strings.ToUpper(severity.String())
+		} else if len(orderedSources) == 1 {
+			content.Cvss3Severity = strings.ToUpper(vul.Severity)
+		}
+		if cvss, ok := vul.CVSS[sourceID]; ok {
+			content.Cvss2Score = cvss.V2Score
+			content.Cvss2Vector = cvss.V2Vector
+			content.Cvss3Score = cvss.V3Score
+			content.Cvss3Vector = cvss.V3Vector
+		}
+		contents[contentType] = []models.CveContent{content}
 	}
 	return contents
 }
+
+func trivyDate(date *time.Time) time.Time {
+	if date == nil {
+		return time.Time{}
+	}
+	return *date
+}
+
+func mergeLibraryCveContents(dst *models.CveContents, src models.CveContents) {
+	if *dst == nil {
+		*dst = models.CveContents{}
+	}
+	for contentType, incoming := range src {
+		if len(incoming) == 0 {
+			continue
+		}
+		current := (*dst)[contentType]
+		if len(current) == 0 {
+			(*dst)[contentType] = incoming
+			continue
+		}
+		for _, content := range incoming {
+			for i := range current {
+				if current[i].CveID != content.CveID {
+					continue
+				}
+				if current[i].Title == "" {
+					current[i].Title = content.Title
+				}
+				if current[i].Summary == "" {
+					current[i].Summary = content.Summary
+				}
+				if current[i].Cvss2Score == 0 && current[i].Cvss2Vector == "" {
+					current[i].Cvss2Score = content.Cvss2Score
+					current[i].Cvss2Vector = content.Cvss2Vector
+				}
+				if current[i].Cvss3Score == 0 && current[i].Cvss3Vector == "" {
+					current[i].Cvss3Score = content.Cvss3Score
+					current[i].Cvss3Vector = content.Cvss3Vector
+				}
+				if current[i].Cvss3Severity == "" {
+					current[i].Cvss3Severity = content.Cvss3Severity
+				}
+				if current[i].Published.IsZero() {
+					current[i].Published = content.Published
+				}
+				if content.LastModified.After(current[i].LastModified) {
+					current[i].LastModified = content.LastModified
+				}
+				for _, reference := range content.References {
+					found := false
+					for _, oldReference := range current[i].References {
+						if oldReference.Link == reference.Link && oldReference.Source == reference.Source {
+							found = true
+							break
+						}
+					}
+					if !found {
+						current[i].References = append(current[i].References, reference)
+					}
+				}
+			}
+		}
+		(*dst)[contentType] = current
+	}
+}
