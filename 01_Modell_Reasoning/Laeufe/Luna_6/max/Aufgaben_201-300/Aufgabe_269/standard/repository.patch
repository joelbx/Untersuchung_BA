+func trivyCveContents(
+	cveID, title, summary, severity, severitySource string,
+	dataSource *trivydbTypes.DataSource,
+	vendorSeverity trivydbTypes.VendorSeverity,
+	vendorCVSS trivydbTypes.VendorCVSS,
+	references models.References,
+	published, lastModified time.Time,
+) models.CveContents {
+	sources := map[string]struct{}{}
+	for source := range vendorSeverity {
+		if source != "" {
+			sources[string(source)] = struct{}{}
+		}
+	}
+	for source := range vendorCVSS {
+		if source != "" {
+			sources[string(source)] = struct{}{}
+		}
+	}
+	if severitySource != "" {
+		sources[severitySource] = struct{}{}
+	}
+	if dataSource != nil && dataSource.ID != "" {
+		sources[string(dataSource.ID)] = struct{}{}
+	}
+
+	if len(sources) == 0 {
+		return models.CveContents{
+			models.Trivy: {{
+				Type:          models.Trivy,
+				CveID:         cveID,
+				Title:         title,
+				Summary:       summary,
+				Cvss3Severity: severity,
+				References:    references,
+				Published:     published,
+				LastModified:  lastModified,
+			}},
+		}
+	}
+
+	orderedSources := make([]string, 0, len(sources))
+	for source := range sources {
+		orderedSources = append(orderedSources, source)
+	}
+	sort.Strings(orderedSources)
+
+	contents := models.CveContents{}
+	for _, source := range orderedSources {
+		sourceID := trivydbTypes.SourceID(source)
+		contentType := models.NewCveContentType("trivy:" + strings.ToLower(source))
+		content := models.CveContent{
+			Type:         contentType,
+			CveID:        cveID,
+			Title:        title,
+			Summary:      summary,
+			References:   references,
+			Published:    published,
+			LastModified: lastModified,
+		}
+		if cvss, ok := vendorCVSS[sourceID]; ok {
+			content.Cvss2Score = cvss.V2Score
+			content.Cvss2Vector = cvss.V2Vector
+			content.Cvss3Score = cvss.V3Score
+			content.Cvss3Vector = cvss.V3Vector
+		}
+		if sourceSeverity, ok := vendorSeverity[sourceID]; ok && sourceSeverity != trivydbTypes.SeverityUnknown {
+			content.Cvss3Severity = strings.ToUpper(sourceSeverity.String())
+		} else if source == severitySource || (severitySource == "" && len(orderedSources) == 1) {
+			content.Cvss3Severity = strings.ToUpper(severity)
+		}
+		contents[contentType] = []models.CveContent{content}
+	}
+	return contents
+}
+
+func mergeTrivyCveContents(dst *models.CveContents, src models.CveContents) {
+	if *dst == nil {
+		*dst = models.CveContents{}
+	}
+	for contentType, incomingContents := range src {
+		if len(incomingContents) == 0 {
+			continue
+		}
+		currentContents := (*dst)[contentType]
+		if len(currentContents) == 0 {
+			(*dst)[contentType] = incomingContents
+			continue
+		}
+
+		current := currentContents[0]
+		incoming := incomingContents[0]
+		if incoming.CveID != "" {
+			current.CveID = incoming.CveID
+		}
+		if incoming.Title != "" {
+			current.Title = incoming.Title
+		}
+		if incoming.Summary != "" {
+			current.Summary = incoming.Summary
+		}
+		if incoming.Cvss2Score != 0 || incoming.Cvss2Vector != "" {
+			current.Cvss2Score = incoming.Cvss2Score
+			current.Cvss2Vector = incoming.Cvss2Vector
+		}
+		if incoming.Cvss3Score != 0 || incoming.Cvss3Vector != "" {
+			current.Cvss3Score = incoming.Cvss3Score
+			current.Cvss3Vector = incoming.Cvss3Vector
+		}
+		if incoming.Cvss2Severity != "" {
+			current.Cvss2Severity = incoming.Cvss2Severity
+		}
+		if incoming.Cvss3Severity != "" {
+			current.Cvss3Severity = incoming.Cvss3Severity
+		}
+		if !incoming.Published.IsZero() {
+			current.Published = incoming.Published
+		}
+		if incoming.LastModified.After(current.LastModified) {
+			current.LastModified = incoming.LastModified
+		}
+		for _, reference := range incoming.References {
+			found := false
+			for _, existing := range current.References {
+				if existing.Link == reference.Link && existing.Source == reference.Source {
+					found = true
+					break
+				}
+			}
+			if !found {
+				current.References = append(current.References, reference)
+			}
+		}
+		sort.Slice(current.References, func(i, j int) bool {
+			return current.References[i].Link < current.References[j].Link
+		})
+		currentContents[0] = current
+		(*dst)[contentType] = currentContents
+	}
+}
