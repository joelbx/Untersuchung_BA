+const storeAuth = (response, password = '') => {
+  // Validate the token before persisting any session data.
+  jwtDecode(response.token)
+  localStorage.setItem('token', response.token)
+  localStorage.setItem('userId', response.id)
+  localStorage.setItem('name', response.name)
+  localStorage.setItem('username', response.username)
+  if (response.avatar) {
+    localStorage.setItem('avatar', response.avatar)
+  } else {
+    localStorage.removeItem('avatar')
+  }
+  localStorage.setItem('role', response.isAdmin ? 'admin' : 'regular')
+
+  const salt = response.subsonicSalt || generateSubsonicSalt()
+  localStorage.setItem('subsonic-salt', salt)
+  localStorage.setItem(
+    'subsonic-token',
+    response.subsonicToken || generateSubsonicToken(password, salt)
+  )
+}
+
+// serveIndex injects this only for requests authenticated by a trusted proxy.
+if (config.auth) {
+  try {
+    storeAuth(config.auth)
+    config.firstTime = false
+  } catch (e) {
+    // Ignore invalid injected auth data and leave the login screen available.
+  }
+}
