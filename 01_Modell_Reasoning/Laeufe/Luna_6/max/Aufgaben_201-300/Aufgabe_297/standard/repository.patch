+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+
+	rv := reflect.ValueOf(value)
+	switch rv.Kind() {
+	case reflect.String:
+		return re.ReplaceAllString(rv.String(), "$1[REDACTED]$2")
+	case reflect.Map:
+		if rv.IsNil() {
+			return value
+		}
+		if rv.Type().Key().Kind() == reflect.String {
+			redacted := make(map[string]interface{}, rv.Len())
+			iter := rv.MapRange()
+			for iter.Next() {
+				key := iter.Key().String()
+				if isSensitiveKey(key) || re.MatchString(key) {
+					redacted[key] = "[REDACTED]"
+				} else {
+					redacted[key] = redactValue(iter.Value().Interface(), re)
+				}
+			}
+			return redacted
+		}
+		redacted := make(map[interface{}]interface{}, rv.Len())
+		iter := rv.MapRange()
+		for iter.Next() {
+			key := iter.Key().Interface()
+			if isSensitiveKey(fmt.Sprint(key)) || re.MatchString(fmt.Sprint(key)) {
+				redacted[key] = "[REDACTED]"
+			} else {
+				redacted[key] = redactValue(iter.Value().Interface(), re)
+			}
+		}
+		return redacted
+	case reflect.Slice, reflect.Array:
+		if containsMapValue(rv) {
+			redacted := make([]interface{}, rv.Len())
+			for i := 0; i < rv.Len(); i++ {
+				redacted[i] = redactValue(rv.Index(i).Interface(), re)
+			}
+			return redacted
+		}
+	}
+
+	formatted := fmt.Sprint(value)
+	redacted := re.ReplaceAllString(formatted, "$1[REDACTED]$2")
+	if redacted != formatted {
+		return redacted
+	}
+	return value
+}
+
+func containsMapValue(value reflect.Value) bool {
+	if !value.IsValid() {
+		return false
+	}
+	if value.Kind() == reflect.Interface {
+		if value.IsNil() {
+			return false
+		}
+		return containsMapValue(value.Elem())
+	}
+	if value.Kind() == reflect.Map {
+		return true
+	}
+	if value.Kind() == reflect.Slice || value.Kind() == reflect.Array {
+		for i := 0; i < value.Len(); i++ {
+			if containsMapValue(value.Index(i)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func isSensitiveKey(key string) bool {
+	key = strings.ToLower(strings.NewReplacer("-", "", "_", "").Replace(key))
+	return strings.Contains(key, "token") ||
+		strings.Contains(key, "secret") ||
+		strings.Contains(key, "password") ||
+		strings.Contains(key, "apikey") ||
+		strings.Contains(key, "authorization") ||
+		strings.Contains(key, "credential") ||
+		strings.HasSuffix(key, "salt")
+}
