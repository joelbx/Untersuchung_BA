+// handleLoginFromHeaders authenticates a request from a trusted reverse proxy.
+// A nil result means that the request must continue without a proxy session.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+
+	now := time.Now()
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for reverse proxy login", countErr)
+			return nil
+		}
+		user = &model.User{
+			ID:          uuid.NewString(),
+			UserName:    username,
+			Name:        strings.Title(username),
+			IsAdmin:     count == 0,
+			LastLoginAt: &now,
+		}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Could not create user for reverse proxy login", "username", username, err)
+			return nil
+		}
+	} else if err != nil || user == nil {
+		log.Error(r, "Could not find user for reverse proxy login", "username", username, err)
+		return nil
+	}
+
+	user.LastLoginAt = &now
+	if err = repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update LastLoginAt for reverse proxy login", "username", user.UserName, err)
+	}
+
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create token for reverse proxy login", "username", user.UserName, err)
+		return nil
+	}
+
+	saltBytes := make([]byte, 3)
+	if _, err = rand.Read(saltBytes); err != nil {
+		log.Error(r, "Could not create Subsonic salt for reverse proxy login", err)
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	subsonicToken := fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt)))
+
+	payload := map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         token,
+		"subsonicSalt":  salt,
+		"subsonicToken": subsonicToken,
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
+
+// validateIPAgainstList matches the request's peer address against a comma-separated
+// list of IPs or CIDRs. Invalid entries are skipped. Ports are accepted and ignored,
+// since RemoteAddr contains the connected peer's source port.
+func validateIPAgainstList(remoteAddr, ipList string) bool {
+	if strings.TrimSpace(ipList) == "" {
+		return false
+	}
+
+	clientIP, isUnix := parseRemoteIP(remoteAddr)
+	for _, rawEntry := range strings.Split(ipList, ",") {
+		entry := strings.TrimSpace(rawEntry)
+		if entry == "" {
+			continue
+		}
+		if entry == "@" {
+			if isUnix {
+				return true
+			}
+			continue
+		}
+		if isUnix {
+			continue
+		}
+
+		host := entry
+		if parsedHost, _, err := net.SplitHostPort(entry); err == nil {
+			host = parsedHost
+		}
+		host = strings.Trim(host, "[]")
+		if zone := strings.LastIndexByte(host, '%'); zone >= 0 {
+			host = host[:zone]
+		}
+
+		if _, network, err := net.ParseCIDR(host); err == nil {
+			if network.Contains(clientIP) {
+				return true
+			}
+			continue
+		}
+		if allowedIP := net.ParseIP(host); allowedIP != nil && allowedIP.Equal(clientIP) {
+			return true
+		}
+	}
+	return false
+}
+
+func parseRemoteIP(remoteAddr string) (net.IP, bool) {
+	host := remoteAddr
+	if parsedHost, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		host = parsedHost
+	}
+	host = strings.Trim(host, "[]")
+	if zone := strings.LastIndexByte(host, '%'); zone >= 0 {
+		host = host[:zone]
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		return ip, false
+	}
+	return nil, true
+}
