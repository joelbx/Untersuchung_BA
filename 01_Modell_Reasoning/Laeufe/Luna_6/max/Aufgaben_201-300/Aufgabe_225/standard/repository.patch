diff --git a/detector/kev_mapping.go b/detector/kev_mapping.go
new file mode 100644
index 0000000..402a7f6
--- /dev/null
+++ b/detector/kev_mapping.go
@@ -0,0 +1,303 @@
+//go:build !scanner
+// +build !scanner
+
+package detector
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+)
+
+// decodeKEVs converts the KEV records returned by go-kev into the public
+// vulnerability model. Decoding through JSON keeps the mapping compatible
+// with feed records that add source-specific fields over time.
+func decodeKEVs(data []byte) ([]models.KEV, error) {
+	var value json.RawMessage
+	if err := json.Unmarshal(data, &value); err != nil {
+		return nil, err
+	}
+	return decodeKEVValue(value, nil, ""), nil
+}
+
+type kevRawFields map[string]json.RawMessage
+
+func decodeKEVValue(value json.RawMessage, inherited kevRawFields, forcedType models.KEVType) []models.KEV {
+	value = bytes.TrimSpace(value)
+	if len(value) == 0 || bytes.Equal(value, []byte("null")) {
+		return nil
+	}
+
+	if value[0] == '[' {
+		var values []json.RawMessage
+		if json.Unmarshal(value, &values) != nil {
+			return nil
+		}
+		var kevs []models.KEV
+		for _, item := range values {
+			kevs = append(kevs, decodeKEVValue(item, inherited, forcedType)...)
+		}
+		return kevs
+	}
+
+	var fields kevRawFields
+	if err := json.Unmarshal(value, &fields); err != nil || fields == nil {
+		return nil
+	}
+	fields = mergeKEVFields(inherited, fields)
+
+	var sourced []models.KEV
+	for _, source := range []struct {
+		key      string
+		typeName models.KEVType
+	}{
+		{key: "cisa", typeName: models.CISAKEVType},
+		{key: "vulncheck", typeName: models.VulnCheckKEVType},
+	} {
+		if raw, ok := findKEVField(fields, source.key); ok {
+			base := cloneKEVFields(fields)
+			deleteKEVField(base, "cisa")
+			deleteKEVField(base, "vulncheck")
+			sourced = append(sourced, decodeKEVSource(raw, base, source.typeName)...)
+		}
+	}
+	if len(sourced) > 0 {
+		return sourced
+	}
+
+	if raw, ok := findKEVField(fields, "sources"); ok {
+		base := cloneKEVFields(fields)
+		deleteKEVField(base, "sources")
+		if kevs := decodeKEVValue(raw, base, ""); len(kevs) > 0 {
+			return kevs
+		}
+	}
+
+	kev, ok := mapKEVFields(fields, forcedType)
+	if !ok {
+		return nil
+	}
+	return []models.KEV{kev}
+}
+
+func decodeKEVSource(value json.RawMessage, inherited kevRawFields, sourceType models.KEVType) []models.KEV {
+	value = bytes.TrimSpace(value)
+	if len(value) == 0 || bytes.Equal(value, []byte("null")) {
+		return nil
+	}
+	if value[0] == '[' {
+		var values []json.RawMessage
+		if json.Unmarshal(value, &values) != nil {
+			return nil
+		}
+		var kevs []models.KEV
+		for _, item := range values {
+			kevs = append(kevs, decodeKEVSource(item, inherited, sourceType)...)
+		}
+		return kevs
+	}
+	var fields kevRawFields
+	if err := json.Unmarshal(value, &fields); err != nil || fields == nil {
+		return nil
+	}
+	kev, ok := mapKEVFields(mergeKEVFields(inherited, fields), sourceType)
+	if !ok {
+		return nil
+	}
+	return []models.KEV{kev}
+}
+
+func mapKEVFields(fields kevRawFields, forcedType models.KEVType) (models.KEV, bool) {
+	kev := models.KEV{
+		Type:                       forcedType,
+		VendorProject:              kevString(fields, "vendorProject", "vendor"),
+		Product:                    kevString(fields, "product"),
+		VulnerabilityName:          kevString(fields, "vulnerabilityName", "name"),
+		ShortDescription:           kevString(fields, "shortDescription", "description"),
+		RequiredAction:             kevString(fields, "requiredAction"),
+		KnownRansomwareCampaignUse: kevString(fields, "knownRansomwareCampaignUse"),
+		DateAdded:                  kevDate(fields, "dateAdded"),
+	}
+	if kev.Type == "" {
+		kev.Type = sourceKEVType(kevString(fields, "type", "kevType", "source"), fields)
+	}
+	if dueDate, ok := kevDateValue(fields, "dueDate"); ok {
+		kev.DueDate = &dueDate
+	}
+
+	switch kev.Type {
+	case models.CISAKEVType:
+		kev.CISA = &models.CISAKEV{Note: kevString(fields, "note", "notes")}
+	case models.VulnCheckKEVType:
+		kev.VulnCheck = mapVulnCheckFields(fields)
+	}
+
+	hasData := kev.VendorProject != "" || kev.Product != "" || kev.VulnerabilityName != "" ||
+		kev.ShortDescription != "" || kev.RequiredAction != "" || kev.KnownRansomwareCampaignUse != "" ||
+		!kev.DateAdded.IsZero() || kev.DueDate != nil
+	if kev.CISA != nil && kev.CISA.Note != "" {
+		hasData = true
+	}
+	if kev.VulnCheck != nil && (len(kev.VulnCheck.XDB) > 0 || len(kev.VulnCheck.ReportedExploitation) > 0) {
+		hasData = true
+	}
+	return kev, hasData
+}
+
+func sourceKEVType(source string, fields kevRawFields) models.KEVType {
+	normalized := normalizeKEVKey(source)
+	switch normalized {
+	case "vulncheck", "vulncheckkev":
+		return models.VulnCheckKEVType
+	case "cisa", "cisakev", "":
+		if _, ok := findKEVField(fields, "xdb", "xdbs", "reportedExploitation", "reportedExploitations", "reportedExploits"); ok {
+			return models.VulnCheckKEVType
+		}
+		return models.CISAKEVType
+	default:
+		return models.KEVType(source)
+	}
+}
+
+func mapVulnCheckFields(fields kevRawFields) *models.VulnCheckKEV {
+	vc := &models.VulnCheckKEV{}
+	if raw, ok := findKEVField(fields, "xdb", "xdbs"); ok {
+		for _, item := range kevRawObjects(raw) {
+			vc.XDB = append(vc.XDB, models.VulnCheckXDB{
+				XDBID:       kevString(item, "xdbID", "id"),
+				XDBURL:      kevString(item, "xdbURL", "url"),
+				DateAdded:   kevDate(item, "dateAdded"),
+				ExploitType: kevString(item, "exploitType"),
+				CloneSSHURL: kevString(item, "cloneSSHURL"),
+			})
+		}
+	}
+	if raw, ok := findKEVField(fields, "reportedExploitation", "reportedExploitations", "reportedExploits"); ok {
+		for _, item := range kevRawObjects(raw) {
+			vc.ReportedExploitation = append(vc.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL:       kevString(item, "url"),
+				DateAdded: kevDate(item, "dateAdded"),
+			})
+		}
+	}
+	return vc
+}
+
+func kevRawObjects(value json.RawMessage) []kevRawFields {
+	value = bytes.TrimSpace(value)
+	if len(value) == 0 || bytes.Equal(value, []byte("null")) {
+		return nil
+	}
+	if value[0] == '[' {
+		var values []json.RawMessage
+		if json.Unmarshal(value, &values) != nil {
+			return nil
+		}
+		var objects []kevRawFields
+		for _, item := range values {
+			var fields kevRawFields
+			if json.Unmarshal(item, &fields) == nil && fields != nil {
+				objects = append(objects, fields)
+			}
+		}
+		return objects
+	}
+	var fields kevRawFields
+	if json.Unmarshal(value, &fields) == nil && fields != nil {
+		return []kevRawFields{fields}
+	}
+	return nil
+}
+
+func kevString(fields kevRawFields, keys ...string) string {
+	raw, ok := findKEVField(fields, keys...)
+	if !ok || bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+		return ""
+	}
+	var value string
+	if json.Unmarshal(raw, &value) == nil {
+		return value
+	}
+	return ""
+}
+
+func kevDate(fields kevRawFields, key string) time.Time {
+	value, ok := kevDateValue(fields, key)
+	if !ok {
+		return time.Time{}
+	}
+	return value
+}
+
+func kevDateValue(fields kevRawFields, key string) (time.Time, bool) {
+	raw, ok := findKEVField(fields, key)
+	if !ok || bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+		return time.Time{}, false
+	}
+	var value string
+	if json.Unmarshal(raw, &value) != nil || strings.TrimSpace(value) == "" {
+		return time.Time{}, false
+	}
+	for _, layout := range []string{
+		time.RFC3339Nano,
+		"2006-01-02",
+		"2006-01-02 15:04:05",
+		"2006-01-02T15:04:05",
+	} {
+		if parsed, err := time.Parse(layout, value); err == nil && !parsed.IsZero() {
+			return parsed, true
+		}
+	}
+	return time.Time{}, false
+}
+
+func findKEVField(fields kevRawFields, keys ...string) (json.RawMessage, bool) {
+	for _, key := range keys {
+		normalized := normalizeKEVKey(key)
+		for field, value := range fields {
+			if normalizeKEVKey(field) == normalized {
+				return value, true
+			}
+		}
+	}
+	return nil, false
+}
+
+func normalizeKEVKey(key string) string {
+	key = strings.ToLower(key)
+	return strings.NewReplacer("_", "", "-", "", " ", "").Replace(key)
+}
+
+func mergeKEVFields(base, additional kevRawFields) kevRawFields {
+	merged := cloneKEVFields(base)
+	if merged == nil {
+		merged = kevRawFields{}
+	}
+	for key, value := range additional {
+		merged[key] = value
+	}
+	return merged
+}
+
+func cloneKEVFields(fields kevRawFields) kevRawFields {
+	if fields == nil {
+		return nil
+	}
+	cloned := make(kevRawFields, len(fields))
+	for key, value := range fields {
+		cloned[key] = value
+	}
+	return cloned
+}
+
+func deleteKEVField(fields kevRawFields, key string) {
+	wanted := normalizeKEVKey(key)
+	for field := range fields {
+		if normalizeKEVKey(field) == wanted {
+			delete(fields, field)
+		}
+	}
+}
