+def test_install_artifact_restores_symlinks(tmp_path_factory):
+    temp_dir = to_bytes(tmp_path_factory.mktemp('collection-artifact-install'))
+    namespace_dir = os.path.join(temp_dir, b'namespace')
+    os.mkdir(namespace_dir)
+    artifact_path = os.path.join(temp_dir, b'collection.tar')
+    destination = os.path.join(namespace_dir, b'collection')
+    data = b'installed target'
+    checksum = sha256(data).hexdigest()
+    files_manifest = {
+        'files': [
+            {'name': '.', 'ftype': 'dir'},
+            {'name': 'target.txt', 'ftype': 'file', 'chksum_sha256': checksum},
+            {'name': 'file-link', 'ftype': 'file', 'chksum_sha256': checksum},
+            {'name': 'target-dir', 'ftype': 'dir'},
+            {'name': 'dir-link', 'ftype': 'dir'},
+        ],
+    }
+
+    with tarfile.open(artifact_path, 'w') as tfile:
+        for name, contents in (('MANIFEST.json', b'{}'),
+                               ('FILES.json', to_bytes(json.dumps(files_manifest))),
+                               ('target.txt', data)):
+            tar_info = tarfile.TarInfo(name)
+            tar_info.size = len(contents)
+            tfile.addfile(tar_info, BytesIO(contents))
+
+        file_link = tarfile.TarInfo('file-link')
+        file_link.type = tarfile.SYMTYPE
+        file_link.linkname = 'target.txt'
+        tfile.addfile(file_link)
+
+        target_dir = tarfile.TarInfo('target-dir')
+        target_dir.type = tarfile.DIRTYPE
+        tfile.addfile(target_dir)
+        dir_link = tarfile.TarInfo('dir-link')
+        dir_link.type = tarfile.SYMTYPE
+        dir_link.linkname = 'target-dir'
+        tfile.addfile(dir_link)
+
+    requirement = object.__new__(collection.CollectionRequirement)
+    requirement.b_path = artifact_path
+    requirement.install_artifact(destination, temp_dir)
+
+    assert os.path.islink(os.path.join(destination, b'file-link'))
+    assert os.path.islink(os.path.join(destination, b'dir-link'))
+    assert open(os.path.join(destination, b'file-link'), 'rb').read() == data
+
