+def _is_child_path(path, parent):
+    """Return whether path resolves to parent or one of its descendants."""
+    b_path = os.path.realpath(path)
+    b_parent = os.path.realpath(parent)
+    try:
+        relative_path = os.path.relpath(b_path, b_parent)
+    except ValueError:
+        # The paths are on different drives (on platforms that have drives).
+        return False
+
+    if isinstance(relative_path, six.text_type):
+        parent_path = os.path.join(os.pardir, '')
+        current_path = os.curdir
+        previous_path = os.pardir
+    else:
+        parent_path = to_bytes(os.path.join(os.pardir, ''))
+        current_path = to_bytes(os.curdir)
+        previous_path = to_bytes(os.pardir)
+
+    return relative_path == current_path or (relative_path != previous_path and
+                                               not relative_path.startswith(parent_path))
+
