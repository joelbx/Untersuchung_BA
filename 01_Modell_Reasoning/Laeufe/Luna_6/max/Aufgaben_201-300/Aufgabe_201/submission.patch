index 591ea9c..5c4ca29 100644
--- a/internal/ext/common.go
+++ b/internal/ext/common.go
@@ -1,5 +1,7 @@
 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,197 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment is implemented by the supported rule segment representations.
+type IsSegment interface {
+	isSegment()
+}
+
+// SegmentKey is the string representation of a rule segment.
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+// Segments is the object representation of a rule segment.
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+// SegmentEmbed allows rule segments to be represented as either a string or an object.
+type SegmentEmbed struct {
+	Segment IsSegment
+}
+
+// MarshalYAML serializes a segment key as a string and a group as an object.
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil || s.Segment == nil {
+		return nil, fmt.Errorf("segment is required")
+	}
+
+	switch segment := s.Segment.(type) {
+	case SegmentKey:
+		if segment == "" {
+			return nil, fmt.Errorf("segment key is required")
+		}
+		return string(segment), nil
+	case *SegmentKey:
+		if segment == nil || *segment == "" {
+			return nil, fmt.Errorf("segment key is required")
+		}
+		return string(*segment), nil
+	case Segments:
+		return segment.marshalValue()
+	case *Segments:
+		if segment == nil {
+			return nil, fmt.Errorf("segment keys are required")
+		}
+		return segment.marshalValue()
+	default:
+		return nil, fmt.Errorf("unsupported segment type %T", s.Segment)
+	}
+}
+
+// UnmarshalYAML accepts a string or an object with keys and operator fields.
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var value interface{}
+	if err := unmarshal(&value); err != nil {
+		return err
+	}
+
+	switch segment := value.(type) {
+	case string:
+		if segment == "" {
+			return fmt.Errorf("segment key is required")
+		}
+		s.Segment = SegmentKey(segment)
+		return nil
+	case map[interface{}]interface{}, map[string]interface{}:
+		fields, err := segmentObjectFields(segment)
+		if err != nil {
+			return err
+		}
+		if len(fields) != 2 || !fields["keys"] || !fields["operator"] {
+			return fmt.Errorf("segment object must contain only keys and operator")
+		}
+
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return fmt.Errorf("unmarshaling segment object: %w", err)
+		}
+		if len(segments.Keys) == 0 {
+			return fmt.Errorf("segment object must contain at least one key")
+		}
+		if err := validateSegmentKeys(segments.Keys); err != nil {
+			return err
+		}
+		if len(segments.Keys) == 1 {
+			// A single-key object has the same semantics as the string form.
+			s.Segment = SegmentKey(segments.Keys[0])
+			return nil
+		}
+		if !validSegmentOperator(segments.SegmentOperator) {
+			return fmt.Errorf("unsupported segment operator %q", segments.SegmentOperator)
+		}
+		s.Segment = segments
+		return nil
+	default:
+		return fmt.Errorf("segment must be a string or an object containing keys and operator")
+	}
+}
+
+// SegmentKeysAndOperator returns normalized segment keys and their operator.
+func (s *SegmentEmbed) SegmentKeysAndOperator() ([]string, string, error) {
+	if s == nil || s.Segment == nil {
+		return nil, "", fmt.Errorf("segment is required")
+	}
+
+	switch segment := s.Segment.(type) {
+	case SegmentKey:
+		if segment == "" {
+			return nil, "", fmt.Errorf("segment key is required")
+		}
+		return []string{string(segment)}, "OR_SEGMENT_OPERATOR", nil
+	case *SegmentKey:
+		if segment == nil || *segment == "" {
+			return nil, "", fmt.Errorf("segment key is required")
+		}
+		return []string{string(*segment)}, "OR_SEGMENT_OPERATOR", nil
+	case Segments:
+		return segment.keysAndOperator()
+	case *Segments:
+		if segment == nil {
+			return nil, "", fmt.Errorf("segment keys are required")
+		}
+		return segment.keysAndOperator()
+	default:
+		return nil, "", fmt.Errorf("unsupported segment type %T", s.Segment)
+	}
+}
+
+func (s Segments) marshalValue() (interface{}, error) {
+	keys, operator, err := s.keysAndOperator()
+	if err != nil {
+		return nil, err
+	}
+	return Segments{Keys: keys, SegmentOperator: operator}, nil
+}
+
+func (s Segments) keysAndOperator() ([]string, string, error) {
+	if err := validateSegmentKeys(s.Keys); err != nil {
+		return nil, "", err
+	}
+	if len(s.Keys) == 1 {
+		return append([]string(nil), s.Keys...), "OR_SEGMENT_OPERATOR", nil
+	}
+	if !validSegmentOperator(s.SegmentOperator) {
+		return nil, "", fmt.Errorf("unsupported segment operator %q", s.SegmentOperator)
+	}
+	return append([]string(nil), s.Keys...), s.SegmentOperator, nil
+}
+
+func validateSegmentKeys(keys []string) error {
+	for _, key := range keys {
+		if key == "" {
+			return fmt.Errorf("segment keys must not be empty")
+		}
+	}
+	return nil
+}
+
+func validSegmentOperator(operator string) bool {
+	return operator == "OR_SEGMENT_OPERATOR" || operator == "AND_SEGMENT_OPERATOR"
+}
+
+func segmentObjectFields(value interface{}) (map[string]bool, error) {
+	fields := make(map[string]bool)
+	switch object := value.(type) {
+	case map[interface{}]interface{}:
+		for key := range object {
+			name, ok := key.(string)
+			if !ok {
+				return nil, fmt.Errorf("segment object keys must be strings")
+			}
+			if name != "keys" && name != "operator" {
+				return nil, fmt.Errorf("unsupported segment object field %q", name)
+			}
+			fields[name] = true
+		}
+	case map[string]interface{}:
+		for name := range object {
+			if name != "keys" && name != "operator" {
+				return nil, fmt.Errorf("unsupported segment object field %q", name)
+			}
+			fields[name] = true
+		}
+	}
+	return fields, nil
 }
 
