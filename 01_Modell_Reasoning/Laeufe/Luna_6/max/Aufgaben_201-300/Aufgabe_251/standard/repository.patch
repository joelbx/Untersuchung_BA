+// Result contains all validation errors found in a feature file.
+type Result struct {
+	Errors []Error `json:"errors"`
+}
+
+// FeaturesValidator holds the CUE context and compiled feature schema.
+type FeaturesValidator struct {
+	cue *cue.Context
+	v   cue.Value
+}
+
+// NewFeaturesValidator compiles the embedded feature schema.
+func NewFeaturesValidator() (*FeaturesValidator, error) {
+	cctx := cuecontext.New()
+	v := cctx.CompileBytes(cueFile)
+	if err := v.Err(); err != nil {
+		return nil, err
+	}
+
+	return &FeaturesValidator{cue: cctx, v: v}, nil
+}
+
+// Validate checks YAML content and returns every validation failure with its
+// field path and source location.
+func (v *FeaturesValidator) Validate(file string, b []byte) (Result, error) {
+	f, err := yaml.Extract(file, b)
+	if err != nil {
+		return Result{Errors: validationErrors(file, err)}, ErrValidationFailed
+	}
+
+	yv := v.cue.BuildFile(f, cue.Scope(v.v))
+	err = v.v.Unify(yv).Validate()
+	if err != nil {
+		return Result{Errors: validationErrors(file, err)}, ErrValidationFailed
+	}
+
+	return Result{Errors: []Error{}}, nil
+}
