+func validationErrors(file string, err error) []Error {
+	ce := cueerror.Errors(err)
+	if len(ce) == 0 {
+		return []Error{{
+			Message:  err.Error(),
+			Location: Location{File: file},
+		}}
+	}
+
+	result := make([]Error, 0, len(ce))
+	for _, m := range ce {
+		pathParts := m.Path()
+		path := strings.Join(pathParts, ".")
+		format, args := m.Msg()
+		message := fmt.Sprintf(format, args...)
+		if message == "field not allowed" && len(pathParts) > 0 {
+			message = fmt.Sprintf("field %q is not allowed", pathParts[len(pathParts)-1])
+		}
+
+		location := Location{File: file}
+		for _, pos := range m.InputPositions() {
+			if sameFile(file, pos.Filename()) {
+				location.Line = pos.Line()
+				location.Column = pos.Column()
+				break
+			}
+		}
+
+		result = append(result, Error{
+			Path:     path,
+			Message:  message,
+			Location: location,
+		})
+	}
+
+	return result
+}
+
+func sameFile(input, position string) bool {
+	if input == position {
+		return true
+	}
+	if input == "" || position == "" {
+		return false
+	}
+
+	inputAbs, inputErr := filepath.Abs(input)
+	positionAbs, positionErr := filepath.Abs(position)
+	return inputErr == nil && positionErr == nil && filepath.Clean(inputAbs) == filepath.Clean(positionAbs)
+}
