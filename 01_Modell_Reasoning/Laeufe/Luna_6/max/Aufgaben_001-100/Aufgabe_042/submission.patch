diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..792b2dc
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,55 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+
+const wellKnown = module.exports;
+
+wellKnown.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	if (typeof resource !== 'string' || !resource.startsWith('acct:') || !hostname) {
+		return res.sendStatus(400);
+	}
+
+	const account = resource.slice('acct:'.length);
+	const atIndex = account.lastIndexOf('@');
+	if (atIndex <= 0 || account.slice(atIndex + 1).toLowerCase() !== hostname.toLowerCase()) {
+		return res.sendStatus(400);
+	}
+
+	const callerUid = req.uid || 0;
+	if (!await privileges.global.can('view:users', callerUid)) {
+		return res.sendStatus(403);
+	}
+
+	const username = account.slice(0, atIndex);
+	let uid = await user.getUidByUsername(username);
+	if (!uid) {
+		uid = await user.getUidByUserslug(username);
+	}
+	if (!uid || parseInt(uid, 10) <= 0) {
+		return res.sendStatus(404);
+	}
+
+	const userData = await user.getUserFields(uid, ['uid', 'userslug']);
+	if (!userData || parseInt(userData.uid, 10) <= 0 || !userData.userslug) {
+		return res.sendStatus(404);
+	}
+
+	const profileUrl = `${nconf.get('url')}/user/${encodeURIComponent(userData.userslug)}`;
+	res.json({
+		subject: resource,
+		aliases: [
+			`${nconf.get('url')}/uid/${userData.uid}`,
+			profileUrl,
+		],
+		links: [{
+			rel: 'http://webfinger.net/rel/profile-page',
+			type: 'text/html',
+			href: profileUrl,
+		}],
+	});
+};
