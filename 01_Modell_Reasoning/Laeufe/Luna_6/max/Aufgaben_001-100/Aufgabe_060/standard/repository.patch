+def _author_key_sort_key(author: "Author") -> tuple[int, int | str, str]:
+    """Return a stable ordering for authors, including non-OL test/import keys."""
+    key = str(author.get('key', ''))
+    olid = key.rsplit('/', 1)[-1]
+    if olid.startswith('OL') and olid.endswith('A'):
+        number = olid[2:-1]
+        if number.isdigit():
+            return (0, int(number), key)
+    return (1, key, key)
+
+
+def _resolve_author_redirect(author: "Author | None") -> "Author | None":
+    """Follow redirects and return only a valid author record."""
+    seen = set()
+    while author and author.type.key == '/type/redirect':
+        key = author['key']
+        if key in seen:
+            return None
+        seen.add(key)
+        location = author.get('location')
+        if not location or location == key:
+            return None
+        author = web.ctx.site.get(location)
+    if author and author.type.key == '/type/author':
+        return author
+    return None
+
+
+def find_author_by_key(author: dict[str, Any]) -> "Author | None":
+    """Find an author by an Open Library key supplied in the import record."""
+    key = author.get('key')
+    if isinstance(key, dict):
+        key = key.get('key')
+    if not isinstance(key, str) or not key:
+        return None
+    if key.startswith('OL') and key.endswith('A'):
+        key = f'/authors/{key}'
+    elif key.startswith('/a/'):
+        key = f"/authors/{key.rsplit('/', 1)[-1]}"
+    if not key.startswith('/'):
+        return None
+    return _resolve_author_redirect(web.ctx.site.get(key))
+
+
+def find_authors_by_remote_ids(author: dict[str, Any]) -> list["Author"]:
+    """Find authors by any supplied remote identifier, ranked by ID overlap."""
+    remote_ids = author.get('remote_ids')
+    if not isinstance(remote_ids, dict):
+        return []
+
+    matches: dict[str, tuple["Author", set[str]]] = {}
+    for identifier, value in sorted(remote_ids.items(), key=lambda item: str(item[0])):
+        if not isinstance(identifier, str) or not isinstance(value, str) or not value:
+            continue
+        query = {
+            'type': '/type/author',
+            'remote_ids': {identifier: value},
+        }
+        for key in web.ctx.site.things(query):
+            existing = _resolve_author_redirect(web.ctx.site.get(key))
+            if not existing:
+                continue
+            # Ignore approximate/index-only results. External identifiers match
+            # only when both the identifier type and value are identical.
+            if (existing.get('remote_ids') or {}).get(identifier) != value:
+                continue
+            existing_key = existing['key']
+            matches.setdefault(existing_key, (existing, set()))[1].add(identifier)
+
+    return sorted(
+        (author for author, _ in matches.values()),
+        key=lambda existing: (
+            -len(matches[existing['key']][1]),
+            _author_key_sort_key(existing),
+        ),
+    )
 
 
