+// stringToSliceHookFunc converts scalar strings to []string, splitting on
+// commas and whitespace while leaving other source and target types untouched.
+func stringToSliceHookFunc() mapstructure.DecodeHookFunc {
+	stringSliceType := reflect.TypeOf([]string(nil))
+
+	return func(from reflect.Type, to reflect.Type, data interface{}) (interface{}, error) {
+		if from.Kind() != reflect.String || to != stringSliceType {
+			return data, nil
+		}
+
+		value := reflect.ValueOf(data)
+		if !value.IsValid() || value.Kind() != reflect.String {
+			return data, nil
+		}
+
+		items := strings.Fields(strings.ReplaceAll(value.String(), ",", " "))
+		if len(items) == 0 {
+			return []string{}, nil
+		}
+
+		return items, nil
+	}
+}
