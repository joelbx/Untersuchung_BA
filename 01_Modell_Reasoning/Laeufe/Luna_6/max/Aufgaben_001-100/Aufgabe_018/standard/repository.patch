+
+func TestStringToSliceDecodeHook(t *testing.T) {
+	hook := stringToSliceHookFunc()
+	stringSlice := reflect.ValueOf([]string{})
+
+	t.Run("empty string produces empty slice", func(t *testing.T) {
+		got, err := mapstructure.DecodeHookExec(hook, reflect.ValueOf(""), stringSlice)
+		require.NoError(t, err)
+		assert.Equal(t, []string{}, got)
+		assert.NotNil(t, got)
+	})
+
+	t.Run("non-string source is unchanged", func(t *testing.T) {
+		input := []interface{}{"foo.com", "bar.com"}
+		got, err := mapstructure.DecodeHookExec(hook, reflect.ValueOf(input), stringSlice)
+		require.NoError(t, err)
+		assert.Equal(t, input, got)
+		assert.IsType(t, input, got)
+	})
+
+	t.Run("non-string slice target is unchanged", func(t *testing.T) {
+		input := "foo.com bar.com"
+		got, err := mapstructure.DecodeHookExec(hook, reflect.ValueOf(input), reflect.ValueOf([]int{}))
+		require.NoError(t, err)
+		assert.Equal(t, input, got)
+		assert.IsType(t, input, got)
+	})
+}
