-        if not any(fnmatch.fnmatch(server, pattern) for pattern in allowed_servers):
-            scheduler.remove_job(func.__name__)
+        names = {hostname, hostname.split(".", 1)[0]} if hostname else set()
+
+        def matches(pattern: str) -> bool:
+            if pattern.endswith("*"):
+                prefix = pattern[:-1]
+                return any(name.startswith(prefix) for name in names)
+            return pattern in names
+
+        if not any(matches(pattern) for pattern in allowed_hosts):
+            # With the usual decorator order, scheduled_job has registered the
+            # function immediately before this decorator runs.
+            with contextlib.suppress(JobLookupError):
+                scheduler.remove_job(func.__name__)
         return func
 
     return decorator
+
