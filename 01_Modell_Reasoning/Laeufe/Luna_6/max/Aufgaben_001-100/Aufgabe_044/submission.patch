+func filterNamespaces(namespaces []*flipt.Namespace, accessible []string) []*flipt.Namespace {
+	allowed := make(map[string]struct{}, len(accessible))
+	for _, namespace := range accessible {
+		if namespace == "*" {
+			return namespaces
+		}
+		allowed[namespace] = struct{}{}
+	}
+
+	filtered := make([]*flipt.Namespace, 0, len(allowed))
+	for _, namespace := range namespaces {
+		if _, ok := allowed[namespace.Key]; ok {
+			filtered = append(filtered, namespace)
+		}
+	}
+	return filtered
+}
+
+func namespacePageOffset(r *flipt.ListNamespaceRequest) (uint64, error) {
+	if token := r.GetPageToken(); token != "" {
+		if offset, err := strconv.ParseUint(token, 10, 64); err == nil {
+			return offset, nil
+		}
+
+		decoded, err := base64.StdEncoding.DecodeString(token)
+		if err != nil {
+			return 0, errors.ErrInvalidf("pageToken is not valid: %q", token)
+		}
+
+		var page struct {
+			Offset uint64 `json:"offset,omitempty"`
+		}
+		if err := json.Unmarshal(decoded, &page); err != nil {
+			return 0, errors.ErrInvalidf("pageToken is not valid: %q", token)
+		}
+		return page.Offset, nil
+	}
+
+	if r.GetOffset() < 0 {
+		return 0, errors.ErrInvalidf("offset must not be negative")
+	}
+	return uint64(r.GetOffset()), nil
+}
