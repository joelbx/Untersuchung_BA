 package authz
 
-import "context"
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+type contextKey string
+
+// NamespacesKey identifies the accessible namespaces attached to a request context.
+const NamespacesKey contextKey = "accessible_namespaces"
+
+// ErrNoViewableNamespacesDefined is returned when an authorization policy does not
+// define a viewable_namespaces decision.
+var ErrNoViewableNamespacesDefined = errors.New("no viewable namespaces defined")
+
+// ContextWithNamespaces stores the namespaces accessible to the current requester.
+func ContextWithNamespaces(ctx context.Context, namespaces []string) context.Context {
+	return context.WithValue(ctx, NamespacesKey, namespaces)
+}
+
+// NamespacesFromContext returns the accessible namespaces and whether they were set.
+func NamespacesFromContext(ctx context.Context) ([]string, bool) {
+	namespaces, ok := ctx.Value(NamespacesKey).([]string)
+	return namespaces, ok
+}
+
+// FormatNamespaces converts an OPA namespace decision result to a string slice.
+func FormatNamespaces(result any) ([]string, error) {
+	if result == nil {
+		return nil, ErrNoViewableNamespacesDefined
+	}
+
+	var values []any
+	switch v := result.(type) {
+	case []string:
+		formatted := make([]string, len(v))
+		for i, namespace := range v {
+			if strings.TrimSpace(namespace) == "" {
+				return nil, fmt.Errorf("invalid viewable namespace at index %d: namespace is empty", i)
+			}
+			formatted[i] = namespace
+		}
+		return uniqueNamespaces(formatted), nil
+	case []any:
+		values = v
+	default:
+		return nil, fmt.Errorf("unexpected viewable namespaces result type %T", result)
+	}
+
+	formatted := make([]string, 0, len(values))
+	for i, value := range values {
+		namespace, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("unexpected viewable namespace at index %d: expected string, got %T", i, value)
+		}
+		if strings.TrimSpace(namespace) == "" {
+			return nil, fmt.Errorf("invalid viewable namespace at index %d: namespace is empty", i)
+		}
+		formatted = append(formatted, namespace)
+	}
+
+	return uniqueNamespaces(formatted), nil
+}
+
+func uniqueNamespaces(namespaces []string) []string {
+	unique := make([]string, 0, len(namespaces))
+	seen := make(map[string]struct{}, len(namespaces))
+	for _, namespace := range namespaces {
+		if _, ok := seen[namespace]; ok {
+			continue
+		}
+		seen[namespace] = struct{}{}
+		unique = append(unique, namespace)
+	}
+	return unique
+}
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
