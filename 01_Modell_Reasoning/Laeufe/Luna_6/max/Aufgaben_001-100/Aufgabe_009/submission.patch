+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [isEditing, setIsEditing] = useState(false);
+    const [deviceName, setDeviceName] = useState(device.display_name ?? '');
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    const startEditing = (): void => {
+        setDeviceName(device.display_name ?? '');
+        setError(undefined);
+        setIsEditing(true);
+    };
+
+    const cancelEditing = (): void => {
+        setDeviceName(device.display_name ?? '');
+        setError(undefined);
+        setIsEditing(false);
+    };
+
+    const submit = async (event: React.FormEvent<HTMLFormElement>): Promise<void> => {
+        event.preventDefault();
+        setError(undefined);
+
+        if (deviceName === device.display_name) {
+            setIsEditing(false);
+            return;
+        }
+
+        setIsSaving(true);
+        try {
+            await saveDeviceName(device.device_id, deviceName);
+            setIsEditing(false);
+        } catch {
+            setError(_t('Failed to set display name.'));
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (isEditing) {
+        return <div
+            className='mx_DeviceDetailHeading mx_DeviceDetailHeading_edit'
+            data-testid='device-detail-heading-edit'
+        >
+            <form onSubmit={submit}>
+                <label htmlFor={`device-detail-name-${device.device_id}`}>
+                    { _t('Session name') }
+                </label>
+                <input
+                    id={`device-detail-name-${device.device_id}`}
+                    data-testid='device-detail-name-input'
+                    type='text'
+                    value={deviceName}
+                    maxLength={100}
+                    autoComplete='off'
+                    autoFocus
+                    onChange={event => setDeviceName(event.target.value)}
+                    disabled={isSaving}
+                />
+                <p className='mx_DeviceDetailHeading_note'>
+                    { _t('Session names may be visible to other people you communicate with.') }
+                </p>
+                { error && <p
+                    className='mx_DeviceDetailHeading_error'
+                    role='alert'
+                    data-testid='device-detail-name-error'
+                >
+                    { error }
+                </p> }
+                <div className='mx_DeviceDetailHeading_actions'>
+                    <AccessibleButton
+                        element='button'
+                        type='submit'
+                        kind='primary'
+                        disabled={isSaving}
+                        data-testid='device-detail-save'
+                        onClick={() => undefined}
+                    >
+                        { _t('Save') }
+                        { isSaving && <span data-testid='device-detail-saving-spinner'>
+                            <Spinner w={16} h={16} />
+                        </span> }
+                    </AccessibleButton>
+                    <AccessibleButton
+                        element='button'
+                        type='button'
+                        kind='link'
+                        disabled={isSaving}
+                        data-testid='device-detail-cancel'
+                        onClick={cancelEditing}
+                    >
+                        { _t('Cancel') }
+                    </AccessibleButton>
+                </div>
+            </form>
+        </div>;
+    }
+
+    return <div className='mx_DeviceDetailHeading mx_DeviceDetailHeading_read' data-testid='device-detail-heading'>
+        <Heading size='h3' data-testid='device-detail-heading-name'>
+            { device.display_name ?? device.device_id }
+        </Heading>
+        <AccessibleButton
+            kind='link_inline'
+            onClick={startEditing}
+            data-testid='device-detail-rename'
+        >
+            { _t('Rename') }
+        </AccessibleButton>
+    </div>;
+};
