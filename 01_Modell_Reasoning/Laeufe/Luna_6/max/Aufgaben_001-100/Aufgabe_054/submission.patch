+	instances      = make(map[string]interface{})
+	getOrCreateC   = make(chan *entry, 1)
+	typedInstances = struct {
+		sync.Mutex
+		instances map[reflect.Type]*typedEntry
+	}{instances: make(map[reflect.Type]*typedEntry)}
 )
 
 type entry struct {
@@ -18,6 +23,35 @@ type entry struct {
 	resultC     chan interface{}
 }
 
+type typedEntry struct {
+	once   sync.Once
+	object interface{}
+}
+
+type typedObject[T any] struct {
+	value T
+}
+
+// GetInstance returns the singleton instance for T, creating it with
+// constructor on the first call.
+func GetInstance[T any](constructor func() T) T {
+	typ := reflect.TypeOf((*T)(nil)).Elem()
+
+	typedInstances.Lock()
+	instance := typedInstances.instances[typ]
+	if instance == nil {
+		instance = &typedEntry{}
+		typedInstances.instances[typ] = instance
+	}
+	typedInstances.Unlock()
+
+	instance.once.Do(func() {
+		instance.object = typedObject[T]{value: constructor()}
+	})
+
+	return instance.object.(typedObject[T]).value
+}
+
 // Get returns an existing instance of object. If it is not yet created, calls `constructor`, stores the
 // result for future calls and return it
 func Get(object interface{}, constructor func() interface{}) interface{} {
diff --git a/utils/singleton/singleton_test.go b/utils/singleton/singleton_test.go
index 9014e4e..9f16c77 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -73,3 +73,89 @@ var _ = Describe("Get", func() {
 		Expect(numInstances).To(Equal(1))
 	})
 })
+
+var _ = Describe("GetInstance", func() {
+	type instance struct{ id int }
+
+	It("creates and reuses instances separately for value and pointer types", func() {
+		valueCreations := 0
+		value := singleton.GetInstance(func() instance {
+			valueCreations++
+			return instance{id: 1}
+		})
+		valueAgain := singleton.GetInstance(func() instance {
+			valueCreations++
+			return instance{id: 2}
+		})
+
+		Expect(valueAgain).To(Equal(value))
+		Expect(valueCreations).To(Equal(1))
+
+		pointerCreations := 0
+		pointer := singleton.GetInstance(func() *instance {
+			pointerCreations++
+			return &instance{id: 3}
+		})
+		pointerAgain := singleton.GetInstance(func() *instance {
+			pointerCreations++
+			return &instance{id: 4}
+		})
+
+		Expect(pointerAgain).To(BeIdenticalTo(pointer))
+		Expect(pointerCreations).To(Equal(1))
+		Expect(value.id).To(Equal(1))
+		Expect(pointer.id).To(Equal(3))
+	})
+
+	It("preserves a nil interface result", func() {
+		creations := 0
+		instance := singleton.GetInstance(func() any {
+			creations++
+			return nil
+		})
+		instanceAgain := singleton.GetInstance(func() any {
+			creations++
+			return "unused"
+		})
+
+		Expect(instance).To(BeNil())
+		Expect(instanceAgain).To(BeNil())
+		Expect(creations).To(Equal(1))
+	})
+
+	It("creates one instance across 20,000 concurrent calls", func() {
+		type concurrentInstance struct{}
+		const calls = 20000
+
+		var creations int32
+		start := make(chan struct{})
+		instances := make(chan *concurrentInstance, calls)
+		var done sync.WaitGroup
+		done.Add(calls)
+
+		for i := 0; i < calls; i++ {
+			go func() {
+				defer done.Done()
+				<-start
+				instances <- singleton.GetInstance(func() *concurrentInstance {
+					atomic.AddInt32(&creations, 1)
+					return &concurrentInstance{}
+				})
+			}()
+		}
+
+		close(start)
+		done.Wait()
+		close(instances)
+
+		var first *concurrentInstance
+		for current := range instances {
+			if first == nil {
+				first = current
+				continue
+			}
+			Expect(current).To(BeIdenticalTo(first))
+		}
+		Expect(atomic.LoadInt32(&creations)).To(Equal(int32(1)))
+	})
+})
