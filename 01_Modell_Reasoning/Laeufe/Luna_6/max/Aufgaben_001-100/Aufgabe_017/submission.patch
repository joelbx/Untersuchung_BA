+func TestGetDatabaseConnTester(t *testing.T) {
+	tester, err := getDatabaseConnTester(defaults.ProtocolSQLServer)
+	require.NoError(t, err)
+	require.IsType(t, &database.SQLServerPinger{}, tester)
+
+	_, err = getDatabaseConnTester("unsupported")
+	require.Error(t, err)
+}
