+// Match parses a literal, wildcard, regular expression, or matcher expression.
+// A single {{...}} expression may be surrounded by static prefix and suffix text.
+func Match(value string) (Matcher, error) {
+	prefix, expression, suffix, present, err := parseMatcherTemplate(value)
+	if err != nil {
+		return nil, err
+	}
+	if !present {
+		return matcherFromPattern(value)
+	}
+
+	node, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing matcher expression %q: %v", expression, err)
+	}
+
+	inner, err := matcherFromExpression(node, value)
+	if err != nil {
+		return nil, err
+	}
+	if prefix != "" || suffix != "" {
+		return prefixSuffixMatcher{prefix: prefix, suffix: suffix, matcher: inner}, nil
+	}
+	return inner, nil
+}
+
+func parseMatcherTemplate(value string) (prefix, expression, suffix string, present bool, err error) {
+	open := strings.Index(value, "{{")
+	closeBeforeOpen := strings.Index(value, "}}")
+	if open == -1 && closeBeforeOpen == -1 {
+		return "", "", "", false, nil
+	}
+	if open == -1 || (closeBeforeOpen != -1 && closeBeforeOpen < open) {
+		return "", "", "", false, malformedMatcherBrackets(value)
+	}
+
+	var close int
+	for i := open + 2; i < len(value); {
+		switch value[i] {
+		case '"', '\'', '`':
+			quote := value[i]
+			i++
+			for i < len(value) {
+				if quote != '`' && value[i] == '\\' {
+					i += 2
+					continue
+				}
+				if value[i] == quote {
+					i++
+					break
+				}
+				i++
+			}
+		case '{':
+			if i+1 < len(value) && value[i+1] == '{' {
+				return "", "", "", false, invalidMatcherExpression(value)
+			}
+			i++
+		case '}':
+			if i+1 < len(value) && value[i+1] == '}' {
+				close = i
+				i = len(value)
+			} else {
+				i++
+			}
+		default:
+			i++
+		}
+	}
+	if close == 0 {
+		return "", "", "", false, malformedMatcherBrackets(value)
+	}
+	if strings.Contains(value[close+2:], "{{") {
+		return "", "", "", false, invalidMatcherExpression(value)
+	}
+	if strings.Contains(value[close+2:], "}}") {
+		return "", "", "", false, malformedMatcherBrackets(value)
+	}
+	return value[:open], value[open+2 : close], value[close+2:], true, nil
+}
+
+func malformedMatcherBrackets(value string) error {
+	return trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+}
+
+func invalidMatcherExpression(value string) error {
+	return trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+}
+
+func matcherFromExpression(node ast.Expr, value string) (Matcher, error) {
+	switch n := node.(type) {
+	case *ast.BasicLit:
+		if n.Kind != token.STRING {
+			return nil, invalidMatcherExpression(value)
+		}
+		value, err := strconv.Unquote(n.Value)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing matcher string %q: %v", n.Value, err)
+		}
+		return matcherFromPattern(value)
+	case *ast.CallExpr:
+		return matcherFromCall(n)
+	default:
+		return nil, invalidMatcherExpression(value)
+	}
+}
+
+func matcherFromCall(call *ast.CallExpr) (Matcher, error) {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, trace.BadParameter("unsupported matcher function %T", call.Fun)
+	}
+	namespace, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return nil, trace.BadParameter("unsupported function namespace %v, supported namespaces are email and regexp", selector.X)
+	}
+	if namespace.Name != EmailNamespace && namespace.Name != RegexpNamespace {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+
+	fn := selector.Sel.Name
+	switch namespace.Name {
+	case RegexpNamespace:
+		if fn != RegexpMatchFnName && fn != RegexpNotMatchFnName {
+			return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match", fn)
+		}
+	case EmailNamespace:
+		if fn != EmailLocalFnName {
+			return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", fn)
+		}
+	}
+
+	function := namespace.Name + "." + fn
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("expected exactly one argument for %s, got %d", function, len(call.Args))
+	}
+	argument, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || argument.Kind != token.STRING {
+		return nil, trace.BadParameter("expected a string literal argument for %s", function)
+	}
+	pattern, err := strconv.Unquote(argument.Value)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing string argument for %s: %v", function, err)
+	}
+
+	switch function {
+	case "regexp.match", "regexp.not_match":
+		matcher, err := matcherFromRegexp(pattern)
+		if err != nil {
+			return nil, err
+		}
+		if function == "regexp.not_match" {
+			return notMatcher{matcher: matcher}, nil
+		}
+		return matcher, nil
+	case "email.local":
+		matcher, err := matcherFromPattern(pattern)
+		if err != nil {
+			return nil, err
+		}
+		return emailLocalMatcher{matcher: matcher}, nil
+	default:
+		return nil, trace.BadParameter("unsupported matcher function %s", function)
+	}
+}
+
+func matcherFromPattern(pattern string) (Matcher, error) {
+	if strings.HasPrefix(pattern, "^") && strings.HasSuffix(pattern, "$") {
+		return matcherFromRegexp(pattern)
+	}
+	return matcherFromRegexp("^" + utils.GlobToRegexp(pattern) + "$")
+}
+
+func matcherFromRegexp(expression string) (Matcher, error) {
+	re, err := regexp.Compile(expression)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", expression, err)
+	}
+	return regexpMatcher{re: re}, nil
+}
