+func containsRegexpMatcher(node ast.Node) bool {
+	found := false
+	ast.Inspect(node, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		namespace, ok := selector.X.(*ast.Ident)
+		if !ok || namespace.Name != RegexpNamespace {
+			return true
+		}
+		if selector.Sel.Name == RegexpMatchFnName || selector.Sel.Name == RegexpNotMatchFnName {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
