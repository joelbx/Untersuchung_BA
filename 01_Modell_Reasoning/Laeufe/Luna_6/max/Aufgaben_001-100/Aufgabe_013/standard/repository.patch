     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
+    _TTY_MACRO = re.compile(
+        r'(?<!\w)(?:(?P<name>[IBMUC])\((?P<value>[^)]+)\)|'
+        r'(?P<link>[LR])\((?P<label>[^,)]+?)\s*,\s*(?P<target>[^)]+)\)|'
+        r'HORIZONTALLINE(?!\w))'
+    )
+
+    @classmethod
+    def tty_ify(cls, text):
+        """Render documentation macros in a form suitable for terminal output."""
+        def replace_macro(match):
+            name = match.group('name')
+            if name:
+                value = match.group('value')
+                if name == 'I' or name == 'C':
+                    return "`%s'" % value
+                if name == 'B':
+                    return '*%s*' % value
+                if name == 'M':
+                    return '[%s]' % value
+                return value  # U()
+
+            link = match.group('link')
+            if link == 'L':
+                return '%s <%s>' % (match.group('label').strip(), match.group('target').strip())
+            if link == 'R':
+                return match.group('label').strip()
+
+            return '\n-------------\n'
+
+        return cls._TTY_MACRO.sub(replace_macro, text)
 
     def __init__(self, args):
 
