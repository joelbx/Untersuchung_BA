index 39d9646..ba4d116 100644
--- a/lib/utils/prompt/stdin.go
+++ b/lib/utils/prompt/stdin.go
@@ -19,6 +19,8 @@ package prompt
 import (
 	"os"
 	"sync"
+
+	"github.com/sirupsen/logrus"
 )
 
 var (
@@ -52,3 +54,17 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit signals the stdin prompt reader that the program is exiting.
+// Closing a ContextReader restores the terminal if a password read is active.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	closer, ok := stdin.(interface{ Close() error })
+	if !ok {
+		return
+	}
+	if err := closer.Close(); err != nil {
+		logrus.WithError(err).Warn("failed to close stdin prompt reader")
+	}
+}
