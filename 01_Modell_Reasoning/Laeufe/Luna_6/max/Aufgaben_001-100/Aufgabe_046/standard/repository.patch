+class ModuleUtilLocatorBase:
+    """Resolve a single module_utils import to source code or a redirect shim."""
+
+    _module_utils_prefix_length = 0
+    _redirect_first = False
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, child_is_redirected=False):
+        self.fq_name_parts = tuple(fq_name_parts)
+        self.is_ambiguous = is_ambiguous
+        self.child_is_redirected = child_is_redirected
+        self.candidate_fq_name_parts = self._make_candidates()
+        self.normalized_name_parts = None
+        self.resolved_fq_name_parts = None
+        self.is_package = False
+        self.found = False
+        self.is_redirected = False
+        self.source = None
+        self.source_path = None
+        self.output_path = None
+        self.redirected_child_parts = None
+
+    def _make_candidates(self):
+        candidates = [self.fq_name_parts]
+        depth = len(self.fq_name_parts) - self._module_utils_prefix_length
+        if self.is_ambiguous and depth > 1 and len(self.fq_name_parts) > self._module_utils_prefix_length:
+            candidates.append(self.fq_name_parts[:-1])
+        return candidates
+
+    def candidate_names_joined(self):
+        return ['.'.join(candidate) for candidate in self.candidate_fq_name_parts]
+
+    def _set_result(self, fq_name_parts, source, is_package, path, redirected=False):
+        self.resolved_fq_name_parts = tuple(fq_name_parts)
+        self.is_package = bool(is_package)
+        if self.is_package:
+            self.normalized_name_parts = self.resolved_fq_name_parts + ('__init__',)
+        else:
+            self.normalized_name_parts = self.resolved_fq_name_parts
+        self.source = source
+        self.source_path = path
+        self.output_path = '/'.join(self.normalized_name_parts) + '.py'
+        self.is_redirected = redirected
+        self.found = True
+
+    def _redirect_source(self, original_parts, redirect_parts):
+        original_name = '.'.join(original_parts)
+        redirect_name = '.'.join(redirect_parts)
+        source = ('import sys\n'
+                  'import {0} as mod\n'
+                  "sys.modules[{1!r}] = mod\n").format(redirect_name, original_name)
+        return _ModuleUtilSource(to_bytes(source), False, 'redirect:{0}'.format(redirect_name))
+
+    def _try_redirect(self, candidate):
+        raise NotImplementedError
+
+    def _try_local(self, candidate):
+        raise NotImplementedError
+
+    def _resolve(self):
+        for candidate in self.candidate_fq_name_parts:
+            if self._redirect_first:
+                resolved = self._try_redirect(candidate)
+                if resolved:
+                    return
+                resolved = self._try_local(candidate)
+            else:
