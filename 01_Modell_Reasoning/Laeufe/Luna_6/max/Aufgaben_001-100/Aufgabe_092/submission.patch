diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..4e218c5
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,216 @@
+---
+- name: set collection upgrade test path
+  set_fact:
+    upgrade_dir: '{{ galaxy_dir }}/upgrade/{{ test_name }}'
+
+- name: create collection upgrade test path
+  file:
+    path: '{{ upgrade_dir }}'
+    state: directory
+
+- name: install initial parent and dependency versions - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install 'upgrade_parent.parent:1.0.0'
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/ansible_collections'
+  register: upgrade_initial
+
+- name: check install without upgrade leaves installed versions alone - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install upgrade_parent.parent
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/ansible_collections'
+  register: upgrade_without_flag
+
+- name: assert install without upgrade leaves installed versions alone - {{ test_name }}
+  assert:
+    that:
+    - '"Nothing to do. All requested collections are already installed" in upgrade_without_flag.stdout'
+
+- name: reject a parent version that would change an installed dependency without upgrade - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install 'upgrade_parent.parent:2.0.0'
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/ansible_collections'
+  register: upgrade_dependency_without_flag
+  failed_when: false
+
+- name: assert dependency conflict does not modify installed collections - {{ test_name }}
+  slurp:
+    path: '{{ upgrade_dir }}/ansible_collections/{{ item }}/MANIFEST.json'
+  register: upgrade_dependency_conflict_manifests
+  loop:
+  - upgrade_parent/parent
+  - upgrade_dep/child
+
+- name: verify conflicting dependency requirements fail without changes - {{ test_name }}
+  assert:
+    that:
+    - upgrade_dependency_without_flag.rc != 0
+    - (upgrade_dependency_conflict_manifests.results[0].content | b64decode | from_json).collection_info.version == '1.0.0'
+    - (upgrade_dependency_conflict_manifests.results[1].content | b64decode | from_json).collection_info.version == '1.0.0'
+
+- name: upgrade parent and required dependency with -U - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install -U upgrade_parent.parent
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/ansible_collections'
+  register: upgrade_parent_result
+
+- name: read upgraded parent and dependency manifests - {{ test_name }}
+  slurp:
+    path: '{{ upgrade_dir }}/ansible_collections/{{ item }}/MANIFEST.json'
+  register: upgrade_parent_manifests
+  loop:
+  - upgrade_parent/parent
+  - upgrade_dep/child
+
+- name: assert upgrade updates the parent and constrained dependency - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''upgrade_parent.parent:2.0.0'' to" in upgrade_parent_result.stdout'
+    - '"Installing ''upgrade_dep.child:2.0.0'' to" in upgrade_parent_result.stdout'
+    - (upgrade_parent_manifests.results[0].content | b64decode | from_json).collection_info.version == '2.0.0'
+    - (upgrade_parent_manifests.results[1].content | b64decode | from_json).collection_info.version == '2.0.0'
+
+- name: rerun upgrade when collections are current - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade upgrade_parent.parent
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/ansible_collections'
+  register: upgrade_current
+
+- name: assert rerunning upgrade does not reinstall current versions - {{ test_name }}
+  assert:
+    that:
+    - '"Installing ''upgrade_parent.parent:" not in upgrade_current.stdout'
+    - '"Installing ''upgrade_dep.child:" not in upgrade_current.stdout'
+
+- name: install old versions for no-deps upgrade test - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install 'upgrade_parent.parent:1.0.0'
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}/no_deps'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/no_deps/ansible_collections'
+
+- name: upgrade parent without changing dependencies when --no-deps is set - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade --no-deps upgrade_parent.parent
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}/no_deps'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/no_deps/ansible_collections'
+
+- name: read no-deps upgrade manifests - {{ test_name }}
+  slurp:
+    path: '{{ upgrade_dir }}/no_deps/ansible_collections/{{ item }}/MANIFEST.json'
+  register: upgrade_no_deps_manifests
+  loop:
+  - upgrade_parent/parent
+  - upgrade_dep/child
+
+- name: assert no-deps upgrade leaves dependency unchanged - {{ test_name }}
+  assert:
+    that:
+    - (upgrade_no_deps_manifests.results[0].content | b64decode | from_json).collection_info.version == '2.0.0'
+    - (upgrade_no_deps_manifests.results[1].content | b64decode | from_json).collection_info.version == '1.0.0'
+
+- name: install initial versions for requirements-file upgrade test - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install 'namespace1.name1:1.0.0' 'upgrade_parent.parent:1.0.0'
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}/requirements'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/requirements/ansible_collections'
+
+- name: write collection upgrade requirements file - {{ test_name }}
+  copy:
+    dest: '{{ upgrade_dir }}/requirements.yml'
+    content: |
+      collections:
+      - name: namespace1.name1
+        version: '>=1.0.0,<1.1.0'
+      - upgrade_parent.parent
+
+- name: upgrade all collections in a requirements file - {{ test_name }}
+  command: >-
+    ansible-galaxy collection install --upgrade -r '{{ upgrade_dir }}/requirements.yml'
+    -s '{{ test_name }}' -p '{{ upgrade_dir }}/requirements'
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ upgrade_dir }}/requirements/ansible_collections'
+  register: upgrade_requirements_result
+
+- name: read requirements-file upgrade manifests - {{ test_name }}
+  slurp:
