+def test_collection_upgrade_candidate_selection(galaxy_server, monkeypatch, tmp_path_factory):
+    test_dir = to_bytes(tmp_path_factory.mktemp('test-ÅÑŚÌβŁÈ Collections Input'))
+    concrete_artifact_cm = collection.concrete_artifact_manager.ConcreteArtifactsManager(test_dir, validate_certs=False)
+    multi_api_proxy = collection.galaxy_api_proxy.MultiGalaxyAPIProxy([galaxy_server], concrete_artifact_cm)
+    monkeypatch.setattr(galaxy_server, 'get_collection_versions', MagicMock(return_value=['1.0.0', '2.0.0', '3.0.0']))
+
+    requested = Requirement('namespace.collection', '*', None, 'galaxy')
+    installed = Candidate('namespace.collection', '1.0.0', None, 'galaxy')
+    normal_provider = dependency_resolution.providers.CollectionDependencyProvider(
+        apis=multi_api_proxy,
+        concrete_artifacts_manager=concrete_artifact_cm,
+        user_requirements=[requested],
+        preferred_candidates=[installed],
+    )
+    upgrade_provider = dependency_resolution.providers.CollectionDependencyProvider(
+        apis=multi_api_proxy,
+        concrete_artifacts_manager=concrete_artifact_cm,
+        user_requirements=[requested],
+        preferred_candidates=[installed],
+        upgrade=True,
+    )
+
+    assert normal_provider.find_matches([requested])[0] == installed
+    assert [candidate.ver for candidate in upgrade_provider.find_matches([requested])] == ['3.0.0', '2.0.0', '1.0.0']
+
+    dependency_requirement = Requirement('namespace.collection', '>=2.0.0,<3.0.0', None, 'galaxy')
+    transitive_provider = dependency_resolution.providers.CollectionDependencyProvider(
+        apis=multi_api_proxy,
+        concrete_artifacts_manager=concrete_artifact_cm,
+        user_requirements=[Requirement('parent.collection', '*', None, 'galaxy')],
+        preferred_candidates=[installed],
+    )
+    transitive_upgrade_provider = dependency_resolution.providers.CollectionDependencyProvider(
+        apis=multi_api_proxy,
+        concrete_artifacts_manager=concrete_artifact_cm,
+        user_requirements=[Requirement('parent.collection', '*', None, 'galaxy')],
+        preferred_candidates=[installed],
+        upgrade=True,
+    )
+
+    assert transitive_provider.find_matches([dependency_requirement]) == []
+    assert [candidate.ver for candidate in transitive_upgrade_provider.find_matches(
+        [dependency_requirement]
+    )] == ['2.0.0']
+
