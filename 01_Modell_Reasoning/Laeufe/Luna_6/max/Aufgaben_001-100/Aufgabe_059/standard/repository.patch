+import {
+    forwardRef,
+    HTMLAttributes,
+    ReactEventHandler,
+    useCallback,
+    useImperativeHandle,
+    useRef,
+} from 'react';
+
+export interface DialogProps extends HTMLAttributes<HTMLDialogElement> {
+    onCancel?: ReactEventHandler<HTMLDialogElement>;
+    onClose?: ReactEventHandler<HTMLDialogElement>;
+    open?: boolean;
+}
+
+const supportsNativeDialog = () =>
+    typeof window !== 'undefined' &&
+    typeof window.HTMLDialogElement !== 'undefined' &&
+    typeof window.HTMLDialogElement.prototype.showModal === 'function';
+
+const Dialog = forwardRef<HTMLDialogElement, DialogProps>(({ children, role, ...rest }, ref) => {
+    const hostRef = useRef<HTMLElement | null>(null);
+
+    useImperativeHandle(ref, () => hostRef.current as HTMLDialogElement);
+
+    const setHostRef = useCallback((element: HTMLElement | null) => {
+        hostRef.current = element;
+    }, []);
+
+    if (supportsNativeDialog()) {
+        return (
+            <dialog {...rest} role={role} ref={setHostRef}>
+                {children}
+            </dialog>
+        );
+    }
+
+    return (
+        <div {...(rest as unknown as HTMLAttributes<HTMLDivElement>)} role={role ?? 'dialog'} ref={setHostRef}>
+            {children}
+        </div>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
