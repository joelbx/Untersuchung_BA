+// CountDiff returns the number of newly detected and resolved vulnerabilities.
+func (v VulnInfos) CountDiff() (nPlus int, nMinus int) {
+	for _, vuln := range v {
+		switch vuln.DiffStatus {
+		case DiffPlus:
+			nPlus++
+		case DiffMinus:
+			nMinus++
+		}
+	}
+	return nPlus, nMinus
+}
+
 // Find elements that matches the function passed in argument
 func (v VulnInfos) Find(f func(VulnInfo) bool) VulnInfos {
 	filtered := VulnInfos{}
