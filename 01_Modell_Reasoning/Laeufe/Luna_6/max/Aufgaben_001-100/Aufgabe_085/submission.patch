 }
 
+// DiffStatus identifies whether a vulnerability is new or resolved in a diff.
+type DiffStatus string
+
+const (
+	// DiffPlus marks a vulnerability newly detected in the current scan.
+	DiffPlus DiffStatus = "+"
+	// DiffMinus marks a vulnerability present only in the previous scan.
+	DiffMinus DiffStatus = "-"
+)
+
 // VulnInfo has a vulnerability information and unsecure packages
 type VulnInfo struct {
 	CveID                string               `json:"cveID,omitempty"`
+	DiffStatus           DiffStatus           `json:"diffStatus,omitempty"`
