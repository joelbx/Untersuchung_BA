+		if path = strings.TrimSpace(path); path != "" {
+			cleanPaths = append(cleanPaths, path)
+		}
+	}
+	if len(cleanPaths) == 0 {
+		return models.Packages{}, nil
+	}
+
+	cmd := o.rpmQf() + strings.Join(cleanPaths, " ")
