+// pkgPs associates each running process with the scanned packages that own its
+// executable or loaded files. Package ownership differs between distributions,
+// so callers provide the appropriate lookup function.
+func (l *base) pkgPs(getOwnerPkgs func([]string) (models.Packages, error)) error {
+	stdout, err := l.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+
+	pidNames := l.parsePs(stdout)
+	pidLoadedFiles := map[string][]string{}
+	for pid := range pidNames {
+		stdout, err := l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		exePath, err := l.parseLsProcExe(stdout)
+		if err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+			continue
+		}
+		if exePath = strings.TrimSpace(exePath); exePath != "" {
+			pidLoadedFiles[pid] = append(pidLoadedFiles[pid], exePath)
+		}
+
+		stdout, err = l.grepProcMap(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/maps: %s", pid, err)
+			continue
+		}
+		for _, path := range l.parseGrepProcMap(stdout) {
+			path = strings.TrimSpace(path)
+			if path != "" {
+				pidLoadedFiles[pid] = util.AppendIfMissing(pidLoadedFiles[pid], path)
+			}
+		}
+	}
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = l.lsOfListen()
+	if err != nil {
+		// Listening-port discovery is best effort; process/package associations
+		// remain useful when lsof is unavailable.
+		l.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range l.parseLsOf(stdout) {
+		portStat, err := models.NewPortStat(ipPort)
+		if err != nil {
+			l.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+			continue
+		}
+		for _, pid := range pids {
+			pidListenPorts[pid] = append(pidListenPorts[pid], *portStat)
+		}
+	}
+
+	for pid, loadedFiles := range pidLoadedFiles {
+		if len(loadedFiles) == 0 {
+			continue
+		}
+		ownerPkgs, err := getOwnerPkgs(loadedFiles)
+		if err != nil {
+			l.log.Debugf("Failed to get package owners for process %s: %s", pid, err)
+			continue
+		}
+
+		proc := models.AffectedProcess{
+			PID:             pid,
+			Name:            pidNames[pid],
+			ListenPortStats: pidListenPorts[pid],
+		}
+		for key, pack := range ownerPkgs {
+			pack.AffectedProcs = append(pack.AffectedProcs, proc)
+			l.Packages[key] = pack
+		}
+	}
+	return nil
+}
+
