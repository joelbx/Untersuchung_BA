+func (o *redhatBase) findScannedOwnerPackage(owner models.Package) (string, models.Package, bool) {
+	for key, installed := range o.Packages {
+		if installed.Name == owner.Name &&
+			installed.Version == owner.Version &&
+			installed.Release == owner.Release &&
+			installed.Arch == owner.Arch {
+			return key, installed, true
+		}
+	}
+
+	// The package collection is keyed by name and therefore may contain only
+	// one of several installed versions or architectures. Keep associating the
+	// process with that scanned package when RPM reports another installed
+	// instance of the same package name.
+	if installed, ok := o.Packages[owner.Name]; ok {
+		return owner.Name, installed, true
+	}
+	return "", models.Package{}, false
+}
