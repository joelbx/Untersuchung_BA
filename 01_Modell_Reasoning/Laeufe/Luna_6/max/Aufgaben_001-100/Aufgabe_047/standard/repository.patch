+
+func (h *Hasher) seedFor(id string) string {
+	h.mu.RLock()
+	seed, ok := h.seeds[id]
+	h.mu.RUnlock()
+	if ok {
+		return seed
+	}
+
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if seed, ok = h.seeds[id]; ok {
+		return seed
+	}
+	if h.seeds == nil {
+		h.seeds = make(map[string]string)
+	}
+	seed = randomSeed()
+	h.seeds[id] = seed
+	return seed
+}
+
+func writePart(hash *maphash.Hash, value string) {
+	var length [8]byte
+	binary.LittleEndian.PutUint64(length[:], uint64(len(value)))
+	_, _ = hash.Write(length[:])
+	_, _ = hash.WriteString(value)
+}
+
+func randomSeed() string {
+	var seed [16]byte
+	if _, err := rand.Read(seed[:]); err == nil {
+		return string(seed[:])
+	}
+
+	// Keep reseeding usable even if the system random source is unavailable.
+	var hash maphash.Hash
+	hash.SetSeed(globalSeed)
+	var counter [8]byte
+	binary.LittleEndian.PutUint64(counter[:], fallbackCounter.Add(1))
+	_, _ = hash.Write(counter[:])
+	return string(hash.Sum(nil))
+}
