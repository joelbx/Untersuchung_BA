+// NewHasher creates a Hasher with no per-identifier seeds assigned.
+func NewHasher() *Hasher {
+	return &Hasher{seeds: make(map[string]string)}
+}
+
+// SetSeed assigns seed to id. Reusing the same id and seed produces the same
+// hash values.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.seeds == nil {
+		h.seeds = make(map[string]string)
+	}
+	h.seeds[id] = seed
