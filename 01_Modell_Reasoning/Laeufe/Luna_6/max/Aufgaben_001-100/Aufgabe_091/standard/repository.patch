+func Test_matchesString_ListOperators(t *testing.T) {
+	tests := []struct {
+		name      string
+		operator  string
+		list      string
+		value     string
+		wantMatch bool
+	}{
+		{name: "isoneof matches", operator: flipt.OpIsOneOf, list: `["red","blue"]`, value: "blue", wantMatch: true},
+		{name: "isoneof does not match", operator: flipt.OpIsOneOf, list: `["red","blue"]`, value: "green"},
+		{name: "isnotoneof matches", operator: flipt.OpIsNotOneOf, list: `["red","blue"]`, value: "green", wantMatch: true},
+		{name: "isnotoneof does not match", operator: flipt.OpIsNotOneOf, list: `["red","blue"]`, value: "blue"},
+		{name: "isnotoneof matches absent value", operator: flipt.OpIsNotOneOf, list: `["red"]`, value: "", wantMatch: true},
+		{name: "invalid list", operator: flipt.OpIsOneOf, list: `not-json`, value: "red"},
+		{name: "invalid list is not inverted", operator: flipt.OpIsNotOneOf, list: `not-json`, value: "red"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			constraint := storage.EvaluationConstraint{Property: "color", Operator: tt.operator, Value: tt.list}
+			assert.Equal(t, tt.wantMatch, matchesString(constraint, tt.value))
+		})
+	}
+}
