+func TestValidate_ConstraintArrayValues(t *testing.T) {
+	tooManyStrings := `[` + strings.TrimSuffix(strings.Repeat(`"x",`, MAX_JSON_ARRAY_ITEMS+1), ",") + `]`
+	tooManyNumbers := `[` + strings.TrimSuffix(strings.Repeat("1,", MAX_JSON_ARRAY_ITEMS+1), ",") + `]`
+	tests := []struct {
+		name           string
+		property       string
+		value          string
+		comparisonType ComparisonType
+		wantErr        error
+	}{
+		{name: "valid strings", property: "color", value: `["red","blue"]`, comparisonType: ComparisonType_STRING_COMPARISON_TYPE},
+		{name: "valid numbers", property: "age", value: `[1,2.5]`, comparisonType: ComparisonType_NUMBER_COMPARISON_TYPE},
+		{name: "empty list", property: "color", value: `[]`, comparisonType: ComparisonType_STRING_COMPARISON_TYPE},
+		{name: "invalid json", property: "color", value: `not-json`, comparisonType: ComparisonType_STRING_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{name: "not an array", property: "age", value: `null`, comparisonType: ComparisonType_NUMBER_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`invalid value provided for property "age" of type number`)},
+		{name: "wrong string element type", property: "color", value: `[1]`, comparisonType: ComparisonType_STRING_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{name: "wrong number element type", property: "age", value: `["1"]`, comparisonType: ComparisonType_NUMBER_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`invalid value provided for property "age" of type number`)},
+		{name: "null string element", property: "color", value: `[null]`, comparisonType: ComparisonType_STRING_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{name: "null number element", property: "age", value: `[null]`, comparisonType: ComparisonType_NUMBER_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`invalid value provided for property "age" of type number`)},
+		{name: "too many strings", property: "color", value: tooManyStrings, comparisonType: ComparisonType_STRING_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`too many values provided for property "color" of type string (maximum 100)`)},
+		{name: "too many numbers", property: "age", value: tooManyNumbers, comparisonType: ComparisonType_NUMBER_COMPARISON_TYPE, wantErr: errors.ErrInvalid(`too many values provided for property "age" of type number (maximum 100)`)},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.wantErr, validateArrayValue(tt.property, tt.value, tt.comparisonType))
+		})
+	}
+}
