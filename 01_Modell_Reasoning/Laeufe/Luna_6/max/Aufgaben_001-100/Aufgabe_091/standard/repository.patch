+		wantMatch bool
+		wantErr   bool
+	}{
+		{name: "isoneof matches", operator: flipt.OpIsOneOf, list: `[1,2.5]`, value: "2.5", wantMatch: true},
+		{name: "isoneof does not match", operator: flipt.OpIsOneOf, list: `[1,2.5]`, value: "3"},
+		{name: "isnotoneof matches", operator: flipt.OpIsNotOneOf, list: `[1,2.5]`, value: "3", wantMatch: true},
+		{name: "isnotoneof does not match", operator: flipt.OpIsNotOneOf, list: `[1,2.5]`, value: "1"},
+		{name: "invalid json", operator: flipt.OpIsOneOf, list: `[1,`, value: "1", wantErr: true},
+		{name: "wrong element type", operator: flipt.OpIsOneOf, list: `["1"]`, value: "1", wantErr: true},
+		{name: "null element", operator: flipt.OpIsNotOneOf, list: `[null]`, value: "1", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			constraint := storage.EvaluationConstraint{Property: "age", Operator: tt.operator, Value: tt.list}
+			match, err := matchesNumber(constraint, tt.value)
+			if tt.wantErr {
+				assert.ErrorAs(t, err, new(ferrors.ErrInvalid))
+				return
+			}
+			assert.NoError(t, err)
+			assert.Equal(t, tt.wantMatch, match)
+		})
+	}
+}
