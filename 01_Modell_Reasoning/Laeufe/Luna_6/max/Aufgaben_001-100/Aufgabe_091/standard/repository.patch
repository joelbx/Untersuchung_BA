+func validateArrayValue(property, value string, comparisonType ComparisonType) error {
+	typeName := ""
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		typeName = "string"
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		typeName = "number"
+	default:
+		return nil
+	}
+
+	invalidValue := func() error {
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+	}
+	tooManyValues := func() error {
+		return errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", property, typeName, MAX_JSON_ARRAY_ITEMS)
+	}
+
+	trimmed := strings.TrimSpace(value)
+	if trimmed == "" || trimmed[0] != '[' {
+		return invalidValue()
+	}
+
+	var items []json.RawMessage
+	if err := json.Unmarshal([]byte(trimmed), &items); err != nil {
+		return invalidValue()
+	}
+	if len(items) > MAX_JSON_ARRAY_ITEMS {
+		return tooManyValues()
+	}
+	for _, item := range items {
+		if bytes.Equal(bytes.TrimSpace(item), []byte("null")) {
+			return invalidValue()
+		}
+	}
+
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		var values []string
+		if err := json.Unmarshal([]byte(trimmed), &values); err != nil {
+			return invalidValue()
+		}
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		var values []float64
+		if err := json.Unmarshal([]byte(trimmed), &values); err != nil {
+			return invalidValue()
+		}
+	}
+
+	return nil
+}
