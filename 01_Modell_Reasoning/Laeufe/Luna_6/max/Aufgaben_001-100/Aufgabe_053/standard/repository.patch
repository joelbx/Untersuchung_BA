+// DetectGitHubCves detects GitHub Security Alerts for the scan result's server.
+func DetectGitHubCves(r *models.ScanResult) error {
+	ints := &integrationResults{}
+	return GithubSecurityAlerts(config.Conf.Servers[r.ServerName].GitHubRepos).apply(r, ints)
+}
+
+// DetectWordPressCves detects WordPress vulnerabilities for the scan result's server.
+func DetectWordPressCves(r *models.ScanResult) error {
+	caches := map[string]string{}
+	option := WordPressOption{
+		token:        config.Conf.Servers[r.ServerName].WordPress.WPVulnDBToken,
+		wpVulnCaches: &caches,
+	}
+	return option.apply(r, &integrationResults{})
+}
