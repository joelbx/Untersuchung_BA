+// DiagResult holds the results of the Touch ID availability checks.
+type DiagResult struct {
+	HasCompileSupport       bool // The binary includes Touch ID support.
+	HasSignature            bool // The running binary has a valid code signature.
+	HasEntitlements         bool // The signature carries the required keychain entitlements.
+	PassedLAPolicyTest      bool // Local Authentication can evaluate Touch ID.
+	PassedSecureEnclaveTest bool // The Secure Enclave can create a biometric key.
+	IsAvailable             bool // All required checks passed.
+}
+
+// Diag runs Touch ID diagnostics and reports the result of each check.
+func Diag() (*DiagResult, error) {
+	return diagnose()
+}
+
 // nativeTID represents the native Touch ID interface.
 // Implementors must provide a global variable called `native`.
 type nativeTID interface {
