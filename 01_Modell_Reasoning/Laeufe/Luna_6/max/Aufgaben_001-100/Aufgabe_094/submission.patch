+
+static BOOL hasValidCodeSignature(BOOL *hasEntitlements) {
+  SecCodeRef code = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &code) != errSecSuccess) {
+    return NO;
+  }
+
+  CFDictionaryRef signingInfo = NULL;
+  OSStatus status = SecCodeCopySigningInformation(
+      code, kSecCSSigningInformation, &signingInfo);
+  if (status != errSecSuccess) {
+    CFRelease(code);
+    return NO;
+  }
+
+  CFTypeRef cmsSignature = CFDictionaryGetValue(signingInfo, kSecCodeInfoCMS);
+  BOOL signedAndValid = cmsSignature != NULL &&
+      SecCodeCheckValidity(code, kSecCSStrictValidate, NULL) == errSecSuccess;
+
+  CFTypeRef entitlements =
+      CFDictionaryGetValue(signingInfo, kSecCodeInfoEntitlements);
+  if (entitlements != NULL &&
+      CFGetTypeID(entitlements) == CFDictionaryGetTypeID()) {
+    CFDictionaryRef entitlementDict = (CFDictionaryRef)entitlements;
+    CFTypeRef teamID = CFDictionaryGetValue(
+        entitlementDict, CFSTR("com.apple.developer.team-identifier"));
+    CFTypeRef applicationID = CFDictionaryGetValue(
+        entitlementDict, CFSTR("com.apple.application-identifier"));
+    CFTypeRef keychainGroups =
+        CFDictionaryGetValue(entitlementDict, CFSTR("keychain-access-groups"));
+    *hasEntitlements =
+        teamID != NULL && CFGetTypeID(teamID) == CFStringGetTypeID() &&
+        CFStringGetLength((CFStringRef)teamID) > 0 &&
+        applicationID != NULL && CFGetTypeID(applicationID) == CFStringGetTypeID() &&
+        CFStringGetLength((CFStringRef)applicationID) > 0 &&
+        keychainGroups != NULL && CFGetTypeID(keychainGroups) == CFArrayGetTypeID() &&
+        CFArrayGetCount((CFArrayRef)keychainGroups) > 0;
+  }
+
+  CFRelease(signingInfo);
+  CFRelease(code);
+  return signedAndValid;
+}
+
+static BOOL passedLAPolicyTest(void) {
+  LAContext *context = [[LAContext alloc] init];
+  NSError *error = nil;
+  return [context canEvaluatePolicy:LAPolicyDeviceOwnerAuthenticationWithBiometrics
+                              error:&error];
+}
+
+static BOOL passedSecureEnclaveTest(void) {
+  CFErrorRef error = NULL;
+  SecAccessControlRef access = SecAccessControlCreateWithFlags(
+      kCFAllocatorDefault, kSecAttrAccessibleWhenUnlockedThisDeviceOnly,
+      kSecAccessControlPrivateKeyUsage | kSecAccessControlBiometryAny, &error);
+  if (access == NULL) {
+    if (error != NULL) {
+      CFRelease(error);
+    }
+    return NO;
+  }
+
+  NSDictionary *attributes = @{
+    (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+    (id)kSecAttrKeySizeInBits : @256,
+    (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+    (id)kSecPrivateKeyAttrs : @{
+      (id)kSecAttrIsPermanent : @NO,
+      (id)kSecAttrAccessControl : (__bridge id)access,
+    },
+  };
+  SecKeyRef key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes,
+                                        &error);
+  BOOL passed = key != NULL;
+  if (key != NULL) {
+    CFRelease(key);
+  }
+  if (error != NULL) {
+    CFRelease(error);
+  }
+  CFRelease(access);
+  return passed;
+}
+
+void TouchIDDiag(int *hasSignature, int *hasEntitlements,
+                 int *passedLAPolicy, int *passedSecureEnclave) {
+  BOOL entitlements = NO;
+  if (hasSignature != NULL) {
+    *hasSignature = hasValidCodeSignature(&entitlements);
+  }
+  if (hasEntitlements != NULL) {
+    *hasEntitlements = entitlements;
+  }
+  if (passedLAPolicy != NULL) {
+    *passedLAPolicy = passedLAPolicyTest();
+  }
+  if (passedSecureEnclave != NULL) {
+    *passedSecureEnclave = passedSecureEnclaveTest();
+  }
+}
