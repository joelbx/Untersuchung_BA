+func diagnose() (*DiagResult, error) {
+	result := &DiagResult{HasCompileSupport: true}
+	var hasSignature, hasEntitlements, passedLAPolicyTest, passedSecureEnclaveTest C.int
+	C.TouchIDDiag(&hasSignature, &hasEntitlements, &passedLAPolicyTest, &passedSecureEnclaveTest)
+	result.HasSignature = hasSignature != 0
+	result.HasEntitlements = hasEntitlements != 0
+	result.PassedLAPolicyTest = passedLAPolicyTest != 0
+	result.PassedSecureEnclaveTest = passedSecureEnclaveTest != 0
+	result.IsAvailable = result.HasCompileSupport && result.HasSignature && result.HasEntitlements &&
+		result.PassedLAPolicyTest && result.PassedSecureEnclaveTest
+	return result, nil
+}
