+var environmentVariablePattern = regexp.MustCompile(`^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$`)
+
+func environmentVariableHookFunc() mapstructure.DecodeHookFunc {
+	return func(_ reflect.Type, _ reflect.Type, data interface{}) (interface{}, error) {
+		value, ok := data.(string)
+		if !ok {
+			return data, nil
+		}
+
+		match := environmentVariablePattern.FindStringSubmatch(value)
+		if len(match) != 2 {
+			return data, nil
+		}
+
+		if replacement, ok := os.LookupEnv(match[1]); ok {
+			return replacement, nil
+		}
+
+		return data, nil
+	}
+}
+
