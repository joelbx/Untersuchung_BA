+// NewWriterEmitter returns an emitter that writes audit events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		WriterLog: *NewWriterLog(utils.NopWriteCloser(w)),
+		writer:    w,
+	}
+}
+
+// WriterEmitter emits audit events to an external writer and provides the
+// legacy audit log implementation through its embedded WriterLog.
+type WriterEmitter struct {
+	WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent marshals an audit event to JSON and writes it as one line.
+func (w *WriterEmitter) EmitAuditEvent(_ context.Context, event AuditEvent) error {
+	line, err := utils.FastMarshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	line = append(line, '\n')
+	n, err := w.writer.Write(line)
+	if err != nil {
+		return trace.ConvertSystemError(err)
+	}
+	if n != len(line) {
+		return trace.ConvertSystemError(io.ErrShortWrite)
+	}
+	return nil
+}
+
+// Close closes the writer and its embedded WriterLog, aggregating errors.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(
+		trace.ConvertSystemError(w.writer.Close()),
+		trace.ConvertSystemError(w.WriterLog.Close()),
+	)
+}
