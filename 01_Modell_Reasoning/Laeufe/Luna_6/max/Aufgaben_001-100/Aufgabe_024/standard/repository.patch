+def _normalize_author_name(name: str) -> str:
+    """Normalize punctuation and case for honorific exception matching."""
+    return ''.join(character for character in name.casefold() if character.isalnum())
+
+
+_HONORIFIC_EXCEPTIONS_NORMALIZED: Final = frozenset(
+    _normalize_author_name(name) for name in HONORIFC_NAME_EXECPTIONS
+)
+
+_HONORIFIC_PREFIX_RE: Final = re.compile(
+    r"^\s*(?:"
+    + '|'.join(
+        re.escape(honorific.rstrip('.'))
+        for honorific in sorted(set(HONORIFICS), key=len, reverse=True)
+    )
+    + r")(?:\.)?(?=\s|[,;:]|$)(?:[,;:]?\s*)",
+    re.IGNORECASE,
+)
 
 
