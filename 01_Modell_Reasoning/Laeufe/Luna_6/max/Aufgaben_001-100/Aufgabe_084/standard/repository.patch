+const TECHNICAL_FIELD_PREFIXES = ["_finalEncrypted", "_defaultEncrypted", "_errors"]
+
+/**
+ * Removes technical fields from a new entity and all nested objects. The entity is mutated and is no longer suitable for update operations.
+ */
+export function removeTechnicalFields<E extends SomeEntity>(entity: E): void {
+	const visited = new WeakSet<object>()
+
+	const removeFrom = (value: unknown): void => {
+		if (value === null || typeof value !== "object" || visited.has(value)) {
+			return
+		}
+
+		visited.add(value)
+		const properties = value as Record<string, unknown>
+
+		for (const key of Object.keys(properties)) {
+			if (TECHNICAL_FIELD_PREFIXES.some((prefix) => key.startsWith(prefix))) {
+				delete properties[key]
+			} else {
+				removeFrom(properties[key])
+			}
+		}
+	}
+
+	removeFrom(entity)
+}
