+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	authConfig := AuthenticationConfig{}
+	methods := authConfig.Methods.AllMethods()
+	wantDatabaseRequirements := map[string]bool{
+		"token":      true,
+		"oidc":       true,
+		"github":     true,
+		"kubernetes": true,
+		"jwt":        false,
+	}
+	require.Len(t, methods, len(wantDatabaseRequirements))
+
+	for _, info := range methods {
+		assert.Equal(t, wantDatabaseRequirements[info.Name()], info.RequiresDatabase, info.Name())
+	}
+
+	assert.False(t, authConfig.RequiresDatabase())
+	authConfig.Methods.JWT.Enabled = true
+	authConfig.Methods.JWT.Cleanup = &AuthenticationCleanupSchedule{Interval: time.Hour, GracePeriod: time.Hour}
+	assert.False(t, authConfig.RequiresDatabase())
+	assert.False(t, authConfig.ShouldRunCleanup())
+
+	authConfig.Methods.Token.Cleanup = &AuthenticationCleanupSchedule{Interval: time.Hour, GracePeriod: time.Hour}
+	assert.False(t, authConfig.ShouldRunCleanup(), "cleanup is not needed for disabled methods")
+	authConfig.Methods.Token.Enabled = true
+	assert.True(t, authConfig.RequiresDatabase())
+	assert.True(t, authConfig.ShouldRunCleanup())
+
+	authConfig.Methods.Token.Enabled = false
+	assert.False(t, authConfig.RequiresDatabase())
+	assert.False(t, authConfig.ShouldRunCleanup())
+}
