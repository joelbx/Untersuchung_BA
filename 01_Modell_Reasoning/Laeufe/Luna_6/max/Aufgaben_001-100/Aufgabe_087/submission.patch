new file mode 100644
index 0000000..e71d141
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,31 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt contains build and update metadata exposed by the /meta/info endpoint.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP serializes the Flipt metadata as JSON.
+func (f Flipt) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	out, err := json.Marshal(f)
+	if err != nil {
+		http.Error(w, "failed to serialize Flipt info", http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := w.Write(out); err != nil {
+		w.WriteHeader(http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..021d88d
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,319 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	stateVersion    = "1.0"
+	reportInterval  = 4 * time.Hour
+	segmentTrackURL = "https://api.segment.io/v1/track"
+)
+
+// FliptVersion is set by the server executable before starting the reporter.
+var FliptVersion = "dev"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type trackEvent struct {
+	AnonymousID string                 `json:"anonymousId"`
+	Event       string                 `json:"event"`
+	Properties  map[string]interface{} `json:"properties"`
+	Context     map[string]interface{} `json:"context,omitempty"`
+}
+
+type eventClient interface {
+	Track(context.Context, trackEvent) error
+}
+
+// Reporter persists an anonymous installation identifier and reports usage.
+type Reporter struct {
+	statePath string
+	state     state
+	client    eventClient
+	logger    logrus.FieldLogger
+
+	mu        sync.Mutex
+	startOnce sync.Once
+}
+
+// NewReporter creates a reporter when telemetry is enabled. It returns nil,
+// nil when telemetry is disabled or the configured state path is not a directory.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if logger == nil {
+		logger = logrus.New()
+	}
+	if cfg == nil {
+		return nil, errors.New("telemetry config cannot be nil")
+	}
+
+	enabled := cfg.Meta.TelemetryEnabled
+	if raw, ok := os.LookupEnv("FLIPT_META_TELEMETRY_ENABLED"); ok && raw != "" {
+		value, err := strconv.ParseBool(raw)
+		if err != nil {
+			err = fmt.Errorf("parsing FLIPT_META_TELEMETRY_ENABLED: %w", err)
+			logger.Errorf("initializing telemetry: %v", err)
+			return nil, err
+		}
+		enabled = value
+	}
+	if !enabled {
+		return nil, nil
+	}
+
+	directory := cfg.Meta.StateDirectory
+	if envDirectory := os.Getenv("FLIPT_META_STATE_DIRECTORY"); envDirectory != "" {
+		directory = envDirectory
+	}
+	if directory == "" {
+		userConfigDirectory, err := os.UserConfigDir()
+		if err != nil {
+			err = fmt.Errorf("resolving user configuration directory: %w", err)
+			logger.Errorf("initializing telemetry: %v", err)
+			return nil, err
+		}
+		directory = filepath.Join(userConfigDirectory, "flipt")
+	}
+
+	if info, err := os.Stat(directory); err == nil && !info.IsDir() {
+		logger.Warnf("disabling telemetry: state path %q is not a directory", directory)
+		return nil, nil
+	} else if err != nil && !os.IsNotExist(err) {
+		err = fmt.Errorf("checking telemetry state directory: %w", err)
+		logger.Errorf("initializing telemetry: %v", err)
+		return nil, err
+	}
+
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		err = fmt.Errorf("creating telemetry state directory: %w", err)
+		logger.Errorf("initializing telemetry: %v", err)
+		return nil, err
+	}
+
+	statePath := filepath.Join(directory, "telemetry.json")
+	current := state{
+		Version:       stateVersion,
+		LastTimestamp: time.Unix(0, 0).UTC().Format(time.RFC3339),
+	}
+	contents, err := os.ReadFile(statePath)
+	if err == nil {
+		if decodeErr := json.Unmarshal(contents, &current); decodeErr != nil {
+			logger.Warnf("reading telemetry state: %v; creating fresh state", decodeErr)
+			current = state{
+				Version:       stateVersion,
+				LastTimestamp: time.Unix(0, 0).UTC().Format(time.RFC3339),
+			}
+		}
+	} else if !os.IsNotExist(err) {
+		err = fmt.Errorf("reading telemetry state: %w", err)
+		logger.Errorf("initializing telemetry: %v", err)
+		return nil, err
+	}
+
+	current.Version = stateVersion
+	if parsed, parseErr := uuid.FromString(current.UUID); parseErr != nil || parsed.String() == "00000000-0000-0000-0000-000000000000" {
+		generated, generateErr := uuid.NewV4()
+		if generateErr != nil {
+			err = fmt.Errorf("generating telemetry identifier: %w", generateErr)
+			logger.Errorf("initializing telemetry: %v", err)
+			return nil, err
+		}
+		current.UUID = generated.String()
+	} else {
+		current.UUID = parsed.String()
+	}
+	if _, err := time.Parse(time.RFC3339, current.LastTimestamp); err != nil {
+		current.LastTimestamp = time.Unix(0, 0).UTC().Format(time.RFC3339)
+	}
+
+	if err := writeState(statePath, current); err != nil {
+		err = fmt.Errorf("writing telemetry state: %w", err)
+		logger.Errorf("initializing telemetry: %v", err)
+		return nil, err
+	}
+
+	return &Reporter{
+		statePath: statePath,
+		state:     current,
+		client:    newHTTPClient(),
+		logger:    logger,
+	}, nil
+}
+
+// Start launches the periodic reporting loop. The first report is sent when
+// the persisted timestamp is at least four hours old.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	r.startOnce.Do(func() {
+		go r.run(ctx)
+	})
+}
+
+func (r *Reporter) run(ctx context.Context) {
+	timer := time.NewTimer(r.timeUntilNextReport())
+	defer timer.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-timer.C:
+			_ = r.Report(ctx)
+			timer.Reset(reportInterval)
+		}
+	}
+}
+
+func (r *Reporter) timeUntilNextReport() time.Duration {
+	r.mu.Lock()
+	lastTimestamp := r.state.LastTimestamp
+	r.mu.Unlock()
+
+	last, err := time.Parse(time.RFC3339, lastTimestamp)
+	if err != nil {
+		return 0
+	}
+	remaining := last.Add(reportInterval).Sub(time.Now())
+	if remaining < 0 {
+		return 0
+	}
+	return remaining
+}
+
+// Report sends one anonymous flipt.ping event and persists its successful time.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return errors.New("telemetry reporter cannot be nil")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	r.mu.Lock()
+	identifier := r.state.UUID
+	r.mu.Unlock()
+
+	event := trackEvent{
+		AnonymousID: identifier,
+		Event:       "flipt.ping",
+		Properties: map[string]interface{}{
+			"uuid":          identifier,
+			"version":       stateVersion,
+			"flipt.version": FliptVersion,
+		},
+		// Segment can infer an IP address from the connection. Explicitly
+		// override it so the event is not associated with a user's IP address.
+		Context: map[string]interface{}{"ip": "0.0.0.0"},
+	}
+	if err := r.client.Track(ctx, event); err != nil {
+		err = fmt.Errorf("sending telemetry event: %w", err)
+		r.logger.Errorf("%v", err)
+		return err
+	}
+
+	r.mu.Lock()
+	updated := r.state
+	updated.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := writeState(r.statePath, updated); err != nil {
+		r.mu.Unlock()
+		err = fmt.Errorf("writing telemetry state after report: %w", err)
+		r.logger.Errorf("%v", err)
+		return err
+	}
+	r.state = updated
+	r.mu.Unlock()
+	return nil
+}
+
+func writeState(path string, value state) error {
+	contents, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
+	if err != nil {
+		return err
+	}
+	if err := file.Chmod(0600); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if _, err := io.Copy(file, bytes.NewReader(contents)); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	return nil
+}
+
+type httpEventClient struct {
+	endpoint string
+	writeKey string
+	client   *http.Client
+}
+
+func newHTTPClient() eventClient {
+	endpoint := os.Getenv("FLIPT_META_TELEMETRY_ENDPOINT")
+	if endpoint == "" {
+		endpoint = segmentTrackURL
+	}
+	return &httpEventClient{
+		endpoint: endpoint,
+		writeKey: os.Getenv("FLIPT_META_TELEMETRY_WRITE_KEY"),
+		client:   &http.Client{Timeout: 10 * time.Second},
+	}
+}
+
+func (c *httpEventClient) Track(ctx context.Context, event trackEvent) error {
+	contents, err := json.Marshal(event)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, c.endpoint, bytes.NewReader(contents))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	request.Header.Set("Content-Type", "application/json")
+	if c.writeKey != "" {
+		request.SetBasicAuth(c.writeKey, "")
+	}
+
+	response, err := c.client.Do(request)
+	if err != nil {
+		return fmt.Errorf("posting telemetry event: %w", err)
+	}
+	defer response.Body.Close()
+	_, _ = io.Copy(io.Discard, response.Body)
+	if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+		return fmt.Errorf("telemetry endpoint returned HTTP %d", response.StatusCode)
+	}
+	return nil
+}
