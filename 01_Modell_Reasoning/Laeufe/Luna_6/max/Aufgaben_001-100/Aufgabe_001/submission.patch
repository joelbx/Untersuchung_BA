--- /dev/null
+++ b/config/syslog/syslogconf_windows.go
@@ -0,0 +1,13 @@
+//go:build windows
+
+package syslog
+
+import "golang.org/x/xerrors"
+
+// Validate rejects syslog configuration on Windows.
+func (c *Conf) Validate() []error {
+	if c.Enabled {
+		return []error{xerrors.New("windows not support syslog")}
+	}
+	return nil
+}
diff --git a/config/syslog/types.go b/config/syslog/types.go
new file mode 100644
index 0000000..3091d59
--- /dev/null
+++ b/config/syslog/types.go
@@ -0,0 +1,14 @@
+// Package syslog provides syslog configuration and validation.
+package syslog
+
+// Conf is the configuration for reporting to a syslog server.
+type Conf struct {
+	Protocol string `json:"-"`
+	Host     string `valid:"host" json:"-"`
+	Port     string `valid:"port" json:"-"`
+	Severity string `json:"-"`
+	Facility string `json:"-"`
+	Tag      string `json:"-"`
+	Verbose  bool   `json:"-"`
+	Enabled  bool   `toml:"-" json:"-"`
+}
