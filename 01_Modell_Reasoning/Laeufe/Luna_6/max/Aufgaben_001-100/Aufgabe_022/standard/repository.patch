+func (o *redhatBase) parseSourcePackage(filename, epoch, binaryName string) *models.SrcPackage {
+	if filename == "(none)" {
+		return nil
+	}
+
+	name, version, release, err := splitFileName(filename)
+	if err != nil {
+		warning := xerrors.Errorf("Failed to parse source RPM filename %q; skipping source package. err: %w", filename, err)
+		if o.log.Logger != nil {
+			o.log.Warnf("%s", warning)
+		}
+		o.warns = append(o.warns, warning)
+		return nil
+	}
+
+	// The epoch may be present in the source RPM filename as well as in the
+	// package query fields. Avoid adding it twice when splitFileName found it.
+	if epoch != "0" && epoch != "(none)" && !strings.Contains(version, ":") {
+		version = fmt.Sprintf("%s:%s", epoch, version)
+	}
+
+	return &models.SrcPackage{
+		Name:        name,
+		Version:     fmt.Sprintf("%s-%s", version, release),
+		Arch:        "src",
+		BinaryNames: []string{binaryName},
+	}
+}
+
 // https://github.com/aquasecurity/trivy/blob/51f2123c5ccc4f7a37d1068830b6670b4ccf9ac8/pkg/fanal/analyzer/pkg/rpm/rpm.go#L212-L241
 func splitFileName(filename string) (name, ver, rel string, err error) {
 	filename = strings.TrimSuffix(filename, ".rpm")
@@ -708,6 +685,20 @@ func splitFileName(filename string) (name, ver, rel string, err error) {
 	ver = filename[verIndex+1 : relIndex]
 
 	name = filename[:verIndex]
+	if colonIndex := strings.IndexByte(name, ':'); colonIndex > 0 {
+		epoch := name[:colonIndex]
+		isEpoch := true
+		for _, r := range epoch {
+			if r < '0' || r > '9' {
+				isEpoch = false
+				break
+			}
+		}
+		if isEpoch {
+			name = name[colonIndex+1:]
+			ver = fmt.Sprintf("%s:%s", epoch, ver)
+		}
+	}
 	return name, ver, rel, nil
 }
 
