+// resolveKubeProxyAddr replaces an unspecified listen host with the web proxy
+// host, which is reachable by clients.
+func resolveKubeProxyAddr(addr *utils.NetAddr, original string, tc *TeleportClient) string {
+	ip := net.ParseIP(addr.Host())
+	if ip == nil || !ip.IsUnspecified() {
+		return original
+	}
+	webProxyHost, _ := tc.WebProxyHostPort()
+	return net.JoinHostPort(webProxyHost, strconv.Itoa(addr.Port(defaults.KubeListenPort)))
+}
