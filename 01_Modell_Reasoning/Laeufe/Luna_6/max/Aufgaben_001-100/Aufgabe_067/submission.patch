+    @pytest.mark.parametrize('backend, supported_qt, is_mac, expected', [
+        (usertypes.Backend.QtWebEngine, True, False, True),
+        (usertypes.Backend.QtWebEngine, False, False, False),
+        (usertypes.Backend.QtWebEngine, True, True, False),
+        (usertypes.Backend.QtWebKit, True, False, False),
+    ])
+    def test_overlay_scrollbars(self, config_stub, monkeypatch, parser,
+                                backend, supported_qt, is_mac, expected):
+        monkeypatch.setattr(configinit.objects, 'backend', backend)
+        monkeypatch.setattr(configinit.utils, 'is_mac', is_mac)
+        monkeypatch.setattr(
+            configinit.qtutils, 'version_check',
+            lambda version, compiled=False: (supported_qt
+                                              if version == '5.11' else True))
+        config_stub.val.scrolling.bar = 'overlay'
+
+        args = configinit.qt_args(parser.parse_args([]))
+        assert ('--enable-features=OverlayScrollbar' in args) == expected
+
+    @pytest.mark.parametrize('bar', ['always', 'never', 'when-searching'])
+    def test_overlay_scrollbars_disabled_for_other_values(
+            self, config_stub, monkeypatch, parser, bar):
+        monkeypatch.setattr(configinit.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(configinit.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = bar
+
+        args = configinit.qt_args(parser.parse_args([]))
+        assert '--enable-features=OverlayScrollbar' not in args
+
+    def test_overlay_scrollbars_with_other_chromium_flags(
+            self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(configinit.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(configinit.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+        config_stub.val.qt.force_software_rendering = 'chromium'
+
+        parsed = parser.parse_args(['--debug-flag', 'chromium'])
+        args = configinit.qt_args(parsed)
+        assert '--enable-features=OverlayScrollbar' in args
+        assert '--disable-gpu' in args
