+func cacheTLS(ctx context.Context, client *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	cert, key, err := redisTLSCertificate()
+	if err != nil {
+		return func() error { return err }
+	}
+
+	redisSrv := client.Container().
+		From("redis:alpine").
+		WithNewFile("/tmp/redis.crt", dagger.ContainerWithNewFileOpts{Contents: string(cert)}).
+		WithNewFile("/tmp/redis.key", dagger.ContainerWithNewFileOpts{Contents: string(key)}).
+		WithExposedPort(6379).
+		WithExec([]string{
+			"redis-server",
+			"--port", "0",
+			"--tls-port", "6379",
+			"--tls-cert-file", "/tmp/redis.crt",
+			"--tls-key-file", "/tmp/redis.key",
+			"--tls-ca-cert-file", "/tmp/redis.crt",
+			"--tls-auth-clients", "no",
+		}).
+		AsService()
+
+	flipt = flipt.
+		WithServiceBinding("redis", redisSrv).
+		WithEnvVariable("FLIPT_LOG_LEVEL", "DEBUG").
+		WithEnvVariable("FLIPT_CACHE_ENABLED", "true").
+		WithEnvVariable("FLIPT_CACHE_BACKEND", "redis").
+		WithEnvVariable("FLIPT_CACHE_REDIS_HOST", "redis").
+		WithEnvVariable("FLIPT_CACHE_REDIS_PORT", "6379").
+		WithEnvVariable("FLIPT_CACHE_REDIS_REQUIRE_TLS", "true").
+		WithEnvVariable("FLIPT_CACHE_REDIS_CA_CERT_BYTES", string(cert))
+
+	return suite(ctx, "api", base, flipt.WithExec(nil), conf)
+}
+
+func redisTLSCertificate() ([]byte, []byte, error) {
+	now := time.Now()
+	certTemplate := &x509.Certificate{
+		SerialNumber:          big.NewInt(now.UnixNano()),
+		Subject:               pkix.Name{CommonName: "redis"},
+		NotBefore:             now.Add(-time.Minute),
+		NotAfter:              now.Add(time.Hour),
+		KeyUsage:              x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment | x509.KeyUsageCertSign,
+		ExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+		DNSNames:              []string{"redis"},
+	}
+
+	certDER, err := x509.CreateCertificate(rand.Reader, certTemplate, certTemplate, &priv.PublicKey, priv)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certDER})
+	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(priv)})
+	return certPEM, keyPEM, nil
+}
