+func kubeAddrFromPublicAddr(publicAddr string) (string, error) {
+	proxyConfig := service.ProxyConfig{
+		Kube: service.KubeProxyConfig{
+			Enabled:     true,
+			PublicAddrs: []utils.NetAddr{{Addr: publicAddr}},
+		},
+	}
+	return proxyConfig.KubeAddr()
