+// KubeAddr returns the public Kubernetes proxy address as an HTTPS URL.
+// The public address host is used with the default Kubernetes proxy port.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	addrs := c.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = c.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("no public address configured for Kubernetes proxy")
+	}
+
+	addr, err := utils.ParseAddr(addrs[0].String())
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	host := addr.Host()
+	if host == "" || (net.ParseIP(host) == nil && (strings.ContainsAny(host, ":[]/?#@%\\") || strings.TrimSpace(host) != host)) {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addrs[0].String())
+	}
+	if net.ParseIP(addr.Addr) == nil && strings.Contains(addr.Addr, ":") {
+		_, port, err := net.SplitHostPort(addr.Addr)
+		if err != nil {
+			// A bracketed IPv6 address may omit its port.
+			if net.ParseIP(host) == nil || strings.Trim(addr.Addr, "[]") != host {
+				return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addrs[0].String())
+			}
+		} else if portNumber, err := strconv.Atoi(port); err != nil || portNumber < 1 || portNumber > 65535 {
+			return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addrs[0].String())
+		}
+	}
+
+	port := strconv.Itoa(defaults.KubeProxyListenPort)
+	proxyAddr := (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(host, port),
+	}).String()
+	parsedURL, err := url.Parse(proxyAddr)
+	if err != nil || parsedURL.Hostname() != host || parsedURL.Port() != port {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addrs[0].String())
+	}
+	return proxyAddr, nil
+}
