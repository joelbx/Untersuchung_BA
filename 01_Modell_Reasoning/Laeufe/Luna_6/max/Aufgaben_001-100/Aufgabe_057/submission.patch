new file mode 100644
index 0000000..4fe8bd9
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,226 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+}
+
+// Importer creates flags, segments, and their associated data from YAML.
+type Importer struct {
+	store creator
+}
+
+// NewImporter returns an importer for the provided store.
+func NewImporter(store creator) *Importer {
+	return &Importer{store: store}
+}
+
+// Import decodes a YAML document and creates its entities in the store.
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	if i == nil || i.store == nil {
+		return fmt.Errorf("importing: store is nil")
+	}
+	if r == nil {
+		return fmt.Errorf("importing: reader is nil")
+	}
+
+	doc := &Document{}
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("decoding YAML: %w", err)
+	}
+
+	type variantKey struct {
+		flag    string
+		variant string
+	}
+	createdVariants := make(map[variantKey]*flipt.Variant)
+
+	for _, f := range doc.Flags {
+		if f == nil {
+			continue
+		}
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{
+			Key:         f.Key,
+			Name:        f.Name,
+			Description: f.Description,
+			Enabled:     f.Enabled,
+		}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+
+		for _, v := range f.Variants {
+			if v == nil {
+				continue
+			}
+			attachment, err := importAttachment(v)
+			if err != nil {
+				return fmt.Errorf("encoding attachment for variant %q on flag %q: %w", v.Key, f.Key, err)
+			}
+			created, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{
+				FlagKey:     f.Key,
+				Key:         v.Key,
+				Name:        v.Name,
+				Description: v.Description,
+				Attachment:  attachment,
+			})
+			if err != nil {
+				return fmt.Errorf("importing variant %q on flag %q: %w", v.Key, f.Key, err)
+			}
+			createdVariants[variantKey{flag: f.Key, variant: v.Key}] = created
+		}
+	}
+
+	for _, s := range doc.Segments {
+		if s == nil {
+			continue
+		}
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{
+			Key:         s.Key,
+			Name:        s.Name,
+			Description: s.Description,
+		}); err != nil {
+			return fmt.Errorf("importing segment %q: %w", s.Key, err)
+		}
+
+		for _, c := range s.Constraints {
+			if c == nil {
+				continue
+			}
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{
+				SegmentKey: s.Key,
+				Type:       flipt.ComparisonType(flipt.ComparisonType_value[c.Type]),
+				Property:   c.Property,
+				Operator:   c.Operator,
+				Value:      c.Value,
+			}); err != nil {
+				return fmt.Errorf("importing constraint for segment %q: %w", s.Key, err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		if f == nil {
+			continue
+		}
+		for _, r := range f.Rules {
+			if r == nil {
+				continue
+			}
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{
+				FlagKey:    f.Key,
+				SegmentKey: r.SegmentKey,
+				Rank:       int32(r.Rank),
+			})
+			if err != nil {
+				return fmt.Errorf("importing rule for flag %q: %w", f.Key, err)
+			}
+
+			for _, d := range r.Distributions {
+				if d == nil {
+					continue
+				}
+				variant, found := createdVariants[variantKey{flag: f.Key, variant: d.VariantKey}]
+				if !found || variant == nil {
+					return fmt.Errorf("finding variant %q on flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{
+					FlagKey:   f.Key,
+					RuleId:    rule.Id,
+					VariantId: variant.Id,
+					Rollout:   d.Rollout,
+				}); err != nil {
+					return fmt.Errorf("importing distribution for flag %q: %w", f.Key, err)
+				}
+			}
+		}
+	}
+
+	return nil
+}
+
+func importAttachment(v *Variant) (string, error) {
+	if v.Attachment == nil {
+		if v.attachmentSet {
+			return "null", nil
+		}
+		return "", nil
+	}
+
+	attachment := convert(v.Attachment)
+	if raw, ok := attachment.(string); ok && json.Valid([]byte(raw)) {
+		var compact bytes.Buffer
+		if err := json.Compact(&compact, []byte(raw)); err != nil {
+			return "", err
+		}
+		return compact.String(), nil
+	}
+
+	data, err := json.Marshal(attachment)
+	if err != nil {
+		return "", err
+	}
+	return string(data), nil
+}
+
+// convert recursively changes YAML's interface-keyed maps to string-keyed maps
+// so they can be encoded as JSON.
+func convert(value interface{}) interface{} {
+	switch value := value.(type) {
+	case map[interface{}]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			converted[fmt.Sprint(key)] = convert(item)
+		}
+		return converted
+	case map[string]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			converted[key] = convert(item)
+		}
+		return converted
+	case []interface{}:
+		converted := make([]interface{}, len(value))
+		for index, item := range value {
+			converted[index] = convert(item)
+		}
+		return converted
+	default:
+		return value
+	}
+}
+
+func (v *Variant) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	type variantAlias Variant
+	var decoded variantAlias
+	if err := unmarshal(&decoded); err != nil {
+		return err
+	}
+	var fields map[interface{}]interface{}
+	if err := unmarshal(&fields); err != nil {
+		return err
+	}
+
+	*v = Variant(decoded)
+	for key := range fields {
+		if fmt.Sprint(key) == "attachment" && v.Attachment == nil {
+			v.attachmentSet = true
+			break
+		}
+	}
+	return nil
+}
