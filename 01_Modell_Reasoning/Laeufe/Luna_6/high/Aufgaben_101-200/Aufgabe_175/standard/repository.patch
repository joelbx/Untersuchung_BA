diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..3441d86
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,182 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupTimestamp = "20060102T150405.000000000Z"
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0o755); err != nil {
+		return "", fmt.Errorf("create backup directory: %w", err)
+	}
+	path := filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format(backupTimestamp)+".db")
+	dest, err := sql.Open(Driver, path)
+	if err != nil {
+		return "", err
+	}
+	defer dest.Close()
+
+	srcConn, err := d.readDB.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer srcConn.Close()
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer destConn.Close()
+	if err := sqliteOnlineBackup(ctx, destConn, srcConn); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file path is empty")
+	}
+	backupPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	databasePath, err := filepath.Abs(conf.Server.DbPath)
+	if err == nil && backupPath == databasePath {
+		return errors.New("cannot restore database from itself")
+	}
+	if _, err := os.Stat(backupPath); err != nil {
+		return fmt.Errorf("backup file is unavailable: %w", err)
+	}
+	source, err := sql.Open(Driver, backupPath)
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	srcConn, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	var check string
+	if err := srcConn.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&check); err != nil {
+		return fmt.Errorf("validate backup database: %w", err)
+	}
+	if check != "ok" {
+		return fmt.Errorf("backup database integrity check failed: %s", check)
+	}
+	var hasSchema bool
+	if err := srcConn.QueryRowContext(ctx, "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='goose_db_version')").Scan(&hasSchema); err != nil {
+		return fmt.Errorf("validate backup schema: %w", err)
+	}
+	if !hasSchema {
+		return errors.New("backup database does not contain a Navidrome schema")
+	}
+	destConn, err := d.writeDB.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	return sqliteOnlineBackup(ctx, destConn, srcConn)
+}
+
+func sqliteOnlineBackup(ctx context.Context, destConn, srcConn *sql.Conn) error {
+	return destConn.Raw(func(destRaw any) error {
+		dest, ok := destRaw.(*sqlite3.SQLiteConn)
+		if !ok {
+			return fmt.Errorf("unexpected SQLite destination connection %T", destRaw)
+		}
+		return srcConn.Raw(func(srcRaw any) error {
+			src, ok := srcRaw.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("unexpected SQLite source connection %T", srcRaw)
+			}
+			backup, err := dest.Backup("main", src, "main")
+			if err != nil {
+				return err
+			}
+			finished := false
+			defer func() {
+				if !finished {
+					_ = backup.Close()
+				}
+			}()
+			for {
+				if err := ctx.Err(); err != nil {
+					return err
+				}
+				done, err := backup.Step(-1)
+				if err != nil {
+					return err
+				}
+				if done {
+					finished = true
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return 0, nil
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return 0, nil
+		}
+		return 0, err
+	}
+	var backups []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") {
+			continue
+		}
+		stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), ".db")
+		if _, err := time.Parse(backupTimestamp, stamp); err == nil {
+			backups = append(backups, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(backups)))
+	count := conf.Server.Backup.Count
+	if count < 0 {
+		count = 0
+	}
+	if len(backups) <= count {
+		return 0, nil
+	}
+	removed := 0
+	for _, name := range backups[count:] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(dir, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
