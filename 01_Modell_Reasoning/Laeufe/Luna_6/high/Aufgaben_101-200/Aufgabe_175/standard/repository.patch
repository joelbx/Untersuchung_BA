 	g.Go(schedulePeriodicScan(ctx))
+	g.Go(schedulePeriodicBackup(ctx))
 
 	if err := g.Wait(); err != nil {
 		log.Error("Fatal error in Navidrome. Aborting", err)
 	}
 }
 
+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		backup := conf.Server.Backup
+		if backup.Path == "" || backup.Schedule == "" || backup.Count == 0 {
+			log.Info("Periodic backup is DISABLED")
+			return nil
+		}
+		log.Info("Scheduling periodic backup", "schedule", backup.Schedule)
+		err := scheduler.GetInstance().Add(backup.Schedule, func() {
+			path, err := db.Db().Backup(ctx)
+			if err != nil {
+				log.Error("Error creating scheduled backup", err)
+				return
+			}
+			log.Info("Created scheduled backup", "path", path)
+			if removed, err := db.Db().Prune(ctx); err != nil {
+				log.Error("Error pruning scheduled backups", err)
+			} else if removed > 0 {
+				log.Info("Pruned scheduled backups", "count", removed)
+			}
+		})
+		if err != nil {
+			log.Error("Error scheduling periodic backup", err)
+		}
+		return nil
+	}
+}
