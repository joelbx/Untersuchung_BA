+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+var (
+	backupFile  string
+	backupForce bool
+)
+
+func init() {
+	create := &cobra.Command{
+		Use:   "create",
+		Short: "Create a database backup",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			path, err := db.Db().Backup(cmd.Context())
+			if err == nil {
+				fmt.Fprintln(cmd.OutOrStdout(), path)
+			}
+			return err
+		},
+	}
+	prune := &cobra.Command{
+		Use:   "prune",
+		Short: "Prune old database backups",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if conf.Server.Backup.Count == 0 && !backupForce {
+				ok, err := confirm("backup.count is 0 and all backups will be deleted. Continue? [y/N] ")
+				if err != nil {
+					return err
+				}
+				if !ok {
+					return nil
+				}
+			}
+			removed, err := db.Db().Prune(cmd.Context())
+			if err == nil {
+				fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backup(s)\n", removed)
+			}
+			return err
+		},
+	}
+	restore := &cobra.Command{
+		Use:   "restore",
+		Short: "Restore the database from a backup",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if !backupForce {
+				ok, err := confirm("This will replace the current database. Continue? [y/N] ")
+				if err != nil {
+					return err
+				}
+				if !ok {
+					return nil
+				}
+			}
+			return db.Db().Restore(cmd.Context(), backupFile)
+		},
+	}
+	restore.Flags().StringVar(&backupFile, "backup-file", "", "path to the database backup to restore")
+	restore.Flags().BoolVar(&backupForce, "force", false, "skip confirmation")
+	_ = restore.MarkFlagRequired("backup-file")
+	prune.Flags().BoolVar(&backupForce, "force", false, "skip confirmation")
+
+	backup := &cobra.Command{Use: "backup", Short: "Create, prune, and restore database backups"}
+	backup.AddCommand(create, prune, restore)
+	rootCmd.AddCommand(backup)
+}
+
+func confirm(prompt string) (bool, error) {
+	fmt.Fprint(os.Stderr, prompt)
+	line, err := bufio.NewReader(os.Stdin).ReadString('\n')
+	if err != nil && len(line) == 0 {
+		return false, err
+	}
+	return strings.EqualFold(strings.TrimSpace(line), "y") || strings.EqualFold(strings.TrimSpace(line), "yes"), nil
+}
