+func readTeleportProxyPayload(reader *bufio.Reader) ([]byte, *apiSSH.HandshakePayload, error) {
+	const maxPayloadSize = 64 * 1024
+	var header []byte
+	for {
+		part, err := reader.ReadSlice(0)
+		header = append(header, part...)
+		if len(header) > maxPayloadSize {
+			return nil, nil, trace.BadParameter("Teleport proxy payload is too large")
+		}
+		if err == nil {
+			break
+		}
+		if err != bufio.ErrBufferFull {
+			return nil, nil, trace.Wrap(err, "missing null terminator")
+		}
+	}
+	payload := bytes.TrimSuffix(header, []byte{0})
+	payload = bytes.TrimPrefix(payload, []byte(apiSSH.ProxyHelloSignature))
+	var handshake apiSSH.HandshakePayload
+	if err := json.Unmarshal(payload, &handshake); err != nil {
+		return nil, nil, trace.Wrap(err, "invalid JSON payload")
+	}
+	return header, &handshake, nil
+}
+
+func teleportClientAddr(addr string) (net.Addr, error) {
+	parsed, err := utils.ParseAddr(addr)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if parsed.AddrNetwork == "tcp" {
+		return &net.TCPAddr{IP: net.ParseIP(parsed.Host()), Port: parsed.Port(0)}, nil
+	}
+	return stringAddr{network: parsed.AddrNetwork, addr: strings.TrimSpace(parsed.Addr)}, nil
+}
+
+type stringAddr struct {
+	network string
+	addr    string
+}
+
+func (a stringAddr) Network() string { return a.network }
+func (a stringAddr) String() string  { return a.addr }
