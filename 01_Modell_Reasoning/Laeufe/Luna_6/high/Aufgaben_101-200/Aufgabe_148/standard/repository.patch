 }
 
+func TestDetectTeleportProxySSH(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+
+	const preamble = `Teleport-Proxy{"clientAddr":"192.0.2.10:4567"}` + "\x00"
+	const banner = "SSH-2.0-Teleport\r\n"
+	go func() {
+		_, _ = io.WriteString(client, preamble+banner)
+	}()
+
+	conn, err := detect(server, false)
+	require.NoError(t, err)
+	require.Equal(t, ProtoSSH, conn.Protocol())
+	require.Equal(t, "192.0.2.10:4567", conn.RemoteAddr().String())
+
+	got := make([]byte, len(preamble)+len(banner))
+	_, err = io.ReadFull(conn, got)
+	require.NoError(t, err)
+	require.Equal(t, preamble+banner, string(got))
+}
