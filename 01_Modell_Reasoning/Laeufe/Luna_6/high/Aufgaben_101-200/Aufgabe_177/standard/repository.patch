diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..21c31d8
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,29 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chat users to allow lists',
+	timestamp: Date.UTC(2025, 5, 1),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settings = await db.getObjects(uids.map(uid => `user:${uid}:settings`));
+			const updates = [];
+			await Promise.all(settings.map(async (data, index) => {
+				if (!data || data.chatAllowList !== undefined || parseInt(data.restrictChat, 10) !== 1) {
+					return;
+				}
+				const uid = uids[index];
+				const following = await db.getSortedSetRange(`following:${uid}`, 0, -1);
+				updates.push([`user:${uid}:settings`, { chatAllowList: following.map(String) }]);
+			}));
+			if (updates.length) {
+				await db.setObjectBulk(updates);
+			}
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
