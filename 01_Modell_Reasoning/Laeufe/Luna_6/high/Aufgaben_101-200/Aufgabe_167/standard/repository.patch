diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..a93c7d4
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,118 @@
+package oci
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source builds filesystem snapshots from an OCI artifact repository.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+
+	mu       sync.RWMutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+// WithPollInterval configures how often the OCI artifact is checked for updates.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+// NewSource constructs a source for an OCI artifact repository.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, fmt.Errorf("poll interval must be positive")
+	}
+	if s.store == nil {
+		return nil, errors.New("OCI store must be provided")
+	}
+	return s, nil
+}
+
+// Get returns the latest snapshot, fetching OCI layers only when the artifact digest changes.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.mu.RLock()
+	currentDigest, currentSnapshot := s.digest, s.snapshot
+	s.mu.RUnlock()
+
+	s.logger.Debug("fetching OCI snapshot", zap.Stringer("digest", currentDigest))
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(currentDigest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	if response.Matched {
+		if currentSnapshot == nil {
+			return nil, errors.New("OCI store matched a digest before a snapshot was built")
+		}
+		return currentSnapshot, nil
+	}
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	s.mu.Lock()
+	s.snapshot, s.digest = snapshot, response.Digest
+	s.mu.Unlock()
+	s.logger.Debug("updated OCI snapshot", zap.Stringer("digest", response.Digest))
+	return snapshot, nil
+}
+
+// Subscribe polls for OCI changes until ctx is cancelled, sending only changed snapshots.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			s.mu.RLock()
+			before := s.digest
+			s.mu.RUnlock()
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				s.logger.Error("failed polling OCI snapshot", zap.Error(err))
+				continue
+			}
+			s.mu.RLock()
+			changed := before != s.digest
+			s.mu.RUnlock()
+			if !changed {
+				continue
+			}
+			s.logger.Debug("sending updated OCI snapshot")
+			select {
+			case <-ctx.Done():
+				return
+			case ch <- snapshot:
+			}
+		}
+	}
+}
+
+// String identifies this snapshot source.
+func (*Source) String() string { return "oci" }
