diff --git a/test/units/modules/network/nxos/test_nxos_vrf_af.py b/test/units/modules/network/nxos/test_nxos_vrf_af.py
index c26f480b..0e64b92d 100644
--- a/test/units/modules/network/nxos/test_nxos_vrf_af.py
+++ b/test/units/modules/network/nxos/test_nxos_vrf_af.py
@@ -62,3 +62,36 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_nxos_vrf_af_route_targets_mixed(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 65000:100\n'
+                                        '    route-target export 65000:100\n'
+                                        '    route-target export 65000:200\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='65000:100', direction='both'),
+            dict(rt='65000:200', direction='export', state='absent'),
+            dict(rt='65000:300', direction='import'),
+        ]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted([
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target export 65000:200', 'route-target import 65000:300',
+        ]))
+
+    def test_nxos_vrf_af_route_targets_idempotent(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv6 unicast\n'
+                                        '    route-target import 65000:100\n'
+                                        '    route-target export 65000:100\n')
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[dict(rt='65000:100')]))
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_match_current_rt(self):
+        commands = []
+        rt = dict(rt='65000:100', state='absent')
+        self.assertEqual(nxos_vrf_af.match_current_rt(
+            rt, 'import', 'route-target import 65000:100', commands),
+            ['no route-target import 65000:100'])
