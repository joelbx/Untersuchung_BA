+def match_current_rt(rt, direction, current, rt_commands):
+    """Append the command needed to match one route-target direction."""
+    command = 'route-target %s %s' % (direction, rt['rt'])
+    have = command in [line.strip() for line in current.splitlines()]
+    want = rt.get('state', 'present') == 'present'
+
+    if want and not have:
+        rt_commands.append(command)
+    elif have and not want:
+        rt_commands.append('no %s' % command)
+
+    return rt_commands
+
+
