+// ConvertFortinetToModel converts Fortinet advisories to CveContent.
+func ConvertFortinetToModel(cveID string, fortinets []cvedict.Fortinet) []CveContent {
+	cves := []CveContent{}
+	for _, fortinet := range fortinets {
+		refs := []Reference{}
+		for _, ref := range fortinet.References {
+			refs = append(refs, Reference{Link: ref.Link, Source: ref.Source})
+		}
+		cweIDs := []string{}
+		for _, cwe := range fortinet.Cwes {
+			cweIDs = append(cweIDs, cwe.CweID)
+		}
+		cves = append(cves, CveContent{
+			Type: Fortinet, CveID: cveID, Title: fortinet.Title,
+			Summary: fortinet.Summary, Cvss3Score: fortinet.Cvss3.BaseScore,
+			Cvss3Vector: fortinet.Cvss3.VectorString, Cvss3Severity: fortinet.Cvss3.BaseSeverity,
+			SourceLink: fortinet.AdvisoryURL, CweIDs: cweIDs, References: refs,
+			Published: fortinet.PublishedDate, LastModified: fortinet.LastModifiedDate,
+		})
+	}
+	return cves
+}
