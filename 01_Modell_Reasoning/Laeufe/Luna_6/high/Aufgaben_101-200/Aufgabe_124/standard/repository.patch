+	return api.describeOut, nil
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		mode           string
+		awsMode        string
+		wantThroughput bool
+	}{
+		{name: "on-demand", mode: billingModePayPerRequest, awsMode: dynamodb.BillingModePayPerRequest},
+		{name: "provisioned", mode: billingModeProvisioned, awsMode: dynamodb.BillingModeProvisioned, wantThroughput: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			api := &dynamoTestAPI{}
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{
+				BillingMode: tc.mode, ReadCapacityUnits: 17, WriteCapacityUnits: 23,
+			}, svc: api}
+			if err := b.createTable(context.Background(), tableName, fullPathKey); err != nil {
+				t.Fatal(err)
+			}
+			input := api.createInput
+			if got := aws.StringValue(input.BillingMode); got != tc.awsMode {
+				t.Errorf("BillingMode = %q, want %q", got, tc.awsMode)
+			}
+			if (input.ProvisionedThroughput != nil) != tc.wantThroughput {
+				t.Fatalf("ProvisionedThroughput present = %t, want %t", input.ProvisionedThroughput != nil, tc.wantThroughput)
+			}
+			if tc.wantThroughput && (aws.Int64Value(input.ProvisionedThroughput.ReadCapacityUnits) != 17 || aws.Int64Value(input.ProvisionedThroughput.WriteCapacityUnits) != 23) {
+				t.Errorf("unexpected provisioned throughput: %+v", input.ProvisionedThroughput)
+			}
+		})
+	}
+}
