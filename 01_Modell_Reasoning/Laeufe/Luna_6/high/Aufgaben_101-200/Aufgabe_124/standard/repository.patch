+func TestBillingModeDefaultsAndValidation(t *testing.T) {
+	cfg := Config{TableName: tableName}
+	if err := cfg.CheckAndSetDefaults(); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.BillingMode != billingModePayPerRequest {
+		t.Fatalf("expected default billing mode %q, got %q", billingModePayPerRequest, cfg.BillingMode)
+	}
+
+	for _, mode := range []string{billingModePayPerRequest, billingModeProvisioned} {
+		cfg := Config{TableName: tableName, BillingMode: mode}
+		if err := cfg.CheckAndSetDefaults(); err != nil {
+			t.Errorf("billing mode %q rejected: %v", mode, err)
+		}
+	}
+	if err := (&Config{TableName: tableName, BillingMode: "invalid"}).CheckAndSetDefaults(); err == nil {
+		t.Fatal("expected invalid billing mode to fail")
+	}
+}
