+func TestGetTableStatusReturnsBillingMode(t *testing.T) {
+	api := &dynamoTestAPI{describeOut: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+		BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+	}}}
+	b := &Backend{svc: api}
+	status, mode, err := b.getTableStatus(context.Background(), tableName)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status != tableStatusOK || mode != dynamodb.BillingModePayPerRequest {
+		t.Fatalf("got status %v and billing mode %q", status, mode)
+	}
