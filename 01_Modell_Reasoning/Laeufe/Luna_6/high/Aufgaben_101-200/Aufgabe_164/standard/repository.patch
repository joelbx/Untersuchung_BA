+func TestImport_NestedMetadataAndJSONComment(t *testing.T) {
+	const payload = `version: 1.4
+namespace:
+  key: nested
+  name: Nested Namespace
+  description: namespace description
+flags:
+  - key: complex
+    metadata:
+      nested:
+        enabled: true
+        labels: [one, two]
+      items:
+        - name: first
+          value: 42
+    variants:
+      - key: value
+        attachment:
+          nested: {enabled: true}
+          values: [one, two]
+`
+
+	for _, tc := range []struct {
+		name     string
+		encoding Encoding
+		input    string
+	}{
+		{name: "yaml", encoding: EncodingYAML, input: payload},
+		{name: "json with leading comment", encoding: EncodingJSON, input: "# Flipt export\n" + `{"version":"1.4","namespace":{"key":"nested","name":"Nested Namespace","description":"namespace description"},"flags":[{"key":"complex","metadata":{"nested":{"enabled":true,"labels":["one","two"]},"items":[{"name":"first","value":42}]},"variants":[{"key":"value","attachment":{"nested":{"enabled":true},"values":["one","two"]}}]}]}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "not found")}
+			err := NewImporter(creator).Import(context.Background(), tc.encoding, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "nested", Name: "Nested Namespace", Description: "namespace description"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, map[string]any{
+				"nested": map[string]any{"enabled": true, "labels": []any{"one", "two"}},
+				"items":  []any{map[string]any{"name": "first", "value": float64(42)}},
+			}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":{"enabled":true},"values":["one","two"]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
