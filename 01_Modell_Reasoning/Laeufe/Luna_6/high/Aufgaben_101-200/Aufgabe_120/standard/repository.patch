+class Batch:
+    """A 10,000-cover batch in a million-cover archive item."""
+
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id = item_id
+        self.batch_id = batch_id
+        self.size = size
+
+    def _norm_ids(self):
+        return f'{int(self.item_id):04d}', f'{int(self.batch_id):02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = f'{int(item_id):04d}', f'{int(batch_id):02d}'
+        size = (size or '').lower()
+        if size not in SIZES:
+            raise ValueError("size must be one of '', 's', 'm', or 'l'")
+        prefix = f'{size}_' if size else ''
+        folder = f'{prefix}covers_{item_id}'
+        return 'items/%s/%s_%s.%s' % (folder, folder, batch_id, ext.lstrip('.'))
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        uploader = uploader or Uploader
+        item_id, batch_id = self._norm_ids()
+        sizes = (self.size.lower(),) if self.size else SIZES
+        completed = True
+        found = False
+        for size in sizes:
+            filepath = self.get_abspath(item_id, batch_id, size)
+            if not os.path.isfile(filepath):
+                completed = False
+                continue
+            found = True
+            item_prefix = f'{size}_' if size else ''
+            item = f'{item_prefix}covers_{item_id}'
+            if upload and not test:
+                uploader.upload(item, [filepath])
+            if not uploader.is_uploaded(item, filepath):
+                completed = False
+        if finalize and found and completed and self.size is None and not test:
+            self.finalize(int(item_id) * 1_000_000 + int(batch_id) * 10_000, test)
 
