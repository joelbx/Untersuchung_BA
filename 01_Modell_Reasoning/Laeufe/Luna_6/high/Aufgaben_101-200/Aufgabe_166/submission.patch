+    @patch.object(DataLoader, '_get_file_contents')
+    def test_cache_none_does_not_cache(self, mock_def):
+        mock_def.return_value = (b'foo: bar', True)
+
+        for _ in range(2):
+            self.assertEqual(self._loader.load_from_file('dummy.yml', cache='none'), {'foo': 'bar'})
+
+        self.assertEqual(mock_def.call_count, 2)
+        self.assertEqual(self._loader._FILE_CACHE, {})
+
+    @patch.object(DataLoader, '_get_file_contents')
+    def test_cache_vaulted_caches_only_encrypted_data(self, mock_def):
+        mock_def.side_effect = [
+            (b'foo: bar', False),  # show_content=False marks decrypted vault data
+            (b'foo: bar', True),
+            (b'foo: bar', True),
+        ]
+
+        self.assertEqual(self._loader.load_from_file('vault.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(self._loader.load_from_file('vault.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(mock_def.call_count, 1)
+        self.assertEqual(self._loader._FILE_CACHE, {self._loader.path_dwim('vault.yml'): {'foo': 'bar'}})
+
+        self.assertEqual(self._loader.load_from_file('plain.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(self._loader.load_from_file('plain.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(mock_def.call_count, 3)
+        self.assertEqual(len(self._loader._FILE_CACHE), 1)
