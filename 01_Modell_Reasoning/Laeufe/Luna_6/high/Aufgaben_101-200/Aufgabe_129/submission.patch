+
+import React, { useState } from "react";
+
+import AccessibleButton from "../elements/AccessibleButton";
+import IconizedContextMenu from "./IconizedContextMenu";
+import { ChevronFace, useContextMenu } from "../../structures/ContextMenu";
+import UIStore from "../../../stores/UIStore";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "children" | "onClick"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+const KebabContextMenu: React.FC<Props> = ({ options, title, ...buttonProps }) => {
+    const [isOpen, setIsOpen] = useState(false);
+    const [isMenuOpen, menuRef, openMenu, closeMenu] = useContextMenu<HTMLButtonElement>();
+
+    const open = (event: React.SyntheticEvent) => {
+        openMenu(event);
+        setIsOpen(true);
+    };
+    const close = () => {
+        closeMenu();
+        setIsOpen(false);
+    };
+
+    return <>
+        <AccessibleButton
+            {...buttonProps}
+            inputRef={menuRef}
+            className={`mx_KebabContextMenu ${buttonProps.className || ""}`}
+            title={title}
+            aria-label={title}
+            aria-haspopup="true"
+            aria-expanded={isOpen}
+            onClick={open}
+            onKeyDown={(event) => {
+                if (event.key === "Escape" && isMenuOpen) {
+                    close();
+                    event.stopPropagation();
+                }
+            }}
+        >
+            <span className="mx_KebabContextMenu_icon" />
+        </AccessibleButton>
+        { isMenuOpen && menuRef.current && <IconizedContextMenu
+            {...{
+                top: menuRef.current.getBoundingClientRect().bottom + window.scrollY,
+                right: UIStore.instance.windowWidth - menuRef.current.getBoundingClientRect().right - window.scrollX,
+                rightAligned: true,
+                chevronFace: ChevronFace.None,
+            }}
+            onFinished={close}
+        >
+            { options }
+        </IconizedContextMenu> }
+    </>;
+};
+
+export default KebabContextMenu;
