+// installedPackageFields retains the empty release field emitted as two spaces
+// between VERSION and RELEASE in rpm -qa output.
+func installedPackageFields(line string) []string {
+	fields := strings.Fields(line)
+	if len(fields) >= 5 {
+		separator := regexp.MustCompile(`\s{2,}`).FindStringIndex(line)
+		if separator != nil && len(strings.Fields(line[:separator[0]])) == 3 &&
+			len(strings.Fields(line[:separator[1]])) == 3 {
+			fields = append(fields[:3], append([]string{""}, fields[3:]...)...)
+		}
+	}
+	return fields
+}
+
+func rpmVersion(epoch, version, release string) string {
+	result := version
+	if epoch != "0" && epoch != "(none)" {
+		result = epoch + ":" + result
+	}
+	if release != "" {
+		result += "-" + release
+	}
+	return result
+}
