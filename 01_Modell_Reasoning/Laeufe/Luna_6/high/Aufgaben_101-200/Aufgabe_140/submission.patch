@@ -73,6 +73,24 @@ class InvalidUrlError(Error):
         super().__init__(self.msg)
 
 
+def widened_hostnames(hostname: Optional[str]) -> Iterable[str]:
+    """Yield a hostname and each parent formed by removing its leftmost label.
+
+    Empty input yields no hostnames. A final dot is kept as part of the
+    hostname, and a trailing dot does not produce an empty parent.
+    """
+    if not hostname:
+        return
+
+    yield hostname
+    while True:
+        separator = hostname.find('.')
+        if separator < 0 or separator == len(hostname) - 1:
+            return
+        hostname = hostname[separator + 1:]
+        yield hostname
+
