+@pytest.mark.parametrize("blocked_host_set", ["runtime", "config"])
+def test_blocked_parent_domain_covers_subdomains(
+    config_stub, host_blocker_factory, blocked_host_set
+):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    host_blocker = host_blocker_factory()
+    blocked_hosts = (host_blocker._blocked_hosts if blocked_host_set == "runtime"
+                     else host_blocker._config_blocked_hosts)
+    blocked_hosts.add("example.com")
+
+    for url in (
+        "https://example.com/",
+        "https://sub.example.com/path",
+        "https://a.b.example.com/",
+        "https://sub.example.com./path",
+        "sub.example.com",
+    ):
+        assert host_blocker._is_blocked(QUrl(url))
+
+
+def test_whitelist_overrides_blocked_parent_domain(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = ["https://sub.example.com/*"]
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    assert not host_blocker._is_blocked(QUrl("https://sub.example.com/path"))
+
