+    def _valid_time_stamp(self, timestamp):
+        """Return a validated ZIP timestamp tuple, or the ZIP epoch."""
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.fullmatch(r'(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})', timestamp)
+        if not match:
+            return epoch
+
+        components = tuple(int(component) for component in match.groups())
+        if not 1980 <= components[0] <= 2107:
+            return epoch
+
+        try:
+            datetime.datetime(*components)
+        except ValueError:
+            return epoch
+
+        return components + (0, 0, 0)
+
