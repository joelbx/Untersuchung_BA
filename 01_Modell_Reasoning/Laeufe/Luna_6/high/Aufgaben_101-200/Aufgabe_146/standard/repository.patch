+    def get_sysinfo_facts(self):
+        """Read hardware facts exposed by IBM Z / s390 in /proc/sysinfo."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        sysinfo_keys = {
+            'Manufacturer': 'system_vendor',
+            'Type': 'product_name',
+            'Sequence Code': 'product_serial',
+        }
+
+        for line in get_file_lines('/proc/sysinfo'):
+            for source_key, fact_key in sysinfo_keys.items():
+                prefix = source_key + ':'
+                if line.startswith(prefix):
+                    value = line[len(prefix):].strip()
+                    if fact_key == 'product_serial':
+                        value = value.lstrip('0')
+                    sysinfo_facts[fact_key] = value
+                    break
+
+        return sysinfo_facts
+
