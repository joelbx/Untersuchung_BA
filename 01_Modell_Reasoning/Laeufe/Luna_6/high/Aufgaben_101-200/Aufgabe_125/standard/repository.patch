+					uid: postData.uid,
+				});
+			}));
+			await db.sortedSetAdd(`pid:${postData.pid}:backlinks`, Date.now(), tidsToAdd);
+		}
+
+		return tidsToRemove.length + tidsToAdd.length;
+	};
