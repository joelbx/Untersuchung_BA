+// NewDowngradedOSSAdminRole returns the restricted admin role used when
+// migrating OSS clusters to RBAC. Keeping the admin role name preserves
+// implicit admin-to-admin mappings between trusted clusters.
+func NewDowngradedOSSAdminRole() Role {
+	role := NewOSSUserRole().(*RoleV3)
+	role.SetName(teleport.AdminRoleName)
+	role.Metadata.Labels = map[string]string{teleport.OSSMigratedV6: types.True}
+	return role
+}
