+	TracingPropagatorB3Multi      TracingPropagator = "b3multi"
+	TracingPropagatorJaeger       TracingPropagator = "jaeger"
+	TracingPropagatorXRay         TracingPropagator = "xray"
+	TracingPropagatorOTTrace      TracingPropagator = "ottrace"
