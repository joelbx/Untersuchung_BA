+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name    string
+		header  string
+		present bool
+		want    semver.Version
+	}{
+		{name: "v prefix", header: "v1.2.3", present: true, want: semver.Version{Major: 1, Minor: 2, Patch: 3}},
+		{name: "without v prefix", header: "1.2.3", present: true, want: semver.Version{Major: 1, Minor: 2, Patch: 3}},
+		{name: "invalid", header: "not-a-version", present: true, want: semver.Version{}},
+		{name: "missing", want: semver.Version{}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.present {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.header))
+			}
+
+			called := false
+			_, err := FliptAcceptServerVersionUnaryInterceptor(nil)(ctx, nil, nil, func(ctx context.Context, _ interface{}) (interface{}, error) {
+				called = true
+				assert.Equal(t, tt.want, FliptAcceptServerVersionFromContext(ctx))
+				return nil, nil
+			})
+			require.NoError(t, err)
+			assert.True(t, called)
+		})
+	}
+}
