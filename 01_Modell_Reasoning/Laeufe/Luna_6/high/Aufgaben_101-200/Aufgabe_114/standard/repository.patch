+func artistFolder(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	for i := range dirs {
+		dirs[i] = filepath.Clean(dirs[i])
+	}
+	sort.Strings(dirs)
+	common := dirs[0]
+	for _, dir := range dirs[1:] {
+		for common != dir && !isParentDir(common, dir) {
+			parent := filepath.Dir(common)
+			if parent == common {
+				return ""
+			}
+			common = parent
+		}
+	}
+	// With only one album directory, its parent is the artist folder.
+	if len(dirs) == 1 {
+		common = filepath.Dir(common)
+	}
+	return common
+}
+
+func isParentDir(parent, child string) bool {
+	rel, err := filepath.Rel(parent, child)
+	return err == nil && rel != "." && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
+
+func fromArtistFolder(folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		entries, err := os.ReadDir(folder)
+		if err != nil {
+			return nil, "", err
+		}
+		for _, entry := range entries {
+			match, _ := filepath.Match("artist.*", strings.ToLower(entry.Name()))
+			if match && !entry.IsDir() {
+				file := filepath.Join(folder, entry.Name())
+				f, err := os.Open(file)
+				return f, file, err
+			}
+		}
+		return nil, "", nil
+	}
+}
