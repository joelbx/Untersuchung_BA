@@ -135,6 +135,25 @@ def test_password_hash_filter_passlib():
     assert get_encrypted_password("123", "pbkdf2_sha256")
 
 
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_password_hash_bcrypt_ident(ident):
+    result = get_encrypted_password('123', 'blowfish', salt='1234567890123456789012', ident=ident)
+    assert result.startswith('$%s$' % ident)
+
+
+def test_password_hash_bcrypt_invalid_ident():
+    with pytest.raises(AnsibleFilterError):
+        get_encrypted_password('123', 'bcrypt', salt='1234567890123456789012', ident='2x')
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+@pytest.mark.parametrize('ident', ('2', '2a', '2y', '2b'))
+def test_password_hash_bcrypt_ident_no_passlib(ident):
+    with passlib_off():
+        result = get_encrypted_password('123', 'bcrypt', salt='1234567890123456789012', ident=ident)
+    assert result.startswith('$%s$' % ident)
+
+
