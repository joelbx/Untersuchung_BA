diff --git a/lib/utils/parse/ast.go b/lib/utils/parse/ast.go
new file mode 100644
index 0000000..03d1d4a
--- /dev/null
+++ b/lib/utils/parse/ast.go
@@ -0,0 +1,230 @@
+package parse
+
+import (
+	"fmt"
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a typed expression node.
+type Expr interface {
+	Evaluate(EvaluateContext) (any, error)
+	Kind() reflect.Kind
+	String() string
+}
+
+// EvaluateContext provides the inputs needed to evaluate an expression.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string                        { return strconv.Quote(e.Value) }
+func (StringLitExpr) Kind() reflect.Kind                      { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) { return []string{e.Value}, nil }
+
+type VarExpr struct{ Namespace, Name string }
+
+func (e VarExpr) String() string   { return e.Namespace + "." + e.Name }
+func (VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("no variable resolver for %s", e)
+	}
+	return ctx.VarValue(e)
+}
+
+type EmailLocalExpr struct{ Inner Expr }
+
+func (e EmailLocalExpr) String() string   { return "email.local(" + e.Inner.String() + ")" }
+func (EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evalStrings(e.Inner, ctx)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("email.local input is empty")
+		}
+		addr, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("email.local could not parse address %q: %v", value, err)
+		}
+		at := strings.LastIndexByte(addr.Address, '@')
+		if at <= 0 {
+			return nil, trace.BadParameter("email.local address %q has no local part", addr.Address)
+		}
+		out = append(out, addr.Address[:at])
+	}
+	return out, nil
+}
+
+type RegexpReplaceExpr struct {
+	Inner                Expr
+	Pattern, Replacement string
+	re                   *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return "regexp.replace(" + e.Inner.String() + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evalStrings(e.Inner, ctx)
+	if err != nil {
+		return nil, err
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegex(e.Pattern)
+		if err != nil {
+			return nil, err
+		}
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if re.MatchString(value) {
+			out = append(out, re.ReplaceAllString(value, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string   { return "regexp.match(" + strconv.Quote(e.Pattern) + ")" }
+func (RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re, err := e.compiled()
+	if err != nil {
+		return nil, err
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+func (e RegexpMatchExpr) compiled() (*regexp.Regexp, error) {
+	if e.re != nil {
+		return e.re, nil
+	}
+	return compileRegex(e.Pattern)
+}
+
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	return "regexp.not_match(" + strconv.Quote(e.Pattern) + ")"
+}
+func (RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re, err := e.compiled()
+	if err != nil {
+		return nil, err
+	}
+	return !re.MatchString(ctx.MatcherInput), nil
+}
+func (e RegexpNotMatchExpr) compiled() (*regexp.Regexp, error) {
+	if e.re != nil {
+		return e.re, nil
+	}
+	return compileRegex(e.Pattern)
+}
+
+func compileRegex(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("invalid regexp pattern %q: %v", pattern, err)
+	}
+	return re, nil
+}
+func evalStrings(expr Expr, ctx EvaluateContext) ([]string, error) {
+	if expr == nil || expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %v", expr)
+	}
+	v, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, err
+	}
+	values, ok := v.([]string)
+	if !ok {
+		return nil, trace.BadParameter("expected string expression result, got %T", v)
+	}
+	return values, nil
+}
+func validateExpr(expr Expr) error {
+	var visit func(Expr) error
+	visit = func(node Expr) error {
+		switch n := node.(type) {
+		case VarExpr:
+			if n.Name == "" {
+				return trace.BadParameter("variable must have the form namespace.name")
+			}
+		case EmailLocalExpr:
+			return visit(n.Inner)
+		case RegexpReplaceExpr:
+			return visit(n.Inner)
+		}
+		return nil
+	}
+	return visit(expr)
+}
+
+type namespaceRef struct{ namespace string }
+
+func buildVarExpr(parts []string) (interface{}, error) {
+	if len(parts) == 1 {
+		if parts[0] == "internal" || parts[0] == "external" || parts[0] == LiteralNamespace {
+			return namespaceRef{parts[0]}, nil
+		}
+		return nil, trace.BadParameter("incomplete variable %q; expected namespace.name", parts[0])
+	}
+	if len(parts) != 2 {
+		return nil, trace.BadParameter("variable must have exactly two parts: namespace.name")
+	}
+	return newVar(parts[0], parts[1])
+}
+func buildVarExprFromProperty(base, key interface{}) (interface{}, error) {
+	ref, ok := base.(namespaceRef)
+	if !ok {
+		return nil, trace.BadParameter("variable selector must have the form namespace[\"name\"]")
+	}
+	name, ok := key.(string)
+	if !ok {
+		return nil, trace.BadParameter("variable name must be a string")
+	}
+	return newVar(ref.namespace, name)
+}
+func newVar(namespace, name string) (VarExpr, error) {
+	if namespace != "internal" && namespace != "external" && namespace != LiteralNamespace {
+		return VarExpr{}, trace.BadParameter("unsupported variable namespace %q", namespace)
+	}
+	if name == "" {
+		return VarExpr{}, trace.BadParameter("variable must have exactly two parts: namespace.name")
+	}
+	return VarExpr{Namespace: namespace, Name: name}, nil
+}
+func buildIdentifier(parts []string) (interface{}, error) { return buildVarExpr(parts) }
+
+func asExpr(v interface{}) (Expr, error) {
+	e, ok := v.(Expr)
+	if !ok {
+		return nil, trace.BadParameter("expected string expression, got %T", v)
+	}
+	if e.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %s", fmt.Sprint(e.Kind()))
+	}
+	return e, nil
+}
