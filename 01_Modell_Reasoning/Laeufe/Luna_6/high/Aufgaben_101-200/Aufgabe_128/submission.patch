diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..cf39ff9 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,56 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_implicitly_adds_set_match(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'src',
+            'destination_port': '22',
+            'jump': 'ACCEPT',
+            'comment': 'SSH from admin hosts',
+            '_ansible_check_mode': True,
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 0, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', 'src',
+            '-j', 'ACCEPT', '--destination-port', '22',
+            '-m', 'comment', '--comment', 'SSH from admin hosts'
+        ])
+
+    def test_match_set_with_explicit_match_and_inversion(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match': ['set'],
+            'match_set': '!blocked_hosts',
+            'match_set_flags': 'src,dst',
+            'jump': 'DROP',
+            '_ansible_check_mode': True,
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 0, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'blocked_hosts', 'src,dst',
+            '-j', 'DROP'
+        ])
+
+    def test_match_set_parameters_are_required_together(self):
+        for options in (
+                {'match_set': 'admin_hosts'},
+                {'match_set_flags': 'src'}):
+            set_module_args(dict({'chain': 'INPUT'}, **options))
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
