+
+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnknown DatabaseProtocol = iota
+	DatabaseProtocolSQLite
+	DatabaseProtocolPostgres
+	DatabaseProtocolMySQL
+
+	// Short names retained for consistency with the other configuration enums.
+	SQLite   = DatabaseProtocolSQLite
+	Postgres = DatabaseProtocolPostgres
+	MySQL    = DatabaseProtocolMySQL
+)
+
+var databaseProtocolNames = map[DatabaseProtocol]string{
+	SQLite:   "sqlite",
+	Postgres: "postgres",
+	MySQL:    "mysql",
+}
+
+func (p DatabaseProtocol) String() string {
+	if value, ok := databaseProtocolNames[p]; ok {
+		return value
+	}
+	return fmt.Sprintf("%d", p)
+}
+
+func parseDatabaseProtocol(value string) (DatabaseProtocol, bool) {
+	switch strings.ToLower(value) {
+	case "sqlite", "sqlite3":
+		return SQLite, true
+	case "postgres", "postgresql":
+		return Postgres, true
+	case "mysql":
+		return MySQL, true
+	default:
+		return DatabaseProtocolUnknown, false
+	}
+}
+
+// ConnectionURL returns the configured URL or builds one from the discrete settings.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.URL != "" {
+		parsed, err := url.Parse(d.URL)
+		if err != nil || parsed.Scheme == "" {
+			return "", errors.New("db.url: invalid database URL")
+		}
+		switch strings.ToLower(parsed.Scheme) {
+		case "file", "sqlite", "sqlite3", "postgres", "postgresql", "mysql":
+		default:
+			return "", fmt.Errorf("db.url: unsupported database protocol %q; expected sqlite, postgres, or mysql", parsed.Scheme)
+		}
+		return d.URL, nil
+	}
+	if _, ok := databaseProtocolNames[d.Protocol]; !ok {
+		return "", fmt.Errorf("db.protocol: invalid value %q; expected sqlite, postgres, or mysql", d.Protocol.String())
+	}
+	if d.Protocol == SQLite {
+		path := d.Path
+		if path == "" {
+			return "", errors.New("db.path: is required for sqlite")
+		}
+		return "file:" + path, nil
+	}
+	if d.Host == "" {
+		return "", errors.New("db.host: is required")
+	}
+	if d.Name == "" {
+		return "", errors.New("db.name: is required")
+	}
+	port := d.Port
+	if port < 0 || port > 65535 {
+		return "", fmt.Errorf("db.port: invalid value %d; expected a port from 1 to 65535", port)
+	}
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	scheme := d.Protocol.String()
+	var credentials *url.Userinfo
+	if d.User != "" {
+		if d.Password != "" {
+			credentials = url.UserPassword(d.User, d.Password)
+		} else {
+			credentials = url.User(d.User)
+		}
+	}
+	u := url.URL{Scheme: scheme, User: credentials, Host: net.JoinHostPort(d.Host, strconv.Itoa(port)), Path: "/" + d.Name}
+	return u.String(), nil
 }
 
