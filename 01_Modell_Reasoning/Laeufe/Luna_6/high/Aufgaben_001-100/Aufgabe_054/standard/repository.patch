+// GetInstance returns the singleton instance of T, creating it with constructor
+// the first time GetInstance is called for that exact type.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+
+	instanceMu.Lock()
+	entry, exists := instanceMap[typeOfT]
+	if !exists {
+		entry = &genericEntry{}
+		instanceMap[typeOfT] = entry
+	}
+	instanceMu.Unlock()
+
+	entry.once.Do(func() {
+		entry.instance = genericValue[T]{value: constructor()}
+	})
+
+	return entry.instance.(genericValue[T]).value
+}
