index 9014e4e..c8a7d16 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -17,6 +17,57 @@ func TestSingleton(t *testing.T) {
 	RunSpecs(t, "Singleton Suite")
 }
 
+type genericSingleton struct {
+	id int
+}
+
+type concurrentGenericSingleton struct {
+	id int32
+}
+
+var _ = Describe("GetInstance", func() {
+	It("keeps value and pointer type parameters in separate singletons", func() {
+		value := singleton.GetInstance(func() genericSingleton {
+			return genericSingleton{id: 1}
+		})
+		pointer := singleton.GetInstance(func() *genericSingleton {
+			return &genericSingleton{id: 2}
+		})
+
+		Expect(value.id).To(Equal(1))
+		Expect(pointer.id).To(Equal(2))
+	})
+
+	It("calls the constructor only once across 20,000 concurrent calls", func() {
+		const maxCalls = 20000
+		var constructorCalls int32
+		instances := make([]*concurrentGenericSingleton, maxCalls)
+		start := make(chan struct{})
+		var calls sync.WaitGroup
+		calls.Add(maxCalls)
+
+		for i := range instances {
+			go func(i int) {
+				defer calls.Done()
+				<-start
+				instances[i] = singleton.GetInstance(func() *concurrentGenericSingleton {
+					id := atomic.AddInt32(&constructorCalls, 1)
+					return &concurrentGenericSingleton{id: id}
+				})
+			}(i)
+		}
+
+		close(start)
+		calls.Wait()
+
+		Expect(atomic.LoadInt32(&constructorCalls)).To(Equal(int32(1)))
+		for _, instance := range instances {
+			Expect(instance).To(BeIdenticalTo(instances[0]))
+			Expect(instance.id).To(Equal(int32(1)))
+		}
+	})
+})
