+// NewWriterEmitter creates an emitter that writes audit events as JSON lines.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		WriterLog: *NewWriterLog(w),
+		writer:    w,
+	}
+}
+
+// WriterEmitter emits audit events to an external writer.
+type WriterEmitter struct {
+	WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent marshals an audit event to JSON and writes it as a line.
+func (w *WriterEmitter) EmitAuditEvent(_ context.Context, event AuditEvent) error {
+	data, err := utils.FastMarshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	data = append(data, '\n')
+	n, err := w.writer.Write(data)
+	if err == nil && n != len(data) {
+		err = io.ErrShortWrite
+	}
+	return trace.ConvertSystemError(err)
+}
+
+// Close closes the writer and its embedded legacy log.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(
+		trace.ConvertSystemError(w.writer.Close()),
+		trace.ConvertSystemError(w.WriterLog.Close()),
+	)
+}
+
