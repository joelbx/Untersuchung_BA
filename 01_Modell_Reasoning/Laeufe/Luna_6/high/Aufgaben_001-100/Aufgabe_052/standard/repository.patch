+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package model
+
+import (
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// TokenCounter returns a token count.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll returns the sum of all counters.
+func (counters TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range counters {
+		if counter != nil {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount aggregates prompt and completion token usage for one invocation.
+type TokenCount struct {
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount creates an empty token count.
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+
+// AddPromptCounter adds a prompt-side counter. Nil counters are ignored.
+func (t *TokenCount) AddPromptCounter(counter TokenCounter) {
+	if t != nil && counter != nil {
+		t.prompt = append(t.prompt, counter)
+	}
+}
+
+// AddCompletionCounter adds a completion-side counter. Nil counters are ignored.
+func (t *TokenCount) AddCompletionCounter(counter TokenCounter) {
+	if t != nil && counter != nil {
+		t.completion = append(t.completion, counter)
+	}
+}
+
+// CountAll returns prompt and completion totals, in that order.
+func (t *TokenCount) CountAll() (int, int) {
+	if t == nil {
+		return 0, 0
+	}
+	return t.prompt.CountAll(), t.completion.CountAll()
+}
+
+// StaticTokenCounter is a fixed token count.
+type StaticTokenCounter struct{ count int }
+
+// TokenCount returns the fixed count.
+func (c *StaticTokenCounter) TokenCount() int {
+	if c == nil {
+		return 0
+	}
+	return c.count
+}
+
+// NewPromptTokenCounter counts prompt tokens using cl100k_base.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	count := 0
+	for _, message := range messages {
+		tokens, _, err := tokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter counts a complete response using cl100k_base.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter counts completion tokens as stream chunks arrive.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter initializes a streaming counter with its first fragment.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add increments the streamed token count by one.
+func (c *AsynchronousTokenCounter) Add() error {
+	if c == nil {
+		return trace.Errorf("cannot add to a nil token counter")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.Errorf("token counter has already been finalized")
+	}
+	c.count++
+	return nil
+}
+
+// TokenCount finalizes the counter and returns its value including request overhead.
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	if c == nil {
+		return perRequest
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
