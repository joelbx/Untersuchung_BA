+// DiffStatus indicates how a vulnerability changed between scans.
+type DiffStatus string
+
+const (
+	DiffPlus  DiffStatus = "+"
+	DiffMinus DiffStatus = "-"
+)
+
+// CountDiff counts newly detected and resolved vulnerabilities.
+func (v VulnInfos) CountDiff() (nPlus int, nMinus int) {
+	for _, vuln := range v {
+		switch vuln.DiffStatus {
+		case DiffPlus:
+			nPlus++
+		case DiffMinus:
+			nMinus++
+		}
+	}
+	return
+}
