+func TestDiffStatusHelpers(t *testing.T) {
+	vulns := VulnInfos{
+		"CVE-NEW":  {CveID: "CVE-NEW", DiffStatus: DiffPlus},
+		"CVE-OLD":  {CveID: "CVE-OLD", DiffStatus: DiffMinus},
+		"CVE-SAME": {CveID: "CVE-SAME"},
+	}
+	if plus, minus := vulns.CountDiff(); plus != 1 || minus != 1 {
+		t.Fatalf("CountDiff() = (%d, %d), want (1, 1)", plus, minus)
+	}
+	if got := vulns["CVE-NEW"].CveIDDiffFormat(true); got != "+CVE-NEW" {
+		t.Fatalf("CveIDDiffFormat(true) = %q, want %q", got, "+CVE-NEW")
+	}
+	if got := vulns["CVE-OLD"].CveIDDiffFormat(true); got != "-CVE-OLD" {
+		t.Fatalf("CveIDDiffFormat(true) = %q, want %q", got, "-CVE-OLD")
+	}
+	if got := vulns["CVE-NEW"].CveIDDiffFormat(false); got != "CVE-NEW" {
+		t.Fatalf("CveIDDiffFormat(false) = %q, want %q", got, "CVE-NEW")
+	}
+}
