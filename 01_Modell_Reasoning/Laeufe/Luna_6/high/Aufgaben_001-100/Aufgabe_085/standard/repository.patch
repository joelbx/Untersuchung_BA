+func TestDiffIncludesRequestedStatusesAndPackages(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"CVE-NEW":  {CveID: "CVE-NEW", AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+			"CVE-SAME": {CveID: "CVE-SAME"},
+		},
+		Packages: models.Packages{"new-pkg": {Name: "new-pkg", Version: "2"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"CVE-OLD":  {CveID: "CVE-OLD", AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+			"CVE-SAME": {CveID: "CVE-SAME"},
+		},
+		Packages: models.Packages{"old-pkg": {Name: "old-pkg", Version: "1"}},
+	}
+
+	got := getDiffCves(previous, current, true, true)
+	if len(got) != 2 || got["CVE-NEW"].DiffStatus != models.DiffPlus || got["CVE-OLD"].DiffStatus != models.DiffMinus {
+		t.Fatalf("unexpected combined diff: %#v", got)
+	}
+	plusOnly := getDiffCves(previous, current, true, false)
+	if len(plusOnly) != 1 || plusOnly["CVE-NEW"].DiffStatus != models.DiffPlus {
+		t.Fatalf("unexpected plus-only diff: %#v", plusOnly)
+	}
+	minusOnly := getDiffCves(previous, current, false, true)
+	if len(minusOnly) != 1 || minusOnly["CVE-OLD"].DiffStatus != models.DiffMinus {
+		t.Fatalf("unexpected minus-only diff: %#v", minusOnly)
+	}
+
+	results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if results[0].Packages["new-pkg"].Version != "2" || results[0].Packages["old-pkg"].Version != "1" {
+		t.Fatalf("package data did not come from the corresponding scan: %#v", results[0].Packages)
+	}
+}
