diff --git a/openlibrary/catalog/utils/__init__.py b/openlibrary/catalog/utils/__init__.py
index 36b2e9f..8badaa5 100644
--- a/openlibrary/catalog/utils/__init__.py
+++ b/openlibrary/catalog/utils/__init__.py
@@ -454,11 +454,38 @@ def format_languages(languages: Iterable) -> list[dict[str, str]]:
     if not languages:
         return []
 
+    # Import locally to avoid coupling catalog utilities to upstream utilities
+    # during module initialization.
+    from openlibrary.plugins.upstream.utils import (
+        LanguageMultipleMatchError,
+        LanguageNoMatchError,
+        convert_iso_to_marc,
+        get_abbrev_from_full_lang_name,
+        get_marc21_language,
+    )
+
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
+        normalized = language.strip().casefold()
+        code = get_marc21_language(normalized)
+        if code is None and len(normalized) == 2:
+            code = convert_iso_to_marc(normalized)
+        if code is None:
+            try:
+                code = get_abbrev_from_full_lang_name(language)
+            except (LanguageNoMatchError, LanguageMultipleMatchError):
+                code = None
+
+        code = (code or normalized).lower()
+        key = f'/languages/{code}'
+        if web.ctx.site.get(key) is None:
+            raise InvalidLanguage(normalized)
+
+        if key in seen:
+            continue
+        seen.add(key)
 
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        formatted_languages.append({'key': key})
 
     return formatted_languages
