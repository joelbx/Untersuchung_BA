 from datetime import datetime, timedelta
 
 import pytest
+import web
 
 from openlibrary.catalog.utils import (
     InvalidLanguage,
@@ -443,3 +444,34 @@ def test_format_languages(languages: list[str], expected: list[dict[str, str]])
 def test_format_language_rasise_for_invalid_language(languages: list[str]) -> None:
     with pytest.raises(InvalidLanguage):
         format_languages(languages)
+
+
+def test_format_languages_normalizes_and_deduplicates(monkeypatch: pytest.MonkeyPatch) -> None:
+    from openlibrary.plugins.upstream import utils as upstream_utils
+
+    class Site:
+        def get(self, key: str) -> object | None:
+            return (
+                object()
+                if key in {"/languages/ger", "/languages/spa", "/languages/eng"}
+                else None
+            )
+
+    monkeypatch.setattr(web.ctx, "site", Site(), raising=False)
+    monkeypatch.setattr(
+        upstream_utils,
+        "get_marc21_language",
+        lambda token: {"eng": "eng", "ger": "ger", "es": "spa"}.get(token),
+    )
+    monkeypatch.setattr(upstream_utils, "convert_iso_to_marc", lambda token: "spa")
+    monkeypatch.setattr(
+        upstream_utils,
+        "get_abbrev_from_full_lang_name",
+        lambda name: "ger" if name.casefold() in {"german", "deutsch"} else None,
+    )
+
+    assert format_languages(["German", "Deutsch", "es", "eng", "eng"]) == [
+        {"key": "/languages/ger"},
+        {"key": "/languages/spa"},
+        {"key": "/languages/eng"},
+    ]
