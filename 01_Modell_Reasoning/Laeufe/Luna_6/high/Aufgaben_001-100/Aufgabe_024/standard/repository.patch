+def _normalized_name(name: str) -> str:
+    return re.sub(r"[^\w]+", "", name.casefold(), flags=re.UNICODE)
+
+
+def remove_author_honorifics(name: str) -> str:
+    """Remove one supported leading honorific from a name string."""
+    exceptions = {_normalized_name(value) for value in HONORIFC_NAME_EXECPTIONS}
+    if _normalized_name(name) in exceptions:
+        return name
+
+    for honorific in HONORIFICS:
+        if name[: len(honorific)].casefold() != honorific.casefold():
+            continue
+        remainder = name[len(honorific) :]
+        if not remainder or not remainder[0].isspace():
+            continue
+        cleaned = remainder.lstrip()
+        return cleaned if cleaned else name
+    return name
 
 
