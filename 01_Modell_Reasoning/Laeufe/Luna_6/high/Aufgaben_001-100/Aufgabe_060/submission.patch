+def _resolve_author(key: str) -> "Author | None":
+    """Load an author key and follow any redirect to its current target."""
+    obj = web.ctx.site.get(key)
+    seen = set()
+    while obj and obj.type.key == '/type/redirect':
+        if obj.key in seen or obj.get('location') == obj.key:
+            return None
+        seen.add(obj.key)
+        obj = web.ctx.site.get(obj.location)
+    if obj and obj.type.key == '/type/author':
+        return obj
+    return None
+
+
+def find_author_by_remote_ids(remote_ids: dict[str, str]) -> "Author | None":
+    """Find the most consistently identified author, with a stable key tie-break."""
+    matches: dict[str, tuple["Author", int]] = {}
+    for identifier, value in sorted(remote_ids.items()):
+        keys = web.ctx.site.things(
+            {'type': '/type/author', 'remote_ids': {identifier: value}}
+        )
+        for key in keys:
+            candidate = _resolve_author(key)
+            if candidate:
+                count = matches.get(candidate.key, (candidate, 0))[1] + 1
+                matches[candidate.key] = (candidate, count)
+    if not matches:
+        return None
+    return min(matches.values(), key=lambda item: (-item[1], key_int(item[0])))[0]
+
