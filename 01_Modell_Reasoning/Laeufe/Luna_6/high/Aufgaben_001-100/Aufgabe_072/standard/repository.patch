+import punycode from 'punycode.js';
+
 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
 
+/** Extract the main domain label from a URL without relying on browser URL parsing. */
+export const getHostnameWithRegex = (url: string): string => {
+    const match = url.match(/(?:^|:\/\/)(?:[^/@]+@)?(?:www\.)?([^./:?#]+)\.[^./:?#]+/i);
+    return match?.[1] || '';
+};
+
+/** Convert the hostname to ASCII while retaining the rest of the URL. */
+export const punycodeUrl = (url: string): string => {
+    try {
+        const parsed = new URL(url);
+        if (!parsed.hostname) {
+            return url;
+        }
+
+        const hostname = punycode.toASCII(parsed.hostname);
+        const credentials = parsed.username ? `${parsed.username}${parsed.password ? `:${parsed.password}` : ''}@` : '';
+        const pathname = parsed.pathname.replace(/\/+$/, '');
+
+        return `${parsed.protocol}//${credentials}${hostname}${parsed.port ? `:${parsed.port}` : ''}${pathname}${
+            parsed.search
+        }${parsed.hash}`;
+    } catch {
+        return url;
+    }
+};
