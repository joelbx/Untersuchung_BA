diff --git a/internal/info/flipt.go b/internal/info/flipt.go
new file mode 100644
index 0000000..adcbe4e
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,31 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt describes build and update information exposed by the meta endpoint.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the information as JSON.
+func (f Flipt) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	out, err := json.Marshal(f)
+	if err != nil {
+		http.Error(w, "failed to serialize info", http.StatusInternalServerError)
+		return
+	}
+	if _, err := w.Write(out); err != nil {
+		// A response write may already have committed headers; the status is
+		// still set for writers that have not committed yet.
+		w.WriteHeader(http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..d3c98fe
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,202 @@
+// Package telemetry reports anonymous Flipt usage events.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion  = "1.0"
+	stateFilename  = "telemetry.json"
+	reportInterval = 4 * time.Hour
+	endpoint       = "https://telemetry.flipt.io/v1/track"
+)
+
+// FliptVersion is set by the executable before the reporter starts.
+var FliptVersion = "dev"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type event struct {
+	AnonymousID string                 `json:"anonymousId"`
+	Event       string                 `json:"event"`
+	Properties  map[string]interface{} `json:"properties"`
+}
+
+// Reporter manages the persisted anonymous identity and telemetry events.
+type Reporter struct {
+	statePath string
+	state     state
+	logger    logrus.FieldLogger
+	client    *http.Client
+	mu        sync.Mutex
+}
+
+// NewReporter creates a reporter when telemetry is enabled. A state path that
+// is a regular file disables reporting without affecting the application.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil {
+		return nil, errors.New("telemetry config is nil")
+	}
+	if !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	if logger == nil {
+		logger = logrus.New()
+	}
+
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		configDir, err := os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("finding user config directory: %w", err)
+		}
+		dir = filepath.Join(configDir, "flipt")
+	}
+
+	if info, err := os.Stat(dir); err == nil && !info.IsDir() {
+		logger.Warnf("telemetry disabled: state path %q is not a directory", dir)
+		return nil, nil
+	} else if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("checking telemetry state directory: %w", err)
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("creating telemetry state directory: %w", err)
+	}
+
+	r := &Reporter{
+		statePath: filepath.Join(dir, stateFilename),
+		logger:    logger,
+		client:    &http.Client{Timeout: 10 * time.Second},
+	}
+	if err := r.loadState(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *Reporter) loadState() error {
+	data, err := os.ReadFile(r.statePath)
+	if err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if err == nil {
+		if decodeErr := json.Unmarshal(data, &r.state); decodeErr != nil {
+			r.logger.Warnf("reading telemetry state, initializing new state: %v", decodeErr)
+			r.state = state{}
+		}
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, genErr := uuid.NewV4()
+		if genErr != nil {
+			return fmt.Errorf("generating telemetry identifier: %w", genErr)
+		}
+		r.state.UUID = id.String()
+	}
+	r.state.Version = schemaVersion
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	}
+	if err := r.writeState(); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	return nil
+}
+
+func (r *Reporter) writeState() error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := r.statePath + ".tmp"
+	if err := os.WriteFile(tmp, data, 0600); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, r.statePath); err != nil {
+		_ = os.Remove(tmp)
+		return err
+	}
+	return nil
+}
+
+// Start reports immediately and then every four hours until ctx is cancelled.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		if err := r.Report(ctx); err != nil {
+			r.logger.Errorf("reporting telemetry: %v", err)
+		}
+		ticker := time.NewTicker(reportInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				if err := r.Report(ctx); err != nil {
+					r.logger.Errorf("reporting telemetry: %v", err)
+				}
+			}
+		}
+	}()
+}
+
+// Report sends one anonymous ping and persists the successful report time.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	payload := event{
+		AnonymousID: r.state.UUID,
+		Event:       "flipt.ping",
+		Properties: map[string]interface{}{
+			"uuid":    r.state.UUID,
+			"version": r.state.Version,
+			"flipt":   map[string]string{"version": FliptVersion},
+		},
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("encoding telemetry event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating telemetry request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending telemetry event: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending telemetry event: server returned %s", resp.Status)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := r.writeState(); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	return nil
+}
