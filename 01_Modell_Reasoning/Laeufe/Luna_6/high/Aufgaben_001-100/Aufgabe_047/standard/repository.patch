+// SetSeed assigns the specified seed to an identifier. The same identifier,
+// seed, and input always produce the same hash.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.seeds == nil {
+		h.seeds = make(map[string]string)
+	}
+	h.seeds[id] = seed
