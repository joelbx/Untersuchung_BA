+func TestLoadWithoutPathUsesDefaultsAndEnvironment(t *testing.T) {
+	type envValue struct {
+		value  string
+		exists bool
+	}
+	previous := make(map[string]envValue)
+	for _, key := range []string{"FLIPT_LOG_LEVEL", "FLIPT_SERVER_HTTP_PORT"} {
+		value, exists := os.LookupEnv(key)
+		previous[key] = envValue{value: value, exists: exists}
+		require.NoError(t, os.Unsetenv(key))
+	}
+	t.Cleanup(func() {
+		for key, original := range previous {
+			if original.exists {
+				_ = os.Setenv(key, original.value)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		}
+	})
+
+	res, err := Load("")
+	require.NoError(t, err)
+	assert.Equal(t, "INFO", res.Config.Log.Level)
+	assert.Equal(t, 8080, res.Config.Server.HTTPPort)
+
+	require.NoError(t, os.Setenv("FLIPT_LOG_LEVEL", "debug"))
+	require.NoError(t, os.Setenv("FLIPT_SERVER_HTTP_PORT", "8123"))
+
+	res, err = Load("")
+	require.NoError(t, err)
+	assert.Equal(t, "debug", res.Config.Log.Level)
+	assert.Equal(t, 8123, res.Config.Server.HTTPPort)
+}
+
+func TestLoadEnvironmentOverridesFile(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(configPath, []byte("log:\n  level: WARN\nserver:\n  http_port: 9090\n"), 0600))
+	t.Setenv("FLIPT_LOG_LEVEL", "debug")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8123")
+
+	res, err := Load(configPath)
+	require.NoError(t, err)
+	assert.Equal(t, "debug", res.Config.Log.Level)
+	assert.Equal(t, 8123, res.Config.Server.HTTPPort)
+}
