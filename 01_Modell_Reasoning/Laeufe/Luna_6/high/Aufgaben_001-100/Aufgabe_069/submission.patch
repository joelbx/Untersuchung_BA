+// Matcher evaluates whether an input string satisfies a parsed string pattern.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct{ regexp *regexp.Regexp }
+
+func (m regexpMatcher) Match(in string) bool { return m.regexp.MatchString(in) }
+
+type prefixSuffixMatcher struct {
+	prefix, suffix string
+	matcher        Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct{ matcher Matcher }
+
+func (m notMatcher) Match(in string) bool { return !m.matcher.Match(in) }
+
+type emailLocalMatcher struct{ matcher Matcher }
+
+func (m emailLocalMatcher) Match(in string) bool {
+	addr, err := mail.ParseAddress(in)
+	if err != nil {
+		return false
+	}
+	parts := strings.SplitN(addr.Address, "@", 2)
+	return len(parts) == 2 && m.matcher.Match(parts[0])
+}
+
+// Match parses a literal, wildcard, regular expression, or matcher function expression.
+func Match(value string) (Matcher, error) {
+	match := reVariable.FindStringSubmatch(value)
+	if len(match) == 0 {
+		if strings.Count(value, "{{") > 1 && strings.Count(value, "}}") > 1 {
+			return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+		}
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+		}
+		return compileMatcher(value)
+	}
+
+	prefix, expression, suffix := match[1], strings.TrimSpace(match[2]), match[3]
+	parsed, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	call, ok := parsed.(*ast.CallExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	matcher, err := parseMatcherCall(call)
+	if err != nil {
+		return nil, err
+	}
+	if prefix != "" || suffix != "" {
+		matcher = prefixSuffixMatcher{
+			prefix:  prefix,
+			suffix:  suffix,
+			matcher: matcher,
+		}
+	}
+	return matcher, nil
+}
+
+func compileMatcher(pattern string) (Matcher, error) {
+	if strings.HasPrefix(pattern, "^") && strings.HasSuffix(pattern, "$") {
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+		}
+		return regexpMatcher{regexp: re}, nil
+	}
+	pattern = "^" + utils.GlobToRegexp(pattern) + "$"
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return regexpMatcher{regexp: re}, nil
+}
+
+func parseMatcherCall(call *ast.CallExpr) (Matcher, error) {
+	sel, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, trace.BadParameter("unsupported matcher function %T", call.Fun)
+	}
+	namespace, ok := sel.X.(*ast.Ident)
+	if !ok {
+		return nil, trace.BadParameter("unsupported matcher function %v", sel)
+	}
+	if namespace.Name != RegexpNamespace && namespace.Name != EmailNamespace {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+	fn := sel.Sel.Name
+	if namespace.Name == RegexpNamespace && fn != "match" && fn != "not_match" {
+		return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match", fn)
+	}
+	if namespace.Name == EmailNamespace && fn != EmailLocalFnName {
+		return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", fn)
+	}
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("function %s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	lit, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || lit.Kind != token.STRING {
+		return nil, trace.BadParameter("function %s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	pattern, err := strconv.Unquote(lit.Value)
+	if err != nil {
+		return nil, trace.BadParameter("function %s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	switch namespace.Name {
+	case RegexpNamespace:
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+		}
+		matcher := Matcher(regexpMatcher{regexp: re})
+		if fn == "not_match" {
+			return notMatcher{matcher: matcher}, nil
+		}
+		return matcher, nil
+	case EmailNamespace:
+		matcher, err := compileMatcher(pattern)
+		if err != nil {
+			return nil, err
+		}
+		return emailLocalMatcher{matcher: matcher}, nil
+	default:
+		panic("unreachable")
+	}
+}
+
+func matcherFunction(node ast.Node) bool {
+	found := false
+	ast.Inspect(node, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		if namespace, ok := selector.X.(*ast.Ident); ok && namespace.Name == RegexpNamespace {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
+
