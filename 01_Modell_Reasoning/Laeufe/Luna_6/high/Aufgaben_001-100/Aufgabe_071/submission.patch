+def _decode_clixml_text(value: str) -> str:
+    """Decode PowerShell's escaped UTF-16 code units in a CLIXML string."""
+    escape_re = re.compile(r'_x([0-9a-f]{4})_', re.IGNORECASE)
+    matches = list(escape_re.finditer(value))
+    decoded = []
+    index = 0
+    cursor = 0
+
+    while index < len(matches):
+        match = matches[index]
+        unit = int(match.group(1), 16)
+        decoded.append(value[cursor:match.start()])
+
+        # PowerShell uses an escaped underscore to protect the following
+        # escape. A standalone escaped underscore is literal CLIXML text.
+        if unit == 0x005F:
+            if match.group(0) == '_x005F_' and not (
+                index + 1 < len(matches) and matches[index + 1].start() == match.end()
+            ):
+                decoded.append(match.group(0))
+            else:
+                decoded.append('_')
+            cursor = match.end()
+            index += 1
+            continue
+
+        if 0xD800 <= unit <= 0xDBFF and index + 1 < len(matches):
+            next_match = matches[index + 1]
+            next_unit = int(next_match.group(1), 16)
+            if next_match.start() == match.end() and 0xDC00 <= next_unit <= 0xDFFF:
+                decoded.append(chr(0x10000 + ((unit - 0xD800) << 10) + next_unit - 0xDC00))
+                cursor = next_match.end()
+                index += 2
+                continue
+        decoded.append(chr(unit))
+        cursor = match.end()
+        index += 1
+
+    decoded.append(value[cursor:])
+    return ''.join(decoded)
+
