+def test_parse_clixml_decodes_utf16_escapes():
+    clixml = b'<Objs><S S="Error">_x263A__xD83D__xDE00__x000D__x000A_</S></Objs>'
+    assert _parse_clixml(clixml) == '\u263a\U0001f600\r\n'.encode()
+
+
+def test_parse_clixml_preserves_invalid_and_unpaired_escapes():
+    clixml = b'<Objs><S S="Error">_x005G_ _xD800_</S></Objs>'
+    assert _parse_clixml(clixml) == '_x005G_ \ud800'.encode('utf-8', 'surrogatepass')
+
+
+def test_parse_clixml_underscore_escapes():
+    clixml = b'<Objs><S S="Error">_x005F_ _x005F__x000A_ _x005f_</S></Objs>'
+    assert _parse_clixml(clixml) == b'_x005F_ _\n _'
+
+
+def test_parse_clixml_empty_and_multiple_blocks():
+    clixml = b'<Objs><S S="Error" /></Objs><Objs><S S="Info">ignored</S>' \
+             b'<S S="Error">first</S><S S="Error" /></Objs>' \
+             b'<Objs><S S="Error">second</S></Objs>'
+    assert _parse_clixml(clixml) == b'first\r\nsecond'
+    assert _parse_clixml(b'<Objs><S S="Error" /></Objs>') == b''
+    assert _parse_clixml(b'<Objs><S S="Info">ignored</S></Objs>') == b''
+
