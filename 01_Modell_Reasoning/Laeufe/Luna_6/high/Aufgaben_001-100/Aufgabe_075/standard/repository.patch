diff --git a/tests/mock_user_props_repo.go b/tests/mock_user_props_repo.go
new file mode 100644
index 0000000..d06478e
--- /dev/null
+++ b/tests/mock_user_props_repo.go
@@ -0,0 +1,45 @@
+package tests
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type MockedUserPropsRepo struct {
+	model.UserPropsRepository
+	data   map[string]map[string]string
+	userID string
+}
+
+func (p *MockedUserPropsRepo) forUser(ctx context.Context) *MockedUserPropsRepo {
+	user, _ := request.UserFrom(ctx)
+	return &MockedUserPropsRepo{data: p.data, userID: user.ID}
+}
+
+func (p *MockedUserPropsRepo) Put(key, value string) error {
+	if p.data == nil {
+		p.data = make(map[string]map[string]string)
+	}
+	if p.data[p.userID] == nil {
+		p.data[p.userID] = make(map[string]string)
+	}
+	p.data[p.userID][key] = value
+	return nil
+}
+
+func (p *MockedUserPropsRepo) Get(key string) (string, error) {
+	if value, ok := p.data[p.userID][key]; ok {
+		return value, nil
+	}
+	return "", model.ErrNotFound
+}
+
+func (p *MockedUserPropsRepo) Delete(key string) error {
+	if _, ok := p.data[p.userID][key]; !ok {
+		return model.ErrNotFound
+	}
+	delete(p.data[p.userID], key)
+	return nil
+}
