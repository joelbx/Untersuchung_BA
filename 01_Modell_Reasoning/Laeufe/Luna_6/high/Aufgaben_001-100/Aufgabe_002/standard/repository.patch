+func validProxyPublicAddr(addr *utils.NetAddr) bool {
+	if addr == nil || addr.Path != "" || addr.Host() == "" || strings.ContainsAny(addr.Host(), " /\\@?#") {
+		return false
+	}
+	if _, port, err := net.SplitHostPort(addr.Addr); err == nil {
+		portNumber, err := strconv.Atoi(port)
+		return err == nil && portNumber > 0 && portNumber <= 65535
+	}
+	return !strings.Contains(addr.Addr, ":") || net.ParseIP(strings.Trim(addr.Addr, "[]")) != nil
+}
