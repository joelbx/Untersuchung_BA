+// KubeAddr returns the public Kubernetes proxy address using the default
+// Kubernetes proxy port.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is not enabled")
+	}
+	var addr string
+	if len(c.Kube.PublicAddrs) > 0 {
+		addr = c.Kube.PublicAddrs[0].Addr
+	} else if len(c.PublicAddrs) > 0 {
+		addr = c.PublicAddrs[0].Addr
+	} else {
+		return "", trace.BadParameter("no public proxy address configured")
+	}
+	host, err := publicAddrHost(addr)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	return fmt.Sprintf("https://%s", net.JoinHostPort(host, fmt.Sprint(defaults.KubeProxyListenPort))), nil
+}
+
+func publicAddrHost(addr string) (string, error) {
+	if addr == "" {
+		return "", trace.BadParameter("empty public proxy address")
+	}
+	parsed, err := utils.ParseAddr(addr)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	host := parsed.Host()
+	if host == "" || parsed.Path != "" || strings.ContainsAny(host, " /\\@?#") {
+		return "", trace.BadParameter("invalid public proxy address %q", addr)
+	}
+	if _, port, err := net.SplitHostPort(parsed.Addr); err == nil {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 {
+			return "", trace.BadParameter("invalid public proxy address %q", addr)
+		}
+	} else if strings.Contains(parsed.Addr, ":") && net.ParseIP(strings.Trim(parsed.Addr, "[]")) == nil {
+		return "", trace.BadParameter("invalid public proxy address %q", addr)
+	}
+	return host, nil
+}
