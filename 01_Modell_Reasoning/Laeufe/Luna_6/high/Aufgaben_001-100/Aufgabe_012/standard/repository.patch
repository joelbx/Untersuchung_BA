+def test_custom_headers_accept_language_fallback(config_stub):
+    config_stub.val.content.headers.do_not_track = None
+    config_stub.val.content.headers.accept_language = 'global'
+    url = QUrl('https://example.com')
+
+    assert shared.custom_headers(
+        url=url, fallback_accept_language=False) == []
+    assert shared.custom_headers(
+        url=url, fallback_accept_language=True) == [
+            (b'Accept-Language', b'global')]
+    assert shared.custom_headers(
+        url=None, fallback_accept_language=False) == [
+            (b'Accept-Language', b'global')]
+
+    pattern = urlmatch.UrlPattern('https://example.com')
+    config_stub.set_obj('content.headers.accept_language', 'domain',
+                        pattern=pattern)
+    assert shared.custom_headers(
+        url=url, fallback_accept_language=False) == [
+            (b'Accept-Language', b'domain')]
