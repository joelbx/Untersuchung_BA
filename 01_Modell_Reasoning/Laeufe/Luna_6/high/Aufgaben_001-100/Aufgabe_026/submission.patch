+func TestGetCveContentTypes(t *testing.T) {
+	tests := []struct {
+		family string
+		want   []CveContentType
+	}{
+		{"redhat", []CveContentType{RedHat, RedHatAPI}},
+		{"centos", []CveContentType{RedHat, RedHatAPI}},
+		{"alma", []CveContentType{RedHat, RedHatAPI}},
+		{"rocky", []CveContentType{RedHat, RedHatAPI}},
+		{"debian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"raspbian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"ubuntu", []CveContentType{Ubuntu, UbuntuAPI}},
+		{"unknown-family", nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.family, func(t *testing.T) {
+			if got := GetCveContentTypes(tt.family); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("GetCveContentTypes(%q) = %v, want %v", tt.family, got, tt.want)
+			}
+		})
+	}
+	if got := NewCveContentType("centos"); got != RedHat {
+		t.Errorf("NewCveContentType(centos) = %v, want %v", got, RedHat)
+	}
+	if got := NewCveContentType("unknown-family"); got != Unknown {
+		t.Errorf("NewCveContentType(unknown-family) = %v, want %v", got, Unknown)
+	}
+}
+
+func TestNegligibleSeverity(t *testing.T) {
+	if got, want := severityToCvssScoreRange("NEGLIGIBLE"), severityToCvssScoreRange("LOW"); got != want {
+		t.Errorf("NEGLIGIBLE range = %q, want %q", got, want)
+	}
+	if got, want := severityToCvssScoreRoughly("NEGLIGIBLE"), severityToCvssScoreRoughly("LOW"); got != want {
+		t.Errorf("NEGLIGIBLE rough score = %v, want %v", got, want)
+	}
+}
