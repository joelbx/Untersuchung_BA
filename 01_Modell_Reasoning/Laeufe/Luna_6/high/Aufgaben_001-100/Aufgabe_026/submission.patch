+func TestIsCveInfoUpdatedChecksEveryFamilySource(t *testing.T) {
+	base := time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	newer := base.Add(time.Hour)
+	makeResult := func(modified time.Time) models.ScanResult {
+		return models.ScanResult{
+			Family: "ubuntu",
+			ScannedCves: models.VulnInfos{
+				"CVE-2024-0001": {
+					CveID: "CVE-2024-0001",
+					CveContents: models.CveContents{
+						models.Ubuntu:    {{Type: models.Ubuntu, LastModified: base}},
+						models.UbuntuAPI: {{Type: models.UbuntuAPI, LastModified: modified}},
+					},
+				},
+			},
+		}
+	}
+	if !isCveInfoUpdated("CVE-2024-0001", makeResult(base), makeResult(newer)) {
+		t.Fatal("change in Ubuntu API data was not detected")
+	}
+}
