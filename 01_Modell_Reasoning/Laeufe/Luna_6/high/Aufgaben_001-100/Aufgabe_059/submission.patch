+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,33 @@
+import { forwardRef, HTMLAttributes, ReactNode } from 'react';
+
+export interface DialogProps extends HTMLAttributes<HTMLDialogElement> {
+    children?: ReactNode;
+    open?: boolean;
+}
+
+/**
+ * A dialog host that uses a regular element in DOM implementations without
+ * the native dialog API (such as JSDOM).
+ */
+const Dialog = forwardRef<HTMLDialogElement, DialogProps>(({ children, ...rest }, ref) => {
+    const supportsNativeDialog =
+        typeof HTMLDialogElement !== 'undefined' && typeof HTMLDialogElement.prototype.showModal === 'function';
+
+    if (supportsNativeDialog) {
+        return (
+            <dialog {...rest} ref={ref}>
+                {children}
+            </dialog>
+        );
+    }
+
+    return (
+        <div {...(rest as HTMLAttributes<HTMLDivElement>)} role={rest.role || 'dialog'} ref={ref as any}>
+            {children}
+        </div>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
