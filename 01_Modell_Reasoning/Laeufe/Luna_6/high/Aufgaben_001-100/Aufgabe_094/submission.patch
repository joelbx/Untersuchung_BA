index bba4929..f948a28 100644
--- a/lib/auth/touchid/api.go
+++ b/lib/auth/touchid/api.go
@@ -40,6 +40,22 @@ var (
 	ErrNotAvailable       = errors.New("touch ID not available")
 )
 
+// DiagResult contains the results of the Touch ID availability checks.
+type DiagResult struct {
+	HasCompileSupport       bool
+	HasSignature            bool
+	HasEntitlements         bool
+	PassedLAPolicyTest      bool
+	PassedSecureEnclaveTest bool
+	IsAvailable             bool
+}
+
+// Diag runs the Touch ID availability checks and returns their individual
+// results along with the aggregate availability status.
+func Diag() (*DiagResult, error) {
+	return diag(), nil
+}
+
 // nativeTID represents the native Touch ID interface.
 // Implementors must provide a global variable called `native`.
 type nativeTID interface {
diff --git a/lib/auth/touchid/diag_darwin.go b/lib/auth/touchid/diag_darwin.go
new file mode 100644
index 0000000..bd1c133
--- /dev/null
+++ b/lib/auth/touchid/diag_darwin.go
@@ -0,0 +1,16 @@
+//go:build touchid
+// +build touchid
+
+package touchid
+
+func diag() *DiagResult {
+	available := native.IsAvailable()
+	return &DiagResult{
+		HasCompileSupport:       true,
+		HasSignature:            available,
+		HasEntitlements:         available,
+		PassedLAPolicyTest:      available,
+		PassedSecureEnclaveTest: available,
+		IsAvailable:             available,
+	}
+}
