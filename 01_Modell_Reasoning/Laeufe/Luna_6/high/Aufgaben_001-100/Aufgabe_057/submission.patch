new file mode 100644
index 0000000..0c3cc79
--- /dev/null
+++ b/internal/ext/common.go
@@ -0,0 +1,48 @@
+package ext
+
+// Document is the portable YAML representation of flags and segments.
+type Document struct {
+	Flags    []*Flag    `yaml:"flags,omitempty"`
+	Segments []*Segment `yaml:"segments,omitempty"`
+}
+
+type Flag struct {
+	Key         string     `yaml:"key,omitempty"`
+	Name        string     `yaml:"name,omitempty"`
+	Description string     `yaml:"description,omitempty"`
+	Enabled     bool       `yaml:"enabled"`
+	Variants    []*Variant `yaml:"variants,omitempty"`
+	Rules       []*Rule    `yaml:"rules,omitempty"`
+}
+
+type Variant struct {
+	Key         string      `yaml:"key,omitempty"`
+	Name        string      `yaml:"name,omitempty"`
+	Description string      `yaml:"description,omitempty"`
+	Attachment  interface{} `yaml:"attachment,omitempty"`
+}
+
+type Rule struct {
+	SegmentKey    string          `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type Distribution struct {
+	VariantKey string  `yaml:"variant,omitempty"`
+	Rollout    float32 `yaml:"rollout,omitempty"`
+}
+
+type Segment struct {
+	Key         string        `yaml:"key,omitempty"`
+	Name        string        `yaml:"name,omitempty"`
+	Description string        `yaml:"description,omitempty"`
+	Constraints []*Constraint `yaml:"constraints,omitempty"`
+}
+
+type Constraint struct {
+	Type     string `yaml:"type,omitempty"`
+	Property string `yaml:"property,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+	Value    string `yaml:"value,omitempty"`
+}
diff --git a/internal/ext/exporter.go b/internal/ext/exporter.go
new file mode 100644
index 0000000..27ff26e
--- /dev/null
+++ b/internal/ext/exporter.go
@@ -0,0 +1,110 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+const defaultBatchSize uint64 = 25
+
+type lister interface {
+	ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error)
+	ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error)
+	ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error)
+}
+
+// Exporter writes a YAML document containing the store's flags and segments.
+type Exporter struct {
+	store     lister
+	batchSize uint64
+}
+
+// yamlNull keeps an explicitly stored JSON null distinct from an absent
+// attachment while satisfying yaml.v2's omitempty handling.
+type yamlNull struct{}
+
+func (yamlNull) MarshalYAML() (interface{}, error) { return nil, nil }
+
+func NewExporter(store lister) *Exporter {
+	return &Exporter{store: store, batchSize: defaultBatchSize}
+}
+
+func (e *Exporter) Export(ctx context.Context, w io.Writer) error {
+	doc := &Document{}
+	batchSize := e.batchSize
+	if batchSize == 0 {
+		batchSize = defaultBatchSize
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		flags, err := e.store.ListFlags(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting flags: %w", err)
+		}
+		for _, f := range flags {
+			flag := &Flag{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}
+			variantKeys := make(map[string]string, len(f.Variants))
+			for _, v := range f.Variants {
+				variant := &Variant{Key: v.Key, Name: v.Name, Description: v.Description}
+				if v.Attachment != "" {
+					if err := json.Unmarshal([]byte(v.Attachment), &variant.Attachment); err != nil {
+						return fmt.Errorf("decoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+					if variant.Attachment == nil {
+						variant.Attachment = yamlNull{}
+					}
+				}
+				flag.Variants = append(flag.Variants, variant)
+				variantKeys[v.Id] = v.Key
+			}
+			rules, err := e.store.ListRules(ctx, f.Key)
+			if err != nil {
+				return fmt.Errorf("getting rules for flag %q: %w", f.Key, err)
+			}
+			for _, r := range rules {
+				rule := &Rule{SegmentKey: r.SegmentKey, Rank: uint(r.Rank)}
+				for _, d := range r.Distributions {
+					rule.Distributions = append(rule.Distributions, &Distribution{VariantKey: variantKeys[d.VariantId], Rollout: d.Rollout})
+				}
+				flag.Rules = append(flag.Rules, rule)
+			}
+			doc.Flags = append(doc.Flags, flag)
+		}
+		if uint64(len(flags)) < batchSize {
+			break
+		}
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		segments, err := e.store.ListSegments(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting segments: %w", err)
+		}
+		for _, s := range segments {
+			segment := &Segment{Key: s.Key, Name: s.Name, Description: s.Description}
+			for _, c := range s.Constraints {
+				segment.Constraints = append(segment.Constraints, &Constraint{Type: c.Type.String(), Property: c.Property, Operator: c.Operator, Value: c.Value})
+			}
+			doc.Segments = append(doc.Segments, segment)
+		}
+		if uint64(len(segments)) < batchSize {
+			break
+		}
+	}
+	if err := yaml.NewEncoder(w).Encode(doc); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	return nil
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..4a396c8
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,121 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+// Importer creates store entities from a YAML document.
+type Importer struct{ store creator }
+
+func NewImporter(store creator) *Importer { return &Importer{store: store} }
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	doc := new(Document)
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+	createdVariants := make(map[string]*flipt.Variant)
+	for _, f := range doc.Flags {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		_, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled})
+		if err != nil {
+			return fmt.Errorf("importing flag: %w", err)
+		}
+		for _, v := range f.Variants {
+			attachment := ""
+			if v.Attachment != nil {
+				encoded, err := json.Marshal(convert(v.Attachment))
+				if err != nil {
+					return fmt.Errorf("encoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+				}
+				attachment = string(encoded)
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{FlagKey: f.Key, Key: v.Key, Name: v.Name, Description: v.Description, Attachment: attachment})
+			if err != nil {
+				return fmt.Errorf("importing variant: %w", err)
+			}
+			createdVariants[f.Key+":"+variant.Key] = variant
+		}
+	}
+
+	for _, s := range doc.Segments {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		_, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: s.Key, Name: s.Name, Description: s.Description})
+		if err != nil {
+			return fmt.Errorf("importing segment: %w", err)
+		}
+		for _, c := range s.Constraints {
+			typ, ok := flipt.ComparisonType_value[c.Type]
+			if !ok {
+				return fmt.Errorf("unknown constraint type %q", c.Type)
+			}
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{SegmentKey: s.Key, Type: flipt.ComparisonType(typ), Property: c.Property, Operator: c.Operator, Value: c.Value}); err != nil {
+				return fmt.Errorf("importing constraint: %w", err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{FlagKey: f.Key, SegmentKey: r.SegmentKey, Rank: int32(r.Rank)})
+			if err != nil {
+				return fmt.Errorf("importing rule: %w", err)
+			}
+			for _, d := range r.Distributions {
+				variant, ok := createdVariants[f.Key+":"+d.VariantKey]
+				if !ok {
+					return fmt.Errorf("finding variant: %s; flag: %s", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{FlagKey: f.Key, RuleId: rule.Id, VariantId: variant.Id, Rollout: d.Rollout}); err != nil {
+					return fmt.Errorf("importing distribution: %w", err)
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// convert recursively converts YAML's interface-keyed maps into JSON-compatible maps.
+func convert(value interface{}) interface{} {
+	switch value := value.(type) {
+	case map[interface{}]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			result[fmt.Sprint(key)] = convert(item)
+		}
+		return result
+	case map[string]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			result[key] = convert(item)
+		}
+		return result
+	case []interface{}:
+		result := make([]interface{}, len(value))
+		for index, item := range value {
+			result[index] = convert(item)
+		}
+		return result
+	default:
+		return value
+	}
+}
