+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import classNames from 'classnames';
+
+import { _t } from '../../../languageHandler';
+import AccessibleButton from '../elements/AccessibleButton';
+
+interface IProps extends Omit<React.ComponentProps<typeof AccessibleButton>, 'size'> {
+    size?: string;
+}
+
+interface IStyle extends React.CSSProperties {
+    '--cancel-button-size': string;
+}
+
+export default function CancelButton({ size = '16', className, style, ...props }: IProps): JSX.Element {
+    return <AccessibleButton
+        {...props}
+        className={classNames('mx_CancelButton', className)}
+        aria-label={props['aria-label'] || _t('Cancel')}
+        style={{ ...style, '--cancel-button-size': `${size}px` } as IStyle}
+    />;
+}
