+func TestLoadEnvironmentVariableReferences(t *testing.T) {
+	t.Setenv("CONFIG_HTTP_PORT", "9191")
+	t.Setenv("CONFIG_LOG_ENCODING", "json")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "")
+	t.Setenv("FLIPT_SERVER_GRPC_PORT", "9193")
+	t.Setenv("FLIPT_LOG_ENCODING", "")
+
+	path := filepath.Join(t.TempDir(), "config.yml")
+	contents := []byte(`
+server:
+  http_port: ${CONFIG_HTTP_PORT}
+  grpc_port: 9192
+log:
+  encoding: ${CONFIG_LOG_ENCODING}
+  level: ${CONFIG_MISSING_VALUE}
+  file: prefix-${CONFIG_LOG_ENCODING}
+`)
+	require.NoError(t, os.WriteFile(path, contents, 0o600))
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 9191, result.Config.Server.HTTPPort)
+	assert.Equal(t, 9193, result.Config.Server.GRPCPort)
+	assert.Equal(t, LogEncodingJSON, result.Config.Log.Encoding)
+	assert.Equal(t, "${CONFIG_MISSING_VALUE}", result.Config.Log.Level)
+	assert.Equal(t, "prefix-${CONFIG_LOG_ENCODING}", result.Config.Log.File)
+}
