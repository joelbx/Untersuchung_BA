 # GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
 
 import json
+import datetime
 
 import pytest
 
@@ -49,3 +50,39 @@ def test_deprecate_without_list(am, capfd):
     assert output['deprecations'] == [
         {u'msg': u'Simple deprecation warning', u'version': None},
     ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_with_date(am, capfd):
+    am.deprecate('dated deprecation', date=datetime.date(2025, 1, 2))
+    with pytest.raises(SystemExit):
+        am.exit_json()
+    out, err = capfd.readouterr()
+    assert json.loads(out)['deprecations'] == [
+        {'msg': 'dated deprecation', 'date': '2025-01-02'},
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_rejects_version_and_date(am):
+    with pytest.raises(AssertionError) as exc:
+        am.deprecate('invalid deprecation', version='2.3', date='2025-01-02')
+    assert str(exc.value) == 'implementation error -- version and date must not both be set'
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_exit_json_merges_date_deprecations(am, capfd):
+    am.deprecate('recorded deprecation', version='2.3')
+    with pytest.raises(SystemExit):
+        am.exit_json(deprecations=[
+            {'msg': 'supplied date deprecation', 'date': '2025-01-02'},
+            'supplied message',
+            ('supplied tuple', '2.4'),
+        ])
+    out, err = capfd.readouterr()
+    assert json.loads(out)['deprecations'] == [
+        {'msg': 'recorded deprecation', 'version': '2.3'},
+        {'msg': 'supplied date deprecation', 'date': '2025-01-02'},
+        {'msg': 'supplied message', 'version': None},
+        {'msg': 'supplied tuple', 'version': '2.4'},
+    ]
