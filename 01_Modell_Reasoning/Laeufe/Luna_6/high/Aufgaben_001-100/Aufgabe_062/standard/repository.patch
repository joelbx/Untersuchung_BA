+// NotifyExit signals the global stdin reader that the program is exiting.
+// Closing a ContextReader restores the terminal if a password read is active.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		if err := closer.Close(); err != nil {
+			log.Printf("prompt: failed closing stdin reader: %v", err)
+		}
+	}
+}
