+UserEmail.getEmailForValidation = async function (uid) {
+	const email = await user.getUserField(uid, 'email');
+	if (email) {
+		return email;
+	}
+	const code = await db.get(`confirm:byUid:${uid}`);
+	if (!code) {
+		return '';
+	}
+	const confirmation = await db.getObject(`confirm:${code}`);
+	return confirmation && parseInt(confirmation.uid, 10) === parseInt(uid, 10) ? confirmation.email || '' : '';
+};
+
+UserEmail.isValidationPending = async function (uid, email) {
+	const code = await db.get(`confirm:byUid:${uid}`);
+	if (!code) {
+		return false;
+	}
+	const confirmation = await db.getObject(`confirm:${code}`);
+	return !!(confirmation && confirmation.email && parseInt(confirmation.uid, 10) === parseInt(uid, 10) &&
+		(!email || confirmation.email.toLowerCase() === email.toLowerCase()) &&
+		parseInt(confirmation.expires, 10) > Date.now());
+};
+
+UserEmail.expireValidation = async function (uid) {
+	const key = `confirm:byUid:${uid}`;
+	const code = await db.get(key);
+	const keys = [key];
+	if (code) {
+		keys.push(`confirm:${code}`);
+	}
+	await db.deleteAll(keys);
+};
