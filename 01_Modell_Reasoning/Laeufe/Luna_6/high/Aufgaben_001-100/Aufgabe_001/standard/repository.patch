--- /dev/null
+++ b/config/syslog/types.go
@@ -0,0 +1,14 @@
+// Package syslog contains syslog reporting configuration and validation.
+package syslog
+
+// Conf is syslog configuration.
+type Conf struct {
+	Protocol string `json:"-"`
+	Host     string `valid:"host" json:"-"`
+	Port     string `valid:"port" json:"-"`
+	Severity string `json:"-"`
+	Facility string `json:"-"`
+	Tag      string `json:"-"`
+	Verbose  bool   `json:"-"`
+	Enabled  bool   `toml:"-" json:"-"`
+}
