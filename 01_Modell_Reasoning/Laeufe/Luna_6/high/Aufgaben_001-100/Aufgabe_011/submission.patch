 class _AnsibleUnicode(str):
     """Backwards compatibility type."""
 
-    def __new__(cls, value):
-        return _datatag.AnsibleTagHelper.tag_copy(value, str(value))
+    def __new__(cls, value='', encoding=None, errors='strict', **kwargs):
