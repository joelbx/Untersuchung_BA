+func validateArrayValue(property string, comparisonType ComparisonType, value string) error {
+	typeName := ""
+	var items []json.RawMessage
+
+	if err := json.Unmarshal([]byte(value), &items); err != nil || !strings.HasPrefix(strings.TrimSpace(value), "[") {
+		switch comparisonType {
+		case ComparisonType_STRING_COMPARISON_TYPE:
+			typeName = "string"
+		case ComparisonType_NUMBER_COMPARISON_TYPE:
+			typeName = "number"
+		}
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+	}
+
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		typeName = "string"
+		var values []string
+		if err := json.Unmarshal([]byte(value), &values); err != nil {
+			return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+		}
+		for _, item := range items {
+			item = json.RawMessage(strings.TrimSpace(string(item)))
+			if len(item) == 0 || item[0] != '"' {
+				return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+			}
+		}
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		typeName = "number"
+		var values []float64
+		if err := json.Unmarshal([]byte(value), &values); err != nil {
+			return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+		}
+		for _, item := range items {
+			item = json.RawMessage(strings.TrimSpace(string(item)))
+			if len(item) == 0 || string(item) == "null" {
+				return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+			}
+		}
+	default:
+		return errors.ErrInvalidf("invalid value provided for property %q", property)
+	}
+
+	if len(items) > MAX_JSON_ARRAY_ITEMS {
+		return errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", property, typeName, MAX_JSON_ARRAY_ITEMS)
+	}
+
+	return nil
+}
