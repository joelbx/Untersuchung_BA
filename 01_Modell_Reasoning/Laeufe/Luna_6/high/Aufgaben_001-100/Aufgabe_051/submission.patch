 		t.Run(tt.comment, func(t *testing.T) {
@@ -934,3 +940,39 @@ func TestReadTeleportHome(t *testing.T) {
 		})
 	}
 }
+
+func TestReadKubernetesCluster(t *testing.T) {
+	tests := []struct {
+		name               string
+		cliCluster         string
+		environmentCluster string
+		want               string
+	}{
+		{
+			name: "unset",
+		},
+		{
+			name:               "environment set",
+			environmentCluster: "dev",
+			want:               "dev",
+		},
+		{
+			name:               "CLI takes precedence",
+			cliCluster:         "prod",
+			environmentCluster: "dev",
+			want:               "prod",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cf := CLIConf{KubernetesCluster: tt.cliCluster}
+			readKubernetesCluster(&cf, func(name string) string {
+				if name == kubeClusterEnvVar {
+					return tt.environmentCluster
+				}
+				return ""
+			})
+			require.Equal(t, tt.want, cf.KubernetesCluster)
+		})
+	}
+}
