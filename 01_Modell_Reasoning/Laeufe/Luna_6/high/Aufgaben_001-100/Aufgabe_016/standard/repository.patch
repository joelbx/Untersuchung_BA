+        short_hostname = hostname.split(".", 1)[0] if hostname else ""
+
+        def matches(pattern: str) -> bool:
+            # Wildcards are intentionally limited to a trailing '*'.
+            if "*" in pattern and not pattern.endswith("*"):
+                return False
+            patterns = {pattern, pattern.split(".", 1)[0]}
+            return any(
+                re.fullmatch(re.escape(candidate).replace(r"\*", ".*"), name)
+                is not None
+                for candidate in patterns
+                for name in {hostname or "", short_hostname}
+            )
+
+        if not any(matches(pattern) for pattern in allowed_hosts):
+            # scheduled_job runs before this decorator in the established decorator
+            # order. Jobs added before scheduler.start() live in APScheduler's
+            # pending list and cannot be removed through remove_job yet.
+            pending_jobs = getattr(scheduler, "_pending_jobs", None)
+            if pending_jobs is not None:
+                pending_jobs[:] = [
+                    pending for pending in pending_jobs
+                    if pending[0].id != func.__name__
+                ]
+            try:
+                scheduler.remove_job(func.__name__)
+            except JobLookupError:
+                pass
         return func
 
     return decorator
