+def get_service_ip(image_name: str) -> str:
+    """Return the IP of a running Docker container identified by image/name."""
+    container_name = image_name.rsplit("/", 1)[-1]
+    result = subprocess.check_output(
+        [
+            "docker",
+            "inspect",
+            "--format",
+            "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}",
+            container_name,
+        ],
+        text=True,
+    ).strip()
+    if not result:
+        raise RuntimeError(f"No IP address found for container {container_name}")
+    return result
