diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..532c700
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,51 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+
+const wellKnownController = module.exports;
+
+wellKnownController.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	if (typeof resource !== 'string' || !resource.startsWith('acct:')) {
+		return res.status(400).json({ error: 'Bad Request' });
+	}
+
+	const account = resource.slice('acct:'.length);
+	const separator = account.lastIndexOf('@');
+	if (separator <= 0 || account.slice(separator + 1) !== hostname) {
+		return res.status(400).json({ error: 'Bad Request' });
+	}
+
+	const callerUid = req.uid || 0;
+	if (!await privileges.global.can('view:users', callerUid)) {
+		return res.status(403).json({ error: 'Forbidden' });
+	}
+
+	const userslug = account.slice(0, separator);
+	const uid = await user.getUidByUserslug(userslug);
+	if (!uid) {
+		return res.status(404).json({ error: 'Not Found' });
+	}
+
+	const userData = await user.getUserFields(uid, ['uid', 'userslug']);
+	if (!userData || !userData.userslug) {
+		return res.status(404).json({ error: 'Not Found' });
+	}
+
+	const siteUrl = nconf.get('url');
+	const uidUrl = `${siteUrl}/uid/${userData.uid}`;
+	const profileUrl = `${siteUrl}/user/${userData.userslug}`;
+	return res.json({
+		subject: resource,
+		aliases: [uidUrl, profileUrl],
+		links: [{
+			rel: 'http://webfinger.net/rel/profile-page',
+			type: 'text/html',
+			href: profileUrl,
+		}],
+	});
+};
