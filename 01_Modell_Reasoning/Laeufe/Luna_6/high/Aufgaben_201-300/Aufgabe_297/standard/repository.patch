+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	rv := reflect.ValueOf(value)
+	if rv.Kind() == reflect.Map && rv.Type().Key().Kind() == reflect.String {
+		result := reflect.MakeMap(rv.Type())
+		iter := rv.MapRange()
+		for iter.Next() {
+			key := iter.Key()
+			v := iter.Value().Interface()
+			if re.MatchString(key.String()) {
+				v = "[REDACTED]"
+			} else {
+				v = redactValue(v, re)
+			}
+			converted := reflect.ValueOf(v)
+			if !converted.IsValid() {
+				converted = reflect.Zero(rv.Type().Elem())
+			} else if !converted.Type().AssignableTo(rv.Type().Elem()) {
+				converted = reflect.ValueOf(re.ReplaceAllString(fmt.Sprint(v), "$1[REDACTED]$2"))
+			}
+			if converted.Type().AssignableTo(rv.Type().Elem()) {
+				result.SetMapIndex(key, converted)
+			} else {
+				return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+			}
+		}
+		return result.Interface()
+	}
+	if rv.Kind() == reflect.String {
+		return re.ReplaceAllString(rv.String(), "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
