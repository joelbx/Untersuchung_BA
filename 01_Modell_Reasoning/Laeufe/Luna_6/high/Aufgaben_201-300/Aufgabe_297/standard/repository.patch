+// handleLoginFromHeaders authenticates requests from explicitly trusted proxies.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	username := strings.TrimSpace(r.Header.Get(conf.Server.ReverseProxyUserHeader))
+	if username == "" {
+		return nil
+	}
+
+	auth.Init(ds)
+	users := ds.User(r.Context())
+	user, err := users.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := users.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users during reverse proxy login", countErr)
+			return nil
+		}
+		now := time.Now()
+		user = &model.User{
+			ID:          uuid.NewString(),
+			UserName:    username,
+			Name:        strings.Title(username),
+			IsAdmin:     count == 0,
+			LastLoginAt: &now,
+		}
+		if err = users.Put(user); err != nil {
+			log.Error(r, "Could not create reverse proxy user", "username", username, err)
+			return nil
+		}
+	} else if err != nil {
+		log.Error(r, "Could not find reverse proxy user", "username", username, err)
+		return nil
+	} else {
+		now := time.Now()
+		user.LastLoginAt = &now
+		if err = users.UpdateLastLoginAt(user.ID); err != nil {
+			log.Error(r, "Could not update LastLoginAt", "user", username, err)
+		}
+	}
+
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create reverse proxy token", "username", username, err)
+		return nil
+	}
+	salt := uuid.NewString()[:6]
+	subsonicToken := md5.Sum([]byte(user.Password + salt))
+	return map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         token,
+		"subsonicSalt":  salt,
+		"subsonicToken": hex.EncodeToString(subsonicToken[:]),
+	}
+}
+
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if strings.TrimSpace(whitelist) == "" {
+		return false
+	}
+	remoteHost := remoteAddr
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteHost = host
+	}
+	if remoteHost == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	remoteIP := net.ParseIP(strings.Trim(remoteHost, "[]"))
+	if remoteIP == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" || entry == "@" {
+			continue
+		}
+		candidate := entry
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			candidate = host
+		}
+		if ip := net.ParseIP(strings.Trim(candidate, "[]")); ip != nil {
+			if ip.Equal(remoteIP) {
+				return true
+			}
+			continue
+		}
+		_, network, err := net.ParseCIDR(candidate)
+		if err == nil && network.Contains(remoteIP) {
+			return true
+		}
+	}
+	return false
+}
