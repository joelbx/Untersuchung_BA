+
+def _get_uptime_seconds(module):
+    """Return uptime from kern.boottime, or None when its value is unusable."""
+    try:
+        sysctl_cmd = module.get_bin_path('sysctl')
+    except (IOError, OSError) as exc:
+        raise ValueError(str(exc))
+    if not sysctl_cmd:
+        raise ValueError('sysctl command not found')
+    try:
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'], check_rc=False)
+    except (IOError, OSError) as exc:
+        raise ValueError(str(exc))
+    if rc != 0:
+        return None
+
+    boot_time = out.strip()
+    if not boot_time or re.match(r'^\d+(?:\.\d+)?$', boot_time) is None:
+        return None
+    return int(time.time() - float(boot_time))
