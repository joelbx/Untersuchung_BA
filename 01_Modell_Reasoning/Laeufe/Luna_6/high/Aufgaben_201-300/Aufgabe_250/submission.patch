+def luqum_replace_child(parent: Item, old_child: Item, new_child: Item) -> None:
+    """Replace a child in a luqum parse tree.
+
+    :param parent: Node containing the child to replace
+    :param old_child: Child node to replace
+    :param new_child: Replacement node
+    """
+    if isinstance(parent, (BaseOperation, Group, Unary)):
+        parent.children = tuple(
+            new_child if child == old_child else child for child in parent.children
+        )
+    else:
+        raise ValueError("Not supported for generic class Item")
