+// migrateFieldsMap converts legacy Fields strings into native DynamoDB maps.
+// It is safe to interrupt and rerun; the backend lock prevents concurrent
+// migrations across auth servers and the completion flag avoids future scans.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	flagKey := backend.FlagKey(fieldsMapMigrationFlag)
+	if _, err := l.backend.Get(ctx, flagKey); err == nil {
+		return nil
+	} else if !trace.IsNotFound(err) {
+		return trace.Wrap(err)
+	}
+
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		if _, err := l.backend.Get(ctx, flagKey); err == nil {
+			return nil
+		} else if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+
+		var startKey map[string]*dynamodb.AttributeValue
+		var processed int64
+		for {
+			out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName:                aws.String(l.Tablename),
+				ExclusiveStartKey:        startKey,
+				ConsistentRead:           aws.Bool(true),
+				Limit:                    aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+				FilterExpression:         aws.String("attribute_exists(#legacy) AND attribute_not_exists(#map)"),
+				ExpressionAttributeNames: map[string]*string{"#legacy": aws.String("Fields"), "#map": aws.String("FieldsMap")},
+			})
+			if err != nil {
+				return trace.WrapWithMessage(convertError(err), "failed scanning legacy DynamoDB event fields")
+			}
+
+			requests := make([]*dynamodb.WriteRequest, 0, len(out.Items))
+			for _, item := range out.Items {
+				legacy, ok := item["Fields"]
+				if !ok || legacy.S == nil {
+					return trace.BadParameter("legacy event Fields attribute is missing or is not a string")
+				}
+				var original map[string]interface{}
+				if err := json.Unmarshal([]byte(*legacy.S), &original); err != nil {
+					return trace.BadParameter("failed decoding legacy event %v: %v", item[keySessionID], err)
+				}
+				if original == nil {
+					return trace.BadParameter("legacy event %v fields are not a JSON object", item[keySessionID])
+				}
+				converted, err := dynamodbattribute.MarshalMap(original)
+				if err != nil {
+					return trace.WrapWithMessage(err, "failed converting legacy event fields to DynamoDB map")
+				}
+				// Round trip through DynamoDB's attribute representation before
+				// writing, so unsupported or changed values fail without data loss.
+				var check map[string]interface{}
+				if err := dynamodbattribute.UnmarshalMap(converted, &check); err != nil {
+					return trace.WrapWithMessage(err, "failed validating converted DynamoDB event fields")
+				}
+				if !reflect.DeepEqual(original, check) {
+					return trace.BadParameter("semantic validation failed for migrated event %v", item[keySessionID])
+				}
+				item["FieldsMap"] = &dynamodb.AttributeValue{M: converted}
+				delete(item, "Fields")
+				requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+			}
+
+			for len(requests) > 0 {
+				batchSize := len(requests)
+				if batchSize > DynamoBatchSize {
+					batchSize = DynamoBatchSize
+				}
+				if err := l.uploadBatch(requests[:batchSize]); err != nil {
+					return trace.WrapWithMessage(err, "failed writing migrated DynamoDB event fields")
+				}
+				requests = requests[batchSize:]
+				processed += int64(batchSize)
+				log.Infof("Migrated %d DynamoDB events to FieldsMap", processed)
+			}
+
+			startKey = out.LastEvaluatedKey
+			if startKey == nil {
+				break
+			}
+		}
+
+		if _, err := l.backend.Create(ctx, backend.Item{Key: flagKey, Value: []byte("complete")}); err != nil && !trace.IsAlreadyExists(err) {
+			return trace.WrapWithMessage(err, "failed recording DynamoDB FieldsMap migration completion")
+		}
+		log.Infof("DynamoDB FieldsMap migration completed; converted %d events", processed)
+		return nil
+	})
+}
