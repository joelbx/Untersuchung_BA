+// fieldsMap converts the JSON representation produced by audit event encoders
+// into a native DynamoDB map value.
+func fieldsMap(data []byte) map[string]interface{} {
+	var fields map[string]interface{}
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return nil // data was just marshaled by the caller and is valid JSON.
+	}
+	return fields
+}
+
+// eventFields decodes both the current native-map representation and legacy
+// JSON string representation while the table migration is in progress.
+func eventFields(e event) (events.EventFields, error) {
+	data := []byte(e.Fields)
+	if e.FieldsMap != nil {
+		var err error
+		data, err = json.Marshal(e.FieldsMap)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	var fields events.EventFields
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return fields, nil
+}
