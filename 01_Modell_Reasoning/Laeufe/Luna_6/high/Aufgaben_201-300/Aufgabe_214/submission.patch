+func setScanTechniques(c *config.PortScanConf) ([]string, error) {
+	options := []string{}
+	for _, technique := range c.GetScanTechniques() {
+		if technique == config.NotSupportTechnique {
+			return nil, xerrors.Errorf("unsupported scan technique in %v", c.ScanTechniques)
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	techniqueOptions, err := setScanTechniques(conf)
+	if err != nil {
+		return nil, err
+	}
+	if len(techniqueOptions) == 0 {
+		techniqueOptions = []string{"-sT"}
+	}
+	results := []string{}
+	for ip, ports := range scanDestIPPorts {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		args := append([]string{}, techniqueOptions...)
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, "-oG", "-", "-p", strings.Join(ports, ","), ip)
+		out, err := osExec.Command(conf.ScannerBinPath, args...).CombinedOutput()
+		if err != nil {
+			return nil, xerrors.Errorf("nmap scan failed (%s): %w", strings.TrimSpace(string(out)), err)
+		}
+		for _, line := range strings.Split(string(out), "\n") {
+			if !strings.Contains(line, "Ports:") {
+				continue
+			}
+			for _, entry := range strings.Split(strings.SplitN(line, "Ports:", 2)[1], ",") {
+				fields := strings.Split(strings.TrimSpace(entry), "/")
+				if len(fields) >= 2 && fields[1] == "open" {
+					results = append(results, net.JoinHostPort(ip, fields[0]))
+				}
+			}
+		}
+	}
+	return results, nil
+}
