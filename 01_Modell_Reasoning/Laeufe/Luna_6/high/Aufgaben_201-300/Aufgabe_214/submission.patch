diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..743b282
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,131 @@
+package config
+
+import (
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+
+	"golang.org/x/xerrors"
+)
+
+// ScanTechnique is an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+var scanTechniqueNames = map[string]ScanTechnique{
+	"sS": TCPSYN, "sT": TCPConnect, "sA": TCPACK, "sW": TCPWindow,
+	"sM": TCPMaimon, "sN": TCPNull, "sF": TCPFIN, "sX": TCPXmas,
+}
+
+func (t ScanTechnique) String() string {
+	for name, technique := range scanTechniqueNames {
+		if t == technique {
+			return name
+		}
+	}
+	return "NotSupportTechnique"
+}
+
+// PortScanConf configures optional external port scanning.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath,omitempty" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques,omitempty" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged,omitempty" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort,omitempty" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c *PortScanConf) GetScanTechniques() (techniques []ScanTechnique) {
+	for _, input := range c.ScanTechniques {
+		technique, ok := scanTechniqueNames[strings.ToLower(input)]
+		if !ok {
+			for name, supported := range scanTechniqueNames {
+				if strings.EqualFold(input, name) {
+					technique, ok = supported, true
+					break
+				}
+			}
+		}
+		if !ok {
+			technique = NotSupportTechnique
+		}
+		techniques = append(techniques, technique)
+	}
+	return
+}
+
+// IsZero reports whether no port scan setting was supplied.
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+// Validate checks external scanner configuration.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, xerrors.New("scannerBinPath is required when port scanning is configured"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil || info.IsDir() {
+		errs = append(errs, xerrors.Errorf("scannerBinPath is invalid or does not exist: %s", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		errs = append(errs, xerrors.New("multiple scan techniques are not supported"))
+	}
+	for _, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, xerrors.New("unsupported scan technique"))
+		}
+	}
+	if !c.HasPrivileged && len(techniques) > 0 && techniques[0] != TCPConnect {
+		errs = append(errs, xerrors.New("only TCPConnect can be used when hasPrivileged is false"))
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, xerrors.Errorf("sourcePort must be an integer in [0,65535]: %s", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, xerrors.New("sourcePort 0 is not usable"))
+		}
+		if len(techniques) > 0 && techniques[0] == TCPConnect {
+			errs = append(errs, xerrors.New("sourcePort is incompatible with TCPConnect"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		out, err := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if err != nil {
+			errs = append(errs, xerrors.Errorf("failed to check scanner capabilities: %s: %w", strings.TrimSpace(string(out)), err))
+		} else if !strings.Contains(string(out), "cap_net_raw") || !hasEffectiveRawCapability(string(out)) {
+			errs = append(errs, xerrors.Errorf("scanner has missing or malformed capabilities: %s", strings.TrimSpace(string(out))))
+		}
+	}
+	return errs
+}
+
+func hasEffectiveRawCapability(output string) bool {
+	for _, field := range strings.Fields(output) {
+		if !strings.Contains(field, "cap_net_raw") {
+			continue
+		}
+		parts := strings.SplitN(field, "=", 2)
+		if len(parts) != 2 {
+			return false
+		}
+		flags := strings.Trim(parts[1], ",")
+		return strings.Contains(flags, "e") && strings.Contains(flags, "p")
+	}
+	return false
+}
