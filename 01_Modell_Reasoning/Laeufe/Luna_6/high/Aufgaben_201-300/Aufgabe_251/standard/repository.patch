+// yamlSourcePosition resolves a CUE data path to the corresponding YAML node.
+// Unknown-field errors point at the mapping key; other errors point at the value.
+func yamlSourcePosition(b []byte, path []string, keyPosition bool) (line, column int, ok bool) {
+	var document stdyaml.Node
+	if err := stdyaml.NewDecoder(bytes.NewReader(b)).Decode(&document); err != nil || len(document.Content) == 0 {
+		return 0, 0, false
+	}
+	node := document.Content[0]
+	for i, part := range path {
+		switch node.Kind {
+		case stdyaml.MappingNode:
+			var value *stdyaml.Node
+			for j := 0; j+1 < len(node.Content); j += 2 {
+				if node.Content[j].Value == part {
+					if keyPosition && i == len(path)-1 {
+						return node.Content[j].Line, node.Content[j].Column, true
+					}
+					value = node.Content[j+1]
+					break
+				}
+			}
+			if value == nil {
+				return 0, 0, false
+			}
+			node = value
+		case stdyaml.SequenceNode:
+			var index int
+			if _, err := fmt.Sscanf(part, "%d", &index); err != nil || index < 0 || index >= len(node.Content) {
+				return 0, 0, false
+			}
+			node = node.Content[index]
+		default:
+			return 0, 0, false
+		}
+	}
+	return node.Line, node.Column, true
+}
