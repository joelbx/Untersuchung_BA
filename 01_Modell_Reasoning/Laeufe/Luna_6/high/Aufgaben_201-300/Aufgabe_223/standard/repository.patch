+def _extract_interpreter(b_module_data):
+    """Return the interpreter and arguments from a module's first line."""
+    first_line = b_module_data.split(b'\n', 1)[0]
+    if not first_line.startswith(b'#!'):
+        return None, []
+
+    args = shlex.split(to_native(first_line[2:].strip(), errors='surrogate_or_strict'))
+    if not args:
+        return None, []
+    return to_text(args[0], errors='surrogate_or_strict'), [to_text(arg, errors='surrogate_or_strict') for arg in args[1:]]
+
+
+def _quote_shebang_arg(arg):
+    """Quote one argument so shlex parsing the shebang recovers the same value."""
+    if arg and not re.search(r"[\s'\\]", arg):
+        return arg
+    return u"'" + arg.replace(u"'", u"'\"'\"'") + u"'"
+
