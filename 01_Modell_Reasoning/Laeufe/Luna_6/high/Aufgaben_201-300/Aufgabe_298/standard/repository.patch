 type simpleCache[K comparable, V any] struct {
-	data *ttlcache.Cache[K, V]
+	data             *ttlcache.Cache[K, V]
+	evictionDeadline atomic.Pointer[time.Time]
+}
+
+const evictionInterval = 10 * time.Millisecond
+
+// evictExpired opportunistically checks all items for expiration. The deadline
+// keeps frequent cache operations from repeatedly scanning the entire cache.
+func (c *simpleCache[K, V]) evictExpired() {
+	now := time.Now()
+	deadline := c.evictionDeadline.Load()
+	if deadline != nil && now.Before(*deadline) {
+		return
+	}
+
+	nextDeadline := now.Add(evictionInterval)
+	if !c.evictionDeadline.CompareAndSwap(deadline, &nextDeadline) {
+		return
+	}
+
+	// ttlcache removes expired items when they are read. Walking its keys and
+	// reading each item therefore purges expired entries without exposing them.
+	for _, key := range c.data.Keys() {
+		c.data.Get(key)
+	}
 }
 
