diff --git a/tests/unit/config/test_qtargs.py b/tests/unit/config/test_qtargs.py
index b38158f..a23a862 100644
--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -87,6 +87,48 @@ class TestQtArgs:
         for arg in ['--foo', '--bar']:
             assert arg in args
 
+    @pytest.mark.parametrize('user_args, config_args, features', [
+        (['--qt-arg', 'enable-features', 'UserFeature,AnotherFeature'], [],
+         'UserFeature,AnotherFeature'),
+        ([], ['enable-features=UserFeature,AnotherFeature'],
+         'UserFeature,AnotherFeature'),
+        (['--qt-arg', 'enable-features', 'CliFeature'],
+         ['enable-features=ConfigFeature'], 'CliFeature,ConfigFeature'),
+    ])
+    def test_enable_features_are_consolidated(self, config_stub, monkeypatch,
+                                              parser, user_args,
+                                              config_args, features):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.qt.args = config_args
+        config_stub.val.scrolling.bar = 'overlay'
+
+        parsed = parser.parse_args(user_args)
+        args = qtargs.qt_args(parsed)
+
+        assert [arg for arg in args if arg.startswith('--enable-features=')] == [
+            '--enable-features={},OverlayScrollbar'.format(features)]
+        assert '--enable-features' not in args
+
+    def test_enable_features_unchanged_for_qtwebkit(self, config_stub,
+                                                    monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebKit)
+        config_stub.val.qt.args = ['enable-features=UserFeature']
+
+        args = qtargs.qt_args(parser.parse_args([]))
+
+        assert '--enable-features=UserFeature' in args
+        assert not any(arg.startswith('--enable-features=OverlayScrollbar')
+                       for arg in args)
+
+    def test_enabled_features_split_user_flags(self, config_stub):
+        config_stub.val.scrolling.bar = 'never'
+        features = list(qtargs._qtwebengine_enabled_features(
+            ['--enable-features=First,Second']))
+
+        assert features == ['First', 'Second']
+
     @pytest.mark.parametrize('backend, expected', [
         (usertypes.Backend.QtWebEngine, True),
         (usertypes.Backend.QtWebKit, False),
