+// parseKEV normalizes the source records returned by go-kev. Dates in its feeds
+// are date-only strings, and placeholder due dates must not become timestamps.
+func parseKEV(data []byte) (models.KEV, error) {
+	var item struct {
+		Type                       models.KEVType `json:"type"`
+		VendorProject              string         `json:"vendorProject"`
+		Product                    string         `json:"product"`
+		VulnerabilityName          string         `json:"vulnerabilityName"`
+		ShortDescription           string         `json:"shortDescription"`
+		RequiredAction             string         `json:"requiredAction"`
+		KnownRansomwareCampaignUse string         `json:"knownRansomwareCampaignUse"`
+		DateAdded                  string         `json:"dateAdded"`
+		DueDate                    string         `json:"dueDate"`
+		Notes                      string         `json:"notes"`
+		Note                       string         `json:"note"`
+		VulnCheck                  *struct {
+			XDB []struct {
+				XDBID       string `json:"xdbID"`
+				ID          string `json:"id"`
+				XDBURL      string `json:"xdbURL"`
+				URL         string `json:"url"`
+				DateAdded   string `json:"dateAdded"`
+				ExploitType string `json:"exploitType"`
+				CloneSSHURL string `json:"cloneSSHURL"`
+			} `json:"xdb"`
+			ReportedExploitation []struct {
+				URL       string `json:"url"`
+				DateAdded string `json:"dateAdded"`
+			} `json:"reportedExploitation"`
+		} `json:"vulncheck"`
+	}
+	if err := json.Unmarshal(data, &item); err != nil {
+		return models.KEV{}, err
+	}
+	kev := models.KEV{
+		Type: item.Type, VendorProject: item.VendorProject, Product: item.Product,
+		VulnerabilityName: item.VulnerabilityName, ShortDescription: item.ShortDescription,
+		RequiredAction: item.RequiredAction, KnownRansomwareCampaignUse: item.KnownRansomwareCampaignUse,
+	}
+	if kev.Type == "" {
+		kev.Type = models.CISAKEVType
+	}
+	var err error
+	if kev.DateAdded, err = parseKEVDate(item.DateAdded); err != nil {
+		return models.KEV{}, err
+	}
+	if dueDate, err := parseKEVDate(item.DueDate); err == nil && !dueDate.IsZero() {
+		kev.DueDate = &dueDate
+	}
+	if kev.Type == models.CISAKEVType {
+		note := item.Note
+		if note == "" {
+			note = item.Notes
+		}
+		kev.CISA = &models.CISAKEV{Note: note}
+	} else if kev.Type == models.VulnCheckKEVType {
+		kev.VulnCheck = &models.VulnCheckKEV{}
+		if item.VulnCheck != nil {
+			for _, xdb := range item.VulnCheck.XDB {
+				dateAdded, err := parseKEVDate(xdb.DateAdded)
+				if err != nil {
+					return models.KEV{}, err
+				}
+				id, url := xdb.XDBID, xdb.XDBURL
+				if id == "" {
+					id = xdb.ID
+				}
+				if url == "" {
+					url = xdb.URL
+				}
+				kev.VulnCheck.XDB = append(kev.VulnCheck.XDB, models.VulnCheckXDB{
+					XDBID: id, XDBURL: url, DateAdded: dateAdded,
+					ExploitType: xdb.ExploitType, CloneSSHURL: xdb.CloneSSHURL,
+				})
+			}
+			for _, exploitation := range item.VulnCheck.ReportedExploitation {
+				dateAdded, err := parseKEVDate(exploitation.DateAdded)
+				if err != nil {
+					return models.KEV{}, err
+				}
+				kev.VulnCheck.ReportedExploitation = append(kev.VulnCheck.ReportedExploitation,
+					models.VulnCheckReportedExploitation{URL: exploitation.URL, DateAdded: dateAdded})
+			}
+		}
+	}
+	return kev, nil
+}
+
+func parseKEVDate(value string) (time.Time, error) {
+	value = strings.TrimSpace(value)
+	if value == "" || strings.EqualFold(value, "n/a") || value == "-" {
+		return time.Time{}, nil
+	}
+	for _, layout := range []string{time.DateOnly, time.RFC3339, "2006-01-02 15:04:05"} {
+		if parsed, err := time.Parse(layout, value); err == nil {
+			return parsed, nil
+		}
+	}
+	return time.Time{}, xerrors.Errorf("invalid KEV date %q", value)
+}
