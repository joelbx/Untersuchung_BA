+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenList.map(tokenKey)),
+		tokenUtils.getLastSeen(tokenList),
+	]);
+	const hydrated = tokenList.map((token, index) => {
+		const data = objects[index];
+		if (!data) {
+			return null;
+		}
+		return {
+			uid: finiteNumber(data.uid),
+			description: data.description,
+			timestamp: finiteNumber(data.timestamp),
+			lastSeen: lastSeen[index],
+		};
+	});
+	return isArray ? hydrated : hydrated[0];
+};
