+func TestNewWithClientEnvironment(t *testing.T) {
+	t.Run("missing namespace", func(t *testing.T) {
+		t.Setenv(NamespaceEnv, "")
+		t.Setenv(teleportReplicaNameEnv, "agent-0")
+
+		_, err := NewWithClient(fake.NewSimpleClientset())
+		require.EqualError(t, err, `environment variable "KUBE_NAMESPACE" not set or empty`)
+	})
+
+	t.Run("missing replica name", func(t *testing.T) {
+		t.Setenv(NamespaceEnv, "test")
+		t.Setenv(teleportReplicaNameEnv, "")
+
+		_, err := NewWithClient(fake.NewSimpleClientset())
+		require.EqualError(t, err, `environment variable "TELEPORT_REPLICA_NAME" not set or empty`)
+	})
+
+	t.Run("configuration reads environment", func(t *testing.T) {
+		t.Setenv(NamespaceEnv, "test")
+		t.Setenv(teleportReplicaNameEnv, "agent-0")
+		t.Setenv(ReleaseNameEnv, "teleport")
+
+		b, err := NewWithClient(fake.NewSimpleClientset())
+		require.NoError(t, err)
+		require.Equal(t, "test", b.Namespace)
+		require.Equal(t, "teleport", b.ReleaseName)
+	})
+}
