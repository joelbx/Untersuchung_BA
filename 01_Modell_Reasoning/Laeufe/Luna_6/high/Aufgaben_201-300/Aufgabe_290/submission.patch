+import { logger } from 'matrix-js-sdk/src/logger';
+
+import SettingsStore from '../../settings/SettingsStore';
+
+const ERROR_EVENTS = new Set(['error', 'abort', 'stalled']);
+const DEBUG_EVENTS = new Set([
+    'canplay',
+    'canplaythrough',
+    'durationchange',
+    'emptied',
+    'ended',
+    'loadeddata',
+    'loadedmetadata',
+    'loadstart',
+    'pause',
+    'play',
+    'playing',
+    'progress',
+    'ratechange',
+    'seeked',
+    'seeking',
+    'suspend',
+    'timeupdate',
+    'volumechange',
+    'waiting',
+]);
+
+/**
+ * Public listener for HTMLMediaElement events. Safe to attach directly to a
+ * media element.
+ */
+export function handleEvent(e: Event): void {
+    const element = e.currentTarget as HTMLMediaElement | null;
+    const elementId = element?.id;
+
+    if (ERROR_EVENTS.has(e.type)) {
+        logger.error('Legacy call audio media error', {
+            eventType: e.type,
+            elementId,
+            error: element?.error,
+        });
+    } else if (DEBUG_EVENTS.has(e.type) && SettingsStore.getValue('debug_legacy_call_handler')) {
+        logger.debug('Legacy call audio media event', {
+            eventType: e.type,
+            elementId,
+        });
+    }
+}
