+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards\.json"
+    encoding = "json"
+
+    def POST(self, work_id):
+        user = accounts.get_current_user()
+        if not user:
+            return delegate.RawText(
+                json.dumps({'errors': 'Authentication failed'}),
+                content_type='application/json',
+            )
+        username = user.key.split('/')[2]
+        i = web.input(op=None, topic=None, comment='', edition_key=None)
+        try:
+            edition_id = (
+                extract_numeric_id_from_olid(i.edition_key) if i.edition_key else None
+            )
+            if i.op == 'add' and i.topic:
+                Bestbook.add(username, work_id, i.topic, i.comment, edition_id)
+            elif i.op == 'update' and i.topic:
+                Bestbook.update(username, work_id, i.topic, i.comment, edition_id)
+            elif i.op == 'remove':
+                rows = Bestbook.remove(username, work_id=work_id)
+                return delegate.RawText(
+                    json.dumps({'success': True, 'rows': rows}),
+                    content_type='application/json',
+                )
+            else:
+                raise Bestbook.AwardConditionsError(
+                    'Invalid award operation or missing topic'
+                )
+            award = Bestbook.get_awards(username=username, work_id=work_id)[0]
+            award_value = {
+                field: award[field]
+                for field in ('id', 'username', 'work_id', 'topic', 'comment', 'edition_id')
+            }
+            return delegate.RawText(
+                json.dumps({'success': True, 'award': award_value}),
+                content_type='application/json',
+            )
+        except Bestbook.AwardConditionsError as error:
+            return delegate.RawText(
+                json.dumps({'errors': str(error)}), content_type='application/json'
+            )
+
+
+class bestbook_count(delegate.page):
+    path = r"/awards/count\.json"
+    encoding = "json"
+
+    @jsonapi
+    def GET(self):
+        i = web.input(work_id=None, username=None, topic=None)
+        try:
+            count = Bestbook.get_count(
+                work_id=i.work_id, username=i.username, topic=i.topic
+            )
+        except (TypeError, ValueError):
+            count = 0
+        return json.dumps({'count': count})
+
+
