diff --git a/internal/server/audit/types_test.go b/internal/server/audit/types_test.go
index 218d657..403ade7 100644
--- a/internal/server/audit/types_test.go
+++ b/internal/server/audit/types_test.go
@@ -171,3 +171,36 @@ func TestRule(t *testing.T) {
 		testDistributionHelper(t, d)
 	}
 }
+
+func TestRuleSegments(t *testing.T) {
+	single := NewRule(&flipt.Rule{SegmentKeys: []string{"one"}})
+	assert.Equal(t, "one", single.SegmentKey)
+	assert.Empty(t, single.SegmentOperator)
+
+	multiple := NewRule(&flipt.Rule{
+		SegmentKeys:     []string{"one", "two"},
+		SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+	})
+	assert.Equal(t, "one,two", multiple.SegmentKey)
+	assert.Equal(t, flipt.SegmentOperator_AND_SEGMENT_OPERATOR.String(), multiple.SegmentOperator)
+}
+
+func TestRolloutSegments(t *testing.T) {
+	single := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{
+		Segment: &flipt.RolloutSegment{SegmentKeys: []string{"one"}, Value: true},
+	}})
+	assert.Equal(t, &RolloutSegment{Key: "one", Value: true}, single.Segment)
+
+	multiple := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{
+		Segment: &flipt.RolloutSegment{
+			SegmentKeys:     []string{"one", "two"},
+			SegmentOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR,
+			Value:           false,
+		},
+	}})
+	assert.Equal(t, &RolloutSegment{
+		Key:      "one,two",
+		Value:    false,
+		Operator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR.String(),
+	}, multiple.Segment)
+}
