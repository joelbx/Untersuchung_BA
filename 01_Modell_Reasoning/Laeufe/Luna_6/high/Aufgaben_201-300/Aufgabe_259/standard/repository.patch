+    @pytest.mark.asyncio
+    async def test_public_edition_is_preferred_with_multiple_access_types(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w,
+                    key="/books/OL10M",
+                    ocaid='public-scan',
+                    _ia_meta={"collection": ['americana', 'opensource']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL11M",
+                    ocaid='loanable-scan',
+                    _ia_meta={"collection": ['inlibrary', 'internetarchivebooks']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL12M",
+                    ocaid='printdisabled-scan',
+                    _ia_meta={"collection": ['printdisabled', 'inlibrary']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+
+        assert d['has_fulltext'] is True
+        assert d['public_scan_b'] is True
+        assert d['lending_edition_s'] == 'OL10M'
+        assert d['printdisabled_s'] == 'OL12M'
+        assert set(d['ia']) == {'public-scan', 'loanable-scan', 'printdisabled-scan'}
+        assert set(d['ia_collection_s'].split(';')) == {
+            'americana',
+            'opensource',
+            'inlibrary',
+            'internetarchivebooks',
+            'printdisabled',
+        }
+
