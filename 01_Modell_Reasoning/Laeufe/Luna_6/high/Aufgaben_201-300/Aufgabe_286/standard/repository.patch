diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..e0962f0
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,65 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Check looks up the latest published release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	info := Info{CurrentVersion: version}
+	client := github.NewClient(nil)
+	release, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return failed(info, fmt.Errorf("checking for latest version: %w", err))
+	}
+
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return failed(info, fmt.Errorf("parsing current version: %w", err))
+	}
+	latestVersion := release.GetTagName()
+	latest, err := semver.ParseTolerant(latestVersion)
+	if err != nil {
+		return failed(info, fmt.Errorf("parsing latest version: %w", err))
+	}
+
+	info.LatestVersion = latestVersion
+	info.LatestVersionURL = release.GetHTMLURL()
+	info.UpdateAvailable = current.Compare(latest) < 0
+	return info, nil
+}
+
+func failed(info Info, err error) (Info, error) {
+	zap.L().Warn("checking for updates", zap.Error(err))
+	return info, err
+}
+
+// Is reports whether version is a stable release build.
+func Is(version string) bool {
+	if version == "" {
+		return false
+	}
+	version = strings.ToLower(version)
+	if version == "dev" || strings.Contains(version, "dev") ||
+		strings.Contains(version, "-snapshot") || strings.Contains(version, "-rc") {
+		return false
+	}
+	if parsed, err := semver.ParseTolerant(version); err == nil && len(parsed.Pre) > 0 {
+		return false
+	}
+	return true
+}
