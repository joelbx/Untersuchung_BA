+func TestConvertToVinfosEnterpriseFields(t *testing.T) {
+	body := `{"wordpress":{"vulnerabilities":[{
+		"id":"123",
+		"title":"Example",
+		"description":"Detailed summary",
+		"created_at":"2024-01-02T03:04:05+02:00",
+		"updated_at":"2024-02-03T04:05:06+03:00",
+		"vuln_type":"SQL Injection",
+		"references":{"cve":["2024-1234","2024-5678"],"url":["https://one.example","https://two.example"]},
+		"fixed_in":"6.5.1",
+		"poc":"https://poc.example",
+		"introduced_in":"6.1",
+		"cvss":{"score":8.1,"vector":"CVSS:3.1/AV:N/AC:L","severity":"HIGH"}
+	}]}}`
+	vinfos, err := convertToVinfos("core", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(vinfos) != 1 {
+		t.Fatalf("expected one record, got %d", len(vinfos))
+	}
+	vinfo := vinfos[0]
+	if vinfo.CveID != "CVE-2024-1234" || vinfo.VulnType != "SQL Injection" {
+		t.Fatalf("unexpected identity/classification: %+v", vinfo)
+	}
+	content := vinfo.CveContents[models.WpScan][0]
+	if content.Type != models.WpScan || content.Summary != "Detailed summary" {
+		t.Fatalf("unexpected source or summary: %+v", content)
+	}
+	if content.Published.Location() != time.UTC || !content.Published.Equal(time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)) {
+		t.Errorf("published timestamp was not normalized to UTC: %v", content.Published)
+	}
+	if content.LastModified.Location() != time.UTC || !content.LastModified.Equal(time.Date(2024, 2, 3, 1, 5, 6, 0, time.UTC)) {
+		t.Errorf("last modified timestamp was not normalized to UTC: %v", content.LastModified)
+	}
+	wantRefs := []string{"https://one.example", "https://two.example"}
+	if len(content.References) != len(wantRefs) || content.References[0].Link != wantRefs[0] || content.References[1].Link != wantRefs[1] {
+		t.Errorf("reference order not preserved: %+v", content.References)
+	}
+	if len(vinfo.WpPackageFixStats) != 1 || vinfo.WpPackageFixStats[0].FixedIn != "6.5.1" {
+		t.Errorf("unexpected fix version: %+v", vinfo.WpPackageFixStats)
+	}
+	if content.Optional["poc"] != "https://poc.example" || content.Optional["introduced_in"] != "6.1" {
+		t.Errorf("unexpected optional metadata: %+v", content.Optional)
+	}
+	if content.Cvss3Score != 8.1 || content.Cvss3Vector != "CVSS:3.1/AV:N/AC:L" || content.Cvss3Severity != "HIGH" {
+		t.Errorf("unexpected CVSS fields: %+v", content)
+	}
+}
+
+func TestConvertToVinfosBasicFields(t *testing.T) {
+	body := `{"wordpress":{"vulnerabilities":[{
+		"id":"123","references":{"cve":["CVE-2024-1234"],"url":[]},
+		"poc":null,"introduced_in":null,"cvss":null,"description":null,"fixed_in":null
+	}]}}`
+	vinfos, err := convertToVinfos("core", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(vinfos) != 1 || vinfos[0].CveID != "CVE-2024-1234" {
+		t.Fatalf("unexpected records: %+v", vinfos)
+	}
+	content := vinfos[0].CveContents[models.WpScan][0]
+	if content.Optional == nil || len(content.Optional) != 0 {
+		t.Errorf("expected empty optional map, got %#v", content.Optional)
+	}
+	if content.Summary != "" || content.Cvss3Score != 0 || content.Cvss3Vector != "" || content.Cvss3Severity != "" {
+		t.Errorf("absent enrichment fabricated values: %+v", content)
+	}
+	if vinfos[0].WpPackageFixStats[0].FixedIn != "" {
+		t.Errorf("expected empty fix version, got %q", vinfos[0].WpPackageFixStats[0].FixedIn)
+	}
+}
