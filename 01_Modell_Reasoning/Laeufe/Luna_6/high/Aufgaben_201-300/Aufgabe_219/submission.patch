 }
+
+func TestCheckerTokenEvents(t *testing.T) {
+	tests := []struct {
+		name       string
+		eventPairs []string
+		wantCreate bool
+		wantDelete bool
+	}{
+		{name: "token events", eventPairs: []string{"token:created", "token:deleted"}, wantCreate: true, wantDelete: true},
+		{name: "token deletion wildcard", eventPairs: []string{"*:deleted"}, wantDelete: true},
+		{name: "all events", eventPairs: []string{"*:*"}, wantCreate: true, wantDelete: true},
+		{name: "creation only", eventPairs: []string{"token:created"}, wantCreate: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			checker, err := NewChecker(tt.eventPairs)
+			assert.NoError(t, err)
+			assert.Equal(t, tt.wantCreate, checker.Check("token:created"))
+			assert.Equal(t, tt.wantDelete, checker.Check("token:deleted"))
+		})
+	}
+}
