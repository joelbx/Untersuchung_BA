diff --git a/config/os.go b/config/os.go
new file mode 100644
index 0000000..5a0bd8d
--- /dev/null
+++ b/config/os.go
@@ -0,0 +1,148 @@
+package config
+
+import "time"
+
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// EOL describes the end of standard and extended support for an OS release.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support ended before now.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether applicable extended support ended before now.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+var eolDates = map[string]map[string][2]string{
+	Amazon:  {"2018.03": {"2023-06-30", "2023-06-30"}, "2 (Karoo)": {"2025-06-30", ""}},
+	RedHat:  {"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""}, "6": {"2020-11-30", "2024-06-30"}},
+	CentOS:  {"7": {"2024-06-30", ""}, "8": {"2021-12-31", ""}, "6": {"2020-11-30", "2020-11-30"}},
+	Oracle:  {"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""}, "6": {"2021-03-31", "2022-03-31"}},
+	Ubuntu:  {"18.04": {"2023-05-31", "2028-04-30"}, "14.04": {"2019-04-30", "2024-04-30"}, "14.10": {"2015-07-30", "2015-07-30"}, "21.04": {"2022-01-30", ""}},
+	Debian:  {"9": {"2022-06-30", ""}, "10": {"2024-06-30", ""}, "8": {"2020-06-30", "2020-06-30"}},
+	Alpine:  {"3.10": {"2021-05-30", ""}, "3.11": {"2021-11-30", ""}, "3.12": {"2022-05-30", ""}, "3.9": {"2020-11-30", "2020-11-30"}},
+	FreeBSD: {"11": {"2021-09-30", "2021-09-30"}, "12": {"2023-12-31", ""}, "10": {"2019-10-30", "2019-10-30"}},
+}
+
+// GetEOL returns lifecycle information for a modeled OS family and release.
+func GetEOL(family, release string) (EOL, bool) {
+	versions, ok := eolDates[family]
+	if !ok {
+		return EOL{}, false
+	}
+	key := release
+	if family != Amazon {
+		// Ubuntu and Alpine releases use major.minor identifiers; other modeled
+		// families use the major release.
+		if family == Ubuntu || family == Alpine {
+			parts := splitVersion(release)
+			if len(parts) >= 2 {
+				key = parts[0] + "." + parts[1]
+			}
+		} else {
+			key = majorRelease(release)
+		}
+	} else if release != "2018.03" && release != "2 (Karoo)" {
+		// Amazon Linux 1 has a single token; Amazon Linux 2 has a named release.
+		if len(splitVersion(release)) == 1 && release != "" {
+			if release[0] == '2' {
+				key = "2 (Karoo)"
+			} else {
+				key = release
+			}
+		}
+	}
+	dates, ok := versions[key]
+	if !ok {
+		return EOL{}, false
+	}
+	standard, _ := time.Parse("2006-01-02", dates[0])
+	var extended time.Time
+	if dates[1] != "" {
+		extended, _ = time.Parse("2006-01-02", dates[1])
+	}
+	e := EOL{StandardSupportUntil: standard, ExtendedSupportUntil: extended}
+	e.Ended = e.IsStandardSupportEnded(time.Now())
+	return e, true
+}
+
+// Major extracts the major component of a version, ignoring an optional epoch.
+func Major(version string) string {
+	if i := indexByte(version, ':'); i >= 0 {
+		version = version[i+1:]
+	}
+	if i := indexByte(version, '.'); i >= 0 {
+		return version[:i]
+	}
+	return version
+}
+
+func indexByte(s string, b byte) int {
+	for i := 0; i < len(s); i++ {
+		if s[i] == b {
+			return i
+		}
+	}
+	return -1
+}
+
+func splitVersion(version string) []string {
+	parts := []string{}
+	start := -1
+	for i, r := range version {
+		if r >= '0' && r <= '9' || r == '.' {
+			if start < 0 {
+				start = i
+			}
+		} else if start >= 0 {
+			parts = append(parts, version[start:i])
+			start = -1
+		}
+	}
+	if start >= 0 {
+		parts = append(parts, version[start:])
+	}
+	return parts
+}
+
+func majorRelease(version string) string {
+	if i := indexNonDigit(version); i >= 0 {
+		return version[:i]
+	}
+	return version
+}
+
+func indexNonDigit(s string) int {
+	for i, r := range s {
+		if r < '0' || r > '9' {
+			return i
+		}
+	}
+	return -1
+}
