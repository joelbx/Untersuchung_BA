+func TestLoadEnvironmentOverrides(t *testing.T) {
+	for _, key := range []string{"FLIPT_LOG_LEVEL", "FLIPT_SERVER_HTTP_PORT"} {
+		value, exists := os.LookupEnv(key)
+		require.NoError(t, os.Unsetenv(key))
+		t.Cleanup(func() {
+			if exists {
+				_ = os.Setenv(key, value)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		})
+	}
+
+	t.Run("defaults without a file", func(t *testing.T) {
+		res, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, "INFO", res.Config.Log.Level)
+		assert.Equal(t, 8080, res.Config.Server.HTTPPort)
+	})
+
+	t.Run("overrides without a file", func(t *testing.T) {
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8081")
+		res, err := Load("")
+		require.NoError(t, err)
+		assert.Equal(t, "debug", res.Config.Log.Level)
+		assert.Equal(t, 8081, res.Config.Server.HTTPPort)
+	})
+
+	t.Run("overrides file values", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "config.yml")
+		require.NoError(t, os.WriteFile(path, []byte("log:\n  level: WARN\nserver:\n  http_port: 8082\n"), 0600))
+		t.Setenv("FLIPT_LOG_LEVEL", "debug")
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8081")
+		res, err := Load(path)
+		require.NoError(t, err)
+		assert.Equal(t, "debug", res.Config.Log.Level)
+		assert.Equal(t, 8081, res.Config.Server.HTTPPort)
+	})
+}
