diff --git a/utils/singleton/singleton.go b/utils/singleton/singleton.go
index fb1d86d..39e1133 100644
--- a/utils/singleton/singleton.go
+++ b/utils/singleton/singleton.go
@@ -3,15 +3,36 @@ package singleton
 import (
 	"reflect"
 	"strings"
+	"sync"
 
 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances        = make(map[string]interface{})
+	getOrCreateC     = make(chan *entry, 1)
+	genericInstances sync.Map // reflect.Type -> *genericEntry
 )
 
+type genericEntry struct {
+	once        sync.Once
+	constructor func()
+	value       interface{} // *T, so even a nil T can be stored
+}
+
+// GetInstance returns the singleton for T, constructing it on the first call.
+// T and *T have distinct entries.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	e := &genericEntry{}
+	e.value = new(T)
+	e.constructor = func() { *e.value.(*T) = constructor() }
+	stored, _ := genericInstances.LoadOrStore(typeOfT, e)
+	instance := stored.(*genericEntry)
+	instance.once.Do(instance.constructor)
+	return *instance.value.(*T)
+}
+
 type entry struct {
 	constructor func() interface{}
 	object      interface{}
diff --git a/utils/singleton/singleton_test.go b/utils/singleton/singleton_test.go
index 9014e4e..464bfa2 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -73,3 +73,62 @@ var _ = Describe("Get", func() {
 		Expect(numInstances).To(Equal(1))
 	})
 })
+
+func TestGetInstance(t *testing.T) {
+	type value struct{ id int }
+	var valueCalls int
+	first := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 42}
+	})
+	second := singleton.GetInstance(func() value {
+		t.Fatal("value constructor called twice")
+		return value{}
+	})
+	if first != (value{id: 42}) || second != first || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v calls=%d", first, second, valueCalls)
+	}
+
+	var pointerCalls int
+	pointer := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 99}
+	})
+	again := singleton.GetInstance(func() *value {
+		t.Fatal("pointer constructor called twice")
+		return nil
+	})
+	if pointer != again || pointer.id != 99 || pointerCalls != 1 || valueCalls != 1 {
+		t.Fatalf("pointer singleton: pointer=%p again=%p calls=%d", pointer, again, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type instance struct{ id int }
+	const calls = 20000
+	var constructions int32
+	results := make([]*instance, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *instance {
+				atomic.AddInt32(&constructions, 1)
+				return &instance{id: 1}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+	if got := atomic.LoadInt32(&constructions); got != 1 {
+		t.Fatalf("constructor ran %d times; want 1", got)
+	}
+	for i, result := range results {
+		if result != results[0] || result.id != 1 {
+			t.Fatalf("call %d returned %p; want %p", i, result, results[0])
+		}
+	}
+}
