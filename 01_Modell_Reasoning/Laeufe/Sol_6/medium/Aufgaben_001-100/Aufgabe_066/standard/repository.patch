+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and nested elements while preserving other styles', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 100vh; color: red');
+        root.innerHTML = `
+            <section style="height: calc(50vh - 10px) !important; width: 20vh">
+                <div style="height: 25px; min-height: 50vh"></div>
+            </section>
+            <p style="color: blue"></p>
+        `;
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+
+        const section = root.querySelector('section') as HTMLElement;
+        expect(section.style.height).toBe('auto');
+        expect(section.style.getPropertyPriority('height')).toBe('important');
+        expect(section.style.width).toBe('20vh');
+
+        const inner = root.querySelector('div') as HTMLElement;
+        expect(inner.style.height).toBe('25px');
+        expect(inner.style.minHeight).toBe('50vh');
+        expect((root.querySelector('p') as HTMLElement).style.color).toBe('blue');
+    });
+
+    it('leaves heights without a vh unit unchanged', () => {
+        const root = document.createElement('div');
+        root.innerHTML = '<p style="height: 50%; width: 10vh"></p><p style="height: 20px"></p>';
+
+        transformStyleAttributes(root);
+
+        expect((root.children[0] as HTMLElement).style.height).toBe('50%');
+        expect((root.children[1] as HTMLElement).style.height).toBe('20px');
+    });
+});
