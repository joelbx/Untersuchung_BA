+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "diag.h"
+
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+
+TouchIDDiagResult TouchIDDiag(void) {
+  TouchIDDiagResult result = {0};
+
+  SecCodeRef selfCode = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &selfCode) == errSecSuccess) {
+    CFDictionaryRef signingInfo = NULL;
+    if (SecCodeCopySigningInformation(selfCode, kSecCSSigningInformation,
+                                      &signingInfo) == errSecSuccess) {
+      NSDictionary *info = (__bridge NSDictionary *)signingInfo;
+      NSArray *certificates = info[(id)kSecCodeInfoCertificates];
+      result.has_signature = certificates.count > 0;
+
+      NSDictionary *entitlements = info[(id)kSecCodeInfoEntitlementsDict];
+      NSArray *groups = entitlements[@"keychain-access-groups"];
+      result.has_entitlements = groups.count > 0;
+      CFRelease(signingInfo);
+    }
+    CFRelease(selfCode);
+  }
+
+  LAContext *context = [[LAContext alloc] init];
+  result.passed_la_policy_test =
+      [context canEvaluatePolicy:LAPolicyDeviceOwnerAuthenticationWithBiometrics
+                          error:NULL];
+
+  // A non-permanent key tests access to the Secure Enclave without leaving a
+  // credential behind or asking for biometric authentication.
+  NSDictionary *attributes = @{
+    (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+    (id)kSecAttrKeySizeInBits : @256,
+    (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+    (id)kSecPrivateKeyAttrs : @{(id)kSecAttrIsPermanent : @NO},
+  };
+  SecKeyRef key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes,
+                                        NULL);
+  result.passed_secure_enclave_test = key != NULL;
+  if (key) {
+    CFRelease(key);
+  }
+
+  return result;
+}
