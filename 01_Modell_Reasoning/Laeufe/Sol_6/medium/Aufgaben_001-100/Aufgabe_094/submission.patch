+func diag() (*DiagResult, error) {
+	checks := C.TouchIDDiag()
+	result := &DiagResult{
+		HasCompileSupport:       true,
+		HasSignature:            checks.has_signature != 0,
+		HasEntitlements:         checks.has_entitlements != 0,
+		PassedLAPolicyTest:      checks.passed_la_policy_test != 0,
+		PassedSecureEnclaveTest: checks.passed_secure_enclave_test != 0,
+	}
+	result.IsAvailable = result.HasSignature && result.HasEntitlements &&
+		result.PassedLAPolicyTest && result.PassedSecureEnclaveTest
+	return result, nil
 }
 
