@@ -1,4 +1,5 @@
 from openlibrary.plugins.openlibrary import lists
+import web
 
 
 def test_process_seeds():
@@ -11,3 +12,39 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_from_body_ignores_query_and_nested_seed_defaults(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: (
+            b'name=Body+name&name=Later+name&description=Body+description'
+            b'&seeds--0--key=%2Fworks%2FOL1W&seeds--1--unused=invalid'
+            b'&seeds--2--key=%2Fbooks%2FOL2M&seeds--3=invalid'
+        ),
+    )
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: (_ for _ in ()).throw(AssertionError('query read')),
+    )
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'Body name'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/works/OL1W'}, {'key': '/books/OL2M'}]
+
+
+def test_list_record_from_query_without_body(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+
+    def query_input(**defaults):
+        assert defaults == {'key': None, 'name': '', 'description': '', 'seeds': []}
+        return web.storage(defaults, name='Query name')
+
+    monkeypatch.setattr(web, 'input', query_input)
+
+    assert lists.ListRecord.from_input() == lists.ListRecord(name='Query name')
