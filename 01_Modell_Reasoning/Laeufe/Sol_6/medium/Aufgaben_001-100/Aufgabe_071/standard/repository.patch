+def test_parse_clixml_decodes_escapes_and_surrogates():
+    data = (b'<Objs><S S="Error">_x000D__x000A__x263A__xD83D__xDE00_'
+            b'_x005F__x000A_ _x005F_ _x005f_ _x005G_ _xD83D_'
+            b'_x000D_X_x000A__x123_</S></Objs>')
+    expected = '\r\n\u263a\U0001f600_\n _x005F_ _ _x005G_ \ud83d\rX\n_x123_'.encode('utf-8', 'surrogatepass')
+    assert _parse_clixml(data) == expected
+
+
+def test_parse_clixml_stream_empty_text_and_block_boundaries():
+    data = (b'<Objs><S S="Info">ignored</S><S S="Error" />'
+            b'<S S="Error">first</S><S S="Error">second</S></Objs>'
+            b'<Objs><S S="Info">ignored</S></Objs>'
+            b'<Objs><S S="Error">third</S><S S="Error" /></Objs>')
+    assert _parse_clixml(data) == b'firstsecond\r\nthird'
+    assert _parse_clixml(data, stream='Info') == b'ignored\r\nignored'
+    assert _parse_clixml(data, stream='Debug') == b''
+    assert _parse_clixml(b'<Objs><S S="Error" /></Objs><Objs><S S="Error" /></Objs>') == b''
+
+
