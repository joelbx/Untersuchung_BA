+@pytest.mark.parametrize('filter_function', (to_yaml, to_nice_yaml))
+def test_yaml_filter_undefined(filter_function):
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_function({'environment': AnsibleUndefined(name='MYSVC_ENV')})
+    assert filter_function.__name__ in str(error.value)
+    assert 'MYSVC_ENV' in str(error.value)
+    assert isinstance(error.value.orig_exc, UndefinedError)
+
+
+@pytest.mark.parametrize('filter_name', ('to_yaml', 'to_nice_yaml'))
+def test_yaml_filter_undefined_in_template(filter_name):
+    templar = Templar(loader=DictDataLoader({}), variables={})
+    template = '{{ MYSVC_ENV | %s }}' % filter_name
+    with pytest.raises(AnsibleUndefinedVariable) as error:
+        templar.template(template)
+    assert 'MYSVC_ENV' in str(error.value)
+    assert isinstance(error.value.orig_exc, UndefinedError)
+    assert templar.template(template, fail_on_undefined=False) == template
+
+
+@pytest.mark.parametrize('filter_function', (to_yaml, to_nice_yaml))
