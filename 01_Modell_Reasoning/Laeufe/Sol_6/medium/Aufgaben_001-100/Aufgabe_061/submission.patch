+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	owners, err := r.parseOwnerPkgs(`libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 39.el7 i686
+error: file /run/log/journal/system.journal: Permission denied
+file /tmp/unowned is not owned by any package
+error: /tmp/missing: No such file or directory
+`)
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(owners, []string{"libgcc"}) {
+		t.Fatalf("unexpected owners: %v", owners)
+	}
+	if _, err := r.parseOwnerPkgs("unrecognized rpm output"); err == nil {
+		t.Fatal("expected malformed rpm output to fail")
+	}
+	if _, err := r.parseOwnerPkgs("this is not rpm output"); err == nil {
+		t.Fatal("expected five-field malformed rpm output to fail")
+	}
+}
