+func TestStringToSliceHook(t *testing.T) {
+	tests := []struct {
+		name   string
+		input  interface{}
+		target interface{}
+		want   interface{}
+	}{
+		{
+			name:   "mixed whitespace",
+			input:  " \tfoo.com  bar.com\n\tbaz.com \r\n",
+			target: []string{},
+			want:   []string{"foo.com", "bar.com", "baz.com"},
+		},
+		{
+			name:   "empty string",
+			input:  "",
+			target: []string{},
+			want:   []string{},
+		},
+		{
+			name:   "whitespace only",
+			input:  " \t\n",
+			target: []string{},
+			want:   []string{},
+		},
+		{
+			name:   "existing sequence",
+			input:  []string{"foo.com", "bar.com"},
+			target: []string{},
+			want:   []string{"foo.com", "bar.com"},
+		},
+		{
+			name:   "non-string scalar",
+			input:  42,
+			target: []string{},
+			want:   42,
+		},
+		{
+			name:   "different target slice",
+			input:  "1 2",
+			target: []int{},
+			want:   "1 2",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := mapstructure.DecodeHookExec(
+				stringToSliceHookFunc(),
+				reflect.ValueOf(tt.input),
+				reflect.ValueOf(tt.target),
+			)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
