diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..3222574 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,45 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the same hash when a previous seed is set again", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("id", "original")
+		original := hashFunc("id", input)
+		Expect(hashFunc("id", input)).To(Equal(original))
+
+		h.SetSeed("id", "replacement")
+		Expect(hashFunc("id", input)).NotTo(Equal(original))
+
+		h.SetSeed("id", "original")
+		Expect(hashFunc("id", input)).To(Equal(original))
+	})
+
+	It("uses the same explicit seed across hasher instances", func() {
+		first := hasher.NewHasher()
+		second := hasher.NewHasher()
+		first.SetSeed("id", "shared")
+		second.SetSeed("id", "shared")
+		Expect(first.HashFunc()("id", input)).To(Equal(second.HashFunc()("id", input)))
+	})
+
+	It("initializes an unset id and keeps its hash stable", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		original := hashFunc("unset", input)
+		Expect(hashFunc("unset", input)).To(Equal(original))
+		h.Reseed("unset")
+		Expect(hashFunc("unset", input)).NotTo(Equal(original))
+	})
+
+	It("uses the package SetSeed function for the global hasher", func() {
+		hashFunc := hasher.HashFunc()
+		hasher.SetSeed("global-seed-test", "original")
+		original := hashFunc("global-seed-test", input)
+		hasher.SetSeed("global-seed-test", "replacement")
+		Expect(hashFunc("global-seed-test", input)).NotTo(Equal(original))
+		hasher.SetSeed("global-seed-test", "original")
+		Expect(hashFunc("global-seed-test", input)).To(Equal(original))
+	})
 })
