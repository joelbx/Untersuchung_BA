+from qutebrowser.qt import machinery
 
 
 @pytest.mark.parametrize('attr', ['stderr', '__stderr__'])
@@ -48,3 +49,61 @@ def test_qt_version(same):
 def test_qt_version_no_args():
     """Make sure qt_version without arguments at least works."""
     earlyinit.qt_version()
+
+
+def test_check_qt_available_no_wrapper(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+
+    def unavailable(current_info):
+        assert current_info is info
+        current_info.pyqt5 = "ImportError: missing PyQt5"
+        current_info.pyqt6 = "ImportError: missing PyQt6"
+        return False
+
+    monkeypatch.setattr(machinery, "check_wrapper_availability", unavailable)
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        earlyinit.check_qt_available(info)
+    assert excinfo.value.info is info
+    assert str(excinfo.value) == f"No Qt wrapper was importable.\n\n\n{info}"
+
+
+def test_check_qt_available_success(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    monkeypatch.setattr(machinery, "check_wrapper_availability",
+                        lambda current_info: current_info is info)
+    earlyinit.check_qt_available(info)
+
+
+def test_early_init_passes_selection_info(monkeypatch):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    calls = []
+    monkeypatch.setattr(earlyinit, "init_faulthandler",
+                        lambda: calls.append("faulthandler"))
+    monkeypatch.setattr(machinery, "init", lambda args: info)
+    monkeypatch.setattr(earlyinit, "check_qt_available",
+                        lambda current_info: calls.append(current_info))
+    monkeypatch.setattr(earlyinit, "init_log",
+                        lambda args, current_info: calls.append(current_info))
+    for name in ("check_pyqt", "check_libraries", "check_qt_version",
+                 "configure_pyqt", "check_ssl_support", "check_optimize_flag",
+                 "webengine_early_import"):
+        monkeypatch.setattr(earlyinit, name, lambda: None)
+
+    earlyinit.early_init(object())
+    assert calls == ["faulthandler", info, info]
+
+
+def test_check_pyqt_error_has_blank_lines(monkeypatch, capsys):
+    info = machinery.SelectionInfo(wrapper="PyQt5")
+    monkeypatch.setattr(machinery, "INFO", info)
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+    monkeypatch.setattr(sys, "argv", ["qutebrowser"])
+
+    def fail_import(name):
+        raise ImportError(f"missing {name}")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", fail_import)
+    with pytest.raises(SystemExit) as excinfo:
+        earlyinit.check_pyqt()
+    assert excinfo.value.code == 1
+    assert capsys.readouterr().err.endswith("\n\n\n\n")
