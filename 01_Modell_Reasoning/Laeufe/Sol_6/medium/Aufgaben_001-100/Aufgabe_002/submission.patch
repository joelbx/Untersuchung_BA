+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (p ProxyConfig) KubeAddr() (string, error) {
+	if !p.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	var addr utils.NetAddr
+	switch {
+	case len(p.Kube.PublicAddrs) > 0:
+		addr = p.Kube.PublicAddrs[0]
+	case len(p.PublicAddrs) > 0:
+		addr = p.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+
+	// Validate the advertised address before replacing its port. In particular,
+	// a malformed host must not produce a seemingly valid kubeconfig URL.
+	if addr.Path != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", addr.Addr)
+	}
+	parsed, err := url.Parse("https://" + addr.Addr)
+	if err != nil || parsed.Hostname() == "" || parsed.User != nil || parsed.Path != "" || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", addr.Addr)
+	}
+	return (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(parsed.Hostname(), strconv.Itoa(defaults.KubeProxyListenPort)),
+	}).String(), nil
+}
