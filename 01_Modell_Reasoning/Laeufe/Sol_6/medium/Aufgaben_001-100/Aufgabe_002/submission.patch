 func TestConfig(t *testing.T) { check.TestingT(t) }
 
+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name      string
+		config    ProxyConfig
+		want      string
+		wantError bool
+	}{
+		{
+			name:      "disabled",
+			config:    ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}},
+			wantError: true,
+		},
+		{
+			name: "kubernetes address takes precedence",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube: KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4444"}},
+				},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "fallback public address",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://proxy.example.com:3026",
+		},
+		{
+			name: "IPv6 address",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "[::1]:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://[::1]:3026",
+		},
+		{
+			name:      "missing address",
+			config:    ProxyConfig{Kube: KubeProxyConfig{Enabled: true}},
+			wantError: true,
+		},
+		{
+			name: "invalid address",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "bad.example.com:invalid"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			wantError: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.config.KubeAddr()
+			if (err != nil) != tt.wantError {
+				t.Fatalf("KubeAddr() error = %v, want error %v", err, tt.wantError)
+			}
+			if err == nil && got != tt.want {
+				t.Errorf("KubeAddr() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
