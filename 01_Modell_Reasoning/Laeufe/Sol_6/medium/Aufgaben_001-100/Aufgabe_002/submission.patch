+func TestAuthSignKubeconfigProxyAddr(t *testing.T) {
+	tests := []struct {
+		name      string
+		config    *service.Config
+		proxies   []services.Server
+		explicit  string
+		want      string
+		wantError bool
+	}{
+		{
+			name: "local Kubernetes proxy",
+			config: &service.Config{Proxy: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube: service.KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4444"}},
+				},
+			}},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name:    "registered proxy skips invalid address",
+			config:  &service.Config{},
+			proxies: []services.Server{testProxy("bad.example.com:invalid"), testProxy("proxy.example.com:3080")},
+			want:    "https://proxy.example.com:3026",
+		},
+		{
+			name:      "no valid registered proxy",
+			config:    &service.Config{},
+			proxies:   []services.Server{testProxy("bad.example.com:invalid")},
+			wantError: true,
+		},
+		{
+			name:     "explicit proxy",
+			config:   &service.Config{},
+			explicit: "https://custom.example.com:1234",
+			want:     "https://custom.example.com:1234",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cmd := AuthCommand{config: tt.config, outputFormat: identityfile.FormatKubernetes, proxyAddr: tt.explicit}
+			err := cmd.checkProxyAddr(mockClient{proxies: tt.proxies})
+			if (err != nil) != tt.wantError {
+				t.Fatalf("checkProxyAddr() error = %v, want error %v", err, tt.wantError)
+			}
+			if err == nil && cmd.proxyAddr != tt.want {
+				t.Errorf("proxy address = %q, want %q", cmd.proxyAddr, tt.want)
+			}
+		})
+	}
+}
+
+func testProxy(publicAddr string) services.Server {
+	p := &services.ServerV2{}
+	p.SetPublicAddr(publicAddr)
+	return p
 }
 
