@@ -0,0 +1,129 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestCursorOrderAndReclamation(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	first, second := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	read := func(c *Cursor[int], want []int) {
+		t.Helper()
+		out := make([]int, len(want))
+		n, err := c.TryRead(out)
+		if err != nil || n != len(want) || !reflect.DeepEqual(out, want) {
+			t.Fatalf("read = (%v, %v), want %v", out[:n], err, want)
+		}
+	}
+	read(first, []int{1, 2, 3, 4, 5})
+	read(second, []int{1, 2})
+	b.Append(6, 7)
+	read(second, []int{3, 4, 5, 6, 7})
+	read(first, []int{6, 7})
+	if b.count != 0 || len(b.overflow) != 0 {
+		t.Fatal("consumed items were retained")
+	}
+	first.Close()
+	second.Close()
+}
+
+func TestGracePeriodAndFreshBacklog(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3)
+	clock.Advance(30 * time.Second)
+	out := make([]int, 3)
+	if n, err := fast.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("fast read = (%d, %v)", n, err)
+	}
+	// Draining one overflow cycle must reset the next cycle's grace timer.
+	if n, err := slow.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("slow read = (%d, %v)", n, err)
+	}
+	b.Append(4, 5, 6)
+	clock.Advance(31 * time.Second)
+	if n, err := slow.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("fresh backlog expired early: (%d, %v)", n, err)
+	}
+	b.Append(7, 8, 9)
+	clock.Advance(time.Minute)
+	if n, err := slow.TryRead(out); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow read = (%d, %v)", n, err)
+	}
+	if n, err := fast.TryRead(make([]int, 6)); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("fast read = (%d, %v)", n, err)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]int, 1)
+		n, err := c.Read(context.Background(), out)
+		if n != 1 || out[0] != 42 {
+			result <- errors.New("wrong read result")
+			return
+		}
+		result <- err
+	}()
+	b.Append(42)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	b.Close()
+	if err := <-result; !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("read after buffer close: %v", err)
+	}
+	c.Close()
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("read after cursor close: %v", err)
+	}
+}
+
+func TestConcurrentReaders(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 8})
+	const readers, items = 8, 500
+	var wg sync.WaitGroup
+	for i := 0; i < readers; i++ {
+		c := b.NewCursor()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer c.Close()
+			out := make([]int, 17)
+			for expected := 0; expected < items; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, got := range out[:n] {
+					if got != expected {
+						t.Errorf("got %d, want %d", got, expected)
+						return
+					}
+					expected++
+				}
+			}
+		}()
+	}
+	for i := 0; i < items; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
