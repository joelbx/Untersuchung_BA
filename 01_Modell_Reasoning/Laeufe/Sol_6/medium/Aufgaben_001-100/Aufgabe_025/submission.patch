+func TestEnvSubstitutionHook(t *testing.T) {
+	t.Setenv("FLIPT_TEST_CONFIG_REFERENCE", "resolved")
+	t.Setenv("_FLIPT_TEST_CONFIG_REFERENCE", "underscore")
+	t.Setenv("FLIPT_TEST_CONFIG_EMPTY_REFERENCE", "")
+
+	tests := []struct {
+		name  string
+		input interface{}
+		want  interface{}
+	}{
+		{"reference", "${FLIPT_TEST_CONFIG_REFERENCE}", "resolved"},
+		{"leading underscore", "${_FLIPT_TEST_CONFIG_REFERENCE}", "underscore"},
+		{"empty value", "${FLIPT_TEST_CONFIG_EMPTY_REFERENCE}", ""},
+		{"unset", "${FLIPT_TEST_CONFIG_MISSING_REFERENCE_UNLIKELY}", "${FLIPT_TEST_CONFIG_MISSING_REFERENCE_UNLIKELY}"},
+		{"prefix", "prefix${FLIPT_TEST_CONFIG_REFERENCE}", "prefix${FLIPT_TEST_CONFIG_REFERENCE}"},
+		{"suffix", "${FLIPT_TEST_CONFIG_REFERENCE}suffix", "${FLIPT_TEST_CONFIG_REFERENCE}suffix"},
+		{"two references", "${FLIPT_TEST_CONFIG_REFERENCE}${FLIPT_TEST_CONFIG_REFERENCE}", "${FLIPT_TEST_CONFIG_REFERENCE}${FLIPT_TEST_CONFIG_REFERENCE}"},
+		{"starts with digit", "${1INVALID}", "${1INVALID}"},
+		{"invalid character", "${INVALID-NAME}", "${INVALID-NAME}"},
+		{"empty name", "${}", "${}"},
+		{"integer", 42, 42},
+		{"boolean", true, true},
+	}
+
+	hook := envSubstitutionHookFunc()
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(reflect.TypeOf(tt.input).Kind(), reflect.TypeOf(tt.input).Kind(), tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
