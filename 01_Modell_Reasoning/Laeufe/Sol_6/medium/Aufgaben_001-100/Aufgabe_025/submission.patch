+func TestLoadEnvReferences(t *testing.T) {
+	t.Setenv("CONFIG_LOG_LEVEL", "DEBUG")
+	t.Setenv("CONFIG_LOG_ENCODING", "console")
+	t.Setenv("CONFIG_HTTP_PORT", "8081")
+	t.Setenv("CONFIG_GRPC_PORT", "9001")
+	t.Setenv("CONFIG_GRPC_IDLE", "5s")
+	t.Setenv("FLIPT_LOG_ENCODING", "json")
+	t.Setenv("FLIPT_SERVER_GRPC_PORT", "9002")
+
+	path := filepath.Join(t.TempDir(), "config.yml")
+	err := os.WriteFile(path, []byte(`log:
+  level: ${CONFIG_LOG_LEVEL}
+  encoding: ${CONFIG_LOG_ENCODING}
+server:
+  http_port: ${CONFIG_HTTP_PORT}
+  grpc_port: ${CONFIG_GRPC_PORT}
+  grpc_conn_max_idle_time: ${CONFIG_GRPC_IDLE}
+`), 0600)
+	require.NoError(t, err)
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, "DEBUG", result.Config.Log.Level)
+	assert.Equal(t, LogEncodingJSON, result.Config.Log.Encoding)
+	assert.Equal(t, 8081, result.Config.Server.HTTPPort)
+	assert.Equal(t, 9002, result.Config.Server.GRPCPort)
+	assert.Equal(t, 5*time.Second, result.Config.Server.GRPCConnectionMaxIdleTime)
+}
