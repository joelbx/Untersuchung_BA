--- a/test/units/module_utils/basic/test_deprecate_warn.py
+++ b/test/units/module_utils/basic/test_deprecate_warn.py
@@ -49,3 +49,22 @@ def test_deprecate_without_list(am, capfd):
     assert output['deprecations'] == [
         {u'msg': u'Simple deprecation warning', u'version': None},
     ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_with_date_and_exit_deprecations(am, capfd):
+    am.deprecate('dated', date='2030-01-02')
+    with pytest.raises(SystemExit):
+        am.exit_json(deprecations=[{'msg': 'another date', 'date': '2031-03-04'}, 'plain'])
+    output = json.loads(capfd.readouterr()[0])
+    assert output['deprecations'] == [
+        {'msg': 'dated', 'date': '2030-01-02'},
+        {'msg': 'another date', 'date': '2031-03-04'},
+        {'msg': 'plain', 'version': None},
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_rejects_version_and_date(am):
+    with pytest.raises(AssertionError, match='^implementation error -- version and date must not both be set$'):
+        am.deprecate('invalid', version='2.3', date='2030-01-02')
