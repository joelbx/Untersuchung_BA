@@ -0,0 +1,55 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type recordingWriteCloser struct {
+	bytes.Buffer
+	closes   int
+	closeErr error
+}
+
+func (w *recordingWriteCloser) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	first, second := &recordingWriteCloser{}, &recordingWriteCloser{}
+	logger, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent, Code: SessionStartCode}}
+	require.NoError(t, logger.EmitAuditEvent(context.Background(), event))
+	for _, writer := range []*recordingWriteCloser{first, second} {
+		require.Equal(t, 1, bytes.Count(writer.Bytes(), []byte{'\n'}))
+		var got map[string]interface{}
+		require.NoError(t, json.Unmarshal(bytes.TrimSpace(writer.Bytes()), &got))
+		require.Equal(t, SessionStartEvent, got[EventType])
+	}
+	require.NoError(t, logger.Close())
+	require.Equal(t, 2, first.closes)
+	require.Equal(t, 2, second.closes)
+}
+
+func TestMultiLogRejectsNonEmitter(t *testing.T) {
+	logger, err := NewMultiLog(NewWriterLog(&recordingWriteCloser{}))
+	require.Nil(t, logger)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
+
+func TestWriterEmitterCloseAggregatesErrors(t *testing.T) {
+	writer := &recordingWriteCloser{closeErr: errors.New("close failed")}
+	err := NewWriterEmitter(writer).Close()
+	require.Error(t, err)
+	require.Equal(t, 2, writer.closes)
+}
