@@ -0,0 +1,31 @@
+import { HTMLAttributes, MutableRefObject, Ref, forwardRef } from 'react';
+
+interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props: Props, ref: Ref<HTMLDialogElement>) => {
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        const { open, role = 'dialog', ...rest } = props;
+        const fallbackProps = { ...rest, role } as unknown as HTMLAttributes<HTMLDivElement>;
+        const setRef = (element: HTMLDivElement | null) => {
+            if (element) {
+                element.toggleAttribute('open', !!open);
+            }
+
+            if (typeof ref === 'function') {
+                ref(element as unknown as HTMLDialogElement);
+            } else if (ref) {
+                (ref as MutableRefObject<HTMLDialogElement | null>).current = element as unknown as HTMLDialogElement;
+            }
+        };
+
+        return <div {...fallbackProps} ref={setRef} />;
+    }
+
+    return <dialog {...props} ref={ref} />;
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
