+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Return ISBNs grouped by length, with formatting whitespace removed."""
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    for value in [isbns] if isinstance(isbns, str) else isbns or []:
+        if not isinstance(value, str):
+            continue
+        isbn = re.sub(r'[\s-]+', '', value).upper()
+        if re.fullmatch(r'\d{9}[\dX]', isbn):
+            isbn_10.append(isbn)
+        elif re.fullmatch(r'\d{13}', isbn):
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
+
+def get_publisher_and_place(
+    publishers: str | list[str],
+) -> tuple[list[str], list[str]]:
+    """Split IA's optional ``Place : Publisher`` entries into edition fields."""
+    names: list[str] = []
+    places: list[str] = []
+    for value in [publishers] if isinstance(publishers, str) else publishers or []:
+        if not isinstance(value, str):
+            continue
+        value = value.strip()
+        if not value:
+            continue
+        if ':' in value:
+            place, name = (part.strip() for part in value.split(':', 1))
+            if place and name:
+                places.append(place)
+                names.append(name)
+        else:
+            names.append(value)
+    return names, places
+
