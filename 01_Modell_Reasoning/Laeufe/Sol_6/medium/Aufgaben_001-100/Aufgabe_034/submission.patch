+def test_get_ia_record_normalizes_mixed_values() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'isbn': [' 1451654685 ', '978-1-4516-5468-4', 'bad'],
+            'publisher': [' Plain Press ', ' New York : Simon & Schuster ', ' '],
+        }
+    )
+    assert result['isbn_10'] == ['1451654685']
+    assert result['isbn_13'] == ['9781451654684']
+    assert result['publishers'] == ['Plain Press', 'Simon & Schuster']
+    assert result['publish_places'] == ['New York']
+    assert 'isbn' not in result
+    assert 'publisher' not in result
+
+
+def test_get_ia_record_normalizes_string_isbn() -> None:
+    result = code.ia_importapi.get_ia_record({'isbn': ' 9781451654684 '})
+    assert result['isbn_13'] == ['9781451654684']
+    assert 'isbn_10' not in result
+    assert 'isbn' not in result
+
+
+@pytest.mark.parametrize('value', [None, '', [], [' ', ' : ']])
+def test_get_ia_record_omits_empty_normalized_fields(value) -> None:
+    result = code.ia_importapi.get_ia_record({'isbn': value, 'publisher': value})
+    assert not {'isbn', 'isbn_10', 'isbn_13', 'publisher', 'publishers', 'publish_places'} & result.keys()
