+
+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        db = get_db()
+        db.query("""
+            CREATE TABLE booknotes (
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                edition_id integer NOT NULL DEFAULT -1,
+                notes text NOT NULL,
+                PRIMARY KEY (username, work_id, edition_id)
+            )
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source note")
+
+    def teardown_method(self):
+        self.db.delete("booknotes", where="1=1")
+
+    def notes(self):
+        return sorted(
+            tuple(row[key] for key in ("username", "work_id", "edition_id", "notes"))
+            for row in self.db.select("booknotes")
+        )
+
+    def test_conflict_preserves_all_notes(self):
+        self.db.insert("booknotes", username="reader", work_id=2,
+                       edition_id=-1, notes="destination note")
+        self.db.insert("booknotes", username="another", work_id=1,
+                       edition_id=3, notes="other source note")
+        before = self.notes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.notes() == before
+
+    def test_update_without_conflict(self):
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0}
+        assert self.notes() == [("reader", 2, -1, "source note")]
+
+    def test_existing_target_work_preserves_unrelated_notes(self):
+        self.db.insert("booknotes", username="another", work_id=2,
+                       edition_id=3, notes="destination note")
+        before = self.notes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.notes() == before
+
+    def test_dry_run_preserves_notes(self):
+        before = self.notes()
+
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {"rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0}
+        assert self.notes() == before
