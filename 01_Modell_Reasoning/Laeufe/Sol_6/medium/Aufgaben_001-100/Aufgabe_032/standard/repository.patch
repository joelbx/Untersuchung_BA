+    def test_jwrite_replaces_complete_record(self, monkeypatch, tmp_path):
+        path = str(tmp_path / 'job')
+        monkeypatch.setattr(async_wrapper, 'job_path', path)
+        observed = []
+        rename = async_wrapper.os.rename
+
+        def check_rename(source, target):
+            with open(source) as stream:
+                observed.append(json.load(stream))
+            assert source == path + '.tmp'
+            assert target == path
+            rename(source, target)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', check_rename)
+        async_wrapper.jwrite({'ansible_job_id': 'job.1', 'started': 1, 'finished': 0})
+        async_wrapper.jwrite({'ansible_job_id': 'job.1', 'started': 1, 'finished': 1})
+        assert [record['finished'] for record in observed] == [0, 1]
+        with open(path) as stream:
+            assert json.load(stream) == observed[-1]
+
+    def test_fork_failure_is_json(self, monkeypatch, tmp_path, capsys):
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'job', '10', '/tmp/module', '_'])
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', str(tmp_path))
+
+        def fail_fork():
+            raise OSError(11, 'fork unavailable')
+
+        monkeypatch.setattr(async_wrapper.os, 'fork', fail_fork)
+        with pytest.raises(SystemExit) as error:
+            async_wrapper.main()
+        assert error.value.code == 1
+        output = capsys.readouterr().out
+        result = json.loads(output)
+        assert output.count('\n') == 1
+        assert result['failed'] is True
+        assert result['ansible_job_id'].startswith('job.')
+        assert result['finished'] == 1
+
