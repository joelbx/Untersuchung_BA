+func TestReadKubeClusterFlag(t *testing.T) {
+	tests := []struct {
+		name string
+		cli  string
+		env  string
+		want string
+	}{
+		{name: "nothing set"},
+		{name: "environment set", env: "env-kube", want: "env-kube"},
+		{name: "CLI set", cli: "cli-kube", want: "cli-kube"},
+		{name: "CLI takes precedence", cli: "cli-kube", env: "env-kube", want: "cli-kube"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cf := CLIConf{KubernetesCluster: tt.cli}
+			readKubeClusterFlag(&cf, func(name string) string {
+				require.Equal(t, kubeClusterEnvVar, name)
+				return tt.env
+			})
+			require.Equal(t, tt.want, cf.KubernetesCluster)
+		})
+	}
+}
