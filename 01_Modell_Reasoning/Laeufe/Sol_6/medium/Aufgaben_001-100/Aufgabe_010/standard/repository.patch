+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import { mount } from "enzyme";
+
+import dis from "../../../../src/dispatcher/dispatcher";
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import RoomContext, { TimelineRenderingType } from "../../../../src/contexts/RoomContext";
+import { mkEvent } from "../../../test-utils";
+
+jest.mock("../../../../src/components/views/rooms/ReplyTile", () => () => <div />);
+
+describe("ReplyPreview", () => {
+    it("names the sender and offers an accessible cancel action", () => {
+        const event = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:example.org",
+            user: "@alice:example.org",
+            content: { msgtype: "m.text", body: "Hello" },
+            ts: Date.now(),
+        });
+        const dispatch = jest.spyOn(dis, "dispatch").mockImplementation(() => {});
+        const wrapper = mount(
+            <RoomContext.Provider value={{ timelineRenderingType: TimelineRenderingType.Room } as any}>
+                <ReplyPreview replyToEvent={event} permalinkCreator={null} />
+            </RoomContext.Provider>,
+        );
+
+        expect(wrapper.find(".mx_ReplyPreview_header").text()).toContain("Replying to @alice:example.org");
+        expect(wrapper.find(".mx_ReplyPreview_header span.mx_DisambiguatedProfile")).toHaveLength(1);
+        const cancel = wrapper.find("button.mx_ReplyPreview_header_cancel");
+        expect(cancel.prop("aria-label")).toBe("Cancel reply");
+        cancel.simulate("click");
+        expect(dispatch).toHaveBeenCalledWith({
+            action: "reply_to_event",
+            event: null,
+            context: TimelineRenderingType.Room,
+        });
+
+        wrapper.unmount();
+        dispatch.mockRestore();
+    });
+});
