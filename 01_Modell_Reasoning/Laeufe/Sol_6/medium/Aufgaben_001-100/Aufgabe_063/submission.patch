+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	for _, test := range []struct {
+		listen, public, want string
+	}{
+		{"0.0.0.0:8080", "", "proxy.example.com:8080"},
+		{"[::]:8080", "", "proxy.example.com:8080"},
+		{"127.0.0.1:8080", "", "127.0.0.1:8080"},
+		{"0.0.0.0:8080", "kube.example.com:8443", "kube.example.com:8443"},
+	} {
+		tc := &TeleportClient{Config: Config{WebProxyAddr: "old.example.com:3080"}}
+		err := tc.applyProxySettings(ProxySettings{
+			Kube: KubeProxySettings{Enabled: true, ListenAddr: test.listen, PublicAddr: test.public},
+			SSH:  SSHProxySettings{PublicAddr: "proxy.example.com:3080"},
+		})
+		c.Assert(err, check.IsNil)
+		c.Assert(tc.KubeProxyAddr, check.Equals, test.want)
+	}
+}
