 }
 
+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	for _, test := range []struct {
+		name, kubeConfig, wantAddr string
+		wantError                  bool
+	}{
+		{"shorthand", "kube_listen_addr: 0.0.0.0:8080", "0.0.0.0:8080", false},
+		{"default port", "kube_listen_addr: 0.0.0.0", fmt.Sprintf("0.0.0.0:%d", defaults.KubeListenPort), false},
+		{"legacy", "kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8081", "0.0.0.0:8081", false},
+		{"disabled legacy", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no", "0.0.0.0:8080", false},
+		{"conflict", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes", "", true},
+	} {
+		conf, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  " + test.kubeConfig + "\n"))
+		if test.wantError {
+			c.Assert(err, check.ErrorMatches, ".*kube_listen_addr conflicts.*")
+			continue
+		}
+		c.Assert(err, check.IsNil, check.Commentf(test.name))
+		cfg := service.MakeDefaultConfig()
+		c.Assert(ApplyFileConfig(conf, cfg), check.IsNil, check.Commentf(test.name))
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true, check.Commentf(test.name))
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, test.wantAddr, check.Commentf(test.name))
+	}
+}
+
+func (s *ConfigTestSuite) TestStandaloneKubeListenAddress(c *check.C) {
+	conf, err := ReadConfig(bytes.NewBufferString("kubernetes_service:\n  enabled: yes\n  listen_addr: 127.0.0.1:8082\n"))
+	c.Assert(err, check.IsNil)
+	cfg := service.MakeDefaultConfig()
+	c.Assert(ApplyFileConfig(conf, cfg), check.IsNil)
+	c.Assert(cfg.Kube.ListenAddr.Addr, check.Equals, "127.0.0.1:8082")
+}
