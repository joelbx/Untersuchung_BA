@@ -447,18 +455,34 @@ class InvalidLanguage(Exception):
 
 def format_languages(languages: Iterable) -> list[dict[str, str]]:
     """
-    Format language data to match Open Library's expected format.
-    For an input of ["eng", "fre"], return:
-    [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
+    Resolve MARC codes, ISO 639-1 codes, and language names to unique
+    Open Library language keys in input order.
     """
     if not languages:
         return []
 
     formatted_languages = []
+    seen = set()
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        identifier = language.strip().casefold()
+        code = identifier
+        exists = web.ctx.site.get(f'/languages/{code}') is not None
+        if not exists:
+            code = get_marc21_language(identifier)
+            if code is None and len(identifier) == 2:
+                code = convert_iso_to_marc(identifier)
+            if code is None:
+                try:
+                    code = get_abbrev_from_full_lang_name(identifier)
+                except (LanguageNoMatchError, LanguageMultipleMatchError):
+                    raise InvalidLanguage(identifier) from None
+
+        key = f'/languages/{code}'
+        if not exists and web.ctx.site.get(key) is None:
+            raise InvalidLanguage(identifier)
+
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
