 }
 
+func (s *WebSuite) TestU2FLoginWithMultipleDevices(c *C) {
+	cap, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  "https://" + s.server.ClusterName(),
+			Facets: []string{"https://" + s.server.ClusterName()},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.server.Auth().SetAuthPreference(cap), IsNil)
+	s.createUser(c, "bob", "root", "password", "")
+
+	keys := make([]*mocku2f.Key, 2)
+	for i := range keys {
+		keys[i], err = mocku2f.Create()
+		c.Assert(err, IsNil)
+		dev, err := u2f.NewDevice(fmt.Sprintf("key-%d", i), &u2f.Registration{
+			KeyHandle: keys[i].KeyHandle,
+			PubKey:    keys[i].PrivateKey.PublicKey,
+		}, s.clock.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.server.Auth().UpsertMFADevice(context.Background(), "bob", dev), IsNil)
+	}
+
+	clt := s.client()
+	re, err := clt.PostJSON(context.Background(), clt.Endpoint("webapi", "u2f", "signrequest"), client.U2fSignRequestReq{
+		User: "bob",
+		Pass: "password",
+	})
+	c.Assert(err, IsNil)
+	var challenge auth.U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &challenge), IsNil)
+	c.Assert(len(challenge.Challenges), Equals, 2)
+	c.Assert(challenge.AuthenticateChallenge, NotNil)
+	c.Assert(*challenge.AuthenticateChallenge, DeepEquals, challenge.Challenges[0])
+
+	// Respond using the key excluded from the legacy single-device field.
+	var alternate *u2f.AuthenticateChallenge
+	var alternateKey *mocku2f.Key
+	for i := range challenge.Challenges {
+		if challenge.Challenges[i].KeyHandle == challenge.AuthenticateChallenge.KeyHandle {
+			continue
+		}
+		keyHandle, err := base64.RawURLEncoding.DecodeString(challenge.Challenges[i].KeyHandle)
+		c.Assert(err, IsNil)
+		for _, key := range keys {
+			if bytes.Equal(keyHandle, key.KeyHandle) {
+				alternate = &challenge.Challenges[i]
+				alternateKey = key
+			}
+		}
+	}
+	c.Assert(alternate, NotNil)
+	c.Assert(alternateKey, NotNil)
+	response, err := alternateKey.SignResponse(alternate)
+	c.Assert(err, IsNil)
+	_, err = clt.PostJSON(context.Background(), clt.Endpoint("webapi", "u2f", "sessions"), u2fSignResponseReq{
+		User: "bob", U2FSignResponse: *response,
+	})
+	c.Assert(err, IsNil)
+}
