diff --git a/lib/auth/u2f_challenge_test.go b/lib/auth/u2f_challenge_test.go
new file mode 100644
index 0000000..e0bf473
--- /dev/null
+++ b/lib/auth/u2f_challenge_test.go
@@ -0,0 +1,33 @@
+package auth
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/u2f"
+)
+
+func TestU2FAuthenticateChallengeLegacyJSON(t *testing.T) {
+	legacy := u2f.AuthenticateChallenge{
+		Challenge: "challenge",
+		KeyHandle: "key",
+		AppID:     "https://example.com",
+	}
+	data, err := json.Marshal(legacy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wrapped U2FAuthenticateChallenge
+	if err := json.Unmarshal(data, &wrapped); err != nil {
+		t.Fatal(err)
+	}
+	got := wrapped.GetChallenges()
+	if len(got) != 1 || got[0] != legacy {
+		t.Fatalf("legacy challenge decoded as %+v", got)
+	}
+
+	wrapped.Challenges = []u2f.AuthenticateChallenge{legacy, {KeyHandle: "second"}}
+	if got := wrapped.GetChallenges(); len(got) != 2 || got[1].KeyHandle != "second" {
+		t.Fatalf("multi-device challenges decoded as %+v", got)
+	}
+}
