diff --git a/internal/ext/common.go b/internal/ext/common.go
new file mode 100644
index 0000000..b7d9128
--- /dev/null
+++ b/internal/ext/common.go
@@ -0,0 +1,48 @@
+package ext
+
+// Document is the YAML representation of a collection of flags and segments.
+type Document struct {
+	Flags    []*Flag    `yaml:"flags,omitempty"`
+	Segments []*Segment `yaml:"segments,omitempty"`
+}
+
+type Flag struct {
+	Key         string     `yaml:"key,omitempty"`
+	Name        string     `yaml:"name,omitempty"`
+	Description string     `yaml:"description,omitempty"`
+	Enabled     bool       `yaml:"enabled"`
+	Variants    []*Variant `yaml:"variants,omitempty"`
+	Rules       []*Rule    `yaml:"rules,omitempty"`
+}
+
+type Variant struct {
+	Key         string      `yaml:"key,omitempty"`
+	Name        string      `yaml:"name,omitempty"`
+	Description string      `yaml:"description,omitempty"`
+	Attachment  interface{} `yaml:"attachment,omitempty"`
+}
+
+type Rule struct {
+	SegmentKey    string          `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type Distribution struct {
+	VariantKey string  `yaml:"variant,omitempty"`
+	Rollout    float32 `yaml:"rollout,omitempty"`
+}
+
+type Segment struct {
+	Key         string        `yaml:"key,omitempty"`
+	Name        string        `yaml:"name,omitempty"`
+	Description string        `yaml:"description,omitempty"`
+	Constraints []*Constraint `yaml:"constraints,omitempty"`
+}
+
+type Constraint struct {
+	Type     string `yaml:"type,omitempty"`
+	Property string `yaml:"property,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+	Value    string `yaml:"value,omitempty"`
+}
diff --git a/internal/ext/exporter.go b/internal/ext/exporter.go
new file mode 100644
index 0000000..ae0ab5f
--- /dev/null
+++ b/internal/ext/exporter.go
@@ -0,0 +1,99 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type lister interface {
+	ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error)
+	ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error)
+	ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error)
+}
+
+const defaultBatchSize uint64 = 25
+
+type Exporter struct {
+	store     lister
+	batchSize uint64
+}
+
+func NewExporter(store lister) *Exporter {
+	return &Exporter{store: store, batchSize: defaultBatchSize}
+}
+
+func (e *Exporter) Export(ctx context.Context, w io.Writer) error {
+	doc := &Document{}
+	batchSize := e.batchSize
+	if batchSize == 0 {
+		batchSize = defaultBatchSize
+	}
+	for offset := uint64(0); ; offset += batchSize {
+		flags, err := e.store.ListFlags(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting flags: %w", err)
+		}
+		for _, f := range flags {
+			flag := &Flag{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}
+			variantKeys := make(map[string]string, len(f.Variants))
+			for _, v := range f.Variants {
+				variant := &Variant{Key: v.Key, Name: v.Name, Description: v.Description}
+				if v.Attachment != "" {
+					if err := json.Unmarshal([]byte(v.Attachment), &variant.Attachment); err != nil {
+						return fmt.Errorf("decoding attachment for variant %q: %w", v.Key, err)
+					}
+				}
+				flag.Variants = append(flag.Variants, variant)
+				variantKeys[v.Id] = v.Key
+			}
+			// Rules are listed independently because they are not embedded in flags.
+			for ruleOffset := uint64(0); ; ruleOffset += batchSize {
+				rules, err := e.store.ListRules(ctx, f.Key, storage.WithOffset(ruleOffset), storage.WithLimit(batchSize))
+				if err != nil {
+					return fmt.Errorf("getting rules for flag %q: %w", f.Key, err)
+				}
+				for _, r := range rules {
+					rule := &Rule{SegmentKey: r.SegmentKey, Rank: uint(r.Rank)}
+					for _, d := range r.Distributions {
+						rule.Distributions = append(rule.Distributions, &Distribution{VariantKey: variantKeys[d.VariantId], Rollout: d.Rollout})
+					}
+					flag.Rules = append(flag.Rules, rule)
+				}
+				if uint64(len(rules)) < batchSize {
+					break
+				}
+			}
+			doc.Flags = append(doc.Flags, flag)
+		}
+		if uint64(len(flags)) < batchSize {
+			break
+		}
+	}
+	for offset := uint64(0); ; offset += batchSize {
+		segments, err := e.store.ListSegments(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting segments: %w", err)
+		}
+		for _, s := range segments {
+			segment := &Segment{Key: s.Key, Name: s.Name, Description: s.Description}
+			for _, c := range s.Constraints {
+				segment.Constraints = append(segment.Constraints, &Constraint{Type: c.Type.String(), Property: c.Property, Operator: c.Operator, Value: c.Value})
+			}
+			doc.Segments = append(doc.Segments, segment)
+		}
+		if uint64(len(segments)) < batchSize {
+			break
+		}
+	}
+	enc := yaml.NewEncoder(w)
+	if err := enc.Encode(doc); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	return enc.Close()
+}
diff --git a/internal/ext/ext_test.go b/internal/ext/ext_test.go
new file mode 100644
index 0000000..ed756df
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,172 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type listStore struct {
+	flags    []*flipt.Flag
+	rules    []*flipt.Rule
+	segments []*flipt.Segment
+}
+
+func (s *listStore) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	p := storage.QueryParams{}
+	for _, o := range opts {
+		o(&p)
+	}
+	if p.Offset >= uint64(len(s.flags)) {
+		return nil, nil
+	}
+	end := p.Offset + p.Limit
+	if end > uint64(len(s.flags)) {
+		end = uint64(len(s.flags))
+	}
+	return s.flags[p.Offset:end], nil
+}
+func (s *listStore) ListRules(_ context.Context, _ string, opts ...storage.QueryOption) ([]*flipt.Rule, error) {
+	p := storage.QueryParams{}
+	for _, o := range opts {
+		o(&p)
+	}
+	if p.Offset >= uint64(len(s.rules)) {
+		return nil, nil
+	}
+	end := p.Offset + p.Limit
+	if end > uint64(len(s.rules)) {
+		end = uint64(len(s.rules))
+	}
+	return s.rules[p.Offset:end], nil
+}
+func (s *listStore) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	p := storage.QueryParams{}
+	for _, o := range opts {
+		o(&p)
+	}
+	if p.Offset >= uint64(len(s.segments)) {
+		return nil, nil
+	}
+	end := p.Offset + p.Limit
+	if end > uint64(len(s.segments)) {
+		end = uint64(len(s.segments))
+	}
+	return s.segments[p.Offset:end], nil
+}
+
+type createStore struct {
+	flags         []*flipt.CreateFlagRequest
+	variants      []*flipt.CreateVariantRequest
+	segments      []*flipt.CreateSegmentRequest
+	constraints   []*flipt.CreateConstraintRequest
+	rules         []*flipt.CreateRuleRequest
+	distributions []*flipt.CreateDistributionRequest
+}
+
+func (s *createStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	s.flags = append(s.flags, r)
+	return &flipt.Flag{Key: r.Key}, nil
+}
+func (s *createStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.variants = append(s.variants, r)
+	return &flipt.Variant{Id: "variant-id", Key: r.Key}, nil
+}
+func (s *createStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s.segments = append(s.segments, r)
+	return &flipt.Segment{Key: r.Key}, nil
+}
+func (s *createStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.constraints = append(s.constraints, r)
+	return &flipt.Constraint{}, nil
+}
+func (s *createStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	s.rules = append(s.rules, r)
+	return &flipt.Rule{Id: "rule-id"}, nil
+}
+func (s *createStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.distributions = append(s.distributions, r)
+	return &flipt.Distribution{}, nil
+}
+
+func TestExportImportAttachmentsAndHierarchy(t *testing.T) {
+	attachment := `{"nested":{"items":[true,4,null,{"label":"hello"}]},"empty":[],"number":3.5}`
+	listed := &listStore{
+		flags:    []*flipt.Flag{{Key: "feature", Name: "Feature", Enabled: true, Variants: []*flipt.Variant{{Id: "id-1", Key: "blue", Attachment: attachment}, {Id: "id-2", Key: "plain"}}}},
+		rules:    []*flipt.Rule{{SegmentKey: "users", Rank: 1, Distributions: []*flipt.Distribution{{VariantId: "id-1", Rollout: 50}}}},
+		segments: []*flipt.Segment{{Key: "users", Constraints: []*flipt.Constraint{{Type: flipt.ComparisonType(1), Property: "region", Operator: "eq", Value: "us"}}}},
+	}
+	var output bytes.Buffer
+	if err := NewExporter(listed).Export(context.Background(), &output); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(output.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := doc.Flags[0].Variants[0].Attachment.(map[interface{}]interface{}); !ok {
+		t.Fatalf("attachment is not a YAML map: %s", output.String())
+	}
+	if strings.Contains(output.String(), "attachment: '{") {
+		t.Fatalf("attachment emitted as JSON string: %s", output.String())
+	}
+	if len(doc.Flags[0].Rules) != 1 || len(doc.Segments) != 1 || len(doc.Segments[0].Constraints) != 1 {
+		t.Fatalf("hierarchy missing: %s", output.String())
+	}
+	created := &createStore{}
+	if err := NewImporter(created).Import(context.Background(), bytes.NewReader(output.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	if len(created.flags) != 1 || len(created.variants) != 2 || len(created.segments) != 1 || len(created.constraints) != 1 || len(created.rules) != 1 || len(created.distributions) != 1 {
+		t.Fatalf("entities missing: %+v", created)
+	}
+	var got, want interface{}
+	if err := json.Unmarshal([]byte(created.variants[0].Attachment), &got); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal([]byte(attachment), &want); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("attachment changed: %#v != %#v", got, want)
+	}
+	if created.variants[1].Attachment != "" {
+		t.Fatalf("missing attachment became %q", created.variants[1].Attachment)
+	}
+	if created.distributions[0].VariantId != "variant-id" || created.distributions[0].RuleId != "rule-id" {
+		t.Fatal("distribution references lost")
+	}
+}
+
+func TestImportYAMLAttachment(t *testing.T) {
+	input := `flags:
+- key: test
+  enabled: false
+  variants:
+  - key: nested
+    attachment:
+      group:
+        - 1
+        - null
+        - active: true
+  - key: absent
+segments: []
+`
+	created := &createStore{}
+	if err := NewImporter(created).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if created.variants[0].Attachment != `{"group":[1,null,{"active":true}]}` {
+		t.Fatalf("unexpected JSON: %s", created.variants[0].Attachment)
+	}
+	if created.variants[1].Attachment != "" {
+		t.Fatal("absent attachment should be empty")
+	}
+}
