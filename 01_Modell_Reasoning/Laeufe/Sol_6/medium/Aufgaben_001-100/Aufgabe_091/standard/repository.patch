diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..455a88b
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,50 @@
+package evaluation
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	ferrors "go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/storage"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestMatchesStringList(t *testing.T) {
+	tests := []struct {
+		operator, list, value string
+		want                  bool
+	}{
+		{flipt.OpIsOneOf, `["a","b"]`, "b", true},
+		{flipt.OpIsOneOf, `["a","b"]`, "c", false},
+		{flipt.OpIsNotOneOf, `["a","b"]`, "c", true},
+		{flipt.OpIsNotOneOf, `["a","b"]`, "a", false},
+		{flipt.OpIsOneOf, `[""]`, "", true},
+		{flipt.OpIsNotOneOf, `[]`, "", true},
+		{flipt.OpIsNotOneOf, `[1]`, "a", false},
+		{flipt.OpIsNotOneOf, `broken`, "a", false},
+	}
+	for _, tt := range tests {
+		assert.Equal(t, tt.want, matchesString(storage.EvaluationConstraint{Operator: tt.operator, Value: tt.list}, tt.value))
+	}
+}
+
+func TestMatchesNumberList(t *testing.T) {
+	tests := []struct {
+		operator, list, value string
+		want                  bool
+		invalid               bool
+	}{
+		{flipt.OpIsOneOf, `[1,2.5]`, "2.5", true, false},
+		{flipt.OpIsOneOf, `[1,2.5]`, "3", false, false},
+		{flipt.OpIsNotOneOf, `[1,2.5]`, "3", true, false},
+		{flipt.OpIsNotOneOf, `[1,2.5]`, "1", false, false},
+		{flipt.OpIsNotOneOf, `[1,"2"]`, "3", false, true},
+		{flipt.OpIsOneOf, `broken`, "", false, true},
+		{flipt.OpIsOneOf, `null`, "1", false, true},
+	}
+	for _, tt := range tests {
+		got, err := matchesNumber(storage.EvaluationConstraint{Property: "foo", Operator: tt.operator, Value: tt.list}, tt.value)
+		assert.Equal(t, tt.want, got)
+		assert.Equal(t, tt.invalid, ferrors.AsMatch[ferrors.ErrInvalid](err))
+	}
+}
