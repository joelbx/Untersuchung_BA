+++ b/rpc/flipt/list_operators_test.go
@@ -0,0 +1,45 @@
+package flipt
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"go.flipt.io/flipt/errors"
+)
+
+func TestValidateListOperators(t *testing.T) {
+	hundred := "[" + strings.TrimSuffix(strings.Repeat(`"x",`, MAX_JSON_ARRAY_ITEMS), ",") + "]"
+	hundredOne := "[" + strings.TrimSuffix(strings.Repeat(`"x",`, MAX_JSON_ARRAY_ITEMS+1), ",") + "]"
+	hundredOneNumbers := "[" + strings.TrimSuffix(strings.Repeat("1,", MAX_JSON_ARRAY_ITEMS+1), ",") + "]"
+	tests := []struct {
+		name  string
+		typ   ComparisonType
+		value string
+		want  error
+	}{
+		{"string list", ComparisonType_STRING_COMPARISON_TYPE, `["a","b"]`, nil},
+		{"number list", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,2.5]`, nil},
+		{"empty list", ComparisonType_STRING_COMPARISON_TYPE, `[]`, nil},
+		{"hundred items", ComparisonType_STRING_COMPARISON_TYPE, hundred, nil},
+		{"too many", ComparisonType_STRING_COMPARISON_TYPE, hundredOne, errors.ErrInvalidf("too many values provided for property %q of type string (maximum 100)", "foo")},
+		{"too many numbers", ComparisonType_NUMBER_COMPARISON_TYPE, hundredOneNumbers, errors.ErrInvalidf("too many values provided for property %q of type number (maximum 100)", "foo")},
+		{"empty value", ComparisonType_STRING_COMPARISON_TYPE, ``, errors.ErrInvalidf("invalid value provided for property %q of type string", "foo")},
+		{"wrong string element", ComparisonType_STRING_COMPARISON_TYPE, `["a",1]`, errors.ErrInvalidf("invalid value provided for property %q of type string", "foo")},
+		{"wrong number element", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,"2"]`, errors.ErrInvalidf("invalid value provided for property %q of type number", "foo")},
+		{"invalid json", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,`, errors.ErrInvalidf("invalid value provided for property %q of type number", "foo")},
+		{"null is not array", ComparisonType_STRING_COMPARISON_TYPE, `null`, errors.ErrInvalidf("invalid value provided for property %q of type string", "foo")},
+		{"object is not array", ComparisonType_NUMBER_COMPARISON_TYPE, `{}`, errors.ErrInvalidf("invalid value provided for property %q of type number", "foo")},
+	}
+	for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+		for _, tt := range tests {
+			t.Run(fmt.Sprintf("%s/%s", operator, tt.name), func(t *testing.T) {
+				create := &CreateConstraintRequest{SegmentKey: "segment", Property: "foo", Type: tt.typ, Operator: operator, Value: tt.value}
+				update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "foo", Type: tt.typ, Operator: operator, Value: tt.value}
+				assert.Equal(t, tt.want, create.Validate())
+				assert.Equal(t, tt.want, update.Validate())
+			})
+		}
+	}
+}
