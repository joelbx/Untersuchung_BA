+	result, err := ParserV2{}.Parse([]byte(`{
+		"ArtifactName":"example/image",
+		"ArtifactType":"container_image",
+		"Metadata":{"OS":{"Family":"debian"}},
+		"Results":[{"Target":"example/image (debian)","Type":"debian"}]
+	}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.ServerName != "example/image:latest" || result.Release != "" || result.Family != "debian" || result.Optional != nil {
+		t.Fatalf("unexpected metadata: server=%q family=%q release=%q optional=%v", result.ServerName, result.Family, result.Release, result.Optional)
+	}
