diff --git a/detector/pkg_gate_test.go b/detector/pkg_gate_test.go
new file mode 100644
index 0000000..1c4e6a7
--- /dev/null
+++ b/detector/pkg_gate_test.go
@@ -0,0 +1,59 @@
+//go:build !scanner
+// +build !scanner
+
+package detector
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestIsPkgCvesDetactable(t *testing.T) {
+	base := models.ScanResult{
+		Family: "debian", Release: "12",
+		Packages: models.Packages{"pkg": {Name: "pkg", Version: "1"}},
+	}
+	tests := []struct {
+		name string
+		edit func(*models.ScanResult)
+		want bool
+	}{
+		{"supported", func(*models.ScanResult) {}, true},
+		{"missing family", func(r *models.ScanResult) { r.Family = "" }, false},
+		{"missing version", func(r *models.ScanResult) { r.Release = "" }, false},
+		{"no packages", func(r *models.ScanResult) { r.Packages = nil }, false},
+		{"trivy", func(r *models.ScanResult) { r.ScannedBy = "trivy" }, false},
+		{"freebsd", func(r *models.ScanResult) { r.Family = constant.FreeBSD }, false},
+		{"raspbian", func(r *models.ScanResult) { r.Family = constant.Raspbian }, false},
+		{"pseudo", func(r *models.ScanResult) { r.Family = constant.ServerTypePseudo }, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := base
+			tt.edit(&r)
+			if got := isPkgCvesDetactable(&r); got != tt.want {
+				t.Fatalf("isPkgCvesDetactable() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestReuseScannedCvesUsesScannedBy(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		r    models.ScanResult
+		want bool
+	}{
+		{"trivy", models.ScanResult{ScannedBy: "trivy"}, true},
+		{"legacy optional", models.ScanResult{Optional: map[string]interface{}{"trivy-target": "old"}}, false},
+		{"other", models.ScanResult{ScannedBy: "other"}, false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := reuseScannedCves(&tt.r); got != tt.want {
+				t.Fatalf("reuseScannedCves() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
