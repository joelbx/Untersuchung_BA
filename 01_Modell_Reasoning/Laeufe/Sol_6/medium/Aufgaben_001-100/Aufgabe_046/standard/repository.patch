+class LegacyModuleUtilLocator(ModuleUtilLocatorBase):
+    prefix_length = 2
+
+    def __init__(self, fq_name_parts, is_ambiguous=False, mu_paths=None, child_is_redirected=False):
+        self.mu_paths = mu_paths if mu_paths is not None else [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)] + [_MODULE_UTILS_PATH]
+        super(LegacyModuleUtilLocator, self).__init__(fq_name_parts, is_ambiguous, child_is_redirected)
+
+    def _routing_collection(self, candidate):
+        return 'ansible.builtin'
+
+    def _local(self, candidate):
+        relative = candidate[2:]
+        if not relative:
+            return False
+        try:
+            info = ModuleInfo(relative[-1], [os.path.join(p, *relative[:-1]) for p in self.mu_paths])
+        except (ImportError, AttributeError, TypeError):
+            return False
+        if not info.py_src and not info.pkg_dir:
+            raise AnsibleError('Could not find python source for imported module support code for {0}'.format('.'.join(candidate)))
+        self.is_package = info.pkg_dir
+        self.source_code = info.get_source()
+        self.path = info.path
+        return True
