+func TestUbuntuAPIReportFields(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Nvd:       {{Type: Nvd, Summary: "NVD summary"}},
+		Ubuntu:    {{Type: Ubuntu, Summary: "Ubuntu summary", Cvss3Severity: "NEGLIGIBLE"}},
+		UbuntuAPI: {{Type: UbuntuAPI, Summary: "Ubuntu API summary", Cvss3Score: 7.5, Cvss3Severity: "HIGH"}},
+	}}
+	if want := []CveContentType{Nvd, Ubuntu, UbuntuAPI}; !reflect.DeepEqual(contentTypes(v.Titles("en", "ubuntu")), want) {
+		t.Errorf("title order: got %v, want %v", contentTypes(v.Titles("en", "ubuntu")), want)
+	}
+	if want := []CveContentType{Ubuntu, UbuntuAPI, Nvd}; !reflect.DeepEqual(contentTypes(v.Summaries("en", "ubuntu")), want) {
+		t.Errorf("summary order: got %v, want %v", contentTypes(v.Summaries("en", "ubuntu")), want)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 || scores[0].Type != UbuntuAPI || scores[0].Value.Score != 7.5 || scores[1].Type != Ubuntu || scores[1].Value.Score != 3.9 {
+		t.Errorf("CVSS scores: %v", scores)
+	}
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("NEGLIGIBLE range: %s", got)
+	}
+	v.CveContents[UbuntuAPI] = []CveContent{{Type: UbuntuAPI, Cvss3Severity: "NEGLIGIBLE"}}
+	scores = v.Cvss3Scores()
+	if len(scores) != 2 || scores[1].Type != UbuntuAPI || scores[1].Value.Score != 3.9 || !scores[1].Value.CalculatedBySeverity {
+		t.Errorf("severity-only Ubuntu API score: %v", scores)
+	}
+}
