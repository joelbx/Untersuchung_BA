@@ -0,0 +1,68 @@
+package oidc
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestStateCookieDomainAndPath(t *testing.T) {
+	for _, tc := range []struct {
+		domain     string
+		wantDomain string
+	}{
+		{"localhost", ""},
+		{"auth.example.com", "auth.example.com"},
+	} {
+		t.Run(tc.domain, func(t *testing.T) {
+			middleware := NewHTTPMiddleware(config.AuthenticationSession{
+				Domain: tc.domain, StateLifetime: time.Minute,
+			})
+			response := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			middleware.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(response, request)
+
+			cookies := response.Result().Cookies()
+			if len(cookies) != 1 {
+				t.Fatalf("got %d cookies, want 1", len(cookies))
+			}
+			cookie := cookies[0]
+			if cookie.Name != stateCookieKey || cookie.Domain != tc.wantDomain || cookie.Path != "/auth/v1/method/oidc/google/callback" {
+				t.Fatalf("unexpected state cookie: %#v", cookie)
+			}
+			if tc.domain == "localhost" && strings.Contains(response.Header().Get("Set-Cookie"), "Domain=") {
+				t.Fatalf("localhost cookie has Domain attribute: %s", response.Header().Get("Set-Cookie"))
+			}
+		})
+	}
+}
+
+func TestCallbackURL(t *testing.T) {
+	for _, tc := range []struct{ host, want string }{
+		{"http://localhost:8080", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"http://localhost:8080/", "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{"https://auth.example.com:8443/", "https://auth.example.com:8443/auth/v1/method/oidc/google/callback"},
+		{"https://auth.example.com//", "https://auth.example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		if got := callbackURL(tc.host, "google"); got != tc.want {
+			t.Errorf("callbackURL(%q) = %q, want %q", tc.host, got, tc.want)
+		}
+	}
+}
+
+func TestTokenCookieOmitsLocalhostDomain(t *testing.T) {
+	middleware := NewHTTPMiddleware(config.AuthenticationSession{Domain: "localhost", TokenLifetime: time.Hour})
+	response := httptest.NewRecorder()
+	callback := &auth.CallbackResponse{ClientToken: "token"}
+	if err := middleware.ForwardResponseOption(nil, response, callback); err != nil {
+		t.Fatal(err)
+	}
+	if got := response.Header().Get("Set-Cookie"); strings.Contains(got, "Domain=") {
+		t.Fatalf("localhost cookie has Domain attribute: %s", got)
+	}
+}
