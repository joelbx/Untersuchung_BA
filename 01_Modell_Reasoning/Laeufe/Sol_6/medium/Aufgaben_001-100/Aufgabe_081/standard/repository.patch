@@ -0,0 +1,35 @@
+package config
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationConfigValidateSessionDomain(t *testing.T) {
+	for _, tc := range []struct {
+		name, domain, want string
+	}{
+		{"scheme and port", "http://localhost:8080", "localhost"},
+		{"https and port", "https://auth.example.com:8443", "auth.example.com"},
+		{"hostname and port", "auth.example.com:8080", "auth.example.com"},
+		{"hostname", "auth.example.com", "auth.example.com"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tc.domain},
+				Methods: AuthenticationMethods{
+					OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+				},
+			}
+			require.NoError(t, cfg.validate())
+			require.Equal(t, tc.want, cfg.Session.Domain)
+		})
+	}
+
+	cfg := AuthenticationConfig{Session: AuthenticationSession{Domain: "http://bad host"}}
+	err := cfg.validate()
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "authentication.session.domain"))
+}
