+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-id', display_name: 'Old name', isVerified: false };
+
+    it('uses the device ID when the display name is undefined and limits input to 100 characters', () => {
+        const saveDeviceName = jest.fn();
+        const unnamedDevice = { device_id: 'device-id', isVerified: false };
+        const { getByTestId } = render(
+            <DeviceDetailHeading device={unnamedDevice} saveDeviceName={saveDeviceName} />,
+        );
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('device-id');
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        expect(getByTestId('device-detail-heading-input').getAttribute('maxlength')).toBe('100');
+    });
+
+    it('saves a changed name and returns to the read view', async () => {
+        let resolveSave: () => void;
+        const saveDeviceName = jest.fn().mockImplementation(() => new Promise<void>(resolve => {
+            resolveSave = resolve;
+        }));
+        const { getByTestId, queryByTestId } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        expect(getByTestId('device-detail-heading-edit').textContent).toContain('Session names may be visible');
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', 'Work Laptop');
+        expect(getByTestId('device-detail-heading-edit').querySelector('.mx_Spinner')).not.toBeNull();
+        resolveSave();
+        await waitFor(() => expect(queryByTestId('device-detail-heading-edit')).toBeNull());
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Work Laptop');
+    });
+
+    it('accepts an empty name and skips an unchanged name', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-read')).toBeTruthy());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', '');
+    });
+
+    it('cancels without saving and shows a failed save message', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('Network error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Changed' } });
+        fireEvent.click(getByTestId('device-detail-heading-cancel'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Old name');
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Changed' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-error').textContent)
+            .toBe('Failed to set display name.'));
+    });
+});
