+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [editing, setEditing] = useState(false);
+    const [name, setName] = useState('');
+    const [saving, setSaving] = useState(false);
+    const [error, setError] = useState<string>();
+    // Keep the newly saved name visible until the parent receives its updated device.
+    const [savedName, setSavedName] = useState<{ deviceId: string, name: string, previous: string | undefined }>();
+    const displayName = savedName?.deviceId === device.device_id && savedName.previous === device.display_name
+        ? savedName.name : device.display_name;
+
+    const startEditing = () => {
+        setName(displayName ?? '');
+        setError(undefined);
+        setEditing(true);
+    };
+
+    const cancel = () => {
+        setError(undefined);
+        setEditing(false);
+    };
+
+    const save = async (event: React.FormEvent) => {
+        event.preventDefault();
+        if (saving) return;
+        if (name === displayName) {
+            setEditing(false);
+            return;
+        }
+        setSaving(true);
+        setError(undefined);
+        try {
+            await saveDeviceName(device.device_id, name);
+            setSavedName({ deviceId: device.device_id, name, previous: device.display_name });
+            setEditing(false);
+        } catch {
+            setError(_t('Failed to set display name.'));
+        } finally {
+            setSaving(false);
+        }
+    };
+
+    if (editing) {
+        return <form onSubmit={save} data-testid='device-detail-heading-edit'>
+            <label htmlFor={`device-name-${device.device_id}`}>{ _t('Session name') }</label>
+            <input
+                id={`device-name-${device.device_id}`}
+                data-testid='device-detail-heading-input'
+                type='text'
+                maxLength={100}
+                value={name}
+                onChange={event => setName(event.target.value)}
+                disabled={saving}
+                autoFocus
+            />
+            <p>{ _t('Session names may be visible to people you communicate with.') }</p>
+            { error && <p role='alert' data-testid='device-detail-heading-error'>{ error }</p> }
+            <button type='submit' disabled={saving} data-testid='device-detail-heading-save'>
+                { _t('Save') } { saving && <Spinner w={16} h={16} /> }
+            </button>
+            <button type='button' onClick={cancel} disabled={saving} data-testid='device-detail-heading-cancel'>
+                { _t('Cancel') }
+            </button>
+        </form>;
+    }
+
+    return <div data-testid='device-detail-heading-read'>
+        <Heading size='h3'>{ displayName ?? device.device_id }</Heading>
+        <AccessibleButton kind='link_inline' onClick={startEditing} data-testid='device-detail-heading-rename'>
+            { _t('Rename') }
+        </AccessibleButton>
+    </div>;
+};
