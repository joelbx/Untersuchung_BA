+    def merge_remote_ids(
+        self, incoming_ids: dict[str, str]
+    ) -> tuple[dict[str, str], int]:
+        """Return the combined identifiers and number of identifiers already shared.
+
+        The author is left untouched when a conflict is found.
+        """
+        existing = dict(self.get('remote_ids') or {})
+        matching = 0
+        for identifier, value in incoming_ids.items():
+            if identifier in existing:
+                if existing[identifier] != value:
+                    raise AuthorRemoteIdConflictError(
+                        f"Conflicting {identifier} remote ID for {self.key}: "
+                        f"{existing[identifier]!r} != {value!r}"
+                    )
+                matching += 1
+            else:
+                existing[identifier] = value
+        return existing, matching
