--- a/lib/utils/prompt/stdin.go
+++ b/lib/utils/prompt/stdin.go
@@ -52,3 +52,13 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so an active password prompt can
+// restore the terminal before the program exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		_ = closer.Close()
+	}
+}
diff --git a/lib/utils/prompt/stdin_test.go b/lib/utils/prompt/stdin_test.go
new file mode 100644
index 0000000..8115b3c
--- /dev/null
+++ b/lib/utils/prompt/stdin_test.go
@@ -0,0 +1,29 @@
+package prompt
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/term"
+)
+
+func TestNotifyExitRestoresStdin(t *testing.T) {
+	stdinMU.Lock()
+	previous := stdin
+	stdinMU.Unlock()
+	t.Cleanup(func() { SetStdin(previous) })
+
+	cr := NewContextReader(strings.NewReader(""))
+	cr.term = &fakeTerm{}
+	cr.fd = 0
+	cr.mu.Lock()
+	cr.state = readerStatePassword
+	cr.previousTermState = &term.State{}
+	cr.mu.Unlock()
+	SetStdin(cr)
+
+	NotifyExit()
+	require.True(t, cr.term.(*fakeTerm).restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+}
