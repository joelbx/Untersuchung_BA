+func TestContextReaderPasswordDeadline(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	cr := NewContextReader(pr)
+	cr.term = &fakeTerm{reader: pr}
+	cr.fd = 0
+	defer cr.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+	defer cancel()
+	value, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, value)
+
+	cr.mu.Lock()
+	state := cr.state
+	previousTermState := cr.previousTermState
+	restored := cr.term.(*fakeTerm).restoreCalled
+	cr.mu.Unlock()
+	require.Equal(t, readerStateClean, state)
+	require.Nil(t, previousTermState)
+	require.True(t, restored)
+
+	go func() { _, _ = pw.Write([]byte("next")) }()
+	value, err = cr.ReadContext(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, "next", string(value))
+}
+
+func TestContextReaderCloseRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	cr := NewContextReader(pr)
+	cr.fd = 0
+	cr.term = &fakeTerm{reader: pr}
+	cr.mu.Lock()
+	cr.state = readerStatePassword
+	cr.previousTermState = &term.State{}
+	cr.mu.Unlock()
+
+	require.NoError(t, cr.Close())
+	require.True(t, cr.term.(*fakeTerm).restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+	require.NoError(t, cr.Close())
+}
+
+func TestContextReaderCloseReturnsRestoreError(t *testing.T) {
+	cr := NewContextReader(&io.LimitedReader{R: os.Stdin, N: 0})
+	cr.fd = 0
+	want := errors.New("restore failed")
+	cr.term = &fakeTerm{restoreErr: want}
+	cr.mu.Lock()
+	cr.state = readerStatePassword
+	cr.previousTermState = &term.State{}
+	cr.mu.Unlock()
+
+	require.ErrorIs(t, cr.Close(), want)
+	require.Equal(t, readerStateClosed, cr.state)
+}
