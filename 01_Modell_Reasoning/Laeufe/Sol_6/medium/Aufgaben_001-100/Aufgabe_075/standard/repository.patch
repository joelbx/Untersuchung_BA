diff --git a/tests/mock_user_props_repo.go b/tests/mock_user_props_repo.go
new file mode 100644
index 0000000..dc1a8b6
--- /dev/null
+++ b/tests/mock_user_props_repo.go
@@ -0,0 +1,46 @@
+package tests
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type MockedUserPropsRepo struct {
+	data map[string]map[string]string
+}
+
+type scopedMockUserPropsRepo struct {
+	*MockedUserPropsRepo
+	ctx context.Context
+}
+
+func (r *scopedMockUserPropsRepo) userID() string {
+	u, _ := request.UserFrom(r.ctx)
+	return u.ID
+}
+
+func (r *scopedMockUserPropsRepo) Put(key, value string) error {
+	id := r.userID()
+	if r.data[id] == nil {
+		r.data[id] = make(map[string]string)
+	}
+	r.data[id][key] = value
+	return nil
+}
+
+func (r *scopedMockUserPropsRepo) Get(key string) (string, error) {
+	if value, ok := r.data[r.userID()][key]; ok {
+		return value, nil
+	}
+	return "", model.ErrNotFound
+}
+
+func (r *scopedMockUserPropsRepo) Delete(key string) error {
+	if _, ok := r.data[r.userID()][key]; !ok {
+		return model.ErrNotFound
+	}
+	delete(r.data[r.userID()], key)
+	return nil
+}
