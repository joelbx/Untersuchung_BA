new file mode 100644
index 0000000..cf7b348
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,40 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r *userPropsRepository) Put(key string, value string) error {
+	where := Eq{"user_id": userId(r.ctx), "key": key}
+	count, err := r.executeSQL(Update(r.tableName).Set("value", value).Where(where))
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	_, err = r.executeSQL(Insert(r.tableName).Columns("user_id", "key", "value").Values(userId(r.ctx), key, value))
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	var row struct{ Value string }
+	err := r.queryOne(Select("value").From(r.tableName).Where(Eq{"user_id": userId(r.ctx), "key": key}), &row)
+	return row.Value, err
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	return r.delete(Eq{"user_id": userId(r.ctx), "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..8d45eed
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,39 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	It("isolates keys by context user and supports update and delete", func() {
+		o := orm.NewOrm()
+		for _, id := range []string{"props-user-1", "props-user-2"} {
+			_, err := o.Raw("insert or ignore into user (id, user_name, name, email, password, created_at, updated_at) values (?, ?, '', ?, '', current_timestamp, current_timestamp)", id, id, id+"@example.test").Exec()
+			Expect(err).NotTo(HaveOccurred())
+		}
+		ctx := log.NewContext(context.Background())
+		first := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "props-user-1"}), o)
+		second := NewUserPropsRepository(request.WithUser(ctx, model.User{ID: "props-user-2"}), o)
+
+		Expect(first.Put("key", "first")).To(Succeed())
+		value, err := second.Get("key")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(MatchError(model.ErrNotFound))
+		Expect(second.Put("key", "second")).To(Succeed())
+		Expect(first.Put("key", "updated")).To(Succeed())
+		Expect(first.Get("key")).To(Equal("updated"))
+		Expect(second.Get("key")).To(Equal("second"))
+		Expect(first.Delete("key")).To(Succeed())
+		value, err = first.Get("key")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(MatchError(model.ErrNotFound))
+		Expect(second.Get("key")).To(Equal("second"))
+	})
+})
