+func TestDiffDirections(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"new":  {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "newpkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"newpkg": {Name: "newpkg", Version: "current"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"old":  {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "oldpkg"}}},
+			"same": {CveID: "same"},
+		},
+		Packages: models.Packages{"oldpkg": {Name: "oldpkg", Version: "previous"}},
+	}
+	for _, tc := range []struct {
+		name        string
+		plus, minus bool
+		want        models.VulnInfos
+	}{
+		{"plus", true, false, models.VulnInfos{"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "newpkg"}}}}},
+		{"minus", false, true, models.VulnInfos{"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "oldpkg"}}}}},
+		{"both", true, true, models.VulnInfos{
+			"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "newpkg"}}},
+			"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "oldpkg"}}},
+		}},
+		{"neither", false, false, models.VulnInfos{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tc.plus, tc.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got[0].ScannedCves, tc.want) {
+				t.Errorf("CVEs: got %#v, want %#v", got[0].ScannedCves, tc.want)
+			}
+			for _, info := range got[0].ScannedCves {
+				for _, affected := range info.AffectedPackages {
+					want := current.Packages[affected.Name]
+					if info.DiffStatus == models.DiffMinus {
+						want = previous.Packages[affected.Name]
+					}
+					if !reflect.DeepEqual(got[0].Packages[affected.Name], want) {
+						t.Errorf("package %s: got %#v, want %#v", affected.Name, got[0].Packages[affected.Name], want)
+					}
+				}
+			}
+		})
+	}
+}
