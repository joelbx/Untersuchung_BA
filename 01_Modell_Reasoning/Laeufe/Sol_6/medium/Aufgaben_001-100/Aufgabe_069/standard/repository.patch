+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		pattern string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, "unsupported function namespace other, supported namespaces are email and regexp"},
+		{`{{regexp.other("foo")}}`, "unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match."},
+		{`{{email.other("foo")}}`, "unsupported function email.other, supported functions are: email.local"},
+		{`{{regexp.match(internal.foo)}}`, "not a valid matcher expression - no variables and transformations are allowed."},
+		{`{{regexp.match("a", "b")}}`, "not a valid matcher expression - no variables and transformations are allowed."},
+		{`{{email.local("foo")}}`, "not a valid matcher expression - no variables and transformations are allowed."},
+		{`{{internal.foo}}`, "not a valid matcher expression - no variables and transformations are allowed."},
+		{`{{regexp.match("[")}}`, `failed parsing regexp "[":`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			_, err := Match(tt.pattern)
+			assert.True(t, trace.IsBadParameter(err), "error: %v", err)
+			if err != nil {
+				assert.True(t, strings.Contains(err.Error(), tt.message), "error: %v", err)
+			}
+		})
+	}
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+}
