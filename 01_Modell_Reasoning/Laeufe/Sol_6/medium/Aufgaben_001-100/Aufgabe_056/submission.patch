diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts
new file mode 100644
index 0000000..940900e
--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/imageSupport.test.ts
@@ -0,0 +1,40 @@
+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    ...jest.requireActual('@proton/shared/lib/helpers/browser'),
+    getBrowser: jest.fn(),
+    getOS: jest.fn(),
+}));
+
+const mockBrowser = getBrowser as jest.Mock;
+const mockOS = getOS as jest.Mock;
+
+describe('modern image support', () => {
+    it.each([
+        ['Mac OS', 'Safari', '17.0', true],
+        ['iOS', 'Mobile Safari', '17.1', true],
+        ['Mac OS', 'Safari', '16.6', false],
+        ['iOS', 'Mobile Safari', '16.4', false],
+        ['Windows', 'Safari', '17.0', false],
+        ['Mac OS', 'Chrome', '17.0', false],
+        ['Mac OS', 'Safari', undefined, false],
+    ])('checks %s %s %s', (os, browser, version, supported) => {
+        mockOS.mockReturnValue({ name: os });
+        mockBrowser.mockReturnValue({ name: browser, version });
+
+        expect(isHEICSupported()).toBe(supported);
+        expect(isJXLSupported()).toBe(supported);
+        for (const mimeType of [
+            SupportedMimeTypes.heic,
+            SupportedMimeTypes.heics,
+            SupportedMimeTypes.heif,
+            SupportedMimeTypes.heifs,
+            SupportedMimeTypes.jxl,
+        ]) {
+            expect(isSupportedImage(mimeType)).toBe(supported);
+        }
+        expect(isSupportedImage(SupportedMimeTypes.png)).toBe(true);
+    });
+});
diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
new file mode 100644
index 0000000..3bc5627
--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
@@ -0,0 +1,23 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('uses the declared MIME type when it is specific', async () => {
+        const file = new File(['x'], 'photo.jxl', { type: 'image/png' });
+        expect(await mimeTypeFromFile(file)).toBe('image/png');
+    });
+
+    it.each(['', 'application/octet-stream'])('uses the extension for a generic type (%s)', async (type) => {
+        const file = new File(['x'], 'photo.jxl', { type });
+        expect(await mimeTypeFromFile(file)).toBe('image/jxl');
+    });
+
+    it('recognizes HEIC on small files without a declared type', async () => {
+        const file = new File(['x'], 'photo.heic');
+        expect(await mimeTypeFromFile(file)).toBe('image/heic');
+    });
+
+    it('uses a generic type for unknown extensions', async () => {
+        const file = new File(['x'], 'photo.unknownextension');
+        expect(await mimeTypeFromFile(file)).toBe('application/octet-stream');
+    });
+});
