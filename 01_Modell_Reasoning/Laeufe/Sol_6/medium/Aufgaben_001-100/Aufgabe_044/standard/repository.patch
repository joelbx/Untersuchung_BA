@@ -0,0 +1,31 @@
+package authz
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestFormatNamespaces(t *testing.T) {
+	got, err := FormatNamespaces([]any{"local", "staging"})
+	require.NoError(t, err)
+	require.Equal(t, []string{"local", "staging"}, got)
+
+	got, err = FormatNamespaces([]any{})
+	require.NoError(t, err)
+	require.Empty(t, got)
+
+	for _, malformed := range []any{nil, true, []any{"local", 42}} {
+		_, err = FormatNamespaces(malformed)
+		require.Error(t, err)
+	}
+}
+
+func TestNamespacesContext(t *testing.T) {
+	_, ok := NamespacesFromContext(context.Background())
+	require.False(t, ok)
+	got, ok := NamespacesFromContext(ContextWithNamespaces(context.Background(), []string{}))
+	require.True(t, ok)
+	require.Empty(t, got)
+}
