@@ -0,0 +1,74 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { RESPONSE_CODE } from '@proton/shared/lib/drive/constants';
+
+import useLink from './useLink';
+
+const mockRequest = jest.fn();
+const mockSetLinks = jest.fn();
+
+jest.mock('../_api/useDebouncedRequest', () => () => mockRequest);
+jest.mock('../_utils/useDebouncedFunction', () => () => (callback: (signal: AbortSignal) => unknown) =>
+    callback(new AbortController().signal)
+);
+jest.mock('../_crypto', () => ({ useDriveCrypto: () => ({ getVerificationKey: jest.fn() }) }));
+jest.mock('../_shares', () => ({ useShare: () => ({ getSharePrivateKey: jest.fn() }) }));
+jest.mock('./useLinksKeys', () => () => ({}));
+jest.mock('./useLinksState', () => () => ({ getLink: () => undefined, setLinks: mockSetLinks }));
+
+describe('useLink failed fetch backoff', () => {
+    const signal = new AbortController().signal;
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        mockRequest.mockReset();
+        mockSetLinks.mockReset();
+    });
+
+    afterEach(() => {
+        jest.clearAllTimers();
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses error %s for the same link and retries after the backoff',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequest.mockRejectedValue(error);
+            const { result } = renderHook(() => useLink());
+
+            await expect(result.current.setSignatureIssues(signal, 'share', `missing-${code}`, {})).rejects.toBe(error);
+            await expect(result.current.setSignatureIssues(signal, 'share', `missing-${code}`, {})).rejects.toBe(error);
+            expect(mockRequest).toHaveBeenCalledTimes(1);
+
+            jest.advanceTimersByTime(30_000);
+            await expect(result.current.setSignatureIssues(signal, 'share', `missing-${code}`, {})).rejects.toBe(error);
+            expect(mockRequest).toHaveBeenCalledTimes(2);
+        }
+    );
+
+    it('keeps other links and shares independent and processes successful fetches', async () => {
+        const error = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequest.mockRejectedValueOnce(error).mockResolvedValue({ Link: { LinkID: 'valid', Name: 'name' } });
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.setSignatureIssues(signal, 'share-a', 'missing-isolation', {})).rejects.toBe(error);
+        await result.current.setSignatureIssues(signal, 'share-a', 'valid', {});
+        await result.current.setSignatureIssues(signal, 'share-a', 'valid', {});
+        expect(mockSetLinks).toHaveBeenCalledWith('share-a', [
+            { encrypted: expect.objectContaining({ linkId: 'valid', name: 'name', rootShareId: 'share-a' }) },
+        ]);
+        await result.current.setSignatureIssues(signal, 'share-b', 'missing-isolation', {});
+        expect(mockRequest).toHaveBeenCalledTimes(4);
+    });
+
+    it('does not cache other API errors', async () => {
+        const error = { data: { Code: 9999 } };
+        mockRequest.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.setSignatureIssues(signal, 'share', 'other-error', {})).rejects.toBe(error);
+        await expect(result.current.setSignatureIssues(signal, 'share', 'other-error', {})).rejects.toBe(error);
+        expect(mockRequest).toHaveBeenCalledTimes(2);
+    });
+});
