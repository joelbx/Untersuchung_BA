+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_new_file_default_mode_warning(atomic_am, tmp_path, mocker, capsys):
+    source = tmp_path / 'source'
+    destination = tmp_path / 'destination'
+    second_source = tmp_path / 'second_source'
+    second_destination = tmp_path / 'second_destination'
+    source.write_text('contents')
+    second_source.write_text('more contents')
+    os.chmod(str(source), 0o644)
+    atomic_am.selinux_enabled.return_value = False
+    mocker.patch('ansible.module_utils.basic.os.umask', side_effect=[0o022, 0o022, 0o022, 0o022])
+    mocker.patch('ansible.module_utils.common.warnings._global_warnings', [])
+    mocker.patch.object(atomic_am, 'log')
+
+    atomic_am.atomic_move(str(source), str(destination))
+    atomic_am.atomic_move(str(second_source), str(second_destination))
+
+    assert stat.S_IMODE(destination.stat().st_mode) == 0o600
+    assert stat.S_IMODE(second_destination.stat().st_mode) == 0o600
+    assert atomic_am._created_files == {str(destination), str(second_destination)}
+
+    atomic_am._return_formatted({})
+    result = json.loads(capsys.readouterr().out)
+    assert result['warnings'] == [
+        "File '%s' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning." % path
+        for path in (destination, second_destination)
+    ]
+
+
+@pytest.mark.parametrize('stdin, am', [({}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_explicit_mode_clears_created_file_warning(atomic_am, tmp_path, mocker, capsys):
+    source = tmp_path / 'source'
+    destination = tmp_path / 'destination'
+    source.write_text('contents')
+    atomic_am.selinux_enabled.return_value = False
+    mocker.patch('ansible.module_utils.common.warnings._global_warnings', [])
+    mocker.patch.object(atomic_am, 'log')
+
+    atomic_am.atomic_move(str(source), str(destination))
+    assert atomic_am._created_files == {str(destination)}
+    atomic_am.set_mode_if_different(str(destination), '0640', False)
+    assert atomic_am._created_files == set()
+
+    atomic_am._return_formatted({})
+    assert 'warnings' not in json.loads(capsys.readouterr().out)
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_without_mode_argument_has_no_warning(atomic_am, tmp_path):
+    source = tmp_path / 'source'
+    destination = tmp_path / 'destination'
+    source.write_text('contents')
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move(str(source), str(destination))
+
+    assert stat.S_IMODE(destination.stat().st_mode) == 0o600
+    assert atomic_am._created_files == set()
+
+
+@pytest.mark.parametrize('stdin, am', [({'mode': '0640'}, {'mode': {'type': 'raw'}})], indirect=['stdin', 'am'])
+def test_supplied_mode_has_no_default_warning(atomic_am, tmp_path):
+    source = tmp_path / 'source'
