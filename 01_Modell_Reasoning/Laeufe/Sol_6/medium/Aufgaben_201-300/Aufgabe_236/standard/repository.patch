@@ -6,6 +6,7 @@ from __future__ import annotations
 
 from itertools import chain
 import pytest
+from ansible.module_utils.common import warnings
 
 
 # Strings that should be converted into a typed value
@@ -66,3 +67,16 @@ def test_invalid_strings_with_exceptions(am, code, expected, exception):
         assert res[1] == exception
     else:
         assert isinstance(res[1], exception)
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=True)
+def test_safe_eval_deprecation(am, monkeypatch):
+    from ansible.module_utils.common.validation import safe_eval
+
+    monkeypatch.setattr(warnings, '_global_deprecations', [])
+    assert safe_eval('{}') == {}
+    assert am.safe_eval('{}') == {}
+    messages = warnings.get_deprecation_messages()
+    assert len(messages) == 2
+    assert all(message['version'] == '2.21' for message in messages)
+    assert all('safe_eval' in message['msg'] for message in messages)
