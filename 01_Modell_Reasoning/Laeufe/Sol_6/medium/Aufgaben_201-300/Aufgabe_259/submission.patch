+    @pytest.mark.asyncio
+    async def test_public_edition_wins_regardless_of_edition_order(self):
+        w = make_work()
+        editions = [
+            make_edition(
+                w, key='/books/OL11M', ocaid='print_scan',
+                _ia_meta={'collection': ['printdisabled', 'americana']},
+            ),
+            make_edition(
+                w, key='/books/OL12M', ocaid='library_scan',
+                _ia_meta={'collection': ['inlibrary', 'internetarchivebooks']},
+            ),
+            make_edition(
+                w, key='/books/OL13M', ocaid='other_print_scan',
+                _ia_meta={'collection': ['printdisabled']},
+            ),
+            make_edition(
+                w, key='/books/OL14M', ocaid='public_scan',
+                _ia_meta={'collection': ['americana']},
+            ),
+            make_edition(
+                w, key='/books/OL15M', ocaid='lending_scan',
+                _ia_meta={'collection': ['lendinglibrary']},
+            ),
+        ]
+        for ordered_editions in (editions, list(reversed(editions))):
+            update_work.data_provider = FakeDataProvider([w, *ordered_editions])
+            d = await build_data(w)
+            assert d['has_fulltext'] is True
+            assert d['public_scan_b'] is True
+            assert d['lending_edition_s'] == 'OL14M'
+            assert d['lending_identifier_s'] == 'public_scan'
+            assert sss(d['printdisabled_s']) == ['OL11M', 'OL13M']
+            assert set(d['ia']) == {
+                'print_scan', 'library_scan', 'other_print_scan', 'public_scan',
+                'lending_scan',
+            }
+            assert set(d['ia_collection_s'].split(';')) == {
+                'printdisabled', 'americana', 'inlibrary', 'internetarchivebooks',
+                'lendinglibrary',
+            }
