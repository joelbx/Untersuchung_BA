 	Groups.removeCover = async function (data) {
+		const urls = await db.getObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url']);
+		const prefix = `${nconf.get('relative_path') || ''}/assets/uploads/files/`;
+		const folder = path.join(nconf.get('upload_path'), 'files');
+		await Promise.all(Object.values(urls).map(async (url) => {
+			if (typeof url !== 'string' || !url.startsWith(prefix)) {
+				return;
+			}
+			const filename = url.slice(prefix.length);
+			if (!filename || filename === '.' || filename === '..' || filename.includes('/') || filename.includes('\\')) {
+				return;
+			}
+			try {
+				await fs.promises.unlink(path.join(folder, filename));
+			} catch (err) {
+				if (err.code !== 'ENOENT') {
+					throw err;
+				}
+			}
+		}));
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
 	};
 };
