index 4c82dc2..ddf7552 100644
--- a/lib/ansible/module_utils/facts/sysctl.py
+++ b/lib/ansible/module_utils/facts/sysctl.py
@@ -17,22 +17,56 @@ from __future__ import (absolute_import, division, print_function)
 __metaclass__ = type
 
 import re
+import time
+import errno
 
 
 def get_sysctl(module, prefixes):
-    sysctl_cmd = module.get_bin_path('sysctl')
-    cmd = [sysctl_cmd]
-    cmd.extend(prefixes)
-
-    rc, out, err = module.run_command(cmd)
-    if rc != 0:
-        return dict()
+    try:
+        sysctl_cmd = module.get_bin_path('sysctl')
+        if not sysctl_cmd:
+            raise OSError('sysctl binary not found')
+        rc, out, err = module.run_command([sysctl_cmd] + prefixes)
+        if rc != 0:
+            raise IOError(err or 'sysctl exited with status %s' % rc)
+    except (IOError, OSError) as exc:
+        module.warn('Unable to read sysctl: %s' % exc)
+        return {}
 
-    sysctl = dict()
+    sysctl = {}
+    key = None
     for line in out.splitlines():
         if not line:
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
+        if line[0].isspace() and key is not None:
+            sysctl[key] += '\n' + line
+            continue
+        try:
+            key, value = re.split(r'\s*=\s*|:\s*|\s+', line, maxsplit=1)
+            if not key:
+                raise ValueError('empty sysctl key')
+        except ValueError as exc:
+            module.warn('Unable to split sysctl line (%s): %s' % (line, exc))
+            key = None
+            continue
         sysctl[key] = value.strip()
 
     return sysctl
+
+
+def get_uptime_facts(module):
+    sysctl_cmd = module.get_bin_path('sysctl')
+    if not sysctl_cmd:
+        raise ValueError('sysctl binary not found')
+    try:
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'])
+    except OSError as exc:
+        if exc.errno == errno.ENOENT:
+            raise ValueError('sysctl binary not found')
+        return {}
+    if rc != 0:
+        return {}
+    boot_time = out.strip()
+    if not re.match(r'^\d+$', boot_time):
+        return {}
+    return {'uptime_seconds': int(time.time() - int(boot_time))}
diff --git a/test/units/module_utils/facts/hardware/test_bsd_uptime.py b/test/units/module_utils/facts/hardware/test_bsd_uptime.py
