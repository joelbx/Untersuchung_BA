+    def _build_doc(self, role, path, collection, argspec, entry_point=None):
+        """Build documentation for a role's matching entry points.
+
+        Return the role name and None when there are no matching entry points.
+        """
+        fqcn = '.'.join([collection, role]) if collection else role
+        entry_points = {
+            name: spec for name, spec in argspec.items()
+            if entry_point is None or name == entry_point
+        }
+        if not entry_points:
+            return (fqcn, None)
+
+        doc = {
+            'path': path,
+            'collection': collection,
+            'entry_points': entry_points,
+        }
+        return (fqcn, doc)
