+@pytest.mark.parametrize('collection, entry_point, expected_name, expected_entries', [
+    ('example.collection', None, 'example.collection.sample', ('main', 'alternate')),
+    ('', 'alternate', 'sample', ('alternate',)),
+    (None, 'missing', 'sample', ()),
+])
+def test_role_build_doc(collection, entry_point, expected_name, expected_entries):
+    argspec = {
+        'main': {'short_description': 'Main', 'options': {'value': {'type': 'str'}}},
+        'alternate': {'short_description': 'Alternate'},
+    }
+
+    fqcn, doc = RoleMixin()._build_doc('sample', '/roles/sample', collection, argspec, entry_point)
+
+    assert fqcn == expected_name
+    if not expected_entries:
+        assert doc is None
+    else:
+        assert doc == {
+            'path': '/roles/sample',
+            'collection': collection,
+            'entry_points': {name: argspec[name] for name in expected_entries},
+        }
+        for name in expected_entries:
+            assert doc['entry_points'][name] is argspec[name]
+
+
+def test_role_build_doc_with_no_entry_points():
+    assert RoleMixin()._build_doc('sample', '/roles/sample', '', {}) == ('sample', None)
