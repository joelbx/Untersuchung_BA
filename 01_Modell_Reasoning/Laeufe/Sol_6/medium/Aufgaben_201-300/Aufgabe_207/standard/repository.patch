             assert arg in args
 
+    @pytest.mark.parametrize('backend, expected', [
+        (usertypes.Backend.QtWebEngine,
+         ['--enable-features=First,Second,Third,Fourth']),
+        (usertypes.Backend.QtWebKit,
+         ['--enable-features=First,Second',
+          '--enable-features=Third,Fourth']),
+    ])
+    def test_feature_flags_from_cli_and_config(self, config_stub, monkeypatch,
+                                               parser, backend, expected):
+        monkeypatch.setattr(qtargs.objects, 'backend', backend)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = ['enable-features=Third,Fourth']
+        parsed = parser.parse_args(
+            ['--qt-flag', 'enable-features=First,Second'])
+
+        args = qtargs.qt_args(parsed)
+
+        feature_args = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+        assert feature_args == expected
+
+    def test_feature_flags_from_qt_arg(self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.scrolling.bar = 'never'
+        parsed = parser.parse_args(
+            ['--qt-arg', 'enable-features', 'First,Second'])
+
+        args = qtargs.qt_args(parsed)
+
+        assert '--enable-features' not in args
+        feature_args = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+        assert feature_args == ['--enable-features=First,Second']
+
+    def test_feature_flags_with_overlay(self, config_stub, monkeypatch,
+                                        parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+        config_stub.val.qt.args = ['enable-features=Other']
+
+        args = qtargs.qt_args(parser.parse_args([]))
+
+        feature_args = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+        assert feature_args == ['--enable-features=Other,OverlayScrollbar']
+
+    def test_enabled_features_from_multiple_flags(self, config_stub):
+        config_stub.val.scrolling.bar = 'never'
+        assert list(qtargs._qtwebengine_enabled_features([
+            '--enable-features=First,Second', '--enable-features=Third',
+        ])) == ['First', 'Second', 'Third']
+
+    @pytest.mark.parametrize('feature_flags, expected', [
