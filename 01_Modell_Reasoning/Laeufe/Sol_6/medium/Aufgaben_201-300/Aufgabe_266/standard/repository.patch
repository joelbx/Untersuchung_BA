@@ -96,6 +96,32 @@ def import_item_db_staged(setup_item_db):
 
 
 class TestImportItem:
+    def test_find_staged_or_pending(self, import_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'batch_id': 1, 'ia_id': 'amazon:123', 'status': 'staged'},
+                {'batch_id': 1, 'ia_id': 'idb:456', 'status': 'pending'},
+                {'batch_id': 1, 'ia_id': 'idb:123', 'status': 'created'},
+                {'batch_id': 1, 'ia_id': 'other:123', 'status': 'pending'},
+                {'batch_id': 1, 'ia_id': 'amazon:789', 'status': 'staged'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['123', '456'])
+
+        assert isinstance(result, web.db.SqliteResultSet)
+        assert {(row.ia_id, row.status) for row in result} == {
+            ('amazon:123', 'staged'),
+            ('idb:456', 'pending'),
+        }
+        assert [
+            row.ia_id for row in ImportItem.find_staged_or_pending(['123'], iter(['other']))
+        ] == ['other:123']
+        assert list(ImportItem.find_staged_or_pending([])) == []
+        assert list(ImportItem.find_staged_or_pending(['123'], [])) == []
+
     def test_delete(self, import_item_db):
         assert len(list(import_item_db.select('import_item'))) == 3
 
