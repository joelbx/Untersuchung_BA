+def _is_child_path(root, path, link_path=None):
+    """Check a path, or a link target relative to its containing directory."""
+    if link_path is not None:
+        path = os.path.join(os.path.dirname(link_path), path)
+    root = os.path.realpath(root)
+    path = os.path.realpath(path)
+    return path == root or path.startswith(root + to_bytes(os.path.sep) if isinstance(root, bytes) else root + os.path.sep)
 
 
