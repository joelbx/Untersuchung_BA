+def _extract_tar_dir(tar, filename, b_dest):
+    with _get_tar_file_member(tar, filename) as (tar_member, _):
+        b_dest_path = os.path.abspath(os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict')))
+        if not _is_child_path(b_dest, b_dest_path):
+            raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                               % to_native(filename, errors='surrogate_or_strict'))
+        b_parent = os.path.dirname(b_dest_path)
+        if not os.path.exists(b_parent):
+            os.makedirs(b_parent, mode=0o0755)
+        if tar_member.issym():
+            b_linkname = to_bytes(tar_member.linkname, errors='surrogate_or_strict')
+            if _is_child_path(b_dest, b_linkname, b_dest_path):
+                os.symlink(b_linkname, b_dest_path)
+                return
+            # A symlink without an in-collection target has no directory contents to copy.
+            with open(b_dest_path, 'wb'):
+                pass
+        else:
+            os.makedirs(b_dest_path, mode=0o0755)
+
