index 47ddca1..a8eb4cd 100644
--- a/detector/wordpress_test.go
+++ b/detector/wordpress_test.go
@@ -6,10 +6,77 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	tests := []struct {
+		name, body, fixedIn, summary, poc, introducedIn, severity, vector string
+		score                                                             float64
+	}{
+		{
+			name:    "enterprise",
+			body:    `{"617":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/one","https://example.org/two"]},"fixed_in":"6.1.8","description":"A detailed summary","poc":"https://example.org/poc","introduced_in":"6.1.0","cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N","severity":"HIGH"}}]}}`,
+			fixedIn: "6.1.8", summary: "A detailed summary", poc: "https://example.org/poc", introducedIn: "6.1.0", score: 7.5, vector: "CVSS:3.1/AV:N", severity: "HIGH",
+		},
+		{
+			name: "basic",
+			body: `{"617":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/one","https://example.org/two"]},"fixed_in":null,"description":null,"poc":null,"introduced_in":null,"cvss":null}]}}`,
+		},
+		{
+			name: "omitted",
+			body: `{"617":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/one","https://example.org/two"]}}]}}`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			infos, err := convertToVinfos("core", tt.body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(infos) != 1 {
+				t.Fatalf("got %d records, want one", len(infos))
+			}
+			info := infos[0]
+			if info.CveID != "CVE-2024-1234" || info.VulnType != "XSS" {
+				t.Fatalf("unexpected ID or type: %+v", info)
+			}
+			if len(info.WpPackageFixStats) != 1 || info.WpPackageFixStats[0].Name != "core" || info.WpPackageFixStats[0].FixedIn != tt.fixedIn {
+				t.Fatalf("unexpected fix status: %+v", info.WpPackageFixStats)
+			}
+			contents := info.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("unexpected WPScan contents: %+v", contents)
+			}
+			content := contents[0]
+			if content.Type != models.WpScan || content.CveID != info.CveID || content.Summary != tt.summary {
+				t.Fatalf("unexpected content: %+v", content)
+			}
+			wantPublished := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			wantModified := time.Date(2024, 2, 3, 2, 5, 6, 0, time.UTC)
+			if !content.Published.Equal(wantPublished) || content.Published.Location() != time.UTC || !content.LastModified.Equal(wantModified) || content.LastModified.Location() != time.UTC {
+				t.Fatalf("unexpected timestamps: %v, %v", content.Published, content.LastModified)
+			}
+			wantRefs := models.References{{Link: "https://example.org/one"}, {Link: "https://example.org/two"}}
+			if !reflect.DeepEqual(content.References, wantRefs) {
+				t.Fatalf("references = %+v, want %+v", content.References, wantRefs)
+			}
+			wantOptional := map[string]string{}
+			if tt.poc != "" {
+				wantOptional["poc"] = tt.poc
+			}
+			if tt.introducedIn != "" {
+				wantOptional["introduced_in"] = tt.introducedIn
+			}
+			if !reflect.DeepEqual(content.Optional, wantOptional) || content.Cvss3Score != tt.score || content.Cvss3Vector != tt.vector || content.Cvss3Severity != tt.severity {
+				t.Fatalf("unexpected enterprise fields: %+v", content)
+			}
+		})
+	}
+}
