diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..982f07b
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,52 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseBeforeStart(t *testing.T) {
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		t.Fatal("update called after close")
+		return false, nil
+	})
+	require.NoError(t, p.Close())
+	require.NoError(t, p.Close())
+	p.Poll()
+}
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		close(entered)
+		<-ctx.Done()
+		<-release
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	go p.Poll()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("poller did not start")
+	}
+	go func() { p.Close(); close(finished) }()
+	select {
+	case <-finished:
+		t.Fatal("close returned while update was running")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatal("close did not wait for poller exit")
+	}
+
+	require.NoError(t, p.Close())
+}
