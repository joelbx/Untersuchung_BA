+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Classify raw, unhyphenated ISBN metadata by length without validation."""
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    for value in [isbns] if isinstance(isbns, str) else isbns:
+        isbn = value.strip()
+        if len(isbn) == 10:
+            isbn_10.append(isbn)
+        elif len(isbn) == 13:
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
