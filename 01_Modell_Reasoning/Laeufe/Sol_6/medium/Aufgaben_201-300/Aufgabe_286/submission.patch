diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..1f01523
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,72 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" || strings.HasSuffix(version, "dev") {
+		return false
+	}
+
+	// A numbered prerelease (for example, 1.2.3-rc.1) is still a prerelease.
+	base := strings.SplitN(version, "+", 2)[0]
+	if parts := strings.SplitN(base, "-", 2); len(parts) == 2 {
+		identifier := strings.SplitN(parts[1], ".", 2)[0]
+		switch identifier {
+		case "dev", "snapshot", "rc":
+			return false
+		}
+	}
+	return true
+}
+
+// Check looks up the latest release and compares it with version.
+func Check(ctx context.Context, version string) (info Info, err error) {
+	return check(ctx, version, github.NewClient(nil))
+}
+
+func check(ctx context.Context, version string, client *github.Client) (info Info, err error) {
+	info = Info{CurrentVersion: version}
+	defer func() {
+		if err != nil {
+			zap.L().Warn("checking for updates", zap.Error(err))
+		}
+	}()
+
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		err = fmt.Errorf("getting latest release: %w", err)
+		return info, err
+	}
+
+	latestVersion, err := semver.ParseTolerant(latest.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latestVersion.String()
+	info.LatestVersionURL = latest.GetHTMLURL()
+	info.UpdateAvailable = current.LT(latestVersion)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..db81447
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,95 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"1.2.3dev", false},
+		{"1.2.3-dev", false},
+		{"1.2.3-snapshot", false},
+		{"1.2.3-snapshot.2", false},
+		{"1.2.3-rc", false},
+		{"1.2.3-rc.1", false},
+		{"1.2.3", true},
+		{"v1.2.3", true},
+		{"1.2.3+rc", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			if got := Is(tt.version); got != tt.want {
+				t.Errorf("Is(%q) = %t, want %t", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"tag_name":"v1.3.0","html_url":"https://example.com/releases/1.3.0"}`)
+	}))
+	defer server.Close()
+
+	client := github.NewClient(server.Client())
+	baseURL, err := url.Parse(server.URL + "/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.BaseURL = baseURL
+
+	for _, tt := range []struct {
+		version string
+		update  bool
+	}{
+		{"1.2.0", true},
+		{"1.3.0", false},
+		{"1.4.0", false},
+	} {
+		t.Run(tt.version, func(t *testing.T) {
+			got, err := check(context.Background(), tt.version, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tt.version || got.LatestVersion != "1.3.0" || got.LatestVersionURL != "https://example.com/releases/1.3.0" || got.UpdateAvailable != tt.update {
+				t.Errorf("unexpected release info: %+v", got)
+			}
+		})
+	}
+}
+
+func TestCheckFailureWarns(t *testing.T) {
+	core, logs := observer.New(zap.WarnLevel)
+	restore := zap.ReplaceGlobals(zap.New(core))
+	defer restore()
+
+	got, err := Check(context.Background(), "invalid")
+	if err == nil {
+		t.Fatal("expected invalid version error")
+	}
+	if got.CurrentVersion != "invalid" {
+		t.Errorf("current version = %q", got.CurrentVersion)
+	}
+	entries := logs.All()
+	if len(entries) != 1 || entries[0].Message != "checking for updates" || entries[0].ContextMap()["error"] == nil {
+		t.Errorf("expected warning with error, got %+v", entries)
+	}
+}
