+func TestTeleportClusterClientDialEndpoint(t *testing.T) {
+	endpoint := kubeClusterEndpoint{addr: "k8s.example.com:3026", serverID: "kube-service.local"}
+	client := teleportClusterClient{
+		dial: func(ctx context.Context, network, addr, serverID string) (net.Conn, error) {
+			require.Equal(t, "tcp", network)
+			require.Equal(t, endpoint.addr, addr)
+			require.Equal(t, endpoint.serverID, serverID)
+			conn, peer := net.Pipe()
+			peer.Close()
+			return conn, nil
+		},
+	}
+	conn, err := client.dialEndpoint(context.Background(), "tcp", endpoint)
+	require.NoError(t, err)
+	require.NoError(t, conn.Close())
+}
