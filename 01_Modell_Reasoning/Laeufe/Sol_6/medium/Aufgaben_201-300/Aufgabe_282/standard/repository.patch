+@pytest.mark.parametrize('source, level, msg, shown', [
+    ('userscript:style', usertypes.JsLogLevel.error, 'ordinary failure', True),
+    ('userscript:style', usertypes.JsLogLevel.error,
+     'Refused to apply inline style due to CSP', False),
+    ('userscript:style', usertypes.JsLogLevel.warning,
+     'ordinary warning', False),
+    ('page', usertypes.JsLogLevel.error, 'ordinary failure', False),
+    ('qute:internal', usertypes.JsLogLevel.error,
+     'Refused to apply inline style due to CSP', True),
+])
+def test_js_log_to_ui(config_stub, message_mock, caplog, source, level, msg,
+                      shown):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error'], 'qute:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:*': ['*Refused to apply inline style*']}
+
+    with caplog.at_level(logging.ERROR):
+        assert shared._js_log_to_ui(level, source, 66, msg) is shown
+    if shown:
+        assert message_mock.getmsg(usertypes.MessageLevel.error).text == (
+            f'JS: [{source}:66] {msg}')
+    else:
+        assert not message_mock.messages
+
