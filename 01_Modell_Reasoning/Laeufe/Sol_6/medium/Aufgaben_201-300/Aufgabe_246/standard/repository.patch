new file mode 100644
index 0000000..4392a2d
--- /dev/null
+++ b/scan/library_test.go
@@ -0,0 +1,30 @@
+package scan
+
+import (
+	"testing"
+
+	"github.com/aquasecurity/fanal/analyzer"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestAnalyzeLockfilesSeparately(t *testing.T) {
+	var scanners models.LibraryScanners
+	for _, file := range []struct{ path, version string }{
+		{"/a/Pipfile.lock", "1.0"},
+		{"/b/Pipfile.lock", "2.0"},
+	} {
+		content := []byte(`{"default":{"requests":{"version":"==` + file.version + `"}}}`)
+		result, err := analyzer.AnalyzeFile(file.path, &DummyFileInfo{}, func() ([]byte, error) { return content, nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		scanners = append(scanners, convertLibWithScanner(result)...)
+		got := scanners.Find(file.path, "requests")
+		if got[file.path].Version != file.version {
+			t.Fatalf("%s: got library %#v", file.path, got)
+		}
+	}
+	if len(scanners) != 2 {
+		t.Fatalf("expected one scanner per lockfile, got %#v", scanners)
+	}
+}
