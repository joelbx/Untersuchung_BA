+package libmanager
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestMergeLibraryVulnKeepsSources(t *testing.T) {
+	r := &models.ScanResult{ScannedCves: models.VulnInfos{}}
+	for _, path := range []string{"/a/Pipfile.lock", "/b/Pipfile.lock"} {
+		mergeLibraryVuln(r, models.VulnInfo{
+			CveID:           "CVE-1",
+			LibraryFixedIns: models.LibraryFixedIns{{Path: path, Name: "requests", FixedIn: "2.0"}},
+		})
+	}
+	got := r.ScannedCves["CVE-1"].LibraryFixedIns
+	if len(got) != 2 || got[0].Path != "/a/Pipfile.lock" || got[1].Path != "/b/Pipfile.lock" {
+		t.Fatalf("library sources were not merged: %#v", got)
+	}
+}
