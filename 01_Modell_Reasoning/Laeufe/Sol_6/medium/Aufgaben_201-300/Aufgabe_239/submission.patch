+	if err := repo.Put("a", "b_c", "second"); err != nil {
+		t.Fatal(err)
+	}
+	if value, err := repo.Get("a_b", "c"); err != nil || value != "first" {
+		t.Fatalf("first user: %q, %v", value, err)
+	}
+	if value, err := repo.Get("a", "b_c"); err != nil || value != "second" {
+		t.Fatalf("second user: %q, %v", value, err)
+	}
+	if value, err := repo.DefaultGet("missing", "c", "default"); err != nil || value != "default" {
+		t.Fatalf("missing user: %q, %v", value, err)
+	}
+	if err := repo.Delete("a_b", "c"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.Get("a_b", "c"); err != model.ErrNotFound {
+		t.Fatalf("deleted user: %v", err)
+	}
+	if value, err := repo.Get("a", "b_c"); err != nil || value != "second" {
+		t.Fatalf("other user after delete: %q, %v", value, err)
+	}
+}
