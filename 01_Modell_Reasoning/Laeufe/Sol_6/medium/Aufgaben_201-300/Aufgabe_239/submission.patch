diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..e6109c2
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,89 @@
+package lastfm
+
+import (
+	"bytes"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkCallbackUsesAuthenticatedStartUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	router := NewRouter(ds)
+	fake := &tests.FakeHttpClient{Res: http.Response{
+		Body:       ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"session-a"}}`)),
+		StatusCode: http.StatusOK,
+	}}
+	router.client = NewClient("key", "secret", "en", fake)
+
+	start := httptest.NewRequest(http.MethodGet, "/link/start", nil)
+	start = start.WithContext(request.WithUser(start.Context(), model.User{ID: "user-a"}))
+	startResponse := httptest.NewRecorder()
+	router.startLink(startResponse, start)
+	if startResponse.Code != http.StatusOK {
+		t.Fatalf("start status: %d", startResponse.Code)
+	}
+	var body struct{ State string }
+	if err := json.Unmarshal(startResponse.Body.Bytes(), &body); err != nil || body.State == "" {
+		t.Fatalf("start state: %q, %v", body.State, err)
+	}
+
+	callbackURL := "/link/callback?state=" + url.QueryEscape(body.State) + "&uid=user-b&token=token"
+	callbackResponse := httptest.NewRecorder()
+	router.callback(callbackResponse, httptest.NewRequest(http.MethodGet, callbackURL, nil))
+	if callbackResponse.Code != http.StatusOK {
+		t.Fatalf("callback status: %d, body: %s", callbackResponse.Code, callbackResponse.Body.String())
+	}
+	if key, err := ds.UserProps(start.Context()).Get("user-a", sessionKeyProperty); err != nil || key != "session-a" {
+		t.Fatalf("user-a key: %q, %v", key, err)
+	}
+	if _, err := ds.UserProps(start.Context()).Get("user-b", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("user-b key: %v", err)
+	}
+	if fake.RequestCount != 1 {
+		t.Fatalf("LastFM requests: %d", fake.RequestCount)
+	}
+	replay := httptest.NewRecorder()
+	router.callback(replay, httptest.NewRequest(http.MethodGet, callbackURL, nil))
+	if replay.Code != http.StatusBadRequest || fake.RequestCount != 1 {
+		t.Fatalf("replayed callback: status %d, requests %d", replay.Code, fake.RequestCount)
+	}
+}
+
+func TestLinkStatusAndUnlinkAreUserScoped(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	router := NewRouter(ds)
+	ctx := request.WithUser(httptest.NewRequest(http.MethodGet, "/link", nil).Context(), model.User{ID: "user-b"})
+	if err := ds.UserProps(ctx).Put("user-a", sessionKeyProperty, "session-a"); err != nil {
+		t.Fatal(err)
+	}
+	status := httptest.NewRecorder()
+	router.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx))
+	var body struct{ Status bool }
+	if err := json.Unmarshal(status.Body.Bytes(), &body); err != nil || body.Status {
+		t.Fatalf("user-b status: %s, %v", status.Body.String(), err)
+	}
+	if err := ds.UserProps(ctx).Put("user-b", sessionKeyProperty, "session-b"); err != nil {
+		t.Fatal(err)
+	}
+	status = httptest.NewRecorder()
+	router.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx))
+	if err := json.Unmarshal(status.Body.Bytes(), &body); err != nil || !body.Status {
+		t.Fatalf("linked user-b status: %s, %v", status.Body.String(), err)
+	}
+	unlink := httptest.NewRecorder()
+	router.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+	if unlink.Code != http.StatusOK {
+		t.Fatalf("unlink status: %d", unlink.Code)
+	}
+	if key, err := ds.UserProps(ctx).Get("user-a", sessionKeyProperty); err != nil || key != "session-a" {
+		t.Fatalf("user-a key after unlink: %q, %v", key, err)
+	}
+}
