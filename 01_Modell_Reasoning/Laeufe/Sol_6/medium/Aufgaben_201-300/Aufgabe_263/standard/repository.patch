+// migrateFieldsMap converts legacy events in bounded pages. A conditional update
+// protects against concurrent writes, and a new scan can resume after any error.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock+"/"+l.Tablename, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		l.Info("Starting DynamoDB event FieldsMap migration")
+		var startKey map[string]*dynamodb.AttributeValue
+		var migrated int
+		for {
+			if err := ctx.Err(); err != nil {
+				return trace.Wrap(err)
+			}
+			page, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+				TableName:                aws.String(l.Tablename),
+				ConsistentRead:           aws.Bool(true),
+				Limit:                    aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+				ExclusiveStartKey:        startKey,
+				FilterExpression:         aws.String("attribute_exists(#fields) AND attribute_not_exists(#map)"),
+				ExpressionAttributeNames: map[string]*string{"#fields": aws.String("Fields"), "#map": aws.String("FieldsMap")},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+			// Process each page before advancing its cursor. Conditional updates
+			// allow the page to be retried safely after interruption.
+			results := make(chan error, len(page.Items))
+			slots := make(chan struct{}, maxMigrationWorkers)
+			var workers sync.WaitGroup
+			for _, item := range page.Items {
+				slots <- struct{}{}
+				workers.Add(1)
+				go func(item map[string]*dynamodb.AttributeValue) {
+					defer workers.Done()
+					defer func() { <-slots }()
+					results <- l.migrateFieldsMapItem(ctx, item)
+				}(item)
+			}
+			workers.Wait()
+			close(results)
+			for err := range results {
+				if err != nil {
+					return trace.Wrap(err)
+				}
+				migrated++
+			}
+			if migrated > 0 && migrated%DynamoBatchSize == 0 {
+				l.Infof("Migrated %d DynamoDB event field maps", migrated)
+			}
+			startKey = page.LastEvaluatedKey
+			if len(startKey) == 0 {
+				break
+			}
+		}
+		_, err := l.backend.Put(ctx, backend.Item{Key: backend.FlagKey("dynamoEvents", l.Tablename, "fieldsMap"), Value: []byte("complete")})
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		l.Infof("DynamoDB event FieldsMap migration complete: %d events", migrated)
+		return nil
+	})
+}
+
+func (l *Log) migrateFieldsMapItem(ctx context.Context, item map[string]*dynamodb.AttributeValue) error {
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return trace.BadParameter("event %v/%v has a non-string Fields attribute", item[keySessionID], item[keyEventIndex])
+	}
+	fields, err := fieldsMap([]byte(*legacy.S))
+	if err != nil {
+		l.WithError(err).Errorf("Cannot convert event %v/%v", item[keySessionID], item[keyEventIndex])
+		return trace.Wrap(err)
+	}
+	converted, err := fieldsJSON(fields)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	var original, roundTrip interface{}
+	for _, input := range []struct {
+		data   []byte
+		target *interface{}
+	}{{[]byte(*legacy.S), &original}, {converted, &roundTrip}} {
+		decoder := json.NewDecoder(bytes.NewReader(input.data))
+		decoder.UseNumber()
+		if err := decoder.Decode(input.target); err != nil {
+			return trace.Wrap(err)
+		}
+	}
+	if !reflect.DeepEqual(original, roundTrip) {
+		return trace.BadParameter("FieldsMap conversion changed event %v/%v", item[keySessionID], item[keyEventIndex])
+	}
+	_, err = l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+		TableName:                aws.String(l.Tablename),
+		Key:                      map[string]*dynamodb.AttributeValue{keySessionID: item[keySessionID], keyEventIndex: item[keyEventIndex]},
+		UpdateExpression:         aws.String("SET #map = :map REMOVE #fields"),
+		ConditionExpression:      aws.String("#fields = :old AND attribute_not_exists(#map)"),
+		ExpressionAttributeNames: map[string]*string{"#fields": aws.String("Fields"), "#map": aws.String("FieldsMap")},
+		ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+			":map": {M: fields}, ":old": legacy,
+		},
+	})
+	if err != nil {
+		if requestErr, ok := err.(awserr.Error); ok && requestErr.Code() == dynamodb.ErrCodeConditionalCheckFailedException {
+			return nil
+		}
+		return trace.Wrap(convertError(err))
+	}
+	return nil
+}
