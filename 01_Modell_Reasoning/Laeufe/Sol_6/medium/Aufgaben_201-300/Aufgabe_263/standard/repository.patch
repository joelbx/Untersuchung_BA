+func TestFieldsMapRoundTrip(t *testing.T) {
+	data := []byte(`{"large":9007199254740993,"nested":{"enabled":true,"empty":null,"blank":""},"items":[1,"two"]}`)
+	item, err := marshalEvent(event{SessionID: "session", EventIndex: 1}, data)
+	require.NoError(t, err)
+	require.NotContains(t, item, "Fields")
+	require.Equal(t, "9007199254740993", aws.StringValue(item["FieldsMap"].M["large"].N))
+	require.Equal(t, "", aws.StringValue(item["FieldsMap"].M["nested"].M["blank"].S))
+	var got event
+	require.NoError(t, unmarshalEvent(item, &got))
+	require.JSONEq(t, string(data), got.Fields)
+
+	legacy, err := dynamodbattribute.MarshalMap(event{SessionID: "session", EventIndex: 1, Fields: string(data)})
+	require.NoError(t, err)
+	require.NoError(t, unmarshalEvent(legacy, &got))
+	require.JSONEq(t, string(data), got.Fields)
+	require.Equal(t, []byte("/.flags/dynamoEvents/test/fieldsMap"), backend.FlagKey("dynamoEvents", "test", "fieldsMap"))
