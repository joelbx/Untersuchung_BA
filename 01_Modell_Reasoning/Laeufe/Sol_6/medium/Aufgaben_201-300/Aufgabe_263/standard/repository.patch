+// fieldsMap converts JSON without passing numbers through float64, which would
+// silently change large audit identifiers and timestamps.
+func fieldsMap(data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.UseNumber()
+	var fields map[string]interface{}
+	if err := dec.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var trailing interface{}
+	if err := dec.Decode(&trailing); err != io.EOF {
+		return nil, trace.BadParameter("event fields contain trailing JSON data")
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	out := make(map[string]*dynamodb.AttributeValue, len(fields))
+	for key, value := range fields {
+		av, err := jsonAttribute(value)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		out[key] = av
+	}
+	return out, nil
+}
+
+func jsonAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch v := value.(type) {
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(v))}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(v)}, nil
+	case map[string]interface{}:
+		m := make(map[string]*dynamodb.AttributeValue, len(v))
+		for key, child := range v {
+			av, err := jsonAttribute(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			m[key] = av
+		}
+		return &dynamodb.AttributeValue{M: m}, nil
+	case []interface{}:
+		list := make([]*dynamodb.AttributeValue, len(v))
+		for i, child := range v {
+			av, err := jsonAttribute(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			list[i] = av
+		}
+		return &dynamodb.AttributeValue{L: list}, nil
+	default:
+		return dynamodbattribute.Marshal(value)
+	}
+}
+
+func fieldsJSON(m map[string]*dynamodb.AttributeValue) ([]byte, error) {
+	var decoded map[string]interface{}
+	decoder := dynamodbattribute.NewDecoder(func(d *dynamodbattribute.Decoder) { d.UseNumber = true })
+	if err := decoder.Decode(&dynamodb.AttributeValue{M: m}, &decoded); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return json.Marshal(normalizeNumbers(decoded))
+}
+
+func normalizeNumbers(value interface{}) interface{} {
+	switch v := value.(type) {
+	case dynamodbattribute.Number:
+		return json.Number(v)
+	case map[string]interface{}:
+		for k, child := range v {
+			v[k] = normalizeNumbers(child)
+		}
+	case []interface{}:
+		for i, child := range v {
+			v[i] = normalizeNumbers(child)
+		}
+	}
+	return value
+}
+
+func marshalEvent(e event, data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	m, err := fieldsMap(data)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item["FieldsMap"] = &dynamodb.AttributeValue{M: m}
+	return item, nil
+}
+
+func unmarshalEvent(item map[string]*dynamodb.AttributeValue, e *event) error {
+	if err := dynamodbattribute.UnmarshalMap(item, e); err != nil {
+		return trace.Wrap(err)
+	}
+	if av := item["FieldsMap"]; av != nil {
+		if av.M == nil {
+			return trace.BadParameter("FieldsMap is not a DynamoDB map")
+		}
+		data, err := fieldsJSON(av.M)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		e.Fields = string(data)
+	}
+	return nil
+}
