+func convertKEVs(response kevulndb.Response) (kevs []models.KEV) {
+	for _, cisa := range response.CISA {
+		kevs = append(kevs, models.KEV{
+			Type: models.CISAKEVType, VendorProject: cisa.VendorProject,
+			Product: cisa.Product, VulnerabilityName: cisa.VulnerabilityName,
+			ShortDescription: cisa.ShortDescription, RequiredAction: cisa.RequiredAction,
+			KnownRansomwareCampaignUse: cisa.KnownRansomwareCampaignUse,
+			DateAdded:                  cisa.DateAdded, DueDate: validDueDate(&cisa.DueDate),
+			CISA: &models.CISAKEV{Note: cisa.Notes},
+		})
+	}
+	for _, vulncheck := range response.VulnCheck {
+		kev := models.KEV{
+			Type: models.VulnCheckKEVType, VendorProject: vulncheck.VendorProject,
+			Product: vulncheck.Product, VulnerabilityName: vulncheck.Name,
+			ShortDescription: vulncheck.Description, RequiredAction: vulncheck.RequiredAction,
+			KnownRansomwareCampaignUse: vulncheck.KnownRansomwareCampaignUse,
+			DateAdded:                  vulncheck.DateAdded, DueDate: validDueDate(vulncheck.DueDate),
+			VulnCheck: &models.VulnCheckKEV{},
+		}
+		for _, xdb := range vulncheck.VulnCheckXDB {
+			kev.VulnCheck.XDB = append(kev.VulnCheck.XDB, models.VulnCheckXDB{
+				XDBID: xdb.XDBID, XDBURL: xdb.XDBURL, DateAdded: xdb.DateAdded,
+				ExploitType: xdb.ExploitType, CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, reported := range vulncheck.VulnCheckReportedExploitation {
+			kev.VulnCheck.ReportedExploitation = append(kev.VulnCheck.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL: reported.URL, DateAdded: reported.DateAdded,
+			})
+		}
+		kevs = append(kevs, kev)
+	}
+	return kevs
+}
+
+func validDueDate(date *time.Time) *time.Time {
+	if date == nil || date.IsZero() || date.Year() <= 1000 {
+		return nil
+	}
+	return date
+}
