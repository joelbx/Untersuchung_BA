+package models
+
+import "testing"
+
+func TestKEVSummaryAndJSONOrder(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"CVE-1": {KEVs: []KEV{
+			{Type: VulnCheckKEVType, VulnerabilityName: "Z"},
+			{Type: CISAKEVType, VulnerabilityName: "B"},
+			{Type: CISAKEVType, VulnerabilityName: "A"},
+		}},
+		"CVE-2": {KEVs: []KEV{{Type: CISAKEVType, VulnerabilityName: "C"}}},
+		"CVE-3": {},
+	}}
+	if got := r.FormatKEVCveSummary(); got != "2 KEVs" {
+		t.Fatalf("summary = %q", got)
+	}
+	r.SortForJSONOutput()
+	kevs := r.ScannedCves["CVE-1"].KEVs
+	if kevs[0].VulnerabilityName != "A" || kevs[1].VulnerabilityName != "B" || kevs[2].VulnerabilityName != "Z" {
+		t.Errorf("KEV order: %+v", kevs)
+	}
+}
