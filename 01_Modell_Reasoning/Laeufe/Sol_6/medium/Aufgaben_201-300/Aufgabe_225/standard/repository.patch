 	request kevulnRequest
 	json    string
diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..db8a176
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,39 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestConvertKEVs(t *testing.T) {
+	date := time.Date(2024, time.September, 1, 0, 0, 0, 0, time.UTC)
+	placeholder := time.Date(1000, time.January, 1, 0, 0, 0, 0, time.UTC)
+	response := kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{VendorProject: "CISA vendor", VulnerabilityName: "CISA entry", Notes: "note", DueDate: placeholder}},
+		VulnCheck: []kevulnmodels.VulnCheck{{
+			VendorProject: "VC vendor", Name: "VC entry", Description: "description", DueDate: &date,
+			VulnCheckXDB:                  []kevulnmodels.VulnCheckXDB{{XDBID: "XDB-1", XDBURL: "https://example.com/xdb", ExploitType: "poc", CloneSSHURL: "git@example.com:xdb", DateAdded: date}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{URL: "https://example.com/report", DateAdded: date}},
+		}},
+	}
+	kevs := convertKEVs(response)
+	if len(kevs) != 2 || kevs[0].Type != models.CISAKEVType || kevs[1].Type != models.VulnCheckKEVType {
+		t.Fatalf("unexpected KEVs: %+v", kevs)
+	}
+	if kevs[0].DueDate != nil || kevs[0].CISA == nil || kevs[0].CISA.Note != "note" {
+		t.Errorf("CISA mapping: %+v", kevs[0])
+	}
+	vc := kevs[1]
+	if vc.VendorProject != "VC vendor" || vc.ShortDescription != "description" || vc.DueDate == nil || !vc.DueDate.Equal(date) || vc.VulnCheck == nil {
+		t.Fatalf("VulnCheck mapping: %+v", vc)
+	}
+	if len(vc.VulnCheck.XDB) != 1 || vc.VulnCheck.XDB[0].XDBID != "XDB-1" || vc.VulnCheck.XDB[0].CloneSSHURL != "git@example.com:xdb" || len(vc.VulnCheck.ReportedExploitation) != 1 || vc.VulnCheck.ReportedExploitation[0].URL != "https://example.com/report" {
+		t.Errorf("VulnCheck details: %+v", vc.VulnCheck)
+	}
+}
