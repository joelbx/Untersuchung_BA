+def process_cover_url(
+    edition: dict, allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS
+) -> tuple[str | None, dict]:
+    """Remove an imported cover URL and return it only for an allowed HTTP host."""
+    if 'cover' not in edition:
+        return None, edition
+
+    cover_url = edition.pop('cover')
+    if not isinstance(cover_url, str):
+        return None, edition
+    try:
+        parsed = urlsplit(cover_url)
+        hostname = parsed.hostname
+    except ValueError:
+        return None, edition
+    if parsed.scheme.lower() in ('http', 'https') and hostname and hostname.lower() in {
+        host.lower() for host in allowed_cover_hosts
+    }:
+        return cover_url, edition
+    return None, edition
+
