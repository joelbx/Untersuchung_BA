+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "loadstart", "loadedmetadata", "loadeddata", "canplay", "canplaythrough",
+    "play", "playing", "pause", "ended", "waiting", "seeking", "seeked",
+    "volumechange", "suspend", "emptied", "durationchange", "progress",
+    "ratechange", "timeupdate",
+]);
+
+/** Listener for events dispatched by a call's media element. */
+export function handleEvent(e: Event): void {
+    const element = e.currentTarget as HTMLMediaElement | null;
+    const details = { id: element?.id, type: e.type };
+
+    if (errorEvents.has(e.type)) {
+        logger.error("LegacyCallHandler media event", { ...details, error: element?.error });
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("LegacyCallHandler media event", details);
+    }
+}
