diff --git a/scanner/refresher_test.go b/scanner/refresher_test.go
new file mode 100644
index 0000000..3752e46
--- /dev/null
+++ b/scanner/refresher_test.go
@@ -0,0 +1,29 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("imageFiles", func() {
+	It("joins every image in the album's directories in directory and filename order", func() {
+		a := filepath.Join("music", "a")
+		b := filepath.Join("music", "b")
+		other := filepath.Join("music", "other")
+		fsDirs := dirMap{
+			a:     {ImageFiles: []string{"back.png", "front.jpg"}},
+			b:     {ImageFiles: []string{"cover.webp"}},
+			other: {ImageFiles: []string{"unrelated.jpg"}},
+		}
+		Expect(imageFiles([]string{a, b}, fsDirs)).To(Equal(strings.Join([]string{
+			filepath.Join(a, "back.png"), filepath.Join(a, "front.jpg"), filepath.Join(b, "cover.webp"),
+		}, string(filepath.ListSeparator))))
+	})
+
+	It("returns an empty string when the album has no images", func() {
+		Expect(imageFiles([]string{"music"}, dirMap{})).To(BeEmpty())
+	})
+})
