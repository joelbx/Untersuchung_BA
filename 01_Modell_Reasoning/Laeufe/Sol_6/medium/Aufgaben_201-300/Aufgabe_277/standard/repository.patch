+
+func TestRuleSegments(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		legacy  string
+		keys    []string
+		wantKey string
+		wantOp  string
+	}{
+		{name: "legacy", legacy: "old", wantKey: "old"},
+		{name: "single", legacy: "old", keys: []string{"one"}, wantKey: "one"},
+		{name: "multiple", keys: []string{"one", "two"}, wantKey: "one,two", wantOp: flipt.SegmentOperator_AND_SEGMENT_OPERATOR.String()},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{SegmentKey: tt.legacy, SegmentKeys: tt.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR})
+			assert.Equal(t, tt.wantKey, rule.SegmentKey)
+			assert.Equal(t, tt.wantOp, rule.SegmentOperator)
+			data, err := json.Marshal(rule)
+			assert.NoError(t, err)
+			if tt.wantOp == "" {
+				assert.NotContains(t, string(data), `"segment_operator"`)
+			} else {
+				assert.Contains(t, string(data), `"segment_operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		legacy  string
+		keys    []string
+		wantKey string
+		wantOp  string
+	}{
+		{name: "legacy", legacy: "old", wantKey: "old"},
+		{name: "single", legacy: "old", keys: []string{"one"}, wantKey: "one"},
+		{name: "multiple", keys: []string{"one", "two"}, wantKey: "one,two", wantOp: flipt.SegmentOperator_AND_SEGMENT_OPERATOR.String()},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+				SegmentKey: tt.legacy, SegmentKeys: tt.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true,
+			}}})
+			assert.Equal(t, tt.wantKey, rollout.Segment.Key)
+			assert.Equal(t, tt.wantOp, rollout.Segment.Operator)
+			assert.True(t, rollout.Segment.Value)
+			data, err := json.Marshal(rollout)
+			assert.NoError(t, err)
+			if tt.wantOp == "" {
+				assert.NotContains(t, string(data), `"operator"`)
+			} else {
+				assert.Contains(t, string(data), `"operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
