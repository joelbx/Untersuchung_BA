@@ -0,0 +1,68 @@
+package app
+
+import (
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/tests"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	cases := []struct {
+		addr, list string
+		valid      bool
+	}{
+		{"127.0.0.1:5000", "bad, 127.0.0.0/8", true},
+		{"[2001:db8::1]:5000", "bad, 2001:db8::/32", true},
+		{"192.0.2.1:5000", "127.0.0.0/8,2001:db8::/32", false},
+		{"127.0.0.1:5000", "", false},
+		{"@", "@", true},
+		{"@", "0.0.0.0/0", false},
+	}
+	for _, tc := range cases {
+		assert.Equal(t, tc.valid, validateIPAgainstList(tc.addr, tc.list), tc.addr)
+	}
+}
+
+func TestProxyAuthRequiresTrustedPeerAndHeader(t *testing.T) {
+	old := *conf.Server
+	defer func() { *conf.Server = old }()
+	conf.Server.ReverseProxyWhitelist = "127.0.0.0/8"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{}
+	req := httptest.NewRequest("GET", "/app/", nil)
+	req.Header.Set("Remote-User", "alice")
+	req.RemoteAddr = "192.0.2.1:5000"
+	assert.Nil(t, handleLoginFromHeaders(ds, req))
+	req.RemoteAddr = "127.0.0.1:5000"
+	auth := handleLoginFromHeaders(ds, req)
+	if assert.NotNil(t, auth) {
+		assert.Equal(t, "alice", auth["username"])
+		assert.Equal(t, true, auth["isAdmin"])
+		assert.NotEmpty(t, auth["token"])
+		assert.NotEmpty(t, auth["subsonicToken"])
+	}
+	req.Header.Del("Remote-User")
+	assert.Nil(t, handleLoginFromHeaders(ds, req))
+}
+
+func TestIndexOnlyIncludesTrustedProxyAuth(t *testing.T) {
+	old := *conf.Server
+	defer func() { *conf.Server = old }()
+	conf.Server.ReverseProxyWhitelist = "@"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{}
+	req := httptest.NewRequest("GET", "/app/", nil)
+	req.Header.Set("Remote-User", "alice")
+	req.RemoteAddr = "127.0.0.1:5000"
+	resp := httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(resp, req)
+	assert.NotContains(t, extractAppConfig(resp.Body.String()), "auth")
+	req.RemoteAddr = "@"
+	resp = httptest.NewRecorder()
+	serveIndex(ds, os.DirFS("tests/fixtures"))(resp, req)
+	assert.Contains(t, extractAppConfig(resp.Body.String()), "auth")
+}
