+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		redacted := reflect.MakeMap(v.Type())
+		var widened map[interface{}]interface{}
+		for _, key := range v.MapKeys() {
+			var replacement interface{}
+			if re.MatchString(fmt.Sprint(key.Interface())) {
+				replacement = "[REDACTED]"
+			} else {
+				replacement = redactValue(v.MapIndex(key).Interface(), re)
+			}
+			rv := reflect.ValueOf(replacement)
+			if !rv.IsValid() {
+				rv = reflect.Zero(v.Type().Elem())
+			} else if !rv.Type().AssignableTo(v.Type().Elem()) {
+				if rv.Type().ConvertibleTo(v.Type().Elem()) {
+					rv = rv.Convert(v.Type().Elem())
+				} else {
+					if widened == nil {
+						widened = make(map[interface{}]interface{}, v.Len())
+					}
+					widened[key.Interface()] = replacement
+					continue
+				}
+			}
+			redacted.SetMapIndex(key, rv)
+		}
+		if widened != nil {
+			for _, key := range redacted.MapKeys() {
+				widened[key.Interface()] = redacted.MapIndex(key).Interface()
+			}
+			return widened
+		}
+		return redacted.Interface()
+	}
+	if s, ok := value.(string); ok {
+		return re.ReplaceAllString(s, "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprint(value), "$1[REDACTED]$2")
+}
