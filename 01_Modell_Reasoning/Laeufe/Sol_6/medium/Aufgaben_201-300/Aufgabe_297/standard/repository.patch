+// validateIPAgainstList checks the actual connection peer, never a forwarded header.
+// A bare IP is treated as a single-host range. @ denotes a Unix socket.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	host := remoteAddr
+	if parsed, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		host = parsed
+	}
+	ip := net.ParseIP(strings.Trim(host, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil {
+			if network.Contains(ip) {
+				return true
+			}
+		} else if allowed := net.ParseIP(entry); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// handleLoginFromHeaders returns a session only for a trusted peer and a named user.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" {
+		return nil
+	}
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for proxy login", countErr)
+			return nil
+		}
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: strings.Title(username),
+			IsAdmin: count == 0, NewPassword: uuid.NewString()}
+		if err = userRepo.Put(user); err != nil {
+			log.Error(r, "Creating proxy user", err)
+			return nil
+		}
+	} else if err != nil || user == nil {
+		log.Error(r, "Finding proxy user", err)
+		return nil
+	}
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating proxy token", err)
+		return nil
+	}
+	if err := userRepo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating proxy login time", err)
+	}
+	salt := uuid.NewString()[:6]
+	password := user.Password
+	if password == "" {
+		password = user.NewPassword
+	}
+	payload := map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token, "subsonicSalt": salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(password+salt))),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
