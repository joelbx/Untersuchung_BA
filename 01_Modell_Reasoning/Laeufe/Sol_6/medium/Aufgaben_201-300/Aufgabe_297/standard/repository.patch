@@ -0,0 +1,26 @@
+test('stores a trusted proxy session from the page configuration', () => {
+  const previous = window.__APP_CONFIG__
+  window.__APP_CONFIG__ = JSON.stringify({
+    auth: {
+      id: 'user-1',
+      name: 'Alice',
+      username: 'alice',
+      isAdmin: true,
+      token: 'jwt',
+      subsonicSalt: 'salt',
+      subsonicToken: 'subsonic',
+    },
+  })
+  try {
+    jest.isolateModules(() => require('./config'))
+    expect(localStorage.getItem('token')).toBe('jwt')
+    expect(localStorage.getItem('userId')).toBe('user-1')
+    expect(localStorage.getItem('name')).toBe('Alice')
+    expect(localStorage.getItem('username')).toBe('alice')
+    expect(localStorage.getItem('role')).toBe('admin')
+    expect(localStorage.getItem('subsonic-salt')).toBe('salt')
+    expect(localStorage.getItem('subsonic-token')).toBe('subsonic')
+  } finally {
+    window.__APP_CONFIG__ = previous
+  }
+})
