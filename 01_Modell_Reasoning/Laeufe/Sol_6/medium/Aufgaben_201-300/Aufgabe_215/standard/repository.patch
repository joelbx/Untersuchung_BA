+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "flipt.yml")
+	if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("unexpected scheme names")
+	}
+
+	cfg, err := configure(writeConfig(t, "# defaults\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults differ: %#v", cfg)
+	}
+
+	cert := filepath.Join(t.TempDir(), "cert.pem")
+	key := filepath.Join(t.TempDir(), "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := os.WriteFile(path, []byte("present"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := writeConfig(t, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: "+cert+"\n  cert_key: "+key+"\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) || !cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server != (serverConfig{"127.0.0.1", HTTPS, 8081, 8080, 9001, cert, key}) || cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("advanced config differs: %#v", cfg)
+	}
+
+	listPath := writeConfig(t, "cors:\n  allowed_origins: [foo.com]\n")
+	listCfg, err := configure(listPath)
+	if err != nil || !reflect.DeepEqual(listCfg.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("list origins: %#v, %v", listCfg, err)
+	}
+
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8082")
+	t.Setenv("FLIPT_UI_ENABLED", "false")
+	envCfg, err := configure(writeConfig(t, "server:\n  http_port: 8081\n"))
+	if err != nil || envCfg.Server.HTTPPort != 8082 || envCfg.UI.Enabled {
+		t.Fatalf("environment overrides: %#v, %v", envCfg, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	checks := []struct {
+		cert, key, want string
+	}{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{"missing-cert", "", "cert_key cannot be empty when using HTTPS"},
+		{"missing-cert", "missing-key", "cannot find TLS cert_file at \"missing-cert\""},
+	}
+	for _, check := range checks {
+		cfg.Server.CertFile, cfg.Server.CertKey = check.cert, check.key
+		if err := cfg.validate(); err == nil || err.Error() != check.want {
+			t.Fatalf("validate(%q, %q) = %v; want %q", check.cert, check.key, err, check.want)
+		}
+	}
+	cert := filepath.Join(t.TempDir(), "cert.pem")
+	if err := os.WriteFile(cert, []byte("present"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Server.CertFile = cert
+	if err := cfg.validate(); err == nil || err.Error() != "cannot find TLS cert_key at \"missing-key\"" {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatalf("HTTP validation: %v", err)
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []http.Handler{defaultConfig(), info{Version: "test"}} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/", nil))
+		if recorder.Code != http.StatusOK || !strings.HasPrefix(recorder.Body.String(), "{") {
+			t.Fatalf("response: %d %q", recorder.Code, recorder.Body.String())
+		}
+	}
+}
