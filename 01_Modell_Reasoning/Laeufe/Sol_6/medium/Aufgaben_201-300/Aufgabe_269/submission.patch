--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,76 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySources(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	vulnerability := trivydbTypes.Vulnerability{
+		Title: "title", Description: "summary", Severity: "LOW",
+		VendorSeverity: trivydbTypes.VendorSeverity{
+			"debian": trivydbTypes.SeverityLow,
+			"ubuntu": trivydbTypes.SeverityMedium,
+		},
+		CVSS: trivydbTypes.VendorCVSS{
+			"debian": {V2Score: 3.5, V2Vector: "AV:N", V3Score: 4.1, V3Vector: "CVSS:3.1/debian"},
+			"nvd":    {V3Score: 7.5, V3Vector: "CVSS:3.1/nvd"},
+		},
+		References: []string{"https://example.org/advisory"}, PublishedDate: &published, LastModifiedDate: &modified,
+	}
+	results := types.Results{
+		{Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-2024-0001", Vulnerability: vulnerability}}},
+		{Vulnerabilities: []types.DetectedVulnerability{{VulnerabilityID: "CVE-2024-0001", Vulnerability: vulnerability}}},
+	}
+	result, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-2024-0001"].CveContents
+	for source, severity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyNVD: "",
+	} {
+		if len(contents[source]) == 0 || contents[source][0].Cvss3Severity != severity {
+			t.Errorf("%s severity: %#v", source, contents[source])
+			continue
+		}
+		content := contents[source][0]
+		if content.Type != source || content.CveID != "CVE-2024-0001" || content.Title != "title" || content.Summary != "summary" ||
+			!content.Published.Equal(published) || !content.LastModified.Equal(modified) || len(content.References) != 1 {
+			t.Errorf("%s metadata: %#v", source, content)
+		}
+	}
+	if contents[models.TrivyDebian][0].Cvss2Score != 3.5 || contents[models.TrivyDebian][0].Cvss3Score != 4.1 ||
+		contents[models.TrivyNVD][0].Cvss3Score != 7.5 {
+		t.Errorf("source scores: %#v", contents)
+	}
+	info := result.ScannedCves["CVE-2024-0001"]
+	if len(info.Titles("en", "debian")) == 0 || len(info.Summaries("en", "debian")) == 0 {
+		t.Fatal("Trivy titles or summaries were omitted")
+	}
+	scores2, scores3 := info.Cvss2Scores(), info.Cvss3Scores()
+	foundDebianV2, foundDebianV3, foundUbuntu := false, false, false
+	for _, score := range scores2 {
+		if score.Type == models.TrivyDebian && score.Value.Score == 3.5 {
+			foundDebianV2 = true
+		}
+	}
+	for _, score := range scores3 {
+		switch score.Type {
+		case models.TrivyDebian:
+			foundDebianV3 = score.Value.Score == 4.1
+		case models.TrivyUbuntu:
+			foundUbuntu = score.Value.Severity == "MEDIUM"
+		}
+	}
+	if !foundDebianV2 || !foundDebianV3 || !foundUbuntu {
+		t.Errorf("aggregated scores: v2=%#v v3=%#v", scores2, scores3)
+	}
+}
