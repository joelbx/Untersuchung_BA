+@pytest.mark.parametrize('query', ['foo OR bar', '(foo)', 'NOT foo'])
+def test_luqum_replace_child(query: str):
+    parent = luqum_parser(query)
+    original_children = parent.children
+    replacement = luqum_parser('baz')
+
+    assert luqum_replace_child(parent, original_children[0], replacement) is None
+    assert isinstance(parent.children, type(original_children))
+    assert list(parent.children) == [replacement, *original_children[1:]]
+
+    unchanged_children = parent.children
+    luqum_replace_child(parent, luqum_parser('missing'), luqum_parser('other'))
+    assert parent.children == unchanged_children
+
+
+def test_luqum_replace_child_replaces_all_matching_children():
+    parent = luqum_parser('foo OR bar')
+    old_child = parent.children[0]
+    parent.children = (old_child, old_child)
+    new_child = luqum_parser('baz')
+
+    luqum_replace_child(parent, old_child, new_child)
+
+    assert parent.children == (new_child, new_child)
+
+
+def test_luqum_replace_child_rejects_unsupported_parent():
+    with pytest.raises(ValueError, match='^Not supported for generic class Item$'):
+        luqum_replace_child(
+            luqum_parser('foo'), luqum_parser('foo'), luqum_parser('bar')
+        )
+
