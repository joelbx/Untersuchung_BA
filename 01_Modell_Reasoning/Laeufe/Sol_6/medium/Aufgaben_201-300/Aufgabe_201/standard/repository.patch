-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ Segment IsSegment }
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil {
+		return nil, fmt.Errorf("segment is missing")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, fmt.Errorf("segment key is empty")
+		}
+		return string(v), nil
+	case Segments:
+		_, operator, err := s.KeysAndOperator()
+		if err != nil {
+			return nil, err
+		}
+		v.SegmentOperator = operator
+		return v, nil
+	default:
+		return nil, fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		s.Segment = SegmentKey(v)
+	case map[interface{}]interface{}:
+		for k := range v {
+			if k != "keys" && k != "operator" {
+				return fmt.Errorf("invalid segment field %v", k)
+			}
+		}
+		var group Segments
+		if err := unmarshal(&group); err != nil {
+			return err
+		}
+		if len(group.Keys) == 1 {
+			group.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		s.Segment = group
+	case map[string]interface{}:
+		for k := range v {
+			if k != "keys" && k != "operator" {
+				return fmt.Errorf("invalid segment field %v", k)
+			}
+		}
+		var group Segments
+		if err := unmarshal(&group); err != nil {
+			return err
+		}
+		if len(group.Keys) == 1 {
+			group.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		s.Segment = group
+	default:
+		return fmt.Errorf("invalid segment format %T", raw)
+	}
+	_, _, err := s.KeysAndOperator()
+	return err
+}
+
+func (s *SegmentEmbed) KeysAndOperator() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("segment is missing")
+	}
+	var keys []string
+	operator := "OR_SEGMENT_OPERATOR"
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		keys = []string{string(v)}
+	case Segments:
+		keys = v.Keys
+		if len(keys) > 1 {
+			operator = v.SegmentOperator
+		}
+	default:
+		return nil, "", fmt.Errorf("invalid segment type %T", s.Segment)
+	}
+	if len(keys) == 0 {
+		return nil, "", fmt.Errorf("segment requires keys")
+	}
+	for _, key := range keys {
+		if key == "" {
+			return nil, "", fmt.Errorf("segment key is empty")
+		}
+	}
+	if operator != "OR_SEGMENT_OPERATOR" && operator != "AND_SEGMENT_OPERATOR" {
+		return nil, "", fmt.Errorf("invalid segment operator %q", operator)
+	}
+	return keys, operator, nil
 }
 
