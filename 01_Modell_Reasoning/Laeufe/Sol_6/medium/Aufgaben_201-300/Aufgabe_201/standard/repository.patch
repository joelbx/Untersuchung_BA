@@ -0,0 +1,48 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestSegmentEmbedYAML(t *testing.T) {
+	for _, tc := range []struct {
+		name, input, operator string
+		keys                  []string
+	}{
+		{"string", "segment: foo", "OR_SEGMENT_OPERATOR", []string{"foo"}},
+		{"object", "segment: {keys: [foo, bar], operator: AND_SEGMENT_OPERATOR}", "AND_SEGMENT_OPERATOR", []string{"foo", "bar"}},
+		{"single object", "segment: {keys: [foo], operator: AND_SEGMENT_OPERATOR}", "OR_SEGMENT_OPERATOR", []string{"foo"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var rule Rule
+			require.NoError(t, yaml.UnmarshalStrict([]byte(tc.input), &rule))
+			keys, operator, err := rule.Segment.KeysAndOperator()
+			require.NoError(t, err)
+			assert.Equal(t, tc.keys, keys)
+			assert.Equal(t, tc.operator, operator)
+			_, err = yaml.Marshal(&rule)
+			require.NoError(t, err)
+			var v3rule Rule
+			require.NoError(t, yamlv3.Unmarshal([]byte(tc.input), &v3rule))
+			v3keys, v3operator, err := v3rule.Segment.KeysAndOperator()
+			require.NoError(t, err)
+			assert.Equal(t, tc.keys, v3keys)
+			assert.Equal(t, tc.operator, v3operator)
+		})
+	}
+	for _, input := range []string{
+		"segment: []", "segment: {}", "segment: ''", "segment: {keys: []}",
+		"segment: {keys: [foo, bar]}", "segment: {keys: [foo, bar], operator: BAD}",
+		"segment: {key: foo}",
+	} {
+		t.Run(input, func(t *testing.T) {
+			var rule Rule
+			assert.Error(t, yaml.Unmarshal([]byte(input), &rule))
+		})
+	}
+}
