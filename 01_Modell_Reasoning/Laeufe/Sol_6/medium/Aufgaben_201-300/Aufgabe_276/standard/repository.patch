+func TestLoadAuthenticationRequiredFields(t *testing.T) {
+	github := `authentication:
+  session:
+    domain: localhost
+  methods:
+    github:
+      enabled: true
+      client_id: id
+      client_secret: secret
+      redirect_address: http://localhost/callback
+`
+	oidc := `authentication:
+  session:
+    domain: localhost
+  methods:
+    oidc:
+      enabled: true
+      providers:
+        bar:
+          client_id: id
+          client_secret: secret
+          redirect_address: http://localhost/callback
+        foo:
+          client_id: id
+          client_secret: secret
+          redirect_address: http://localhost/callback
+`
+
+	tests := []struct {
+		name, config, remove, provider, field string
+	}{
+		{"github client_id", github, "      client_id: id\n", "github", "client_id"},
+		{"github client_secret", github, "      client_secret: secret\n", "github", "client_secret"},
+		{"github redirect_address", github, "      redirect_address: http://localhost/callback\n", "github", "redirect_address"},
+		{"github blank client_id", github, "      client_id: id\n", "github", "client_id"},
+		{"oidc client_id", oidc, "          client_id: id\n", "foo", "client_id"},
+		{"oidc client_secret", oidc, "          client_secret: secret\n", "foo", "client_secret"},
+		{"oidc redirect_address", oidc, "          redirect_address: http://localhost/callback\n", "foo", "redirect_address"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			config := tt.config
+			if tt.provider == "foo" {
+				// Modify only foo; bar remains valid to check the provider key in the error.
+				prefix, foo, _ := strings.Cut(config, "        foo:\n")
+				config = prefix + "        foo:\n" + strings.Replace(foo, tt.remove, "", 1)
+			} else if tt.name == "github blank client_id" {
+				config = strings.Replace(config, tt.remove, "      client_id: '   '\n", 1)
+			} else {
+				config = strings.Replace(config, tt.remove, "", 1)
+			}
+
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(config), 0600))
+			_, err := Load(path)
+			require.EqualError(t, err, fmt.Sprintf("provider %q: field %q: non-empty value is required", tt.provider, tt.field))
+		})
+	}
+}
