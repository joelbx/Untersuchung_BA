@@ -0,0 +1,75 @@
+package config
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  ScanTechnique
+	}{
+		{"ss", TCPSYN}, {"ST", TCPConnect}, {"sa", TCPACK}, {"sw", TCPWindow},
+		{"SM", TCPMaimon}, {"sn", TCPNull}, {"SF", TCPFIN}, {"sx", TCPXmas},
+		{"unknown", NotSupportTechnique},
+	} {
+		conf := PortScanConf{ScanTechniques: []string{tc.input}}
+		got := conf.GetScanTechniques()
+		if len(got) != 1 || got[0] != tc.want {
+			t.Errorf("%q: got %v, want %v", tc.input, got, tc.want)
+		}
+	}
+	conf := PortScanConf{}
+	if len(conf.GetScanTechniques()) != 0 || !conf.IsZero() {
+		t.Fatal("empty configuration should have no techniques and be zero")
+	}
+	conf.HasPrivileged = true
+	if conf.IsZero() {
+		t.Fatal("hasPrivileged must affect IsZero")
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	file, err := os.CreateTemp(t.TempDir(), "nmap")
+	if err != nil {
+		t.Fatal(err)
+	}
+	file.Close()
+	if err := os.Chmod(file.Name(), 0755); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"connect", PortScanConf{ScannerBinPath: file.Name(), ScanTechniques: []string{"sT"}}, ""},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unknown", PortScanConf{ScannerBinPath: file.Name(), ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: file.Name(), ScanTechniques: []string{"sT", "sT"}}, "multiple"},
+		{"privilege", PortScanConf{ScannerBinPath: file.Name(), ScanTechniques: []string{"sS"}}, "hasPrivileged"},
+		{"source and connect", PortScanConf{ScannerBinPath: file.Name(), ScanTechniques: []string{"sT"}, SourcePort: "443"}, "sourcePort"},
+		{"out of range", PortScanConf{ScannerBinPath: file.Name(), SourcePort: "65536"}, "sourcePort"},
+		{"zero port", PortScanConf{ScannerBinPath: file.Name(), SourcePort: "0"}, "sourcePort"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			if tc.want == "" && len(errs) != 0 {
+				t.Fatalf("unexpected errors: %v", errs)
+			}
+			if tc.want != "" && !strings.Contains(strings.ToLower(strings.TrimSpace(joinErrors(errs))), strings.ToLower(tc.want)) {
+				t.Fatalf("expected %q in %v", tc.want, errs)
+			}
+		})
+	}
+}
+
+func joinErrors(errs []error) string {
+	var messages []string
+	for _, err := range errs {
+		messages = append(messages, err.Error())
+	}
+	return strings.Join(messages, " ")
+}
