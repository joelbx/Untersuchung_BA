diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..557d8f8
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,101 @@
+package scanner
+
+import (
+	"context"
+	"encoding/xml"
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := []string{}
+	for _, technique := range techniques {
+		if technique.String() == "" {
+			return nil, fmt.Errorf("unsupported scan technique: %v", technique)
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+type nmapRun struct {
+	Hosts []struct {
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(destinations map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil {
+		return nil, fmt.Errorf("external port scanner is not configured")
+	}
+	if errs := conf.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniques, err := setScanTechniques(conf.GetScanTechniques())
+	if err != nil {
+		return nil, err
+	}
+	if len(techniques) == 0 {
+		if conf.HasPrivileged {
+			techniques = []string{"-sS"}
+		} else {
+			techniques = []string{"-sT"}
+		}
+	}
+	ips := make([]string, 0, len(destinations))
+	for ip := range destinations {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	open := []string{}
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := destinations[ip]
+		if len(ports) == 0 {
+			continue
+		}
+		args := append([]string{}, techniques...)
+		args = append(args, "-Pn", "-n", "-oX", "-", "-p", strings.Join(ports, ","))
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, "--", ip)
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+		out, err := osExec.CommandContext(ctx, conf.ScannerBinPath, args...).CombinedOutput()
+		cancel()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed: %w: %s", ip, err, strings.TrimSpace(string(out)))
+		}
+		var result nmapRun
+		if err := xml.Unmarshal(out, &result); err != nil {
+			return nil, fmt.Errorf("invalid nmap XML for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.State == "open" {
+					open = append(open, net.JoinHostPort(ip, port.PortID))
+				}
+			}
+		}
+	}
+	return open, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..36da71e
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,40 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScan(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	script := `#!/bin/sh
+printf '%s\n' '<nmaprun><host><ports><port protocol="tcp" portid="443"><state state="open"/></port><port protocol="tcp" portid="80"><state state="closed"/></port></ports></host></nmaprun>'
+`
+	if err := os.WriteFile(path, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{Host: "example.org", Port: "22", PortScan: &config.PortScanConf{
+		ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true,
+	}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"80", "443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.1:443"}) {
+		t.Fatalf("open ports = %v", got)
+	}
+}
+
+func TestSetScanTechniques(t *testing.T) {
+	options, err := setScanTechniques([]config.ScanTechnique{config.TCPSYN})
+	if err != nil || !reflect.DeepEqual(options, []string{"-sS"}) {
+		t.Fatalf("options = %v, error = %v", options, err)
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.NotSupportTechnique}); err == nil {
+		t.Fatal("unsupported technique accepted")
+	}
+}
