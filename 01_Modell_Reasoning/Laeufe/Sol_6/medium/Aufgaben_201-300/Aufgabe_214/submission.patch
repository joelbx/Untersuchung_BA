new file mode 100644
index 0000000..6d66c81
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,139 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan type.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (t ScanTechnique) String() string {
+	switch t {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures a scanner running on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (techniques []ScanTechnique) {
+	for _, input := range c.ScanTechniques {
+		match := NotSupportTechnique
+		for _, technique := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(input, technique.String()) {
+				match = technique
+				break
+			}
+		}
+		techniques = append(techniques, match)
+	}
+	return techniques
+}
+
+// Validate reports invalid external scanner settings before a scan starts.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() && !c.IsUseExternalScanner {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath: %w", err))
+	} else if info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan scannerBinPath is not executable: %s", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan multiple scan techniques are not supported"))
+	}
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan unsupported scan technique: %q", c.ScanTechniques[i]))
+		} else if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan %s requires hasPrivileged", technique))
+		}
+		if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("portscan sourcePort cannot be used with TCPConnect"))
+		}
+	}
+	if c.SourcePort != "" {
+		if len(techniques) == 0 && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan sourcePort cannot be used with TCPConnect"))
+		}
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort must be an integer in [0,65535]: %q", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan sourcePort 0 is not usable"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		out, err := exec.Command("getcap", c.ScannerBinPath).Output()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan capability check failed: %w", err))
+		} else if !hasScannerCapabilities(string(out)) {
+			errs = append(errs, fmt.Errorf("portscan missing or malformed scanner capabilities: %s", strings.TrimSpace(string(out))))
+		}
+	}
+	return errs
+}
+
+func hasScannerCapabilities(output string) bool {
+	fields := strings.Fields(output)
+	if len(fields) != 2 || !strings.HasPrefix(fields[1], "cap_") {
+		return false
+	}
+	parts := strings.Split(fields[1], "=")
+	if len(parts) != 2 || !strings.Contains(parts[1], "e") {
+		return false
+	}
+	caps := strings.Split(parts[0], ",")
+	found := map[string]bool{}
+	for _, cap := range caps {
+		found[cap] = true
+	}
+	return found["cap_net_raw"] && found["cap_net_admin"]
+}
