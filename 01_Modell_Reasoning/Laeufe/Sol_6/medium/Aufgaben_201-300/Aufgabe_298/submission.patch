+// evictExpired limits full scans during ordinary reads and writes. Inserts can
+// bring the deadline forward when their TTL ends before the next scan.
+func (c *simpleCache[K, V]) evictExpired() {
+	now := time.Now()
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && now.Before(*deadline) {
+			return
+		}
+		next := now.Add(10 * time.Millisecond)
+		if c.evictionDeadline.CompareAndSwap(deadline, &next) {
+			c.data.DeleteExpired()
+			c.data.Range(func(item *ttlcache.Item[K, V]) bool {
+				c.scheduleEviction(item)
+				return true
+			})
+			return
+		}
+	}
+}
+
+func (c *simpleCache[K, V]) scheduleEviction(item *ttlcache.Item[K, V]) {
+	if item.TTL() <= 0 {
+		return
+	}
+	expires := item.ExpiresAt()
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && !expires.Before(*deadline) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(deadline, &expires) {
+			return
+		}
+	}
 }
 
