diff --git a/utils/cache/simple_cache_test.go b/utils/cache/simple_cache_test.go
index 3b25d30..80878da 100644
--- a/utils/cache/simple_cache_test.go
+++ b/utils/cache/simple_cache_test.go
@@ -84,6 +84,52 @@ var _ = Describe("SimpleCache", func() {
 		})
 	})
 
+	It("returns only active keys and values after a short TTL", func() {
+		Expect(cache.AddWithTTL("short", "short=value", 10*time.Millisecond)).To(Succeed())
+		Expect(cache.Add("active", "active=value")).To(Succeed())
+		Expect(cache.Keys()).To(ConsistOf("short", "active"))
+		Expect(cache.Values()).To(ConsistOf("short=value", "active=value"))
+
+		time.Sleep(50 * time.Millisecond)
+
+		Expect(cache.Keys()).To(ConsistOf("active"))
+		Expect(cache.Values()).To(ConsistOf("active=value"))
+		_, err := cache.Get("short")
+		Expect(err).To(HaveOccurred())
+	})
+
+	It("evicts expired entries when another key is accessed", func() {
+		c := NewSimpleCache[string, string]().(*simpleCache[string, string])
+		Expect(c.AddWithTTL("short", "short=value", 10*time.Millisecond)).To(Succeed())
+		Expect(c.Add("active", "active=value")).To(Succeed())
+		time.Sleep(50 * time.Millisecond)
+
+		value, err := c.Get("active")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("active=value"))
+		Expect(c.data.Len()).To(Equal(1))
+	})
+
+	It("loads missing keys with their own TTL and excludes them after expiry", func() {
+		loader := func(key string) (string, time.Duration, error) {
+			return key + "=value", 10 * time.Millisecond, nil
+		}
+		value, err := cache.GetWithLoader("loaded", loader)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("loaded=value"))
+		value, err = cache.GetWithLoader("loaded", func(string) (string, time.Duration, error) {
+			return "wrong", time.Hour, nil
+		})
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("loaded=value"))
+
+		time.Sleep(50 * time.Millisecond)
+		Expect(cache.Keys()).To(BeEmpty())
+		Expect(cache.Values()).To(BeEmpty())
+		_, err = cache.Get("loaded")
+		Expect(err).To(HaveOccurred())
+	})
+
