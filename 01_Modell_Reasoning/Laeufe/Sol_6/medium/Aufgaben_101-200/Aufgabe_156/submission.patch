+    def test_value_only_redaction(self):
+        value = {'secret': 'secret and secret', 'nested': [{'password': b'caf\xc3\xa9 secret'}],
+                 'number': 1234, 'flag': True, 'date': __import__('datetime').date(2020, 1, 1)}
+        result = remove_values(value, iter((b'secret', u'caf\xe9')))
+        self.assertEqual(result, {'secret': '******** and ********',
+                                  'nested': [{'password': b'******** ********'}],
+                                  'number': 1234, 'flag': True,
+                                  'date': __import__('datetime').date(2020, 1, 1)})
+        self.assertIsNot(result, value)
+
+    def test_container_types_and_scalars(self):
+        from collections import OrderedDict, UserDict, defaultdict
+        value = OrderedDict([('key', ('secret', frozenset(['secret'])))])
+        result = remove_values(value, ['secret'])
+        self.assertIsInstance(result, OrderedDict)
+        self.assertIsInstance(result['key'], tuple)
+        self.assertIsInstance(result['key'][1], frozenset)
+        self.assertEqual(result['key'], ('********', frozenset(['********'])))
+        for scalar in (1, False, None, __import__('datetime').datetime(2020, 1, 1)):
+            self.assertIs(remove_values(scalar, ['1']), scalar)
+
+        wrapped = UserDict({'secret': 'secret'})
+        self.assertEqual(remove_values(wrapped, ['secret']), {'secret': '********'})
+        self.assertEqual(wrapped['secret'], 'secret')
+        defaulted = defaultdict(list, {'secret': 'secret'})
+        redacted = remove_values(defaulted, ['secret'])
+        self.assertIs(redacted.default_factory, list)
+        self.assertEqual(redacted['secret'], '********')
+
+    def test_deep_structure(self):
+        value = []
+        inner = value
+        for _ in range(10000):
+            child = []
+            inner.append(child)
+            inner = child
+        inner.append('secret')
+        result = remove_values(value, ['secret'])
+        for _ in range(10000):
+            result = result[0]
+        self.assertEqual(result, ['********'])
+
