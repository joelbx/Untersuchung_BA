+class TestSanitizeKeys(unittest.TestCase):
+    def test_nested_keys_and_ignore(self):
+        value = {'password': 'password', 'my-password-end': 1,
+                 'changed': {'status': [{'password': 2, '_ansible_password': 3,
+                                        'ignored-password': 4}]}}
+        result = sanitize_keys(value, iter((b'password', 'changed', 'status')),
+                               frozenset(('changed', 'status', 'ignored-password')))
+        self.assertEqual(result, {
+            'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 'password',
+            'my-********-end': 1,
+            'changed': {'status': [{'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 2,
+                                    '_ansible_password': 3, 'ignored-password': 4}]}})
+        self.assertEqual(value['password'], 'password')
+
+    def test_other_containers_and_scalars(self):
+        import datetime
+        for value in ('password', b'password', 1, False, None, datetime.date.today()):
+            self.assertIs(sanitize_keys(value, ['password']), value)
+        value = ({'password': 1}, frozenset(['password']), {'password'})
+        result = sanitize_keys(value, ['password'])
+        self.assertIsInstance(result, tuple)
+        self.assertEqual(result[0], {'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 1})
+        self.assertEqual(result[1:], value[1:])
+
+    def test_deep_structure(self):
+        value = []
+        inner = value
+        for _ in range(10000):
+            child = []
+            inner.append(child)
+            inner = child
+        inner.append({'password': 1})
+        result = sanitize_keys(value, ['password'])
+        for _ in range(10000):
+            result = result[0]
+        self.assertEqual(result, [{'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER': 1}])
