+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_pip_uses_current_interpreter(mocker):
+    module = mocker.Mock()
+    mocker.patch('ansible.modules.pip._have_pip_module', return_value=True)
+
+    assert pip._get_pip(module) == [sys.executable, '-m', 'pip']
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{'name': 'six'}], indirect=True)
+def test_main_uses_pip_module_without_binary(mocker, capfd):
+    mocker.patch('ansible.modules.pip._have_pip_module', return_value=True)
+    get_bin_path = mocker.patch('ansible.module_utils.basic.AnsibleModule.get_bin_path', return_value=None)
+    run_command = mocker.patch('ansible.module_utils.basic.AnsibleModule.run_command',
+                               return_value=(0, 'Successfully installed six', ''))
+
+    with pytest.raises(SystemExit):
+        pip.main()
+
+    result = json.loads(capfd.readouterr()[0])
+    assert result['cmd'] == [sys.executable, '-m', 'pip', 'install', 'six']
+    assert result['changed'] is True
+    assert run_command.call_args[0][0] == result['cmd']
+    get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_pip_explicit_executable(mocker):
+    module = mocker.Mock()
+
+    assert pip._get_pip(module, executable='/usr/bin/pip3') == ['/usr/bin/pip3']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_get_packages_falls_back_to_freeze(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(1, '', 'unsupported option'), (0, 'six==1.0\n', '')]
+    mocker.patch('ansible.modules.pip.get_best_parsable_locale', return_value='C')
+
+    command, out, err = pip._get_packages(module, ['/usr/bin/python', '-m', 'pip'], '/tmp')
+
+    assert command == '/usr/bin/python -m pip freeze'
+    assert (out, err) == ('six==1.0\n', '')
+    assert module.run_command.call_args_list[0][0][0] == ['/usr/bin/python', '-m', 'pip', 'list', '--format=freeze']
+    assert module.run_command.call_args_list[1][0][0] == ['/usr/bin/python', '-m', 'pip', 'freeze']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=True)
+def test_have_pip_module_detection_error(mocker):
+    mocker.patch('importlib.util.find_spec', side_effect=RuntimeError('broken import'))
+    assert pip._have_pip_module() is False
+
