+def _have_pip_module():
+    """Check whether pip is available to the interpreter running this module."""
+    try:
+        try:
+            from importlib.util import find_spec
+        except ImportError:
+            import imp
+            found, _, _ = imp.find_module('pip')
+            if found is not None:
+                found.close()
+            return True
+        return find_spec('pip') is not None
+    except Exception:
+        return False
+
