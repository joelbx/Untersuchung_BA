@@ -0,0 +1,46 @@
+package ext
+
+import (
+	"fmt"
+
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/rego"
+	"github.com/open-policy-agent/opa/types"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func init() {
+	rego.RegisterBuiltin2(&rego.Function{
+		Name: "flipt.is_auth_method",
+		Decl: types.NewFunction(types.Args(types.NewObject(nil, types.NewDynamicProperty(types.S, types.A)), types.S), types.B),
+	}, isAuthMethod)
+}
+
+func isAuthMethod(_ rego.BuiltinContext, input, key *ast.Term) (*ast.Term, error) {
+	authentication := input.Get(ast.StringTerm("authentication"))
+	if authentication == nil {
+		return nil, fmt.Errorf("no authentication found")
+	}
+
+	method := string(key.Value.(ast.String))
+	var expected auth.Method
+	switch method {
+	case "token":
+		expected = auth.Method_METHOD_TOKEN
+	case "oidc":
+		expected = auth.Method_METHOD_OIDC
+	case "kubernetes", "k8s":
+		expected = auth.Method_METHOD_KUBERNETES
+	case "github":
+		expected = auth.Method_METHOD_GITHUB
+	case "jwt":
+		expected = auth.Method_METHOD_JWT
+	case "cloud":
+		expected = auth.Method_METHOD_CLOUD
+	default:
+		return nil, fmt.Errorf("unsupported auth method: %s", method)
+	}
+
+	actual := authentication.Get(ast.StringTerm("method"))
+	return ast.BooleanTerm(actual != nil && actual.Equal(ast.IntNumberTerm(int(expected)))), nil
+}
diff --git a/internal/server/authz/engine/ext/extentions_test.go b/internal/server/authz/engine/ext/extentions_test.go
new file mode 100644
index 0000000..2f17647
--- /dev/null
+++ b/internal/server/authz/engine/ext/extentions_test.go
@@ -0,0 +1,56 @@
+package ext
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/rego"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestIsAuthMethod(t *testing.T) {
+	methods := []struct {
+		name string
+		code auth.Method
+	}{
+		{"token", auth.Method_METHOD_TOKEN},
+		{"oidc", auth.Method_METHOD_OIDC},
+		{"kubernetes", auth.Method_METHOD_KUBERNETES},
+		{"k8s", auth.Method_METHOD_KUBERNETES},
+		{"github", auth.Method_METHOD_GITHUB},
+		{"jwt", auth.Method_METHOD_JWT},
+		{"cloud", auth.Method_METHOD_CLOUD},
+	}
+
+	for _, method := range methods {
+		t.Run(method.name, func(t *testing.T) {
+			input := ast.MustParseTerm(fmt.Sprintf(`{"authentication": {"method": %d}}`, method.code))
+			result, err := isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm(method.name))
+			require.NoError(t, err)
+			require.Equal(t, ast.BooleanTerm(true), result)
+
+			input = ast.MustParseTerm(`{"authentication": {"method": 0}}`)
+			result, err = isAuthMethod(rego.BuiltinContext{}, input, ast.StringTerm(method.name))
+			require.NoError(t, err)
+			require.Equal(t, ast.BooleanTerm(false), result)
+		})
+	}
+
+	_, err := isAuthMethod(rego.BuiltinContext{}, ast.MustParseTerm(`{}`), ast.StringTerm("token"))
+	require.EqualError(t, err, "no authentication found")
+
+	_, err = isAuthMethod(rego.BuiltinContext{}, ast.MustParseTerm(`{"authentication": {"method": 1}}`), ast.StringTerm("unknown"))
+	require.EqualError(t, err, "unsupported auth method: unknown")
+}
+
+func TestIsAuthMethodRegistered(t *testing.T) {
+	query := rego.New(rego.Query(`flipt.is_auth_method(input, "k8s")`), rego.Input(map[string]any{
+		"authentication": map[string]any{"method": int(auth.Method_METHOD_KUBERNETES)},
+	}))
+	result, err := query.Eval(context.Background())
+	require.NoError(t, err)
+	require.Len(t, result, 1)
+}
