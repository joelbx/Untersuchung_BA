+func TestInterpolationValidation(t *testing.T) {
+	e, err := NewExpression(`{{regexp.replace(email.local(internal.mail), "(.*)", "$1")}}`)
+	require.NoError(t, err)
+	_, err = e.Interpolate(map[string][]string{"mail": {"a@b.com"}}, func(namespace, name string) error { return trace.BadParameter("unsupported variable %q", name) })
+	require.True(t, trace.IsBadParameter(err))
+	e, err = NewExpression("{{external.absent}}")
+	require.NoError(t, err)
+	_, err = e.Interpolate(nil)
+	require.True(t, trace.IsNotFound(err))
+	require.Contains(t, err.Error(), "external.absent")
+	e, err = NewExpression(`{{regexp.replace("abc", "z", "x")}}`)
+	require.NoError(t, err)
+	_, err = e.Interpolate(nil)
+	require.True(t, trace.IsNotFound(err))
+}
