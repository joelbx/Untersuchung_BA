+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+
+describe('optimistic mark-as bypass filter', () => {
+    const messages = [
+        { ID: 'message-one', ConversationID: 'conversation-one' },
+        { ID: 'message-two', ConversationID: 'conversation-two' },
+    ] as Element[];
+
+    it.each([
+        [true, ['conversation-one', 'conversation-two']],
+        [false, ['message-one', 'message-two']],
+    ])('adds and removes IDs in conversationMode %s', (conversationMode, ids) => {
+        let state = newState({ params: { filter: { Unread: 1 } } });
+        state = elementsReducer(
+            state,
+            optimisticMarkAs({ elements: messages, bypass: true, conversationMode, markAsStatus: MARK_AS_STATUS.READ })
+        );
+        expect(state.bypassFilter).toEqual(ids);
+
+        state = elementsReducer(
+            state,
+            optimisticMarkAs({ elements: messages, bypass: true, conversationMode, markAsStatus: MARK_AS_STATUS.READ })
+        );
+        expect(state.bypassFilter).toEqual(ids);
+
+        state = elementsReducer(
+            state,
+            optimisticMarkAs({
+                elements: [messages[0]],
+                bypass: true,
+                conversationMode,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(state.bypassFilter).toEqual([ids[1]]);
+    });
+
+    it('does not change bypass IDs without a mark-as status', () => {
+        const state = newState({ params: { filter: { Unread: 1 } } });
+        const updated = elementsReducer(state, optimisticMarkAs({ elements: messages, bypass: true }));
+        expect(updated.bypassFilter).toEqual([]);
+        expect(updated.elements['message-one']).toEqual(messages[0]);
+    });
+});
