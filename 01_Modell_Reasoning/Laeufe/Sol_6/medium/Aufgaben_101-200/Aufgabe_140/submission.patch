+@pytest.mark.parametrize('blocked_set', ['runtime', 'config'])
+def test_parent_domain_blocks_subdomains(config_stub, host_blocker_factory,
+                                         blocked_set):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = []
+    host_blocker = host_blocker_factory()
+    hosts = (host_blocker._blocked_hosts if blocked_set == 'runtime'
+             else host_blocker._config_blocked_hosts)
+    hosts.add('example.com')
+
+    for host in ['example.com', 'sub.example.com', 'a.b.example.com',
+                 'example.com.', 'a.b.example.com.']:
+        assert host_blocker._is_blocked(QUrl('https://' + host + '/path'))
+    assert not host_blocker._is_blocked(QUrl('https://notexample.com/path'))
+
+
+def test_subdomain_whitelist_overrides_parent(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = [
+        'https://allowed.example.com/*']
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add('example.com')
+
+    assert not host_blocker._is_blocked(QUrl('https://allowed.example.com/path'))
+    assert host_blocker._is_blocked(QUrl('https://other.example.com/path'))
+
+
+def test_trailing_dot_in_blocklist(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.method = 'hosts'
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.whitelist = []
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts |= host_blocker._read_hosts_line(b'example.com.')
+
+    assert host_blocker._is_blocked(QUrl('https://sub.example.com/path'))
+
+
