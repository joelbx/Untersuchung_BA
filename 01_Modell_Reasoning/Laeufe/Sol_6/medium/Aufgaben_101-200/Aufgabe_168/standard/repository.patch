+interface IAdminActionLock {
+    pending: Set<string>;
+    acquire(key: string): boolean;
+    release(key: string): void;
+}
+
+const AdminActionLockContext = React.createContext<IAdminActionLock | null>(null);
+
+function useAdminActionLock(): IAdminActionLock {
+    const [pending, setPending] = useState<Set<string>>(new Set());
+    const locked = useRef(new Set<string>());
+    const acquire = useCallback((key: string): boolean => {
+        if (locked.current.has(key)) return false;
+        locked.current.add(key);
+        setPending(new Set(locked.current));
+        return true;
+    }, []);
+    const release = useCallback((key: string): void => {
+        locked.current.delete(key);
+        setPending(new Set(locked.current));
+    }, []);
+    return { pending, acquire, release };
+}
+
+function useMemberAdminAction(member: RoomMember): {
+    disabled: boolean;
+    run(action: () => Promise<void>, errorMessage: string): Promise<void>;
+} {
+    const sharedLock = useContext(AdminActionLockContext);
+    const localLock = useAdminActionLock();
+    const lock = sharedLock ?? localLock;
+    const key = `${member.roomId}\0${member.userId}`;
+    return {
+        disabled: lock.pending.has(key),
+        run: async (action, errorMessage): Promise<void> => {
+            if (!lock.acquire(key)) return;
+            try {
+                await action();
+            } catch (err) {
+                logger.error(errorMessage, err);
+                Modal.createDialog(ErrorDialog, { title: _t("Error"), description: errorMessage });
+            } finally {
+                lock.release(key);
+            }
+        },
+    };
+}
