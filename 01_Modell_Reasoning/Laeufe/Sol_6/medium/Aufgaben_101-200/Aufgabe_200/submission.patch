--- a/tests/unit/misc/test_utilcmds.py
+++ b/tests/unit/misc/test_utilcmds.py
@@ -40,6 +40,28 @@ def test_repeat_command_initial(mocker, mode_manager):
         utilcmds.repeat_command(win_id=0)
 
 
+@pytest.mark.parametrize('duration, milliseconds', [
+    ('5000', 5000),
+    ('2m30s', 150000),
+    ('0.25m', 15000),
+])
+def test_later_duration(mocker, qapp, duration, milliseconds):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer').return_value
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration, 'message-info hello', win_id=0)
+
+    timer.setInterval.assert_called_once_with(milliseconds)
+    timer.start.assert_called_once_with()
+
+
+def test_later_invalid_duration(mocker):
+    timer_class = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+    with pytest.raises(cmdutils.CommandError, match='Invalid duration'):
+        utilcmds.later('bad', 'message-info hello', win_id=0)
+    timer_class.assert_not_called()
+
