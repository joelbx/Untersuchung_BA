+        ['A', 'IMG'].includes(node.nodeName) && (node.hasAttribute('class') || node.hasAttribute('style')),
+    replacement: (_content, node) => (node as HTMLElement).outerHTML,
+});
+
+export const fixNestedLists = (dom: Document): Document => {
+    dom.querySelectorAll('ul, ol').forEach((list) => {
+        const parent = list.parentElement;
+        if (!parent || !['UL', 'OL'].includes(parent.tagName)) {
+            return;
+        }
+        let previous = list.previousElementSibling;
+        if (previous?.tagName !== 'LI') {
+            previous = dom.createElement('li');
+            parent.insertBefore(previous, list);
+        }
+        previous.appendChild(list);
+    });
+    return dom;
+};
