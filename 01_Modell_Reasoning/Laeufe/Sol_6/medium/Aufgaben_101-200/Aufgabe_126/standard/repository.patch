@@ -0,0 +1,44 @@
+import { simplifyHTML } from './html';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+describe('assistant Markdown conversion', () => {
+    it('moves sibling nested lists into their preceding list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>parent</li><ul><li>child</li></ul></ul>';
+        fixNestedLists(dom);
+        expect(dom.querySelector('ul > li > ul > li')?.textContent).toBe('child');
+        expect(dom.querySelector('ul > ul')).toBeNull();
+    });
+
+    it('keeps ordered markers and nested list structure through conversion', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>first<ul><li>child</li></ul></li><li>second</li></ol>';
+        const markdown = htmlToMarkdown(dom);
+        expect(markdown).toMatch(/1\. first/);
+        const rendered = document.implementation.createHTMLDocument();
+        rendered.body.innerHTML = markdownToHTML(markdown);
+        expect(rendered.querySelector('ol > li > ul > li')?.textContent).toBe('child');
+        expect(rendered.querySelectorAll('ol > li')).toHaveLength(2);
+    });
+
+    it('keeps class and style on links and images', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML =
+            '<a href="#1" class="link" style="color: red">text</a><img src="#2" class="image" style="width: 20px">';
+        simplifyHTML(dom);
+        const rendered = document.implementation.createHTMLDocument();
+        rendered.body.innerHTML = markdownToHTML(htmlToMarkdown(dom));
+        expect(rendered.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(rendered.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(rendered.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(rendered.querySelector('img')?.getAttribute('style')).toBe('width: 20px');
+    });
+
+    it('keeps indentation inside code blocks', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<pre><code>    # aligned\n    &gt; quoted\n</code></pre>';
+        const markdown = htmlToMarkdown(dom);
+        expect(markdown).toContain('    # aligned');
+        expect(markdown).toContain('    > quoted');
+    });
+});
