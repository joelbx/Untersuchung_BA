@@ -0,0 +1,32 @@
+package sbom
+
+import "testing"
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typeName, packageName    string
+		namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"pypi", "My_Package_Name", "", "my-package-name", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"pom", "org.example:library", "org.example", "library", ""},
+		{"pip", "Some_Project", "", "some-project", ""},
+		{"gomod", "example.com/module", "example.com", "module", ""},
+		{"yarn", "@scope/package", "@scope", "package", ""},
+		{"npm", "unscoped", "", "unscoped", ""},
+		{"golang", "single", "", "single", ""},
+		{"unknown", "some/name", "", "some/name", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typeName+"/"+tt.packageName, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typeName, tt.packageName)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)",
+					tt.typeName, tt.packageName, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
