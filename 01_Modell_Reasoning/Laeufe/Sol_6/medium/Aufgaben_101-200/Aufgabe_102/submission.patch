+    def get_locally_reachable_ips(self, ip_path):
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, flag, version in (('ipv4', '-4', 4), ('ipv6', '-6', 6)):
+            if version == 6 and not socket.has_ipv6:
+                continue
+
+            command = [ip_path, flag, 'route', 'show', 'table', 'local']
+            try:
+                rc, output, err = self.module.run_command(command, errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Unable to gather locally reachable %s routes' % family)
+                continue
+
+            destinations = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                if 'scope' in words:
+                    scope_index = words.index('scope')
+                    if len(words) <= scope_index + 1 or words[scope_index + 1] != 'host':
+                        continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if network.version == version:
+                    destinations.add(network)
+
+            ordered = sorted(destinations, key=lambda network: (int(network.network_address), network.prefixlen))
+            reachable[family] = [str(network.network_address) if network.prefixlen == network.max_prefixlen
+                                 else str(network) for network in ordered]
+        return reachable
+
