+
+import React from "react";
+
+import AccessibleButton, { ButtonEvent } from "../elements/AccessibleButton";
+import UIStore from "../../../stores/UIStore";
+import { ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "onClick" | "children"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...props }) => {
+    const [isOpen, button, openMenu, closeMenu] = useContextMenu();
+    const menuOptions = options.map((option) => {
+        if (!React.isValidElement(option)) return option;
+        const item = option as React.ReactElement<{ onClick?: (event: ButtonEvent) => void }>;
+        return React.cloneElement(item, {
+            onClick: (event: ButtonEvent) => {
+                item.props.onClick?.(event);
+                closeMenu();
+            },
+        });
+    });
+
+    return <>
+        <ContextMenuButton
+            {...props}
+            inputRef={button}
+            label={title}
+            isExpanded={isOpen}
+            disabled={disabled}
+            aria-disabled={!!disabled}
+            onClick={(event) => {
+                button.current?.focus();
+                openMenu(event);
+            }}
+            kind="icon"
+            className="mx_KebabContextMenu_button"
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { isOpen && <IconizedContextMenu
+            onFinished={closeMenu}
+            className="mx_KebabContextMenu_menu"
+            rightAligned
+            top={button.current.getBoundingClientRect().bottom}
+            right={UIStore.instance.windowWidth - button.current.getBoundingClientRect().right}
+        >
+            <IconizedContextMenuOptionList first red>
+                { menuOptions }
+            </IconizedContextMenuOptionList>
+        </IconizedContextMenu> }
+    </>;
+};
