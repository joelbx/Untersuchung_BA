+def test_extra_suffixes_specific_mimes(monkeypatch, affected_qt, accepted,
+                                     expected):
+    extensions = {
+        "image/jpeg": [".jpg", ".jpe"],
+        "image/png": [".png"],
+        "video/mp4": [".m4v", ".mpg4"],
+    }
+    monkeypatch.setattr(mimetypes, "guess_all_extensions", extensions.get)
+
+    assert webview.extra_suffixes_workaround(accepted) == expected
