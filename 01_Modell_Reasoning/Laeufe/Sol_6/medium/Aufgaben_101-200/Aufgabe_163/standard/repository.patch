+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	SQLite DatabaseProtocol = iota + 1
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return ""
+	}
+}
+
+// ConnectionURL returns the chosen connection target. A URL always takes precedence.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.Protocol != 0 && d.Protocol.String() == "" {
+		return "", fmt.Errorf("db.protocol %d is invalid; expected sqlite3, postgres, or mysql", d.Protocol)
+	}
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if d.Protocol.String() == "" {
+		return "", errors.New("db.protocol is required (sqlite3, postgres, mysql)")
+	}
+	if d.Name == "" {
+		return "", errors.New("db.name is required")
+	}
+	if d.Host == "" {
+		return "", errors.New("db.host is required (path for sqlite3)")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return "", errors.New("db.port must be between 0 and 65535")
+	}
+	if d.Protocol == SQLite {
+		return "file:" + filepath.Join(d.Host, d.Name), nil
+	}
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, fmt.Sprint(port)), Path: "/" + d.Name}
+	if d.Password != "" {
+		u.User = url.UserPassword(d.User, d.Password)
+	} else if d.User != "" {
+		u.User = url.User(d.User)
+	}
+	return u.String(), nil
 }
 
