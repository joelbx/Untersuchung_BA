+func TestDatabaseConnectionURL(t *testing.T) {
+	tests := []struct {
+		name string
+		db   DatabaseConfig
+		want string
+		err  string
+	}{
+		{"URL precedence", DatabaseConfig{URL: "file:existing.db", Protocol: Postgres, Host: "other", Name: "other"}, "file:existing.db", ""},
+		{"sqlite", DatabaseConfig{Protocol: SQLite, Host: "/data", Name: "flipt.db"}, "file:/data/flipt.db", ""},
+		{"postgres default port", DatabaseConfig{Protocol: Postgres, Host: "db", User: "alice", Password: "secret", Name: "flipt"}, "postgres://alice:secret@db:5432/flipt", ""},
+		{"mysql default port", DatabaseConfig{Protocol: MySQL, Host: "db", Name: "flipt"}, "mysql://db:3306/flipt", ""},
+		{"missing protocol", DatabaseConfig{Name: "flipt", Host: "db"}, "", "db.protocol"},
+		{"missing name", DatabaseConfig{Protocol: Postgres, Host: "db"}, "", "db.name"},
+		{"missing host", DatabaseConfig{Protocol: SQLite, Name: "flipt.db"}, "", "db.host"},
+		{"invalid protocol", DatabaseConfig{Protocol: 99, Name: "flipt", Host: "db"}, "", "db.protocol 99"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.db.ConnectionURL()
+			if tt.err != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
