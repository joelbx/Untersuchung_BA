+	}{
+		{"fields", "db:\n  protocol: postgres\n  host: db\n  name: flipt\n  user: alice\n", "", Postgres},
+		{"missing host", "db:\n  protocol: mysql\n  name: flipt\n", "db.host", 0},
+		{"invalid protocol", "db:\n  protocol: oracle\n  host: db\n  name: flipt\n", "db.protocol \"oracle\"", 0},
+		{"URL precedence", "db:\n  url: file:existing.db\n  protocol: postgres\n  host: db\n  name: flipt\n  port: invalid\n", "", Postgres},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			require.NoError(t, ioutil.WriteFile(path, []byte(tt.body), 0600))
+			cfg, err := Load(path)
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.protocol, cfg.Database.Protocol)
+			if tt.name == "fields" {
+				assert.Empty(t, cfg.Database.URL)
+			}
+			if tt.name == "URL precedence" {
+				assert.Equal(t, "file:existing.db", cfg.Database.URL)
+			}
+		})
+	}
+}
