+_ERROR_XML = b'<Objs Version="1.1.0.1"><S S="Error">Error _x000A_</S></Objs>'
+
+
+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain stderr\r\n', b'plain stderr\r\n'),
+    (b'#< CLIXML\r\n' + _ERROR_XML, b'Error \n'),
+    (b'before\r\n#< CLIXML\r\n' + _ERROR_XML + b'after\r\n', b'before\r\nError \nafter\r\n'),
+    (b'left #< CLIXML\r\n' + _ERROR_XML + b' right', b'left Error \n right'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1">\r\n<S S="Error">Hi</S>\r\n</Objs>tail', b'Hitail'),
+    (b'#< CLIXML\r\n' + _ERROR_XML + b'\r\nCLIXML\r\n' + _ERROR_XML, b'Error \nError \n'),
+    (b'#< CLIXML\r\n' + _ERROR_XML + _ERROR_XML, b'Error \n\r\nError \n'),
