+    (b'\xff #< CLIXML\r\n' + _ERROR_XML + b' \xfe', b'\xff Error \n \xfe'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">', b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">'),
