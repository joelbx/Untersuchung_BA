diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..2d508f5
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,161 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupTimeFormat = "20060102T150405.000000000Z"
+
+// copySQLite uses SQLite's online backup API so concurrent writers cannot produce
+// an inconsistent database image.
+func copySQLite(ctx context.Context, dest, src *sql.DB) error {
+	source, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	target, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer target.Close()
+	return target.Raw(func(dst any) error {
+		return source.Raw(func(from any) error {
+			backup, err := dst.(*sqlite3.SQLiteConn).Backup("main", from.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(100)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				// SQLite may return BUSY or LOCKED; release the CPU while retrying.
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", fmt.Errorf("backup.path is empty")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		return "", err
+	}
+	path := filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format(backupTimeFormat)+".db")
+	// Reserve the name before opening SQLite, so a failed copy never replaces an
+	// existing backup. Remove the incomplete file on any error.
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	if err := f.Close(); err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	dest, err := sql.Open(Driver, path)
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	err = copySQLite(ctx, dest, d.writeDB)
+	closeErr := dest.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	source, err := sql.Open(Driver, (&url.URL{Scheme: "file", Path: absPath, RawQuery: "mode=ro"}).String())
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var result string
+	if err := source.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&result); err != nil {
+		return err
+	}
+	if result != "ok" {
+		return fmt.Errorf("backup database failed integrity check: %s", result)
+	}
+	return copySQLite(ctx, d.writeDB, source)
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Count < 0 {
+		return 0, fmt.Errorf("backup.count must not be negative")
+	}
+	if conf.Server.Backup.Path == "" {
+		return 0, fmt.Errorf("backup.path is empty")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if !entry.Type().IsRegular() {
+			continue
+		}
+		name := entry.Name()
+		if !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") {
+			continue
+		}
+		stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), ".db")
+		if _, err := time.Parse(backupTimeFormat, stamp); err == nil {
+			names = append(names, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
