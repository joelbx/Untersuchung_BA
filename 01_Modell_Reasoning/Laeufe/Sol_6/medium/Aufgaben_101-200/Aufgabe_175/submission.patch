index 0000000..40cde00
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,68 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	ctx := context.Background()
+	oldBackup := conf.Server.Backup
+	defer func() { conf.Server.Backup = oldBackup }()
+	conf.Server.Backup.Path = filepath.Join(t.TempDir(), "backups")
+	conf.Server.Backup.Count = 1
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0700); err != nil {
+		t.Fatal(err)
+	}
+	live, err := sql.Open(Driver, filepath.Join(t.TempDir(), "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE item (value TEXT); INSERT INTO item VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	database := &db{readDB: live, writeDB: live}
+	first, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := live.Exec("UPDATE item SET value = 'changed'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup filenames collided")
+	}
+	if err := database.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := live.QueryRow("SELECT value FROM item").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "original" {
+		t.Fatalf("restored value = %q", value)
+	}
+	pruned, err := database.Prune(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pruned != 1 {
+		t.Fatalf("pruned %d backups, want 1", pruned)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatalf("latest backup missing: %v", err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("old backup still exists: %v", err)
+	}
+}
