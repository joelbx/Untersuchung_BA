+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	createCmd := &cobra.Command{Use: "create", Short: "Create a database backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		path, err := db.Db().Backup(cmd.Context())
+		if err == nil {
+			_, _ = fmt.Fprintln(cmd.OutOrStdout(), path)
+		}
+		return err
+	}}
+	pruneCmd := &cobra.Command{Use: "prune", Short: "Delete old database backups", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		force, _ := cmd.Flags().GetBool("force")
+		if conf.Server.Backup.Count == 0 && !force && !confirmBackupAction(cmd, "Delete all database backups?") {
+			return fmt.Errorf("backup pruning cancelled")
+		}
+		count, err := db.Db().Prune(cmd.Context())
+		if err == nil {
+			_, _ = fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backups\n", count)
+		}
+		return err
+	}}
+	restoreCmd := &cobra.Command{Use: "restore", Short: "Restore a database backup", Args: cobra.NoArgs, RunE: func(cmd *cobra.Command, _ []string) error {
+		path, _ := cmd.Flags().GetString("backup-file")
+		if path == "" {
+			return fmt.Errorf("--backup-file is required")
+		}
+		force, _ := cmd.Flags().GetBool("force")
+		if !force && !confirmBackupAction(cmd, "Restore database from "+path+"?") {
+			return fmt.Errorf("database restore cancelled")
+		}
+		if err := db.Db().Restore(cmd.Context(), path); err != nil {
+			return err
+		}
+		_, _ = fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+		return nil
+	}}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation")
+	restoreCmd.Flags().Bool("force", false, "skip confirmation")
+	restoreCmd.Flags().String("backup-file", "", "path to the backup database")
+	backupCmd.AddCommand(createCmd, pruneCmd, restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackupAction(cmd *cobra.Command, prompt string) bool {
+	_, _ = fmt.Fprintf(cmd.ErrOrStderr(), "%s [y/N] ", prompt)
+	reader := bufio.NewReader(cmd.InOrStdin())
+	answer, err := reader.ReadString('\n')
+	if err != nil {
+		return false
+	}
+	answer = strings.ToLower(strings.TrimSpace(answer))
+	return answer == "y" || answer == "yes"
+}
