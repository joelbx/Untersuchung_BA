diff --git a/packages/drive-store/zustand/share/memberInvitations.store.test.ts b/packages/drive-store/zustand/share/memberInvitations.store.test.ts
new file mode 100644
index 0000000..14faba6
--- /dev/null
+++ b/packages/drive-store/zustand/share/memberInvitations.store.test.ts
@@ -0,0 +1,66 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareInvitation;
+const externalInvitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareExternalInvitation;
+
+describe('share member and invitation stores', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('isolates members and replaces the selected share only', () => {
+        const store = useMembersStore.getState();
+        store.setMembers('a', [member('a@example.com')]);
+        store.setMembers('b', [member('b@example.com')]);
+        store.setMembers('a', [member('new@example.com')]);
+
+        expect(store.getMembers('a')).toEqual([member('new@example.com')]);
+        expect(store.getMembers('b')).toEqual([member('b@example.com')]);
+        expect(store.getMembers('missing')).toEqual([]);
+    });
+
+    it('isolates internal and external invitations through updates and removals', () => {
+        const store = useInvitationsStore.getState();
+        store.setInvitations('a', [invitation('a@example.com')]);
+        store.setExternalInvitations('a', [externalInvitation('external-a@example.com')]);
+        store.setInvitations('b', [invitation('b@example.com')]);
+        store.setExternalInvitations('b', [externalInvitation('external-b@example.com')]);
+
+        store.updateInvitationsPermissions('a', [invitation('updated@example.com')]);
+        store.removeExternalInvitations('a', []);
+        expect(store.getInvitations('a')).toEqual([invitation('updated@example.com')]);
+        expect(store.getExternalInvitations('a')).toEqual([]);
+        expect(store.getInvitations('b')).toEqual([invitation('b@example.com')]);
+        expect(store.getExternalInvitations('b')).toEqual([externalInvitation('external-b@example.com')]);
+
+        store.addMultipleInvitations('a', [], [externalInvitation('new@example.com')]);
+        expect(store.getInvitations('a')).toEqual([]);
+        expect(store.getExternalInvitations('a')).toEqual([externalInvitation('new@example.com')]);
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+        expect(store.getInvitations('b')).toEqual([invitation('b@example.com')]);
+
+        store.removeInvitations('b', []);
+        store.updateExternalInvitations('b', [externalInvitation('updated-b@example.com')]);
+        expect(store.getInvitations('b')).toEqual([]);
+        expect(store.getExternalInvitations('b')).toEqual([externalInvitation('updated-b@example.com')]);
+        expect(store.getExternalInvitations('a')).toEqual([externalInvitation('new@example.com')]);
+    });
+
+    it('combines email addresses from all three lists', () => {
+        expect(
+            getExistingEmails(
+                [member('member@example.com')],
+                [invitation('invite@example.com')],
+                [externalInvitation('external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'invite@example.com', 'external@example.com']);
+    });
+});
