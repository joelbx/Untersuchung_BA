diff --git a/packages/components/payments/client-extensions/usePollEvents.test.ts b/packages/components/payments/client-extensions/usePollEvents.test.ts
new file mode 100644
index 0000000..34f6bf1
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.ts
@@ -0,0 +1,106 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+
+import { useEventManager } from '../../hooks';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+jest.mock('../../hooks', () => ({ useEventManager: jest.fn() }));
+
+describe('usePollEvents', () => {
+    const call = jest.fn<Promise<void>, []>();
+    const unsubscribe = jest.fn();
+    let notify: (event: Record<string, { Action: EVENT_ACTIONS }[]>) => void;
+    const subscribe = jest.fn((handler) => {
+        notify = handler;
+        return unsubscribe;
+    });
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        jest.clearAllMocks();
+        call.mockResolvedValue(undefined);
+        jest.mocked(useEventManager).mockReturnValue({ call, subscribe } as any);
+    });
+
+    afterEach(() => {
+        jest.useRealTimers();
+    });
+
+    it('calls at 5 second intervals up to five times', async () => {
+        const { result } = renderHook(() => usePollEvents());
+        const done = result.current();
+
+        await jest.advanceTimersByTimeAsync(interval - 1);
+        expect(call).not.toHaveBeenCalled();
+        await jest.advanceTimersByTimeAsync(1);
+        expect(call).toHaveBeenCalledTimes(1);
+        await jest.advanceTimersByTimeAsync(interval * (maxPollingSteps - 1));
+        await done;
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+        expect(subscribe).not.toHaveBeenCalled();
+    });
+
+    it('ignores unrelated events and cleans up after the matching event', async () => {
+        const { result } = renderHook(() => usePollEvents());
+        const done = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        notify({ Subscription: [{ Action: EVENT_ACTIONS.CREATE }] });
+        notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(1);
+
+        notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await done;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+    });
+
+    it('unsubscribes after all attempts and ignores late events', async () => {
+        const { result } = renderHook(() => usePollEvents());
+        const done = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        await done;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    });
+
+    it('does not schedule another call when the matching event arrives during a call', async () => {
+        let completeCall: () => void = () => {};
+        call.mockImplementation(
+            () =>
+                new Promise<void>((resolve) => {
+                    completeCall = resolve;
+                })
+        );
+        const { result } = renderHook(() => usePollEvents());
+        const done = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        await jest.advanceTimersByTimeAsync(interval);
+        notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await done;
+        completeCall();
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+    });
+
+    it('cleans up when subscribe delivers the matching event synchronously', async () => {
+        subscribe.mockImplementationOnce((handler) => {
+            handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+            return unsubscribe;
+        });
+        const { result } = renderHook(() => usePollEvents());
+
+        await result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        expect(call).not.toHaveBeenCalled();
+    });
+});
