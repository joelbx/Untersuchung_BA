+
+// readTeleportProxyHeader consumes the metadata header, leaving the SSH stream
+// at the start of its identification string. The header is bounded so a peer
+// cannot force an unbounded allocation while waiting for its terminator.
+func readTeleportProxyHeader(r *bufio.Reader) (net.Addr, error) {
+	if _, err := r.Discard(len(teleportProxyPrefix)); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	const maxHeaderSize = 64 * 1024
+	header := make([]byte, 0, 256)
+	for len(header) < maxHeaderSize {
+		b, err := r.ReadByte()
+		if err != nil {
+			return nil, trace.Wrap(err, "reading Teleport-Proxy header")
+		}
+		if b == 0 {
+			var metadata struct {
+				ClientAddr string
+			}
+			payload := strings.TrimLeft(string(header), ": \t")
+			if err := json.Unmarshal([]byte(payload), &metadata); err != nil {
+				return nil, trace.Wrap(err, "invalid Teleport-Proxy header")
+			}
+			if metadata.ClientAddr == "" {
+				return nil, nil
+			}
+			return &utils.NetAddr{AddrNetwork: "tcp", Addr: metadata.ClientAddr}, nil
+		}
+		header = append(header, b)
+	}
+	return nil, trace.BadParameter("Teleport-Proxy header exceeds %d bytes", maxHeaderSize)
+}
