@@ -56,6 +56,50 @@ func TestMain(m *testing.M) {
 	os.Exit(m.Run())
 }
 
+func TestTeleportProxySSH(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		prefix     string
+		clientAddr string
+	}{
+		{name: "standard SSH"},
+		{name: "metadata with client address", prefix: "Teleport-Proxy: {\"ClientAddr\":\"192.0.2.10:1234\",\"Trace\":\"test\"}\x00", clientAddr: "192.0.2.10:1234"},
+		{name: "metadata without client address", prefix: "Teleport-Proxy{}\x00"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			mux, err := New(Config{Listener: listener, Context: ctx})
+			require.NoError(t, err)
+			defer mux.Close()
+			sshListener := mux.SSH()
+			go mux.Serve()
+
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			_, err = io.WriteString(client, tc.prefix+"SSH-2.0-test\r\n")
+			require.NoError(t, err)
+
+			server, err := sshListener.Accept()
+			require.NoError(t, err)
+			defer server.Close()
+			require.Equal(t, ProtoSSH, server.(*Conn).Protocol())
+			wantAddr := client.LocalAddr().String()
+			if tc.clientAddr != "" {
+				wantAddr = tc.clientAddr
+			}
+			require.Equal(t, wantAddr, server.RemoteAddr().String())
+			ident := make([]byte, len("SSH-2.0-test\r\n"))
+			_, err = io.ReadFull(server, ident)
+			require.NoError(t, err)
+			require.Equal(t, "SSH-2.0-test\r\n", string(ident))
+		})
+	}
+}
