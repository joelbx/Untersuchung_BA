+@contextmanager
+def _batch_lock(item_id, batch_id):
+    """Serialize work on a batch across processes sharing the staging directory."""
+    lockpath = Batch.get_abspath(item_id, batch_id) + '.lock'
+    os.makedirs(os.path.dirname(lockpath), exist_ok=True)
+    with open(lockpath, 'a+b') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock, fcntl.LOCK_UN)
