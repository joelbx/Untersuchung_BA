diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..53fc25c 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -26,6 +26,64 @@ class TestIptables(ModuleTestCase):
         self.mock_get_iptables_version.start()
         self.addCleanup(self.mock_get_iptables_version.stop)  # ensure that the patching is 'undone'
 
+    def test_match_set_rule(self):
+        """Set matches work with or without an explicit set extension."""
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            for match in ([], ['set']):
+                set_module_args({
+                    'chain': 'INPUT',
+                    'protocol': 'tcp',
+                    'destination_port': '22',
+                    'match': match,
+                    'match_set': 'admin_hosts',
+                    'match_set_flags': flags,
+                    'jump': 'ACCEPT',
+                    'comment': 'SSH from admins',
+                    '_ansible_check_mode': True,
+                })
+                with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+                    with self.assertRaises(AnsibleExitJson):
+                        iptables.main()
+                self.assertEqual(run_command.call_args_list[0][0][0], [
+                    '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                    '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', flags,
+                    '-j', 'ACCEPT', '--destination-port', '22',
+                    '-m', 'comment', '--comment', 'SSH from admins',
+                ])
+
+    def test_match_set_inverted(self):
+        for match in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT', 'match': match, 'match_set': '!admin_hosts',
+                'match_set_flags': 'src', 'jump': 'DROP',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command', side_effect=[(1, '', ''), (0, '', '')]) as run_command:
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_args_list[0][0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-m', 'set', '!', '--match-set', 'admin_hosts', 'src', '-j', 'DROP',
+            ])
+            self.assertEqual(run_command.call_args_list[1][0][0], [
+                '/sbin/iptables', '-t', 'filter', '-A', 'INPUT',
+                '-m', 'set', '!', '--match-set', 'admin_hosts', 'src', '-j', 'DROP',
+            ])
+
+    def test_match_set_parameters_required_together(self):
+        for options in ({'match_set': 'admin_hosts'}, {'match_set_flags': 'src'}):
+            set_module_args(dict({'chain': 'INPUT'}, **options))
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            run_command.assert_not_called()
+
+    def test_match_set_flags_reject_invalid_value(self):
+        set_module_args({'chain': 'INPUT', 'match_set': 'admin_hosts', 'match_set_flags': 'source'})
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+        run_command.assert_not_called()
+
