+def test_parse_data_augments_before_validation(monkeypatch):
+    from openlibrary.core.imports import ImportItem
+    monkeypatch.setattr(web.ctx, 'env', {}, raising=False)
+    calls = []
+
+    class Items:
+        def first(self):
+            return {'data': json.dumps({
+                'authors': [{'name': 'An author'}], 'publish_date': '2001'
+            })}
+
+    def find(ids):
+        calls.append(ids)
+        return Items()
+
+    monkeypatch.setattr(ImportItem, 'find_staged_or_pending', find)
+    rec = {'title': 'A title', 'source_records': ['promise:item:1'],
+           'isbn_10': ['1234567890'], 'identifiers': {'amazon': ['B000000000']}}
+    result, _ = code.parse_data(json.dumps(rec).encode())
+    assert calls == [['1234567890']]
+    assert result['authors'] == [{'name': 'An author'}]
+    assert result['publish_date'] == '2001'
+
+    calls.clear()
+    rec.update(authors=[{'name': 'An author'}], publish_date='2001')
+    code.parse_data(json.dumps(rec).encode())
+    assert calls == []
