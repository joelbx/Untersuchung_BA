+    @pytest.mark.parametrize('source', ['commandline', 'config', 'mixed'])
+    @pytest.mark.parametrize('overlay', [True, False])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch,
+                                         parser, source, overlay):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+
+        flags = ['enable-features=First,Second',
+                 'disable-features=Third,Fourth',
+                 'enable-features=Fifth',
+                 'disable-features=Sixth']
+        if source == 'commandline':
+            commandline_flags, config_flags = flags, []
+        elif source == 'config':
+            commandline_flags, config_flags = [], flags
+        else:
+            commandline_flags, config_flags = flags[:2], flags[2:]
+
+        config_stub.val.qt.args = config_flags
+        commandline = [item for flag in commandline_flags
+                       for item in ('--qt-flag', flag)]
+        args = qtargs.qt_args(parser.parse_args(commandline))
+
+        enabled = 'First,Second,Fifth'
+        if overlay:
+            enabled += ',OverlayScrollbar'
+        assert [arg for arg in args
+                if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)] == [
+                    qtargs.ENABLE_FEATURES_PREFIX + enabled]
+        assert [arg for arg in args
+                if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)] == [
+                    '--disable-features=Third,Fourth',
+                    '--disable-features=Sixth']
+
+    @pytest.mark.parametrize('source', ['commandline', 'config'])
+    def test_disable_features_without_enable(self, config_stub, monkeypatch,
+                                             parser, source):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+        flag = 'disable-features=Third,Fourth'
+        config_stub.val.qt.args = [flag] if source == 'config' else []
+        commandline = ['--qt-flag', flag] if source == 'commandline' else []
+
+        args = qtargs.qt_args(parser.parse_args(commandline))
+
+        assert not any(arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)
+                       for arg in args)
+        assert '--' + flag in args
+
