+@pytest.mark.parametrize('name, expected', [('min', {'block_total': 1}), ('max', {'block_total': 5})])
+def test_min_max_attribute(name, expected):
+    values = [{'block_total': 5}, {'block_total': 1}, {'block_total': 3}]
+    assert getattr(ms, name)(env, values, attribute='block_total') == expected
+    template_env = Environment()
+    template_env.filters[name] = getattr(ms, name)
+    assert template_env.from_string("{{ (values | %s(attribute='block_total')).block_total }}" % name).render(values=values) == str(expected['block_total'])
+
+
+@pytest.mark.parametrize('name, expected', [('min', 'B'), ('max', 'a')])
+def test_min_max_case_sensitive(name, expected):
+    assert getattr(ms, name)(env, ['a', 'B'], case_sensitive=True) == expected
+
+
+@pytest.mark.parametrize('name', ['min', 'max'])
+def test_min_max_forwards_all_kwargs(monkeypatch, name):
+    calls = []
+
+    def jinja_filter(environment, values, **kwargs):
+        calls.append((environment, values, kwargs))
+        return 'result'
+
+    monkeypatch.setattr(ms, 'do_' + name, jinja_filter)
+    values = [1, 2]
+    assert getattr(ms, name)(env, values, attribute='value', case_sensitive=True, custom='forwarded') == 'result'
+    assert calls == [(env, values, {'attribute': 'value', 'case_sensitive': True, 'custom': 'forwarded'})]
+
+
+@pytest.mark.parametrize('name, expected', [('min', 1), ('max', 3)])
+def test_min_max_without_jinja_filter(monkeypatch, name, expected):
+    monkeypatch.setattr(ms, 'do_' + name, None)
+    assert getattr(ms, name)(env, [3, 1, 2]) == expected
+    with pytest.raises(AnsibleFilterError) as error:
+        getattr(ms, name)(env, [3, 1, 2], attribute='value')
+    assert error.value.message == ("Ansible's %s filter does not support any keyword arguments. "
+                                   "You need Jinja2 2.10 or later that provides their version of the filter." % name)
 
 
