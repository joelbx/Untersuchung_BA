diff --git a/src/topics/system-tags.js b/src/topics/system-tags.js
new file mode 100644
index 0000000..0ef5ac6
--- /dev/null
+++ b/src/topics/system-tags.js
@@ -0,0 +1,12 @@
+'use strict';
+
+const meta = require('../meta');
+const utils = require('../utils');
+
+module.exports = function isSystemTag(tag) {
+	const configured = meta.config.systemTags || '';
+	const tags = Array.isArray(configured) ? configured : String(configured).split(',');
+	const normalizedTag = utils.cleanUpTag(tag, meta.config.maximumTagLength);
+	const normalizedSystemTags = tags.map(tag => utils.cleanUpTag(tag, meta.config.maximumTagLength));
+	return !!normalizedTag && normalizedSystemTags.includes(normalizedTag);
+};
