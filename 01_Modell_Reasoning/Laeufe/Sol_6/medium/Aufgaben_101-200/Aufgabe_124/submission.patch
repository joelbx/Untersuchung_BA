@@ -0,0 +1,124 @@
+package dynamo
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/awserr"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbiface"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type billingModeDynamoDB struct {
+	dynamodbiface.DynamoDBAPI
+	createInput *dynamodb.CreateTableInput
+	describe    *dynamodb.DescribeTableOutput
+	describeErr error
+}
+
+func (m *billingModeDynamoDB) CreateTableWithContext(_ context.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingModeDynamoDB) WaitUntilTableExistsWithContext(_ context.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingModeDynamoDB) DescribeTableWithContext(_ context.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describe, m.describeErr
+}
+
+func TestBillingModeDefaultsAndValidation(t *testing.T) {
+	for _, test := range []struct {
+		mode string
+		want string
+		err  bool
+	}{
+		{mode: "", want: billingModePayPerRequest},
+		{mode: billingModePayPerRequest, want: billingModePayPerRequest},
+		{mode: billingModeProvisioned, want: billingModeProvisioned},
+		{mode: "invalid", err: true},
+	} {
+		cfg := Config{TableName: "test", BillingMode: test.mode}
+		err := cfg.CheckAndSetDefaults()
+		if test.err {
+			require.Error(t, err)
+		} else {
+			require.NoError(t, err)
+			require.Equal(t, test.want, cfg.BillingMode)
+		}
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		mode string
+		want string
+	}{
+		{billingModePayPerRequest, dynamodb.BillingModePayPerRequest},
+		{billingModeProvisioned, dynamodb.BillingModeProvisioned},
+	} {
+		t.Run(test.mode, func(t *testing.T) {
+			mock := &billingModeDynamoDB{}
+			b := &Backend{
+				Entry:  logrus.NewEntry(logrus.New()),
+				Config: Config{BillingMode: test.mode, ReadCapacityUnits: 23, WriteCapacityUnits: 37},
+				svc:    mock,
+			}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, test.want, aws.StringValue(mock.createInput.BillingMode))
+			if test.mode == billingModePayPerRequest {
+				require.Nil(t, mock.createInput.ProvisionedThroughput)
+			} else {
+				require.Equal(t, int64(23), aws.Int64Value(mock.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(37), aws.Int64Value(mock.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		table  *dynamodb.TableDescription
+		err    error
+		status tableStatus
+		mode   string
+	}{
+		{name: "on-demand", table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}, status: tableStatusOK, mode: dynamodb.BillingModePayPerRequest},
+		{name: "provisioned", table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)}}, status: tableStatusOK, mode: dynamodb.BillingModeProvisioned},
+		{name: "legacy provisioned", table: &dynamodb.TableDescription{}, status: tableStatusOK},
+		{name: "missing", err: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), status: tableStatusMissing},
+		{name: "migration", table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}}, status: tableStatusNeedsMigration},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			mock := &billingModeDynamoDB{describe: &dynamodb.DescribeTableOutput{Table: test.table}, describeErr: test.err}
+			b := &Backend{svc: mock}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.NoError(t, err)
+			require.Equal(t, test.status, status)
+			require.Equal(t, test.mode, mode)
+		})
+	}
+}
+
+func TestDisableAutoScaling(t *testing.T) {
+	for _, reason := range []string{"the table is on-demand", "the table will be on-demand"} {
+		t.Run(reason, func(t *testing.T) {
+			var output bytes.Buffer
+			logger := logrus.New()
+			logger.SetOutput(&output)
+			b := &Backend{Entry: logrus.NewEntry(logger), Config: Config{EnableAutoScaling: true}}
+			b.disableAutoScaling(reason)
+			require.False(t, b.EnableAutoScaling)
+			require.True(t, strings.Contains(output.String(), "auto_scaling is ignored because "+reason))
+		})
+	}
+}
