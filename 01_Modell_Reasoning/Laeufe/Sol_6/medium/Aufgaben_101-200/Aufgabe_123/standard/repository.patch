diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..54886b4
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,92 @@
+import { Dispatch, SetStateAction } from 'react';
+import { render } from '@testing-library/react';
+
+import Notification from './Notification';
+import createNotificationManager from './manager';
+import { NotificationOptions } from './interfaces';
+
+describe('notification content', () => {
+    const props = { type: 'info' as const, isClosing: false, onExit: () => {} };
+
+    it('renders safe HTML and gives every link safe navigation attributes', () => {
+        const { container } = render(
+            <Notification {...props}>
+                {
+                    '<b>Details</b> <a href="https://example.com" target="_self" onclick="alert(1)">Open</a> <a href="javascript:alert(1)">Bad link</a><script>alert(1)</script>'
+                }
+            </Notification>
+        );
+
+        expect(container.querySelector('b')?.textContent).toBe('Details');
+        const links = container.querySelectorAll('a');
+        expect(links).toHaveLength(2);
+        expect(links[0].getAttribute('href')).toBe('https://example.com');
+        expect(links[1].hasAttribute('href')).toBe(false);
+        links.forEach((link) => {
+            expect(link.getAttribute('rel')).toBe('noopener noreferrer');
+            expect(link.getAttribute('target')).toBe('_blank');
+            expect(link.hasAttribute('onclick')).toBe(false);
+        });
+        expect(container.querySelector('script')).toBeNull();
+    });
+
+    it('preserves React element content', () => {
+        const { getByTestId } = render(
+            <Notification {...props}>
+                <a href="https://example.com" target="_self" data-testid="element">
+                    Element
+                </a>
+            </Notification>
+        );
+        expect(getByTestId('element').textContent).toBe('Element');
+        expect(getByTestId('element').getAttribute('rel')).toBe('noopener noreferrer');
+        expect(getByTestId('element').getAttribute('target')).toBe('_blank');
+    });
+});
+
+describe('notification deduplication', () => {
+    let notifications: NotificationOptions[];
+    let manager: ReturnType<typeof createNotificationManager>;
+
+    beforeEach(() => {
+        notifications = [];
+        const setNotifications: Dispatch<SetStateAction<NotificationOptions[]>> = (value) => {
+            notifications = typeof value === 'function' ? value(notifications) : value;
+        };
+        manager = createNotificationManager(setNotifications);
+    });
+
+    it('uses string text as the fallback key for non-success notifications', () => {
+        manager.createNotification({ text: 'Same error', type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'Same error', type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('Same error');
+    });
+
+    it('prefers an explicit key to string text when finding duplicates', () => {
+        manager.createNotification({ text: 'First', type: 'info', key: 'request', expiration: -1 });
+        manager.createNotification({ text: 'Second', type: 'error', key: 'request', expiration: -1 });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].text).toBe('Second');
+        expect(notifications[0].key).toBe('request');
+    });
+
+    it('uses an explicit key for React content and an id when no key is given', () => {
+        const text = <strong>Error</strong>;
+        manager.createNotification({ text, type: 'error', key: 'shared', expiration: -1 });
+        manager.createNotification({ text: <em>Error again</em>, type: 'error', key: 'shared', expiration: -1 });
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0].key).toBe('shared');
+
+        const id = manager.createNotification({ text, type: 'error', expiration: -1 });
+        expect(notifications).toHaveLength(2);
+        expect(notifications[1].key).toBe(id);
+    });
+
+    it('allows repeated success notifications without deduplicating other types against them', () => {
+        manager.createNotification({ text: 'Done', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Done', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Done', type: 'info', expiration: -1 });
+        expect(notifications).toHaveLength(3);
+    });
+});
