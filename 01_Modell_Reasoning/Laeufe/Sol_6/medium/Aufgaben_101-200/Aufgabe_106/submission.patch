+func TestFillWordPressIgnoreInactiveByServer(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+
+	config.Conf.Servers = map[string]config.ServerInfo{
+		"ignored":  {WordPress: config.WordPressConf{IgnoreInactive: true}},
+		"included": {WordPress: config.WordPressConf{IgnoreInactive: false}},
+	}
+	config.Conf.WpIgnoreInactive = false
+
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Type: models.WPCore, Version: "5.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: "inactive", Version: "1.0"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+	}
+	cache := map[string]*string{
+		"50":              cacheValue(`{}`),
+		"active-plugin":   cacheValue(`{"active-plugin":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`),
+		"inactive-plugin": cacheValue(`{"inactive-plugin":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`),
+		"active-theme":    cacheValue(`{"active-theme":{"vulnerabilities":[{"id":3,"fixed_in":"2.0"}]}}`),
+		"inactive-theme":  cacheValue(`{"inactive-theme":{"vulnerabilities":[{"id":4,"fixed_in":"2.0"}]}}`),
+	}
+
+	for _, tt := range []struct {
+		server string
+		want   int
+	}{
+		{server: "ignored", want: 2},
+		{server: "included", want: 4},
+	} {
+		config.Conf.WpIgnoreInactive = tt.server == "included"
+		r := &models.ScanResult{ServerName: tt.server, WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+		count, err := FillWordPress(r, "unused", cache)
+		if err != nil {
+			t.Fatalf("%s: FillWordPress: %v", tt.server, err)
+		}
+		if count != tt.want || len(r.ScannedCves) != tt.want {
+			t.Errorf("%s: got %d vulnerabilities and %d CVEs, want %d", tt.server, count, len(r.ScannedCves), tt.want)
+		}
+	}
