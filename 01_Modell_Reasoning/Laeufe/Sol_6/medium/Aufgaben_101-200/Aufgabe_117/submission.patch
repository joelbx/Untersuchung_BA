+@pytest.mark.parametrize('locale, packs, expected', [
+    ('en', ['en-US'], 'en-US'),
+    ('en-LR', ['en-US'], 'en-US'),
+    ('en-PH', ['en-US'], 'en-US'),
+    ('en-AU', ['en-GB'], 'en-GB'),
+    ('en-CA', ['en-GB'], 'en-GB'),
+    ('en-IE', ['en-GB'], 'en-GB'),
+    ('en-IN', ['en-GB'], 'en-GB'),
+    ('en-NZ', ['en-GB'], 'en-GB'),
+    ('en-ZA', ['en-GB'], 'en-GB'),
+    ('en-ZW', ['en-GB'], 'en-GB'),
+    ('es', ['es-ES'], 'es-ES'),
+    ('es_MX.UTF-8', ['es-419'], 'es-419'),
+    ('es-ES', ['es-ES'], None),
+    ('es-ES', ['es-419'], 'es-419'),
+    ('pt', ['pt-BR'], 'pt-BR'),
+    ('pt-BR', ['pt-BR'], None),
+    ('pt-PT', ['pt-PT'], None),
+    ('pt-PT', ['pt-BR'], 'pt-BR'),
+    ('zh', ['zh-CN'], 'zh-CN'),
+    ('zh-CN', ['zh-CN'], None),
+    ('zh-TW', ['zh-TW'], None),
+    ('zh-HK', ['zh-TW'], 'zh-TW'),
+    ('zh-MO', ['zh-TW'], 'zh-TW'),
+    ('fr-CA', ['fr'], 'fr'),
+    ('es-MX', ['es'], 'es'),
+    ('pt-PT', ['pt'], 'pt'),
+    ('zh-HK', ['zh'], 'zh'),
+    ('es-MX', [], 'en-US'),
+])
+def test_locale_override(tmp_path, config_stub, monkeypatch,
+                         locale, packs, expected):
+    config_stub.val.qt.workarounds.locale = True
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    for pack in packs:
+        (tmp_path / (pack + '.pak')).touch()
+    versions = version.WebEngineVersions.from_pyqt('5.15.3')
+    assert qtargs._get_lang_override(versions, locale, tmp_path) == expected
+
+
+@pytest.mark.parametrize('enabled, linux, qt_version', [
+    (False, True, '5.15.3'),
+    (True, False, '5.15.3'),
+    (True, True, '5.15.2'),
+    (True, True, '5.15.4'),
+])
+def test_locale_override_gates(tmp_path, config_stub, monkeypatch,
+                               enabled, linux, qt_version):
+    config_stub.val.qt.workarounds.locale = enabled
+    monkeypatch.setattr(qtargs.utils, 'is_linux', linux)
+    versions = version.WebEngineVersions.from_pyqt(qt_version)
+    assert qtargs._get_lang_override(versions, 'es-MX', tmp_path) is None
+
+
+def test_locale_pak_path(tmp_path):
+    assert qtargs._get_locale_pak_path(tmp_path, 'es_MX') == tmp_path / 'es-MX.pak'
+
+
+def test_locale_argument(tmp_path, config_stub, monkeypatch, parser,
+                         version_patcher):
+    config_stub.val.qt.workarounds.locale = True
+    version_patcher('5.15.3')
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    monkeypatch.setenv('QTWEBENGINE_LOCALES_PATH', str(tmp_path))
+    monkeypatch.setattr(qtargs.QLocale, 'system', lambda: qtargs.QLocale('es_MX'))
+    (tmp_path / 'es-419.pak').touch()
+    assert '--lang=es-419' in qtargs.qt_args(parser.parse_args([]))
+
