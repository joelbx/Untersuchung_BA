+func (s *AuthSuite) TestRemoteClusterHeartbeatSurvivesTunnelRemoval(c *C) {
+	const clusterName = "remote.example.com"
+	now := time.Now().UTC().Truncate(time.Second)
+	s.a.SetClock(clockwork.NewFakeClockAt(now))
+
+	rc, err := services.NewRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	rc.SetExpiry(now.Add(time.Hour))
+	c.Assert(s.a.Presence.CreateRemoteCluster(rc), IsNil)
+
+	assertCluster := func(status string, heartbeat time.Time) {
+		cluster, err := s.a.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(cluster.GetConnectionStatus(), Equals, status)
+		c.Assert(cluster.GetLastHeartbeat().Equal(heartbeat), Equals, true)
+		stored, err := s.a.Presence.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(stored.GetConnectionStatus(), Equals, status)
+		c.Assert(stored.GetLastHeartbeat().Equal(heartbeat), Equals, true)
+		c.Assert(stored.Expiry().Equal(rc.Expiry()), Equals, true)
+	}
+
+	assertCluster(teleport.RemoteClusterStatusOffline, time.Time{})
+	older := now.Add(-time.Second)
+	first, err := services.NewTunnelConnection("first", services.TunnelConnectionSpecV2{
+		ClusterName: clusterName, ProxyName: "proxy1", LastHeartbeat: older,
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.Presence.UpsertTunnelConnection(first), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, older)
+
+	second, err := services.NewTunnelConnection("second", services.TunnelConnectionSpecV2{
+		ClusterName: clusterName, ProxyName: "proxy2", LastHeartbeat: now,
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.Presence.UpsertTunnelConnection(second), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, now)
+
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, second.GetName()), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, now)
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, first.GetName()), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOffline, now)
+}
