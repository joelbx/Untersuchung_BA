+func TestGetAmazonLinuxVersion(t *testing.T) {
+	tests := map[string]string{
+		"1": "1", "2": "2", "2 (Karoo)": "2",
+		"2022": "2022", "2023": "2023", "2023 (Amazon Linux)": "2023",
+		"2025": "2025", "2027": "2027", "2029": "2029",
+		"2018.03": "1", "2024": "unknown", "": "unknown", "nonsense": "unknown",
+	}
+	for release, want := range tests {
+		if got := getAmazonLinuxVersion(release); got != want {
+			t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", release, got, want)
+		}
+	}
+}
