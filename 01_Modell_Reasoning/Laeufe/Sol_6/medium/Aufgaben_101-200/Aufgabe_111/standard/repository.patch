+func TestAmazonLinuxEOL(t *testing.T) {
+	for release, year := range map[string]int{"2023": 2028, "2025": 2030, "2027": 2032, "2029": 2034} {
+		eol, found := GetEOL(Amazon, release)
+		if !found {
+			t.Errorf("GetEOL(%q) not found", release)
+			continue
+		}
+		want := time.Date(year, 3, 15, 23, 59, 59, 0, time.UTC)
+		if !eol.StandardSupportUntil.Equal(want) {
+			t.Errorf("GetEOL(%q) standard end = %v, want %v", release, eol.StandardSupportUntil, want)
+		}
+		if eol.IsStandardSupportEnded(want) || eol.IsExtendedSuppportEnded(want) {
+			t.Errorf("GetEOL(%q) ended at deadline", release)
+		}
+		if !eol.IsStandardSupportEnded(want.Add(time.Second)) || !eol.IsExtendedSuppportEnded(want.Add(time.Second)) {
+			t.Errorf("GetEOL(%q) still supported after deadline", release)
+		}
+	}
+	for _, release := range []string{"2024", "unknown", ""} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL(%q) unexpectedly found", release)
+		}
+	}
+}
