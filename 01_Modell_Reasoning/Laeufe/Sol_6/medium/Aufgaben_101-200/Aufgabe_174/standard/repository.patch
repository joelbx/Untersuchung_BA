 from ansible.utils.display import Display
+import pytest
+from unittest.mock import MagicMock
 
 
 def test_display_basic_message(capsys, mocker):
@@ -18,3 +20,37 @@ def test_display_basic_message(capsys, mocker):
     out, err = capsys.readouterr()
     assert out == 'Some displayed message\n'
     assert err == ''
+
+
+def test_display_uses_parent_lock(monkeypatch):
+    display = Display()
+    lock = MagicMock()
+    monkeypatch.setattr(display, '_lock', lock)
+
+    display.display(u'parent message')
+
+    lock.__enter__.assert_called_once_with()
+    lock.__exit__.assert_called_once()
+
+
+def test_display_forwards_from_worker(mocker, monkeypatch, capsys):
+    display = Display()
+    queue = MagicMock()
+    lock = MagicMock()
+    monkeypatch.setattr(display, '_lock', lock)
+    monkeypatch.setattr(display, '_final_q', None)
+
+    with pytest.raises(RuntimeError):
+        display.set_queue(queue)
+
+    mocker.patch('ansible.utils.display.os.getpid', return_value=display._pid + 1)
+    display.set_queue(queue)
+    display.display(u'worker message', color='red', stderr=True, screen_only=True,
+                    log_only=False, newline=False)
+
+    queue.send_display.assert_called_once_with(
+        u'worker message', color='red', stderr=True, screen_only=True,
+        log_only=False, newline=False,
+    )
+    lock.__enter__.assert_not_called()
+    assert capsys.readouterr() == ('', '')
