                 else:
                     dmi_facts[k] = 'NA'
 
+        # IBM Z exposes system identity in /proc/sysinfo instead of DMI.
+        dmi_facts.update(self.get_sysinfo_facts())
         return dmi_facts
 
+    def get_sysinfo_facts(self):
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer:': 'system_vendor',
+            'Type:': 'product_name',
+            'Sequence Code:': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            for prefix, key in fields.items():
+                if line.startswith(prefix):
+                    value = line[len(prefix):].strip()
+                    if key == 'product_serial':
+                        value = value.lstrip('0')
+                    sysinfo_facts[key] = value
+                    break
+
+        return sysinfo_facts
