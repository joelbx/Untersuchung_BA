+class TestFactsLinuxHardwareSysinfo(unittest.TestCase):
+
+    def setUp(self):
+        self.hardware = linux.LinuxHardware(module=Mock(), load_on_init=False)
+
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False)
+    def test_missing_sysinfo(self, mock_exists):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {})
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM',
+        'Type: 3906',
+        'Sequence Code: 0000123456',
+        'Model: 7E7',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_sysinfo_fields(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '123456',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=['Type: 2964'])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_partial_sysinfo(self, mock_exists, mock_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'NA',
+            'product_name': '2964',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer: IBM', 'Type: 3906', 'Sequence Code: 0000123456',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists',
+           side_effect=lambda path: path == '/proc/sysinfo')
+    def test_sysinfo_overrides_missing_dmi(self, mock_exists, mock_lines):
+        self.hardware.module.get_bin_path.return_value = None
+        facts = self.hardware.get_dmi_facts()
+        self.assertEqual(facts['system_vendor'], 'IBM')
+        self.assertEqual(facts['product_name'], '3906')
+        self.assertEqual(facts['product_serial'], '123456')
