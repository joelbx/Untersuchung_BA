+func TestOCIManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name, value, want string
+		invalid           bool
+	}{
+		{name: "default", want: "1.1"},
+		{name: "version 1.0", value: "    manifest_version: \"1.0\"\n", want: "1.0"},
+		{name: "version 1.1", value: "    manifest_version: \"1.1\"\n", want: "1.1"},
+		{name: "invalid", value: "    manifest_version: \"1.2\"\n", invalid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := t.TempDir() + "/flipt.yml"
+			data := "storage:\n  type: oci\n  oci:\n    repository: local/test:latest\n" + tc.value
+			require.NoError(t, os.WriteFile(path, []byte(data), 0600))
+			result, err := Load(path)
+			if tc.invalid {
+				require.EqualError(t, err, "wrong manifest version, it should be 1.0 or 1.1")
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.want, result.Config.Storage.OCI.ManifestVersion)
+		})
+	}
+}
