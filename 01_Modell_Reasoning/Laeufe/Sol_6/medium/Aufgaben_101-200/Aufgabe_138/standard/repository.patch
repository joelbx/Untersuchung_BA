+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name            string
+		options         []containers.Option[StoreOptions]
+		configMediaType string
+	}{
+		{name: "default", configMediaType: v1.MediaTypeEmptyJSON},
+		{name: "version 1.0", options: []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)}, configMediaType: MediaTypeFliptFeatures},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			dir := t.TempDir()
+			store, err := NewStore(zaptest.NewLogger(t), dir, tc.options...)
+			require.NoError(t, err)
+			ref, err := ParseReference("flipt://local/testrepo:latest")
+			require.NoError(t, err)
+			src, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			bundle, err := store.Build(ctx, src, ref)
+			require.NoError(t, err)
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, ref.Reference.Reference)
+			require.NoError(t, err)
+			require.Equal(t, bundle.Digest, desc.Digest)
+			manifestBytes, err := content.FetchAll(ctx, target, desc)
+			require.NoError(t, err)
+			var manifest v1.Manifest
+			require.NoError(t, json.Unmarshal(manifestBytes, &manifest))
+			require.Equal(t, tc.configMediaType, manifest.Config.MediaType)
+		})
+	}
+}
