+// artistFolder finds the common parent of the media directories of the artist's albums.
+func artistFolder(albums model.Albums) string {
+	var folder string
+	for _, album := range albums {
+		for _, dir := range album.Dirs() {
+			parent := filepath.Dir(dir)
+			if folder == "" {
+				folder = parent
+			}
+			for folder != "" {
+				rel, err := filepath.Rel(folder, parent)
+				if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+					break
+				}
+				if next := filepath.Dir(folder); next != folder {
+					folder = next
+				} else {
+					folder = ""
+				}
+			}
+		}
+	}
+	return folder
+}
+
+func fromArtistFolder(folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		files, err := filepath.Glob(filepath.Join(folder, "artist.*"))
+		if err != nil {
+			return nil, "", err
+		}
+		for _, file := range files {
+			f, err := os.Open(file)
+			if err != nil {
+				continue
+			}
+			info, err := f.Stat()
+			if err == nil && info.Mode().IsRegular() {
+				return f, file, nil
+			}
+			f.Close()
+		}
+		return nil, "", nil
+	}
+}
