+func TestTOMLLoaderWpIgnoreInactive(t *testing.T) {
+	dir, err := ioutil.TempDir("", "vuls-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "config.toml")
+	if err := ioutil.WriteFile(path, []byte("wpIgnoreInactive = true\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := Conf
+	defer func() { Conf = old }()
+	Conf = Config{}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !Conf.WpIgnoreInactive {
+		t.Fatal("wpIgnoreInactive from config.toml was not loaded")
+	}
+}
