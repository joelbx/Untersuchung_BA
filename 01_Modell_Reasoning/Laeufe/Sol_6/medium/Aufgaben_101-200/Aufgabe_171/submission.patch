+func TestFliptAcceptServerVersionFromContext(t *testing.T) {
+	require.Equal(t, defaultFliptAcceptServerVersion, FliptAcceptServerVersionFromContext(context.Background()))
+
+	version := semver.Version{Major: 2, Minor: 3, Patch: 4}
+	ctx := WithFliptAcceptServerVersion(context.Background(), version)
+	require.Equal(t, version, FliptAcceptServerVersionFromContext(ctx))
+}
+
+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name   string
+		header string
+		want   semver.Version
+	}{
+		{name: "missing", want: defaultFliptAcceptServerVersion},
+		{name: "prefixed", header: "v1.2.3", want: semver.Version{Major: 1, Minor: 2, Patch: 3}},
+		{name: "unprefixed", header: "2.3.4", want: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+		{name: "incomplete", header: "2.3", want: defaultFliptAcceptServerVersion},
+		{name: "invalid", header: "not-a-version", want: defaultFliptAcceptServerVersion},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.header != "" {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.header))
+			}
+
+			called := false
+			resp, err := FliptAcceptServerVersionUnaryInterceptor(nil)(ctx, "request", nil, func(ctx context.Context, req interface{}) (interface{}, error) {
+				called = true
+				require.Equal(t, tt.want, FliptAcceptServerVersionFromContext(ctx))
+				return req, nil
+			})
+			require.NoError(t, err)
+			require.True(t, called)
+			require.Equal(t, "request", resp)
+		})
+	}
+}
