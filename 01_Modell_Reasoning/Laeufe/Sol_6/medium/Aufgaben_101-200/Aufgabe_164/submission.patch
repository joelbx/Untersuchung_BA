+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	metadata := map[string]any{
+		"owner": map[string]any{"name": "team", "details": []any{map[string]any{"active": true}, "second"}},
+		"count": 3,
+	}
+	for _, tc := range []struct {
+		name     string
+		encoding Encoding
+		input    string
+	}{
+		{
+			name:     "yaml",
+			encoding: EncodingYAML,
+			input: `version: "1.4"
+namespace:
+  key: production
+  name: Production
+  description: Production flags
+flags:
+  - key: nested
+    enabled: true
+    metadata:
+      owner:
+        name: team
+        details:
+          - active: true
+          - second
+      count: 3
+    variants:
+      - key: variant
+        attachment:
+          data:
+            - nested:
+                value: true
+`,
+		},
+		{
+			name:     "json with header",
+			encoding: EncodingJSON,
+			input:    "# exported flags\n" + `{"version":"1.4","namespace":{"key":"production","name":"Production","description":"Production flags"},"flags":[{"key":"nested","enabled":true,"metadata":{"owner":{"name":"team","details":[{"active":true},"second"]},"count":3},"variants":[{"key":"variant","attachment":{"data":[{"nested":{"value":true}}]}}]}]}`,
+		},
+		{
+			name:     "json without header",
+			encoding: EncodingJSON,
+			input:    `{"version":"1.4","namespace":{"key":"production","name":"Production","description":"Production flags"},"flags":[{"key":"nested","enabled":true,"metadata":{"owner":{"name":"team","details":[{"active":true},"second"]},"count":3},"variants":[{"key":"variant","attachment":{"data":[{"nested":{"value":true}}]}}]}]}`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.encoding, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Equal(t, []*flipt.CreateNamespaceRequest{{Key: "production", Name: "Production", Description: "Production flags"}}, creator.createNSReqs)
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "production", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, newStruct(t, metadata), creator.createflagReqs[0].Metadata)
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"data":[{"nested":{"value":true}}]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		"# first\n# second\n{}",
+		" # first\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.Error(t, err)
+	}
+}
