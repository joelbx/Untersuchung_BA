new file mode 100644
index 0000000..5891249
--- /dev/null
+++ b/config/portscan_test.go
@@ -0,0 +1,116 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniqueMapping(t *testing.T) {
+	cases := []struct {
+		name string
+		want ScanTechnique
+	}{
+		{"sS", TCPSYN}, {"sT", TCPConnect}, {"sA", TCPACK}, {"sW", TCPWindow},
+		{"sM", TCPMaimon}, {"sN", TCPNull}, {"sF", TCPFIN}, {"sX", TCPXmas},
+	}
+	for _, tc := range cases {
+		if got := (&PortScanConf{ScanTechniques: []string{strings.ToUpper(tc.name)}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{tc.want}) {
+			t.Errorf("%s: got %v, want %v", tc.name, got, tc.want)
+		}
+		if tc.want.String() != tc.name {
+			t.Errorf("%v.String() = %q, want %q", tc.want, tc.want.String(), tc.name)
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty techniques: %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"unknown"}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{NotSupportTechnique}) {
+		t.Errorf("unknown technique: %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"unknown", "other"}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{NotSupportTechnique}) {
+		t.Errorf("multiple unknown techniques: %v", got)
+	}
+}
+
+func TestPortScanConfValidate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"empty", PortScanConf{}, ""},
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, ""},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"enabled without path", PortScanConf{IsUseExternalScanner: true}, "scannerBinPath"},
+		{"bad path", PortScanConf{ScannerBinPath: path + "-missing"}, "scannerBinPath"},
+		{"unknown", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sS"}}, "multiple"},
+		{"requires privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, "requires"},
+		{"source with connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "TCPConnect"},
+		{"source with default connect", PortScanConf{ScannerBinPath: path, SourcePort: "443"}, "TCPConnect"},
+		{"source zero", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, "sourcePort"},
+		{"source range", PortScanConf{ScannerBinPath: path, SourcePort: "65536"}, "sourcePort"},
+		{"source invalid", PortScanConf{ScannerBinPath: path, SourcePort: "foo"}, "sourcePort"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.conf.Validate()
+			if tc.want == "" && len(errs) != 0 {
+				t.Fatalf("unexpected errors: %v", errs)
+			}
+			if tc.want != "" && !strings.Contains(strings.Join(errorStrings(errs), " "), tc.want) {
+				t.Fatalf("errors %v do not contain %q", errs, tc.want)
+			}
+		})
+	}
+	if !(PortScanConf{}).IsZero() || (PortScanConf{HasPrivileged: true}).IsZero() || (PortScanConf{SourcePort: "443"}).IsZero() || (PortScanConf{ScanTechniques: []string{"sS"}}).IsZero() || (PortScanConf{ScannerBinPath: path}).IsZero() {
+		t.Fatal("IsZero did not inspect every configuration field")
+	}
+}
+
+func errorStrings(errs []error) []string {
+	var result []string
+	for _, err := range errs {
+		result = append(result, err.Error())
+	}
+	return result
+}
+
+func TestPortScanTOMLPerServer(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	configPath := filepath.Join(t.TempDir(), "config.toml")
+	data := "[default]\nuser = \"root\"\n[servers.external]\nhost = \"192.0.2.1\"\nscanModules = [\"ospkg\", \"port\"]\n[servers.external.portscan]\nscannerBinPath = \"" + path + "\"\nscanTechniques = [\"sT\"]\n[servers.native]\nhost = \"192.0.2.2\"\nscanModules = [\"ospkg\", \"port\"]\n"
+	if err := os.WriteFile(configPath, []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	previous := Conf
+	defer func() { Conf = previous }()
+	Conf = Config{}
+	if err := (TOMLLoader{}).Load(configPath, ""); err != nil {
+		t.Fatal(err)
+	}
+	if got := Conf.Servers["external"].PortScan; got == nil || !got.IsUseExternalScanner || got.ScannerBinPath != path {
+		t.Fatalf("external config not loaded: %+v", got)
+	}
+	if got := Conf.Servers["native"].PortScan; got != nil && got.IsUseExternalScanner {
+		t.Fatalf("native server configured for external scanning: %+v", got)
+	}
+	if errs := Conf.checkPortScan(); len(errs) != 0 {
+		t.Fatalf("unexpected validation errors: %v", errs)
+	}
+	external := Conf.Servers["external"]
+	external.PortScan.ScanTechniques = []string{"bad"}
+	Conf.Servers["external"] = external
+	if errs := Conf.checkPortScan(); len(errs) == 0 || !strings.Contains(strings.Join(errorStrings(errs), " "), "unsupported") {
+		t.Fatalf("invalid active portscan config was accepted: %v", errs)
+	}
+}
