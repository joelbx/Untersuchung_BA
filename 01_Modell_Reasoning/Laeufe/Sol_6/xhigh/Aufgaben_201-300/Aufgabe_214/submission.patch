diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..80eeca9
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,172 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies a TCP scan supported by nmap.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+// String returns the nmap scan option without its leading dash.
+func (t ScanTechnique) String() string {
+	switch t {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures an external scanner on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+// IsZero reports whether no port scan settings have been supplied.
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+// GetScanTechniques maps case insensitive nmap option names to scan techniques.
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	if c == nil {
+		return []ScanTechnique{}
+	}
+	scanTechniques = make([]ScanTechnique, 0, len(c.ScanTechniques))
+	seenUnsupported := false
+	for _, name := range c.ScanTechniques {
+		technique := parseScanTechnique(name)
+		if technique == NotSupportTechnique {
+			if seenUnsupported {
+				continue
+			}
+			seenUnsupported = true
+		}
+		scanTechniques = append(scanTechniques, technique)
+	}
+	return scanTechniques
+}
+
+func parseScanTechnique(name string) ScanTechnique {
+	for _, candidate := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+		if strings.EqualFold(name, candidate.String()) {
+			return candidate
+		}
+	}
+	return NotSupportTechnique
+}
+
+// Validate checks scanner settings before a port scan starts.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() && !c.IsUseExternalScanner {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath is required when portscan options are set"))
+	} else {
+		info, err := os.Stat(c.ScannerBinPath)
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q: %w", c.ScannerBinPath, err))
+		} else if !info.Mode().IsRegular() || info.Mode()&0111 == 0 {
+			errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q is not an executable file", c.ScannerBinPath))
+		} else if c.HasPrivileged && os.Geteuid() != 0 {
+			if err := checkScannerCapabilities(c.ScannerBinPath); err != nil {
+				errs = append(errs, err)
+			}
+		}
+	}
+
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan: multiple scan techniques are not supported"))
+	}
+	if c.SourcePort != "" && !c.HasPrivileged && len(c.ScanTechniques) == 0 {
+		errs = append(errs, fmt.Errorf("portscan.sourcePort cannot be used with the default TCPConnect scan"))
+	}
+	for _, name := range c.ScanTechniques {
+		technique := parseScanTechnique(name)
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan: unsupported scan technique %q", name))
+		} else if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan: %s requires hasPrivileged=true; only TCPConnect is allowed without privileges", technique.String()))
+		}
+		if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort cannot be used with TCPConnect"))
+		}
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort %q must be an integer in [0,65535]", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort 0 cannot be used as an explicit source port"))
+		}
+	}
+	return errs
+}
+
+func checkScannerCapabilities(path string) error {
+	out, err := exec.Command("getcap", path).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("portscan: failed to check capabilities on %q: %v: %s", path, err, strings.TrimSpace(string(out)))
+	}
+	line := strings.TrimSpace(string(out))
+	if line == "" {
+		return fmt.Errorf("portscan: missing capabilities on %q (need cap_net_raw and cap_net_admin)", path)
+	}
+	if !strings.HasPrefix(line, path+" ") {
+		return fmt.Errorf("portscan: malformed capability data on %q: %q", path, line)
+	}
+	// getcap prints "path cap_net_admin,cap_net_raw=ep" (some versions insert "=").
+	data := strings.TrimSpace(strings.TrimPrefix(line, path))
+	data = strings.TrimSpace(strings.TrimPrefix(data, "="))
+	separator := "="
+	if !strings.Contains(data, separator) {
+		separator = "+"
+	}
+	parts := strings.SplitN(data, separator, 2)
+	if len(parts) != 2 || len(parts[1]) == 0 || !strings.Contains(parts[1], "e") {
+		return fmt.Errorf("portscan: malformed or ineffective capability data on %q: %q", path, line)
+	}
+	caps := map[string]bool{}
+	for _, cap := range strings.Split(parts[0], ",") {
+		caps[strings.TrimSpace(cap)] = true
+	}
+	if !caps["cap_net_raw"] || !caps["cap_net_admin"] {
+		return fmt.Errorf("portscan: missing cap_net_raw or cap_net_admin on %q: %q", path, line)
+	}
+	return nil
+}
