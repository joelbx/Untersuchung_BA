diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..8a10534
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,125 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+// setScanTechniques converts supported scan techniques into nmap arguments.
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		if technique == config.NotSupportTechnique || technique.String() == "" {
+			return nil, fmt.Errorf("unsupported scan technique: %d", technique)
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+type nmapResult struct {
+	Hosts []struct {
+		Addresses []struct {
+			Addr     string `xml:"addr,attr"`
+			AddrType string `xml:"addrtype,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				Value string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil || conf.ScannerBinPath == "" {
+		return nil, fmt.Errorf("external port scanner path is empty")
+	}
+	if errs := conf.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniques, err := setScanTechniques(conf.GetScanTechniques())
+	if err != nil {
+		return nil, err
+	}
+	// nmap chooses a SYN scan by default when run as root. Make the default
+	// unprivileged behavior explicit so hasPrivileged=false always uses connect().
+	if !conf.HasPrivileged && len(techniques) == 0 {
+		techniques = []string{"-sT"}
+	}
+	open := []string{}
+	for ip, ports := range scanDestIPPorts {
+		parsedIP := net.ParseIP(ip)
+		if parsedIP == nil {
+			return nil, fmt.Errorf("invalid scan destination IP %q", ip)
+		}
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && parsedIP.IsLoopback() {
+			continue
+		}
+		if len(ports) == 0 {
+			continue
+		}
+		for _, port := range ports {
+			n, err := strconv.Atoi(port)
+			if err != nil || n < 1 || n > 65535 {
+				return nil, fmt.Errorf("invalid scan destination port %q", port)
+			}
+		}
+		options := []string{"-n", "-Pn", "-oX", "-"}
+		if parsedIP.To4() == nil {
+			options = append(options, "-6")
+		}
+		if conf.HasPrivileged {
+			options = append(options, "--privileged")
+		} else {
+			options = append(options, "--unprivileged")
+		}
+		options = append(options, techniques...)
+		if conf.SourcePort != "" {
+			options = append(options, "-g", conf.SourcePort)
+		}
+		options = append(options, "-p", strings.Join(ports, ","), ip)
+		out, err := osExec.Command(conf.ScannerBinPath, options...).Output()
+		if err != nil {
+			if exit, ok := err.(*osExec.ExitError); ok {
+				return nil, fmt.Errorf("nmap %s failed: %w: %s", formatNmapOptionsToString(options), err, strings.TrimSpace(string(exit.Stderr)))
+			}
+			return nil, fmt.Errorf("nmap %s failed: %w", formatNmapOptionsToString(options), err)
+		}
+		var result nmapResult
+		if err := xml.Unmarshal(out, &result); err != nil {
+			return nil, fmt.Errorf("failed to parse nmap output for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			address := ""
+			for _, addr := range host.Addresses {
+				if addr.Addr == ip && (addr.AddrType == "ipv4" || addr.AddrType == "ipv6") {
+					address = ip
+					break
+				}
+			}
+			if address == "" {
+				continue
+			}
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.Value == "open" {
+					open = append(open, net.JoinHostPort(address, port.PortID))
+				}
+			}
+		}
+	}
+	return open, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..3063f42
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,72 @@
+package scanner
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestExternalPortScanParsesNmapOutput(t *testing.T) {
+	dir := t.TempDir()
+	argsPath := filepath.Join(dir, "args")
+	binPath := filepath.Join(dir, "nmap")
+	script := fmt.Sprintf(`#!/bin/sh
+printf '%%s\n' "$@" > %q
+cat <<'XML'
+<?xml version="1.0"?>
+<nmaprun><host><address addr="192.0.2.5" addrtype="ipv4"/><ports>
+<port protocol="tcp" portid="22"><state state="open"/></port>
+<port protocol="tcp" portid="80"><state state="closed"/></port>
+<port protocol="udp" portid="53"><state state="open"/></port>
+</ports></host></nmaprun>
+XML
+`, argsPath)
+	if err := os.WriteFile(binPath, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{
+		ScannerBinPath: binPath, IsUseExternalScanner: true, ScanTechniques: []string{"ST"},
+	}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.5": {"22", "80"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.5:22"}) {
+		t.Fatalf("open ports: %v", got)
+	}
+	args, err := os.ReadFile(argsPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"-sT", "--unprivileged", "-p", "22,80", "192.0.2.5"} {
+		if !strings.Contains(string(args), want+"\n") {
+			t.Errorf("nmap args %q missing %q", args, want)
+		}
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.NotSupportTechnique}); err == nil {
+		t.Fatal("unsupported scan technique accepted")
+	}
+}
+
+func TestPortScanUsesNativeWhenExternalDisabled(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ip, port, err := net.SplitHostPort(listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{Host: "localhost", Port: "local", PortScan: &config.PortScanConf{}}}
+	got, err := l.execPortsScan(map[string][]string{ip: {port}})
+	if err != nil || !reflect.DeepEqual(got, []string{net.JoinHostPort(ip, port)}) {
+		t.Fatalf("native scan got %v, err %v", got, err)
+	}
+}
