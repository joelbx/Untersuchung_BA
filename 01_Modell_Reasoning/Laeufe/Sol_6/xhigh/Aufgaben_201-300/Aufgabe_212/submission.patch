diff --git a/detector/wordpress_test.go b/detector/wordpress_test.go
index 47ddca1..b5c6a8c 100644
--- a/detector/wordpress_test.go
+++ b/detector/wordpress_test.go
@@ -6,10 +6,98 @@ package detector
 import (
 	"reflect"
 	"testing"
+	"time"
 
 	"github.com/future-architect/vuls/models"
 )
 
+func TestConvertToVinfos(t *testing.T) {
+	const common = `"id":"123","title":"Test issue","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-03:00","vuln_type":"AUTH_BYPASS","references":{"cve":["2024-1000","2024-2000"],"url":["https://example.com/first","https://example.com/second"]}`
+	tests := []struct {
+		name     string
+		fields   string
+		fixedIn  string
+		summary  string
+		optional map[string]string
+		score    float64
+		vector   string
+		severity string
+	}{
+		{
+			name:     "enterprise",
+			fields:   `,"fixed_in":"6.5.1","description":"Detailed summary","poc":"https://example.com/poc","introduced_in":"6.0","cvss":{"score":8.8,"vector":"CVSS:3.1/AV:N/AC:L","severity":"HIGH"}`,
+			fixedIn:  "6.5.1",
+			summary:  "Detailed summary",
+			optional: map[string]string{"poc": "https://example.com/poc", "introduced_in": "6.0"},
+			score:    8.8,
+			vector:   "CVSS:3.1/AV:N/AC:L",
+			severity: "HIGH",
+		},
+		{
+			name:     "omitted enterprise fields",
+			optional: map[string]string{},
+		},
+		{
+			name:     "null enterprise fields",
+			fields:   `,"fixed_in":null,"description":null,"poc":null,"introduced_in":null,"cvss":null`,
+			optional: map[string]string{},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"6.5":{"vulnerabilities":[{` + common + tt.fields + `}]}}`
+			vinfos, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d vulnerability records, want 1", len(vinfos))
+			}
+			vinfo := vinfos[0]
+			if vinfo.CveID != "CVE-2024-1000" || vinfo.VulnType != "AUTH_BYPASS" {
+				t.Fatalf("unexpected identifier or classification: %+v", vinfo)
+			}
+			if len(vinfo.WpPackageFixStats) != 1 || vinfo.WpPackageFixStats[0].Name != "core" || vinfo.WpPackageFixStats[0].FixedIn != tt.fixedIn {
+				t.Errorf("unexpected fix status: %+v", vinfo.WpPackageFixStats)
+			}
+			contents := vinfo.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("got %d WPScan contents, want 1", len(contents))
+			}
+			content := contents[0]
+			if content.Type != models.WpScan || content.CveID != vinfo.CveID || content.Title != "Test issue" || content.Summary != tt.summary {
+				t.Errorf("unexpected content identity or summary: %+v", content)
+			}
+			wantRefs := models.References{{Link: "https://example.com/first"}, {Link: "https://example.com/second"}}
+			if !reflect.DeepEqual(content.References, wantRefs) {
+				t.Errorf("references = %+v, want %+v", content.References, wantRefs)
+			}
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 7, 5, 6, 0, time.UTC)
+			if !content.Published.Equal(published) || content.Published.Location() != time.UTC || !content.LastModified.Equal(modified) || content.LastModified.Location() != time.UTC {
+				t.Errorf("timestamps = %s, %s; want %s, %s in UTC", content.Published, content.LastModified, published, modified)
+			}
+			if !reflect.DeepEqual(content.Optional, tt.optional) {
+				t.Errorf("optional = %+v, want %+v", content.Optional, tt.optional)
+			}
+			if content.Cvss3Score != tt.score || content.Cvss3Vector != tt.vector || content.Cvss3Severity != tt.severity {
+				t.Errorf("CVSS = %g, %q, %q; want %g, %q, %q", content.Cvss3Score, content.Cvss3Vector, content.Cvss3Severity, tt.score, tt.vector, tt.severity)
+			}
+		})
+	}
+}
+
+func TestConvertToVinfosWithoutCVE(t *testing.T) {
+	vinfos, err := convertToVinfos("core", `{"6.5":{"vulnerabilities":[{"id":"123","references":{"url":["https://example.com/advisory"]}}]}}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(vinfos) != 1 || vinfos[0].CveID != "WPVDBID-123" {
+		t.Fatalf("unexpected vulnerability records: %+v", vinfos)
+	}
+}
