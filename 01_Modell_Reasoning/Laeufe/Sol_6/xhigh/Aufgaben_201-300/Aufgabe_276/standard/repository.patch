+func TestLoadAuthenticationProviderValidation(t *testing.T) {
+	const github = `authentication:
+  session:
+    domain: localhost
+  methods:
+    github:
+      enabled: true
+      client_id: id
+      client_secret: secret
+      redirect_address: http://localhost/callback
+      scopes:
+        - read:org
+      allowed_organizations:
+        - flipt-io
+`
+	const oidc = `authentication:
+  session:
+    domain: localhost
+  methods:
+    oidc:
+      enabled: true
+      providers:
+        foo:
+          issuer_url: http://localhost
+          client_id: id
+          client_secret: secret
+          redirect_address: http://localhost/callback
+`
+
+	tests := []struct {
+		name    string
+		config  string
+		wantErr string
+	}{
+		{"github valid", github, ""},
+		{"github missing client_id", strings.Replace(github, "      client_id: id\n", "", 1), `provider "github": field "client_id": non-empty value is required`},
+		{"github missing client_secret", strings.Replace(github, "      client_secret: secret\n", "", 1), `provider "github": field "client_secret": non-empty value is required`},
+		{"github missing redirect_address", strings.Replace(github, "      redirect_address: http://localhost/callback\n", "", 1), `provider "github": field "redirect_address": non-empty value is required`},
+		{"github blank client_id", strings.Replace(github, "client_id: id", `client_id: "   "`, 1), `provider "github": field "client_id": non-empty value is required`},
+		{"github disabled", strings.Replace(strings.Replace(github, "enabled: true", "enabled: false", 1), "      client_id: id\n", "", 1), ""},
+		{"oidc valid", oidc, ""},
+		{"oidc missing client_id", strings.Replace(oidc, "          client_id: id\n", "", 1), `provider "foo": field "client_id": non-empty value is required`},
+		{"oidc missing client_secret", strings.Replace(oidc, "          client_secret: secret\n", "", 1), `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc missing redirect_address", strings.Replace(oidc, "          redirect_address: http://localhost/callback\n", "", 1), `provider "foo": field "redirect_address": non-empty value is required`},
+		{"oidc blank client_secret", strings.Replace(oidc, "client_secret: secret", `client_secret: "   "`, 1), `provider "foo": field "client_secret": non-empty value is required`},
+		{"oidc named provider", strings.Replace(strings.Replace(oidc, "foo:", "custom-provider:", 1), "          client_id: id\n", "", 1), `provider "custom-provider": field "client_id": non-empty value is required`},
+		{"oidc provider key case", strings.Replace(strings.Replace(oidc, "foo:", "Foo:", 1), "          client_id: id\n", "", 1), `provider "Foo": field "client_id": non-empty value is required`},
+		{"oidc second provider", oidc + "        bar:\n          client_secret: secret\n          redirect_address: http://localhost/callback\n", `provider "bar": field "client_id": non-empty value is required`},
+		{"oidc disabled", strings.Replace(strings.Replace(oidc, "enabled: true", "enabled: false", 1), "          client_id: id\n", "", 1), ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "flipt.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.config), 0600))
+
+			result, err := Load(path)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				require.Nil(t, result)
+				return
+			}
+
+			require.NoError(t, err)
+			require.NotNil(t, result)
+		})
+	}
+}
