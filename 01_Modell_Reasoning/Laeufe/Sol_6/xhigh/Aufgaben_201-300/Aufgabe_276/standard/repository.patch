+// Viper normalizes map keys to lowercase. Keep the spelling of OIDC provider
+// keys from YAML so validation errors identify the provider as configured.
+func restoreOIDCProviderKeys(cfg *Config, path string) error {
+	ext := strings.ToLower(filepath.Ext(path))
+	if !cfg.Authentication.Methods.OIDC.Enabled || len(cfg.Authentication.Methods.OIDC.Method.Providers) == 0 || (ext != ".yml" && ext != ".yaml") {
+		return nil
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("reading OIDC provider keys: %w", err)
+	}
+
+	var source struct {
+		Authentication struct {
+			Methods struct {
+				OIDC struct {
+					Providers map[string]any `yaml:"providers"`
+				} `yaml:"oidc"`
+			} `yaml:"methods"`
+		} `yaml:"authentication"`
+	}
+	if err := yaml.Unmarshal(data, &source); err != nil {
+		return fmt.Errorf("reading OIDC provider keys: %w", err)
+	}
+
+	providers := cfg.Authentication.Methods.OIDC.Method.Providers
+	for name := range source.Authentication.Methods.OIDC.Providers {
+		if normalized := strings.ToLower(name); name != normalized {
+			if provider, ok := providers[normalized]; ok {
+				delete(providers, normalized)
+				providers[name] = provider
+			}
+		}
+	}
+
+	return nil
+}
