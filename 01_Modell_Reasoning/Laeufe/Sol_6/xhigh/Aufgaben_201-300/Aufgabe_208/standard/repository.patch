+const plugins = require('../../src/plugins');
 
 describe('email confirmation (v3 api)', () => {
 	let userObj;
@@ -105,3 +107,95 @@ describe('email confirmation (v3 api)', () => {
 		await groups.leave('administrators', userObj.uid);
 	});
 });
+
+describe('email confirmation expiry and resend', () => {
+	const email = 'ttl@example.org';
+	const expiryMs = 2 * 24 * 60 * 60 * 1000;
+	const intervalMs = 10 * 60 * 1000;
+	let uid;
+	let code;
+	let oldExpiry;
+	let oldInterval;
+
+	before(async () => {
+		oldExpiry = meta.config.emailConfirmExpiry;
+		oldInterval = meta.config.emailConfirmInterval;
+		meta.config.emailConfirmExpiry = 2;
+		meta.config.emailConfirmInterval = 10;
+		plugins.hooks.register('email-expiry-test', {
+			hook: 'action:user.verify',
+			method: async () => {},
+		});
+		uid = await user.create({ username: 'email-expiry-test', password: 'abcdef' });
+		code = await user.email.sendValidationEmail(uid, { email });
+	});
+
+	after(async () => {
+		if (uid) {
+			await user.email.expireValidation(uid);
+		}
+		plugins.hooks.unregister('email-expiry-test', 'action:user.verify');
+		meta.config.emailConfirmExpiry = oldExpiry;
+		meta.config.emailConfirmInterval = oldInterval;
+	});
+
+	it('reports a strict pending state and live millisecond TTL', async () => {
+		assert.strictEqual(await user.email.isValidationPending(uid), true);
+		assert.strictEqual(await user.email.isValidationPending(uid, email.toUpperCase()), true);
+		assert.strictEqual(await user.email.isValidationPending(uid, 'other@example.org'), false);
+		const ttlMs = await user.email.getValidationExpiry(uid);
+		const recordTtlMs = await db.pttl(`confirm:${code}`);
+		assert(ttlMs > 0 && ttlMs <= expiryMs);
+		assert(recordTtlMs > 0 && recordTtlMs <= expiryMs);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), false);
+		assert.strictEqual(await user.email.canSendValidation(uid, 'other@example.org'), true);
+	});
+
+	it('blocks an immediate resend and permits one after the configured interval', async () => {
+		await assert.rejects(user.email.sendValidationEmail(uid, { email }), /confirm-email-already-sent/);
+		const remainingMs = expiryMs - intervalMs - 2000;
+		await Promise.all([
+			db.pexpireAt(`confirm:byUid:${uid}`, Date.now() + remainingMs),
+			db.pexpireAt(`confirm:${code}`, Date.now() + remainingMs),
+		]);
+		assert((await user.email.getValidationExpiry(uid)) < expiryMs - intervalMs);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+		const oldCode = code;
+		code = await user.email.sendValidationEmail(uid, { email });
+		assert.notStrictEqual(code, oldCode);
+		assert.strictEqual(await db.getObject(`confirm:${oldCode}`), null);
+		assert((await user.email.getValidationExpiry(uid)) > expiryMs - intervalMs);
+	});
+
+	it('clears both keys on expiry and allows an immediate new request', async () => {
+		const oldCode = code;
+		await user.email.expireValidation(uid);
+		assert.strictEqual(await db.get(`confirm:byUid:${uid}`), null);
+		assert.strictEqual(await db.getObject(`confirm:${oldCode}`), null);
+		assert.strictEqual(await user.email.isValidationPending(uid), false);
+		assert.strictEqual(await user.email.isValidationPending(uid, email), false);
+		assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+		await assert.rejects(user.email.confirmByCode(oldCode), /invalid-data/);
+		code = await user.email.sendValidationEmail(uid, { email });
+		assert.strictEqual(await user.email.isValidationPending(uid, email), true);
+	});
+
+	it('does not accept a code when its per-user marker has expired', async () => {
+		const oldCode = code;
+		await db.pexpireAt(`confirm:byUid:${uid}`, Date.now() - 1);
+		assert.strictEqual(await user.email.isValidationPending(uid), false);
+		assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+		await assert.rejects(user.email.confirmByCode(oldCode), /invalid-data/);
+		code = await user.email.sendValidationEmail(uid, { email });
+		assert.strictEqual(await user.email.isValidationPending(uid), true);
+	});
+
+	it('does not treat a missing confirmation record as pending', async () => {
+		await db.delete(`confirm:${code}`);
+		assert.strictEqual(await user.email.isValidationPending(uid), false);
+		assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+	});
+});
