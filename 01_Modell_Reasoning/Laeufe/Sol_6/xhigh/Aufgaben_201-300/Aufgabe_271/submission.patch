+def get_location_and_publisher(loc_pub: str) -> tuple[list[str], list[str]]:
+    """Extract ordered places and publishers from IA publisher metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub:
+        return [], []
+
+    loc_pub = re.sub(
+        'Place of publication not identified', '', loc_pub, flags=re.IGNORECASE
+    )
+
+    def clean(value: str) -> str:
+        return value.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+
+    if ':' not in loc_pub:
+        publisher = clean(loc_pub.split(',', 1)[1] if ',' in loc_pub else loc_pub)
+        return [], [publisher] if publisher else []
+
+    places = []
+    publishers = []
+    pending_places = []
+    segments = loc_pub.split(';')
+    for segment in segments:
+        if ':' not in segment:
+            if value := clean(segment):
+                pending_places.append(value)
+            continue
+
+        # Text after a second colon in one segment is not a publisher name.
+        pair = ':'.join(segment.split(':', 2)[:2])
+        location, publisher = get_colon_only_loc_pub(pair)
+        places.extend(pending_places)
+        pending_places = []
+        if location := clean(location):
+            places.append(location)
+        if publisher := clean(publisher):
+            publishers.append(publisher)
+
+    return places, publishers
 
 
