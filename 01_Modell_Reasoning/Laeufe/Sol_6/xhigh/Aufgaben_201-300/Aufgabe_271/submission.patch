+def test_get_ia_record_splits_multiple_places_and_publishers() -> None:
+    metadata = {
+        'title': 'French for Travellers',
+        'publisher': [
+            'London ; New York ; Paris : Berlitz Publishing',
+            '[Berlin] : [Langenscheidt] ; [Rome] : [Mondadori]',
