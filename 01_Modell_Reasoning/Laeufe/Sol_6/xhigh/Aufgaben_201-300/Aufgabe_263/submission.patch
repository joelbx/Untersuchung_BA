+
+package dynamoevents
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/credentials"
+	"github.com/aws/aws-sdk-go/aws/session"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/gravitational/teleport/lib/backend/memory"
+	log "github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+type dynamoTransportFunc func(*http.Request) (*http.Response, error)
+
+func (f dynamoTransportFunc) RoundTrip(req *http.Request) (*http.Response, error) { return f(req) }
+
+func dynamoTestResponse(status int, body string) *http.Response {
+	return &http.Response{
+		StatusCode: status,
+		Body:       io.NopCloser(strings.NewReader(body)),
+		Header:     http.Header{"Content-Type": []string{"application/x-amz-json-1.0"}},
+	}
+}
+
+func TestFieldsMapMigrationResumesAfterBatchFailure(t *testing.T) {
+	ctx := context.Background()
+	bk, err := memory.New(memory.Config{})
+	require.NoError(t, err)
+	defer bk.Close()
+
+	first := false
+	failed := false
+	writes := 0
+	transport := dynamoTransportFunc(func(req *http.Request) (*http.Response, error) {
+		body, err := io.ReadAll(req.Body)
+		require.NoError(t, err)
+		switch req.Header.Get("X-Amz-Target") {
+		case "DynamoDB_20120810.Scan":
+			var input struct {
+				ExclusiveStartKey map[string]map[string]string
+			}
+			require.NoError(t, json.Unmarshal(body, &input))
+			if len(input.ExclusiveStartKey) == 0 {
+				if first {
+					return dynamoTestResponse(200, `{"Items":[],"LastEvaluatedKey":{"SessionID":{"S":"one"},"EventIndex":{"N":"1"}}}`), nil
+				}
+				return dynamoTestResponse(200, `{"Items":[{"SessionID":{"S":"one"},"EventIndex":{"N":"1"},"Fields":{"S":"{\"a\":1}"},"Custom":{"S":"keep"}}],"LastEvaluatedKey":{"SessionID":{"S":"one"},"EventIndex":{"N":"1"}}}`), nil
+			}
+			require.Equal(t, "one", input.ExclusiveStartKey["SessionID"]["S"])
+			return dynamoTestResponse(200, `{"Items":[{"SessionID":{"S":"two"},"EventIndex":{"N":"2"},"Fields":{"S":"{\"b\":true}"}}]}`), nil
+		case "DynamoDB_20120810.BatchWriteItem":
+			var input struct {
+				RequestItems map[string][]struct {
+					PutRequest struct {
+						Item map[string]json.RawMessage
+					}
+				}
+			}
+			require.NoError(t, json.Unmarshal(body, &input))
+			require.Len(t, input.RequestItems["events"], 1)
+			item := input.RequestItems["events"][0].PutRequest.Item
+			require.Contains(t, item, "FieldsMap")
+			require.NotContains(t, item, "Fields")
+			if !first {
+				first = true
+				writes++
+				return dynamoTestResponse(200, `{"UnprocessedItems":{}}`), nil
+			}
+			if !failed {
+				failed = true
+				return dynamoTestResponse(400, `{"__type":"ValidationException","message":"forced failure"}`), nil
+			}
+			writes++
+			return dynamoTestResponse(200, `{"UnprocessedItems":{}}`), nil
+		default:
+			t.Fatalf("unexpected DynamoDB operation: %s", req.Header.Get("X-Amz-Target"))
+			return nil, nil
+		}
+	})
+	awsSession := session.Must(session.NewSession(&aws.Config{
+		Region: aws.String("us-east-1"), Endpoint: aws.String("http://dynamodb.test"),
+		Credentials: credentials.NewStaticCredentials("test", "test", ""),
+		HTTPClient:  &http.Client{Transport: transport},
+	}))
+	l := &Log{Entry: log.New().WithField("test", true), Config: Config{Tablename: "events"}, svc: dynamodb.New(awsSession), backend: bk}
+	require.Error(t, l.migrateFieldsMap(ctx))
+	cursor, err := bk.Get(ctx, fieldsMapCursorKey("events"))
+	require.NoError(t, err)
+	require.Contains(t, string(cursor.Value), "one")
+
+	require.NoError(t, l.migrateFieldsMap(ctx))
+	_, err = bk.Get(ctx, fieldsMapCursorKey("events"))
+	require.Error(t, err)
+	require.Equal(t, 2, writes)
+}
