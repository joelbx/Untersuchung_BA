+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package dynamoevents
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"math/big"
+	"reflect"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/trace"
+)
+
+const fieldsMapScanSize = DynamoBatchSize * 4
+const fieldsMapMigrationInterval = time.Hour
+
+// marshalEvent writes only the native map. Fields remains in event for reading
+// older rows and for the existing event conversion code.
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	fields, err := fieldsMapAttribute(e.Fields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	e.Fields = ""
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item["FieldsMap"] = fields
+	return item, nil
+}
+
+func parseJSONFields(data string) (map[string]interface{}, error) {
+	decoder := json.NewDecoder(bytes.NewBufferString(data))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	var extra interface{}
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return nil, trace.BadParameter("event fields contain trailing data")
+	}
+	return fields, nil
+}
+
+func fieldsMapAttribute(data string) (*dynamodb.AttributeValue, error) {
+	fields, err := parseJSONFields(data)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	value, err := jsonAttribute(fields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	// Check the full round trip, including nested arrays, nulls and numbers.
+	restored, err := attributeJSONValue(value)
+	if err != nil || !reflect.DeepEqual(fields, restored) {
+		return nil, trace.BadParameter("event fields changed during DynamoDB map conversion: %v", err)
+	}
+	return value, nil
+}
+
+func jsonAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch v := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(v)}, nil
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(v)}, nil
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(v))}, nil
+	case []interface{}:
+		list := make([]*dynamodb.AttributeValue, 0, len(v))
+		for _, element := range v {
+			child, err := jsonAttribute(element)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			list = append(list, child)
+		}
+		return &dynamodb.AttributeValue{L: list}, nil
+	case map[string]interface{}:
+		m := make(map[string]*dynamodb.AttributeValue, len(v))
+		for key, element := range v {
+			child, err := jsonAttribute(element)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			m[key] = child
+		}
+		return &dynamodb.AttributeValue{M: m}, nil
+	default:
+		return nil, trace.BadParameter("unsupported JSON event field type %T", value)
+	}
+}
+
+func attributeJSONValue(value *dynamodb.AttributeValue) (interface{}, error) {
+	if value == nil {
+		return nil, trace.BadParameter("missing DynamoDB event field value")
+	}
+	switch {
+	case value.M != nil:
+		fields := make(map[string]interface{}, len(value.M))
+		for key, child := range value.M {
+			var err error
+			fields[key], err = attributeJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+		}
+		return fields, nil
+	case value.L != nil:
+		list := make([]interface{}, 0, len(value.L))
+		for _, child := range value.L {
+			decoded, err := attributeJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			list = append(list, decoded)
+		}
+		return list, nil
+	case value.S != nil:
+		return *value.S, nil
+	case value.N != nil:
+		return json.Number(*value.N), nil
+	case value.BOOL != nil:
+		return *value.BOOL, nil
+	case aws.BoolValue(value.NULL):
+		return nil, nil
+	default:
+		return nil, trace.BadParameter("unsupported DynamoDB event field type")
+	}
+}
+
+// eventFieldsJSON prefers the native map when a row has both representations.
+func eventFieldsJSON(item map[string]*dynamodb.AttributeValue) (string, error) {
+	if mapped, ok := item["FieldsMap"]; ok {
+		fields, err := attributeJSONValue(mapped)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		if _, ok := fields.(map[string]interface{}); !ok {
+			return "", trace.BadParameter("FieldsMap is not a DynamoDB map")
+		}
+		data, err := json.Marshal(fields)
+		return string(data), trace.Wrap(err)
+	}
+	if legacy := item["Fields"]; legacy != nil && legacy.S != nil {
+		return *legacy.S, nil
+	}
+	return "", trace.BadParameter("event has neither FieldsMap nor legacy Fields")
+}
+
+func fieldsMapCursorKey(table string) []byte {
+	return backend.FlagKey("dynamoEvents", "fieldsMap", table, "cursor")
+}
+
+func fieldsMapCompletedKey(table string) []byte {
+	return backend.FlagKey("dynamoEvents", "fieldsMap", table, "completed")
+}
+
+// equalJSONValues compares numbers by value, since DynamoDB can normalize
+// their written form (for example, 1.0 and 1).
+func equalJSONValues(a, b interface{}) bool {
+	switch left := a.(type) {
+	case json.Number:
+		right, ok := b.(json.Number)
+		if !ok {
+			return false
+		}
+		leftNumber, _, err := big.ParseFloat(string(left), 10, 512, big.ToNearestEven)
+		if err != nil {
+			return false
+		}
+		rightNumber, _, err := big.ParseFloat(string(right), 10, 512, big.ToNearestEven)
+		return err == nil && leftNumber.Cmp(rightNumber) == 0
+	case map[string]interface{}:
+		right, ok := b.(map[string]interface{})
+		if !ok || len(left) != len(right) {
+			return false
+		}
+		for key, value := range left {
+			other, exists := right[key]
+			if !exists || !equalJSONValues(value, other) {
+				return false
+			}
+		}
+		return true
+	case []interface{}:
+		right, ok := b.([]interface{})
+		if !ok || len(left) != len(right) {
+			return false
+		}
+		for index := range left {
+			if !equalJSONValues(left[index], right[index]) {
+				return false
+			}
+		}
+		return true
+	default:
+		return reflect.DeepEqual(a, b)
+	}
+}
+
+func migrateFieldsItem(item map[string]*dynamodb.AttributeValue) error {
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return trace.BadParameter("invalid legacy Fields")
+	}
+	mapped, err := fieldsMapAttribute(*legacy.S)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if existing := item["FieldsMap"]; existing != nil {
+		oldValue, err := attributeJSONValue(existing)
+		newValue, _ := attributeJSONValue(mapped)
+		if err != nil || !equalJSONValues(oldValue, newValue) {
+			return trace.BadParameter("conflicting Fields and FieldsMap")
+		}
+	}
+	item["FieldsMap"] = mapped
+	delete(item, "Fields")
+	return nil
+}
+
+// migrateFieldsMapWithRetry repeats the scan so rows written by older nodes
+// during a rolling upgrade are eventually converted as well.
+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		err := backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock+"/"+l.Tablename, rfd24MigrationLockTTL, func(ctx context.Context) error {
+			completed, err := l.backend.Get(ctx, fieldsMapCompletedKey(l.Tablename))
+			if err != nil && !trace.IsNotFound(err) {
+				return trace.Wrap(err)
+			}
+			if err == nil {
+				last, parseErr := time.Parse(time.RFC3339Nano, string(completed.Value))
+				if parseErr != nil {
+					return trace.Wrap(parseErr)
+				}
+				if time.Since(last) < fieldsMapMigrationInterval {
+					return nil
+				}
+			}
+			if err := l.migrateFieldsMap(ctx); err != nil {
+				return trace.Wrap(err)
+			}
+			_, err = l.backend.Put(ctx, backend.Item{Key: fieldsMapCompletedKey(l.Tablename), Value: []byte(time.Now().UTC().Format(time.RFC3339Nano))})
+			return trace.Wrap(err)
+		})
+		if err != nil {
+			l.WithError(err).Error("FieldsMap migration failed; retrying")
+		}
+		delay := fieldsMapMigrationInterval
+		if err != nil {
+			delay = time.Minute
+		}
+		select {
+		case <-time.After(delay):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// migrateFieldsMap uses bounded scans and batch writes. A cursor is recorded
+// only after every write in a scan page succeeds. Replaying a page is safe.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	var startKey map[string]*dynamodb.AttributeValue
+	cursorKey := fieldsMapCursorKey(l.Tablename)
+	cursor, err := l.backend.Get(ctx, cursorKey)
+	if err != nil && !trace.IsNotFound(err) {
+		return trace.Wrap(err)
+	}
+	if err == nil {
+		if err := json.Unmarshal(cursor.Value, &startKey); err != nil {
+			return trace.WrapWithMessage(err, "invalid FieldsMap migration cursor")
+		}
+	}
+	l.Info("Starting DynamoDB FieldsMap event migration")
+	var migrated int64
+	for {
+		if err := ctx.Err(); err != nil {
+			return trace.Wrap(err)
+		}
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: startKey,
+			ConsistentRead:    aws.Bool(true),
+			Limit:             aws.Int64(fieldsMapScanSize),
+			FilterExpression:  aws.String("attribute_exists(Fields)"),
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		for offset := 0; offset < len(out.Items); offset += DynamoBatchSize {
+			end := offset + DynamoBatchSize
+			if end > len(out.Items) {
+				end = len(out.Items)
+			}
+			batch := make([]*dynamodb.WriteRequest, 0, end-offset)
+			for _, item := range out.Items[offset:end] {
+				if err := migrateFieldsItem(item); err != nil {
+					l.WithError(err).Errorf("Cannot convert event %s/%s", aws.StringValue(item[keySessionID].S), aws.StringValue(item[keyEventIndex].N))
+					return trace.Wrap(err)
+				}
+				batch = append(batch, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+			}
+			if err := l.uploadFieldsBatch(ctx, batch); err != nil {
+				return trace.Wrap(err)
+			}
+			migrated += int64(len(batch))
+			if migrated%1000 < int64(len(batch)) {
+				l.Infof("Migrated %d DynamoDB events to FieldsMap", migrated)
+			}
+		}
+		startKey = out.LastEvaluatedKey
+		if len(startKey) == 0 {
+			break
+		}
+		data, err := json.Marshal(startKey)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		if _, err := l.backend.Put(ctx, backend.Item{Key: cursorKey, Value: data}); err != nil {
+			return trace.Wrap(err)
+		}
+	}
+	if err := l.backend.Delete(ctx, cursorKey); err != nil && !trace.IsNotFound(err) {
+		return trace.Wrap(err)
+	}
+	l.Infof("DynamoDB FieldsMap migration pass complete; converted %d events", migrated)
+	return nil
+}
+
+func (l *Log) uploadFieldsBatch(ctx context.Context, batch []*dynamodb.WriteRequest) error {
+	delay := 100 * time.Millisecond
+	for len(batch) != 0 {
+		out, err := l.svc.BatchWriteItemWithContext(ctx, &dynamodb.BatchWriteItemInput{
+			RequestItems: map[string][]*dynamodb.WriteRequest{l.Tablename: batch},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		batch = out.UnprocessedItems[l.Tablename]
+		if len(batch) == 0 {
+			break
+		}
+		select {
+		case <-time.After(delay):
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		}
+		if delay < 5*time.Second {
+			delay *= 2
+		}
+	}
+	return nil
+}
