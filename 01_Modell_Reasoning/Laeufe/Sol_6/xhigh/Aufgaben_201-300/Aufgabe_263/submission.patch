+func TestSubPageCheckpointStableAcrossFieldsMigration(t *testing.T) {
+	before := &event{SessionID: "session", EventIndex: 42, Fields: `{"old":true}`}
+	after := &event{SessionID: "session", EventIndex: 42, Fields: `{"old":true,"new":null}`}
+	first, err := getSubPageCheckpoint(before)
+	require.NoError(t, err)
+	second, err := getSubPageCheckpoint(after)
+	require.NoError(t, err)
+	require.Equal(t, first, second)
+}
