+func nearestSourcePosition(source cue.Value, path []string, file string) token.Pos {
+	for n := len(path) - 1; n >= 0; n-- {
+		selectors := make([]cue.Selector, 0, n)
+		for _, part := range path[:n] {
+			if index, err := strconv.Atoi(part); err == nil {
+				selectors = append(selectors, cue.Index(index))
+			} else {
+				selectors = append(selectors, cue.Str(part))
+			}
+		}
+		if node := source.LookupPath(cue.MakePath(selectors...)).Source(); node != nil {
+			pos := node.Pos()
+			if pos.IsValid() && pos.Filename() == file {
+				return pos
+			}
+		}
+	}
+	return token.NoPos
 }
 
