+@pytest.mark.parametrize('first_line, task_vars, expected_shebang', [
+    (b'#!/usr/bin/python3.8 -B', {}, '#!/usr/bin/python3.8 -B'),
+    (b'#!/usr/bin/env python3.8 -B', {}, '#!/usr/bin/env python3.8 -B'),
+    (b'#!/opt/venv/bin/python -OO', {}, '#!/opt/venv/bin/python -OO'),
+    (b'#!/usr/bin/python3.8 -B', {'ansible_python_interpreter': '/opt/python/bin/python3'}, '#!/opt/python/bin/python3 -B'),
+    (b'#!/usr/bin/env python3.8 -B', {'ansible_python_interpreter': '/opt/python/bin/python3'}, '#!/opt/python/bin/python3 -B'),
+    (None, {}, '#!/usr/bin/python'),
+])
+def test_new_style_shebang(tmp_path, monkeypatch, templar, first_line, task_vars, expected_shebang):
+    monkeypatch.setattr(amc.C, 'DEFAULT_LOCAL_TMP', str(tmp_path))
+    module_path = tmp_path / 'fake_module.py'
+    source = b'from ansible.module_utils.basic import AnsibleModule\n'
+    if first_line is not None:
+        source = first_line + b'\n' + source
+    module_path.write_bytes(source)
+
+    data, style, shebang = modify_module('fake_module', str(module_path), {}, templar, task_vars=task_vars)
+
+    assert style == 'new'
+    assert shebang == expected_shebang
+    assert data.startswith(expected_shebang.encode('utf-8') + b'\n' + amc.b_ENCODING_STRING + b'\n')
+
+
+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/usr/bin/ruby  -w\nputs "ok"\n', {}, b'#!/usr/bin/ruby  -w\n'),
+    (b'#!/usr/bin/ruby -w\nputs "ok"\n', {'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'}, b'#!/opt/ruby/bin/ruby -w\n'),
+    (b'#!/usr/bin/ruby  -w\nputs "ok"\n', {'ansible_ruby_interpreter': '/usr/bin/ruby'}, b'#!/usr/bin/ruby  -w\n'),
+    (b'#!/usr/bin/python3.8 -B\nprint("ok")\n', {}, b'#!/usr/bin/python3.8 -B\n'),
+    (b'#!/usr/bin/env python3.8 -B\nprint("ok")\n', {'ansible_python_interpreter': '/opt/python/bin/python3'},
+     b'#!/opt/python/bin/python3 -B\n'),
+    (b'print("ok")\n', {}, b'#!/usr/bin/python\n'),
+])
+def test_old_style_shebang(tmp_path, templar, source, task_vars, expected):
+    module_path = tmp_path / 'old_module.py'
+    module_path.write_bytes(source)
+
+    data, style, shebang = modify_module('old_module', str(module_path), {}, templar, task_vars=task_vars)
+
+    assert style == 'old'
+    assert data.startswith(expected + amc.b_ENCODING_STRING + b'\n')
+    assert shebang == expected[:-1].decode('utf-8')
