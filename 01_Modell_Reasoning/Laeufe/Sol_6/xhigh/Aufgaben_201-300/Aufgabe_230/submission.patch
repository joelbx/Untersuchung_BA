+def test_prioritized_identifier_equality_ordering_and_json() -> None:
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    isbn = PrioritizedIdentifier("9780747532699", timestamp=timestamp)
+    same_isbn = PrioritizedIdentifier(
+        "9780747532699", stage_import=False, priority=Priority.HIGH
+    )
+    asin = PrioritizedIdentifier("B06XYHVXVJ", priority=Priority.HIGH)
+
+    assert len({isbn, same_isbn, asin}) == 2
+    assert isbn != asin
+    assert asin < isbn
+    assert json.loads(json.dumps(asin.to_dict())) == {
+        "identifier": "B06XYHVXVJ",
+        "stage_import": True,
+        "priority": "HIGH",
+        "timestamp": asin.timestamp.isoformat(),
+    }
+    assert isbn.to_dict()["timestamp"] == "2024-01-02T03:04:05"
+
+
+def test_prioritized_isbn_legacy_interface() -> None:
+    item = PrioritizedISBN(isbn="0747532699", priority=Priority.HIGH)
+
