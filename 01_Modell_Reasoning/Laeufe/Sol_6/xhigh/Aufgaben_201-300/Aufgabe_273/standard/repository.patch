 """py.test tests for addbook"""
+import pytest
 import web
 from .. import addbook
 from openlibrary import accounts
@@ -21,6 +22,57 @@ def mock_user():
     )()
 
 
+@pytest.mark.parametrize(
+    'author_fields',
+    [
+        {},
+        {'author_key': ['OL1A']},
+        {'author_name': ['Writer']},
+        {'author_key': None, 'author_name': ['Writer']},
+    ],
+)
+def test_make_work_without_author_pair(author_fields):
+    doc = {'key': 'OL1W', 'title': 'Untitled', **author_fields}
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert work.key == 'OL1W'
+    assert work.title == 'Untitled'
+    assert work.authors == []
+    assert work.cover_url == '/images/icons/avatar_book-sm.png'
+    assert work.ia == []
+    assert work.first_publish_year is None
+    assert all(work[field] == value for field, value in doc.items())
+
+
+def test_make_work_with_author_and_optional_metadata():
+    web.ctx.site = MockSite()
+    doc = {
+        'title': 'A Book',
+        'author_key': ['OL1A', 'OL2A'],
+        'author_name': ['First Writer', 'Second Writer'],
+        'cover_url': '/covers/1.jpg',
+        'ia': ['archive-id'],
+        'first_publish_year': 2000,
+    }
+
+    work = addbook.make_work(doc)
+
+    assert [author.key for author in work.authors] == [
+        '/authors/OL1A',
+        '/authors/OL2A',
+    ]
+    assert [author.name for author in work.authors] == [
+        'First Writer',
+        'Second Writer',
+    ]
+    assert all(author.type.key == '/type/author' for author in work.authors)
+    assert work.cover_url == '/covers/1.jpg'
+    assert work.ia == ['archive-id']
+    assert work.first_publish_year == 2000
+
+
 class TestSaveBookHelper:
     def setup_method(self, method):
         web.ctx.site = MockSite()
