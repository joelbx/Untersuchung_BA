+def test_build_install_symlinks_and_external_file(collection_input, tmp_path_factory):
+    input_dir, output_dir = collection_input
+    target_dir = os.path.join(input_dir, 'roles', 'shared')
+    os.makedirs(target_dir)
+    with open(os.path.join(target_dir, 'task.yml'), 'wb') as file_obj:
+        file_obj.write(b'---\n')
+
+    dir_link = os.path.join(input_dir, 'playbooks', 'shared')
+    file_link = os.path.join(input_dir, 'docs', 'readme-link')
+    external_file = os.path.join(output_dir, 'external.txt')
+    external_link = os.path.join(input_dir, 'docs', 'external-link')
+    with open(external_file, 'wb') as file_obj:
+        file_obj.write(b'external content')
+    os.symlink(target_dir, dir_link)
+    os.symlink(os.path.join(input_dir, 'README.md'), file_link)
+    os.symlink(external_file, external_link)
+
+    collection.build_collection(input_dir, output_dir, False)
+    artifact = os.path.join(output_dir, 'ansible_namespace-collection-0.1.0.tar.gz')
+    with tarfile.open(artifact, 'r') as tar_obj:
+        assert tar_obj.getmember('playbooks/shared').issym()
+        assert tar_obj.getmember('playbooks/shared').linkname == '../roles/shared'
+        assert tar_obj.getmember('docs/readme-link').issym()
+        assert tar_obj.getmember('docs/readme-link').linkname == '../README.md'
+        assert tar_obj.getmember('docs/external-link').isreg()
+        assert tar_obj.extractfile('docs/external-link').read() == b'external content'
+        manifest = json.load(tar_obj.extractfile('FILES.json'))
+        assert len([entry for entry in manifest['files'] if entry['name'].startswith('playbooks/shared')]) == 1
+
+    install_root = to_bytes(tmp_path_factory.mktemp('installed collections'))
+    temp_dir = to_bytes(tmp_path_factory.mktemp('collection install temp'))
+    requirement = collection.CollectionRequirement.from_tar(to_bytes(artifact), True)
+    requirement.install(to_text(install_root), temp_dir)
+    installed = os.path.join(install_root, b'ansible_namespace', b'collection')
+    assert os.path.islink(os.path.join(installed, b'playbooks', b'shared'))
+    assert os.readlink(os.path.join(installed, b'playbooks', b'shared')) == b'../roles/shared'
+    assert os.path.isfile(os.path.join(installed, b'playbooks', b'shared', b'task.yml'))
+    assert os.path.islink(os.path.join(installed, b'docs', b'readme-link'))
+    assert os.readlink(os.path.join(installed, b'docs', b'readme-link')) == b'../README.md'
+    assert not os.path.islink(os.path.join(installed, b'docs', b'external-link'))
+    with open(os.path.join(installed, b'docs', b'external-link'), 'rb') as file_obj:
+        assert file_obj.read() == b'external content'
+
+
+def test_is_child_path(tmp_path_factory):
+    root = to_bytes(tmp_path_factory.mktemp('root'))
+    sibling = root + b'-sibling'
+    assert collection._is_child_path(os.path.join(root, b'child'), root)
+    assert not collection._is_child_path(os.path.join(sibling, b'child'), root)
+    assert collection._is_child_path(b'../child', root, os.path.join(root, b'dir', b'link'))
+    assert not collection._is_child_path(b'../../outside', root, os.path.join(root, b'dir', b'link'))
+
+
+def test_extract_unsafe_symlink_as_file(tmp_path_factory):
+    temp_dir = to_bytes(tmp_path_factory.mktemp('unsafe link tar'))
+    tar_path = os.path.join(temp_dir, b'links.tar.gz')
+    with tarfile.open(tar_path, 'w:gz') as tar_obj:
+        data = b'safe copied content'
+        source = tarfile.TarInfo('../outside')
+        source.size = len(data)
+        tar_obj.addfile(source, BytesIO(data))
+        link = tarfile.TarInfo('unsafe')
+        link.type = tarfile.SYMTYPE
+        link.linkname = '../outside'
+        tar_obj.addfile(link)
+        directory_link = tarfile.TarInfo('unsafe-dir')
+        directory_link.type = tarfile.SYMTYPE
+        directory_link.linkname = '../outside-dir'
+        tar_obj.addfile(directory_link)
+
+    output = os.path.join(temp_dir, b'installed')
+    with tarfile.open(tar_path, 'r') as tar_obj:
+        collection._extract_tar_file(tar_obj, 'unsafe', output, temp_dir, sha256(data).hexdigest())
+        collection._extract_tar_dir(tar_obj, 'unsafe-dir', output)
+    assert not os.path.islink(os.path.join(output, b'unsafe'))
+    with open(os.path.join(output, b'unsafe'), 'rb') as file_obj:
+        assert file_obj.read() == data
+    assert os.path.isdir(os.path.join(output, b'unsafe-dir'))
+    assert not os.path.islink(os.path.join(output, b'unsafe-dir'))
+
+
+def test_extract_rejects_symlink_destination(tmp_tarfile):
+    temp_dir, tar_obj, filename, checksum = tmp_tarfile
+    output = os.path.join(temp_dir, b'installed')
+    os.makedirs(output)
+    os.symlink(temp_dir, os.path.join(output, to_bytes(filename)))
+    with pytest.raises(AnsibleError, match='outside the collection directory'):
+        collection._extract_tar_file(tar_obj, filename, output, temp_dir, checksum)
+
