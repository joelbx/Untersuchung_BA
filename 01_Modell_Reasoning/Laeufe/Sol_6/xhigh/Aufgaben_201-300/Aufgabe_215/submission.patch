diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..90c286c
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,153 @@
+package main
+
+import (
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestSchemeString(t *testing.T) {
+	if got := HTTP.String(); got != "http" {
+		t.Fatalf("HTTP.String() = %q", got)
+	}
+	if got := HTTPS.String(); got != "https" {
+		t.Fatalf("HTTPS.String() = %q", got)
+	}
+}
+
+func TestConfigureDefaults(t *testing.T) {
+	got, err := configure("testdata/config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := defaultConfig(); !reflect.DeepEqual(got, want) {
+		t.Fatalf("configure(defaults) = %#v, want %#v", got, want)
+	}
+}
+
+func TestConfigureAdvancedHTTPS(t *testing.T) {
+	got, err := configure("testdata/config/advanced.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := &config{
+		LogLevel: "WARN",
+		UI:       uiConfig{Enabled: false},
+		Cors:     corsConfig{Enabled: true, AllowedOrigins: []string{"foo.com"}},
+		Cache:    cacheConfig{Memory: memoryCacheConfig{Enabled: true, Items: 5000}},
+		Server: serverConfig{
+			Host: "127.0.0.1", Protocol: HTTPS, HTTPPort: 8081, HTTPSPort: 8080,
+			GRPCPort: 9001, CertFile: "./testdata/config/ssl_cert.pem", CertKey: "./testdata/config/ssl_key.pem",
+		},
+		Database: databaseConfig{
+			URL:            "postgres://postgres@localhost:5432/flipt?sslmode=disable",
+			MigrationsPath: "./config/migrations",
+		},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("configure(advanced) = %#v, want %#v", got, want)
+	}
+}
+
+func TestConfigureValidatesHTTPS(t *testing.T) {
+	f, err := ioutil.TempFile("", "flipt-https-*.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(f.Name())
+	if _, err := f.WriteString("server:\n  protocol: https\n"); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := configure(f.Name()); err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Fatalf("configure() error = %v", err)
+	}
+}
+
+func TestConfigureEnvironmentAndOriginList(t *testing.T) {
+	key := "FLIPT_SERVER_HTTPS_PORT"
+	old, set := os.LookupEnv(key)
+	if err := os.Setenv(key, "8443"); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if set {
+			_ = os.Setenv(key, old)
+		} else {
+			_ = os.Unsetenv(key)
+		}
+	}()
+
+	for _, origins := range []string{"foo.com", "[foo.com]"} {
+		f, err := ioutil.TempFile("", "flipt-config-*.yml")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.Remove(f.Name())
+		if _, err := f.WriteString("cors:\n  allowed_origins: " + origins + "\n"); err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+		got, err := configure(f.Name())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got.Server.HTTPSPort != 8443 || !reflect.DeepEqual(got.Cors.AllowedOrigins, []string{"foo.com"}) {
+			t.Fatalf("origins %s: port = %d, origins = %v", origins, got.Server.HTTPSPort, got.Cors.AllowedOrigins)
+		}
+	}
+}
+
+func TestValidateHTTPS(t *testing.T) {
+	missing := filepath.Join(os.TempDir(), "flipt-missing-tls-test.pem")
+	cert := "testdata/config/ssl_cert.pem"
+	key := "testdata/config/ssl_key.pem"
+	for _, tc := range []struct {
+		name, cert, key, want string
+	}{
+		{"missing cert field", "", "", "cert_file cannot be empty when using HTTPS"},
+		{"missing key field", cert, "", "cert_key cannot be empty when using HTTPS"},
+		{"missing cert file", missing, key, "cannot find TLS cert_file at \"" + missing + "\""},
+		{"missing key file", cert, missing, "cannot find TLS cert_key at \"" + missing + "\""},
+		{"valid", cert, key, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := defaultConfig()
+			cfg.Server.Protocol = HTTPS
+			cfg.Server.CertFile, cfg.Server.CertKey = tc.cert, tc.key
+			err := cfg.validate()
+			if tc.want == "" && err != nil || tc.want != "" && (err == nil || err.Error() != tc.want) {
+				t.Fatalf("validate() = %v, want %q", err, tc.want)
+			}
+		})
+	}
+	cfg := defaultConfig()
+	cfg.Server.CertFile, cfg.Server.CertKey = missing, missing
+	if err := cfg.validate(); err != nil {
+		t.Fatalf("HTTP validation failed: %v", err)
+	}
+}
+
+func TestConfigAndInfoHandlers(t *testing.T) {
+	for _, h := range []http.Handler{defaultConfig(), info{Version: "test"}} {
+		r := httptest.NewRecorder()
+		h.ServeHTTP(r, httptest.NewRequest("GET", "/", nil))
+		if r.Code != http.StatusOK || strings.TrimSpace(r.Body.String()) == "" {
+			t.Fatalf("response status = %d, body = %q", r.Code, r.Body.String())
+		}
+		var body map[string]interface{}
+		if err := json.Unmarshal(r.Body.Bytes(), &body); err != nil || len(body) == 0 {
+			t.Fatalf("invalid response body: %s (%v)", r.Body.String(), err)
+		}
+	}
+}
