+describe('post purge upload cleanup', () => {
+	let uid;
+	let cid;
+	let originalSetting;
+	const uploadDir = path.join(nconf.get('upload_path'), 'files');
+	const files = ['purge-shared.txt', 'purge-preserved.txt', 'purge-resized.png', 'purge-resized-resized.png', 'purge-batch-a.txt', 'purge-batch-b.txt', 'purge-thumb.png'];
+	const fullPath = name => path.join(uploadDir, name);
+
+	before(async () => {
+		originalSetting = meta.config.preserveOrphanedUploads;
+		meta.config.preserveOrphanedUploads = 0;
+		files.forEach(name => fs.writeFileSync(fullPath(name), 'test'));
+		uid = await user.create({ username: 'purge uploads user', password: 'abracadabra', gdpr_consent: 1 });
+		({ cid } = await categories.create({ name: 'Purge uploads category' }));
+	});
+
+	after(() => {
+		meta.config.preserveOrphanedUploads = originalSetting;
+		files.forEach((name) => {
+			if (fs.existsSync(fullPath(name))) {
+				fs.unlinkSync(fullPath(name));
+			}
+		});
+	});
+
+	async function createPost(fileName) {
+		return (await topics.post({
+			uid,
+			cid,
+			title: `topic for ${fileName}`,
+			content: `[file](/assets/uploads/files/${fileName})`,
+		})).postData.pid;
+	}
+
+	it('retains a shared file until its last post is purged', async () => {
+		const first = await createPost('purge-shared.txt');
+		const second = await createPost('purge-shared.txt');
+		await posts.purge(first, uid);
+		assert.strictEqual(fs.existsSync(fullPath('purge-shared.txt')), true);
+		await posts.purge(second, uid);
+		assert.strictEqual(fs.existsSync(fullPath('purge-shared.txt')), false);
+	});
+
+	it('retains orphaned files when configured', async () => {
+		const pid = await createPost('purge-preserved.txt');
+		meta.config.preserveOrphanedUploads = 1;
+		try {
+			await posts.purge(pid, uid);
+			assert.strictEqual(fs.existsSync(fullPath('purge-preserved.txt')), true);
+		} finally {
+			meta.config.preserveOrphanedUploads = 0;
+		}
+	});
+
+	it('deletes the original and resized copy after purge', async () => {
+		const pid = await createPost('purge-resized-resized.png');
+		await posts.purge(pid, uid);
+		assert.strictEqual(fs.existsSync(fullPath('purge-resized.png')), false);
+		assert.strictEqual(fs.existsSync(fullPath('purge-resized-resized.png')), false);
+	});
+
+	it('deletes an orphaned topic thumbnail when the topic is purged', async () => {
+		const topic = await topics.post({ uid, cid, title: 'topic with thumbnail', content: 'body with thumbnail' });
+		await topics.thumbs.associate({ id: topic.topicData.tid, path: fullPath('purge-thumb.png') });
+		await topics.purgePostsAndTopic(topic.topicData.tid, uid);
+		assert.strictEqual(fs.existsSync(fullPath('purge-thumb.png')), false);
+	});
+
+	it('deletes one or several valid files and ignores unsafe paths', async () => {
+		const outside = path.join(nconf.get('upload_path'), 'purge-outside.txt');
+		fs.writeFileSync(outside, 'keep');
+		try {
+			fs.symlinkSync(outside, fullPath('purge-link.txt'));
+			await posts.uploads.deleteFromDisk('purge-batch-a.txt');
+			assert.strictEqual(fs.existsSync(fullPath('purge-batch-a.txt')), false);
+			await posts.uploads.deleteFromDisk([
+				'purge-batch-b.txt', '../purge-outside.txt', outside, 'purge-link.txt',
+				'purge-preserved.txt/child', 'folder/../purge-preserved.txt', 'bad\0name', null, 123,
+			]);
+			assert.strictEqual(fs.existsSync(fullPath('purge-batch-b.txt')), false);
+			assert.strictEqual(fs.existsSync(outside), true);
+			assert.strictEqual(fs.existsSync(fullPath('purge-link.txt')), true);
+			assert.strictEqual(fs.existsSync(fullPath('purge-preserved.txt')), true);
+			await assert.rejects(posts.uploads.deleteFromDisk(123));
+		} finally {
+			fs.unlinkSync(fullPath('purge-link.txt'));
+			fs.unlinkSync(outside);
+		}
+	});
+});
