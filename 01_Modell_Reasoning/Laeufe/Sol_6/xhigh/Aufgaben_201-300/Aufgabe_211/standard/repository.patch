 	await Thumbs.delete(id, thumbs);
 };
+
+Thumbs.purge = async (id) => {
+	const set = `topic:${id}:thumbs`;
+	const thumbs = await db.getSortedSetRange(set, 0, -1);
+	const localPaths = thumbs.filter(thumb => thumb.startsWith('/files/')).map(thumb => thumb.slice('/files/'.length));
+	if (localPaths.length) {
+		const mainPid = (await require('.').getMainPids([id]))[0];
+		await posts.uploads.dissociate(mainPid, localPaths);
+		if (!meta.config.preserveOrphanedUploads) {
+			const orphaned = (await Promise.all(localPaths.map(async filePath => (
+				await posts.uploads.isOrphan(filePath) ? filePath : null
+			)))).filter(Boolean);
+			await posts.uploads.deleteFromDisk([
+				...orphaned,
+				...orphaned.map(filePath => file.appendToFileName(filePath, '-resized')),
+			]);
+		}
+	}
+	await db.delete(set);
+	cache.del(set);
+};
