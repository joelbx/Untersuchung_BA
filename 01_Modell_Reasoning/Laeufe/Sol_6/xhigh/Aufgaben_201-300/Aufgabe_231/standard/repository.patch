+func Test_newDBConnection(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "vuls.db")
+	if err := putMetadata(types.Metadata{SchemaVersion: common.SchemaVersion}, path); err != nil {
+		t.Fatalf("putMetadata err = %v", err)
+	}
+
+	dbc, err := newDBConnection(config.Vuls2Conf{Path: path, SkipUpdate: true}, true)
+	if err != nil {
+		t.Fatalf("newDBConnection err = %v", err)
+	}
+	if err := dbc.Open(); err != nil {
+		t.Fatalf("returned db connection cannot be opened: %v", err)
+	}
+	defer dbc.Close()
+	metadata, err := dbc.GetMetadata()
+	if err != nil || metadata == nil || metadata.SchemaVersion != common.SchemaVersion {
+		t.Errorf("returned db metadata = %v, err = %v", metadata, err)
+	}
+}
+
+func initializeDB(path string) error {
+	c := common.Config{Type: "boltdb", Path: path}
+	dbc, err := c.New()
+	if err != nil {
+		return err
+	}
+	if err := dbc.Open(); err != nil {
+		return err
+	}
+	defer dbc.Close()
+	return dbc.Initialize()
+}
