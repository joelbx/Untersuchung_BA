+import logging
+
 import pytest
 
 from qutebrowser.browser import shared
+from qutebrowser.utils import usertypes
 
 
 @pytest.mark.parametrize('dnt, accept_language, custom_headers, expected', [
@@ -45,3 +48,96 @@ def test_custom_headers(config_stub, dnt, accept_language, custom_headers,
 
     expected_items = sorted(expected.items())
     assert shared.custom_headers(url=None) == expected_items
+
+
+@pytest.mark.parametrize('level, source, msg, shown', [
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Refused to apply inline style because it violates CSP', False),
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Another message that violates CSP', False),
+    (usertypes.JsLogLevel.error, 'userscript:_qute_stylesheet',
+     'Unexpected stylesheet error', True),
+    (usertypes.JsLogLevel.error, 'userscript:other',
+     'Refused to apply inline style', True),
+    (usertypes.JsLogLevel.warning, 'userscript:_qute_stylesheet',
+     'Unexpected stylesheet error', False),
+    (usertypes.JsLogLevel.error, 'qute:internal',
+     'Refused to apply inline style because it violates CSP', True),
+    (usertypes.JsLogLevel.error, 'page:example',
+     'Unexpected stylesheet error', False),
+])
+def test_js_log_to_ui(config_stub, message_mock, caplog, level, source, msg,
+                      shown):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error'],
+        'qute:*': ['error'],
+    }
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:_qute_*': ['Refused to apply inline style*'],
+        'userscript:*': ['*violates CSP'],
+    }
+
+    with caplog.at_level(logging.ERROR):
+        assert shared._js_log_to_ui(level, source, 66, msg) is shown
+    if shown:
+        shown_msg = message_mock.getmsg(usertypes.MessageLevel.error)
+        assert shown_msg.text == f'JS: [{source}:66] {msg}'
+    else:
+        assert not message_mock.messages
+
+
+@pytest.mark.parametrize('level, message_level', [
+    (usertypes.JsLogLevel.info, usertypes.MessageLevel.info),
+    (usertypes.JsLogLevel.warning, usertypes.MessageLevel.warning),
+    (usertypes.JsLogLevel.error, usertypes.MessageLevel.error),
+])
+def test_js_log_to_ui_levels(config_stub, message_mock, caplog, level,
+                             message_level):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['info', 'warning', 'error'],
+    }
+
+    log_level = {
+        usertypes.JsLogLevel.info: logging.INFO,
+        usertypes.JsLogLevel.warning: logging.WARNING,
+        usertypes.JsLogLevel.error: logging.ERROR,
+    }[level]
+    with caplog.at_level(log_level):
+        assert shared._js_log_to_ui(level, 'userscript:test', 3, 'message')
+    assert message_mock.getmsg(message_level).text == \
+        'JS: [userscript:test:3] message'
+
+
+def test_js_log_to_ui_disabled(config_stub, message_mock):
+    config_stub.val.content.javascript.log_message.levels = None
+    config_stub.val.content.javascript.log_message.excludes = None
+
+    assert not shared._js_log_to_ui(usertypes.JsLogLevel.error,
+                                    'userscript:test', 1, 'message')
+    assert not message_mock.messages
+
+
+@pytest.mark.parametrize('excluded', [False, True])
+def test_javascript_log_message_fallback(config_stub, monkeypatch, caplog,
+                                         message_mock, excluded):
+    logged = []
+    monkeypatch.setitem(shared._JS_LOGMAP, 'debug', logged.append)
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error'],
+    }
+    config_stub.val.content.javascript.log_message.excludes = (
+        {'userscript:*': ['Refused to apply inline style*']} if excluded else {}
+    )
+
+    with caplog.at_level(logging.ERROR):
+        shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                      'userscript:test', 66,
+                                      'Refused to apply inline style')
+
+    if excluded:
+        assert not message_mock.messages
+        assert logged == ['[userscript:test:66] Refused to apply inline style']
+    else:
+        assert message_mock.getmsg(usertypes.MessageLevel.error).text == \
+            'JS: [userscript:test:66] Refused to apply inline style'
+        assert logged == []
