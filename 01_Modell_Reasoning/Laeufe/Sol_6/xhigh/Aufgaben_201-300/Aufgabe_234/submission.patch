+func TestSQLiteDSN(t *testing.T) {
+	dsn := sqliteDSN("file:test.db?mode=ro&_busy_timeout=10")
+	name, query, found := strings.Cut(dsn, "?")
+	if !found || name != "file:test.db" {
+		t.Fatalf("unexpected SQLite path: %q", dsn)
+	}
+	params, err := url.ParseQuery(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]string{
+		"mode":          "ro",
+		"cache":         "shared",
+		"_cache_size":   "1000000000",
+		"_busy_timeout": "5000",
+		"_journal_mode": "WAL",
+		"_synchronous":  "NORMAL",
+		"_foreign_keys": "on",
+		"_txlock":       "immediate",
+	} {
+		if got := params.Get(key); got != want {
+			t.Errorf("%s = %q, want %q", key, got, want)
+		}
+	}
+}
