+    def test_find_staged_or_pending(self, import_item_db):
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'id': 4, 'batch_id': 1, 'ia_id': 'amazon:9780140328721', 'status': 'staged', 'data': '{"title":"Matilda"}'},
+                {'id': 5, 'batch_id': 1, 'ia_id': 'idb:0140328726', 'status': 'pending'},
