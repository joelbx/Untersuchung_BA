+		want          bool
+	}{
+		{"192.0.2.4:1234", "invalid, 192.0.2.0/24, 2001:db8::/32", true},
+		{"[2001:db8::4]:1234", "invalid, 192.0.2.0/24, 2001:db8::/32", true},
+		{"192.0.3.4:1234", "192.0.2.0/24", false},
+		{"2001:db9::4", "2001:db8::/32", false},
+		{"192.0.2.4:1234", "192.0.2.4:5678", true},
+		{"@", "192.0.2.0/24", false},
