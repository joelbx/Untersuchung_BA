+func TestReverseProxyUnixSocketRequiresWhitelist(t *testing.T) {
+	oldWhitelist, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() {
+		conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldWhitelist, oldHeader
+	}()
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	ds := &tests.MockDataStore{MockedUser: tests.CreateMockUserRepo()}
+	r := httptest.NewRequest("GET", "/index.html", nil)
+	r.RemoteAddr = "@"
+	r.Header.Set("Remote-User", "alice")
+	conf.Server.ReverseProxyWhitelist = ""
+	if got := handleLoginFromHeaders(ds, r); got != nil {
+		t.Fatal("Unix socket bypassed an empty whitelist")
+	}
+	conf.Server.ReverseProxyWhitelist = "@"
+	if got := handleLoginFromHeaders(ds, r); got == nil {
+		t.Fatal("whitelisted Unix socket did not log in")
+	}
+	if _, err := ds.User(r.Context()).FindByUsername("alice"); err != nil {
+		t.Fatalf("whitelisted socket did not create user: %v", err)
+	}
+}
