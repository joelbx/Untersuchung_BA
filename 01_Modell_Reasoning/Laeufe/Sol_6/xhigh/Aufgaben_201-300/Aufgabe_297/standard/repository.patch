+// validateIPAgainstList checks the connection peer, never a forwarded address.
+// Bare IPs and host:port entries are treated as single-host networks.
+func validateIPAgainstList(address, whitelist string) bool {
+	if address == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	ip := parseProxyIP(address)
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" || entry == "@" {
+			continue
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil {
+			if network.Contains(ip) {
+				return true
+			}
+			continue
+		}
+		if listed := parseProxyIP(entry); listed != nil && listed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func parseProxyIP(address string) net.IP {
+	if ip := net.ParseIP(address); ip != nil {
+		return ip
+	}
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil
+	}
+	portNumber, err := strconv.Atoi(port)
+	if err != nil || portNumber < 0 || portNumber > 65535 {
+		return nil
+	}
+	return net.ParseIP(host)
+}
+
+// handleLoginFromHeaders returns a session only for a trusted peer with a username.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	address := r.RemoteAddr
+	if peer, ok := request.PeerAddressFrom(r.Context()); ok {
+		address = peer
+	}
+	if !validateIPAgainstList(address, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	username := strings.TrimSpace(r.Header.Get(conf.Server.ReverseProxyUserHeader))
+	if conf.Server.ReverseProxyUserHeader == "" || username == "" {
+		return nil
+	}
+
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for reverse proxy login", countErr)
+			return nil
+		}
+		now := time.Now()
+		user = &model.User{
+			ID: uuid.NewString(), UserName: username, Name: strings.Title(username),
+			NewPassword: uuid.NewString(), IsAdmin: count == 0, LastLoginAt: &now,
+		}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Could not create reverse proxy user", "username", username, err)
+			return nil
+		}
+		user, err = repo.FindByUsername(username)
+		if err != nil || user == nil {
+			log.Error(r, "Could not reload reverse proxy user", "username", username, err)
+			return nil
+		}
+	} else if err != nil || user == nil {
+		log.Error(r, "Could not find reverse proxy user", "username", username, err)
+		return nil
+	}
+	if err := repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update LastLoginAt", "user", user.UserName, err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create reverse proxy token", err)
+		return nil
+	}
+	salt := uuid.NewString()
+	payload := map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token,
+		"subsonicSalt":  salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
 }
 
