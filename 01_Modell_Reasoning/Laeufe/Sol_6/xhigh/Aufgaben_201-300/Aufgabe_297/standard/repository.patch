+func TestReverseProxyIndexAuthentication(t *testing.T) {
+	oldWhitelist, oldHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() {
+		conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader = oldWhitelist, oldHeader
+	}()
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+
+	repo := &trackingUserRepo{MockedUserRepo: tests.CreateMockUserRepo()}
+	ds := &tests.MockDataStore{MockedUser: repo}
+	fs := os.DirFS("tests/fixtures")
+
+	index := func(peer, remote, username string) map[string]interface{} {
+		r := httptest.NewRequest("GET", "/index.html", nil)
+		r.RemoteAddr = remote
+		r.Header.Set("Remote-User", username)
+		if peer != "" {
+			r = r.WithContext(request.WithPeerAddress(r.Context(), peer))
+		}
+		w := httptest.NewRecorder()
+		serveIndex(ds, fs)(w, r)
+		if w.Code != 200 {
+			t.Fatalf("index status = %d", w.Code)
+		}
+		return extractAppConfig(w.Body.String())
+	}
+
+	if _, ok := index("198.51.100.1:1111", "192.0.2.4:1111", "alice")["auth"]; ok {
+		t.Fatal("untrusted connection received authentication data")
+	}
+	if len(repo.Data) != 0 {
+		t.Fatal("untrusted connection created a user")
+	}
+	if _, ok := index("", "192.0.2.4:1111", "")["auth"]; ok {
+		t.Fatal("missing username received authentication data")
+	}
+
+	config := index("", "192.0.2.4:1111", "alice")
+	session, ok := config["auth"].(map[string]interface{})
+	if !ok {
+		t.Fatal("trusted connection did not receive a session")
+	}
+	for _, key := range []string{"id", "isAdmin", "name", "username", "token", "subsonicSalt", "subsonicToken"} {
+		if _, ok := session[key]; !ok {
+			t.Errorf("session missing %s", key)
+		}
+	}
+	if session["username"] != "alice" || session["isAdmin"] != true || config["firstTime"] != false {
+		t.Fatalf("wrong initial user state: %#v", session)
+	}
+	if _, err := auth.Validate(session["token"].(string)); err != nil {
+		t.Fatalf("invalid session token: %v", err)
+	}
+	wantSubsonicToken := fmt.Sprintf("%x", md5.Sum([]byte(repo.Data["alice"].Password+session["subsonicSalt"].(string))))
+	if session["subsonicToken"] != wantSubsonicToken {
+		t.Fatal("invalid Subsonic token")
+	}
+	if repo.updates != 1 || repo.Data["alice"].LastLoginAt == nil {
+		t.Fatal("last login was not updated")
+	}
+
+	second := index("", "192.0.2.4:1111", "bob")["auth"].(map[string]interface{})
+	if second["isAdmin"] != false {
+		t.Fatal("second user was made admin")
+	}
+	if _, ok := index("", "192.0.2.4:1111", "alice")["auth"]; !ok {
+		t.Fatal("existing user could not log in")
+	}
+	if repo.updates != 3 {
+		t.Fatal("last login was not updated for each login")
+	}
