+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	if m, ok := value.(map[string]interface{}); ok {
+		redacted := make(map[string]interface{}, len(m))
+		for key, item := range m {
+			if re.MatchString(key) {
+				redacted[key] = "[REDACTED]"
+			} else {
+				redacted[key] = redactValue(item, re)
+			}
+		}
+		return redacted
+	}
+	if m, ok := value.(map[string]string); ok {
+		redacted := make(map[string]string, len(m))
+		for key, item := range m {
+			if re.MatchString(key) {
+				redacted[key] = "[REDACTED]"
+			} else {
+				redacted[key] = re.ReplaceAllString(item, "$1[REDACTED]$2")
+			}
+		}
+		return redacted
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		if v.Type().Key().Kind() == reflect.String {
+			redacted := make(map[string]interface{}, v.Len())
+			for _, key := range v.MapKeys() {
+				name := key.String()
+				if re.MatchString(name) {
+					redacted[name] = "[REDACTED]"
+				} else {
+					redacted[name] = redactValue(v.MapIndex(key).Interface(), re)
+				}
+			}
+			return redacted
+		}
+		redacted := make(map[interface{}]interface{}, v.Len())
+		for _, key := range v.MapKeys() {
+			if re.MatchString(fmt.Sprint(key.Interface())) {
+				redacted[key.Interface()] = "[REDACTED]"
+			} else {
+				redacted[key.Interface()] = redactValue(v.MapIndex(key).Interface(), re)
+			}
+		}
+		return redacted
+	}
+	if v.Kind() == reflect.String {
+		return re.ReplaceAllString(v.String(), "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprintf("%v", value), "$1[REDACTED]$2")
+}
