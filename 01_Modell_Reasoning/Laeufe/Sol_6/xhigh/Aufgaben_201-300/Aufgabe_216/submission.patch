+def test_ssh_option_precedence(tmp_path, monkeypatch):
+    config = tmp_path / 'ansible.cfg'
+    config.write_text('[ssh_connection]\nssh_common_args = -o FromConfig=1\ntransfer_method = scp\nretries = 2\n')
+    monkeypatch.setattr(C.config, '_config_file', str(config))
+    pc = PlayContext()
+    conn = connection_loader.get('ssh', pc, StringIO())
+
+    conn.set_options()
+    assert conn.get_option('ssh_common_args') == '-o FromConfig=1'
+    assert conn.get_option('transfer_method') == 'scp'
+    assert conn.get_option('retries') == 2
+
+    monkeypatch.setenv('ANSIBLE_SSH_COMMON_ARGS', '-o FromEnv=1')
+    conn.set_options()
+    assert conn.get_option('ssh_common_args') == '-o FromEnv=1'
+
+    pc.ssh_common_args = '-o FromCLI=1'
+    conn.set_options()
+    assert conn.get_option('ssh_common_args') == '-o FromCLI=1'
+
+    conn.set_options(var_options={'ansible_ssh_common_args': '-o FromInventory=1'})
+    assert conn.get_option('ssh_common_args') == '-o FromInventory=1'
+
+
+def test_ssh_timeout_distinguishes_cli_from_default(tmp_path, monkeypatch):
+    config = tmp_path / 'ansible.cfg'
+    config.write_text('[ssh_connection]\ntimeout = 25\n')
+    monkeypatch.setattr(C.config, '_config_file', str(config))
+    pc = PlayContext()
+    pc.timeout = C.DEFAULT_TIMEOUT
+    conn = connection_loader.get('ssh', pc, StringIO())
+
+    monkeypatch.setattr(ssh.context, 'CLIARGS', {})
+    conn.set_options(task_keys={'timeout': C.DEFAULT_TIMEOUT})
+    assert conn.get_option('timeout') == 25
+
+    monkeypatch.setattr(ssh.context, 'CLIARGS', {'timeout': C.DEFAULT_TIMEOUT})
+    conn.set_options(task_keys={'timeout': C.DEFAULT_TIMEOUT})
+    assert conn.get_option('timeout') == C.DEFAULT_TIMEOUT
+
+
+def test_ssh_build_command_uses_resolved_options(tmp_path):
+    pc = PlayContext()
+    pc.remote_addr = 'example.test'
+    conn = connection_loader.get('ssh', pc, StringIO())
+    conn.set_options(direct={
+        'ssh_args': '-o ControlMaster=auto -o ControlPersist=60s',
+        'ssh_common_args': '-o Common=1',
+        'ssh_extra_args': '-o Extra=1',
+        'control_path': '%(directory)s/socket',
+        'control_path_dir': str(tmp_path),
+        'port': 2222,
+        'remote_user': 'resolved-user',
+        'private_key_file': '/tmp/resolved-key',
+        'timeout': 23,
+    })
+    command = conn._build_command('ssh', 'ssh', 'example.test', 'true')
+    assert b'Common=1' in command
+    assert b'Extra=1' in command
+    assert b'Port=2222' in command
+    assert b'User="resolved-user"' in command
+    assert b'IdentityFile="/tmp/resolved-key"' in command
+    assert b'ConnectTimeout=23' in command
+    assert b'ControlPath=' + to_bytes(str(tmp_path / 'socket')) in command
+
+
+def test_ssh_control_path_preserves_ssh_tokens(tmp_path):
