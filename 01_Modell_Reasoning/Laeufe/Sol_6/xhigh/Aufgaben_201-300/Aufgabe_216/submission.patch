+def test_ssh_transfer_method_controls_fallback():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.set_options(direct={'transfer_method': 'smart', 'retries': 0})
+    conn._build_command = MagicMock(return_value=[b'command'])
+    conn._bare_run = MagicMock(side_effect=[(1, b'', b'failed'), (0, b'', b'')])
+
+    conn._file_transport_command('/source', '/target', 'put')
+    assert [call[0][1] for call in conn._build_command.call_args_list] == ['sftp', 'scp']
+
+    conn.set_options(direct={'transfer_method': 'scp', 'retries': 0})
+    conn._build_command.reset_mock()
+    conn._bare_run.reset_mock(side_effect=True)
+    conn._bare_run.return_value = (0, b'', b'')
+    conn._file_transport_command('/source', '/target', 'put')
+    assert [call[0][1] for call in conn._build_command.call_args_list] == ['scp']
+
