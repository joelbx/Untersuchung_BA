+@pytest.mark.parametrize('check_status, expected_calls', [(1, 1), (0, 2)])
+def test_ssh_reset_checks_effective_socket(tmp_path, monkeypatch, check_status, expected_calls):
+    pc = PlayContext()
+    pc.remote_addr = 'example.test'
+    conn = connection_loader.get('ssh', pc, StringIO())
+    conn.set_options(direct={
+        'ssh_executable': 'custom-ssh',
+        'ssh_args': '-o ControlMaster=auto -o ControlPersist=60s',
+        'control_path': '%(directory)s/socket',
+        'control_path_dir': str(tmp_path),
+        'remote_user': 'resolved-user',
+        'port': 2222,
+    })
+    commands = []
+    statuses = [check_status, 0]
+
+    def fake_popen(command, **kwargs):
+        commands.append(list(command))
+        process = MagicMock()
+        process.communicate.return_value = (b'', b'')
+        process.wait.return_value = statuses.pop(0)
+        return process
+
+    monkeypatch.setattr(ssh.subprocess, 'Popen', fake_popen)
+    debug = MagicMock()
+    monkeypatch.setattr(ssh.display, 'debug', debug)
+    conn.reset()
+
+    assert len(commands) == expected_calls
+    assert commands[0][0] == b'custom-ssh'
+    assert commands[0][-3:] == [b'-O', b'check', b'example.test']
+    assert b'ControlPath=' + to_bytes(str(tmp_path / 'socket')) in commands[0]
+    assert b'User="resolved-user"' in commands[0]
+    assert b'Port=2222' in commands[0]
+    if check_status == 0:
+        assert commands[1][:-2] == commands[0][:-2]
+        assert commands[1][-2:] == [b'stop', b'example.test']
+    else:
+        assert debug.called
