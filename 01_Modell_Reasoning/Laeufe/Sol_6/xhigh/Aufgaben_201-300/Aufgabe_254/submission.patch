+func TestInstanceMetadataClientIsAvailable(t *testing.T) {
+	testCases := []struct {
+		name       string
+		instanceID string
+		available  bool
+	}{
+		{name: "short instance ID", instanceID: "i-1a2b3c4d", available: true},
+		{name: "long instance ID", instanceID: "i-1234567890abcdef0", available: true},
+		{name: "captive portal page", instanceID: "<!DOCTYPE html><html>Login</html>"},
+		{name: "wrong length", instanceID: "i-123456789"},
+		{name: "uppercase digits", instanceID: "i-1A2B3C4D"},
+		{name: "trailing newline", instanceID: "i-1a2b3c4d\n"},
+		{name: "extra content", instanceID: "i-1a2b3c4d\n<html>Login</html>"},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var metadataRequested int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch {
+				case r.Method == http.MethodPut && r.URL.Path == "/latest/api/token":
+					_, _ = w.Write([]byte("test-token"))
+				case r.Method == http.MethodGet && r.URL.Path == "/latest/meta-data/instance-id":
+					atomic.StoreInt32(&metadataRequested, 1)
+					_, _ = w.Write([]byte(tc.instanceID))
+				default:
+					http.NotFound(w, r)
+				}
+			}))
+			defer server.Close()
+
+			imdsClient := imds.New(imds.Options{Endpoint: server.URL, HTTPClient: server.Client()})
+			client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(imdsClient))
+			require.NoError(t, err)
+			assert.Equal(t, tc.available, client.IsAvailable(context.Background()))
+			assert.Equal(t, int32(1), atomic.LoadInt32(&metadataRequested), "availability check must retrieve instance-id")
+		})
+	}
+}
