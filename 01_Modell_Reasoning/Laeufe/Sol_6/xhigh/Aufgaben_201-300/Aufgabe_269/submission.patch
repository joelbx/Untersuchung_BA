@@ -0,0 +1,56 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2020, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	base := dbtypes.Vulnerability{
+		Title: "title", Description: "summary", References: []string{"https://example.test/advisory"},
+		PublishedDate: &published, LastModifiedDate: &modified,
+		CVSS: dbtypes.VendorCVSS{
+			"nvd": {V2Score: 4.3, V2Vector: "AV:N", V3Score: 7.5, V3Vector: "CVSS:3.1/AV:N"},
+		},
+	}
+	debian := types.DetectedVulnerability{VulnerabilityID: "CVE-2020-0001", PkgName: "liba", SeveritySource: "debian", Vulnerability: base}
+	debian.Severity = "LOW"
+	ubuntu := types.DetectedVulnerability{VulnerabilityID: "CVE-2020-0001", PkgName: "libb", SeveritySource: "ubuntu", Vulnerability: base}
+	ubuntu.Severity = "MEDIUM"
+	results := types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{debian}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{ubuntu}},
+	}
+	scan, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := scan.ScannedCves["CVE-2020-0001"].CveContents
+	if len(contents) != 3 {
+		t.Fatalf("got %d sources, want 3: %#v", len(contents), contents)
+	}
+	for source, severity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyNVD: "",
+	} {
+		entries := contents[source]
+		if len(entries) != 1 {
+			t.Fatalf("%s has %d entries, want 1", source, len(entries))
+		}
+		entry := entries[0]
+		if entry.Type != source || entry.CveID != "CVE-2020-0001" || entry.Title != "title" || entry.Summary != "summary" || entry.Cvss3Severity != severity || !entry.Published.Equal(published) || !entry.LastModified.Equal(modified) || len(entry.References) != 1 {
+			t.Errorf("unexpected %s content: %#v", source, entry)
+		}
+	}
+	nvd := contents[models.TrivyNVD][0]
+	if nvd.Cvss2Score != 4.3 || nvd.Cvss2Vector != "AV:N" || nvd.Cvss3Score != 7.5 || nvd.Cvss3Vector != "CVSS:3.1/AV:N" {
+		t.Errorf("NVD scores lost: %#v", nvd)
+	}
+}
