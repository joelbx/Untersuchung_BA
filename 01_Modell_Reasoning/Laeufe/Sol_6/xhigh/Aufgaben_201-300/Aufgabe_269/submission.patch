+func TestTrivySourceMetadata(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, Title: "Debian title", Summary: "Debian summary", Cvss3Severity: "LOW"}},
+		TrivyUbuntu: {{Type: TrivyUbuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "MEDIUM"}},
+		TrivyNVD:    {{Type: TrivyNVD, Summary: "NVD summary", Cvss2Score: 4.3, Cvss2Vector: "AV:N", Cvss3Score: 7.5, Cvss3Vector: "CVSS:3.1/AV:N"}},
+	}}
+	for _, want := range []CveContentStr{{TrivyDebian, "Debian title"}, {TrivyUbuntu, "Ubuntu title"}, {TrivyNVD, "NVD summary"}} {
+		if !containsCveContentStr(v.Titles("en", "debian"), want) {
+			t.Errorf("Titles missing %#v", want)
+		}
+	}
+	for _, want := range []CveContentStr{{TrivyDebian, "Debian summary"}, {TrivyUbuntu, "Ubuntu summary"}, {TrivyNVD, "NVD summary"}} {
+		if !containsCveContentStr(v.Summaries("en", "debian"), want) {
+			t.Errorf("Summaries missing %#v", want)
+		}
+	}
+	if scores := v.Cvss2Scores(); len(scores) != 1 || scores[0].Type != TrivyNVD || scores[0].Value.Score != 4.3 {
+		t.Errorf("Cvss2Scores = %#v", scores)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 3 {
+		t.Fatalf("Cvss3Scores = %#v", scores)
+	}
+	byType := map[CveContentType]Cvss{}
+	for _, score := range scores {
+		byType[score.Type] = score.Value
+	}
+	if byType[TrivyDebian].Severity != "LOW" || byType[TrivyUbuntu].Severity != "MEDIUM" || byType[TrivyNVD].Score != 7.5 || byType[TrivyNVD].CalculatedBySeverity {
+		t.Errorf("Cvss3Scores = %#v", byType)
+	}
+}
