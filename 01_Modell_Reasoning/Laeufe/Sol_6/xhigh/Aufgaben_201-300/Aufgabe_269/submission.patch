--- /dev/null
+++ b/contrib/trivy/pkg/cvecontents.go
@@ -0,0 +1,71 @@
+package pkg
+
+import (
+	"sort"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+// ConvertCveContents preserves the severity and CVSS reported by each Trivy source.
+func ConvertCveContents(cveID string, vul trivydbTypes.Vulnerability, severitySource trivydbTypes.SourceID) models.CveContents {
+	sources := map[trivydbTypes.SourceID]struct{}{}
+	for source := range vul.VendorSeverity {
+		sources[source] = struct{}{}
+	}
+	for source := range vul.CVSS {
+		sources[source] = struct{}{}
+	}
+	if severitySource != "" {
+		sources[severitySource] = struct{}{}
+	}
+	if len(sources) == 0 {
+		sources["unknown"] = struct{}{}
+	}
+
+	references := make(models.References, 0, len(vul.References))
+	for _, reference := range vul.References {
+		references = append(references, models.Reference{Source: "trivy", Link: reference})
+	}
+	sort.Slice(references, func(i, j int) bool { return references[i].Link < references[j].Link })
+
+	var published, lastModified time.Time
+	if vul.PublishedDate != nil {
+		published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		lastModified = *vul.LastModifiedDate
+	}
+
+	contents := models.CveContents{}
+	for source := range sources {
+		if source == "" {
+			source = "unknown"
+		}
+		ctype := models.CveContentType("trivy:" + string(source))
+		cvss := vul.CVSS[source]
+		severity := ""
+		if vendorSeverity, ok := vul.VendorSeverity[source]; ok {
+			severity = vendorSeverity.String()
+		} else if source == severitySource || (source == "unknown" && severitySource == "") {
+			severity = vul.Severity
+		}
+		contents[ctype] = []models.CveContent{{
+			Type:          ctype,
+			CveID:         cveID,
+			Title:         vul.Title,
+			Summary:       vul.Description,
+			Cvss2Score:    cvss.V2Score,
+			Cvss2Vector:   cvss.V2Vector,
+			Cvss3Score:    cvss.V3Score,
+			Cvss3Vector:   cvss.V3Vector,
+			Cvss3Severity: severity,
+			References:    references,
+			Published:     published,
+			LastModified:  lastModified,
+		}}
+	}
+	return contents
+}
