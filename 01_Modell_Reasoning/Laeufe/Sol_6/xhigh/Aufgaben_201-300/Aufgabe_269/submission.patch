+	if contents[models.TrivyNVD][0].Cvss2Score != 5.0 || contents[models.TrivyNVD][0].Cvss2Vector != "AV:N" || contents[models.TrivyNVD][0].Cvss3Score != 8.1 || contents[models.TrivyNVD][0].Cvss3Vector != "CVSS:3.1/AV:N" {
+		t.Errorf("NVD CVSS lost: %#v", contents[models.TrivyNVD][0])
+	}
+}
