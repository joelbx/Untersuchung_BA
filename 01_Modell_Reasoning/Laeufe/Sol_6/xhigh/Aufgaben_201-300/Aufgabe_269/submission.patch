+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsPreservesVendorSeverity(t *testing.T) {
+	published := time.Date(2021, 2, 3, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	contents := getCveContents("CVE-2021-0001", dbtypes.Vulnerability{
+		Title: "title", Description: "summary", References: []string{"https://example.test/cve"},
+		PublishedDate: &published, LastModifiedDate: &modified,
+		VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "ubuntu": dbtypes.SeverityMedium, "redhat": dbtypes.SeverityHigh},
+		CVSS:           dbtypes.VendorCVSS{"nvd": {V2Score: 5.0, V2Vector: "AV:N", V3Score: 8.1, V3Vector: "CVSS:3.1/AV:N"}},
+	})
+	for ctype, severity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyRedHat: "HIGH", models.TrivyNVD: "",
+	} {
+		entries := contents[ctype]
+		if len(entries) != 1 {
+			t.Fatalf("%s has %d entries, want 1", ctype, len(entries))
+		}
+		entry := entries[0]
+		if entry.Type != ctype || entry.CveID != "CVE-2021-0001" || entry.Cvss3Severity != severity || entry.Title != "title" || entry.Summary != "summary" || !entry.Published.Equal(published) || !entry.LastModified.Equal(modified) || len(entry.References) != 1 {
