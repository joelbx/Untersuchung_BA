+func convertKEVulns(source kevulndb.Response) (kevs []models.KEV) {
+	for _, cisa := range source.CISA {
+		kevs = append(kevs, models.KEV{
+			Type:                       models.CISAKEVType,
+			VendorProject:              cisa.VendorProject,
+			Product:                    cisa.Product,
+			VulnerabilityName:          cisa.VulnerabilityName,
+			ShortDescription:           cisa.ShortDescription,
+			RequiredAction:             cisa.RequiredAction,
+			KnownRansomwareCampaignUse: cisa.KnownRansomwareCampaignUse,
+			DateAdded:                  cisa.DateAdded,
+			DueDate:                    validKEVDueDate(&cisa.DueDate),
+			CISA:                       &models.CISAKEV{Note: cisa.Notes},
+		})
+	}
+	for _, vulncheck := range source.VulnCheck {
+		entry := models.KEV{
+			Type:                       models.VulnCheckKEVType,
+			VendorProject:              vulncheck.VendorProject,
+			Product:                    vulncheck.Product,
+			VulnerabilityName:          vulncheck.Name,
+			ShortDescription:           vulncheck.Description,
+			RequiredAction:             vulncheck.RequiredAction,
+			KnownRansomwareCampaignUse: vulncheck.KnownRansomwareCampaignUse,
+			DateAdded:                  vulncheck.DateAdded,
+			DueDate:                    validKEVDueDate(vulncheck.DueDate),
+			VulnCheck:                  &models.VulnCheckKEV{},
+		}
+		for _, xdb := range vulncheck.VulnCheckXDB {
+			entry.VulnCheck.XDB = append(entry.VulnCheck.XDB, models.VulnCheckXDB{
+				XDBID:       xdb.XDBID,
+				XDBURL:      xdb.XDBURL,
+				DateAdded:   xdb.DateAdded,
+				ExploitType: xdb.ExploitType,
+				CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, report := range vulncheck.VulnCheckReportedExploitation {
+			entry.VulnCheck.ReportedExploitation = append(entry.VulnCheck.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL:       report.URL,
+				DateAdded: report.DateAdded,
+			})
+		}
+		kevs = append(kevs, entry)
+	}
+	return kevs
+}
+
+func validKEVDueDate(date *time.Time) *time.Time {
+	if date == nil || date.IsZero() || date.Equal(time.Date(1000, time.January, 1, 0, 0, 0, 0, time.UTC)) {
+		return nil
+	}
+	return date
+}
