+
+func TestConvertKEVulns(t *testing.T) {
+	added := time.Date(2024, 8, 30, 0, 0, 0, 0, time.UTC)
+	due := added.AddDate(0, 0, 21)
+	invalidDue := time.Date(1000, time.January, 1, 0, 0, 0, 0, time.UTC)
+	source := kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{
+			{
+				VendorProject: "CISA vendor", Product: "CISA product",
+				VulnerabilityName: "CISA name", ShortDescription: "CISA description",
+				RequiredAction: "CISA action", KnownRansomwareCampaignUse: "Known",
+				DateAdded: added, DueDate: invalidDue, Notes: "CISA note",
+			},
+			{VulnerabilityName: "CISA with due date", DueDate: due},
+		},
+		VulnCheck: []kevulnmodels.VulnCheck{
+			{
+				VendorProject: "VulnCheck vendor", Product: "VulnCheck product",
+				Name: "VulnCheck name", Description: "VulnCheck description",
+				RequiredAction: "VulnCheck action", KnownRansomwareCampaignUse: "Unknown",
+				DateAdded: added, DueDate: &due,
+				VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{
+					XDBID: "XDB-1", XDBURL: "https://example.com/xdb",
+					DateAdded: added, ExploitType: "poc", CloneSSHURL: "git@example.com:xdb",
+				}},
+				VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{
+					URL: "https://example.com/report", DateAdded: added,
+				}},
+			},
+			{DueDate: new(time.Time)},
+		},
+	}
+	want := []models.KEV{
+		{
+			Type: models.CISAKEVType, VendorProject: "CISA vendor", Product: "CISA product",
+			VulnerabilityName: "CISA name", ShortDescription: "CISA description",
+			RequiredAction: "CISA action", KnownRansomwareCampaignUse: "Known",
+			DateAdded: added, CISA: &models.CISAKEV{Note: "CISA note"},
+		},
+		{Type: models.CISAKEVType, VulnerabilityName: "CISA with due date", DueDate: &due, CISA: &models.CISAKEV{}},
+		{
+			Type: models.VulnCheckKEVType, VendorProject: "VulnCheck vendor", Product: "VulnCheck product",
+			VulnerabilityName: "VulnCheck name", ShortDescription: "VulnCheck description",
+			RequiredAction: "VulnCheck action", KnownRansomwareCampaignUse: "Unknown",
+			DateAdded: added, DueDate: &due,
+			VulnCheck: &models.VulnCheckKEV{
+				XDB: []models.VulnCheckXDB{{
+					XDBID: "XDB-1", XDBURL: "https://example.com/xdb",
+					DateAdded: added, ExploitType: "poc", CloneSSHURL: "git@example.com:xdb",
+				}},
+				ReportedExploitation: []models.VulnCheckReportedExploitation{{
+					URL: "https://example.com/report", DateAdded: added,
+				}},
+			},
+		},
+		{Type: models.VulnCheckKEVType, VulnCheck: &models.VulnCheckKEV{}},
+	}
+	if got := convertKEVulns(source); !reflect.DeepEqual(got, want) {
+		t.Errorf("converted KEVs = %#v, want %#v", got, want)
+	}
+}
