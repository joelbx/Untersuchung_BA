diff --git a/tests/unit/config/test_qtargs.py b/tests/unit/config/test_qtargs.py
index b38158f..1a7a947 100644
--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -87,6 +87,58 @@ class TestQtArgs:
         for arg in ['--foo', '--bar']:
             assert arg in args
 
+    def test_combines_enabled_features(self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.scrolling.bar = 'overlay'
+        config_stub.val.qt.args = ['enable-features=ConfigOne,ConfigTwo',
+                                   'enable-features=ConfigThree']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CliOne,CliTwo',
+            '--qt-arg', 'enable-features', 'CliThree',
+        ])
+
+        args = qtargs.qt_args(parsed)
+        feature_args = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+        assert '--enable-features' not in args
+        assert feature_args == [
+            '--enable-features=CliOne,CliTwo,CliThree,ConfigOne,ConfigTwo,'
+            'ConfigThree,OverlayScrollbar'
+        ]
+
+    def test_webkit_keeps_enabled_features(self, config_stub, monkeypatch,
+                                           parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebKit)
+        config_stub.val.qt.args = ['enable-features=ConfigFeature']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CliFeature',
+            '--qt-arg', 'enable-features', 'SeparateFeature',
+        ])
+
+        assert qtargs.qt_args(parsed) == [
+            sys.argv[0], '--enable-features=CliFeature',
+            '--enable-features', 'SeparateFeature',
+            '--enable-features=ConfigFeature',
+        ]
+
+    def test_enabled_features_helpers(self, config_stub, parser):
+        config_stub.val.scrolling.bar = 'never'
+        parsed = parser.parse_args([])
+        flags = ['--enable-features=First,Second',
+                 '--enable-features=Third']
+
+        assert list(qtargs._qtwebengine_enabled_features(flags)) == [
+            'First', 'Second', 'Third'
+        ]
+        args = list(qtargs._qtwebengine_args(parsed, flags))
+        assert [arg for arg in args if arg.startswith('--enable-features=')] == [
+            '--enable-features=First,Second,Third'
+        ]
+        assert not any(arg.startswith('--enable-features=') for arg in
+                       qtargs._qtwebengine_args(parsed, []))
+
     @pytest.mark.parametrize('backend, expected', [
         (usertypes.Backend.QtWebEngine, True),
         (usertypes.Backend.QtWebKit, False),
