+}
+
+// The caller holds mu. Scanning after the sweep schedules the next eviction
+// without changing the cache's least recently used order.
+func (c *simpleCache[K, V]) evictExpiredLocked() {
+	deadline := c.evictionDeadline.Load()
+	if deadline == nil || time.Now().Before(*deadline) {
+		return
+	}
+
+	c.data.DeleteExpired()
+	var next time.Time
+	c.data.Range(func(item *ttlcache.Item[K, V]) bool {
+		expiresAt := item.ExpiresAt()
+		if !expiresAt.IsZero() && (next.IsZero() || expiresAt.Before(next)) {
+			next = expiresAt
+		}
+		return true
+	})
+	if next.IsZero() {
+		c.evictionDeadline.Store(nil)
+	} else {
+		c.evictionDeadline.Store(&next)
+	}
+}
+
+// The caller holds mu, so no other insertion or sweep can change the deadline.
+func (c *simpleCache[K, V]) advanceEvictionDeadline(expiresAt time.Time) {
+	if expiresAt.IsZero() {
+		return
+	}
+	deadline := c.evictionDeadline.Load()
+	if deadline == nil || expiresAt.Before(*deadline) {
+		c.evictionDeadline.Store(&expiresAt)
+	}
 }
