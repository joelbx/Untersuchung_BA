+@pytest.mark.parametrize(
+    'parent',
+    [
+        OrOperation(Word('old'), Word('keep'), Word('old')),
+        Group(Word('old')),
+        Not(Word('old')),
+    ],
+)
+def test_luqum_replace_child(parent: Item):
+    original_children = parent.children
+    old_child = Word('old')
+    replacement = Word('new')
+
+    assert luqum_replace_child(parent, old_child, replacement) is None
+    assert type(parent.children) is type(original_children)
+    assert len(parent.children) == len(original_children)
+    assert all(
+        actual is (replacement if old == old_child else old)
+        for actual, old in zip(parent.children, original_children)
+    )
+
+
+def test_luqum_replace_child_in_parsed_tree():
+    tree = luqum_parser('foo OR bar')
+    for node, parents in luqum_traverse(tree):
+        if node == Word('bar'):
+            luqum_replace_child(
+                parents[-1], node, Word('baz', head=node.head, tail=node.tail)
+            )
+            break
+
+    assert str(tree) == 'foo OR baz'
+
+
