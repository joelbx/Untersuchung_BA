new file mode 100644
index 0000000..fb1be11
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,57 @@
+package release
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running version and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version is a proper release version.
+func Is(version string) bool {
+	parsed, err := semver.ParseTolerant(version)
+	return err == nil && len(parsed.Pre) == 0
+}
+
+// Check looks up the latest release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	info, err := check(ctx, version, github.NewClient(nil))
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func check(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	latestRelease, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+
+	latest, err := semver.ParseTolerant(latestRelease.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latestRelease.GetTagName()
+	info.LatestVersionURL = latestRelease.GetHTMLURL()
+	info.UpdateAvailable = current.LT(latest)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..18cb880
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,94 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3", true},
+		{"1.2.3+build.1", true},
+		{"1.2.3-dev", false},
+		{"1.2.3-snapshot", false},
+		{"1.2.3-rc", false},
+		{"1.2.3-rc.1", false},
+		{"1.2.3-beta.1", false},
+		{"invalid", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			if got := Is(tt.version); got != tt.want {
+				t.Fatalf("Is(%q) = %v, want %v", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name            string
+		current, latest string
+		wantUpdate      bool
+	}{
+		{"newer", "v1.2.3", "v1.3.0", true},
+		{"same", "v1.2.3", "v1.2.3", false},
+		{"older", "v1.3.0", "v1.2.3", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+					t.Errorf("unexpected request path: %s", r.URL.Path)
+				}
+				_, _ = fmt.Fprintf(w, `{"tag_name":%q,"html_url":"https://example.com/latest"}`, tt.latest)
+			}))
+			defer server.Close()
+
+			client := github.NewClient(server.Client())
+			client.BaseURL, _ = url.Parse(server.URL + "/")
+			got, err := check(context.Background(), tt.current, client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.CurrentVersion != tt.current || got.LatestVersion != tt.latest || got.UpdateAvailable != tt.wantUpdate || got.LatestVersionURL != "https://example.com/latest" {
+				t.Fatalf("unexpected release info: %+v", got)
+			}
+		})
+	}
+}
+
+func TestCheckWarnsOnFailure(t *testing.T) {
+	core, logs := observer.New(zapcore.WarnLevel)
+	restore := zap.ReplaceGlobals(zap.New(core))
+	defer restore()
+
+	got, err := Check(context.Background(), "invalid")
+	if err == nil {
+		t.Fatal("expected invalid version error")
+	}
+	if got.CurrentVersion != "invalid" {
+		t.Fatalf("current version = %q", got.CurrentVersion)
+	}
+	entries := logs.All()
+	if len(entries) != 1 || entries[0].Message != "checking for updates" || !strings.Contains(entries[0].ContextMap()["error"].(string), "parsing current version") {
+		t.Fatalf("unexpected warning: %+v", entries)
+	}
+}
