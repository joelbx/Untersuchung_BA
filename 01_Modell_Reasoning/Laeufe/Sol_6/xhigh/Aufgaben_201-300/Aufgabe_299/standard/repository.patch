+def test_filesystem_category(qtmodeltester, config_stub, quickmark_manager_stub,
+                             bookmark_manager_stub, info, tmp_path):
+    """Filesystem follows the configured order and stays visible when empty."""
+    favorite = str(tmp_path / 'favorite.html')
+    quickmark_manager_stub.marks = {'local': 'https://example.com'}
+    config_stub.val.completion.favorite_paths = [favorite]
+    config_stub.val.completion.open_categories = ['filesystem', 'quickmarks',
+                                                  'bookmarks']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    _check_completions(model, {
+        'Filesystem': [(favorite, None, None)],
+        'Quickmarks': [('https://example.com', 'local', None)],
+    })
+    names = [model.data(model.index(row, 0))
+             for row in range(model.rowCount())]
+    assert names == [
+        'Filesystem', 'Quickmarks']
+
+    model.set_pattern('relative/path')
+    _check_completions(model, {'Filesystem': [], 'Quickmarks': []})
+
+    config_stub.val.completion.open_categories = ['quickmarks', 'bookmarks']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    _check_completions(model, {
+        'Quickmarks': [('https://example.com', 'local', None)],
+    })
+
+
