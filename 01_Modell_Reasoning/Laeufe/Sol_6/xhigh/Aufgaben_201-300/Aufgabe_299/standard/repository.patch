+"""Completion category for local filesystem paths."""
+
+import os
+import re
+from urllib import parse
+
+from PyQt5.QtCore import QAbstractListModel, QModelIndex, Qt
+
+from qutebrowser.config import config
+
+
+class FilePathCategory(QAbstractListModel):
+
+    """Expose matching local paths as a completion category."""
+
+    def __init__(self, name: str, parent=None):
+        super().__init__(parent)
+        self.name = name
+        self.columns_to_filter = [0]
+        self.delete_func = None
+        self._paths = []
+
+    def set_pattern(self, val: str) -> None:
+        """Update suggestions for a path, a local file URL, or a home path."""
+        if not val:
+            paths = list(config.val.completion.favorite_paths or [])
+        else:
+            paths = self._matches(val)
+        self.beginResetModel()
+        self._paths = paths
+        self.endResetModel()
+
+    def _matches(self, val: str):
+        """Find matching children, retaining the form used in the input."""
+        is_url = val.startswith('file:///')
+        if is_url:
+            try:
+                url = parse.urlsplit(val)
+            except ValueError:
+                return []
+            if (url.scheme != 'file' or url.netloc or url.query or
+                    url.fragment or re.search(r'%(?![0-9a-fA-F]{2})',
+                                              url.path)):
+                return []
+            path = parse.unquote(url.path)
+        elif val.startswith('~'):
+            path = os.path.expanduser(val)
+        elif os.path.isabs(val):
+            path = val
+        else:
+            return []
+
+        if not os.path.isabs(path):
+            return []
+
+        # A trailing separator means the user wants children of that directory.
+        # A bare home directory is treated the same way, making it useful
+        # immediately after typing the tilde (or a user name).
+        bare_home = val.startswith('~') and '/' not in val and path != val
+        if path.endswith(os.sep) or bare_home:
+            directory, prefix = path, ''
+            display_base = val if val.endswith('/') else val + '/'
+        else:
+            directory, prefix = os.path.split(path)
+            display_base = val[:val.rfind('/') + 1]
+
+        try:
+            with os.scandir(directory) as entries:
+                matches = sorted((entry.name, entry.is_dir())
+                                 for entry in entries
+                                 if entry.name.startswith(prefix))
+        except (OSError, ValueError):
+            return []
+
+        paths = []
+        for name, is_dir in matches:
+            if is_url:
+                suggestion = 'file://' + parse.quote(
+                    os.path.join(directory, name), safe='/')
+            else:
+                suggestion = display_base + name
+            if is_dir:
+                suggestion += '/'
+            paths.append(suggestion)
+        return paths
+
+    def data(self, index: QModelIndex, role: int = Qt.DisplayRole):
+        """Return a path in the first column, if the index is valid."""
+        if (role != Qt.DisplayRole or not index.isValid() or
+                index.column() != 0 or not 0 <= index.row() < len(self._paths)):
+            return None
+        return self._paths[index.row()]
+
+    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:
+        """Return the number of path suggestions."""
+        return 0 if parent.isValid() else len(self._paths)
