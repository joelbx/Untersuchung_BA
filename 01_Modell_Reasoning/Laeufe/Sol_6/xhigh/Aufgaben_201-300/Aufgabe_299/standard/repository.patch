+
+"""Tests for local path completion."""
+
+from PyQt5.QtCore import QModelIndex, Qt
+
+from qutebrowser.completion.models import filepathcategory
+
+
+def _suggestions(category):
+    return [category.data(category.index(row, 0))
+            for row in range(category.rowCount())]
+
+
+def test_favorite_paths(config_stub, qtmodeltester):
+    favorites = ['~/site.html', '/tmp/a path', 'file:///tmp/other']
+    config_stub.val.completion.favorite_paths = favorites
+    category = filepathcategory.FilePathCategory('Filesystem')
+    category.set_pattern('')
+    qtmodeltester.check(category)
+    assert _suggestions(category) == favorites
+    assert category.rowCount(category.index(0, 0)) == 0
+    assert category.data(QModelIndex()) is None
+    assert category.data(category.index(0, 0), Qt.ToolTipRole) is None
+    assert category.data(category.index(0, 1)) is None
+
+
+def test_local_paths(config_stub, tmp_path, monkeypatch, qtmodeltester):
+    home = tmp_path / 'home'
+    home.mkdir()
+    (home / 'alpha.html').touch()
+    (home / 'a space.html').touch()
+    (home / 'assets').mkdir()
+    (home / 'beta.html').touch()
+    monkeypatch.setenv('HOME', str(home))
+    category = filepathcategory.FilePathCategory('Filesystem')
+
+    category.set_pattern(str(home) + '/')
+    qtmodeltester.check(category)
+    assert _suggestions(category) == [
+        str(home / 'a space.html'),
+        str(home / 'alpha.html'),
+        str(home / 'assets') + '/',
+        str(home / 'beta.html'),
+    ]
+
+    category.set_pattern(str(home / 'al'))
+    assert _suggestions(category) == [str(home / 'alpha.html')]
+
+    category.set_pattern(home.as_uri() + '/')
+    assert _suggestions(category) == [
+        (home / 'a space.html').as_uri(),
+        (home / 'alpha.html').as_uri(),
+        (home / 'assets').as_uri() + '/',
+        (home / 'beta.html').as_uri(),
+    ]
+
+    category.set_pattern('~/a')
+    assert _suggestions(category) == [
+        '~/a space.html', '~/alpha.html', '~/assets/']
+
+    category.set_pattern('~')
+    assert _suggestions(category) == [
+        '~/a space.html', '~/alpha.html', '~/assets/', '~/beta.html']
+
+
+def test_invalid_or_nonlocal_paths(config_stub, tmp_path):
+    category = filepathcategory.FilePathCategory('Filesystem')
+    for pattern in ('example.com', 'relative/path', 'https://example.com',
+                    'file://server/path', 'file:///tmp/%wrong',
+                    str(tmp_path / 'missing') + '/', 'file:///[invalid'):
+        category.set_pattern(pattern)
+        assert _suggestions(category) == []
