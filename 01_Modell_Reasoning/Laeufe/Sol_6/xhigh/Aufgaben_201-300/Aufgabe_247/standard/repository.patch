diff --git a/test/socket-posts-upvoters.js b/test/socket-posts-upvoters.js
new file mode 100644
index 0000000..3db7c02
--- /dev/null
+++ b/test/socket-posts-upvoters.js
@@ -0,0 +1,81 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const Module = require('module');
+const path = require('path');
+
+const posts = {};
+const user = {};
+const privileges = { categories: {} };
+const SocketPosts = {};
+
+const filename = path.join(__dirname, '../src/socket.io/posts/votes.js');
+const votesModule = new Module(filename, module);
+votesModule.filename = filename;
+votesModule.require = request => ({
+	'../../database': {},
+	'../../user': user,
+	'../../posts': posts,
+	'../../privileges': privileges,
+	'../../meta': {},
+})[request];
+votesModule._compile(fs.readFileSync(filename, 'utf8'), filename);
+votesModule.exports(SocketPosts);
+
+describe('SocketPosts.getUpvoters', () => {
+	it('denies the entire request when any post category is unreadable', async () => {
+		posts.getCidsByPids = async (pids) => {
+			assert.deepStrictEqual(pids, [10, 20]);
+			return [1, 2];
+		};
+		user.isAdministrator = async () => false;
+		privileges.categories.filterCids = async (privilege, cids, uid) => {
+			assert.strictEqual(privilege, 'topics:read');
+			assert.deepStrictEqual(cids, [1, 2]);
+			assert.strictEqual(uid, 0);
+			return [1];
+		};
+		posts.getUpvotedUidsByPids = async () => {
+			assert.fail('votes must not be fetched before authorization');
+		};
+
+		await assert.rejects(SocketPosts.getUpvoters({ uid: 0 }, [10, 20]), {
+			message: '[[error:no-privileges]]',
+		});
+	});
+
+	it('allows administrators regardless of category privileges', async () => {
+		posts.getCidsByPids = async () => [1, 2];
+		user.isAdministrator = async () => true;
+		privileges.categories.filterCids = async () => {
+			assert.fail('administrators should bypass category restrictions');
+		};
+		posts.getUpvotedUidsByPids = async () => [[5], []];
+		user.getUsernamesByUids = async uids => uids.map(uid => `user${uid}`);
+
+		assert.deepStrictEqual(await SocketPosts.getUpvoters({ uid: 1 }, [10, 20]), [
+			{ otherCount: 0, usernames: ['user5'], cutoff: 6 },
+			{ otherCount: 0, usernames: [], cutoff: 6 },
+		]);
+	});
+
+	it('resolves each visible UID once and preserves vote order at the cutoff', async () => {
+		posts.getCidsByPids = async () => [1, 1];
+		user.isAdministrator = async () => false;
+		privileges.categories.filterCids = async (privilege, cids) => {
+			assert.deepStrictEqual(cids, [1]);
+			return [1];
+		};
+		posts.getUpvotedUidsByPids = async () => [[5, 1, 3, 2, 4, 6], [3, 5, 7, 1]];
+		user.getUsernamesByUids = async (uids) => {
+			assert.deepStrictEqual(uids, [5, 1, 3, 2, 4, 7]);
+			return uids.map(uid => `user${uid}`);
+		};
+
+		assert.deepStrictEqual(await SocketPosts.getUpvoters({ uid: 9 }, [10, 20]), [
+			{ otherCount: 1, usernames: ['user5', 'user1', 'user3', 'user2', 'user4'], cutoff: 6 },
+			{ otherCount: 0, usernames: ['user3', 'user5', 'user7', 'user1'], cutoff: 6 },
+		]);
+	});
+});
