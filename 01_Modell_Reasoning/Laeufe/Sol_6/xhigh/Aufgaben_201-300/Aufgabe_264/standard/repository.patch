+def test_rate_limit_then_success(module, mocker):
+    url = 'https://api.meraki.com/api/v0/resources'
+    responses = [
+        (None, {'status': 429, 'msg': 'rate limited'}),
+        (None, {'status': 429, 'msg': 'rate limited'}),
+        (mock.Mock(read=mock.Mock(return_value=b'{"ok": true}')), {'status': 200, 'msg': 'OK'}),
+    ]
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url', side_effect=responses)
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    warn = mocker.patch.object(module.module, 'warn')
+
+    assert module.request('/resources', method='POST', payload='{}') == {'ok': True}
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert all(call[0][1] == url and call[1]['data'] == '{}' and call[1]['method'] == 'POST'
+               for call in fetch.call_args_list)
+    assert [call[0][0] for call in sleep.call_args_list] == [1, 2]
+    assert '2 time(s)' in warn.call_args[0][0]
+
+
