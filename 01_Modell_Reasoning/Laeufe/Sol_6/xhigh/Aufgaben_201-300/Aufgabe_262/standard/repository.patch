+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('https://EXAMPLE.COM/cover.jpg', 'https://EXAMPLE.COM/cover.jpg'),
+        ('HTTP://example.com/cover.jpg', 'HTTP://example.com/cover.jpg'),
+        ('https://other.example.com/cover.jpg', None),
+        ('https://example.com.evil.org/cover.jpg', None),
+        ('ftp://example.com/cover.jpg', None),
+        ('https://[invalid/cover.jpg', None),
+        (None, None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'Test', 'cover': cover}
+    url, updated_edition = process_cover_url(edition, ['ExAmPlE.CoM'])
+    assert url == expected
+    assert updated_edition is edition
+    assert edition == {'title': 'Test'}
+
+
+def test_process_cover_url_without_cover():
+    edition = {'title': 'Test'}
+    assert process_cover_url(edition) == (None, edition)
+    assert edition == {'title': 'Test'}
+
+
+def test_default_allowed_cover_hosts():
+    edition = {'cover': 'https://archive.org/cover.jpg'}
+    assert 'archive.org' in ALLOWED_COVER_HOSTS
+    assert process_cover_url(edition) == ('https://archive.org/cover.jpg', {})
