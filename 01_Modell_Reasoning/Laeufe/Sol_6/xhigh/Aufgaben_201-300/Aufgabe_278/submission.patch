diff --git a/applications/mail/src/app/logic/elements/elements.test.ts b/applications/mail/src/app/logic/elements/elements.test.ts
new file mode 100644
index 0000000..f0d817e
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elements.test.ts
@@ -0,0 +1,98 @@
+import { configureStore } from '@reduxjs/toolkit';
+import elementsReducer, { newState } from './elementsSlice';
+import { backendActionFinished, backendActionStarted, invalidate, load } from './elementsActions';
+import { shouldSendRequest } from './elementsSelectors';
+import { QueryParams } from './elementsTypes';
+
+const makeStore = () =>
+    configureStore({
+        reducer: elementsReducer,
+        middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+    });
+
+const makeRequest = (api: jest.Mock): QueryParams => ({
+    api: api as unknown as QueryParams['api'],
+    abortController: undefined,
+    conversationMode: true,
+    page: 0,
+    params: newState().params,
+});
+
+describe('elements loading', () => {
+    afterEach(() => {
+        jest.clearAllTimers();
+        jest.useRealTimers();
+    });
+
+    it('rejects stale responses and allows a fresh response after one second', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const api = jest
+            .fn()
+            .mockResolvedValueOnce({ Total: 1, Conversations: [{ ID: 'stale' }], Stale: 1 })
+            .mockResolvedValueOnce({ Total: 1, Conversations: [{ ID: 'fresh' }], Stale: 0 });
+        const request = makeRequest(api);
+
+        await store.dispatch(load(request));
+        expect(store.getState().elements).toEqual({});
+        expect(store.getState().pendingRequest).toBe(true);
+
+        jest.advanceTimersByTime(999);
+        expect(store.getState().pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().pendingRequest).toBe(false);
+        expect(store.getState().retry).toMatchObject({ count: 1, error: undefined });
+
+        await store.dispatch(load(request));
+        expect(Object.keys(store.getState().elements)).toEqual(['fresh']);
+    });
+
+    it('retries a failed refresh of a cached page after two seconds', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const error = new Error('request failed');
+        const api = jest
+            .fn()
+            .mockResolvedValueOnce({ Total: 1, Conversations: [{ ID: 'old' }], Stale: 0 })
+            .mockRejectedValueOnce(error)
+            .mockResolvedValueOnce({ Total: 1, Conversations: [{ ID: 'fresh' }], Stale: 0 });
+        const request = makeRequest(api);
+
+        await store.dispatch(load(request));
+        store.dispatch(invalidate());
+        await store.dispatch(load(request));
+
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().retry.error).toBe(error);
+        expect(store.getState().pendingRequest).toBe(false);
+        expect(shouldSendRequest({ elements: store.getState() } as any, { page: 0, params: request.params })).toBe(
+            true
+        );
+
+        await store.dispatch(load(request));
+        expect(store.getState().elements.fresh).toBeDefined();
+    });
+
+    it('waits for all backend actions and discards a request completed during them', async () => {
+        const store = makeStore();
+        const api = jest.fn().mockResolvedValue({ Total: 1, Conversations: [{ ID: 'old' }], Stale: 0 });
+        const request = makeRequest(api);
+
+        store.dispatch(backendActionStarted());
+        store.dispatch(backendActionStarted());
+        await store.dispatch(load(request));
+
+        expect(store.getState().elements).toEqual({});
+        expect(store.getState().pendingActions).toBe(2);
+        expect(store.getState().invalidated).toBe(true);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().pendingActions).toBe(1);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().pendingActions).toBe(0);
+        expect(shouldSendRequest({ elements: store.getState() } as any, { page: 0, params: request.params })).toBe(
+            true
+        );
+    });
+});
