diff --git a/applications/mail/src/app/hooks/useBackendAction.ts b/applications/mail/src/app/hooks/useBackendAction.ts
new file mode 100644
index 0000000..931c08a
--- /dev/null
+++ b/applications/mail/src/app/hooks/useBackendAction.ts
@@ -0,0 +1,20 @@
+import { useCallback } from 'react';
+import { useDispatch } from 'react-redux';
+import { backendActionFinished, backendActionStarted } from '../logic/elements/elementsActions';
+
+/** Keep the mailbox list from refreshing until a mutation and its event update have settled. */
+export const useBackendAction = () => {
+    const dispatch = useDispatch();
+
+    return useCallback(
+        async <T>(action: () => Promise<T>): Promise<T> => {
+            dispatch(backendActionStarted());
+            try {
+                return await action();
+            } finally {
+                dispatch(backendActionFinished());
+            }
+        },
+        [dispatch]
+    );
+};
