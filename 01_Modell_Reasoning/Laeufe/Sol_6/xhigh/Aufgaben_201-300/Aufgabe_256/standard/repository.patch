+    def test_name_from_hosts_does_not_change_input(self):
+        data = dict(hosts=['foo', 'bar'])
+        p = Play.load(data)
+
+        self.assertNotIn('name', data)
+        self.assertEqual(p.get_name(), 'foo,bar')
+        p.hosts = ['baz']
+        self.assertEqual(p.get_name(), 'baz')
+
+    def test_name_from_string_and_tuple_hosts(self):
+        self.assertEqual(Play.load(dict(hosts='foo')).get_name(), 'foo')
+        self.assertEqual(Play.load(dict(hosts=('foo', 'bar'))).get_name(), 'foo,bar')
+        self.assertEqual(Play.load(dict(hosts=[b'foo', 'bar'])).get_name(), 'foo,bar')
+        self.assertEqual(Play.load(dict(name='custom', hosts=['foo'])).get_name(), 'custom')
+
+        p = Play()
+        p.hosts = 42
+        self.assertEqual(p.get_name(), 42)
+
+    def test_invalid_hosts(self):
+        cases = (
+            (None, "Hosts list cannot be empty. Please check your playbook"),
+            ([], "Hosts list cannot be empty. Please check your playbook"),
+            ('', "Hosts list cannot be empty. Please check your playbook"),
+            ([None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['foo', None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['foo', {'bar': 'baz'}], "Hosts list contains an invalid host value: '{'bar': 'baz'}'"),
+            (42, "Hosts list must be a sequence or string. Please check your playbook."),
+            ({'foo': 'bar'}, "Hosts list must be a sequence or string. Please check your playbook."),
+        )
+        for hosts, message in cases:
+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load(dict(name='named play', hosts=hosts))
+            self.assertEqual(error.exception.message, message)
+
+        with self.assertRaises(AnsibleParserError) as error:
+            Play.load(dict(hosts=['foo', {'test': '^'}]))
+        self.assertEqual(error.exception.message, "Hosts list contains an invalid host value: '{'test': '^'}'")
