+func TestRuleSegments(t *testing.T) {
+	tests := []struct {
+		name     string
+		keys     []string
+		operator flipt.SegmentOperator
+		wantKey  string
+		wantOp   string
+	}{
+		{name: "legacy key", wantKey: "legacy"},
+		{name: "single segment", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple segments with default operator", keys: []string{"first", "second"}, wantKey: "first,second", wantOp: "OR_SEGMENT_OPERATOR"},
+		{name: "multiple segments", keys: []string{"first", "second", "third"}, operator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, wantKey: "first,second,third", wantOp: "AND_SEGMENT_OPERATOR"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{
+				SegmentKey:      "legacy",
+				SegmentKeys:     tt.keys,
+				SegmentOperator: tt.operator,
+			})
+			assert.Equal(t, tt.wantKey, rule.SegmentKey)
+			assert.Equal(t, tt.wantOp, rule.SegmentOperator)
+
+			encoded, err := json.Marshal(rule)
+			require.NoError(t, err)
+			if tt.wantOp == "" {
+				assert.NotContains(t, string(encoded), `"segment_operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"segment_operator":"`+tt.wantOp+`"`)
+			}
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	tests := []struct {
+		name     string
+		keys     []string
+		operator flipt.SegmentOperator
+		wantKey  string
+		wantOp   string
+	}{
+		{name: "legacy key", wantKey: "legacy"},
+		{name: "single segment", keys: []string{"first"}, wantKey: "first"},
+		{name: "multiple segments with default operator", keys: []string{"first", "second"}, wantKey: "first,second", wantOp: "OR_SEGMENT_OPERATOR"},
+		{name: "multiple segments", keys: []string{"first", "second", "third"}, operator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, wantKey: "first,second,third", wantOp: "AND_SEGMENT_OPERATOR"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{
+				Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+					SegmentKey:      "legacy",
+					SegmentKeys:     tt.keys,
+					SegmentOperator: tt.operator,
+					Value:           true,
+				}},
+			})
+			require.NotNil(t, rollout.Segment)
+			assert.Equal(t, tt.wantKey, rollout.Segment.Key)
+			assert.True(t, rollout.Segment.Value)
+			assert.Equal(t, tt.wantOp, rollout.Segment.Operator)
+
+			encoded, err := json.Marshal(rollout)
+			require.NoError(t, err)
+			if tt.wantOp == "" {
+				assert.NotContains(t, string(encoded), `"operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"operator":"`+tt.wantOp+`"`)
+			}
+		})
+	}
+}
