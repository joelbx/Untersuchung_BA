diff --git a/test/image-cleanup.js b/test/image-cleanup.js
new file mode 100644
index 0000000..60c3ddb
--- /dev/null
+++ b/test/image-cleanup.js
@@ -0,0 +1,145 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs').promises;
+const path = require('path');
+const nconf = require('nconf');
+
+const db = require('./mocks/databasemock');
+const User = require('../src/user');
+const Groups = require('../src/groups');
+const socketUser = require('../src/socket.io/user');
+const slugify = require('../src/slugify');
+
+describe('Local profile image cleanup', () => {
+	let uid;
+	let createdFiles;
+	const profileFolder = () => path.join(nconf.get('upload_path'), 'profile');
+	const filesFolder = () => path.join(nconf.get('upload_path'), 'files');
+
+	async function createFile(folder, filename) {
+		await fs.mkdir(folder, { recursive: true });
+		const localPath = path.join(folder, filename);
+		await fs.writeFile(localPath, 'test image');
+		createdFiles.push(localPath);
+		return localPath;
+	}
+
+	async function assertGone(paths) {
+		await Promise.all(paths.map(localPath => assert.rejects(fs.stat(localPath), { code: 'ENOENT' })));
+	}
+
+	beforeEach(async () => {
+		uid = await User.create({ username: `imagecleanup${Date.now()}${Math.random().toString(36).slice(2)}` });
+		createdFiles = [];
+	});
+
+	afterEach(async () => {
+		await Promise.all(createdFiles.map(localPath => fs.unlink(localPath).catch((err) => {
+			if (err.code !== 'ENOENT') {
+				throw err;
+			}
+		})));
+	});
+
+	it('removes every local cover variant and clears its fields through the socket', async () => {
+		const names = ['png', 'jpeg', 'jpg', 'bmp'].map(ext => `${uid}-profilecover.${ext}`);
+		names.push(`${uid}-profilecover-12345.png`);
+		const paths = await Promise.all(names.map(name => createFile(profileFolder(), name)));
+		await db.setObject(`user:${uid}`, {
+			'cover:url': `/assets/uploads/profile/${names[0]}`,
+			'cover:position': '50% 50%',
+		});
+		assert(paths.includes(await User.getLocalCoverPath(uid)));
+		await socketUser.removeCover({ uid: uid }, { uid: uid });
+		await assertGone(paths);
+		assert.strictEqual(await User.getLocalCoverPath(uid), false);
+		const fields = await db.getObjectFields(`user:${uid}`, ['cover:url', 'cover:position']);
+		assert.strictEqual(fields['cover:url'], null);
+		assert.strictEqual(fields['cover:position'], null);
+		await assert.rejects(socketUser.removeCover({ uid: uid }, { uid: 'bad' }), /invalid-uid/);
+	});
+
+	it('removes every local avatar variant and returns the previous fields', async () => {
+		const names = ['png', 'jpeg', 'jpg', 'bmp'].map(ext => `${uid}-profileavatar.${ext}`);
+		names.push(`${uid}-profileavatar-12345.png`);
+		const paths = await Promise.all(names.map(name => createFile(profileFolder(), name)));
+		const url = `/assets/uploads/profile/${names[0]}`;
+		await db.setObject(`user:${uid}`, { uploadedpicture: url, picture: url });
+		assert(paths.includes(await User.getLocalAvatarPath(uid)));
+		const previous = await User.removeProfileImage(uid);
+		assert.strictEqual(previous.uploadedpicture, url);
+		assert.strictEqual(previous.picture, url);
+		await assertGone(paths);
+		assert.strictEqual(await User.getLocalAvatarPath(uid), false);
+		const fields = await db.getObjectFields(`user:${uid}`, ['uploadedpicture', 'picture']);
+		assert.strictEqual(fields.uploadedpicture, '');
+		assert.strictEqual(fields.picture, '');
+	});
+
+	it('preserves a different picture and ignores nonlocal avatar URLs', async () => {
+		const external = 'https://example.com/avatar.png';
+		await db.setObject(`user:${uid}`, { uploadedpicture: external, picture: external });
+		await socketUser.removeUploadedPicture({ uid: uid }, { uid: uid });
+		let fields = await db.getObjectFields(`user:${uid}`, ['uploadedpicture', 'picture']);
+		assert.strictEqual(fields.uploadedpicture, '');
+		assert.strictEqual(fields.picture, '');
+
+		const localPath = await createFile(profileFolder(), `${uid}-profileavatar.png`);
+		await db.setObject(`user:${uid}`, {
+			uploadedpicture: `/assets/uploads/profile/${uid}-profileavatar.png`,
+			picture: 'https://example.com/other.png',
+		});
+		await socketUser.removeUploadedPicture({ uid: uid }, { uid: uid });
+		await assertGone([localPath]);
+		fields = await db.getObjectFields(`user:${uid}`, ['uploadedpicture', 'picture']);
+		assert.strictEqual(fields.uploadedpicture, '');
+		assert.strictEqual(fields.picture, 'https://example.com/other.png');
+	});
+
+	it('does not delete another user image through an uploaded picture URL', async () => {
+		const otherName = `${uid + 10000}-profileavatar.png`;
+		const otherPath = await createFile(profileFolder(), otherName);
+		await db.setObjectField(`user:${uid}`, 'uploadedpicture', `/assets/uploads/profile/${otherName}`);
+		await User.removeProfileImage(uid);
+		await fs.stat(otherPath);
+	});
+
+	it('removes all legacy and timestamped profile images on account deletion', async () => {
+		const names = ['cover', 'avatar'].flatMap(type => [
+			...['png', 'jpeg', 'jpg', 'bmp'].map(ext => `${uid}-profile${type}.${ext}`),
+			`${uid}-profile${type}-12345.png`,
+		]);
+		const paths = await Promise.all(names.map(name => createFile(profileFolder(), name)));
+		await User.deleteAccount(uid);
+		await assertGone(paths);
+	});
+
+	it('removes only locally stored group cover and thumbnail files', async () => {
+		const groupName = `ImageCleanupGroup${uid}`;
+		await Groups.create({ name: groupName });
+		const cover = await createFile(filesFolder(), `groupCover-${groupName}.png`);
+		const thumb = await createFile(filesFolder(), `groupCoverThumb-${groupName}.jpg`);
+		const oldCover = await createFile(filesFolder(), `${slugify(`groupCover-${groupName}`)}.jpeg`);
+		const oldThumb = await createFile(filesFolder(), `${slugify(`groupCoverThumb-${groupName}`)}.bmp`);
+		const unrelated = await createFile(filesFolder(), `unrelated-${uid}.png`);
+		await db.setObject(`group:${groupName}`, {
+			'cover:url': `/assets/uploads/files/${path.basename(cover)}`,
+			'cover:thumb:url': `/assets/uploads/files/${path.basename(thumb)}`,
+			'cover:position': '50% 50%',
+		});
+		await Groups.removeCover({ groupName: groupName });
+		await assertGone([cover, thumb, oldCover, oldThumb]);
+		await fs.stat(unrelated);
+		const fields = await db.getObjectFields(`group:${groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
+		assert.strictEqual(fields['cover:url'], null);
+		assert.strictEqual(fields['cover:thumb:url'], null);
+		assert.strictEqual(fields['cover:position'], null);
+		await db.setObjectField(`group:${groupName}`, 'cover:url', 'https://example.com/cover.png');
+		await Groups.removeCover({ groupName: groupName });
+		await fs.stat(unrelated);
+		await db.setObjectField(`group:${groupName}`, 'cover:url', `/assets/uploads/files/../profile/${uid}-profileavatar.png`);
+		await Groups.removeCover({ groupName: groupName });
+		await fs.stat(unrelated);
+	});
+});
