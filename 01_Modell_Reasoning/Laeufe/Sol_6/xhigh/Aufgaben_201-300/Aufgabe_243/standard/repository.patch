+func TestClusterSessionDialEndpoints(t *testing.T) {
+	ctx := context.Background()
+	var calls []kubeClusterEndpoint
+	sess := &clusterSession{authContext: authContext{
+		teleportCluster: teleportClusterClient{dial: func(gotCtx context.Context, network, addr, serverID string) (net.Conn, error) {
+			require.Equal(t, ctx, gotCtx)
+			require.Equal(t, "tcp", network)
+			calls = append(calls, kubeClusterEndpoint{addr: addr, serverID: serverID})
+			if addr == "unavailable" {
+				return nil, trace.ConnectionProblem(nil, "unavailable")
+			}
+			return &net.TCPConn{}, nil
+		}},
+	}}
+
+	_, err := sess.dial(ctx, "tcp", "ignored")
+	require.True(t, trace.IsBadParameter(err))
+
+	sess.teleportClusterEndpoints = []kubeClusterEndpoint{
+		{addr: "unavailable", serverID: "first.local"},
+		{addr: "available", serverID: "second.local"},
+	}
+	sess.selectedEndpoint = &sess.teleportClusterEndpoints[0]
+	sess.kubeAddress = "unavailable"
+	_, err = sess.dial(ctx, "tcp", "ignored")
+	require.NoError(t, err)
+	require.Equal(t, sess.teleportClusterEndpoints, calls)
+	require.Equal(t, "available", sess.kubeAddress)
+	require.Equal(t, "second.local", sess.selectedEndpoint.serverID)
+}
