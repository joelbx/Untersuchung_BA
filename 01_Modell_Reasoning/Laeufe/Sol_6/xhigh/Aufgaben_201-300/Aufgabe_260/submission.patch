+import { v4 as uuidv4 } from 'uuid'
+
+// Each window has its own ID. EventSource includes it in the URL because it
+// cannot add custom headers and browser cookies are shared across windows.
+export const clientUniqueId = uuidv4()
+export const clientUniqueIdHeader = 'X-ND-Client-Unique-Id'
