@@ -0,0 +1,26 @@
+import { fetchUtils } from 'react-admin'
+import httpClient from './httpClient'
+import { clientUniqueId, clientUniqueIdHeader } from '../clientUniqueId'
+
+jest.mock('react-admin', () => ({
+  ...jest.requireActual('react-admin'),
+  fetchUtils: {
+    ...jest.requireActual('react-admin').fetchUtils,
+    fetchJson: jest.fn(),
+  },
+}))
+
+it('sends the same window ID on each API request', async () => {
+  fetchUtils.fetchJson.mockResolvedValue({ headers: new Headers() })
+
+  await httpClient('/api/album')
+  await httpClient('/api/song')
+
+  expect(clientUniqueId).toMatch(
+    /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+  )
+  for (const [, options] of fetchUtils.fetchJson.mock.calls) {
+    expect(options.headers.get(clientUniqueIdHeader)).toBe(clientUniqueId)
+  }
+  expect(fetchUtils.fetchJson).toHaveBeenCalledTimes(2)
+})
