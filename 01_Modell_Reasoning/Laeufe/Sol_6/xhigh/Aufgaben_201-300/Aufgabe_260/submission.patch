diff --git a/server/events/sse_test.go b/server/events/sse_test.go
new file mode 100644
index 0000000..6bc2d1a
--- /dev/null
+++ b/server/events/sse_test.go
@@ -0,0 +1,48 @@
+package events
+
+import (
+	"context"
+	"net/http/httptest"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("SSE delivery", func() {
+	It("uses the window ID on a stream even when another window changed the cookie", func() {
+		b := &broker{subscribing: make(clientsChan, 1)}
+		r := httptest.NewRequest("GET", "/events?clientUniqueId=window-a", nil)
+		ctx := request.WithUser(r.Context(), model.User{UserName: "alice"})
+		r = r.WithContext(request.WithClientUniqueId(ctx, "window-b"))
+
+		c := b.subscribe(r)
+		Expect(c.clientUniqueId).To(Equal("window-a"))
+		Expect(c.username).To(Equal("alice"))
+	})
+
+	It("sends request events only to other clients of the same user", func() {
+		b := &broker{}
+		ctx := request.WithClientUniqueId(context.Background(), "origin")
+		ctx = request.WithUser(ctx, model.User{UserName: "alice"})
+		msg := b.prepareMessage(ctx, &RefreshResource{})
+
+		Expect(shouldSendTo(client{username: "alice", clientUniqueId: "origin"}, msg)).To(BeFalse())
+		Expect(shouldSendTo(client{username: "alice", clientUniqueId: "other"}, msg)).To(BeTrue())
+		Expect(shouldSendTo(client{username: "bob", clientUniqueId: "third"}, msg)).To(BeFalse())
+	})
+
+	It("broadcasts events without a sender client ID", func() {
+		ctx := request.WithUsername(context.Background(), "alice")
+		msg := (&broker{}).prepareMessage(ctx, &KeepAlive{TS: 1})
+		Expect(shouldSendTo(client{username: "bob", clientUniqueId: "other"}, msg)).To(BeTrue())
+	})
+
+	It("writes the event wire format", func() {
+		w := httptest.NewRecorder()
+		msg := message{id: 7, event: "keepAlive", data: `{"ts":1}`}
+		Expect(writeEvent(w, msg, writeTimeOut)).To(Succeed())
+		Expect(w.Body.String()).To(Equal("id: 7\nevent: keepAlive\ndata: {\"ts\":1}\n\n"))
+	})
+})
