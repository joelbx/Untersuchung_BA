+@pytest.mark.parametrize('error, wording', [
+    (QProcess.FailedToStart, 'failed to start'),
+    (QProcess.Crashed, 'crashed'),
+    (QProcess.Timedout, 'timed out'),
+    (QProcess.WriteError, 'write error'),
+    (QProcess.ReadError, 'read error'),
+    (QProcess.UnknownError, 'encountered an unknown error'),
+])
+def test_error_type(fake_proc, monkeypatch, message_mock, caplog,
+                    error, wording):
+    """Show the command and a useful description for each Qt error code."""
+    monkeypatch.setattr(utils, 'is_windows', True)
+    fake_proc.cmd = 'example-command'
+    fake_proc._proc.errorString.return_value = 'error detail'
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        fake_proc._on_error(error)
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == (
+        "Testprocess 'example-command' {}: error detail".format(wording))
+
+
+@pytest.mark.parametrize('detail, is_windows, hint', [
+    ('No such file or directory', False, True),
+    ('execvp: No such file or directory', False, True),
+    ('Permission denied', False, True),
+    ('execvp: Permission denied', False, True),
+    ('Other error', False, False),
+    ('No such file or directory', True, False),
+    ('Permission denied', True, False),
+])
+def test_start_error_hint(fake_proc, monkeypatch, message_mock, caplog,
+                          detail, is_windows, hint):
+    """Suggest checking the command for common POSIX start errors."""
+    monkeypatch.setattr(utils, 'is_windows', is_windows)
+    fake_proc.cmd = 'example-command'
+    fake_proc._proc.errorString.return_value = detail
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        fake_proc._on_error(QProcess.FailedToStart)
+
+    expected = "Testprocess 'example-command' failed to start: " + detail
+    if hint:
+        expected += (" (Hint: Make sure 'example-command' exists and "
+                     "is executable)")
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == expected
 
 
