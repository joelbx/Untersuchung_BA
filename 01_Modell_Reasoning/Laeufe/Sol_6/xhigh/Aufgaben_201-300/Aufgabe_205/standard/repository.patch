 const utils = module.exports;
 
-// internal token management utilities only
+// Internal token management utilities. The token string is also returned so
+// callers can associate metadata with a token when listing several of them.
+const tokens = {};
+utils.tokens = tokens;
 
-utils.log = async (token) => {
+tokens.list = async () => {
+	const tokenIds = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await tokens.get(tokenIds);
+};
+
+tokens.get = async (tokenIds) => {
+	if (tokenIds === null || tokenIds === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const single = !Array.isArray(tokenIds);
+	const ids = single ? [tokenIds] : tokenIds;
+	if (ids.some(token => typeof token !== 'string' || !token)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!ids.length) {
+		return [];
+	}
+
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(ids.map(token => `token:${token}`)),
+		tokens.getLastSeen(ids),
+	]);
+	const result = objects.map((data, index) => {
+		if (!data) {
+			return null;
+		}
+		return {
+			token: ids[index],
+			uid: Number(data.uid),
+			description: data.description || '',
+			timestamp: Number(data.timestamp),
+			lastSeen: lastSeen[index],
+		};
+	});
+	return single ? result[0] : result;
+};
+
+tokens.generate = async ({ uid, description = '' } = {}) => {
+	const numericUid = Number(uid);
+	if (
+		(typeof uid !== 'number' && typeof uid !== 'string') ||
+		(typeof uid === 'string' && !uid.trim()) ||
+		!Number.isSafeInteger(numericUid) || numericUid < 0
+	) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.exists(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = generateUUID();
+	const timestamp = Date.now();
+	await db.setObject(`token:${token}`, { uid: numericUid, description, timestamp });
+	await Promise.all([
+		db.sortedSetAdd('tokens:createtime', timestamp, token),
+		db.sortedSetAdd('tokens:uid', numericUid, token),
+	]);
+	return token;
+};
+
+tokens.update = async (token, { description } = {}) => {
+	if (typeof token !== 'string' || !token || description === undefined) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!await db.getObject(`token:${token}`)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.setObjectField(`token:${token}`, 'description', description);
+	return await tokens.get(token);
+};
+
+tokens.delete = async (token) => {
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetRemove(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'], token),
+	]);
+};
+
+tokens.log = async (token) => {
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+tokens.getLastSeen = async (tokenIds) => {
+	if (!Array.isArray(tokenIds)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (!tokenIds.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokenIds);
+	return scores.map(score => (
+		score === null || score === undefined || !Number.isFinite(Number(score)) ? null : Number(score)
+	));
+};
+
+// Keep the existing call sites for API usage logging and settings display.
+utils.log = tokens.log;
+utils.getLastSeen = tokens.getLastSeen;
