diff --git a/scanner/refresher_test.go b/scanner/refresher_test.go
new file mode 100644
index 0000000..8426d7e
--- /dev/null
+++ b/scanner/refresher_test.go
@@ -0,0 +1,66 @@
+package scanner
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("getImageFiles", func() {
+	It("joins all images from sorted, distinct album directories", func() {
+		mfs := model.MediaFiles{
+			{Path: filepath.Join("music", "disc2", "song1.mp3")},
+			{Path: filepath.Join("music", "disc1", "song1.mp3")},
+			{Path: filepath.Join("music", "disc1", "song2.mp3")},
+		}
+		dirs := dirMap{
+			filepath.Join("music", "disc1"): {ImageFiles: []string{"front.jpg", "back.png"}},
+			filepath.Join("music", "disc2"): {ImageFiles: []string{"cover.jpg"}},
+		}
+		want := strings.Join([]string{
+			filepath.Join("music", "disc1", "front.jpg"),
+			filepath.Join("music", "disc1", "back.png"),
+			filepath.Join("music", "disc2", "cover.jpg"),
+		}, string(filepath.ListSeparator))
+		Expect(getImageFiles(mfs, dirs)).To(Equal(want))
+	})
+
+	It("omits images from directories no longer in the scan", func() {
+		mfs := model.MediaFiles{{Path: filepath.Join("music", "disc1", "song.mp3")}}
+		Expect(getImageFiles(mfs, dirMap{})).To(BeEmpty())
+	})
+})
+
+type albumMediaRepo struct {
+	model.MediaFileRepository
+	files model.MediaFiles
+}
+
+func (r *albumMediaRepo) GetAll(...model.QueryOptions) (model.MediaFiles, error) {
+	return r.files, nil
+}
+
+var _ = Describe("album refresher", func() {
+	It("stores the full image paths when refreshing an album", func() {
+		dir := filepath.Join("music", "album")
+		ds := &tests.MockDataStore{
+			MockedMediaFile: &albumMediaRepo{files: model.MediaFiles{
+				{ID: "song", AlbumID: "album", Album: "Album", Path: filepath.Join(dir, "song.mp3")},
+			}},
+		}
+		refresher := newRefresher(context.Background(), ds, dirMap{
+			dir: {ImageFiles: []string{"front.jpg", "back.png"}},
+		})
+		Expect(refresher.refreshAlbums("album")).To(Succeed())
+		album, err := ds.Album(context.Background()).Get("album")
+		Expect(err).ToNot(HaveOccurred())
+		Expect(album.ImageFiles).To(Equal(strings.Join([]string{
+			filepath.Join(dir, "front.jpg"), filepath.Join(dir, "back.png"),
+		}, string(filepath.ListSeparator))))
+	})
+})
