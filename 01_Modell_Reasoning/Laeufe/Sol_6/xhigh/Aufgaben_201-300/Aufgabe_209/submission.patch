diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..9c66260
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,93 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+import useGetCalendarSetup from '../hooks/useGetCalendarSetup';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ loading: false, error: false })),
+}));
+
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ handleCreateCalendar: jest.fn() })),
+}));
+
+const mockUseGetCalendarSetup = useGetCalendarSetup as jest.Mock;
+
+describe('SubscribeCalendarModal', () => {
+    beforeEach(() => {
+        mockUseGetCalendarSetup.mockReturnValue({ loading: false, error: false });
+    });
+
+    it('validates the trimmed URL at the limit and shows one warning in priority order', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        const input = screen.getByLabelText('Calendar URL') as HTMLInputElement;
+        const submit = document.querySelector('button[type="submit"]') as HTMLButtonElement;
+        const setURL = (value: string) => fireEvent.change(input, { target: { value } });
+        const longURL = `https://example.com/${'a'.repeat(
+            MAX_LENGTHS_API.CALENDAR_URL - 'https://example.com/'.length
+        )}`;
+
+        expect(submit).toBeDisabled();
+        setURL('not a url');
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('Invalid URL')).toBeInTheDocument();
+
+        setURL(`  ${longURL}  `);
+        expect(input.value).toBe(longURL);
+        expect(submit).toBeEnabled();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        setURL(`${longURL}a`);
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+
+        setURL('a'.repeat(MAX_LENGTHS_API.CALENDAR_URL + 1));
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+        expect(screen.queryByText('Invalid URL')).not.toBeInTheDocument();
+
+        setURL(`https://calendar.google.com/public/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}.ics`);
+        expect(submit).toBeDisabled();
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        setURL(`https://calendar.google.com/public/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}`);
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(
+            screen.queryByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).not.toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        setURL('https://outlook.live.com/calendar');
+        expect(submit).toBeEnabled();
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+    });
+
+    it('uses the same disabled state in the setup error view', () => {
+        const { rerender } = render(<SubscribeCalendarModal isOpen />);
+        const input = screen.getByLabelText('Calendar URL');
+        fireEvent.change(input, { target: { value: 'https://example.com/calendar.ics' } });
+
+        mockUseGetCalendarSetup.mockReturnValue({ loading: false, error: true });
+        rerender(<SubscribeCalendarModal isOpen />);
+        const submit = document.querySelector('button[type="submit"]') as HTMLButtonElement;
+        expect(submit).toBeEnabled();
+
+        mockUseGetCalendarSetup.mockReturnValue({ loading: false, error: false });
+        rerender(<SubscribeCalendarModal isOpen />);
+        fireEvent.change(screen.getByLabelText('Calendar URL'), {
+            target: { value: `https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}` },
+        });
+
+        mockUseGetCalendarSetup.mockReturnValue({ loading: false, error: true });
+        rerender(<SubscribeCalendarModal isOpen />);
+        expect(submit).toBeDisabled();
+    });
+});
