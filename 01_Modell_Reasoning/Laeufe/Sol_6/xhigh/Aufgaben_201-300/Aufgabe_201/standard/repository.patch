@@ -0,0 +1,58 @@
+package sql_test
+
+import (
+	"context"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/storage"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func (s *DBTestSuite) TestSingleSegmentOperatorFallback() {
+	t := s.T()
+	ctx := context.Background()
+	flag, err := s.store.CreateFlag(ctx, &flipt.CreateFlagRequest{
+		Key: t.Name(), Name: t.Name(), Type: flipt.FlagType_BOOLEAN_FLAG_TYPE,
+	})
+	require.NoError(t, err)
+	segment, err := s.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: t.Name(), Name: t.Name()})
+	require.NoError(t, err)
+
+	rule, err := s.store.CreateRule(ctx, &flipt.CreateRuleRequest{
+		FlagKey: flag.Key, SegmentKeys: []string{segment.Key},
+		SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Rank: 1,
+	})
+	require.NoError(t, err)
+	require.Equal(t, segment.Key, rule.SegmentKey)
+	require.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rule.SegmentOperator)
+
+	rule, err = s.store.UpdateRule(ctx, &flipt.UpdateRuleRequest{
+		Id: rule.Id, FlagKey: flag.Key, SegmentKey: segment.Key,
+		SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+	})
+	require.NoError(t, err)
+	require.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rule.SegmentOperator)
+
+	rollout, err := s.store.CreateRollout(ctx, &flipt.CreateRolloutRequest{
+		FlagKey: flag.Key, Rank: 1,
+		Rule: &flipt.CreateRolloutRequest_Segment{Segment: &flipt.RolloutSegment{
+			SegmentKeys: []string{segment.Key}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+		}},
+	})
+	require.NoError(t, err)
+	require.Equal(t, segment.Key, rollout.GetSegment().SegmentKey)
+	require.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rollout.GetSegment().SegmentOperator)
+
+	rollout, err = s.store.UpdateRollout(ctx, &flipt.UpdateRolloutRequest{
+		Id: rollout.Id, FlagKey: flag.Key,
+		Rule: &flipt.UpdateRolloutRequest_Segment{Segment: &flipt.RolloutSegment{
+			SegmentKey: segment.Key, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+		}},
+	})
+	require.NoError(t, err)
+	require.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rollout.GetSegment().SegmentOperator)
+
+	fetched, err := s.store.GetRollout(ctx, storage.DefaultNamespace, rollout.Id)
+	require.NoError(t, err)
+	require.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, fetched.GetSegment().SegmentOperator)
+}
