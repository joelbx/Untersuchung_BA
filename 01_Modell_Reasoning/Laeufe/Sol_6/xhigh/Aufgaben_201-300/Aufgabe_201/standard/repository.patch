@@ -0,0 +1,54 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+)
+
+func TestRuleSegmentYAML(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		keys     []string
+		operator string
+		output   string
+		invalid  bool
+	}{
+		{"string", "segment: foo", []string{"foo"}, "OR_SEGMENT_OPERATOR", "segment: foo\n", false},
+		{"object", "segment: {keys: [foo, bar], operator: AND_SEGMENT_OPERATOR}", []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR", "segment:\n  keys:\n  - foo\n  - bar\n  operator: AND_SEGMENT_OPERATOR\n", false},
+		{"one key overrides operator", "segment: {keys: [foo], operator: AND_SEGMENT_OPERATOR}", []string{"foo"}, "OR_SEGMENT_OPERATOR", "segment:\n  keys:\n  - foo\n  operator: OR_SEGMENT_OPERATOR\n", false},
+		{"one key ignores unknown operator", "segment: {keys: [foo], operator: NOT_AN_OPERATOR}", []string{"foo"}, "OR_SEGMENT_OPERATOR", "segment:\n  keys:\n  - foo\n  operator: OR_SEGMENT_OPERATOR\n", false},
+		{"missing segment", "rank: 1", nil, "", "", true},
+		{"empty string", "segment: ''", nil, "", "", true},
+		{"number", "segment: 42", nil, "", "", true},
+		{"list", "segment: [foo]", nil, "", "", true},
+		{"empty object", "segment: {}", nil, "", "", true},
+		{"missing operator", "segment: {keys: [foo, bar]}", nil, "", "", true},
+		{"unknown operator", "segment: {keys: [foo, bar], operator: XOR_SEGMENT_OPERATOR}", nil, "", "", true},
+		{"unknown field", "segment: {keys: [foo], operator: OR_SEGMENT_OPERATOR, other: true}", nil, "", "", true},
+		{"empty key", "segment: {keys: [''], operator: OR_SEGMENT_OPERATOR}", nil, "", "", true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var rule Rule
+			err := yaml.Unmarshal([]byte(tc.input), &rule)
+			if tc.invalid {
+				if err == nil {
+					_, _, err = rule.Segment.KeysAndOperator()
+				}
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			keys, operator, err := rule.Segment.KeysAndOperator()
+			require.NoError(t, err)
+			require.Equal(t, tc.keys, keys)
+			require.Equal(t, tc.operator, operator)
+			out, err := yaml.Marshal(&rule)
+			require.NoError(t, err)
+			require.YAMLEq(t, tc.output, string(out))
+		})
+	}
+}
