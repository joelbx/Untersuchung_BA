 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,120 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment is implemented by the two supported rule segment formats.
+type IsSegment interface {
+	isSegment()
+}
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+// SegmentEmbed holds either a single key or a group of keys for a rule.
+type SegmentEmbed struct {
+	IsSegment
+}
+
+// KeysAndOperator returns the normalized segment definition. A single key
+// always uses OR, including when supplied in object form.
+func (s *SegmentEmbed) KeysAndOperator() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("rule segment is required")
+	}
+
+	var keys []string
+	var operator string
+	switch segment := s.IsSegment.(type) {
+	case SegmentKey:
+		keys = []string{string(segment)}
+	case Segments:
+		keys, operator = segment.Keys, segment.SegmentOperator
+	case *Segments:
+		if segment == nil {
+			return nil, "", fmt.Errorf("rule segment is required")
+		}
+		keys, operator = segment.Keys, segment.SegmentOperator
+	default:
+		return nil, "", fmt.Errorf("unsupported rule segment type %T", s.IsSegment)
+	}
+
+	if len(keys) == 0 {
+		return nil, "", fmt.Errorf("rule segment requires at least one key")
+	}
+	for _, key := range keys {
+		if key == "" {
+			return nil, "", fmt.Errorf("rule segment keys cannot be empty")
+		}
+	}
+	if len(keys) == 1 {
+		return keys, "OR_SEGMENT_OPERATOR", nil
+	}
+	if operator != "OR_SEGMENT_OPERATOR" && operator != "AND_SEGMENT_OPERATOR" {
+		return nil, "", fmt.Errorf("rule segment requires a valid operator")
+	}
+	return keys, operator, nil
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	keys, operator, err := s.KeysAndOperator()
+	if err != nil {
+		return nil, err
+	}
+	if _, ok := s.IsSegment.(SegmentKey); ok {
+		return keys[0], nil
+	}
+	return Segments{Keys: keys, SegmentOperator: operator}, nil
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+
+	switch value := raw.(type) {
+	case string:
+		s.IsSegment = SegmentKey(value)
+	case map[interface{}]interface{}:
+		for key := range value {
+			if key != "keys" && key != "operator" {
+				return fmt.Errorf("unsupported rule segment field %v", key)
+			}
+		}
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return err
+		}
+		s.IsSegment = segments
+	case map[string]interface{}:
+		for key := range value {
+			if key != "keys" && key != "operator" {
+				return fmt.Errorf("unsupported rule segment field %v", key)
+			}
+		}
+		var segments Segments
+		if err := unmarshal(&segments); err != nil {
+			return err
+		}
+		s.IsSegment = segments
+	default:
+		return fmt.Errorf("rule segment must be a string or keys/operator object")
+	}
+
+	_, _, err := s.KeysAndOperator()
+	return err
 }
 
