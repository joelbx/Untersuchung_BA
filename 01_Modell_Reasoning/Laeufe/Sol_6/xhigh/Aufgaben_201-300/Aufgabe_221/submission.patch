+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = 'json'
+
+    def POST(self, work_id):
+        def response(data):
+            return delegate.RawText(
+                json.dumps(data), content_type='application/json'
+            )
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        params = web.input(op='', topic=None, comment=None, edition_key=None)
+        if 'application/json' in web.ctx.env.get('CONTENT_TYPE', ''):
+            try:
+                payload = json.loads(web.data())
+                if not isinstance(payload, dict):
+                    raise ValueError('Invalid request body')
+                params.update(payload)
+            except (ValueError, TypeError):
+                return response({'errors': 'Invalid JSON request body'})
+
+        op = params.get('op')
+        username = user.key.split('/')[2]
+        if not isinstance(op, str) or op not in {'add', 'remove', 'update'}:
+            return response({'errors': 'Invalid award operation'})
+
+        try:
+            if op == 'remove':
+                return response(
+                    {'success': True, 'rows': Bestbook.remove(username, work_id=work_id)}
+                )
+
+            topic = params.get('topic')
+            if not isinstance(topic, str):
+                raise Bestbook.AwardConditionsError('A topic is required')
+            edition_key = params.get('edition_key')
+            edition_id = None
+            if edition_key:
+                if (
+                    not isinstance(edition_key, str)
+                    or not edition_key.split('/')[-1].startswith('OL')
+                    or not edition_key.endswith('M')
+                ):
+                    raise Bestbook.AwardConditionsError('Invalid edition key')
+                try:
+                    edition_id = int(extract_numeric_id_from_olid(edition_key))
+                except ValueError as exc:
+                    raise Bestbook.AwardConditionsError('Invalid edition key') from exc
+
+            comment = params.get('comment')
+            if comment is not None and not isinstance(comment, str):
+                raise Bestbook.AwardConditionsError('Invalid comment')
+            method = Bestbook.add if op == 'add' else Bestbook.update
+            award = method(
+                username,
+                work_id,
+                topic,
+                comment=(comment or '') if op == 'add' else comment,
+                edition_id=edition_id,
+            )
+            return response({'success': True, 'award': award})
+        except Bestbook.AwardConditionsError as exc:
+            return response({'errors': str(exc)})
+
