new file mode 100644
index 0000000..c7dccd2
--- /dev/null
+++ b/internal/version/major.go
@@ -0,0 +1,14 @@
+package version
+
+import "strings"
+
+// Major extracts the first version component after an optional epoch.
+func Major(v string) string {
+	if i := strings.IndexByte(v, ':'); i >= 0 {
+		v = v[i+1:]
+	}
+	if i := strings.IndexByte(v, '.'); i >= 0 {
+		v = v[:i]
+	}
+	return v
+}
