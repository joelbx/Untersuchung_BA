+package scan
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestEOLWarnings(t *testing.T) {
+	date := func(s string) time.Time {
+		tm, err := time.Parse("2006-01-02", s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return tm
+	}
+	tests := []struct {
+		family, release string
+		now             time.Time
+		want            []string
