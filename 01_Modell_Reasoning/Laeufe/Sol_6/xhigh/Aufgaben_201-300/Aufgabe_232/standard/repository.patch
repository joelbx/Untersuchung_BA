+func parseAmazonRelease(systemRelease string) string {
+	fields := strings.Fields(systemRelease)
+	if len(fields) < 3 || fields[0] != "Amazon" || fields[1] != "Linux" {
+		return "unknown"
+	}
+	switch {
+	case fields[2] == "2":
+		return strings.Join(fields[2:], " ")
+	case len(fields) >= 4 && fields[2] == "release" && fields[3] == "2":
+		return strings.Join(fields[3:], " ")
+	case len(fields) >= 5 && fields[2] == "AMI" && fields[3] == "release":
+		return fields[4]
+	case len(fields) >= 4 && fields[2] == "release":
+		return fields[3]
+	}
+	return "unknown"
+}
