@@ -0,0 +1,113 @@
+package config
+
+import "time"
+
+// OS family identifiers are shared by detection, lifecycle lookup and reporting.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	// ServerTypePseudo is used for ServerInfo.Type and scan result Family.
+	ServerTypePseudo = "pseudo"
+)
+
+// EOL describes the published end dates of an OS release. Ended can describe
+// a release without a published standard end date; dated phases use their dates.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support has ended at now.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	if e.StandardSupportUntil.IsZero() {
+		return e.Ended
+	}
+	return now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether applicable extended support has ended.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+func eolDate(date string) time.Time {
+	if date == "" {
+		return time.Time{}
+	}
+	t, err := time.Parse("2006-01-02", date)
+	if err != nil {
+		panic(err) // All dates below are fixed source literals.
+	}
+	return t
+}
+
+func supportUntil(standard, extended string) EOL {
+	return EOL{StandardSupportUntil: eolDate(standard), ExtendedSupportUntil: eolDate(extended)}
+}
+
+// eolByFamily is keyed by the vendor's release identifier, not a guessed major
+// version. Callers normalize detected OS release strings before lookup.
+var eolByFamily = map[string]map[string]EOL{
+	Amazon: {
+		"2018.03":   supportUntil("2023-06-30", "2023-06-30"),
+		"2 (Karoo)": supportUntil("2025-06-30", ""),
+	},
+	RedHat: {
+		"7": supportUntil("2024-06-30", ""),
+		"8": supportUntil("2029-05-31", ""),
+		"6": supportUntil("2020-11-30", "2024-06-30"),
+	},
+	CentOS: {
+		"7": supportUntil("2024-06-30", ""),
+		"8": supportUntil("2021-12-31", ""),
+		"6": supportUntil("2020-11-30", "2020-11-30"),
+	},
+	Oracle: {
+		"7": supportUntil("2024-06-30", ""),
+		"8": supportUntil("2029-05-31", ""),
+		"6": supportUntil("2021-03-31", "2022-03-31"),
+	},
+	Ubuntu: {
+		"18.04": supportUntil("2023-05-31", "2028-04-30"),
+		"14.04": supportUntil("2019-04-30", "2024-04-30"),
+		"14.10": supportUntil("2015-07-30", "2015-07-30"),
+		"21.04": supportUntil("2022-01-30", ""),
+	},
+	Debian: {
+		"9":  supportUntil("2022-06-30", ""),
+		"10": supportUntil("2024-06-30", ""),
+		"8":  supportUntil("2020-06-30", "2020-06-30"),
+	},
+	Alpine: {
+		"3.10": supportUntil("2021-05-30", ""),
+		"3.11": supportUntil("2021-11-30", ""),
+		"3.12": supportUntil("2022-05-30", ""),
+		"3.9":  supportUntil("2020-11-30", "2020-11-30"),
+	},
+	FreeBSD: {
+		"11": supportUntil("2021-09-30", "2021-09-30"),
+		"12": supportUntil("2023-12-31", ""),
+		"10": supportUntil("2019-10-30", "2019-10-30"),
+	},
+}
+
+// GetEOL returns lifecycle dates for an exact OS family and release key.
+func GetEOL(family string, release string) (EOL, bool) {
+	eol, found := eolByFamily[family][release]
+	return eol, found
+}
