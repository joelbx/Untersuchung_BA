+func TestSingleLocalSite(t *testing.T) {
+	s := &server{}
+	s.localSite = &localSite{
+		srv:         s,
+		domainName:  "local",
+		remoteConns: make(map[connKey][]*remoteConn),
+	}
+	conn := mockRemoteConnConn{}
+	sshConn := &ssh.ServerConn{
+		Permissions: &ssh.Permissions{Extensions: map[string]string{
+			extAuthority: "local",
+			extHost:      "node-id",
+		}},
+	}
+
+	site, remoteConn, err := s.upsertServiceConn(conn, sshConn, types.NodeTunnel)
+	require.NoError(t, err)
+	require.Same(t, s.localSite, site)
+	require.Same(t, remoteConn, s.localSite.remoteConns[connKey{uuid: "node-id", connType: types.NodeTunnel}][0])
+
+	sites, err := s.GetSites()
+	require.NoError(t, err)
+	require.Equal(t, []RemoteSite{s.localSite}, sites)
+	found, err := s.GetSite("local")
+	require.NoError(t, err)
+	require.Same(t, s.localSite, found)
+
+	proxies := []types.Server{nil}
+	s.fanOutProxies(proxies)
+	select {
+	case got := <-remoteConn.newProxiesC:
+		require.Equal(t, proxies, got)
+	case <-time.After(time.Second):
+		t.Fatal("local site did not forward proxy update")
+	}
+
+	require.NoError(t, s.onSiteTunnelClose(&alwaysClose{RemoteSite: s.localSite}))
+	require.Same(t, site, s.localSite)
+	found, err = s.GetSite("local")
+	require.NoError(t, err)
+	require.Same(t, site, found)
+
+	sshConn.Permissions.Extensions[extAuthority] = "remote"
+	_, _, err = s.upsertServiceConn(conn, sshConn, types.NodeTunnel)
+	require.True(t, trace.IsBadParameter(err))
+	require.Len(t, s.localSite.remoteConns[connKey{uuid: "node-id", connType: types.NodeTunnel}], 1)
+}
