+func TestRequireLocalAgentForConn(t *testing.T) {
+	s := &server{localSite: &localSite{domainName: "local"}}
+	for _, tt := range []struct {
+		name        string
+		clusterName string
+		wantError   bool
+	}{
+		{name: "matching cluster", clusterName: "local"},
+		{name: "empty cluster", wantError: true},
+		{name: "whitespace cluster", clusterName: " ", wantError: true},
+		{name: "different cluster", clusterName: "remote", wantError: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			err := s.requireLocalAgentForConn(tt.clusterName, types.NodeTunnel)
+			if !tt.wantError {
+				require.NoError(t, err)
+				return
+			}
+			require.True(t, trace.IsBadParameter(err))
+			require.Contains(t, err.Error(), string(types.NodeTunnel))
+			if strings.TrimSpace(tt.clusterName) != "" {
+				require.Contains(t, err.Error(), tt.clusterName)
+			}
+		})
+	}
+}
