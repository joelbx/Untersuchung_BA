@@ -33,3 +33,61 @@ TTY_IFY_DATA = {
 @pytest.mark.parametrize('text, expected', sorted(TTY_IFY_DATA.items()))
 def test_ttyify(text, expected):
     assert DocCLI.tty_ify(text) == expected
+
+
+@pytest.mark.parametrize('collection, entry_point, expected_fqcn, expected_entry_points', [
+    ('', None, 'sample', ('main', 'alternate')),
+    ('namespace.collection', 'alternate', 'namespace.collection.sample', ('alternate',)),
+])
+def test_role_build_doc(collection, entry_point, expected_fqcn, expected_entry_points):
+    argspec = {
+        'main': {'short_description': 'Main entry point', 'options': {'flag': {'type': 'bool'}}},
+        'alternate': {'short_description': 'Alternate entry point'},
+    }
+    path = '/roles/sample'
+
+    fqcn, doc = RoleMixin()._build_doc('sample', path, collection, argspec, entry_point)
+
+    assert fqcn == expected_fqcn
+    assert doc['path'] == path
+    assert doc['collection'] == collection
+    assert tuple(doc['entry_points']) == expected_entry_points
+    for name in expected_entry_points:
+        assert doc['entry_points'][name] is argspec[name]
+    assert tuple(argspec) == ('main', 'alternate')
+
+
+@pytest.mark.parametrize('argspec, entry_point', [
+    ({}, None),
+    ({'main': {'short_description': 'Main entry point'}}, 'alternate'),
+])
+def test_role_build_doc_without_matching_entry_points(argspec, entry_point):
+    assert RoleMixin()._build_doc('sample', '/roles/sample', '', argspec, entry_point) == ('sample', None)
+
+
+def test_role_build_doc_preserves_empty_specification():
+    fqcn, doc = RoleMixin()._build_doc('sample', '/roles/sample', None, {'main': None})
+
+    assert fqcn == 'sample'
+    assert doc == {'path': '/roles/sample', 'collection': None, 'entry_points': {'main': None}}
+    assert 'ENTRY POINT: main\n' in DocCLI.get_role_man_text(None, fqcn, doc)
+
+
+def test_create_role_doc_omits_roles_without_matching_entry_points(monkeypatch):
+    mixin = RoleMixin()
+    monkeypatch.setattr(mixin, '_find_all_normal_roles', lambda roles_path, name_filters: {('local', '/roles/local')})
+    monkeypatch.setattr(mixin, '_find_all_collection_roles', lambda name_filters: {('remote', 'namespace.collection', '/collections/remote')})
+    monkeypatch.setattr(mixin, '_load_argspec', lambda role, **kwargs: {
+        'local': {'main': {'short_description': 'Main entry point'}},
+        'remote': {'alternate': {'short_description': 'Alternate entry point'}},
+    }[role])
+
+    docs = mixin._create_role_doc(('local', 'remote'), ('/roles',), entry_point='alternate')
+
+    assert docs == {
+        'namespace.collection.remote': {
+            'path': '/collections/remote',
+            'collection': 'namespace.collection',
+            'entry_points': {'alternate': {'short_description': 'Alternate entry point'}},
+        },
+    }
