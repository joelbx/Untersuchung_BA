+import { logger } from "matrix-js-sdk/src/logger";
+
+import { handleEvent } from "../../../src/legacy/LegacyCallHandler/handleEvent";
+import SettingsStore from "../../../src/settings/SettingsStore";
+
+describe("handleEvent", () => {
+    const audio = document.createElement("audio");
+    audio.id = "ringAudio";
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it("logs media errors with the element id", () => {
+        const log = jest.spyOn(logger, "error").mockImplementation(() => {});
+        audio.addEventListener("error", handleEvent);
+
+        audio.dispatchEvent(new Event("error"));
+
+        expect(log).toHaveBeenCalledWith("LegacyCallHandler media event", expect.objectContaining({
+            type: "error",
+            elementId: "ringAudio",
+        }));
+        audio.removeEventListener("error", handleEvent);
+    });
+
+    it("logs debug events only when enabled and ignores unknown events", () => {
+        const log = jest.spyOn(logger, "debug").mockImplementation(() => {});
+        const setting = jest.spyOn(SettingsStore, "getValue").mockReturnValue(false);
+        audio.addEventListener("play", handleEvent);
+        audio.addEventListener("custom", handleEvent);
+
+        audio.dispatchEvent(new Event("play"));
+        expect(log).not.toHaveBeenCalled();
+
+        setting.mockReturnValue(true);
+        audio.dispatchEvent(new Event("play"));
+        expect(log).toHaveBeenCalledWith("LegacyCallHandler media event", {
+            type: "play",
+            elementId: "ringAudio",
+        });
+        expect(setting).toHaveBeenCalledWith("debug_legacy_call_handler");
+
+        log.mockClear();
+        audio.dispatchEvent(new Event("custom"));
+        expect(log).not.toHaveBeenCalled();
+        audio.removeEventListener("play", handleEvent);
+        audio.removeEventListener("custom", handleEvent);
+    });
+});
