+describe('LegacyCallHandler call sounds', () => {
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it.each(Object.values(AudioID))('unmutes %s before playing', (audioId) => {
+        const audio = {
+            muted: true,
+            play: jest.fn(() => {
+                expect(audio.muted).toBe(false);
+                return Promise.resolve();
+            }),
+        } as unknown as HTMLMediaElement;
+        jest.spyOn(document, 'getElementById').mockReturnValue(audio);
+
+        new LegacyCallHandler().play(audioId);
+
+        expect(document.getElementById).toHaveBeenCalledWith(audioId);
+        expect(audio.play).toHaveBeenCalledTimes(1);
+        expect(audio.muted).toBe(false);
+    });
+
+    it('plays an unmuted sound without changing its muted state', () => {
+        const setMuted = jest.fn();
+        const audio = {
+            get muted() { return false; },
+            set muted(value: boolean) { setMuted(value); },
+            play: jest.fn(() => Promise.resolve()),
+        } as unknown as HTMLMediaElement;
+        jest.spyOn(document, 'getElementById').mockReturnValue(audio);
+
+        new LegacyCallHandler().play(AudioID.Ring);
+
+        expect(setMuted).not.toHaveBeenCalled();
+        expect(audio.play).toHaveBeenCalledTimes(1);
+    });
+
+    it('unmutes again after reloading a queued sound', async () => {
+        let finishFirstPlay: () => void;
+        const firstPlay = new Promise<void>(resolve => { finishFirstPlay = resolve; });
+        const audio = {
+            muted: false,
+            play: jest.fn()
+                .mockReturnValueOnce(firstPlay)
+                .mockImplementationOnce(() => {
+                    expect(audio.muted).toBe(false);
+                    return Promise.resolve();
+                }),
+            load: jest.fn(() => { audio.muted = true; }),
+        } as unknown as HTMLMediaElement;
+        jest.spyOn(document, 'getElementById').mockReturnValue(audio);
+        const handler = new LegacyCallHandler();
+
+        handler.play(AudioID.Ring);
+        handler.play(AudioID.Ring);
+        finishFirstPlay();
+        await firstPlay;
+        await Promise.resolve();
+        await Promise.resolve();
+
+        expect(audio.load).toHaveBeenCalledTimes(1);
+        expect(audio.play).toHaveBeenCalledTimes(2);
+        expect(audio.muted).toBe(false);
+    });
+});
