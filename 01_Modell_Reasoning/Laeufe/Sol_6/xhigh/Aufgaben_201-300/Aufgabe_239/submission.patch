diff --git a/tests/mock_user_props_repo_test.go b/tests/mock_user_props_repo_test.go
new file mode 100644
index 0000000..5ab5e0d
--- /dev/null
+++ b/tests/mock_user_props_repo_test.go
@@ -0,0 +1,35 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestMockedUserPropsRepoUsesCompositeKey(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	for _, entry := range []struct{ user, key, value string }{
+		{"a_b", "c", "one"},
+		{"a", "b_c", "two"},
+	} {
+		if err := repo.Put(entry.user, entry.key, entry.value); err != nil {
+			t.Fatal(err)
+		}
+		value, err := repo.DefaultGet(entry.user, entry.key, "fallback")
+		if err != nil || value != entry.value {
+			t.Fatalf("DefaultGet(%q, %q) = %q, %v", entry.user, entry.key, value, err)
+		}
+	}
+	if err := repo.Delete("a_b", "c"); err != nil {
+		t.Fatal(err)
+	}
+	if value, err := repo.Get("a", "b_c"); err != nil || value != "two" {
+		t.Fatalf("other user's value changed: %q, %v", value, err)
+	}
+	if value, err := repo.DefaultGet("a_b", "c", "fallback"); err != nil || value != "fallback" {
+		t.Fatalf("missing value = %q, %v", value, err)
+	}
+	if err := repo.Put("", "key", "value"); err != model.ErrInvalidAuth {
+		t.Fatalf("empty user ID was accepted: %v", err)
+	}
+}
