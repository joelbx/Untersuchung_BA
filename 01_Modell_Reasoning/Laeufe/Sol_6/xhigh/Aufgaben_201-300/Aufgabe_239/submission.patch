@@ -0,0 +1,47 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	It("uses the supplied user ID for every operation", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
+		key := "user-props-isolation-test"
+
+		Expect(repo.Put("user-a", key, "a")).To(Succeed())
+		Expect(repo.Put("user-b", key, "b")).To(Succeed())
+		Expect(repo.Get("user-a", key)).To(Equal("a"))
+		Expect(repo.Get("user-b", key)).To(Equal("b"))
+		_, err := repo.Get("context-user", key)
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(repo.DefaultGet("user-a", key, "fallback")).To(Equal("a"))
+		Expect(repo.DefaultGet("context-user", key, "fallback")).To(Equal("fallback"))
+
+		Expect(repo.Put("user-a", key, "updated")).To(Succeed())
+		Expect(repo.Get("user-a", key)).To(Equal("updated"))
+		Expect(repo.Get("user-b", key)).To(Equal("b"))
+		Expect(repo.Delete("user-a", key)).To(Succeed())
+		_, err = repo.Get("user-a", key)
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(repo.Get("user-b", key)).To(Equal("b"))
+		Expect(repo.Delete("user-b", key)).To(Succeed())
+	})
+
+	It("rejects an empty user ID", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("", "key", "value")).To(Equal(model.ErrInvalidAuth))
+		_, err := repo.Get("", "key")
+		Expect(err).To(Equal(model.ErrInvalidAuth))
+		_, err = repo.DefaultGet("", "key", "fallback")
+		Expect(err).To(Equal(model.ErrInvalidAuth))
+		Expect(repo.Delete("", "key")).To(Equal(model.ErrInvalidAuth))
+	})
+})
