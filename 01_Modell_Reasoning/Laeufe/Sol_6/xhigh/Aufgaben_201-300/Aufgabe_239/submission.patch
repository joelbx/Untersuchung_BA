+// startLink binds the Last.fm callback to the authenticated user without trusting a UID from the browser.
+func (s *Router) startLink(w http.ResponseWriter, r *http.Request) {
+	u, ok := request.UserFrom(r.Context())
+	if !ok || u.ID == "" {
+		_ = rest.RespondWithError(w, http.StatusUnauthorized, "Not authenticated")
+		return
+	}
+	state := makeLinkState(u.ID, time.Now().Add(10*time.Minute))
+	_ = rest.RespondWithJSON(w, http.StatusOK, map[string]string{"state": state})
+}
+
+func makeLinkState(userId string, expires time.Time) string {
+	payload := base64.RawURLEncoding.EncodeToString([]byte(userId)) + "." + strconv.FormatInt(expires.Unix(), 10)
+	mac := hmac.New(sha256.New, auth.Secret)
+	_, _ = mac.Write([]byte(payload))
+	return payload + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
+
+func userFromLinkState(state string) (string, error) {
+	parts := strings.Split(state, ".")
+	if len(parts) != 3 {
+		return "", errors.New("invalid link state")
+	}
+	expires, err := strconv.ParseInt(parts[1], 10, 64)
+	if err != nil || time.Now().Unix() > expires {
+		return "", errors.New("expired link state")
+	}
+	uid, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil || len(uid) == 0 {
+		return "", errors.New("invalid link state")
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[2])
+	if err != nil {
+		return "", errors.New("invalid link state")
+	}
+	mac := hmac.New(sha256.New, auth.Secret)
+	_, _ = mac.Write([]byte(parts[0] + "." + parts[1]))
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", errors.New("invalid link state")
+	}
+	return string(uid), nil
+}
+
