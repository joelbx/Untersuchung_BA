new file mode 100644
index 0000000..9ae0612
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,86 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("LastFM auth router", func() {
+	It("binds the callback and link operations to the authenticated user", func() {
+		previousSecret := auth.Secret
+		auth.Secret = []byte("test-only-link-state-secret")
+		defer func() { auth.Secret = previousSecret }()
+
+		ds := &tests.MockDataStore{}
+		httpClient := &tests.FakeHttpClient{Res: http.Response{
+			Body:       ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"SK-1"}}`)),
+			StatusCode: 200,
+		}}
+		router := &Router{sessionKeys: &sessionKeys{ds: ds}, client: NewClient("key", "secret", "en", httpClient)}
+		userOne := request.WithUser(context.Background(), model.User{ID: "user-1"})
+		userTwo := request.WithUser(context.Background(), model.User{ID: "user-2"})
+
+		start := httptest.NewRecorder()
+		router.startLink(start, httptest.NewRequest(http.MethodGet, "/link/start", nil).WithContext(userOne))
+		Expect(start.Code).To(Equal(http.StatusOK))
+		var result struct{ State string }
+		Expect(json.Unmarshal(start.Body.Bytes(), &result)).To(Succeed())
+		Expect(result.State).ToNot(BeEmpty())
+
+		callback := httptest.NewRecorder()
+		router.callback(callback, httptest.NewRequest(http.MethodGet, "/link/callback?token=token&state="+url.QueryEscape(result.State), nil))
+		Expect(callback.Code).To(Equal(http.StatusOK))
+		Expect(ds.UserProps(userOne).Get("user-1", sessionKeyProperty)).To(Equal("SK-1"))
+		_, err := ds.UserProps(userTwo).Get("user-2", sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+
+		status := httptest.NewRecorder()
+		router.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(userTwo))
+		Expect(status.Code).To(Equal(http.StatusOK))
+		Expect(status.Body.String()).To(ContainSubstring(`"status":false`))
+
+		Expect(ds.UserProps(userTwo).Put("user-2", sessionKeyProperty, "SK-2")).To(Succeed())
+		unlink := httptest.NewRecorder()
+		router.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(userTwo))
+		Expect(unlink.Code).To(Equal(http.StatusOK))
+		Expect(ds.UserProps(userOne).Get("user-1", sessionKeyProperty)).To(Equal("SK-1"))
+		_, err = ds.UserProps(userTwo).Get("user-2", sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+
+		parts := strings.Split(result.State, ".")
+		parts[0] = "dXNlci0y" // user-2 with user-1's signature
+		invalid := httptest.NewRecorder()
+		router.callback(invalid, httptest.NewRequest(http.MethodGet, "/link/callback?token=token&state="+url.QueryEscape(strings.Join(parts, ".")), nil))
+		Expect(invalid.Code).To(Equal(http.StatusBadRequest))
+		_, err = ds.UserProps(userTwo).Get("user-2", sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+	})
+
+	It("rejects expired link states", func() {
+		_, err := userFromLinkState(makeLinkState("user-1", time.Now().Add(-time.Minute)))
+		Expect(err).To(HaveOccurred())
+	})
+
+	It("rejects link operations without an authenticated user", func() {
+		router := &Router{sessionKeys: &sessionKeys{ds: &tests.MockDataStore{}}}
+		for _, handler := range []http.HandlerFunc{router.startLink, router.getLinkStatus, router.unlink} {
+			response := httptest.NewRecorder()
+			handler(response, httptest.NewRequest(http.MethodGet, "/link", nil))
+			Expect(response.Code).To(Equal(http.StatusUnauthorized))
+		}
+	})
+})
