+def test_Request_open_response_stream(urlopen_mock, install_opener_mock, encoding, decompress):
+    body = b'{"message":"hello"}' * 100
+    wire_body = gzip.compress(body) if encoding == 'gzip' else body
+    source = io.BytesIO(wire_body)
+    headers = {'Content-Encoding': encoding, 'Content-Length': str(len(wire_body))}
