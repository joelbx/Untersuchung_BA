+func TestLoadEnvironmentOverrides(t *testing.T) {
+	// Start each case without the two overrides, including when the test
+	// process itself has them set.
+	for _, key := range []string{"FLIPT_LOG_LEVEL", "FLIPT_SERVER_HTTP_PORT"} {
+		t.Setenv(key, "")
+		require.NoError(t, os.Unsetenv(key))
+	}
+
+	path := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(path, []byte("log:\n  level: WARN\nserver:\n  http_port: 8087\n"), 0600))
+
+	for _, tt := range []struct {
+		name     string
+		path     string
+		logLevel string
+		httpPort string
+		wantLog  string
+		wantPort int
+	}{
+		{name: "defaults", wantLog: "INFO", wantPort: 8080},
+		{name: "default log override", logLevel: "debug", wantLog: "debug", wantPort: 8080},
+		{name: "default port override", httpPort: "9090", wantLog: "INFO", wantPort: 9090},
+		{name: "both default overrides", logLevel: "debug", httpPort: "9090", wantLog: "debug", wantPort: 9090},
+		{name: "file values", path: path, wantLog: "WARN", wantPort: 8087},
+		{name: "file overrides", path: path, logLevel: "debug", httpPort: "9090", wantLog: "debug", wantPort: 9090},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.logLevel != "" {
+				t.Setenv("FLIPT_LOG_LEVEL", tt.logLevel)
+			}
+			if tt.httpPort != "" {
+				t.Setenv("FLIPT_SERVER_HTTP_PORT", tt.httpPort)
+			}
+
+			res, err := Load(tt.path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantLog, res.Config.Log.Level)
+			assert.Equal(t, tt.wantPort, res.Config.Server.HTTPPort)
+			if tt.name == "defaults" {
+				assert.Equal(t, Default(), res.Config)
+			}
+		})
+	}
+}
