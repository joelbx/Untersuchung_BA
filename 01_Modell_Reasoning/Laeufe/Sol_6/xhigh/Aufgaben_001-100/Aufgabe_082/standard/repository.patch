 )
 
+type testAuditWriter struct {
+	bytes.Buffer
+	closeErr error
+}
+
+func (w *testAuditWriter) Close() error {
+	return w.closeErr
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	first, second := &testAuditWriter{}, &testAuditWriter{}
+	multi, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent}}
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, first.String(), second.String())
+	require.Contains(t, first.String(), `"event":"user.login"`)
+	require.Equal(t, byte('\n'), first.Bytes()[first.Len()-1])
+	require.Equal(t, 1, bytes.Count(first.Bytes(), []byte{'\n'}))
+	require.NoError(t, multi.Close())
+}
+
+func TestNewMultiLogRejectsNonEmitter(t *testing.T) {
+	_, err := NewMultiLog(NewWriterLog(&testAuditWriter{}))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
+
+func TestWriterEmitterCloseErrors(t *testing.T) {
+	writer := &testAuditWriter{closeErr: io.ErrClosedPipe}
+	err := NewWriterEmitter(writer).Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), io.ErrClosedPipe.Error())
+}
