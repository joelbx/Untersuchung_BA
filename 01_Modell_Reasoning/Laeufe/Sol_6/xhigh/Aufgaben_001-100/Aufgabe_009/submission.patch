diff --git a/src/components/views/settings/devices/DeviceDetailHeading.tsx b/src/components/views/settings/devices/DeviceDetailHeading.tsx
new file mode 100644
index 0000000..a0768cd
--- /dev/null
+++ b/src/components/views/settings/devices/DeviceDetailHeading.tsx
@@ -0,0 +1,138 @@
+/*
+Copyright 2022 The Matrix.org Foundation C.I.C.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useState } from 'react';
+import { IMyDevice } from 'matrix-js-sdk/src/matrix';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Field from '../../elements/Field';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+
+interface Props {
+    device: IMyDevice;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading = ({ device, saveDeviceName }: Props): JSX.Element => {
+    const [displayName, setDisplayName] = useState(device.display_name);
+    const [draftName, setDraftName] = useState('');
+    const [isEditing, setIsEditing] = useState(false);
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    useEffect(() => {
+        setDisplayName(device.display_name);
+    }, [device.device_id, device.display_name]);
+
+    const visibleName = displayName ?? device.device_id;
+
+    const onRename = () => {
+        setDraftName(visibleName);
+        setError(undefined);
+        setIsEditing(true);
+    };
+
+    const onCancel = () => {
+        setError(undefined);
+        setIsEditing(false);
+    };
+
+    const onSave = async (event: React.SyntheticEvent): Promise<void> => {
+        event.preventDefault();
+        if (isSaving) return;
+        if (draftName === visibleName) {
+            setIsEditing(false);
+            return;
+        }
+
+        setIsSaving(true);
+        setError(undefined);
+        try {
+            await saveDeviceName(device.device_id, draftName);
+            setDisplayName(draftName);
+            setIsEditing(false);
+        } catch (error) {
+            setError(_t('Failed to set display name.'));
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (!isEditing) {
+        return <div className='mx_DeviceDetailHeading' data-testid='device-detail-heading'>
+            <Heading size='h3'>{ visibleName }</Heading>
+            <AccessibleButton
+                kind='link_inline'
+                onClick={onRename}
+                data-testid='device-detail-rename'
+            >
+                { _t('Rename') }
+            </AccessibleButton>
+        </div>;
+    }
+
+    return <form
+        className='mx_DeviceDetailHeading_edit'
+        data-testid='device-detail-heading-edit'
+        aria-busy={isSaving}
+        onSubmit={onSave}
+    >
+        <Field
+            label={_t('Session name')}
+            type='text'
+            value={draftName}
+            maxLength={100}
+            autoComplete='off'
+            autoFocus
+            disabled={isSaving}
+            data-testid='device-detail-name-input'
+            onChange={event => {
+                setDraftName(event.target.value);
+                setError(undefined);
+            }}
+        />
+        <p className='mx_DeviceDetailHeading_hint'>
+            { _t('Session names may be visible to people you communicate with.') }
+        </p>
+        { error && <p role='alert' className='mx_DeviceDetailHeading_error' data-testid='device-detail-name-error'>
+            { error }
+        </p> }
+        <div className='mx_DeviceDetailHeading_actions'>
+            <AccessibleButton
+                element='button'
+                type='submit'
+                kind='primary_sm'
+                onClick={onSave}
+                disabled={isSaving}
+                data-testid='device-detail-name-save'
+            >
+                { _t('Save') }
+            </AccessibleButton>
+            <AccessibleButton
+                element='button'
+                type='button'
+                onClick={onCancel}
+                disabled={isSaving}
+                data-testid='device-detail-name-cancel'
+            >
+                { _t('Cancel') }
+            </AccessibleButton>
+            { isSaving && <Spinner w={16} h={16} /> }
+        </div>
+    </form>;
+};
