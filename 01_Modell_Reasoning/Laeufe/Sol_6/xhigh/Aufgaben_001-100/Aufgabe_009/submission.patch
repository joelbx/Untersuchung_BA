+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-id', display_name: 'Old name' };
+    const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+
+    beforeEach(() => saveDeviceName.mockReset().mockResolvedValue(undefined));
+
+    it('uses the device ID when a display name is undefined', () => {
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ device_id: device.device_id }}
+            saveDeviceName={saveDeviceName}
+        />);
+        expect(getByTestId('device-detail-heading').textContent).toContain(device.device_id);
+    });
+
+    it('saves a changed name, shows progress, and returns to the read view', async () => {
+        let resolveSave: () => void;
+        saveDeviceName.mockImplementation(() => new Promise<void>(resolve => { resolveSave = resolve; }));
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-rename'));
+        const input = getByTestId('device-detail-name-input') as HTMLInputElement;
+        expect(input.maxLength).toBe(100);
+        expect(input.value).toBe('Old name');
+        expect(getByTestId('device-detail-heading-edit').textContent).toContain('may be visible');
+
+        fireEvent.change(input, { target: { value: 'Work Laptop' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+
+        expect(saveDeviceName).toHaveBeenCalledWith(device.device_id, 'Work Laptop');
+        expect(getByTestId('device-detail-heading-edit').getAttribute('aria-busy')).toBe('true');
+        expect(getByTestId('device-detail-name-save').getAttribute('aria-disabled')).toBe('true');
+
+        resolveSave();
+        await waitFor(() => expect(queryByTestId('device-detail-heading-edit')).toBeNull());
+        expect(getByTestId('device-detail-heading').textContent).toContain('Work Laptop');
+    });
+
+    it('does not persist an unchanged name and restores the read view', () => {
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading').textContent).toContain('Old name');
+    });
+
+    it('accepts an empty name', async () => {
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(queryByTestId('device-detail-heading-edit')).toBeNull());
+        expect(saveDeviceName).toHaveBeenCalledWith(device.device_id, '');
+        expect(getByTestId('device-detail-heading').querySelector('h3')?.textContent).toBe('');
+    });
+
+    it('cancels without saving', () => {
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Draft' } });
+        fireEvent.click(getByTestId('device-detail-name-cancel'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading').textContent).toContain('Old name');
+    });
+
+    it('reports a failed save and keeps the edit view', async () => {
+        saveDeviceName.mockRejectedValue(new Error('Network error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'New name' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-name-error').textContent).toBe(
+            'Failed to set display name.',
+        ));
+        expect(getByTestId('device-detail-heading-edit').getAttribute('aria-busy')).toBe('false');
+    });
+});
