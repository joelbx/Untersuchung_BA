+		{"valid strings", ComparisonType_STRING_COMPARISON_TYPE, `["alpha","beta"]`, nil},
+		{"empty strings", ComparisonType_STRING_COMPARISON_TYPE, `[]`, nil},
+		{"100 strings", ComparisonType_STRING_COMPARISON_TYPE, stringArray(MAX_JSON_ARRAY_ITEMS), nil},
+		{"101 strings", ComparisonType_STRING_COMPARISON_TYPE, stringArray(MAX_JSON_ARRAY_ITEMS + 1), errors.ErrInvalid(`too many values provided for property "foo" of type string (maximum 100)`)},
+		{"invalid string JSON", ComparisonType_STRING_COMPARISON_TYPE, `[`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"string scalar", ComparisonType_STRING_COMPARISON_TYPE, `"alpha"`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"empty string JSON", ComparisonType_STRING_COMPARISON_TYPE, ``, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
