+		{"null string element", ComparisonType_STRING_COMPARISON_TYPE, `[null]`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"null string list", ComparisonType_STRING_COMPARISON_TYPE, `null`, errors.ErrInvalid(`invalid value provided for property "foo" of type string`)},
+		{"valid numbers", ComparisonType_NUMBER_COMPARISON_TYPE, `[1,2.5]`, nil},
+		{"empty numbers", ComparisonType_NUMBER_COMPARISON_TYPE, `[]`, nil},
+		{"100 numbers", ComparisonType_NUMBER_COMPARISON_TYPE, numberArray(MAX_JSON_ARRAY_ITEMS), nil},
