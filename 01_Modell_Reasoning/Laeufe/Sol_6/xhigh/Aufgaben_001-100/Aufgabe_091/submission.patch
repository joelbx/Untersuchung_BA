+func validateArrayValue(value, property string, comparisonType ComparisonType) error {
+	typeName := "string"
+	var err error
+
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		var values []string
+		err = json.Unmarshal([]byte(value), &values)
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		typeName = "number"
+		var values []float64
+		err = json.Unmarshal([]byte(value), &values)
+	}
+
+	invalidValue := func() error {
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+	}
+
+	if err != nil {
+		return invalidValue()
+	}
+
+	var items []json.RawMessage
+	if err := json.Unmarshal([]byte(value), &items); err != nil || items == nil {
+		return invalidValue()
+	}
+
+	for _, item := range items {
+		if strings.TrimSpace(string(item)) == "null" {
+			return invalidValue()
+		}
+	}
+
+	if len(items) > MAX_JSON_ARRAY_ITEMS {
+		return errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", property, typeName, MAX_JSON_ARRAY_ITEMS)
+	}
+
+	return nil
+}
