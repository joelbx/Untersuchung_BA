diff --git a/packages/shared/test/mail/recipient.spec.ts b/packages/shared/test/mail/recipient.spec.ts
new file mode 100644
index 0000000..b4ef254
--- /dev/null
+++ b/packages/shared/test/mail/recipient.spec.ts
@@ -0,0 +1,34 @@
+import { inputToRecipient, splitBySeparator } from '../../lib/mail/recipient';
+
+describe('recipient input', () => {
+    it('splits mixed separators in order without empty or bracket-only tokens', () => {
+        expect(
+            splitBySeparator(
+                ',plus@debye.proton.black, visionary@debye.proton.black; pro@debye.proton.black, , <>; <domain@debye.proton.black>,'
+            )
+        ).toEqual([
+            'plus@debye.proton.black',
+            'visionary@debye.proton.black',
+            'pro@debye.proton.black',
+            'domain@debye.proton.black',
+        ]);
+    });
+
+    it('uses the address as both name and address for plain and bracketed emails', () => {
+        expect(inputToRecipient(' email@domain.test ')).toEqual({
+            Name: 'email@domain.test',
+            Address: 'email@domain.test',
+        });
+        expect(inputToRecipient(' <email@domain.test> ')).toEqual({
+            Name: 'email@domain.test',
+            Address: 'email@domain.test',
+        });
+    });
+
+    it('preserves an explicit display name', () => {
+        expect(inputToRecipient('Alice <email@domain.test>')).toEqual({
+            Name: 'Alice',
+            Address: 'email@domain.test',
+        });
+    });
+});
