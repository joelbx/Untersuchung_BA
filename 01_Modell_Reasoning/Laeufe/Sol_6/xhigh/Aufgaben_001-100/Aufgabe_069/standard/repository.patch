+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		matches []string
+		misses  []string
+	}{
+		{pattern: "foo", matches: []string{"foo"}, misses: []string{"foobar", "barfoo"}},
+		{pattern: "*", matches: []string{"", "anything"}},
+		{pattern: "foo*bar", matches: []string{"foobar", "foo-middle-bar"}, misses: []string{"foo-middle-baz"}},
+		{pattern: "^foo+$", matches: []string{"foo", "fooo"}, misses: []string{"foo+", "xfoo"}},
+		{pattern: `{{regexp.match("foo")}}`, matches: []string{"foo", "xfooy"}, misses: []string{"bar"}},
+		{pattern: `{{regexp.not_match("foo")}}`, matches: []string{"bar"}, misses: []string{"foo", "xfooy"}},
+		{pattern: `foo-{{regexp.match("bar")}}-baz`, matches: []string{"foo-bar-baz", "foo-xbary-baz"}, misses: []string{"foo-bar-no", "other-bar-baz", "foo--baz"}},
+		{pattern: `foo-{{regexp.not_match("bar")}}-baz`, matches: []string{"foo-qux-baz"}, misses: []string{"foo-bar-baz", "other-qux-baz"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, in := range tt.matches {
+				assert.True(t, matcher.Match(in), "%q should match", in)
+			}
+			for _, in := range tt.misses {
+				assert.False(t, matcher.Match(in), "%q should not match", in)
+			}
+		})
+	}
+}
