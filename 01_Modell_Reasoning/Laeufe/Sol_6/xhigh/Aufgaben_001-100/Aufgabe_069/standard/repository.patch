+func TestMatchErrors(t *testing.T) {
+	_, invalidRegexp := regexp.Compile("[")
+	tests := []struct {
+		in   string
+		want string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, `unsupported function namespace other, supported namespaces are email and regexp`},
+		{`{{regexp.other("foo")}}`, `unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match.`},
+		{`{{email.other("foo")}}`, `unsupported function email.other, supported functions are: email.local`},
+		{`{{regexp.match("[")}}`, fmt.Sprintf("failed parsing regexp %q: %v", "[", invalidRegexp)},
+		{`{{regexp.match()}}`, `expected 1 string literal argument for regexp.match, got 0`},
+		{`{{regexp.match("a", "b")}}`, `expected 1 string literal argument for regexp.match, got 2`},
+		{`{{regexp.match(internal.foo)}}`, `expected a string literal argument for regexp.match`},
+		{`{{internal.foo}}`, `"internal.foo" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{email.local("foo")}}`, `"email.local(\"foo\")" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match(regexp.match("foo"))}}`, `expected a string literal argument for regexp.match`},
+		{`{{regexp.match("foo")}}{{regexp.match("bar")}}`, `"{{regexp.match(\"foo\")}}{{regexp.match(\"bar\")}}" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{{{regexp.match("foo")}}}}`, `"{{{{regexp.match(\"foo\")}}}}" is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.in, func(t *testing.T) {
+			matcher, err := Match(tt.in)
+			assert.Nil(t, matcher)
+			if assert.True(t, trace.IsBadParameter(err)) {
+				assert.Equal(t, tt.want, err.Error())
+			}
+		})
+	}
+}
