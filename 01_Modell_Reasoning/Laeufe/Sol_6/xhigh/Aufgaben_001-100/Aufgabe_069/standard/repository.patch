+// Matcher tests whether a string satisfies a match expression.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct {
+	re *regexp.Regexp
+}
+
+func (m regexpMatcher) Match(in string) bool {
+	return m.re.MatchString(in)
+}
+
+type prefixSuffixMatcher struct {
+	prefix  string
+	suffix  string
+	matcher Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct {
+	matcher Matcher
+}
+
+func (m notMatcher) Match(in string) bool {
+	return !m.matcher.Match(in)
+}
+
+// Match parses a literal, glob, regular expression, or template matcher.
+// Regular expressions outside templates are recognized by their ^ and $ anchors.
+func Match(value string) (Matcher, error) {
+	match := reVariable.FindStringSubmatch(value)
+	if len(match) == 0 {
+		if n := strings.Count(value, "{{"); n > 1 && n == strings.Count(value, "}}") {
+			return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+		}
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+		}
+		pattern := value
+		if !strings.HasPrefix(value, "^") || !strings.HasSuffix(value, "$") {
+			pattern = "^" + utils.GlobToRegexp(value) + "$"
+		}
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+		}
+		return regexpMatcher{re: re}, nil
+	}
+
+	prefix, expression, suffix := match[1], match[2], match[3]
+	invalid := func() error {
+		return trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, invalid()
+	}
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return nil, invalid()
+	}
+	function, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, invalid()
+	}
+	namespace, ok := function.X.(*ast.Ident)
+	if !ok {
+		return nil, invalid()
+	}
+
+	switch namespace.Name {
+	case "regexp":
+		if function.Sel.Name != "match" && function.Sel.Name != "not_match" {
+			return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match.", function.Sel.Name)
+		}
+	case EmailNamespace:
+		if function.Sel.Name != EmailLocalFnName {
+			return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", function.Sel.Name)
+		}
+	default:
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("expected 1 string literal argument for %s.%s, got %d", namespace.Name, function.Sel.Name, len(call.Args))
+	}
+	argument, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || argument.Kind != token.STRING {
+		return nil, trace.BadParameter("expected a string literal argument for %s.%s", namespace.Name, function.Sel.Name)
+	}
+	raw, err := strconv.Unquote(argument.Value)
+	if err != nil {
+		return nil, trace.BadParameter("invalid string literal %q: %v", argument.Value, err)
+	}
+	if namespace.Name == EmailNamespace {
+		// email.local transforms a variable, which matcher expressions cannot use.
+		return nil, invalid()
+	}
+	re, err := regexp.Compile(raw)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", raw, err)
+	}
+	var matcher Matcher = regexpMatcher{re: re}
+	if function.Sel.Name == "not_match" {
+		matcher = notMatcher{matcher: matcher}
+	}
+	return prefixSuffixMatcher{prefix: prefix, suffix: suffix, matcher: matcher}, nil
+}
