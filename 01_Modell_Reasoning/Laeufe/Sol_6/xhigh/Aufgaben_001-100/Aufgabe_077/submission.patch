@@ -49,3 +49,44 @@ def test_deprecate_without_list(am, capfd):
     assert output['deprecations'] == [
         {u'msg': u'Simple deprecation warning', u'version': None},
     ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_date_and_exit_json_order(am, capfd):
+    am.deprecate('by date', date='2030-01-02')
+    am.deprecate('by version', version='2.14')
+
+    with pytest.raises(SystemExit):
+        am.exit_json(deprecations=[{'msg': 'another date', 'date': '2031-02-03'},
+                                   'without schedule', ('last', '2.15')])
+
+    output = json.loads(capfd.readouterr()[0])
+    assert output['deprecations'] == [
+        {'msg': 'by date', 'date': '2030-01-02'},
+        {'msg': 'by version', 'version': '2.14'},
+        {'msg': 'another date', 'date': '2031-02-03'},
+        {'msg': 'without schedule', 'version': None},
+        {'msg': 'last', 'version': '2.15'},
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_rejects_version_and_date(am):
+    with pytest.raises(AssertionError, match='^implementation error -- version and date must not both be set$'):
+        am.deprecate('conflicting', version='2.14', date='2030-01-02')
+
+
+@pytest.mark.parametrize('stdin', [{'old': 'value', 'retiring': 'value'}], indirect=['stdin'])
+@pytest.mark.parametrize('am', [{
+    'current': {'aliases': ['old'], 'deprecated_aliases': [{'name': 'old', 'date': '2030-01-02'}]},
+    'retiring': {'removed_at_date': '2031-02-03'},
+}], indirect=['am'])
+def test_argument_spec_date_deprecations(am, capfd):
+    with pytest.raises(SystemExit):
+        am.exit_json()
+
+    output = json.loads(capfd.readouterr()[0])
+    assert output['deprecations'] == [
+        {'msg': "Alias 'old' is deprecated. See the module docs for more information", 'date': '2030-01-02'},
+        {'msg': "Param 'retiring' is deprecated. See the module docs for more information", 'date': '2031-02-03'},
+    ]
