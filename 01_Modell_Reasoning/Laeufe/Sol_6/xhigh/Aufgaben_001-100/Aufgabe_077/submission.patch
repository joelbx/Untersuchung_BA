diff --git a/test/ansible_test/validate-modules-unit/test_argument_spec_dates.py b/test/ansible_test/validate-modules-unit/test_argument_spec_dates.py
new file mode 100644
index 0000000..1492c83
--- /dev/null
+++ b/test/ansible_test/validate-modules-unit/test_argument_spec_dates.py
@@ -0,0 +1,35 @@
+"""Validation of date based module deprecations."""
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import pytest
+
+from voluptuous import Invalid
+
+from validate_modules.main import parse_removal_date
+from validate_modules.schema import argument_spec_schema
+
+
+@pytest.mark.parametrize('removal', [
+    {'removed_at_date': '2030-01-02'},
+    {'deprecated_aliases': [{'name': 'old', 'date': '2030-01-02'}]},
+    {'deprecated_aliases': [{'name': 'old', 'version': '2.14'}]},
+])
+def test_argument_spec_accepts_removal_schedule(removal):
+    argument_spec_schema()({'value': removal})
+
+
+@pytest.mark.parametrize('alias', [
+    {'name': 'old'},
+    {'name': 'old', 'version': '2.14', 'date': '2030-01-02'},
+])
+def test_alias_requires_one_removal_schedule(alias):
+    with pytest.raises(Invalid):
+        argument_spec_schema()({'value': {'deprecated_aliases': [alias]}})
+
+
+@pytest.mark.parametrize('value', ['2030-1-02', '2030-02-30', 20300102])
+def test_invalid_removal_date(value):
+    with pytest.raises(ValueError):
+        parse_removal_date(value)
