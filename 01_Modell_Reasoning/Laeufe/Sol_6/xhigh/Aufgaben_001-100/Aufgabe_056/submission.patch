@@ -0,0 +1,66 @@
+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+jest.mock('@proton/shared/lib/helpers/browser');
+
+const mockGetBrowser = jest.mocked(getBrowser);
+const mockGetOS = jest.mocked(getOS);
+
+describe('modern image support', () => {
+    const modernTypes = [
+        SupportedMimeTypes.heic,
+        SupportedMimeTypes.heics,
+        SupportedMimeTypes.heif,
+        SupportedMimeTypes.heifs,
+        SupportedMimeTypes.jxl,
+    ];
+
+    it.each([
+        ['Mac OS', 'Safari', '17'],
+        ['iOS', 'Mobile Safari', '17.0'],
+        ['Mac OS', 'Safari', '18.1'],
+    ])('supports HEIC and JXL on %s %s %s', (osName, browserName, version) => {
+        mockGetOS.mockReturnValue({ name: osName, version: '' });
+        mockGetBrowser.mockReturnValue({ name: browserName, version, major: version.split('.')[0] });
+
+        expect(isHEICSupported()).toBe(true);
+        expect(isJXLSupported()).toBe(true);
+        modernTypes.forEach((type) => expect(isSupportedImage(type)).toBe(true));
+    });
+
+    it.each([
+        ['Mac OS', 'Safari', '16.6'],
+        ['iOS', 'Mobile Safari', '16.4'],
+        ['Mac OS', 'Chrome', '17'],
+        ['Windows', 'Safari', '17'],
+        ['Mac OS', 'Safari', ''],
+    ])('rejects HEIC and JXL on %s %s %s', (osName, browserName, version) => {
+        mockGetOS.mockReturnValue({ name: osName, version: '' });
+        mockGetBrowser.mockReturnValue({ name: browserName, version, major: version.split('.')[0] });
+
+        expect(isHEICSupported()).toBe(false);
+        expect(isJXLSupported()).toBe(false);
+        modernTypes.forEach((type) => expect(isSupportedImage(type)).toBe(false));
+        expect(isSupportedImage(SupportedMimeTypes.jpg)).toBe(true);
+    });
+});
+
+describe('mimeTypeFromFile', () => {
+    it('uses a specific MIME type supplied by the browser, including for an empty file', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.jxl', { type: 'image/png' }))).resolves.toBe('image/png');
+    });
+
+    it('uses the extension when the browser type is empty or generic', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.JXL'))).resolves.toBe(SupportedMimeTypes.jxl);
+        await expect(mimeTypeFromFile(new File([], 'photo.heic', { type: 'application/octet-stream' }))).resolves.toBe(
+            SupportedMimeTypes.heic
+        );
+    });
+
+    it('uses the generic type only when the extension is unknown', async () => {
+        await expect(mimeTypeFromFile(new File([], 'photo.unknown'))).resolves.toBe('application/octet-stream');
+    });
+});
