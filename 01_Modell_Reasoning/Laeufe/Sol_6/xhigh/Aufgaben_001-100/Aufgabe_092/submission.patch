+def test_upgrade_updates_only_required_dependencies(monkeypatch, tmp_path_factory, galaxy_server):
+    versions = {
+        'example.parent': ['1.0.0', '2.0.0'],
+        'example.dependency': ['1.0.0', '2.0.0', '3.0.0'],
+        'example.unchanged': ['1.0.0', '2.0.0'],
+    }
+    dependencies = {
+        ('example.parent', '1.0.0'): {'example.dependency': '>=1.0.0', 'example.unchanged': '>=1.0.0'},
+        ('example.parent', '2.0.0'): {'example.dependency': '>=2.0.0', 'example.unchanged': '>=1.0.0'},
+    }
+    installed = [Candidate(name, '1.0.0', '/installed/' + name, 'dir') for name in versions]
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda path, manager: installed)
+    monkeypatch.setattr(galaxy_server, 'get_collection_versions',
+                        lambda namespace, name: versions[namespace + '.' + name])
+    monkeypatch.setattr(galaxy_server, 'get_collection_version_metadata',
+                        lambda namespace, name, version: api.CollectionVersionMetadata(
+                            namespace, name, version, None, None,
+                            dependencies.get((namespace + '.' + name, version), {})))
+
+    test_dir = to_text(tmp_path_factory.mktemp('collection-upgrade'))
+    manager = collection.concrete_artifact_manager.ConcreteArtifactsManager(test_dir, validate_certs=False)
+    monkeypatch.setattr(manager, 'get_direct_collection_dependencies',
+                        lambda candidate: dependencies.get((candidate.fqcn, candidate.ver), {}))
+    mock_install = MagicMock()
+    monkeypatch.setattr(collection, 'install', mock_install)
+    requests = [Requirement('example.parent', '>=1.0.0,<3.0.0', None, 'galaxy')]
+
+    with pytest.raises(AnsibleError, match='Use --force'):
+        collection.install_collections([Requirement('example.parent', '==2.0.0', None, 'galaxy')],
+                                       test_dir, [galaxy_server], False, False, False, False, False, manager)
+    mock_install.assert_not_called()
+
+    collection.install_collections(requests, test_dir, [galaxy_server], False, False, False, False, False,
+                                   manager, upgrade=True)
+    assert {(call[0][0].fqcn, call[0][0].ver) for call in mock_install.call_args_list} == {
+        ('example.parent', '2.0.0'), ('example.dependency', '3.0.0')}
+
+    installed[:] = [Candidate('example.parent', '2.0.0', '/installed/parent', 'dir'),
+                    Candidate('example.dependency', '3.0.0', '/installed/dependency', 'dir'),
+                    Candidate('example.unchanged', '1.0.0', '/installed/unchanged', 'dir')]
+    mock_install.reset_mock()
+    collection.install_collections(requests, test_dir, [galaxy_server], False, False, False, False, False,
+                                   manager, upgrade=True)
+    mock_install.assert_not_called()
+
+
