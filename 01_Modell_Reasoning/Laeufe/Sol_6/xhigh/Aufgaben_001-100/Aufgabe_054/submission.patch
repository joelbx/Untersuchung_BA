+func TestGetInstanceValueAndPointer(t *testing.T) {
+	type instance struct{ id int }
+	var valueCalls, pointerCalls int
+
+	value := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 1}
+	})
+	valueAgain := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 2}
+	})
+	if value != valueAgain || value.id != 1 || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%+v second=%+v constructor calls=%d", value, valueAgain, valueCalls)
+	}
+
+	pointer := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 3}
+	})
+	pointerAgain := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 4}
+	})
+	if pointer != pointerAgain || pointer.id != 3 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", pointer, pointerAgain, pointerCalls)
+	}
+}
