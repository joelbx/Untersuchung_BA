+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// Each type, including each pointer type, has its own instance.
+func GetInstance[T any](constructor func() T) T {
+	typ := reflect.TypeOf((*T)(nil)).Elem()
+	actual, _ := genericInstances.LoadOrStore(typ, &genericEntry{})
+	e := actual.(*genericEntry)
+	e.once.Do(func() {
+		instance := constructor()
+		e.value = &instance
+	})
+	return *e.value.(*T)
+}
