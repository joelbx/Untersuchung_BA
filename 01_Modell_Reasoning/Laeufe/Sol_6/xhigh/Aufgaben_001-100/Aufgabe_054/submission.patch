+func TestGetInstanceConcurrent(t *testing.T) {
+	type instance struct{ id int }
+	const calls = 20000
+	var constructorCalls int32
+	results := make([]*instance, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *instance {
+				atomic.AddInt32(&constructorCalls, 1)
+				return &instance{id: 1}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&constructorCalls); got != 1 {
+		t.Fatalf("constructor called %d times, want 1", got)
+	}
+	for i, result := range results {
+		if result == nil || result != results[0] {
+			t.Fatalf("call %d returned %p, want %p", i, result, results[0])
+		}
+	}
+}
