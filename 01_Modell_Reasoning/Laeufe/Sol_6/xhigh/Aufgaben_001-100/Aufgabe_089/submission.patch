+// validateReferences runs before creating any resources, so an invalid import
+// has the same result even when retried against the same store.
+func validateReferences(doc *Document, namespace string) error {
+	segments := make(map[string]bool)
+	for _, segment := range doc.Segments {
+		if segment != nil {
+			segments[segment.Key] = true
+		}
+	}
+	for _, flag := range doc.Flags {
+		if flag == nil {
+			continue
+		}
+		variants := make(map[string]bool)
+		for _, variant := range flag.Variants {
+			if variant != nil {
+				variants[variant.Key] = true
+			}
+		}
+		checkSegment := func(index int, key string) error {
+			if key != "" && !segments[key] {
+				return fmt.Errorf("flag %s/%s rule %d references unknown segment %q", namespace, flag.Key, index, key)
+			}
+			return nil
+		}
+		for index, rule := range flag.Rules {
+			if rule == nil {
+				continue
+			}
+			if rule.Segment != nil {
+				switch segment := rule.Segment.IsSegment.(type) {
+				case SegmentKey:
+					if err := checkSegment(index, string(segment)); err != nil {
+						return err
+					}
+				case *Segments:
+					for _, key := range segment.Keys {
+						if err := checkSegment(index, key); err != nil {
+							return err
+						}
+					}
+				}
+			}
+			for _, distribution := range rule.Distributions {
+				if distribution != nil && !variants[distribution.VariantKey] {
+					return fmt.Errorf("flag %s/%s rule %d references unknown variant %q", namespace, flag.Key, index, distribution.VariantKey)
+				}
+			}
+		}
+		for index, rollout := range flag.Rollouts {
+			if rollout == nil || rollout.Segment == nil {
+				continue
+			}
+			if err := checkSegment(index, rollout.Segment.Key); err != nil {
+				return err
+			}
+			for _, key := range rollout.Segment.Keys {
+				if err := checkSegment(index, key); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
+
 // convert converts each encountered map[interface{}]interface{} to a map[string]interface{} value.
 // This is necessary because the json library does not support map[interface{}]interface{} values which nested
 // maps get unmarshalled into from the yaml library.
