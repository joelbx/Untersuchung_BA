+func TestSnapshotRejectsInvalidReferences(t *testing.T) {
+	contents := []byte(`namespace: default
+flags:
+- key: example
+  name: Example
+  variants: []
+  rules:
+  - segment: missing
+    distributions:
+    - variant: absent
+      rollout: 100
+segments: []
+`)
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "features.yaml"), contents, 0600))
+	files := os.DirFS(dir)
+	for _, build := range []struct {
+		name string
+		fn   func() (*StoreSnapshot, error)
+	}{
+		{"paths", func() (*StoreSnapshot, error) { return SnapshotFromPaths(files, "features.yaml") }},
+		{"filesystem", func() (*StoreSnapshot, error) { return SnapshotFromFS(zap.NewNop(), files) }},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			snapshot, err := build.fn()
+			require.Nil(t, snapshot)
+			issues, ok := cue.Unwrap(err)
+			require.True(t, ok)
+			require.Len(t, issues, 2)
+			assert.EqualError(t, issues[0], `flag default/example rule 0 references unknown segment "missing" (features.yaml 7:14)`)
+			assert.EqualError(t, issues[1], `flag default/example rule 0 references unknown variant "absent" (features.yaml 9:16)`)
+		})
+	}
+}
