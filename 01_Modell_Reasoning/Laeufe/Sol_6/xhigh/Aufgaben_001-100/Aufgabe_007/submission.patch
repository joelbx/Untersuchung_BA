+    @pytest.mark.parametrize('use_pexpect', [False, True])
+    def test_kinit_uses_unique_cache_per_attempt(self, monkeypatch, use_pexpect):
+        if use_pexpect:
+            pytest.importorskip("pexpect")
+            mock_process = MagicMock()
+            mock_process.return_value.exitstatus = 0
+            monkeypatch.setattr("pexpect.spawn", mock_process)
+        else:
+            mock_process = MagicMock()
+            mock_process.return_value.communicate.return_value = (b"", b"")
+            mock_process.return_value.returncode = 0
+            monkeypatch.setattr("subprocess.Popen", mock_process)
+
+        winrm.HAS_PEXPECT = use_pexpect
+        conn = connection_loader.get('winrm', PlayContext(), StringIO())
+        conn.set_options(var_options={"_extras": {}})
+        conn._build_winrm_kwargs()
+
+        conn._kerb_auth("user@domain", "pass")
+        first_cache = mock_process.call_args[1]['env']['KRB5CCNAME']
+        conn._kerb_auth("user@domain", "pass")
+        second_cache = mock_process.call_args[1]['env']['KRB5CCNAME']
+
+        assert mock_process.call_count == 2
