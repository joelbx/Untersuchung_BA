@@ -0,0 +1,53 @@
+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestMiddlewareCookies(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		domain string
+		want   string
+	}{
+		{name: "localhost", domain: "localhost", want: ""},
+		{name: "other host", domain: "auth.example.com", want: "auth.example.com"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{
+				Domain:        tt.domain,
+				StateLifetime: time.Minute,
+				TokenLifetime: time.Hour,
+			})
+
+			req := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			w := httptest.NewRecorder()
+			m.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+			})).ServeHTTP(w, req)
+
+			cookies := w.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, stateCookieKey, cookies[0].Name)
+			require.Equal(t, tt.want, cookies[0].Domain)
+			require.Equal(t, "/auth/v1/method/oidc/google/callback", cookies[0].Path)
+			require.Equal(t, req.URL.Query().Get("state"), cookies[0].Value)
+
+			w = httptest.NewRecorder()
+			require.NoError(t, m.ForwardResponseOption(context.Background(), w, &auth.CallbackResponse{ClientToken: "token"}))
+			cookies = w.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, tokenCookieKey, cookies[0].Name)
+			require.Equal(t, tt.want, cookies[0].Domain)
+			require.Equal(t, "/", cookies[0].Path)
+		})
+	}
+}
