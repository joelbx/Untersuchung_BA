+package oidc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCallbackURL(t *testing.T) {
+	for _, tt := range []struct {
+		host string
+		want string
+	}{
+		{host: "http://localhost:8080", want: "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{host: "http://localhost:8080/", want: "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{host: "https://auth.example.com/", want: "https://auth.example.com/auth/v1/method/oidc/google/callback"},
+		{host: "https://auth.example.com//", want: "https://auth.example.com//auth/v1/method/oidc/google/callback"},
+	} {
+		t.Run(tt.host, func(t *testing.T) {
+			require.Equal(t, tt.want, callbackURL(tt.host, "google"))
+		})
+	}
+}
