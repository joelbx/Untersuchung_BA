+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationConfigValidateSessionDomain(t *testing.T) {
+	tests := []struct {
+		name   string
+		domain string
+		want   string
+	}{
+		{name: "bare host", domain: "auth.example.com", want: "auth.example.com"},
+		{name: "host and port", domain: "auth.example.com:8080", want: "auth.example.com"},
+		{name: "http URL", domain: "http://localhost:8080", want: "localhost"},
+		{name: "https URL", domain: "https://auth.example.com:443", want: "auth.example.com"},
+		{name: "localhost", domain: "localhost", want: "localhost"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tt.domain},
+				Methods: AuthenticationMethods{
+					OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+				},
+			}
+
+			require.NoError(t, cfg.validate())
+			require.Equal(t, tt.want, cfg.Session.Domain)
+		})
+	}
+}
+
+func TestAuthenticationConfigValidateSessionDomainParseError(t *testing.T) {
+	cfg := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: "http://[invalid"},
+		Methods: AuthenticationMethods{
+			OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+		},
+	}
+
+	require.ErrorContains(t, cfg.validate(), "authentication.session.domain")
+}
+
+func TestAuthenticationConfigValidateSessionDomainWithoutHost(t *testing.T) {
+	cfg := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: "http://"},
+		Methods: AuthenticationMethods{
+			OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+		},
+	}
+
+	require.ErrorContains(t, cfg.validate(), "authentication.session.domain")
+}
