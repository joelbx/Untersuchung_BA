+func Test_redhatBase_parseInstalledPackagesContinuesAfterBadSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages(`elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)
+bar 1 9 123a ia64 1:bar-9-123a.src.rpm
+bar-libs 1 9 123a ia64 1:bar-9-123a.src.rpm`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("warnings = %v, want one warning about the source filename", o.warns)
+	}
+	if len(bins) != 3 || bins["elasticsearch"].Version != "8.17.0" || bins["bar"].Version != "1:9" {
+		t.Errorf("binary packages = %v", bins)
+	}
+	src := srcs["bar"]
+	if len(srcs) != 1 || src.Name != "bar" || src.Version != "1:9-123a" || src.Arch != "src" ||
+		len(src.BinaryNames) != 2 || !slices.Contains(src.BinaryNames, "bar") || !slices.Contains(src.BinaryNames, "bar-libs") {
+		t.Errorf("source packages = %v, want bar linked to both binaries", srcs)
+	}
+}
