+func Test_redhatBase_parseInstalledPackagesLineFromRepoqueryBadSourceRPM(t *testing.T) {
+	o := &redhatBase{}
+	bin, src, err := o.parseInstalledPackagesLineFromRepoquery("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm @amzn2-core")
