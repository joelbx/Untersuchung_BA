+	}
+	wantBin := &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64", Repository: "amzn2-core"}
+	if !reflect.DeepEqual(bin, wantBin) || src != nil {
+		t.Errorf("got binary %v, source %v; want %v, nil", bin, src, wantBin)
+	}
+	if len(o.warns) != 1 {
+		t.Errorf("warnings = %v, want one source RPM warning", o.warns)
