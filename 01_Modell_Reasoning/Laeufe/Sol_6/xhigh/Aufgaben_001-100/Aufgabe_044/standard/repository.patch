 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey string
+
+const NamespacesKey contextKey = "namespaces"
+
+func ContextWithNamespaces(ctx context.Context, namespaces []string) context.Context {
+	return context.WithValue(ctx, NamespacesKey, namespaces)
+}
+
+func NamespacesFromContext(ctx context.Context) ([]string, bool) {
+	namespaces, ok := ctx.Value(NamespacesKey).([]string)
+	return namespaces, ok
+}
+
+// FormatNamespaces validates an OPA decision, which may contain JSON values or Go strings.
+func FormatNamespaces(result any) ([]string, error) {
+	if result == nil {
+		return nil, fmt.Errorf("viewable namespaces decision is undefined")
+	}
+	if namespaces, ok := result.([]string); ok {
+		return namespaces, nil
+	}
+	values, ok := result.([]any)
+	if !ok {
+		return nil, fmt.Errorf("viewable namespaces decision must be a list: %T", result)
+	}
+	namespaces := make([]string, 0, len(values))
+	for _, value := range values {
+		namespace, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("viewable namespace must be a string: %T", value)
+		}
+		namespaces = append(namespaces, namespace)
+	}
+	return namespaces, nil
+}
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
