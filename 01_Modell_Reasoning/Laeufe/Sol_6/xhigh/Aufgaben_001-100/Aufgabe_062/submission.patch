 )
 
 var (
@@ -52,3 +55,15 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so an active password prompt can
+// restore the terminal before the process exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(io.Closer); ok {
+		if err := closer.Close(); err != nil {
+			log.WithError(err).Warn("failed to close stdin prompt reader")
+		}
+	}
+}
