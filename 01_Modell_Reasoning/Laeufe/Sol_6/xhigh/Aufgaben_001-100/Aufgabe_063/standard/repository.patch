+func (s *ConfigTestSuite) TestKubeProxyListenAddress(c *check.C) {
+	tests := []struct {
+		name, config, address string
+		enabled               bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", true},
+		{"default port", "proxy_service:\n  kube_listen_addr: kube.example.com\n", "kube.example.com:3026", true},
+		{"IPv6", "proxy_service:\n  kube_listen_addr: '[::]:8080'\n", "[::]:8080", true},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:3026\n", "0.0.0.0:8080", true},
+		{"legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:8080\n", "127.0.0.1:8080", true},
+		{"legacy disabled", "proxy_service:\n  kubernetes:\n    enabled: no\n", "0.0.0.0:3026", false},
+	}
+	for _, tt := range tests {
+		fc, err := ReadConfig(bytes.NewBufferString(tt.config))
+		c.Assert(err, check.IsNil, check.Commentf(tt.name))
+		cfg := service.MakeDefaultConfig()
+		c.Assert(ApplyFileConfig(fc, cfg), check.IsNil, check.Commentf(tt.name))
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, tt.enabled, check.Commentf(tt.name))
+		c.Assert(cfg.Proxy.Kube.ListenAddr.String(), check.Equals, tt.address, check.Commentf(tt.name))
+	}
+}
