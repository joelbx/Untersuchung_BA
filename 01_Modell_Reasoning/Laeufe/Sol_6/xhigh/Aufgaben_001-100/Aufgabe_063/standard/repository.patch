+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	tests := []struct {
+		name, listen, public, webPublic, want string
+	}{
+		{"wildcard IPv4", "0.0.0.0:8080", "", "", "proxy.example.com:8080"},
+		{"wildcard IPv6", "[::]:8080", "", "", "proxy.example.com:8080"},
+		{"web public host", "0.0.0.0:8080", "", "public.example.com:443", "public.example.com:8080"},
+		{"wildcard public host", "0.0.0.0:8080", "[::]:6443", "public.example.com:443", "public.example.com:6443"},
+		{"IPv6 web public host", "[::]:8080", "", "[2001:db8::1]:443", "[2001:db8::1]:8080"},
+		{"public priority", "0.0.0.0:8080", "kube.example.com:6443", "public.example.com:443", "kube.example.com:6443"},
+		{"public default port", "0.0.0.0:8080", "kube.example.com", "", "kube.example.com:3026"},
+		{"no address", "", "", "", "proxy.example.com:3026"},
+	}
+	for _, tt := range tests {
+		tc := &TeleportClient{Config: Config{WebProxyAddr: "proxy.example.com:3080"}}
+		err := tc.applyProxySettings(ProxySettings{
+			Kube: KubeProxySettings{Enabled: true, ListenAddr: tt.listen, PublicAddr: tt.public},
+			SSH:  SSHProxySettings{PublicAddr: tt.webPublic},
+		})
+		c.Assert(err, check.IsNil, check.Commentf(tt.name))
+		c.Assert(tc.KubeProxyAddr, check.Equals, tt.want, check.Commentf(tt.name))
+	}
+	client := &TeleportClient{Config: Config{WebProxyAddr: "[2001:db8::1]:443", KubeProxyAddr: "[2001:db8::1]:8080"}}
+	c.Assert(client.KubeClusterAddr(), check.Equals, "https://[2001:db8::1]:8080")
+}
