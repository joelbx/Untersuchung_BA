+func (s *ConfigTestSuite) TestKubeProxyListenAddressConflict(c *check.C) {
+	for _, legacy := range []string{
+		"    enabled: yes\n    listen_addr: 127.0.0.1:3026\n",
+		"    listen_addr: 127.0.0.1:3026\n",
+	} {
+		fc, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n" + legacy))
+		c.Assert(fc, check.IsNil)
+		c.Assert(err, check.ErrorMatches, ".*proxy_service.kube_listen_addr conflicts with enabled proxy_service.kubernetes.*")
+	}
+}
