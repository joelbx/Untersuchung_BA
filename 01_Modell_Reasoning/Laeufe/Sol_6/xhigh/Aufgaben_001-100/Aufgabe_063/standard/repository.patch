+		config string
+		warn   bool
+	}{
+		{"proxy_service:\n  enabled: yes\nkubernetes_service:\n  enabled: yes\n", true},
+		{"proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\nkubernetes_service:\n  enabled: yes\n", false},
+		{"proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:3026\nkubernetes_service:\n  enabled: yes\n", false},
