+
+package model
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// Ref: https://github.com/openai/openai-cookbook/blob/594fc6c952425810e9ea5bd1a275c8ca5f32e8f9/examples/How_to_count_tokens_with_tiktoken.ipynb
+const (
+	perMessage = 3
+	perRole    = 1
+	perRequest = 3
+)
+
+// TokenCounter reports a token count.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll sums the counters.
+func (counters TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range counters {
+		if !nilCounter(counter) {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount groups the prompt and completion counters for one invocation.
+type TokenCount struct {
+	Prompt     TokenCounters
+	Completion TokenCounters
+}
+
+// NewTokenCount creates an empty token count.
+func NewTokenCount() *TokenCount { return &TokenCount{} }
+
+// AddPromptCounter appends a prompt counter.
+func (count *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if !nilCounter(prompt) {
+		count.Prompt = append(count.Prompt, prompt)
+	}
+}
+
+// AddCompletionCounter appends a completion counter.
+func (count *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if !nilCounter(completion) {
+		count.Completion = append(count.Completion, completion)
+	}
+}
+
+func nilCounter(counter TokenCounter) bool {
+	if counter == nil {
+		return true
+	}
+	value := reflect.ValueOf(counter)
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return value.IsNil()
+	default:
+		return false
+	}
+}
+
+// CountAll returns prompt and completion totals, in that order.
+func (count *TokenCount) CountAll() (int, int) {
+	return count.Prompt.CountAll(), count.Completion.CountAll()
+}
+
+// StaticTokenCounter is a fixed token count.
+type StaticTokenCounter struct{ count int }
+
+// TokenCount returns the fixed count.
+func (counter *StaticTokenCounter) TokenCount() int { return counter.count }
+
+// NewPromptTokenCounter counts message content and per-message overhead.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	var total int
+	for _, message := range messages {
+		tokens, _, err := tokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		total += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: total}, nil
+}
+
+// NewSynchronousTokenCounter counts a completed response and request overhead.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter counts tokens as a response streams in.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter counts the starting fragment of a response.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add records one streamed token.
+func (counter *AsynchronousTokenCounter) Add() error {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	if counter.finished {
+		return trace.BadParameter("token counter is finished")
+	}
+	counter.count++
+	return nil
+}
+
+// setCount corrects chunk-boundary differences once the full response is known.
+// A finalized counter keeps the value already returned to its caller.
+func (counter *AsynchronousTokenCounter) setCount(count int) {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	if !counter.finished {
+		counter.count = count
+	}
+}
+
+// TokenCount finalizes the counter and returns its total including request overhead.
+func (counter *AsynchronousTokenCounter) TokenCount() int {
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.finished = true
+	return perRequest + counter.count
+}
