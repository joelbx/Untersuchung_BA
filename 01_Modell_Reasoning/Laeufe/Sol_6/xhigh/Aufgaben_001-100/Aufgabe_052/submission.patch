+func TestChat_CompleteCountsAllSteps(t *testing.T) {
+	const unknownAction = `{"action":"missing","action_input":"anything"}`
+	const commandAction = `{"action":"Command Execution","action_input":{"command":"df -h","nodes":["localhost"]}}`
+	responses := []string{unknownAction, commandAction}
+	requests := make(chan []openai.ChatCompletionMessage, len(responses))
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var request openai.ChatCompletionRequest
+		require.NoError(t, json.NewDecoder(r.Body).Decode(&request))
+		requests <- request.Messages
+		w.Header().Set("Content-Type", "text/event-stream")
+		response := responses[0]
+		responses = responses[1:]
+		_, err := w.Write([]byte(generateResponse(response)))
+		require.NoError(t, err)
+	}))
+	defer server.Close()
+
+	cfg := openai.DefaultConfig("secret-test-token")
+	cfg.BaseURL = server.URL + "/v1"
+	chat := NewClientFromConfig(cfg).NewChat(nil, "Bob")
+	chat.Insert(openai.ChatMessageRoleUser, "hello")
+
+	message, count, err := chat.Complete(context.Background(), "run df", func(*model.AgentAction) {})
+	require.NoError(t, err)
+	require.IsType(t, &model.CompletionCommand{}, message)
+	require.NotNil(t, count)
+
+	var expectedPrompt int
+	for i := 0; i < 2; i++ {
+		counter, err := model.NewPromptTokenCounter(<-requests)
+		require.NoError(t, err)
+		expectedPrompt += counter.TokenCount()
+	}
+	first, err := model.NewSynchronousTokenCounter(unknownAction)
+	require.NoError(t, err)
+	second, err := model.NewSynchronousTokenCounter(commandAction)
+	require.NoError(t, err)
+	prompt, completion := count.CountAll()
+	require.Equal(t, expectedPrompt, prompt)
+	require.Equal(t, first.TokenCount()+second.TokenCount(), completion)
+}
+
+func generateResponse(content string) string {
+	delta, err := json.Marshal(struct {
+		Content string `json:"content"`
+		Role    string `json:"role"`
+	}{Content: content, Role: "assistant"})
+	if err != nil {
+		panic(err)
+	}
+	return fmt.Sprintf("data: {\"id\":\"1\",\"object\":\"completion\",\"created\":1598069254,\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"delta\":%s}]}\n\ndata: [DONE]\n\n", delta)
+}
