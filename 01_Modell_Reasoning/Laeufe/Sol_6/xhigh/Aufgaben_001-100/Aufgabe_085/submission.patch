+func TestCveIDDiffFormatAndCountDiff(t *testing.T) {
+	infos := VulnInfos{
+		"new":      {CveID: "CVE-NEW", DiffStatus: DiffPlus},
+		"resolved": {CveID: "CVE-RESOLVED", DiffStatus: DiffMinus},
+		"same":     {CveID: "CVE-SAME"},
+	}
+	plus, minus := infos.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Fatalf("CountDiff() = (%d, %d), want (1, 1)", plus, minus)
+	}
+	for _, tt := range []struct {
+		key  string
+		want string
+	}{
+		{"new", "+CVE-NEW"},
+		{"resolved", "-CVE-RESOLVED"},
+		{"same", "CVE-SAME"},
+	} {
+		info := infos[tt.key]
+		if got := info.CveIDDiffFormat(true); got != tt.want {
+			t.Errorf("CveIDDiffFormat(true) = %q, want %q", got, tt.want)
+		}
+		if got := info.CveIDDiffFormat(false); got != info.CveID {
+			t.Errorf("CveIDDiffFormat(false) = %q, want %q", got, info.CveID)
+		}
+	}
+	encoded, err := json.Marshal(infos["resolved"])
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded VulnInfo
+	if err := json.Unmarshal(encoded, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.DiffStatus != DiffMinus {
+		t.Errorf("diff status lost during JSON round trip: %q", decoded.DiffStatus)
+	}
+}
