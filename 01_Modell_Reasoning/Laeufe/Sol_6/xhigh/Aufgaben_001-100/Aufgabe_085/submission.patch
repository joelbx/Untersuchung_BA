+func TestDiffFiltersChangesAndUsesMatchingPackages(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"new":  {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}},
+			"same": {CveID: "same", AffectedPackages: models.PackageFixStatuses{{Name: "shared-package"}}, CveContents: models.CveContents{models.Nvd: {LastModified: time.Unix(1, 0)}}},
+		},
+		Packages: models.Packages{
+			"new-package":    {Name: "new-package", Version: "current"},
+			"shared-package": {Name: "shared-package", Version: "current"},
+		},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"resolved": {CveID: "resolved", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+			"same":     {CveID: "same", AffectedPackages: models.PackageFixStatuses{{Name: "shared-package"}}},
+		},
+		Packages: models.Packages{
+			"old-package":    {Name: "old-package", Version: "previous"},
+			"shared-package": {Name: "shared-package", Version: "previous"},
+		},
+	}
+	for _, tt := range []struct {
+		name        string
+		plus, minus bool
+		want        map[string]models.DiffStatus
+		wantPacks   map[string]string
+	}{
+		{"plus", true, false, map[string]models.DiffStatus{"new": models.DiffPlus}, map[string]string{"new-package": "current"}},
+		{"minus", false, true, map[string]models.DiffStatus{"resolved": models.DiffMinus}, map[string]string{"old-package": "previous"}},
+		{"both", true, true, map[string]models.DiffStatus{"new": models.DiffPlus, "resolved": models.DiffMinus}, map[string]string{"new-package": "current", "old-package": "previous"}},
+		{"neither", false, false, map[string]models.DiffStatus{}, map[string]string{}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tt.plus, tt.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(results) != 1 {
+				t.Fatalf("got %d results, want 1", len(results))
+			}
+			got := results[0]
+			if len(got.ScannedCves) != len(tt.want) {
+				t.Errorf("got CVEs %v, want %v", got.ScannedCves, tt.want)
+			}
+			for id, status := range tt.want {
+				if got.ScannedCves[id].DiffStatus != status {
+					t.Errorf("%s status = %q, want %q", id, got.ScannedCves[id].DiffStatus, status)
+				}
+			}
+			if len(got.Packages) != len(tt.wantPacks) {
+				t.Errorf("got packages %v, want %v", got.Packages, tt.wantPacks)
+			}
+			for name, version := range tt.wantPacks {
+				if got.Packages[name].Version != version {
+					t.Errorf("%s version = %q, want %q", name, got.Packages[name].Version, version)
+				}
+			}
+		})
+	}
+	results, err := diff(models.ScanResults{current}, nil, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if plus, minus := results[0].ScannedCves.CountDiff(); plus != 2 || minus != 0 {
+		t.Errorf("unmatched current scan counts = (%d, %d), want (2, 0)", plus, minus)
+	}
+}
