+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	stdout := `libgcc 0 4.8.5 39.el7 x86_64
+error: file /root/private: Permission denied
+libgcc 0 4.8.5 39.el7 i686
+file /tmp/unowned is not owned by any package
+error: file /tmp/missing: No such file or directory
+libgcc 0 4.8.5 44.el7 x86_64`
+	owners, err := r.parseOwnerPkgs(stdout)
+	if err != nil {
+		t.Fatalf("parseOwnerPkgs: %v", err)
+	}
+	want := []models.Package{
+		{Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64"},
+		{Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "i686"},
+		{Name: "libgcc", Version: "4.8.5", Release: "44.el7", Arch: "x86_64"},
+	}
+	if !reflect.DeepEqual(owners, want) {
+		t.Errorf("owners = %#v, want %#v", owners, want)
+	}
+	for _, line := range []string{
+		"unexpected rpm output",
+		"libgcc bad-epoch 4.8.5 39.el7 x86_64",
+	} {
+		if _, err := r.parseOwnerPkgs(stdout + "\n" + line); err == nil {
+			t.Errorf("expected an error for %q", line)
+		}
+	}
+}
