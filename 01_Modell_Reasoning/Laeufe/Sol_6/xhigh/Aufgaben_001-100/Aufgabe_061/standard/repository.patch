+func TestAddAffectedProcessMatchesInstalledPackage(t *testing.T) {
+	installed := models.Package{Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64"}
+	l := base{osPackages: osPackages{Packages: models.NewPackages(installed)}}
+	proc := models.AffectedProcess{PID: "42", Name: "app"}
+	otherOwners := []models.Package{
+		{Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "i686"},
+		{Name: "libgcc", Version: "4.8.5", Release: "44.el7", Arch: "x86_64"},
+		{Name: "other", Version: "1", Arch: "x86_64"},
+	}
+	l.addAffectedProcess(otherOwners, proc)
+	if got := l.Packages["libgcc"].AffectedProcs; len(got) != 0 {
+		t.Fatalf("unmatched owners added processes: %#v", got)
+	}
+	l.addAffectedProcess(append(otherOwners,
+		installed,
+		installed,
+	), proc)
+	want := []models.AffectedProcess{proc}
+	if got := l.Packages["libgcc"].AffectedProcs; !reflect.DeepEqual(got, want) {
+		t.Errorf("affected processes = %#v, want %#v", got, want)
+	}
+}
