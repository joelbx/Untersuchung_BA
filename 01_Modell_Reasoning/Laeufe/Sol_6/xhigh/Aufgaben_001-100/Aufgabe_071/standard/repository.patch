+def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
     """
     Takes a byte string like '#< CLIXML\r\n<Objs...' and extracts the stream
     message encoded in the XML data. CLIXML is used by PowerShell to encode
     multiple objects in stderr.
     """
-    lines = []
+    def decode_escapes(match: re.Match[str]) -> str:
+        tokens = re.findall(r'_x[0-9A-Fa-f]{4}_', match.group())
+        # PowerShell uses this token to escape an underscore before another
+        # escape. On its own, the uppercase token is literal text.
+        trailing_underscore = tokens[-1] == '_x005F_'
+        if trailing_underscore:
+            tokens.pop()
+
+        code_units = b''.join(int(token[2:6], 16).to_bytes(2, 'little') for token in tokens)
+        decoded = code_units.decode('utf-16-le', errors='surrogatepass')
+        return decoded + ('_x005F_' if trailing_underscore else '')
+
+    blocks = []
 
     # There are some scenarios where the stderr contains a nested CLIXML element like
     # '<# CLIXML\r\n<# CLIXML\r\n<Objs>...</Objs><Objs>...</Objs>'.
     # Parse each individual <Objs> element and add the error strings to our stderr list.
     # https://github.com/ansible/ansible/issues/69550
-    while data:
-        end_idx = data.find(b"</Objs>") + 7
-        current_element = data[data.find(b"<Objs "):end_idx]
-        data = data[end_idx:]
-
-        clixml = ET.fromstring(current_element)
+    for match in re.finditer(rb'<Objs(?:\s[^>]*)?>.*?</Objs>', data, flags=re.DOTALL):
+        clixml = ET.fromstring(match.group())
         namespace_match = re.match(r'{(.*)}', clixml.tag)
         namespace = "{%s}" % namespace_match.group(1) if namespace_match else ""
 
         strings = clixml.findall("./%sS" % namespace)
-        lines.extend([e.text.replace('_x000D__x000A_', '') for e in strings if e.attrib.get('S') == stream])
+        block_text = ''.join(element.text or '' for element in strings if element.attrib.get('S') == stream)
+        block = re.sub(r'(?:_x[0-9A-Fa-f]{4}_)+', decode_escapes, block_text)
+        if block:
+            blocks.append(block)
 
-    return to_bytes('\r\n'.join(lines))
+    return '\r\n'.join(blocks).encode('utf-8', errors='surrogatepass')
 
 
