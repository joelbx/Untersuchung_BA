index 0000000..559ea6a
--- /dev/null
+++ b/lib/utils/fanoutbuffer/buffer_test.go
@@ -0,0 +1,187 @@
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestConfigDefaults(t *testing.T) {
+	var cfg Config
+	cfg.SetDefaults()
+	if cfg.Capacity != 64 || cfg.GracePeriod != 5*time.Minute || cfg.Clock == nil {
+		t.Fatalf("unexpected defaults: %+v", cfg)
+	}
+}
+
+func TestCursorOrderAndCleanup(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	first, second := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+
+	readAll := func(c *Cursor[int]) []int {
+		t.Helper()
+		var got []int
+		out := make([]int, 2)
+		for len(got) < 5 {
+			n, err := c.TryRead(out)
+			if err != nil || n == 0 {
+				t.Fatalf("TryRead = %d, %v", n, err)
+			}
+			got = append(got, out[:n]...)
+		}
+		return got
+	}
+	if got := readAll(first); !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+		t.Fatalf("first cursor: %v", got)
+	}
+	if len(b.overflow) != 3 {
+		t.Fatalf("overflow reclaimed before second cursor read: %d", len(b.overflow))
+	}
+	if got := readAll(second); !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+		t.Fatalf("second cursor: %v", got)
+	}
+	if len(b.overflow) != 0 || b.ringStart != b.next {
+		t.Fatalf("items not reclaimed: overflow=%d, ring=%d..%d", len(b.overflow), b.ringStart, b.next)
+	}
+	if err := first.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := first.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor error = %v", err)
+	}
+
+	// New cursors do not replay items appended before registration.
+	third := b.NewCursor()
+	if n, err := third.TryRead(make([]int, 1)); n != 0 || err != nil {
+		t.Fatalf("new cursor read = %d, %v", n, err)
+	}
+}
+
+func TestOverflowGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClockAt(time.Time{})
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3)
+
+	out := make([]int, 3)
+	if n, err := fast.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("fast read = %d, %v", n, err)
+	}
+	clock.Advance(time.Minute)
+	if n, err := slow.TryRead(out); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow read = %d, %v", n, err)
+	}
+	if len(b.overflow) != 0 {
+		t.Fatalf("overflow retained after expiry: %d", len(b.overflow))
+	}
+
+	b.Append(4, 5, 6)
+	if n, err := fast.TryRead(out); n != 3 || err != nil || !reflect.DeepEqual(out, []int{4, 5, 6}) {
+		t.Fatalf("fast cursor after slow expiry = %d, %v, %v", n, err, out)
+	}
+}
+
+func TestCursorCatchesUpWithinGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClockAt(time.Time{})
+	b := NewBuffer[int](Config{Capacity: 1, GracePeriod: time.Minute, Clock: clock})
+	defer b.Close()
+	c := b.NewCursor()
+	b.Append(1, 2)
+	out := make([]int, 2)
+	if n, err := c.TryRead(out); n != 2 || err != nil || !reflect.DeepEqual(out, []int{1, 2}) {
+		t.Fatalf("catch-up read = %d, %v, %v", n, err, out)
+	}
+	clock.Advance(time.Minute)
+	b.Append(3, 4)
+	if n, err := c.TryRead(out); n != 2 || err != nil || !reflect.DeepEqual(out, []int{3, 4}) {
+		t.Fatalf("read after new overflow = %d, %v, %v", n, err, out)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]int, 1)
+		n, err := c.Read(context.Background(), out)
+		if err == nil && (n != 1 || out[0] != 42) {
+			err = errors.New("wrong item returned")
+		}
+		result <- err
+	}()
+	b.Append(42)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		result <- err
+	}()
+	b.Close()
+	if err := <-result; !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("blocked read after close = %v", err)
+	}
+	if _, err := b.NewCursor().TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("new cursor after close = %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor = %v", err)
+	}
+}
+
+func TestReadContextCancellation(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	defer b.Close()
+	c := b.NewCursor()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if n, err := c.Read(ctx, make([]int, 1)); n != 0 || !errors.Is(err, context.Canceled) {
+		t.Fatalf("Read with canceled context = %d, %v", n, err)
+	}
+}
+
+func TestConcurrentAppendFanout(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 8, GracePeriod: time.Hour})
+	defer b.Close()
+	first, second := b.NewCursor(), b.NewCursor()
+	var wg sync.WaitGroup
+	for producer := 0; producer < 4; producer++ {
+		wg.Add(1)
+		go func(producer int) {
+			defer wg.Done()
+			for i := 0; i < 100; i++ {
+				b.Append(producer*100 + i)
+			}
+		}(producer)
+	}
+	wg.Wait()
+	readAll := func(c *Cursor[int]) []int {
+		var got []int
+		out := make([]int, 32)
+		for len(got) < 400 {
+			n, err := c.TryRead(out)
+			if err != nil || n == 0 {
+				t.Fatalf("TryRead = %d, %v", n, err)
+			}
+			got = append(got, out[:n]...)
+		}
+		return got
+	}
+	a, z := readAll(first), readAll(second)
+	if !reflect.DeepEqual(a, z) {
+		t.Fatal("cursors received different order")
+	}
+}
