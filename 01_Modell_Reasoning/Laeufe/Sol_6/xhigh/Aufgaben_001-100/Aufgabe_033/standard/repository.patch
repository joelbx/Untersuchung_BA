+func (s *AuthSuite) TestU2FSignRequestMultipleDevices(c *C) {
+	ctx := context.Background()
+	const user = "u2f-user"
+	password := []byte("password")
+	pref, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  "https://me.localhost",
+			Facets: []string{"https://me.localhost"},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.SetAuthPreference(pref), IsNil)
+	usr, err := services.NewUser(user)
+	c.Assert(err, IsNil)
+	c.Assert(s.a.CreateUser(ctx, usr), IsNil)
+	c.Assert(s.a.Identity.UpsertPassword(user, password), IsNil)
+
+	keys := make([]*mocku2f.Key, 2)
+	for i := range keys {
+		keys[i], err = mocku2f.Create()
+		c.Assert(err, IsNil)
+		dev, err := u2f.NewDevice(fmt.Sprintf("key-%d", i), &u2f.Registration{
+			KeyHandle: keys[i].KeyHandle,
+			PubKey:    keys[i].PrivateKey.PublicKey,
+		}, time.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.a.UpsertMFADevice(ctx, user, dev), IsNil)
+	}
+
+	challenge, err := s.a.U2FSignRequest(user, password)
+	c.Assert(err, IsNil)
+	c.Assert(challenge.Challenges, HasLen, 2)
+	c.Assert(challenge.AuthenticateChallenge, NotNil)
+	c.Assert(*challenge.AuthenticateChallenge, DeepEquals, challenge.Challenges[0])
+	c.Assert(challenge.Challenges[0].Challenge, Equals, challenge.Challenges[1].Challenge)
+
+	data, err := json.Marshal(challenge)
+	c.Assert(err, IsNil)
+	var legacy u2f.AuthenticateChallenge
+	c.Assert(json.Unmarshal(data, &legacy), IsNil)
+	c.Assert(legacy, DeepEquals, challenge.Challenges[0])
+	var modern U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(data, &modern), IsNil)
+	c.Assert(modern.GetChallenges(), HasLen, 2)
+
+	// The old wire format can still be read by a new client.
+	legacyData, err := json.Marshal(legacy)
+	c.Assert(err, IsNil)
+	var fromOldServer U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(legacyData, &fromOldServer), IsNil)
+	c.Assert(fromOldServer.GetChallenges(), HasLen, 1)
+
+	// Sign with the second key to verify that its challenge was stored and can
+	// be used even though the embedded legacy challenge belongs to the first.
+	secondHandle := base64.URLEncoding.WithPadding(base64.NoPadding).EncodeToString(keys[1].KeyHandle)
+	for _, ch := range modern.GetChallenges() {
+		if ch.KeyHandle != secondHandle {
+			continue
+		}
+		resp, err := keys[1].SignResponse(&ch)
+		c.Assert(err, IsNil)
+		c.Assert(s.a.CheckU2FSignResponse(ctx, user, resp), IsNil)
+		return
+	}
+	c.Fatal("second device was not offered a challenge")
+}
