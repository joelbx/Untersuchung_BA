+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package web
+
+// u2fMultiDeviceScript adapts the bundled web UI's single-key sign calls to
+// the multi-key challenge response. The sign request's challenges all share
+// one nonce, as required by the browser U2F API. With older auth servers,
+// the response has no challenges array and the original call is used.
+const u2fMultiDeviceScript = `(function () {
+  if (!window.u2f || !window.u2f.sign) return;
+  var sign = window.u2f.sign;
+  window.u2f.sign = function (appId, challenge, requests, callback, timeout) {
+    var offered = requests && requests[0] && requests[0].challenges;
+    if (Array.isArray(offered) && offered.length) {
+      return sign.call(this, offered[0].appId, offered[0].challenge, offered, callback, timeout);
+    }
+    return sign.apply(this, arguments);
+  };
+}());`
