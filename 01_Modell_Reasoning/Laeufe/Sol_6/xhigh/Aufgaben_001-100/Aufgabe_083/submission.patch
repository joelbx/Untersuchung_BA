diff --git a/applications/drive/src/app/utils/type/DeepPartial.ts b/applications/drive/src/app/utils/type/DeepPartial.ts
new file mode 100644
index 0000000..f1eaefb
--- /dev/null
+++ b/applications/drive/src/app/utils/type/DeepPartial.ts
@@ -0,0 +1,8 @@
+/** Makes every property of an object, including nested properties, optional. */
+export type DeepPartial<T> = T extends (infer Item)[]
+    ? DeepPartial<Item>[]
+    : T extends readonly (infer Item)[]
+    ? readonly DeepPartial<Item>[]
+    : T extends object
+    ? { [Key in keyof T]?: DeepPartial<T[Key]> }
+    : T;
