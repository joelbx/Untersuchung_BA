+func TestReadKubeClusterFlag(t *testing.T) {
+	tests := []struct {
+		name       string
+		cliCluster string
+		envCluster string
+		want       string
+	}{
+		{name: "nothing set"},
+		{name: "environment set", envCluster: "dev", want: "dev"},
+		{name: "CLI set", cliCluster: "prod", want: "prod"},
+		{name: "CLI takes precedence", cliCluster: "prod", envCluster: "dev", want: "prod"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cf := CLIConf{KubernetesCluster: tt.cliCluster}
+			readKubeClusterFlag(&cf, func(name string) string {
+				if name == kubeClusterEnvVar {
+					return tt.envCluster
+				}
+				return ""
+			})
+			require.Equal(t, tt.want, cf.KubernetesCluster)
+		})
+	}
+}
