@@ -448,17 +448,62 @@ class InvalidLanguage(Exception):
 def format_languages(languages: Iterable) -> list[dict[str, str]]:
     """
     Format language data to match Open Library's expected format.
-    For an input of ["eng", "fre"], return:
+    For an input of ["en", "French"], return:
     [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
     """
     if not languages:
         return []
 
+    from openlibrary.plugins.upstream.utils import (
+        LanguageMultipleMatchError,
+        LanguageNoMatchError,
+        get_abbrev_from_full_lang_name,
+        get_marc21_language,
+        safeget,
+    )
+
     formatted_languages = []
-    for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
+    seen = set()
+    language_records = None
+
+    def get_language_records():
+        nonlocal language_records
+        if language_records is None:
+            keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+            language_records = [
+                lang for lang in web.ctx.site.get_many(keys) if not lang.deprecated
+            ]
+        return language_records
 
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+    for language in languages:
+        name = language.strip().casefold()
+        code = name if len(name) == 3 and web.ctx.site.get(f'/languages/{name}') else None
+        if len(name) == 2:
+            # Stored ISO identifiers take precedence over the incomplete alias map.
+            matches = {
+                lang.code
+                for lang in get_language_records()
+                if safeget(lambda: lang['identifiers']['iso_639_1'][0]) == name
+            }
+            if len(matches) > 1:
+                raise InvalidLanguage(name)
+            if matches:
+                code = matches.pop()
+        if code is None and len(name) != 3:
+            code = get_marc21_language(name)
+        if code is None:
+            try:
+                code = get_abbrev_from_full_lang_name(
+                    name, languages=get_language_records()
+                )
+            except (LanguageNoMatchError, LanguageMultipleMatchError) as exc:
+                raise InvalidLanguage(name) from exc
+
+        key = f'/languages/{code}'
+        if web.ctx.site.get(key) is None:
+            raise InvalidLanguage(name)
+        if key not in seen:
+            formatted_languages.append({'key': key})
+            seen.add(key)
 
     return formatted_languages
