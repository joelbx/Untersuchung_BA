diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..5416047
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,61 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAuthenticationMethodDatabaseRequirements(t *testing.T) {
+	want := map[string]bool{
+		"token":      true,
+		"oidc":       true,
+		"github":     true,
+		"kubernetes": true,
+		"jwt":        false,
+	}
+
+	methods := AuthenticationMethods{}
+	for _, info := range methods.AllMethods() {
+		assert.Equal(t, want[info.Name()], info.RequiresDatabase, info.Name())
+		delete(want, info.Name())
+	}
+	assert.Empty(t, want)
+}
+
+func TestAuthenticationDatabaseAndCleanupDecisions(t *testing.T) {
+	schedule := &AuthenticationCleanupSchedule{Interval: time.Hour, GracePeriod: time.Minute}
+	tests := []struct {
+		name        string
+		config      AuthenticationConfig
+		wantDB      bool
+		wantCleanup bool
+	}{
+		{name: "required without methods", config: AuthenticationConfig{Required: true}},
+		{name: "disabled database method with cleanup", config: AuthenticationConfig{Methods: AuthenticationMethods{
+			Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Cleanup: schedule},
+		}}},
+		{name: "JWT with cleanup", config: AuthenticationConfig{Methods: AuthenticationMethods{
+			JWT: AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true, Cleanup: schedule},
+		}}},
+		{name: "JWT and disabled token", config: AuthenticationConfig{Methods: AuthenticationMethods{
+			JWT:   AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true},
+			Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Cleanup: schedule},
+		}}},
+		{name: "token without cleanup", config: AuthenticationConfig{Methods: AuthenticationMethods{
+			Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Enabled: true},
+		}}, wantDB: true},
+		{name: "token with cleanup and JWT", config: AuthenticationConfig{Methods: AuthenticationMethods{
+			JWT:   AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true, Cleanup: schedule},
+			Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Enabled: true, Cleanup: schedule},
+		}}, wantDB: true, wantCleanup: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.wantDB, tt.config.RequiresDatabase())
+			assert.Equal(t, tt.wantCleanup, tt.config.ShouldRunCleanup())
+		})
+	}
+}
