index 0000000..35fc339
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,208 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type memoryStore struct {
+	flags         []*flipt.Flag
+	segments      []*flipt.Segment
+	rules         map[string][]*flipt.Rule
+	variantInputs []*flipt.CreateVariantRequest
+	constraints   []*flipt.CreateConstraintRequest
+	distributions []*flipt.CreateDistributionRequest
+}
+
+func (s *memoryStore) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	start, end := pageBounds(len(s.flags), opts...)
+	return s.flags[start:end], nil
+}
+func (s *memoryStore) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	start, end := pageBounds(len(s.segments), opts...)
+	return s.segments[start:end], nil
+}
+func (s *memoryStore) ListRules(_ context.Context, flag string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	return s.rules[flag], nil
+}
+func pageBounds(length int, opts ...storage.QueryOption) (int, int) {
+	params := new(storage.QueryParams)
+	for _, opt := range opts {
+		opt(params)
+	}
+	if params.Offset >= uint64(length) {
+		return length, length
+	}
+	start := int(params.Offset)
+	end := length
+	if params.Limit > 0 && uint64(end-start) > params.Limit {
+		end = start + int(params.Limit)
+	}
+	return start, end
+}
+func (s *memoryStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	f := &flipt.Flag{Key: r.Key, Name: r.Name, Description: r.Description, Enabled: r.Enabled}
+	s.flags = append(s.flags, f)
+	return f, nil
+}
+func (s *memoryStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.variantInputs = append(s.variantInputs, r)
+	v := &flipt.Variant{Id: r.FlagKey + ":" + r.Key, Key: r.Key, Attachment: r.Attachment}
+	for _, f := range s.flags {
+		if f.Key == r.FlagKey {
+			f.Variants = append(f.Variants, v)
+		}
+	}
+	return v, nil
+}
+func (s *memoryStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	segment := &flipt.Segment{Key: r.Key, Name: r.Name, Description: r.Description}
+	s.segments = append(s.segments, segment)
+	return segment, nil
+}
+func (s *memoryStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.constraints = append(s.constraints, r)
+	return &flipt.Constraint{}, nil
+}
+func (s *memoryStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	return &flipt.Rule{Id: r.FlagKey + ":" + r.SegmentKey}, nil
+}
+func (s *memoryStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.distributions = append(s.distributions, r)
+	return &flipt.Distribution{}, nil
+}
+
+func TestExportNativeAttachmentAndHierarchy(t *testing.T) {
+	attachment := `{"nested":{"items":[1,"two",true,null,{"n":2.5}]},"empty":[]}`
+	s := &memoryStore{
+		flags: []*flipt.Flag{{Key: "flag", Name: "Flag", Enabled: true, Variants: []*flipt.Variant{
+			{Id: "id-1", Key: "a", Attachment: attachment}, {Id: "id-2", Key: "b"},
+		}}},
+		segments: []*flipt.Segment{{Key: "segment", Constraints: []*flipt.Constraint{{Type: flipt.ComparisonType(flipt.ComparisonType_value["STRING_COMPARISON_TYPE"]), Property: "country", Operator: "eq", Value: "US"}}}},
+		rules:    map[string][]*flipt.Rule{"flag": {{SegmentKey: "segment", Rank: 1, Distributions: []*flipt.Distribution{{VariantId: "id-1", Rollout: 100}}}}},
+	}
+	var out bytes.Buffer
+	if err := NewExporter(s).Export(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if len(doc.Flags) != 1 || len(doc.Flags[0].Rules) != 1 || len(doc.Segments) != 1 || len(doc.Segments[0].Constraints) != 1 {
+		t.Fatalf("hierarchy lost: %s", out.String())
+	}
+	if doc.Flags[0].Rules[0].Distributions[0].VariantKey != "a" {
+		t.Fatalf("distribution lost variant key: %s", out.String())
+	}
+	got := convert(doc.Flags[0].Variants[0].Attachment)
+	want := map[string]interface{}{"nested": map[string]interface{}{"items": []interface{}{1, "two", true, nil, map[string]interface{}{"n": 2.5}}}, "empty": []interface{}{}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("attachment = %#v, want %#v", got, want)
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil || strings.Contains(out.String(), "attachment: \"{\\\"") {
+		t.Fatalf("unexpected attachment encoding: %s", out.String())
+	}
+}
+
+func TestImportNativeAndMissingAttachments(t *testing.T) {
+	input := `flags:
+- key: flag
+  name: Flag
+  enabled: true
+  variants:
+  - key: native
+    attachment:
+      nested:
+      - one
+      - 2
+      - true
+      - null
+      object:
+        enabled: false
+  - key: scalar
+    attachment: "true"
+  - key: legacy
+    attachment: '{"value":[1,null]}'
+  - key: empty
+  rules:
+  - segment: segment
+    rank: 1
+    distributions:
+    - variant: native
+      rollout: 100
+segments:
+- key: segment
+  name: Segment
+  constraints:
+  - type: STRING_COMPARISON_TYPE
+    property: country
+    operator: eq
+    value: US
+`
+	s := &memoryStore{}
+	if err := NewImporter(s).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.flags) != 1 || len(s.variantInputs) != 4 || len(s.segments) != 1 || len(s.constraints) != 1 || len(s.distributions) != 1 {
+		t.Fatalf("missing created entities: flags=%d variants=%d segments=%d constraints=%d distributions=%d", len(s.flags), len(s.variantInputs), len(s.segments), len(s.constraints), len(s.distributions))
+	}
+	var got interface{}
+	if err := json.Unmarshal([]byte(s.variantInputs[0].Attachment), &got); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]interface{}{"nested": []interface{}{"one", float64(2), true, nil}, "object": map[string]interface{}{"enabled": false}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("stored attachment = %#v, want %#v", got, want)
+	}
+	if s.variantInputs[1].Attachment != `"true"` || s.variantInputs[2].Attachment != `{"value":[1,null]}` || s.variantInputs[3].Attachment != "" {
+		t.Fatalf("scalar, legacy or missing attachment changed: %#v", s.variantInputs)
+	}
+	if s.distributions[0].VariantId != "flag:native" || s.distributions[0].RuleId != "flag:segment" {
+		t.Fatalf("distribution references = %#v", s.distributions[0])
+	}
+}
+
+func TestImportExistingDocumentWithoutAttachment(t *testing.T) {
+	file, err := os.Open("../../test/flipt.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	s := &memoryStore{}
+	if err := NewImporter(s).Import(context.Background(), file); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.variantInputs) != 2 || s.variantInputs[0].Attachment != "" || s.variantInputs[1].Attachment != "" || len(s.constraints) != 2 || len(s.distributions) != 1 {
+		t.Fatalf("existing document was not imported: %#v", s)
+	}
+}
+
+func TestExportAllPages(t *testing.T) {
+	s := &memoryStore{rules: make(map[string][]*flipt.Rule)}
+	for n := 0; n < 26; n++ {
+		s.flags = append(s.flags, &flipt.Flag{Key: fmt.Sprintf("flag-%d", n)})
+		s.segments = append(s.segments, &flipt.Segment{Key: fmt.Sprintf("segment-%d", n)})
+	}
+	var out bytes.Buffer
+	if err := NewExporter(s).Export(context.Background(), &out); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(out.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if len(doc.Flags) != 26 || len(doc.Segments) != 26 {
+		t.Fatalf("exported %d flags and %d segments", len(doc.Flags), len(doc.Segments))
+	}
+}
