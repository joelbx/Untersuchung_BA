-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
-			h.seeds[id] = seed
+		h.mu.RLock()
+		seed, ok := h.seeds[id]
+		h.mu.RUnlock()
+		if !ok {
+			h.mu.Lock()
+			seed, ok = h.seeds[id]
+			if !ok {
+				seed = newSeed()
+				h.seeds[id] = seed
+			}
+			h.mu.Unlock()
 		}
-		hash.SetSeed(seed)
+
+		var hash maphash.Hash
+		hash.SetSeed(h.seed)
+		var seedLength [8]byte
+		binary.LittleEndian.PutUint64(seedLength[:], uint64(len(seed)))
+		_, _ = hash.Write(seedLength[:])
+		_, _ = hash.WriteString(seed)
 		_, _ = hash.WriteString(str)
 		return hash.Sum64()
 	}
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..2988af9 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,45 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the same hash when a previous seed is set again", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		id := "restorable"
+
+		// An identifier without a seed is initialized on its first hash.
+		initial := hashFunc(id, input)
+		Expect(hashFunc(id, input)).To(Equal(initial))
+
+		h.SetSeed(id, "first seed")
+		first := hashFunc(id, input)
+		Expect(hashFunc(id, input)).To(Equal(first))
+
+		h.Reseed(id)
+		Expect(hashFunc(id, input)).NotTo(Equal(first))
+
+		h.SetSeed(id, "first seed")
+		Expect(hashFunc(id, input)).To(Equal(first))
+	})
+
+	It("uses the same explicit seed across hasher instances", func() {
+		first := hasher.NewHasher()
+		second := hasher.NewHasher()
+		first.SetSeed("shared", "repeatable")
+		second.SetSeed("shared", "repeatable")
+
+		Expect(first.HashFunc()("shared", input)).To(Equal(second.HashFunc()("shared", input)))
+	})
+
+	It("sets a seed on the global hasher", func() {
+		id := "global seed"
+		hasher.SetSeed(id, "repeatable")
+		first := hasher.HashFunc()(id, input)
+
+		hasher.Reseed(id)
+		Expect(hasher.HashFunc()(id, input)).NotTo(Equal(first))
+
+		hasher.SetSeed(id, "repeatable")
+		Expect(hasher.HashFunc()(id, input)).To(Equal(first))
+	})
 })
