+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and nested elements', () => {
+        const root = document.createElement('div');
+        root.style.cssText = 'height: 100vh; color: red';
+        root.innerHTML =
+            '<section style="height: calc(50vh - 10px); width: 20px"><p style="height: 25vh"></p></section>';
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+        expect((root.querySelector('section') as HTMLElement).style.height).toBe('auto');
+        expect((root.querySelector('section') as HTMLElement).style.width).toBe('20px');
+        expect((root.querySelector('p') as HTMLElement).style.height).toBe('auto');
+    });
+
+    it('preserves unrelated styles, other height units, and the height priority', () => {
+        const root = document.createElement('div');
+        root.innerHTML = `
+            <div id="fixed" style="height: 50px; min-height: 20vh; width: 40px"></div>
+            <div id="important" style="height: 75vh !important; background: blue"></div>
+            <div id="variable" style="height: var(--vh-height)"></div>
+        `;
+
+        transformStyleAttributes(root);
+
+        const fixed = root.querySelector('#fixed') as HTMLElement;
+        const important = root.querySelector('#important') as HTMLElement;
+        const variable = root.querySelector('#variable') as HTMLElement;
+        expect(fixed.style.height).toBe('50px');
+        expect(fixed.style.minHeight).toBe('20vh');
+        expect(fixed.style.width).toBe('40px');
+        expect(important.style.height).toBe('auto');
+        expect(important.style.getPropertyPriority('height')).toBe('important');
+        expect(important.style.background).toBe('blue');
+        expect(variable.getAttribute('style')).toBe('height: var(--vh-height)');
+    });
+});
