--- a/test/units/template/test_template_utilities.py
+++ b/test/units/template/test_template_utilities.py
@@ -21,8 +21,39 @@ __metaclass__ = type
 
 import jinja2
 from units.compat import unittest
-
-from ansible.template import AnsibleUndefined, _escape_backslashes, _count_newlines_from_end
+from units.compat.mock import patch
+
+from ansible.template import AnsibleUndefined, JinjaPluginIntercept, _escape_backslashes, _count_newlines_from_end
+from ansible.plugins.loader import filter_loader
+
+
+def test_removed_filter_raises_template_syntax_error():
+    filters = JinjaPluginIntercept({}, filter_loader)
+    with patch.object(filter_loader, '_query_collection_routing_meta',
+                      return_value={'tombstone': {'removal_date': '2026-01-01'}}):
+        with unittest.TestCase().assertRaises(jinja2.TemplateSyntaxError) as error:
+            filters['ansible.builtin.removed_filter_for_context_test']
+    assert '2026-01-01' in str(error.exception)
+
+
+def test_removed_builtin_filter_overrides_legacy_implementation():
+    filters = JinjaPluginIntercept({'removed_filter_for_context_test': lambda value: value}, filter_loader)
+    routing = {'plugin_routing': {'filter': {'removed_filter_for_context_test': {'tombstone': {}}}}}
+    with patch('ansible.template._get_collection_metadata', return_value=routing), \
+            patch.object(filter_loader, '_query_collection_routing_meta', return_value={'tombstone': {}}):
+        with unittest.TestCase().assertRaises(jinja2.TemplateSyntaxError):
+            filters['removed_filter_for_context_test']
+
+
+def test_legacy_filter_masks_builtin_redirect():
+    def legacy(value):
+        return value
+    filters = JinjaPluginIntercept({'legacy_filter_for_context_test': legacy}, filter_loader)
+    routing = {'plugin_routing': {'filter': {'legacy_filter_for_context_test': {'redirect': 'ansible.builtin.some_filter'}}}}
+    with patch('ansible.template._get_collection_metadata', return_value=routing), \
+            patch.object(filter_loader, 'find_plugin_with_context') as lookup:
+        assert filters['legacy_filter_for_context_test'] is legacy
+        lookup.assert_not_called()
 
