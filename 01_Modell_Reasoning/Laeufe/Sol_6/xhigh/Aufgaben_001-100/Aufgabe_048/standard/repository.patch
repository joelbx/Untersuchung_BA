+from ansible.plugins.loader import PluginLoader, shell_loader, get_with_context_result
 
 
 class TestErrors(unittest.TestCase):
 
+    def test_get_with_context_reports_success_and_missing_plugin(self):
+        found = shell_loader.get_with_context('sh')
+        self.assertIsInstance(found, get_with_context_result)
+        self.assertIsNotNone(found.object)
+        self.assertTrue(found.plugin_load_context.resolved)
+        self.assertEqual(found.plugin_load_context.plugin_resolved_name, 'sh')
+
+        missing = shell_loader.get_with_context('missing_shell_for_context_test')
+        self.assertIsNone(missing.object)
+        self.assertFalse(missing.plugin_load_context.resolved)
+        self.assertEqual(missing.plugin_load_context.original_name, 'missing_shell_for_context_test')
+
+    def test_tombstone_keeps_context_on_exception_and_get_result(self):
+        name = 'ansible.builtin.removed_shell_for_context_test'
+        with patch.object(shell_loader, '_query_collection_routing_meta', return_value={
+            'tombstone': {'removal_version': '3.0'},
+        }):
+            with self.assertRaises(AnsiblePluginRemovedError) as error:
+                shell_loader.find_plugin_with_context(name)
+            self.assertIsInstance(error.exception, AnsiblePluginError)
+            self.assertTrue(error.exception.plugin_load_context.tombstone)
+            self.assertEqual(error.exception.plugin_load_context.removal_version, '3.0')
+
+            result = shell_loader.get_with_context(name)
+            self.assertIsNone(result.object)
+            self.assertTrue(result.plugin_load_context.tombstone)
+            self.assertIsNone(shell_loader.get(name))
+
+        with patch.object(shell_loader, '_query_collection_routing_meta', return_value={'tombstone': {}}):
+            with self.assertRaises(AnsiblePluginRemovedError):
+                shell_loader.find_plugin_with_context(name)
+
+    def test_deprecation_is_contextual_until_plugin_is_loaded(self):
+        with patch.object(shell_loader, '_query_collection_routing_meta', return_value={
+            'deprecation': {'removal_version': '3.0'},
+        }), patch('ansible.plugins.loader.display.deprecated') as warning:
+            context = shell_loader.find_plugin_with_context('ansible.builtin.sh')
+            self.assertTrue(context.deprecated)
+            self.assertEqual(context.removal_version, '3.0')
+            warning.assert_not_called()
+
+            result = shell_loader.get_with_context('ansible.builtin.sh')
+            self.assertIsNotNone(result.object)
+            warning.assert_called_once()
+
+    def test_circular_redirect_carries_resolution_path(self):
+        name = 'ansible.builtin.loop_shell_for_context_test'
+        with patch.object(shell_loader, '_query_collection_routing_meta', return_value={'redirect': name}):
+            with self.assertRaises(AnsiblePluginCircularRedirect) as error:
+                shell_loader.find_plugin_with_context(name)
+        self.assertEqual(error.exception.plugin_load_context.redirect_list, [name])
+        self.assertIn('redirect loop', error.exception.plugin_load_context.exit_reason)
