+def test_deprecation_message_includes_collection_and_removal_date():
+    d = Display()
+    warning = d.get_deprecation_message('old filter', date='sample.collection:2027-01-01')
+    assert 'sample.collection after 2027-01-01' in warning
+    removal = d.get_deprecation_message('sample.collection.old_filter', version='2.0',
+                                        removed=True, collection_name='sample.collection')
+    assert 'removed in version 2.0 of sample.collection' in removal
+    with pytest.raises(AnsibleError, match='removed in version 2.0'):
+        d.deprecated('sample.collection.old_filter', version='2.0', removed=True,
+                     collection_name='sample.collection')
