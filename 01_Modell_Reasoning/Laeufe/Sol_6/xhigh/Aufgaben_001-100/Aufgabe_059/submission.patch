new file mode 100644
index 0000000..4f1d862
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,31 @@
+import { DialogHTMLAttributes, HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends DialogHTMLAttributes<HTMLDialogElement> {}
+
+const Dialog = ({ children, ...props }: Props, ref: Ref<HTMLDialogElement>) => {
+    // JSDOM and older browsers can expose HTMLDialogElement without its dialog methods.
+    // A regular element keeps the content available to accessibility queries in that case.
+    if (
+        typeof HTMLDialogElement !== 'function' ||
+        typeof HTMLDialogElement.prototype.showModal !== 'function' ||
+        typeof HTMLDialogElement.prototype.close !== 'function'
+    ) {
+        const fallbackProps = props as unknown as HTMLAttributes<HTMLDivElement>;
+        return (
+            <div role="dialog" {...fallbackProps} ref={ref as Ref<HTMLDivElement>}>
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...props} ref={ref}>
+            {children}
+        </dialog>
+    );
+};
+
+const ForwardedDialog = forwardRef<HTMLDialogElement, Props>(Dialog);
+ForwardedDialog.displayName = 'Dialog';
+
+export default ForwardedDialog;
