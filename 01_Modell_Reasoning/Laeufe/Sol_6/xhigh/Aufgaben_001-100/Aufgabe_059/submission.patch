+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('forwards dialog attributes and the host ref in a limited DOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole } = render(
+            <Dialog ref={ref} open aria-label="Example" data-testid="dialog-host" title="Example title">
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(host.tagName).toBe('DIV');
+        expect(ref.current).toBe(host);
+        expect(host).toHaveAttribute('open');
+        expect(host).toHaveAttribute('data-testid', 'dialog-host');
+        expect(host).toHaveAttribute('title', 'Example title');
+        expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+        expect(Dialog.displayName).toBe('Dialog');
+    });
+
+    it('uses a native dialog and forwards attributes and ref when dialog methods are supported', () => {
+        const prototype = HTMLDialogElement.prototype;
+        const originalShowModal = Object.getOwnPropertyDescriptor(prototype, 'showModal');
+        const originalClose = Object.getOwnPropertyDescriptor(prototype, 'close');
+        Object.defineProperty(prototype, 'showModal', { configurable: true, value: jest.fn() });
+        Object.defineProperty(prototype, 'close', { configurable: true, value: jest.fn() });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByRole } = render(
+                <Dialog ref={ref} open aria-label="Example" data-testid="native-dialog">
+                    <button type="button">Hello</button>
+                </Dialog>
+            );
+
+            const host = getByRole('dialog', { name: 'Example' });
+            expect(host.tagName).toBe('DIALOG');
+            expect(ref.current).toBe(host);
+            expect(host).toHaveAttribute('open');
+            expect(host).toHaveAttribute('data-testid', 'native-dialog');
+            expect(getByRole('button', { name: 'Hello' })).toBeVisible();
+        } finally {
+            if (originalShowModal) {
+                Object.defineProperty(prototype, 'showModal', originalShowModal);
+            } else {
+                Reflect.deleteProperty(prototype, 'showModal');
+            }
+            if (originalClose) {
+                Object.defineProperty(prototype, 'close', originalClose);
+            } else {
+                Reflect.deleteProperty(prototype, 'close');
+            }
+        }
+    });
+});
