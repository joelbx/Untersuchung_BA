+func TestProxyKubeAddr(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  ProxyConfig
+		want string
+	}{
+		{
+			name: "disabled",
+			cfg:  ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}},
+		},
+		{
+			name: "Kubernetes public address takes precedence",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube: KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}},
+				},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "generic public address uses Kubernetes port",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://proxy.example.com:3026",
+		},
+		{
+			name: "invalid first public address is skipped",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:invalid"}, {Addr: "other.example.com:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://other.example.com:3026",
+		},
+		{
+			name: "IPv6 address",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "[2001:db8::1]:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://[2001:db8::1]:3026",
+		},
+		{
+			name: "missing public address",
+			cfg:  ProxyConfig{Kube: KubeProxyConfig{Enabled: true}},
+		},
+		{
+			name: "invalid public address",
+			cfg: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:invalid"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.KubeAddr()
+			if tt.want == "" {
+				assert.Error(t, err)
+				return
+			}
+			assert.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
