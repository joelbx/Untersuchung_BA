+func TestAuthSignKubeconfigProxyAddress(t *testing.T) {
+	tests := []struct {
+		name       string
+		config     *service.Config
+		proxies    []string
+		proxyFlag  string
+		wantServer string
+	}{
+		{
+			name: "local Kubernetes public address",
+			config: &service.Config{Proxy: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube: service.KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}},
+				},
+			}},
+			wantServer: "https://kube.example.com:3026",
+		},
+		{
+			name: "local generic public address",
+			config: &service.Config{Proxy: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube:        service.KubeProxyConfig{Enabled: true},
+			}},
+			wantServer: "https://web.example.com:3026",
+		},
+		{
+			name: "registered proxy skips invalid address",
+			config: &service.Config{Proxy: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "local.example.com:3080"}},
+			}},
+			proxies:    []string{"bad.example.com:invalid", "web.example.com:3080"},
+			wantServer: "https://web.example.com:3026",
+		},
+		{
+			name: "invalid local address uses registered proxy",
+			config: &service.Config{Proxy: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "local.example.com:invalid"}},
+				Kube:        service.KubeProxyConfig{Enabled: true},
+			}},
+			proxies:    []string{"web.example.com:3080"},
+			wantServer: "https://web.example.com:3026",
+		},
+		{
+			name:       "explicit proxy overrides configuration",
+			config:     &service.Config{Proxy: service.ProxyConfig{Kube: service.KubeProxyConfig{Enabled: true}}},
+			proxyFlag:  "https://custom.example.com:443",
+			wantServer: "https://custom.example.com:443",
+		},
+		{
+			name:    "no valid registered proxy",
+			config:  &service.Config{},
+			proxies: []string{"bad.example.com:invalid", ""},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			proxies := make([]services.Server, 0, len(tt.proxies))
+			for _, addr := range tt.proxies {
+				proxy := &services.ServerV2{}
+				proxy.SetPublicAddr(addr)
+				proxies = append(proxies, proxy)
+			}
+			client := mockClient{
+				proxies:     proxies,
+				clusterName: testClusterName(t),
+				userCerts:   &proto.Certs{SSH: []byte("SSH cert"), TLS: []byte("TLS cert")},
+				cas:         []services.CertAuthority{testHostCA()},
+			}
+			tmpDir, err := ioutil.TempDir("", "auth_command_proxy_test")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer os.RemoveAll(tmpDir)
+			ac := &AuthCommand{
+				config:       tt.config,
+				output:       filepath.Join(tmpDir, "kubeconfig"),
+				outputFormat: identityfile.FormatKubernetes,
+				proxyAddr:    tt.proxyFlag,
+			}
+			err = ac.generateUserKeys(client)
+			if tt.wantServer == "" {
+				if err == nil {
+					t.Fatal("expected an error when no proxy address is valid")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			kc, err := kubeconfig.Load(ac.output)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := kc.Clusters[kc.CurrentContext].Server; got != tt.wantServer {
+				t.Errorf("server address = %q, want %q", got, tt.wantServer)
+			}
+		})
+	}
+}
