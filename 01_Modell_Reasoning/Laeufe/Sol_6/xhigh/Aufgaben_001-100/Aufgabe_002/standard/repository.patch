+func testHostCA() services.CertAuthority {
+	ca := services.NewCertAuthority(services.HostCA, "example.com", nil,
+		[][]byte{[]byte("SSH CA cert")}, nil, services.CertAuthoritySpecV2_RSA_SHA2_512)
+	ca.SetTLSKeyPairs([]services.TLSKeyPair{{Cert: []byte("TLS CA cert")}})
+	return ca
+}
