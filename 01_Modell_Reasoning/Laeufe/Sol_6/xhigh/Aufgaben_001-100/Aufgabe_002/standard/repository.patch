+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	addrs := c.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = c.PublicAddrs
+	}
+	if len(addrs) == 0 {
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+
+	for _, addr := range addrs {
+		kubeAddr, err := kubeAddrFromPublicAddr(addr)
+		if err == nil {
+			return kubeAddr, nil
+		}
+	}
+	return "", trace.BadParameter("Kubernetes proxy has no valid public address")
+}
+
+func kubeAddrFromPublicAddr(addr utils.NetAddr) (string, error) {
+	if addr.Path != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+	}
+	parsed, err := url.Parse("https://" + addr.Addr)
+	if err != nil || parsed.Hostname() == "" || strings.HasSuffix(parsed.Host, ":") || parsed.User != nil || parsed.Path != "" || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+	}
+	if port := parsed.Port(); port != "" {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 {
+			return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+		}
+	}
+
+	return (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(parsed.Hostname(), strconv.Itoa(defaults.KubeProxyListenPort)),
+	}).String(), nil
+}
