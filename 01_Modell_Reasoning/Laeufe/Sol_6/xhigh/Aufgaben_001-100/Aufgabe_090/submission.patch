+def test_unflatten_last_assignment_wins():
+    fields = utils.MultiDict(
+        items=[
+            ('name', 'first'),
+            ('name', 'last'),
+            ('seeds', []),
+            ('seeds--0--key', '/works/OL1W'),
+        ]
+    )
+
+    assert utils.unflatten(fields) == {
+        'name': 'last',
+        'seeds': [{'key': '/works/OL1W'}],
