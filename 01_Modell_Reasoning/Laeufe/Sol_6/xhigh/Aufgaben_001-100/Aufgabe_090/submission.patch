diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..2ea2254 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,3 +1,5 @@
+import web
+
 from openlibrary.plugins.openlibrary import lists
 
 
@@ -11,3 +13,64 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_from_body_ignores_query_and_uses_first_value(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: (
+            b'key=%2Flists%2FOL1L&name=Body+list&name=Other'
+            b'&description=From+body&seeds--0--key=%2Fbooks%2FOL1M'
+        ),
+    )
+
+    def unexpected_query_input(**defaults):
+        raise AssertionError('Query parameters must not be read for a form body')
+
+    monkeypatch.setattr(web, 'input', unexpected_query_input)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key == '/lists/OL1L'
+    assert record.name == 'Body list'
+    assert record.description == 'From body'
+    assert record.seeds == [{'key': '/books/OL1M'}]
+
+
+def test_list_record_from_body_ignores_invalid_nested_seeds(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: (
+            b'name=Body&seeds--0--key=&seeds--1--other=invalid'
+            b'&seeds--2--key=%2Fworks%2FOL1W'
+            b'&seeds--3--key=%2Fsubjects%2Flove&seeds--4--key='
+            b'&seeds--5=invalid'
+        ),
+    )
+    monkeypatch.setattr(web, 'input', lambda **defaults: None)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.seeds == [{'key': '/works/OL1W'}, 'love']
+
+
+def test_list_record_from_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+
+    def query_input(**defaults):
+        assert defaults == {
+            'key': None,
+            'name': '',
+            'description': '',
+            'seeds': [],
+        }
+        return web.storage({**defaults, 'name': 'Query list', 'seeds': ['OL1W']})
+
+    monkeypatch.setattr(web, 'input', query_input)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'Query list'
+    assert record.seeds == [{'key': '/works/OL1W'}]
