+@pytest.mark.parametrize('script_body,limit,expected_failure', [
+    ('print(\'{"rc": 0}\')\n', 3, False),
+    ('import time\ntime.sleep(30)\n', 1, True),
+])
+def test_async_process_has_one_response_and_final_record(tmp_path, script_body, limit, expected_failure):
+    module_dir = tmp_path / 'ansible-tmp-work'
+    module_dir.mkdir()
+    module = module_dir / 'module.py'
+    module.write_text('#!%s\n%s' % (sys.executable, script_body))
+    job_dir = tmp_path / 'jobs'
+    env = dict(os.environ, PYTHONPATH=os.path.abspath('lib'), ANSIBLE_ASYNC_DIR=str(job_dir))
+    command = ('import sys; from ansible.modules import async_wrapper; '
+               'sys.argv = ["async_wrapper"] + sys.argv[1:]; async_wrapper.main()')
+    process = subprocess.run([sys.executable, '-c', command, 'job', str(limit), str(module), '_'],
+                             env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             universal_newlines=True, timeout=10)
+
+    assert process.returncode == 0
+    assert process.stderr == ''
+    assert len(process.stdout.splitlines()) == 1
+    response = json.loads(process.stdout)
+    assert response['ansible_job_id'].startswith('job.')
+    assert response['_ansible_suppress_tmpdir_delete'] is True
+
+    for _ in range(200):
+        with open(response['results_file']) as jobfile:
+            record = json.load(jobfile)
+        if record['finished'] and not module_dir.exists():
+            break
+        time.sleep(0.025)
+    else:
+        pytest.fail('async job did not finish and clean up')
+
+    assert record['ansible_job_id'] == response['ansible_job_id']
+    assert record['started'] == 1
+    assert record['finished'] == 1
+    assert record['failed'] is expected_failure
+    assert not os.path.exists(response['results_file'] + '.tmp')
+    if expected_failure:
+        assert record['child_pid'] > 0
+        assert 'timed out' in record['msg']
+    else:
+        assert record['rc'] == 0
