+func TestSetScanResultMeta(t *testing.T) {
+	tests := []struct {
+		name        string
+		report      types.Report
+		wantName    string
+		wantFamily  string
+		wantRelease string
+	}{
+		{
+			name: "OS without version",
+			report: types.Report{
+				ArtifactName: "ubuntu",
+				ArtifactType: ftypes.ArtifactContainerImage,
+				Metadata:     types.Metadata{OS: &ftypes.OS{Family: "ubuntu"}},
+				Results:      types.Results{{Type: "ubuntu"}},
+			},
+			wantName: "ubuntu:latest", wantFamily: "ubuntu",
+		},
+		{
+			name: "library only image",
+			report: types.Report{
+				ArtifactName: "example/library",
+				ArtifactType: ftypes.ArtifactContainerImage,
+				Results:      types.Results{{Type: "jar"}},
+			},
+			wantName: "example/library:latest", wantFamily: "pseudo",
+		},
+		{
+			name: "tagged image",
+			report: types.Report{
+				ArtifactName: "example/app:v1",
+				ArtifactType: ftypes.ArtifactContainerImage,
+				Metadata:     types.Metadata{OS: &ftypes.OS{Family: "debian", Name: "12"}},
+				Results:      types.Results{{Type: "debian"}},
+			},
+			wantName: "example/app:v1", wantFamily: "debian", wantRelease: "12",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := &models.ScanResult{Optional: map[string]interface{}{"trivy-target": "old"}, Release: "old"}
+			if err := setScanResultMeta(r, &tt.report); err != nil {
+				t.Fatal(err)
+			}
+			if r.ServerName != tt.wantName || r.Family != tt.wantFamily || r.Release != tt.wantRelease {
+				t.Errorf("metadata = (%q, %q, %q), want (%q, %q, %q)", r.ServerName, r.Family, r.Release, tt.wantName, tt.wantFamily, tt.wantRelease)
+			}
+			if r.Optional != nil || r.ScannedBy != "trivy" {
+				t.Errorf("Optional = %v, ScannedBy = %q", r.Optional, r.ScannedBy)
+			}
+		})
+	}
+}
