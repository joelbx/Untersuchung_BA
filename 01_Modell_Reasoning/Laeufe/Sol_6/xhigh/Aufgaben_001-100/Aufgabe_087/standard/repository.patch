+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+func testLogger() *logrus.Logger {
+	l := logrus.New()
+	l.SetOutput(io.Discard)
+	return l
+}
+
+func readTestState(t *testing.T, path string) state {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	var s state
+	require.NoError(t, json.Unmarshal(data, &s))
+	return s
+}
+
+func TestReporterPersistsAnonymousStateAndReports(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "new", "state")
+	var received trackEvent
+	var method, contentType string
+	var decodeErr error
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		method = req.Method
+		contentType = req.Header.Get("Content-Type")
+		decodeErr = json.NewDecoder(req.Body).Decode(&received)
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer server.Close()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	cfg.Meta.TelemetryEndpoint = server.URL
+	r, err := NewReporter(cfg, testLogger())
+	require.NoError(t, err)
+	require.NotNil(t, r)
+
+	path := filepath.Join(dir, stateFileName)
+	initial := readTestState(t, path)
+	require.Equal(t, schemaVersion, initial.Version)
+	_, err = uuid.FromString(initial.UUID)
+	require.NoError(t, err)
+	_, err = time.Parse(time.RFC3339, initial.LastTimestamp)
+	require.NoError(t, err)
+
+	r.FliptVersion = "1.2.3"
+	require.NoError(t, r.Report(context.Background()))
+	require.Equal(t, http.MethodPost, method)
+	require.Equal(t, "application/json", contentType)
+	require.NoError(t, decodeErr)
+	require.Equal(t, "flipt.ping", received.Event)
+	require.Equal(t, initial.UUID, received.AnonymousId)
+	require.Equal(t, initial.UUID, received.Properties["uuid"])
+	require.Equal(t, schemaVersion, received.Properties["version"])
+	require.Equal(t, "1.2.3", received.Properties["flipt"].(map[string]interface{})["version"])
+
+	updated := readTestState(t, path)
+	require.Equal(t, initial.UUID, updated.UUID)
+	last, err := time.Parse(time.RFC3339, updated.LastTimestamp)
+	require.NoError(t, err)
+	require.WithinDuration(t, time.Now(), last, 2*time.Second)
+
+	second, err := NewReporter(cfg, testLogger())
+	require.NoError(t, err)
+	require.Equal(t, initial.UUID, second.state.UUID)
+	require.Equal(t, updated.LastTimestamp, second.state.LastTimestamp)
+}
+
+func TestReporterDisabledAndInvalidDirectory(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "unused")
+	cfg := config.Default()
+	cfg.Meta.TelemetryEnabled = false
+	cfg.Meta.StateDirectory = dir
+	r, err := NewReporter(cfg, testLogger())
+	require.NoError(t, err)
+	require.Nil(t, r)
+	_, err = os.Stat(dir)
+	require.True(t, os.IsNotExist(err))
+
+	file := filepath.Join(t.TempDir(), "file")
+	require.NoError(t, os.WriteFile(file, []byte("x"), 0600))
+	cfg.Meta.TelemetryEnabled = true
+	cfg.Meta.StateDirectory = file
+	r, err = NewReporter(cfg, testLogger())
+	require.Error(t, err)
+	require.Nil(t, r)
+	require.Equal(t, []byte("x"), mustReadFile(t, file))
+}
+
+func TestReporterUsesOSConfigurationDirectory(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("XDG_CONFIG_HOME controls UserConfigDir on Linux")
+	}
+	dir := t.TempDir()
+	old, had := os.LookupEnv("XDG_CONFIG_HOME")
+	defer func() {
+		if had {
+			_ = os.Setenv("XDG_CONFIG_HOME", old)
+		} else {
+			_ = os.Unsetenv("XDG_CONFIG_HOME")
+		}
+	}()
+	require.NoError(t, os.Setenv("XDG_CONFIG_HOME", dir))
+
+	r, err := NewReporter(config.Default(), testLogger())
+	require.NoError(t, err)
+	require.Equal(t, filepath.Join(dir, stateFileName), r.statePath)
+	require.FileExists(t, r.statePath)
+}
+
+func mustReadFile(t *testing.T, path string) []byte {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	return data
+}
+
+func TestReporterRecoversMalformedIdentifierAndDoesNotUpdateOnFailure(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, stateFileName)
+	old := state{Version: schemaVersion, UUID: "invalid", LastTimestamp: "2022-04-06T01:01:51Z"}
+	require.NoError(t, writeState(path, old))
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer server.Close()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	cfg.Meta.TelemetryEndpoint = server.URL
+	r, err := NewReporter(cfg, testLogger())
+	require.NoError(t, err)
+	require.NotEqual(t, old.UUID, r.state.UUID)
+	require.Equal(t, old.LastTimestamp, r.state.LastTimestamp)
+	require.Error(t, r.Report(context.Background()))
+	require.Equal(t, old.LastTimestamp, readTestState(t, path).LastTimestamp)
+}
+
+func TestReporterStartStopsWithContext(t *testing.T) {
+	received := make(chan struct{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		received <- struct{}{}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = t.TempDir()
+	cfg.Meta.TelemetryEndpoint = server.URL
+	r, err := NewReporter(cfg, testLogger())
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(context.Background())
+	r.Start(ctx)
+	select {
+	case <-received:
+	case <-time.After(2 * time.Second):
+		t.Fatal("report was not sent when state was due")
+	}
+	cancel()
+	select {
+	case <-received:
+		t.Fatal("report sent after cancellation")
+	case <-time.After(20 * time.Millisecond):
+	}
+}
