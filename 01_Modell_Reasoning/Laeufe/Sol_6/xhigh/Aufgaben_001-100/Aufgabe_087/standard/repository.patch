@@ -0,0 +1,34 @@
+package info
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestFliptServeHTTP(t *testing.T) {
+	w := httptest.NewRecorder()
+	f := Flipt{Version: "1.2.3", IsRelease: true}
+	f.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, "application/json", w.Header().Get("Content-Type"))
+	var got Flipt
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &got))
+	require.Equal(t, f, got)
+}
+
+type failingWriter struct{ code int }
+
+func (w *failingWriter) Header() http.Header       { return make(http.Header) }
+func (w *failingWriter) Write([]byte) (int, error) { return 0, errors.New("write failed") }
+func (w *failingWriter) WriteHeader(code int)      { w.code = code }
+
+func TestFliptServeHTTPWriteFailure(t *testing.T) {
+	w := &failingWriter{}
+	Flipt{Version: "1.2.3"}.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+	require.Equal(t, http.StatusInternalServerError, w.code)
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..ebcc80a
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,266 @@
+// Package telemetry schedules anonymous Flipt usage reports every four hours.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"runtime/debug"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion = "1.0"
+	interval      = 4 * time.Hour
+	stateFileName = "telemetry.json"
+	// The collector receives only the fields in trackEvent. In particular, no
+	// host name or IP address is placed in the event body.
+	collectorURL = "https://telemetry.flipt.io/v1/track"
+)
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type trackEvent struct {
+	AnonymousId string                 `json:"anonymousId"`
+	Event       string                 `json:"event"`
+	Properties  map[string]interface{} `json:"properties"`
+}
+
+type httpClient interface {
+	Do(*http.Request) (*http.Response, error)
+}
+
+// Reporter persists a host identifier and sends anonymous usage events.
+type Reporter struct {
+	mu        sync.Mutex
+	state     state
+	statePath string
+	client    httpClient
+	logger    logrus.FieldLogger
+	endpoint  string
+	// FliptVersion is the version included in subsequent reports. The binary
+	// sets this from its release version at startup.
+	FliptVersion string
+}
+
+// NewReporter creates a reporter when telemetry is enabled. A disabled
+// reporter does not touch the filesystem or make network requests.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (reporter *Reporter, err error) {
+	if logger == nil {
+		logger = logrus.StandardLogger()
+	}
+	defer func() {
+		if err != nil {
+			logger.Warnf("telemetry disabled: %v", err)
+		}
+	}()
+	if cfg == nil {
+		return nil, fmt.Errorf("telemetry: nil configuration")
+	}
+	if !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		userDir, err := os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("telemetry: finding user configuration directory: %w", err)
+		}
+		dir = userDir
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("telemetry: creating state directory: %w", err)
+	}
+	info, err := os.Stat(dir)
+	if err != nil {
+		return nil, fmt.Errorf("telemetry: checking state directory: %w", err)
+	}
+	if !info.IsDir() {
+		return nil, fmt.Errorf("telemetry: state directory %q is a file", dir)
+	}
+
+	path := filepath.Join(dir, stateFileName)
+	s, err := readState(path, logger)
+	if err != nil {
+		return nil, err
+	}
+	if err := writeState(path, s); err != nil {
+		return nil, fmt.Errorf("telemetry: writing initial state: %w", err)
+	}
+
+	fliptVersion := "dev"
+	if build, ok := debug.ReadBuildInfo(); ok && build.Main.Version != "" && build.Main.Version != "(devel)" {
+		fliptVersion = build.Main.Version
+	}
+	endpoint := cfg.Meta.TelemetryEndpoint
+	if endpoint == "" {
+		endpoint = collectorURL
+	}
+	return &Reporter{
+		state:        s,
+		statePath:    path,
+		client:       &http.Client{Timeout: 10 * time.Second},
+		logger:       logger,
+		endpoint:     endpoint,
+		FliptVersion: fliptVersion,
+	}, nil
+}
+
+func readState(path string, logger logrus.FieldLogger) (state, error) {
+	s := state{Version: schemaVersion, LastTimestamp: time.Time{}.UTC().Format(time.RFC3339)}
+	data, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return state{}, fmt.Errorf("telemetry: reading state: %w", err)
+	}
+	if err == nil {
+		if decodeErr := json.Unmarshal(data, &s); decodeErr != nil {
+			logger.Warnf("telemetry: malformed state, generating a new identifier: %v", decodeErr)
+			s = state{Version: schemaVersion, LastTimestamp: time.Time{}.UTC().Format(time.RFC3339)}
+		}
+	}
+	if id, parseErr := uuid.FromString(s.UUID); parseErr != nil || id == uuid.Nil {
+		if err == nil {
+			logger.Warn("telemetry: invalid identifier in state, generating a new one")
+		}
+		id, err := uuid.NewV4()
+		if err != nil {
+			return state{}, fmt.Errorf("telemetry: generating identifier: %w", err)
+		}
+		s.UUID = id.String()
+	}
+	if _, err := time.Parse(time.RFC3339, s.LastTimestamp); err != nil {
+		logger.Warn("telemetry: invalid report timestamp in state, resetting it")
+		s.LastTimestamp = time.Time{}.UTC().Format(time.RFC3339)
+	}
+	s.Version = schemaVersion
+	return s, nil
+}
+
+func writeState(path string, s state) error {
+	data, err := json.Marshal(s)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".telemetry-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if err := f.Chmod(0600); err != nil {
+		f.Close()
+		return err
+	}
+	if _, err := f.Write(data); err != nil {
+		f.Close()
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(f.Name(), path)
+}
+
+// Start runs a background reporting loop until ctx is cancelled. An instance
+// whose last report is older than four hours reports as soon as it starts.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		for {
+			r.mu.Lock()
+			last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			delay := time.Until(last.Add(interval))
+			if delay > 0 {
+				timer := time.NewTimer(delay)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+			if ctx.Err() != nil {
+				return
+			}
+			_ = r.Report(ctx)
+			// A failed report must wait before retrying, too.
+			r.mu.Lock()
+			last, _ = time.Parse(time.RFC3339, r.state.LastTimestamp)
+			r.mu.Unlock()
+			if time.Since(last) >= interval {
+				timer := time.NewTimer(interval)
+				select {
+				case <-ctx.Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+			}
+		}
+	}()
+}
+
+// Report sends one flipt.ping event and persists the success time.
+func (r *Reporter) Report(ctx context.Context) (err error) {
+	if r == nil {
+		return nil
+	}
+	defer func() {
+		if err != nil && ctx.Err() == nil {
+			r.logger.Warnf("telemetry: reporting usage: %v", err)
+		}
+	}()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	event := trackEvent{
+		AnonymousId: r.state.UUID,
+		Event:       "flipt.ping",
+		Properties: map[string]interface{}{
+			"uuid":    r.state.UUID,
+			"version": schemaVersion,
+			"flipt":   map[string]string{"version": r.FliptVersion},
+		},
+	}
+	data, err := json.Marshal(event)
+	if err != nil {
+		return fmt.Errorf("encoding event: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(data))
+	if err != nil {
+		return fmt.Errorf("creating request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("sending event: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("sending event: HTTP %d", resp.StatusCode)
+	}
+
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	if err := writeState(r.statePath, r.state); err != nil {
+		return fmt.Errorf("writing state after report: %w", err)
+	}
+	return nil
+}
