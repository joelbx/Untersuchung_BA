@@ -0,0 +1,53 @@
+package tests
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type MockedUserPropsRepo struct {
+	ctx  context.Context
+	data map[string]map[string]string
+}
+
+func (p *MockedUserPropsRepo) userID() (string, error) {
+	user, ok := request.UserFrom(p.ctx)
+	if !ok || user.ID == "" {
+		return "", model.ErrNotAuthorized
+	}
+	return user.ID, nil
+}
+
+func (p *MockedUserPropsRepo) Put(key, value string) error {
+	id, err := p.userID()
+	if err != nil {
+		return err
+	}
+	if p.data[id] == nil {
+		p.data[id] = make(map[string]string)
+	}
+	p.data[id][key] = value
+	return nil
+}
+
+func (p *MockedUserPropsRepo) Get(key string) (string, error) {
+	id, err := p.userID()
+	if err != nil {
+		return "", err
+	}
+	if value, ok := p.data[id][key]; ok {
+		return value, nil
+	}
+	return "", model.ErrNotFound
+}
+
+func (p *MockedUserPropsRepo) Delete(key string) error {
+	id, err := p.userID()
+	if err != nil {
+		return err
+	}
+	delete(p.data[id], key)
+	return nil
+}
