index 0000000..40fab00
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,59 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r *userPropsRepository) userID() (string, error) {
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return "", model.ErrNotAuthorized
+	}
+	return user.ID, nil
+}
+
+func (r *userPropsRepository) Put(key string, value string) error {
+	userID, err := r.userID()
+	if err != nil {
+		return err
+	}
+	query := Insert(r.tableName).Columns("user_id", "key", "value").
+		Values(userID, key, value).
+		Suffix("ON CONFLICT(user_id, key) DO UPDATE SET value = excluded.value")
+	_, err = r.executeSQL(query)
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	userID, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	query := Select("value").From(r.tableName).Where(Eq{"user_id": userID, "key": key})
+	var result struct{ Value string }
+	if err := r.queryOne(query, &result); err != nil {
+		return "", err
+	}
+	return result.Value, nil
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	userID, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": userID, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..125feed
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,61 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	var o orm.Ormer
+	var alice, bob model.UserPropsRepository
+
+	BeforeEach(func() {
+		o = orm.NewOrm()
+		_, err := o.Raw(`insert into user (id, user_name, name, email, password, created_at, updated_at)
+			values ('user-props-alice', 'user-props-alice', '', 'user-props-alice@example.com', '', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
+			       ('user-props-bob', 'user-props-bob', '', 'user-props-bob@example.com', '', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`).Exec()
+		Expect(err).NotTo(HaveOccurred())
+		alice = NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-props-alice"}), o)
+		bob = (&SQLStore{}).UserProps(request.WithUser(context.Background(), model.User{ID: "user-props-bob"}))
+	})
+
+	AfterEach(func() {
+		_, err := o.Raw(`delete from user where id in ('user-props-alice', 'user-props-bob')`).Exec()
+		Expect(err).NotTo(HaveOccurred())
+	})
+
+	It("stores and updates keys independently for each user", func() {
+		Expect(alice.Put("shared", "alice's value")).To(Succeed())
+		value, err := bob.Get("shared")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(bob.Put("shared", "bob's value")).To(Succeed())
+		Expect(alice.Put("shared", "updated value")).To(Succeed())
+		Expect(alice.Get("shared")).To(Equal("updated value"))
+		Expect(bob.Get("shared")).To(Equal("bob's value"))
+	})
+
+	It("deletes only the current user's key", func() {
+		Expect(alice.Put("shared", "alice's value")).To(Succeed())
+		Expect(bob.Put("shared", "bob's value")).To(Succeed())
+		Expect(alice.Delete("shared")).To(Succeed())
+		value, err := alice.Get("shared")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(bob.Get("shared")).To(Equal("bob's value"))
+	})
+
+	It("requires a user in the context", func() {
+		repo := NewUserPropsRepository(context.Background(), o)
+		Expect(repo.Put("key", "value")).To(Equal(model.ErrNotAuthorized))
+		value, err := repo.Get("key")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(Equal(model.ErrNotAuthorized))
+		Expect(repo.Delete("key")).To(Equal(model.ErrNotAuthorized))
+	})
+})
