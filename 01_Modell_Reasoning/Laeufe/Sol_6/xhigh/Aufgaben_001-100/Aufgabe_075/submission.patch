@@ -0,0 +1,47 @@
+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props
+(
+	user_id varchar(255) not null references user (id) on delete cascade,
+	key varchar(255) not null,
+	value text not null,
+	primary key (user_id, key)
+);
+
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from property p
+join user u on u.id = substr(p.id, 18)
+where substr(p.id, 1, 17) = 'LastFMSessionKey_';
+
+delete from property
+where substr(id, 1, 17) = 'LastFMSessionKey_'
+  and substr(id, 18) in (select id from user);
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+insert into property (id, value)
+select 'LastFMSessionKey_' || user_id, value
+from user_props
+where key = 'LastFMSessionKey'
+on conflict(id) do update set value = excluded.value;
+
+drop table user_props;
+`)
+	return err
+}
diff --git a/db/migration/20210619231717_create_user_props_table_test.go b/db/migration/20210619231717_create_user_props_table_test.go
new file mode 100644
index 0000000..7f272e7
--- /dev/null
+++ b/db/migration/20210619231717_create_user_props_table_test.go
@@ -0,0 +1,63 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	_, err = db.Exec(`create table user (id text primary key);
+		create table property (id text primary key, value text not null);
+		insert into user (id) values ('alice');
+		insert into property (id, value) values
+			('LastFMSessionKey_alice', 'session'),
+			('LastFMSessionKey_orphan', 'orphan-session'),
+			('LastScan', 'scan');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := db.QueryRow(`select value from user_props where user_id = 'alice' and key = 'LastFMSessionKey'`).Scan(&value); err != nil || value != "session" {
+		t.Fatalf("migrated session = %q, %v", value, err)
+	}
+	var count int
+	if err := db.QueryRow(`select count(*) from property where id = 'LastFMSessionKey_alice'`).Scan(&count); err != nil || count != 0 {
+		t.Fatalf("legacy session count = %d, %v", count, err)
+	}
+	if err := db.QueryRow(`select count(*) from property where id in ('LastFMSessionKey_orphan', 'LastScan')`).Scan(&count); err != nil || count != 2 {
+		t.Fatalf("other property count = %d, %v", count, err)
+	}
+	tx, err = db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := downCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`select value from property where id = 'LastFMSessionKey_alice'`).Scan(&value); err != nil || value != "session" {
+		t.Fatalf("restored session = %q, %v", value, err)
+	}
+}
