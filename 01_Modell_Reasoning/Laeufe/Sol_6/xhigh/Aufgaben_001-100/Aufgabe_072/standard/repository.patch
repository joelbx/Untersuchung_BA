+import { ReactElement } from 'react';
+
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { MailSettings } from '@proton/shared/lib/interfaces';
+
+import { useLinkHandler } from './useLinkHandler';
+
+const mockCreateNotification = jest.fn();
+const mockSetModalOpen = jest.fn();
+
+jest.mock('../components', () => ({
+    useModalState: () => [{ open: false }, mockSetModalOpen],
+}));
+jest.mock('../components/notifications/LinkConfirmationModal', () => () => null);
+jest.mock('./index', () => ({
+    useHandler: (handler: (...args: any[]) => void) => handler,
+    useNotifications: () => ({ createNotification: mockCreateNotification }),
+}));
+
+describe('useLinkHandler', () => {
+    beforeEach(() => {
+        mockCreateNotification.mockClear();
+        mockSetModalOpen.mockClear();
+    });
+
+    it('encodes an external hostname before showing the confirmation', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        anchor.setAttribute('href', 'https://www.аррӏе.com/path/?next=https://example.com#section');
+        wrapper.appendChild(anchor);
+
+        const { result } = renderHook(() => useLinkHandler({ current: wrapper }));
+        const click = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(click);
+        });
+
+        const modal = result.current.modal as ReactElement<{ link?: string }>;
+        const expected = 'https://www.xn--80ak6aa92e.com/path?next=https://example.com#section';
+        expect(anchor.getAttribute('href')).toBe(expected);
+        expect(modal.props.link).toBe(expected);
+        expect(mockSetModalOpen).toHaveBeenCalledWith(true);
+        expect(click.defaultPrevented).toBe(true);
+    });
+
+    it('encodes external links even when confirmation is disabled', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        anchor.setAttribute('href', 'https://www.аррӏе.com');
+        wrapper.appendChild(anchor);
+
+        renderHook(() => useLinkHandler({ current: wrapper }, { ConfirmLink: 0 } as MailSettings));
+        act(() => {
+            anchor.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
+        });
+
+        expect(anchor.getAttribute('href')).toBe('https://www.xn--80ak6aa92e.com');
+        expect(mockSetModalOpen).not.toHaveBeenCalled();
+    });
+
+    it('shows an error when a link has no URL', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        wrapper.appendChild(anchor);
+
+        renderHook(() => useLinkHandler({ current: wrapper }));
+        const click = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(click);
+        });
+
+        expect(mockCreateNotification).toHaveBeenCalledWith(expect.objectContaining({ type: 'error' }));
+        expect(click.defaultPrevented).toBe(true);
+    });
+});
