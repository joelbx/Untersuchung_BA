+import punycode from 'punycode.js';
+
 import { getSecondLevelDomain } from '@proton/shared/lib/helpers/url';
 import isTruthy from '@proton/utils/isTruthy';
 
+/** Return the first domain label after an optional www prefix. */
+export const getHostnameWithRegex = (url: string): string => {
+    const match = /^(?:[a-z][a-z\d+.-]*:\/\/)?(?:[^/?#@]+@)?(?:www\.)?([^.:/?#]+)\.[^/?#]+/i.exec(url);
+    return match?.[1] || '';
+};
+
+/** Encode only the hostname, leaving the remaining URL components in place. */
+export const punycodeUrl = (url: string): string => {
+    const parsedUrl = new URL(url);
+    const { protocol, username, password, port, pathname, search, hash } = parsedUrl;
+    if (!parsedUrl.hostname) {
+        throw new TypeError('URL has no hostname');
+    }
+
+    const credentials = username || password ? `${username}${password ? `:${password}` : ''}@` : '';
+    const hostname = punycode.toASCII(parsedUrl.hostname);
+
+    return `${protocol}//${credentials}${hostname}${port ? `:${port}` : ''}${pathname.replace(
+        /\/+$/,
+        ''
+    )}${search}${hash}`;
+};
+
 export const isSubDomain = (hostname: string, domain: string) => {
