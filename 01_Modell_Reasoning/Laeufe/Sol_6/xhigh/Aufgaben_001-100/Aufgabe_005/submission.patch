+def test_check_qt_available_no_installed_wrapper(stubs, monkeypatch):
+    stubs.ImportFake(dict.fromkeys(machinery.WRAPPERS, False), monkeypatch).patch()
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default
+    )
+
+    with pytest.raises(machinery.NoWrapperAvailableError) as exc_info:
+        earlyinit.check_qt_available(info)
+
+    message = str(exc_info.value)
+    assert "PyQt5: ImportError: Fake ImportError for PyQt5." in message
+    assert "PyQt6: ImportError: Fake ImportError for PyQt6." in message
+
+
+def test_check_qt_available_missing_core(stubs, monkeypatch, capsys):
+    stubs.ImportFake({"PyQt5": True, "PyQt5.QtCore": False}, monkeypatch).patch()
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+    monkeypatch.setattr(sys, "argv", ["qutebrowser"])
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default
+    )
+
+    with pytest.raises(SystemExit) as exc_info:
+        earlyinit.check_qt_available(info)
+
+    assert exc_info.value.code == 1
+    output = capsys.readouterr().err
+    assert "PyQt5.QtCore" in output
+    assert output.endswith("\n\n\n")
+
+
+def test_early_init_passes_selection_info(monkeypatch):
+    events = []
+    args = object()
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default
+    )
+
+    monkeypatch.setattr(earlyinit, "init_faulthandler", lambda: events.append("fault"))
+    monkeypatch.setattr(
+        machinery, "init", lambda passed: (events.append(("init", passed)), info)[1]
+    )
+    monkeypatch.setattr(
+        earlyinit, "check_qt_available", lambda passed: events.append(("check", passed))
+    )
+    for name in (
+        "init_log", "check_libraries", "check_qt_version", "configure_pyqt",
+        "check_ssl_support", "check_optimize_flag", "webengine_early_import",
+    ):
+        monkeypatch.setattr(earlyinit, name, lambda *_, name=name: events.append(name))
+
+    earlyinit.early_init(args)
+
+    assert events[:3] == ["fault", ("init", args), ("check", info)]
+    assert events[3:] == [
+        "init_log", "check_libraries", "check_qt_version", "configure_pyqt",
+        "check_ssl_support", "check_optimize_flag", "webengine_early_import",
+    ]
