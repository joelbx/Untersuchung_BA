+func TestStore_FetchGzipLayer(t *testing.T) {
+	const payload = "flags:\n  - key: compressed\n    name: Compressed\n"
+	var compressed bytes.Buffer
+	writer := gzip.NewWriter(&compressed)
+	_, err := writer.Write([]byte(payload))
+	require.NoError(t, err)
+	require.NoError(t, writer.Close())
+
+	dir, repo := testRepository(t, func(t *testing.T, store oras.Target) v1.Descriptor {
+		desc := v1.Descriptor{
+			Digest:    digest.FromBytes(compressed.Bytes()),
+			Size:      int64(compressed.Len()),
+			MediaType: MediaTypeFliptNamespace + "+yaml+gzip",
+			Annotations: map[string]string{
+				AnnotationFliptNamespace: "production",
+			},
+		}
+		require.NoError(t, store.Push(context.Background(), desc, bytes.NewReader(compressed.Bytes())))
+		return desc
+	})
+
+	store, err := NewStore(&config.OCI{BundleDirectory: dir, Repository: fmt.Sprintf("flipt://local/%s:latest", repo)})
+	require.NoError(t, err)
+	resp, err := store.Fetch(context.Background())
+	require.NoError(t, err)
+	require.Len(t, resp.Files, 1)
+	defer resp.Files[0].Close()
+	contents, err := io.ReadAll(resp.Files[0])
+	require.NoError(t, err)
+	assert.Equal(t, payload, string(contents))
+	assert.Equal(t, "production", resp.Files[0].(*File).Namespace())
+	info, err := resp.Files[0].Stat()
+	require.NoError(t, err)
+	assert.Equal(t, ".yaml", path.Ext(info.Name()))
+	assert.False(t, info.ModTime().IsZero())
+}
+
