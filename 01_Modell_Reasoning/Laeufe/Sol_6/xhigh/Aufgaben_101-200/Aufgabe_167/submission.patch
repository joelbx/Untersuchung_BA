new file mode 100644
index 0000000..6b49bd6
--- /dev/null
+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,110 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap/zaptest"
+	"oras.land/oras-go/v2"
+	ociStore "oras.land/oras-go/v2/content/oci"
+)
+
+func TestSourceGetAndSubscribe(t *testing.T) {
+	dir := t.TempDir()
+	writeArtifact(t, dir, "first", fliptoci.MediaTypeFliptNamespace)
+
+	store, err := fliptoci.NewStore(&config.OCI{
+		BundleDirectory: dir,
+		Repository:      "flipt://local/flags:latest",
+	})
+	require.NoError(t, err)
+	source, err := NewSource(zaptest.NewLogger(t), store, WithPollInterval(20*time.Millisecond))
+	require.NoError(t, err)
+	require.Equal(t, "oci", source.String())
+
+	ctx := context.Background()
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "production", "first")
+	require.NoError(t, err)
+
+	again, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, again)
+
+	watchCtx, cancel := context.WithCancel(ctx)
+	ch := make(chan *storagefs.StoreSnapshot, 1)
+	go source.Subscribe(watchCtx, ch)
+	defer cancel()
+
+	// Several polls of an unchanged tag must not emit a snapshot.
+	select {
+	case <-ch:
+		t.Fatal("unchanged OCI digest produced an update")
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	// A separate OCI store simulates another process replacing the tag.
+	writeArtifact(t, dir, "second", fliptoci.MediaTypeFliptFeatures)
+	refreshed, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.NotSame(t, first, refreshed)
+	select {
+	case updated := <-ch:
+		require.Same(t, refreshed, updated)
+		_, err := updated.GetFlag(ctx, "production", "second")
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("external OCI update was not observed")
+	}
+
+	latest, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = latest.GetFlag(ctx, "production", "second")
+	require.NoError(t, err)
+	select {
+	case <-ch:
+		t.Fatal("unchanged OCI digest produced a duplicate update")
+	case <-time.After(80 * time.Millisecond):
+	}
+
+	cancel()
+	select {
+	case _, open := <-ch:
+		require.False(t, open)
+	case <-time.After(time.Second):
+		t.Fatal("subscription did not stop after cancellation")
+	}
+}
+
+func writeArtifact(t *testing.T, dir, flag, mediaType string) {
+	t.Helper()
+	ctx := context.Background()
+	store, err := ociStore.New(filepath.Join(dir, "flags"))
+	require.NoError(t, err)
+
+	payload := []byte("flags:\n  - key: " + flag + "\n    name: " + flag + "\n    enabled: true\n")
+	layer := v1.Descriptor{
+		MediaType: mediaType + "+yaml",
+		Digest:    digest.FromBytes(payload),
+		Size:      int64(len(payload)),
+		Annotations: map[string]string{
+			fliptoci.AnnotationFliptNamespace: "production",
+		},
+	}
+	require.NoError(t, store.Push(ctx, layer, bytes.NewReader(payload)))
+	desc, err := oras.PackManifest(ctx, store, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{
+		Layers: []v1.Descriptor{layer},
+	})
+	require.NoError(t, err)
+	require.NoError(t, store.Tag(ctx, desc, "latest"))
+}
