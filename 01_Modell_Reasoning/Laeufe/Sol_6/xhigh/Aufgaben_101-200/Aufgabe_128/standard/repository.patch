diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..178675d 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,68 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_rule(self):
+        for match in ([], ['set']):
+            for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+                set_module_args({
+                    'chain': 'INPUT',
+                    'protocol': 'tcp',
+                    'match': match,
+                    'match_set': 'admin_hosts',
+                    'match_set_flags': flags,
+                    'destination_port': '22',
+                    'jump': 'ACCEPT',
+                    'comment': 'SSH from admin hosts',
+                })
+
+                with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                    run_command.side_effect = [(1, '', ''), (0, '', '')]
+                    with self.assertRaises(AnsibleExitJson) as result:
+                        iptables.main()
+
+                expected_rule = [
+                    '-p', 'tcp',
+                    '-m', 'set', '--match-set', 'admin_hosts', flags,
+                    '-j', 'ACCEPT',
+                    '--destination-port', '22',
+                    '-m', 'comment', '--comment', 'SSH from admin hosts',
+                ]
+                self.assertEqual(result.exception.args[0]['rule'], ' '.join(expected_rule))
+                self.assertTrue(result.exception.args[0]['changed'])
+                self.assertEqual(run_command.call_count, 2)
+                for action, call in zip(('-C', '-A'), run_command.call_args_list):
+                    self.assertEqual(call[0][0], ['/sbin/iptables', '-t', 'filter', action, 'INPUT'] + expected_rule)
+
+    def test_match_set_inverted(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': '!admin_hosts',
+            'match_set_flags': 'src',
+            'jump': 'DROP',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'src',
+            '-j', 'DROP',
+        ])
+
+    def test_match_set_requires_flags_and_name(self):
+        for args in (
+                {'match_set': 'admin_hosts'},
+                {'match_set_flags': 'src'},
+                {'match_set': '', 'match_set_flags': 'src'},
+                {'match_set': 'admin_hosts', 'match_set_flags': 'source'},
+        ):
+            args['chain'] = 'INPUT'
+            set_module_args(args)
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            run_command.assert_not_called()
