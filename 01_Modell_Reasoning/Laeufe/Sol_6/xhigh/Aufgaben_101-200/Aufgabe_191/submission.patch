+interface IRegistrationTokenAuthEntryState {
+    token: string;
+}
+
+export class RegistrationTokenAuthEntry extends React.Component<IAuthEntryProps, IRegistrationTokenAuthEntryState> {
+    public static LOGIN_TYPE = AuthType.RegistrationToken;
+
+    private submitting = false;
+
+    public constructor(props: IAuthEntryProps) {
+        super(props);
+        this.state = { token: "" };
+    }
+
+    public componentDidMount(): void {
+        this.props.onPhaseChange(DEFAULT_PHASE);
+    }
+
+    public componentDidUpdate(prevProps: IAuthEntryProps): void {
+        if (prevProps.busy && !this.props.busy) {
+            this.submitting = false;
+        }
+    }
+
+    private onTokenChange = (ev: ChangeEvent<HTMLInputElement>): void => {
+        this.setState({ token: ev.target.value });
+    };
+
+    private onSubmit = (ev: React.SyntheticEvent): void => {
+        ev.preventDefault();
+        if (this.props.busy || this.submitting || !this.state.token) return;
+
+        this.submitting = true;
+        this.props.submitAuthDict({
+            type: this.props.loginType,
+            token: this.state.token,
+        });
+    };
+
+    public render(): JSX.Element {
+        return (
+            <div>
+                <p>{_t("Enter a registration token provided by the homeserver administrator.")}</p>
+                <form onSubmit={this.onSubmit}>
+                    <Field
+                        className={classNames({ error: this.props.errorText })}
+                        name="registrationTokenField"
+                        label={_t("Registration token")}
+                        autoFocus={true}
+                        value={this.state.token}
+                        onChange={this.onTokenChange}
+                    />
+                    {this.props.errorText && (
+                        <div className="error" role="alert">
+                            {this.props.errorText}
+                        </div>
+                    )}
+                    <div className="mx_button_row">
+                        {this.props.busy ? (
+                            <Spinner />
+                        ) : (
+                            <AccessibleButton
+                                element="button"
+                                type="submit"
+                                kind="primary"
+                                onClick={this.onSubmit}
+                                disabled={!this.state.token}
+                            >
+                                {_t("Continue")}
+                            </AccessibleButton>
+                        )}
+                    </div>
+                </form>
+            </div>
+        );
+    }
+}
+
