+import React from "react";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+import { MatrixError } from "matrix-js-sdk/src/http-api/errors";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+import { RegistrationTokenAuthEntry } from "../../../src/components/views/auth/InteractiveAuthEntryComponents";
+import { getMockClientWithEventEmitter, unmockClientPeg } from "../../test-utils";
+
+describe("registration token interactive authentication", () => {
+    const clientSecret = "test-client-secret";
+    const mockClient = getMockClientWithEventEmitter({
+        generateClientSecret: jest.fn().mockReturnValue(clientSecret),
+    });
+
+    afterAll(() => unmockClientPeg());
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits the advertised %s token stage and completes authentication",
+        async (loginType) => {
+            const response = { user_id: "@new:example.org" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+
+            render(
+                <InteractiveAuth
+                    matrixClient={mockClient}
+                    authData={{ session: "test-session", flows: [{ stages: [loginType] }] }}
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+            );
+
+            const field = screen.getByRole("textbox", { name: "Registration token" }) as HTMLInputElement;
+            const button = screen.getByRole("button", { name: "Continue" }) as HTMLButtonElement;
+            expect(field.name).toBe("registrationTokenField");
+            expect(field).toHaveFocus();
+            expect(
+                screen.getByText("Enter a registration token provided by the homeserver administrator."),
+            ).toBeTruthy();
+            expect(onStagePhaseChange).toHaveBeenCalledWith(loginType, 0);
+            expect(button).toHaveClass("mx_AccessibleButton_kind_primary");
+            expect(button).toBeDisabled();
+
+            fireEvent.change(field, { target: { value: "given-token" } });
+            expect(button).toBeEnabled();
+            fireEvent.submit(field.closest("form"));
+
+            await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+            expect(makeRequest).toHaveBeenCalledWith({
+                session: "test-session",
+                type: loginType,
+                token: "given-token",
+            });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret,
+                emailSid: undefined,
+            });
+        },
+    );
+
+    it("continues to the next advertised stage after a token is accepted", async () => {
+        const loginType = AuthType.RegistrationToken;
+        const flows = [{ stages: [loginType, AuthType.Password] }];
+        const makeRequest = jest
+            .fn()
+            .mockRejectedValueOnce(new MatrixError({ session: "test-session", flows, completed: [loginType] }, 401))
+            .mockResolvedValueOnce({ user_id: "@new:example.org" });
+        const onAuthFinished = jest.fn();
+        mockClient.credentials = { userId: "@new:example.org" };
+
+        render(
+            <InteractiveAuth
+                matrixClient={mockClient}
+                authData={{ session: "test-session", flows }}
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />,
+        );
+
+        fireEvent.change(screen.getByRole("textbox", { name: "Registration token" }), {
+            target: { value: "given-token" },
+        });
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+
+        const passwordField = await screen.findByLabelText("Password");
+        expect(makeRequest).toHaveBeenNthCalledWith(1, {
+            session: "test-session",
+            type: loginType,
+            token: "given-token",
+        });
+        fireEvent.change(passwordField, { target: { value: "password" } });
+        fireEvent.submit(passwordField.closest("form"));
+        await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+        expect(onAuthFinished).toHaveBeenCalledWith(
+            true,
+            { user_id: "@new:example.org" },
+            { clientSecret, emailSid: undefined },
+        );
+    });
+
+    it("shows errors and prevents duplicate token submissions while busy", () => {
+        const submitAuthDict = jest.fn();
+        const onPhaseChange = jest.fn();
+        const props = {
+            matrixClient: mockClient,
+            loginType: AuthType.RegistrationToken,
+            authSessionId: "test-session",
+            onPhaseChange,
+            submitAuthDict,
+        };
+        const { rerender } = render(<RegistrationTokenAuthEntry {...props} busy={false} />);
+        const field = screen.getByRole("textbox", { name: "Registration token" });
+        const form = field.closest("form");
+
+        expect(onPhaseChange).toHaveBeenCalledWith(0);
+        fireEvent.submit(form);
+        expect(submitAuthDict).not.toHaveBeenCalled();
+        fireEvent.change(field, { target: { value: "given-token" } });
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        fireEvent.submit(form);
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: AuthType.RegistrationToken, token: "given-token" });
+
+        rerender(<RegistrationTokenAuthEntry {...props} busy={true} />);
+        expect(screen.queryByRole("button", { name: "Continue" })).toBeNull();
+        expect(screen.getByLabelText("Loading...")).toBeTruthy();
+        fireEvent.submit(form);
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+
+        rerender(<RegistrationTokenAuthEntry {...props} busy={false} errorText="Invalid registration token" />);
+        expect(screen.getByRole("alert")).toHaveTextContent("Invalid registration token");
+        expect(field.closest(".mx_Field")).toHaveClass("error");
+        fireEvent.submit(form);
+        expect(submitAuthDict).toHaveBeenCalledTimes(2);
+    });
+});
