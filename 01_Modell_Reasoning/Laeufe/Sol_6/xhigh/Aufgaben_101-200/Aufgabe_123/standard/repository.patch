diff --git a/packages/components/containers/notifications/manager.test.tsx b/packages/components/containers/notifications/manager.test.tsx
new file mode 100644
index 0000000..b5dfe6e
--- /dev/null
+++ b/packages/components/containers/notifications/manager.test.tsx
@@ -0,0 +1,51 @@
+import createNotificationManager from './manager';
+import { NotificationOptions } from './interfaces';
+
+const setup = () => {
+    let notifications: NotificationOptions[] = [];
+    const manager = createNotificationManager((update) => {
+        notifications = typeof update === 'function' ? update(notifications) : update;
+    });
+    return { manager, getNotifications: () => notifications };
+};
+
+describe('notification manager', () => {
+    it('uses string text as the default key and deduplicates non-success notifications', () => {
+        const { manager, getNotifications } = setup();
+        manager.createNotification({ type: 'error', text: 'Try again', expiration: -1 });
+        const secondId = manager.createNotification({ type: 'info', text: 'Try again', expiration: -1 });
+
+        expect(getNotifications()).toHaveLength(1);
+        expect(getNotifications()[0]).toMatchObject({ id: secondId, key: 'Try again', type: 'info' });
+    });
+
+    it('uses an explicit key for deduplication even when text changes', () => {
+        const { manager, getNotifications } = setup();
+        manager.createNotification({ type: 'error', text: 'First', key: 'problem', expiration: -1 });
+        manager.createNotification({ type: 'error', text: 'Second', key: 'problem', expiration: -1 });
+        manager.createNotification({ type: 'error', text: 'Second', key: 'different', expiration: -1 });
+
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications()[0]).toMatchObject({ key: 'problem', text: 'Second' });
+        expect(getNotifications()[1]).toMatchObject({ key: 'different', text: 'Second' });
+    });
+
+    it('uses the notification id for React content without an explicit key', () => {
+        const { manager, getNotifications } = setup();
+        const firstId = manager.createNotification({ type: 'warning', text: <b>Warning</b>, expiration: -1 });
+        const secondId = manager.createNotification({ type: 'warning', text: <b>Warning</b>, expiration: -1 });
+
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications().map(({ key }) => key)).toEqual([firstId, secondId]);
+    });
+
+    it('allows repeated success notifications with identical text and keys', () => {
+        const { manager, getNotifications } = setup();
+        manager.createNotification({ type: 'success', text: 'Saved', key: 'saved', expiration: -1 });
+        manager.createNotification({ type: 'success', text: 'Saved', key: 'saved', expiration: -1 });
+        manager.createNotification({ type: 'error', text: 'Saved', key: 'saved', expiration: -1 });
+
+        expect(getNotifications()).toHaveLength(3);
+        expect(getNotifications().map(({ type }) => type)).toEqual(['success', 'success', 'error']);
+    });
+});
