diff --git a/packages/components/containers/notifications/Notification.test.tsx b/packages/components/containers/notifications/Notification.test.tsx
new file mode 100644
index 0000000..4767cda
--- /dev/null
+++ b/packages/components/containers/notifications/Notification.test.tsx
@@ -0,0 +1,60 @@
+import { render, waitFor } from '@testing-library/react';
+import Notification from './Notification';
+
+const renderNotification = (children: React.ReactNode) =>
+    render(
+        <Notification type="error" isClosing={false} onExit={() => {}}>
+            {children}
+        </Notification>
+    );
+
+describe('Notification', () => {
+    it('renders safe HTML links and formatting from string content', () => {
+        const { container } = renderNotification(
+            '<strong>Help</strong> <a href="https://example.com" target="_self" rel="opener">Read more</a>'
+        );
+        const link = container.querySelector('a');
+
+        expect(container.querySelector('strong')).toHaveTextContent('Help');
+        expect(link).toHaveAttribute('href', 'https://example.com');
+        expect(link).toHaveAttribute('target', '_blank');
+        expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('removes unsafe HTML and unsafe link destinations', () => {
+        const { container } = renderNotification(
+            '<img src=x onerror="alert(1)"><script>alert(1)</script><a href="javascript:alert(1)">Bad link</a>'
+        );
+
+        expect(container.querySelector('script')).toBeNull();
+        expect(container.querySelector('img')).not.toHaveAttribute('onerror');
+        expect(container.querySelector('a')).not.toHaveAttribute('href');
+        expect(container.querySelector('a')).toHaveAttribute('target', '_blank');
+        expect(container.querySelector('a')).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('keeps plain strings and React elements supported', () => {
+        const plain = renderNotification('A plain message with &lt; text');
+        expect(plain.getByRole('alert')).toHaveTextContent('A plain message with &lt; text');
+
+        const rich = renderNotification(<a href="https://example.com">React link</a>);
+        expect(rich.getByRole('link')).toHaveAttribute('target', '_blank');
+        expect(rich.getByRole('link')).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('secures links added later by React content', async () => {
+        const view = renderNotification(<span>Waiting</span>);
+        view.rerender(
+            <Notification type="error" isClosing={false} onExit={() => {}}>
+                <a href="https://example.com" target="_self">
+                    New link
+                </a>
+            </Notification>
+        );
+
+        await waitFor(() => {
+            expect(view.getByRole('link')).toHaveAttribute('target', '_blank');
+            expect(view.getByRole('link')).toHaveAttribute('rel', 'noopener noreferrer');
+        });
+    });
+});
