@@ -0,0 +1,115 @@
+package wordpress
+
+import (
+	"io/ioutil"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+	"github.com/future-architect/vuls/util"
+)
+
+type roundTripperFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripperFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestRemoveInactives(t *testing.T) {
+	pkgs := models.WordPressPackages{
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+		{Name: models.WPCore, Type: models.WPCore},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+	}
+	want := models.WordPressPackages{pkgs[1], pkgs[2]}
+	if got := removeInactives(pkgs); !reflect.DeepEqual(got, want) {
+		t.Fatalf("removeInactives() = %#v, want %#v", got, want)
+	}
+	if got := removeInactives(models.WordPressPackages{pkgs[0], pkgs[3]}); got != nil {
+		t.Fatalf("removeInactives(all inactive) = %#v, want nil", got)
+	}
+	if got := removeInactives(nil); got != nil {
+		t.Fatalf("removeInactives(nil) = %#v, want nil", got)
+	}
+}
+
+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	previousTransport := http.DefaultTransport
+	previousConf := config.Conf
+	previousLog := util.Log
+	defer func() {
+		http.DefaultTransport = previousTransport
+		config.Conf = previousConf
+		util.Log = previousLog
+	}()
+	util.Log = util.NewCustomLogger(config.ServerInfo{})
+
+	for _, tt := range []struct {
+		name         string
+		ignore       bool
+		serverIgnore bool
+		paths        []string
+		names        []string
+	}{
+		{
+			name:  "default includes inactive",
+			paths: []string{"/api/v3/wordpresses/60", "/api/v3/themes/active-theme", "/api/v3/themes/inactive-theme", "/api/v3/plugins/must-use-plugin", "/api/v3/plugins/inactive-plugin"},
+			names: []string{"core", "active-theme", "inactive-theme", "must-use-plugin", "inactive-plugin"},
+		},
+		{
+			name:   "ignore inactive",
+			ignore: true,
+			paths:  []string{"/api/v3/wordpresses/60", "/api/v3/themes/active-theme", "/api/v3/plugins/must-use-plugin"},
+			names:  []string{"core", "active-theme", "must-use-plugin"},
+		},
+		{
+			name:         "per-server ignore inactive",
+			serverIgnore: true,
+			paths:        []string{"/api/v3/wordpresses/60", "/api/v3/themes/active-theme", "/api/v3/plugins/must-use-plugin"},
+			names:        []string{"core", "active-theme", "must-use-plugin"},
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf = config.Config{
+				WpIgnoreInactive: tt.ignore,
+				Servers: map[string]config.ServerInfo{
+					"site": {WordPress: config.WordPressConf{IgnoreInactive: tt.serverIgnore}},
+				},
+			}
+			var paths []string
+			http.DefaultTransport = roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+				paths = append(paths, req.URL.Path)
+				return &http.Response{
+					StatusCode: http.StatusOK,
+					Body:       ioutil.NopCloser(strings.NewReader("{}")),
+					Header:     make(http.Header),
+				}, nil
+			})
+			pkgs := models.WordPressPackages{
+				{Name: "core", Type: models.WPCore, Version: "6.0"},
+				{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+				{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+				{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+				{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+			}
+			r := models.ScanResult{ServerName: "site", WordPressPackages: &pkgs, ScannedCves: models.VulnInfos{}}
+			if _, err := FillWordPress(&r, "test-token"); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(paths, tt.paths) {
+				t.Errorf("requested paths = %v, want %v", paths, tt.paths)
+			}
+			var names []string
+			for _, p := range *r.WordPressPackages {
+				names = append(names, p.Name)
+			}
+			if !reflect.DeepEqual(names, tt.names) {
+				t.Errorf("result packages = %v, want %v", names, tt.names)
+			}
+		})
+	}
+}
