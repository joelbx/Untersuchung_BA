+func artistFolderVersion(ctx context.Context, folder string, lastUpdate time.Time) (string, time.Time) {
+	if folder == "" {
+		return "", lastUpdate
+	}
+	started := time.Now()
+	defer func() {
+		log.Trace(ctx, "Checked artist folder for cached image", "folder", folder, "duration", time.Since(started))
+	}()
+	entries, err := os.ReadDir(folder)
+	if err != nil {
+		return "", lastUpdate
+	}
+	dirInfo, err := os.Stat(folder)
+	if err != nil {
+		return "", lastUpdate
+	}
+	var version strings.Builder
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		match, _ := filepath.Match("artist.*", strings.ToLower(entry.Name()))
+		if !match {
+			continue
+		}
+		info, err := entry.Info()
+		if err != nil || info.IsDir() {
+			continue
+		}
+		if lastUpdate.Before(dirInfo.ModTime()) {
+			lastUpdate = dirInfo.ModTime()
+		}
+		if lastUpdate.Before(info.ModTime()) {
+			lastUpdate = info.ModTime()
+		}
+		fmt.Fprintf(&version, "%s.%d.", entry.Name(), info.ModTime().UnixNano())
+	}
+	if version.Len() == 0 {
+		return "", lastUpdate
+	}
+	return fmt.Sprintf("%d.%s", dirInfo.ModTime().UnixNano(), version.String()), lastUpdate
+}
