+// ArtistFolder returns the artist directory shared by the albums' media files.
+func (als Albums) ArtistFolder() string {
+	var folder string
+	albumCount := 0
+	for _, al := range als {
+		dirs := al.Dirs()
+		if len(dirs) == 0 {
+			continue
+		}
+		albumCount++
+		for _, dir := range dirs {
+			if folder == "" {
+				folder = dir
+			} else {
+				folder = commonDir(folder, dir)
+			}
+			if folder == "" {
+				return ""
+			}
+		}
+	}
+	if albumCount == 1 && folder != "" {
+		folder = filepath.Dir(folder)
+	}
+	if folder == "." || folder == string(filepath.Separator) {
+		return ""
+	}
+	return folder
+}
+
+func commonDir(a, b string) string {
+	if filepath.IsAbs(a) != filepath.IsAbs(b) {
+		return ""
+	}
+	for {
+		rel, err := filepath.Rel(a, b)
+		if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			return a
+		}
+		parent := filepath.Dir(a)
+		if parent == a {
+			return ""
+		}
+		a = parent
+	}
+}
