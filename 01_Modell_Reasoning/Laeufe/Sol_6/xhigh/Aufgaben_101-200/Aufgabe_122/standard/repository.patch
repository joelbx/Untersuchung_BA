--- /dev/null
+++ b/ui/src/app/meta/metaSlice.test.ts
@@ -0,0 +1,31 @@
+import { IConfig, StorageType } from '~/types/Meta';
+import { metaSlice, selectConfig, selectReadonly } from './metaSlice';
+
+describe('meta configuration selectors', () => {
+  const initialMeta = metaSlice.getInitialState();
+
+  const cases: {
+    type: StorageType;
+    readOnly?: boolean;
+    expected: boolean;
+  }[] = [
+    { type: StorageType.DATABASE, expected: false },
+    { type: StorageType.DATABASE, readOnly: true, expected: true },
+    { type: StorageType.DATABASE, readOnly: false, expected: false },
+    { type: StorageType.LOCAL, expected: true },
+    { type: StorageType.GIT, expected: true },
+    { type: StorageType.OBJECT, expected: true },
+    { type: StorageType.OBJECT, readOnly: false, expected: false }
+  ];
+
+  it.each(cases)(
+    'uses the config for $type with readOnly $readOnly',
+    ({ type, readOnly, expected }) => {
+      const config: IConfig = { storage: { type, readOnly } };
+      const state = { meta: { ...initialMeta, config } };
+
+      expect(selectConfig(state)).toBe(config);
+      expect(selectReadonly(state)).toBe(expected);
+    }
+  );
+});
