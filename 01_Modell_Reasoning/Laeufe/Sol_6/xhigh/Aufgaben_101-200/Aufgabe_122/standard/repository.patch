+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+func TestAuthenticationGRPCWithoutDatabaseForObjectStorage(t *testing.T) {
+	cfg := config.DefaultConfig()
+	cfg.Storage.Type = config.ObjectStorageType
+	cfg.Database.URL = "invalid://database"
+
+	ctx := context.Background()
+	register, interceptors, shutdown, err := authenticationGRPC(ctx, zap.NewNop(), cfg, false)
+	require.NoError(t, err)
+	require.Len(t, register, 2)
+	require.Empty(t, interceptors)
+	require.NoError(t, shutdown(ctx))
+}
