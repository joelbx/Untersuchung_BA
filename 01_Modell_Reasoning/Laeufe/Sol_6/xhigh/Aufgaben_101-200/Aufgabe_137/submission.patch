+func TestNewGRPCServerUsesConfiguredPropagator(t *testing.T) {
+	cfg := config.Default()
+	cfg.Database.URL = fmt.Sprintf("file:%s", filepath.Join(t.TempDir(), "flipt.db"))
+	cfg.Server.GRPCPort = 0
+	cfg.Tracing.Propagators = []config.TracingPropagator{config.TracingPropagatorB3}
+
+	previous := otel.GetTextMapPropagator()
+	t.Cleanup(func() { otel.SetTextMapPropagator(previous) })
+	previousProvider := otel.GetTracerProvider()
+	t.Cleanup(func() { otel.SetTracerProvider(previousProvider) })
+
+	ctx := context.Background()
+	s, err := NewGRPCServer(ctx, zaptest.NewLogger(t), cfg, info.Flipt{}, false)
+	assert.NoError(t, err)
+	if err != nil {
+		return
+	}
+	t.Cleanup(func() { assert.NoError(t, s.Shutdown(ctx)) })
+	spanCtx, span := otel.Tracer("test").Start(ctx, "operation")
+	defer span.End()
+	carrier := propagation.MapCarrier{}
+	otel.GetTextMapPropagator().Inject(spanCtx, carrier)
+	assert.NotEmpty(t, carrier.Get("b3"))
+	assert.Empty(t, carrier.Get("traceparent"))
+}
