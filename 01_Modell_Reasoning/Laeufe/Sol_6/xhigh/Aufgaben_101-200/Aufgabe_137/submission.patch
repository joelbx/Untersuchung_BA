+func TestNewProviderSampling(t *testing.T) {
+	for _, tt := range []struct {
+		name          string
+		ratio         float64
+		wantRecording bool
+	}{
+		{name: "never sample", ratio: 0, wantRecording: false},
+		{name: "always sample", ratio: 1, wantRecording: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := config.Default().Tracing
+			cfg.SamplingRatio = tt.ratio
+			provider, err := NewProvider(context.Background(), "test", &cfg)
+			assert.NoError(t, err)
+			defer provider.Shutdown(context.Background())
+
+			_, span := provider.Tracer("test").Start(context.Background(), "operation")
+			assert.Equal(t, tt.wantRecording, span.IsRecording())
+			span.End()
+		})
+	}
+}
