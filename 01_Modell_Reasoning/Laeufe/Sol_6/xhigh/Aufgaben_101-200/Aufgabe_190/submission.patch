+        'remote_ids': {'viaf': '123'},
+    }
+    mock_site.save(author)
+    monkeypatch.setattr(
+        mock_site, 'save_many', lambda *args, **kwargs: pytest.fail('preview saved')
+    )
+
+    reply = load(
+        {
+            'title': 'Author Preview',
+            'source_records': ['non-marc:author-preview'],
+            'authors': [
+                {
+                    'name': 'Existing Author',
+                    'key': '/authors/OL123A',
+                    'remote_ids': {'viaf': '123', 'wikidata': 'Q123'},
+                }
+            ],
+        },
+        save=False,
+    )
+
+    assert reply['authors'] == [
+        {'key': '/authors/OL123A', 'name': 'Existing Author', 'status': 'modified'}
+    ]
+    author_edit = next(e for e in reply['edits'] if e['key'] == '/authors/OL123A')
+    assert author_edit['remote_ids'] == {'viaf': '123', 'wikidata': 'Q123'}
+    assert mock_site.get('/authors/OL123A').dict()['remote_ids'] == {'viaf': '123'}
