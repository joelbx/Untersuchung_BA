+def test_preview_orphaned_edition_creates_temporary_work(mock_site, monkeypatch):
+    mock_site.save(
+        {'key': '/authors/OL99A', 'name': 'Test Author', 'type': {'key': '/type/author'}}
+    )
+    mock_site.save(
+        {
+            'key': '/books/OL99M',
+            'title': 'Orphaned Preview',
+            'source_records': ['ia:orphaned-preview'],
+            'authors': [{'key': '/authors/OL99A'}],
+            'type': {'key': '/type/edition'},
+        }
+    )
+    monkeypatch.setattr(
+        mock_site, 'save_many', lambda *args, **kwargs: pytest.fail('preview saved')
+    )
+
+    reply = load(
+        {
+            'title': 'Orphaned Preview',
+            'source_records': ['ia:orphaned-preview'],
+            'authors': [{'name': 'Test Author'}],
+        },
+        save=False,
+    )
+
+    assert reply['edition'] == {'key': '/books/OL99M', 'status': 'modified'}
+    assert reply['work']['key'].startswith('/works/__new__')
+    assert reply['work']['status'] == 'created'
+    assert {edit['key'] for edit in reply['edits']} == {
+        '/books/OL99M', reply['work']['key']
+    }
+    assert not mock_site.get('/books/OL99M').get('works')
