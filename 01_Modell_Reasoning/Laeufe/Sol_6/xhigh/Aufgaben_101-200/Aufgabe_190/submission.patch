+            'languages': ['fre'],
+            'subjects': ['Preview subject'],
+            'cover': 'https://evil.test/cover.jpg',
+        },
+        save=False,
+    )
+
+    assert reply['preview'] is True
+    assert reply['cover_accepted'] is False
+    assert reply['edition'] == {'key': edition_key, 'status': 'modified'}
+    assert reply['work'] == {'key': work_key, 'status': 'modified'}
+    assert {e['key'] for e in reply['edits']} == {edition_key, work_key}
+    assert mock_site.get(edition_key).dict() == before_edition
