@@ -0,0 +1,60 @@
+package grpc_middleware
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/blang/semver/v4"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap/zaptest"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+)
+
+func TestFliptAcceptServerVersionFromContext(t *testing.T) {
+	require.Equal(t, semver.Version{Major: 1}, FliptAcceptServerVersionFromContext(context.Background()))
+
+	version := semver.Version{Major: 2, Minor: 3, Patch: 4}
+	ctx := WithFliptAcceptServerVersion(context.Background(), version)
+	require.Equal(t, version, FliptAcceptServerVersionFromContext(ctx))
+}
+
+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name      string
+		header    string
+		hasHeader bool
+		want      semver.Version
+	}{
+		{name: "missing header", want: semver.Version{Major: 1}},
+		{name: "empty header", hasHeader: true, want: semver.Version{Major: 1}},
+		{name: "plain version", header: "1.2.3", hasHeader: true, want: semver.Version{Major: 1, Minor: 2, Patch: 3}},
+		{name: "prefixed version", header: "v2.3.4", hasHeader: true, want: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+		{name: "invalid version", header: "not-a-version", hasHeader: true, want: semver.Version{Major: 1}},
+		{name: "incomplete version", header: "1.2", hasHeader: true, want: semver.Version{Major: 1}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.hasHeader {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.header))
+			}
+
+			response := new(struct{})
+			handlerErr := errors.New("handler error")
+			called := false
+			handler := func(ctx context.Context, _ interface{}) (interface{}, error) {
+				called = true
+				require.Equal(t, tt.want, FliptAcceptServerVersionFromContext(ctx))
+				return response, handlerErr
+			}
+
+			got, err := FliptAcceptServerVersionUnaryInterceptor(zaptest.NewLogger(t))(ctx, nil, &grpc.UnaryServerInfo{}, handler)
+			require.True(t, called)
+			require.Same(t, response, got)
+			require.ErrorIs(t, err, handlerErr)
+		})
+	}
+}
