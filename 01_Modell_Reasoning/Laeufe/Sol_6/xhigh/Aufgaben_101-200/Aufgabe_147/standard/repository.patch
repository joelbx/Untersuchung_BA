+/** Upgrade older config shapes in place, retaining all other fields. */
+export function migrateConfig(loadedConfig: any, version: number = DeviceConfig.Version): void {
+	if (loadedConfig._version >= version) return
+	if (loadedConfig._version < 3 || Array.isArray(loadedConfig._credentials)) {
 		migrateConfigV2to3(loadedConfig)
 	}
+	if (loadedConfig._themeId == null && loadedConfig._theme != null) {
+		loadedConfig._themeId = loadedConfig._theme
+	}
+	delete loadedConfig._theme
+	loadedConfig._version = version
 }
 
