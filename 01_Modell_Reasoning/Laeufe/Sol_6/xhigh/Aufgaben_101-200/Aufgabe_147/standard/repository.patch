+/** Migrate V2 array credentials to a userId-keyed object. Exported for testing. */
+export function migrateConfigV2to3(loadedConfig: any): void {
+	if (!Array.isArray(loadedConfig._credentials)) return
+	loadedConfig._credentials = Object.fromEntries(loadedConfig._credentials.map((oldCredential: any) => {
+		const userId = oldCredential.credentialInfo?.userId ?? oldCredential.userId
+		const mailAddress = oldCredential.mailAddress
+		let credential = oldCredential
+		if (!oldCredential.credentialInfo) {
