+
+describe('Topic backlinks', () => {
+	let uid;
+	let cid;
+	let target;
+	let otherTarget;
+	let source;
+	let originalSetting;
+
+	before(async () => {
+		originalSetting = meta.config.topicBacklinks;
+		meta.config.topicBacklinks = 1;
+		uid = await user.create({ username: 'backlinkauthor' });
+		cid = (await categories.create({ name: 'Backlink test category' })).cid;
+		target = await topics.post({ title: 'Backlink target', content: 'Target content', uid, cid });
+		otherTarget = await topics.post({ title: 'Other backlink target', content: 'Other target content', uid, cid });
+	});
+
+	after(() => {
+		meta.config.topicBacklinks = originalSetting;
+	});
+
+	it('rejects invalid post data', async () => {
+		await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+		await assert.rejects(topics.syncBacklinks({ pid: 1, uid, tid: 1 }), { message: '[[error:invalid-data]]' });
+	});
+
+	it('creates one backlink for a new topic even when its first post repeats the link', async () => {
+		const targetTid = target.topicData.tid;
+		const otherTid = otherTarget.topicData.tid;
+		source = await topics.post({
+			title: 'Backlink source',
+			content: `See ${nconf.get('url')}/topic/${targetTid}/target and /topic/${targetTid}. External https://elsewhere.example/topic/${otherTid}`,
+			uid,
+			cid,
+		});
+		const key = `pid:${source.postData.pid}:backlinks`;
+		assert.deepStrictEqual(await db.getSortedSetRange(key, 0, -1), [String(targetTid)]);
+		const events = await topics.events.get(targetTid);
+		assert.strictEqual(events.length, 1);
+		assert.strictEqual(events[0].type, 'backlink');
+		assert.strictEqual(events[0].text, '[[topic:backlink]]');
+		assert.strictEqual(events[0].href, `/post/${source.postData.pid}`);
+		assert.strictEqual(events[0].uid, uid);
+		assert.deepStrictEqual(await topics.events.get(otherTid), []);
+		assert.strictEqual(await topics.syncBacklinks(source.postData), 0);
+	});
+
+	it('removes stale backlinks and ignores self and missing topics', async () => {
+		const changeCount = await topics.syncBacklinks({
+			...source.postData,
+			content: `Self /topic/${source.topicData.tid}, missing /topic/999999999`,
+		});
+		assert.strictEqual(changeCount, 1);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${source.postData.pid}:backlinks`, 0, -1), []);
+		assert.deepStrictEqual(await topics.events.get(target.topicData.tid), []);
+	});
+
+	it('updates backlinks when a reply is edited', async () => {
+		const reply = await topics.reply({
+			uid,
+			tid: source.topicData.tid,
+			content: `See /topic/${target.topicData.tid}`,
+		});
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${reply.pid}:backlinks`, 0, -1), [String(target.topicData.tid)]);
+		await posts.edit({ pid: reply.pid, uid, content: `Now see /topic/${otherTarget.topicData.tid}` });
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${reply.pid}:backlinks`, 0, -1), [String(otherTarget.topicData.tid)]);
+		assert.deepStrictEqual(await topics.events.get(target.topicData.tid), []);
+		const events = await topics.events.get(otherTarget.topicData.tid);
+		assert.strictEqual(events.length, 1);
+		assert.strictEqual(events[0].href, `/post/${reply.pid}`);
+	});
+
+	it('hides existing backlinks from the timeline when disabled', async () => {
+		const nonBacklink = (await topics.events.log(otherTarget.topicData.tid, { type: 'pin', uid }))[0];
+		meta.config.topicBacklinks = 0;
+		const visibleEvents = await topics.events.get(otherTarget.topicData.tid);
+		assert.strictEqual(visibleEvents.length, 1);
+		assert.strictEqual(visibleEvents[0].id, nonBacklink.id);
+		assert.strictEqual(visibleEvents[0].type, 'pin');
+		meta.config.topicBacklinks = 1;
+		assert.strictEqual((await topics.events.get(otherTarget.topicData.tid)).length, 2);
+	});
+
+	it('drops an association when the referenced topic no longer exists', async () => {
+		const doomed = await topics.post({ title: 'Temporary target', content: 'Temporary content', uid, cid });
+		const referring = await topics.post({
+			title: 'Temporary reference',
+			content: `See /topic/${doomed.topicData.tid}`,
+			uid,
+			cid,
+		});
+		await topics.purgePostsAndTopic(doomed.topicData.tid, uid);
+		assert.strictEqual(await topics.syncBacklinks(referring.postData), 1);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${referring.postData.pid}:backlinks`, 0, -1), []);
+	});
+});
