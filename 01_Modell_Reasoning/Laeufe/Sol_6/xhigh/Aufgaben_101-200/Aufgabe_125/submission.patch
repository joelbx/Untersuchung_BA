+		const prefix = baseUrl ? `(?:${escapedBaseUrl})?` : '';
+		const linkPattern = new RegExp(`(?:^|[\\s(<"'=])${prefix}/topic/([1-9]\\d*)(?=$|[^\\w-])`, 'gi');
+		const referenced = new Set();
