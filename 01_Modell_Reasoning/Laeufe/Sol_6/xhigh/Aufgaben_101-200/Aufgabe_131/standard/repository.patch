diff --git a/packages/components/payments/client-extensions/usePollEvents.test.ts b/packages/components/payments/client-extensions/usePollEvents.test.ts
new file mode 100644
index 0000000..bafb133
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.ts
@@ -0,0 +1,151 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+
+import { useEventManager } from '../../hooks';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+jest.mock('../../hooks', () => ({ useEventManager: jest.fn() }));
+
+const call = jest.fn().mockResolvedValue(undefined);
+const unsubscribe = jest.fn();
+const subscribe = jest.fn();
+
+const advancePollingSteps = async (steps: number) => {
+    for (let step = 0; step < steps; step += 1) {
+        jest.advanceTimersByTime(interval);
+        await Promise.resolve();
+    }
+};
+
+beforeEach(() => {
+    jest.useFakeTimers();
+    jest.clearAllMocks();
+    call.mockResolvedValue(undefined);
+    subscribe.mockReturnValue(unsubscribe);
+    jest.mocked(useEventManager).mockReturnValue({ call, subscribe } as any);
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+it('calls at fixed intervals and stops after five attempts', async () => {
+    expect(interval).toBe(5000);
+    expect(maxPollingSteps).toBe(5);
+
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current();
+
+    expect(call).not.toHaveBeenCalled();
+    jest.advanceTimersByTime(interval - 1);
+    expect(call).not.toHaveBeenCalled();
+
+    jest.advanceTimersByTime(1);
+    expect(call).toHaveBeenCalledTimes(1);
+    await Promise.resolve();
+    await advancePollingSteps(maxPollingSteps - 1);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+
+    await polling;
+    await advancePollingSteps(2);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(subscribe).not.toHaveBeenCalled();
+});
+
+it('ignores unrelated events and stops on the matching property and action', async () => {
+    let notify!: (event: Record<string, { Action: EVENT_ACTIONS }[]>) => void;
+    subscribe.mockImplementation((handler) => {
+        notify = handler;
+        return unsubscribe;
+    });
+
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    notify({ Addresses: [{ Action: EVENT_ACTIONS.CREATE }] });
+    notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+    await advancePollingSteps(2);
+    expect(call).toHaveBeenCalledTimes(2);
+    expect(unsubscribe).not.toHaveBeenCalled();
+
+    notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+    notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await advancePollingSteps(maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(2);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes after the last attempt and ignores late events', async () => {
+    let notify!: (event: Record<string, { Action: EVENT_ACTIONS }[]>) => void;
+    subscribe.mockImplementation((handler) => {
+        notify = handler;
+        return unsubscribe;
+    });
+
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    await advancePollingSteps(maxPollingSteps);
+    await polling;
+
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    jest.advanceTimersByTime(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('cleans up when a matching event arrives while a call is pending', async () => {
+    let notify!: (event: Record<string, { Action: EVENT_ACTIONS }[]>) => void;
+    let completeCall!: () => void;
+    call.mockImplementation(() => new Promise<void>((resolve) => (completeCall = resolve)));
+    subscribe.mockImplementation((handler) => {
+        notify = handler;
+        return unsubscribe;
+    });
+
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    jest.advanceTimersByTime(interval);
+    jest.advanceTimersByTime(interval * 2);
+    expect(call).toHaveBeenCalledTimes(1);
+    notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    completeCall();
+    await Promise.resolve();
+    jest.advanceTimersByTime(interval * maxPollingSteps);
+
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes if a matching event arrives during registration', async () => {
+    subscribe.mockImplementation((handler) => {
+        handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        return unsubscribe;
+    });
+
+    const { result } = renderHook(() => usePollEvents());
+    await result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    jest.advanceTimersByTime(interval * maxPollingSteps);
+
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    expect(call).not.toHaveBeenCalled();
+});
+
+it('unsubscribes if the event manager call fails', async () => {
+    const error = new Error('fetch failed');
+    call.mockRejectedValue(error);
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    jest.advanceTimersByTime(interval);
+    await expect(polling).rejects.toBe(error);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    jest.advanceTimersByTime(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+});
