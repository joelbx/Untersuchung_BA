+@pytest.mark.posix
+@pytest.mark.parametrize('verbose', [False, True])
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, verbose):
+    proc.verbose = verbose
+
+    with qtbot.wait_signals([proc.started, proc.finished], timeout=10000,
+                            order='strict'):
+        proc.start(*py_proc('import os, signal; os.kill(os.getpid(), signal.SIGTERM)'))
+
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.code == signal.SIGTERM
+    assert proc.outcome.was_sigterm()
+    assert not proc.outcome.was_successful()
+    assert proc.outcome.state_str() == 'terminated'
+    assert str(proc.outcome) == 'Testprocess terminated with SIGTERM.'
+
+    if verbose:
+        assert message_mock.messages[-1].level == usertypes.MessageLevel.info
+        assert message_mock.messages[-1].text == (
+            f"Testprocess terminated with SIGTERM. See :process {proc.pid} "
+            "for details.")
+    else:
+        assert not message_mock.messages
 
 
