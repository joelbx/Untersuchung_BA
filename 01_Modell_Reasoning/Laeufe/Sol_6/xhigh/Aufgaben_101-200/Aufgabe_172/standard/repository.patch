+// FormattedListenPorts returns listening ports for reports, including legacy scan results.
+func (p AffectedProcess) FormattedListenPorts() []string {
+	if len(p.ListenPortStats) == 0 {
+		return p.ListenPorts
+	}
+	ports := make([]string, 0, len(p.ListenPortStats))
+	for _, stat := range p.ListenPortStats {
+		port := fmt.Sprintf("%s:%s", stat.BindAddress, stat.Port)
+		if len(stat.PortReachableTo) > 0 {
+			port = fmt.Sprintf("%s(◉ Scannable: %s)", port, stat.PortReachableTo)
+		}
+		ports = append(ports, port)
+	}
+	return ports
+}
+
+// NewPortStat parses an IP address and port, including wildcard and bracketed IPv6 addresses.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	host, port, err := net.SplitHostPort(ipPort)
+	if err != nil || host == "" || port == "" || (host != "*" && net.ParseIP(host) == nil) {
+		return nil, xerrors.Errorf("Invalid listening port: %s", ipPort)
+	}
+	for _, digit := range port {
+		if digit < '0' || digit > '9' {
+			return nil, xerrors.Errorf("Invalid listening port: %s", ipPort)
+		}
+	}
+	n, err := strconv.Atoi(port)
+	if err != nil || n < 0 || n > 65535 {
+		return nil, xerrors.Errorf("Invalid listening port: %s", ipPort)
+	}
+	if strings.HasPrefix(ipPort, "[") {
+		host = "[" + host + "]"
+	}
+	stat.BindAddress, stat.Port = host, port
+	return stat, nil
+}
+
