+func TestAffectedProcessLegacyListenPorts(t *testing.T) {
+	var p Package
+	input := `{"affectedProcs":[{"pid":"12","listenPorts":["127.0.0.1:22","*:80"]}]}`
+	if err := json.Unmarshal([]byte(input), &p); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := p.AffectedProcs[0].ListenPorts, []string{"127.0.0.1:22", "*:80"}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("legacy ports = %v, want %v", got, want)
+	}
+	if got := p.AffectedProcs[0].FormattedListenPorts(); !reflect.DeepEqual(got, p.AffectedProcs[0].ListenPorts) {
+		t.Fatalf("formatted legacy ports = %v", got)
+	}
+}
+
+func TestNewPortStatInvalid(t *testing.T) {
+	for _, input := range []string{"127.0.0.1", "127.0.0.1:", ":22", "::1:22", "host:22", "127.0.0.1:bad", "127.0.0.1:+22", "127.0.0.1:65536"} {
+		if _, err := NewPortStat(input); err == nil {
+			t.Errorf("NewPortStat(%q) should fail", input)
+		}
+	}
+}
+
+func TestPackageHasReachablePort(t *testing.T) {
+	for _, tt := range []struct {
+		packageValue Package
+		want         bool
+	}{
+		{Package{}, false},
+		{Package{AffectedProcs: []AffectedProcess{{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22"}}}}}, false},
+		{Package{AffectedProcs: []AffectedProcess{{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1"}}}}}}, true},
+	} {
+		if got := tt.packageValue.HasReachablePort(); got != tt.want {
+			t.Errorf("HasReachablePort() = %v, want %v", got, tt.want)
+		}
+	}
+}
