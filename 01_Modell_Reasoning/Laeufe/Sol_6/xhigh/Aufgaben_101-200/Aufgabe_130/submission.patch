+func TestPrintEnrollOutcomeNilDevice(t *testing.T) {
+	read, write, err := os.Pipe()
+	require.NoError(t, err)
+	defer read.Close()
+	defer write.Close()
+
+	stdout := os.Stdout
+	os.Stdout = write
+	defer func() { os.Stdout = stdout }()
+
+	printEnrollOutcome(enroll.DeviceRegistered, nil)
+	require.NoError(t, write.Close())
+	got, err := io.ReadAll(read)
+	require.NoError(t, err)
+	require.Equal(t, "Device registered\n", string(got))
+}
