+func TestCeremony_RunAdminDeviceLimit(t *testing.T) {
+	env := testenv.MustNew()
+	defer env.Close()
+
+	dev, err := testenv.NewFakeMacOSDevice()
+	require.NoError(t, err)
+	c := &enroll.Ceremony{
+		GetDeviceOSType:         dev.GetDeviceOSType,
+		EnrollDeviceInit:        dev.EnrollDeviceInit,
+		SignChallenge:           dev.SignChallenge,
+		SolveTPMEnrollChallenge: dev.SolveTPMEnrollChallenge,
+	}
+	ctx := context.Background()
+	env.Service.SetDevicesLimitReached(true)
+
+	registered, outcome, err := c.RunAdmin(ctx, env.DevicesClient, false)
+	require.Error(t, err)
+	assert.True(t, trace.IsAccessDenied(trail.FromGRPC(err)))
+	assert.ErrorContains(t, err, "cluster has reached its enrolled trusted device limit")
+	assert.ErrorContains(t, err, "device limit")
+	assert.Equal(t, enroll.DeviceRegistered, outcome)
+	require.NotNil(t, registered)
+	assert.Equal(t, dev.SerialNumber, registered.AssetTag)
+	assert.Equal(t, devicepb.DeviceEnrollStatus_DEVICE_ENROLL_STATUS_NOT_ENROLLED, registered.EnrollStatus)
+
+	// Registration persists even though enrollment failed.
+	found, err := env.DevicesClient.FindDevices(ctx, &devicepb.FindDevicesRequest{IdOrTag: dev.SerialNumber})
+	require.NoError(t, err)
+	require.Len(t, found.Devices, 1)
+	assert.Equal(t, registered.Id, found.Devices[0].Id)
+	assert.Equal(t, devicepb.DeviceEnrollStatus_DEVICE_ENROLL_STATUS_NOT_ENROLLED, found.Devices[0].EnrollStatus)
+
+	env.Service.SetDevicesLimitReached(false)
+	enrolled, outcome, err := c.RunAdmin(ctx, env.DevicesClient, false)
+	require.NoError(t, err)
+	assert.Equal(t, enroll.DeviceEnrolled, outcome)
+	require.NotNil(t, enrolled)
+	assert.Equal(t, registered.Id, enrolled.Id)
+}
