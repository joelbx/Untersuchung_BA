+def add_db_name(rec: dict) -> None:
+    """Add an author's name and available dates to each author in place."""
+    for author in rec.get('authors') or []:
+        name = author.get('name')
+        if not name:
+            continue
+        date = author.get('date')
+        if not date and (author.get('birth_date') or author.get('death_date')):
+            date = f"{author.get('birth_date') or ''}-{author.get('death_date') or ''}"
+        author['db_name'] = f'{name} {date}' if date else name
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare an imported or existing edition."""
+    title = rec.get('title')
+    if title:
+        if prefix := rec.get('title_prefix'):
+            title = f'{prefix.rstrip()} {title}'
+        if rec.get('subtitle'):
+            title += ' ' + rec['subtitle']
+    else:
+        title = rec.get('full_title') or ''
+
+    expanded = build_titles(title) if title else {
+        'full_title': '',
+        'normalized_title': '',
+        'titles': [],
+        'short_title': '',
+    }
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        if isinstance(values, str):
+            values = [values]
+        for value in values:
+            if value and value not in expanded['isbn']:
+                expanded['isbn'].append(value)
+
+    if rec.get('publish_country') and rec['publish_country'] not in ('   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in ('lccn', 'publishers', 'publish_date', 'number_of_pages'):
+        if rec.get(field):
+            expanded[field] = rec[field]
+    for field in ('authors', 'contribs'):
+        if rec.get(field):
+            expanded[field] = [author.copy() for author in rec[field]]
+            add_db_name({'authors': expanded[field]})
+    return expanded
+
+
