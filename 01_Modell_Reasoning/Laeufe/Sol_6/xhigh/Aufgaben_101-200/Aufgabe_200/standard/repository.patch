+@pytest.mark.parametrize('duration, ms', [
+    ('5000', 5000),
+    ('2m30s', 150000),
+    ('0.25m', 15000),
+])
+def test_later_duration(mocker, mode_manager, duration, ms):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer').return_value
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    result = runners.CommandParser().parse(
+        'later {} message-info done'.format(duration))
+    result.cmd.run(win_id=0, args=result.args)
+
+    timer.setInterval.assert_called_once_with(ms)
+    timer.start.assert_called_once_with()
+
+
+def test_later_invalid_duration(mocker, mode_manager):
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+
+    result = runners.CommandParser().parse('later 1ms message-info done')
+    with pytest.raises(cmdutils.CommandError, match='Invalid duration'):
+        result.cmd.run(win_id=0, args=result.args)
+
+    timer.assert_not_called()
