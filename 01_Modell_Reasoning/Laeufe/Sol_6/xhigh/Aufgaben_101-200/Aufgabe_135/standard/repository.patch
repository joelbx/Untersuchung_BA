+@pytest.mark.parametrize('filter_name, selected_mount', [('min', '/small'), ('max', '/large')])
+def test_min_max_attribute(filter_name, selected_mount):
+    if not getattr(ms, 'HAS_' + filter_name.upper()):
+        pytest.skip('Jinja2 does not provide do_' + filter_name)
+
+    mounts = [{'mount': '/small', 'block_total': 10}, {'mount': '/large', 'block_total': 100}]
+    template_env = Environment()
+    template_env.filters.update(ms.FilterModule().filters())
+    template = template_env.from_string('{{ (mounts | %s(attribute="block_total")).mount }}' % filter_name)
+    assert template.render(mounts=mounts) == selected_mount
+
+
+@pytest.mark.parametrize('filter_name, default, case_sensitive', [('min', 'a', 'B'), ('max', 'B', 'a')])
+def test_min_max_case_sensitive(filter_name, default, case_sensitive):
+    if not getattr(ms, 'HAS_' + filter_name.upper()):
+        pytest.skip('Jinja2 does not provide do_' + filter_name)
+
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, ['a', 'B']) == default
+    assert filter_func(env, ['a', 'B'], case_sensitive=True) == case_sensitive
+
+
+@pytest.mark.parametrize('filter_name', ['min', 'max'])
+def test_min_max_forward_all_kwargs(monkeypatch, filter_name):
+    received = {}
+
+    def jinja_filter(environment, values, **kwargs):
+        received.update(environment=environment, values=values, kwargs=kwargs)
+        return 'selected'
+
+    monkeypatch.setattr(ms, 'HAS_' + filter_name.upper(), True)
+    monkeypatch.setattr(ms, 'do_' + filter_name, jinja_filter, raising=False)
+    values = [{'name': 'a'}]
+    assert getattr(ms, filter_name)(env, values, attribute='name', case_sensitive=True, custom=True) == 'selected'
+    assert received == {'environment': env, 'values': values,
+                        'kwargs': {'attribute': 'name', 'case_sensitive': True, 'custom': True}}
+
+
+@pytest.mark.parametrize('filter_name, expected', [('min', 1), ('max', 2)])
+@pytest.mark.parametrize('kwargs', [{'attribute': 'value'}, {'case_sensitive': False}, {'custom': True}])
+def test_min_max_fallback(monkeypatch, filter_name, expected, kwargs):
+    monkeypatch.setattr(ms, 'HAS_' + filter_name.upper(), False)
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, [2, 1]) == expected
+
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_func(env, [2, 1], **kwargs)
+    assert error.value.message == (
+        "Ansible's %s filter does not support any keyword arguments. "
+        "You need Jinja2 2.10 or later that provides their version of the filter." % filter_name
+    )
 
 
