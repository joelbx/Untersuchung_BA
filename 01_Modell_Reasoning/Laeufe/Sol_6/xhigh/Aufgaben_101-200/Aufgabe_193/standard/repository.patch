+@pytest.mark.parametrize('command, role_count, collection_count, skipped_message', [
+    (['install'], 1, 1, None),
+    (['install', '-p', '/tmp/galaxy-roles'], 1, 0, 'Collections cannot be installed to a roles path'),
+    (['install', '--roles-path', '/tmp/galaxy-roles'], 1, 0, 'Collections cannot be installed to a roles path'),
+    (['role', 'install'], 1, 0, None),
+    (['role', 'install', '-p', '/tmp/galaxy-roles'], 1, 0, None),
+    (['collection', 'install'], 0, 1, 'contains roles which will be ignored'),
+])
+def test_mixed_requirements_install(tmp_path, monkeypatch, capsys, command, role_count, collection_count,
+                                    skipped_message):
+    requirements_file = str(tmp_path.joinpath('requirements.yml'))
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles:\n- example.role\ncollections:\n- example.collection\n')
+
+    mock_roles = MagicMock()
+    mock_collections = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', mock_roles)
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', mock_collections)
+
+    GalaxyCLI(['ansible-galaxy'] + command + ['-r', requirements_file]).run()
+
+    assert mock_roles.call_count == role_count
+    assert mock_collections.call_count == collection_count
+    if role_count:
+        assert [role.name for role in mock_roles.call_args[0][0]] == ['example.role']
+    if collection_count:
+        assert mock_collections.call_args[0][0] == [('example.collection', '*', None)]
+
+    output = capsys.readouterr()
+    if skipped_message:
+        assert skipped_message in output.out + output.err
+    if role_count:
+        assert 'Starting galaxy role install process' in output.out
+
+
+def test_explicit_role_skips_collections_at_verbose_level(tmp_path, monkeypatch, capsys):
+    requirements_file = str(tmp_path.joinpath('requirements.yml'))
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('collections:\n- example.collection\n')
+
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', MagicMock())
+    GalaxyCLI(['ansible-galaxy', 'role', 'install', '-r', requirements_file]).run()
+    assert 'contains collections which will be ignored' not in capsys.readouterr().out
+
+    co.GlobalCLIArgs._Singleton__instance = None
+    GalaxyCLI(['ansible-galaxy', 'role', 'install', '-vvv', '-r', requirements_file]).run()
+    assert 'contains collections which will be ignored' in capsys.readouterr().out
+
+
+def test_empty_requirements_skips_install(tmp_path, monkeypatch, capsys):
+    requirements_file = str(tmp_path.joinpath('requirements.yml'))
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles: []\ncollections: []\n')
+
+    mock_roles = MagicMock()
+    mock_collections = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', mock_roles)
+    monkeypatch.setattr(GalaxyCLI, '_install_collections', mock_collections)
+    GalaxyCLI(['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+    mock_roles.assert_not_called()
+    mock_collections.assert_not_called()
+    assert 'Skipping install, no requirements found' in capsys.readouterr().out
+
+
+def test_implicit_install_uses_default_paths(tmp_path, monkeypatch):
+    roles_path = str(tmp_path.joinpath('roles'))
+    collections_path = str(tmp_path.joinpath('collections'))
+    monkeypatch.setattr(C, 'DEFAULT_ROLES_PATH', [roles_path])
+    monkeypatch.setattr(C, 'COLLECTIONS_PATHS', [collections_path])
+
+    requirements_file = str(tmp_path.joinpath('requirements.yml'))
+    with open(requirements_file, 'w') as req_obj:
+        req_obj.write('roles:\n- example.role\ncollections:\n- example.collection\n')
+
+    mock_roles = MagicMock()
+    mock_install = MagicMock()
+    monkeypatch.setattr(GalaxyCLI, '_install_roles', mock_roles)
+    monkeypatch.setattr(ansible.cli.galaxy, 'install_collections', mock_install)
+    GalaxyCLI(['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+    assert context.CLIARGS['roles_path'] == (roles_path,)
+    assert context.CLIARGS['requirements'] is None
+    assert mock_roles.call_count == 1
+    assert mock_install.call_args[0][1] == os.path.join(collections_path, 'ansible_collections')
+
+
+def test_role_requirements_reject_invalid_extension(tmp_path):
+    requirements_file = str(tmp_path.joinpath('requirements.txt'))
+    with pytest.raises(AnsibleError, match='Invalid role requirements file'):
+        GalaxyCLI(['ansible-galaxy', 'install', '-r', requirements_file]).run()
+
+
+def test_implicit_role_command_with_type_name_as_argument():
+    cli = GalaxyCLI(['ansible-galaxy', 'install', 'collection'])
+    cli.parse()
+
+    assert cli._implicit_role is True
+    assert context.CLIARGS['type'] == 'role'
+    assert context.CLIARGS['args'] == ('collection',)
+
+
+@pytest.mark.parametrize('child_installed, force_flag, expected', [
+    (False, None, ['example.root', 'example.child', 'example.grandchild']),
+    (True, None, ['example.root']),
+    (True, '--force', ['example.root', 'example.child', 'example.grandchild']),
+    (True, '--force-with-deps', ['example.root', 'example.child', 'example.grandchild']),
+])
+def test_role_dependencies_only_reinstall_when_forced(monkeypatch, child_installed, force_flag, expected):
+    installed = []
+
+    class FakeRole(object):
+        def __init__(self, galaxy, api, name, src=None, version=None, scm=None, path=None):
+            self.name = name
+            self.src = src or name
+            self.scm = scm
+            self.version = version
+            self.path = path or 'unused'
+            dependencies = {
+                'example.root': ['example.child'],
+                'example.child': ['example.grandchild'],
+            }
+            self.metadata = {'dependencies': dependencies.get(name, [])}
+            self.requirements = []
+            self.install_info = {'version': version} if name == 'example.child' and child_installed else None
+
+        def __eq__(self, other):
+            return self.name == other.name
+
+        def __repr__(self):
+            return self.name
+
+        def install(self):
+            installed.append(self.name)
+            return True
+
+        def remove(self):
+            self.install_info = None
+
+    monkeypatch.setattr(ansible.cli.galaxy, 'GalaxyRole', FakeRole)
+    command = ['ansible-galaxy', 'role', 'install', 'example.root']
+    if force_flag:
+        command.append(force_flag)
+    GalaxyCLI(command).run()
+
+    assert installed == expected
+
+
