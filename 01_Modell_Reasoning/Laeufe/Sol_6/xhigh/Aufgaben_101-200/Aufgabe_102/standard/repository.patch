+    def get_locally_reachable_ips(self, ip_path):
+        """Return the destinations of Linux host-scoped routes, by address family."""
+        reachable = {'ipv4': [], 'ipv6': []}
+
+        for family, version in (('ipv4', '4'), ('ipv6', '6')):
+            if version == '6' and not socket.has_ipv6:
+                self.module.warn('Cannot gather locally reachable IPv6 IPs: IPv6 is unavailable')
+                continue
+
+            command = [ip_path, '-' + version, 'route', 'show', 'table', 'all', 'scope', 'host']
+            try:
+                rc, output, stderr = self.module.run_command(command, errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Cannot gather locally reachable IPv%s IPs: route query failed' % version)
+                continue
+
+            routes = set()
+            for line in (output or '').splitlines():
+                words = line.split()
+                if not words:
+                    continue
+                # IPv6 local routes may omit the redundant "scope host" text.
+                if words[0] == 'local':
+                    destination = words[1] if len(words) > 1 else ''
+                elif any(words[i:i + 2] == ['scope', 'host'] for i in range(len(words) - 1)):
+                    destination = words[0]
+                else:
+                    continue
+                try:
+                    network = ipaddress.ip_network(destination, strict=False)
+                except ValueError:
+                    continue
+                if network.version == int(version):
+                    routes.add(network)
+
+            for network in sorted(routes, key=lambda route: (int(route.network_address), route.prefixlen)):
+                if network.prefixlen == network.max_prefixlen:
+                    reachable[family].append(str(network.network_address))
+                else:
+                    reachable[family].append(str(network))
+
+        return reachable
+
