+package types
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDeduplicateDatabaseServers(t *testing.T) {
+	first := NewDatabaseServerV3("first", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	second := NewDatabaseServerV3("second", nil, DatabaseServerSpecV3{HostID: "host-2"})
+	duplicate := NewDatabaseServerV3("first", nil, DatabaseServerSpecV3{HostID: "host-3"})
+	input := []DatabaseServer{first, second, duplicate}
+
+	got := DeduplicateDatabaseServers(input)
+	if len(got) != 2 || got[0] != first || got[1] != second {
+		t.Fatalf("unexpected deduplicated servers: %v", got)
+	}
+	got[0] = duplicate
+	if input[0] != first {
+		t.Fatal("deduplicated slice changed the input")
+	}
+}
+
+func TestSortedDatabaseServers(t *testing.T) {
+	servers := []DatabaseServer{
+		NewDatabaseServerV3("beta", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+		NewDatabaseServerV3("alpha", nil, DatabaseServerSpecV3{HostID: "host-2"}),
+		NewDatabaseServerV3("alpha", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+	}
+	sort.Sort(SortedDatabaseServers(servers))
+	if servers[0].GetName() != "alpha" || servers[0].GetHostID() != "host-1" ||
+		servers[1].GetName() != "alpha" || servers[1].GetHostID() != "host-2" ||
+		servers[2].GetName() != "beta" {
+		t.Fatalf("unexpected sort order: %v", servers)
+	}
+}
+
+func TestDatabaseServerStringIncludesHostID(t *testing.T) {
+	server := NewDatabaseServerV3("postgres", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	if !strings.Contains(server.String(), "HostID=host-1") {
+		t.Fatalf("server string %q does not include host ID", server.String())
+	}
+}
