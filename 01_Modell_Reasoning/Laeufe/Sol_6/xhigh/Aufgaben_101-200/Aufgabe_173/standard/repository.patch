+// TestProxyDatabaseServerFailover verifies that an unavailable service tunnel
+// does not prevent access through another server for the same database.
+func TestProxyDatabaseServerFailover(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+	healthy := testCtx.postgres["postgres"].server
+	offline := healthy.Copy().(*types.DatabaseServerV3)
+	offline.Spec.HostID = "0-offline"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, offline)
+	require.NoError(t, err)
+	_, candidates, err := testCtx.proxyServer.pickDatabaseServers(ctx, tlsca.Identity{
+		RouteToCluster: testCtx.clusterName,
+		RouteToDatabase: tlsca.RouteToDatabase{
+			ServiceName: "postgres",
+		},
+	})
+	require.NoError(t, err)
+	require.Len(t, candidates, 2)
+
+	// Ensure the unavailable tunnel is attempted before the healthy one.
+	testCtx.proxyServer.cfg.Shuffle = func(servers []types.DatabaseServer) []types.DatabaseServer {
+		sort.Sort(types.SortedDatabaseServers(servers))
+		return servers
+	}
+	testCtx.remoteSite.OfflineTunnels = map[string]bool{
+		offline.GetHostID() + "." + testCtx.clusterName: true,
+	}
+	go testCtx.startHandlingConnections()
+
+	psql, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.NoError(t, err)
+	require.NoError(t, psql.Close(ctx))
+
+	// When every tunnel is offline the proxy reports the exhausted candidates.
+	testCtx.remoteSite.OfflineTunnels[healthy.GetHostID()+"."+testCtx.clusterName] = true
+	_, err = testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "failed to connect to any database service")
+}
