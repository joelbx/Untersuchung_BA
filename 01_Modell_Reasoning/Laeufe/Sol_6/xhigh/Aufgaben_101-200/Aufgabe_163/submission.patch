+func TestDatabaseConnectionURL(t *testing.T) {
+	tests := []struct {
+		name    string
+		db      DatabaseConfig
+		want    string
+		wantErr string
+	}{
+		{"url precedence", DatabaseConfig{URL: "file:existing.db", Protocol: MySQL, Host: "ignored", Password: "secret"}, "file:existing.db", ""},
+		{"postgres defaults and escaping", DatabaseConfig{Protocol: Postgres, Host: "db.local", User: "alice", Password: "a@b:c", Name: "flipt"}, "postgres://alice:a%40b%3Ac@db.local:5432/flipt", ""},
+		{"mysql port", DatabaseConfig{Protocol: MySQL, Host: "db.local", Port: 3307, User: "alice", Name: "flipt"}, "mysql://alice@db.local:3307/flipt", ""},
+		{"sqlite path", DatabaseConfig{Protocol: SQLite, Path: "/var/data", Name: "flipt.db"}, "file:///var/data/flipt.db", ""},
+		{"protocol missing", DatabaseConfig{Name: "flipt", Host: "localhost"}, "", "db.protocol"},
+		{"name missing", DatabaseConfig{Protocol: Postgres, Host: "localhost"}, "", "db.name"},
+		{"host missing", DatabaseConfig{Protocol: MySQL, Name: "flipt"}, "", "db.host"},
+		{"sqlite path missing", DatabaseConfig{Protocol: SQLite, Name: "flipt.db"}, "", "db.host or db.path"},
+		{"invalid numeric protocol", DatabaseConfig{Protocol: 99, Host: "localhost", Name: "flipt"}, "", "db.protocol"},
+		{"invalid port", DatabaseConfig{Protocol: MySQL, Host: "localhost", Name: "flipt", Port: 65536}, "", "db.port"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.db.ConnectionURL()
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadDatabaseModes(t *testing.T) {
+	for _, tt := range []struct {
+		name, contents, wantURL, wantErr string
+		wantProtocol                     DatabaseProtocol
+	}{
+		{"fields", "db:\n  protocol: postgres\n  host: db.local\n  user: alice\n  password: secret\n  name: flipt\n", "", "", Postgres},
+		{"URL wins", "db:\n  url: file:existing.db\n  protocol: mysql\n  name: ignored\n", "file:existing.db", "", MySQL},
+		{"invalid protocol", "db:\n  protocol: oracle\n  host: db.local\n  name: flipt\n", "", "db.protocol: invalid value \"oracle\"", 0},
+		{"invalid port", "db:\n  protocol: postgres\n  host: db.local\n  name: flipt\n  port: wrong\n", "", "db.port: invalid value \"wrong\"", 0},
+		{"missing field", "db:\n  protocol: mysql\n  name: flipt\n", "", "db.host", 0},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			f, err := ioutil.TempFile("", "flipt-config-*.yml")
+			require.NoError(t, err)
+			defer os.Remove(f.Name())
+			_, err = f.WriteString(tt.contents)
+			require.NoError(t, err)
+			require.NoError(t, f.Close())
+			cfg, err := Load(f.Name())
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantURL, cfg.Database.URL)
+			assert.Equal(t, tt.wantProtocol, cfg.Database.Protocol)
+		})
+	}
+}
