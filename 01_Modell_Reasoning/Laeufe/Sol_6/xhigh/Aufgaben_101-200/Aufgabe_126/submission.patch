+import { prepareContentToModel } from './input';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+
+const createDOM = (html: string) => {
+    const dom = document.implementation.createHTMLDocument();
+    dom.body.innerHTML = html;
+    return dom;
+};
+
+describe('assistant Markdown conversion', () => {
+    it('moves sibling nested lists into the preceding list item', () => {
+        const dom = createDOM('<ul><li>First</li><ul><li>Child</li></ul><li>Last</li></ul>');
+
+        fixNestedLists(dom);
+
+        expect(dom.querySelector('ul > ul')).toBeNull();
+        expect(dom.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+        expect(dom.querySelectorAll('ul > li')).toHaveLength(3);
+
+        const roundTrip = createDOM(markdownToHTML(htmlToMarkdown(dom)));
+        expect(roundTrip.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    });
+
+    it('keeps ordered and nested list markers through HTML and Markdown', () => {
+        const markdown = htmlToMarkdown(createDOM('<ol><li>First<ul><li>Child</li></ul></li><li>Second</li></ol>'));
+        const html = createDOM(markdownToHTML(markdown));
+
+        expect(markdown).toMatch(/1\. First/);
+        expect(markdown).toMatch(/2\. Second/);
+        expect(html.querySelector('ol > li > ul > li')?.textContent).toBe('Child');
+        expect(html.querySelectorAll('ol > li')).toHaveLength(2);
+    });
+
+    it('keeps list items together across blank lines', () => {
+        const html = createDOM(markdownToHTML('1. First\n\n2. Second'));
+
+        expect(html.querySelectorAll('ol')).toHaveLength(1);
+        expect(html.querySelectorAll('ol > li')).toHaveLength(2);
+    });
+
+    it('keeps link and image formatting across model preparation and result parsing', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://example.com" class="link" style="color: red">Text</a>' +
+                '<img src="https://example.com/image.png" class="image" style="width: 20px">',
+            'uid',
+            'message-1'
+        );
+        const html = createDOM(parseModelResult(markdown, 'message-1'));
+
+        expect(markdown).not.toContain('https://example.com');
+        expect(html.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+        expect(html.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(html.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(html.querySelector('img')?.getAttribute('src')).toBe('https://example.com/image.png');
+        expect(html.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(html.querySelector('img')?.getAttribute('style')).toBe('width: 20px');
+
+        const otherMessage = createDOM(parseModelResult(markdown, 'message-2'));
+        expect(otherMessage.querySelector('a, img')).toBeNull();
+        expect(otherMessage.body.textContent).toContain('Text');
+    });
+
+    it('renders headings, fenced code, and blockquotes', () => {
+        const html = createDOM(markdownToHTML('# Heading\n\n```\n  aligned\n```\n\n> Quote'));
+        expect(html.querySelector('h1')?.textContent).toBe('Heading');
+        expect(html.querySelector('pre code')?.textContent).toContain('  aligned');
+        expect(html.querySelector('blockquote')?.textContent).toContain('Quote');
+    });
+
+    it('preserves list-like text and alignment inside code blocks', () => {
+        const markdown = htmlToMarkdown(createDOM('<pre><code>-   aligned\n  second</code></pre>'));
+
+        expect(markdown).toContain('-   aligned');
+        expect(createDOM(markdownToHTML(markdown)).querySelector('pre code')?.textContent).toContain('-   aligned');
+    });
+});
