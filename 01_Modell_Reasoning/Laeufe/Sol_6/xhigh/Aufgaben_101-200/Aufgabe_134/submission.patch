diff --git a/openlibrary/tests/test_book_providers_runeberg.py b/openlibrary/tests/test_book_providers_runeberg.py
new file mode 100644
index 0000000..789713c
--- /dev/null
+++ b/openlibrary/tests/test_book_providers_runeberg.py
@@ -0,0 +1,52 @@
+from pathlib import Path
+
+from web.template import Template
+
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+    is_non_ia_ocaid,
+)
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.get_identifiers(
+        {'identifiers': {'project_runeberg': ['book-one', 'book-two']}}
+    ) == ['book-one', 'book-two']
+    assert provider.is_own_ocaid('archive_runeberg_scan')
+    assert not provider.is_own_ocaid('unrelated_scan')
+    assert is_non_ia_ocaid('archive_runeberg_scan')
+
+    acquisitions = provider.get_acquisitions(
+        {'identifiers': {'project_runeberg': ['book-one', 'book-two']}}
+    )
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].price is None
+    assert acquisitions[0].url == 'https://runeberg.org/book-one/'
+    assert acquisitions[0].provider_name == 'runeberg'
+
+
+def test_project_runeberg_templates():
+    template_dir = Path(__file__).parents[1] / 'templates' / 'book_providers'
+    globals = {'_': lambda text: text, 'render_once': lambda key: True}
+    read_button = Template(
+        (template_dir / 'runeberg_read_button.html').read_text(), globals=globals
+    )
+    download_options = Template(
+        (template_dir / 'runeberg_download_options.html').read_text(), globals=globals
+    )
+
+    read_html = str(read_button('book-one', lambda action: f'data-action="{action}"'))
+    assert 'href="https://runeberg.org/book-one/"' in read_html
+    assert 'data-action="Read"' in read_html
+    assert 'Nordic literary works' in read_html
+    assert 'data-action=' not in str(read_button('book-one'))
+
+    download_html = str(download_options('book-one'))
+    assert 'https://runeberg.org/book-one/download.html' in download_html
+    for label in ('Scanned images', 'Color images', 'HTML', 'Text files', 'OCR content'):
+        assert label in download_html
