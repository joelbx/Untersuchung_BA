diff --git a/tests/unit/browser/webengine/test_webengine_certificateerror.py b/tests/unit/browser/webengine/test_webengine_certificateerror.py
new file mode 100644
index 0000000..3e69eed
--- /dev/null
+++ b/tests/unit/browser/webengine/test_webengine_certificateerror.py
@@ -0,0 +1,53 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Tests for QtWebEngine certificate error decisions."""
+
+import pytest
+
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+@pytest.mark.parametrize('qt6, wrapper_type', [
+    (False, certificateerror.CertificateErrorWrapperQt5),
+    (True, certificateerror.CertificateErrorWrapperQt6),
+])
+def test_create_selects_qt_version(monkeypatch, mocker, qt6, wrapper_type):
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', qt6)
+    error = mocker.Mock()
+    wrapper = certificateerror.create(error)
+    assert isinstance(wrapper, wrapper_type)
+    assert not wrapper.certificate_was_accepted()
+    assert error.mock_calls == []
+
+
+def test_qt5_decisions(mocker):
+    error = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapperQt5(error)
+
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    assert wrapper.ignore
+
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    assert not wrapper.ignore
+    with pytest.raises(usertypes.UndeferrableError):
+        wrapper.defer()
+    assert error.mock_calls == []
+
+
+def test_qt6_decisions(mocker):
+    error = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapperQt6(error)
+
+    wrapper.defer()
+    error.defer.assert_called_once_with()
+
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    error.acceptCertificate.assert_called_once_with()
+
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    error.rejectCertificate.assert_called_once_with()
