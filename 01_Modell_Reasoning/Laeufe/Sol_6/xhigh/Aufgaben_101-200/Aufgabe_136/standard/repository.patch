 ])
 def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+def test_reply_constructor_and_decision(mocker):
+    reply = mocker.Mock()
+    errors = [FakeError('bad certificate')]
+    wrapper = certificateerror.CertificateErrorWrapper(reply=reply, errors=errors)
+
+    assert reply.mock_calls == []
+    assert wrapper.html() == '<p>bad certificate</p>'
+    assert not wrapper.certificate_was_accepted()
+
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    reply.ignoreSslErrors.assert_called_once_with()
+
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    reply.ignoreSslErrors.assert_called_once_with()
+
+
+def test_errors_only_keyword_constructor():
+    wrapper = certificateerror.CertificateErrorWrapper(
+        errors=[FakeError('certificate error')])
+    assert wrapper.html() == '<p>certificate error</p>'
+
+
+def test_reply_and_errors_positional_constructor(mocker):
+    reply = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply, [FakeError('certificate error')])
+    assert wrapper.html() == '<p>certificate error</p>'
+    assert reply.mock_calls == []
