+
+class CertificateErrorWrapperQt5(CertificateErrorWrapper):
+
+    """Certificate decision returned by the Qt 5 page callback."""
+
+    @property
+    def ignore(self) -> bool:
+        return self.certificate_was_accepted()
+
+    @ignore.setter
+    def ignore(self, value: bool) -> None:
+        if value:
+            self.accept_certificate()
+        else:
+            self.reject_certificate()
+
+
+class CertificateErrorWrapperQt6(CertificateErrorWrapper):
+
+    """Certificate decision made on the Qt 6 error object."""
+
+    def accept_certificate(self) -> None:
+        self._error.acceptCertificate()
+        super().accept_certificate()
+
+    def reject_certificate(self) -> None:
+        self._error.rejectCertificate()
+        super().reject_certificate()
+
+    def defer(self) -> None:
+        self._error.defer()
+
+
+def create(error: QWebEngineCertificateError) -> CertificateErrorWrapper:
+    """Wrap a certificate error for the active Qt major version."""
+    wrapper_class = (CertificateErrorWrapperQt6 if machinery.IS_QT6
+                     else CertificateErrorWrapperQt5)
+    return wrapper_class(error)
