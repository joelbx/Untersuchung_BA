+    ])
+    @pytest.mark.parametrize('overlay', [True, False])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch, parser,
+                                         enable_source, disable_source, overlay):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+
+        enabled = ['enable-features=First,Second', 'enable-features=Third']
+        disabled = ['disable-features=BlockedA,BlockedB',
+                    'disable-features=BlockedC']
+        commandline = ([] if enable_source == 'config' else enabled) + (
+            [] if disable_source == 'config' else disabled)
+        config_stub.val.qt.args = (
+            ([] if enable_source == 'commandline' else enabled) +
+            ([] if disable_source == 'commandline' else disabled))
+
+        parsed = parser.parse_args([
+            arg for flag in commandline for arg in ('--qt-flag', flag)])
+        args = qtargs.qt_args(parsed)
+
+        assert qtargs.ENABLE_FEATURES_PREFIX == '--enable-features='
+        assert qtargs.DISABLE_FEATURES_PREFIX == '--disable-features='
+        expected_enabled = 'First,Second,Third'
+        if overlay:
+            expected_enabled += ',OverlayScrollbar'
+        assert [arg for arg in args
+                if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)] == [
+                    qtargs.ENABLE_FEATURES_PREFIX + expected_enabled]
+        assert [arg for arg in args
+                if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)] == [
+                    qtargs.DISABLE_FEATURES_PREFIX + 'BlockedA,BlockedB',
+                    qtargs.DISABLE_FEATURES_PREFIX + 'BlockedC']
+
