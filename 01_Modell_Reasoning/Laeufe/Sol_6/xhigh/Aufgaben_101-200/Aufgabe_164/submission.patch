+func TestImport_JSONCommentOnlyOnFirstLine(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		enc   Encoding
+		input string
+		valid bool
+	}{
+		{name: "one leading JSON comment", enc: EncodingJSON, input: "# header\n{}", valid: true},
+		{name: "second JSON comment", enc: EncodingJSON, input: "# first\n# second\n{}"},
+		{name: "JSON comment after whitespace", enc: EncodingJSON, input: " # header\n{}"},
+		{name: "YAML comment", enc: EncodingYML, input: "# header\n{}", valid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := NewImporter(&mockCreator{}).Import(context.Background(), tc.enc, strings.NewReader(tc.input), false)
+			if tc.valid {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, "unmarshalling document")
+			}
+		})
+	}
+}
