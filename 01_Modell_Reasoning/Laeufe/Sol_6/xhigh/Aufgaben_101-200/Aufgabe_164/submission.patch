+func TestImport_ExportedNestedMetadata(t *testing.T) {
+	metadata := map[string]any{
+		"settings": map[string]any{
+			"targets": []any{
+				map[string]any{"region": "west", "enabled": true},
+				map[string]any{"region": "east", "weight": float64(2)},
+			},
+		},
+	}
+	attachment := `{"options":[{"label":"first","values":{"a":1}},null]}`
+	lister := mockLister{
+		namespaces: map[string]*flipt.Namespace{
+			"0_team": {Key: "team", Name: "Team", Description: "Team flags"},
+		},
+		nsToFlags: map[string][]*flipt.Flag{
+			"team": {{
+				Key: "feature", Name: "Feature", NamespaceKey: "team",
+				Type:     flipt.FlagType_VARIANT_FLAG_TYPE,
+				Metadata: newStruct(t, metadata),
+				Variants: []*flipt.Variant{{Key: "choice", Attachment: attachment}},
+			}},
+		},
+	}
+
+	for _, tc := range []struct {
+		name   string
+		enc    Encoding
+		header string
+	}{
+		{name: "YML export", enc: EncodingYML},
+		{name: "YML export with header", enc: EncodingYML, header: "# exported by Flipt\n\n"},
+		{name: "YAML export", enc: EncodingYAML},
+		{name: "JSON export", enc: EncodingJSON},
+		{name: "JSON export with header", enc: EncodingJSON, header: "# exported by Flipt\n\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var exported bytes.Buffer
+			require.NoError(t, NewExporter(lister, "", true, false).Export(context.Background(), tc.enc, &exported))
+
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "namespace missing")}
+			input := strings.NewReader(tc.header + exported.String())
+			require.NoError(t, NewImporter(creator).Import(context.Background(), tc.enc, input, false))
+
+			require.Len(t, creator.getNSReqs, 1)
+			assert.Equal(t, "team", creator.getNSReqs[0].Key)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{
+				Key: "team", Name: "Team", Description: "Team flags",
+			}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, metadata, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, attachment, creator.variantReqs[0].Attachment)
+		})
+	}
+}
