 var releasePattern = regexp.MustCompile(`(.*) release (\d[\d\.]*)`)
 
+// rpm's query format separates columns with one space. A missing release leaves
+// two adjacent separators, so splitting on runs of whitespace loses that column.
+var rpmPackageLinePattern = regexp.MustCompile(`^\s*(\S+)\s+(\S+)\s+(\S+)\s(\S*)\s+(\S+)\s+(\S+)(?:\s+(\S+))?\s*$`)
+var rpmUpdatableLinePattern = regexp.MustCompile(`^\s*(\S+)\s+(\S+)\s+(\S+)\s(\S*)\s+(\S+(?:\s+\S+)*)\s*$`)
+
+func rpmPackageLineFields(line string) []string {
+	fields := rpmPackageLinePattern.FindStringSubmatch(line)
+	if fields == nil {
+		return nil
+	}
+	if fields[7] == "" {
+		return fields[1:7]
+	}
+	return fields[1:8]
+}
+
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
