+++ b/scanner/redhatbase_parsing_test.go
@@ -0,0 +1,142 @@
+package scanner
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/logging"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRPMInstalledPackageEmptyRelease(t *testing.T) {
+	for _, tc := range []struct {
+		name, epoch, release, version, srcVersion string
+	}{
+		{"zero empty", "0", "", "1", "1"},
+		{"none empty", "(none)", "", "1", "1"},
+		{"epoch empty", "2", "", "2:1", "2:1"},
+		{"zero release", "0", "3", "1", "1-3"},
+		{"none release", "(none)", "3", "1", "1-3"},
+		{"epoch release", "2", "3", "2:1", "2:1-3"},
+	} {
+		for _, repoquery := range []bool{false, true} {
+			t.Run(tc.name+map[bool]string{false: " rpm", true: " repoquery"}[repoquery], func(t *testing.T) {
+				line := "sample " + tc.epoch + " 1 " + tc.release + " x86_64 sample-1-" + tc.release + ".src.rpm"
+				if repoquery {
+					line += " @updates"
+				}
+				o := &redhatBase{}
+				var pkg *models.Package
+				var src *models.SrcPackage
+				var err error
+				if repoquery {
+					pkg, src, err = o.parseInstalledPackagesLineFromRepoquery(line)
+				} else {
+					pkg, src, err = o.parseInstalledPackagesLine(line)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				wantPkg := &models.Package{Name: "sample", Version: tc.version, Release: tc.release, Arch: "x86_64"}
+				if repoquery {
+					wantPkg.Repository = "updates"
+				}
+				wantSrc := &models.SrcPackage{Name: "sample", Version: tc.srcVersion, Arch: "src", BinaryNames: []string{"sample"}}
+				if !reflect.DeepEqual(pkg, wantPkg) || !reflect.DeepEqual(src, wantSrc) {
+					t.Errorf("got package %#v, source %#v; want package %#v, source %#v", pkg, src, wantPkg, wantSrc)
+				}
+			})
+		}
+	}
+}
+
+func TestRPMInstalledPackagesEmptyRelease(t *testing.T) {
+	for _, tc := range []struct {
+		name, family, release, stdout, repository string
+	}{
+		{"rpm -qa", constant.CentOS, "9", "sample 0 1  x86_64 sample-1--src.rpm\n", ""},
+		{"Amazon 2 rpm -qa", constant.Amazon, "2 (Karoo)", "sample 0 1  x86_64 sample-1--src.rpm\n", ""},
+		{"Amazon 2 repoquery", constant.Amazon, "2 (Karoo)", "sample 0 1  x86_64 sample-1--src.rpm @amzn2-core\n", "amzn2-core"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := &redhatBase{base: base{Distro: config.Distro{Family: tc.family, Release: tc.release}, log: logging.NewIODiscardLogger()}}
+			bins, srcs, err := o.parseInstalledPackages(tc.stdout)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantBins := models.Packages{"sample": {Name: "sample", Version: "1", Arch: "x86_64", Repository: tc.repository}}
+			wantSrcs := models.SrcPackages{"sample": {Name: "sample", Version: "1", Arch: "src", BinaryNames: []string{"sample"}}}
+			if !reflect.DeepEqual(bins, wantBins) || !reflect.DeepEqual(srcs, wantSrcs) {
+				t.Errorf("got packages %#v, sources %#v; want packages %#v, sources %#v", bins, srcs, wantBins, wantSrcs)
+			}
+		})
+	}
+}
+
+func TestSplitFileNameSourceVariants(t *testing.T) {
+	for _, tc := range []struct {
+		filename, name, version, release, epoch, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "", "src"},
+		{"package-0--src.rpm", "package", "0", "", "", "src"},
+		{"package-0-1.src.rpm", "package", "0", "1", "", "src"},
+		{"package-0-.src.rpm", "package", "0", "", "", "src"},
+		{"1:package-name-0-1.src.rpm", "package-name", "0", "1", "1", "src"},
+	} {
+		t.Run(tc.filename, func(t *testing.T) {
+			name, version, release, epoch, arch, err := splitFileName(tc.filename)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if name != tc.name || version != tc.version || release != tc.release || epoch != tc.epoch || arch != tc.arch {
+				t.Errorf("got %q, %q, %q, %q, %q", name, version, release, epoch, arch)
+			}
+		})
+	}
+	for _, filename := range []string{
+		"package-0-1-src", "package-0-src.rpm", "-0-1-src.rpm", "package--1-src.rpm",
+		"package--0-1.src.rpm", "package--part-0-1.src.rpm", "-package-0-1.src.rpm",
+		"package-0-1-.rpm", "bad:package-0-1.src.rpm", "package-0-1.bad-arch.rpm",
+	} {
+		t.Run("invalid "+filename, func(t *testing.T) {
+			if _, _, _, _, _, err := splitFileName(filename); err == nil {
+				t.Fatal("expected an error")
+			}
+		})
+	}
+}
+
+func TestRPMUpdatablePackages(t *testing.T) {
+	for _, tc := range []struct {
+		name, input string
+		want        models.Packages
+	}{
+		{
+			"CentOS", "plain 0 1 2 base\nepoch 3 4 5 updates\nempty (none) 6  updates\n",
+			models.Packages{
+				"plain": {Name: "plain", NewVersion: "1", NewRelease: "2", Repository: "base"},
+				"epoch": {Name: "epoch", NewVersion: "3:4", NewRelease: "5", Repository: "updates"},
+				"empty": {Name: "empty", NewVersion: "6", Repository: "updates"},
+			},
+		},
+		{
+			"Amazon", "Loading packages\njava-1.7.0-openjdk  0 1.7.0.95 2.6.4 amzn-main\nbind-libs 32 9.8.2 0.37 amzn-main\n",
+			models.Packages{
+				"java-1.7.0-openjdk": {Name: "java-1.7.0-openjdk", NewVersion: "1.7.0.95", NewRelease: "2.6.4", Repository: "amzn-main"},
+				"bind-libs":          {Name: "bind-libs", NewVersion: "32:9.8.2", NewRelease: "0.37", Repository: "amzn-main"},
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := (&redhatBase{}).parseUpdatablePacksLines(tc.input)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, tc.want) {
+				t.Errorf("got %#v, want %#v", got, tc.want)
+			}
+		})
+	}
+}
