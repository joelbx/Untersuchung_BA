+def test_load_data_keeps_roles_on_work_authors(mock_site):
+    rec = {
+        'title': 'Roles in a work',
+        'source_records': ['marc:roles'],
+        'authors': [
+            {'name': 'Example, Alice', 'role': 'Editor'},
+            {'name': 'Example, Bob', 'role': 'Translator'},
+        ],
+    }
+
+    reply = load_data(rec)
+    work = mock_site.get(reply['work']['key'])
+    assert [a['role'] for a in work['authors']] == ['Editor', 'Translator']
+    assert [a['author']['key'] for a in work['authors']] == [
+        reply['authors'][0]['key'],
