+def match_current_rt(rt, direction, current, rt_commands):
+    """Update pending changes for one import or export route-target."""
+    command = 'route-target %s %s' % (direction, rt['rt'])
+    no_command = 'no %s' % command
+    present = command in set(line.strip() for line in (current or '').splitlines())
+    if rt['state'] == 'present':
+        if no_command in rt_commands:
+            rt_commands.remove(no_command)
+        if not present and command not in rt_commands:
+            rt_commands.append(command)
+    else:
+        if command in rt_commands:
+            rt_commands.remove(command)
+        if present and no_command not in rt_commands:
+            rt_commands.append(no_command)
+    return rt_commands
+
