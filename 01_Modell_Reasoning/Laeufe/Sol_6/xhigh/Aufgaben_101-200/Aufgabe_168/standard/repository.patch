+// A ref closes the gap before React renders the disabled buttons after an activation.
+function useAdminAction(): {
+    pending: boolean;
+    run: (operation: () => Promise<void>, errorTitle: string) => Promise<void>;
+} {
+    const [pending, setPending] = useState(false);
+    const locked = useRef(false);
+
+    const run = async (operation: () => Promise<void>, errorTitle: string): Promise<void> => {
+        if (locked.current) return;
+        locked.current = true;
+        setPending(true);
+        try {
+            await operation();
+        } catch (err) {
+            logger.error(errorTitle, err);
+            Modal.createDialog(ErrorDialog, {
+                title: errorTitle,
+                description: err instanceof Error && err.message ? err.message : _t("Operation failed"),
+            });
+        } finally {
+            locked.current = false;
+            setPending(false);
+        }
+    };
+
+    return { pending, run };
+}
+
+const AdminActionContext = React.createContext<ReturnType<typeof useAdminAction> | null>(null);
+
+const AdminActionProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
+    const action = useAdminAction();
+    return <AdminActionContext.Provider value={action}>{children}</AdminActionContext.Provider>;
+};
+
+function useMemberAdminAction(): ReturnType<typeof useAdminAction> {
+    const ownAction = useAdminAction();
+    return useContext(AdminActionContext) ?? ownAction;
+}
