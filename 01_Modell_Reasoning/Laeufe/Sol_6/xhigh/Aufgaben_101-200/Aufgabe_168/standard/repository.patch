+describe("member admin action pending state", () => {
+    let member: RoomMember;
+    let createDialogSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+        member = new RoomMember(defaultRoomId, defaultUserId);
+        member.membership = "join";
+        member.powerLevel = 0;
+        const me = new RoomMember(defaultRoomId, "@admin:example.com");
+        me.powerLevel = 100;
+        mockRoom.getMember.mockReturnValue(me);
+        mockRoom.currentState.getStateEvents.mockReturnValue(
+            mocked({ getContent: jest.fn().mockReturnValue({ events_default: 0 }) } as unknown as MatrixEvent),
+        );
+        Object.assign(mockClient, { kick: jest.fn(), ban: jest.fn(), setPowerLevel: jest.fn() });
+        createDialogSpy = jest.spyOn(Modal, "createDialog");
+    });
+
+    afterEach(() => createDialogSpy.mockReset());
+
+    const adminElement = (target: RoomMember) => (
+        <MatrixClientContext.Provider value={mockClient}>
+            <RoomAdminToolsContainer
+                room={mockRoom}
+                member={target}
+                powerLevels={{ events: { "m.room.power_levels": 1 }, events_default: 0 }}
+                startUpdating={jest.fn()}
+                stopUpdating={jest.fn()}
+            />
+        </MatrixClientContext.Provider>
+    );
+
+    const renderAdmin = (target: RoomMember) => render(adminElement(target));
+
+    const buttons = () => [
+        screen.getByRole("button", { name: "Mute" }),
+        screen.getByRole("button", { name: "Remove from room" }),
+        screen.getByRole("button", { name: "Ban from room" }),
+    ];
+
+    const expectPending = (pending: boolean) => {
+        for (const button of buttons()) {
+            if (pending) {
+                expect(button).toHaveAttribute("disabled");
+                expect(button).toHaveAttribute("aria-disabled", "true");
+            } else {
+                expect(button).not.toHaveAttribute("disabled");
+                expect(button).not.toHaveAttribute("aria-disabled");
+            }
+        }
+    };
+
+    it.each(["Remove from room", "Ban from room"])(
+        "locks all controls before confirming %s and until its operation settles",
+        async (label) => {
+            const confirmation = defer<[boolean]>();
+            const operation = defer<Awaited<ReturnType<MatrixClient["kick"]>>>();
+            createDialogSpy.mockReturnValue({ finished: confirmation.promise, close: jest.fn() });
+            mockClient.kick.mockReturnValue(operation.promise);
+            mockClient.ban.mockReturnValue(operation.promise);
+            renderAdmin(member);
+
+            const button = screen.getByRole("button", { name: label });
+            fireEvent.click(button);
+            expectPending(true);
+            fireEvent.click(button);
+            fireEvent.keyDown(button, { key: "Enter", code: "Enter" });
+            fireEvent.click(screen.getByRole("button", { name: "Mute" }));
+            expect(createDialogSpy).toHaveBeenCalledTimes(1);
+            expect(mockClient.setPowerLevel).not.toHaveBeenCalled();
+
+            await act(async () => confirmation.resolve([true]));
+            expectPending(true);
+            const call = label === "Remove from room" ? mockClient.kick : mockClient.ban;
+            expect(call).toHaveBeenCalledTimes(1);
+            fireEvent.click(button);
+            expect(call).toHaveBeenCalledTimes(1);
+
+            await act(async () => operation.resolve({}));
+            expectPending(false);
+        },
+    );
+
+    it("releases all controls after cancellation without sending an operation", async () => {
+        const confirmation = defer<[boolean]>();
+        createDialogSpy.mockReturnValue({ finished: confirmation.promise, close: jest.fn() });
+        renderAdmin(member);
+
+        fireEvent.click(screen.getByRole("button", { name: "Remove from room" }));
+        expectPending(true);
+        await act(async () => confirmation.resolve([false]));
+        expectPending(false);
+        expect(mockClient.kick).not.toHaveBeenCalled();
+        expect(mockClient.ban).not.toHaveBeenCalled();
+    });
+
+    it("does not carry a pending action over to another member", async () => {
+        const confirmation = defer<[boolean]>();
+        createDialogSpy.mockReturnValue({ finished: confirmation.promise, close: jest.fn() });
+        const view = renderAdmin(member);
+
+        fireEvent.click(screen.getByRole("button", { name: "Remove from room" }));
+        expectPending(true);
+
+        const otherMember = new RoomMember(defaultRoomId, "@other:example.com");
+        otherMember.membership = "join";
+        otherMember.powerLevel = 0;
+        view.rerender(adminElement(otherMember));
+        expectPending(false);
+
+        await act(async () => confirmation.resolve([false]));
+        expectPending(false);
+    });
+
+    it("runs mute once and recovers from a failed operation with one error", async () => {
+        const operation = defer<Awaited<ReturnType<MatrixClient["setPowerLevel"]>>>();
+        mockClient.setPowerLevel.mockReturnValue(operation.promise);
+        createDialogSpy.mockReturnValue({ close: jest.fn() });
+        renderAdmin(member);
+
+        const mute = screen.getByRole("button", { name: "Mute" });
+        fireEvent.click(mute);
+        expectPending(true);
+        fireEvent.click(mute);
+        fireEvent.click(screen.getByRole("button", { name: "Ban from room" }));
+        expect(mockClient.setPowerLevel).toHaveBeenCalledTimes(1);
+        expect(createDialogSpy).not.toHaveBeenCalled();
+
+        await act(async () => operation.reject(new Error("Server refused")));
+        expectPending(false);
+        expect(createDialogSpy).toHaveBeenCalledTimes(1);
+        expect(createDialogSpy).toHaveBeenCalledWith(
+            ErrorDialog,
+            expect.objectContaining({ title: "Failed to mute user", description: "Server refused" }),
+        );
+    });
+});
+
 describe("disambiguateDevices", () => {
     it("does not add ambiguous key to unique names", () => {
         const initialDevices = [
