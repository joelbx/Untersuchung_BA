+def test_get_pip_uses_virtualenv(mocker, tmp_path):
+    module = mocker.Mock()
+    venv_bin = tmp_path / 'bin'
+    venv_bin.mkdir()
+    basename = 'pip3' if PY3 else 'pip2'
+    (venv_bin / basename).touch(mode=0o755)
+    have_pip = mocker.patch.object(pip, '_have_pip_module', return_value=True)
