+@pytest.mark.parametrize('responses, expected_command, expected_output, expected_error', [
+    ([(0, 'foo==1.0\n', '')], 'list --format=freeze', 'foo==1.0\n', ''),
+    ([(1, '', 'unknown option'), (0, 'foo==1.0\n', 'warning')], 'freeze', 'foo==1.0\n', 'warning'),
+])
+def test_get_packages_with_module_launcher(mocker, responses, expected_command, expected_output, expected_error):
+    module = mocker.Mock()
+    module.run_command.side_effect = responses
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+    launcher = [sys.executable, '-m', 'pip']
+
+    command, stdout, stderr = pip._get_packages(module, launcher, '/tmp')
+
+    assert command == ' '.join(launcher + expected_command.split())
+    assert stdout == expected_output
+    assert stderr == expected_error
+    assert module.run_command.call_args[0][0] == launcher + expected_command.split()
+
+
+def test_get_packages_reports_final_command_on_failure(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(1, '', 'unknown option'), (1, '', 'freeze failed')]
+    module.fail_json.side_effect = RuntimeError('pip failed')
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    with pytest.raises(RuntimeError):
+        pip._get_packages(module, [sys.executable, '-m', 'pip'], '/tmp')
+
+    assert module.fail_json.call_args[1]['cmd'] == '%s -m pip freeze' % sys.executable
+
+
+def test_have_pip_module(mocker):
+    find_spec = mocker.patch('importlib.util.find_spec', return_value=object())
+    assert pip._have_pip_module()
+
+    find_spec.return_value = None
+    assert not pip._have_pip_module()
+
+    find_spec.side_effect = RuntimeError('finder failed')
+    assert not pip._have_pip_module()
+
+
+def test_have_pip_module_legacy_fallback(mocker):
+    find_loader = mocker.patch('pkgutil.find_loader', return_value=object())
+    with patch.dict(sys.modules, {'importlib.util': None}):
+        assert pip._have_pip_module()
+        find_loader.side_effect = RuntimeError('finder failed')
+        assert not pip._have_pip_module()
+
