+func TestEnsureUUIDsImageName(t *testing.T) {
+	tests := []struct {
+		name  string
+		image models.Image
+		key   string
+	}{
+		{"tag", models.Image{Name: "repo/app", Tag: "latest"}, "repo/app:latest@0@host"},
+		{"digest", models.Image{Name: "repo/app", Digest: "sha256:abc"}, "repo/app@sha256:abc@0@host"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			original := config.Conf
+			defer func() { config.Conf = original }()
+			config.Conf = config.Config{Servers: map[string]config.ServerInfo{
+				"0@host": {UUIDs: map[string]string{tt.key: defaultUUID}},
+			}}
+
+			dir, err := ioutil.TempDir("", "vuls-image-uuid-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer os.RemoveAll(dir)
+			path := filepath.Join(dir, "config.toml")
+			if err := ioutil.WriteFile(path, nil, 0600); err != nil {
+				t.Fatal(err)
+			}
+
+			results := models.ScanResults{{ServerName: "0@host", Image: tt.image}}
+			if err := EnsureUUIDs(path, results); err != nil {
+				t.Fatal(err)
+			}
+			if results[0].ServerUUID != defaultUUID {
+				t.Errorf("image UUID = %q, want existing UUID %q", results[0].ServerUUID, defaultUUID)
+			}
+		})
+	}
+}
