+		image Image
+		want  string
+	}{
+		{"missing name", Image{Tag: "latest"}, "Invalid arguments : no image name"},
+		{"missing identifier", Image{Name: "repo/app"}, "Invalid arguments : no image tag and digest"},
+		{"conflicting identifiers", Image{Name: "repo/app", Tag: "latest", Digest: "sha256:abc"}, "Invalid arguments : you can either set image tag or digest"},
