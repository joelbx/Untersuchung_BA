+def test_legacy_member_cannot_be_repointed_to_incomplete_zip(archive_db, tmp_path):
+    source = tmp_path / 'source.jpg'
+    source.write_bytes(b'jpeg')
+    manager = archive.ZipManager()
+    for size in archive.SIZES:
+        suffix = f'-{size.upper()}' if size else ''
+        manager.add_file(f'0008800123{suffix}.jpg', str(source), 1_700_000_000)
+    manager.close()
+    archive_db.insert('cover', id=8_800_123, archived=True, failed=False, uploaded=False)
+    archive_db.insert('cover', id=8_800_124, archived=True, failed=False, uploaded=False, filename='covers_0008_80.tar:0:4')
+    archive_db.insert('cover', id=8_810_000, archived=True, failed=False, uploaded=True)
+    uploader = FakeUploader()
+    with pytest.raises(RuntimeError, match='missing 1 archived covers'):
+        archive.Batch(8, 80).process_pending(upload=True, test=False, uploader=uploader)
+    assert not uploader.calls
+
