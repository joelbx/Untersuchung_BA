+def test_reconcile_verified_legacy_tar_batch(archive_db):
+    cover_id = 8_800_123
+    filenames = {}
+    uploader = FakeUploader()
+    for size in archive.SIZES:
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_0008'
+        stem = f'{item}_80'
+        field = f'filename_{size}' if size else 'filename'
+        filenames[field] = f'{stem}.tar:100:4'
+        uploader.files.add((item, f'{stem}.tar'))
+        uploader.files.add((item, f'{stem}.index'))
+    archive_db.insert('cover', id=cover_id, archived=True, failed=False, uploaded=False, **filenames)
+    archive_db.insert('cover', id=8_810_000, archived=True, failed=False, uploaded=True)
+    batch = archive.Batch(8, 80)
+    assert batch.reconcile_legacy(uploader=uploader) == 1
+    assert not archive_db.select('cover', where='id=$id', vars={'id': cover_id})[0].uploaded
+    uploader.files.remove(('s_covers_0008', 's_covers_0008_80.index'))
+    with pytest.raises(RuntimeError, match='missing remote'):
+        batch.reconcile_legacy(test=False, uploader=uploader)
+    uploader.files.add(('s_covers_0008', 's_covers_0008_80.index'))
+    assert batch.reconcile_legacy(test=False, uploader=uploader) == 1
+    completed = archive_db.select('cover', where='id=$id', vars={'id': cover_id})[0]
+    assert completed.uploaded
+    assert completed.filename_s == (
+        'https://archive.org/download/s_covers_0008/s_covers_0008_80.tar/0008800123-S.jpg'
+    )
