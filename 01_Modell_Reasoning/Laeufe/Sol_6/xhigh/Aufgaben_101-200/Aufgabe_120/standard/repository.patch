+def test_zip_manager_deduplicates_retries(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    source = tmp_path / 'image.jpg'
+    source.write_bytes(b'jpeg')
+    for _ in range(2):
+        manager = archive.ZipManager()
+        manager.add_file('0008000001-S.jpg', str(source), 1_700_000_000)
+        manager.close()
+    path = archive.Batch.get_abspath(8, 0, 's')
+    with zipfile.ZipFile(path) as zf:
+        assert zf.namelist() == ['0008000001-S.jpg']
+    assert archive.count_files_in_zip(path) == 1
+
