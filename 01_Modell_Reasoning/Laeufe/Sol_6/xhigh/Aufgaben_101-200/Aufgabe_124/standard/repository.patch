+
+func TestBillingModeDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		mode  string
+		want  string
+		valid bool
+	}{
+		{"default", "", billingModePayPerRequest, true},
+		{"on demand", billingModePayPerRequest, billingModePayPerRequest, true},
+		{"provisioned", billingModeProvisioned, billingModeProvisioned, true},
+		{"invalid", "PAY_PER_REQUEST", "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: tc.mode}
+			err := cfg.CheckAndSetDefaults()
+			if !tc.valid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.want, cfg.BillingMode)
+		})
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		mode    string
+		awsMode string
+	}{
+		{"on demand", billingModePayPerRequest, dynamodb.BillingModePayPerRequest},
+		{"provisioned", billingModeProvisioned, dynamodb.BillingModeProvisioned},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			api := &billingTableAPI{}
+			b := &Backend{
+				Entry:  logrus.New().WithField("test", true),
+				Config: Config{BillingMode: tc.mode, ReadCapacityUnits: 17, WriteCapacityUnits: 23},
+				svc:    api,
+			}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tc.awsMode, aws.StringValue(api.createInput.BillingMode))
+			if tc.mode == billingModePayPerRequest {
+				require.Nil(t, api.createInput.ProvisionedThroughput)
+			} else {
+				require.Equal(t, int64(17), aws.Int64Value(api.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(23), aws.Int64Value(api.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		api        billingTableAPI
+		wantStatus tableStatus
+		wantMode   string
+		wantErr    bool
+	}{
+		{"on demand", billingTableAPI{description: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}}, tableStatusOK, dynamodb.BillingModePayPerRequest, false},
+		{"provisioned", billingTableAPI{description: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)}}}}, tableStatusOK, dynamodb.BillingModeProvisioned, false},
+		{"legacy provisioned", billingTableAPI{description: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}}, tableStatusOK, "", false},
+		{"missing", billingTableAPI{describeErr: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)}, tableStatusMissing, "", false},
+		{"migration", billingTableAPI{description: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}}}}, tableStatusNeedsMigration, "", false},
+		{"error", billingTableAPI{describeErr: errors.New("describe failed")}, tableStatusError, "", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &tc.api}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.Equal(t, tc.wantStatus, status)
+			require.Equal(t, tc.wantMode, mode)
+			if tc.wantErr {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
+
+func TestConfigureAutoScaling(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		status         tableStatus
+		configuredMode string
+		tableMode      string
+		wantEnabled    bool
+		wantLog        string
+	}{
+		{"existing on demand", tableStatusOK, billingModeProvisioned, dynamodb.BillingModePayPerRequest, false, "auto_scaling is ignored because the table is on-demand"},
+		{"new on demand", tableStatusMissing, billingModePayPerRequest, "", false, "auto_scaling is ignored because the table will be on-demand"},
+		{"existing provisioned", tableStatusOK, billingModePayPerRequest, dynamodb.BillingModeProvisioned, true, ""},
+		{"legacy provisioned", tableStatusOK, billingModePayPerRequest, "", true, ""},
+		{"new provisioned", tableStatusMissing, billingModeProvisioned, "", true, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var logs bytes.Buffer
+			logger := logrus.New()
+			logger.SetOutput(&logs)
+			b := &Backend{Entry: logger.WithField("test", true), Config: Config{BillingMode: tc.configuredMode, EnableAutoScaling: true}}
+			b.configureAutoScaling(tc.status, tc.tableMode)
+			require.Equal(t, tc.wantEnabled, b.EnableAutoScaling)
+			if tc.wantLog == "" {
+				require.Empty(t, logs.String())
+			} else {
+				require.Contains(t, logs.String(), tc.wantLog)
+			}
+		})
+	}
+}
