+func TestLoadDeprecationsRequireExplicitFileKeys(t *testing.T) {
+	tests := []struct {
+		name     string
+		content  string
+		env      map[string]string
+		warnings []string
+	}{
+		{
+			name:     "ui enabled true",
+			content:  "ui:\n  enabled: true\n",
+			warnings: []string{`"ui.enabled" is deprecated and will be removed in a future version.`},
+		},
+		{
+			name:     "ui enabled false",
+			content:  "ui:\n  enabled: false\n",
+			warnings: []string{`"ui.enabled" is deprecated and will be removed in a future version.`},
+		},
+		{
+			name:     "cache memory enabled false",
+			content:  "cache:\n  memory:\n    enabled: false\n",
+			warnings: []string{`"cache.memory.enabled" is deprecated and will be removed in a future version. Please use 'cache.backend' and 'cache.enabled' instead.`},
+		},
+		{
+			name:     "cache memory expiration without enabled",
+			content:  "cache:\n  memory:\n    expiration: 30s\n",
+			warnings: []string{`"cache.memory.expiration" is deprecated and will be removed in a future version. Please use 'cache.ttl' instead.`},
+		},
+		{
+			name:    "environment only",
+			content: "# no deprecated keys\n",
+			env: map[string]string{
+				"FLIPT_UI_ENABLED":           "false",
+				"FLIPT_CACHE_MEMORY_ENABLED": "true",
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(tt.content), 0600))
+			for key, value := range tt.env {
+				t.Setenv(key, value)
+			}
+
+			result, err := Load(path)
+			require.NoError(t, err)
+			require.NotNil(t, result.Config)
+			assert.Equal(t, tt.warnings, result.Warnings)
 		})
 	}
 }
