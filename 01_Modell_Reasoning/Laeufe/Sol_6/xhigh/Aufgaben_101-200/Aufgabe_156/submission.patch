+
+import pytest
+
+from ansible.modules import uri
+
+
+@pytest.mark.parametrize('no_log_values, expected_key, expected_json_key', (
+    (set(), 'x_secret', 'secret'),
+    ({'secret'}, 'x_********', 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'),
+))
+def test_uri_sanitizes_response_keys_only_with_no_log_values(mocker, no_log_values, expected_key, expected_json_key):
+    module = mocker.Mock()
+    module.no_log_values = no_log_values
+    module.params = {
+        'url': 'https://example.invalid/', 'body': None, 'body_format': 'raw',
+        'method': 'GET', 'dest': None, 'return_content': False,
+        'creates': None, 'removes': None, 'status_code': [200],
+        'timeout': 30, 'headers': {},
+    }
+    mocker.patch.object(uri, 'AnsibleModule', return_value=module)
+    mocker.patch.object(uri, 'url_argument_spec', return_value={})
+    mocker.patch.object(uri, 'uri', return_value=(
+        {'status': 200, 'content-type': 'application/json', 'x-secret': 'visible'},
+        b'{"secret": "visible"}', None,
+    ))
+
+    uri.main()
+
+    result = module.exit_json.call_args[1]
+    assert result[expected_key] == 'visible'
+    assert result['json'] == {expected_json_key: 'visible'}
+    assert result['status'] == 200
+    assert result['changed'] is False
+    assert result['content_type'] == 'application/json'
