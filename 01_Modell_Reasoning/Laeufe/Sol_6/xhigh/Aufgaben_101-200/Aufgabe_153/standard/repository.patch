diff --git a/packages/drive-store/zustand/share/share.stores.test.ts b/packages/drive-store/zustand/share/share.stores.test.ts
new file mode 100644
index 0000000..ef75f57
--- /dev/null
+++ b/packages/drive-store/zustand/share/share.stores.test.ts
@@ -0,0 +1,80 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/utils/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (memberId: string): ShareMember => ({ memberId, email: `${memberId}@example.com` }) as ShareMember;
+const invitation = (invitationId: string): ShareInvitation =>
+    ({ invitationId, inviteeEmail: `${invitationId}@example.com`, permissions: 1 }) as ShareInvitation;
+const externalInvitation = (externalInvitationId: string): ShareExternalInvitation =>
+    ({
+        externalInvitationId,
+        inviteeEmail: `${externalInvitationId}@example.com`,
+        permissions: 1,
+    }) as ShareExternalInvitation;
+
+beforeEach(() => {
+    useMembersStore.setState({ members: {} });
+    useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+});
+
+describe('share members store', () => {
+    it('isolates shares and replaces only the selected share', () => {
+        const first = member('first');
+        const second = member('second');
+        const replacement = member('replacement');
+        const store = useMembersStore.getState();
+
+        expect(store.getMembers('missing')).toEqual([]);
+        store.setMembers('share-1', [first]);
+        store.setMembers('share-2', [second]);
+        store.setMembers('share-1', [replacement]);
+
+        expect(store.getMembers('share-1')).toEqual([replacement]);
+        expect(store.getMembers('share-2')).toEqual([second]);
+    });
+});
+
+describe('share invitations store', () => {
+    it('isolates internal and external invitations across shares', () => {
+        const first = invitation('first');
+        const second = invitation('second');
+        const firstExternal = externalInvitation('first-external');
+        const secondExternal = externalInvitation('second-external');
+        const store = useInvitationsStore.getState();
+
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+
+        store.setInvitations('share-1', [first]);
+        store.setInvitations('share-2', [second]);
+        store.setExternalInvitations('share-1', [firstExternal]);
+        store.setExternalInvitations('share-2', [secondExternal]);
+
+        store.updateInvitationsPermissions('share-1', [{ ...first, permissions: 2 }]);
+        store.updateExternalInvitations('share-1', [{ ...firstExternal, permissions: 2 }]);
+        expect(store.getInvitations('share-2')).toEqual([second]);
+        expect(store.getExternalInvitations('share-2')).toEqual([secondExternal]);
+
+        store.removeInvitations('share-1', []);
+        store.removeExternalInvitations('share-1', []);
+        expect(store.getInvitations('share-1')).toEqual([]);
+        expect(store.getExternalInvitations('share-1')).toEqual([]);
+        expect(store.getInvitations('share-2')).toEqual([second]);
+        expect(store.getExternalInvitations('share-2')).toEqual([secondExternal]);
+
+        store.addMultipleInvitations('share-1', [first], [firstExternal]);
+        expect(store.getInvitations('share-1')).toEqual([first]);
+        expect(store.getExternalInvitations('share-1')).toEqual([firstExternal]);
+        expect(store.getInvitations('share-2')).toEqual([second]);
+        expect(store.getExternalInvitations('share-2')).toEqual([secondExternal]);
+    });
+});
+
+it('collects email addresses from members and both invitation types', () => {
+    expect(getExistingEmails([member('member')], [invitation('invite')], [externalInvitation('external')])).toEqual([
+        'member@example.com',
+        'invite@example.com',
+        'external@example.com',
+    ]);
+});
