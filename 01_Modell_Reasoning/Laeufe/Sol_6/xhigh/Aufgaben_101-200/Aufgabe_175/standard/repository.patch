+++ b/db/backup_test.go
@@ -0,0 +1,106 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	ctx := context.Background()
+	root := t.TempDir()
+	livePath := filepath.Join(root, "live.db")
+	backupDir := filepath.Join(root, "backups")
+	oldBackup, oldDBPath := conf.Server.Backup, conf.Server.DbPath
+	conf.Server.Backup.Path = backupDir
+	conf.Server.Backup.Count = 0
+	conf.Server.DbPath = livePath
+	t.Cleanup(func() {
+		conf.Server.Backup, conf.Server.DbPath = oldBackup, oldDBPath
+	})
+
+	live, err := sql.Open(Driver, livePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = live.Close() })
+	if _, err := live.Exec("PRAGMA journal_mode=WAL"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := live.Exec("CREATE TABLE goose_db_version (id INTEGER); CREATE TABLE sample (value TEXT); INSERT INTO sample VALUES ('original')"); err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: live, writeDB: live}
+	first, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Dir(first) != backupDir {
+		t.Fatalf("backup stored in %q, want %q", filepath.Dir(first), backupDir)
+	}
+	second, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backups collided")
+	}
+	if _, err := live.Exec("UPDATE sample SET value='changed'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := live.QueryRow("SELECT value FROM sample").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "original" {
+		t.Fatalf("restored value = %q", value)
+	}
+
+	conf.Server.Backup.Count = 1
+	count, err := d.Prune(ctx)
+	if err != nil || count != 1 {
+		t.Fatalf("prune 1: count=%d err=%v", count, err)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatalf("newest backup missing: %v", err)
+	}
+	conf.Server.Backup.Count = 0
+	count, err = d.Prune(ctx)
+	if err != nil || count != 1 {
+		t.Fatalf("prune all: count=%d err=%v", count, err)
+	}
+}
+
+func TestRestoreRejectsInvalidSource(t *testing.T) {
+	root := t.TempDir()
+	livePath := filepath.Join(root, "live.db")
+	oldDBPath := conf.Server.DbPath
+	conf.Server.DbPath = livePath
+	t.Cleanup(func() { conf.Server.DbPath = oldDBPath })
+	live, err := sql.Open(Driver, livePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if _, err := live.Exec("CREATE TABLE goose_db_version (id INTEGER)"); err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: live, writeDB: live}
+	if err := d.Restore(context.Background(), livePath); err == nil {
+		t.Fatal("restoring live database should fail")
+	}
+	badPath := filepath.Join(root, "bad.db")
+	if err := os.WriteFile(badPath, []byte("not sqlite"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(context.Background(), badPath); err == nil {
+		t.Fatal("invalid backup should fail")
+	}
+}
