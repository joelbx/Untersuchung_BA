+package cmd
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/scheduler"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{
+		Use:   "backup",
+		Short: "Create, prune, or restore database backups",
+	}
+	backupCmd.AddCommand(&cobra.Command{
+		Use:   "create",
+		Short: "Create a database backup",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, err := db.Db().Backup(cmd.Context())
+			if err != nil {
+				return err
+			}
+			_, _ = fmt.Fprintln(cmd.OutOrStdout(), path)
+			return nil
+		},
+	})
+
+	pruneCmd := &cobra.Command{
+		Use:   "prune",
+		Short: "Remove old database backups",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, _ := cmd.Flags().GetBool("force")
+			if conf.Server.Backup.Count == 0 && !force {
+				if !confirmBackupAction(cmd, "backup.count is 0; delete all backup files?") {
+					return nil
+				}
+			}
+			count, err := db.Db().Prune(cmd.Context())
+			if err != nil {
+				return err
+			}
+			_, _ = fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backup files\n", count)
+			return nil
+		},
+	}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation when backup.count is 0")
+	backupCmd.AddCommand(pruneCmd)
+
+	restoreCmd := &cobra.Command{
+		Use:   "restore",
+		Short: "Restore the database from a backup file",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, _ := cmd.Flags().GetString("backup-file")
+			force, _ := cmd.Flags().GetBool("force")
+			if !force && !confirmBackupAction(cmd, fmt.Sprintf("Restore database from %q?", path)) {
+				return nil
+			}
+			if err := db.Db().Restore(cmd.Context(), path); err != nil {
+				return err
+			}
+			_, _ = fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+			return nil
+		},
+	}
+	restoreCmd.Flags().String("backup-file", "", "path to the database backup")
+	restoreCmd.Flags().Bool("force", false, "skip restore confirmation")
+	_ = restoreCmd.MarkFlagRequired("backup-file")
+	backupCmd.AddCommand(restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackupAction(cmd *cobra.Command, prompt string) bool {
+	_, _ = fmt.Fprintf(cmd.OutOrStdout(), "%s [y/N] ", prompt)
+	answer, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	_, _ = fmt.Fprintln(cmd.OutOrStdout())
+	if err != nil && err != io.EOF {
+		return false
+	}
+	answer = strings.TrimSpace(answer)
+	return strings.EqualFold(answer, "y") || strings.EqualFold(answer, "yes")
+}
+
+func schedulePeriodicBackup(ctx context.Context) func() error {
+	return func() error {
+		backup := conf.Server.Backup
+		if backup.Path == "" || backup.Schedule == "" || backup.Count == 0 {
+			log.Info("Periodic database backup is disabled")
+			return nil
+		}
+		log.Info("Scheduling periodic database backup", "schedule", backup.Schedule)
+		return scheduler.GetInstance().Add(backup.Schedule, func() {
+			// The scheduler stops on cancellation, and an in-flight copy uses the
+			// same context so shutdown can interrupt it.
+			if ctx.Err() != nil {
+				return
+			}
+			path, err := db.Db().Backup(ctx)
+			if err != nil {
+				log.Error("Periodic database backup failed", err)
+				return
+			}
+			log.Info("Created periodic database backup", "path", path)
+			if count, err := db.Db().Prune(ctx); err != nil {
+				log.Error("Periodic database backup pruning failed", err)
+			} else if count > 0 {
+				log.Info("Pruned old database backups", "count", count)
+			}
+		})
+	}
+}
