+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	previous := Server.Backup.Schedule
+	t.Cleanup(func() { Server.Backup.Schedule = previous })
+	for _, test := range []struct {
+		input string
+		want  string
+		valid bool
+	}{
+		{"", "", true},
+		{"2h", "@every 2h", true},
+		{"0 3 * * *", "0 3 * * *", true},
+		{"invalid schedule", "invalid schedule", false},
+	} {
+		Server.Backup.Schedule = test.input
+		err := validateBackupSchedule()
+		if (err == nil) != test.valid || Server.Backup.Schedule != test.want {
+			t.Errorf("schedule %q: normalized=%q err=%v", test.input, Server.Backup.Schedule, err)
+		}
+	}
+}
