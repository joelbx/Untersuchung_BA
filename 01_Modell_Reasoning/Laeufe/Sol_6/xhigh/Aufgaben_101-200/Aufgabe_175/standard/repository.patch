diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..7da9680
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,191 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const (
+	backupPrefix     = "navidrome_backup_"
+	backupTimeFormat = "20060102T150405.000000000Z"
+)
+
+// Backup creates a consistent online copy of the live SQLite database.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	backupDir := conf.Server.Backup.Path
+	if backupDir == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := os.MkdirAll(backupDir, os.ModePerm); err != nil {
+		return "", fmt.Errorf("create backup directory: %w", err)
+	}
+
+	// Work in the destination directory so a failed copy never appears as a backup.
+	tmp, err := os.CreateTemp(backupDir, ".navidrome_backup_*.tmp")
+	if err != nil {
+		return "", err
+	}
+	tmpPath := tmp.Name()
+	defer os.Remove(tmpPath)
+	if err := tmp.Close(); err != nil {
+		return "", err
+	}
+
+	dest, err := sql.Open(Driver, tmpPath)
+	if err != nil {
+		return "", err
+	}
+	if err := copySQLite(ctx, d.writeDB, dest); err != nil {
+		_ = dest.Close()
+		return "", fmt.Errorf("backup database: %w", err)
+	}
+	if err := dest.Close(); err != nil {
+		return "", err
+	}
+
+	path := filepath.Join(backupDir, backupPrefix+time.Now().UTC().Format(backupTimeFormat)+".db")
+	if err := os.Rename(tmpPath, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+// Restore replaces the live database with a verified SQLite backup.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return fmt.Errorf("open backup file: %w", err)
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("backup file must be a regular file")
+	}
+	if liveInfo, err := os.Stat(conf.Server.DbPath); err == nil && os.SameFile(info, liveInfo) {
+		return errors.New("backup file is the live database")
+	}
+
+	src, err := sql.Open(Driver, path)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var check string
+	if err := src.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&check); err != nil {
+		return fmt.Errorf("invalid SQLite backup: %w", err)
+	}
+	if check != "ok" {
+		return fmt.Errorf("SQLite backup failed integrity check: %s", check)
+	}
+	var schemaTable string
+	if err := src.QueryRowContext(ctx, "SELECT name FROM sqlite_master WHERE type='table' AND name='goose_db_version'").Scan(&schemaTable); err != nil {
+		return fmt.Errorf("backup is not a Navidrome database: %w", err)
+	}
+	if err := copySQLite(ctx, src, d.writeDB); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+// copySQLite uses SQLite's online backup API, including for restoring into a live DB.
+func copySQLite(ctx context.Context, src, dest *sql.DB) error {
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+
+	return srcConn.Raw(func(srcDriver any) error {
+		return destConn.Raw(func(destDriver any) error {
+			source, ok := srcDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("source is not a SQLite connection")
+			}
+			target, ok := destDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("destination is not a SQLite connection")
+			}
+			backup, err := target.Backup("main", source, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				remaining := backup.Remaining()
+				done, err := backup.Step(128)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				if backup.Remaining() == remaining {
+					select {
+					case <-ctx.Done():
+						_ = backup.Finish()
+						return ctx.Err()
+					case <-time.After(10 * time.Millisecond):
+					}
+				}
+			}
+		})
+	})
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) {
+	return prune(ctx)
+}
+
+// prune keeps the newest backup.count timestamped backups in backup.path.
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is not configured")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count must be non-negative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if !entry.Type().IsRegular() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") || len(name) <= len(backupPrefix)+len(".db") {
+			continue
+		}
+		names = append(names, name)
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	var deleted int
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return deleted, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return deleted, err
+		}
+		deleted++
+	}
+	return deleted, nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
