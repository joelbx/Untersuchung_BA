+                                             monkeypatch, mocker):
+    config_stub.set_obj("fileselect.handler", "default")
+    monkeypatch.setattr(webview.qtutils, "version_check",
+                        lambda version, *, compiled: version == "6.2.3")
+    monkeypatch.setattr(webview.mimetypes, "guess_all_extensions",
+                        lambda mime: [".jpg", ".jpe"])
+    parent_choose_files = mocker.patch.object(
+        QWebEnginePage, "chooseFiles", return_value=["selected.jpg"])
+
+    mode = QWebEnginePage.FileSelectionMode.FileSelectOpen
+    result = webengine_tab._widget.page().chooseFiles(
+        mode, [], iter(["image/jpeg", ".jpg"]))
+
+    assert result == ["selected.jpg"]
+    parent_choose_files.assert_called_once_with(
