diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..f383344
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,40 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chats to chat allow lists',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const keys = uids.map(uid => `user:${uid}:settings`);
+			const settings = await db.getObjects(keys);
+			const toMigrate = uids.filter((uid, index) => (
+				settings[index] && parseInt(settings[index].restrictChat, 10) === 1 &&
+				settings[index].chatAllowList === undefined
+			));
+			if (!toMigrate.length) {
+				progress.incr(uids.length);
+				return;
+			}
+			const following = await db.getSortedSetsMembers(toMigrate.flatMap(uid => [
+				`following:${uid}`, `followingRemote:${uid}`,
+			]));
+			const writes = toMigrate.map((uid, index) => {
+				const allowList = [...(following[index * 2] || []), ...(following[(index * 2) + 1] || [])].map(String);
+				return [`user:${uid}:settings`, {
+					chatAllowList: JSON.stringify(allowList),
+					disableIncomingMessages: allowList.length ? 0 : 1,
+				}];
+			});
+			if (writes.length) {
+				await db.setObjectBulk(writes);
+			}
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
