+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/package-url/packageurl-go"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typ, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"unknown", "some/package", "", "some/package", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typ+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typ, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.typ, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPackagePURL(t *testing.T) {
+	tests := []struct {
+		sourceType                           ftypes.LangType
+		input, typ, namespace, name, subpath string
+	}{
+		{ftypes.Pom, "com.google.guava:guava", "maven", "com.google.guava", "guava", ""},
+		{ftypes.Pip, "My_Package", "pypi", "", "my-package", ""},
+		{ftypes.GoModule, "github.com/protobom/protobom", "golang", "github.com/protobom", "protobom", ""},
+		{ftypes.Npm, "@babel/core", "npm", "@babel", "core", ""},
+		{ftypes.Cocoapods, "GoogleUtilities/NSData+zlib", "cocoapods", "", "GoogleUtilities", "NSData+zlib"},
+	}
+	for _, tt := range tests {
+		t.Run(string(tt.sourceType), func(t *testing.T) {
+			lockfile := "example.lock"
+			refs := map[string]map[string]string{lockfile: {}}
+			components := libpkgToCdxComponents(models.LibraryScanner{
+				Type: tt.sourceType, LockfilePath: lockfile,
+				Libs: []models.Library{{Name: tt.input, Version: "1.0"}},
+			}, refs)
+			if len(components) != 2 {
+				t.Fatalf("got %d components, want 2", len(components))
+			}
+			checkPackagePURL(t, components[1].PackageURL, tt.typ, tt.namespace, tt.name, tt.subpath)
+			if refs[lockfile][tt.input] != components[1].PackageURL {
+				t.Error("original library name did not resolve to its PURL")
+			}
+		})
+	}
+}
+
+func TestDependencyGraphPackagePURL(t *testing.T) {
+	manifest := models.DependencyGraphManifest{
+		Filename: "pom.xml", Repository: "example/repo",
+		Dependencies: []models.Dependency{{PackageName: "com.google.guava:guava", Requirements: "= 1.0"}},
+	}
+	refs := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+	components := ghpkgToCdxComponents(manifest, refs)
+	if len(components) != 2 {
+		t.Fatalf("got %d components, want 2", len(components))
+	}
+	checkPackagePURL(t, components[1].PackageURL, "maven", "com.google.guava", "guava", "")
+	if refs[manifest.RepoURLFilename()][manifest.Dependencies[0].PackageName] != components[1].PackageURL {
+		t.Error("original dependency name did not resolve to its PURL")
+	}
+}
+
+func checkPackagePURL(t *testing.T, raw, typ, namespace, name, subpath string) {
+	t.Helper()
+	purl, err := packageurl.FromString(raw)
+	if err != nil {
+		t.Fatalf("invalid PURL %q: %v", raw, err)
+	}
+	if purl.Type != typ || purl.Namespace != namespace || purl.Name != name || purl.Subpath != subpath {
+		t.Errorf("PURL %q = (%q, %q, %q, %q), want (%q, %q, %q, %q)", raw, purl.Type, purl.Namespace, purl.Name, purl.Subpath, typ, namespace, name, subpath)
+	}
+}
