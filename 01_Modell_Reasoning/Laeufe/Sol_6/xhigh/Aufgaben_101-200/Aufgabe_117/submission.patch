+def test_get_lang_override(tmp_path, monkeypatch, config_stub, version_patcher,
+                           locale, available, expected):
+    version_patcher('5.15.3')
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    monkeypatch.setenv('QTWEBENGINE_LOCALES_PATH', str(tmp_path))
+    config_stub.val.qt.workarounds.locale = True
+    for name in available:
+        (tmp_path / (name + '.pak')).touch()
+
+    versions = version.qtwebengine_versions(avoid_init=True)
+    assert qtargs._get_lang_override(versions, locale) == expected
+
+
