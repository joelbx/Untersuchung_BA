+func TestAmazonLinuxEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		until   time.Time
+	}{
+		{"2023 (Amazon Linux)", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2023.0.20230315.0 (Amazon Linux)", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2025 (Amazon Linux)", time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2027 (Amazon Linux)", time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2029 (Amazon Linux)", time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL did not find the release")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("StandardSupportUntil = %v, want %v", eol.StandardSupportUntil, tt.until)
+			}
+			if !eol.ExtendedSupportUntil.IsZero() {
+				t.Errorf("ExtendedSupportUntil = %v, want zero", eol.ExtendedSupportUntil)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSuppportEnded(tt.until) {
+				t.Error("support ended before the end of the last day")
+			}
+			if !eol.IsStandardSupportEnded(tt.until.Add(time.Second)) || !eol.IsExtendedSuppportEnded(tt.until.Add(time.Second)) {
+				t.Error("support did not end after the last day")
+			}
+		})
+	}
+	for _, release := range []string{"2024", "2031", "unknown", ""} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL found unsupported release %q", release)
+		}
+	}
+}
