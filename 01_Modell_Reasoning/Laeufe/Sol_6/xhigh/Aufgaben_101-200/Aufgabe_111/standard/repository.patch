+func TestGetEOLExtendedSupport(t *testing.T) {
+	eol, found := GetEOL(RedHat, "7")
+	if !found {
+		t.Fatal("GetEOL did not find Red Hat 7")
+	}
+	standardEnd := time.Date(2024, 6, 30, 23, 59, 59, 0, time.UTC)
+	extendedEnd := time.Date(2026, 6, 30, 23, 59, 59, 0, time.UTC)
+	if !eol.StandardSupportUntil.Equal(standardEnd) || !eol.ExtendedSupportUntil.Equal(extendedEnd) {
+		t.Fatalf("GetEOL returned standard %v and extended %v", eol.StandardSupportUntil, eol.ExtendedSupportUntil)
+	}
+	if eol.IsStandardSupportEnded(standardEnd) || eol.IsExtendedSuppportEnded(standardEnd) {
+		t.Error("support ended before the standard support end")
+	}
+	if !eol.IsStandardSupportEnded(standardEnd.Add(time.Second)) || eol.IsExtendedSuppportEnded(standardEnd.Add(time.Second)) {
+		t.Error("extended support should continue after standard support ends")
+	}
+	if eol.IsExtendedSuppportEnded(extendedEnd) || !eol.IsExtendedSuppportEnded(extendedEnd.Add(time.Second)) {
+		t.Error("extended support ended at the wrong time")
+	}
+}
