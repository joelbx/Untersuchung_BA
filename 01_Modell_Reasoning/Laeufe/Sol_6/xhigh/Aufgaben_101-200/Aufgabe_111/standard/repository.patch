+func parseAmazonRelease(systemRelease string) string {
+	fields := strings.Fields(systemRelease)
+	if len(fields) < 3 || fields[0] != "Amazon" || fields[1] != "Linux" {
+		return "unknown"
+	}
+	fields = fields[2:]
+	if fields[0] == "AMI" {
+		fields = fields[1:]
+	}
+	if len(fields) > 0 && fields[0] == "release" {
+		fields = fields[1:]
+	}
+	if len(fields) > 0 {
+		return strings.Join(fields, " ")
+	}
+	return "unknown"
+}
