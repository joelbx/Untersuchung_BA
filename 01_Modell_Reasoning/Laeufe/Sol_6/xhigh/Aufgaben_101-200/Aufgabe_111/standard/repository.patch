+func amazonAdvisorySourceLink(advisoryID string) string {
+	for _, release := range []string{"2022", "2023", "2025", "2027", "2029"} {
+		prefix := "ALAS" + release
+		if strings.HasPrefix(advisoryID, prefix+"-") {
+			return fmt.Sprintf("https://alas.aws.amazon.com/AL%s/ALAS%s.html", release, strings.TrimPrefix(advisoryID, prefix))
+		}
+	}
+	if strings.HasPrefix(advisoryID, "ALAS2-") {
+		return fmt.Sprintf("https://alas.aws.amazon.com/AL2/ALAS%s.html", strings.TrimPrefix(advisoryID, "ALAS2"))
+	}
+	if strings.HasPrefix(advisoryID, "ALAS-") {
+		return fmt.Sprintf("https://alas.aws.amazon.com/%s.html", advisoryID)
+	}
+	return ""
+}
