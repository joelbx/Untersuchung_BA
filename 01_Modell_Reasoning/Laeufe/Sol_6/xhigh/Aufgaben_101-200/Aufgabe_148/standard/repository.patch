+func TestTeleportProxySSHServerRemoteAddr(t *testing.T) {
+	_, signer, err := utils.CreateCertificate("foo", ssh.HostCert)
+	require.NoError(t, err)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener})
+	require.NoError(t, err)
+	sshListener := mux.SSH()
+	go mux.Serve()
+	defer mux.Close()
+
+	remoteAddrs := make(chan net.Addr, 1)
+	server, err := sshutils.NewServer(
+		"test",
+		utils.NetAddr{AddrNetwork: "tcp", Addr: "localhost:0"},
+		sshutils.NewChanHandlerFunc(func(_ context.Context, _ *sshutils.ConnectionContext, channel ssh.NewChannel) {
+			channel.Reject(ssh.Prohibited, "no channels")
+		}),
+		[]ssh.Signer{signer},
+		sshutils.AuthMethods{Password: func(conn ssh.ConnMetadata, password []byte) (*ssh.Permissions, error) {
+			remoteAddrs <- conn.RemoteAddr()
+			return nil, nil
+		}},
+	)
+	require.NoError(t, err)
+	go server.Serve(sshListener)
+	defer server.Close()
+
+	conn, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer conn.Close()
+	require.NoError(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = io.WriteString(conn, `Teleport-Proxy{"clientAddr":"203.0.113.7:4812","tracingContext":{"trace":"value"}}`+"\x00")
+	require.NoError(t, err)
+	client, _, _, err := ssh.NewClientConn(conn, listener.Addr().String(), &ssh.ClientConfig{
+		User:            "test",
+		Auth:            []ssh.AuthMethod{ssh.Password("password")},
+		HostKeyCallback: ssh.FixedHostKey(signer.PublicKey()),
+	})
+	require.NoError(t, err)
+	defer client.Close()
+	select {
+	case remoteAddr := <-remoteAddrs:
+		require.Equal(t, "203.0.113.7:4812", remoteAddr.String())
+		require.IsType(t, &net.TCPAddr{}, remoteAddr)
+	case <-time.After(5 * time.Second):
+		t.Fatal("SSH server did not authenticate the prefixed connection")
+	}
+}
