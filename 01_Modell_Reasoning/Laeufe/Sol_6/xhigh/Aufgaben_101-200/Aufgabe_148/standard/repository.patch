+// readTeleportProxyAddr inspects the handshake without consuming it. The SSH
+// server also reads this header to obtain tracing context, so it must remain
+// available to the connection passed to the SSH listener.
+func readTeleportProxyAddr(reader *bufio.Reader) (net.Addr, error) {
+	// The SSH server reads at most MaxVersionStringBytes on its first read.
+	// Keep the entire header within that limit so it can parse it too.
+	for size := len(teleportProxyPrefix) + 1; size <= 255; size++ {
+		in, err := reader.Peek(size)
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport-Proxy header")
+		}
+		if in[size-1] != 0 {
+			continue
+		}
+
+		var payload apisshutils.HandshakePayload
+		if err := json.Unmarshal(in[len(teleportProxyPrefix):size-1], &payload); err != nil {
+			return nil, trace.BadParameter("invalid Teleport-Proxy payload: %v", err)
+		}
+		if payload.ClientAddr == "" {
+			return nil, nil
+		}
+		addr, err := utils.ParseAddr(payload.ClientAddr)
+		if err != nil {
+			return nil, trace.Wrap(err, "invalid Teleport-Proxy client address")
+		}
+		if addr.AddrNetwork == "tcp" {
+			// SSH source-address checks require a TCPAddr.
+			return &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}, nil
+		}
+		return addr, nil
+	}
+	return nil, trace.BadParameter("Teleport-Proxy header exceeds SSH version string limit")
+}
