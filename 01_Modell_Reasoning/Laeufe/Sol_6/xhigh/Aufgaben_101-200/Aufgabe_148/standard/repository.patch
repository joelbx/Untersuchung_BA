+func TestTeleportProxySSH(t *testing.T) {
+	const sshVersion = "SSH-2.0-test\r\n"
+	for _, tc := range []struct {
+		name       string
+		header     string
+		clientAddr string
+	}{
+		{name: "client address", header: `Teleport-Proxy{"clientAddr":"203.0.113.7:4812","tracingContext":{"trace":"value"}}` + "\x00", clientAddr: "203.0.113.7:4812"},
+		{name: "tracing only", header: `Teleport-Proxy{"tracingContext":{"trace":"value"}}` + "\x00"},
+		{name: "standard SSH"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			mux, err := New(Config{Listener: listener})
+			require.NoError(t, err)
+			sshListener := mux.SSH()
+			go mux.Serve()
+			defer mux.Close()
+
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			message := tc.header + sshVersion
+			_, err = io.WriteString(client, message)
+			require.NoError(t, err)
+
+			accepted := make(chan net.Conn, 1)
+			go func() {
+				conn, err := sshListener.Accept()
+				if err == nil {
+					accepted <- conn
+				}
+			}()
+			var conn net.Conn
+			select {
+			case conn = <-accepted:
+			case <-time.After(5 * time.Second):
+				t.Fatal("SSH connection was not routed to the SSH listener")
+			}
+			defer conn.Close()
+			require.Equal(t, ProtoSSH, conn.(*Conn).Protocol())
+			wantAddr := tc.clientAddr
+			if wantAddr == "" {
+				wantAddr = client.LocalAddr().String()
+			}
+			require.Equal(t, wantAddr, conn.RemoteAddr().String())
+			require.IsType(t, &net.TCPAddr{}, conn.RemoteAddr())
+			require.NoError(t, conn.SetReadDeadline(time.Now().Add(5*time.Second)))
+			buf := make([]byte, len(message))
+			_, err = io.ReadFull(conn, buf)
+			require.NoError(t, err)
+			require.Equal(t, message, string(buf))
+		})
+	}
+}
