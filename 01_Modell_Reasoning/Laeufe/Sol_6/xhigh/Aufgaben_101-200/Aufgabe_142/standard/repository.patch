+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package parse
+
+import (
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a typed, evaluable expression.
+type Expr interface {
+	String() string
+	Kind() reflect.Kind
+	Evaluate(EvaluateContext) (any, error)
+}
+
+// EvaluateContext supplies traits and the candidate string for a matcher.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+// StringLitExpr evaluates to exactly one string, including an empty string.
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string     { return strconv.Quote(e.Value) }
+func (e StringLitExpr) Kind() reflect.Kind { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) {
+	return []string{e.Value}, nil
+}
+
+// VarExpr refers to a two-part, namespaced variable.
+type VarExpr struct {
+	Namespace string
+	Name      string
+}
+
+func (e VarExpr) String() string {
+	if e.Name == "" {
+		return e.Namespace
+	}
+	return e.Namespace + "." + e.Name
+}
+func (e VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if e.Namespace == LiteralNamespace {
+		return []string{e.Name}, nil
+	}
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("variable resolver is missing for %q", e.String())
+	}
+	return ctx.VarValue(e)
+}
+
+// EmailLocalExpr extracts the local part of each address.
+type EmailLocalExpr struct{ Input Expr }
+
+func (e EmailLocalExpr) String() string     { return "email.local(" + e.Input.String() + ")" }
+func (e EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evalStrings(e.Input, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("email.local: address is empty")
+		}
+		addr, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("email.local: invalid address %q: %v", value, err)
+		}
+		local, _, ok := strings.Cut(addr.Address, "@")
+		if !ok || local == "" {
+			return nil, trace.BadParameter("email.local: missing local part in %q", value)
+		}
+		out = append(out, local)
+	}
+	return out, nil
+}
+
+// RegexpReplaceExpr replaces matches in each source value. Values with no
+// match are omitted.
+type RegexpReplaceExpr struct {
+	Input       Expr
+	Pattern     string
+	Replacement string
+	re          *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return "regexp.replace(" + e.Input.String() + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (e RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evalStrings(e.Input, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if re.MatchString(value) {
+			out = append(out, re.ReplaceAllString(value, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+// RegexpMatchExpr tests the matcher input against a regular expression.
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string     { return "regexp.match(" + strconv.Quote(e.Pattern) + ")" }
+func (e RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	var err error
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+
+// RegexpNotMatchExpr negates regexp.match.
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	return "regexp.not_match(" + strconv.Quote(e.Pattern) + ")"
+}
+func (e RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	var err error
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	return !re.MatchString(ctx.MatcherInput), nil
+}
+
+func evalStrings(expr Expr, ctx EvaluateContext) ([]string, error) {
+	if expr == nil || expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("string expression required")
+	}
+	value, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	strings, ok := value.([]string)
+	if !ok {
+		return nil, trace.BadParameter("string expression %s returned %T", expr.String(), value)
+	}
+	return strings, nil
+}
+
+func compileRegexp(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("invalid regexp %q: %v", pattern, err)
+	}
+	return re, nil
+}
