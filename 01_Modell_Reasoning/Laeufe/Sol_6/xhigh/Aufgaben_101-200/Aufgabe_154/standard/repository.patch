+_CLIXML_ERROR = (b'#< CLIXML\r\n<Objs Version="1.1.0.1">'
+                 b'<S S="Error">caf\xc3\xa9_x000D__x000A_</S></Objs>')
+
+
+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain stderr\r\n', b'plain stderr\r\n'),
+    (_CLIXML_ERROR, b'caf\xc3\xa9\r\n'),
+    (b'before ' + _CLIXML_ERROR + b' after\r\n', b'before caf\xc3\xa9\r\n after\r\n'),
+    (b'first\r\n' + _CLIXML_ERROR + b'\r\nlast', b'first\r\ncaf\xc3\xa9\r\n\r\nlast'),
+    (_CLIXML_ERROR.replace(b'caf\xc3\xa9', b'caf\x82'), b'caf\xc3\xa9\r\n'),
+    (_CLIXML_ERROR + b'\r\n' + _CLIXML_ERROR, b'caf\xc3\xa9\r\n\r\ncaf\xc3\xa9\r\n'),
+    (b'\r\nCLIXML\r\n' + _CLIXML_ERROR.split(b'\r\n', 1)[1], b'caf\xc3\xa9\r\n'),
+    (_CLIXML_ERROR.replace(b'<S S="Error">', b'\r\n<S S="Error">'), b'caf\xc3\xa9\r\n'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">unfinished',
+     b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">unfinished'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">bad & raw</S></Objs>',
+     b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">bad & raw</S></Objs>'),
+    (b'#< CLI\r\nXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken</S></Objs>',
+     b'#< CLI\r\nXML\r\n<Objs Version="1.1.0.1"><S S="Error">broken</S></Objs>'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">unfinished\r\n' + _CLIXML_ERROR,
+     b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">unfinished\r\ncaf\xc3\xa9\r\n'),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_exec_command_replaces_windows_clixml():
+    conn = connection_loader.get('ssh', PlayContext(), StringIO())
+    conn.get_option = MagicMock(return_value='ssh')
+    conn._build_command = MagicMock(return_value='ssh command')
+    conn._run = MagicMock(return_value=(1, b'', b'prefix ' + _CLIXML_ERROR + b' suffix'))
+
+    with patch.object(conn._shell, '_IS_WINDOWS', True, create=True):
+        assert conn.exec_command('command') == (1, b'', b'prefix caf\xc3\xa9\r\n suffix')
+
