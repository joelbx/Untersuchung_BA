@@ -0,0 +1,57 @@
+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs, reset } from './elementsActions';
+import elementsReducer from './elementsSlice';
+
+describe('optimistic mark-as bypass filtering', () => {
+    const message = { ID: 'message-1', ConversationID: 'conversation-1' } as Element;
+    const otherMessage = { ID: 'message-2', ConversationID: 'conversation-2' } as Element;
+
+    it.each([
+        { unreadFilter: 1, bypassStatus: MARK_AS_STATUS.READ, matchingStatus: MARK_AS_STATUS.UNREAD },
+        { unreadFilter: 0, bypassStatus: MARK_AS_STATUS.UNREAD, matchingStatus: MARK_AS_STATUS.READ },
+    ])(
+        'removes stale message bypass IDs when the status matches filter $unreadFilter',
+        ({ unreadFilter, bypassStatus, matchingStatus }) => {
+            let state = elementsReducer(undefined, reset({ params: { filter: { Unread: unreadFilter } } }));
+
+            state = elementsReducer(
+                state,
+                optimisticMarkAs({ elements: [message, otherMessage], bypass: true, markAsStatus: bypassStatus })
+            );
+            expect(state.bypassFilter).toEqual(['message-1', 'message-2']);
+
+            state = elementsReducer(
+                state,
+                optimisticMarkAs({ elements: [message], bypass: true, markAsStatus: matchingStatus })
+            );
+            expect(state.bypassFilter).toEqual(['message-2']);
+        }
+    );
+
+    it('uses conversation IDs to add and remove bypasses in conversation mode', () => {
+        let state = elementsReducer(undefined, reset({ params: { filter: { Unread: 1 } } }));
+
+        state = elementsReducer(
+            state,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: true,
+                markAsStatus: MARK_AS_STATUS.READ,
+            })
+        );
+        expect(state.bypassFilter).toEqual(['conversation-1']);
+
+        state = elementsReducer(
+            state,
+            optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                conversationMode: true,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            })
+        );
+        expect(state.bypassFilter).toEqual([]);
+    });
+});
