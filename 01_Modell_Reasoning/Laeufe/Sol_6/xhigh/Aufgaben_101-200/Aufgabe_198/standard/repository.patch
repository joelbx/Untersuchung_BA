+func TestConvertToDistroAdvisory(t *testing.T) {
+	tests := []struct {
+		family string
+		title  string
+		want   string
+	}{
+		{constant.RedHat, "RHSA-2024:1234: security update", "RHSA-2024:1234"},
+		{constant.CentOS, "RHBA-2024:1234: bug fix", "RHBA-2024:1234"},
+		{constant.Alma, "RHSA-2024:1234: security update", "RHSA-2024:1234"},
+		{constant.Rocky, "RHSA-2024:1234: security update", "RHSA-2024:1234"},
+		{constant.Oracle, "ELSA-2024-1234: security update", "ELSA-2024-1234"},
+		{constant.Amazon, "ALAS2-2024-1234", "ALAS2-2024-1234"},
+		{constant.Fedora, "FEDORA-2024-1234", "FEDORA-2024-1234"},
+		{constant.RedHat, "CVE-2024-1234", ""},
+		{constant.Oracle, "RHSA-2024:1234", ""},
+		{constant.Amazon, "", ""},
+		{constant.Fedora, "FEDORA", ""},
+	}
+	for _, tt := range tests {
+		o := RedHatBase{Base: Base{family: tt.family}}
+		got := o.convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
+		if tt.want == "" {
+			if got != nil {
+				t.Errorf("%s %q: unexpected advisory %+v", tt.family, tt.title, got)
+			}
+		} else if got == nil || got.AdvisoryID != tt.want {
+			t.Errorf("%s %q: got %+v, want %s", tt.family, tt.title, got, tt.want)
+		}
+	}
+}
