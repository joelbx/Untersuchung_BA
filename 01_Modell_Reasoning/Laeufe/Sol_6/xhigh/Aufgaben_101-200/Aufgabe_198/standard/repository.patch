+func TestIsOvalDefAffectedResolution(t *testing.T) {
+	tests := []struct {
+		name      string
+		state     string
+		component string
+		family    string
+		release   string
+		req       request
+		pack      ovalmodels.Package
+		want      bool
+		wantState string
+	}{
+		{name: "will not fix", state: "Will not fix", component: "nginx", wantState: "Will not fix"},
+		{name: "under investigation", state: "Under investigation", component: "nginx", wantState: "Under investigation"},
+		{name: "fix deferred", state: "Fix deferred", component: "nginx", want: true, wantState: "Fix deferred"},
+		{name: "affected", state: "Affected", component: "nginx", want: true, wantState: "Affected"},
+		{name: "out of support scope", state: "Out of support scope", component: "nginx", want: true, wantState: "Out of support scope"},
+		{name: "no resolution", want: true},
+		{name: "unrelated component", state: "Will not fix", component: "httpd", want: true},
+		{
+			name: "modular component", state: "Fix deferred", component: "nginx:1.16", want: true, wantState: "Fix deferred",
+			req:  request{packName: "nginx", versionRelease: "1.0-1.module+el8.3.0+1", modularityLabel: "nginx:1.16"},
+			pack: ovalmodels.Package{Name: "nginx", Version: "2.0", NotFixedYet: true, ModularityLabel: "nginx:1.16"},
+		},
+		{
+			name: "wrong module", state: "Fix deferred", component: "nginx:1.16",
+			req:  request{packName: "nginx", versionRelease: "1.0-1.module+el8.3.0+1"},
+			pack: ovalmodels.Package{Name: "nginx", Version: "2.0", NotFixedYet: true, ModularityLabel: "nginx:1.14"},
+		},
+		{
+			name: "wrong Amazon repository", state: "Affected", component: "nginx", family: constant.Amazon, release: "2",
+			req:  request{packName: "nginx", versionRelease: "1.0", arch: "x86_64", repository: "amzn2extra-nginx"},
+			pack: ovalmodels.Package{Name: "nginx", Version: "2.0", Arch: "x86_64", NotFixedYet: true},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.family == "" {
+				tt.family = constant.RedHat
+			}
+			if tt.req.packName == "" {
+				tt.req = request{packName: "nginx", versionRelease: "1.0"}
+			}
+			if tt.pack.Name == "" {
+				tt.pack = ovalmodels.Package{Name: "nginx", Version: "2.0", NotFixedYet: true}
+			}
+			def := ovalmodels.Definition{AffectedPacks: []ovalmodels.Package{tt.pack}}
+			if tt.state != "" {
+				def.Advisory.AffectedResolution = []ovalmodels.Resolution{{
+					State: tt.state, Components: []ovalmodels.Component{{Component: tt.component}},
+				}}
+			}
+			if tt.family == constant.Amazon {
+				def.Advisory.AffectedRepository = "amzn2-core"
+			}
+			affected, unfixed, state, fixedIn, err := isOvalDefAffected(def, tt.req, tt.family, tt.release, models.Kernel{}, []string{"nginx:1.16"})
+			if err != nil || affected != tt.want || state != tt.wantState {
+				t.Errorf("got affected=%t, state=%q, err=%v; want %t, %q", affected, state, err, tt.want, tt.wantState)
+			}
+			if tt.name == "wrong module" || tt.name == "wrong Amazon repository" {
+				if unfixed || fixedIn != "" {
+					t.Errorf("unmatched package: unfixed=%t fixedIn=%q", unfixed, fixedIn)
+				}
+			} else if !unfixed || fixedIn != "2.0" {
+				t.Errorf("matched package: unfixed=%t fixedIn=%q", unfixed, fixedIn)
+			}
+		})
+	}
+}
