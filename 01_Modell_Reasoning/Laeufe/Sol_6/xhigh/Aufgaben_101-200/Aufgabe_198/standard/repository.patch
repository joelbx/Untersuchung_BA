+func TestRedHatUpdatePreservesFixState(t *testing.T) {
+	r := models.ScanResult{ScannedCves: models.VulnInfos{
+		"CVE-2024-1234": {AffectedPackages: models.PackageFixStatuses{
+			{Name: "existing", NotFixedYet: true, FixState: "Affected", FixedIn: "2.0"},
+			{Name: "shared", NotFixedYet: true, FixState: "Fix deferred", FixedIn: "1.0"},
+		}},
+	}}
+	dp := defPacks{
+		def: ovalmodels.Definition{Title: "CVE-2024-1234", Advisory: ovalmodels.Advisory{Cves: []ovalmodels.Cve{{CveID: "CVE-2024-1234"}}}},
+		binpkgFixstat: map[string]fixStat{
+			"shared": {notFixedYet: true, fixedIn: "3.0"},
+			"new":    {notFixedYet: true, fixState: "Out of support scope", fixedIn: "4.0"},
+		},
+	}
+	RedHatBase{Base: Base{family: constant.RedHat}}.update(&r, dp)
+	got := r.ScannedCves["CVE-2024-1234"]
+	if len(got.DistroAdvisories) != 0 {
+		t.Errorf("unexpected advisory: %+v", got.DistroAdvisories)
+	}
+	got.AffectedPackages.Sort()
+	want := models.PackageFixStatuses{
+		{Name: "existing", NotFixedYet: true, FixState: "Affected", FixedIn: "2.0"},
+		{Name: "new", NotFixedYet: true, FixState: "Out of support scope", FixedIn: "4.0"},
+		{Name: "shared", NotFixedYet: true, FixState: "Fix deferred", FixedIn: "3.0"},
+	}
+	if !reflect.DeepEqual(got.AffectedPackages, want) {
+		t.Errorf("got %+v, want %+v", got.AffectedPackages, want)
+	}
+}
