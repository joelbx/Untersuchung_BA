+def get_isbn_10_and_13(isbns: str | list[str] | None) -> tuple[list[str], list[str]]:
+    """Return compact ISBN-10 and ISBN-13 values from IA metadata."""
+    isbn_10: list[str] = []
+    isbn_13: list[str] = []
+    values = [isbns] if isinstance(isbns, str) else isbns or []
+
+    for value in values:
+        if not isinstance(value, str):
+            continue
+        isbn = re.sub(r'[\s-]', '', value).upper()
+        if re.fullmatch(r'\d{9}[\dX]', isbn):
+            isbn_10.append(isbn)
+        elif re.fullmatch(r'\d{13}', isbn):
+            isbn_13.append(isbn)
+
+    return isbn_10, isbn_13
+
+
+def get_publisher_and_place(
+    publishers: str | list[str] | None,
+) -> tuple[list[str], list[str]]:
+    """Split IA's ``Place : Publisher`` entries into Open Library fields."""
+    publisher_names: list[str] = []
+    publish_places: list[str] = []
+    values = [publishers] if isinstance(publishers, str) else publishers or []
+
+    for value in values:
+        if not isinstance(value, str):
+            continue
+        if ':' in value:
+            place, publisher = (part.strip() for part in value.split(':', 1))
+            if place and publisher:
+                publish_places.append(place)
+                publisher_names.append(publisher)
+        elif publisher := value.strip():
+            publisher_names.append(publisher)
+
+    return publisher_names, publish_places
+
