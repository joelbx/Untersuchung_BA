+def test_get_ia_record_normalizes_mixed_ia_identification_fields() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            "title": "Example",
+            "isbn": [" 0-306-40615-2 ", " 978 0 306 40615 7 ", "bad", ""],
+            "publisher": [
+                "  New York : Simon & Schuster  ",
+                " Other Publisher ",
+                "  ",
+            ],
+        }
+    )
+
+    assert result["isbn_10"] == ["0306406152"]
+    assert result["isbn_13"] == ["9780306406157"]
+    assert result["publishers"] == ["Simon & Schuster", "Other Publisher"]
+    assert result["publish_places"] == ["New York"]
+    assert "isbn" not in result
+    assert "publisher" not in result
+
+
+@pytest.mark.parametrize("value", [None, "", [], [" ", " : "]])
+def test_get_ia_record_omits_empty_identification_fields(value) -> None:
+    result = code.ia_importapi.get_ia_record({"isbn": value, "publisher": value})
+    assert "isbn_10" not in result
+    assert "isbn_13" not in result
+    assert "publishers" not in result
+    assert "publish_places" not in result
