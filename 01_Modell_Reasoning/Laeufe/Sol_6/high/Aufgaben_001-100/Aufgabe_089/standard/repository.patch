+func TestSnapshotValidation(t *testing.T) {
+	const invalid = `namespace: default
+flags:
+- key: example
+  name: Example
+  variants:
+  - key: existing
+    name: Existing
+  rules:
+  - segment: missing
+    distributions:
+    - variant: absent
+      rollout: 100
+segments: []
+`
+	source := fstest.MapFS{"features.yaml": &fstest.MapFile{Data: []byte(invalid)}}
+	for _, build := range []struct {
+		name string
+		fn   func() (*StoreSnapshot, error)
+	}{
+		{"paths", func() (*StoreSnapshot, error) { return SnapshotFromPaths(source, "features.yaml") }},
+		{"filesystem", func() (*StoreSnapshot, error) { return SnapshotFromFS(zap.NewNop(), source) }},
+	} {
+		t.Run(build.name, func(t *testing.T) {
+			for attempt := 0; attempt < 2; attempt++ {
+				_, err := build.fn()
+				require.Error(t, err)
+				issues, ok := cue.Unwrap(err)
+				require.True(t, ok)
+				require.Len(t, issues, 2)
+				assert.Contains(t, issues[0].Error(), `references unknown segment "missing"`)
+				assert.Contains(t, issues[1].Error(), `references unknown variant "absent"`)
+			}
+		})
+	}
+}
