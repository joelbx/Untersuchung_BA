+			variants[scalar(field(variant, "key"))] = true
+		}
+		for i, rule := range sequence(field(flag, "rules")) {
+			checkSegments(flagKey, i, field(rule, "segment"))
+			for _, distribution := range sequence(field(rule, "distributions")) {
+				key := field(distribution, "variant")
+				if key != nil && !variants[key.Value] {
+					add(fmt.Sprintf("flag %s/%s rule %d references unknown variant %q", namespace, flagKey, i, key.Value), key)
+				}
+			}
+		}
+		for i, rollout := range sequence(field(flag, "rollouts")) {
+			checkSegments(flagKey, i, field(rollout, "segment"))
+		}
+	}
+	return issues
 }
