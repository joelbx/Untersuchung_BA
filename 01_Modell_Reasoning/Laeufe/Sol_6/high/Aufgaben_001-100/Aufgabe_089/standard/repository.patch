@@ -0,0 +1,36 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/spf13/cobra"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestImportRejectsInvalidReferencesOnEveryAttempt(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "features.yaml")
+	content := []byte(`flags:
+- key: flag
+  name: Flag
+  variants:
+  - key: existing
+  rules:
+  - segment: missing
+    distributions:
+    - variant: absent
+      rollout: 100
+segments: []
+`)
+	require.NoError(t, os.WriteFile(path, content, 0600))
+
+	command := &importCommand{}
+	for attempt := 0; attempt < 2; attempt++ {
+		err := command.run(&cobra.Command{}, []string{path})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), `references unknown segment "missing"`)
+		assert.Contains(t, err.Error(), `references unknown variant "absent"`)
+	}
+}
