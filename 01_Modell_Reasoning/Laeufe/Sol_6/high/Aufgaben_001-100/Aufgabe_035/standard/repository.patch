-		return value == n, nil
-	case opNEQ:
-		return value != n, nil
-	case opLT:
-		return n < value, nil
-	case opLTE:
-		return n <= value, nil
-	case opGT:
-		return n > value, nil
-	case opGTE:
-		return n >= value, nil
