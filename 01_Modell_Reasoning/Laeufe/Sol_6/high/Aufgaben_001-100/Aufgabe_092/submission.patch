+def test_upgrade_respects_constraints_and_is_idempotent(monkeypatch, tmp_path_factory):
+    versions = {'namespace.collection': ['1.0.0', '1.1.0', '1.2.0', '1.3.0-beta.1']}
+    installed = [Candidate('namespace.collection', '1.0.0', None, 'dir')]
+    installs = []
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: installed)
+    monkeypatch.setattr(collection, 'install', lambda candidate, *args: installs.append(candidate))
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_versions',
+        lambda self, req: [(version, None) for version in versions[req.fqcn]],
+    )
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_dependencies',
+        lambda self, candidate: {},
+    )
+    output = to_text(tmp_path_factory.mktemp('collection-upgrade'))
+    req = [Requirement('namespace.collection', '>=1.0.0,<1.2.0', None, 'galaxy')]
+
+    collection.install_collections(req, output, [], False, False, False, False, False, None, upgrade=True)
+    assert [candidate.ver for candidate in installs] == ['1.1.0']
+
+    installed[:] = [Candidate('namespace.collection', '1.1.0', None, 'dir')]
+    collection.install_collections(req, output, [], False, False, False, False, False, None, upgrade=True)
+    assert [candidate.ver for candidate in installs] == ['1.1.0']
+
+    collection.install_collections(req, output, [], False, False, False, False, False, None)
+    assert [candidate.ver for candidate in installs] == ['1.1.0']
+
+    installed[:] = [Candidate('namespace.collection', '1.2.0', None, 'dir')]
+    collection.install_collections(req, output, [], False, False, False, False, False, None, upgrade=True)
+    assert [candidate.ver for candidate in installs] == ['1.1.0', '1.1.0']
+
+
+def test_upgrade_transitive_dependencies_and_no_deps(monkeypatch, tmp_path_factory):
+    versions = {
+        'namespace.parent': ['1.0.0', '2.0.0'],
+        'namespace.child': ['1.0.0', '2.0.0'],
+        'namespace.leaf': ['1.0.0', '2.0.0'],
+    }
+    dependencies = {
+        ('namespace.parent', '1.0.0'): {'namespace.child': '>=1.0.0'},
+        ('namespace.parent', '2.0.0'): {'namespace.child': '>=2.0.0'},
+        ('namespace.child', '1.0.0'): {'namespace.leaf': '>=1.0.0'},
+        ('namespace.child', '2.0.0'): {'namespace.leaf': '>=2.0.0'},
+    }
+    installed = [Candidate(fqcn, '1.0.0', None, 'dir') for fqcn in versions]
+    installs = []
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: installed)
+    monkeypatch.setattr(collection, 'install', lambda candidate, *args: installs.append(candidate))
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_versions',
+        lambda self, req: [(version, None) for version in versions[req.fqcn]],
+    )
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_dependencies',
+        lambda self, candidate: dependencies.get((candidate.fqcn, candidate.ver), {}),
+    )
+    output = to_text(tmp_path_factory.mktemp('collection-dependency-upgrade'))
+    req = [Requirement('namespace.parent', '*', None, 'galaxy')]
+
+    collection.install_collections(req, output, [], False, False, False, False, False, None)
+    assert installs == []
+
+    collection.install_collections(req, output, [], False, True, False, False, False, None, upgrade=True)
+    assert [(candidate.fqcn, candidate.ver) for candidate in installs] == [('namespace.parent', '2.0.0')]
+
+    installs[:] = []
+    collection.install_collections(req, output, [], False, False, False, False, False, None, upgrade=True)
+    assert {(candidate.fqcn, candidate.ver) for candidate in installs} == {
+        ('namespace.parent', '2.0.0'), ('namespace.child', '2.0.0'), ('namespace.leaf', '2.0.0'),
+    }
+
+
+def test_upgrade_pre_releases_are_opt_in(monkeypatch, tmp_path_factory):
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: [
+        Candidate('namespace.collection', '1.0.0', None, 'dir'),
+    ])
+    installs = []
+    monkeypatch.setattr(collection, 'install', lambda candidate, *args: installs.append(candidate))
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_versions',
+        lambda self, req: [('1.0.0', None), ('1.1.0-beta.1', None)],
+    )
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_dependencies',
+        lambda self, candidate: {},
+    )
+    output = to_text(tmp_path_factory.mktemp('collection-prerelease-upgrade'))
+    req = [Requirement('namespace.collection', '*', None, 'galaxy')]
+    collection.install_collections(req, output, [], False, False, False, False, False, None, upgrade=True)
+    assert installs == []
+    collection.install_collections(req, output, [], False, False, False, False, True, None, upgrade=True)
+    assert [candidate.ver for candidate in installs] == ['1.1.0-beta.1']
+
+
+def test_upgrade_unsatisfiable_constraint(monkeypatch, tmp_path_factory):
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: [
+        Candidate('namespace.collection', '1.0.0', None, 'dir'),
+    ])
+    monkeypatch.setattr(
+        collection.galaxy_api_proxy.MultiGalaxyAPIProxy, 'get_collection_versions',
+        lambda self, req: [('1.0.0', None), ('1.1.0', None)],
+    )
+    output = to_text(tmp_path_factory.mktemp('collection-conflicting-upgrade'))
+    req = [Requirement('namespace.collection', '>=2.0.0', None, 'galaxy')]
+    with pytest.raises(AnsibleError, match=r'namespace\.collection:>=2\.0\.0 \(direct request\)'):
+        collection.install_collections(req, output, [], False, False, False, False, False, None, upgrade=True)
+
+
+def test_upgrade_flag_passed_for_requirements_file(monkeypatch, tmp_path):
+    requirements_path = tmp_path / 'requirements.yml'
+    requirements_path.write_text('collections:\n  - name: namespace.collection\n    version: ">=1.0.0"\n')
+    mock_install = MagicMock()
+    monkeypatch.setattr('ansible.cli.galaxy.install_collections', mock_install)
+    call_galaxy_cli(['install', '-U', '-r', to_text(requirements_path), '-p', to_text(tmp_path)])
+    assert mock_install.call_args[1]['upgrade'] is True
+    assert mock_install.call_args[0][0][0].fqcn == 'namespace.collection'
+    assert mock_install.call_args[0][0][0].ver == '>=1.0.0'
+
