diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..6620e56
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,110 @@
+---
+- name: Clear collection used by upgrade tests - {{ test_name }}
+  file:
+    path: '{{ galaxy_dir }}/ansible_collections/namespace1/name1'
+    state: absent
+
+- name: Install an older collection - {{ test_name }}
+  command: ansible-galaxy collection install namespace1.name1:0.1.0 -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+
+- name: Upgrade within a version constraint - {{ test_name }}
+  command: ansible-galaxy collection install -U 'namespace1.name1:<1.1.0' -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+  register: constrained_upgrade
+
+- name: Check constrained upgrade - {{ test_name }}
+  assert:
+    that:
+      - "\"Installing 'namespace1.name1:1.0.9' to\" in constrained_upgrade.stdout"
+
+- name: Repeat constrained upgrade - {{ test_name }}
+  command: ansible-galaxy collection install --upgrade 'namespace1.name1:<1.1.0' -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+  register: repeated_upgrade
+
+- name: Check repeat installation is idempotent - {{ test_name }}
+  assert:
+    that:
+      - "\"Installing 'namespace1.name1:\" not in repeated_upgrade.stdout"
+
+- name: Upgrade to a pre-release when requested - {{ test_name }}
+  command: ansible-galaxy collection install --upgrade --pre namespace1.name1 -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+  register: prerelease_upgrade
+
+- name: Check pre-release upgrade - {{ test_name }}
+  assert:
+    that:
+      - "\"Installing 'namespace1.name1:1.1.0-beta.1' to\" in prerelease_upgrade.stdout"
+
+- name: Restore old collection for requirements-file upgrade - {{ test_name }}
+  command: ansible-galaxy collection install --force namespace1.name1:0.1.0 -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+
+- name: Create requirements file for upgrade - {{ test_name }}
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade-requirements.yml'
+    content: |
+      collections:
+        - name: namespace1.name1
+          version: '>=1.0.0,<1.1.0'
+        - name: namespace2.name
+          version: '1.0.0'
+
+- name: Upgrade collections from requirements file - {{ test_name }}
+  command: ansible-galaxy collection install --upgrade -r '{{ galaxy_dir }}/upgrade-requirements.yml' -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+  register: requirements_upgrade
+
+- name: Check requirements-file upgrade - {{ test_name }}
+  assert:
+    that:
+      - "\"Installing 'namespace1.name1:1.0.9' to\" in requirements_upgrade.stdout"
+
+- name: Clear collections used by dependency upgrade tests - {{ test_name }}
+  file:
+    path: '{{ galaxy_dir }}/ansible_collections/{{ item }}'
+    state: absent
+  loop:
+    - parent_dep/parent_collection
+    - child_dep/child_collection
+    - child_dep/child_dep2
+
+- name: Install an outdated dependency - {{ test_name }}
+  command: ansible-galaxy collection install --no-deps child_dep.child_collection:0.4.0 -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+
+- name: Install parent without updating dependencies - {{ test_name }}
+  command: ansible-galaxy collection install --upgrade --no-deps parent_dep.parent_collection -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+
+- name: Read dependency after --no-deps - {{ test_name }}
+  slurp:
+    path: '{{ galaxy_dir }}/ansible_collections/child_dep/child_collection/MANIFEST.json'
+  register: no_deps_manifest
+
+- name: Check --no-deps preserved the dependency - {{ test_name }}
+  assert:
+    that:
+      - (no_deps_manifest.content | b64decode | from_json).collection_info.version == '0.4.0'
+
+- name: Upgrade required dependencies - {{ test_name }}
+  command: ansible-galaxy collection install --upgrade parent_dep.parent_collection -s '{{ test_name }}' {{ galaxy_verbosity }}
+  environment:
+    ANSIBLE_COLLECTIONS_PATH: '{{ galaxy_dir }}/ansible_collections'
+  register: dependency_upgrade
+
+- name: Check dependency upgrade - {{ test_name }}
+  assert:
+    that:
+      - "\"Installing 'child_dep.child_collection:0.9.9' to\" in dependency_upgrade.stdout"
+      - "\"Installing 'child_dep.child_dep2:1.2.2' to\" in dependency_upgrade.stdout"
