+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestConfigDefaults(t *testing.T) {
+	var cfg Config
+	cfg.SetDefaults()
+	if cfg.Capacity != 64 || cfg.GracePeriod != 5*time.Minute || cfg.Clock == nil {
+		t.Fatalf("unexpected defaults: %+v", cfg)
+	}
+}
+
+func TestOverflowAndIndependentCursors(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 3})
+	slow := b.NewCursor()
+	fast := b.NewCursor()
+	b.Append(0, 1, 2, 3, 4, 5, 6)
+
+	read := func(c *Cursor[int], size int) []int {
+		t.Helper()
+		out := make([]int, size)
+		n, err := c.TryRead(out)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return out[:n]
+	}
+	if got := read(fast, 7); !reflect.DeepEqual(got, []int{0, 1, 2, 3, 4, 5, 6}) {
+		t.Fatalf("fast cursor: %v", got)
+	}
+	if got := read(slow, 2); !reflect.DeepEqual(got, []int{0, 1}) {
+		t.Fatalf("slow cursor prefix: %v", got)
+	}
+	b.Append(7, 8)
+	if got := read(slow, 7); !reflect.DeepEqual(got, []int{2, 3, 4, 5, 6, 7, 8}) {
+		t.Fatalf("slow cursor suffix: %v", got)
+	}
+	if got := read(fast, 2); !reflect.DeepEqual(got, []int{7, 8}) {
+		t.Fatalf("fast cursor suffix: %v", got)
+	}
+	if b.base != b.end || len(b.overflow) != 0 {
+		t.Fatalf("items not reclaimed: base=%d end=%d overflow=%d", b.base, b.end, len(b.overflow))
+	}
+	late := b.NewCursor()
+	b.Append(9)
+	if got := read(late, 1); !reflect.DeepEqual(got, []int{9}) {
+		t.Fatalf("late cursor: %v", got)
+	}
+}
+
+func TestGracePeriod(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	slow := b.NewCursor()
+	fast := b.NewCursor()
+	b.Append(1, 2, 3)
+	clock.Advance(30 * time.Second)
+	out := make([]int, 3)
+	if n, err := fast.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("fast read: %d, %v", n, err)
+	}
+	clock.Advance(31 * time.Second)
+	if n, err := slow.TryRead(out); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow read: %d, %v", n, err)
+	}
+	if b.base != b.end || len(b.overflow) != 0 {
+		t.Fatalf("expired cursor retained items: base=%d end=%d", b.base, b.end)
+	}
+}
+
+func TestGraceResetsOnCatchUp(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 2, GracePeriod: time.Minute, Clock: clock})
+	c := b.NewCursor()
+	b.Append(1, 2, 3)
+	clock.Advance(30 * time.Second)
+	out := make([]int, 3)
+	if n, err := c.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("catch up: %d, %v", n, err)
+	}
+	b.Append(4, 5, 6)
+	clock.Advance(31 * time.Second)
+	if n, err := c.TryRead(out); n != 3 || err != nil {
+		t.Fatalf("second backlog: %d, %v", n, err)
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		out := make([]int, 1)
+		n, err := c.Read(context.Background(), out)
+		if n != 1 || out[0] != 42 {
+			result <- errors.New("unexpected read result")
+			return
+		}
+		result <- err
+	}()
+	b.Append(42)
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read did not wake")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read: %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(make([]int, 1)); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+	other := b.NewCursor()
+	closedRead := make(chan error, 1)
+	go func() {
+		_, err := other.Read(context.Background(), make([]int, 1))
+		closedRead <- err
+	}()
+	b.Close()
+	select {
+	case err := <-closedRead:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("blocked read after close: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close did not wake read")
+	}
+	if _, err := other.TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("closed buffer: %v", err)
+	}
+	if _, err := b.NewCursor().TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("cursor after close: %v", err)
+	}
+}
+
+func TestConcurrentReadersAndAppender(t *testing.T) {
+	const count = 1000
+	b := NewBuffer[int](Config{Capacity: count})
+	const readers = 8
+	var wg sync.WaitGroup
+	for i := 0; i < readers; i++ {
+		c := b.NewCursor()
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer c.Close()
+			out := make([]int, 17)
+			for want := 0; want < count; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, got := range out[:n] {
+					if got != want {
+						t.Errorf("got %d, want %d", got, want)
+						return
+					}
+					want++
+				}
+			}
+		}()
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+}
