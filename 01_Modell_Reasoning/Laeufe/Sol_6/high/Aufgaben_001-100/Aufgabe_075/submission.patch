+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"io/ioutil"
+	"net/http"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("LastFM session callback", func() {
+	It("saves the session under the callback user", func() {
+		ds := &tests.MockDataStore{}
+		httpClient := &tests.FakeHttpClient{
+			Res: http.Response{Body: ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"session-1"}}`)), StatusCode: 200},
+		}
+		router := NewRouter(ds)
+		router.client = NewClient("API_KEY", "SECRET", "en", httpClient)
+		Expect(router.fetchSessionKey(context.Background(), "callback-user", "token")).To(Succeed())
+
+		ctx := request.WithUser(context.Background(), model.User{ID: "callback-user"})
+		Expect(ds.UserProps(ctx).Get(sessionKeyProperty)).To(Equal("session-1"))
+		ctx = request.WithUser(context.Background(), model.User{ID: "other-user"})
+		_, err := ds.UserProps(ctx).Get(sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+	})
+})
