+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props
+(
+	user_id varchar(255) not null references user(id) on delete cascade,
+	key varchar(255) not null,
+	value text not null,
+	primary key (user_id, key)
+);
+
+insert into user_props (user_id, key, value)
+select user.id, 'LastFMSessionKey', property.value
+from user join property on property.id = 'LastFMSessionKey_' || user.id;
+
+delete from property
+where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_';
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`drop table user_props;`)
+	return err
+}
diff --git a/db/migration/user_props_test.go b/db/migration/user_props_test.go
new file mode 100644
index 0000000..498807d
--- /dev/null
+++ b/db/migration/user_props_test.go
@@ -0,0 +1,59 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	_, err = db.Exec(`
+create table user (id text primary key);
+create table property (id text primary key, value text not null);
+insert into user (id) values ('user_a'), ('user_b');
+insert into property (id, value) values
+  ('LastFMSessionKey_user_a', 'session-a'),
+  ('LastFMSessionKey_user_b', 'session-b'),
+  ('LastFMSessionKey_deleted-user', 'stale'),
+  ('unrelated', 'keep');
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ userID, want string }{{"user_a", "session-a"}, {"user_b", "session-b"}} {
+		var got string
+		if err := db.QueryRow("select value from user_props where user_id = ? and key = ?", tc.userID, "LastFMSessionKey").Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != tc.want {
+			t.Errorf("user %s: got %q, want %q", tc.userID, got, tc.want)
+		}
+	}
+	var remaining int
+	if err := db.QueryRow("select count(*) from property where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_'").Scan(&remaining); err != nil {
+		t.Fatal(err)
+	}
+	if remaining != 0 {
+		t.Errorf("old session properties remain: %d", remaining)
+	}
+	var unrelated string
+	if err := db.QueryRow("select value from property where id = 'unrelated'").Scan(&unrelated); err != nil || unrelated != "keep" {
+		t.Errorf("unrelated property: got %q, err %v", unrelated, err)
+	}
+}
