--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,61 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{
+		ctx: ctx, ormer: o, tableName: "user_props",
+	}}
+}
+
+func (r *userPropsRepository) Put(key string, value string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").
+		Values(uid, key, value).
+		Suffix("ON CONFLICT(user_id, key) DO UPDATE SET value=excluded.value")
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	sel := Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key})
+	resp := struct{ Value string }{}
+	if err = r.queryOne(sel, &resp); err != nil {
+		return "", err
+	}
+	return resp.Value, nil
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
+
+func (r *userPropsRepository) userID() (string, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return "", model.ErrNotAuthorized
+	}
+	return u.ID, nil
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..ea00150
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,54 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	var first, second model.UserPropsRepository
+
+	BeforeEach(func() {
+		o := orm.NewOrm()
+		users := NewUserRepository(context.Background(), o)
+		Expect(users.Put(&model.User{ID: "user-props-first", UserName: "user-props-first", Email: "user-props-first@example.com"})).To(Succeed())
+		Expect(users.Put(&model.User{ID: "user-props-second", UserName: "user-props-second", Email: "user-props-second@example.com"})).To(Succeed())
+		first = NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-props-first"}), o)
+		second = NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-props-second"}), o)
+	})
+
+	AfterEach(func() {
+		o := orm.NewOrm()
+		_, err := o.Raw("delete from user_props where user_id in (?, ?)", "user-props-first", "user-props-second").Exec()
+		Expect(err).To(Succeed())
+		_, err = o.Raw("delete from user where id in (?, ?)", "user-props-first", "user-props-second").Exec()
+		Expect(err).To(Succeed())
+	})
+
+	It("scopes reads, updates, and deletes to the contextual user", func() {
+		Expect(first.Put("session", "first value")).To(Succeed())
+		_, err := second.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Put("session", "second value")).To(Succeed())
+		Expect(first.Put("session", "updated value")).To(Succeed())
+		Expect(first.Get("session")).To(Equal("updated value"))
+		Expect(second.Get("session")).To(Equal("second value"))
+		Expect(first.Delete("session")).To(Succeed())
+		_, err = first.Get("session")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Get("session")).To(Equal("second value"))
+	})
+
+	It("rejects operations without a user in the context", func() {
+		repo := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(repo.Put("session", "value")).To(Equal(model.ErrNotAuthorized))
+		_, err := repo.Get("session")
+		Expect(err).To(Equal(model.ErrNotAuthorized))
+		Expect(repo.Delete("session")).To(Equal(model.ErrNotAuthorized))
+	})
+})
