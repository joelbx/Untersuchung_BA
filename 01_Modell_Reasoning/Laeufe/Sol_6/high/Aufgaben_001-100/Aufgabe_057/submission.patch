new file mode 100644
index 0000000..097b307
--- /dev/null
+++ b/internal/ext/common.go
@@ -0,0 +1,50 @@
+// Package ext imports and exports Flipt configuration as YAML.
+package ext
+
+// Document is the top-level import/export document.
+type Document struct {
+	Flags    []*Flag    `yaml:"flags,omitempty"`
+	Segments []*Segment `yaml:"segments,omitempty"`
+}
+
+type Flag struct {
+	Key         string     `yaml:"key,omitempty"`
+	Name        string     `yaml:"name,omitempty"`
+	Description string     `yaml:"description,omitempty"`
+	Enabled     bool       `yaml:"enabled"`
+	Variants    []*Variant `yaml:"variants,omitempty"`
+	Rules       []*Rule    `yaml:"rules,omitempty"`
+}
+
+type Variant struct {
+	Key         string      `yaml:"key,omitempty"`
+	Name        string      `yaml:"name,omitempty"`
+	Description string      `yaml:"description,omitempty"`
+	Attachment  interface{} `yaml:"attachment,omitempty"`
+}
+
+type Rule struct {
+	SegmentKey    string          `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type Distribution struct {
+	VariantKey string  `yaml:"variant,omitempty"`
+	Rollout    float32 `yaml:"rollout,omitempty"`
+}
+
+type Segment struct {
+	Key         string        `yaml:"key,omitempty"`
+	Name        string        `yaml:"name,omitempty"`
+	Description string        `yaml:"description,omitempty"`
+	MatchType   string        `yaml:"match_type,omitempty"`
+	Constraints []*Constraint `yaml:"constraints,omitempty"`
+}
+
+type Constraint struct {
+	Type     string `yaml:"type,omitempty"`
+	Property string `yaml:"property,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+	Value    string `yaml:"value,omitempty"`
+}
diff --git a/internal/ext/exporter.go b/internal/ext/exporter.go
new file mode 100644
index 0000000..188682d
--- /dev/null
+++ b/internal/ext/exporter.go
@@ -0,0 +1,104 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type lister interface {
+	ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error)
+	ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error)
+	ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error)
+}
+
+// Exporter writes the configuration held by a store to YAML.
+type Exporter struct {
+	store     lister
+	batchSize uint64
+}
+
+func NewExporter(store lister) *Exporter {
+	return &Exporter{store: store, batchSize: 25}
+}
+
+func (e *Exporter) Export(ctx context.Context, w io.Writer) error {
+	doc := new(Document)
+	batchSize := e.batchSize
+	if batchSize == 0 {
+		batchSize = 25
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		flags, err := e.store.ListFlags(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting flags: %w", err)
+		}
+		for _, f := range flags {
+			flag := &Flag{Key: f.Key, Name: f.Name, Description: f.Description, Enabled: f.Enabled}
+			variantKeys := make(map[string]string, len(f.Variants))
+			for _, v := range f.Variants {
+				variant := &Variant{Key: v.Key, Name: v.Name, Description: v.Description}
+				if v.Attachment != "" {
+					if err := json.Unmarshal([]byte(v.Attachment), &variant.Attachment); err != nil {
+						return fmt.Errorf("decoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+				}
+				flag.Variants = append(flag.Variants, variant)
+				variantKeys[v.Id] = v.Key
+			}
+
+			// Rules are fetched separately because ListFlags only includes variants.
+			rules, err := e.store.ListRules(ctx, f.Key)
+			if err != nil {
+				return fmt.Errorf("getting rules for flag %q: %w", f.Key, err)
+			}
+			for _, r := range rules {
+				rule := &Rule{SegmentKey: r.SegmentKey, Rank: uint(r.Rank)}
+				for _, d := range r.Distributions {
+					rule.Distributions = append(rule.Distributions, &Distribution{
+						VariantKey: variantKeys[d.VariantId], Rollout: d.Rollout,
+					})
+				}
+				flag.Rules = append(flag.Rules, rule)
+			}
+			doc.Flags = append(doc.Flags, flag)
+		}
+		if uint64(len(flags)) < batchSize {
+			break
+		}
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		segments, err := e.store.ListSegments(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting segments: %w", err)
+		}
+		for _, s := range segments {
+			segment := &Segment{Key: s.Key, Name: s.Name, Description: s.Description}
+			if s.MatchType != flipt.MatchType_ALL_MATCH_TYPE {
+				segment.MatchType = s.MatchType.String()
+			}
+			for _, c := range s.Constraints {
+				segment.Constraints = append(segment.Constraints, &Constraint{
+					Type: c.Type.String(), Property: c.Property, Operator: c.Operator, Value: c.Value,
+				})
+			}
+			doc.Segments = append(doc.Segments, segment)
+		}
+		if uint64(len(segments)) < batchSize {
+			break
+		}
+	}
+
+	enc := yaml.NewEncoder(w)
+	if err := enc.Encode(doc); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	return enc.Close()
+}
diff --git a/internal/ext/ext_test.go b/internal/ext/ext_test.go
new file mode 100644
index 0000000..b4c341c
--- /dev/null
+++ b/internal/ext/ext_test.go
@@ -0,0 +1,193 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type memoryStore struct {
+	flags         []*flipt.Flag
+	segments      []*flipt.Segment
+	rules         map[string][]*flipt.Rule
+	distributions []*flipt.CreateDistributionRequest
+}
+
+func (m *memoryStore) CreateFlag(_ context.Context, r *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	f := &flipt.Flag{Key: r.Key, Name: r.Name, Description: r.Description, Enabled: r.Enabled}
+	m.flags = append(m.flags, f)
+	return f, nil
+}
+func (m *memoryStore) CreateVariant(_ context.Context, r *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	v := &flipt.Variant{Id: r.FlagKey + ":" + r.Key, FlagKey: r.FlagKey, Key: r.Key, Name: r.Name, Description: r.Description, Attachment: r.Attachment}
+	for _, f := range m.flags {
+		if f.Key == r.FlagKey {
+			f.Variants = append(f.Variants, v)
+		}
+	}
+	return v, nil
+}
+func (m *memoryStore) CreateSegment(_ context.Context, r *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s := &flipt.Segment{Key: r.Key, Name: r.Name, Description: r.Description, MatchType: r.MatchType}
+	m.segments = append(m.segments, s)
+	return s, nil
+}
+func (m *memoryStore) CreateConstraint(_ context.Context, r *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	c := &flipt.Constraint{SegmentKey: r.SegmentKey, Type: r.Type, Property: r.Property, Operator: r.Operator, Value: r.Value}
+	for _, s := range m.segments {
+		if s.Key == r.SegmentKey {
+			s.Constraints = append(s.Constraints, c)
+		}
+	}
+	return c, nil
+}
+func (m *memoryStore) CreateRule(_ context.Context, r *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	if m.rules == nil {
+		m.rules = make(map[string][]*flipt.Rule)
+	}
+	rule := &flipt.Rule{Id: r.FlagKey + ":" + r.SegmentKey, FlagKey: r.FlagKey, SegmentKey: r.SegmentKey, Rank: r.Rank}
+	m.rules[r.FlagKey] = append(m.rules[r.FlagKey], rule)
+	return rule, nil
+}
+func (m *memoryStore) CreateDistribution(_ context.Context, r *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	m.distributions = append(m.distributions, r)
+	d := &flipt.Distribution{RuleId: r.RuleId, VariantId: r.VariantId, Rollout: r.Rollout}
+	for _, rules := range m.rules {
+		for _, rule := range rules {
+			if rule.Id == r.RuleId {
+				rule.Distributions = append(rule.Distributions, d)
+			}
+		}
+	}
+	return d, nil
+}
+func bounds(length int, opts ...storage.QueryOption) (int, int) {
+	p := new(storage.QueryParams)
+	for _, opt := range opts {
+		opt(p)
+	}
+	if p.Offset >= uint64(length) {
+		return length, length
+	}
+	start := int(p.Offset)
+	end := length
+	if p.Limit > 0 && uint64(end-start) > p.Limit {
+		end = start + int(p.Limit)
+	}
+	return start, end
+}
+func (m *memoryStore) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	start, end := bounds(len(m.flags), opts...)
+	return m.flags[start:end], nil
+}
+func (m *memoryStore) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	start, end := bounds(len(m.segments), opts...)
+	return m.segments[start:end], nil
+}
+func (m *memoryStore) ListRules(_ context.Context, key string, opts ...storage.QueryOption) ([]*flipt.Rule, error) {
+	rules := m.rules[key]
+	start, end := bounds(len(rules), opts...)
+	return rules[start:end], nil
+}
+
+func TestImportExportAttachmentsAndRelationships(t *testing.T) {
+	input := `flags:
+- key: checkout
+  name: Checkout
+  enabled: true
+  variants:
+  - key: on
+    attachment:
+      nested:
+      - {one: 1, empty: null}
+      - [true, 2.5, hello]
+      4: four
+  - key: off
+  - key: empty
+    attachment: ""
+  rules:
+  - segment: members
+    rank: 1
+    distributions:
+    - variant: on
+      rollout: 42.5
+segments:
+- key: members
+  name: Members
+  match_type: ANY_MATCH_TYPE
+  constraints:
+  - type: STRING_COMPARISON_TYPE
+    property: plan
+    operator: eq
+    value: paid
+`
+	store := new(memoryStore)
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if got := store.flags[0].Variants[1].Attachment; got != "" {
+		t.Fatalf("missing attachment = %q", got)
+	}
+	if got := store.flags[0].Variants[2].Attachment; got != "" {
+		t.Fatalf("empty attachment = %q", got)
+	}
+	if len(store.distributions) != 1 || store.distributions[0].VariantId != "checkout:on" {
+		t.Fatalf("distributions = %#v", store.distributions)
+	}
+	var attachment interface{}
+	if err := json.Unmarshal([]byte(store.flags[0].Variants[0].Attachment), &attachment); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]interface{}{"nested": []interface{}{map[string]interface{}{"one": float64(1), "empty": nil}, []interface{}{true, 2.5, "hello"}}, "4": "four"}
+	if !reflect.DeepEqual(attachment, want) {
+		t.Fatalf("attachment = %#v", attachment)
+	}
+
+	exporter := NewExporter(store)
+	exporter.batchSize = 1 // exercise the final empty page for exact multiples
+	var output bytes.Buffer
+	if err := exporter.Export(context.Background(), &output); err != nil {
+		t.Fatal(err)
+	}
+	var doc Document
+	if err := yaml.Unmarshal(output.Bytes(), &doc); err != nil {
+		t.Fatal(err)
+	}
+	if len(doc.Flags) != 1 || len(doc.Segments) != 1 || len(doc.Flags[0].Rules) != 1 || len(doc.Flags[0].Rules[0].Distributions) != 1 {
+		t.Fatalf("incomplete export: %s", output.String())
+	}
+	if _, ok := doc.Flags[0].Variants[0].Attachment.(map[interface{}]interface{}); !ok {
+		t.Fatalf("attachment was not exported as a YAML map: %s", output.String())
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil || doc.Segments[0].MatchType != "ANY_MATCH_TYPE" {
+		t.Fatalf("missing values changed: %s", output.String())
+	}
+}
+
+func TestImportStringAndLegacyJSONAttachments(t *testing.T) {
+	input := `flags:
+- key: example
+  variants:
+  - key: text
+    attachment: "true"
+  - key: old
+    attachment: '{"numbers":[1,null]}'
+`
+	store := new(memoryStore)
+	if err := NewImporter(store).Import(context.Background(), strings.NewReader(input)); err != nil {
+		t.Fatal(err)
+	}
+	if got := store.flags[0].Variants[0].Attachment; got != `"true"` {
+		t.Fatalf("string attachment = %q", got)
+	}
+	if got := store.flags[0].Variants[1].Attachment; got != `{"numbers":[1,null]}` {
+		t.Fatalf("legacy attachment = %q", got)
+	}
+}
