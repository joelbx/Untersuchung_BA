diff --git a/utils/hasher/hasher.go b/utils/hasher/hasher.go
index 7856691..1d8c682 100644
--- a/utils/hasher/hasher.go
+++ b/utils/hasher/hasher.go
@@ -1,44 +1,86 @@
 package hasher
 
-import "hash/maphash"
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"hash/maphash"
+	"sync"
+)
 
+var globalSeed = maphash.MakeSeed()
 var instance = NewHasher()
 
 func Reseed(id string) {
 	instance.Reseed(id)
 }
 
+func SetSeed(id, seed string) {
+	instance.SetSeed(id, seed)
+}
+
 func HashFunc() func(id, str string) uint64 {
 	return instance.HashFunc()
 }
 
-type hasher struct {
-	seeds map[string]maphash.Seed
+// Hasher keeps a seed for each identifier. All instances share the same
+// maphash seed so an explicit identifier and seed hash the same within a process.
+type Hasher struct {
+	mu    sync.Mutex
+	seeds map[string]string
+	seed  maphash.Seed
 }
 
-func NewHasher() *hasher {
-	h := new(hasher)
-	h.seeds = make(map[string]maphash.Seed)
-	return h
+func NewHasher() *Hasher {
+	return &Hasher{
+		seeds: make(map[string]string),
+		seed:  globalSeed,
+	}
 }
 
-// Reseed generates a new seed for the given id
-func (h *hasher) Reseed(id string) {
-	h.seeds[id] = maphash.MakeSeed()
+// SetSeed assigns a reproducible seed to the given identifier.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	h.seeds[id] = seed
+	h.mu.Unlock()
 }
 
-// HashFunc returns a function that hashes a string using the seed for the given id
-func (h *hasher) HashFunc() func(id, str string) uint64 {
+// Reseed generates a new seed for the given identifier.
+func (h *Hasher) Reseed(id string) {
+	h.SetSeed(id, randomSeed())
+}
+
+// HashFunc returns a function that uses the current seed for each identifier.
+func (h *Hasher) HashFunc() func(id, str string) uint64 {
 	return func(id, str string) uint64 {
-		var hash maphash.Hash
-		var seed maphash.Seed
-		var ok bool
-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
+		h.mu.Lock()
+		seed, ok := h.seeds[id]
+		if !ok {
+			seed = randomSeed()
 			h.seeds[id] = seed
 		}
-		hash.SetSeed(seed)
-		_, _ = hash.WriteString(str)
+		h.mu.Unlock()
+
+		var hash maphash.Hash
+		hash.SetSeed(h.seed)
+		writeString(&hash, id)
+		writeString(&hash, seed)
+		writeString(&hash, str)
 		return hash.Sum64()
 	}
 }
+
+func randomSeed() string {
+	var bytes [16]byte
+	if _, err := rand.Read(bytes[:]); err != nil {
+		panic(err)
+	}
+	return hex.EncodeToString(bytes[:])
+}
+
+func writeString(hash *maphash.Hash, value string) {
+	var length [8]byte
+	binary.LittleEndian.PutUint64(length[:], uint64(len(value)))
+	_, _ = hash.Write(length[:])
+	_, _ = hash.WriteString(value)
+}
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..ea937c1 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,46 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the original hash when an explicit seed is restored", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("id", "first seed")
+		original := hashFunc("id", input)
+
+		h.Reseed("id")
+		Expect(hashFunc("id", input)).NotTo(Equal(original))
+
+		h.SetSeed("id", "first seed")
+		Expect(hashFunc("id", input)).To(Equal(original))
+		Expect(h.HashFunc()("id", input)).To(Equal(original))
+	})
+
+	It("uses the same explicit seed across hasher instances", func() {
+		first := hasher.NewHasher()
+		second := hasher.NewHasher()
+		first.SetSeed("id", "shared seed")
+		second.SetSeed("id", "shared seed")
+		Expect(first.HashFunc()("id", input)).To(Equal(second.HashFunc()("id", input)))
+	})
+
+	It("initializes missing seeds and keeps ids independent", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		initial := hashFunc("unseeded", input)
+		Expect(hashFunc("unseeded", input)).To(Equal(initial))
+
+		h.SetSeed("other", "explicit")
+		Expect(hashFunc("unseeded", input)).To(Equal(initial))
+	})
+
+	It("sets a seed on the global hasher", func() {
+		const id = "global-explicit-seed-test"
+		hasher.SetSeed(id, "first seed")
+		original := hasher.HashFunc()(id, input)
+		hasher.Reseed(id)
+		Expect(hasher.HashFunc()(id, input)).NotTo(Equal(original))
+		hasher.SetSeed(id, "first seed")
+		Expect(hasher.HashFunc()(id, input)).To(Equal(original))
+	})
 })
