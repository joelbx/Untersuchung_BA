+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	tests := []struct {
+		name       string
+		listenAddr string
+		publicAddr string
+		want       string
+	}{
+		{"ipv4 wildcard", "0.0.0.0:8080", "", "proxy.example.com:8080"},
+		{"ipv6 wildcard", "[::]:8081", "", "proxy.example.com:8081"},
+		{"default port", "0.0.0.0", "", "proxy.example.com:3026"},
+		{"explicit host", "kube.example.com:8080", "", "kube.example.com:8080"},
+		{"public address", "0.0.0.0:8080", "public.example.com:9443", "public.example.com:9443"},
+	}
+	for _, tt := range tests {
+		c.Log(tt.name)
+		tc := &TeleportClient{}
+		tc.WebProxyAddr = "old.example.com:3080"
+		err := tc.applyProxySettings(ProxySettings{
+			SSH:  SSHProxySettings{PublicAddr: "proxy.example.com:443"},
+			Kube: KubeProxySettings{Enabled: true, ListenAddr: tt.listenAddr, PublicAddr: tt.publicAddr},
+		})
+		c.Assert(err, check.IsNil)
+		c.Assert(tc.KubeProxyAddr, check.Equals, tt.want)
+	}
+
+	// Addresses loaded from a saved profile must also resolve wildcard hosts.
+	conf := &Config{KubeProxyAddr: "[::]:8080", WebProxyAddr: "proxy.example.com:443"}
+	host, port := conf.KubeProxyHostPort()
+	c.Assert(host, check.Equals, "proxy.example.com")
+	c.Assert(port, check.Equals, 8080)
+	conf.WebProxyAddr = "[2001:db8::1]:443"
+	c.Assert(conf.KubeClusterAddr(), check.Equals, "https://[2001:db8::1]:8080")
+}
