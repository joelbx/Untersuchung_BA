+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	tests := []struct {
+		name       string
+		proxy      string
+		wantAddr   string
+		wantEnable bool
+		wantError  string
+	}{
+		{"shorthand", "kube_listen_addr: 0.0.0.0:8080", "0.0.0.0:8080", true, ""},
+		{"default port", "kube_listen_addr: kube.example.com", "kube.example.com:3026", true, ""},
+		{"disabled legacy", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no", "0.0.0.0:8080", true, ""},
+		{"disabled legacy address", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:9999", "0.0.0.0:8080", true, ""},
+		{"enabled legacy", "kubernetes:\n    enabled: yes\n    listen_addr: 0.0.0.0:8080", "0.0.0.0:8080", true, ""},
+		{"conflict", "kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes", "", false, "proxy_service.kube_listen_addr conflicts with proxy_service.kubernetes.enabled"},
+	}
+	for _, tt := range tests {
+		c.Log(tt.name)
+		conf, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  " + tt.proxy + "\n"))
+		if tt.wantError != "" {
+			c.Assert(err, check.NotNil)
+			c.Assert(strings.Contains(err.Error(), tt.wantError), check.Equals, true)
+			continue
+		}
+		c.Assert(err, check.IsNil)
+		cfg := service.MakeDefaultConfig()
+		c.Assert(ApplyFileConfig(conf, cfg), check.IsNil)
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, tt.wantEnable)
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, tt.wantAddr)
+	}
+}
