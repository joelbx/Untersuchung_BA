+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+func TestNewResource(t *testing.T) {
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "")
+
+	check := func(wantName, wantVersion string) {
+		t.Helper()
+		res, err := newResource(context.Background(), "v1.2.3")
+		if err != nil {
+			t.Fatal(err)
+		}
+		attrs := res.Set()
+		for _, tc := range []struct {
+			key  attribute.Key
+			want string
+		}{
+			{"service.name", wantName},
+			{"service.version", wantVersion},
+		} {
+			got, ok := attrs.Value(tc.key)
+			if !ok || got.AsString() != tc.want {
+				t.Errorf("%s = %q, want %q", tc.key, got.AsString(), tc.want)
+			}
+		}
+	}
+
+	check("flipt", "v1.2.3")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "service.name=from-attributes,service.version=from-env,custom.key=custom-value")
+	check("from-attributes", "from-env")
+	t.Setenv("OTEL_SERVICE_NAME", "from-service-name")
+	check("from-service-name", "from-env")
+
+	res, err := newResource(context.Background(), "v1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, ok := res.Set().Value("custom.key")
+	if !ok || got.AsString() != "custom-value" {
+		t.Fatalf("custom environment attribute = %q", got.AsString())
+	}
+}
+
+func TestNewProvider(t *testing.T) {
+	provider, err := NewProvider(context.Background(), "v1.2.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = provider.Shutdown(context.Background()) })
+	_, span := provider.Tracer("test").Start(context.Background(), "sampled")
+	defer span.End()
+	if !span.SpanContext().IsSampled() {
+		t.Fatal("provider did not sample span")
+	}
+}
+
+func TestGetExporter(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"Jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"Zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"OTLP HTTP", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"OTLP HTTPS", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318"}}},
+		{"OTLP gRPC", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317"}}},
+		{"OTLP host:port", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317"}}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			exp, shutdown, err := GetExporter(context.Background(), &tt.cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if exp == nil || shutdown == nil {
+				t.Fatal("missing exporter or shutdown")
+			}
+			if err := shutdown(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestGetExporterRepeatedCalls(t *testing.T) {
+	bad := config.TracingConfig{Exporter: config.TracingExporter(255)}
+	for i := 0; i < 2; i++ {
+		_, _, err := GetExporter(context.Background(), &bad)
+		if err == nil || err.Error() != "unsupported tracing exporter: 255" {
+			t.Fatalf("unsupported exporter error = %v", err)
+		}
+	}
+
+	good := config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}
+	for i := 0; i < 2; i++ {
+		exp, shutdown, err := GetExporter(context.Background(), &good)
+		if err != nil || exp == nil || shutdown == nil {
+			t.Fatalf("call %d: exporter = %v, shutdown = %v, err = %v", i, exp, shutdown != nil, err)
+		}
+		if err := shutdown(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestGetExporterInvalidEndpoints(t *testing.T) {
+	for _, endpoint := range []string{"", "localhost", "localhost:abc", "http://%", "ftp://localhost:4317", "grpc://localhost:4317/path"} {
+		t.Run(endpoint, func(t *testing.T) {
+			cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: endpoint}}
+			_, _, err := GetExporter(context.Background(), &cfg)
+			if err == nil || !strings.Contains(err.Error(), "parsing otlp endpoint") {
+				t.Fatalf("error = %v", err)
+			}
+		})
+	}
+}
+
+func TestOTLPHTTPHeadersAndPath(t *testing.T) {
+	requests := make(chan *http.Request, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r
+		w.Header().Set("Content-Type", "application/x-protobuf")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{
+		Endpoint: server.URL + "/custom/traces",
+		Headers:  map[string]string{"X-Test-Header": "configured-value"},
+	}}
+	exp, shutdown, err := GetExporter(context.Background(), &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = shutdown(context.Background()) }()
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSyncer(exp))
+	_, span := provider.Tracer("test").Start(context.Background(), "send")
+	span.End()
+	if err := provider.Shutdown(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case req := <-requests:
+		if req.URL.Path != "/custom/traces" || req.Header.Get("X-Test-Header") != "configured-value" {
+			t.Fatalf("path = %q, header = %q", req.URL.Path, req.Header.Get("X-Test-Header"))
+		}
+	default:
+		t.Fatal("OTLP exporter did not send span")
+	}
+}
