+import type { PassBridge, PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { ItemState } from '@proton/pass/types';
+import { UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+
+import { fetchPassAliases, filterPassAliases } from './PassAliasesProvider.helpers';
+import type { PassAliasesVault } from './interface';
+
+const alias = (revisionTime: number, lastUseTime?: number, state = ItemState.Active): PassBridgeAliasItem =>
+    ({ item: { revisionTime, lastUseTime, state } }) as PassBridgeAliasItem;
+
+describe('Pass aliases provider helpers', () => {
+    it('filters trashed aliases and sorts the remaining aliases by recent use or revision', () => {
+        const old = alias(1);
+        const recentlyUsed = alias(2, 5);
+        const recentlyRevised = alias(4);
+        const trashed = alias(10, undefined, ItemState.Trashed);
+
+        expect(filterPassAliases([old, trashed, recentlyRevised, recentlyUsed])).toEqual([
+            recentlyUsed,
+            recentlyRevised,
+            old,
+        ]);
+    });
+
+    it('fetches aliases and the alias limit with a five minute TTL', async () => {
+        const aliases = [alias(1)];
+        const getAllByShareId = jest.fn().mockResolvedValue(aliases);
+        const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 12 } });
+        const bridge = { alias: { getAllByShareId }, user: { getUserAccess } } as unknown as PassBridge;
+        const vault = { shareId: 'vault' } as PassAliasesVault;
+
+        await expect(fetchPassAliases(bridge, vault)).resolves.toEqual({
+            aliasesCountLimit: 12,
+            filteredAliases: aliases,
+            aliases,
+        });
+        expect(getAllByShareId).toHaveBeenCalledWith('vault', { maxAge: UNIX_MINUTE * 5 });
+        expect(getUserAccess).toHaveBeenCalledWith({ maxAge: UNIX_MINUTE * 5 });
+    });
+});
