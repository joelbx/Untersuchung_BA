+import { act, renderHook, waitFor } from '@testing-library/react';
+
+import type { PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { UNIX_DAY, UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+
+import { usePassAliasesSetup } from './usePassAliasesProviderSetup';
+
+const mockUser = {};
+const mockAddresses: never[] = [];
+const mockAuthStore = {};
+const mockCreateNotification = jest.fn();
+const mockOpenModal = jest.fn();
+const mockTextToClipboard = jest.fn();
+const mockBridge = {
+    init: jest.fn().mockResolvedValue(true),
+    vault: {
+        getDefault: jest.fn().mockResolvedValue(undefined),
+        createDefaultVault: jest.fn().mockResolvedValue({ shareId: 'new-vault', content: { name: 'Personal' } }),
+    },
+    alias: {
+        create: jest.fn().mockResolvedValue(undefined),
+        getAllByShareId: jest.fn(),
+        getAliasOptions: jest.fn().mockResolvedValue({ mailboxes: [], suffixes: [] }),
+    },
+    user: { getUserAccess: jest.fn().mockResolvedValue({ plan: { AliasLimit: 10 } }) },
+};
+
+jest.mock('@proton/components/components', () => ({ useModalStateObject: () => ({ openModal: mockOpenModal }) }));
+jest.mock('@proton/components/containers', () => ({ NOTIFICATION_DEFAULT_EXPIRATION_TIME: 3000 }));
+jest.mock('@proton/components/hooks', () => ({
+    useUser: () => [mockUser],
+    useAddresses: () => [mockAddresses],
+    useAuthentication: () => mockAuthStore,
+    useNotifications: () => ({ createNotification: mockCreateNotification }),
+}));
+jest.mock('@proton/hooks/useAsyncError', () => () => jest.fn());
+jest.mock('@proton/hooks/useIsMounted', () => () => () => true);
+jest.mock('@proton/pass/lib/bridge/PassBridgeProvider', () => ({ usePassBridge: () => mockBridge }));
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    textToClipboard: (text: string) => mockTextToClipboard(text),
+}));
+jest.mock('@proton/shared/lib/helpers/sentry', () => ({ traceInitiativeError: jest.fn() }));
+
+it('loads an empty account without creating a vault, then creates one and refreshes aliases after creation', async () => {
+    const newAlias = {
+        item: { aliasEmail: 'new@example.test', revisionTime: 2, state: 1 },
+    } as PassBridgeAliasItem;
+    mockBridge.alias.getAllByShareId.mockResolvedValueOnce([]).mockResolvedValueOnce([newAlias]);
+
+    const { result } = renderHook(() => usePassAliasesSetup());
+    await waitFor(() => expect(result.current.loading).toBe(false));
+
+    expect(mockBridge.init).toHaveBeenCalledWith({
+        user: mockUser,
+        addresses: mockAddresses,
+        authStore: mockAuthStore,
+    });
+    expect(mockBridge.vault.getDefault).toHaveBeenCalledWith({ maxAge: UNIX_DAY });
+    expect(mockBridge.vault.createDefaultVault).not.toHaveBeenCalled();
+    expect(mockBridge.alias.getAllByShareId).not.toHaveBeenCalled();
+    expect(result.current.hasAliases).toBe(false);
+
+    await act(async () => {
+        await result.current.getAliasOptions();
+    });
+    expect(mockBridge.vault.createDefaultVault).toHaveBeenCalledTimes(1);
+    expect(mockBridge.alias.getAllByShareId).toHaveBeenCalledWith('new-vault', { maxAge: UNIX_MINUTE * 5 });
+    expect(result.current.passAliasesVaultName).toBe('Personal');
+
+    await act(async () => {
+        await result.current.submitNewAlias({
+            name: 'New',
+            alias: 'new@example.test',
+            signedSuffix: 'signed',
+            mailbox: {} as any,
+            note: '',
+        });
+    });
+    expect(mockBridge.alias.getAllByShareId).toHaveBeenCalledWith('new-vault', { maxAge: 0 });
+    expect(result.current.passAliasesItems).toEqual([newAlias]);
+    expect(result.current.hasAliases).toBe(true);
+    expect(mockTextToClipboard).toHaveBeenCalledWith('new@example.test');
+    expect(mockCreateNotification).toHaveBeenCalledWith(expect.objectContaining({ text: 'Alias saved and copied' }));
+});
