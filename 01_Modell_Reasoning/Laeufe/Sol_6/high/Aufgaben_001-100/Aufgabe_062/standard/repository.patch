diff --git a/lib/utils/prompt/stdin.go b/lib/utils/prompt/stdin.go
index 39d9646..9c86430 100644
--- a/lib/utils/prompt/stdin.go
+++ b/lib/utils/prompt/stdin.go
@@ -52,3 +52,13 @@ func SetStdin(rd StdinReader) {
 	defer stdinMU.Unlock()
 	stdin = rd
 }
+
+// NotifyExit closes the global stdin reader so that an active password read
+// can restore the terminal before the program exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(interface{ Close() error }); ok {
+		_ = closer.Close()
+	}
+}
