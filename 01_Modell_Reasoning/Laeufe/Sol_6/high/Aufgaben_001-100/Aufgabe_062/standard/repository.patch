+func TestContextReader_PasswordDeadline(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+
+	term := &fakeTerm{reader: pr, readStarted: make(chan struct{})}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+	defer cr.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	value, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, value)
+	require.True(t, term.restoreCalled)
+
+	cr.mu.Lock()
+	require.Equal(t, readerStateClean, cr.state)
+	cr.mu.Unlock()
+}
+
+func TestContextReader_CloseRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+
+	term := &fakeTerm{reader: pr, readStarted: make(chan struct{})}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+
+	result := make(chan error, 1)
+	go func() {
+		_, err := cr.ReadPassword(context.Background())
+		result <- err
+	}()
+	<-term.readStarted
+	require.NoError(t, cr.Close())
+	require.True(t, term.restoreCalled)
+	require.ErrorIs(t, <-result, ErrReaderClosed)
+	require.NoError(t, cr.Close())
+}
+
+func TestContextReader_RestoreError(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+
+	restoreErr := errors.New("restore failed")
