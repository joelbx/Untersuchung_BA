+package prompt
+
+import (
+	"context"
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNotifyExitRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+
+	term := &fakeTerm{reader: pr, readStarted: make(chan struct{})}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+
+	stdinMU.Lock()
+	previous := stdin
+	stdinMU.Unlock()
+	SetStdin(cr)
+	defer SetStdin(previous)
+
+	result := make(chan error, 1)
+	go func() {
+		_, err := cr.ReadPassword(context.Background())
+		result <- err
+	}()
+	<-term.readStarted
+	NotifyExit()
+	require.True(t, term.restoreCalled)
+	require.ErrorIs(t, <-result, ErrReaderClosed)
+}
