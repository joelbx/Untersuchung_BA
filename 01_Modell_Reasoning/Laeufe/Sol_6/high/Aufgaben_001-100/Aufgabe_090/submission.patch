diff --git a/openlibrary/plugins/openlibrary/tests/test_lists.py b/openlibrary/plugins/openlibrary/tests/test_lists.py
index a282c36..4a53da4 100644
--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,4 +1,5 @@
 from openlibrary.plugins.openlibrary import lists
+import web
 
 
 def test_process_seeds():
@@ -11,3 +12,51 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_from_body_ignores_query_and_uses_first_form_value(monkeypatch):
+    monkeypatch.setattr(
+        lists.web,
+        'data',
+        lambda: b'name=Body+name&name=Later&description=Body+description&seeds=ignored&seeds--0--key=%2Fbooks%2FOL1M&seeds--1=',
+    )
+
+    def unexpected_input(**defaults):
+        raise AssertionError('web.input must not be used for a form body')
+
+    monkeypatch.setattr(lists.web, 'input', unexpected_input)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'Body name'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/books/OL1M'}]
+
+
+def test_list_record_from_body_ignores_invalid_nested_seeds(monkeypatch):
+    monkeypatch.setattr(
+        lists.web,
+        'data',
+        lambda: b'name=List&seeds--0--other=bad&seeds--1--key=&seeds--2--key=%2Fbooks%2FOL2M',
+    )
+    monkeypatch.setattr(lists.web, 'input', lambda **defaults: web.storage(defaults))
+
+    record = lists.ListRecord.from_input()
+
+    assert record.seeds == [{'key': '/books/OL2M'}]
+
+
+def test_list_record_from_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(lists.web, 'data', lambda: b'')
+    monkeypatch.setattr(
+        lists.web,
+        'input',
+        lambda **defaults: web.storage({**defaults, 'name': 'Query name', 'seeds': 'OL1M'}),
+    )
+
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'Query name'
+    assert record.description == ''
+    assert record.seeds == [{'key': '/books/OL1M'}]
