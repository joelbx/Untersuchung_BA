+// pkgPs associates running processes with packages owning their executable or mapped files.
+func (l *base) pkgPs(getOwnerPkgs func([]string) ([]string, error)) error {
+	stdout, err := l.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+
+	pidNames := l.parsePs(stdout)
+	pidLoadedFiles := map[string][]string{}
+	for pid := range pidNames {
+		var paths []string
+		stdout, err := l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to read /proc/%s/exe: %s", pid, err)
+		} else if path, err := l.parseLsProcExe(stdout); err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+		} else {
+			paths = append(paths, path)
+		}
+
+		stdout, err = l.grepProcMap(pid)
+		if err != nil {
+			l.log.Debugf("Failed to read /proc/%s/maps: %s", pid, err)
+		} else {
+			paths = append(paths, l.parseGrepProcMap(stdout)...)
+		}
+		if len(paths) > 0 {
+			pidLoadedFiles[pid] = paths
+		}
+	}
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = l.lsOfListen()
+	if err != nil {
+		l.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range l.parseLsOf(stdout) {
+		portStat, err := models.NewPortStat(ipPort)
+		if err != nil {
+			l.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+			continue
+		}
+		for _, pid := range pids {
+			pidListenPorts[pid] = append(pidListenPorts[pid], *portStat)
+		}
+	}
+
+	for pid, loadedFiles := range pidLoadedFiles {
+		pkgNames, err := getOwnerPkgs(loadedFiles)
+		if err != nil {
+			l.log.Debugf("Failed to get package owners of %v: %s", loadedFiles, err)
+			continue
+		}
+		proc := models.AffectedProcess{
+			PID:             pid,
+			Name:            pidNames[pid],
+			ListenPortStats: pidListenPorts[pid],
+		}
+		l.addAffectedProcess(proc, pkgNames)
+	}
+	return nil
+}
+
+func (l *base) addAffectedProcess(proc models.AffectedProcess, pkgNames []string) {
+	seen := map[string]bool{}
+	for _, name := range pkgNames {
+		if seen[name] {
+			continue
+		}
+		seen[name] = true
+		p, ok := l.Packages[name]
+		if !ok {
+			l.log.Debugf("Package owner %q is not in scanned packages", name)
+			continue
+		}
+		p.AffectedProcs = append(p.AffectedProcs, proc)
+		l.Packages[name] = p
+	}
+}
