+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	tests := []struct {
+		name    string
+		output  string
+		want    []string
+		wantErr bool
+	}{
+		{
+			name: "multiple versions and architectures with ignorable file errors",
+			output: `libgcc 0 4.8.5 39.el7 x86_64
+error: file /root/private: Permission denied
+libgcc 0 4.8.5 39.el7 i686
+file /tmp/unknown is not owned by any package
+libgcc 0 4.8.5 44.el7 x86_64
+error: file /tmp/gone: No such file or directory`,
+			want: []string{"libgcc", "libgcc", "libgcc"},
+		},
+		{
+			name:    "malformed line",
+			output:  "libgcc 0 4.8.5 39.el7 x86_64\nunexpected rpm output",
+			wantErr: true,
+		},
+		{
+			name:    "malformed five field line",
+			output:  "unexpected rpm output has five fields",
+			wantErr: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := r.parseOwnerPkgs(tt.output)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("parseOwnerPkgs() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if !tt.wantErr && !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("parseOwnerPkgs() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAddAffectedProcessWithMultipleRPMOwners(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages["libgcc"] = models.Package{
+		Name: "libgcc", Version: "4.8.5", Release: "44.el7", Arch: "x86_64",
+	}
+	names, err := r.parseOwnerPkgs(`libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 44.el7 x86_64`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.addAffectedProcess(models.AffectedProcess{PID: "42"}, names)
+	procs := r.Packages["libgcc"].AffectedProcs
+	if len(procs) != 1 || procs[0].PID != "42" {
+		t.Errorf("affected processes = %v, want one process with PID 42", procs)
+	}
+}
