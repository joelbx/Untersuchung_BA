diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..6ffac47
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,119 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+function load(file, dependencies) {
+	const module = { exports: {} };
+	const source = fs.readFileSync(path.join(__dirname, '..', file), 'utf8');
+	vm.runInNewContext(source, {
+		module,
+		require: name => dependencies[name],
+	});
+	return module.exports;
+}
+
+describe('WebFinger', () => {
+	const resource = 'acct:some-user@example.com';
+	let uid;
+	let permitted;
+	let checkedUid;
+	let lookedUpSlug;
+	let webfinger;
+
+	beforeEach(() => {
+		uid = 42;
+		permitted = true;
+		checkedUid = undefined;
+		lookedUpSlug = undefined;
+		webfinger = load('src/controllers/well-known.js', {
+			nconf: { get: key => ({ url: 'https://example.com/forum', url_parsed: { hostname: 'example.com' } })[key] },
+			'../privileges': {
+				global: {
+					can: async (privilege, callerUid) => {
+						assert.strictEqual(privilege, 'view:users');
+						checkedUid = callerUid;
+						return permitted;
+					},
+				},
+			},
+			'../user': {
+				getUidByUserslug: async (slug) => {
+					lookedUpSlug = slug;
+					return uid;
+				},
+				getUserField: async () => 'some-user',
+			},
+		}).webfinger;
+	});
+
+	function response() {
+		return {
+			statusCode: 200,
+			sendStatus(code) { this.statusCode = code; return this; },
+			type(value) { this.contentType = value; return this; },
+			json(value) { this.body = value; return this; },
+		};
+	}
+
+	it('registers GET /.well-known/webfinger', () => {
+		let route;
+		const register = load('src/routes/well-known.js', {
+			'./helpers': { tryRoute: handler => handler },
+		});
+		register({ get: (path, handler) => { route = { path, handler }; } }, {}, { 'well-known': { webfinger } });
+		assert.strictEqual(route.path, '/.well-known/webfinger');
+		assert.strictEqual(route.handler, webfinger);
+	});
+
+	it('rejects missing and malformed resources', async () => {
+		const statuses = await Promise.all([undefined, 'some-user@example.com', 'acct:@example.com', 'acct:some-user@other.com', 'acct:some-user@otherexample.com', ['acct:some-user@example.com']].map(async (badResource) => {
+			const res = response();
+			await webfinger({ query: { resource: badResource } }, res);
+			return res.statusCode;
+		}));
+		assert.deepStrictEqual(statuses, [400, 400, 400, 400, 400, 400]);
+		assert.strictEqual(checkedUid, undefined);
+	});
+
+	it('checks the Guest role when uid is absent and denies access without permission', async () => {
+		permitted = false;
+		const res = response();
+		await webfinger({ query: { resource } }, res);
+		assert.strictEqual(checkedUid, 0);
+		assert.strictEqual(res.statusCode, 403);
+		assert.strictEqual(lookedUpSlug, undefined);
+	});
+
+	it('returns 404 when the user slug is unknown', async () => {
+		uid = 0;
+		const res = response();
+		await webfinger({ query: { resource } }, res);
+		assert.strictEqual(lookedUpSlug, 'some-user');
+		assert.strictEqual(res.statusCode, 404);
+	});
+
+	it('returns a WebFinger document with both profile aliases', async () => {
+		const res = response();
+		await webfinger({ uid: 7, query: { resource } }, res);
+		assert.strictEqual(res.statusCode, 200);
+		assert.strictEqual(checkedUid, 7);
+		assert.strictEqual(res.contentType, 'application/jrd+json');
+		assert.strictEqual(res.body.subject, resource);
+		assert.deepStrictEqual(Array.from(res.body.aliases), [
+			'https://example.com/forum/uid/42',
+			'https://example.com/forum/user/some-user',
+		]);
+		assert.strictEqual(res.body.links[0].href, res.body.aliases[1]);
+	});
+
+	it('serves an anonymous request when Guest has permission', async () => {
+		const res = response();
+		await webfinger({ query: { resource } }, res);
+		assert.strictEqual(checkedUid, 0);
+		assert.strictEqual(res.statusCode, 200);
+		assert.strictEqual(res.body.subject, resource);
+	});
+});
