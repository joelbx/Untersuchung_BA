+def test_format_languages_normalizes_names_and_codes(mock_site, add_languages):
+    mock_site.save(
+        {
+            'key': '/languages/ger',
+            'code': 'ger',
+            'name': 'German',
+            'type': {'key': '/type/language'},
+            'name_translated': {'de': ['Deutsch']},
+            'identifiers': {'iso_639_1': ['de']},
+        }
+    )
+    assert format_languages(['German', 'Deutsch', 'de', 'GER', 'es', 'Español', 'spa', 'ENG']) == [
+        {'key': '/languages/ger'},
+        {'key': '/languages/spa'},
+        {'key': '/languages/eng'},
+    ]
+    assert format_languages(['eng', 'eng']) == [{'key': '/languages/eng'}]
+    assert format_languages([]) == []
+    with pytest.raises(InvalidLanguage):
+        format_languages(['unknown language'])
+
+
+def test_format_languages_uses_recorded_names(mock_site, add_languages):
+    mock_site.save(
