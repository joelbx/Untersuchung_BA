+            'name': 'Yiddish',
+            'type': {'key': '/type/language'},
+            'name_translated': {'yi': ['ייִדיש']},
+        }
+    )
+    assert format_languages(['yi', 'ייִדיש']) == [{'key': '/languages/yid'}]
