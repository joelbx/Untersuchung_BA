+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "diag.h"
+
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+
+TouchIDDiagResult TouchIDDiag(void) {
+  TouchIDDiagResult res = {0};
+
+  SecCodeRef code = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &code) == errSecSuccess) {
+    res.has_signature =
+        SecCodeCheckValidity(code, kSecCSDefaultFlags, NULL) == errSecSuccess;
+    CFRelease(code);
+  }
+
+  SecTaskRef task = SecTaskCreateFromSelf(kCFAllocatorDefault);
+  if (task) {
+    CFTypeRef applicationID = SecTaskCopyValueForEntitlement(
+        task, CFSTR("com.apple.application-identifier"), NULL);
+    CFTypeRef accessGroups = SecTaskCopyValueForEntitlement(
+        task, CFSTR("keychain-access-groups"), NULL);
+    res.has_entitlements = applicationID != NULL && accessGroups != NULL;
+    if (applicationID) CFRelease(applicationID);
+    if (accessGroups) CFRelease(accessGroups);
+    CFRelease(task);
+  }
+
+  LAContext *context = [[LAContext alloc] init];
+  res.passed_la_policy_test = [context canEvaluatePolicy:
+      LAPolicyDeviceOwnerAuthenticationWithBiometrics error:nil];
+
+  // Use the same key access policy as registration. An ephemeral key avoids
+  // leaving a credential in the user's keychain.
+  CFErrorRef accessError = NULL;
+  SecAccessControlRef access = SecAccessControlCreateWithFlags(
+      kCFAllocatorDefault, kSecAttrAccessibleWhenUnlockedThisDeviceOnly,
+      kSecAccessControlPrivateKeyUsage | kSecAccessControlBiometryAny,
+      &accessError);
+  if (!access) {
+    if (accessError) CFRelease(accessError);
+    return res;
+  }
+  if (accessError) CFRelease(accessError);
+
+  NSDictionary *attributes = @{
+    (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+    (id)kSecAttrKeySizeInBits : @256,
+    (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+    (id)kSecPrivateKeyAttrs : @{
+      (id)kSecAttrAccessControl : (__bridge id)access,
+    },
+  };
+  CFErrorRef keyError = NULL;
+  SecKeyRef key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes,
+                                       &keyError);
+  BOOL hadEphemeralKey = key != NULL;
+  if (key) CFRelease(key);
+  if (keyError) CFRelease(keyError);
+
+  // Some macOS versions only permit permanent Secure Enclave keys. Probe
+  // those with a unique tag, then remove the key immediately.
+  if (!hadEphemeralKey) {
+    NSData *tag = [[[NSUUID UUID] UUIDString]
+        dataUsingEncoding:NSUTF8StringEncoding];
+    NSDictionary *permanentAttributes = @{
+      (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+      (id)kSecAttrKeySizeInBits : @256,
+      (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+      (id)kSecPrivateKeyAttrs : @{
+        (id)kSecAttrIsPermanent : @YES,
+        (id)kSecAttrAccessControl : (__bridge id)access,
+        (id)kSecAttrApplicationTag : tag,
+      },
+    };
+    keyError = NULL;
+    key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)permanentAttributes,
+                                &keyError);
+    if (key) {
+      NSDictionary *query = @{
+        (id)kSecClass : (id)kSecClassKey,
+        (id)kSecAttrApplicationTag : tag,
+        (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+      };
+      res.passed_secure_enclave_test =
+          SecItemDelete((__bridge CFDictionaryRef)query) == errSecSuccess;
+      CFRelease(key);
+    }
+    if (keyError) CFRelease(keyError);
+  } else {
+    res.passed_secure_enclave_test = 1;
+  }
+
+  CFRelease(access);
+
+  return res;
+}
