+from ansible.plugins.loader import get_with_context_result
+from ansible.errors import AnsiblePluginRemovedError, AnsiblePluginError, AnsibleCollectionUnsupportedVersionError
 
 
 class TestErrors(unittest.TestCase):
 
+    def test_tombstone_context_is_preserved(self):
+        loader = PluginLoader('ActionModule', 'ansible.plugins.action', [], 'action_plugins')
+        with patch.object(loader, '_query_collection_routing_meta', return_value={'tombstone': {'removal_version': '2.0'}}):
+            with self.assertRaises(AnsiblePluginRemovedError) as raised:
+                loader.find_plugin_with_context('ansible.builtin.removed_action')
+            context = raised.exception.plugin_load_context
+            self.assertIsInstance(raised.exception, AnsiblePluginError)
+            self.assertTrue(context.removed)
+            self.assertEqual(context.removal_version, '2.0')
+            self.assertIn('2.0', context.exit_reason)
+            result = loader.get_with_context('ansible.builtin.removed_action')
+            self.assertIsInstance(result, get_with_context_result)
+            self.assertIsNone(result.object)
+            self.assertTrue(result.plugin_load_context.removed)
+            self.assertIsNone(loader.get('ansible.builtin.removed_action'))
+
+    def test_missing_plugin_returns_context(self):
+        loader = PluginLoader('ActionModule', 'ansible.plugins.action', [], 'action_plugins')
+        result = loader.get_with_context('ansible.builtin.no_such_action')
+        self.assertIsNone(result.object)
+        self.assertFalse(result.plugin_load_context.resolved)
+        self.assertEqual(result.plugin_load_context.original_name, 'ansible.builtin.no_such_action')
+
+    def test_plugin_error_without_context_returns_failure_context(self):
+        loader = PluginLoader('ActionModule', 'ansible.plugins.action', [], 'action_plugins')
+        with patch.object(loader, 'find_plugin_with_context', side_effect=AnsibleCollectionUnsupportedVersionError('unsupported collection')):
+            result = loader.get_with_context('example.collection.plugin')
+        self.assertIsNone(result.object)
+        self.assertEqual(result.plugin_load_context.original_name, 'example.collection.plugin')
+        self.assertIn('unsupported collection', result.plugin_load_context.exit_reason)
+
+    def test_redirect_and_deprecation_are_reported_without_warning(self):
+        loader = PluginLoader('ActionModule', 'ansible.plugins.action', [], 'action_plugins')
+
+        def routing(acr, plugin_type, extension=''):
+            if acr.resource == 'old_action':
+                return {'redirect': 'ansible.builtin.command',
+                        'deprecation': {'removal_version': '3.0'}}
+            return None
+
