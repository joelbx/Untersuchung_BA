 import textwrap
 import traceback
 import yaml
@@ -71,6 +72,36 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    _TTY_MACRO = re.compile(
+        r'(?<!\w)(?:'
+        r'(?P<simple>[IBMUC])\((?P<text>[^)]+)\)'
+        r'|(?P<link>[LR])\((?P<label>[^,)]+), ?(?P<target>[^)]+)\)'
+        r'|HORIZONTALLINE(?!\w)'
+        r')'
+    )
+
+    @classmethod
+    def tty_ify(cls, text):
+        def render(match):
+            simple = match.group('simple')
+            if simple in ('I', 'C'):
+                return "`%s'" % match.group('text')
+            if simple == 'B':
+                return '*%s*' % match.group('text')
+            if simple == 'M':
+                return '[%s]' % match.group('text')
+            if simple == 'U':
+                return match.group('text')
+
+            link = match.group('link')
+            if link == 'L':
+                return '%s <%s>' % (match.group('label'), match.group('target'))
+            if link == 'R':
+                return match.group('label')
+            return '\n-------------\n'
+
+        return cls._TTY_MACRO.sub(render, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
