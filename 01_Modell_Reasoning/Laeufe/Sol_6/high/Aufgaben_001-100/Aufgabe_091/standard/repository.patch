+func validateArrayValue(value, property string, comparisonType ComparisonType) error {
+	var (
+		count    int
+		typeName string
+		err      error
+	)
+	var elements []json.RawMessage
+	arrayErr := json.Unmarshal([]byte(value), &elements)
+
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		typeName = "string"
+		var values []string
+		err = json.Unmarshal([]byte(value), &values)
+		count = len(values)
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		typeName = "number"
+		var values []float64
+		err = json.Unmarshal([]byte(value), &values)
+		count = len(values)
+	default:
+		return errors.ErrInvalidf("invalid constraint type: %q", comparisonType.String())
+	}
+
+	if err != nil || arrayErr != nil || !strings.HasPrefix(strings.TrimSpace(value), "[") {
+		return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+	}
+	for _, element := range elements {
+		if bytes.Equal(element, []byte("null")) {
+			return errors.ErrInvalidf("invalid value provided for property %q of type %s", property, typeName)
+		}
+	}
+	if count > MAX_JSON_ARRAY_ITEMS {
+		return errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", property, typeName, MAX_JSON_ARRAY_ITEMS)
+	}
+	return nil
+}
