+func TestValidate_ConstraintListOperators(t *testing.T) {
+	stringHundred := "[" + strings.Repeat(`"x",`, 99) + `"x"]`
+	stringHundredOne := "[" + strings.Repeat(`"x",`, 100) + `"x"]`
+	numberHundred := "[" + strings.Repeat("1,", 99) + "1]"
+	numberHundredOne := "[" + strings.Repeat("1,", 100) + "1]"
+
+	tests := []struct {
+		name, operator, value string
+		typeOf                ComparisonType
+		wantErr               error
+	}{
+		{"string one of", OpIsOneOf, `["red","blue"]`, ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"string not one of uppercase", "ISNOTONEOF", `[]`, ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"number one of", OpIsOneOf, `[1,2.5]`, ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"number not one of", OpIsNotOneOf, `[]`, ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"string 100 items", OpIsOneOf, stringHundred, ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"number 100 items", OpIsNotOneOf, numberHundred, ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"string 101 items", OpIsOneOf, stringHundredOne, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`too many values provided for property "color" of type string (maximum 100)`)},
+		{"number 101 items", OpIsNotOneOf, numberHundredOne, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`too many values provided for property "color" of type number (maximum 100)`)},
+		{"string invalid JSON", OpIsNotOneOf, `["red"`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"number invalid JSON", OpIsOneOf, `[1`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+		{"string wrong type", OpIsOneOf, `["red",1]`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"number wrong type", OpIsNotOneOf, `[1,"2"]`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+		{"string null element", OpIsOneOf, `[null]`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"number null element", OpIsNotOneOf, `[null]`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+		{"string null list", OpIsOneOf, `null`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"number object", OpIsNotOneOf, `{}`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+		{"datetime rejected", OpIsOneOf, `[1]`, ComparisonType_DATETIME_COMPARISON_TYPE, errors.ErrInvalid(`constraint operator "isoneof" is not valid for type datetime`)},
+	}
