+func TestDiffStatusAndPackages(t *testing.T) {
+	current := models.ScanResults{{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"new":    {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}},
+			"same":   {CveID: "same"},
+			"edited": {CveID: "edited", CpeURIs: []string{"changed"}},
+		},
+		Packages: models.Packages{"new-package": {Name: "new-package", Version: "current"}},
+	}}
+	previous := models.ScanResults{{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"old":    {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+			"same":   {CveID: "same"},
+			"edited": {CveID: "edited"},
+		},
+		Packages: models.Packages{"old-package": {Name: "old-package", Version: "previous"}},
+	}}
+	for _, tc := range []struct {
+		name        string
+		plus, minus bool
+		want        models.VulnInfos
+	}{
+		{"plus", true, false, models.VulnInfos{"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}}}},
+		{"minus", false, true, models.VulnInfos{"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}}}},
+		{"both", true, true, models.VulnInfos{
+			"new": {CveID: "new", DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "new-package"}}},
+			"old": {CveID: "old", DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+		}},
+		{"neither", false, false, models.VulnInfos{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			results, err := diff(current, previous, tc.plus, tc.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := results[0]
+			if !reflect.DeepEqual(got.ScannedCves, tc.want) {
+				t.Errorf("CVEs = %v, want %v", got.ScannedCves, tc.want)
+			}
+			if tc.plus && got.Packages["new-package"].Version != "current" {
+				t.Errorf("new package must come from current scan: %v", got.Packages["new-package"])
+			}
+			if tc.minus && got.Packages["old-package"].Version != "previous" {
+				t.Errorf("resolved package must come from previous scan: %v", got.Packages["old-package"])
+			}
+		})
+	}
+
+	withoutPrevious, err := diff(current, nil, true, true)
+	if err != nil || withoutPrevious[0].ScannedCves["new"].DiffStatus != models.DiffPlus {
+		t.Errorf("current-only scan should report additions: %v, %v", withoutPrevious, err)
+	}
+	withoutPlus, err := diff(current, nil, false, true)
+	if err != nil || len(withoutPlus[0].ScannedCves) != 0 {
+		t.Errorf("current-only scan should be empty when plus is disabled: %v, %v", withoutPlus, err)
+	}
+}
