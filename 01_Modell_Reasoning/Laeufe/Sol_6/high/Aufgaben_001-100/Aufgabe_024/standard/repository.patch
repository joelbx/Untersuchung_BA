     def regex_ilike(self, pattern: str, text: str) -> bool:
         """Construct a regex pattern for ILIKE operation and match against the text."""
-        # Remove '_' to ignore single character matches, the same as Infobase.
-        regex_pattern = f"^{pattern.replace('*', '.*').replace('_', '')}$"
+        # An escaped asterisk is literal; an unescaped one is a LIKE wildcard.
+        parts = []
+        i = 0
+        while i < len(pattern):
+            if pattern[i : i + 2] == r'\*':
+                parts.append(r'\*')
+                i += 2
+            elif pattern[i] == '*':
+                parts.append('.*')
+                i += 1
+            elif pattern[i] == '_':
+                # Ignore single-character matches, as Infobase does.
+                i += 1
+            else:
+                parts.append(re.escape(pattern[i]))
+                i += 1
+        regex_pattern = '^' + ''.join(parts) + '$'
         return bool(re.match(regex_pattern, text, re.IGNORECASE))
 
