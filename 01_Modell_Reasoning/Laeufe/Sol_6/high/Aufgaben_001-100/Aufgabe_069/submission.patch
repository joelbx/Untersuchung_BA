+// Matcher tests whether a string satisfies a pattern.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct {
+	regexp *regexp.Regexp
+}
+
+func (m regexpMatcher) Match(in string) bool {
+	return m.regexp.MatchString(in)
+}
+
+type prefixSuffixMatcher struct {
+	prefix  string
+	suffix  string
+	matcher Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if len(in) < len(m.prefix)+len(m.suffix) ||
+		!strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct {
+	matcher Matcher
+}
+
+func (m notMatcher) Match(in string) bool {
+	return !m.matcher.Match(in)
+}
+
+// emailLocalMatcher matches the local part of a valid email address.
+type emailLocalMatcher struct {
+	matcher Matcher
+}
+
+func (m emailLocalMatcher) Match(in string) bool {
+	local, err := (emailLocalTransformer{}).transform(in)
+	return err == nil && m.matcher.Match(local)
+}
+
+// Match parses a literal, glob, regular expression, or matcher template.
+func Match(value string) (Matcher, error) {
+	parts := reVariable.FindStringSubmatch(value)
+	if len(parts) == 0 {
+		if strings.Count(value, "{{") > 1 && strings.Count(value, "{{") == strings.Count(value, "}}") {
+			return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+		}
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter(
+				"%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}",
+				value)
+		}
+		return patternMatcher(value)
+	}
+
+	expr, err := parser.ParseExpr(parts[2])
+	if err != nil {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	inner, err := functionMatcher(expr, value)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return prefixSuffixMatcher{prefix: parts[1], suffix: parts[3], matcher: inner}, nil
+}
+
+// patternMatcher follows the same literal/glob/regexp convention as utils.ReplaceRegexp.
+func patternMatcher(value string) (Matcher, error) {
+	pattern := value
+	if !strings.HasPrefix(value, "^") || !strings.HasSuffix(value, "$") {
+		pattern = "^" + utils.GlobToRegexp(value) + "$"
+	}
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+	}
+	return regexpMatcher{regexp: re}, nil
+}
+
+func functionMatcher(expr ast.Expr, value string) (Matcher, error) {
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	namespace, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	if namespace.Name != "regexp" && namespace.Name != EmailNamespace {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+	fn := selector.Sel.Name
+	if namespace.Name == "regexp" && fn != "match" && fn != "not_match" {
+		return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match.", fn)
+	}
+	if namespace.Name == EmailNamespace && fn != EmailLocalFnName {
+		return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", fn)
+	}
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("%s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	arg, ok := call.Args[0].(*ast.BasicLit)
+	if !ok {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+	}
+	if arg.Kind != token.STRING {
+		return nil, trace.BadParameter("%s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	raw, err := strconv.Unquote(arg.Value)
+	if err != nil {
+		return nil, trace.BadParameter("invalid string literal %q: %v", arg.Value, err)
+	}
+	if namespace.Name == EmailNamespace {
+		inner, err := patternMatcher(raw)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return emailLocalMatcher{matcher: inner}, nil
+	}
+	re, err := regexp.Compile(raw)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", raw, err)
+	}
+	inner := Matcher(regexpMatcher{regexp: re})
+	if fn == "not_match" {
+		return notMatcher{matcher: inner}, nil
+	}
+	return inner, nil
+}
