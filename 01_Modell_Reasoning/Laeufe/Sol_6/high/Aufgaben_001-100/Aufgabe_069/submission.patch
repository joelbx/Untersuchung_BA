+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern string
+		matches []string
+		misses  []string
+	}{
+		{"foo", []string{"foo"}, []string{"foobar", "bar"}},
+		{"*", []string{"", "anything"}, nil},
+		{"foo*bar", []string{"foobar", "foo123bar"}, []string{"foo123barx", "xfoobar"}},
+		{"^foo$", []string{"foo"}, []string{"foobar"}},
+		{`{{regexp.match("foo")}}`, []string{"foo", "xfooy"}, []string{"bar"}},
+		{`{{regexp.not_match("foo")}}`, []string{"bar"}, []string{"foo", "xfooy"}},
+		{`foo-{{regexp.match("bar")}}-baz`, []string{"foo-bar-baz", "foo-xbary-baz"}, []string{"foo-bar", "xfoo-bar-baz", "foo-bar-bazx"}},
+		{`{{email.local("alice")}}`, []string{"alice@example.com"}, []string{"bob@example.com", "invalid"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, in := range tt.matches {
+				assert.True(t, matcher.Match(in), "pattern %q should match %q", tt.pattern, in)
+			}
+			for _, in := range tt.misses {
+				assert.False(t, matcher.Match(in), "pattern %q should reject %q", tt.pattern, in)
+			}
+		})
+	}
+}
+
+func TestMatchErrors(t *testing.T) {
+	tests := []struct {
+		pattern string
+		message string
+	}{
+		{`{{regexp.match("foo")`, `"{{regexp.match(\"foo\")" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`},
+		{`{{other.match("foo")}}`, "unsupported function namespace other, supported namespaces are email and regexp"},
+		{`{{regexp.unknown("foo")}}`, "unsupported function regexp.unknown, supported functions are: regexp.match, regexp.not_match."},
+		{`{{email.unknown("foo")}}`, "unsupported function email.unknown, supported functions are: email.local"},
+		{`{{regexp.match("[")}}`, "failed parsing regexp \"[\": error parsing regexp: missing closing ]: `[`"},
+		{`{{regexp.match()}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{regexp.match("a", "b")}}`, "regexp.match expects exactly one string literal argument"},
+		{`{{regexp.match(external.foo)}}`, `"{{regexp.match(external.foo)}}" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{external.foo}}`, `"{{external.foo}}" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match(regexp.match("a"))}}`, `"{{regexp.match(regexp.match(\"a\"))}}" is not a valid matcher expression - no variables and transformations are allowed`},
+		{`{{regexp.match("a")}}{{regexp.match("b")}}`, `"{{regexp.match(\"a\")}}{{regexp.match(\"b\")}}" is not a valid matcher expression - no variables and transformations are allowed`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern, func(t *testing.T) {
+			_, err := Match(tt.pattern)
+			if assert.Error(t, err) {
+				assert.True(t, trace.IsBadParameter(err))
+				assert.Equal(t, tt.message, err.Error())
+			}
+		})
+	}
+
+	_, err := Variable(`prefix-{{regexp.match("foo")}}-suffix`)
+	if assert.Error(t, err) {
+		assert.Equal(t, `matcher functions (like regexp.match) are not allowed here: "prefix-{{regexp.match(\"foo\")}}-suffix"`, err.Error())
+	}
+	_, err = Variable(`{{email.local(regexp.not_match("foo"))}}`)
+	assert.Error(t, err)
+	assert.True(t, strings.Contains(err.Error(), "matcher functions (like regexp.match) are not allowed here"))
+}
