+func TestEnvVarSubstitutionHookFunc(t *testing.T) {
+	t.Setenv("CONFIG_TEST_PRESENT", "value")
+	t.Setenv("CONFIG_TEST_EMPTY", "")
+	hook := envVarSubstitutionHookFunc()
+
+	tests := []struct {
+		name string
+		kind reflect.Kind
+		data interface{}
+		want interface{}
+	}{
+		{"present", reflect.String, "${CONFIG_TEST_PRESENT}", "value"},
+		{"empty", reflect.String, "${CONFIG_TEST_EMPTY}", ""},
+		{"missing", reflect.String, "${CONFIG_TEST_MISSING}", "${CONFIG_TEST_MISSING}"},
+		{"embedded", reflect.String, "before ${CONFIG_TEST_PRESENT}", "before ${CONFIG_TEST_PRESENT}"},
+		{"invalid first character", reflect.String, "${1CONFIG_TEST_PRESENT}", "${1CONFIG_TEST_PRESENT}"},
+		{"invalid punctuation", reflect.String, "${CONFIG-TEST-PRESENT}", "${CONFIG-TEST-PRESENT}"},
+		{"number", reflect.Int, 123, 123},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := hook(tt.kind, reflect.String, tt.data)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
