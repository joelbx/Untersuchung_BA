+func TestLoadEnvironmentReferences(t *testing.T) {
+	t.Setenv("CONFIG_TEST_LOG_LEVEL", "DEBUG")
+	t.Setenv("CONFIG_TEST_LOG_ENCODING", "json")
+	t.Setenv("CONFIG_TEST_HTTP_PORT", "8085")
+	t.Setenv("CONFIG_TEST_CACHE_TTL", "45s")
+
+	path := filepath.Join(t.TempDir(), "config.yml")
+	contents := `log:
+  level: "${CONFIG_TEST_LOG_LEVEL}"
+  encoding: "${CONFIG_TEST_LOG_ENCODING}"
+  file: "${CONFIG_TEST_MISSING}"
+  grpc_level: "prefix${CONFIG_TEST_LOG_LEVEL}"
+cache:
+  ttl: "${CONFIG_TEST_CACHE_TTL}"
+server:
+  http_port: "${CONFIG_TEST_HTTP_PORT}"
+`
+	require.NoError(t, os.WriteFile(path, []byte(contents), 0600))
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, "DEBUG", result.Config.Log.Level)
+	assert.Equal(t, LogEncodingJSON, result.Config.Log.Encoding)
+	assert.Equal(t, "${CONFIG_TEST_MISSING}", result.Config.Log.File)
+	assert.Equal(t, "prefix${CONFIG_TEST_LOG_LEVEL}", result.Config.Log.GRPCLevel)
+	assert.Equal(t, 45*time.Second, result.Config.Cache.TTL)
+	assert.Equal(t, 8085, result.Config.Server.HTTPPort)
+
+	t.Setenv("FLIPT_LOG_LEVEL", "WARN")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8086")
+	result, err = Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, "WARN", result.Config.Log.Level)
+	assert.Equal(t, 8086, result.Config.Server.HTTPPort)
+}
