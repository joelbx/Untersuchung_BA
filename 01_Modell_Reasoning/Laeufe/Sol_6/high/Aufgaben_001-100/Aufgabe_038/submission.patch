+def test_request_missing_gzip_is_actionable(mocker):
+    mocker.patch.object(urls, 'gzip', None)
+    mocker.patch.object(urls.urllib_request, 'urlopen', return_value=_Response(b'compressed', 'gzip'))
+    with pytest.raises(urls.MissingModuleError) as error:
+        urls.Request().get('http://example.test/')
+    assert error.value.module == 'gzip'
