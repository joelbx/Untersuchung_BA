+def test_request_defaults_and_override(mocker):
+    urlopen = mocker.patch.object(urls.urllib_request, 'urlopen', return_value=_Response(b'data'))
+    request = urls.Request(decompress=False, unredirected_headers=['X-Secret'], headers={'X-Secret': 'value'})
+    request.get('http://example.test/')
+    sent = urlopen.call_args[0][0]
+    assert sent.get_header('Accept-encoding') == 'identity'
+    assert sent.unredirected_hdrs['X-secret'] == 'value'
+
+    request.get('http://example.test/', decompress=True, unredirected_headers=[])
+    sent = urlopen.call_args[0][0]
+    assert sent.get_header('Accept-encoding') == 'gzip'
+    assert 'X-secret' not in sent.unredirected_hdrs
+
