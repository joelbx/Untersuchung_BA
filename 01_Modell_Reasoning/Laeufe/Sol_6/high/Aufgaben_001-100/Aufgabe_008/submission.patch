+
+describe('useLink failed fetch backoff', () => {
+    const abortSignal = new AbortController().signal;
+
+    beforeEach(() => {
+        jest.resetAllMocks();
+        jest.useFakeTimers();
+    });
+
+    afterEach(() => {
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses error code %s for the same link, then retries after backoff',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequst.mockRejectedValue(error);
+            const { result, rerender } = renderHook(() => useLink());
+
+            await expect(result.current.getLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+            rerender();
+            await expect(result.current.getLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+            expect(mockRequst).toHaveBeenCalledTimes(1);
+
+            jest.advanceTimersByTime(10_000);
+            await expect(result.current.getLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+            expect(mockRequst).toHaveBeenCalledTimes(2);
+        }
+    );
+
+    it('keeps errors scoped to the share and link pair', async () => {
+        const error = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequst.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+        await expect(result.current.getLink(abortSignal, 'share', 'other')).rejects.toBe(error);
+        await expect(result.current.getLink(abortSignal, 'otherShare', 'missing')).rejects.toBe(error);
+        await expect(result.current.getLink(abortSignal, 'share', 'missing')).rejects.toBe(error);
+        expect(mockRequst).toHaveBeenCalledTimes(3);
+    });
+
+    it('retries other errors without caching them', async () => {
+        const error = { data: { Code: 5000 } };
+        mockRequst.mockRejectedValue(error);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'share', 'link')).rejects.toBe(error);
+        await expect(result.current.getLink(abortSignal, 'share', 'link')).rejects.toBe(error);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+    });
+
+    it('processes a successful link normally', async () => {
+        const missingError = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequst.mockRejectedValueOnce(missingError).mockResolvedValue({
+            Link: { LinkID: 'link', Name: 'encryptedName', CreateTime: 0, ModifyTime: 0 },
+        });
+        // @ts-ignore
+        decryptSigned.mockResolvedValue({ data: 'decryptedName', verified: 1 });
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'share', 'missing')).rejects.toBe(missingError);
+        await expect(result.current.getLink(abortSignal, 'share', 'link')).resolves.toMatchObject({
+            linkId: 'link',
+            name: 'decryptedName',
+        });
+        expect(mockHookLinksState.setLinks).toHaveBeenCalledWith('share', [
+            expect.objectContaining({
+                encrypted: expect.objectContaining({ linkId: 'link', name: 'encryptedName' }),
+                decrypted: expect.objectContaining({ linkId: 'link', name: 'decryptedName' }),
+            }),
+        ]);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+    });
+});
