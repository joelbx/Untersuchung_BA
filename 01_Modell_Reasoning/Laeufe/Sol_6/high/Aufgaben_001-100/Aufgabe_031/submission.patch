+func TestLoadEnvironmentOverrides(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		path     string
+		logLevel string
+		httpPort string
+		wantLog  string
+		wantPort int
+	}{
+		{name: "defaults", wantLog: "INFO", wantPort: 8080},
+		{name: "default log override", logLevel: "debug", wantLog: "debug", wantPort: 8080},
+		{name: "default port override", httpPort: "8082", wantLog: "INFO", wantPort: 8082},
+		{name: "both default overrides", logLevel: "debug", httpPort: "8082", wantLog: "debug", wantPort: 8082},
+		{name: "file values", path: "./testdata/advanced.yml", wantLog: "WARN", wantPort: 8081},
+		{name: "file overrides", path: "./testdata/advanced.yml", logLevel: "debug", httpPort: "8082", wantLog: "debug", wantPort: 8082},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("FLIPT_LOG_LEVEL", tt.logLevel)
+			t.Setenv("FLIPT_SERVER_HTTP_PORT", tt.httpPort)
+			if tt.logLevel == "" {
+				require.NoError(t, os.Unsetenv("FLIPT_LOG_LEVEL"))
+			}
+			if tt.httpPort == "" {
+				require.NoError(t, os.Unsetenv("FLIPT_SERVER_HTTP_PORT"))
+			}
+
+			res, err := Load(tt.path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantLog, res.Config.Log.Level)
+			assert.Equal(t, tt.wantPort, res.Config.Server.HTTPPort)
+		})
+	}
+}
