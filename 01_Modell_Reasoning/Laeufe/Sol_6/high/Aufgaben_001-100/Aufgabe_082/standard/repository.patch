+type testEventWriter struct {
+	bytes.Buffer
+	closes   int
+	writeErr error
+	closeErr error
+}
+
+func (w *testEventWriter) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	return w.Buffer.Write(p)
+}
+
+func (w *testEventWriter) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+func TestWriterEmitter(t *testing.T) {
+	w := &testEventWriter{}
+	emitter := NewWriterEmitter(w)
+	var _ IAuditLog = emitter
+	var _ Emitter = emitter
+
+	event := &UserLogin{Metadata: Metadata{Type: "user.login"}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, byte('\n'), w.Bytes()[w.Len()-1])
+	var decoded map[string]interface{}
+	require.NoError(t, json.Unmarshal(bytes.TrimSuffix(w.Bytes(), []byte{'\n'}), &decoded))
+	require.Equal(t, "user.login", decoded["event"])
+
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 1, w.closes)
+}
+
+func TestWriterEmitterErrors(t *testing.T) {
+	w := &testEventWriter{writeErr: errors.New("write failed"), closeErr: errors.New("close failed")}
+	emitter := NewWriterEmitter(w)
+	require.Error(t, emitter.EmitAuditEvent(context.Background(), &UserLogin{}))
+	err := emitter.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "close failed")
+	require.Equal(t, 1, w.closes)
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	first, second := &testEventWriter{}, &testEventWriter{}
+	_, err := NewMultiLog(NewWriterEmitter(first), NewWriterLog(second))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+	require.Equal(t, 0, first.closes)
+
+	multi, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+	var _ Emitter = multi
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), &UserLogin{Metadata: Metadata{Type: "user.login"}}))
+	require.Equal(t, first.String(), second.String())
+	require.NoError(t, multi.Close())
+	require.Equal(t, 1, first.closes)
+	require.Equal(t, 1, second.closes)
+}
+
+func TestMultiLogCloseErrors(t *testing.T) {
+	first := &testEventWriter{closeErr: errors.New("first close failed")}
+	second := &testEventWriter{closeErr: errors.New("second close failed")}
+	multi, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+	err = multi.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "first close failed")
+	require.Contains(t, err.Error(), "second close failed")
+	require.Equal(t, 1, first.closes)
+	require.Equal(t, 1, second.closes)
+}
