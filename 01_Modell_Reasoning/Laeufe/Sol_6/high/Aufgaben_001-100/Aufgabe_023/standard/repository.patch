diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..00ceb22
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,44 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	cleanup := AuthenticationCleanupSchedule{Interval: time.Hour, GracePeriod: time.Minute}
+
+	for _, method := range (&AuthenticationMethods{}).AllMethods() {
+		t.Run(method.Name(), func(t *testing.T) {
+			cfg := AuthenticationConfig{}
+			for _, info := range cfg.Methods.AllMethods() {
+				if info.Method != method.Method {
+					continue
+				}
+
+				wantDB := info.Method != auth.Method_METHOD_JWT
+				assert.Equal(t, wantDB, info.RequiresDatabase)
+
+				info.SetCleanup(t, cleanup)
+				assert.False(t, cfg.RequiresDatabase(), "disabled method")
+				assert.False(t, cfg.ShouldRunCleanup(), "disabled method")
+
+				info.Enable(t)
+				assert.Equal(t, wantDB, cfg.RequiresDatabase())
+				assert.Equal(t, wantDB, cfg.ShouldRunCleanup())
+			}
+		})
+	}
+
+	cfg := AuthenticationConfig{}
+	cfg.Methods.JWT.Enabled = true
+	cfg.Methods.JWT.Cleanup = &cleanup
+	cfg.Methods.Token.Enabled = true
+	assert.True(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+	cfg.Methods.Token.Cleanup = &cleanup
+	assert.True(t, cfg.ShouldRunCleanup())
+}
