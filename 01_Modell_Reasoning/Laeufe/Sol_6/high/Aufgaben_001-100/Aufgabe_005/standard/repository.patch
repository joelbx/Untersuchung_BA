+
+def test_init_implicit_no_wrapper(stubs, modules, monkeypatch):
+    for wrapper in machinery.WRAPPERS:
+        monkeypatch.delitem(sys.modules, wrapper, raising=False)
+    monkeypatch.setattr(machinery, "_initialized", False)
+    stubs.ImportFake(modules, monkeypatch).patch()
+
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        machinery.init()
+
+    error = excinfo.value
+    assert isinstance(error, ImportError)
+    assert error.info.wrapper is None
+    assert str(error) == f"No Qt wrapper was importable.\n\n\n{error.info}"
+    assert not machinery._initialized
+
+
+def test_init_implicit_selects_available(stubs, modules, monkeypatch):
+    for wrapper in machinery.WRAPPERS:
+        monkeypatch.delitem(sys.modules, wrapper, raising=False)
+    monkeypatch.setattr(machinery, "_initialized", False)
+    modules["PyQt5"] = True
+    stubs.ImportFake(modules, monkeypatch).patch()
+    monkeypatch.setattr(machinery, "_select_wrapper", lambda args: pytest.fail(
+        "implicit initialization reached explicit selection"))
+
+    info = machinery.init()
+
+    assert info is machinery.INFO
+    assert info.wrapper == "PyQt5"
+    assert info.reason is machinery.SelectionReason.auto
+    assert machinery.USE_PYQT5
+
+
+def test_selection_info_str():
+    short = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default)
+    assert str(short) == "Qt wrapper: PyQt5 (via default)"
+
+    verbose = machinery.SelectionInfo(
+        pyqt6="ImportError: unavailable", pyqt5="ImportError: unavailable",
+        reason=machinery.SelectionReason.auto)
+    assert str(verbose) == (
+        "Qt wrapper info:\n"
+        "PyQt5: ImportError: unavailable\n"
+        "PyQt6: ImportError: unavailable\n"
+        "selected: None (via autoselect)"
+    )
