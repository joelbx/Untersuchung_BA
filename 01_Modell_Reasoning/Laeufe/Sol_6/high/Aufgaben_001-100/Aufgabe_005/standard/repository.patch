diff --git a/tests/unit/misc/test_earlyinit.py b/tests/unit/misc/test_earlyinit.py
index e29cc0a..429f8ec 100644
--- a/tests/unit/misc/test_earlyinit.py
+++ b/tests/unit/misc/test_earlyinit.py
@@ -24,6 +24,7 @@ import sys
 import pytest
 
 from qutebrowser.misc import earlyinit
+from qutebrowser.qt import machinery
 
 
 @pytest.mark.parametrize('attr', ['stderr', '__stderr__'])
@@ -48,3 +49,60 @@ def test_qt_version(same):
 def test_qt_version_no_args():
     """Make sure qt_version without arguments at least works."""
     earlyinit.qt_version()
+
+
+def test_check_qt_available_no_wrapper():
+    info = machinery.SelectionInfo(
+        pyqt5="ImportError: no PyQt5",
+        pyqt6="ImportError: no PyQt6",
+        reason=machinery.SelectionReason.auto,
+    )
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        earlyinit.check_qt_available(info)
+
+    assert excinfo.value.info is info
+    assert str(excinfo.value) == f"No Qt wrapper was importable.\n\n\n{info}"
+
+
+def test_check_qt_available_error_spacing(monkeypatch, capsys):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default)
+
+    def fail_import(name):
+        raise ImportError(f"missing {name}")
+
+    monkeypatch.setattr(earlyinit.importlib, "import_module", fail_import)
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+    monkeypatch.setattr(sys, "argv", ["qutebrowser"])
+
+    with pytest.raises(SystemExit) as excinfo:
+        earlyinit.check_qt_available(info)
+
+    assert excinfo.value.code == 1
+    error_output = capsys.readouterr().err
+    assert "missing PyQt5.QtCore" in error_output
+    assert error_output.endswith("\n\n\n")
+
+
+def test_early_init_passes_selection_info(monkeypatch):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default)
+    args = object()
+    calls = []
+
+    def init_wrapper(received):
+        calls.append(("init", received))
+        return info
+
+    monkeypatch.setattr(earlyinit, "init_faulthandler", lambda: calls.append("fault"))
+    monkeypatch.setattr(machinery, "init", init_wrapper)
+    monkeypatch.setattr(earlyinit, "check_qt_available",
+                        lambda received: calls.append(("check", received)))
+    for name in ("init_log", "check_libraries", "check_qt_version",
+                 "configure_pyqt", "check_ssl_support", "check_optimize_flag",
+                 "webengine_early_import"):
+        monkeypatch.setattr(earlyinit, name, lambda *args: None)
+
+    earlyinit.early_init(args)
+
+    assert calls == ["fault", ("init", args), ("check", info)]
