+func TestUbuntuContentOrdering(t *testing.T) {
+	contents := CveContents{
+		Nvd:       {{SourceLink: "nvd", Cpes: []Cpe{{URI: "nvd"}}, References: References{{Link: "nvd"}}, CweIDs: []string{"CWE-1"}}},
+		Ubuntu:    {{SourceLink: "ubuntu", Cpes: []Cpe{{URI: "ubuntu"}}, References: References{{Link: "ubuntu"}}, CweIDs: []string{"CWE-2"}}},
+		UbuntuAPI: {{SourceLink: "ubuntu-api", Cpes: []Cpe{{URI: "ubuntu-api"}}, References: References{{Link: "ubuntu-api"}}, CweIDs: []string{"CWE-2", "CWE-3"}}},
+	}
+	if got, want := contents.PrimarySrcURLs("en", "ubuntu", "CVE-2024-0001", nil), []CveContentStr{{Nvd, "nvd"}, {Ubuntu, "ubuntu"}, {UbuntuAPI, "ubuntu-api"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("PrimarySrcURLs = %v, want %v", got, want)
+	}
+	if got, want := contents.Cpes("ubuntu"), []CveContentCpes{{Ubuntu, []Cpe{{URI: "ubuntu"}}}, {UbuntuAPI, []Cpe{{URI: "ubuntu-api"}}}, {Nvd, []Cpe{{URI: "nvd"}}}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("Cpes = %v, want %v", got, want)
+	}
+	if got, want := contents.References("ubuntu"), []CveContentRefs{{Ubuntu, References{{Link: "ubuntu"}}}, {UbuntuAPI, References{{Link: "ubuntu-api"}}}, {Nvd, References{{Link: "nvd"}}}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("References = %v, want %v", got, want)
+	}
+	if got, want := contents.UniqCweIDs("ubuntu"), []CveContentStr{{Ubuntu, "CWE-2"}, {UbuntuAPI, "CWE-3"}, {Nvd, "CWE-1"}}; !reflect.DeepEqual(got, want) {
+		t.Errorf("UniqCweIDs = %v, want %v", got, want)
+	}
+}
