+func TestIsCveInfoUpdatedForUbuntuAPI(t *testing.T) {
+	const id = "CVE-2024-0001"
+	previous := models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{id: {
+		CveContents: models.CveContents{models.UbuntuAPI: {{LastModified: time.Unix(1, 0)}}},
+	}}}
+	current := models.ScanResult{Family: "ubuntu", ScannedCves: models.VulnInfos{id: {
+		CveContents: models.CveContents{models.UbuntuAPI: {{LastModified: time.Unix(2, 0)}}},
+	}}}
+	if !isCveInfoUpdated(id, previous, current) {
+		t.Fatal("Ubuntu API update was missed")
+	}
+}
