+func TestGetCveContentTypes(t *testing.T) {
+	tests := []struct {
+		family string
+		want   []CveContentType
+	}{
+		{"redhat", []CveContentType{RedHat, RedHatAPI}},
+		{"centos", []CveContentType{RedHat, RedHatAPI}},
+		{"alma", []CveContentType{RedHat, RedHatAPI}},
+		{"rocky", []CveContentType{RedHat, RedHatAPI}},
+		{"debian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"raspbian", []CveContentType{Debian, DebianSecurityTracker}},
+		{"ubuntu", []CveContentType{Ubuntu, UbuntuAPI}},
+		{"unknown-family", nil},
+	}
+	for _, tt := range tests {
+		if got := GetCveContentTypes(tt.family); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("GetCveContentTypes(%q) = %v, want %v", tt.family, got, tt.want)
+		}
+	}
+	if NewCveContentType("redhat") != RedHat || NewCveContentType("centos") != RedHat || NewCveContentType("raspbian") != Debian || NewCveContentType("unknown-family") != Unknown {
+		t.Error("single-source family mapping changed")
+	}
+}
