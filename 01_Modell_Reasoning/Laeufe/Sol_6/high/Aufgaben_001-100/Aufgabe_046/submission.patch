+def recursive_finder(name, module_fqn, data, py_module_names, py_module_cache, zf):
+    """Collect module_utils dependencies in breadth first order."""
+    mu_paths = [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)]
+    mu_paths.append(_MODULE_UTILS_PATH)
+    queued = deque([(name, module_fqn, data)])
+    scanned = set()
+    written = set(zf.namelist())
+
+    # The wrapper imports basic even when the module itself does not.
+    pending = deque([(('ansible', 'module_utils', 'basic'), False)])
+    for base in (('ansible', '__init__'), ('ansible', 'module_utils', '__init__')):
+        output = os.path.join(*base) + '.py'
+        if output not in written:
+            if base in py_module_cache:
+                source = py_module_cache[base][0]
+            elif base == ('ansible', '__init__'):
+                source = (b'from pkgutil import extend_path\n__path__=extend_path(__path__,__name__)\n'
+                          b'__version__="' + to_bytes(__version__) + b'"\n'
+                          b'__author__="' + to_bytes(__author__) + b'"\n')
+            else:
+                source = b'from pkgutil import extend_path\n__path__=extend_path(__path__,__name__)\n'
+            zf.writestr(output, source)
+            written.add(output)
+        py_module_names.add(base)
+
+    while queued or pending:
+        if queued:
+            current_name, current_fqn, current_data = queued.popleft()
+            if current_fqn in scanned:
+                continue
+            scanned.add(current_fqn)
+            try:
+                tree = compile(current_data, '<unknown>', 'exec', ast.PyCF_ONLY_AST)
+            except (SyntaxError, IndentationError) as exc:
+                raise AnsibleError('Unable to import %s due to %s' % (current_name, exc.msg))
+            finder = ModuleDepFinder(current_fqn)
+            finder.visit(tree)
+            for dependency in sorted(finder.submodules):
+                pending.append((dependency, dependency in finder.ambiguous_submodules))
+            continue
 
+        dependency, ambiguous = pending.popleft()
+        if dependency[:3] == ('ansible', 'module_utils', 'six'):
+            dependency = dependency[:3]
+            ambiguous = False
+        if dependency[:2] == ('ansible', 'module_utils'):
+            locator = LegacyModuleUtilLocator(dependency, ambiguous, mu_paths)
+        elif len(dependency) > 5 and dependency[0] == 'ansible_collections' and dependency[3:5] == ('plugins', 'module_utils'):
+            locator = CollectionModuleUtilLocator(dependency, ambiguous)
+        else:
+            continue
+        if not locator.found:
+            raise AnsibleError('Could not find imported module support code for %s. Looked for (%s)' %
+                               (module_fqn, ', '.join(locator.candidate_names_joined())))
+        resolved = locator.normalized_name
+        if resolved not in py_module_names:
+            py_module_names.add(resolved)
+            py_module_cache[resolved] = (locator.source, locator.path)
+            if locator.output_path not in written:
+                zf.writestr(locator.output_path, locator.source)
+                written.add(locator.output_path)
+            queued.append((resolved[-1], '.'.join(resolved), locator.source))
+            display.vvvvv('Using module_utils file %s' % to_text(locator.path, errors='surrogate_or_strict'))
+
+        # Include every parent package.  A missing initializer is a namespace
+        # level in the collection, so make an empty file for the zip payload.
+        for length in range(1, len(resolved) if resolved[-1] != '__init__' else len(resolved) - 1):
+            parent = resolved[:length]
+            package_name = parent + ('__init__',)
+            if package_name in py_module_names:
+                continue
+            if parent[0] == 'ansible_collections' and length >= 5:
+                parent_locator = CollectionModuleUtilLocator(parent, child_is_redirected=locator.is_redirected)
+                source = parent_locator.source if parent_locator.found and parent_locator.is_package else b''
+                path = parent_locator.path if parent_locator.found and parent_locator.is_package else '/'.join(parent) + '/__init__.py'
+            elif parent[:2] == ('ansible', 'module_utils') and length > 2:
+                parent_locator = LegacyModuleUtilLocator(parent, mu_paths=mu_paths,
+                                                         child_is_redirected=locator.is_redirected)
+                source = parent_locator.source if parent_locator.found and parent_locator.is_package else b''
+                path = parent_locator.path if parent_locator.found and parent_locator.is_package else '/'.join(parent) + '/__init__.py'
+            else:
+                source = b''
+                path = '/'.join(parent) + '/__init__.py'
+            py_module_names.add(package_name)
+            output = os.path.join(*package_name) + '.py'
+            if output not in written:
+                zf.writestr(output, source)
+                written.add(output)
+            if source:
+                queued.append(('__init__', '.'.join(package_name), source))
+
+        py_module_cache.pop(resolved, None)
 
