+func (s *WebSuite) TestU2FLoginWithSecondDevice(c *C) {
+	ctx := context.Background()
+	pref, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  "https://" + s.server.ClusterName(),
+			Facets: []string{"https://" + s.server.ClusterName()},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.server.Auth().SetAuthPreference(pref), IsNil)
+
+	const user = "multiple-u2f"
+	const password = "abc123"
+	s.createUser(c, user, "root", password, "")
+	keys := []*mocku2f.Key{s.mockU2F}
+	second, err := mocku2f.Create()
+	c.Assert(err, IsNil)
+	keys = append(keys, second)
+	for i, key := range keys {
+		dev, err := u2f.NewDevice(fmt.Sprintf("key-%d", i), &u2f.Registration{
+			KeyHandle: key.KeyHandle,
+			PubKey:    key.PrivateKey.PublicKey,
+		}, s.clock.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.server.Auth().UpsertMFADevice(ctx, user, dev), IsNil)
+	}
+
+	// The auth API and web endpoint both expose all registered keys.
+	apiChallenge, err := s.proxyClient.GetU2FSignRequest(user, []byte(password))
+	c.Assert(err, IsNil)
+	c.Assert(apiChallenge.GetChallenges(), HasLen, 2)
+
+	clt := s.client()
+	re, err := clt.PostJSON(ctx, clt.Endpoint("webapi", "u2f", "signrequest"), client.U2fSignRequestReq{
+		User: user,
+		Pass: password,
+	})
+	c.Assert(err, IsNil)
+	var challenge auth.U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &challenge), IsNil)
+	c.Assert(challenge.GetChallenges(), HasLen, 2)
+	c.Assert(challenge.AuthenticateChallenge, NotNil)
+
+	// Sign with the key omitted from the legacy single-device challenge.
+	for _, request := range challenge.Challenges {
+		if request.KeyHandle == challenge.AuthenticateChallenge.KeyHandle {
+			continue
+		}
+		for _, key := range keys {
+			response, err := key.SignResponse(&request)
+			if err != nil {
+				continue
+			}
+			_, err = clt.PostJSON(ctx, clt.Endpoint("webapi", "u2f", "sessions"), u2fSignResponseReq{
+				User:            user,
+				U2FSignResponse: *response,
+			})
+			c.Assert(err, IsNil)
+			return
+		}
+	}
+	c.Fatal("no challenge for the alternate U2F device")
+}
