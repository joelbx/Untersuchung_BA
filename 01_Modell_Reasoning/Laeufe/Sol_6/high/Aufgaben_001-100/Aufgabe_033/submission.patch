+func (s *AuthSuite) TestU2FSignRequestMultipleDevices(c *C) {
+	ctx := context.Background()
+	user := "u2f-user"
+	password := []byte("abc123")
+	_, _, err := CreateUserAndRole(s.a, user, []string{user})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.UpsertPassword(user, password), IsNil)
+
+	pref, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F:          &services.U2F{AppID: "https://example.com", Facets: []string{"https://example.com"}},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.a.SetAuthPreference(pref), IsNil)
+
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	c.Assert(err, IsNil)
+	for _, name := range []string{"first", "second"} {
+		dev, err := u2f.NewDevice(name, &u2f.Registration{
+			KeyHandle: []byte(name),
+			PubKey:    key.PublicKey,
+		}, time.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.a.UpsertMFADevice(ctx, user, dev), IsNil)
+	}
+
+	got, err := s.a.U2FSignRequest(user, password)
+	c.Assert(err, IsNil)
+	c.Assert(got.Challenges, HasLen, 2)
+	c.Assert(got.AuthenticateChallenge, DeepEquals, &got.Challenges[0])
+	c.Assert(got.Challenges[0].KeyHandle, Not(Equals), got.Challenges[1].KeyHandle)
+	for _, dev := range got.Challenges {
+		c.Assert(dev.Challenge, Not(Equals), "")
+	}
+
+	data, err := json.Marshal(got)
+	c.Assert(err, IsNil)
+	var legacy u2f.AuthenticateChallenge
+	c.Assert(json.Unmarshal(data, &legacy), IsNil)
+	c.Assert(legacy, DeepEquals, got.Challenges[0])
+	var modern U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(data, &modern), IsNil)
+	c.Assert(modern.GetChallenges(), DeepEquals, got.Challenges)
+
+	legacyData, err := json.Marshal(legacy)
+	c.Assert(err, IsNil)
+	var fromOldServer U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(legacyData, &fromOldServer), IsNil)
+	c.Assert(fromOldServer.GetChallenges(), DeepEquals, []u2f.AuthenticateChallenge{legacy})
+}
