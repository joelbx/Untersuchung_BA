+export const getHostnameWithRegex = (url: string): string => {
+    const match = /^(?:(?:[a-z][a-z\d+.-]*:)?\/\/(?:[^/?#@]*@)?)?([^/?#:]+)(?::\d+)?(?=[/?#]|$)/i.exec(url);
+    return match?.[1].replace(/^www\./i, '').split('.')[0] || '';
+};
+
+export const punycodeUrl = (url: string): string => {
+    const protocolRelative = url.startsWith('//');
+    if (!protocolRelative && !/^[a-z][a-z\d+.-]*:\/\//i.test(url)) {
+        return url;
+    }
+
+    const parsed = new URL(protocolRelative ? `https:${url}` : url);
+    if (!parsed.hostname) {
+        return url;
+    }
+
+    if (!parsed.hostname.startsWith('[')) {
+        parsed.hostname = punycode.toASCII(parsed.hostname);
+    }
+
+    const credentials =
+        parsed.username || parsed.password
+            ? `${parsed.username}${parsed.password ? `:${parsed.password}` : ''}@`
+            : '';
+    const prefix = protocolRelative ? '//' : `${parsed.protocol}//`;
+    const originalAuthority = protocolRelative ? /^\/\/([^/?#]*)/.exec(url)?.[1] || '' : '';
+    const explicitPort = /:(\d+)$/.exec(originalAuthority)?.[1];
+    const host = protocolRelative && explicitPort && !parsed.port ? `${parsed.hostname}:${explicitPort}` : parsed.host;
+    const pathname = parsed.pathname.replace(/\/+$/, '');
+
+    return `${prefix}${credentials}${host}${pathname}${parsed.search}${parsed.hash}`;
+};
+
 export const isMailTo = (url: string): boolean => {
     return url.toLowerCase().startsWith('mailto:');
 };
