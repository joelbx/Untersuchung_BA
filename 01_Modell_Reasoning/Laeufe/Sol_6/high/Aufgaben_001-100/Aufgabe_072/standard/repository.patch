@@ -0,0 +1,77 @@
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { MailSettings } from '@proton/shared/lib/interfaces';
+
+import { useLinkHandler } from './useLinkHandler';
+
+const mockCreateNotification = jest.fn();
+const mockOpenModal = jest.fn();
+
+jest.mock('./index', () => ({
+    useHandler: (handler: Function) => handler,
+    useNotifications: () => ({ createNotification: mockCreateNotification }),
+}));
+jest.mock('../components', () => ({
+    useModalState: () => [{ open: false }, mockOpenModal],
+}));
+jest.mock('../components/notifications/LinkConfirmationModal', () => () => null);
+
+describe('useLinkHandler', () => {
+    beforeEach(() => {
+        mockCreateNotification.mockClear();
+        mockOpenModal.mockClear();
+    });
+
+    it('encodes an external link before showing the confirmation', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        anchor.setAttribute('href', 'https://www.аррӏе.com/path/?next=https://example.com/#part');
+        wrapper.appendChild(anchor);
+
+        renderHook(() => useLinkHandler({ current: wrapper }));
+
+        const click = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(click);
+        });
+
+        expect(click.defaultPrevented).toBe(true);
+        expect(anchor.getAttribute('href')).toBe('https://www.xn--80ak6aa92e.com/path?next=https://example.com/#part');
+        expect(mockOpenModal).toHaveBeenCalledWith(true);
+    });
+
+    it('reports an error and stops navigation when no URL can be extracted', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        wrapper.appendChild(anchor);
+
+        renderHook(() => useLinkHandler({ current: wrapper }));
+
+        const click = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(click);
+        });
+
+        expect(click.defaultPrevented).toBe(true);
+        expect(mockCreateNotification).toHaveBeenCalledWith(expect.objectContaining({ type: 'error' }));
+        expect(mockOpenModal).not.toHaveBeenCalled();
+    });
+
+    it('encodes an external link when confirmation is disabled', () => {
+        const wrapper = document.createElement('div');
+        const anchor = document.createElement('a');
+        anchor.setAttribute('href', 'https://www.аррӏе.com');
+        wrapper.appendChild(anchor);
+
+        renderHook(() => useLinkHandler({ current: wrapper }, { ConfirmLink: 0 } as MailSettings));
+
+        const click = new MouseEvent('click', { bubbles: true, cancelable: true });
+        act(() => {
+            anchor.dispatchEvent(click);
+        });
+
+        expect(click.defaultPrevented).toBe(false);
+        expect(anchor.getAttribute('href')).toBe('https://www.xn--80ak6aa92e.com');
+        expect(mockOpenModal).not.toHaveBeenCalled();
+    });
+});
