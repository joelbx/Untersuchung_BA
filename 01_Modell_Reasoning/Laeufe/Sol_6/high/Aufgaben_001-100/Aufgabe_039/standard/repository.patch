+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        db = get_db()
+        db.query("""
+        CREATE TABLE booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL DEFAULT -1,
+            notes text NOT NULL,
+            PRIMARY KEY (username, work_id, edition_id)
+        );
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.notes = [
+            dict(username="reader", work_id=1, edition_id=-1,
+                 notes="source work"),
+            dict(username="other", work_id=1, edition_id=3,
+                 notes="source edition"),
+            dict(username="reader", work_id=2, edition_id=-1,
+                 notes="destination"),
+        ]
+        for note in self.notes:
+            self.db.insert("booknotes", **note)
+
+    def teardown_method(self):
+        self.db.delete("booknotes", where="1=1")
+
+    def get_notes(self):
+        return [dict(row) for row in self.db.select(
+            "booknotes", order="username, work_id, edition_id"
+        )]
+
+    def test_conflict_preserves_all_notes(self):
+        before = self.get_notes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            'rows_changed': 0, 'rows_deleted': 0, 'failed_deletes': 1,
+        }
+        assert self.get_notes() == before
+
+    def test_update_without_conflict(self):
+        result = Booknotes.update_work_id(1, 3)
+        expected = [
+            dict(note, work_id=3) if note['work_id'] == 1 else note
+            for note in self.notes
+        ]
+        expected.sort(key=lambda note: (
+            note['username'], note['work_id'], note['edition_id']
+        ))
+
+        assert result == {
+            'rows_changed': 2, 'rows_deleted': 0, 'failed_deletes': 0,
+        }
+        assert self.get_notes() == expected
+
+    def test_dry_run_preserves_notes(self):
+        before = self.get_notes()
+
+        result = Booknotes.update_work_id(1, 3, _test=True)
+
+        assert result == {
+            'rows_changed': 2, 'rows_deleted': 0, 'failed_deletes': 0,
+        }
+        assert self.get_notes() == before
