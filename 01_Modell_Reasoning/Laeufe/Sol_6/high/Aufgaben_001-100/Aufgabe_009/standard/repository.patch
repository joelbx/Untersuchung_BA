+limitations under the License.
+*/
+
+import React from 'react';
+import { act, fireEvent, render } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-id', display_name: 'Original', isVerified: false };
+    const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+
+    beforeEach(() => saveDeviceName.mockReset().mockResolvedValue(undefined));
+
+    it('shows the device id when the name is missing, and skips an unchanged save', async () => {
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={{ device_id: device.device_id, isVerified: false }}
+            saveDeviceName={saveDeviceName}
+        />);
+        expect(getByTestId('device-detail-heading-name').textContent).toBe('device-id');
+        fireEvent.click(getByTestId('device-detail-rename'));
+        expect((getByTestId('device-detail-name-input') as HTMLInputElement).maxLength).toBe(100);
+        await act(async () => { fireEvent.click(getByTestId('device-detail-name-save')); });
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(getByTestId('device-detail-heading-read')).toBeTruthy();
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+    });
+
+    it('saves an empty name and returns to the read view after the request completes', async () => {
+        let finish = () => {};
+        saveDeviceName.mockImplementation(() => new Promise<void>(resolve => { finish = resolve; }));
+        const { getByTestId, queryByTestId, getByText, container } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-rename'));
+        expect(getByText('Session names may be visible to people you communicate with.')).toBeTruthy();
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', '');
+        expect(container.querySelector('.mx_Spinner')).toBeTruthy();
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+        await act(async () => finish());
+        expect(getByTestId('device-detail-heading-name').textContent).toBe('');
+        expect(getByTestId('device-detail-heading-read')).toBeTruthy();
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+    });
+
+    it('cancels without saving', () => {
+        const { getByTestId, queryByTestId } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Changed' } });
+        fireEvent.click(getByTestId('device-detail-name-cancel'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(getByTestId('device-detail-heading-name').textContent).toBe('Original');
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+    });
+
+    it('shows the required error and keeps the form open on failure', async () => {
+        saveDeviceName.mockRejectedValue(new Error('server error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Changed' } });
+        await act(async () => { fireEvent.click(getByTestId('device-detail-name-save')); });
+        expect(getByTestId('device-detail-name-error').textContent).toBe('Failed to set display name.');
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+    });
+});
