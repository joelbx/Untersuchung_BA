+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Field from '../../elements/Field';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+import { DevicesState } from './useOwnDevices';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: DevicesState['saveDeviceName'];
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [savedName, setSavedName] = useState(device.display_name);
+    const [draft, setDraft] = useState('');
+    const [isEditing, setIsEditing] = useState(false);
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    useEffect(() => {
+        setSavedName(device.display_name);
+    }, [device.device_id, device.display_name]);
+
+    const visibleName = savedName ?? device.device_id;
+
+    const startEditing = () => {
+        setDraft(visibleName);
+        setError(undefined);
+        setIsEditing(true);
+    };
+
+    const cancel = () => {
+        setError(undefined);
+        setIsEditing(false);
+    };
+
+    const save = async () => {
+        if (isSaving) return;
+        if (draft === visibleName) {
+            setIsEditing(false);
+            return;
+        }
+        setIsSaving(true);
+        setError(undefined);
+        try {
+            await saveDeviceName(device.device_id, draft);
+            setSavedName(draft);
+            setIsEditing(false);
+        } catch (error) {
+            setError(_t('Failed to set display name.'));
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (!isEditing) {
+        return <div className='mx_DeviceDetailHeading_read' data-testid='device-detail-heading-read'>
+            <Heading size='h3' data-testid='device-detail-heading-name'>{ visibleName }</Heading>
+            <AccessibleButton kind='link_inline' onClick={startEditing} data-testid='device-detail-rename'>
+                { _t('Rename') }
+            </AccessibleButton>
+        </div>;
+    }
+
+    return <form className='mx_DeviceDetailHeading_edit'
+        data-testid='device-detail-heading-edit'
+        onSubmit={(event) => { event.preventDefault(); void save(); }}
+    >
+        <Field
+            label={_t('Session name')}
+            value={draft}
+            maxLength={100}
+            autoComplete='off'
+            autoFocus
+            disabled={isSaving}
+            onChange={(event) => setDraft(event.target.value)}
+            data-testid='device-detail-name-input'
+        />
+        <p>{ _t('Session names may be visible to people you communicate with.') }</p>
+        { error && <div role='alert' data-testid='device-detail-name-error'>{ error }</div> }
+        <div className='mx_DeviceDetailHeading_actions'>
+            <AccessibleButton kind='primary_sm'
+                onClick={save}
+                disabled={isSaving}
+                data-testid='device-detail-name-save'
+            >
+                { _t('Save') }
+            </AccessibleButton>
+            <AccessibleButton kind='secondary'
+                onClick={cancel}
+                disabled={isSaving}
+                data-testid='device-detail-name-cancel'
+            >
+                { _t('Cancel') }
+            </AccessibleButton>
+            { isSaving && <Spinner w={16} h={16} /> }
+        </div>
+    </form>;
+};
