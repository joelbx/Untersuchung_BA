+func TestStringToSliceHookFunc(t *testing.T) {
+	tests := []struct {
+		name   string
+		input  interface{}
+		target reflect.Type
+		want   interface{}
+	}{
+		{"whitespace", "  foo.com\tbar.com\n\n baz.com  ", reflect.TypeOf([]string{}), []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "", reflect.TypeOf([]string{}), []string{}},
+		{"only whitespace", " \t\n ", reflect.TypeOf([]string{}), []string{}},
+		{"sequence", []string{"foo.com", "bar.com"}, reflect.TypeOf([]string{}), []string{"foo.com", "bar.com"}},
+		{"non-string", 42, reflect.TypeOf([]string{}), 42},
+		{"other target", "foo.com bar.com", reflect.TypeOf([]int{}), "foo.com bar.com"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := stringToSliceHookFunc(reflect.TypeOf(tt.input), tt.target, tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadCorsAllowedOrigins(t *testing.T) {
+	tests := []struct {
+		name  string
+		value string
+		want  []string
+	}{
+		{"whitespace", "\"  foo.com\\tbar.com\\n baz.com  \"", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "\"\"", []string{}},
+		{"sequence", "[foo.com, bar.com]", []string{"foo.com", "bar.com"}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: "+tt.value+"\n"), 0600))
+
+			cfg, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+		})
+	}
+
+	t.Run("environment", func(t *testing.T) {
+		t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", "  foo.com\tbar.com\n baz.com  ")
+		cfg, err := Load("./testdata/default.yml")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"foo.com", "bar.com", "baz.com"}, cfg.Cors.AllowedOrigins)
+	})
+}
