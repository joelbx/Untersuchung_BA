+// stringToSliceHookFunc splits scalar strings into string slices on whitespace.
+func stringToSliceHookFunc(_ reflect.Type, to reflect.Type, data interface{}) (interface{}, error) {
+	value, ok := data.(string)
+	if !ok || to != reflect.TypeOf([]string{}) {
+		return data, nil
+	}
+
+	return strings.Fields(value), nil
+}
