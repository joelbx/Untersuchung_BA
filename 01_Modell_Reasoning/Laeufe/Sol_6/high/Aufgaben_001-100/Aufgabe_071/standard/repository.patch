+@pytest.mark.parametrize(('escaped', 'expected'), [
+    (b'_x000D__x000A__x263A_', '\r\n☺'.encode()),
+    (b'_xD83D__xDE00_', '😀'.encode()),
+    (b'_xD83D_', '\ud83d'.encode('utf-8', 'surrogatepass')),
+    (b'_xDE00_', '\ude00'.encode('utf-8', 'surrogatepass')),
+    (b'_x005G__x123_', b'_x005G__x123_'),
+    (b'_x005f_', b'_'),
+    (b'_x005F_', b'_x005F_'),
+    (b'_x005F__x000A_', b'_\n'),
+])
+def test_parse_clixml_escapes(escaped, expected):
+    data = b'<Objs><S S="Error">' + escaped + b'</S></Objs>'
+    assert _parse_clixml(data) == expected
+
+
+def test_parse_clixml_streams_empty_entries_and_block_boundaries():
+    data = (b'#< CLIXML\r\n'
+            b'<Objs><S S="Info">ignored</S><S S="Error" />'
+            b'<S S="Error">one</S><S S="Error">_xD83D_</S><S S="Error">_xDE00_</S></Objs>'
+            b'<Objs><S S="Info">also ignored</S></Objs>'
+            b'<Objs><S S="Error">two_x000D__x000A_</S><S S="Error" /></Objs>')
+    assert _parse_clixml(data) == 'one😀\r\ntwo\r\n'.encode()
+    assert _parse_clixml(data, stream='Info') == b'ignored\r\nalso ignored'
+
+
+def test_parse_clixml_only_empty_entries():
+    data = b'<Objs><S S="Error" /><S S="Info">other</S></Objs><Objs><S S="Error"></S></Objs>'
+    assert _parse_clixml(data) == b''
+
