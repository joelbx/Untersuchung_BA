+
+import React from "react";
+import { mount } from "enzyme";
+
+import dis from "../../../../src/dispatcher/dispatcher";
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import { TimelineRenderingType } from "../../../../src/contexts/RoomContext";
+import { mkEvent } from "../../../test-utils";
+
+jest.mock("../../../../src/components/views/rooms/ReplyTile", () => () => <div />);
+
+describe("ReplyPreview", () => {
+    it("identifies the recipient and offers a labeled cancel action", () => {
+        const event = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:server",
+            user: "@alice:server",
+            content: { msgtype: "m.text", body: "Hello" },
+            ts: Date.now(),
+        });
+        const dispatch = jest.spyOn(dis, "dispatch").mockImplementation(() => undefined);
+        const wrapper = mount(<ReplyPreview replyToEvent={event} permalinkCreator={null} />);
+
+        expect(wrapper.find(".mx_ReplyPreview_header").text()).toContain("Replying to @alice:server");
+        expect(wrapper.find(".mx_ReplyPreview_header span.mx_DisambiguatedProfile")).toHaveLength(1);
+        const cancel = wrapper.find('button[aria-label="Cancel reply"]');
+        expect(cancel).toHaveLength(1);
+        cancel.simulate("click");
+        expect(dispatch).toHaveBeenCalledWith({
+            action: "reply_to_event",
+            event: null,
+            context: TimelineRenderingType.Room,
+        });
+        dispatch.mockRestore();
+    });
+});
