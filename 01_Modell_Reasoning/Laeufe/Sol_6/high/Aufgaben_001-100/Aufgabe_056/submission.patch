--- /dev/null
+++ b/packages/drive-store/store/_uploads/media/modernImageSupport.test.ts
@@ -0,0 +1,49 @@
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    getBrowser: jest.fn(),
+    getOS: jest.fn(),
+    isAndroid: jest.fn(() => false),
+    isDesktop: jest.fn(() => true),
+    isIos: jest.fn(() => false),
+    isMobile: jest.fn(() => false),
+}));
+
+const setBrowser = (name: string, version: string, osName: string) => {
+    jest.mocked(getBrowser).mockReturnValue({ name, version } as ReturnType<typeof getBrowser>);
+    jest.mocked(getOS).mockReturnValue({ name: osName, version: '' });
+};
+
+describe('modern image support', () => {
+    const formats = ['image/heic', 'image/heic-sequence', 'image/heif', 'image/heif-sequence', 'image/jxl'];
+
+    it.each([
+        ['Safari', 'Mac OS'],
+        ['Mobile Safari', 'iOS'],
+    ])('supports HEIC and JXL in %s 17+ on %s', (browser, os) => {
+        setBrowser(browser, '17.0', os);
+
+        expect(isHEICSupported()).toBe(true);
+        expect(isJXLSupported()).toBe(true);
+        formats.forEach((format) => expect(isSupportedImage(format)).toBe(true));
+
+        setBrowser(browser, '18.1', os);
+        formats.forEach((format) => expect(isSupportedImage(format)).toBe(true));
+    });
+
+    it.each([
+        ['Safari', '16.6', 'Mac OS'],
+        ['Mobile Safari', '16.6', 'iOS'],
+        ['Chrome', '120', 'Mac OS'],
+        ['Safari', '17', 'Windows'],
+        ['Safari', '', 'Mac OS'],
+    ])('does not support HEIC and JXL in %s %s on %s', (browser, version, os) => {
+        setBrowser(browser, version, os);
+
+        expect(isHEICSupported()).toBe(false);
+        expect(isJXLSupported()).toBe(false);
+        formats.forEach((format) => expect(isSupportedImage(format)).toBe(false));
+        expect(isSupportedImage('image/png')).toBe(true);
+    });
+});
diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
