--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
@@ -0,0 +1,21 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('uses the browser-provided type when it is specific', async () => {
+        const file = new File([], 'image.unknown', { type: 'image/png' });
+
+        await expect(mimeTypeFromFile(file)).resolves.toBe('image/png');
+    });
+
+    it('uses the extension for files without a useful browser-provided type', async () => {
+        await expect(mimeTypeFromFile(new File([], 'image.jxl'))).resolves.toBe('image/jxl');
+        await expect(mimeTypeFromFile(new File([], 'image.JXL', { type: 'application/octet-stream' }))).resolves.toBe(
+            'image/jxl'
+        );
+        await expect(mimeTypeFromFile(new File([], 'image.heic'))).resolves.toBe('image/heic');
+    });
+
+    it('uses the generic type only when neither source identifies the file', async () => {
+        await expect(mimeTypeFromFile(new File([], 'image.unknown'))).resolves.toBe('application/octet-stream');
+    });
+});
