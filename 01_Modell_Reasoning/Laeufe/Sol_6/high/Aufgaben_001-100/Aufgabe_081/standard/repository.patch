+package oidc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCallbackURL(t *testing.T) {
+	for _, tc := range []struct {
+		host string
+		want string
+	}{
+		{host: "http://localhost:8080", want: "http://localhost:8080/auth/v1/method/oidc/google/callback"},
+		{host: "https://auth.flipt.io/", want: "https://auth.flipt.io/auth/v1/method/oidc/google/callback"},
+		{host: "https://auth.flipt.io//", want: "https://auth.flipt.io//auth/v1/method/oidc/google/callback"},
+	} {
+		t.Run(tc.host, func(t *testing.T) {
+			require.Equal(t, tc.want, callbackURL(tc.host, "google"))
+		})
+	}
+}
