+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationConfigValidateSessionDomain(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		domain string
+		want   string
+	}{
+		{name: "URL with port", domain: "http://localhost:8080", want: "localhost"},
+		{name: "secure URL with port", domain: "https://auth.flipt.io:8443", want: "auth.flipt.io"},
+		{name: "host with port", domain: "auth.flipt.io:8080", want: "auth.flipt.io"},
+		{name: "host only", domain: "auth.flipt.io", want: "auth.flipt.io"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tc.domain},
+				Methods: AuthenticationMethods{
+					OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+				},
+			}
+			require.NoError(t, cfg.validate())
+			require.Equal(t, tc.want, cfg.Session.Domain)
+		})
+	}
+}
+
+func TestAuthenticationConfigValidateSessionDomainParseError(t *testing.T) {
+	cfg := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: "http://localhost:%invalid"},
+		Methods: AuthenticationMethods{
+			OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+		},
+	}
+	require.ErrorContains(t, cfg.validate(), "authentication.session.domain")
+}
