diff --git a/internal/server/auth/method/oidc/http_test.go b/internal/server/auth/method/oidc/http_test.go
new file mode 100644
index 0000000..81635f6
--- /dev/null
+++ b/internal/server/auth/method/oidc/http_test.go
@@ -0,0 +1,59 @@
+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestMiddlewareStateCookie(t *testing.T) {
+	for _, tc := range []struct {
+		domain string
+		want   string
+	}{
+		{domain: "localhost", want: ""},
+		{domain: "auth.flipt.io", want: "auth.flipt.io"},
+	} {
+		t.Run(tc.domain, func(t *testing.T) {
+			middleware := NewHTTPMiddleware(config.AuthenticationSession{Domain: tc.domain})
+			handler := middleware.Handler(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+			response := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize", nil)
+			handler.ServeHTTP(response, request)
+
+			cookies := response.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, stateCookieKey, cookies[0].Name)
+			require.Equal(t, tc.want, cookies[0].Domain)
+			require.Equal(t, "/auth/v1/method/oidc/google/callback", cookies[0].Path)
+		})
+	}
+}
+
+func TestMiddlewareTokenCookie(t *testing.T) {
+	for _, tc := range []struct {
+		domain string
+		want   string
+	}{
+		{domain: "localhost", want: ""},
+		{domain: "auth.flipt.io", want: "auth.flipt.io"},
+	} {
+		t.Run(tc.domain, func(t *testing.T) {
+			middleware := NewHTTPMiddleware(config.AuthenticationSession{Domain: tc.domain})
+			response := httptest.NewRecorder()
+			callback := &auth.CallbackResponse{ClientToken: "client-token"}
+			require.NoError(t, middleware.ForwardResponseOption(context.Background(), response, callback))
+
+			cookies := response.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, tokenCookieKey, cookies[0].Name)
+			require.Equal(t, tc.want, cookies[0].Domain)
+			require.Equal(t, "/", cookies[0].Path)
+		})
+	}
+}
