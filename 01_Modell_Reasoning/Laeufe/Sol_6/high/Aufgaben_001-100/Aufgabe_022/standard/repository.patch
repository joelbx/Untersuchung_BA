+func (o *redhatBase) parseSourceRPM(filename, epoch, binaryName string) *models.SrcPackage {
+	if filename == "(none)" {
+		return nil
+	}
+
+	name, version, release, err := splitFileName(filename)
+	if err != nil {
+		warn := xerrors.Errorf("Failed to parse source rpm file %q: %w", filename, err)
+		o.warns = append(o.warns, warn)
+		if o.log.Logger != nil {
+			o.log.Warnf("%s", warn)
+		}
+		return nil
+	}
+
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	return &models.SrcPackage{
+		Name:        name,
+		Version:     version + "-" + release,
+		Arch:        "src",
+		BinaryNames: []string{binaryName},
+	}
+}
