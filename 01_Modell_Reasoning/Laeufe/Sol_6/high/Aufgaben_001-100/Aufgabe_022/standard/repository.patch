+func Test_redhatBase_parseInstalledPackagesContinuesAfterBadSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)\nbar 1 9 123a ia64 1:bar-9-123a.src.rpm")
+	if err != nil {
+		t.Fatalf("parseInstalledPackages() error = %v", err)
+	}
+	if got := bins["elasticsearch"]; got.Name != "elasticsearch" || got.Version != "8.17.0" || got.Release != "1" || got.Arch != "x86_64" {
+		t.Errorf("elasticsearch binary = %+v", got)
+	}
+	if got := bins["bar"]; got.Name != "bar" || got.Version != "1:9" || got.Release != "123a" || got.Arch != "ia64" {
+		t.Errorf("bar binary = %+v", got)
+	}
+	if _, ok := srcs["elasticsearch"]; ok {
+		t.Errorf("unexpected elasticsearch source package: %+v", srcs["elasticsearch"])
+	}
+	if got := srcs["bar"]; !reflect.DeepEqual(got, models.SrcPackage{
+		Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"},
+	}) {
+		t.Errorf("bar source = %+v", got)
+	}
+	if len(o.warns) != 1 {
+		t.Errorf("warnings = %v, want one warning", o.warns)
+	}
+}
