+// KubeAddr returns the public HTTPS address of the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is not enabled")
+	}
+
+	var addr utils.NetAddr
+	switch {
+	case len(c.Kube.PublicAddrs) > 0:
+		addr = c.Kube.PublicAddrs[0]
+	case len(c.PublicAddrs) > 0:
+		addr = c.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("no public proxy address configured")
+	}
+
+	// Parse the advertised address before extracting its host. NetAddr.Host
+	// alone treats malformed host:port strings as hostnames.
+	u, err := url.Parse("https://" + addr.Addr)
+	if err != nil || u.Hostname() == "" || strings.HasSuffix(u.Host, ":") || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" || addr.Path != "" || addr.AddrNetwork == "unix" {
+		return "", trace.BadParameter("invalid public proxy address %q", addr.Addr)
+	}
+	if port := u.Port(); port != "" {
+		n, err := strconv.Atoi(port)
+		if err != nil || n < 1 || n > 65535 {
+			return "", trace.BadParameter("invalid public proxy address %q", addr.Addr)
+		}
+	}
+	return (&url.URL{Scheme: "https", Host: net.JoinHostPort(u.Hostname(), strconv.Itoa(defaults.KubeProxyListenPort))}).String(), nil
+}
