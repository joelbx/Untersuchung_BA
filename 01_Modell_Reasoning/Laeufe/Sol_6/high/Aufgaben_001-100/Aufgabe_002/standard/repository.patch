@@ -31,6 +31,65 @@ import (
 
 func TestConfig(t *testing.T) { check.TestingT(t) }
 
+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  ProxyConfig
+		want string
+	}{
+		{
+			name: "Kubernetes public address takes priority and ignores its port",
+			cfg: ProxyConfig{
+				Kube:        KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:443"}}},
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "web public address supplies host",
+			cfg: ProxyConfig{
+				Kube:        KubeProxyConfig{Enabled: true},
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			},
+			want: "https://web.example.com:3026",
+		},
+		{
+			name: "IPv6 host",
+			cfg: ProxyConfig{
+				Kube:        KubeProxyConfig{Enabled: true},
+				PublicAddrs: []utils.NetAddr{{Addr: "[2001:db8::1]:3080"}},
+			},
+			want: "https://[2001:db8::1]:3026",
+		},
+		{
+			name: "disabled",
+			cfg:  ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}}},
+		},
+		{
+			name: "missing address",
+			cfg:  ProxyConfig{Kube: KubeProxyConfig{Enabled: true}},
+		},
+		{
+			name: "invalid address",
+			cfg: ProxyConfig{
+				Kube:        KubeProxyConfig{Enabled: true},
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:bad"}},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.KubeAddr()
+			if tt.want == "" {
+				assert.Error(t, err)
+			} else {
+				assert.NoError(t, err)
+				assert.Equal(t, tt.want, got)
+			}
+		})
+	}
+}
