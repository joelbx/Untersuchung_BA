+func TestAuthSignKubeconfigProxyAddr(t *testing.T) {
+	proxy := func(addr string) services.Server {
+		p := &services.ServerV2{}
+		p.SetPublicAddr(addr)
+		return p
+	}
+	tests := []struct {
+		name     string
+		config   service.ProxyConfig
+		proxies  []services.Server
+		override string
+		want     string
+	}{
+		{
+			name: "local Kubernetes proxy",
+			config: service.ProxyConfig{
+				Kube:        service.KubeProxyConfig{Enabled: true, PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:443"}}},
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "registered proxy after invalid address",
+			config: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "local.example.com:3080"}},
+			},
+			proxies: []services.Server{proxy("bad.example.com:abc"), proxy("https://bad.example.com:3080/path"), proxy("proxy.example.com:3080")},
+			want:    "https://proxy.example.com:3026",
+		},
+		{
+			name:    "no valid registered proxy",
+			proxies: []services.Server{proxy("bad.example.com:abc")},
+		},
+		{
+			name:     "explicit proxy",
+			override: "https://custom.example.com:8443",
+			want:     "https://custom.example.com:8443",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			a := &AuthCommand{
+				config:       &service.Config{Proxy: tt.config},
+				outputFormat: identityfile.FormatKubernetes,
+				proxyAddr:    tt.override,
+			}
+			err := a.checkProxyAddr(mockClient{proxies: tt.proxies})
+			if tt.want == "" {
+				if err == nil {
+					t.Fatal("expected an error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if a.proxyAddr != tt.want {
+				t.Fatalf("got proxy address %q, want %q", a.proxyAddr, tt.want)
+			}
+		})
+	}
+}
