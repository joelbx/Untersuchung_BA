+	"github.com/navidrome/navidrome/core"
+)
+
+type offsetStreamer struct {
+	core.MediaStreamer
+	offset int
+}
+
+func (s *offsetStreamer) NewStream(_ context.Context, _ string, _ string, _, timeOffset int) (*core.Stream, error) {
+	s.offset = timeOffset
+	return nil, errors.New("stream failed")
+}
+
+func TestStreamTimeOffset(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		param  string
+		offset int
+	}{
+		{name: "specified", param: "&timeOffset=42", offset: 42},
+		{name: "missing", offset: 0},
+		{name: "invalid", param: "&timeOffset=abc", offset: 0},
+		{name: "negative", param: "&timeOffset=-2", offset: 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			streamer := &offsetStreamer{}
+			api := &Router{streamer: streamer}
+			req := httptest.NewRequest("GET", "/stream?id=123"+tc.param, nil)
+			_, err := api.Stream(httptest.NewRecorder(), req)
+			if err == nil {
+				t.Fatal("expected stream error")
+			}
+			if streamer.offset != tc.offset {
+				t.Fatalf("offset = %d, want %d", streamer.offset, tc.offset)
+			}
+		})
+	}
+}
+
+func TestTimeOffsetExtension(t *testing.T) {
+	response, err := (&Router{}).GetOpenSubsonicExtensions(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	extensions := *response.OpenSubsonicExtensions
+	if len(extensions) != 1 || extensions[0].Name != "transcodeOffset" || len(extensions[0].Versions) != 1 || extensions[0].Versions[0] != 1 {
+		t.Fatalf("unexpected extensions: %+v", extensions)
+	}
+}
