diff --git a/server/public/handle_streams_test.go b/server/public/handle_streams_test.go
new file mode 100644
index 0000000..23f4877
--- /dev/null
+++ b/server/public/handle_streams_test.go
@@ -0,0 +1,60 @@
+package public
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/go-chi/jwtauth/v5"
+	"github.com/navidrome/navidrome/core"
+	"github.com/navidrome/navidrome/core/auth"
+)
+
+type offsetStreamer struct {
+	core.MediaStreamer
+	offset int
+}
+
+func (s *offsetStreamer) NewStream(_ context.Context, _ string, _ string, _, timeOffset int) (*core.Stream, error) {
+	s.offset = timeOffset
+	return nil, errors.New("stream failed")
+}
+
+func TestSharedStreamTimeOffset(t *testing.T) {
+	auth.TokenAuth = jwtauth.New("HS256", []byte("test secret"), nil)
+	token, err := auth.CreatePublicToken(map[string]any{"id": "123"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name   string
+		param  string
+		offset int
+	}{
+		{name: "specified", param: "42", offset: 42},
+		{name: "missing", offset: 0},
+		{name: "invalid", param: "abc", offset: 0},
+		{name: "negative", param: "-2", offset: 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			streamer := &offsetStreamer{}
+			p := &Router{streamer: streamer}
+			query := url.Values{":id": {token}}
+			if tc.param != "" {
+				query.Set("timeOffset", tc.param)
+			}
+			req := httptest.NewRequest(http.MethodGet, "/s/123?"+query.Encode(), nil)
+			w := httptest.NewRecorder()
+			p.handleStream(w, req)
+			if w.Code != http.StatusInternalServerError {
+				t.Fatalf("status = %d, want %d", w.Code, http.StatusInternalServerError)
+			}
+			if streamer.offset != tc.offset {
+				t.Fatalf("offset = %d, want %d", streamer.offset, tc.offset)
+			}
+		})
+	}
+}
