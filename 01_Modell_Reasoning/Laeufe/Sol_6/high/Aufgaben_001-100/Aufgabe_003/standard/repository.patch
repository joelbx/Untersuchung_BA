+func createFFmpegCommand(cmd, path string, maxBitRate, timeOffset int) []string {
 	split := strings.Split(fixCmd(cmd), " ")
+	hasOffset := strings.Contains(cmd, "%t")
+	inputIndex := -1
 	for i, s := range split {
+		if inputIndex < 0 && strings.Contains(s, "%s") {
+			inputIndex = i
+		}
 		s = strings.ReplaceAll(s, "%s", path)
 		s = strings.ReplaceAll(s, "%b", strconv.Itoa(maxBitRate))
+		s = strings.ReplaceAll(s, "%t", strconv.Itoa(timeOffset))
 		split[i] = s
 	}
+	if !hasOffset && timeOffset != 0 && inputIndex >= 0 {
+		split = append(split[:inputIndex+1], append([]string{"-ss", strconv.Itoa(timeOffset)}, split[inputIndex+1:]...)...)
+	}
 
 	return split
 }
