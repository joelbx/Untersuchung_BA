+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and nested elements', () => {
+        const root = document.createElement('section');
+        root.style.cssText = 'height: 100vh; color: red';
+        root.innerHTML =
+            '<div style="height: calc(50vh - 10px) !important; width: 20vh; background: proton-url(https://example.com/a.png)"><span style="height: 25vh">Text</span></div>';
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+
+        const child = root.querySelector('div') as HTMLElement;
+        expect(child.style.height).toBe('auto');
+        expect(child.style.getPropertyPriority('height')).toBe('important');
+        expect(child.style.width).toBe('20vh');
+        expect(child.getAttribute('style')).toContain('background: proton-url(https://example.com/a.png)');
+        expect((root.querySelector('span') as HTMLElement).style.height).toBe('auto');
+    });
+
+    it('leaves other heights and style properties untouched', () => {
+        const root = document.createElement('div');
+        root.innerHTML =
+            '<p style="height: 50px; min-height: 30vh; color: blue">Text</p><p style="width: 75vh">More</p>';
+        const stylesBefore = [...root.querySelectorAll('[style]')].map((element) => element.getAttribute('style'));
+
+        transformStyleAttributes(root);
+
+        expect([...root.querySelectorAll('[style]')].map((element) => element.getAttribute('style'))).toEqual(
+            stylesBefore
+        );
+    });
+
+    it('handles non HTML elements and semicolons inside other style values', () => {
+        const root = document.createElement('div');
+        root.innerHTML =
+            '<math style="HEIGHT: 25VH; color: green"></math><p style="content: \' ; height: 100vh\'; height: 30vh; color: blue">Text</p>';
+
+        transformStyleAttributes(root);
+
+        expect(root.querySelector('math')?.getAttribute('style')).toBe('HEIGHT: auto; color: green');
+        expect(root.querySelector('p')?.getAttribute('style')).toBe(
+            "content: ' ; height: 100vh'; height: auto; color: blue"
+        );
+    });
+});
