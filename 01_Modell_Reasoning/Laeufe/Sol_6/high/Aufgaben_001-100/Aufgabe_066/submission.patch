+const replaceHeight = (declaration: string): string => {
+    const match = /^(\s*(?:\/\*[\s\S]*?\*\/\s*)*height\s*:\s*)([\s\S]*)$/i.exec(declaration);
+    if (!match || !/(?:\d+(?:\.\d*)?|\.\d+)vh\b/i.test(match[2])) {
+        return declaration;
+    }
+
+    const priority = match[2].match(/\s*!important\s*$/i)?.[0] || '';
+    return `${match[1]}auto${priority}`;
+};
+
+const replaceViewportHeight = (style: string): string => {
+    // Keep the original declarations intact, including proton-url values used by transformRemote.
+    let result = '';
+    let start = 0;
+    let quote = '';
+    let comment = false;
+    let depth = 0;
+
+    for (let index = 0; index < style.length; index += 1) {
+        const character = style[index];
+        const next = style[index + 1];
+
+        if (comment) {
+            if (character === '*' && next === '/') {
+                comment = false;
+                index += 1;
+            }
+        } else if (character === '\\') {
+            index += 1;
+        } else if (quote) {
+            if (character === quote) {
+                quote = '';
+            }
+        } else if (character === '/' && next === '*') {
+            comment = true;
+            index += 1;
+        } else if (character === '"' || character === "'") {
+            quote = character;
+        } else if (character === '(') {
+            depth += 1;
+        } else if (character === ')') {
+            depth = Math.max(0, depth - 1);
+        } else if (character === ';' && depth === 0) {
+            result += `${replaceHeight(style.slice(start, index))};`;
+            start = index + 1;
+        }
+    }
+
+    return result + replaceHeight(style.slice(start));
+};
+
+export const transformStyleAttributes = (document: Element): void => {
+    const elements = [document, ...document.querySelectorAll('[style]')];
+
+    elements.forEach((element) => {
+        const style = element.getAttribute('style');
+        if (style) {
+            const nextStyle = replaceViewportHeight(style);
+            if (nextStyle !== style) {
+                element.setAttribute('style', nextStyle);
+            }
+        }
+    });
+};
