+
+func TestFormatNamespaces(t *testing.T) {
+	namespaces, err := FormatNamespaces([]any{"local", "staging"})
+	require.NoError(t, err)
+	require.Equal(t, []string{"local", "staging"}, namespaces)
+
+	namespaces, err = FormatNamespaces([]any{})
+	require.NoError(t, err)
+	require.Empty(t, namespaces)
+
+	for _, result := range []any{nil, true, []any{"local", 1}} {
+		_, err := FormatNamespaces(result)
+		require.Error(t, err)
+	}
+}
+
+func TestNamespacesFromContext(t *testing.T) {
+	_, ok := NamespacesFromContext(context.Background())
+	require.False(t, ok)
+	namespaces, ok := NamespacesFromContext(ContextWithNamespaces(context.Background(), nil))
+	require.True(t, ok)
+	require.Empty(t, namespaces)
+}
