+
+    out, err = capfd.readouterr()
+    assert json.loads(out)['deprecations'] == [
+        {'msg': 'dated warning', 'date': '2030-01-02'},
+        {'msg': 'another dated warning', 'date': '2031-03-04'},
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecate_rejects_version_and_date(am):
+    with pytest.raises(AssertionError, match='^implementation error -- version and date must not both be set$'):
+        am.deprecate('invalid warning', version='2.14', date='2030-01-02')
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_deprecated_alias_with_date(am, capfd):
+    spec = {'option': {'aliases': ['old_option'], 'deprecated_aliases': [{'name': 'old_option', 'date': '2030-01-02'}]}}
+    am._handle_aliases(spec=spec, param={'old_option': 'value'})
+    with pytest.raises(SystemExit):
+        am.exit_json()
+
+    out, err = capfd.readouterr()
+    assert json.loads(out)['deprecations'] == [
+        {'msg': "Alias 'old_option' is deprecated. See the module docs for more information", 'date': '2030-01-02'},
+    ]
