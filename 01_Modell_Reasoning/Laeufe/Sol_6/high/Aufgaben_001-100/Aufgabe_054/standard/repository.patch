+package singleton_test
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/singleton"
+)
+
+func TestGetInstanceReusesFirstResult(t *testing.T) {
+	type item struct{ id int }
+	var constructions int
+	first := singleton.GetInstance(func() *item {
+		constructions++
+		return &item{id: 1}
+	})
+	second := singleton.GetInstance(func() *item {
+		constructions++
+		return &item{id: 2}
+	})
+	if first != second || first.id != 1 || constructions != 1 {
+		t.Fatalf("first=%p, second=%p, constructions=%d", first, second, constructions)
+	}
+}
+
+func TestGetInstanceSeparatesValueAndPointerTypes(t *testing.T) {
+	type item struct{ id int }
+	var valueConstructions, pointerConstructions int
+	value := singleton.GetInstance(func() item {
+		valueConstructions++
+		return item{id: 1}
+	})
+	pointer := singleton.GetInstance(func() *item {
+		pointerConstructions++
+		return &item{id: 2}
+	})
+	secondValue := singleton.GetInstance(func() item {
+		valueConstructions++
+		return item{id: 3}
+	})
+	secondPointer := singleton.GetInstance(func() *item {
+		pointerConstructions++
+		return &item{id: 4}
+	})
+	if value.id != 1 || secondValue != value || pointer.id != 2 || secondPointer != pointer || valueConstructions != 1 || pointerConstructions != 1 {
+		t.Fatalf("value=%v, secondValue=%v, pointer=%p, secondPointer=%p, constructions=%d/%d", value, secondValue, pointer, secondPointer, valueConstructions, pointerConstructions)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type item struct{ id int }
+	const calls = 20000
+	var constructions atomic.Int32
+	results := make(chan *item, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := 0; i < calls; i++ {
+		go func() {
+			defer done.Done()
+			<-start
+			results <- singleton.GetInstance(func() *item {
+				constructions.Add(1)
+				return &item{id: 1}
+			})
+		}()
+	}
+	close(start)
+	done.Wait()
+	close(results)
+	var first *item
+	var received int
+	for result := range results {
+		received++
+		if first == nil {
+			first = result
+		} else if result != first {
+			t.Fatal("concurrent callers received different instances")
+		}
+	}
+	if received != calls || first == nil || first.id != 1 || constructions.Load() != 1 {
+		t.Fatalf("received=%d, instance=%p, constructions=%d", received, first, constructions.Load())
+	}
+}
