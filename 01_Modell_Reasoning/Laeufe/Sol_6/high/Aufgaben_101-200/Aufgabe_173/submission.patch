+// TestAccessPostgresWithOfflineTunnel verifies that another service can be used
+// when the first matching database server's tunnel is unavailable.
+func TestAccessPostgresWithOfflineTunnel(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	duplicate := testCtx.postgres["postgres"].server.Copy().(*types.DatabaseServerV3)
+	duplicate.Spec.HostID = "offline-host"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, duplicate)
+	require.NoError(t, err)
+
+	site := testCtx.proxyServer.cfg.Tunnel.(*reversetunnel.FakeServer).Sites[0].(*reversetunnel.FakeRemoteSite)
+	site.OfflineTunnels = map[string]bool{"offline-host." + testCtx.clusterName: true}
+	candidateCounts := make(chan int, 2)
+	testCtx.proxyServer.cfg.Shuffle = func(servers []types.DatabaseServer) []types.DatabaseServer {
+		candidateCounts <- len(servers)
+		if len(servers) < 2 {
+			return servers
+		}
+		if servers[0].GetHostID() == "offline-host" {
+			return servers
+		}
+		return []types.DatabaseServer{servers[1], servers[0]}
+	}
+	go testCtx.startHandlingConnections()
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{types.Wildcard}, []string{types.Wildcard})
+
+	conn, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.NoError(t, err)
+	result, err := conn.Exec(ctx, "select 1").ReadAll()
+	require.NoError(t, err)
+	require.Equal(t, []*pgconn.Result{postgres.TestQueryResponse}, result)
+	require.NoError(t, conn.Close(ctx))
+	select {
+	case count := <-candidateCounts:
+		require.Equal(t, 2, count)
+	case <-time.After(5 * time.Second):
+		t.Fatal("proxy did not select database candidates")
+	}
+
+	// With every candidate offline, the proxy must reject the connection.
+	site.OfflineTunnels = map[string]bool{
+		"offline-host." + testCtx.clusterName:      true,
+		testCtx.hostID + "." + testCtx.clusterName: true,
+	}
+	connectCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	_, err = testCtx.postgresClient(connectCtx, "alice", "postgres", "postgres", "postgres")
+	require.Error(t, err)
+	select {
+	case count := <-candidateCounts:
+		require.Equal(t, 2, count)
+	case <-time.After(5 * time.Second):
+		t.Fatal("proxy did not select database candidates")
+	}
+}
+
