+++ b/api/types/databaseserver_test.go
@@ -0,0 +1,36 @@
+package types
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDeduplicateDatabaseServers(t *testing.T) {
+	first := NewDatabaseServerV3("alpha", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	second := NewDatabaseServerV3("beta", nil, DatabaseServerSpecV3{HostID: "host-2"})
+	duplicate := NewDatabaseServerV3("alpha", nil, DatabaseServerSpecV3{HostID: "host-3"})
+	servers := []DatabaseServer{first, second, duplicate}
+	result := DeduplicateDatabaseServers(servers)
+	if len(result) != 2 || result[0] != first || result[1] != second {
+		t.Fatalf("unexpected deduplicated servers: %v", result)
+	}
+	if len(servers) != 3 {
+		t.Fatal("deduplication changed the input slice")
+	}
+	if !strings.Contains(first.String(), "HostID=host-1") {
+		t.Fatalf("database server string omits host ID: %s", first)
+	}
+}
+
+func TestSortedDatabaseServers(t *testing.T) {
+	servers := SortedDatabaseServers{
+		NewDatabaseServerV3("beta", nil, DatabaseServerSpecV3{HostID: "a"}),
+		NewDatabaseServerV3("alpha", nil, DatabaseServerSpecV3{HostID: "z"}),
+		NewDatabaseServerV3("alpha", nil, DatabaseServerSpecV3{HostID: "a"}),
+	}
+	sort.Sort(servers)
+	if servers[0].GetHostID() != "a" || servers[1].GetHostID() != "z" || servers[2].GetName() != "beta" {
+		t.Fatalf("unexpected server order: %v", servers)
+	}
+}
