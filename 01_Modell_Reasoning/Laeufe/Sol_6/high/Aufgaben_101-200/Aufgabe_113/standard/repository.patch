--- a/test/units/modules/network/nxos/test_nxos_vrf_af.py
+++ b/test/units/modules/network/nxos/test_nxos_vrf_af.py
@@ -62,3 +62,98 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_create_address_family(self):
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[
+            dict(rt='65000:1000'),
+            dict(rt='65000:2000', direction='import')]))
+        self.execute_module(changed=True, commands=[
+            'vrf context ntc', 'address-family ipv6 unicast',
+            'route-target import 65000:1000',
+            'route-target export 65000:1000',
+            'route-target import 65000:2000'], sort=False)
+
+    def test_route_targets_mixed_and_scoped(self):
+        self.get_config.return_value = '''vrf context other
+  address-family ipv4 unicast
+    route-target import 65000:1000
+vrf context ntc
+  address-family ipv6 unicast
+    route-target export 65000:2000
+  address-family ipv4 unicast
+    route-target import 65000:1000
+    route-target export 65000:1000
+    route-target import 65000:2000
+    route-target import 65000:10000
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False,
+                             route_targets=[
+                                 dict(rt='65000:1000', state='absent'),
+                                 dict(rt='65000:2000', direction='import', state='absent'),
+                                 dict(rt='65000:3000', direction='export'),
+                                 dict(rt='65000:4000')]))
+        self.execute_module(changed=True, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target both auto evpn',
+            'no route-target import 65000:1000',
+            'no route-target export 65000:1000',
+            'no route-target import 65000:2000',
+            'route-target export 65000:3000',
+            'route-target import 65000:4000',
+            'route-target export 65000:4000'], sort=False)
+
+    def test_route_targets_idempotent(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 65000:1000
+    route-target export 65000:1000
+    route-target both auto evpn
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='65000:1000'),
+                                            dict(rt='65000:2000', state='absent')]))
+        self.execute_module(changed=False, commands=[])
+        self.load_config.assert_not_called()
+
+    def test_remove_address_family_ignores_route_targets(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target import 65000:1000
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv6', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='65000:2000')]))
+        self.execute_module(changed=True, commands=[
+            'vrf context ntc', 'no address-family ipv6 unicast'], sort=False)
+
+    def test_route_targets_in_other_address_family_do_not_satisfy_request(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 65000:1000
+  address-family ipv6 unicast
+    route-target import 65000:2000
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='65000:2000', direction='import')]))
+        self.execute_module(changed=True, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'route-target import 65000:2000'], sort=False)
+
+    def test_route_targets_require_rt(self):
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[dict(direction='import')]))
+        self.execute_module(failed=True)
+
+    def test_match_current_rt_uses_exact_lines(self):
+        current = 'address-family ipv4 unicast\n  route-target import 65000:10000\nend'
+        commands = nxos_vrf_af.match_current_rt(
+            dict(rt='65000:1000', state='present'), 'import', current, [])
+        self.assertEqual(commands, ['route-target import 65000:1000'])
+        commands = nxos_vrf_af.match_current_rt(
+            dict(rt='65000:1000', state='absent'), 'import', current, [])
+        self.assertEqual(commands, [])
+
+    def test_remove_missing_address_family_ignores_route_targets(self):
+        set_module_args(dict(vrf='ntc', afi='ipv6', state='absent',
+                             route_targets=[dict(rt='65000:1000')]))
+        self.execute_module(changed=False, commands=[])
