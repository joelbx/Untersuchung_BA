+def match_current_rt(rt, direction, current, rt_commands):
+    """Append the command needed for one route-target direction and value."""
+    command = 'route-target %s %s' % (direction, rt['rt'])
+    present = command in set(line.strip() for line in (current or '').splitlines())
+    if rt['state'] == 'present' and not present:
+        if command not in rt_commands:
+            rt_commands.append(command)
+    elif rt['state'] == 'absent' and present:
+        if 'no ' + command not in rt_commands:
+            rt_commands.append('no ' + command)
+    return rt_commands
+
