+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_uses_current_interpreter(mocker):
+    module = mocker.Mock()
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+
+    assert pip._get_pip(module) == [sys.executable, '-m', 'pip']
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_pip_with_explicit_executable(mocker):
+    module = mocker.Mock()
+    module.get_bin_path.return_value = '/usr/bin/custom-pip'
+    have_pip = mocker.patch.object(pip, '_have_pip_module')
+
+    assert pip._get_pip(module, executable='custom-pip') == ['/usr/bin/custom-pip']
+    have_pip.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_packages_falls_back_to_freeze(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [(1, '', 'unsupported format'), (0, 'six==1.0\n', '')]
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+    launcher = [sys.executable, '-m', 'pip']
+
+    command, out, err = pip._get_packages(module, launcher, '/tmp')
+
+    assert (command, out, err) == ('%s -m pip freeze' % sys.executable, 'six==1.0\n', '')
+    assert module.run_command.call_args_list[0][0][0] == launcher + ['list', '--format=freeze']
+    assert module.run_command.call_args_list[1][0][0] == launcher + ['freeze']
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_get_packages_uses_list_when_available(mocker):
+    module = mocker.Mock()
+    module.run_command.return_value = (0, 'six==1.0\n', '')
+    mocker.patch.object(pip, 'get_best_parsable_locale', return_value='C')
+
+    command, out, err = pip._get_packages(module, ['/usr/bin/pip'], '/tmp')
+
+    assert (command, out, err) == ('/usr/bin/pip list --format=freeze', 'six==1.0\n', '')
+    module.run_command.assert_called_once_with(
+        ['/usr/bin/pip', 'list', '--format=freeze'], cwd='/tmp',
+        environ_update={'LANG': 'C', 'LC_ALL': 'C', 'LC_MESSAGES': 'C'})
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_have_pip_module(mocker):
+    find_spec = mocker.patch('importlib.util.find_spec')
+    find_spec.return_value = mocker.sentinel.pip_spec
+    assert pip._have_pip_module()
+
+    find_spec.return_value = None
+    assert not pip._have_pip_module()
+
+    find_spec.side_effect = RuntimeError('broken import machinery')
+    assert not pip._have_pip_module()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{}], indirect=['patch_ansible_module'])
+def test_have_pip_module_uses_legacy_loader_when_find_spec_unavailable(mocker):
+    loader = mocker.patch('pkgutil.find_loader', return_value=mocker.sentinel.pip_loader)
+    mocker.patch.dict(sys.modules, {'importlib.util': None})
+    assert pip._have_pip_module()
+    loader.assert_called_once_with('pip')
+
+    loader.side_effect = RuntimeError('broken import machinery')
+    assert not pip._have_pip_module()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{'name': 'six'}], indirect=['patch_ansible_module'])
+def test_main_uses_current_interpreter_without_pip_binary(mocker, capfd):
+    mocker.patch.object(pip, '_have_pip_module', return_value=True)
+    get_bin_path = mocker.patch('ansible.module_utils.basic.AnsibleModule.get_bin_path', return_value=None)
+    run_command = mocker.patch('ansible.module_utils.basic.AnsibleModule.run_command',
+                               return_value=(0, 'Successfully installed six\n', ''))
+
+    with pytest.raises(SystemExit):
+        pip.main()
+
+    results = json.loads(capfd.readouterr()[0])
+    assert not results.get('failed')
+    assert results['cmd'] == [sys.executable, '-m', 'pip', 'install', 'six']
+    assert run_command.call_args[0][0] == results['cmd']
+    get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{'name': 'six', 'virtualenv': '/tmp/my-venv'}],
+                         indirect=['patch_ansible_module'])
+def test_main_uses_virtualenv_bin_as_path_prefix(mocker, capfd):
+    env_bin = os.path.join('/tmp/my-venv', 'bin')
+    mocker.patch.object(pip.os.path, 'exists', return_value=True)
+    mocker.patch.object(pip, 'is_executable', return_value=True)
+    run_command = mocker.patch('ansible.module_utils.basic.AnsibleModule.run_command',
+                               return_value=(0, 'Successfully installed six\n', ''))
+
+    with pytest.raises(SystemExit):
+        pip.main()
+
+    results = json.loads(capfd.readouterr()[0])
+    assert not results.get('failed')
+    assert results['cmd'][0] == os.path.join(env_bin, 'pip3' if pip.PY3 else 'pip2')
+    assert run_command.call_args[1]['path_prefix'] == env_bin
+
+
