+func connectionURL(cfg config.DatabaseConfig) (string, error) {
+	if err := cfg.Validate(); err != nil {
+		return "", err
+	}
+	if cfg.URL != "" {
+		return cfg.URL, nil
+	}
+	if cfg.Protocol == config.DatabaseProtocolSQLite {
+		dir := cfg.Path
+		if dir == "" {
+			dir = cfg.Host
+		}
+		path := (&url.URL{Path: filepath.Join(dir, cfg.Name)}).EscapedPath()
+		return "file:" + path, nil
+	}
+
+	port := cfg.Port
+	scheme := cfg.Protocol.String()
+	if port == 0 {
+		if cfg.Protocol == config.DatabaseProtocolPostgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{Scheme: scheme, Host: net.JoinHostPort(cfg.Host, strconv.Itoa(port)), Path: "/" + cfg.Name}
+	if cfg.Password != "" {
+		u.User = url.UserPassword(cfg.User, cfg.Password)
+	} else if cfg.User != "" {
+		u.User = url.User(cfg.User)
+	}
+	return u.String(), nil
+}
