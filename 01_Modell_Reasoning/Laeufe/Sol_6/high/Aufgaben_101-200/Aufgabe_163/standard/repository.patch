+func redactConnectionError(err error, rawurl, dsn string) string {
+	message := err.Error()
+	for _, secret := range []string{rawurl, dsn} {
+		if secret != "" {
+			message = strings.ReplaceAll(message, secret, "[REDACTED]")
+		}
+	}
+	if u, parseErr := url.Parse(rawurl); parseErr == nil {
+		var secrets []string
+		if u.User != nil {
+			if password, ok := u.User.Password(); ok {
+				secrets = append(secrets, password)
+			}
+		}
+		for key, values := range u.Query() {
+			if strings.Contains(strings.ToLower(key), "pass") {
+				secrets = append(secrets, values...)
+			}
+		}
+		for _, secret := range secrets {
+			if secret == "" {
+				continue
+			}
+			message = strings.ReplaceAll(message, secret, "[REDACTED]")
+			message = strings.ReplaceAll(message, url.QueryEscape(secret), "[REDACTED]")
+			message = strings.ReplaceAll(message, url.PathEscape(secret), "[REDACTED]")
+		}
+	}
+	return message
+}
