+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolUnknown DatabaseProtocol = iota
+	DatabaseProtocolSQLite
+	DatabaseProtocolPostgres
+	DatabaseProtocolMySQL
+)
+
+// Short names are provided for callers constructing database configurations.
+const (
+	SQLite   = DatabaseProtocolSQLite
+	Postgres = DatabaseProtocolPostgres
+	MySQL    = DatabaseProtocolMySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseProtocolSQLite:
+		return "sqlite"
+	case DatabaseProtocolPostgres:
+		return "postgres"
+	case DatabaseProtocolMySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// Validate checks the selected database configuration mode. A URL always wins.
+func (d DatabaseConfig) Validate() error {
+	if d.URL != "" {
+		return nil
+	}
+	if d.Protocol == DatabaseProtocolUnknown {
+		return fmt.Errorf("db.protocol cannot be empty; expected one of sqlite, postgres, mysql")
+	}
+	if d.Protocol > DatabaseProtocolMySQL {
+		return fmt.Errorf("db.protocol %d is invalid; expected one of sqlite, postgres, mysql", d.Protocol)
+	}
+	if d.Name == "" {
+		return fmt.Errorf("db.name cannot be empty")
+	}
+	if d.Protocol == DatabaseProtocolSQLite {
+		if d.Path == "" && d.Host == "" {
+			return fmt.Errorf("db.path (or db.host) cannot be empty for sqlite")
+		}
+	} else if d.Host == "" {
+		return fmt.Errorf("db.host cannot be empty")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return fmt.Errorf("db.port must be between 1 and 65535 when provided")
+	}
+	return nil
 }
 
