+func TestOpenFromFieldsAppliesPoolSettings(t *testing.T) {
+	cfg := config.Config{Database: config.DatabaseConfig{
+		Protocol: config.SQLite, Path: t.TempDir(), Name: "app.db",
+		MaxIdleConn: 2, MaxOpenConn: 3, ConnMaxLifetime: time.Minute,
+	}}
+	database, driver, err := openConfig(cfg, false)
+	require.NoError(t, err)
+	defer database.Close()
+	assert.Equal(t, SQLite, driver)
+	assert.Equal(t, 3, database.Stats().MaxOpenConnections)
+	_, err = database.Exec("CREATE TABLE IF NOT EXISTS settings (value TEXT)")
+	require.NoError(t, err)
+}
