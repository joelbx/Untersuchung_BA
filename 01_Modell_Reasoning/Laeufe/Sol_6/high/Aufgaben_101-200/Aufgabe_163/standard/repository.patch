+	assert.False(t, strings.Contains(message, secret))
+	assert.False(t, strings.Contains(message, "private"))
+	queryURL := "postgres://localhost/app?password=another-secret"
+	message = redactConnectionError(fmt.Errorf("authentication failed: another-secret"), queryURL, "")
+	assert.NotContains(t, message, "another-secret")
+}
