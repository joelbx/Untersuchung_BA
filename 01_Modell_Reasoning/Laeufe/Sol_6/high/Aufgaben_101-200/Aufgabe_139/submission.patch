+def test_parse_data_supplements_incomplete_promise_item(monkeypatch, identifier_field, identifier):
+    web.ctx.env = {}
+    staged = {
+        'title': 'Staged title',
+        'authors': [{'name': 'Staged author'}],
+        'publish_date': '2020',
+        'publishers': ['Staged publisher'],
+        'isbn_13': ['9781234567890'],
+        'number_of_pages': 42,
+    }
+    looked_up = []
+
+    class Result:
+        def first(self):
+            return {'data': json.dumps(staged)}
+
+    def find(identifiers):
+        looked_up.extend(identifiers)
+        return Result()
+
+    monkeypatch.setattr(ImportItem, 'find_staged_or_pending', find)
+    rec = {
+        'title': 'Original title',
+        'source_records': ['promise:1'],
+        'publishers': ['????'],
+        'authors': [{'name': '????'}],
+        'publish_date': '????',
+    }
+    if identifier_field == 'isbn_10':
+        rec['isbn_10'] = [identifier]
+    else:
+        rec['identifiers'] = {'amazon': [identifier]}
+    parsed, _ = code.parse_data(json.dumps(rec).encode())
+    assert looked_up == [identifier]
+    assert parsed['title'] == 'Original title'
+    assert parsed['authors'] == staged['authors']
+    assert parsed['publish_date'] == staged['publish_date']
+    assert parsed['publishers'] == staged['publishers']
+    assert parsed['isbn_13'] == staged['isbn_13']
