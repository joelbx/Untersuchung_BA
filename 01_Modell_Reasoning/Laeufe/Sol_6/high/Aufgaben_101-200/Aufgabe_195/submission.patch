+func TestLoadDeprecationsFromFileOnly(t *testing.T) {
+	tests := []struct {
+		name     string
+		contents string
+		warning  string
+	}{
+		{
+			name:     "ui enabled true",
+			contents: "ui:\n  enabled: true\n",
+			warning:  `"ui.enabled" is deprecated and will be removed in a future version.`,
+		},
+		{
+			name:     "cache memory expiration without enabled",
+			contents: "cache:\n  memory:\n    expiration: 30s\n",
+			warning:  `"cache.memory.expiration" is deprecated and will be removed in a future version. Please use 'cache.ttl' instead.`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := t.TempDir() + "/config.yml"
+			require.NoError(t, os.WriteFile(path, []byte(tt.contents), 0600))
+
+			result, err := Load(path)
+			require.NoError(t, err)
+			require.NotNil(t, result.Config)
+			assert.Equal(t, []string{tt.warning}, result.Warnings)
 		})
 	}
 }
