 const _ = require('lodash');
 const validator = require('validator');
+const nconf = require('nconf');
 
 const db = require('../database');
 const user = require('../user');
@@ -15,6 +16,67 @@ module.exports = function (Topics) {
 	Topics.onNewPostMade = async function (postData) {
 		await Topics.updateLastPostTime(postData.tid, postData.timestamp);
 		await Topics.addPostToTopic(postData.tid, postData);
+		await Topics.syncBacklinks(postData);
+	};
+
+	Topics.syncBacklinks = async function (postData) {
+		const validId = value => (typeof value === 'number' || typeof value === 'string') &&
+			/^\d+$/.test(String(value)) && Number.isSafeInteger(Number(value));
+		if (!postData || !validId(postData.pid) || Number(postData.pid) === 0 ||
+			!validId(postData.uid) || !validId(postData.tid) || Number(postData.tid) === 0 ||
+			typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const base = new URL(nconf.get('url'));
+		const basePath = base.pathname.replace(/\/$/, '');
+		const references = new Set();
+		const links = postData.content.match(/(?:[a-z][a-z\d+.-]*:)?\/\/[^\s<>"'()[\]]+|\/topic\/\d+(?![a-z\d])(?:\/[^\s<>"'()[\]]*)?/gi) || [];
+		links.forEach((link) => {
+			const absolute = !link.startsWith('/topic/');
+			let url;
+			try {
+				url = new URL(link, base);
+			} catch (err) {
+				return;
+			}
+			if (absolute && url.origin !== base.origin) {
+				return;
+			}
+			if (absolute && !url.pathname.startsWith(`${basePath}/topic/`)) {
+				return;
+			}
+			const path = absolute ? url.pathname.slice(basePath.length) : url.pathname;
+			const match = /^\/topic\/(\d+)(?:\/|$)/.exec(path);
+			if (match && Number.isSafeInteger(Number(match[1])) && Number(match[1]) !== Number(postData.tid)) {
+				references.add(String(Number(match[1])));
+			}
+		});
+
+		const key = `pid:${postData.pid}:backlinks`;
+		const oldReferences = await db.getSortedSetRange(key, 0, -1);
+		const existing = references.size ? await Topics.exists([...references]) : [];
+		const current = [...references].filter((tid, index) => existing[index]);
+		const added = current.filter(tid => !oldReferences.includes(tid));
+		const removed = oldReferences.filter(tid => !current.includes(tid));
+
+		for (const tid of removed) {
+			/* eslint-disable no-await-in-loop */
+			const eventIds = await db.getSortedSetRange(`topic:${tid}:events`, 0, -1);
+			const events = eventIds.length ? await db.getObjects(eventIds.map(id => `topicEvent:${id}`)) : [];
+			const backlinkIds = eventIds.filter((id, index) => events[index] &&
+				events[index].type === 'backlink' && events[index].href === `/post/${postData.pid}`);
+			if (backlinkIds.length) {
+				await Topics.events.purge(tid, backlinkIds);
+			}
+			await db.sortedSetRemove(key, tid);
+		}
+		for (const tid of added) {
+			/* eslint-disable no-await-in-loop */
+			await Topics.events.log(tid, { type: 'backlink', uid: postData.uid, href: `/post/${postData.pid}` });
+		}
+		await Promise.all(current.map(tid => db.sortedSetAdd(key, Date.now(), tid)));
+		return added.length + removed.length;
 	};
 
 	Topics.getTopicPosts = async function (tid, set, start, stop, uid, reverse) {
