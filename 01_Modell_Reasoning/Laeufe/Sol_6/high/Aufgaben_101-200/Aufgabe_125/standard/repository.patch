+			assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), [String(tid)]);
+			assert.strictEqual((await topics.events.get(tid)).filter(event => event.type === 'backlink').length, 1);
+
+			const [marker] = await topics.events.log(tid, { type: 'foo' });
