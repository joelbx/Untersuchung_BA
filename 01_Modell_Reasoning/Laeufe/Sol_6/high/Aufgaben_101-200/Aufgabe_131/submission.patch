diff --git a/packages/components/payments/client-extensions/usePollEvents.test.ts b/packages/components/payments/client-extensions/usePollEvents.test.ts
new file mode 100644
index 0000000..aba1779
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.ts
@@ -0,0 +1,127 @@
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+
+import { useEventManager } from '../../hooks';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+jest.mock('../../hooks/useEventManager');
+
+const call = jest.fn<Promise<void>, []>();
+const unsubscribe = jest.fn();
+let handler: (event: Record<string, unknown>) => void;
+const subscribe = jest.fn((listener: typeof handler) => {
+    handler = listener;
+    return unsubscribe;
+});
+
+const advance = async () => {
+    await act(async () => {
+        jest.advanceTimersByTime(interval);
+    });
+};
+
+beforeEach(() => {
+    jest.useFakeTimers();
+    jest.clearAllMocks();
+    call.mockResolvedValue(undefined);
+    jest.mocked(useEventManager).mockReturnValue({ call, subscribe } as any);
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+it('calls once per interval and stops after five attempts without a subscription', async () => {
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current();
+
+    expect(call).not.toHaveBeenCalled();
+    expect(subscribe).not.toHaveBeenCalled();
+
+    for (let attempt = 1; attempt <= maxPollingSteps; attempt += 1) {
+        jest.advanceTimersByTime(interval - 1);
+        expect(call).toHaveBeenCalledTimes(attempt - 1);
+        await act(async () => {
+            jest.advanceTimersByTime(1);
+        });
+        expect(call).toHaveBeenCalledTimes(attempt);
+    }
+
+    await polling;
+    jest.advanceTimersByTime(interval * 2);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
+it('ignores unrelated events and stops on the requested property and action', async () => {
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    handler({ Subscriptions: [{ Action: EVENT_ACTIONS.CREATE }] });
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+    await advance();
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).not.toHaveBeenCalled();
+
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    jest.advanceTimersByTime(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes after the final attempt if no matching event arrives', async () => {
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    for (let attempt = 0; attempt < maxPollingSteps; attempt += 1) {
+        await advance();
+    }
+    await polling;
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('completes once when a matching event arrives during an in-flight call', async () => {
+    let resolveCall!: () => void;
+    call.mockImplementationOnce(() => new Promise<void>((resolve) => (resolveCall = resolve)));
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    await advance();
+    handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    resolveCall();
+    await act(async () => {});
+    jest.advanceTimersByTime(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes when the expected event is delivered during subscription', async () => {
+    subscribe.mockImplementationOnce((listener) => {
+        handler = listener;
+        listener({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        return unsubscribe;
+    });
+    const { result } = renderHook(() => usePollEvents());
+
+    await result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    jest.advanceTimersByTime(interval * maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    expect(call).not.toHaveBeenCalled();
+});
+
+it('cleans up when an update call fails', async () => {
+    call.mockRejectedValueOnce(new Error('failed'));
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    const rejection = expect(polling).rejects.toThrow('failed');
+
+    await advance();
+    await rejection;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
