diff --git a/tests/unit/browser/webengine/test_webengine_certificateerror.py b/tests/unit/browser/webengine/test_webengine_certificateerror.py
new file mode 100644
index 0000000..2944910
--- /dev/null
+++ b/tests/unit/browser/webengine/test_webengine_certificateerror.py
@@ -0,0 +1,40 @@
+# vim: ft=python fileencoding=utf-8 sts=4 sw=4 et:
+
+"""Tests for WebEngine certificate error wrappers."""
+
+import pytest
+
+from qutebrowser.browser.webengine import certificateerror
+from qutebrowser.utils import usertypes
+
+
+@pytest.mark.parametrize('qt6', [False, True])
+def test_create_and_decisions(monkeypatch, mocker, qt6):
+    monkeypatch.setattr(certificateerror.machinery, 'IS_QT6', qt6)
+    error = mocker.Mock()
+    error.errorDescription.return_value = '<unsafe & text>'
+
+    wrapper = certificateerror.create(error)
+    expected_class = (certificateerror.CertificateErrorWrapperQt6 if qt6 else
+                      certificateerror.CertificateErrorWrapperQt5)
+    assert isinstance(wrapper, expected_class)
+    assert wrapper.html() == '<p>&lt;unsafe &amp; text&gt;</p>'
+    assert not wrapper.certificate_was_accepted()
+
+    if qt6:
+        wrapper.defer()
+        error.defer.assert_called_once_with()
+    else:
+        with pytest.raises(usertypes.UndeferrableError):
+            wrapper.defer()
+
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    if qt6:
+        error.acceptCertificate.assert_called_once_with()
+        error.rejectCertificate.assert_called_once_with()
+    else:
+        error.acceptCertificate.assert_not_called()
+        error.rejectCertificate.assert_not_called()
diff --git a/tests/unit/browser/webkit/test_certificateerror.py b/tests/unit/browser/webkit/test_certificateerror.py
index 4d497b5..c306631 100644
--- a/tests/unit/browser/webkit/test_certificateerror.py
+++ b/tests/unit/browser/webkit/test_certificateerror.py
@@ -21,6 +21,7 @@ import pytest
 from qutebrowser.qt.network import QSslError
 
 from qutebrowser.browser.webkit import certificateerror
+from qutebrowser.utils import usertypes
 
 
 class FakeError:
@@ -71,3 +72,42 @@ def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+@pytest.mark.parametrize('errors', [
+    [FakeError('<script>"x" & y')],
+    [FakeError('<script>"x" & y'), FakeError("'other'")],
+])
+def test_html_escapes_all_special_characters(errors):
+    wrapper = certificateerror.CertificateErrorWrapper(errors=errors)
+    rendered = wrapper.html()
+    assert '&lt;script&gt;&quot;x&quot; &amp; y' in rendered
+    assert '<script>' not in rendered
+    if len(errors) > 1:
+        assert '&#x27;other&#x27;' in rendered
+
+
+def test_reply_decision(mocker):
+    reply = mocker.Mock()
+    errors = [FakeError('bad certificate')]
+    wrapper = certificateerror.CertificateErrorWrapper(reply=reply, errors=errors)
+    reply.ignoreSslErrors.assert_not_called()
+
+    assert not wrapper.certificate_was_accepted()
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    reply.ignoreSslErrors.assert_called_once_with()
+
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    reply.ignoreSslErrors.assert_called_once_with()
+    with pytest.raises(usertypes.UndeferrableError):
+        wrapper.defer()
+
+
+def test_positional_reply_and_errors(mocker):
+    reply = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply, [FakeError('bad certificate')])
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
