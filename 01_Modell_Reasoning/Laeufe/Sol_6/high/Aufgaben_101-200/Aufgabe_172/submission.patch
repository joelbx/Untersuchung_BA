+func Test_detectScanDestAcrossPackages(t *testing.T) {
+	l := base{
+		osPackages: osPackages{Packages: models.Packages{
+			"legacy":   {AffectedProcs: []models.AffectedProcess{{ListenPorts: []string{"127.0.0.1:99"}}}},
+			"direct":   {AffectedProcs: []models.AffectedProcess{{ListenPortStats: []models.PortStat{{BindAddress: "127.0.0.1", Port: "22"}, {BindAddress: "127.0.0.1", Port: "22"}}}}},
+			"wildcard": {AffectedProcs: []models.AffectedProcess{{ListenPortStats: []models.PortStat{{BindAddress: "*", Port: "22"}, {BindAddress: "*", Port: "80"}}}}},
+		}},
+		ServerInfo: config.ServerInfo{IPv4Addrs: []string{"127.0.0.1", "192.168.1.1"}},
+	}
+	got := l.detectScanDest()
+	for addr, want := range map[string][]string{
+		"127.0.0.1":   {"22", "80"},
+		"192.168.1.1": {"22", "80"},
+	} {
+		if len(got[addr]) != len(want) {
+			t.Fatalf("destination %s has ports %v, want %v", addr, got[addr], want)
+		}
+		for _, port := range want {
+			found := false
+			for _, actual := range got[addr] {
+				if actual == port {
+					found = true
+				}
+			}
+			if !found {
+				t.Errorf("destination %s missing port %s: %v", addr, port, got[addr])
+			}
+		}
+	}
+}
