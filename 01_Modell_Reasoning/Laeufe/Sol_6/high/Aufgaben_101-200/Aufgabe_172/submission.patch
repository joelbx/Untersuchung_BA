+// NewPortStat parses a listening address and port.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	address, port, err := net.SplitHostPort(ipPort)
+	if err != nil || address == "" || port == "" {
+		return nil, xerrors.Errorf("invalid listening port %q: expected <ip>:<port>", ipPort)
+	}
+	if address != "*" && net.ParseIP(address) == nil {
+		return nil, xerrors.Errorf("invalid listening address %q", address)
+	}
+	n, err := strconv.Atoi(port)
+	if err != nil || n < 0 || n > 65535 {
+		return nil, xerrors.Errorf("invalid listening port %q", port)
+	}
+	if strings.HasPrefix(ipPort, "[") {
+		address = "[" + address + "]"
+	}
+	stat.BindAddress, stat.Port = address, port
+	return stat, nil
+}
