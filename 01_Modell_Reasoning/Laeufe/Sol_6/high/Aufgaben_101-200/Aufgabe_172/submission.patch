+func TestAffectedProcessLegacyListenPorts(t *testing.T) {
+	var p Package
+	data := []byte(`{"AffectedProcs":[{"pid":"42","listenPorts":["127.0.0.1:22","*:80"]}]}`)
+	if err := json.Unmarshal(data, &p); err != nil {
+		t.Fatal(err)
+	}
+	if len(p.AffectedProcs) != 1 || !reflect.DeepEqual(p.AffectedProcs[0].ListenPorts, []string{"127.0.0.1:22", "*:80"}) {
+		t.Fatalf("legacy ports were not preserved: %#v", p.AffectedProcs)
+	}
+	if p.AffectedProcs[0].ListenPortStats != nil {
+		t.Fatalf("legacy ports unexpectedly populated scan statistics: %#v", p.AffectedProcs[0])
+	}
+}
+
+func TestNewPortStatInvalid(t *testing.T) {
+	for _, input := range []string{"127.0.0.1", ":22", "127.0.0.1:", "::1:22", "localhost:22", "127.0.0.1:abc", "[::1]22"} {
+		if stat, err := NewPortStat(input); err == nil {
+			t.Errorf("NewPortStat(%q) = %#v, nil; want error", input, stat)
+		}
+	}
+}
+
+func TestPackageHasReachablePort(t *testing.T) {
+	for _, tc := range []struct {
+		pack Package
+		want bool
+	}{
+		{Package{}, false},
+		{Package{AffectedProcs: []AffectedProcess{{ListenPorts: []string{"127.0.0.1:22"}}}}, false},
+		{Package{AffectedProcs: []AffectedProcess{{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1"}}}}}}, true},
+	} {
+		if got := tc.pack.HasReachablePort(); got != tc.want {
+			t.Errorf("HasReachablePort(%#v) = %t, want %t", tc.pack, got, tc.want)
+		}
+	}
+}
