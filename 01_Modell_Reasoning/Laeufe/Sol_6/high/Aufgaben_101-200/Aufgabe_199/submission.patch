 from __future__ import print_function
 import os
 import pytest
+import requests
 from openlibrary.catalog import get_ia
 from openlibrary.core import ia
 from openlibrary.catalog.marc.marc_xml import MarcXml
 from openlibrary.catalog.marc.marc_binary import MarcBinary, BadLength, BadMARC
 
+
+def make_response(content=b'', status=200, content_type=None, encoding=None):
+    response = requests.Response()
+    response._content = content
+    response.status_code = status
+    response.url = 'https://example.org/record'
+    response.encoding = encoding
+    if content_type:
+        response.headers['Content-Type'] = content_type
+    return response
+
+
 def return_test_marc_bin(url):
     assert url, "return_test_marc_bin({})".format(url)
     return return_test_marc_data(url, "bin_input")
@@ -18,7 +31,87 @@ def return_test_marc_data(url, test_data_subdir="xml_input"):
     filename = url.split('/')[-1]
     test_data_dir = "/../../catalog/marc/tests/test_data/%s/" % test_data_subdir
     path = os.path.dirname(__file__) + test_data_dir + filename
-    return open(path, mode='rb')
+    with open(path, mode='rb') as fixture:
+        return make_response(fixture.read())
+
+
+def test_urlopen_keep_trying_forwards_options_and_defaults_to_utf8(monkeypatch):
+    calls = []
+    response = make_response('é'.encode('utf-8'), content_type='text/xml', encoding='ISO-8859-1')
+
+    def get(url, **kwargs):
+        calls.append((url, kwargs))
+        return response
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    result = get_ia.urlopen_keep_trying('https://example.org/record', headers={'Range': 'bytes=0-4'}, timeout=5)
+
+    assert result is response
+    assert calls == [('https://example.org/record', {'headers': {'Range': 'bytes=0-4'}, 'timeout': 5})]
+    assert result.text == 'é'
+
+
+def test_urlopen_keep_trying_preserves_declared_charset(monkeypatch):
+    response = make_response(b'\xe9', content_type='text/plain; charset=iso-8859-1', encoding='iso-8859-1')
+    monkeypatch.setattr(get_ia.requests, 'get', lambda *args, **kwargs: response)
+
+    assert get_ia.urlopen_keep_trying('https://example.org/record').text == 'é'
+    assert response.encoding == 'iso-8859-1'
+
+
+@pytest.mark.parametrize('status', [403, 404, 416])
+def test_urlopen_keep_trying_raises_terminal_http_errors(monkeypatch, status):
+    calls = []
+
+    def get(url, **kwargs):
+        calls.append(url)
+        return make_response(status=status)
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+    with pytest.raises(requests.exceptions.HTTPError) as exc:
+        get_ia.urlopen_keep_trying('https://example.org/record')
+
+    assert exc.value.response.status_code == status
+    assert len(calls) == 1
+
+
+def test_urlopen_keep_trying_retries_server_and_connection_errors(monkeypatch):
+    responses = [make_response(status=500), requests.exceptions.ConnectionError(), make_response(b'ok')]
+    calls = []
+    monkeypatch.setattr(get_ia, 'sleep', lambda seconds: calls.append(seconds))
+
+    def get(url, **kwargs):
+        response = responses.pop(0)
+        if isinstance(response, Exception):
+            raise response
+        return response
+
+    monkeypatch.setattr(get_ia.requests, 'get', get)
+
+    assert get_ia.urlopen_keep_trying('https://example.org/record').content == b'ok'
+    assert calls == [2, 2]
+
+
+def test_files_parses_response_content_and_retries_bad_xml(monkeypatch):
+    responses = [make_response(b'<files'), make_response(b'<files><file name="part.mrc"><size>12</size></file></files>')]
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', lambda url: responses.pop(0))
+    monkeypatch.setattr(get_ia, 'sleep', lambda seconds: None)
+
+    assert list(get_ia.files('item')) == [('part.mrc', 12)]
+
+
+def test_get_from_archive_bulk_uses_range_header(monkeypatch):
+    calls = []
+    monkeypatch.setattr(get_ia, 'MAX_MARC_LENGTH', 15)
+
+    def get(url, headers=None):
+        calls.append((url, headers))
+        return make_response(b'00010abcde00015padding')
+
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', get)
+
+    assert get_ia.get_from_archive_bulk('item/part:0:10') == (b'00010abcde', 10, 15)
+    assert calls == [(get_ia.IA_DOWNLOAD_URL + 'item/part', {'Range': 'bytes=0-14'})]
 
