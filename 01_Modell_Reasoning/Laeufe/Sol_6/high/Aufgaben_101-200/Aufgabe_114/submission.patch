+// ArtistFolder returns the common parent of the albums' media directories.
+func (als Albums) ArtistFolder() string {
+	var folder string
+	for _, al := range als {
+		for _, dir := range al.Dirs() {
+			parent := filepath.Dir(dir)
+			if folder == "" {
+				folder = parent
+				continue
+			}
+			for folder != parent && !isDirectoryWithin(parent, folder) {
+				prev := folder
+				folder = filepath.Dir(folder)
+				if folder == prev {
+					return ""
+				}
+			}
+		}
+	}
+	return folder
+}
+
+func isDirectoryWithin(dir, parent string) bool {
+	rel, err := filepath.Rel(parent, dir)
+	return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
