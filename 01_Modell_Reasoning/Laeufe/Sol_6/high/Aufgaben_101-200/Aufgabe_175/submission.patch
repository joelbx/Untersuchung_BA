diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..bc7d764
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,194 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupTimeFormat = "20060102T150405.000000000Z"
+
+var backupName = regexp.MustCompile(`^navidrome_backup_\d{8}T\d{6}\.\d{9}Z\.db$`)
+
+// Backup creates a consistent online copy of the database in backup.path.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", fmt.Errorf("create backup directory: %w", err)
+	}
+	file, err := os.CreateTemp(dir, ".navidrome_backup_*.db")
+	if err != nil {
+		return "", err
+	}
+	tmp := file.Name()
+	if err := file.Close(); err != nil {
+		_ = os.Remove(tmp)
+		return "", err
+	}
+	defer os.Remove(tmp)
+
+	dest, err := sql.Open(Driver, tmp)
+	if err != nil {
+		return "", err
+	}
+	err = copySQLite(ctx, d.readDB, dest)
+	closeErr := dest.Close()
+	if err != nil {
+		return "", fmt.Errorf("backup database: %w", err)
+	}
+	if closeErr != nil {
+		return "", closeErr
+	}
+
+	// A nanosecond timestamp keeps lexical order equal to creation order.
+	for i := 0; i < 10; i++ {
+		path := filepath.Join(dir, "navidrome_backup_"+time.Now().UTC().Format(backupTimeFormat)+".db")
+		if _, err := os.Stat(path); err == nil {
+			continue
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return "", err
+		}
+		// Link is atomic and refuses to replace an existing backup.
+		if err := os.Link(tmp, path); err != nil {
+			if errors.Is(err, os.ErrExist) {
+				continue
+			}
+			return "", err
+		}
+		return path, nil
+	}
+	return "", errors.New("could not allocate unique backup name")
+}
+
+// Restore replaces the current database contents from a SQLite backup.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return errors.New("backup file must be a regular file")
+	}
+	// Opening the source read-only also prevents SQLite from creating an empty
+	// database when a bad path is supplied.
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	if currentInfo, err := os.Stat(conf.Server.DbPath); err == nil && os.SameFile(info, currentInfo) {
+		return errors.New("backup file is the live database")
+	}
+	sourceURI := (&url.URL{Scheme: "file", Path: abs}).String() + "?mode=ro"
+	source, err := sql.Open(Driver, sourceURI)
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var check string
+	if err := source.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&check); err != nil {
+		return fmt.Errorf("check backup integrity: %w", err)
+	}
+	if check != "ok" {
+		return fmt.Errorf("backup integrity check failed: %s", check)
+	}
+	if err := copySQLite(ctx, source, d.writeDB); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+// copySQLite uses SQLite's online backup API so concurrent database writes
+// cannot produce an inconsistent copy.
+func copySQLite(ctx context.Context, source, destination *sql.DB) error {
+	src, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	dst, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dst.Close()
+	return src.Raw(func(srcDriver any) error {
+		return dst.Raw(func(dstDriver any) error {
+			s, ok := srcDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("source is not SQLite")
+			}
+			d, ok := dstDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("destination is not SQLite")
+			}
+			backup, err := d.Backup("main", s, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+// Prune removes all but the newest backup.count files.
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count must be non-negative")
+	}
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is not configured")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		if entry.Type().IsRegular() && backupName.MatchString(entry.Name()) {
+			names = append(names, entry.Name())
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
