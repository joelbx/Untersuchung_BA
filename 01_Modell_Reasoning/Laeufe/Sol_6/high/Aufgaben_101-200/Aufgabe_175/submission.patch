index 0000000..baab8b5
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,83 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	dir := t.TempDir()
+	oldBackup, oldDBPath := conf.Server.Backup, conf.Server.DbPath
+	t.Cleanup(func() {
+		conf.Server.Backup, conf.Server.DbPath = oldBackup, oldDBPath
+	})
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 0
+	conf.Server.DbPath = filepath.Join(dir, "live.db")
+	reader, err := sql.Open(Driver, conf.Server.DbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	writer, err := sql.Open(Driver, conf.Server.DbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := &db{readDB: reader, writeDB: writer}
+	defer d.Close()
+	ctx := context.Background()
+	if _, err := writer.Exec("CREATE TABLE example (value TEXT); INSERT INTO example VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(filepath.Base(first), "navidrome_backup_") {
+		t.Fatalf("unexpected backup name: %s", first)
+	}
+	if _, err := writer.Exec("UPDATE example SET value = 'after'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := reader.QueryRow("SELECT value FROM example").Scan(&value); err != nil || value != "before" {
+		t.Fatalf("restored value = %q, err = %v", value, err)
+	}
+	second, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup filenames collided")
+	}
+	if err := os.WriteFile(filepath.Join(conf.Server.Backup.Path, "unrelated.db"), []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	conf.Server.Backup.Count = 1
+	n, err := d.Prune(ctx)
+	if err != nil || n != 1 {
+		t.Fatalf("pruned %d, err = %v", n, err)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("old backup still exists: %v", err)
+	}
+	conf.Server.Backup.Count = 0
+	n, err = d.Prune(ctx)
+	if err != nil || n != 1 {
+		t.Fatalf("pruned %d with count 0, err = %v", n, err)
+	}
+	if _, err := os.Stat(filepath.Join(conf.Server.Backup.Path, "unrelated.db")); err != nil {
+		t.Fatal(err)
+	}
+}
