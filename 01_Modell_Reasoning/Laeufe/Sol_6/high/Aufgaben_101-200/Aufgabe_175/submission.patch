@@ -0,0 +1,46 @@
+package cmd
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/spf13/cobra"
+)
+
+func backupSubcommand(t *testing.T, name string) *cobra.Command {
+	t.Helper()
+	for _, group := range rootCmd.Commands() {
+		if group.Name() == "backup" {
+			for _, command := range group.Commands() {
+				if command.Name() == name {
+					return command
+				}
+			}
+		}
+	}
+	t.Fatalf("backup %s command not registered", name)
+	return nil
+}
+
+func TestDestructiveBackupCommandsRequireConfirmation(t *testing.T) {
+	previous := conf.Server.Backup
+	t.Cleanup(func() { conf.Server.Backup = previous })
+	conf.Server.Backup.Count = 0
+	for _, name := range []string{"prune", "restore"} {
+		t.Run(name, func(t *testing.T) {
+			command := backupSubcommand(t, name)
+			command.SetIn(strings.NewReader("no\n"))
+			command.SetErr(&bytes.Buffer{})
+			if name == "restore" {
+				if err := command.Flags().Set("backup-file", "some-backup.db"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := command.RunE(command, nil); err == nil {
+				t.Fatal("destructive command proceeded without confirmation")
+			}
+		})
+	}
+}
