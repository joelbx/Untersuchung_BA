@@ -0,0 +1,72 @@
+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Create, prune, or restore database backups"}
+	createCmd := &cobra.Command{
+		Use: "create", Short: "Create a database backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			database := db.Db()
+			defer database.Close()
+			path, err := database.Backup(cmd.Context())
+			if err == nil {
+				fmt.Fprintln(cmd.OutOrStdout(), path)
+			}
+			return err
+		},
+	}
+	pruneCmd := &cobra.Command{
+		Use: "prune", Short: "Remove old database backups", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, _ := cmd.Flags().GetBool("force")
+			if conf.Server.Backup.Count == 0 && !force && !confirmBackupAction(cmd, "Delete all database backups?") {
+				return fmt.Errorf("backup pruning cancelled")
+			}
+			n, err := db.Db().Prune(cmd.Context())
+			if err == nil {
+				fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backup(s)\n", n)
+			}
+			return err
+		},
+	}
+	restoreCmd := &cobra.Command{
+		Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, _ := cmd.Flags().GetString("backup-file")
+			if path == "" {
+				return fmt.Errorf("--backup-file is required")
+			}
+			force, _ := cmd.Flags().GetBool("force")
+			if !force && !confirmBackupAction(cmd, "Replace the current database with "+path+"?") {
+				return fmt.Errorf("database restore cancelled")
+			}
+			database := db.Db()
+			defer database.Close()
+			if err := database.Restore(cmd.Context(), path); err != nil {
+				return err
+			}
+			fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+			return nil
+		},
+	}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation when deleting all backups")
+	restoreCmd.Flags().String("backup-file", "", "path to the database backup to restore")
+	restoreCmd.Flags().Bool("force", false, "skip restore confirmation")
+	backupCmd.AddCommand(createCmd, pruneCmd, restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackupAction(cmd *cobra.Command, question string) bool {
+	fmt.Fprintf(cmd.ErrOrStderr(), "%s Type 'yes' to continue: ", question)
+	answer, _ := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	return strings.TrimSpace(answer) == "yes"
+}
