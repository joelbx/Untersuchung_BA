+@pytest.mark.parametrize("source", ["runtime", "config"])
+@pytest.mark.parametrize("request_url, blocked", [
+    ("https://example.com/path", True),
+    ("https://sub.example.com/path", True),
+    ("https://a.b.example.com/path", True),
+    ("https://a.b.example.com./path", True),
+    ("https://otherexample.com/path", False),
+    ("https://example.org/path", False),
+])
+def test_parent_domain_blocking(config_stub, host_blocker_factory,
+                                source, request_url, blocked):
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.whitelist = []
+    host_blocker = host_blocker_factory()
+    hosts = (host_blocker._blocked_hosts if source == "runtime" else
+             host_blocker._config_blocked_hosts)
+    hosts.add("example.com")
+
+    assert host_blocker._is_blocked(QUrl(request_url)) is blocked
+
+
+@pytest.mark.parametrize("source", ["runtime", "config"])
+def test_parent_domain_whitelist_override(config_stub, host_blocker_factory,
+                                          source):
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.whitelist = [
+        "https://allowed.example.com/*"]
+    host_blocker = host_blocker_factory()
+    hosts = (host_blocker._blocked_hosts if source == "runtime" else
+             host_blocker._config_blocked_hosts)
+    hosts.add("example.com")
+
+    assert not host_blocker._is_blocked(QUrl("https://allowed.example.com/path"))
+    assert host_blocker._is_blocked(QUrl("https://other.example.com/path"))
+
+
+def test_trailing_dot_in_blocklist(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.whitelist = []
+    host_blocker = host_blocker_factory()
+    host_blocker._config_blocked_hosts |= host_blocker._read_hosts_line(
+        b"example.com.\n")
+
+    assert host_blocker._is_blocked(QUrl("https://sub.example.com/path"))
+
+
+def test_disabled_blocking_for_parent_domain(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.enabled = False
+    config_stub.val.content.blocking.method = "hosts"
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+
+    assert not host_blocker._is_blocked(QUrl("https://sub.example.com/path"))
+
+
