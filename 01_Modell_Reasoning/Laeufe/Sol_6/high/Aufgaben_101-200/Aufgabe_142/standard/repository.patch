+
+import (
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+func TestApplyValueTraitsNestedExpression(t *testing.T) {
+	values, err := ApplyValueTraits(`{{regexp.replace(email.local(external.email), "^(.*)$", "user-$1")}}`, map[string][]string{"email": {"alice@example.com"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"user-alice"}, values)
+
+	_, err = ApplyValueTraits(`{{email.local(internal.unsupported)}}`, map[string][]string{"unsupported": {"alice@example.com"}})
+	require.True(t, trace.IsBadParameter(err), "%v", err)
+	require.Contains(t, err.Error(), `unsupported variable "unsupported"`)
+
+	_, err = ApplyValueTraits(`{{regexp.replace(external.email, "^missing$", "x")}}`, map[string][]string{"email": {"alice@example.com"}})
+	require.True(t, trace.IsNotFound(err), "%v", err)
+	require.Contains(t, err.Error(), "variable interpolation result is empty")
+}
