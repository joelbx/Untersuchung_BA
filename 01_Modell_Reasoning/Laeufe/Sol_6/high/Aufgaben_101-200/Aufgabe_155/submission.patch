+func TestImageReference(t *testing.T) {
+	tests := []struct {
+		name     string
+		image    Image
+		fullName string
+		err      string
+	}{
+		{name: "tag", image: Image{Name: "example/app", Tag: "v1"}, fullName: "example/app:v1"},
+		{name: "digest", image: Image{Name: "example/app", Digest: "sha256:abc"}, fullName: "example/app@sha256:abc"},
+		{name: "no name", image: Image{Digest: "sha256:abc"}, err: "Invalid arguments : no image name"},
+		{name: "no reference", image: Image{Name: "example/app"}, err: "Invalid arguments : no image tag and digest"},
+		{name: "conflict", image: Image{Name: "example/app", Tag: "v1", Digest: "sha256:abc"}, err: "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := IsValidImage(tt.image)
+			if tt.err != "" {
+				if err == nil || err.Error() != tt.err {
+					t.Fatalf("IsValidImage() error = %v, want %q", err, tt.err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("IsValidImage() error = %v", err)
+			}
+			if got := tt.image.GetFullName(); got != tt.fullName {
+				t.Errorf("GetFullName() = %q, want %q", got, tt.fullName)
+			}
+		})
+	}
+}
