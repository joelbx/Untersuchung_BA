+func TestEnsureUUIDsImageReference(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+
+	tests := []struct {
+		name  string
+		image models.Image
+		key   string
+	}{
+		{name: "tag", image: models.Image{Name: "example/app", Tag: "v1"}, key: "example/app:v1@image@host"},
+		{name: "digest", image: models.Image{Name: "example/app", Digest: "sha256:abc"}, key: "example/app@sha256:abc@image@host"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf = config.Config{Servers: map[string]config.ServerInfo{
+				"image@host": {},
+			}}
+			dir, err := ioutil.TempDir("", "vuls-image-report-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer os.RemoveAll(dir)
+			path := filepath.Join(dir, "config.toml")
+			if err := ioutil.WriteFile(path, nil, 0600); err != nil {
+				t.Fatal(err)
+			}
+			results := models.ScanResults{{ServerName: "image@host", Image: tt.image}}
+			if err := EnsureUUIDs(path, results); err != nil {
+				t.Fatal(err)
+			}
+			if got := config.Conf.Servers["image@host"].UUIDs[tt.key]; got == "" {
+				t.Errorf("no UUID recorded for %q", tt.key)
+			}
+		})
+	}
+}
