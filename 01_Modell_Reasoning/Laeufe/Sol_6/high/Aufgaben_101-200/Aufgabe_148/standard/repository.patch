+func TestProxySSHHello(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener})
+	require.NoError(t, err)
+	sshListener := mux.SSH()
+	go mux.Serve()
+	defer mux.Close()
+
+	for _, test := range []struct {
+		name       string
+		prefix     string
+		clientAddr string
+	}{
+		{name: "IPv4", prefix: apisshutils.ProxyHelloSignature + `{"clientAddr":"192.0.2.10:1234","tracingContext":{"key":"value"}}` + "\x00", clientAddr: "192.0.2.10:1234"},
+		{name: "IPv6", prefix: apisshutils.ProxyHelloSignature + `{"clientAddr":"[2001:db8::1]:2222"}` + "\x00", clientAddr: "[2001:db8::1]:2222"},
+		{name: "NoClientAddr", prefix: apisshutils.ProxyHelloSignature + `{}` + "\x00"},
+		{name: "StandardSSH"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			wantAddr := test.clientAddr
+			if wantAddr == "" {
+				wantAddr = client.LocalAddr().String()
+			}
+			message := test.prefix + "SSH-2.0-test\r\n"
+			_, err = io.WriteString(client, message)
+			require.NoError(t, err)
+
+			server, err := sshListener.Accept()
+			require.NoError(t, err)
+			defer server.Close()
+			require.Equal(t, ProtoSSH, server.(*Conn).Protocol())
+			require.Equal(t, wantAddr, server.RemoteAddr().String())
+			read := make([]byte, len(message))
+			_, err = io.ReadFull(server, read)
+			require.NoError(t, err)
+			require.Equal(t, message, string(read))
+		})
+	}
+}
