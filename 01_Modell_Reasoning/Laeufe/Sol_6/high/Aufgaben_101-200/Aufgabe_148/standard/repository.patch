+// readProxySSHHello reads a bounded Teleport SSH hello and puts it back for
+// the SSH server, which also uses the payload for tracing context.
+func readProxySSHHello(reader *bufio.Reader) (net.Addr, *bufio.Reader, error) {
+	const maxHelloBytes = 255 // SSH version string limit used by the SSH server.
+	hello := make([]byte, 0, maxHelloBytes)
+	for len(hello) < maxHelloBytes {
+		b, err := reader.ReadByte()
+		if err != nil {
+			return nil, nil, trace.Wrap(err, "reading Teleport proxy hello")
+		}
+		hello = append(hello, b)
+		if b == 0 {
+			break
+		}
+	}
+	if len(hello) == maxHelloBytes && hello[len(hello)-1] != 0 {
+		return nil, nil, trace.BadParameter("Teleport proxy hello is too long")
+	}
+	var payload sshutils.HandshakePayload
+	if err := json.Unmarshal(hello[len(sshutils.ProxyHelloSignature):len(hello)-1], &payload); err != nil {
+		return nil, nil, trace.Wrap(err, "invalid Teleport proxy hello")
+	}
+	var clientAddr net.Addr
+	if payload.ClientAddr != "" {
+		host, port, err := net.SplitHostPort(payload.ClientAddr)
+		if err != nil {
+			return nil, nil, trace.Wrap(err, "invalid Teleport proxy client address")
+		}
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 0 || portNumber > 65535 || net.ParseIP(host) == nil {
+			return nil, nil, trace.BadParameter("invalid Teleport proxy client address")
+		}
+		clientAddr = &net.TCPAddr{IP: net.ParseIP(host), Port: portNumber}
+	}
+	return clientAddr, bufio.NewReader(io.MultiReader(bytes.NewReader(hello), reader)), nil
+}
