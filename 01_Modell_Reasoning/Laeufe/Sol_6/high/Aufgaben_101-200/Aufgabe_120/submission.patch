+class Batch:
+    """One 10k-cover batch inside a million-cover archive.org item."""
+
+    def __init__(self, item_id, batch_id, size=None):
+        self.item_id, self.batch_id = self._format_ids(item_id, batch_id)
+        self.size = None if size is None else _size(size)
+
+    def _norm_ids(self):
+        return self.item_id, self.batch_id
+
+    @staticmethod
+    def _format_ids(item_id, batch_id):
+        item_id, batch_id = int(item_id), int(batch_id)
+        if not 0 <= item_id <= 9999 or not 0 <= batch_id <= 99:
+            raise ValueError('Invalid item or batch ID')
+        return f'{item_id:04d}', f'{batch_id:02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item_id, batch_id = cls._format_ids(item_id, batch_id)
+        size = _size(size)
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        return os.path.join('items', item, f'{item}_{batch_id}.{ext}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    @property
+    def start_id(self):
+        return int(self.item_id) * 1_000_000 + int(self.batch_id) * 10_000
+
+    @contextmanager
+    def lock(self):
+        path = self.get_abspath(self.item_id, self.batch_id, ext='lock')
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, 'a+b') as lockfile:
+            try:
+                fcntl.flock(lockfile, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError as exc:
+                raise RuntimeError(f'Batch {self.item_id}_{self.batch_id} is busy') from exc
+            try:
+                yield
+            finally:
+                fcntl.flock(lockfile, fcntl.LOCK_UN)
+
+    def process_pending(self, upload=False, finalize=False, test=True, uploader=None):
+        """Verify staged ZIPs, optionally upload them and complete the batch.
+
+        Completion requires all four variants to be present and visible remotely.
+        """
+        uploader = uploader or Uploader()
+        with self.lock():
+            if (upload or finalize) and not test and not CoverDB().is_batch_closed(self.item_id, self.batch_id):
+                return False
+            sizes = SIZES if self.size is None else (self.size,)
+            for size in sizes:
+                path = self.get_abspath(self.item_id, self.batch_id, size)
+                if not os.path.isfile(path):
+                    continue
+                with zipfile.ZipFile(path) as archive:
+                    if archive.testzip() is not None or not count_files_in_zip(path):
+                        raise ValueError(f'Invalid or empty ZIP: {path}')
+                item = os.path.basename(os.path.dirname(path))
+                if upload and not test and not uploader.is_uploaded(item, os.path.basename(path)):
+                    uploader.upload(item, [path])
+                if finalize and not test and not uploader.is_uploaded(item, os.path.basename(path)):
+                    raise RuntimeError(f'Upload not verified: {path}')
+            if finalize and not test:
+                self._finalize(test=False, uploader=uploader)
+
+    def finalize(self, start_id=None, test=True, uploader=None):
+        with self.lock():
+            return self._finalize(start_id, test, uploader)
+
+    def _finalize(self, start_id=None, test=True, uploader=None):
+        if test:
+            return False
+        if start_id is not None and int(start_id) != self.start_id:
+            raise ValueError('Start ID does not match batch')
+        uploader = uploader or Uploader()
+        if not CoverDB().is_batch_closed(self.item_id, self.batch_id):
+            return False
+        paths = [self.get_abspath(self.item_id, self.batch_id, size) for size in SIZES]
+        if any(not os.path.isfile(path) for path in paths):
+            return False
+        for path in paths:
+            with zipfile.ZipFile(path) as archive:
+                if archive.testzip() is not None or not count_files_in_zip(path):
+                    raise ValueError(f'Invalid or empty ZIP: {path}')
+        covers = CoverDB().get_batch_covers(self.item_id, self.batch_id)
+        if not covers:
+            return False
+        for size, path in zip(SIZES, paths):
+            with zipfile.ZipFile(path) as archive:
+                names = set(archive.namelist())
+            missing = [
+                row.id for row in covers
+                if f'{row.id:010d}{"-" + size.upper() if size else ""}.jpg' not in names
+            ]
+            if missing:
+                raise ValueError(f'{path} is missing {len(missing)} archived covers')
+        if not all(uploader.is_uploaded(os.path.basename(os.path.dirname(path)), os.path.basename(path)) for path in paths):
+            return False
+        CoverDB.update_completed_batch(self.item_id, self.batch_id)
+        for path in paths:
+            os.remove(path)
+        return True
