+class Cover:
+    """A cover record and its deterministic archive names."""
+
+    def __init__(self, attributes):
+        self.__dict__.update(dict(attributes) if hasattr(attributes, 'keys') else vars(attributes))
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        cover_id = int(cover_id)
+        if not 0 <= cover_id < 10**10:
+            raise ValueError('Cover ID must fit in ten digits')
+        padded = f'{cover_id:010d}'
+        return padded[:4], padded[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        size = _size(size)
+        if protocol not in ('http', 'https'):
+            raise ValueError('Invalid protocol')
+        if not re.fullmatch(r'[a-zA-Z0-9]+', ext):
+            raise ValueError('Invalid extension')
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f'{size}_' if size else ''
+        item = f'{prefix}covers_{item_id}'
+        filename = f'{prefix}covers_{item_id}_{batch_id}.zip'
+        member = f'{int(cover_id):010d}{"-" + size.upper() if size else ""}.{ext}'
+        return f'{protocol}://archive.org/download/{item}/{filename}/{member}'
+
+    def files(self):
+        for size in SIZES:
+            key = f'filename_{size}' if size else 'filename'
+            filename = getattr(self, key, None)
+            if not filename:
+                return
+            path = os.path.join(config.data_root, 'localdisk', filename)
+            if not os.path.isfile(path):
+                return
+            yield size, path
+
+    def delete_files(self):
+        for _, path in self.files():
+            os.remove(path)
