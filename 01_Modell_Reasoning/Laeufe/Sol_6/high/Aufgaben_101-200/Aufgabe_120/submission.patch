+def test_cover_ids_urls_and_paths(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    assert archive.Cover.id_to_item_and_batch_id(8_123_456) == ('0008', '12')
+    assert archive.Batch(8, 12)._norm_ids() == ('0008', '12')
+    assert archive.Batch.get_relpath(8, 12, 's') == 'items/s_covers_0008/s_covers_0008_12.zip'
+    assert archive.Cover.get_cover_url(8_123_456, 'm', protocol='http') == (
+        'http://archive.org/download/m_covers_0008/m_covers_0008_12.zip/0008123456-M.jpg'
+    )
+    with pytest.raises(ValueError, match='ten digits'):
+        archive.Cover.id_to_item_and_batch_id(10**10)
+
+
+def test_zip_manager_deduplicates_and_reads(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    source = tmp_path / 'cover.jpg'
+    source.write_bytes(b'image')
+    manager = archive.ZipManager()
+    try:
+        first = manager.add_file('0008123456-S.jpg', str(source), 1_700_000_000)
+        assert manager.add_file('0008123456-S.jpg', str(source), 1_700_000_000) == first
+    finally:
+        manager.close()
+    path = archive.Batch.get_abspath(8, 12, 's')
+    with zipfile.ZipFile(path) as opened:
+        assert opened.namelist() == ['0008123456-S.jpg']
+        assert opened.read('0008123456-S.jpg') == b'image'
+        assert opened.getinfo('0008123456-S.jpg').compress_type == zipfile.ZIP_STORED
+    assert archive.count_files_in_zip(path) == 1
+
