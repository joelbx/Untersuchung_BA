+def test_expand_record_preserves_comparison_fields_and_combines_isbns():
+    rec = {
+        'full_title': 'The Book & Its Readers: An Introduction.',
+        'isbn': ['one'],
+        'isbn_10': ['two'],
+        'isbn_13': ['three'],
+        'publish_country': 'xxu',
+        'lccn': ['12345'],
+        'publishers': ['Example Press'],
+        'publish_date': '2000',
+        'number_of_pages': 120,
+        'authors': [{'name': 'An Author'}],
+        'contribs': [{'name': 'A Contributor'}],
+    }
+
+    expanded = expand_record(rec)
+
+    assert expanded['full_title'] == rec['full_title']
+    assert expanded['normalized_title'] == 'the book and its readers an introduction'
+    assert expanded['short_title'] == expanded['normalized_title'][:25]
+    assert 'The Book and Its Readers: An Introduction.' in expanded['titles']
+    assert 'Book & Its Readers: An Introduction.' in expanded['titles']
+    assert expanded['isbn'] == ['one', 'two', 'three']
+    for field in (
+        'publish_country',
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        assert expanded[field] == rec[field]
+    assert rec['isbn'] == ['one']
+
+
+@pytest.mark.parametrize('publish_country', ['   ', '|||'])
+def test_expand_record_excludes_blank_publish_country(publish_country):
+    expanded = expand_record({'full_title': 'A title', 'publish_country': publish_country})
+    assert 'publish_country' not in expanded
+    assert expanded['isbn'] == []
+
+
+def test_expand_record_normalizes_extra_spaces_and_punctuation():
+    expanded = expand_record({'full_title': '  A   title:  subtitle. '})
+    assert expanded['normalized_title'] == 'a title subtitle'
+    assert 'a title subtitle' in expanded['titles']
