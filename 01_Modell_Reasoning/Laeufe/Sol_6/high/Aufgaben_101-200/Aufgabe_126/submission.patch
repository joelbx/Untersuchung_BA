@@ -0,0 +1,39 @@
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+describe('assistant Markdown conversion', () => {
+    it('moves nested lists into their preceding list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First</li><ul><li>Nested</li></ul><li>Second</li></ol>';
+
+        fixNestedLists(dom);
+
+        expect(dom.querySelector('ol > li > ul > li')?.textContent).toBe('Nested');
+        expect(dom.querySelectorAll('ol > ul')).toHaveLength(0);
+    });
+
+    it('retains ordered list markers and nested indentation through conversion', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First<ul><li>Nested</li></ul></li><li>Second</li></ol>';
+
+        const markdown = htmlToMarkdown(dom);
+        const rendered = document.implementation.createHTMLDocument();
+        rendered.body.innerHTML = markdownToHTML(markdown);
+
+        expect(markdown).toMatch(/1\. First/);
+        expect(markdown).toMatch(/\n\s+- Nested/);
+        expect(rendered.querySelector('ol > li > ul > li')?.textContent).toBe('Nested');
+        expect(rendered.querySelectorAll('ol > li')).toHaveLength(2);
+    });
+
+    it('preserves indentation and line breaks in code fences', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<pre><code>  const value = 1;\n    return value;</code></pre>';
+
+        const markdown = htmlToMarkdown(dom);
+        const rendered = document.implementation.createHTMLDocument();
+        rendered.body.innerHTML = markdownToHTML(markdown);
+
+        expect(markdown).toContain('```');
+        expect(rendered.querySelector('pre code')?.textContent).toBe('  const value = 1;\n    return value;\n');
+    });
+});
