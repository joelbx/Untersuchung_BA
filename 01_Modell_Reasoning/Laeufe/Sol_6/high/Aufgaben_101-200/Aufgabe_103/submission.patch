+func TestSplitFileName(t *testing.T) {
+	tests := []struct {
+		filename                            string
+		name, version, release, epoch, arch string
+		wantErr                             bool
+	}{
+		{filename: "package-0-1-src.rpm", name: "package", version: "0", release: "1", arch: "src"},
+		{filename: "package-0--src.rpm", name: "package", version: "0", arch: "src"},
+		{filename: "package-0-.src.rpm", name: "package", version: "0", arch: "src"},
+		{filename: "1:my-package-9-123a.ia64.rpm", name: "my-package", version: "9", release: "123a", epoch: "1", arch: "ia64"},
+		{filename: "package-0-1-src", wantErr: true},
+		{filename: "package--1-src.rpm", wantErr: true},
+		{filename: "package--0-1.src.rpm", wantErr: true},
+		{filename: "package-0-src.rpm", wantErr: true},
+		{filename: "-0-1-src.rpm", wantErr: true},
+		{filename: "x:package-0-1.src.rpm", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			name, version, release, epoch, arch, err := splitFileName(tt.filename)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("splitFileName(%q) error = %v, wantErr %v", tt.filename, err, tt.wantErr)
+			}
+			if !tt.wantErr && (name != tt.name || version != tt.version || release != tt.release || epoch != tt.epoch || arch != tt.arch) {
+				t.Errorf("splitFileName(%q) = (%q, %q, %q, %q, %q)", tt.filename, name, version, release, epoch, arch)
+			}
+		})
+	}
+}
