+func TestControllerSSHHeartbeatAddress(t *testing.T) {
+	for _, tt := range []struct {
+		name, nodeAddr, peerAddr, wantAddr string
+	}{
+		{"IPv6 wildcard", "[::]:3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"IPv4 wildcard", "0.0.0.0:3022", "[2001:db8::1]:54321", "[2001:db8::1]:3022"},
+		{"empty wildcard", ":3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"loopback", "127.0.0.1:3022", "192.0.2.10:54321", "192.0.2.10:3022"},
+		{"routable", "198.51.100.10:3022", "192.0.2.10:54321", "198.51.100.10:3022"},
+		{"no peer", "[::]:3022", "", "[::]:3022"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
+			defer controller.Close()
+			upstream, downstream := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peerAddr))
+			defer downstream.Close()
+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{
+				ServerID: "test-server",
+				Services: []types.SystemRole{types.RoleNode},
+			})
+			server := &types.ServerV2{Metadata: types.Metadata{Name: "test-server"}}
+			server.SetAddr(tt.nodeAddr)
+			require.NoError(t, controller.handleSSHServerHB(handle, server))
+			require.Equal(t, tt.wantAddr, auth.lastUpsertAddr)
+		})
+	}
+}
