+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect } from "react";
+
+import { ChevronFace, ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import AccessibleButton from "../elements/AccessibleButton";
+import UIStore from "../../../stores/UIStore";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "onClick" | "title" | "children"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ options, title, disabled, ...props }) => {
+    const [isOpen, button, open, close, setIsOpen] = useContextMenu<HTMLDivElement>();
+
+    useEffect(() => {
+        if (disabled) setIsOpen(false);
+    }, [disabled, setIsOpen]);
+
+    const closeMenu = () => {
+        setIsOpen(false);
+        button.current?.focus();
+    };
+
+    const rect = isOpen && button.current?.getBoundingClientRect();
+
+    return <>
+        <ContextMenuButton
+            {...props}
+            inputRef={button}
+            label={title}
+            isExpanded={isOpen}
+            disabled={disabled}
+            aria-disabled={disabled}
+            className="mx_KebabContextMenu"
+            onClick={isOpen ? close : open}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { isOpen && rect && <IconizedContextMenu
+            top={rect.bottom + window.scrollY}
+            right={UIStore.instance.windowWidth - rect.right - window.scrollX}
+            rightAligned
+            chevronFace={ChevronFace.None}
+            onFinished={closeMenu}
+            className="mx_KebabContextMenu_menu"
+        >
+            <IconizedContextMenuOptionList first red>
+                { options.map((option, index) => React.isValidElement(option)
+                    ? React.cloneElement(option as React.ReactElement<{ onClick?: (ev: unknown) => void }>, {
+                        key: option.key ?? index,
+                        onClick: (ev: unknown) => {
+                            closeMenu();
+                            option.props.onClick?.(ev);
+                        },
+                    })
+                    : option) }
+            </IconizedContextMenuOptionList>
+        </IconizedContextMenu> }
+    </>;
+};
+
+export default KebabContextMenu;
