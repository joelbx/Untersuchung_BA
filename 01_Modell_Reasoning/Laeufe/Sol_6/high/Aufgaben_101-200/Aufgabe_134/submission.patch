diff --git a/openlibrary/tests/test_book_providers.py b/openlibrary/tests/test_book_providers.py
new file mode 100644
index 0000000..1a6ca36
--- /dev/null
+++ b/openlibrary/tests/test_book_providers.py
@@ -0,0 +1,55 @@
+from typing import cast
+
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider_by_name,
+    get_book_providers,
+    get_solr_keys,
+)
+from openlibrary.plugins.upstream.models import Edition
+
+
+def test_project_runeberg_provider():
+    provider = get_book_provider_by_name('runeberg')
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.is_own_ocaid('stories_runeberg_1900')
+    assert provider.is_own_ocaid('Stories_Runeberg_1900'.upper())
+    assert not provider.is_own_ocaid('unrelated_archive')
+    assert 'id_project_runeberg' in get_solr_keys()
+
+    edition = cast(
+        Edition,
+        {
+            'key': '/books/OL1M',
+            'identifiers': {'project_runeberg': ['stories/1900']},
+        },
+    )
+    assert provider in list(get_book_providers(edition))
+    acquisitions = provider.get_acquisitions(edition)
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].url == 'https://runeberg.org/stories/1900/'
+    assert acquisitions[0].provider_name == 'runeberg'
+
+
+def test_project_runeberg_templates(render_template):
+    downloads = render_template(
+        'book_providers/runeberg_download_options.html', 'stories/1900'
+    )
+    for filename in ('faksim.html', 'color.html', 'index.html', 'text.txt', 'ocr.txt'):
+        assert f'https://runeberg.org/stories/1900/{filename}' in downloads
+
+    button = render_template(
+        'book_providers/runeberg_read_button.html',
+        'stories/1900',
+        lambda action: f'data-action="{action}"',
+    )
+    assert 'https://runeberg.org/stories/1900/' in button
+    assert 'data-action="Read"' in button
+    assert 'Nordic literary works' in button
+
+    button_without_analytics = render_template(
+        'book_providers/runeberg_read_button.html', 'stories/1900'
+    )
+    assert 'https://runeberg.org/stories/1900/' in button_without_analytics
