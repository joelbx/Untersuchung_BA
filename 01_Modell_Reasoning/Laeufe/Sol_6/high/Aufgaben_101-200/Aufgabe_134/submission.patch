+def test_work_search_project_runeberg_field(monkeypatch):
+    docs = [
+        {'key': '/works/OL1W', 'id_project_gutenberg': ['123']},
+        {'key': '/works/OL2W', 'id_project_runeberg': ['stories/1900']},
