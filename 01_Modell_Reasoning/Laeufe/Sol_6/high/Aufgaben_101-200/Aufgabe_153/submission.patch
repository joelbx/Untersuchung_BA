diff --git a/applications/drive/src/app/zustand/share/memberStores.test.ts b/applications/drive/src/app/zustand/share/memberStores.test.ts
new file mode 100644
index 0000000..6c39790
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/memberStores.test.ts
@@ -0,0 +1,73 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareInvitation;
+const externalInvitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareExternalInvitation;
+
+describe('share member stores', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('replaces members for one share without changing another share', () => {
+        const first = member('first@example.com');
+        const second = member('second@example.com');
+        const replacement = member('replacement@example.com');
+        const store = useMembersStore.getState();
+
+        expect(store.getMembers('missing')).toEqual([]);
+        store.setMembers('first', [first]);
+        store.setMembers('second', [second]);
+        store.setMembers('first', [replacement]);
+
+        expect(store.getMembers('first')).toEqual([replacement]);
+        expect(store.getMembers('second')).toEqual([second]);
+    });
+
+    it('isolates internal and external invitations through all store actions', () => {
+        const first = invitation('first@example.com');
+        const second = invitation('second@example.com');
+        const externalFirst = externalInvitation('external-first@example.com');
+        const externalSecond = externalInvitation('external-second@example.com');
+        const store = useInvitationsStore.getState();
+
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+        store.setInvitations('first', [first]);
+        store.setExternalInvitations('first', [externalFirst]);
+        store.setInvitations('second', [second]);
+        store.setExternalInvitations('second', [externalSecond]);
+        store.removeInvitations('first', []);
+        store.updateExternalInvitations('first', []);
+
+        expect(store.getInvitations('first')).toEqual([]);
+        expect(store.getExternalInvitations('first')).toEqual([]);
+        expect(store.getInvitations('second')).toEqual([second]);
+        expect(store.getExternalInvitations('second')).toEqual([externalSecond]);
+
+        store.addMultipleInvitations('first', [first], [externalFirst]);
+        store.updateInvitationsPermissions('first', []);
+        store.removeExternalInvitations('first', []);
+
+        expect(store.getInvitations('first')).toEqual([]);
+        expect(store.getExternalInvitations('first')).toEqual([]);
+        expect(store.getInvitations('second')).toEqual([second]);
+        expect(store.getExternalInvitations('second')).toEqual([externalSecond]);
+    });
+
+    it('collects email addresses from all three lists', () => {
+        expect(
+            getExistingEmails(
+                [member('member@example.com')],
+                [invitation('invited@example.com')],
+                [externalInvitation('external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'invited@example.com', 'external@example.com']);
+    });
+});
