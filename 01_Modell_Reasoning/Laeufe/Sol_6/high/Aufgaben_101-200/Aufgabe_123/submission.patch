diff --git a/packages/components/containers/notifications/Notifications.test.tsx b/packages/components/containers/notifications/Notifications.test.tsx
new file mode 100644
index 0000000..22bb8a3
--- /dev/null
+++ b/packages/components/containers/notifications/Notifications.test.tsx
@@ -0,0 +1,98 @@
+import { act, render, screen } from '@testing-library/react';
+import { useContext } from 'react';
+
+import NotificationsProvider from './Provider';
+import NotificationsChildren from './Children';
+import NotificationsContext from './notificationsContext';
+import { NotificationsManager } from './manager';
+
+let manager: NotificationsManager;
+
+const CaptureManager = () => {
+    manager = useContext(NotificationsContext);
+    return null;
+};
+
+const renderNotifications = () =>
+    render(
+        <NotificationsProvider>
+            <CaptureManager />
+            <NotificationsChildren />
+        </NotificationsProvider>
+    );
+
+describe('notifications', () => {
+    it('renders safe HTML in strings and secures links', () => {
+        renderNotifications();
+        act(() => {
+            manager.createNotification({
+                type: 'error',
+                expiration: -1,
+                text: '<strong>Help</strong> <a href="https://example.com" target="_self" rel="opener" onclick="alert(1)">here</a><script>alert(1)</script><a href="javascript:alert(1)">bad</a>',
+            });
+        });
+
+        expect(screen.getByText('Help').tagName).toBe('STRONG');
+        const link = screen.getByText('here');
+        expect(link).toHaveAttribute('href', 'https://example.com');
+        expect(link).toHaveAttribute('target', '_blank');
+        expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(link).not.toHaveAttribute('onclick');
+        expect(screen.getByText('bad')).not.toHaveAttribute('href');
+        expect(document.querySelector('.notification script')).toBeNull();
+    });
+
+    it('secures links in React element content', () => {
+        renderNotifications();
+        act(() => {
+            manager.createNotification({
+                type: 'info',
+                expiration: -1,
+                text: (
+                    <span>
+                        <a href="/help" target="_self" rel="nofollow">
+                            React link
+                        </a>
+                    </span>
+                ),
+            });
+        });
+
+        expect(screen.getByText('React link')).toHaveAttribute('target', '_blank');
+        expect(screen.getByText('React link')).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+
+    it('deduplicates non-success notifications by explicit key or string text', () => {
+        renderNotifications();
+        act(() => {
+            manager.createNotification({ type: 'error', text: 'First', key: 'shared', expiration: -1 });
+            manager.createNotification({ type: 'warning', text: 'Second', key: 'shared', expiration: -1 });
+            manager.createNotification({ type: 'error', text: 'Same text', key: 'one', expiration: -1 });
+            manager.createNotification({ type: 'info', text: 'Same text', key: 'two', expiration: -1 });
+            manager.createNotification({ type: 'info', text: 'Fallback', expiration: -1 });
+            manager.createNotification({ type: 'error', text: 'Fallback', expiration: -1 });
+        });
+
+        expect(screen.queryByText('First')).toBeNull();
+        expect(screen.getByText('Second')).toBeInTheDocument();
+        expect(screen.getAllByText('Same text')).toHaveLength(2);
+        expect(screen.getAllByText('Fallback')).toHaveLength(1);
+        expect(document.querySelectorAll('.notification')).toHaveLength(4);
+    });
+
+    it('uses identifiers for React element content and keeps repeated successes', () => {
+        renderNotifications();
+        act(() => {
+            manager.createNotification({ type: 'error', text: <span>Element</span>, expiration: -1 });
+            manager.createNotification({ type: 'error', text: <span>Element</span>, expiration: -1 });
+            manager.createNotification({ type: 'success', text: 'Done', key: 'shared', expiration: -1 });
+            manager.createNotification({ type: 'success', text: 'Done', key: 'shared', expiration: -1 });
+            manager.createNotification({ type: 'error', text: 'Error', key: 'shared', expiration: -1 });
+        });
+
+        expect(screen.getAllByText('Element')).toHaveLength(2);
+        expect(screen.getAllByText('Done')).toHaveLength(2);
+        expect(screen.getByText('Error')).toBeInTheDocument();
+        expect(document.querySelectorAll('.notification')).toHaveLength(5);
+    });
+});
