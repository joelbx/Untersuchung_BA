+type billingModeDynamoDB struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+	describeError  error
+}
+
+func (svc *billingModeDynamoDB) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	svc.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (svc *billingModeDynamoDB) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (svc *billingModeDynamoDB) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return svc.describeOutput, svc.describeError
+}
+
+func TestBillingModeDefaults(t *testing.T) {
+	for _, tt := range []struct {
+		name      string
+		mode      string
+		wantMode  string
+		wantRead  int64
+		wantWrite int64
+		wantError bool
+	}{
+		{name: "default", wantMode: billingModePayPerRequest, wantRead: DefaultReadCapacityUnits, wantWrite: DefaultWriteCapacityUnits},
+		{name: "on demand", mode: billingModePayPerRequest, wantMode: billingModePayPerRequest, wantRead: DefaultReadCapacityUnits, wantWrite: DefaultWriteCapacityUnits},
+		{name: "provisioned", mode: billingModeProvisioned, wantMode: billingModeProvisioned, wantRead: DefaultReadCapacityUnits, wantWrite: DefaultWriteCapacityUnits},
+		{name: "invalid", mode: "invalid", wantError: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: tt.mode}
+			err := cfg.CheckAndSetDefaults()
+			if tt.wantError {
+				require.True(t, trace.IsBadParameter(err))
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.wantMode, cfg.BillingMode)
+			require.Equal(t, tt.wantRead, cfg.ReadCapacityUnits)
+			require.Equal(t, tt.wantWrite, cfg.WriteCapacityUnits)
+		})
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tt := range []struct {
+		name           string
+		mode           string
+		wantAWSMode    string
+		wantThroughput bool
+	}{
+		{name: "on demand ignores units", mode: billingModePayPerRequest, wantAWSMode: dynamodb.BillingModePayPerRequest},
+		{name: "provisioned uses units", mode: billingModeProvisioned, wantAWSMode: dynamodb.BillingModeProvisioned, wantThroughput: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			svc := &billingModeDynamoDB{}
+			b := &Backend{Config: Config{BillingMode: tt.mode, ReadCapacityUnits: 23, WriteCapacityUnits: 41}, Entry: log.New().WithField("test", tt.name), svc: svc}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, tt.wantAWSMode, aws.StringValue(svc.createInput.BillingMode))
+			if tt.wantThroughput {
+				require.NotNil(t, svc.createInput.ProvisionedThroughput)
+				require.Equal(t, int64(23), aws.Int64Value(svc.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(41), aws.Int64Value(svc.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
+				require.Nil(t, svc.createInput.ProvisionedThroughput)
+			}
+		})
+	}
+}
+
+func TestGetTableStatusBillingMode(t *testing.T) {
+	for _, tt := range []struct {
+		name      string
+		output    *dynamodb.DescribeTableOutput
+		err       error
+		want      tableStatus
+		wantMode  string
+		wantError bool
+	}{
+		{name: "on demand", output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, want: tableStatusOK, wantMode: dynamodb.BillingModePayPerRequest},
+		{name: "legacy provisioned", output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}, want: tableStatusOK},
+		{name: "missing", err: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), want: tableStatusMissing},
+		{name: "migration", output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}, BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, want: tableStatusNeedsMigration},
+		{name: "error", err: errors.New("describe failed"), want: tableStatusError, wantError: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			b := &Backend{svc: &billingModeDynamoDB{describeOutput: tt.output, describeError: tt.err}}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			if tt.wantError {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+			require.Equal(t, tt.want, status)
+			require.Equal(t, tt.wantMode, mode)
+		})
+	}
+}
+
+func TestInitializeTableBillingMode(t *testing.T) {
+	for _, tt := range []struct {
+		name            string
+		configuredMode  string
+		existingMode    string
+		missing         bool
+		wantAutoScaling bool
+		wantCreated     bool
+		wantLog         string
+	}{
+		{name: "existing on demand", configuredMode: billingModeProvisioned, existingMode: dynamodb.BillingModePayPerRequest, wantLog: "auto_scaling is ignored because the table is on-demand"},
+		{name: "new on demand", configuredMode: billingModePayPerRequest, missing: true, wantCreated: true, wantLog: "auto_scaling is ignored because the table will be on-demand"},
+		{name: "existing provisioned", configuredMode: billingModePayPerRequest, existingMode: dynamodb.BillingModeProvisioned, wantAutoScaling: true},
+		{name: "new provisioned", configuredMode: billingModeProvisioned, missing: true, wantAutoScaling: true, wantCreated: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			svc := &billingModeDynamoDB{}
+			if tt.missing {
+				svc.describeError = awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil)
+			} else {
+				svc.describeOutput = &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+					BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(tt.existingMode)},
+				}}
+			}
+			var logs bytes.Buffer
+			logger := log.New()
+			logger.SetOutput(&logs)
+			b := &Backend{
+				Entry:  logger.WithField("test", tt.name),
+				Config: Config{TableName: "test", BillingMode: tt.configuredMode, EnableAutoScaling: true, ReadCapacityUnits: 10, WriteCapacityUnits: 10},
+				svc:    svc,
+			}
+			require.NoError(t, b.initializeTable(context.Background()))
+			require.Equal(t, tt.wantAutoScaling, b.EnableAutoScaling)
+			require.Equal(t, tt.wantCreated, svc.createInput != nil)
+			if tt.wantLog != "" {
+				require.Contains(t, logs.String(), tt.wantLog)
+			}
+		})
+	}
+}
