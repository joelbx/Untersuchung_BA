+// initializeTable creates a missing table and adjusts auto scaling to match
+// the table's actual billing mode.
+func (b *Backend) initializeTable(ctx context.Context) error {
+	ts, billingMode, err := b.getTableStatus(ctx, b.TableName)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	switch ts {
+	case tableStatusOK:
+		if billingMode == dynamodb.BillingModePayPerRequest && b.EnableAutoScaling {
+			b.Warn("auto_scaling is ignored because the table is on-demand")
+			b.EnableAutoScaling = false
+		}
+	case tableStatusMissing:
+		if b.BillingMode == billingModePayPerRequest && b.EnableAutoScaling {
+			b.Warn("auto_scaling is ignored because the table will be on-demand")
+			b.EnableAutoScaling = false
+		}
+		err = b.createTable(ctx, b.TableName, fullPathKey)
+	case tableStatusNeedsMigration:
+		return trace.BadParameter("unsupported schema")
+	}
+	return trace.Wrap(err)
+}
