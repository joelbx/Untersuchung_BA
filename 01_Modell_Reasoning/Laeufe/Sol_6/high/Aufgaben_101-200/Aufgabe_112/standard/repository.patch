diff --git a/models/utils_fortinet_test.go b/models/utils_fortinet_test.go
new file mode 100644
index 0000000..9ce7bce
--- /dev/null
+++ b/models/utils_fortinet_test.go
@@ -0,0 +1,64 @@
+//go:build !scanner
+
+package models
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertFortinetToModel(t *testing.T) {
+	published := time.Date(2023, 9, 1, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	advisory := cvedict.Fortinet{
+		AdvisoryID: "FG-IR-23-001", AdvisoryURL: "https://fortiguard.com/psirt/FG-IR-23-001",
+		Title: "FortiOS issue", Summary: "Affected FortiOS versions",
+		Cvss3: cvedict.FortinetCvss3{Cvss3: cvedict.Cvss3{
+			BaseScore: 9.8, VectorString: "CVSS:3.1/AV:N", BaseSeverity: "CRITICAL",
+		}},
+		Cwes: []cvedict.FortinetCwe{{CweID: "CWE-79"}},
+		References: []cvedict.FortinetReference{{Reference: cvedict.Reference{
+			Link: "https://example.com/reference", Source: "Fortinet", Tags: "Vendor Advisory",
+		}}},
+		PublishedDate: published, LastModifiedDate: modified,
+	}
+	want := []CveContent{{
+		Type: Fortinet, CveID: "CVE-2023-0001", Title: advisory.Title, Summary: advisory.Summary,
+		Cvss3Score: 9.8, Cvss3Vector: "CVSS:3.1/AV:N", Cvss3Severity: "CRITICAL",
+		SourceLink: advisory.AdvisoryURL, CweIDs: []string{"CWE-79"},
+		References: References{{Link: "https://example.com/reference", Source: "Fortinet", Tags: []string{"Vendor Advisory"}}},
+		Published:  published, LastModified: modified,
+	}}
+	if got := ConvertFortinetToModel("CVE-2023-0001", []cvedict.Fortinet{advisory}); !reflect.DeepEqual(got, want) {
+		t.Errorf("ConvertFortinetToModel() = %#v, want %#v", got, want)
+	}
+}
+
+func TestFortinetContentSelection(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Trivy:    {{Type: Trivy, Summary: "Trivy summary"}},
+		Fortinet: {{Type: Fortinet, Title: "Fortinet title", Summary: "Fortinet summary", Cvss3Score: 9.8}},
+		Nvd:      {{Type: Nvd, Summary: "NVD summary", Cvss3Score: 8.0}},
+		Jvn:      {{Type: Jvn, Cvss3Score: 7.0}},
+		GitHub:   {{Type: GitHub, Summary: "GitHub summary"}},
+	}}
+	if got := v.Titles("en", ""); !reflect.DeepEqual(got[:3], []CveContentStr{
+		{Trivy, "Trivy summary"}, {Fortinet, "Fortinet title"}, {Nvd, "NVD summary"},
+	}) {
+		t.Errorf("Titles order: %#v", got)
+	}
+	if got := v.Summaries("en", ""); !reflect.DeepEqual(got[:4], []CveContentStr{
+		{Trivy, "Trivy summary"}, {Fortinet, "Fortinet summary"}, {Nvd, "NVD summary"}, {GitHub, "GitHub summary"},
+	}) {
+		t.Errorf("Summaries order: %#v", got)
+	}
+	if got := v.Cvss3Scores(); len(got) != 3 || got[0].Type != Fortinet || got[1].Type != Nvd || got[2].Type != Jvn {
+		t.Errorf("Cvss3Scores order: %#v", got)
+	}
+	if NewCveContentType("fortinet") != Fortinet {
+		t.Error("Fortinet content type is not recognized")
+	}
+}
