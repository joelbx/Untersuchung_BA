+func TestDetectCveByCpeURIRetainsFortinetWithoutJVN(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode([]cvemodels.CveDetail{
+			{CveID: "CVE-FORTINET", Fortinets: []cvemodels.Fortinet{{AdvisoryID: "FG-IR-23-001"}}, Jvns: []cvemodels.Jvn{{}}},
+			{CveID: "CVE-JVN", Jvns: []cvemodels.Jvn{{}}},
+		})
+	}))
+	defer server.Close()
+
+	client := goCveDictClient{baseURL: server.URL}
+	cves, err := client.detectCveByCpeURI("cpe:/o:fortinet:fortios:4.3.0", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(cves) != 1 || cves[0].CveID != "CVE-FORTINET" || len(cves[0].Jvns) != 0 {
+		t.Fatalf("unexpected CVEs: %#v", cves)
+	}
+}
