+func TestFillCvesWithNvdJvnFortinet(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode(cvemodels.CveDetail{
+			CveID: "CVE-2023-0001",
+			Fortinets: []cvemodels.Fortinet{{
+				AdvisoryID: "FG-IR-23-001", AdvisoryURL: "https://fortiguard.com/psirt/FG-IR-23-001",
+				Title: "FortiOS issue", Summary: "Affected FortiOS versions",
+			}},
+		})
+	}))
+	defer server.Close()
+
+	result := models.ScanResult{ScannedCves: models.VulnInfos{
+		"CVE-2023-0001": {CveID: "CVE-2023-0001"},
+	}}
+	cnf := config.GoCveDictConf{VulnDict: config.VulnDict{Type: "http", URL: server.URL}}
+	if err := FillCvesWithNvdJvnFortinet(&result, cnf, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-2023-0001"].CveContents[models.Fortinet]
+	if len(contents) != 1 || contents[0].Title != "FortiOS issue" || contents[0].SourceLink != "https://fortiguard.com/psirt/FG-IR-23-001" {
+		t.Fatalf("unexpected Fortinet content: %#v", contents)
+	}
+}
