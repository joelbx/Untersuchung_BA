+func TestDetectCpeURIsCvesAddsFortinetAdvisories(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode([]cvemodels.CveDetail{{
+			CveID: "CVE-2023-0001",
+			Fortinets: []cvemodels.Fortinet{
+				{AdvisoryID: "FG-IR-23-001", DetectionMethod: cvemodels.FortinetExactVersionMatch},
+				{AdvisoryID: "FG-IR-23-002", DetectionMethod: cvemodels.FortinetVendorProductMatch},
+			},
+		}})
+	}))
+	defer server.Close()
+
+	result := models.ScanResult{ScannedCves: models.VulnInfos{}}
+	cnf := config.GoCveDictConf{VulnDict: config.VulnDict{Type: "http", URL: server.URL}}
+	if err := DetectCpeURIsCves(&result, []Cpe{{CpeURI: "cpe:/o:fortinet:fortios:4.3.0"}}, cnf, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	v := result.ScannedCves["CVE-2023-0001"]
+	if v.CveID == "" || len(v.DistroAdvisories) != 2 ||
+		v.DistroAdvisories[0].AdvisoryID != "FG-IR-23-001" ||
+		v.DistroAdvisories[1].AdvisoryID != "FG-IR-23-002" ||
+		len(v.Confidences) != 1 || v.Confidences[0] != models.FortinetExactVersionMatch {
+		t.Fatalf("unexpected Fortinet detection: %#v", v)
+	}
+}
