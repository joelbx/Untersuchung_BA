+func amazonReleaseFromSystemRelease(systemRelease string) string {
+	systemRelease = strings.TrimSpace(systemRelease)
+	for _, prefix := range []string{"Amazon Linux AMI release ", "Amazon Linux release ", "Amazon Linux "} {
+		if strings.HasPrefix(systemRelease, prefix) {
+			release := strings.TrimSpace(strings.TrimPrefix(systemRelease, prefix))
+			if release == "" {
+				return "unknown"
+			}
+			if prefix == "Amazon Linux AMI release " {
+				return strings.Fields(release)[0]
+			}
+			return release
+		}
+	}
+	return "unknown"
+}
