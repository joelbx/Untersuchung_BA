+func TestAmazonLinuxEOLDates(t *testing.T) {
+	tests := []struct {
+		release string
+		until   time.Time
+	}{
+		{"2023 (Amazon Linux)", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2025 (Amazon Linux)", time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2027 (Amazon Linux)", time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2029 (Amazon Linux)", time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL did not find release")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("StandardSupportUntil = %s, want %s", eol.StandardSupportUntil, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSuppportEnded(tt.until) {
+				t.Error("support ended on the last supported second")
+			}
+			after := tt.until.Add(time.Second)
+			if !eol.IsStandardSupportEnded(after) || !eol.IsExtendedSuppportEnded(after) {
+				t.Error("support did not end after the last supported second")
+			}
+		})
+	}
+	for _, release := range []string{"2024", "2031", "unknown", ""} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL(%q) unexpectedly found release", release)
+		}
+	}
+}
+
+func TestEOLWithExtendedSupport(t *testing.T) {
+	eol, found := GetEOL(RedHat, "8")
+	if !found {
+		t.Fatal("GetEOL did not find RHEL 8")
+	}
+	if eol.IsStandardSupportEnded(eol.StandardSupportUntil) || eol.IsExtendedSuppportEnded(eol.StandardSupportUntil) {
+		t.Error("support ended on the last standard support second")
+	}
+	if !eol.IsStandardSupportEnded(eol.StandardSupportUntil.Add(time.Second)) || eol.IsExtendedSuppportEnded(eol.StandardSupportUntil.Add(time.Second)) {
+		t.Error("extended support should remain after standard support ends")
+	}
+	if eol.IsExtendedSuppportEnded(eol.ExtendedSupportUntil) || !eol.IsExtendedSuppportEnded(eol.ExtendedSupportUntil.Add(time.Second)) {
+		t.Error("extended support boundary is incorrect")
+	}
+}
