+func ovalReleaseFor(r *models.ScanResult) (string, error) {
+	switch r.Family {
+	case constant.CentOS:
+		return strings.TrimPrefix(r.Release, "stream"), nil
+	case constant.Amazon:
+		version, err := (config.Distro{Family: constant.Amazon, Release: r.Release}).MajorVersion()
+		if err != nil {
+			return "", xerrors.Errorf("Failed to parse Amazon Linux release %q: %w", r.Release, err)
+		}
+		return strconv.Itoa(version), nil
+	default:
+		return r.Release, nil
+	}
+}
