+    def get_locally_reachable_ips(self, ip_path):
+        """Return local routes from the kernel's local table, grouped by IP family."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, option, version in (('ipv4', '-4', 4), ('ipv6', '-6', 6)):
+            if family == 'ipv6' and not socket.has_ipv6:
+                self.module.warn('Could not collect locally reachable IPv6 ranges: IPv6 unavailable')
+                continue
+
+            command = [ip_path, option, 'route', 'show', 'table', 'local']
+            try:
+                rc, output, _ = self.module.run_command(command, errors='surrogate_then_replace')
+            except OSError:
+                rc, output = 1, ''
+            if rc != 0:
+                self.module.warn('Could not collect locally reachable %s ranges: local routing table unavailable' % family.upper())
+                continue
+
+            routes = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                # IPv6 local routes often omit the scope field; an explicit
+                # non-host scope does not describe a locally reachable route.
+                if 'scope' in words:
+                    scope_index = words.index('scope')
+                    if words[scope_index + 1:scope_index + 2] != ['host']:
+                        continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if network.version != version:
+                    continue
+                routes.add(network)
+
+            reachable[family] = [str(route.network_address) if route.prefixlen == route.max_prefixlen else str(route)
+                                 for route in sorted(routes)]
+            if not reachable[family]:
+                self.module.warn('No locally reachable %s ranges found in the local routing table' % family.upper())
+        return reachable
+
