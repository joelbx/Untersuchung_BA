+_DURATION_NUMBER = r'(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+)'
+_DURATION_RE = re.compile(
+    r'(?:({})h)?\s*(?:({})m)?\s*(?:({})s)?'.format(
+        _DURATION_NUMBER, _DURATION_NUMBER, _DURATION_NUMBER))
+
+
+def parse_duration(duration: str) -> int:
+    """Return a duration in milliseconds.
+
+    Hours, minutes and seconds can be decimal values and must appear in that
+    order. Bare integers are interpreted as milliseconds for compatibility.
+
+    Raises:
+        ValueError: If the duration has no valid time components.
+    """
+    duration = duration.strip()
+    if re.fullmatch(r'[0-9]+', duration):
+        return int(duration)
+
+    match = _DURATION_RE.fullmatch(duration)
+    if match is None or not any(part is not None for part in match.groups()):
+        raise ValueError("Invalid duration: {!r}".format(duration))
+
+    hours, minutes, seconds = match.groups()
+    milliseconds = sum(
+        (Decimal(value) * multiplier
+         for value, multiplier in zip(
+             (hours, minutes, seconds), (3600000, 60000, 1000))
+         if value is not None),
+        Decimal(0))
+    return int(milliseconds)
+
+
