diff --git a/tests/unit/misc/test_utilcmds.py b/tests/unit/misc/test_utilcmds.py
index e8f651d..9edae99 100644
--- a/tests/unit/misc/test_utilcmds.py
+++ b/tests/unit/misc/test_utilcmds.py
@@ -27,6 +27,32 @@ from qutebrowser.api import cmdutils
 from qutebrowser.utils import objreg
 
 
+@pytest.mark.parametrize('duration, milliseconds', [
+    ('5000', 5000),
+    ('2m30s', 150000),
+])
+def test_later_duration(mocker, duration, milliseconds):
+    timer_class = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+    runner_class = mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration, 'scroll down', win_id=0)
+
+    timer_class.return_value.setInterval.assert_called_once_with(milliseconds)
+    timer_class.return_value.start.assert_called_once_with()
+    callback = timer_class.return_value.timeout.connect.call_args_list[0][0][0]
+    callback()
+    runner_class.return_value.run_safely.assert_called_once_with('scroll down')
+
+
+def test_later_invalid_duration(mocker):
+    timer_class = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+
+    with pytest.raises(cmdutils.CommandError, match='Invalid duration'):
+        utilcmds.later('bad', 'scroll down', win_id=0)
+
+    timer_class.assert_not_called()
+
