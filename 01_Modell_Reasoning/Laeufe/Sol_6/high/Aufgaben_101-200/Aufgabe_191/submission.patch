+import React from "react";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+import { getMockClientWithEventEmitter, unmockClientPeg } from "../../test-utils";
+
+describe("InteractiveAuth registration token", () => {
+    const matrixClient = getMockClientWithEventEmitter({
+        generateClientSecret: jest.fn().mockReturnValue("client-secret"),
+    });
+
+    afterAll(() => unmockClientPeg());
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits the advertised %s stage and finishes registration",
+        async (loginType) => {
+            const response = { user_id: "@new:example.org", access_token: "access-token" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+            const { container } = render(
+                <InteractiveAuth
+                    matrixClient={matrixClient}
+                    authData={{ session: "session-id", flows: [{ stages: [loginType] }] }}
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+            );
+
+            const field = screen.getByRole("textbox", { name: "Registration token" });
+            expect(field).toHaveAttribute("name", "registrationTokenField");
+            expect(field).toHaveFocus();
+            expect(
+                screen.getByText("Enter a registration token provided by the homeserver administrator."),
+            ).toBeTruthy();
+            expect(onStagePhaseChange).toHaveBeenCalledWith(loginType, 0);
+
+            const button = screen.getByRole("button", { name: "Continue" });
+            expect(button).toBeDisabled();
+            expect(button).toHaveClass("mx_AccessibleButton_kind_primary");
+
+            fireEvent.change(field, { target: { value: "registration-token" } });
+            expect(button).toBeEnabled();
+            if (loginType === AuthType.RegistrationToken) {
+                fireEvent.click(button);
+            } else {
+                fireEvent.submit(container.querySelector("form"));
+            }
+
+            await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+            expect(makeRequest).toHaveBeenCalledWith({
+                session: "session-id",
+                type: loginType,
+                token: "registration-token",
+            });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            });
+        },
+    );
+
+    it("shows a spinner while busy, prevents duplicate submissions, and shows an error for retry", async () => {
+        let rejectRequest: (reason: Error) => void;
+        const response = { user_id: "@new:example.org" };
+        const makeRequest = jest
+            .fn()
+            .mockImplementationOnce(
+                () =>
+                    new Promise((resolve, reject) => {
+                        rejectRequest = reject;
+                    }),
+            )
+            .mockResolvedValue(response);
+        const onAuthFinished = jest.fn();
+        const authData = {
+            session: "session-id",
+            flows: [{ stages: [AuthType.RegistrationToken] }],
+        };
+        const { container } = render(
+            <InteractiveAuth
+                matrixClient={matrixClient}
+                authData={authData}
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />,
+        );
+
+        fireEvent.change(screen.getByRole("textbox", { name: "Registration token" }), {
+            target: { value: "bad-token" },
+        });
+        fireEvent.submit(container.querySelector("form"));
+        expect(screen.getByRole("progressbar")).toBeTruthy();
+        expect(screen.queryByRole("button", { name: "Continue" })).toBeNull();
+        fireEvent.submit(container.querySelector("form"));
+        expect(makeRequest).toHaveBeenCalledTimes(1);
+
+        rejectRequest(
+            Object.assign(new Error("Invalid token"), {
+                httpStatus: 401,
+                data: { ...authData, error: "Invalid token", errcode: "M_FORBIDDEN" },
+            }),
+        );
+        await waitFor(() => expect(screen.getByRole("alert")).toHaveTextContent("Invalid token"));
+        expect(screen.getByRole("alert")).toHaveClass("error");
+        expect(screen.getByRole("button", { name: "Continue" })).toBeEnabled();
+        expect(onAuthFinished).not.toHaveBeenCalled();
+
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        await waitFor(() =>
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            }),
+        );
+        expect(makeRequest).toHaveBeenCalledTimes(2);
+    });
+});
