diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..a6a9b5e
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,31 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+const meta = require('../../meta');
+
+module.exports = {
+	name: 'Migrate restricted chats to chat allow lists',
+	timestamp: Date.UTC(2025, 4, 1),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const keys = uids.map(uid => `user:${uid}:settings`);
+			const settings = await db.getObjects(keys);
+			const restricted = uids.filter((uid, index) =>
+				parseInt(settings[index] && settings[index].restrictChat !== undefined ?
+					settings[index].restrictChat : meta.config.restrictChat, 10) === 1 &&
+				settings[index].chatAllowList === undefined &&
+				settings[index].disableIncomingMessages === undefined);
+			const following = await Promise.all(restricted.map(uid => db.getSortedSetMembers(`following:${uid}`)));
+			await db.setObjectBulk(restricted.map((uid, index) => [
+				`user:${uid}:settings`,
+				following[index].length ? { chatAllowList: JSON.stringify(following[index].map(String)) } :
+					{ chatAllowList: '[]', disableIncomingMessages: 1 },
+			]));
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
