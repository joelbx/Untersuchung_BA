diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..f971b52 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,84 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_implicit_with_common_options(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'destination_port': '22',
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'src',
+            'jump': 'ACCEPT',
+            'comment': 'SSH from admins',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.side_effect = [(1, '', ''), (0, '', '')]
+            with self.assertRaises(AnsibleExitJson) as result:
+                iptables.main()
+
+        self.assertTrue(result.exception.args[0]['changed'])
+        expected_rule = [
+            '-p', 'tcp',
+            '-m', 'set', '--match-set', 'admin_hosts', 'src',
+            '-j', 'ACCEPT',
+            '--destination-port', '22',
+            '-m', 'comment', '--comment', 'SSH from admins',
+        ]
+        self.assertEqual(result.exception.args[0]['rule'], ' '.join(expected_rule))
+        self.assertEqual(run_command.call_args_list[0][0][0],
+                         ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'] + expected_rule)
+        self.assertEqual(run_command.call_args_list[1][0][0],
+                         ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'] + expected_rule)
+
+    def test_match_set_explicit_match_and_inversion(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'match': ['tcp', 'set'],
+            'match_set': '!admin_hosts',
+            'match_set_flags': 'dst,src',
+            'destination_port': '22',
+            'jump': 'DROP',
+            '_ansible_check_mode': True,
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 1, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_count, 1)
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-p', 'tcp', '-m', 'tcp',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'dst,src',
+            '-j', 'DROP', '--destination-port', '22',
+        ])
+
+    def test_match_set_flags_choices(self):
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            set_module_args({
+                'chain': 'INPUT',
+                'match_set': 'admin_hosts',
+                'match_set_flags': flags,
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = 0, '', ''
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_args[0][0][-5:],
+                             ['-m', 'set', '--match-set', 'admin_hosts', flags])
+
+    def test_match_set_requires_name_and_flags(self):
+        for options in (
+                {'match_set': 'admin_hosts'},
+                {'match_set_flags': 'src'},
+                {'match_set': '', 'match_set_flags': 'src'},
+                {'match_set': 'admin_hosts', 'match_set_flags': 'invalid'}):
+            args = {'chain': 'INPUT'}
+            args.update(options)
+            set_module_args(args)
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_count, 0)
