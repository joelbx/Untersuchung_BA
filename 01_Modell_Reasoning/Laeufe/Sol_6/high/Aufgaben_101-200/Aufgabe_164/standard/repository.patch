+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	tests := []struct {
+		name     string
+		encoding Encoding
+		input    string
+	}{
+		{
+			name:     "YAML",
+			encoding: EncodingYAML,
+			input: `namespace:
+  key: team
+  name: Team
+  description: Team namespace
+flags:
+  - key: nested
+    name: Nested
+    enabled: true
+    metadata:
+      labels:
+        owner: team
+        levels: [1, {depth: 2}]
+      active: true
+    variants:
+      - key: choice
+        attachment:
+          nested:
+            items: [one, {two: 2}]
+`,
+		},
+		{
+			name:     "JSON",
+			encoding: EncodingJSON,
+			input:    `{"namespace":{"key":"team","name":"Team","description":"Team namespace"},"flags":[{"key":"nested","name":"Nested","enabled":true,"metadata":{"labels":{"owner":"team","levels":[1,{"depth":2}]},"active":true},"variants":[{"key":"choice","attachment":{"nested":{"items":["one",{"two":2}]}}}]}]}`,
+		},
+		{
+			name:     "JSON with export header",
+			encoding: EncodingJSON,
+			input:    "# exported by Flipt\n" + `{"namespace":{"key":"team","name":"Team","description":"Team namespace"},"flags":[{"key":"nested","name":"Nested","enabled":true,"metadata":{"labels":{"owner":"team","levels":[1,{"depth":2}]},"active":true},"variants":[{"key":"choice","attachment":{"nested":{"items":["one",{"two":2}]}}}]}]}`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			err := NewImporter(creator).Import(context.Background(), tc.encoding, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team", Description: "Team namespace"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			flag := creator.createflagReqs[0]
+			assert.Equal(t, "team", flag.NamespaceKey)
+			assert.Equal(t, map[string]any{
+				"labels": map[string]any{"owner": "team", "levels": []any{float64(1), map[string]any{"depth": float64(2)}}},
+				"active": true,
+			}, flag.Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.Equal(t, "team", creator.variantReqs[0].NamespaceKey)
+			assert.JSONEq(t, `{"nested":{"items":["one",{"two":2}]}}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		"# first\n# second\n{}",
+		" \n# comment\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+		require.Error(t, err)
+	}
+
+	err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingYAML, strings.NewReader("# YAML comment\nflags: []\n"), false)
+	require.NoError(t, err)
+}
