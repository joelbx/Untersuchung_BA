+func TestEngine_AuthMethodBuiltin(t *testing.T) {
+	ctx := context.Background()
+	engine, err := newEngine(ctx, zaptest.NewLogger(t), withPolicySource(policySource(`package flipt.authz.v1
+import rego.v1
+default allow := false
+allow if { flipt.is_auth_method(input, "jwt") }`)))
+	require.NoError(t, err)
+
+	allowed, err := engine.IsAllowed(ctx, map[string]interface{}{"authentication": map[string]interface{}{"method": 5}})
+	require.NoError(t, err)
+	require.True(t, allowed)
+
+	allowed, err = engine.IsAllowed(ctx, map[string]interface{}{"authentication": map[string]interface{}{"method": 1}})
+	require.NoError(t, err)
+	require.False(t, allowed)
+
+	_, err = engine.IsAllowed(ctx, map[string]interface{}{})
+	require.ErrorContains(t, err, "no authentication found")
+
+	invalid, err := newEngine(ctx, zaptest.NewLogger(t), withPolicySource(policySource(`package flipt.authz.v1
+import rego.v1
+default allow := false
+allow if { flipt.is_auth_method(input, "password") }`)))
+	require.NoError(t, err)
+	_, err = invalid.IsAllowed(ctx, map[string]interface{}{"authentication": map[string]interface{}{"method": 5}})
+	require.ErrorContains(t, err, "unsupported auth method: password")
+}
