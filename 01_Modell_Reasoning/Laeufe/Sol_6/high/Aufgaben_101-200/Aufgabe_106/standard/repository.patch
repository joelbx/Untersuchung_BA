+func TestFillWordPressIgnoreInactivePerServer(t *testing.T) {
+	previousConf := config.Conf
+	defer func() { config.Conf = previousConf }()
+
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Type: models.WPCore, Version: "5.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive, Version: "1.0"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive, Version: "1.0"},
+	}
+	coreBody := "{}"
+	activePluginBody := `{"package":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`
+	inactivePluginBody := `{"package":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`
+	activeThemeBody := `{"package":{"vulnerabilities":[{"id":3,"fixed_in":"2.0"}]}}`
+	inactiveThemeBody := `{"package":{"vulnerabilities":[{"id":4,"fixed_in":"2.0"}]}}`
+
+	for _, tt := range []struct {
+		name           string
+		ignoreInactive bool
+		want           int
+	}{
+		{name: "ignore inactive", ignoreInactive: true, want: 2},
+		{name: "include inactive", ignoreInactive: false, want: 4},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf.WpIgnoreInactive = !tt.ignoreInactive
+			config.Conf.Servers = map[string]config.ServerInfo{
+				"target": {WordPress: config.WordPressConf{IgnoreInactive: tt.ignoreInactive}},
+			}
+			r := &models.ScanResult{
+				ServerName:        "target",
+				WordPressPackages: &packages,
+				ScannedCves:       models.VulnInfos{},
+			}
+			cache := map[string]*string{
+				"50":              &coreBody,
+				"active-plugin":   &activePluginBody,
+				"inactive-plugin": &inactivePluginBody,
+				"active-theme":    &activeThemeBody,
+				"inactive-theme":  &inactiveThemeBody,
+			}
+			got, err := FillWordPress(r, "unused", cache)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got != tt.want || len(r.ScannedCves) != tt.want {
+				t.Errorf("FillWordPress returned %d vulnerabilities and stored %d, want %d", got, len(r.ScannedCves), tt.want)
+			}
+			for _, id := range []string{"WPVDBID-1", "WPVDBID-3"} {
+				if _, ok := r.ScannedCves[id]; !ok {
+					t.Errorf("active package vulnerability %s missing", id)
+				}
+			}
+			for _, id := range []string{"WPVDBID-2", "WPVDBID-4"} {
+				if _, ok := r.ScannedCves[id]; ok == tt.ignoreInactive {
+					t.Errorf("inactive package vulnerability %s presence = %t, ignoreInactive = %t", id, ok, tt.ignoreInactive)
+				}
+			}
+		})
+	}
+}
