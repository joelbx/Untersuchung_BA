@@ -0,0 +1,55 @@
+import { Message } from '@proton/shared/lib/interfaces/mail/Message';
+
+import { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { optimisticUpdates } from './elementsReducers';
+import { newState } from './elementsSlice';
+
+describe('optimisticUpdates bypass filter', () => {
+    const message = { ID: 'message', ConversationID: 'conversation' } as Message;
+
+    it.each([
+        { unreadFilter: 1, bypassStatus: MARK_AS_STATUS.READ, matchingStatus: MARK_AS_STATUS.UNREAD },
+        { unreadFilter: 0, bypassStatus: MARK_AS_STATUS.UNREAD, matchingStatus: MARK_AS_STATUS.READ },
+    ])(
+        'adds and removes conversation IDs with Unread: $unreadFilter',
+        ({ unreadFilter, bypassStatus, matchingStatus }) => {
+            const state = newState({ params: { filter: { Unread: unreadFilter } } });
+            state.bypassFilter = ['unrelated'];
+
+            const markAs = (markAsStatus: MARK_AS_STATUS) =>
+                optimisticUpdates(state, {
+                    type: 'elements/optimistic/markAs',
+                    payload: { elements: [message], bypass: true, conversationMode: true, markAsStatus },
+                });
+
+            markAs(bypassStatus);
+            markAs(bypassStatus);
+            expect(state.bypassFilter).toEqual(['unrelated', 'conversation']);
+
+            markAs(matchingStatus);
+            expect(state.bypassFilter).toEqual(['unrelated']);
+        }
+    );
+
+    it('uses message IDs in message mode and leaves bypass unchanged without a mark-as status', () => {
+        const state = newState({ params: { filter: { Unread: 1 } } });
+        state.bypassFilter = ['message'];
+
+        optimisticUpdates(state, {
+            type: 'elements/optimistic/markAs',
+            payload: { elements: [message], bypass: true, conversationMode: false },
+        });
+        expect(state.bypassFilter).toEqual(['message']);
+
+        optimisticUpdates(state, {
+            type: 'elements/optimistic/markAs',
+            payload: {
+                elements: [message],
+                bypass: true,
+                conversationMode: false,
+                markAsStatus: MARK_AS_STATUS.UNREAD,
+            },
+        });
+        expect(state.bypassFilter).toEqual([]);
+    });
+});
