+	"context"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/content/oci"
+)
+
+func TestSourceLocalRefreshAndSubscribe(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "features")
+	writeManifest := func(payload string) {
+		t.Helper()
+		var compressed bytes.Buffer
+		writer := gzip.NewWriter(&compressed)
+		_, err := writer.Write([]byte(payload))
+		require.NoError(t, err)
+		require.NoError(t, writer.Close())
+		layout, err := oci.New(path)
+		require.NoError(t, err)
+		layout.AutoSaveIndex = true
+		layer := v1.Descriptor{
+			MediaType: fliptoci.MediaTypeFliptFeatures + "+yaml+gzip",
+			Digest:    digest.FromBytes(compressed.Bytes()),
+			Size:      int64(compressed.Len()),
+			Annotations: map[string]string{
+				fliptoci.AnnotationFliptNamespace: "production",
+			},
+		}
+		require.NoError(t, layout.Push(ctx, layer, bytes.NewReader(compressed.Bytes())))
+		manifest, err := oras.PackManifest(ctx, layout, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{Layers: []v1.Descriptor{layer}})
+		require.NoError(t, err)
+		require.NoError(t, layout.Tag(ctx, manifest, "latest"))
+	}
+
+	writeManifest("flags:\n  - key: first\n    name: First\n    type: BOOLEAN_FLAG_TYPE\n    enabled: true\n")
+	store, err := fliptoci.NewStore(&config.OCI{BundleDirectory: dir, Repository: "flipt://local/features:latest"})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, WithPollInterval(20*time.Millisecond))
+	require.NoError(t, err)
+	require.Equal(t, "oci", source.String())
+
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "production", "first")
+	require.NoError(t, err)
+	again, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, again)
+
+	subCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	ch := make(chan *storagefs.StoreSnapshot)
+	go source.Subscribe(subCtx, ch)
+	select {
+	case <-ch:
+		t.Fatal("unchanged OCI manifest emitted a snapshot")
+	case <-time.After(80 * time.Millisecond):
+	}
+
+	writeManifest("flags:\n  - key: second\n    name: Second\n    type: BOOLEAN_FLAG_TYPE\n    enabled: true\n")
+	select {
+	case snap := <-ch:
+		require.NotNil(t, snap)
+		_, err := snap.GetFlag(ctx, "production", "second")
+		require.NoError(t, err)
+		current, err := source.Get(ctx)
+		require.NoError(t, err)
+		require.Same(t, snap, current)
+	case <-time.After(2 * time.Second):
+		t.Fatal(fmt.Errorf("timed out waiting for OCI update"))
+	}
+	cancel()
+	_, open := <-ch
+	require.False(t, open)
+}
