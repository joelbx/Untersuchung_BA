+    @pytest.mark.parametrize('enable_source', ['commandline', 'config'])
+    @pytest.mark.parametrize('disable_source', ['commandline', 'config'])
+    def test_enable_and_disable_features(self, config_stub, monkeypatch, parser,
+                                         enable_source, disable_source):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+
+        enable = 'enable-features=FirstFeature,SecondFeature'
+        disable = 'disable-features=ThirdFeature,FourthFeature'
+        commandline_flags = []
+        config_flags = []
+        for flag, source in [(enable, enable_source),
+                             (disable, disable_source)]:
+            if source == 'commandline':
+                commandline_flags.extend(['--qt-flag', flag])
+            else:
+                config_flags.append(flag)
+
+        config_stub.val.qt.args = config_flags
+        args = qtargs.qt_args(parser.parse_args(commandline_flags))
+
+        enable_flags = [arg for arg in args
+                        if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        disable_flags = [arg for arg in args
+                         if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)]
+        assert enable_flags == [qtargs.ENABLE_FEATURES_PREFIX +
+                                'FirstFeature,SecondFeature,OverlayScrollbar']
+        assert disable_flags == [qtargs.DISABLE_FEATURES_PREFIX +
+                                 'ThirdFeature,FourthFeature']
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_without_enabled_features(
