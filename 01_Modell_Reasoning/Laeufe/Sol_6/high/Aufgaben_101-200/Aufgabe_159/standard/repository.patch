@@ -0,0 +1,34 @@
+package sbom
+
+import "testing"
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		pkgType   string
+		pkgName   string
+		namespace string
+		name      string
+		subpath   string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package_Name", "", "my-package-name", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"cargo", "serde", "", "serde", ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.pkgType+"/"+tt.pkgName, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.pkgType, tt.pkgName)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)",
+					tt.pkgType, tt.pkgName, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
