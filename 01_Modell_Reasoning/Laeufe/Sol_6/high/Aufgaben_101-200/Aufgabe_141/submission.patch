new file mode 100644
index 0000000..78f3213
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,75 @@
+package wordpress
+
+import (
+	"io/ioutil"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	packages := models.WordPressPackages{
+		{Name: models.WPCore, Type: models.WPCore, Version: "5.4"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+	}
+	previousTransport := http.DefaultTransport
+	previousConfig := config.Conf
+	defer func() {
+		http.DefaultTransport = previousTransport
+		config.Conf = previousConfig
+	}()
+
+	for _, tc := range []struct {
+		name     string
+		ignore   bool
+		paths    []string
+		pkgCount int
+	}{
+		{"all packages", false, []string{
+			"/api/v3/wordpresses/54", "/api/v3/themes/active-theme", "/api/v3/themes/inactive-theme",
+			"/api/v3/plugins/active-plugin", "/api/v3/plugins/inactive-plugin", "/api/v3/plugins/must-use-plugin",
+		}, 6},
+		{"ignore inactive", true, []string{
+			"/api/v3/wordpresses/54", "/api/v3/themes/active-theme",
+			"/api/v3/plugins/active-plugin", "/api/v3/plugins/must-use-plugin",
+		}, 4},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var paths []string
+			http.DefaultTransport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				paths = append(paths, req.URL.Path)
+				return &http.Response{StatusCode: http.StatusOK, Body: ioutil.NopCloser(strings.NewReader("{}"))}, nil
+			})
+			config.Conf.WpIgnoreInactive = tc.ignore
+			r := models.ScanResult{WordPressPackages: &packages, ScannedCves: models.VulnInfos{}}
+			if _, err := FillWordPress(&r, "test-token"); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(paths, tc.paths) {
+				t.Errorf("requested paths = %v, want %v", paths, tc.paths)
+			}
+			if len(*r.WordPressPackages) != tc.pkgCount {
+				t.Errorf("package count = %d, want %d", len(*r.WordPressPackages), tc.pkgCount)
+			}
+		})
+	}
+}
+
+func TestRemoveInactivesReturnsNilWhenEmpty(t *testing.T) {
+	got := removeInactives(models.WordPressPackages{{Name: "unused", Status: models.Inactive}})
+	if got != nil {
+		t.Errorf("got %v, want nil", got)
+	}
+}
