+
+func TestRuleSegmentKeys(t *testing.T) {
+	tests := []struct {
+		name     string
+		rule     *flipt.Rule
+		key      string
+		operator string
+	}{
+		{"legacy", &flipt.Rule{SegmentKey: "legacy"}, "legacy", ""},
+		{"single", &flipt.Rule{SegmentKey: "legacy", SegmentKeys: []string{"one"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR}, "one", ""},
+		{"multiple", &flipt.Rule{SegmentKeys: []string{"one", "two"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR}, "one,two", "AND_SEGMENT_OPERATOR"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rule := NewRule(tt.rule)
+			assert.Equal(t, tt.key, rule.SegmentKey)
+			assert.Equal(t, tt.operator, rule.SegmentOperator)
+
+			encoded, err := json.Marshal(rule)
+			assert.NoError(t, err)
+			if tt.operator == "" {
+				assert.NotContains(t, string(encoded), `"segment_operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"segment_operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
+
+func TestRolloutSegmentKeys(t *testing.T) {
+	tests := []struct {
+		name     string
+		segment  *flipt.RolloutSegment
+		key      string
+		operator string
+	}{
+		{"legacy", &flipt.RolloutSegment{SegmentKey: "legacy", Value: true}, "legacy", ""},
+		{"single", &flipt.RolloutSegment{SegmentKey: "legacy", SegmentKeys: []string{"one"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true}, "one", ""},
+		{"multiple", &flipt.RolloutSegment{SegmentKeys: []string{"one", "two"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true}, "one,two", "AND_SEGMENT_OPERATOR"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: tt.segment}})
+			if assert.NotNil(t, rollout.Segment) {
+				assert.Equal(t, tt.key, rollout.Segment.Key)
+				assert.True(t, rollout.Segment.Value)
+				assert.Equal(t, tt.operator, rollout.Segment.Operator)
+			}
+
+			encoded, err := json.Marshal(rollout)
+			assert.NoError(t, err)
+			if tt.operator == "" {
+				assert.NotContains(t, string(encoded), `"operator"`)
+			} else {
+				assert.Contains(t, string(encoded), `"operator":"AND_SEGMENT_OPERATOR"`)
+			}
+		})
+	}
+}
