@@ -0,0 +1,41 @@
+package dynamoevents
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFieldsMapRoundTrip(t *testing.T) {
+	const original = `{"empty":"","none":null,"object":{},"array":[],"nested":{"count":9223372036854775807,"fraction":1.234567890123456789,"bool":false,"list":["",null,{}]}}`
+	item, err := marshalEvent(event{SessionID: "session", EventIndex: 1, Fields: original})
+	require.NoError(t, err)
+	require.NotContains(t, item, "Fields")
+	require.NotNil(t, item[keyFieldsMap].M)
+	require.NotNil(t, item[keyFieldsMap].M["object"].M)
+	require.NotNil(t, item[keyFieldsMap].M["array"].L)
+	require.Equal(t, "", aws.StringValue(item[keyFieldsMap].M["empty"].S))
+	require.Equal(t, "9223372036854775807", aws.StringValue(item[keyFieldsMap].M["nested"].M["count"].N))
+	require.NoError(t, validateFieldsConversion(original, item[keyFieldsMap]))
+
+	var read event
+	require.NoError(t, dynamodbattribute.UnmarshalMap(item, &read))
+	require.NoError(t, populateEventFields(item, &read))
+	var before, after interface{}
+	require.NoError(t, json.Unmarshal([]byte(original), &before))
+	require.NoError(t, json.Unmarshal([]byte(read.Fields), &after))
+	require.Equal(t, before, after)
+}
+
+func TestLegacyFieldsRead(t *testing.T) {
+	item := map[string]*dynamodb.AttributeValue{"Fields": {S: aws.String(`{"event":"legacy"}`)}}
+	e := event{Fields: aws.StringValue(item["Fields"].S)}
+	require.NoError(t, populateEventFields(item, &e))
+	require.Equal(t, `{"event":"legacy"}`, e.Fields)
+	require.Error(t, populateEventFields(map[string]*dynamodb.AttributeValue{}, &event{}))
+	require.Error(t, validateFieldsConversion(`{"value":1}`, &dynamodb.AttributeValue{M: map[string]*dynamodb.AttributeValue{"value": {N: aws.String("2")}}}))
+}
