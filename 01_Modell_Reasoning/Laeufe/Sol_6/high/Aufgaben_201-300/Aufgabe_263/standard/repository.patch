diff --git a/lib/events/dynamoevents/fieldsmap.go b/lib/events/dynamoevents/fieldsmap.go
new file mode 100644
index 0000000..cd79128
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap.go
@@ -0,0 +1,162 @@
+package dynamoevents
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"reflect"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/trace"
+)
+
+// marshalEvent stores metadata as a DynamoDB map. The JSON decoder retains
+// number spelling so large integers do not lose precision during conversion.
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	fields, err := fieldsJSONToAttribute(e.Fields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	e.Fields = ""
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item[keyFieldsMap] = fields
+	return item, nil
+}
+
+func fieldsJSONToAttribute(raw string) (*dynamodb.AttributeValue, error) {
+	decoder := json.NewDecoder(bytes.NewBufferString(raw))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	var extra interface{}
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return nil, trace.BadParameter("invalid trailing data in event fields")
+	}
+	return jsonValueToAttribute(fields), nil
+}
+
+func jsonValueToAttribute(value interface{}) *dynamodb.AttributeValue {
+	switch v := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(v)}
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(v)}
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(v))}
+	case []interface{}:
+		list := make([]*dynamodb.AttributeValue, len(v))
+		for i, item := range v {
+			list[i] = jsonValueToAttribute(item)
+		}
+		return &dynamodb.AttributeValue{L: list}
+	case map[string]interface{}:
+		items := make(map[string]*dynamodb.AttributeValue, len(v))
+		for key, item := range v {
+			items[key] = jsonValueToAttribute(item)
+		}
+		return &dynamodb.AttributeValue{M: items}
+	default:
+		panic("unexpected JSON value")
+	}
+}
+
+func fieldsAttributeToJSON(value *dynamodb.AttributeValue) (string, error) {
+	if value == nil || value.M == nil {
+		return "", trace.BadParameter("event FieldsMap is not a map")
+	}
+	decoded, err := attributeToJSONValue(value)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	data, err := json.Marshal(decoded)
+	return string(data), trace.Wrap(err)
+}
+
+func attributeToJSONValue(value *dynamodb.AttributeValue) (interface{}, error) {
+	switch {
+	case value == nil, value.NULL != nil && aws.BoolValue(value.NULL):
+		return nil, nil
+	case value.M != nil:
+		items := make(map[string]interface{}, len(value.M))
+		for key, child := range value.M {
+			converted, err := attributeToJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			items[key] = converted
+		}
+		return items, nil
+	case value.L != nil:
+		items := make([]interface{}, len(value.L))
+		for i, child := range value.L {
+			converted, err := attributeToJSONValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			items[i] = converted
+		}
+		return items, nil
+	case value.S != nil:
+		return aws.StringValue(value.S), nil
+	case value.N != nil:
+		return json.Number(aws.StringValue(value.N)), nil
+	case value.BOOL != nil:
+		return aws.BoolValue(value.BOOL), nil
+	default:
+		return nil, trace.BadParameter("unsupported event FieldsMap value")
+	}
+}
+
+func populateEventFields(item map[string]*dynamodb.AttributeValue, e *event) error {
+	if fields, ok := item[keyFieldsMap]; ok {
+		value, err := fieldsAttributeToJSON(fields)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		e.Fields = value
+		return nil
+	}
+	if e.Fields == "" {
+		return trace.BadParameter("event has neither FieldsMap nor Fields")
+	}
+	return nil
+}
+
+// validateFieldsConversion verifies a migration before changing the item.
+func validateFieldsConversion(original string, converted *dynamodb.AttributeValue) error {
+	roundTrip, err := fieldsAttributeToJSON(converted)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	decode := func(raw string) (interface{}, error) {
+		decoder := json.NewDecoder(bytes.NewBufferString(raw))
+		decoder.UseNumber()
+		var value interface{}
+		err := decoder.Decode(&value)
+		return value, err
+	}
+	before, err := decode(original)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	after, err := decode(roundTrip)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		return trace.BadParameter("event fields changed during conversion")
+	}
+	return nil
+}
diff --git a/lib/events/dynamoevents/fieldsmap_migration.go b/lib/events/dynamoevents/fieldsmap_migration.go
new file mode 100644
index 0000000..aefd8f3
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap_migration.go
@@ -0,0 +1,148 @@
+package dynamoevents
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/gravitational/trace"
+)
+
+// migrateFieldsMapWithRetry resumes from unconverted records after an error.
+// The scan remains safe if a node stops midway: successful conditional updates
+// remove Fields, so the next scan skips them.
+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		// The older date migration uses unconditional batch puts. Holding its
+		// lock prevents another node from restoring a scanned legacy item.
+		err := backend.RunWhileLocked(ctx, l.backend, rfd24MigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+			return backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock+"/"+l.Tablename, rfd24MigrationLockTTL, l.migrateFieldsMap)
+		})
+		if err == nil || ctx.Err() != nil {
+			return
+		}
+		l.WithError(err).Error("FieldsMap migration failed; retrying")
+		select {
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// migrateFieldsMap scans in bounded pages and performs conditional updates in
+// parallel. BatchWriteItem cannot be used here because its unconditional puts
+// could overwrite an event changed by a concurrent writer.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	l.Info("Starting DynamoDB FieldsMap migration")
+	var startKey map[string]*dynamodb.AttributeValue
+	var processed int
+	for {
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:            aws.String(l.Tablename),
+			ExclusiveStartKey:    startKey,
+			ConsistentRead:       aws.Bool(true),
+			Limit:                aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+			ProjectionExpression: aws.String("#sid, #index, #fields"),
+			FilterExpression:     aws.String("attribute_exists(#fields) AND attribute_not_exists(#map)"),
+			ExpressionAttributeNames: map[string]*string{
+				"#sid":    aws.String(keySessionID),
+				"#index":  aws.String(keyEventIndex),
+				"#fields": aws.String("Fields"),
+				"#map":    aws.String(keyFieldsMap),
+			},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		var workers sync.WaitGroup
+		semaphore := make(chan struct{}, maxMigrationWorkers)
+		errors := make(chan error, len(out.Items))
+		for _, item := range out.Items {
+			select {
+			case semaphore <- struct{}{}:
+			case <-ctx.Done():
+				workers.Wait()
+				return trace.Wrap(ctx.Err())
+			}
+			workers.Add(1)
+			go func(item map[string]*dynamodb.AttributeValue) {
+				defer workers.Done()
+				defer func() { <-semaphore }()
+				if err := l.migrateFieldsMapItem(ctx, item); err != nil {
+					errors <- err
+				}
+			}(item)
+		}
+		workers.Wait()
+		close(errors)
+		var firstError error
+		for err := range errors {
+			l.WithError(err).Error("Failed to convert DynamoDB event fields")
+			if firstError == nil {
+				firstError = err
+			}
+		}
+		if firstError != nil {
+			return trace.Wrap(firstError)
+		}
+		processed += len(out.Items)
+		if len(out.Items) > 0 {
+			l.Infof("Processed %d legacy DynamoDB event records for FieldsMap migration", processed)
+		}
+		startKey = out.LastEvaluatedKey
+		if len(startKey) == 0 {
+			break
+		}
+	}
+	l.Infof("FieldsMap migration complete: %d legacy records processed", processed)
+	return nil
+}
+
+func (l *Log) migrateFieldsMapItem(ctx context.Context, item map[string]*dynamodb.AttributeValue) error {
+	fields := item["Fields"]
+	sid := item[keySessionID]
+	index := item[keyEventIndex]
+	if fields == nil || fields.S == nil || sid == nil || index == nil {
+		return trace.BadParameter("legacy event is missing fields or its primary key")
+	}
+	converted, err := fieldsJSONToAttribute(aws.StringValue(fields.S))
+	if err == nil {
+		err = validateFieldsConversion(aws.StringValue(fields.S), converted)
+	}
+	if err != nil {
+		return trace.WrapWithMessage(err, "invalid legacy event at session %q index %q", aws.StringValue(sid.S), aws.StringValue(index.N))
+	}
+	_, err = l.svc.UpdateItemWithContext(ctx, &dynamodb.UpdateItemInput{
+		TableName:                 aws.String(l.Tablename),
+		Key:                       map[string]*dynamodb.AttributeValue{keySessionID: sid, keyEventIndex: index},
+		UpdateExpression:          aws.String("SET #map = :converted REMOVE #fields"),
+		ConditionExpression:       aws.String("#fields = :original AND attribute_not_exists(#map)"),
+		ExpressionAttributeNames:  map[string]*string{"#map": aws.String(keyFieldsMap), "#fields": aws.String("Fields")},
+		ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{":converted": converted, ":original": fields},
+	})
+	if err != nil && trace.IsAlreadyExists(convertError(err)) {
+		// A concurrent writer may have changed the legacy JSON. If it is still
+		// present, retry the scan so the changed value is converted too.
+		current, getErr := l.svc.GetItemWithContext(ctx, &dynamodb.GetItemInput{
+			TableName:      aws.String(l.Tablename),
+			Key:            map[string]*dynamodb.AttributeValue{keySessionID: sid, keyEventIndex: index},
+			ConsistentRead: aws.Bool(true),
+		})
+		if getErr != nil {
+			return trace.Wrap(convertError(getErr))
+		}
+		if current.Item["Fields"] != nil && current.Item[keyFieldsMap] == nil {
+			return trace.CompareFailed("legacy event changed during conversion at session %q index %q", aws.StringValue(sid.S), aws.StringValue(index.N))
+		}
+		return nil
+	}
+	if err != nil {
+		return trace.WrapWithMessage(convertError(err), "failed to convert event at session %q index %q", aws.StringValue(sid.S), aws.StringValue(index.N))
+	}
+	return nil
+}
