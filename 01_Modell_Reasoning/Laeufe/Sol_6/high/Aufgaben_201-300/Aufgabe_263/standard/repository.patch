+func (s *DynamoeventsSuite) TestFieldsMapMigration(c *check.C) {
+	legacy := event{
+		SessionID: uuid.New(), EventIndex: 7, EventType: "test.event",
+		CreatedAt: time.Now().Unix(), CreatedAtDate: time.Now().UTC().Format(iso8601DateFormat),
+		EventNamespace: apidefaults.Namespace,
+		Fields:         `{"event":"test.event","empty":"","nested":{"number":9223372036854775807}}`,
+	}
+	item, err := dynamodbattribute.MarshalMap(legacy)
+	c.Assert(err, check.IsNil)
+	_, err = s.log.svc.PutItem(&dynamodb.PutItemInput{TableName: aws.String(s.log.Tablename), Item: item})
+	c.Assert(err, check.IsNil)
+
+	err = s.log.migrateFieldsMap(context.Background())
+	c.Assert(err, check.IsNil)
+	// A second pass must be safe after a restart.
+	err = s.log.migrateFieldsMap(context.Background())
+	c.Assert(err, check.IsNil)
+
+	key := map[string]*dynamodb.AttributeValue{
+		keySessionID:  {S: aws.String(legacy.SessionID)},
+		keyEventIndex: {N: aws.String("7")},
+	}
+	out, err := s.log.svc.GetItem(&dynamodb.GetItemInput{TableName: aws.String(s.log.Tablename), Key: key, ConsistentRead: aws.Bool(true)})
+	c.Assert(err, check.IsNil)
+	c.Assert(out.Item["Fields"], check.IsNil)
+	c.Assert(out.Item[keyFieldsMap].M["nested"].M["number"].N, check.DeepEquals, aws.String("9223372036854775807"))
+	c.Assert(validateFieldsConversion(legacy.Fields, out.Item[keyFieldsMap]), check.IsNil)
+}
