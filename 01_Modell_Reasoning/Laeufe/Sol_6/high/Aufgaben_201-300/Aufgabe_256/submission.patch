+    def test_play_name_derived_from_hosts(self):
+        data = dict(hosts=['foo', 'bar'])
+        p = Play.load(data)
+        self.assertNotIn('name', data)
+        self.assertEqual(p.name, '')
+        self.assertEqual(p.get_name(), 'foo,bar')
+        p.hosts = ('baz', 'qux')
+        self.assertEqual(p.get_name(), 'baz,qux')
+        p.name = 'explicit name'
+        self.assertEqual(p.get_name(), 'explicit name')
+
+    def test_play_name_from_scalar_hosts(self):
+        p = Play.load(dict(hosts='foo'))
+        self.assertEqual(p.get_name(), 'foo')
+        p.hosts = None
+        self.assertEqual(p.get_name(), '')
+
+    def test_invalid_hosts(self):
+        cases = (
+            (None, "Hosts list cannot be empty. Please check your playbook"),
+            ([], "Hosts list cannot be empty. Please check your playbook"),
+            ('', "Hosts list cannot be empty. Please check your playbook"),
+            (['foo', None], "Hosts list cannot contain values of 'None'. Please check your playbook"),
+            (['foo', {'test': None}], "Hosts list contains an invalid host value: '{'test': None}'"),
+            (['foo', 3], "Hosts list contains an invalid host value: '3'"),
+            ({'foo': 'bar'}, "Hosts list must be a sequence or string. Please check your playbook."),
+            (3, "Hosts list must be a sequence or string. Please check your playbook."),
+        )
+        for hosts, message in cases:
+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load(dict(hosts=hosts))
+            self.assertIn(message, str(error.exception))
+
+    def test_invalid_hosts_with_explicit_name(self):
+        with self.assertRaises(AnsibleParserError) as error:
+            Play.load(dict(name='explicit name', hosts=['foo', None]))
+        self.assertIn("Hosts list cannot contain values of 'None'. Please check your playbook", str(error.exception))
+
+    def test_binary_hosts_in_sequence(self):
+        p = Play.load(dict(hosts=[b'foo', 'bar']))
