+    @pytest.mark.parametrize('backend, bar, expected', [
+        (usertypes.Backend.QtWebEngine, 'never',
+         ['--enable-features=CliOne,CliTwo,ArgOne,CfgOne,CfgTwo']),
+        (usertypes.Backend.QtWebEngine, 'overlay',
+         ['--enable-features=CliOne,CliTwo,ArgOne,CfgOne,CfgTwo,'
+          'OverlayScrollbar']),
+        (usertypes.Backend.QtWebKit, 'overlay',
+         ['--enable-features=CliOne,CliTwo', '--enable-features', 'ArgOne',
+          '--enable-features=CfgOne,CfgTwo']),
+    ])
+    def test_enable_features(self, config_stub, monkeypatch, parser,
+                             backend, bar, expected):
+        monkeypatch.setattr(qtargs.objects, 'backend', backend)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = bar
+        config_stub.val.qt.args = ['enable-features=CfgOne,CfgTwo', 'foo']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CliOne,CliTwo',
+            '--qt-arg', 'enable-features', 'ArgOne',
+        ])
+
+        args = qtargs.qt_args(parsed)
+
+        if backend == usertypes.Backend.QtWebEngine:
+            features = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+            assert features == expected
+            assert '--enable-features' not in args
+        else:
+            assert args == [sys.argv[0], '--enable-features=CliOne,CliTwo',
+                            '--enable-features', 'ArgOne',
+                            '--enable-features=CfgOne,CfgTwo', '--foo']
+        assert '--foo' in args
+
+    @pytest.mark.parametrize('configured_args', [
+        ['enable-features='],
+        ['enable-features'],
+    ])
+    def test_enable_features_empty(self, config_stub, monkeypatch, parser,
+                                   configured_args):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = configured_args
+
+        args = qtargs.qt_args(parser.parse_args([]))
+
+        assert not any(arg.startswith('--enable-features=') for arg in args)
+        assert '--enable-features' not in args
+
+    def test_enabled_features_helper(self, config_stub, monkeypatch):
+        config_stub.val.scrolling.bar = 'overlay'
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+
+        features = qtargs._qtwebengine_enabled_features([
+            '--enable-features=Foo<Trial/yes>,Bar', '--enable-features=Baz'])
+
+        assert list(features) == [
+            'Foo<Trial/yes>', 'Bar', 'Baz', 'OverlayScrollbar']
+
+    def test_qtwebengine_args_features(self, config_stub, parser):
+        config_stub.val.scrolling.bar = 'never'
+        namespace = parser.parse_args([])
+
+        with_features = list(qtargs._qtwebengine_args(
+            namespace, ['--enable-features=Foo,Bar',
+                        '--enable-features=Bar,Baz']))
+        without_features = list(qtargs._qtwebengine_args(namespace, []))
+
+        assert [arg for arg in with_features
+                if arg.startswith('--enable-features=')] == [
+                    '--enable-features=Foo,Bar,Baz']
+        assert not any(arg.startswith('--enable-features=')
+                       for arg in without_features)
+
