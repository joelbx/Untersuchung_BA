-        argv += list(_qtwebengine_args(namespace))
+        feature_flags = []
+        other_args = []
+        index = 0
+        while index < len(argv):
+            arg = argv[index]
+            if arg.startswith('--enable-features='):
+                feature_flags.append(arg)
+            elif arg == '--enable-features':
+                if (index + 1 < len(argv) and
+                        not argv[index + 1].startswith('--')):
+                    index += 1
+                    feature_flags.append('--enable-features=' + argv[index])
+            else:
+                other_args.append(arg)
+            index += 1
+
+        argv = other_args
