diff --git a/test/image-cleanup.js b/test/image-cleanup.js
new file mode 100644
index 0000000..28b8d4e
--- /dev/null
+++ b/test/image-cleanup.js
@@ -0,0 +1,134 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const nconf = require('nconf');
+
+const db = require('./mocks/databasemock');
+const User = require('../src/user');
+const Groups = require('../src/groups');
+const socketUser = require('../src/socket.io/user');
+
+describe('local profile image cleanup', () => {
+	const extensions = ['png', 'jpeg', 'jpg', 'bmp'];
+	const profileDir = () => path.join(nconf.get('upload_path'), 'profile');
+	const filesDir = () => path.join(nconf.get('upload_path'), 'files');
+	const profileUrl = filename => `${nconf.get('relative_path')}/assets/uploads/profile/${filename}`;
+	const storedProfileUrl = filename => `/assets/uploads/profile/${filename}`;
+	const filesUrl = filename => `${nconf.get('relative_path')}/assets/uploads/files/${filename}`;
+	let sequence = 0;
+
+	async function makeUser() {
+		sequence += 1;
+		return await User.create({ username: `imagecleanup${sequence}` });
+	}
+
+	async function createProfileFiles(uid, type) {
+		await fs.promises.mkdir(profileDir(), { recursive: true });
+		const names = extensions.flatMap(ext => [
+			`${uid}-profile${type}.${ext}`,
+			`${uid}-profile${type}-123.${ext}`,
+		]);
+		await Promise.all(names.map(name => fs.promises.writeFile(path.join(profileDir(), name), 'image')));
+		return names;
+	}
+
+	async function assertMissing(folder, names) {
+		const remaining = await fs.promises.readdir(folder);
+		names.forEach(name => assert(!remaining.includes(name), name));
+	}
+
+	it('removes every local cover and avatar variant and returns previous avatar fields', async () => {
+		const uid = await makeUser();
+		const covers = await createProfileFiles(uid, 'cover');
+		const avatars = await createProfileFiles(uid, 'avatar');
+		const coverUrl = storedProfileUrl(covers[1]);
+		const avatarUrl = profileUrl(avatars[1]);
+		await User.setUserFields(uid, {
+			'cover:url': coverUrl,
+			'cover:position': '50% 50%',
+			uploadedpicture: storedProfileUrl(avatars[1]),
+			picture: storedProfileUrl(avatars[1]),
+		});
+		assert.strictEqual(await User.getLocalCoverPath(uid), path.join(profileDir(), covers[1]));
+		assert.strictEqual(await User.getLocalAvatarPath(uid), path.join(profileDir(), avatars[1]));
+		assert.deepStrictEqual(await User.removeProfileImage(uid), {
+			uploadedpicture: avatarUrl,
+			picture: avatarUrl,
+		});
+		assert.deepStrictEqual(await User.removeCoverPicture(uid), { success: true });
+		await assertMissing(profileDir(), covers.concat(avatars));
+		assert.strictEqual(await User.getLocalCoverPath(uid), false);
+		assert.strictEqual(await User.getLocalAvatarPath(uid), false);
+		const fields = await User.getUserFields(uid, ['uploadedpicture', 'picture', 'cover:url', 'cover:position']);
+		assert.strictEqual(fields.uploadedpicture, '');
+		assert.strictEqual(fields.picture, '');
+		assert.strictEqual(fields['cover:url'], null);
+		assert.strictEqual(fields['cover:position'], null);
+		await User.removeProfileImage(uid);
+		await User.removeCoverPicture(uid);
+	});
+
+	it('keeps an unrelated avatar and never follows a profile URL outside its folder', async () => {
+		const uid = await makeUser();
+		const other = await makeUser();
+		const otherNames = await createProfileFiles(other, 'avatar');
+		const outsideName = `image-cleanup-${uid}.png`;
+		await fs.promises.mkdir(filesDir(), { recursive: true });
+		await fs.promises.writeFile(path.join(filesDir(), outsideName), 'image');
+		await User.setUserFields(uid, {
+			uploadedpicture: storedProfileUrl(`../files/${outsideName}`),
+			picture: 'https://example.com/avatar.png',
+		});
+		await User.removeProfileImage(uid);
+		assert.strictEqual((await User.getUserField(uid, 'picture')), 'https://example.com/avatar.png');
+		assert(await fs.promises.stat(path.join(filesDir(), outsideName)));
+		assert(await fs.promises.stat(path.join(profileDir(), otherNames[0])));
+		await fs.promises.unlink(path.join(filesDir(), outsideName));
+		await User.deleteAccount(other);
+	});
+
+	it('removes profile files on account deletion even when fields are empty', async () => {
+		const uid = await makeUser();
+		const names = (await createProfileFiles(uid, 'cover')).concat(await createProfileFiles(uid, 'avatar'));
+		await User.deleteAccount(uid);
+		await assertMissing(profileDir(), names);
+	});
+
+	it('removes only group covers inside the local files folder', async () => {
+		await fs.promises.mkdir(filesDir(), { recursive: true });
+		const names = ['groupCover-cleanup.png', 'groupCover-cleanup.bmp', 'groupCoverThumb-cleanup.jpg'];
+		await Promise.all(names.map(name => fs.promises.writeFile(path.join(filesDir(), name), 'image')));
+		await db.setObject(`group:image-cleanup`, {
+			'cover:url': `/assets/uploads/files/${names[0]}`,
+			'cover:thumb:url': filesUrl(names[2]),
+			'cover:position': '50% 50%',
+		});
+		await Groups.removeCover({ groupName: 'image-cleanup' });
+		await assertMissing(filesDir(), names);
+		assert.deepStrictEqual(await db.getObjectFields('group:image-cleanup', ['cover:url', 'cover:thumb:url', 'cover:position']), {
+			'cover:url': null,
+			'cover:thumb:url': null,
+			'cover:position': null,
+		});
+		await Groups.removeCover({ groupName: 'image-cleanup' });
+		const external = path.join(filesDir(), 'group-cover-external.png');
+		await fs.promises.writeFile(external, 'image');
+		await db.setObject('group:image-cleanup', {
+			'cover:url': 'https://example.com/group-cover-external.png',
+			'cover:thumb:url': `${nconf.get('relative_path')}/assets/uploads/files/../files/group-cover-external.png`,
+		});
+		await Groups.removeCover({ groupName: 'image-cleanup' });
+		assert(await fs.promises.stat(external));
+		await fs.promises.unlink(external);
+	});
+
+	it('rejects invalid user IDs before removing a cover', async () => {
+		const callerUid = await makeUser();
+		await assert.rejects(
+			socketUser.removeCover({ uid: callerUid }, { uid: '../1' }),
+			{ message: '[[error:invalid-uid]]' }
+		);
+	});
+});
