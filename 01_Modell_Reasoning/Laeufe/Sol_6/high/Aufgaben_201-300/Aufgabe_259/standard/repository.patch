+    @pytest.mark.asyncio
+    async def test_public_edition_preferred_with_multiple_printdisabled_editions(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w,
+                    key="/books/OL1M",
+                    ocaid='loanable',
+                    _ia_meta={"collection": ['lendinglibrary', 'inlibrary']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL2M",
+                    ocaid='printdisabled1',
+                    _ia_meta={"collection": ['printdisabled', 'americana']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL3M",
+                    ocaid='printdisabled2',
+                    _ia_meta={"collection": ['printdisabled', 'internetarchivebooks']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL4M",
+                    ocaid='public',
+                    _ia_meta={"collection": ['americana', 'opensource']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+        assert d['has_fulltext'] is True
+        assert d['public_scan_b'] is True
+        assert d['lending_edition_s'] == 'OL4M'
+        assert d['lending_identifier_s'] == 'public'
+        assert sss(d['printdisabled_s']) == ['OL2M', 'OL3M']
+        assert set(d['ia']) == {
+            'loanable', 'printdisabled1', 'printdisabled2', 'public',
+        }
+        assert set(d['ia_collection_s'].split(';')) == {
+            'lendinglibrary', 'inlibrary', 'printdisabled', 'americana',
+            'internetarchivebooks', 'opensource',
+        }
+
+    @pytest.mark.asyncio
+    async def test_lending_identifier_matches_edition_without_public_scan(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w,
+                    key="/books/OL1M",
+                    ocaid='lendinglibrary-id',
+                    _ia_meta={"collection": ['lendinglibrary']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL2M",
+                    ocaid='inlibrary-id',
+                    _ia_meta={"collection": ['inlibrary']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+        assert d['public_scan_b'] is False
+        assert d['lending_edition_s'] == 'OL1M'
+        assert d['lending_identifier_s'] == 'lendinglibrary-id'
+
