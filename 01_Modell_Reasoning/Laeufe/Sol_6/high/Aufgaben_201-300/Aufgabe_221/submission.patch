+class bestbook_award(delegate.page):
+    path = r'/works/OL(\d+)W/awards'
+    encoding = 'json'
+
+    @jsonapi
+    def POST(self, work_id):
+        user = accounts.get_current_user()
+        if not user:
+            return json.dumps({'errors': 'Authentication failed'})
+
+        params = dict(web.input(op=None, topic=None, comment=None, edition_key=None))
+        if web.ctx.env.get('CONTENT_TYPE', '').startswith('application/json'):
+            try:
+                params.update(json.loads(web.data()))
+            except (TypeError, ValueError):
+                return json.dumps({'errors': 'Invalid JSON'})
+
+        username = user.key.split('/')[-1]
+        op = params.get('op')
+        if op not in ('add', 'remove', 'update'):
+            return json.dumps({'errors': 'Invalid operation'})
+
+        try:
+            if op == 'remove':
+                rows = Bestbook.remove(username, work_id=work_id)
+                return json.dumps({'success': True, 'rows': rows})
+
+            topic = params.get('topic')
+            if not isinstance(topic, str) or not topic.strip():
+                return json.dumps({'errors': 'A topic is required'})
+            awards = (
+                Bestbook.get_awards(work_id=work_id, username=username)
+                if op == 'update'
+                else []
+            )
+            comment = params.get('comment')
+            if op == 'update' and comment is None and awards:
+                comment = awards[0]['comment']
+            if comment is None:
+                comment = ''
+            if not isinstance(comment, str):
+                return json.dumps({'errors': 'Invalid comment'})
+            edition_key = params.get('edition_key')
+            edition_id = (
+                int(extract_numeric_id_from_olid(edition_key)) if edition_key else None
+            )
+            if op == 'update' and edition_key is None and awards:
+                edition_id = awards[0]['edition_id']
+            if op == 'add':
+                award = Bestbook.add(username, work_id, topic, comment, edition_id)
+            else:
+                award = Bestbook.update(username, work_id, topic, comment, edition_id)
+            return json.dumps({'success': True, 'award': award})
+        except (Bestbook.AwardConditionsError, TypeError, ValueError) as exc:
+            return json.dumps({'errors': str(exc)})
+
+
+class bestbook_count(delegate.page):
+    path = '/awards/count'
+    encoding = 'json'
+
+    @jsonapi
+    def GET(self):
+        params = web.input(work_id=None, username=None, topic=None)
+        try:
+            count = Bestbook.get_count(
+                work_id=params.work_id,
+                username=params.username,
+                topic=params.topic,
+            )
+            return json.dumps({'count': count})
+        except (TypeError, ValueError):
+            return json.dumps({'errors': 'Invalid work ID'})
+
