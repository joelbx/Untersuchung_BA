+                            lambda: utils.parse_version(runtime))}))
+    monkeypatch.setattr(QtCore, 'QT_VERSION_STR', compiled_qt)
+    monkeypatch.setattr(QtCore, 'PYQT_VERSION_STR', compiled_pyqt)
+    monkeypatch.setattr(earlyinit, 'qt_version', lambda: 'reported Qt')
+    errors = []
+    monkeypatch.setattr(earlyinit, '_die', errors.append)
+
+    earlyinit.check_qt_version()
+
+    if invalid:
+        assert len(errors) == 1
+        assert 'reported Qt' in errors[0]
+        assert compiled_pyqt in errors[0]
+    else:
+        assert errors == []
 
 
