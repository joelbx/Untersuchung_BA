@@ -0,0 +1,26 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { useShouldMoveOut } from './useShouldMoveOut';
+
+describe('useShouldMoveOut', () => {
+    const onBack = jest.fn();
+
+    beforeEach(() => onBack.mockClear());
+
+    it('waits for elements to load before checking the active ID', () => {
+        const { rerender } = renderHook((props) => useShouldMoveOut(props), {
+            initialProps: { elementID: 'active', elementIDs: [] as string[], loadingElements: true, onBack },
+        });
+
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ elementID: 'active', elementIDs: ['active'], loadingElements: false, onBack });
+        expect(onBack).not.toHaveBeenCalled();
+        rerender({ elementID: 'active', elementIDs: [], loadingElements: false, onBack });
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([undefined, '', 'missing'])('moves out for an invalid active ID (%s)', (elementID) => {
+        renderHook(() => useShouldMoveOut({ elementID, elementIDs: ['active'], loadingElements: false, onBack }));
+        expect(onBack).toHaveBeenCalledTimes(1);
+    });
+});
