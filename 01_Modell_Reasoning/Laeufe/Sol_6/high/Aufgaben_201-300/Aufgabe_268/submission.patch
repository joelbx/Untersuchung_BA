+@pytest.mark.parametrize('error, description', [
+    (QProcess.FailedToStart, 'failed to start'),
+    (QProcess.Crashed, 'crashed'),
+    (QProcess.Timedout, 'timed out'),
+    (QProcess.WriteError, 'write error'),
+    (QProcess.ReadError, 'read error'),
+])
+def test_error_types(fake_proc, message_mock, caplog, monkeypatch, error,
+                     description):
+    """Each process error identifies the command and the error type."""
+    monkeypatch.setattr(utils, 'is_windows', True)
+    fake_proc.cmd = 'example-command'
+    fake_proc._proc.errorString.return_value = 'Example error detail'
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_error(error)
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == (
+        "Testprocess 'example-command' {}: Example error detail".format(
+            description))
+
+
+@pytest.mark.parametrize('detail, hint', [
+    ('No such file or directory', True),
+    ('execvp: No such file or directory', True),
+    ('Permission denied', True),
+    ('execvp: Permission denied', True),
+    ('Other error', False),
+])
+@pytest.mark.parametrize('windows', [False, True])
+def test_failed_to_start_hint(fake_proc, message_mock, caplog, monkeypatch,
+                              detail, hint, windows):
+    """Show the command hint for common POSIX start failures only."""
+    monkeypatch.setattr(utils, 'is_windows', windows)
+    fake_proc.cmd = 'example-command'
+    fake_proc._proc.errorString.return_value = detail
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_error(QProcess.FailedToStart)
+
+    expected = "Testprocess 'example-command' failed to start: " + detail
+    if hint and not windows:
+        expected += (" (Hint: Make sure 'example-command' exists and is "
+                     "executable)")
+    assert message_mock.getmsg(usertypes.MessageLevel.error).text == expected
 
 
