+func TestNewWithClient(t *testing.T) {
+	tests := []struct {
+		name        string
+		namespace   string
+		replicaName string
+		releaseName string
+		missingEnv  string
+	}{
+		{
+			name:        "configured",
+			namespace:   "agent-namespace",
+			replicaName: "agent-0",
+			releaseName: "agent-release",
+		},
+		{
+			name:        "release name is optional",
+			namespace:   "agent-namespace",
+			replicaName: "agent-0",
+		},
+		{
+			name:        "missing namespace",
+			replicaName: "agent-0",
+			missingEnv:  NamespaceEnv,
+		},
+		{
+			name:       "missing replica name",
+			namespace:  "agent-namespace",
+			missingEnv: teleportReplicaNameEnv,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv(teleportReplicaNameEnv, tt.replicaName)
+			t.Setenv(ReleaseNameEnv, tt.releaseName)
+
+			client := fake.NewSimpleClientset()
+			b, err := NewWithClient(client)
+			if tt.missingEnv != "" {
+				require.Nil(t, b)
+				require.EqualError(t, err, fmt.Sprintf("environment variable %q not set or empty", tt.missingEnv))
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.namespace, b.Namespace)
+			require.Equal(t, tt.replicaName, b.ReplicaName)
+			require.Equal(t, tt.replicaName+"-state", b.SecretName)
+			require.Equal(t, tt.releaseName, b.ReleaseName)
+			require.Equal(t, client, b.KubeClient)
+			require.Equal(t, generateSecretAnnotations(tt.namespace, tt.releaseName), b.genSecretObject().Annotations)
+		})
+	}
+}
