+		return
+	}
+	expiresAt := item.ExpiresAt()
+	deadline := c.evictionDeadline.Load()
+	if deadline == nil || expiresAt.Before(*deadline) {
+		c.evictionDeadline.Store(&expiresAt)
+	}
 }
 
