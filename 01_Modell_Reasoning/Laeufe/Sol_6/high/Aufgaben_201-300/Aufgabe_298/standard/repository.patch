+}
+
+// evictExpiredLocked also refreshes the deadline after removing expired items.
+// Callers that insert values hold evictionMu so a new short TTL cannot be lost
+// while the next deadline is being calculated.
+func (c *simpleCache[K, V]) evictExpiredLocked() {
+	deadline := c.evictionDeadline.Load()
+	if deadline == nil || time.Now().Before(*deadline) {
+		return
+	}
+	c.data.DeleteExpired()
+	c.evictionDeadline.Store(nil)
+	for _, key := range c.data.Keys() {
+		if item := c.data.Get(key); item != nil {
+			c.scheduleEviction(item)
+		}
+	}
+}
