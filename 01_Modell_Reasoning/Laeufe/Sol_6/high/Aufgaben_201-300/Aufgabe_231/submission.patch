+func Test_shouldDownload_missingMetadata(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "vuls.db")
+	dbc, err := bolt.Open(path, 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dbc.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	_, err = vuls2.ShouldDownload(config.Vuls2Conf{Path: path, SkipUpdate: true}, time.Now())
+	if err == nil || !strings.Contains(err.Error(), path) {
+		t.Fatalf("shouldDownload() error = %v, want error containing db path", err)
+	}
+}
+
+func Test_newDBConnection_validDatabase(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "vuls.db")
+	if err := putMetadata(types.Metadata{SchemaVersion: common.SchemaVersion}, path); err != nil {
+		t.Fatal(err)
+	}
+
+	dbc, err := vuls2.NewDBConnection(config.Vuls2Conf{Path: path, SkipUpdate: true}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dbc.Open(); err != nil {
+		t.Fatalf("returned connection could not be opened: %v", err)
+	}
+	defer dbc.Close()
+	metadata, err := dbc.GetMetadata()
+	if err != nil || metadata == nil || metadata.SchemaVersion != common.SchemaVersion {
+		t.Fatalf("GetMetadata() = %v, %v", metadata, err)
+	}
+}
