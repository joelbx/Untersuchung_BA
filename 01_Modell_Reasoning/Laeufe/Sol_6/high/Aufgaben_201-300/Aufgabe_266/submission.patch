@@ -96,6 +97,37 @@ def import_item_db_staged(setup_item_db):
 
 
 class TestImportItem:
+    def test_find_staged_or_pending(self, import_item_db):
+        assert STAGED_SOURCES == ('amazon', 'idb')
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {
+                    'id': 4,
+                    'ia_id': 'amazon:9780306406157',
+                    'status': 'staged',
+                    'data': '{}',
+                },
+                {'id': 5, 'ia_id': 'idb:0306406152', 'status': 'pending'},
+                {'id': 6, 'ia_id': 'other:9780306406157', 'status': 'pending'},
+                {'id': 7, 'ia_id': 'amazon:0306406152', 'status': 'created'},
+                {'id': 8, 'ia_id': 'idb:9780306406157', 'status': 'failed'},
+                {'id': 9, 'ia_id': 'amazon:unrelated', 'status': 'staged'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['9780306406157', '0306406152'])
+        assert isinstance(result, BaseResultSet)
+        rows = list(result)
+        assert {row.ia_id for row in rows} == {
+            'amazon:9780306406157',
+            'idb:0306406152',
+        }
+        assert next(row for row in rows if row.id == 4).data == '{}'
+        assert ImportItem.find_staged_or_pending(['9780306406157'], iter(['other']))[0].id == 6
+        assert list(ImportItem.find_staged_or_pending([])) == []
+        assert list(ImportItem.find_staged_or_pending(['9780306406157'], [])) == []
+
     def test_delete(self, import_item_db):
         assert len(list(import_item_db.select('import_item'))) == 3
 
