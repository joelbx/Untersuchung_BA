+    def test_from_isbn_loads_local_import(self, monkeypatch):
+        class Site:
+            imported = False
+
+            def things(self, query):
+                if self.imported and query.get('isbn_10') == '0306406152':
+                    return ['/books/OL1M']
+                return []
+
+            def get(self, key):
+                return key
+
+        site = Site()
+        monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+        searched = []
+        imported = []
+
+        def find_local(identifiers):
+            searched.append(identifiers)
+            return [web.storage(ia_id='idb:0306406152', status='staged')]
+
+        def do_import(item):
+            imported.append(item)
+            site.imported = True
+
+        monkeypatch.setattr(
+            models.ImportItem, 'find_staged_or_pending', staticmethod(find_local)
+        )
+        monkeypatch.setattr(models, 'do_import', do_import)
+
+        assert models.Edition.from_isbn('0306406152') == '/books/OL1M'
+        assert searched == [['9780306406157', '0306406152']]
+        assert len(imported) == 1
+        assert imported[0].ia_id == 'idb:0306406152'
+
     def mock_edition(self, edition_class):
