diff --git a/test/api-utils-tokens.js b/test/api-utils-tokens.js
new file mode 100644
index 0000000..41d0391
--- /dev/null
+++ b/test/api-utils-tokens.js
@@ -0,0 +1,92 @@
+'use strict';
+
+const assert = require('assert');
+
+const db = require('./mocks/databasemock');
+const helpers = require('./helpers');
+const user = require('../src/user');
+const { tokens } = require('../src/api/utils');
+
+describe('API token utilities', () => {
+	let uid;
+	let first;
+	let second;
+
+	before(async () => {
+		uid = await user.create({ username: 'api-token-utils-user' });
+	});
+
+	it('handles empty inputs and invalid users', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), { message: '[[error:invalid-data]]' });
+		await assert.rejects(tokens.get(), { message: '[[error:invalid-data]]' });
+		await assert.rejects(tokens.get(''), { message: '[[error:invalid-data]]' });
+		await assert.rejects(tokens.generate({ uid: uid + 100000 }), { message: '[[error:no-user]]' });
+	});
+
+	it('creates indexed tokens and returns hydrated data in input order', async () => {
+		const before = Date.now();
+		first = await tokens.generate({ uid, description: 'first' });
+		second = await tokens.generate({ uid: 0 });
+		const after = Date.now();
+		const raw = await db.getObject(`token:${first}`);
+		assert.strictEqual(Number(raw.uid), uid);
+		assert.strictEqual(raw.description, 'first');
+		assert(Number.isFinite(Number(raw.timestamp)));
+		assert(Number(raw.timestamp) >= before && Number(raw.timestamp) <= after);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', first), Number(raw.timestamp));
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', first), uid);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', second), 0);
+
+		const data = await tokens.get([second, first]);
+		assert.strictEqual(data[0].uid, 0);
+		assert.strictEqual(data[0].description, '');
+		assert.strictEqual(data[1].uid, uid);
+		assert.strictEqual(data[1].lastSeen, null);
+		assert.deepStrictEqual(await tokens.get(first), data[1]);
+		const listed = await tokens.list();
+		assert.strictEqual(listed.length, 2);
+		assert(listed[0].timestamp <= listed[1].timestamp);
+	});
+
+	it('authenticates generated tokens and tracks usage', async () => {
+		const auth = require('../src/routes/authentication');
+		const result = await new Promise((resolve) => { auth.verifyToken(first, (_, principal) => resolve(principal)); });
+		assert.strictEqual(result.uid, uid);
+		const { res, body } = await helpers.request('get', '/api/self', {
+			json: true,
+			headers: { Authorization: `Bearer ${first}` },
+		});
+		assert.strictEqual(res.statusCode, 200);
+		assert.strictEqual(body.username, 'api-token-utils-user');
+		const master = await new Promise((resolve) => { auth.verifyToken(second, (_, principal) => resolve(principal)); });
+		assert.strictEqual(master.master, true);
+		const before = Date.now();
+		await tokens.log(first);
+		const scores = await tokens.getLastSeen([second, first]);
+		assert.strictEqual(scores[0], null);
+		assert(Number.isFinite(scores[1]) && scores[1] >= before && scores[1] <= Date.now());
+		assert.strictEqual((await tokens.get(first)).lastSeen, scores[1]);
+	});
+
+	it('updates only description and removes all token data', async () => {
+		const original = await db.getObject(`token:${first}`);
+		const updated = await tokens.update(first, { description: 'updated' });
+		assert.strictEqual(updated.description, 'updated');
+		assert.strictEqual(updated.uid, uid);
+		assert.strictEqual(updated.timestamp, Number(original.timestamp));
+		assert(Number.isFinite(updated.lastSeen));
+
+		await tokens.delete(first);
+		await tokens.delete(second);
+		assert.strictEqual(await db.getObject(`token:${first}`), null);
+		const keys = ['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'];
+		const scores = await Promise.all(keys.flatMap(key => [
+			db.sortedSetScore(key, first), db.sortedSetScore(key, second),
+		]));
+		assert(scores.every(score => score === null));
+		assert.deepStrictEqual(await tokens.list(), []);
+	});
+});
