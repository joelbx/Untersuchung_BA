+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Show an eligible JavaScript message in the UI. Return whether shown."""
+    levels_by_source = config.cache['content.javascript.log_message.levels'] or {}
+    if not any(level.name in levels and fnmatch.fnmatchcase(source, pattern)
+               for pattern, levels in levels_by_source.items()):
+        return False
+
+    excludes = config.cache['content.javascript.log_message.excludes'] or {}
+    for pattern, messages in excludes.items():
+        if fnmatch.fnmatchcase(source, pattern) and any(
+                fnmatch.fnmatchcase(msg, excluded) for excluded in messages):
+            return False
+
+    _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+    return True
+
