diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..74ad2d8
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,83 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan struct{})
+	cancelled := make(chan struct{})
+	release := make(chan struct{})
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		close(started)
+		<-ctx.Done()
+		close(cancelled)
+		<-release
+		return false, ctx.Err()
+	}, WithInterval(time.Millisecond))
+
+	loopDone := make(chan struct{})
+	go func() {
+		p.Poll()
+		close(loopDone)
+	}()
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("poller did not invoke update")
+	}
+
+	closeDone := make(chan struct{})
+	go func() {
+		_ = p.Close()
+		close(closeDone)
+	}()
+	select {
+	case <-cancelled:
+	case <-time.After(time.Second):
+		t.Fatal("close did not cancel update")
+	}
+	select {
+	case <-closeDone:
+		t.Fatal("close returned before update finished")
+	default:
+	}
+
+	close(release)
+	select {
+	case <-closeDone:
+	case <-time.After(time.Second):
+		t.Fatal("close did not wait for polling loop")
+	}
+	<-loopDone
+	require.NoError(t, p.Close())
+}
+
+func TestPollerCloseBeforeStart(t *testing.T) {
+	called := false
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		called = true
+		return false, nil
+	})
+	require.NoError(t, p.Close())
+	p.Poll()
+	require.False(t, called)
+}
+
+func TestPollerCloseImmediatelyAfterStart(t *testing.T) {
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		return false, nil
+	})
+	p.Start()
+	require.NoError(t, p.Close())
+	select {
+	case <-p.done:
+	default:
+		t.Fatal("polling loop remained active after close")
+	}
+}
