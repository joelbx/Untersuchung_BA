+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsKeepsVendorSeverityAndCVSS(t *testing.T) {
+	published := time.Date(2023, 4, 5, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	contents := getCveContents("CVE-2023-1", trivydbTypes.Vulnerability{
+		Title: "title", Description: "summary", Severity: "HIGH",
+		VendorSeverity: trivydbTypes.VendorSeverity{
+			"debian": trivydbTypes.SeverityLow,
+			"ubuntu": trivydbTypes.SeverityMedium,
+			"nvd":    trivydbTypes.SeverityHigh,
+		},
+		CVSS: trivydbTypes.VendorCVSS{
+			"nvd": {V2Score: 5.2, V2Vector: "AV:N/test", V3Score: 8.1, V3Vector: "CVSS:3.1/test"},
+		},
+		References:    []string{"https://example.test/advisory"},
+		PublishedDate: &published, LastModifiedDate: &modified,
+	})
+	for source, severity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM", models.TrivyNVD: "HIGH",
+	} {
+		if len(contents[source]) != 1 {
+			t.Fatalf("%s contents: %+v", source, contents[source])
+		}
+		content := contents[source][0]
+		if content.Type != source || content.CveID != "CVE-2023-1" || content.Cvss3Severity != severity ||
+			content.Title != "title" || content.Summary != "summary" || len(content.References) != 1 ||
+			!content.Published.Equal(published) || !content.LastModified.Equal(modified) {
+			t.Fatalf("%s metadata: %+v", source, content)
+		}
+	}
+	if contents[models.TrivyNVD][0].Cvss2Score != 5.2 || contents[models.TrivyNVD][0].Cvss3Score != 8.1 ||
+		contents[models.TrivyDebian][0].Cvss3Score != 0 {
+		t.Fatalf("source scores: %+v", contents)
+	}
+}
