--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,57 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	base := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-0001", PkgName: "example",
+		SeveritySource: "debian",
+		Vulnerability: dbtypes.Vulnerability{
+			Title: "title", Description: "summary", Severity: "LOW",
+			VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "nvd": dbtypes.SeverityHigh},
+			CVSS:           dbtypes.VendorCVSS{"nvd": {V3Score: 8.1, V3Vector: "CVSS:3.1/test"}},
+			References:     []string{"https://example.test/advisory"},
+			PublishedDate:  &published, LastModifiedDate: &modified,
+		},
+	}
+	ubuntu := base
+	ubuntu.SeveritySource = "ubuntu"
+	ubuntu.Severity = "MEDIUM"
+	ubuntu.VendorSeverity = dbtypes.VendorSeverity{"ubuntu": dbtypes.SeverityMedium}
+	ubuntu.CVSS = dbtypes.VendorCVSS{"ubuntu": {V2Score: 4.2, V2Vector: "AV:N/test"}}
+	results := types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{base}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{ubuntu}},
+	}
+	got, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := got.ScannedCves[base.VulnerabilityID].CveContents
+	for source, severity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyNVD: "HIGH", models.TrivyUbuntu: "MEDIUM",
+	} {
+		if len(contents[source]) != 1 || contents[source][0].Cvss3Severity != severity {
+			t.Fatalf("%s severity: %+v", source, contents[source])
+		}
+		if contents[source][0].Type != source || contents[source][0].CveID != base.VulnerabilityID ||
+			!contents[source][0].Published.Equal(published) || !contents[source][0].LastModified.Equal(modified) ||
+			len(contents[source][0].References) != 1 {
+			t.Fatalf("%s metadata: %+v", source, contents[source][0])
+		}
+	}
+	if contents[models.TrivyNVD][0].Cvss3Score != 8.1 || contents[models.TrivyUbuntu][0].Cvss2Score != 4.2 {
+		t.Fatalf("source scores: %+v", contents)
+	}
+}
