+func TestTrivySourceMetadataAggregation(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, Title: "Debian title", Summary: "Debian summary", Cvss3Severity: "LOW"}},
+		TrivyUbuntu: {{Type: TrivyUbuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "MEDIUM"}},
+		TrivyNVD:    {{Type: TrivyNVD, Title: "NVD title", Summary: "NVD summary", Cvss2Score: 4.3, Cvss3Score: 8.1, Cvss3Severity: "HIGH"}},
+	}}
+	for _, result := range []struct {
+		name   string
+		values []CveContentStr
+	}{
+		{"titles", v.Titles("en", "debian")},
+		{"summaries", v.Summaries("en", "debian")},
+	} {
+		if len(result.values) != 3 {
+			t.Fatalf("%s: %+v", result.name, result.values)
+		}
+	}
+	if scores := v.Cvss2Scores(); len(scores) != 1 || scores[0].Type != TrivyNVD || scores[0].Value.Score != 4.3 {
+		t.Fatalf("CVSS2: %+v", scores)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 3 {
+		t.Fatalf("CVSS3: %+v", scores)
+	}
+	got := map[CveContentType]string{}
+	for _, score := range scores {
+		got[score.Type] = score.Value.Severity
+	}
+	for source, severity := range map[CveContentType]string{TrivyDebian: "LOW", TrivyUbuntu: "MEDIUM", TrivyNVD: "HIGH"} {
+		if got[source] != severity {
+			t.Fatalf("%s severity: %q", source, got[source])
+		}
+	}
