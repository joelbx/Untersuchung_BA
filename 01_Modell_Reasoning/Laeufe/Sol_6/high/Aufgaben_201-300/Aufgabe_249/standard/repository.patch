diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index cbf68a2..0889e3d 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -25,6 +25,111 @@ def createWikidataEntity(
     )
 
 
+@pytest.mark.parametrize(
+    'language, sitelinks, expected',
+    [
+        (
+            'fr',
+            {
+                'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Auteur'},
+                'enwiki': {'url': 'https://en.wikipedia.org/wiki/Author'},
+            },
+            ('https://fr.wikipedia.org/wiki/Auteur', 'fr'),
+        ),
+        (
+            'fr',
+            {'enwiki': {'url': 'https://en.wikipedia.org/wiki/Author'}},
+            ('https://en.wikipedia.org/wiki/Author', 'en'),
+        ),
+        ('fr', {'frwiki': {}, 'enwiki': {'url': 'https://en.wikipedia.org/wiki/Author'}}, ('https://en.wikipedia.org/wiki/Author', 'en')),
+        ('fr', {'dewiki': {'url': 'https://de.wikipedia.org/wiki/Autor'}}, None),
+    ],
+)
+def test_get_wikipedia_link(language, sitelinks, expected):
+    entity = createWikidataEntity()
+    entity.sitelinks = sitelinks
+
+    assert entity._get_wikipedia_link(language) == expected
+
+
+def test_get_statement_values_skips_malformed_entries():
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'first'}},
+            {'value': {'content': 'second'}},
+            {'value': {}},
+            {'value': None},
+            {},
+            None,
+        ]
+    }
+
+    assert entity._get_statement_values('P1960') == ['first', 'second']
+    assert entity._get_statement_values('P9999') == []
+
+    entity.statements['P1960'] = [{'value': {'content': 'only'}}]
+    assert entity._get_statement_values('P1960') == ['only']
+
+    entity.statements['P1960'] = {'value': {'content': 'not a statement list'}}
+    assert entity._get_statement_values('P1960') == []
+
+
+def test_get_external_profiles_uses_language_and_multiple_identifiers():
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Auteur'},
+        'enwiki': {'url': 'https://en.wikipedia.org/wiki/Author'},
+    }
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'abc'}},
+            {'value': {}},
+            {'value': {'content': 'xyz'}},
+        ]
+    }
+
+    assert entity.get_external_profiles('fr') == [
+        {
+            'url': 'https://fr.wikipedia.org/wiki/Auteur',
+            'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+            'label': 'Wikipedia',
+        },
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=abc',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=xyz',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+    ]
+
+    entity.sitelinks.pop('frwiki')
+    assert entity.get_external_profiles('fr')[0]['url'] == 'https://en.wikipedia.org/wiki/Author'
+
+
+def test_get_external_profiles_without_wikipedia_or_identifiers():
+    entity = createWikidataEntity()
+    entity.sitelinks = {}
+    entity.statements = {}
+
+    assert entity.get_external_profiles() == [
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        }
+    ]
+
+
 EXPIRED = "expired"
 MISSING = "missing"
 VALID_CACHE = ""
