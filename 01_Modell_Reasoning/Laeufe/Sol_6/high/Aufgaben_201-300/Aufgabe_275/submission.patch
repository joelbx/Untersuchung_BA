diff --git a/lib/httplib/httplib_test.go b/lib/httplib/httplib_test.go
index 9b7ff1e..ef0e801 100644
--- a/lib/httplib/httplib_test.go
+++ b/lib/httplib/httplib_test.go
@@ -17,16 +17,71 @@ limitations under the License.
 package httplib
 
 import (
+	"encoding/json"
 	"net/http"
 	"net/http/httptest"
 	"testing"
 
+	"github.com/gravitational/trace"
 	"github.com/julienschmidt/httprouter"
 	. "gopkg.in/check.v1"
 )
 
 func TestHTTP(t *testing.T) { TestingT(t) }
 
+func TestHandlersWithErrorWriter(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		makeHandler func(interface{}, error, ErrorWriter) http.HandlerFunc
+	}{
+		{
+			name: "router",
+			makeHandler: func(out interface{}, err error, writer ErrorWriter) http.HandlerFunc {
+				h := MakeHandlerWithErrorWriter(func(http.ResponseWriter, *http.Request, httprouter.Params) (interface{}, error) {
+					return out, err
+				}, writer)
+				return func(w http.ResponseWriter, r *http.Request) { h(w, r, nil) }
+			},
+		},
+		{
+			name: "standard",
+			makeHandler: func(out interface{}, err error, writer ErrorWriter) http.HandlerFunc {
+				return MakeStdHandlerWithErrorWriter(func(http.ResponseWriter, *http.Request) (interface{}, error) {
+					return out, err
+				}, writer)
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			originalErr := trace.BadParameter("test error")
+			var writtenErr error
+			writer := func(w http.ResponseWriter, err error) {
+				writtenErr = err
+				w.WriteHeader(http.StatusTeapot)
+			}
+			response := httptest.NewRecorder()
+			tc.makeHandler(nil, originalErr, writer)(response, httptest.NewRequest(http.MethodGet, "/", nil))
+			if writtenErr != originalErr || response.Code != http.StatusTeapot {
+				t.Fatalf("custom error writer received %v, response code %d", writtenErr, response.Code)
+			}
+			if response.Header().Get("Cache-Control") != "no-cache, no-store, must-revalidate" {
+				t.Fatalf("missing no-cache headers: %v", response.Header())
+			}
+
+			writtenErr = nil
+			response = httptest.NewRecorder()
+			tc.makeHandler(map[string]string{"message": "ok"}, nil, writer)(response, httptest.NewRequest(http.MethodGet, "/", nil))
+			var body map[string]string
+			if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil || body["message"] != "ok" {
+				t.Fatalf("unexpected JSON response %q: %v", response.Body.String(), err)
+			}
+			if response.Code != http.StatusOK || writtenErr != nil {
+				t.Fatalf("unexpected successful response code %d or error writer call %v", response.Code, writtenErr)
+			}
+		})
+	}
+}
+
 type HTTPSuite struct {
 }
 
