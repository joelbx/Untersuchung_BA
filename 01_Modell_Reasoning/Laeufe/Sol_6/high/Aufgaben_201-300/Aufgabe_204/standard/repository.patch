+/** Parse ISO dates and the common text dates accepted by JavaScript's Date parser. */
+export const guessDateFromText = (text: string): Date | undefined => {
+    const trimmed = text.trim();
+    const isoDate = parseISO(trimmed);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+
+    // An invalid ISO date must not be normalized by the more permissive Date parser.
+    if (/^\d{4}-/.test(trimmed)) {
+        return undefined;
+    }
+
+    const date = new Date(trimmed);
+    return isValid(date) ? date : undefined;
+};
+
