+describe('LegacyCallHandler call sounds', () => {
+    it.each(Object.values(AudioID))('unmutes %s before playback', (audioId) => {
+        const audio = document.createElement('audio');
+        audio.id = audioId;
+        audio.muted = true;
+        document.body.appendChild(audio);
+        const play = jest.spyOn(audio, 'play').mockImplementation(() => {
+            expect(audio.muted).toBe(false);
+            return Promise.resolve();
+        });
+
+        new LegacyCallHandler().play(audioId);
+
+        expect(play).toHaveBeenCalledTimes(1);
+        audio.remove();
+    });
+
+    it('does not change the mute state of an already unmuted sound', () => {
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ring;
+        document.body.appendChild(audio);
+        const setMuted = jest.fn();
+        Object.defineProperty(audio, 'muted', {
+            configurable: true,
+            get: () => false,
+            set: setMuted,
+        });
+        const play = jest.spyOn(audio, 'play').mockResolvedValue(undefined);
+
+        new LegacyCallHandler().play(AudioID.Ring);
+
+        expect(setMuted).not.toHaveBeenCalled();
+        expect(play).toHaveBeenCalledTimes(1);
+        audio.remove();
+    });
+
+    it('unmutes a sound that becomes muted while playback is queued', async () => {
+        const audio = document.createElement('audio');
+        audio.id = AudioID.Ringback;
+        document.body.appendChild(audio);
+        let finishFirstPlay: () => void;
+        const firstPlay = new Promise<void>(resolve => { finishFirstPlay = resolve; });
+        const play = jest.spyOn(audio, 'play')
+            .mockImplementationOnce(() => firstPlay)
+            .mockImplementationOnce(() => {
+                expect(audio.muted).toBe(false);
+                return Promise.resolve();
+            });
+        jest.spyOn(audio, 'load').mockImplementation();
+        const handler = new LegacyCallHandler();
+
+        handler.play(AudioID.Ringback);
+        handler.play(AudioID.Ringback);
+        audio.muted = true;
+        finishFirstPlay();
+        await new Promise<void>(resolve => setTimeout(resolve, 0));
+
+        expect(play).toHaveBeenCalledTimes(2);
+        audio.remove();
+    });
+});
