+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "canplay", "canplaythrough", "durationchange", "emptied", "ended", "loadeddata",
+    "loadedmetadata", "loadstart", "pause", "play", "playing", "progress", "ratechange",
+    "seeked", "seeking", "suspend", "timeupdate", "volumechange", "waiting",
+]);
+
+/** Log media events from call audio elements. Safe to use as a direct event listener. */
+export function handleEvent(e: Event): void {
+    const element = (e.currentTarget || e.target) as HTMLMediaElement | null;
+    const details = { type: e.type, id: element?.id };
+
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call media error", details);
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call media event", details);
+    }
+}
