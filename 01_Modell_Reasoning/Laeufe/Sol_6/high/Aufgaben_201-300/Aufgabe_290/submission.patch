+import { logger } from "matrix-js-sdk/src/logger";
+
+import { handleEvent } from "../../../src/legacy/LegacyCallHandler/handleEvent";
+import SettingsStore from "../../../src/settings/SettingsStore";
+
+describe('handleEvent', () => {
+    let audio: HTMLAudioElement;
+    let error: jest.SpyInstance;
+    let debug: jest.SpyInstance;
+
+    beforeEach(() => {
+        audio = document.createElement('audio');
+        audio.id = 'ringAudio';
+        audio.addEventListener('error', handleEvent);
+        audio.addEventListener('play', handleEvent);
+        audio.addEventListener('click', handleEvent);
+        error = jest.spyOn(logger, 'error').mockImplementation();
+        debug = jest.spyOn(logger, 'debug').mockImplementation();
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it('logs error events with the element id', () => {
+        audio.dispatchEvent(new Event('error'));
+        expect(error).toHaveBeenCalledWith('Legacy call media error', { type: 'error', id: 'ringAudio' });
+        expect(debug).not.toHaveBeenCalled();
+    });
+
+    it('logs debug events only when enabled', () => {
+        jest.spyOn(SettingsStore, 'getValue').mockReturnValue(false);
+        audio.dispatchEvent(new Event('play'));
+        expect(debug).not.toHaveBeenCalled();
+
+        jest.spyOn(SettingsStore, 'getValue').mockReturnValue(true);
+        audio.dispatchEvent(new Event('play'));
+        expect(debug).toHaveBeenCalledWith('Legacy call media event', { type: 'play', id: 'ringAudio' });
+    });
+
+    it('ignores unrelated events', () => {
+        audio.dispatchEvent(new Event('click'));
+        expect(error).not.toHaveBeenCalled();
+        expect(debug).not.toHaveBeenCalled();
+    });
+});
