diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..2b9d95b
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,68 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if strings.HasSuffix(strings.ToLower(version), "dev") {
+		return false
+	}
+
+	v, err := semver.ParseTolerant(version)
+	return err == nil && len(v.Pre) == 0
+}
+
+// Check looks up the latest published release and compares it with version.
+func Check(ctx context.Context, version string) (Info, error) {
+	client := github.NewClient(nil)
+	info, err := check(ctx, version, func(ctx context.Context) (*github.RepositoryRelease, error) {
+		release, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+		return release, err
+	})
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func check(ctx context.Context, version string, latest func(context.Context) (*github.RepositoryRelease, error)) (Info, error) {
+	info := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+	info.CurrentVersion = current.String()
+
+	release, err := latest(ctx)
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+	if release == nil {
+		return info, fmt.Errorf("getting latest release: empty response")
+	}
+
+	latestVersion, err := semver.ParseTolerant(release.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+	info.LatestVersion = latestVersion.String()
+	info.LatestVersionURL = release.GetHTMLURL()
+	info.UpdateAvailable = current.LT(latestVersion)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..4566010
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,85 @@
+package release
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3-dev", false},
+		{"v1.2.3-snapshot", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-beta.2", false},
+		{"v1.2.3", true},
+		{"1.2.3+build", true},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			if got := Is(tc.version); got != tc.want {
+				t.Fatalf("Is(%q) = %t, want %t", tc.version, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCheckRelease(t *testing.T) {
+	for _, tc := range []struct {
+		current string
+		latest  string
+		want    bool
+	}{
+		{"v1.2.3", "v1.2.3", false},
+		{"v1.2.3", "v1.3.0", true},
+		{"v1.3.0", "v1.2.3", false},
+	} {
+		t.Run(tc.current+"/"+tc.latest, func(t *testing.T) {
+			info, err := check(context.Background(), tc.current, func(context.Context) (*github.RepositoryRelease, error) {
+				return &github.RepositoryRelease{TagName: github.String(tc.latest), HTMLURL: github.String("https://example.com/release")}, nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if info.CurrentVersion != tc.current[1:] || info.LatestVersion != tc.latest[1:] || info.UpdateAvailable != tc.want || info.LatestVersionURL != "https://example.com/release" {
+				t.Fatalf("unexpected release info: %+v", info)
+			}
+		})
+	}
+}
+
+func TestCheckFailurePreservesCurrentVersion(t *testing.T) {
+	info, err := check(context.Background(), "v1.2.3", func(context.Context) (*github.RepositoryRelease, error) {
+		return nil, errors.New("unavailable")
+	})
+	if err == nil || info.CurrentVersion != "1.2.3" || info.UpdateAvailable {
+		t.Fatalf("unexpected failure result: info=%+v err=%v", info, err)
+	}
+}
+
+func TestCheckWarnsAndReturnsOnFailure(t *testing.T) {
+	core, logs := observer.New(zap.WarnLevel)
+	undo := zap.ReplaceGlobals(zap.New(core))
+	defer undo()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	info, err := Check(ctx, "v1.2.3")
+	if err == nil || info.CurrentVersion != "1.2.3" {
+		t.Fatalf("unexpected failure result: info=%+v err=%v", info, err)
+	}
+
+	entries := logs.All()
+	if len(entries) != 1 || entries[0].Message != "checking for updates" || entries[0].ContextMap()["error"] == nil {
+		t.Fatalf("expected warning with error, got %+v", entries)
+	}
+}
