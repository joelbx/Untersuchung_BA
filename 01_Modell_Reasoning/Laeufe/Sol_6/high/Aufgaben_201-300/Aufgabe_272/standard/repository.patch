+    context_class = mocker.patch('ansible.module_utils.urls.PyOpenSSLContext', create=True)
+    context = make_context(cafile='/tmp/ca.pem', ciphers=['ECDHE-RSA-AES128-SHA256'])
+    assert context is context_class.return_value
+    context.load_verify_locations.assert_called_once_with(cafile='/tmp/ca.pem', cadata=None)
+    context.set_ciphers.assert_called_once_with('ECDHE-RSA-AES128-SHA256')
+    assert context.verify_mode == ssl.CERT_REQUIRED
