+@pytest.mark.skipif(not HAS_SSLCONTEXT, reason='requires SSLContext')
+@pytest.mark.parametrize('url', ['http://ansible.com/', 'https://ansible.com/'])
+def test_Request_ciphers_on_https_handler(urlopen_mock, install_opener_mock, mocker, url):
+    mocker.patch('ansible.module_utils.urls.get_ca_certs', return_value=(None, bytearray(), []))
+    Request().open('GET', url, ciphers=['ECDHE-RSA-AES128-SHA256'], unix_socket='/tmp/ansible.sock')
+    handlers = install_opener_mock.call_args[0][0].handlers
+    contexts = [handler._context for handler in handlers
+                if isinstance(handler, (CustomHTTPSHandler, HTTPSClientAuthHandler))]
+    assert len(contexts) == 2
+    assert contexts[0] is contexts[1]
+    assert 'ECDHE-RSA-AES128-SHA256' in [cipher['name'] for cipher in contexts[0].get_ciphers()]
+    assert contexts[0].verify_mode == ssl.CERT_REQUIRED
+
+
+@pytest.mark.skipif(not HAS_SSLCONTEXT, reason='requires SSLContext')
+def test_make_context_ciphers_and_validation():
+    context = make_context(ciphers='ECDHE-RSA-AES128-SHA256', validate_certs=False)
+    assert 'ECDHE-RSA-AES128-SHA256' in [cipher['name'] for cipher in context.get_ciphers()]
+    assert context.verify_mode == ssl.CERT_NONE
+    assert context.options & ssl.OP_NO_SSLv3
+
+    for ciphers in ([], ['DEFAULT', 1], 42, 'ANSIBLE-NOT-A-CIPHER'):
+        with pytest.raises(ValueError, match='cipher'):
+            make_context(ciphers=ciphers)
+
+
