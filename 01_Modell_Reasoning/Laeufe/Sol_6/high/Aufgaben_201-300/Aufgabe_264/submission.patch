+def test_rate_limit_then_success(module, mocker):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         side_effect=[response(429), response(429), response(200)])
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    warning_count = len(module.module._warnings)
+    result = module.request('test', method='POST', payload='{"value": 1}')
+    assert result == {'ok': True}
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert [call[1]['data'] for call in fetch.call_args_list] == ['{"value": 1}'] * 3
+    assert [call[1]['method'] for call in fetch.call_args_list] == ['POST'] * 3
+    assert sleep.call_count == 2
+    assert len(module.module._warnings) == warning_count + 1
