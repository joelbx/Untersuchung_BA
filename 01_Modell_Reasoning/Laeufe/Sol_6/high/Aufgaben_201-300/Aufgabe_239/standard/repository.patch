 }
 
+const linkStateLifetime = 10 * time.Minute
+
+func (s *Router) signLinkState(userId string, issuedAt int64) string {
+	payload := base64.RawURLEncoding.EncodeToString([]byte(userId)) + "." + strconv.FormatInt(issuedAt, 10)
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(payload))
+	return payload + "." + hex.EncodeToString(mac.Sum(nil))
+}
+
+func (s *Router) userFromLinkState(state string) (string, bool) {
+	parts := strings.Split(state, ".")
+	if len(parts) != 3 || s.secret == "" {
+		return "", false
+	}
+	issuedAt, err := strconv.ParseInt(parts[1], 10, 64)
+	if err != nil || issuedAt > time.Now().Unix() || time.Since(time.Unix(issuedAt, 0)) > linkStateLifetime {
+		return "", false
+	}
+	userId, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil || len(userId) == 0 {
+		return "", false
+	}
+	signature, err := hex.DecodeString(parts[2])
+	if err != nil {
+		return "", false
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write([]byte(parts[0] + "." + parts[1]))
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", false
+	}
+	return string(userId), true
+}
+
