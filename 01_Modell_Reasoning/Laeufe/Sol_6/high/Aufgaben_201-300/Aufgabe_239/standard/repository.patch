+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	It("uses the explicit user ID for reads, updates, and deletes", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "context-user"})
+		props := NewUserPropsRepository(ctx, orm.NewOrm())
+		key := "user-props-isolation"
+
+		Expect(props.Put("user-a", key, "a")).To(Succeed())
+		Expect(props.Put("user-b", key, "b")).To(Succeed())
+		Expect(props.Get("user-a", key)).To(Equal("a"))
+		Expect(props.Get("user-b", key)).To(Equal("b"))
+		Expect(props.DefaultGet("context-user", key, "default")).To(Equal("default"))
+
+		Expect(props.Put("user-a", key, "updated")).To(Succeed())
+		Expect(props.Get("user-a", key)).To(Equal("updated"))
+		Expect(props.Get("user-b", key)).To(Equal("b"))
+
+		Expect(props.Delete("user-a", key)).To(Succeed())
+		_, err := props.Get("user-a", key)
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(props.Get("user-b", key)).To(Equal("b"))
+		Expect(props.Delete("user-b", key)).To(Succeed())
+		Expect(props.Put("", key, "invalid")).To(Equal(model.ErrInvalidAuth))
+		_, err = props.DefaultGet("", key, "default")
+		Expect(err).To(Equal(model.ErrInvalidAuth))
+	})
+})
