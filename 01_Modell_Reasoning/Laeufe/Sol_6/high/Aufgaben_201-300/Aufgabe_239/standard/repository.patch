+package tests
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestMockedUserPropsRepoScopesCompositeKeys(t *testing.T) {
+	p := &MockedUserPropsRepo{}
+	if err := p.Put("a_b", "c", "first"); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.Put("a", "b_c", "second"); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ user, key, want string }{
+		{"a_b", "c", "first"},
+		{"a", "b_c", "second"},
+	} {
+		got, err := p.DefaultGet(tc.user, tc.key, "missing")
+		if err != nil || got != tc.want {
+			t.Fatalf("DefaultGet(%q, %q) = %q, %v; want %q", tc.user, tc.key, got, err, tc.want)
+		}
+	}
+	if err := p.Delete("a_b", "c"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Get("a_b", "c"); err != model.ErrNotFound {
+		t.Fatalf("deleted property error = %v; want ErrNotFound", err)
+	}
+	if got, err := p.Get("a", "b_c"); err != nil || got != "second" {
+		t.Fatalf("other user's property = %q, %v", got, err)
+	}
+	if err := p.Put("", "key", "value"); err != model.ErrInvalidAuth {
+		t.Fatalf("empty user ID error = %v; want ErrInvalidAuth", err)
+	}
+}
