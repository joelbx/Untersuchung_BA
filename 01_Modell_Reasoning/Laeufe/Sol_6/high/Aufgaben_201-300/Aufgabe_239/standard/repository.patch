diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..673a1ae
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,92 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("LastFM link routing", func() {
+	var router *Router
+	var props model.UserPropsRepository
+
+	BeforeEach(func() {
+		ds := &tests.MockDataStore{}
+		router = &Router{sessionKeys: &sessionKeys{ds: ds}, secret: "lastfm-test-secret"}
+		props = ds.UserProps(context.Background())
+	})
+
+	It("issues a state for the authenticated user and rejects altered or expired states", func() {
+		ctx := request.WithUser(context.Background(), model.User{ID: "user-a"})
+		req := httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx)
+		resp := httptest.NewRecorder()
+		router.getLinkStatus(resp, req)
+		Expect(resp.Code).To(Equal(http.StatusOK))
+		var payload map[string]interface{}
+		Expect(json.Unmarshal(resp.Body.Bytes(), &payload)).To(Succeed())
+		state, ok := payload["state"].(string)
+		Expect(ok).To(BeTrue())
+		userId, valid := router.userFromLinkState(state)
+		Expect(valid).To(BeTrue())
+		Expect(userId).To(Equal("user-a"))
+		_, valid = router.userFromLinkState(state + "x")
+		Expect(valid).To(BeFalse())
+		_, valid = router.userFromLinkState(router.signLinkState("user-a", time.Now().Add(-linkStateLifetime-time.Minute).Unix()))
+		Expect(valid).To(BeFalse())
+
+		unauthenticated := httptest.NewRecorder()
+		router.getLinkStatus(unauthenticated, httptest.NewRequest(http.MethodGet, "/link", nil))
+		Expect(unauthenticated.Code).To(Equal(http.StatusUnauthorized))
+	})
+
+	It("reports and unlinks only the authenticated user's session", func() {
+		Expect(props.Put("user-a", sessionKeyProperty, "SK-A")).To(Succeed())
+		Expect(props.Put("user-b", sessionKeyProperty, "SK-B")).To(Succeed())
+		ctx := request.WithUser(context.Background(), model.User{ID: "user-a"})
+
+		status := httptest.NewRecorder()
+		router.getLinkStatus(status, httptest.NewRequest(http.MethodGet, "/link", nil).WithContext(ctx))
+		Expect(status.Code).To(Equal(http.StatusOK))
+		Expect(strings.Contains(status.Body.String(), `"status":true`)).To(BeTrue())
+
+		unlink := httptest.NewRecorder()
+		router.unlink(unlink, httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+		Expect(unlink.Code).To(Equal(http.StatusOK))
+		_, err := props.Get("user-a", sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(props.Get("user-b", sessionKeyProperty)).To(Equal("SK-B"))
+	})
+
+	It("persists the callback session for the signed user instead of a supplied uid", func() {
+		httpClient := &tests.FakeHttpClient{Res: http.Response{
+			Body:       ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"SK-A"}}`)),
+			StatusCode: http.StatusOK,
+		}}
+		router.client = NewClient("API_KEY", router.secret, "en", httpClient)
+		state := router.signLinkState("user-a", time.Now().Unix())
+		callbackURL := "/link/callback?token=TOKEN&uid=user-b&state=" + url.QueryEscape(state)
+		resp := httptest.NewRecorder()
+		router.callback(resp, httptest.NewRequest(http.MethodGet, callbackURL, nil))
+		Expect(resp.Code).To(Equal(http.StatusOK))
+		Expect(props.Get("user-a", sessionKeyProperty)).To(Equal("SK-A"))
+		_, err := props.Get("user-b", sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+
+		invalid := httptest.NewRecorder()
+		router.callback(invalid, httptest.NewRequest(http.MethodGet, "/link/callback?token=TOKEN&uid=user-b", nil))
+		Expect(invalid.Code).To(Equal(http.StatusBadRequest))
+		Expect(httpClient.RequestCount).To(Equal(1))
+	})
+})
