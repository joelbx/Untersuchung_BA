@@ -1,5 +1,7 @@
 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,149 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment is implemented by the two supported rule segment representations.
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct {
+	Segment IsSegment
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil {
+		return nil, fmt.Errorf("missing rule segment")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v != "" {
+			return string(v), nil
+		}
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, err
+		}
+		if len(v.Keys) == 1 {
+			v.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		return v, nil
+	}
+	return nil, fmt.Errorf("invalid rule segment %T", s.Segment)
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		if v == "" {
+			return fmt.Errorf("empty rule segment")
+		}
+		s.Segment = SegmentKey(v)
+		return nil
+	case map[interface{}]interface{}:
+		object := make(map[string]interface{}, len(v))
+		for key, value := range v {
+			name, ok := key.(string)
+			if !ok {
+				return fmt.Errorf("rule segment fields must be strings")
+			}
+			object[name] = value
+		}
+		return s.unmarshalObject(object)
+	case map[string]interface{}:
+		return s.unmarshalObject(v)
+	}
+	return fmt.Errorf("rule segment must be a string or keys/operator object")
+}
+
+func (s *SegmentEmbed) unmarshalObject(v map[string]interface{}) error {
+	if len(v) != 2 {
+		return fmt.Errorf("rule segment must contain keys and operator")
+	}
+	keys, hasKeys := v["keys"]
+	op, hasOperator := v["operator"]
+	if !hasKeys || !hasOperator {
+		return fmt.Errorf("rule segment must contain keys and operator")
+	}
+	list, ok := keys.([]interface{})
+	if !ok {
+		return fmt.Errorf("rule segment keys must be a list")
+	}
+	segments := Segments{Keys: make([]string, 0, len(list))}
+	for _, key := range list {
+		value, ok := key.(string)
+		if !ok || value == "" {
+			return fmt.Errorf("rule segment keys must be nonempty strings")
+		}
+		segments.Keys = append(segments.Keys, value)
+	}
+	if len(segments.Keys) == 1 {
+		segments.SegmentOperator = "OR_SEGMENT_OPERATOR"
+	} else {
+		segments.SegmentOperator, ok = op.(string)
+		if !ok {
+			return fmt.Errorf("rule segment operator must be a string")
+		}
+	}
+	if err := validateSegments(segments); err != nil {
+		return err
+	}
+	s.Segment = segments
+	return nil
+}
+
+func validateSegments(s Segments) error {
+	if len(s.Keys) == 0 {
+		return fmt.Errorf("rule segment requires at least one key")
+	}
+	for _, key := range s.Keys {
+		if key == "" {
+			return fmt.Errorf("rule segment keys must be nonempty strings")
+		}
+	}
+	if len(s.Keys) > 1 && s.SegmentOperator != "AND_SEGMENT_OPERATOR" && s.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid rule segment operator %q", s.SegmentOperator)
+	}
+	return nil
+}
+
+// RuleSegment returns the keys and effective operator for a rule segment.
+func (s *SegmentEmbed) RuleSegment() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("missing rule segment")
+	}
+	switch v := s.Segment.(type) {
+	case SegmentKey:
+		if v != "" {
+			return []string{string(v)}, "OR_SEGMENT_OPERATOR", nil
+		}
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, "", err
+		}
+		if len(v.Keys) == 1 {
+			return v.Keys, "OR_SEGMENT_OPERATOR", nil
+		}
+		return v.Keys, v.SegmentOperator, nil
+	}
+	return nil, "", fmt.Errorf("invalid rule segment %T", s.Segment)
 }
 
