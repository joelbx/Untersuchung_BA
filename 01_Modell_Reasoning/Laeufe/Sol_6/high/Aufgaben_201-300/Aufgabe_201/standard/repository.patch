index 0000000..b900031
--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,73 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	yamlv2 "gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestRuleSegmentYAML(t *testing.T) {
+	cases := []struct {
+		name, input string
+		keys        []string
+		operator    string
+		valid       bool
+	}{
+		{"string", "segment: foo", []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{"group", "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR", []string{"foo", "bar"}, "AND_SEGMENT_OPERATOR", true},
+		{"single key fallback", "segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR", []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{"single key ignores operator", "segment:\n  keys: [foo]\n  operator: 123", []string{"foo"}, "OR_SEGMENT_OPERATOR", true},
+		{"empty string", "segment: ''", nil, "", false},
+		{"list", "segment: [foo, bar]", nil, "", false},
+		{"empty keys", "segment:\n  keys: []\n  operator: OR_SEGMENT_OPERATOR", nil, "", false},
+		{"missing operator", "segment:\n  keys: [foo, bar]", nil, "", false},
+		{"invalid operator", "segment:\n  keys: [foo, bar]\n  operator: INVALID", nil, "", false},
+		{"extra field", "segment:\n  keys: [foo]\n  operator: OR_SEGMENT_OPERATOR\n  other: x", nil, "", false},
+	}
+	for _, decode := range []struct {
+		name      string
+		unmarshal func([]byte, interface{}) error
+	}{
+		{"v2", yamlv2.Unmarshal}, {"v3", yamlv3.Unmarshal},
+	} {
+		t.Run(decode.name, func(t *testing.T) {
+			for _, tc := range cases {
+				t.Run(tc.name, func(t *testing.T) {
+					var rule Rule
+					err := decode.unmarshal([]byte(tc.input), &rule)
+					if !tc.valid {
+						require.Error(t, err)
+						return
+					}
+					require.NoError(t, err)
+					keys, operator, err := rule.Segment.RuleSegment()
+					require.NoError(t, err)
+					require.Equal(t, tc.keys, keys)
+					require.Equal(t, tc.operator, operator)
+				})
+			}
+		})
+	}
+}
+
+func TestSegmentEmbedMarshal(t *testing.T) {
+	for _, tc := range []struct {
+		segment IsSegment
+		want    string
+	}{
+		{SegmentKey("foo"), "foo"},
+		{Segments{Keys: []string{"foo"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}, "OR_SEGMENT_OPERATOR"},
+	} {
+		value, err := (&SegmentEmbed{Segment: tc.segment}).MarshalYAML()
+		require.NoError(t, err)
+		if group, ok := value.(Segments); ok {
+			require.Equal(t, tc.want, group.SegmentOperator)
+		} else {
+			require.Equal(t, tc.want, value)
+		}
+	}
+	_, err := (&SegmentEmbed{}).MarshalYAML()
+	require.Error(t, err)
+}
