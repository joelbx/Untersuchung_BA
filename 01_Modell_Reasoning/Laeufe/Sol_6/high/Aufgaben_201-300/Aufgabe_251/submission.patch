+// errorLocation prefers a source position in the YAML file. CUE also includes
+// schema positions in InputPositions, often before the offending YAML field.
+func errorLocation(file string, e cueerror.Error) Location {
+	for _, p := range e.InputPositions() {
+		if pos := p.Position(); p.IsValid() && pos.Filename == file && pos.Line > 0 {
+			return Location{File: file, Line: pos.Line, Column: pos.Column}
 		}
+	}
+	positions := append([]token.Pos{e.Position()}, e.InputPositions()...)
+	for _, p := range positions {
+		if pos := p.Position(); p.IsValid() && pos.Filename != "" && pos.Line > 0 {
+			return Location{File: pos.Filename, Line: pos.Line, Column: pos.Column}
+		}
+	}
+	return Location{File: file}
+}
 
