 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	tests := []struct {
+		name       string
+		extra      string
+		summary    string
+		optional   map[string]string
+		fixedIn    string
+		cvssScore  float64
+		cvssVector string
+		cvssLevel  string
+	}{
+		{
+			name:       "enterprise",
+			extra:      `,"fixed_in":"6.0.8","description":"A detailed summary","poc":"https://example.org/poc","introduced_in":"6.0.0","cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","severity":"HIGH"}`,
+			summary:    "A detailed summary",
+			optional:   map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.0.0"},
+			fixedIn:    "6.0.8",
+			cvssScore:  7.5,
+			cvssVector: "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N",
+			cvssLevel:  "HIGH",
+		},
+		{name: "basic absent", optional: map[string]string{}},
+		{name: "basic null", extra: `,"fixed_in":null,"description":null,"poc":null,"introduced_in":null,"cvss":null`, optional: map[string]string{}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"607":{"vulnerabilities":[{"id":"123","title":"Example issue","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-05:00","vuln_type":"XSS","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/second","https://example.org/first"]}` + tt.extra + `}]}}`
+			got, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := []models.VulnInfo{{
+				CveID: "CVE-2024-1234",
+				CveContents: models.NewCveContents(models.CveContent{
+					Type:          models.WpScan,
+					CveID:         "CVE-2024-1234",
+					Title:         "Example issue",
+					Summary:       tt.summary,
+					Cvss3Score:    tt.cvssScore,
+					Cvss3Vector:   tt.cvssVector,
+					Cvss3Severity: tt.cvssLevel,
+					References: models.References{
+						{Link: "https://example.org/second"},
+						{Link: "https://example.org/first"},
+					},
+					Published:    time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC),
+					LastModified: time.Date(2024, 2, 3, 9, 5, 6, 0, time.UTC),
+					Optional:     tt.optional,
+				}),
+				VulnType:    "XSS",
+				Confidences: []models.Confidence{models.WpScanMatch},
+				WpPackageFixStats: []models.WpPackageFixStatus{{
+					Name: "core", FixedIn: tt.fixedIn,
+				}},
+			}}
+			if !reflect.DeepEqual(got, want) {
+				t.Errorf("convertToVinfos() = %#v, want %#v", got, want)
+			}
+		})
+	}
+}
