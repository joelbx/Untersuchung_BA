@@ -0,0 +1,30 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/navidrome/navidrome/model"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("albumImageFiles", func() {
+	It("collects every image from the album's directories in sorted directory order", func() {
+		files := model.MediaFiles{
+			{Path: filepath.Join("music", "disc2", "song.mp3")},
+			{Path: filepath.Join("music", "disc1", "song.mp3")},
+			{Path: filepath.Join("music", "disc2", "other.mp3")},
+		}
+		dirs := dirMap{
+			filepath.Join("music", "disc1"): {ImageFiles: []string{"cover.jpg", "back.png"}},
+			filepath.Join("music", "disc2"): {ImageFiles: []string{"highres.png"}},
+			filepath.Join("music", "other"): {ImageFiles: []string{"unrelated.jpg"}},
+		}
+		Expect(strings.Split(albumImageFiles(files, dirs), string(filepath.ListSeparator))).To(Equal([]string{
+			filepath.Join("music", "disc1", "cover.jpg"),
+			filepath.Join("music", "disc1", "back.png"),
+			filepath.Join("music", "disc2", "highres.png"),
+		}))
+	})
+})
