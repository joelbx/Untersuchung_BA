 	"testing"
 
 	"github.com/navidrome/navidrome/log"
@@ -10,6 +12,48 @@ import (
 	. "github.com/onsi/gomega"
 )
 
+func TestSQLiteDSN(t *testing.T) {
+	dsn := sqliteDSN(filepath.Join(t.TempDir(), "navidrome.db") + "?mode=rwc&_foreign_keys=off")
+	parsed, err := url.Parse(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]string{
+		"mode": "rwc", "cache": "shared", "_cache_size": "1000000000",
+		"_busy_timeout": "5000", "_journal_mode": "WAL",
+		"_synchronous": "NORMAL", "_foreign_keys": "on", "_txlock": "immediate",
+	} {
+		if got := parsed.Query().Get(key); got != want {
+			t.Errorf("%s = %q, want %q", key, got, want)
+		}
+	}
+
+	conn, err := sql.Open(Driver, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for pragma, want := range map[string]int{
+		"busy_timeout": 5000, "cache_size": 1000000000,
+		"foreign_keys": 1, "synchronous": 1,
+	} {
+		var got int
+		if err := conn.QueryRow("PRAGMA " + pragma).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != want {
+			t.Errorf("PRAGMA %s = %d, want %d", pragma, got, want)
+		}
+	}
+	var journalMode string
+	if err := conn.QueryRow("PRAGMA journal_mode").Scan(&journalMode); err != nil {
+		t.Fatal(err)
+	}
+	if journalMode != "wal" {
+		t.Errorf("PRAGMA journal_mode = %q, want wal", journalMode)
+	}
+}
+
