+// redactValue preserves map keys while redacting their values, including
+// values in nested maps. Other non-string values use Go's default formatting.
+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		redacted := make(map[interface{}]interface{}, v.Len())
+		iter := v.MapRange()
+		for iter.Next() {
+			key := iter.Key().Interface()
+			if re.MatchString(fmt.Sprint(key)) || sensitiveField.MatchString(fmt.Sprint(key)) {
+				redacted[key] = "[REDACTED]"
+			} else {
+				redacted[key] = redactValue(iter.Value().Interface(), re)
+			}
+		}
+		// Keep the common map types intact for callers that inspect log fields.
+		switch value.(type) {
+		case map[string]interface{}, logrus.Fields:
+			result := make(map[string]interface{}, len(redacted))
+			for key, val := range redacted {
+				result[key.(string)] = val
+			}
+			return result
+		case map[string]string:
+			result := make(map[string]string, len(redacted))
+			for key, val := range redacted {
+				result[key.(string)] = fmt.Sprint(val)
+			}
+			return result
+		}
+		return redacted
+	}
+	if s, ok := value.(string); ok {
+		return re.ReplaceAllString(s, "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprintf("%v", value), "$1[REDACTED]$2")
+}
+
+var sensitiveField = regexp.MustCompile(`(?i)^(?:token|subsonictoken|subsonicsalt|secret|password|apikey|authorization|cookie|set-cookie|jwt)$`)
+
