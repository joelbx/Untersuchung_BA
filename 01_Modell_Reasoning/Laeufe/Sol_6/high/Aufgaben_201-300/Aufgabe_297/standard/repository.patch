+func TestValidateIPAgainstList(t *testing.T) {
+	tests := []struct {
+		address, list string
+		want          bool
+	}{
+		{"192.0.2.3:1234", "", false},
+		{"192.0.2.3:1234", "bad, 192.0.2.0/24", true},
+		{"192.0.3.3:1234", "192.0.2.0/24", false},
+		{"[2001:db8::1]:1234", "bad, 2001:db8::/32", true},
+		{"[2001:db9::1]:1234", "2001:db8::/32", false},
+		{"192.0.2.3:1234", "192.0.2.3:8080", true},
+		{"@", "@", true},
+		{"@", "0.0.0.0/0", false},
+	}
+	for _, tc := range tests {
+		if got := validateIPAgainstList(tc.address, tc.list); got != tc.want {
+			t.Errorf("validateIPAgainstList(%q, %q) = %v, want %v", tc.address, tc.list, got, tc.want)
+		}
+	}
+}
+
+type loginTrackingRepo struct {
+	*tests.MockedUserRepo
+	lastLoginID string
+}
+
+func (r *loginTrackingRepo) UpdateLastLoginAt(id string) error {
+	r.lastLoginID = id
+	return nil
+}
+
+func TestHandleLoginFromHeaders(t *testing.T) {
+	previousList, previousHeader := conf.Server.ReverseProxyWhitelist, conf.Server.ReverseProxyUserHeader
+	defer func() {
+		conf.Server.ReverseProxyWhitelist = previousList
+		conf.Server.ReverseProxyUserHeader = previousHeader
+	}()
+	repo := &loginTrackingRepo{MockedUserRepo: tests.CreateMockUserRepo()}
+	ds := &tests.MockDataStore{MockedUser: repo}
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	conf.Server.ReverseProxyUserHeader = "X-Proxy-User"
+	req := httptest.NewRequest("GET", "/app/", nil)
+	req.RemoteAddr = "198.51.100.1:1234"
+	req.Header.Set("X-Proxy-User", "alice")
+	if got := handleLoginFromHeaders(ds, req); got != nil {
+		t.Fatal("untrusted IP received credentials")
+	}
+	req.RemoteAddr = "192.0.2.1:1234"
+	login := handleLoginFromHeaders(ds, req)
+	if login == nil || login["username"] != "alice" || login["isAdmin"] != true {
+		t.Fatalf("unexpected first login payload: %v", login)
+	}
+	if repo.lastLoginID != login["id"] {
+		t.Fatal("LastLoginAt was not updated")
+	}
+	if _, err := auth.Validate(login["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	if login["subsonicSalt"] == "" || login["subsonicToken"] == "" {
+		t.Fatal("missing Subsonic credentials")
+	}
+	req.RemoteAddr = "@"
+	conf.Server.ReverseProxyWhitelist = "0.0.0.0/0"
+	if got := handleLoginFromHeaders(ds, req); got != nil {
+		t.Fatal("unix socket request received credentials without @ whitelist")
+	}
+	req.RemoteAddr = "192.0.2.1:1234"
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24"
+	req.Header.Del("X-Proxy-User")
+	if got := handleLoginFromHeaders(ds, req); got != nil {
+		t.Fatal("missing user header received credentials")
+	}
+}
