+// validateIPAgainstList checks the actual connection address. Forwarded headers
+// cannot be used here because clients can supply them themselves.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteAddr = host
+	}
+	ip := net.ParseIP(strings.Trim(remoteAddr, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		if host, _, err := net.SplitHostPort(entry); err == nil {
+			entry = host
+		}
+		entry = strings.Trim(entry, "[]")
+		if !strings.Contains(entry, "/") {
+			if listed := net.ParseIP(entry); listed != nil && listed.Equal(ip) {
+				return true
+			}
+			continue
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil && network.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// handleLoginFromHeaders returns a session only for a user asserted by a
+// configured, trusted proxy. A first-time proxy user becomes the initial admin.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for proxy login", countErr)
+			return nil
+		}
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: strings.Title(username), IsAdmin: count == 0, NewPassword: uuid.NewString()}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Could not create proxy user", err)
+			return nil
+		}
+		// Put persists NewPassword but does not populate Password on the model.
+		user, err = repo.FindByUsername(username)
+		if err != nil || user == nil {
+			log.Error(r, "Could not reload proxy user", err)
+			return nil
+		}
+	} else if err != nil || user == nil {
+		log.Error(r, "Could not find proxy user", err)
+		return nil
+	}
+	if err := repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update LastLoginAt", "user", user.UserName, err)
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create proxy session", err)
+		return nil
+	}
+	salt := uuid.NewString()
+	return map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token,
+		"subsonicSalt":  salt,
+		"subsonicToken": fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt))),
+	}
 }
 
