+package config
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	codes := []string{"sS", "ST", "sa", "SW", "sm", "SN", "sf", "sX", "invalid"}
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas, NotSupportTechnique}
+	conf := PortScanConf{ScanTechniques: codes}
+	if got := conf.GetScanTechniques(); !reflect.DeepEqual(got, want) {
+		t.Fatalf("techniques: got %v, want %v", got, want)
+	}
+	for i, technique := range want[:8] {
+		if !strings.EqualFold(technique.String(), codes[i]) {
+			t.Errorf("code for %v: %s", technique, technique.String())
+		}
+	}
+	if len((&PortScanConf{}).GetScanTechniques()) != 0 {
+		t.Fatal("empty configuration should have no techniques")
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"invalid"}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{NotSupportTechnique}) {
+		t.Fatalf("unsupported technique: %v", got)
+	}
+}
+
+func TestPortScanValidate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name      string
+		conf      PortScanConf
+		wantError bool
+	}{
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, false},
+		{"missing path", PortScanConf{ScannerBinPath: path + "missing"}, true},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"foo"}}, true},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sA"}}, true},
+		{"privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, true},
+		{"connect source", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, true},
+		{"negative source", PortScanConf{ScannerBinPath: path, SourcePort: "-1"}, true},
+		{"zero source", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, true},
+		{"high source", PortScanConf{ScannerBinPath: path, SourcePort: "65536"}, true},
+		{"nonnumeric source", PortScanConf{ScannerBinPath: path, SourcePort: "abc"}, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := len(tc.conf.Validate()) > 0; got != tc.wantError {
+				t.Fatalf("Validate() errors = %v", tc.conf.Validate())
+			}
+		})
+	}
+}
+
+func TestPortScanIsZero(t *testing.T) {
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("empty config is not zero")
+	}
+	for _, conf := range []PortScanConf{{ScannerBinPath: "nmap"}, {ScanTechniques: []string{"sT"}}, {SourcePort: "80"}, {HasPrivileged: true}} {
+		if conf.IsZero() {
+			t.Fatalf("nonempty config is zero: %+v", conf)
+		}
+	}
+}
+
+func TestPortScanTOMLLoadingAndValidation(t *testing.T) {
+	old := Conf
+	defer func() { Conf = old }()
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name        string
+		settings    string
+		useExternal bool
+		valid       bool
+	}{
+		{"native", "", false, true},
+		{"external", "scannerBinPath = \"" + path + "\"\nscanTechniques = [\"sT\"]\n", true, true},
+		{"bad source", "scannerBinPath = \"" + path + "\"\nscanTechniques = [\"sT\"]\nsourcePort = \"65536\"\n", true, false},
+		{"unsupported", "scannerBinPath = \"" + path + "\"\nscanTechniques = [\"bad\"]\n", true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			Conf = Config{}
+			file := filepath.Join(t.TempDir(), "config.toml")
+			contents := "[servers.example]\nhost = \"192.0.2.1\"\nuser = \"root\"\nscanModules = [\"ospkg\", \"port\"]\n"
+			if tc.settings != "" {
+				contents += "[servers.example.portscan]\n" + tc.settings
+			}
+			if err := os.WriteFile(file, []byte(contents), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if err := (TOMLLoader{}).Load(file, ""); err != nil {
+				t.Fatal(err)
+			}
+			server := Conf.Servers["example"]
+			if server.PortScan != nil && server.PortScan.IsUseExternalScanner != tc.useExternal || server.PortScan == nil && tc.useExternal {
+				t.Fatalf("external scanner flag: %+v", server.PortScan)
+			}
+			if got := len(Conf.checkPortScan()) == 0; got != tc.valid {
+				t.Fatalf("portscan validation: %v", Conf.checkPortScan())
+			}
+		})
+	}
+}
+
+func TestHasNmapCapabilities(t *testing.T) {
+	for _, tc := range []struct {
+		output string
+		want   bool
+	}{
+		{"/usr/bin/nmap cap_net_admin,cap_net_raw=ep", true},
+		{"/usr/bin/nmap = cap_net_admin,cap_net_raw+ep", true},
+		{"/usr/bin/nmap cap_net_raw=ep cap_net_admin=p", false},
+		{"/usr/bin/nmap cap_net_raw=ep", false},
+		{"malformed", false},
+	} {
+		if got := hasNmapCapabilities("/usr/bin/nmap", tc.output); got != tc.want {
+			t.Errorf("hasNmapCapabilities(%q) = %v", tc.output, got)
+		}
+	}
+}
