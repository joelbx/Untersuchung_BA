diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..c33c813
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,132 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+)
+
+// setScanTechniques translates the configured technique to nmap arguments.
+func setScanTechniques(c config.PortScanConf) ([]string, error) {
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		return nil, fmt.Errorf("multiple scan techniques are not supported")
+	}
+	if len(techniques) == 0 {
+		if !c.HasPrivileged {
+			return []string{"-sT"}, nil
+		}
+		return nil, nil
+	}
+	if techniques[0] == config.NotSupportTechnique {
+		return nil, fmt.Errorf("unsupported scan technique %q", c.ScanTechniques[0])
+	}
+	return []string{"-" + techniques[0].String()}, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+type nmapResult struct {
+	Hosts []struct {
+		Addresses []struct {
+			Address string `xml:"addr,attr"`
+			Type    string `xml:"addrtype,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				Name string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	c := l.ServerInfo.PortScan
+	if c == nil || c.ScannerBinPath == "" {
+		return nil, fmt.Errorf("external scanner path is empty")
+	}
+	if errs := c.Validate(); len(errs) > 0 {
+		return nil, errs[0]
+	}
+	techniqueOptions, err := setScanTechniques(*c)
+	if err != nil {
+		return nil, err
+	}
+	open := []string{}
+	for ip, ports := range scanDestIPPorts {
+		parsedIP := net.ParseIP(ip)
+		if parsedIP == nil {
+			return nil, fmt.Errorf("invalid port scan address %q", ip)
+		}
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && parsedIP.IsLoopback() {
+			continue
+		}
+		unique := make(map[string]bool)
+		validPorts := []string{}
+		for _, port := range ports {
+			n, parseErr := strconv.Atoi(port)
+			if parseErr != nil || n < 1 || n > 65535 {
+				return nil, fmt.Errorf("invalid port scan port %q", port)
+			}
+			if !unique[port] {
+				unique[port] = true
+				validPorts = append(validPorts, port)
+			}
+		}
+		if len(validPorts) == 0 {
+			continue
+		}
+		sort.Slice(validPorts, func(i, j int) bool {
+			left, _ := strconv.Atoi(validPorts[i])
+			right, _ := strconv.Atoi(validPorts[j])
+			return left < right
+		})
+		options := []string{"-Pn", "-n", "-oX", "-"}
+		if c.HasPrivileged {
+			options = append(options, "--privileged")
+		}
+		if parsedIP.To4() == nil {
+			options = append(options, "-6")
+		}
+		options = append(options, techniqueOptions...)
+		if c.SourcePort != "" {
+			options = append(options, "-g", c.SourcePort)
+		}
+		options = append(options, "-p", strings.Join(validPorts, ","), ip)
+		output, scanErr := osExec.Command(c.ScannerBinPath, options...).Output()
+		if scanErr != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed (%s): %w", ip, formatNmapOptionsToString(options), scanErr)
+		}
+		var result nmapResult
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("parse nmap output for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			matchesTarget := false
+			for _, addr := range host.Addresses {
+				if address := net.ParseIP(addr.Address); address != nil && address.Equal(parsedIP) && (addr.Type == "ipv4" || addr.Type == "ipv6" || addr.Type == "") {
+					matchesTarget = true
+				}
+			}
+			if !matchesTarget {
+				continue
+			}
+			for _, port := range host.Ports {
+				if port.Protocol == "tcp" && port.State.Name == "open" && unique[port.PortID] {
+					open = append(open, ip+":"+port.PortID)
+				}
+			}
+		}
+	}
+	return open, nil
+}
