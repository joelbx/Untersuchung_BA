+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestSetScanTechniques(t *testing.T) {
+	for _, tc := range []struct {
+		conf      config.PortScanConf
+		want      string
+		wantError bool
+	}{
+		{config.PortScanConf{}, "-sT", false},
+		{config.PortScanConf{ScanTechniques: []string{"sS"}}, "-sS", false},
+		{config.PortScanConf{ScanTechniques: []string{"other"}}, "", true},
+		{config.PortScanConf{ScanTechniques: []string{"sS", "sT"}}, "", true},
+	} {
+		got, err := setScanTechniques(tc.conf)
+		if (err != nil) != tc.wantError || (!tc.wantError && formatNmapOptionsToString(got) != tc.want) {
+			t.Errorf("setScanTechniques(%+v) = %v, %v", tc.conf, got, err)
+		}
+	}
+}
+
+func TestExternalPortScanParsesOpenPorts(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	script := `#!/bin/sh
+case " $* " in
+  *" -sT -p 80,443 "* ) ;;
+  * ) exit 13 ;;
+esac
+cat <<'XML'
+<?xml version="1.0"?>
+<nmaprun><host><address addr="192.0.2.1" addrtype="ipv4"/><ports>
+<port protocol="tcp" portid="80"><state state="open"/></port>
+<port protocol="tcp" portid="443"><state state="closed"/></port>
+</ports></host></nmaprun>
+XML
+`
+	if err := os.WriteFile(path, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{
+		ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true,
+	}}}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"443", "80"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.1:80"}) {
+		t.Fatalf("open ports: %v", got)
+	}
+	if _, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"bad"}}); err == nil || !strings.Contains(err.Error(), "invalid port") {
+		t.Fatalf("invalid port error: %v", err)
+	}
+}
