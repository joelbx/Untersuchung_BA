diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..dd3bd4b
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,149 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is an nmap TCP scan type.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures an external scanner on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	for _, value := range c.ScanTechniques {
+		technique := NotSupportTechnique
+		for _, candidate := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(value, candidate.String()) {
+				technique = candidate
+				break
+			}
+		}
+		scanTechniques = append(scanTechniques, technique)
+	}
+	return scanTechniques
+}
+
+// Validate checks external scanner settings before a port scan starts.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath is required for external scanning"))
+	}
+	var pathErr error
+	if c.ScannerBinPath != "" {
+		info, err := os.Stat(c.ScannerBinPath)
+		pathErr = err
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q: %w", c.ScannerBinPath, err))
+		} else if !info.Mode().IsRegular() || info.Mode()&0111 == 0 {
+			errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q is not an executable file", c.ScannerBinPath))
+		}
+	}
+
+	techniques := (&c).GetScanTechniques()
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported portscan.scanTechniques entry %q", c.ScanTechniques[i]))
+		}
+	}
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple portscan.scanTechniques are not supported"))
+	}
+	if !c.HasPrivileged && len(techniques) == 1 && techniques[0] != TCPConnect && techniques[0] != NotSupportTechnique {
+		errs = append(errs, fmt.Errorf("portscan.scanTechniques %s requires hasPrivileged", techniques[0]))
+	}
+	if c.SourcePort != "" {
+		port, parseErr := strconv.Atoi(c.SourcePort)
+		if parseErr != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort must be an integer in [0,65535]: %q", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort 0 is not a usable source port"))
+		}
+		if (len(techniques) == 1 && techniques[0] == TCPConnect) || (!c.HasPrivileged && len(techniques) == 0) {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort cannot be used with TCPConnect"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && pathErr == nil && c.ScannerBinPath != "" {
+		output, capErr := exec.Command("getcap", c.ScannerBinPath).CombinedOutput()
+		if capErr != nil {
+			errs = append(errs, fmt.Errorf("cannot check scanner capabilities: %w: %s", capErr, strings.TrimSpace(string(output))))
+		} else {
+			caps := strings.TrimSpace(string(output))
+			if !hasNmapCapabilities(c.ScannerBinPath, caps) {
+				errs = append(errs, fmt.Errorf("scanner capabilities missing or malformed: %q (need cap_net_raw and cap_net_admin with effective permission)", caps))
+			}
+		}
+	}
+	return errs
+}
+
+func hasNmapCapabilities(path, output string) bool {
+	if !strings.HasPrefix(output, path+" ") {
+		return false
+	}
+	permissions := strings.TrimSpace(strings.TrimPrefix(output, path))
+	permissions = strings.TrimSpace(strings.TrimPrefix(permissions, "="))
+	found := map[string]bool{}
+	for _, group := range strings.Fields(permissions) {
+		separator := strings.IndexAny(group, "=+")
+		if separator < 1 || separator == len(group)-1 {
+			return false
+		}
+		if !strings.Contains(group[separator+1:], "e") {
+			continue
+		}
+		for _, capability := range strings.Split(group[:separator], ",") {
+			found[capability] = true
+		}
+	}
+	return found["cap_net_raw"] && found["cap_net_admin"]
+}
