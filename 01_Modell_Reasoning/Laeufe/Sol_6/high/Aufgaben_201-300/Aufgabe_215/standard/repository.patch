diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..7b9c044
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, dir, body string) string {
+	t.Helper()
+	path := filepath.Join(dir, "config.yml")
+	if err := ioutil.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	path := writeConfig(t, dir, "# defaults\n")
+	got, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := defaultConfig(); !reflect.DeepEqual(got, want) {
+		t.Fatalf("defaults: got %#v, want %#v", got, want)
+	}
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatal("unexpected scheme strings")
+	}
+
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, name := range []string{cert, key} {
+		if err := ioutil.WriteFile(name, []byte("test"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path = writeConfig(t, dir, "log:\n  level: WARN\nui:\n  enabled: false\ncors:\n  enabled: true\n  allowed_origins: foo.com\ncache:\n  memory:\n    enabled: true\n    items: 5000\nserver:\n  host: 127.0.0.1\n  protocol: https\n  http_port: 8081\n  https_port: 8080\n  grpc_port: 9001\n  cert_file: "+cert+"\n  cert_key: "+key+"\ndb:\n  url: postgres://postgres@localhost:5432/flipt?sslmode=disable\n  migrations:\n    path: ./config/migrations\n")
+	got, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.LogLevel != "WARN" || got.UI.Enabled || !got.Cors.Enabled || !reflect.DeepEqual(got.Cors.AllowedOrigins, []string{"foo.com"}) || !got.Cache.Memory.Enabled || got.Cache.Memory.Items != 5000 {
+		t.Fatalf("incorrect non-server settings: %#v", got)
+	}
+	if got.Server != (serverConfig{Host: "127.0.0.1", Protocol: HTTPS, HTTPPort: 8081, HTTPSPort: 8080, GRPCPort: 9001, CertFile: cert, CertKey: key}) {
+		t.Fatalf("incorrect server settings: %#v", got.Server)
+	}
+	if got.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || got.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("incorrect database settings: %#v", got.Database)
+	}
+
+	path = writeConfig(t, dir, "cors:\n  allowed_origins:\n    - foo.com\n")
+	got, err = configure(path)
+	if err != nil || !reflect.DeepEqual(got.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("list origins: got %#v, err %v", got, err)
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTP_PORT", "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTP_PORT")
+	got, err = configure(path)
+	if err != nil || got.Server.HTTPPort != 8181 {
+		t.Fatalf("environment override: got %#v, err %v", got, err)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	dir, err := ioutil.TempDir("", "flipt-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	missing := filepath.Join(dir, "missing")
+	cert := filepath.Join(dir, "cert")
+	if err := ioutil.WriteFile(cert, []byte("test"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		file, key, want string
+	}{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{cert, "", "cert_key cannot be empty when using HTTPS"},
+		{missing, cert, "cannot find TLS cert_file at \"" + missing + "\""},
+		{cert, missing, "cannot find TLS cert_key at \"" + missing + "\""},
+	}
+	for _, tc := range tests {
+		cfg := defaultConfig()
+		cfg.Server.Protocol = HTTPS
+		cfg.Server.CertFile = tc.file
+		cfg.Server.CertKey = tc.key
+		if err := cfg.validate(); err == nil || err.Error() != tc.want {
+			t.Errorf("validate(%q, %q): got %v, want %q", tc.file, tc.key, err, tc.want)
+		}
+	}
+	cfg := defaultConfig()
+	cfg.Server.CertFile = missing
+	if err := cfg.validate(); err != nil {
+		t.Fatalf("HTTP validation: %v", err)
+	}
+
+	path := writeConfig(t, dir, "server:\n  protocol: https\n")
+	if _, err := configure(path); err == nil || err.Error() != tests[0].want {
+		t.Fatalf("configure validation: %v", err)
+	}
+}
+
+func TestConfigAndInfoHandlers(t *testing.T) {
+	for _, handler := range []http.Handler{defaultConfig(), info{Version: "test"}} {
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, httptest.NewRequest("GET", "/", nil))
+		if response.Code != 200 || strings.TrimSpace(response.Body.String()) == "" {
+			t.Errorf("handler response: status %d, body %q", response.Code, response.Body.String())
+		}
+		if _, ok := handler.(*config); ok && !strings.Contains(response.Body.String(), `"protocol":"http"`) {
+			t.Errorf("config response has unexpected protocol: %q", response.Body.String())
+		}
+	}
+}
