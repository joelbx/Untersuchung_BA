+@pytest.mark.parametrize('cover', ['https://unsupported.test/cover.jpg', 'HTTP://COVERS.OPENLIBRARY.ORG/cover.jpg'])
+def test_load_only_uploads_allowed_cover(mock_site, monkeypatch, ia_writeback, cover):
+    upload = Mock(return_value=1234)
+    monkeypatch.setattr(add_book, 'add_cover', upload)
+    rec = {'title': 'Cover test', 'source_records': ['test:cover'], 'cover': cover}
+
+    reply = load(rec)
+
+    assert reply['success'] is True
+    edition = mock_site.get(reply['edition']['key'])
+    assert 'cover' not in edition
+    if cover.startswith('https://unsupported'):
+        upload.assert_not_called()
+        assert not edition.get('covers')
+    else:
+        upload.assert_called_once_with(cover, reply['edition']['key'], account_key=None)
+        assert edition['covers'] == [1234]
