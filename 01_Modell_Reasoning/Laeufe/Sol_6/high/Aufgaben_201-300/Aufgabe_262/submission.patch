+def process_cover_url(
+    edition: dict, allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS
+) -> tuple[str | None, dict]:
+    """Remove and return an HTTP(S) cover URL only for an allowed hostname."""
+    cover_url = edition.pop('cover', None)
+    if not isinstance(cover_url, str):
+        return None, edition
+
+    try:
+        parsed_url = urlsplit(cover_url)
+    except ValueError:
+        return None, edition
+
+    if parsed_url.scheme.lower() in ('http', 'https') and parsed_url.hostname in {
+        host.lower() for host in allowed_cover_hosts
+    }:
+        return cover_url, edition
+    return None, edition
+
