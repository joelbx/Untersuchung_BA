+def test_extract_external_symlink_as_regular_file(tmp_path):
+    artifact = to_bytes(tmp_path / 'collection.tar')
+    with tarfile.open(artifact, 'w') as archive:
+        data = b'outside content'
+        target = tarfile.TarInfo('../outside.txt')
+        target.size = len(data)
+        archive.addfile(target, BytesIO(data))
+        link = tarfile.TarInfo('link.txt')
+        link.type = tarfile.SYMTYPE
+        link.linkname = '../outside.txt'
+        archive.addfile(link)
+
+    destination = to_bytes(tmp_path / 'installed')
+    with tarfile.open(artifact) as archive:
+        collection._extract_tar_file(archive, 'link.txt', destination, to_bytes(tmp_path),
+                                     secure_hash_s(b'outside content', hash_func=sha256))
+    installed_file = os.path.join(destination, b'link.txt')
+    assert not os.path.islink(installed_file)
+    with open(installed_file, 'rb') as file_obj:
+        assert file_obj.read() == b'outside content'
+
+
+def test_extract_external_directory_symlink_as_directory(tmp_path):
