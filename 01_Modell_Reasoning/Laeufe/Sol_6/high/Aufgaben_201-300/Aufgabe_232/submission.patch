@@ -7,8 +7,14 @@ import (
 	"strings"
 
 	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/internal/version"
 )
 
+// Major returns the major version after an optional epoch prefix.
+func Major(value string) string {
+	return version.Major(value)
+}
+
 // GenWorkers generates goroutine
 // http://qiita.com/na-o-ys/items/65373132b1c5bc973cca
 func GenWorkers(num int) chan<- func() {
