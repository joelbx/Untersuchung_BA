+package util
+
+import "testing"
+
+func TestMajor(t *testing.T) {
+	for input, want := range map[string]string{
+		"": "", "4.1": "4", "0:4.1": "4", "10": "10", "1:10": "10",
+	} {
+		if got := Major(input); got != want {
+			t.Errorf("Major(%q) = %q; want %q", input, got, want)
+		}
+	}
+}
