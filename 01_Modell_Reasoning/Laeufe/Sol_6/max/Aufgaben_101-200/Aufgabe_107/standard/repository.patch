+import type { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+
+const read = 'read' as MARK_AS_STATUS;
+const unread = 'unread' as MARK_AS_STATUS;
+
+describe('optimistic mark-as bypass filter', () => {
+    it('removes a message from the unread filter bypass after marking it unread again', () => {
+        const message = { ID: 'message', ConversationID: 'conversation', Unread: 0 } as Element;
+        const initialState = newState({ params: { filter: { Unread: 1 } } });
+        initialState.bypassFilter = ['other'];
+
+        const readState = elementsReducer(
+            initialState,
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: false, markAsStatus: read })
+        );
+        expect(readState.bypassFilter).toEqual(['other', 'message']);
+
+        const unreadMessage = { ...message, Unread: 1 } as Element;
+        const unreadState = elementsReducer(
+            readState,
+            optimisticMarkAs({ elements: [unreadMessage], bypass: true, conversationMode: false, markAsStatus: unread })
+        );
+        expect(unreadState.bypassFilter).toEqual(['other']);
+        expect(unreadState.elements.message).toEqual(unreadMessage);
+    });
+
+    it('uses conversation IDs and removes them when the read filter matches again', () => {
+        const message = { ID: 'message', ConversationID: 'conversation', Unread: 1 } as Element;
+        const initialState = newState({ params: { filter: { Unread: 0 } } });
+        const unreadAction = optimisticMarkAs({
+            elements: [message],
+            bypass: true,
+            conversationMode: true,
+            markAsStatus: unread,
+        });
+
+        const unreadState = elementsReducer(elementsReducer(initialState, unreadAction), unreadAction);
+        expect(unreadState.bypassFilter).toEqual(['conversation']);
+
+        const readState = elementsReducer(
+            unreadState,
+            optimisticMarkAs({ elements: [message], bypass: true, conversationMode: true, markAsStatus: read })
+        );
+        expect(readState.bypassFilter).toEqual([]);
+    });
+
+    it('only changes bypass entries when both bypass and mark-as status are supplied', () => {
+        const message = { ID: 'message', ConversationID: 'conversation' } as Element;
+        const initialState = newState({ params: { filter: { Unread: 1 } } });
+
+        const withoutStatus = elementsReducer(initialState, optimisticMarkAs({ elements: [message], bypass: true }));
+        const withoutBypass = elementsReducer(
+            withoutStatus,
+            optimisticMarkAs({ elements: [message], markAsStatus: read })
+        );
+
+        expect(withoutBypass.bypassFilter).toEqual([]);
+        expect(withoutBypass.elements.message).toEqual(message);
+    });
+});
