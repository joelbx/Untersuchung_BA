@@ -0,0 +1,28 @@
+import { render, screen } from '@testing-library/react';
+import { addMonths, format, getUnixTime } from 'date-fns';
+
+import { subscriptionMock, upcomingSubscriptionMock } from '@proton/testing/data';
+
+import { ExpirationTime as B2BExpirationTime } from './b2bCommonConfig';
+import { ExpirationTime as B2CExpirationTime } from './b2cCommonConfig';
+
+const currentEnd = getUnixTime(addMonths(new Date(), 2));
+const upcomingEnd = getUnixTime(addMonths(new Date(), 14));
+const subscription = {
+    ...subscriptionMock,
+    PeriodEnd: currentEnd,
+    UpcomingSubscription: { ...upcomingSubscriptionMock, PeriodEnd: upcomingEnd },
+};
+
+describe.each([
+    ['B2C', B2CExpirationTime, 'cancellablePlan'],
+    ['B2B', B2BExpirationTime, 'isChargeBeeUser'],
+] as const)('%s cancellation confirmation date', (_name, ExpirationTime, dateDisplayProp) => {
+    it.each([true, false])('uses the current term for the date display when %s', (showDate) => {
+        render(<ExpirationTime subscription={subscription} {...{ [dateDisplayProp]: showDate }} />);
+
+        const time = screen.getByText(showDate ? format(currentEnd * 1000, 'PP') : /days? left/);
+        expect(time).toHaveAttribute('dateTime', format(currentEnd * 1000, 'yyyy-MM-dd'));
+        expect(time).not.toHaveAttribute('dateTime', format(upcomingEnd * 1000, 'yyyy-MM-dd'));
+    });
+});
