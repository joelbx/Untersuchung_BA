@@ -1,6 +1,7 @@
 from __future__ import print_function
 import os
 import pytest
+import requests
 from openlibrary.catalog import get_ia
 from openlibrary.core import ia
 from openlibrary.catalog.marc.marc_xml import MarcXml
@@ -18,7 +19,102 @@ def return_test_marc_data(url, test_data_subdir="xml_input"):
     filename = url.split('/')[-1]
     test_data_dir = "/../../catalog/marc/tests/test_data/%s/" % test_data_subdir
     path = os.path.dirname(__file__) + test_data_dir + filename
-    return open(path, mode='rb')
+    with open(path, mode='rb') as source:
+        return make_response(source.read())
+
+
+def make_response(content=b'', status_code=200, encoding=None):
+    response = requests.Response()
+    response.status_code = status_code
+    response._content = content
+    response.encoding = encoding
+    return response
+
+
+def test_urlopen_keep_trying_retries_and_decodes_utf8(monkeypatch):
+    attempts = [make_response(status_code=500), requests.exceptions.ConnectionError(),
+                make_response(b'\xc3\xa9')]
+    calls = []
+    sleeps = []
+
+    def fake_get(url, **kwargs):
+        calls.append((url, kwargs))
+        result = attempts.pop(0)
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+    monkeypatch.setattr(get_ia.requests, 'get', fake_get)
+    monkeypatch.setattr(get_ia, 'sleep', sleeps.append)
+
+    response = get_ia.urlopen_keep_trying('https://example.org/marc.xml',
+                                           headers={'Accept': 'application/xml'}, timeout=5)
+    assert response.text == u'\xe9'
+    assert response.encoding == 'utf-8'
+    assert calls == [('https://example.org/marc.xml',
+                      {'headers': {'Accept': 'application/xml'}, 'timeout': 5})] * 3
+    assert sleeps == [2, 2]
+
+
+def test_urlopen_keep_trying_honors_response_encoding(monkeypatch):
+    expected = make_response(b'\xe9', encoding='iso-8859-1')
+    monkeypatch.setattr(get_ia.requests, 'get', lambda url, **kwargs: expected)
+
+    response = get_ia.urlopen_keep_trying('https://example.org/marc.xml')
+    assert response.text == u'\xe9'
+    assert response.encoding == 'iso-8859-1'
+
+
+@pytest.mark.parametrize('status_code', [403, 404, 416])
+def test_urlopen_keep_trying_raises_terminal_http_errors(monkeypatch, status_code):
+    calls = []
+
+    def fake_get(url, **kwargs):
+        calls.append(url)
+        return make_response(status_code=status_code)
+
+    monkeypatch.setattr(get_ia.requests, 'get', fake_get)
+    with pytest.raises(requests.exceptions.HTTPError) as error:
+        get_ia.urlopen_keep_trying('https://example.org/marc.xml')
+    assert error.value.response.status_code == status_code
+    assert len(calls) == 1
+
+
+def test_files_retries_invalid_xml_and_reads_response_content(monkeypatch):
+    responses = [make_response(b'<files>'), make_response(
+        b'<?xml version="1.0" encoding="UTF-8"?>'
+        b'<files><file name="sample.mrc"><size>12</size></file>'
+        b'<file name="notes.txt"/></files>')]
+    sleeps = []
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', lambda url: responses.pop(0))
+    monkeypatch.setattr(get_ia, 'sleep', sleeps.append)
+
+    assert list(get_ia.files('sample')) == [('sample.mrc', 12)]
+    assert sleeps == [2]
+
+
+def test_get_from_archive_bulk_uses_range_and_limits_content(monkeypatch):
+    record = b'99995' + b'x' * (99995 - 5)
+    response = make_response(record + b'00010' + b'extra data beyond the range')
+    calls = []
+
+    def fake_get(url, headers=None):
+        calls.append((url, headers))
+        return response
+
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', fake_get)
+    assert get_ia.get_from_archive_bulk('sample/file.mrc:0:99995') == (record, 99995, 10)
+    assert calls == [(get_ia.IA_DOWNLOAD_URL + 'sample/file.mrc',
+                      {'Range': 'bytes=0-99999'})]
+
+
+def test_marc_formats_reads_xml_response_content(monkeypatch):
+    response = make_response(b'<?xml version="1.0"?><files>'
+                             b'<file name="sample_marc.xml"/>'
+                             b'<file name="sample_meta.mrc"/></files>')
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', lambda url: response)
+
+    assert get_ia.marc_formats('sample') == {'xml': True, 'bin': True}
 
