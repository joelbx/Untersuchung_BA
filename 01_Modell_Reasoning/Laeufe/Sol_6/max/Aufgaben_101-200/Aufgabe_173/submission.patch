+// TestDatabaseProxyFailover verifies that an offline service is skipped and
+// that an error is returned when every service's tunnel is offline.
+func TestDatabaseProxyFailover(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		allOffline bool
+	}{
+		{name: "connects to healthy service"},
+		{name: "all services offline", allOffline: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.Background()
+			testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+			go testCtx.startHandlingConnections()
+			testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+			// Register the same database on a second host whose tunnel is offline.
+			offlineServer := testCtx.postgres["postgres"].server.Copy().(*types.DatabaseServerV3)
+			offlineServer.Spec.HostID = "0"
+			_, err := testCtx.authClient.UpsertDatabaseServer(ctx, offlineServer)
+			require.NoError(t, err)
+
+			_, candidates, err := testCtx.proxyServer.pickDatabaseServers(ctx, tlsca.Identity{
+				RouteToCluster:  testCtx.clusterName,
+				RouteToDatabase: tlsca.RouteToDatabase{ServiceName: "postgres"},
+			})
+			require.NoError(t, err)
+			require.Len(t, candidates, 2)
+
+			// Sorting by host ID puts the offline service first on every attempt.
+			testCtx.proxyServer.cfg.Shuffle = func(servers []types.DatabaseServer) []types.DatabaseServer {
+				sort.Sort(types.SortedDatabaseServers(servers))
+				return servers
+			}
+			testCtx.remoteSite.OfflineTunnels = map[string]bool{
+				"0." + testCtx.clusterName: true,
+			}
+			if test.allOffline {
+				testCtx.remoteSite.OfflineTunnels[testCtx.hostID+"."+testCtx.clusterName] = true
+			}
+
+			pgConn, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+			if test.allOffline {
+				require.Error(t, err)
+				require.Contains(t, err.Error(), "failed to connect to any database service")
+				return
+			}
+			require.NoError(t, err)
+			result, err := pgConn.Exec(ctx, "select 1").ReadAll()
+			require.NoError(t, err)
+			require.Equal(t, []*pgconn.Result{postgres.TestQueryResponse}, result)
+			require.NoError(t, pgConn.Close(ctx))
+		})
+	}
+}
