+package types
+
+import (
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDatabaseServerOrderingAndDeduplication(t *testing.T) {
+	serverB2 := NewDatabaseServerV3("b", nil, DatabaseServerSpecV3{HostID: "2"})
+	serverA2 := NewDatabaseServerV3("a", nil, DatabaseServerSpecV3{HostID: "2"})
+	serverB1 := NewDatabaseServerV3("b", nil, DatabaseServerSpecV3{HostID: "1"})
+	serverA1 := NewDatabaseServerV3("a", nil, DatabaseServerSpecV3{HostID: "1"})
+
+	input := []DatabaseServer{serverB2, serverA2, serverB1, serverA1}
+	if got, want := DeduplicateDatabaseServers(input), []DatabaseServer{serverB2, serverA2}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("deduplicated servers = %v, want %v", got, want)
+	}
+	if input[0] != serverB2 || input[1] != serverA2 {
+		t.Fatal("deduplication changed the input slice")
+	}
+
+	sort.Sort(SortedDatabaseServers(input))
+	if want := []DatabaseServer{serverA1, serverA2, serverB1, serverB2}; !reflect.DeepEqual(input, want) {
+		t.Fatalf("sorted servers = %v, want %v", input, want)
+	}
+	if got, want := DeduplicateDatabaseServers(input), []DatabaseServer{serverA1, serverB1}; !reflect.DeepEqual(got, want) {
+		t.Fatalf("deduplicated sorted servers = %v, want %v", got, want)
+	}
+	if !strings.Contains(serverA1.String(), "HostID=1") {
+		t.Fatalf("database server string does not include host ID: %v", serverA1)
+	}
+}
