+def test_bcrypt_ident_saved_and_reused(tmp_path):
+    path = tmp_path / 'password'
+    lookup = password.LookupModule(loader=DictDataLoader())
+
+    first = lookup.run([u'%s encrypt=bcrypt ident=2b' % path], None)[0]
+    saved = path.read_text()
+    assert first.startswith('$2b$')
+    assert ' salt=' in saved
+    assert saved.endswith(' ident=2b\n')
+
+    repeated = lookup.run([u'%s encrypt=bcrypt' % path], None)[0]
+    assert repeated == first
+    assert path.read_text() == saved
+
+    changed = lookup.run([u'%s encrypt=bcrypt ident=2y' % path], None)[0]
+    assert changed.startswith('$2y$')
