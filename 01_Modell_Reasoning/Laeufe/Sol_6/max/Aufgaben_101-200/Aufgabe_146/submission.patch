+class TestFactsLinuxHardwareGetSysinfoFacts(unittest.TestCase):
+
+    def setUp(self):
+        self.hardware = linux.LinuxHardware(module=Mock(), load_on_init=False)
+
+    def test_missing_sysinfo(self):
+        with patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False) as exists:
+            with patch('ansible.module_utils.facts.hardware.linux.get_file_lines') as get_file_lines:
+                self.assertEqual(self.hardware.get_sysinfo_facts(), {})
+
+        exists.assert_called_once_with('/proc/sysinfo')
+        get_file_lines.assert_not_called()
+
+    def test_sysinfo_facts(self):
+        lines = [
+            'Manufacturer:         IBM',
+            'Type:                 3906',
+            'Model:                7C5',
+            'Sequence Code:        0000001234',
+        ]
+        with patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True):
+            with patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=lines) as get_file_lines:
+                facts = self.hardware.get_sysinfo_facts()
+
+        self.assertEqual(facts, {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '1234',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+        get_file_lines.assert_called_once_with('/proc/sysinfo')
+
+    def test_missing_sysinfo_fields(self):
+        with patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True):
+            with patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=['Type: 8561']):
+                facts = self.hardware.get_sysinfo_facts()
+
+        self.assertEqual(facts, {
+            'system_vendor': 'NA',
+            'product_name': '8561',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    def test_sysinfo_facts_populated_after_dmi(self):
+        for method in ('get_cpu_facts', 'get_memory_facts', 'get_device_facts',
+                       'get_uptime_facts', 'get_lvm_facts', 'get_mount_facts'):
+            setattr(self.hardware, method, Mock(return_value={}))
+        self.hardware.get_dmi_facts = Mock(return_value={
+            'system_vendor': 'NA', 'product_name': 'NA', 'product_serial': 'NA',
+        })
+
+        with patch('ansible.module_utils.facts.hardware.linux.get_best_parsable_locale', return_value='C'):
+            with patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True):
+                with patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+                        'Manufacturer: IBM', 'Type: 3906', 'Sequence Code: 0001234']):
+                    facts = self.hardware.populate()
+
+        self.assertEqual(facts, {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '1234',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+
