+func TestTeleportProxySSHServer(t *testing.T) {
+	_, signer, err := utils.CreateCertificate("foo", ssh.HostCert)
+	require.NoError(t, err)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener})
+	require.NoError(t, err)
+	go mux.Serve()
+	defer mux.Close()
+
+	remoteAddrs := make(chan net.Addr, 1)
+	srv, err := sshutils.NewServer(
+		"test",
+		utils.NetAddr{AddrNetwork: "tcp", Addr: "localhost:0"},
+		sshutils.NewChanHandlerFunc(func(context.Context, *sshutils.ConnectionContext, ssh.NewChannel) {}),
+		[]ssh.Signer{signer},
+		sshutils.AuthMethods{Password: func(conn ssh.ConnMetadata, _ []byte) (*ssh.Permissions, error) {
+			remoteAddrs <- conn.RemoteAddr()
+			return nil, nil
+		}},
+	)
+	require.NoError(t, err)
+	go srv.Serve(mux.SSH())
+	defer srv.Close()
+
+	client, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer client.Close()
+	// Include a tracing payload larger than the default buffered reader.
+	header := fmt.Sprintf("Teleport-Proxy{\"clientAddr\":\"192.0.2.10:1234\",\"tracingContext\":{\"key\":%q}}\x00", strings.Repeat("x", 5000))
+	_, err = io.WriteString(client, header)
+	require.NoError(t, err)
+	sshConn, _, _, err := ssh.NewClientConn(client, listener.Addr().String(), &ssh.ClientConfig{
+		User:            "test",
+		Auth:            []ssh.AuthMethod{ssh.Password("password")},
+		HostKeyCallback: ssh.FixedHostKey(signer.PublicKey()),
+		Timeout:         time.Second,
+	})
+	require.NoError(t, err)
+	defer sshConn.Close()
+	require.Equal(t, "192.0.2.10:1234", (<-remoteAddrs).String())
+}
