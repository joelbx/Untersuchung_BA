+const maxTeleportProxyHeaderSize = 16 * 1024
+
+// readTeleportProxyPayload inspects the header without consuming it. The SSH
+// server reads the same header to recover the tracing context.
+func readTeleportProxyPayload(reader *bufio.Reader) (net.Addr, error) {
+	// A header must fit in the reader's buffer. This bounds how much data an
+	// unauthenticated connection can make us buffer while waiting for a NUL.
+	for length := len(teleportProxyPrefix) + 1; length <= reader.Size(); length++ {
+		in, err := reader.Peek(length)
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport proxy header")
+		}
+		if in[length-1] != 0 {
+			continue
+		}
+
+		var payload apisshutils.HandshakePayload
+		if err := json.Unmarshal(in[len(teleportProxyPrefix):length-1], &payload); err != nil {
+			return nil, trace.BadParameter("invalid Teleport proxy payload: %v", err)
+		}
+		if payload.ClientAddr == "" {
+			return nil, nil
+		}
+
+		addr, err := utils.ParseAddr(payload.ClientAddr)
+		if err != nil {
+			return nil, trace.Wrap(err, "invalid Teleport proxy client address")
+		}
+		if addr.AddrNetwork == "tcp" {
+			ip := net.ParseIP(addr.Host())
+			if ip == nil {
+				return nil, trace.BadParameter("invalid Teleport proxy client IP %q", addr.Host())
+			}
+			return &net.TCPAddr{IP: ip, Port: addr.Port(0)}, nil
+		}
+		return addr, nil
+	}
+	return nil, trace.BadParameter("Teleport proxy header is too long")
+}
