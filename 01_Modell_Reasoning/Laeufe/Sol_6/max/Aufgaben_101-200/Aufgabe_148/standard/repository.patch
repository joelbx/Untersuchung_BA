+func TestTeleportProxySSH(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	mux, err := New(Config{Listener: listener, Context: ctx})
+	require.NoError(t, err)
+	sshListener := mux.SSH()
+	go mux.Serve()
+	defer mux.Close()
+
+	for _, tc := range []struct {
+		name       string
+		input      string
+		clientAddr string
+	}{
+		{name: "IPv4", input: "Teleport-Proxy{\"clientAddr\":\"192.0.2.10:1234\"}\x00SSH-2.0-test\r\n", clientAddr: "192.0.2.10:1234"},
+		{name: "IPv6", input: "Teleport-Proxy{\"ClientAddr\":\"[2001:db8::10]:4321\"}\x00SSH-2.0-test\r\n", clientAddr: "[2001:db8::10]:4321"},
+		{name: "NoClientAddr", input: "Teleport-Proxy{\"tracingContext\":{\"key\":\"value\"}}\x00SSH-2.0-test\r\n"},
+		{name: "PlainSSH", input: "SSH-2.0-test\r\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer client.Close()
+			_, err = io.WriteString(client, tc.input)
+			require.NoError(t, err)
+
+			conn, err := sshListener.Accept()
+			require.NoError(t, err)
+			defer conn.Close()
+			require.Equal(t, ProtoSSH, conn.(*Conn).Protocol())
+			wantAddr := tc.clientAddr
+			if wantAddr == "" {
+				wantAddr = client.LocalAddr().String()
+			}
+			require.Equal(t, wantAddr, conn.RemoteAddr().String())
+			require.IsType(t, &net.TCPAddr{}, conn.RemoteAddr())
+
+			require.NoError(t, conn.SetReadDeadline(time.Now().Add(time.Second)))
+			got := make([]byte, len(tc.input))
+			_, err = io.ReadFull(conn, got)
+			require.NoError(t, err)
+			require.Equal(t, tc.input, string(got))
+		})
+	}
+}
