@@ -0,0 +1,36 @@
+import { MEMORY_DOWNLOAD_LIMIT } from '@proton/shared/lib/drive/constants';
+
+import { isUnsupported } from './download';
+import fileSaver, { selectMechanismForDownload } from './fileSaver';
+
+jest.mock('./download', () => ({
+    initDownloadSW: jest.fn(() => Promise.resolve()),
+    isUnsupported: jest.fn(() => false),
+    openDownloadStream: jest.fn(),
+}));
+
+describe('selectMechanismForDownload', () => {
+    beforeEach(() => {
+        jest.mocked(isUnsupported).mockReturnValue(false);
+    });
+
+    it('uses memory for files below the limit, including empty files', () => {
+        expect(selectMechanismForDownload(0)).toBe('memory');
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT - 1)).toBe('memory');
+        expect(isUnsupported).not.toHaveBeenCalled();
+    });
+
+    it('uses the service worker at the limit or when size is unknown and it is supported', () => {
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT)).toBe('sw');
+        expect(selectMechanismForDownload()).toBe('sw');
+    });
+
+    it('uses memory fallback for large or unknown sizes when service workers are unsupported', () => {
+        jest.mocked(isUnsupported).mockReturnValue(true);
+
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT)).toBe('memory_fallback');
+        expect(selectMechanismForDownload()).toBe('memory_fallback');
+        expect(selectMechanismForDownload(MEMORY_DOWNLOAD_LIMIT - 1)).toBe('memory');
+        expect(fileSaver.isFileTooBig(MEMORY_DOWNLOAD_LIMIT + 1)).toBe(true);
+    });
+});
