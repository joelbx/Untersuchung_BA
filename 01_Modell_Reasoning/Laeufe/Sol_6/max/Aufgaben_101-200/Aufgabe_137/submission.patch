+// NewPropagator composes the configured context propagation formats.
+func NewPropagator(configured []config.TracingPropagator) (propagation.TextMapPropagator, error) {
+	if configured == nil {
+		configured = []config.TracingPropagator{
+			config.TracingPropagatorTraceContext,
+			config.TracingPropagatorBaggage,
+		}
+	}
+
+	if len(configured) == 0 {
+		return propagation.NewCompositeTextMapPropagator(), nil
+	}
+
+	names := make([]string, len(configured))
+	for i, name := range configured {
+		names[i] = string(name)
+	}
+	return autoprop.TextMapPropagator(names...)
+}
