+func TestNewPropagator(t *testing.T) {
+	for _, tt := range []struct {
+		name  config.TracingPropagator
+		field string
+	}{
+		{config.TracingPropagatorTraceContext, "traceparent"},
+		{config.TracingPropagatorBaggage, "baggage"},
+		{config.TracingPropagatorB3Multi, "x-b3-traceid"},
+		{config.TracingPropagatorJaeger, "uber-trace-id"},
+		{config.TracingPropagatorXRay, "X-Amzn-Trace-Id"},
+		{config.TracingPropagatorOTTrace, "ot-tracer-traceid"},
+	} {
+		t.Run(string(tt.name), func(t *testing.T) {
+			propagator, err := NewPropagator([]config.TracingPropagator{tt.name})
+			require.NoError(t, err)
+			assert.Contains(t, propagator.Fields(), tt.field)
+		})
+	}
+
+	b3, err := NewPropagator([]config.TracingPropagator{config.TracingPropagatorB3})
+	require.NoError(t, err)
+	spanContext := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    trace.TraceID{1},
+		SpanID:     trace.SpanID{1},
+		TraceFlags: trace.FlagsSampled,
+	})
+	carrier := propagation.MapCarrier{}
+	b3.Inject(trace.ContextWithSpanContext(context.Background(), spanContext), carrier)
+	assert.NotEmpty(t, carrier.Get("b3"))
+
+	propagator, err := NewPropagator([]config.TracingPropagator{config.TracingPropagatorTraceContext, config.TracingPropagatorNone})
+	require.NoError(t, err)
+	assert.Empty(t, propagator.Fields())
+
+	propagator, err = NewPropagator(nil)
+	require.NoError(t, err)
+	assert.Contains(t, propagator.Fields(), "traceparent")
+	assert.Contains(t, propagator.Fields(), "baggage")
+
+	propagator, err = NewPropagator([]config.TracingPropagator{})
+	require.NoError(t, err)
+	assert.Empty(t, propagator.Fields())
+}
