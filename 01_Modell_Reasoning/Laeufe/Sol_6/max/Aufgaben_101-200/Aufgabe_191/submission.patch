+import React from "react";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MatrixClient } from "matrix-js-sdk/src/client";
+import { MatrixError } from "matrix-js-sdk/src/http-api/errors";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+import {
+    DEFAULT_PHASE,
+    RegistrationTokenAuthEntry,
+} from "../../../src/components/views/auth/InteractiveAuthEntryComponents";
+
+describe("registration token interactive authentication", () => {
+    const matrixClient = { credentials: { userId: "@user:example.org" } } as MatrixClient;
+    const helpText = "Enter a registration token provided by the homeserver administrator.";
+
+    it("collects and submits a token from the form", async () => {
+        const onPhaseChange = jest.fn();
+        const submitAuthDict = jest.fn();
+        const props = {
+            matrixClient,
+            loginType: AuthType.RegistrationToken,
+            authSessionId: "session",
+            onPhaseChange,
+            submitAuthDict,
+        };
+        const { container, rerender } = render(<RegistrationTokenAuthEntry {...props} />);
+
+        const input = screen.getByLabelText("Registration token") as HTMLInputElement;
+        const button = screen.getByRole("button", { name: "Continue" });
+        expect(screen.getByText(helpText)).toBeInTheDocument();
+        expect(input.name).toBe("registrationTokenField");
+        expect(input).toHaveFocus();
+        expect(button).toBeDisabled();
+        expect(onPhaseChange).toHaveBeenCalledWith(DEFAULT_PHASE);
+
+        await userEvent.type(input, "my-token");
+        expect(button).toBeEnabled();
+        await userEvent.keyboard("{Enter}");
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: AuthType.RegistrationToken, token: "my-token" });
+
+        rerender(<RegistrationTokenAuthEntry {...props} busy={true} />);
+        expect(screen.getByLabelText("Loading...")).toBeInTheDocument();
+        expect(screen.queryByRole("button", { name: "Continue" })).not.toBeInTheDocument();
+        fireEvent.submit(container.querySelector("form"));
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+
+        rerender(<RegistrationTokenAuthEntry {...props} errorText="Invalid token" />);
+        expect(screen.getByRole("alert")).toHaveTextContent("Invalid token");
+        expect(screen.getByRole("alert")).toHaveClass("error");
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        expect(submitAuthDict).toHaveBeenCalledTimes(2);
+        expect(submitAuthDict).toHaveBeenLastCalledWith({ type: AuthType.RegistrationToken, token: "my-token" });
+    });
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "completes the %s token stage with the advertised type",
+        async (loginType) => {
+            const response = { access_token: "access-token" };
+            const makeRequest = jest.fn().mockResolvedValue(response);
+            const onAuthFinished = jest.fn();
+            render(
+                <InteractiveAuth
+                    matrixClient={matrixClient}
+                    authData={{ session: "session", flows: [{ stages: [loginType] }] }}
+                    clientSecret="client-secret"
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                />,
+            );
+
+            fireEvent.change(screen.getByLabelText("Registration token"), { target: { value: "my-token" } });
+            fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+
+            await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+            expect(makeRequest).toHaveBeenCalledWith({
+                session: "session",
+                type: loginType,
+                token: "my-token",
+            });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            });
+        },
+    );
+
+    it("shows a server error and allows the token to be corrected", async () => {
+        const loginType = AuthType.RegistrationToken;
+        const flow = { stages: [loginType] };
+        const response = { access_token: "access-token" };
+        const makeRequest = jest
+            .fn()
+            .mockRejectedValueOnce(
+                new MatrixError(
+                    { session: "session", flows: [flow], error: "Invalid token", errcode: "M_FORBIDDEN" },
+                    401,
+                ),
+            )
+            .mockResolvedValueOnce(response);
+        const onAuthFinished = jest.fn();
+        render(
+            <InteractiveAuth
+                matrixClient={matrixClient}
+                authData={{ session: "session", flows: [flow] }}
+                clientSecret="client-secret"
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />,
+        );
+
+        fireEvent.change(screen.getByLabelText("Registration token"), { target: { value: "wrong" } });
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        expect(await screen.findByRole("alert")).toHaveTextContent("Invalid token");
+        expect(onAuthFinished).not.toHaveBeenCalled();
+
+        fireEvent.change(screen.getByLabelText("Registration token"), { target: { value: "correct" } });
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        await waitFor(() =>
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            }),
+        );
+        expect(makeRequest).toHaveBeenNthCalledWith(2, {
+            session: "session",
+            type: loginType,
+            token: "correct",
+        });
+    });
+
+    it("moves to the next stage after the token is accepted", async () => {
+        const stages = [AuthType.UnstableRegistrationToken, AuthType.Password];
+        const response = { access_token: "access-token" };
+        const makeRequest = jest
+            .fn()
+            .mockRejectedValueOnce(
+                new MatrixError({ session: "session", flows: [{ stages }], completed: [stages[0]] }, 401),
+            )
+            .mockResolvedValueOnce(response);
+        const onAuthFinished = jest.fn();
+        const { container } = render(
+            <InteractiveAuth
+                matrixClient={matrixClient}
+                authData={{ session: "session", flows: [{ stages }] }}
+                clientSecret="client-secret"
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />,
+        );
+
+        fireEvent.change(screen.getByLabelText("Registration token"), { target: { value: "my-token" } });
+        fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+        const password = await screen.findByLabelText("Password");
+        expect(onAuthFinished).not.toHaveBeenCalled();
+
+        fireEvent.change(password, { target: { value: "password" } });
+        fireEvent.submit(container.querySelector("form"));
+        await waitFor(() =>
+            expect(onAuthFinished).toHaveBeenCalledWith(true, response, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            }),
+        );
+        expect(makeRequest).toHaveBeenCalledTimes(2);
+    });
+});
