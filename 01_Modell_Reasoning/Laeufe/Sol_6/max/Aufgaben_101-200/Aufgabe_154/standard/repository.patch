+_CLIXML = b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">failure</S></Objs>'
+
+
+@pytest.mark.parametrize('stderr, expected', [
+    (_CLIXML, b'failure'),
+    (b'before\r\n' + _CLIXML + b'after\r\n', b'before\r\nfailureafter\r\n'),
+    (b'\xff' + _CLIXML + b'\xfe', b'\xfffailure\xfe'),
+    (b'first ' + _CLIXML + b' middle ' + _CLIXML + b' last', b'first failure middle failure last'),
+    (b'before\r\nCLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">failure</S></Objs>after', b'before\r\nfailureafter'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1">\r\n<S S="Error">failure</S>\r\n</Objs>tail', b'failuretail'),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">caf\xc3\xa9</S></Objs>', 'café'.encode()),
+    (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">caf\x82</S></Objs>', 'café'.encode()),
+    (b'#< CLIXML\r\n#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">first</S></Objs>'
+     b'<Objs Version="1.1.0.1"><S S="Error">second</S></Objs>', b'first\r\nsecond'),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+@pytest.mark.parametrize('stderr', [
+    b'plain stderr\r\n',
+    b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">incomplete</S>',
+    b'#< CLIXML\r\n<Objs Version="1.1.0.1">\r\n<S S="Error">incomplete</S>',
+    b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">invalid</Objs>',
+    b'#< CLI\r\nXML\r\n<Objs Version="1.1.0.1"><S S="Error">failure</S></Objs>',
+])
+def test_replace_stderr_clixml_preserves_non_clixml_and_invalid_blocks(stderr):
+    assert ssh._replace_stderr_clixml(stderr) is stderr
+
+
+def test_replace_stderr_clixml_continues_after_invalid_block():
+    invalid = b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">incomplete</S>\r\n'
+    stderr = invalid + _CLIXML
+
+    assert ssh._replace_stderr_clixml(stderr) == invalid + b'failure'
+
