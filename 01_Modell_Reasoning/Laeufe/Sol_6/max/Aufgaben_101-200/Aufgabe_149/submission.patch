+    def test_feature_flag_prefixes(self):
+        assert qtargs.ENABLE_FEATURES_PREFIX == '--enable-features='
+        assert qtargs.DISABLE_FEATURES_PREFIX == '--disable-features='
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    @pytest.mark.parametrize('overlay', [True, False])
+    def test_disable_features_flag(self, config_stub, monkeypatch, parser,
+                                   via_commandline, overlay):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay' if overlay else 'never'
+
+        flag = 'disable-features=DisabledOne,DisabledTwo'
+        config_stub.val.qt.args = [] if via_commandline else [flag]
+        parsed = parser.parse_args(['--qt-flag', flag] if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+
+        assert args.count('--' + flag) == 1
+        enabled_flags = [arg for arg in args
+                         if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)]
+        assert enabled_flags == (['--enable-features=OverlayScrollbar']
+                                 if overlay else [])
+
+    def test_feature_flags_from_both_sources(self, config_stub, monkeypatch,
+                                             parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        config_stub.val.scrolling.bar = 'overlay'
+        config_stub.val.qt.args = [
+            'enable-features=ConfigOne,ConfigTwo',
+            'disable-features=ConfigDisabledOne,ConfigDisabledTwo',
+            'enable-features=ConfigThree',
+        ]
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CommandOne,CommandTwo',
+            '--qt-flag', 'disable-features=CommandDisabled',
+        ])
+
+        args = qtargs.qt_args(parsed)
+
+        assert [arg for arg in args
+                if arg.startswith(qtargs.ENABLE_FEATURES_PREFIX)] == [
+                    '--enable-features=CommandOne,CommandTwo,'
+                    'ConfigOne,ConfigTwo,ConfigThree,OverlayScrollbar',
+                ]
+        assert [arg for arg in args
+                if arg.startswith(qtargs.DISABLE_FEATURES_PREFIX)] == [
+                    '--disable-features=CommandDisabled',
+                    '--disable-features=ConfigDisabledOne,ConfigDisabledTwo',
+                ]
