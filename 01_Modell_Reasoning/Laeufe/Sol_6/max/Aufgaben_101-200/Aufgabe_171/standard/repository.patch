+func TestFliptAcceptServerVersionFromContext(t *testing.T) {
+	ctx := context.Background()
+	assert.Equal(t, semver.Version{Major: 1}, FliptAcceptServerVersionFromContext(ctx))
+
+	version := semver.Version{Major: 2, Minor: 3, Patch: 4}
+	withVersion := WithFliptAcceptServerVersion(ctx, version)
+	assert.Equal(t, version, FliptAcceptServerVersionFromContext(withVersion))
+	assert.Equal(t, semver.Version{Major: 1}, FliptAcceptServerVersionFromContext(ctx))
+}
+
+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name       string
+		header     string
+		withHeader bool
+		version    semver.Version
+	}{
+		{name: "missing header", version: semver.Version{Major: 1}},
+		{name: "empty header", withHeader: true, version: semver.Version{Major: 1}},
+		{name: "invalid header", header: "not-a-version", withHeader: true, version: semver.Version{Major: 1}},
+		{name: "incomplete version", header: "2.3", withHeader: true, version: semver.Version{Major: 1}},
+		{name: "prefixed version", header: "v2.3.4", withHeader: true, version: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+		{name: "unprefixed version", header: "2.3.4", withHeader: true, version: semver.Version{Major: 2, Minor: 3, Patch: 4}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.withHeader {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.header))
+			}
+
+			called := false
+			resp, err := FliptAcceptServerVersionUnaryInterceptor(zaptest.NewLogger(t))(
+				ctx, "request", nil,
+				func(handlerCtx context.Context, req interface{}) (interface{}, error) {
+					called = true
+					assert.Equal(t, tt.version, FliptAcceptServerVersionFromContext(handlerCtx))
+					assert.Equal(t, "request", req)
+					return "response", nil
+				},
+			)
+
+			require.NoError(t, err)
+			assert.True(t, called)
+			assert.Equal(t, "response", resp)
+		})
+	}
+}
