+    def test_route_targets_create_address_family(self):
+        self.get_config.return_value = 'vrf context other\n  address-family ipv4 unicast\n'
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[
+            dict(rt='65000:1000', direction='import'),
+            dict(rt='65000:2000', direction='export'),
+            dict(rt='65000:3000'),
+            dict(rt='65000:4000', state='absent'),
+        ]))
+
+        commands = ['vrf context ntc', 'address-family ipv6 unicast',
+                    'route-target import 65000:1000',
+                    'route-target export 65000:2000',
+                    'route-target import 65000:3000',
+                    'route-target export 65000:3000']
+        self.execute_module(changed=True, commands=commands, sort=False)
+        self.assertEqual(self.load_config.call_count, 1)
+
