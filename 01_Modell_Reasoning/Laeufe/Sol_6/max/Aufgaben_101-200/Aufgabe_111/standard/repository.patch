+func parseAmazonSystemRelease(systemRelease string) string {
+	fields := strings.Fields(systemRelease)
+	if len(fields) < 3 || fields[0] != "Amazon" || fields[1] != "Linux" {
+		return "unknown"
+	}
+	if fields[2] == "AMI" {
+		if len(fields) == 5 && fields[3] == "release" {
+			return fields[4]
+		}
+		return "unknown"
+	}
+	if fields[2] == "release" {
+		fields = fields[3:]
+	} else {
+		fields = fields[2:]
+	}
+	if len(fields) == 0 {
+		return "unknown"
+	}
+	return strings.Join(fields, " ")
+}
