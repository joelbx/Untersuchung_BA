+func amazonAdvisorySourceLink(advisoryID string) string {
+	prefix, suffix, found := strings.Cut(advisoryID, "-")
+	if !found || suffix == "" {
+		return ""
+	}
+	if prefix == "ALAS" {
+		return fmt.Sprintf("https://alas.aws.amazon.com/%s.html", advisoryID)
+	}
+	switch prefix {
+	case "ALAS2", "ALAS2022", "ALAS2023", "ALAS2025", "ALAS2027", "ALAS2029":
+		return fmt.Sprintf("https://alas.aws.amazon.com/AL%s/ALAS-%s.html", strings.TrimPrefix(prefix, "ALAS"), suffix)
+	}
+	return ""
+}
