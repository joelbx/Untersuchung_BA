+func TestAmazonLinuxEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		until   time.Time
+	}{
+		{release: "2023 (Amazon Linux)", until: time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{release: "2025", until: time.Date(2030, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{release: "2027", until: time.Date(2032, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{release: "2029", until: time.Date(2034, 3, 15, 23, 59, 59, 0, time.UTC)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL did not find release")
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("StandardSupportUntil = %s, want %s", eol.StandardSupportUntil, tt.until)
+			}
+			if !eol.ExtendedSupportUntil.IsZero() {
+				t.Errorf("ExtendedSupportUntil = %s, want zero", eol.ExtendedSupportUntil)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSuppportEnded(tt.until) {
+				t.Error("support ended before the end of the final day")
+			}
+			after := tt.until.Add(time.Second)
+			if !eol.IsStandardSupportEnded(after) || !eol.IsExtendedSuppportEnded(after) {
+				t.Error("support did not end after the final day")
+			}
+		})
+	}
+	for _, release := range []string{"2024", "2024 (Amazon Linux)", "unknown", ""} {
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("GetEOL unexpectedly found %q", release)
+		}
+	}
+}
+
+func TestEOLWithExtendedSupport(t *testing.T) {
+	eol, found := GetEOL(RedHat, "7")
+	if !found {
+		t.Fatal("GetEOL did not find Red Hat 7")
+	}
+	if eol.IsStandardSupportEnded(eol.StandardSupportUntil) || eol.IsExtendedSuppportEnded(eol.StandardSupportUntil) {
+		t.Error("support ended at the standard support boundary")
+	}
+	if !eol.IsStandardSupportEnded(eol.StandardSupportUntil.Add(time.Second)) || eol.IsExtendedSuppportEnded(eol.StandardSupportUntil.Add(time.Second)) {
+		t.Error("extended support status is wrong after standard support ends")
+	}
+	if eol.IsExtendedSuppportEnded(eol.ExtendedSupportUntil) || !eol.IsExtendedSuppportEnded(eol.ExtendedSupportUntil.Add(time.Second)) {
+		t.Error("extended support status is wrong at the extended support boundary")
+	}
+}
