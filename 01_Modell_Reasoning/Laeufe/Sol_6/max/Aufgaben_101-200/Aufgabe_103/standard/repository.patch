+func TestSplitFileName(t *testing.T) {
+	tests := []struct {
+		filename string
+		name     string
+		version  string
+		release  string
+		epoch    string
+		arch     string
+		wantErr  bool
+	}{
+		{filename: "package-0-1-src.rpm", name: "package", version: "0", release: "1", arch: "src"},
+		{filename: "package-0--src.rpm", name: "package", version: "0", arch: "src"},
+		{filename: "package-0-.src.rpm", name: "package", version: "0", arch: "src"},
+		{filename: "package-name-0-1.src.rpm", name: "package-name", version: "0", release: "1", arch: "src"},
+		{filename: "1:package-name-0-1.x86_64.rpm", name: "package-name", version: "0", release: "1", epoch: "1", arch: "x86_64"},
+		{filename: "package-0-1-src", wantErr: true},
+		{filename: "package-0-1.rpm", wantErr: true},
+		{filename: "package-0-src.rpm", wantErr: true},
+		{filename: "package-name-1.src.rpm", wantErr: true},
+		{filename: "package--1.src.rpm", wantErr: true},
+		{filename: "-0-1.src.rpm", wantErr: true},
+		{filename: "package-0-1..rpm", wantErr: true},
+		{filename: "x:package-0-1.src.rpm", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			name, version, release, epoch, arch, err := splitFileName(tt.filename)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("splitFileName(%q) error = %v, wantErr %v", tt.filename, err, tt.wantErr)
+			}
+			if tt.wantErr {
+				return
+			}
+			if name != tt.name || version != tt.version || release != tt.release || epoch != tt.epoch || arch != tt.arch {
+				t.Errorf("splitFileName(%q) = (%q, %q, %q, %q, %q), want (%q, %q, %q, %q, %q)", tt.filename, name, version, release, epoch, arch, tt.name, tt.version, tt.release, tt.epoch, tt.arch)
+			}
+		})
+	}
+}
