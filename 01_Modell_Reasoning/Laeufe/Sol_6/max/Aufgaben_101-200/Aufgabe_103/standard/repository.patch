+func splitRPMQueryFields(line string) []string {
+	return strings.Split(strings.ReplaceAll(strings.TrimSpace(line), "\t", " "), " ")
+}
+
+func validInstalledPackageFields(fields []string) bool {
+	for _, index := range []int{0, 1, 2, 4, 5} {
+		if fields[index] == "" {
+			return false
+		}
+	}
+	return true
+}
+
+func (o *redhatBase) parseInstalledSourcePackage(fields []string) *models.SrcPackage {
+	if fields[5] == "(none)" {
+		return nil
+	}
+
+	name, version, release, _, _, err := splitFileName(fields[5])
+	if err != nil {
+		o.warns = append(o.warns, xerrors.Errorf("Failed to parse source rpm file. err: %w", err))
+		return nil
+	}
+	return &models.SrcPackage{
+		Name:        name,
+		Version:     rpmPackageVersion(fields[1], version, release),
+		Arch:        "src",
+		BinaryNames: []string{fields[0]},
+	}
+}
+
+func rpmPackageVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
