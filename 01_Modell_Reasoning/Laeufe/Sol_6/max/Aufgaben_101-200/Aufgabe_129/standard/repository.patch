+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect } from "react";
+import classNames from "classnames";
+
+import UIStore from "../../../stores/UIStore";
+import { ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import AccessibleButton, { ButtonEvent } from "../elements/AccessibleButton";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+
+interface IProps extends Omit<React.ComponentProps<typeof AccessibleButton>, "onClick" | "title" | "children"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+export const KebabContextMenu: React.FC<IProps> = ({ options, title, className, disabled, onKeyDown, ...props }) => {
+    const [isOpen, buttonRef, openMenu, closeMenu] = useContextMenu<HTMLDivElement>();
+
+    useEffect(() => {
+        if (disabled && isOpen) closeMenu();
+    }, [disabled, isOpen, closeMenu]);
+
+    const onOpen = (ev: ButtonEvent): void => {
+        if (disabled) {
+            ev.preventDefault();
+            return;
+        }
+        // ContextMenu restores focus to the element that was focused when it opened.
+        buttonRef.current?.focus();
+        openMenu(ev);
+    };
+
+    const onTriggerKeyDown = (ev: React.KeyboardEvent<Element>): void => {
+        if (ev.key === "Escape" && isOpen) closeMenu(ev);
+        onKeyDown?.(ev);
+    };
+
+    const buttonRect = isOpen && buttonRef.current?.getBoundingClientRect();
+    const menuOptions = options.map((option, index) => {
+        if (!React.isValidElement<{ onClick?: (ev: ButtonEvent) => void | Promise<void> }>(option)) {
+            return option;
+        }
+
+        // Keyboard activation of AccessibleButton does not emit a click event,
+        // so the menu's click handler alone cannot close the menu in that case.
+        return React.cloneElement(option, {
+            key: option.key ?? index,
+            onClick: (ev: ButtonEvent) => {
+                option.props.onClick?.(ev);
+                closeMenu();
+            },
+        });
+    });
+
+    return <>
+        <ContextMenuButton
+            {...props}
+            inputRef={buttonRef}
+            className={classNames("mx_KebabContextMenu", className)}
+            label={title}
+            isExpanded={isOpen}
+            disabled={disabled}
+            onClick={onOpen}
+            onKeyDown={onTriggerKeyDown}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { buttonRect && <IconizedContextMenu
+            top={buttonRect.bottom + window.scrollY}
+            right={UIStore.instance.windowWidth - buttonRect.right - window.scrollX}
+            menuClassName="mx_KebabContextMenu_menu"
+            closeOnInteraction
+            onFinished={closeMenu}
+        >
+            <IconizedContextMenuOptionList first>
+                { menuOptions }
+            </IconizedContextMenuOptionList>
+        </IconizedContextMenu> }
+    </>;
+};
+
+export default KebabContextMenu;
