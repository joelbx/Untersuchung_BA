+    width: 18px;
+    height: 18px;
+    transform: rotate(90deg);
+    mask: url('$(res)/img/element-icons/context-menu.svg') center / contain no-repeat;
+    background-color: currentColor;
+}
+
+.mx_KebabContextMenu_menu.mx_ContextualMenu_right {
+    right: 0;
+}
+
+.mx_KebabContextMenu_menu .mx_IconizedContextMenu_option_red {
+    &:hover, &:focus, &:focus-visible {
+        color: $alert !important;
+        background-color: $menu-selected-color;
+    }
+
+    &:focus, &:focus-visible {
+        box-shadow: inset 0 0 0 2px $alert;
+    }
+}
