+
+import React from 'react';
+import { fireEvent, render } from '@testing-library/react';
+
+import { KebabContextMenu } from '../../../../src/components/views/context_menus/KebabContextMenu';
+import { IconizedContextMenuOption } from '../../../../src/components/views/context_menus/IconizedContextMenu';
+import UIStore from '../../../../src/stores/UIStore';
+import { mockPlatformPeg } from '../../../test-utils';
+
+mockPlatformPeg();
+
+describe('<KebabContextMenu />', () => {
+    it('positions the supplied options below and to the right of its trigger', () => {
+        const { getByTestId, getByLabelText, getByRole } = render(<KebabContextMenu
+            data-testid="kebab"
+            title="Session actions"
+            options={[<IconizedContextMenuOption key="sign-out" label="Sign out" onClick={jest.fn()} />]}
+        />);
+        const trigger = getByTestId('kebab');
+        jest.spyOn(trigger, 'getBoundingClientRect').mockReturnValue({
+            top: 48,
+            bottom: 80,
+            right: 240,
+            left: 208,
+            width: 32,
+            height: 32,
+        } as DOMRect);
+
+        fireEvent.click(trigger);
+
+        expect(trigger).toHaveAttribute('title', 'Session actions');
+        expect(trigger).toHaveAttribute('aria-expanded', 'true');
+        expect(getByLabelText('Sign out')).toHaveAttribute('role', 'menuitem');
+        expect(getByRole('menu')).toHaveClass('mx_KebabContextMenu_menu');
+        const wrapper = getByRole('menu').parentElement as HTMLElement;
+        expect(wrapper.style.top).toBe(`${80 + window.scrollY}px`);
+        expect(wrapper.style.right).toBe(`${UIStore.instance.windowWidth - 240 - window.scrollX}px`);
+
+        // Clicking even non-option space within the menu closes it.
+        fireEvent.click(getByRole('menu'));
+        expect(trigger).toHaveAttribute('aria-expanded', 'false');
+        expect(document.activeElement).toBe(trigger);
+    });
+});
