+def is_missing_import_value(value) -> bool:
+    """Treat empty values and promise-item placeholders as missing metadata."""
+    if isinstance(value, str):
+        return not value.strip() or value.strip() == '????'
+    if isinstance(value, list):
+        return not value or all(is_missing_import_value(item) for item in value)
+    if isinstance(value, dict) and 'name' in value:
+        return is_missing_import_value(value['name'])
+    return not value
+
+
+def is_complete_import_record(rec: dict) -> bool:
+    """A complete import has a title, an author, and a publication date."""
+    return all(
+        not is_missing_import_value(rec.get(field))
+        for field in ('title', 'authors', 'publish_date')
+    )
+
+
+def get_import_item_identifier(rec: dict) -> str | None:
+    """Prefer ISBN-10 for metadata lookup, then a non-ISBN Amazon ASIN."""
+    isbn_10s = rec.get('isbn_10') or []
+    if isinstance(isbn_10s, str):
+        isbn_10s = [isbn_10s]
+    for isbn in isbn_10s:
+        if not is_missing_import_value(isbn) and (
+            normalized_isbn := normalize_isbn(isbn)
+        ):
+            return normalized_isbn
+    return get_non_isbn_asin(rec)
