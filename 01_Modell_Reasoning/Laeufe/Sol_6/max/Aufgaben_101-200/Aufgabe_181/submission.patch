+def test_exit_unsuccessful_uses_own_pid(fake_proc, monkeypatch, message_mock,
+                                        caplog):
+    fake_proc.pid = 1234
+    monkeypatch.setattr(guiprocess, 'last_pid', 5678)
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_finished(1, QProcess.ExitStatus.NormalExit)
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == (
+        'Testprocess exited with status 1. See :process 1234 for details.'
+    )
+
+
+@pytest.mark.posix
+@pytest.mark.parametrize('verbose', [False, True])
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, verbose):
+    proc.verbose = verbose
+
+    with qtbot.wait_signal(proc.finished, timeout=10000):
+        with qtbot.wait_signal(proc.started, timeout=5000):
+            proc.start(*py_proc('import time; time.sleep(10)'))
+        proc.terminate()
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert proc.outcome.code == signal.SIGTERM
+    assert proc.outcome.was_sigterm()
+    assert not proc.outcome.was_successful()
+    assert str(proc.outcome) == 'Testprocess terminated with SIGTERM.'
+    assert proc.outcome.state_str() == 'terminated'
+
+    if verbose:
+        assert message_mock.messages[-1].level == usertypes.MessageLevel.info
+        assert message_mock.messages[-1].text == (
+            f'Testprocess terminated with SIGTERM. See :process {proc.pid} for details.'
+        )
+    else:
+        assert not message_mock.messages
 
 
