+def test_add_db_name_with_available_dates():
+    authors = [
+        {'name': 'No Dates'},
+        {'name': 'General Date', 'date': 'fl. 1900'},
+        {'name': 'Born', 'birth_date': '1895'},
+        {'name': 'Died', 'death_date': '1964'},
+        {'name': 'Both', 'birth_date': '1895', 'death_date': '1964'},
+        {'name': 'Structured Dates', 'date': '1895-1964', 'birth_date': '1895'},
+        {'name': 'Null Dates', 'birth_date': None, 'death_date': None},
+    ]
+    add_db_name({'authors': authors})
+    assert [author['db_name'] for author in authors] == [
+        'No Dates',
+        'General Date fl. 1900',
+        'Born 1895-',
+        'Died -1964',
+        'Both 1895-1964',
+        'Structured Dates 1895-',
+        'Null Dates',
+    ]
+
+    for rec in ({}, {'authors': None}, {'authors': []}):
+        original = rec.copy()
+        assert add_db_name(rec) is None
+        assert rec == original
