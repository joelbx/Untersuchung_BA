+type AdminActionLock = {
+    pending: boolean;
+    run(action: () => Promise<void>): Promise<void>;
+};
+
+const AdminActionLockContext = React.createContext<AdminActionLock | null>(null);
+
+const useAdminActionLock = (): AdminActionLock => {
+    const [pending, setPending] = useState(false);
+    const inFlight = useRef(false);
+
+    const run = useCallback(async (action: () => Promise<void>): Promise<void> => {
+        // State updates can be batched, so guard synchronously as well as disabling the buttons.
+        if (inFlight.current) return;
+        inFlight.current = true;
+        setPending(true);
+        try {
+            await action();
+        } finally {
+            inFlight.current = false;
+            setPending(false);
+        }
+    }, []);
+
+    return { pending, run };
+};
+
+const useMemberAdminActionLock = (): AdminActionLock => {
+    const sharedLock = useContext(AdminActionLockContext);
+    const localLock = useAdminActionLock();
+    return sharedLock ?? localLock;
+};
+
+const AdminActionLockProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
+    const lock = useAdminActionLock();
+    return <AdminActionLockContext.Provider value={lock}>{children}</AdminActionLockContext.Provider>;
+};
+
+const showAdminActionError = (title: string, err: unknown): void => {
+    logger.error(title, err);
+    Modal.createDialog(ErrorDialog, {
+        title,
+        description: err instanceof Error && err.message ? err.message : _t("Operation failed"),
+    });
+};
