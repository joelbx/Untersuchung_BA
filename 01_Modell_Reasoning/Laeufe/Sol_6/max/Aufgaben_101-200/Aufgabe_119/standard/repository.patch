+import React, { ReactElement, useEffect, useMemo, useState } from "react";
+import { Room } from "matrix-js-sdk/src/models/room";
+import { RoomMember } from "matrix-js-sdk/src/models/room-member";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { PillType } from "../components/views/elements/PillType";
+import { ButtonEvent } from "../components/views/elements/AccessibleButton";
+import RoomAvatar from "../components/views/avatars/RoomAvatar";
+import MemberAvatar from "../components/views/avatars/MemberAvatar";
+import { MatrixClientPeg } from "../MatrixClientPeg";
+import { getPrimaryPermalinkEntity } from "../utils/permalinks/Permalinks";
+import dis from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+
+export interface UsePermalinkArgs {
+    room?: Room;
+    type?: PillType;
+    url?: string;
+}
+
+export interface UsePermalinkResult {
+    avatar: ReactElement | null;
+    text: string | null;
+    onClick: ((e: ButtonEvent) => void) | null;
+    resourceId: string | null;
+    type: PillType | "space" | null;
+}
+
+interface Profile {
+    userId: string;
+    displayName?: string;
+    avatarUrl?: string;
+}
+
+export function usePermalink({ room, type, url }: UsePermalinkArgs): UsePermalinkResult {
+    const permalinkId = useMemo(() => (url ? getPrimaryPermalinkEntity(url) : null), [url]);
+    const inferredType =
+        type ??
+        (permalinkId?.startsWith("@")
+            ? PillType.UserMention
+            : permalinkId?.startsWith("!") || permalinkId?.startsWith("#")
+            ? PillType.RoomMention
+            : null);
+
+    const userId = inferredType === PillType.UserMention && permalinkId?.startsWith("@") ? permalinkId : null;
+    const localMember = userId ? room?.getMember(userId) : null;
+    const [profile, setProfile] = useState<Profile | null>(null);
+
+    useEffect(() => {
+        if (!userId || localMember) return;
+
+        let active = true;
+        MatrixClientPeg.get()
+            .getProfileInfo(userId)
+            .then((resp) => {
+                if (active) {
+                    setProfile({ userId, displayName: resp.displayname, avatarUrl: resp.avatar_url });
+                }
+            })
+            .catch((err) => logger.error("Could not retrieve profile data for " + userId + ":", err));
+
+        return () => {
+            active = false;
+        };
+    }, [userId, localMember]);
+
+    const member = useMemo(() => {
+        if (!userId) return null;
+        if (localMember) return localMember;
+
+        const fallbackMember = new RoomMember(null, userId);
+        if (profile?.userId === userId) {
+            fallbackMember.name = profile.displayName;
+            fallbackMember.rawDisplayName = profile.displayName;
+            fallbackMember.events.member = {
+                getContent: () => ({ avatar_url: profile.avatarUrl }),
+                getDirectionalContent: () => ({ avatar_url: profile.avatarUrl }),
+            } as MatrixEvent;
+        }
+        return fallbackMember;
+    }, [userId, localMember, profile]);
+
+    if (inferredType === PillType.AtRoomMention) {
+        return {
+            avatar: room ? <RoomAvatar room={room} width={16} height={16} aria-hidden="true" /> : null,
+            text: "@room",
+            onClick: null,
+            resourceId: room?.roomId ?? null,
+            type: PillType.AtRoomMention,
+        };
+    }
+
+    if (inferredType === PillType.UserMention && userId && member) {
+        return {
+            avatar: <MemberAvatar member={member} width={16} height={16} aria-hidden="true" hideTitle />,
+            text: member.rawDisplayName || member.userId,
+            onClick: (e: ButtonEvent) => {
+                e.preventDefault();
+                dis.dispatch({ action: Action.ViewUser, member });
+            },
+            resourceId: userId,
+            type: PillType.UserMention,
+        };
+    }
+
+    if (inferredType === PillType.RoomMention && permalinkId?.match(/^[!#]/)) {
+        const resolvedRoom =
+            permalinkId[0] === "#"
+                ? MatrixClientPeg.get()
+                      .getRooms()
+                      .find((candidate) =>
+                          [candidate.getCanonicalAlias(), ...candidate.getAltAliases()].includes(permalinkId),
+                      )
+                : MatrixClientPeg.get().getRoom(permalinkId);
+        return {
+            avatar: resolvedRoom ? <RoomAvatar room={resolvedRoom} width={16} height={16} aria-hidden="true" /> : null,
+            text: resolvedRoom?.name || permalinkId,
+            onClick: null,
+            resourceId: permalinkId,
+            type: resolvedRoom?.isSpaceRoom() ? "space" : PillType.RoomMention,
+        };
+    }
+
+    return { avatar: null, text: null, onClick: null, resourceId: null, type: null };
+}
