+import React from "react";
+import { fireEvent, render, waitFor } from "@testing-library/react";
+import { MatrixClient, Room, RoomMember } from "matrix-js-sdk/src/matrix";
+
+import { Pill, PillType, pillRoomNotifLen, pillRoomNotifPos } from "../../../../src/components/views/elements/Pill";
+import dis from "../../../../src/dispatcher/dispatcher";
+import { Action } from "../../../../src/dispatcher/actions";
+import DMRoomMap from "../../../../src/utils/DMRoomMap";
+import { mkStubRoom, stubClient } from "../../../test-utils/test-utils";
+
+describe("Pill", () => {
+    let client: MatrixClient;
+    let room: Room;
+
+    beforeEach(() => {
+        client = stubClient();
+        room = mkStubRoom("!room:example.org", "A room", client);
+        (client.getRoom as jest.Mock).mockReturnValue(room);
+        (client.getRooms as jest.Mock).mockReturnValue([room]);
+        DMRoomMap.makeShared();
+    });
+
+    it("exports the @room splitting helpers", () => {
+        expect(pillRoomNotifPos("before @room after @room")).toBe(7);
+        expect(pillRoomNotifPos("no mention")).toBe(-1);
+        expect(pillRoomNotifLen()).toBe(5);
+    });
+
+    it("renders nothing without a resolvable type and target", () => {
+        const { container, rerender } = render(<Pill url="https://example.org/elsewhere" inMessage />);
+        expect(container.querySelector("bdi")).toBeNull();
+        rerender(<Pill type={PillType.UserMention} inMessage />);
+        expect(container.querySelector("bdi")).toBeNull();
+    });
+
+    it("preserves a message URL verbatim and renders a non-message pill as a span", () => {
+        const url = "https://matrix.to/#/!room:example.org?via=example.org";
+        const { container, rerender } = render(<Pill url={url} inMessage room={room} />);
+        expect(container.querySelector("bdi > a.mx_Pill.mx_RoomPill")?.getAttribute("href")).toBe(url);
+        expect(container.querySelector(".mx_Pill_linkText")).toHaveTextContent("A room");
+        expect(container.querySelector(".mx_BaseAvatar")).toBeNull();
+
+        rerender(<Pill url={url} room={room} />);
+        expect(container.querySelector("bdi > span.mx_Pill.mx_RoomPill")).toBeInTheDocument();
+        expect(container.querySelector("a")).toBeNull();
+    });
+
