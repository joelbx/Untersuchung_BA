+
+package parse
+
+import (
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a typed, evaluatable expression node.
+type Expr interface {
+	String() string
+	Kind() reflect.Kind
+	Evaluate(EvaluateContext) (any, error)
+}
+
+// EvaluateContext supplies the values needed to evaluate an expression.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+// StringLitExpr is a constant string.
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string                        { return strconv.Quote(e.Value) }
+func (e StringLitExpr) Kind() reflect.Kind                    { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) { return []string{e.Value}, nil }
+
+// VarExpr is a namespaced variable with exactly one name component.
+type VarExpr struct {
+	Namespace string
+	Name      string
+}
+
+func (e VarExpr) String() string     { return e.Namespace + "." + e.Name }
+func (e VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("no variable resolver for %q", e.String())
+	}
+	return ctx.VarValue(e)
+}
+
+// EmailLocalExpr extracts the local part from each address produced by Source.
+type EmailLocalExpr struct{ Source Expr }
+
+func (e EmailLocalExpr) String() string     { return "email.local(" + e.Source.String() + ")" }
+func (e EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Source, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("address is empty")
+		}
+		addr, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("failed to parse address %q: %v", value, err)
+		}
+		at := strings.LastIndexByte(addr.Address, '@')
+		if at <= 0 || at == len(addr.Address)-1 {
+			return nil, trace.BadParameter("could not find local part in %q", addr.Address)
+		}
+		out = append(out, addr.Address[:at])
+	}
+	return out, nil
+}
+
+// RegexpReplaceExpr replaces every match in each string produced by Source.
+// Values without a match are omitted.
+type RegexpReplaceExpr struct {
+	Source      Expr
+	Pattern     string
+	Replacement string
+	re          *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return "regexp.replace(" + e.Source.String() + ", " + strconv.Quote(e.Pattern) + ", " + strconv.Quote(e.Replacement) + ")"
+}
+func (e RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Source, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if re.MatchString(value) {
+			out = append(out, re.ReplaceAllString(value, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+// RegexpMatchExpr tests MatcherInput against a compiled regular expression.
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string     { return "regexp.match(" + strconv.Quote(e.Pattern) + ")" }
+func (e RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	if re == nil {
+		var err error
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+
+// RegexpNotMatchExpr negates a regular expression match of MatcherInput.
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string {
+	return "regexp.not_match(" + strconv.Quote(e.Pattern) + ")"
+}
+func (e RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	if re == nil {
+		var err error
+		re, err = compileRegexp(e.Pattern)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	return !re.MatchString(ctx.MatcherInput), nil
+}
+
+func evaluateStrings(expr Expr, ctx EvaluateContext) ([]string, error) {
+	if expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected a string expression, got %s", expr.Kind())
+	}
+	value, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	strings, ok := value.([]string)
+	if !ok {
+		return nil, trace.BadParameter("string expression %s returned %T", expr.String(), value)
+	}
+	return strings, nil
+}
+
+func compileRegexp(pattern string) (*regexp.Regexp, error) {
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", pattern, err)
+	}
+	return re, nil
+}
