+func TestApplyValueTraitsExpressionValidation(t *testing.T) {
+	t.Parallel()
+	traits := map[string][]string{
+		constants.TraitLogins: {"alice@example.com"},
+		"custom":              {"external@example.com"},
+		"empty":               {},
+		"unsupported":         {"unsupported@example.com"},
+	}
+
+	values, err := ApplyValueTraits(`{{regexp.replace(email.local(internal.logins), "^alice$", "user")}}`, traits)
+	require.NoError(t, err)
+	require.Equal(t, []string{"user"}, values)
+
+	values, err = ApplyValueTraits(`{{email.local(external.custom)}}`, traits)
+	require.NoError(t, err)
+	require.Equal(t, []string{"external"}, values)
+
+	_, err = ApplyValueTraits(`{{email.local(internal.unsupported)}}`, traits)
+	require.True(t, trace.IsBadParameter(err), "%v", err)
+	require.Contains(t, err.Error(), `unsupported variable "unsupported"`)
+
+	_, err = ApplyValueTraits(`{{external.empty}}`, traits)
+	require.True(t, trace.IsNotFound(err), "%v", err)
+	require.Contains(t, err.Error(), "variable interpolation result is empty")
+
+	_, err = ApplyValueTraits(`{{external.missing}}`, traits)
+	require.True(t, trace.IsNotFound(err), "%v", err)
+	require.Contains(t, err.Error(), "external.missing")
+}
