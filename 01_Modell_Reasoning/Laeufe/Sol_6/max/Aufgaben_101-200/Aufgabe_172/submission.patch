+// UnmarshalJSON accepts string listenPorts from older results and port objects
+// from results written before structured ports moved to listenPortStats.
+func (ap *AffectedProcess) UnmarshalJSON(data []byte) error {
+	var decoded struct {
+		PID             string          `json:"pid"`
+		Name            string          `json:"name"`
+		ListenPorts     json.RawMessage `json:"listenPorts"`
+		ListenPortStats []PortStat      `json:"listenPortStats"`
+	}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		return err
+	}
+
+	result := AffectedProcess{
+		PID:             decoded.PID,
+		Name:            decoded.Name,
+		ListenPortStats: decoded.ListenPortStats,
+	}
+	if len(decoded.ListenPorts) != 0 {
+		if err := json.Unmarshal(decoded.ListenPorts, &result.ListenPorts); err != nil {
+			result.ListenPorts = nil
+			var ports []struct {
+				Address           string   `json:"address"`
+				Port              string   `json:"port"`
+				PortScanSuccessOn []string `json:"portScanSuccessOn"`
+			}
+			if err := json.Unmarshal(decoded.ListenPorts, &ports); err != nil {
+				return xerrors.Errorf("Invalid listenPorts: %w", err)
+			}
+			for _, port := range ports {
+				result.ListenPortStats = append(result.ListenPortStats, PortStat{
+					BindAddress:     port.Address,
+					Port:            port.Port,
+					PortReachableTo: port.PortScanSuccessOn,
+				})
+			}
+		}
+	}
+	*ap = result
+	return nil
+}
+
+// NewPortStat parses a listening address in <ip>:<port> form.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	if ipPort == "" {
+		return &PortStat{}, nil
+	}
+
+	host, port, err := net.SplitHostPort(ipPort)
+	if err != nil || host == "" || port == "" || (host != "*" && net.ParseIP(host) == nil) {
+		return nil, xerrors.Errorf("Invalid listening port: %q", ipPort)
+	}
+	if _, err := strconv.ParseUint(port, 10, 16); err != nil {
+		return nil, xerrors.Errorf("Invalid listening port: %q", ipPort)
+	}
+
+	if strings.HasPrefix(ipPort, "[") {
+		host = "[" + host + "]"
+	}
+	return &PortStat{BindAddress: host, Port: port}, nil
+}
