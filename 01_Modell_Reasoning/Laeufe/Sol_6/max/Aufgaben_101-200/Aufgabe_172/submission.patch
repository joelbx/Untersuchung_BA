+func TestNewPortStat(t *testing.T) {
+	tests := []struct {
+		input string
+		want  PortStat
+		bad   bool
+	}{
+		{input: "", want: PortStat{}},
+		{input: "127.0.0.1:22", want: PortStat{BindAddress: "127.0.0.1", Port: "22"}},
+		{input: "*:22", want: PortStat{BindAddress: "*", Port: "22"}},
+		{input: "[::1]:22", want: PortStat{BindAddress: "[::1]", Port: "22"}},
+		{input: "127.0.0.1", bad: true},
+		{input: ":22", bad: true},
+		{input: "127.0.0.1:", bad: true},
+		{input: "::1:22", bad: true},
+		{input: "[::1:22", bad: true},
+		{input: "example.com:22", bad: true},
+		{input: "127.0.0.1:ssh", bad: true},
+		{input: "127.0.0.1:65536", bad: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			got, err := NewPortStat(tt.input)
+			if tt.bad {
+				if err == nil {
+					t.Fatalf("NewPortStat(%q) expected an error", tt.input)
+				}
+				return
+			}
+			if err != nil || got == nil || !reflect.DeepEqual(*got, tt.want) {
+				t.Errorf("NewPortStat(%q) = %v, %v; want %v", tt.input, got, err, tt.want)
+			}
+		})
+	}
+}
+
+func TestLegacyListenPortsJSON(t *testing.T) {
+	var result struct {
+		Packages Packages `json:"packages"`
+	}
+	input := `{"packages":{"pkg":{"AffectedProcs":[{"pid":"42","listenPorts":["127.0.0.1:22","*:80"]}]}}}`
+	if err := json.Unmarshal([]byte(input), &result); err != nil {
+		t.Fatal(err)
+	}
+	proc := result.Packages["pkg"].AffectedProcs[0]
+	if !reflect.DeepEqual(proc.ListenPorts, []string{"127.0.0.1:22", "*:80"}) || proc.ListenPortStats != nil {
+		t.Errorf("unexpected affected process: %+v", proc)
+	}
+	if result.Packages["pkg"].HasReachablePort() {
+		t.Error("legacy listenPorts should not imply reachability")
+	}
+}
+
+func TestStructuredListenPortsJSON(t *testing.T) {
+	want := AffectedProcess{
+		PID: "42",
+		ListenPortStats: []PortStat{{
+			BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1"},
+		}},
+	}
+	for name, input := range map[string]string{
+		"previous structured field": `{"pid":"42","listenPorts":[{"address":"*","port":"22","portScanSuccessOn":["127.0.0.1"]}]}`,
+		"current structured field":  `{"pid":"42","listenPortStats":[{"bindAddress":"*","port":"22","portReachableTo":["127.0.0.1"]}]}`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			var proc AffectedProcess
+			if err := json.Unmarshal([]byte(input), &proc); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(proc, want) {
+				t.Errorf("unexpected affected process: %+v; want %+v", proc, want)
+			}
+		})
+	}
+}
+
+func TestPackageHasReachablePort(t *testing.T) {
+	tests := []struct {
+		name string
+		p    Package
+		want bool
+	}{
+		{name: "no processes", p: Package{}},
+		{name: "nil port stats", p: Package{AffectedProcs: []AffectedProcess{{ListenPorts: []string{"*:22"}}}}},
+		{name: "unreachable", p: Package{AffectedProcs: []AffectedProcess{{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22"}}}}}},
+		{
+			name: "reachable",
+			p: Package{AffectedProcs: []AffectedProcess{
+				{},
+				{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22", PortReachableTo: []string{"127.0.0.1"}}}},
+			}},
+			want: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.p.HasReachablePort(); got != tt.want {
+				t.Errorf("HasReachablePort() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
