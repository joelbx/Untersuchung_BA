+func TestEngine_IsAuthMethod(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+
+	policy := `package flipt.authz.v1
+import rego.v1
+default allow := false
+allow if {
+    flipt.is_auth_method(input, input.request.method)
+}`
+	engine, err := newEngine(ctx, zaptest.NewLogger(t), withPolicySource(policySource(policy)))
+	require.NoError(t, err)
+
+	tests := []struct {
+		name     string
+		method   auth.Method
+		expected bool
+	}{
+		{"token", auth.Method_METHOD_TOKEN, true},
+		{"oidc", auth.Method_METHOD_OIDC, true},
+		{"kubernetes", auth.Method_METHOD_KUBERNETES, true},
+		{"k8s", auth.Method_METHOD_KUBERNETES, true},
+		{"github", auth.Method_METHOD_GITHUB, true},
+		{"jwt", auth.Method_METHOD_JWT, true},
+		{"cloud", auth.Method_METHOD_CLOUD, true},
+		{"wrong method", auth.Method_METHOD_TOKEN, false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			methodName := tt.name
+			if tt.name == "wrong method" {
+				methodName = "jwt"
+			}
+
+			allowed, err := engine.IsAllowed(ctx, map[string]any{
+				"authentication": &auth.Authentication{Method: tt.method, Metadata: map[string]string{"io.flipt.auth.role": "admin"}},
+				"request":        map[string]any{"method": methodName},
+			})
+			require.NoError(t, err)
+			require.Equal(t, tt.expected, allowed)
+		})
+	}
+
+	for _, tt := range []struct {
+		name  string
+		input map[string]any
+		want  string
+	}{
+		{"missing authentication", map[string]any{"request": map[string]any{"method": "token"}}, "no authentication found"},
+		{"unsupported method", map[string]any{"authentication": &auth.Authentication{Method: auth.Method_METHOD_TOKEN}, "request": map[string]any{"method": "password"}}, "unsupported auth method: \"password\""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := engine.IsAllowed(ctx, tt.input)
+			require.ErrorContains(t, err, tt.want)
+		})
+	}
+}
