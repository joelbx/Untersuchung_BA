+			}
+			if config.Conf.Servers["host"].UUIDs["host"] == "" {
+				t.Error("host UUID was not saved")
+			}
+			if _, ok := config.Conf.Servers["0@host"]; ok {
+				t.Error("created a config entry for the indexed image server name")
+			}
+		})
+	}
