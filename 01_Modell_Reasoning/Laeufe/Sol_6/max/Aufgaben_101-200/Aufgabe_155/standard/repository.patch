+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded Image
+	if err := json.Unmarshal(encoded, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded != r.Image {
+		t.Errorf("image JSON round trip = %+v, want %+v", decoded, r.Image)
+	}
