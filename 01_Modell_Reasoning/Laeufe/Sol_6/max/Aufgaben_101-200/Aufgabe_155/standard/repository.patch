+func TestEnsureUUIDsImageNames(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		image    models.Image
+		want     string
+		existing bool
+	}{
+		{"tag", models.Image{Name: "example/app", Tag: "1.2"}, "example/app:1.2@0@host", false},
+		{"digest", models.Image{Name: "example/app", Digest: "sha256:abc"}, "example/app@sha256:abc@0@host", false},
+		{"existing digest", models.Image{Name: "example/app", Digest: "sha256:abc"}, "example/app@sha256:abc@0@host", true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			oldConf := config.Conf
+			defer func() { config.Conf = oldConf }()
+			server := config.ServerInfo{ServerName: "host"}
+			if tt.existing {
+				server.UUIDs = map[string]string{tt.want: defaultUUID}
+			}
+			config.Conf = config.Config{Servers: map[string]config.ServerInfo{
+				"host": server,
+			}}
+			dir, err := ioutil.TempDir("", "vuls-image-uuids-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer os.RemoveAll(dir)
+			path := filepath.Join(dir, "config.toml")
+			if err := ioutil.WriteFile(path, nil, 0600); err != nil {
+				t.Fatal(err)
+			}
+			results := models.ScanResults{{ServerName: "0@host", Image: tt.image}}
