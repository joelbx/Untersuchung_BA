+import { parseStringToDOM } from '@proton/shared/lib/helpers/dom';
+
+import { prepareConversionToHTML } from 'proton-mail/helpers/textToHtml';
+
+import { simplifyHTML } from './html';
+import { prepareContentToModel } from './input';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { parseModelResult } from './result';
+
+describe('assistant HTML and Markdown conversion', () => {
+    it('moves misplaced nested lists into the preceding list item', () => {
+        const dom = parseStringToDOM('<ol><li>First</li><ul><li>Child</li></ul><li>Second</li></ol>');
+
+        expect(fixNestedLists(dom)).toBe(dom);
+        expect(dom.querySelector('ol > li:first-child > ul > li')?.textContent).toBe('Child');
+        expect(dom.querySelectorAll('ol > ul')).toHaveLength(0);
+    });
+
+    it('creates a list item for a nested list without a preceding item', () => {
+        const dom = parseStringToDOM('<ul><ol><li>Child</li></ol></ul>');
+
+        fixNestedLists(dom);
+
+        expect(dom.querySelector('ul > li > ol > li')?.textContent).toBe('Child');
+    });
+
+    it('keeps ordered markers and nested hierarchy through an HTML round trip', () => {
+        const dom = parseStringToDOM('<ol><li>First</li><ol><li>Child</li></ol><li>Second</li></ol>');
+
+        const markdown = htmlToMarkdown(dom);
+        const restored = parseStringToDOM(markdownToHTML(markdown));
+
+        expect(markdown).toContain('1. First');
+        expect(markdown).toContain('2. Second');
+        expect(restored.querySelector('ol > li:first-child > ol > li')?.textContent).toBe('Child');
+        expect(restored.querySelectorAll('ol > li')).toHaveLength(3);
+    });
+
+    it('allows Markdown list rules to be configured without changing ordinary text conversion', () => {
+        const markdown = '- First\n- Second';
+
+        expect(prepareConversionToHTML(markdown)).not.toContain('<ul>');
+        expect(prepareConversionToHTML(markdown, ['heading'])).toContain('<ul>');
+        expect(markdownToHTML(markdown)).toContain('<ul>');
+    });
+
+    it('keeps class and style on links and images during simplification', () => {
+        const dom = parseStringToDOM(
+            '<div class="outer" style="color: blue"><a href="https://example.com" class="link" style="color: red">Link</a><img src="https://example.com/image" class="image" style="width: 50px"></div>'
+        );
+
+        simplifyHTML(dom);
+
+        expect(dom.querySelector('div')?.hasAttribute('class')).toBe(false);
+        expect(dom.querySelector('div')?.hasAttribute('style')).toBe(false);
+        expect(dom.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(dom.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(dom.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(dom.querySelector('img')?.getAttribute('style')).toBe('width: 50px');
+    });
+
+    it('uses the same message identity when preparing and rendering model content', () => {
+        const markdown = prepareContentToModel('<a href="https://example.com">Link</a>', 'uid', 'message-1');
+
+        expect(parseModelResult(markdown, 'message-1')).toContain('href="https://example.com"');
+        expect(parseModelResult(markdown, 'message-2')).not.toContain('<a');
+        expect(parseModelResult(markdown, 'message-2')).toContain('Link');
+    });
+
+    it('retains link and image formatting through model preparation and result rendering', () => {
+        const markdown = prepareContentToModel(
+            '<a href="https://example.com" class="link" style="color: red">Link</a><img src="https://example.com/image.png" class="image" style="width: 50px" alt="Image">',
+            'uid',
+            'message-3'
+        );
+        const result = parseStringToDOM(parseModelResult(markdown, 'message-3'));
+
+        expect(result.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(result.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(result.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(result.querySelector('img')?.getAttribute('style')).toBe('width: 50px');
+    });
+});
