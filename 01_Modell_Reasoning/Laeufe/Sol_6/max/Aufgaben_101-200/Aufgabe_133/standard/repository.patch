+func replaceOSSUserRole(roles []string, replacement string) ([]string, bool) {
+	updatedRoles := make([]string, len(roles))
+	replaced := false
+	for i, role := range roles {
+		if role == teleport.OSSUserRoleName {
+			role = replacement
+			replaced = true
+		}
+		updatedRoles[i] = role
+	}
+	if replaced {
+		updatedRoles = utils.Deduplicate(updatedRoles)
+	}
+	return updatedRoles, replaced
+}
