+// replaceOSSUserRoleMap replaces mappings left by the earlier OSS migration
+// while preserving any other mappings added since then.
+func replaceOSSUserRoleMap(roleMap types.RoleMap, replacement string) (types.RoleMap, bool) {
+	updatedMap := make(types.RoleMap, len(roleMap))
+	replaced := false
+	for i, mapping := range roleMap {
+		updatedMap[i] = mapping
+		updatedRoles, changed := replaceOSSUserRole(mapping.Local, replacement)
+		if changed {
+			updatedMap[i].Local = updatedRoles
+			replaced = true
+		}
+	}
+	return updatedMap, replaced
+}
