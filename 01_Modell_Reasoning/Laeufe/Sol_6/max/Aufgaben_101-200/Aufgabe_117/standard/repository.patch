+def test_locale_workaround_setting(config_stub):
+    option = configdata.DATA['qt.workarounds.locale']
+    assert option.default is False
+    assert option.backends == [usertypes.Backend.QtWebEngine]
+    assert option.restart
+
+
+def test_locale_pak_path(tmp_path):
+    locales_dir = tmp_path / 'qtwebengine_locales'
+    assert qtargs._get_locale_pak_path(locales_dir, 'es_MX') == (
+        locales_dir / 'es-MX.pak')
+
+
+@pytest.fixture
+def locale_paks(monkeypatch, tmp_path, config_stub):
+    """Provide a synthetic Qt translations directory."""
+    locales_dir = tmp_path / 'qtwebengine_locales'
+    locales_dir.mkdir()
+
+    class LibraryInfo:
+        TranslationsPath = object()
+
+        @staticmethod
+        def location(path):
+            assert path is LibraryInfo.TranslationsPath
+            return str(tmp_path)
+
+    monkeypatch.setattr(qtargs, 'QLibraryInfo', LibraryInfo)
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    config_stub.val.qt.workarounds.locale = True
+    return locales_dir
+
+
+@pytest.mark.parametrize('locale, paks, expected', [
+    ('en', ['en-US'], 'en-US'),
+    ('en-LR', ['en-US'], 'en-US'),
+    ('en-PH', ['en-US'], 'en-US'),
+    ('en-FJ', ['en-GB'], 'en-GB'),
+    ('en-GB', ['en-GB'], None),
+    ('en-AU', ['en-GB'], 'en-GB'),
+    ('en-CA', ['en-GB'], 'en-GB'),
+    ('en-IE', ['en-GB'], 'en-GB'),
+    ('en-IN', ['en-GB'], 'en-GB'),
+    ('en-NZ', ['en-GB'], 'en-GB'),
+    ('en-ZA', ['en-GB'], 'en-GB'),
+    ('en-ZW', ['en-GB'], 'en-GB'),
+    ('es', ['es'], None),
+    ('es-ES', ['es'], 'es'),
+    ('es_MX', ['es-419'], 'es-419'),
+    ('es-AR', ['es-419'], 'es-419'),
+    ('es-MX', ['es'], 'es'),
+    ('es-MX', [], 'en-US'),
+    ('pt', ['pt-BR'], 'pt-BR'),
+    ('pt-BR', ['pt-BR'], None),
+    ('pt-PT', ['pt-PT'], None),
+    ('pt-PT', ['pt'], 'pt'),
+    ('pt-AO', ['pt-PT'], 'pt-PT'),
+    ('zh', ['zh-CN'], 'zh-CN'),
+    ('zh-CN', ['zh-CN'], None),
+    ('zh-TW', ['zh-TW'], None),
+    ('zh-HK', ['zh-TW'], 'zh-TW'),
+    ('zh-HK', ['zh'], 'zh'),
+    ('zh-MO', ['zh-TW'], 'zh-TW'),
+    ('zh-SG', ['zh-CN'], 'zh-CN'),
+    ('de-CH', ['de'], 'de'),
+    ('unknown-XX', [], 'en-US'),
+    ('en-AU', ['en-US'], 'en-US'),
+])
+def test_lang_override(locale_paks, locale, paks, expected):
+    for name in paks:
+        qtargs._get_locale_pak_path(locale_paks, name).touch()
+    versions = version.WebEngineVersions.from_pyqt('5.15.3')
+    assert qtargs._get_lang_override(versions, locale) == expected
+
+
+@pytest.mark.parametrize('enabled, linux, qt_version, expected', [
