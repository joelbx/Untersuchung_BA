diff --git a/applications/drive/src/app/zustand/share/shareMemberStores.test.ts b/applications/drive/src/app/zustand/share/shareMemberStores.test.ts
new file mode 100644
index 0000000..cd04322
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/shareMemberStores.test.ts
@@ -0,0 +1,88 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from '../../store/_views/getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ memberId: email, email }) as ShareMember;
+const invitation = (email: string) => ({ invitationId: email, inviteeEmail: email }) as ShareInvitation;
+const externalInvitation = (email: string) =>
+    ({ externalInvitationId: email, inviteeEmail: email }) as ShareExternalInvitation;
+
+beforeEach(() => {
+    useMembersStore.setState({ members: {} });
+    useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+});
+
+describe('share member stores', () => {
+    it('replaces members for one share without changing another share', () => {
+        const { getMembers, setMembers } = useMembersStore.getState();
+        const memberA = member('a@example.com');
+        const memberB = member('b@example.com');
+
+        expect(getMembers('missing')).toEqual([]);
+        setMembers('shareA', [memberA]);
+        setMembers('shareB', [memberB]);
+        setMembers('shareA', []);
+
+        expect(getMembers('shareA')).toEqual([]);
+        expect(getMembers('shareB')).toEqual([memberB]);
+    });
+
+    it('isolates internal and external invitation changes for two shares', () => {
+        const {
+            getInvitations,
+            getExternalInvitations,
+            setInvitations,
+            setExternalInvitations,
+            updateInvitationsPermissions,
+            updateExternalInvitations,
+            removeInvitations,
+            removeExternalInvitations,
+            addMultipleInvitations,
+        } = useInvitationsStore.getState();
+        const internalA = invitation('internal-a@example.com');
+        const internalB = invitation('internal-b@example.com');
+        const externalA = externalInvitation('external-a@example.com');
+        const externalB = externalInvitation('external-b@example.com');
+
+        expect(getInvitations('missing')).toEqual([]);
+        expect(getExternalInvitations('missing')).toEqual([]);
+        setInvitations('shareA', [internalA]);
+        setExternalInvitations('shareA', [externalA]);
+        setInvitations('shareB', [internalB]);
+        setExternalInvitations('shareB', [externalB]);
+
+        const updatedA = { ...internalA, inviteeEmail: 'updated-a@example.com' };
+        const updatedExternalA = { ...externalA, inviteeEmail: 'updated-external-a@example.com' };
+        updateInvitationsPermissions('shareA', [updatedA]);
+        updateExternalInvitations('shareA', [updatedExternalA]);
+        expect(getInvitations('shareA')).toEqual([updatedA]);
+        expect(getExternalInvitations('shareA')).toEqual([updatedExternalA]);
+        expect(getInvitations('shareB')).toEqual([internalB]);
+        expect(getExternalInvitations('shareB')).toEqual([externalB]);
+
+        removeInvitations('shareA', []);
+        removeExternalInvitations('shareA', []);
+        expect(getInvitations('shareA')).toEqual([]);
+        expect(getExternalInvitations('shareA')).toEqual([]);
+        expect(getInvitations('shareB')).toEqual([internalB]);
+        expect(getExternalInvitations('shareB')).toEqual([externalB]);
+
+        addMultipleInvitations('shareA', [internalA], [externalA]);
+        expect(getInvitations('shareA')).toEqual([internalA]);
+        expect(getExternalInvitations('shareA')).toEqual([externalA]);
+        expect(getInvitations('shareB')).toEqual([internalB]);
+        expect(getExternalInvitations('shareB')).toEqual([externalB]);
+    });
+
+    it('combines email addresses from members and both invitation types', () => {
+        expect(
+            getExistingEmails(
+                [member('member@example.com')],
+                [invitation('internal@example.com')],
+                [externalInvitation('external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'internal@example.com', 'external@example.com']);
+        expect(getExistingEmails([], [], [])).toEqual([]);
+    });
+});
