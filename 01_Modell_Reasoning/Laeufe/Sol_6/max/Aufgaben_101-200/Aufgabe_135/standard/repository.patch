+@pytest.mark.parametrize('filter_name, selected_index, default_result, sensitive_result', (
+    ('min', 1, 'a', 'B'),
+    ('max', 0, 'B', 'a'),
+))
+def test_min_max_jinja_options(filter_name, selected_index, default_result, sensitive_result):
+    if getattr(ms, 'do_' + filter_name) is None:
+        pytest.skip('Jinja2 does not provide do_' + filter_name)
+
+    filter_func = getattr(ms, filter_name)
+    mounts = [{'block_total': 100}, {'block_total': 25}]
+    assert filter_func(env, mounts, attribute='block_total') is mounts[selected_index]
+    assert filter_func(env, ['a', 'B']) == default_result
+    assert filter_func(env, ['a', 'B'], case_sensitive=True) == sensitive_result
+
+    template_env = Environment()
+    template_env.filters.update(ms.FilterModule().filters())
+    template = template_env.from_string('{{ (mounts | %s(attribute="block_total")).block_total }}' % filter_name)
+    assert template.render(mounts=mounts) == str(mounts[selected_index]['block_total'])
+
+
+@pytest.mark.parametrize('filter_name', ('min', 'max'))
+def test_min_max_forwards_all_kwargs(monkeypatch, filter_name):
+    calls = []
+
+    def jinja_filter(environment, values, **kwargs):
+        calls.append((environment, values, kwargs))
+        return 'selected'
+
+    monkeypatch.setattr(ms, 'do_' + filter_name, jinja_filter)
+    values = [{'block_total': 25}]
+    kwargs = {'attribute': 'block_total', 'case_sensitive': True, 'future_option': 'value'}
+    assert getattr(ms, filter_name)(env, values, **kwargs) == 'selected'
+    assert calls == [(env, values, kwargs)]
+
+
+@pytest.mark.parametrize('filter_name, expected', (('min', 'B'), ('max', 'a')))
+def test_min_max_without_jinja_filter(monkeypatch, filter_name, expected):
+    monkeypatch.setattr(ms, 'do_' + filter_name, None)
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, ['a', 'B']) == expected
+
+    message = ("Ansible's %s filter does not support any keyword arguments. "
+               "You need Jinja2 2.10 or later that provides their version of the filter." % filter_name)
+    for kwargs in ({'attribute': None}, {'case_sensitive': False}, {'future_option': 'value'}):
+        with pytest.raises(AnsibleFilterError) as exc:
+            filter_func(env, ['a', 'B'], **kwargs)
+        assert exc.value.message == message
 
 
