+func TestImport_JSONSkipsOnlyFirstCommentLine(t *testing.T) {
+	for _, input := range []string{
+		"# first\n# second\n{}",
+		" # leading space\n{}",
+		"{}\n# trailing",
+	} {
+		t.Run(input, func(t *testing.T) {
+			err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, strings.NewReader(input), false)
+			require.Error(t, err)
+		})
+	}
+}
