+func TestImport_NestedMetadataAndNamespace(t *testing.T) {
+	const yamlInput = `version: "1.4"
+namespace:
+  key: team
+  name: Team
+  description: Team flags
+flags:
+  - key: nested
+    name: Nested
+    enabled: true
+    metadata:
+      context:
+        owners:
+          - name: Anna
+            active: true
+          - name: Ben
+        thresholds: [1, 2.5]
+        settings:
+          mode: safe
+      empty: null
+    variants:
+      - key: detailed
+        attachment:
+          nested:
+            values:
+              - tag: alpha
+              - tag: beta
+`
+	const jsonInput = `{
+  "version": "1.4",
+  "namespace": {"key": "team", "name": "Team", "description": "Team flags"},
+  "flags": [{
+    "key": "nested", "name": "Nested", "enabled": true,
+    "metadata": {
+      "context": {
+        "owners": [{"name": "Anna", "active": true}, {"name": "Ben"}],
+        "thresholds": [1, 2.5],
+        "settings": {"mode": "safe"}
+      },
+      "empty": null
+    },
+    "variants": [{"key": "detailed", "attachment": {
+      "nested": {"values": [{"tag": "alpha"}, {"tag": "beta"}]}
+    }}]
+  }]
+}`
+
+	for _, tc := range []struct {
+		name     string
+		encoding Encoding
+		input    string
+	}{
+		{"YML", EncodingYML, yamlInput},
+		{"YAML", EncodingYAML, yamlInput},
+		{"YAML with comment", EncodingYAML, "# exported flags\n" + yamlInput},
+		{"JSON", EncodingJSON, jsonInput},
+		{"JSON with header", EncodingJSON, "# exported flags\n" + jsonInput},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "namespace not found")}
+			err := NewImporter(creator).Import(context.Background(), tc.encoding, strings.NewReader(tc.input), false)
+			require.NoError(t, err)
+			require.Equal(t, []*flipt.GetNamespaceRequest{{Key: "team"}}, creator.getNSReqs)
+			require.Equal(t, []*flipt.CreateNamespaceRequest{{
+				Key: "team", Name: "Team", Description: "Team flags",
+			}}, creator.createNSReqs)
+			require.Len(t, creator.createflagReqs, 1)
+			flag := creator.createflagReqs[0]
+			require.Equal(t, "team", flag.NamespaceKey)
+			require.Equal(t, "nested", flag.Key)
+			require.Equal(t, map[string]any{
+				"context": map[string]any{
+					"owners": []any{
+						map[string]any{"name": "Anna", "active": true},
+						map[string]any{"name": "Ben"},
+					},
+					"thresholds": []any{float64(1), 2.5},
+					"settings":   map[string]any{"mode": "safe"},
+				},
+				"empty": nil,
+			}, flag.Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			require.Equal(t, "team", creator.variantReqs[0].NamespaceKey)
+			require.JSONEq(t, `{"nested":{"values":[{"tag":"alpha"},{"tag":"beta"}]}}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
