index 0000000..824989e
--- /dev/null
+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,128 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	"oras.land/oras-go/v2/content/oci"
+)
+
+func TestSourceGetLocalUpdates(t *testing.T) {
+	dir := t.TempDir()
+	writeBundle(t, dir, "first", `{"flags":[{"key":"first","name":"First"}]}`)
+	source := newTestSource(t, dir)
+	ctx := context.Background()
+
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "production", "first")
+	require.NoError(t, err)
+
+	again, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, again, "an unchanged digest must reuse the snapshot")
+
+	// A different OCI target simulates a process updating the layout on disk.
+	writeBundle(t, dir, "second", `{"flags":[{"key":"second","name":"Second"}]}`)
+	updated, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.NotSame(t, first, updated)
+	_, err = updated.GetFlag(ctx, "production", "second")
+	require.NoError(t, err)
+	_, err = updated.GetFlag(ctx, "production", "first")
+	require.Error(t, err)
+
+	namespace, err := updated.GetNamespace(ctx, "production")
+	require.NoError(t, err)
+	require.Equal(t, time.Date(2024, 1, 2, 3, 4, 5, 0, time.UTC), namespace.CreatedAt.AsTime())
+}
+
+func TestSourceSubscribeOnlyChanges(t *testing.T) {
+	dir := t.TempDir()
+	writeBundle(t, dir, "first", `{"flags":[{"key":"first","name":"First"}]}`)
+	source := newTestSource(t, dir, WithPollInterval(20*time.Millisecond))
+	_, err := source.Get(context.Background())
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ch := make(chan *storagefs.StoreSnapshot)
+	go source.Subscribe(ctx, ch)
+
+	select {
+	case <-ch:
+		t.Fatal("unchanged bundle produced a snapshot")
+	case <-time.After(80 * time.Millisecond):
+	}
+
+	writeBundle(t, dir, "second", `{"flags":[{"key":"second","name":"Second"}]}`)
+	select {
+	case snapshot := <-ch:
+		_, err := snapshot.GetFlag(ctx, "production", "second")
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("updated bundle was not published")
+	}
+
+	select {
+	case <-ch:
+		t.Fatal("unchanged bundle was published twice")
+	case <-time.After(80 * time.Millisecond):
+	}
+	cancel()
+	select {
+	case _, open := <-ch:
+		require.False(t, open)
+	case <-time.After(time.Second):
+		t.Fatal("subscription did not stop on cancellation")
+	}
+}
+
+func newTestSource(t *testing.T, dir string, opts ...containers.Option[Source]) *Source {
+	t.Helper()
+	store, err := fliptoci.NewStore(&config.OCI{
+		BundleDirectory: dir,
+		Repository:      "flipt://local/bundle:latest",
+	})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, opts...)
+	require.NoError(t, err)
+	return source
+}
+
+func writeBundle(t *testing.T, dir, name, payload string) {
+	t.Helper()
+	store, err := oci.New(filepath.Join(dir, "bundle"))
+	require.NoError(t, err)
+	store.AutoSaveIndex = true
+	ctx := context.Background()
+	content := []byte(payload)
+	layer := v1.Descriptor{
+		MediaType: fliptoci.MediaTypeFliptNamespace,
+		Digest:    digest.FromBytes(content),
+		Size:      int64(len(content)),
+		Annotations: map[string]string{
+			fliptoci.AnnotationFliptNamespace: "production",
+			"test.layer":                      name,
+		},
+	}
+	require.NoError(t, store.Push(ctx, layer, bytes.NewReader(content)))
+	desc, err := oras.PackManifest(ctx, store, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{
+		ManifestAnnotations: map[string]string{v1.AnnotationCreated: "2024-01-02T03:04:05Z"},
+		Layers:              []v1.Descriptor{layer},
+	})
+	require.NoError(t, err)
+	require.NoError(t, store.Tag(ctx, desc, "latest"))
+}
