+func TestStore_FetchGzipFeatures(t *testing.T) {
+	payload := []byte("flags:\n  - key: foo\n    name: Foo\n")
+	var compressed bytes.Buffer
+	writer := gzip.NewWriter(&compressed)
+	_, err := writer.Write(payload)
+	require.NoError(t, err)
+	require.NoError(t, writer.Close())
+
+	dir, repo := testRepository(t, func(t *testing.T, store oras.Target) v1.Descriptor {
+		desc := v1.Descriptor{
+			Digest:    digest.FromBytes(compressed.Bytes()),
+			Size:      int64(compressed.Len()),
+			MediaType: MediaTypeFliptFeatures + "+yaml+gzip",
+			Annotations: map[string]string{
+				AnnotationFliptNamespace: "production",
+			},
+		}
+		require.NoError(t, store.Push(context.Background(), desc, bytes.NewReader(compressed.Bytes())))
+		return desc
+	})
+	store, err := NewStore(&config.OCI{
+		BundleDirectory: dir,
+		Repository:      fmt.Sprintf("flipt://local/%s:latest", repo),
+	})
+	require.NoError(t, err)
