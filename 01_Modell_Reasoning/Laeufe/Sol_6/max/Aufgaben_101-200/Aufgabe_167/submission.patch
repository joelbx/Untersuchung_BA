diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..50a80d2
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,136 @@
+package oci
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+// Source tracks a feature bundle in an OCI layout or remote registry.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+// NewSource constructs an OCI snapshot source.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if store == nil {
+		return nil, errors.New("OCI store is required")
+	}
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	source := &Source{
+		logger:   logger,
+		store:    store,
+		interval: 30 * time.Second,
+	}
+	containers.ApplyAll(source, opts...)
+	if source.interval <= 0 {
+		return nil, errors.New("OCI poll interval must be positive")
+	}
+	return source, nil
+}
+
+// WithPollInterval configures how often a source checks for changes.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) {
+		s.interval = tick
+	}
+}
+
+// String returns the source identifier.
+func (*Source) String() string {
+	return "oci"
+}
+
+// Get returns the current snapshot, fetching a new one when the bundle changes.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	snapshot, _, err := s.get(ctx)
+	return snapshot, err
+}
+
+func (s *Source) get(ctx context.Context) (*storagefs.StoreSnapshot, digest.Digest, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.logger.Debug("fetching OCI snapshot", zap.String("digest", s.digest.String()))
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, "", err
+	}
+	if response.Matched && s.snapshot != nil {
+		s.logger.Debug("OCI snapshot unchanged", zap.String("digest", s.digest.String()))
+		return s.snapshot, s.digest, nil
+	}
+
+	if err := ctx.Err(); err != nil {
+		for _, file := range response.Files {
+			file.Close()
+		}
+		return nil, "", err
+	}
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, "", err
+	}
+
+	s.snapshot = snapshot
+	s.digest = response.Digest
+	s.logger.Debug("updated OCI snapshot", zap.String("digest", s.digest.String()))
+	return snapshot, s.digest, nil
+}
+
+// Subscribe sends a snapshot when the tracked content digest changes.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+
+	s.mu.Lock()
+	previous := s.digest
+	s.mu.Unlock()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			snapshot, current, err := s.get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				s.logger.Error("failed polling OCI snapshot", zap.Error(err))
+				continue
+			}
+			if current == previous {
+				continue
+			}
+			previous = current
+			s.logger.Debug("publishing OCI snapshot", zap.String("digest", current.String()))
+			select {
+			case ch <- snapshot:
+			case <-ctx.Done():
+				return
+			}
+		}
+	}
+}
