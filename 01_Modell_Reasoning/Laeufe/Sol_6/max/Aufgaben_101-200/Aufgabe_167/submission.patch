+		Authentication: &config.OCIAuthentication{
+			Username: "user",
+			Password: "pass",
+		},
+	})
+	require.NoError(t, err)
+	response, err := store.Fetch(ctx)
+	require.NoError(t, err)
+	require.Len(t, response.Files, 1)
+	defer response.Files[0].Close()
+	actual, err := io.ReadAll(response.Files[0])
