+def add_db_name(rec: dict) -> None:
+    """Add each author's name and available dates as ``db_name`` in place."""
+    for author in rec.get('authors') or []:
+        name = author.get('name') or author.get('db_name', '')
+        date = author.get('date')
+        if not date and (author.get('birth_date') or author.get('death_date')):
+            date = f"{author.get('birth_date') or ''}-{author.get('death_date') or ''}"
+        author['db_name'] = f'{name} {date}' if date else name
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare an import record with an edition.
+
+    Already expanded records are accepted so callers can pass either form.
+    """
+    title = rec.get('title') or ''
+    if title:
+        prefix = rec.get('title_prefix') or ''
+        if prefix and not title.startswith(prefix):
+            title = f'{prefix.rstrip()} {title}'
+        if subtitle := rec.get('subtitle'):
+            title = f'{title} {subtitle}'
+    full_title = title or rec.get('full_title') or ''
+    expanded = build_titles(full_title) if full_title else {
+        'full_title': '',
+        'normalized_title': '',
+        'titles': [],
+        'short_title': '',
+    }
+
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        expanded['isbn'].extend(
+            value for value in ([values] if isinstance(values, str) else values) if value
+        )
+
+    if rec.get('publish_country') and rec['publish_country'] not in ('   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if field in rec:
+            expanded[field] = rec[field]
+
+    for field in ('authors', 'contribs'):
+        if expanded.get(field):
+            expanded[field] = [person.copy() for person in expanded[field]]
+            add_db_name({'authors': expanded[field]})
+    return expanded
+
+
