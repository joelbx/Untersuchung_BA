+import { MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import { shouldForceDisableEncryption } from "../../src/utils/room/shouldForceDisableEncryption";
+import { privateShouldBeEncrypted } from "../../src/utils/rooms";
+
+describe("new room encryption .well-known policy", () => {
+    const getClientWellKnown = jest.fn();
+    const client = { getClientWellKnown } as unknown as MatrixClient;
+
+    it.each([
+        [null, false],
+        [{}, false],
+        [{ "io.element.e2ee": {} }, false],
+        [{ "io.element.e2ee": { force_disable: false } }, false],
+        [{ "io.element.e2ee": { force_disable: "true" } }, false],
+        [{ "io.element.e2ee": { force_disable: 1 } }, false],
+        [{ "io.element.e2ee": { force_disable: true } }, true],
+        [{ "im.vector.riot.e2ee": { force_disable: true } }, true],
+    ])("recognizes force-disable only when explicitly true in %p", (wellKnown, expected) => {
+        getClientWellKnown.mockReturnValue(wellKnown);
+        expect(shouldForceDisableEncryption(client)).toBe(expected);
+    });
+
+    it.each([
+        [null, true],
+        [{ "io.element.e2ee": { default: true } }, true],
+        [{ "io.element.e2ee": { default: false } }, false],
+        [{ "io.element.e2ee": { default: true, force_disable: true } }, false],
+        [{ "io.element.e2ee": { default: false, force_disable: false } }, false],
+    ])("applies forced disable before the encryption default in %p", (wellKnown, expected) => {
+        getClientWellKnown.mockReturnValue(wellKnown);
+        expect(privateShouldBeEncrypted(client)).toBe(expected);
+    });
+});
