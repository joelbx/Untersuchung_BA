+describe("checkUserIsAllowedToChangeEncryption", () => {
+    const getClientWellKnown = jest.fn();
+    const doesServerForceEncryptionForPreset = jest.fn();
+    const client = { getClientWellKnown, doesServerForceEncryptionForPreset } as unknown as MatrixClient;
+
+    beforeEach(() => {
+        getClientWellKnown.mockReturnValue(null);
+        doesServerForceEncryptionForPreset.mockResolvedValue(false);
+    });
+
+    it("allows changes when neither policy forces encryption", async () => {
+        await expect(checkUserIsAllowedToChangeEncryption(client, Preset.PrivateChat)).resolves.toEqual({
+            allowChange: true,
+        });
+        expect(doesServerForceEncryptionForPreset).toHaveBeenCalledWith(Preset.PrivateChat);
+    });
+
+    it("enforces server-enabled encryption", async () => {
+        doesServerForceEncryptionForPreset.mockResolvedValue(true);
+
+        await expect(checkUserIsAllowedToChangeEncryption(client, Preset.TrustedPrivateChat)).resolves.toEqual({
+            allowChange: false,
+            forcedValue: true,
+        });
+        expect(doesServerForceEncryptionForPreset).toHaveBeenCalledWith(Preset.TrustedPrivateChat);
+    });
+
+    it("enforces .well-known-disabled encryption", async () => {
+        getClientWellKnown.mockReturnValue({ "io.element.e2ee": { force_disable: true } });
+
+        await expect(checkUserIsAllowedToChangeEncryption(client, Preset.PrivateChat)).resolves.toEqual({
+            allowChange: false,
+            forcedValue: false,
+        });
+    });
+
+    it("prefers the server policy and warns when it conflicts with .well-known", async () => {
+        getClientWellKnown.mockReturnValue({ "io.element.e2ee": { force_disable: true } });
+        doesServerForceEncryptionForPreset.mockResolvedValue(true);
+        const warn = jest.spyOn(console, "warn").mockImplementation();
+
+        try {
+            await expect(checkUserIsAllowedToChangeEncryption(client, Preset.PrivateChat)).resolves.toEqual({
+                allowChange: false,
+                forcedValue: true,
+            });
+            expect(warn).toHaveBeenCalledWith(expect.stringContaining("Conflicting encryption policies"));
+        } finally {
+            warn.mockRestore();
+        }
+    });
+});
