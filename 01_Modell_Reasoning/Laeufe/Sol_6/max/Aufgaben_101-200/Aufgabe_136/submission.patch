+    ),
+    (
+        [FakeError('A & B'), FakeError('C < D "quote" \'single\'')],
+        [
+            '<ul>',
+            '<li>A &amp; B</li>',
+            '<li>C &lt; D &quot;quote&quot; &#x27;single&#x27;</li>',
+            '</ul>',
