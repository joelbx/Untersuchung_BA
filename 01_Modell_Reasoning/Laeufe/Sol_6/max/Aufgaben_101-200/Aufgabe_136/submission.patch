+    ),
 ])
 def test_html(errors, expected):
     wrapper = certificateerror.CertificateErrorWrapper(errors)
     lines = [line.strip() for line in wrapper.html().splitlines() if line.strip()]
     assert lines == expected
+
+
+@pytest.mark.parametrize('use_keywords', [False, True])
+def test_reply_is_only_used_when_certificate_is_accepted(mocker, use_keywords):
+    reply = mocker.Mock()
+    errors = [FakeError('Certificate error')]
+    if use_keywords:
+        wrapper = certificateerror.CertificateErrorWrapper(reply=reply, errors=errors)
+    else:
+        wrapper = certificateerror.CertificateErrorWrapper(reply, errors)
+
+    reply.ignoreSslErrors.assert_not_called()
+    assert wrapper.certificate_was_accepted() is False
+
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
+    assert wrapper.certificate_was_accepted() is True
+
+    wrapper.reject_certificate()
+    assert wrapper.certificate_was_accepted() is False
+    reply.ignoreSslErrors.assert_called_once_with()
