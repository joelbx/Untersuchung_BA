+// disableAutoScalingForOnDemandTable uses the actual mode for an existing table
+// and the configured mode for a table that will be created.
+func (b *Backend) disableAutoScalingForOnDemandTable(status tableStatus, billingMode string) {
+	switch {
+	case status == tableStatusOK && billingMode == dynamodb.BillingModePayPerRequest:
+		b.Warn("auto_scaling is ignored because the table is on-demand.")
+		b.EnableAutoScaling = false
+	case status == tableStatusMissing && (b.BillingMode == "" || b.BillingMode == billingModePayPerRequest):
+		b.Warn("auto_scaling is ignored because the table will be on-demand.")
+		b.EnableAutoScaling = false
+	}
+}
