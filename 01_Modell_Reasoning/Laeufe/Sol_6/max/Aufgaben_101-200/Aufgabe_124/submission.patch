+func TestBillingModeConfig(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		mode string
+		want string
+		err  bool
+	}{
+		{name: "default", want: billingModePayPerRequest},
+		{name: "on-demand", mode: billingModePayPerRequest, want: billingModePayPerRequest},
+		{name: "provisioned", mode: billingModeProvisioned, want: billingModeProvisioned},
+		{name: "invalid", mode: "invalid", err: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: tt.mode}
+			err := cfg.CheckAndSetDefaults()
+			if tt.err {
+				require.True(t, trace.IsBadParameter(err))
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.want, cfg.BillingMode)
+		})
+	}
+}
