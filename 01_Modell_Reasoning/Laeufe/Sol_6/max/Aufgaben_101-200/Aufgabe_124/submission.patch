+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		mode       string
+		wantMode   string
+		throughput bool
+	}{
+		{name: "default on-demand", wantMode: dynamodb.BillingModePayPerRequest},
+		{name: "explicit on-demand", mode: billingModePayPerRequest, wantMode: dynamodb.BillingModePayPerRequest},
+		{name: "provisioned", mode: billingModeProvisioned, wantMode: dynamodb.BillingModeProvisioned, throughput: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: tt.mode, ReadCapacityUnits: 23, WriteCapacityUnits: 45}
+			require.NoError(t, cfg.CheckAndSetDefaults())
+			svc := &tableAPI{}
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: cfg, svc: svc}
+			require.NoError(t, b.createTable(context.Background(), cfg.TableName, fullPathKey))
+			require.True(t, svc.waited)
+			require.Equal(t, cfg.TableName, aws.StringValue(svc.createInput.TableName))
+			require.Equal(t, tt.wantMode, aws.StringValue(svc.createInput.BillingMode))
+			if tt.throughput {
+				require.NotNil(t, svc.createInput.ProvisionedThroughput)
+				require.Equal(t, int64(23), aws.Int64Value(svc.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(45), aws.Int64Value(svc.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
