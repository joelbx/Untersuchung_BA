+func TestOnDemandDisablesAutoScaling(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		status   tableStatus
+		config   string
+		actual   string
+		auto     bool
+		wantAuto bool
+		wantLog  string
+	}{
+		{name: "existing on-demand", status: tableStatusOK, config: billingModeProvisioned, actual: dynamodb.BillingModePayPerRequest, auto: true, wantLog: "auto_scaling is ignored because the table is on-demand"},
+		{name: "new on-demand", status: tableStatusMissing, config: billingModePayPerRequest, auto: true, wantLog: "auto_scaling is ignored because the table will be on-demand"},
+		{name: "new default on-demand", status: tableStatusMissing, auto: true, wantLog: "auto_scaling is ignored because the table will be on-demand"},
+		{name: "on-demand without auto scaling", status: tableStatusOK, config: billingModePayPerRequest, actual: dynamodb.BillingModePayPerRequest, wantLog: "auto_scaling is ignored because the table is on-demand"},
+		{name: "existing provisioned", status: tableStatusOK, config: billingModePayPerRequest, actual: dynamodb.BillingModeProvisioned, auto: true, wantAuto: true},
+		{name: "legacy provisioned", status: tableStatusOK, config: billingModePayPerRequest, auto: true, wantAuto: true},
+		{name: "new provisioned", status: tableStatusMissing, config: billingModeProvisioned, auto: true, wantAuto: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			var output bytes.Buffer
+			logger := log.New()
+			logger.SetOutput(&output)
+			b := &Backend{Entry: log.NewEntry(logger), Config: Config{BillingMode: tt.config, EnableAutoScaling: tt.auto}}
+			b.disableAutoScalingForOnDemandTable(tt.status, tt.actual)
+			require.Equal(t, tt.wantAuto, b.EnableAutoScaling)
+			if tt.wantLog != "" {
+				require.True(t, strings.Contains(output.String(), tt.wantLog), output.String())
+			} else {
+				require.Empty(t, output.String())
+			}
+		})
+	}
+}
