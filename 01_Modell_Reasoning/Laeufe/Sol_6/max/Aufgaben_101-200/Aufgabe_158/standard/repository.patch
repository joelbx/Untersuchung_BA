+    @staticmethod
+    def _valid_time_stamp(time_stamp):
+        # ZIP timestamps can only represent dates from 1980 through 2107.
+        default_time_stamp = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        if not isinstance(time_stamp, str):
+            return default_time_stamp
+
+        match = re.fullmatch(r'([0-9]{4})([0-9]{2})([0-9]{2})\.([0-9]{2})([0-9]{2})([0-9]{2})', time_stamp)
+        if match is None:
+            return default_time_stamp
+
+        year, month, day, hour, minute, second = (int(value) for value in match.groups())
+        if not 1980 <= year <= 2107:
+            return default_time_stamp
+
+        try:
+            return datetime.datetime(year, month, day, hour, minute, second).timetuple()
+        except ValueError:
+            return default_time_stamp
+
