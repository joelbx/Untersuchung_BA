diff --git a/internal/cmd/auth_test.go b/internal/cmd/auth_test.go
new file mode 100644
index 0000000..e37da36
--- /dev/null
+++ b/internal/cmd/auth_test.go
@@ -0,0 +1,33 @@
+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+func TestAuthenticationGRPCWithoutDatabaseStorage(t *testing.T) {
+	for _, storageType := range []config.StorageType{
+		config.GitStorageType,
+		config.LocalStorageType,
+		config.ObjectStorageType,
+	} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := config.DefaultConfig()
+			cfg.Storage.Type = storageType
+			cfg.Database.URL = "invalid://database"
+
+			register, interceptors, shutdown, err := authenticationGRPC(
+				context.Background(), zap.NewNop(), cfg, false,
+			)
+
+			require.NoError(t, err)
+			require.Len(t, register, 2)
+			require.Empty(t, interceptors)
+			require.NoError(t, shutdown(context.Background()))
+		})
+	}
+}
