+def test_build_manifest_directives_skip_external_symlink(tmp_path, monkeypatch):
+    input_dir = tmp_path / 'collection'
+    input_dir.mkdir()
+    source_file = input_dir / 'source.txt'
+    source_file.write_text('included')
+    inside_link = input_dir / 'inside.txt'
+    inside_link.symlink_to(source_file)
+
+    outside_file = tmp_path / 'outside.txt'
+    outside_file.write_text('excluded')
+    outside_link = input_dir / 'outside.txt'
+    outside_link.symlink_to(outside_file)
+
+    manifest_class = MagicMock()
+    manifest_class.return_value.sorted.return_value = [str(inside_link), str(outside_link)]
+    monkeypatch.setattr(collection, 'HAS_DISTLIB', True)
+    monkeypatch.setattr(collection, 'Manifest', manifest_class, raising=False)
+
+    actual = collection._build_files_manifest(
+        to_bytes(str(input_dir)), 'namespace', 'collection', [],
+        {'omit_default_directives': True, 'directives': ['include *.txt']},
+    )
+
+    assert actual['format'] == 1
+    assert [entry['name'] for entry in actual['files']] == ['.', 'inside.txt']
+
