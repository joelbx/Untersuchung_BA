diff --git a/openlibrary/tests/test_book_providers.py b/openlibrary/tests/test_book_providers.py
new file mode 100644
index 0000000..f0bf233
--- /dev/null
+++ b/openlibrary/tests/test_book_providers.py
@@ -0,0 +1,27 @@
+from openlibrary.book_providers import (
+    ProjectRunebergProvider,
+    get_book_provider,
+    get_book_provider_by_name,
+    is_non_ia_ocaid,
+)
+
+
+def test_project_runeberg_provider():
+    edition = {
+        'key': '/books/OL1M',
+        'identifiers': {'project_runeberg': ['nordic/1900', 'nordic/1901']},
+    }
+    provider = get_book_provider_by_name('runeberg')
+
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert get_book_provider(edition) is provider
+    assert provider.is_own_ocaid('project_runeberg_nordic1900')
+    assert is_non_ia_ocaid('project_runeberg_nordic1900')
+    assert not provider.is_own_ocaid('unrelated_archive')
+
+    acquisitions = provider.get_acquisitions(edition)
+    assert len(acquisitions) == 1
+    assert acquisitions[0].access == 'open-access'
+    assert acquisitions[0].format == 'web'
+    assert acquisitions[0].url == 'https://runeberg.org/nordic/1900/'
+    assert acquisitions[0].provider_name == 'runeberg'
