+def test_get_doc_preserves_identifiers_with_runeberg():
+    doc = get_doc(
+        {
+            'key': '/works/OL1W',
+            'title': 'Nordic stories',
+            'edition_count': 2,
+            'id_project_runeberg': ['nordic/1900', 'nordic/1901'],
