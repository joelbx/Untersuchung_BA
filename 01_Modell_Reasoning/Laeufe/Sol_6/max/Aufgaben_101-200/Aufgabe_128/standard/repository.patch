--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,99 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_with_and_without_explicit_match(self):
+        """The set extension is loaded once and uses the same rule in both forms."""
+        for match in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'destination_port': '22',
+                'match': match,
+                'match_set': 'admin_hosts',
+                'match_set_flags': 'src',
+                'jump': 'ACCEPT',
+                'comment': 'SSH administrators',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.side_effect = [(1, '', ''), (0, '', '')]
+                with self.assertRaises(AnsibleExitJson) as result:
+                    iptables.main()
+
+            self.assertTrue(result.exception.args[0]['changed'])
+            self.assertEqual(run_command.call_count, 2)
+            rule = [
+                '-p', 'tcp',
+                '-m', 'set', '--match-set', 'admin_hosts', 'src',
+                '--destination-port', '22',
+                '-j', 'ACCEPT',
+                '-m', 'comment', '--comment', 'SSH administrators',
+            ]
+            self.assertEqual(result.exception.args[0]['rule'], ' '.join(rule))
+            self.assertEqual(run_command.call_args_list[0][0][0],
+                             ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'] + rule)
+            self.assertEqual(run_command.call_args_list[1][0][0],
+                             ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'] + rule)
+
+    def test_match_set_flags_and_match_order(self):
+        """Every supported flag is emitted beside its explicit set match."""
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'match': ['set', 'tcp'],
+                'match_set': 'admin_hosts',
+                'match_set_flags': flags,
+                'jump': 'ACCEPT',
+                '_ansible_check_mode': True,
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (1, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_count, 1)
+            self.assertEqual(run_command.call_args[0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-p', 'tcp',
+                '-m', 'set', '--match-set', 'admin_hosts', flags,
+                '-m', 'tcp',
+                '-j', 'ACCEPT',
+            ])
+
+    def test_match_set_inverted(self):
+        """A leading exclamation mark inverts the set membership test."""
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': '!admin_hosts',
+            'match_set_flags': 'dst,src',
+            'jump': 'DROP',
+            '_ansible_check_mode': True,
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (1, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'dst,src',
+            '-j', 'DROP',
+        ])
+
+    def test_match_set_requires_name_and_flags(self):
+        """Incomplete and invalid set matches fail before running iptables."""
+        for options in (
+            {'match_set': 'admin_hosts'},
+            {'match_set_flags': 'src'},
+            {'match_set': 'admin_hosts', 'match_set_flags': 'source'},
+            {'match_set': '', 'match_set_flags': 'src'},
+            {'match_set': '!', 'match_set_flags': 'src'},
+        ):
+            args = {'chain': 'INPUT'}
+            args.update(options)
+            set_module_args(args)
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_count, 0)
