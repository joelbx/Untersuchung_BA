@@ -0,0 +1,52 @@
+package cmd
+
+import (
+	"context"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestPruneRequiresConfirmationWhenCountIsZero(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "navidrome_backup_20240101T000000.000000000Z.db")
+	if err := os.WriteFile(path, []byte("backup"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := conf.Server.Backup
+	conf.Server.Backup.Path = dir
+	conf.Server.Backup.Count = 0
+	t.Cleanup(func() { conf.Server.Backup = old })
+	backupPruneCmd.SetIn(strings.NewReader("no\n"))
+	backupPruneCmd.SetOut(io.Discard)
+	backupPruneCmd.SetContext(context.Background())
+	if err := backupPruneCmd.RunE(backupPruneCmd, nil); err == nil {
+		t.Fatal("prune continued after confirmation was declined")
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("backup was deleted without confirmation: %v", err)
+	}
+	if err := backupPruneCmd.Flags().Set("force", "true"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = backupPruneCmd.Flags().Set("force", "false") })
+	if err := backupPruneCmd.RunE(backupPruneCmd, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("backup still exists after forced prune: %v", err)
+	}
+}
+
+func TestRestoreRequiresConfirmation(t *testing.T) {
+	backupRestoreCmd.SetIn(strings.NewReader("no\n"))
+	backupRestoreCmd.SetOut(io.Discard)
+	backupRestoreCmd.SetContext(context.Background())
+	if err := backupRestoreCmd.RunE(backupRestoreCmd, nil); err == nil || !strings.Contains(err.Error(), "cancelled") {
+		t.Fatalf("restore proceeded without confirmation: %v", err)
+	}
+}
