@@ -0,0 +1,50 @@
+package conf
+
+import (
+	"testing"
+
+	"github.com/spf13/viper"
+)
+
+func TestBackupConfigFields(t *testing.T) {
+	v := viper.New()
+	v.Set("backup.path", "/tmp/backups")
+	v.Set("backup.schedule", "24h")
+	v.Set("backup.count", 7)
+	var config *configOptions
+	if err := v.Unmarshal(&config); err != nil {
+		t.Fatal(err)
+	}
+	if config.Backup.Path != "/tmp/backups" || config.Backup.Schedule != "24h" || config.Backup.Count != 7 {
+		t.Fatalf("backup options were not loaded: %+v", config.Backup)
+	}
+}
+
+func TestValidateBackupSchedule(t *testing.T) {
+	old := Server.Backup.Schedule
+	t.Cleanup(func() { Server.Backup.Schedule = old })
+	for _, test := range []struct {
+		input string
+		want  string
+		valid bool
+	}{
+		{"", "", true},
+		{"5m", "@every 5m", true},
+		{"@daily", "@daily", true},
+		{"0 2 * * *", "0 2 * * *", true},
+		{"0", "", false},
+		{"@every 0s", "", false},
+		{"not a schedule", "", false},
+	} {
+		t.Run(test.input, func(t *testing.T) {
+			Server.Backup.Schedule = test.input
+			err := validateBackupSchedule()
+			if (err == nil) != test.valid {
+				t.Fatalf("validateBackupSchedule(%q) error = %v", test.input, err)
+			}
+			if test.valid && Server.Backup.Schedule != test.want {
+				t.Fatalf("normalized schedule = %q, want %q", Server.Backup.Schedule, test.want)
+			}
+		})
+	}
+}
diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..97fc1a0
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,215 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const (
+	backupPrefix    = "navidrome_backup_"
+	backupTimestamp = "20060102T150405.000000000Z"
+)
+
+// Backup creates an online, consistent copy of the current SQLite database.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return "", errors.New("backup.path is not configured")
+	}
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	file, err := os.CreateTemp(dir, ".navidrome_backup_*.tmp")
+	if err != nil {
+		return "", fmt.Errorf("create temporary backup: %w", err)
+	}
+	tmpPath := file.Name()
+	if err := file.Close(); err != nil {
+		_ = os.Remove(tmpPath)
+		return "", err
+	}
+	defer os.Remove(tmpPath)
+
+	dest, err := sql.Open(Driver, tmpPath)
+	if err != nil {
+		return "", fmt.Errorf("open temporary backup: %w", err)
+	}
+	srcConn, err := d.readDB.Conn(ctx)
+	if err != nil {
+		_ = dest.Close()
+		return "", fmt.Errorf("open source database: %w", err)
+	}
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		_ = srcConn.Close()
+		_ = dest.Close()
+		return "", fmt.Errorf("open temporary backup connection: %w", err)
+	}
+	err = sqliteCopy(ctx, destConn, srcConn)
+	err = errors.Join(err, destConn.Close(), srcConn.Close(), dest.Close())
+	if err != nil {
+		return "", fmt.Errorf("copy database to backup: %w", err)
+	}
+	info, err := os.Stat(tmpPath)
+	if err != nil {
+		return "", fmt.Errorf("inspect temporary backup: %w", err)
+	}
+	if info.Size() == 0 {
+		return "", errors.New("source database is empty")
+	}
+
+	path := filepath.Join(dir, backupPrefix+time.Now().UTC().Format(backupTimestamp)+".db")
+	if err := os.Rename(tmpPath, path); err != nil {
+		return "", fmt.Errorf("publish backup: %w", err)
+	}
+	return path, nil
+}
+
+// Restore replaces the live SQLite database from a valid backup file.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file path is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return fmt.Errorf("access backup file: %w", err)
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	if info.Size() == 0 {
+		return fmt.Errorf("backup file is empty: %s", path)
+	}
+	currentPath := conf.Server.DbPath
+	if strings.HasPrefix(currentPath, "file:") {
+		if uri, err := url.Parse(currentPath); err == nil {
+			currentPath = uri.Path
+		}
+	}
+	if current, err := os.Stat(currentPath); err == nil && os.SameFile(info, current) {
+		return errors.New("backup file is the current database")
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	uri := (&url.URL{Scheme: "file", Path: filepath.ToSlash(absPath), RawQuery: "mode=ro"}).String()
+	src, err := sql.Open(Driver, uri)
+	if err != nil {
+		return fmt.Errorf("open backup file: %w", err)
+	}
+	defer src.Close()
+	var check string
+	if err := src.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&check); err != nil {
+		return fmt.Errorf("validate backup file: %w", err)
+	}
+	if check != "ok" {
+		return fmt.Errorf("backup file failed integrity check: %s", check)
+	}
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return fmt.Errorf("open backup connection: %w", err)
+	}
+	defer srcConn.Close()
+	destConn, err := d.writeDB.Conn(ctx)
+	if err != nil {
+		return fmt.Errorf("open destination database: %w", err)
+	}
+	defer destConn.Close()
+	if err := sqliteCopy(ctx, destConn, srcConn); err != nil {
+		return fmt.Errorf("restore database: %w", err)
+	}
+	return nil
+}
+
+// sqliteCopy uses SQLite's online backup API. A bounded step allows cancellation
+// and lets concurrent writers make progress while the copy is in flight.
+func sqliteCopy(ctx context.Context, destination, source *sql.Conn) error {
+	return destination.Raw(func(destDriver any) error {
+		dest, ok := destDriver.(*sqlite3.SQLiteConn)
+		if !ok {
+			return errors.New("destination is not a SQLite connection")
+		}
+		return source.Raw(func(srcDriver any) error {
+			src, ok := srcDriver.(*sqlite3.SQLiteConn)
+			if !ok {
+				return errors.New("source is not a SQLite connection")
+			}
+			backup, err := dest.Backup("main", src, "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Close()
+					return err
+				}
+				done, err := backup.Step(256)
+				if err != nil {
+					_ = backup.Close()
+					return err
+				}
+				if done {
+					return backup.Close()
+				}
+				// Step can return without progress when the source or destination is busy.
+				time.Sleep(time.Millisecond)
+			}
+		})
+	})
+}
+
+// Prune removes all but the configured number of newest backup files.
+func (d *db) Prune(ctx context.Context) (int, error) {
+	return prune(ctx)
+}
+
+func prune(ctx context.Context) (int, error) {
+	dir := conf.Server.Backup.Path
+	if dir == "" {
+		return 0, errors.New("backup.path is not configured")
+	}
+	keep := conf.Server.Backup.Count
+	if keep < 0 {
+		return 0, errors.New("backup.count must be nonnegative")
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0, fmt.Errorf("read backup directory: %w", err)
+	}
+	var files []string
+	for _, entry := range entries {
+		if !entry.Type().IsRegular() {
+			continue
+		}
+		name := entry.Name()
+		if !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") {
+			continue
+		}
+		files = append(files, name)
+	}
+	// Generated timestamps sort chronologically, so the newest names come first.
+	sort.Sort(sort.Reverse(sort.StringSlice(files)))
+	var removed int
+	for _, file := range files[min(keep, len(files)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(dir, file)); err != nil {
+			return removed, fmt.Errorf("remove backup %s: %w", file, err)
+		}
+		removed++
+	}
+	return removed, nil
+}
