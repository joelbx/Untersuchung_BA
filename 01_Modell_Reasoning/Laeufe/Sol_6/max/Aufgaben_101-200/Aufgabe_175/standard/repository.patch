@@ -0,0 +1,93 @@
+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd.AddCommand(backupCreateCmd, backupPruneCmd, backupRestoreCmd)
+	backupPruneCmd.Flags().Bool("force", false, "prune without confirmation when backup.count is zero")
+	backupRestoreCmd.Flags().String("backup-file", "", "path to the backup file to restore")
+	_ = backupRestoreCmd.MarkFlagRequired("backup-file")
+	backupRestoreCmd.Flags().Bool("force", false, "restore without confirmation")
+	rootCmd.AddCommand(backupCmd)
+}
+
+var backupCmd = &cobra.Command{
+	Use:   "backup",
+	Short: "Create, prune, or restore database backups",
+}
+
+var backupCreateCmd = &cobra.Command{
+	Use:   "create",
+	Short: "Create a database backup",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		path, err := db.Db().Backup(cmd.Context())
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintln(cmd.OutOrStdout(), path)
+		return err
+	},
+}
+
+var backupPruneCmd = &cobra.Command{
+	Use:   "prune",
+	Short: "Remove old database backups",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		force, _ := cmd.Flags().GetBool("force")
+		if conf.Server.Backup.Count == 0 && !force {
+			message := "backup.count is 0; this will delete all database backups. Continue? [y/N] "
+			if !confirmBackupAction(cmd, message) {
+				return fmt.Errorf("backup pruning cancelled")
+			}
+		}
+		count, err := db.Db().Prune(cmd.Context())
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backup(s)\n", count)
+		return err
+	},
+}
+
+var backupRestoreCmd = &cobra.Command{
+	Use:   "restore",
+	Short: "Restore a database from a backup file",
+	Args:  cobra.NoArgs,
+	RunE: func(cmd *cobra.Command, _ []string) error {
+		path, _ := cmd.Flags().GetString("backup-file")
+		force, _ := cmd.Flags().GetBool("force")
+		if !force {
+			message := fmt.Sprintf("Restore database %s from %s? Current database contents will be replaced. Continue? [y/N] ", conf.Server.DbPath, path)
+			if !confirmBackupAction(cmd, message) {
+				return fmt.Errorf("database restore cancelled")
+			}
+		}
+		if err := db.Db().Restore(cmd.Context(), path); err != nil {
+			return err
+		}
+		_, err := fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+		return err
+	},
+}
+
+func confirmBackupAction(cmd *cobra.Command, message string) bool {
+	if _, err := fmt.Fprint(cmd.OutOrStdout(), message); err != nil {
+		return false
+	}
+	answer, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	if err != nil && err != io.EOF {
+		return false
+	}
+	return strings.EqualFold(strings.TrimSpace(answer), "y") || strings.EqualFold(strings.TrimSpace(answer), "yes")
+}
