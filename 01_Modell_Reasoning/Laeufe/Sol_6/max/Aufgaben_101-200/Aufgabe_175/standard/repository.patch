@@ -0,0 +1,130 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupAndRestore(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	backupDir := filepath.Join(dir, "backups")
+	if err := os.Mkdir(backupDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	dbPath := filepath.Join(dir, "live.db")
+	oldBackup, oldDBPath := conf.Server.Backup, conf.Server.DbPath
+	conf.Server.Backup.Path = backupDir
+	conf.Server.Backup.Count = 0 // Manual backups work even when scheduled retention is off.
+	conf.Server.DbPath = dbPath
+	t.Cleanup(func() { conf.Server.Backup, conf.Server.DbPath = oldBackup, oldDBPath })
+
+	read, err := sql.Open(Driver, dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer read.Close()
+	write, err := sql.Open(Driver, dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer write.Close()
+	d := &db{readDB: read, writeDB: write}
+	if _, err := write.Exec("PRAGMA journal_mode=WAL"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := write.Exec("CREATE TABLE items (value TEXT); INSERT INTO items VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+
+	path, err := d.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Dir(path) != backupDir || !strings.HasPrefix(filepath.Base(path), backupPrefix) || !strings.HasSuffix(path, ".db") {
+		t.Fatalf("unexpected backup path %q", path)
+	}
+	copyDB, err := sql.Open(Driver, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := copyDB.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "before" {
+		t.Fatalf("backup contents = %q, %v", value, err)
+	}
+	_ = copyDB.Close()
+
+	if _, err := write.Exec("UPDATE items SET value = 'after'"); err != nil {
+		t.Fatal(err)
+	}
+	bad := filepath.Join(dir, "bad.db")
+	if err := os.WriteFile(bad, []byte("not a SQLite database"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Restore(ctx, bad); err == nil {
+		t.Fatal("invalid backup was accepted")
+	}
+	if err := write.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "after" {
+		t.Fatalf("database changed after failed restore: %q, %v", value, err)
+	}
+	if err := d.Restore(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	if err := write.QueryRow("SELECT value FROM items").Scan(&value); err != nil || value != "before" {
+		t.Fatalf("restored value = %q, %v", value, err)
+	}
+	if err := d.Restore(ctx, dbPath); err == nil {
+		t.Fatal("restoring the live database over itself was accepted")
+	}
+}
+
+func TestPruneKeepsNewestBackups(t *testing.T) {
+	dir := t.TempDir()
+	oldBackup := conf.Server.Backup
+	conf.Server.Backup.Path = dir
+	conf.Server.Backup.Count = 2
+	t.Cleanup(func() { conf.Server.Backup = oldBackup })
+	var paths []string
+	for i := 0; i < 4; i++ {
+		stamp := time.Date(2024, 1, i+1, 0, 0, 0, 0, time.UTC).Format(backupTimestamp)
+		path := filepath.Join(dir, backupPrefix+stamp+".db")
+		if err := os.WriteFile(path, []byte("backup"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		// Retention follows the filename timestamp, even if modification times differ.
+		modTime := time.Date(2025, 1, 4-i, 0, 0, 0, 0, time.UTC)
+		if err := os.Chtimes(path, modTime, modTime); err != nil {
+			t.Fatal(err)
+		}
+		paths = append(paths, path)
+	}
+	unrelated := filepath.Join(dir, "other.db")
+	if err := os.WriteFile(unrelated, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	count, err := prune(context.Background())
+	if err != nil || count != 2 {
+		t.Fatalf("prune = %d, %v; want 2", count, err)
+	}
+	for i, path := range paths {
+		_, err := os.Stat(path)
+		if (i < 2) != os.IsNotExist(err) {
+			t.Fatalf("unexpected status for %s: %v", path, err)
+		}
+	}
+	conf.Server.Backup.Count = 0
+	count, err = prune(context.Background())
+	if err != nil || count != 2 {
+		t.Fatalf("prune all = %d, %v; want 2", count, err)
+	}
+	if _, err := os.Stat(unrelated); err != nil {
+		t.Fatalf("unrelated file was removed: %v", err)
+	}
+}
