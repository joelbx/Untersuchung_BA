+// ArtistFolder returns the common folder for an artist's albums. A single
+// album can span multiple disc folders, so find their common directory first.
+func (als Albums) ArtistFolder() string {
+	var dirs []string
+	albumsWithDirs := 0
+	for _, al := range als {
+		albumDirs := al.Dirs()
+		if len(albumDirs) == 0 {
+			continue
+		}
+		albumsWithDirs++
+		dirs = append(dirs, albumDirs...)
+	}
+	if len(dirs) == 0 {
+		return ""
+	}
+	folder := commonDirectory(dirs)
+	if albumsWithDirs == 1 {
+		folder = filepath.Dir(folder)
+	}
+	if folder == filepath.Dir(folder) {
+		return ""
+	}
+	return folder
+}
+
+func commonDirectory(dirs []string) string {
+	common := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		for {
+			rel, err := filepath.Rel(common, dir)
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			parent := filepath.Dir(common)
+			if parent == common {
+				return common
+			}
+			common = parent
+		}
+	}
+	return common
+}
