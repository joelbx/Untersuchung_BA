+func findArtistImage(ctx context.Context, folder string) (io.ReadCloser, string, os.FileInfo, error) {
+	if folder == "" {
+		return nil, "", nil, nil
+	}
+	entries, err := os.ReadDir(folder)
+	if err != nil {
+		return nil, "", nil, err
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || !model.IsImageFile(strings.ToLower(entry.Name())) {
+			continue
+		}
+		match, _ := filepath.Match("artist.*", strings.ToLower(entry.Name()))
+		if !match {
+			continue
+		}
+		path := filepath.Join(folder, entry.Name())
+		file, err := os.Open(path)
+		if err != nil {
+			log.Warn(ctx, "Could not open artist image file", "file", path, err)
+			continue
+		}
+		info, err := file.Stat()
+		if err != nil || !info.Mode().IsRegular() {
+			file.Close()
+			continue
+		}
+		return file, path, info, nil
+	}
+	return nil, "", nil, nil
+}
