+package migrations
+
+import (
+	"database/sql"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upAddAlbumMediaFileDirs, downAddAlbumMediaFileDirs)
+}
+
+func upAddAlbumMediaFileDirs(tx *sql.Tx) error {
+	if _, err := tx.Exec("alter table album add column media_file_dirs varchar not null default ''"); err != nil {
+		return err
+	}
+
+	rows, err := tx.Query("select album_id, path from media_file where path <> ''")
+	if err != nil {
+		return err
+	}
+	dirsByAlbum := make(map[string]map[string]struct{})
+	for rows.Next() {
+		var albumID, path string
+		if err := rows.Scan(&albumID, &path); err != nil {
+			rows.Close()
+			return err
+		}
+		if dirsByAlbum[albumID] == nil {
+			dirsByAlbum[albumID] = make(map[string]struct{})
+		}
+		dirsByAlbum[albumID][filepath.Dir(path)] = struct{}{}
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return err
+	}
+
+	for albumID, uniqueDirs := range dirsByAlbum {
+		dirs := make([]string, 0, len(uniqueDirs))
+		for dir := range uniqueDirs {
+			dirs = append(dirs, dir)
+		}
+		sort.Strings(dirs)
+		if _, err := tx.Exec("update album set media_file_dirs = ? where id = ?", strings.Join(dirs, string(filepath.ListSeparator)), albumID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func downAddAlbumMediaFileDirs(tx *sql.Tx) error {
+	_, err := tx.Exec("alter table album drop column media_file_dirs")
+	return err
+}
