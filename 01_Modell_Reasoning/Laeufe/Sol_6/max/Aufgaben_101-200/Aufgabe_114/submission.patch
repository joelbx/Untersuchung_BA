+package migrations
+
+import (
+	"database/sql"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestAddAlbumMediaFileDirsBackfillsExistingAlbums(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+
+	_, err = db.Exec(`
+		create table album (id text primary key);
+		create table media_file (album_id text, path text);
+		insert into album (id) values ('one');
+		insert into media_file (album_id, path) values
+			('one', '/music/Artist/Album/Disc 2/two.mp3'),
+			('one', '/music/Artist/Album/Disc 1/one.mp3'),
+			('one', '/music/Artist/Album/Disc 1/three.mp3');
+	`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upAddAlbumMediaFileDirs(tx); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	var dirs string
+	if err := db.QueryRow("select media_file_dirs from album where id = 'one'").Scan(&dirs); err != nil {
+		t.Fatal(err)
+	}
+	want := strings.Join([]string{
+		filepath.FromSlash("/music/Artist/Album/Disc 1"),
+		filepath.FromSlash("/music/Artist/Album/Disc 2"),
+	}, string(filepath.ListSeparator))
+	if dirs != want {
+		t.Fatalf("media_file_dirs = %q, want %q", dirs, want)
+	}
+}
