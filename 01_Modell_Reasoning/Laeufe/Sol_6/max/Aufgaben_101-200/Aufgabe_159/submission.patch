@@ -0,0 +1,108 @@
+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/package-url/packageurl-go"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typ, input, namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package_Name", "", "my-package-name", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "stdlib", "", "stdlib", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "Main/Sub/Feature", "", "Main", "Sub/Feature"},
+		{"cargo", "serde", "", "serde", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typ+"/"+tt.input, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typ, tt.input)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.typ, tt.input, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPackagePURLs(t *testing.T) {
+	tests := []struct {
+		typ                        ftypes.LangType
+		input, wantType, namespace string
+		name, subpath              string
+	}{
+		{ftypes.Pom, "com.google.guava:guava", "maven", "com.google.guava", "guava", ""},
+		{ftypes.Pip, "My_Package", "pypi", "", "my-package", ""},
+		{ftypes.GoModule, "github.com/protobom/protobom", "golang", "github.com/protobom", "protobom", ""},
+		{ftypes.Npm, "@babel/core", "npm", "@babel", "core", ""},
+		{ftypes.Yarn, "@babel/core", "npm", "@babel", "core", ""},
+		{ftypes.Cocoapods, "GoogleUtilities/NSData+zlib", "cocoapods", "", "GoogleUtilities", "NSData+zlib"},
+	}
+	for _, tt := range tests {
+		t.Run(string(tt.typ), func(t *testing.T) {
+			const path = "package.lock"
+			purls := map[string]map[string]string{path: {}}
+			components := libpkgToCdxComponents(models.LibraryScanner{
+				Type:         tt.typ,
+				LockfilePath: path,
+				Libs:         []models.Library{{Name: tt.input, Version: "1.2.3"}},
+			}, purls)
+			if len(components) != 2 {
+				t.Fatalf("got %d components, want 2", len(components))
+			}
+			assertPackagePURL(t, components[1].PackageURL, tt.wantType, tt.namespace, tt.name, tt.subpath)
+			if components[1].Name != tt.input || purls[path][tt.input] != components[1].PackageURL {
+				t.Errorf("original package name was not preserved in the component and PURL lookup")
+			}
+		})
+	}
+}
+
+func TestDependencyGraphPackagePURLs(t *testing.T) {
+	tests := []struct {
+		filename, input, wantType, namespace, name string
+	}{
+		{"pom.xml", "com.google.guava:guava", "maven", "com.google.guava", "guava"},
+		{"requirements.txt", "My_Package", "pypi", "", "my-package"},
+		{"go.mod", "github.com/protobom/protobom", "golang", "github.com/protobom", "protobom"},
+		{"package-lock.json", "@babel/core", "npm", "@babel", "core"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			manifest := models.DependencyGraphManifest{
+				Filename:     tt.filename,
+				Repository:   "https://example.invalid/repo",
+				Dependencies: []models.Dependency{{PackageName: tt.input, Requirements: "= 1.2.3"}},
+			}
+			purls := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+			components := ghpkgToCdxComponents(manifest, purls)
+			if len(components) != 2 {
+				t.Fatalf("got %d components, want 2", len(components))
+			}
+			assertPackagePURL(t, components[1].PackageURL, tt.wantType, tt.namespace, tt.name, "")
+			if components[1].Name != tt.input || purls[manifest.RepoURLFilename()][tt.input] != components[1].PackageURL {
+				t.Errorf("original package name was not preserved in the component and PURL lookup")
+			}
+		})
+	}
+}
+
+func assertPackagePURL(t *testing.T, raw, typ, namespace, name, subpath string) {
+	t.Helper()
+	purl, err := packageurl.FromString(raw)
+	if err != nil {
+		t.Fatalf("invalid PURL %q: %v", raw, err)
+	}
+	if purl.Type != typ || purl.Namespace != namespace || purl.Name != name || purl.Subpath != subpath {
+		t.Errorf("PURL %q has (%q, %q, %q, %q), want (%q, %q, %q, %q)", raw, purl.Type, purl.Namespace, purl.Name, purl.Subpath, typ, namespace, name, subpath)
+	}
+}
