+func libraryPURLType(t string) string {
+	switch t {
+	case "jar", "pom", "gradle", "sbt":
+		return "maven"
+	case "pip", "pipenv", "poetry", "uv", "python-pkg":
+		return "pypi"
+	case "gobinary", "gomod":
+		return "golang"
+	case "yarn", "pnpm", "node-pkg":
+		return "npm"
+	default:
+		return t
+	}
+}
+
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	switch t {
+	case "maven":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			return group, artifact, ""
+		}
+	case "pypi":
+		return "", strings.ToLower(strings.ReplaceAll(n, "_", "-")), ""
+	case "golang":
+		if i := strings.LastIndex(n, "/"); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				return scope, pkg, ""
+			}
+		}
+	case "cocoapods":
+		if pkg, path, ok := strings.Cut(n, "/"); ok {
+			return "", pkg, path
+		}
+	}
+	return "", n, ""
+}
