+_ENTRY_NAME = re.compile(r'^([0-9]{10})(?:-([SML]))?\.([A-Za-z0-9]+)$')
+
+
+def _decimal_id(value, maximum, label):
+    if isinstance(value, bool) or not (
+        isinstance(value, int) or isinstance(value, str) and value.isascii() and value.isdecimal()
+    ):
+        raise ValueError(f'{label} must be a decimal integer')
+    result = int(value)
+    if not 0 <= result <= maximum:
+        raise ValueError(f'{label} is out of range')
+    return result
+
+
+def _size(size):
+    if size not in SIZES:
+        raise ValueError("size must be '', 's', 'm', or 'l'")
+    return size
+
+
+def _extension(ext):
+    if not isinstance(ext, str) or not re.fullmatch(r'[A-Za-z0-9]+', ext):
+        raise ValueError('invalid file extension')
+    return ext
+
+
+class Cover:
+    """A cover record and the names of its four image variants."""
+
+    def __init__(self, attributes):
+        self.attributes = dict(attributes)
+        self.id = _decimal_id(self.attributes['id'], 9_999_999_999, 'cover ID')
+        self.id_to_item_and_batch_id(self.id)
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        cover_id = _decimal_id(cover_id, 9_999_999_999, 'cover ID')
+        padded = f'{cover_id:010d}'
+        return padded[:4], padded[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        _size(size)
+        _extension(ext)
+        if protocol not in ('http', 'https'):
+            raise ValueError('protocol must be http or https')
+        item_id, batch_id = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f'{size}_' if size else ''
+        stem = f'{prefix}covers_{item_id}'
+        suffix = f'-{size.upper()}' if size else ''
+        filename = f'{_decimal_id(cover_id, 9_999_999_999, "cover ID"):010d}{suffix}.{ext}'
+        return (
+            f'{protocol}://archive.org/download/{stem}/'
+            f'{stem}_{batch_id}.zip/{filename}'
+        )
 
+    def entry_name(self, size='', ext='jpg'):
+        _size(size)
+        _extension(ext)
+        suffix = f'-{size.upper()}' if size else ''
+        return f'{self.id:010d}{suffix}.{ext}'
+
+    def local_path(self, size=''):
+        """Return a safe local source path, or None for a remote/legacy value."""
+        _size(size)
+        key = f'filename_{size}' if size else 'filename'
+        name = self.attributes.get(key)
+        if not name or '://' in name or ':' in name or os.path.isabs(name):
+            return None
+        root = os.path.abspath(os.path.join(config.data_root, 'localdisk'))
+        path = os.path.abspath(os.path.join(root, name))
+        return path if os.path.commonpath((root, path)) == root else None
+
+    def valid_files(self):
+        return all(
+            (path := self.local_path(size))
+            and os.path.isfile(path)
+            and os.path.getsize(path) > 0
+            for size in SIZES
+        )
 
