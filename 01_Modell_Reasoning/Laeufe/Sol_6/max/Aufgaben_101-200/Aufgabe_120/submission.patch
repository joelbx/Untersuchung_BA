+def test_cleanup_retries_after_database_commit(archive_db, tmp_path, monkeypatch):
+    names = {
+        'filename': 'source.jpg', 'filename_s': 'source-S.jpg',
+        'filename_m': 'source-M.jpg', 'filename_l': 'source-L.jpg',
+    }
+    for name in names.values():
+        (tmp_path / 'localdisk' / name).write_bytes(b'image')
+    archive_db.insert(
+        'cover', id=8_000_001, archived=False, uploaded=False, failed=False, **names
+    )
+    archive_db.insert('cover', id=8_010_000, archived=True, uploaded=True, failed=False)
+    assert archive.archive(test=False) == 1
+    batch = archive.Batch(8, 0)
+    FakeUploader.uploaded = {
+        (batch.item_name(size), batch.zip_filename(size)) for size in archive.SIZES
+    }
+
+    original_remove = os.remove
+    source = str(tmp_path / 'localdisk' / 'source.jpg')
+
+    def fail_source_cleanup(path):
+        if path == source:
+            raise PermissionError('source cleanup interrupted')
+        return original_remove(path)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(archive.os, 'remove', fail_source_cleanup)
+        with pytest.raises(PermissionError, match='interrupted'):
+            batch.process_pending(finalize=True, test=False, uploader=FakeUploader)
+
+    assert archive_db.select('cover', where='id=8000001')[0].uploaded
+    assert os.path.exists(batch.source_manifest)
+    assert os.path.exists(archive.Batch.get_abspath(8, 0))
+    assert batch.process_pending(finalize=True, test=False, uploader=FakeUploader)[
+        'completed'
+    ] == 0
+    assert not os.path.exists(batch.source_manifest)
+    assert not os.path.exists(source)
+    assert not os.path.exists(archive.Batch.get_abspath(8, 0))
