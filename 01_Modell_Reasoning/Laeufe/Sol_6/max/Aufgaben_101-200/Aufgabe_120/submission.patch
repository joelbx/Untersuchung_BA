+def test_zip_retry_rejects_changed_content(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    source = tmp_path / 'source.jpg'
+    source.write_bytes(b'first')
+    name = '0008000000.jpg'
+    manager = archive.ZipManager()
+    manager.add_file(name, str(source), time.time())
+    manager.close()
+
+    manager = archive.ZipManager()
+    assert manager.add_file(name, str(source), time.time()).endswith('.zip')
+    source.write_bytes(b'changed')
+    with pytest.raises(ValueError, match='differs'):
+        manager.add_file(name, str(source), time.time())
+    manager.close()
+    assert archive.count_files_in_zip(archive.Batch.get_abspath(8, 0)) == 1
+
