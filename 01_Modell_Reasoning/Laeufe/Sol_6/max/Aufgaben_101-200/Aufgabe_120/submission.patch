+def archive(test=True):
+    """Stage up to 10,000 unarchived covers, grouped by locked batch range."""
+    cover_db = CoverDB()
+    selected = list(cover_db.get_unarchived())
+    batch_keys = {Cover.id_to_item_and_batch_id(row.id) for row in selected}
+    staged = 0
+    for item_id, batch_id in sorted(batch_keys):
+        batch = Batch(item_id, batch_id)
+        with batch.locked():
+            covers = [Cover(row) for row in cover_db.get_unarchived_in_batch(item_id, batch_id)]
+            if test:
+                staged += sum(cover.valid_files() for cover in covers)
+                continue
+            manager = ZipManager()
+            completed = []
+            try:
+                for cover in covers:
+                    if not cover.valid_files():
+                        cover_db.mark_failed(cover.id)
+                        continue
+                    created = cover.attributes.get('created')
+                    if isinstance(created, str):
+                        from infogami.infobase.utils import parse_datetime
+
+                        created = parse_datetime(created)
+                    mtime = time.mktime(created.timetuple()) if created else time.time()
+                    for size in SIZES:
+                        manager.add_file(cover.entry_name(size), cover.local_path(size), mtime)
+                    completed.append(cover.id)
+            finally:
+                manager.close()
+            cover_db.mark_archived(completed)
+            staged += len(completed)
+    return staged
