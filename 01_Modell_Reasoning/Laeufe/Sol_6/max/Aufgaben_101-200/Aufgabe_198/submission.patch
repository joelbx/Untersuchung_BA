+		{"Under investigation", "nginx", false},
+		{"Fix deferred", "nginx", true},
+		{"Affected", "nginx", true},
+		{"Out of support scope", "nginx", true},
+		{"Will not fix", "other-package", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.state+"/"+tt.component, func(t *testing.T) {
+			def := ovalmodels.Definition{
+				Advisory: ovalmodels.Advisory{AffectedResolution: []ovalmodels.Resolution{{
+					State:      tt.state,
+					Components: []ovalmodels.Component{{Component: tt.component}},
+				}}},
+				AffectedPacks: []ovalmodels.Package{{Name: "nginx", NotFixedYet: true}},
+			}
+			affected, notFixedYet, fixState, _ := isOvalDefAffected(def, request{packName: "nginx"}, constant.RedHat, "8", models.Kernel{}, nil)
+			if affected != tt.affected || !notFixedYet {
+				t.Fatalf("affected=%t notFixedYet=%t", affected, notFixedYet)
+			}
+			wantState := tt.state
+			if tt.component != "nginx" {
+				wantState = ""
+			}
+			if fixState != wantState {
+				t.Fatalf("fixState=%q, want %q", fixState, wantState)
+			}
+		})
+	}
