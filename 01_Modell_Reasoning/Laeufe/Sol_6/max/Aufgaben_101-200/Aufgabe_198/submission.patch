+func TestConvertToDistroAdvisory(t *testing.T) {
+	tests := []struct {
+		family, title, advisoryID string
+	}{
+		{constant.RedHat, "RHSA-2024:1234: Important update", "RHSA-2024:1234"},
+		{constant.CentOS, "RHBA-2024:1234: Bug fix", "RHBA-2024:1234"},
+		{constant.Alma, "RHSA-2024:1234", "RHSA-2024:1234"},
+		{constant.Rocky, "RHBA-2024:1234", "RHBA-2024:1234"},
+		{constant.Oracle, "ELSA-2024-1234: Security update", "ELSA-2024-1234"},
+		{constant.Amazon, "ALAS2-2024-1234: Security update", "ALAS2-2024-1234"},
+		{constant.Fedora, "FEDORA-2024-abcd: Security update", "FEDORA-2024-abcd"},
+		{constant.RedHat, "CVE-2024-1234 is unfixed", ""},
+		{constant.Oracle, "RHSA-2024:1234: Wrong family", ""},
+		{constant.Amazon, "", ""},
+		{constant.Fedora, "FEDORA", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.family+"/"+tt.title, func(t *testing.T) {
+			got := (RedHatBase{Base: Base{family: tt.family}}).convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
+			if tt.advisoryID == "" {
+				if got != nil {
+					t.Fatalf("expected no advisory, got %+v", got)
+				}
+				return
+			}
+			if got == nil || got.AdvisoryID != tt.advisoryID {
+				t.Fatalf("expected advisory %q, got %+v", tt.advisoryID, got)
+			}
+		})
+	}
+}
