+func TestUpdatePreservesPackageFixStateWithoutInvalidAdvisory(t *testing.T) {
+	r := models.ScanResult{ScannedCves: models.VulnInfos{
+		"CVE-2024-1234": {
+			AffectedPackages: models.PackageFixStatuses{
+				{Name: "existing", NotFixedYet: true, FixState: "Affected", FixedIn: "0.9"},
+				{Name: "shared", NotFixedYet: true, FixState: "Affected", FixedIn: "1.0"},
+			},
+		},
+	}}
+	def := defPacks{
+		def: ovalmodels.Definition{
+			Title:    "CVE-2024-1234 is unfixed",
+			Advisory: ovalmodels.Advisory{Cves: []ovalmodels.Cve{{CveID: "CVE-2024-1234"}}},
+		},
+		binpkgFixstat: map[string]fixStat{
+			"shared": {notFixedYet: true, fixState: "Fix deferred", fixedIn: "1.2"},
+		},
+	}
+	(RedHatBase{Base: Base{family: constant.RedHat}}).update(&r, def)
+	got := r.ScannedCves["CVE-2024-1234"]
+	if len(got.DistroAdvisories) != 0 {
+		t.Fatalf("unexpected advisory: %+v", got.DistroAdvisories)
+	}
+	want := models.PackageFixStatuses{
+		{Name: "existing", NotFixedYet: true, FixState: "Affected", FixedIn: "0.9"},
+		{Name: "shared", NotFixedYet: true, FixState: "Fix deferred", FixedIn: "1.2"},
+	}
+	if !reflect.DeepEqual(got.AffectedPackages, want) {
+		t.Fatalf("package statuses: got %+v, want %+v", got.AffectedPackages, want)
+	}
+}
