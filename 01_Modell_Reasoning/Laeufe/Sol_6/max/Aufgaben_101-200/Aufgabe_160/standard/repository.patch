+func TestInventoryControlStreamPipePeerAddr(t *testing.T) {
+	upstream, downstream := InventoryControlStreamPipe()
+	require.Empty(t, upstream.PeerAddr())
+	require.NoError(t, downstream.Close())
+
+	upstream, downstream = InventoryControlStreamPipe(ICSPipePeerAddr("192.0.2.10:44000"))
+	require.Equal(t, "192.0.2.10:44000", upstream.PeerAddr())
+	require.NoError(t, downstream.Close())
+}
+
+type peerAddrTestStream struct {
+	proto.AuthService_InventoryControlStreamServer
+	ctx context.Context
+}
+
+func (s peerAddrTestStream) Context() context.Context {
+	return s.ctx
+}
+
+func (s peerAddrTestStream) Recv() (*proto.UpstreamInventoryOneOf, error) {
+	return nil, io.EOF
+}
+
+func TestUpstreamInventoryControlStreamPeerAddr(t *testing.T) {
+	addr := &net.TCPAddr{IP: net.ParseIP("192.0.2.10"), Port: 44000}
+	for _, tt := range []struct {
+		name string
+		ctx  context.Context
+		want string
+	}{
+		{name: "peer available", ctx: peer.NewContext(context.Background(), &peer.Peer{Addr: addr}), want: addr.String()},
+		{name: "peer unavailable", ctx: context.Background()},
+		{name: "peer address unavailable", ctx: peer.NewContext(context.Background(), &peer.Peer{})},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			stream := NewUpstreamInventoryControlStream(peerAddrTestStream{ctx: tt.ctx})
+			require.Equal(t, tt.want, stream.PeerAddr())
+			require.NoError(t, stream.Close())
+		})
+	}
+}
