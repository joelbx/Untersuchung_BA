+func TestControllerSSHServerHeartbeatAddress(t *testing.T) {
+	const serverID = "test-server"
+	for _, tt := range []struct {
+		name     string
+		addr     string
+		peerAddr string
+		want     string
+	}{
+		{name: "IPv6 wildcard", addr: "[::]:3022", peerAddr: "192.0.2.10:44000", want: "192.0.2.10:3022"},
+		{name: "IPv4 wildcard", addr: "0.0.0.0:3022", peerAddr: "192.0.2.10:44000", want: "192.0.2.10:3022"},
+		{name: "loopback", addr: "127.0.0.1:3022", peerAddr: "192.0.2.10:44000", want: "192.0.2.10:3022"},
+		{name: "IPv6 peer", addr: "[::]:3022", peerAddr: "[2001:db8::10]:44000", want: "[2001:db8::10]:3022"},
+		{name: "routable address", addr: "10.0.0.5:3022", peerAddr: "192.0.2.10:44000", want: "10.0.0.5:3022"},
+		{name: "no peer", addr: "[::]:3022", want: "[::]:3022"},
+		{name: "invalid peer", addr: "[::]:3022", peerAddr: "invalid", want: "[::]:3022"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
+			defer controller.Close()
+
+			upstream, downstream := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peerAddr))
+			defer downstream.Close()
+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{
+				ServerID: serverID,
+				Services: []types.SystemRole{types.RoleNode},
+			})
+			server := &types.ServerV2{
+				Metadata: types.Metadata{Name: serverID},
+				Spec:     types.ServerSpecV2{Addr: tt.addr},
+			}
+			require.NoError(t, controller.handleSSHServerHB(handle, server))
+			require.Equal(t, tt.want, auth.lastUpsertAddr)
+		})
+	}
+}
