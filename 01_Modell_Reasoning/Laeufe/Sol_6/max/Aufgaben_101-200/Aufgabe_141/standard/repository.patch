+	config.Conf = config.Config{WpIgnoreInactive: true}
+
+	packages := WordPressPackages{
+		{Name: "active-plugin", Type: WPPlugin, Status: "active"},
+		{Name: "inactive-plugin", Type: WPPlugin, Status: Inactive},
+	}
+	r := ScanResult{
+		ServerName:        "site",
+		WordPressPackages: &packages,
+		ScannedCves: VulnInfos{
+			"inactive-only": {CveID: "inactive-only", WpPackageFixStats: []WpPackageFixStatus{{Name: "inactive-plugin"}}},
+			"active":        {CveID: "active", WpPackageFixStats: []WpPackageFixStatus{{Name: "active-plugin"}}},
+			"os":            {CveID: "os"},
+		},
+	}
+	got := r.FilterInactiveWordPressLibs()
+	if _, found := got.ScannedCves["inactive-only"]; found {
+		t.Error("inactive-only WordPress finding remained in the result")
+	}
+	if _, found := got.ScannedCves["active"]; !found {
+		t.Error("active WordPress finding was removed")
+	}
+	if _, found := got.ScannedCves["os"]; !found {
+		t.Error("non-WordPress finding was removed")
+	}
+}
