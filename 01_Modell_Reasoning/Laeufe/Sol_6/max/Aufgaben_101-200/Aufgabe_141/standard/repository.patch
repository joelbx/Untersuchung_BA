@@ -0,0 +1,25 @@
+package commands
+
+import (
+	"flag"
+	"testing"
+
+	c "github.com/future-architect/vuls/config"
+)
+
+func TestWpIgnoreInactiveFlag(t *testing.T) {
+	oldConf := c.Conf
+	defer func() { c.Conf = oldConf }()
+
+	for _, cmd := range []interface{ SetFlags(*flag.FlagSet) }{&ReportCmd{}, &TuiCmd{}} {
+		c.Conf = c.Config{}
+		flags := flag.NewFlagSet("wordpress", flag.ContinueOnError)
+		cmd.SetFlags(flags)
+		if err := flags.Parse([]string{"-wp-ignore-inactive"}); err != nil {
+			t.Fatal(err)
+		}
+		if !c.Conf.WpIgnoreInactive {
+			t.Errorf("%T did not enable WpIgnoreInactive", cmd)
+		}
+	}
+}
