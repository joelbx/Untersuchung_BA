+func TestTOMLLoaderWpIgnoreInactive(t *testing.T) {
+	file, err := ioutil.TempFile("", "vuls-wp-ignore-*.toml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(file.Name())
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	oldConf := Conf
+	defer func() { Conf = oldConf }()
+	for _, tc := range []struct {
+		name string
+		toml string
+		want bool
+	}{
+		{name: "enabled", toml: "wpIgnoreInactive = true\n", want: true},
+		{name: "disabled", toml: "wpIgnoreInactive = false\n", want: false},
+		{name: "omitted", toml: "", want: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := ioutil.WriteFile(file.Name(), []byte(tc.toml), 0600); err != nil {
+				t.Fatal(err)
+			}
+			Conf = Config{WpIgnoreInactive: true}
+			if err := (TOMLLoader{}).Load(file.Name(), ""); err != nil {
+				t.Fatal(err)
+			}
+			if Conf.WpIgnoreInactive != tc.want {
+				t.Errorf("WpIgnoreInactive = %t, want %t", Conf.WpIgnoreInactive, tc.want)
+			}
+		})
+	}
+}
