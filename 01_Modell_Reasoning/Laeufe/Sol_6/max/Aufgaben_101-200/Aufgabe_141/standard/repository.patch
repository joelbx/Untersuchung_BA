diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..4b4bd4a
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,120 @@
+package wordpress
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+type testTransport func(*http.Request) (*http.Response, error)
+
+func (f testTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+type testBody struct {
+	io.Reader
+}
+
+func (testBody) Close() error { return nil }
+
+func TestRemoveInactives(t *testing.T) {
+	packages := models.WordPressPackages{
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+		{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+		{Name: models.WPCore, Type: models.WPCore},
+	}
+	want := models.WordPressPackages{packages[1], packages[2], packages[4]}
+	if got := removeInactives(packages); !reflect.DeepEqual(got, want) {
+		t.Fatalf("filtered packages = %#v, want %#v", got, want)
+	}
+	if got := removeInactives(models.WordPressPackages{packages[0], packages[3]}); got != nil {
+		t.Fatalf("all inactive packages should produce nil, got %#v", got)
+	}
+	if got := removeInactives(nil); got != nil {
+		t.Fatalf("nil input should produce nil, got %#v", got)
+	}
+}
+
+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	oldConf := config.Conf
+	oldTransport := http.DefaultTransport
+	defer func() {
+		config.Conf = oldConf
+		http.DefaultTransport = oldTransport
+	}()
+
+	packages := models.WordPressPackages{
+		{Name: models.WPCore, Type: models.WPCore, Version: "6.5"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive, Version: "1.0.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive, Version: "1.0.0"},
+	}
+	for _, tc := range []struct {
+		name       string
+		ignore     bool
+		wantCalls  []string
+		wantCount  int
+		wantLength int
+	}{
+		{
+			name: "default scans all packages",
+			wantCalls: []string{
+				"/api/v3/wordpresses/65", "/api/v3/themes/active-theme", "/api/v3/themes/inactive-theme",
+				"/api/v3/plugins/active-plugin", "/api/v3/plugins/inactive-plugin",
+			},
+			wantCount:  4,
+			wantLength: 5,
+		},
+		{
+			name:   "flag skips inactive packages",
+			ignore: true,
+			wantCalls: []string{
+				"/api/v3/wordpresses/65", "/api/v3/themes/active-theme", "/api/v3/plugins/active-plugin",
+			},
+			wantCount:  2,
+			wantLength: 3,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config.Conf.WpIgnoreInactive = tc.ignore
+			calls := []string{}
+			http.DefaultTransport = testTransport(func(req *http.Request) (*http.Response, error) {
+				calls = append(calls, req.URL.Path)
+				body := "{}"
+				if !strings.Contains(req.URL.Path, "/wordpresses/") {
+					body = fmt.Sprintf(`{"package":{"vulnerabilities":[{"id":%d,"fixed_in":"2.0.0"}]}}`, len(calls))
+				}
+				return &http.Response{StatusCode: http.StatusOK, Body: testBody{strings.NewReader(body)}, Header: make(http.Header)}, nil
+			})
+
+			installed := append(models.WordPressPackages(nil), packages...)
+			result := models.ScanResult{WordPressPackages: &installed, ScannedCves: models.VulnInfos{}}
+			count, err := FillWordPress(&result, "test-token")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if count != tc.wantCount {
+				t.Errorf("vulnerability count = %d, want %d", count, tc.wantCount)
+			}
+			if !reflect.DeepEqual(calls, tc.wantCalls) {
+				t.Errorf("API requests = %#v, want %#v", calls, tc.wantCalls)
+			}
+			if len(*result.WordPressPackages) != tc.wantLength {
+				t.Errorf("result packages = %#v, want %d packages", *result.WordPressPackages, tc.wantLength)
+			}
+			if len(result.ScannedCves) != tc.wantCount {
+				t.Errorf("result CVEs = %d, want %d", len(result.ScannedCves), tc.wantCount)
+			}
+		})
+	}
+}
