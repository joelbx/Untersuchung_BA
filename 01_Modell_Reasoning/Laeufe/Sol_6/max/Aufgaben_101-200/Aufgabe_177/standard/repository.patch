diff --git a/src/upgrades/4.3.0/chat_allow_list.js b/src/upgrades/4.3.0/chat_allow_list.js
new file mode 100644
index 0000000..c70489b
--- /dev/null
+++ b/src/upgrades/4.3.0/chat_allow_list.js
@@ -0,0 +1,41 @@
+'use strict';
+
+const db = require('../../database');
+const batch = require('../../batch');
+
+module.exports = {
+	name: 'Migrate restricted chats to chat allow lists',
+	timestamp: Date.UTC(2025, 3, 16),
+	method: async function () {
+		const { progress } = this;
+		progress.total = await db.sortedSetCard('users:joindate');
+
+		await batch.processSortedSet('users:joindate', async (uids) => {
+			const settings = await db.getObjects(uids.map(uid => `user:${uid}:settings`));
+			const migrateUids = uids.filter((uid, index) => {
+				const current = settings[index];
+				return current && parseInt(current.restrictChat, 10) === 1 &&
+					!Object.prototype.hasOwnProperty.call(current, 'chatAllowList') &&
+					!Object.prototype.hasOwnProperty.call(current, 'disableIncomingMessages');
+			});
+
+			if (migrateUids.length) {
+				const [localFollowing, remoteFollowing] = await Promise.all([
+					db.getSortedSetsMembers(migrateUids.map(uid => `following:${uid}`)),
+					db.getSortedSetsMembers(migrateUids.map(uid => `followingRemote:${uid}`)),
+				]);
+				const writes = migrateUids.map((uid, index) => {
+					const allowed = [...(localFollowing[index] || []), ...(remoteFollowing[index] || [])].map(String);
+					return [`user:${uid}:settings`, {
+						chatAllowList: JSON.stringify(allowed),
+						disableIncomingMessages: allowed.length ? 0 : 1,
+					}];
+				});
+				await db.setObjectBulk(writes);
+			}
+			await db.deleteObjectFields(uids.map(uid => `user:${uid}:settings`), ['restrictChat']);
+
+			progress.incr(uids.length);
+		}, { batch: 500 });
+	},
+};
