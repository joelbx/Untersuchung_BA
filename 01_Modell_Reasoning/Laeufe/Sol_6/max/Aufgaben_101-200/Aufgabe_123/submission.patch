@@ -0,0 +1,60 @@
+import { NotificationOptions } from './interfaces';
+import createNotificationManager from './manager';
+
+describe('notification manager', () => {
+    let notifications: NotificationOptions[] = [];
+    const manager = createNotificationManager((update) => {
+        notifications = typeof update === 'function' ? update(notifications) : update;
+    });
+
+    afterEach(() => {
+        manager.clearNotifications();
+    });
+
+    it('uses string text as the key and replaces repeated non-success notifications', () => {
+        manager.createNotification({ text: 'Unavailable', type: 'error', expiration: -1 });
+        const latestId = manager.createNotification({ text: 'Unavailable', type: 'error', expiration: -1 });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ id: latestId, key: 'Unavailable', text: 'Unavailable' });
+    });
+
+    it('deduplicates by an explicit key even when the text changes', () => {
+        manager.createNotification({ text: 'First', type: 'error', key: 'shared', expiration: -1 });
+        manager.createNotification({ text: 'Second', type: 'info', key: 'shared', expiration: -1 });
+        manager.createNotification({ text: 'Second', type: 'info', key: 'other', expiration: -1 });
+
+        expect(notifications).toHaveLength(2);
+        expect(notifications[0]).toMatchObject({ key: 'shared', text: 'Second', type: 'info' });
+        expect(notifications[1]).toMatchObject({ key: 'other', text: 'Second' });
+    });
+
+    it('uses the identifier for React content without an explicit key', () => {
+        const firstId = manager.createNotification({
+            text: <strong>Unavailable</strong>,
+            type: 'error',
+            expiration: -1,
+        });
+        const secondId = manager.createNotification({
+            text: <strong>Unavailable</strong>,
+            type: 'error',
+            expiration: -1,
+        });
+
+        expect(notifications.map(({ key }) => key)).toEqual([firstId, secondId]);
+
+        manager.createNotification({ text: <strong>First</strong>, type: 'error', key: 0, expiration: -1 });
+        manager.createNotification({ text: <em>Second</em>, type: 'warning', key: 0, expiration: -1 });
+
+        expect(notifications).toHaveLength(3);
+        expect(notifications[2]).toMatchObject({ key: 0, type: 'warning' });
+    });
+
+    it('keeps repeated success notifications and never replaces one with an error', () => {
+        manager.createNotification({ text: 'Saved', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Saved', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Saved', type: 'error', expiration: -1 });
+
+        expect(notifications.map(({ type }) => type)).toEqual(['success', 'success', 'error']);
+    });
+});
