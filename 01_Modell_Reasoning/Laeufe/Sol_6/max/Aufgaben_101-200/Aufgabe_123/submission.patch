+import { ReactNode, useState } from 'react';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import Notification from './Notification';
+
+const renderNotification = (children: ReactNode) =>
+    render(
+        <Notification type="error" isClosing={false} onExit={() => {}}>
+            {children}
+        </Notification>
+    );
+
+describe('Notification', () => {
+    it('renders safe markup and opens links in a separate tab', () => {
+        renderNotification('Read <strong>the guide</strong> at <a href="https://example.com/help">Help</a>.');
+
+        expect(screen.getByText('the guide').tagName).toBe('STRONG');
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('href', 'https://example.com/help');
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('target', '_blank');
+    });
+
+    it('removes unsafe HTML and URLs', () => {
+        renderNotification(
+            '<a href="javascript:alert(1)" target="_self" rel="opener" onclick="alert(1)">Unsafe link</a><img src="x" onerror="alert(1)"><script>alert(1)</script>'
+        );
+
+        const notification = screen.getByRole('alert');
+        const link = screen.getByText('Unsafe link');
+        expect(notification.querySelector('img, script')).toBeNull();
+        expect(link).not.toHaveAttribute('href');
+        expect(link).not.toHaveAttribute('onclick');
+        expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(link).toHaveAttribute('target', '_blank');
+    });
+
+    it('preserves plain text and secures links supplied as React elements', () => {
+        const { rerender } = renderNotification('2 < 3 & 4 > 1');
+        expect(screen.getByRole('alert')).toHaveTextContent('2 < 3 & 4 > 1');
+
+        rerender(
+            <Notification type="error" isClosing={false} onExit={() => {}}>
+                <a href="/help" target="_self" rel="opener">
+                    Help
+                </a>
+            </Notification>
+        );
+
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('target', '_blank');
+    });
+
+    it('secures links added later by React content', async () => {
+        const DynamicContent = () => {
+            const [visible, setVisible] = useState(false);
+            return (
+                <>
+                    <button onClick={() => setVisible(true)}>Show link</button>
+                    {visible && <a href="/help">Help</a>}
+                </>
+            );
+        };
+
+        renderNotification(<DynamicContent />);
+        fireEvent.click(screen.getByRole('button', { name: 'Show link' }));
+
+        await waitFor(() =>
+            expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('rel', 'noopener noreferrer')
+        );
+        expect(screen.getByRole('link', { name: 'Help' })).toHaveAttribute('target', '_blank');
+    });
+});
