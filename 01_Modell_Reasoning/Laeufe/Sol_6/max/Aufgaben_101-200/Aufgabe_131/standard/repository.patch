diff --git a/packages/components/payments/client-extensions/usePollEvents.test.ts b/packages/components/payments/client-extensions/usePollEvents.test.ts
new file mode 100644
index 0000000..b8fcb27
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.ts
@@ -0,0 +1,145 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+import type { EventManager } from '@proton/shared/lib/eventManager/eventManager';
+import createListeners from '@proton/shared/lib/helpers/listeners';
+
+import useEventManager from '../../hooks/useEventManager';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+jest.mock('../../hooks/useEventManager');
+
+const call = jest.fn<Promise<void>, []>();
+const unsubscribe = jest.fn();
+let listener: (event: Record<string, unknown>) => void;
+const subscribe = jest.fn((handler: (event: Record<string, unknown>) => void) => {
+    listener = handler;
+    return unsubscribe;
+});
+
+beforeEach(() => {
+    jest.useFakeTimers();
+    jest.clearAllMocks();
+    call.mockResolvedValue(undefined);
+    jest.mocked(useEventManager).mockReturnValue({ call, subscribe } as unknown as EventManager);
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+it('calls once per interval, at most five times, without a subscription when no property is supplied', async () => {
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current();
+
+    expect(interval).toBe(5000);
+    expect(maxPollingSteps).toBe(5);
+    expect(subscribe).not.toHaveBeenCalled();
+
+    for (let attempt = 1; attempt <= maxPollingSteps; attempt += 1) {
+        await jest.advanceTimersByTimeAsync(interval - 1);
+        expect(call).toHaveBeenCalledTimes(attempt - 1);
+        await jest.advanceTimersByTimeAsync(1);
+        expect(call).toHaveBeenCalledTimes(attempt);
+    }
+
+    await polling;
+    await jest.advanceTimersByTimeAsync(interval * 2);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+});
+
+it('ignores unrelated events and stops on the requested property and action', async () => {
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    listener({ Addresses: [{ Action: EVENT_ACTIONS.CREATE }] });
+    listener({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+    listener({ PaymentMethods: [] });
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(1);
+
+    listener({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await polling;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+    listener({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes after the last attempt and ignores late events', async () => {
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.DELETE);
+
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    await polling;
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+    listener({ PaymentMethods: [{ Action: EVENT_ACTIONS.DELETE }] });
+    await jest.advanceTimersByTimeAsync(interval);
+    expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('completes only once when the matching event arrives during a call', async () => {
+    call.mockImplementation(async () => {
+        listener({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+    });
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+    await jest.advanceTimersByTimeAsync(interval);
+    await polling;
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes if subscribe delivers the matching event synchronously', async () => {
+    subscribe.mockImplementationOnce((handler) => {
+        handler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        listener = handler;
+        return unsubscribe;
+    });
+    const { result } = renderHook(() => usePollEvents());
+
+    await result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    expect(call).not.toHaveBeenCalled();
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+});
+
+it('lets later event manager subscribers receive the matching event', async () => {
+    const listeners = createListeners<[Record<string, unknown>]>();
+    const laterSubscriber = jest.fn();
+    jest.mocked(useEventManager).mockReturnValue({
+        call: jest.fn(async () => {
+            listeners.notify({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        }),
+        subscribe: listeners.subscribe,
+    } as unknown as EventManager);
+
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    listeners.subscribe(laterSubscriber);
+
+    await jest.advanceTimersByTimeAsync(interval);
+    await polling;
+    expect(laterSubscriber).toHaveBeenCalledTimes(1);
+});
+
+it('unsubscribes if an event manager call fails', async () => {
+    const error = new Error('event fetch failed');
+    call.mockRejectedValueOnce(error);
+    const { result } = renderHook(() => usePollEvents());
+    const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+    const rejection = expect(polling).rejects.toBe(error);
+
+    await jest.advanceTimersByTimeAsync(interval);
+    await rejection;
+    expect(unsubscribe).toHaveBeenCalledTimes(1);
+    await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+    expect(call).toHaveBeenCalledTimes(1);
+});
