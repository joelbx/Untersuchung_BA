+                        // The event manager iterates its listeners synchronously. Unsubscribing
+                        // during that iteration could prevent another listener from seeing this event.
+                        void Promise.resolve().then(() => finish());
+                    }
+                });
+            }
+
+            schedule(poll);
+        });
 
