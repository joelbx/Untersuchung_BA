+    const eventManager = useEventManager();
+
+    const pollEventsMultipleTimes = (property?: string, action?: EVENT_ACTIONS) =>
+        new Promise<void>((resolve, reject) => {
+            let completed = false;
+            let attempts = 0;
+            let timeout: ReturnType<typeof setTimeout> | undefined;
+            let unsubscribe: (() => void) | undefined;
+
+            const finish = (error?: unknown, failed = false) => {
+                if (completed) {
+                    return;
+                }
+
+                completed = true;
+                if (timeout) {
+                    clearTimeout(timeout);
+                }
+                unsubscribe?.();
+
+                if (failed) {
+                    reject(error);
+                } else {
+                    resolve();
+                }
+            };
+
+            const schedule = (callback: () => Promise<void>) => {
+                timeout = setTimeout(() => {
+                    timeout = undefined;
+                    void callback();
+                }, interval);
+            };
+
+            const poll = async () => {
+                if (completed) {
+                    return;
+                }
+
+                attempts += 1;
+                try {
+                    await eventManager.call();
+                } catch (error) {
+                    finish(error, true);
+                    return;
+                }
+
+                if (completed) {
+                    return;
+                }
+
+                if (attempts === maxPollingSteps) {
+                    finish();
+                } else {
+                    schedule(poll);
+                }
+            };
+
+            if (property) {
+                unsubscribe = eventManager.subscribe((event: Record<string, unknown>) => {
+                    if (completed) {
+                        return;
+                    }
+
+                    const updates = event?.[property];
+                    if (
+                        Array.isArray(updates) &&
+                        updates.some((update) => update && (action === undefined || update.Action === action))
