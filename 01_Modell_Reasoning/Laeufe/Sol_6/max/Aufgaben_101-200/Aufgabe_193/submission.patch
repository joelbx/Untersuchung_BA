+@pytest.mark.parametrize('force_deps', [False, True])
+def test_selected_role_installs_transitive_dependencies(tmp_path, monkeypatch, force_deps):
+    monkeypatch.setattr(C, 'DEVEL_WARNING', False)
+    requirements_file = tmp_path / 'requirements.yml'
+    requirements_file.write_text('roles:\n- middle.role\n- parent.role\n- skipped.role\n')
+    dependencies = {'parent.role': ['middle.role', 'already.installed'], 'middle.role': ['leaf.role']}
+    installed = {'already.installed'}
+    install_calls = []
+
+    def install(role):
+        install_calls.append(role.name)
+        installed.add(role.name)
+        return True
+
+    monkeypatch.setattr(GalaxyRole, 'install', install)
+    monkeypatch.setattr(GalaxyRole, 'remove', lambda role: installed.discard(role.name))
+    monkeypatch.setattr(GalaxyRole, 'install_info', property(
+        lambda role: {'version': role.version} if role.name in installed else None))
+    monkeypatch.setattr(GalaxyRole, 'metadata', property(
+        lambda role: {'dependencies': dependencies.get(role.name, [])}))
+    monkeypatch.setattr(GalaxyRole, 'requirements', property(lambda role: []))
+
+    args = ['ansible-galaxy', 'role', 'install', '-r', to_text(requirements_file), 'parent.role']
+    if force_deps:
