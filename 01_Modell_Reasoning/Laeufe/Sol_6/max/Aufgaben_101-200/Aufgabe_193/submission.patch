+def test_implicit_install_both_from_requirements(mixed_install_requirements, capsys):
+    with patch.object(GalaxyCLI, '_install_roles') as install_roles, \
+            patch.object(GalaxyCLI, '_install_collections') as install_collections:
+        GalaxyCLI(args=['ansible-galaxy', 'install', '-r', mixed_install_requirements]).run()
+
+    assert [role.name for role in install_roles.call_args[0][0]] == ['local.role']
+    assert install_collections.call_args[0] == ([('namespace.coll', '*', None)], C.COLLECTIONS_PATHS[0])
+    output = capsys.readouterr().out
+    assert 'Starting galaxy role install process' in output
+    assert 'Starting galaxy collection install process' in output
+
+
+def test_implicit_install_uses_default_role_and_collection_paths(tmp_path, monkeypatch):
+    monkeypatch.setattr(C, 'DEVEL_WARNING', False)
+    roles_path = to_text(tmp_path / 'roles')
+    collections_path = to_text(tmp_path / 'collections')
+    monkeypatch.setattr(C, 'DEFAULT_ROLES_PATH', [roles_path])
+    monkeypatch.setattr(C, 'COLLECTIONS_PATHS', [collections_path])
+
+    role_source = tmp_path / 'role_source'
+    (role_source / 'meta').mkdir(parents=True)
+    (role_source / 'meta' / 'main.yml').write_text('dependencies: []\n')
+    role_archive = tmp_path / 'local_role.tar.gz'
+    with tarfile.open(to_text(role_archive), 'w:gz') as archive:
+        archive.add(to_text(role_source), arcname='role_source')
+
+    requirements_file = tmp_path / 'requirements.yml'
+    requirements_file.write_text(yaml.safe_dump({
+        'roles': [{'src': to_text(role_archive), 'name': 'local_role'}],
+        'collections': ['namespace.coll'],
+    }))
+    install_collections = MagicMock()
+    monkeypatch.setattr(ansible.cli.galaxy, 'install_collections', install_collections)
+
+    GalaxyCLI(args=['ansible-galaxy', 'install', '-r', to_text(requirements_file)]).run()
+
+    assert (tmp_path / 'roles' / 'local_role' / 'meta' / 'main.yml').is_file()
+    assert install_collections.call_args[0][0] == [('namespace.coll', '*', None)]
