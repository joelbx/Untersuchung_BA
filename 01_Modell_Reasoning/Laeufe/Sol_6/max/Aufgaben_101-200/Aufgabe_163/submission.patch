+// redactDatabaseError removes known credentials and the original URL before
+// surfacing driver errors, which may include a DSN in their text.
+func redactDatabaseError(err error, rawurl, password string) string {
+	message := err.Error()
+	secrets := []string{password}
+	if rawurl != "" {
+		message = strings.ReplaceAll(message, rawurl, "[redacted database URL]")
+		if parsed, parseErr := url.Parse(rawurl); parseErr == nil {
+			if parsed.User != nil {
+				if secret, ok := parsed.User.Password(); ok {
+					secrets = append(secrets, secret)
+				}
+			}
+			for key, values := range parsed.Query() {
+				if strings.EqualFold(key, "password") || strings.EqualFold(key, "passwd") || strings.EqualFold(key, "pwd") {
+					secrets = append(secrets, values...)
+				}
+			}
+		}
+	}
+	for _, secret := range secrets {
+		if secret == "" {
+			continue
+		}
+		for _, value := range []string{secret, url.PathEscape(secret), url.QueryEscape(secret)} {
+			message = strings.ReplaceAll(message, value, "[REDACTED]")
+		}
+	}
+	return message
 }
