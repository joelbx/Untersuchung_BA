+func TestLoadDatabaseFieldsFromEnvironment(t *testing.T) {
+	values := map[string]string{
+		"FLIPT_DB_PROTOCOL": "mysql",
+		"FLIPT_DB_HOST":     "db.example",
+		"FLIPT_DB_USER":     "alice",
+		"FLIPT_DB_PASSWORD": "secret",
+		"FLIPT_DB_NAME":     "flipt",
+	}
+	for _, key := range []string{"FLIPT_DB_URL", "FLIPT_DB_PROTOCOL", "FLIPT_DB_HOST", "FLIPT_DB_PATH", "FLIPT_DB_PORT", "FLIPT_DB_USER", "FLIPT_DB_PASSWORD", "FLIPT_DB_NAME"} {
+		previous, wasSet := os.LookupEnv(key)
+		defer func(key, previous string, wasSet bool) {
+			if wasSet {
+				_ = os.Setenv(key, previous)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		}(key, previous, wasSet)
+		if value, ok := values[key]; ok {
+			require.NoError(t, os.Setenv(key, value))
+		} else {
+			require.NoError(t, os.Unsetenv(key))
+		}
+	}
+
+	cfg, err := Load("./testdata/config/default.yml")
+	require.NoError(t, err)
+	assert.Empty(t, cfg.Database.URL)
+	target, err := cfg.Database.ConnectionURL()
+	require.NoError(t, err)
+	assert.Equal(t, "mysql://alice:secret@db.example:3306/flipt", target)
+}
+
+func TestLoadDatabaseInvalidValues(t *testing.T) {
+	tests := []struct{ body, want string }{
+		{"db:\n  protocol: oracle\n  host: db.example\n  name: flipt\n", `db.protocol: invalid value "oracle" (expected sqlite, sqlite3, postgres, postgresql, or mysql)`},
+		{"db:\n  protocol: postgres\n  host: db.example\n  name: flipt\n  port: nonsense\n", `db.port: invalid value "nonsense"`},
+		{"db:\n  protocol: postgres\n  name: flipt\n", "db.host: required"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.want, func(t *testing.T) {
+			_, err := Load(writeDatabaseConfig(t, tt.body))
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), tt.want)
+		})
+	}
+}
