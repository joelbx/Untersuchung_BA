+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const databaseProtocolOptions = "sqlite, sqlite3, postgres, postgresql, or mysql"
+
+const (
+	_ DatabaseProtocol = iota
+	SQLite
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return ""
+	}
+}
+
+// ConnectionURL returns the selected database target, applying defaults for
+// individual settings. A nonempty URL always takes precedence over them.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.Protocol != 0 && d.Protocol.String() == "" {
+		return "", fmt.Errorf("db.protocol: invalid value %d (expected %s)", d.Protocol, databaseProtocolOptions)
+	}
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if d.Protocol == 0 {
+		return "", fmt.Errorf("db.protocol: required when db.url is empty (expected %s)", databaseProtocolOptions)
+	}
+	if d.Name == "" {
+		return "", fmt.Errorf("db.name: required when db.url is empty")
+	}
+	host := d.Host
+	if d.Protocol == SQLite && d.Path != "" {
+		host = d.Path
+	}
+	if host == "" {
+		if d.Protocol == SQLite {
+			return "", fmt.Errorf("db.path: required for sqlite3 when db.url is empty (db.host is also accepted)")
+		}
+		return "", fmt.Errorf("db.host: required when db.url is empty")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return "", fmt.Errorf("db.port: invalid value %d (expected 1-65535 or 0 for the default)", d.Port)
+	}
+
+	if d.Protocol == SQLite {
+		path := filepath.ToSlash(filepath.Join(host, d.Name))
+		return "file:" + (&url.URL{Path: path}).EscapedPath(), nil
+	}
+
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := &url.URL{
+		Scheme: d.Protocol.String(),
+		Host:   net.JoinHostPort(host, strconv.Itoa(port)),
+		Path:   "/" + d.Name,
+	}
+	if d.Password != "" {
+		u.User = url.UserPassword(d.User, d.Password)
+	} else if d.User != "" {
+		u.User = url.User(d.User)
+	}
+	return u.String(), nil
 }
 
