+++ b/config/database_test.go
@@ -0,0 +1,186 @@
+package config
+
+import (
+	"io/ioutil"
+	"net/url"
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDatabaseConnectionURL(t *testing.T) {
+	tests := []struct {
+		name    string
+		db      DatabaseConfig
+		want    string
+		wantErr string
+	}{
+		{
+			name: "URL takes precedence",
+			db:   DatabaseConfig{URL: "file:existing.db", Protocol: MySQL, Host: "other", Name: "ignored"},
+			want: "file:existing.db",
+		},
+		{
+			name: "Postgres default port",
+			db:   DatabaseConfig{Protocol: Postgres, Host: "db.example", User: "alice", Name: "flipt"},
+			want: "postgres://alice@db.example:5432/flipt",
+		},
+		{
+			name: "MySQL default port",
+			db:   DatabaseConfig{Protocol: MySQL, Host: "db.example", User: "alice", Name: "flipt"},
+			want: "mysql://alice@db.example:3306/flipt",
+		},
+		{
+			name: "custom port",
+			db:   DatabaseConfig{Protocol: MySQL, Host: "db.example", Port: 3307, Name: "flipt"},
+			want: "mysql://db.example:3307/flipt",
+		},
+		{
+			name: "SQLite path",
+			db:   DatabaseConfig{Protocol: SQLite, Path: "/var/opt/flipt", Name: "flipt.db"},
+			want: "file:/var/opt/flipt/flipt.db",
+		},
+		{
+			name: "SQLite host as path",
+			db:   DatabaseConfig{Protocol: SQLite, Host: "/var/opt/flipt", Name: "flipt.db"},
+			want: "file:/var/opt/flipt/flipt.db",
+		},
+		{
+			name:    "missing protocol",
+			db:      DatabaseConfig{Name: "flipt", Host: "db.example"},
+			wantErr: "db.protocol: required",
+		},
+		{
+			name:    "invalid protocol",
+			db:      DatabaseConfig{Protocol: DatabaseProtocol(99), Host: "db.example", Name: "flipt"},
+			wantErr: "db.protocol: invalid value 99 (expected sqlite, sqlite3, postgres, postgresql, or mysql)",
+		},
+		{
+			name:    "missing name",
+			db:      DatabaseConfig{Protocol: Postgres, Host: "db.example"},
+			wantErr: "db.name: required",
+		},
+		{
+			name:    "missing host",
+			db:      DatabaseConfig{Protocol: MySQL, Name: "flipt"},
+			wantErr: "db.host: required",
+		},
+		{
+			name:    "missing SQLite path",
+			db:      DatabaseConfig{Protocol: SQLite, Name: "flipt.db"},
+			wantErr: "db.path: required",
+		},
+		{
+			name:    "invalid port",
+			db:      DatabaseConfig{Protocol: Postgres, Host: "db.example", Port: 65536, Name: "flipt"},
+			wantErr: "db.port: invalid value 65536",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.db.ConnectionURL()
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestDatabaseConnectionURLEscapesCredentials(t *testing.T) {
+	db := DatabaseConfig{Protocol: Postgres, Host: "db.example", User: "alice", Password: "p@ss:word", Name: "flipt"}
+	target, err := db.ConnectionURL()
+	require.NoError(t, err)
+	parsed, err := url.Parse(target)
+	require.NoError(t, err)
+	password, ok := parsed.User.Password()
+	require.True(t, ok)
+	assert.Equal(t, db.Password, password)
+	assert.NotContains(t, target, db.Password)
+}
+
+func writeDatabaseConfig(t *testing.T, body string) string {
+	t.Helper()
+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	require.NoError(t, err)
+	_, err = f.WriteString(body)
+	require.NoError(t, err)
+	require.NoError(t, f.Close())
+	t.Cleanup(func() { _ = os.Remove(f.Name()) })
+	return f.Name()
+}
+
+func TestLoadDatabaseFields(t *testing.T) {
+	path := writeDatabaseConfig(t, "db:\n  protocol: postgres\n  host: db.example\n  user: alice\n  password: secret\n  name: flipt\n  max_open_conn: 7\n")
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Empty(t, cfg.Database.URL)
+	assert.Equal(t, Postgres, cfg.Database.Protocol)
+	assert.Equal(t, "secret", cfg.Database.Password)
+	assert.Equal(t, 7, cfg.Database.MaxOpenConn)
+	target, err := cfg.Database.ConnectionURL()
+	require.NoError(t, err)
+	assert.Equal(t, "postgres://alice:secret@db.example:5432/flipt", target)
+}
+
+func TestLoadDatabaseURLPrecedence(t *testing.T) {
+	path := writeDatabaseConfig(t, "db:\n  url: file:existing.db\n  protocol: mysql\n  host: db.example\n  name: flipt\n")
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, "file:existing.db", cfg.Database.URL)
