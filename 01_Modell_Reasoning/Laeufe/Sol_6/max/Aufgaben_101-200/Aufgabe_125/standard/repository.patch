+
+	Topics.syncBacklinks = async function (postData) {
+		function validId(value, minimum) {
+			return (typeof value === 'number' || typeof value === 'string') &&
+				/^\d+$/.test(String(value)) && Number.isSafeInteger(Number(value)) && Number(value) >= minimum;
+		}
+
+		if (!postData || typeof postData !== 'object' ||
+			!validId(postData.pid, 1) || !validId(postData.uid, 0) ||
+			!validId(postData.tid, 1) || typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const baseUrl = String(nconf.get('url') || '').replace(/\/+$/, '');
+		const topicLink = new RegExp(
+			`(?:^|[\\s"'(<\\[=,;>])(?:${_.escapeRegExp(baseUrl)}/topic/|/topic/)([1-9]\\d*)(?![\\w-])`, 'g'
+		);
+		const referenced = new Set();
+		for (const match of postData.content.matchAll(topicLink)) {
+			const tid = Number(match[1]);
+			if (Number.isSafeInteger(tid) && tid !== Number(postData.tid)) {
+				referenced.add(String(tid));
+			}
+		}
+
+		const key = `pid:${postData.pid}:backlinks`;
+		const previous = (await db.getSortedSetRange(key, 0, -1)).map(String);
+		const tids = Array.from(referenced);
+		const exists = tids.length ? await Topics.exists(tids) : [];
+		const current = new Set(tids.filter((tid, index) => exists[index]));
+		const removed = previous.filter(tid => !current.has(tid));
+		const added = Array.from(current).filter(tid => !previous.includes(tid));
+
+		await Promise.all(removed.map(async (tid) => {
+			await Topics.events.purgeBacklinks(tid, postData.pid);
+			await db.sortedSetRemove(key, tid);
+		}));
+		const timestamp = Date.now();
+		await Promise.all(added.map(async (tid) => {
+			await Topics.events.log(tid, {
+				type: 'backlink',
+				pid: postData.pid,
+				uid: postData.uid,
+				href: `/post/${postData.pid}`,
+			});
+			await db.sortedSetAdd(key, timestamp, tid);
+		}));
+
+		return added.length + removed.length;
 	};
 
 	Topics.getTopicPosts = async function (tid, set, start, stop, uid, reverse) {
