diff --git a/test/topicBacklinks.js b/test/topicBacklinks.js
new file mode 100644
index 0000000..1283687
--- /dev/null
+++ b/test/topicBacklinks.js
@@ -0,0 +1,133 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+
+const db = require('./mocks/databasemock');
+const categories = require('../src/categories');
+const meta = require('../src/meta');
+const posts = require('../src/posts');
+const topics = require('../src/topics');
+const user = require('../src/user');
+
+describe('Topic backlinks', () => {
+	let uid;
+	let cid;
+	let source;
+	let targetA;
+	let targetB;
+	let targetC;
+	let originalSetting;
+
+	before(async () => {
+		originalSetting = meta.config.topicBacklinks;
+		meta.config.topicBacklinks = 1;
+		uid = await user.create({ username: 'backlink-tester' });
+		cid = (await categories.create({ name: 'Backlink tests' })).cid;
+		const makeTopic = async title => await topics.post({ uid, cid, title, content: 'Initial topic content.' });
+		targetA = await makeTopic('Backlink target A');
+		targetB = await makeTopic('Backlink target B');
+		targetC = await makeTopic('Backlink target C');
+	});
+
+	after(() => {
+		meta.config.topicBacklinks = originalSetting;
+	});
+
+	it('rejects missing or incomplete post data', async () => {
+		await assert.rejects(topics.syncBacklinks(), { message: '[[error:invalid-data]]' });
+		await assert.rejects(topics.syncBacklinks({ pid: 123 }), { message: '[[error:invalid-data]]' });
+	});
+
+	it('creates backlinks from the initial post for site URLs and bare topic paths', async () => {
+		const a = targetA.topicData.tid;
+		const b = targetB.topicData.tid;
+		source = await topics.post({
+			uid,
+			cid,
+			title: 'Backlink source',
+			content: `See ${nconf.get('url')}/topic/${a}/a-slug and /topic/${b}. ` +
+				`Again /topic/${a}; outside https://other.example/topic/${targetC.topicData.tid}.`,
+		});
+
+		const { pid } = source.postData;
+		const key = `pid:${pid}:backlinks`;
+		assert.deepStrictEqual((await db.getSortedSetRange(key, 0, -1)).sort(), [String(a), String(b)].sort());
+		await Promise.all([targetA, targetB].map(async (target) => {
+			const events = await topics.events.get(target.topicData.tid);
+			assert.strictEqual(events.length, 1);
+			assert.strictEqual(events[0].type, 'backlink');
+			assert.strictEqual(events[0].text, '[[topic:backlink]]');
+			assert.strictEqual(events[0].href, `/post/${pid}`);
+			assert.strictEqual(events[0].uid, uid);
+		}));
+		assert.deepStrictEqual(await topics.events.get(targetC.topicData.tid), []);
+		assert.strictEqual(await topics.syncBacklinks(source.postData), 0);
+	});
+
+	it('hides backlink events when the admin setting is off', async () => {
+		const { tid } = targetA.topicData;
+		const [pin] = await topics.events.log(tid, { type: 'pin', uid });
+		meta.config.topicBacklinks = 0;
+		const events = await topics.events.get(tid);
+		assert.strictEqual(events.length, 1);
+		assert.strictEqual(events[0].type, 'pin');
+		assert.strictEqual(events[0].id, pin.id);
+		assert(events[0].timestamp);
+		meta.config.topicBacklinks = 1;
+		assert.strictEqual((await topics.events.get(tid)).length, 2);
+	});
+
+	it('updates associations and events after editing a post', async () => {
+		const { pid } = source.postData;
+		const { tid } = source.topicData;
+		await posts.edit({
+			pid,
+			uid,
+			title: 'Backlink source',
+			content: `Now /topic/${targetC.topicData.tid}/new-slug, /topic/${tid} and /topic/99999999.`,
+		});
+
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1), [String(targetC.topicData.tid)]);
+		assert.strictEqual((await topics.events.get(targetA.topicData.tid)).filter(e => e.type === 'backlink').length, 0);
+		assert.strictEqual((await topics.events.get(targetB.topicData.tid)).length, 0);
+		const events = await topics.events.get(targetC.topicData.tid);
+		assert.strictEqual(events.length, 1);
+		assert.strictEqual(events[0].href, `/post/${pid}`);
+		assert.strictEqual(events[0].uid, uid);
+	});
+
+	it('creates backlinks when a reply links to another topic', async () => {
+		const reply = await topics.reply({
+			uid,
+			cid,
+			tid: source.topicData.tid,
+			content: `This reply points to /topic/${targetB.topicData.tid}/a-slug.`,
+		});
+		const events = await topics.events.get(targetB.topicData.tid);
+		assert.strictEqual(events.length, 1);
+		assert.strictEqual(events[0].href, `/post/${reply.pid}`);
+		assert.strictEqual(events[0].uid, uid);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${reply.pid}:backlinks`, 0, -1), [String(targetB.topicData.tid)]);
+	});
+
+	it('reports the number of added and removed references', async () => {
+		const reply = await topics.reply({
+			uid,
+			cid,
+			tid: source.topicData.tid,
+			content: 'A reply with no links.',
+		});
+		const postData = { ...reply, content: `/topic/${targetA.topicData.tid} /topic/${targetB.topicData.tid}` };
+		assert.strictEqual(await topics.syncBacklinks(postData), 2);
+		assert.strictEqual(await topics.syncBacklinks(postData), 0);
+		postData.content = `/topic/${targetC.topicData.tid}`;
+		assert.strictEqual(await topics.syncBacklinks(postData), 3);
+		meta.config.topicBacklinks = 0;
+		postData.content = 'No topic references here.';
+		assert.strictEqual(await topics.syncBacklinks(postData), 1);
+		meta.config.topicBacklinks = 1;
+		assert.strictEqual((await topics.events.get(targetC.topicData.tid)).filter(e => e.href === `/post/${reply.pid}`).length, 0);
+		assert.deepStrictEqual(await db.getSortedSetRange(`pid:${reply.pid}:backlinks`, 0, -1), []);
+	});
+});
