+func TestFilterInactiveWordPressLibs(t *testing.T) {
+	previousConf := config.Conf
+	defer func() { config.Conf = previousConf }()
+
+	packages := WordPressPackages{
+		{Name: "active-plugin", Status: "active", Type: WPPlugin},
+		{Name: "inactive-plugin", Status: "inactive", Type: WPPlugin},
+	}
+	for _, tt := range []struct {
+		name         string
+		serverIgnore bool
+		globalIgnore bool
+		wantCount    int
+	}{
+		{name: "include all", wantCount: 4},
+		{name: "server setting", serverIgnore: true, wantCount: 3},
+		{name: "report flag", globalIgnore: true, wantCount: 3},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf = config.Config{
+				WpIgnoreInactive: tt.globalIgnore,
+				Servers: map[string]config.ServerInfo{
+					"site": {WordPress: config.WordPressConf{IgnoreInactive: tt.serverIgnore}},
+				},
+			}
+			r := ScanResult{
+				ServerName:        "site",
+				WordPressPackages: &packages,
+				ScannedCves: VulnInfos{
+					"active":   {CveID: "active", WpPackageFixStats: []WpPackageFixStatus{{Name: "active-plugin"}}},
+					"inactive": {CveID: "inactive", WpPackageFixStats: []WpPackageFixStatus{{Name: "inactive-plugin"}}},
+					"mixed": {CveID: "mixed", WpPackageFixStats: []WpPackageFixStatus{
+						{Name: "inactive-plugin"}, {Name: "active-plugin"},
+					}},
+					"other": {CveID: "other"},
+				},
+			}
+			filtered := r.FilterInactiveWordPressLibs()
+			if len(filtered.ScannedCves) != tt.wantCount {
+				t.Fatalf("got %d vulnerabilities, want %d", len(filtered.ScannedCves), tt.wantCount)
+			}
+			for _, id := range []string{"active", "mixed", "other"} {
+				if _, ok := filtered.ScannedCves[id]; !ok {
+					t.Errorf("%s vulnerability was excluded", id)
+				}
+			}
+			_, got := filtered.ScannedCves["inactive"]
+			if want := !tt.serverIgnore && !tt.globalIgnore; got != want {
+				t.Errorf("inactive vulnerability present = %t, want %t", got, want)
+			}
+		})
+	}
+}
