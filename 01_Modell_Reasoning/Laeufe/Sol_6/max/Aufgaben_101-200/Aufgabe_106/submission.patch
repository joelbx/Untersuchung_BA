+func TestFillWordPressIgnoreInactive(t *testing.T) {
+	previousConf := c.Conf
+	defer func() { c.Conf = previousConf }()
+
+	for _, tt := range []struct {
+		name          string
+		serverIgnore  bool
+		globalIgnore  bool
+		wantVulnCount int
+	}{
+		{name: "include all", wantVulnCount: 4},
+		{name: "server setting", serverIgnore: true, wantVulnCount: 2},
+		{name: "report flag", globalIgnore: true, wantVulnCount: 2},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			c.Conf = c.Config{
+				WpIgnoreInactive: tt.globalIgnore,
+				Servers: map[string]c.ServerInfo{
+					"site": {WordPress: c.WordPressConf{IgnoreInactive: tt.serverIgnore}},
+				},
+			}
+
+			packages := models.WordPressPackages{
+				{Type: models.WPCore, Version: "6.2"},
+				{Name: "active-theme", Type: models.WPTheme, Version: "1.0", Status: "active"},
+				{Name: "inactive-theme", Type: models.WPTheme, Version: "1.0", Status: "inactive"},
+				{Name: "active-plugin", Type: models.WPPlugin, Version: "1.0", Status: "active"},
+				{Name: "inactive-plugin", Type: models.WPPlugin, Version: "1.0", Status: "inactive"},
+			}
+			result := models.ScanResult{
+				ServerName:        "site",
+				WordPressPackages: &packages,
+				ScannedCves:       models.VulnInfos{},
+			}
+			emptyBody := ""
+			cache := map[string]*string{"62": &emptyBody}
+			for i, name := range []string{"active-theme", "inactive-theme", "active-plugin", "inactive-plugin"} {
+				body := fmt.Sprintf(`{"entry":{"vulnerabilities":[{"id":%d,"fixed_in":"2.0","references":{"cve":["2020-%04d"]}}]}}`, i+1, i+1)
+				cache[name] = &body
+			}
+
+			count, err := FillWordPress(&result, "unused", cache)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if count != tt.wantVulnCount || len(result.ScannedCves) != tt.wantVulnCount {
+				t.Fatalf("got %d vulnerabilities and %d scanned CVEs, want %d", count, len(result.ScannedCves), tt.wantVulnCount)
+			}
+			for _, id := range []string{"CVE-2020-0001", "CVE-2020-0003"} {
+				if _, ok := result.ScannedCves[id]; !ok {
+					t.Errorf("active package vulnerability %s was excluded", id)
+				}
+			}
+			for _, id := range []string{"CVE-2020-0002", "CVE-2020-0004"} {
+				_, got := result.ScannedCves[id]
+				if want := !tt.serverIgnore && !tt.globalIgnore; got != want {
+					t.Errorf("inactive package vulnerability %s present = %t, want %t", id, got, want)
+				}
+			}
+		})
+	}
+}
