@@ -0,0 +1,30 @@
+import { fetchUtils } from 'react-admin'
+import httpClient from './httpClient'
+import { clientUniqueIdHeader } from '../clientUniqueId'
+
+jest.mock('react-admin', () => ({
+  fetchUtils: { fetchJson: jest.fn() },
+}))
+jest.mock('../utils', () => ({ baseUrl: (url) => url }))
+
+describe('httpClient', () => {
+  beforeEach(() => {
+    localStorage.clear()
+    fetchUtils.fetchJson.mockReset()
+    fetchUtils.fetchJson.mockResolvedValue({ headers: new Headers() })
+  })
+
+  it('sends one tab ID on every request, preserving custom headers', async () => {
+    await httpClient('/first')
+    await httpClient('/second', { headers: { 'X-Other': 'value' } })
+
+    const firstHeaders = fetchUtils.fetchJson.mock.calls[0][1].headers
+    const secondHeaders = fetchUtils.fetchJson.mock.calls[1][1].headers
+    const id = firstHeaders.get(clientUniqueIdHeader)
+    expect(id).toMatch(
+      /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+    )
+    expect(secondHeaders.get(clientUniqueIdHeader)).toBe(id)
+    expect(secondHeaders.get('X-Other')).toBe('value')
+  })
+})
