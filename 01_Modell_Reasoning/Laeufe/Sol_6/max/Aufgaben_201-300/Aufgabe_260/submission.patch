diff --git a/server/events/sse_test.go b/server/events/sse_test.go
new file mode 100644
index 0000000..0ff4eee
--- /dev/null
+++ b/server/events/sse_test.go
@@ -0,0 +1,71 @@
+package events
+
+import (
+	"context"
+	"net/http/httptest"
+	"time"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("SSE broker", func() {
+	It("delivers request events only to other clients of the same user", func() {
+		b := NewBroker().(*broker)
+		var cancellations []context.CancelFunc
+		defer func() {
+			for _, cancel := range cancellations {
+				cancel()
+			}
+		}()
+		subscribe := func(username, cookieID, urlID string) client {
+			r := httptest.NewRequest("GET", "/events?clientUniqueId="+urlID, nil)
+			ctx, cancel := context.WithCancel(r.Context())
+			cancellations = append(cancellations, cancel)
+			ctx = request.WithUser(ctx, model.User{UserName: username})
+			ctx = request.WithClientUniqueId(ctx, cookieID)
+			c := b.subscribe(r.WithContext(ctx))
+			Expect(c.diode.next().event).To(Equal("serverStart"))
+			return c
+		}
+		next := func(c client) message {
+			var msg *message
+			Eventually(func() bool {
+				msg, _ = c.diode.tryNext()
+				return msg != nil
+			}, time.Second).Should(BeTrue())
+			return *msg
+		}
+
+		origin := subscribe("alice", "shared-cookie", "tab-one")
+		otherTab := subscribe("alice", "shared-cookie", "tab-two")
+		otherUser := subscribe("bob", "shared-cookie", "tab-three")
+		Expect(origin.clientUniqueId).To(Equal("tab-one"))
+		Expect(otherTab.clientUniqueId).To(Equal("tab-two"))
+
+		ctx := request.WithUsername(context.Background(), "alice")
+		ctx = request.WithClientUniqueId(ctx, "tab-one")
+		b.SendMessage(ctx, &RefreshResource{})
+		b.SendMessage(context.Background(), &KeepAlive{TS: 1})
+
+		Expect(next(origin).event).To(Equal("keepAlive"))
+		Expect(next(otherTab).event).To(Equal("refreshResource"))
+		Expect(next(otherTab).event).To(Equal("keepAlive"))
+		Expect(next(otherUser).event).To(Equal("keepAlive"))
+
+		// Older clients without an ID still broadcast, even when a username exists.
+		b.SendMessage(request.WithUsername(context.Background(), "alice"), &RefreshResource{})
+		for _, c := range []client{origin, otherTab, otherUser} {
+			Expect(next(c).event).To(Equal("refreshResource"))
+		}
+	})
+
+	It("formats events with their wire field names", func() {
+		w := httptest.NewRecorder()
+		err := writeEvent(w, message{id: 7, event: "keepAlive", data: `{"ts":1}`}, time.Second)
+		Expect(err).To(BeNil())
+		Expect(w.Body.String()).To(Equal("id: 7\nevent: keepAlive\ndata: {\"ts\":1}\n\n"))
+	})
+})
