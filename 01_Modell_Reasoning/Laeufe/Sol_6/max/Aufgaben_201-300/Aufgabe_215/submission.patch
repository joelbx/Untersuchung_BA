+// gatewayTLSName picks an identity from the configured certificate for the
+// gateway's local connection to the gRPC server.
+func gatewayTLSName(cert *x509.Certificate) (string, error) {
+	if len(cert.DNSNames) > 0 {
+		name := cert.DNSNames[0]
+		if strings.HasPrefix(name, "*.") {
+			name = "flipt" + name[1:]
+		}
+		return name, nil
+	}
+	if len(cert.IPAddresses) > 0 {
+		return cert.IPAddresses[0].String(), nil
+	}
+	return "", errors.New("TLS certificate must contain a DNS or IP subject alternative name")
+}
