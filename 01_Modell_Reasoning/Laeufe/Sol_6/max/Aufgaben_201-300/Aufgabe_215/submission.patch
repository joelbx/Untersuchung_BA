diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..4d8f17c
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestConfigureDefaultsAndAdvanced(t *testing.T) {
+	defaults, err := configure("testdata/config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := defaultConfig(); !reflect.DeepEqual(defaults, want) {
+		t.Fatalf("default config = %#v, want %#v", defaults, want)
+	}
+
+	advanced, err := configure("testdata/config/advanced.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := &config{
+		LogLevel: "WARN",
+		UI:       uiConfig{Enabled: false},
+		Cors:     corsConfig{Enabled: true, AllowedOrigins: []string{"foo.com"}},
+		Cache:    cacheConfig{Memory: memoryCacheConfig{Enabled: true, Items: 5000}},
+		Server: serverConfig{
+			Host: "127.0.0.1", Protocol: HTTPS, HTTPPort: 8081, HTTPSPort: 8080,
+			GRPCPort: 9001, CertFile: "./testdata/config/ssl_cert.pem", CertKey: "./testdata/config/ssl_key.pem",
+		},
+		Database: databaseConfig{
+			URL: "postgres://postgres@localhost:5432/flipt?sslmode=disable", MigrationsPath: "./config/migrations",
+		},
+	}
+	if !reflect.DeepEqual(advanced, want) {
+		t.Fatalf("advanced config = %#v, want %#v", advanced, want)
+	}
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatalf("unexpected scheme strings: %q, %q", HTTP, HTTPS)
+	}
+}
+
+func TestConfigureEnvironmentAndOrigins(t *testing.T) {
+	for key, value := range map[string]string{
+		"FLIPT_SERVER_PROTOCOL":   "https",
+		"FLIPT_SERVER_HTTPS_PORT": "8443",
+		"FLIPT_SERVER_CERT_FILE":  "testdata/config/ssl_cert.pem",
+		"FLIPT_SERVER_CERT_KEY":   "testdata/config/ssl_key.pem",
+		"FLIPT_UI_ENABLED":        "false",
+		"FLIPT_CORS_ENABLED":      "true",
+	} {
+		old, had := os.LookupEnv(key)
+		if err := os.Setenv(key, value); err != nil {
+			t.Fatal(err)
+		}
+		defer func(key, old string, had bool) {
+			if had {
+				_ = os.Setenv(key, old)
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		}(key, old, had)
+	}
+
+	cfg, err := configure("testdata/config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.Protocol != HTTPS || cfg.Server.HTTPSPort != 8443 || cfg.UI.Enabled || !cfg.Cors.Enabled {
+		t.Fatalf("environment overrides not applied: %#v", cfg)
+	}
+
+	// YAML sequences and scalar values have the same list semantics.
+	tmp, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmp)
+	path := filepath.Join(tmp, "origins.yml")
+	if err := ioutil.WriteFile(path, []byte("cors:\n  allowed_origins: [foo.com, bar.com]\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com", "bar.com"}) {
+		t.Fatalf("allowed origins = %v", cfg.Cors.AllowedOrigins)
+	}
+}
+
+func TestValidateHTTPS(t *testing.T) {
+	cases := []struct {
+		name string
+		cfg  serverConfig
+		want string
+	}{
+		{"missing cert", serverConfig{Protocol: HTTPS}, "cert_file cannot be empty when using HTTPS"},
+		{"missing key", serverConfig{Protocol: HTTPS, CertFile: "testdata/config/ssl_cert.pem"}, "cert_key cannot be empty when using HTTPS"},
+		{"unknown cert", serverConfig{Protocol: HTTPS, CertFile: "missing-cert.pem", CertKey: "testdata/config/ssl_key.pem"}, "cannot find TLS cert_file at \"missing-cert.pem\""},
+		{"unknown key", serverConfig{Protocol: HTTPS, CertFile: "testdata/config/ssl_cert.pem", CertKey: "missing-key.pem"}, "cannot find TLS cert_key at \"missing-key.pem\""},
+		{"existing pair", serverConfig{Protocol: HTTPS, CertFile: "testdata/config/ssl_cert.pem", CertKey: "testdata/config/ssl_key.pem"}, ""},
+		{"http ignores credentials", serverConfig{Protocol: HTTP, CertFile: "missing-cert.pem", CertKey: "missing-key.pem"}, ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := (&config{Server: tc.cfg}).validate()
+			if tc.want == "" {
+				if err != nil {
+					t.Fatal(err)
+				}
+			} else if err == nil || err.Error() != tc.want {
+				t.Fatalf("error = %v, want %q", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []http.Handler{defaultConfig(), info{Version: "test"}} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/", nil))
+		if recorder.Code != http.StatusOK || len(recorder.Body.Bytes()) == 0 || !json.Valid(recorder.Body.Bytes()) {
+			t.Fatalf("status = %d, body = %q", recorder.Code, recorder.Body.String())
+		}
+	}
+}
