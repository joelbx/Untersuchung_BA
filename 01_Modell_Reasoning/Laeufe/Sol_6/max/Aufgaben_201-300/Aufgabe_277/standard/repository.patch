+func TestRuleSegments(t *testing.T) {
+	tests := []struct {
+		name         string
+		rule         *flipt.Rule
+		wantKey      string
+		wantOperator string
+	}{
+		{
+			name:    "legacy segment key",
+			rule:    &flipt.Rule{SegmentKey: "legacy"},
+			wantKey: "legacy",
+		},
+		{
+			name:    "single segment",
+			rule:    &flipt.Rule{SegmentKey: "stale", SegmentKeys: []string{"first"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR},
+			wantKey: "first",
+		},
+		{
+			name: "multiple segments",
+			rule: &flipt.Rule{
+				SegmentKeys:     []string{"first", "second"},
+				SegmentOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR,
+			},
+			wantKey:      "first,second",
+			wantOperator: "OR_SEGMENT_OPERATOR",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			data, err := json.Marshal(NewRule(tt.rule))
+			require.NoError(t, err)
+
+			var payload map[string]any
+			require.NoError(t, json.Unmarshal(data, &payload))
+			assert.Equal(t, tt.wantKey, payload["segment_key"])
+			if tt.wantOperator == "" {
+				assert.NotContains(t, payload, "segment_operator")
+			} else {
+				assert.Equal(t, tt.wantOperator, payload["segment_operator"])
+			}
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	tests := []struct {
+		name         string
+		segment      *flipt.RolloutSegment
+		wantKey      string
+		wantOperator string
+	}{
+		{
+			name:    "legacy segment key",
+			segment: &flipt.RolloutSegment{SegmentKey: "legacy", Value: true},
+			wantKey: "legacy",
+		},
+		{
+			name:    "single segment",
+			segment: &flipt.RolloutSegment{SegmentKey: "stale", SegmentKeys: []string{"first"}, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true},
+			wantKey: "first",
+		},
+		{
+			name: "multiple segments",
+			segment: &flipt.RolloutSegment{
+				SegmentKeys:     []string{"first", "second"},
+				SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+				Value:           true,
+			},
+			wantKey:      "first,second",
+			wantOperator: "AND_SEGMENT_OPERATOR",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rollout := &flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: tt.segment}}
+			data, err := json.Marshal(NewRollout(rollout))
+			require.NoError(t, err)
+
+			var payload map[string]any
+			require.NoError(t, json.Unmarshal(data, &payload))
+			require.IsType(t, map[string]any{}, payload["segment"])
+			segment := payload["segment"].(map[string]any)
+			assert.Equal(t, tt.wantKey, segment["key"])
+			assert.Equal(t, true, segment["value"])
+			if tt.wantOperator == "" {
+				assert.NotContains(t, segment, "operator")
+			} else {
+				assert.Equal(t, tt.wantOperator, segment["operator"])
+			}
+		})
+	}
+}
