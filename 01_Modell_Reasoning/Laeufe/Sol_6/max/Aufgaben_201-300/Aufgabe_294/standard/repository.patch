+def _is_child_path(path, root, link_path=None):
+    """Check a path against a collection root, resolving links already on disk.
+
+    If link_path is set, path is a symlink target relative to that link's parent.
+    """
+    b_path = to_bytes(path, errors='surrogate_or_strict')
+    b_root = os.path.realpath(to_bytes(root, errors='surrogate_or_strict'))
+    if link_path is not None:
+        b_link_path = to_bytes(link_path, errors='surrogate_or_strict')
+        b_path = os.path.join(os.path.dirname(b_link_path), b_path)
+
+    b_path = os.path.realpath(b_path)
+    return b_path == b_root or b_path.startswith(b_root + to_bytes(os.path.sep))
+
