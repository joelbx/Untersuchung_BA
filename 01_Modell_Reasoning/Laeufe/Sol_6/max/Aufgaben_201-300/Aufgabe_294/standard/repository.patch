+def test_extract_external_tar_symlink_as_regular_file(tmp_path_factory):
+    temp_dir = to_bytes(tmp_path_factory.mktemp('external-tar-link'))
+    tar_path = os.path.join(temp_dir, b'collection.tar.gz')
+    data = b'content from archive'
+    with tarfile.open(tar_path, 'w:gz') as tfile:
+        target = tarfile.TarInfo('../payload')
+        target.size = len(data)
+        tfile.addfile(target, BytesIO(data))
+        link = tarfile.TarInfo('docs/link')
+        link.type = tarfile.SYMTYPE
+        link.linkname = '../../payload'
+        tfile.addfile(link)
+
+    output_dir = os.path.join(temp_dir, b'installed')
+    with tarfile.open(tar_path, 'r') as tfile:
+        collection._extract_tar_file(tfile, 'docs/link', output_dir, temp_dir, sha256(data).hexdigest())
+
+    output_file = os.path.join(output_dir, b'docs', b'link')
+    assert not os.path.islink(output_file)
+    with open(output_file, 'rb') as file_obj:
+        assert file_obj.read() == data
+    assert not os.path.exists(os.path.join(temp_dir, b'payload'))
+
