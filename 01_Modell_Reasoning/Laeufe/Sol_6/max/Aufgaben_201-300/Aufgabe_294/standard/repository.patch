+def test_is_child_path_checks_siblings_and_link_targets(tmp_path_factory):
+    parent = to_bytes(tmp_path_factory.mktemp('collection-paths'))
+    root = os.path.join(parent, b'collection')
+    sibling = os.path.join(parent, b'collection-other')
+    os.makedirs(root)
+    os.makedirs(sibling)
+
+    assert collection._is_child_path(root, root)
+    assert collection._is_child_path(os.path.join(root, b'docs', b'README.md'), root)
+    assert not collection._is_child_path(sibling, root)
+    assert collection._is_child_path(b'../README.md', root, os.path.join(root, b'docs', b'link'))
+    assert not collection._is_child_path(b'../../outside', root, os.path.join(root, b'docs', b'link'))
+
+    os.symlink(sibling, os.path.join(root, b'escape'))
+    assert not collection._is_child_path(os.path.join(root, b'escape', b'file'), root)
