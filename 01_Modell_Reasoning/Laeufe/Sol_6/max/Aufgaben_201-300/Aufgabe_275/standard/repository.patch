diff --git a/lib/httplib/httplib_test.go b/lib/httplib/httplib_test.go
index 9b7ff1e..b8ec13f 100644
--- a/lib/httplib/httplib_test.go
+++ b/lib/httplib/httplib_test.go
@@ -17,16 +17,70 @@ limitations under the License.
 package httplib
 
 import (
+	"errors"
 	"net/http"
 	"net/http/httptest"
 	"testing"
 
 	"github.com/julienschmidt/httprouter"
+	"github.com/stretchr/testify/require"
 	. "gopkg.in/check.v1"
 )
 
 func TestHTTP(t *testing.T) { TestingT(t) }
 
+func TestHandlersWithErrorWriter(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler func(StdHandlerFunc, ErrorWriter) http.HandlerFunc
+	}{
+		{
+			name: "router handler",
+			handler: func(fn StdHandlerFunc, errWriter ErrorWriter) http.HandlerFunc {
+				h := MakeHandlerWithErrorWriter(func(w http.ResponseWriter, r *http.Request, _ httprouter.Params) (interface{}, error) {
+					return fn(w, r)
+				}, errWriter)
+				return func(w http.ResponseWriter, r *http.Request) { h(w, r, nil) }
+			},
+		},
+		{
+			name: "standard handler",
+			handler: func(fn StdHandlerFunc, errWriter ErrorWriter) http.HandlerFunc {
+				return MakeStdHandlerWithErrorWriter(fn, errWriter)
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			wantErr := errors.New("handler failed")
+			var gotErr error
+			writeError := func(w http.ResponseWriter, err error) {
+				gotErr = err
+				w.WriteHeader(http.StatusTeapot)
+			}
+			h := tt.handler(func(http.ResponseWriter, *http.Request) (interface{}, error) {
+				return nil, wantErr
+			}, writeError)
+			w := httptest.NewRecorder()
+			h(w, httptest.NewRequest(http.MethodGet, "/", nil))
+			require.Equal(t, http.StatusTeapot, w.Code)
+			require.True(t, gotErr == wantErr)
+			require.Equal(t, "no-cache, no-store, must-revalidate", w.Header().Get("Cache-Control"))
+
+			gotErr = nil
+			h = tt.handler(func(http.ResponseWriter, *http.Request) (interface{}, error) {
+				return map[string]string{"value": "ok"}, nil
+			}, writeError)
+			w = httptest.NewRecorder()
+			h(w, httptest.NewRequest(http.MethodGet, "/", nil))
+			require.Nil(t, gotErr)
+			require.Equal(t, http.StatusOK, w.Code)
+			require.JSONEq(t, `{"value":"ok"}`, w.Body.String())
+			require.Equal(t, "no-cache, no-store, must-revalidate", w.Header().Get("Cache-Control"))
+		})
+	}
+}
+
 type HTTPSuite struct {
 }
 
