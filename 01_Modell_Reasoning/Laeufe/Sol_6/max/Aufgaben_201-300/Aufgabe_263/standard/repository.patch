+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package dynamoevents
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"reflect"
+
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/teleport/lib/events"
+	"github.com/gravitational/trace"
+)
+
+// decodeJSONFields keeps JSON numbers as decimal strings until DynamoDB has
+// encoded them. Converting through float64 would lose large integer values.
+func decodeJSONFields(data []byte) (map[string]interface{}, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	var extra interface{}
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return nil, trace.BadParameter("event fields contain trailing JSON")
+	}
+	return dynamoNumbers(fields).(map[string]interface{}), nil
+}
+
+func dynamoNumbers(value interface{}) interface{} {
+	switch value := value.(type) {
+	case json.Number:
+		return dynamodbattribute.Number(value)
+	case map[string]interface{}:
+		for key, child := range value {
+			value[key] = dynamoNumbers(child)
+		}
+	case []interface{}:
+		for i, child := range value {
+			value[i] = dynamoNumbers(child)
+		}
+	}
+	return value
+}
+
+func jsonNumbers(value interface{}) interface{} {
+	switch value := value.(type) {
+	case dynamodbattribute.Number:
+		return json.Number(value)
+	case map[string]interface{}:
+		for key, child := range value {
+			value[key] = jsonNumbers(child)
+		}
+	case []interface{}:
+		for i, child := range value {
+			value[i] = jsonNumbers(child)
+		}
+	}
+	return value
+}
+
+func fieldsEncoder() *dynamodbattribute.Encoder {
+	return dynamodbattribute.NewEncoder(func(encoder *dynamodbattribute.Encoder) {
+		encoder.EnableEmptyCollections = true
+		encoder.NullEmptyString = false
+	})
+}
+
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	av, err := fieldsEncoder().Encode(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return av.M, nil
+}
+
+func unmarshalEvent(item map[string]*dynamodb.AttributeValue, e *event) error {
+	decoder := dynamodbattribute.NewDecoder(func(decoder *dynamodbattribute.Decoder) {
+		decoder.UseNumber = true
+	})
+	return trace.Wrap(decoder.Decode(&dynamodb.AttributeValue{M: item}, e))
+}
+
+func eventJSON(e *event) ([]byte, error) {
+	if e.FieldsMap != nil {
+		return json.Marshal(jsonNumbers(e.FieldsMap))
+	}
+	if e.Fields == "" {
+		return nil, trace.BadParameter("event has neither FieldsMap nor legacy Fields")
+	}
+	return []byte(e.Fields), nil
+}
+
+func eventFields(e *event) (events.EventFields, error) {
+	data, err := eventJSON(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var fields events.EventFields
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return fields, nil
+}
+
+// convertLegacyFields verifies that the native map round trips to the same
+// JSON value, including nested objects, empty values, and number spelling.
+func convertLegacyFields(data string) (*dynamodb.AttributeValue, error) {
+	fields, err := decodeJSONFields([]byte(data))
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	av, err := fieldsEncoder().Encode(fields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var decoded map[string]interface{}
+	decoder := dynamodbattribute.NewDecoder(func(decoder *dynamodbattribute.Decoder) {
+		decoder.UseNumber = true
+	})
+	if err := decoder.Decode(av, &decoded); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(jsonNumbers(fields), jsonNumbers(decoded)) {
+		return nil, trace.BadParameter("FieldsMap does not preserve legacy JSON content")
+	}
+	return av, nil
+}
