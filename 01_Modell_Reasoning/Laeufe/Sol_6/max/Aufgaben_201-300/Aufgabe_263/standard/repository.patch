+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package dynamoevents
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/trace"
+)
+
+const fieldsMapMigrationLockTTL = 5 * time.Minute
+
+// migrateFieldsMap is safe to retry: a strongly consistent scan selects only
+// rows still using Fields, and each Put replaces its row atomically.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	flag := backend.FlagKey("dynamoEvents", l.Region, l.Tablename, "fieldsMap")
+	if _, err := l.backend.Get(ctx, flag); err == nil {
+		return nil
+	} else if !trace.IsNotFound(err) {
+		return trace.Wrap(err)
+	}
+
+	lockName := fmt.Sprintf("dynamoEvents/fieldsMap/%s/%s", l.Region, l.Tablename)
+	return backend.RunWhileLocked(ctx, l.backend, lockName, fieldsMapMigrationLockTTL, func(ctx context.Context) error {
+		// Check again after acquiring the lock; another node may have finished.
+		if _, err := l.backend.Get(ctx, flag); err == nil {
+			return nil
+		} else if !trace.IsNotFound(err) {
+			return trace.Wrap(err)
+		}
+
+		l.Info("Starting DynamoDB event FieldsMap migration")
+		if err := l.convertFieldsMap(ctx); err != nil {
+			return trace.Wrap(err)
+		}
+		if _, err := l.backend.Put(ctx, backend.Item{Key: flag, Value: []byte("complete")}); err != nil {
+			return trace.Wrap(err)
+		}
+		l.Info("Completed DynamoDB event FieldsMap migration")
+		return nil
+	})
+}
+
+func (l *Log) convertFieldsMap(ctx context.Context) error {
+	var startKey map[string]*dynamodb.AttributeValue
+	var total int64
+	for {
+		if err := ctx.Err(); err != nil {
+			return trace.Wrap(err)
+		}
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: startKey,
+			ConsistentRead:    aws.Bool(true),
+			Limit:             aws.Int64(DynamoBatchSize * maxMigrationWorkers),
+			FilterExpression:  aws.String("attribute_exists(#legacy) AND attribute_not_exists(#native)"),
+			ExpressionAttributeNames: map[string]*string{
+				"#legacy": aws.String(keyFields),
+				"#native": aws.String(keyFieldsMap),
+			},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+
+		requests := make([]*dynamodb.WriteRequest, 0, len(out.Items))
+		for _, item := range out.Items {
+			legacy := item[keyFields]
+			if legacy == nil || legacy.S == nil {
+				return trace.BadParameter("event %s has no legacy JSON string in Fields", eventKeyForLog(item))
+			}
+			fieldsMap, err := convertLegacyFields(aws.StringValue(legacy.S))
+			if err != nil {
+				return trace.WrapWithMessage(err, "cannot migrate event %s", eventKeyForLog(item))
+			}
+			item[keyFieldsMap] = fieldsMap
+			delete(item, keyFields)
+			requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+		}
+
+		// A scan page contains at most 32 batches. Finish it before moving the
+		// cursor, so an interrupted run can restart from the beginning safely.
+		var wg sync.WaitGroup
+		errors := make(chan error, maxMigrationWorkers)
+		for len(requests) > 0 {
+			n := len(requests)
+			if n > DynamoBatchSize {
+				n = DynamoBatchSize
+			}
+			batch := requests[:n]
+			requests = requests[n:]
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				if err := l.uploadFieldsBatch(ctx, batch); err != nil {
+					errors <- err
+				}
+			}()
+		}
+		wg.Wait()
+		close(errors)
+		for err := range errors {
+			return trace.Wrap(err)
+		}
+
+		total += int64(len(out.Items))
+		if len(out.Items) != 0 {
+			l.Infof("Migrated %d DynamoDB events to FieldsMap", total)
+		}
+		if len(out.LastEvaluatedKey) == 0 {
+			return nil
+		}
+		startKey = out.LastEvaluatedKey
+	}
+}
+
+func eventKeyForLog(item map[string]*dynamodb.AttributeValue) string {
+	var sessionID, eventIndex string
+	if value := item[keySessionID]; value != nil {
+		sessionID = aws.StringValue(value.S)
+	}
+	if value := item[keyEventIndex]; value != nil {
+		eventIndex = aws.StringValue(value.N)
+	}
+	return fmt.Sprintf("(SessionID=%q, EventIndex=%q)", sessionID, eventIndex)
+}
+
+func (l *Log) uploadFieldsBatch(ctx context.Context, requests []*dynamodb.WriteRequest) error {
+	delay := 100 * time.Millisecond
+	for len(requests) != 0 {
+		out, err := l.svc.BatchWriteItemWithContext(ctx, &dynamodb.BatchWriteItemInput{
+			RequestItems: map[string][]*dynamodb.WriteRequest{l.Tablename: requests},
+		})
+		if err != nil {
+			return trace.WrapWithMessage(convertError(err), "batch containing event %s (%d items remaining)", eventKeyForLog(requests[0].PutRequest.Item), len(requests))
+		}
+		requests = out.UnprocessedItems[l.Tablename]
+		if len(requests) == 0 {
+			return nil
+		}
+		select {
+		case <-time.After(delay):
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		}
+		if delay < 2*time.Second {
+			delay *= 2
+		}
+	}
+	return nil
+}
