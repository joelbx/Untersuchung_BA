+import errno
 import re
+import time
 
 
 def get_sysctl(module, prefixes):
     sysctl_cmd = module.get_bin_path('sysctl')
+    if not sysctl_cmd:
+        raise ValueError('Unable to find sysctl')
     cmd = [sysctl_cmd]
     cmd.extend(prefixes)
 
-    rc, out, err = module.run_command(cmd)
+    try:
+        rc, out, err = module.run_command(cmd)
+    except (IOError, OSError) as exc:
+        module.warn('Unable to read sysctl: %s' % exc)
+        return {}
     if rc != 0:
-        return dict()
+        module.warn('Unable to read sysctl: %s' % (err.strip() or 'exit code %s' % rc))
+        return {}
 
-    sysctl = dict()
+    sysctl = {}
+    previous_key = None
+    blank_lines = 0
     for line in out.splitlines():
         if not line:
+            blank_lines += 1
+            continue
+        if line[0].isspace():
+            if previous_key is None:
+                module.warn('Unable to split sysctl line (%s): no preceding sysctl key' % line)
+            else:
+                sysctl[previous_key] += '\n' * (blank_lines + 1) + line
+            blank_lines = 0
+            continue
+        blank_lines = 0
+        try:
+            (key, value) = re.split(r'\s*[=:]\s*|\s+', line, maxsplit=1)
+            if not key:
+                raise ValueError('missing sysctl key')
+        except ValueError as exc:
+            module.warn('Unable to split sysctl line (%s): %s' % (line, exc))
             continue
-        (key, value) = re.split(r'\s?=\s?|: ', line, maxsplit=1)
         sysctl[key] = value.strip()
+        previous_key = key
 
     return sysctl
+
+
+def get_bsd_uptime_facts(module):
+    sysctl_cmd = module.get_bin_path('sysctl')
+    if not sysctl_cmd:
+        raise ValueError('Unable to find sysctl')
+
+    try:
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'])
+    except (IOError, OSError) as exc:
+        if getattr(exc, 'errno', None) == errno.ENOENT:
+            raise ValueError('Unable to find sysctl: %s' % exc)
+        module.warn('Unable to read sysctl: %s' % exc)
+        return {}
+
+    if rc != 0:
+        return {}
+
+    boot_time = out.strip()
+    if not boot_time or not re.match(r'^[0-9]+$', boot_time):
+        return {}
+
+    return {'uptime_seconds': int(time.time() - int(boot_time))}
