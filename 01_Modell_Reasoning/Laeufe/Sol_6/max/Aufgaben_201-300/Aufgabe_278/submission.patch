diff --git a/applications/mail/src/app/logic/elements/elements.test.ts b/applications/mail/src/app/logic/elements/elements.test.ts
new file mode 100644
index 0000000..bea699d
--- /dev/null
+++ b/applications/mail/src/app/logic/elements/elements.test.ts
@@ -0,0 +1,150 @@
+import { Api } from '@proton/shared/lib/interfaces';
+import { globalReset } from '../actions';
+import { store } from '../store';
+import { backendActionFinished, backendActionStarted, invalidate, load, reset } from './elementsActions';
+import { loading, shouldSendRequest } from './elementsSelectors';
+import { QueryParams } from './elementsTypes';
+
+const response = (id: string, stale = 0) => ({
+    Total: 1,
+    Conversations: [{ ID: id, LabelIDs: ['0'] }],
+    Stale: stale,
+});
+
+const request = (api: jest.Mock): QueryParams => ({
+    api: api as unknown as Api,
+    abortController: undefined,
+    conversationMode: true,
+    page: 0,
+    params: store.getState().elements.params,
+});
+
+beforeEach(() => {
+    store.dispatch(globalReset());
+    jest.useFakeTimers();
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+describe('element list requests', () => {
+    it('discards a request started before a backend action even if that action finishes first', async () => {
+        let resolveResponse: (value: ReturnType<typeof response>) => void = () => {};
+        const api = jest
+            .fn()
+            .mockImplementationOnce(
+                () =>
+                    new Promise((resolve) => {
+                        resolveResponse = resolve;
+                    })
+            )
+            .mockResolvedValue(response('fresh'));
+        const query = request(api);
+
+        const pending = store.dispatch(load(query));
+        store.dispatch(backendActionStarted());
+        store.dispatch(backendActionFinished());
+        resolveResponse(response('old'));
+        await pending;
+
+        expect(store.getState().elements.elements).toEqual({});
+        expect(shouldSendRequest(store.getState(), { page: 0, params: query.params })).toBe(true);
+
+        await store.dispatch(load(query));
+        expect(Object.keys(store.getState().elements.elements)).toEqual(['fresh']);
+    });
+
+    it('discards a response received during overlapping backend actions and reloads after both finish', async () => {
+        const api = jest.fn().mockResolvedValue(response('fresh'));
+        const query = request(api);
+
+        store.dispatch(backendActionStarted());
+        store.dispatch(backendActionStarted());
+        await store.dispatch(load(query));
+
+        expect(store.getState().elements.elements).toEqual({});
+        expect(store.getState().elements.pendingActions).toBe(2);
+
+        store.dispatch(reset({ page: 0 }));
+        expect(store.getState().elements.pendingActions).toBe(2);
+        store.dispatch(backendActionFinished());
+        expect(store.getState().elements.pendingActions).toBe(1);
+        store.dispatch(backendActionFinished());
+        expect(shouldSendRequest(store.getState(), { page: 0, params: query.params })).toBe(true);
+
+        await store.dispatch(load(query));
+        expect(Object.keys(store.getState().elements.elements)).toEqual(['fresh']);
+    });
+
+    it('waits one second and retries a stale refresh without caching its result', async () => {
+        const api = jest
+            .fn()
+            .mockResolvedValueOnce(response('cached'))
+            .mockResolvedValueOnce(response('stale', 1))
+            .mockResolvedValueOnce(response('fresh'));
+        const query = request(api);
+
+        await store.dispatch(load(query));
+        store.dispatch(invalidate());
+        const first = await store.dispatch(load(query));
+        expect(first.type).toBe(load.rejected.type);
+        expect(Object.keys(store.getState().elements.elements)).toEqual(['cached']);
+
+        jest.advanceTimersByTime(999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.retry.error).toBeUndefined();
+        expect(shouldSendRequest(store.getState(), { page: 0, params: query.params })).toBe(true);
+
+        await store.dispatch(load(query));
+        expect(Object.keys(store.getState().elements.elements)).toContain('fresh');
+        expect(Object.keys(store.getState().elements.elements)).not.toContain('stale');
+        expect(api).toHaveBeenCalledTimes(3);
+    });
+
+    it('waits two seconds and retries a failed refresh of a cached page', async () => {
+        const error = new Error('request failed');
+        const api = jest
+            .fn()
+            .mockResolvedValueOnce(response('first'))
+            .mockRejectedValueOnce(error)
+            .mockResolvedValueOnce(response('fresh'));
+        const query = request(api);
+
+        await store.dispatch(load(query));
+        store.dispatch(invalidate());
+        const failed = await store.dispatch(load(query));
+        expect(failed.type).toBe(load.rejected.type);
+
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.retry.error).toBe(error);
+        expect(shouldSendRequest(store.getState(), { page: 0, params: query.params })).toBe(true);
+
+        await store.dispatch(load(query));
+        expect(Object.keys(store.getState().elements.elements)).toContain('fresh');
