+def test_open_filesystem_category(qtmodeltester, config_stub, info, tmp_path,
+                                  quickmark_manager_stub, bookmark_manager_stub):
+    """The filesystem category follows the configured order and stays visible."""
+    files = tmp_path / 'files'
+    files.mkdir()
+    local_file = files / 'local.html'
+    local_file.write_text('')
+    favorite = str(tmp_path / 'favorite.html')
+    config_stub.val.completion.favorite_paths = [favorite]
+    config_stub.val.url.searchengines = {
+        'DEFAULT': 'https://example.com/?q={}',
+        'example': 'https://example.com/?q={}',
+    }
+    config_stub.val.completion.open_categories = [
+        'filesystem', 'quickmarks', 'bookmarks', 'searchengines']
+
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    _check_completions(model, {
+        'Filesystem': [(favorite, None, None)],
+        'Search engines': [('example', 'https://example.com/?q={}', None)],
+    })
+    assert [model.data(model.index(i, 0)) for i in range(model.rowCount())] == [
+        'Filesystem', 'Search engines']
+
+    model.set_pattern(str(files) + '/')
+    _check_completions(model, {
+        'Filesystem': [(str(local_file), None, None)],
+        'Search engines': [],
+    })
+
+    model.set_pattern('no local path')
+    _check_completions(model, {
+        'Filesystem': [],
+        'Search engines': [],
+    })
+
+    config_stub.val.completion.open_categories = ['searchengines']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    _check_completions(model, {
+        'Search engines': [('example', 'https://example.com/?q={}', None)],
+    })
+
