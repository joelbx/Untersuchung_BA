+func TestInstanceMetadataClientIsAvailable(t *testing.T) {
+	tests := []struct {
+		name   string
+		body   string
+		status int
+		want   bool
+	}{
+		{name: "short instance ID", body: "i-1a2b3c4d", want: true},
+		{name: "long instance ID", body: "i-1234567890abcdef0", want: true},
+		{name: "captive portal", body: "<!DOCTYPE html><html>Login</html>"},
+		{name: "wrong prefix", body: "x-1a2b3c4d"},
+		{name: "wrong length", body: "i-123456789"},
+		{name: "overlong ID", body: "i-1234567890abcdef00"},
+		{name: "non-hex digit", body: "i-1234567g"},
+		{name: "uppercase digit", body: "i-1A2b3c4d"},
+		{name: "trailing content", body: "i-1a2b3c4d\n<html>Login</html>"},
+		{name: "metadata missing", status: http.StatusNotFound},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch {
+				case r.Method == http.MethodPut && r.URL.Path == "/latest/api/token":
+					w.Header().Set("X-Aws-Ec2-Metadata-Token-Ttl-Seconds", "60")
+					_, _ = io.WriteString(w, "test-token")
+				case r.Method == http.MethodGet && r.URL.Path == "/latest/meta-data/instance-id":
+					if r.Header.Get("X-Aws-Ec2-Metadata-Token") != "test-token" {
+						t.Errorf("metadata request is missing the IMDS token")
+					}
+					if tt.status != 0 {
+						w.WriteHeader(tt.status)
+					}
+					_, _ = io.WriteString(w, tt.body)
+				default:
+					t.Errorf("unexpected metadata request: %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(http.StatusNotFound)
+				}
+			}))
+			defer server.Close()
+
+			client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(imds.New(imds.Options{
+				Endpoint: server.URL,
+			})))
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, client.IsAvailable(context.Background()))
+		})
+	}
+}
+
+func TestNewInstanceMetadataClientOptions(t *testing.T) {
+	imdsClient := imds.New(imds.Options{})
+	client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(imdsClient), func(c *InstanceMetadataClient) error {
+		assert.Same(t, imdsClient, c.c)
+		return nil
+	})
+	require.NoError(t, err)
+	assert.Same(t, imdsClient, client.c)
+
+	wantErr := errors.New("invalid option")
+	client, err = NewInstanceMetadataClient(context.Background(), func(*InstanceMetadataClient) error {
+		return wantErr
+	})
+	require.Nil(t, client)
+	require.ErrorIs(t, err, wantErr)
+
+	client, err = NewInstanceMetadataClient(context.Background(), WithIMDSClient(nil))
+	require.Nil(t, client)
+	require.Error(t, err)
+}
