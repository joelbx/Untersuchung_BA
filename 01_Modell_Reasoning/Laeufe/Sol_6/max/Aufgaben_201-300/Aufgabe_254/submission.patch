+func TestInstanceMetadataClientIsAvailableTimeout(t *testing.T) {
+	deadlines := make(chan time.Duration, 1)
+	httpClient := metadataHTTPClientFunc(func(req *http.Request) (*http.Response, error) {
+		if req.Method == http.MethodPut {
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header: http.Header{
+					"X-Aws-Ec2-Metadata-Token-Ttl-Seconds": {"60"},
+				},
+				Body: io.NopCloser(strings.NewReader("test-token")),
+			}, nil
+		}
+		deadline, ok := req.Context().Deadline()
+		if !ok {
+			t.Error("metadata request has no deadline")
+		}
+		select {
+		case deadlines <- time.Until(deadline):
+		default:
+		}
+		<-req.Context().Done()
+		return nil, req.Context().Err()
+	})
+	client := &InstanceMetadataClient{c: imds.New(imds.Options{HTTPClient: httpClient})}
+	require.False(t, client.IsAvailable(context.Background()))
+	select {
+	case remaining := <-deadlines:
+		require.LessOrEqual(t, remaining, 250*time.Millisecond)
+	default:
+		t.Fatal("instance-id metadata was not requested")
+	}
+}
