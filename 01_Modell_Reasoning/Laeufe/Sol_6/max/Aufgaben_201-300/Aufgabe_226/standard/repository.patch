diff --git a/mime/mime.go b/mime/mime.go
new file mode 100644
index 0000000..f8b8189
--- /dev/null
+++ b/mime/mime.go
@@ -0,0 +1,67 @@
+package mime
+
+import (
+	"fmt"
+	"io/fs"
+	stdmime "mime"
+	"sort"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/resources"
+	"gopkg.in/yaml.v3"
+)
+
+const configFile = "mime_types.yaml"
+
+type configuration struct {
+	Types    map[string]string `yaml:"types"`
+	Lossless []string          `yaml:"lossless"`
+}
+
+var LosslessFormats []string
+
+func TypeByExtension(ext string) string {
+	return stdmime.TypeByExtension(ext)
+}
+
+func load(fsys fs.FS) error {
+	data, err := fs.ReadFile(fsys, configFile)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", configFile, err)
+	}
+
+	var cfg configuration
+	if err := yaml.Unmarshal(data, &cfg); err != nil {
+		return fmt.Errorf("parse %s: %w", configFile, err)
+	}
+	if cfg.Types == nil || cfg.Lossless == nil {
+		return fmt.Errorf("%s must define types and lossless", configFile)
+	}
+
+	for ext, typ := range cfg.Types {
+		if err := stdmime.AddExtensionType(ext, typ); err != nil {
+			return fmt.Errorf("register MIME type for %s: %w", ext, err)
+		}
+	}
+
+	LosslessFormats = make([]string, 0, len(cfg.Lossless))
+	for _, ext := range cfg.Lossless {
+		LosslessFormats = append(LosslessFormats, strings.TrimPrefix(ext, "."))
+	}
+	sort.Strings(LosslessFormats)
+
+	// Windows can identify these extensions as text/plain.
+	_ = stdmime.AddExtensionType(".js", "text/javascript")
+	_ = stdmime.AddExtensionType(".css", "text/css")
+	return nil
+}
+
+func init() {
+	conf.AddHook(func() {
+		if err := load(resources.FS()); err != nil {
+			log.Fatal("Error loading MIME types", err)
+		}
+	})
+}
diff --git a/mime/mime_test.go b/mime/mime_test.go
new file mode 100644
index 0000000..ba5e0c1
--- /dev/null
+++ b/mime/mime_test.go
@@ -0,0 +1,42 @@
+package mime
+
+import (
+	"mime"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/spf13/viper"
+)
+
+func TestLoadFromResourceOverride(t *testing.T) {
+	dataFolder := t.TempDir()
+	resourceFolder := filepath.Join(dataFolder, "resources")
+	if err := os.Mkdir(resourceFolder, 0755); err != nil {
+		t.Fatal(err)
+	}
+	configuration := []byte("types:\n  .ndtest: audio/x-ndtest\nlossless:\n  - .ndtest\n")
+	if err := os.WriteFile(filepath.Join(resourceFolder, configFile), configuration, 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	previousDataFolder := viper.Get("datafolder")
+	viper.Set("datafolder", dataFolder)
+	t.Cleanup(func() { viper.Set("datafolder", previousDataFolder) })
+	conf.Load()
+
+	if got := TypeByExtension(".ndtest"); got != "audio/x-ndtest" {
+		t.Errorf("custom MIME type = %q, want audio/x-ndtest", got)
+	}
+	if want := []string{"ndtest"}; !reflect.DeepEqual(LosslessFormats, want) {
+		t.Errorf("lossless formats = %v, want %v", LosslessFormats, want)
+	}
+	for ext, want := range map[string]string{".js": "text/javascript", ".css": "text/css"} {
+		if got := mime.TypeByExtension(ext); !strings.HasPrefix(got, want) {
+			t.Errorf("MIME type for %s = %q, want %s", ext, got, want)
+		}
+	}
+}
