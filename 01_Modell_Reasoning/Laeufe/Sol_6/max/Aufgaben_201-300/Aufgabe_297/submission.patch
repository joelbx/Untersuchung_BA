+// redactValue walks map values while retaining their keys and applies the
+// pattern to other values using Go's default string representation.
+func redactValue(v interface{}, re *regexp.Regexp) interface{} {
+	if v == nil {
+		return nil
+	}
+	value := reflect.ValueOf(v)
+	if value.Kind() == reflect.Map {
+		if value.IsNil() {
+			return v
+		}
+		keys := value.MapKeys()
+		values := make([]interface{}, len(keys))
+		resultType := value.Type()
+		for i, key := range keys {
+			if re.MatchString(fmt.Sprint(key.Interface())) {
+				values[i] = "[REDACTED]"
+			} else {
+				values[i] = redactValue(value.MapIndex(key).Interface(), re)
+			}
+			if values[i] != nil && !reflect.TypeOf(values[i]).AssignableTo(resultType.Elem()) {
+				resultType = reflect.MapOf(resultType.Key(), reflect.TypeOf((*interface{})(nil)).Elem())
+			}
+		}
+		result := reflect.MakeMapWithSize(resultType, len(keys))
+		for i, key := range keys {
+			item := reflect.Zero(resultType.Elem())
+			if values[i] != nil {
+				item = reflect.ValueOf(values[i])
+			}
+			result.SetMapIndex(key, item)
+		}
+		return result.Interface()
+	}
+	str, ok := v.(string)
+	if !ok {
+		str = fmt.Sprint(v)
+	}
+	redacted := re.ReplaceAllString(str, "$1[REDACTED]$2")
+	if ok || redacted != str {
+		return redacted
+	}
+	return v
+}
