+// validateIPAgainstList checks the connection peer against the configured CIDRs.
+// Invalid entries are ignored, so one typo cannot disable the valid ranges.
+func validateIPAgainstList(addr, list string) bool {
+	if strings.TrimSpace(list) == "" {
+		return false
+	}
+	if addr == "@" {
+		for _, entry := range strings.Split(list, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+
+	addr = strings.TrimSpace(addr)
+	ip := net.ParseIP(addr)
+	if ip == nil {
+		host, _, err := net.SplitHostPort(addr)
+		if err != nil {
+			return false
+		}
+		ip = net.ParseIP(strings.SplitN(host, "%", 2)[0])
+	}
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(list, ",") {
+		entry = strings.TrimSpace(entry)
+		_, network, err := net.ParseCIDR(entry)
+		if err == nil && network.Contains(ip) {
+			return true
+		}
+		// A single IP is equivalent to a one-host CIDR.
+		allowedIP := net.ParseIP(entry)
+		if allowedIP == nil {
+			host, _, err := net.SplitHostPort(entry)
+			if err == nil {
+				allowedIP = net.ParseIP(host)
+			}
+		}
+		if allowedIP != nil && allowedIP.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// handleLoginFromHeaders returns credentials only for a trusted connection peer.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	peer := r.RemoteAddr
+	if saved, ok := request.RemoteAddrFrom(r.Context()); ok {
+		peer = saved
+	}
+	if !validateIPAgainstList(peer, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" || strings.ContainsAny(username, ",\r\n") {
+		return nil
+	}
+
+	users := ds.User(r.Context())
+	user, err := users.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := users.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for reverse proxy login", countErr)
+			return nil
+		}
+		user = &model.User{
+			ID:          uuid.NewString(),
+			UserName:    username,
+			Name:        strings.Title(username),
+			NewPassword: uuid.NewString(),
+			IsAdmin:     count == 0,
+		}
+		if err = users.Put(user); err != nil {
+			log.Error(r, "Could not create reverse proxy user", "username", username, err)
+			return nil
+		}
+		user, err = users.FindByUsername(username)
+	}
+	if err != nil || user == nil {
+		log.Error(r, "Could not load reverse proxy user", "username", username, err)
+		return nil
+	}
+	if err = users.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update reverse proxy user's LastLoginAt", "username", username, err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create reverse proxy token", "username", username, err)
+		return nil
+	}
+	saltDigest := md5.Sum([]byte(uuid.NewString()))
+	salt := hex.EncodeToString(saltDigest[:])[:6]
+	subsonicToken := md5.Sum([]byte(user.Password + salt))
+	payload := map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         token,
+		"subsonicSalt":  salt,
+		"subsonicToken": hex.EncodeToString(subsonicToken[:]),
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
