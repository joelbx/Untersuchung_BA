+func TestReverseProxyCreatesRegularAndDefaultUsers(t *testing.T) {
+	tests.Init(t, false)
+	previous := *conf.Server
+	t.Cleanup(func() { *conf.Server = previous })
+	conf.Server.ReverseProxyWhitelist = "@"
+	conf.Server.ReverseProxyUserHeader = "" // Verify the Remote-User default.
+	conf.Server.ReverseProxyDefaultUser = "fallback"
+	ds := &tests.MockDataStore{}
+	_ = ds.User(context.Background()).Put(&model.User{UserName: "admin", Name: "Admin", IsAdmin: true, NewPassword: "secret"})
+
+	req := httptest.NewRequest("GET", "/index.html", nil)
+	req.RemoteAddr = "@"
+	payload := handleLoginFromHeaders(ds, req)
+	if payload == nil || payload["username"] != "fallback" || payload["isAdmin"] != false {
+		t.Fatalf("expected regular default user on trusted socket: %v", payload)
+	}
+	user, err := ds.User(req.Context()).FindByUsername("fallback")
+	if err != nil || user.LastLoginAt == nil {
+		t.Fatalf("default user missing login time: %v, %v", user, err)
+	}
+
+	req.Header.Set("Remote-User", "admin")
+	payload = handleLoginFromHeaders(ds, req)
+	if payload == nil || payload["name"] != "Admin" || payload["isAdmin"] != true {
+		t.Fatalf("existing user's current state not returned: %v", payload)
+	}
+
+	conf.Server.ReverseProxyDefaultUser = ""
+	req.Header.Del("Remote-User")
+	if handleLoginFromHeaders(ds, req) != nil {
+		t.Fatal("missing header returned authentication")
+	}
+}
