+func TestValidateIPAgainstList(t *testing.T) {
+	tests := []struct {
+		name, addr, list string
+		want             bool
+	}{
+		{"disabled", "192.0.2.4:1234", "", false},
+		{"IPv4", "192.0.2.4:1234", "198.51.100.0/24, 192.0.2.0/24", true},
+		{"IPv6", "[2001:db8::4]:1234", "invalid, 192.0.2.0/24, 2001:db8::/32", true},
+		{"IPv6 without port", "2001:db8::4", "2001:db8::/32", true},
+		{"invalid entries", "198.51.100.4:1234", "invalid, 192.0.2.0/24, 2001:db8::/32", false},
+		{"single host", "192.0.2.4:1234", "192.0.2.4", true},
+		{"host and port entry", "192.0.2.4:1234", "192.0.2.4:4567", true},
+		{"not IP", "192.0.2.4.attacker:1234", "192.0.2.0/24", false},
+		{"Unix socket", "@", "192.0.2.0/24, @", true},
+		{"Unix socket disabled", "@", "192.0.2.0/24", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := validateIPAgainstList(tc.addr, tc.list); got != tc.want {
+				t.Fatalf("validateIPAgainstList(%q, %q) = %v, want %v", tc.addr, tc.list, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestReverseProxyLoginAndConfig(t *testing.T) {
+	tests.Init(t, false)
+	previous := *conf.Server
+	t.Cleanup(func() { *conf.Server = previous })
+	conf.Server.ReverseProxyWhitelist = "192.0.2.0/24, 2001:db8::/32"
+	conf.Server.ReverseProxyUserHeader = "X-Proxy-User"
+	conf.Server.ReverseProxyDefaultUser = ""
+	ds := &tests.MockDataStore{}
+	fs := os.DirFS("tests/fixtures")
+	serve := serveIndex(ds, fs)
+
+	req := httptest.NewRequest("GET", "/index.html", nil)
+	req.RemoteAddr = "[2001:db8::4]:1234"
+	req.Header.Set("X-Proxy-User", "alice")
+	w := httptest.NewRecorder()
+	serve(w, req)
+	config := extractAppConfig(w.Body.String())
+	payload, ok := config["auth"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("expected authentication payload, got %v", config)
+	}
+	user, err := ds.User(req.Context()).FindByUsername("alice")
+	if err != nil || !user.IsAdmin || user.LastLoginAt == nil {
+		t.Fatalf("first proxy user should be an admin with a login time: %v, %v", user, err)
+	}
+	if payload["id"] != user.ID || payload["name"] != user.Name || payload["username"] != user.UserName || payload["isAdmin"] != true {
+		t.Fatalf("authentication payload does not reflect user: %v", payload)
+	}
+	token, ok := payload["token"].(string)
+	if !ok || token == "" {
+		t.Fatalf("expected token: %v", payload)
+	}
+	claims, err := auth.Validate(token)
+	if err != nil || claims["sub"] != "alice" || claims["uid"] != user.ID {
+		t.Fatalf("invalid token claims: %v, %v", claims, err)
+	}
+	salt, ok := payload["subsonicSalt"].(string)
+	if !ok || len(salt) != 6 {
+		t.Fatalf("invalid Subsonic salt: %v", payload["subsonicSalt"])
+	}
+	digest := md5.Sum([]byte(user.Password + salt))
+	if payload["subsonicToken"] != hex.EncodeToString(digest[:]) {
+		t.Fatalf("Subsonic token does not match user password and salt")
+	}
+	if config["firstTime"] != false || w.Header().Get("Cache-Control") != "private, no-store" {
+		t.Fatalf("unexpected index config or cache policy: %v", config)
+	}
+
+	// A forged forwarded address must not make a direct client trusted.
+	for _, peer := range []string{"198.51.100.4:1234", "@"} {
+		untrusted := httptest.NewRequest("GET", "/index.html", nil)
+		untrusted.RemoteAddr = peer
+		untrusted.Header.Set("X-Proxy-User", "alice")
+		untrusted.Header.Set("X-Forwarded-For", "192.0.2.4")
+		w = httptest.NewRecorder()
+		serve(w, untrusted)
+		if _, present := extractAppConfig(w.Body.String())["auth"]; present {
+			t.Fatalf("untrusted peer %q received credentials", peer)
+		}
+	}
+
+	// The server preserves the actual peer before its RealIP middleware runs.
+	forwarded := httptest.NewRequest("GET", "/index.html", nil)
+	forwarded.RemoteAddr = "192.0.2.4:1234"
+	forwarded.Header.Set("X-Proxy-User", "alice")
+	forwarded = forwarded.WithContext(request.WithRemoteAddr(forwarded.Context(), "198.51.100.4:1234"))
+	w = httptest.NewRecorder()
+	serve(w, forwarded)
+	if _, present := extractAppConfig(w.Body.String())["auth"]; present {
+		t.Fatal("a forwarded address overrode the connection peer")
+	}
+
+	conf.Server.ReverseProxyWhitelist = ""
+	w = httptest.NewRecorder()
+	serve(w, req)
+	if _, present := extractAppConfig(w.Body.String())["auth"]; present {
+		t.Fatal("empty whitelist returned credentials")
+	}
+}
