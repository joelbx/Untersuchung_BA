+def fetch_response(status, body=b'{}', retry_after=None):
+    info = {'status': status, 'msg': 'HTTP {0}'.format(status)}
+    if retry_after is not None:
+        info['retry-after'] = retry_after
+    return BytesIO(body) if status < 400 else None, info
+
+
+@pytest.mark.parametrize('status', [400, 401, 404, 503])
+def test_non_retryable_http_error(module, mocker, status):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url', return_value=fetch_response(status))
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+
+    with pytest.raises(HTTPError) as exc:
+        module.request('resource', method='GET')
+
+    assert str(status) in str(exc.value)
+    assert module.status == status
+    assert fetch.call_count == 1
+    sleep.assert_not_called()
+
+
+def test_rate_limit_retries_then_succeeds(module, mocker):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url', side_effect=[
+        fetch_response(429, retry_after='3'),
+        fetch_response(429),
+        fetch_response(200, body=b'{"id": "123"}'),
+    ])
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    warn = mocker.patch.object(module.module, 'warn')
+
+    assert module.request('resource', method='GET') == {'id': '123'}
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert sleep.call_count == 2
+    assert sleep.call_args_list[0][0] == (3.0,)
+    warn.assert_called_once()
+    assert 'rate limiter' in warn.call_args[0][0]
+    assert 'retry count: 2' in warn.call_args[0][0]
+
+
