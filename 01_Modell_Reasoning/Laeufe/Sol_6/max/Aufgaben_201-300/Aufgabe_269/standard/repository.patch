+// CveContentsFromTrivy keeps each Trivy severity and CVSS source separate.
+func CveContentsFromTrivy(cveID string, vul trivydbTypes.Vulnerability, severitySource string) models.CveContents {
+	type sourceData struct {
+		severity    trivydbTypes.Severity
+		hasSeverity bool
+		cvss        trivydbTypes.CVSS
+	}
+	sources := map[string]sourceData{}
+	for source, severity := range vul.VendorSeverity {
+		name := strings.ToLower(strings.TrimSpace(string(source)))
+		if name == "" {
+			continue
+		}
+		data := sources[name]
+		data.severity = severity
+		data.hasSeverity = true
+		sources[name] = data
+	}
+	for source, cvss := range vul.CVSS {
+		name := strings.ToLower(strings.TrimSpace(string(source)))
+		if name == "" {
+			continue
+		}
+		data := sources[name]
+		data.cvss = cvss
+		sources[name] = data
+	}
+	selectedSource := strings.ToLower(strings.TrimSpace(severitySource))
+	if selectedSource != "" {
+		if _, found := sources[selectedSource]; !found {
+			sources[selectedSource] = sourceData{}
+		}
+	}
+	if len(sources) == 0 {
+		sources["unknown"] = sourceData{}
+		selectedSource = "unknown"
+	}
+
+	references := make(models.References, 0, len(vul.References))
+	for _, refURL := range vul.References {
+		references = append(references, models.Reference{Source: "trivy", Link: refURL})
+	}
+	sort.Slice(references, func(i, j int) bool { return references[i].Link < references[j].Link })
+
+	var published, lastModified time.Time
+	if vul.PublishedDate != nil {
+		published = *vul.PublishedDate
+	}
+	if vul.LastModifiedDate != nil {
+		lastModified = *vul.LastModifiedDate
+	}
+
+	contents := models.CveContents{}
+	for source, data := range sources {
+		ctype := models.CveContentType("trivy:" + source)
+		severity := ""
+		switch {
+		case data.hasSeverity:
+			severity = data.severity.String()
+		case source == selectedSource && vul.Severity != "":
+			severity = vul.Severity
+		case data.cvss.V3Score > 0:
+			severity = cvss3Severity(data.cvss.V3Score)
+		}
+		contents[ctype] = []models.CveContent{{
+			Type:          ctype,
+			CveID:         cveID,
+			Title:         vul.Title,
+			Summary:       vul.Description,
+			Cvss2Score:    data.cvss.V2Score,
+			Cvss2Vector:   data.cvss.V2Vector,
+			Cvss3Score:    data.cvss.V3Score,
+			Cvss3Vector:   data.cvss.V3Vector,
+			Cvss3Severity: severity,
+			References:    append(models.References(nil), references...),
+			CweIDs:        append([]string(nil), vul.CweIDs...),
+			Published:     published,
+			LastModified:  lastModified,
+		}}
+	}
+	return contents
+}
+
+func cvss3Severity(score float64) string {
+	switch {
+	case score >= 9:
+		return "CRITICAL"
+	case score >= 7:
+		return "HIGH"
+	case score >= 4:
+		return "MEDIUM"
+	case score > 0:
+		return "LOW"
+	default:
+		return ""
+	}
+}
+
+// MergeCveContents preserves differing reports from the same source across targets.
+func MergeCveContents(dst, src models.CveContents) models.CveContents {
+	if dst == nil {
+		dst = models.CveContents{}
+	}
+	for ctype, contents := range src {
+		for _, content := range contents {
+			found := false
+			for _, existing := range dst[ctype] {
+				if reflect.DeepEqual(existing, content) {
+					found = true
+					break
+				}
+			}
+			if !found {
+				dst[ctype] = append(dst[ctype], content)
+			}
+		}
+	}
+	return dst
+}
