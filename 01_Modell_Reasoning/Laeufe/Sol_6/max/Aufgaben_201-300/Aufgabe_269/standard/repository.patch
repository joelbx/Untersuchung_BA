@@ -0,0 +1,48 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsKeepsVendorSeverityAndDates(t *testing.T) {
+	published := time.Date(2024, time.January, 2, 3, 4, 0, 0, time.UTC)
+	modified := published.Add(time.Hour)
+	vul := trivydbTypes.Vulnerability{
+		Title:            "Library vulnerability",
+		Description:      "Library details",
+		Severity:         "MEDIUM",
+		VendorSeverity:   trivydbTypes.VendorSeverity{"debian": trivydbTypes.SeverityLow, "ubuntu": trivydbTypes.SeverityMedium},
+		CVSS:             trivydbTypes.VendorCVSS{"nvd": {V2Score: 5.1, V2Vector: "AV:N", V3Score: 9.2, V3Vector: "CVSS:3.1/NVD"}, "redhat": {V3Score: 7.1, V3Vector: "CVSS:3.1/REDHAT"}},
+		References:       []string{"https://example.org/advisory"},
+		PublishedDate:    &published,
+		LastModifiedDate: &modified,
+	}
+	contents := getCveContents("CVE-2024-5678", vul, "ubuntu")
+	for ctype, wantSeverity := range map[models.CveContentType]string{
+		models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM",
+		models.TrivyNVD: "CRITICAL", models.TrivyRedHat: "HIGH",
+	} {
+		entries := contents[ctype]
+		if len(entries) != 1 {
+			t.Fatalf("%s: got %d entries", ctype, len(entries))
+		}
+		entry := entries[0]
+		if entry.Type != ctype || entry.CveID != "CVE-2024-5678" || entry.Cvss3Severity != wantSeverity || entry.Title != vul.Title || entry.Summary != vul.Description {
+			t.Errorf("%s: content fields differ: %+v", ctype, entry)
+		}
+		if !entry.Published.Equal(published) || !entry.LastModified.Equal(modified) || len(entry.References) != 1 {
+			t.Errorf("%s: date or reference missing: %+v", ctype, entry)
+		}
+	}
+	nvd := contents[models.TrivyNVD][0]
+	if nvd.Cvss2Score != 5.1 || nvd.Cvss2Vector != "AV:N" || nvd.Cvss3Score != 9.2 || nvd.Cvss3Vector != "CVSS:3.1/NVD" {
+		t.Errorf("NVD scoring lost: %+v", nvd)
+	}
+}
