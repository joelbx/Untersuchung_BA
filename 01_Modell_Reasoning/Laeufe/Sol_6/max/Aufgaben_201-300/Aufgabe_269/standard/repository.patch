diff --git a/contrib/trivy/pkg/converter_test.go b/contrib/trivy/pkg/converter_test.go
new file mode 100644
index 0000000..6c581d6
--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,105 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertKeepsTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2024, time.March, 1, 12, 0, 0, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	debian := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-1234",
+		PkgName:         "debian-package",
+		SeveritySource:  "debian",
+		Vulnerability: trivydbTypes.Vulnerability{
+			Title:            "A source-specific vulnerability",
+			Description:      "Description from Trivy",
+			Severity:         "LOW",
+			VendorSeverity:   trivydbTypes.VendorSeverity{"debian": trivydbTypes.SeverityLow, "redhat": trivydbTypes.SeverityHigh},
+			CVSS:             trivydbTypes.VendorCVSS{"nvd": {V2Score: 5, V2Vector: "AV:N/AC:L/Au:N/C:P/I:N/A:N", V3Score: 9.8, V3Vector: "CVSS:3.1/NVD"}, "redhat": {V3Score: 7.5, V3Vector: "CVSS:3.1/REDHAT"}},
+			References:       []string{"https://example.org/z", "https://example.org/a"},
+			PublishedDate:    &published,
+			LastModifiedDate: &modified,
+		},
+	}
+	ubuntu := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-1234",
+		PkgName:         "ubuntu-package",
+		SeveritySource:  "ubuntu",
+		Vulnerability: trivydbTypes.Vulnerability{
+			Title:            "Ubuntu title",
+			Description:      "Ubuntu description",
+			Severity:         "MEDIUM",
+			VendorSeverity:   trivydbTypes.VendorSeverity{"ubuntu": trivydbTypes.SeverityMedium},
+			CVSS:             trivydbTypes.VendorCVSS{"ubuntu": {V3Score: 5.2, V3Vector: "CVSS:3.1/UBUNTU"}},
+			References:       []string{"https://example.org/ubuntu"},
+			PublishedDate:    &published,
+			LastModifiedDate: &modified,
+		},
+	}
+	results := types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{debian}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{ubuntu}},
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{debian}},
+	}
+
+	result, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := result.ScannedCves["CVE-2024-1234"].CveContents
+	if len(contents) != 4 {
+		t.Fatalf("got %d sources, want debian, ubuntu, nvd, and redhat: %v", len(contents), contents)
+	}
+	if _, found := contents[models.Trivy]; found {
+		t.Fatal("generic Trivy content unexpectedly present")
+	}
+	for ctype, want := range map[models.CveContentType]struct {
+		severity string
+		score    float64
+	}{
+		models.TrivyDebian: {"LOW", 0},
+		models.TrivyUbuntu: {"MEDIUM", 5.2},
+		models.TrivyNVD:    {"CRITICAL", 9.8},
+		models.TrivyRedHat: {"HIGH", 7.5},
+	} {
+		entries := contents[ctype]
+		if len(entries) != 1 {
+			t.Fatalf("%s: got %d entries, want one", ctype, len(entries))
+		}
+		entry := entries[0]
+		if entry.Type != ctype || entry.CveID != "CVE-2024-1234" || entry.Cvss3Severity != want.severity || entry.Cvss3Score != want.score {
+			t.Errorf("%s: unexpected identity, severity, or score: %+v", ctype, entry)
+		}
+		if !entry.Published.Equal(published) || !entry.LastModified.Equal(modified) {
+			t.Errorf("%s: publication dates lost: %+v", ctype, entry)
+		}
+		if entry.Title == "" || entry.Summary == "" || len(entry.References) == 0 {
+			t.Errorf("%s: identification or references lost: %+v", ctype, entry)
+		}
+	}
+	nvd := contents[models.TrivyNVD][0]
+	if nvd.Cvss2Score != 5 || nvd.Cvss2Vector != "AV:N/AC:L/Au:N/C:P/I:N/A:N" || nvd.Cvss3Vector != "CVSS:3.1/NVD" {
+		t.Errorf("NVD CVSS metrics lost: %+v", nvd)
+	}
+	if nvd.References[0].Link != "https://example.org/a" || nvd.References[1].Link != "https://example.org/z" {
+		t.Errorf("references are not sorted: %+v", nvd.References)
+	}
+}
+
+func TestMergeCveContentsKeepsConflictingReports(t *testing.T) {
+	low := models.CveContent{Type: models.TrivyDebian, CveID: "CVE-2024-1234", Cvss3Severity: "LOW"}
+	high := low
+	high.Cvss3Severity = "HIGH"
+	contents := MergeCveContents(models.CveContents{models.TrivyDebian: {low}}, models.CveContents{models.TrivyDebian: {low, high}})
+	if got := contents[models.TrivyDebian]; len(got) != 2 || got[0].Cvss3Severity != "LOW" || got[1].Cvss3Severity != "HIGH" {
+		t.Fatalf("conflicting reports were lost: %+v", got)
+	}
+}
