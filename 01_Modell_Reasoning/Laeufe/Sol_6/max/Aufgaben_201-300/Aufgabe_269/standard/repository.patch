+package models
+
+import "testing"
+
+func TestTrivyContentTypesAndAggregations(t *testing.T) {
+	types := GetCveContentTypes("trivy")
+	for _, want := range []CveContentType{TrivyDebian, TrivyUbuntu, TrivyNVD, TrivyRedHat, TrivyGHSA, TrivyOracleOVAL} {
+		found := false
+		for _, got := range types {
+			if got == want {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Errorf("Trivy source %s missing from GetCveContentTypes", want)
+		}
+	}
+	if got := NewCveContentType("trivy:ghsa"); got != TrivyGHSA {
+		t.Errorf("NewCveContentType(trivy:ghsa) = %s", got)
+	}
+
+	custom := CveContentType("trivy:custom-vendor")
+	vinfo := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, Title: "Debian title", Summary: "Debian summary", Cvss3Severity: "LOW"}},
+		TrivyUbuntu: {{Type: TrivyUbuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Severity: "MEDIUM", Cvss3Score: 5.2, Cvss3Vector: "CVSS:3.1/UBUNTU"}},
+		TrivyNVD:    {{Type: TrivyNVD, Title: "NVD title", Summary: "NVD summary", Cvss2Score: 4.3, Cvss2Vector: "AV:N"}},
+		custom:      {{Type: custom, Title: "Custom title", Summary: "Custom summary", References: References{{Link: "https://example.org/custom"}}}},
+	}}
+	for ctype, want := range map[CveContentType]string{
+		TrivyDebian: "Debian title", TrivyUbuntu: "Ubuntu title", TrivyNVD: "NVD title", custom: "Custom title",
+	} {
+		if !hasCveContentStr(vinfo.Titles("en", "debian"), ctype, want) {
+			t.Errorf("title for %s missing", ctype)
+		}
+	}
+	for ctype, want := range map[CveContentType]string{
+		TrivyDebian: "Debian summary", TrivyUbuntu: "Ubuntu summary", TrivyNVD: "NVD summary", custom: "Custom summary",
+	} {
+		if !hasCveContentStr(vinfo.Summaries("en", "debian"), ctype, want) {
+			t.Errorf("summary for %s missing", ctype)
+		}
+	}
+	if got := vinfo.Cvss2Scores(); len(got) != 1 || got[0].Type != TrivyNVD || got[0].Value.Score != 4.3 || got[0].Value.Vector != "AV:N" {
+		t.Errorf("Trivy CVSS v2 missing: %+v", got)
+	}
+	var ubuntu, debian *CveContentCvss
+	for _, score := range vinfo.Cvss3Scores() {
+		if score.Type == TrivyUbuntu {
+			copy := score
+			ubuntu = &copy
+		}
+		if score.Type == TrivyDebian {
+			copy := score
+			debian = &copy
+		}
+	}
+	if ubuntu == nil || ubuntu.Value.Score != 5.2 || ubuntu.Value.Vector != "CVSS:3.1/UBUNTU" || ubuntu.Value.CalculatedBySeverity {
+		t.Errorf("Ubuntu numeric CVSS v3 missing: %+v", ubuntu)
+	}
+	if debian == nil || debian.Value.Severity != "LOW" || !debian.Value.CalculatedBySeverity {
+		t.Errorf("Debian severity missing: %+v", debian)
+	}
+	if refs := vinfo.CveContents.References("debian"); len(refs) != 1 || refs[0].Type != custom {
+		t.Errorf("custom Trivy references missing: %+v", refs)
+	}
+}
+
+func hasCveContentStr(values []CveContentStr, ctype CveContentType, value string) bool {
+	for _, item := range values {
+		if item.Type == ctype && item.Value == value {
+			return true
+		}
+	}
+	return false
+}
