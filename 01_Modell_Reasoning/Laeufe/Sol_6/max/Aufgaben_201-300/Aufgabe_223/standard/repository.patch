+    (b'#!/usr/bin/env ruby "one two"', {'ansible_env_interpreter': '/opt/env'}, b'#!/opt/env ruby "one two"'),
+))
+def test_new_style_shebang(source_shebang, task_vars, expected, tmp_path, mocker, templar):
+    module_path = tmp_path / 'fake_module.py'
+    module_path.write_bytes(source_shebang + b'\nfrom ansible.module_utils.basic import AnsibleModule\n')
+    mocker.patch.object(amc.C, 'DEFAULT_LOCAL_TMP', str(tmp_path))
