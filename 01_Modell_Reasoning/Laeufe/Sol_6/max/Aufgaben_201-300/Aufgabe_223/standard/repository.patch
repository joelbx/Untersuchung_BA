+    (b'', {}, b'#!/usr/bin/python'),
+    (b'#!/usr/bin/python3.8 -u', {'ansible_python_interpreter': '/opt/python'}, b'#!/opt/python -u'),
+    (b'#!/usr/bin/env python3.8 -I', {'ansible_python_interpreter': '/opt/python'}, b'#!/opt/python -I'),
