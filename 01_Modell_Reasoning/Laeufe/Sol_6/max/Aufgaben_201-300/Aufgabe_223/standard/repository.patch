+))
+def test_old_style_preserves_or_overrides_shebang(source, task_vars, expected, mocker, templar):
+    module_open = mocker.mock_open(read_data=source)
+    mocker.patch('__builtin__.open' if PY2 else 'builtins.open', module_open)
+
+    data, style, shebang = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
+
+    assert style == 'old'
+    assert shebang == expected.decode('utf-8')
+    assert data.startswith(expected + b'\n' + amc.b_ENCODING_STRING + b'\n')
+
+
