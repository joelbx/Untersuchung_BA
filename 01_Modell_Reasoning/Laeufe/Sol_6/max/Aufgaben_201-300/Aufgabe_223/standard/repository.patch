+
+    data, style, shebang = modify_module('fake_module', str(module_path), {}, templar, task_vars=task_vars)
+
+    assert style == 'new'
+    assert shebang == expected.decode('utf-8')
+    assert data.startswith(expected + b'\n' + amc.b_ENCODING_STRING + b'\n')
+
+
+def test_new_style_config_override(tmp_path, mocker, templar):
+    module_path = tmp_path / 'fake_module.py'
