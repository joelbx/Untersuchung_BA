+
+    def configured_interpreter(name, *args, **kwargs):
+        if name == 'INTERPRETER_PYTHON':
+            return '/opt/config/bin/python', 'ansible.cfg'
+        return get_config_value_and_origin(name, *args, **kwargs)
+
+    mocker.patch.object(amc.C.config, 'get_config_value_and_origin', side_effect=configured_interpreter)
+
+    data, style, shebang = modify_module('fake_module', str(module_path), {}, templar)
