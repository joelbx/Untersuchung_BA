+def test_js_log_to_ui_levels(config_stub, message_mock, caplog,
+                             level, ui_level):
+    config_stub.set_obj('content.javascript.log_message.levels', {
+        'userscript:*': ['info', 'warning', 'error'],
+    })
+
+    with caplog.at_level(getattr(logging, level.name.upper())):
+        assert shared._js_log_to_ui(level, 'userscript:_qute_stylesheet', 66,
+                                    'Unexpected failure')
+    assert message_mock.getmsg(ui_level).text == (
+        'JS: [userscript:_qute_stylesheet:66] Unexpected failure')
+
+
+@pytest.mark.parametrize('levels, excludes, source, msg, shown', [
+    ({'qute:*': ['error']}, {}, 'userscript:_qute_stylesheet',
+     'CSP error', False),
+    ({'userscript:*': ['warning']}, {}, 'userscript:_qute_stylesheet',
+     'CSP error', False),
+    ({'userscript:*': ['error']}, {'userscript:*': ['*CSP*']},
+     'userscript:_qute_stylesheet', 'CSP error', False),
+    ({'userscript:*': ['error']},
+     {'userscript:*': ['*other*'], 'userscript:_qute_*': ['*CSP*']},
+     'userscript:_qute_stylesheet', 'CSP error', False),
+    ({'userscript:*': ['error']}, {'qute:*': ['*CSP*']},
+     'userscript:_qute_stylesheet', 'CSP error', True),
+    ({'userscript:*': ['error']}, {'userscript:*': ['*csp*']},
+     'userscript:_qute_stylesheet', 'CSP error', True),
+    ({'userscript:*': ['error']}, {'userscript:*': ['*CSP*']},
+     'userscript:_qute_stylesheet', 'Unexpected failure', True),
+    (None, {}, 'userscript:_qute_stylesheet', 'CSP error', False),
+    ({'userscript:*': ['error']}, None, 'userscript:_qute_stylesheet',
+     'CSP error', True),
+])
+def test_js_log_to_ui_filters(config_stub, message_mock, caplog, levels,
+                              excludes, source, msg, shown):
+    config_stub.set_obj('content.javascript.log_message.levels', levels)
+    config_stub.set_obj('content.javascript.log_message.excludes', excludes)
+
+    with caplog.at_level(logging.ERROR):
+        assert shared._js_log_to_ui(usertypes.JsLogLevel.error,
+                                    source, 66, msg) is shown
+    assert len(message_mock.messages) == int(shown)
+
+
+def test_javascript_log_message_logger_fallback(config_stub, message_mock,
+                                                monkeypatch, caplog):
+    config_stub.set_obj('content.javascript.log_message.levels', {
+        'userscript:*': ['error'],
+    })
+    config_stub.set_obj('content.javascript.log_message.excludes', {
+        'userscript:_qute_stylesheet': ['Refused to apply inline style*'],
+    })
+    logged = []
+    monkeypatch.setitem(shared._JS_LOGMAP, 'debug', logged.append)
+
+    shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                  'userscript:_qute_stylesheet', 66,
+                                  'Refused to apply inline style because of '
+                                  'CSP')
+    assert message_mock.messages == []
+    assert logged == [
+        '[userscript:_qute_stylesheet:66] '
+        'Refused to apply inline style because of CSP',
+    ]
+
+    with caplog.at_level(logging.ERROR):
+        shared.javascript_log_message(usertypes.JsLogLevel.error,
+                                      'userscript:_qute_stylesheet', 67,
+                                      'Unexpected failure')
+    assert message_mock.getmsg(usertypes.MessageLevel.error).text == (
+        'JS: [userscript:_qute_stylesheet:67] Unexpected failure')
+    assert len(logged) == 1
