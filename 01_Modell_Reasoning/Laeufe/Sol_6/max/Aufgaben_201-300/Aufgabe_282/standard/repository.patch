+content.javascript.log_message.excludes:
+  type:
+    name: Dict
+    none_ok: true
+    keytype: String
+    valtype:
+      name: List
+      valtype: String
+  default: {}
+  desc: >-
+    JavaScript messages to exclude from the qutebrowser UI.
+
+    Each key is a glob pattern matching the message source. The associated list
+    contains glob patterns matching the message text. Messages matching both a
+    source and message pattern are excluded even if their level is enabled by
+    `content.javascript.log_message.levels`.
