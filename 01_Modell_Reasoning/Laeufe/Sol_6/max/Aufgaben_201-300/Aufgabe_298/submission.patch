 	Keys() []K
+	Values() []V
 }
 
+const evictionInterval = 10 * time.Millisecond
+
 type Options struct {
 	SizeLimit  uint64
 	DefaultTTL time.Duration
 }
 
 func NewSimpleCache[K comparable, V any](options ...Options) SimpleCache[K, V] {
+	var sizeLimit uint64
 	opts := []ttlcache.Option[K, V]{
 		ttlcache.WithDisableTouchOnHit[K, V](),
 	}
 	if len(options) > 0 {
 		o := options[0]
 		if o.SizeLimit > 0 {
+			sizeLimit = o.SizeLimit
 			opts = append(opts, ttlcache.WithCapacity[K, V](o.SizeLimit))
 		}
 		if o.DefaultTTL > 0 {
@@ -36,12 +42,35 @@ func NewSimpleCache[K comparable, V any](options ...Options) SimpleCache[K, V] {
 
 	c := ttlcache.New[K, V](opts...)
 	return &simpleCache[K, V]{
-		data: c,
+		data:      c,
+		sizeLimit: sizeLimit,
 	}
 }
 
 type simpleCache[K comparable, V any] struct {
-	data *ttlcache.Cache[K, V]
+	data             *ttlcache.Cache[K, V]
+	sizeLimit        uint64
+	evictionDeadline atomic.Pointer[time.Time]
+}
+
+func (c *simpleCache[K, V]) evictExpired() {
+	now := time.Now()
+	deadline := c.evictionDeadline.Load()
+	if deadline != nil && now.Before(*deadline) {
+		return
+	}
+
+	next := now.Add(evictionInterval)
+	if c.evictionDeadline.CompareAndSwap(deadline, &next) {
+		c.data.DeleteExpired()
+	}
+}
+
+func (c *simpleCache[K, V]) evictAtCapacity() {
+	// Expired items still occupy capacity until they are deleted.
+	if c.sizeLimit > 0 && uint64(c.data.Len()) >= c.sizeLimit {
+		c.data.DeleteExpired()
+	}
 }
 
 func (c *simpleCache[K, V]) Add(key K, value V) error {
@@ -49,6 +78,8 @@ func (c *simpleCache[K, V]) Add(key K, value V) error {
 }
 
 func (c *simpleCache[K, V]) AddWithTTL(key K, value V, ttl time.Duration) error {
+	c.evictExpired()
+	c.evictAtCapacity()
 	item := c.data.Set(key, value, ttl)
 	if item == nil {
 		return errors.New("failed to add item")
@@ -57,6 +88,7 @@ func (c *simpleCache[K, V]) AddWithTTL(key K, value V, ttl time.Duration) error
 }
 
 func (c *simpleCache[K, V]) Get(key K) (V, error) {
+	c.evictExpired()
 	item := c.data.Get(key)
 	if item == nil {
 		var zero V
@@ -66,12 +98,15 @@ func (c *simpleCache[K, V]) Get(key K) (V, error) {
 }
 
 func (c *simpleCache[K, V]) GetWithLoader(key K, loader func(key K) (V, time.Duration, error)) (V, error) {
+	c.evictExpired()
 	loaderWrapper := ttlcache.LoaderFunc[K, V](
 		func(t *ttlcache.Cache[K, V], key K) *ttlcache.Item[K, V] {
 			value, ttl, err := loader(key)
 			if err != nil {
 				return nil
 			}
+			c.evictExpired()
+			c.evictAtCapacity()
 			return t.Set(key, value, ttl)
 		},
 	)
@@ -84,5 +119,25 @@ func (c *simpleCache[K, V]) GetWithLoader(key K, loader func(key K) (V, time.Dur
 }
 
 func (c *simpleCache[K, V]) Keys() []K {
-	return c.data.Keys()
+	c.evictExpired()
+	keys := c.data.Keys()
+	active := keys[:0]
+	for _, key := range keys {
+		if c.data.Get(key) != nil {
+			active = append(active, key)
+		}
+	}
+	return active
+}
+
+func (c *simpleCache[K, V]) Values() []V {
+	c.evictExpired()
+	keys := c.data.Keys()
+	values := make([]V, 0, len(keys))
+	for _, key := range keys {
+		if item := c.data.Get(key); item != nil {
+			values = append(values, item.Value())
+		}
+	}
+	return values
 }
