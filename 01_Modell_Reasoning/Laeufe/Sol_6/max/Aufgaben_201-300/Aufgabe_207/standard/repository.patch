+        ('overlay', True, True, '--enable-features=User'),
+        ('never', True, False, '--enable-features=User'),
+    ])
+    def test_enable_features_with_overlay(self, config_stub, monkeypatch,
+                                          parser, bar, new_qt, is_mac,
+                                          expected):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
