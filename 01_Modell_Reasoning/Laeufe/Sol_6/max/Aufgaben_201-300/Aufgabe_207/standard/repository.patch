+    @pytest.mark.parametrize('cli_args, config_args, expected', [
+        ([], [], []),
+        (['--qt-flag', 'enable-features=CliA,CliB'],
+         ['enable-features=ConfigA,ConfigB'],
+         ['CliA', 'CliB', 'ConfigA', 'ConfigB']),
+        (['--qt-arg', 'enable-features', 'FromArg'],
+         ['enable-features=FromConfig'],
+         ['FromArg', 'FromConfig']),
+        (['--qt-flag', 'enable-features=First',
+          '--qt-flag', 'enable-features=Second'],
+         ['enable-features=Third', 'enable-features=Fourth'],
+         ['First', 'Second', 'Third', 'Fourth']),
+        (['--qt-flag', 'enable-features='], ['enable-features='], []),
+    ])
+    def test_enable_features(self, config_stub, monkeypatch, parser,
+                             cli_args, config_args, expected):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = config_args
+
+        args = qtargs.qt_args(parser.parse_args(cli_args))
+        feature_args = [arg for arg in args
+                        if arg.startswith('--enable-features=')]
+        if expected:
+            assert feature_args == ['--enable-features=' + ','.join(expected)]
+        else:
+            assert feature_args == []
+
+    def test_enable_features_webkit(self, config_stub, monkeypatch, parser):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebKit)
+        config_stub.val.qt.args = ['enable-features=FromConfig']
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=FromFlag',
+            '--qt-arg', 'enable-features', 'FromArg',
+        ])
+
+        assert qtargs.qt_args(parsed) == [
+            sys.argv[0], '--enable-features=FromFlag',
+            '--enable-features', 'FromArg', '--enable-features=FromConfig',
+        ]
+
+    @pytest.mark.parametrize('bar, new_qt, is_mac, expected', [
