+        parsed = parser.parse_args(['--qt-flag', 'enable-features=User'])
+        args = qtargs.qt_args(parsed)
+        assert [arg for arg in args
+                if arg.startswith('--enable-features=')] == [expected]
+
+    def test_enable_features_overlay_already_provided(self, config_stub,
