+    def test_find_staged_or_pending_matches_source_and_identifier(self, import_item_db):
+        import_item_db.multiple_insert(
+            'import_item',
+            [
+                {'id': 4, 'batch_id': 1, 'ia_id': 'amazon:9780143038252', 'status': 'staged'},
+                {'id': 5, 'batch_id': 1, 'ia_id': 'amazon:0143038257', 'status': 'pending'},
+                {'id': 6, 'batch_id': 1, 'ia_id': 'idb:9780143038252', 'status': 'pending'},
+                {'id': 7, 'batch_id': 1, 'ia_id': 'idb:0143038257', 'status': 'staged'},
+                {'id': 8, 'batch_id': 1, 'ia_id': 'other:9780143038252', 'status': 'staged'},
+                {'id': 9, 'batch_id': 2, 'ia_id': 'idb:9780143038252', 'status': 'created'},
+            ],
+        )
+
+        result = ImportItem.find_staged_or_pending(['9780143038252', '0143038257'])
+
+        assert isinstance(result, web.db.BaseResultSet)
+        assert {row.id for row in result} == {4, 5, 6, 7}
+
+    def test_find_staged_or_pending_accepts_custom_sources_and_empty_inputs(
+        self, import_item_db
+    ):
+        import_item_db.insert(
+            'import_item',
+            id=4,
+            batch_id=1,
+            ia_id='partner:9780143038252',
+            status='staged',
+        )
+
+        result = ImportItem.find_staged_or_pending(
+            ['9780143038252'], sources=iter(['partner'])
+        )
+
+        assert isinstance(result, web.db.BaseResultSet)
+        assert [row.ia_id for row in result] == ['partner:9780143038252']
+        assert list(ImportItem.find_staged_or_pending([])) == []
+        assert list(ImportItem.find_staged_or_pending(['9780143038252'], sources=[])) == []
