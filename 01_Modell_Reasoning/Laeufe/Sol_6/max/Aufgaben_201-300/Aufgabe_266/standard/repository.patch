+    def test_from_isbn_loads_staged_data_locally(self, monkeypatch):
+        queries = []
+        loaded = []
+        statuses = []
+        identifiers_seen = []
+
+        class Site:
+            def things(self, query):
+                queries.append(query)
+                return []
+
+            def get(self, key):
+                return key
+
+        row = web.storage(
+            ia_id='idb:9780143038252',
+            data=json.dumps({'title': 'A staged book', 'source_records': ['idb:9780143038252']}),
+            status='staged',
+        )
+
+        def find_staged_or_pending(identifiers):
+            identifiers_seen.extend(identifiers)
+            return [row]
+
+        def load(data, account_key):
+            loaded.append((data, account_key))
+            return {'success': True, 'edition': {'key': '/books/OL1M', 'status': 'created'}}
+
+        monkeypatch.setattr(web.ctx, 'site', Site(), raising=False)
+        monkeypatch.setattr(
+            models.ImportItem, 'find_staged_or_pending', find_staged_or_pending
+        )
+        monkeypatch.setattr(models.ImportItem, 'set_status', lambda self, status, ol_key: statuses.append((status, ol_key)))
+        monkeypatch.setattr(models.accounts, 'RunAs', lambda username: nullcontext())
+        monkeypatch.setattr(models.add_book, 'load', load)
+        monkeypatch.setattr(models, 'do_import', lambda item: pytest.fail('HTTP import used'))
+
+        assert models.Edition.from_isbn('0143038257') == '/books/OL1M'
+        assert identifiers_seen == ['9780143038252', '0143038257']
+        assert queries == [
+            {'type': '/type/edition', 'isbn_13': '9780143038252'},
+            {'type': '/type/edition', 'isbn_10': '0143038257'},
+        ]
+        assert loaded == [
+            (
+                {'title': 'A staged book', 'source_records': ['idb:9780143038252']},
+                'account/ImportBot',
+            )
+        ]
+        assert statuses == [('created', '/books/OL1M')]
