+func TestConvertToVinfosWordPress(t *testing.T) {
+	tests := []struct {
+		name             string
+		body             string
+		wantSummary      string
+		wantOptional     map[string]string
+		wantFixedIn      string
+		wantCvssScore    float64
+		wantCvssVector   string
+		wantCvssSeverity string
+	}{
+		{
+			name: "enterprise",
+			body: `{"612":{"vulnerabilities":[{
+				"id":"42","title":"Example issue","description":"Detailed issue summary",
+				"poc":"https://example.org/poc","introduced_in":"6.0",
+				"created_at":"2024-03-01T12:30:00+03:00","updated_at":"2024-03-02T05:10:00-04:00",
+				"vuln_type":"XSS","fixed_in":"6.1.3",
+				"references":{"cve":["2024-1000","2024-1001"],"url":["https://example.org/first","https://example.org/second"]},
+				"cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:N","severity":"HIGH"}
+			}]}}`,
+			wantSummary:      "Detailed issue summary",
+			wantOptional:     map[string]string{"poc": "https://example.org/poc", "introduced_in": "6.0"},
+			wantFixedIn:      "6.1.3",
+			wantCvssScore:    7.5,
+			wantCvssVector:   "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:N",
+			wantCvssSeverity: "HIGH",
+		},
+		{
+			name: "basic omitted fields",
+			body: `{"612":{"vulnerabilities":[{
+				"id":"42","title":"Example issue",
+				"created_at":"2024-03-01T12:30:00+03:00","updated_at":"2024-03-02T05:10:00-04:00",
+				"vuln_type":"XSS",
+				"references":{"cve":["2024-1000","2024-1001"],"url":["https://example.org/first","https://example.org/second"]}
+			}]}}`,
+			wantOptional: map[string]string{},
+		},
+		{
+			name: "basic null fields",
+			body: `{"612":{"vulnerabilities":[{
+				"id":"42","title":"Example issue","description":null,"poc":null,"introduced_in":null,
+				"created_at":"2024-03-01T12:30:00+03:00","updated_at":"2024-03-02T05:10:00-04:00",
+				"vuln_type":"XSS","fixed_in":null,"cvss":null,
+				"references":{"cve":["2024-1000","2024-1001"],"url":["https://example.org/first","https://example.org/second"]}
+			}]}}`,
+			wantOptional: map[string]string{},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := convertToVinfos("core", tt.body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := []models.VulnInfo{{
+				CveID: "CVE-2024-1000",
+				CveContents: models.NewCveContents(models.CveContent{
+					Type:          models.WpScan,
+					CveID:         "CVE-2024-1000",
+					Title:         "Example issue",
+					Summary:       tt.wantSummary,
+					Cvss3Score:    tt.wantCvssScore,
+					Cvss3Vector:   tt.wantCvssVector,
+					Cvss3Severity: tt.wantCvssSeverity,
+					References: models.References{
+						{Link: "https://example.org/first"},
+						{Link: "https://example.org/second"},
+					},
+					Published:    time.Date(2024, 3, 1, 9, 30, 0, 0, time.UTC),
+					LastModified: time.Date(2024, 3, 2, 9, 10, 0, 0, time.UTC),
+					Optional:     tt.wantOptional,
+				}),
+				VulnType:    "XSS",
+				Confidences: models.Confidences{models.WpScanMatch},
+				WpPackageFixStats: models.WpPackageFixStats{{
+					Name:    "core",
+					FixedIn: tt.wantFixedIn,
+				}},
+			}}
+			if !reflect.DeepEqual(got, want) {
+				t.Errorf("convertToVinfos() = %#v, want %#v", got, want)
+			}
+		})
+	}
+}
