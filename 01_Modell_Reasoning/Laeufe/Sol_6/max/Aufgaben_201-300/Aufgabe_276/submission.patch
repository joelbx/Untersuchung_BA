+func TestLoadAuthenticationProviderValidation(t *testing.T) {
+	tests := []struct {
+		name                      string
+		method                    string
+		missingField              string
+		blankField                string
+		invalidSecondOIDCProvider bool
+		disabled                  bool
+		allowedOrg                bool
+		includeOrgScope           bool
+		wantErr                   string
+	}{
+		{name: "github missing client ID", method: "github", missingField: "client_id", wantErr: `provider "github": field "client_id": non-empty value is required`},
+		{name: "github missing client secret", method: "github", missingField: "client_secret", wantErr: `provider "github": field "client_secret": non-empty value is required`},
+		{name: "github missing redirect address", method: "github", missingField: "redirect_address", wantErr: `provider "github": field "redirect_address": non-empty value is required`},
+		{name: "github blank client ID", method: "github", blankField: "client_id", wantErr: `provider "github": field "client_id": non-empty value is required`},
+		{name: "oidc foo missing client ID", method: "oidc", missingField: "client_id", wantErr: `provider "foo": field "client_id": non-empty value is required`},
+		{name: "oidc foo missing client secret", method: "oidc", missingField: "client_secret", wantErr: `provider "foo": field "client_secret": non-empty value is required`},
+		{name: "oidc foo missing redirect address", method: "oidc", missingField: "redirect_address", wantErr: `provider "foo": field "redirect_address": non-empty value is required`},
+		{name: "oidc foo blank client secret", method: "oidc", blankField: "client_secret", wantErr: `provider "foo": field "client_secret": non-empty value is required`},
+		{name: "oidc second provider missing client secret", method: "oidc", invalidSecondOIDCProvider: true, wantErr: `provider "bar": field "client_secret": non-empty value is required`},
+		{name: "github with organization scope", method: "github", allowedOrg: true, includeOrgScope: true},
+		{name: "oidc foo with credentials", method: "oidc"},
+		{name: "disabled github", method: "github", disabled: true},
+		{name: "disabled oidc", method: "oidc", disabled: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			lines := []string{
+				"authentication:",
+				"  session:",
+				"    domain: localhost",
+				"  methods:",
+				"    " + tt.method + ":",
+				fmt.Sprintf("      enabled: %t", !tt.disabled),
+			}
+
+			indent := "      "
+			if tt.method == "oidc" {
+				lines = append(lines, "      providers:", "        foo:")
+				indent = "          "
+			}
+
+			if !tt.disabled {
+				for _, field := range []struct{ name, value string }{
+					{"client_id", "client-id"},
+					{"client_secret", "client-secret"},
+					{"redirect_address", "http://localhost/callback"},
+				} {
+					if field.name == tt.missingField {
+						continue
+					}
+
+					value := field.value
+					if field.name == tt.blankField {
+						value = "   "
+					}
+					lines = append(lines, fmt.Sprintf("%s%s: %q", indent, field.name, value))
+				}
+			}
+			if tt.invalidSecondOIDCProvider {
+				lines = append(lines,
+					"        bar:",
+					"          client_id: second-client-id",
+					"          redirect_address: http://localhost/second-callback",
+				)
+			}
+
+			if tt.allowedOrg {
+				lines = append(lines, "      allowed_organizations:", "        - flipt-io")
+			}
+			if tt.includeOrgScope {
+				lines = append(lines, "      scopes:", "        - read:org")
+			}
+
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(strings.Join(lines, "\n")+"\n"), 0600))
+			_, err := Load(path)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+}
