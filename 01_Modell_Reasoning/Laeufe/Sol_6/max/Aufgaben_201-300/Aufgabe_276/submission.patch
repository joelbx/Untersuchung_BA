+
+func validateOAuthProviderCredentials(provider, clientID, clientSecret, redirectAddress string) error {
+	for _, field := range []struct {
+		name  string
+		value string
+	}{
+		{"client_id", clientID},
+		{"client_secret", clientSecret},
+		{"redirect_address", redirectAddress},
+	} {
+		if strings.TrimSpace(field.value) == "" {
+			return fmt.Errorf("provider %q: %w", provider, errFieldRequired(field.name))
+		}
 	}
 
 	return nil
