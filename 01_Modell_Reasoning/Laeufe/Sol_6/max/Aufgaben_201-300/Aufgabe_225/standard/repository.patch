+func decodeKEVResponse(body string) (kevulndb.Response, error) {
+	data := bytes.TrimSpace([]byte(body))
+	if len(data) > 0 && data[0] == '[' {
+		// Older go-kev HTTP servers returned only CISA entries as an array.
+		var cisa []kevulnmodels.KEVuln
+		if err := json.Unmarshal(data, &cisa); err != nil {
+			return kevulndb.Response{}, err
+		}
+		return kevulndb.Response{CISA: cisa}, nil
+	}
+	var response kevulndb.Response
+	if err := json.Unmarshal(data, &response); err != nil {
+		return kevulndb.Response{}, err
+	}
+	return response, nil
+}
+
+func toKEVs(source kevulndb.Response) (kevs []models.KEV) {
+	for _, cisa := range source.CISA {
+		kevs = append(kevs, models.KEV{
+			Type:                       models.CISAKEVType,
+			VendorProject:              cisa.VendorProject,
+			Product:                    cisa.Product,
+			VulnerabilityName:          cisa.VulnerabilityName,
+			ShortDescription:           cisa.ShortDescription,
+			RequiredAction:             cisa.RequiredAction,
+			KnownRansomwareCampaignUse: cisa.KnownRansomwareCampaignUse,
+			DateAdded:                  cisa.DateAdded,
+			DueDate:                    validKEVDueDate(cisa.DueDate),
+			CISA:                       &models.CISAKEV{Note: cisa.Notes},
+		})
+	}
+	for _, vulncheck := range source.VulnCheck {
+		kev := models.KEV{
+			Type:                       models.VulnCheckKEVType,
+			VendorProject:              vulncheck.VendorProject,
+			Product:                    vulncheck.Product,
+			VulnerabilityName:          vulncheck.Name,
+			ShortDescription:           vulncheck.Description,
+			RequiredAction:             vulncheck.RequiredAction,
+			KnownRansomwareCampaignUse: vulncheck.KnownRansomwareCampaignUse,
+			DateAdded:                  vulncheck.DateAdded,
+			VulnCheck:                  &models.VulnCheckKEV{},
+		}
+		if vulncheck.DueDate != nil {
+			kev.DueDate = validKEVDueDate(*vulncheck.DueDate)
+		}
+		for _, xdb := range vulncheck.VulnCheckXDB {
+			kev.VulnCheck.XDB = append(kev.VulnCheck.XDB, models.VulnCheckXDB{
+				XDBID:       xdb.XDBID,
+				XDBURL:      xdb.XDBURL,
+				DateAdded:   xdb.DateAdded,
+				ExploitType: xdb.ExploitType,
+				CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, reported := range vulncheck.VulnCheckReportedExploitation {
+			kev.VulnCheck.ReportedExploitation = append(kev.VulnCheck.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL:       reported.URL,
+				DateAdded: reported.DateAdded,
+			})
+		}
+		kevs = append(kevs, kev)
+	}
+	return kevs
+}
+
+func validKEVDueDate(date time.Time) *time.Time {
+	// go-kev uses year 1000 when a date is missing or cannot be parsed.
+	if date.IsZero() || date.Year() <= 1000 {
+		return nil
+	}
+	return &date
+}
