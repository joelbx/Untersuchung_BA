@@ -0,0 +1,118 @@
+//go:build !scanner
+// +build !scanner
+
+package detector
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/logging"
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestToKEVs(t *testing.T) {
+	added := time.Date(2024, time.July, 1, 0, 0, 0, 0, time.UTC)
+	due := added.AddDate(0, 0, 14)
+	missing := time.Date(1000, time.January, 1, 0, 0, 0, 0, time.UTC)
+	source := kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{
+			VendorProject: "CISA vendor", Product: "CISA product",
+			VulnerabilityName: "CISA name", ShortDescription: "CISA description",
+			RequiredAction: "CISA action", KnownRansomwareCampaignUse: "Known",
+			DateAdded: added, DueDate: missing, Notes: "CISA note",
+		}},
+		VulnCheck: []kevulnmodels.VulnCheck{{
+			VendorProject: "VulnCheck vendor", Product: "VulnCheck product",
+			Name: "VulnCheck name", Description: "VulnCheck description",
+			RequiredAction: "VulnCheck action", KnownRansomwareCampaignUse: "Unknown",
+			DateAdded: added, DueDate: &due,
+			VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{
+				XDBID: "xdb-1", XDBURL: "https://xdb.example/1", DateAdded: added,
+				ExploitType: "poc", CloneSSHURL: "git@example:xdb-1",
+			}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{
+				URL: "https://report.example/1", DateAdded: added,
+			}},
+		}},
+	}
+	want := []models.KEV{
+		{
+			Type: models.CISAKEVType, VendorProject: "CISA vendor", Product: "CISA product",
+			VulnerabilityName: "CISA name", ShortDescription: "CISA description",
+			RequiredAction: "CISA action", KnownRansomwareCampaignUse: "Known",
+			DateAdded: added, CISA: &models.CISAKEV{Note: "CISA note"},
+		},
+		{
+			Type: models.VulnCheckKEVType, VendorProject: "VulnCheck vendor", Product: "VulnCheck product",
+			VulnerabilityName: "VulnCheck name", ShortDescription: "VulnCheck description",
+			RequiredAction: "VulnCheck action", KnownRansomwareCampaignUse: "Unknown",
+			DateAdded: added, DueDate: &due,
+			VulnCheck: &models.VulnCheckKEV{
+				XDB: []models.VulnCheckXDB{{
+					XDBID: "xdb-1", XDBURL: "https://xdb.example/1", DateAdded: added,
+					ExploitType: "poc", CloneSSHURL: "git@example:xdb-1",
+				}},
+				ReportedExploitation: []models.VulnCheckReportedExploitation{{
+					URL: "https://report.example/1", DateAdded: added,
+				}},
+			},
+		},
+	}
+	if got := toKEVs(source); !reflect.DeepEqual(got, want) {
+		t.Errorf("toKEVs() = %#v, want %#v", got, want)
+	}
+	if validKEVDueDate(time.Time{}) != nil || validKEVDueDate(missing) != nil {
+		t.Error("missing due dates must be nil")
+	}
+}
+
+func TestFillWithKEVulnHTTP(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var source kevulndb.Response
+		if r.URL.Path == "/cves/CVE-2024-0001" {
+			source.CISA = []kevulnmodels.KEVuln{{VulnerabilityName: "CISA record"}}
+			source.VulnCheck = []kevulnmodels.VulnCheck{{Name: "VulnCheck record"}}
+		}
+		if err := json.NewEncoder(w).Encode(source); err != nil {
+			t.Errorf("encode response: %v", err)
+		}
+	}))
+	defer server.Close()
+
+	r := models.ScanResult{ScannedCves: models.VulnInfos{
+		"CVE-2024-0001": {CveID: "CVE-2024-0001", AlertDict: models.AlertDict{JPCERT: []models.Alert{{Title: "Existing alert"}}}},
+		"CVE-2024-0002": {CveID: "CVE-2024-0002"},
+	}}
+	cnf := config.KEVulnConf{VulnDict: config.VulnDict{Type: "http", URL: server.URL}}
+	if err := FillWithKEVuln(&r, cnf, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	got := r.ScannedCves["CVE-2024-0001"]
+	if len(got.KEVs) != 2 || got.KEVs[0].Type != models.CISAKEVType || got.KEVs[1].Type != models.VulnCheckKEVType {
+		t.Errorf("KEVs = %#v, want one entry from each source", got.KEVs)
+	}
+	if len(got.AlertDict.CISA) != 0 || len(got.AlertDict.JPCERT) != 1 {
+		t.Errorf("alerts = %#v, want existing JPCERT alert without synthetic CISA alert", got.AlertDict)
+	}
+	if len(r.ScannedCves["CVE-2024-0002"].KEVs) != 0 {
+		t.Error("CVE without feed entries must have no KEVs")
+	}
+}
+
+func TestDecodeKEVResponseLegacy(t *testing.T) {
+	response, err := decodeKEVResponse(`[{"vulnerabilityName":"Legacy CISA entry"}]`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(response.CISA) != 1 || response.CISA[0].VulnerabilityName != "Legacy CISA entry" || len(response.VulnCheck) != 0 {
+		t.Errorf("legacy response = %#v", response)
+	}
+}
