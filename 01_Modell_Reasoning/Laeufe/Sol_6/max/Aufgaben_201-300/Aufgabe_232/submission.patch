diff --git a/config/os.go b/config/os.go
new file mode 100644
index 0000000..cbd696c
--- /dev/null
+++ b/config/os.go
@@ -0,0 +1,127 @@
+package config
+
+import (
+	"strings"
+	"time"
+)
+
+// OS family identifiers and the pseudo server type.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// Major extracts the major version after an optional epoch prefix.
+// It also accepts releases without a minor version.
+func Major(version string) string {
+	if i := strings.IndexByte(version, ':'); i >= 0 {
+		version = version[i+1:]
+	}
+	if i := strings.IndexByte(version, '.'); i >= 0 {
+		return version[:i]
+	}
+	return version
+}
+
+// EOL describes the end dates for standard and, if offered, extended OS support.
+// Ended is a snapshot of standard support status when GetEOL is called.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether now is strictly after the standard support end date.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether now is strictly after the extended support end date.
+// The spelling is kept as part of the public API.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+func eolDate(date string) time.Time {
+	if date == "" {
+		return time.Time{}
+	}
+	t, err := time.Parse("2006-01-02", date)
+	if err != nil {
+		panic(err) // All dates below are fixed literals.
+	}
+	return t
+}
+
+func supportEnds(standard, extended string) EOL {
+	return EOL{StandardSupportUntil: eolDate(standard), ExtendedSupportUntil: eolDate(extended)}
+}
+
+var osEOL = map[string]map[string]EOL{
+	Amazon: {
+		"2018.03":   supportEnds("2023-06-30", "2023-06-30"),
+		"2 (Karoo)": supportEnds("2025-06-30", ""),
+	},
+	RedHat: {
+		"7": supportEnds("2024-06-30", ""),
+		"8": supportEnds("2029-05-31", ""),
+		"6": supportEnds("2020-11-30", "2024-06-30"),
+	},
+	CentOS: {
+		"7": supportEnds("2024-06-30", ""),
+		"8": supportEnds("2021-12-31", ""),
+		"6": supportEnds("2020-11-30", "2020-11-30"),
+	},
+	Oracle: {
+		"7": supportEnds("2024-06-30", ""),
+		"8": supportEnds("2029-05-31", ""),
+		"6": supportEnds("2021-03-31", "2022-03-31"),
+	},
+	Ubuntu: {
+		"18.04": supportEnds("2023-05-31", "2028-04-30"),
+		"14.04": supportEnds("2019-04-30", "2024-04-30"),
+		"14.10": supportEnds("2015-07-30", "2015-07-30"),
+		"21.04": supportEnds("2022-01-30", ""),
+	},
+	Debian: {
+		"9":  supportEnds("2022-06-30", ""),
+		"10": supportEnds("2024-06-30", ""),
+		"8":  supportEnds("2020-06-30", "2020-06-30"),
+	},
+	Alpine: {
+		"3.10": supportEnds("2021-05-30", ""),
+		"3.11": supportEnds("2021-11-30", ""),
+		"3.12": supportEnds("2022-05-30", ""),
+		"3.9":  supportEnds("2020-11-30", "2020-11-30"),
+	},
+	FreeBSD: {
+		"11": supportEnds("2021-09-30", "2021-09-30"),
+		"12": supportEnds("2023-12-31", ""),
+		"10": supportEnds("2019-10-30", "2019-10-30"),
+	},
+}
+
+// GetEOL returns lifecycle dates for the exact family and release identifier.
+func GetEOL(family string, release string) (EOL, bool) {
+	e, found := osEOL[family][release]
+	if !found {
+		return EOL{}, false
+	}
+	e.Ended = e.IsStandardSupportEnded(time.Now())
+	return e, true
+}
