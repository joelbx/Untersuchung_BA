diff --git a/scan/eol.go b/scan/eol.go
new file mode 100644
index 0000000..ed7728d
--- /dev/null
+++ b/scan/eol.go
@@ -0,0 +1,54 @@
+package scan
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/util"
+)
+
+// eolRelease selects the release identifier used by the lifecycle table.
+// Amazon releases are kept intact: 2018.03 is Linux 1, while 2 (Karoo) is Linux 2.
+func eolRelease(family, release string) string {
+	release = strings.TrimSpace(release)
+	switch family {
+	case config.RedHat, config.CentOS, config.Oracle, config.Debian, config.FreeBSD:
+		return util.Major(release)
+	case config.Ubuntu, config.Alpine:
+		parts := strings.SplitN(release, ".", 3)
+		if len(parts) >= 2 {
+			return strings.Join(parts[:2], ".")
+		}
+	}
+	return release
+}
+
+func eolWarnings(family, release string, now time.Time) []string {
+	if family == config.ServerTypePseudo || family == config.Raspbian {
+		return nil
+	}
+
+	e, found := config.GetEOL(family, eolRelease(family, release))
+	if !found {
+		return []string{fmt.Sprintf("Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: %s Release: %s'", family, release)}
+	}
+
+	if e.IsStandardSupportEnded(now) {
+		warnings := []string{"Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended."}
+		if !e.ExtendedSupportUntil.IsZero() {
+			if e.IsExtendedSuppportEnded(now) {
+				warnings = append(warnings, "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended.")
+			} else {
+				warnings = append(warnings, fmt.Sprintf("Extended support available until %s. Check the vendor site.", e.ExtendedSupportUntil.Format("2006-01-02")))
+			}
+		}
+		return warnings
+	}
+
+	if !now.AddDate(0, 3, 0).Before(e.StandardSupportUntil) {
+		return []string{fmt.Sprintf("Standard OS support will be end in 3 months. EOL date: %s", e.StandardSupportUntil.Format("2006-01-02"))}
+	}
+	return nil
+}
diff --git a/scan/eol_test.go b/scan/eol_test.go
new file mode 100644
index 0000000..d38dbb0
--- /dev/null
+++ b/scan/eol_test.go
@@ -0,0 +1,63 @@
+package scan
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func eolTestDate(t *testing.T, date string) time.Time {
+	t.Helper()
+	now, err := time.Parse("2006-01-02", date)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return now
+}
+
+func TestEOLWarnings(t *testing.T) {
+	const standardEnded = "Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended."
+	const extendedEnded = "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended."
+	tests := []struct {
+		name, family, release, now string
+		want                       []string
+	}{
+		{"before three months", config.FreeBSD, "11.4-RELEASE-p1", "2021-06-29", nil},
+		{"three month boundary", config.FreeBSD, "11.4-RELEASE-p1", "2021-06-30", []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"}},
+		{"standard end boundary", config.FreeBSD, "11.4-RELEASE-p1", "2021-09-30", []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"}},
+		{"extended available", config.Ubuntu, "14.04", "2019-05-01", []string{standardEnded, "Extended support available until 2024-04-30. Check the vendor site."}},
+		{"extended end boundary", config.Ubuntu, "14.04", "2024-04-30", []string{standardEnded, "Extended support available until 2024-04-30. Check the vendor site."}},
+		{"both ended", config.Ubuntu, "14.10", "2015-07-31", []string{standardEnded, extendedEnded}},
+		{"no extended support", config.Amazon, "2 (Karoo)", "2025-07-01", []string{standardEnded}},
+		{"unknown release", config.RedHat, "9.1", "2025-07-01", []string{"Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: redhat Release: 9.1'"}},
+		{"pseudo", config.ServerTypePseudo, "", "2025-07-01", nil},
+		{"raspbian", config.Raspbian, "10", "2025-07-01", nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := eolWarnings(tt.family, tt.release, eolTestDate(t, tt.now))
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("warnings = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestEOLReleaseNormalization(t *testing.T) {
+	tests := []struct{ family, release, want string }{
+		{config.Amazon, "2018.03", "2018.03"},
+		{config.Amazon, "2 (Karoo)", "2 (Karoo)"},
+		{config.RedHat, "7.9", "7"},
+		{config.Debian, "10.11", "10"},
+		{config.Alpine, "3.10.4", "3.10"},
+		{config.Ubuntu, "18.04.5", "18.04"},
+		{config.FreeBSD, "11.4-RELEASE-p1", "11"},
+	}
+	for _, tt := range tests {
+		if got := eolRelease(tt.family, tt.release); got != tt.want {
+			t.Errorf("%s %s normalized to %s, want %s", tt.family, tt.release, got, tt.want)
+		}
+	}
+}
