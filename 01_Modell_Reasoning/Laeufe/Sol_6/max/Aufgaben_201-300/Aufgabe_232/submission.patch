@@ -0,0 +1,86 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestGetEOLDates(t *testing.T) {
+	tests := []struct {
+		family, release, standard, extended string
+	}{
+		{Amazon, "2018.03", "2023-06-30", "2023-06-30"},
+		{Amazon, "2 (Karoo)", "2025-06-30", ""},
+		{RedHat, "7", "2024-06-30", ""},
+		{RedHat, "8", "2029-05-31", ""},
+		{RedHat, "6", "2020-11-30", "2024-06-30"},
+		{CentOS, "7", "2024-06-30", ""},
+		{CentOS, "8", "2021-12-31", ""},
+		{CentOS, "6", "2020-11-30", "2020-11-30"},
+		{Oracle, "7", "2024-06-30", ""},
+		{Oracle, "8", "2029-05-31", ""},
+		{Oracle, "6", "2021-03-31", "2022-03-31"},
+		{Ubuntu, "18.04", "2023-05-31", "2028-04-30"},
+		{Ubuntu, "14.04", "2019-04-30", "2024-04-30"},
+		{Ubuntu, "14.10", "2015-07-30", "2015-07-30"},
+		{Ubuntu, "21.04", "2022-01-30", ""},
+		{Debian, "9", "2022-06-30", ""},
+		{Debian, "10", "2024-06-30", ""},
+		{Debian, "8", "2020-06-30", "2020-06-30"},
+		{Alpine, "3.10", "2021-05-30", ""},
+		{Alpine, "3.11", "2021-11-30", ""},
+		{Alpine, "3.12", "2022-05-30", ""},
+		{Alpine, "3.9", "2020-11-30", "2020-11-30"},
+		{FreeBSD, "11", "2021-09-30", "2021-09-30"},
+		{FreeBSD, "12", "2023-12-31", ""},
+		{FreeBSD, "10", "2019-10-30", "2019-10-30"},
+	}
+	for _, tt := range tests {
+		e, found := GetEOL(tt.family, tt.release)
+		if !found {
+			t.Errorf("%s %s was not found", tt.family, tt.release)
+			continue
+		}
+		if got := e.StandardSupportUntil.Format("2006-01-02"); got != tt.standard {
+			t.Errorf("%s %s standard end = %s, want %s", tt.family, tt.release, got, tt.standard)
+		}
+		if tt.extended == "" {
+			if !e.ExtendedSupportUntil.IsZero() {
+				t.Errorf("%s %s has unexpected extended support", tt.family, tt.release)
+			}
+		} else if got := e.ExtendedSupportUntil.Format("2006-01-02"); got != tt.extended {
+			t.Errorf("%s %s extended end = %s, want %s", tt.family, tt.release, got, tt.extended)
+		}
+	}
+
+	for _, tt := range []struct{ family, release string }{
+		{RedHat, "9"}, {CentOS, "9"}, {Oracle, "9"},
+		{Ubuntu, "12.10"}, {Debian, "11"}, {Alpine, "3.13"},
+		{RedHat, "7.9"}, {Amazon, "2 (2017.12)"}, {"unknown", "7"},
+	} {
+		if _, found := GetEOL(tt.family, tt.release); found {
+			t.Errorf("unexpected EOL data for %s %s", tt.family, tt.release)
+		}
+	}
+}
+
+func TestEOLSupportEndBoundaries(t *testing.T) {
+	e, _ := GetEOL(Ubuntu, "14.04")
+	if e.IsStandardSupportEnded(e.StandardSupportUntil) {
+		t.Fatal("standard support must not end at its exact end time")
+	}
+	if !e.IsStandardSupportEnded(e.StandardSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("standard support must end after its end time")
+	}
+	if e.IsExtendedSuppportEnded(e.ExtendedSupportUntil) {
+		t.Fatal("extended support must not end at its exact end time")
+	}
+	if !e.IsExtendedSuppportEnded(e.ExtendedSupportUntil.Add(time.Nanosecond)) {
+		t.Fatal("extended support must end after its end time")
+	}
+
+	withoutExtended, _ := GetEOL(RedHat, "7")
+	if withoutExtended.IsExtendedSuppportEnded(time.Now().AddDate(100, 0, 0)) {
+		t.Fatal("extended support is not applicable when its date is absent")
+	}
+}
