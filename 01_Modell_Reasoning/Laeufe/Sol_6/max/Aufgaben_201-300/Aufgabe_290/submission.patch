+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const ERROR_EVENTS = new Set(["error", "stalled"]);
+const DEBUG_EVENTS = new Set([
+    "abort", "canplay", "canplaythrough", "durationchange", "emptied", "ended", "loadeddata",
+    "loadedmetadata", "loadstart", "pause", "play", "playing", "progress", "ratechange",
+    "seeked", "seeking", "suspend", "timeupdate", "volumechange", "waiting",
+]);
+
+/** Log relevant HTMLMediaElement events when attached as a DOM event listener. */
+export function handleEvent(e: Event): void {
+    if (!ERROR_EVENTS.has(e.type) && !DEBUG_EVENTS.has(e.type)) return;
+
+    const element = (e.currentTarget || e.target) as HTMLMediaElement | null;
+    const details = { id: element?.id, event: e.type };
+
+    if (ERROR_EVENTS.has(e.type)) {
+        logger.error("LegacyCallHandler media element error", { ...details, error: element?.error });
+    } else if (SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("LegacyCallHandler media element event", details);
+    }
+}
