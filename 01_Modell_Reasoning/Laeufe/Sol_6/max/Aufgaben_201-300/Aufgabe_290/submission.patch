+import { logger } from "matrix-js-sdk/src/logger";
+
+import { handleEvent } from "../../../src/legacy/LegacyCallHandler/handleEvent";
+import SettingsStore from "../../../src/settings/SettingsStore";
+
+describe('legacy call media events', () => {
+    let audioElement: HTMLAudioElement;
+
+    beforeEach(() => {
+        audioElement = document.createElement('audio');
+        audioElement.id = 'ringAudio';
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it.each(['error', 'stalled'])('logs %s with the element id', (type) => {
+        const error = jest.spyOn(logger, 'error').mockImplementation(() => {});
+        audioElement.addEventListener(type, handleEvent);
+
+        audioElement.dispatchEvent(new Event(type));
+
+        expect(error).toHaveBeenCalledWith(
+            'LegacyCallHandler media element error',
+            expect.objectContaining({ id: 'ringAudio', event: type }),
+        );
+    });
+
+    it('logs playback events when debug logging is enabled', () => {
+        jest.spyOn(SettingsStore, 'getValue').mockReturnValue(true);
+        const debug = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+        audioElement.addEventListener('playing', handleEvent);
+
+        audioElement.dispatchEvent(new Event('playing'));
+
+        expect(debug).toHaveBeenCalledWith(
+            'LegacyCallHandler media element event',
+            { id: 'ringAudio', event: 'playing' },
+        );
+    });
+
+    it('does not log playback events when debug logging is disabled', () => {
+        jest.spyOn(SettingsStore, 'getValue').mockReturnValue(false);
+        const debug = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+        audioElement.addEventListener('playing', handleEvent);
+
+        audioElement.dispatchEvent(new Event('playing'));
+
+        expect(debug).not.toHaveBeenCalled();
+    });
+
+    it('ignores other events', () => {
+        const error = jest.spyOn(logger, 'error').mockImplementation(() => {});
+        const debug = jest.spyOn(logger, 'debug').mockImplementation(() => {});
+        const getValue = jest.spyOn(SettingsStore, 'getValue');
+
+        handleEvent(new Event('click'));
+
+        expect(error).not.toHaveBeenCalled();
+        expect(debug).not.toHaveBeenCalled();
+        expect(getValue).not.toHaveBeenCalled();
+    });
+});
