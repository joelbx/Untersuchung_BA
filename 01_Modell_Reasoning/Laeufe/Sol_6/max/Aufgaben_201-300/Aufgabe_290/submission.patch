+describe('LegacyCallHandler call sounds', () => {
+    let callHandler: LegacyCallHandler;
+    let audioElement: HTMLAudioElement;
+
+    beforeEach(() => {
+        callHandler = new LegacyCallHandler();
+        audioElement = document.createElement('audio');
+        document.body.appendChild(audioElement);
+    });
+
+    afterEach(() => {
+        audioElement.remove();
+        jest.restoreAllMocks();
+    });
+
+    it.each(Object.values(AudioID))('unmutes %s before playing it', (audioId) => {
+        audioElement.id = audioId;
+        audioElement.muted = true;
+        const play = jest.spyOn(audioElement, 'play').mockImplementation(() => {
+            expect(audioElement.muted).toBe(false);
+            return Promise.resolve();
+        });
+
+        callHandler.play(audioId);
+
+        expect(play).toHaveBeenCalledTimes(1);
+    });
+
+    it('does not change an already unmuted element', () => {
+        audioElement.id = AudioID.Ring;
+        const setMuted = jest.fn();
+        Object.defineProperty(audioElement, 'muted', { configurable: true, get: () => false, set: setMuted });
+        const play = jest.spyOn(audioElement, 'play').mockResolvedValue();
+
+        callHandler.play(AudioID.Ring);
+
+        expect(setMuted).not.toHaveBeenCalled();
+        expect(play).toHaveBeenCalledTimes(1);
+    });
+
+    it('unmutes a queued replay after the element reloads', async () => {
+        audioElement.id = AudioID.Ringback;
+        const load = jest.spyOn(audioElement, 'load').mockImplementation(() => {
+            audioElement.muted = true;
+        });
+        const play = jest.spyOn(audioElement, 'play').mockImplementation(() => {
+            expect(audioElement.muted).toBe(false);
+            return Promise.resolve();
+        });
+
+        callHandler.play(AudioID.Ringback);
+        callHandler.play(AudioID.Ringback);
+        await new Promise(resolve => setTimeout(resolve, 0));
+
+        expect(load).toHaveBeenCalledTimes(1);
+        expect(play).toHaveBeenCalledTimes(2);
+    });
+});
