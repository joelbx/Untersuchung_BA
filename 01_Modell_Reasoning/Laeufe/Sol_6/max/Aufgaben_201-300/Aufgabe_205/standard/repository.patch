+// Internal token management utilities only.
+utils.tokens = {};
+const { tokens } = utils;
 
-utils.log = async (token) => {
-	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
+function validateTokens(value) {
+	if (!Array.isArray(value) || value.some(token => typeof token !== 'string' || !token)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+}
+
+tokens.list = async () => {
+	const ids = await db.getSortedSetRange('tokens:createtime', 0, -1);
+	return await tokens.get(ids);
+};
+
+tokens.get = async (value) => {
+	const single = !Array.isArray(value);
+	const ids = single ? [value] : value;
+	validateTokens(ids);
+	if (!ids.length) {
+		return [];
+	}
+
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(ids.map(token => `token:${token}`)),
+		tokens.getLastSeen(ids),
+	]);
+	const result = objects.map((object, index) => {
+		if (!object) {
+			return null;
+		}
+		const uid = Number(object.uid);
+		const timestamp = Number(object.timestamp);
+		if (object.uid == null || object.timestamp == null || !Number.isFinite(uid) || !Number.isFinite(timestamp)) {
+			throw new Error('[[error:invalid-data]]');
+		}
+		return {
+			token: ids[index],
+			uid: uid,
+			description: object.description || '',
+			timestamp: timestamp,
+			lastSeen: lastSeen[index],
+		};
+	});
+	return single ? result[0] : result;
+};
+
+tokens.generate = async (data) => {
+	if (!data || typeof data !== 'object') {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const { uid, description = '' } = data;
+	const numericUid = Number(uid);
+	if (!['string', 'number'].includes(typeof uid) || uid === '' ||
+		!Number.isSafeInteger(numericUid) || numericUid < 0 || typeof description !== 'string') {
+		throw new Error('[[error:invalid-data]]');
+	}
+	if (numericUid !== 0 && !await user.exists(numericUid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = generateUUID();
+	const timestamp = Date.now();
+	if (!Number.isFinite(timestamp)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.setObject(`token:${token}`, { uid: numericUid, description: description || '', timestamp });
+	await db.sortedSetsAdd(['tokens:createtime', 'tokens:uid'], [timestamp, numericUid], token);
+	return token;
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+tokens.update = async (token, data) => {
+	if (!data || typeof data.description !== 'string' || !await tokens.get(token)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.setObjectField(`token:${token}`, 'description', data.description);
+	return await tokens.get(token);
+};
+
+tokens.delete = async (token) => {
+	validateTokens([token]);
+	await Promise.all([
+		db.delete(`token:${token}`),
+		db.sortedSetsRemove(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'], token),
+	]);
+};
+
+tokens.log = async (token) => {
+	validateTokens([token]);
+	const timestamp = Date.now();
+	if (!Number.isFinite(timestamp)) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	await db.sortedSetAdd('tokens:lastSeen', timestamp, token);
+};
+
+tokens.getLastSeen = async (ids) => {
+	validateTokens(ids);
+	if (!ids.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', ids);
+	return scores.map(score => (score !== null && Number.isFinite(Number(score)) ? Number(score) : null));
+};
