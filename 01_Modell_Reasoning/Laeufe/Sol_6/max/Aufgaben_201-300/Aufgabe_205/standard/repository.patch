diff --git a/test/api-token-utils.js b/test/api-token-utils.js
new file mode 100644
index 0000000..1c6063b
--- /dev/null
+++ b/test/api-token-utils.js
@@ -0,0 +1,95 @@
+'use strict';
+
+const assert = require('assert');
+
+const db = require('./mocks/databasemock');
+const user = require('../src/user');
+const { tokens } = require('../src/api/utils');
+const helpers = require('./helpers');
+
+describe('internal API token utilities', () => {
+	let uid;
+	const created = [];
+
+	before(async () => {
+		uid = await user.create({ username: 'apiTokenUtilsUser' });
+	});
+
+	afterEach(async () => {
+		await Promise.all(created.splice(0).map(token => tokens.delete(token)));
+	});
+
+	it('persists, hydrates, orders, updates, and removes token metadata', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get(undefined), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.generate({ uid: 99999999 }), /\[\[error:no-user\]\]/);
+
+		const before = Date.now();
+		const first = await tokens.generate({ uid: String(uid), description: 'first' });
+		created.push(first);
+		await new Promise((resolve) => { setTimeout(resolve, 5); });
+		const second = await tokens.generate({ uid: 0 });
+		created.push(second);
+		const after = Date.now();
+
+		const firstData = await db.getObject(`token:${first}`);
+		const secondData = await db.getObject(`token:${second}`);
+		assert.strictEqual(Number(firstData.uid), uid);
+		assert.strictEqual(firstData.description, 'first');
+		assert.strictEqual(Number(secondData.uid), 0);
+		assert.strictEqual(secondData.description, '');
+		await Promise.all([[first, firstData], [second, secondData]].map(async ([token, data]) => {
+			const timestamp = Number(data.timestamp);
+			assert(Number.isFinite(timestamp) && timestamp >= before && timestamp <= after);
+			assert.strictEqual(await db.sortedSetScore('tokens:createtime', token), timestamp);
+			assert.strictEqual(await db.sortedSetScore('tokens:uid', token), Number(data.uid));
+		}));
+
+		assert.deepStrictEqual((await tokens.list()).map(item => item.token), [first, second]);
+		assert.deepStrictEqual((await tokens.get([second, first])).map(item => item.token), [second, first]);
+		assert.strictEqual((await tokens.get(first)).lastSeen, null);
+		assert.deepStrictEqual(await tokens.getLastSeen([second, first]), [null, null]);
+
+		await tokens.log(first);
+		const seen = await tokens.getLastSeen([second, first]);
+		assert.strictEqual(seen[0], null);
+		assert(Number.isFinite(seen[1]) && seen[1] >= before);
+		const updated = await tokens.update(first, { description: 'updated' });
+		assert.strictEqual(updated.description, 'updated');
+		assert.strictEqual(updated.uid, uid);
+		assert.strictEqual(updated.timestamp, Number(firstData.timestamp));
+		assert.strictEqual(updated.lastSeen, seen[1]);
+		const stored = await db.getObject(`token:${first}`);
+		assert.strictEqual(stored.uid, firstData.uid);
+		assert.strictEqual(stored.timestamp, firstData.timestamp);
+
+		await tokens.delete(first);
+		await tokens.delete(second);
+		await Promise.all([first, second].map(async (token) => {
+			assert.strictEqual(await db.getObject(`token:${token}`), null);
+			await Promise.all(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'].map(async (index) => {
+				assert.strictEqual(await db.sortedSetScore(index, token), null);
+			}));
+		}));
+		assert.deepStrictEqual(await tokens.list(), []);
+	});
+
+	it('authenticates generated tokens and rejects them after deletion', async () => {
+		const token = await tokens.generate({ uid, description: 'for bearer auth' });
+		created.push(token);
+		const requestOptions = { json: true, headers: { Authorization: `Bearer ${token}` } };
+		const authorized = await helpers.request('get', '/api/self', requestOptions);
+		assert.strictEqual(authorized.res.statusCode, 200);
+		assert.strictEqual(authorized.body.username, 'apiTokenUtilsUser');
+		const ping = await helpers.request('get', '/api/v3/ping', requestOptions);
+		assert.strictEqual(ping.res.statusCode, 200);
+		assert(Number.isFinite((await tokens.get(token)).lastSeen));
+
+		await tokens.delete(token);
+		const rejected = await helpers.request('get', '/api/self', requestOptions);
+		assert.strictEqual(rejected.res.statusCode, 401);
+	});
+});
