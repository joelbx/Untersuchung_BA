+/** Parse ISO dates first so date-only values use local calendar time, like vCard dates. */
+export const guessDateFromText = (text: string): Date | undefined => {
+    const value = text.trim();
+    const isoDate = parseISO(value);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+
+    // Native Date parsing normalizes impossible ISO dates (e.g. February 30).
+    if (/^\d{4}-\d{2}-\d{2}(?:T|$)/.test(value)) {
+        return undefined;
+    }
+
+    const date = new Date(value);
+    if (!isValid(date)) {
+        return undefined;
+    }
+
+    // Check the calendar components of slash dates before accepting native parsing.
+    const yearFirst = /^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(value);
+    const monthFirst = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(value);
+    if (yearFirst || monthFirst) {
+        const year = Number(yearFirst?.[1] || monthFirst?.[3]);
+        const month = Number(yearFirst?.[2] || monthFirst?.[1]);
+        const day = Number(yearFirst?.[3] || monthFirst?.[2]);
+        if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) {
+            return undefined;
+        }
+    }
+
+    const namedDate = /^[A-Za-z]+\s+(\d{1,2}),?\s+(\d{4})$/.exec(value);
+    if (namedDate && (date.getDate() !== Number(namedDate[1]) || date.getFullYear() !== Number(namedDate[2]))) {
+        return undefined;
+    }
+
+    return date;
+};
