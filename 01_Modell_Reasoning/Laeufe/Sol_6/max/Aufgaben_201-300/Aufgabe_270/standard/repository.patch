+import { renderHook } from '@testing-library/react-hooks';
+
+import { useAuthentication } from '@proton/components';
+
+import { usePublicSession } from '../_api';
+import { usePublicSessionUser } from './usePublicSessionUser';
+
+jest.mock('@proton/components', () => ({ useAuthentication: jest.fn() }));
+jest.mock('../_api', () => ({ usePublicSession: jest.fn() }));
+
+it('returns the resumed user and current authentication localID', () => {
+    const user = { ID: 'user-1' };
+    const getLocalID = jest.fn().mockReturnValue(undefined);
+    jest.mocked(usePublicSession).mockReturnValue({ user } as any);
+    jest.mocked(useAuthentication).mockReturnValue({ getLocalID } as any);
+
+    const { result, rerender } = renderHook(() => usePublicSessionUser());
+    expect(result.current).toEqual({ user, localID: undefined });
+
+    getLocalID.mockReturnValue(42);
+    rerender();
+    expect(result.current).toEqual({ user, localID: 42 });
+});
