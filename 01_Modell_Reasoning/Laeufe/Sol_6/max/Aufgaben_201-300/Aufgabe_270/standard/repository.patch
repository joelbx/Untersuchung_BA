+import usePublicSession, { PublicSessionProvider } from './usePublicSession';
+
+jest.mock('@proton/components', () => ({ useApi: jest.fn(), useAuthentication: jest.fn() }));
+jest.mock('@proton/metrics', () => ({ __esModule: true, default: { setAuthHeaders: jest.fn() } }));
+jest.mock('@proton/shared/lib/authentication/persistedSessionHelper', () => ({ resumeSession: jest.fn() }));
+jest.mock('@proton/shared/lib/srp', () => ({ srpAuth: jest.fn() }));
+jest.mock('@proton/shared/lib/user/helpers', () => ({ formatUser: jest.fn() }));
+jest.mock('../../utils/lastActivePersistedUserSession', () => ({ getLastActivePersistedUserSession: jest.fn() }));
+jest.mock('../_shares', () => ({
+    isLegacySharedUrl: jest.fn(() => false),
+    hasCustomPassword: jest.fn(() => false),
+    hasGeneratedPasswordIncluded: jest.fn(() => false),
+}));
+jest.mock('./useDebouncedRequest', () => ({ __esModule: true, default: () => jest.fn() }));
+
+const persistedSession = { UID: 'persisted-uid', localID: 42 };
+const handshakeInfo = {
+    Flags: 0,
+    Modulus: 'modulus',
+    ServerEphemeral: 'ephemeral',
+    UrlPasswordSalt: 'salt',
+    SRPSession: 'srp-session',
+    Version: 4,
+};
+const auth = {
+    setPassword: jest.fn(),
+    setUID: jest.fn(),
+    setLocalID: jest.fn(),
+};
+
+beforeEach(() => {
+    jest.clearAllMocks();
+    jest.mocked(useApi).mockReturnValue(jest.fn().mockResolvedValue(handshakeInfo) as any);
+    jest.mocked(useAuthentication).mockReturnValue(auth as any);
+    jest.mocked(getLastActivePersistedUserSession).mockReturnValue(persistedSession as any);
+});
+
+describe('PublicSessionProvider', () => {
+    it('resumes the selected session and exposes its user and localID', async () => {
+        const resumedUser = { ID: 'user-42' };
+        const formattedUser = { ID: 'user-42', Name: 'Example' };
+        jest.mocked(resumeSession).mockResolvedValue({
+            UID: 'resumed-uid',
+            LocalID: 42,
+            keyPassword: 'key-password',
+            User: resumedUser,
+        } as any);
+        jest.mocked(formatUser).mockReturnValue(formattedUser as any);
+        const { result } = renderHook(() => usePublicSession(), { wrapper: PublicSessionProvider });
+
+        await act(async () => {
+            await result.current.initHandshake('token');
+        });
+
+        expect(metrics.setAuthHeaders).toHaveBeenCalledWith('persisted-uid');
+        expect(resumeSession).toHaveBeenCalledWith({ api: expect.any(Function), localID: 42 });
+        expect(auth.setPassword).toHaveBeenCalledWith('key-password');
+        expect(auth.setUID).toHaveBeenCalledWith('resumed-uid');
+        expect(auth.setLocalID).toHaveBeenCalledWith(42);
+        expect(result.current.user).toBe(formattedUser);
+    });
+
+    it('sends the persisted UID in the SRP request', async () => {
+        jest.mocked(resumeSession).mockResolvedValue({ UID: 'persisted-uid', LocalID: 42, User: {} } as any);
+        jest.mocked(srpAuth).mockResolvedValue({
+            json: async () => ({ AccessToken: 'access-token', UID: 'public-uid' }),
+        } as any);
+        const { result } = renderHook(() => usePublicSession(), { wrapper: PublicSessionProvider });
+
+        await act(async () => {
+            await result.current.initSession('token', 'password', handshakeInfo as any);
+        });
+
+        expect(srpAuth).toHaveBeenCalledWith(
+            expect.objectContaining({ config: expect.objectContaining({ headers: getUIDHeaders('persisted-uid') }) })
+        );
+    });
+});
