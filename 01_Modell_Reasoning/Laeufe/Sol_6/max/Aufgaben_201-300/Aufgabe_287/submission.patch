+package scanner
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/db"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/persistence"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("album image files", func() {
+	It("joins every image beside an album's media files in directory order", func() {
+		mfs := model.MediaFiles{
+			{Path: filepath.Join("music", "disc 2", "track.mp3")},
+			{Path: filepath.Join("music", "disc 1", "one.mp3")},
+			{Path: filepath.Join("music", "disc 1", "two.mp3")},
+		}
+		dirs := dirMap{
+			filepath.Join("music", "disc 1"): {ImageFiles: []string{"back.png", "front.jpg"}},
+			filepath.Join("music", "disc 2"): {ImageFiles: []string{"hires.png"}},
+			filepath.Join("music", "unused"): {ImageFiles: []string{"unused.jpg"}},
+		}
+		Expect(imageFilesForAlbum(mfs, dirs)).To(Equal(strings.Join([]string{
+			filepath.Join("music", "disc 1", "back.png"),
+			filepath.Join("music", "disc 1", "front.jpg"),
+			filepath.Join("music", "disc 2", "hires.png"),
+		}, string(filepath.ListSeparator))))
+	})
+
+	It("persists the complete image list and removes deleted images on refresh", func() {
+		ctx := context.Background()
+		ds := persistence.New(db.Db())
+		root := GinkgoT().TempDir()
+		disc1 := filepath.Join(root, "disc 1")
+		disc2 := filepath.Join(root, "disc 2")
+		Expect(os.MkdirAll(disc1, 0755)).To(Succeed())
+		Expect(os.MkdirAll(disc2, 0755)).To(Succeed())
+		albumID := "scanner-image-files-test"
+		future := time.Now().Add(time.Hour)
+		first := model.MediaFile{ID: "scanner-image-files-1", AlbumID: albumID, Album: "Images", Path: filepath.Join(disc1, "one.mp3"), UpdatedAt: future}
+		second := model.MediaFile{ID: "scanner-image-files-2", AlbumID: albumID, Album: "Images", Path: filepath.Join(disc2, "two.mp3"), UpdatedAt: future}
+		Expect(os.WriteFile(first.Path, nil, 0600)).To(Succeed())
+		Expect(ds.MediaFile(ctx).Put(&first)).To(Succeed())
+		Expect(ds.MediaFile(ctx).Put(&second)).To(Succeed())
+		DeferCleanup(func() {
+			_, _ = db.Db().Exec("delete from media_file where id in (?, ?)", first.ID, second.ID)
+			_, _ = db.Db().Exec("delete from album where id = ?", albumID)
+		})
+
+		dirs := dirMap{
+			disc1: {ImageFiles: []string{"front.jpg", "back.png"}},
+			disc2: {ImageFiles: []string{"hires.png"}},
+		}
+		ref := newRefresher(ctx, ds, dirs)
+		Expect(ref.refreshAlbums(albumID)).To(Succeed())
+		album, err := ds.Album(ctx).Get(albumID)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(album.ImageFiles).To(Equal(strings.Join([]string{
+			filepath.Join(disc1, "front.jpg"),
+			filepath.Join(disc1, "back.png"),
+			filepath.Join(disc2, "hires.png"),
+		}, string(filepath.ListSeparator))))
+
+		s := &TagScanner{ds: ds, cacheWarmer: noopCacheWarmer{}, cnt: &counters{}}
+		dirs[disc1] = dirStats{ImageFiles: []string{"front.jpg"}}
+		Expect(s.processChangedDir(ctx, disc1, false, dirs)).To(Succeed())
+		album, err = ds.Album(ctx).Get(albumID)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(album.ImageFiles).To(Equal(strings.Join([]string{
+			filepath.Join(disc1, "front.jpg"),
+			filepath.Join(disc2, "hires.png"),
+		}, string(filepath.ListSeparator))))
+
+		delete(dirs, disc2)
+		Expect(s.processDeletedDir(ctx, disc2, dirs)).To(Succeed())
+		album, err = ds.Album(ctx).Get(albumID)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(album.ImageFiles).To(Equal(filepath.Join(disc1, "front.jpg")))
+	})
+})
+
+type noopCacheWarmer struct{}
+
+func (noopCacheWarmer) AddAlbum(context.Context, string) {}
+func (noopCacheWarmer) Flush(context.Context)            {}
