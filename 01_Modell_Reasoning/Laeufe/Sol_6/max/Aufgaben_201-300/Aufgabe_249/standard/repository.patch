diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index cbf68a2..813d105 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -25,6 +25,131 @@ def createWikidataEntity(
     )
 
 
+@pytest.mark.parametrize(
+    'sitelinks, language, expected',
+    [
+        (
+            {
+                'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'},
+                'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+            },
+            'fr',
+            ('https://fr.wikipedia.org/wiki/Douglas_Adams', 'fr'),
+        ),
+        (
+            {'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'}},
+            'fr',
+            ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en'),
+        ),
+        (
+            {
+                'frwiki': {},
+                'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+            },
+            'fr',
+            ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en'),
+        ),
+        (
+            {
+                'frwiki': {'url': 123},
+                'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+            },
+            'fr',
+            ('https://en.wikipedia.org/wiki/Douglas_Adams', 'en'),
+        ),
+        ({'frwiki': {'title': 'Douglas Adams'}}, 'fr', None),
+    ],
+)
+def test_get_wikipedia_link(sitelinks, language, expected):
+    entity = createWikidataEntity()
+    entity.sitelinks = sitelinks
+    assert entity._get_wikipedia_link(language) == expected
+
+
+@pytest.mark.parametrize(
+    'statements, expected',
+    [
+        ({}, []),
+        ({'P1960': [{'value': {'content': 'first'}}]}, ['first']),
+        ({'P1960': {'value': {'content': 'first'}}}, ['first']),
+        (
+            {
+                'P1960': [
+                    {'value': {'content': 'first'}},
+                    {},
+                    {'value': {}},
+                    {'value': None},
+                    None,
+                    {'value': {'content': None}},
+                    {'value': {'content': 'second'}},
+                ]
+            },
+            ['first', 'second'],
+        ),
+        ({'P1960': 'malformed'}, []),
+    ],
+)
+def test_get_statement_values(statements, expected):
+    entity = createWikidataEntity()
+    entity.statements = statements
+    assert entity._get_statement_values('P1960') == expected
+
+
+def test_get_external_profiles():
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'},
+        'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+    }
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'scholar-one'}},
+            {'value': {}},
+            {'value': {'content': 'scholar-two'}},
+        ]
+    }
+
+    assert entity.get_external_profiles('fr') == [
+        {
+            'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams',
+            'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+            'label': 'Wikipedia',
+        },
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=scholar-one',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+        {
+            'url': 'https://scholar.google.com/citations?user=scholar-two',
+            'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+            'label': 'Google Scholar',
+        },
+    ]
+
+
+def test_get_external_profiles_fallback_and_no_wikipedia():
+    entity = createWikidataEntity()
+    entity.sitelinks = {'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'}}
+
+    profiles = entity.get_external_profiles('fr')
+    assert profiles[0]['url'] == 'https://en.wikipedia.org/wiki/Douglas_Adams'
+
+    entity.sitelinks = {}
+    assert entity.get_external_profiles() == [
+        {
+            'url': 'https://www.wikidata.org/wiki/Q42',
+            'icon_url': '/static/images/identifier_icons/wikidata.svg',
+            'label': 'Wikidata',
+        }
+    ]
+
+
 EXPIRED = "expired"
 MISSING = "missing"
 VALID_CACHE = ""
