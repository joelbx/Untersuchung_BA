+        assert custom._context is context
+
+    if unix_socket:
+        auth = next(handler for handler in opener.handlers if isinstance(handler, HTTPSClientAuthHandler))
+        assert auth._context is context
+        assert auth._build_https_connection('ansible.com')._context is context
+
