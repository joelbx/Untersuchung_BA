@@ -7,6 +7,7 @@ __metaclass__ = type
 
 import pytest
 
+from ansible.errors import AnsibleError
 from ansible.plugins.loader import lookup_loader
 
 
@@ -24,3 +25,23 @@ def test_user_agent(mocker, kwargs, agent):
         url_lookup.run(['https://nourl'], **kwargs)
     assert 'http_agent' in mock_open_url.call_args.kwargs
     assert mock_open_url.call_args.kwargs['http_agent'] == agent
+
+
+@pytest.mark.parametrize('ciphers', [None, 'ECDHE-RSA-AES128-SHA256', ['ECDHE-RSA-AES128-SHA256']])
+def test_lookup_passes_ciphers(mocker, ciphers):
+    mock_open_url = mocker.patch('ansible.plugins.lookup.url.open_url', side_effect=AttributeError('raised intentionally'))
+    url_lookup = lookup_loader.get('url')
+    kwargs = {} if ciphers is None else {'ciphers': ciphers}
+    with pytest.raises(AttributeError):
+        url_lookup.run(['https://nourl'], **kwargs)
+    assert mock_open_url.call_args.kwargs['ciphers'] == ciphers
+
+
+def test_lookup_invalid_ciphers_are_user_facing(mocker):
+    mocker.patch('ansible.module_utils.urls.get_ca_certs', return_value=(None, bytearray(), []))
+    urlopen_mock = mocker.patch('ansible.module_utils.urls.urllib_request.urlopen')
+    url_lookup = lookup_loader.get('url')
+    with pytest.raises(AnsibleError, match='Unsupported TLS cipher configuration') as excinfo:
+        url_lookup.run(['https://nourl'], ciphers='PRIVATE-INVALID-CIPHER')
+    assert 'PRIVATE-INVALID-CIPHER' not in str(excinfo.value)
+    urlopen_mock.assert_not_called()
