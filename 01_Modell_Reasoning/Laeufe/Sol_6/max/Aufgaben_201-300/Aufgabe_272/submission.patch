+
+    if url.startswith('http:'):
+        redirect = next(handler for handler in opener.handlers if handler.__class__.__name__ == 'RedirectHandler')
+        redirected = redirect.redirect_request(urllib_request.Request(url), None, 302, 'Found', {}, 'https://ansible.com/')
