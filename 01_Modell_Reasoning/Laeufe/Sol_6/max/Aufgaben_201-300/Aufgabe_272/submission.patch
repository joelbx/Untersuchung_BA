+def test_Request_ciphers_reach_https_handlers(urlopen_mock, install_opener_mock, mocker, url, unix_socket, use_proxy):
+    mocker.patch('ansible.module_utils.urls.get_ca_certs', return_value=(None, bytearray(), []))
