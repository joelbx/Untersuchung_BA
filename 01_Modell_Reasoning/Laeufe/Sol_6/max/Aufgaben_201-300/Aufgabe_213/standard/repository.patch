@@ -0,0 +1,73 @@
+import { RouteComponentProps } from 'react-router';
+import { MemoryRouter } from 'react-router-dom';
+
+import { render, waitFor } from '@testing-library/react';
+
+import { LinkURLType } from '@proton/shared/lib/drive/constants';
+
+import { DriveSectionRouteProps } from '../components/sections/Drive/DriveView';
+import FolderContainer from './FolderContainer';
+
+const mockIsShareAvailable = jest.fn();
+const mockNavigateToRoot = jest.fn();
+const mockSetFolder = jest.fn();
+
+Object.defineProperty(globalThis, 'reportError', { value: jest.fn(), configurable: true });
+
+jest.mock('@proton/components', () => ({ useAppTitle: jest.fn() }));
+jest.mock('../components/sections/Drive/DriveView', () => () => null);
+jest.mock('./PreviewContainer', () => () => null);
+jest.mock('../hooks/drive/useActiveShare', () => () => ({
+    activeFolder: { shareId: '', linkId: '' },
+    setFolder: mockSetFolder,
+}));
+jest.mock('../hooks/drive/useFolderContainerTitle', () => ({ useFolderContainerTitle: jest.fn() }));
+jest.mock('../hooks/drive/useNavigate', () => () => ({ navigateToRoot: mockNavigateToRoot }));
+jest.mock('../store', () => ({
+    useDefaultShare: () => ({ isShareAvailable: mockIsShareAvailable }),
+    useDriveEventManager: () => ({
+        shares: {
+            startSubscription: () => Promise.resolve(),
+            pauseSubscription: () => {},
+        },
+    }),
+}));
+
+const folder = { shareId: 'share-id', linkId: 'link-id' };
+
+const renderFolder = () => {
+    const props = {
+        match: { params: { ...folder, type: LinkURLType.FOLDER } },
+    } as unknown as RouteComponentProps<DriveSectionRouteProps>;
+
+    return render(
+        <MemoryRouter>
+            <FolderContainer {...props} />
+        </MemoryRouter>
+    );
+};
+
+describe('FolderContainer', () => {
+    beforeEach(() => {
+        jest.resetAllMocks();
+    });
+
+    it('loads a folder when its share is available', async () => {
+        mockIsShareAvailable.mockResolvedValue(true);
+
+        renderFolder();
+
+        await waitFor(() => expect(mockSetFolder).toHaveBeenCalledWith(folder));
+        expect(mockIsShareAvailable).toHaveBeenCalledWith(expect.anything(), folder.shareId);
+        expect(mockNavigateToRoot).not.toHaveBeenCalled();
+    });
+
+    it('returns to the root when the folder share is unavailable', async () => {
+        mockIsShareAvailable.mockResolvedValue(false);
+
+        renderFolder();
+
+        await waitFor(() => expect(mockNavigateToRoot).toHaveBeenCalledTimes(1));
+        expect(mockSetFolder).not.toHaveBeenCalled();
+    });
+});
