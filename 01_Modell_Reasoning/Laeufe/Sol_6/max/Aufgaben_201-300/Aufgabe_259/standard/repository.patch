+    @pytest.mark.asyncio
+    async def test_public_edition_wins_regardless_of_order(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w,
+                    key='/books/OL4M',
+                    ocaid='printdisabled_inlibrary',
+                    _ia_meta={'collection': ['printdisabled', 'inlibrary']},
+                ),
+                make_edition(
+                    w,
+                    key='/books/OL3M',
+                    ocaid='borrowable',
+                    _ia_meta={'collection': ['inlibrary', 'americana']},
+                ),
+                make_edition(
+                    w,
+                    key='/books/OL2M',
+                    ocaid='publicgoog',
+                    _ia_meta={'collection': ['americana']},
+                ),
+                make_edition(
+                    w,
+                    key='/books/OL5M',
+                    ocaid='printdisabled_only',
+                    _ia_meta={'collection': ['printdisabled', 'internetarchivebooks']},
+                ),
+                make_edition(
+                    w,
+                    key='/books/OL1M',
+                    ocaid='public',
+                    _ia_meta={'collection': ['europeanlibraries']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+        assert d['has_fulltext'] is True
+        assert d['public_scan_b'] is True
+        assert d['lending_edition_s'] == 'OL1M'
+        assert d['lending_identifier_s'] == 'public'
+        assert sss(d['printdisabled_s']) == ['OL4M', 'OL5M']
+        assert set(d['ia']) == {
+            'printdisabled_inlibrary', 'borrowable', 'publicgoog',
+            'printdisabled_only', 'public',
+        }
+        assert set(d['ia_collection_s'].split(';')) == {
+            'printdisabled', 'inlibrary', 'americana',
+            'internetarchivebooks', 'europeanlibraries',
+        }
+        assert d['ebook_count_i'] == 5
+
+    @pytest.mark.asyncio
+    async def test_lendinglibrary_edition_is_borrowable(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w,
+                    key='/books/OL3M',
+                    ocaid='printdisabled_ia',
+                    _ia_meta={'collection': ['printdisabled', 'inlibrary']},
+                ),
+                make_edition(
+                    w,
+                    key='/books/OL1M',
+                    ocaid='lendinglibrary_ia',
+                    _ia_meta={'collection': ['lendinglibrary']},
+                ),
+                make_edition(
+                    w,
+                    key='/books/OL2M',
+                    ocaid='inlibrary_ia',
+                    _ia_meta={'collection': ['inlibrary']},
+                ),
+            ]
+        )
+
+        d = await build_data(w)
+        assert d['has_fulltext'] is True
+        assert d['public_scan_b'] is False
+        assert d['lending_edition_s'] == 'OL1M'
+        assert d['lending_identifier_s'] == 'lendinglibrary_ia'
+        assert d['printdisabled_s'] == 'OL3M'
+        assert set(d['ia']) == {
+            'printdisabled_ia', 'lendinglibrary_ia', 'inlibrary_ia',
+        }
+
