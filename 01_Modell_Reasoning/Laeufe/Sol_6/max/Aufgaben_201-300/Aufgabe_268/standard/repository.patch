 def test_error(qtbot, proc, caplog, message_mock):
     """Test the process emitting an error."""
+    cmd = 'this_does_not_exist_either'
     with caplog.at_level(logging.ERROR, 'message'):
         with qtbot.wait_signal(proc.error, timeout=5000):
-            proc.start('this_does_not_exist_either', [])
+            proc.start(cmd, [])
 
     msg = message_mock.getmsg(usertypes.MessageLevel.error)
-    assert msg.text.startswith("Error while spawning testprocess:")
+    assert msg.text.startswith("Testprocess '{}' failed to start: ".format(cmd))
+    if not utils.is_windows:
+        assert msg.text.endswith(
+            "(Hint: Make sure '{}' exists and is executable)".format(cmd))
+
+
+@pytest.mark.parametrize('error, description', [
+    (QProcess.FailedToStart, 'failed to start'),
+    (QProcess.Crashed, 'crashed'),
+    (QProcess.Timedout, 'timed out'),
+    (QProcess.WriteError, 'had a write error'),
+    (QProcess.ReadError, 'had a read error'),
+    (QProcess.UnknownError, 'had an unknown error'),
+])
+def test_error_types(fake_proc, message_mock, error, description, caplog):
+    """Each QProcess error identifies the command and kind of failure."""
+    fake_proc.start('my_command', [])
+    fake_proc._proc.errorString.return_value = 'Some detail'
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_error(error)
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == "Testprocess 'my_command' {}: Some detail".format(
+        description)
+
+
+@pytest.mark.parametrize('detail', [
+    'No such file or directory',
+    'Permission denied',
+    'execvp: No such file or directory',
+    'Other error',
+])
+@pytest.mark.parametrize('windows', [False, True])
+def test_failed_to_start_hint(fake_proc, message_mock, monkeypatch, caplog,
+                              detail, windows):
+    """The actionable hint appears for missing or nonexecutable commands."""
+    monkeypatch.setattr(utils, 'is_windows', windows)
+    fake_proc.start('my_command', [])
+    fake_proc._proc.errorString.return_value = detail
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_error(QProcess.FailedToStart)
+
+    expected = "Testprocess 'my_command' failed to start: {}".format(detail)
+    if not windows and detail.endswith(('No such file or directory',
+                                        'Permission denied')):
+        expected += (" (Hint: Make sure 'my_command' exists and is "
+                     "executable)")
+    assert message_mock.getmsg(usertypes.MessageLevel.error).text == expected
 
 
