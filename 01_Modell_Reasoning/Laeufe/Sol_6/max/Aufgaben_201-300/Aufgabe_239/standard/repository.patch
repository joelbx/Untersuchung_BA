diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..115be11
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,97 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkRoutesUseAuthenticatedUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	ctxA := request.WithUser(context.Background(), model.User{ID: "user-a"})
+	ctxB := request.WithUser(context.Background(), model.User{ID: "user-b"})
+	if err := ds.UserProps(ctxB).Put("user-b", sessionKeyProperty, "SK-B"); err != nil {
+		t.Fatal(err)
+	}
+	router := &Router{sessionKeys: &sessionKeys{ds: ds}, secret: "test-secret"}
+
+	status := func(ctx context.Context) struct {
+		Status bool   `json:"status"`
+		State  string `json:"state"`
+	} {
+		req := httptest.NewRequest(http.MethodGet, "/link?uid=user-b", nil).WithContext(ctx)
+		resp := httptest.NewRecorder()
+		router.getLinkStatus(resp, req)
+		if resp.Code != http.StatusOK {
+			t.Fatalf("link status code = %d", resp.Code)
+		}
+		var result struct {
+			Status bool   `json:"status"`
+			State  string `json:"state"`
+		}
+		if err := json.Unmarshal(resp.Body.Bytes(), &result); err != nil {
+			t.Fatal(err)
+		}
+		return result
+	}
+	stateA := status(ctxA)
+	if stateA.Status || stateA.State == "" {
+		t.Fatalf("user A link status = %+v; want unlinked with a state", stateA)
+	}
+	if !status(ctxB).Status {
+		t.Fatal("user B should remain linked")
+	}
+	if uid, err := router.userFromLinkState(stateA.State); err != nil || uid != "user-a" {
+		t.Fatalf("signed state identifies %q, %v; want user-a", uid, err)
+	}
+
+	client := &tests.FakeHttpClient{Res: http.Response{
+		Body:       ioutil.NopCloser(bytes.NewBufferString(`{"session":{"name":"A","key":"SK-A","subscriber":0}}`)),
+		StatusCode: http.StatusOK,
+	}}
+	router.client = NewClient("API_KEY", "test-secret", "en", client)
+	callback := func(state string) int {
+		query := url.Values{"token": {"TOKEN"}, "state": {state}, "uid": {"user-b"}}
+		req := httptest.NewRequest(http.MethodGet, "/link/callback?"+query.Encode(), nil)
+		resp := httptest.NewRecorder()
+		router.callback(resp, req)
+		return resp.Code
+	}
+	if code := callback(""); code != http.StatusBadRequest {
+		t.Fatalf("callback without state = %d; want 400", code)
+	}
+	if code := callback(stateA.State + "x"); code != http.StatusBadRequest {
+		t.Fatalf("callback with tampered state = %d; want 400", code)
+	}
+	if client.RequestCount != 0 {
+		t.Fatal("invalid state reached Last.fm")
+	}
+	if code := callback(stateA.State); code != http.StatusOK {
+		t.Fatalf("callback with valid state = %d; want 200", code)
+	}
+	if key, err := ds.UserProps(ctxA).Get("user-a", sessionKeyProperty); err != nil || key != "SK-A" {
+		t.Fatalf("user A key = %q, %v; want SK-A", key, err)
+	}
+	if key, err := ds.UserProps(ctxB).Get("user-b", sessionKeyProperty); err != nil || key != "SK-B" {
+		t.Fatalf("user B key = %q, %v; want SK-B", key, err)
+	}
+
+	req := httptest.NewRequest(http.MethodDelete, "/link?uid=user-b", nil).WithContext(ctxA)
+	resp := httptest.NewRecorder()
+	router.unlink(resp, req)
+	if resp.Code != http.StatusOK {
+		t.Fatalf("unlink code = %d; want 200", resp.Code)
+	}
+	if status(ctxA).Status || !status(ctxB).Status {
+		t.Fatal("unlink affected the wrong user")
+	}
+}
diff --git a/core/agents/lastfm/link_state.go b/core/agents/lastfm/link_state.go
new file mode 100644
index 0000000..3e3e95b
--- /dev/null
+++ b/core/agents/lastfm/link_state.go
@@ -0,0 +1,56 @@
+package lastfm
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+)
+
+const linkStateLifetime = 10 * time.Minute
+
+type linkState struct {
+	UserID    string `json:"uid"`
+	ExpiresAt int64  `json:"exp"`
+}
+
+var errInvalidLinkState = errors.New("invalid link state")
+
+func (s *Router) signLinkState(userId string) string {
+	data, _ := json.Marshal(linkState{UserID: userId, ExpiresAt: time.Now().Add(linkStateLifetime).Unix()})
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write(data)
+	return base64.RawURLEncoding.EncodeToString(data) + "." + base64.RawURLEncoding.EncodeToString(mac.Sum(nil))
+}
+
+func (s *Router) userFromLinkState(state string) (string, error) {
+	if s.secret == "" || len(state) > 4096 {
+		return "", errInvalidLinkState
+	}
+	parts := strings.Split(state, ".")
+	if len(parts) != 2 {
+		return "", errInvalidLinkState
+	}
+	data, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", errInvalidLinkState
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", errInvalidLinkState
+	}
+	mac := hmac.New(sha256.New, []byte(s.secret))
+	_, _ = mac.Write(data)
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return "", errInvalidLinkState
+	}
+	var payload linkState
+	if json.Unmarshal(data, &payload) != nil || payload.UserID == "" ||
+		payload.ExpiresAt <= time.Now().Unix() || payload.ExpiresAt > time.Now().Add(linkStateLifetime).Unix() {
+		return "", errInvalidLinkState
+	}
+	return payload.UserID, nil
+}
