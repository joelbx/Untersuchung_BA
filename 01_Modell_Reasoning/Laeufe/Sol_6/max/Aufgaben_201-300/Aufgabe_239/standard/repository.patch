+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User Props Repository", func() {
+	It("uses the explicit user ID for every operation", func() {
+		// A context for user B must not override the ID supplied by the caller.
+		ctx := request.WithUser(context.Background(), model.User{ID: "user-b"})
+		repo := NewUserPropsRepository(ctx, orm.NewOrm())
+		const key = "per-user-test"
+
+		Expect(repo.Put("user-a", key, "A")).To(Succeed())
+		Expect(repo.Put("user-b", key, "B")).To(Succeed())
+		Expect(repo.Get("user-a", key)).To(Equal("A"))
+		Expect(repo.Get("user-b", key)).To(Equal("B"))
+		Expect(repo.DefaultGet("user-a", key, "default")).To(Equal("A"))
+		Expect(repo.DefaultGet("user-c", key, "default")).To(Equal("default"))
+
+		Expect(repo.Put("user-a", key, "A updated")).To(Succeed())
+		Expect(repo.Delete("user-b", key)).To(Succeed())
+		Expect(repo.Get("user-a", key)).To(Equal("A updated"))
+		_, err := repo.Get("user-b", key)
+		Expect(err).To(Equal(model.ErrNotFound))
+
+		Expect(repo.Put("", key, "missing user")).To(Equal(model.ErrInvalidAuth))
+		_, err = repo.DefaultGet("", key, "default")
+		Expect(err).To(Equal(model.ErrInvalidAuth))
+		Expect(repo.Delete("", key)).To(Equal(model.ErrInvalidAuth))
+	})
+})
