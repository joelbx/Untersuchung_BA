new file mode 100644
index 0000000..cd7053f
--- /dev/null
+++ b/tests/mock_user_props_repo_test.go
@@ -0,0 +1,40 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestMockedUserPropsRepoScopesProperties(t *testing.T) {
+	repo := &MockedUserPropsRepo{}
+	if err := repo.Put("a_b", "c", "one"); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Put("a", "b_c", "two"); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ userId, key, want string }{
+		{"a_b", "c", "one"},
+		{"a", "b_c", "two"},
+	} {
+		got, err := repo.DefaultGet(tc.userId, tc.key, "default")
+		if err != nil || got != tc.want {
+			t.Fatalf("DefaultGet(%q, %q) = %q, %v; want %q", tc.userId, tc.key, got, err, tc.want)
+		}
+	}
+	if err := repo.Delete("a_b", "c"); err != nil {
+		t.Fatal(err)
+	}
+	got, err := repo.DefaultGet("a_b", "c", "default")
+	if err != nil || got != "default" {
+		t.Fatalf("deleted property = %q, %v; want default", got, err)
+	}
+	got, err = repo.Get("a", "b_c")
+	if err != nil || got != "two" {
+		t.Fatalf("other user's property = %q, %v; want two", got, err)
+	}
+	if err := repo.Put("", "key", "value"); err != model.ErrInvalidAuth {
+		t.Fatalf("empty user ID error = %v; want ErrInvalidAuth", err)
+	}
+}
