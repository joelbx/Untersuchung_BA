+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Group IA ISBN metadata by length without validating the ISBNs."""
+    isbn_10 = []
+    isbn_13 = []
+
+    if isinstance(isbns, str):
+        isbns = [isbns]
+
+    for isbn in isbns:
+        isbn = isbn.strip()
+        if len(isbn) == 10:
+            isbn_10.append(isbn)
+        elif len(isbn) == 13:
+            isbn_13.append(isbn)
+
+    return isbn_10, isbn_13
+
