+def test_prioritized_identifier_deduplicates_by_identifier() -> None:
+    earlier = datetime(2026, 10, 20, 12, 30)
+    later = datetime(2026, 10, 20, 12, 31)
+    isbn = PrioritizedIdentifier("9780747532699", timestamp=earlier)
+    duplicate = PrioritizedIdentifier(
+        "9780747532699", False, Priority.HIGH, later
+    )
+    asin = PrioritizedIdentifier("B012346789", timestamp=later)
+
+    assert isbn == duplicate
+    assert hash(isbn) == hash(duplicate)
+    assert len({isbn, duplicate, asin}) == 2
+    assert isbn != "9780747532699"
+    assert min([isbn, asin]) == isbn
+    highest = PrioritizedIdentifier("B999999999", priority=Priority.HIGH)
+    assert min([isbn, asin, highest]) == highest
+
+
