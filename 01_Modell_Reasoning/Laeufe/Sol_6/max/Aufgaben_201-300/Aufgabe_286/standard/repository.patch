diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..579bfd5
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,81 @@
+// Package release checks whether a build is a release and whether a newer
+// version is available.
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info contains the current and latest release versions and the URL of the
+// latest release. LatestVersion and LatestVersionURL are empty when no check
+// has completed successfully.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+type loggerKey struct{}
+
+// WithLogger lets Check report failures through the application's logger.
+func WithLogger(ctx context.Context, logger *zap.Logger) context.Context {
+	return context.WithValue(ctx, loggerKey{}, logger)
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" || strings.HasSuffix(strings.ToLower(version), "dev") {
+		return false
+	}
+
+	v, err := semver.ParseTolerant(version)
+	return err == nil && len(v.Pre) == 0
+}
+
+// Check retrieves the latest release and compares it with version. Errors are
+// returned for callers that need them and logged as warnings so startup can
+// continue when the update service is unavailable.
+func Check(ctx context.Context, version string) (Info, error) {
+	return check(ctx, version, github.NewClient(nil))
+}
+
+func check(ctx context.Context, version string, client *github.Client) (Info, error) {
+	info := Info{CurrentVersion: version}
+
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, warn(ctx, fmt.Errorf("parsing current version: %w", err))
+	}
+
+	latestRelease, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, warn(ctx, fmt.Errorf("getting latest release: %w", err))
+	}
+
+	latest, err := semver.ParseTolerant(latestRelease.GetTagName())
+	if err != nil {
+		return info, warn(ctx, fmt.Errorf("parsing latest version: %w", err))
+	}
+
+	info.LatestVersion = latestRelease.GetTagName()
+	info.LatestVersionURL = latestRelease.GetHTMLURL()
+	info.UpdateAvailable = current.Compare(latest) < 0
+
+	return info, nil
+}
+
+func warn(ctx context.Context, err error) error {
+	logger, ok := ctx.Value(loggerKey{}).(*zap.Logger)
+	if !ok || logger == nil {
+		logger = zap.L()
+	}
+	logger.Warn("checking for updates", zap.Error(err))
+	return err
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..b48ab4e
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,110 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3-snapshot", false},
+		{"1.2.3-dev", false},
+		{"1.2.3+dev", false},
+		{"1.2.3-rc", false},
+		{"v1.2.3-rc.2+sha", false},
+		{"1.2.3-beta.1", false},
+		{"not-a-version", false},
+		{"1.2.3", true},
+		{"v1.2.3", true},
+		{"1.2.3+sha", true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			if got := Is(tt.version); got != tt.want {
+				t.Errorf("Is(%q) = %t, want %t", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name       string
+		current    string
+		latest     string
+		wantUpdate bool
+	}{
+		{"update available", "v1.2.3", "v1.3.0", true},
+		{"running latest", "v1.3.0", "v1.3.0", false},
+		{"current is newer", "v1.4.0", "v1.3.0", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			const latestURL = "https://example.test/release"
+			client, closeServer := testClient(t, http.StatusOK, fmt.Sprintf(`{"tag_name":%q,"html_url":%q}`, tt.latest, latestURL))
+			defer closeServer()
+
+			got, err := check(context.Background(), tt.current, client)
+			if err != nil {
+				t.Fatalf("check: %v", err)
+			}
+			if got.CurrentVersion != tt.current || got.LatestVersion != tt.latest || got.LatestVersionURL != latestURL || got.UpdateAvailable != tt.wantUpdate {
+				t.Errorf("check = %+v, want current %q, latest %q, URL %q, update %t", got, tt.current, tt.latest, latestURL, tt.wantUpdate)
+			}
+		})
+	}
+}
+
+func TestCheckFailureLogsWarning(t *testing.T) {
+	client, closeServer := testClient(t, http.StatusServiceUnavailable, `{"message":"unavailable"}`)
+	defer closeServer()
+
+	core, logs := observer.New(zap.WarnLevel)
+	ctx := WithLogger(context.Background(), zap.New(core))
+	got, err := check(ctx, "v1.2.3", client)
+	if err == nil {
+		t.Fatal("expected update check error")
+	}
+	if got.CurrentVersion != "v1.2.3" || got.LatestVersion != "" || got.UpdateAvailable {
+		t.Errorf("check returned unexpected status after failure: %+v", got)
+	}
+	entries := logs.All()
+	if len(entries) != 1 || entries[0].Message != "checking for updates" || !strings.Contains(fmt.Sprint(entries[0].ContextMap()["error"]), "503") {
+		t.Errorf("expected warning with update check error, got %+v", entries)
+	}
+}
+
+func testClient(t *testing.T, status int, body string) (*github.Client, func()) {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/repos/flipt-io/flipt/releases/latest" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+		}
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}))
+	client := github.NewClient(server.Client())
+	baseURL, err := url.Parse(server.URL + "/")
+	if err != nil {
+		server.Close()
+		t.Fatalf("parse test server URL: %v", err)
+	}
+	client.BaseURL = baseURL
+	return client, server.Close
+}
