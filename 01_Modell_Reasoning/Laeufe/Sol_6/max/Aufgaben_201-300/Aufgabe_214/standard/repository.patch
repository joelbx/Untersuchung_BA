diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..728a911
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,200 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is a TCP scan technique supported by nmap.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+// String returns the nmap option without its leading dash.
+func (t ScanTechnique) String() string {
+	switch t {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return "NotSupportTechnique"
+	}
+}
+
+// PortScanConf configures an external scanner on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+// IsZero reports whether no port scan setting was supplied.
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+// GetScanTechniques resolves configured nmap option codes without case sensitivity.
+// Unsupported entries are represented once by NotSupportTechnique.
+func (c *PortScanConf) GetScanTechniques() []ScanTechnique {
+	if c == nil || len(c.ScanTechniques) == 0 {
+		return []ScanTechnique{}
+	}
+	techniques := make([]ScanTechnique, 0, len(c.ScanTechniques))
+	unsupported := false
+	for _, value := range c.ScanTechniques {
+		technique := parseScanTechnique(value)
+		if technique == NotSupportTechnique {
+			if unsupported {
+				continue
+			}
+			unsupported = true
+		}
+		techniques = append(techniques, technique)
+	}
+	return techniques
+}
+
+func parseScanTechnique(value string) ScanTechnique {
+	switch strings.ToLower(value) {
+	case "ss":
+		return TCPSYN
+	case "st":
+		return TCPConnect
+	case "sa":
+		return TCPACK
+	case "sw":
+		return TCPWindow
+	case "sm":
+		return TCPMaimon
+	case "sn":
+		return TCPNull
+	case "sf":
+		return TCPFIN
+	case "sx":
+		return TCPXmas
+	default:
+		return NotSupportTechnique
+	}
+}
+
+// Validate checks settings that would be passed to an external scanner.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() && !c.IsUseExternalScanner {
+		return nil
+	}
+
+	pathValid := false
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath is required for external scanning"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q: %w", c.ScannerBinPath, err))
+	} else if !info.Mode().IsRegular() || info.Mode().Perm()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q must be an executable file", c.ScannerBinPath))
+	} else {
+		pathValid = true
+	}
+
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan.scanTechniques: multiple scan techniques are not supported"))
+	}
+	for _, value := range c.ScanTechniques {
+		technique := parseScanTechnique(value)
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan.scanTechniques: unsupported technique %q", value))
+		} else if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan.scanTechniques: %s requires hasPrivileged = true; only sT is allowed without privileges", technique))
+		}
+	}
+
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort %q must be an integer from 1 to 65535", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort 0 is not a usable source port"))
+		}
+		if len(c.ScanTechniques) == 0 && !c.HasPrivileged || len(c.ScanTechniques) == 1 && parseScanTechnique(c.ScanTechniques[0]) == TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort cannot be used with TCPConnect (sT)"))
+		}
+	}
+
+	if c.HasPrivileged && pathValid && os.Geteuid() != 0 {
+		if err := checkScannerCapabilities(c.ScannerBinPath); err != nil {
+			errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q: %w", c.ScannerBinPath, err))
+		}
+	}
+	return errs
+}
+
+// checkScannerCapabilities checks the effective file capabilities needed for raw TCP scans.
+func checkScannerCapabilities(path string) error {
+	output, err := exec.Command("getcap", path).Output()
+	if err != nil {
+		return fmt.Errorf("could not check scanner capabilities with getcap: %w", err)
+	}
+	line := strings.TrimSpace(string(output))
+	if line == "" {
+		return fmt.Errorf("missing scanner capabilities: cap_net_raw and cap_net_admin are required")
+	}
+	if !strings.HasPrefix(line, path) {
+		return fmt.Errorf("malformed scanner capability data: %q", line)
+	}
+	capabilities := strings.TrimSpace(strings.TrimPrefix(line, path))
+	capabilities = strings.TrimSpace(strings.TrimPrefix(capabilities, "="))
+	if capabilities == "" || strings.Contains(capabilities, "\n") {
+		return fmt.Errorf("malformed scanner capability data: %q", line)
+	}
+	effective := map[string]bool{}
+	for _, group := range strings.Fields(capabilities) {
+		separator := strings.IndexAny(group, "=+")
+		if separator <= 0 || separator == len(group)-1 {
+			return fmt.Errorf("malformed scanner capability data: %q", line)
+		}
+		flags := group[separator+1:]
+		for _, flag := range flags {
+			if !strings.ContainsRune("eip", flag) {
+				return fmt.Errorf("malformed scanner capability data: %q", line)
+			}
+		}
+		for _, capability := range strings.Split(group[:separator], ",") {
+			if !strings.HasPrefix(capability, "cap_") || len(capability) <= len("cap_") {
+				return fmt.Errorf("malformed scanner capability data: %q", line)
+			}
+			if strings.Contains(flags, "e") {
+				effective[capability] = true
+			}
+		}
+	}
+	if !effective["cap_net_raw"] || !effective["cap_net_admin"] {
+		return fmt.Errorf("missing effective scanner capabilities: cap_net_raw and cap_net_admin are required")
+	}
+	return nil
+}
