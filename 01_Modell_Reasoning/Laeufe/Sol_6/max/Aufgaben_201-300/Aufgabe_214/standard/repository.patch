@@ -0,0 +1,179 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	codes := []string{"sS", "ST", "Sa", "sw", "SM", "sn", "SF", "sx"}
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas}
+	got := (&PortScanConf{ScanTechniques: codes}).GetScanTechniques()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("GetScanTechniques() = %v, want %v", got, want)
+	}
+	for i, technique := range got {
+		if !strings.EqualFold(technique.String(), codes[i]) {
+			t.Errorf("%v.String() = %q, want %q", technique, technique.String(), codes[i])
+		}
+	}
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty scan techniques = %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad", "invalid"}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{NotSupportTechnique}) {
+		t.Errorf("unsupported scan techniques = %v", got)
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"sT", "bad"}}).GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{TCPConnect, NotSupportTechnique}) {
+		t.Errorf("mixed scan techniques = %v", got)
+	}
+}
+
+func TestPortScanIsZero(t *testing.T) {
+	if !(PortScanConf{}).IsZero() || !(PortScanConf{IsUseExternalScanner: true}).IsZero() {
+		t.Fatal("unset port scan fields should be zero")
+	}
+	for _, conf := range []PortScanConf{
+		{ScannerBinPath: "/usr/bin/nmap"},
+		{ScanTechniques: []string{"sS"}},
+		{SourcePort: "443"},
+		{HasPrivileged: true},
+	} {
+		if conf.IsZero() {
+			t.Errorf("%+v was reported as zero", conf)
+		}
+	}
+}
+
+func TestPortScanValidate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "scanner")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"native default", PortScanConf{}, ""},
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"St"}}, ""},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"explicit empty path", PortScanConf{IsUseExternalScanner: true}, "scannerBinPath"},
+		{"nonexistent path", PortScanConf{ScannerBinPath: path + "-missing"}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sU"}}, "unsupported technique"},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sT"}}, "multiple scan techniques"},
+		{"unprivileged syn", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, "hasPrivileged"},
+		{"connect source port", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "TCPConnect"},
+		{"zero source port", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, "sourcePort 0"},
+		{"out of range source port", PortScanConf{ScannerBinPath: path, SourcePort: "65536"}, "sourcePort"},
+		{"invalid source port", PortScanConf{ScannerBinPath: path, SourcePort: "abc"}, "sourcePort"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			errs := tt.conf.Validate()
+			if tt.want == "" && len(errs) != 0 {
+				t.Fatalf("unexpected validation errors: %v", errs)
+			}
+			if tt.want != "" {
+				found := false
+				for _, err := range errs {
+					found = found || strings.Contains(err.Error(), tt.want)
+				}
+				if !found {
+					t.Errorf("validation errors %v do not contain %q", errs, tt.want)
+				}
+			}
+		})
+	}
+}
+
+func TestTOMLPortScanPerServer(t *testing.T) {
+	old := Conf
+	Conf = Config{}
+	defer func() { Conf = old }()
+	path := filepath.Join(t.TempDir(), "config.toml")
+	content := `[servers.external]
+host = "localhost"
+port = "local"
+[servers.external.portscan]
+scannerBinPath = "/usr/bin/nmap"
+scanTechniques = ["sT"]
+
+[servers.native]
+host = "localhost"
+port = "local"
+[servers.native.portscan]
+scanTechniques = []
+
+[servers.empty]
+host = "localhost"
+port = "local"
+[servers.empty.portscan]
+scannerBinPath = ""
+`
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := (TOMLLoader{}).Load(path, ""); err != nil {
+		t.Fatal(err)
+	}
+	if got := Conf.Servers["external"].PortScan; got == nil || !got.IsUseExternalScanner || !reflect.DeepEqual(got.GetScanTechniques(), []ScanTechnique{TCPConnect}) {
+		t.Errorf("external port scan not loaded: %+v", got)
+	}
+	if got := Conf.Servers["native"].PortScan; got == nil || got.IsUseExternalScanner {
+		t.Errorf("native port scan incorrectly enabled: %+v", got)
+	}
+	if got := Conf.Servers["empty"].PortScan; got == nil || !got.IsUseExternalScanner {
+		t.Errorf("explicit scannerBinPath was not enabled: %+v", got)
+	}
+}
+
+func TestCheckPortScanConfig(t *testing.T) {
+	server := ServerInfo{PortScan: &PortScanConf{ScanTechniques: []string{"sU"}}}
+	server.Module.Set(Port)
+	conf := Config{Servers: map[string]ServerInfo{"target": server}}
+	if errs := conf.checkPortScanConfig(); len(errs) == 0 {
+		t.Fatal("invalid port scan settings were accepted for a port scan target")
+	}
+	if conf.ValidateOnScan() {
+		t.Fatal("scan configuration accepted invalid port scan settings")
+	}
+	server.Module = ScanModule{}
+	server.Module.Set(OSPkg)
+	conf.Servers["target"] = server
+	if errs := conf.checkPortScanConfig(); len(errs) != 0 {
+		t.Errorf("port scan settings were checked without the port module: %v", errs)
+	}
+}
+
+func TestCheckScannerCapabilities(t *testing.T) {
+	dir := t.TempDir()
+	getcap := filepath.Join(dir, "getcap")
+	if err := os.WriteFile(getcap, []byte("#!/bin/sh\nprintf '%s\\n' \"$FAKE_CAP_OUTPUT\"\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	path := filepath.Join(dir, "scanner")
+	for _, tt := range []struct {
+		name   string
+		output string
+		want   string
+	}{
+		{"valid", path + " cap_net_raw,cap_net_admin=ep", ""},
+		{"missing", "", "missing scanner capabilities"},
+		{"malformed", path + " invalid", "malformed scanner capability data"},
+		{"incomplete", path + " cap_net_raw=ep", "missing effective scanner capabilities"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("FAKE_CAP_OUTPUT", tt.output)
+			err := checkScannerCapabilities(path)
+			if tt.want == "" && err != nil {
+				t.Errorf("unexpected capability error: %v", err)
+			} else if tt.want != "" && (err == nil || !strings.Contains(err.Error(), tt.want)) {
+				t.Errorf("capability error = %v, want %q", err, tt.want)
+			}
+		})
+	}
+}
