diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..ea2f7b9
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,168 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+// execPortsScan selects the scanner configured for this server.
+func (l *base) execPortsScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	if conf := l.ServerInfo.PortScan; conf != nil && conf.IsUseExternalScanner {
+		return l.execExternalPortScan(scanDestIPPorts)
+	}
+	return l.execNativePortScan(scanDestIPPorts)
+}
+
+func (l *base) shouldSkipPortScanIP(ip string) bool {
+	parsed := net.ParseIP(ip)
+	return parsed != nil && parsed.IsLoopback() && !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host)
+}
+
+func (l *base) execNativePortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	listenIPPorts := []string{}
+	for ip, ports := range scanDestIPPorts {
+		if l.shouldSkipPortScanIP(ip) {
+			continue
+		}
+		for _, port := range ports {
+			conn, err := net.DialTimeout("tcp", net.JoinHostPort(ip, port), time.Second)
+			if err != nil {
+				continue
+			}
+			conn.Close()
+			listenIPPorts = append(listenIPPorts, ip+":"+port)
+		}
+	}
+	return listenIPPorts, nil
+}
+
+// setScanTechniques converts scan types into nmap command line options.
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	if len(techniques) > 1 {
+		return nil, fmt.Errorf("multiple scan techniques are not supported")
+	}
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		if technique == config.NotSupportTechnique || technique < config.TCPSYN || technique > config.TCPXmas {
+			return nil, fmt.Errorf("unsupported scan technique: %v", technique)
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+type nmapRun struct {
+	XMLName xml.Name `xml:"nmaprun"`
+	Hosts   []struct {
+		Ports []struct {
+			Protocol string `xml:"protocol,attr"`
+			PortID   string `xml:"portid,attr"`
+			State    struct {
+				Value string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil {
+		return nil, fmt.Errorf("external port scan requires portscan configuration")
+	}
+	if errs := conf.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid external port scan configuration: %v", errs)
+	}
+
+	techniques := conf.GetScanTechniques()
+	if len(techniques) == 0 {
+		if conf.HasPrivileged {
+			techniques = []config.ScanTechnique{config.TCPSYN}
+		} else {
+			techniques = []config.ScanTechnique{config.TCPConnect}
+		}
+	}
+	techniqueOptions, err := setScanTechniques(techniques)
+	if err != nil {
+		return nil, err
+	}
+
+	listenIPPorts := []string{}
+	for ip, ports := range scanDestIPPorts {
+		if l.shouldSkipPortScanIP(ip) || len(ports) == 0 {
+			continue
+		}
+		parsedIP := net.ParseIP(ip)
+		if parsedIP == nil {
+			return nil, fmt.Errorf("invalid port scan destination IP %q", ip)
+		}
+		uniqPorts := map[string]bool{}
+		for _, port := range ports {
+			n, err := strconv.Atoi(port)
+			if err != nil || n < 1 || n > 65535 {
+				return nil, fmt.Errorf("invalid port scan destination port %q", port)
+			}
+			uniqPorts[strconv.Itoa(n)] = true
+		}
+		portList := make([]string, 0, len(uniqPorts))
+		for port := range uniqPorts {
+			portList = append(portList, port)
+		}
+		sort.Slice(portList, func(i, j int) bool {
+			left, _ := strconv.Atoi(portList[i])
+			right, _ := strconv.Atoi(portList[j])
+			return left < right
+		})
+
+		options := []string{"-n", "-Pn", "-oX", "-"}
+		if parsedIP.To4() == nil {
+			options = append(options, "-6")
+		}
+		if conf.HasPrivileged {
+			options = append(options, "--privileged")
+		}
+		options = append(options, techniqueOptions...)
+		if conf.SourcePort != "" {
+			options = append(options, "-g", conf.SourcePort)
+		}
+		options = append(options, "-p", strings.Join(portList, ","), ip)
+		output, err := osExec.Command(conf.ScannerBinPath, options...).Output()
+		if err != nil {
+			if exitErr, ok := err.(*osExec.ExitError); ok {
+				return nil, fmt.Errorf("port scanner %q %s failed: %w: %s", conf.ScannerBinPath, formatNmapOptionsToString(options), err, strings.TrimSpace(string(exitErr.Stderr)))
+			}
+			return nil, fmt.Errorf("port scanner %q %s failed: %w", conf.ScannerBinPath, formatNmapOptionsToString(options), err)
+		}
+		var result nmapRun
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("failed to parse port scanner output for %s: %w", ip, err)
+		}
+		if len(result.Hosts) == 0 {
+			return nil, fmt.Errorf("port scanner returned no host results for %s", ip)
+		}
+		for _, host := range result.Hosts {
+			for _, port := range host.Ports {
+				if port.Protocol != "tcp" || !uniqPorts[port.PortID] {
+					continue
+				}
+				// ACK and stealth scans can report a reachable port as
+				// unfiltered or open|filtered rather than open.
+				if port.State.Value == "open" || port.State.Value == "unfiltered" || port.State.Value == "open|filtered" {
+					listenIPPorts = append(listenIPPorts, ip+":"+port.PortID)
+				}
+			}
+		}
+	}
+	return listenIPPorts, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
index 0000000..fd0b04c
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,115 @@
+package scanner
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestSetScanTechniques(t *testing.T) {
+	for _, technique := range []config.ScanTechnique{
+		config.TCPSYN, config.TCPConnect, config.TCPACK, config.TCPWindow,
+		config.TCPMaimon, config.TCPNull, config.TCPFIN, config.TCPXmas,
+	} {
+		got, err := setScanTechniques([]config.ScanTechnique{technique})
+		if err != nil || !reflect.DeepEqual(got, []string{"-" + technique.String()}) {
+			t.Errorf("setScanTechniques(%v) = %v, %v", technique, got, err)
+		}
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.NotSupportTechnique}); err == nil {
+		t.Error("unsupported technique was accepted")
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.TCPSYN, config.TCPACK}); err == nil {
+		t.Error("multiple techniques were accepted")
+	}
+}
+
+func TestExecPortsScanSelectsNative(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	port := strings.TrimPrefix(listener.Addr().String(), "127.0.0.1:")
+	l := base{ServerInfo: config.ServerInfo{Host: "localhost", Port: "local"}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {port}})
+	if err != nil || !reflect.DeepEqual(got, []string{"127.0.0.1:" + port}) {
+		t.Errorf("native scan = %v, %v", got, err)
+	}
+}
+
+func TestExecExternalPortScan(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "fake-nmap")
+	argsPath := filepath.Join(dir, "args")
+	script := `#!/bin/sh
+printf '%s\n' "$@" > "$FAKE_NMAP_ARGS"
+printf '%s\n' '<nmaprun><host><ports><port protocol="tcp" portid="80"><state state="open"/></port><port protocol="tcp" portid="443"><state state="closed"/></port></ports></host></nmaprun>'
+`
+	if err := os.WriteFile(path, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("FAKE_NMAP_ARGS", argsPath)
+	l := base{ServerInfo: config.ServerInfo{
+		Host: "localhost", Port: "local",
+		PortScan: &config.PortScanConf{
+			ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true,
+		},
+	}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {"443", "80"}})
+	if err != nil || !reflect.DeepEqual(got, []string{"127.0.0.1:80"}) {
+		t.Fatalf("external scan = %v, %v", got, err)
+	}
+	args, err := os.ReadFile(argsPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, option := range []string{"-n", "-Pn", "-oX", "-sT", "-p", "80,443", "127.0.0.1"} {
+		if !strings.Contains("\n"+string(args), "\n"+option+"\n") {
+			t.Errorf("missing %q from nmap arguments: %q", option, args)
+		}
+	}
+}
+
+func TestExecExternalPortScanSourcePort(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "fake-nmap")
+	argsPath := filepath.Join(dir, "args")
+	script := `#!/bin/sh
+printf '%s\n' "$@" > "$FAKE_NMAP_ARGS"
+printf '%s\n' '<nmaprun><host><ports><port protocol="tcp" portid="80"><state state="open"/></port></ports></host></nmaprun>'
+`
+	if err := os.WriteFile(path, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	getcap := filepath.Join(dir, "getcap")
+	if err := os.WriteFile(getcap, []byte("#!/bin/sh\nprintf '%s cap_net_raw,cap_net_admin=ep\\n' \"$1\"\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("FAKE_NMAP_ARGS", argsPath)
+	l := base{ServerInfo: config.ServerInfo{
+		Host: "localhost", Port: "local",
+		PortScan: &config.PortScanConf{
+			ScannerBinPath: path, ScanTechniques: []string{"sS"}, SourcePort: "443", HasPrivileged: true, IsUseExternalScanner: true,
+		},
+	}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {"80"}})
+	if err != nil || !reflect.DeepEqual(got, []string{"127.0.0.1:80"}) {
+		t.Fatalf("external source port scan = %v, %v", got, err)
+	}
+	args, err := os.ReadFile(argsPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, option := range []string{"--privileged", "-sS", "-g", "443"} {
+		if !strings.Contains("\n"+string(args), "\n"+option+"\n") {
+			t.Errorf("missing %q from nmap arguments: %q", option, args)
+		}
+	}
+}
