diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..97b7c36
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,109 @@
+import React from 'react';
+import { fireEvent, render, screen } from '@testing-library/react';
+
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+
+import useGetCalendarSetup from '../hooks/useGetCalendarSetup';
+import useGetCalendarActions from '../hooks/useGetCalendarActions';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ error: false, loading: false })),
+}));
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(),
+}));
+
+const mockedUseGetCalendarSetup = useGetCalendarSetup as jest.Mock;
+const mockedUseGetCalendarActions = useGetCalendarActions as jest.Mock;
+
+describe('SubscribeCalendarModal', () => {
+    const handleCreateCalendar = jest.fn(() => Promise.resolve());
+
+    beforeEach(() => {
+        mockedUseGetCalendarSetup.mockReturnValue({ error: false, loading: false });
+        mockedUseGetCalendarActions.mockReturnValue({ handleCreateCalendar });
+        handleCreateCalendar.mockClear();
+    });
+
+    it('accepts a trimmed valid URL and rejects an empty or malformed URL', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        const input = screen.getByLabelText('Calendar URL') as HTMLInputElement;
+        const submit = screen.getByText('Add calendar', { selector: 'button' });
+        expect(submit).toBeDisabled();
+
+        fireEvent.change(input, { target: { value: 'invalid' } });
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('Invalid URL')).toBeInTheDocument();
+
+        fireEvent.change(input, { target: { value: '  https://example.com/calendar.ics  ' } });
+        expect(input.value).toBe('https://example.com/calendar.ics');
+        expect(submit).toBeEnabled();
+        expect(screen.queryByText('Invalid URL')).not.toBeInTheDocument();
+    });
+
+    it('allows the limit and blocks longer URLs, including form submission', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        const input = screen.getByLabelText('Calendar URL') as HTMLInputElement;
+        const submit = screen.getByText('Add calendar', { selector: 'button' });
+        const prefix = 'https://example.com/';
+        const limitURL = prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length);
+
+        fireEvent.change(input, { target: { value: limitURL } });
+        expect(submit).toBeEnabled();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        fireEvent.change(input, { target: { value: `${limitURL}a` } });
+        expect(input.value).toHaveLength(MAX_LENGTHS_API.CALENDAR_URL + 1);
+        expect(input).not.toHaveAttribute('maxLength');
+        expect(submit).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+
+        fireEvent.submit(input.closest('form') as HTMLFormElement);
+        expect(handleCreateCalendar).not.toHaveBeenCalled();
+    });
+
+    it.each([
+        ['Google without .ics', 'https://calendar.google.com/', '', 'This link might be wrong'],
+        ['Outlook without .ics', 'https://outlook.live.com/', '', 'This link might be wrong'],
+        [
+            'Google public link without .ics ending',
+            'https://calendar.google.com/public/',
+            '.ics?token=abc',
+            'This link might be wrong',
+        ],
+        [
+            'Google public .ics',
+            'https://calendar.google.com/public/',
+            '.ics',
+            'By using this link, Google will make the calendar you are subscribing to public',
+        ],
+    ])('prioritizes the %s warning over URL length', (_case, prefix, suffix, expectedWarning) => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        const input = screen.getByLabelText('Calendar URL') as HTMLInputElement;
+        const longURL = prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length - suffix.length + 1) + suffix;
+        fireEvent.change(input, { target: { value: longURL } });
+
+        expect(screen.getByText(expectedWarning)).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(screen.getByText('Add calendar', { selector: 'button' })).toBeDisabled();
+    });
+
+    it('uses the same URL validation in the error flow', () => {
+        const { rerender } = render(<SubscribeCalendarModal isOpen />);
+
+        const input = screen.getByLabelText('Calendar URL') as HTMLInputElement;
+        const prefix = 'https://example.com/';
+        const longURL = prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length + 1);
+        fireEvent.change(input, { target: { value: longURL } });
+
+        mockedUseGetCalendarSetup.mockReturnValue({ error: true, loading: false });
+        rerender(<SubscribeCalendarModal isOpen />);
+        expect(screen.getByText('Close', { selector: 'button' })).toBeDisabled();
+    });
+});
