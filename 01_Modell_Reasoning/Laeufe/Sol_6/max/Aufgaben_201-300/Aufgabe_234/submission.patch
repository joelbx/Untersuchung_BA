 	"github.com/navidrome/navidrome/log"
@@ -10,6 +13,63 @@ import (
 	. "github.com/onsi/gomega"
 )
 
+func TestSQLiteDSN(t *testing.T) {
+	name := filepath.Join(t.TempDir(), "test.db")
+	dsn := sqliteDSN(name + "?cache=private&custom=value")
+	path, query, ok := strings.Cut(dsn, "?")
+	if !ok || path != name {
+		t.Fatalf("unexpected SQLite path: %q", dsn)
+	}
+	params, err := url.ParseQuery(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]string{
+		"cache":         "shared",
+		"_cache_size":   "1000000000",
+		"_busy_timeout": "5000",
+		"_journal_mode": "WAL",
+		"_synchronous":  "NORMAL",
+		"_foreign_keys": "on",
+		"_txlock":       "immediate",
+		"custom":        "value",
+	} {
+		if got := params.Get(key); got != want {
+			t.Errorf("SQLite option %s = %q, want %q", key, got, want)
+		}
+	}
+	if got := sqliteDSN(":memory:"); !strings.HasPrefix(got, "file::memory:?") {
+		t.Errorf("shared memory SQLite DSN = %q", got)
+	}
+
+	conn, err := sql.Open(Driver, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for pragma, want := range map[string]int{
+		"cache_size":   1000000000,
+		"busy_timeout": 5000,
+		"synchronous":  1,
+		"foreign_keys": 1,
+	} {
+		var got int
+		if err := conn.QueryRow("PRAGMA " + pragma).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != want {
+			t.Errorf("PRAGMA %s = %d, want %d", pragma, got, want)
+		}
+	}
+	var journal string
+	if err := conn.QueryRow("PRAGMA journal_mode").Scan(&journal); err != nil {
+		t.Fatal(err)
+	}
+	if journal != "wal" {
+		t.Errorf("PRAGMA journal_mode = %q, want wal", journal)
+	}
+}
