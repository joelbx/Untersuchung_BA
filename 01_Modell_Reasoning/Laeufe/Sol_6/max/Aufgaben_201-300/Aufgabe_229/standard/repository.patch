diff --git a/test/imageCleanup.js b/test/imageCleanup.js
new file mode 100644
index 0000000..f57ba6f
--- /dev/null
+++ b/test/imageCleanup.js
@@ -0,0 +1,169 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs').promises;
+const path = require('path');
+const nconf = require('nconf');
+
+const db = require('./mocks/databasemock');
+const groups = require('../src/groups');
+const user = require('../src/user');
+const socketUser = require('../src/socket.io/user');
+const plugins = require('../src/plugins');
+
+describe('local cover and avatar cleanup', () => {
+	let nextUser = 0;
+	let createdPaths = [];
+
+	async function putFile(folder, filename) {
+		const filePath = path.join(nconf.get('upload_path'), folder, filename);
+		await fs.mkdir(path.dirname(filePath), { recursive: true });
+		await fs.writeFile(filePath, 'image');
+		createdPaths.push(filePath);
+		return filePath;
+	}
+
+	async function missing(filePath) {
+		await assert.rejects(fs.access(filePath), { code: 'ENOENT' });
+	}
+
+	async function createUser() {
+		nextUser += 1;
+		return await user.create({ username: `image-cleanup-${nextUser}` });
+	}
+
+	afterEach(async () => {
+		await Promise.all(createdPaths.map(async (filePath) => {
+			try {
+				await fs.unlink(filePath);
+			} catch (err) {
+				if (err.code !== 'ENOENT') {
+					throw err;
+				}
+			}
+		}));
+		createdPaths = [];
+	});
+
+	it('removes local group cover and thumbnail, but leaves paths outside uploads/files alone', async () => {
+		const groupName = 'image-cleanup-group';
+		const cover = await putFile('files', `groupCover-${groupName}.png`);
+		const thumb = await putFile('files', `groupCoverThumb-${groupName}.jpg`);
+		const oldCover = await putFile('files', `groupCover-${groupName}.bmp`);
+		const oldThumb = await putFile('files', `groupCoverThumb-${groupName}.jpeg`);
+		const other = await putFile('profile', 'group-cover-sentinel.png');
+		await db.setObject(`group:${groupName}`, {
+			'cover:url': `/assets/uploads/files/${path.basename(cover)}`,
+			'cover:thumb:url': `/assets/uploads/files/${path.basename(thumb)}`,
+			'cover:position': '50% 50%',
+		});
+
+		await groups.removeCover({ groupName });
+		await Promise.all([cover, thumb, oldCover, oldThumb].map(missing));
+		assert.deepStrictEqual(await db.getObjectFields(`group:${groupName}`, [
+			'cover:url', 'cover:thumb:url', 'cover:position',
+		]), { 'cover:url': null, 'cover:thumb:url': null, 'cover:position': null });
+
+		await db.setObject(`group:${groupName}`, {
+			'cover:url': `/assets/uploads/files/../profile/${path.basename(other)}`,
+			'cover:thumb:url': 'https://example.org/remote.jpg',
+		});
+		await groups.removeCover({ groupName });
+		await fs.access(other);
+
+		await db.setObjectField(`group:${groupName}`, 'cover:url',
+			`/assets/uploads/files/groupCover-${groupName}.png`);
+		await groups.removeCover({ groupName });
+	});
+
+	it('removes every local user cover variant and fires the cover removal hook', async () => {
+		const uid = await createUser();
+		const names = [
+			`${uid}-profilecover.png`,
+			`${uid}-profilecover-1.jpeg`,
+			`${uid}-profilecover-2.jpg`,
+			`${uid}-profilecover-3.bmp`,
+		];
+		const files = await Promise.all(names.map(name => putFile('profile', name)));
+		await user.setUserFields(uid, {
+			'cover:url': `/assets/uploads/profile/${names[0]}`,
+			'cover:position': '40% 60%',
+		});
+		assert(files.includes(await user.getLocalCoverPath(uid)));
+		let hookData;
+		const onRemove = (data) => { hookData = data; };
+		plugins.hooks.register('image-cleanup-test', { hook: 'action:user.removeCoverPicture', method: onRemove });
+		try {
+			await assert.rejects(socketUser.removeCover({ uid }, { uid: '../bad' }), /invalid-data/);
+			await socketUser.removeCover({ uid }, { uid });
+		} finally {
+			plugins.hooks.unregister('image-cleanup-test', 'action:user.removeCoverPicture', onRemove);
+		}
+		await Promise.all(files.map(missing));
+		assert.strictEqual(await user.getLocalCoverPath(uid), false);
+		assert.strictEqual(await db.getObjectField(`user:${uid}`, 'cover:url'), null);
+		assert.strictEqual(await db.getObjectField(`user:${uid}`, 'cover:position'), null);
+		assert.strictEqual(hookData.uid, uid);
+		assert.strictEqual(hookData.user['cover:url'], `/assets/uploads/profile/${names[0]}`);
+	});
+
+	it('returns prior avatar fields and preserves a separately selected picture', async () => {
+		const uid = await createUser();
+		const names = [
+			`${uid}-profileavatar.png`,
+			`${uid}-profileavatar-1.jpeg`,
+			`${uid}-profileavatar-2.jpg`,
+			`${uid}-profileavatar-3.bmp`,
+		];
+		const files = await Promise.all(names.map(name => putFile('profile', name)));
+		const uploadedpicture = `/assets/uploads/profile/${names[0]}`;
+		const picture = 'https://example.org/avatar.png';
+		await user.setUserFields(uid, { uploadedpicture, picture });
+		assert(files.includes(await user.getLocalAvatarPath(uid)));
+
+		assert.deepStrictEqual(await user.removeProfileImage(uid), { uploadedpicture, picture });
+		await Promise.all(files.map(missing));
+		assert.strictEqual(await user.getLocalAvatarPath(uid), false);
+		assert.strictEqual(await db.getObjectField(`user:${uid}`, 'uploadedpicture'), '');
+		assert.strictEqual(await db.getObjectField(`user:${uid}`, 'picture'), picture);
+
+		const other = await putFile('files', `image-cleanup-${uid}-sentinel.png`);
+		await user.setUserField(uid, 'uploadedpicture',
+			`/assets/uploads/profile/../files/${path.basename(other)}`);
+		await user.removeProfileImage(uid);
+		await fs.access(other);
+	});
+
+	it('removes the selected avatar through the socket and fires the avatar removal hook', async () => {
+		const uid = await createUser();
+		const filename = `${uid}-profileavatar-123.jpg`;
+		const localPath = await putFile('profile', filename);
+		const uploadedpicture = `/assets/uploads/profile/${filename}`;
+		await user.setUserFields(uid, { uploadedpicture, picture: uploadedpicture });
+		let hookData;
+		const onRemove = (data) => { hookData = data; };
+		plugins.hooks.register('image-cleanup-test', { hook: 'action:user.removeUploadedPicture', method: onRemove });
+		try {
+			await socketUser.removeUploadedPicture({ uid }, { uid });
+		} finally {
+			plugins.hooks.unregister('image-cleanup-test', 'action:user.removeUploadedPicture', onRemove);
+		}
+		await missing(localPath);
+		assert.strictEqual(await db.getObjectField(`user:${uid}`, 'uploadedpicture'), '');
+		assert.strictEqual(await db.getObjectField(`user:${uid}`, 'picture'), '');
+		assert.strictEqual(hookData.uid, uid);
+		assert.strictEqual(hookData.user.uploadedpicture, nconf.get('relative_path') + uploadedpicture);
+	});
+
+	it('removes cover and avatar variants on account deletion even without image fields', async () => {
+		const uid = await createUser();
+		const files = await Promise.all(['cover', 'avatar'].flatMap(type => [
+			`${uid}-profile${type}.png`,
+			`${uid}-profile${type}-1.jpeg`,
+			`${uid}-profile${type}-2.jpg`,
+			`${uid}-profile${type}-3.bmp`,
+		].map(name => putFile('profile', name))));
+		await user.deleteAccount(uid);
+		await Promise.all(files.map(missing));
+	});
+});
