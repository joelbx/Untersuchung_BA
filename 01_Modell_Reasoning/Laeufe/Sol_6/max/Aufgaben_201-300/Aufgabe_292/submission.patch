diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..ac33b26
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,117 @@
+package fs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan context.Context, 1)
+	release := make(chan struct{})
+	poller := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		started <- ctx
+		<-release
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	t.Cleanup(func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+		require.NoError(t, poller.Close())
+	})
+
+	stopped := make(chan struct{})
+	go func() {
+		poller.Poll()
+		close(stopped)
+	}()
+
+	var updateCtx context.Context
+	select {
+	case updateCtx = <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("poller did not start an update")
+	}
+
+	closed := make(chan error, 2)
+	go func() { closed <- poller.Close() }()
+	go func() { closed <- poller.Close() }()
+
+	select {
+	case <-updateCtx.Done():
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not cancel the update context")
+	}
+
+	select {
+	case <-closed:
+		t.Fatal("close returned before the update finished")
+	default:
+	}
+
+	close(release)
+	for i := 0; i < 2; i++ {
+		select {
+		case err := <-closed:
+			require.NoError(t, err)
+		case <-time.After(5 * time.Second):
+			t.Fatal("close did not wait for the poller")
+		}
+	}
+	select {
+	case <-stopped:
+	case <-time.After(5 * time.Second):
+		t.Fatal("poller still running after close")
+	}
+}
+
+func TestPollerCloseBeforePoll(t *testing.T) {
+	called := make(chan struct{}, 1)
+	poller := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		called <- struct{}{}
+		return false, nil
+	})
+
+	closed := make(chan error, 1)
+	go func() { closed <- poller.Close() }()
+	select {
+	case err := <-closed:
+		require.NoError(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("close blocked before polling started")
+	}
+
+	poller.Poll()
+	require.NoError(t, poller.Close())
+	select {
+	case <-called:
+		t.Fatal("update called after close")
+	default:
+	}
+}
+
+func TestPollerStopsWithParentContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	poller := NewPoller(ctx, zap.NewNop(), func(context.Context) (bool, error) {
+		return false, nil
+	})
+	stopped := make(chan struct{})
+	go func() {
+		poller.Poll()
+		close(stopped)
+	}()
+
+	cancel()
+	select {
+	case <-stopped:
+	case <-time.After(5 * time.Second):
+		t.Fatal("poller ignored parent cancellation")
+	}
+	require.NoError(t, poller.Close())
+}
