+func TestCheckerTokenEvents(t *testing.T) {
+	testCases := []struct {
+		name        string
+		events      []string
+		wantCreated bool
+		wantDeleted bool
+	}{
+		{name: "create only", events: []string{"token:created"}, wantCreated: true},
+		{name: "delete only", events: []string{"token:deleted"}, wantDeleted: true},
+		{name: "token wildcard", events: []string{"token:*"}, wantCreated: true, wantDeleted: true},
+		{name: "created wildcard", events: []string{"*:created"}, wantCreated: true},
+		{name: "deleted wildcard", events: []string{"*:deleted"}, wantDeleted: true},
+		{name: "all events", events: []string{"*:*"}, wantCreated: true, wantDeleted: true},
+		{name: "unrelated event", events: []string{"flag:deleted"}},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			checker, err := NewChecker(tc.events)
+			require.NoError(t, err)
+			assert.Equal(t, tc.wantCreated, checker.Check("token:created"))
+			assert.Equal(t, tc.wantDeleted, checker.Check("token:deleted"))
+		})
+	}
+}
