+
+func TestDeleteAuthenticationTokenAudit(t *testing.T) {
+	testCases := []struct {
+		name         string
+		method       rpcauth.Method
+		auditEnabled bool
+		failDelete   bool
+		wantEvent    bool
+	}{
+		{name: "token deletion enabled", method: rpcauth.Method_METHOD_TOKEN, auditEnabled: true, wantEvent: true},
+		{name: "token deletion disabled", method: rpcauth.Method_METHOD_TOKEN},
+		{name: "other authentication method", method: rpcauth.Method_METHOD_OIDC, auditEnabled: true},
+		{name: "failed token deletion", method: rpcauth.Method_METHOD_TOKEN, auditEnabled: true, failDelete: true},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			store := memory.NewStore()
+			_, authentication, err := store.CreateAuthentication(ctx, &storageauth.CreateAuthenticationRequest{
+				Method:   tc.method,
+				Metadata: map[string]string{"name": "test-token"},
+			})
+			require.NoError(t, err)
+
+			var authStore storageauth.Store = store
+			if tc.failDelete {
+				authStore = failingDeleteStore{Store: store}
+			}
+
+			sink := &tokenAuditSink{}
+			exporter := audit.NewSinkSpanExporter(zaptest.NewLogger(t), []audit.Sink{sink})
+			tp := sdktrace.NewTracerProvider(sdktrace.WithSampler(sdktrace.AlwaysSample()))
+			tp.RegisterSpanProcessor(sdktrace.NewSimpleSpanProcessor(exporter))
+
+			ctx, span := tp.Tracer("auth-test").Start(ctx, "delete-authentication")
+			_, err = auth.NewServer(zaptest.NewLogger(t), authStore, auth.WithAuditLoggingEnabled(tc.auditEnabled)).
+				DeleteAuthentication(ctx, &rpcauth.DeleteAuthenticationRequest{Id: authentication.Id})
+			span.End()
+			require.NoError(t, tp.Shutdown(context.Background()))
+
+			if tc.failDelete {
+				require.ErrorContains(t, err, "delete failed")
+			} else {
+				require.NoError(t, err)
+				_, err = store.GetAuthenticationByID(ctx, authentication.Id)
+				var notFound errors.ErrNotFound
+				require.ErrorAs(t, err, &notFound)
+			}
+
+			if tc.wantEvent {
+				require.Len(t, sink.events, 1)
+				require.Equal(t, audit.TokenType, sink.events[0].Type)
+				require.Equal(t, audit.Delete, sink.events[0].Action)
+				require.Equal(t, map[string]interface{}{"name": "test-token"}, sink.events[0].Payload)
+			} else {
+				require.Empty(t, sink.events)
+			}
+		})
+	}
+}
