+@pytest.mark.parametrize('query', ['foo OR bar', '(foo)', 'NOT foo'])
+def test_luqum_replace_child(query: str):
+    parent = luqum_parser(query)
+    original_children = parent.children
+    new_child = luqum_parser('baz')
+
+    luqum_replace_child(parent, original_children[0], new_child)
+
+    assert type(parent.children) is type(original_children)
+    assert parent.children[0] is new_child
+    assert parent.children[1:] == original_children[1:]
+
+
+def test_luqum_replace_child_replaces_all_matches_and_leaves_other_children():
+    parent = luqum_parser('foo OR bar')
+    old_child, other_child = parent.children
+    parent.children = (old_child, old_child, other_child)
+    new_child = luqum_parser('baz')
+
+    luqum_replace_child(parent, old_child, new_child)
+
+    assert parent.children[0] is new_child
+    assert parent.children[1] is new_child
+    assert parent.children[2] is other_child
+
+
+def test_luqum_replace_child_with_missing_child_leaves_children_unchanged():
+    parent = luqum_parser('foo OR bar')
+    children = parent.children
+
+    luqum_replace_child(parent, luqum_parser('missing'), luqum_parser('baz'))
+
+    assert parent.children is children
+
+
+def test_luqum_replace_child_rejects_unsupported_parent():
+    word = luqum_parser('foo')
+
+    with pytest.raises(ValueError, match='^Not supported for generic class Item$'):
+        luqum_replace_child(word, word, luqum_parser('baz'))
+
+
 def test_luqum_parser():
