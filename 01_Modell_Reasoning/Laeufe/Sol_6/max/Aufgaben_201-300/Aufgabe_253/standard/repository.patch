+def test_same_text_from_different_streams(view):
+    """Identical stdout and stderr content must keep their own severity."""
+    view.show_message(usertypes.MessageLevel.info, 'test', replace='stdout-1')
+    view.show_message(usertypes.MessageLevel.error, 'test', replace='stderr-1')
+
+    assert [(msg.level, msg.text()) for msg in view._messages] == [
+        (usertypes.MessageLevel.info, 'test'),
+        (usertypes.MessageLevel.error, 'test'),
+    ]
+
