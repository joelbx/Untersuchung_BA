+func TestRequireLocalAgentForConn(t *testing.T) {
+	srv := &server{localSite: &localSite{domainName: "local-cluster"}}
+	tests := []struct {
+		name        string
+		clusterName string
+		connType    types.TunnelType
+		wantErr     bool
+		wantText    []string
+	}{
+		{name: "empty cluster", connType: types.NodeTunnel, wantErr: true, wantText: []string{"empty cluster name"}},
+		{name: "whitespace cluster", clusterName: " \t", connType: types.AppTunnel, wantErr: true, wantText: []string{"empty cluster name"}},
+		{name: "other cluster", clusterName: "other-cluster", connType: types.KubeTunnel, wantErr: true, wantText: []string{"other-cluster", string(types.KubeTunnel)}},
+		{name: "local cluster", clusterName: "local-cluster", connType: types.NodeTunnel},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := srv.requireLocalAgentForConn(tt.clusterName, tt.connType)
+			if !tt.wantErr {
+				require.NoError(t, err)
+				return
+			}
+			require.True(t, trace.IsBadParameter(err), "error: %v", err)
+			for _, part := range tt.wantText {
+				require.ErrorContains(t, err, part)
+			}
+		})
+	}
+}
