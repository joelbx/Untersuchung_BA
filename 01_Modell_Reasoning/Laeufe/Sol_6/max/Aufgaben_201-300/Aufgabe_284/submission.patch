+func TestServerUsesSingleLocalSite(t *testing.T) {
+	srv := &server{Config: Config{ID: "proxy"}}
+	site := &localSite{
+		srv:         srv,
+		domainName:  "local-cluster",
+		remoteConns: make(map[connKey][]*remoteConn),
+	}
+	srv.localSite = site
+	sconn := &ssh.ServerConn{Permissions: &ssh.Permissions{Extensions: map[string]string{
+		extAuthority: "other-cluster",
+		extHost:      "node-id",
+	}}}
+	gotSite, gotConn, err := srv.upsertServiceConn(mockRemoteConnConn{}, sconn, types.NodeTunnel)
+	require.True(t, trace.IsBadParameter(err), "error: %v", err)
+	require.Nil(t, gotSite)
+	require.Nil(t, gotConn)
+	require.Empty(t, site.remoteConns)
+
+	sconn.Permissions.Extensions[extAuthority] = site.domainName
+	gotSite, gotConn, err = srv.upsertServiceConn(mockRemoteConnConn{}, sconn, types.NodeTunnel)
+	require.NoError(t, err)
+	require.Same(t, site, gotSite)
+	require.Equal(t, []*remoteConn{gotConn}, site.remoteConns[connKey{uuid: "node-id", connType: types.NodeTunnel}])
+
+	sites, err := srv.GetSites()
+	require.NoError(t, err)
+	require.Equal(t, []RemoteSite{site}, sites)
+	got, err := srv.GetSite(site.domainName)
+	require.NoError(t, err)
+	require.Same(t, site, got)
+
+	srv.fanOutProxies(nil)
+	require.Len(t, gotConn.newProxiesC, 1)
+
+	require.NoError(t, srv.onSiteTunnelClose(&alwaysClose{RemoteSite: site}))
+	require.Same(t, site, srv.localSite)
+}
