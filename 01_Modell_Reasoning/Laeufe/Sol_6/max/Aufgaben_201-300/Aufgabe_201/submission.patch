new file mode 100644
index 0000000..71cae65
--- /dev/null
+++ b/internal/ext/common_test.go
@@ -0,0 +1,92 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	yamlv2 "gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestSegmentEmbedYAML(t *testing.T) {
+	cases := []struct {
+		name     string
+		input    string
+		keys     []string
+		operator string
+		invalid  bool
+	}{
+		{name: "string", input: "segment: foo", keys: []string{"foo"}, operator: "OR_SEGMENT_OPERATOR"},
+		{name: "single object", input: "segment: {keys: [foo], operator: AND_SEGMENT_OPERATOR}", keys: []string{"foo"}, operator: "OR_SEGMENT_OPERATOR"},
+		{name: "single object ignores operator value", input: "segment: {keys: [foo], operator: UNKNOWN}", keys: []string{"foo"}, operator: "OR_SEGMENT_OPERATOR"},
+		{name: "multiple object", input: "segment: {keys: [foo, bar], operator: AND_SEGMENT_OPERATOR}", keys: []string{"foo", "bar"}, operator: "AND_SEGMENT_OPERATOR"},
+		{name: "missing", input: "rank: 1", invalid: true},
+		{name: "null", input: "segment: null", invalid: true},
+		{name: "number", input: "segment: 42", invalid: true},
+		{name: "list", input: "segment: [foo, bar]", invalid: true},
+		{name: "empty string", input: "segment: ''", invalid: true},
+		{name: "empty keys", input: "segment: {keys: [], operator: AND_SEGMENT_OPERATOR}", invalid: true},
+		{name: "missing operator", input: "segment: {keys: [foo]}", invalid: true},
+		{name: "missing keys", input: "segment: {operator: AND_SEGMENT_OPERATOR}", invalid: true},
+		{name: "extra field", input: "segment: {keys: [foo], operator: OR_SEGMENT_OPERATOR, other: bar}", invalid: true},
+		{name: "non-string key", input: "segment: {keys: [42], operator: OR_SEGMENT_OPERATOR}", invalid: true},
+		{name: "invalid multi operator", input: "segment: {keys: [foo, bar], operator: XOR}", invalid: true},
+	}
+
+	for _, decoder := range []struct {
+		name      string
+		unmarshal func([]byte, interface{}) error
+	}{
+		{name: "yaml.v2", unmarshal: yamlv2.Unmarshal},
+		{name: "yaml.v3", unmarshal: yamlv3.Unmarshal},
+	} {
+		t.Run(decoder.name, func(t *testing.T) {
+			for _, tc := range cases {
+				t.Run(tc.name, func(t *testing.T) {
+					var rule Rule
+					err := decoder.unmarshal([]byte(tc.input), &rule)
+					if tc.invalid {
+						if err == nil {
+							_, _, err = rule.Segment.KeysAndOperator()
+						}
+						require.Error(t, err)
+						return
+					}
+					require.NoError(t, err)
+					keys, operator, err := rule.Segment.KeysAndOperator()
+					require.NoError(t, err)
+					assert.Equal(t, tc.keys, keys)
+					assert.Equal(t, tc.operator, operator)
+					if tc.name == "single object" {
+						assert.Equal(t, "OR_SEGMENT_OPERATOR", rule.Segment.IsSegment.(Segments).SegmentOperator)
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestSegmentEmbedMarshalYAML(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		segment *SegmentEmbed
+		want    string
+		invalid bool
+	}{
+		{name: "string", segment: &SegmentEmbed{IsSegment: SegmentKey("foo")}, want: "segment: foo"},
+		{name: "object", segment: &SegmentEmbed{IsSegment: Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}}, want: "segment: {keys: [foo, bar], operator: AND_SEGMENT_OPERATOR}"},
+		{name: "single object normalizes operator", segment: &SegmentEmbed{IsSegment: Segments{Keys: []string{"foo"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}}, want: "segment: {keys: [foo], operator: OR_SEGMENT_OPERATOR}"},
+		{name: "invalid", segment: &SegmentEmbed{}, invalid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := yamlv2.Marshal(&Rule{Segment: tc.segment})
+			if tc.invalid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.YAMLEq(t, tc.want, string(got))
+		})
+	}
+}
