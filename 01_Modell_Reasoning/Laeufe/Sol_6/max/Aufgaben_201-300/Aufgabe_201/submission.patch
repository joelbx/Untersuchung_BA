+func TestSnapshotRuleSegmentFormats(t *testing.T) {
+	doc := `flags:
+- key: flag1
+  name: flag1
+  enabled: true
+  rules:
+  - segment: foo
+  - segment: {keys: [foo], operator: AND_SEGMENT_OPERATOR}
+  - segment: {keys: [foo, bar], operator: AND_SEGMENT_OPERATOR}
+  rollouts:
+  - segment: {keys: [foo], operator: AND_SEGMENT_OPERATOR, value: true}
+segments:
+- key: foo
+- key: bar
+`
+	ss, err := snapshotFromReaders(strings.NewReader(doc))
+	require.NoError(t, err)
+
+	rules, err := ss.ListRules(context.Background(), "default", "flag1")
+	require.NoError(t, err)
+	require.Len(t, rules.Results, 3)
