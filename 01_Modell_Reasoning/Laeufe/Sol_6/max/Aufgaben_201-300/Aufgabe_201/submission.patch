+	assert.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rules.Results[0].SegmentOperator)
+	assert.Equal(t, "foo", rules.Results[1].SegmentKey)
+	assert.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rules.Results[1].SegmentOperator)
+	assert.Equal(t, []string{"foo", "bar"}, rules.Results[2].SegmentKeys)
+	assert.Equal(t, flipt.SegmentOperator_AND_SEGMENT_OPERATOR, rules.Results[2].SegmentOperator)
+
+	evalRules, err := ss.GetEvaluationRules(context.Background(), "default", "flag1")
+	require.NoError(t, err)
+	require.Len(t, evalRules, 3)
+	assert.Len(t, evalRules[2].Segments, 2)
+	assert.Equal(t, flipt.SegmentOperator_AND_SEGMENT_OPERATOR, evalRules[2].SegmentOperator)
+
+	rollouts, err := ss.ListRollouts(context.Background(), "default", "flag1")
+	require.NoError(t, err)
+	require.Len(t, rollouts.Results, 1)
+	assert.Equal(t, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, rollouts.Results[0].GetSegment().SegmentOperator)
+}
