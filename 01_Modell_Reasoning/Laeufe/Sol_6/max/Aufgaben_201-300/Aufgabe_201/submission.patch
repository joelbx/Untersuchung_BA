 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,152 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment represents either a single segment key or a group of keys.
+type IsSegment interface {
+	isSegment()
+}
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+// SegmentEmbed allows a rule's segment to be a scalar or a mapping in YAML.
+type SegmentEmbed struct {
+	IsSegment
+}
+
+// KeysAndOperator returns the normalized segment keys and operator. A single
+// key always uses OR, including when supplied in the mapping form.
+func (s *SegmentEmbed) KeysAndOperator() ([]string, string, error) {
+	if s == nil {
+		return nil, "", fmt.Errorf("rule segment is required")
+	}
+
+	switch value := s.IsSegment.(type) {
+	case SegmentKey:
+		if value == "" {
+			return nil, "", fmt.Errorf("rule segment key is required")
+		}
+		return []string{string(value)}, "OR_SEGMENT_OPERATOR", nil
+	case *SegmentKey:
+		if value != nil {
+			return (&SegmentEmbed{IsSegment: *value}).KeysAndOperator()
+		}
+	case Segments:
+		if len(value.Keys) == 0 {
+			return nil, "", fmt.Errorf("rule segment keys are required")
+		}
+		for _, key := range value.Keys {
+			if key == "" {
+				return nil, "", fmt.Errorf("rule segment keys cannot be empty")
+			}
+		}
+		if len(value.Keys) == 1 {
+			return value.Keys, "OR_SEGMENT_OPERATOR", nil
+		}
+		if value.SegmentOperator != "OR_SEGMENT_OPERATOR" && value.SegmentOperator != "AND_SEGMENT_OPERATOR" {
+			return nil, "", fmt.Errorf("invalid rule segment operator %q", value.SegmentOperator)
+		}
+		return value.Keys, value.SegmentOperator, nil
+	case *Segments:
+		if value != nil {
+			return (&SegmentEmbed{IsSegment: *value}).KeysAndOperator()
+		}
+	}
+
+	return nil, "", fmt.Errorf("invalid rule segment type %T", s.IsSegment)
+}
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	keys, operator, err := s.KeysAndOperator()
+	if err != nil {
+		return nil, err
+	}
+
+	switch s.IsSegment.(type) {
+	case SegmentKey, *SegmentKey:
+		return keys[0], nil
+	case Segments, *Segments:
+		return Segments{Keys: keys, SegmentOperator: operator}, nil
+	default:
+		return nil, fmt.Errorf("invalid rule segment type %T", s.IsSegment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+
+	switch value := raw.(type) {
+	case string:
+		s.IsSegment = SegmentKey(value)
+	case map[interface{}]interface{}:
+		if err := s.unmarshalSegmentMap(value); err != nil {
+			return err
+		}
+	case map[string]interface{}:
+		mapping := make(map[interface{}]interface{}, len(value))
+		for key, item := range value {
+			mapping[key] = item
+		}
+		if err := s.unmarshalSegmentMap(mapping); err != nil {
+			return err
+		}
+	default:
+		return fmt.Errorf("rule segment must be a string or a keys/operator object, got %T", raw)
+	}
+
+	_, _, err := s.KeysAndOperator()
+	return err
+}
+
+func (s *SegmentEmbed) unmarshalSegmentMap(mapping map[interface{}]interface{}) error {
+	if len(mapping) != 2 {
+		return fmt.Errorf("rule segment object must contain keys and operator")
+	}
+	for key := range mapping {
+		if key != "keys" && key != "operator" {
+			return fmt.Errorf("unsupported rule segment field %v", key)
+		}
+	}
+
+	rawKeys, ok := mapping["keys"].([]interface{})
+	if !ok {
+		return fmt.Errorf("rule segment keys must be a list of strings")
+	}
+	operator, ok := mapping["operator"].(string)
+	if !ok {
+		return fmt.Errorf("rule segment operator must be a string")
+	}
+
+	keys := make([]string, 0, len(rawKeys))
+	for _, key := range rawKeys {
+		value, ok := key.(string)
+		if !ok {
+			return fmt.Errorf("rule segment keys must be a list of strings")
+		}
+		keys = append(keys, value)
+	}
+	if len(keys) == 1 {
+		operator = "OR_SEGMENT_OPERATOR"
+	}
+
+	s.IsSegment = Segments{Keys: keys, SegmentOperator: operator}
+	return nil
 }
 
