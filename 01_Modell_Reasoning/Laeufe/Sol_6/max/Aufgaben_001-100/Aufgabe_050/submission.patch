+package persistence
+
+import (
+	"context"
+	"time"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/utils/gg"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("ShareRepository", func() {
+	It("loads a share with unset expiration and visit timestamps", func() {
+		repo := NewShareRepository(context.Background(), getDBXBuilder()).(*shareRepository)
+		share := &model.Share{ID: "nullable-share-test", UserID: "userid", ResourceIDs: "103", ResourceType: "album"}
+		_, err := repo.Save(share)
+		Expect(err).ToNot(HaveOccurred())
+		DeferCleanup(func() { Expect(repo.Delete(share.ID)).To(Succeed()) })
+
+		loaded, err := repo.Get(share.ID)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(loaded.ExpiresAt).To(BeNil())
+		Expect(loaded.LastVisitedAt).To(BeNil())
+		Expect(gg.V(loaded.ExpiresAt)).To(Equal(time.Time{}))
+		Expect(gg.V(loaded.LastVisitedAt)).To(Equal(time.Time{}))
+	})
+
+	It("round trips present expiration and visit timestamps", func() {
+		repo := NewShareRepository(context.Background(), getDBXBuilder()).(*shareRepository)
+		expiresAt := time.Date(2027, time.January, 2, 3, 4, 5, 0, time.UTC)
+		visitedAt := time.Date(2026, time.December, 1, 2, 3, 4, 0, time.UTC)
+		share := &model.Share{
+			ID: "dated-share-test", UserID: "userid", ResourceIDs: "103", ResourceType: "album",
+			ExpiresAt: gg.P(expiresAt), LastVisitedAt: gg.P(visitedAt),
+		}
+		_, err := repo.Save(share)
+		Expect(err).ToNot(HaveOccurred())
+		DeferCleanup(func() { Expect(repo.Delete(share.ID)).To(Succeed()) })
+
+		loaded, err := repo.Get(share.ID)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(loaded.ExpiresAt).To(Equal(gg.P(expiresAt)))
+		Expect(loaded.LastVisitedAt).To(Equal(gg.P(visitedAt)))
+	})
+})
