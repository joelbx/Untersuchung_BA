--- /dev/null
+++ b/test/ansible_test/validate-modules-unit/test_validate_modules_date.py
@@ -0,0 +1,27 @@
+"""Tests for date-based module deprecation validation."""
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import pytest
+from voluptuous import MultipleInvalid
+
+from validate_modules.main import parse_removal_date
+from validate_modules.schema import argument_spec_schema
+
+
+def test_date_deprecation_schema():
+    schema = argument_spec_schema()
+    schema({'old': {'removed_at_date': '2030-01-02',
+                    'deprecated_aliases': [{'name': 'previous', 'date': '2031-02-03'}]}})
+    schema({'old': {'deprecated_aliases': [{'name': 'previous', 'version': '3.0'}]}})
+
+    for alias in ({'name': 'previous'},
+                  {'name': 'previous', 'version': '3.0', 'date': '2031-02-03'}):
+        with pytest.raises(MultipleInvalid):
+            schema({'old': {'deprecated_aliases': [alias]}})
+
+
+@pytest.mark.parametrize('value', ['2030-1-02', '2030-02-30', 'not-a-date'])
+def test_invalid_removal_date(value):
+    with pytest.raises(ValueError):
+        parse_removal_date(value)
