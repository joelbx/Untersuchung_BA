+func TestIsCveInfoUpdatedUbuntuAPI(t *testing.T) {
+	const cveID = "CVE-2024-0001"
+	previous := models.ScanResult{
+		Family: "ubuntu",
+		ScannedCves: models.VulnInfos{cveID: {
+			CveContents: models.NewCveContents(models.CveContent{
+				Type: models.UbuntuAPI, LastModified: time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC),
+			}),
+		}},
+	}
+	current := models.ScanResult{
+		Family: "ubuntu",
+		ScannedCves: models.VulnInfos{cveID: {
+			CveContents: models.NewCveContents(models.CveContent{
+				Type: models.UbuntuAPI, LastModified: time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC),
+			}),
+		}},
+	}
+	if !isCveInfoUpdated(cveID, previous, current) {
+		t.Fatal("Ubuntu API content change was not detected")
+	}
+}
