+def test_check_qt_available_success(stubs, monkeypatch):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.fake,
+    )
+    stubs.ImportFake({
+        "PyQt5.QtCore": True,
+        "PyQt5.QtWidgets": True,
+    }, monkeypatch).patch()
+
+    assert earlyinit.check_qt_available(info) is None
+
+
+def test_check_qt_available_no_importable_binding(stubs, monkeypatch):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.default,
+    )
+    modules = {
+        "PyQt5.QtCore": False,
+        "PyQt6": False,
+        "PyQt5": False,
+    }
+    stubs.ImportFake(modules, monkeypatch).patch()
+
+    with pytest.raises(machinery.NoWrapperAvailableError) as excinfo:
+        earlyinit.check_qt_available(info)
+
+    assert excinfo.value.info is info
+    assert info.pyqt5 == "ImportError: Fake ImportError for PyQt5."
+    assert info.pyqt6 == "ImportError: Fake ImportError for PyQt6."
+    assert "PyQt5: ImportError:" in str(excinfo.value)
+    assert "PyQt6: ImportError:" in str(excinfo.value)
+
+
+def test_check_qt_available_selected_binding_missing(stubs, monkeypatch, capsys):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.cli,
+    )
+    stubs.ImportFake({"PyQt5.QtCore": False, "PyQt6": True}, monkeypatch).patch()
+    monkeypatch.setattr(earlyinit, "tkinter", None)
+
+    with pytest.raises(SystemExit, match="1"):
+        earlyinit.check_qt_available(info)
