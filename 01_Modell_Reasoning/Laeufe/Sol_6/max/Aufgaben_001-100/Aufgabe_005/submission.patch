+
+def test_early_init_passes_selection_info(monkeypatch):
+    info = machinery.SelectionInfo(
+        wrapper="PyQt5", reason=machinery.SelectionReason.fake,
+    )
+    args = object()
+    calls = []
+    monkeypatch.setattr(earlyinit, "init_faulthandler", lambda: calls.append("fault"))
+
+    def init_wrapper(received_args):
+        assert received_args is args
+        calls.append("wrapper")
+        return info
+
+    def check_wrapper(received_info):
+        assert received_info is info
+        calls.append("check")
+        raise RuntimeError("stop after Qt availability check")
+
+    monkeypatch.setattr(machinery, "init", init_wrapper)
+    monkeypatch.setattr(earlyinit, "check_qt_available", check_wrapper)
+
+    with pytest.raises(RuntimeError, match="stop after Qt availability check"):
+        earlyinit.early_init(args)
