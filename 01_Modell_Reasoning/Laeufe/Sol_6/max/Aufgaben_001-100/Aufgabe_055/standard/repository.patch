+func TestIsPkgCvesDetactable(t *testing.T) {
+	base := models.ScanResult{
+		Family:   constant.Debian,
+		Release:  "11",
+		Packages: models.Packages{"apt": {Name: "apt"}},
+	}
+	cases := []struct {
+		name   string
+		change func(*models.ScanResult)
+		want   bool
+	}{
+		{name: "supported OS and packages", want: true},
+		{name: "source packages only", change: func(r *models.ScanResult) {
+			r.Packages = nil
+			r.SrcPackages = models.SrcPackages{"apt": {Name: "apt"}}
+		}, want: true},
+		{name: "missing family", change: func(r *models.ScanResult) { r.Family = "" }},
+		{name: "missing version", change: func(r *models.ScanResult) { r.Release = "" }},
+		{name: "no packages", change: func(r *models.ScanResult) { r.Packages = nil }},
+		{name: "Trivy result", change: func(r *models.ScanResult) { r.ScannedBy = "trivy" }},
+		{name: "FreeBSD", change: func(r *models.ScanResult) { r.Family = constant.FreeBSD }},
+		{name: "Raspbian", change: func(r *models.ScanResult) { r.Family = constant.Raspbian }},
+		{name: "pseudo", change: func(r *models.ScanResult) { r.Family = constant.ServerTypePseudo }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r := base
+			if tc.change != nil {
+				tc.change(&r)
+			}
+			if got := isPkgCvesDetactable(&r); got != tc.want {
+				t.Errorf("isPkgCvesDetactable() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
