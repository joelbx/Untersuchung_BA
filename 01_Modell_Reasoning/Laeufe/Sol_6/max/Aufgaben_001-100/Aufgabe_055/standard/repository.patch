+func TestTrivyPkgCvesAreReusedWithoutDBDetection(t *testing.T) {
+	r := models.ScanResult{
+		Family:    constant.Debian,
+		Release:   "11",
+		ScannedBy: "trivy",
+		Packages:  models.Packages{"apt": {Name: "apt"}},
+		ScannedCves: models.VulnInfos{
+			"CVE-2020-0001": {CveID: "CVE-2020-0001"},
+		},
+	}
+	if !reuseScannedCves(&r) {
+		t.Fatal("Trivy CVEs should be reused when Optional is nil")
+	}
+	if err := DetectPkgCves(&r, config.GovalDictConf{}, config.GostConf{}, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := r.ScannedCves["CVE-2020-0001"]; !ok {
+		t.Error("Trivy CVE was discarded")
+	}
+
+	r.ScannedBy = ""
+	r.Optional = map[string]interface{}{"trivy-target": "old target"}
+	if reuseScannedCves(&r) {
+		t.Error("Optional metadata alone must not identify a Trivy result")
+	}
+}
