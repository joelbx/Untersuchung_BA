+func TestParseMetadataWithoutOSName(t *testing.T) {
+	cases := []struct {
+		name       string
+		report     string
+		serverName string
+		family     string
+	}{
+		{
+			name:       "OS name absent",
+			report:     `{"ArtifactName":"alpine","ArtifactType":"container_image","Metadata":{"OS":{"Family":"alpine"}},"Results":[{"Type":"alpine"}]}`,
+			serverName: "alpine:latest",
+			family:     "alpine",
+		},
+		{
+			name:       "library only container image",
+			report:     `{"ArtifactName":"library-image","ArtifactType":"container_image","Results":[{"Type":"jar"}]}`,
+			serverName: "library-image:latest",
+			family:     "pseudo",
+		},
+		{
+			name:       "trailing colon has no tag",
+			report:     `{"ArtifactName":"library-image:","ArtifactType":"container_image","Results":[{"Type":"jar"}]}`,
+			serverName: "library-image::latest",
+			family:     "pseudo",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			result, err := ParserV2{}.Parse([]byte(tc.report))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result.ServerName != tc.serverName || result.Family != tc.family || result.Release != "" {
+				t.Errorf("metadata = (%q, %q, %q), want (%q, %q, empty release)", result.ServerName, result.Family, result.Release, tc.serverName, tc.family)
+			}
+			if result.Optional != nil {
+				t.Errorf("Optional = %v, want nil", result.Optional)
+			}
+		})
+	}
+}
