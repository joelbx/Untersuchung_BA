+func TestSplitFileName(t *testing.T) {
+	tests := []struct {
+		filename string
+		name     string
+		version  string
+		release  string
+		wantErr  bool
+	}{
+		{filename: "openssl-1.1.0h-3.fc27.src.rpm", name: "openssl", version: "1.1.0h", release: "3.fc27"},
+		{filename: "1:bar-9-123a.src.rpm", name: "bar", version: "1:9", release: "123a"},
+		{filename: "elasticsearch-8.17.0-1-src.rpm", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			name, version, release, err := splitFileName(tt.filename)
+			if (err != nil) != tt.wantErr || name != tt.name || version != tt.version || release != tt.release {
+				t.Errorf("splitFileName(%q) = (%q, %q, %q, %v), want (%q, %q, %q, err=%v)", tt.filename, name, version, release, err, tt.name, tt.version, tt.release, tt.wantErr)
+			}
 		})
 	}
 }
