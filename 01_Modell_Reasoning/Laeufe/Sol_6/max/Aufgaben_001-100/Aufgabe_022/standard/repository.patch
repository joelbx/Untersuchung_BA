+func rpmVersionWithEpoch(epoch, version string) string {
+	switch epoch {
+	case "0", "(none)":
+		return version
+	default:
+		return fmt.Sprintf("%s:%s", epoch, version)
+	}
+}
+
+func (o *redhatBase) parseSourceRPM(filename, binaryName, binaryEpoch string) *models.SrcPackage {
+	if filename == "(none)" {
+		return nil
+	}
+
+	name, version, release, err := splitFileName(filename)
+	if err != nil {
+		o.warns = append(o.warns, xerrors.Errorf("Failed to parse source rpm file %q: %w", filename, err))
+		return nil
+	}
+	if !strings.Contains(version, ":") {
+		version = rpmVersionWithEpoch(binaryEpoch, version)
+	}
+	return &models.SrcPackage{
+		Name:        name,
+		Version:     fmt.Sprintf("%s-%s", version, release),
+		Arch:        "src",
+		BinaryNames: []string{binaryName},
+	}
+}
+
 // https://github.com/aquasecurity/trivy/blob/51f2123c5ccc4f7a37d1068830b6670b4ccf9ac8/pkg/fanal/analyzer/pkg/rpm/rpm.go#L212-L241
 func splitFileName(filename string) (name, ver, rel string, err error) {
-	filename = strings.TrimSuffix(filename, ".rpm")
+	const expected = "<name>-<version>-<release>.<arch>.rpm"
+	unexpected := func() (string, string, string, error) {
+		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", expected, filename)
+	}
+	if !strings.HasSuffix(filename, ".rpm") {
+		return unexpected()
+	}
+	stem := strings.TrimSuffix(filename, ".rpm")
 
-	archIndex := strings.LastIndex(filename, ".")
-	if archIndex == -1 {
-		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", filename)
+	archIndex := strings.LastIndex(stem, ".")
+	if archIndex <= 0 || archIndex == len(stem)-1 {
+		return unexpected()
 	}
 
-	relIndex := strings.LastIndex(filename[:archIndex], "-")
-	if relIndex == -1 {
-		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", filename)
+	relIndex := strings.LastIndex(stem[:archIndex], "-")
+	if relIndex <= 0 || relIndex == archIndex-1 {
+		return unexpected()
 	}
-	rel = filename[relIndex+1 : archIndex]
+	rel = stem[relIndex+1 : archIndex]
 
-	verIndex := strings.LastIndex(filename[:relIndex], "-")
-	if verIndex == -1 {
-		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", filename)
+	verIndex := strings.LastIndex(stem[:relIndex], "-")
+	if verIndex <= 0 || verIndex == relIndex-1 {
+		return unexpected()
 	}
-	ver = filename[verIndex+1 : relIndex]
+	ver = stem[verIndex+1 : relIndex]
+	name = stem[:verIndex]
 
-	name = filename[:verIndex]
+	if epoch, packageName, ok := strings.Cut(name, ":"); ok {
+		if epoch == "" || packageName == "" {
+			return unexpected()
+		}
+		for _, digit := range epoch {
+			if digit < '0' || digit > '9' {
+				return unexpected()
+			}
+		}
+		name = packageName
+		ver = epoch + ":" + ver
+	}
 	return name, ver, rel, nil
 }
 
