+func Test_redhatBase_parseInstalledPackagesContinuesAfterBadSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{
+		Distro: config.Distro{Family: constant.Alma, Release: "9.0"},
+		log:    logging.NewIODiscardLogger(),
+	}}
+	bins, srcs, err := o.parseInstalledPackages(`elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)
+bar 1 9 123a ia64 1:bar-9-123a.src.rpm`)
+	if err != nil {
+		t.Fatalf("parseInstalledPackages() error = %v", err)
+	}
+	if len(bins) != 2 || bins["elasticsearch"].Version != "8.17.0" || bins["bar"].Version != "1:9" {
+		t.Errorf("parseInstalledPackages() binary packages = %v", bins)
+	}
+	if len(srcs) != 1 || srcs["bar"].Version != "1:9-123a" || !reflect.DeepEqual(srcs["bar"].BinaryNames, []string{"bar"}) {
+		t.Errorf("parseInstalledPackages() source packages = %v", srcs)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("parseInstalledPackages() warnings = %v, want source filename warning", o.warns)
+	}
+}
