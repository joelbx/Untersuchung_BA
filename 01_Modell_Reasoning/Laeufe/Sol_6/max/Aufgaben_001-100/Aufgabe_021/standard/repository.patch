+def test_membership_uses_normalized_keys():
+    models.register_models()
+    list_model.register_models()
+    site = MockSite()
+    author = site.quicksave('/authors/OL1A', '/type/author', name='Example')
+    lst = site.quicksave('/people/test/lists/OL1L', '/type/list', name='Test', seeds=[])
+
+    assert lst.add_seed(author)
+    assert not lst.add_seed({'key': author.key})
+    assert lst.has_seed({'key': author.key})
+    assert lst.remove_seed({'key': author.key})
+    assert not lst.remove_seed(author)
+
+    assert lst.add_seed(list_model.SeedSubjectString('subject:foo__bar'))
+    assert lst.seeds == ['subject:foo_bar']
+    assert not lst.add_seed(list_model.SeedSubjectString('/subjects/foo,bar'))
+    assert not lst.add_seed({'key': '/subjects/foo__bar'})
+    assert lst.has_seed(list_model.SeedSubjectString('subject:foo,bar'))
+    assert lst.remove_seed(list_model.SeedSubjectString('/subjects/foo_bar'))
+    assert lst.seeds == []
+
+
+def test_get_seeds_resolves_objects_and_subjects(monkeypatch):
+    models.register_models()
+    list_model.register_models()
+    site = MockSite()
+    author = site.quicksave('/authors/OL1A', '/type/author', name='Example')
+    lst = site.quicksave(
+        '/people/test/lists/OL1L',
+        '/type/list',
+        name='Test',
+        seeds=[{'key': author.key}, 'subject:foo'],
+    )
+    subject = Subject(key='/subjects/foo', name='Foo', works=[])
+    monkeypatch.setattr(list_model, 'get_subject', lambda key: subject)
+
+    seeds = lst.get_seeds()
+    assert len(seeds) == 2
+    assert isinstance(seeds[0].value, Thing)
+    assert seeds[0].document.name == 'Example'
+    assert seeds[0].type == 'author'
+    assert seeds[1].value == 'subject:foo'
+    assert seeds[1].document is subject
+    assert seeds[1].url == '/subjects/foo'
+
+
+def test_export_list_loads_only_matching_types():
+    models.register_models()
+    list_model.register_models()
+    site = MockSite()
+    author = site.quicksave('/authors/OL1A', '/type/author', name='Example')
+    work = site.quicksave('/works/OL1W', '/type/work', title='Work')
+    edition = site.quicksave('/books/OL1M', '/type/edition', title='Edition')
+    wrong_type = site.quicksave('/books/OL2M', '/type/work', title='Wrong type')
+    lst = site.quicksave(
+        '/people/test/lists/OL1L',
+        '/type/list',
+        name='Test',
+        seeds=[
+            {'key': author.key},
+            {'key': work.key},
+            {'key': edition.key},
+            {'key': wrong_type.key},
+            'subject:foo',
+        ],
+    )
+
+    exported = lst.get_export_list()
+    assert set(exported) == {'authors', 'works', 'editions'}
+    assert [doc['key'] for doc in exported['authors']] == [author.key]
+    assert [doc['key'] for doc in exported['works']] == [work.key]
+    assert [doc['key'] for doc in exported['editions']] == [edition.key]
+    assert exported['editions'][0]['title'] == 'Edition'
+    assert [doc.key for doc in lst.get_editions()['editions']] == [edition.key]
+    assert set(lst.get_book_keys()) == {work.key, edition.key}
+
+    edition_only = site.quicksave(
+        '/people/test/lists/OL2L',
+        '/type/list',
+        name='Editions',
+        seeds=[{'key': edition.key}, {'key': wrong_type.key}, 'subject:foo'],
+    )
+    assert [doc['key'] for doc in edition_only.get_all_editions()] == [edition.key]
+
+    empty = site.quicksave('/people/test/lists/OL3L', '/type/list', name='Empty', seeds=[])
+    assert empty.get_export_list() == {'authors': [], 'works': [], 'editions': []}
