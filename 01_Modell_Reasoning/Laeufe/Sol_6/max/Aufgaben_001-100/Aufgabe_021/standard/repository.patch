+def is_seed_subject_string(seed: str) -> TypeGuard[SeedSubjectString]:
+    return seed.startswith(("subject:", "place:", "person:", "time:"))
+
+
+def subject_key_to_seed(key: str) -> SeedSubjectString:
+    """Convert a /subjects/ pseudo key to a normalized list seed."""
+    subject = key.split("/", 2)[-1]
+    if not is_seed_subject_string(subject):
+        subject = "subject:" + subject
+    return SeedSubjectString(re.sub(r"_{2,}", "_", subject.replace(",", "_")))
+
+
+def _seed_key(seed: SeedValue | str) -> str:
+    if isinstance(seed, str):
+        if seed.startswith('/subjects/') or is_seed_subject_string(seed):
+            return subject_key_to_seed(seed)
+        return seed
+    if isinstance(seed, dict):
+        return _seed_key(seed['key'])
+    return seed.key
+
