+@pytest.mark.parametrize(
+    'key, expected',
+    [
+        ('/subjects/foo__bar,baz', 'subject:foo_bar_baz'),
+        ('/subjects/place:san__francisco', 'place:san_francisco'),
+        ('/subjects/person:someone', 'person:someone'),
+        ('/subjects/time:1900s', 'time:1900s'),
+    ],
+)
+def test_subject_key_to_seed(key, expected):
+    assert lists.subject_key_to_seed(key) == expected
+    assert lists.ListRecord.normalize_input_seed({'key': key}) == expected
+    assert lists.is_seed_subject_string(expected)
+
+
+def test_is_seed_subject_string_rejects_other_prefixes():
+    assert not lists.is_seed_subject_string('subjects:foo')
+    assert not lists.is_seed_subject_string('personality:foo')
+    assert not lists.is_seed_subject_string('/subjects/foo')
+
