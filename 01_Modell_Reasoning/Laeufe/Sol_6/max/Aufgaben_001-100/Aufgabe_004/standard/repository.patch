+import React, { PropsWithChildren } from 'react';
+
+import { act, renderHook, waitFor } from '@testing-library/react';
+import { mocked } from 'jest-mock';
+
+import { useAddresses, useAuthentication, useNotifications, useUser } from '@proton/components/hooks';
+import { PassBridgeContext } from '@proton/pass/lib/bridge/PassBridgeProvider';
+import type { PassBridge, PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { ItemState } from '@proton/pass/types';
+import { UNIX_DAY, UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+import { textToClipboard } from '@proton/shared/lib/helpers/browser';
+
+import { fetchPassAliases, filterPassAliases } from './PassAliasesProvider.helpers';
+import type { CreateModalFormState, PassAliasesVault } from './interface';
+import { usePassAliasesSetup } from './usePassAliasesProviderSetup';
+
+jest.mock('@proton/components/hooks/useAddresses');
+jest.mock('@proton/components/hooks/useAuthentication');
+jest.mock('@proton/components/hooks/useNotifications');
+jest.mock('@proton/components/hooks/useUser');
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    ...jest.requireActual('@proton/shared/lib/helpers/browser'),
+    textToClipboard: jest.fn(),
+}));
+
+const vault = { shareId: 'vault-1', content: { name: 'Personal' } } as PassAliasesVault;
+const aliasItem = (state: ItemState, revisionTime: number, lastUseTime?: number): PassBridgeAliasItem =>
+    ({ item: { state, revisionTime, lastUseTime, aliasEmail: 'alias@example.com' } }) as PassBridgeAliasItem;
+
+const setupBridge = (defaultVault: PassAliasesVault | undefined) => {
+    const init = jest.fn().mockResolvedValue(true);
+    const getDefault = jest.fn().mockResolvedValue(defaultVault);
+    const createDefaultVault = jest.fn().mockResolvedValue(vault);
+    const getAllByShareId = jest.fn().mockResolvedValue([]);
+    const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 10 } });
+    const getAliasOptions = jest.fn().mockResolvedValue({ mailboxes: [], suffixes: [] });
+    const create = jest.fn().mockResolvedValue(aliasItem(ItemState.Active, 10));
+    const bridge = {
+        init,
+        vault: { getDefault, createDefaultVault },
+        alias: { getAllByShareId, getAliasOptions, create },
+        user: { getUserAccess },
+    } as unknown as PassBridge;
+    const wrapper = ({ children }: PropsWithChildren) => (
+        <PassBridgeContext.Provider value={bridge}>{children}</PassBridgeContext.Provider>
+    );
+
+    return {
+        bridge,
+        wrapper,
+        init,
+        getDefault,
+        createDefaultVault,
+        getAllByShareId,
+        getUserAccess,
+        getAliasOptions,
+        create,
+    };
+};
+
+describe('Pass aliases provider setup', () => {
+    const user = {};
+    const addresses: never[] = [];
+    const authStore = {};
+    const createNotification = jest.fn();
+
+    beforeEach(() => {
+        mocked(useUser).mockReturnValue([user, false] as any);
+        mocked(useAddresses).mockReturnValue([addresses, false] as any);
+        mocked(useAuthentication).mockReturnValue(authStore as any);
+        mocked(useNotifications).mockReturnValue({ createNotification } as any);
+        createNotification.mockClear();
+        mocked(textToClipboard).mockClear();
+    });
+
+    it('loads and caches the filtered list from an existing vault', async () => {
+        const { wrapper, init, getDefault, getAllByShareId, getUserAccess, createDefaultVault } = setupBridge(vault);
+        const active = aliasItem(ItemState.Active, 10);
+        getAllByShareId.mockResolvedValue([aliasItem(ItemState.Trashed, 20), active]);
+
+        const { result } = renderHook(() => usePassAliasesSetup(), { wrapper });
+        await waitFor(() => expect(result.current.loading).toBe(false));
+
+        expect(init).toHaveBeenCalledWith({ user, addresses, authStore });
+        expect(getDefault).toHaveBeenCalledWith({ maxAge: UNIX_DAY });
+        expect(getAllByShareId).toHaveBeenCalledWith(vault.shareId, { maxAge: UNIX_MINUTE * 5 });
+        expect(getUserAccess).toHaveBeenCalledWith({ maxAge: UNIX_MINUTE * 5 });
+        expect(createDefaultVault).not.toHaveBeenCalled();
+        expect(result.current.passAliasesItems).toEqual([active]);
+        expect(result.current.hasAliases).toBe(true);
+        expect(result.current.hasUsedProtonPassApp).toBe(true);
+        expect(result.current.hadInitialisedPreviously).toBe(true);
+    });
+
+    it('shows an empty state without fetching, then creates a vault and refreshes after saving', async () => {
+        const { wrapper, getAllByShareId, getUserAccess, createDefaultVault, getAliasOptions, create } =
+            setupBridge(undefined);
+        const active = aliasItem(ItemState.Active, 10);
+        getAllByShareId.mockResolvedValueOnce([]).mockResolvedValueOnce([active]);
+
+        const { result } = renderHook(() => usePassAliasesSetup(), { wrapper });
+        await waitFor(() => expect(result.current.loading).toBe(false));
+        expect(result.current.hasAliases).toBe(false);
+        expect(result.current.hadInitialisedPreviously).toBe(true);
+        expect(getAllByShareId).not.toHaveBeenCalled();
+        expect(getUserAccess).not.toHaveBeenCalled();
+
+        await act(async () => {
+            await result.current.getAliasOptions();
+        });
+        expect(createDefaultVault).toHaveBeenCalledTimes(1);
+        expect(getAllByShareId).toHaveBeenCalledWith(vault.shareId, { maxAge: UNIX_MINUTE * 5 });
+        expect(getAliasOptions).toHaveBeenCalledWith(vault.shareId);
+
+        const formValues: CreateModalFormState = {
+            name: 'Shopping',
+            alias: 'shopping@example.com',
+            signedSuffix: '@example.com',
+            mailbox: { id: 1, email: 'inbox@example.com' },
+            note: '',
+        };
+        await act(async () => {
+            await result.current.submitNewAlias(formValues);
+        });
+
+        expect(create).toHaveBeenCalledWith(expect.objectContaining({ shareId: vault.shareId, name: 'Shopping' }));
+        expect(getAllByShareId).toHaveBeenCalledWith(vault.shareId, { maxAge: 0 });
+        expect(result.current.passAliasesItems).toEqual([active]);
+        expect(result.current.hasAliases).toBe(true);
+        expect(textToClipboard).toHaveBeenCalledWith(formValues.alias);
+        expect(createNotification).toHaveBeenCalledWith(expect.objectContaining({ text: 'Alias saved and copied' }));
+    });
+
+    it('filters trashed items and sorts by last use or revision time', () => {
+        const oldest = aliasItem(ItemState.Active, 1);
+        const recent = aliasItem(ItemState.Active, 2, 5);
+        const middle = aliasItem(ItemState.Active, 3);
+        expect(filterPassAliases([oldest, aliasItem(ItemState.Trashed, 9), recent, middle])).toEqual([
+            recent,
+            middle,
+            oldest,
+        ]);
+    });
+
+    it('fetches aliases and the count limit with a five minute TTL', async () => {
+        const { bridge, getAllByShareId, getUserAccess } = setupBridge(vault);
+        const aliases = [aliasItem(ItemState.Active, 1)];
+        getAllByShareId.mockResolvedValue(aliases);
+
+        await expect(fetchPassAliases(bridge, vault)).resolves.toEqual({
+            aliases,
+            filteredAliases: aliases,
+            aliasesCountLimit: 10,
+        });
