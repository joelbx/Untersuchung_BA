--- /dev/null
+++ b/packages/pass/lib/bridge/PassBridgeFactory.test.ts
@@ -0,0 +1,58 @@
+import { mocked } from 'jest-mock';
+
+import { exposeApi } from '@proton/pass/lib/api/api';
+import { exposePassCrypto } from '@proton/pass/lib/crypto';
+import { createPassCrypto } from '@proton/pass/lib/crypto/pass-crypto';
+import { parseShareResponse } from '@proton/pass/lib/shares/share.parser';
+import { requestShares } from '@proton/pass/lib/shares/share.requests';
+import { isActiveVault, isOwnVault, isWritableVault } from '@proton/pass/lib/vaults/vault.predicates';
+import { createVault } from '@proton/pass/lib/vaults/vault.requests';
+import type { Share, ShareType } from '@proton/pass/types';
+import { UNIX_DAY } from '@proton/pass/utils/time/constants';
+
+import { createPassBridge } from './PassBridgeFactory';
+
+jest.mock('@proton/pass/lib/api/api', () => ({ exposeApi: jest.fn() }));
+jest.mock('@proton/pass/lib/crypto', () => ({ exposePassCrypto: jest.fn() }));
+jest.mock('@proton/pass/lib/crypto/pass-crypto', () => ({ createPassCrypto: jest.fn() }));
+jest.mock('@proton/pass/lib/shares/share.parser', () => ({ parseShareResponse: jest.fn() }));
+jest.mock('@proton/pass/lib/shares/share.requests', () => ({ requestShares: jest.fn() }));
+jest.mock('@proton/pass/lib/vaults/vault.predicates', () => ({
+    isActiveVault: jest.fn(),
+    isOwnVault: jest.fn(),
+    isWritableVault: jest.fn(),
+}));
+jest.mock('@proton/pass/lib/vaults/vault.requests', () => ({ createVault: jest.fn() }));
+
+it('finds the oldest active vault and caches a newly created default vault', async () => {
+    const newer = { shareId: 'newer', createTime: 20 } as Share<ShareType.Vault>;
+    const older = { shareId: 'older', createTime: 10 } as Share<ShareType.Vault>;
+    const inactive = { shareId: 'inactive', createTime: 1 } as Share<ShareType.Vault>;
+    const created = { shareId: 'created', createTime: 30 } as Share<ShareType.Vault>;
+
+    mocked(exposeApi).mockImplementation(() => undefined as any);
+    mocked(createPassCrypto).mockReturnValue({} as any);
+    mocked(exposePassCrypto).mockReturnValue({} as any);
+    mocked(parseShareResponse).mockImplementation(async (share) => share as any);
+    mocked(isActiveVault).mockImplementation((share) => share.shareId !== 'inactive');
+    mocked(isOwnVault).mockReturnValue(true);
+    mocked(isWritableVault).mockReturnValue(true);
+    mocked(requestShares)
+        .mockResolvedValueOnce([newer, inactive, older] as any)
+        .mockResolvedValueOnce([newer, inactive, older] as any)
+        .mockResolvedValue([]);
+    mocked(createVault).mockResolvedValue(created);
+
+    const bridge = createPassBridge({} as any);
+    await expect(bridge.vault.getDefault({ maxAge: 0 })).resolves.toBe(older);
+    await expect(bridge.vault.createDefaultVault()).resolves.toBe(older);
+    expect(createVault).not.toHaveBeenCalled();
+
+    await expect(bridge.vault.getDefault({ maxAge: 0 })).resolves.toBeUndefined();
+    await expect(bridge.vault.createDefaultVault()).resolves.toBe(created);
+    expect(createVault).toHaveBeenCalledWith({
+        content: { name: 'Personal', description: 'Personal vault (created from Mail)', display: {} },
+    });
+    await expect(bridge.vault.getDefault({ maxAge: UNIX_DAY })).resolves.toBe(created);
+    expect(requestShares).toHaveBeenCalledTimes(4);
+});
