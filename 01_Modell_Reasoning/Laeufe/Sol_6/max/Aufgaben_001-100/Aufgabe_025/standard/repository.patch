+// envVarSubstitutionHookFunc resolves whole-string environment variable references
+// before the other decode hooks convert strings to their target types.
+func envVarSubstitutionHookFunc() mapstructure.DecodeHookFunc {
+	return func(from, _ reflect.Kind, data interface{}) (interface{}, error) {
+		if from != reflect.String {
+			return data, nil
+		}
+
+		match := envVarReference.FindStringSubmatch(reflect.ValueOf(data).String())
+		if match == nil {
+			return data, nil
+		}
+
+		if value, ok := os.LookupEnv(match[1]); ok {
+			return value, nil
+		}
+
+		return data, nil
+	}
+}
