+func TestLoadEnvVarReferences(t *testing.T) {
+	t.Setenv("CONFIG_TEST_LOG_LEVEL", "DEBUG")
+	t.Setenv("CONFIG_TEST_LOG_ENCODING", "json")
+	t.Setenv("CONFIG_TEST_HTTP_PORT", "8087")
+	t.Setenv("CONFIG_TEST_CACHE_TTL", "45s")
+	t.Setenv("CONFIG_TEST_CACHE_BACKEND", "redis")
+	t.Setenv("CONFIG_TEST_EMPTY", "")
+	t.Setenv("_CONFIG_TEST_2", "from environment")
+	t.Setenv("1INVALID", "should not be used")
+
+	// Make the missing-variable case independent of the process environment.
+	t.Setenv("CONFIG_TEST_MISSING", "temporary")
+	require.NoError(t, os.Unsetenv("CONFIG_TEST_MISSING"))
+
+	path := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(path, []byte(`log:
+  level: ${CONFIG_TEST_LOG_LEVEL}
+  encoding: ${CONFIG_TEST_LOG_ENCODING}
+  grpc_level: ${CONFIG_TEST_EMPTY}
+  file: ${CONFIG_TEST_MISSING}
+  keys:
+    time: prefix-${CONFIG_TEST_LOG_LEVEL}
+    level: ${1INVALID}
+    message: ${CONFIG_TEST_LOG_LEVEL}${CONFIG_TEST_LOG_ENCODING}
+server:
+  http_port: ${CONFIG_TEST_HTTP_PORT}
+  grpc_port: 9090
+cache:
+  ttl: ${CONFIG_TEST_CACHE_TTL}
+  backend: ${CONFIG_TEST_CACHE_BACKEND}
+ui:
+  topbar:
+    label: ${_CONFIG_TEST_2}
+`), 0600))
+
+	t.Run("substitutes multiple values before type conversion", func(t *testing.T) {
+		res, err := Load(context.Background(), path)
+		require.NoError(t, err)
+		assert.Equal(t, "DEBUG", res.Config.Log.Level)
+		assert.Equal(t, LogEncodingJSON, res.Config.Log.Encoding)
+		assert.Equal(t, "", res.Config.Log.GRPCLevel)
+		assert.Equal(t, "${CONFIG_TEST_MISSING}", res.Config.Log.File)
+		assert.Equal(t, "prefix-${CONFIG_TEST_LOG_LEVEL}", res.Config.Log.Keys.Time)
+		assert.Equal(t, "${1INVALID}", res.Config.Log.Keys.Level)
+		assert.Equal(t, "${CONFIG_TEST_LOG_LEVEL}${CONFIG_TEST_LOG_ENCODING}", res.Config.Log.Keys.Message)
+		assert.Equal(t, 8087, res.Config.Server.HTTPPort)
+		assert.Equal(t, 9090, res.Config.Server.GRPCPort)
+		assert.Equal(t, 45*time.Second, res.Config.Cache.TTL)
+		assert.Equal(t, CacheRedis, res.Config.Cache.Backend)
+		assert.Equal(t, "from environment", res.Config.UI.Topbar.Label)
+	})
+
+	t.Run("flipt environment variables override referenced values", func(t *testing.T) {
+		t.Setenv("FLIPT_SERVER_HTTP_PORT", "8088")
+		t.Setenv("FLIPT_LOG_ENCODING", "console")
+
+		res, err := Load(context.Background(), path)
+		require.NoError(t, err)
+		assert.Equal(t, 8088, res.Config.Server.HTTPPort)
+		assert.Equal(t, LogEncodingConsole, res.Config.Log.Encoding)
+	})
+}
