+func TestEvaluateRolloutBoundary(t *testing.T) {
+	const flagKey = "boundary-flag"
+	var entityID string
+	for i := 0; i < 10000; i++ {
+		candidate := fmt.Sprintf("entity-%d", i)
+		if crc32.ChecksumIEEE([]byte(flagKey+candidate))%1000 == 500 {
+			entityID = candidate
+			break
+		}
+	}
+	require.NotEmpty(t, entityID)
+
+	matched, selected := evaluate(&flipt.EvaluationRequest{FlagKey: flagKey, EntityId: entityID},
+		[]distribution{{VariantKey: "first"}, {VariantKey: "second"}}, []int{500, 1000})
+	assert.True(t, matched)
+	assert.Equal(t, "first", selected.VariantKey)
+}
