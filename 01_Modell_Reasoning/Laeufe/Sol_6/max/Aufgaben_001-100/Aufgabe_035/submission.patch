+		{"notempty has no value", constraint{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "p", Operator: "NOTEMPTY"}, map[string]string{"p": " x "}, true, false},
+		{"string present has no value", constraint{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "p", Operator: "PRESENT"}, map[string]string{"p": " x "}, true, false},
+		{"string notpresent has no value", constraint{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "p", Operator: "NOTPRESENT"}, nil, true, false},
+		{"decimal number", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "GtE", Value: " 1.25 "}, map[string]string{"p": " 1.5 "}, true, false},
+		{"missing number", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "eq", Value: "1"}, nil, false, false},
+		{"nonnumeric input", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "eq", Value: "1"}, map[string]string{"p": "banana"}, false, true},
+		{"hex input", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "eq", Value: "1"}, map[string]string{"p": "0x1p0"}, false, true},
+		{"NaN input", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "eq", Value: "1"}, map[string]string{"p": "NaN"}, false, true},
+		{"numeric present", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "present"}, map[string]string{"p": "1"}, true, false},
+		{"numeric notpresent", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "notpresent"}, nil, true, false},
+		{"boolean true has no value", constraint{Type: flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE, Property: "p", Operator: "TRUE"}, map[string]string{"p": " TRUE "}, true, false},
+		{"boolean false has no value", constraint{Type: flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE, Property: "p", Operator: "FALSE"}, map[string]string{"p": "false"}, true, false},
+		{"nonboolean input", constraint{Type: flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE, Property: "p", Operator: "TRUE"}, map[string]string{"p": "banana"}, false, true},
+		{"blank boolean input", constraint{Type: flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE, Property: "p", Operator: "FALSE"}, map[string]string{"p": " "}, false, true},
+		{"required comparison value", constraint{Type: flipt.ComparisonType_NUMBER_COMPARISON_TYPE, Property: "p", Operator: "eq"}, map[string]string{"p": "1"}, false, true},
+		{"unsupported type operator", constraint{Type: flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE, Property: "p", Operator: "prefix", Value: "x"}, map[string]string{"p": "x"}, false, true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			match, err := matchesConstraints([]constraint{tt.c}, tt.context)
+			if tt.wantErr {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+			assert.Equal(t, tt.match, match)
+		})
+	}
+}
