+func (s *ConfigTestSuite) TestKubernetesServiceListenAndProxyWarning(c *check.C) {
+	var warnings bytes.Buffer
+	previousOutput := log.StandardLogger().Out
+	log.SetOutput(&warnings)
+	defer log.SetOutput(previousOutput)
+
+	fc, err := ReadConfig(bytes.NewBufferString("proxy_service:\n  enabled: yes\nkubernetes_service:\n  enabled: yes\n  listen_addr: kube.internal\n"))
+	c.Assert(err, check.IsNil)
+	cfg := service.MakeDefaultConfig()
+	c.Assert(ApplyFileConfig(fc, cfg), check.IsNil)
+	c.Assert(cfg.Kube.Enabled, check.Equals, true)
+	c.Assert(cfg.Kube.ListenAddr.Addr, check.Equals, "kube.internal:3026")
+	c.Assert(strings.Contains(warnings.String(), "proxy_service.kube_listen_addr"), check.Equals, true)
+
+	warnings.Reset()
+	fc.Proxy.KubeListenAddr = "0.0.0.0:3026"
+	cfg = service.MakeDefaultConfig()
+	c.Assert(ApplyFileConfig(fc, cfg), check.IsNil)
+	c.Assert(warnings.String(), check.Equals, "")
+
+	warnings.Reset()
+	fc.Proxy.KubeListenAddr = ""
+	fc.Proxy.EnabledFlag = "no"
+	cfg = service.MakeDefaultConfig()
+	c.Assert(ApplyFileConfig(fc, cfg), check.IsNil)
+	c.Assert(warnings.String(), check.Equals, "")
+
+	warnings.Reset()
+	fc = &FileConfig{}
+	cfg = service.MakeDefaultConfig()
+	c.Assert(ApplyFileConfig(fc, cfg), check.IsNil)
+	c.Assert(cfg.Kube.Enabled, check.Equals, false)
+	c.Assert(warnings.String(), check.Equals, "")
+}
