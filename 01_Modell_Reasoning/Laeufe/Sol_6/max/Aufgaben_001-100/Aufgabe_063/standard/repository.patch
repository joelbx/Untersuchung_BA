+func (s *ConfigTestSuite) TestKubernetesProxyListenConfig(c *check.C) {
+	tests := []struct {
+		name       string
+		config     string
+		enabled    bool
+		listenAddr string
+		conflict   bool
+	}{
+		{
+			name:       "shorthand with port",
+			config:     "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n",
+			enabled:    true,
+			listenAddr: "0.0.0.0:8080",
+		},
+		{
+			name:       "shorthand with default port",
+			config:     "proxy_service:\n  kube_listen_addr: kube.example.com\n",
+			enabled:    true,
+			listenAddr: "kube.example.com:3026",
+		},
+		{
+			name:       "shorthand with IPv6 default port",
+			config:     "proxy_service:\n  kube_listen_addr: '[::]'\n",
+			enabled:    true,
+			listenAddr: "[::]:3026",
+		},
+		{
+			name:       "legacy enabled block",
+			config:     "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:4040\n",
+			enabled:    true,
+			listenAddr: "127.0.0.1:4040",
+		},
+		{
+			name:       "legacy disabled block",
+			config:     "proxy_service:\n  kubernetes:\n    enabled: no\n",
+			enabled:    false,
+			listenAddr: "0.0.0.0:3026",
+		},
+		{
+			name:       "disabled legacy block with shorthand",
+			config:     "proxy_service:\n  kube_listen_addr: localhost:8080\n  kubernetes:\n    enabled: no\n    listen_addr: localhost:9999\n",
+			enabled:    true,
+			listenAddr: "localhost:8080",
+		},
+		{
+			name:       "nested public address with shorthand",
+			config:     "proxy_service:\n  kube_listen_addr: localhost:8080\n  kubernetes:\n    public_addr: kube.example.com:3026\n",
+			enabled:    true,
+			listenAddr: "localhost:8080",
+		},
+		{
+			name:     "enabled legacy block conflicts",
+			config:   "proxy_service:\n  kube_listen_addr: localhost:8080\n  kubernetes:\n    enabled: yes\n    listen_addr: localhost:9999\n",
+			conflict: true,
+		},
+		{
+			name:     "legacy listen address conflicts",
+			config:   "proxy_service:\n  kube_listen_addr: localhost:8080\n  kubernetes:\n    listen_addr: localhost:9999\n",
+			conflict: true,
+		},
+	}
+
+	for _, test := range tests {
+		comment := check.Commentf(test.name)
+		fc, err := ReadConfig(bytes.NewBufferString(test.config))
+		if test.conflict {
+			c.Assert(err, check.NotNil, comment)
+			c.Assert(trace.IsBadParameter(err), check.Equals, true, comment)
+			c.Assert(strings.Contains(err.Error(), "kube_listen_addr") && strings.Contains(err.Error(), "kubernetes"), check.Equals, true, comment)
+			continue
+		}
+		c.Assert(err, check.IsNil, comment)
+		cfg := service.MakeDefaultConfig()
+		c.Assert(ApplyFileConfig(fc, cfg), check.IsNil, comment)
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, test.enabled, comment)
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, test.listenAddr, comment)
+		if len(fc.Proxy.Kube.PublicAddr) != 0 {
+			c.Assert(cfg.Proxy.Kube.PublicAddrs, check.HasLen, 1, comment)
+			c.Assert(cfg.Proxy.Kube.PublicAddrs[0].Addr, check.Equals, "kube.example.com:3026", comment)
+		}
+	}
+
+	fc := &FileConfig{Proxy: Proxy{
+		KubeListenAddr: "localhost:8080",
+		Kube:           KubeProxy{Service: Service{EnabledFlag: "yes"}},
+	}}
+	cfg := service.MakeDefaultConfig()
+	c.Assert(trace.IsBadParameter(ApplyFileConfig(fc, cfg)), check.Equals, true)
+}
