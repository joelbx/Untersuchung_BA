+func (s *APITestSuite) TestKubernetesProxyAddressResolution(c *check.C) {
+	tests := []struct {
+		name     string
+		webAddr  string
+		settings ProxySettings
+		wantAddr string
+		wantURL  string
+	}{
+		{
+			name:     "public address takes precedence",
+			webAddr:  "web.example.com:3080",
+			settings: ProxySettings{Kube: KubeProxySettings{Enabled: true, PublicAddr: "kube.example.com:443", ListenAddr: "0.0.0.0:3026"}},
+			wantAddr: "kube.example.com:443",
+			wantURL:  "https://kube.example.com:443",
+		},
+		{
+			name:    "IPv4 wildcard uses advertised web host",
+			webAddr: "old.example.com:3080",
+			settings: ProxySettings{
+				Kube: KubeProxySettings{Enabled: true, ListenAddr: "0.0.0.0:8080"},
+				SSH:  SSHProxySettings{PublicAddr: "web.example.com:443"},
+			},
+			wantAddr: "web.example.com:8080",
+			wantURL:  "https://web.example.com:8080",
+		},
+		{
+			name:     "IPv6 wildcard uses web host",
+			webAddr:  "[2001:db8::1]:3080",
+			settings: ProxySettings{Kube: KubeProxySettings{Enabled: true, ListenAddr: "[::]:4040"}},
+			wantAddr: "[2001:db8::1]:4040",
+			wantURL:  "https://[2001:db8::1]:4040",
+		},
+		{
+			name:     "missing Kubernetes port uses default",
+			webAddr:  "web.example.com:3080",
+			settings: ProxySettings{Kube: KubeProxySettings{Enabled: true, ListenAddr: "0.0.0.0"}},
+			wantAddr: "web.example.com:3026",
+			wantURL:  "https://web.example.com:3026",
+		},
+		{
+			name:     "missing Kubernetes address uses web proxy",
+			webAddr:  "web.example.com:3080",
+			settings: ProxySettings{Kube: KubeProxySettings{Enabled: true}},
+			wantAddr: "web.example.com:3026",
+			wantURL:  "https://web.example.com:3026",
+		},
+	}
+
+	for _, test := range tests {
+		tc := &TeleportClient{Config: Config{WebProxyAddr: test.webAddr}}
+		c.Assert(tc.applyProxySettings(test.settings), check.IsNil, check.Commentf(test.name))
+		c.Assert(tc.KubeProxyAddr, check.Equals, test.wantAddr, check.Commentf(test.name))
+		c.Assert(tc.KubeClusterAddr(), check.Equals, test.wantURL, check.Commentf(test.name))
+	}
+
+	// Profiles created before this change may still contain wildcard addresses.
+	conf := Config{WebProxyAddr: "web.example.com:3080", KubeProxyAddr: "[::]:9000"}
+	c.Assert(conf.KubeClusterAddr(), check.Equals, "https://web.example.com:9000")
+}
+
