+def find_author_by_remote_ids(remote_ids: dict[str, str]) -> "Author | None":
+    """Find an author by external IDs, preferring the most ID agreements."""
+    from openlibrary.core.models import AuthorRemoteIdConflictError
+
+    candidates = {}
+    matches_by_source = {}
+    for source, remote_id in sorted(remote_ids.items()):
+        if not remote_id:
+            continue
+        query = {'type': '/type/author', f'remote_ids.{source}': remote_id}
+        keys = set(web.ctx.site.things(query))
+        matches_by_source[source] = keys
+        for key in keys:
+            if key not in candidates:
+                candidates[key] = web.ctx.site.get(key)
+    if not candidates:
+        return None
+
+    compatible = []
+    conflict = None
+    for candidate in candidates.values():
+        try:
+            _, matching = candidate.merge_remote_ids(remote_ids)
+        except AuthorRemoteIdConflictError as e:
+            conflict = e
+        else:
+            compatible.append((candidate, matching))
+    if not compatible:
+        assert conflict is not None
+        raise conflict
+
+    # More agreeing IDs take priority; the numeric OL key and full key make
+    # duplicate identifier matches deterministic.
+    selected = min(
+        compatible, key=lambda item: (-item[1], key_int(item[0]), item[0].key)
+    )[0]
+    for source, keys in matches_by_source.items():
+        if keys and selected.key not in keys:
+            raise AuthorRemoteIdConflictError(
+                f"Conflicting {source} remote ID: already assigned to "
+                f"{min(keys)}"
+            )
+    return selected
+
