+    @classmethod
+    def update_work_id(cls, current_work_id, new_work_id, _test=False):
+        """Move booknotes only when the destination work has no booknotes.
+
+        A conflict must leave every booknote intact, including notes for the
+        source work that would otherwise be moved individually.
+        """
+        oldb = db.get_db()
+        result = {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 0}
+        transaction = oldb.transaction()
+        try:
+            source_notes = oldb.select(
+                cls.TABLENAME,
+                what="1",
+                where="work_id=$work_id",
+                vars={"work_id": current_work_id},
+                limit=1,
+            )
+            if not list(source_notes):
+                transaction.rollback()
+                return result
+
+            destination_notes = oldb.select(
+                cls.TABLENAME,
+                what="1",
+                where="work_id=$new_work_id AND work_id<>$current_work_id",
+                vars={
+                    "new_work_id": new_work_id,
+                    "current_work_id": current_work_id,
+                },
+                limit=1,
+            )
+            if list(destination_notes):
+                result["failed_deletes"] = 1
+                transaction.rollback()
+                return result
+
+            result["rows_changed"] = oldb.update(
+                cls.TABLENAME,
+                where="work_id=$work_id",
+                work_id=new_work_id,
+                vars={"work_id": current_work_id},
+            )
+            if _test:
+                transaction.rollback()
+            else:
+                transaction.commit()
+        except (UniqueViolation, IntegrityError):
+            transaction.rollback()
+            result["rows_changed"] = 0
+            result["failed_deletes"] = 1
+        except Exception:
+            transaction.rollback()
+            raise
+        return result
+
     @classmethod
     def total_booknotes(cls):
         oldb = db.get_db()
