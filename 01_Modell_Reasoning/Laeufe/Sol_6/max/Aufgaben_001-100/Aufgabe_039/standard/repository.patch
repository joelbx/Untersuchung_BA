+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        db = get_db()
+        db.query("""
+        CREATE TABLE booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL DEFAULT -1,
+            notes text NOT NULL,
+            PRIMARY KEY (username, work_id, edition_id)
+        );
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        self.db.insert(
+            "booknotes", username="reader", work_id=1, edition_id=1, notes="source"
+        )
+
+    def teardown_method(self):
+        self.db.delete("booknotes", where="1=1")
+
+    def booknotes(self):
+        return [
+            dict(row)
+            for row in self.db.select(
+                "booknotes", order="username, work_id, edition_id"
+            )
+        ]
+
+    def test_collision_preserves_every_record(self):
+        self.db.insert(
+            "booknotes", username="reader", work_id=2, edition_id=1, notes="target"
+        )
+        self.db.insert(
+            "booknotes",
+            username="other",
+            work_id=1,
+            edition_id=3,
+            notes="another source",
+        )
+        self.db.insert(
+            "booknotes", username="other", work_id=3, edition_id=3, notes="unrelated"
+        )
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.booknotes() == before
+
+    def test_target_work_used_by_another_patron(self):
+        self.db.insert(
+            "booknotes", username="other", work_id=2, edition_id=1, notes="target"
+        )
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1}
+        assert self.booknotes() == before
+
+    def test_update_simple(self):
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {"rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0}
+        assert self.booknotes() == [
+            {"username": "reader", "work_id": 2, "edition_id": 1, "notes": "source"}
+        ]
+
+    def test_dry_run(self):
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {"rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0}
+        assert self.booknotes() == before
+
+    def test_no_source_notes(self):
+        before = self.booknotes()
+
+        result = Booknotes.update_work_id(3, 1)
+
+        assert result == {"rows_changed": 0, "rows_deleted": 0, "failed_deletes": 0}
+        assert self.booknotes() == before
