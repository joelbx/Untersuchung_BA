+def test_custom_headers_accept_language_fallback(config_stub):
+    option = 'content.headers.accept_language'
+    url = QUrl('https://example.com/')
+    other_url = QUrl('https://other.example.com/')
+    config_stub.val.content.headers.accept_language = 'global'
+
+    assert dict(shared.custom_headers(url))[b'Accept-Language'] == b'global'
+    assert b'Accept-Language' not in dict(
+        shared.custom_headers(url, fallback_accept_language=False))
+    assert dict(shared.custom_headers(
+        None, fallback_accept_language=False))[b'Accept-Language'] == b'global'
+
+    config_stub.set_obj(
+        option, 'domain', pattern=urlmatch.UrlPattern('https://example.com/*'))
+    assert dict(shared.custom_headers(
+        url, fallback_accept_language=False))[b'Accept-Language'] == b'domain'
+    assert b'Accept-Language' not in dict(
+        shared.custom_headers(other_url, fallback_accept_language=False))
+
+    config_stub.set_obj(
+        option, None, pattern=urlmatch.UrlPattern('https://example.com/*'))
+    assert b'Accept-Language' not in dict(
+        shared.custom_headers(url, fallback_accept_language=False))
+
