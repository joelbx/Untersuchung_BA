+++ b/server/public/handle_streams_test.go
@@ -0,0 +1,51 @@
+package public
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+
+	"github.com/go-chi/jwtauth/v5"
+	"github.com/navidrome/navidrome/core"
+	"github.com/navidrome/navidrome/core/auth"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type recordingSharedStreamOffset struct {
+	core.MediaStreamer
+	id         string
+	timeOffset int
+}
+
+func (s *recordingSharedStreamOffset) NewStream(_ context.Context, id, _ string, _, timeOffset int) (*core.Stream, error) {
+	s.id, s.timeOffset = id, timeOffset
+	return nil, errors.New("stop stream")
+}
+
+var _ = Describe("Shared stream timeOffset", func() {
+	DescribeTable("parses and forwards the offset", func(raw string, want int) {
+		auth.TokenAuth = jwtauth.New("HS256", []byte("super secret"), nil)
+		token, err := auth.CreatePublicToken(map[string]any{"id": "track"})
+		Expect(err).ToNot(HaveOccurred())
+		params := url.Values{":id": {token}}
+		if raw != "" {
+			params.Set("timeOffset", raw)
+		}
+		r := httptest.NewRequest(http.MethodGet, "/s/"+token+"?"+params.Encode(), nil)
+		w := httptest.NewRecorder()
+		streamer := &recordingSharedStreamOffset{}
+		p := &Router{streamer: streamer}
+		p.handleStream(w, r)
+		Expect(w.Code).To(Equal(http.StatusInternalServerError))
+		Expect(streamer.id).To(Equal("track"))
+		Expect(streamer.timeOffset).To(Equal(want))
+	},
+		Entry("when missing", "", 0),
+		Entry("when valid", "37", 37),
+		Entry("when malformed", "bad", 0),
+		Entry("when negative", "-5", 0),
+	)
+})
