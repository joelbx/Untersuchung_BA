--- /dev/null
+++ b/server/subsonic/stream_test.go
@@ -0,0 +1,57 @@
+package subsonic
+
+import (
+	"context"
+	"errors"
+	"net/http/httptest"
+	"net/url"
+
+	"github.com/navidrome/navidrome/core"
+	"github.com/navidrome/navidrome/server/subsonic/responses"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+type recordingStreamOffset struct {
+	core.MediaStreamer
+	id         string
+	format     string
+	bitRate    int
+	timeOffset int
+}
+
+func (s *recordingStreamOffset) NewStream(_ context.Context, id, format string, bitRate, timeOffset int) (*core.Stream, error) {
+	s.id, s.format, s.bitRate, s.timeOffset = id, format, bitRate, timeOffset
+	return nil, errors.New("stop stream")
+}
+
+var _ = Describe("Stream timeOffset", func() {
+	DescribeTable("parses and forwards the offset", func(raw string, want int) {
+		streamer := &recordingStreamOffset{}
+		api := &Router{streamer: streamer}
+		r := newGetRequest("id=track", "format=mp3", "maxBitRate=128")
+		if raw != "" {
+			r.URL.RawQuery += "&timeOffset=" + url.QueryEscape(raw)
+		}
+		_, err := api.Stream(httptest.NewRecorder(), r)
+		Expect(err).To(MatchError("stop stream"))
+		Expect(streamer.id).To(Equal("track"))
+		Expect(streamer.format).To(Equal("mp3"))
+		Expect(streamer.bitRate).To(Equal(128))
+		Expect(streamer.timeOffset).To(Equal(want))
+	},
+		Entry("when missing", "", 0),
+		Entry("when valid", "37", 37),
+		Entry("when malformed", "bad", 0),
+		Entry("when negative", "-5", 0),
+	)
+
+	It("advertises transcoding offsets", func() {
+		api := &Router{}
+		response, err := api.GetOpenSubsonicExtensions(nil)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(*response.OpenSubsonicExtensions).To(ContainElement(responses.OpenSubsonicExtension{
+			Name: "transcodeOffset", Versions: []int32{1},
+		}))
+	})
+})
