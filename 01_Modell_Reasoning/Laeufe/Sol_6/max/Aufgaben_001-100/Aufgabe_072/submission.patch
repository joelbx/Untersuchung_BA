+import { useRef } from 'react';
+
+import { fireEvent, render, screen } from '@testing-library/react';
+
+import { MailSettings } from '@proton/shared/lib/interfaces';
+
+import { useLinkHandler } from './useLinkHandler';
+
+const mockCreateNotification = jest.fn();
+
+jest.mock('./index', () => ({
+    useHandler: (handler: (...args: any[]) => void) => handler,
+    useNotifications: () => ({ createNotification: mockCreateNotification }),
+}));
+
+jest.mock('../components', () => {
+    const { useState } = jest.requireActual('react');
+    return {
+        useModalState: () => {
+            const [open, setOpen] = useState(false);
+            return [{ open }, setOpen];
+        },
+    };
+});
+
+jest.mock('../components/notifications/LinkConfirmationModal', () => {
+    const React = jest.requireActual('react');
+    return {
+        __esModule: true,
+        default: ({ link }: { link?: string }) => React.createElement('div', { 'data-testid': 'confirmation' }, link),
+    };
+});
+
+const TestLink = ({ href, confirmLink }: { href?: string; confirmLink?: number }) => {
+    const wrapperRef = useRef<HTMLDivElement>(null);
+    const settings = confirmLink === undefined ? undefined : ({ ConfirmLink: confirmLink } as MailSettings);
+    const { modal } = useLinkHandler(wrapperRef, settings);
+
+    return (
+        <div ref={wrapperRef}>
+            <a data-testid="link" href={href}>
+                Visit
+            </a>
+            {modal}
+        </div>
+    );
+};
+
+describe('useLinkHandler', () => {
+    beforeEach(() => {
+        mockCreateNotification.mockClear();
+    });
+
+    it('shows a punycoded external URL in the confirmation modal', () => {
+        render(<TestLink href="https://www.аррӏе.com/путь?next=https://другой.com#часть" />);
+
+        fireEvent.click(screen.getByTestId('link'));
+
+        expect(screen.getByTestId('confirmation')).toHaveTextContent(
+            'https://www.xn--80ak6aa92e.com/путь?next=https://другой.com#часть'
+        );
+    });
+
+    it('updates the link destination when confirmation is disabled', () => {
+        render(<TestLink href="https://www.аррӏе.com/path" confirmLink={0} />);
+
+        const link = screen.getByTestId('link');
+        fireEvent.click(link);
+
+        expect(link).toHaveAttribute('href', 'https://www.xn--80ak6aa92e.com/path');
+    });
+
+    it('reports an error when the link has no URL', () => {
+        render(<TestLink />);
+
+        fireEvent.click(screen.getByTestId('link'));
+
+        expect(mockCreateNotification).toHaveBeenCalledWith(expect.objectContaining({ type: 'error' }));
+    });
+});
