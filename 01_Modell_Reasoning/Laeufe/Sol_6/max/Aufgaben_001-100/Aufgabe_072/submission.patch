+/** Extract the domain label immediately before the final suffix. */
+export const getHostnameWithRegex = (url: string): string => {
+    const match =
+        /^(?:(?:[a-z][a-z\d+.-]*:)?\/\/(?:[^/?#@]*@)?)?(?:[^./:?#@]+\.)*([^./:?#@]+)\.[^./:?#@]+(?::\d+)?(?:[/?#]|$)/i.exec(
+            url
+        );
+    return match?.[1] || '';
+};
+
+/** Encode only the hostname, leaving the other URL components as written. */
+export const punycodeUrl = (url: string): string => {
+    const match = /^((?:[a-z][a-z\d+.-]*:)?\/\/)([^/?#]*)([^?#]*)(\?[^#]*)?(#.*)?$/i.exec(url);
+    if (!match) {
+        return url;
+    }
+
+    const [, prefix, authority, pathname, search = '', hash = ''] = match;
+    if (authority.includes('\\')) {
+        throw new TypeError('Invalid URL authority');
+    }
+
+    const hostnameStart = authority.lastIndexOf('@') + 1;
+    const hostAndPort = authority.slice(hostnameStart);
+    const hostnameEnd = hostAndPort.startsWith('[')
+        ? hostAndPort.indexOf(']') + 1
+        : hostAndPort.indexOf(':') === -1
+        ? hostAndPort.length
+        : hostAndPort.indexOf(':');
+
+    const rawHostname = hostAndPort.slice(0, hostnameEnd);
+    if (!rawHostname) {
+        throw new TypeError('URL has no hostname');
+    }
+
+    // Older browsers have no URL constructor. The authority has already been separated from the rest of the URL.
+    const hostname = typeof URL === 'undefined' ? rawHostname : new URL(url, 'https://example.invalid').hostname;
+    if (!hostname) {
+        throw new TypeError('URL has no hostname');
+    }
+
+    const asciiHostname = punycode.toASCII(hostname);
+    const pathWithoutTrailingSlash = pathname.replace(/\/+$/, '');
+    return `${prefix}${authority.slice(0, hostnameStart)}${asciiHostname}${hostAndPort.slice(
+        hostnameEnd
+    )}${pathWithoutTrailingSlash}${search}${hash}`;
+};
+
 export const isMailTo = (url: string): boolean => {
     return url.toLowerCase().startsWith('mailto:');
 };
