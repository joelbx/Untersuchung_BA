+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package auth
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/u2f"
+	"github.com/stretchr/testify/require"
+)
+
+func TestU2FAuthenticateChallengeJSON(t *testing.T) {
+	first := u2f.AuthenticateChallenge{
+		Version: "U2F_V2", Challenge: "first", KeyHandle: "key-one", AppID: "https://example.com",
+	}
+	second := u2f.AuthenticateChallenge{
+		Version: "U2F_V2", Challenge: "second", KeyHandle: "key-two", AppID: "https://example.com",
+	}
+	challenge := U2FAuthenticateChallenge{
+		AuthenticateChallenge: &first,
+		Challenges:            []u2f.AuthenticateChallenge{first, second},
+	}
+
+	encoded, err := json.Marshal(challenge)
+	require.NoError(t, err)
+	var oldClient u2f.AuthenticateChallenge
+	require.NoError(t, json.Unmarshal(encoded, &oldClient))
+	require.Equal(t, first, oldClient)
+	var newClient U2FAuthenticateChallenge
+	require.NoError(t, json.Unmarshal(encoded, &newClient))
+	require.Equal(t, []u2f.AuthenticateChallenge{first, second}, newClient.SignChallenges())
+
+	legacy, err := json.Marshal(first)
+	require.NoError(t, err)
+	var fromOldServer U2FAuthenticateChallenge
+	require.NoError(t, json.Unmarshal(legacy, &fromOldServer))
+	require.Equal(t, []u2f.AuthenticateChallenge{first}, fromOldServer.SignChallenges())
+}
