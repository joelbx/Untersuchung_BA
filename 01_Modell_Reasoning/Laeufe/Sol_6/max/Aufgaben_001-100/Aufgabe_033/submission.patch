 }
 
+func (s *WebSuite) TestU2FLoginMultipleDevices(c *C) {
+	ctx := context.Background()
+	cap, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  "https://" + s.server.ClusterName(),
+			Facets: []string{"https://" + s.server.ClusterName()},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.server.Auth().SetAuthPreference(cap), IsNil)
+
+	const user = "multi-u2f-user"
+	const password = "password"
+	s.createUser(c, user, "root", password, "")
+	firstKey, err := mocku2f.Create()
+	c.Assert(err, IsNil)
+	secondKey, err := mocku2f.Create()
+	c.Assert(err, IsNil)
+	for _, entry := range []struct {
+		name string
+		key  *mocku2f.Key
+	}{
+		{"first", firstKey},
+		{"second", secondKey},
+	} {
+		dev, err := u2f.NewDevice(entry.name, &u2f.Registration{
+			KeyHandle: entry.key.KeyHandle,
+			PubKey:    entry.key.PrivateKey.PublicKey,
+		}, s.clock.Now())
+		c.Assert(err, IsNil)
+		c.Assert(s.server.Auth().UpsertMFADevice(ctx, user, dev), IsNil)
+	}
+
+	// The auth API client must preserve every challenge on the wire.
+	viaAuth, err := s.proxyClient.GetU2FSignRequest(user, []byte(password))
+	c.Assert(err, IsNil)
+	c.Assert(viaAuth.SignChallenges(), HasLen, 2)
+
+	clt := s.client()
+	re, err := clt.PostJSON(ctx, clt.Endpoint("webapi", "u2f", "signrequest"), client.U2fSignRequestReq{
+		User: user,
+		Pass: password,
+	})
+	c.Assert(err, IsNil)
+	var challenge auth.U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &challenge), IsNil)
+	c.Assert(challenge.Challenges, HasLen, 2)
+	c.Assert(challenge.AuthenticateChallenge, DeepEquals, &challenge.Challenges[0])
+
+	// The original top-level fields are still usable by older web clients.
+	var legacy u2f.AuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &legacy), IsNil)
+	c.Assert(legacy, DeepEquals, challenge.Challenges[0])
+
+	// Use the second device, regardless of which challenge is first.
+	secondHandle := base64.URLEncoding.WithPadding(base64.NoPadding).EncodeToString(secondKey.KeyHandle)
+	for _, signReq := range challenge.Challenges {
+		if signReq.KeyHandle != secondHandle {
+			continue
+		}
+		signResp, err := secondKey.SignResponse(&signReq)
+		c.Assert(err, IsNil)
+		_, err = clt.PostJSON(ctx, clt.Endpoint("webapi", "u2f", "sessions"), u2fSignResponseReq{
+			User:            user,
+			U2FSignResponse: *signResp,
+		})
+		c.Assert(err, IsNil)
+		return
+	}
+	c.Fatal("no challenge for the second U2F device")
+}
