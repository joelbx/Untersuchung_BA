+const NamespacesKey contextKey = "namespaces"
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
+
+// FormatNamespaces converts an OPA decision into a list of namespace keys.
+// An empty list is a valid decision; an undefined or malformed decision is not.
+func FormatNamespaces(result any) ([]string, error) {
+	switch namespaces := result.(type) {
+	case []string:
+		return namespaces, nil
+	case []any:
+		formatted := make([]string, 0, len(namespaces))
+		for i, namespace := range namespaces {
+			key, ok := namespace.(string)
+			if !ok {
+				return nil, fmt.Errorf("viewable namespaces result contains %T at index %d", namespace, i)
+			}
+			formatted = append(formatted, key)
+		}
+		return formatted, nil
+	case nil:
+		return nil, fmt.Errorf("viewable namespaces decision is undefined")
+	default:
+		return nil, fmt.Errorf("unexpected viewable namespaces result type %T", result)
+	}
+}
