+// listAccessibleNamespaces filters before applying pagination so every page
+// and the total count describe only the namespaces visible to the requester.
+func (s *Server) listAccessibleNamespaces(ctx context.Context, ref storage.ReferenceRequest, r *flipt.ListNamespaceRequest, accessible []string) (*flipt.NamespaceList, error) {
+	resp := &flipt.NamespaceList{}
+	if len(accessible) == 0 {
+		return resp, nil
+	}
+
+	results, err := s.store.ListNamespaces(ctx, storage.ListWithOptions(ref))
+	if err != nil {
+		return nil, err
+	}
+
+	allowed := make(map[string]struct{}, len(accessible))
+	for _, key := range accessible {
+		allowed[key] = struct{}{}
+	}
+	_, all := allowed["*"]
+	for _, namespace := range results.Results {
+		if namespace == nil {
+			continue
+		}
+		if _, ok := allowed[namespace.Key]; ok || all {
+			resp.Namespaces = append(resp.Namespaces, namespace)
+		}
+	}
+
+	resp.TotalCount = int32(len(resp.Namespaces))
+	offset := int(r.GetOffset())
+	if r.GetPageToken() != "" {
+		offset, err = strconv.Atoi(r.GetPageToken())
+		if err != nil || offset < 0 {
+			return nil, errors.ErrInvalidf("pageToken is not valid: %q", r.GetPageToken())
+		}
+	}
+	if offset < 0 {
+		return nil, errors.ErrInvalidf("offset is not valid: %d", offset)
+	}
+	if offset >= len(resp.Namespaces) {
+		resp.Namespaces = nil
+		return resp, nil
+	}
+
+	end := len(resp.Namespaces)
+	if limit := int(r.GetLimit()); limit > 0 && limit < end-offset {
+		end = offset + limit
+		resp.NextPageToken = strconv.Itoa(end)
+	}
+	resp.Namespaces = resp.Namespaces[offset:end]
+	s.logger.Debug("list namespaces", zap.Stringer("response", resp))
+	return resp, nil
+}
