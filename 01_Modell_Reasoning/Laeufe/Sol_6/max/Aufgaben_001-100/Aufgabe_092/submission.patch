+    assert run(upgrade=True) == {('upgrade.parent', '2.0.0')}
+
+    installed[1:] = [
+        Candidate('upgrade.child', '1.0.0', None, 'dir'),
+        Candidate('upgrade.leaf', '1.0.0', None, 'dir'),
+    ]
+    assert run(upgrade=True, no_deps=True) == {('upgrade.parent', '2.0.0')}
+
+    installed[:] = [Candidate(name, version, None, 'dir') for name, version in (
+        ('upgrade.parent', '2.0.0'), ('upgrade.child', '3.0.0'), ('upgrade.leaf', '3.0.0'),
+    )]
+    assert run(upgrade=True) == {('upgrade.child', '2.0.0'), ('upgrade.leaf', '2.0.0')}
+
+
+def test_upgrade_respects_constraints_and_reports_unsatisfied(upgrade_install):
+    installed, versions, dependencies, run = upgrade_install
+    installed.extend([
+        Candidate('upgrade.child', '1.0.0', None, 'dir'),
+        Candidate('upgrade.leaf', '1.0.0', None, 'dir'),
+    ])
+    requested = [Requirement('upgrade.parent', '<2.0.0', None, 'galaxy')]
+    assert run(requested, upgrade=True) == set()
+
+    installed[:] = [Candidate(name, '2.0.0', None, 'dir') for name in
+                    ('upgrade.parent', 'upgrade.child', 'upgrade.leaf')]
+    with pytest.raises(AnsibleError, match=r'Use --force to overwrite'):
+        run(requested)
+    assert run(requested, upgrade=True) == {('upgrade.parent', '1.0.0'),
+                                          ('upgrade.child', '1.0.0'),
+                                          ('upgrade.leaf', '1.0.0')}
+
+    impossible = [Requirement('upgrade.parent', '>2.0.0', None, 'galaxy')]
+    with pytest.raises(AnsibleError, match=r'upgrade.parent:>2.0.0 \(direct request\)'):
+        run(impossible, upgrade=True, no_deps=True)
+
+
+def test_install_without_upgrade_does_not_replace_incompatible_dependency(upgrade_install):
+    installed, versions, dependencies, run = upgrade_install
+    installed[:] = [Candidate('upgrade.child', '1.0.0', None, 'dir')]
+    requested = [Requirement('upgrade.parent', '2.0.0', None, 'galaxy')]
+    with pytest.raises(AnsibleError, match=r'Use --force-with-deps to overwrite'):
+        run(requested)
+
+
+def test_unknown_installed_version_does_not_satisfy_a_pin(upgrade_install):
+    installed, versions, dependencies, run = upgrade_install
+    installed[:] = [Candidate('upgrade.parent', '*', None, 'dir')]
+    requested = [Requirement('upgrade.parent', '2.0.0', None, 'galaxy')]
+
+    with pytest.raises(AnsibleError, match=r'Use --force to overwrite'):
+        run(requested, no_deps=True)
+    assert run(requested, upgrade=True, no_deps=True) == {('upgrade.parent', '2.0.0')}
+
+
+def test_upgrade_prerelease_is_opt_in(upgrade_install):
+    installed, versions, dependencies, run = upgrade_install
+    versions['upgrade.parent'] = ['1.0.0', '2.0.0-beta.1']
+    installed[:] = []
+    assert run() == {('upgrade.parent', '1.0.0'),
+                     ('upgrade.child', '1.0.0'),
+                     ('upgrade.leaf', '1.0.0')}
+    assert run(allow_pre_release=True) == {('upgrade.parent', '2.0.0-beta.1')}
+
+    installed[:] = [Candidate(name, '1.0.0', None, 'dir') for name in
+                    ('upgrade.parent', 'upgrade.child', 'upgrade.leaf')]
+    assert run(upgrade=True) == set()
+    assert run(upgrade=True, allow_pre_release=True) == {('upgrade.parent', '2.0.0-beta.1')}
+
+    installed[:] = [Candidate('upgrade.parent', '2.0.0-beta.1', None, 'dir')]
+    assert run(no_deps=True) == {('upgrade.parent', '1.0.0')}
+    constrained = [Requirement('upgrade.parent', '<2.0.0-beta.1', None, 'galaxy')]
+    assert run(constrained, upgrade=True, no_deps=True, allow_pre_release=True) == {('upgrade.parent', '1.0.0')}
+
