diff --git a/packages/drive-store/store/_uploads/media/modernImageSupport.test.ts b/packages/drive-store/store/_uploads/media/modernImageSupport.test.ts
new file mode 100644
index 0000000..e010ad2
--- /dev/null
+++ b/packages/drive-store/store/_uploads/media/modernImageSupport.test.ts
@@ -0,0 +1,45 @@
+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+import { isPreviewAvailable } from '@proton/shared/lib/helpers/preview';
+
+jest.mock('@proton/shared/lib/helpers/browser', () => ({
+    getBrowser: jest.fn(),
+    getOS: jest.fn(),
+    isAndroid: () => false,
+    isDesktop: () => true,
+    isIos: () => false,
+    isMobile: () => false,
+    hasPDFSupport: () => false,
+}));
+
+const mockGetBrowser = getBrowser as jest.MockedFunction<typeof getBrowser>;
+const mockGetOS = getOS as jest.MockedFunction<typeof getOS>;
+
+describe('modern image support', () => {
+    it.each([
+        ['Safari', '17.0', 'Mac OS', true],
+        ['Safari', '17.1', 'iOS', true],
+        ['Mobile Safari', '17.0', 'iOS', true],
+        ['Safari', '16.6', 'Mac OS', false],
+        ['Chrome', '17.0', 'Mac OS', false],
+        ['Safari', '17.0', 'Windows', false],
+        ['Safari', undefined, 'iOS', false],
+    ])('%s %s on %s allows modern images: %s', (browser, version, os, supported) => {
+        mockGetBrowser.mockReturnValue({ name: browser, version, major: version?.split('.')[0] });
+        mockGetOS.mockReturnValue({ name: os, version: '' });
+
+        expect(isHEICSupported()).toBe(supported);
+        expect(isJXLSupported()).toBe(supported);
+        for (const type of [
+            SupportedMimeTypes.heic,
+            SupportedMimeTypes.heics,
+            SupportedMimeTypes.heif,
+            SupportedMimeTypes.heifs,
+            SupportedMimeTypes.jxl,
+        ]) {
+            expect(isSupportedImage(type)).toBe(supported);
+            expect(isPreviewAvailable(type)).toBe(supported);
+        }
+    });
+});
diff --git a/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
new file mode 100644
index 0000000..ba0de2c
--- /dev/null
+++ b/packages/drive-store/store/_uploads/mimeTypeParser/mimeTypeParser.test.ts
@@ -0,0 +1,20 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it('uses the browser-provided type when it is specific', async () => {
+        const file = new File(['image data'], 'photo.jxl', { type: 'image/png' });
+
+        await expect(mimeTypeFromFile(file)).resolves.toBe('image/png');
+    });
+
+    it.each([
+        ['photo.jxl', '', 'image/jxl'],
+        ['photo.JXL', 'application/octet-stream', 'image/jxl'],
+        ['photo.heic', '', 'image/heic'],
+        ['unknown.extension-that-does-not-exist', '', 'application/octet-stream'],
+    ])('uses the extension for %s when the browser type is %s', async (name, type, expected) => {
+        const file = new File([], name, { type });
+
+        await expect(mimeTypeFromFile(file)).resolves.toBe(expected);
+    });
+});
