+def _run_wrapper(tmpdir, arguments, fork_failure=None):
+    if sys.version_info[0] < 3:
+        pytest.skip('subprocess timeout requires Python 3')
+
+    env = os.environ.copy()
+    package_root = os.path.abspath(os.path.join(os.path.dirname(async_wrapper.__file__), '..', '..'))
+    env['PYTHONPATH'] = package_root + os.pathsep + env.get('PYTHONPATH', '')
+    env['ANSIBLE_ASYNC_DIR'] = str(tmpdir.join('jobs'))
+
+    if fork_failure is None:
+        command = [sys.executable, '-m', 'ansible.modules.async_wrapper']
+    else:
+        env['FAIL_FORK'] = str(fork_failure)
+        code = '''import errno, os
+from ansible.modules import async_wrapper
+original_fork = os.fork
+count = [0]
+def fail_selected_fork():
+    count[0] += 1
+    if count[0] == int(os.environ['FAIL_FORK']):
+        raise OSError(errno.EAGAIN, 'simulated fork failure')
+    return original_fork()
+os.fork = fail_selected_fork
+async_wrapper.main()
+'''
+        command = [sys.executable, '-c', code]
+
+    process = subprocess.Popen(command + arguments, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+    stdout, stderr = process.communicate(timeout=10)
+    assert stderr == b''
+    assert len(stdout.splitlines()) == 1
+    return process.returncode, json.loads(stdout)
+
