+@pytest.mark.skipif(not hasattr(os, 'fork'), reason='async_wrapper requires fork')
+@pytest.mark.parametrize('delay,limit,preserve_tmp', [(0, 10, False), (5, 1, False), (0, 10, True)])
+def test_async_process_lifecycle(tmpdir, delay, limit, preserve_tmp):
+    module_dir = tmpdir.mkdir('ansible-tmp-module')
+    module = module_dir.join('module.py')
+    module.write('#!%s\nimport json, time\ntime.sleep(%s)\nprint(json.dumps({"rc": 0}))\n' %
+                 (sys.executable, delay))
+    arguments = ['testjob', str(limit), str(module), '_']
+    if preserve_tmp:
+        arguments.append('-preserve_tmp')
+
+    code, immediate = _run_wrapper(tmpdir, arguments)
+    assert code == 0
+    assert immediate['started'] == 1
+    assert immediate['finished'] == 0
+    assert immediate['failed'] is False
+    assert immediate['_ansible_suppress_tmpdir_delete'] is not preserve_tmp
+
+    result_path = immediate['results_file']
+    for unused in range(100):
+        with open(result_path) as jobfile:
+            result = json.load(jobfile)
+        assert result['ansible_job_id'] == immediate['ansible_job_id']
+        if result['finished']:
+            break
+        time.sleep(0.05)
+    else:
+        pytest.fail('async job did not finish')
+
+    assert result['started'] == 1
+    if delay:
+        assert result['failed'] is True
+        assert result['timed_out'] is True
+        assert result['child_pid'] > 0
+        assert 'timed out' in result['msg']
+    else:
+        assert result['failed'] is False
+        assert result['rc'] == 0
+
+    if preserve_tmp:
+        assert module_dir.check(dir=True)
+    else:
+        for unused in range(100):
+            if not module_dir.check():
+                break
+            time.sleep(0.05)
+        assert not module_dir.check()
