--- /dev/null
+++ b/cmd/flipt/main_test.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"path/filepath"
+	"testing"
+
+	"go.uber.org/zap"
+)
+
+func TestBuildConfigWithoutFileUsesEnvironment(t *testing.T) {
+	previousCfgPath, previousDefaultCfgPath, previousFliptConfigFile := cfgPath, defaultCfgPath, fliptConfigFile
+	t.Cleanup(func() {
+		cfgPath, defaultCfgPath, fliptConfigFile = previousCfgPath, previousDefaultCfgPath, previousFliptConfigFile
+	})
+	cfgPath = ""
+	defaultCfgPath = ""
+	fliptConfigFile = filepath.Join(t.TempDir(), "missing.yml")
+	t.Setenv("FLIPT_LOG_LEVEL", "debug")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8081")
+
+	logger, cfg := buildConfig()
+	defer func() { _ = logger.Sync() }()
+
+	if cfg.Log.Level != "debug" || cfg.Server.HTTPPort != 8081 {
+		t.Fatalf("environment overrides were not applied: log level %q, HTTP port %d", cfg.Log.Level, cfg.Server.HTTPPort)
+	}
+	if !logger.Core().Enabled(zap.DebugLevel) {
+		t.Fatal("logger did not enable debug level")
+	}
+}
