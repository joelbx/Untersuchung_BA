+func TestLoadWithoutFile(t *testing.T) {
+	for _, key := range []string{"FLIPT_LOG_LEVEL", "FLIPT_SERVER_HTTP_PORT"} {
+		// Keep these cases independent of the environment running the tests.
+		t.Setenv(key, "")
+		require.NoError(t, os.Unsetenv(key))
+	}
+
+	for _, tt := range []struct {
+		name     string
+		logLevel string
+		httpPort string
+		wantPort int
+	}{
+		{name: "defaults", wantPort: 8080},
+		{name: "log level override", logLevel: "debug", wantPort: 8080},
+		{name: "HTTP port override", httpPort: "8081", wantPort: 8081},
+		{name: "both overrides", logLevel: "debug", httpPort: "8081", wantPort: 8081},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.logLevel != "" {
+				t.Setenv("FLIPT_LOG_LEVEL", tt.logLevel)
+			}
+			if tt.httpPort != "" {
+				t.Setenv("FLIPT_SERVER_HTTP_PORT", tt.httpPort)
+			}
+
+			res, err := Load("")
+			require.NoError(t, err)
+			require.NotNil(t, res)
+			assert.Empty(t, res.Warnings)
+
+			want := Default()
+			if tt.logLevel != "" {
+				want.Log.Level = tt.logLevel
+			}
+			want.Server.HTTPPort = tt.wantPort
+			assert.Equal(t, want, res.Config)
+		})
+	}
+}
+
+func TestLoadFileWithEnvironmentOverrides(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yml")
+	require.NoError(t, os.WriteFile(path, []byte("log:\n  level: WARN\n  grpc_level: DEBUG\nserver:\n  http_port: 8081\n  grpc_port: 9010\n"), 0600))
+	t.Setenv("FLIPT_LOG_LEVEL", "debug")
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8082")
+
+	res, err := Load(path)
+	require.NoError(t, err)
+	require.NotNil(t, res)
+	assert.Equal(t, "debug", res.Config.Log.Level)
+	assert.Equal(t, "DEBUG", res.Config.Log.GRPCLevel)
+	assert.Equal(t, 8082, res.Config.Server.HTTPPort)
+	assert.Equal(t, 9010, res.Config.Server.GRPCPort)
+}
