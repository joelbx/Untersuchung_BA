@@ -448,17 +456,47 @@ class InvalidLanguage(Exception):
 def format_languages(languages: Iterable) -> list[dict[str, str]]:
     """
     Format language data to match Open Library's expected format.
-    For an input of ["eng", "fre"], return:
+    For an input of ["eng", "French"], return:
     [{'key': '/languages/eng'}, {'key': '/languages/fre'}]
     """
     if not languages:
         return []
 
+    site = web.ctx.site
     formatted_languages = []
+    seen = set()
+    site_languages = None
     for language in languages:
-        if web.ctx.site.get(f"/languages/{language.lower()}") is None:
-            raise InvalidLanguage(language.lower())
-
-        formatted_languages.append({'key': f'/languages/{language.lower()}'})
+        token = language.casefold()
+        code = token if len(token) == 3 and site.get(f'/languages/{token}') else None
+
+        if code is None:
+            if site_languages is None:
+                keys = site.things({'type': '/type/language', 'limit': 10000})
+                site_languages = [
+                    lang for lang in site.get_many(keys) if not lang.deprecated
+                ]
+
+            if len(token) == 2:
+                matches = {
+                    lang.code
+                    for lang in site_languages
+                    if token in (safeget(lambda: lang['identifiers']['iso_639_1'], []) or [])
+                }
+                if len(matches) > 1:
+                    raise InvalidLanguage(token)
+                code = next(iter(matches), None) or get_marc21_language(token)
+            else:
+                try:
+                    code = get_abbrev_from_full_lang_name(language, site_languages)
+                except (LanguageMultipleMatchError, LanguageNoMatchError):
+                    raise InvalidLanguage(token) from None
+
+        if code is None or site.get(f'/languages/{code}') is None:
+            raise InvalidLanguage(token)
+
+        if code not in seen:
+            formatted_languages.append({'key': f'/languages/{code}'})
+            seen.add(code)
 
     return formatted_languages
