+class patron_check_ins(delegate.page):
+    path = r'/people/([^/]+)/check-ins'
+
+    def POST(self, username):
+        """Update a check-in owned by the signed-in patron."""
+        user = get_current_user()
+        if not user:
+            return web.unauthorized(message='Requires log-in.')
+        if user['key'].split('/')[-1] != username:
+            return web.forbidden(message='Permission denied.')
+
+        try:
+            data = json.loads(web.data())
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            return web.badrequest(message='Invalid request')
+        if not self.is_valid(data):
+            return web.badrequest(message='Invalid request')
+
+        changes = {}
+        if 'year' in data:
+            try:
+                changes['event_date'] = make_date_string(
+                    data['year'], data.get('month'), data.get('day')
+                )
+            except (TypeError, ValueError):
+                return web.badrequest(message='Invalid request')
+        if 'data' in data:
+            changes['data'] = json.dumps(data['data'])
+
+        if not BookshelvesEvents.update_event(username, data['id'], changes):
+            return web.notfound(message='Check-in not found')
+        return delegate.RawText(
+            json.dumps({'status': 'ok'}), content_type='application/json'
+        )
+
+    def is_valid(self, data: dict) -> bool:
+        """Require an event id and a date or data update."""
+        return (
+            isinstance(data, dict)
+            and data.get('id') is not None
+            and (data.get('year') is not None or 'data' in data)
+        )
 
 
