+class TestPatronCheckIns:
+    def test_is_valid_requires_id_and_updatable_content(self):
+        handler = patron_check_ins()
+
+        assert handler.is_valid({'id': 1, 'year': 2024})
+        assert handler.is_valid({'id': 1, 'data': {}})
+        assert not handler.is_valid({'year': 2024})
+        assert not handler.is_valid({'id': 1, 'month': 2, 'day': 9})
+        assert not handler.is_valid({'id': None, 'data': {}})
+        assert not handler.is_valid({'id': 1, 'year': None})
+        assert not handler.is_valid([])
+
+    def test_post_rejects_missing_content_before_database_update(self, monkeypatch):
+        update_event = Mock()
+        monkeypatch.setattr(checkins, 'get_current_user', lambda: {'key': '/people/alice'})
+        monkeypatch.setattr(checkins.web, 'data', lambda: b'{"id": 1}')
+        monkeypatch.setattr(checkins.web.ctx, 'headers', [], raising=False)
+        monkeypatch.setattr(checkins.BookshelvesEvents, 'update_event', update_event)
+
+        response = patron_check_ins().POST('alice')
+
+        assert isinstance(response, checkins.web.badrequest)
+        update_event.assert_not_called()
+
+    def test_post_normalizes_date_and_scopes_update_to_patron(self, monkeypatch):
+        update_event = Mock(return_value=1)
+        monkeypatch.setattr(checkins, 'get_current_user', lambda: {'key': '/people/alice'})
+        monkeypatch.setattr(
+            checkins.web,
+            'data',
+            lambda: json.dumps(
+                {'id': 7, 'year': 2024, 'month': 2, 'day': 9, 'data': {'pages': 50}}
+            ).encode(),
+        )
+        monkeypatch.setattr(checkins.BookshelvesEvents, 'update_event', update_event)
+
+        patron_check_ins().POST('alice')
+
+        update_event.assert_called_once_with(
+            'alice', 7, {'event_date': '2024-02-09', 'data': '{"pages": 50}'}
+        )
+
+    def test_post_rejects_another_patron_before_database_update(self, monkeypatch):
+        update_event = Mock()
+        monkeypatch.setattr(checkins, 'get_current_user', lambda: {'key': '/people/alice'})
+        monkeypatch.setattr(checkins.web.ctx, 'headers', [], raising=False)
+        monkeypatch.setattr(checkins.BookshelvesEvents, 'update_event', update_event)
+
+        response = patron_check_ins().POST('bob')
+
+        assert isinstance(response, checkins.web.forbidden)
+        update_event.assert_not_called()
