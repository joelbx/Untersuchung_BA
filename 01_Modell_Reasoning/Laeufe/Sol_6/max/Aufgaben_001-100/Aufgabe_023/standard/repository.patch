diff --git a/internal/config/authentication_database_test.go b/internal/config/authentication_database_test.go
new file mode 100644
index 0000000..a3c2324
--- /dev/null
+++ b/internal/config/authentication_database_test.go
@@ -0,0 +1,53 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	for _, method := range []struct {
+		name     string
+		method   auth.Method
+		requires bool
+	}{
+		{"token", auth.Method_METHOD_TOKEN, true},
+		{"github", auth.Method_METHOD_GITHUB, true},
+		{"oidc", auth.Method_METHOD_OIDC, true},
+		{"kubernetes", auth.Method_METHOD_KUBERNETES, true},
+		{"jwt", auth.Method_METHOD_JWT, false},
+	} {
+		t.Run(method.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{Required: true}
+			assert.False(t, cfg.RequiresDatabase(), "required authentication alone does not need a database")
+
+			for _, info := range cfg.Methods.AllMethods() {
+				if info.Method == method.method {
+					assert.Equal(t, method.requires, info.RequiresDatabase)
+					info.SetCleanup(t, AuthenticationCleanupSchedule{Interval: time.Hour})
+					assert.False(t, cfg.RequiresDatabase(), "disabled method must be ignored")
+					assert.False(t, cfg.ShouldRunCleanup(), "disabled method must be ignored")
+					info.Enable(t)
+					assert.Equal(t, method.requires, cfg.RequiresDatabase())
+					assert.Equal(t, method.requires, cfg.ShouldRunCleanup())
+				}
+			}
+		})
+	}
+
+	cfg := AuthenticationConfig{}
+	cfg.Methods.JWT.Enabled = true
+	cfg.Methods.JWT.Cleanup = &AuthenticationCleanupSchedule{Interval: time.Hour}
+	assert.False(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+
+	cfg.Methods.Token.Enabled = true
+	assert.True(t, cfg.RequiresDatabase())
+	assert.False(t, cfg.ShouldRunCleanup())
+
+	cfg.Methods.Token.Cleanup = &AuthenticationCleanupSchedule{Interval: time.Hour}
+	assert.True(t, cfg.ShouldRunCleanup())
+}
