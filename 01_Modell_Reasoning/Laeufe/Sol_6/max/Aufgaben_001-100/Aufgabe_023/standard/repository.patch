diff --git a/internal/cmd/authn_test.go b/internal/cmd/authn_test.go
new file mode 100644
index 0000000..9fe1334
--- /dev/null
+++ b/internal/cmd/authn_test.go
@@ -0,0 +1,51 @@
+package cmd
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap/zaptest"
+)
+
+func TestAuthenticationGRPCJWTWithoutDatabase(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	publicKey, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
+	require.NoError(t, err)
+	keyFile := filepath.Join(t.TempDir(), "jwt-public.pem")
+	require.NoError(t, os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: publicKey}), 0600))
+
+	for _, storageType := range []config.StorageType{
+		config.LocalStorageType,
+		config.GitStorageType,
+		config.OCIStorageType,
+		config.ObjectStorageType,
+	} {
+		t.Run(string(storageType), func(t *testing.T) {
+			dbFile := filepath.Join(t.TempDir(), "unexpected.db")
+			cfg := &config.Config{}
+			cfg.Storage.Type = storageType
+			cfg.Database.URL = "file:" + dbFile
+			cfg.Authentication.Required = true
+			cfg.Authentication.Methods.JWT.Enabled = true
+			cfg.Authentication.Methods.JWT.Method.PublicKeyFile = keyFile
+			cfg.Authentication.Methods.JWT.Cleanup = &config.AuthenticationCleanupSchedule{Interval: time.Hour}
+
+			register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zaptest.NewLogger(t), cfg, false, false)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, shutdown(context.Background())) })
+			require.Len(t, register, 2)
+			require.Len(t, interceptors, 3)
+			require.NoFileExists(t, dbFile)
+		})
+	}
+}
