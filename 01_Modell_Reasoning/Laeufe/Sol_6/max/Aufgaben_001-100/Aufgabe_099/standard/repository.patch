+func TestBatchEvaluate_DisabledFlags(t *testing.T) {
+	store := &storeMock{}
+	s := &Server{logger: logger, store: store}
+
+	store.On("GetFlag", mock.Anything, "off").Return(&flipt.Flag{Key: "off"}, nil).Twice()
+	store.On("GetFlag", mock.Anything, "on").Return(&flipt.Flag{Key: "on", Enabled: true}, nil).Twice()
+	store.On("GetEvaluationRules", mock.Anything, "on").Return([]*storage.EvaluationRule{{
+		ID: "rule", FlagKey: "on", SegmentKey: "segment", SegmentMatchType: flipt.MatchType_ALL_MATCH_TYPE,
+	}}, nil).Twice()
+	store.On("GetEvaluationDistributions", mock.Anything, "rule").Return([]*storage.EvaluationDistribution{}, nil).Twice()
+
+	requests := []*flipt.EvaluationRequest{
+		{FlagKey: "off", EntityId: "first", Context: map[string]string{"order": "1"}},
+		{FlagKey: "on", EntityId: "second", Context: map[string]string{"order": "2"}},
+		{FlagKey: "off", EntityId: "third", Context: map[string]string{"order": "3"}},
+		{FlagKey: "on", EntityId: "fourth", Context: map[string]string{"order": "4"}},
+	}
+	resp, err := s.BatchEvaluate(context.Background(), &flipt.BatchEvaluationRequest{
+		RequestId: "batch-id", Requests: requests,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, resp)
+	assert.Equal(t, "batch-id", resp.RequestId)
+	assert.Greater(t, resp.RequestDurationMillis, float64(0))
+	require.Len(t, resp.Responses, len(requests))
+	for i, entry := range resp.Responses {
+		require.NotNil(t, entry)
+		assert.Equal(t, requests[i].FlagKey, entry.FlagKey)
+		assert.Equal(t, requests[i].EntityId, entry.EntityId)
+		assert.Equal(t, requests[i].Context, entry.RequestContext)
+		assert.Empty(t, entry.RequestId)
+		require.NotNil(t, entry.Timestamp)
+		assert.NoError(t, entry.Timestamp.CheckValid())
+		assert.Greater(t, entry.RequestDurationMillis, float64(0))
+		assert.GreaterOrEqual(t, resp.RequestDurationMillis, entry.RequestDurationMillis)
+		assert.Equal(t, i%2 == 0, entry.Disabled)
+		assert.Equal(t, i%2 != 0, entry.Match)
+		if entry.Disabled {
+			assert.Empty(t, entry.Value)
+			assert.Empty(t, entry.SegmentKey)
+		} else {
+			assert.Equal(t, "segment", entry.SegmentKey)
+		}
+	}
+
+	// The disabled marker must survive serialization to reach API clients.
+	data, err := proto.Marshal(resp.Responses[0])
+	require.NoError(t, err)
+	var decoded flipt.EvaluationResponse
+	require.NoError(t, proto.Unmarshal(data, &decoded))
+	assert.True(t, decoded.Disabled)
+	jsonData, err := (&runtime.JSONPb{OrigName: true}).Marshal(resp.Responses[0])
+	require.NoError(t, err)
+	assert.Contains(t, string(jsonData), `"disabled":true`)
+	store.AssertExpectations(t)
+}
