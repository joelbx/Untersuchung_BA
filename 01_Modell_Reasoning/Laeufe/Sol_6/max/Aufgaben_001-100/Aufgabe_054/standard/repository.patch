+func TestGetInstanceValueAndPointer(t *testing.T) {
+	type instance struct{ id int }
+	var valueCalls, pointerCalls int
+
+	value := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 1}
+	})
+	valueAgain := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 2}
+	})
+	pointer := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 3}
+	})
+	pointerAgain := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 4}
+	})
+
+	if value != valueAgain || value.id != 1 || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", value, valueAgain, valueCalls)
+	}
+	if pointer != pointerAgain || pointer.id != 3 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", pointer, pointerAgain, pointerCalls)
+	}
+}
+
+func TestGetInstanceNilInterface(t *testing.T) {
+	type instance interface{ String() string }
+	var calls int
+	constructor := func() instance {
+		calls++
+		return nil
+	}
+
+	if got := singleton.GetInstance(constructor); got != nil {
+		t.Fatalf("first instance = %v, want nil", got)
+	}
+	if got := singleton.GetInstance(constructor); got != nil {
+		t.Fatalf("second instance = %v, want nil", got)
+	}
+	if calls != 1 {
+		t.Fatalf("constructor called %d times, want once", calls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type instance struct{ id int32 }
+	const maxCalls = 20_000
+	var creations int32
+	constructor := func() *instance {
+		return &instance{id: atomic.AddInt32(&creations, 1)}
+	}
+
+	results := make([]*instance, maxCalls)
+	start := make(chan struct{})
+	var ready sync.WaitGroup
+	var done sync.WaitGroup
+	ready.Add(maxCalls)
+	done.Add(maxCalls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			ready.Done()
+			<-start
+			results[i] = singleton.GetInstance(constructor)
+		}(i)
+	}
+	ready.Wait()
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&creations); got != 1 {
+		t.Fatalf("constructor called %d times, want once", got)
+	}
+	first := results[0]
+	if first == nil || first.id != 1 {
+		t.Fatalf("first instance = %v, want instance with id 1", first)
+	}
+	for i, result := range results {
+		if result != first {
+			t.Fatalf("call %d returned %p, want %p", i, result, first)
+		}
+	}
+	if got := singleton.GetInstance(constructor); got != first {
+		t.Fatalf("subsequent call returned %p, want %p", got, first)
+	}
+	if got := atomic.LoadInt32(&creations); got != 1 {
+		t.Fatalf("constructor called %d times after subsequent call, want once", got)
+	}
+}
