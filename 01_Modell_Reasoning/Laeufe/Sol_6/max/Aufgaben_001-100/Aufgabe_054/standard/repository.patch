+// GetInstance returns the singleton for T, calling constructor once for each distinct type.
+func GetInstance[T any](constructor func() T) T {
+	instanceType := reflect.TypeOf((*T)(nil)).Elem()
+	stored, _ := genericInstances.LoadOrStore(instanceType, &genericEntry[T]{})
+	entry := stored.(*genericEntry[T])
+	entry.once.Do(func() {
+		entry.value = constructor()
+		log.Trace("Created new singleton", "object", instanceType.String(), "instance", entry.value)
+	})
+	return entry.value
+}
