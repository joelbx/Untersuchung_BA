 func (s *RolesTestSuite) TestEquivalence(c *check.C) {
@@ -67,4 +77,28 @@ func (s *RolesTestSuite) TestEquivalence(c *check.C) {
 	c.Assert(authRole.Equals(nodeProxyRole), check.Equals, false)
 	c.Assert(authRole.Equals(teleport.Roles{teleport.RoleAuth, teleport.RoleAdmin}),
 		check.Equals, true)
+
+	for _, test := range []struct {
+		name  string
+		left  teleport.Roles
+		right teleport.Roles
+		equal bool
+	}{
+		{"nil and empty", nil, teleport.Roles{}, true},
+		{"same set with duplicate", teleport.Roles{teleport.RoleAuth},
+			teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}, true},
+		{"same set in different order", teleport.Roles{teleport.RoleAuth, teleport.RoleNode},
+			teleport.Roles{teleport.RoleNode, teleport.RoleAuth}, true},
+		{"different role with duplicate", teleport.Roles{teleport.RoleAuth, teleport.RoleAuth},
+			teleport.Roles{teleport.RoleAuth, teleport.RoleNode}, false},
+		{"missing distinct role", teleport.Roles{teleport.RoleAuth, teleport.RoleNode},
+			teleport.Roles{teleport.RoleAuth}, false},
+		{"different roles", teleport.Roles{teleport.RoleAuth},
+			teleport.Roles{teleport.RoleNode}, false},
+	} {
+		c.Assert(test.left.Equals(test.right), check.Equals, test.equal,
+			check.Commentf("%s (left to right)", test.name))
+		c.Assert(test.right.Equals(test.left), check.Equals, test.equal,
+			check.Commentf("%s (right to left)", test.name))
+	}
 }
