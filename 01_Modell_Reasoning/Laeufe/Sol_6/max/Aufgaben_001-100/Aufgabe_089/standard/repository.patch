+			require.Len(t, issues, 2)
+			assert.Equal(t, `flag default/flag rule 0 references unknown segment "missing-segment" (state/features.yaml 15:18)`, issues[0].Error())
+			assert.Equal(t, `flag default/flag rule 0 references unknown variant "missing-variant" (state/features.yaml 17:22)`, issues[1].Error())
+		})
+	}
