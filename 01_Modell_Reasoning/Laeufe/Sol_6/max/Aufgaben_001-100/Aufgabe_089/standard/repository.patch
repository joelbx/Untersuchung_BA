+func TestValidate_UnknownReferences(t *testing.T) {
+	const config = `version: "1.2"
+namespace: staging
+segments:
+  - key: known
+    name: Known
+    match_type: ALL_MATCH_TYPE
+flags:
+  - key: my-flag
+    name: My Flag
+    variants:
+      - key: known
+        name: Known
+    rules:
+      - segment: missing-segment
+        distributions:
+          - variant: missing-variant
+            rollout: 100
+      - segment:
+          keys: [known, another-missing-segment]
+        distributions:
+          - variant: known
+            rollout: 100
+  - key: bool-flag
+    name: Boolean Flag
+    type: BOOLEAN_FLAG_TYPE
+    rules:
+      - segment: missing-for-boolean
+        distributions: []
+`
+	v, err := NewFeaturesValidator()
+	require.NoError(t, err)
+	err = v.Validate("refs.yaml", []byte(config))
+	require.Error(t, err)
+	issues, ok := Unwrap(err)
+	require.True(t, ok)
+	require.Len(t, issues, 4)
+	assert.Equal(t, `flag staging/my-flag rule 0 references unknown segment "missing-segment" (refs.yaml 14:18)`, issues[0].Error())
+	assert.Equal(t, `flag staging/my-flag rule 0 references unknown variant "missing-variant" (refs.yaml 16:22)`, issues[1].Error())
+	assert.Equal(t, `flag staging/my-flag rule 1 references unknown segment "another-missing-segment" (refs.yaml 19:25)`, issues[2].Error())
+	assert.Equal(t, `flag staging/bool-flag rule 0 references unknown segment "missing-for-boolean" (refs.yaml 27:18)`, issues[3].Error())
 }
