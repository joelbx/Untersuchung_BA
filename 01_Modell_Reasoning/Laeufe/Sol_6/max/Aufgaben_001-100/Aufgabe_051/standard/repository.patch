@@ -656,6 +656,45 @@ func TestReadClusterFlag(t *testing.T) {
 	}
 }
 
+func TestReadKubeClusterFlag(t *testing.T) {
+	tests := []struct {
+		name            string
+		cliCluster      string
+		envCluster      string
+		expectedCluster string
+	}{
+		{name: "nothing set"},
+		{
+			name:            "environment set",
+			envCluster:      "dev",
+			expectedCluster: "dev",
+		},
+		{
+			name:            "CLI set",
+			cliCluster:      "prod",
+			expectedCluster: "prod",
+		},
+		{
+			name:            "CLI takes precedence",
+			cliCluster:      "prod",
+			envCluster:      "dev",
+			expectedCluster: "prod",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cf := CLIConf{KubernetesCluster: tt.cliCluster}
+			readKubeClusterFlag(&cf, func(name string) string {
+				if name == kubeClusterEnvVar {
+					return tt.envCluster
+				}
+				return ""
+			})
+			require.Equal(t, tt.expectedCluster, cf.KubernetesCluster)
+		})
+	}
+}
