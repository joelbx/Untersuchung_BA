+// readKubeClusterFlag selects the Kubernetes cluster from the environment
+// unless one was specified on the command line.
+func readKubeClusterFlag(cf *CLIConf, fn envGetter) {
+	if cf.KubernetesCluster == "" {
+		cf.KubernetesCluster = fn(kubeClusterEnvVar)
+	}
