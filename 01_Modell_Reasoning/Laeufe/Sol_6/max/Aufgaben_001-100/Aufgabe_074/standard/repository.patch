+    def test_required_typed_lists(self):
+        def integers(values: list[int]):
+            return values
+
+        def strings(values: list[str]):
+            return values
+
+        for fn, tokens, expected in (
+            (integers, ['1', '2', '3'], [1, 2, 3]),
+            (strings, ['one', 'two'], ['one', 'two']),
+        ):
+            cli = FnToCLI(fn)
+            assert cli.parse_args(tokens).values == expected
+            assert cli.run() == expected
+            with pytest.raises(SystemExit):
+                cli.parse_args([])
+
+    def test_paths_and_optional_typed_lists(self):
+        def fn(
+            output: Path,
+            files: list[Path] | None,
+            weights: list[float] | None = None,
+        ):
+            return output, files, weights
+
+        cli = FnToCLI(fn)
+        assert cli.parse_args(['out.txt']).files is None
+        assert cli.run() == (Path('out.txt'), None, None)
+
+        cli.parse_args(
+            ['out.txt', '--files', 'a.txt', 'b.txt', '--weights', '1.5', '2.25']
+        )
+        assert cli.run() == (
+            Path('out.txt'),
+            [Path('a.txt'), Path('b.txt')],
+            [1.5, 2.25],
+        )
+
+    def test_option_names_match_parameter_names(self):
+        def fn(input_files: list[Path] | None = None):
+            return input_files
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--input_files', 'a.txt', 'b.txt'])
+        assert cli.args_dict() == {'input_files': [Path('a.txt'), Path('b.txt')]}
+        assert cli.run() == [Path('a.txt'), Path('b.txt')]
+
+        cli.parse_args(['--input-files', 'c.txt'])
+        assert cli.run() == [Path('c.txt')]
+
+    def test_async_run_returns_result(self):
+        async def fn(value: int):
+            return value * 2
+
+        cli = FnToCLI(fn)
