+# (c) 2018 Red Hat, Inc.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.modules.net_tools.nios import nios_fixed_address
+from units.compat.mock import Mock, patch
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+
+
+class TestNiosFixedAddress(ModuleTestCase):
+
+    def setUp(self):
+        super(TestNiosFixedAddress, self).setUp()
+        mock_connector = patch('ansible.module_utils.net_tools.nios.api.get_connector')
+        self.connector = mock_connector.start().return_value
+        self.addCleanup(mock_connector.stop)
+        self.args = dict(name='printer', ipaddr='192.0.2.10', mac='00:11:22:33:44:55',
+                         network='192.0.2.0/24', provider={})
+
+    def run_module(self, **overrides):
+        args = self.args.copy()
+        args.update(overrides)
+        set_module_args(args)
+        with self.assertRaises(AnsibleExitJson) as exc:
+            nios_fixed_address.main()
+        return exc.exception.args[0]
+
+    def failed_module(self, **overrides):
+        args = self.args.copy()
+        args.update(overrides)
+        set_module_args(args)
+        with self.assertRaises(AnsibleFailJson) as exc:
+            nios_fixed_address.main()
+        return exc.exception.args[0]
+
+    def fixed_object(self, address_field='ipv4addr', address='192.0.2.10', **fields):
+        obj = dict(_ref='fixedaddress/ref', name='printer', mac=self.args['mac'],
+                   network=self.args['network'], network_view='default')
+        obj[address_field] = address
+        obj.update(fields)
+        return obj
+
+    def test_ipv4_create_then_idempotent(self):
+        self.connector.get_object.return_value = None
+        result = self.run_module()
+        self.assertTrue(result['changed'])
+        self.connector.create_object.assert_called_once_with('fixedaddress', {
+            'name': 'printer', 'ipv4addr': '192.0.2.10', 'mac': self.args['mac'],
+            'network': self.args['network'], 'network_view': 'default'})
+        lookup_args, lookup_kwargs = self.connector.get_object.call_args
+        self.assertEqual(lookup_args, ('fixedaddress', {
+            'ipv4addr': '192.0.2.10', 'mac': self.args['mac'],
+            'network': self.args['network'], 'network_view': 'default'}))
+        self.assertIn('name', lookup_kwargs['return_fields'])
+
+        self.connector.create_object.reset_mock()
+        self.connector.get_object.return_value = [self.fixed_object()]
+        self.assertFalse(self.run_module()['changed'])
+        self.connector.create_object.assert_not_called()
+        self.connector.update_object.assert_not_called()
+
+    def test_ipv6_create_then_idempotent(self):
+        self.args.update(ipaddr='2001:db8::10', network='2001:db8::/64')
+        self.connector.get_object.return_value = None
+        self.assertTrue(self.run_module()['changed'])
+        self.connector.create_object.assert_called_once_with('ipv6fixedaddress', {
+            'name': 'printer', 'ipv6addr': '2001:db8::10', 'mac': self.args['mac'],
+            'network': self.args['network'], 'network_view': 'default'})
+
+        self.connector.create_object.reset_mock()
+        self.connector.get_object.return_value = [self.fixed_object(
+            address_field='ipv6addr', address='2001:db8::10')]
+        self.assertFalse(self.run_module()['changed'])
+        self.connector.create_object.assert_not_called()
+
+    def test_custom_view_and_numbered_option(self):
+        self.connector.get_object.return_value = None
+        self.assertTrue(self.run_module(
+            network_view='blue', options=[{'num': 42, 'value': 'answer',
+                                           'use_option': False, 'vendor_class': 'CUSTOM'}])['changed'])
+        lookup_args, _ = self.connector.get_object.call_args
+        self.assertEqual(lookup_args[1]['network_view'], 'blue')
+        self.assertEqual(self.connector.create_object.call_args[0][1]['options'], [{
+            'num': 42, 'value': 'answer', 'use_option': False, 'vendor_class': 'CUSTOM'}])
+
+    def test_options_ignore_explicit_null_fields(self):
+        module = Mock()
+        module.params = {'options': [{'num': 42, 'name': None, 'value': 'answer',
+                                      'use_option': None, 'vendor_class': None}]}
+        self.assertEqual(nios_fixed_address.options(module), [{'num': 42, 'value': 'answer'}])
+
+    def test_update_metadata_and_options_without_creating_duplicate(self):
+        self.connector.get_object.return_value = [self.fixed_object(
+            comment='old', options=[{'name': 'domain-name', 'value': 'old.example'}],
+            extattrs={'Site': {'value': 'old'}})]
+        desired = dict(name='new-printer', comment='new', extattrs={'Site': 'new'},
+                       options=[{'name': 'domain-name', 'value': 'new.example'}])
+        self.assertTrue(self.run_module(**desired)['changed'])
+        self.connector.create_object.assert_not_called()
+        self.connector.update_object.assert_called_once_with('fixedaddress/ref', {
+            'name': 'new-printer', 'ipv4addr': '192.0.2.10', 'mac': self.args['mac'],
+            'network': self.args['network'], 'comment': 'new',
+            'extattrs': {'Site': {'value': 'new'}},
+            'options': [{'name': 'domain-name', 'value': 'new.example',
+                         'use_option': True, 'vendor_class': 'DHCP'}]})
+
+        self.connector.update_object.reset_mock()
+        self.connector.get_object.return_value = [self.fixed_object(
+            name='new-printer', comment='new', extattrs={'Site': {'value': 'new'}},
+            options=[{'name': 'domain-name', 'value': 'new.example'}])]
+        self.assertFalse(self.run_module(**desired)['changed'])
+        self.connector.update_object.assert_not_called()
+
+    def test_clear_options_and_extattrs(self):
+        self.connector.get_object.return_value = [self.fixed_object(
+            options=[{'name': 'domain-name', 'value': 'old.example'}],
+            extattrs={'Site': {'value': 'old'}})]
+        self.assertTrue(self.run_module(options=[], extattrs={})['changed'])
+        self.connector.update_object.assert_called_once_with('fixedaddress/ref', {
+            'name': 'printer', 'ipv4addr': '192.0.2.10', 'mac': self.args['mac'],
+            'network': self.args['network'], 'options': [], 'extattrs': {}})
+
+        self.connector.update_object.reset_mock()
+        self.connector.get_object.return_value = [self.fixed_object()]
+        self.assertFalse(self.run_module(options=[], extattrs={})['changed'])
+        self.connector.update_object.assert_not_called()
+
+    def test_delete_and_check_mode(self):
+        self.connector.get_object.return_value = [self.fixed_object()]
+        self.assertTrue(self.run_module(state='absent', _ansible_check_mode=True)['changed'])
+        self.connector.delete_object.assert_not_called()
+
+        self.assertTrue(self.run_module(state='absent')['changed'])
+        self.connector.delete_object.assert_called_once_with('fixedaddress/ref')
+
+        self.connector.delete_object.reset_mock()
+        self.connector.get_object.return_value = None
+        self.assertFalse(self.run_module(state='absent')['changed'])
+        self.assertTrue(self.run_module(_ansible_check_mode=True)['changed'])
+        self.connector.create_object.assert_not_called()
+        self.connector.delete_object.assert_not_called()
+
+    def test_multiple_ipv6_results_select_matching_identity(self):
+        self.args.update(ipaddr='2001:db8::10', network='2001:db8::/64')
+        other = self.fixed_object(address_field='ipv6addr', address='2001:db8::11')
+        current = self.fixed_object(address_field='ipv6addr', address='2001:db8::10', comment='old')
+        self.connector.get_object.return_value = [other, current]
+        self.assertTrue(self.run_module(comment='new')['changed'])
+        self.connector.update_object.assert_called_once()
+
+    def test_invalid_ip_and_options_are_rejected(self):
+        self.assertIn('IPv4 or IPv6', self.failed_module(ipaddr='not-an-ip')['msg'])
+        self.assertIn('name', self.failed_module(options=[{'value': 'x'}])['msg'])
+        self.assertIn('value', self.failed_module(options=[{'name': 'domain-name', 'value': None}])['msg'])
+
+    def test_provider_is_required(self):
+        args = self.args.copy()
+        del args['provider']
+        set_module_args(args)
+        with self.assertRaises(AnsibleFailJson) as exc:
+            nios_fixed_address.main()
+        self.assertIn('provider', exc.exception.args[0]['msg'])
