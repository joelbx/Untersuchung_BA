-    def __init__(self, message, import_traceback):
+    def __init__(self, message, import_traceback, module=None):
         super(MissingModuleError, self).__init__(message)
         self.import_traceback = import_traceback
+        self.module = module
+
+
+class GzipDecodedReader(gzip.GzipFile if HAS_GZIP else object):
+    """Read a gzip response while retaining its HTTP response metadata."""
+
+    def __init__(self, fp):
+        if not HAS_GZIP:
+            raise MissingModuleError(self.missing_gzip_error(), GZIP_IMPORT_ERROR, module='gzip')
+
+        self._response = fp
+        gzip.GzipFile.__init__(self, fileobj=fp, mode='rb')
+        # Callers of urllib responses use fp to check whether a body is present.
+        # The response itself is the readable stream on both Python 2 and 3.
+        self.fp = getattr(fp, 'fp', fp)
+
+    def __getattr__(self, name):
+        return getattr(self._response, name)
+
+    def close(self):
+        try:
+            super(GzipDecodedReader, self).close()
+        finally:
+            self._response.close()
+            self.fp = None
+
+    @staticmethod
+    def missing_gzip_error():
+        return missing_required_lib('gzip', reason='to decompress gzip-encoded HTTP responses')
 
 
