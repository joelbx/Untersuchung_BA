+++ b/test/units/module_utils/urls/test_gzip.py
@@ -0,0 +1,264 @@
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import gzip
+import io
+
+import pytest
+
+from ansible.module_utils import urls
+from ansible.modules import get_url, uri
+
+
+URL = 'http://example.com/data'
+PAYLOAD = b'{"items": [' + b'"repeated value", ' * 200 + b'"end"]}'
+
+
+class Socket:
+    def __init__(self, data):
+        self.data = data
+
+    def makefile(self, *args, **kwargs):
+        return io.BytesIO(self.data)
+
+
+class Response:
+    def __init__(self, body, encoding=None, content_type=None):
+        header = b'HTTP/1.1 200 OK\r\nContent-Length: %d\r\nX-Mixed-Case: value\r\n' % len(body)
+        if encoding:
+            header += b'Content-Encoding: ' + encoding + b'\r\n'
+        if content_type:
+            header += b'Content-Type: ' + content_type + b'\r\n'
+        self.fp = urls.httplib.HTTPResponse(Socket(header + b'\r\n' + body))
+        self.fp.begin()
+        self.headers = getattr(self.fp, 'headers', self.fp.msg)
+        self.code = 200
+        self.closed = False
+
+    def read(self, size=None):
+        return self.fp.read(size)
+
+    def info(self):
+        return self.headers
+
+    def geturl(self):
+        return URL
+
+    def close(self):
+        self.fp.close()
+        self.fp = None
+        self.closed = True
+
+
+class Module:
+    params = {}
+    tmpdir = None
+
+    def __init__(self):
+        self.deprecations = []
+
+    def deprecate(self, message, version):
+        self.deprecations.append((message, version))
+
+    def fail_json(self, **kwargs):
+        raise AssertionError(kwargs)
+
+
+def compressed(data):
+    stream = io.BytesIO()
+    with gzip.GzipFile(fileobj=stream, mode='wb') as writer:
+        writer.write(data)
+    return stream.getvalue()
+
+
+def test_gzip_decoded_reader_accepts_file_object_without_fp():
+    source = io.BytesIO(compressed(PAYLOAD))
+    reader = urls.GzipDecodedReader(source)
+    assert reader.read() == PAYLOAD
+    reader.close()
+    assert source.closed
+
+
+@pytest.mark.parametrize('decompress', [None, True, False])
+def test_request_gzip_response(mocker, decompress):
+    body = compressed(PAYLOAD)
+    response = Response(body, b'gzip')
+    assert len(body) < len(PAYLOAD)
+    mocker.patch.object(urls.urllib_request, 'install_opener')
+    urlopen = mocker.patch.object(urls.urllib_request, 'urlopen', return_value=response)
+
+    kwargs = {} if decompress is None else {'decompress': decompress}
+    reader = urls.Request().open('GET', URL, **kwargs)
+    request = urlopen.call_args[0][0]
+    assert request.headers['Accept-encoding'] == 'gzip'
+    assert reader.headers.get('Content-Encoding') == 'gzip'
+
+    if decompress is False:
+        assert reader is response
+        assert reader.read() == body
+    else:
+        assert isinstance(reader, urls.GzipDecodedReader)
+        assert reader.read(7) + reader.read() == PAYLOAD
+        reader.close()
+        assert response.closed
+
