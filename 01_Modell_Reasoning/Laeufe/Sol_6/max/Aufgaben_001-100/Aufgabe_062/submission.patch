+
+func TestContextReader_MaybeRestoreTerm(t *testing.T) {
+	restoreErr := errors.New("restore failed")
+	mockTerm := &fakeTerm{restoreErr: restoreErr}
+	savedState := &term.State{}
+	cr := &ContextReader{
+		term:              mockTerm,
+		fd:                1,
+		mu:                &sync.Mutex{},
+		previousTermState: savedState,
+	}
+	cr.mu.Lock()
+	defer cr.mu.Unlock()
+
+	require.NoError(t, cr.maybeRestoreTerm()) // idle, despite saved state
+	require.Zero(t, mockTerm.restoreCalls)
+	cr.state = readerStatePassword
+	cr.previousTermState = nil
+	require.NoError(t, cr.maybeRestoreTerm()) // password, without saved state
+	require.Zero(t, mockTerm.restoreCalls)
+	cr.previousTermState = savedState
+	require.ErrorIs(t, cr.maybeRestoreTerm(), restoreErr)
