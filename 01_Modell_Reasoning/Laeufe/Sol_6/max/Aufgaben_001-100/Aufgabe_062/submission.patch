+package prompt
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNotifyExitRestoresPassword(t *testing.T) {
+	stdinMU.Lock()
+	previous := stdin
+	stdinMU.Unlock()
+	t.Cleanup(func() { SetStdin(previous) })
+
+	cr, mockTerm, pr, pw := newPasswordTestReader(t)
+	defer pr.Close()
+	defer pw.Close()
+	SetStdin(cr)
+
+	result := make(chan readOutcome, 1)
+	go func() {
+		value, err := cr.ReadPassword(context.Background())
+		result <- readOutcome{value: value, err: err}
+	}()
+	<-mockTerm.readStarted
+
+	NotifyExit()
+	require.Equal(t, 1, mockTerm.restoreCalls)
+	require.ErrorIs(t, (<-result).err, ErrReaderClosed)
+	NotifyExit() // repeated exit notifications are harmless
+	require.Equal(t, 1, mockTerm.restoreCalls)
+}
