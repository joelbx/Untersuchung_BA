+func TestContextReader_PasswordDeadline(t *testing.T) {
+	cr, term, pr, pw := newPasswordTestReader(t)
+	defer pr.Close()
+	defer pw.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	result := make(chan readOutcome, 1)
+	go func() {
+		value, err := cr.ReadPassword(ctx)
+		result <- readOutcome{value: value, err: err}
+	}()
+	<-term.readStarted
+
+	got := <-result
+	require.ErrorIs(t, got.err, context.DeadlineExceeded)
+	require.Empty(t, got.value)
+	require.Equal(t, 1, term.restoreCalls)
+	cr.mu.Lock()
+	state := cr.state
+	cr.mu.Unlock()
+	require.Equal(t, readerStateClean, state)
+
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := pw.Write([]byte("next read"))
+		writeDone <- err
+	}()
+	value, err := cr.ReadContext(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, "next read", string(value))
+	require.NoError(t, <-writeDone)
+}
+
