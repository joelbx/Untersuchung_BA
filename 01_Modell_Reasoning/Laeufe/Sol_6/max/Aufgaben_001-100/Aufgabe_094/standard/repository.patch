+type DiagResult struct {
+	HasCompileSupport       bool
+	HasSignature            bool
+	HasEntitlements         bool
+	PassedLAPolicyTest      bool
+	PassedSecureEnclaveTest bool
+	IsAvailable             bool
+}
+
+// Diag checks whether this binary and device can use Touch ID. The individual
+// results identify why Touch ID is unavailable; failed checks are not errors.
+func Diag() (*DiagResult, error) {
+	result, err := diagNative()
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	result.IsAvailable = result.HasCompileSupport && result.HasSignature &&
+		result.HasEntitlements && result.PassedLAPolicyTest &&
+		result.PassedSecureEnclaveTest
+	return result, nil
+}
