+import { act, renderHook } from '@testing-library/react-hooks';
+
+import { RESPONSE_CODE } from '@proton/shared/lib/drive/constants';
+
+import useLink from './useLink';
+
+const mockRequest = jest.fn();
+const mockGetLink = jest.fn();
+const mockSetLinks = jest.fn();
+
+jest.mock('../_api/useDebouncedRequest', () => () => mockRequest);
+jest.mock(
+    '../_utils/useDebouncedFunction',
+    () => () => (callback: (signal: AbortSignal) => Promise<unknown>) => callback(new AbortController().signal)
+);
+jest.mock('../_crypto/useDriveCrypto', () => () => ({ getVerificationKey: jest.fn() }));
+jest.mock('../_shares/useShare', () => () => ({ getSharePrivateKey: jest.fn() }));
+jest.mock('./useLinksKeys', () => () => ({}));
+jest.mock('./useLinksState', () => () => ({
+    getLink: mockGetLink,
+    setLinks: mockSetLinks,
+    setCachedThumbnail: jest.fn(),
+}));
+
+const abortSignal = new AbortController().signal;
+const linkResponse = (linkId: string) => ({ Link: { LinkID: linkId, ShareIDs: [], ShareUrls: [] } });
+
+describe('useLink failed fetch backoff', () => {
+    beforeEach(() => {
+        jest.useFakeTimers();
+        jest.resetAllMocks();
+        mockGetLink.mockReturnValue(undefined);
+    });
+
+    afterEach(() => {
+        jest.runOnlyPendingTimers();
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses API error %s for the same share and link across hook instances',
+        async (code) => {
+            const error = Object.assign(new Error('Link unavailable'), { data: { Code: code } });
+            mockRequest.mockRejectedValueOnce(error);
+
+            const first = renderHook(() => useLink());
+            await act(async () => {
+                await expect(first.result.current.setSignatureIssues(abortSignal, 'share', 'missing', {})).rejects.toBe(
+                    error
+                );
+            });
+
+            const second = renderHook(() => useLink());
+            await act(async () => {
+                await expect(
+                    second.result.current.setSignatureIssues(abortSignal, 'share', 'missing', {})
+                ).rejects.toBe(error);
+            });
+
+            expect(mockRequest).toHaveBeenCalledTimes(1);
+        }
+    );
+
+    it('fetches other links and shares normally while one link is backed off', async () => {
+        const error = Object.assign(new Error('Missing link'), { data: { Code: RESPONSE_CODE.NOT_FOUND } });
+        mockRequest.mockImplementation(async ({ url }) => {
+            if (url === 'drive/shares/share-a/links/missing') {
+                throw error;
+            }
+            return linkResponse(url.split('/').pop());
+        });
+
+        const { result } = renderHook(() => useLink());
+        await act(async () => {
+            await expect(result.current.setSignatureIssues(abortSignal, 'share-a', 'missing', {})).rejects.toBe(error);
+            await result.current.setSignatureIssues(abortSignal, 'share-a', 'valid', {});
+            await result.current.setSignatureIssues(abortSignal, 'share-b', 'missing', {});
+            await expect(result.current.setSignatureIssues(abortSignal, 'share-a', 'missing', {})).rejects.toBe(error);
+        });
+
+        expect(mockRequest.mock.calls.map(([{ url }]) => url)).toEqual([
+            'drive/shares/share-a/links/missing',
+            'drive/shares/share-a/links/valid',
+            'drive/shares/share-b/links/missing',
+        ]);
+        expect(mockSetLinks).toHaveBeenCalledWith('share-a', [
+            { encrypted: expect.objectContaining({ linkId: 'valid', rootShareId: 'share-a' }) },
+        ]);
+        expect(mockSetLinks).toHaveBeenCalledWith('share-b', [
+            { encrypted: expect.objectContaining({ linkId: 'missing', rootShareId: 'share-b' }) },
+        ]);
+    });
+
+    it('retries the failed link when the backoff expires', async () => {
+        const error = Object.assign(new Error('Missing link'), { data: { Code: RESPONSE_CODE.NOT_FOUND } });
+        mockRequest.mockRejectedValueOnce(error).mockResolvedValue(linkResponse('missing'));
+
+        const { result } = renderHook(() => useLink());
+        await act(async () => {
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', 'missing', {})).rejects.toBe(error);
+            jest.advanceTimersByTime(4_999);
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', 'missing', {})).rejects.toBe(error);
+            jest.advanceTimersByTime(1);
+            await result.current.setSignatureIssues(abortSignal, 'share', 'missing', {});
+        });
+
+        expect(mockRequest).toHaveBeenCalledTimes(2);
+        expect(mockSetLinks).toHaveBeenCalledWith('share', [
+            { encrypted: expect.objectContaining({ linkId: 'missing' }) },
+        ]);
+    });
+
+    it('clears a cached failure when an in-flight fetch for the same link succeeds', async () => {
+        const error = Object.assign(new Error('Missing link'), { data: { Code: RESPONSE_CODE.NOT_FOUND } });
+        let rejectFirst!: (error: Error) => void;
+        let resolveSecond!: (response: ReturnType<typeof linkResponse>) => void;
+        mockRequest
+            .mockImplementationOnce(
+                () =>
+                    new Promise<ReturnType<typeof linkResponse>>((_, reject) => {
+                        rejectFirst = reject;
+                    })
+            )
+            .mockImplementationOnce(
+                () =>
+                    new Promise<ReturnType<typeof linkResponse>>((resolve) => {
+                        resolveSecond = resolve;
+                    })
+            )
+            .mockResolvedValue(linkResponse('link'));
+
+        const first = renderHook(() => useLink());
+        const second = renderHook(() => useLink());
+        await act(async () => {
+            const failed = first.result.current.setSignatureIssues(abortSignal, 'share', 'link', {});
+            const succeeded = second.result.current.setSignatureIssues(abortSignal, 'share', 'link', {});
+            const failedResult = expect(failed).rejects.toBe(error);
+            rejectFirst(error);
+            await failedResult;
+            resolveSecond(linkResponse('link'));
+            await succeeded;
+            await first.result.current.setSignatureIssues(abortSignal, 'share', 'link', {});
+        });
+
+        expect(mockRequest).toHaveBeenCalledTimes(3);
+    });
+
+    it('does not cache other API errors', async () => {
+        const error = Object.assign(new Error('Temporary failure'), { data: { Code: 5000 } });
+        mockRequest.mockRejectedValue(error);
+
+        const { result } = renderHook(() => useLink());
+        await act(async () => {
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', 'link', {})).rejects.toBe(error);
+            await expect(result.current.setSignatureIssues(abortSignal, 'share', 'link', {})).rejects.toBe(error);
+        });
+
+        expect(mockRequest).toHaveBeenCalledTimes(2);
+    });
+});
