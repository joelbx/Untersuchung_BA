+def test_get_ia_record_normalizes_mixed_publishers_and_single_isbn() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {
+            'publisher': ['  The Publisher  ', ' New York : Simon & Schuster ', '  '],
+            'isbn': ' 0-306-40615-2 ',
+        }
+    )
+
+    assert result['publishers'] == ['The Publisher', 'Simon & Schuster']
+    assert result['publish_places'] == ['New York']
+    assert result['isbn_10'] == ['0306406152']
+    assert 'isbn' not in result
+    assert 'publisher' not in result
+
+
