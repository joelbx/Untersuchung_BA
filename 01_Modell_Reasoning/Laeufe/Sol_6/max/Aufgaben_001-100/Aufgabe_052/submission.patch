+package model
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sashabaranov/go-openai"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTokenCount(t *testing.T) {
+	prompt, err := NewPromptTokenCounter([]openai.ChatCompletionMessage{
+		{Role: openai.ChatMessageRoleSystem, Content: "Hello"},
+		{Role: openai.ChatMessageRoleUser, Content: "world"},
+	})
+	require.NoError(t, err)
+	require.Equal(t, 10, prompt.TokenCount())
+
+	completion, err := NewSynchronousTokenCounter("Hello world")
+	require.NoError(t, err)
+	require.Equal(t, 5, completion.TokenCount())
+
+	count := NewTokenCount()
+	count.AddPromptCounter(nil)
+	count.AddCompletionCounter(nil)
+	var typedNil *StaticTokenCounter
+	count.AddPromptCounter(typedNil)
+	count.AddCompletionCounter(typedNil)
+	count.AddPromptCounter(prompt)
+	count.AddCompletionCounter(completion)
+	count.AddCompletionCounter(completion)
+	require.Equal(t, 10, TokenCounters{prompt, nil, typedNil}.CountAll())
+	promptTotal, completionTotal := count.CountAll()
+	require.Equal(t, 10, promptTotal)
+	require.Equal(t, 10, completionTotal)
+}
+
+func TestAsynchronousTokenCounter(t *testing.T) {
+	counter, err := NewAsynchronousTokenCounter("Hello")
+	require.NoError(t, err)
+	require.NoError(t, counter.Add())
+	require.NoError(t, counter.Add())
+
+	done := make(chan int, 1)
+	go func() { done <- counter.TokenCount() }()
+	select {
+	case count := <-done:
+		require.Equal(t, 6, count)
+	case <-time.After(time.Second):
+		t.Fatal("TokenCount blocked")
+	}
+	require.Equal(t, 6, counter.TokenCount())
+	require.Error(t, counter.Add())
+}
+
+func TestStreamingTokenCounterSplitToken(t *testing.T) {
+	counter := newStreamingTokenCounter()
+	require.NoError(t, counter.appendFragment("Hel"))
+	require.NoError(t, counter.appendFragment("lo"))
+	require.Equal(t, 4, counter.TokenCount())
+	require.NoError(t, counter.appendFragment(" world"))
+	require.Equal(t, 5, counter.TokenCount())
+}
