+*/
+
+package model
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// Ref: https://github.com/openai/openai-cookbook/blob/594fc6c952425810e9ea5bd1a275c8ca5f32e8f9/examples/How_to_count_tokens_with_tiktoken.ipynb
+const (
+	perMessage = 3
+	perRole    = 1
+	perRequest = 3
+)
+
+// TokenCounter reports the number of tokens used by one part of a request.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of counters for one side of an invocation.
+type TokenCounters []TokenCounter
+
+// CountAll sums the counters in the collection.
+func (c TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range c {
+		if !isNilTokenCounter(counter) {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount aggregates prompt and completion tokens across agent steps.
+type TokenCount struct {
+	prompts     TokenCounters
+	completions TokenCounters
+}
+
+// NewTokenCount creates an empty token count.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{}
+}
+
+// AddPromptCounter adds a prompt counter. Nil counters are ignored.
+func (c *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if !isNilTokenCounter(prompt) {
+		c.prompts = append(c.prompts, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion counter. Nil counters are ignored.
+func (c *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if !isNilTokenCounter(completion) {
+		c.completions = append(c.completions, completion)
+	}
+}
+
+func isNilTokenCounter(counter TokenCounter) bool {
+	if counter == nil {
+		return true
+	}
+	value := reflect.ValueOf(counter)
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		return value.IsNil()
+	default:
+		return false
+	}
+}
+
+// CountAll returns the total prompt and completion tokens, in that order.
+func (c *TokenCount) CountAll() (int, int) {
+	return c.prompts.CountAll(), c.completions.CountAll()
+}
+
+// StaticTokenCounter holds the token count for a completed prompt or response.
+type StaticTokenCounter struct {
+	count int
+}
+
+// TokenCount returns the stored count.
+func (c *StaticTokenCounter) TokenCount() int {
+	return c.count
+}
+
+// NewPromptTokenCounter counts message contents and their per-message overhead.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	enc := codec.NewCl100kBase()
+	var count int
+	for _, message := range messages {
+		tokens, _, err := enc.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter counts a complete response and request overhead.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter counts tokens received after an initial fragment.
+// Calling TokenCount finalizes the counter.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter counts the starting fragment of a streamed response.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add records one more streamed token, unless the counter has been finalized.
+func (c *AsynchronousTokenCounter) Add() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.finished {
+		return trace.BadParameter("token counter has already been finalized")
+	}
+	c.count++
+	return nil
+}
+
+// TokenCount finalizes the counter and returns its total, including request overhead.
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.finished = true
+	return perRequest + c.count
+}
+
+// streamingTokenCounter tracks the exact tokenization of content received so far.
+// Stream deltas can split a token, so counting each delta separately is inaccurate.
+// Unlike AsynchronousTokenCounter, this counter can be read before the stream ends.
+type streamingTokenCounter struct {
+	mu      sync.Mutex
+	content string
+	count   int
+	enc     tokenizer.Codec
+}
+
+func newStreamingTokenCounter() *streamingTokenCounter {
+	return &streamingTokenCounter{enc: codec.NewCl100kBase()}
+}
+
+func (c *streamingTokenCounter) appendFragment(fragment string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	content := c.content + fragment
+	tokens, _, err := c.enc.Encode(content)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	c.content = content
+	c.count = len(tokens)
+	return nil
+}
+
+func (c *streamingTokenCounter) TokenCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return perRequest + c.count
+}
