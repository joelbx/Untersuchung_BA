+func validateArrayValue(value, property string, comparisonType ComparisonType) error {
+	var length int
+	switch comparisonType {
+	case ComparisonType_STRING_COMPARISON_TYPE:
+		values, ok := decodeTypedArray[string](value)
+		if !ok {
+			return errors.ErrInvalidf("invalid value provided for property %q of type string", property)
+		}
+		length = len(values)
+	case ComparisonType_NUMBER_COMPARISON_TYPE:
+		values, ok := decodeTypedArray[float64](value)
+		if !ok {
+			return errors.ErrInvalidf("invalid value provided for property %q of type number", property)
+		}
+		length = len(values)
+	default:
+		return errors.ErrInvalidf("invalid constraint type: %q", comparisonType.String())
+	}
+
+	if length > MAX_JSON_ARRAY_ITEMS {
+		typeName := "string"
+		if comparisonType == ComparisonType_NUMBER_COMPARISON_TYPE {
+			typeName = "number"
+		}
+		return errors.ErrInvalidf("too many values provided for property %q of type %s (maximum %d)", property, typeName, MAX_JSON_ARRAY_ITEMS)
+	}
+
+	return nil
+}
