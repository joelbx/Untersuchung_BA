+    @pytest.mark.parametrize('use_pexpect', [False, True])
+    def test_kinit_uses_unique_cache_per_attempt(self, monkeypatch, use_pexpect):
+        if use_pexpect:
+            pytest.importorskip('pexpect')
+            process = MagicMock()
+            process.return_value.exitstatus = 0
+            monkeypatch.setattr('pexpect.spawn', process)
+        else:
+            process = MagicMock()
+            process.return_value.communicate.return_value = (b'', b'')
+            process.return_value.returncode = 0
+            monkeypatch.setattr('subprocess.Popen', process)
+
+        winrm.HAS_PEXPECT = use_pexpect
+        conn = connection_loader.get('winrm', PlayContext(), StringIO())
+        conn.set_options(var_options={'_extras': {}})
+        conn._build_winrm_kwargs()
+
+        cache_names = []
+        for _ in range(2):
+            conn._kerb_auth('user@domain', 'pass')
+            cache_names.append(conn._kerb_ccache.name)
+            expected_cache = 'FILE:%s' % cache_names[-1]
+            assert os.path.isfile(cache_names[-1])
+            assert os.environ['KRB5CCNAME'] == expected_cache
+            assert process.call_args[1]['env']['KRB5CCNAME'] == expected_cache
+
+        assert cache_names[0] != cache_names[1]
+        assert process.call_count == 2
