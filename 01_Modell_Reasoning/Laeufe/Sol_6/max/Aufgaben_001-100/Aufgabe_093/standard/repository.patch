+import { act, renderHook } from '@testing-library/react-hooks';
+
+import usePopper from './usePopper';
+
+test('reports the visual alignment for an RTL floating element', async () => {
+    Object.defineProperties(document.documentElement, {
+        clientWidth: { configurable: true, value: 1024 },
+        clientHeight: { configurable: true, value: 768 },
+    });
+
+    const reference = document.createElement('button');
+    reference.getBoundingClientRect = () => ({
+        x: 200,
+        y: 200,
+        top: 200,
+        bottom: 240,
+        left: 200,
+        right: 300,
+        width: 100,
+        height: 40,
+        toJSON: () => ({}),
+    });
+
+    const floating = document.createElement('div');
+    floating.style.direction = 'rtl';
+    floating.style.width = '80px';
+    floating.style.height = '40px';
+    document.body.append(reference, floating);
+
+    const { result, waitFor, unmount } = renderHook(() =>
+        usePopper({ isOpen: true, originalPlacement: 'top-start', availablePlacements: ['top-start'] })
+    );
+
+    act(() => {
+        result.current.reference?.(reference);
+        result.current.floating?.(floating);
+    });
+
+    await waitFor(() => expect(result.current.placement).toBe('top-end'));
+
+    unmount();
+    reference.remove();
+    floating.remove();
+    Reflect.deleteProperty(document.documentElement, 'clientWidth');
+    Reflect.deleteProperty(document.documentElement, 'clientHeight');
+});
