@@ -0,0 +1,100 @@
+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestMiddlewareHandlerStateCookie(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		domain     string
+		wantDomain string
+	}{
+		{name: "localhost", domain: "localhost"},
+		{name: "other host", domain: "auth.example.com", wantDomain: "auth.example.com"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			var state string
+			middleware := NewHTTPMiddleware(config.AuthenticationSession{
+				Domain:        tt.domain,
+				StateLifetime: time.Minute,
+			})
+			handler := middleware.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				state = r.URL.Query().Get("state")
+			}))
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize?state=original", nil))
+
+			cookies := w.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, stateCookieKey, cookies[0].Name)
+			require.Equal(t, state, cookies[0].Value)
+			require.Equal(t, "/auth/v1/method/oidc/google/callback", cookies[0].Path)
+			require.Equal(t, tt.wantDomain, cookies[0].Domain)
+			require.Equal(t, tt.wantDomain != "", strings.Contains(w.Header().Get("Set-Cookie"), "Domain="))
+		})
+	}
+}
+
+func TestMiddlewareForwardResponseTokenCookieDomain(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		domain     string
+		wantDomain string
+	}{
+		{name: "localhost", domain: "localhost"},
+		{name: "other host", domain: "auth.example.com", wantDomain: "auth.example.com"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			middleware := NewHTTPMiddleware(config.AuthenticationSession{
+				Domain:        tt.domain,
+				TokenLifetime: time.Hour,
+			})
+			w := httptest.NewRecorder()
+			require.NoError(t, middleware.ForwardResponseOption(context.Background(), w, &auth.CallbackResponse{ClientToken: "token"}))
+
+			cookies := w.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, tokenCookieKey, cookies[0].Name)
+			require.Equal(t, tt.wantDomain, cookies[0].Domain)
+			require.Equal(t, tt.wantDomain != "", strings.Contains(w.Header().Get("Set-Cookie"), "Domain="))
+		})
+	}
+}
+
+func TestCallbackURL(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		host string
+		want string
+	}{
+		{
+			name: "host with port",
+			host: "http://localhost:8080",
+			want: "http://localhost:8080/auth/v1/method/oidc/google/callback",
+		},
+		{
+			name: "single trailing slash",
+			host: "https://auth.example.com:8443/",
+			want: "https://auth.example.com:8443/auth/v1/method/oidc/google/callback",
+		},
+		{
+			name: "two trailing slashes",
+			host: "https://auth.example.com//",
+			want: "https://auth.example.com//auth/v1/method/oidc/google/callback",
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.want, callbackURL(tt.host, "google"))
+		})
+	}
+}
