+package config
+
+import (
+	"errors"
+	"net/url"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationConfigSessionDomain(t *testing.T) {
+	tests := []struct {
+		name   string
+		domain string
+		want   string
+	}{
+		{name: "http with port", domain: "http://localhost:8080", want: "localhost"},
+		{name: "https with port", domain: "https://auth.example.com:8443", want: "auth.example.com"},
+		{name: "host with port", domain: "auth.example.com:8080", want: "auth.example.com"},
+		{name: "host only", domain: "auth.example.com", want: "auth.example.com"},
+		{name: "localhost", domain: "localhost", want: "localhost"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tt.domain},
+				Methods: AuthenticationMethods{
+					OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+				},
+			}
+
+			require.NoError(t, cfg.validate())
+			require.Equal(t, tt.want, cfg.Session.Domain)
+		})
+	}
+}
+
+func TestAuthenticationConfigSessionDomainParseError(t *testing.T) {
+	cfg := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: "http://bad host"},
+		Methods: AuthenticationMethods{
+			OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+		},
+	}
+
+	err := cfg.validate()
+	var parseErr *url.Error
+	require.True(t, errors.As(err, &parseErr), "expected URL parsing error, got %v", err)
+}
+
+func TestAuthenticationConfigSessionDomainWithoutOIDC(t *testing.T) {
+	cfg := AuthenticationConfig{Session: AuthenticationSession{Domain: "https://auth.example.com:8443"}}
+
+	require.NoError(t, cfg.validate())
+	require.Equal(t, "auth.example.com", cfg.Session.Domain)
+}
