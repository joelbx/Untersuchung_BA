diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 25a157e..71d6c53 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -372,6 +372,80 @@ class TestIptables(ModuleTestCase):
             '8600'
         ])
 
+    def test_destination_ports(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'destination_ports': [80, 443, '8081:8083'],
+            'jump': 'ACCEPT',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.side_effect = [(1, '', ''), (0, '', '')]
+            with self.assertRaises(AnsibleExitJson) as result:
+                iptables.main()
+
+        expected_rule = ['-p', 'tcp', '-j', 'ACCEPT', '-m', 'multiport', '--dports', '80,443,8081:8083']
+        self.assertTrue(result.exception.args[0]['changed'])
+        self.assertEqual(result.exception.args[0]['rule'], ' '.join(expected_rule))
+        self.assertEqual(run_command.call_args_list[0][0][0],
+                         ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'] + expected_rule)
+        self.assertEqual(run_command.call_args_list[1][0][0],
+                         ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'] + expected_rule)
+
+    def test_destination_ports_supported_protocols(self):
+        for protocol in ('tcp', 'udp', 'udplite', 'dccp', 'sctp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['53', '1000:1002'],
+                '_ansible_check_mode': True,
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = 1, '', ''
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_args[0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-p', protocol, '-m', 'multiport', '--dports', '53,1000:1002',
+            ])
+
+    def test_destination_ports_rejects_unsupported_protocols(self):
+        for protocol in (None, 'all', 'icmp', 'ipv6-icmp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['80', '443'],
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson) as result:
+                    iptables.main()
+
+            self.assertIn('destination_ports requires protocol', result.exception.args[0]['msg'])
+            self.assertEqual(run_command.call_count, 0)
+
+    def test_destination_ports_with_explicit_multiport_match(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'match': ['multiport'],
+            'destination_ports': ['80', '443'],
+            '_ansible_check_mode': True,
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 1, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-p', 'tcp', '-m', 'multiport', '--dports', '80,443',
+        ])
+
