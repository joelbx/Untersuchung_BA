diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..81adb46
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,50 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const privileges = require('../privileges');
+const user = require('../user');
+
+const wellKnownController = module.exports;
+
+wellKnownController.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	const suffix = `@${hostname}`;
+
+	if (typeof resource !== 'string' || !resource.startsWith('acct:') || !resource.endsWith(suffix)) {
+		return res.status(400).json({ error: 'Invalid resource' });
+	}
+
+	const requestedSlug = resource.slice('acct:'.length, -suffix.length);
+	if (!requestedSlug || requestedSlug.includes('@')) {
+		return res.status(400).json({ error: 'Invalid resource' });
+	}
+
+	// UID 0 is the Guest role in the global privileges API.
+	const canViewUsers = await privileges.global.can('view:users', req.uid == null ? 0 : req.uid);
+	if (!canViewUsers) {
+		return res.status(403).json({ error: 'Forbidden' });
+	}
+
+	const uid = await user.getUidByUserslug(requestedSlug.toLowerCase());
+	if (!uid) {
+		return res.status(404).json({ error: 'User not found' });
+	}
+
+	const userslug = await user.getUserField(uid, 'userslug');
+	if (!userslug) {
+		return res.status(404).json({ error: 'User not found' });
+	}
+
+	const baseUrl = nconf.get('url');
+	const profileUrl = `${baseUrl}/user/${encodeURIComponent(userslug)}`;
+	res.type('application/jrd+json').json({
+		subject: resource,
+		aliases: [
+			`${baseUrl}/uid/${uid}`,
+			profileUrl,
+		],
+		links: [{ rel: 'http://webfinger.net/rel/profile-page', type: 'text/html', href: profileUrl }],
+	});
+};
