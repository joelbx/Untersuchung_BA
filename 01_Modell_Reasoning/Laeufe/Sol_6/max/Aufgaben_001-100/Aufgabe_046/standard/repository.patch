+def test_legacy_namespace_packages_get_init_files(tmp_path, mocker):
+    write_file(tmp_path / 'outer' / 'inner' / 'leaf.py', 'VALUE = 4\n')
+    mocker.patch.object(amc.module_utils_loader, '_get_paths', return_value=[str(tmp_path)])
+
+    payload = bundle(b'from ansible.module_utils.outer.inner.leaf import VALUE\n')
+    assert payload['ansible/module_utils/outer/__init__.py'] == b''
+    assert payload['ansible/module_utils/outer/inner/__init__.py'] == b''
+    assert payload['ansible/module_utils/outer/inner/leaf.py'] == b'VALUE = 4\n'
