+def test_legacy_local_override_and_ambiguity(collections, tmp_path):
+    unused, metadata = collections
+    metadata['ansible.builtin'] = {'plugin_routing': {'module_utils': {
+        'local': {'redirect': 'other.coll.real'}}}}
+    write_file(tmp_path / 'local.py', 'local = True\n')
+
+    locator = amc.LegacyModuleUtilLocator(('ansible', 'module_utils', 'local'), mu_paths=[str(tmp_path)])
+    assert locator.found and not locator.redirected
+    assert locator.source == b'local = True\n'
+
+    root_import = amc.LegacyModuleUtilLocator(('ansible', 'module_utils', 'missing'), True,
+                                               mu_paths=[str(tmp_path)])
+    nested_import = amc.LegacyModuleUtilLocator(('ansible', 'module_utils', 'pkg', 'missing'), True,
+                                                 mu_paths=[str(tmp_path)])
+    assert root_import.candidate_names_joined() == ['ansible.module_utils.missing']
+    assert nested_import.candidate_names_joined() == ['ansible.module_utils.pkg.missing',
+                                                       'ansible.module_utils.pkg']
+
