+def test_redirect_deprecation_and_tombstone(collections, mocker):
+    add, metadata = collections
+    add('ns.coll')
+    routing = metadata['ns.coll']['plugin_routing']['module_utils']
+    routing['old'] = {'redirect': 'ns.coll.new', 'deprecation': {
+        'warning_text': 'Use new', 'removal_version': '2.0', 'removal_date': '2027-01-01'}}
+    warning = mocker.patch.object(amc.display, 'deprecated')
+
+    locator = amc.CollectionModuleUtilLocator(('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'old'))
+    assert locator.redirected
+    warning.assert_called_once_with('Use new', version='2.0', date='2027-01-01', collection_name='ns.coll')
+
+    routing['gone'] = {'tombstone': {'warning_text': 'Gone forever', 'removal_version': '3.0'}}
+    with pytest.raises(AnsibleError, match='Gone forever.*ns.coll.*3.0'):
+        amc.CollectionModuleUtilLocator(('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'gone'))
+
