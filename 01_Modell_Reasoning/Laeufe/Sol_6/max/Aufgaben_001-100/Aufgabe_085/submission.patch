+			"CVE-old":    {CveID: "CVE-old", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+			"CVE-common": {CveID: "CVE-common", AffectedPackages: models.PackageFixStatuses{{Name: "old-package"}}},
+		},
+		Packages: models.NewPackages(models.Package{Name: "old-package", Version: "previous"}),
+	}
+	for _, test := range []struct {
+		name        string
+		plus, minus bool
+		want        map[string]models.DiffStatus
+	}{
+		{"both", true, true, map[string]models.DiffStatus{"CVE-new": models.DiffPlus, "CVE-old": models.DiffMinus}},
+		{"plus", true, false, map[string]models.DiffStatus{"CVE-new": models.DiffPlus}},
+		{"minus", false, true, map[string]models.DiffStatus{"CVE-old": models.DiffMinus}},
+		{"neither", false, false, map[string]models.DiffStatus{}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, test.plus, test.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(results) != 1 || len(results[0].ScannedCves) != len(test.want) {
+				t.Fatalf("got %+v, want %d CVEs", results, len(test.want))
+			}
+			for cveID, wantStatus := range test.want {
+				if got := results[0].ScannedCves[cveID].DiffStatus; got != wantStatus {
+					t.Errorf("%s: got status %q, want %q", cveID, got, wantStatus)
+				}
+			}
+			if len(results[0].Packages) != len(test.want) {
+				t.Errorf("got %d packages, want %d", len(results[0].Packages), len(test.want))
+			}
+			if test.plus && results[0].Packages["new-package"].Version != "current" {
+				t.Errorf("plus package was not sourced from current scan: %+v", results[0].Packages)
+			}
+			if test.minus && results[0].Packages["old-package"].Version != "previous" {
+				t.Errorf("minus package was not sourced from previous scan: %+v", results[0].Packages)
+			}
+		})
+	}
+}
