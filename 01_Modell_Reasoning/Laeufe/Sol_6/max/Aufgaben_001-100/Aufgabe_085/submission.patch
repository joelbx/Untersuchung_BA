+func TestDiffSharedPackageKeepsBothVersions(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"CVE-new": {CveID: "CVE-new", AffectedPackages: models.PackageFixStatuses{{Name: "shared"}}},
+		},
+		Packages: models.NewPackages(models.Package{Name: "shared", Version: "current"}),
+	}
+	previous := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"CVE-old": {CveID: "CVE-old", AffectedPackages: models.PackageFixStatuses{{Name: "shared"}}},
+		},
+		Packages: models.NewPackages(models.Package{Name: "shared", Version: "previous"}),
+	}
+	results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := results[0]
+	if got := result.ScannedCves["CVE-new"].PackagesForDiff(result.Packages)["shared"].Version; got != "current" {
+		t.Errorf("new CVE has package version %q, want current", got)
+	}
+	if got := result.ScannedCves["CVE-old"].PackagesForDiff(result.Packages)["shared"].Version; got != "previous" {
+		t.Errorf("resolved CVE has package version %q, want previous", got)
+	}
+	full := formatFullPlainText(result)
+	if !strings.Contains(full, "shared-current") || !strings.Contains(full, "shared-previous") {
+		t.Errorf("full report does not show both package versions: %s", full)
+	}
+}
