+func TestDiffReportDisplaysStatuses(t *testing.T) {
+	before := config.Conf.Diff
+	config.Conf.Diff = true
+	defer func() { config.Conf.Diff = before }()
+
+	current := models.ScanResult{
+		ServerName:  "host",
+		ScannedCves: models.VulnInfos{"CVE-new": {CveID: "CVE-new"}},
+	}
+	previous := models.ScanResult{
+		ServerName:  "host",
+		ScannedCves: models.VulnInfos{"CVE-old": {CveID: "CVE-old"}},
+	}
+	results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	list := formatList(results[0])
+	for _, label := range []string{"+CVE-new", "-CVE-old"} {
+		if !strings.Contains(list, label) {
+			t.Errorf("list does not contain %q: %s", label, list)
+		}
+	}
+	encoded, err := json.Marshal(results[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(encoded), `"diffStatus":"+"`) || !strings.Contains(string(encoded), `"diffStatus":"-"`) {
+		t.Errorf("JSON does not include both statuses: %s", encoded)
+	}
+}
