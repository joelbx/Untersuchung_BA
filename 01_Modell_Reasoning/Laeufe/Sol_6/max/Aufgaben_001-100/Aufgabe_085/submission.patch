+func TestCveIDDiffFormat(t *testing.T) {
+	for _, test := range []struct {
+		status DiffStatus
+		diff   bool
+		want   string
+	}{
+		{DiffPlus, true, "+CVE-2024-0001"},
+		{DiffMinus, true, "-CVE-2024-0001"},
+		{DiffPlus, false, "CVE-2024-0001"},
+		{"", true, "CVE-2024-0001"},
+	} {
+		got := (VulnInfo{CveID: "CVE-2024-0001", DiffStatus: test.status}).CveIDDiffFormat(test.diff)
+		if got != test.want {
+			t.Errorf("status=%q diff=%t: got %q, want %q", test.status, test.diff, got, test.want)
+		}
+	}
+}
+
+func TestCountDiff(t *testing.T) {
+	vulns := VulnInfos{
+		"plus":      {DiffStatus: DiffPlus},
+		"minus":     {DiffStatus: DiffMinus},
+		"unchanged": {},
+	}
+	plus, minus := vulns.CountDiff()
+	if plus != 1 || minus != 1 {
+		t.Errorf("got (+%d, -%d), want (+1, -1)", plus, minus)
+	}
+}
