+
+import React from "react";
+import { mount } from "enzyme";
+
+import { mkEvent, stubClient } from "../../../test-utils";
+import dis from "../../../../src/dispatcher/dispatcher";
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import { TimelineRenderingType } from "../../../../src/contexts/RoomContext";
+
+jest.mock("../../../../src/components/views/rooms/ReplyTile", () => () => <div className="reply-tile" />);
+
+describe("ReplyPreview", () => {
+    stubClient();
+
+    it("names the sender of an emote and offers an accessible way to cancel", () => {
+        const event = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:server",
+            user: "@alice:server",
+            content: { msgtype: "m.emote", body: "waves" },
+        });
+        const dispatch = jest.spyOn(dis, "dispatch");
+        const wrapper = mount(<ReplyPreview replyToEvent={event} permalinkCreator={null} />);
+
+        expect(wrapper.find(".mx_ReplyPreview_header p").text()).toBe("Replying to @alice:server");
+        expect(wrapper.find(".mx_ReplyPreview_header p span.mx_DisambiguatedProfile")).toHaveLength(1);
+
+        const button = wrapper.find("button.mx_ReplyPreview_header_cancel");
+        expect(button.prop("aria-label")).toBe("Cancel replying to a message");
+        button.simulate("click");
+        expect(dispatch).toHaveBeenCalledWith({
+            action: "reply_to_event",
+            event: null,
+            context: TimelineRenderingType.Room,
+        });
+
+        dispatch.mockRestore();
+        wrapper.unmount();
+    });
+});
