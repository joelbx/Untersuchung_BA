+
+import React from "react";
+import { mount } from "enzyme";
+
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+
+describe("CancelButton", () => {
+    it("renders a labeled button with the default size", () => {
+        const wrapper = mount(<CancelButton onClick={jest.fn()} />);
+        const button = wrapper.find("button.mx_CancelButton");
+
+        expect(button).toHaveLength(1);
+        expect(button.prop("type")).toBe("button");
+        expect(button.prop("aria-label")).toBe("Cancel");
+        expect(button.getDOMNode<HTMLButtonElement>().style.getPropertyValue("--CancelButton-size")).toBe("16px");
+    });
+
+    it("forwards the label, size, click handler, and disabled state", () => {
+        const onClick = jest.fn();
+        const wrapper = mount(<CancelButton onClick={onClick} size="24" aria-label="Cancel reply" />);
+        const button = wrapper.find("button.mx_CancelButton");
+
+        expect(button.prop("aria-label")).toBe("Cancel reply");
+        expect(button.getDOMNode<HTMLButtonElement>().style.getPropertyValue("--CancelButton-size")).toBe("24px");
+        button.simulate("click");
+        expect(onClick).toHaveBeenCalledTimes(1);
+
+        wrapper.setProps({ disabled: true });
+        expect(wrapper.find("button.mx_CancelButton").prop("aria-disabled")).toBe(true);
+        wrapper.find("button.mx_CancelButton").simulate("click");
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+});
