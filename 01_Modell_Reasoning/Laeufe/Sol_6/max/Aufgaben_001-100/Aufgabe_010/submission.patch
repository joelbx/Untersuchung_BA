+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { ComponentProps } from "react";
+import classNames from "classnames";
+
+import { _t } from "../../../languageHandler";
+import AccessibleButton from "../elements/AccessibleButton";
+
+// HTML input props define `size` as a number; here it controls the icon's CSS dimensions.
+type IProps = Omit<ComponentProps<typeof AccessibleButton>, "size"> & { size?: string };
+
+export default function CancelButton({ size = "16", className, style, ...props }: IProps): JSX.Element {
+    const buttonSize = /^\d+(\.\d+)?$/.test(size) ? `${size}px` : size;
+
+    return <AccessibleButton
+        {...props}
+        element={props.element || "button"}
+        type={props.type || (!props.element || props.element === "button" ? "button" : undefined)}
+        aria-label={props["aria-label"] || _t("Cancel")}
+        className={classNames("mx_CancelButton", className)}
+        style={{ ...style, "--CancelButton-size": buttonSize } as React.CSSProperties}
+    />;
+}
