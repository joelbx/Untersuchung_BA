+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestConfigDefaults(t *testing.T) {
+	var cfg Config
+	cfg.SetDefaults()
+	if cfg.Capacity != 64 || cfg.GracePeriod != 5*time.Minute || cfg.Clock == nil {
+		t.Fatalf("unexpected defaults: %+v", cfg)
+	}
+}
+
+func TestFanoutAndOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	b.Append(0) // A new cursor subscribes to future items only.
+	fast := b.NewCursor()
+	slow := b.NewCursor()
+	defer fast.Close()
+	defer slow.Close()
+
+	b.Append(1, 2, 3, 4)
+	read := func(c *Cursor[int], want []int) {
+		t.Helper()
+		out := make([]int, len(want)+1)
+		n, err := c.TryRead(out)
+		if err != nil || !reflect.DeepEqual(out[:n], want) {
+			t.Fatalf("TryRead = (%v, %v), want %v", out[:n], err, want)
+		}
+	}
+	read(fast, []int{1, 2, 3, 4})
+	read(slow, []int{1, 2, 3, 4})
+	b.Append(5)
+	read(fast, []int{5})
+	read(slow, []int{5})
+
+	var out [1]int
+	if n, err := fast.TryRead(out[:]); n != 0 || err != nil {
+		t.Fatalf("empty TryRead = (%d, %v)", n, err)
+	}
+	if len(b.overflow) != 0 || b.ringStart != b.end {
+		t.Fatalf("items retained after all cursors read: overflow=%d ring=%d", len(b.overflow), b.end-b.ringStart)
+	}
+}
+
+func TestRingGrowthPreservesOrder(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 128})
+	defer b.Close()
+	// Advance the sequence before subscribing, to exercise ring growth at a
+	// nonzero offset.
+	b.Append(make([]int, 1000)...)
+	c := b.NewCursor()
+	defer c.Close()
+	for i := 0; i < 140; i++ {
+		b.Append(i)
+	}
+	out := make([]int, 140)
+	if n, err := c.TryRead(out); n != len(out) || err != nil {
+		t.Fatalf("TryRead = (%d, %v)", n, err)
+	}
+	for i, got := range out {
+		if got != i {
+			t.Fatalf("item %d = %d", i, got)
+		}
+	}
+}
+
+func TestGracePeriodAndCleanup(t *testing.T) {
+	clock := clockwork.NewFakeClockAt(time.Unix(0, 0))
+	b := NewBuffer[*int](Config{Capacity: 2, GracePeriod: 10 * time.Second, Clock: clock})
+	defer b.Close()
+	slow := b.NewCursor()
+	fast := b.NewCursor()
+	defer slow.Close()
+	defer fast.Close()
+
+	values := []*int{new(int), new(int), new(int), new(int)}
+	b.Append(values[:3]...)
+	var out [4]*int
+	if n, err := fast.TryRead(out[:]); n != 3 || err != nil {
+		t.Fatalf("fast TryRead = (%d, %v)", n, err)
+	}
+	clock.Advance(9 * time.Second)
+	if n, err := slow.TryRead(out[:1]); n != 1 || err != nil || out[0] != values[0] {
+		t.Fatalf("slow TryRead within grace = (%d, %v)", n, err)
+	}
+	// Catching up to the ring ends the first grace period.
+	b.Append(values[3])
+	clock.Advance(9 * time.Second)
+	if n, err := slow.TryRead(out[:]); n != 3 || err != nil || !reflect.DeepEqual(out[:n], values[1:]) {
+		t.Fatalf("slow TryRead after catching up = (%d, %v)", n, err)
+	}
+
+	b.Append(values[:3]...)
+	if n, err := fast.TryRead(out[:]); n != 4 || err != nil {
+		t.Fatalf("fast cursor before slow expiry = (%d, %v)", n, err)
+	}
+	clock.Advance(10 * time.Second)
+	if n, err := slow.TryRead(out[:]); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("expired TryRead = (%d, %v)", n, err)
+	}
+	b.Append(values[0])
+	if n, err := fast.TryRead(out[:]); n != 1 || err != nil {
+		t.Fatalf("fast cursor after slow expiry = (%d, %v)", n, err)
+	}
+	if len(b.overflow) != 0 || b.ringStart != b.end {
+		t.Fatal("buffer retained items after the remaining cursor read them")
+	}
+	for _, item := range b.ring {
+		if item != nil {
+			t.Fatal("ring retained a consumed pointer")
+		}
+	}
+}
+
+func TestGraceTimerReleasesIdleCursor(t *testing.T) {
+	clock := clockwork.NewFakeClockAt(time.Unix(0, 0))
+	b := NewBuffer[int](Config{Capacity: 1, GracePeriod: time.Second, Clock: clock})
+	defer b.Close()
+	c := b.NewCursor()
+	b.Append(1, 2)
+
+	b.mu.Lock()
+	changed := b.notify
+	b.mu.Unlock()
+	clock.Advance(time.Second)
+	select {
+	case <-changed:
+	case <-time.After(5 * time.Second):
+		t.Fatal("grace timer did not release the idle cursor")
+	}
+	if n, err := c.TryRead(make([]int, 2)); n != 0 || !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("expired cursor returned (%d, %v)", n, err)
+	}
+	if len(b.overflow) != 0 || b.ringStart != b.end {
+		t.Fatal("expired cursor retained buffered items")
+	}
+}
+
+func TestOverflowReleasesConsumedPrefix(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	defer b.Close()
+	c := b.NewCursor()
+	defer c.Close()
+	for i := 0; i < 100; i++ {
+		b.Append(i)
+	}
+	out := make([]int, 90)
+	if n, err := c.TryRead(out); n != len(out) || err != nil {
+		t.Fatalf("TryRead = (%d, %v)", n, err)
+	}
+	for i, item := range out {
+		if item != i {
+			t.Fatalf("item %d = %d", i, item)
+		}
+	}
+	if cap(b.overflow) > 20 {
+		t.Fatalf("small overflow tail retained a large backing array: cap=%d", cap(b.overflow))
+	}
+}
+
+func TestBlockingReadAndClose(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	result := make(chan error, 1)
+	go func() {
+		var out [1]int
+		n, err := c.Read(context.Background(), out[:])
+		if n != 1 || out[0] != 42 || err != nil {
+			result <- errors.New("blocking read did not receive appended item")
+			return
+		}
+		result <- nil
+	}()
+	b.Append(42)
+	select {
+	case err := <-result:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("blocking read did not wake on append")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var out [1]int
+	if _, err := c.Read(ctx, out[:]); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled Read returned %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TryRead(out[:]); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor returned %v", err)
+	}
+
+	other := b.NewCursor()
+	b.Close()
+	if _, err := other.Read(context.Background(), out[:]); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("closed buffer returned %v", err)
+	}
+	if err := other.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := b.NewCursor().TryRead(out[:]); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("cursor created after buffer close returned %v", err)
+	}
+}
+
+type observedDoneContext struct {
+	context.Context
+	observed chan struct{}
+	once     sync.Once
+}
+
+func (c *observedDoneContext) Done() <-chan struct{} {
+	c.once.Do(func() { close(c.observed) })
+	return c.Context.Done()
+}
+
+func TestBlockedReadTerminates(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		stop func(*Buffer[int], *Cursor[int], context.CancelFunc)
+		want error
+	}{
+		{"cursor close", func(_ *Buffer[int], c *Cursor[int], _ context.CancelFunc) { c.Close() }, ErrUseOfClosedCursor},
+		{"buffer close", func(b *Buffer[int], _ *Cursor[int], _ context.CancelFunc) { b.Close() }, ErrBufferClosed},
+		{"context cancel", func(_ *Buffer[int], _ *Cursor[int], cancel context.CancelFunc) { cancel() }, context.Canceled},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := NewBuffer[int](Config{})
+			defer b.Close()
+			c := b.NewCursor()
+			defer c.Close()
+			base, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			ctx := &observedDoneContext{Context: base, observed: make(chan struct{})}
+			result := make(chan error, 1)
+			go func() {
+				_, err := c.Read(ctx, make([]int, 1))
+				result <- err
+			}()
+			select {
+			case <-ctx.observed:
+			case <-time.After(5 * time.Second):
+				t.Fatal("read did not block")
+			}
+			tc.stop(b, c, cancel)
+			select {
+			case err := <-result:
+				if !errors.Is(err, tc.want) {
+					t.Fatalf("Read returned %v, want %v", err, tc.want)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("blocked read did not terminate")
+			}
+		})
+	}
+}
+
+func TestConcurrentReaders(t *testing.T) {
+	const readers, total = 8, 1000
+	b := NewBuffer[int](Config{Capacity: 16, GracePeriod: time.Hour})
+	defer b.Close()
+	cursors := make([]*Cursor[int], readers)
+	for i := range cursors {
+		cursors[i] = b.NewCursor()
+	}
+
+	var wg sync.WaitGroup
+	errs := make(chan error, readers)
+	for _, c := range cursors {
+		wg.Add(1)
+		go func(c *Cursor[int]) {
+			defer wg.Done()
+			defer c.Close()
+			var out [7]int
+			for next := 0; next < total; {
+				n, err := c.Read(context.Background(), out[:])
+				if err != nil {
+					errs <- err
+					return
+				}
+				for _, got := range out[:n] {
+					if got != next {
+						errs <- errors.New("reader saw out-of-order or missing item")
+						return
+					}
+					next++
+				}
+			}
+		}(c)
+	}
+	for i := 0; i < total; i++ {
+		b.Append(i)
+	}
+	finished := make(chan struct{})
+	go func() { wg.Wait(); close(finished) }()
+	select {
+	case <-finished:
+	case <-time.After(5 * time.Second):
+		t.Fatal("concurrent readers did not finish")
+	}
+	close(errs)
+	for err := range errs {
+		t.Fatal(err)
+	}
+}
