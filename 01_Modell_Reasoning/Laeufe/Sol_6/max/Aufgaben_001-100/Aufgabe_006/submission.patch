+// Package fanoutbuffer provides a concurrent buffer with independent readers.
+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+var (
+	// ErrGracePeriodExceeded means a cursor stayed more than Capacity items
+	// behind for longer than the configured grace period.
+	ErrGracePeriodExceeded = errors.New("fanout buffer grace period exceeded")
+	// ErrUseOfClosedCursor means a cursor was used after Close.
+	ErrUseOfClosedCursor = errors.New("use of closed fanout buffer cursor")
+	// ErrBufferClosed means the buffer was closed.
+	ErrBufferClosed = errors.New("fanout buffer closed")
+)
+
+// Config controls the amount of recent data kept in the ring and how long a
+// cursor may need the overflow backlog.
+type Config struct {
+	Capacity    uint64
+	GracePeriod time.Duration
+	Clock       clockwork.Clock
+}
+
+// SetDefaults fills in unset configuration fields.
+func (c *Config) SetDefaults() {
+	if c.Capacity == 0 {
+		c.Capacity = 64
+	}
+	if c.GracePeriod == 0 {
+		c.GracePeriod = 5 * time.Minute
+	}
+	if c.Clock == nil {
+		c.Clock = clockwork.NewRealClock()
+	}
+}
+
+// Buffer distributes each appended item to every cursor that existed when it
+// was appended. All state, including cursor positions, is guarded by mu.
+type Buffer[T any] struct {
+	mu     sync.Mutex
+	config Config
+	closed bool
+
+	// ring contains the recent items in [ringStart, end). Older items still
+	// needed by a cursor live in overflow, in [overflowStart, ringStart).
+	// Sequence numbers also make wraparound in the ring transparent to readers.
+	ring          []T
+	ringStart     uint64
+	end           uint64
+	overflow      []T
+	overflowStart uint64
+	// Number of cleared entries preceding overflow in its backing array.
+	overflowDropped int
+	cursors         map[*Cursor[T]]struct{}
+
+	// Closing and replacing notify broadcasts a change without a goroutine per
+	// waiting reader. A reader captures the channel while holding mu.
+	notify chan struct{}
+
+	graceTimer    clockwork.Timer
+	graceDeadline time.Time
+	timerVersion  uint64
+}
+
+// NewBuffer returns a buffer configured with cfg. A new cursor starts at the
+// current end of the stream and receives subsequent appends.
+func NewBuffer[T any](cfg Config) *Buffer[T] {
+	cfg.SetDefaults()
+	// Grow larger rings as needed, so a large configured capacity does not
+	// allocate memory for items that have never been appended.
+	initialSize := min(cfg.Capacity, uint64(64))
+	return &Buffer[T]{
+		config:  cfg,
+		ring:    make([]T, int(initialSize)),
+		cursors: make(map[*Cursor[T]]struct{}),
+		notify:  make(chan struct{}),
+	}
+}
+
+// Append adds items in order and wakes readers. Appends after Close are ignored.
+func (b *Buffer[T]) Append(items ...T) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed || len(items) == 0 {
+		return
+	}
+
+	b.refreshGraceLocked()
+	if len(b.cursors) == 0 {
+		// No cursor needs these items. In particular, do not retain references
+		// to them in the ring until another cursor is created.
+		b.end += uint64(len(items))
+		b.ringStart = b.end
+		b.overflowStart = b.end
+		return
+	}
+
+	oldest := b.end
+	if uint64(len(items)) > b.config.Capacity-(b.end-b.ringStart) {
+		for c := range b.cursors {
+			if c.next < oldest {
+				oldest = c.next
+			}
+		}
+	}
+
+	for _, item := range items {
+		if b.end-b.ringStart == uint64(len(b.ring)) && uint64(len(b.ring)) < b.config.Capacity {
+			b.growRingLocked()
+		}
+		if b.end-b.ringStart == b.config.Capacity {
+			// Preserve a ring entry only while an active cursor still needs it.
+			if b.ringStart >= oldest {
+				if len(b.overflow) == 0 {
+					b.overflowStart = b.ringStart
+				}
+				oldCapacity := cap(b.overflow)
+				b.overflow = append(b.overflow, b.ring[int(b.ringStart%uint64(len(b.ring)))])
+				if len(b.overflow) > oldCapacity {
+					// Append allocated a new backing array without the old
+					// cleared prefix.
+					b.overflowDropped = 0
+				}
+			}
+			b.ringStart++
+		}
+		b.ring[int(b.end%uint64(len(b.ring)))] = item
+		b.end++
+	}
+
+	b.refreshGraceLocked()
+	b.signalLocked()
+}
+
+func (b *Buffer[T]) growRingLocked() {
+	oldSize := uint64(len(b.ring))
+	newSize := min(oldSize*2, b.config.Capacity)
+	newRing := make([]T, int(newSize))
+	for seq := b.ringStart; seq < b.end; seq++ {
+		newRing[int(seq%newSize)] = b.ring[int(seq%oldSize)]
+	}
+	b.ring = newRing
+}
+
+// NewCursor registers a reader for items appended from this point onward.
+// A cursor created after Close reports ErrBufferClosed when read.
+func (b *Buffer[T]) NewCursor() *Cursor[T] {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if !b.closed {
+		b.refreshGraceLocked()
+	}
+	c := &Cursor[T]{buffer: b, next: b.end}
+	if !b.closed {
+		b.cursors[c] = struct{}{}
+	}
+	return c
+}
+
+// Close permanently closes the buffer, wakes readers, and releases retained
+// items. It is safe to call more than once.
+func (b *Buffer[T]) Close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed {
+		return
+	}
+	b.closed = true
+	b.stopGraceTimerLocked()
+	b.ring = nil
+	b.overflow = nil
+	b.overflowDropped = 0
+	b.cursors = nil
+	b.ringStart = b.end
+	b.overflowStart = b.end
+	b.signalLocked()
+}
+
+// Cursor reads an independent, ordered view of the buffer. Concurrent calls
+// on the same cursor are serialized by the buffer mutex.
+type Cursor[T any] struct {
+	buffer   *Buffer[T]
+	next     uint64
+	lagSince time.Time
+	lagging  bool
+	err      error
+	closed   bool
+}
+
+// Read blocks until at least one item is available, the cursor or buffer is
+// closed, the grace period is exceeded, or ctx is canceled. An empty out slice
+// returns immediately.
+func (c *Cursor[T]) Read(ctx context.Context, out []T) (n int, err error) {
+	b := c.buffer
+	for {
+		b.mu.Lock()
+		n, err = c.tryReadLocked(out)
+		if n != 0 || err != nil || len(out) == 0 {
+			b.mu.Unlock()
+			return n, err
+		}
+		changed := b.notify
+		b.mu.Unlock()
+
+		select {
+		case <-changed:
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		}
+	}
+}
+
+// TryRead copies available items without waiting. It returns (0, nil) when
+// there is no item to read.
+func (c *Cursor[T]) TryRead(out []T) (n int, err error) {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return c.tryReadLocked(out)
+}
+
+func (c *Cursor[T]) tryReadLocked(out []T) (int, error) {
+	b := c.buffer
+	if c.closed {
+		return 0, ErrUseOfClosedCursor
+	}
+	if b.closed {
+		return 0, ErrBufferClosed
+	}
+	b.refreshGraceLocked()
+	if c.err != nil {
+		return 0, c.err
+	}
+	if len(out) == 0 || c.next == b.end {
+		return 0, nil
+	}
+
+	limit := uint64(len(out))
+	if available := b.end - c.next; available < limit {
+		limit = available
+	}
+	written := 0
+	if c.next < b.ringStart {
+		start := int(c.next - b.overflowStart)
+		count := min(int(limit), len(b.overflow)-start)
+		written += copy(out, b.overflow[start:start+count])
+		c.next += uint64(count)
+	}
+	for written < int(limit) {
+		start := int(c.next % uint64(len(b.ring)))
+		count := min(int(limit)-written, len(b.ring)-start)
+		written += copy(out[written:], b.ring[start:start+count])
+		c.next += uint64(count)
+	}
+
+	b.trimLocked()
+	b.refreshGraceLocked()
+	return written, nil
+}
+
+// Close releases the cursor's claim on buffered items and wakes a pending
+// Read. Repeated calls to Close succeed.
+func (c *Cursor[T]) Close() error {
+	b := c.buffer
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	delete(b.cursors, c)
+	if !b.closed {
+		b.trimLocked()
+		b.refreshGraceLocked()
+		b.signalLocked()
+	}
+	return nil
+}
+
+// trimLocked discards everything no active cursor can still read. Clearing the
+// dropped slots is necessary for T values that contain pointers.
+func (b *Buffer[T]) trimLocked() {
+	oldest := b.end
+	for c := range b.cursors {
+		if c.next < oldest {
+			oldest = c.next
+		}
+	}
+	if len(b.overflow) != 0 {
+		drop := min(uint64(len(b.overflow)), oldest-b.overflowStart)
+		clear(b.overflow[:int(drop)])
+		b.overflow = b.overflow[int(drop):]
+		b.overflowStart += drop
+		b.overflowDropped += int(drop)
+		if len(b.overflow) == 0 {
+			b.overflow = nil
+			b.overflowStart = b.ringStart
+			b.overflowDropped = 0
+		} else if b.overflowDropped >= len(b.overflow) {
+			// A small tail of a large backlog must not keep the entire
+			// backing array alive.
+			b.overflow = append([]T(nil), b.overflow...)
+			b.overflowDropped = 0
+		}
+	}
+	if oldest > b.ringStart {
+		for seq := b.ringStart; seq < oldest; seq++ {
+			var zero T
+			b.ring[int(seq%uint64(len(b.ring)))] = zero
+		}
+		b.ringStart = oldest
+	}
+	if len(b.overflow) == 0 {
+		b.overflowStart = b.ringStart
+	}
+}
+
+// refreshGraceLocked marks cursors once they lag beyond the ring and removes
+// those that have remained there past their deadline. The timer also calls it,
+// so stale cursors are cleaned up without another append or read.
+func (b *Buffer[T]) refreshGraceLocked() {
+	if len(b.overflow) == 0 {
+		if b.graceTimer != nil {
+			for c := range b.cursors {
+				c.lagging = false
+			}
+			b.stopGraceTimerLocked()
+		}
+		return
+	}
+	now := b.config.Clock.Now()
+	expired := false
+	for c := range b.cursors {
+		if b.end-c.next <= b.config.Capacity {
+			c.lagging = false
+			continue
+		}
+		if !c.lagging {
+			c.lagSince = now
+			c.lagging = true
+		}
+		if !now.Before(c.lagSince.Add(b.config.GracePeriod)) {
+			c.err = ErrGracePeriodExceeded
+			delete(b.cursors, c)
+			expired = true
+		}
+	}
+	if expired {
+		b.trimLocked()
+		b.signalLocked()
+	}
+	b.scheduleGraceTimerLocked(now)
+}
+
+func (b *Buffer[T]) scheduleGraceTimerLocked(now time.Time) {
+	var earliest time.Time
+	for c := range b.cursors {
+		if c.lagging {
+			deadline := c.lagSince.Add(b.config.GracePeriod)
+			if earliest.IsZero() || deadline.Before(earliest) {
+				earliest = deadline
+			}
+		}
+	}
+	if earliest.IsZero() {
+		b.stopGraceTimerLocked()
+		return
+	}
+	if b.graceTimer != nil && earliest.Equal(b.graceDeadline) {
+		return
+	}
+	b.stopGraceTimerLocked()
+	b.graceDeadline = earliest
+	b.timerVersion++
+	version := b.timerVersion
+	delay := earliest.Sub(now)
+	if delay < 0 {
+		delay = 0
+	}
+	b.graceTimer = b.config.Clock.AfterFunc(delay, func() {
+		b.mu.Lock()
+		defer b.mu.Unlock()
+		if b.closed || version != b.timerVersion {
+			return
+		}
+		b.graceTimer = nil
+		b.graceDeadline = time.Time{}
+		b.refreshGraceLocked()
+	})
+}
+
+func (b *Buffer[T]) stopGraceTimerLocked() {
+	if b.graceTimer != nil {
+		b.graceTimer.Stop()
+		b.graceTimer = nil
+		b.graceDeadline = time.Time{}
+		b.timerVersion++
+	}
+}
+
+func (b *Buffer[T]) signalLocked() {
+	close(b.notify)
+	b.notify = make(chan struct{})
+}
