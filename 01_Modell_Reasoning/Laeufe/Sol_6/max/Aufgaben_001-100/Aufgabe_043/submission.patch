+package tracing
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/attribute"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+func TestNewResource(t *testing.T) {
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "")
+
+	res, err := newResource(context.Background(), "v1.2.3")
+	require.NoError(t, err)
+	assert.Equal(t, "flipt", resourceValue(res.Attributes(), "service.name"))
+	assert.Equal(t, "v1.2.3", resourceValue(res.Attributes(), "service.version"))
+
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "service.name=from-attributes,service.version=from-environment,region=local")
+	res, err = newResource(context.Background(), "v1.2.3")
+	require.NoError(t, err)
+	assert.Equal(t, "from-attributes", resourceValue(res.Attributes(), "service.name"))
+	assert.Equal(t, "v1.2.3", resourceValue(res.Attributes(), "service.version"))
+	assert.Equal(t, "local", resourceValue(res.Attributes(), "region"))
+
+	t.Setenv("OTEL_SERVICE_NAME", "from-service-name")
+	res, err = newResource(context.Background(), "v1.2.3")
+	require.NoError(t, err)
+	assert.Equal(t, "from-service-name", resourceValue(res.Attributes(), "service.name"))
+}
+
+func resourceValue(attrs []attribute.KeyValue, key attribute.Key) string {
+	for _, attr := range attrs {
+		if attr.Key == key {
+			return attr.Value.AsString()
+		}
+	}
+	return ""
+}
+
+func TestNewProviderAlwaysSamples(t *testing.T) {
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "")
+	provider, err := NewProvider(context.Background(), "v1.2.3")
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, provider.Shutdown(context.Background())) })
+
+	_, span := provider.Tracer("test").Start(context.Background(), "sampled")
+	assert.True(t, span.SpanContext().IsSampled())
+	span.End()
+}
+
+func TestNewProviderResourceError(t *testing.T) {
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "missing-value")
+	_, err := NewProvider(context.Background(), "v1.2.3")
+	require.Error(t, err)
+}
+
+func TestGetExporter(t *testing.T) {
+	tests := []struct {
+		name string
+		cfg  config.TracingConfig
+	}{
+		{"Jaeger", config.TracingConfig{Exporter: config.TracingJaeger, Jaeger: config.JaegerTracingConfig{Host: "localhost", Port: 6831}}},
+		{"Zipkin", config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}},
+		{"OTLP HTTP", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "http://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"OTLP HTTPS", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "https://localhost:4318", Headers: map[string]string{"key": "value"}}}},
+		{"OTLP gRPC", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "grpc://localhost:4317", Headers: map[string]string{"key": "value"}}}},
+		{"OTLP host:port", config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: "localhost:4317", Headers: map[string]string{"key": "value"}}}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			exporter, shutdown, err := GetExporter(context.Background(), &tt.cfg)
+			require.NoError(t, err)
+			require.NotNil(t, exporter)
+			require.NotNil(t, shutdown)
+			assert.NoError(t, shutdown(context.Background()))
+			assert.NoError(t, shutdown(context.Background()))
+		})
+	}
+}
+
+func TestGetExporterMultipleCalls(t *testing.T) {
+	bad := config.TracingConfig{Exporter: config.TracingExporter(255)}
+	_, _, err := GetExporter(context.Background(), &bad)
+	require.EqualError(t, err, "unsupported tracing exporter: 255")
+
+	good := config.TracingConfig{Exporter: config.TracingZipkin, Zipkin: config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"}}
+	first, stopFirst, err := GetExporter(context.Background(), &good)
+	require.NoError(t, err)
+	second, stopSecond, err := GetExporter(context.Background(), &good)
+	require.NoError(t, err)
+	assert.NotSame(t, first, second)
+	assert.NoError(t, stopFirst(context.Background()))
+	assert.NoError(t, stopSecond(context.Background()))
+}
+
+func TestGetExporterInvalidOTLPEndpoint(t *testing.T) {
+	for _, endpoint := range []string{"", "localhost", "localhost:bad", "http://", "http://localhost:bad", "grpc://localhost:4317/path", "ftp://localhost:4317", "http://%"} {
+		t.Run(endpoint, func(t *testing.T) {
+			cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{Endpoint: endpoint}}
+			exporter, shutdown, err := GetExporter(context.Background(), &cfg)
+			require.Error(t, err)
+			assert.True(t, strings.HasPrefix(err.Error(), "parsing otlp endpoint"), err.Error())
+			assert.Nil(t, exporter)
+			assert.Nil(t, shutdown)
+		})
+	}
+}
+
+func TestOTLPHTTPExporterUsesEndpointAndHeaders(t *testing.T) {
+	requests := make(chan *http.Request, 1)
+	collector := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case requests <- r:
+		default:
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer collector.Close()
+
+	cfg := config.TracingConfig{Exporter: config.TracingOTLP, OTLP: config.OTLPTracingConfig{
+		Endpoint: collector.URL + "/custom/traces",
+		Headers:  map[string]string{"x-test-header": "configured"},
+	}}
+	exporter, shutdown, err := GetExporter(context.Background(), &cfg)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, shutdown(context.Background())) }()
+	cfg.OTLP.Headers["x-test-header"] = "changed-after-construction"
+
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSyncer(exporter))
+	defer func() { assert.NoError(t, provider.Shutdown(context.Background())) }()
+	_, span := provider.Tracer("test").Start(context.Background(), "exported")
+	span.End()
+
+	select {
+	case request := <-requests:
+		assert.Equal(t, "/custom/traces", request.URL.Path)
+		assert.Equal(t, "configured", request.Header.Get("x-test-header"))
+	case <-time.After(5 * time.Second):
+		t.Fatal("OTLP HTTP collector did not receive a span")
+	}
+}
