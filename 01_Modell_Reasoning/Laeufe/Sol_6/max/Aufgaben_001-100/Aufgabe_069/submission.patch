+func TestVariableRejectsMatcherFunctions(t *testing.T) {
+	tests := []struct {
+		value      string
+		expression string
+	}{
+		{"{{regexp.match(\"foo\")}}", "regexp.match(\"foo\")"},
+		{"prefix{{regexp.not_match(\"foo\")}}suffix", "regexp.not_match(\"foo\")"},
+		{"{{email.local(regexp.match(\"foo\"))}}", "email.local(regexp.match(\"foo\"))"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.value, func(t *testing.T) {
+			_, err := Variable(tt.value)
+			if assert.True(t, trace.IsBadParameter(err), "error: %v", err) {
+				assert.EqualError(t, err, "matcher functions (like regexp.match) are not allowed here: "+strconv.Quote(tt.expression))
+			}
+		})
+	}
+}
