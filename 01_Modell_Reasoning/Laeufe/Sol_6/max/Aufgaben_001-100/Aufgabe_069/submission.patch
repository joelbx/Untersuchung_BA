+func TestMatcherErrors(t *testing.T) {
+	tests := []struct {
+		name    string
+		value   string
+		message string
+	}{
+		{
+			name:    "missing opening brackets",
+			value:   "regexp.match(\"foo\")}}",
+			message: "\"regexp.match(\\\"foo\\\")}}\" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}",
+		},
+		{
+			name:    "missing closing brackets",
+			value:   "{{regexp.match(\"foo\")",
+			message: "\"{{regexp.match(\\\"foo\\\")\" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}",
+		},
+		{
+			name:    "unsupported namespace",
+			value:   "{{other.match(\"foo\")}}",
+			message: "unsupported function namespace other, supported namespaces are email and regexp",
+		},
+		{
+			name:    "unsupported regexp function",
+			value:   "{{regexp.other(\"foo\")}}",
+			message: "unsupported function regexp.other, supported functions are: regexp.match, regexp.not_match.",
+		},
+		{
+			name:    "unsupported email function",
+			value:   "{{email.other(\"foo\")}}",
+			message: "unsupported function email.other, supported functions are: email.local",
+		},
+		{
+			name:    "variable",
+			value:   "{{internal.foo}}",
+			message: "\"internal.foo\" is not a valid matcher expression - no variables and transformations are allowed",
+		},
+		{
+			name:    "transformation",
+			value:   "{{email.local(\"foo@example.com\")}}",
+			message: "\"email.local(\\\"foo@example.com\\\")\" is not a valid matcher expression - no variables and transformations are allowed",
+		},
+		{
+			name:    "multiple expressions",
+			value:   "{{regexp.match(\"foo\") + regexp.match(\"bar\")}}",
+			message: "\"regexp.match(\\\"foo\\\") + regexp.match(\\\"bar\\\")\" is not a valid matcher expression - no variables and transformations are allowed",
+		},
+		{
+			name:    "multiple templates",
+			value:   "{{regexp.match(\"foo\")}}{{regexp.match(\"bar\")}}",
+			message: "\"{{regexp.match(\\\"foo\\\")}}{{regexp.match(\\\"bar\\\")}}\" is not a valid matcher expression - no variables and transformations are allowed",
+		},
+		{
+			name:    "nested expression",
+			value:   "{{regexp.match(regexp.match(\"foo\"))}}",
+			message: "\"regexp.match(regexp.match(\\\"foo\\\"))\" is not a valid matcher expression - no variables and transformations are allowed",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			matcher, err := Match(tt.value)
+			assert.Nil(t, matcher)
+			if assert.True(t, trace.IsBadParameter(err), "error: %v", err) {
+				assert.EqualError(t, err, tt.message)
+			}
+		})
+	}
+
+	for _, value := range []string{
+		"{{regexp.match()}}",
+		"{{regexp.match(\"foo\", \"bar\")}}",
+		"{{regexp.match(internal.foo)}}",
+		"{{regexp.match(42)}}",
+		"{{email.local(internal.foo)}}",
+	} {
+		t.Run(value, func(t *testing.T) {
+			_, err := Match(value)
+			assert.True(t, trace.IsBadParameter(err), "error: %v", err)
+		})
+	}
+
+	for _, value := range []string{"{{regexp.match(\"[\")}}", "{{regexp.not_match(\"[\")}}"} {
+		t.Run(value, func(t *testing.T) {
+			_, err := Match(value)
+			if assert.True(t, trace.IsBadParameter(err), "error: %v", err) {
+				assert.True(t, strings.HasPrefix(err.Error(), "failed parsing regexp \"[\": "), "error: %v", err)
+			}
+		})
+	}
+}
