+func TestMatch(t *testing.T) {
+	tests := []struct {
+		name  string
+		value string
+		cases map[string]bool
+	}{
+		{
+			name:  "literal",
+			value: "a.b",
+			cases: map[string]bool{"a.b": true, "axb": false, "xa.b": false},
+		},
+		{
+			name:  "wildcard",
+			value: "foo*bar",
+			cases: map[string]bool{"foobar": true, "foo123bar": true, "foo123barx": false},
+		},
+		{
+			name:  "standalone wildcard",
+			value: "*",
+			cases: map[string]bool{"": true, "anything": true},
+		},
+		{
+			name:  "raw regexp",
+			value: "^foo[0-9]+$",
+			cases: map[string]bool{"foo123": true, "foo": false, "xfoo123": false},
+		},
+		{
+			name:  "regexp.match",
+			value: "{{regexp.match(\"b.r\")}}",
+			cases: map[string]bool{"bar": true, "a-bar-z": true, "baz": false},
+		},
+		{
+			name:  "regexp.not_match",
+			value: "{{regexp.not_match(\"bar\")}}",
+			cases: map[string]bool{"bar": false, "foo-bar": false, "baz": true},
+		},
+		{
+			name:  "static prefix and suffix",
+			value: "foo-{{regexp.match(\"^bar$\")}}-baz",
+			cases: map[string]bool{"foo-bar-baz": true, "foo-barx-baz": false, "foo-bar-qux": false},
+		},
+		{
+			name:  "negation with static text",
+			value: "foo-{{regexp.not_match(\"bar\")}}-baz",
+			cases: map[string]bool{"foo-qux-baz": true, "foo-bar-baz": false, "foo-qux-bazz": false},
+		},
+		{
+			name:  "overlapping prefix and suffix",
+			value: "aa{{regexp.not_match(\"x\")}}aa",
+			cases: map[string]bool{"aaa": false, "aaaa": true},
+		},
+		{
+			name:  "preserve static whitespace",
+			value: " pre {{ regexp.match(\"x\") }} post ",
+			cases: map[string]bool{" pre x post ": true, "pre x post": false},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			matcher, err := Match(tt.value)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for in, want := range tt.cases {
+				assert.Equal(t, want, matcher.Match(in), "input %q", in)
+			}
+		})
+	}
+}
