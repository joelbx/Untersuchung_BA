+// Matcher tests whether a string satisfies a matcher expression.
+type Matcher interface {
+	Match(in string) bool
+}
+
+// regexpMatcher matches a string against a compiled regular expression.
+type regexpMatcher struct {
+	*regexp.Regexp
+}
+
+func (m regexpMatcher) Match(in string) bool {
+	return m.Regexp.MatchString(in)
+}
+
+// prefixSuffixMatcher applies a matcher to the content between a fixed prefix
+// and suffix.
+type prefixSuffixMatcher struct {
+	prefix  string
+	suffix  string
+	matcher Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if len(in) < len(m.prefix)+len(m.suffix) ||
+		!strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+// notMatcher inverts an inner matcher's result.
+type notMatcher struct {
+	matcher Matcher
+}
+
+func (m notMatcher) Match(in string) bool {
+	return !m.matcher.Match(in)
+}
+
+// Match parses a literal, glob, regular expression, or matcher template.
+// Regular expressions outside templates must begin with ^ and end with $.
+func Match(value string) (Matcher, error) {
+	match := reVariable.FindStringSubmatch(value)
+	if len(match) == 0 {
+		if strings.Count(value, "{{") > 1 && strings.Count(value, "}}") > 1 {
+			return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", value)
+		}
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter(
+				"%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}",
+				value)
+		}
+
+		pattern := value
+		if !strings.HasPrefix(value, "^") || !strings.HasSuffix(value, "$") {
+			pattern = "^" + utils.GlobToRegexp(value) + "$"
+		}
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+		}
+		return regexpMatcher{re}, nil
+	}
+
+	prefix, expression, suffix := match[1], match[2], match[3]
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	matcher, err := parseMatcherExpression(expr, expression)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if prefix == "" && suffix == "" {
+		return matcher, nil
+	}
+	return prefixSuffixMatcher{prefix: prefix, suffix: suffix, matcher: matcher}, nil
+}
+
+// parseMatcherExpression accepts only one function call with a string literal
+// argument. Variable references and transformations have no meaning in a
+// matcher expression.
+func parseMatcherExpression(expr ast.Expr, expression string) (Matcher, error) {
+	invalid := func() error {
+		return trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return nil, invalid()
+	}
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, invalid()
+	}
+	namespace, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return nil, invalid()
+	}
+
+	fn := selector.Sel.Name
+	switch namespace.Name {
+	case "regexp":
+		if fn != "match" && fn != "not_match" {
+			return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match.", fn)
+		}
+	case EmailNamespace:
+		if fn != EmailLocalFnName {
+			return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", fn)
+		}
+	default:
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("expected 1 string literal argument for %s.%s, got %d", namespace.Name, fn, len(call.Args))
+	}
+	arg, ok := call.Args[0].(*ast.BasicLit)
+	if !ok {
+		return nil, invalid()
+	}
+	if arg.Kind != token.STRING {
+		return nil, trace.BadParameter("expected a string literal argument for %s.%s", namespace.Name, fn)
+	}
+	raw, err := strconv.Unquote(arg.Value)
+	if err != nil {
+		return nil, trace.BadParameter("invalid string literal for %s.%s: %v", namespace.Name, fn, err)
+	}
+	if namespace.Name == EmailNamespace {
+		return nil, invalid()
+	}
+
+	re, err := regexp.Compile(raw)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", raw, err)
+	}
+	matcher := Matcher(regexpMatcher{re})
+	if fn == "not_match" {
+		matcher = notMatcher{matcher}
+	}
+	return matcher, nil
+}
+
+// containsMatcherFunction keeps matcher calls out of variable expressions,
+// including matcher calls nested inside a transformation.
+func containsMatcherFunction(expr ast.Expr) bool {
+	found := false
+	ast.Inspect(expr, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		namespace, ok := selector.X.(*ast.Ident)
+		if ok && namespace.Name == "regexp" && (selector.Sel.Name == "match" || selector.Sel.Name == "not_match") {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
