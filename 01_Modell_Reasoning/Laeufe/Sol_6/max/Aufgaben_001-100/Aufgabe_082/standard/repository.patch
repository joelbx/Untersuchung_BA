+type recordingWriteCloser struct {
+	bytes.Buffer
+	closeCount int
+	closeErr   error
+	writeErr   error
+	shortWrite bool
+}
+
+func (w *recordingWriteCloser) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	if w.shortWrite {
+		return 0, nil
+	}
+	return w.Buffer.Write(p)
+}
+
+func (w *recordingWriteCloser) Close() error {
+	w.closeCount++
+	return w.closeErr
+}
+
+func TestWriterEmitter(t *testing.T) {
+	writer := &recordingWriteCloser{}
+	emitter := NewWriterEmitter(writer)
+	event := &UserLogin{
+		Metadata:     Metadata{Type: UserLoginEvent, Code: UserLocalLoginCode},
+		UserMetadata: UserMetadata{User: "bob"},
+	}
+
+	for i := 0; i < 2; i++ {
+		require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	}
+	lines := bytes.Split(bytes.TrimSuffix(writer.Bytes(), []byte("\n")), []byte("\n"))
+	require.Len(t, lines, 2)
+	for _, line := range lines {
+		var got map[string]interface{}
+		require.NoError(t, json.Unmarshal(line, &got))
+		require.Equal(t, UserLoginEvent, got["event"])
+		require.Equal(t, "bob", got["user"])
+	}
+
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 1, writer.closeCount)
+}
+
+func TestWriterEmitterErrors(t *testing.T) {
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent}}
+	writer := &recordingWriteCloser{writeErr: os.ErrPermission}
+	emitter := NewWriterEmitter(writer)
+	require.True(t, trace.IsAccessDenied(emitter.EmitAuditEvent(context.Background(), event)))
+
+	writer.writeErr = nil
+	writer.shortWrite = true
+	require.Error(t, emitter.EmitAuditEvent(context.Background(), event))
+
+	writer.closeErr = errors.New("writer close failed")
+	err := emitter.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "writer close failed")
+	require.Equal(t, 1, writer.closeCount)
+}
+
+func TestMultiLogEmitter(t *testing.T) {
+	first := &recordingWriteCloser{closeErr: errors.New("first close failed")}
+	second := &recordingWriteCloser{closeErr: errors.New("second close failed")}
+	firstEmitter := NewWriterEmitter(first)
+	secondEmitter := NewWriterEmitter(second)
+
+	log, err := NewMultiLog(firstEmitter, secondEmitter)
+	require.NoError(t, err)
+	event := &UserLogin{Metadata: Metadata{Type: UserLoginEvent}}
+	require.NoError(t, log.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, first.String(), second.String())
+	require.True(t, bytes.HasSuffix(first.Bytes(), []byte("\n")))
+
+	second.writeErr = errors.New("second write failed")
+	err = log.EmitAuditEvent(context.Background(), event)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "second write failed")
+	require.Equal(t, 2, bytes.Count(first.Bytes(), []byte("\n")))
+	require.Equal(t, 1, bytes.Count(second.Bytes(), []byte("\n")))
+
+	err = log.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "first close failed")
+	require.Contains(t, err.Error(), "second close failed")
+	require.Equal(t, 1, first.closeCount)
+	require.Equal(t, 1, second.closeCount)
+}
+
+func TestNewMultiLogRejectsNonEmitter(t *testing.T) {
+	log, err := NewMultiLog(NewWriterEmitter(&recordingWriteCloser{}), NewWriterLog(&recordingWriteCloser{}))
+	require.Nil(t, log)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
