+// NewWriterEmitter returns an emitter that writes audit events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		writer:    w,
+		WriterLog: NewWriterLog(utils.NopWriteCloser(w)),
+	}
+}
+
+// WriterEmitter writes audit events to an external writer and supports the
+// legacy audit log operations through WriterLog.
+type WriterEmitter struct {
+	*WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes a JSON event followed by a newline.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	line, err := utils.FastMarshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	line = append(line, '\n')
+	n, err := w.writer.Write(line)
+	if err != nil {
+		return trace.Wrap(trace.ConvertSystemError(err))
+	}
+	if n != len(line) {
+		return trace.Wrap(trace.ConvertSystemError(io.ErrShortWrite))
+	}
+	return nil
+}
+
+// Close closes the writer and the embedded log. WriterLog uses a no-op closer
+// around the same writer so that the underlying writer is closed only once.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(
+		trace.Wrap(trace.ConvertSystemError(w.writer.Close())),
+		trace.Wrap(trace.ConvertSystemError(w.WriterLog.Close())),
+	)
+}
