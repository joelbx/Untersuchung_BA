@@ -0,0 +1,57 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	var db *SQLStore
+
+	BeforeEach(func() {
+		o := orm.NewOrm()
+		for _, uid := range []string{"user-props-a", "user-props-b"} {
+			_, err := o.Raw(`insert into user (id, user_name, name, email, password, created_at, updated_at)
+				values (?, ?, '', ?, '', datetime('now'), datetime('now'))`, uid, uid, uid+"@example.com").Exec()
+			Expect(err).ToNot(HaveOccurred())
+		}
+		db = &SQLStore{}
+	})
+
+	AfterEach(func() {
+		o := orm.NewOrm()
+		_, err := o.Raw("delete from user_props where user_id in (?, ?)", "user-props-a", "user-props-b").Exec()
+		Expect(err).ToNot(HaveOccurred())
+		_, err = o.Raw("delete from user where id in (?, ?)", "user-props-a", "user-props-b").Exec()
+		Expect(err).ToNot(HaveOccurred())
+	})
+
+	It("keeps each user's values separate through updates and deletes", func() {
+		a := db.UserProps(request.WithUser(context.Background(), model.User{ID: "user-props-a"}))
+		b := db.UserProps(request.WithUser(context.Background(), model.User{ID: "user-props-b"}))
+
+		Expect(a.Put("service-key", "a1")).To(Succeed())
+		Expect(b.Put("service-key", "b1")).To(Succeed())
+		Expect(a.Put("service-key", "a2")).To(Succeed())
+		Expect(a.Get("service-key")).To(Equal("a2"))
+		Expect(b.Get("service-key")).To(Equal("b1"))
+
+		Expect(a.Delete("service-key")).To(Succeed())
+		_, err := a.Get("service-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(b.Get("service-key")).To(Equal("b1"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		repo := db.UserProps(context.Background())
+		Expect(repo.Put("service-key", "value")).To(Equal(model.ErrNotAuthorized))
+		_, err := repo.Get("service-key")
+		Expect(err).To(Equal(model.ErrNotAuthorized))
+		Expect(repo.Delete("service-key")).To(Equal(model.ErrNotAuthorized))
+	})
+})
