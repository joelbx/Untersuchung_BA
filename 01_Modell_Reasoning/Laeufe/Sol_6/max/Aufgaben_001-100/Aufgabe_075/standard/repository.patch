index 0000000..8f29970
--- /dev/null
+++ b/db/migration/20210620120000_create_user_props_table.go
@@ -0,0 +1,45 @@
+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserPropsTable, downCreateUserPropsTable)
+}
+
+func upCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props
+(
+	user_id varchar(255) not null references user (id) on update cascade on delete cascade,
+	"key" varchar(255) not null,
+	value text not null,
+	primary key (user_id, "key")
+);
+
+insert into user_props (user_id, "key", value)
+select u.id, 'LastFMSessionKey', p.value
+from property p
+join user u on u.id = substr(p.id, length('LastFMSessionKey_') + 1)
+where substr(p.id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_';
+
+delete from property
+where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_'
+	and substr(id, length('LastFMSessionKey_') + 1) in (select id from user);
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+insert or replace into property (id, value)
+select 'LastFMSessionKey_' || user_id, value
+from user_props where "key" = 'LastFMSessionKey';
+
+drop table user_props;
+`)
+	return err
+}
diff --git a/db/migration/user_props_test.go b/db/migration/user_props_test.go
new file mode 100644
index 0000000..31f3d09
--- /dev/null
+++ b/db/migration/user_props_test.go
@@ -0,0 +1,89 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMigratesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	_, err = db.Exec(`
+		pragma foreign_keys = on;
+		create table user (id text primary key);
+		create table property (id text primary key, value text not null);
+		insert into user values ('a'), ('b');
+		insert into property values
+			('LastFMSessionKey_a', 'session-a'),
+			('LastFMSessionKey_b', 'session-b'),
+			('LastFMSessionKey_missing', 'orphan'),
+			('OtherProperty', 'global');
+	`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	for uid, want := range map[string]string{"a": "session-a", "b": "session-b"} {
+		var got string
+		if err := db.QueryRow(`select value from user_props where user_id = ? and "key" = 'LastFMSessionKey'`, uid).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != want {
+			t.Fatalf("session for %s: got %q, want %q", uid, got, want)
+		}
+	}
+	var count int
+	if err := db.QueryRow("select count(*) from property").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Fatalf("global properties after migration: got %d, want 2", count)
+	}
+
+	if _, err := db.Exec("delete from user where id = 'a'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow("select count(*) from user_props where user_id = 'a'").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Fatalf("deleted user's properties remain: %d", count)
+	}
+
+	tx, err = db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := downCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var restored string
+	if err := db.QueryRow("select value from property where id = 'LastFMSessionKey_b'").Scan(&restored); err != nil {
+		t.Fatal(err)
+	}
+	if restored != "session-b" {
+		t.Fatalf("restored session: got %q, want %q", restored, "session-b")
+	}
+}
