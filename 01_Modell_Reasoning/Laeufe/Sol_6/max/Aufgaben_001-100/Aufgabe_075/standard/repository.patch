+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"io/ioutil"
+	"net/http"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("LastFM callback", func() {
+	It("stores the session key for the callback's user", func() {
+		ds := &tests.MockDataStore{}
+		router := NewRouter(ds)
+		httpClient := &tests.FakeHttpClient{Res: http.Response{
+			StatusCode: http.StatusOK,
+			Body:       ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"session-a"}}`)),
+		}}
+		router.client = NewClient("API_KEY", "SECRET", "en", httpClient)
+
+		Expect(router.fetchSessionKey(context.Background(), "user-a", "token")).To(Succeed())
+		ctxA := request.WithUser(context.Background(), model.User{ID: "user-a"})
+		ctxB := request.WithUser(context.Background(), model.User{ID: "user-b"})
+		Expect(ds.UserProps(ctxA).Get(sessionKeyProperty)).To(Equal("session-a"))
+		_, err := ds.UserProps(ctxB).Get(sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+	})
+})
