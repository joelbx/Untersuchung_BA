--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,66 @@
+package persistence
+
+import (
+	"context"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{
+		ctx:       ctx,
+		ormer:     o,
+		tableName: "user_props",
+	}}
+}
+
+func (r *userPropsRepository) Put(key string, value string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	insert := Insert(r.tableName).
+		Columns("user_id", "key", "value").
+		Values(uid, key, value).
+		Suffix("ON CONFLICT (user_id, key) DO UPDATE SET value = excluded.value")
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	sel := r.newSelect().Columns("value").Where(Eq{"user_id": uid, "key": key})
+	var prop struct{ Value string }
+	if err := r.queryOne(sel, &prop); err != nil {
+		return "", err
+	}
+	return prop.Value, nil
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
+
+func (r *userPropsRepository) userID() (string, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return "", model.ErrNotAuthorized
+	}
+	return u.ID, nil
+}
+
+var _ model.UserPropsRepository = (*userPropsRepository)(nil)
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
