+func TestCheckProxyAddr(t *testing.T) {
+	serverWithPublicAddr := func(addr string) services.Server {
+		server := &services.ServerV2{}
+		server.SetPublicAddr(addr)
+		return server
+	}
+	tests := []struct {
+		name      string
+		config    service.ProxyConfig
+		proxies   []services.Server
+		proxyFlag string
+		want      string
+		wantError bool
+	}{
+		{
+			name: "local Kubernetes proxy",
+			config: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube: service.KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:443"}},
+				},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "registered proxy when local Kubernetes proxy is disabled",
+			config: service.ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "local.example.com:3080"}},
+			},
+			proxies: []services.Server{
+				serverWithPublicAddr("ftp://unparseable.example.com:3080"),
+				serverWithPublicAddr("bad.example.com:invalid"),
+				serverWithPublicAddr("https://registered.example.com:3080"),
+			},
+			want: "https://registered.example.com:3026",
+		},
+		{
+			name: "invalid local address falls back to registered proxy",
+			config: service.ProxyConfig{
+				Kube: service.KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "bad.example.com:invalid"}},
+				},
+			},
+			proxies: []services.Server{serverWithPublicAddr("registered.example.com:3080")},
+			want:    "https://registered.example.com:3026",
+		},
+		{
+			name:      "explicit proxy flag",
+			proxyFlag: "https://custom.example.com:4443",
+			want:      "https://custom.example.com:4443",
+		},
+		{
+			name:      "no valid registered proxy",
+			proxies:   []services.Server{serverWithPublicAddr("bad.example.com:invalid")},
+			wantError: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			command := &AuthCommand{
+				config:       &service.Config{Proxy: tt.config},
+				outputFormat: identityfile.FormatKubernetes,
+				proxyAddr:    tt.proxyFlag,
+			}
+			err := command.checkProxyAddr(mockClient{proxies: tt.proxies})
+			if (err != nil) != tt.wantError {
+				t.Fatalf("checkProxyAddr() error = %v, want error = %v", err, tt.wantError)
+			}
+			if command.proxyAddr != tt.want {
+				t.Errorf("proxy address = %q, want %q", command.proxyAddr, tt.want)
+			}
+		})
 	}
 }
 
