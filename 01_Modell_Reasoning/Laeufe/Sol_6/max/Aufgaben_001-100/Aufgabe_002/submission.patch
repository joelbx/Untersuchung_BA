+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name      string
+		config    ProxyConfig
+		want      string
+		wantError bool
+	}{
+		{
+			name:      "disabled",
+			config:    ProxyConfig{PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}}},
+			wantError: true,
+		},
+		{
+			name: "Kubernetes public address takes precedence",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube: KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:4443"}},
+				},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "generic public address uses Kubernetes port",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:3080"}},
+				Kube: KubeProxyConfig{
+					Enabled:    true,
+					ListenAddr: utils.NetAddr{Addr: "0.0.0.0:4443"},
+				},
+			},
+			want: "https://proxy.example.com:3026",
+		},
+		{
+			name: "IPv6 address",
+			config: ProxyConfig{
+				Kube: KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "[2001:db8::1]:4443"}},
+				},
+			},
+			want: "https://[2001:db8::1]:3026",
+		},
+		{
+			name: "skip invalid public address",
+			config: ProxyConfig{
+				Kube: KubeProxyConfig{
+					Enabled: true,
+					PublicAddrs: []utils.NetAddr{
+						{Addr: "bad.example.com:invalid"},
+						{Addr: "good.example.com:443"},
+					},
+				},
+			},
+			want: "https://good.example.com:3026",
+		},
+		{
+			name:      "no public address",
+			config:    ProxyConfig{Kube: KubeProxyConfig{Enabled: true}},
+			wantError: true,
+		},
+		{
+			name: "invalid public address",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "proxy.example.com:invalid"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			wantError: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.config.KubeAddr()
+			if (err != nil) != tt.wantError {
+				t.Fatalf("KubeAddr() error = %v, want error = %v", err, tt.wantError)
+			}
+			if got != tt.want {
+				t.Errorf("KubeAddr() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
