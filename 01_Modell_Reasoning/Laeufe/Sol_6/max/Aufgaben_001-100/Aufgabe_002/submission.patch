+// KubeAddr returns the public Kubernetes proxy URL on the default port.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	for _, addr := range c.Kube.PublicAddrs {
+		if kubeAddr, err := kubeProxyURL(addr); err == nil {
+			return kubeAddr, nil
+		}
+	}
+	for _, addr := range c.PublicAddrs {
+		if kubeAddr, err := kubeProxyURL(addr); err == nil {
+			return kubeAddr, nil
+		}
+	}
+	return "", trace.BadParameter("Kubernetes proxy has no valid public address")
+}
+
+// kubeProxyURL replaces the advertised port with the Kubernetes proxy port.
+func kubeProxyURL(addr utils.NetAddr) (string, error) {
+	if addr.Path != "" || addr.AddrNetwork == "unix" {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+	}
+
+	host := addr.Addr
+	if parsedHost, port, err := net.SplitHostPort(host); err == nil {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 ||
+			(strings.HasPrefix(host, "[") && net.ParseIP(parsedHost) == nil) {
+			return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+		}
+		host = parsedHost
+	} else if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+		host = host[1 : len(host)-1]
+	}
+	if host == "" || strings.ContainsAny(host, "[]/?#@%\\ \t\r\n\"'<>|^{}") ||
+		(strings.Contains(host, ":") && net.ParseIP(host) == nil) {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+	}
+
+	return (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)),
+	}).String(), nil
+}
