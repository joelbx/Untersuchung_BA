--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,29 @@
+import { HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>((props, ref: Ref<HTMLDialogElement>): JSX.Element => {
+    const supportsNativeDialog =
+        typeof HTMLDialogElement === 'function' &&
+        typeof HTMLDialogElement.prototype.showModal === 'function' &&
+        typeof HTMLDialogElement.prototype.close === 'function';
+
+    if (!supportsNativeDialog) {
+        return (
+            <div
+                role="dialog"
+                hidden={!props.open}
+                {...(props as HTMLAttributes<HTMLDivElement>)}
+                ref={ref as Ref<HTMLDivElement>}
+            />
+        );
+    }
+
+    return <dialog {...props} ref={ref} />;
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
