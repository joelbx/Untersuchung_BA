+import { createRef } from 'react';
+
+import { render, screen } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('exposes its children and forwards attributes and the host ref in JSDOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+
+        render(
+            <Dialog
+                ref={ref}
+                open
+                aria-label="Example"
+                data-testid="dialog-host"
+                title="Dialog title"
+                className="custom"
+            >
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const host = screen.getByRole('dialog', { name: 'Example' });
+        const button = screen.getByRole('button', { name: 'Hello' });
+
+        expect(host.tagName).toBe('DIV');
+        expect(ref.current).toBe(host);
+        expect(host).toHaveAttribute('data-testid', 'dialog-host');
+        expect(host).toHaveAttribute('title', 'Dialog title');
+        expect(host).toHaveClass('custom');
+        expect(host).toHaveAttribute('open');
+        expect(host).toContainElement(button);
+        expect(button).toBeVisible();
+        expect(button.tabIndex).toBe(0);
+    });
+
+    it('uses the native dialog when its methods are available', () => {
+        const { prototype } = HTMLDialogElement;
+        const showModal = Object.getOwnPropertyDescriptor(prototype, 'showModal');
+        const close = Object.getOwnPropertyDescriptor(prototype, 'close');
+
+        Object.defineProperty(prototype, 'showModal', { configurable: true, value: jest.fn() });
+        Object.defineProperty(prototype, 'close', { configurable: true, value: jest.fn() });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            render(
+                <Dialog ref={ref} open aria-label="Native" data-testid="native-dialog">
+                    <button type="button">Hello</button>
+                </Dialog>
+            );
+
+            const host = screen.getByRole('dialog', { name: 'Native' });
+            expect(host.tagName).toBe('DIALOG');
+            expect(ref.current).toBe(host);
+            expect(host).toHaveAttribute('data-testid', 'native-dialog');
+            expect(screen.getByRole('button', { name: 'Hello' })).toBeVisible();
+        } finally {
+            if (showModal) {
+                Object.defineProperty(prototype, 'showModal', showModal);
+            } else {
+                Reflect.deleteProperty(prototype, 'showModal');
+            }
+            if (close) {
+                Object.defineProperty(prototype, 'close', close);
+            } else {
+                Reflect.deleteProperty(prototype, 'close');
+            }
+        }
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
new file mode 100644
