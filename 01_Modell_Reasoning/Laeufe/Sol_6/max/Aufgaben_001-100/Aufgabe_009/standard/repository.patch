+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useState } from 'react';
+import { IMyDevice } from 'matrix-js-sdk/src/matrix';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Field from '../../elements/Field';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DevicesState } from './useOwnDevices';
+
+interface Props {
+    device: IMyDevice;
+    saveDeviceName: DevicesState['saveDeviceName'];
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [name, setName] = useState(device.display_name ?? device.device_id);
+    const [draftName, setDraftName] = useState(name);
+    const [isEditing, setIsEditing] = useState(false);
+    const [isSaving, setIsSaving] = useState(false);
+    const [error, setError] = useState<string>();
+
+    useEffect(() => {
+        setName(device.display_name ?? device.device_id);
+    }, [device.device_id, device.display_name]);
+
+    const onRename = (): void => {
+        setDraftName(name);
+        setError(undefined);
+        setIsEditing(true);
+    };
+
+    const onCancel = (): void => {
+        setDraftName(name);
+        setError(undefined);
+        setIsEditing(false);
+    };
+
+    const onSave = async (): Promise<void> => {
+        if (isSaving) return;
+        if (draftName === name) {
+            setIsEditing(false);
+            return;
+        }
+
+        setError(undefined);
+        setIsSaving(true);
+        try {
+            await saveDeviceName(device.device_id, draftName);
+            setName(draftName);
+            setIsEditing(false);
+        } catch (error) {
+            setError(_t('Failed to set display name.'));
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (!isEditing) {
+        return <div className='mx_DeviceDetailHeading_read' data-testid='device-detail-heading'>
+            <Heading size='h3'>{ name }</Heading>
+            <AccessibleButton
+                kind='link_inline'
+                onClick={onRename}
+                data-testid='device-detail-rename-button'
+            >
+                { _t('Rename') }
+            </AccessibleButton>
+        </div>;
+    }
+
+    return <form
+        className='mx_DeviceDetailHeading_edit'
+        data-testid='device-detail-heading-edit'
+        onSubmit={event => {
+            event.preventDefault();
+            void onSave();
+        }}
+    >
+        <Field
+            label={_t('Session name')}
+            type='text'
+            value={draftName}
+            maxLength={100}
+            autoComplete='off'
+            autoFocus
+            disabled={isSaving}
+            data-testid='device-detail-name-input'
+            onChange={event => setDraftName(event.target.value.slice(0, 100))}
+        />
+        <p className='mx_DeviceDetailHeading_hint'>
+            { _t('Session names are visible to people you communicate with.') }
+        </p>
+        { error && <p role='alert' className='mx_DeviceDetailHeading_error' data-testid='device-detail-name-error'>
+            { error }
+        </p> }
+        <div className='mx_DeviceDetailHeading_actions'>
+            <AccessibleButton
+                element='button'
+                type='submit'
+                kind='primary_sm'
+                disabled={isSaving}
+                onClick={event => {
+                    event.preventDefault();
+                    void onSave();
+                }}
+                data-testid='device-detail-save-button'
+            >
+                { _t('Save') }
+                { isSaving && <span data-testid='device-detail-save-spinner'><Spinner w={16} h={16} /></span> }
+            </AccessibleButton>
+            <AccessibleButton
+                element='button'
+                type='button'
+                kind='link_inline'
+                disabled={isSaving}
+                onClick={onCancel}
+                data-testid='device-detail-cancel-button'
+            >
+                { _t('Cancel') }
+            </AccessibleButton>
+        </div>
+    </form>;
+};
