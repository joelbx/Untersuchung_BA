+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { act, fireEvent, render } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'my-device', display_name: 'Old name', isVerified: false };
+
+    it('shows the device ID when no display name is set', () => {
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ ...device, display_name: undefined }}
+            saveDeviceName={jest.fn()}
+        />);
+        expect(getByTestId('device-detail-heading').textContent).toContain(device.device_id);
+    });
+
+    it('cancels without saving and restores the original heading', () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-rename-button'));
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+        expect(getByTestId('device-detail-heading-edit').textContent)
+            .toContain('Session names are visible to people you communicate with.');
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Unsaved name' } });
+        fireEvent.click(getByTestId('device-detail-cancel-button'));
+
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading').textContent).toContain('Old name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('closes the editor without a request when the name is unchanged', () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename-button'));
+        fireEvent.click(getByTestId('device-detail-save-button'));
+        expect(getByTestId('device-detail-heading').textContent).toContain('Old name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('saves an empty name and shows progress until the request completes', async () => {
+        let finishSave: () => void = () => {};
+        const saveDeviceName = jest.fn(() => new Promise<void>(resolve => { finishSave = resolve; }));
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-rename-button'));
+        const input = getByTestId('device-detail-name-input') as HTMLInputElement;
+        expect(input.maxLength).toBe(100);
+        fireEvent.change(input, { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-save-button'));
+
+        expect(saveDeviceName).toHaveBeenCalledWith(device.device_id, '');
+        expect(getByTestId('device-detail-save-spinner')).toBeTruthy();
+        expect(getByTestId('device-detail-save-button').getAttribute('aria-disabled')).toBe('true');
+
+        await act(async () => { finishSave(); });
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading').querySelector('h3')?.textContent).toBe('');
+    });
+
+    it('limits the new name to 100 characters', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename-button'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'x'.repeat(101) } });
+        await act(async () => { fireEvent.click(getByTestId('device-detail-save-button')); });
+        expect(saveDeviceName).toHaveBeenCalledWith(device.device_id, 'x'.repeat(100));
+        expect(getByTestId('device-detail-heading').textContent).toContain('x'.repeat(100));
+    });
+
+    it('shows the required error and keeps the editor open when saving fails', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('Server failed'));
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+        fireEvent.click(getByTestId('device-detail-rename-button'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'New name' } });
+        await act(async () => { fireEvent.click(getByTestId('device-detail-save-button')); });
+
+        expect(getByTestId('device-detail-name-error').textContent).toBe('Failed to set display name.');
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+        expect(queryByTestId('device-detail-heading')).toBeNull();
+    });
+});
