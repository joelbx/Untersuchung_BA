diff --git a/packages/shared/test/mail/recipient.spec.ts b/packages/shared/test/mail/recipient.spec.ts
new file mode 100644
index 0000000..14c3b58
--- /dev/null
+++ b/packages/shared/test/mail/recipient.spec.ts
@@ -0,0 +1,38 @@
+import { inputToRecipient, splitBySeparator } from '../../lib/mail/recipient';
+
+describe('recipient input parsing', () => {
+    it('splits commas and semicolons without returning empty addresses', () => {
+        expect(
+            splitBySeparator(',plus@debye.proton.black, visionary@debye.proton.black; pro@debye.proton.black,')
+        ).toEqual(['plus@debye.proton.black', 'visionary@debye.proton.black', 'pro@debye.proton.black']);
+    });
+
+    it('removes angle brackets and ignores tokens that contain only whitespace or brackets', () => {
+        expect(splitBySeparator(' ; <first@example.com>, <<second@example.com>>; < > ;; ')).toEqual([
+            'first@example.com',
+            'second@example.com',
+        ]);
+    });
+
+    it('uses the email for both fields of plain and bare bracketed recipients', () => {
+        expect(inputToRecipient(' plain@example.com ')).toEqual({
+            Name: 'plain@example.com',
+            Address: 'plain@example.com',
+        });
+        expect(inputToRecipient(' <bracketed@example.com> ')).toEqual({
+            Name: 'bracketed@example.com',
+            Address: 'bracketed@example.com',
+        });
+        expect(inputToRecipient(' <<nested@example.com>> ')).toEqual({
+            Name: 'nested@example.com',
+            Address: 'nested@example.com',
+        });
+    });
+
+    it('keeps a supplied display name for named recipients', () => {
+        expect(inputToRecipient('Person <person@example.com>')).toEqual({
+            Name: 'Person',
+            Address: 'person@example.com',
+        });
+    });
+});
