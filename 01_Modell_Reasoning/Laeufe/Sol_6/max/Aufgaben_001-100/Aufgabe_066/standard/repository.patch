+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and descendants without losing other inline styles', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 100vh; color: red');
+        root.innerHTML = `
+            <section style="HEIGHT: calc(50VH - 1rem) !important; background: proton-url(https://example.test/image.jpg)">
+                <span style="height: 20px; min-height: 40vh; width: 30vh"></span>
+            </section>
+        `;
+
+        transformStyleAttributes(root);
+
+        const section = root.querySelector('section') as HTMLElement;
+        const span = root.querySelector('span') as HTMLElement;
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+        expect(section.style.height).toBe('auto');
+        expect(section.style.getPropertyPriority('height')).toBe('important');
+        expect(section.getAttribute('style')).toContain('background: proton-url(https://example.test/image.jpg)');
+        expect(span.getAttribute('style')).toBe('height: 20px; min-height: 40vh; width: 30vh');
+    });
+
+    it('leaves unrelated declarations intact when their values contain semicolons or vh text', () => {
+        const root = document.createElement('div');
+        const style = 'background: proton-url("https://example.test/image;height:50vh"); height: 20px; color: blue';
+        root.setAttribute('style', style);
+
+        transformStyleAttributes(root);
+
+        expect(root.getAttribute('style')).toBe(style);
+    });
+});
