+const viewportHeight = /\d(?:\.\d+)?vh\b/i;
+
+const transformDeclaration = (declaration: string) => {
+    const match = declaration.match(/^(\s*height\s*:)([\s\S]*)$/i);
+    if (!match) {
+        return declaration;
+    }
+
+    const value = match[2];
+    if (!viewportHeight.test(value.replace(/\/\*[\s\S]*?\*\//g, ''))) {
+        return declaration;
+    }
+
+    const leadingWhitespace = value.match(/^\s*/)?.[0] || '';
+    const suffix = value.match(/\s*!important\s*$/i)?.[0] || value.match(/\s*$/)?.[0] || '';
+    return `${match[1]}${leadingWhitespace}auto${suffix}`;
+};
+
+const replaceViewportHeights = (style: string) => {
+    let result = '';
+    let start = 0;
+    let parentheses = 0;
+    let quote: string | undefined;
+    let inComment = false;
+
+    for (let index = 0; index <= style.length; index++) {
+        const character = style[index];
+
+        if (index === style.length || (character === ';' && !quote && !inComment && parentheses === 0)) {
+            result += transformDeclaration(style.slice(start, index));
+            if (index < style.length) {
+                result += ';';
+            }
+            start = index + 1;
+            continue;
+        }
+
+        if (inComment) {
+            if (character === '*' && style[index + 1] === '/') {
+                inComment = false;
+                index++;
+            }
+            continue;
+        }
+
+        if (character === '\\') {
+            index++;
+        } else if (quote) {
+            if (character === quote) {
+                quote = undefined;
+            }
+        } else if (character === '/' && style[index + 1] === '*') {
+            inComment = true;
+            index++;
+        } else if (character === '"' || character === "'") {
+            quote = character;
+        } else if (character === '(') {
+            parentheses++;
+        } else if (character === ')' && parentheses > 0) {
+            parentheses--;
+        }
+    }
+
+    return result;
+};
+
+export const transformStyleAttributes = (document: Element): void => {
+    [document, ...document.querySelectorAll('[style]')].forEach((element) => {
+        const style = element.getAttribute('style');
+        if (!style || !/vh/i.test(style)) {
+            return;
+        }
+
+        const transformedStyle = replaceViewportHeights(style);
+        if (transformedStyle !== style) {
+            element.setAttribute('style', transformedStyle);
+        }
+    });
+};
