+	stdsql "database/sql"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/markphelps/flipt/config"
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage/sql"
+	"github.com/markphelps/flipt/storage/sql/sqlite"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+
+	_ "github.com/golang-migrate/migrate/source/file"
+)
+
+func testStore(t *testing.T) *sqlite.Store {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "flipt.db")
+	cfg := config.Config{Database: config.DatabaseConfig{
+		URL:            "file:" + path,
+		MigrationsPath: "../../config/migrations",
+	}}
+	db, err := stdsql.Open("sqlite3", path+"?_fk=true")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	migrator, err := sql.NewMigrator(cfg, logrus.New())
+	require.NoError(t, err)
+	defer migrator.Close()
+	require.NoError(t, migrator.Run(false))
+	return sqlite.NewStore(db)
+}
+
+func TestImportExport(t *testing.T) {
+	store := testStore(t)
+	ctx := context.Background()
+	in, err := os.Open("testdata/import.yml")
+	require.NoError(t, err)
+	defer in.Close()
+	require.NoError(t, NewImporter(store).Import(ctx, in))
+
+	flag, err := store.GetFlag(ctx, "checkout")
+	require.NoError(t, err)
+	require.Len(t, flag.Variants, 7)
+	attachments := make(map[string]string)
+	for _, variant := range flag.Variants {
+		attachments[variant.Key] = variant.Attachment
+	}
+	require.JSONEq(t, `{"features":[{"name":"summary","enabled":true},{"name":"recommendations","enabled":false}],"settings":{"count":3,"large":9007199254740993,"ratio":0.25,"note":null,"labels":["web","mobile",null,7,true]}}`, attachments["modern"])
+	require.Empty(t, attachments["classic"])
+	require.JSONEq(t, `[1,"two",false,null,{"deep":[0.5,"leaf"]}]`, attachments["experimental"])
+	require.Equal(t, "null", attachments["null-value"])
+	require.Equal(t, "false", attachments["false-value"])
+	require.Equal(t, "0", attachments["zero-value"])
+	require.Equal(t, `"hello"`, attachments["text-value"])
+
+	segment, err := store.GetSegment(ctx, "beta-users")
+	require.NoError(t, err)
+	require.Equal(t, flipt.MatchType_ANY_MATCH_TYPE, segment.MatchType)
+	require.Len(t, segment.Constraints, 2)
+	rules, err := store.ListRules(ctx, "checkout")
+	require.NoError(t, err)
+	require.Len(t, rules, 1)
+	require.Len(t, rules[0].Distributions, 3)
+
+	var out bytes.Buffer
+	require.NoError(t, NewExporter(store).Export(ctx, &out))
+	var doc Document
+	require.NoError(t, yaml.Unmarshal(out.Bytes(), &doc))
+	require.Len(t, doc.Flags, 1)
+	require.Len(t, doc.Segments, 1)
+	require.IsType(t, map[interface{}]interface{}{}, doc.Flags[0].Variants[0].Attachment)
+	require.IsType(t, []interface{}{}, doc.Flags[0].Variants[2].Attachment)
+	want, err := os.ReadFile("testdata/export.yml")
+	require.NoError(t, err)
+	require.Equal(t, string(want), out.String())
+}
+
+func TestImportNoAttachment(t *testing.T) {
+	store := testStore(t)
+	in, err := os.Open("testdata/import_no_attachment.yml")
+	require.NoError(t, err)
+	defer in.Close()
+	ctx := context.Background()
+	require.NoError(t, NewImporter(store).Import(ctx, in))
+	flag, err := store.GetFlag(ctx, "checkout")
+	require.NoError(t, err)
+	require.Len(t, flag.Variants, 2)
+	for _, variant := range flag.Variants {
+		require.Empty(t, variant.Attachment)
+	}
+	var out bytes.Buffer
+	require.NoError(t, NewExporter(store).Export(ctx, &out))
+	require.NotContains(t, out.String(), "attachment:")
+}
+
+func TestConvertNestedKeys(t *testing.T) {
+	value := map[interface{}]interface{}{
+		7:        []interface{}{map[interface{}]interface{}{true: nil}},
+		"nested": map[string]interface{}{"items": []interface{}{map[interface{}]interface{}{2: "two"}}},
+	}
+	got, err := json.Marshal(convert(value))
+	require.NoError(t, err)
+	require.JSONEq(t, `{"7":[{"true":null}],"nested":{"items":[{"2":"two"}]}}`, string(got))
+}
+
+func TestExportAllBatches(t *testing.T) {
+	store := testStore(t)
+	ctx := context.Background()
+	for n := 0; n < 27; n++ {
+		key := fmt.Sprintf("flag-%02d", n)
+		_, err := store.CreateFlag(ctx, &flipt.CreateFlagRequest{Key: key, Name: key})
+		require.NoError(t, err)
+		_, err = store.CreateSegment(ctx, &flipt.CreateSegmentRequest{Key: key, Name: key})
+		require.NoError(t, err)
+	}
+	var out bytes.Buffer
+	require.NoError(t, NewExporter(store).Export(ctx, &out))
+	var doc Document
+	require.NoError(t, yaml.Unmarshal(out.Bytes(), &doc))
+	require.Len(t, doc.Flags, 27)
+	require.Len(t, doc.Segments, 27)
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..86f7854
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,179 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+// Importer reads YAML configuration and creates its entities in a store.
+type Importer struct {
+	store creator
+}
+
+func NewImporter(store creator) *Importer {
+	return &Importer{store: store}
+}
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	var doc Document
+	if err := yaml.NewDecoder(r).Decode(&doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+
+	type variantID struct{ flag, variant string }
+	createdVariants := make(map[variantID]*flipt.Variant)
+
+	// Flags and variants must exist before their rules and distributions.
+	for _, f := range doc.Flags {
+		if f == nil {
+			return fmt.Errorf("importing flag: null flag")
+		}
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{
+			Key:         f.Key,
+			Name:        f.Name,
+			Description: f.Description,
+			Enabled:     f.Enabled,
+		}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+
+		for _, v := range f.Variants {
+			if v == nil {
+				return fmt.Errorf("importing variant for flag %q: null variant", f.Key)
+			}
+			var attachment string
+			if v.Attachment != nil || v.attachmentPresent {
+				// An empty YAML string is the store's representation of no attachment.
+				if value, isString := v.Attachment.(string); !isString || value != "" {
+					data, err := json.Marshal(convert(v.Attachment))
+					if err != nil {
+						return fmt.Errorf("encoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+					attachment = string(data)
+				}
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{
+				FlagKey:     f.Key,
+				Key:         v.Key,
+				Name:        v.Name,
+				Description: v.Description,
+				Attachment:  attachment,
+			})
+			if err != nil {
+				return fmt.Errorf("importing variant %q for flag %q: %w", v.Key, f.Key, err)
+			}
+			createdVariants[variantID{f.Key, v.Key}] = variant
+		}
+	}
+
+	// Segments must exist before rules that refer to them.
+	for _, s := range doc.Segments {
+		if s == nil {
+			return fmt.Errorf("importing segment: null segment")
+		}
+		matchType := flipt.MatchType_ALL_MATCH_TYPE
+		if s.MatchType != "" {
+			value, ok := flipt.MatchType_value[s.MatchType]
+			if !ok {
+				return fmt.Errorf("importing segment %q: invalid match type %q", s.Key, s.MatchType)
+			}
+			matchType = flipt.MatchType(value)
+		}
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{
+			Key:         s.Key,
+			Name:        s.Name,
+			Description: s.Description,
+			MatchType:   matchType,
+		}); err != nil {
+			return fmt.Errorf("importing segment %q: %w", s.Key, err)
+		}
+		for _, c := range s.Constraints {
+			if c == nil {
+				return fmt.Errorf("importing constraint for segment %q: null constraint", s.Key)
+			}
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{
+				SegmentKey: s.Key,
+				Type:       flipt.ComparisonType(flipt.ComparisonType_value[c.Type]),
+				Property:   c.Property,
+				Operator:   c.Operator,
+				Value:      c.Value,
+			}); err != nil {
+				return fmt.Errorf("importing constraint for segment %q: %w", s.Key, err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			if r == nil {
+				return fmt.Errorf("importing rule for flag %q: null rule", f.Key)
+			}
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{
+				FlagKey:    f.Key,
+				SegmentKey: r.SegmentKey,
+				Rank:       int32(r.Rank),
+			})
+			if err != nil {
+				return fmt.Errorf("importing rule for flag %q: %w", f.Key, err)
+			}
+			for _, d := range r.Distributions {
+				if d == nil {
+					return fmt.Errorf("importing distribution for flag %q: null distribution", f.Key)
+				}
+				variant, ok := createdVariants[variantID{f.Key, d.VariantKey}]
+				if !ok {
+					return fmt.Errorf("finding variant %q for flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{
+					FlagKey:   f.Key,
+					RuleId:    rule.Id,
+					VariantId: variant.Id,
+					Rollout:   d.Rollout,
+				}); err != nil {
+					return fmt.Errorf("importing distribution for flag %q: %w", f.Key, err)
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// convert replaces YAML's interface{} map keys with strings at every depth.
+func convert(value interface{}) interface{} {
+	switch value := value.(type) {
+	case map[interface{}]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			result[fmt.Sprint(key)] = convert(item)
+		}
+		return result
+	case map[string]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			result[key] = convert(item)
+		}
+		return result
+	case []interface{}:
+		result := make([]interface{}, len(value))
+		for index, item := range value {
+			result[index] = convert(item)
+		}
+		return result
+	default:
+		return value
+	}
+}
