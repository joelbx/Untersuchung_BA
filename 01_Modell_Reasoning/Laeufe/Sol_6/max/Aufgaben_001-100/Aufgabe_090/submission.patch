--- a/openlibrary/plugins/openlibrary/tests/test_lists.py
+++ b/openlibrary/plugins/openlibrary/tests/test_lists.py
@@ -1,3 +1,7 @@
+from types import SimpleNamespace
+
+import web
+
 from openlibrary.plugins.openlibrary import lists
 
 
@@ -11,3 +15,87 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_lists_add_post_uses_body_instead_of_query(monkeypatch):
+    saved = []
+    site = SimpleNamespace(
+        can_write=lambda key: True,
+        seq=SimpleNamespace(next_value=lambda name: 1),
+        save=lambda doc, **kwargs: saved.append(doc),
+    )
+    monkeypatch.setitem(web.ctx, 'site', site)
+    monkeypatch.setattr(lists, 'safe_seeother', lambda key: key)
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: (
+            b'name=Body+list&name=Ignored+duplicate&description=From+body'
+            b'&seeds--0--key=%2Fbooks%2FOL1M'
+            b'&seeds--1--other=invalid&seeds--2--key='
+            b'&seeds--3--key=%2Fworks%2FOL2W&seeds--4=invalid'
+        ),
+    )
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: web.storage(
+            key='/wrong',
+            name='Query list',
+            description='From query',
+            seeds=['/books/OL9M'],
+            _comment='',
+        ),
+    )
+
+    assert lists.lists_add().POST('/people/test') == '/people/test/lists/OL1L'
+    assert saved == [
+        {
+            'key': '/people/test/lists/OL1L',
+            'type': {'key': '/type/list'},
+            'name': 'Body list',
+            'description': 'From body',
+            'seeds': [{'key': '/books/OL1M'}, {'key': '/works/OL2W'}],
+        }
+    ]
+
+
+def test_list_record_from_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: web.storage(
+            {**defaults, 'name': 'Query list', 'seeds': ['OL1W']}
+        ),
+    )
+
+    assert lists.ListRecord.from_input() == lists.ListRecord(
+        name='Query list', seeds=[{'key': '/works/OL1W'}]
+    )
+
+
+def test_list_record_from_nested_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: web.storage(
+            {'seeds--0--key': '/books/OL1M', **defaults, 'name': 'Query list'}
+        ),
+    )
+
+    assert lists.ListRecord.from_input() == lists.ListRecord(
+        name='Query list', seeds=[{'key': '/books/OL1M'}]
+    )
+
+
+def test_list_record_body_fills_missing_defaults(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'name=Body+list')
+
+    def unexpected_input(**defaults):
+        raise AssertionError('web.input should not be called for a form body')
+
+    monkeypatch.setattr(web, 'input', unexpected_input)
+
+    assert lists.ListRecord.from_input() == lists.ListRecord(name='Body list')
