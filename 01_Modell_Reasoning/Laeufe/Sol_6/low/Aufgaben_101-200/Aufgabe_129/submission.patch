@@ -0,0 +1,45 @@
+/*
+Copyright 2026 The Matrix.org Foundation C.I.C.
+SPDX-License-Identifier: Apache-2.0
+*/
+
+import React from "react";
+
+import { ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import IconizedContextMenu, { IconizedContextMenuOptionList } from "./IconizedContextMenu";
+import AccessibleButton from "../elements/AccessibleButton";
+import UIStore from "../../../stores/UIStore";
+
+interface Props extends Omit<React.ComponentProps<typeof AccessibleButton>, "title" | "children" | "onClick"> {
+    title: string;
+    options: React.ReactNode[];
+}
+
+export const KebabContextMenu: React.FC<Props> = ({ title, options, disabled, className, ...props }) => {
+    const [isOpen, button, openMenu, closeMenu] = useContextMenu<HTMLButtonElement>();
+    const close = () => closeMenu();
+    const rect = isOpen && button.current?.getBoundingClientRect();
+
+    return <>
+        <ContextMenuButton
+            {...props}
+            className={className}
+            label={title}
+            isExpanded={isOpen}
+            disabled={disabled}
+            aria-disabled={!!disabled}
+            inputRef={button}
+            onClick={openMenu}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { rect && <IconizedContextMenu
+            onFinished={close}
+            right={UIStore.instance.windowWidth - rect.right - window.scrollX}
+            top={rect.bottom + window.scrollY}
+            rightAligned
+        >
+            <IconizedContextMenuOptionList red>{ options }</IconizedContextMenuOptionList>
+        </IconizedContextMenu> }
+    </>;
+};
