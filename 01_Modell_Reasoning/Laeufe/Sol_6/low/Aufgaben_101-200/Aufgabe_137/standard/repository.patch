+func TestTracingSettings(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte("tracing:\n  samplingRatio: 0.5\n  propagators: [b3, jaeger]\n"), 0600))
+	result, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, 0.5, result.Config.Tracing.SamplingRatio)
+	assert.Equal(t, []TracingPropagator{TracingPropagatorB3, TracingPropagatorJaeger}, result.Config.Tracing.Propagators)
+
+	for _, tc := range []struct {
+		config  TracingConfig
+		message string
+	}{
+		{TracingConfig{SamplingRatio: -0.1}, "sampling ratio should be a number between 0 and 1"},
+		{TracingConfig{SamplingRatio: 1.1}, "sampling ratio should be a number between 0 and 1"},
+		{TracingConfig{SamplingRatio: 1, Propagators: []TracingPropagator{"unknown"}}, "invalid propagator option: unknown"},
+	} {
+		require.EqualError(t, tc.config.validate(), tc.message)
+	}
+}
