+func TestStore_BuildManifestVersion(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		option       []containers.Option[StoreOptions]
+		artifactType string
+	}{
+		{"default 1.1", nil, MediaTypeFliptFeatures},
+		{"configured 1.0", []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)}, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			dir := t.TempDir()
+			ref, err := ParseReference("flipt://local/testrepo:latest")
+			require.NoError(t, err)
+			store, err := NewStore(zaptest.NewLogger(t), dir, tc.option...)
+			require.NoError(t, err)
+			files, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+			_, err = store.Build(ctx, files, ref)
+			require.NoError(t, err)
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+			desc, err := target.Resolve(ctx, "latest")
+			require.NoError(t, err)
+			reader, err := target.Fetch(ctx, desc)
+			require.NoError(t, err)
+			defer reader.Close()
+			var manifest v1.Manifest
+			require.NoError(t, json.NewDecoder(reader).Decode(&manifest))
+			assert.Equal(t, tc.artifactType, manifest.ArtifactType)
+		})
+	}
+}
