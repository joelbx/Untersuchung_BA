+SIZES = ('', 's', 'm', 'l')
+
+
+def _ids(cover_id):
+    cover_id = int(cover_id)
+    if not 0 <= cover_id <= 9999999999:
+        raise ValueError('cover ID must fit in ten digits')
+    return f'{cover_id:010d}'
+
+
+class Cover:
+    def __init__(self, attributes):
+        self.__dict__.update(attributes)
+
+    @staticmethod
+    def id_to_item_and_batch_id(cover_id):
+        number = _ids(cover_id)
+        return number[:4], number[4:6]
+
+    @staticmethod
+    def get_cover_url(cover_id, size='', ext='jpg', protocol='https'):
+        if size.lower() not in SIZES or protocol not in ('http', 'https'):
+            raise ValueError('invalid size or protocol')
+        number = _ids(cover_id)
+        item, batch = Cover.id_to_item_and_batch_id(cover_id)
+        prefix = f'{size.lower()}_' if size else ''
+        suffix = f'-{size.upper()}' if size else ''
+        return (f'{protocol}://archive.org/download/{prefix}covers_{item}/'
+                f'{prefix}covers_{item}_{batch}.zip/{number}{suffix}.{ext}')
+
+
+class Batch:
+    def __init__(self, item_id, batch_id, size=''):
+        self.item_id, self.batch_id, self.size = item_id, batch_id, size
+        self._norm_ids()
+        if size not in SIZES:
+            raise ValueError('invalid size')
+
+    def _norm_ids(self):
+        item, batch = int(self.item_id), int(self.batch_id)
+        if not 0 <= item <= 9999 or not 0 <= batch <= 99:
+            raise ValueError('invalid batch identifiers')
+        return f'{item:04d}', f'{batch:02d}'
+
+    @classmethod
+    def get_relpath(cls, item_id, batch_id, size='', ext='zip'):
+        item, batch = cls(item_id, batch_id, size)._norm_ids()
+        prefix = f'{size}_' if size else ''
+        name = f'{prefix}covers_{item}'
+        return os.path.join('items', name, f'{name}_{batch}.{ext}')
+
+    @classmethod
+    def get_abspath(cls, item_id, batch_id, size='', ext='zip'):
+        return os.path.join(config.data_root, cls.get_relpath(item_id, batch_id, size, ext))
+
+    @property
+    def start_id(self):
+        item, batch = self._norm_ids()
+        return int(item) * 1000000 + int(batch) * 10000
+
+    @contextlib.contextmanager
+    def lock(self):
+        path = self.get_abspath(self.item_id, self.batch_id, ext='lock')
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, 'a+b') as lockfile:
+            fcntl.flock(lockfile, fcntl.LOCK_EX)
+            try:
+                yield
+            finally:
+                fcntl.flock(lockfile, fcntl.LOCK_UN)
+
+    def process_pending(self, upload=False, finalize=False, test=False, uploader=None):
+        uploader = uploader or Uploader()
+        sizes = SIZES if not self.size else (self.size,)
+        with self.lock():
+            paths = []
+            for size in sizes:
+                path = self.get_abspath(self.item_id, self.batch_id, size)
+                if os.path.isfile(path):
+                    item, _ = self._norm_ids()
+                    prefix = f'{size}_' if size else ''
+                    itemname = f'{prefix}covers_{item}'
+                    if upload and not test:
+                        uploader.upload(itemname, [path])
+                    if finalize and not uploader.is_uploaded(itemname, os.path.basename(path)):
+                        return False
+                    paths.append(path)
+            if not paths or (finalize and len(paths) != len(sizes)):
+                return False
+            if finalize and len(paths) == len(sizes) and not test:
+                CoverDB.update_completed_batch(self.item_id, self.batch_id)
+                for path in paths:
+                    os.remove(path)
+            return True
+
+    def finalize(self, start_id=None, test=False):
+        return self.process_pending(finalize=True, test=test)
+
+
+class ZipManager:
+    def __init__(self):
+        self.zips = {}
+
+    def add_file(self, name, filepath, mtime):
+        number = _ids(name.split('-')[0].split('.')[0])
+        size = name[len(number) + 1].lower() if name.startswith(number + '-') else ''
+        item, batch = Cover.id_to_item_and_batch_id(number)
+        path = Batch.get_abspath(item, batch, size)
+        if path not in self.zips:
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            archive = zipfile.ZipFile(path, 'a', compression=zipfile.ZIP_STORED)
+            self.zips[path] = (archive, set(archive.namelist()))
+        archive, names = self.zips[path]
+        if name not in names:
+            info = zipfile.ZipInfo(name, time.localtime(mtime)[:6])
+            info.compress_type = zipfile.ZIP_STORED
+            with open(filepath, 'rb') as source:
+                archive.writestr(info, source.read())
+            names.add(name)
+        return os.path.basename(path)
+
+    def close(self):
+        for archive, _ in self.zips.values():
+            archive.close()
+        self.zips.clear()
 
