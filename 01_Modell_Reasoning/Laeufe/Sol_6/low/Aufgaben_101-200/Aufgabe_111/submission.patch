+func TestAmazonLinuxVersionsAndEOL(t *testing.T) {
+	for _, tt := range []struct {
+		release string
+		version string
+		year    int
+	}{
+		{"2018.03", "1", 2023},
+		{"1", "1", 2023},
+		{"2 (Karoo)", "2", 2024},
+		{"2022 (Amazon Linux)", "2022", 2026},
+		{"2023 (Amazon Linux)", "2023", 2029},
+		{"2025 (Amazon Linux)", "2025", 2030},
+		{"2027 (Amazon Linux)", "2027", 2032},
+		{"2029 (Amazon Linux)", "2029", 2034},
+	} {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.version {
+				t.Fatalf("version = %q, want %q", got, tt.version)
+			}
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("EOL not found")
+			}
+			want := time.Date(tt.year, 6, 30, 23, 59, 59, 0, time.UTC)
+			if !eol.StandardSupportUntil.Equal(want) {
+				t.Errorf("standard support until = %v, want %v", eol.StandardSupportUntil, want)
+			}
+			if eol.IsStandardSupportEnded(want) || eol.IsExtendedSuppportEnded(want) {
+				t.Error("support ended at deadline")
+			}
+			if !eol.IsStandardSupportEnded(want.Add(time.Second)) || !eol.IsExtendedSuppportEnded(want.Add(time.Second)) {
+				t.Error("support still active after deadline")
+			}
+		})
+	}
+	for _, release := range []string{"", "2024", "2024 (Amazon Linux)", "garbage", "2023x", "2018.3"} {
+		if got := getAmazonLinuxVersion(release); got != "unknown" {
+			t.Errorf("version for %q = %q", release, got)
+		}
+		if _, found := GetEOL(Amazon, release); found {
+			t.Errorf("unexpected EOL for %q", release)
+		}
+	}
+}
