@@ -37,6 +38,7 @@ import (
 	"golang.org/x/crypto/ssh"
 
 	"github.com/gravitational/teleport/api/constants"
+	apisshutils "github.com/gravitational/teleport/api/utils/sshutils"
 	"github.com/gravitational/teleport/lib/fixtures"
 	"github.com/gravitational/teleport/lib/httplib"
 	"github.com/gravitational/teleport/lib/multiplexer/test"
@@ -51,6 +53,31 @@ import (
 	"github.com/stretchr/testify/require"
 )
 
+func TestTeleportProxySSH(t *testing.T) {
+	for _, tc := range []struct {
+		name, preamble, wantAddr string
+	}{
+		{"client address", `{"clientAddr":"192.0.2.10:1234"}`, "192.0.2.10:1234"},
+		{"tracing only", `{"tracingContext":{"trace":"value"}}`, "pipe"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server, client := net.Pipe()
+			defer server.Close()
+			defer client.Close()
+			message := []byte(apisshutils.ProxyHelloSignature + tc.preamble + "\x00SSH-2.0-test\r\n")
+			go func() { _, _ = client.Write(message) }()
+			conn, err := detect(server, false)
+			require.NoError(t, err)
+			require.Equal(t, ProtoSSH, conn.Protocol())
+			require.Equal(t, tc.wantAddr, conn.RemoteAddr().String())
+			got := make([]byte, len(message))
+			_, err = io.ReadFull(conn, got)
+			require.NoError(t, err)
+			require.True(t, bytes.Equal(message, got))
+		})
+	}
+}
+
 func TestMain(m *testing.M) {
 	utils.InitLoggerForTests()
 	os.Exit(m.Run())
