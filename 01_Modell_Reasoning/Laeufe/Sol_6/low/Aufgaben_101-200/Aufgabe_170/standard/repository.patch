+def add_db_name(rec: dict) -> None:
+    """Add a comparable name, including available dates, to each author."""
+    for author in rec.get("authors") or []:
+        date = author.get("date")
+        if not date and ("birth_date" in author or "death_date" in author):
+            date = (
+                (author.get("birth_date") or "")
+                + "-"
+                + (author.get("death_date") or "")
+            )
+        if author.get("name"):
+            author["db_name"] = " ".join(filter(None, (author["name"], date)))
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used when comparing an imported or existing edition."""
+    full_title = rec.get("title") or rec.get("full_title") or ""
+    if rec.get("subtitle"):
+        full_title += " " + rec["subtitle"]
+    expanded = build_titles(full_title)
+    expanded["isbn"] = []
+    for field in ("isbn", "isbn_10", "isbn_13"):
+        values = rec.get(field) or []
+        expanded["isbn"].extend([values] if isinstance(values, str) else values)
+    if rec.get("publish_country") not in (None, "   ", "|||"):
+        expanded["publish_country"] = rec["publish_country"]
+    for field in (
+        "lccn",
+        "publishers",
+        "publish_date",
+        "number_of_pages",
+        "authors",
+        "contribs",
+    ):
+        if field in rec:
+            expanded[field] = rec[field]
+    add_db_name(expanded)
+    if expanded.get("contribs"):
+        add_db_name({"authors": expanded["contribs"]})
+    return expanded
+
