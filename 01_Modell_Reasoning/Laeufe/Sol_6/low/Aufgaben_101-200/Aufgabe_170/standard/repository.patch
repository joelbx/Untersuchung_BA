 from openlibrary.catalog.utils import expand_record
 from openlibrary.catalog.merge.merge_marc import (
+    add_db_name,
     build_titles,
     compare_authors,
     compare_publisher,
     editions_match,
+    expand_record as merge_expand_record,
+    threshold_match,
 )
 
 
+def test_raw_record_expansion_and_matching():
+    incoming = {
+        "title": "The Example Book",
+        "subtitle": "A Study",
+        "isbn_10": ["1234567890"],
+        "isbn_13": ["9781234567890"],
+        "publish_country": "|||",
+        "publish_date": "2000",
+        "authors": [{"name": "Jane Doe", "birth_date": "1940"}],
+    }
+    existing = {
+        "title": "The Example Book",
+        "subtitle": "A Study",
+        "isbn": ["1234567890"],
+        "publish_date": "2000",
+        "authors": [{"name": "Jane Doe", "date": "1940-"}],
+    }
+    expanded = merge_expand_record(incoming)
+    assert expanded["full_title"] == "The Example Book A Study"
+    assert expanded["normalized_title"] in expanded["titles"]
+    assert expanded["short_title"] == expanded["normalized_title"][:25]
+    assert expanded["isbn"] == ["1234567890", "9781234567890"]
+    assert "publish_country" not in expanded
+    assert expanded["authors"][0]["db_name"] == "Jane Doe 1940-"
+    assert editions_match(incoming, existing, 875)
+    assert threshold_match(incoming, existing, 875)
+
+
+def test_missing_authors_and_contributor_match():
+    for authors in (None, []):
+        rec = {"authors": authors}
+        assert add_db_name(rec) is None
+    incoming = {"title": "An Example of Matching", "authors": [{"name": "Jane Doe"}]}
+    existing = {"title": "An Example of Matching", "contribs": [{"name": "Jane Doe"}]}
+    assert compare_authors(
+        merge_expand_record(incoming), merge_expand_record(existing)
+    ) == ("authors", "exact match", 125)
+    assert threshold_match(incoming, existing, 515)
+
+
+def test_title_match_without_isbn_from_raw_records():
+    first = {
+        "title": "Eli Whitney and the birth of American technology",
+        "publish_date": "1956",
+    }
+    second = {
+        "title": "Eli Whitney and the birth of American technology.",
+        "publish_date": "1956",
+    }
+    assert editions_match(first, second, 875)
+
