index 0000000..ae98003
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,66 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	old := conf.Server.Backup
+	defer func() { conf.Server.Backup = old }()
+	dir := t.TempDir()
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 1
+	source, err := sql.Open(Driver, filepath.Join(dir, "live.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer source.Close()
+	if _, err := source.Exec("CREATE TABLE sample (value TEXT); INSERT INTO sample VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	database := &db{readDB: source, writeDB: source}
+	ctx := context.Background()
+	first, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := source.Exec("UPDATE sample SET value = 'after'"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second {
+		t.Fatal("backup filenames collided")
+	}
+	if err := database.Restore(ctx, first); err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := source.QueryRow("SELECT value FROM sample").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "before" {
+		t.Fatalf("restored value = %q", value)
+	}
+	count, err := database.Prune(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 {
+		t.Fatalf("pruned %d files", count)
+	}
+	if _, err := os.Stat(second); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(first); !os.IsNotExist(err) {
+		t.Fatalf("older backup remains: %v", err)
+	}
+}
