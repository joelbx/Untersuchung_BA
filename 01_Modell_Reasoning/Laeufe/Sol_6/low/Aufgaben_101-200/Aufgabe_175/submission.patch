+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func confirm(cmd *cobra.Command, prompt string) bool {
+	fmt.Fprint(cmd.OutOrStdout(), prompt+" [y/N]: ")
+	reader := bufio.NewReader(cmd.InOrStdin())
+	answer, _ := reader.ReadString('\n')
+	return strings.EqualFold(strings.TrimSpace(answer), "y") || strings.EqualFold(strings.TrimSpace(answer), "yes")
+}
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	create := &cobra.Command{Use: "create", RunE: func(cmd *cobra.Command, args []string) error {
+		path, err := db.Db().Backup(cmd.Context())
+		if err != nil {
+			return err
+		}
+		fmt.Fprintln(cmd.OutOrStdout(), path)
+		return nil
+	}}
+	pruneCmd := &cobra.Command{Use: "prune", RunE: func(cmd *cobra.Command, args []string) error {
+		force, _ := cmd.Flags().GetBool("force")
+		if conf.Server.Backup.Count == 0 && !force && !confirm(cmd, "Delete all backups?") {
+			return fmt.Errorf("prune cancelled")
+		}
+		count, err := db.Db().Prune(cmd.Context())
+		if err != nil {
+			return err
+		}
+		fmt.Fprintf(cmd.OutOrStdout(), "Pruned %d backups\n", count)
+		return nil
+	}}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation")
+	restore := &cobra.Command{Use: "restore", RunE: func(cmd *cobra.Command, args []string) error {
+		path, _ := cmd.Flags().GetString("backup-file")
+		force, _ := cmd.Flags().GetBool("force")
+		if !force && !confirm(cmd, "Restore database from "+path+"?") {
+			return fmt.Errorf("restore cancelled")
+		}
+		if err := db.Db().Restore(cmd.Context(), path); err != nil {
+			return err
+		}
+		fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+		return nil
+	}}
+	restore.Flags().String("backup-file", "", "backup database file")
+	_ = restore.MarkFlagRequired("backup-file")
+	restore.Flags().Bool("force", false, "skip confirmation")
+	backupCmd.AddCommand(create, pruneCmd, restore)
+	rootCmd.AddCommand(backupCmd)
+}
