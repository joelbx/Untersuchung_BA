diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..3f99773
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,150 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupTimeFormat = "20060102T150405.000000000"
+
+func copyDatabase(ctx context.Context, destination, source *sql.DB) error {
+	src, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	dst, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer dst.Close()
+	return dst.Raw(func(d any) error {
+		return src.Raw(func(s any) error {
+			backup, err := d.(*sqlite3.SQLiteConn).Backup("main", s.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(100)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					break
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			return backup.Finish()
+		})
+	})
+}
+
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", fmt.Errorf("backup.path is empty")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		return "", err
+	}
+	path := filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format(backupTimeFormat)+".db")
+	target, err := sql.Open(Driver, path)
+	if err != nil {
+		return "", err
+	}
+	err = copyDatabase(ctx, target, d.writeDB)
+	closeErr := target.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		_ = os.Remove(path)
+		return "", err
+	}
+	return path, nil
+}
+
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return fmt.Errorf("backup file is required")
+	}
+	backupPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	livePath, err := filepath.Abs(conf.Server.DbPath)
+	if err == nil && backupPath == livePath {
+		return fmt.Errorf("backup file is the live database")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup is not a regular file")
+	}
+	source, err := sql.Open(Driver, "file:"+path+"?mode=ro")
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var check string
+	if err := source.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&check); err != nil {
+		return err
+	}
+	if check != "ok" {
+		return fmt.Errorf("backup failed integrity check: %s", check)
+	}
+	return copyDatabase(ctx, d.writeDB, source)
+}
+
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, fmt.Errorf("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, fmt.Errorf("backup.count cannot be negative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, ".db") {
+			continue
+		}
+		if _, err := time.Parse(backupTimeFormat, strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), ".db")); err == nil {
+			names = append(names, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
diff --git a/db/backup_test.go b/db/backup_test.go
