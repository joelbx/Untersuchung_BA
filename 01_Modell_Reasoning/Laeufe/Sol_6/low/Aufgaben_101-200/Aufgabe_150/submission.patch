+])
+def test_manifest_metadata_presence(provided, expected):
+    metadata = {'namespace': 'namespace', 'name': 'collection', 'version': '1.0.0',
+                'readme': 'README.md', 'authors': ['Author'], **provided}
+    normalized = _normalize_galaxy_yml_manifest(metadata, b'galaxy.yml')
