+		err := cfg.CheckAndSetDefaults()
+		if (err == nil) != tc.valid {
+			t.Errorf("billing mode %q: unexpected error %v", tc.input, err)
+		}
+		if tc.valid && cfg.BillingMode != tc.want {
+			t.Errorf("billing mode %q: got %q, want %q", tc.input, cfg.BillingMode, tc.want)
+		}
+	}
