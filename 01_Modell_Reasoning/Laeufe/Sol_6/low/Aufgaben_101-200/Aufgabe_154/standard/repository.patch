index 0bba41b..111a4cc 100644
--- a/test/units/plugins/connection/test_ssh.py
+++ b/test/units/plugins/connection/test_ssh.py
@@ -34,6 +34,21 @@ from ansible.plugins.connection import ssh
 from ansible.plugins.loader import connection_loader, become_loader
 
 
+def test_replace_stderr_clixml_embedded_and_multiline():
+    block = (b'#< CLIXML\r\n<Objs Version="1">\r\n'
+             b'<S S="Error">failure</S>\r\n</Objs>')
+    assert ssh._replace_stderr_clixml(b'before\r\n' + block + b' tail\r\nafter') == b'before\r\nfailure tail\r\nafter'
+
+
+def test_replace_stderr_clixml_cp437_and_invalid():
+    block = b'#< CLIXML\r\n<Objs Version="1"><S S="Error">caf\x82</S></Objs>'
+    assert ssh._replace_stderr_clixml(block) == 'café'.encode()
+    incomplete = b'#< CLIXML\r\n<Objs Version="1"><S S="Error">oops</S>'
+    assert ssh._replace_stderr_clixml(incomplete) == incomplete
+    malformed = b'#< CLIXML\r\n<Objs Version="1"><S>oops</Objs>'
+    assert ssh._replace_stderr_clixml(malformed) == malformed
+
