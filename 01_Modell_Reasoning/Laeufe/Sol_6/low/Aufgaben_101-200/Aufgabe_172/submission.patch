diff --git a/models/portstat_test.go b/models/portstat_test.go
new file mode 100644
index 0000000..41e66ca
--- /dev/null
+++ b/models/portstat_test.go
@@ -0,0 +1,56 @@
+package models
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestNewPortStat(t *testing.T) {
+	for _, tc := range []struct {
+		input, address, port string
+		invalid              bool
+	}{
+		{input: ""},
+		{input: "127.0.0.1:22", address: "127.0.0.1", port: "22"},
+		{input: "*:22", address: "*", port: "22"},
+		{input: "[::1]:22", address: "[::1]", port: "22"},
+		{input: "missing-port", invalid: true},
+		{input: "127.0.0.1:", invalid: true},
+		{input: ":22", invalid: true},
+		{input: "::1:22", invalid: true},
+	} {
+		got, err := NewPortStat(tc.input)
+		if (err != nil) != tc.invalid {
+			t.Errorf("%q: unexpected error %v", tc.input, err)
+			continue
+		}
+		if !tc.invalid && (got.BindAddress != tc.address || got.Port != tc.port) {
+			t.Errorf("%q: got %+v", tc.input, got)
+		}
+	}
+}
+
+func TestLegacyListenPortsJSON(t *testing.T) {
+	var p AffectedProcess
+	if err := json.Unmarshal([]byte(`{"listenPorts":["127.0.0.1:22"]}`), &p); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(p.ListenPorts, []string{"127.0.0.1:22"}) {
+		t.Fatalf("ports: %v", p.ListenPorts)
+	}
+	if p.ListenPortStats != nil {
+		t.Fatalf("unexpected stats: %v", p.ListenPortStats)
+	}
+}
+
+func TestHasReachablePort(t *testing.T) {
+	p := Package{AffectedProcs: []AffectedProcess{{ListenPortStats: []PortStat{{BindAddress: "*", Port: "22"}}}}}
+	if p.HasReachablePort() {
+		t.Fatal("unreachable port reported reachable")
+	}
+	p.AffectedProcs[0].ListenPortStats[0].PortReachableTo = []string{"127.0.0.1"}
+	if !p.HasReachablePort() {
+		t.Fatal("reachable port missed")
+	}
+}
