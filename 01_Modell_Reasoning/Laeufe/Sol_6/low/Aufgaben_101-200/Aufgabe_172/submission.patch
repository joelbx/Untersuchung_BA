+// NewPortStat parses a listening address and port.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+	host, port, err := net.SplitHostPort(ipPort)
+	if err != nil || host == "" || port == "" || strings.Contains(host, ":") && !strings.HasPrefix(ipPort, "[") {
+		return stat, fmt.Errorf("invalid listening port %q", ipPort)
+	}
+	if strings.HasPrefix(ipPort, "[") {
+		host = "[" + host + "]"
+	}
+	stat.BindAddress, stat.Port = host, port
+	return stat, nil
