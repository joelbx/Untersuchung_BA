diff --git a/test/units/modules/network/nxos/test_nxos_vrf_af.py b/test/units/modules/network/nxos/test_nxos_vrf_af.py
index c26f480b..3097d954 100644
--- a/test/units/modules/network/nxos/test_nxos_vrf_af.py
+++ b/test/units/modules/network/nxos/test_nxos_vrf_af.py
@@ -62,3 +62,42 @@ class TestNxosVrfafModule(TestNxosModule):
         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_mixed_and_idempotent(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 1:1\n'
+                                        '    route-target export 2:2\n'
+                                        '  address-family ipv6 unicast\n'
+                                        '    route-target import 3:3\n'
+                                        'vrf context other\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target export 3:3\n')
+        args = dict(vrf='ntc', afi='ipv4', route_targets=[
+            dict(rt='1:1', direction='import'),
+            dict(rt='2:2', direction='export', state='absent'),
+            dict(rt='3:3')])
+        set_module_args(args)
+        result = self.execute_module(changed=True)
+        self.assertEqual(result['commands'], [
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target export 2:2', 'route-target import 3:3',
+            'route-target export 3:3'])
+
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 1:1\n'
+                                        '    route-target import 3:3\n'
+                                        '    route-target export 3:3\n')
+        set_module_args(args)
+        self.assertEqual(self.execute_module(changed=False)['commands'], [])
+
+    def test_route_targets_absent_af_ignores_entries(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv6 unicast\n'
+                                        '    route-target import 1:1\n')
+        set_module_args(dict(vrf='ntc', afi='ipv6', state='absent',
+                             route_targets=[dict(rt='2:2')],
+                             route_target_both_auto_evpn=True))
+        self.assertEqual(self.execute_module(changed=True)['commands'],
+                         ['vrf context ntc', 'no address-family ipv6 unicast'])
