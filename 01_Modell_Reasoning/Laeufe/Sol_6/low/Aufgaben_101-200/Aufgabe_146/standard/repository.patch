@@ -410,6 +411,33 @@ class LinuxHardware(Hardware):
 
         return dmi_facts
 
+    def get_sysinfo_facts(self):
+        """Read IBM Z hardware identity from /proc/sysinfo when available."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer:': 'system_vendor',
+            'Type:': 'product_name',
+            'Sequence Code:': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            for prefix, key in fields.items():
+                if line.startswith(prefix):
+                    value = line[len(prefix):].strip()
+                    if key == 'product_serial':
+                        value = value.lstrip('0') or '0'
+                    facts[key] = value
+                    break
+        return facts
+
