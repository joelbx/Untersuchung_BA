+
+
+def test_reply_is_idle_until_accepted(mocker):
+    reply = mocker.Mock()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('A & "B" <C>')])
+
+    assert reply.mock_calls == []
+    assert wrapper.html() == '<p>A &amp; &quot;B&quot; &lt;C&gt;</p>'
+    wrapper.accept_certificate()
+    reply.ignoreSslErrors.assert_called_once_with()
