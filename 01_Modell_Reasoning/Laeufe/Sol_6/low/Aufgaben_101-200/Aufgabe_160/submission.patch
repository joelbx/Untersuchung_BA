+func TestSSHHeartbeatPeerAddress(t *testing.T) {
+	for _, tt := range []struct {
+		addr, peer, want string
+	}{
+		{"[::]:3022", "192.0.2.10:50000", "192.0.2.10:3022"},
+		{"0.0.0.0:3022", "[2001:db8::1]:50000", "[2001:db8::1]:3022"},
+		{"127.0.0.1:3022", "192.0.2.10:50000", "192.0.2.10:3022"},
+		{"node.example:3022", "192.0.2.10:50000", "node.example:3022"},
+		{"[::]:3022", "", "[::]:3022"},
+	} {
+		t.Run(tt.addr+tt.peer, func(t *testing.T) {
+			auth := &fakeAuth{}
+			controller := NewController(auth)
+			defer controller.Close()
+			upstream, downstream := client.InventoryControlStreamPipe(client.ICSPipePeerAddr(tt.peer))
+			defer downstream.Close()
+			require.Equal(t, tt.peer, upstream.PeerAddr())
+			handle := newUpstreamHandle(upstream, proto.UpstreamInventoryHello{ServerID: "node", Services: []types.SystemRole{types.RoleNode}})
+			server := &types.ServerV2{Metadata: types.Metadata{Name: "node"}}
+			server.SetAddr(tt.addr)
+			require.NoError(t, controller.handleSSHServerHB(handle, server))
+			require.Equal(t, tt.want, auth.lastAddr)
+		})
+	}
+}
