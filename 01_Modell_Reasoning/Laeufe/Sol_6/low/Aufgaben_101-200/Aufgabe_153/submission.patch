diff --git a/applications/drive/src/app/zustand/share/shareIsolation.test.ts b/applications/drive/src/app/zustand/share/shareIsolation.test.ts
new file mode 100644
index 0000000..c561439
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/shareIsolation.test.ts
@@ -0,0 +1,33 @@
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+describe('share member data isolation', () => {
+    it('keeps members for each share independent and replaces only the selected share', () => {
+        const first = [{ email: 'first@example.com' }] as ShareMember[];
+        const second = [{ email: 'second@example.com' }] as ShareMember[];
+        const store = useMembersStore.getState();
+        store.setMembers('first', first);
+        store.setMembers('second', second);
+        expect(store.getMembers('first')).toEqual(first);
+        store.setMembers('first', []);
+        expect(store.getMembers('first')).toEqual([]);
+        expect(store.getMembers('second')).toEqual(second);
+        expect(store.getMembers('missing')).toEqual([]);
+    });
+
+    it('keeps internal and external invitations scoped to each share', () => {
+        const internal = [{ inviteeEmail: 'first@example.com' }] as ShareInvitation[];
+        const external = [{ inviteeEmail: 'outside@example.com' }] as ShareExternalInvitation[];
+        const other = [{ inviteeEmail: 'second@example.com' }] as ShareInvitation[];
+        const store = useInvitationsStore.getState();
+        store.addMultipleInvitations('first', internal, external);
+        store.setInvitations('second', other);
+        store.removeInvitations('first', []);
+        expect(store.getInvitations('first')).toEqual([]);
+        expect(store.getExternalInvitations('first')).toEqual(external);
+        expect(store.getInvitations('second')).toEqual(other);
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+    });
+});
