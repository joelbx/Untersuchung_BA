+    @patch.object(DataLoader, '_get_file_contents')
+    def test_file_cache_modes(self, mock_contents):
+        mock_contents.return_value = (b'foo: bar', False)
+        self.assertEqual(self._loader.load_from_file('vault.yml', cache='none'), {'foo': 'bar'})
+        self.assertEqual(self._loader._FILE_CACHE, {})
+
+        self.assertEqual(self._loader.load_from_file('vault.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(len(self._loader._FILE_CACHE), 1)
+        self.assertEqual(self._loader.load_from_file('vault.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(mock_contents.call_count, 2)
+
+    @patch.object(DataLoader, '_get_file_contents')
+    def test_vaulted_cache_skips_plain_files(self, mock_contents):
+        mock_contents.return_value = (b'foo: bar', True)
+        self.assertEqual(self._loader.load_from_file('plain.yml', cache='vaulted'), {'foo': 'bar'})
+        self.assertEqual(self._loader._FILE_CACHE, {})
