new file mode 100644
index 0000000..3e851c5
--- /dev/null
+++ b/oval/redhat_fixstate_test.go
@@ -0,0 +1,52 @@
+//go:build !scanner
+
+package oval
+
+import (
+	"testing"
+
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/models"
+	ovalmodels "github.com/vulsio/goval-dictionary/models"
+)
+
+func TestRedHatAdvisoryPrefixes(t *testing.T) {
+	for _, tc := range []struct {
+		family, title string
+		valid         bool
+	}{
+		{constant.RedHat, "RHSA-2024:1: Security Update", true},
+		{constant.CentOS, "RHBA-2024:1: Bug Fix", true},
+		{constant.Oracle, "ELSA-2024-1: Security Update", true},
+		{constant.Amazon, "ALAS2-2024-1: Security Update", true},
+		{constant.Fedora, "FEDORA-2024-1", true},
+		{constant.RedHat, "CVE-2024-1", false},
+		{constant.Oracle, "RHSA-2024:1", false},
+		{constant.RedHat, "", false},
+	} {
+		o := RedHatBase{Base: Base{family: tc.family}}
+		got := o.convertToDistroAdvisory(&ovalmodels.Definition{Title: tc.title})
+		if (got != nil) != tc.valid {
+			t.Errorf("%s %q: advisory %v", tc.family, tc.title, got)
+		}
+	}
+}
+
+func TestRedHatUnfixedResolution(t *testing.T) {
+	for _, tc := range []struct {
+		state    string
+		affected bool
+	}{
+		{"", true}, {"Will not fix", false}, {"Under investigation", false},
+		{"Fix deferred", true}, {"Affected", true}, {"Out of support scope", true},
+	} {
+		def := ovalmodels.Definition{AffectedPacks: []ovalmodels.Package{{Name: "pkg", NotFixedYet: true}}}
+		if tc.state != "" {
+			def.Advisory.AffectedResolution = []ovalmodels.Resolution{{State: tc.state, Components: []ovalmodels.Component{{Component: "pkg"}}}}
+		}
+		affected, unfixed, state, _, err := isOvalDefAffected(def, request{packName: "pkg"}, constant.RedHat, "8", models.Kernel{}, nil)
+		if err != nil || affected != tc.affected || !unfixed || state != tc.state {
+			t.Errorf("%q: affected=%v unfixed=%v state=%q err=%v", tc.state, affected, unfixed, state, err)
+		}
+	}
+}
