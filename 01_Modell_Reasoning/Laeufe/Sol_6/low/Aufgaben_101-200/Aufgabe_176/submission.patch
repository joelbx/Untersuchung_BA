--- a/tests/unit/utils/test_urlutils.py
+++ b/tests/unit/utils/test_urlutils.py
@@ -618,6 +618,45 @@ class TestIncDecNumber:
 
     """Tests for urlutils.incdec_number()."""
 
+    @pytest.mark.parametrize('source, expected, segments', [
+        ('http://example.com/%3A5', 'http://example.com/%3A6', {'path'}),
+        ('http://example.com/%3A', None, {'path'}),
+        ('http://example.com/a2%3A5', 'http://example.com/a3%3A5', {'path'}),
+        ('http://example.com/?x=%3A5', 'http://example.com/?x=%3A6', {'query'}),
+        ('http://example.com/#%3A5', 'http://example.com/#%3A6', {'anchor'}),
+        ('http://ex4mple.com:80/%3A5', 'http://ex4mple.com:80/%3A6',
+         {'host', 'path'}),
+        ('http://example.com:80/', None, {'port'}),
+    ])
+    def test_encoded_components(self, source, expected, segments):
+        """Skip escape digits and retain encoding in every component."""
+        if expected is None:
+            with pytest.raises(urlutils.IncDecError):
+                urlutils.incdec_number(QUrl(source), 'increment',
+                                       segments=segments)
+        else:
+            result = urlutils.incdec_number(QUrl(source), 'increment',
+                                            segments=segments)
+            assert result.toString(QUrl.FullyEncoded) == expected
+
+    def test_first_match_and_default_path(self):
+        url = QUrl('http://ex4mple.com/a1b2?x=3#4')
+        assert urlutils.incdec_number(url, 'increment').path() == '/a2b2'
+        result = urlutils.incdec_number(
+            url, 'increment', segments={'host', 'path', 'query', 'anchor'})
+        assert result.toString() == 'http://ex4mple.com/a2b2?x=3#4'
+
+    @pytest.mark.parametrize('count', [0, -1, 1.5, True])
+    def test_invalid_count(self, count):
+        with pytest.raises(ValueError):
+            urlutils.incdec_number(QUrl('http://example.com/2'),
+                                   'increment', count)
+
+    def test_decrement_too_far(self):
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(QUrl('http://example.com/1'),
+                                   'decrement', 2)
+
     @pytest.mark.parametrize('incdec', ['increment', 'decrement'])
