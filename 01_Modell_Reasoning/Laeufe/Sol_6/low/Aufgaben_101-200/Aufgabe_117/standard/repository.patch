     assert args == [sys.argv[0]]
 
 
+@pytest.mark.parametrize('locale, packs, expected', [
+    ('es_MX', ['es-419'], 'es-419'),
+    ('es', ['es-419'], 'es-419'),
+    ('pt_BR', ['pt-BR'], None),
+    ('pt_PT', ['pt-BR'], 'en-US'),
+    ('zh_CN', ['zh-CN'], None),
+    ('zh_HK', ['zh-TW'], 'zh-TW'),
+    ('zh_MO', ['zh-TW'], 'zh-TW'),
+    ('en_LR', ['en-US'], 'en-US'),
+    ('en_AU', ['en-GB'], 'en-GB'),
+    ('fr_CA', ['fr'], 'fr'),
+    ('fr_CA', [], 'en-US'),
+])
+def test_locale_override(monkeypatch, config_stub, tmp_path, locale, packs, expected):
+    config_stub.val.qt.workarounds.locale = True
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    monkeypatch.setattr(qtargs, '_get_locale_pak_path',
+                        lambda directory, name: tmp_path / (name + '.pak'))
+    for pack in packs:
+        (tmp_path / (pack + '.pak')).touch()
+    versions = version.WebEngineVersions.from_pyqt('5.15.3')
+    assert qtargs._get_lang_override(versions, locale) == expected
+
+
+def test_locale_override_gates(monkeypatch, config_stub, tmp_path):
+    config_stub.val.qt.workarounds.locale = True
+    monkeypatch.setattr(qtargs, '_get_locale_pak_path',
+                        lambda directory, name: tmp_path / (name + '.pak'))
+    versions = version.WebEngineVersions.from_pyqt('5.15.3')
+    monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+    assert qtargs._get_lang_override(versions, 'es-MX') is None
+    monkeypatch.setattr(qtargs.utils, 'is_linux', True)
+    assert qtargs._get_lang_override(
+        version.WebEngineVersions.from_pyqt('5.15.2'), 'es-MX') is None
+    config_stub.val.qt.workarounds.locale = False
+    assert qtargs._get_lang_override(versions, 'es-MX') is None
+
+
+def test_locale_override_argument(monkeypatch, config_stub, version_patcher, parser):
+    version_patcher('5.15.3')
+    config_stub.val.qt.workarounds.locale = True
+    monkeypatch.setattr(qtargs, '_get_lang_override',
+                        lambda versions, locale: 'es-419')
+    assert '--lang=es-419' in qtargs.qt_args(parser.parse_args([]))
+
