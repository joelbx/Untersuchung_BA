diff --git a/models/image_digest_test.go b/models/image_digest_test.go
new file mode 100644
index 0000000..5a10698
--- /dev/null
+++ b/models/image_digest_test.go
@@ -0,0 +1,28 @@
+package models
+
+import (
+	"testing"
+	"time"
+)
+
+func TestImageReportNames(t *testing.T) {
+	for _, tt := range []struct {
+		image Image
+		full  string
+	}{
+		{Image{Name: "app", Tag: "v1"}, "app:v1"},
+		{Image{Name: "app", Digest: "sha256:abc"}, "app@sha256:abc"},
+	} {
+		r := ScanResult{ServerName: "server", Image: tt.image, ScannedAt: time.Date(2020, 1, 2, 3, 4, 5, 0, time.UTC)}
+		want := tt.full + "@server"
+		if got := r.ReportFileName(); got != want {
+			t.Errorf("ReportFileName() = %q, want %q", got, want)
+		}
+		if got := r.ReportKeyName(); got != "2020-01-02T03:04:05Z/"+want {
+			t.Errorf("ReportKeyName() = %q", got)
+		}
+		if got := r.FormatServerName(); got != want {
+			t.Errorf("FormatServerName() = %q, want %q", got, want)
+		}
+	}
+}
