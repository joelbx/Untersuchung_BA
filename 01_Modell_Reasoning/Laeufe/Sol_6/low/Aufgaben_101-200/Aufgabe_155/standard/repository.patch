diff --git a/config/image_digest_test.go b/config/image_digest_test.go
new file mode 100644
index 0000000..33f744c
--- /dev/null
+++ b/config/image_digest_test.go
@@ -0,0 +1,33 @@
+package config
+
+import "testing"
+
+func TestImageReference(t *testing.T) {
+	tests := []struct {
+		name  string
+		image Image
+		full  string
+		err   string
+	}{
+		{"tag", Image{Name: "repo/app", Tag: "v1"}, "repo/app:v1", ""},
+		{"digest", Image{Name: "repo/app", Digest: "sha256:abc"}, "repo/app@sha256:abc", ""},
+		{"no name", Image{Tag: "v1"}, "", "Invalid arguments : no image name"},
+		{"no identifier", Image{Name: "repo/app"}, "", "Invalid arguments : no image tag and digest"},
+		{"both", Image{Name: "repo/app", Tag: "v1", Digest: "sha256:abc"}, "", "Invalid arguments : you can either set image tag or digest"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := IsValidImage(tt.image)
+			if tt.err == "" {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+				if got := tt.image.GetFullName(); got != tt.full {
+					t.Fatalf("full name = %q, want %q", got, tt.full)
+				}
+			} else if err == nil || err.Error() != tt.err {
+				t.Fatalf("error = %v, want %q", err, tt.err)
+			}
+		})
+	}
+}
