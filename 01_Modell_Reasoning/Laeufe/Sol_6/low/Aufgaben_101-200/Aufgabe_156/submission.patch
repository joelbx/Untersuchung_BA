+def _sanitize_container(value, no_log_strings, keys=False, ignore_keys=frozenset()):
+    needles = [to_native(s, errors='surrogate_or_strict') for s in no_log_strings]
+    result = [None]
+    pending = [(value, result, 0, False)]
+
+    while pending:
+        item, parent, index, finish = pending.pop()
+        if finish:
+            original, children = item
+            if isinstance(original, Mapping):
+                copied = type(original)((key, child[0]) for key, child in children)
+            else:
+                copied = type(original)(child[0] for child in children)
+            parent[index] = copied
+            continue
+
+        if isinstance(item, Mapping):
+            children = []
+            pending.append(((item, children), parent, index, True))
+            for key, element in item.items():
+                if keys and isinstance(key, (text_type, binary_type)) and key not in ignore_keys:
+                    native_key = to_native(key, errors='surrogate_or_strict')
+                    if native_key.startswith('_ansible'):
+                        pass
+                    elif native_key in needles:
+                        key = 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+                    else:
+                        for needle in needles:
+                            native_key = native_key.replace(needle, '********')
+                        key = native_key if isinstance(key, text_type) else to_bytes(native_key, errors='surrogate_or_strict')
+                slot = [None]
+                children.append((key, slot))
+                pending.append((element, slot, 0, False))
+        elif isinstance(item, (Sequence, Set)) and not isinstance(item, (text_type, binary_type)):
+            children = []
+            pending.append(((item, children), parent, index, True))
+            for element in item:
+                slot = [None]
+                children.append(slot)
+                pending.append((element, slot, 0, False))
+        elif not keys and isinstance(item, (text_type, binary_type)):
+            native_value = to_native(item, errors='surrogate_or_strict')
+            for needle in needles:
+                native_value = native_value.replace(needle, '********')
+            parent[index] = native_value if isinstance(item, text_type) else to_bytes(native_value, errors='surrogate_or_strict')
+        else:
+            parent[index] = item
+    return result[0]
 
 
