+func TestSplitFileNameSourceFormats(t *testing.T) {
+	for _, tc := range []struct {
+		file, name, version, release, arch string
+		valid                              bool
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "src", true},
+		{"package-0--src.rpm", "package", "0", "", "src", true},
+		{"package-0-1.src.rpm", "package", "0", "1", "src", true},
+		{"-0-1.src.rpm", "", "", "", "", false},
+		{"package--1.src.rpm", "", "", "", "", false},
+		{"package-0-1.rpm", "", "", "", "", false},
+	} {
+		name, version, release, _, arch, err := splitFileName(tc.file)
+		if (err == nil) != tc.valid || (tc.valid && (name != tc.name || version != tc.version || release != tc.release || arch != tc.arch)) {
+			t.Errorf("splitFileName(%q) = %q, %q, %q, %q, %v", tc.file, name, version, release, arch, err)
+		}
+	}
+}
+
+func TestParseInstalledPackagesEmptyRelease(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2"}, log: logging.NewIODiscardLogger()}}
+	bins, srcs, err := o.parseInstalledPackages("package 0 0  x86_64 package-0--src.rpm\n")
+	if err != nil || bins["package"].Version != "0" || bins["package"].Release != "" || bins["package"].Arch != "x86_64" || srcs["package"].Version != "0" {
+		t.Fatalf("unexpected packages: bins=%v srcs=%v err=%v", bins, srcs, err)
+	}
+}
