+func TestImportNestedMetadataAndJSONHeader(t *testing.T) {
+	tests := []struct {
+		name string
+		enc  Encoding
+		data string
+	}{
+		{"yaml", EncodingYAML, "namespace:\n  key: team\n  name: Team\n  description: Team flags\nflags:\n  - key: feature\n    metadata:\n      nested:\n        items:\n          - key: value\n    variants:\n      - key: option\n        attachment:\n          nested:\n            items: [one, two]\n"},
+		{"json", EncodingJSON, `{"namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","metadata":{"nested":{"items":[{"key":"value"}]}},"variants":[{"key":"option","attachment":{"nested":{"items":["one","two"]}}}]}]}`},
+		{"json header", EncodingJSON, "# export header\n" + `{"namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","metadata":{"nested":{"items":[{"key":"value"}]}},"variants":[{"key":"option","attachment":{"nested":{"items":["one","two"]}}}]}]}`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "missing")}
+			require.NoError(t, NewImporter(creator).Import(context.Background(), tt.enc, strings.NewReader(tt.data), false))
+			require.Equal(t, []*flipt.CreateNamespaceRequest{{Key: "team", Name: "Team", Description: "Team flags"}}, creator.createNSReqs)
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{"nested": map[string]any{"items": []any{map[string]any{"key": "value"}}}}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":{"items":["one","two"]}}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
 var (
 	extensions        = []Encoding{EncodingYML, EncodingJSON}
 	skipExistingFalse = false
