+func TestFliptAcceptServerVersionUnaryInterceptor(t *testing.T) {
+	tests := []struct {
+		name   string
+		header string
+		want   string
+	}{
+		{"missing", "", "1.0.0"},
+		{"prefixed", "v2.3.4", "2.3.4"},
+		{"plain", "2.3.4", "2.3.4"},
+		{"invalid", "not-a-version", "1.0.0"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tt.header != "" {
+				ctx = metadata.NewIncomingContext(ctx, metadata.Pairs(fliptAcceptServerVersionHeader, tt.header))
+			}
+			called := false
+			_, err := FliptAcceptServerVersionUnaryInterceptor(zaptest.NewLogger(t))(ctx, nil, nil, func(ctx context.Context, _ interface{}) (interface{}, error) {
+				called = true
+				assert.Equal(t, semver.MustParse(tt.want), FliptAcceptServerVersionFromContext(ctx))
+				return nil, nil
+			})
+			require.NoError(t, err)
+			assert.True(t, called)
+		})
+	}
+}
+
+func TestWithFliptAcceptServerVersion(t *testing.T) {
+	version := semver.MustParse("3.2.1")
+	assert.Equal(t, version, FliptAcceptServerVersionFromContext(WithFliptAcceptServerVersion(context.Background(), version)))
+}
