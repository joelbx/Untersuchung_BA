diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..0fa19c3 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -26,6 +26,45 @@ class TestIptables(ModuleTestCase):
         self.mock_get_iptables_version.start()
         self.addCleanup(self.mock_get_iptables_version.stop)  # ensure that the patching is 'undone'
 
+    def test_match_set_rule(self):
+        for matches in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT', 'protocol': 'tcp', 'destination_port': '22',
+                'match': matches, 'match_set': 'admin_hosts',
+                'match_set_flags': 'src', 'jump': 'ACCEPT',
+                'comment': 'SSH from admins',
+            })
+            with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+            command = run_command.call_args_list[0][0][0]
+            self.assertEqual(command.count('set'), 1)
+            self.assertEqual(command[command.index('-p'):command.index('-j')], [
+                '-p', 'tcp', '-m', 'set', '--match-set', 'admin_hosts', 'src',
+            ])
+            self.assertEqual(command[command.index('--destination-port'):], [
+                '--destination-port', '22', '-m', 'comment', '--comment', 'SSH from admins',
+            ])
+
+    def test_inverted_match_set(self):
+        set_module_args({
+            'chain': 'INPUT', 'match_set': '!admin_hosts',
+            'match_set_flags': 'dst,src', 'jump': 'DROP',
+        })
+        with patch.object(basic.AnsibleModule, 'run_command', return_value=(1, '', '')) as run_command:
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        command = run_command.call_args_list[0][0][0]
+        self.assertEqual(command[-8:], ['-m', 'set', '!', '--match-set', 'admin_hosts', 'dst,src', '-j', 'DROP'])
+
+    def test_match_set_parameters_required_together(self):
+        for parameters in ({'match_set': 'admin_hosts'}, {'match_set_flags': 'src'}):
+            set_module_args(dict({'chain': 'INPUT'}, **parameters))
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+            self.assertEqual(run_command.call_count, 0)
+
