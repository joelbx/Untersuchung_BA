+
+func TestDatabaseConnectionURL(t *testing.T) {
+	tests := []struct {
+		name string
+		db   DatabaseConfig
+		want string
+		err  string
+	}{
+		{name: "URL precedence", db: DatabaseConfig{URL: "file:existing.db", Protocol: DatabaseProtocolMySQL, Password: "secret"}, want: "file:existing.db"},
+		{name: "postgres defaults", db: DatabaseConfig{Protocol: DatabaseProtocolPostgres, Host: "localhost", User: "alice", Password: "p@ss", Name: "flipt"}, want: "postgres://alice:p%40ss@localhost:5432/flipt"},
+		{name: "mysql defaults", db: DatabaseConfig{Protocol: DatabaseProtocolMySQL, Host: "localhost", Name: "flipt"}, want: "mysql://localhost:3306/flipt"},
+		{name: "sqlite", db: DatabaseConfig{Protocol: DatabaseProtocolSQLite, Host: "/var/lib", Name: "flipt.db"}, want: "file:/var/lib/flipt.db"},
+		{name: "missing host", db: DatabaseConfig{Protocol: DatabaseProtocolPostgres, Name: "flipt"}, err: "db.host"},
+		{name: "missing name", db: DatabaseConfig{Protocol: DatabaseProtocolPostgres, Host: "localhost"}, err: "db.name"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.db.ConnectionURL()
+			if tt.err != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.err)
+			} else {
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, got)
+			}
+		})
+	}
+}
