+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	DatabaseProtocolSQLite DatabaseProtocol = iota + 1
+	DatabaseProtocolPostgres
+	DatabaseProtocolMySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case DatabaseProtocolSQLite:
+		return "sqlite3"
+	case DatabaseProtocolPostgres:
+		return "postgres"
+	case DatabaseProtocolMySQL:
+		return "mysql"
+	default:
+		return ""
+	}
+}
+
+// ConnectionURL resolves the selected database configuration into a driver URL.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if d.Protocol.String() == "" {
+		if d.protocolInput != "" {
+			return "", fmt.Errorf("db.protocol: invalid value %q (expected sqlite3, postgres, mysql)", d.protocolInput)
+		}
+		return "", errors.New("db.protocol is required (expected sqlite3, postgres, mysql)")
+	}
+	if d.Name == "" {
+		return "", errors.New("db.name is required")
+	}
+	if d.Host == "" {
+		return "", errors.New("db.host is required (SQLite requires a path)")
+	}
+	if d.Port < 0 || d.Port > 65535 {
+		return "", errors.New("db.port must be between 0 and 65535")
+	}
+	if d.Protocol == DatabaseProtocolSQLite {
+		return "file:" + d.Host + "/" + d.Name, nil
+	}
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == DatabaseProtocolPostgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	u := url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, fmt.Sprint(port)), Path: "/" + d.Name}
+	if d.Password != "" {
+		u.User = url.UserPassword(d.User, d.Password)
+	} else if d.User != "" {
+		u.User = url.User(d.User)
+	}
+	return u.String(), nil
+}
