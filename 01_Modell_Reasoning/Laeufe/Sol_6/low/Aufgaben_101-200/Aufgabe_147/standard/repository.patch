+export function migrateConfig(loadedConfig: any, version: number = DeviceConfig.Version) {
+	if (loadedConfig._version < 2 && !loadedConfig._credentials) loadedConfig._credentials = []
+	if (Array.isArray(loadedConfig._credentials)) migrateConfigV2to3(loadedConfig)
+	if (loadedConfig._themeId == null && loadedConfig._theme != null) loadedConfig._themeId = loadedConfig._theme
+	loadedConfig._version = version
 }
 
