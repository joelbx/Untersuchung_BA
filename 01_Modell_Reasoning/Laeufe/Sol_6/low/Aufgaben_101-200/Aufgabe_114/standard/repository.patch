+func Up20221220100000(tx *sql.Tx) error {
+	_, err := tx.Exec("alter table album add media_dirs varchar")
+	if err != nil {
+		return err
+	}
+	rows, err := tx.Query("select album_id, path from media_file order by album_id, path")
+	if err != nil {
+		return err
+	}
+	dirs := make(map[string]map[string]bool)
+	for rows.Next() {
+		var id, path string
+		if err = rows.Scan(&id, &path); err != nil {
+			rows.Close()
+			return err
+		}
+		if dirs[id] == nil {
+			dirs[id] = make(map[string]bool)
+		}
+		dirs[id][filepath.Dir(path)] = true
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return err
+	}
+	for id, set := range dirs {
+		var paths []string
+		for path := range set {
+			paths = append(paths, path)
+		}
+		slices.Sort(paths)
+		if _, err = tx.Exec("update album set media_dirs = ? where id = ?", strings.Join(paths, string(filepath.ListSeparator)), id); err != nil {
