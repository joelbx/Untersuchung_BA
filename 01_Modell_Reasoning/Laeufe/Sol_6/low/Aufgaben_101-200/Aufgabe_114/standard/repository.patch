diff --git a/model/album_dirs_test.go b/model/album_dirs_test.go
new file mode 100644
index 0000000..58a7c41
--- /dev/null
+++ b/model/album_dirs_test.go
@@ -0,0 +1,25 @@
+package model
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestAlbumDirsAndArtistDir(t *testing.T) {
+	root := t.TempDir()
+	first := filepath.Join(root, "Artist", "First")
+	second := filepath.Join(root, "Artist", "Second")
+	albums := Albums{
+		{MediaDirs: first + string(filepath.ListSeparator) + first},
+		{MediaDirs: second},
+	}
+	if got := albums[0].Dirs(); len(got) != 1 || got[0] != first {
+		t.Fatalf("album directories: %v", got)
+	}
+	if got := albums.ArtistDir(); got != filepath.Join(root, "Artist") {
+		t.Fatalf("artist directory: %q", got)
+	}
+	if got := albums[:1].ArtistDir(); got != filepath.Join(root, "Artist") {
+		t.Fatalf("single album artist directory: %q", got)
+	}
+}
