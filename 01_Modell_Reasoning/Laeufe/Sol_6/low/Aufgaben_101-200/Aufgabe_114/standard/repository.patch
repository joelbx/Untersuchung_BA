+// ArtistDir returns the shared parent of the directories containing the artist's albums.
+func (als Albums) ArtistDir() string {
+	var base string
+	var distinct map[string]bool = make(map[string]bool)
+	for _, album := range als {
+		for _, dir := range album.Dirs() {
+			distinct[dir] = true
+			if base == "" {
+				base = dir
+				continue
+			}
+			for base != dir {
+				rel, err := filepath.Rel(base, dir)
+				if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+					break
+				}
+				parent := filepath.Dir(base)
+				if parent == base {
+					return ""
+				}
+				base = parent
+			}
+		}
+	}
+	if len(distinct) == 1 && base != "" {
+		return filepath.Dir(base)
+	}
+	return base
+}
