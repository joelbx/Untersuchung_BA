+package artwork
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestFromArtistFolder(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "artist.png")
+	if err := os.WriteFile(path, []byte("image"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	r, got, err := fromArtistFolder(dir)()
+	if err != nil || got != path || r == nil {
+		t.Fatalf("got reader %v, path %q, error %v", r, got, err)
+	}
+	r.Close()
+}
