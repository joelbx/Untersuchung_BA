+    def get_locally_reachable_ips(self, ip_path):
+        reachable = {'ipv4': [], 'ipv6': []}
+        for family, key in (('-4', 'ipv4'), ('-6', 'ipv6')):
+            if family == '-6' and not socket.has_ipv6:
+                continue
+            command = [ip_path, family, 'route', 'show', 'table', 'local', 'scope', 'host']
+            rc, output, err = self.module.run_command(command, errors='surrogate_then_replace')
+            if rc != 0:
+                self.module.warn('Unable to gather locally reachable %s IPs' % key)
+                continue
+            addresses = set()
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local' or 'scope' not in words:
+                    continue
+                scope = words.index('scope')
+                if scope + 1 >= len(words) or words[scope + 1] != 'host':
+                    continue
+                try:
+                    network = ipaddress.ip_network(words[1], strict=False)
+                except ValueError:
+                    continue
+                if network.version != (4 if family == '-4' else 6):
+                    continue
+                addresses.add(str(network) if '/' in words[1] else str(network.network_address))
+            reachable[key] = sorted(addresses, key=lambda address: (
+                int(ipaddress.ip_network(address, strict=False).network_address),
+                ipaddress.ip_network(address, strict=False).prefixlen,
+                address,
+            ))
+        return reachable
+
