+interface IAdminActionLock {
+    pending: boolean;
+    run(action: () => Promise<void>): void;
+}
+
+const AdminActionLockContext = React.createContext<IAdminActionLock | undefined>(undefined);
+
+const useAdminActionLock = (): IAdminActionLock => {
+    const [pending, setPending] = useState(false);
+    const locked = useRef(false);
+    const run = useCallback((action: () => Promise<void>): void => {
+        // The ref closes the gap before React renders the disabled buttons.
+        if (locked.current) return;
+        locked.current = true;
+        setPending(true);
+        void Promise.resolve()
+            .then(action)
+            .catch((err) => {
+                logger.error("Admin action error", err);
+                Modal.createDialog(ErrorDialog, {
+                    title: _t("Admin action failed"),
+                    description: err instanceof Error ? err.message : _t("Operation failed"),
+                });
+            })
+            .finally(() => {
+                locked.current = false;
+                setPending(false);
+            });
+    }, []);
+    return { pending, run };
+};
+
+const useMemberAdminActionLock = (): IAdminActionLock => {
+    const shared = useContext(AdminActionLockContext);
+    const local = useAdminActionLock();
+    return shared ?? local;
+};
