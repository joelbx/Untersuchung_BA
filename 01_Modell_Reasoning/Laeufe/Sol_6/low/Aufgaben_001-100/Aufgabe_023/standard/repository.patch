diff --git a/internal/config/authentication_database_test.go b/internal/config/authentication_database_test.go
new file mode 100644
index 0000000..96d7822
--- /dev/null
+++ b/internal/config/authentication_database_test.go
@@ -0,0 +1,22 @@
+package config
+
+import "testing"
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	cfg := AuthenticationConfig{}
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("disabled authentication must not require database or cleanup")
+	}
+
+	for _, method := range cfg.Methods.AllMethods() {
+		method.Enable(t)
+		method.SetCleanup(t, AuthenticationCleanupSchedule{})
+		if got := cfg.RequiresDatabase(); got != method.RequiresDatabase {
+			t.Errorf("%s: RequiresDatabase() = %t, want %t", method.Name(), got, method.RequiresDatabase)
+		}
+		if got := cfg.ShouldRunCleanup(); got != method.RequiresDatabase {
+			t.Errorf("%s: ShouldRunCleanup() = %t, want %t", method.Name(), got, method.RequiresDatabase)
+		}
+		cfg = AuthenticationConfig{}
+	}
+}
