diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..262824b 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -40,4 +40,26 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum).To(Equal(hashFunc("1", input)))
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
+
+	It("restores the same hash after setting an earlier seed", func() {
+		h := hasher.NewHasher()
+		hash := h.HashFunc()
+		h.SetSeed("id", "original")
+		original := hash("id", input)
+		Expect(hash("id", input)).To(Equal(original))
+		h.SetSeed("id", "other")
+		Expect(hash("id", input)).NotTo(Equal(original))
+		h.SetSeed("id", "original")
+		Expect(hash("id", input)).To(Equal(original))
+	})
+
+	It("uses a seed set through the package function", func() {
+		hasher.SetSeed("package-id", "fixed")
+		hash := hasher.HashFunc()
+		original := hash("package-id", input)
+		hasher.Reseed("package-id")
+		Expect(hash("package-id", input)).NotTo(Equal(original))
+		hasher.SetSeed("package-id", "fixed")
+		Expect(hash("package-id", input)).To(Equal(original))
+	})
 })
