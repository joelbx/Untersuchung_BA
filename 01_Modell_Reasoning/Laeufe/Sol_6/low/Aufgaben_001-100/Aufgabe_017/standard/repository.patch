+++ b/lib/client/conntest/database/sqlserver_test.go
@@ -0,0 +1,35 @@
+package database
+
+import (
+	"context"
+	"fmt"
+	"syscall"
+	"testing"
+
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSQLServerErrors(t *testing.T) {
+	p := SQLServerPinger{}
+	for _, tt := range []struct {
+		err                 error
+		refused, user, name bool
+	}{
+		{err: fmt.Errorf("dial: %w", syscall.ECONNREFUSED), refused: true},
+		{err: fmt.Errorf("login: %w", mssql.Error{Number: 18456}), user: true},
+		{err: fmt.Errorf("database: %w", mssql.Error{Number: 4060}), name: true},
+		{err: mssql.Error{Number: 911}, name: true},
+		{err: fmt.Errorf("other failure")},
+		{},
+	} {
+		require.Equal(t, tt.refused, p.IsConnectionRefusedError(tt.err))
+		require.Equal(t, tt.user, p.IsInvalidDatabaseUserError(tt.err))
+		require.Equal(t, tt.name, p.IsInvalidDatabaseNameError(tt.err))
+	}
+}
+
+func TestSQLServerPingValidation(t *testing.T) {
+	p := SQLServerPinger{}
+	require.Error(t, p.Ping(context.Background(), PingParams{Port: 1433, Username: "user"}))
+}
