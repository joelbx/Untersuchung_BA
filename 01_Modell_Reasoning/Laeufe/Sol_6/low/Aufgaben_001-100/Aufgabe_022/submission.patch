@@ -708,6 +715,13 @@ func splitFileName(filename string) (name, ver, rel string, err error) {
 	ver = filename[verIndex+1 : relIndex]
 
 	name = filename[:verIndex]
+	if epoch, n, ok := strings.Cut(name, ":"); ok {
+		if epoch == "" || n == "" {
+			return "", "", "", xerrors.Errorf("unexpected epoch in file name: %q", filename)
+		}
+		name = n
+		ver = epoch + ":" + ver
+	}
 	return name, ver, rel, nil
 }
 
