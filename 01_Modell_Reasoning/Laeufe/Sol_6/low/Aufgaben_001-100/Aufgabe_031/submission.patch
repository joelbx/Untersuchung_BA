+func TestLoadEnvironmentOverrides(t *testing.T) {
+	for _, path := range []string{"", "./testdata/default.yml"} {
+		t.Run(path, func(t *testing.T) {
+			baseline, err := Load(path)
+			require.NoError(t, err)
+			require.Equal(t, "INFO", baseline.Config.Log.Level)
+			require.Equal(t, 8080, baseline.Config.Server.HTTPPort)
+
+			t.Setenv("FLIPT_LOG_LEVEL", "DEBUG")
+			t.Setenv("FLIPT_SERVER_HTTP_PORT", "8181")
+			result, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, "DEBUG", result.Config.Log.Level)
+			assert.Equal(t, 8181, result.Config.Server.HTTPPort)
+		})
+	}
