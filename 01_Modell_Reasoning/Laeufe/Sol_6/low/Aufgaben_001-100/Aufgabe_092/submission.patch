diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..1f7aef6
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,27 @@
+---
+- name: install an older collection for upgrade
+  command: ansible-galaxy collection install namespace1.name1:1.0.0 -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+
+- name: upgrade the collection within a version constraint
+  command: ansible-galaxy collection install --upgrade 'namespace1.name1:<1.1.0' -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+  register: upgrade_result
+
+- name: verify the upgraded version
+  slurp:
+    path: '{{ galaxy_dir }}/upgrade_collections/ansible_collections/namespace1/name1/MANIFEST.json'
+  register: upgraded_manifest
+
+- name: assert the latest permitted version was installed
+  assert:
+    that:
+      - (upgraded_manifest.content | b64decode | from_json).collection_info.version == '1.0.9'
+
+- name: repeat the upgrade
+  command: ansible-galaxy collection install -U 'namespace1.name1:<1.1.0' -s galaxy_ng -p '{{ galaxy_dir }}/upgrade_collections'
+  register: repeat_upgrade
+
+- name: assert the second upgrade is idempotent
+  assert:
+    that:
+      - "'Skipping' in repeat_upgrade.stdout"
+      - "'Installing' not in repeat_upgrade.stdout"
diff --git a/test/units/galaxy/test_collection_install.py b/test/units/galaxy/test_collection_install.py
index a4f5c35..a0541f0 100644
--- a/test/units/galaxy/test_collection_install.py
+++ b/test/units/galaxy/test_collection_install.py
@@ -916,3 +916,26 @@ def test_install_collection_with_circular_dependency(collection_artifact, monkey
     assert display_msgs[1] == "Starting collection install process"
     assert display_msgs[2] == "Installing 'ansible_namespace.collection:0.1.0' to '%s'" % to_text(collection_path)
     assert display_msgs[3] == "ansible_namespace.collection:0.1.0 was installed successfully"
+
+
+def test_upgrade_installs_new_version_once(monkeypatch, tmp_path):
+    existing = Candidate('namespace.collection', '1.0.0', None, 'galaxy')
+    newer = Candidate('namespace.collection', '1.1.0', None, 'galaxy')
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: [existing])
+    resolved = MagicMock(return_value={'namespace.collection': newer})
+    installed = MagicMock()
+    monkeypatch.setattr(collection, '_resolve_depenency_map', resolved)
+    monkeypatch.setattr(collection, 'install', installed)
+    manager = MagicMock()
+    requirement = Requirement('namespace.collection', '<2.0.0', None, 'galaxy')
+
+    collection.install_collections([requirement], to_text(tmp_path), [], False, False,
+                                   False, False, False, manager, upgrade=True)
+    installed.assert_called_once_with(newer, to_text(tmp_path), manager)
+    assert resolved.call_args[1]['upgrade'] is True
+
+    installed.reset_mock()
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda *args: [newer])
+    collection.install_collections([requirement], to_text(tmp_path), [], False, False,
+                                   False, False, False, manager, upgrade=True)
+    installed.assert_not_called()
