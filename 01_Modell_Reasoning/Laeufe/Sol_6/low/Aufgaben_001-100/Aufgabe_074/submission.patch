diff --git a/scripts/solr_builder/tests/test_fn_to_cli.py b/scripts/solr_builder/tests/test_fn_to_cli.py
index 1399523..0ffd4f2 100644
--- a/scripts/solr_builder/tests/test_fn_to_cli.py
+++ b/scripts/solr_builder/tests/test_fn_to_cli.py
@@ -1,4 +1,5 @@
 from argparse import BooleanOptionalAction
+from pathlib import Path
 import typing
 from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
 
@@ -47,3 +48,29 @@ class TestFnToCLI:
     def test_is_optional(self):
         assert FnToCLI.is_optional(typing.Optional[int])  # noqa: UP007
         assert not FnToCLI.is_optional(int)
+
+    def test_required_typed_list_and_path(self):
+        def fn(numbers: list[int], output: Path):
+            return numbers, output
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1', '2', '3', 'result.txt'])
+        assert cli.run() == ([1, 2, 3], Path('result.txt'))
+
+    def test_optional_lists_and_parameter_names(self):
+        def fn(files: list[Path] | None = None, scores: list[float] | None = None):
+            return files, scores
+
+        cli = FnToCLI(fn)
+        cli.parse_args([])
+        assert cli.run() == (None, None)
+        cli.parse_args(['--files', 'a.txt', 'b.txt', '--scores', '1.5', '2'])
+        assert cli.run() == ([Path('a.txt'), Path('b.txt')], [1.5, 2.0])
+
+    def test_async_result_and_underscored_option(self):
+        async def fn(input_files: list[str] | None = None):
+            return input_files
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['--input_files', 'a', 'b'])
+        assert cli.run() == ['a', 'b']
