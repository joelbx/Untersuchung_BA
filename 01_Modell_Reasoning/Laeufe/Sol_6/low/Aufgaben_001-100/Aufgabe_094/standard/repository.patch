+func nativeDiag() (*DiagResult, error) {
+	checks := uint(C.TouchIDDiagnostics())
+	return &DiagResult{
+		HasCompileSupport:       true,
+		HasSignature:            checks&1 != 0,
+		HasEntitlements:         checks&2 != 0,
+		PassedLAPolicyTest:      checks&4 != 0,
+		PassedSecureEnclaveTest: checks&8 != 0,
+		IsAvailable:             checks == 15,
+	}, nil
+}
