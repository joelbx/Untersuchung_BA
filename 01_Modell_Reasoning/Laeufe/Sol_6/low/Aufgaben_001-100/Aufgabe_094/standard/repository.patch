--- a/lib/auth/touchid/common.m
+++ b/lib/auth/touchid/common.m
@@ -18,6 +18,9 @@
 #include "common.h"
 
 #import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+#import <Security/SecCode.h>
 
 #include <string.h>
 
@@ -27,3 +30,38 @@ char *CopyNSString(NSString *val) {
   }
   return strdup("");
 }
+
+unsigned int TouchIDDiagnostics(void) {
+  unsigned int result = 0;
+  SecCodeRef code = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &code) == errSecSuccess) {
+    CFDictionaryRef info = NULL;
+    if (SecCodeCheckValidity(code, kSecCSDefaultFlags, NULL) == errSecSuccess &&
+        SecCodeCopySigningInformation(code, kSecCSSigningInformation, &info) == errSecSuccess) {
+      NSDictionary *signingInfo = (__bridge NSDictionary *)info;
+      if (signingInfo[(__bridge NSString *)kSecCodeInfoIdentifier] != nil) result |= 1;
+      NSDictionary *entitlements = signingInfo[(__bridge NSString *)kSecCodeInfoEntitlementsDict];
+      if ([entitlements[@"keychain-access-groups"] count] > 0) result |= 2;
+      CFRelease(info);
+    }
+    CFRelease(code);
+  }
+
+  LAContext *context = [[LAContext alloc] init];
+  if ([context canEvaluatePolicy:LAPolicyDeviceOwnerAuthenticationWithBiometrics error:nil]) result |= 4;
+
+  NSDictionary *attributes = @{
+    (__bridge id)kSecAttrKeyType: (__bridge id)kSecAttrKeyTypeECSECPrimeRandom,
+    (__bridge id)kSecAttrKeySizeInBits: @256,
+    (__bridge id)kSecAttrTokenID: (__bridge id)kSecAttrTokenIDSecureEnclave,
+    (__bridge id)kSecPrivateKeyAttrs: @{(__bridge id)kSecAttrIsPermanent: @NO}
+  };
+  CFErrorRef error = NULL;
+  SecKeyRef key = SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes, &error);
+  if (key != NULL) {
+    result |= 8;
+    CFRelease(key);
+  }
+  if (error != NULL) CFRelease(error);
+  return result;
+}
