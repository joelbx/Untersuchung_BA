+package migrations
+
+import (
+	"database/sql"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upCreateUserProps, downCreateUserProps)
+}
+
+func upCreateUserProps(tx *sql.Tx) error {
+	_, err := tx.Exec(`
+create table user_props (
+	user_id varchar(255) not null references user(id) on delete cascade,
+	key varchar(255) not null,
+	value varchar(255) default '' not null,
+	primary key (user_id, key)
+);
+insert into user_props (user_id, key, value)
+select substr(id, length('LastFMSessionKey_') + 1), 'LastFMSessionKey', value
+from property where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_'
+and substr(id, length('LastFMSessionKey_') + 1) in (select id from user);
+delete from property where substr(id, 1, length('LastFMSessionKey_')) = 'LastFMSessionKey_'
+and substr(id, length('LastFMSessionKey_') + 1) in (select id from user);
+`)
+	return err
+}
+
+func downCreateUserProps(tx *sql.Tx) error {
+	_, err := tx.Exec(`drop table user_props`)
+	return err
+}
