diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..25cdf09
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,67 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	"github.com/navidrome/navidrome/model/request"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+)
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r *userPropsRepository) userID() (string, error) {
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return "", errors.New("user missing from context")
+	}
+	return user.ID, nil
+}
+
+func (r *userPropsRepository) Put(key, value string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	update := Update(r.tableName).Set("value", value).Where(Eq{"user_id": uid, "key": key})
+	count, err := r.executeSQL(update)
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	insert := Insert(r.tableName).Columns("user_id", "key", "value").Values(uid, key, value)
+	_, err = r.executeSQL(insert)
+	return err
+}
+
+func (r *userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	var row struct{ Value string }
+	err = r.queryOne(Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key}), &row)
+	if err != nil {
+		return "", err
+	}
+	return row.Value, nil
+}
+
+func (r *userPropsRepository) Delete(key string) error {
+	uid, err := r.userID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..46eca91
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,30 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User properties", func() {
+	It("isolates keys by contextual user and supports update and delete", func() {
+		first := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-a"}), orm.NewOrm())
+		second := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "user-b"}), orm.NewOrm())
+		Expect(first.Put("shared", "one")).To(Succeed())
+		Expect(second.Put("shared", "two")).To(Succeed())
+		value, err := first.Get("shared")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("one"))
+		Expect(first.Put("shared", "updated")).To(Succeed())
+		Expect(first.Delete("shared")).To(Succeed())
+		_, err = first.Get("shared")
+		Expect(err).To(Equal(model.ErrNotFound))
+		value, err = second.Get("shared")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(value).To(Equal("two"))
+	})
+})
