+    assert get_isbn_10_and_13([]) == ([], [])
+    assert get_publisher_and_place(
+        [' New York : Simon & Schuster ', ' Other Press ', '  ', 'London : Faber']
+    ) == (['Simon & Schuster', 'Other Press', 'Faber'], ['New York', 'London'])
