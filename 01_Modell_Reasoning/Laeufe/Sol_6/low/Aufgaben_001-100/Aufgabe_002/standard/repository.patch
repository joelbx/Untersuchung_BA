+// KubeAddr returns the public Kubernetes proxy URL.
+func (p ProxyConfig) KubeAddr() (string, error) {
+	if !p.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	addrs := p.Kube.PublicAddrs
+	if len(addrs) == 0 {
+		addrs = p.PublicAddrs
+	}
+	for _, addr := range addrs {
+		if host := addr.Host(); host != "" && !strings.ContainsAny(host, "/@ \t\n") && (!strings.Contains(host, ":") || net.ParseIP(host) != nil) {
+			return "https://" + net.JoinHostPort(host, fmt.Sprint(defaults.KubeProxyListenPort)), nil
+		}
+	}
+	return "", trace.BadParameter("no valid Kubernetes proxy public address")
+}
