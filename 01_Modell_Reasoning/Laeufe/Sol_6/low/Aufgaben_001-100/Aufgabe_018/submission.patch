+func TestAllowedOriginsWhitespace(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		value string
+		want  []string
+	}{
+		{"spaces", "foo.com bar.com  baz.com", []string{"foo.com", "bar.com", "baz.com"}},
+		{"mixed whitespace", " \tfoo.com\nbar.com \t baz.com  ", []string{"foo.com", "bar.com", "baz.com"}},
+		{"empty", "", []string{}},
+	} {
+		for _, source := range []string{"YAML", "ENV"} {
+			t.Run(tt.name+" "+source, func(t *testing.T) {
+				path := t.TempDir() + "/config.yml"
+				content := "cors:\n  allowed_origins: " + fmt.Sprintf("%q", tt.value) + "\n"
+				if source == "ENV" {
+					content = "cors:\n  allowed_origins: placeholder\n"
+					t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", tt.value)
+				}
+				require.NoError(t, os.WriteFile(path, []byte(content), 0600))
+				cfg, err := Load(path)
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+			})
+		}
+	}
+}
+
+func TestAllowedOriginsSequence(t *testing.T) {
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte("cors:\n  allowed_origins: [foo.com, bar.com]\n"), 0600))
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"foo.com", "bar.com"}, cfg.Cors.AllowedOrigins)
+}
