+def test_parse_clixml_escapes_and_empty_streams():
+    data = (b'<Objs><S S="Info">ignored</S><S S="Error">A_x000D__x000A__x263A_'
+            b'_xD83D__xDE00__x005f__x000A__x005F_ _x005G_ _xD800_</S>'
+            b'<S S="Error" /></Objs><Objs><S S="Error">B</S></Objs>')
+    expected = 'A\r\n☺😀_\n_x005F_ _x005G_ \ud800\r\nB'.encode('utf-8', 'surrogatepass')
+    assert _parse_clixml(data) == expected
+    assert _parse_clixml(data, stream='Missing') == b''
+    assert _parse_clixml(b'<Objs><S S="Error" /></Objs>') == b''
