+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('DeviceDetailHeading', () => {
+    const device = { device_id: 'device-id', display_name: 'Old name', isVerified: false };
+
+    it('saves an empty name and returns to the read view', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId, queryByTestId } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(queryByTestId('device-detail-heading-edit')).toBeNull());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', '');
+        expect(getByTestId('device-detail-heading')).toBeTruthy();
+    });
+
+    it('cancels without saving and skips unchanged names', () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'Other' } });
+        fireEvent.click(getByTestId('device-detail-name-cancel'));
+        expect(getByTestId('device-detail-heading').textContent).toContain('Old name');
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('keeps the edit view open with the required error on failure', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('network error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-rename'));
+        fireEvent.change(getByTestId('device-detail-name-input'), { target: { value: 'New name' } });
+        fireEvent.click(getByTestId('device-detail-name-save'));
+        await waitFor(() => expect(getByTestId('device-detail-name-error').textContent)
+            .toBe('Failed to set display name.'));
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+    });
+});
