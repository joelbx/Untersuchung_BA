+
+import React, { useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [editing, setEditing] = useState(false);
+    const [name, setName] = useState('');
+    const [saving, setSaving] = useState(false);
+    const [error, setError] = useState<string>();
+    const [savedName, setSavedName] = useState<string>();
+    const visibleName = savedName !== undefined ? savedName : (device.display_name ?? device.device_id);
+
+    const startEditing = () => {
+        setName(visibleName);
+        setError(undefined);
+        setEditing(true);
+    };
+
+    const save = async (event: React.FormEvent) => {
+        event.preventDefault();
+        if (saving) return;
+        if (name === visibleName) {
+            setEditing(false);
+            return;
+        }
+        setSaving(true);
+        setError(undefined);
+        try {
+            await saveDeviceName(device.device_id, name);
+            setSavedName(name);
+            setEditing(false);
+        } catch (error) {
+            setError('Failed to set display name.');
+        } finally {
+            setSaving(false);
+        }
+    };
+
+    if (!editing) {
+        return <div data-testid='device-detail-heading'>
+            <Heading size='h3'>{ visibleName }</Heading>
+            <AccessibleButton kind='link_inline' onClick={startEditing} data-testid='device-detail-rename'>
+                { _t('Rename') }
+            </AccessibleButton>
+        </div>;
+    }
+
+    return <form onSubmit={save} data-testid='device-detail-heading-edit'>
+        <label htmlFor={`device-name-${device.device_id}`}>{ _t('Session name') }</label>
+        <input
+            id={`device-name-${device.device_id}`}
+            data-testid='device-detail-name-input'
+            value={name}
+            maxLength={100}
+            onChange={event => setName(event.target.value)}
+            disabled={saving}
+        />
+        <p>{ _t("A device's name is visible to people you communicate with.") }</p>
+        { error && <p role='alert' data-testid='device-detail-name-error'>{ error }</p> }
+        <button type='submit' disabled={saving} data-testid='device-detail-name-save'>
+            { _t('Save') }{ saving && <Spinner w={16} h={16} /> }
+        </button>
+        <button type='button' disabled={saving} onClick={() => setEditing(false)} data-testid='device-detail-name-cancel'>
+            { _t('Cancel') }
+        </button>
+    </form>;
+};
