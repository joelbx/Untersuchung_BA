new file mode 100644
index 0000000..c3b27c6
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,29 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt describes the running Flipt build.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the build information as JSON.
+func (i Flipt) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	out, err := json.Marshal(i)
+	if err != nil {
+		http.Error(w, "failed to encode info", http.StatusInternalServerError)
+		return
+	}
+	if _, err := w.Write(out); err != nil {
+		http.Error(w, "failed to write info", http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..c352e32
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,163 @@
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const schemaVersion = "1.0"
+const interval = 4 * time.Hour
+const endpoint = "https://telemetry.flipt.io/v1/track"
+
+// Version is set by the server at startup.
+var Version = "dev"
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+// Reporter persists a host identifier and reports anonymous usage.
+type Reporter struct {
+	mu     sync.Mutex
+	state  state
+	path   string
+	logger logrus.FieldLogger
+	client *http.Client
+}
+
+// NewReporter initializes telemetry when enabled. Errors are returned to the caller for logging.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil || !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("telemetry config directory: %w", err)
+		}
+		dir = filepath.Join(dir, "flipt")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("telemetry state directory: %w", err)
+	}
+	r := &Reporter{path: filepath.Join(dir, "telemetry.json"), logger: logger, client: &http.Client{Timeout: 10 * time.Second}}
+	data, err := os.ReadFile(r.path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, fmt.Errorf("reading telemetry state: %w", err)
+	}
+	if len(data) > 0 {
+		if err := json.Unmarshal(data, &r.state); err != nil {
+			logger.Warnf("reading telemetry state: %v", err)
+		}
+	}
+	if _, err := uuid.FromString(r.state.UUID); err != nil {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, fmt.Errorf("generating telemetry id: %w", err)
+		}
+		r.state.UUID = id.String()
+	}
+	r.state.Version = schemaVersion
+	if err := r.save(); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *Reporter) save() error {
+	data, err := json.Marshal(r.state)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(r.path, data, 0600); err != nil {
+		return fmt.Errorf("writing telemetry state: %w", err)
+	}
+	return nil
+}
+
+// Start reports when due, then checks every four hours until cancellation.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	go func() {
+		r.reportIfDue(ctx)
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				r.reportIfDue(ctx)
+			}
+		}
+	}()
+}
+
+func (r *Reporter) reportIfDue(ctx context.Context) {
+	r.mu.Lock()
+	last, err := time.Parse(time.RFC3339, r.state.LastTimestamp)
+	r.mu.Unlock()
+	if err == nil && time.Since(last) < interval {
+		return
+	}
+	if ctx.Err() != nil {
+		return
+	}
+	if err := r.Report(ctx); err != nil {
+		r.logger.Warnf("sending telemetry: %v", err)
+	}
+}
+
+// Report sends one anonymous ping and records the successful send time.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	payload := struct {
+		Event       string                 `json:"event"`
+		AnonymousId string                 `json:"anonymousId"`
+		Properties  map[string]interface{} `json:"properties"`
+	}{"flipt.ping", r.state.UUID, map[string]interface{}{
+		"uuid":    r.state.UUID,
+		"version": schemaVersion,
+		"flipt":   map[string]string{"version": Version},
+	}}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(data))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("telemetry response: %s", resp.Status)
+	}
+	r.state.LastTimestamp = time.Now().UTC().Format(time.RFC3339)
+	return r.save()
+}
diff --git a/telemetry/telemetry_test.go b/telemetry/telemetry_test.go
new file mode 100644
index 0000000..2e38d43
--- /dev/null
+++ b/telemetry/telemetry_test.go
@@ -0,0 +1,84 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+type transport func(*http.Request) (*http.Response, error)
+
+func (f transport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestReporter(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	logger := logrus.New()
+	r, err := NewReporter(cfg, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.state.UUID == "" || r.state.Version != schemaVersion {
+		t.Fatalf("unexpected state: %+v", r.state)
+	}
+	id := r.state.UUID
+	r.client.Transport = transport(func(req *http.Request) (*http.Response, error) {
+		var event struct {
+			Event       string                 `json:"event"`
+			AnonymousId string                 `json:"anonymousId"`
+			Properties  map[string]interface{} `json:"properties"`
+		}
+		if err := json.NewDecoder(req.Body).Decode(&event); err != nil {
+			t.Fatal(err)
+		}
+		if event.Event != "flipt.ping" || event.AnonymousId != id || event.Properties["uuid"] != id || event.Properties["version"] != schemaVersion {
+			t.Fatalf("unexpected event: %+v", event)
+		}
+		flipt := event.Properties["flipt"].(map[string]interface{})
+		if flipt["version"] != Version {
+			t.Fatalf("unexpected version: %v", flipt)
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(http.NoBody)}, nil
+	})
+	if err := r.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+	again, err := NewReporter(cfg, logger)
+	if err != nil || again.state.UUID != id || again.state.LastTimestamp == "" {
+		t.Fatalf("state not persisted: %+v, %v", again, err)
+	}
+	cfg.Meta.TelemetryEnabled = false
+	disabled, err := NewReporter(cfg, logger)
+	if err != nil || disabled != nil {
+		t.Fatalf("disabled reporter: %v, %v", disabled, err)
+	}
+}
+
+func TestInvalidStateAndDirectory(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	if err := os.WriteFile(filepath.Join(dir, "telemetry.json"), []byte(`{"uuid":"bad"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r.state.UUID == "bad" {
+		t.Fatalf("invalid state: %+v, %v", r, err)
+	}
+	cfg.Meta.StateDirectory = filepath.Join(dir, "telemetry.json")
+	if _, err := NewReporter(cfg, logrus.New()); err == nil {
+		t.Fatal("expected directory error")
+	}
+}
