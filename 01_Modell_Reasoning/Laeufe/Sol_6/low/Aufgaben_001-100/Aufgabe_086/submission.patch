diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 25a157e..0dad410 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -17,6 +17,26 @@ def get_iptables_version(iptables_path, module):
 
 class TestIptables(ModuleTestCase):
 
+    def test_destination_ports_multiport_rule(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'destination_ports': ['80', '443', '8081:8083'],
+            '_ansible_check_mode': True,
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 1, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+        command = run_command.call_args[0][0]
+        self.assertEqual(command[command.index('-m'):command.index('-m') + 4],
+                         ['-m', 'multiport', '--dports', '80,443,8081:8083'])
+
+    def test_destination_ports_requires_compatible_protocol(self):
+        set_module_args({'chain': 'INPUT', 'protocol': 'icmp', 'destination_ports': ['80']})
+        with self.assertRaises(AnsibleFailJson):
+            iptables.main()
+
     def setUp(self):
         super(TestIptables, self).setUp()
         self.mock_get_bin_path = patch.object(basic.AnsibleModule, 'get_bin_path', get_bin_path)
