+class TestBooknotesUpdateWorkID:
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        get_db().query("""CREATE TABLE booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL,
+            notes text NOT NULL,
+            PRIMARY KEY (username, work_id, edition_id)
+        )""")
+
+    def setup_method(self, method):
+        self.db = get_db()
+        self.db.insert('booknotes', username='reader', work_id=1,
+                       edition_id=10, notes='original')
+        self.db.insert('booknotes', username='reader', work_id=2,
+                       edition_id=10, notes='existing')
+
+    def teardown_method(self):
+        self.db.delete('booknotes', where='1=1')
+
+    def test_conflict_preserves_every_note(self):
+        before = [dict(row) for row in self.db.select('booknotes', order='work_id')]
+        assert Booknotes.update_work_id(1, 2) == {
+            'rows_changed': 0, 'rows_deleted': 0, 'failed_deletes': 1,
+        }
+        assert [dict(row) for row in self.db.select('booknotes', order='work_id')] == before
+
+    def test_success_and_dry_run(self):
+        expected = {'rows_changed': 1, 'rows_deleted': 0, 'failed_deletes': 0}
+        assert Booknotes.update_work_id(1, 3, _test=True) == expected
+        assert len(list(self.db.select('booknotes', where='work_id=1'))) == 1
+        assert Booknotes.update_work_id(1, 3) == expected
+        assert len(list(self.db.select('booknotes', where='work_id=3'))) == 1
