+def recursive_finder(name, module_fqn, data, py_module_names, py_module_cache, zf):
+    """Collect module support code and its dependencies using a work queue."""
+    mu_paths = [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)] + [_MODULE_UTILS_PATH]
+    work = deque([(name, module_fqn, data, False)])
+    pending = deque()
+    seen = set(py_module_names)
+    resolved_requests = set()
+    written = set(zf.namelist())
+
+    def include(parts, source, path, is_package=False, scan=True):
+        key = parts + (('__init__',) if is_package else ())
+        if key in seen:
+            return
+        seen.add(key)
+        py_module_names.add(key)
+        py_module_cache[key] = (source, path)
+        if path not in written:
+            zf.writestr(path, source)
+            written.add(path)
+        if scan and source:
+            work.append((parts[-1], '.'.join(parts), source, is_package))
+
+    # The wrapper imports basic even when the module source does not.
+    pending.append((('ansible', 'module_utils', 'basic'), False))
+    for parts, path in ((('ansible',), 'ansible/__init__.py'),
+                        (('ansible', 'module_utils'), 'ansible/module_utils/__init__.py')):
+        if path not in written:
+            try:
+                source = _slurp(os.path.join(os.path.dirname(__file__), '..', *parts[1:], '__init__.py'))
+            except AnsibleError:
+                source = b''
+            zf.writestr(path, source)
+            written.add(path)
+        py_module_names.add(parts + ('__init__',))
+
+    while work or pending:
+        if work:
+            current_name, current_fqn, current_data, is_package = work.popleft()
+            try:
+                tree = compile(current_data, '<unknown>', 'exec', ast.PyCF_ONLY_AST)
+            except (SyntaxError, IndentationError) as exc:
+                raise AnsibleError('Unable to import %s due to %s' % (current_name, exc.msg))
+            finder = ModuleDepFinder(current_fqn, is_package=is_package)
+            finder.visit(tree)
+            for parts in sorted(finder.submodules):
+                if parts[:3] == ('ansible', 'module_utils', 'six'):
+                    parts = parts[:3]
+                if parts == ('_six',):
+                    continue
+                if parts[:2] == ('ansible', 'module_utils') or parts[:1] == ('ansible_collections',):
+                    pending.append((parts, True))
+            continue
+        parts, ambiguous = pending.popleft()
+        if parts[:3] == ('ansible', 'module_utils', 'six'):
+            parts, ambiguous = parts[:3], False
+        if (parts, ambiguous) in resolved_requests:
+            continue
+        resolved_requests.add((parts, ambiguous))
+        locator = (CollectionModuleUtilLocator(parts, ambiguous) if parts[0] == 'ansible_collections'
+                   else LegacyModuleUtilLocator(parts, ambiguous, mu_paths))
+        if not locator.found:
+            raise AnsibleError('Could not find imported module support code for {0}. Looked for ({1})'.format(
+                module_fqn, ', '.join(locator.candidate_names_joined())))
+        resolved = locator.name_parts
+        if locator.redirect_target:
+            pending.append((locator.redirect_target, False))
+        # Include actual package initializers. Missing levels get an empty initializer.
+        for length in range(1, len(resolved)):
+            parent = resolved[:length]
+            key = parent + ('__init__',)
+            if key in seen:
+                continue
+            if parent[:1] == ('ansible_collections',):
+                if length > 5:
+                    parent_locator = CollectionModuleUtilLocator(parent)
+                    source = parent_locator.source if parent_locator.found and parent_locator.is_package else b''
+                else:
+                    source = b''
+            elif length > 2:
+                parent_locator = LegacyModuleUtilLocator(parent, mu_paths=mu_paths)
+                source = parent_locator.source if parent_locator.found and parent_locator.is_package else b''
+            else:
+                continue
+            include(parent, source, '/'.join(parent) + '/__init__.py', True)
+        include(resolved, locator.source, locator.output_path, locator.is_package)
+    py_module_cache.clear()
 
 
