+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_default_mode_warning_on_result(atomic_am, atomic_mocks, mocker):
+    atomic_am.argument_spec['mode'] = {'type': 'raw'}
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+    atomic_mocks['umask'].side_effect = [0o022, 0]
+    warn = mocker.patch.object(atomic_am, 'warn')
+    mocker.patch.object(atomic_am, 'add_path_info')
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert atomic_am._created_files == {'/path/to/dest'}
+    atomic_mocks['chmod'].assert_called_with(b'/path/to/dest', 0o600)
+    atomic_am._return_formatted({})
+    warn.assert_called_once_with("File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning.")
+    assert not atomic_am._created_files
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_setting_mode_clears_default_mode_warning(atomic_am, atomic_mocks, mocker):
+    atomic_am.argument_spec['mode'] = {'type': 'raw'}
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    mocker.patch('os.lstat').return_value.st_mode = 0o600
+    atomic_am.set_mode_if_different('/path/to/dest', '0600', False)
+    assert not atomic_am._created_files
+
+
