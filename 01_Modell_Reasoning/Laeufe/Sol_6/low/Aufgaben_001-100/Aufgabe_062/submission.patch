+
+// NotifyExit closes the shared stdin reader so an active password prompt can
+// restore the terminal before the program exits.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+	if closer, ok := stdin.(io.Closer); ok {
+		_ = closer.Close()
+	}
+}
