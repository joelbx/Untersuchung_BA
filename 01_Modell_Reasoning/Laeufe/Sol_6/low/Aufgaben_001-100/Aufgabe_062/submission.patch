@@ -186,6 +186,52 @@ func TestContextReader_ReadPassword(t *testing.T) {
 	})
 }
 
+func TestContextReaderPasswordAbandonment(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ctx  func() (context.Context, context.CancelFunc)
+		err  error
+	}{
+		{"cancel", func() (context.Context, context.CancelFunc) { return context.WithCancel(context.Background()) }, context.Canceled},
+		{"deadline", func() (context.Context, context.CancelFunc) {
+			return context.WithTimeout(context.Background(), time.Millisecond)
+		}, context.DeadlineExceeded},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pr, pw := io.Pipe()
+			defer pr.Close()
+			defer pw.Close()
+			cr := NewContextReader(pr)
+			fake := &fakeTerm{reader: pr}
+			cr.term, cr.fd = fake, 1
+			ctx, cancel := tc.ctx()
+			defer cancel()
+			if tc.err == context.Canceled {
+				cancel()
+			}
+			got, err := cr.ReadPassword(ctx)
+			require.ErrorIs(t, err, tc.err)
+			require.Empty(t, got)
+			require.True(t, fake.restoreCalled)
+			require.Equal(t, readerStateClean, cr.state)
+			require.NoError(t, cr.Close())
+		})
+	}
+}
+
+func TestContextReaderCloseRestoresPassword(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	cr := NewContextReader(pr)
+	fake := &fakeTerm{reader: pr}
+	cr.term, cr.fd = fake, 1
+	require.NoError(t, cr.firePasswordRead())
+	require.NoError(t, cr.Close())
+	require.True(t, fake.restoreCalled)
+	require.Equal(t, readerStateClosed, cr.state)
+}
+
 type fakeTerm struct {
 	reader        io.Reader
 	restoreCalled bool
