+func TestMatch(t *testing.T) {
+	for _, tt := range []struct {
+		pattern, input string
+		want           bool
+	}{
+		{"foo", "foo", true},
+		{"foo", "foobar", false},
+		{"foo*bar", "foo123bar", true},
+		{"^foo+$", "fooo", true},
+		{`{{regexp.match("^b.r$")}}`, "bar", true},
+		{`{{regexp.not_match("^foo$")}}`, "bar", true},
+		{`{{regexp.not_match("^foo$")}}`, "foo", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz", true},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz-extra", false},
+	} {
+		matcher, err := Match(tt.pattern)
+		assert.NoError(t, err, tt.pattern)
+		if err == nil {
+			assert.Equal(t, tt.want, matcher.Match(tt.input), tt.pattern)
+		}
+	}
+	for _, pattern := range []string{
+		`{{regexp.match("[")}}`, `{{regexp.match(foo)}}`, `{{regexp.match()}}`,
+		`{{regexp.match("a", "b")}}`, `{{other.match("a")}}`, `{{regexp.other("a")}}`,
+		`{{internal.foo}}`, `{{regexp.match("a")`, `{{regexp.match("a")}}{{regexp.match("b")}}`,
+	} {
+		_, err := Match(pattern)
+		assert.Error(t, err, pattern)
+	}
+	_, err := Variable(`{{regexp.match("foo")}}`)
+	assert.EqualError(t, err, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"foo\")}}"`)
+}
