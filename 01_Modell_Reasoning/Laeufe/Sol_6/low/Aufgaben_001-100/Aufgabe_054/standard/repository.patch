 	object      interface{}
diff --git a/utils/singleton/singleton_test.go b/utils/singleton/singleton_test.go
index 9014e4e..b56e2bc 100644
--- a/utils/singleton/singleton_test.go
+++ b/utils/singleton/singleton_test.go
@@ -17,6 +17,63 @@ func TestSingleton(t *testing.T) {
 	RunSpecs(t, "Singleton Suite")
 }
 
+func TestGetInstance(t *testing.T) {
+	type value struct{ id int }
+	var valueCalls, pointerCalls int
+	first := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 1}
+	})
+	second := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 2}
+	})
+	if first != second || first.id != 1 || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v calls=%d", first, second, valueCalls)
+	}
+	pointer := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 3}
+	})
+	again := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 4}
+	})
+	if pointer != again || pointer.id != 3 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p calls=%d", pointer, again, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type concurrent struct{ id int }
+	const calls = 20000
+	var creations atomic.Int32
+	var start sync.WaitGroup
+	start.Add(1)
+	results := make([]*concurrent, calls)
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			start.Wait()
+			results[i] = singleton.GetInstance(func() *concurrent {
+				return &concurrent{id: int(creations.Add(1))}
+			})
+		}(i)
+	}
+	start.Done()
+	done.Wait()
+	if got := creations.Load(); got != 1 {
+		t.Fatalf("constructor called %d times", got)
+	}
+	for i, result := range results {
+		if result != results[0] || result.id != 1 {
+			t.Fatalf("call %d returned %p; first=%p", i, result, results[0])
+		}
+	}
+}
