+def remove_author_honorifics(name: str) -> str:
+    """Remove a leading honorific when a name follows it."""
+    normalized = re.sub(r'\W', '', name.casefold())
+    if normalized in {re.sub(r'\W', '', n) for n in HONORIFC_NAME_EXECPTIONS}:
+        return name
+    for honorific in HONORIFICS:
+        if name.casefold().startswith(honorific):
+            rest = name[len(honorific):]
+            if rest and (rest[0].isspace() or rest[0] == '.'):
+                stripped = rest.lstrip(' .')
+                if stripped:
+                    return stripped
+    return name
 
 
