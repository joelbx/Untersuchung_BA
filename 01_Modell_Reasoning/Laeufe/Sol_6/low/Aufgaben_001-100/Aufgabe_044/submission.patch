--- a/internal/server/authz/authz.go
+++ b/internal/server/authz/authz.go
@@ -1,8 +1,40 @@
 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey struct{}
+
+// NamespacesKey carries the namespaces visible to the authenticated caller.
+var NamespacesKey contextKey
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
+
+// FormatNamespaces validates the value returned by a namespace policy.
+func FormatNamespaces(value any) ([]string, error) {
+	if value == nil {
+		return nil, fmt.Errorf("viewable namespaces are undefined")
+	}
+	switch v := value.(type) {
+	case []string:
+		return v, nil
+	case []any:
+		namespaces := make([]string, 0, len(v))
+		for _, item := range v {
+			name, ok := item.(string)
+			if !ok {
+				return nil, fmt.Errorf("invalid viewable namespace %T", item)
+			}
+			namespaces = append(namespaces, name)
+		}
+		return namespaces, nil
+	default:
+		return nil, fmt.Errorf("invalid viewable namespaces result %T", value)
+	}
+}
