+// CveIDDiffFormat formats the CVE ID for a diff report.
+func (v VulnInfo) CveIDDiffFormat(isDiffMode bool) string {
+	if isDiffMode {
+		return string(v.DiffStatus) + v.CveID
+	}
+	return v.CveID
+}
