+// DiffStatus describes a change between scans.
+type DiffStatus string
+
+const (
+	DiffPlus  DiffStatus = "+"
+	DiffMinus DiffStatus = "-"
+)
+
 // VulnInfos has a map of VulnInfo
 // Key: CveID
 type VulnInfos map[string]VulnInfo
 
+// CountDiff counts newly detected and resolved vulnerabilities.
+func (v VulnInfos) CountDiff() (nPlus int, nMinus int) {
+	for _, info := range v {
+		switch info.DiffStatus {
+		case DiffPlus:
+			nPlus++
+		case DiffMinus:
+			nMinus++
+		}
+	}
+	return
+}
+
 // Find elements that matches the function passed in argument
 func (v VulnInfos) Find(f func(VulnInfo) bool) VulnInfos {
 	filtered := VulnInfos{}
