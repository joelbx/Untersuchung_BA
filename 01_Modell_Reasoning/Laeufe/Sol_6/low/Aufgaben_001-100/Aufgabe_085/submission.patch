+func TestDiffDirections(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"new":    {CveID: "new", AffectedPackages: models.PackageFixStatuses{{Name: "current"}}},
+			"shared": {CveID: "shared"},
+		},
+		Packages: models.Packages{"current": {Name: "current", Version: "new"}},
+	}
+	previous := models.ScanResult{
+		ServerName: "server",
+		ScannedCves: models.VulnInfos{
+			"old":    {CveID: "old", AffectedPackages: models.PackageFixStatuses{{Name: "previous"}}},
+			"shared": {CveID: "shared"},
+		},
+		Packages: models.Packages{"previous": {Name: "previous", Version: "old"}},
+	}
+	for _, tc := range []struct {
+		plus, minus         bool
+		wantPlus, wantMinus int
+	}{
+		{true, false, 1, 0}, {false, true, 0, 1}, {true, true, 1, 1}, {false, false, 0, 0},
+	} {
+		results, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tc.plus, tc.minus)
+		if err != nil {
+			t.Fatal(err)
+		}
+		result := results[0]
+		nPlus, nMinus := result.ScannedCves.CountDiff()
+		if nPlus != tc.wantPlus || nMinus != tc.wantMinus || len(result.ScannedCves) != nPlus+nMinus {
+			t.Errorf("plus=%v minus=%v: got %d plus, %d minus, %d total", tc.plus, tc.minus, nPlus, nMinus, len(result.ScannedCves))
+		}
+		if tc.plus {
+			if result.ScannedCves["new"].CveIDDiffFormat(true) != "+new" || result.Packages["current"].Version != "new" {
+				t.Error("new CVE or package incorrect")
+			}
+		}
+		if tc.minus {
+			if result.ScannedCves["old"].CveIDDiffFormat(true) != "-old" || result.Packages["previous"].Version != "old" {
+				t.Error("resolved CVE or package incorrect")
+			}
+		}
+	}
+}
