+func TestEnvironmentSubstitution(t *testing.T) {
+	t.Setenv("TEST_FLIPT_PORT", "8181")
+	t.Setenv("TEST_FLIPT_LEVEL", "DEBUG")
+	t.Setenv("TEST_FLIPT_ENCODING", "json")
+
+	path := t.TempDir() + "/config.yml"
+	require.NoError(t, os.WriteFile(path, []byte(`server:
+  http_port: ${TEST_FLIPT_PORT}
+log:
+  level: ${TEST_FLIPT_LEVEL}
+  encoding: ${TEST_FLIPT_ENCODING}
+  file: prefix-${TEST_FLIPT_LEVEL}
+`), 0600))
+
+	result, err := Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8181, result.Config.Server.HTTPPort)
+	assert.Equal(t, "DEBUG", result.Config.Log.Level)
+	assert.Equal(t, LogEncodingJSON, result.Config.Log.Encoding)
+	assert.Equal(t, "prefix-${TEST_FLIPT_LEVEL}", result.Config.Log.File)
+
+	t.Setenv("FLIPT_SERVER_HTTP_PORT", "8282")
+	t.Setenv("FLIPT_LOG_LEVEL", "WARN")
+	result, err = Load(context.Background(), path)
+	require.NoError(t, err)
+	assert.Equal(t, 8282, result.Config.Server.HTTPPort)
+	assert.Equal(t, "WARN", result.Config.Log.Level)
+}
+
+func TestEnvironmentSubstitutionHook(t *testing.T) {
+	t.Setenv("TEST_FLIPT_EMPTY", "")
+	hook := envSubstitutionHookFunc()
+	decode := func(value any) any {
+		result, err := mapstructure.DecodeHookExec(hook, reflect.ValueOf(value), reflect.ValueOf(""))
+		require.NoError(t, err)
+		return result
+	}
+	assert.Equal(t, "", decode("${TEST_FLIPT_EMPTY}"))
+	assert.Equal(t, "${TEST_FLIPT_MISSING}", decode("${TEST_FLIPT_MISSING}"))
+	for _, value := range []string{"x${TEST_FLIPT_EMPTY}", "${TEST_FLIPT_EMPTY}x", "${1INVALID}", "${INVALID-NAME}", "${}"} {
+		assert.Equal(t, value, decode(value))
+	}
+	assert.Equal(t, 42, decode(42))
+}
