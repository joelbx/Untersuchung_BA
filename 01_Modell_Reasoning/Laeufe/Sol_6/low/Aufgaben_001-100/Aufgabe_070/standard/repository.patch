+        value = language.strip().casefold()
+        code = get_marc21_language(value)
+        if code is None and len(value) == 3:
+            code = value
+        if code is None:
+            keys = web.ctx.site.things({'type': '/type/language', 'limit': 1000})
+            for record in web.ctx.site.get_many(keys):
+                if record.deprecated:
+                    continue
+                names = [record.name]
+                names.extend(
+                    translated[0]
+                    for translated in (record.get('name_translated') or {}).values()
+                    if translated
+                )
+                if any(name.casefold() == value for name in names):
+                    code = record.code
+                    break
+
+        if code is None or web.ctx.site.get(f"/languages/{code}") is None:
+            raise InvalidLanguage(value)
+
+        if code not in seen:
+            seen.add(code)
+            formatted_languages.append({'key': f'/languages/{code}'})
 
     return formatted_languages
