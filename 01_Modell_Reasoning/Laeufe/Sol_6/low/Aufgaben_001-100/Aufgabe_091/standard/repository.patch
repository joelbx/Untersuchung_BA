diff --git a/internal/server/evaluation/list_operators_test.go b/internal/server/evaluation/list_operators_test.go
new file mode 100644
index 0000000..83f79e6
--- /dev/null
+++ b/internal/server/evaluation/list_operators_test.go
@@ -0,0 +1,35 @@
+package evaluation
+
+import (
+	"testing"
+
+	"go.flipt.io/flipt/internal/storage"
+	"go.flipt.io/flipt/rpc/flipt"
+)
+
+func TestListOperators(t *testing.T) {
+	for _, op := range []string{flipt.OpIsOneOf, flipt.OpIsNotOneOf} {
+		for _, present := range []bool{true, false} {
+			stringValue := "missing"
+			numberValue := "3"
+			if present {
+				stringValue = "b"
+				numberValue = "2"
+			}
+			want := present == (op == flipt.OpIsOneOf)
+			if got := matchesString(storage.EvaluationConstraint{Operator: op, Value: `["a","b"]`}, stringValue); got != want {
+				t.Errorf("string %s present=%t: got %t", op, present, got)
+			}
+			got, err := matchesNumber(storage.EvaluationConstraint{Operator: op, Value: `[1,2]`}, numberValue)
+			if err != nil || got != want {
+				t.Errorf("number %s present=%t: got %t, %v", op, present, got, err)
+			}
+		}
+		if matchesString(storage.EvaluationConstraint{Operator: op, Value: `[1]`}, "a") {
+			t.Errorf("invalid string list matched for %s", op)
+		}
+		if _, err := matchesNumber(storage.EvaluationConstraint{Operator: op, Value: `["1"]`}, "1"); err == nil {
+			t.Errorf("invalid number list accepted for %s", op)
+		}
+	}
+}
