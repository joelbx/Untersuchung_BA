--- /dev/null
+++ b/rpc/flipt/list_operators_test.go
@@ -0,0 +1,30 @@
+package flipt
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestListConstraintValidation(t *testing.T) {
+	for _, tc := range []struct {
+		typ   ComparisonType
+		value string
+		valid bool
+	}{
+		{ComparisonType_STRING_COMPARISON_TYPE, `["a","b"]`, true},
+		{ComparisonType_NUMBER_COMPARISON_TYPE, `[1,2]`, true},
+		{ComparisonType_STRING_COMPARISON_TYPE, `[1]`, false},
+		{ComparisonType_NUMBER_COMPARISON_TYPE, `["1"]`, false},
+		{ComparisonType_STRING_COMPARISON_TYPE, `null`, false},
+		{ComparisonType_NUMBER_COMPARISON_TYPE, `[1,`, false},
+		{ComparisonType_STRING_COMPARISON_TYPE, `[` + strings.Repeat(`"x",`, 100) + `"x"]`, false},
+	} {
+		for _, op := range []string{OpIsOneOf, OpIsNotOneOf} {
+			create := (&CreateConstraintRequest{SegmentKey: "seg", Property: "p", Type: tc.typ, Operator: op, Value: tc.value}).Validate()
+			update := (&UpdateConstraintRequest{Id: "id", SegmentKey: "seg", Property: "p", Type: tc.typ, Operator: op, Value: tc.value}).Validate()
+			if (create == nil) != tc.valid || (update == nil) != tc.valid {
+				t.Errorf("type %s operator %s value %s: create %v update %v", tc.typ, op, tc.value, create, update)
+			}
+		}
+	}
+}
