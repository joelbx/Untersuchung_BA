+def _is_child_path(b_root, b_path, b_link_path=None):
+    """Check a path, optionally relative to a symlink location, against a root."""
+    if b_link_path is not None:
+        b_path = os.path.join(os.path.dirname(b_link_path), b_path)
+    root = os.path.realpath(b_root)
+    candidate = os.path.realpath(b_path)
+    return candidate == root or candidate.startswith(root + to_bytes(os.path.sep) if isinstance(root, bytes) else root + os.path.sep)
