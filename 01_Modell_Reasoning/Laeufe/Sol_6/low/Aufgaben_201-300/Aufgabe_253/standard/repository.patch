+def test_stderr_message_while_running(proc, qtbot, message_mock, py_proc, caplog):
+    proc._output_messages = True
+    cmd, args = py_proc(r"""
+        import sys, time
+        sys.stderr.write('early error\n')
+        sys.stderr.flush()
+        time.sleep(2)
+    """)
+    with caplog.at_level(logging.ERROR, 'message'):
+        proc.start(cmd, args)
+        qtbot.wait_until(lambda: bool(message_mock.messages), timeout=1000)
+    assert proc.outcome.running
+    assert message_mock.messages[0].level == usertypes.MessageLevel.error
+    assert message_mock.messages[0].text == 'early error'
+
+
