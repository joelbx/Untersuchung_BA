+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set(["loadstart", "loadeddata", "canplay", "playing", "pause", "ended", "waiting"]);
+
+/** Listener suitable for attachment to call sound media elements. */
+export function handleEvent(e: Event): void {
+    if (!errorEvents.has(e.type) && !debugEvents.has(e.type)) return;
+
+    const id = (e.currentTarget as HTMLMediaElement | null)?.id ??
+        (e.target as HTMLMediaElement | null)?.id;
+    if (errorEvents.has(e.type)) {
+        logger.error("LegacyCallHandler media event", { id, type: e.type });
+    } else if (SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("LegacyCallHandler media event", { id, type: e.type });
+    }
+}
