diff --git a/test/units/module_utils/common/validation/test_check_type_dict.py b/test/units/module_utils/common/validation/test_check_type_dict.py
index 665224e..d4300a3 100644
--- a/test/units/module_utils/common/validation/test_check_type_dict.py
+++ b/test/units/module_utils/common/validation/test_check_type_dict.py
@@ -31,3 +31,31 @@ def test_check_type_dict_fail():
     for case in test_cases:
         with pytest.raises(TypeError):
             check_type_dict(case)
+
+@pytest.mark.parametrize('value, expected', [
+    ("{'key': 'value'}", {'key': 'value'}),
+    ('k1=v1 k2=v2', {'k1': 'v1', 'k2': 'v2'}),
+    (' k1=v1, k2=v2 ', {'k1': 'v1', 'k2': 'v2'}),
+])
+def test_check_type_dict_supported_forms(value, expected):
+    assert check_type_dict(value) == expected
+
+
+@pytest.mark.parametrize('value', [
+    '[]', 'null', '42', '"text"', "{'key': [__import__('os').system('false')]}",
+    '{bad}', 'k1=v1 k2', 'k1=v1,', '=v1', 'k1=', 'k1="unterminated',
+])
+def test_check_type_dict_rejects_invalid_input(value):
+    with pytest.raises(TypeError):
+        check_type_dict(value)
+
+
+def test_safe_eval_emits_deprecation():
+    from ansible.module_utils.common.validation import safe_eval
+    from ansible.module_utils.common.warnings import get_deprecation_messages
+
+    before = len(get_deprecation_messages())
+    assert safe_eval("{'key': 'value'}") == {'key': 'value'}
+    notice = get_deprecation_messages()[before]
+    assert notice['version'] == '2.21'
+    assert 'safe_eval' in notice['msg']
