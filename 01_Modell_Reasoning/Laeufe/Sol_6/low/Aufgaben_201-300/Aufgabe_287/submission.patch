+// imageFiles collects artwork from every directory containing an album's tracks.
+func imageFiles(albumDirs []string, dirs dirMap) string {
+	var paths []string
+	for _, dir := range albumDirs {
+		for _, name := range dirs[dir].ImageFiles {
+			paths = append(paths, filepath.Join(dir, name))
+		}
+	}
+	return strings.Join(paths, string(filepath.ListSeparator))
+}
