+package model
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestMediaFilesDirs(t *testing.T) {
+	files := MediaFiles{{Path: "/music/b/one.mp3"}, {Path: "/music/a/two.mp3"}, {Path: "/music/b/three.mp3"}}
+	want := []string{"/music/a", "/music/b"}
+	if got := files.Dirs(); !reflect.DeepEqual(got, want) {
+		t.Fatalf("Dirs = %v, want %v", got, want)
+	}
+}
