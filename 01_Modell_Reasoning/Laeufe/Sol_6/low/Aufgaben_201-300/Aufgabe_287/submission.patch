@@ -0,0 +1,19 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestImageFiles(t *testing.T) {
+	dirs := dirMap{
+		"/music/a": {ImageFiles: []string{"cover.jpg", "back.png"}},
+		"/music/b": {ImageFiles: []string{"front.jpg"}},
+	}
+	got := imageFiles([]string{"/music/a", "/music/b"}, dirs)
+	want := strings.Join([]string{filepath.Join("/music/a", "cover.jpg"), filepath.Join("/music/a", "back.png"), filepath.Join("/music/b", "front.jpg")}, string(filepath.ListSeparator))
+	if got != want {
+		t.Fatalf("imageFiles = %q, want %q", got, want)
+	}
+}
