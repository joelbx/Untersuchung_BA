+package cue
+
+import (
+ "errors"
+ "strings"
+ "testing"
+ "github.com/stretchr/testify/require"
+)
+func TestPreciseErrors(t *testing.T) {
+ v, err := NewFeaturesValidator(); require.NoError(t,err)
+ b := []byte("flags:\n- ey: bad\n  name: a\n  enabled: false\n  nabled: true\n  variants: []\n  rules:\n  - segment: a\n    rank: 1\n    distributions:\n    - variant: a\n      rollout: 110\nsegments: []\n")
+ r, err := v.Validate("test.yaml",b)
+ require.True(t,errors.Is(err,ErrValidationFailed))
+ for _, e := range r.Errors { t.Logf("%s %s %d:%d",e.Path,e.Message,e.Location.Line,e.Location.Column) }
+ require.NotEmpty(t,r.Errors)
+ require.True(t,strings.Contains(r.Errors[len(r.Errors)-1].Message,"rollout") || len(r.Errors)>1)
+}
