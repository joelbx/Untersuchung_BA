+++ b/internal/ext/common_test.go
@@ -0,0 +1,33 @@
+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestRuleSegmentYAML(t *testing.T) {
+	for _, input := range []string{
+		"segment: foo\n",
+		"segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n",
+		"segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR\n",
+	} {
+		var rule Rule
+		require.NoError(t, yaml.UnmarshalStrict([]byte(input), &rule))
+		require.NotNil(t, rule.Segment)
+		var fsRule Rule
+		require.NoError(t, yamlv3.Unmarshal([]byte(input), &fsRule))
+		require.NotNil(t, fsRule.Segment)
+		_, err := yaml.Marshal(&rule)
+		require.NoError(t, err)
+	}
+	for _, input := range []string{
+		"segment: []\n", "segment: ''\n", "segment: {keys: [] , operator: AND_SEGMENT_OPERATOR}\n",
+		"segment: {keys: [foo, bar], operator: BAD}\n", "segment: {keys: [foo]}\n",
+	} {
+		var rule Rule
+		require.Error(t, yaml.Unmarshal([]byte(input), &rule))
+	}
+}
