 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type IsSegment interface{ isSegment() }
+
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+type SegmentEmbed struct{ IsSegment IsSegment }
+
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	switch v := s.IsSegment.(type) {
+	case SegmentKey:
+		if v == "" {
+			return nil, fmt.Errorf("segment key is empty")
+		}
+		return string(v), nil
+	case Segments:
+		if err := validateSegments(v); err != nil {
+			return nil, err
+		}
+		if len(v.Keys) == 1 {
+			v.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		return v, nil
+	default:
+		return nil, fmt.Errorf("invalid segment: %T", s.IsSegment)
+	}
+}
+
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case string:
+		if v == "" {
+			return fmt.Errorf("segment key is empty")
+		}
+		s.IsSegment = SegmentKey(v)
+		return nil
+	case map[interface{}]interface{}:
+		if len(v) != 2 {
+			return fmt.Errorf("segment requires keys and operator")
+		}
+		if _, ok := v["keys"]; !ok {
+			return fmt.Errorf("segment requires keys")
+		}
+		if _, ok := v["operator"]; !ok {
+			return fmt.Errorf("segment requires operator")
+		}
+		var group Segments
+		if err := unmarshal(&group); err != nil {
+			return err
+		}
+		if err := validateSegments(group); err != nil {
+			return err
+		}
+		if len(group.Keys) == 1 {
+			group.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		s.IsSegment = group
+		return nil
+	case map[string]interface{}:
+		if len(v) != 2 {
+			return fmt.Errorf("segment requires keys and operator")
+		}
+		if _, ok := v["keys"]; !ok {
+			return fmt.Errorf("segment requires keys")
+		}
+		if _, ok := v["operator"]; !ok {
+			return fmt.Errorf("segment requires operator")
+		}
+		var group Segments
+		if err := unmarshal(&group); err != nil {
+			return err
+		}
+		if err := validateSegments(group); err != nil {
+			return err
+		}
+		if len(group.Keys) == 1 {
+			group.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		s.IsSegment = group
+		return nil
+	default:
+		return fmt.Errorf("invalid segment format: %T", raw)
+	}
+}
+
+func validateSegments(group Segments) error {
+	if len(group.Keys) == 0 {
+		return fmt.Errorf("segment requires at least one key")
+	}
+	for _, key := range group.Keys {
+		if key == "" {
+			return fmt.Errorf("segment key is empty")
+		}
+	}
+	if len(group.Keys) == 1 {
+		return nil
+	}
+	if group.SegmentOperator != "AND_SEGMENT_OPERATOR" && group.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid segment operator %q", group.SegmentOperator)
+	}
+	return nil
 }
 
 type Distribution struct {
