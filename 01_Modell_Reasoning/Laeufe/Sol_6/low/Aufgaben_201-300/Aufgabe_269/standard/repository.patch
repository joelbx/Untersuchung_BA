diff --git a/contrib/trivy/pkg/converter_test.go b/contrib/trivy/pkg/converter_test.go
new file mode 100644
index 0000000..42a34fb
--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,41 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesSourceContentsAcrossTargets(t *testing.T) {
+	date := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	results := types.Results{
+		{Vulnerabilities: []types.DetectedVulnerability{{
+			VulnerabilityID: "CVE-2024-1234",
+			Vulnerability: dbtypes.Vulnerability{
+				Title: "example", Description: "description", PublishedDate: &date, LastModifiedDate: &date,
+				VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow},
+				CVSS:           dbtypes.VendorCVSS{"debian": {V3Score: 3.1, V3Vector: "CVSS:3.1/example"}},
+			},
+		}}},
+		{Vulnerabilities: []types.DetectedVulnerability{{
+			VulnerabilityID: "CVE-2024-1234",
+			Vulnerability: dbtypes.Vulnerability{
+				VendorSeverity: dbtypes.VendorSeverity{"ubuntu": dbtypes.SeverityMedium},
+				CVSS:           dbtypes.VendorCVSS{"ubuntu": {V3Score: 5.0}},
+			},
+		}}},
+	}
+	got, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := got.ScannedCves["CVE-2024-1234"].CveContents
+	debian := contents[models.TrivyDebian][0]
+	ubuntu := contents[models.TrivyUbuntu][0]
+	if debian.Cvss3Severity != "LOW" || debian.Cvss3Score != 3.1 || !debian.Published.Equal(date) || ubuntu.Cvss3Severity != "MEDIUM" || ubuntu.Cvss3Score != 5.0 {
+		t.Fatalf("source-specific contents lost: %#v", contents)
+	}
+}
