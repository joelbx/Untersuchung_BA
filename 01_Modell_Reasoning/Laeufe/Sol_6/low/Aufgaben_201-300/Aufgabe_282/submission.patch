diff --git a/tests/unit/browser/test_shared.py b/tests/unit/browser/test_shared.py
index 5ec8a4c..425ec78 100644
--- a/tests/unit/browser/test_shared.py
+++ b/tests/unit/browser/test_shared.py
@@ -20,6 +20,7 @@
 import pytest
 
 from qutebrowser.browser import shared
+from qutebrowser.utils import usertypes
 
 
 @pytest.mark.parametrize('dnt, accept_language, custom_headers, expected', [
@@ -45,3 +46,36 @@ def test_custom_headers(config_stub, dnt, accept_language, custom_headers,
 
     expected_items = sorted(expected.items())
     assert shared.custom_headers(url=None) == expected_items
+
+
+@pytest.mark.parametrize('source, level, msg, shown', [
+    ('userscript:style', usertypes.JsLogLevel.error, 'CSP blocked style', False),
+    ('userscript:style', usertypes.JsLogLevel.error, 'Unexpected error', True),
+    ('userscript:other', usertypes.JsLogLevel.error, 'CSP blocked style', True),
+    ('userscript:style', usertypes.JsLogLevel.warning, 'Unexpected error', False),
+    ('website', usertypes.JsLogLevel.error, 'Unexpected error', False),
+])
+def test_javascript_log_message_filter(config_stub, mocker, source, level,
+                                       msg, shown):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error'],
+    }
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:style': ['*CSP blocked*'],
+    }
+    config_stub.val.content.javascript.log = {
+        'unknown': 'debug', 'info': 'debug', 'warning': 'debug', 'error': 'debug',
+    }
+    ui = mocker.Mock()
+    logger = mocker.Mock()
+    mocker.patch.dict(shared._JS_LOGMAP_MESSAGE, {level: ui})
+    mocker.patch.dict(shared._JS_LOGMAP, {'debug': logger})
+
+    shared.javascript_log_message(level, source, 66, msg)
+
+    if shown:
+        ui.assert_called_once_with(f'JS: [{source}:66] {msg}')
+        logger.assert_not_called()
+    else:
+        ui.assert_not_called()
+        logger.assert_called_once_with(f'[{source}:66] {msg}')
