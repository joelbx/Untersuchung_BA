+		if err := validateOAuthFields(name, provider.ClientID, provider.ClientSecret, provider.RedirectAddress); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateOAuthFields(provider, clientID, clientSecret, redirectAddress string) error {
+	for _, field := range []struct{ name, value string }{
+		{"client_id", clientID},
+		{"client_secret", clientSecret},
+		{"redirect_address", redirectAddress},
+	} {
+		if strings.TrimSpace(field.value) == "" {
+			return fmt.Errorf("provider %q: field %q: non-empty value is required", provider, field.name)
+		}
+	}
+	return nil
+}
 
