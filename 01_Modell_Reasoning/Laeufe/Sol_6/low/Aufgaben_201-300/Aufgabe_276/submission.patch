diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..c2d06a4
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,47 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationOAuthValidation(t *testing.T) {
+	for _, method := range []string{"github", "oidc"} {
+		for _, field := range []string{"client_id", "client_secret", "redirect_address"} {
+			t.Run(method+"/"+field, func(t *testing.T) {
+				cfg := AuthenticationConfig{}
+				cfg.Session.Domain = "localhost"
+				provider := "github"
+				if method == "github" {
+					cfg.Methods.Github.Enabled = true
+					cfg.Methods.Github.Method = AuthenticationMethodGithubConfig{
+						ClientId: "id", ClientSecret: "secret", RedirectAddress: "callback",
+					}
+					switch field {
+					case "client_id":
+						cfg.Methods.Github.Method.ClientId = " "
+					case "client_secret":
+						cfg.Methods.Github.Method.ClientSecret = ""
+					case "redirect_address":
+						cfg.Methods.Github.Method.RedirectAddress = ""
+					}
+				} else {
+					provider = "foo"
+					cfg.Methods.OIDC.Enabled = true
+					p := AuthenticationMethodOIDCProvider{ClientID: "id", ClientSecret: "secret", RedirectAddress: "callback"}
+					switch field {
+					case "client_id":
+						p.ClientID = ""
+					case "client_secret":
+						p.ClientSecret = " "
+					case "redirect_address":
+						p.RedirectAddress = ""
+					}
+					cfg.Methods.OIDC.Method.Providers = map[string]AuthenticationMethodOIDCProvider{provider: p}
+				}
+				require.EqualError(t, cfg.validate(), "provider \""+provider+"\": field \""+field+"\": non-empty value is required")
+			})
+		}
+	}
+}
