+	function localProfilePath(url) {
+		const prefix = `${nconf.get('relative_path') || ''}/assets/uploads/profile/`;
+		if (typeof url !== 'string' || !url.startsWith(prefix)) {
+			return false;
+		}
+		const filename = url.slice(prefix.length);
+		if (!filename || filename === '.' || filename === '..' || path.basename(filename) !== filename || filename.includes('\\')) {
+			return false;
+		}
+		return path.join(nconf.get('upload_path'), 'profile', filename);
+	}
+
+	async function profilePaths(uid, type) {
+		if (!Number.isInteger(Number(uid)) || Number(uid) <= 0) {
+			return [];
+		}
+		const folder = path.join(nconf.get('upload_path'), 'profile');
+		let names;
+		try {
+			names = await fs.promises.readdir(folder);
+		} catch (err) {
+			if (err.code === 'ENOENT') {
+				return [];
+			}
+			throw err;
+		}
+		const pattern = new RegExp(`^${Number(uid)}-profile${type}(?:-\\d+)?\\.(?:png|jpeg|jpg|bmp)$`, 'i');
+		return names.filter(name => pattern.test(name)).map(name => path.join(folder, name));
+	}
+
+	async function getLocalPath(uid, field, type) {
+		const url = await User.getUserField(uid, field);
+		if (!localProfilePath(url)) {
+			return false;
+		}
+		return (await profilePaths(uid, type))[0] || false;
+	}
+
+	User.getLocalCoverPath = uid => getLocalPath(uid, 'cover:url', 'cover');
+	User.getLocalAvatarPath = uid => getLocalPath(uid, 'uploadedpicture', 'avatar');
+	User.deleteProfileImageFiles = async function (uid) {
+		const paths = (await Promise.all(['cover', 'avatar'].map(type => profilePaths(uid, type)))).flat();
+		await Promise.all(paths.map(file.delete));
+	};
+
+	User.removeProfileImage = async function (uid) {
+		const userData = await User.getUserFields(uid, ['uploadedpicture', 'picture']);
+		if (localProfilePath(userData.uploadedpicture)) {
+			await User.deleteProfileImageFilesForType(uid, 'avatar');
+		}
+		await User.setUserFields(uid, {
+			uploadedpicture: '',
+			picture: userData.uploadedpicture === userData.picture ? '' : userData.picture,
+		});
+		return userData;
+	};
+
+	User.deleteProfileImageFilesForType = async function (uid, type) {
+		await Promise.all((await profilePaths(uid, type)).map(file.delete));
+	};
