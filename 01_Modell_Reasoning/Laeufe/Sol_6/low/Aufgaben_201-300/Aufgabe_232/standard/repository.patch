+package config
+
+import "time"
+
+// EOL describes the support lifetime of an OS release.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return e.Ended || now.After(e.StandardSupportUntil)
+}
+
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+var eolDates = map[string]map[string][2]string{
+	Amazon:  {"2018.03": {"2023-06-30", "2023-06-30"}, "2 (Karoo)": {"2025-06-30", ""}},
+	RedHat:  {"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""}, "6": {"2020-11-30", "2024-06-30"}},
+	CentOS:  {"7": {"2024-06-30", ""}, "8": {"2021-12-31", ""}, "6": {"2020-11-30", "2020-11-30"}},
+	Oracle:  {"7": {"2024-06-30", ""}, "8": {"2029-05-31", ""}, "6": {"2021-03-31", "2022-03-31"}},
+	Ubuntu:  {"18.04": {"2023-05-31", "2028-04-30"}, "14.04": {"2019-04-30", "2024-04-30"}, "14.10": {"2015-07-30", "2015-07-30"}, "21.04": {"2022-01-30", ""}},
+	Debian:  {"9": {"2022-06-30", ""}, "10": {"2024-06-30", ""}, "8": {"2020-06-30", "2020-06-30"}},
+	Alpine:  {"3.10": {"2021-05-30", ""}, "3.11": {"2021-11-30", ""}, "3.12": {"2022-05-30", ""}, "3.9": {"2020-11-30", "2020-11-30"}},
+	FreeBSD: {"11": {"2021-09-30", "2021-09-30"}, "12": {"2023-12-31", ""}, "10": {"2019-10-30", "2019-10-30"}},
+}
+
+// GetEOL returns lifecycle dates for an exact family and release pair.
+func GetEOL(family, release string) (EOL, bool) {
+	dates, ok := eolDates[family][release]
+	if !ok {
+		return EOL{}, false
+	}
+	standard, _ := time.Parse("2006-01-02", dates[0])
+	var extended time.Time
+	if dates[1] != "" {
+		extended, _ = time.Parse("2006-01-02", dates[1])
+	}
+	return EOL{StandardSupportUntil: standard, ExtendedSupportUntil: extended}, true
+}
