+func TestNewWithClientEnvironment(t *testing.T) {
+	for _, tt := range []struct {
+		name, namespace, replica, missing string
+	}{
+		{name: "missing namespace", replica: "agent-0", missing: NamespaceEnv},
+		{name: "missing replica", namespace: "test", missing: teleportReplicaNameEnv},
+		{name: "configured", namespace: "test", replica: "agent-0"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv(teleportReplicaNameEnv, tt.replica)
+			t.Setenv(ReleaseNameEnv, "teleport")
+
+			b, err := NewWithClient(fake.NewSimpleClientset())
+			if tt.missing != "" {
+				require.EqualError(t, err, fmt.Sprintf("environment variable %q not set or empty", tt.missing))
+				require.Nil(t, b)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.namespace, b.Namespace)
+			require.Equal(t, tt.replica, b.ReplicaName)
+			require.Equal(t, "agent-0-state", b.SecretName)
+			require.Equal(t, "teleport", b.ReleaseName)
+		})
+	}
+}
