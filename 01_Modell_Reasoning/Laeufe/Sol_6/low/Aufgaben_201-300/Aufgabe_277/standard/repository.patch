+
+func TestRuleSegmentKeys(t *testing.T) {
+	for _, tc := range []struct {
+		keys          []string
+		key, operator string
+	}{
+		{[]string{"one"}, "one", ""},
+		{[]string{"one", "two"}, "one,two", flipt.SegmentOperator_AND_SEGMENT_OPERATOR.String()},
+	} {
+		got := NewRule(&flipt.Rule{SegmentKeys: tc.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR})
+		assert.Equal(t, tc.key, got.SegmentKey)
+		assert.Equal(t, tc.operator, got.SegmentOperator)
+	}
+}
+
+func TestRolloutSegmentKeys(t *testing.T) {
+	for _, tc := range []struct {
+		keys          []string
+		key, operator string
+	}{
+		{[]string{"one"}, "one", ""},
+		{[]string{"one", "two"}, "one,two", flipt.SegmentOperator_AND_SEGMENT_OPERATOR.String()},
+	} {
+		got := NewRollout(&flipt.Rollout{Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+			SegmentKeys: tc.keys, SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR, Value: true,
+		}}})
+		assert.Equal(t, tc.key, got.Segment.Key)
+		assert.Equal(t, tc.operator, got.Segment.Operator)
+		assert.True(t, got.Segment.Value)
+	}
+}
