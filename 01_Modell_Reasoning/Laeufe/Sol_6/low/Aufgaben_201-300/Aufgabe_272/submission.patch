+def test_make_context_ciphers():
+    from ansible.module_utils.urls import make_context
+    context = make_context(ciphers=['ECDHE-RSA-AES128-SHA256'], validate_certs=False)
+    assert any(cipher['name'] == 'ECDHE-RSA-AES128-SHA256' for cipher in context.get_ciphers())
+    assert context.verify_mode == 0
+
+
+def test_make_context_invalid_ciphers():
+    from ansible.module_utils.urls import make_context
+    import pytest
+    for value in ([], [4], 'NO_SUCH_CIPHER'):
+        with pytest.raises(ValueError, match='cipher'):
+            make_context(ciphers=value)
