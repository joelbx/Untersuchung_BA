+def make_context(cafile=None, cadata=None, ciphers=None, validate_certs=True):
+    """Build a TLS context shared by all HTTPS connection paths."""
+    if ciphers is not None:
+        if isinstance(ciphers, (list, tuple)) and ciphers and all(isinstance(item, str) and item for item in ciphers):
+            ciphers = ':'.join(ciphers)
+        elif not isinstance(ciphers, str) or not ciphers:
+            raise ValueError('ciphers must be a non-empty OpenSSL cipher string or list of strings')
+
+    if HAS_SSLCONTEXT:
+        context = create_default_context(cafile=cafile) if validate_certs else SSLContext(ssl.PROTOCOL_SSLv23)
+    elif HAS_URLLIB3_PYOPENSSLCONTEXT:
+        context = PyOpenSSLContext(PROTOCOL)
+    else:
+        raise NotImplementedError('Host libraries are too old to support creating an sslcontext')
+
+    if not validate_certs:
+        context.options |= ssl.OP_NO_SSLv2 | ssl.OP_NO_SSLv3
+        context.check_hostname = False
+        context.verify_mode = ssl.CERT_NONE
+    elif cafile or cadata:
+        context.load_verify_locations(cafile=cafile, cadata=cadata or None)
+
+    if ciphers is not None:
+        try:
+            context.set_ciphers(ciphers)
+        except (ValueError, ssl.SSLError):
+            raise ValueError('Invalid or unsupported TLS cipher configuration')
+    return context
+
