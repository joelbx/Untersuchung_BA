diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..82f83c6
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,59 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the current build and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release.
+func Is(version string) bool {
+	if version == "" || version == "dev" {
+		return false
+	}
+	lower := strings.ToLower(version)
+	return !strings.Contains(lower, "-snapshot") && !strings.Contains(lower, "-rc") && !strings.Contains(lower, "-dev")
+}
+
+// Check queries the latest published release. A failed query is logged and
+// returned so callers can continue startup without update information.
+func Check(ctx context.Context, version string) (info Info, checkErr error) {
+	defer func() {
+		if checkErr != nil {
+			zap.L().Warn("checking for updates", zap.Error(checkErr))
+		}
+	}()
+	info = Info{CurrentVersion: version}
+	client := github.NewClient(nil)
+	latest, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+	if err != nil {
+		return info, err
+	}
+	if latest == nil {
+		return info, nil
+	}
+	info.LatestVersion = latest.GetTagName()
+	info.LatestVersionURL = latest.GetHTMLURL()
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+	newest, err := semver.ParseTolerant(info.LatestVersion)
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+	info.UpdateAvailable = current.LT(newest)
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..63c8442
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,18 @@
+package release
+
+import "testing"
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"", false}, {"dev", false}, {"v1.2.3-dev", false},
+		{"v1.2.3-snapshot", false}, {"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false}, {"v1.2.3", true},
+	} {
+		if got := Is(tc.version); got != tc.want {
+			t.Errorf("Is(%q) = %v, want %v", tc.version, got, tc.want)
+		}
+	}
+}
