+func TestProxyHeaderAuthentication(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	previous := conf.Server.ReverseProxyWhitelist
+	defer func() { conf.Server.ReverseProxyWhitelist = previous }()
+	conf.Server.ReverseProxyWhitelist = "127.0.0.0/8"
+	r := httptest.NewRequest("GET", "/app/", nil)
+	r.RemoteAddr = "127.0.0.1:1234"
+	r.Header.Set("Remote-User", "alice")
+	payload := handleLoginFromHeaders(ds, r)
+	if payload == nil || payload["token"] == "" || payload["isAdmin"] != true {
+		t.Fatalf("invalid proxy payload: %v", payload)
+	}
+	r.RemoteAddr = "192.0.2.1:1234"
+	if handleLoginFromHeaders(ds, r) != nil {
+		t.Fatal("untrusted source authenticated")
+	}
+}
