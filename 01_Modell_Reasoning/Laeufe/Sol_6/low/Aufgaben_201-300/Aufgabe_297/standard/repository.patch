+func TestValidateIPAgainstList(t *testing.T) {
+	list := "invalid, 192.168.2.0/24, 2001:db8::/32, @"
+	for _, address := range []string{"192.168.2.4:1234", "[2001:db8::1]:3456", "@"} {
+		if !validateIPAgainstList(address, list) {
+			t.Errorf("expected %s to match", address)
+		}
+	}
+	for _, address := range []string{"192.168.3.4:1234", "[2001:db9::1]:3456"} {
+		if validateIPAgainstList(address, list) {
+			t.Errorf("unexpected match for %s", address)
+		}
+	}
+	if validateIPAgainstList("192.168.2.4:1234", "") {
+		t.Fatal("empty whitelist matched")
+	}
+}
