+// validateIPAgainstList accepts CIDR ranges and individual IP addresses.
+func validateIPAgainstList(address, list string) bool {
+	if strings.TrimSpace(list) == "" {
+		return false
+	}
+	if address == "@" || address == "" {
+		for _, entry := range strings.Split(list, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(address); err == nil {
+		address = host
+	}
+	ip := net.ParseIP(strings.Trim(address, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(list, ",") {
+		entry = strings.TrimSpace(entry)
+		if _, network, err := net.ParseCIDR(entry); err == nil && network.Contains(ip) {
+			return true
+		}
+		if allowed := net.ParseIP(entry); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	auth.Init(ds)
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			return nil
+		}
+		secret := make([]byte, 32)
+		if _, err = rand.Read(secret); err != nil {
+			return nil
+		}
+		user = &model.User{ID: uuid.NewString(), UserName: username, Name: strings.Title(username), NewPassword: hex.EncodeToString(secret), IsAdmin: count == 0}
+		if err = repo.Put(user); err != nil {
+			return nil
+		}
+		user, err = repo.FindByUsername(username)
+	}
+	if err != nil || user == nil {
+		return nil
+	}
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		return nil
+	}
+	if err := repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Could not update LastLoginAt", err)
+	}
+	saltBytes := make([]byte, 6)
+	if _, err = rand.Read(saltBytes); err != nil {
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	subsonicToken := fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt)))
+	return map[string]interface{}{"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name, "username": user.UserName, "token": token, "subsonicSalt": salt, "subsonicToken": subsonicToken}
+}
