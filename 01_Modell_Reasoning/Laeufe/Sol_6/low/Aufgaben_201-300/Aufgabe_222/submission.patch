 import pytest
 
-from ansible.cli.doc import DocCLI
+from ansible.cli.doc import DocCLI, RoleMixin
+
+
+@pytest.mark.parametrize('collection, expected_name', [('', 'role'), ('ns.coll', 'ns.coll.role')])
+def test_role_build_doc(collection, expected_name):
+    spec = {'main': {'short_description': 'Main', 'options': {'value': {'type': 'str'}}},
+            'other': None}
+    mixin = RoleMixin()
+
+    fqcn, doc = mixin._build_doc('role', '/role/path', collection, spec, entry_point='main')
+    assert fqcn == expected_name
+    assert doc == {'path': '/role/path', 'collection': collection,
+                   'entry_points': {'main': spec['main']}}
+    assert doc['entry_points']['main'] is spec['main']
+    assert mixin._build_doc('role', '/role/path', collection, spec, 'missing') == (expected_name, None)
+    assert mixin._build_doc('role', '/role/path', collection, {}) == (expected_name, None)
+    assert mixin._build_doc('role', '/role/path', collection, spec)[1]['entry_points'] == spec
 
 
