+def test_prioritized_identifier_deduplicates_and_serializes() -> None:
+    from datetime import datetime
+
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    isbn = PrioritizedIdentifier('9780747532699', timestamp=timestamp)
+    asin = PrioritizedIdentifier('B06XYHVXVJ', False, Priority.HIGH, timestamp)
+    duplicate = PrioritizedIdentifier('B06XYHVXVJ', priority=Priority.LOW)
+
+    assert len({isbn, asin, duplicate}) == 2
+    assert asin != isbn
+    assert asin.to_dict() == {
+        'identifier': 'B06XYHVXVJ',
+        'stage_import': False,
+        'priority': 'HIGH',
+        'timestamp': '2024-01-02T03:04:05',
+    }
+    assert json.loads(json.dumps(asin.to_dict())) == asin.to_dict()
+    assert PrioritizedISBN(isbn='9780747532699').identifier == isbn.identifier
+
