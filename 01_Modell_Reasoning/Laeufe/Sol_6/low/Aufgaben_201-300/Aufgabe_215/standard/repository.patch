new file mode 100644
index 0000000..dc41af0
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,43 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestConfigureHTTPS(t *testing.T) {
+	dir, err := os.MkdirTemp("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := os.WriteFile(path, []byte("test"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := filepath.Join(dir, "config.yml")
+	yaml := "server:\n  protocol: https\n  cert_file: " + cert + "\n  cert_key: " + key + "\ncors:\n  allowed_origins: foo.com\n"
+	if err := os.WriteFile(path, []byte(yaml), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.Protocol != HTTPS || cfg.Server.HTTPSPort != 443 || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("unexpected config: %+v", cfg)
+	}
+	if err := os.Remove(cert); err != nil {
+		t.Fatal(err)
+	}
+	_, err = configure(path)
+	if err == nil || !strings.Contains(err.Error(), "cannot find TLS cert_file") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
