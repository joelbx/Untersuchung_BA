+@pytest.mark.parametrize(
+    ('cover', 'expected'),
+    [
+        ('HTTP://IMAGES.EXAMPLE.COM/cover.jpg', 'HTTP://IMAGES.EXAMPLE.COM/cover.jpg'),
+        ('https://images.example.com/cover.jpg', 'https://images.example.com/cover.jpg'),
+        ('https://other.example.com/cover.jpg', None),
+        ('https://images.example.com.evil.org/cover.jpg', None),
+        ('ftp://images.example.com/cover.jpg', None),
+        ('not a URL', None),
+    ],
+)
+def test_process_cover_url(cover, expected):
+    edition = {'title': 'A book', 'cover': cover}
+    url, updated = process_cover_url(edition, ['Images.Example.Com'])
+    assert url == expected
+    assert updated is edition
+    assert edition == {'title': 'A book'}
+
