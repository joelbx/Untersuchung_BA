 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	for _, tt := range []struct {
+		name, fields                    string
+		summary, poc, introduced, fixed string
+		score                           float64
+	}{
+		{"enterprise", `,"description":"A detailed summary","poc":"https://example.org/poc","introduced_in":"5.0","fixed_in":"5.2","cvss":{"score":7.5,"vector":"CVSS:3.1/AV:N","severity":"HIGH"}`, "A detailed summary", "https://example.org/poc", "5.0", "5.2", 7.5},
+		{"basic", `,"description":null,"poc":null,"introduced_in":null,"fixed_in":null,"cvss":null`, "", "", "", "", 0},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"512":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06+02:00","vuln_type":"RCE","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.org/one","https://example.org/two"]}` + tt.fields + `}]}}`
+			got, err := convertToVinfos("core", body)
+			if err != nil || len(got) != 1 {
+				t.Fatalf("convertToVinfos: %v, records: %d", err, len(got))
+			}
+			v := got[0]
+			if len(v.CveContents[models.WpScan]) != 1 {
+				t.Fatalf("expected one WPScan content: %+v", v.CveContents)
+			}
+			c := v.CveContents[models.WpScan][0]
+			if v.CveID != "CVE-2024-1234" || c.CveID != v.CveID || c.Type != models.WpScan || v.VulnType != "RCE" || v.WpPackageFixStats[0].FixedIn != tt.fixed {
+				t.Fatalf("incorrect base fields: %+v", v)
+			}
+			if c.Published != time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC) || c.LastModified != time.Date(2024, 2, 3, 2, 5, 6, 0, time.UTC) {
+				t.Fatalf("incorrect timestamps: %+v", c)
+			}
+			if len(c.References) != 2 || c.References[0].Link != "https://example.org/one" || c.References[1].Link != "https://example.org/two" {
+				t.Fatalf("incorrect references: %+v", c.References)
+			}
+			if c.Summary != tt.summary || c.Optional == nil || c.Optional["poc"] != tt.poc || c.Optional["introduced_in"] != tt.introduced || c.Cvss3Score != tt.score {
+				t.Fatalf("incorrect enriched fields: %+v", c)
+			}
+			if tt.score == 0 && (len(c.Optional) != 0 || c.Cvss3Vector != "" || c.Cvss3Severity != "") {
+				t.Fatalf("unexpected basic fields: %+v", c)
+			}
+			if tt.score != 0 && (c.Cvss3Vector != "CVSS:3.1/AV:N" || c.Cvss3Severity != "HIGH") {
+				t.Fatalf("incorrect severity: %+v", c)
+			}
+		})
+	}
+}
