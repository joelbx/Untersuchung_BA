--- a/test/units/playbook/test_play.py
+++ b/test/units/playbook/test_play.py
@@ -31,6 +31,29 @@ from units.mock.path import mock_unfrackpath_noop
 
 class TestPlay(unittest.TestCase):
 
+    def test_hosts_derive_name_without_changing_input(self):
+        data = {'hosts': ['foo', 'bar']}
+        play = Play.load(data)
+        self.assertEqual(play.get_name(), 'foo,bar')
+        self.assertNotIn('name', data)
+        play.hosts = ['baz']
+        self.assertEqual(play.get_name(), 'baz')
+        self.assertEqual(Play.load({'name': 'explicit', 'hosts': ['foo']}).get_name(), 'explicit')
+
+    def test_invalid_hosts(self):
+        cases = [
+            (None, 'Hosts list cannot be empty'),
+            ([], 'Hosts list cannot be empty'),
+            ((), 'Hosts list cannot be empty'),
+            ([None], "Hosts list cannot contain values of 'None'"),
+            (['foo', {'bar': 'baz'}], "Hosts list contains an invalid host value"),
+            ({'foo': 'bar'}, 'Hosts list must be a sequence or string'),
+        ]
+        for hosts, message in cases:
+            with self.subTest(hosts=hosts):
+                with self.assertRaisesRegex(AnsibleParserError, message):
+                    Play.load({'hosts': hosts})
+
     def test_empty_play(self):
         p = Play.load(dict())
         self.assertEqual(str(p), '')
