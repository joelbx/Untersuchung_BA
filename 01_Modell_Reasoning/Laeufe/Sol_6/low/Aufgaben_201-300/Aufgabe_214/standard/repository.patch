+
+func setScanTechniques(conf *config.PortScanConf) ([]string, error) {
+	options := []string{}
+	for _, technique := range conf.GetScanTechniques() {
+		if technique == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique")
+		}
+		options = append(options, "-"+technique.String())
+	}
+	if len(options) == 0 {
+		options = append(options, "-sT")
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+func (l *base) execExternalPortScan(destinations map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if errs := conf.Validate(); len(errs) > 0 {
+		return nil, errs[0]
+	}
+	techniques, err := setScanTechniques(conf)
+	if err != nil {
+		return nil, err
+	}
+	found := []string{}
+	for ip, ports := range destinations {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		if len(ports) == 0 {
+			continue
+		}
+		args := append([]string{}, techniques...)
+		args = append(args, "-Pn", "-n", "-oX", "-", "-p", strings.Join(ports, ","))
+		if conf.SourcePort != "" {
+			args = append(args, "-g", conf.SourcePort)
+		}
+		args = append(args, ip)
+		output, err := osexec.Command(conf.ScannerBinPath, args...).CombinedOutput()
+		if err != nil {
+			return nil, fmt.Errorf("nmap scan of %s failed: %w: %s", ip, err, string(output))
+		}
+		var result struct {
+			Hosts []struct {
+				Addresses []struct {
+					Addr string `xml:"addr,attr"`
+				} `xml:"address"`
+				Ports []struct {
+					PortID string `xml:"portid,attr"`
+					State  struct {
+						State string `xml:"state,attr"`
+					} `xml:"state"`
+				} `xml:"ports>port"`
+			} `xml:"host"`
+		}
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, fmt.Errorf("invalid nmap XML: %w", err)
+		}
+		for _, host := range result.Hosts {
+			address := ip
+			if len(host.Addresses) > 0 {
+				address = host.Addresses[0].Addr
+			}
+			for _, port := range host.Ports {
+				if port.State.State == "open" {
+					found = append(found, net.JoinHostPort(address, port.PortID))
+				}
+			}
+		}
+	}
+	return found, nil
+}
