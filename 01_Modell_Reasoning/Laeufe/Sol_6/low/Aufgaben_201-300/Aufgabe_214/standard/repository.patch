diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..473e0be
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,96 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies an nmap TCP scan option.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+var scanOptions = map[ScanTechnique]string{
+	TCPSYN: "sS", TCPConnect: "sT", TCPACK: "sA", TCPWindow: "sW", TCPMaimon: "sM", TCPNull: "sN", TCPFIN: "sF", TCPXmas: "sX",
+}
+
+func (t ScanTechnique) String() string { return scanOptions[t] }
+
+// PortScanConf configures the optional scanner on the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+func (c *PortScanConf) GetScanTechniques() (result []ScanTechnique) {
+	for _, input := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for technique, option := range scanOptions {
+			if strings.EqualFold(input, option) {
+				found = technique
+				break
+			}
+		}
+		result = append(result, found)
+	}
+	return result
+}
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil || info.IsDir() {
+		errs = append(errs, fmt.Errorf("scannerBinPath is not a file: %s", c.ScannerBinPath))
+	}
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("multiple scan techniques are not supported"))
+	}
+	techniques := c.GetScanTechniques()
+	for i, t := range techniques {
+		if t == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("unsupported scan technique: %s", c.ScanTechniques[i]))
+		}
+		if t != NotSupportTechnique && t != TCPConnect && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("scan technique %s requires hasPrivileged", c.ScanTechniques[i]))
+		}
+		if t == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("sourcePort cannot be used with TCPConnect"))
+		}
+	}
+	if c.SourcePort != "" {
+		p, err := strconv.Atoi(c.SourcePort)
+		if err != nil || p < 0 || p > 65535 {
+			errs = append(errs, fmt.Errorf("sourcePort must be in [0,65535]: %s", c.SourcePort))
+		} else if p == 0 {
+			errs = append(errs, fmt.Errorf("sourcePort 0 is invalid"))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).Output()
+		if err != nil || (!strings.Contains(string(output), "cap_net_raw") && !strings.Contains(string(output), "cap_net_admin")) {
+			errs = append(errs, fmt.Errorf("scannerBinPath has missing or malformed network capabilities: %s", c.ScannerBinPath))
+		}
+	}
+	return errs
+}
