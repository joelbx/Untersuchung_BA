diff --git a/openlibrary/plugins/upstream/tests/test_addbook.py b/openlibrary/plugins/upstream/tests/test_addbook.py
index a644a09..6698acc 100644
--- a/openlibrary/plugins/upstream/tests/test_addbook.py
+++ b/openlibrary/plugins/upstream/tests/test_addbook.py
@@ -5,6 +5,36 @@ from openlibrary import accounts
 from openlibrary.mocks.mock_infobase import MockSite
 
 
+def test_make_work_without_authors():
+    for doc in ({'title': 'Untitled'}, {'author_key': ['OL1A']}, {'author_name': ['A']}, {'author_key': [], 'author_name': ['A']}):
+        work = addbook.make_work(doc)
+        assert isinstance(work, web.Storage)
+        assert work.authors == []
+        assert work.ia == []
+        assert work.first_publish_year is None
+        assert work.cover_url == '/images/icons/avatar_book-sm.png'
+        for key, value in doc.items():
+            assert work[key] == value
+
+
+def test_make_work_preserves_metadata_and_creates_authors():
+    web.ctx.site = MockSite()
+    doc = {
+        'title': 'Book',
+        'author_key': ['OL1A'],
+        'author_name': ['Writer'],
+        'cover_url': '/custom-cover.png',
+        'ia': ['item'],
+        'first_publish_year': 2000,
+    }
+    work = addbook.make_work(doc)
+    assert work.cover_url == doc['cover_url']
+    assert work.ia == doc['ia']
+    assert work.first_publish_year == doc['first_publish_year']
+    assert work.authors[0].key == '/authors/OL1A'
+    assert work.authors[0].name == 'Writer'
+
+
 def strip_nones(d):
     return {k: v for k, v in d.items() if v is not None}
 
