+// fieldsMap preserves the JSON representation used by the event writers.
+func fieldsMap(data []byte) map[string]interface{} {
+	var fields map[string]interface{}
+	_ = json.Unmarshal(data, &fields) // data was just marshaled from an event
+	return fields
+}
+
+func (e event) decodeFields(fields *events.EventFields) error {
+	if e.FieldsMap != nil {
+		data, err := json.Marshal(e.FieldsMap)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		return trace.Wrap(json.Unmarshal(data, fields))
+	}
+	return trace.Wrap(json.Unmarshal([]byte(e.Fields), fields))
+}
+
+// migrateFieldsWithRetry runs the resumable conversion under a distributed lock.
+func (l *Log) migrateFieldsWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		err := backend.RunWhileLocked(ctx, l.backend, fieldsMigrationLock, rfd24MigrationLockTTL, l.migrateFields)
+		if err == nil || ctx.Err() != nil {
+			return
+		}
+		l.WithError(err).Error("FieldsMap migration failed; retrying")
+		select {
+		case <-time.After(time.Minute):
+		case <-ctx.Done():
+		}
+	}
+}
+
+// migrateFields scans legacy rows in bounded pages. Each successful batch is durable,
+// so restarting the scan after an interruption resumes without rewriting converted rows.
+func (l *Log) migrateFields(ctx context.Context) error {
+	var startKey map[string]*dynamodb.AttributeValue
+	var migrated int
+	for {
+		if err := ctx.Err(); err != nil {
+			return trace.Wrap(err)
+		}
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName: aws.String(l.Tablename), ExclusiveStartKey: startKey,
+			ConsistentRead: aws.Bool(true), Limit: aws.Int64(DynamoBatchSize),
+			FilterExpression:         aws.String("attribute_exists(#fields) AND attribute_not_exists(#map)"),
+			ExpressionAttributeNames: map[string]*string{"#fields": aws.String("Fields"), "#map": aws.String("FieldsMap")},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		requests := make([]*dynamodb.WriteRequest, 0, len(out.Items))
+		for _, item := range out.Items {
+			legacy := item["Fields"]
+			if legacy == nil || legacy.S == nil {
+				return trace.BadParameter("event %v has invalid Fields attribute", item[keySessionID])
+			}
+			var fields map[string]interface{}
+			if err := json.Unmarshal([]byte(*legacy.S), &fields); err != nil || fields == nil {
+				return trace.BadParameter("event %v has invalid Fields JSON: %v", item[keySessionID], err)
+			}
+			mapped, err := dynamodbattribute.MarshalMap(fields)
+			if err != nil {
+				return trace.Wrap(err)
+			}
+			var restored map[string]interface{}
+			if err := dynamodbattribute.UnmarshalMap(mapped, &restored); err != nil {
+				return trace.Wrap(err)
+			}
+			if !reflect.DeepEqual(fields, restored) {
+				return trace.BadParameter("event %v FieldsMap conversion changed metadata", item[keySessionID])
+			}
+			item["FieldsMap"] = &dynamodb.AttributeValue{M: mapped}
+			delete(item, "Fields")
+			requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+		}
+		if len(requests) != 0 {
+			if err := l.uploadBatch(requests); err != nil {
+				return trace.Wrap(err)
+			}
+			migrated += len(requests)
+			l.Infof("Migrated %d events to FieldsMap", migrated)
+		}
+		startKey = out.LastEvaluatedKey
+		if startKey == nil {
+			return nil
+		}
+	}
+}
