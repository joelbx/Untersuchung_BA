+func (o *redhatBase) parseSourceRPM(fields []string) *models.SrcPackage {
+	if fields[5] == "(none)" {
+		return nil
+	}
+
+	n, v, r, err := splitFileName(fields[5])
+	if err != nil {
+		o.warns = append(o.warns, xerrors.Errorf("Failed to parse source rpm file %q: %w", fields[5], err))
+		return nil
+	}
+	if fields[1] != "0" && fields[1] != "(none)" && !strings.Contains(v, ":") {
+		v = fields[1] + ":" + v
+	}
+	return &models.SrcPackage{
+		Name:        n,
+		Version:     v + "-" + r,
+		Arch:        "src",
+		BinaryNames: []string{fields[0]},
+	}
+}
