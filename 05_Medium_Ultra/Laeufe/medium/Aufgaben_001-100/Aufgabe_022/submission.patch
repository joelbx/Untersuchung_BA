+func Test_redhatBase_parseInstalledPackagesWithUnparseableSource(t *testing.T) {
+	o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Alma, Release: "9"}, log: logging.NewIODiscardLogger()}}
+	bins, srcs, err := o.parseInstalledPackages(`elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm (none)
+bar 1 9 123a ia64 1:bar-9-123a.src.rpm`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := (models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"}); !reflect.DeepEqual(bins["elasticsearch"], want) {
+		t.Errorf("elasticsearch binary = %v, want %v", bins["elasticsearch"], want)
+	}
+	if want := (models.Package{Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64"}); !reflect.DeepEqual(bins["bar"], want) {
+		t.Errorf("bar binary = %v, want %v", bins["bar"], want)
+	}
+	if want := (models.SrcPackage{Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}}); !reflect.DeepEqual(srcs["bar"], want) {
+		t.Errorf("bar source = %v, want %v", srcs["bar"], want)
+	}
+	if _, ok := srcs["elasticsearch"]; ok {
+		t.Errorf("unexpected source package for elasticsearch: %v", srcs["elasticsearch"])
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("warnings = %v, want one warning for the source filename", o.warns)
+	}
+}
