+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_without_mode_warns_on_return(atomic_am, atomic_mocks, capfd, isolated_warnings):
+    atomic_am.argument_spec['mode'] = dict(type='raw')
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert atomic_am._created_files == {'/path/to/dest'}
+
+    atomic_am._return_formatted({})
+    output = json.loads(capfd.readouterr()[0])
+    assert output['warnings'] == [
+        "File '/path/to/dest' created with default permissions '600'. The previous default was '666'. Specify 'mode' to avoid this warning."
+    ]
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_set_mode_clears_new_file_warning(atomic_am, atomic_mocks, mocker, capfd, isolated_warnings):
+    atomic_am.argument_spec['mode'] = dict(type='raw')
+    atomic_am.params['mode'] = None
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    mocker.patch('os.lstat', return_value=mocker.Mock(st_mode=0o600))
+    atomic_am.set_mode_if_different('/path/to/dest', '0600', False)
+    assert not atomic_am._created_files
+
+    atomic_am._return_formatted({})
+    assert 'warnings' not in json.loads(capfd.readouterr()[0])
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
+def test_new_file_without_mode_argument_is_not_tracked(atomic_am, atomic_mocks):
+    atomic_mocks['path_exists'].return_value = False
+    atomic_am.selinux_enabled.return_value = False
+
+    atomic_am.atomic_move('/path/to/src', '/path/to/dest')
+    assert not atomic_am._created_files
+
+
+@pytest.mark.parametrize('stdin', [{}], indirect=['stdin'])
