+++ b/internal/config/authentication_test.go
@@ -0,0 +1,34 @@
+package config
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationSessionDomainValidation(t *testing.T) {
+	for _, tc := range []struct {
+		name, domain, want string
+	}{
+		{"scheme and port", "http://localhost:8080", "localhost"},
+		{"secure scheme and port", "https://auth.example.com:8443", "auth.example.com"},
+		{"host and port", "auth.example.com:8080", "auth.example.com"},
+		{"hostname", "auth.example.com", "auth.example.com"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := AuthenticationConfig{Session: AuthenticationSession{Domain: tc.domain}}
+			c.Methods.OIDC.Enabled = true
+			require.NoError(t, c.validate())
+			require.Equal(t, tc.want, c.Session.Domain)
+		})
+	}
+
+	t.Run("invalid URL", func(t *testing.T) {
+		c := AuthenticationConfig{Session: AuthenticationSession{Domain: "http://bad%host"}}
+		c.Methods.OIDC.Enabled = true
+		err := c.validate()
+		require.Error(t, err)
+		require.True(t, strings.Contains(err.Error(), "authentication.session.domain"))
+	})
+}
