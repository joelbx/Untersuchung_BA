--- a/internal/server/authz/authz.go
+++ b/internal/server/authz/authz.go
@@ -1,8 +1,40 @@
 package authz
 
-import "context"
+import (
+	"context"
+	"fmt"
+)
+
+type contextKey int
+
+// NamespacesKey stores the namespaces a requester may view.
+const NamespacesKey contextKey = iota
+
+// FormatNamespaces validates a namespace decision returned by an OPA engine.
+func FormatNamespaces(result any) ([]string, error) {
+	if result == nil {
+		return nil, fmt.Errorf("viewable namespaces decision is undefined")
+	}
+	if namespaces, ok := result.([]string); ok {
+		return namespaces, nil
+	}
+	values, ok := result.([]any)
+	if !ok {
+		return nil, fmt.Errorf("viewable namespaces decision must be a list of strings, got %T", result)
+	}
+	namespaces := make([]string, 0, len(values))
+	for _, value := range values {
+		namespace, ok := value.(string)
+		if !ok {
+			return nil, fmt.Errorf("viewable namespaces decision contains %T, expected string", value)
+		}
+		namespaces = append(namespaces, namespace)
+	}
+	return namespaces, nil
+}
 
 type Verifier interface {
 	IsAllowed(ctx context.Context, input map[string]any) (bool, error)
+	Namespaces(ctx context.Context, input map[string]any) ([]string, error)
 	Shutdown(ctx context.Context) error
 }
