 	"github.com/navidrome/navidrome/log"
 )
 
 var (
-	instances    = make(map[string]interface{})
-	getOrCreateC = make(chan *entry, 1)
+	instances        = make(map[string]interface{})
+	getOrCreateC     = make(chan *entry, 1)
+	genericInstances sync.Map
 )
 
+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// Each exact type, including pointer types, has its own instance.
+func GetInstance[T any](constructor func() T) T {
+	type instance struct {
+		once  sync.Once
+		value T
+	}
+	key := reflect.TypeOf((*T)(nil)).Elem()
+	cached, _ := genericInstances.LoadOrStore(key, &instance{})
+	entry := cached.(*instance)
+	entry.once.Do(func() { entry.value = constructor() })
+	return entry.value
+}
+
 type entry struct {
 	constructor func() interface{}
 	object      interface{}
