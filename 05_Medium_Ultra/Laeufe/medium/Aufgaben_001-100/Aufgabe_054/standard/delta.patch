 		Expect(numInstances).To(Equal(1))
 	})
 })
+
+func TestGetInstanceValueAndPointerTypes(t *testing.T) {
+	type value struct{ id int }
+	valueCalls := 0
+	first := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 1}
+	})
+	second := singleton.GetInstance(func() value {
+		valueCalls++
+		return value{id: 2}
+	})
+	if first != (value{id: 1}) || second != first || valueCalls != 1 {
+		t.Fatalf("value singleton: first=%v second=%v constructor calls=%d", first, second, valueCalls)
+	}
+
+	pointerCalls := 0
+	pointer := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 3}
+	})
+	again := singleton.GetInstance(func() *value {
+		pointerCalls++
+		return &value{id: 4}
+	})
+	if pointer != again || pointer.id != 3 || pointerCalls != 1 {
+		t.Fatalf("pointer singleton: first=%p second=%p constructor calls=%d", pointer, again, pointerCalls)
+	}
+}
+
+func TestGetInstanceConcurrent(t *testing.T) {
+	type value struct{ id int }
+	const calls = 20_000
+	var constructorCalls int32
+	results := make([]*value, calls)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(calls)
+	for i := range results {
+		go func(i int) {
+			defer done.Done()
+			<-start
+			results[i] = singleton.GetInstance(func() *value {
+				atomic.AddInt32(&constructorCalls, 1)
+				return &value{id: 42}
+			})
+		}(i)
+	}
+	close(start)
+	done.Wait()
+	if atomic.LoadInt32(&constructorCalls) != 1 {
+		t.Fatalf("constructor called %d times, want 1", atomic.LoadInt32(&constructorCalls))
+	}
+	for i, result := range results {
+		if result == nil || result != results[0] || result.id != 42 {
+			t.Fatalf("result %d = %p, want %p with id 42", i, result, results[0])
+		}
+	}
+}
