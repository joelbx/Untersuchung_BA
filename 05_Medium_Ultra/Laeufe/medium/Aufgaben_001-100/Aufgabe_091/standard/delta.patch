+func TestValidate_ConstraintList(t *testing.T) {
+	for _, tt := range []struct {
+		name, value string
+		typ         ComparisonType
+		want        error
+	}{
+		{"string valid", `["a","b"]`, ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"number valid", `[1,2.5]`, ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"string at limit", `[` + strings.Join(makeStringItems(100), ",") + `]`, ComparisonType_STRING_COMPARISON_TYPE, nil},
+		{"number at limit", `[` + strings.Join(makeNumberItems(100), ",") + `]`, ComparisonType_NUMBER_COMPARISON_TYPE, nil},
+		{"string over limit", `[` + strings.Join(makeStringItems(101), ",") + `]`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`too many values provided for property "color" of type string (maximum 100)`)},
+		{"number over limit", `[` + strings.Join(makeNumberItems(101), ",") + `]`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`too many values provided for property "color" of type number (maximum 100)`)},
+		{"string mixed", `["a",1]`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"number mixed", `[1,"2"]`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+		{"string null", `[null]`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"number null", `[null]`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+		{"not array", `null`, ComparisonType_STRING_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type string`)},
+		{"malformed", `[1,`, ComparisonType_NUMBER_COMPARISON_TYPE, errors.ErrInvalid(`invalid value provided for property "color" of type number`)},
+	} {
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			t.Run(tt.name+"/"+operator, func(t *testing.T) {
+				create := &CreateConstraintRequest{SegmentKey: "segment", Property: "color", Type: tt.typ, Operator: operator, Value: tt.value}
+				update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "color", Type: tt.typ, Operator: operator, Value: tt.value}
+				assert.Equal(t, tt.want, create.Validate())
+				assert.Equal(t, tt.want, update.Validate())
+			})
+		}
+	}
+	for _, typ := range []ComparisonType{ComparisonType_BOOLEAN_COMPARISON_TYPE, ComparisonType_DATETIME_COMPARISON_TYPE} {
+		for _, operator := range []string{OpIsOneOf, OpIsNotOneOf} {
+			create := &CreateConstraintRequest{SegmentKey: "segment", Property: "color", Type: typ, Operator: operator, Value: `[]`}
+			update := &UpdateConstraintRequest{Id: "id", SegmentKey: "segment", Property: "color", Type: typ, Operator: operator, Value: `[]`}
+			assert.Error(t, create.Validate())
+			assert.Error(t, update.Validate())
+		}
+	}
+}
