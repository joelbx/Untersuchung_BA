+func Test_matchesStringList(t *testing.T) {
+	for _, tt := range []struct {
+		name, operator, list, value string
+		want                        bool
+	}{
+		{"one of match", flipt.OpIsOneOf, `["red","blue"]`, "blue", true},
+		{"one of miss", flipt.OpIsOneOf, `["red","blue"]`, "green", false},
+		{"not one of match", flipt.OpIsNotOneOf, `["red","blue"]`, "green", true},
+		{"not one of miss", flipt.OpIsNotOneOf, `["red","blue"]`, "red", false},
+		{"invalid list", flipt.OpIsOneOf, `["red",3]`, "red", false},
+		{"invalid list inverted", flipt.OpIsNotOneOf, `bad`, "red", true},
+		{"empty string element", flipt.OpIsOneOf, `[""]`, "", true},
+		{"null element", flipt.OpIsOneOf, `["red",null]`, "red", false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, matchesString(storage.EvaluationConstraint{Operator: tt.operator, Value: tt.list}, tt.value))
+		})
+	}
+}
