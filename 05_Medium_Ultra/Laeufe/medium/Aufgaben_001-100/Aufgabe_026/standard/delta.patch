+func TestUbuntuAPIInfo(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		Ubuntu:    {{Type: Ubuntu, Summary: "Ubuntu OVAL", Cvss3Severity: "LOW"}},
+		UbuntuAPI: {{Type: UbuntuAPI, Summary: "Ubuntu API", Cvss3Severity: "NEGLIGIBLE"}},
+		Nvd:       {{Type: Nvd, Summary: "NVD"}},
+	}}
+	titles := v.Titles("en", "ubuntu")
+	if len(titles) < 3 || titles[1].Type != Ubuntu || titles[2].Type != UbuntuAPI {
+		t.Errorf("title order: %v", titles)
+	}
+	summaries := v.Summaries("en", "ubuntu")
+	if len(summaries) < 3 || summaries[0].Type != Ubuntu || summaries[1].Type != UbuntuAPI {
+		t.Errorf("summary order: %v", summaries)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 || scores[1].Type != UbuntuAPI || scores[1].Value.Score != 3.9 || !scores[1].Value.CalculatedBySeverity {
+		t.Errorf("CVSS scores: %v", scores)
+	}
+	if got := severityToCvssScoreRange("NEGLIGIBLE"); got != "0.1-3.9" {
+		t.Errorf("negligible range: %s", got)
+	}
+}
