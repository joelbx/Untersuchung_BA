+func referenceErrors(file string, doc *yamlv3.Node) []error {
+	var issues []error
+	add := func(message string, n *yamlv3.Node) {
+		issues = append(issues, Error{Message: message, Location: Location{File: file, Line: n.Line, Column: n.Column}})
+	}
+	segments := map[string]bool{}
+	for _, s := range items(field(doc, "segments")) {
+		segments[value(field(s, "key"))] = true
+	}
+	ns := value(field(doc, "namespace"))
+	if ns == "" {
