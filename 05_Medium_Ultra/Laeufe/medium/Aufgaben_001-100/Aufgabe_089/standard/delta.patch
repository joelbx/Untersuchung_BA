+				if variant != nil && !variants[variant.Value] {
+					add(fmt.Sprintf("flag %s rule %d references unknown variant %q", name, i+1, variant.Value), variant)
+				}
+			}
+		}
+		for i, rollout := range items(field(flag, "rollouts")) {
+			checkSegment(field(rollout, "segment"), i+1)
+		}
+	}
