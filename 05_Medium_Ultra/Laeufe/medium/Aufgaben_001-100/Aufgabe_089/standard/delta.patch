+
+func TestSnapshotRejectsUnknownReferences(t *testing.T) {
+	files := fstest.MapFS{
+		"features.yaml": &fstest.MapFile{Data: []byte(`flags:
+- key: flag
+  name: Flag
+  variants: []
+  rules:
+  - segment: missing
+    distributions: []
+segments: []
+`)},
+	}
+	_, err := SnapshotFromPaths(files, "features.yaml")
+	require.ErrorContains(t, err, "validation failed")
+	issues, ok := cue.Unwrap(err)
+	require.True(t, ok)
+	require.Len(t, issues, 1)
+	assert.Equal(t, `flag default/flag rule 1 references unknown segment "missing" (features.yaml 6:14)`, issues[0].Error())
+	_, err = SnapshotFromFS(zap.NewNop(), files)
+	require.ErrorContains(t, err, `validation failed`)
+}
