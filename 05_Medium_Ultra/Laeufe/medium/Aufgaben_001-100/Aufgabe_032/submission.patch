+    @pytest.mark.parametrize('module_source,limit,expected_failure,auto_cleanup', [
+        ('print("{\\"rc\\": 0}")', 5, False, False),
+        ('print("{\\"rc\\": 0}")', 5, False, True),
+        ('import time; time.sleep(10)', 1, True, False),
+    ])
+    def test_job_lifecycle(self, module_source, limit, expected_failure, auto_cleanup):
+        workdir = tempfile.mkdtemp()
+        try:
+            module_dir = os.path.join(workdir, 'ansible-tmp-module') if auto_cleanup else workdir
+            if auto_cleanup:
+                os.mkdir(module_dir)
+            module_path = os.path.join(module_dir, 'module.py')
+            with open(module_path, 'w') as module_file:
+                module_file.write('#!%s\n%s\n' % (sys.executable, module_source))
+            async_dir = os.path.join(workdir, 'jobs')
+            env = os.environ.copy()
+            env['ANSIBLE_ASYNC_DIR'] = async_dir
+            env['PYTHONPATH'] = os.path.join(os.path.dirname(async_wrapper.__file__), '..', '..')
+            output = subprocess.check_output([sys.executable, '-c',
+                                              'from ansible.modules.async_wrapper import main; main()',
+                                              'test', str(limit), module_path, '_'], env=env)
+            immediate = json.loads(output)
+            assert immediate['started'] == 1
+            assert immediate['finished'] == 0
+            assert immediate['_ansible_suppress_tmpdir_delete'] is auto_cleanup
+            path = immediate['results_file']
+            deadline = time.time() + limit + 5
+            while time.time() < deadline:
+                if os.path.exists(path):
+                    with open(path) as result_file:
+                        result = json.load(result_file)
+                    if result['finished']:
+                        break
+                time.sleep(0.05)
+            else:
+                pytest.fail('async job did not finish')
+            assert result['ansible_job_id'] == immediate['ansible_job_id']
+            assert result['started'] == 1
+            if expected_failure:
+                assert result['failed']
+                assert result['child_pid'] > 0
+                assert 'time limit' in result['msg']
+            else:
+                assert result['rc'] == 0
+            if auto_cleanup:
+                deadline = time.time() + 5
+                while os.path.exists(module_dir) and time.time() < deadline:
+                    time.sleep(0.05)
+                assert not os.path.exists(module_dir)
+        finally:
+            shutil.rmtree(workdir)
+
+    @pytest.mark.parametrize('failure_at', ['directory', 'fork'])
+    def test_startup_failure_is_json(self, monkeypatch, capsys, tmpdir, failure_at):
+        jobdir = str(tmpdir.join('jobs'))
+        monkeypatch.setenv('ANSIBLE_ASYNC_DIR', jobdir)
+        monkeypatch.setattr(sys, 'argv', ['async_wrapper', 'test', '5', '/module', '_'])
+
+        def fail(*args):
+            raise OSError('simulated %s failure' % failure_at)
+
+        if failure_at == 'directory':
+            monkeypatch.setattr(async_wrapper, '_make_temp_dir', fail)
+        else:
+            monkeypatch.setattr(async_wrapper.os, 'fork', fail)
+
+        with pytest.raises(SystemExit) as exc:
+            async_wrapper.main()
+        assert exc.value.code == 1
+        response = json.loads(capsys.readouterr().out)
+        assert response['failed'] is True
+        assert response['finished'] == 1
+        assert response['ansible_job_id'].startswith('test.')
+        assert failure_at in response['msg']
+        if failure_at == 'fork':
+            with open(os.path.join(jobdir, response['ansible_job_id'])) as result_file:
+                assert json.load(result_file) == response
+
+    def test_invalid_time_limit_is_json(self, monkeypatch, capsys):
