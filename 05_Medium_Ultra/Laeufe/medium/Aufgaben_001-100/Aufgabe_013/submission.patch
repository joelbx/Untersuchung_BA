 display = Display()
 
+_TTY_MACRO = re.compile(r'(?<!\w)(?:([IBMUC])\(([^)]+)\)|([LR])\(([^,()]+),[ \t]*([^)]+)\)|HORIZONTALLINE(?!\w))')
+
 
 def jdump(text):
     try:
@@ -71,6 +74,26 @@ class DocCLI(CLI):
     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
 
+    @classmethod
+    def tty_ify(cls, text):
+        def replace(match):
+            macro = match.group(1) or match.group(3)
+            if macro is None:
+                return '\n-------------\n'
+
+            value = match.group(2) if match.group(1) else match.group(4)
+            if macro in ('I', 'C'):
+                return "`%s'" % value
+            if macro == 'B':
+                return '*%s*' % value
+            if macro == 'M':
+                return '[%s]' % value
+            if macro == 'L':
+                return '%s <%s>' % (value, match.group(5))
+            return value
+
+        return _TTY_MACRO.sub(replace, text)
+
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
