diff --git a/lib/auth/u2f_challenge_test.go b/lib/auth/u2f_challenge_test.go
new file mode 100644
index 0000000..12d9473
--- /dev/null
+++ b/lib/auth/u2f_challenge_test.go
@@ -0,0 +1,53 @@
+package auth
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/u2f"
+)
+
+func TestU2FAuthenticateChallengeCompatibility(t *testing.T) {
+	legacy := u2f.AuthenticateChallenge{
+		Challenge: "challenge",
+		KeyHandle: "first",
+		AppID:     "https://example.com",
+	}
+	oldJSON, err := json.Marshal(legacy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fromOld U2FAuthenticateChallenge
+	if err := json.Unmarshal(oldJSON, &fromOld); err != nil {
+		t.Fatal(err)
+	}
+	if got := fromOld.DeviceChallenges(); len(got) != 1 || got[0].KeyHandle != legacy.KeyHandle {
+		t.Fatalf("legacy response returned challenges %+v", got)
+	}
+
+	combined := U2FAuthenticateChallenge{
+		AuthenticateChallenge: &legacy,
+		Challenges: []u2f.AuthenticateChallenge{
+			legacy,
+			{Challenge: "challenge", KeyHandle: "second", AppID: legacy.AppID},
+		},
+	}
+	newJSON, err := json.Marshal(combined)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var oldClient u2f.AuthenticateChallenge
+	if err := json.Unmarshal(newJSON, &oldClient); err != nil {
+		t.Fatal(err)
+	}
+	if oldClient.KeyHandle != legacy.KeyHandle {
+		t.Fatalf("old client received challenge %+v", oldClient)
+	}
+	var newClient U2FAuthenticateChallenge
+	if err := json.Unmarshal(newJSON, &newClient); err != nil {
+		t.Fatal(err)
+	}
+	if got := newClient.DeviceChallenges(); len(got) != 2 || got[1].KeyHandle != "second" {
+		t.Fatalf("new client received challenges %+v", got)
+	}
+}
