+            add_parents(locator.name_parts)
+            add(resolved, locator.source, locator.path)
+            if locator.redirected:
+                target = tuple(locator.redirect_target.split('.'))
+                if target[:2] == ('ansible', 'module_utils'):
+                    target_locator = LegacyModuleUtilLocator(target, mu_paths=mu_paths)
+                else:
+                    target_locator = CollectionModuleUtilLocator(target)
+                if not target_locator.found:
+                    raise AnsibleError('Could not find imported module support code for %s. Looked for (%s)' %
+                                       (current_fqn, target_locator.candidate_names_joined()))
+                add_parents(target_locator.name_parts)
+                add(target_locator.name_parts + (('__init__',) if target_locator.is_package else ()),
+                    target_locator.source, target_locator.path)
+    py_module_cache.clear()
 
