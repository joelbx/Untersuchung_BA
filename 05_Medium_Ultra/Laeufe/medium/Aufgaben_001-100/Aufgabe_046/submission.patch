+import ast
+import types
+import zipfile
+from io import BytesIO
+
+import pytest
+
+from ansible.errors import AnsibleError
+from ansible.executor import module_common as mc
+
+
+def test_package_initializer_relative_imports():
+    finder = mc.ModuleDepFinder('ansible_collections.ns.coll.plugins.module_utils.pkg.__init__')
+    finder.visit(ast.parse('from .submod import X\nfrom ..cousin.submod import Y'))
+    assert ('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'pkg', 'submod', 'X') in finder.submodules
+    assert ('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'cousin', 'submod', 'Y') in finder.submodules
+
+
+def test_collection_payload_redirect_and_missing_package_inits(tmp_path, monkeypatch):
+    root = tmp_path / 'collection'
+    (root / 'plugins' / 'module_utils' / 'pkg' / 'nested').mkdir(parents=True)
+    (root / 'plugins' / 'module_utils' / 'pkg' / '__init__.py').write_text('from .nested import thing\n')
+    (root / 'plugins' / 'module_utils' / 'pkg' / 'nested' / 'thing.py').write_text('VALUE = 1\n')
+    package = types.SimpleNamespace(__path__=[str(root)])
+    monkeypatch.setattr(mc, 'import_module', lambda name: package)
+    monkeypatch.setattr(mc, '_get_collection_metadata', lambda name: {
+        'plugin_routing': {'module_utils': {'old': {'redirect': 'ns.coll.pkg.nested.thing'},
+                                            'alias': {'redirect': 'ns.coll.pkg'}}}
+    })
+    output = BytesIO()
+    with zipfile.ZipFile(output, 'w') as zf:
+        mc.recursive_finder('test', 'test',
+                            b'import ansible_collections.ns.coll.plugins.module_utils.old\n'
+                            b'import ansible_collections.ns.coll.plugins.module_utils.alias.nested.thing\n',
+                            set(), {}, zf)
+    with zipfile.ZipFile(BytesIO(output.getvalue())) as zf:
+        prefix = 'ansible_collections/ns/coll/plugins/module_utils/'
+        assert prefix + 'old.py' in zf.namelist()
+        assert b'ansible_collections.ns.coll.plugins.module_utils.pkg.nested.thing' in zf.read(prefix + 'old.py')
+        assert prefix + 'pkg/__init__.py' in zf.namelist()
+        assert prefix + 'pkg/nested/__init__.py' in zf.namelist()
+        assert prefix + 'pkg/nested/thing.py' in zf.namelist()
+        assert prefix + 'alias/__init__.py' in zf.namelist()
+        assert prefix + 'alias/nested/__init__.py' in zf.namelist()
+        assert prefix + 'alias/nested/thing.py' in zf.namelist()
+        assert 'ansible/__init__.py' in zf.namelist()
+        assert 'ansible/module_utils/__init__.py' in zf.namelist()
+
+
+def test_redirect_tombstone_and_missing_collection(monkeypatch):
+    parts = ('ansible_collections', 'ns', 'coll', 'plugins', 'module_utils', 'gone')
+    monkeypatch.setattr(mc, 'import_module', lambda name: types.SimpleNamespace(__path__=[]))
+    monkeypatch.setattr(mc, '_get_collection_metadata', lambda name: {
+        'plugin_routing': {'module_utils': {'gone': {'tombstone': {
+            'warning_text': 'gone forever', 'removal_version': '2.0'}}}}
+    })
+    with pytest.raises(AnsibleError, match='gone forever'):
+        mc.CollectionModuleUtilLocator(parts)
+    def missing(name):
+        raise ImportError(name)
+    monkeypatch.setattr(mc, 'import_module', missing)
+    with pytest.raises(AnsibleError, match='unable to locate collection ns.coll'):
+        mc.CollectionModuleUtilLocator(parts)
+
+
+def test_redirect_emits_deprecation_metadata(mocker):
+    warn = mocker.patch.object(mc.display, 'deprecated')
+    parts = ('ansible', 'module_utils', 'old_basic')
+    result = mc._redirect_result({'redirect': 'ansible.module_utils.basic',
+                                  'deprecation': {'warning_text': 'use basic',
+                                                  'removal_version': '3.0',
+                                                  'removal_date': '2027-01-01'}},
+                                 parts, 'ansible.builtin')
+    assert result[3] == 'ansible.module_utils.basic'
+    warn.assert_called_once_with('use basic', version='3.0', date='2027-01-01',
+                                 collection_name='ansible.builtin')
