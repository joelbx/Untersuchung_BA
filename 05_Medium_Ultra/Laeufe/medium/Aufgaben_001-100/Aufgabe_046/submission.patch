+def recursive_finder(name, module_fqn, data, py_module_names, py_module_cache, zf):
+    """Build the transitive module_utils payload with an iterative work queue."""
+    mu_paths = [p for p in module_utils_loader._get_paths(subdirs=False) if os.path.isdir(p)] + [_MODULE_UTILS_PATH]
+    queued = deque([(name, module_fqn, data)])
+    written = set(zf.namelist())
 
+    def add(parts, source, path, scan=True):
+        if parts in py_module_names:
+            return
+        filename = os.path.join(*parts) + '.py'
+        py_module_names.add(parts)
+        if filename not in written:
+            zf.writestr(filename, source)
+            written.add(filename)
+        display.vvvvv('Using module_utils file %s' % to_text(path, errors='surrogate_or_strict'))
+        if scan:
+            queued.append((parts[-1], '.'.join(parts), source))
+
+    # These files are part of every payload, including callers that start with an empty cache.
+    for parts in (('ansible', '__init__'), ('ansible', 'module_utils', '__init__')):
+        filename = os.path.join(*parts) + '.py'
+        if filename not in written:
+            source = py_module_cache.get(parts, (b'', filename))[0]
+            zf.writestr(filename, source)
+            written.add(filename)
+        py_module_names.add(parts)
+
+    def add_parents(parts):
+        for size in range(1, len(parts)):
+            parent = parts[:size] + ('__init__',)
+            if parent in py_module_names:
+                continue
+            source, path = b'', os.path.join(*parent) + '.py'
+            if parts[0] == 'ansible' and size > 2:
+                relative = parts[2:size]
+                try:
+                    info = ModuleInfo(relative[-1], [os.path.join(p, *relative[:-1]) for p in mu_paths])
+                    if info.pkg_dir:
+                        source, path = info.get_source(), info.path
+                except ImportError:
+                    pass
+            elif parts[0] == 'ansible_collections' and size > 5:
+                locator = CollectionModuleUtilLocator(parts[:size])
+                if locator.found and locator.is_package:
+                    source, path = locator.source, locator.path
