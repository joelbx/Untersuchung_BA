diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..6e109c4
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,34 @@
+package config
+
+import "testing"
+
+func TestAuthenticationDatabaseRequirements(t *testing.T) {
+	var cfg AuthenticationConfig
+	for _, info := range cfg.Methods.AllMethods() {
+		if got, want := info.RequiresDatabase, info.Name() != "jwt"; got != want {
+			t.Errorf("%s RequiresDatabase = %t, want %t", info.Name(), got, want)
+		}
+	}
+
+	schedule := &AuthenticationCleanupSchedule{}
+	cfg.Methods.JWT.Enabled = true
+	cfg.Methods.JWT.Cleanup = schedule
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("JWT alone should not require database or cleanup")
+	}
+
+	cfg.Methods.Token.Cleanup = schedule
+	if cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("disabled token method should not require database or cleanup")
+	}
+
+	cfg.Methods.Token.Enabled = true
+	if !cfg.RequiresDatabase() || !cfg.ShouldRunCleanup() {
+		t.Fatal("enabled token method with cleanup should require both")
+	}
+
+	cfg.Methods.Token.Cleanup = nil
+	if !cfg.RequiresDatabase() || cfg.ShouldRunCleanup() {
+		t.Fatal("token without cleanup should only require database")
+	}
+}
