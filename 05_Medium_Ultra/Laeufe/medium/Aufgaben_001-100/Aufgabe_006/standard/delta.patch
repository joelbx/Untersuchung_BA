+package fanoutbuffer
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jonboulle/clockwork"
+)
+
+func TestFanoutAndOverflow(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 2})
+	a, c := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2, 3, 4, 5)
+	for _, cursor := range []*Cursor[int]{a, c} {
+		got := make([]int, 5)
+		n, err := cursor.TryRead(got[:3])
+		if err != nil || n != 3 {
+			t.Fatalf("first read: n=%d err=%v", n, err)
+		}
+		m, err := cursor.TryRead(got[3:])
+		if err != nil || m != 2 || !reflect.DeepEqual(got, []int{1, 2, 3, 4, 5}) {
+			t.Fatalf("read: n=%d err=%v items=%v", m, err, got)
+		}
+	}
+	if b.base != b.next || b.overflow != nil {
+		t.Fatal("consumed items retained")
+	}
+	b.Close()
+}
+
+func TestGraceAndClose(t *testing.T) {
+	clock := clockwork.NewFakeClock()
+	b := NewBuffer[int](Config{Capacity: 1, GracePeriod: time.Second, Clock: clock})
+	slow, fast := b.NewCursor(), b.NewCursor()
+	b.Append(1, 2)
+	got := make([]int, 2)
+	if n, err := fast.TryRead(got); n != 2 || err != nil {
+		t.Fatalf("fast read: %d %v", n, err)
+	}
+	clock.Advance(time.Second)
+	if _, err := slow.TryRead(got); !errors.Is(err, ErrGracePeriodExceeded) {
+		t.Fatalf("slow read: %v", err)
+	}
+	b.Append(3)
+	if n, err := fast.TryRead(got); n != 1 || err != nil || got[0] != 3 {
+		t.Fatalf("fast follow-up: %d %v %v", n, err, got)
+	}
+	if err := fast.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fast.TryRead(got); !errors.Is(err, ErrUseOfClosedCursor) {
+		t.Fatalf("closed cursor: %v", err)
+	}
+	b.Close()
+	if _, err := slow.TryRead(got); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("closed buffer: %v", err)
+	}
+}
+
+func TestConcurrentBlockingReaders(t *testing.T) {
+	b := NewBuffer[int](Config{Capacity: 8})
+	const readers, count = 8, 300
+	cursors := make([]*Cursor[int], readers)
+	for i := range cursors {
+		cursors[i] = b.NewCursor()
+	}
+	var wg sync.WaitGroup
+	for _, cursor := range cursors {
+		wg.Add(1)
+		go func(c *Cursor[int]) {
+			defer wg.Done()
+			out := make([]int, 17)
+			for want := 0; want < count; {
+				n, err := c.Read(context.Background(), out)
+				if err != nil {
+					t.Errorf("read: %v", err)
+					return
+				}
+				for _, v := range out[:n] {
+					if v != want {
+						t.Errorf("got %d want %d", v, want)
+						return
+					}
+					want++
+				}
+			}
+		}(cursor)
+	}
+	for i := 0; i < count; i++ {
+		b.Append(i)
+	}
+	wg.Wait()
+	b.Close()
+}
+
+func TestBlockingReadLifecycle(t *testing.T) {
+	b := NewBuffer[int](Config{})
+	c := b.NewCursor()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.Read(ctx, make([]int, 1)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled read: %v", err)
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		_, err := c.Read(context.Background(), make([]int, 1))
+		done <- err
+	}()
+	b.Close()
+	select {
+	case err := <-done:
+		if !errors.Is(err, ErrBufferClosed) {
+			t.Fatalf("blocked read after close: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("blocked read was not woken by close")
+	}
+	if _, err := b.NewCursor().TryRead(make([]int, 1)); !errors.Is(err, ErrBufferClosed) {
+		t.Fatalf("new cursor after close: %v", err)
+	}
+}
