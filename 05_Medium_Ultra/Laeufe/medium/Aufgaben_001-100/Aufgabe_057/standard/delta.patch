+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"gopkg.in/yaml.v2"
+)
+
+func TestAttachmentConversion(t *testing.T) {
+	var doc Document
+	input := `flags:
+  - key: example
+    enabled: true
+    variants:
+      - key: nested
+        attachment:
+          list:
+            - {mixed: [true, 2, null, "text"]}
+            - [a, {inner: [1, false]}]
+          empty: null
+      - key: absent
+`
+	if err := yaml.Unmarshal([]byte(input), &doc); err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(convert(doc.Flags[0].Variants[0].Attachment))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got interface{}
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatal(err)
+	}
+	var want interface{}
+	if err := json.Unmarshal([]byte(`{"list":[{"mixed":[true,2,null,"text"]},["a",{"inner":[1,false]}]],"empty":null}`), &want); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("attachment = %#v, want %#v", got, want)
+	}
+	if doc.Flags[0].Variants[1].Attachment != nil {
+		t.Fatal("missing attachment should remain nil")
+	}
+}
