diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 0000000..51b164f
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,60 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient constructs a Redis client using the supplied cache configuration.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CACertPath != "" && cfg.CACertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{MinVersion: tls.VersionTLS12, InsecureSkipVerify: cfg.InsecureSkipTLS} //nolint:gosec // explicitly configured by the operator
+
+		if !cfg.InsecureSkipTLS {
+			var cert []byte
+			if cfg.CACertPath != "" {
+				var err error
+				cert, err = os.ReadFile(cfg.CACertPath)
+				if err != nil {
+					return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+				}
+			} else if cfg.CACertBytes != "" {
+				cert = []byte(cfg.CACertBytes)
+			}
+
+			if cert != nil {
+				roots := x509.NewCertPool()
+				if !roots.AppendCertsFromPEM(cert) {
+					return nil, errors.New("invalid redis CA certificate")
+				}
+				tlsConfig.RootCAs = roots
+			}
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 0000000..7517312
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,83 @@
+package redis
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestNewClientTLS(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	cert := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "redis"},
+		DNSNames:              []string{"redis"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		KeyUsage:              x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign,
+		ExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+	require.NoError(t, err)
+	certPEM := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))
+	path := filepath.Join(t.TempDir(), "ca.pem")
+	require.NoError(t, os.WriteFile(path, []byte(certPEM), 0600))
+
+	for _, tt := range []struct {
+		name         string
+		cfg          config.RedisCacheConfig
+		wantRoots    bool
+		wantInsecure bool
+	}{
+		{name: "system roots", cfg: config.RedisCacheConfig{RequireTLS: true}},
+		{name: "inline CA", cfg: config.RedisCacheConfig{RequireTLS: true, CACertBytes: certPEM}, wantRoots: true},
+		{name: "CA file", cfg: config.RedisCacheConfig{RequireTLS: true, CACertPath: path}, wantRoots: true},
+		{name: "insecure", cfg: config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true}, wantInsecure: true},
+		{name: "insecure ignores CA", cfg: config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true, CACertBytes: "invalid"}, wantInsecure: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			client, err := NewClient(tt.cfg)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, client.Close()) })
+			tlsConfig := client.Options().TLSConfig
+			require.NotNil(t, tlsConfig)
+			require.Equal(t, uint16(tls.VersionTLS12), tlsConfig.MinVersion)
+			require.Equal(t, tt.wantInsecure, tlsConfig.InsecureSkipVerify)
+			if tt.wantRoots {
+				require.NotNil(t, tlsConfig.RootCAs)
+				parsed, err := x509.ParseCertificate(der)
+				require.NoError(t, err)
+				_, err = parsed.Verify(x509.VerifyOptions{Roots: tlsConfig.RootCAs, DNSName: "redis"})
+				require.NoError(t, err)
+			} else {
+				require.Nil(t, tlsConfig.RootCAs)
+			}
+		})
+	}
+
+	_, err = NewClient(config.RedisCacheConfig{CACertPath: path, CACertBytes: certPEM})
+	require.EqualError(t, err, "please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CACertPath: filepath.Join(t.TempDir(), "missing")})
+	require.Error(t, err)
+	_, err = NewClient(config.RedisCacheConfig{RequireTLS: true, CACertBytes: "invalid"})
+	require.EqualError(t, err, "invalid redis CA certificate")
+
+	client, err := NewClient(config.RedisCacheConfig{})
+	require.NoError(t, err)
+	require.Nil(t, client.Options().TLSConfig)
+	require.NoError(t, client.Close())
+}
