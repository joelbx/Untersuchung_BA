+func (s *APITestSuite) TestKubeProxyAddressResolution(c *check.C) {
+	for _, test := range []struct {
+		listen, public, want string
+	}{
+		{"0.0.0.0:8080", "", "web.example.com:8080"},
+		{"[::]:8080", "", "web.example.com:8080"},
+		{"kube.example.com:8080", "", "kube.example.com:8080"},
+		{"0.0.0.0:8080", "public.example.com:443", "public.example.com:443"},
+	} {
+		client := &TeleportClient{Config: Config{WebProxyAddr: "old.example.com:3080"}}
+		err := client.applyProxySettings(ProxySettings{
+			Kube: KubeProxySettings{Enabled: true, ListenAddr: test.listen, PublicAddr: test.public},
+			SSH:  SSHProxySettings{PublicAddr: "web.example.com:3080"},
+		})
+		c.Assert(err, check.IsNil)
+		c.Assert(client.KubeProxyAddr, check.Equals, test.want)
+	}
+	config := Config{WebProxyAddr: "[2001:db8::1]:3080", KubeProxyAddr: "[::]:8080"}
+	c.Assert(config.KubeClusterAddr(), check.Equals, "https://[2001:db8::1]:8080")
+}
