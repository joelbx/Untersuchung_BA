 }
 
+func (s *ConfigTestSuite) TestKubeProxyListenShorthand(c *check.C) {
+	for _, test := range []struct {
+		name, yaml, wantAddr string
+		wantError            bool
+	}{
+		{"shorthand", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n", "0.0.0.0:8080", false},
+		{"default port", "proxy_service:\n  kube_listen_addr: kube.example.com\n", "kube.example.com:3026", false},
+		{"disabled legacy", "proxy_service:\n  kube_listen_addr: '[::]:8080'\n  kubernetes:\n    enabled: no\n    listen_addr: 127.0.0.1:9000\n", "[::]:8080", false},
+		{"enabled legacy", "proxy_service:\n  kube_listen_addr: 0.0.0.0:8080\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:9000\n", "", true},
+		{"legacy", "proxy_service:\n  kubernetes:\n    enabled: yes\n    listen_addr: 127.0.0.1:9000\n", "127.0.0.1:9000", false},
+		{"invalid address", "proxy_service:\n  kube_listen_addr: 'udp://host:8080'\n", "", true},
+	} {
+		c.Log(test.name)
+		fc, err := ReadConfig(bytes.NewBufferString(test.yaml))
+		if test.name == "enabled legacy" {
+			c.Assert(err, check.ErrorMatches, ".*kube_listen_addr conflicts with enabled proxy_service.kubernetes.*")
+			continue
+		}
+		c.Assert(err, check.IsNil)
+		cfg := service.MakeDefaultConfig()
+		err = ApplyFileConfig(fc, cfg)
+		if test.wantError {
+			c.Assert(err, check.NotNil)
+			continue
+		}
+		c.Assert(err, check.IsNil)
+		c.Assert(cfg.Proxy.Kube.Enabled, check.Equals, true)
+		c.Assert(cfg.Proxy.Kube.ListenAddr.Addr, check.Equals, test.wantAddr)
+	}
+}
