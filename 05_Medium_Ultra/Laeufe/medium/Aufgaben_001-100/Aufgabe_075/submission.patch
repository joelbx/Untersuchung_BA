diff --git a/persistence/user_props_repository.go b/persistence/user_props_repository.go
new file mode 100644
index 0000000..e11d4e0
--- /dev/null
+++ b/persistence/user_props_repository.go
@@ -0,0 +1,63 @@
+package persistence
+
+import (
+	"context"
+	"errors"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+var errUserPropsNoUser = errors.New("user properties require a user in context")
+
+type userPropsRepository struct {
+	sqlRepository
+}
+
+func NewUserPropsRepository(ctx context.Context, o orm.Ormer) model.UserPropsRepository {
+	return &userPropsRepository{sqlRepository: sqlRepository{ctx: ctx, ormer: o, tableName: "user_props"}}
+}
+
+func (r userPropsRepository) currentUserID() (string, error) {
+	u, ok := request.UserFrom(r.ctx)
+	if !ok || u.ID == "" {
+		return "", errUserPropsNoUser
+	}
+	return u.ID, nil
+}
+
+func (r userPropsRepository) Put(key, value string) error {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	count, err := r.executeSQL(Update(r.tableName).Set("value", value).Where(Eq{"user_id": uid, "key": key}))
+	if err != nil {
+		return err
+	}
+	if count > 0 {
+		return nil
+	}
+	_, err = r.executeSQL(Insert(r.tableName).Columns("user_id", "key", "value").Values(uid, key, value))
+	return err
+}
+
+func (r userPropsRepository) Get(key string) (string, error) {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return "", err
+	}
+	var result struct{ Value string }
+	err = r.queryOne(Select("value").From(r.tableName).Where(Eq{"user_id": uid, "key": key}), &result)
+	return result.Value, err
+}
+
+func (r userPropsRepository) Delete(key string) error {
+	uid, err := r.currentUserID()
+	if err != nil {
+		return err
+	}
+	return r.delete(Eq{"user_id": uid, "key": key})
+}
diff --git a/persistence/user_props_repository_test.go b/persistence/user_props_repository_test.go
new file mode 100644
index 0000000..1f6f32b
--- /dev/null
+++ b/persistence/user_props_repository_test.go
@@ -0,0 +1,39 @@
+package persistence
+
+import (
+	"context"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("User properties repository", func() {
+	It("isolates and updates properties by contextual user", func() {
+		o := orm.NewOrm()
+		alice := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "alice"}), o)
+		bob := NewUserPropsRepository(request.WithUser(context.Background(), model.User{ID: "bob"}), o)
+
+		Expect(alice.Put("shared-key", "alice-value")).To(Succeed())
+		Expect(bob.Put("shared-key", "bob-value")).To(Succeed())
+		Expect(alice.Get("shared-key")).To(Equal("alice-value"))
+		Expect(bob.Get("shared-key")).To(Equal("bob-value"))
+
+		Expect(alice.Put("shared-key", "updated")).To(Succeed())
+		Expect(alice.Get("shared-key")).To(Equal("updated"))
+		Expect(alice.Delete("shared-key")).To(Succeed())
+		_, err := alice.Get("shared-key")
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(bob.Get("shared-key")).To(Equal("bob-value"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		r := NewUserPropsRepository(context.Background(), orm.NewOrm())
+		Expect(r.Put("key", "value")).To(HaveOccurred())
+		_, err := r.Get("key")
+		Expect(err).To(HaveOccurred())
+		Expect(r.Delete("key")).To(HaveOccurred())
+	})
+})
