+// KubeAddr returns the public HTTPS address for the Kubernetes proxy.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+	var addr utils.NetAddr
+	switch {
+	case len(c.Kube.PublicAddrs) > 0:
+		addr = c.Kube.PublicAddrs[0]
+	case len(c.PublicAddrs) > 0:
+		addr = c.PublicAddrs[0]
+	default:
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+	if addr.Path != "" || addr.Addr == "" {
+		return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+	}
+	host := addr.Addr
+	if parsedHost, port, err := net.SplitHostPort(addr.Addr); err == nil {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 || parsedHost == "" {
+			return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+		}
+		host = parsedHost
+	} else if strings.Contains(host, ":") {
+		// A bare IPv6 address is valid; any other colon requires a valid host:port.
+		host = strings.Trim(host, "[]")
+		if net.ParseIP(host) == nil {
+			return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+		}
+	}
+	if host == "" || strings.ContainsAny(host, " /?#@%") {
+		return "", trace.BadParameter("invalid proxy public address %q", addr.String())
+	}
+	return fmt.Sprintf("https://%s", net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort))), nil
+}
