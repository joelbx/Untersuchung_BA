+func TestLoadEnvironmentOverrides(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		path  string
+		level string
+		port  int
+	}{
+		{name: "defaults", level: "INFO", port: 8080},
+		{name: "file", path: "./testdata/advanced.yml", level: "WARN", port: 8081},
+		{name: "defaults with overrides", level: "debug", port: 9191},
+		{name: "file with overrides", path: "./testdata/advanced.yml", level: "debug", port: 9191},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			// Empty values are treated as unset by Viper.
+			t.Setenv("FLIPT_LOG_LEVEL", "")
+			t.Setenv("FLIPT_SERVER_HTTP_PORT", "")
+			if strings.Contains(tt.name, "overrides") {
+				t.Setenv("FLIPT_LOG_LEVEL", "debug")
+				t.Setenv("FLIPT_SERVER_HTTP_PORT", "9191")
+			}
+
+			res, err := Load(tt.path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.level, res.Config.Log.Level)
+			assert.Equal(t, tt.port, res.Config.Server.HTTPPort)
+		})
+	}
+}
