+// NewWriterEmitter returns an emitter that writes JSON events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		WriterLog: NewWriterLog(utils.NopWriteCloser(w)),
+		writer:    w,
+	}
+}
+
+// WriterEmitter combines the legacy writer log with an audit event emitter.
+type WriterEmitter struct {
+	*WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes a newline-delimited JSON audit event.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	data, err := json.Marshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	data = append(data, '\n')
+	n, err := w.writer.Write(data)
+	if err != nil {
+		return trace.ConvertSystemError(err)
+	}
+	if n != len(data) {
+		return trace.ConvertSystemError(io.ErrShortWrite)
+	}
+	return nil
+}
+
+// Close closes the writer and the embedded legacy log.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(w.writer.Close(), w.WriterLog.Close())
+}
+
 // CheckingEmitterConfig provides parameters for emitter
 type CheckingEmitterConfig struct {
 	// Inner emits events to the underlying store
