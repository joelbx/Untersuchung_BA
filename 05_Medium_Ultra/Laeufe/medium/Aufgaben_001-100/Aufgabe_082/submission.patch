 // NewMultiLog returns a new instance of a multi logger
-func NewMultiLog(loggers ...IAuditLog) *MultiLog {
-	return &MultiLog{
-		loggers: loggers,
+func NewMultiLog(loggers ...IAuditLog) (*MultiLog, error) {
+	emitters := make([]Emitter, 0, len(loggers))
+	for _, logger := range loggers {
+		emitter, ok := logger.(Emitter)
+		if !ok {
+			return nil, trace.BadParameter("expected emitter, but %T does not emit", logger)
+		}
+		emitters = append(emitters, emitter)
 	}
+	return &MultiLog{MultiEmitter: NewMultiEmitter(emitters...), loggers: loggers}, nil
 }
 
 // MultiLog is a logger that fan outs write operations
 // to all loggers, and performs all read and search operations
 // on the first logger that implements the operation
 type MultiLog struct {
+	*MultiEmitter
 	loggers []IAuditLog
 }
 
diff --git a/lib/events/multilog_test.go b/lib/events/multilog_test.go
new file mode 100644
index 0000000..7ef38d3
--- /dev/null
+++ b/lib/events/multilog_test.go
@@ -0,0 +1,69 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type testEventWriter struct {
+	bytes.Buffer
+	closeErr error
+	closes   int
+}
+
+func (w *testEventWriter) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+func TestWriterEmitter(t *testing.T) {
+	w := &testEventWriter{}
+	emitter := NewWriterEmitter(w)
+	event := &UserLogin{}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+	want, err := json.Marshal(event)
+	require.NoError(t, err)
+	require.Equal(t, append(want, '\n'), w.Bytes())
+	require.NoError(t, emitter.Close())
+	require.Equal(t, 1, w.closes)
+}
+
+func TestWriterEmitterErrors(t *testing.T) {
+	closeErr := errors.New("close failed")
+	w := &testEventWriter{closeErr: closeErr}
+	require.Error(t, NewWriterEmitter(w).Close())
+	require.Equal(t, 1, w.closes)
+
+	broken := NewWriterEmitter(writeErrorCloser{})
+	require.Error(t, broken.EmitAuditEvent(context.Background(), &UserLogin{}))
+}
+
+type writeErrorCloser struct{ io.Closer }
+
+func (writeErrorCloser) Write([]byte) (int, error) { return 0, io.ErrClosedPipe }
+
+func TestMultiLogEmitter(t *testing.T) {
+	w1, w2 := &testEventWriter{}, &testEventWriter{}
+	multi, err := NewMultiLog(NewWriterEmitter(w1), NewWriterEmitter(w2))
+	require.NoError(t, err)
+	event := &UserLogin{}
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	require.Equal(t, w1.Bytes(), w2.Bytes())
+	require.NotEmpty(t, w1.Bytes())
+	require.NoError(t, multi.Close())
+	require.Equal(t, 1, w1.closes)
+	require.Equal(t, 1, w2.closes)
+}
+
+func TestMultiLogRejectsNonEmitter(t *testing.T) {
+	_, err := NewMultiLog(NewWriterLog(&testEventWriter{}))
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
