+func TestSetScanResultMeta(t *testing.T) {
+	cases := []struct {
+		name, artifact, artifactType, osName, resultType, wantServer, wantRelease string
+		withOS                                                                    bool
+	}{
+		{"registry port matches tag pattern", "registry:5000/team/app", "container_image", "12", "debian", "registry:5000/team/app", "12", true},
+		{"image without tag", "app", "container_image", "", "debian", "app:latest", "", true},
+		{"image with empty tag", "app:", "container_image", "", "jar", "app::latest", "", false},
+		{"library only", "/data/lib", "filesystem", "", "jar", "/data/lib", "", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			report := &types.Report{ArtifactName: tc.artifact, ArtifactType: ftypes.ArtifactType(tc.artifactType), Results: types.Results{{Type: tc.resultType}}}
+			if tc.withOS {
+				report.Metadata.OS = &ftypes.OS{Name: tc.osName}
+			}
+			result := &models.ScanResult{Optional: map[string]interface{}{"trivy-target": "old"}}
+			if err := setScanResultMeta(result, report); err != nil {
+				t.Fatal(err)
+			}
+			if result.ServerName != tc.wantServer || result.Release != tc.wantRelease || result.Optional != nil {
+				t.Errorf("metadata = (%q, %q, %v), want (%q, %q, nil)", result.ServerName, result.Release, result.Optional, tc.wantServer, tc.wantRelease)
+			}
+		})
+	}
+}
