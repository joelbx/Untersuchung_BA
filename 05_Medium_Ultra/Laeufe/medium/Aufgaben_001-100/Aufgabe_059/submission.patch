+import { createRef } from 'react';
+
+import { render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('uses an accessible fallback for a limited dialog implementation', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const { getByRole, rerender } = render(
+            <Dialog ref={ref} open aria-label="Example" aria-modal="true" data-testid="host">
+                <button type="button">Continue</button>
+            </Dialog>
+        );
+
+        const host = getByRole('dialog', { name: 'Example' });
+        expect(host.tagName).toBe('DIV');
+        expect(host).toHaveAttribute('data-testid', 'host');
+        expect(host).toHaveAttribute('aria-modal', 'true');
+        expect(ref.current).toBe(host);
+        expect(getByRole('button', { name: 'Continue' })).toBeVisible();
+
+        rerender(
+            <Dialog ref={ref} aria-label="Example">
+                <button type="button">Continue</button>
+            </Dialog>
+        );
+        expect(host).toHaveAttribute('hidden');
+    });
+
+    it('uses a native dialog when its modal API is available', () => {
+        const descriptor = Object.getOwnPropertyDescriptor(HTMLDialogElement.prototype, 'showModal');
+        Object.defineProperty(HTMLDialogElement.prototype, 'showModal', {
+            configurable: true,
+            value: () => {},
+        });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { getByTestId } = render(
+                <Dialog ref={ref} open aria-label="Native" data-testid="native">
+                    <button type="button">Continue</button>
+                </Dialog>
+            );
+            const host = getByTestId('native');
+            expect(host.tagName).toBe('DIALOG');
+            expect(host).toHaveAttribute('open');
+            expect(host).toHaveAttribute('aria-label', 'Native');
+            expect(ref.current).toBe(host);
+        } finally {
+            if (descriptor) {
+                Object.defineProperty(HTMLDialogElement.prototype, 'showModal', descriptor);
+            } else {
+                Reflect.deleteProperty(HTMLDialogElement.prototype, 'showModal');
+            }
+        }
+    });
+});
diff --git a/packages/components/components/dialog/Dialog.tsx b/packages/components/components/dialog/Dialog.tsx
