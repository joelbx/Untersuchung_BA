index 0000000..f0bf600
--- /dev/null
+++ b/packages/components/components/dialog/Dialog.tsx
@@ -0,0 +1,31 @@
+import { HTMLAttributes, Ref, forwardRef } from 'react';
+
+export interface Props extends HTMLAttributes<HTMLDialogElement> {
+    open?: boolean;
+}
+
+const Dialog = forwardRef<HTMLDialogElement, Props>(({ children, open, ...rest }, ref: Ref<HTMLDialogElement>) => {
+    // Limited dialog implementations can hide descendants from accessibility queries.
+    if (typeof HTMLDialogElement === 'undefined' || typeof HTMLDialogElement.prototype.showModal !== 'function') {
+        return (
+            <div
+                {...(rest as HTMLAttributes<HTMLDivElement>)}
+                role={rest.role || 'dialog'}
+                hidden={!open}
+                ref={ref as Ref<HTMLDivElement>}
+            >
+                {children}
+            </div>
+        );
+    }
+
+    return (
+        <dialog {...rest} open={open} ref={ref}>
+            {children}
+        </dialog>
+    );
+});
+
+Dialog.displayName = 'Dialog';
+
+export default Dialog;
