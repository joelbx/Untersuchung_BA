+def test_parse_clixml_decodes_utf16_escapes_and_keeps_invalid_tokens():
+    data = (b'<Objs><S S="Error">_x263A__x005f__xD83D_</S>'
+            b'<S S="Info">ignored</S>'
+            b'<S S="Error">_xDE00__x000D__x000A__x005G__x005F_</S></Objs>')
+    assert _parse_clixml(data) == ('☺_' + chr(0x1F600) + '\r\n_x005G__x005F_').encode()
+
+
+def test_parse_clixml_escaped_underscore_before_token():
+    data = b'<Objs><S S="Error">_x005F__x000A__x005F__x263a_</S></Objs>'
+    assert _parse_clixml(data) == '_\n_☺'.encode()
+
+
+def test_parse_clixml_empty_elements_and_blocks():
+    data = (b'<Objs><S S="Error"/><S S="Info">ignored</S></Objs>'
+            b'<Objs><S S="Error">first</S><S S="Error"/></Objs>'
+            b'<Objs><S S="Error">second</S></Objs>')
+    assert _parse_clixml(data) == b'first\r\nsecond'
+    assert _parse_clixml(b'<Objs><S S="Error"/></Objs>') == b''
+    assert _parse_clixml(b'no CLIXML blocks') == b''
+
+
+def test_parse_clixml_unpaired_surrogate():
+    data = b'<Objs><S S="Error">_xD800_</S></Objs>'
+    assert _parse_clixml(data).decode('utf-8', 'surrogatepass') == '\ud800'
+
