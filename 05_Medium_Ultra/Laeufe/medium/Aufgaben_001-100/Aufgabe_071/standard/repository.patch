+def _decode_clixml_text(value: str) -> str:
+    """Decode PowerShell's UTF-16 code unit escapes in a CLIXML string."""
+    result = []
+    position = 0
+
+    for match in _CLIXML_ESCAPE.finditer(value):
+        if match.start() < position:
+            continue
+
+        result.append(value[position:match.start()])
+        unit = int(match.group(1), 16)
+        next_match = _CLIXML_ESCAPE.match(value, match.end())
+
+        if unit == 0x005F and next_match is None:
+            # PowerShell only escapes an underscore to protect a following token.
+            result.append(match.group())
+        elif 0xD800 <= unit <= 0xDBFF and next_match is not None:
+            next_unit = int(next_match.group(1), 16)
+            if 0xDC00 <= next_unit <= 0xDFFF:
+                result.append(chr(0x10000 + (unit - 0xD800) * 0x400 + next_unit - 0xDC00))
+                position = next_match.end()
+                continue
+            result.append(chr(unit))
+        else:
+            result.append(chr(unit))
+
+        position = match.end()
+
+    result.append(value[position:])
+    return ''.join(result)
+
