+class GzipDecodedReader(gzip.GzipFile if gzip is not None else object):
+    """Read a gzip HTTP response while retaining its response metadata."""
+
+    def __init__(self, fp):
+        if gzip is None:
+            raise MissingModuleError(self.missing_gzip_error(), module='gzip')
+        self._response = fp
+        # Python 2 response objects may expose the headers through info() only.
+        self.headers = getattr(fp, 'headers', None) or fp.info()
+        self.code = getattr(fp, 'code', None)
+        gzip.GzipFile.__init__(self, fileobj=fp, mode='rb')
+
+    def info(self):
+        return self._response.info()
+
+    def geturl(self):
+        return self._response.geturl()
+
+    def close(self):
+        try:
+            if gzip is not None:
+                gzip.GzipFile.close(self)
+        finally:
+            self._response.close()
+
+    @staticmethod
+    def missing_gzip_error():
+        return missing_required_lib('gzip', reason='to decompress gzip-encoded HTTP responses')
 
 
