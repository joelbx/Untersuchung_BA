+@pytest.mark.parametrize('encoded,decompress', [(True, True), (True, False), (False, True), (False, False)])
+def test_response_decompression(urlopen_mock, install_opener_mock, encoded, decompress):
+    payload = b'hello from a gzip response' * 100
+    buffer = io.BytesIO()
+    with gzip.GzipFile(fileobj=buffer, mode='wb') as writer:
+        writer.write(payload)
+    compressed = buffer.getvalue()
+
+    class Response(io.BytesIO):
+        def __init__(self):
+            io.BytesIO.__init__(self, compressed if encoded else payload)
+            self.headers = Message()
+            self.headers['Content-Length'] = str(len(compressed if encoded else payload))
+            if encoded:
+                self.headers['Content-Encoding'] = 'gzip'
+            self.code = 200
+
+        def info(self):
+            return self.headers
+
+        def geturl(self):
+            return 'http://ansible.com/'
+
+    response = Response()
+    urlopen_mock.return_value = response
+    stream = Request(decompress=decompress).open('GET', 'http://ansible.com/')
+    assert stream.read() == (compressed if encoded and not decompress else payload)
+    assert stream.info().get('Content-Length') == str(len(compressed if encoded else payload))
+    stream.close()
+    assert response.closed
