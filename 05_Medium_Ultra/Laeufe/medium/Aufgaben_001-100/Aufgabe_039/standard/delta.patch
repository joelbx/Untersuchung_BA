+
+class TestBooknotesUpdateWorkID:
+
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        db = get_db()
+        db.query("""
+        CREATE TABLE booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL DEFAULT -1,
+            notes text NOT NULL,
+            PRIMARY KEY (username, work_id, edition_id)
+        );
+        """)
+
+    def setup_method(self, method):
+        self.db = get_db()
+        self.db.insert(
+            "booknotes", username="alice", work_id=1, edition_id=-1,
+            notes="source note",
+        )
+
+    def teardown_method(self):
+        self.db.query("DELETE FROM booknotes")
+
+    def test_conflict_preserves_every_note(self):
+        self.db.insert(
+            "booknotes", username="alice", work_id=2, edition_id=-1,
+            notes="target note",
+        )
+        self.db.insert(
+            "booknotes", username="bob", work_id=1, edition_id=-1,
+            notes="another source note",
+        )
+        before = sorted(
+            (row.username, row.work_id, row.edition_id, row.notes)
+            for row in self.db.select("booknotes")
+        )
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1,
+        }
+        assert sorted(
+            (row.username, row.work_id, row.edition_id, row.notes)
+            for row in self.db.select("booknotes")
+        ) == before
+
+    def test_update_without_conflict(self):
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0,
+        }
+        assert [(row.username, row.work_id, row.edition_id, row.notes)
+                for row in self.db.select("booknotes")] == [
+            ("alice", 2, -1, "source note")
+        ]
+
+    def test_dry_run_preserves_notes(self):
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {
+            "rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0,
+        }
+        assert [(row.username, row.work_id, row.edition_id, row.notes)
+                for row in self.db.select("booknotes")] == [
+            ("alice", 1, -1, "source note")
+        ]
