+def _normalize_language_name(name: str) -> str:
+    return ''.join(char for char in normalize('NFKD', name.casefold()) if not combining(char))
+
+
+@cache
+def _native_language_codes() -> dict[str, str]:
+    """Map Babel's native language names to their ISO 639-1 codes."""
+    codes: dict[str, str] = {}
+    ambiguous: set[str] = set()
+    for first in ascii_lowercase:
+        for second in ascii_lowercase:
+            iso_code = first + second
+            try:
+                native_name = Locale.parse(iso_code).get_language_name(iso_code)
+            except (UnknownLocaleError, ValueError):
+                continue
+            name = _normalize_language_name(native_name)
+            if name in codes and codes[name] != iso_code:
+                ambiguous.add(name)
+            else:
+                codes[name] = iso_code
+    return {name: code for name, code in codes.items() if name not in ambiguous}
+
+
+def _iso_to_marc(iso_code: str, languages: list) -> str | None:
