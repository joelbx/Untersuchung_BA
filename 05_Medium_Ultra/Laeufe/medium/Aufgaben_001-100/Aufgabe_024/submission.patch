+def remove_author_honorifics(name: str) -> str:
+    """Remove leading honorifics, preserving names made only of an honorific."""
+    normalized = re.sub(r'[^\w]+', ' ', name.casefold()).strip()
+    if normalized in {
+        re.sub(r'[^\w]+', ' ', exception.casefold()).strip()
+        for exception in HONORIFC_NAME_EXECPTIONS
+    }:
+        return name
+
+    original = name
+    while True:
+        for honorific in HONORIFICS:
+            match = re.match(
+                rf'^\s*{re.escape(honorific)}(?=\W|$)\s*', name, re.IGNORECASE
+            )
+            if match:
+                name = name[match.end() :].lstrip()
+                break
+        else:
+            break
+    return name if name else original
 
 
