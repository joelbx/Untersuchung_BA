+func TestMatcherErrors(t *testing.T) {
+	tests := []struct {
+		value, message string
+	}{
+		{`{{regexp.match("x")`, `is using template brackets '{{' or '}}'`},
+		{`{{internal.foo}}`, `is not a valid matcher expression`},
+		{`{{regexp.match(internal.foo)}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match()}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match("a", "b")}}`, `expects exactly one string literal argument`},
+		{`{{regexp.match("[")}}`, `failed parsing regexp "["`},
+		{`{{other.match("x")}}`, `unsupported function namespace other`},
+		{`{{regexp.other("x")}}`, `unsupported function regexp.other`},
+		{`{{email.other("x")}}`, `unsupported function email.other`},
+		{`{{email.local("x")}}`, `is not a valid matcher expression`},
+		{`{{regexp.match("x")}}-{{regexp.match("y")}}`, `is using template brackets '{{' or '}}'`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.value, func(t *testing.T) {
+			_, err := Match(tt.value)
+			assert.True(t, trace.IsBadParameter(err), "error: %v", err)
+			if err != nil {
+				assert.True(t, strings.Contains(err.Error(), tt.message), "error: %v", err)
+			}
+		})
+	}
+
+	_, err := Variable(`{{regexp.match("x")}}`)
+	assert.True(t, trace.IsBadParameter(err))
+	if err != nil {
+		assert.Equal(t, `matcher functions (like regexp.match) are not allowed here: "{{regexp.match(\"x\")}}"`, err.Error())
+	}
+}
