+func TestMatch(t *testing.T) {
+	tests := []struct {
+		pattern, input string
+		want           bool
+	}{
+		{"foo", "foo", true},
+		{"foo", "foobar", false},
+		{"*", "anything", true},
+		{"foo*bar", "foo-middle-bar", true},
+		{"foo*bar", "foo-middle-baz", false},
+		{"^fo+$", "fooo", true},
+		{"^fo+$", "afooo", false},
+		{`{{regexp.match("bar")}}`, "bar", true},
+		{`{{regexp.match("bar")}}`, "baz", false},
+		{`{{regexp.not_match("bar")}}`, "baz", true},
+		{`{{regexp.not_match("bar")}}`, "bar", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz", true},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-other", false},
+		{`foo-{{regexp.match("bar")}}-baz`, "foo-bar-baz-extra", false},
+		{`foo-{{regexp.not_match("bar")}}-baz`, "foo-other-baz", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.pattern+"/"+tt.input, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			assert.NoError(t, err)
+			if err == nil {
+				assert.Equal(t, tt.want, matcher.Match(tt.input))
+			}
+		})
+	}
+}
