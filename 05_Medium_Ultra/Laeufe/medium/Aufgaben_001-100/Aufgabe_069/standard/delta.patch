+// Matcher tests whether a string satisfies a pattern.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct {
+	regexp *regexp.Regexp
+}
+
+func (m regexpMatcher) Match(in string) bool { return m.regexp.MatchString(in) }
+
+type prefixSuffixMatcher struct {
+	prefix, suffix string
+	matcher        Matcher
+}
+
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) || len(in) < len(m.prefix)+len(m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct{ matcher Matcher }
+
+func (m notMatcher) Match(in string) bool { return !m.matcher.Match(in) }
+
+// Match parses a literal, glob, regexp, or a matcher function in a template.
+func Match(value string) (Matcher, error) {
+	parts := reVariable.FindStringSubmatch(value)
+	if len(parts) == 0 {
+		if strings.Contains(value, "{{") || strings.Contains(value, "}}") {
+			return nil, trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+		}
+		pattern := value
+		if !strings.HasPrefix(pattern, "^") || !strings.HasSuffix(pattern, "$") {
+			pattern = "^" + utils.GlobToRegexp(pattern) + "$"
+		}
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+		}
+		return regexpMatcher{regexp: re}, nil
+	}
+
+	expression := strings.TrimSpace(parts[2])
+	invalid := func() error {
+		return trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+	}
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, invalid()
+	}
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return nil, invalid()
+	}
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return nil, invalid()
+	}
+	namespace, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return nil, invalid()
+	}
+	if namespace.Name != "regexp" && namespace.Name != EmailNamespace {
+		return nil, trace.BadParameter("unsupported function namespace %s, supported namespaces are email and regexp", namespace.Name)
+	}
+	fn := selector.Sel.Name
+	if namespace.Name == EmailNamespace {
+		if fn != EmailLocalFnName {
+			return nil, trace.BadParameter("unsupported function email.%s, supported functions are: email.local", fn)
+		}
+	} else if fn != "match" && fn != "not_match" {
+		return nil, trace.BadParameter("unsupported function regexp.%s, supported functions are: regexp.match, regexp.not_match.", fn)
+	}
+	if len(call.Args) != 1 {
+		return nil, trace.BadParameter("%s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	arg, ok := call.Args[0].(*ast.BasicLit)
+	if !ok || arg.Kind != token.STRING {
+		return nil, trace.BadParameter("%s.%s expects exactly one string literal argument", namespace.Name, fn)
+	}
+	if namespace.Name == EmailNamespace {
+		return nil, invalid()
+	}
+	raw, err := strconv.Unquote(arg.Value)
+	if err != nil {
+		return nil, trace.BadParameter("invalid string literal %s: %v", arg.Value, err)
+	}
+	re, err := regexp.Compile(raw)
+	if err != nil {
+		return nil, trace.BadParameter("failed parsing regexp %q: %v", raw, err)
+	}
+	var matcher Matcher = regexpMatcher{regexp: re}
+	if fn == "not_match" {
+		matcher = notMatcher{matcher: matcher}
+	}
+	if parts[1] != "" || parts[3] != "" {
+		matcher = prefixSuffixMatcher{prefix: parts[1], suffix: parts[3], matcher: matcher}
+	}
+	return matcher, nil
+}
