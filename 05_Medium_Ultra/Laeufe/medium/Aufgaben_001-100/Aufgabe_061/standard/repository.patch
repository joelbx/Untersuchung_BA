+func TestParseOwnerPkgs(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	names, err := r.parseOwnerPkgs(`libgcc 0 4.8.5 39.el7 x86_64
+error: file /root/private: Permission denied
+libgcc 0 4.8.5 39.el7 i686
+file /tmp/missing is not owned by any package
+error: file /tmp/gone: No such file or directory
+openssl 1 1.0.2k 26.el7 x86_64`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(names, []string{"libgcc", "openssl"}) {
+		t.Errorf("unexpected package owners: %v", names)
+	}
+	if _, err := r.parseOwnerPkgs("unexpected rpm output"); err == nil {
+		t.Error("expected malformed RPM output to produce an error")
+	}
+}
