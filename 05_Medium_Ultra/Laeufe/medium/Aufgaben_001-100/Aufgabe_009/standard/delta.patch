+
+import React from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-id', display_name: 'Old name', isVerified: false };
+
+    it('saves a new name and returns to the read view', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId, queryByTestId, rerender } = render(
+            <DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />,
+        );
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        const input = getByTestId('device-detail-heading-input') as HTMLInputElement;
+        expect(input.maxLength).toBe(100);
+        fireEvent.change(input, { target: { value: 'Work laptop' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(queryByTestId('device-detail-heading-edit')).toBeNull());
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', 'Work laptop');
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Work laptop');
+        rerender(<DeviceDetailHeading
+            device={{ ...device, display_name: 'Work laptop' }}
+            saveDeviceName={saveDeviceName}
+        />);
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Work laptop');
+    });
+
+    it('accepts an empty name and leaves unchanged names unsaved', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: '' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(saveDeviceName).toHaveBeenCalledWith('device-id', ''));
+    });
+
+    it('cancels without saving and reports save failures', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('server error'));
+        const { getByTestId } = render(<DeviceDetailHeading device={device} saveDeviceName={saveDeviceName} />);
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'New name' } });
+        fireEvent.click(getByTestId('device-detail-heading-cancel'));
+        expect(getByTestId('device-detail-heading-read').textContent).toContain('Old name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'New name' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+        await waitFor(() => expect(getByTestId('device-detail-heading-error').textContent)
+            .toBe('Failed to set display name.'));
+    });
+});
