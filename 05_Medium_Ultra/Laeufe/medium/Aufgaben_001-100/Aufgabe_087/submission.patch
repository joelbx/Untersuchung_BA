@@ -0,0 +1,130 @@
+package telemetry
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+func TestReporter(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	var event struct {
+		AnonymousId string            `json:"anonymousId"`
+		Event       string            `json:"event"`
+		Properties  map[string]string `json:"properties"`
+	}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if err := json.NewDecoder(r.Body).Decode(&event); err != nil {
+			t.Errorf("decode event: %v", err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+	oldEndpoint, oldVersion := endpoint, Version
+	endpoint, Version = srv.URL, "v1.2.3"
+	defer func() { endpoint, Version = oldEndpoint, oldVersion }()
+
+	reporter, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := reporter.Report(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if event.Event != "flipt.ping" || event.AnonymousId == "" || event.Properties["uuid"] != event.AnonymousId || event.Properties["version"] != schemaVersion || event.Properties["flipt.version"] != Version {
+		t.Fatalf("unexpected event: %+v", event)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, stateFile))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved state
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.UUID != event.AnonymousId || saved.Version != schemaVersion {
+		t.Fatalf("unexpected state: %+v", saved)
+	}
+	if _, err := time.Parse(time.RFC3339, saved.LastTimestamp); err != nil {
+		t.Fatal(err)
+	}
+	second, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second.state.UUID != saved.UUID {
+		t.Fatal("UUID changed across reporter restarts")
+	}
+}
+
+func TestDisabledAndInvalidDirectory(t *testing.T) {
+	dir := t.TempDir()
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	cfg.Meta.TelemetryEnabled = false
+	r, err := NewReporter(cfg, logrus.New())
+	if err != nil || r != nil {
+		t.Fatalf("disabled reporter: %v, %v", r, err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, stateFile)); !os.IsNotExist(err) {
+		t.Fatalf("disabled reporter created state: %v", err)
+	}
+	file := filepath.Join(dir, "file")
+	if err := os.WriteFile(file, []byte("x"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Meta.StateDirectory = file
+	cfg.Meta.TelemetryEnabled = true
+	if r, err := NewReporter(cfg, logrus.New()); err == nil || r != nil {
+		t.Fatalf("expected invalid directory error: %v, %v", r, err)
+	}
+}
+
+func TestMalformedStateAndFailedReport(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, stateFile)
+	if err := os.WriteFile(path, []byte(`{"version":"0","uuid":"bad","lastTimestamp":"2022-04-06T01:01:51Z"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := config.Default()
+	cfg.Meta.StateDirectory = dir
+	reporter, err := NewReporter(cfg, logrus.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reporter.state.UUID == "bad" || reporter.state.UUID == "" {
+		t.Fatalf("invalid regenerated UUID: %q", reporter.state.UUID)
+	}
+	before := reporter.state.LastTimestamp
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer srv.Close()
+	oldEndpoint := endpoint
+	endpoint = srv.URL
+	defer func() { endpoint = oldEndpoint }()
+	if err := reporter.Report(context.Background()); err == nil {
+		t.Fatal("expected report failure")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved state
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.LastTimestamp != before {
+		t.Fatalf("failed report changed timestamp: %q", saved.LastTimestamp)
+	}
+}
