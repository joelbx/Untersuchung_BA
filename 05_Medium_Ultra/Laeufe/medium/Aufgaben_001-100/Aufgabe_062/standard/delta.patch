+func TestPasswordReadRestoresTerminal(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		exit func(*ContextReader, context.CancelFunc) error
+		want error
+	}{
+		{"cancel", func(_ *ContextReader, cancel context.CancelFunc) error { cancel(); return nil }, context.Canceled},
+		{"close", func(cr *ContextReader, _ context.CancelFunc) error { return cr.Close() }, ErrReaderClosed},
+		{"notify exit", func(_ *ContextReader, _ context.CancelFunc) error { NotifyExit(); return nil }, ErrReaderClosed},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			pr, pw := io.Pipe()
+			defer pr.Close()
+			defer pw.Close()
+			cr := NewContextReader(pr)
+			term := &fakeTerm{reader: pr}
+			cr.term = term
+			cr.fd = 1
+			if test.name == "notify exit" {
+				SetStdin(cr)
+				defer SetStdin(nil)
+			}
+
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			result := make(chan error, 1)
+			go func() {
+				value, err := cr.ReadPassword(ctx)
+				if len(value) != 0 {
+					result <- errors.New("password read returned data")
+					return
+				}
+				result <- err
+			}()
+			require.Eventually(t, func() bool {
+				cr.mu.Lock()
+				defer cr.mu.Unlock()
+				return cr.state == readerStatePassword
+			}, time.Second, time.Millisecond)
+			require.NoError(t, test.exit(cr, cancel))
+			require.ErrorIs(t, <-result, test.want)
+			assert.True(t, term.restoreCalled)
+			if test.name == "cancel" {
+				cr.mu.Lock()
+				assert.Equal(t, readerStateClean, cr.state)
+				cr.mu.Unlock()
+				go func() { _, _ = pw.Write([]byte("next")) }()
+				value, err := cr.ReadContext(context.Background())
+				require.NoError(t, err)
+				assert.Equal(t, "next", string(value))
+			}
+			require.NoError(t, cr.Close())
+		})
+	}
+}
+
+func TestPasswordReadDeadline(t *testing.T) {
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	cr := NewContextReader(pr)
+	term := &fakeTerm{reader: pr}
+	cr.term = term
+	cr.fd = 1
+	defer cr.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	value, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, value)
+	assert.True(t, term.restoreCalled)
+}
+
+func TestMaybeRestoreTerm(t *testing.T) {
+	cr := &ContextReader{term: &fakeTerm{}}
+	state := &term.State{}
+	cr.previousTermState = state
+	require.NoError(t, cr.maybeRestoreTerm())
+	assert.False(t, cr.term.(*fakeTerm).restoreCalled)
+
+	cr.state = readerStatePassword
+	cr.term.(*fakeTerm).restoreErr = errors.New("restore failed")
+	require.ErrorContains(t, cr.maybeRestoreTerm(), "restore failed")
+	assert.Same(t, state, cr.previousTermState)
+
+	cr.term.(*fakeTerm).restoreErr = nil
+	require.NoError(t, cr.maybeRestoreTerm())
+	assert.True(t, cr.term.(*fakeTerm).restoreCalled)
+	assert.Nil(t, cr.previousTermState)
+}
+
+func TestCloseReportsRestoreError(t *testing.T) {
+	cr := &ContextReader{
+		term:              &fakeTerm{restoreErr: errors.New("restore failed")},
+		previousTermState: &term.State{},
+		state:             readerStatePassword,
+		mu:                &sync.Mutex{},
+		closed:            make(chan struct{}),
+	}
+	cr.cond = sync.NewCond(cr.mu)
+	require.ErrorContains(t, cr.Close(), "restore failed")
+	assert.Equal(t, readerStateClosed, cr.state)
+}
