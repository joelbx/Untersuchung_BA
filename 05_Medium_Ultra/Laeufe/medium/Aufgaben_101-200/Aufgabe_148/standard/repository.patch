+
+// readSSHClientAddr inspects a Teleport proxy hello without consuming it. The
+// SSH server still needs the original hello to extract tracing metadata.
+func readSSHClientAddr(r *bufio.Reader) (net.Addr, error) {
+	in, err := r.Peek(8)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if !bytes.Equal(in, teleportProxyPrefix[:8]) {
+		return nil, nil
+	}
+	in, err = r.Peek(len(teleportProxyPrefix))
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// The SSH server reads at most 255 bytes for the initial version message.
+	const maxHelloBytes = 255
+	for size := len(teleportProxyPrefix) + 1; size <= maxHelloBytes; size++ {
+		in, err = r.Peek(size)
+		if err != nil {
+			return nil, trace.Wrap(err, "failed to read Teleport proxy hello")
+		}
+		if in[size-1] != 0 {
+			continue
+		}
+		var payload sshutils.HandshakePayload
+		if err := json.Unmarshal(in[len(teleportProxyPrefix):size-1], &payload); err != nil {
+			return nil, trace.Wrap(err, "invalid Teleport proxy hello")
+		}
+		if payload.ClientAddr == "" {
+			return nil, nil
+		}
+		addr, err := utils.ParseAddr(payload.ClientAddr)
+		if err != nil {
+			return nil, trace.Wrap(err, "invalid Teleport proxy client address")
+		}
+		if addr.AddrNetwork == "tcp" {
+			return &net.TCPAddr{IP: net.ParseIP(addr.Host()), Port: addr.Port(0)}, nil
+		}
+		return addr, nil
+	}
+	return nil, trace.BadParameter("Teleport proxy hello exceeds %d bytes", maxHelloBytes)
+}
