+func TestAmazonLinuxVersionAndEOL(t *testing.T) {
+	tests := []struct {
+		release string
+		version string
+		until   time.Time
+	}{
+		{"2018.03", "1", time.Date(2023, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"1", "1", time.Date(2023, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2 (Karoo)", "2", time.Date(2024, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2022 (Amazon Linux)", "2022", time.Date(2026, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2023", "2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2023.6.20241031 (Amazon Linux)", "2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2023 (Amazon Linux)", "2023", time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)},
+		{"2025", "2025", time.Date(2030, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2027", "2027", time.Date(2032, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2029", "2029", time.Date(2034, 6, 30, 23, 59, 59, 0, time.UTC)},
+		{"2024 (Amazon Linux)", "unknown", time.Time{}},
+		{"2024", "unknown", time.Time{}},
+		{"", "unknown", time.Time{}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			if got := getAmazonLinuxVersion(tt.release); got != tt.version {
+				t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.version)
+			}
+			eol, found := GetEOL(Amazon, tt.release)
+			if found != !tt.until.IsZero() {
+				t.Fatalf("GetEOL(%q) found = %v", tt.release, found)
+			}
+			if !found {
+				return
+			}
+			if !eol.StandardSupportUntil.Equal(tt.until) {
+				t.Errorf("standard support until = %v, want %v", eol.StandardSupportUntil, tt.until)
+			}
+			if eol.IsStandardSupportEnded(tt.until) || eol.IsExtendedSuppportEnded(tt.until) {
+				t.Error("support ended at the end date")
+			}
+			after := tt.until.Add(time.Second)
+			if !eol.IsStandardSupportEnded(after) || !eol.IsExtendedSuppportEnded(after) {
+				t.Error("support did not end after the end date")
+			}
+		})
+	}
+}
+
+func TestEOLWithExtendedSupport(t *testing.T) {
+	standard := time.Date(2028, 3, 15, 23, 59, 59, 0, time.UTC)
+	extended := standard.AddDate(1, 0, 0)
+	eol := EOL{StandardSupportUntil: standard, ExtendedSupportUntil: extended}
+	if !eol.IsStandardSupportEnded(standard.Add(time.Second)) || eol.IsExtendedSuppportEnded(standard.Add(time.Second)) {
+		t.Fatal("expected extended support after standard support ends")
+	}
+	if !eol.IsExtendedSuppportEnded(extended.Add(time.Second)) {
+		t.Fatal("expected extended support to end after its end date")
+	}
+}
