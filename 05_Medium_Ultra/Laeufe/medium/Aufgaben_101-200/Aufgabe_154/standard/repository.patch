diff --git a/test/units/plugins/connection/test_ssh.py b/test/units/plugins/connection/test_ssh.py
index 0bba41b..ad207de 100644
--- a/test/units/plugins/connection/test_ssh.py
+++ b/test/units/plugins/connection/test_ssh.py
@@ -34,6 +34,41 @@ from ansible.plugins.connection import ssh
 from ansible.plugins.loader import connection_loader, become_loader
 
 
+@pytest.mark.parametrize('stderr, expected', [
+    (b'plain stderr\r\n', b'plain stderr\r\n'),
+    (b'before #< CLIXML\r\n<Objs><S S="Error">broken</S>',
+     b'before #< CLIXML\r\n<Objs><S S="Error">broken</S>'),
+    (b'before #< CLIXML\r\n<Objs><S S="Error">valid</S></Objs> after',
+     b'before valid after'),
+    (b'before #< CLIXML\r\n<Objs Version="1"><S S="Error">bad</S>',
+     b'before #< CLIXML\r\n<Objs Version="1"><S S="Error">bad</S>'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">first</S>\r\n'
+     b'<S S="Error"> second</S></Objs> trailing\r\n', b'first second trailing\r\n'),
+    (b'before\r\nCLIXML\r\n<Objs Version="1"><S S="Error">error</S></Objs>after',
+     b'beforeerrorafter'),
+    (b'pre #< CLIXML\r\n<Objs Version="1"><S S="Error">caf\x82</S></Objs> post',
+     b'pre caf\xc3\xa9 post'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">one</S></Objs>\n'
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">two</S></Objs>',
+     b'one\ntwo'),
+    (b'#< CLIXML\r\n<Objs Version="1"><S S="Error">bad</S>\n'
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">good</S></Objs>',
+     b'#< CLIXML\r\n<Objs Version="1"><S S="Error">bad</S>\ngood'),
+])
+def test_replace_stderr_clixml(stderr, expected):
+    assert ssh._replace_stderr_clixml(stderr) == expected
+
+
+def test_exec_command_replaces_windows_stderr_clixml():
+    conn = ssh.Connection(PlayContext(), StringIO())
+    conn._shell = MagicMock(_IS_WINDOWS=True)
+    conn.get_option = MagicMock(return_value='host')
+    conn._build_command = MagicMock(return_value='ssh host command')
+    conn._run = MagicMock(return_value=(1, b'', b'prefix #< CLIXML\r\n<Objs><S S="Error">failed</S></Objs> suffix'))
+
+    assert conn.exec_command('command') == (1, b'', b'prefix failed suffix')
+
+
