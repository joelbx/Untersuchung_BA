 SSHPASS_AVAILABLE = None
 SSH_DEBUG = re.compile(r'^debug\d+: .*')
 
+_CLIXML_HEADER = re.compile(rb'(?:#< |\r\n)CLIXML\r\n')
+
+
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """Replace complete CLIXML blocks in stderr, preserving all other bytes."""
+    output = bytearray()
+    position = 0
+    search_position = 0
+
+    while header := _CLIXML_HEADER.search(stderr, search_position):
+        start = header.start()
+        xml_start = header.end()
+
+        # A header can be followed by a newline before the XML document.
+        while xml_start < len(stderr) and stderr[xml_start:xml_start + 1] in (b'\r', b'\n'):
+            xml_start += 1
+
+        if not re.match(rb'<Objs(?:\s|>)', stderr[xml_start:]):
+            search_position = header.end()
+            continue
+
+        end = stderr.find(b'</Objs>', xml_start)
+        if end == -1:
+            search_position = header.end()
+            continue
+        end += len(b'</Objs>')
+
+        try:
+            try:
+                xml = stderr[xml_start:end].decode('utf-8')
+            except UnicodeDecodeError:
+                xml = stderr[xml_start:end].decode('cp437')
+
+            # _parse_clixml ignores a missing or malformed element, so validate
+            # the entire document before replacing the original bytes.
+            ET.fromstring(xml)
+            replacement = _parse_clixml(xml.encode('utf-8'))
+        except (ET.ParseError, UnicodeError, ValueError):
+            search_position = header.end()
+            continue
+
+        output.extend(stderr[position:start])
+        output.extend(replacement)
+        position = end
+        search_position = end
+
+    output.extend(stderr[position:])
+    return bytes(output) if output != stderr else stderr
+
 
