+import { parseStringToDOM } from '@proton/shared/lib/helpers/dom';
+
+import { simplifyHTML } from './html';
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+import { replaceURLs, restoreURLs } from './url';
+
+it('moves sibling nested lists inside the preceding item and renders list Markdown', () => {
+    const dom = parseStringToDOM('<ul><li>Parent</li><ul><li>Child</li></ul><li>Next</li></ul>');
+    fixNestedLists(dom);
+    expect(dom.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    const markdown = htmlToMarkdown(dom);
+    const html = parseStringToDOM(markdownToHTML(markdown));
+    expect(html.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    expect(html.querySelectorAll('ul > li')).toHaveLength(3);
+});
+
+it('retains formatted link and image attributes through conversion and scoped restoration', () => {
+    const dom = parseStringToDOM(
+        '<a href="https://example.com" class="link" style="color: red">Text</a><img src="https://example.com/a.png" class="image" style="width: 20px">'
+    );
+    const markdown = htmlToMarkdown(replaceURLs(simplifyHTML(dom), 'uid', 'message-1'));
+    const result = restoreURLs(parseStringToDOM(markdownToHTML(markdown)), 'message-1');
+    expect(result.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+    expect(result.querySelector('a')?.getAttribute('class')).toBe('link');
+    expect(result.querySelector('a')?.getAttribute('style')).toBe('color: red');
+    expect(result.querySelector('img')?.getAttribute('src')).toBe('https://example.com/a.png');
+    expect(result.querySelector('img')?.getAttribute('class')).toBe('image');
+    expect(result.querySelector('img')?.getAttribute('style')).toBe('width: 20px');
+});
+
+it('keeps ordered list indentation and creates a containing item for an orphan nested list', () => {
+    const dom = parseStringToDOM('<ol><ul><li>Orphan</li></ul><li>Second</li></ol>');
+    fixNestedLists(dom);
+    expect(dom.querySelector('ol > li > ul > li')?.textContent).toBe('Orphan');
+    expect(markdownToHTML('1. First\n   1. Nested')).toContain('<ol>');
+});
