+# Copyright: Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from units.compat.mock import patch
+from units.modules.utils import set_module_args
+from ansible.modules.network.icx import icx_logging
+from .icx_module import TestICXModule
+
+
+CONFIG = '''
+logging host 192.0.2.1 udp-port 514
+logging host ipv6 2001:db8::1 udp-port 1514
+logging facility local7
+logging console
+logging buffered
+no logging buffered debugging
+logging persistence
+logging enable rfc5424
+'''
+
+
+class TestICXLoggingModule(TestICXModule):
+    module = icx_logging
+
+    def setUp(self):
+        super(TestICXLoggingModule, self).setUp()
+        self.config_patch = patch('ansible.modules.network.icx.icx_logging.get_config', return_value=CONFIG)
+        self.load_patch = patch('ansible.modules.network.icx.icx_logging.load_config')
+        self.get_config = self.config_patch.start()
+        self.load_config = self.load_patch.start()
+
+    def tearDown(self):
+        self.config_patch.stop()
+        self.load_patch.stop()
+        super(TestICXLoggingModule, self).tearDown()
+
+    def test_aggregate_host_and_facility(self):
+        set_module_args(dict(aggregate=[dict(dest='host', name='2001:db8::2', udp_port='5514'),
+                                        dict(dest='host', name='192.0.2.1', udp_port='514'),
+                                        dict(facility='local6')]))
+        self.execute_module(changed=True, commands=['logging host ipv6 2001:db8::2 udp-port 5514',
+                                                     'logging facility local6'])
+
+    def test_ipv6_removal_discovers_port(self):
+        set_module_args(dict(dest='host', name='2001:db8::1', state='absent'))
+        self.execute_module(changed=True, commands=['no logging host ipv6 2001:db8::1 udp-port 1514'])
+
+    def test_host_port_change(self):
+        set_module_args(dict(dest='host', name='192.0.2.1', udp_port='1514'))
+        self.execute_module(changed=True, commands=['no logging host 192.0.2.1 udp-port 514',
+                                                     'logging host 192.0.2.1 udp-port 1514'])
+
+    def test_buffered_levels(self):
+        set_module_args(dict(dest='buffered', level='debugging'))
+        self.execute_module(changed=True, commands=['logging buffered debugging'])
+        set_module_args(dict(dest='buffered', level='alerts', state='absent'))
+        self.execute_module(changed=True, commands=['no logging buffered alerts'])
+        set_module_args(dict(dest='buffered', level='debugging', state='absent'))
+        self.execute_module(changed=False, commands=[])
+
+    def test_facility_clear_and_console_disable(self):
+        set_module_args(dict(aggregate=[dict(facility='local7', state='absent'),
+                                        dict(dest='console', state='absent')]))
+        self.execute_module(changed=True, commands=['no logging facility', 'no logging console'])
+
+    def test_idempotent_and_check_mode(self):
+        set_module_args(dict(dest='host', name='2001:db8::1', udp_port='1514'))
+        self.execute_module(changed=False, commands=[])
+        set_module_args(dict(dest='on', state='absent', _ansible_check_mode=True))
+        self.execute_module(changed=True, commands=['no logging on'])
+        self.load_config.assert_not_called()
+
+    def test_global_off(self):
+        self.get_config.return_value = 'no logging on\n'
+        set_module_args(dict(dest='on', state='absent'))
+        self.execute_module(changed=False, commands=[])
+        set_module_args(dict(dest='on'))
+        self.execute_module(changed=True, commands=['logging on'])
+
+    def test_console_level_and_unchecked_removals(self):
+        self.get_config.return_value = 'logging console errors\n'
+        set_module_args(dict(dest='console', level='errors'))
+        self.execute_module(changed=False, commands=[])
+        set_module_args(dict(dest='console', level='warnings'))
+        self.execute_module(changed=True, commands=['logging console warnings'])
+        self.get_config.reset_mock()
+        set_module_args(dict(aggregate=[dict(dest='host', name='2001:db8::1', udp_port='1514', state='absent'),
+                                        dict(dest='buffered', level='debugging', state='absent'),
+                                        dict(dest='on', state='absent')], check_running_config=False))
+        self.execute_module(changed=True, commands=['no logging host ipv6 2001:db8::1 udp-port 1514',
+                                                     'no logging buffered debugging', 'no logging on'])
+        self.get_config.assert_not_called()
+
+    def test_required_fields(self):
+        set_module_args(dict(dest='host'))
+        self.execute_module(failed=True)
+        set_module_args(dict(aggregate=[dict(dest='buffered')]))
+        self.execute_module(failed=True)
