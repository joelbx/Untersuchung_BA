         self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
                                                              'address-family ipv4 unicast',
                                                              'route-target both auto evpn']))
+
+    def test_route_targets_mixed_and_idempotent(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 2:2
+    route-target both auto evpn
+  address-family ipv6 unicast
+    route-target import 3:3
+vrf context other
+  address-family ipv4 unicast
+    route-target export 3:3
+'''
+        args = dict(vrf='ntc', afi='ipv4', route_target_both_auto_evpn=False,
+                    route_targets=[dict(rt='1:1', direction='import'),
+                                   dict(rt='1:1', direction='export'),
+                                   dict(rt='2:2', direction='export', state='absent'),
+                                   dict(rt='3:3', state='absent'),
+                                   dict(rt='4:4')])
+        set_module_args(args)
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'no route-target both auto evpn',
+            'route-target export 1:1', 'no route-target export 2:2',
+            'route-target import 4:4', 'route-target export 4:4'])
+
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+    route-target export 1:1
+    route-target import 4:4
+    route-target export 4:4
+'''
+        set_module_args(args)
+        self.execute_module(changed=False, commands=[])
+
+    def test_route_targets_create_address_family(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', route_targets=[dict(rt='1:1')]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'address-family ipv4 unicast',
+            'route-target import 1:1', 'route-target export 1:1'])
+
+    def test_absent_ignores_route_target_options(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv4 unicast
+    route-target import 1:1
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='absent',
+                             route_target_both_auto_evpn=True,
+                             route_targets=[dict(rt='2:2')]))
+        self.execute_module(changed=True, sort=False, commands=[
+            'vrf context ntc', 'no address-family ipv4 unicast'])
+
+    def test_match_current_rt_uses_exact_line(self):
+        current = 'route-target import 1:10\nroute-target export 1:1\n'
+        commands = []
+        nxos_vrf_af.match_current_rt(dict(rt='1:1', state='present'),
+                                     'import', current, commands)
+        nxos_vrf_af.match_current_rt(dict(rt='1:1', state='absent'),
+                                     'import', current, commands)
+        self.assertEqual(commands, ['route-target import 1:1'])
+
+    def test_both_absent_removes_each_configured_direction(self):
+        self.get_config.return_value = '''vrf context ntc
+  address-family ipv6 unicast
+    route-target import 1:1
+    route-target export 2:2
+'''
+        set_module_args(dict(vrf='ntc', afi='ipv6', route_targets=[
+            dict(rt='1:1', state='absent'), dict(rt='2:2', state='absent')]))
+        self.execute_module(changed=True, sort=False, commands=[
