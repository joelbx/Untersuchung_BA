diff --git a/db/backup.go b/db/backup.go
new file mode 100644
index 0000000..5900290
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,173 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const backupPrefix = "navidrome_backup_"
+const backupSuffix = ".db"
+const backupTimestamp = "20060102T150405.000000000"
+
+// Backup creates an online, consistent snapshot of the main SQLite database.
+func (d *db) Backup(ctx context.Context) (string, error) {
+	if conf.Server.Backup.Path == "" {
+		return "", errors.New("backup.path is empty")
+	}
+	if err := os.MkdirAll(conf.Server.Backup.Path, 0755); err != nil {
+		return "", err
+	}
+	path := filepath.Join(conf.Server.Backup.Path, backupPrefix+time.Now().UTC().Format(backupTimestamp)+backupSuffix)
+	// A temporary file prevents incomplete snapshots from appearing in the backup list.
+	tmp, err := os.CreateTemp(conf.Server.Backup.Path, ".navidrome_backup_*.db")
+	if err != nil {
+		return "", err
+	}
+	tmpPath := tmp.Name()
+	_ = tmp.Close()
+	defer os.Remove(tmpPath)
+
+	src, err := d.readDB.Conn(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer src.Close()
+	dest, err := sql.Open(Driver, tmpPath)
+	if err != nil {
+		return "", err
+	}
+	if err := copySQLite(ctx, dest, src); err != nil {
+		_ = dest.Close()
+		return "", err
+	}
+	if err := dest.Close(); err != nil {
+		return "", err
+	}
+	if err := os.Rename(tmpPath, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+// Restore replaces the live main database with the contents of a SQLite backup.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if path == "" {
+		return errors.New("backup file is required")
+	}
+	if info, err := os.Stat(path); err != nil {
+		return err
+	} else if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file is not a regular file: %s", path)
+	}
+	if liveInfo, err := os.Stat(conf.Server.DbPath); err == nil {
+		if sourceInfo, err := os.Stat(path); err == nil && os.SameFile(liveInfo, sourceInfo) {
+			return errors.New("backup file is the live database")
+		}
+	}
+	// Open read-only to avoid silently creating an empty database on a bad path.
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	uri := (&url.URL{Scheme: "file", Path: absPath, RawQuery: "mode=ro"}).String()
+	src, err := sql.Open(Driver, uri)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	var result string
+	if err := src.QueryRowContext(ctx, "PRAGMA integrity_check").Scan(&result); err != nil {
+		return fmt.Errorf("invalid backup: %w", err)
+	}
+	if result != "ok" {
+		return fmt.Errorf("backup integrity check failed: %s", result)
+	}
+	srcConn, err := src.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+	return copySQLite(ctx, d.writeDB, srcConn)
+}
+
+// copySQLite copies the source main database into the destination using SQLite's online backup API.
+func copySQLite(ctx context.Context, dest *sql.DB, src *sql.Conn) error {
+	destConn, err := dest.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	return destConn.Raw(func(destRaw any) error {
+		return src.Raw(func(srcRaw any) error {
+			backup, err := destRaw.(*sqlite3.SQLiteConn).Backup("main", srcRaw.(*sqlite3.SQLiteConn), "main")
+			if err != nil {
+				return err
+			}
+			for {
+				if err := ctx.Err(); err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				done, err := backup.Step(128)
+				if err != nil {
+					_ = backup.Finish()
+					return err
+				}
+				if done {
+					return backup.Finish()
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+		})
+	})
+}
+
+// Prune removes old completed backups from the configured backup directory.
+func (d *db) Prune(ctx context.Context) (int, error) { return prune(ctx) }
+
+func prune(ctx context.Context) (int, error) {
+	if conf.Server.Backup.Path == "" {
+		return 0, errors.New("backup.path is empty")
+	}
+	if conf.Server.Backup.Count < 0 {
+		return 0, errors.New("backup.count must be nonnegative")
+	}
+	entries, err := os.ReadDir(conf.Server.Backup.Path)
+	if err != nil {
+		return 0, err
+	}
+	var names []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, backupSuffix) {
+			continue
+		}
+		stamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), backupSuffix)
+		if _, err := time.Parse(backupTimestamp, stamp); err == nil {
+			names = append(names, name)
+		}
+	}
+	sort.Sort(sort.Reverse(sort.StringSlice(names)))
+	removed := 0
+	for _, name := range names[min(conf.Server.Backup.Count, len(names)):] {
+		if err := ctx.Err(); err != nil {
+			return removed, err
+		}
+		if err := os.Remove(filepath.Join(conf.Server.Backup.Path, name)); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
