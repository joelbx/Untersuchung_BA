index 0000000..0acf045
--- /dev/null
+++ b/db/backup_test.go
@@ -0,0 +1,49 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBackupRestoreAndPrune(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	oldBackup, oldDB := conf.Server.Backup, conf.Server.DbPath
+	conf.Server.Backup.Path = filepath.Join(dir, "backups")
+	conf.Server.Backup.Count = 1
+	conf.Server.DbPath = filepath.Join(dir, "live.db")
+	t.Cleanup(func() { conf.Server.Backup, conf.Server.DbPath = oldBackup, oldDB })
+	require.NoError(t, os.MkdirAll(conf.Server.Backup.Path, 0755))
+	read, err := sql.Open(Driver, conf.Server.DbPath)
+	require.NoError(t, err)
+	write, err := sql.Open(Driver, conf.Server.DbPath)
+	require.NoError(t, err)
+	t.Cleanup(func() { read.Close(); write.Close() })
+	d := &db{readDB: read, writeDB: write}
+	_, err = write.Exec("CREATE TABLE sample (value TEXT); INSERT INTO sample VALUES ('before')")
+	require.NoError(t, err)
+	first, err := d.Backup(ctx)
+	require.NoError(t, err)
+	_, err = write.Exec("UPDATE sample SET value='after'")
+	require.NoError(t, err)
+	second, err := d.Backup(ctx)
+	require.NoError(t, err)
+	require.NotEqual(t, first, second)
+	require.NoError(t, d.Restore(ctx, first))
+	var value string
+	require.NoError(t, write.QueryRow("SELECT value FROM sample").Scan(&value))
+	require.Equal(t, "before", value)
+	count, err := d.Prune(ctx)
+	require.NoError(t, err)
+	require.Equal(t, 1, count)
+	_, err = os.Stat(second)
+	require.NoError(t, err)
+	_, err = os.Stat(first)
+	require.True(t, os.IsNotExist(err))
+}
