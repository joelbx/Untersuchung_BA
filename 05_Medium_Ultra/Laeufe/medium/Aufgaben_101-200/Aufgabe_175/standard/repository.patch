+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{Use: "backup", Short: "Manage database backups"}
+	backupCmd.AddCommand(&cobra.Command{
+		Use: "create", Short: "Create a database backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, err := db.Db().Backup(cmd.Context())
+			if err == nil {
+				fmt.Fprintln(cmd.OutOrStdout(), path)
+			}
+			return err
+		},
+	})
+	pruneCmd := &cobra.Command{
+		Use: "prune", Short: "Remove old database backups", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, _ := cmd.Flags().GetBool("force")
+			if conf.Server.Backup.Count == 0 && !force && !confirmBackupAction(cmd, "Delete all database backups?") {
+				return fmt.Errorf("backup pruning cancelled")
+			}
+			n, err := db.Db().Prune(cmd.Context())
+			if err == nil {
+				fmt.Fprintf(cmd.OutOrStdout(), "Removed %d backups\n", n)
+			}
+			return err
+		},
+	}
+	pruneCmd.Flags().Bool("force", false, "skip confirmation")
+	backupCmd.AddCommand(pruneCmd)
+	restoreCmd := &cobra.Command{
+		Use: "restore", Short: "Restore the database from a backup", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, _ := cmd.Flags().GetString("backup-file")
+			force, _ := cmd.Flags().GetBool("force")
+			if !force && !confirmBackupAction(cmd, "Restore database from "+path+"?") {
+				return fmt.Errorf("database restore cancelled")
+			}
+			if err := db.Db().Restore(cmd.Context(), path); err != nil {
+				return err
+			}
+			fmt.Fprintln(cmd.OutOrStdout(), "Database restored")
+			return nil
+		},
+	}
+	restoreCmd.Flags().String("backup-file", "", "SQLite backup file to restore")
+	_ = restoreCmd.MarkFlagRequired("backup-file")
+	restoreCmd.Flags().Bool("force", false, "skip confirmation")
+	backupCmd.AddCommand(restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+func confirmBackupAction(cmd *cobra.Command, prompt string) bool {
+	fmt.Fprintf(cmd.OutOrStdout(), "%s [y/N] ", prompt)
+	line, err := bufio.NewReader(cmd.InOrStdin()).ReadString('\n')
+	if err != nil {
+		return false
+	}
+	return strings.EqualFold(strings.TrimSpace(line), "y") || strings.EqualFold(strings.TrimSpace(line), "yes")
+}
