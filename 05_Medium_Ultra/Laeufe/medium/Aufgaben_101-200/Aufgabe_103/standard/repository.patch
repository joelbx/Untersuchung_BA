+func TestInstalledPackagesEmptyRelease(t *testing.T) {
+	tests := []struct {
+		name, line, version, repository string
+		fromRepoquery                   bool
+	}{
+		{"rpm no epoch", "package 0 1  x86_64 package-1--src.rpm", "1", "", false},
+		{"rpm epoch", "package 2 1  x86_64 package-1--src.rpm", "2:1", "", false},
+		{"repoquery no epoch", "package (none) 1  x86_64 package-1--src.rpm @amzn2-core", "1", "amzn2-core", true},
+		{"repoquery epoch", "package 2 1  x86_64 package-1--src.rpm installed", "2:1", "amzn2-core", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			o := &redhatBase{}
+			var bp *models.Package
+			var sp *models.SrcPackage
+			var err error
+			if tt.fromRepoquery {
+				bp, sp, err = o.parseInstalledPackagesLineFromRepoquery(tt.line)
+			} else {
+				bp, sp, err = o.parseInstalledPackagesLine(tt.line)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if bp.Name != "package" || bp.Version != tt.version || bp.Release != "" || bp.Arch != "x86_64" || bp.Repository != tt.repository {
+				t.Errorf("incorrect binary package: %+v", bp)
+			}
+			if sp == nil || sp.Name != "package" || sp.Version != tt.version || sp.Arch != "src" || !reflect.DeepEqual(sp.BinaryNames, []string{"package"}) {
+				t.Errorf("incorrect source package: %+v", sp)
+			}
+		})
+	}
+	for _, tt := range []struct {
+		name, line string
+	}{
+		{"rpm", "package 0 1  x86_64 package-1--src.rpm"},
+		{"repoquery", "package 0 1  x86_64 package-1--src.rpm @amzn2-core"},
+	} {
+		t.Run("full "+tt.name, func(t *testing.T) {
+			o := &redhatBase{base: base{Distro: config.Distro{Family: constant.Amazon, Release: "2 (Karoo)"}, log: logging.NewIODiscardLogger()}}
+			bp, sp, err := o.parseInstalledPackages(tt.line)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if bp["package"].Version != "1" || bp["package"].Release != "" || sp["package"].Version != "1" {
+				t.Errorf("incorrect packages: binary=%+v source=%+v", bp, sp)
+			}
+		})
+	}
+}
