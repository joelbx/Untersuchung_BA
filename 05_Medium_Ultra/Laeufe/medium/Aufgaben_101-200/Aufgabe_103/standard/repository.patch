+// rpmQueryFields keeps empty space-delimited fields, including an empty release.
+// Tabs are also used as separators by rpm -qf output.
+func rpmQueryFields(line string) []string {
+	return strings.Split(strings.ReplaceAll(line, "\t", " "), " ")
+}
+
+// rpmVersion builds an epoch:version-release string, omitting absent parts.
+func rpmVersion(epoch, version, release string) string {
+	if epoch != "0" && epoch != "(none)" {
+		version = epoch + ":" + version
+	}
+	if release != "" {
+		version += "-" + release
+	}
+	return version
+}
