+func TestSplitFileNameValidation(t *testing.T) {
+	for _, tt := range []struct {
+		filename, name, version, release, epoch, arch string
+	}{
+		{"package-0-1-src.rpm", "package", "0", "1", "", "src"},
+		{"package-0-1.el9-src.rpm", "package", "0", "1.el9", "", "src"},
+		{"package-0--src.rpm", "package", "0", "", "", "src"},
+		{"package-0-.src.rpm", "package", "0", "", "", "src"},
+		{"name-with-hyphens-0-1.src.rpm", "name-with-hyphens", "0", "1", "", "src"},
+		{"2:name-with-hyphens-0-1.src.rpm", "name-with-hyphens", "0", "1", "2", "src"},
+	} {
+		t.Run(tt.filename, func(t *testing.T) {
+			n, v, r, e, a, err := splitFileName(tt.filename)
+			if err != nil || n != tt.name || v != tt.version || r != tt.release || e != tt.epoch || a != tt.arch {
+				t.Errorf("got %q %q %q %q %q, %v", n, v, r, e, a, err)
+			}
+		})
+	}
+	for _, filename := range []string{"package-0-1-src", "-0-1.src.rpm", "package--1.src.rpm", "package-0.src.rpm", "package-0-1..rpm", "package-0-1.src.rpm.bak", "bad:package-0-1.src.rpm"} {
+		t.Run("invalid "+filename, func(t *testing.T) {
+			if _, _, _, _, _, err := splitFileName(filename); err == nil {
+				t.Errorf("accepted malformed filename %q", filename)
+			}
+		})
+	}
+}
