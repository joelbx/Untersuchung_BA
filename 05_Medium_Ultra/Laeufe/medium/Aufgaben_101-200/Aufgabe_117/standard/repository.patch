+def _get_locale_pak_path(locales_dir: pathlib.Path, locale: str) -> pathlib.Path:
+    """Return the QtWebEngine resource path for a Chromium locale name."""
+    return locales_dir / (locale + '.pak')
+
+
+def _get_lang_override(
+        versions: version.WebEngineVersions, locale: str,
+) -> Optional[str]:
+    """Find a usable Chromium locale when QtWebEngine's locale file is absent."""
+    if (not config.val.qt.workarounds.locale or not utils.is_linux or
+            versions.webengine != utils.VersionNumber(5, 15, 3)):
+        return None
+
+    translations_dir = QLibraryInfo.location(QLibraryInfo.TranslationsPath)
+    locales_dir = pathlib.Path(translations_dir) / 'qtwebengine_locales'
+    locale = locale.replace('_', '-')
+    if _get_locale_pak_path(locales_dir, locale).is_file():
+        return None
+
+    language, _, territory = locale.partition('-')
+    fallback = None
+    if language == 'en':
+        fallback = 'en-US' if territory in ('', 'LR', 'PH', 'US') else 'en-GB'
+    elif language == 'es':
+        fallback = 'es' if territory in ('', 'ES') else 'es-419'
+    elif language == 'pt':
+        fallback = 'pt-BR' if territory in ('', 'BR') else 'pt-PT'
+    elif language == 'zh':
+        fallback = 'zh-TW' if territory in ('TW', 'HK', 'MO') else 'zh-CN'
+
+    for candidate in (fallback, language, 'en-US'):
+        if candidate and _get_locale_pak_path(locales_dir, candidate).is_file():
+            return candidate
+    return 'en-US'
+
+
