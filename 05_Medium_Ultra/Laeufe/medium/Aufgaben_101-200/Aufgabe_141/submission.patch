diff --git a/wordpress/wordpress_test.go b/wordpress/wordpress_test.go
new file mode 100644
index 0000000..09beeb4
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,32 @@
+package wordpress
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestRemoveInactives(t *testing.T) {
+	core := models.WpPackage{Name: models.WPCore, Type: models.WPCore}
+	active := models.WpPackage{Name: "active-plugin", Type: models.WPPlugin, Status: "active"}
+	mustUse := models.WpPackage{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"}
+	inactive := models.WpPackage{Name: "unused-theme", Type: models.WPTheme, Status: models.Inactive}
+
+	tests := []struct {
+		name string
+		in   models.WordPressPackages
+		want models.WordPressPackages
+	}{
+		{name: "mixed", in: models.WordPressPackages{core, inactive, active, mustUse}, want: models.WordPressPackages{core, active, mustUse}},
+		{name: "all inactive", in: models.WordPressPackages{inactive}, want: nil},
+		{name: "empty", in: nil, want: nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := removeInactives(tt.in); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("removeInactives() = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
