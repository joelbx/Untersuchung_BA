+func (s *AuthSuite) TestRemoteClusterHeartbeatSurvivesTunnelRemoval(c *C) {
+	const clusterName = "remote.example.com"
+	now := time.Date(2020, 1, 2, 3, 4, 5, 0, time.UTC)
+	s.a.SetClock(clockwork.NewFakeClockAt(now))
+
+	rc, err := services.NewRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	c.Assert(s.a.Presence.CreateRemoteCluster(rc), IsNil)
+
+	checkCluster := func(status string, heartbeat time.Time) {
+		cluster, err := s.a.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(cluster.GetConnectionStatus(), Equals, status)
+		c.Assert(cluster.GetLastHeartbeat(), DeepEquals, heartbeat)
+		stored, err := s.a.Presence.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(stored.GetConnectionStatus(), Equals, status)
+		c.Assert(stored.GetLastHeartbeat(), DeepEquals, heartbeat)
+	}
+
+	checkCluster(teleport.RemoteClusterStatusOffline, time.Time{})
+	older := now.Add(-2 * time.Second)
+	newer := now.Add(-time.Second)
+	for _, conn := range []struct {
+		name      string
+		heartbeat time.Time
+	}{
+		{"older", older},
+		{"newer", newer},
+	} {
+		tunnel, err := services.NewTunnelConnection(conn.name, services.TunnelConnectionSpecV2{
+			ClusterName: clusterName, ProxyName: "proxy", LastHeartbeat: conn.heartbeat,
+		})
+		c.Assert(err, IsNil)
+		c.Assert(s.a.Presence.UpsertTunnelConnection(tunnel), IsNil)
+		checkCluster(teleport.RemoteClusterStatusOnline, conn.heartbeat)
+	}
+
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, "newer"), IsNil)
+	checkCluster(teleport.RemoteClusterStatusOnline, newer)
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, "older"), IsNil)
+	checkCluster(teleport.RemoteClusterStatusOffline, newer)
+}
