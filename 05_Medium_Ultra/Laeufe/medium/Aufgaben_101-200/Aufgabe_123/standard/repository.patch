diff --git a/packages/components/containers/notifications/manager.test.tsx b/packages/components/containers/notifications/manager.test.tsx
new file mode 100644
index 0000000..c874efb
--- /dev/null
+++ b/packages/components/containers/notifications/manager.test.tsx
@@ -0,0 +1,69 @@
+import { NotificationOptions } from './interfaces';
+import createManager from './manager';
+
+describe('notification manager', () => {
+    let notifications: NotificationOptions[];
+    let manager: ReturnType<typeof createManager>;
+
+    beforeEach(() => {
+        notifications = [];
+        manager = createManager((update) => {
+            notifications = typeof update === 'function' ? update(notifications) : update;
+        });
+    });
+
+    afterEach(() => manager.clearNotifications());
+
+    it('deduplicates non-success string notifications by text', () => {
+        manager.createNotification({ text: 'Problem', type: 'error' });
+        manager.createNotification({ text: 'Problem', type: 'info' });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ text: 'Problem', type: 'info', key: 'Problem' });
+    });
+
+    it('uses explicit keys for React content', () => {
+        manager.createNotification({ text: <b>First</b>, key: 'shared', type: 'error' });
+        manager.createNotification({ text: <b>Second</b>, key: 'shared', type: 'warning' });
+
+        expect(notifications).toHaveLength(1);
+        expect(notifications[0]).toMatchObject({ key: 'shared', type: 'warning' });
+    });
+
+    it('uses explicit keys instead of string text for deduplication', () => {
+        manager.createNotification({ text: 'Same', key: 'first', type: 'error' });
+        manager.createNotification({ text: 'Same', key: 'second', type: 'error' });
+        manager.createNotification({ text: 'Different', key: 'first', type: 'error' });
+
+        expect(notifications).toHaveLength(2);
+        expect(notifications.find(({ key }) => key === 'first')?.text).toBe('Different');
+    });
+
+    it('uses the identifier when React content has no key', () => {
+        manager.createNotification({ text: <b>Same</b>, type: 'error' });
+        manager.createNotification({ text: <b>Same</b>, type: 'error' });
+
+        expect(notifications).toHaveLength(2);
+        expect(notifications.map(({ id, key }) => key === id)).toEqual([true, true]);
+    });
+
+    it('uses string text when an undefined key is passed', () => {
+        manager.createNotification({ text: 'Problem', key: undefined, type: 'error' });
+
+        expect(notifications[0].key).toBe('Problem');
+    });
+
+    it('allows repeated success notifications', () => {
+        manager.createNotification({ text: 'Done', key: 'shared', type: 'success' });
+        manager.createNotification({ text: 'Done', key: 'shared', type: 'success' });
+
+        expect(notifications).toHaveLength(2);
+    });
+
+    it('does not deduplicate an error against an existing success', () => {
+        manager.createNotification({ text: 'Same', type: 'success' });
+        manager.createNotification({ text: 'Same', type: 'error' });
+
+        expect(notifications).toHaveLength(2);
+    });
+});
