@@ -0,0 +1,39 @@
+import { ReactNode } from 'react';
+import { render } from '@testing-library/react';
+import Notification from './Notification';
+
+const renderNotification = (children: ReactNode) =>
+    render(
+        <Notification type="error" isClosing={false} onExit={() => {}}>
+            {children}
+        </Notification>
+    );
+
+describe('Notification', () => {
+    it('renders safe HTML with secure links', () => {
+        const { container } = renderNotification(
+            '<b>Help</b> <a href="https://example.com" target="_self" onclick="alert(1)">read more</a><script>alert(1)</script>'
+        );
+        const link = container.querySelector('a');
+
+        expect(container.querySelector('b')).toHaveTextContent('Help');
+        expect(link).toHaveAttribute('href', 'https://example.com');
+        expect(link).toHaveAttribute('target', '_blank');
+        expect(link).toHaveAttribute('rel', 'noopener noreferrer');
+        expect(link).not.toHaveAttribute('onclick');
+        expect(container.querySelector('script')).toBeNull();
+    });
+
+    it('removes unsafe link URLs', () => {
+        const { container } = renderNotification('<a href="javascript:alert(1)">bad link</a>');
+
+        expect(container.querySelector('a')).not.toHaveAttribute('href');
+    });
+
+    it('secures links supplied as React elements', () => {
+        const { container } = renderNotification(<a href="https://example.com">React link</a>);
+
+        expect(container.querySelector('a')).toHaveAttribute('target', '_blank');
+        expect(container.querySelector('a')).toHaveAttribute('rel', 'noopener noreferrer');
+    });
+});
