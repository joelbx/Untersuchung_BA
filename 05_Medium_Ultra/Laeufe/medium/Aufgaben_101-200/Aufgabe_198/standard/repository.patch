+func TestConvertToDistroAdvisory(t *testing.T) {
+	tests := []struct {
+		family, title, want string
+	}{
+		{"redhat", "RHSA-2024:1234: update", "RHSA-2024:1234"},
+		{"centos", "RHBA-2024:1234: update", "RHBA-2024:1234"},
+		{"alma", "RHSA-2024:1234 update", "RHSA-2024:1234"},
+		{"rocky", "RHBA-2024:1234 update", "RHBA-2024:1234"},
+		{"oracle", "ELSA-2024-1234 update", "ELSA-2024-1234"},
+		{"amazon", "ALAS2-2024-1234: update", "ALAS2-2024-1234"},
+		{"fedora", "FEDORA-2024-1234 update", "FEDORA-2024-1234"},
+		{"redhat", "RHEA-2024:1234 update", ""},
+		{"oracle", "RHSA-2024:1234 update", ""},
+		{"amazon", "unrelated", ""},
+		{"fedora", "", ""},
+	}
+	for _, tt := range tests {
+		got := (RedHatBase{Base: Base{family: tt.family}}).convertToDistroAdvisory(&ovalmodels.Definition{Title: tt.title})
+		if tt.want == "" {
+			if got != nil {
+				t.Errorf("%s %q: expected nil, got %q", tt.family, tt.title, got.AdvisoryID)
+			}
+		} else if got == nil || got.AdvisoryID != tt.want {
+			t.Errorf("%s %q: expected %q, got %v", tt.family, tt.title, tt.want, got)
+		}
+	}
+}
+
+func TestUnfixedOvalResolution(t *testing.T) {
+	for _, tt := range []struct {
+		state    string
+		affected bool
+	}{
+		{"Will not fix", false},
+		{"Under investigation", false},
+		{"Fix deferred", true},
+		{"Affected", true},
+		{"Out of support scope", true},
+		{"", true},
+	} {
+		def := ovalmodels.Definition{AffectedPacks: []ovalmodels.Package{{Name: "pkg", NotFixedYet: true}}}
+		if tt.state != "" {
+			def.Advisory.AffectedResolution = []ovalmodels.Resolution{{State: tt.state, Components: []ovalmodels.Component{{Component: "other"}, {Component: "pkg"}}}}
+		}
+		affected, unfixed, state, _, err := isOvalDefAffected(def, request{packName: "pkg"}, "redhat", "9", models.Kernel{}, nil)
+		if err != nil || affected != tt.affected || !unfixed || state != tt.state {
+			t.Errorf("state %q: got affected=%v unfixed=%v state=%q err=%v", tt.state, affected, unfixed, state, err)
+		}
+	}
+}
+
+func TestRedHatUpdateCarriesFixState(t *testing.T) {
+	result := models.ScanResult{ScannedCves: models.VulnInfos{}}
+	packs := defPacks{
+		def: ovalmodels.Definition{
+			Title:    "unsupported definition",
+			Advisory: ovalmodels.Advisory{Cves: []ovalmodels.Cve{{CveID: "CVE-2024-1234"}}},
+		},
+		binpkgFixstat: map[string]fixStat{
+			"pkg": {notFixedYet: true, fixState: "Fix deferred"},
+		},
+	}
+	RedHat{RedHatBase{Base{family: "redhat"}}}.update(&result, packs)
+	vuln := result.ScannedCves["CVE-2024-1234"]
+	if len(vuln.DistroAdvisories) != 0 {
+		t.Errorf("unexpected advisory: %v", vuln.DistroAdvisories)
+	}
+	want := models.PackageFixStatuses{{Name: "pkg", NotFixedYet: true, FixState: "Fix deferred"}}
+	if !reflect.DeepEqual(vuln.AffectedPackages, want) {
+		t.Errorf("package statuses: got %v, want %v", vuln.AffectedPackages, want)
+	}
+}
