+++ b/openlibrary/coverstore/tests/test_archive.py
@@ -0,0 +1,107 @@
+import os
+import zipfile
+
+import pytest
+
+from openlibrary.coverstore import archive, config
+
+
+def test_cover_url_and_batch_layout(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    assert archive.Cover.id_to_item_and_batch_id(8_819_999) == ('0008', '81')
+    assert archive.Batch(8, 81)._norm_ids() == ('0008', '81')
+    assert archive.Batch.get_relpath(8, 81, 'm') == os.path.join(
+        'items', 'm_covers_0008', 'm_covers_0008_81.zip'
+    )
+    assert archive.Cover.get_cover_url(8_819_999, 'm') == (
+        'https://archive.org/download/m_covers_0008/m_covers_0008_81.zip/'
+        '0008819999-M.jpg'
+    )
+    assert archive.CoverDB._get_batch_end_id(8_810_123) == 8_819_999
+    with pytest.raises(ValueError, match='ten digits'):
+        archive.Cover.id_to_item_and_batch_id(10_000_000_000)
+
+
+def test_zip_manager_can_resume_without_duplicates(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    source = tmp_path / 'cover.jpg'
+    source.write_bytes(b'image')
+    path = archive.Batch.get_abspath(8, 81, 's')
+    for _ in range(2):
+        manager = archive.ZipManager()
+        manager.add_file('0008819999-S.jpg', str(source), 1_700_000_000)
+        manager.close()
+    with zipfile.ZipFile(path) as zf:
+        assert zf.compression == zipfile.ZIP_STORED
+        assert zf.namelist() == ['0008819999-S.jpg']
+        assert zf.read('0008819999-S.jpg') == b'image'
+    assert archive.count_files_in_zip(path) == 1
+
+
+def test_pending_batch_requires_all_remote_files(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    batch = archive.Batch(8, 81)
+    for size in archive.SIZES:
+        path = batch.get_abspath(8, 81, size)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with zipfile.ZipFile(path, 'w'):
+            pass
+
+    class FakeUploader:
+        def __init__(self):
+            self.uploaded = set()
+
+        def is_uploaded(self, item, filename):
+            return (item, filename) in self.uploaded
+
+        def upload(self, item, paths):
+            self.uploaded.add((item, os.path.basename(paths[0])))
+
+    uploader = FakeUploader()
+    assert batch.process_pending(uploader=uploader) is False
+    assert batch.process_pending(upload=True, test=False, uploader=uploader) is True
+    assert len(uploader.uploaded) == 4
+
+
+def test_completed_batch_updates_only_eligible_rows(monkeypatch):
+    import web
+    from openlibrary.coverstore import db
+
+    class Transaction:
+        def __init__(self):
+            self.committed = False
+
+        def commit(self):
+            self.committed = True
+
+        def rollback(self):
+            raise AssertionError('unexpected rollback')
+
+    class FakeDB:
+        def __init__(self):
+            self.updates = []
+            self.tx = Transaction()
+
+        def select(self, table, **kwargs):
+            assert table == 'cover'
+            assert kwargs['vars']['start'] == 8_810_000
+            assert kwargs['vars']['end'] == 8_819_999
+            return [web.storage(id=8_819_999, filename='local.jpg', archived=True,
+                                failed=False, uploaded=False)]
+
+        def transaction(self):
+            return self.tx
+
+        def update(self, table, **kwargs):
+            self.updates.append(kwargs)
+
+    fake = FakeDB()
+    monkeypatch.setattr(db, 'getdb', lambda: fake)
+    records = archive.CoverDB.update_completed_batch(8, 81)
+    assert len(records) == 1
+    assert fake.tx.committed
+    assert len(fake.updates) == 1
+    update = fake.updates[0]
+    assert update['vars']['f'] is False
+    assert update['uploaded'] is True
+    assert update['filename_m'].endswith('/0008819999-M.jpg')
