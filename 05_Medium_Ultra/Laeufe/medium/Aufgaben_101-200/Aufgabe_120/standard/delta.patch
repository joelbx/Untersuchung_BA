+            filename = d.get('filename' + (f'_{size.lower()}' if size else ''))
+            if filename:
+                raise web.found(filename)
+
+        # The older cover cluster has its own layout for large originals.
+        if size in ("L", "") and self.is_cover_in_cluster(value):
+            raise web.found(zipview_url_from_id(int(value), size))
+
+        # Older rows retain tar offsets. Use the recorded archive name to
+        # locate the member when the staged tar is no longer on this server.
+        filename = d.get('filename' + (f'_{size.lower()}' if size else ''))
+        if filename and '.tar:' in filename:
+            from openlibrary.coverstore.coverlib import find_image_path
+
+            if not os.path.isfile(find_image_path(filename).split(':', 1)[0]):
+                from openlibrary.coverstore.archive import Cover
+
+                item_id, batch_id = Cover.id_to_item_and_batch_id(d.id)
+                prefix = f'{size.lower()}_' if size else ''
+                item = f'{prefix}covers_{item_id}'
+                tarname = filename.split(':', 1)[0]
+                suffix = f'-{size}' if size else ''
+                member = f'{d.id:010d}{suffix}.jpg'
+                raise web.found(f'{web.ctx.protocol}://archive.org/download/{item}/{tarname}/{member}')
+
         # set cache-for-ever headers only when requested with ID
         if key == 'id':
             etag = f"{d.id}-{size.lower()}"
