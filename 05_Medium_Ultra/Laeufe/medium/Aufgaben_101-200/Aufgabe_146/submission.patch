         return dmi_facts
 
+    def get_sysinfo_facts(self):
+        """Read IBM Z hardware identification from /proc/sysinfo."""
+        if not os.path.exists('/proc/sysinfo'):
+            return {}
+
+        sysinfo_facts = {
+            'system_vendor': 'NA',
+            'product_name': 'NA',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        }
+        fields = {
+            'Manufacturer': 'system_vendor',
+            'Type': 'product_name',
+            'Sequence Code': 'product_serial',
+        }
+        for line in get_file_lines('/proc/sysinfo'):
+            label, separator, value = line.partition(':')
+            if separator and label in fields:
+                value = value.strip()
+                if label == 'Sequence Code':
+                    value = value.lstrip('0')
+                sysinfo_facts[fields[label]] = value
+
+        return sysinfo_facts
+
