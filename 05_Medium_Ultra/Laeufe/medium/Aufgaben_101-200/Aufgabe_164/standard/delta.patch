+func TestImport_NestedMetadataAndJSONHeader(t *testing.T) {
+	const yamlInput = `namespace:
+  key: team
+  name: Team
+  description: Team flags
+flags:
+  - key: feature
+    enabled: true
+    metadata:
+      owner:
+        name: Alice
+        groups:
+          - ops
+          - dev
+      settings:
+        - active: true
+    variants:
+      - key: control
+        attachment:
+          nested:
+            - value: 1
+`
+	const jsonInput = `{"namespace":{"key":"team","name":"Team","description":"Team flags"},"flags":[{"key":"feature","enabled":true,"metadata":{"owner":{"name":"Alice","groups":["ops","dev"]},"settings":[{"active":true}]},"variants":[{"key":"control","attachment":{"nested":[{"value":1}]}}]}]}`
+
+	for _, tc := range []struct {
+		name  string
+		enc   Encoding
+		input string
+	}{
+		{"yaml", EncodingYAML, yamlInput},
+		{"json", EncodingJSON, jsonInput},
+		{"json with export header", EncodingJSON, "# exported by Flipt\n\n" + jsonInput},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			creator := &mockCreator{getNSErr: status.Error(codes.NotFound, "not found")}
+			err := NewImporter(creator).Import(context.Background(), tc.enc, bytes.NewBufferString(tc.input), false)
+			require.NoError(t, err)
+			require.Len(t, creator.createNSReqs, 1)
+			assert.Equal(t, &flipt.CreateNamespaceRequest{Key: "team", Name: "Team", Description: "Team flags"}, creator.createNSReqs[0])
+			require.Len(t, creator.createflagReqs, 1)
+			assert.Equal(t, "team", creator.createflagReqs[0].NamespaceKey)
+			assert.Equal(t, map[string]any{
+				"owner":    map[string]any{"name": "Alice", "groups": []any{"ops", "dev"}},
+				"settings": []any{map[string]any{"active": true}},
+			}, creator.createflagReqs[0].Metadata.AsMap())
+			require.Len(t, creator.variantReqs, 1)
+			assert.JSONEq(t, `{"nested":[{"value":1}]}`, creator.variantReqs[0].Attachment)
+		})
+	}
+}
+
+func TestImport_JSONHeaderOnlyOnFirstLine(t *testing.T) {
+	for _, input := range []string{
+		" # header\n{}",
+		"# first header\n# second header\n{}",
+	} {
+		err := NewImporter(&mockCreator{}).Import(context.Background(), EncodingJSON, bytes.NewBufferString(input), false)
+		require.ErrorContains(t, err, "unmarshalling document")
+	}
+}
