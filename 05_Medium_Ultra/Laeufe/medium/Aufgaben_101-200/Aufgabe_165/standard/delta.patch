+export interface AllowedEncryptionSetting {
+    allowChange: boolean;
+    forcedValue?: boolean;
+}
+
+/** Resolve server and .well-known policies before exposing the encryption choice to a user. */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const forceDisabled = shouldForceDisableEncryption(client);
+    const forceEnabled = await client.doesServerForceEncryptionForPreset(chatPreset);
+
+    if (forceEnabled) {
+        if (forceDisabled)
+            console.warn("Conflicting encryption policies: server requires encryption; .well-known disables it.");
+        return { allowChange: false, forcedValue: true };
+    }
+    if (forceDisabled) return { allowChange: false, forcedValue: false };
+    return { allowChange: true };
+}
+
