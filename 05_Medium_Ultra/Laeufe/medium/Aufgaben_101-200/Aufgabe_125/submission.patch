 const db = require('../database');
 const user = require('../user');
@@ -15,6 +16,49 @@ module.exports = function (Topics) {
 	Topics.onNewPostMade = async function (postData) {
 		await Topics.updateLastPostTime(postData.tid, postData.timestamp);
 		await Topics.addPostToTopic(postData.tid, postData);
+		await Topics.syncBacklinks(postData);
+	};
+
+	Topics.syncBacklinks = async function (postData) {
+		if (!postData || !postData.pid || postData.uid === undefined || !postData.tid || typeof postData.content !== 'string') {
+			throw new Error('[[error:invalid-data]]');
+		}
+
+		const baseUrl = String(nconf.get('url') || '').replace(/\/$/, '');
+		const escapedUrl = baseUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+		const linkPattern = new RegExp(`(?:${escapedUrl}/topic/|(?<![\\w/:])/topic/)(\\d+)(?=/|[^\\w]|$)`, 'g');
+		const references = new Set();
+		for (const match of postData.content.matchAll(linkPattern)) {
+			const tid = parseInt(match[1], 10);
+			if (tid !== parseInt(postData.tid, 10)) {
+				references.add(tid);
+			}
+		}
+
+		const key = `pid:${postData.pid}:backlinks`;
+		const previous = (await db.getSortedSetRange(key, 0, -1)).map(String);
+		const valid = references.size ? await Topics.exists([...references]) : [];
+		const current = [...references].filter((tid, index) => valid[index]).map(String);
+		const removed = previous.filter(tid => !current.includes(tid));
+		const added = current.filter(tid => !previous.includes(tid));
+
+		await Promise.all(removed.map(async (tid) => {
+			// An association can be removed even after its target topic has been deleted.
+			const eventIds = await db.getSortedSetRange(`topic:${tid}:events`, 0, -1);
+			const events = await db.getObjects(eventIds.map(id => `topicEvent:${id}`));
+			const obsoleteIds = eventIds.filter((id, index) => events[index] && events[index].type === 'backlink' && events[index].href === `/post/${postData.pid}`);
+			if (obsoleteIds.length) {
+				await Topics.events.purge(tid, obsoleteIds);
+			}
+		}));
+		if (removed.length) {
+			await db.sortedSetRemove(key, removed);
+		}
+		await Promise.all(added.map(async (tid) => {
+			await Topics.events.log(tid, { type: 'backlink', href: `/post/${postData.pid}`, uid: postData.uid });
+			await db.sortedSetAdd(key, Date.now(), tid);
+		}));
+		return added.length + removed.length;
 	};
 
 	Topics.getTopicPosts = async function (tid, set, start, stop, uid, reverse) {
