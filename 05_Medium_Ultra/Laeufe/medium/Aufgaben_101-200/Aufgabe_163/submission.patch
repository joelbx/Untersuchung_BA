+		{"postgres defaults", DatabaseConfig{Protocol: Postgres, Host: "localhost", User: "reader", Password: "a@b", Name: "flipt"}, "postgres://reader:a%40b@localhost:5432/flipt", ""},
+		{"mysql defaults", DatabaseConfig{Protocol: MySQL, Host: "localhost", Name: "flipt"}, "mysql://localhost:3306/flipt", ""},
+		{"sqlite path", DatabaseConfig{Protocol: SQLite, Path: "/tmp", Name: "flipt.db"}, "file:/tmp/flipt.db", ""},
+		{"missing protocol", DatabaseConfig{}, "", "db.protocol"},
+		{"missing name", DatabaseConfig{Protocol: MySQL}, "", "db.name"},
+		{"missing host", DatabaseConfig{Protocol: Postgres, Name: "flipt"}, "", "db.host"},
+		{"missing sqlite path", DatabaseConfig{Protocol: SQLite, Name: "flipt.db"}, "", "db.path"},
+		{"bad port", DatabaseConfig{Protocol: MySQL, Host: "localhost", Name: "flipt", Port: -1}, "", "db.port"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.cfg.ConnectionURL()
+			if tt.err != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
