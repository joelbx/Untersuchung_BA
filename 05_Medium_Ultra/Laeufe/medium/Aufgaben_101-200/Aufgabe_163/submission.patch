+func TestLoadDatabaseFields(t *testing.T) {
+	f, err := ioutil.TempFile("", "flipt-db-*.yml")
+	require.NoError(t, err)
+	defer func() { f.Close(); _ = os.Remove(f.Name()) }()
+	_, err = f.WriteString("db:\n  url: ''\n  protocol: postgres\n  host: localhost\n  user: reader\n  password: secret\n  name: flipt\n")
+	require.NoError(t, err)
+	cfg, err := Load(f.Name())
+	require.NoError(t, err)
+	assert.Equal(t, Postgres, cfg.Database.Protocol)
+	assert.Equal(t, "secret", cfg.Database.Password)
+	assert.Equal(t, "", cfg.Database.URL)
+	_, err = f.Seek(0, 0)
+	require.NoError(t, err)
+	require.NoError(t, f.Truncate(0))
+	_, err = f.WriteString("db:\n  url: file:legacy.db\n  protocol: mysql\n  port: nonsense\n  password: ignored\n")
+	require.NoError(t, err)
+	cfg, err = Load(f.Name())
+	require.NoError(t, err)
+	assert.Equal(t, "file:legacy.db", cfg.Database.URL)
+	assert.Empty(t, cfg.Database.Password)
+	_, err = f.Seek(0, 0)
+	require.NoError(t, err)
+	require.NoError(t, f.Truncate(0))
+	_, err = f.WriteString("db:\n  protocol: invalid\n  password: secret\n")
+	require.NoError(t, err)
+	_, err = Load(f.Name())
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "db.protocol")
+	assert.Contains(t, err.Error(), "invalid")
