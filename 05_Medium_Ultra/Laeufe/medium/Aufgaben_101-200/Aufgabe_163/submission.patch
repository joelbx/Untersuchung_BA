+// DatabaseProtocol identifies a supported database engine.
+type DatabaseProtocol uint8
+
+const (
+	SQLite DatabaseProtocol = iota + 1
+	Postgres
+	MySQL
+)
+
+func (p DatabaseProtocol) String() string {
+	switch p {
+	case SQLite:
+		return "sqlite3"
+	case Postgres:
+		return "postgres"
+	case MySQL:
+		return "mysql"
+	default:
+		return "unknown"
+	}
+}
+
+// ConnectionURL validates the selected mode and returns a driver URL.
+func (d DatabaseConfig) ConnectionURL() (string, error) {
+	if d.URL != "" {
+		return d.URL, nil
+	}
+	if d.Protocol != SQLite && d.Protocol != Postgres && d.Protocol != MySQL {
+		return "", fmt.Errorf("db.protocol must be one of sqlite3, postgres, mysql (got %d)", d.Protocol)
+	}
+	if d.Name == "" {
+		return "", errors.New("db.name cannot be empty")
+	}
+	if d.Protocol == SQLite {
+		path := d.Path
+		if path == "" {
+			path = d.Host
+		}
+		if path == "" {
+			return "", errors.New("db.path cannot be empty for sqlite3")
+		}
+		return "file:" + filepath.ToSlash(filepath.Join(path, d.Name)), nil
+	}
+	if d.Host == "" {
+		return "", errors.New("db.host cannot be empty")
+	}
+	port := d.Port
+	if port == 0 {
+		if d.Protocol == Postgres {
+			port = 5432
+		} else {
+			port = 3306
+		}
+	}
+	if port < 1 || port > 65535 {
+		return "", fmt.Errorf("db.port must be between 1 and 65535 (got %d)", port)
+	}
+	u := url.URL{Scheme: d.Protocol.String(), Host: net.JoinHostPort(d.Host, strconv.Itoa(port)), Path: "/" + d.Name}
+	if d.Password != "" {
+		u.User = url.UserPassword(d.User, d.Password)
+	} else if d.User != "" {
+		u.User = url.User(d.User)
+	}
+	return u.String(), nil
 }
 
