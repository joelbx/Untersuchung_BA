@@ -0,0 +1,83 @@
+package sbom
+
+import (
+	"strings"
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		typeName, packageName    string
+		namespace, name, subpath string
+	}{
+		{"maven", "com.google.guava:guava", "com.google.guava", "guava", ""},
+		{"maven", "guava", "", "guava", ""},
+		{"pypi", "My_Package", "", "my-package", ""},
+		{"golang", "github.com/protobom/protobom", "github.com/protobom", "protobom", ""},
+		{"golang", "protobom", "", "protobom", ""},
+		{"npm", "@babel/core", "@babel", "core", ""},
+		{"npm", "core", "", "core", ""},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "", "GoogleUtilities", "NSData+zlib"},
+		{"cocoapods", "GoogleUtilities", "", "GoogleUtilities", ""},
+		{"other", "plain/name", "", "plain/name", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.typeName+"/"+tt.packageName, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.typeName, tt.packageName)
+			if namespace != tt.namespace || name != tt.name || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.typeName, tt.packageName, namespace, name, subpath, tt.namespace, tt.name, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPURLNames(t *testing.T) {
+	tests := []struct {
+		scannerType, packageName, wantPrefix string
+	}{
+		{"pom", "com.google.guava:guava", "pkg:maven/com.google.guava/guava@1"},
+		{"pip", "My_Package", "pkg:pypi/my-package@1"},
+		{"gomod", "github.com/protobom/protobom", "pkg:golang/github.com/protobom/protobom@1"},
+		{"npm", "@babel/core", "pkg:npm/%40babel/core@1"},
+		{"cocoapods", "GoogleUtilities/NSData+zlib", "pkg:cocoapods/GoogleUtilities@1"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.scannerType, func(t *testing.T) {
+			lookup := map[string]map[string]string{"lockfile": {}}
+			components := libpkgToCdxComponents(models.LibraryScanner{
+				Type: ftypes.LangType(tt.scannerType), LockfilePath: "lockfile",
+				Libs: []models.Library{{Name: tt.packageName, Version: "1"}},
+			}, lookup)
+			purl := components[1].PackageURL
+			if !strings.HasPrefix(purl, tt.wantPrefix) {
+				t.Errorf("PURL = %q, want prefix %q", purl, tt.wantPrefix)
+			}
+			if tt.scannerType == "cocoapods" && !strings.HasSuffix(purl, "#NSData+zlib") {
+				t.Errorf("Cocoapods PURL missing subpath: %q", purl)
+			}
+			if lookup["lockfile"][tt.packageName] != purl {
+				t.Errorf("vulnerability lookup has %q, want %q", lookup["lockfile"][tt.packageName], purl)
+			}
+		})
+	}
+}
+
+func TestGitHubDependencyPURLName(t *testing.T) {
+	manifest := models.DependencyGraphManifest{
+		Filename: "pom.xml", Repository: "owner/repo",
+		Dependencies: []models.Dependency{{PackageName: "com.google.guava:guava", Requirements: "= 1"}},
+	}
+	lookup := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+	components := ghpkgToCdxComponents(manifest, lookup)
+	purl := components[1].PackageURL
+	if !strings.HasPrefix(purl, "pkg:maven/com.google.guava/guava@1") {
+		t.Errorf("PURL = %q, want Maven namespace and artifact", purl)
+	}
+	if lookup[manifest.RepoURLFilename()]["com.google.guava:guava"] != purl {
+		t.Errorf("vulnerability lookup does not reference %q", purl)
+	}
+}
