 class ZipArchive(object):
 
+    def _valid_time_stamp(self, timestamp):
+        ''' Return a valid ZIP timestamp tuple, or the ZIP epoch. '''
+        epoch = (1980, 1, 1, 0, 0, 0, 0, 0, 0)
+        match = re.fullmatch(r'(\d{4})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})', timestamp)
+        if match is None:
+            return epoch
+
+        date_parts = tuple(int(part) for part in match.groups())
+        if not 1980 <= date_parts[0] <= 2107:
+            return epoch
+
+        try:
+            return datetime.datetime(*date_parts).timetuple()
+        except ValueError:
+            return epoch
+
