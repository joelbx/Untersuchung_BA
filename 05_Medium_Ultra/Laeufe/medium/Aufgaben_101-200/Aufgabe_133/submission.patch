+// NewDowngradedOSSAdminRole creates the limited admin role used when migrating
+// existing OSS users to RBAC. Keeping the admin name preserves role mappings
+// to trusted clusters that have not yet been upgraded.
+func NewDowngradedOSSAdminRole() Role {
+	role := NewOSSUserRole()
+	meta := role.GetMetadata()
+	meta.Name = teleport.AdminRoleName
+	meta.Labels = map[string]string{teleport.OSSMigratedV6: types.True}
+	role.(*RoleV3).Metadata = meta
+	return role
+}
