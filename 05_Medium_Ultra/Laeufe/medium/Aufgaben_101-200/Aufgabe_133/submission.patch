+func TestNewDowngradedOSSAdminRole(t *testing.T) {
+	role := NewDowngradedOSSAdminRole()
+	require.Equal(t, teleport.AdminRoleName, role.GetName())
+	require.Equal(t, types.True, role.GetMetadata().Labels[teleport.OSSMigratedV6])
+	require.Equal(t, []string{teleport.TraitInternalLoginsVariable}, role.GetLogins(Allow))
+
+	roles := RoleSet{role}
+	for _, tc := range []struct {
+		resource string
+		verb     string
+		allowed  bool
+	}{
+		{KindEvent, VerbRead, true},
+		{KindSession, VerbRead, true},
+		{KindEvent, VerbCreate, false},
+		{KindRole, VerbRead, false},
+		{KindRole, VerbCreate, false},
+		{KindUser, VerbUpdate, false},
+	} {
+		err := roles.CheckAccessToRule(&Context{}, defaults.Namespace, tc.resource, tc.verb, true)
+		if tc.allowed {
+			require.NoError(t, err, "%s %s", tc.verb, tc.resource)
+		} else {
+			require.True(t, trace.IsAccessDenied(err), "%s %s: %v", tc.verb, tc.resource, err)
+		}
+	}
+}
