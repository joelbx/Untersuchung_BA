@@ -0,0 +1,62 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import type { ShareExternalInvitation, ShareInvitation, ShareMember } from '../../store';
+import { getExistingEmails } from './getExistingEmails';
+import { useInvitationsStore } from './invitations.store';
+import { useMembersStore } from './members.store';
+
+const member = (email: string) => ({ email }) as ShareMember;
+const invitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareInvitation;
+const externalInvitation = (inviteeEmail: string) => ({ inviteeEmail }) as ShareExternalInvitation;
+
+beforeEach(() => {
+    useMembersStore.setState({ members: {} });
+    useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+});
+
+describe('share member and invitation stores', () => {
+    it('replaces members only for the selected share', () => {
+        const store = useMembersStore.getState();
+        store.setMembers('one', [member('one@example.com')]);
+        store.setMembers('two', [member('two@example.com')]);
+        store.setMembers('one', [member('new@example.com')]);
+
+        expect(store.getMembers('one')).toEqual([member('new@example.com')]);
+        expect(store.getMembers('two')).toEqual([member('two@example.com')]);
+        expect(store.getMembers('missing')).toEqual([]);
+    });
+
+    it('keeps both invitation kinds isolated through updates and removal', () => {
+        const store = useInvitationsStore.getState();
+        store.setInvitations('one', [invitation('one@example.com')]);
+        store.setInvitations('two', [invitation('two@example.com')]);
+        store.setExternalInvitations('one', [externalInvitation('external-one@example.com')]);
+        store.setExternalInvitations('two', [externalInvitation('external-two@example.com')]);
+
+        store.updateInvitationsPermissions('one', [invitation('updated@example.com')]);
+        store.removeExternalInvitations('one', []);
+        expect(store.getInvitations('one')).toEqual([invitation('updated@example.com')]);
+        expect(store.getExternalInvitations('one')).toEqual([]);
+        expect(store.getInvitations('two')).toEqual([invitation('two@example.com')]);
+        expect(store.getExternalInvitations('two')).toEqual([externalInvitation('external-two@example.com')]);
+
+        store.addMultipleInvitations('one', [], [externalInvitation('new@example.com')]);
+        expect(store.getInvitations('one')).toEqual([]);
+        expect(store.getExternalInvitations('one')).toEqual([externalInvitation('new@example.com')]);
+        expect(store.getInvitations('two')).toEqual([invitation('two@example.com')]);
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+    });
+});
+
+describe('getExistingEmails', () => {
+    it('flattens member and invitation addresses', () => {
+        expect(
+            getExistingEmails(
+                [member('member@example.com')],
+                [invitation('invite@example.com')],
+                [externalInvitation('external@example.com')]
+            )
+        ).toEqual(['member@example.com', 'invite@example.com', 'external@example.com']);
+    });
+});
