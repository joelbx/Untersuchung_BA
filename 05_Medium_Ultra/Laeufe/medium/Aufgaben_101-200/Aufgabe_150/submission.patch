+@pytest.mark.parametrize('manifest_value', [{}, None])
+def test_minimal_manifest_uses_default_directives(collection_input, monkeypatch, manifest_value):
+    input_dir = collection_input[0]
+    build_distlib = MagicMock(return_value={'format': 1, 'files': []})
+    monkeypatch.setattr(collection, '_build_files_manifest_distlib', build_distlib)
+
+    actual = collection._build_files_manifest(to_bytes(input_dir), 'namespace', 'collection', [], manifest_value)
+
+    assert actual == {'format': 1, 'files': []}
+    build_distlib.assert_called_once_with(to_bytes(input_dir), 'namespace', 'collection', {})
+
+
+@pytest.mark.parametrize('manifest_value', [{}, None])
+def test_build_ignore_conflicts_with_explicit_manifest(collection_input, manifest_value):
+    with pytest.raises(AnsibleError, match='mutually exclusive'):
+        collection._build_files_manifest(to_bytes(collection_input[0]), 'namespace', 'collection',
+                                         ['*.md'], manifest_value)
+
+
+@pytest.mark.parametrize('manifest_yaml, expected', [('', Sentinel), ('manifest: {}\n', {}), ('manifest: null\n', None)])
+def test_manifest_metadata_preserves_presence(collection_input, manifest_yaml, expected):
+    input_dir = collection_input[0]
+    with open(os.path.join(input_dir, 'galaxy.yml'), 'a') as galaxy_file:
+        galaxy_file.write('\n' + manifest_yaml)
+
+    actual = collection.concrete_artifact_manager._get_meta_from_src_dir(to_bytes(input_dir))['manifest']
+    if expected is Sentinel:
+        assert actual is Sentinel
+    else:
+        assert actual == expected
+
