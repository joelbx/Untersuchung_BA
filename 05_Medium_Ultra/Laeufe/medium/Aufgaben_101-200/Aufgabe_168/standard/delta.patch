+function useAdminActionLock(): {
+    pending: boolean;
+    run: (action: () => Promise<void>, errorTitle: string) => Promise<void>;
+} {
+    const inFlight = useRef(false);
+    const [pending, setPending] = useState(false);
+
+    const run = async (action: () => Promise<void>, errorTitle: string): Promise<void> => {
+        // The ref closes the gap before React renders the disabled buttons.
+        if (inFlight.current) return;
+        inFlight.current = true;
+        setPending(true);
+        try {
+            await action();
+        } catch (err) {
+            logger.error(`${errorTitle}:`, err);
+            Modal.createDialog(ErrorDialog, {
+                title: errorTitle,
+                description: err instanceof Error && err.message ? err.message : _t("Operation failed"),
+            });
+        } finally {
+            inFlight.current = false;
+            setPending(false);
+        }
+    };
+
+    return { pending, run };
+}
+
+const AdminActionLockContext = React.createContext<ReturnType<typeof useAdminActionLock> | null>(null);
+
+function useMemberAdminActionLock(): ReturnType<typeof useAdminActionLock> {
+    const sharedLock = useContext(AdminActionLockContext);
+    const localLock = useAdminActionLock();
+    return sharedLock ?? localLock;
+}
