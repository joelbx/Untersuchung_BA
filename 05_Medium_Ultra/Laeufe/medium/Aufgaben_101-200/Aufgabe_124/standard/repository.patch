+func (b *Backend) disableAutoScalingForOnDemand(status tableStatus, tableBillingMode string) {
+	if !b.EnableAutoScaling {
+		return
+	}
+	if status == tableStatusOK && tableBillingMode == dynamodb.BillingModePayPerRequest {
+		b.Info("auto_scaling is ignored because the table is on-demand")
+		b.EnableAutoScaling = false
+	} else if status == tableStatusMissing && b.BillingMode == "pay_per_request" {
+		b.Info("auto_scaling is ignored because the table will be on-demand")
+		b.EnableAutoScaling = false
+	}
+}
