+type billingTableAPI struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+	describeError  error
+}
+
+func (m *billingTableAPI) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingTableAPI) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	return nil
+}
+
+func (m *billingTableAPI) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describeOutput, m.describeError
+}
+
+func TestBillingModeConfig(t *testing.T) {
+	for _, test := range []struct {
+		name, mode, want string
+		valid            bool
+	}{
+		{"default", "", "pay_per_request", true},
+		{"on-demand", "pay_per_request", "pay_per_request", true},
+		{"provisioned", "provisioned", "provisioned", true},
+		{"invalid", "PAY_PER_REQUEST", "", false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			cfg := Config{TableName: "test", BillingMode: test.mode}
+			err := cfg.CheckAndSetDefaults()
+			if !test.valid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, test.want, cfg.BillingMode)
+		})
+	}
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		name, mode, want string
+		throughput       bool
+	}{
+		{"default", "", dynamodb.BillingModePayPerRequest, false},
+		{"on-demand", "pay_per_request", dynamodb.BillingModePayPerRequest, false},
+		{"provisioned", "provisioned", dynamodb.BillingModeProvisioned, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			api := &billingTableAPI{}
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{BillingMode: test.mode, ReadCapacityUnits: 17, WriteCapacityUnits: 23}, svc: api}
+			require.NoError(t, b.createTable(context.Background(), "test", fullPathKey))
+			require.Equal(t, test.want, aws.StringValue(api.createInput.BillingMode))
+			if test.throughput {
+				require.NotNil(t, api.createInput.ProvisionedThroughput)
+				require.Equal(t, int64(17), aws.Int64Value(api.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(23), aws.Int64Value(api.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
+				require.Nil(t, api.createInput.ProvisionedThroughput)
+			}
+		})
+	}
+}
+
+func TestTableStatusBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		output     *dynamodb.DescribeTableOutput
+		err        error
+		wantStatus tableStatus
+		wantMode   string
+		wantError  bool
+	}{
+		{"on-demand", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, nil, tableStatusOK, dynamodb.BillingModePayPerRequest, false},
+		{"provisioned", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)}}}, nil, tableStatusOK, dynamodb.BillingModeProvisioned, false},
+		{"legacy", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}}, nil, tableStatusOK, "", false},
+		{"migration", &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}}, BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)}}}, nil, tableStatusNeedsMigration, "", false},
+		{"missing", nil, awserr.New(dynamodb.ErrCodeResourceNotFoundException, "missing", nil), tableStatusMissing, "", false},
+		{"error", nil, errors.New("describe failed"), tableStatusError, "", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			b := &Backend{svc: &billingTableAPI{describeOutput: test.output, describeError: test.err}}
+			status, mode, err := b.getTableStatus(context.Background(), "test")
+			require.Equal(t, test.wantStatus, status)
+			require.Equal(t, test.wantMode, mode)
+			if test.wantError {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
+
+func TestAutoScalingBillingMode(t *testing.T) {
+	for _, test := range []struct {
+		name, configMode, tableMode string
+		status                      tableStatus
+		wantEnabled                 bool
+	}{
+		{"existing on-demand", "provisioned", dynamodb.BillingModePayPerRequest, tableStatusOK, false},
+		{"existing provisioned", "pay_per_request", dynamodb.BillingModeProvisioned, tableStatusOK, true},
+		{"existing legacy", "pay_per_request", "", tableStatusOK, true},
+		{"new on-demand", "pay_per_request", "", tableStatusMissing, false},
+		{"new provisioned", "provisioned", "", tableStatusMissing, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			b := &Backend{Entry: log.NewEntry(log.New()), Config: Config{BillingMode: test.configMode, EnableAutoScaling: true}}
+			b.disableAutoScalingForOnDemand(test.status, test.tableMode)
+			require.Equal(t, test.wantEnabled, b.EnableAutoScaling)
+		})
+	}
+}
