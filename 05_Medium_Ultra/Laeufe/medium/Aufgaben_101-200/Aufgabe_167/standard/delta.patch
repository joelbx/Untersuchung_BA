diff --git a/internal/storage/fs/oci/source.go b/internal/storage/fs/oci/source.go
new file mode 100644
index 0000000..19c7c3a
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,100 @@
+package oci
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+// Source reads snapshots from an OCI repository.
+type Source struct {
+	logger   *zap.Logger
+	store    *fliptoci.Store
+	interval time.Duration
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+}
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if logger == nil || store == nil {
+		return nil, fmt.Errorf("OCI source requires a logger and store")
+	}
+	s := &Source{logger: logger, store: store, interval: 30 * time.Second}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, fmt.Errorf("OCI poll interval must be positive")
+	}
+	return s, nil
+}
+
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) { s.interval = tick }
+}
+
+func (*Source) String() string { return "oci" }
+
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.logger.Debug("fetching OCI snapshot")
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("failed fetching OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	if response.Matched && s.snapshot != nil {
+		return s.snapshot, nil
+	}
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("failed building OCI snapshot", zap.Error(err))
+		return nil, err
+	}
+	s.snapshot, s.digest = snapshot, response.Digest
+	return snapshot, nil
+}
+
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			s.mu.Lock()
+			previous := s.digest
+			s.mu.Unlock()
+			snapshot, err := s.Get(ctx)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				s.logger.Error("failed polling OCI snapshot", zap.Error(err))
+				continue
+			}
+			s.mu.Lock()
+			changed := s.digest != previous
+			s.mu.Unlock()
+			if changed {
+				s.logger.Debug("sending updated OCI snapshot")
+				select {
+				case ch <- snapshot:
+				case <-ctx.Done():
+					return
+				}
+			}
+		}
+	}
+}
diff --git a/internal/storage/fs/oci/source_test.go b/internal/storage/fs/oci/source_test.go
new file mode 100644
index 0000000..18fdbd3
--- /dev/null
+++ b/internal/storage/fs/oci/source_test.go
@@ -0,0 +1,81 @@
+package oci
+
+import (
+	"bytes"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+	"oras.land/oras-go/v2"
+	layout "oras.land/oras-go/v2/content/oci"
+)
+
+func TestSourceLocalExternalUpdate(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	repoDir := filepath.Join(dir, "flags")
+	publish := func(key string) {
+		t.Helper()
+		// A separate OCI store simulates another process updating the layout.
+		target, err := layout.New(repoDir)
+		require.NoError(t, err)
+		target.AutoSaveIndex = true
+		payload := []byte("flags:\n  - key: " + key + "\n    name: " + key + "\n    enabled: true\n    type: BOOLEAN_FLAG_TYPE\n")
+		layer := v1.Descriptor{Digest: digest.FromBytes(payload), Size: int64(len(payload)), MediaType: fliptoci.MediaTypeFliptFeatures + "+yaml", Annotations: map[string]string{fliptoci.AnnotationFliptNamespace: "team"}}
+		require.NoError(t, target.Push(ctx, layer, bytes.NewReader(payload)))
+		desc, err := oras.PackManifest(ctx, target, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{ManifestAnnotations: map[string]string{}, Layers: []v1.Descriptor{layer}})
+		require.NoError(t, err)
+		require.NoError(t, target.Tag(ctx, desc, "latest"))
+	}
+	publish("first")
+	store, err := fliptoci.NewStore(&config.OCI{BundleDirectory: dir, Repository: "flipt://local/flags:latest"})
+	require.NoError(t, err)
+	source, err := NewSource(zap.NewNop(), store, WithPollInterval(5*time.Millisecond))
+	require.NoError(t, err)
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	_, err = first.GetFlag(ctx, "team", "first")
+	require.NoError(t, err)
+	same, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.Same(t, first, same)
+	publish("second")
+	second, err := source.Get(ctx)
+	require.NoError(t, err)
+	require.NotSame(t, first, second)
+	_, err = second.GetFlag(ctx, "team", "second")
+	require.NoError(t, err)
+
+	subCtx, cancel := context.WithCancel(ctx)
+	ch := make(chan *storagefs.StoreSnapshot)
+	done := make(chan struct{})
+	go func() { source.Subscribe(subCtx, ch); close(done) }()
+	select {
+	case <-ch:
+		t.Fatal("received unchanged snapshot")
+	case <-time.After(30 * time.Millisecond):
+	}
+	publish("third")
+	select {
+	case updated := <-ch:
+		require.NotNil(t, updated)
+		_, err := updated.GetFlag(ctx, "team", "third")
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("did not receive updated snapshot")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("subscription did not stop")
+	}
+}
