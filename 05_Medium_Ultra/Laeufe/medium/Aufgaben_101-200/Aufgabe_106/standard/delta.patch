+func TestFillWordPressIgnoresInactivePerServer(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+	config.Conf.Servers = map[string]config.ServerInfo{
+		"site": {WordPress: config.WordPressConf{IgnoreInactive: true}},
+	}
+	core := "{}"
+	active := `{"active":{"vulnerabilities":[{"id":1,"fixed_in":"2.0"}]}}`
+	inactive := `{"inactive":{"vulnerabilities":[{"id":2,"fixed_in":"2.0"}]}}`
+	cache := map[string]*string{"10": &core, "active": &active, "inactive": &inactive}
+	makeResult := func() *models.ScanResult {
+		return &models.ScanResult{
+			ServerName: "site",
+			WordPressPackages: &models.WordPressPackages{
+				{Type: models.WPCore, Version: "1.0"},
+				{Name: "active", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+				{Name: "inactive", Type: models.WPTheme, Status: "inactive", Version: "1.0"},
+			},
+			ScannedCves: models.VulnInfos{},
+		}
+	}
+	r := makeResult()
+	if _, err := FillWordPress(r, "unused", cache); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := r.ScannedCves["WPVDBID-1"]; !ok {
+		t.Fatal("active plugin vulnerability was excluded")
+	}
+	if _, ok := r.ScannedCves["WPVDBID-2"]; ok {
+		t.Fatal("inactive theme vulnerability was included")
+	}
+
+	config.Conf.Servers["site"] = config.ServerInfo{WordPress: config.WordPressConf{IgnoreInactive: false}}
+	r = makeResult()
+	if _, err := FillWordPress(r, "unused", cache); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := r.ScannedCves["WPVDBID-2"]; !ok {
+		t.Fatal("inactive theme vulnerability was excluded when filtering is disabled")
+	}
+}
