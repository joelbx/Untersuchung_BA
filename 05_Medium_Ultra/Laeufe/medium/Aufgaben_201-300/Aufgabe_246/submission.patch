diff --git a/scan/library_test.go b/scan/library_test.go
new file mode 100644
index 0000000..f1c4a5c
--- /dev/null
+++ b/scan/library_test.go
@@ -0,0 +1,28 @@
+package scan
+
+import (
+	"os"
+	"testing"
+
+	"github.com/aquasecurity/fanal/types"
+	deptypes "github.com/aquasecurity/go-dep-parser/pkg/types"
+)
+
+var _ os.FileInfo = (*DummyFileInfo)(nil)
+
+func TestConvertLibWithScannerUsesSourcePath(t *testing.T) {
+	apps := []types.Application{{
+		FilePath: "package-lock.json",
+		Libraries: []types.LibraryInfo{{Library: deptypes.Library{
+			Name: "shared", Version: "1.2.3",
+		}}},
+	}}
+	scanners, err := convertLibWithScanner("/project/a/package-lock.json", apps)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(scanners) != 1 || scanners[0].Path != "/project/a/package-lock.json" ||
+		len(scanners[0].Libs) != 1 || scanners[0].Libs[0].Version != "1.2.3" {
+		t.Fatalf("unexpected scanners: %#v", scanners)
+	}
+}
