diff --git a/test/api-tokens.js b/test/api-tokens.js
new file mode 100644
index 0000000..dc50a4a
--- /dev/null
+++ b/test/api-tokens.js
@@ -0,0 +1,62 @@
+'use strict';
+
+const assert = require('assert');
+const db = require('./mocks/databasemock');
+const user = require('../src/user');
+const { tokens } = require('../src/api/utils');
+
+describe('API token utilities', () => {
+	let created = [];
+
+	afterEach(async () => {
+		await Promise.all(created.map(token => tokens.delete(token)));
+		created = [];
+	});
+
+	it('validates ownership and empty inputs', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+		await assert.rejects(tokens.get(null), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.get(undefined), /\[\[error:invalid-data\]\]/);
+		await assert.rejects(tokens.generate({ uid: 99999999 }), /\[\[error:no-user\]\]/);
+	});
+
+	it('creates, lists, updates, tracks and deletes tokens', async () => {
+		const uid = await user.create({ username: `token-user-${Date.now()}` });
+		const start = Date.now();
+		const first = await tokens.generate({ uid, description: 'first' });
+		await new Promise((resolve) => { setTimeout(resolve, 2); });
+		const second = await tokens.generate({ uid: 0 });
+		created = [first, second];
+		const end = Date.now();
+		const firstData = await tokens.get(first);
+
+		assert.strictEqual(firstData.uid, uid);
+		assert.strictEqual(firstData.description, 'first');
+		assert(Number.isFinite(firstData.timestamp));
+		assert(firstData.timestamp >= start && firstData.timestamp <= end);
+		assert.strictEqual(firstData.lastSeen, null);
+		assert.deepStrictEqual(await tokens.get([first, second]), [firstData, await tokens.get(second)]);
+		assert.deepStrictEqual(await tokens.list(), [firstData, await tokens.get(second)]);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', first), firstData.timestamp);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', first), uid);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', second), 0);
+
+		await tokens.log(first);
+		const [seen, neverSeen] = await tokens.getLastSeen([first, second]);
+		assert(Number.isFinite(seen));
+		assert.strictEqual(neverSeen, null);
+		const updated = await tokens.update(first, { description: 'updated' });
+		assert.deepStrictEqual(updated, { ...firstData, description: 'updated', lastSeen: seen });
+		assert.strictEqual(Number((await db.getObject(`token:${first}`)).timestamp), firstData.timestamp);
+
+		await tokens.delete(first);
+		created = [second];
+		assert.strictEqual(await db.getObject(`token:${first}`), null);
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', first), null);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', first), null);
+		assert.strictEqual(await db.sortedSetScore('tokens:lastSeen', first), null);
+		assert.strictEqual(await tokens.get(first), null);
+	});
+});
