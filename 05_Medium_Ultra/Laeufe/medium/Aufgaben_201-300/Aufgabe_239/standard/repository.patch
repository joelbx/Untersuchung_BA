diff --git a/core/agents/lastfm/auth_router_test.go b/core/agents/lastfm/auth_router_test.go
new file mode 100644
index 0000000..2892124
--- /dev/null
+++ b/core/agents/lastfm/auth_router_test.go
@@ -0,0 +1,64 @@
+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestLinkCallbackIsScopedToInitiatingUser(t *testing.T) {
+	ds := &tests.MockDataStore{}
+	httpClient := &tests.FakeHttpClient{}
+	router := &Router{ds: ds, sessionKeys: &sessionKeys{ds: ds}, client: NewClient("key", "secret", "en", httpClient)}
+	ctx := request.WithUser(context.Background(), model.User{ID: "user-a"})
+	start := httptest.NewRecorder()
+	router.startLink(start, httptest.NewRequest(http.MethodGet, "/link/auth", nil).WithContext(ctx))
+	if start.Code != http.StatusOK {
+		t.Fatalf("start link status = %d: %s", start.Code, start.Body.String())
+	}
+	var challenge struct{ UID, State string }
+	if err := json.Unmarshal(start.Body.Bytes(), &challenge); err != nil {
+		t.Fatal(err)
+	}
+	callback := func(uid string) *httptest.ResponseRecorder {
+		params := url.Values{"uid": {uid}, "state": {challenge.State}, "token": {"lastfm-token"}}
+		recorder := httptest.NewRecorder()
+		router.callback(recorder, httptest.NewRequest(http.MethodGet, "/link/callback?"+params.Encode(), nil))
+		return recorder
+	}
+	if got := callback("user-b"); got.Code != http.StatusBadRequest {
+		t.Fatalf("other user's callback status = %d", got.Code)
+	}
+	if httpClient.RequestCount != 0 {
+		t.Fatal("invalid callback requested a LastFM session")
+	}
+	httpClient.Res = http.Response{Body: ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"SK-A"}}`)), StatusCode: 200}
+	if got := callback("user-a"); got.Code != http.StatusOK {
+		t.Fatalf("owner callback status = %d: %s", got.Code, got.Body.String())
+	}
+	if key, err := ds.UserProps(ctx).Get("user-a", sessionKeyProperty); err != nil || key != "SK-A" {
+		t.Fatalf("owner session key = %q, %v", key, err)
+	}
+	if _, err := ds.UserProps(ctx).Get("user-b", sessionKeyProperty); err != model.ErrNotFound {
+		t.Fatalf("other user's session key error = %v", err)
+	}
+	if got := callback("user-a"); got.Code != http.StatusBadRequest {
+		t.Fatalf("replayed callback status = %d", got.Code)
+	}
+	if err := ds.UserProps(ctx).Put("user-b", sessionKeyProperty, "SK-B"); err != nil {
+		t.Fatal(err)
+	}
+	router.unlink(httptest.NewRecorder(), httptest.NewRequest(http.MethodDelete, "/link", nil).WithContext(ctx))
+	if key, err := ds.UserProps(ctx).Get("user-b", sessionKeyProperty); err != nil || key != "SK-B" {
+		t.Fatalf("other user's session key after unlink = %q, %v", key, err)
+	}
+}
