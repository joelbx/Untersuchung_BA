+describe('upload cleanup on purge', () => {
+	let cid;
+	let uid;
+	const uploadDir = path.join(nconf.get('upload_path'), 'files');
+	const createFile = name => fs.writeFileSync(path.join(uploadDir, name), 'upload');
+	const createPost = async (name) => {
+		const result = await topics.post({
+			uid,
+			cid,
+			title: `upload cleanup ${name}`,
+			content: `[file](/assets/uploads/files/${name})`,
+		});
+		return result.postData.pid;
+	};
+
+	before(async () => {
+		uid = await user.create({ username: 'upload cleanup user', password: 'password', gdpr_consent: 1 });
+		({ cid } = await categories.create({ name: 'Upload cleanup category' }));
+	});
+
+	after(() => {
+		meta.config.preserveOrphanedUploads = 0;
+	});
+
+	it('deletes an unshared upload and its resized copy on purge', async () => {
+		createFile('purge-unique.png');
+		createFile('purge-unique-resized.png');
+		const pid = await createPost('purge-unique.png');
+		meta.config.preserveOrphanedUploads = 0;
+		await posts.purge(pid, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-unique.png')), false);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-unique-resized.png')), false);
+	});
+
+	it('keeps a shared upload until its last post is purged', async () => {
+		createFile('purge-shared.png');
+		const first = await createPost('purge-shared.png');
+		const second = await createPost('purge-shared.png');
+		meta.config.preserveOrphanedUploads = 0;
+		await posts.purge(first, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-shared.png')), true);
+		await posts.purge(second, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-shared.png')), false);
+	});
+
+	it('keeps uploads when preservation is enabled', async () => {
+		createFile('purge-preserved.png');
+		const pid = await createPost('purge-preserved.png');
+		meta.config.preserveOrphanedUploads = 1;
+		await posts.purge(pid, uid);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-preserved.png')), true);
+		fs.unlinkSync(path.join(uploadDir, 'purge-preserved.png'));
+	});
+
+	it('accepts single paths and arrays while rejecting invalid and escaping paths', async () => {
+		createFile('purge-single.txt');
+		createFile('purge-array.txt');
+		const outside = path.join(nconf.get('upload_path'), 'purge-outside.txt');
+		fs.writeFileSync(outside, 'outside');
+		await assert.rejects(posts.uploads.deleteFromDisk(42));
+		await posts.uploads.deleteFromDisk(['../purge-outside.txt', null, 'purge-array.txt']);
+		await posts.uploads.deleteFromDisk('purge-single.txt');
+		assert.strictEqual(fs.existsSync(outside), true);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-array.txt')), false);
+		assert.strictEqual(fs.existsSync(path.join(uploadDir, 'purge-single.txt')), false);
+		fs.unlinkSync(outside);
+	});
+});
+
