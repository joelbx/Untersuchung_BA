diff --git a/scanner/refresher_test.go b/scanner/refresher_test.go
new file mode 100644
index 0000000..a439579
--- /dev/null
+++ b/scanner/refresher_test.go
@@ -0,0 +1,29 @@
+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestImageFiles(t *testing.T) {
+	mfs := model.MediaFiles{
+		{Path: filepath.Join("disc2", "track.mp3")},
+		{Path: filepath.Join("disc1", "track.mp3")},
+		{Path: filepath.Join("disc1", "other.mp3")},
+	}
+	dirs := dirMap{
+		"disc1": {ImageFiles: []string{"back.jpg", "front.png"}},
+		"disc2": {ImageFiles: []string{"cover.jpg"}},
+	}
+	want := strings.Join([]string{
+		filepath.Join("disc1", "back.jpg"),
+		filepath.Join("disc1", "front.png"),
+		filepath.Join("disc2", "cover.jpg"),
+	}, string(filepath.ListSeparator))
+	if got := imageFiles(mfs, dirs); got != want {
+		t.Fatalf("imageFiles() = %q, want %q", got, want)
+	}
+}
