diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..39e442c
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,107 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+
+import useGetCalendarSetup from '../hooks/useGetCalendarSetup';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ error: false, loading: false })),
+}));
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ handleCreateCalendar: jest.fn() })),
+}));
+jest.mock('../../../hooks', () => ({ useLoading: () => [false, jest.fn()] }));
+jest.mock('../calendarModal/calendarModalState', () => ({ getDefaultModel: () => ({}) }));
+jest.mock('../../error', () => ({ GenericError: () => <div>Error content</div> }));
+jest.mock('../../../components', () => ({
+    BasicModal: ({ children, footer, onSubmit }: any) => (
+        <form onSubmit={onSubmit}>
+            {children}
+            {footer}
+        </form>
+    ),
+    Button: ({ children, ...props }: any) => <button {...props}>{children}</button>,
+    Form: 'form',
+    Href: ({ children }: any) => <a href="/">{children}</a>,
+    InputFieldTwo: ({ warning, error, label, ...props }: any) => (
+        <>
+            <label htmlFor="calendar-url">{label}</label>
+            <input id="calendar-url" {...props} />
+            {error && <div>{error}</div>}
+            {warning && <div>{warning}</div>}
+        </>
+    ),
+    Loader: () => null,
+}));
+
+const setURL = (url: string) => fireEvent.change(screen.getByLabelText('Calendar URL'), { target: { value: url } });
+const getSubmit = () => screen.getByRole('button', { name: 'Add calendar' });
+
+describe('SubscribeCalendarModal', () => {
+    beforeEach(() => {
+        (useGetCalendarSetup as jest.Mock).mockReturnValue({ error: false, loading: false });
+    });
+
+    it('accepts URLs up to the shared limit and blocks longer URLs', () => {
+        render(<SubscribeCalendarModal isOpen />);
+        expect(getSubmit()).toBeDisabled();
+
+        setURL('not a URL');
+        expect(getSubmit()).toBeDisabled();
+        expect(screen.getByText('Invalid URL')).toBeInTheDocument();
+
+        const url = `https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - 'https://example.com/'.length)}`;
+        setURL(url);
+        expect(getSubmit()).toBeEnabled();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        setURL(`${url}a`);
+        expect(getSubmit()).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+    });
+
+    it('shows only the highest priority warning', () => {
+        render(<SubscribeCalendarModal isOpen />);
+        const longPath = 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL);
+
+        setURL('https://calendar.google.com/public/example.ics');
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(getSubmit()).toBeEnabled();
+
+        setURL(`https://calendar.google.com/${longPath}`);
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        setURL(`https://calendar.google.com/public/${longPath}.ics`);
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(getSubmit()).toBeDisabled();
+
+        setURL('https://outlook.live.com/calendar');
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(getSubmit()).toBeEnabled();
+    });
+
+    it('trims changes and applies the same disabled rule in the setup error state', () => {
+        const { rerender } = render(<SubscribeCalendarModal isOpen />);
+        setURL('  https://example.com/calendar.ics  ');
+        expect(screen.getByLabelText('Calendar URL')).toHaveValue('https://example.com/calendar.ics');
+
+        (useGetCalendarSetup as jest.Mock).mockReturnValue({ error: true, loading: false });
+        rerender(<SubscribeCalendarModal isOpen />);
+        expect(screen.getByRole('button', { name: 'Close' })).toBeEnabled();
+
+        (useGetCalendarSetup as jest.Mock).mockReturnValue({ error: false, loading: false });
+        rerender(<SubscribeCalendarModal isOpen />);
+        setURL(`https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}`);
+        (useGetCalendarSetup as jest.Mock).mockReturnValue({ error: true, loading: false });
+        rerender(<SubscribeCalendarModal isOpen />);
+        expect(screen.getByRole('button', { name: 'Close' })).toBeDisabled();
+    });
+});
