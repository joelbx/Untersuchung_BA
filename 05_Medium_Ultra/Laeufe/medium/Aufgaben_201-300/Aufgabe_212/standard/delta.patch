 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		optional   string
+		summary    string
+		metadata   map[string]string
+		cvssScore  float64
+		cvssVector string
+		cvssLevel  string
+		fixedIn    string
+	}{
+		{
+			name:       "enterprise",
+			optional:   `,"description":"A detailed description","poc":"https://example.com/poc","introduced_in":"5.0","cvss":{"score":8.1,"vector":"CVSS:3.1/AV:N","severity":"high"},"fixed_in":"6.2"`,
+			summary:    "A detailed description",
+			metadata:   map[string]string{"poc": "https://example.com/poc", "introduced_in": "5.0"},
+			cvssScore:  8.1,
+			cvssVector: "CVSS:3.1/AV:N",
+			cvssLevel:  "high",
+			fixedIn:    "6.2",
+		},
+		{
+			name:     "basic with null fields",
+			optional: `,"description":null,"poc":null,"introduced_in":null,"cvss":null,"fixed_in":null`,
+			metadata: map[string]string{},
+		},
+		{
+			name:     "basic with omitted fields",
+			metadata: map[string]string{},
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			body := `{"610":{"vulnerabilities":[{"id":"123","title":"Example","created_at":"2024-01-02T03:04:05+02:00","updated_at":"2024-02-03T04:05:06-03:00","vuln_type":"SQL injection","references":{"cve":["2024-1234","2024-5678"],"url":["https://example.com/first","https://example.com/second"]}` + tt.optional + `}]}}`
+			vinfos, err := convertToVinfos("core", body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("expected one vulnerability, got %d", len(vinfos))
+			}
+			v := vinfos[0]
+			if v.CveID != "CVE-2024-1234" || v.VulnType != "SQL injection" {
+				t.Fatalf("unexpected identity or classification: %+v", v)
+			}
+			contents := v.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("expected one WPScan content, got %d", len(contents))
+			}
+			c := contents[0]
+			if c.Type != models.WpScan || c.CveID != v.CveID || c.Summary != tt.summary ||
+				c.Cvss3Score != tt.cvssScore || c.Cvss3Vector != tt.cvssVector || c.Cvss3Severity != tt.cvssLevel {
+				t.Errorf("unexpected content: %+v", c)
+			}
+			if !reflect.DeepEqual(c.Optional, tt.metadata) {
+				t.Errorf("optional = %#v, want %#v", c.Optional, tt.metadata)
+			}
+			wantRefs := models.References{{Link: "https://example.com/first"}, {Link: "https://example.com/second"}}
+			if !reflect.DeepEqual(c.References, wantRefs) {
+				t.Errorf("references = %#v, want %#v", c.References, wantRefs)
+			}
+			published := time.Date(2024, 1, 2, 1, 4, 5, 0, time.UTC)
+			modified := time.Date(2024, 2, 3, 7, 5, 6, 0, time.UTC)
+			if !c.Published.Equal(published) || c.Published.Location() != time.UTC ||
+				!c.LastModified.Equal(modified) || c.LastModified.Location() != time.UTC {
+				t.Errorf("unexpected timestamps: %v, %v", c.Published, c.LastModified)
+			}
+			wantFix := models.WpPackageFixStats{{Name: "core", FixedIn: tt.fixedIn}}
+			if !reflect.DeepEqual(v.WpPackageFixStats, wantFix) {
+				t.Errorf("fix = %#v, want %#v", v.WpPackageFixStats, wantFix)
+			}
+		})
+	}
+}
