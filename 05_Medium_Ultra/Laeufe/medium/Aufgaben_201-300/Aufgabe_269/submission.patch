+package models
+
+import "testing"
+
+func TestTrivySourceMetadataAggregation(t *testing.T) {
+	v := VulnInfo{CveContents: CveContents{
+		TrivyDebian: {{Type: TrivyDebian, Title: "Debian title", Summary: "Debian summary", Cvss3Severity: "LOW"}},
+		TrivyUbuntu: {{Type: TrivyUbuntu, Title: "Ubuntu title", Summary: "Ubuntu summary", Cvss3Score: 5.2, Cvss3Vector: "CVSS:3.1/AV:L", Cvss3Severity: "MEDIUM"}},
+		TrivyNVD:    {{Type: TrivyNVD, Cvss2Score: 4.3, Cvss2Vector: "AV:N"}},
+	}}
+	if len(v.Titles("en", "debian")) < 2 || len(v.Summaries("en", "debian")) < 2 {
+		t.Fatal("Trivy source title or summary missing")
+	}
+	if scores := v.Cvss2Scores(); len(scores) != 1 || scores[0].Type != TrivyNVD || scores[0].Value.Score != 4.3 {
+		t.Fatalf("CVSS2 sources: %#v", scores)
+	}
+	scores := v.Cvss3Scores()
+	if len(scores) != 2 || scores[0].Type != TrivyDebian || scores[0].Value.Severity != "LOW" || scores[1].Type != TrivyUbuntu || scores[1].Value.Score != 5.2 || scores[1].Value.CalculatedBySeverity {
+		t.Fatalf("CVSS3 sources: %#v", scores)
+	}
+}
