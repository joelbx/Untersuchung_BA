+// TrivyContentTypes lists the sources commonly present in Trivy results.
+var TrivyContentTypes = []CveContentType{
+	TrivyDebian, TrivyUbuntu, TrivyNVD, TrivyRedHat, TrivyGHSA, TrivyOracleOVAL,
+	"trivy:redhat-oval", "trivy:centos", "trivy:rocky", "trivy:fedora",
+	"trivy:amazon", "trivy:suse-cvrf", "trivy:alpine", "trivy:arch-linux",
+	"trivy:alma", "trivy:cbl-mariner", "trivy:photon", "trivy:ruby-advisory-db",
+	"trivy:php-security-advisories", "trivy:nodejs-security-wg", "trivy:glad",
+	"trivy:osv", "trivy:wolfi", "trivy:chainguard", "trivy:bitnami",
+	"trivy:k8s", "trivy:govulndb",
+}
+
+// TrivyTypes returns all Trivy sources in these contents in stable order.
+func (v CveContents) TrivyTypes() (types []CveContentType) {
+	types = append(types, Trivy)
+	for _, ctype := range TrivyContentTypes {
+		if _, ok := v[ctype]; ok {
+			types = append(types, ctype)
+		}
+	}
+	var extra []string
+	for ctype := range v {
+		if !strings.HasPrefix(string(ctype), "trivy:") {
+			continue
+		}
+		known := false
+		for _, listed := range TrivyContentTypes {
+			if ctype == listed {
+				known = true
+				break
+			}
+		}
+		if !known {
+			extra = append(extra, string(ctype))
+		}
+	}
+	sort.Strings(extra)
+	for _, ctype := range extra {
+		types = append(types, CveContentType(ctype))
+	}
+	return types
+}
+
 // CveContentTypes has slide of CveContentType
 type CveContentTypes []CveContentType
 
