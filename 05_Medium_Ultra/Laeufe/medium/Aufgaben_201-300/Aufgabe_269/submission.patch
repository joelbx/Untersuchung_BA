diff --git a/contrib/trivy/pkg/converter_test.go b/contrib/trivy/pkg/converter_test.go
new file mode 100644
index 0000000..a4f86b3
--- /dev/null
+++ b/contrib/trivy/pkg/converter_test.go
@@ -0,0 +1,44 @@
+package pkg
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+	"github.com/aquasecurity/trivy/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestConvertPreservesSourceContentsAcrossTargets(t *testing.T) {
+	date := time.Date(2024, 1, 2, 0, 0, 0, 0, time.UTC)
+	base := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-1", PkgName: "package",
+		Vulnerability: dbtypes.Vulnerability{
+			Title: "title", Description: "description", References: []string{"https://example.org/advisory"},
+			PublishedDate: &date, LastModifiedDate: &date,
+			VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "nvd": dbtypes.SeverityHigh},
+			CVSS:           dbtypes.VendorCVSS{"nvd": {V2Score: 4.3, V2Vector: "AV:N", V3Score: 8.1, V3Vector: "CVSS:3.1/AV:N"}},
+		},
+	}
+	ubuntu := base
+	ubuntu.VendorSeverity = dbtypes.VendorSeverity{"ubuntu": dbtypes.SeverityMedium}
+	ubuntu.CVSS = dbtypes.VendorCVSS{"ubuntu": {V3Score: 5.2, V3Vector: "CVSS:3.1/AV:L"}}
+	got, err := Convert(types.Results{
+		{Type: ftypes.Debian, Vulnerabilities: []types.DetectedVulnerability{base}},
+		{Type: ftypes.Ubuntu, Vulnerabilities: []types.DetectedVulnerability{ubuntu}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := got.ScannedCves[base.VulnerabilityID].CveContents
+	for ctype, severity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyNVD: "HIGH", models.TrivyUbuntu: "MEDIUM"} {
+		entries := contents[ctype]
+		if len(entries) != 1 || entries[0].Type != ctype || entries[0].CveID != base.VulnerabilityID || entries[0].Cvss3Severity != severity || !entries[0].Published.Equal(date) || !entries[0].LastModified.Equal(date) || len(entries[0].References) != 1 {
+			t.Fatalf("%s: %#v", ctype, entries)
+		}
+	}
+	if contents[models.TrivyNVD][0].Cvss2Score != 4.3 || contents[models.TrivyNVD][0].Cvss3Score != 8.1 || contents[models.TrivyUbuntu][0].Cvss3Score != 5.2 {
+		t.Fatalf("source CVSS lost: %#v", contents)
+	}
+}
