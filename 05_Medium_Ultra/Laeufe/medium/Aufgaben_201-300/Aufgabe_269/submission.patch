+++ b/detector/library_trivy_test.go
@@ -0,0 +1,30 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	dbtypes "github.com/aquasecurity/trivy-db/pkg/types"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsPreservesVendorData(t *testing.T) {
+	date := time.Date(2024, 2, 3, 0, 0, 0, 0, time.UTC)
+	got := getCveContents("CVE-2024-2", dbtypes.Vulnerability{
+		Title: "title", Description: "summary", References: []string{"https://example.org"},
+		PublishedDate: &date, LastModifiedDate: &date,
+		VendorSeverity: dbtypes.VendorSeverity{"debian": dbtypes.SeverityLow, "ubuntu": dbtypes.SeverityMedium},
+		CVSS:           dbtypes.VendorCVSS{"ubuntu": {V3Score: 5.1, V3Vector: "CVSS:3.1/AV:L"}},
+	})
+	for ctype, severity := range map[models.CveContentType]string{models.TrivyDebian: "LOW", models.TrivyUbuntu: "MEDIUM"} {
+		entries := got[ctype]
+		if len(entries) != 1 || entries[0].Type != ctype || entries[0].CveID != "CVE-2024-2" || entries[0].Cvss3Severity != severity || !entries[0].Published.Equal(date) || !entries[0].LastModified.Equal(date) || len(entries[0].References) != 1 {
+			t.Fatalf("%s: %#v", ctype, entries)
+		}
+	}
+	if got[models.TrivyUbuntu][0].Cvss3Score != 5.1 || got[models.TrivyDebian][0].Cvss3Score != 0 {
+		t.Fatalf("source scores mixed: %#v", got)
+	}
+}
