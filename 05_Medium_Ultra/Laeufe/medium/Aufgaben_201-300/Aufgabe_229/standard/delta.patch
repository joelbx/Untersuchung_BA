 		}
 	}
 
+	function localProfilePath(url, uid, type) {
+		const prefix = `${nconf.get('relative_path') || ''}/assets/uploads/profile/`;
+		if (typeof url !== 'string') {
+			return false;
+		}
+		// Uploads are stored without relative_path; public user data includes it.
+		const publicUrl = url.startsWith('/assets/uploads/profile/') ? `${nconf.get('relative_path') || ''}${url}` : url;
+		if (!publicUrl.startsWith(prefix)) {
+			return false;
+		}
+		const filename = publicUrl.slice(prefix.length);
+		return profileFilename(uid, type).test(filename) ? path.join(nconf.get('upload_path'), 'profile', filename) : false;
+	}
+
+	function profileFilename(uid, type) {
+		if (!/^\d+$/.test(String(uid)) || !Number.isSafeInteger(Number(uid)) || Number(uid) <= 0) {
+			throw new Error('[[error:invalid-uid]]');
+		}
+		return new RegExp(`^${Number(uid)}-profile${type}(?:-\\d+)?\\.(?:png|jpeg|jpg|bmp)$`, 'i');
+	}
+
+	async function existingProfilePaths(uid, type) {
+		const folder = path.join(nconf.get('upload_path'), 'profile');
+		let names;
+		try {
+			names = await fs.promises.readdir(folder);
+		} catch (err) {
+			if (err.code === 'ENOENT') {
+				return [];
+			}
+			throw err;
+		}
+		const pattern = profileFilename(uid, type);
+		return names.filter(name => pattern.test(name)).map(name => path.join(folder, name));
+	}
+
+	async function deleteLocalFile(filename) {
+		try {
+			await fs.promises.unlink(filename);
+		} catch (err) {
+			if (err.code !== 'ENOENT') {
+				throw err;
+			}
+		}
+	}
+
+	User.getLocalCoverPath = async function (uid) {
+		const current = localProfilePath(await User.getUserField(uid, 'cover:url'), uid, 'cover');
+		if (current && await file.exists(current)) {
+			return current;
+		}
+		const paths = await existingProfilePaths(uid, 'cover');
+		return paths[0] || false;
+	};
+
+	User.getLocalAvatarPath = async function (uid) {
+		const current = localProfilePath(await db.getObjectField(`user:${uid}`, 'uploadedpicture'), uid, 'avatar');
+		if (current && await file.exists(current)) {
+			return current;
+		}
+		const paths = await existingProfilePaths(uid, 'avatar');
+		return paths[0] || false;
+	};
+
+	User.deleteProfileImageFiles = async function (uid) {
+		const paths = await Promise.all(['cover', 'avatar'].map(type => existingProfilePaths(uid, type)));
+		await Promise.all(paths.flat().map(deleteLocalFile));
+	};
+
+	async function removeImageFiles(uid, type, url) {
+		const paths = await existingProfilePaths(uid, type);
+		const current = localProfilePath(url, uid, type);
+		if (current) {
+			paths.push(current);
+		}
+		await Promise.all([...new Set(paths)].map(deleteLocalFile));
+	}
+
 	function validateUpload(data, maxSize, allowedTypes) {
 		if (!data.imageData) {
 			throw new Error('[[error:invalid-data]]');
@@ -201,7 +279,20 @@ module.exports = function (User) {
