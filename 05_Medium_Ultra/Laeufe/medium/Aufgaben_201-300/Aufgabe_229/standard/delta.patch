@@ -1,6 +1,8 @@
 'use strict';
 
 const path = require('path');
+const fs = require('fs');
+const nconf = require('nconf');
 
 const db = require('../database');
 const image = require('../image');
@@ -62,6 +64,36 @@ module.exports = function (Groups) {
 	};
 
 	Groups.removeCover = async function (data) {
+		const urls = await db.getObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url']);
+		const prefix = `${nconf.get('relative_path') || ''}/assets/uploads/files/`;
+		const folder = path.resolve(nconf.get('upload_path'), 'files');
+		await Promise.all(Object.values(urls).map(async (url) => {
+			if (typeof url !== 'string') {
+				return;
+			}
+			const publicUrl = url.startsWith('/assets/uploads/files/') ? `${nconf.get('relative_path') || ''}${url}` : url;
+			if (!publicUrl.startsWith(prefix)) {
+				return;
+			}
+			const filename = publicUrl.slice(prefix.length);
+			if (!filename || filename === '.' || filename === '..' || /[/\\]/.test(filename)) {
+				return;
+			}
+			const filenames = [filename];
+			if (/^groupCover(?:Thumb)?-/.test(filename) && /\.(?:png|jpeg|jpg|bmp)$/i.test(filename)) {
+				const stem = filename.slice(0, filename.lastIndexOf('.'));
+				filenames.push(...['png', 'jpeg', 'jpg', 'bmp'].map(ext => `${stem}.${ext}`));
+			}
+			await Promise.all([...new Set(filenames)].map(async (name) => {
+				try {
+					await fs.promises.unlink(path.join(folder, name));
+				} catch (err) {
+					if (err.code !== 'ENOENT') {
+						throw err;
+					}
+				}
+			}));
+		}));
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
 	};
 };
