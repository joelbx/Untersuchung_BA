-	User.removeCoverPicture = async function (data) {
-		await db.deleteObjectFields(`user:${data.uid}`, ['cover:url', 'cover:position']);
+	User.removeCoverPicture = async function (uid) {
+		const url = await User.getUserField(uid, 'cover:url');
+		await removeImageFiles(uid, 'cover', url);
+		await db.deleteObjectFields(`user:${uid}`, ['cover:url', 'cover:position']);
+		return { success: true };
+	};
+
+	User.removeProfileImage = async function (uid) {
+		const previous = await db.getObjectFields(`user:${uid}`, ['uploadedpicture', 'picture']);
+		await removeImageFiles(uid, 'avatar', previous.uploadedpicture);
+		await User.setUserFields(uid, {
+			uploadedpicture: '',
+			picture: previous.picture === previous.uploadedpicture ? '' : previous.picture,
+		});
+		return previous;
 	};
 };
