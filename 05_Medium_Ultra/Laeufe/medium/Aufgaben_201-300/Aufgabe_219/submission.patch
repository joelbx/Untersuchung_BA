+func TestDeleteTokenAuditEvent(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		enabled bool
+	}{
+		{name: "disabled"},
+		{name: "enabled", enabled: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			store := memory.NewStore()
+			_, authentication, err := store.CreateAuthentication(context.Background(), &storageauth.CreateAuthenticationRequest{
+				Method: rpcauth.Method_METHOD_TOKEN,
+			})
+			require.NoError(t, err)
+
+			recorder := tracetest.NewSpanRecorder()
+			provider := sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(recorder))
+			ctx, span := provider.Tracer("test").Start(context.Background(), "delete token")
+			server := auth.NewServer(zaptest.NewLogger(t), store, auth.WithAuditLoggingEnabled(tc.enabled))
+			_, err = server.DeleteAuthentication(ctx, &rpcauth.DeleteAuthenticationRequest{Id: authentication.Id})
+			require.NoError(t, err)
+			span.End()
+
+			events := recorder.Ended()[0].Events()
+			if !tc.enabled {
+				require.Empty(t, events)
+				return
+			}
+			require.Len(t, events, 1)
+			var eventType, action string
+			var payload string
+			for _, attr := range events[0].Attributes {
+				switch string(attr.Key) {
+				case "flipt.event.type":
+					eventType = attr.Value.AsString()
+				case "flipt.event.action":
+					action = attr.Value.AsString()
+				case "flipt.event.payload":
+					payload = attr.Value.AsString()
+				}
+			}
+			require.Equal(t, "token", eventType)
+			require.Equal(t, "deleted", action)
+			require.Equal(t, "{}", payload)
+		})
+	}
+}
