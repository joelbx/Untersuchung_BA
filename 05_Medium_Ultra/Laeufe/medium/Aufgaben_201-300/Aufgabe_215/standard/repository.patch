index 0000000..4f0bd48
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"fmt"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func writeConfig(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "config.yml")
+	if err := ioutil.WriteFile(path, []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestConfigureDefaultsAndOverrides(t *testing.T) {
+	cfg, err := configure(writeConfig(t, "{}\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, defaultConfig()) {
+		t.Fatalf("defaults differ: %#v", cfg)
+	}
+	if HTTP.String() != "http" || HTTPS.String() != "https" {
+		t.Fatalf("unexpected scheme strings: %q, %q", HTTP, HTTPS)
+	}
+	cfg, err = configure(writeConfig(t, "cors:\n  allowed_origins: foo.com\n"))
+	if err != nil || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) {
+		t.Fatalf("scalar allowed origin: %#v, %v", cfg, err)
+	}
+
+	dir := t.TempDir()
+	cert := filepath.Join(dir, "cert.pem")
+	key := filepath.Join(dir, "key.pem")
+	for _, path := range []string{cert, key} {
+		if err := ioutil.WriteFile(path, []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := writeConfig(t, fmt.Sprintf(`log:
+  level: WARN
+ui:
+  enabled: false
+cors:
+  enabled: true
+  allowed_origins: [foo.com]
+cache:
+  memory:
+    enabled: true
+    items: 5000
+server:
+  host: 127.0.0.1
+  protocol: https
+  http_port: 8081
+  https_port: 8080
+  grpc_port: 9001
+  cert_file: %q
+  cert_key: %q
+db:
+  url: postgres://postgres@localhost:5432/flipt?sslmode=disable
+  migrations:
+    path: ./config/migrations
+`, cert, key))
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LogLevel != "WARN" || cfg.UI.Enabled || !cfg.Cors.Enabled || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"foo.com"}) ||
+		!cfg.Cache.Memory.Enabled || cfg.Cache.Memory.Items != 5000 || cfg.Server != (serverConfig{"127.0.0.1", HTTPS, 8081, 8080, 9001, cert, key}) ||
+		cfg.Database.URL != "postgres://postgres@localhost:5432/flipt?sslmode=disable" || cfg.Database.MigrationsPath != "./config/migrations" {
+		t.Fatalf("unexpected advanced config: %#v", cfg)
+	}
+
+	if err := os.Setenv("FLIPT_SERVER_HTTPS_PORT", "4443"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_SERVER_HTTPS_PORT")
+	if err := os.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", "bar.com"); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv("FLIPT_CORS_ALLOWED_ORIGINS")
+	cfg, err = configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Server.HTTPSPort != 4443 || !reflect.DeepEqual(cfg.Cors.AllowedOrigins, []string{"bar.com"}) {
+		t.Fatalf("environment overrides missing: %#v", cfg)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTPS
+	checks := []struct{ cert, key, want string }{
+		{"", "", "cert_file cannot be empty when using HTTPS"},
+		{"missing-cert", "", "cert_key cannot be empty when using HTTPS"},
+		{"missing-cert", "missing-key", `cannot find TLS cert_file at "missing-cert"`},
+	}
+	for _, check := range checks {
+		cfg.Server.CertFile, cfg.Server.CertKey = check.cert, check.key
+		if err := cfg.validate(); err == nil || err.Error() != check.want {
+			t.Fatalf("validate(%q, %q) = %v; want %q", check.cert, check.key, err, check.want)
+		}
+	}
+	cert := filepath.Join(t.TempDir(), "cert")
+	if err := ioutil.WriteFile(cert, []byte("fixture"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg.Server.CertFile = cert
+	if err := cfg.validate(); err == nil || err.Error() != `cannot find TLS cert_key at "missing-key"` {
+		t.Fatalf("missing key: %v", err)
+	}
+	cfg.Server.Protocol = HTTP
+	if err := cfg.validate(); err != nil {
+		t.Fatalf("HTTP validation: %v", err)
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, handler := range []http.Handler{defaultConfig(), info{Version: "test"}} {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/", nil))
+		if recorder.Code != http.StatusOK || strings.TrimSpace(recorder.Body.String()) == "" {
+			t.Fatalf("response: %d %q", recorder.Code, recorder.Body.String())
+		}
+	}
+}
