diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index cbf68a2..ddc5886 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -25,6 +25,69 @@ def createWikidataEntity(
     )
 
 
+@pytest.mark.parametrize(
+    'language, sitelinks, expected',
+    [
+        (
+            'fr',
+            {'frwiki': {'url': 'https://fr.wikipedia.org/wiki/A'}, 'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'}},
+            ('https://fr.wikipedia.org/wiki/A', 'fr'),
+        ),
+        ('de', {'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'}}, ('https://en.wikipedia.org/wiki/A', 'en')),
+        ('fr', {'frwiki': {'title': 'A'}, 'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'}}, ('https://en.wikipedia.org/wiki/A', 'en')),
+        ('fr', {'dewiki': {'url': 'https://de.wikipedia.org/wiki/A'}}, None),
+    ],
+)
+def test_get_wikipedia_link(language, sitelinks, expected):
+    entity = createWikidataEntity()
+    entity.sitelinks = sitelinks
+    assert entity._get_wikipedia_link(language) == expected
+
+
+def test_get_statement_values():
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'first'}},
+            {'value': {'content': 'second'}},
+            {'value': {}},
+            {'other': 'missing value'},
+            None,
+        ],
+        'P123': {'value': {'content': 'single'}},
+    }
+    assert entity._get_statement_values('P1960') == ['first', 'second']
+    assert entity._get_statement_values('P123') == ['single']
+    assert entity._get_statement_values('missing') == []
+
+
+def test_get_external_profiles():
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'frwiki': {'url': 'https://fr.wikipedia.org/wiki/A'},
+        'enwiki': {'url': 'https://en.wikipedia.org/wiki/A'},
+    }
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'abc'}},
+            {'value': {'content': 'xyz'}},
+            {'value': {}},
+        ]
+    }
+    assert entity.get_external_profiles('fr') == [
+        {'url': 'https://fr.wikipedia.org/wiki/A', 'icon_url': '/static/images/identifier_icons/wikipedia.svg', 'label': 'Wikipedia'},
+        {'url': 'https://www.wikidata.org/wiki/Q42', 'icon_url': '/static/images/identifier_icons/wikidata.svg', 'label': 'Wikidata'},
+        {'url': 'https://scholar.google.com/citations?user=abc', 'icon_url': '/static/images/identifier_icons/google_scholar.svg', 'label': 'Google Scholar'},
+        {'url': 'https://scholar.google.com/citations?user=xyz', 'icon_url': '/static/images/identifier_icons/google_scholar.svg', 'label': 'Google Scholar'},
+    ]
+    assert entity.get_external_profiles('de')[0]['url'] == 'https://en.wikipedia.org/wiki/A'
+
+    entity.sitelinks = {}
+    assert [profile['label'] for profile in entity.get_external_profiles()] == [
+        'Wikidata', 'Google Scholar', 'Google Scholar'
+    ]
+
+
 EXPIRED = "expired"
 MISSING = "missing"
 VALID_CACHE = ""
