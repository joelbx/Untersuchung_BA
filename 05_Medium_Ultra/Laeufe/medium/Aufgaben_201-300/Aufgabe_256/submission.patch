+    def test_hosts_derive_name_without_changing_data(self):
+        data = dict(hosts=['foo', 'bar'])
+        p = Play.load(data)
+        self.assertEqual(data, dict(hosts=['foo', 'bar']))
+        self.assertEqual(p.get_name(), 'foo,bar')
+        p.hosts = ['baz']
+        self.assertEqual(p.get_name(), 'baz')
+        p.name = 'explicit name'
+        self.assertEqual(p.get_name(), 'explicit name')
+
+    def test_hosts_name_for_other_values(self):
+        self.assertEqual(Play.load(dict(hosts='foo')).get_name(), 'foo')
+        self.assertEqual(Play.load(dict(hosts=('foo', 'bar'))).get_name(), 'foo,bar')
+        self.assertEqual(Play.load(dict(hosts=[b'foo', 'bar'])).get_name(), 'foo,bar')
+        p = Play.load(dict())
+        self.assertEqual(p.get_name(), '')
+        p.hosts = None
+        self.assertEqual(p.get_name(), '')
+
