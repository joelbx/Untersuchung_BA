+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "abort", "stalled"]);
+const debugEvents = new Set([
+    "loadstart", "loadedmetadata", "loadeddata", "canplay", "canplaythrough",
+    "play", "playing", "pause", "ended", "waiting", "suspend", "progress",
+    "durationchange", "seeking", "seeked", "timeupdate", "volumechange", "ratechange",
+]);
+
+/** Listener for media element events emitted by call sounds. */
+export function handleEvent(e: Event): void {
+    const id = (e.currentTarget as HTMLMediaElement | null)?.id ?? (e.target as HTMLMediaElement | null)?.id;
+    if (errorEvents.has(e.type)) {
+        logger.error("LegacyCallHandler audio event", { id, type: e.type });
+    } else if (debugEvents.has(e.type) && SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("LegacyCallHandler audio event", { id, type: e.type });
+    }
+}
