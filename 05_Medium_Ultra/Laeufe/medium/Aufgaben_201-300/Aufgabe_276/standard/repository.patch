+// Viper normalizes map keys to lowercase. OIDC provider names are user-defined
+// YAML keys, so restore their spelling for validation and provider lookups.
+func restoreOIDCProviderKeys(path string, cfg *Config) error {
+	if ext := strings.ToLower(filepath.Ext(path)); ext != ".yml" && ext != ".yaml" {
+		return nil
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+
+	var keys struct {
+		Authentication struct {
+			Methods struct {
+				OIDC struct {
+					Providers map[string]interface{} `yaml:"providers"`
+				} `yaml:"oidc"`
+			} `yaml:"methods"`
+		} `yaml:"authentication"`
+	}
+	if err := yaml.Unmarshal(data, &keys); err != nil {
+		return err
+	}
+
+	providers := cfg.Authentication.Methods.OIDC.Method.Providers
+	for name := range keys.Authentication.Methods.OIDC.Providers {
+		lower := strings.ToLower(name)
+		if lower != name {
+			if provider, ok := providers[lower]; ok {
+				delete(providers, lower)
+				providers[name] = provider
+			}
+		}
+	}
+	return nil
+}
