+	describe('incrObjectFieldByBulk()', () => {
+		it('increments several fields and keys, including missing objects and fields', async () => {
+			await db.setObject('bulkIncrementExisting', { age: 10 });
+			await db.getObject('bulkIncrementExisting'); // populate the object cache
+			const result = await db.incrObjectFieldByBulk([
+				['bulkIncrementExisting', { age: 5, newField: 10 }],
+				['bulkIncrementMissing', { count: -2 }],
+			]);
+			assert.strictEqual(result, undefined);
+			const existing = await db.getObject('bulkIncrementExisting');
+			const missing = await db.getObject('bulkIncrementMissing');
+			assert.strictEqual(Number(existing.age), 15);
+			assert.strictEqual(Number(existing.newField), 10);
+			assert.strictEqual(Number(missing.count), -2);
+		});
+
+		it('leaves a failing key intact while updating other keys', async () => {
+			await db.setObject('bulkIncrementInvalid', { age: 4, name: 'text' });
+			await db.getObject('bulkIncrementInvalid'); // populate the object cache
+			await assert.rejects(db.incrObjectFieldByBulk([
+				['bulkIncrementInvalid', { age: 1, name: 2 }],
+				['bulkIncrementValid', { age: 3 }],
+			]));
+			const invalid = await db.getObject('bulkIncrementInvalid');
+			const valid = await db.getObject('bulkIncrementValid');
+			assert.strictEqual(Number(invalid.age), 4);
+			assert.strictEqual(invalid.name, 'text');
+			assert.strictEqual(Number(valid.age), 3);
+		});
+
+		it('rejects malformed input, unsafe increments, and dangerous fields', async () => {
+			await Promise.all([
+				{ key: { age: 1 } },
+				[['key', 1]],
+				[['key', { age: 1.5 }]],
+				[['key', { age: Number.MAX_SAFE_INTEGER + 1 }]],
+				[['key', { 'a.b': 1 }]],
+				[['key', { 'a/b': 1 }]],
+				[['key', { $age: 1 }]],
+				[['key', { ['__proto__']: 1 }]],
+				[['key', { constructor: 1 }]],
+			].map(input => assert.rejects(db.incrObjectFieldByBulk(input))));
+		});
+
+		it('accepts an empty array without writing', async () => {
+			assert.strictEqual(await db.incrObjectFieldByBulk([]), undefined);
+		});
+
+		it('preserves concurrent increments to the same key', async () => {
+			await Promise.all(Array.from({ length: 20 }, () => db.incrObjectFieldByBulk([
