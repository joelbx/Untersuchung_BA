 	const helpers = require('./helpers');
+	const normalizeIncrementBulk = require('../incrementBulk');
+	const incrementScript = `
+local limit = 9007199254740991
+for i = 1, #ARGV, 2 do
+	local current = redis.call('HGET', KEYS[1], ARGV[i])
+	if current then
+		if not string.match(current, '^%-?%d+$') then
+			return redis.error_reply('hash field is not an integer')
+		end
+		local number = tonumber(current)
+		local increment = tonumber(ARGV[i + 1])
+		if not number or math.abs(number) > limit or math.abs(number + increment) > limit then
+			return redis.error_reply('hash field exceeds the safe integer range')
+		end
+	end
+end
+for i = 1, #ARGV, 2 do
+	redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+end
+return 1`;
 
 	const cache = require('../cache').create('redis');
 
