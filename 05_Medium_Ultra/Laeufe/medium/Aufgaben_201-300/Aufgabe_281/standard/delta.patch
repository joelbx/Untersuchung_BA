index 0000000..0f98daf
--- /dev/null
+++ b/src/database/incrementBulk.js
@@ -0,0 +1,37 @@
+'use strict';
+
+module.exports = function normalizeIncrementBulk(data, fieldToString) {
+	if (!Array.isArray(data)) {
+		throw new TypeError('Bulk increments must be an array of [key, increments] tuples');
+	}
+	const byKey = new Map();
+	data.forEach((item) => {
+		if (!Array.isArray(item) || item.length !== 2 || typeof item[0] !== 'string' || !item[0] ||
+			!item[1] || typeof item[1] !== 'object' || Array.isArray(item[1]) ||
+			(Object.getPrototypeOf(item[1]) !== Object.prototype && Object.getPrototypeOf(item[1]) !== null)) {
+			throw new TypeError('Bulk increments must contain [key, increments] tuples');
+		}
+		const [key, increments] = item;
+		let fields = byKey.get(key);
+		if (!fields) {
+			fields = Object.create(null);
+			byKey.set(key, fields);
+		}
+		Object.entries(increments).forEach(([rawField, value]) => {
+			const field = fieldToString(rawField);
+			if (!field || field === '__proto__' || field === 'constructor' || field === 'prototype' ||
+				/[.$/]/.test(rawField) || /[.$/]/.test(field)) {
+				throw new TypeError(`Invalid increment field: ${rawField}`);
+			}
+			if (!Number.isSafeInteger(value)) {
+				throw new TypeError(`Increment for ${field} must be a safe integer`);
+			}
+			const total = (fields[field] || 0) + value;
+			if (!Number.isSafeInteger(total)) {
+				throw new RangeError(`Increment for ${field} exceeds the safe integer range`);
+			}
+			fields[field] = total;
+		});
+	});
+	return Array.from(byKey).filter(([, fields]) => Object.keys(fields).length);
+};
