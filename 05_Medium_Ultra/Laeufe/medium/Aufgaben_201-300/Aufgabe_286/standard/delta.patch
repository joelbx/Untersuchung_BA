diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..25d3f19
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,90 @@
+package release
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info contains the version information returned by an update check.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	if version == "" || version == "dev" || strings.HasSuffix(version, "dev") {
+		return false
+	}
+
+	// Pre-release identifiers can be followed by a numeric qualifier or build metadata.
+	preRelease := strings.SplitN(version, "+", 2)[0]
+	if i := strings.IndexByte(preRelease, '-'); i >= 0 {
+		for _, identifier := range strings.FieldsFunc(preRelease[i+1:], func(r rune) bool { return r == '-' || r == '.' }) {
+			switch identifier {
+			case "dev", "snapshot", "rc":
+				return false
+			}
+			if strings.HasPrefix(identifier, "rc") && len(identifier) > 2 {
+				allDigits := true
+				for _, digit := range identifier[2:] {
+					if digit < '0' || digit > '9' {
+						allDigits = false
+						break
+					}
+				}
+				if allDigits {
+					return false
+				}
+			}
+		}
+	}
+
+	return true
+}
+
+// Check retrieves the latest release and compares it with version.
+// A failed check is reported as a warning so callers can continue startup.
+func Check(ctx context.Context, version string) (Info, error) {
+	result, err := check(ctx, version, func(ctx context.Context) (*github.RepositoryRelease, error) {
+		client := github.NewClient(nil)
+		release, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+		return release, err
+	})
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return result, err
+}
+
+func check(ctx context.Context, version string, latest func(context.Context) (*github.RepositoryRelease, error)) (Info, error) {
+	result := Info{CurrentVersion: version}
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return result, fmt.Errorf("parsing current version: %w", err)
+	}
+
+	release, err := latest(ctx)
+	if err != nil {
+		return result, fmt.Errorf("getting latest release: %w", err)
+	}
+	if release == nil {
+		return result, fmt.Errorf("getting latest release: empty response")
+	}
+
+	latestVersion, err := semver.ParseTolerant(release.GetTagName())
+	if err != nil {
+		return result, fmt.Errorf("parsing latest version: %w", err)
+	}
+	result.LatestVersion = release.GetTagName()
+	result.LatestVersionURL = release.GetHTMLURL()
+	result.UpdateAvailable = current.LT(latestVersion)
+	return result, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..b1ba832
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,61 @@
+package release
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"github.com/stretchr/testify/require"
+)
+
+func TestIs(t *testing.T) {
+	for _, tc := range []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"v1.2.3-dev", false},
+		{"v1.2.3-snapshot", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-rc1", false},
+		{"v1.2.3-rc+build", false},
+		{"v1.2.3", true},
+		{"v1.2.3+build", true},
+	} {
+		t.Run(tc.version, func(t *testing.T) {
+			require.Equal(t, tc.want, Is(tc.version))
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	for _, tc := range []struct {
+		current string
+		latest  string
+		update  bool
+	}{
+		{"v1.2.3", "v1.2.3", false},
+		{"v1.2.3", "v1.2.4", true},
+		{"v1.2.4", "v1.2.3", false},
+	} {
+		t.Run(tc.current+"_"+tc.latest, func(t *testing.T) {
+			got, err := check(context.Background(), tc.current, func(context.Context) (*github.RepositoryRelease, error) {
+				return &github.RepositoryRelease{TagName: github.String(tc.latest), HTMLURL: github.String("https://example.com/release")}, nil
+			})
+			require.NoError(t, err)
+			require.Equal(t, Info{
+				CurrentVersion: tc.current, LatestVersion: tc.latest,
+				UpdateAvailable: tc.update, LatestVersionURL: "https://example.com/release",
+			}, got)
+		})
+	}
+
+	got, err := check(context.Background(), "v1.2.3", func(context.Context) (*github.RepositoryRelease, error) {
+		return nil, errors.New("unavailable")
+	})
+	require.ErrorContains(t, err, "unavailable")
+	require.Equal(t, Info{CurrentVersion: "v1.2.3"}, got)
+}
