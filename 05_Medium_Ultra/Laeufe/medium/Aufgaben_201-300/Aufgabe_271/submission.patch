+def get_location_and_publisher(loc_pub: str) -> tuple[list[str], list[str]]:
+    """Extract ordered publication places and publishers from IA metadata."""
+    if not isinstance(loc_pub, str) or not loc_pub:
+        return [], []
+
+    loc_pub = loc_pub.replace('Place of publication not identified', '')
+
+    def clean(value: str) -> str:
+        return value.replace('[', '').replace(']', '').strip(STRIP_CHARS)
+
+    if ':' not in loc_pub:
+        publisher = loc_pub.split(',', 1)[1] if ',' in loc_pub else loc_pub
+        publisher = clean(publisher)
+        return [], [publisher] if publisher else []
+
+    locations = []
+    publishers = []
+    pending_locations = []
+    for segment in loc_pub.split(';'):
+        if ':' not in segment:
+            location = clean(segment)
+            if location:
+                pending_locations.append(location)
+            continue
+
+        # Metadata occasionally contains a second colon. Only the first pair
+        # in that segment has a reliable meaning.
+        location, publisher = get_colon_only_loc_pub(':'.join(segment.split(':')[:2]))
+        location = clean(location)
+        publisher = clean(publisher)
+        locations.extend(pending_locations)
+        pending_locations = []
+        if location:
+            locations.append(location)
+        if publisher:
+            publishers.append(publisher)
+    return locations, publishers
 
 
