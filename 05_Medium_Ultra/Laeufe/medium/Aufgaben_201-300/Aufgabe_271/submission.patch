+def test_get_ia_record_handles_multiple_places_and_isbn_lengths() -> None:
+    metadata = {
+        'publisher': 'London ; New York ; Paris : Berlitz Publishing',
+        'isbn': [' 1234567890 ', ' 1234567890123 ', 'short'],
+    }
+    result = code.ia_importapi.get_ia_record(metadata)
+    assert result['publishers'] == ['Berlitz Publishing']
+    assert result['publish_places'] == ['London', 'New York', 'Paris']
+    assert result['isbn_10'] == ['1234567890']
+    assert result['isbn_13'] == ['1234567890123']
+
+
+def test_get_ia_record_preserves_unsplit_publisher_names() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {'publisher': ['First Publisher', 'Second Publisher']}
+    )
+    assert result['publishers'] == ['First Publisher', 'Second Publisher']
