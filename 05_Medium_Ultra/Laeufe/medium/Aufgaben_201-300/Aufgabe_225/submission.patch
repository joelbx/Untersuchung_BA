 	json    string
diff --git a/detector/kevuln_test.go b/detector/kevuln_test.go
new file mode 100644
index 0000000..c9026d6
--- /dev/null
+++ b/detector/kevuln_test.go
@@ -0,0 +1,53 @@
+//go:build !scanner
+
+package detector
+
+import (
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulndb "github.com/vulsio/go-kev/db"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestConvertKEVs(t *testing.T) {
+	added := time.Date(2024, 8, 1, 0, 0, 0, 0, time.UTC)
+	due := added.AddDate(0, 0, 30)
+	got := convertKEVs(kevulndb.Response{
+		CISA: []kevulnmodels.KEVuln{{
+			VendorProject: "CISA vendor", Product: "product", VulnerabilityName: "CISA name",
+			ShortDescription: "description", RequiredAction: "action",
+			KnownRansomwareCampaignUse: "Known", DateAdded: added,
+			Notes: "note", DueDate: time.Date(1000, 1, 1, 0, 0, 0, 0, time.UTC),
+		}},
+		VulnCheck: []kevulnmodels.VulnCheck{{
+			VendorProject: "VC vendor", Product: "other", Name: "VC name",
+			Description: "VC description", RequiredAction: "VC action",
+			KnownRansomwareCampaignUse: "Unknown", DateAdded: added, DueDate: &due,
+			VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{
+				XDBID: "123", XDBURL: "https://example.com/xdb", DateAdded: added,
+				ExploitType: "poc", CloneSSHURL: "ssh://example.com",
+			}},
+			VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{
+				URL: "https://example.com/report", DateAdded: added,
+			}},
+		}},
+	})
+	if len(got) != 2 || got[0].Type != models.CISAKEVType || got[1].Type != models.VulnCheckKEVType {
+		t.Fatalf("unexpected KEVs: %+v", got)
+	}
+	if got[0].DueDate != nil || got[0].CISA == nil || got[0].CISA.Note != "note" || got[0].VendorProject != "CISA vendor" {
+		t.Errorf("CISA mapping: %+v", got[0])
+	}
+	vc := got[1]
+	if vc.DueDate == nil || !vc.DueDate.Equal(due) || vc.VulnerabilityName != "VC name" || vc.ShortDescription != "VC description" || vc.VulnCheck == nil {
+		t.Fatalf("VulnCheck mapping: %+v", vc)
+	}
+	if len(vc.VulnCheck.XDB) != 1 || vc.VulnCheck.XDB[0].XDBID != "123" || vc.VulnCheck.XDB[0].CloneSSHURL != "ssh://example.com" {
+		t.Errorf("XDB mapping: %+v", vc.VulnCheck.XDB)
+	}
+	if len(vc.VulnCheck.ReportedExploitation) != 1 || vc.VulnCheck.ReportedExploitation[0].URL != "https://example.com/report" {
+		t.Errorf("reported exploitation mapping: %+v", vc.VulnCheck.ReportedExploitation)
+	}
+}
