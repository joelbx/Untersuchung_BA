+export const guessDateFromText = (text: string): Date | undefined => {
+    const isoDate = parseISO(text);
+    if (isValid(isoDate)) {
+        return isoDate;
+    }
+
+    // Date accepts some invalid ISO dates by rolling them into the next month.
+    if (/^\d{4}-/.test(text)) {
+        return undefined;
+    }
+
+    const date = new Date(text);
+    if (!isValid(date)) {
+        return undefined;
+    }
+
+    const slashDate = text.match(/^(\d{1,4})\/(\d{1,2})\/(\d{1,4})$/);
+    if (slashDate) {
+        const [, first, second, third] = slashDate;
+        const yearFirst = first.length === 4;
+        const year = Number(yearFirst ? first : third);
+        const month = Number(yearFirst ? second : first);
+        const day = Number(yearFirst ? third : second);
+        if (date.getFullYear() !== year || date.getMonth() + 1 !== month || date.getDate() !== day) {
+            return undefined;
+        }
+    }
+
+    return date;
+};
+
+/** Get a valid date from a birthday or anniversary property, if possible. */
 export const getDateFromVCardProperty = ({ value: { date, text } }: VCardProperty<VCardDateOrText>) => {
