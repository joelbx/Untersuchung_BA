@@ -0,0 +1,105 @@
+package config
+
+import "time"
+
+// OS family identifiers used by scan results and lifecycle lookup.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+	ServerTypePseudo      = "pseudo"
+)
+
+// EOL describes the end of standard and optional extended OS support.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether the standard support date has passed.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	return !e.StandardSupportUntil.IsZero() && now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether an applicable extended support date has passed.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+type supportDates struct {
+	standard string
+	extended string
+}
+
+// eolDates is the canonical list of supported release identifiers and dates.
+var eolDates = map[string]map[string]supportDates{
+	Amazon: {
+		"2018.03":   {"2023-06-30", "2023-06-30"},
+		"2 (Karoo)": {"2025-06-30", ""},
+	},
+	RedHat: {
+		"7": {"2024-06-30", ""},
+		"8": {"2029-05-31", ""},
+		"6": {"2020-11-30", "2024-06-30"},
+	},
+	CentOS: {
+		"7": {"2024-06-30", ""},
+		"8": {"2021-12-31", ""},
+		"6": {"2020-11-30", "2020-11-30"},
+	},
+	Oracle: {
+		"7": {"2024-06-30", ""},
+		"8": {"2029-05-31", ""},
+		"6": {"2021-03-31", "2022-03-31"},
+	},
+	Ubuntu: {
+		"18.04": {"2023-05-31", "2028-04-30"},
+		"14.04": {"2019-04-30", "2024-04-30"},
+		"14.10": {"2015-07-30", "2015-07-30"},
+		"21.04": {"2022-01-30", ""},
+	},
+	Debian: {
+		"9":  {"2022-06-30", ""},
+		"10": {"2024-06-30", ""},
+		"8":  {"2020-06-30", "2020-06-30"},
+	},
+	Alpine: {
+		"3.10": {"2021-05-30", ""},
+		"3.11": {"2021-11-30", ""},
+		"3.12": {"2022-05-30", ""},
+		"3.9":  {"2020-11-30", "2020-11-30"},
+	},
+	FreeBSD: {
+		"11": {"2021-09-30", "2021-09-30"},
+		"12": {"2023-12-31", ""},
+		"10": {"2019-10-30", "2019-10-30"},
+	},
+}
+
+// GetEOL returns lifecycle dates for an exact OS family and release identifier.
+func GetEOL(family string, release string) (EOL, bool) {
+	dates, found := eolDates[family][release]
+	if !found {
+		return EOL{}, false
+	}
+	standard, _ := time.Parse("2006-01-02", dates.standard)
+	var extended time.Time
+	if dates.extended != "" {
+		extended, _ = time.Parse("2006-01-02", dates.extended)
+	}
+	return EOL{StandardSupportUntil: standard, ExtendedSupportUntil: extended}, true
+}
diff --git a/config/os_test.go b/config/os_test.go
new file mode 100644
index 0000000..15a3dd1
--- /dev/null
+++ b/config/os_test.go
@@ -0,0 +1,57 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestGetEOL(t *testing.T) {
+	tests := []struct {
+		family, release, standard, extended string
+	}{
+		{Amazon, "2018.03", "2023-06-30", "2023-06-30"},
+		{Amazon, "2 (Karoo)", "2025-06-30", ""},
+		{RedHat, "6", "2020-11-30", "2024-06-30"},
+		{CentOS, "8", "2021-12-31", ""},
+		{Oracle, "6", "2021-03-31", "2022-03-31"},
+		{Ubuntu, "14.10", "2015-07-30", "2015-07-30"},
+		{Debian, "10", "2024-06-30", ""},
+		{Alpine, "3.12", "2022-05-30", ""},
+		{FreeBSD, "11", "2021-09-30", "2021-09-30"},
+	}
+	for _, tt := range tests {
+		eol, found := GetEOL(tt.family, tt.release)
+		if !found || eol.StandardSupportUntil.Format("2006-01-02") != tt.standard {
+			t.Errorf("%s %s: standard date = %v, found = %v", tt.family, tt.release, eol.StandardSupportUntil, found)
+		}
+		if tt.extended == "" {
+			if !eol.ExtendedSupportUntil.IsZero() {
+				t.Errorf("%s %s: unexpected extended date", tt.family, tt.release)
+			}
+		} else if eol.ExtendedSupportUntil.Format("2006-01-02") != tt.extended {
+			t.Errorf("%s %s: extended date = %v", tt.family, tt.release, eol.ExtendedSupportUntil)
+		}
+	}
+	for _, tt := range []struct{ family, release string }{
+		{RedHat, "9"}, {CentOS, "9"}, {Oracle, "9"}, {Ubuntu, "12.10"},
+		{Debian, "11"}, {Alpine, "3.13"}, {Amazon, "2 (Other)"},
+	} {
+		if _, found := GetEOL(tt.family, tt.release); found {
+			t.Errorf("unexpected EOL for %s %s", tt.family, tt.release)
+		}
+	}
+}
+
+func TestEOLBoundaries(t *testing.T) {
+	standard, _ := time.Parse("2006-01-02", "2024-06-30")
+	e := EOL{StandardSupportUntil: standard, ExtendedSupportUntil: standard}
+	if e.IsStandardSupportEnded(standard) || e.IsExtendedSuppportEnded(standard) {
+		t.Fatal("support must remain active on its end date")
+	}
+	if !e.IsStandardSupportEnded(standard.Add(time.Nanosecond)) || !e.IsExtendedSuppportEnded(standard.Add(time.Nanosecond)) {
+		t.Fatal("support must end immediately after its end date")
+	}
+	if (EOL{}).IsExtendedSuppportEnded(standard) {
+		t.Fatal("missing extended support date is not an ended phase")
+	}
+}
