@@ -0,0 +1,17 @@
+package version
+
+import "strings"
+
+// Major returns the component before the first dot after an optional epoch.
+func Major(value string) string {
+	if i := strings.IndexByte(value, ':'); i >= 0 {
+		value = value[i+1:]
+	}
+	if fields := strings.Fields(value); len(fields) > 0 {
+		value = fields[0]
+	}
+	if i := strings.IndexByte(value, '.'); i >= 0 {
+		return value[:i]
+	}
+	return value
+}
