+@pytest.mark.parametrize('level, source, msg, expected', [
+    (usertypes.JsLogLevel.error, 'userscript:styles',
+     'Refused to apply inline style because of CSP', False),
+    (usertypes.JsLogLevel.error, 'userscript:styles',
+     'Unexpected failure', True),
+    (usertypes.JsLogLevel.warning, 'userscript:styles',
+     'Unexpected failure', False),
+    (usertypes.JsLogLevel.error, 'qute:internal',
+     'Refused to apply inline style because of CSP', True),
+    (usertypes.JsLogLevel.error, 'page:styles',
+     'Unexpected failure', False),
+])
+def test_js_log_to_ui(config_stub, mocker, level, source, msg, expected):
+    config_stub.val.content.javascript.log_message.levels = {
+        'userscript:*': ['error'], 'qute:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'userscript:*': ['Refused to apply inline style*']}
+    show = mocker.patch('qutebrowser.browser.shared.message.error')
+    mocker.patch.dict(shared._JS_LOGMAP_MESSAGE,
+                      {usertypes.JsLogLevel.error: show})
+
+    assert shared._js_log_to_ui(level, source, 66, msg) is expected
+    if expected:
+        show.assert_called_once_with(f'JS: [{source}:66] {msg}')
+    else:
+        show.assert_not_called()
+
+
+def test_js_log_to_ui_multiple_source_patterns(config_stub, mocker):
+    config_stub.val.content.javascript.log_message.levels = {
+        '*': ['info'], 'userscript:*': ['error']}
+    config_stub.val.content.javascript.log_message.excludes = {
+        'other:*': ['*'], 'userscript:*': ['*CSP*']}
+    show = mocker.patch('qutebrowser.browser.shared.message.error')
+    mocker.patch.dict(shared._JS_LOGMAP_MESSAGE,
+                      {usertypes.JsLogLevel.error: show})
+
+    assert shared._js_log_to_ui(usertypes.JsLogLevel.error,
+                                'userscript:styles', 66, 'CSP violation') is False
+    assert shared._js_log_to_ui(usertypes.JsLogLevel.error,
+                                'userscript:styles', 67, 'Other failure') is True
+    show.assert_called_once_with('JS: [userscript:styles:67] Other failure')
+
+
