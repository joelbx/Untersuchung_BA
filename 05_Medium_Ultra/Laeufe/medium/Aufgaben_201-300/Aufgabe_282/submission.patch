@@ -150,7 +150,7 @@ _JS_LOGMAP: Mapping[str, Callable[[str], None]] = {
     'warning': log.js.warning,
     'error': log.js.error,
 }
-# Callables to use for content.javascript.log_message.
+# Callables to use for content.javascript.log_message.levels.
 # Note that the keys are JS log levels here, not config settings!
 _JS_LOGMAP_MESSAGE: Mapping[usertypes.JsLogLevel, Callable[[str], None]] = {
     usertypes.JsLogLevel.info: message.info,
@@ -159,6 +159,27 @@ _JS_LOGMAP_MESSAGE: Mapping[usertypes.JsLogLevel, Callable[[str], None]] = {
 }
 
 
+def _js_log_to_ui(level: usertypes.JsLogLevel, source: str, line: int,
+                  msg: str) -> bool:
+    """Show an enabled JavaScript message in the UI, returning whether shown."""
+    levels_by_source = config.cache['content.javascript.log_message.levels'] or {}
+    enabled = any(
+        fnmatch.fnmatchcase(source, pattern) and level.name in levels
+        for pattern, levels in levels_by_source.items()
+    )
+    if not enabled:
+        return False
+
+    excludes = config.cache['content.javascript.log_message.excludes'] or {}
+    for pattern, messages in excludes.items():
+        if fnmatch.fnmatchcase(source, pattern) and any(
+                fnmatch.fnmatchcase(msg, excluded) for excluded in messages):
+            return False
+
+    _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+    return True
+
+
