+def test_both_streams_live_before_exit(proc, qtbot, py_proc, message_mock,
+                                       caplog):
+    proc._output_messages = True
+    live_messages = []
+    message_mock.got_message.connect(
+        lambda level, text: live_messages.append(
+            (level, text, proc.outcome.running)))
+
+    cmd, args = py_proc(r"""
+        import sys, time
+        print('stdout live', flush=True)
+        print('stderr live', file=sys.stderr, flush=True)
+        time.sleep(0.5)
+    """)
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            proc.start(cmd, args)
+
+    assert (usertypes.MessageLevel.info, 'stdout live', True) in live_messages
+    assert (usertypes.MessageLevel.error, 'stderr live', True) in live_messages
+    assert [(msg.level, msg.text) for msg in message_mock.messages[-2:]] == [
+        (usertypes.MessageLevel.info, 'stdout live'),
+        (usertypes.MessageLevel.error, 'stderr live'),
+    ]
