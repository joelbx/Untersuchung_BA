+def test_prioritized_identifier_equality_and_json() -> None:
+    timestamp = datetime(2024, 1, 2, 3, 4, 5)
+    asin = PrioritizedIdentifier(
+        identifier="B06XYHVXVJ",
+        stage_import=False,
+        priority=Priority.HIGH,
+        timestamp=timestamp,
+    )
+    duplicate = PrioritizedIdentifier(
+        identifier="B06XYHVXVJ", timestamp=timestamp + timedelta(seconds=1)
+    )
+    isbn = PrioritizedIdentifier(identifier="9780747532699")
+
+    assert asin == duplicate
+    assert len({asin, duplicate, isbn}) == 2
+    assert asin != isbn
+    assert json.loads(json.dumps(asin.to_dict())) == {
+        "identifier": "B06XYHVXVJ",
+        "stage_import": False,
+        "priority": "HIGH",
+        "timestamp": "2024-01-02T03:04:05",
+    }
+    assert PrioritizedISBN(isbn="9780747532699") == isbn
+    assert asin < duplicate
+
+
+def test_process_amazon_batch_respects_stage_import(monkeypatch) -> None:
+    products = [
+        {"isbn_10": [], "isbn_13": [], "source_records": ["amazon:B06XYHVXVJ"]},
+        {"isbn_10": ["0747532699"], "isbn_13": ["9780747532699"]},
+    ]
+    amazon_api = MagicMock()
+    amazon_api.get_products.return_value = products
+    batch = MagicMock()
+    cache = MagicMock()
+    monkeypatch.setattr(affiliate_server.web, "amazon_api", amazon_api, raising=False)
+    monkeypatch.setattr(affiliate_server.cache, "memcache_cache", cache)
+    monkeypatch.setattr(affiliate_server.config, "infobase", {"db_parameters": True})
+    monkeypatch.setattr(affiliate_server, "get_current_amazon_batch", lambda: batch)
+    monkeypatch.setattr(
+        affiliate_server, "clean_amazon_metadata_for_load", lambda product: product
+    )
+    monkeypatch.setattr(affiliate_server.stats, "increment", MagicMock())
+
+    affiliate_server.process_amazon_batch(
+        ["B06XYHVXVJ", "0747532699"], {"B06XYHVXVJ"}
+    )
+
+    assert cache.set.call_count == 2
+    batch.add_items.assert_called_once_with(
+        [
+            {
+                "ia_id": "amazon:B06XYHVXVJ",
+                "status": "staged",
+                "data": products[0],
+            }
+        ]
+    )
+
