diff --git a/config/portscan.go b/config/portscan.go
new file mode 100644
index 0000000..a272a5e
--- /dev/null
+++ b/config/portscan.go
@@ -0,0 +1,125 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique is a supported nmap TCP scan option.
+type ScanTechnique int
+
+const (
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+func (s ScanTechnique) String() string {
+	switch s {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures scanning from the Vuls host.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+func (c *PortScanConf) GetScanTechniques() []ScanTechnique {
+	result := make([]ScanTechnique, 0, len(c.ScanTechniques))
+	for _, name := range c.ScanTechniques {
+		found := NotSupportTechnique
+		for _, technique := range []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas} {
+			if strings.EqualFold(name, technique.String()) {
+				found = technique
+				break
+			}
+		}
+		result = append(result, found)
+	}
+	return result
+}
+
+// Validate checks the external scanner settings before any scan is attempted.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() {
+		return nil
+	}
+	if c.ScannerBinPath == "" {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath is required"))
+	} else if info, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath: %w", err))
+	} else if info.IsDir() || info.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath must be an executable file: %s", c.ScannerBinPath))
+	}
+	techniques := c.GetScanTechniques()
+	if len(techniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan: multiple scan techniques are not supported"))
+	}
+	for i, technique := range techniques {
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan: unsupported scan technique %q", c.ScanTechniques[i]))
+		}
+		if technique != NotSupportTechnique && technique != TCPConnect && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan: %s requires hasPrivileged", technique.String()))
+		}
+		if technique == TCPConnect && c.SourcePort != "" {
+			errs = append(errs, fmt.Errorf("portscan: sourcePort is incompatible with TCP connect scan"))
+		}
+	}
+	if c.SourcePort != "" && !c.HasPrivileged && len(techniques) == 0 {
+		errs = append(errs, fmt.Errorf("portscan: sourcePort is incompatible with TCP connect scan"))
+	}
+	if c.SourcePort != "" {
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 1 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort must be an integer between 1 and 65535: %q", c.SourcePort))
+		}
+	}
+	if c.HasPrivileged && os.Geteuid() != 0 && c.ScannerBinPath != "" {
+		output, err := exec.Command("getcap", c.ScannerBinPath).Output()
+		if err != nil {
+			errs = append(errs, fmt.Errorf("portscan: unable to check scanner capabilities: %w", err))
+		} else {
+			fields := strings.Fields(string(output))
+			if len(fields) < 2 || fields[0] != c.ScannerBinPath || !strings.Contains(string(output), "cap_net_raw") {
+				errs = append(errs, fmt.Errorf("portscan: missing or malformed cap_net_raw capability on %s", c.ScannerBinPath))
+			}
+		}
+	}
+	return errs
+}
