@@ -0,0 +1,75 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPortScanTechniques(t *testing.T) {
+	names := []string{"sS", "St", "sa", "Sw", "sM", "sn", "SF", "sx", "unknown"}
+	want := []ScanTechnique{TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas, NotSupportTechnique}
+	c := PortScanConf{ScanTechniques: names}
+	got := c.GetScanTechniques()
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			t.Errorf("%s: got %v, want %v", names[i], got[i], want[i])
+		}
+	}
+	if len((&PortScanConf{}).GetScanTechniques()) != 0 {
+		t.Fatal("empty techniques did not return empty slice")
+	}
+	if got := (&PortScanConf{ScanTechniques: []string{"bad"}}).GetScanTechniques(); len(got) != 1 || got[0] != NotSupportTechnique {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestPortScanValidation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(path, []byte("#!/bin/sh\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name      string
+		c         PortScanConf
+		errorPart string
+	}{
+		{"connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}}, ""},
+		{"unsupported", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"bad"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT", "sT"}}, "multiple"},
+		{"privilege", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sS"}}, "requires hasPrivileged"},
+		{"source connect", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "incompatible"},
+		{"source range", PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, SourcePort: "65536"}, "between"},
+		{"source zero", PortScanConf{ScannerBinPath: path, SourcePort: "0"}, "between"},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := tc.c.Validate()
+			if tc.errorPart == "" {
+				if len(errs) != 0 {
+					t.Fatalf("unexpected errors: %v", errs)
+				}
+				return
+			}
+			for _, err := range errs {
+				if strings.Contains(err.Error(), tc.errorPart) {
+					return
+				}
+			}
+			t.Fatalf("expected %q in %v", tc.errorPart, errs)
+		})
+	}
+	if !(PortScanConf{}).IsZero() {
+		t.Fatal("zero configuration")
+	}
+	for _, c := range []PortScanConf{{ScannerBinPath: "x"}, {ScanTechniques: []string{"sT"}}, {SourcePort: "1"}, {HasPrivileged: true}} {
+		if c.IsZero() {
+			t.Fatalf("incorrectly zero: %+v", c)
+		}
+	}
+}
