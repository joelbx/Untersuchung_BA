+++ b/scanner/portscan_test.go
@@ -0,0 +1,44 @@
+package scanner
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/logging"
+)
+
+func TestSetScanTechniques(t *testing.T) {
+	c := &config.PortScanConf{ScanTechniques: []string{"ss"}}
+	got, err := setScanTechniques(c)
+	if err != nil || !reflect.DeepEqual(got, []string{"-sS"}) {
+		t.Fatalf("got %v, %v", got, err)
+	}
+	c.ScanTechniques = []string{"bad"}
+	if _, err := setScanTechniques(c); err == nil {
+		t.Fatal("expected unsupported technique error")
+	}
+}
+
+func TestExecExternalPortScan(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "fake-nmap")
+	script := `#!/bin/sh
+printf '%s\n' "$@" > "` + filepath.Join(t.TempDir(), "args") + `"
+cat <<'XML'
+<?xml version="1.0"?><nmaprun><host><address addr="192.0.2.1" addrtype="ipv4"/><ports><port protocol="tcp" portid="80"><state state="open"/></port><port protocol="tcp" portid="443"><state state="closed"/></port></ports></host></nmaprun>
+XML
+`
+	if err := os.WriteFile(path, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{ScannerBinPath: path, ScanTechniques: []string{"sT"}, IsUseExternalScanner: true}}, log: logging.NewNormalLogger()}
+	got, err := l.execPortsScan(map[string][]string{"192.0.2.1": {"80", "443"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.1:80"}) {
+		t.Fatalf("got %v", got)
+	}
+}
