diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..edd2677
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,118 @@
+package scanner
+
+import (
+	"bytes"
+	"context"
+	"encoding/xml"
+	"fmt"
+	"net"
+	osexec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func setScanTechniques(c *config.PortScanConf) ([]string, error) {
+	options := []string{}
+	for i, technique := range c.GetScanTechniques() {
+		if technique == config.NotSupportTechnique {
+			return nil, fmt.Errorf("unsupported scan technique %q", c.ScanTechniques[i])
+		}
+		options = append(options, "-"+technique.String())
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string { return strings.Join(options, " ") }
+
+type nmapResult struct {
+	Hosts []struct {
+		Addresses []struct {
+			Addr string `xml:"addr,attr"`
+			Type string `xml:"addrtype,attr"`
+		} `xml:"address"`
+		Ports []struct {
+			Number   int    `xml:"portid,attr"`
+			Protocol string `xml:"protocol,attr"`
+			State    struct {
+				State string `xml:"state,attr"`
+			} `xml:"state"`
+		} `xml:"ports>port"`
+	} `xml:"host"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	c := l.ServerInfo.PortScan
+	if errs := c.Validate(); len(errs) != 0 {
+		return nil, fmt.Errorf("invalid portscan configuration: %v", errs)
+	}
+	techniqueOptions, err := setScanTechniques(c)
+	if err != nil {
+		return nil, err
+	}
+	ips := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		ips = append(ips, ip)
+	}
+	sort.Strings(ips)
+	open := []string{}
+	for _, ip := range ips {
+		if !isLocalExec(l.ServerInfo.Port, l.ServerInfo.Host) && net.ParseIP(ip).IsLoopback() {
+			continue
+		}
+		ports := scanDestIPPorts[ip]
+		if len(ports) == 0 {
+			continue
+		}
+		for _, port := range ports {
+			if _, err := strconv.Atoi(port); err != nil {
+				return nil, fmt.Errorf("invalid destination port %q: %w", port, err)
+			}
+		}
+		options := append([]string{}, techniqueOptions...)
+		if parsed := net.ParseIP(ip); parsed != nil && parsed.To4() == nil {
+			options = append(options, "-6")
+		}
+		options = append(options, "-n", "-Pn", "-oX", "-", "-p", strings.Join(ports, ","))
+		if c.SourcePort != "" {
+			options = append(options, "-g", c.SourcePort)
+		}
+		options = append(options, ip)
+		l.log.Debugf("nmap options: %s", formatNmapOptionsToString(options))
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+		cmd := osexec.CommandContext(ctx, c.ScannerBinPath, options...)
+		output, err := cmd.Output()
+		cancel()
+		if err != nil {
+			if exit, ok := err.(*osexec.ExitError); ok {
+				return nil, fmt.Errorf("nmap scan of %s failed: %s: %w", ip, strings.TrimSpace(string(exit.Stderr)), err)
+			}
+			return nil, fmt.Errorf("nmap scan of %s failed: %w", ip, err)
+		}
+		var result nmapResult
+		if err := xml.NewDecoder(bytes.NewReader(output)).Decode(&result); err != nil {
+			return nil, fmt.Errorf("parse nmap output for %s: %w", ip, err)
+		}
+		for _, host := range result.Hosts {
+			address := ""
+			for _, a := range host.Addresses {
+				if a.Type == "ipv4" || a.Type == "ipv6" {
+					address = a.Addr
+					break
+				}
+			}
+			if address != ip {
+				continue
+			}
+			for _, p := range host.Ports {
+				if p.Protocol == "tcp" && p.State.State == "open" {
+					open = append(open, net.JoinHostPort(ip, strconv.Itoa(p.Number)))
+				}
+			}
+		}
+	}
+	return open, nil
+}
diff --git a/scanner/portscan_test.go b/scanner/portscan_test.go
new file mode 100644
