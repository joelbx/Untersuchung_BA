+def test_extract_tar_dir_rejects_external_symlink(tmp_path):
+    artifact = to_bytes(str(tmp_path / 'links.tar'))
+    destination = to_bytes(str(tmp_path / 'collection'))
+    os.mkdir(destination)
+    with tarfile.open(artifact, 'w') as tar:
+        member = tarfile.TarInfo('linked')
+        member.type = tarfile.SYMTYPE
+        member.linkname = '../outside'
+        tar.addfile(member)
+
+    with tarfile.open(artifact) as tar:
+        with pytest.raises(AnsibleError, match='link target is outside'):
+            collection._extract_tar_dir(tar, 'linked', destination)
+    assert not os.path.lexists(os.path.join(destination, b'linked'))
+
+
+def test_is_child_path_checks_path_components(tmp_path):
+    root = to_bytes(str(tmp_path / 'collection'))
+    os.mkdir(root)
