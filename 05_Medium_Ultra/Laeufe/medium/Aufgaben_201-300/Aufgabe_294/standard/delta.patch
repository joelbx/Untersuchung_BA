+def _is_child_path(path, root, link_target=None):
+    """Check containment, resolving links from the directory containing a link."""
+    if link_target is not None:
+        path = os.path.join(os.path.dirname(path), link_target)
+    path = os.path.realpath(path)
+    root = os.path.realpath(root)
+    return path == root or path.startswith(root + to_bytes(os.path.sep) if isinstance(root, bytes) else root + os.path.sep)
 
 
