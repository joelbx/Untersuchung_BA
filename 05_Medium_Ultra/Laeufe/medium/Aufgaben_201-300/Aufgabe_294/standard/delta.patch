+def _tar_destination(b_dest, filename):
+    b_dest = os.path.abspath(b_dest)
+    b_path = os.path.abspath(os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict')))
+    if not _is_child_path(b_path, b_dest) or b_path == b_dest:
+        raise AnsibleError("Cannot extract tar entry '%s' as it will be placed outside the collection directory"
+                           % to_native(filename, errors='surrogate_or_strict'))
+    return b_path
+
+
+def _extract_tar_dir(tar, dirname, b_dest):
+    b_dest_path = _tar_destination(b_dest, dirname)
+    try:
+        member = tar.getmember(to_native(dirname, errors='surrogate_or_strict'))
+    except KeyError:
+        member = None  # Some artifacts omit directory members.
+    if member is not None and member.issym():
+        b_link_target = to_bytes(member.linkname, errors='surrogate_or_strict')
+        if not _is_child_path(b_dest_path, b_dest, b_link_target):
+            raise AnsibleError("Cannot extract tar entry '%s' as its link target is outside the collection directory"
+                               % to_native(dirname, errors='surrogate_or_strict'))
+        b_parent = os.path.dirname(b_dest_path)
+        if not os.path.exists(b_parent):
+            os.makedirs(b_parent, mode=0o0755)
+        os.symlink(b_link_target, b_dest_path)
+    elif member is None or member.isdir():
+        if not os.path.exists(b_dest_path):
+            os.makedirs(b_dest_path, mode=0o0755)
+    else:
+        raise AnsibleError("Cannot extract tar entry '%s' as a directory" % to_native(dirname))
+
+
