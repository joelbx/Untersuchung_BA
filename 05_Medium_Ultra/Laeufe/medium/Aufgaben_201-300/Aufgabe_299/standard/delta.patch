+def test_open_filesystem_category(config_stub, quickmarks, bookmarks, info,
+                                  tmp_path, qtmodeltester):
+    """Filesystem follows configured order and stays visible when empty."""
+    config_stub.val.completion.open_categories = [
+        'filesystem', 'quickmarks', 'bookmarks']
+    config_stub.val.completion.favorite_paths = [str(tmp_path)]
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    qtmodeltester.check(model)
+    assert [model.data(model.index(row, 0))
+            for row in range(model.rowCount())] == [
+                'Filesystem', 'Quickmarks', 'Bookmarks']
+    assert model.data(model.index(0, 0, model.index(0, 0))) == str(tmp_path)
+    assert model.data(model.index(0, 1, model.index(0, 0))) is None
+    assert model.data(model.index(0, 2, model.index(0, 0))) is None
+
+    model.set_pattern(str(tmp_path / 'missing'))
+    assert model.data(model.index(0, 0)) == 'Filesystem'
+    assert model.rowCount(model.index(0, 0)) == 0
+
+    config_stub.val.completion.open_categories = ['quickmarks', 'bookmarks']
+    model = urlmodel.url(info=info)
+    model.set_pattern('')
+    assert [model.data(model.index(row, 0))
+            for row in range(model.rowCount())] == ['Quickmarks', 'Bookmarks']
+
+
