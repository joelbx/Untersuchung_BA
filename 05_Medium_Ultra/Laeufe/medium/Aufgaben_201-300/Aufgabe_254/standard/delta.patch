 package utils
 
 import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
 	"testing"
+	"time"
 
+	"github.com/aws/aws-sdk-go-v2/feature/ec2/imds"
 	"github.com/google/uuid"
 	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
 )
 
+type imdsHTTPClientFunc func(*http.Request) (*http.Response, error)
+
+func (f imdsHTTPClientFunc) Do(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestInstanceMetadataIsAvailable(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		response  string
+		available bool
+	}{
+		{"old instance ID", "i-1a2b3c4d", true},
+		{"new instance ID", "i-1234567890abcdef0", true},
+		{"portal page", "<!DOCTYPE html><html>Login</html>", false},
+		{"short ID", "i-1234567", false},
+		{"long ID", "i-1234567890abcdef01", false},
+		{"uppercase ID", "i-1234567A", false},
+		{"trailing newline", "i-1a2b3c4d\n", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			metadataClient := imds.New(imds.Options{
+				Endpoint: "http://127.0.0.1",
+				HTTPClient: imdsHTTPClientFunc(func(req *http.Request) (*http.Response, error) {
+					if req.Method == http.MethodPut {
+						return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader("token")), Header: http.Header{}}, nil
+					}
+					require.Equal(t, "/latest/meta-data/instance-id", req.URL.Path)
+					return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(tc.response)), Header: http.Header{}}, nil
+				}),
+			})
+			client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(metadataClient))
+			require.NoError(t, err)
+			assert.Equal(t, tc.available, client.IsAvailable(context.Background()))
+		})
+	}
+}
+
+func TestInstanceMetadataClientOptionError(t *testing.T) {
+	want := errors.New("invalid option")
+	_, err := NewInstanceMetadataClient(context.Background(), func(*InstanceMetadataClient) error { return want })
+	require.ErrorIs(t, err, want)
+}
+
+func TestInstanceMetadataIsAvailableTimeout(t *testing.T) {
+	metadataClient := imds.New(imds.Options{
+		Endpoint: "http://127.0.0.1",
+		HTTPClient: imdsHTTPClientFunc(func(req *http.Request) (*http.Response, error) {
+			<-req.Context().Done()
+			return nil, req.Context().Err()
+		}),
+	})
+	client, err := NewInstanceMetadataClient(context.Background(), WithIMDSClient(metadataClient))
+	require.NoError(t, err)
+	start := time.Now()
+	assert.False(t, client.IsAvailable(context.Background()))
+	assert.Less(t, time.Since(start), time.Second)
+}
