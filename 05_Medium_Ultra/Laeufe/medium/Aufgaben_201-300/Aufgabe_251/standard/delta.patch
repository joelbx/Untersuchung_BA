+}
 
+// yaml.Extract reports syntax errors as "file:line: message" without a CUE position.
+func parserErrorLocation(file, message string) Location {
+	location := Location{File: file}
+	lineText := strings.TrimPrefix(message, file+":")
+	if lineText == message {
+		return location
+	}
+	lineText, _, ok := strings.Cut(lineText, ":")
+	if !ok {
+		return location
+	}
+	line, err := strconv.Atoi(lineText)
+	if err == nil {
+		location.Line = line
+		location.Column = 1
+	}
+	return location
+}
