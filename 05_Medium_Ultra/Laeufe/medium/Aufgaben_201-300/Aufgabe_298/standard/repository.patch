-	data *ttlcache.Cache[K, V]
+	data             *ttlcache.Cache[K, V]
+	evictionDeadline atomic.Pointer[time.Time]
+}
+
+// evictExpired scans only when the earliest known expiration is due. The
+// temporary deadline lets one caller perform the scan while other callers
+// continue using the cache. Insertions can schedule an earlier scan.
+func (c *simpleCache[K, V]) evictExpired() {
+	deadline := c.evictionDeadline.Load()
+	if deadline != nil && time.Now().Before(*deadline) {
+		return
+	}
+
+	// Even an empty cache needs another eventual scan if a concurrent Set
+	// happens before its expiration is published below.
+	scanDeadline := time.Now().Add(24 * time.Hour)
+	if !c.evictionDeadline.CompareAndSwap(deadline, &scanDeadline) {
+		return
+	}
+	c.data.DeleteExpired()
+	next := scanDeadline
+	for _, item := range c.data.Items() {
+		expiresAt := item.ExpiresAt()
+		if !expiresAt.IsZero() && expiresAt.Before(next) {
+			next = expiresAt
+		}
+	}
+	// A concurrent insertion may already have scheduled an earlier scan.
+	c.evictionDeadline.CompareAndSwap(&scanDeadline, &next)
+}
+
+func (c *simpleCache[K, V]) scheduleEviction(item *ttlcache.Item[K, V]) {
+	expiresAt := item.ExpiresAt()
+	if expiresAt.IsZero() {
+		return
+	}
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && !expiresAt.Before(*deadline) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(deadline, &expiresAt) {
+			return
+		}
+	}
 }
 
