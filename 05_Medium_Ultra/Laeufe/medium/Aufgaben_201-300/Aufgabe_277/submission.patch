+
+func TestRuleSegments(t *testing.T) {
+	tests := []struct {
+		name    string
+		keys    []string
+		wantKey string
+		wantOp  string
+	}{
+		{"legacy", nil, "legacy", ""},
+		{"single", []string{"first"}, "first", ""},
+		{"multiple", []string{"first", "second"}, "first,second", "AND_SEGMENT_OPERATOR"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{
+				SegmentKey:      "legacy",
+				SegmentKeys:     tt.keys,
+				SegmentOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+			})
+			assert.Equal(t, tt.wantKey, rule.SegmentKey)
+			assert.Equal(t, tt.wantOp, rule.SegmentOperator)
+			data, err := json.Marshal(rule)
+			assert.NoError(t, err)
+			assert.Equal(t, tt.wantOp != "", jsonHasField(t, data, "segment_operator"))
+		})
+	}
+}
+
+func TestRolloutSegments(t *testing.T) {
+	tests := []struct {
+		name    string
+		keys    []string
+		wantKey string
+		wantOp  string
+	}{
+		{"legacy", nil, "legacy", ""},
+		{"single", []string{"first"}, "first", ""},
+		{"multiple", []string{"first", "second"}, "first,second", "OR_SEGMENT_OPERATOR"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{
+				Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+					SegmentKey:      "legacy",
+					SegmentKeys:     tt.keys,
+					SegmentOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR,
+					Value:           true,
+				}},
+			})
+			assert.Equal(t, tt.wantKey, rollout.Segment.Key)
+			assert.Equal(t, tt.wantOp, rollout.Segment.Operator)
+			assert.True(t, rollout.Segment.Value)
+			data, err := json.Marshal(rollout.Segment)
+			assert.NoError(t, err)
+			assert.Equal(t, tt.wantOp != "", jsonHasField(t, data, "operator"))
+		})
+	}
+}
+
+func jsonHasField(t *testing.T, data []byte, field string) bool {
+	t.Helper()
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		t.Fatal(err)
+	}
+	_, ok := fields[field]
+	return ok
+}
