--- a/internal/server/audit/types_test.go
+++ b/internal/server/audit/types_test.go
@@ -1,6 +1,7 @@
 package audit
 
 import (
+	"encoding/json"
 	"testing"
 
 	"github.com/stretchr/testify/assert"
@@ -171,3 +172,71 @@ func TestRule(t *testing.T) {
 		testDistributionHelper(t, d)
