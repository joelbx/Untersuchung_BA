diff --git a/lib/events/dynamoevents/fieldsmap.go b/lib/events/dynamoevents/fieldsmap.go
new file mode 100644
index 0000000..f0d554e
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap.go
@@ -0,0 +1,204 @@
+package dynamoevents
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"reflect"
+
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/teleport/lib/events"
+	"github.com/gravitational/trace"
+)
+
+// fieldsMapFromJSON converts JSON without passing through float64, which would
+// lose precision for large event indexes and other integer metadata.
+func fieldsMapFromJSON(data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.UseNumber()
+	var value map[string]interface{}
+	if err := dec.Decode(&value); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if value == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	if err := dec.Decode(new(interface{})); err != io.EOF {
+		return nil, trace.BadParameter("trailing data in event fields")
+	}
+	fields := make(map[string]*dynamodb.AttributeValue, len(value))
+	for key, v := range value {
+		av, err := fieldAttribute(v)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		fields[key] = av
+	}
+	return fields, nil
+}
+
+func fieldAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch v := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: boolPtr(true)}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: &v}, nil
+	case json.Number:
+		s := string(v)
+		return &dynamodb.AttributeValue{N: &s}, nil
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: &v}, nil
+	case []interface{}:
+		out := make([]*dynamodb.AttributeValue, 0, len(v))
+		for _, item := range v {
+			av, err := fieldAttribute(item)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out = append(out, av)
+		}
+		return &dynamodb.AttributeValue{L: out}, nil
+	case map[string]interface{}:
+		out := make(map[string]*dynamodb.AttributeValue, len(v))
+		for key, item := range v {
+			av, err := fieldAttribute(item)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out[key] = av
+		}
+		return &dynamodb.AttributeValue{M: out}, nil
+	default:
+		return nil, trace.BadParameter("unsupported event field type %T", value)
+	}
+}
+
+func boolPtr(v bool) *bool { return &v }
+
+func fieldValue(av *dynamodb.AttributeValue) (interface{}, error) {
+	if av == nil {
+		return nil, trace.BadParameter("missing field attribute")
+	}
+	switch {
+	case av.NULL != nil && *av.NULL:
+		return nil, nil
+	case av.S != nil:
+		return *av.S, nil
+	case av.N != nil:
+		return json.Number(*av.N), nil
+	case av.BOOL != nil:
+		return *av.BOOL, nil
+	case av.M != nil:
+		out := make(map[string]interface{}, len(av.M))
+		for key, child := range av.M {
+			v, err := fieldValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out[key] = v
+		}
+		return out, nil
+	case av.L != nil:
+		out := make([]interface{}, 0, len(av.L))
+		for _, child := range av.L {
+			v, err := fieldValue(child)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			out = append(out, v)
+		}
+		return out, nil
+	default:
+		return nil, trace.BadParameter("unsupported DynamoDB event field attribute")
+	}
+}
+
+func fieldsMapJSON(fields map[string]*dynamodb.AttributeValue) ([]byte, error) {
+	out := make(map[string]interface{}, len(fields))
+	for key, av := range fields {
+		v, err := fieldValue(av)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		out[key] = v
+	}
+	data, err := json.Marshal(out)
+	return data, trace.Wrap(err)
+}
+
+func marshalEventWithFields(e event, data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	fields, err := fieldsMapFromJSON(data)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	item["FieldsMap"] = &dynamodb.AttributeValue{M: fields}
+	delete(item, "Fields")
+	return item, nil
+}
+
+func eventData(e *event) ([]byte, error) {
+	if e.FieldsMap != nil {
+		return fieldsMapJSON(e.FieldsMap)
+	}
+	if e.Fields == "" {
+		return nil, trace.BadParameter("event has neither FieldsMap nor Fields")
+	}
+	return []byte(e.Fields), nil
+}
+
+func fieldsFromEvent(e *event) (events.EventFields, error) {
+	data, err := eventData(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	var fields events.EventFields
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return fields, nil
+}
+
+func eventFields(item map[string]*dynamodb.AttributeValue) (events.EventFields, error) {
+	var e event
+	if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if m := item["FieldsMap"]; m != nil {
+		if m.M == nil {
+			return nil, trace.BadParameter("FieldsMap is not a map")
+		}
+		e.FieldsMap = m.M
+	}
+	return fieldsFromEvent(&e)
+}
+
+func validateFieldConversion(original []byte, fields map[string]*dynamodb.AttributeValue) error {
+	converted, err := fieldsMapJSON(fields)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	decode := func(data []byte) (interface{}, error) {
+		dec := json.NewDecoder(bytes.NewReader(data))
+		dec.UseNumber()
+		var value interface{}
+		err := dec.Decode(&value)
+		return value, err
+	}
+	before, err := decode(original)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	after, err := decode(converted)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		return trace.BadParameter("event field content changed during conversion")
+	}
+	return nil
+}
diff --git a/lib/events/dynamoevents/fieldsmap_migration.go b/lib/events/dynamoevents/fieldsmap_migration.go
new file mode 100644
index 0000000..bf2efa3
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap_migration.go
@@ -0,0 +1,124 @@
+package dynamoevents
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/gravitational/trace"
+)
+
+// migrateFieldsMapWithRetry runs after the older index migration has finished.
+// A new scan on retry is safe: converted rows are excluded by the scan filter.
+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		err := backend.RunWhileLocked(ctx, l.backend, fieldsMapMigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+			// The older date migration also rewrites complete items. Share its
+			// lock so concurrent nodes cannot overwrite each other's changes.
+			return backend.RunWhileLocked(ctx, l.backend, rfd24MigrationLock, rfd24MigrationLockTTL, l.migrateFieldsMap)
+		})
+		if err == nil {
+			return
+		}
+		l.WithError(err).Error("FieldsMap migration failed; retrying")
+		select {
+		case <-time.After(utils.HalfJitter(time.Minute)):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// migrateFieldsMap converts legacy JSON strings in bounded batches. It starts
+// at the beginning after interruption; already converted rows are skipped.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	var startKey map[string]*dynamodb.AttributeValue
+	var converted int
+	for {
+		if err := ctx.Err(); err != nil {
+			return trace.Wrap(err)
+		}
+		out, err := l.svc.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ConsistentRead:    aws.Bool(true),
+			ExclusiveStartKey: startKey,
+			FilterExpression:  aws.String("attribute_exists(Fields) AND attribute_not_exists(FieldsMap)"),
+			Limit:             aws.Int64(DynamoBatchSize * 4),
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		requests := make([]*dynamodb.WriteRequest, 0, len(out.Items))
+		for _, item := range out.Items {
+			if err := convertLegacyItem(item); err != nil {
+				return trace.WrapWithMessage(err, "converting event %v/%v", item[keySessionID], item[keyEventIndex])
+			}
+			requests = append(requests, &dynamodb.WriteRequest{PutRequest: &dynamodb.PutRequest{Item: item}})
+		}
+		for len(requests) > 0 {
+			n := DynamoBatchSize
+			if n > len(requests) {
+				n = len(requests)
+			}
+			if err := l.uploadFieldsMapBatch(ctx, requests[:n]); err != nil {
+				return trace.Wrap(err)
+			}
+			requests = requests[n:]
+			converted += n
+			l.Infof("Converted %d DynamoDB events to FieldsMap", converted)
+			if _, err := l.backend.Put(ctx, backend.Item{Key: backend.FlagKey("dynamoEvents", "fieldsMapMigration", l.Tablename), Value: []byte(strconv.Itoa(converted))}); err != nil {
+				return trace.Wrap(err)
+			}
+		}
+		startKey = out.LastEvaluatedKey
+		if startKey == nil {
+			break
+		}
+	}
+	_, err := l.backend.Put(ctx, backend.Item{Key: backend.FlagKey("dynamoEvents", "fieldsMapMigration", l.Tablename), Value: []byte("complete")})
+	if err == nil {
+		l.Infof("FieldsMap migration complete; converted %d events", converted)
+	}
+	return trace.Wrap(err)
+}
+
+func convertLegacyItem(item map[string]*dynamodb.AttributeValue) error {
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return trace.BadParameter("legacy event has invalid Fields attribute")
+	}
+	fields, err := fieldsMapFromJSON([]byte(*legacy.S))
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if err := validateFieldConversion([]byte(*legacy.S), fields); err != nil {
+		return trace.Wrap(err)
+	}
+	item["FieldsMap"] = &dynamodb.AttributeValue{M: fields}
+	delete(item, "Fields")
+	return nil
+}
+
+func (l *Log) uploadFieldsMapBatch(ctx context.Context, requests []*dynamodb.WriteRequest) error {
+	for len(requests) > 0 {
+		out, err := l.svc.BatchWriteItemWithContext(ctx, &dynamodb.BatchWriteItemInput{
+			RequestItems: map[string][]*dynamodb.WriteRequest{l.Tablename: requests},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		requests = out.UnprocessedItems[l.Tablename]
+		if len(requests) > 0 {
+			select {
+			case <-time.After(utils.HalfJitter(time.Second)):
+			case <-ctx.Done():
+				return trace.Wrap(ctx.Err())
+			}
+		}
+	}
+	return nil
+}
diff --git a/lib/events/dynamoevents/fieldsmap_test.go b/lib/events/dynamoevents/fieldsmap_test.go
new file mode 100644
index 0000000..ab3ed90
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap_test.go
@@ -0,0 +1,60 @@
+package dynamoevents
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/teleport/lib/events"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFieldsMapConversion(t *testing.T) {
+	data := []byte(`{"empty":"","null":null,"number":9007199254740993,"nested":{"enabled":true,"values":["",1.25,null]},"array":[]}`)
+	fields, err := fieldsMapFromJSON(data)
+	require.NoError(t, err)
+	require.Equal(t, "", *fields["empty"].S)
+	require.Equal(t, "9007199254740993", *fields["number"].N)
+	require.Equal(t, "", *fields["nested"].M["values"].L[0].S)
+	require.NoError(t, validateFieldConversion(data, fields))
+
+	item, err := marshalEventWithFields(event{SessionID: "session", EventIndex: 1}, data)
+	require.NoError(t, err)
+	require.Nil(t, item["Fields"])
+	require.NotNil(t, item["FieldsMap"].M)
+	got, err := eventFields(item)
+	require.NoError(t, err)
+	require.Equal(t, "", got["empty"])
+	require.Equal(t, float64(9007199254740992), got["number"])
+
+	legacy, err := dynamodbattribute.MarshalMap(event{SessionID: "session", EventIndex: 1, Fields: string(data)})
+	require.NoError(t, err)
+	legacyFields, err := eventFields(legacy)
+	require.NoError(t, err)
+	require.Equal(t, got, legacyFields)
+	require.NoError(t, convertLegacyItem(legacy))
+	require.Nil(t, legacy["Fields"])
+	require.Equal(t, item["FieldsMap"], legacy["FieldsMap"])
+}
+
+func TestFieldsMapRejectsInvalidLegacyData(t *testing.T) {
+	_, err := fieldsMapFromJSON([]byte(`{"a":1} trailing`))
+	require.Error(t, err)
+	_, err = fieldsMapFromJSON([]byte(`null`))
+	require.Error(t, err)
+	_, err = eventFields(map[string]*dynamodb.AttributeValue{"FieldsMap": {S: strPtr("wrong")}})
+	require.Error(t, err)
+	badItem := map[string]*dynamodb.AttributeValue{"Fields": {S: strPtr("not json")}}
+	require.Error(t, convertLegacyItem(badItem))
+	require.Nil(t, badItem["FieldsMap"])
+
+	fields := events.EventFields{"a": "value"}
+	encoded, err := json.Marshal(fields)
+	require.NoError(t, err)
+	mapped, err := fieldsMapFromJSON(encoded)
+	require.NoError(t, err)
+	require.NoError(t, validateFieldConversion(encoded, mapped))
+}
+
+func strPtr(s string) *string { return &s }
