+@pytest.mark.parametrize(
+    'fields,error',
+    [
+        ({'publish_date': '1499'}, PublicationYearTooOld),
+        ({'publish_date': '3000'}, PublishedInFutureYear),
+        ({'publishers': ['Independently Published']}, add_book.IndependentlyPublished),
+        ({'source_records': ['amazon:123']}, add_book.SourceNeedsISBN),
+    ],
+)
+def test_validate_record_override(fields, error):
+    rec = {'title': 'Example', 'source_records': ['ia:example'], **fields}
+    with pytest.raises(error):
+        add_book.validate_record(rec)
+    with pytest.raises(error):
+        add_book.validate_record(rec, override_validation=False)
+    add_book.validate_record(rec, override_validation=True)
+
+
+def test_validate_record_override_still_requires_fields():
+    with pytest.raises(RequiredField):
+        add_book.validate_record({'source_records': ['ia:example']}, True)
