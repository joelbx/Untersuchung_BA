 import pytest
 
-from ansible.executor.module_common import modify_module
+from ansible.executor.module_common import modify_module, b_ENCODING_STRING
 from ansible.module_utils.six import PY2
 
 from test_module_common import templar
@@ -41,3 +41,36 @@ def test_shebang_task_vars(fake_old_module_open, templar):
 
     (data, style, shebang) = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
     assert shebang == '#!/usr/bin/python3'
+
+
+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/usr/bin/python3.8 -I\nprint(1)\n', {}, b'#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -B\nprint(1)\n', {}, b'#!/opt/venv/bin/python -B'),
+    (b'#!/usr/bin/ruby -w\nputs 1\n', {}, b'#!/usr/bin/ruby -w'),
+    (b'#!/usr/bin/ruby -w\nputs 1\n', {'ansible_ruby_interpreter': '/opt/ruby/bin/ruby'}, b'#!/opt/ruby/bin/ruby -w'),
+    (b'#!/usr/bin/env "ruby" -w\nputs 1\n', {}, b'#!/usr/bin/env "ruby" -w'),
+    (b'#!/usr/bin/python3.8 -I\nprint(1)\n', {'ansible_python_interpreter': '/opt/venv/bin/python'}, b'#!/opt/venv/bin/python -I'),
+    (b'print(1)\n', {}, b'#!/usr/bin/python'),
+])
+def test_module_shebang(source, task_vars, expected, mocker, templar):
+    m = mocker.mock_open(read_data=source)
+    mocker.patch('__builtin__.open' if PY2 else 'builtins.open', m)
+    data, style, shebang = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
+    assert data.startswith(expected + b'\n' + b_ENCODING_STRING + b'\n')
+    assert shebang == expected.decode('utf-8')
+
+
+@pytest.mark.parametrize('source, task_vars, expected', [
+    (b'#!/usr/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n', {}, b'#!/usr/bin/python3.8 -I'),
+    (b'#!/opt/venv/bin/python -B\nfrom ansible.module_utils.basic import AnsibleModule\n', {}, b'#!/opt/venv/bin/python -B'),
+    (b'#!/usr/bin/python3.8 -I\nfrom ansible.module_utils.basic import AnsibleModule\n',
+     {'ansible_python_interpreter': '/opt/venv/bin/python'}, b'#!/opt/venv/bin/python -I'),
+    (b'from ansible.module_utils.basic import AnsibleModule\n', {}, b'#!/usr/bin/python'),
+])
+def test_new_style_module_shebang(source, task_vars, expected, tmp_path, templar):
+    module_path = tmp_path / 'test_module.py'
+    module_path.write_bytes(source)
+    data, style, shebang = modify_module('test_module', str(module_path), {}, templar, task_vars=task_vars)
+    assert style == 'new'
+    assert data.startswith(expected + b'\n' + b_ENCODING_STRING + b'\n')
+    assert shebang == expected.decode('utf-8')
