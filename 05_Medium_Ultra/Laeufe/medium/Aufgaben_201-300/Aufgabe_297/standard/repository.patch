+import config from './config'
+
+jest.mock('jwt-decode', () => jest.fn())
+jest.mock('./config', () => ({
+  auth: {
+    id: 'user-id',
+    name: 'Alice',
+    username: 'alice',
+    isAdmin: true,
+    token: 'proxy-token',
+    subsonicSalt: 'salt',
+    subsonicToken: 'subsonic-token',
+  },
+  firstTime: true,
+}))
+jest.mock('./eventStream', () => ({
+  startEventStream: jest.fn(),
+  stopEventStream: jest.fn(),
+}))
+
+test('stores all fields from reverse proxy authentication', () => {
+  localStorage.clear()
+  require('./authProvider')
+
+  expect(localStorage.getItem('token')).toBe('proxy-token')
+  expect(localStorage.getItem('userId')).toBe('user-id')
+  expect(localStorage.getItem('name')).toBe('Alice')
+  expect(localStorage.getItem('username')).toBe('alice')
+  expect(localStorage.getItem('role')).toBe('admin')
+  expect(localStorage.getItem('subsonic-salt')).toBe('salt')
+  expect(localStorage.getItem('subsonic-token')).toBe('subsonic-token')
+  expect(config.firstTime).toBe(false)
+})
