+package app
+
+import (
+	"crypto/md5"
+	"crypto/rand"
+	"encoding/hex"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// validateIPAgainstList only considers the connection's peer address. Forwarded
+// address headers are controlled by the client and must never grant access.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+	if remoteAddr == "@" {
+		for _, entry := range strings.Split(whitelist, ",") {
+			if strings.TrimSpace(entry) == "@" {
+				return true
+			}
+		}
+		return false
+	}
+	if host, _, err := net.SplitHostPort(remoteAddr); err == nil {
+		remoteAddr = host
+	}
+	ip := net.ParseIP(strings.Trim(remoteAddr, "[]"))
+	if ip == nil {
+		return false
+	}
+	for _, entry := range strings.Split(whitelist, ",") {
+		entry = strings.TrimSpace(entry)
+		_, network, err := net.ParseCIDR(entry)
+		if err == nil && network.Contains(ip) {
+			return true
+		}
+		// A single address is equivalent to a /32 or /128 range.
+		if allowed := net.ParseIP(entry); allowed != nil && allowed.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		username = strings.TrimSpace(conf.Server.ReverseProxyDefaultUser)
+	}
+	if username == "" {
+		return nil
+	}
+	repo := ds.User(r.Context())
+	user, err := repo.FindByUsername(username)
+	if err == model.ErrNotFound {
+		count, countErr := repo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Counting users for reverse proxy login", countErr)
+			return nil
+		}
+		password := uuid.NewString()
+		user = &model.User{ID: uuid.NewString(), UserName: username,
+			Name: strings.Title(username), NewPassword: password, Password: password,
+			IsAdmin: count == 0}
+		if err = repo.Put(user); err != nil {
+			log.Error(r, "Creating reverse proxy user", err)
+			return nil
+		}
+	} else if err != nil || user == nil {
+		if err != nil {
+			log.Error(r, "Looking up reverse proxy user", err)
+		}
+		return nil
+	}
+	if err = repo.UpdateLastLoginAt(user.ID); err != nil {
+		log.Error(r, "Updating reverse proxy user's last login", err)
+		return nil
+	}
+	now := time.Now()
+	user.LastLoginAt = &now
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Creating reverse proxy token", err)
+		return nil
+	}
+	saltBytes := make([]byte, 8)
+	if _, err = rand.Read(saltBytes); err != nil {
+		log.Error(r, "Creating Subsonic salt", err)
+		return nil
+	}
+	salt := hex.EncodeToString(saltBytes)
+	subsonicToken := md5.Sum([]byte(user.Password + salt))
+	return map[string]interface{}{
+		"id": user.ID, "isAdmin": user.IsAdmin, "name": user.Name,
+		"username": user.UserName, "token": token,
+		"subsonicSalt": salt, "subsonicToken": hex.EncodeToString(subsonicToken[:]),
+	}
+}
