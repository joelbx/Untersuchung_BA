@@ -0,0 +1,113 @@
+package app
+
+import (
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestValidateIPAgainstList(t *testing.T) {
+	for _, tc := range []struct {
+		remote, list string
+		want         bool
+	}{
+		{"10.1.2.3:4321", "broken, 10.0.0.0/8", true},
+		{"[2001:db8::2]:4321", "broken, 10.0.0.0/8, 2001:db8::/32", true},
+		{"10.1.2.3:4321", "10.2.0.0/16", false},
+		{"10.1.2.3:4321", "", false},
+		{"@", "@", true},
+		{"@", "0.0.0.0/0, ::/0", false},
+	} {
+		if got := validateIPAgainstList(tc.remote, tc.list); got != tc.want {
+			t.Errorf("validateIPAgainstList(%q, %q) = %v, want %v", tc.remote, tc.list, got, tc.want)
+		}
+	}
+}
+
+func TestReverseProxyConfig(t *testing.T) {
+	previous := *conf.Server
+	t.Cleanup(func() { *conf.Server = previous })
+	conf.Server.ReverseProxyWhitelist = "10.0.0.0/8"
+	conf.Server.ReverseProxyUserHeader = "X-Authenticated-User"
+	conf.Server.ReverseProxyDefaultUser = ""
+	ds := &tests.MockDataStore{}
+	repo := ds.User(nil)
+	if err := repo.Put(&model.User{ID: "existing", UserName: "alice", Name: "Alice", NewPassword: "secret"}); err != nil {
+		t.Fatal(err)
+	}
+
+	configFor := func(addr, username string) map[string]interface{} {
+		r := httptest.NewRequest("GET", "/index.html", nil)
+		r.RemoteAddr = addr
+		r.Header.Set("X-Authenticated-User", username)
+		w := httptest.NewRecorder()
+		serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+		if w.Header().Get("Cache-Control") != "no-store" {
+			t.Fatal("UI response must not be cached")
+		}
+		return extractAppConfig(w.Body.String())
+	}
+	if _, ok := configFor("192.0.2.1:1234", "alice")["auth"]; ok {
+		t.Fatal("untrusted peer received auth")
+	}
+	if _, ok := configFor("10.1.1.1:1234", "")["auth"]; ok {
+		t.Fatal("missing username received auth")
+	}
+	config := configFor("10.1.1.1:1234", "alice")
+	payload, ok := config["auth"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("missing auth payload: %v", config)
+	}
+	if payload["id"] != "existing" || payload["username"] != "alice" || payload["name"] != "Alice" || payload["isAdmin"] != false {
+		t.Fatalf("incorrect user payload: %v", payload)
+	}
+	if _, err := auth.Validate(payload["token"].(string)); err != nil {
+		t.Fatalf("invalid token: %v", err)
+	}
+	if payload["subsonicSalt"] == "" || payload["subsonicToken"] == "" {
+		t.Fatalf("missing Subsonic credentials: %v", payload)
+	}
+
+	config = configFor("10.1.1.1:1234", "newuser")
+	payload = config["auth"].(map[string]interface{})
+	if payload["isAdmin"] != false {
+		t.Fatal("second user should not be admin")
+	}
+	created, err := repo.FindByUsername("newuser")
+	if err != nil || created.LastLoginAt == nil {
+		t.Fatalf("user not created or login time missing: %v, %v", created, err)
+	}
+}
+
+func TestReverseProxyFirstUserAndUnixSocket(t *testing.T) {
+	previous := *conf.Server
+	t.Cleanup(func() { *conf.Server = previous })
+	conf.Server.ReverseProxyWhitelist = "@"
+	conf.Server.ReverseProxyUserHeader = "Remote-User"
+	conf.Server.ReverseProxyDefaultUser = "firstuser"
+	ds := &tests.MockDataStore{}
+
+	request := func(addr string) map[string]interface{} {
+		r := httptest.NewRequest("GET", "/index.html", nil)
+		r.RemoteAddr = addr
+		w := httptest.NewRecorder()
+		serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+		return extractAppConfig(w.Body.String())
+	}
+	if _, ok := request("127.0.0.1:1234")["auth"]; ok {
+		t.Fatal("TCP peer received Unix socket auth")
+	}
+	authPayload, ok := request("@")["auth"].(map[string]interface{})
+	if !ok || authPayload["username"] != "firstuser" || authPayload["isAdmin"] != true {
+		t.Fatalf("first proxy user should be admin: %v", authPayload)
+	}
+	conf.Server.ReverseProxyWhitelist = ""
+	if _, ok := request("@")["auth"]; ok {
+		t.Fatal("empty whitelist must disable proxy login")
+	}
+}
