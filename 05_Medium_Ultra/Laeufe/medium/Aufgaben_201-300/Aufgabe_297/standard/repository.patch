+func redactValue(value interface{}, re *regexp.Regexp) interface{} {
+	if value == nil {
+		return nil
+	}
+	v := reflect.ValueOf(value)
+	if v.Kind() == reflect.Map {
+		redacted := reflect.MakeMapWithSize(v.Type(), v.Len())
+		for _, key := range v.MapKeys() {
+			var replacement interface{}
+			if re.MatchString(fmt.Sprint(key.Interface())) || sensitiveKey.MatchString(fmt.Sprint(key.Interface())) {
+				replacement = "[REDACTED]"
+			} else {
+				replacement = redactValue(v.MapIndex(key).Interface(), re)
+			}
+			out := reflect.ValueOf(replacement)
+			if replacement == nil {
+				out = reflect.Zero(v.Type().Elem())
+			} else if !out.Type().AssignableTo(v.Type().Elem()) {
+				// A typed map cannot hold the redacted string. Convert it to a
+				// map with interface values, retaining the original keys.
+				converted := make(map[interface{}]interface{}, v.Len())
+				for _, originalKey := range v.MapKeys() {
+					originalValue := v.MapIndex(originalKey).Interface()
+					if sensitiveKey.MatchString(fmt.Sprint(originalKey.Interface())) || re.MatchString(fmt.Sprint(originalKey.Interface())) {
+						converted[originalKey.Interface()] = "[REDACTED]"
+					} else {
+						converted[originalKey.Interface()] = redactValue(originalValue, re)
+					}
+				}
+				return converted
+			}
+			redacted.SetMapIndex(key, out)
+		}
+		return redacted.Interface()
+	}
+	if str, ok := value.(string); ok {
+		return re.ReplaceAllString(str, "$1[REDACTED]$2")
+	}
+	return re.ReplaceAllString(fmt.Sprintf("%v", value), "$1[REDACTED]$2")
+}
