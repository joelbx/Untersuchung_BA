+func TestNewWithClientEnvironment(t *testing.T) {
+	tests := []struct {
+		name        string
+		namespace   string
+		replicaName string
+		wantErr     string
+	}{
+		{
+			name:        "missing namespace",
+			replicaName: "agent-0",
+			wantErr:     `environment variable "KUBE_NAMESPACE" not set or empty`,
+		},
+		{
+			name:      "missing replica name",
+			namespace: "test",
+			wantErr:   `environment variable "TELEPORT_REPLICA_NAME" not set or empty`,
+		},
+		{
+			name:        "configured",
+			namespace:   "test",
+			replicaName: "agent-0",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(NamespaceEnv, tt.namespace)
+			t.Setenv(teleportReplicaNameEnv, tt.replicaName)
+			t.Setenv(ReleaseNameEnv, "teleport")
+
+			b, err := NewWithClient(fake.NewSimpleClientset())
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				require.Nil(t, b)
+				return
+			}
+
+			require.NoError(t, err)
+			require.Equal(t, tt.namespace, b.Namespace)
+			require.Equal(t, tt.replicaName, b.ReplicaName)
+			require.Equal(t, "agent-0-state", b.SecretName)
+			require.Equal(t, "teleport", b.ReleaseName)
+		})
+	}
+}
