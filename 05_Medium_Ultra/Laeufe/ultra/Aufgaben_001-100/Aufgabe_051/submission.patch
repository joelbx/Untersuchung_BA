+func TestReadKubeClusterFlag(t *testing.T) {
+	tests := []struct {
+		name       string
+		cliCluster string
+		envCluster string
+		want       string
+	}{
+		{
+			name:       "environment cluster",
+			envCluster: "kube-from-env",
+			want:       "kube-from-env",
+		},
+		{
+			name:       "CLI cluster takes precedence",
+			cliCluster: "kube-from-cli",
+			envCluster: "kube-from-env",
+			want:       "kube-from-cli",
+		},
+		{
+			name: "neither set",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cf := CLIConf{KubernetesCluster: tt.cliCluster}
+			readKubeClusterFlag(&cf, func(envName string) string {
+				require.Equal(t, kubeClusterEnvVar, envName)
+				return tt.envCluster
+			})
+			require.Equal(t, tt.want, cf.KubernetesCluster)
+		})
+	}
+}
+
+func TestReadEnvironmentEmptyDefaults(t *testing.T) {
+	cf := CLIConf{}
+	emptyEnv := func(string) string { return "" }
+	readClusterFlag(&cf, emptyEnv)
+	readKubeClusterFlag(&cf, emptyEnv)
+	readTeleportHome(&cf, emptyEnv)
+
+	require.Empty(t, cf.SiteName)
+	require.Empty(t, cf.KubernetesCluster)
+	require.Empty(t, cf.HomePath)
+}
