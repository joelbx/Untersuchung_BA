+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import { mount } from "enzyme";
+import { MsgType } from "matrix-js-sdk/src/@types/event";
+
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import { RoomPermalinkCreator } from "../../../../src/utils/permalinks/Permalinks";
+import { mkEvent, stubClient } from "../../../test-utils";
+import dis from "../../../../src/dispatcher/dispatcher";
+import { TimelineRenderingType } from "../../../../src/contexts/RoomContext";
+
+jest.mock("../../../../src/components/views/rooms/ReplyTile", () => ({
+    __esModule: true,
+    default: () => null,
+}));
+
+describe("ReplyPreview", () => {
+    stubClient();
+
+    it.each([MsgType.Text, MsgType.Emote])("names the sender and supports cancel for %s", msgtype => {
+        const replyToEvent = mkEvent({
+            event: true,
+            type: "m.room.message",
+            room: "!room:example.org",
+            user: "@alice:example.org",
+            content: { msgtype, body: "Hello" },
+        });
+        const dispatchSpy = jest.spyOn(dis, "dispatch").mockImplementation(() => {});
+        const wrapper = mount(<ReplyPreview
+            replyToEvent={replyToEvent}
+            permalinkCreator={{} as RoomPermalinkCreator}
+        />);
+
+        const header = wrapper.find(".mx_ReplyPreview_header").hostNodes();
+        expect(header.find("p").text()).toContain("Replying to @alice:example.org");
+        expect(header.find("p .mx_DisambiguatedProfile").hostNodes().getDOMNode().tagName).toBe("SPAN");
+
+        const cancel = wrapper.find('[aria-label="Cancel replying to a message"]').hostNodes();
+        expect(cancel).toHaveLength(1);
+        cancel.simulate("click");
+        expect(dispatchSpy).toHaveBeenCalledWith({
+            action: "reply_to_event",
+            event: null,
+            context: TimelineRenderingType.Room,
+        });
+
+        wrapper.unmount();
+        dispatchSpy.mockRestore();
+    });
+});
