+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from jinja2.exceptions import TemplateSyntaxError
+
+from units.compat import unittest
+from units.compat.mock import Mock, patch
+
+from ansible.errors import AnsiblePluginRemovedError
+from ansible.plugins.loader import PluginLoadContext
+from ansible.template import JinjaPluginIntercept
+
+
+class TestJinjaPluginIntercept(unittest.TestCase):
+    def setUp(self):
+        self.plugin_loader = Mock()
+        self.plugin_loader.class_name = 'FilterModule'
+        self.filters = JinjaPluginIntercept({}, self.plugin_loader)
+
+    @patch('ansible.template.display.warning')
+    @patch('ansible.template._get_collection_metadata')
+    def test_builtin_filter_tombstone_is_template_error(self, get_metadata, warning):
+        get_metadata.return_value = {
+            'plugin_routing': {'filter': {'gone': {'tombstone': {'removal_date': '2024-01-01'}}}},
+        }
+
+        with self.assertRaises(TemplateSyntaxError) as result:
+            self.filters['gone']
+
+        self.assertIn('gone', str(result.exception))
+        self.assertIn('Ansible-base', str(result.exception))
+        self.assertIn('2024-01-01', str(result.exception))
+        self.plugin_loader.get_with_context.assert_not_called()
+        warning.assert_not_called()
+
+        removal = result.exception.__context__
+        self.assertIsInstance(removal, AnsiblePluginRemovedError)
+        self.assertTrue(removal.plugin_load_context.tombstone)
+        self.assertEqual(removal.plugin_load_context.removal_date, '2024-01-01')
+
+    @patch('ansible.template._get_collection_metadata')
+    def test_empty_tombstone_marks_filter_removed(self, get_metadata):
+        get_metadata.return_value = {'plugin_routing': {'filter': {'gone': {'tombstone': {}}}}}
+
+        with self.assertRaises(TemplateSyntaxError) as result:
+            self.filters['gone']
+
+        self.assertIn('removed', str(result.exception))
+        self.assertTrue(result.exception.__context__.plugin_load_context.tombstone)
+
+    @patch('ansible.template.display.warning')
+    @patch('ansible.template.import_module')
+    @patch('ansible.template._get_collection_metadata')
+    def test_collection_filter_tombstone_before_package_import(self, get_metadata, import_package, warning):
+        get_metadata.return_value = {
+            'plugin_routing': {'filter': {'gone': {'tombstone': {'removal_version': '2.0'}}}},
+        }
+
+        with self.assertRaises(TemplateSyntaxError) as result:
+            self.filters['acme.widgets.gone']
+
+        self.assertIn('acme.widgets.gone', str(result.exception))
+        self.assertIn('acme.widgets', str(result.exception))
+        self.assertIn('2.0', str(result.exception))
+        import_package.assert_not_called()
+        warning.assert_not_called()
+
+    @patch('ansible.template.display.warning')
+    @patch('ansible.template.pkgutil.iter_modules')
+    @patch('ansible.template.import_module')
+    @patch('ansible.template._get_collection_metadata')
+    def test_removed_filter_module_is_template_error(self, get_metadata, import_package, iter_modules, warning):
+        get_metadata.return_value = {}
+        import_package.return_value = type('Package', (), {'__path__': []})()
+        iter_modules.return_value = [(None, 'acme.widgets.old_filters', False)]
+        context = PluginLoadContext()
+        context.tombstone = True
+        context.exit_reason = 'acme.widgets.old_filters was removed in version 2.0 of acme.widgets'
+        self.plugin_loader.get_with_context.return_value = Mock(object=None, plugin_load_context=context)
+
+        with self.assertRaises(TemplateSyntaxError) as result:
+            self.filters['acme.widgets.gone']
+
+        self.assertIn(context.exit_reason, str(result.exception))
+        self.plugin_loader.get_with_context.assert_called_once_with('acme.widgets.old_filters')
+        warning.assert_not_called()
