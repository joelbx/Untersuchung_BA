     # default ignore list for detailed views
     IGNORE = ('module', 'docuri', 'version_added', 'short_description', 'now_date', 'plainexamples', 'returndocs', 'collection')
+    _TTY_MACRO = re.compile(
+        r'(?<!\w)(?:(?P<macro>[IBMUCLR])\((?P<value>[^)]+)\)|(?P<rule>HORIZONTALLINE)(?!\w))'
+    )
 
     def __init__(self, args):
 
         super(DocCLI, self).__init__(args)
         self.plugin_list = set()
 
+    @classmethod
+    def tty_ify(cls, text):
+        def replace(match):
+            macro = match.group('macro')
+            if macro is None:
+                return '\n-------------\n'
+
+            value = match.group('value')
+            if macro in ('I', 'C'):
+                return "`%s'" % value
+            if macro == 'B':
+                return '*%s*' % value
+            if macro == 'M':
+                return '[%s]' % value
+            if macro == 'U':
+                return value
+
+            if ',' not in value:
+                return match.group(0)
+            label, target = value.split(',', 1)
+            if not label or not target.strip():
+                return match.group(0)
+            if macro == 'R':
+                return label
+            return '%s <%s>' % (label, target.lstrip())
+
+        return cls._TTY_MACRO.sub(replace, text)
+
+    @staticmethod
+    def _wrap(text, width, **kwargs):
+        # textwrap.fill collapses newlines, so wrap each side of a rule separately.
+        rule = '\n-------------\n'
+        if rule not in text:
+            return textwrap.fill(text, width, **kwargs)
+        return rule.join(textwrap.fill(part, width, **kwargs) for part in text.split(rule))
+
