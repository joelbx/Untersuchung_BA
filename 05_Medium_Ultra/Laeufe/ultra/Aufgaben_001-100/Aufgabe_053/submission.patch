+// DetectGitHubCves detects CVEs from configured GitHub Security Alerts.
+func DetectGitHubCves(r *models.ScanResult) error {
+	githubConfs := c.Conf.Servers[r.ServerName].GitHubRepos
+	return GithubSecurityAlerts(githubConfs).apply(r, &integrationResults{})
+}
+
+// DetectWordPressCves detects CVEs from the configured WordPress integration.
+func DetectWordPressCves(r *models.ScanResult) error {
+	wpVulnCaches := map[string]string{}
+	wpOpt := WordPressOption{
+		token:        c.Conf.Servers[r.ServerName].WordPress.WPVulnDBToken,
+		wpVulnCaches: &wpVulnCaches,
+	}
+	return wpOpt.apply(r, &integrationResults{})
+}
