+// DetectPkgCves detects package CVEs with OVAL and gost.
+func DetectPkgCves(dbclient DBClient, r *models.ScanResult) error {
+	if _, err := DetectPkgsCvesWithOval(dbclient.OvalDB, r); err != nil {
+		return xerrors.Errorf("Failed to fill with OVAL: %w", err)
+	}
+	if _, err := DetectPkgsCvesWithGost(dbclient.GostDB, r, true); err != nil {
+		return xerrors.Errorf("Failed to fill with gost: %w", err)
+	}
+	return nil
+}
