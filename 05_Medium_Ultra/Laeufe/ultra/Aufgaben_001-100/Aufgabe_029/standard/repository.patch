+# This file is part of Ansible
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import copy
+
+from ansible.module_utils.net_tools.nios import api
+from ansible.modules.net_tools.nios import nios_fixed_address
+from units.compat.mock import Mock, patch
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+
+
+class TestNiosFixedAddress(ModuleTestCase):
+
+    def setUp(self):
+        super(TestNiosFixedAddress, self).setUp()
+        self.connector = Mock()
+        connector_patch = patch('ansible.module_utils.net_tools.nios.api.get_connector',
+                                return_value=self.connector)
+        connector_patch.start()
+        self.addCleanup(connector_patch.stop)
+
+    def _args(self, ipaddr='192.168.10.10', network='192.168.10.0/24', **kwargs):
+        args = dict(name='printer-1', ipaddr=ipaddr, mac='00:11:22:33:44:55',
+                    network=network, provider=dict(host='127.0.0.1'))
+        args.update(kwargs)
+        return args
+
+    def _run(self, args):
+        set_module_args(args)
+        with self.assertRaises(AnsibleExitJson) as context:
+            nios_fixed_address.main()
+        return context.exception.args[0]
+
+    def _failed(self, args):
+        set_module_args(args)
+        with self.assertRaises(AnsibleFailJson) as context:
+            nios_fixed_address.main()
+        return context.exception.args[0]
+
+    def _existing(self, ipaddr='192.168.10.10', network='192.168.10.0/24',
+                  comment=None):
+        address_field = 'ipv6addr' if ':' in ipaddr else 'ipv4addr'
+        result = dict(_ref='fixedaddress/ref', name='printer-1',
+                      mac='00:11:22:33:44:55', network=network,
+                      network_view='default', **{address_field: ipaddr})
+        if comment is not None:
+            result['comment'] = comment
+        return result
+
+    def test_ipv4_create_uses_mapped_address_and_identity(self):
+        self.connector.get_object.return_value = None
+
+        result = self._run(self._args())
+
+        self.assertTrue(result['changed'])
+        lookup = self.connector.get_object.call_args
+        self.assertEqual(lookup[0][0], api.NIOS_IPV4_FIXED_ADDRESS)
+        self.assertEqual(lookup[0][1], dict(ipv4addr='192.168.10.10',
+                                             mac='00:11:22:33:44:55',
+                                             network='192.168.10.0/24',
+                                             network_view='default'))
+        self.assertNotIn('name', lookup[0][1])
+        self.assertIn('ipv4addr', lookup[1]['return_fields'])
+        self.assertNotIn('ipaddr', lookup[1]['return_fields'])
+        created_type, created = self.connector.create_object.call_args[0]
+        self.assertEqual(created_type, api.NIOS_IPV4_FIXED_ADDRESS)
+        self.assertEqual(created['name'], 'printer-1')
+        self.assertEqual(created['ipv4addr'], '192.168.10.10')
+        self.assertNotIn('ipaddr', created)
+
+    def test_ipv6_create_uses_mapped_address_and_identity(self):
+        self.connector.get_object.return_value = None
+        args = self._args(ipaddr='2001:db8::10', network='2001:db8::/64')
+
+        result = self._run(args)
+
+        self.assertTrue(result['changed'])
+        lookup = self.connector.get_object.call_args
+        self.assertEqual(lookup[0][0], api.NIOS_IPV6_FIXED_ADDRESS)
+        self.assertEqual(lookup[0][1]['ipv6addr'], '2001:db8::10')
+        self.assertEqual(lookup[0][1]['mac'], '00:11:22:33:44:55')
+        self.assertEqual(lookup[0][1]['network'], '2001:db8::/64')
+        self.assertEqual(lookup[0][1]['network_view'], 'default')
+        self.assertNotIn('name', lookup[0][1])
+        self.assertNotIn('ipaddr', lookup[0][1])
+        created_type, created = self.connector.create_object.call_args[0]
+        self.assertEqual(created_type, api.NIOS_IPV6_FIXED_ADDRESS)
+        self.assertEqual(created['ipv6addr'], '2001:db8::10')
+        self.assertNotIn('ipaddr', created)
+
+    def test_invalid_ip_fails_before_wapi_lookup(self):
+        result = self._failed(self._args(ipaddr='not-an-address'))
+
+        self.assertIn('ipaddr', result['msg'])
+        self.connector.get_object.assert_not_called()
+
+    def test_provider_is_required(self):
+        args = self._args()
+        del args['provider']
+
+        result = self._failed(args)
+
+        self.assertIn('provider', result['msg'])
+        self.connector.get_object.assert_not_called()
+
+    def test_options_defaults_and_none_fields(self):
+        self.connector.get_object.return_value = None
+        args = self._args(options=[dict(name='domain-name', value='example.com'),
+                                  dict(num=42, value='custom', use_option=False,
+                                       vendor_class='Example')])
+
+        self._run(args)
+
+        created = self.connector.create_object.call_args[0][1]
+        self.assertEqual(created['options'], [
+            dict(name='domain-name', value='example.com', use_option=True,
+                 vendor_class='DHCP'),
+            dict(num=42, value='custom', use_option=False,
+                 vendor_class='Example')])
+
+    def test_options_helper_removes_none_values(self):
+        module = Mock()
+        module.params = {'options': [dict(name='domain-name', num=None,
+                                          value='example.com', use_option=None,
+                                          vendor_class=None)]}
+
+        self.assertEqual(nios_fixed_address.options(module), [
+            dict(name='domain-name', value='example.com')])
+
+    def test_option_requires_name_or_num_and_value(self):
+        for option in (dict(value='example.com'), dict(name='domain-name')):
+            module = Mock()
+            module.params = {'options': [option]}
+            module.fail_json.side_effect = AnsibleFailJson
+            with self.assertRaises(AnsibleFailJson):
+                nios_fixed_address.options(module)
+            module.fail_json.assert_called_once()
+
+    def test_existing_address_is_idempotent(self):
+        existing = self._existing(comment='same comment')
+        self.connector.get_object.side_effect = lambda *args, **kwargs: [copy.deepcopy(existing)]
+        args = self._args(comment='same comment')
+
+        first = self._run(args)
+        second = self._run(args)
+
+        self.assertFalse(first['changed'])
+        self.assertFalse(second['changed'])
+        self.connector.create_object.assert_not_called()
+        self.connector.update_object.assert_not_called()
+
+    def test_existing_address_updates_comment_and_extattrs(self):
+        existing = self._existing(comment='old comment')
+        existing['extattrs'] = {'Site': {'value': 'old'}}
+        self.connector.get_object.return_value = [copy.deepcopy(existing)]
+
+        result = self._run(self._args(comment='new comment', extattrs={'Site': 'new'}))
+
+        self.assertTrue(result['changed'])
+        ref, proposed = self.connector.update_object.call_args[0]
+        self.assertEqual(ref, 'fixedaddress/ref')
+        self.assertEqual(proposed['comment'], 'new comment')
+        self.assertEqual(proposed['extattrs'], {'Site': {'value': 'new'}})
+        for identity_field in ('ipv4addr', 'mac', 'network', 'network_view'):
+            self.assertNotIn(identity_field, proposed)
