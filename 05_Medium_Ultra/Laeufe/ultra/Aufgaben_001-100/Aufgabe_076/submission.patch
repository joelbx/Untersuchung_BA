diff --git a/packages/shared/test/mail/recipient.spec.ts b/packages/shared/test/mail/recipient.spec.ts
new file mode 100644
index 0000000..8f70ca0
--- /dev/null
+++ b/packages/shared/test/mail/recipient.spec.ts
@@ -0,0 +1,44 @@
+import { inputToRecipient, splitBySeparator } from '@proton/shared/lib/mail/recipient';
+
+describe('splitBySeparator', () => {
+    it('splits on commas and semicolons while preserving address order', () => {
+        expect(
+            splitBySeparator(',plus@debye.proton.black, visionary@debye.proton.black; pro@debye.proton.black,')
+        ).toEqual(['plus@debye.proton.black', 'visionary@debye.proton.black', 'pro@debye.proton.black']);
+    });
+
+    it('trims whitespace and removes angle brackets from tokens', () => {
+        expect(splitBySeparator('  <first@example.com> ; <second@example.com>  ')).toEqual([
+            'first@example.com',
+            'second@example.com',
+        ]);
+    });
+
+    it('discards empty tokens from consecutive separators and empty brackets', () => {
+        expect(splitBySeparator(' , ; <> , < > ;; third@example.com ; ')).toEqual(['third@example.com']);
+        expect(splitBySeparator(' , ; <> , < > ;; ')).toEqual([]);
+    });
+});
+
+describe('inputToRecipient', () => {
+    it('uses a plain email as both name and address', () => {
+        expect(inputToRecipient('person@example.com')).toEqual({
+            Name: 'person@example.com',
+            Address: 'person@example.com',
+        });
+    });
+
+    it('uses the bare email as both name and address for a bracketed email', () => {
+        expect(inputToRecipient('<person@example.com>')).toEqual({
+            Name: 'person@example.com',
+            Address: 'person@example.com',
+        });
+    });
+
+    it('preserves the display name of a named address', () => {
+        expect(inputToRecipient('Alice <alice@example.com>')).toEqual({
+            Name: 'Alice',
+            Address: 'alice@example.com',
+        });
+    });
+});
