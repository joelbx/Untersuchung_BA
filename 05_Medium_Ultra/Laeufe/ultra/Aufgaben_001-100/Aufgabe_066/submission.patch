@@ -0,0 +1,83 @@
+const viewportHeight = /\b\d*\.?\d+vh\b/i;
+const cssComment = /\/\*[\s\S]*?\*\//g;
+
+const replaceHeightDeclaration = (declaration: string): string => {
+    let colon = -1;
+    for (let index = 0; index < declaration.length; index++) {
+        if (declaration[index] === '/' && declaration[index + 1] === '*') {
+            const commentEnd = declaration.indexOf('*/', index + 2);
+            if (commentEnd === -1) {
+                return declaration;
+            }
+            index = commentEnd + 1;
+        } else if (declaration[index] === ':') {
+            colon = index;
+            break;
+        }
+    }
+
+    if (colon === -1 || declaration.slice(0, colon).replace(cssComment, '').trim().toLowerCase() !== 'height') {
+        return declaration;
+    }
+
+    const value = declaration.slice(colon + 1);
+    if (!viewportHeight.test(value.replace(cssComment, ''))) {
+        return declaration;
+    }
+
+    const leadingSpace = value.match(/^\s*/)?.[0] || '';
+    const suffix = value.match(/\s*!important\s*$/i)?.[0] || value.match(/\s*$/)?.[0] || '';
+    return `${declaration.slice(0, colon + 1)}${leadingSpace}auto${suffix}`;
+};
+
+const replaceViewportHeights = (style: string): string => {
+    let result = '';
+    let start = 0;
+    let depth = 0;
+    let quote = '';
+
+    for (let index = 0; index < style.length; index++) {
+        const character = style[index];
+
+        if (quote) {
+            if (character === '\\') {
+                index++;
+            } else if (character === quote) {
+                quote = '';
+            }
+        } else if (character === '/' && style[index + 1] === '*') {
+            const commentEnd = style.indexOf('*/', index + 2);
+            if (commentEnd === -1) {
+                break;
+            }
+            index = commentEnd + 1;
+        } else if (character === '"' || character === "'") {
+            quote = character;
+        } else if (character === '(') {
+            depth++;
+        } else if (character === ')' && depth > 0) {
+            depth--;
+        } else if (character === ';' && depth === 0) {
+            result += `${replaceHeightDeclaration(style.slice(start, index))};`;
+            start = index + 1;
+        }
+    }
+
+    return result + replaceHeightDeclaration(style.slice(start));
+};
+
+const replaceViewportHeight = (element: Element) => {
+    const style = element.getAttribute('style');
+    if (style && viewportHeight.test(style)) {
+        // Keep the raw attribute text: CSSOM discards proton-url() markers used by transformRemote.
+        const nextStyle = replaceViewportHeights(style);
+        if (nextStyle !== style) {
+            element.setAttribute('style', nextStyle);
+        }
+    }
+};
+
+export const transformStyleAttributes = (document: Element): void => {
+    replaceViewportHeight(document);
+    document.querySelectorAll('[style]').forEach(replaceViewportHeight);
+};
