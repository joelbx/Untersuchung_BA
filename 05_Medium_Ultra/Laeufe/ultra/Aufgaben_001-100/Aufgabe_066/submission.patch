+import { transformStyleAttributes } from '../transformStyleAttributes';
+
+describe('transformStyleAttributes', () => {
+    it('replaces viewport heights on the root and nested elements', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 75vh; color: red');
+        root.innerHTML =
+            '<section style="height: calc(100vh - 20px); width: 10px"><p style="height: 20vh">Text</p></section>';
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.color).toBe('red');
+        expect((root.querySelector('section') as HTMLElement).style.height).toBe('auto');
+        expect((root.querySelector('section') as HTMLElement).style.width).toBe('10px');
+        expect((root.querySelector('p') as HTMLElement).style.height).toBe('auto');
+    });
+
+    it('leaves non-viewport heights and other properties unchanged', () => {
+        const root = document.createElement('div');
+        root.innerHTML =
+            '<p style="height: 20px; min-height: 30vh; color: blue">Text</p><span style="width: 50vh">More</span>';
+
+        transformStyleAttributes(root);
+
+        const paragraph = root.querySelector('p') as HTMLElement;
+        expect(paragraph.style.height).toBe('20px');
+        expect(paragraph.style.minHeight).toBe('30vh');
+        expect(paragraph.style.color).toBe('blue');
+        expect((root.querySelector('span') as HTMLElement).style.width).toBe('50vh');
+    });
+
+    it('preserves the priority of a height declaration', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 50vh !important; color: green');
+
+        transformStyleAttributes(root);
+
+        expect(root.style.height).toBe('auto');
+        expect(root.style.getPropertyPriority('height')).toBe('important');
+        expect(root.style.color).toBe('green');
+    });
+
+    it('keeps remote image markers and other style text intact', () => {
+        const root = document.createElement('div');
+        root.setAttribute(
+            'style',
+            'background: proton-url(https://example.test/image;a.png); height: 50vh; color: red'
+        );
+
+        transformStyleAttributes(root);
+
+        expect(root.getAttribute('style')).toBe(
+            'background: proton-url(https://example.test/image;a.png); height: auto; color: red'
+        );
+    });
+
+    it('handles style attributes on non-HTML elements', () => {
+        const root = document.createElement('div');
+        root.innerHTML = '<math style="height: 50vh"><mi>n</mi></math>';
+
+        transformStyleAttributes(root);
+
+        expect(root.querySelector('math')?.getAttribute('style')).toBe('height: auto');
+    });
+
+    it('ignores viewport units inside comments and semicolons in comments', () => {
+        const root = document.createElement('div');
+        root.setAttribute('style', 'height: 20px /* 100vh */; color: red');
+        root.innerHTML = '<p style="height: /* note; */ 100vh; color: blue">Text</p>';
+
+        transformStyleAttributes(root);
+
+        expect(root.getAttribute('style')).toBe('height: 20px /* 100vh */; color: red');
+        expect(root.querySelector('p')?.getAttribute('style')).toBe('height: auto; color: blue');
+    });
+});
