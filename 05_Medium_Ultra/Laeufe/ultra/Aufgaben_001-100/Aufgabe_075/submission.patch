+func NewMockUserPropsRepo(ctx context.Context) *MockUserPropsRepo {
+	return &MockUserPropsRepo{ctx: ctx, store: &mockUserPropsStore{values: make(map[string]map[string]string)}}
+}
+
+// WithContext returns a repository for another user while sharing stored values.
+func (r *MockUserPropsRepo) WithContext(ctx context.Context) *MockUserPropsRepo {
+	return &MockUserPropsRepo{ctx: ctx, store: r.store}
+}
+
+func (r *MockUserPropsRepo) userID() (string, error) {
+	if r.ctx == nil {
+		return "", model.ErrNotAuthorized
+	}
+	user, ok := request.UserFrom(r.ctx)
+	if !ok || user.ID == "" {
+		return "", model.ErrNotAuthorized
+	}
+	return user.ID, nil
+}
+
+func (r *MockUserPropsRepo) Put(key, value string) error {
+	userID, err := r.userID()
+	if err != nil {
+		return err
+	}
+	r.store.mu.Lock()
+	defer r.store.mu.Unlock()
+	if r.store.values[userID] == nil {
+		r.store.values[userID] = make(map[string]string)
+	}
+	r.store.values[userID][key] = value
+	return nil
+}
+
+func (r *MockUserPropsRepo) Get(key string) (string, error) {
+	userID, err := r.userID()
+	if err != nil {
+		return "", err
+	}
+	r.store.mu.Lock()
+	defer r.store.mu.Unlock()
+	value, ok := r.store.values[userID][key]
+	if !ok {
+		return "", model.ErrNotFound
+	}
+	return value, nil
+}
+
+func (r *MockUserPropsRepo) Delete(key string) error {
+	userID, err := r.userID()
+	if err != nil {
+		return err
+	}
+	r.store.mu.Lock()
+	defer r.store.mu.Unlock()
+	delete(r.store.values[userID], key)
+	return nil
+}
