+}
diff --git a/db/migration/20210620000000_create_user_props_table_test.go b/db/migration/20210620000000_create_user_props_table_test.go
new file mode 100644
index 0000000..513a282
--- /dev/null
+++ b/db/migration/20210620000000_create_user_props_table_test.go
@@ -0,0 +1,81 @@
+package migrations
+
+import (
+	"database/sql"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestCreateUserPropsTableMovesLastFMSessions(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+
+	_, err = db.Exec(`
+		pragma foreign_keys = on;
+		create table user (id text primary key);
+		create table property (id text primary key, value text not null);
+		insert into user (id) values ('user_1'), ('user-2');
+		insert into property (id, value) values
+			('LastFMSessionKey_user_1', 'first session'),
+			('LastFMSessionKey_user-2', 'second session'),
+			('LastFMSessionKey_deleted-user', 'orphan session'),
+			('LastScan', 'global value');
+	`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = upCreateUserPropsTable(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err = tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, tc := range []struct{ userID, value string }{
+		{"user_1", "first session"},
+		{"user-2", "second session"},
+	} {
+		var value string
+		if err := db.QueryRow("select value from user_props where user_id = ? and key = ?", tc.userID, "LastFMSessionKey").Scan(&value); err != nil {
+			t.Fatal(err)
+		}
+		if value != tc.value {
+			t.Errorf("session for %s = %q, want %q", tc.userID, value, tc.value)
+		}
+	}
+
+	var count int
+	if err := db.QueryRow("select count(*) from property where id in ('LastFMSessionKey_user_1', 'LastFMSessionKey_user-2')").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Errorf("migrated global session properties remaining: %d", count)
+	}
+	if err := db.QueryRow("select count(*) from property where id in ('LastScan', 'LastFMSessionKey_deleted-user')").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Errorf("unrelated or orphan properties remaining: %d, want 2", count)
+	}
+
+	if _, err := db.Exec("delete from user where id = 'user-2'"); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow("select count(*) from user_props where user_id = 'user-2'").Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Errorf("properties remaining after user deletion: %d", count)
+	}
+}
