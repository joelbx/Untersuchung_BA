+package lastfm
+
+import (
+	"bytes"
+	"context"
+	"io/ioutil"
+	"net/http"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+type lastFMUserRepo struct {
+	model.UserRepository
+	users map[string]*model.User
+}
+
+func (r *lastFMUserRepo) Get(id string) (*model.User, error) {
+	user, ok := r.users[id]
+	if !ok {
+		return nil, model.ErrNotFound
+	}
+	return user, nil
+}
+
+var _ = Describe("LastFM session keys", func() {
+	It("keeps each contextual user's session key separate", func() {
+		ds := &tests.MockDataStore{}
+		keys := &sessionKeys{ds: ds}
+		first := request.WithUser(context.Background(), model.User{ID: "user-1"})
+		second := request.WithUser(context.Background(), model.User{ID: "user-2"})
+
+		Expect(keys.put(first, "SK-1")).To(Succeed())
+		Expect(keys.put(second, "SK-2")).To(Succeed())
+		Expect(keys.get(first)).To(Equal("SK-1"))
+		Expect(keys.get(second)).To(Equal("SK-2"))
+		Expect(keys.delete(first)).To(Succeed())
+		_, err := keys.get(first)
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(keys.get(second)).To(Equal("SK-2"))
+	})
+
+	It("scopes a callback to the existing user identified by its uid", func() {
+		ds := &tests.MockDataStore{
+			MockedUser: &lastFMUserRepo{users: map[string]*model.User{
+				"user-1": {ID: "user-1"},
+			}},
+		}
+		httpClient := &tests.FakeHttpClient{Res: http.Response{
+			Body:       ioutil.NopCloser(bytes.NewBufferString(`{"session":{"key":"SK-1"}}`)),
+			StatusCode: http.StatusOK,
+		}}
+		router := &Router{
+			ds:          ds,
+			sessionKeys: &sessionKeys{ds: ds},
+			client:      NewClient("API_KEY", "SECRET", "en", httpClient),
+		}
+
+		Expect(router.fetchSessionKey(context.Background(), "user-1", "TOKEN")).To(Succeed())
+		first := request.WithUser(context.Background(), model.User{ID: "user-1"})
+		Expect(ds.UserProps(first).Get(sessionKeyProperty)).To(Equal("SK-1"))
+		second := request.WithUser(context.Background(), model.User{ID: "user-2"})
+		_, err := ds.UserProps(second).Get(sessionKeyProperty)
+		Expect(err).To(Equal(model.ErrNotFound))
+
+		Expect(router.fetchSessionKey(context.Background(), "missing", "TOKEN")).To(Equal(model.ErrNotFound))
+		Expect(httpClient.RequestCount).To(Equal(1))
+	})
+})
