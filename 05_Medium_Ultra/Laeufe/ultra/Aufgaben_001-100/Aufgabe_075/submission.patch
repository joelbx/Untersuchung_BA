+package persistence
+
+import (
+	"context"
+	"time"
+
+	"github.com/astaxie/beego/orm"
+	"github.com/google/uuid"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("UserPropsRepository", func() {
+	var o orm.Ormer
+	var firstID, secondID string
+	var first, second model.UserPropsRepository
+
+	BeforeEach(func() {
+		o = orm.NewOrm()
+		firstID, secondID = uuid.NewString(), uuid.NewString()
+		for _, id := range []string{firstID, secondID} {
+			_, err := o.Raw(`insert into user (id, user_name, name, email, password, created_at, updated_at)
+				values (?, ?, ?, ?, '', ?, ?)`, id, id, id, id+"@example.com", time.Now(), time.Now()).Exec()
+			Expect(err).ToNot(HaveOccurred())
+		}
+		ctx := log.NewContext(context.Background())
+		first = NewUserPropsRepository(request.WithUser(ctx, model.User{ID: firstID}), o)
+		second = NewUserPropsRepository(request.WithUser(ctx, model.User{ID: secondID}), o)
+	})
+
+	AfterEach(func() {
+		_, err := o.Raw("delete from user_props where user_id in (?, ?)", firstID, secondID).Exec()
+		Expect(err).ToNot(HaveOccurred())
+		_, err = o.Raw("delete from user where id in (?, ?)", firstID, secondID).Exec()
+		Expect(err).ToNot(HaveOccurred())
+	})
+
+	It("creates and updates properties within the contextual user", func() {
+		Expect(first.Put("key", "first value")).To(Succeed())
+		Expect(first.Get("key")).To(Equal("first value"))
+		value, err := second.Get("key")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(Equal(model.ErrNotFound))
+
+		Expect(second.Put("key", "second value")).To(Succeed())
+		Expect(first.Put("key", "updated value")).To(Succeed())
+		Expect(first.Get("key")).To(Equal("updated value"))
+		Expect(second.Get("key")).To(Equal("second value"))
+	})
+
+	It("deletes only the contextual user's property", func() {
+		Expect(first.Put("key", "first value")).To(Succeed())
+		Expect(second.Put("key", "second value")).To(Succeed())
+		Expect(first.Delete("key")).To(Succeed())
+		value, err := first.Get("key")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(Equal(model.ErrNotFound))
+		Expect(second.Get("key")).To(Equal("second value"))
+	})
+
+	It("rejects operations without a contextual user", func() {
+		unscoped := NewUserPropsRepository(log.NewContext(context.Background()), o)
+		Expect(unscoped.Put("key", "value")).To(Equal(model.ErrNotAuthorized))
+		value, err := unscoped.Get("key")
+		Expect(value).To(BeEmpty())
+		Expect(err).To(Equal(model.ErrNotAuthorized))
+		Expect(unscoped.Delete("key")).To(Equal(model.ErrNotAuthorized))
+	})
+})
