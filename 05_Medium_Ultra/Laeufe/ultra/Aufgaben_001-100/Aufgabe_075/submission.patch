+create table user_props
+(
+	user_id varchar(255) not null
+		references user (id)
+			on update cascade on delete cascade,
+	key varchar(255) not null,
+	value text not null,
+	primary key (user_id, key)
+);
+
+insert into user_props (user_id, key, value)
+select u.id, 'LastFMSessionKey', p.value
+from user u
+join property p on p.id = 'LastFMSessionKey_' || u.id;
+
+delete from property
+where id in (select 'LastFMSessionKey_' || id from user);
+`)
+	return err
+}
+
+func downCreateUserPropsTable(tx *sql.Tx) error {
