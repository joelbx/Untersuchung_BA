+def find_author_by_remote_ids(remote_ids: dict[str, str]) -> "Author | None":
+    """Choose the compatible author with the most matching external IDs."""
+    from openlibrary.core.models import AuthorRemoteIdConflictError
+
+    candidates = {}
+    for id_type, value in sorted(remote_ids.items()):
+        if not value:
+            continue
+        offset = 0
+        while True:
+            keys = list(
+                web.ctx.site.things(
+                    {
+                        'type': '/type/author',
+                        f'remote_ids.{id_type}': value,
+                        'limit': 100,
+                        'offset': offset,
+                    }
+                )
+            )
+            for key in keys:
+                if candidate := resolve_author_key(key):
+                    candidates[candidate.key] = candidate
+            if len(keys) < 100:
+                break
+            offset += len(keys)
+
+    compatible = []
+    conflicts = []
+    for candidate in sorted(candidates.values(), key=lambda a: (key_int(a), a.key)):
+        try:
+            _, matches = candidate.merge_remote_ids(remote_ids)
+        except AuthorRemoteIdConflictError as error:
+            conflicts.append(error)
+            continue
+        if matches:
+            compatible.append((candidate, matches))
+
+    if compatible:
+        return min(
+            compatible,
+            key=lambda item: (-item[1], key_int(item[0]), item[0].key),
+        )[0]
+    if conflicts:
+        raise conflicts[0]
+    return None
 
 
