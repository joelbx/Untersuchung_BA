+def resolve_author_key(key: str) -> "Author | None":
+    """Follow an author key through redirects to an existing author."""
+    if not key.startswith('/'):
+        key = f'/authors/{key}'
+
+    seen = set()
+    while key and key not in seen:
+        seen.add(key)
+        author = web.ctx.site.get(key)
+        if not author:
+            return None
+        if author.type.key == '/type/author':
+            return author
+        if author.type.key != '/type/redirect':
+            return None
+        key = author.get('location')
+    return None
