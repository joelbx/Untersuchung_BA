 class Author(Thing):
     """Class to represent /type/author objects in OL."""
 
+    def merge_remote_ids(
+        self, incoming_ids: dict[str, str]
+    ) -> tuple[dict[str, str], int]:
+        """Return remote IDs merged with incoming IDs and the number of matches.
+
+        A match is an identifier type whose incoming value equals the value
+        already on this author. Conflicts leave the author unchanged.
+        """
+        merged_ids = dict(self.get('remote_ids') or {})
+        matching_ids = 0
+
+        for id_type in sorted(incoming_ids):
+            incoming_value = incoming_ids[id_type]
+            if id_type in merged_ids:
+                existing_value = merged_ids[id_type]
+                if existing_value != incoming_value:
+                    raise AuthorRemoteIdConflictError(
+                        f"Conflicting {id_type} remote ID for author {self.key}: "
+                        f"{existing_value!r} != {incoming_value!r}"
+                    )
+                matching_ids += 1
+            else:
+                merged_ids[id_type] = incoming_value
+
+        return merged_ids, matching_ids
+
     def url(self, suffix="", **params):
         return self.get_url(suffix, **params)
 
