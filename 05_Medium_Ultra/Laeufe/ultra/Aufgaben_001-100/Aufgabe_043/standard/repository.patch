+func TestGetExporterOTLPHTTPPath(t *testing.T) {
+	for _, path := range []string{"/custom/traces", "/custom%20traces"} {
+		t.Run(path, func(t *testing.T) {
+			received := make(chan string, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				received <- r.URL.EscapedPath()
+				w.WriteHeader(http.StatusOK)
+			}))
+			t.Cleanup(server.Close)
+			cfg := config.TracingConfig{
+				Exporter: config.TracingOTLP,
+				OTLP:     config.OTLPTracingConfig{Endpoint: server.URL + path},
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			exporter, shutdown, err := GetExporter(ctx, &cfg)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, shutdown(context.Background())) })
+
+			recorder := tracetest.NewSpanRecorder()
+			provider := tracesdk.NewTracerProvider(tracesdk.WithSpanProcessor(recorder))
+			_, span := provider.Tracer("test").Start(ctx, "request")
+			span.End()
+			require.NoError(t, exporter.ExportSpans(ctx, recorder.Ended()))
+			require.NoError(t, provider.Shutdown(ctx))
+
+			select {
+			case actual := <-received:
+				require.Equal(t, path, actual)
+			case <-ctx.Done():
+				t.Fatal("OTLP HTTP exporter did not send a trace")
+			}
+		})
+	}
+}
