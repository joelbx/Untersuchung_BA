+func TestGetExporterOTLPGRPCHeaders(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	collector := &testTraceCollector{headers: make(chan metadata.MD, 2)}
+	server := grpc.NewServer()
+	collectortrace.RegisterTraceServiceServer(server, collector)
+	go func() { _ = server.Serve(listener) }()
+	t.Cleanup(server.Stop)
+
+	for _, endpoint := range []string{"grpc://" + listener.Addr().String(), listener.Addr().String()} {
+		t.Run(endpoint, func(t *testing.T) {
+			cfg := config.TracingConfig{
+				Exporter: config.TracingOTLP,
+				OTLP: config.OTLPTracingConfig{
+					Endpoint: endpoint,
+					Headers:  map[string]string{"api-key": "test-key"},
+				},
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			exporter, shutdown, err := GetExporter(ctx, &cfg)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, shutdown(context.Background())) })
+
+			recorder := tracetest.NewSpanRecorder()
+			provider := tracesdk.NewTracerProvider(tracesdk.WithSpanProcessor(recorder))
+			_, span := provider.Tracer("test").Start(ctx, "request")
+			span.End()
+			require.NoError(t, exporter.ExportSpans(ctx, recorder.Ended()))
+			require.NoError(t, provider.Shutdown(ctx))
+
+			select {
+			case headers := <-collector.headers:
+				require.Equal(t, []string{"test-key"}, headers.Get("api-key"))
+			case <-ctx.Done():
+				t.Fatal("OTLP gRPC exporter did not send a trace")
+			}
+		})
+	}
