new file mode 100644
index 0000000..c46cd00
--- /dev/null
+++ b/internal/tracing/tracing.go
@@ -0,0 +1,179 @@
+// Package tracing configures Flipt's OpenTelemetry trace provider and exporters.
+package tracing
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/exporters/jaeger"
+	"go.opentelemetry.io/otel/exporters/otlp/otlptrace"
+	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
+	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp"
+	"go.opentelemetry.io/otel/exporters/zipkin"
+	"go.opentelemetry.io/otel/sdk/resource"
+	tracesdk "go.opentelemetry.io/otel/sdk/trace"
+	semconv "go.opentelemetry.io/otel/semconv/v1.4.0"
+)
+
+// newResource describes the Flipt service, including attributes from the
+// OpenTelemetry environment. Environment variables can override service.name,
+// while the version supplied by Flipt remains authoritative.
+func newResource(ctx context.Context, fliptVersion string) (*resource.Resource, error) {
+	return resource.New(ctx,
+		resource.WithSchemaURL(semconv.SchemaURL),
+		resource.WithAttributes(semconv.ServiceNameKey.String("flipt")),
+		resource.WithFromEnv(),
+		resource.WithAttributes(semconv.ServiceVersionKey.String(fliptVersion)),
+	)
+}
+
+// NewProvider creates a trace provider with Flipt resource attributes and
+// always-on sampling. Callers own the provider and must shut it down.
+func NewProvider(ctx context.Context, fliptVersion string) (*tracesdk.TracerProvider, error) {
+	res, err := newResource(ctx, fliptVersion)
+	if err != nil {
+		return nil, fmt.Errorf("creating tracing resource: %w", err)
+	}
+
+	return tracesdk.NewTracerProvider(
+		tracesdk.WithResource(res),
+		tracesdk.WithSampler(tracesdk.AlwaysSample()),
+	), nil
+}
+
+// GetExporter creates a tracing exporter for cfg. Each call creates an
+// independent exporter, and its returned shutdown function is safe to repeat.
+func GetExporter(ctx context.Context, cfg *config.TracingConfig) (tracesdk.SpanExporter, func(context.Context) error, error) {
+	if cfg == nil {
+		return nil, nil, fmt.Errorf("tracing config is nil")
+	}
+
+	var (
+		exporter tracesdk.SpanExporter
+		err      error
+	)
+
+	switch cfg.Exporter {
+	case config.TracingJaeger:
+		exporter, err = jaeger.New(jaeger.WithAgentEndpoint(
+			jaeger.WithAgentHost(cfg.Jaeger.Host),
+			jaeger.WithAgentPort(strconv.Itoa(cfg.Jaeger.Port)),
+		))
+	case config.TracingZipkin:
+		exporter, err = zipkin.New(cfg.Zipkin.Endpoint)
+	case config.TracingOTLP:
+		exporter, err = newOTLPExporter(ctx, cfg.OTLP)
+	default:
+		return nil, nil, fmt.Errorf("unsupported tracing exporter: %d", cfg.Exporter)
+	}
+	if err != nil {
+		return nil, nil, err
+	}
+
+	// A span processor also shuts down its exporter when the provider stops.
+	// Share the same once guard with the lifecycle callback so both paths can
+	// safely run without closing the underlying exporter twice.
+	guarded := &shutdownOnceExporter{SpanExporter: exporter}
+	return guarded, guarded.Shutdown, nil
+}
+
+type shutdownOnceExporter struct {
+	tracesdk.SpanExporter
+	once sync.Once
+	err  error
+}
+
+func (e *shutdownOnceExporter) Shutdown(ctx context.Context) error {
+	e.once.Do(func() {
+		e.err = e.SpanExporter.Shutdown(ctx)
+	})
+	return e.err
+}
+
+func newOTLPExporter(ctx context.Context, cfg config.OTLPTracingConfig) (tracesdk.SpanExporter, error) {
+	endpoint := cfg.Endpoint
+	if endpoint == "" {
+		return nil, fmt.Errorf("parsing otlp endpoint: endpoint is empty")
+	}
+
+	var client otlptrace.Client
+	if !strings.Contains(endpoint, "://") {
+		host, port, err := net.SplitHostPort(endpoint)
+		if err != nil {
+			return nil, fmt.Errorf("parsing otlp endpoint %q: %w", endpoint, err)
+		}
+		if host == "" {
+			return nil, fmt.Errorf("parsing otlp endpoint %q: host is empty", endpoint)
+		}
+		if err := validatePort(port); err != nil {
+			return nil, fmt.Errorf("parsing otlp endpoint %q: %w", endpoint, err)
+		}
+		client = otlptracegrpc.NewClient(
+			otlptracegrpc.WithEndpoint(endpoint),
+			otlptracegrpc.WithHeaders(cfg.Headers),
+			otlptracegrpc.WithInsecure(),
+		)
+	} else {
+		u, err := url.Parse(endpoint)
+		if err != nil {
+			return nil, fmt.Errorf("parsing otlp endpoint %q: %w", endpoint, err)
+		}
+		if u.Hostname() == "" {
+			return nil, fmt.Errorf("parsing otlp endpoint %q: host is empty", endpoint)
+		}
+		if u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+			return nil, fmt.Errorf("parsing otlp endpoint %q: user info, query, and fragment are unsupported", endpoint)
+		}
+		if port := u.Port(); port != "" {
+			if err := validatePort(port); err != nil {
+				return nil, fmt.Errorf("parsing otlp endpoint %q: %w", endpoint, err)
+			}
+		}
+
+		switch u.Scheme {
+		case "http", "https":
+			opts := []otlptracehttp.Option{
+				otlptracehttp.WithEndpoint(u.Host),
+				otlptracehttp.WithHeaders(cfg.Headers),
+			}
+			if u.Path != "" {
+				opts = append(opts, otlptracehttp.WithURLPath(u.Path))
+			}
+			if u.Scheme == "http" {
+				opts = append(opts, otlptracehttp.WithInsecure())
+			}
+			client = otlptracehttp.NewClient(opts...)
+		case "grpc":
+			if u.Path != "" {
+				return nil, fmt.Errorf("parsing otlp endpoint %q: grpc endpoint must not have a path", endpoint)
+			}
+			client = otlptracegrpc.NewClient(
+				otlptracegrpc.WithEndpoint(u.Host),
+				otlptracegrpc.WithHeaders(cfg.Headers),
+				otlptracegrpc.WithInsecure(),
+			)
+		default:
+			return nil, fmt.Errorf("parsing otlp endpoint %q: unsupported scheme %q", endpoint, u.Scheme)
+		}
+	}
+
+	exporter, err := otlptrace.New(ctx, client)
+	if err != nil {
+		return nil, fmt.Errorf("creating otlp exporter: %w", err)
+	}
+	return exporter, nil
+}
+
+func validatePort(port string) error {
+	n, err := strconv.Atoi(port)
+	if err != nil || n < 1 || n > 65535 {
+		return fmt.Errorf("invalid port %q", port)
+	}
+	return nil
+}
