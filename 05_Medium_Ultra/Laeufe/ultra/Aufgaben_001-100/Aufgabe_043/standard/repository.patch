+
+func TestNewResource(t *testing.T) {
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "")
+
+	res, err := newResource(context.Background(), "1.2.3")
+	require.NoError(t, err)
+	requireResourceAttribute(t, res.Attributes(), "service.name", "flipt")
+	requireResourceAttribute(t, res.Attributes(), "service.version", "1.2.3")
+
+	t.Setenv("OTEL_SERVICE_NAME", "environment-service")
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "service.name=attribute-service,service.version=environment-version,deployment.environment=testing,team=platform")
+
+	res, err = newResource(context.Background(), "4.5.6")
+	require.NoError(t, err)
+	requireResourceAttribute(t, res.Attributes(), "service.name", "environment-service")
+	requireResourceAttribute(t, res.Attributes(), "service.version", "4.5.6")
+	requireResourceAttribute(t, res.Attributes(), "deployment.environment", "testing")
+	requireResourceAttribute(t, res.Attributes(), "team", "platform")
+
+	t.Setenv("OTEL_SERVICE_NAME", "")
+	res, err = newResource(context.Background(), "7.8.9")
+	require.NoError(t, err)
+	requireResourceAttribute(t, res.Attributes(), "service.name", "attribute-service")
+	requireResourceAttribute(t, res.Attributes(), "service.version", "7.8.9")
+}
+
+func requireResourceAttribute(t *testing.T, attrs []attribute.KeyValue, key, want string) {
+	t.Helper()
+	for _, attr := range attrs {
+		if string(attr.Key) == key {
+			require.Equal(t, want, attr.Value.AsString(), "resource attribute %s", key)
+			return
+		}
+	}
+	t.Fatalf("missing resource attribute %s", key)
+}
+
+func TestNewProviderAlwaysSamples(t *testing.T) {
+	t.Setenv("OTEL_TRACES_SAMPLER", "always_off")
+
+	provider, err := NewProvider(context.Background(), "1.2.3")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, provider.Shutdown(context.Background())) })
+
+	_, span := provider.Tracer("test").Start(context.Background(), "operation")
+	require.True(t, span.IsRecording())
+	span.End()
+}
+
+func TestNewProviderResourceError(t *testing.T) {
+	t.Setenv("OTEL_RESOURCE_ATTRIBUTES", "missing-equals-sign")
