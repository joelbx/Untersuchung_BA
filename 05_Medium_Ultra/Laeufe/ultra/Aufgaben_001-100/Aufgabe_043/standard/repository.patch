+				Exporter: config.TracingOTLP,
+				OTLP:     config.OTLPTracingConfig{Endpoint: endpoint},
+			}
+			_, _, err := GetExporter(context.Background(), &cfg)
+			require.Error(t, err)
+			require.Contains(t, err.Error(), "otlp endpoint")
+		})
+	}
+
+	cfg := config.TracingConfig{Exporter: config.TracingExporter(99)}
+	_, _, err := GetExporter(context.Background(), &cfg)
+	require.Error(t, err)
+	require.EqualError(t, err, "unsupported tracing exporter: 99")
+
+	// A failed call must not prevent a later valid configuration from working.
+	cfg = config.TracingConfig{
+		Exporter: config.TracingZipkin,
+		Zipkin:   config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"},
+	}
+	for i := 0; i < 2; i++ {
+		exporter, shutdown, err := GetExporter(context.Background(), &cfg)
+		require.NoError(t, err)
+		require.NotNil(t, exporter)
+		require.NoError(t, shutdown(context.Background()))
+		require.NoError(t, shutdown(context.Background()))
+	}
+}
