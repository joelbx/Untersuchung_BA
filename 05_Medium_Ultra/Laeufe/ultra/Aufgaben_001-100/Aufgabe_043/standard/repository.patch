+				Jaeger:   config.JaegerTracingConfig{Host: "localhost", Port: 6831},
+			},
+		},
+		{
+			name: "Zipkin",
+			cfg: config.TracingConfig{
+				Exporter: config.TracingZipkin,
+				Zipkin:   config.ZipkinTracingConfig{Endpoint: "http://localhost:9411/api/v2/spans"},
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			exporter, shutdown, err := GetExporter(context.Background(), &tt.cfg)
+			require.NoError(t, err)
+			require.NotNil(t, exporter)
+			require.NotNil(t, shutdown)
+			require.NoError(t, shutdown(context.Background()))
+		})
+	}
+}
+
+func TestGetExporterShutdownAfterProvider(t *testing.T) {
+	cfg := config.TracingConfig{
+		Exporter: config.TracingJaeger,
+		Jaeger:   config.JaegerTracingConfig{Host: "localhost", Port: 6831},
+	}
+	exporter, shutdown, err := GetExporter(context.Background(), &cfg)
+	require.NoError(t, err)
+	provider := tracesdk.NewTracerProvider(tracesdk.WithSyncer(exporter))
+	require.NoError(t, provider.Shutdown(context.Background()))
+	require.NoError(t, shutdown(context.Background()))
+	require.NoError(t, shutdown(context.Background()))
