diff --git a/internal/ext/common.go b/internal/ext/common.go
new file mode 100644
index 0000000..b2c9452
--- /dev/null
+++ b/internal/ext/common.go
@@ -0,0 +1,49 @@
+package ext
+
+// Document is the YAML representation of a Flipt configuration.
+type Document struct {
+	Flags    []*Flag    `yaml:"flags,omitempty"`
+	Segments []*Segment `yaml:"segments,omitempty"`
+}
+
+type Flag struct {
+	Key         string     `yaml:"key,omitempty"`
+	Name        string     `yaml:"name,omitempty"`
+	Description string     `yaml:"description,omitempty"`
+	Enabled     bool       `yaml:"enabled"`
+	Variants    []*Variant `yaml:"variants,omitempty"`
+	Rules       []*Rule    `yaml:"rules,omitempty"`
+}
+
+type Variant struct {
+	Key         string      `yaml:"key,omitempty"`
+	Name        string      `yaml:"name,omitempty"`
+	Description string      `yaml:"description,omitempty"`
+	Attachment  interface{} `yaml:"attachment,omitempty"`
+}
+
+type Rule struct {
+	SegmentKey    string          `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+type Distribution struct {
+	VariantKey string  `yaml:"variant,omitempty"`
+	Rollout    float32 `yaml:"rollout,omitempty"`
+}
+
+type Segment struct {
+	Key         string        `yaml:"key,omitempty"`
+	Name        string        `yaml:"name,omitempty"`
+	Description string        `yaml:"description,omitempty"`
+	MatchType   string        `yaml:"match_type,omitempty"`
+	Constraints []*Constraint `yaml:"constraints,omitempty"`
+}
+
+type Constraint struct {
+	Type     string `yaml:"type,omitempty"`
+	Property string `yaml:"property,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+	Value    string `yaml:"value,omitempty"`
+}
diff --git a/internal/ext/exporter.go b/internal/ext/exporter.go
new file mode 100644
index 0000000..35a152d
--- /dev/null
+++ b/internal/ext/exporter.go
@@ -0,0 +1,132 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"gopkg.in/yaml.v2"
+)
+
+type lister interface {
+	ListFlags(context.Context, ...storage.QueryOption) ([]*flipt.Flag, error)
+	ListRules(context.Context, string, ...storage.QueryOption) ([]*flipt.Rule, error)
+	ListSegments(context.Context, ...storage.QueryOption) ([]*flipt.Segment, error)
+}
+
+const defaultBatchSize uint64 = 25
+
+// Exporter writes the store's flags and segments as a YAML document.
+type Exporter struct {
+	store     lister
+	batchSize uint64
+}
+
+func NewExporter(store lister) *Exporter {
+	return &Exporter{store: store, batchSize: defaultBatchSize}
+}
+
+func (e *Exporter) Export(ctx context.Context, w io.Writer) error {
+	doc := new(Document)
+	batchSize := e.batchSize
+	if batchSize == 0 {
+		batchSize = defaultBatchSize
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		flags, err := e.store.ListFlags(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting flags: %w", err)
+		}
+
+		for _, f := range flags {
+			flag := &Flag{
+				Key:         f.Key,
+				Name:        f.Name,
+				Description: f.Description,
+				Enabled:     f.Enabled,
+			}
+			variantKeys := make(map[string]string, len(f.Variants))
+
+			for _, v := range f.Variants {
+				variant := &Variant{
+					Key:         v.Key,
+					Name:        v.Name,
+					Description: v.Description,
+				}
+				if v.Attachment != "" {
+					if err := json.Unmarshal([]byte(v.Attachment), &variant.Attachment); err != nil {
+						return fmt.Errorf("decoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+					}
+				}
+				flag.Variants = append(flag.Variants, variant)
+				variantKeys[v.Id] = v.Key
+			}
+
+			rules, err := e.store.ListRules(ctx, f.Key)
+			if err != nil {
+				return fmt.Errorf("getting rules for flag %q: %w", f.Key, err)
+			}
+
+			for _, r := range rules {
+				rule := &Rule{SegmentKey: r.SegmentKey, Rank: uint(r.Rank)}
+				for _, d := range r.Distributions {
+					key, ok := variantKeys[d.VariantId]
+					if !ok {
+						return fmt.Errorf("finding variant %q for flag %q", d.VariantId, f.Key)
+					}
+					rule.Distributions = append(rule.Distributions, &Distribution{
+						VariantKey: key,
+						Rollout:    d.Rollout,
+					})
+				}
+				flag.Rules = append(flag.Rules, rule)
+			}
+			doc.Flags = append(doc.Flags, flag)
+		}
+		if uint64(len(flags)) < batchSize {
+			break
+		}
+	}
+
+	for offset := uint64(0); ; offset += batchSize {
+		segments, err := e.store.ListSegments(ctx, storage.WithOffset(offset), storage.WithLimit(batchSize))
+		if err != nil {
+			return fmt.Errorf("getting segments: %w", err)
+		}
+		for _, s := range segments {
+			segment := &Segment{
+				Key:         s.Key,
+				Name:        s.Name,
+				Description: s.Description,
+			}
+			if s.MatchType != flipt.MatchType_ALL_MATCH_TYPE {
+				segment.MatchType = s.MatchType.String()
+			}
+			for _, c := range s.Constraints {
+				segment.Constraints = append(segment.Constraints, &Constraint{
+					Type:     c.Type.String(),
+					Property: c.Property,
+					Operator: c.Operator,
+					Value:    c.Value,
+				})
+			}
+			doc.Segments = append(doc.Segments, segment)
+		}
+		if uint64(len(segments)) < batchSize {
+			break
+		}
+	}
+
+	enc := yaml.NewEncoder(w)
+	if err := enc.Encode(doc); err != nil {
+		return fmt.Errorf("exporting: %w", err)
+	}
+	if err := enc.Close(); err != nil {
+		return fmt.Errorf("closing export: %w", err)
+	}
+	return nil
+}
