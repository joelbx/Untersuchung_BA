+++ b/internal/ext/ext_test.go
@@ -0,0 +1,265 @@
+package ext
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"github.com/markphelps/flipt/storage"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+)
+
+type fixtureLister struct {
+	flags          []*flipt.Flag
+	rules          map[string][]*flipt.Rule
+	segments       []*flipt.Segment
+	flagQueries    []storage.QueryParams
+	segmentQueries []storage.QueryParams
+	ruleKeys       []string
+}
+
+func queryParams(opts []storage.QueryOption) storage.QueryParams {
+	var params storage.QueryParams
+	for _, opt := range opts {
+		opt(&params)
+	}
+	return params
+}
+
+func (s *fixtureLister) ListFlags(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Flag, error) {
+	params := queryParams(opts)
+	s.flagQueries = append(s.flagQueries, params)
+	if params.Offset >= uint64(len(s.flags)) {
+		return nil, nil
+	}
+	end := uint64(len(s.flags))
+	if params.Limit > 0 && params.Offset+params.Limit < end {
+		end = params.Offset + params.Limit
+	}
+	return s.flags[params.Offset:end], nil
+}
+
+func (s *fixtureLister) ListRules(_ context.Context, flagKey string, _ ...storage.QueryOption) ([]*flipt.Rule, error) {
+	s.ruleKeys = append(s.ruleKeys, flagKey)
+	return s.rules[flagKey], nil
+}
+
+func (s *fixtureLister) ListSegments(_ context.Context, opts ...storage.QueryOption) ([]*flipt.Segment, error) {
+	params := queryParams(opts)
+	s.segmentQueries = append(s.segmentQueries, params)
+	if params.Offset >= uint64(len(s.segments)) {
+		return nil, nil
+	}
+	end := uint64(len(s.segments))
+	if params.Limit > 0 && params.Offset+params.Limit < end {
+		end = params.Offset + params.Limit
+	}
+	return s.segments[params.Offset:end], nil
+}
+
+func TestExporterWritesNativeAttachmentsAndCompleteHierarchy(t *testing.T) {
+	store := &fixtureLister{
+		flags: []*flipt.Flag{
+			{
+				Key: "checkout", Name: "Checkout", Description: "Checkout flow", Enabled: true,
+				Variants: []*flipt.Variant{
+					{Id: "new-id", Key: "new", Name: "New flow", Description: "Enabled for selected users", Attachment: `{"active":true,"options":{"nested":{"absent":null,"target":"mobile"},"values":["alpha",17,true,null,{"child":{"score":1.5}}]},"ratio":0.25}`},
+					{Id: "old-id", Key: "old", Name: "Old flow", Attachment: `[1,"two",null]`},
+					{Id: "scalar-id", Key: "scalar", Attachment: `42`},
+					{Id: "empty-id", Key: "empty"},
+				},
+			},
+			{Key: "search", Name: "Search"},
+			{Key: "metrics", Name: "Metrics", Enabled: true},
+		},
+		rules: map[string][]*flipt.Rule{
+			"checkout": {{SegmentKey: "beta", Rank: 1, Distributions: []*flipt.Distribution{
+				{VariantId: "new-id", Rollout: 60},
+				{VariantId: "old-id", Rollout: 40},
+			}}},
+		},
+		segments: []*flipt.Segment{
+			{Key: "beta", Name: "Beta Users", Description: "Limited rollout", Constraints: []*flipt.Constraint{
+				{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "country", Operator: "eq", Value: "US"},
+				{Type: flipt.ComparisonType_STRING_COMPARISON_TYPE, Property: "tier", Operator: "neq", Value: "free"},
+			}},
+			{Key: "staff", Name: "Staff", MatchType: flipt.MatchType_ANY_MATCH_TYPE},
+			{Key: "mobile", Name: "Mobile"},
+		},
+	}
+
+	exporter := NewExporter(store)
+	exporter.batchSize = 2
+	var output bytes.Buffer
+	require.NoError(t, exporter.Export(context.Background(), &output))
+
+	wantYAML, err := os.ReadFile(filepath.Join("testdata", "export.yml"))
+	require.NoError(t, err)
+	var got, want interface{}
+	require.NoError(t, yaml.Unmarshal(output.Bytes(), &got))
+	require.NoError(t, yaml.Unmarshal(wantYAML, &want))
+	assert.Equal(t, want, got)
+	assert.Equal(t, string(wantYAML), output.String())
+	assert.Contains(t, output.String(), "attachment:\n")
+	assert.Contains(t, output.String(), "absent: null")
+	assert.NotContains(t, output.String(), `attachment: '{`)
+
+	assert.Equal(t, []storage.QueryParams{{Limit: 2, Offset: 0}, {Limit: 2, Offset: 2}}, store.flagQueries)
+	assert.Equal(t, []storage.QueryParams{{Limit: 2, Offset: 0}, {Limit: 2, Offset: 2}}, store.segmentQueries)
+	assert.Equal(t, []string{"checkout", "search", "metrics"}, store.ruleKeys)
+}
+
+type fixtureCreator struct {
+	flags         []*flipt.CreateFlagRequest
+	variants      []*flipt.CreateVariantRequest
+	segments      []*flipt.CreateSegmentRequest
+	constraints   []*flipt.CreateConstraintRequest
+	rules         []*flipt.CreateRuleRequest
+	distributions []*flipt.CreateDistributionRequest
+	events        []string
+}
+
+func (s *fixtureCreator) CreateFlag(_ context.Context, req *flipt.CreateFlagRequest) (*flipt.Flag, error) {
+	s.flags = append(s.flags, req)
+	s.events = append(s.events, "flag:"+req.Key)
+	return &flipt.Flag{Key: req.Key}, nil
+}
+
+func (s *fixtureCreator) CreateVariant(_ context.Context, req *flipt.CreateVariantRequest) (*flipt.Variant, error) {
+	s.variants = append(s.variants, req)
+	s.events = append(s.events, "variant:"+req.FlagKey+":"+req.Key)
+	return &flipt.Variant{Id: req.FlagKey + "/" + req.Key, FlagKey: req.FlagKey, Key: req.Key}, nil
+}
+
+func (s *fixtureCreator) CreateSegment(_ context.Context, req *flipt.CreateSegmentRequest) (*flipt.Segment, error) {
+	s.segments = append(s.segments, req)
+	s.events = append(s.events, "segment:"+req.Key)
+	return &flipt.Segment{Key: req.Key}, nil
+}
+
+func (s *fixtureCreator) CreateConstraint(_ context.Context, req *flipt.CreateConstraintRequest) (*flipt.Constraint, error) {
+	s.constraints = append(s.constraints, req)
+	s.events = append(s.events, "constraint:"+req.SegmentKey+":"+req.Property)
+	return &flipt.Constraint{SegmentKey: req.SegmentKey}, nil
+}
+
+func (s *fixtureCreator) CreateRule(_ context.Context, req *flipt.CreateRuleRequest) (*flipt.Rule, error) {
+	s.rules = append(s.rules, req)
+	s.events = append(s.events, "rule:"+req.FlagKey+":"+req.SegmentKey)
+	return &flipt.Rule{Id: req.FlagKey + "/" + req.SegmentKey}, nil
+}
+
+func (s *fixtureCreator) CreateDistribution(_ context.Context, req *flipt.CreateDistributionRequest) (*flipt.Distribution, error) {
+	s.distributions = append(s.distributions, req)
+	s.events = append(s.events, "distribution:"+req.VariantId)
+	return &flipt.Distribution{VariantId: req.VariantId}, nil
+}
+
+func variantRequest(t *testing.T, requests []*flipt.CreateVariantRequest, key string) *flipt.CreateVariantRequest {
+	t.Helper()
+	for _, req := range requests {
+		if req.Key == key {
+			return req
+		}
+	}
+	t.Fatalf("variant %q was not created", key)
+	return nil
+}
+
+func decodeAttachment(t *testing.T, encoded string) interface{} {
+	t.Helper()
+	var decoded interface{}
+	require.NoError(t, json.Unmarshal([]byte(encoded), &decoded))
+	return decoded
+}
+
+func TestImporterCreatesHierarchyAndEncodesNativeAttachments(t *testing.T) {
+	input, err := os.ReadFile(filepath.Join("testdata", "import.yml"))
+	require.NoError(t, err)
+	store := &fixtureCreator{}
+	require.NoError(t, NewImporter(store).Import(context.Background(), bytes.NewReader(input)))
+
+	require.Len(t, store.flags, 3)
+	require.Len(t, store.variants, 4)
+	require.Len(t, store.segments, 3)
+	require.Len(t, store.constraints, 2)
+	require.Len(t, store.rules, 1)
+	require.Len(t, store.distributions, 2)
+	assert.Equal(t, "Checkout", store.flags[0].Name)
+	assert.Equal(t, "Checkout flow", store.flags[0].Description)
+	assert.True(t, store.flags[0].Enabled)
+	assert.Equal(t, "checkout", variantRequest(t, store.variants, "new").FlagKey)
+
+	assert.Equal(t, map[string]interface{}{
+		"active": true,
+		"options": map[string]interface{}{
+			"nested": map[string]interface{}{"absent": nil, "target": "mobile"},
+			"values": []interface{}{"alpha", float64(17), true, nil, map[string]interface{}{"child": map[string]interface{}{"score": 1.5}}},
+		},
+		"ratio": 0.25,
+	}, decodeAttachment(t, variantRequest(t, store.variants, "new").Attachment))
+	assert.Equal(t, []interface{}{float64(1), "two", nil}, decodeAttachment(t, variantRequest(t, store.variants, "old").Attachment))
+	assert.Equal(t, float64(42), decodeAttachment(t, variantRequest(t, store.variants, "scalar").Attachment))
+	assert.Empty(t, variantRequest(t, store.variants, "empty").Attachment)
+
+	assert.Equal(t, "beta", store.segments[0].Key)
+	assert.Equal(t, "Limited rollout", store.segments[0].Description)
+	assert.Equal(t, flipt.MatchType_ANY_MATCH_TYPE, store.segments[1].MatchType)
+	assert.Equal(t, flipt.ComparisonType_STRING_COMPARISON_TYPE, store.constraints[0].Type)
+	assert.Equal(t, "beta", store.constraints[0].SegmentKey)
+	assert.Equal(t, "checkout", store.rules[0].FlagKey)
+	assert.Equal(t, "beta", store.rules[0].SegmentKey)
+	assert.Equal(t, int32(1), store.rules[0].Rank)
+	assert.Equal(t, "checkout/beta", store.distributions[0].RuleId)
+	assert.Equal(t, "checkout/new", store.distributions[0].VariantId)
+	assert.Equal(t, float32(60), store.distributions[0].Rollout)
+	assert.Equal(t, "checkout/old", store.distributions[1].VariantId)
+	assert.Equal(t, float32(40), store.distributions[1].Rollout)
+	assert.Less(t, eventIndex(store.events, "variant:checkout:new"), eventIndex(store.events, "distribution:checkout/new"))
+	assert.Less(t, eventIndex(store.events, "segment:beta"), eventIndex(store.events, "rule:checkout:beta"))
+}
+
+func eventIndex(events []string, want string) int {
+	for index, event := range events {
+		if event == want {
+			return index
+		}
+	}
+	return -1
+}
+
+func TestImporterAcceptsMissingAndNullAttachments(t *testing.T) {
+	input, err := os.ReadFile(filepath.Join("testdata", "import_no_attachment.yml"))
+	require.NoError(t, err)
+	store := &fixtureCreator{}
+	require.NoError(t, NewImporter(store).Import(context.Background(), strings.NewReader(string(input))))
+
+	require.Len(t, store.flags, 1)
+	require.Len(t, store.variants, 2)
+	require.Len(t, store.segments, 1)
+	require.Len(t, store.constraints, 1)
+	require.Len(t, store.rules, 1)
+	require.Len(t, store.distributions, 1)
+	assert.Empty(t, variantRequest(t, store.variants, "omitted").Attachment)
+	assert.Empty(t, variantRequest(t, store.variants, "explicit-null").Attachment)
+	assert.Equal(t, "plain/omitted", store.distributions[0].VariantId)
+}
+
+func TestConvertNormalizesNestedMapKeys(t *testing.T) {
+	input := map[interface{}]interface{}{
+		1: []interface{}{map[interface{}]interface{}{true: nil, "nested": map[interface{}]interface{}{2: "value"}}},
+	}
+	want := map[string]interface{}{
+		"1": []interface{}{map[string]interface{}{"true": nil, "nested": map[string]interface{}{"2": "value"}}},
+	}
+	assert.Equal(t, want, convert(input))
+	_, err := json.Marshal(convert(input))
+	require.NoError(t, err)
+}
diff --git a/internal/ext/importer.go b/internal/ext/importer.go
new file mode 100644
index 0000000..31def18
--- /dev/null
+++ b/internal/ext/importer.go
@@ -0,0 +1,171 @@
+package ext
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	flipt "github.com/markphelps/flipt/rpc/flipt"
+	"gopkg.in/yaml.v2"
+)
+
+type creator interface {
+	CreateFlag(context.Context, *flipt.CreateFlagRequest) (*flipt.Flag, error)
+	CreateVariant(context.Context, *flipt.CreateVariantRequest) (*flipt.Variant, error)
+	CreateSegment(context.Context, *flipt.CreateSegmentRequest) (*flipt.Segment, error)
+	CreateConstraint(context.Context, *flipt.CreateConstraintRequest) (*flipt.Constraint, error)
+	CreateRule(context.Context, *flipt.CreateRuleRequest) (*flipt.Rule, error)
+	CreateDistribution(context.Context, *flipt.CreateDistributionRequest) (*flipt.Distribution, error)
+}
+
+// Importer creates flags and segments from a YAML document.
+type Importer struct {
+	store creator
+}
+
+func NewImporter(store creator) *Importer {
+	return &Importer{store: store}
+}
+
+func (i *Importer) Import(ctx context.Context, r io.Reader) error {
+	doc := new(Document)
+	if err := yaml.NewDecoder(r).Decode(doc); err != nil {
+		return fmt.Errorf("importing: %w", err)
+	}
+
+	// Distributions refer to created variants by ID, while YAML refers to them
+	// by key. Keep IDs scoped to each flag because variant keys can repeat.
+	createdVariants := make(map[string]map[string]string, len(doc.Flags))
+
+	for _, f := range doc.Flags {
+		if f == nil {
+			return fmt.Errorf("importing flag: null flag")
+		}
+		if _, err := i.store.CreateFlag(ctx, &flipt.CreateFlagRequest{
+			Key:         f.Key,
+			Name:        f.Name,
+			Description: f.Description,
+			Enabled:     f.Enabled,
+		}); err != nil {
+			return fmt.Errorf("importing flag %q: %w", f.Key, err)
+		}
+
+		variants := make(map[string]string, len(f.Variants))
+		for _, v := range f.Variants {
+			if v == nil {
+				return fmt.Errorf("importing variant for flag %q: null variant", f.Key)
+			}
+			var attachment string
+			if v.Attachment != nil {
+				encoded, err := json.Marshal(convert(v.Attachment))
+				if err != nil {
+					return fmt.Errorf("encoding attachment for flag %q variant %q: %w", f.Key, v.Key, err)
+				}
+				attachment = string(encoded)
+			}
+			variant, err := i.store.CreateVariant(ctx, &flipt.CreateVariantRequest{
+				FlagKey:     f.Key,
+				Key:         v.Key,
+				Name:        v.Name,
+				Description: v.Description,
+				Attachment:  attachment,
+			})
+			if err != nil {
+				return fmt.Errorf("importing variant %q for flag %q: %w", v.Key, f.Key, err)
+			}
+			variants[variant.Key] = variant.Id
+		}
+		createdVariants[f.Key] = variants
+	}
+
+	// Segments must exist before the rules that reference them.
+	for _, s := range doc.Segments {
+		if s == nil {
+			return fmt.Errorf("importing segment: null segment")
+		}
+		if _, err := i.store.CreateSegment(ctx, &flipt.CreateSegmentRequest{
+			Key:         s.Key,
+			Name:        s.Name,
+			Description: s.Description,
+			MatchType:   flipt.MatchType(flipt.MatchType_value[s.MatchType]),
+		}); err != nil {
+			return fmt.Errorf("importing segment %q: %w", s.Key, err)
+		}
+		for _, c := range s.Constraints {
+			if c == nil {
+				return fmt.Errorf("importing constraint for segment %q: null constraint", s.Key)
+			}
+			if _, err := i.store.CreateConstraint(ctx, &flipt.CreateConstraintRequest{
+				SegmentKey: s.Key,
+				Type:       flipt.ComparisonType(flipt.ComparisonType_value[c.Type]),
+				Property:   c.Property,
+				Operator:   c.Operator,
+				Value:      c.Value,
+			}); err != nil {
+				return fmt.Errorf("importing constraint for segment %q: %w", s.Key, err)
+			}
+		}
+	}
+
+	for _, f := range doc.Flags {
+		for _, r := range f.Rules {
+			if r == nil {
+				return fmt.Errorf("importing rule for flag %q: null rule", f.Key)
+			}
+			rule, err := i.store.CreateRule(ctx, &flipt.CreateRuleRequest{
+				FlagKey:    f.Key,
+				SegmentKey: r.SegmentKey,
+				Rank:       int32(r.Rank),
+			})
+			if err != nil {
+				return fmt.Errorf("importing rule for flag %q: %w", f.Key, err)
+			}
+			for _, d := range r.Distributions {
+				if d == nil {
+					return fmt.Errorf("importing distribution for flag %q: null distribution", f.Key)
+				}
+				variantID, ok := createdVariants[f.Key][d.VariantKey]
+				if !ok {
+					return fmt.Errorf("finding variant %q for flag %q", d.VariantKey, f.Key)
+				}
+				if _, err := i.store.CreateDistribution(ctx, &flipt.CreateDistributionRequest{
+					FlagKey:   f.Key,
+					RuleId:    rule.Id,
+					VariantId: variantID,
+					Rollout:   d.Rollout,
+				}); err != nil {
+					return fmt.Errorf("importing distribution for flag %q: %w", f.Key, err)
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// convert changes YAML's interface-keyed maps into string-keyed maps so that
+// every nested attachment value can be encoded as JSON.
+func convert(value interface{}) interface{} {
+	switch value := value.(type) {
+	case map[interface{}]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			converted[fmt.Sprint(key)] = convert(item)
+		}
+		return converted
+	case map[string]interface{}:
+		converted := make(map[string]interface{}, len(value))
+		for key, item := range value {
+			converted[key] = convert(item)
+		}
+		return converted
+	case []interface{}:
+		converted := make([]interface{}, len(value))
+		for index, item := range value {
+			converted[index] = convert(item)
+		}
+		return converted
+	default:
+		return value
+	}
+}
