+describe('useLink failed fetch backoff', () => {
+    const abortSignal = new AbortController().signal;
+
+    beforeEach(() => {
+        jest.resetAllMocks();
+        jest.useFakeTimers();
+        mockOuterGetVerificationKey.mockResolvedValue([]);
+        mockOuterGetSharePrivateKey.mockResolvedValue('share private key');
+        // @ts-ignore
+        decryptSigned.mockImplementation(({ armoredMessage }) =>
+            Promise.resolve({ data: `dec:${armoredMessage}`, verified: 1 })
+        );
+    });
+
+    afterEach(() => {
+        jest.runOnlyPendingTimers();
+        jest.useRealTimers();
+    });
+
+    it.each([RESPONSE_CODE.NOT_FOUND, RESPONSE_CODE.NOT_ALLOWED, RESPONSE_CODE.INVALID_ID])(
+        'reuses API error %s across hook instances for the same link',
+        async (code) => {
+            const error = { data: { Code: code } };
+            mockRequst.mockRejectedValueOnce(error);
+            const firstHook = renderHook(() => useLink());
+            const secondHook = renderHook(() => useLink());
+
+            await expect(firstHook.result.current.getLink(abortSignal, `share-${code}`, 'missing-link')).rejects.toBe(
+                error
+            );
+            await expect(secondHook.result.current.getLink(abortSignal, `share-${code}`, 'missing-link')).rejects.toBe(
+                error
+            );
+            expect(mockRequst).toHaveBeenCalledTimes(1);
+        }
+    );
+
+    it('fetches another link in the same share while a failed link is cached', async () => {
+        const missingError = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        const otherError = { data: { Code: RESPONSE_CODE.INVALID_ID } };
+        const otherShareError = { data: { Code: RESPONSE_CODE.NOT_ALLOWED } };
+        mockRequst
+            .mockRejectedValueOnce(missingError)
+            .mockRejectedValueOnce(otherError)
+            .mockRejectedValueOnce(otherShareError);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'isolation-share', 'missing-link')).rejects.toBe(missingError);
+        await expect(result.current.getLink(abortSignal, 'isolation-share', 'other-link')).rejects.toBe(otherError);
+        await expect(result.current.getLink(abortSignal, 'other-share', 'missing-link')).rejects.toBe(otherShareError);
+        await expect(result.current.getLink(abortSignal, 'isolation-share', 'missing-link')).rejects.toBe(missingError);
+        expect(mockRequst).toHaveBeenCalledTimes(3);
+    });
+
+    it('retries errors outside the backoff codes', async () => {
+        const firstError = { data: { Code: RESPONSE_CODE.INVALID_REQUIREMENT } };
+        const secondError = { data: { Code: RESPONSE_CODE.INVALID_REQUIREMENT } };
+        mockRequst.mockRejectedValueOnce(firstError).mockRejectedValueOnce(secondError);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'retry-share', 'link')).rejects.toBe(firstError);
+        await expect(result.current.getLink(abortSignal, 'retry-share', 'link')).rejects.toBe(secondError);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+    });
+
+    it('fetches the failed link again after the backoff expires', async () => {
+        const firstError = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        const secondError = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequst.mockRejectedValueOnce(firstError).mockRejectedValueOnce(secondError);
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'expiry-share', 'missing-link')).rejects.toBe(firstError);
+        jest.advanceTimersByTime(29_999);
+        await expect(result.current.getLink(abortSignal, 'expiry-share', 'missing-link')).rejects.toBe(firstError);
+        expect(mockRequst).toHaveBeenCalledTimes(1);
+
+        jest.advanceTimersByTime(1);
+        await expect(result.current.getLink(abortSignal, 'expiry-share', 'missing-link')).rejects.toBe(secondError);
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+    });
+
+    it('continues to decrypt a successful link after another link fails', async () => {
+        const error = { data: { Code: RESPONSE_CODE.NOT_FOUND } };
+        mockRequst.mockRejectedValueOnce(error).mockResolvedValueOnce({
+            Link: { LinkID: 'valid-link', Name: 'valid name' },
+        });
+        const { result } = renderHook(() => useLink());
+
+        await expect(result.current.getLink(abortSignal, 'success-share', 'missing-link')).rejects.toBe(error);
+        await expect(result.current.getLink(abortSignal, 'success-share', 'valid-link')).resolves.toMatchObject({
+            linkId: 'valid-link',
+            name: 'dec:valid name',
+        });
+        expect(mockRequst).toHaveBeenCalledTimes(2);
+        expect(mockOuterLinksState.setLinks).toHaveBeenCalledWith('success-share', [
+            expect.objectContaining({
+                encrypted: expect.objectContaining({ linkId: 'valid-link' }),
+                decrypted: expect.objectContaining({ linkId: 'valid-link', name: 'dec:valid name' }),
+            }),
+        ]);
+    });
+});
