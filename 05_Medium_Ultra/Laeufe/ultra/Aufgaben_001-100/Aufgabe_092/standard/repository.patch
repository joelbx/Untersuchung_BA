+def install_from_catalog(monkeypatch, catalog, requirements, installed=(), upgrade=False,
+                         no_deps=False, allow_pre_release=False, installed_pins=None):
+    _, galaxy_server, artifacts_manager, output_path = catalog
+    installed_collections = [
+        Candidate(fqcn, version, output_path, 'dir')
+        for fqcn, version in installed
+    ]
+    monkeypatch.setattr(collection, 'find_existing_collections', lambda path, manager: installed_collections)
+    if installed_pins is None:
+        installed_pins = []
+    monkeypatch.setattr(collection, 'install', lambda candidate, path, manager: installed_pins.append(candidate))
+
+    collection.install_collections(
+        [Requirement(fqcn, constraint, None, 'galaxy') for fqcn, constraint in requirements],
+        output_path, [galaxy_server], False, no_deps, False, False,
+        allow_pre_release, artifacts_manager, upgrade=upgrade,
+    )
+    return {candidate.fqcn: candidate.ver for candidate in installed_pins}
