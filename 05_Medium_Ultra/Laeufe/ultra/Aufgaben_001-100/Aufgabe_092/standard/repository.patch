+def test_upgrade_resolver_prefers_latest_requested_version_and_keeps_dependency(collection_catalog):
+    versions, galaxy_server, artifacts_manager, output_path = collection_catalog
+    versions.update({
+        'namespace.parent': {
+            '1.0.0': {'namespace.dependency': '>=1.0.0'},
+            '2.0.0': {'namespace.dependency': '>=1.0.0'},
+        },
+        'namespace.dependency': {'1.0.0': {}, '2.0.0': {}},
+    })
+    requirement = Requirement('namespace.parent', '*', None, 'galaxy')
+    preferred = {
+        Candidate('namespace.parent', '1.0.0', output_path, 'dir'),
+        Candidate('namespace.dependency', '1.0.0', output_path, 'dir'),
+    }
+
+    resolved = collection._resolve_depenency_map(
+        [requirement], [galaxy_server], artifacts_manager, preferred,
+        False, False, upgrade=True,
+    )
+
+    assert resolved['namespace.parent'].ver == '2.0.0'
+    assert resolved['namespace.dependency'].ver == '1.0.0'
