diff --git a/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
new file mode 100644
index 0000000..072821d
--- /dev/null
+++ b/test/integration/targets/ansible-galaxy-collection/tasks/upgrade.yml
@@ -0,0 +1,160 @@
+---
+- name: create separate collection path for upgrade tests
+  file:
+    path: '{{ upgrade_collection_path }}'
+    state: directory
+
+- name: install older collection and dependency versions
+  command: >-
+    ansible-galaxy collection install
+    upgrade_parent.top:1.0.0 namespace1.name1:1.0.0
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+
+- name: confirm initial collection versions
+  slurp:
+    path: '{{ upgrade_collection_path }}/{{ item }}/MANIFEST.json'
+  register: upgrade_initial_manifests
+  loop:
+    - upgrade_parent/top
+    - upgrade_middle/middle
+    - upgrade_leaf/leaf
+    - namespace1/name1
+
+- name: assert initial collection versions
+  assert:
+    that:
+      - (upgrade_initial_manifests.results[0].content | b64decode | from_json).collection_info.version == '1.0.0'
+      - (upgrade_initial_manifests.results[1].content | b64decode | from_json).collection_info.version == '1.0.0'
+      - (upgrade_initial_manifests.results[2].content | b64decode | from_json).collection_info.version == '1.0.0'
+      - (upgrade_initial_manifests.results[3].content | b64decode | from_json).collection_info.version == '1.0.0'
+
+- name: install existing collections without upgrade
+  command: >-
+    ansible-galaxy collection install upgrade_parent.top namespace1.name1
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+  register: upgrade_without_flag
+
+- name: assert existing collections were left in place
+  assert:
+    that:
+      - '"Nothing to do. All requested collections are already installed" in upgrade_without_flag.stdout'
+
+- name: reject upgrade when no-deps leaves an incompatible installed dependency
+  command: >-
+    ansible-galaxy collection install --upgrade --no-deps upgrade_parent.top
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+  register: upgrade_no_deps
+  failed_when: false
+
+- name: read collection versions after rejected no-deps upgrade
+  slurp:
+    path: '{{ upgrade_collection_path }}/{{ item }}/MANIFEST.json'
+  register: upgrade_no_deps_manifests
+  loop:
+    - upgrade_parent/top
+    - upgrade_middle/middle
+    - upgrade_leaf/leaf
+
+- name: assert no-deps upgrade did not change collections
+  assert:
+    that:
+      - upgrade_no_deps.rc != 0
+      - '"Installing ''upgrade_parent.top:1.1.0'' to" not in upgrade_no_deps.stdout'
+      - (upgrade_no_deps_manifests.results[0].content | b64decode | from_json).collection_info.version == '1.0.0'
+      - (upgrade_no_deps_manifests.results[1].content | b64decode | from_json).collection_info.version == '1.0.0'
+      - (upgrade_no_deps_manifests.results[2].content | b64decode | from_json).collection_info.version == '1.0.0'
+
+- name: create upgrade requirements file
+  copy:
+    dest: '{{ galaxy_dir }}/upgrade/requirements.yml'
+    content: |
+      collections:
+        - name: upgrade_parent.top
+          version: '>=1.0.0,<2.0.0'
+        - name: namespace1.name1
+          version: '>=1.0.0,<1.1.0'
+
+- name: upgrade every collection in the requirements file
+  command: >-
+    ansible-galaxy collection install --upgrade
+    -r {{ (galaxy_dir + '/upgrade/requirements.yml') | quote }}
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+  register: upgrade_requirements
+
+- name: read upgraded collection manifests
+  slurp:
+    path: '{{ upgrade_collection_path }}/{{ item }}/MANIFEST.json'
+  register: upgrade_manifests
+  loop:
+    - upgrade_parent/top
+    - upgrade_middle/middle
+    - upgrade_leaf/leaf
+    - namespace1/name1
+
+- name: assert requirements and transitive dependencies were upgraded
+  assert:
+    that:
+      - (upgrade_manifests.results[0].content | b64decode | from_json).collection_info.version == '1.1.0'
+      - (upgrade_manifests.results[1].content | b64decode | from_json).collection_info.version == '1.1.0'
+      - (upgrade_manifests.results[2].content | b64decode | from_json).collection_info.version == '1.1.0'
+      - (upgrade_manifests.results[3].content | b64decode | from_json).collection_info.version == '1.0.9'
+      - '"Installing ''upgrade_parent.top:1.1.0'' to" in upgrade_requirements.stdout'
+      - '"Installing ''namespace1.name1:1.0.9'' to" in upgrade_requirements.stdout'
+
+- name: repeat upgrade with the same requirements
+  command: >-
+    ansible-galaxy collection install --upgrade
+    -r {{ (galaxy_dir + '/upgrade/requirements.yml') | quote }}
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+  register: upgrade_repeat
+
+- name: assert upgrade is idempotent
+  assert:
+    that:
+      - '"Installing ''" not in upgrade_repeat.stdout'
+
+- name: upgrade alias respects a tighter version constraint
+  command: >-
+    ansible-galaxy collection install -U namespace1.name1:<1.0.9
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+  register: upgrade_constrained
+
+- name: read constrained collection version
+  slurp:
+    path: '{{ upgrade_collection_path }}/namespace1/name1/MANIFEST.json'
+  register: upgrade_constrained_manifest
+
+- name: assert upgrade selected newest permitted version
+  assert:
+    that:
+      - (upgrade_constrained_manifest.content | b64decode | from_json).collection_info.version == '1.0.0'
+
+- name: upgrade without pre-release opt-in
+  command: >-
+    ansible-galaxy collection install --upgrade namespace1.name1
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+
+- name: read stable collection version
+  slurp:
+    path: '{{ upgrade_collection_path }}/namespace1/name1/MANIFEST.json'
+  register: upgrade_stable_manifest
+
+- name: assert default upgrade selected stable release
+  assert:
+    that:
+      - (upgrade_stable_manifest.content | b64decode | from_json).collection_info.version == '1.0.9'
+
+- name: upgrade with pre-release opt-in
+  command: >-
+    ansible-galaxy collection install --upgrade --pre namespace1.name1
+    -s galaxy_ng -p {{ upgrade_collection_path | quote }}
+
+- name: read pre-release collection version
+  slurp:
+    path: '{{ upgrade_collection_path }}/namespace1/name1/MANIFEST.json'
+  register: upgrade_pre_manifest
+
+- name: assert pre-release was selected when requested
+  assert:
+    that:
+      - (upgrade_pre_manifest.content | b64decode | from_json).collection_info.version == '1.1.0-beta.1'
