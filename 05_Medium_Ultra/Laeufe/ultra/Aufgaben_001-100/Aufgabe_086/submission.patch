+    def test_destination_ports_append_rule(self):
+        """A port list and range are passed to one multiport rule."""
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'destination_ports': [80, '443', '8081:8083'],
+            'jump': 'ACCEPT',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.side_effect = [(1, '', ''), (0, '', '')]
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_count, 2)
+        check_command = run_command.call_args_list[0][0][0]
+        append_command = run_command.call_args_list[1][0][0]
+        self.assertEqual(check_command[:5], ['/sbin/iptables', '-t', 'filter', '-C', 'INPUT'])
+        self.assertEqual(append_command[:5], ['/sbin/iptables', '-t', 'filter', '-A', 'INPUT'])
+        self.assertEqual(check_command[5:], append_command[5:])
+        self.assertEqual(check_command.count('--dports'), 1)
+        multiport_index = check_command.index('-m')
+        self.assertEqual(check_command[multiport_index:multiport_index + 4], [
+            '-m', 'multiport', '--dports', '80,443,8081:8083',
+        ])
+
+    def test_destination_ports_supported_protocols(self):
+        """The multiport option works with each supported transport protocol."""
+        for protocol in ('tcp', 'udp', 'udplite', 'dccp', 'sctp'):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': protocol,
+                'destination_ports': ['80', '443'],
+            })
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            command = run_command.call_args[0][0]
+            self.assertEqual(command[command.index('-p') + 1], protocol)
+            multiport_index = command.index('-m')
+            self.assertEqual(command[multiport_index:multiport_index + 4], [
+                '-m', 'multiport', '--dports', '80,443',
+            ])
+
+    def test_destination_ports_with_explicit_multiport_match(self):
+        """An explicit multiport match is not added a second time."""
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'match': ['multiport'],
+            'destination_ports': ['80', '443'],
+        })
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = (0, '', '')
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        command = run_command.call_args[0][0]
+        self.assertEqual(command.count('multiport'), 1)
+        self.assertEqual(command[command.index('--dports') + 1], '80,443')
+
+    def test_destination_ports_rejects_unsupported_protocols(self):
+        """A nonempty port list requires a multiport-compatible protocol."""
+        for protocol in (None, 'icmp', 'all'):
+            args = {'chain': 'INPUT', 'destination_ports': ['80']}
+            if protocol is not None:
+                args['protocol'] = protocol
+            set_module_args(args)
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson) as result:
+                    iptables.main()
+
+            self.assertIn('destination_ports', result.exception.args[0]['msg'])
+            run_command.assert_not_called()
+
+    def test_empty_destination_ports_has_no_multiport_match(self):
+        """Omitted and empty port lists leave rules without multiport."""
+        for args in (
+            {'chain': 'INPUT', 'protocol': 'icmp'},
+            {'chain': 'INPUT', 'protocol': 'icmp', 'destination_ports': []},
+        ):
+            set_module_args(args)
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = (0, '', '')
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            command = run_command.call_args[0][0]
+            self.assertNotIn('multiport', command)
+            self.assertNotIn('--dports', command)
+
