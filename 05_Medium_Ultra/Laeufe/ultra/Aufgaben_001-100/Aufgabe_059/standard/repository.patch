+import { createRef } from 'react';
+
+import { fireEvent, render } from '@testing-library/react';
+
+import Dialog from './Dialog';
+
+describe('Dialog', () => {
+    it('keeps children accessible and forwards props and the ref in JSDOM', () => {
+        const ref = createRef<HTMLDialogElement>();
+        const onClick = jest.fn();
+        const { container, getByRole } = render(
+            <Dialog
+                open
+                ref={ref}
+                aria-label="Example dialog"
+                data-state="ready"
+                className="custom-dialog"
+                tabIndex={-1}
+                onClick={onClick}
+            >
+                <button type="button">Hello</button>
+            </Dialog>
+        );
+
+        const host = container.firstElementChild;
+        expect(host).toHaveAttribute('aria-label', 'Example dialog');
+        expect(host).toHaveAttribute('data-state', 'ready');
+        expect(host).toHaveClass('custom-dialog');
+        expect(host).toHaveAttribute('tabindex', '-1');
+        expect(host).not.toHaveAttribute('hidden');
+        expect(ref.current).toBe(host);
+
+        const button = getByRole('button', { name: 'Hello' });
+        expect(button).toBeVisible();
+        expect(getByRole('dialog', { name: 'Example dialog' })).toBe(host);
+        fireEvent.click(button);
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+
+    it('uses a native dialog and forwards its ref when native operations are available', () => {
+        const prototype = HTMLDialogElement.prototype;
+        const methods = ['showModal', 'show', 'close'] as const;
+        const descriptors = methods.map((method) => Object.getOwnPropertyDescriptor(prototype, method));
+
+        methods.forEach((method) => {
+            Object.defineProperty(prototype, method, { configurable: true, value: jest.fn() });
+        });
+
+        try {
+            const ref = createRef<HTMLDialogElement>();
+            const { container, getByRole } = render(
+                <Dialog open ref={ref} aria-label="Native dialog" data-state="open">
+                    <button type="button">Continue</button>
+                </Dialog>
+            );
+
+            const host = container.firstElementChild;
+            expect(host).toBeInstanceOf(HTMLDialogElement);
+            expect(host).toHaveAttribute('open');
+            expect(host).toHaveAttribute('aria-label', 'Native dialog');
+            expect(host).toHaveAttribute('data-state', 'open');
+            expect(ref.current).toBe(host);
+            expect(getByRole('button', { name: 'Continue' })).toBeVisible();
+        } finally {
+            methods.forEach((method, index) => {
+                const descriptor = descriptors[index];
+                if (descriptor) {
+                    Object.defineProperty(prototype, method, descriptor);
+                } else {
+                    Reflect.deleteProperty(prototype, method);
+                }
+            });
+        }
+    });
+});
