+def test_unflatten_last_assignment_wins_for_parent_and_child_keys():
+    class RepeatedItems:
+        def items(self):
+            return [('name', 'first'), ('name', 'second')]
+
+    assert utils.unflatten(RepeatedItems()) == {'name': 'second'}
+    assert utils.unflatten({'seeds--0': 'first', 'seeds': []}) == {'seeds': []}
+    assert utils.unflatten({'seeds': 'first', 'seeds--0': 'second'}) == {
+        'seeds': ['second']
+    }
+    assert utils.unflatten({'seeds--0': 'first', 'seeds--0--key': 'second'}) == {
+        'seeds': [{'key': 'second'}]
+    }
+
+
