@@ -1,6 +1,14 @@
+from types import SimpleNamespace
+
+import web
+
 from openlibrary.plugins.openlibrary import lists
 
 
+def _unexpected_query(**defaults):
+    raise AssertionError('The query string should not be read for a form body')
+
+
 def test_process_seeds():
     process_seeds = lists.lists_json().process_seeds
 
@@ -11,3 +19,104 @@ def test_process_seeds():
     assert f({"key": "/books/OL1M"}) == {"key": "/books/OL1M"}
     assert f("/subjects/love") == "subject:love"
     assert f("subject:love") == "subject:love"
+
+
+def test_list_record_from_post_body_ignores_query_and_uses_first_values(monkeypatch):
+    unflattened_inputs = []
+    original_unflatten = lists.utils.unflatten
+
+    def capture_unflatten(values):
+        unflattened_inputs.append(values)
+        return original_unflatten(values)
+
+    monkeypatch.setattr(lists.utils, 'unflatten', capture_unflatten)
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'name=Body+name&name=Later+name&description=Body+description&'
+        b'seeds--0--key=%2Fbooks%2FOL1M',
+    )
+
+    monkeypatch.setattr(web, 'input', _unexpected_query)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.key is None
+    assert record.name == 'Body name'
+    assert record.description == 'Body description'
+    assert record.seeds == [{'key': '/books/OL1M'}]
+    assert 'seeds' not in unflattened_inputs[0]
+
+
+def test_list_record_from_blank_indexed_seed(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'name=My+list&seeds--0--key=')
+    monkeypatch.setattr(web, 'input', _unexpected_query)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.name == 'My list'
+    assert record.seeds == []
+
+
+def test_list_record_from_post_body_ignores_invalid_indexed_seeds(monkeypatch):
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'name=My+list&seeds--0=invalid&seeds--1--other=invalid&'
+        b'seeds--2--key=+&seeds--3--key=&seeds--4--key=%2Fbooks%2FOL2M',
+    )
+    monkeypatch.setattr(web, 'input', _unexpected_query)
+
+    record = lists.ListRecord.from_input()
+
+    assert record.seeds == [{'key': '/books/OL2M'}]
+
+
+def test_list_record_from_query_when_body_is_empty(monkeypatch):
+    monkeypatch.setattr(web, 'data', lambda: b'')
+    captured_defaults = {}
+
+    def query_input(**defaults):
+        captured_defaults.update(defaults)
+        return web.storage({**defaults, 'name': 'Query name', 'seeds': ['/books/OL3M']})
+
+    monkeypatch.setattr(web, 'input', query_input)
+
+    record = lists.ListRecord.from_input()
+
+    assert captured_defaults == {
+        'key': None,
+        'name': '',
+        'description': '',
+        'seeds': [],
+    }
+    assert record == lists.ListRecord(name='Query name', seeds=[{'key': '/books/OL3M'}])
+
+
+def test_lists_add_post_uses_body_fields_when_query_conflicts(monkeypatch):
+    saved = []
+    site = SimpleNamespace(
+        can_write=lambda key: True,
+        seq=SimpleNamespace(next_value=lambda name: 1),
+        save=lambda value, **kwargs: saved.append(value),
+    )
+    monkeypatch.setattr(web.ctx, 'site', site, raising=False)
+    monkeypatch.setattr(
+        web,
+        'data',
+        lambda: b'name=Body+name&seeds--0--key=%2Fbooks%2FOL4M',
+    )
+    monkeypatch.setattr(
+        web,
+        'input',
+        lambda **defaults: web.storage(
+            {**defaults, 'name': 'Query name', 'seeds': ['/books/OL99M']}
+        ),
+    )
+    monkeypatch.setattr(lists, 'safe_seeother', lambda key: key)
+
+    result = lists.lists_add().POST('/people/alice')
+
+    assert result == '/people/alice/lists/OL1L'
+    assert saved[0]['name'] == 'Body name'
+    assert saved[0]['seeds'] == [{'key': '/books/OL4M'}]
