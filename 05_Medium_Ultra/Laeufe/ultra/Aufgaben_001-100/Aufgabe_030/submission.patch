+# along with Ansible.  If not, see <http://www.gnu.org/licenses/>.
+
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from ansible.module_utils.facts.hardware import aix
+
+
+def _aix_hardware(mocker, processor_devices, smt_output):
+    module = mocker.Mock()
+    command_output = {
+        '/usr/sbin/lsdev -Cc processor': processor_devices,
+        '/usr/sbin/lsattr -El proc0 -a type': 'type PowerPC_POWER7 Processor type False\n',
+        '/usr/sbin/lsattr -El proc0 -a smt_threads': smt_output,
+    }
+    module.run_command.side_effect = lambda command: (0, command_output[command], '')
+    return aix.AIXHardware(module)
+
+
+def test_get_cpu_facts_with_smt(mocker):
+    devices = '\n'.join('proc%d Available 00-00 Processor' % i for i in range(12))
+    devices += '\nproc12 Defined 00-00 Processor\n'
+    hardware = _aix_hardware(mocker, devices, 'smt_threads 4 Number of SMT threads True\n')
+
+    assert hardware.get_cpu_facts() == {
+        'processor': ['PowerPC_POWER7'],
+        'processor_count': 1,
+        'processor_cores': 12,
+        'processor_threads_per_core': 4,
+        'processor_vcpus': 48,
+    }
+
+
+def test_get_cpu_facts_defaults_to_one_thread_per_core(mocker):
+    devices = 'proc0 Available 00-00 Processor\nproc1 Available 00-00 Processor\n'
+    hardware = _aix_hardware(mocker, devices, '')
+
+    assert hardware.get_cpu_facts() == {
+        'processor': ['PowerPC_POWER7'],
+        'processor_count': 1,
+        'processor_cores': 2,
+        'processor_threads_per_core': 1,
+        'processor_vcpus': 2,
+    }
