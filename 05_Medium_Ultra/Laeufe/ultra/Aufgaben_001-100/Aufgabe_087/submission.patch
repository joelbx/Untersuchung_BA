new file mode 100644
index 0000000..fad32e8
--- /dev/null
+++ b/internal/info/flipt.go
@@ -0,0 +1,31 @@
+package info
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// Flipt describes the running Flipt build and its update status.
+type Flipt struct {
+	Version         string `json:"version,omitempty"`
+	LatestVersion   string `json:"latestVersion,omitempty"`
+	Commit          string `json:"commit,omitempty"`
+	BuildDate       string `json:"buildDate,omitempty"`
+	GoVersion       string `json:"goVersion,omitempty"`
+	UpdateAvailable bool   `json:"updateAvailable"`
+	IsRelease       bool   `json:"isRelease"`
+}
+
+// ServeHTTP writes the build information as JSON.
+func (i Flipt) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	out, err := json.Marshal(i)
+	if err != nil {
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	if _, err := w.Write(out); err != nil {
+		w.WriteHeader(http.StatusInternalServerError)
+	}
+}
diff --git a/internal/info/flipt_test.go b/internal/info/flipt_test.go
new file mode 100644
index 0000000..e75f96c
--- /dev/null
+++ b/internal/info/flipt_test.go
@@ -0,0 +1,50 @@
+package info
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestFliptServeHTTP(t *testing.T) {
+	info := Flipt{
+		Version:         "1.2.3",
+		Commit:          "abc123",
+		IsRelease:       true,
+		UpdateAvailable: false,
+	}
+
+	w := httptest.NewRecorder()
+	info.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+
+	if w.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", w.Code, http.StatusOK)
+	}
+	if got := w.Header().Get("Content-Type"); got != "application/json" {
+		t.Errorf("Content-Type = %q, want application/json", got)
+	}
+	for _, part := range []string{`"version":"1.2.3"`, `"commit":"abc123"`, `"isRelease":true`, `"updateAvailable":false`} {
+		if !strings.Contains(w.Body.String(), part) {
+			t.Errorf("body %q does not contain %q", w.Body.String(), part)
+		}
+	}
+}
+
+type failingWriter struct {
+	header http.Header
+	status int
+}
+
+func (w *failingWriter) Header() http.Header       { return w.header }
+func (w *failingWriter) WriteHeader(status int)    { w.status = status }
+func (w *failingWriter) Write([]byte) (int, error) { return 0, errors.New("write failed") }
+
+func TestFliptServeHTTPWriteError(t *testing.T) {
+	w := &failingWriter{header: make(http.Header)}
+	(Flipt{}).ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/meta/info", nil))
+	if w.status != http.StatusInternalServerError {
+		t.Fatalf("status = %d, want %d", w.status, http.StatusInternalServerError)
+	}
+}
diff --git a/telemetry/telemetry.go b/telemetry/telemetry.go
new file mode 100644
index 0000000..de226ec
--- /dev/null
+++ b/telemetry/telemetry.go
@@ -0,0 +1,282 @@
+// Package telemetry sends anonymous installation pings when enabled.
+package telemetry
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid"
+	"github.com/markphelps/flipt/config"
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	schemaVersion  = "1.0"
+	stateFileName  = "telemetry.json"
+	reportInterval = 4 * time.Hour
+	// The collector accepts Segment-style track events without host metadata.
+	defaultEndpoint = "https://telemetry.flipt.io/v1/track"
+)
+
+// FliptVersion is set by the executable from its build version before it
+// creates a reporter. Reporters keep a copy of its value at construction.
+var FliptVersion = "dev"
+
+var stateInitMu sync.Mutex
+
+type state struct {
+	Version       string `json:"version"`
+	UUID          string `json:"uuid"`
+	LastTimestamp string `json:"lastTimestamp"`
+}
+
+type trackEvent struct {
+	AnonymousID string `json:"anonymousId"`
+	Event       string `json:"event"`
+	Properties  struct {
+		UUID    string `json:"uuid"`
+		Version string `json:"version"`
+		Flipt   struct {
+			Version string `json:"version"`
+		} `json:"flipt"`
+	} `json:"properties"`
+}
+
+// Reporter persists a stable anonymous ID and sends usage pings.
+type Reporter struct {
+	mu           sync.Mutex
+	state        state
+	statePath    string
+	fliptVersion string
+	endpoint     string
+	client       *http.Client
+	logger       logrus.FieldLogger
+	now          func() time.Time
+}
+
+// NewReporter returns nil without touching the filesystem when telemetry is
+// disabled. Initialization errors can be logged by the caller and ignored.
+func NewReporter(cfg *config.Config, logger logrus.FieldLogger) (*Reporter, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("telemetry: nil configuration")
+	}
+	if !cfg.Meta.TelemetryEnabled {
+		return nil, nil
+	}
+	if logger == nil {
+		logger = logrus.StandardLogger()
+	}
+	stateInitMu.Lock()
+	defer stateInitMu.Unlock()
+
+	dir := cfg.Meta.StateDirectory
+	if dir == "" {
+		var err error
+		dir, err = os.UserConfigDir()
+		if err != nil {
+			return nil, fmt.Errorf("telemetry: finding user configuration directory: %w", err)
+		}
+	}
+
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, fmt.Errorf("telemetry: creating state directory: %w", err)
+	}
+
+	info, err := os.Stat(dir)
+	if err != nil {
+		return nil, fmt.Errorf("telemetry: checking state directory: %w", err)
+	}
+	if !info.IsDir() {
+		return nil, fmt.Errorf("telemetry: state path %q is not a directory", dir)
+	}
+
+	r := &Reporter{
+		statePath:    filepath.Join(dir, stateFileName),
+		fliptVersion: FliptVersion,
+		endpoint:     defaultEndpoint,
+		client: &http.Client{
+			Timeout: 10 * time.Second,
+			CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+				return http.ErrUseLastResponse
+			},
+		},
+		logger: logger,
+		now:    time.Now,
+	}
+
+	for {
+		r.state = state{}
+		data, err := os.ReadFile(r.statePath)
+		missing := os.IsNotExist(err)
+		if err != nil && !missing {
+			return nil, fmt.Errorf("telemetry: reading state: %w", err)
+		}
+		if !missing {
+			if err := json.Unmarshal(data, &r.state); err != nil {
+				logger.Warnf("telemetry: malformed state file (%v); generating a new anonymous ID", err)
+				r.state = state{}
+			}
+		}
+
+		changed := false
+		parsedID, err := uuid.FromString(r.state.UUID)
+		if err != nil || parsedID == uuid.Nil {
+			parsedID, err = uuid.NewV4()
+			if err != nil {
+				return nil, fmt.Errorf("telemetry: generating anonymous ID: %w", err)
+			}
+			r.state.UUID = parsedID.String()
+			changed = true
+		}
+
+		if r.state.Version != schemaVersion {
+			r.state.Version = schemaVersion
+			changed = true
+		}
+		if _, err := time.Parse(time.RFC3339, r.state.LastTimestamp); err != nil {
+			r.state.LastTimestamp = time.Time{}.UTC().Format(time.RFC3339)
+			changed = true
+		}
+		if changed {
+			if err := r.writeState(missing); os.IsExist(err) && missing {
+				// Another process created the state first. Use its ID instead.
+				continue
+			} else if err != nil {
+				return nil, err
+			}
+		}
+		return r, nil
+	}
+}
+
+// Start reports when the last successful ping is due, then every four hours.
+// It runs until ctx is canceled and logs report failures without affecting the
+// application.
+func (r *Reporter) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+
+	r.mu.Lock()
+	last, _ := time.Parse(time.RFC3339, r.state.LastTimestamp)
+	r.mu.Unlock()
+
+	next := last.Add(reportInterval)
+	for {
+		if err := ctx.Err(); err != nil {
+			return
+		}
+
+		now := r.now()
+		if next.After(now.Add(reportInterval)) {
+			next = now.Add(reportInterval)
+		}
+		if delay := next.Sub(now); delay > 0 {
+			timer := time.NewTimer(delay)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+
+		if err := r.Report(ctx); err != nil && ctx.Err() == nil {
+			r.logger.Warnf("telemetry: sending ping: %v", err)
+		}
+		next = r.now().Add(reportInterval)
+	}
+}
+
+// Report sends one anonymous flipt.ping event and saves the time only after
+// the collector confirms the request succeeded.
+func (r *Reporter) Report(ctx context.Context) error {
+	if r == nil {
+		return nil
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+
+	event := trackEvent{AnonymousID: r.state.UUID, Event: "flipt.ping"}
+	event.Properties.UUID = r.state.UUID
+	event.Properties.Version = r.state.Version
+	event.Properties.Flipt.Version = r.fliptVersion
+
+	body, err := json.Marshal(event)
+	if err != nil {
+		return fmt.Errorf("telemetry: encoding ping: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.endpoint, bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("telemetry: preparing ping: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("telemetry: sending ping: %w", err)
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
+		return fmt.Errorf("telemetry: collector returned HTTP %d", resp.StatusCode)
+	}
+
+	r.state.LastTimestamp = r.now().UTC().Format(time.RFC3339)
+	return r.writeState(false)
+}
+
+func (r *Reporter) writeState(createOnly bool) error {
+	data, err := json.MarshalIndent(r.state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("telemetry: encoding state: %w", err)
+	}
+	data = append(data, '\n')
+
+	f, err := os.CreateTemp(filepath.Dir(r.statePath), ".telemetry-*.tmp")
+	if err != nil {
+		return fmt.Errorf("telemetry: creating state file: %w", err)
+	}
+	defer os.Remove(f.Name())
+
+	if err := f.Chmod(0600); err != nil {
+		_ = f.Close()
+		return fmt.Errorf("telemetry: setting state permissions: %w", err)
+	}
+	if _, err := f.Write(data); err != nil {
+		_ = f.Close()
+		return fmt.Errorf("telemetry: writing state: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		return fmt.Errorf("telemetry: closing state file: %w", err)
+	}
+	if createOnly {
+		// Linking publishes the complete file without replacing another
+		// process's freshly created state.
+		if err := os.Link(f.Name(), r.statePath); err == nil {
+			return nil
+		} else if os.IsExist(err) {
+			return err
+		}
+		// Some filesystems do not support links. Retain the ordinary atomic
+		// rename behavior there.
+	}
+	if err := os.Rename(f.Name(), r.statePath); err != nil {
+		return fmt.Errorf("telemetry: replacing state file: %w", err)
+	}
+	return nil
+}
