+func TestStartReportsWhenDueAndStopsOnCancellation(t *testing.T) {
+	reporter, err := NewReporter(testConfig(t.TempDir()), logrus.New())
+	require.NoError(t, err)
+	received := make(chan struct{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		received <- struct{}{}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	reporter.endpoint = server.URL
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		reporter.Start(ctx)
+		close(done)
+	}()
+
+	select {
+	case <-received:
+	case <-time.After(5 * time.Second):
+		t.Fatal("telemetry was not reported when due")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("telemetry loop did not stop")
+	}
+}
