+func TestNewReporterCreatesAndReusesState(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "nested", "state")
+	cfg := testConfig(dir)
+
+	reporter, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	require.NotNil(t, reporter)
+	saved := readState(t, dir)
+	require.Equal(t, schemaVersion, saved.Version)
+	_, err = uuid.FromString(saved.UUID)
+	require.NoError(t, err)
+	_, err = time.Parse(time.RFC3339, saved.LastTimestamp)
+	require.NoError(t, err)
+
+	again, err := NewReporter(cfg, logrus.New())
+	require.NoError(t, err)
+	require.Equal(t, saved, again.state)
+	require.Equal(t, saved, readState(t, dir))
+}
