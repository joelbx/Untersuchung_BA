+func TestNewReporterConcurrentInitializationUsesOneUUID(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "state")
+	cfg := testConfig(dir)
+	const count = 10
+	reporters := make([]*Reporter, count)
+	errors := make([]error, count)
+	var wg sync.WaitGroup
+	for i := range reporters {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			reporters[i], errors[i] = NewReporter(cfg, logrus.New())
+		}(i)
+	}
+	wg.Wait()
+	want := readState(t, dir).UUID
+	for i := range reporters {
+		require.NoError(t, errors[i])
+		require.Equal(t, want, reporters[i].state.UUID)
+	}
+}
