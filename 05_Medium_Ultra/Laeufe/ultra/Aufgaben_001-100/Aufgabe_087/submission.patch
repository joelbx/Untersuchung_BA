+func TestReportSendsAnonymousEventAndUpdatesTimestamp(t *testing.T) {
+	dir := t.TempDir()
+	reporter, err := NewReporter(testConfig(dir), logrus.New())
+	require.NoError(t, err)
+	reporter.fliptVersion = "1.2.3"
+	now := time.Date(2022, 4, 6, 5, 1, 51, 0, time.UTC)
+	reporter.now = func() time.Time { return now }
+
+	var received trackEvent
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.Header.Get("Content-Type") != "application/json" {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if err := json.NewDecoder(r.Body).Decode(&received); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer server.Close()
+	reporter.endpoint = server.URL
+
+	require.NoError(t, reporter.Report(context.Background()))
+	require.Equal(t, "flipt.ping", received.Event)
+	require.Equal(t, reporter.state.UUID, received.AnonymousID)
+	require.Equal(t, received.AnonymousID, received.Properties.UUID)
+	require.Equal(t, schemaVersion, received.Properties.Version)
+	require.Equal(t, "1.2.3", received.Properties.Flipt.Version)
+	require.Equal(t, now.Format(time.RFC3339), readState(t, dir).LastTimestamp)
+}
