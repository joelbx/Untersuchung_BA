+class TestBooknotesUpdateWorkID:
+
+    @classmethod
+    def setup_class(cls):
+        web.config.db_parameters = dict(dbn="sqlite", db=":memory:")
+        get_db().query("""
+        CREATE TABLE booknotes (
+            username text NOT NULL,
+            work_id integer NOT NULL,
+            edition_id integer NOT NULL DEFAULT -1,
+            notes text NOT NULL,
+            PRIMARY KEY (username, work_id, edition_id)
+        );
+        """)
+
+    def setup_method(self):
+        self.db = get_db()
+        assert not list(self.db.select("booknotes"))
+
+    def teardown_method(self):
+        self.db.query("DELETE FROM booknotes")
+
+    def all_notes(self):
+        return list(self.db.select(
+            "booknotes", order="username, work_id, edition_id"
+        ))
+
+    def test_collision_preserves_every_note(self):
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source note")
+        self.db.insert("booknotes", username="reader", work_id=2,
+                       edition_id=-1, notes="target note")
+        self.db.insert("booknotes", username="other", work_id=1,
+                       edition_id=3, notes="another source note")
+        original_notes = self.all_notes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1
+        }
+        assert self.all_notes() == original_notes
+
+    def test_existing_target_preserves_nonconflicting_notes(self):
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source note")
+        self.db.insert("booknotes", username="other", work_id=2,
+                       edition_id=-1, notes="target note")
+        original_notes = self.all_notes()
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 0, "rows_deleted": 0, "failed_deletes": 1
+        }
+        assert self.all_notes() == original_notes
+
+    def test_update_without_conflict(self):
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source note")
+
+        result = Booknotes.update_work_id(1, 2)
+
+        assert result == {
+            "rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert self.all_notes() == [{
+            "username": "reader", "work_id": 2,
+            "edition_id": -1, "notes": "source note"
+        }]
+
+    def test_preview_rolls_back_update(self):
+        self.db.insert("booknotes", username="reader", work_id=1,
+                       edition_id=-1, notes="source note")
+        original_notes = self.all_notes()
+
+        result = Booknotes.update_work_id(1, 2, _test=True)
+
+        assert result == {
+            "rows_changed": 1, "rows_deleted": 0, "failed_deletes": 0
+        }
+        assert self.all_notes() == original_notes
