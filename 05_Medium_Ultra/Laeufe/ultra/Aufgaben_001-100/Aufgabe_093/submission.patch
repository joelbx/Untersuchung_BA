@@ -0,0 +1,65 @@
+import { act, renderHook } from '@testing-library/react-hooks';
+
+import usePopper from './usePopper';
+
+const makeRect = (x: number, y: number, width: number, height: number): DOMRect => ({
+    x,
+    y,
+    width,
+    height,
+    top: y,
+    right: x + width,
+    bottom: y + height,
+    left: x,
+    toJSON: () => ({}),
+});
+
+describe('usePopper RTL placement', () => {
+    test('reports the visual alignment of an RTL floating element', async () => {
+        const reference = document.createElement('button');
+        const floating = document.createElement('div');
+        const originalClientWidth = Object.getOwnPropertyDescriptor(document.documentElement, 'clientWidth');
+        const originalClientHeight = Object.getOwnPropertyDescriptor(document.documentElement, 'clientHeight');
+        floating.style.direction = 'rtl';
+        Object.defineProperty(document.documentElement, 'clientWidth', { configurable: true, value: 1024 });
+        Object.defineProperty(document.documentElement, 'clientHeight', { configurable: true, value: 768 });
+        reference.getBoundingClientRect = () => makeRect(100, 100, 40, 20);
+        floating.getBoundingClientRect = () => makeRect(100, 120, 50, 30);
+        Object.defineProperty(floating, 'offsetWidth', { value: 50 });
+        Object.defineProperty(floating, 'offsetHeight', { value: 30 });
+        document.body.append(reference, floating);
+
+        try {
+            const { result, unmount, waitFor } = renderHook(() =>
+                usePopper({
+                    isOpen: true,
+                    originalPlacement: 'bottom-start',
+                    availablePlacements: ['bottom-start'],
+                    reference: { mode: 'element', value: reference },
+                    offset: 0,
+                })
+            );
+
+            try {
+                act(() => result.current.floating?.(floating));
+                await waitFor(() => expect(result.current.placement).toBe('bottom-end'));
+            } finally {
+                unmount();
+            }
+        } finally {
+            reference.remove();
+            floating.remove();
+
+            if (originalClientWidth) {
+                Object.defineProperty(document.documentElement, 'clientWidth', originalClientWidth);
+            } else {
+                delete (document.documentElement as unknown as { clientWidth?: number }).clientWidth;
+            }
+            if (originalClientHeight) {
+                Object.defineProperty(document.documentElement, 'clientHeight', originalClientHeight);
+            } else {
+                delete (document.documentElement as unknown as { clientHeight?: number }).clientHeight;
+            }
+        }
+    });
+});
