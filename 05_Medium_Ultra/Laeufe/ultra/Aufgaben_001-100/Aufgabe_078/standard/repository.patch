+import React from "react";
+import { act, render } from "@testing-library/react";
+import { mocked } from "jest-mock";
+import { MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import { useVoiceBroadcastPlayback } from "../../../src/voice-broadcast/hooks/useVoiceBroadcastPlayback";
+import {
+    VoiceBroadcastInfoState,
+    VoiceBroadcastPlayback,
+    VoiceBroadcastPlaybackEvent,
+} from "../../../src/voice-broadcast";
+import { flushPromises, stubClient } from "../../test-utils";
+import { mkVoiceBroadcastInfoStateEvent } from "../utils/test-utils";
+
+describe("useVoiceBroadcastPlayback", () => {
+    let client: MatrixClient;
+    let playback: VoiceBroadcastPlayback;
+
+    beforeEach(async () => {
+        client = stubClient();
+        mocked(client.relations).mockResolvedValue({ events: [] });
+        playback = new VoiceBroadcastPlayback(
+            mkVoiceBroadcastInfoStateEvent(
+                "!room:example.com",
+                VoiceBroadcastInfoState.Started,
+                "@user:example.com",
+                client.getDeviceId(),
+            ),
+            client,
+        );
+        await flushPromises();
+    });
+
+    afterEach(() => {
+        playback.destroy();
+    });
+
+    it("initializes liveness and updates it when playback emits a change", () => {
+        jest.spyOn(playback, "getLiveness").mockReturnValue("grey");
+
+        const Probe = (): JSX.Element => {
+            const { liveness } = useVoiceBroadcastPlayback(playback);
+            return <span data-testid="liveness">{ liveness }</span>;
+        };
+
+        const result = render(<Probe />);
+        expect(result.getByTestId("liveness")).toHaveTextContent("grey");
+
+        act(() => {
+            playback.emit(VoiceBroadcastPlaybackEvent.LivenessChanged, "live");
+        });
+        expect(result.getByTestId("liveness")).toHaveTextContent("live");
+    });
+});
