diff --git a/config/syslog/syslogconf.go b/config/syslog/syslogconf.go
new file mode 100644
index 0000000..50f5c00
--- /dev/null
+++ b/config/syslog/syslogconf.go
@@ -0,0 +1,120 @@
+//go:build !windows
+
+package syslog
+
+import (
+	"errors"
+	stdsyslog "log/syslog"
+
+	"github.com/asaskevich/govalidator"
+	"golang.org/x/xerrors"
+)
+
+// Validate validates the syslog configuration.
+func (c *Conf) Validate() (errs []error) {
+	if !c.Enabled {
+		return nil
+	}
+	// If protocol is empty, it will connect to the local syslog server.
+	if len(c.Protocol) > 0 && c.Protocol != "tcp" && c.Protocol != "udp" {
+		errs = append(errs, errors.New(`syslog.protocol must be "tcp" or "udp"`))
+	}
+
+	// Default port: 514
+	if c.Port == "" {
+		c.Port = "514"
+	}
+
+	if _, err := c.GetSeverity(); err != nil {
+		errs = append(errs, err)
+	}
+
+	if _, err := c.GetFacility(); err != nil {
+		errs = append(errs, err)
+	}
+
+	if _, err := govalidator.ValidateStruct(c); err != nil {
+		errs = append(errs, err)
+	}
+	return errs
+}
+
+// GetSeverity gets severity.
+func (c *Conf) GetSeverity() (stdsyslog.Priority, error) {
+	if c.Severity == "" {
+		return stdsyslog.LOG_INFO, nil
+	}
+
+	switch c.Severity {
+	case "emerg":
+		return stdsyslog.LOG_EMERG, nil
+	case "alert":
+		return stdsyslog.LOG_ALERT, nil
+	case "crit":
+		return stdsyslog.LOG_CRIT, nil
+	case "err":
+		return stdsyslog.LOG_ERR, nil
+	case "warning":
+		return stdsyslog.LOG_WARNING, nil
+	case "notice":
+		return stdsyslog.LOG_NOTICE, nil
+	case "info":
+		return stdsyslog.LOG_INFO, nil
+	case "debug":
+		return stdsyslog.LOG_DEBUG, nil
+	default:
+		return -1, xerrors.Errorf("Invalid severity: %s", c.Severity)
+	}
+}
+
+// GetFacility gets facility.
+func (c *Conf) GetFacility() (stdsyslog.Priority, error) {
+	if c.Facility == "" {
+		return stdsyslog.LOG_AUTH, nil
+	}
+
+	switch c.Facility {
+	case "kern":
+		return stdsyslog.LOG_KERN, nil
+	case "user":
+		return stdsyslog.LOG_USER, nil
+	case "mail":
+		return stdsyslog.LOG_MAIL, nil
+	case "daemon":
+		return stdsyslog.LOG_DAEMON, nil
+	case "auth":
+		return stdsyslog.LOG_AUTH, nil
+	case "syslog":
+		return stdsyslog.LOG_SYSLOG, nil
+	case "lpr":
+		return stdsyslog.LOG_LPR, nil
+	case "news":
+		return stdsyslog.LOG_NEWS, nil
+	case "uucp":
+		return stdsyslog.LOG_UUCP, nil
+	case "cron":
+		return stdsyslog.LOG_CRON, nil
+	case "authpriv":
+		return stdsyslog.LOG_AUTHPRIV, nil
+	case "ftp":
+		return stdsyslog.LOG_FTP, nil
+	case "local0":
+		return stdsyslog.LOG_LOCAL0, nil
+	case "local1":
+		return stdsyslog.LOG_LOCAL1, nil
+	case "local2":
+		return stdsyslog.LOG_LOCAL2, nil
+	case "local3":
+		return stdsyslog.LOG_LOCAL3, nil
+	case "local4":
+		return stdsyslog.LOG_LOCAL4, nil
+	case "local5":
+		return stdsyslog.LOG_LOCAL5, nil
+	case "local6":
+		return stdsyslog.LOG_LOCAL6, nil
+	case "local7":
+		return stdsyslog.LOG_LOCAL7, nil
+	default:
+		return -1, xerrors.Errorf("Invalid facility: %s", c.Facility)
+	}
+}
diff --git a/config/syslog/syslogconf_test.go b/config/syslog/syslogconf_test.go
new file mode 100644
index 0000000..52b97bd
--- /dev/null
+++ b/config/syslog/syslogconf_test.go
@@ -0,0 +1,52 @@
+//go:build !windows
+
+package syslog
+
+import "testing"
+
+func TestConfValidate(t *testing.T) {
+	tests := []struct {
+		name       string
+		conf       Conf
+		wantErrors int
+	}{
+		{name: "disabled ignores invalid values", conf: Conf{Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}},
+		{name: "defaults", conf: Conf{Enabled: true}},
+		{name: "tcp", conf: Conf{Enabled: true, Protocol: "tcp", Host: "localhost", Port: "5140"}},
+		{name: "udp", conf: Conf{Enabled: true, Protocol: "udp", Port: "12345", Severity: "emerg", Facility: "user"}},
+		{name: "invalid protocol", conf: Conf{Enabled: true, Protocol: "bad"}, wantErrors: 1},
+		{name: "invalid port", conf: Conf{Enabled: true, Port: "-1"}, wantErrors: 1},
+		{name: "invalid severity", conf: Conf{Enabled: true, Severity: "bad"}, wantErrors: 1},
+		{name: "invalid facility", conf: Conf{Enabled: true, Facility: "bad"}, wantErrors: 1},
+		{name: "all invalid core fields", conf: Conf{Enabled: true, Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}, wantErrors: 4},
+		{name: "invalid host", conf: Conf{Enabled: true, Host: "bad host"}, wantErrors: 1},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if errs := tt.conf.Validate(); len(errs) != tt.wantErrors {
+				t.Fatalf("Validate() returned %d errors, want %d: %v", len(errs), tt.wantErrors, errs)
+			}
+		})
+	}
+}
+
+func TestConfValidateStandardPriorities(t *testing.T) {
+	severities := []string{"emerg", "alert", "crit", "err", "warning", "notice", "info", "debug"}
+	for _, severity := range severities {
+		t.Run("severity/"+severity, func(t *testing.T) {
+			if errs := (&Conf{Enabled: true, Severity: severity}).Validate(); len(errs) != 0 {
+				t.Fatalf("Validate() returned errors for severity %q: %v", severity, errs)
+			}
+		})
+	}
+
+	facilities := []string{"kern", "user", "mail", "daemon", "auth", "syslog", "lpr", "news", "uucp", "cron", "authpriv", "ftp", "local0", "local1", "local2", "local3", "local4", "local5", "local6", "local7"}
+	for _, facility := range facilities {
+		t.Run("facility/"+facility, func(t *testing.T) {
+			if errs := (&Conf{Enabled: true, Facility: facility}).Validate(); len(errs) != 0 {
+				t.Fatalf("Validate() returned errors for facility %q: %v", facility, errs)
+			}
+		})
+	}
+}
