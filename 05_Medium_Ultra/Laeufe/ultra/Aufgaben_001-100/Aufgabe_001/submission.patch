--- /dev/null
+++ b/config/syslog/syslogconf_windows_test.go
@@ -0,0 +1,21 @@
+//go:build windows
+
+package syslog
+
+import "testing"
+
+func TestConfValidateWindows(t *testing.T) {
+	if errs := (&Conf{Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}).Validate(); errs != nil {
+		t.Fatalf("disabled syslog returned errors: %v", errs)
+	}
+
+	errs := (&Conf{Enabled: true}).Validate()
+	if len(errs) != 1 || errs[0].Error() != "windows not support syslog" {
+		t.Fatalf("enabled syslog returned %v, want one Windows support error", errs)
+	}
+
+	errs = (&Conf{Enabled: true, Protocol: "bad", Port: "bad", Severity: "bad", Facility: "bad"}).Validate()
+	if len(errs) != 1 || errs[0].Error() != "windows not support syslog" {
+		t.Fatalf("invalid enabled syslog returned %v, want one Windows support error", errs)
+	}
+}
