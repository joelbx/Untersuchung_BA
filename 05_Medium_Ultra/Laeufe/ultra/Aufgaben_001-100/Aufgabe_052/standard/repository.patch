+func TestChat_TokenCountAcrossSteps(t *testing.T) {
+	t.Parallel()
+
+	firstCompletion := `{"action":"Missing Tool","action_input":"try again"}`
+	secondCompletion := `{"action":"Command Execution","action_input":{"command":"df -h","nodes":["localhost"]}}`
+	responses := make(chan string, 2)
+	responses <- generateSingleChunkResponse(firstCompletion)
+	responses <- generateSingleChunkResponse(secondCompletion)
+	requests := make(chan []openai.ChatCompletionMessage, 2)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		var request openai.ChatCompletionRequest
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		var response string
+		select {
+		case response = <-responses:
+		default:
+			http.Error(w, "unexpected request", http.StatusBadRequest)
+			return
+		}
+		requests <- request.Messages
+		_, _ = w.Write([]byte(response))
+	}))
+	defer server.Close()
+
+	cfg := openai.DefaultConfig("secret-test-token")
+	cfg.BaseURL = server.URL + "/v1"
+	chat := NewClientFromConfig(cfg).NewChat(nil, "Bob")
+	chat.Insert(openai.ChatMessageRoleUser, "Show disk space")
+
+	response, count, err := chat.Complete(context.Background(), "localhost", func(*model.AgentAction) {})
+	require.NoError(t, err)
+	require.IsType(t, &model.CompletionCommand{}, response)
+	require.NotNil(t, count)
+
+	firstPrompt := <-requests
+	secondPrompt := <-requests
+	require.Greater(t, len(secondPrompt), len(firstPrompt))
+	firstPromptCount, err := model.NewPromptTokenCounter(firstPrompt)
+	require.NoError(t, err)
+	secondPromptCount, err := model.NewPromptTokenCounter(secondPrompt)
+	require.NoError(t, err)
+	firstCompletionCount, err := model.NewSynchronousTokenCounter(firstCompletion)
+	require.NoError(t, err)
+	secondCompletionCount, err := model.NewSynchronousTokenCounter(secondCompletion)
+	require.NoError(t, err)
+
+	prompt, completion := count.CountAll()
+	require.Equal(t, firstPromptCount.TokenCount()+secondPromptCount.TokenCount(), prompt)
+	require.Equal(t, firstCompletionCount.TokenCount()+secondCompletionCount.TokenCount(), completion)
+}
+
+func generateSingleChunkResponse(content string) string {
+	delta, err := json.Marshal(struct {
+		Content string `json:"content"`
+		Role    string `json:"role"`
+	}{Content: content, Role: "assistant"})
+	if err != nil {
+		panic(err)
+	}
+	return fmt.Sprintf("data: {\"id\":\"1\",\"object\":\"completion\",\"created\":1598069254,\"model\":\"gpt-4\",\"choices\":[{\"index\":0,\"delta\":%s}]}\n\ndata: [DONE]\n\n", delta)
+}
