+// streamingCompletionCounter reports the partial stream while it is open and
+// the exact tokenized completion once the last part has been sent.
+type streamingCompletionCounter struct {
+	mu      sync.RWMutex
+	partial *AsynchronousTokenCounter
+	final   *StaticTokenCounter
+}
+
+func (counter *streamingCompletionCounter) TokenCount() int {
+	counter.mu.RLock()
+	final := counter.final
+	counter.mu.RUnlock()
+	if final != nil {
+		return final.TokenCount()
+	}
+	return counter.partial.TokenCount()
+}
+
+func (counter *streamingCompletionCounter) finish(completion string) {
+	final, err := NewSynchronousTokenCounter(completion)
+	if err != nil {
+		log.WithError(err).Trace("could not count streamed completion")
+		return
+	}
+	counter.mu.Lock()
+	counter.final = final
+	counter.mu.Unlock()
 }
 
