+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package model
+
+import (
+	"errors"
+	"sync"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// TokenCounter reports the number of tokens counted for one prompt or completion.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll returns the sum of the counters in the collection.
+func (counters TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range counters {
+		if counter != nil {
+			total += counter.TokenCount()
+		}
+	}
+	return total
+}
+
+// TokenCount collects prompt and completion usage for an agent invocation.
+type TokenCount struct {
+	mu         sync.RWMutex
+	prompt     TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount creates an empty token count.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{}
+}
+
+// AddPromptCounter adds a prompt counter. A nil counter is ignored.
+func (count *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt == nil {
+		return
+	}
+	count.mu.Lock()
+	defer count.mu.Unlock()
+	count.prompt = append(count.prompt, prompt)
+}
+
+// AddCompletionCounter adds a completion counter. A nil counter is ignored.
+func (count *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion == nil {
+		return
+	}
+	count.mu.Lock()
+	defer count.mu.Unlock()
+	count.completion = append(count.completion, completion)
+}
+
+// CountAll returns the prompt total followed by the completion total.
+func (count *TokenCount) CountAll() (int, int) {
+	if count == nil {
+		return 0, 0
+	}
+	count.mu.RLock()
+	prompt := append(TokenCounters(nil), count.prompt...)
+	completion := append(TokenCounters(nil), count.completion...)
+	count.mu.RUnlock()
+	return prompt.CountAll(), completion.CountAll()
+}
+
+// StaticTokenCounter stores a fixed number of tokens.
+type StaticTokenCounter struct {
+	count int
+}
+
+// TokenCount returns the fixed token count.
+func (counter *StaticTokenCounter) TokenCount() int {
+	if counter == nil {
+		return 0
+	}
+	return counter.count
+}
+
+// NewPromptTokenCounter counts prompt tokens using cl100k_base.
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	tokenizer := codec.NewCl100kBase()
+	var total int
+	for _, message := range messages {
+		tokens, _, err := tokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		total += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: total}, nil
+}
+
+// NewSynchronousTokenCounter counts a completed response using cl100k_base.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter tracks tokens emitted after a streamed response starts.
+// It is safe to use concurrently with a stream producer.
+type AsynchronousTokenCounter struct {
+	mu       sync.Mutex
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter counts the starting fragment using cl100k_base.
+func NewAsynchronousTokenCounter(start string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := codec.NewCl100kBase().Encode(start)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add records one streamed token. It fails after TokenCount has been called.
+func (counter *AsynchronousTokenCounter) Add() error {
+	if counter == nil {
+		return errors.New("cannot add to a nil token counter")
+	}
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	if counter.finished {
+		return errors.New("cannot add to a finished token counter")
+	}
+	counter.count++
+	return nil
+}
+
+// TokenCount finalizes the counter and returns the completion total.
+// Repeated calls return the same total.
+func (counter *AsynchronousTokenCounter) TokenCount() int {
+	if counter == nil {
+		return 0
+	}
+	counter.mu.Lock()
+	defer counter.mu.Unlock()
+	counter.finished = true
+	return perRequest + counter.count
+}
