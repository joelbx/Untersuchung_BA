+
+func (s *RolesTestSuite) TestEqualsSetSemantics(c *check.C) {
+	tests := []struct {
+		name  string
+		left  teleport.Roles
+		right teleport.Roles
+		equal bool
+	}{
+		{"nil and empty", nil, teleport.Roles{}, true},
+		{"duplicate and single", teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}, teleport.Roles{teleport.RoleAuth}, true},
+		{"same distinct roles in different order", teleport.Roles{teleport.RoleAuth, teleport.RoleNode, teleport.RoleAuth}, teleport.Roles{teleport.RoleNode, teleport.RoleAuth}, true},
+		{"duplicate conceals missing role", teleport.Roles{teleport.RoleAuth, teleport.RoleAuth}, teleport.Roles{teleport.RoleAuth, teleport.RoleAdmin}, false},
+		{"extra distinct role", teleport.Roles{teleport.RoleAuth, teleport.RoleAdmin}, teleport.Roles{teleport.RoleAuth}, false},
+		{"different roles", teleport.Roles{teleport.RoleAuth}, teleport.Roles{teleport.RoleNode}, false},
+	}
+	for _, test := range tests {
+		c.Assert(test.left.Equals(test.right), check.Equals, test.equal, check.Commentf("%s: left to right", test.name))
+		c.Assert(test.right.Equals(test.left), check.Equals, test.equal, check.Commentf("%s: right to left", test.name))
+	}
+}
