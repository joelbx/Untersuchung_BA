+def test_get_ia_record_normalizes_mixed_publishers_and_isbns() -> None:
+    metadata = {
+        "title": "Mixed metadata",
+        "creator": "Alice;Bob",
+        "language": "eng",
+        "publisher": [
+            "  New York : Simon & Schuster  ",
+            " Penguin Books ",
+            "London: Faber & Faber",
+            "  ",
+        ],
+        "isbn": [" 978-1-4516-5468-4 ", "145 165 4685", "short", "  "],
+    }
+
+    result = code.ia_importapi.get_ia_record(metadata)
+
+    assert result["authors"] == [{"name": "Alice"}, {"name": "Bob"}]
+    assert result["languages"] == ["eng"]
+    assert result["publishers"] == [
+        "Simon & Schuster",
+        "Penguin Books",
+        "Faber & Faber",
+    ]
+    assert result["publish_places"] == ["New York", "London"]
+    assert result["isbn_10"] == ["1451654685"]
+    assert result["isbn_13"] == ["9781451654684"]
+    assert "publisher" not in result
+    assert "isbn" not in result
+
+
+def test_get_ia_record_normalizes_string_isbn() -> None:
+    result = code.ia_importapi.get_ia_record(
+        {"title": "A book", "isbn": " 978-1-4516-5468-4 "}
+    )
+
+    assert result["isbn_13"] == ["9781451654684"]
+    assert "isbn_10" not in result
+    assert "isbn" not in result
+
+
+@pytest.mark.parametrize(
+    "metadata",
+    [
+        {},
+        {"publisher": "", "isbn": ""},
+        {"publisher": "   ", "isbn": "   "},
+        {"publisher": [], "isbn": []},
+        {"publisher": ["", "  "], "isbn": ["", "  ", "short"]},
+    ],
+)
+def test_get_ia_record_omits_empty_bibliographic_fields(metadata: dict) -> None:
+    result = code.ia_importapi.get_ia_record(metadata)
+
+    for field in ("publisher", "publishers", "publish_places", "isbn", "isbn_10", "isbn_13"):
+        assert field not in result
+
