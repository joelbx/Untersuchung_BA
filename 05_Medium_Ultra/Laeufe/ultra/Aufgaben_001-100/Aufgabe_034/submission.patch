+def get_isbn_10_and_13(isbns: str | list[str]) -> tuple[list[str], list[str]]:
+    """Separate IA ISBNs by length after removing spaces and hyphens.
+
+    ISBN-10 may end in X; values that do not have an ISBN shape are ignored.
+    The order of the supplied values is preserved.
+    """
+    isbn_10 = []
+    isbn_13 = []
+    values = [isbns] if isinstance(isbns, str) else isbns or []
+    for isbn in values:
+        if not isinstance(isbn, str):
+            continue
+        isbn = re.sub(r'[\s-]+', '', isbn).upper()
+        if len(isbn) == 10 and re.fullmatch(r'[0-9]{9}[0-9X]', isbn):
+            isbn_10.append(isbn)
+        elif len(isbn) == 13 and re.fullmatch(r'[0-9]{13}', isbn):
+            isbn_13.append(isbn)
+    return isbn_10, isbn_13
+
+
+def get_publisher_and_place(
+    publishers: str | list[str],
+) -> tuple[list[str], list[str]]:
+    """Split IA publisher entries into publisher names and publication places."""
+    publisher_names = []
+    publish_places = []
+    values = [publishers] if isinstance(publishers, str) else publishers or []
+    for entry in values:
+        if not isinstance(entry, str):
+            continue
+        entry = re.sub(r'\s+', ' ', entry).strip()
+        if not entry:
+            continue
+        place, separator, publisher = entry.partition(':')
+        if separator:
+            publisher = publisher.strip()
+            if not publisher:
+                continue
+            if place := place.strip():
+                publish_places.append(place)
+            publisher_names.append(publisher)
+        else:
+            publisher_names.append(entry)
+    return publisher_names, publish_places
+
