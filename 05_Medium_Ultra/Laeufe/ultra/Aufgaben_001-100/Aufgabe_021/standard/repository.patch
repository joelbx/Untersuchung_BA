+def make_list(seeds):
+    models.register_models()
+    list_model.register_models()
+    site = MockSite()
+    lst = site.quicksave(
+        '/people/alice/lists/OL1L', '/type/list', name='Favorites', seeds=seeds
+    )
+    return site, lst
+
+
+def test_list_seed_membership_uses_keys_for_all_formats():
+    site, lst = make_list([])
+    edition = site.quicksave('/books/OL1M', '/type/edition', title='A book')
+    lst.seeds = [{'key': edition.key}, 'subject:love']
+
+    assert not lst.add_seed(edition)
+    assert not lst.add_seed({'key': edition.key})
+    assert not lst.add_seed('subject:love')
+    assert lst.has_seed(edition)
+    assert lst.has_seed({'key': edition.key})
+
+    assert lst.remove_seed(edition)
+    assert not lst.has_seed({'key': edition.key})
+    assert lst.add_seed(edition)
+    assert lst.seeds[-1] == {'key': edition.key}
+    assert lst.remove_seed('subject:love')
+    assert not lst.has_seed('subject:love')
+    assert not lst.remove_seed('subject:love')
+
+
+def test_get_seeds_wraps_subjects_and_loaded_things(monkeypatch):
+    site, lst = make_list([])
+    edition = site.quicksave('/books/OL1M', '/type/edition', title='A book')
+    lst.seeds = [{'key': edition.key}, 'subject:love']
+    subject = models.Subject(key='/subjects/love', name='Love', work_count=1)
+    monkeypatch.setattr(list_model, 'get_subject', lambda key: subject)
+
+    seeds = lst.get_seeds()
+
+    assert [seed.key for seed in seeds] == [edition.key, 'subject:love']
+    assert isinstance(seeds[0].value, models.Thing)
+    assert seeds[1].document is subject
+    assert seeds[1].url == '/subjects/love'
+    assert seeds[1].get_subject_url('subject:stoic') == '/subjects/stoic'
+    assert seeds[1].get_subject_url('place:new_york') == '/subjects/place:new_york'
+
+
+def test_get_export_list_has_all_groups_and_filters_loaded_types():
+    site, lst = make_list([])
+    edition = site.quicksave('/books/OL1M', '/type/edition', title='A book')
+    work = site.quicksave('/works/OL1W', '/type/work', title='A work')
+    author = site.quicksave('/authors/OL1A', '/type/author', name='An author')
+    site.quicksave('/books/OL2M', '/type/work', title='Wrong type')
+    lst.seeds = [
+        {'key': edition.key},
+        work,
+        {'key': author.key},
+        'subject:love',
+        {'key': '/books/OL2M'},
+        {'key': '/books/missing'},
+    ]
+
+    assert lst.get_export_list() == {
+        'authors': [author.dict()],
+        'works': [work.dict()],
+        'editions': [edition.dict()],
+    }
+
+    legacy_work = site.quicksave('/legacy/OL1W', '/type/work', title='Old key')
+    lst.seeds = [legacy_work]
+    assert lst.get_export_list()['works'] == [work.dict()]
+
+    lst.seeds = ['subject:love']
+    assert lst.get_export_list() == {'authors': [], 'works': [], 'editions': []}
+
+    lst.seeds = [edition, 'subject:love']
+    assert [doc.key for doc in lst.get_editions()['editions']] == [edition.key]
+    assert lst.get_all_editions() == [edition.dict()]
