+		assert.True(t, valid, "operator %s should be valid for strings", operator)
+		_, valid = NumberOperators[operator]
+		assert.True(t, valid, "operator %s should be valid for numbers", operator)
+		_, valid = BooleanOperators[operator]
+		assert.False(t, valid, "operator %s should be invalid for booleans", operator)
+	}
