+		{name: "isoneof excludes absent number", operator: flipt.OpIsOneOf, list: `[1,2.5,-3]`, value: "4"},
+		{name: "isnotoneof matches absent number", operator: flipt.OpIsNotOneOf, list: `[1,2.5,-3]`, value: "4", wantMatch: true},
+		{name: "isnotoneof excludes present number", operator: flipt.OpIsNotOneOf, list: `[1,2.5,-3]`, value: "-3"},
+		{name: "isoneof rejects malformed JSON", operator: flipt.OpIsOneOf, list: `[1,`, value: "1", wantErr: true},
+		{name: "isnotoneof rejects malformed JSON", operator: flipt.OpIsNotOneOf, list: `[1,`, value: "1", wantErr: true},
+		{name: "isoneof rejects non-numeric element", operator: flipt.OpIsOneOf, list: `[1,"2"]`, value: "1", wantErr: true},
+		{name: "isnotoneof rejects non-numeric element", operator: flipt.OpIsNotOneOf, list: `[1,"2"]`, value: "1", wantErr: true},
+		{name: "isoneof rejects null element", operator: flipt.OpIsOneOf, list: `[null]`, value: "0", wantErr: true},
+		{name: "isnotoneof rejects null element", operator: flipt.OpIsNotOneOf, list: `[null]`, value: "0", wantErr: true},
+		{name: "isoneof rejects invalid context number", operator: flipt.OpIsOneOf, list: `[1,2]`, value: "oops", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			constraint := storage.EvaluationConstraint{Property: "foo", Operator: tt.operator, Value: tt.list}
+			match, err := matchesNumber(constraint, tt.value)
+			if tt.wantErr {
+				assert.False(t, match)
+				var invalid ferrors.ErrInvalid
+				assert.ErrorAs(t, err, &invalid)
+				return
+			}
+			assert.NoError(t, err)
+			assert.Equal(t, tt.wantMatch, match)
+		})
+	}
+}
