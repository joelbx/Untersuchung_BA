+			name:      "unsupported regexp function",
+			pattern:   `{{regexp.replace("foo")}}`,
+			wantError: "unsupported function regexp.replace, supported functions are: regexp.match, regexp.not_match.",
+		},
+		{
+			name:      "unsupported email function",
+			pattern:   `{{email.domain("foo")}}`,
+			wantError: "unsupported function email.domain, supported functions are: email.local",
+		},
+		{
+			name:      "invalid regexp match",
+			pattern:   `{{regexp.match("[")}}`,
+			wantError: fmt.Sprintf("failed parsing regexp %q: %v", "[", regexpErr),
+		},
+		{
+			name:      "invalid regexp not match",
+			pattern:   `{{regexp.not_match("[")}}`,
+			wantError: fmt.Sprintf("failed parsing regexp %q: %v", "[", regexpErr),
+		},
+		{
+			name:     "no arguments",
+			pattern:  `{{regexp.match()}}`,
+			contains: "argument",
+		},
+		{
+			name:     "two arguments",
+			pattern:  `{{regexp.match("foo", "bar")}}`,
+			contains: "argument",
+		},
