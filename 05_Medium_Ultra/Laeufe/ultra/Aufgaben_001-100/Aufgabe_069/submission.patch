+		},
+		{
+			name:      "missing opening brackets",
+			pattern:   `foo-regexp.match("bar")}}`,
+			wantError: `"foo-regexp.match(\"bar\")}}" is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}`,
+		},
+		{
+			name:      "unsupported namespace",
+			pattern:   `{{other.match("foo")}}`,
+			wantError: "unsupported function namespace other, supported namespaces are email and regexp",
+		},
