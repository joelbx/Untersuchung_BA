+// containsMatcherFunctionInTemplates checks each complete template separately
+// so Variable rejects matcher calls even when the input has multiple templates.
+func containsMatcherFunctionInTemplates(value string) bool {
+	for start := 0; start < len(value); {
+		open := strings.Index(value[start:], "{{")
+		if open == -1 {
+			return false
+		}
+		open += start
+		close, nested := findTemplateClose(value, open+2)
+		if close == -1 {
+			return false
+		}
+		expr, err := parser.ParseExpr(value[open+2 : close])
+		if err == nil && containsMatcherFunction(expr) {
+			return true
+		}
+		if nested {
+			start = open + 2
+		} else {
+			start = close + 2
+		}
+	}
+	return false
+}
+
+func containsMatcherFunction(expr ast.Expr) bool {
+	found := false
+	ast.Inspect(expr, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		namespace, ok := selector.X.(*ast.Ident)
+		if ok && namespace.Name == RegexpNamespace &&
+			(selector.Sel.Name == RegexpMatchFnName || selector.Sel.Name == RegexpNotMatchFnName) {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
