+// Matcher tests whether a string satisfies a match expression.
+type Matcher interface {
+	Match(in string) bool
+}
+
+type regexpMatcher struct {
+	re *regexp.Regexp
+}
+
+// Match reports whether in matches the compiled regular expression.
+func (m regexpMatcher) Match(in string) bool {
+	return m.re.MatchString(in)
+}
+
+type prefixSuffixMatcher struct {
+	prefix  string
+	suffix  string
+	matcher Matcher
+}
+
+// Match checks the static text around an expression before matching its content.
+func (m prefixSuffixMatcher) Match(in string) bool {
+	if len(in) < len(m.prefix)+len(m.suffix) || !strings.HasPrefix(in, m.prefix) || !strings.HasSuffix(in, m.suffix) {
+		return false
+	}
+	return m.matcher.Match(in[len(m.prefix) : len(in)-len(m.suffix)])
+}
+
+type notMatcher struct {
+	matcher Matcher
+}
+
+// Match reports the inverse of the inner matcher's result.
+func (m notMatcher) Match(in string) bool {
+	return !m.matcher.Match(in)
+}
+
+// Match parses a literal, glob, raw regular expression, or matcher template.
+// Globs and literals must match the entire input. A raw regular expression
+// starts with ^ and ends with $, while regexp.match uses regexp.MatchString
+// semantics and can match a substring.
+func Match(value string) (Matcher, error) {
+	prefix, expression, suffix, templated, err := splitMatcherTemplate(value)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if !templated {
+		pattern := value
+		if !strings.HasPrefix(value, "^") || !strings.HasSuffix(value, "$") {
+			pattern = "^" + utils.GlobToRegexp(value) + "$"
+		}
+		re, err := regexp.Compile(pattern)
+		if err != nil {
+			return nil, trace.BadParameter("failed parsing regexp %q: %v", value, err)
+		}
+		return regexpMatcher{re: re}, nil
+	}
+
+	expr, err := parser.ParseExpr(expression)
+	if err != nil {
+		return nil, invalidMatcherExpression(expression)
+	}
+	// Operators and grouped or nested expressions cannot form a single matcher.
+	switch expr.(type) {
+	case *ast.CallExpr, *ast.SelectorExpr, *ast.IndexExpr, *ast.Ident, *ast.BasicLit:
+	default:
+		return nil, invalidMatcherExpression(expression)
+	}
+	result, err := walk(expr)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if len(result.parts) != 0 || result.transform != nil || result.matcher == nil {
+		return nil, invalidMatcherExpression(expression)
+	}
+	matcher := result.matcher
+	if prefix != "" || suffix != "" {
+		matcher = prefixSuffixMatcher{prefix: prefix, suffix: suffix, matcher: matcher}
+	}
+	return matcher, nil
+}
+
+func invalidMatcherExpression(expression string) error {
+	return trace.BadParameter("%q is not a valid matcher expression - no variables and transformations are allowed", expression)
+}
+
+func malformedMatcherTemplate(value string) error {
+	return trace.BadParameter("%q is using template brackets '{{' or '}}', however expression does not parse, make sure the format is {{expression}}", value)
+}
+
+// splitMatcherTemplate finds one template while allowing braces within quoted
+// regexp arguments. A second template is an invalid matcher expression.
+func splitMatcherTemplate(value string) (prefix, expression, suffix string, templated bool, err error) {
+	open := strings.Index(value, "{{")
+	if open == -1 {
+		if strings.Contains(value, "}}") {
+			return "", "", "", false, malformedMatcherTemplate(value)
+		}
+		return "", "", "", false, nil
+	}
+	if strings.Contains(value[:open], "}}") {
+		return "", "", "", false, malformedMatcherTemplate(value)
+	}
+
+	close, nested := findTemplateClose(value, open+2)
+	if close == -1 {
+		return "", "", "", false, malformedMatcherTemplate(value)
+	}
+
+	expression = value[open+2 : close]
+	suffix = value[close+2:]
+	if nested || (strings.Contains(suffix, "{{") && strings.Contains(suffix, "}}")) {
+		return "", "", "", false, invalidMatcherExpression(value[open+2 : strings.LastIndex(value, "}}")])
+	}
+	if strings.Contains(suffix, "{{") || strings.Contains(suffix, "}}") {
+		return "", "", "", false, malformedMatcherTemplate(value)
+	}
+	return value[:open], expression, suffix, true, nil
+}
+
+func findTemplateClose(value string, start int) (close int, nested bool) {
+	quote := byte(0)
+	escaped := false
+	for i := start; i+1 < len(value); i++ {
+		ch := value[i]
+		if quote != 0 {
+			if quote != '`' && escaped {
+				escaped = false
+				continue
+			}
+			if quote != '`' && ch == '\\' {
+				escaped = true
+				continue
+			}
+			if ch == quote {
+				quote = 0
+			}
+			continue
+		}
+		if ch == '"' || ch == '\'' || ch == '`' {
+			quote = ch
+			continue
+		}
+		if ch == '{' && value[i+1] == '{' {
+			nested = true
+			i++
+			continue
+		}
+		if ch == '}' && value[i+1] == '}' {
+			return i, nested
+		}
+	}
+	return -1, nested
+}
