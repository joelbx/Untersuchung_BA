+// TestMatch checks the matcher syntax and the boundaries of each match.
+func TestMatch(t *testing.T) {
+	tests := []struct {
+		name    string
+		pattern string
+		matches []string
+		misses  []string
+	}{
+		{
+			name:    "literal",
+			pattern: "foo.bar",
+			matches: []string{"foo.bar"},
+			misses:  []string{"fooXbar", "xfoo.bar", "foo.barx"},
+		},
+		{
+			name:    "wildcard",
+			pattern: "*",
+			matches: []string{"", "foo", "foo/bar"},
+		},
+		{
+			name:    "wildcard with fixed sides",
+			pattern: "foo*bar",
+			matches: []string{"foobar", "foo-middle-bar"},
+			misses:  []string{"xfoobar", "foobarx", "foobaz"},
+		},
+		{
+			name:    "raw regular expression",
+			pattern: "^foo[0-9]+$",
+			matches: []string{"foo1", "foo123"},
+			misses:  []string{"foo", "xfoo1", "foo1x"},
+		},
+		{
+			name:    "regexp match function",
+			pattern: `{{regexp.match("^foo[0-9]+$")}}`,
+			matches: []string{"foo1", "foo123"},
+			misses:  []string{"foo", "xfoo1", "foo1x"},
+		},
+		{
+			name:    "regexp function uses regexp search semantics",
+			pattern: `{{regexp.match("foo")}}`,
+			matches: []string{"foo", "prefix-foo-suffix"},
+			misses:  []string{"bar"},
+		},
+		{
+			name:    "regexp quantifier braces inside template",
+			pattern: `{{regexp.match("^a{2}$")}}`,
+			matches: []string{"aa"},
+			misses:  []string{"a", "aaa"},
+		},
+		{
+			name:    "closing brackets inside quoted regexp",
+			pattern: `{{regexp.match("a}}b")}}`,
+			matches: []string{"a}}b"},
+			misses:  []string{"ab"},
+		},
+		{
+			name:    "regexp not match function",
+			pattern: `{{regexp.not_match("^foo$")}}`,
+			matches: []string{"", "bar", "xfoo"},
+			misses:  []string{"foo"},
+		},
+		{
+			name:    "prefix and suffix",
+			pattern: `foo-{{regexp.match("^bar$")}}-baz`,
+			matches: []string{"foo-bar-baz"},
+			misses:  []string{"bar", "foo-baz-baz", "xfoo-bar-baz", "foo-bar-bazx"},
+		},
+		{
+			name:    "prefix and suffix with negation",
+			pattern: `foo-{{regexp.not_match("^bar$")}}-baz`,
+			matches: []string{"foo-other-baz"},
+			misses:  []string{"foo-bar-baz", "other", "xfoo-other-baz"},
+		},
+		{
+			name:    "prefix and suffix cannot overlap",
+			pattern: `a{{regexp.not_match("x")}}a`,
+			matches: []string{"aa", "aba"},
+			misses:  []string{"a", "axa"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			if !assert.NoError(t, err) {
+				return
+			}
+			for _, input := range tt.matches {
+				assert.True(t, matcher.Match(input), "%q should match %q", input, tt.pattern)
+			}
+			for _, input := range tt.misses {
+				assert.False(t, matcher.Match(input), "%q should not match %q", input, tt.pattern)
+			}
+		})
+	}
+}
