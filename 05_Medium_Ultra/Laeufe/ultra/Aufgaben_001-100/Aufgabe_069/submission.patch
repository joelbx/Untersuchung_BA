+			pattern:  `{{regexp.match("foo"...)}}`,
+			contains: "variadic arguments",
+		},
+		{
+			name:     "non-string argument",
+			pattern:  `{{regexp.match(42)}}`,
+			contains: "string literal",
+		},
+		{
+			name:     "variable argument",
+			pattern:  `{{regexp.match(internal.foo)}}`,
+			contains: "string literal",
+		},
+		{
+			name:     "nested function argument",
+			pattern:  `{{regexp.match(regexp.match("foo"))}}`,
+			contains: "string literal",
+		},
+		{
+			name:     "variable expression",
+			pattern:  `{{internal.foo}}`,
+			contains: "is not a valid matcher expression - no variables and transformations are allowed",
+		},
+		{
+			name:     "transformation",
+			pattern:  `{{email.local(internal.foo)}}`,
+			contains: "is not a valid matcher expression - no variables and transformations are allowed",
+		},
+		{
+			name:     "multiple expressions",
+			pattern:  `{{regexp.match("foo")}}{{regexp.match("bar")}}`,
+			contains: "is not a valid matcher expression - no variables and transformations are allowed",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			matcher, err := Match(tt.pattern)
+			assert.Nil(t, matcher)
+			if !assert.IsType(t, trace.BadParameter(""), err) {
