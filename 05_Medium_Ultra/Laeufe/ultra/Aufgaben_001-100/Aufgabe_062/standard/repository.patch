+func TestContextReader_ReadPasswordDeadline(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+
+	term := &fakeTerm{reader: pr}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+	t.Cleanup(func() { require.NoError(t, cr.Close()) })
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	got, err := cr.ReadPassword(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Empty(t, got)
+	require.True(t, term.restoreCalled, "terminal was not restored on deadline")
+}
+
+func TestContextReader_CloseRestoresPasswordMode(t *testing.T) {
+	pr, pw := io.Pipe()
+	t.Cleanup(func() { pr.Close() })
+	t.Cleanup(func() { pw.Close() })
+
+	term := &fakeTerm{reader: pr}
+	cr := NewContextReader(pr)
+	cr.term = term
+	cr.fd = 0
+
+	var stateAtRestore readerState
+	term.onRestore = func() { stateAtRestore = cr.state }
+	require.NoError(t, cr.firePasswordRead())
+	require.NoError(t, cr.Close())
+	require.Equal(t, 1, term.restoreCalls)
+	require.Equal(t, readerStatePassword, stateAtRestore, "terminal was restored after reader was closed")
+	require.Equal(t, readerStateClosed, cr.state)
+	require.NoError(t, cr.Close(), "second close failed")
+	require.Equal(t, 1, term.restoreCalls, "second close restored the terminal again")
+}
