 }
+
+// NotifyExit signals that the program is exiting, allowing the stdin reader to
+// restore the terminal if a password read is still in progress.
+func NotifyExit() {
+	stdinMU.Lock()
+	defer stdinMU.Unlock()
+
+	if closer, ok := stdin.(io.Closer); ok {
+		_ = closer.Close()
+	}
+}
