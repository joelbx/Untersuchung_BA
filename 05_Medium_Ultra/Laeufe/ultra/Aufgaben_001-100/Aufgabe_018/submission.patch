+func TestStringToSliceHookFunc(t *testing.T) {
+	stringSlice := reflect.TypeOf([]string{})
+	tests := []struct {
+		name   string
+		input  interface{}
+		target reflect.Type
+		want   interface{}
+	}{
+		{
+			name:   "mixed whitespace",
+			input:  " \tfoo.com  bar.com\n\tbaz.com \r\n",
+			target: stringSlice,
+			want:   []string{"foo.com", "bar.com", "baz.com"},
+		},
+		{
+			name:   "comma compatibility",
+			input:  "foo.com,bar.com",
+			target: stringSlice,
+			want:   []string{"foo.com", "bar.com"},
+		},
+		{
+			name:   "empty string",
+			input:  "",
+			target: stringSlice,
+			want:   []string{},
+		},
+		{
+			name:   "whitespace only",
+			input:  " \t\n ",
+			target: stringSlice,
+			want:   []string{},
+		},
+		{
+			name:   "existing sequence",
+			input:  []string{"foo.com bar.com", "baz.com"},
+			target: stringSlice,
+			want:   []string{"foo.com bar.com", "baz.com"},
+		},
+		{
+			name:   "non-string source",
+			input:  42,
+			target: stringSlice,
+			want:   42,
+		},
+		{
+			name:   "non-string-slice target",
+			input:  "foo.com bar.com",
+			target: reflect.TypeOf([]int{}),
+			want:   "foo.com bar.com",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := stringToSliceHookFunc(reflect.TypeOf(tt.input), tt.target, tt.input)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestLoadCorsAllowedOrigins(t *testing.T) {
+	tests := []struct {
+		name     string
+		yaml     string
+		envValue string
+		checkEnv bool
+		want     []string
+	}{
+		{
+			name:     "mixed whitespace",
+			yaml:     "cors:\n  allowed_origins: \"\\tfoo.com\\n bar.com\\t\\tbaz.com  \"\n",
+			envValue: "\tfoo.com\n bar.com\t\tbaz.com  ",
+			checkEnv: true,
+			want:     []string{"foo.com", "bar.com", "baz.com"},
+		},
+		{
+			name: "empty scalar",
+			yaml: "cors:\n  allowed_origins: \"\"\n",
+			want: []string{},
+		},
+		{
+			name: "sequence",
+			yaml: "cors:\n  allowed_origins: [\"foo.com bar.com\", \"baz.com\"]\n",
+			want: []string{"foo.com bar.com", "baz.com"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.yaml), 0600))
+
+			cfg, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+
+			if tt.checkEnv {
+				t.Setenv("FLIPT_CORS_ALLOWED_ORIGINS", tt.envValue)
+				cfg, err = Load("./testdata/default.yml")
+				require.NoError(t, err)
+				assert.Equal(t, tt.want, cfg.Cors.AllowedOrigins)
+			}
+		})
+	}
+}
