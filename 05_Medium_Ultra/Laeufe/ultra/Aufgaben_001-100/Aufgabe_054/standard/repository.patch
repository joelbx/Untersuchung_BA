+package singleton_test
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/navidrome/navidrome/utils/singleton"
+)
+
+func TestGetInstanceValueAndPointerTypes(t *testing.T) {
+	type instance struct{ id int }
+
+	valueCalls := 0
+	firstValue := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 1}
+	})
+	if firstValue.id != 1 || valueCalls != 1 {
+		t.Fatalf("first value = %+v, constructor calls = %d; want id 1 and one call", firstValue, valueCalls)
+	}
+
+	pointerCalls := 0
+	firstPointer := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 2}
+	})
+	if firstPointer == nil || firstPointer.id != 2 || pointerCalls != 1 {
+		t.Fatalf("first pointer = %+v, constructor calls = %d; want id 2 and one call", firstPointer, pointerCalls)
+	}
+
+	secondValue := singleton.GetInstance(func() instance {
+		valueCalls++
+		return instance{id: 3}
+	})
+	secondPointer := singleton.GetInstance(func() *instance {
+		pointerCalls++
+		return &instance{id: 4}
+	})
+	if secondValue != firstValue || valueCalls != 1 {
+		t.Errorf("reused value = %+v, constructor calls = %d; want %+v and one call", secondValue, valueCalls, firstValue)
+	}
+	if secondPointer != firstPointer || pointerCalls != 1 {
+		t.Errorf("reused pointer = %p, constructor calls = %d; want %p and one call", secondPointer, pointerCalls, firstPointer)
+	}
+}
+
+func TestGetInstanceCachesNilInterface(t *testing.T) {
+	type nilable interface{ marker() }
+
+	constructorCalls := 0
+	first := singleton.GetInstance[nilable](func() nilable {
+		constructorCalls++
+		return nil
+	})
+	second := singleton.GetInstance[nilable](func() nilable {
+		constructorCalls++
+		return nil
+	})
+	if first != nil || second != nil || constructorCalls != 1 {
+		t.Fatalf("instances = %v, %v; constructor calls = %d; want nil instances and one call", first, second, constructorCalls)
+	}
+}
+
+func TestGetInstanceConcurrentCalls(t *testing.T) {
+	type instance struct{ creation int32 }
+
+	const callers = 20_000
+	var constructorCalls int32
+	constructor := func() *instance {
+		return &instance{creation: atomic.AddInt32(&constructorCalls, 1)}
+	}
+
+	results := make([]*instance, callers)
+	start := make(chan struct{})
+	var ready, done sync.WaitGroup
+	ready.Add(callers)
+	done.Add(callers)
+	for i := 0; i < callers; i++ {
+		go func(index int) {
+			defer done.Done()
+			ready.Done()
+			<-start
+			results[index] = singleton.GetInstance(constructor)
+		}(i)
+	}
+	ready.Wait()
+	close(start)
+	done.Wait()
+
+	if got := atomic.LoadInt32(&constructorCalls); got != 1 {
+		t.Fatalf("constructor calls = %d; want 1", got)
+	}
+	want := results[0]
+	if want == nil || want.creation != 1 {
+		t.Fatalf("first instance = %+v; want creation 1", want)
+	}
+	for i, got := range results {
+		if got != want {
+			t.Fatalf("caller %d received %p; want %p", i, got, want)
+		}
+	}
+}
