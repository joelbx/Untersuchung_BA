+// GetInstance returns the singleton for T, creating it with constructor on the first call.
+// T and *T have separate instances.
+func GetInstance[T any](constructor func() T) T {
+	typeOfT := reflect.TypeOf((*T)(nil)).Elem()
+	entryValue, _ := typedEntries.LoadOrStore(typeOfT, &typedEntry{})
+	entry := entryValue.(*typedEntry)
+	entry.once.Do(func() {
+		value := constructor()
+		// A *T keeps the type information even when value is a nil interface.
+		entry.value = &value
+	})
+	return *entry.value.(*T)
+}
