+func TestDiffWithUnmatchedServers(t *testing.T) {
+	current := models.ScanResult{
+		ServerName: "new-host",
+		ScannedCves: models.VulnInfos{
+			"CVE-2020-0001": {CveID: "CVE-2020-0001"},
+		},
+	}
+	previous := models.ScanResult{
+		ServerName: "old-host",
+		ScannedCves: models.VulnInfos{
+			"CVE-2020-0002": {CveID: "CVE-2020-0002"},
+		},
+	}
+	got, err := diff(models.ScanResults{current}, models.ScanResults{previous}, true, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].ScannedCves["CVE-2020-0001"].DiffStatus != models.DiffPlus || got[1].ScannedCves["CVE-2020-0002"].DiffStatus != models.DiffMinus {
+		t.Fatalf("unexpected unmatched-server diff: %#v", got)
+	}
+
+	got, err = diff(models.ScanResults{current}, nil, false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || len(got[0].ScannedCves) != 0 {
+		t.Fatalf("missing previous server must not produce minus CVEs: %#v", got)
+	}
+}
