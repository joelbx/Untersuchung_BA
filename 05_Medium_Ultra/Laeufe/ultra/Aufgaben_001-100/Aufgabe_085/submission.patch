new file mode 100644
index 0000000..68a0831
--- /dev/null
+++ b/report/diff_renderers_test.go
@@ -0,0 +1,85 @@
+package report
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestDiffStatusInReportEntries(t *testing.T) {
+	previousDiff := config.Conf.Diff
+	defer func() { config.Conf.Diff = previousDiff }()
+	previousScanResult, previousVinfos, previousVinfo := currentScanResult, vinfos, currentVinfo
+	defer func() {
+		currentScanResult, vinfos, currentVinfo = previousScanResult, previousVinfos, previousVinfo
+	}()
+
+	result := models.ScanResult{
+		ScannedCves: models.VulnInfos{
+			"CVE-2026-0001": {CveID: "CVE-2026-0001", DiffStatus: models.DiffPlus},
+			"CVE-2026-0002": {CveID: "CVE-2026-0002", DiffStatus: models.DiffMinus},
+		},
+	}
+	currentScanResult = result
+	vinfos = result.ScannedCves.ToSortedSlice()
+
+	for _, tt := range []struct {
+		name       string
+		diff       bool
+		plusLabel  string
+		minusLabel string
+	}{
+		{name: "diff", diff: true, plusLabel: "+CVE-2026-0001", minusLabel: "-CVE-2026-0002"},
+		{name: "normal", diff: false, plusLabel: "CVE-2026-0001", minusLabel: "CVE-2026-0002"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf.Diff = tt.diff
+
+			attachments := toSlackAttachments(result)
+			if len(attachments) != 2 {
+				t.Fatalf("got %d Slack attachments, want 2", len(attachments))
+			}
+			if attachments[0].Title != tt.plusLabel || attachments[1].Title != tt.minusLabel {
+				t.Errorf("Slack titles = %q, %q", attachments[0].Title, attachments[1].Title)
+			}
+			if attachments[0].TitleLink != "https://nvd.nist.gov/vuln/detail/CVE-2026-0001" ||
+				attachments[1].TitleLink != "https://nvd.nist.gov/vuln/detail/CVE-2026-0002" {
+				t.Errorf("Slack links contain noncanonical CVE IDs: %q, %q", attachments[0].TitleLink, attachments[1].TitleLink)
+			}
+
+			summary := summaryLines(result)
+			if !strings.Contains(summary, tt.plusLabel) || !strings.Contains(summary, tt.minusLabel) {
+				t.Errorf("TUI summary missing diff labels: %q", summary)
+			}
+			for i, label := range []string{tt.plusLabel, tt.minusLabel} {
+				currentVinfo = i
+				detail, err := detailLines()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !strings.Contains(detail, "\n"+label+"\n") {
+					t.Errorf("TUI detail missing %q: %q", label, detail)
+				}
+			}
+
+			messages := SyslogWriter{}.encodeSyslog(result)
+			if len(messages) != 2 {
+				t.Fatalf("got %d syslog messages, want 2", len(messages))
+			}
+			for _, message := range messages {
+				if tt.diff {
+					if strings.Contains(message, `cve_id="CVE-2026-0001"`) && !strings.Contains(message, `diff_status="+"`) {
+						t.Errorf("new CVE has no plus status: %q", message)
+					}
+					if strings.Contains(message, `cve_id="CVE-2026-0002"`) && !strings.Contains(message, `diff_status="-"`) {
+						t.Errorf("resolved CVE has no minus status: %q", message)
+					}
+				} else if strings.Contains(message, "diff_status=") {
+					t.Errorf("normal report has diff status: %q", message)
+				}
+			}
+		})
+	}
+}
