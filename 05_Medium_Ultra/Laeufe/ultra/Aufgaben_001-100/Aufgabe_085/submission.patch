+func TestDiffFiltersAndPackageSources(t *testing.T) {
+	const (
+		newID      = "CVE-2020-0001"
+		resolvedID = "CVE-2020-0002"
+		sharedID   = "CVE-2020-0003"
+	)
+	current := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			newID:    {CveID: newID, AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+			sharedID: {CveID: sharedID, AffectedPackages: models.PackageFixStatuses{{Name: "changed-pkg"}}},
+		},
+		Packages: models.NewPackages(
+			models.Package{Name: "new-pkg", Version: "2"},
+			models.Package{Name: "changed-pkg", Version: "2"},
+		),
+	}
+	previous := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			resolvedID: {CveID: resolvedID, AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+			sharedID:   {CveID: sharedID, AffectedPackages: models.PackageFixStatuses{{Name: "old-shared-pkg"}}},
+		},
+		Packages: models.NewPackages(
+			models.Package{Name: "old-pkg", Version: "1"},
+			models.Package{Name: "old-shared-pkg", Version: "1"},
+		),
+	}
+
+	tests := []struct {
+		name         string
+		plus, minus  bool
+		wantCves     models.VulnInfos
+		wantPackages models.Packages
+	}{
+		{
+			name:         "plus only",
+			plus:         true,
+			wantCves:     models.VulnInfos{newID: {CveID: newID, DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}}},
+			wantPackages: models.NewPackages(models.Package{Name: "new-pkg", Version: "2"}),
+		},
+		{
+			name:         "minus only",
+			minus:        true,
+			wantCves:     models.VulnInfos{resolvedID: {CveID: resolvedID, DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}}},
+			wantPackages: models.NewPackages(models.Package{Name: "old-pkg", Version: "1"}),
+		},
+		{
+			name:  "both",
+			plus:  true,
+			minus: true,
+			wantCves: models.VulnInfos{
+				newID:      {CveID: newID, DiffStatus: models.DiffPlus, AffectedPackages: models.PackageFixStatuses{{Name: "new-pkg"}}},
+				resolvedID: {CveID: resolvedID, DiffStatus: models.DiffMinus, AffectedPackages: models.PackageFixStatuses{{Name: "old-pkg"}}},
+			},
+			wantPackages: models.NewPackages(models.Package{Name: "new-pkg", Version: "2"}, models.Package{Name: "old-pkg", Version: "1"}),
+		},
+		{
+			name:         "neither",
+			wantCves:     models.VulnInfos{},
+			wantPackages: models.Packages{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := diff(models.ScanResults{current}, models.ScanResults{previous}, tt.plus, tt.minus)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got) != 1 {
+				t.Fatalf("got %d scan results, want 1", len(got))
+			}
+			if !reflect.DeepEqual(got[0].ScannedCves, tt.wantCves) {
+				t.Errorf("CVEs: got %#v, want %#v", got[0].ScannedCves, tt.wantCves)
+			}
+			if !reflect.DeepEqual(got[0].Packages, tt.wantPackages) {
+				t.Errorf("packages: got %#v, want %#v", got[0].Packages, tt.wantPackages)
+			}
+		})
+	}
+}
