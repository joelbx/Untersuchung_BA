@@ -0,0 +1,69 @@
+package models
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestCveIDDiffFormat(t *testing.T) {
+	tests := []struct {
+		name       string
+		vuln       VulnInfo
+		isDiffMode bool
+		want       string
+	}{
+		{name: "normal", vuln: VulnInfo{CveID: "CVE-2026-0001", DiffStatus: DiffPlus}, want: "CVE-2026-0001"},
+		{name: "new", vuln: VulnInfo{CveID: "CVE-2026-0001", DiffStatus: DiffPlus}, isDiffMode: true, want: "+CVE-2026-0001"},
+		{name: "resolved", vuln: VulnInfo{CveID: "CVE-2026-0002", DiffStatus: DiffMinus}, isDiffMode: true, want: "-CVE-2026-0002"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.vuln.CveIDDiffFormat(tt.isDiffMode); got != tt.want {
+				t.Fatalf("CveIDDiffFormat() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCountDiff(t *testing.T) {
+	vulns := VulnInfos{
+		"CVE-2026-0001": {CveID: "CVE-2026-0001", DiffStatus: DiffPlus},
+		"CVE-2026-0002": {CveID: "CVE-2026-0002", DiffStatus: DiffPlus},
+		"CVE-2026-0003": {CveID: "CVE-2026-0003", DiffStatus: DiffMinus},
+		"CVE-2026-0004": {CveID: "CVE-2026-0004"},
+	}
+	plus, minus := vulns.CountDiff()
+	if plus != 2 || minus != 1 {
+		t.Fatalf("CountDiff() = (%d, %d), want (2, 1)", plus, minus)
+	}
+}
+
+func TestFormatCveSummaryShowsDiffCounts(t *testing.T) {
+	previous := config.Conf
+	defer func() { config.Conf = previous }()
+	config.Conf.Diff = true
+	vulns := VulnInfos{
+		"CVE-2026-0001": {CveID: "CVE-2026-0001", DiffStatus: DiffPlus},
+		"CVE-2026-0002": {CveID: "CVE-2026-0002", DiffStatus: DiffMinus},
+	}
+	if summary := vulns.FormatCveSummary(); !strings.Contains(summary, "(+1, -1)") {
+		t.Fatalf("diff summary %q does not show both change counts", summary)
+	}
+}
+
+func TestDiffStatusJSON(t *testing.T) {
+	encoded, err := json.Marshal(VulnInfo{CveID: "CVE-2026-0001", DiffStatus: DiffMinus})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded map[string]interface{}
+	if err := json.Unmarshal(encoded, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded["diffStatus"] != "-" {
+		t.Fatalf("diffStatus = %v, want -", decoded["diffStatus"])
+	}
+}
