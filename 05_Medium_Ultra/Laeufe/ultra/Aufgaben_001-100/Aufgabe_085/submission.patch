+func TestDiffTextAndCsvMarkers(t *testing.T) {
+	beforeDiff := config.Conf.Diff
+	config.Conf.Diff = true
+	defer func() { config.Conf.Diff = beforeDiff }()
+
+	r := models.ScanResult{
+		ServerName: "host",
+		ScannedCves: models.VulnInfos{
+			"CVE-2020-0001": {CveID: "CVE-2020-0001", DiffStatus: models.DiffPlus},
+			"CVE-2020-0002": {CveID: "CVE-2020-0002", DiffStatus: models.DiffMinus},
+		},
+	}
+	for name, report := range map[string]string{
+		"list": formatList(r),
+		"full": formatFullPlainText(r),
+	} {
+		for _, markedID := range []string{"+CVE-2020-0001", "-CVE-2020-0002"} {
+			if !strings.Contains(report, markedID) {
+				t.Errorf("%s report missing %s", name, markedID)
+			}
+		}
+	}
+	if !strings.Contains(formatList(r), "https://nvd.nist.gov/vuln/detail/CVE-2020-0001") {
+		t.Error("list report changed the CVE URL")
+	}
+
+	path := t.TempDir() + "/diff.csv"
+	if err := formatCsvList(r, path); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	rows, err := csv.NewReader(f).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 3 {
+		t.Fatalf("got %d CSV rows, want 3", len(rows))
+	}
+	seen := map[string]string{}
+	for _, row := range rows[1:] {
+		seen[row[0]] = row[6]
+	}
+	if seen["+CVE-2020-0001"] != "https://nvd.nist.gov/vuln/detail/CVE-2020-0001" ||
+		seen["-CVE-2020-0002"] != "https://nvd.nist.gov/vuln/detail/CVE-2020-0002" {
+		t.Errorf("CSV markers or URLs are incorrect: %#v", seen)
+	}
+}
