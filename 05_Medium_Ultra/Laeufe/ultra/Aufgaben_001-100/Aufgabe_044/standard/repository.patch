+				namespaces:    tt.namespaces,
+				namespacesErr: tt.engineErr,
+			}
+			ctx := authmiddlewaregrpc.ContextWithAuthentication(context.Background(), tt.authn)
+			called := false
+			handler := func(ctx context.Context, _ any) (any, error) {
+				called = true
+				namespaces, ok := ctx.Value(authz.NamespacesKey).([]string)
+				require.True(t, ok, "accessible namespaces must be present in context")
