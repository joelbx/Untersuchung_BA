+				assert.Equal(t, map[string]any{"authentication": tt.authn}, verifier.namespacesInput)
+			} else {
+				assert.Equal(t, 0, verifier.namespacesCalls)
+			}
+
+			if tt.wantCalled {
+				require.NoError(t, err)
+			} else {
+				require.Equal(t, errUnauthorized, err)
+			}
