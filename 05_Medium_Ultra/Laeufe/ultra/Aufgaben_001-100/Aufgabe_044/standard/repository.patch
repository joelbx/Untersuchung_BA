+package bundle
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/open-policy-agent/contrib/logging/plugins/ozap"
+	"github.com/open-policy-agent/opa/sdk"
+	sdktest "github.com/open-policy-agent/opa/sdk/test"
+	"github.com/open-policy-agent/opa/storage/inmem"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest"
+)
+
+const namespacesPolicy = `package flipt.authz.v1
+import rego.v1
+
+default allow := false
+default dev_namespaces := []
+default ops_namespaces := []
+
+has_role(role) if {
+    some assigned in split(input.authentication.metadata["io.flipt.auth.role"], ",")
+    assigned == role
+}
+
+dev_namespaces := ["local", "staging"] if { has_role("devs") }
+ops_namespaces := ["production"] if { has_role("ops") }
+viewable_namespaces := array.concat(dev_namespaces, ops_namespaces)
+`
+
+func testEngineWithPolicy(t *testing.T, policy string) *Engine {
+	t.Helper()
+	ctx := context.Background()
+	server := sdktest.MustNewServer(sdktest.MockBundle("/bundles/bundle.tar.gz", map[string]string{
+		"main.rego": policy,
+	}))
+	t.Cleanup(server.Stop)
+
+	config := fmt.Sprintf(`{
+		"services": {"test": {"url": %q}},
+		"bundles": {"test": {"resource": "/bundles/bundle.tar.gz"}}
+	}`, server.URL())
+	logger := zaptest.NewLogger(t)
+	level := zap.NewAtomicLevelAt(logger.Level())
+	opa, err := sdk.New(ctx, sdk.Options{
+		Config: strings.NewReader(config),
+		Store:  inmem.New(),
+		Logger: ozap.Wrap(logger, &level),
+	})
+	require.NoError(t, err)
+
+	engine := &Engine{opa: opa, logger: logger}
+	t.Cleanup(func() { require.NoError(t, engine.Shutdown(ctx)) })
+	return engine
+}
+
+func TestEngine_Namespaces(t *testing.T) {
+	engine := testEngineWithPolicy(t, namespacesPolicy)
+	ctx := context.Background()
+	for _, tt := range []struct {
+		name     string
+		input    map[string]any
+		expected []string
+	}{
+		{name: "nil input", input: nil, expected: []string{}},
+		{name: "empty input", input: map[string]any{}, expected: []string{}},
+		{name: "no roles", input: roleInput(""), expected: []string{}},
+		{name: "devs", input: roleInput("devs"), expected: []string{"local", "staging"}},
+		{name: "ops", input: roleInput("ops"), expected: []string{"production"}},
+		{name: "devs and ops", input: roleInput("devs,ops"), expected: []string{"local", "staging", "production"}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			namespaces, err := engine.Namespaces(ctx, tt.input)
+			require.NoError(t, err)
+			require.Equal(t, tt.expected, namespaces)
+		})
+	}
+}
+
+func TestEngine_NamespacesInvalidDecision(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		policy string
+	}{
+		{name: "undefined", policy: `package flipt.authz.v1
+import rego.v1
+default allow := false`},
+		{name: "scalar", policy: `package flipt.authz.v1
+import rego.v1
+default allow := false
+viewable_namespaces := 42`},
+		{name: "non-string element", policy: `package flipt.authz.v1
+import rego.v1
+default allow := false
+viewable_namespaces := ["local", 42]`},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			engine := testEngineWithPolicy(t, tt.policy)
+			namespaces, err := engine.Namespaces(context.Background(), map[string]any{})
+			require.Error(t, err)
+			require.Nil(t, namespaces)
+		})
+	}
+}
+
+func roleInput(role string) map[string]any {
+	return map[string]any{
+		"authentication": map[string]any{
+			"metadata": map[string]any{"io.flipt.auth.role": role},
+		},
+	}
+}
