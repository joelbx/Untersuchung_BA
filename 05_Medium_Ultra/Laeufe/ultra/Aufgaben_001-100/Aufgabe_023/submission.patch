diff --git a/internal/cmd/authn_test.go b/internal/cmd/authn_test.go
new file mode 100644
index 0000000..72f4f47
--- /dev/null
+++ b/internal/cmd/authn_test.go
@@ -0,0 +1,72 @@
+package cmd
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap/zaptest"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+func TestAuthenticationGRPCJWTWithoutDatabase(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	publicKey, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+	require.NoError(t, err)
+
+	keyPath := filepath.Join(t.TempDir(), "jwt_public.pem")
+	err = os.WriteFile(keyPath, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: publicKey}), 0o600)
+	require.NoError(t, err)
+
+	// getDB returns dbErr after its first call. A sentinel catches any attempt
+	// to use it even if another test already initialized the database.
+	previousDBErr := dbErr
+	dbErr = errors.New("authentication must not connect to a database")
+	t.Cleanup(func() { dbErr = previousDBErr })
+
+	for _, storageType := range []config.StorageType{
+		config.LocalStorageType,
+		config.GitStorageType,
+		config.OCIStorageType,
+		config.ObjectStorageType,
+	} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Storage.Type = storageType
+			cfg.Authentication.Required = true
+			cfg.Authentication.Methods.JWT.Enabled = true
+			cfg.Authentication.Methods.JWT.Method.PublicKeyFile = keyPath
+
+			ctx := context.Background()
+			register, interceptors, shutdown, err := authenticationGRPC(ctx, zaptest.NewLogger(t), cfg, false, false)
+			require.NoError(t, err)
+			require.Len(t, register, 2)
+			require.Len(t, interceptors, 3)
+			require.NoError(t, shutdown(ctx))
+
+			info := &grpc.UnaryServerInfo{Server: struct{}{}, FullMethod: "/flipt.auth.v1.AuthenticationService/Test"}
+			handler := func(context.Context, any) (any, error) {
+				t.Fatal("unauthenticated request reached the handler")
+				return nil, nil
+			}
+			_, err = interceptors[len(interceptors)-1](ctx, nil, info, handler)
+			require.Equal(t, codes.Unauthenticated, status.Code(err))
+
+			jwtContext := metadata.NewIncomingContext(ctx, metadata.Pairs("authorization", "JWT invalid"))
+			_, err = interceptors[0](jwtContext, nil, info, handler)
+			require.Equal(t, codes.Unauthenticated, status.Code(err))
+		})
+	}
+}
