diff --git a/internal/config/authentication_test.go b/internal/config/authentication_test.go
new file mode 100644
index 0000000..b886f64
--- /dev/null
+++ b/internal/config/authentication_test.go
@@ -0,0 +1,91 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestAuthenticationMethodDatabaseRequirements(t *testing.T) {
+	want := map[auth.Method]bool{
+		auth.Method_METHOD_TOKEN:      true,
+		auth.Method_METHOD_OIDC:       true,
+		auth.Method_METHOD_GITHUB:     true,
+		auth.Method_METHOD_KUBERNETES: true,
+		auth.Method_METHOD_JWT:        false,
+	}
+
+	var methods AuthenticationMethods
+	infos := methods.AllMethods()
+	assert.Len(t, infos, len(want))
+	for _, info := range infos {
+		requiresDatabase, ok := want[info.Method]
+		if !assert.True(t, ok, "unexpected authentication method %s", info.Method) {
+			continue
+		}
+		assert.Equal(t, requiresDatabase, info.RequiresDatabase, "method %s", info.Method)
+	}
+}
+
+func TestAuthenticationConfigDatabaseAndCleanupDecisions(t *testing.T) {
+	cleanup := &AuthenticationCleanupSchedule{
+		Interval:    time.Hour,
+		GracePeriod: 30 * time.Minute,
+	}
+
+	tests := []struct {
+		name        string
+		config      AuthenticationConfig
+		wantDB      bool
+		wantCleanup bool
+	}{
+		{
+			name:   "required without methods",
+			config: AuthenticationConfig{Required: true},
+		},
+		{
+			name: "disabled database method with cleanup",
+			config: AuthenticationConfig{Methods: AuthenticationMethods{
+				Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Cleanup: cleanup},
+			}},
+		},
+		{
+			name: "JWT with cleanup",
+			config: AuthenticationConfig{Methods: AuthenticationMethods{
+				JWT: AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true, Cleanup: cleanup},
+			}},
+		},
+		{
+			name: "JWT and disabled token with cleanup",
+			config: AuthenticationConfig{Methods: AuthenticationMethods{
+				JWT:   AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true, Cleanup: cleanup},
+				Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Cleanup: cleanup},
+			}},
+		},
+		{
+			name: "JWT and token without cleanup",
+			config: AuthenticationConfig{Methods: AuthenticationMethods{
+				JWT:   AuthenticationMethod[AuthenticationMethodJWTConfig]{Enabled: true, Cleanup: cleanup},
+				Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Enabled: true},
+			}},
+			wantDB: true,
+		},
+		{
+			name: "enabled token with cleanup",
+			config: AuthenticationConfig{Methods: AuthenticationMethods{
+				Token: AuthenticationMethod[AuthenticationMethodTokenConfig]{Enabled: true, Cleanup: cleanup},
+			}},
+			wantDB:      true,
+			wantCleanup: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.wantDB, tt.config.RequiresDatabase())
+			assert.Equal(t, tt.wantCleanup, tt.config.ShouldRunCleanup())
+		})
+	}
+}
