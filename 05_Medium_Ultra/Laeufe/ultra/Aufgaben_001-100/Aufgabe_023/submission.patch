+func TestCleanupSkipsMethodsWithoutDatabase(t *testing.T) {
+	schedule := &config.AuthenticationCleanupSchedule{Interval: time.Second}
+	authConfig := config.AuthenticationConfig{
+		Methods: config.AuthenticationMethods{
+			JWT: config.AuthenticationMethod[config.AuthenticationMethodJWTConfig]{
+				Enabled: true,
+				Cleanup: schedule,
+			},
+			Token: config.AuthenticationMethod[config.AuthenticationMethodTokenConfig]{
+				Cleanup: schedule,
+			},
+		},
+	}
+
+	service := NewAuthenticationService(zaptest.NewLogger(t), inmemoplock.New(), inmemauth.NewStore(), authConfig)
+	service.Run(context.Background())
+
+	done := make(chan error, 1)
+	go func() { done <- service.errgroup.Wait() }()
+
+	select {
+	case err := <-done:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		require.NoError(t, service.Shutdown(context.Background()))
+		t.Fatal("cleanup started for a non-database or disabled method")
+	}
+
+	require.NoError(t, service.Shutdown(context.Background()))
+}
