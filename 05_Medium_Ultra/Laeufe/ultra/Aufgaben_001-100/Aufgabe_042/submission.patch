diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..3d34584
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,50 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const privileges = require('../privileges');
+const user = require('../user');
+
+const wellKnown = module.exports;
+
+wellKnown.webfinger = async function (req, res) {
+	const { resource } = req.query;
+	const { hostname } = nconf.get('url_parsed');
+	const account = typeof resource === 'string' && resource.startsWith('acct:') ? resource.slice(5) : '';
+	const atIndex = account.indexOf('@');
+
+	if (!account || atIndex < 1 || atIndex !== account.lastIndexOf('@') ||
+		account.slice(atIndex + 1).toLowerCase() !== hostname.toLowerCase()) {
+		return res.status(400).json({ error: 'invalid-resource' });
+	}
+
+	const canViewUsers = await privileges.global.can('view:users', req.uid || 0);
+	if (!canViewUsers) {
+		return res.status(403).json({ error: 'forbidden' });
+	}
+
+	const uid = await user.getUidByUserslug(account.slice(0, atIndex));
+	if (!uid) {
+		return res.status(404).json({ error: 'not-found' });
+	}
+
+	const userslug = await user.getUserField(uid, 'userslug');
+	if (!userslug) {
+		return res.status(404).json({ error: 'not-found' });
+	}
+
+	const siteUrl = nconf.get('url').replace(/\/$/, '');
+	const profileUrl = `${siteUrl}/user/${encodeURIComponent(userslug)}`;
+	res.type('application/jrd+json').json({
+		subject: resource,
+		aliases: [
+			`${siteUrl}/uid/${uid}`,
+			profileUrl,
+		],
+		links: [{
+			rel: 'http://webfinger.net/rel/profile-page',
+			type: 'text/html',
+			href: profileUrl,
+		}],
+	});
+};
