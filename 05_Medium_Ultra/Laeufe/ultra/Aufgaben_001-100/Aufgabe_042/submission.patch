diff --git a/test/well-known.js b/test/well-known.js
new file mode 100644
index 0000000..ed4fee7
--- /dev/null
+++ b/test/well-known.js
@@ -0,0 +1,93 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+const request = require('request-promise-native');
+
+require('./mocks/databasemock');
+
+const privileges = require('../src/privileges');
+const user = require('../src/user');
+const helpers = require('./helpers');
+
+describe('WebFinger', () => {
+	let uid;
+	let userslug;
+	let resource;
+
+	before(async () => {
+		uid = await user.create({ username: 'webfinger-test-user', password: 'barbar' });
+		userslug = await user.getUserField(uid, 'userslug');
+		resource = `acct:${userslug}@${nconf.get('url_parsed').hostname}`;
+	});
+
+	async function getWebFinger(resourceValue, jar) {
+		return await request({
+			url: `${nconf.get('url')}/.well-known/webfinger`,
+			qs: resourceValue === undefined ? undefined : { resource: resourceValue },
+			jar: jar,
+			json: true,
+			simple: false,
+			resolveWithFullResponse: true,
+		});
+	}
+
+	it('returns the user profile in a WebFinger response', async () => {
+		const response = await getWebFinger(resource);
+		const profileUrl = `${nconf.get('url')}/user/${userslug}`;
+
+		assert.strictEqual(response.statusCode, 200);
+		assert(response.headers['content-type'].startsWith('application/jrd+json'));
+		assert.strictEqual(response.body.subject, resource);
+		assert(Array.isArray(response.body.aliases));
+		assert(response.body.aliases.includes(`${nconf.get('url')}/uid/${uid}`));
+		assert(response.body.aliases.includes(profileUrl));
+		assert(Array.isArray(response.body.links));
+		assert(response.body.links.some(link => link.href === profileUrl));
+	});
+
+	it('returns 400 for missing or malformed resources', async () => {
+		const invalidResources = [
+			undefined,
+			`${userslug}@${nconf.get('url_parsed').hostname}`,
+			`acct:${userslug}@elsewhere.example`,
+		];
+
+		for (const invalidResource of invalidResources) {
+			// eslint-disable-next-line no-await-in-loop
+			const response = await getWebFinger(invalidResource);
+			assert.strictEqual(response.statusCode, 400);
+		}
+	});
+
+	it('returns 404 when the account does not exist', async () => {
+		const response = await getWebFinger(`acct:no-such-webfinger-user@${nconf.get('url_parsed').hostname}`);
+		assert.strictEqual(response.statusCode, 404);
+	});
+
+	it('returns 403 for anonymous requests when Guest cannot view users', async () => {
+		await privileges.global.rescind(['groups:view:users'], 'guests');
+		try {
+			const response = await getWebFinger(resource);
+			assert.strictEqual(response.statusCode, 403);
+		} finally {
+			await privileges.global.give(['groups:view:users'], 'guests');
+		}
+	});
+
+	it('allows anonymous requests when Guest can view users', async () => {
+		const response = await getWebFinger(resource);
+		assert.strictEqual(response.statusCode, 200);
+	});
+
+	it('returns 403 when a logged-in user cannot view users', async () => {
+		const { jar } = await helpers.loginUser('webfinger-test-user', 'barbar');
+		await privileges.global.rescind(['groups:view:users'], 'registered-users');
+		try {
+			const response = await getWebFinger(resource, jar);
+			assert.strictEqual(response.statusCode, 403);
+		} finally {
+			await privileges.global.give(['groups:view:users'], 'registered-users');
+		}
+	});
+});
