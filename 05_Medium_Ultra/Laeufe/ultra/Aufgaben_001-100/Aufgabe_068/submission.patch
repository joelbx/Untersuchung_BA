+/** A cached entity may have failed decryption in an aggregated value, such as MailDetails.body. */
+function hasDecryptionErrors(value: unknown, seen: WeakSet<object> = new WeakSet()): boolean {
+	if (value == null || typeof value !== "object" || ArrayBuffer.isView(value) || value instanceof Date || seen.has(value)) {
+		return false
+	}
+	seen.add(value)
+	if ("_errors" in value && value._errors != null && Object.keys(value._errors).length > 0) {
+		return true
+	}
+	return Object.values(value).some((child) => hasDecryptionErrors(child, seen))
+}
