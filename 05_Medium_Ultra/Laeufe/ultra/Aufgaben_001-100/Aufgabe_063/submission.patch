+			config: `proxy_service:
+  kubernetes:
+    enabled: yes
+    listen_addr: 0.0.0.0:4040
+    public_addr: kube.example.com:4040
+`,
+			listenAddr: "0.0.0.0:4040",
+			publicAddr: "kube.example.com:4040",
+		},
+		{
+			name: "shorthand overrides disabled legacy block",
+			config: `proxy_service:
+  kube_listen_addr: 0.0.0.0:8080
+  kubernetes:
+    enabled: no
+    listen_addr: 0.0.0.0:4040
+    public_addr: kube.example.com:4040
+`,
+			listenAddr: "0.0.0.0:8080",
+			publicAddr: "kube.example.com:4040",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fileConfig, err := ReadConfig(bytes.NewBufferString(tt.config))
+			if err != nil {
+				t.Fatal(err)
+			}
+			cfg := service.MakeDefaultConfig()
+			if err := ApplyFileConfig(fileConfig, cfg); err != nil {
+				t.Fatal(err)
+			}
+			if !cfg.Proxy.Kube.Enabled {
+				t.Fatal("Kubernetes proxy was not enabled")
+			}
+			if got := cfg.Proxy.Kube.ListenAddr.String(); got != tt.listenAddr {
+				t.Errorf("listen address = %q, want %q", got, tt.listenAddr)
+			}
+			if tt.publicAddr != "" {
+				if len(cfg.Proxy.Kube.PublicAddrs) != 1 || cfg.Proxy.Kube.PublicAddrs[0].String() != tt.publicAddr {
+					t.Errorf("public addresses = %v, want %q", cfg.Proxy.Kube.PublicAddrs, tt.publicAddr)
+				}
+			}
+		})
+	}
+}
+
+func TestKubeListenAddrConflict(t *testing.T) {
+	config := `proxy_service:
+  kube_listen_addr: 0.0.0.0:8080
+  kubernetes:
+    enabled: yes
+    listen_addr: 0.0.0.0:4040
+`
+	_, err := ReadConfig(bytes.NewBufferString(config))
+	if !trace.IsBadParameter(err) {
+		t.Fatalf("ReadConfig error = %v, want bad parameter", err)
+	}
+	for _, key := range []string{"proxy_service.kube_listen_addr", "proxy_service.kubernetes.enabled"} {
+		if !strings.Contains(err.Error(), key) {
+			t.Errorf("conflict error %q does not mention %s", err, key)
+		}
+	}
+
+	// ApplyFileConfig also validates FileConfig values constructed without YAML.
+	cfg := service.MakeDefaultConfig()
+	fileConfig := &FileConfig{Proxy: Proxy{KubeListenAddr: "0.0.0.0:8080", Kube: KubeProxy{Service: Service{EnabledFlag: "yes"}}}}
+	if err := ApplyFileConfig(fileConfig, cfg); !trace.IsBadParameter(err) {
+		t.Fatalf("ApplyFileConfig error = %v, want bad parameter", err)
+	}
+}
