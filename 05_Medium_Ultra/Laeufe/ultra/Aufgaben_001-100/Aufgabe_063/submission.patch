+func TestInvalidKubeListenAddr(t *testing.T) {
+	fileConfig, err := ReadConfig(bytes.NewBufferString(`proxy_service:
+  kube_listen_addr: "tcp://[broken"
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyFileConfig(fileConfig, service.MakeDefaultConfig()); err == nil || !strings.Contains(err.Error(), "Kubernetes proxy listen address") {
+		t.Fatalf("ApplyFileConfig error = %v, want invalid Kubernetes proxy listen address", err)
+	}
+}
