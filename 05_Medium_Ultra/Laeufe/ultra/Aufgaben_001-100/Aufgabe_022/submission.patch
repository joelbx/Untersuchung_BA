+func Test_redhatBase_parseInstalledPackagesLineFromRepoquery_nonStandardSourceRPM(t *testing.T) {
+	o := &redhatBase{base: base{log: logging.NewIODiscardLogger()}}
+	gotbp, gotsp, err := o.parseInstalledPackagesLineFromRepoquery("elasticsearch 0 8.17.0 1 x86_64 elasticsearch-8.17.0-1-src.rpm @extras")
+	if err != nil {
+		t.Fatalf("parseInstalledPackagesLineFromRepoquery() error = %v", err)
+	}
+	wantbp := &models.Package{Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64", Repository: "extras"}
+	if !reflect.DeepEqual(gotbp, wantbp) {
+		t.Errorf("parseInstalledPackagesLineFromRepoquery() binary package = %v, want %v", gotbp, wantbp)
+	}
+	if gotsp != nil {
+		t.Errorf("parseInstalledPackagesLineFromRepoquery() source package = %v, want nil", gotsp)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
+		t.Errorf("parseInstalledPackagesLineFromRepoquery() warnings = %v, want one for malformed source RPM", o.warns)
+	}
+}
