+bar 1 9 123a ia64 1:bar-9-123a.src.rpm`)
+	if err != nil {
+		t.Fatalf("parseInstalledPackages() error = %v", err)
+	}
+	wantbps := models.Packages{
+		"elasticsearch": {Name: "elasticsearch", Version: "8.17.0", Release: "1", Arch: "x86_64"},
+		"bar":           {Name: "bar", Version: "1:9", Release: "123a", Arch: "ia64"},
+	}
+	wantsps := models.SrcPackages{
+		"bar": {Name: "bar", Version: "1:9-123a", Arch: "src", BinaryNames: []string{"bar"}},
+	}
+	if !reflect.DeepEqual(gotbps, wantbps) {
+		t.Errorf("parseInstalledPackages() binary packages = %v, want %v", gotbps, wantbps)
+	}
+	if !reflect.DeepEqual(gotsps, wantsps) {
+		t.Errorf("parseInstalledPackages() source packages = %v, want %v", gotsps, wantsps)
+	}
+	if len(o.warns) != 1 || !strings.Contains(o.warns[0].Error(), "elasticsearch-8.17.0-1-src.rpm") {
