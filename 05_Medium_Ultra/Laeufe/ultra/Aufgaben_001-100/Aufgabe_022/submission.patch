+func sourceRPMVersion(binaryEpoch, sourceVersion, release string) string {
+	if sourceEpoch, version, found := strings.Cut(sourceVersion, ":"); found {
+		if strings.Trim(sourceEpoch, "0") == "" {
+			return fmt.Sprintf("%s-%s", version, release)
+		}
+		return fmt.Sprintf("%s-%s", sourceVersion, release)
+	}
+	if binaryEpoch == "0" || binaryEpoch == "(none)" {
+		return fmt.Sprintf("%s-%s", sourceVersion, release)
+	}
+	return fmt.Sprintf("%s:%s-%s", binaryEpoch, sourceVersion, release)
+}
+
 // https://github.com/aquasecurity/trivy/blob/51f2123c5ccc4f7a37d1068830b6670b4ccf9ac8/pkg/fanal/analyzer/pkg/rpm/rpm.go#L212-L241
 func splitFileName(filename string) (name, ver, rel string, err error) {
+	actual := filename
+	if !strings.HasSuffix(filename, ".rpm") {
+		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
+	}
 	filename = strings.TrimSuffix(filename, ".rpm")
 
 	archIndex := strings.LastIndex(filename, ".")
-	if archIndex == -1 {
-		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", filename)
+	if archIndex == -1 || archIndex == len(filename)-1 || strings.Contains(filename[archIndex+1:], "-") {
+		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
 	}
 
 	relIndex := strings.LastIndex(filename[:archIndex], "-")
 	if relIndex == -1 {
-		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", filename)
+		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
 	}
 	rel = filename[relIndex+1 : archIndex]
 
 	verIndex := strings.LastIndex(filename[:relIndex], "-")
 	if verIndex == -1 {
-		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", filename)
+		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
 	}
 	ver = filename[verIndex+1 : relIndex]
 
 	name = filename[:verIndex]
+	if name == "" || ver == "" || rel == "" {
+		return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
+	}
+	if epoch, sourceName, found := strings.Cut(name, ":"); found {
+		if epoch == "" || sourceName == "" {
+			return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
+		}
+		for _, digit := range epoch {
+			if digit < '0' || digit > '9' {
+				return "", "", "", xerrors.Errorf("unexpected file name. expected: %q, actual: %q", "<name>-<version>-<release>.<arch>.rpm", actual)
+			}
+		}
+		name = sourceName
+		ver = epoch + ":" + ver
+	}
 	return name, ver, rel, nil
 }
 
