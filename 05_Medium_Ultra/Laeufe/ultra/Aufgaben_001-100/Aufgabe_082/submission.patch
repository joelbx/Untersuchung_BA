+// NewWriterEmitter returns an audit log that writes events to w.
+func NewWriterEmitter(w io.WriteCloser) *WriterEmitter {
+	return &WriterEmitter{
+		writer: w,
+		// Legacy writes share w, while only WriterEmitter owns its close.
+		WriterLog: NewWriterLog(utils.NopWriteCloser(w)),
+	}
+}
+
+// WriterEmitter writes audit events to an external writer and supports the
+// legacy audit log operations provided by WriterLog.
+type WriterEmitter struct {
+	*WriterLog
+	writer io.WriteCloser
+}
+
+// EmitAuditEvent writes one JSON event per line.
+func (w *WriterEmitter) EmitAuditEvent(ctx context.Context, event AuditEvent) error {
+	line, err := utils.FastMarshal(event)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	line = append(line, '\n')
+	n, err := w.writer.Write(line)
+	if err != nil {
+		return trace.ConvertSystemError(err)
+	}
+	if n != len(line) {
+		return trace.ConvertSystemError(io.ErrShortWrite)
+	}
+	return nil
+}
+
+// Close closes the writer and the embedded legacy log.
+func (w *WriterEmitter) Close() error {
+	return trace.NewAggregate(
+		trace.ConvertSystemError(w.writer.Close()),
+		trace.ConvertSystemError(w.WriterLog.Close()),
+	)
+}
