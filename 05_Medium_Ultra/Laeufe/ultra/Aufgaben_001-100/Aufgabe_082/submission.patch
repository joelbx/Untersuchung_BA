+package events
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"testing"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+type testEventWriter struct {
+	bytes.Buffer
+	closeErr   error
+	closeCount int
+	writeErr   error
+	shortWrite bool
+}
+
+func (w *testEventWriter) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	if w.shortWrite {
+		return w.Buffer.Write(p[:1])
+	}
+	return w.Buffer.Write(p)
+}
+
+func (w *testEventWriter) Close() error {
+	w.closeCount++
+	return w.closeErr
+}
+
+func TestNewMultiLogRejectsLoggerWithoutEmitter(t *testing.T) {
+	_, err := NewMultiLog(NewWriterLog(&testEventWriter{}))
+	require.Error(t, err)
+	require.True(t, trace.IsBadParameter(err))
+	require.Contains(t, err.Error(), "*events.WriterLog")
+}
+
+func TestMultiLogEmitsToEveryLogger(t *testing.T) {
+	first, second := &testEventWriter{}, &testEventWriter{}
+	multi, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent, Code: SessionStartCode}}
+	require.NoError(t, multi.EmitAuditEvent(context.Background(), event))
+	require.NotEmpty(t, first.String())
+	require.Equal(t, first.String(), second.String())
+}
+
+func TestWriterEmitterWritesJSONLine(t *testing.T) {
+	writer := &testEventWriter{}
+	emitter := NewWriterEmitter(writer)
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent, Code: SessionStartCode}}
+	require.NoError(t, emitter.EmitAuditEvent(context.Background(), event))
+
+	line := writer.Bytes()
+	require.True(t, bytes.HasSuffix(line, []byte("\n")))
+	require.Equal(t, 1, bytes.Count(line, []byte("\n")))
+	var fields map[string]interface{}
+	require.NoError(t, json.Unmarshal(bytes.TrimSuffix(line, []byte("\n")), &fields))
+	require.Equal(t, SessionStartEvent, fields["event"])
+	require.Equal(t, SessionStartCode, fields["code"])
+}
+
+func TestWriterEmitterWriteErrors(t *testing.T) {
+	event := &SessionStart{Metadata: Metadata{Type: SessionStartEvent, Code: SessionStartCode}}
+	permissionWriter := &testEventWriter{writeErr: os.ErrPermission}
+	err := NewWriterEmitter(permissionWriter).EmitAuditEvent(context.Background(), event)
+	require.Error(t, err)
+	require.True(t, trace.IsAccessDenied(err))
+
+	shortWriter := &testEventWriter{shortWrite: true}
+	err = NewWriterEmitter(shortWriter).EmitAuditEvent(context.Background(), event)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "short write")
+}
+
+func TestWriterEmitterCloseAggregatesErrors(t *testing.T) {
+	firstErr := errors.New("first writer close failed")
+	secondErr := errors.New("embedded writer close failed")
+	first := &testEventWriter{closeErr: firstErr}
+	second := &testEventWriter{closeErr: secondErr}
+	emitter := &WriterEmitter{WriterLog: NewWriterLog(second), writer: first}
+
+	err := emitter.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), firstErr.Error())
+	require.Contains(t, err.Error(), secondErr.Error())
+	require.Equal(t, 1, first.closeCount)
+	require.Equal(t, 1, second.closeCount)
+}
+
+func TestMultiLogCloseAggregatesErrors(t *testing.T) {
+	firstErr := errors.New("first logger close failed")
+	secondErr := errors.New("second logger close failed")
+	first := &testEventWriter{closeErr: firstErr}
+	second := &testEventWriter{closeErr: secondErr}
+	multi, err := NewMultiLog(NewWriterEmitter(first), NewWriterEmitter(second))
+	require.NoError(t, err)
+
+	err = multi.Close()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), firstErr.Error())
+	require.Contains(t, err.Error(), secondErr.Error())
+	require.Equal(t, 1, first.closeCount)
+	require.Equal(t, 1, second.closeCount)
+}
