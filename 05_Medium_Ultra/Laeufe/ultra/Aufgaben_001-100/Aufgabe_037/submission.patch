@@ -39,3 +42,30 @@ def test_to_uuid_invalid_namespace():
     with pytest.raises(AnsibleFilterError) as e:
         to_uuid('example.com', namespace='11111111-2222-3333-4444-555555555')
     assert 'Invalid value' in to_native(e.value)
+
+
+@pytest.mark.parametrize('filter_function, filter_name', (
+    (to_yaml, 'to_yaml'),
+    (to_nice_yaml, 'to_nice_yaml'),
+))
+def test_yaml_filter_undefined_error(filter_function, filter_name):
+    with pytest.raises(AnsibleFilterError) as error:
+        filter_function(AnsibleUndefined(name='MYSVC_ENV'))
+
+    assert filter_name in to_native(error.value)
+    assert 'MYSVC_ENV' in to_native(error.value)
+    assert isinstance(error.value.__cause__, UndefinedError)
+    assert error.value.orig_exc is error.value.__cause__
+
+
+@pytest.mark.parametrize('filter_name', ('to_yaml', 'to_nice_yaml'))
+def test_yaml_filter_undefined_in_template(filter_name):
+    templar = Templar(loader=DictDataLoader({}), variables={})
+    with pytest.raises(AnsibleUndefinedVariable) as error:
+        templar.template('{{ MYSVC_ENV | %s }}' % filter_name)
+
+    assert 'MYSVC_ENV' in to_native(error.value)
+    filter_error = error.value.__cause__
+    assert isinstance(filter_error, AnsibleFilterError)
+    assert filter_name in to_native(filter_error)
+    assert isinstance(filter_error.__cause__, UndefinedError)
