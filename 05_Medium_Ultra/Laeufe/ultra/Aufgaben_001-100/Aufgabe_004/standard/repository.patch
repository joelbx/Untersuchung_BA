+import * as browserHelpers from '@proton/shared/lib/helpers/browser';
+
+import type { CreateModalFormState, PassAliasesVault } from './interface';
+import { usePassAliasesSetup } from './usePassAliasesProviderSetup';
+
+jest.mock('@proton/components/hooks/useAddresses');
+jest.mock('@proton/components/hooks/useAuthentication');
+jest.mock('@proton/components/hooks/useNotifications');
+jest.mock('@proton/components/hooks/useUser');
+jest.mock('@proton/pass/lib/bridge/PassBridgeProvider', () => ({ usePassBridge: jest.fn() }));
+
+describe('usePassAliasesSetup', () => {
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it('loads an empty state without a vault, then creates one before fetching alias options', async () => {
+        const user = {} as ReturnType<typeof useUser>[0];
+        const addresses = [] as ReturnType<typeof useAddresses>[0];
+        const authStore = {} as ReturnType<typeof useAuthentication>;
+        mocked(useUser).mockReturnValue([user, false]);
+        mocked(useAddresses).mockReturnValue([addresses, false]);
+        mocked(useAuthentication).mockReturnValue(authStore);
+        mocked(useNotifications).mockReturnValue({ createNotification: jest.fn() } as any);
+
+        const vault = { shareId: 'new-vault', content: { name: 'Personal' } } as PassAliasesVault;
+        const alias = {
+            item: { aliasEmail: 'alias@example.com', state: ItemState.Active, revisionTime: 10 },
+        } as PassBridgeAliasItem;
+        const options = { mailboxes: [], suffixes: [] } as AliasOptions;
+        const init = jest.fn().mockResolvedValue(true);
+        const getDefault = jest.fn().mockResolvedValue(undefined);
+        const createDefaultVault = jest.fn().mockResolvedValue(vault);
+        const getAllByShareId = jest.fn().mockResolvedValue([alias]);
+        const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 5 } });
+        const getAliasOptions = jest.fn().mockResolvedValue(options);
+        mocked(usePassBridge).mockReturnValue({
+            init,
+            vault: { getDefault, createDefaultVault },
+            alias: { getAllByShareId, getAliasOptions },
+            user: { getUserAccess },
+        } as unknown as PassBridge);
+
+        const { result } = renderHook(() => usePassAliasesSetup());
+        await waitFor(() => expect(result.current.loading).toBe(false));
+
+        expect(init).toHaveBeenCalledWith({ user, addresses, authStore });
+        expect(getDefault).toHaveBeenCalledWith({ maxAge: UNIX_DAY });
+        expect(result.current.hasAliases).toBe(false);
+        expect(result.current.passAliasesItems).toEqual([]);
+        expect(getAllByShareId).not.toHaveBeenCalled();
+        expect(getUserAccess).not.toHaveBeenCalled();
+
+        let returnedOptions: AliasOptions | undefined;
+        await act(async () => {
+            returnedOptions = await result.current.getAliasOptions();
+        });
+
+        expect(createDefaultVault).toHaveBeenCalledTimes(1);
+        expect(getAllByShareId).toHaveBeenCalledWith('new-vault', { maxAge: UNIX_MINUTE * 5 });
+        expect(getUserAccess).toHaveBeenCalledWith({ maxAge: UNIX_MINUTE * 5 });
+        expect(getAliasOptions).toHaveBeenCalledWith('new-vault');
+        expect(returnedOptions).toBe(options);
+        expect(result.current.passAliasesItems).toEqual([alias]);
+        expect(result.current.passAliasesVaultName).toBe('Personal');
+        expect(result.current.hasAliases).toBe(true);
+    });
+
+    it('loads an existing vault and refreshes aliases and the limit state after creation', async () => {
