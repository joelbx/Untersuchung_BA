+import type { PassBridge, PassBridgeAliasItem } from '@proton/pass/lib/bridge/types';
+import { ItemState } from '@proton/pass/types';
+import { UNIX_MINUTE } from '@proton/pass/utils/time/constants';
+
+import { fetchPassAliases, filterPassAliases } from './PassAliasesProvider.helpers';
+import type { PassAliasesVault } from './interface';
+
+const makeAlias = (aliasEmail: string, revisionTime: number, lastUseTime?: number, state = ItemState.Active) =>
+    ({ item: { aliasEmail, revisionTime, lastUseTime, state } }) as PassBridgeAliasItem;
+
+describe('PassAliasesProvider helpers', () => {
+    it('filters trashed aliases and orders active aliases by last use or revision time', () => {
+        const oldest = makeAlias('old@example.com', 10);
+        const recentlyUsed = makeAlias('used@example.com', 5, 30);
+        const newest = makeAlias('new@example.com', 20);
+        const trashed = makeAlias('trashed@example.com', 40, undefined, ItemState.Trashed);
+        const aliases = [oldest, recentlyUsed, trashed, newest];
+
+        expect(filterPassAliases(aliases)).toEqual([recentlyUsed, newest, oldest]);
+        expect(aliases).toEqual([oldest, recentlyUsed, trashed, newest]);
+    });
+
+    it('fetches vault aliases and the alias limit with a five minute cache age', async () => {
+        const active = makeAlias('active@example.com', 10);
+        const trashed = makeAlias('trashed@example.com', 20, undefined, ItemState.Trashed);
+        const getAllByShareId = jest.fn().mockResolvedValue([trashed, active]);
+        const getUserAccess = jest.fn().mockResolvedValue({ plan: { AliasLimit: 7 } });
+        const bridge = { alias: { getAllByShareId }, user: { getUserAccess } } as unknown as PassBridge;
+        const vault = { shareId: 'vault-id' } as PassAliasesVault;
+
+        await expect(fetchPassAliases(bridge, vault)).resolves.toEqual({
+            aliasesCountLimit: 7,
+            filteredAliases: [active],
+            aliases: [trashed, active],
+        });
+        expect(getAllByShareId).toHaveBeenCalledWith('vault-id', { maxAge: UNIX_MINUTE * 5 });
+        expect(getUserAccess).toHaveBeenCalledWith({ maxAge: UNIX_MINUTE * 5 });
+    });
+});
diff --git a/packages/components/components/drawer/views/SecurityCenter/PassAliases/PassAliasesProvider.helpers.ts b/packages/components/components/drawer/views/SecurityCenter/PassAliases/PassAliasesProvider.helpers.ts
