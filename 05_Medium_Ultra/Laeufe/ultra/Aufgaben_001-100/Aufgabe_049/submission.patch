+	it('should display missing, pending, expired, and validated email states', async () => {
+		const userKey = `user:${regularUid}`;
+		const byUidKey = `confirm:byUid:${regularUid}`;
+		const code = `acp-email-status-${regularUid}`;
+		const confirmKey = `confirm:${code}`;
+		const email = 'acp-email-status@example.org';
+		const [originalEmail, originalConfirmed, originalCode] = await Promise.all([
+			db.getObjectField(userKey, 'email'),
+			db.getObjectField(userKey, 'email:confirmed'),
+			db.get(byUidKey),
+		]);
+
+		async function getRow() {
+			const body = await new Promise((resolve, reject) => {
+				request(`${nconf.get('url')}/api/admin/manage/users`, { jar: jar, json: true }, (err, res, body) => {
+					if (err) {
+						return reject(err);
+					}
+					if (res.statusCode !== 200) {
+						return reject(new Error(`Unexpected status code: ${res.statusCode}`));
+					}
+					resolve(body);
+				});
+			});
+			const row = body.users.find(user => parseInt(user.uid, 10) === parseInt(regularUid, 10));
+			assert(row);
+			return row;
+		}
+
+		try {
+			await db.deleteObjectField(userKey, 'email');
+			await db.setObjectField(userKey, 'email:confirmed', 0);
+			await db.delete(byUidKey);
+			assert.strictEqual((await getRow()).emailStatus, 'missing');
+
+			await db.set(byUidKey, code);
+			await db.setObject(confirmKey, { uid: regularUid, email: email, expires: Date.now() + 60000 });
+			let row = await getRow();
+			assert.strictEqual(row.emailStatus, 'pending');
+			assert.strictEqual(row.email, email);
+
+			await db.setObjectField(confirmKey, 'expires', Date.now() - 1);
+			row = await getRow();
+			assert.strictEqual(row.emailStatus, 'expired');
+			assert.strictEqual(row.email, email);
+
+			await db.setObjectField(userKey, 'email', email);
+			await db.setObjectField(userKey, 'email:confirmed', 1);
+			row = await getRow();
+			assert.strictEqual(row.emailStatus, 'validated');
+			assert.strictEqual(row.email, email);
+		} finally {
+			await db.delete(confirmKey);
+			if (originalCode) {
+				await db.set(byUidKey, originalCode);
+			} else {
+				await db.delete(byUidKey);
+			}
+			if (originalEmail !== null && originalEmail !== undefined) {
+				await db.setObjectField(userKey, 'email', originalEmail);
+			} else {
+				await db.deleteObjectField(userKey, 'email');
+			}
+			if (originalConfirmed !== null && originalConfirmed !== undefined) {
