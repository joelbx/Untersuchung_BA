+func isPkgCvesDetactable(r *models.ScanResult) bool {
+	if r.Family == "" {
+		logging.Log.Info("OS family is empty. Skip OVAL and gost detection")
+		return false
+	}
+	if r.Release == "" {
+		logging.Log.Info("OS version is empty. Skip OVAL and gost detection")
+		return false
+	}
+	if len(r.Packages)+len(r.SrcPackages) == 0 {
+		logging.Log.Info("Number of packages is 0. Skip OVAL and gost detection")
+		return false
+	}
+	if isTrivyResult(r) {
+		logging.Log.Info("Scanned by Trivy. Skip OVAL and gost detection")
+		return false
+	}
+	switch r.Family {
+	case constant.FreeBSD, constant.Raspbian, constant.ServerTypePseudo:
+		logging.Log.Infof("%s does not support package CVE detection with OVAL or gost. Skip detection", r.Family)
+		return false
+	}
+	return true
+}
