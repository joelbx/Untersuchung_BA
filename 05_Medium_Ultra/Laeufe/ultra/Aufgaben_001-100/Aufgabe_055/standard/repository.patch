+		name string
+		r    models.ScanResult
+		want bool
+	}{
+		{name: "missing family", r: models.ScanResult{Release: "1", Packages: packages}},
+		{name: "missing version", r: models.ScanResult{Family: constant.Ubuntu, Packages: packages}},
+		{name: "no packages", r: models.ScanResult{Family: constant.Ubuntu, Release: "1"}},
+		{name: "Trivy", r: models.ScanResult{Family: constant.Ubuntu, Release: "1", Packages: packages, ScannedBy: "trivy"}},
+		{name: "FreeBSD", r: models.ScanResult{Family: constant.FreeBSD, Release: "1", Packages: packages}},
