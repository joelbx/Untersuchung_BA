+func TestReuseScannedCves(t *testing.T) {
+	tests := []struct {
+		name   string
+		result models.ScanResult
+		want   bool
+	}{
+		{name: "Trivy without optional metadata", result: models.ScanResult{ScannedBy: "trivy"}, want: true},
+		{name: "legacy optional marker alone", result: models.ScanResult{Optional: map[string]interface{}{"trivy-target": "image"}}},
+		{name: "FreeBSD", result: models.ScanResult{Family: constant.FreeBSD}, want: true},
+		{name: "Raspbian", result: models.ScanResult{Family: constant.Raspbian}, want: true},
+		{name: "other scan", result: models.ScanResult{}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := reuseScannedCves(&tt.result); got != tt.want {
+				t.Errorf("reuseScannedCves() = %t, want %t", got, tt.want)
+			}
+		})
+	}
+}
