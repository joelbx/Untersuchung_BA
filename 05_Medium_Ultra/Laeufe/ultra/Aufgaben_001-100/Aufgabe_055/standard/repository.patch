+func TestSetScanResultMeta(t *testing.T) {
+	cases := map[string]struct {
+		report     types.Report
+		serverName string
+		family     string
+		release    string
+	}{
+		"OS without version": {
+			report: types.Report{
+				ArtifactName: "debian",
+				ArtifactType: ftypes.ArtifactContainerImage,
+				Metadata:     types.Metadata{OS: &ftypes.OS{Family: "debian"}},
+				Results:      types.Results{{Type: "debian", Target: "debian (debian)"}},
+			},
+			serverName: "debian:latest",
+			family:     "debian",
+		},
+		"library-only container without OS": {
+			report: types.Report{
+				ArtifactName: "java-app",
+				ArtifactType: ftypes.ArtifactContainerImage,
+				Results:      types.Results{{Type: ftypes.Jar, Target: "Java"}},
+			},
+			serverName: "java-app:latest",
+			family:     "pseudo",
+		},
+		"library-only tagged container": {
+			report: types.Report{
+				ArtifactName: "java-app:1.2",
+				ArtifactType: ftypes.ArtifactContainerImage,
+				Results:      types.Results{{Type: ftypes.Jar, Target: "Java"}},
+			},
+			serverName: "java-app:1.2",
+			family:     "pseudo",
+		},
+	}
+
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			scanResult := &models.ScanResult{
+				Release:  "old-release",
+				Optional: map[string]interface{}{"trivy-target": "old-target"},
+			}
+			if err := setScanResultMeta(scanResult, &tc.report); err != nil {
+				t.Fatal(err)
+			}
+			if scanResult.ServerName != tc.serverName || scanResult.Family != tc.family || scanResult.Release != tc.release {
+				t.Errorf("metadata = (%q, %q, %q), want (%q, %q, %q)", scanResult.ServerName, scanResult.Family, scanResult.Release, tc.serverName, tc.family, tc.release)
+			}
+			if scanResult.Optional != nil {
+				t.Errorf("Optional = %v, want nil", scanResult.Optional)
+			}
+		})
+	}
+}
