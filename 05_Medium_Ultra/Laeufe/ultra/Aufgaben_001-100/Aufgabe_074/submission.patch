+
+    def test_paths_and_optional_typed_lists(self):
+        def fn(
+            source: Path,
+            files: list[Path] | None = None,
+            names: list[str] | None = None,
+            weights: list[float] | None = None,
+            output: Path | None = None,
+        ):
+            return source, files, names, weights, output
+
+        cli = FnToCLI(fn)
+        args = (
+            'source.txt',
+            '--files',
+            'one.txt',
+            'two.txt',
+            '--names',
+            'first',
+            'second',
+            '--weights',
+            '1.5',
+            '2',
+            '--output',
+            'result.txt',
+        )
+        expected = (
+            Path('source.txt'),
+            [Path('one.txt'), Path('two.txt')],
+            ['first', 'second'],
+            [1.5, 2.0],
+            Path('result.txt'),
+        )
+        assert cli.parse_args(args).source == Path('source.txt')
+        assert cli.run() == expected
+        assert FnToCLI(fn).parse_args(('source.txt',)).files is None
+
