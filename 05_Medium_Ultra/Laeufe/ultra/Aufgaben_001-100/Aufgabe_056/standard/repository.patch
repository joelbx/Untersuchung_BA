@@ -0,0 +1,22 @@
+import { mimeTypeFromFile } from './mimeTypeParser';
+
+describe('mimeTypeFromFile', () => {
+    it.each([
+        ['empty JXL', [], 'photo.jxl', 'image/jxl'],
+        ['small HEIC', ['x'], 'photo.heic', 'image/heic'],
+    ])('detects %s from its extension', async (_description, contents, name, expectedType) => {
+        await expect(mimeTypeFromFile(new File(contents, name))).resolves.toBe(expectedType);
+    });
+
+    it('prefers a specific file MIME type over the extension', async () => {
+        const file = new File(['x'], 'photo.jxl', { type: 'image/png' });
+
+        await expect(mimeTypeFromFile(file)).resolves.toBe('image/png');
+    });
+
+    it('uses the extension when the file MIME type is generic', async () => {
+        const file = new File([], 'photo.jxl', { type: 'application/octet-stream' });
+
+        await expect(mimeTypeFromFile(file)).resolves.toBe('image/jxl');
+    });
+});
