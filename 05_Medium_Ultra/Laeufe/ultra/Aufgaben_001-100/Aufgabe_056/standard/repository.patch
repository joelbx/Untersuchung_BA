@@ -0,0 +1,57 @@
+import { SupportedMimeTypes } from '@proton/shared/lib/drive/constants';
+import { getBrowser, getOS } from '@proton/shared/lib/helpers/browser';
+import { isHEICSupported, isJXLSupported, isSupportedImage } from '@proton/shared/lib/helpers/mimetype';
+
+jest.mock('@proton/shared/lib/helpers/browser');
+
+const mockGetBrowser = jest.mocked(getBrowser);
+const mockGetOS = jest.mocked(getOS);
+
+describe('Safari modern image support', () => {
+    const appleImageTypes = [
+        SupportedMimeTypes.heic,
+        SupportedMimeTypes.heics,
+        SupportedMimeTypes.heif,
+        SupportedMimeTypes.heifs,
+        SupportedMimeTypes.jxl,
+    ];
+
+    beforeEach(() => {
+        jest.resetAllMocks();
+    });
+
+    const setEnvironment = (osName: string, browserName: string, version?: string) => {
+        mockGetOS.mockReturnValue({ name: osName, version: '' });
+        mockGetBrowser.mockReturnValue({ name: browserName, version, major: version?.split('.')[0] });
+    };
+
+    [
+        { os: 'Mac OS', browser: 'Safari', version: '17.0' },
+        { os: 'iOS', browser: 'Mobile Safari', version: '17.1' },
+    ].forEach(({ os, browser: browserName, version }) => {
+        it(`supports HEIC and JXL on ${os} ${browserName} ${version}`, () => {
+            setEnvironment(os, browserName, version);
+
+            expect(isHEICSupported()).toBe(true);
+            expect(isJXLSupported()).toBe(true);
+            appleImageTypes.forEach((mimeType) => expect(isSupportedImage(mimeType)).toBe(true));
+        });
+    });
+
+    [
+        { os: 'Mac OS', browser: 'Safari', version: '16.6' },
+        { os: 'iOS', browser: 'Mobile Safari', version: '16.6' },
+        { os: 'Windows', browser: 'Safari', version: '17.0' },
+        { os: 'Mac OS', browser: 'Chrome', version: '17.0' },
+        { os: 'Mac OS', browser: 'Safari', version: undefined },
+    ].forEach(({ os, browser: browserName, version }) => {
+        it(`rejects HEIC and JXL on ${os} ${browserName} ${version || 'without a version'}`, () => {
+            setEnvironment(os, browserName, version);
+
+            expect(isHEICSupported()).toBe(false);
+            expect(isJXLSupported()).toBe(false);
+            appleImageTypes.forEach((mimeType) => expect(isSupportedImage(mimeType)).toBe(false));
+            expect(isSupportedImage(SupportedMimeTypes.png)).toBe(true);
+        });
+    });
+});
