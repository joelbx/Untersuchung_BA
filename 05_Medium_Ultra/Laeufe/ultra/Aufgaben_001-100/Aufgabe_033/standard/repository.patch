+func (s *WebSuite) TestU2FLoginWithMultipleDevices(c *C) {
+	cap, err := services.NewAuthPreference(services.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F: &services.U2F{
+			AppID:  "https://" + s.server.ClusterName(),
+			Facets: []string{"https://" + s.server.ClusterName()},
+		},
+	})
+	c.Assert(err, IsNil)
+	c.Assert(s.server.Auth().SetAuthPreference(cap), IsNil)
+
+	s.createUser(c, "bob", "root", "password", "")
+	token, err := s.server.Auth().CreateResetPasswordToken(context.TODO(), auth.CreateResetPasswordTokenRequest{
+		Name: "bob",
+	})
+	c.Assert(err, IsNil)
+	regReq, err := s.proxyClient.GetSignupU2FRegisterRequest(token.GetName())
+	c.Assert(err, IsNil)
+	regResp, err := s.mockU2F.RegisterResponse(regReq)
+	c.Assert(err, IsNil)
+	password := []byte("abc123")
+	_, err = s.proxyClient.ChangePasswordWithToken(context.TODO(), auth.ChangePasswordWithTokenRequest{
+		TokenID:             token.GetName(),
+		U2FRegisterResponse: *regResp,
+		Password:            password,
+	})
+	c.Assert(err, IsNil)
+
+	secondKey, err := mocku2f.Create()
+	c.Assert(err, IsNil)
+	secondDevice, err := u2f.NewDevice("backup", &u2f.Registration{
+		KeyHandle: secondKey.KeyHandle,
+		PubKey:    secondKey.PrivateKey.PublicKey,
+	}, s.clock.Now())
+	c.Assert(err, IsNil)
+	c.Assert(s.server.Auth().UpsertMFADevice(context.Background(), "bob", secondDevice), IsNil)
+
+	clt := s.client()
+	re, err := clt.PostJSON(context.Background(), clt.Endpoint("webapi", "u2f", "signrequest"), client.U2fSignRequestReq{
+		User: "bob",
+		Pass: string(password),
+	})
+	c.Assert(err, IsNil)
+	var signReq auth.U2FAuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &signReq), IsNil)
+	c.Assert(len(signReq.Challenges), Equals, 2)
+
+	// Older web clients can continue to decode the flat challenge fields.
+	var legacyReq u2f.AuthenticateChallenge
+	c.Assert(json.Unmarshal(re.Bytes(), &legacyReq), IsNil)
+	legacyInList := false
+	for _, challenge := range signReq.Challenges {
+		if challenge == legacyReq {
+			legacyInList = true
+		}
+	}
+	c.Assert(legacyInList, Equals, true)
+
+	// Authenticate using the key that does not own the flat legacy challenge.
+	var signResp *u2f.AuthenticateChallengeResponse
+	for _, challenge := range signReq.Challenges {
+		if challenge.KeyHandle == legacyReq.KeyHandle {
+			continue
+		}
+		for _, key := range []*mocku2f.Key{s.mockU2F, secondKey} {
+			signResp, err = key.SignResponse(&challenge)
+			if err == nil {
+				break
+			}
+		}
+	}
+	c.Assert(signResp, NotNil)
+	_, err = clt.PostJSON(context.Background(), clt.Endpoint("webapi", "u2f", "sessions"), u2fSignResponseReq{
+		User:            "bob",
+		U2FSignResponse: *signResp,
+	})
+	c.Assert(err, IsNil)
+}
