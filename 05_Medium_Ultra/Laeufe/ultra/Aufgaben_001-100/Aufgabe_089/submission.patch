diff --git a/internal/storage/fs/snapshot_validation_test.go b/internal/storage/fs/snapshot_validation_test.go
new file mode 100644
index 0000000..9eb140d
--- /dev/null
+++ b/internal/storage/fs/snapshot_validation_test.go
@@ -0,0 +1,94 @@
+package fs
+
+import (
+	"context"
+	"io/fs"
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/cue"
+	"go.uber.org/zap"
+)
+
+const validSnapshotFile = `version: "1.2"
+namespace: production
+segments:
+- key: internal
+  name: Internal
+  match_type: ANY_MATCH_TYPE
+flags:
+- key: example
+  name: Example
+  variants:
+  - key: red
+    name: Red
+  rules:
+  - segment: internal
+    distributions:
+    - variant: red
+      rollout: 100
+`
+
+func TestSnapshotConstructorsValidateReferences(t *testing.T) {
+	const path = "config/features.yml"
+	constructors := []struct {
+		name string
+		load func(fs.FS) (*StoreSnapshot, error)
+	}{
+		{
+			name: "paths",
+			load: func(source fs.FS) (*StoreSnapshot, error) {
+				return SnapshotFromPaths(source, path)
+			},
+		},
+		{
+			name: "filesystem",
+			load: func(source fs.FS) (*StoreSnapshot, error) {
+				return SnapshotFromFS(zap.NewNop(), source)
+			},
+		},
+	}
+
+	for _, constructor := range constructors {
+		t.Run(constructor.name, func(t *testing.T) {
+			validFS := fstest.MapFS{path: &fstest.MapFile{Data: []byte(validSnapshotFile)}}
+			snapshot, err := constructor.load(validFS)
+			require.NoError(t, err)
+			assert.Equal(t, "snapshot", snapshot.String())
+			_, err = snapshot.GetFlag(context.Background(), "production", "example")
+			require.NoError(t, err)
+
+			for _, tc := range []struct {
+				name string
+				file string
+				want string
+			}{
+				{
+					name: "unknown variant",
+					file: strings.Replace(validSnapshotFile, "variant: red", "variant: missing", 1),
+					want: `flag production/example rule 0 references unknown variant "missing"`,
+				},
+				{
+					name: "unknown segment",
+					file: strings.Replace(validSnapshotFile, "segment: internal", "segment: missing", 1),
+					want: `flag production/example rule 0 references unknown segment "missing"`,
+				},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					badFS := fstest.MapFS{path: &fstest.MapFile{Data: []byte(tc.file)}}
+					got, err := constructor.load(badFS)
+					require.Nil(t, got)
+					require.Error(t, err)
+					issues, ok := cue.Unwrap(err)
+					require.True(t, ok)
+					require.NotEmpty(t, issues)
+					assert.Contains(t, issues[0].Error(), tc.want)
+					assert.Contains(t, issues[0].Error(), path)
+				})
+			}
+		})
+	}
+}
