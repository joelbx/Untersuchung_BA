+func TestImport_InvalidReferencesAreConsistent(t *testing.T) {
+	tests := []struct {
+		name     string
+		flagType string
+		body     string
+		want     string
+	}{
+		{
+			name:     "missing variant",
+			flagType: "VARIANT_FLAG_TYPE",
+			body: `    rules:
+      - segment: segment1
+        distributions:
+          - variant: missing
+            rollout: 100`,
+			want: `flag team/flag1 rule 0 references unknown variant "missing"`,
+		},
+		{
+			name:     "missing rule segment",
+			flagType: "VARIANT_FLAG_TYPE",
+			body: `    rules:
+      - segment: missing
+        distributions:
+          - variant: variant1
+            rollout: 100`,
+			want: `flag team/flag1 rule 0 references unknown segment "missing"`,
+		},
+		{
+			name:     "missing rule segment in keys",
+			flagType: "VARIANT_FLAG_TYPE",
+			body: `    rules:
+      - segment:
+          keys: [segment1, missing]
+          operator: OR_SEGMENT_OPERATOR
+        distributions:
+          - variant: variant1
+            rollout: 100`,
+			want: `flag team/flag1 rule 0 references unknown segment "missing"`,
+		},
+		{
+			name:     "missing rollout segment",
+			flagType: "BOOLEAN_FLAG_TYPE",
+			body: `    rollouts:
+      - segment:
+          key: missing
+          value: true`,
+			want: `flag team/flag1 rule 0 references unknown segment "missing"`,
+		},
+		{
+			name:     "missing rollout segment in keys",
+			flagType: "BOOLEAN_FLAG_TYPE",
+			body: `    rollouts:
+      - segment:
+          keys: [segment1, missing]
+          operator: OR_SEGMENT_OPERATOR
+          value: true`,
+			want: `flag team/flag1 rule 0 references unknown segment "missing"`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			document := fmt.Sprintf(`version: 1.2
+namespace: team
+flags:
+  - key: flag1
+    name: flag1
+    type: %s
+    variants:
+      - key: variant1
+        name: variant1
+%s
+segments:
+  - key: segment1
+    name: segment1
+    match_type: ANY_MATCH_TYPE
+`, tc.flagType, tc.body)
+
+			creator := &mockCreator{}
+			importer := NewImporter(creator, WithCreateNamespace())
+			for attempt := 0; attempt < 2; attempt++ {
+				err := importer.Import(context.Background(), strings.NewReader(document))
+				assert.EqualError(t, err, tc.want)
+				assert.Equal(t, &mockCreator{}, creator, "attempt %d must not mutate state", attempt+1)
+			}
+		})
+	}
+}
