diff --git a/internal/cache/redis/client.go b/internal/cache/redis/client.go
new file mode 100644
index 0000000..d18d46b
--- /dev/null
+++ b/internal/cache/redis/client.go
@@ -0,0 +1,62 @@
+package redis
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"os"
+
+	goredis "github.com/redis/go-redis/v9"
+	"go.flipt.io/flipt/internal/config"
+)
+
+// NewClient creates a Redis client using the provided cache configuration.
+func NewClient(cfg config.RedisCacheConfig) (*goredis.Client, error) {
+	if cfg.CaCertPath != "" && cfg.CaCertBytes != "" {
+		return nil, errors.New("please provide exclusively one of ca_cert_bytes or ca_cert_path")
+	}
+
+	var tlsConfig *tls.Config
+	if cfg.RequireTLS {
+		tlsConfig = &tls.Config{
+			MinVersion:         tls.VersionTLS12,
+			InsecureSkipVerify: cfg.InsecureSkipTLS, //nolint:gosec // explicitly requested by the operator
+		}
+
+		var caCert []byte
+		switch {
+		case cfg.CaCertPath != "":
+			var err error
+			caCert, err = os.ReadFile(cfg.CaCertPath)
+			if err != nil {
+				return nil, fmt.Errorf("reading redis CA certificate: %w", err)
+			}
+		case cfg.CaCertBytes != "":
+			caCert = []byte(cfg.CaCertBytes)
+		}
+
+		if cfg.CaCertPath != "" || cfg.CaCertBytes != "" {
+			roots := x509.NewCertPool()
+			if !roots.AppendCertsFromPEM(caCert) {
+				return nil, errors.New("invalid redis CA certificate: no certificates found")
+			}
+			tlsConfig.RootCAs = roots
+		}
+	}
+
+	return goredis.NewClient(&goredis.Options{
+		Addr:            fmt.Sprintf("%s:%d", cfg.Host, cfg.Port),
+		TLSConfig:       tlsConfig,
+		Username:        cfg.Username,
+		Password:        cfg.Password,
+		DB:              cfg.DB,
+		PoolSize:        cfg.PoolSize,
+		MinIdleConns:    cfg.MinIdleConn,
+		ConnMaxIdleTime: cfg.ConnMaxIdleTime,
+		DialTimeout:     cfg.NetTimeout,
+		ReadTimeout:     cfg.NetTimeout * 2,
+		WriteTimeout:    cfg.NetTimeout * 2,
+		PoolTimeout:     cfg.NetTimeout * 2,
+	}), nil
+}
diff --git a/internal/cache/redis/client_test.go b/internal/cache/redis/client_test.go
new file mode 100644
index 0000000..683a833
--- /dev/null
+++ b/internal/cache/redis/client_test.go
@@ -0,0 +1,124 @@
+package redis
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestNewClientTLSDefaults(t *testing.T) {
+	plainClient, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, plainClient.Close()) })
+	assert.Nil(t, plainClient.Options().TLSConfig)
+
+	tlsClient, err := NewClient(config.RedisCacheConfig{Host: "localhost", Port: 6379, RequireTLS: true})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, tlsClient.Close()) })
+	assert.Equal(t, uint16(tls.VersionTLS12), tlsClient.Options().TLSConfig.MinVersion)
+	assert.False(t, tlsClient.Options().TLSConfig.InsecureSkipVerify)
+	assert.Nil(t, tlsClient.Options().TLSConfig.RootCAs)
+}
+
+func TestNewClientInsecureTLS(t *testing.T) {
+	client, err := NewClient(config.RedisCacheConfig{RequireTLS: true, InsecureSkipTLS: true})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, client.Close()) })
+	assert.True(t, client.Options().TLSConfig.InsecureSkipVerify)
+}
+
+func TestNewClientCustomCA(t *testing.T) {
+	certPEM, cert := testCACertificate(t)
+	path := filepath.Join(t.TempDir(), "redis-ca.pem")
+	require.NoError(t, os.WriteFile(path, certPEM, 0600))
+
+	for _, test := range []struct {
+		name string
+		cfg  config.RedisCacheConfig
+	}{
+		{name: "inline", cfg: config.RedisCacheConfig{RequireTLS: true, CaCertBytes: string(certPEM)}},
+		{name: "path", cfg: config.RedisCacheConfig{RequireTLS: true, CaCertPath: path}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			client, err := NewClient(test.cfg)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, client.Close()) })
+
+			roots := client.Options().TLSConfig.RootCAs
+			require.NotNil(t, roots)
+			_, err = cert.Verify(x509.VerifyOptions{Roots: roots})
+			require.NoError(t, err)
+		})
+	}
+}
+
+func TestNewClientInvalidCA(t *testing.T) {
+	emptyCAPath := filepath.Join(t.TempDir(), "empty.pem")
+	require.NoError(t, os.WriteFile(emptyCAPath, nil, 0600))
+
+	for _, test := range []struct {
+		name    string
+		cfg     config.RedisCacheConfig
+		message string
+	}{
+		{
+			name:    "both sources",
+			cfg:     config.RedisCacheConfig{CaCertPath: "ca.pem", CaCertBytes: "certificate"},
+			message: "please provide exclusively one of ca_cert_bytes or ca_cert_path",
+		},
+		{
+			name:    "missing file",
+			cfg:     config.RedisCacheConfig{RequireTLS: true, CaCertPath: filepath.Join(t.TempDir(), "missing.pem")},
+			message: "reading redis CA certificate",
+		},
+		{
+			name:    "invalid certificate",
+			cfg:     config.RedisCacheConfig{RequireTLS: true, CaCertBytes: "not PEM"},
+			message: "invalid redis CA certificate",
+		},
+		{
+			name:    "empty certificate file",
+			cfg:     config.RedisCacheConfig{RequireTLS: true, CaCertPath: emptyCAPath},
+			message: "invalid redis CA certificate",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			client, err := NewClient(test.cfg)
+			require.ErrorContains(t, err, test.message)
+			assert.Nil(t, client)
+		})
+	}
+}
+
+func testCACertificate(t *testing.T) ([]byte, *x509.Certificate) {
+	t.Helper()
+
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+
+	template := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+	cert, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), cert
+}
