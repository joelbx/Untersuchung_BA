+// KubeAddr returns the public Kubernetes proxy address for clients.
+func (c ProxyConfig) KubeAddr() (string, error) {
+	if !c.Kube.Enabled {
+		return "", trace.BadParameter("Kubernetes proxy is disabled")
+	}
+
+	publicAddrs := c.Kube.PublicAddrs
+	if len(publicAddrs) == 0 {
+		publicAddrs = c.PublicAddrs
+	}
+	if len(publicAddrs) == 0 {
+		return "", trace.BadParameter("Kubernetes proxy has no public address")
+	}
+
+	host, err := kubePublicHost(publicAddrs[0])
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+
+	return (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)),
+	}).String(), nil
+}
+
+func kubePublicHost(addr utils.NetAddr) (string, error) {
+	if addr.Addr == "" || addr.Path != "" {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+	}
+
+	host, port, err := net.SplitHostPort(addr.Addr)
+	if err == nil {
+		portNum, err := strconv.Atoi(port)
+		if err != nil || portNum < 1 || portNum > 65535 {
+			return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+		}
+	} else {
+		host = addr.Addr
+		if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+			host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+			if net.ParseIP(host) == nil {
+				return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+			}
+		}
+	}
+
+	if host == "" || strings.ContainsAny(host, "/@?#[]%\\ \t\n\r") ||
+		(strings.Contains(host, ":") && net.ParseIP(host) == nil) {
+		return "", trace.BadParameter("invalid Kubernetes proxy public address %q", addr.Addr)
+	}
+	return host, nil
+}
