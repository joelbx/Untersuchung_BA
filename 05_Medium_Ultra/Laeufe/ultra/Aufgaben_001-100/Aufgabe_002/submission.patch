+func TestProxyConfigKubeAddr(t *testing.T) {
+	tests := []struct {
+		name    string
+		config  ProxyConfig
+		want    string
+		wantErr bool
+	}{
+		{
+			name: "Kubernetes public address takes precedence and uses port 3026",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube: KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:443"}},
+				},
+			},
+			want: "https://kube.example.com:3026",
+		},
+		{
+			name: "web public address supplies host only",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://web.example.com:3026",
+		},
+		{
+			name: "IPv6 host",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "[2001:db8::1]:3080"}},
+				Kube:        KubeProxyConfig{Enabled: true},
+			},
+			want: "https://[2001:db8::1]:3026",
+		},
+		{
+			name: "disabled Kubernetes proxy",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+			},
+			wantErr: true,
+		},
+		{
+			name:    "missing public address",
+			config:  ProxyConfig{Kube: KubeProxyConfig{Enabled: true}},
+			wantErr: true,
+		},
+		{
+			name: "invalid first Kubernetes public address",
+			config: ProxyConfig{
+				PublicAddrs: []utils.NetAddr{{Addr: "web.example.com:3080"}},
+				Kube: KubeProxyConfig{
+					Enabled:     true,
+					PublicAddrs: []utils.NetAddr{{Addr: "kube.example.com:invalid"}},
+				},
+			},
+			wantErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.config.KubeAddr()
+			if tt.wantErr {
+				assert.Error(t, err)
+				assert.Empty(t, got)
+				return
+			}
+			assert.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
