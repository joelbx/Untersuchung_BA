+// kubeAddrFromPublicAddr uses a registered proxy's public host with the
+// Kubernetes proxy port. Registered proxies advertise their web address here.
+func kubeAddrFromPublicAddr(publicAddr string) (string, error) {
+	if publicAddr == "" {
+		return "", trace.BadParameter("missing proxy public address")
+	}
+	if !strings.Contains(publicAddr, "://") {
+		publicAddr = "https://" + publicAddr
+	}
+	parsed, err := url.Parse(publicAddr)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	if (parsed.Scheme != "https" && parsed.Scheme != "http" && parsed.Scheme != "tcp") ||
+		parsed.Host == "" || parsed.User != nil || parsed.Path != "" ||
+		parsed.RawQuery != "" || parsed.Fragment != "" {
+		return "", trace.BadParameter("invalid proxy public address %q", publicAddr)
+	}
+	host := parsed.Hostname()
+	if host == "" || strings.HasSuffix(parsed.Host, ":") ||
+		strings.ContainsAny(host, "/@?#[]%\\ \t\n\r") ||
+		(strings.ContainsAny(parsed.Host, "[]") && net.ParseIP(host) == nil) ||
+		(strings.Contains(host, ":") && net.ParseIP(host) == nil) {
+		return "", trace.BadParameter("invalid proxy public host %q", host)
+	}
+	if port := parsed.Port(); port != "" {
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 {
+			return "", trace.BadParameter("invalid proxy public port %q", port)
+		}
+	}
+	return (&url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(host, strconv.Itoa(defaults.KubeProxyListenPort)),
+	}).String(), nil
+}
