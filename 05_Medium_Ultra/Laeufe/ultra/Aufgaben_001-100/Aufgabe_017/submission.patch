+func TestSQLServerErrors(t *testing.T) {
+	p := SQLServerPinger{}
+
+	tests := []struct {
+		name               string
+		pingErr            error
+		wantConnRefusedErr bool
+		wantDBUserErr      bool
+		wantDBNameErr      bool
+	}{
+		{
+			name: "nil error",
+		},
+		{
+			name:               "connection refused",
+			pingErr:            fmt.Errorf("dial tcp: %w", syscall.ECONNREFUSED),
+			wantConnRefusedErr: true,
+		},
+		{
+			name:               "connection refused text",
+			pingErr:            errors.New("dial tcp 127.0.0.1:1433: connection refused"),
+			wantConnRefusedErr: true,
+		},
+		{
+			name:          "invalid user",
+			pingErr:       fmt.Errorf("login: %w", mssql.Error{Number: 18456, Message: "Login failed for user"}),
+			wantDBUserErr: true,
+		},
+		{
+			name:          "forwarded invalid user",
+			pingErr:       mssql.Error{Number: 28353, Message: "Login failed for user 'missing'."},
+			wantDBUserErr: true,
+		},
+		{
+			name:          "invalid database",
+			pingErr:       fmt.Errorf("login: %w", &mssql.Error{Number: 4060, Message: "Cannot open database"}),
+			wantDBNameErr: true,
+		},
+		{
+			name:          "forwarded invalid database",
+			pingErr:       mssql.Error{Number: 28353, Message: "Cannot open database 'missing' requested by the login. The login failed."},
+			wantDBNameErr: true,
+		},
+		{
+			name:          "forwarded nonexistent database",
+			pingErr:       mssql.Error{Number: 28353, Message: "Database 'missing' does not exist."},
+			wantDBNameErr: true,
+		},
+		{
+			name:          "database does not exist",
+			pingErr:       mssql.Error{Number: 911, Message: "Database does not exist"},
+			wantDBNameErr: true,
+		},
+		{
+			name:    "unrelated server error",
+			pingErr: mssql.Error{Number: 1205, Message: "Transaction was deadlocked"},
+		},
+		{
+			name:    "unrelated server error with login text",
+			pingErr: mssql.Error{Number: 1205, Message: "Login failed for user"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.wantConnRefusedErr, p.IsConnectionRefusedError(tt.pingErr))
+			require.Equal(t, tt.wantDBUserErr, p.IsInvalidDatabaseUserError(tt.pingErr))
+			require.Equal(t, tt.wantDBNameErr, p.IsInvalidDatabaseNameError(tt.pingErr))
+		})
+	}
+}
+
+func TestSQLServerPing(t *testing.T) {
+	testServer, err := sqlserver.NewTestServer(common.TestServerConfig{
+		AuthClient: setupMockClient(t),
+	})
+	require.NoError(t, err)
+
+	go func() {
+		if err := testServer.Serve(); err != nil {
+			t.Errorf("SQL Server test server failed: %v", err)
+		}
+	}()
+	t.Cleanup(func() {
+		require.NoError(t, testServer.Close())
+	})
+
+	port, err := strconv.Atoi(testServer.Port())
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+
+	err = (&SQLServerPinger{}).Ping(ctx, PingParams{
+		Port:         port,
+		Username:     "someuser",
+		DatabaseName: "somedb",
+	})
+	require.NoError(t, err)
+}
+
+func TestSQLServerPingValidation(t *testing.T) {
+	p := SQLServerPinger{}
+	valid := PingParams{
+		Host:         "localhost",
+		Port:         1433,
+		Username:     "someuser",
+		DatabaseName: "somedb",
+	}
+
+	for _, tt := range []struct {
+		name   string
+		modify func(*PingParams)
+	}{
+		{name: "missing port", modify: func(params *PingParams) { params.Port = 0 }},
+		{name: "negative port", modify: func(params *PingParams) { params.Port = -1 }},
+		{name: "invalid port", modify: func(params *PingParams) { params.Port = 65536 }},
+		{name: "missing user", modify: func(params *PingParams) { params.Username = "" }},
+		{name: "missing database", modify: func(params *PingParams) { params.DatabaseName = "" }},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			params := valid
+			tt.modify(&params)
+			require.Error(t, p.Ping(context.Background(), params))
+		})
+	}
+}
+
+func TestSQLServerPingContextDeadline(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	release := make(chan struct{})
+	var once sync.Once
+	stopServer := func() { once.Do(func() { close(release) }) }
+	watchdog := time.AfterFunc(2*time.Second, stopServer)
+	t.Cleanup(func() {
+		watchdog.Stop()
+		stopServer()
+		require.NoError(t, listener.Close())
+	})
+
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+
+	// Accept the connection without completing the SQL Server handshake. Ping
+	// must return when its context expires while waiting for the server.
+	go func() {
+		conn, err := listener.Accept()
+		if err == nil {
+			defer conn.Close()
+			<-release
+		}
+	}()
+
+	port := listener.Addr().(*net.TCPAddr).Port
+	start := time.Now()
+	err = (&SQLServerPinger{}).Ping(ctx, PingParams{
+		Host:         "127.0.0.1",
+		Port:         port,
+		Username:     "someuser",
+		DatabaseName: "somedb",
+	})
+	require.Error(t, err)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Less(t, time.Since(start), time.Second)
+}
