+package database
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strings"
+	"syscall"
+
+	"github.com/gravitational/trace"
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/microsoft/go-mssqldb/msdsn"
+	"github.com/sirupsen/logrus"
+
+	"github.com/gravitational/teleport/lib/defaults"
+)
+
+// SQLServerPinger implements database connection checks for SQL Server.
+type SQLServerPinger struct{}
+
+// Ping connects to SQL Server and runs a simple query to check the connection.
+func (p *SQLServerPinger) Ping(ctx context.Context, params PingParams) error {
+	if err := params.CheckAndSetDefaults(defaults.ProtocolSQLServer); err != nil {
+		return trace.Wrap(err)
+	}
+	if params.Port < 1 || params.Port > 65535 {
+		return trace.BadParameter("invalid Port %d", params.Port)
+	}
+	if err := ctx.Err(); err != nil {
+		return trace.Wrap(err)
+	}
+
+	connector := mssql.NewConnectorConfig(msdsn.Config{
+		Host:       params.Host,
+		Port:       uint64(params.Port),
+		User:       params.Username,
+		Database:   params.DatabaseName,
+		Encryption: msdsn.EncryptionDisabled,
+		Protocols:  []string{"tcp"},
+	}, nil)
+	done := make(chan struct{})
+	defer close(done)
+	connector.Dialer = sqlServerPingDialer{ctx: ctx, done: done}
+
+	conn, err := connector.Connect(ctx)
+	if err != nil {
+		if ctx.Err() != nil {
+			return trace.Wrap(ctx.Err())
+		}
+		return trace.Wrap(err)
+	}
+	defer func() {
+		if err := conn.Close(); err != nil {
+			logrus.WithError(err).Info("failed to close connection in SQLServerPinger.Ping")
+		}
+	}()
+
+	mssqlConn, ok := conn.(*mssql.Conn)
+	if !ok {
+		return trace.BadParameter("expected *mssql.Conn, got: %T", conn)
+	}
+	if err := mssqlConn.Ping(ctx); err != nil {
+		if ctx.Err() != nil {
+			return trace.Wrap(ctx.Err())
+		}
+		return trace.Wrap(err)
+	}
+	return nil
+}
+
+// sqlServerPingDialer keeps the TCP connection bound to the Ping context. The
+// SQL Server driver uses its context for dialing, but parts of login do blocking
+// reads after dialing has completed.
+type sqlServerPingDialer struct {
+	ctx  context.Context
+	done <-chan struct{}
+}
+
+func (d sqlServerPingDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	var dialer net.Dialer
+	conn, err := dialer.DialContext(ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	if deadline, ok := d.ctx.Deadline(); ok {
+		if err := conn.SetDeadline(deadline); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	}
+	go func() {
+		select {
+		case <-d.ctx.Done():
+		case <-d.done:
+		}
+		conn.Close()
+	}()
+	return conn, nil
+}
+
+// IsConnectionRefusedError reports whether the SQL Server connection was refused.
+func (p *SQLServerPinger) IsConnectionRefusedError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) {
+		return true
+	}
+	message := strings.ToLower(err.Error())
+	return strings.Contains(message, "connection refused") ||
+		strings.Contains(message, "actively refused")
+}
+
+// IsInvalidDatabaseUserError reports whether SQL Server rejected the user login.
+func (p *SQLServerPinger) IsInvalidDatabaseUserError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if number, ok := sqlServerErrorNumber(err); ok {
+		switch number {
+		case 18456: // Login failed for user.
+			return true
+		case 28353: // The Teleport SQL Server agent forwarded the server error.
+			return strings.Contains(strings.ToLower(err.Error()), "login failed for user")
+		default:
+			return false
+		}
+	}
+	return strings.Contains(strings.ToLower(err.Error()), "login failed for user")
+}
+
+// IsInvalidDatabaseNameError reports whether SQL Server rejected the database name.
+func (p *SQLServerPinger) IsInvalidDatabaseNameError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if number, ok := sqlServerErrorNumber(err); ok {
+		switch number {
+		case 4060, // Cannot open database requested by the login.
+			4064, // Cannot open user default database.
+			911:  // Database does not exist.
+			return true
+		case 28353: // The Teleport SQL Server agent forwarded the server error.
+			return hasInvalidSQLServerDatabaseMessage(err)
+		}
+		return false
+	}
+	return hasInvalidSQLServerDatabaseMessage(err)
+}
+
+func hasInvalidSQLServerDatabaseMessage(err error) bool {
+	message := strings.ToLower(err.Error())
+	return strings.Contains(message, "cannot open database") ||
+		strings.Contains(message, "cannot open user default database") ||
+		(strings.Contains(message, "database") && strings.Contains(message, "does not exist"))
+}
+
+// sqlServerErrorNumber extracts an SQL Server error number from either a value
+// or pointer error, including errors wrapped by trace.Wrap.
+func sqlServerErrorNumber(err error) (int32, bool) {
+	var numbered interface{ SQLErrorNumber() int32 }
+	if errors.As(err, &numbered) {
+		return numbered.SQLErrorNumber(), true
+	}
+	return 0, false
+}
