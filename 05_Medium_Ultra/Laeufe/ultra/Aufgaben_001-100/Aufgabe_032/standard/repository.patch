+    def test_jwrite_replaces_job_file_atomically(self, monkeypatch, tmp_path):
+        job_path = str(tmp_path / 'job')
+        original = {'started': 1, 'finished': 0, 'ansible_job_id': 'job.1'}
+        replacement = {'started': 1, 'finished': 1, 'ansible_job_id': 'job.1'}
+        with open(job_path, 'w') as jobfile:
+            json.dump(original, jobfile)
+
+        monkeypatch.setattr(async_wrapper, 'job_path', job_path, raising=False)
+        rename = os.rename
+        observed = []
+
+        def check_before_rename(source, destination):
+            with open(job_path) as jobfile:
+                observed.append(json.load(jobfile))
+            assert source == job_path + '.tmp'
+            assert destination == job_path
+            with open(source) as jobfile:
+                assert json.load(jobfile) == replacement
+            rename(source, destination)
+
+        monkeypatch.setattr(async_wrapper.os, 'rename', check_before_rename)
+        async_wrapper.jwrite(replacement)
+
+        assert observed == [original]
+        with open(job_path) as jobfile:
+            assert json.load(jobfile) == replacement
+        assert not os.path.exists(job_path + '.tmp')
