+@pytest.mark.parametrize('custom_headers', [
+    {},
+    {'Accept-Language': 'custom-global', 'X-Qute': 'yes'},
+])
+def test_custom_headers_accept_language_fallback(config_stub, custom_headers):
+    headers = config_stub.val.content.headers
+    headers.do_not_track = None
+    headers.accept_language = 'global'
+    headers.custom = custom_headers
+
+    url = QUrl('https://example.com/')
+    other_headers = [(b'X-Qute', b'yes')] if custom_headers else []
+    global_headers = [(b'Accept-Language', b'global')] + other_headers
+
+    assert shared.custom_headers(
+        url=url, fallback_accept_language=False,
+    ) == other_headers
+    assert shared.custom_headers(
+        url=url, fallback_accept_language=True,
+    ) == global_headers
+    assert shared.custom_headers(url=url) == global_headers
+    assert shared.custom_headers(
+        url=None, fallback_accept_language=False,
+    ) == global_headers
+
+
+def test_custom_headers_accept_language_domain_override(config_stub):
+    headers = config_stub.val.content.headers
+    headers.do_not_track = None
+    headers.accept_language = 'global'
+    headers.custom = {}
+    config_stub.set_obj(
+        'content.headers.accept_language',
+        'domain-specific',
+        pattern=urlmatch.UrlPattern('*://example.com/*'),
+    )
+
+    assert shared.custom_headers(
+        url=QUrl('https://example.com/page'),
+        fallback_accept_language=False,
+    ) == [(b'Accept-Language', b'domain-specific')]
+    assert shared.custom_headers(
+        url=QUrl('https://other.example.com/page'),
+        fallback_accept_language=False,
+    ) == []
+
+
