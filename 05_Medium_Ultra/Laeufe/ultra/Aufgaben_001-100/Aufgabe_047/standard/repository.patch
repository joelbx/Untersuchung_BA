+// Hasher keeps an independent seed for each identifier. Its maphash seed
+// initializes identifiers that have not been explicitly seeded.
+type Hasher struct {
+	mu          sync.Mutex
+	seeds       map[string]string
+	seed        maphash.Seed
+	initialized bool
+}
+
+// NewHasher creates a hasher with a random seed for unseeded identifiers.
+func NewHasher() *Hasher {
+	return &Hasher{
+		seeds:       make(map[string]string),
+		seed:        maphash.MakeSeed(),
+		initialized: true,
+	}
 }
 
-func NewHasher() *hasher {
