-	h.seeds = make(map[string]maphash.Seed)
-	return h
+// SetSeed assigns a reproducible seed to the given identifier.
+func (h *Hasher) SetSeed(id, seed string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.initLocked()
+	h.seeds[id] = seed
 }
 
-// Reseed generates a new seed for the given id
-func (h *hasher) Reseed(id string) {
-	h.seeds[id] = maphash.MakeSeed()
+// Reseed generates a new seed for the given id.
+func (h *Hasher) Reseed(id string) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.initLocked()
+	h.reseedLocked(id)
 }
 
-// HashFunc returns a function that hashes a string using the seed for the given id
-func (h *hasher) HashFunc() func(id, str string) uint64 {
+// HashFunc returns a function that hashes a string using the seed for the given id.
+func (h *Hasher) HashFunc() func(id, str string) uint64 {
 	return func(id, str string) uint64 {
-		var hash maphash.Hash
-		var seed maphash.Seed
-		var ok bool
-		if seed, ok = h.seeds[id]; !ok {
-			seed = maphash.MakeSeed()
+		h.mu.Lock()
+		h.initLocked()
+		seed, ok := h.seeds[id]
+		if !ok {
+			seed = strconv.FormatUint(maphash.String(h.seed, id), 16)
 			h.seeds[id] = seed
 		}
-		hash.SetSeed(seed)
+		h.mu.Unlock()
+
+		var hash xxhash.Digest
+		hash.Reset()
+		var seedLength [8]byte
+		binary.LittleEndian.PutUint64(seedLength[:], uint64(len(seed)))
+		_, _ = hash.Write(seedLength[:])
+		_, _ = hash.WriteString(seed)
 		_, _ = hash.WriteString(str)
 		return hash.Sum64()
 	}
 }
+
+func (h *Hasher) initLocked() {
+	if h.seeds == nil {
+		h.seeds = make(map[string]string)
+	}
+	if !h.initialized {
+		h.seed = maphash.MakeSeed()
+		h.initialized = true
+	}
+}
+
+func (h *Hasher) reseedLocked(id string) string {
+	for {
+		seed := strconv.FormatUint(maphash.String(maphash.MakeSeed(), id), 16)
+		if seed != h.seeds[id] {
+			h.seeds[id] = seed
+			return seed
+		}
+	}
+}
diff --git a/utils/hasher/hasher_test.go b/utils/hasher/hasher_test.go
index 3127f78..bfbeb0d 100644
--- a/utils/hasher/hasher_test.go
+++ b/utils/hasher/hasher_test.go
@@ -41,3 +41,50 @@ var _ = Describe("HashFunc", func() {
 		Expect(sum2).To(Equal(hashFunc("2", input)))
 	})
 })
+
+var _ = Describe("SetSeed", func() {
+	const input = "123e4567e89b12d3a456426614174000"
+
+	It("repeats an explicit seed and restores it after reseeding", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("item", "original")
+
+		original := hashFunc("item", input)
+		Expect(hashFunc("item", input)).To(Equal(original))
+
+		h.Reseed("item")
+		Expect(hashFunc("item", input)).NotTo(Equal(original))
+
+		h.SetSeed("item", "original")
+		Expect(hashFunc("item", input)).To(Equal(original))
+		other := hasher.NewHasher()
+		other.SetSeed("item", "original")
+		Expect(other.HashFunc()("item", input)).To(Equal(original))
+	})
+
+	It("keeps seeds for different identifiers independent", func() {
+		h := hasher.NewHasher()
+		hashFunc := h.HashFunc()
+		h.SetSeed("first", "first-seed")
+		h.SetSeed("second", "second-seed")
+		first := hashFunc("first", input)
+		second := hashFunc("second", input)
+
+		h.SetSeed("first", "replacement")
+		Expect(hashFunc("first", input)).NotTo(Equal(first))
+		Expect(hashFunc("second", input)).To(Equal(second))
+	})
+
+	It("sets a seed through the package-level function", func() {
+		hashFunc := hasher.HashFunc()
+		hasher.SetSeed("package-level", "fixed")
+		original := hashFunc("package-level", input)
+
+		hasher.Reseed("package-level")
+		Expect(hashFunc("package-level", input)).NotTo(Equal(original))
+
+		hasher.SetSeed("package-level", "fixed")
+		Expect(hashFunc("package-level", input)).To(Equal(original))
+	})
+})
