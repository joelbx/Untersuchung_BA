+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "diag.h"
+
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/SecCode.h>
+#import <Security/SecTask.h>
+#import <Security/Security.h>
+
+static BOOL hasSignature(void) {
+  SecCodeRef code = NULL;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, &code) != errSecSuccess) {
+    return NO;
+  }
+  BOOL valid = SecCodeCheckValidity(code, kSecCSDefaultFlags, NULL) ==
+               errSecSuccess;
+  CFRelease(code);
+  return valid;
+}
+
+static BOOL hasEntitlements(void) {
+  SecTaskRef task = SecTaskCreateFromSelf(kCFAllocatorDefault);
+  if (!task) {
+    return NO;
+  }
+
+  NSString *teamID = CFBridgingRelease(SecTaskCopyValueForEntitlement(
+      task, CFSTR("com.apple.developer.team-identifier"), NULL));
+  NSString *appID = CFBridgingRelease(SecTaskCopyValueForEntitlement(
+      task, CFSTR("com.apple.application-identifier"), NULL));
+  NSArray *groups = CFBridgingRelease(SecTaskCopyValueForEntitlement(
+      task, CFSTR("keychain-access-groups"), NULL));
+  CFRelease(task);
+
+  if (![teamID isKindOfClass:[NSString class]] || teamID.length == 0 ||
+      ![appID isKindOfClass:[NSString class]] || appID.length == 0 ||
+      ![groups isKindOfClass:[NSArray class]]) {
+    return NO;
+  }
+  NSString *prefix = [teamID stringByAppendingString:@"."];
+  return [appID hasPrefix:prefix] && [groups containsObject:appID];
+}
+
+static BOOL passesLAPolicyTest(void) {
+  LAContext *context = [[LAContext alloc] init];
+  return [context canEvaluatePolicy:LAPolicyDeviceOwnerAuthenticationWithBiometrics
+                             error:NULL];
+}
+
+static BOOL canCreateSecureEnclaveKey(BOOL permanent) {
+  CFErrorRef error = NULL;
+  SecAccessControlRef access = SecAccessControlCreateWithFlags(
+      kCFAllocatorDefault, kSecAttrAccessibleWhenUnlockedThisDeviceOnly,
+      kSecAccessControlPrivateKeyUsage | kSecAccessControlBiometryAny, &error);
+  if (!access) {
+    if (error) {
+      CFRelease(error);
+    }
+    return NO;
+  }
+
+  NSString *identifier = [[NSUUID UUID] UUIDString];
+  NSData *identifierData = [identifier dataUsingEncoding:NSUTF8StringEncoding];
+  NSDictionary *attributes = @{
+    (id)kSecAttrKeyType : (id)kSecAttrKeyTypeECSECPrimeRandom,
+    (id)kSecAttrKeySizeInBits : @256,
+    (id)kSecAttrTokenID : (id)kSecAttrTokenIDSecureEnclave,
+    (id)kSecPrivateKeyAttrs : @{
+      (id)kSecAttrIsPermanent : @(permanent),
+      (id)kSecAttrAccessControl : (__bridge id)access,
+      (id)kSecAttrLabel : identifier,
+      (id)kSecAttrApplicationLabel : identifierData,
+      (id)kSecAttrApplicationTag : identifierData,
+    },
+  };
+  SecKeyRef key =
+      SecKeyCreateRandomKey((__bridge CFDictionaryRef)attributes, &error);
+  if (key && permanent) {
+    // Some macOS versions require an Enclave key to be permanent. Remove the
+    // diagnostic key immediately; its unique label keeps it separate from
+    // registered credentials if the process exits before this call completes.
+    NSDictionary *query = @{
+      (id)kSecClass : (id)kSecClassKey,
+      (id)kSecAttrApplicationLabel : identifierData,
+    };
+    SecItemDelete((__bridge CFDictionaryRef)query);
+  }
+  if (key) {
+    CFRelease(key);
+  }
+  if (error) {
+    CFRelease(error);
+  }
+  CFRelease(access);
+  return key != NULL;
+}
+
+static BOOL passesSecureEnclaveTest(void) {
+  // Prefer a nonpersistent key so ordinary availability checks leave no
+  // keychain entry. Fall back to the permanent form used by Register.
+  return canCreateSecureEnclaveKey(NO) || canCreateSecureEnclaveKey(YES);
+}
+
+TouchIDDiagResult RunTouchIDDiag(void) {
+  TouchIDDiagResult result = {0};
+  result.has_signature = hasSignature();
+  result.has_entitlements = hasEntitlements();
+  result.passed_la_policy_test = passesLAPolicyTest();
+  result.passed_secure_enclave_test = passesSecureEnclaveTest();
+  return result;
+}
