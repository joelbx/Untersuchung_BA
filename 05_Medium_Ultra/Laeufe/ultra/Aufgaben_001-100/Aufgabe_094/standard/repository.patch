+
+typedef struct TouchIDDiagResult {
+  int has_signature;
+  int has_entitlements;
+  int passed_la_policy_test;
+  int passed_secure_enclave_test;
+} TouchIDDiagResult;
+
+// RunTouchIDDiag checks the conditions needed to create and use a biometric
