+
+var (
+	nativeDiagOnce   sync.Once
+	nativeDiagResult DiagResult
+)
+
+func nativeDiag() (*DiagResult, error) {
+	// The Secure Enclave probe creates a key, so run it only once per process.
+	// Copy the cached value so callers cannot change future availability checks.
+	nativeDiagOnce.Do(func() {
+		nativeResult := C.RunTouchIDDiag()
+		nativeDiagResult = DiagResult{
+			HasCompileSupport:       true,
+			HasSignature:            nativeResult.has_signature != 0,
+			HasEntitlements:         nativeResult.has_entitlements != 0,
+			PassedLAPolicyTest:      nativeResult.passed_la_policy_test != 0,
+			PassedSecureEnclaveTest: nativeResult.passed_secure_enclave_test != 0,
+		}
+		nativeDiagResult.IsAvailable = nativeDiagResult.HasCompileSupport && nativeDiagResult.HasSignature &&
+			nativeDiagResult.HasEntitlements && nativeDiagResult.PassedLAPolicyTest &&
+			nativeDiagResult.PassedSecureEnclaveTest
+	})
+	result := nativeDiagResult
+	return &result, nil
 }
 
