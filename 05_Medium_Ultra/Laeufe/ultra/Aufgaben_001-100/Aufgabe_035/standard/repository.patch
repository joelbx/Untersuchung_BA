@@ -0,0 +1,92 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	flipt "github.com/markphelps/flipt/rpc"
+	"github.com/markphelps/flipt/storage"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var _ storage.Evaluator = &evaluatorMock{}
+
+type evaluatorMock struct {
+	evaluateFn func(context.Context, *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error)
+}
+
+func (m *evaluatorMock) Evaluate(ctx context.Context, r *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+	return m.evaluateFn(ctx, r)
+}
+
+func TestEvaluate(t *testing.T) {
+	t.Run("delegates with generated request ID", func(t *testing.T) {
+		req := &flipt.EvaluationRequest{FlagKey: "flagKey", EntityId: "entityID"}
+		ctx := context.Background()
+		called := false
+		s := &Server{Evaluator: &evaluatorMock{evaluateFn: func(gotCtx context.Context, gotReq *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+			called = true
+			assert.Equal(t, ctx, gotCtx)
+			assert.True(t, req == gotReq)
+			assert.Regexp(t, `^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`, gotReq.RequestId)
+			return &flipt.EvaluationResponse{
+				FlagKey:  gotReq.FlagKey,
+				EntityId: gotReq.EntityId,
+			}, nil
+		}}}
+
+		resp, err := s.Evaluate(ctx, req)
+		require.NoError(t, err)
+		require.True(t, called)
+		require.NotNil(t, resp)
+		assert.Equal(t, req.RequestId, resp.RequestId)
+		assert.Equal(t, req.FlagKey, resp.FlagKey)
+		assert.Equal(t, req.EntityId, resp.EntityId)
+		assert.True(t, resp.RequestDurationMillis > 0)
+	})
+
+	t.Run("preserves supplied request ID", func(t *testing.T) {
+		req := &flipt.EvaluationRequest{FlagKey: "flagKey", EntityId: "entityID", RequestId: "existing-id"}
+		s := &Server{Evaluator: &evaluatorMock{evaluateFn: func(_ context.Context, gotReq *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+			assert.Equal(t, "existing-id", gotReq.RequestId)
+			return &flipt.EvaluationResponse{}, nil
+		}}}
+
+		resp, err := s.Evaluate(context.Background(), req)
+		require.NoError(t, err)
+		assert.Equal(t, "existing-id", resp.RequestId)
+	})
+
+	for _, tt := range []struct {
+		name    string
+		req     *flipt.EvaluationRequest
+		wantErr error
+	}{
+		{"empty flag key", &flipt.EvaluationRequest{EntityId: "entityID"}, emptyFieldError("flagKey")},
+		{"empty entity ID", &flipt.EvaluationRequest{FlagKey: "flagKey"}, emptyFieldError("entityId")},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			s := &Server{Evaluator: &evaluatorMock{evaluateFn: func(context.Context, *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+				t.Fatal("evaluator called with invalid request")
+				return nil, nil
+			}}}
+
+			resp, err := s.Evaluate(context.Background(), tt.req)
+			assert.Nil(t, resp)
+			assert.Equal(t, tt.wantErr, err)
+		})
+	}
+
+	t.Run("propagates evaluator error", func(t *testing.T) {
+		wantErr := errors.New("evaluation failed")
+		s := &Server{Evaluator: &evaluatorMock{evaluateFn: func(context.Context, *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+			return nil, wantErr
+		}}}
+
+		resp, err := s.Evaluate(context.Background(), &flipt.EvaluationRequest{FlagKey: "flagKey", EntityId: "entityID"})
+		assert.Nil(t, resp)
+		assert.Equal(t, wantErr, err)
+	})
+}
