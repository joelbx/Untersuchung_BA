diff --git a/storage/evaluator.go b/storage/evaluator.go
new file mode 100644
index 0000000..f5182a3
--- /dev/null
+++ b/storage/evaluator.go
@@ -0,0 +1,429 @@
+package storage
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"hash/crc32"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	sq "github.com/Masterminds/squirrel"
+	"github.com/gofrs/uuid"
+	"github.com/golang/protobuf/ptypes"
+	flipt "github.com/markphelps/flipt/rpc"
+	"github.com/sirupsen/logrus"
+)
+
+// Evaluator evaluates a flag for an entity.
+type Evaluator interface {
+	Evaluate(ctx context.Context, r *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error)
+}
+
+var _ Evaluator = &EvaluatorStorage{}
+
+// EvaluatorStorage is a SQL-backed Evaluator.
+type EvaluatorStorage struct {
+	logger  logrus.FieldLogger
+	builder sq.StatementBuilderType
+}
+
+// NewEvaluatorStorage creates an EvaluatorStorage.
+func NewEvaluatorStorage(logger logrus.FieldLogger, builder sq.StatementBuilderType) *EvaluatorStorage {
+	return &EvaluatorStorage{
+		logger:  logger.WithField("storage", "evaluator"),
+		builder: builder,
+	}
+}
+
+type optionalConstraint struct {
+	ID       sql.NullString
+	Type     sql.NullInt64
+	Property sql.NullString
+	Operator sql.NullString
+	Value    sql.NullString
+}
+
+type constraint struct {
+	Type     flipt.ComparisonType
+	Property string
+	Operator string
+	Value    string
+}
+
+type rule struct {
+	ID          string
+	SegmentKey  string
+	Constraints []constraint
+}
+
+type distribution struct {
+	ID         string
+	RuleID     string
+	VariantID  string
+	Rollout    float32
+	VariantKey string
+}
+
+// Evaluate evaluates a request for a given flag and entity.
+func (s *EvaluatorStorage) Evaluate(ctx context.Context, r *flipt.EvaluationRequest) (*flipt.EvaluationResponse, error) {
+	if r == nil {
+		return nil, ErrInvalid("evaluation request is nil")
+	}
+
+	requestID := r.RequestId
+	if requestID == "" {
+		id, err := uuid.NewV4()
+		if err != nil {
+			return nil, err
+		}
+		requestID = id.String()
+	}
+
+	ts, err := ptypes.TimestampProto(time.Now().UTC())
+	if err != nil {
+		return nil, err
+	}
+	resp := &flipt.EvaluationResponse{
+		RequestId:      requestID,
+		EntityId:       r.EntityId,
+		FlagKey:        r.FlagKey,
+		RequestContext: r.Context,
+		Timestamp:      ts,
+	}
+	logger := s.logger.WithField("request", r)
+	logger.Debug("evaluate")
+
+	var enabled bool
+	err = s.builder.Select("enabled").
+		From("flags").
+		Where(sq.Eq{"key": r.FlagKey}).
+		QueryRowContext(ctx).
+		Scan(&enabled)
+	if err != nil {
+		if err == sql.ErrNoRows {
+			return resp, ErrNotFoundf("flag %q", r.FlagKey)
+		}
+		return resp, err
+	}
+	if !enabled {
+		return resp, ErrInvalidf("flag %q is disabled", r.FlagKey)
+	}
+
+	rules, err := s.rules(ctx, r.FlagKey)
+	if err != nil {
+		return resp, err
+	}
+	for _, rule := range rules {
+		matches := true
+		for _, c := range rule.Constraints {
+			value, present := r.Context[c.Property]
+			match, err := matchesConstraint(c, value, present)
+			if err != nil {
+				return resp, err
+			}
+			if !match {
+				matches = false
+				break
+			}
+		}
+		if !matches {
+			continue
+		}
+
+		resp.SegmentKey = rule.SegmentKey
+		distributions, buckets, err := s.distributions(ctx, rule.ID)
+		if err != nil {
+			return resp, err
+		}
+		if len(distributions) == 0 {
+			resp.Match = true
+			return resp, nil
+		}
+
+		matched, selected := evaluate(r, distributions, buckets)
+		resp.Match = matched
+		if resp.Match {
+			resp.Value = selected.VariantKey
+		}
+		return resp, nil
+	}
+
+	return resp, nil
+}
+
+// rules retains SQL rank order while grouping the rows produced by the constraint join.
+func (s *EvaluatorStorage) rules(ctx context.Context, flagKey string) (rules []*rule, err error) {
+	rows, err := s.builder.Select("r.id", "r.segment_key", "c.id", "c.type", "c.property", "c.operator", "c.value").
+		From("rules r").
+		LeftJoin("constraints c ON (r.segment_key = c.segment_key)").
+		Where(sq.Eq{"r.flag_key": flagKey}).
+		OrderBy("r.rank ASC", "r.id ASC", "c.id ASC").
+		QueryContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if closeErr := rows.Close(); err == nil {
+			err = closeErr
+		}
+	}()
+
+	byID := make(map[string]*rule)
+	for rows.Next() {
+		var (
+			id, segmentKey string
+			optional       optionalConstraint
+		)
+		if err := rows.Scan(&id, &segmentKey, &optional.ID, &optional.Type, &optional.Property, &optional.Operator, &optional.Value); err != nil {
+			return nil, err
+		}
+		current := byID[id]
+		if current == nil {
+			current = &rule{ID: id, SegmentKey: segmentKey}
+			byID[id] = current
+			rules = append(rules, current)
+		}
+		if optional.ID.Valid {
+			current.Constraints = append(current.Constraints, constraint{
+				Type:     flipt.ComparisonType(optional.Type.Int64),
+				Property: optional.Property.String,
+				Operator: optional.Operator.String,
+				Value:    optional.Value.String,
+			})
+		}
+	}
+	return rules, rows.Err()
+}
+
+// distributions returns positive rollouts in a stable order and their cumulative cutoffs.
+func (s *EvaluatorStorage) distributions(ctx context.Context, ruleID string) (distributions []distribution, buckets []int, err error) {
+	rows, err := s.builder.Select("d.id", "d.rule_id", "d.variant_id", "d.rollout", "v.key").
+		From("distributions d").
+		Join("variants v ON (d.variant_id = v.id)").
+		Where(sq.Eq{"d.rule_id": ruleID}).
+		OrderBy("d.created_at ASC", "d.id ASC").
+		QueryContext(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer func() {
+		if closeErr := rows.Close(); err == nil {
+			err = closeErr
+		}
+	}()
+
+	cutoff := 0
+	for rows.Next() {
+		var d distribution
+		if err := rows.Scan(&d.ID, &d.RuleID, &d.VariantID, &d.Rollout, &d.VariantKey); err != nil {
+			return nil, nil, err
+		}
+		if d.Rollout <= 0 {
+			continue
+		}
+		cutoff += int(d.Rollout * percentMultiplier)
+		distributions = append(distributions, d)
+		buckets = append(buckets, cutoff)
+	}
+	return distributions, buckets, rows.Err()
+}
+
+func evaluate(r *flipt.EvaluationRequest, distributions []distribution, buckets []int) (bool, distribution) {
+	bucket := int(crc32Num(r.EntityId, r.FlagKey))
+	// A boundary bucket belongs to the distribution whose cutoff equals it.
+	index := sort.Search(len(buckets), func(i int) bool { return buckets[i] >= bucket })
+	if index == len(distributions) {
+		return false, distribution{}
+	}
+	return true, distributions[index]
+}
+
+func crc32Num(entityID, flagKey string) uint {
+	return uint(crc32.ChecksumIEEE([]byte(flagKey+entityID))) % totalBucketNum
+}
+
+const (
+	opEQ         = "eq"
+	opNEQ        = "neq"
+	opLT         = "lt"
+	opLTE        = "lte"
+	opGT         = "gt"
+	opGTE        = "gte"
+	opEmpty      = "empty"
+	opNotEmpty   = "notempty"
+	opTrue       = "true"
+	opFalse      = "false"
+	opPresent    = "present"
+	opNotPresent = "notpresent"
+	opPrefix     = "prefix"
+	opSuffix     = "suffix"
+)
+
+var (
+	validOperators = map[string]struct{}{
+		opEQ: {}, opNEQ: {}, opLT: {}, opLTE: {}, opGT: {}, opGTE: {},
+		opEmpty: {}, opNotEmpty: {}, opTrue: {}, opFalse: {},
+		opPresent: {}, opNotPresent: {}, opPrefix: {}, opSuffix: {},
+	}
+	noValueOperators = map[string]struct{}{
+		opEmpty: {}, opNotEmpty: {}, opPresent: {}, opNotPresent: {},
+		opTrue: {}, opFalse: {},
+	}
+	stringOperators = map[string]struct{}{
+		opEQ: {}, opNEQ: {}, opEmpty: {}, opNotEmpty: {}, opPrefix: {}, opSuffix: {},
+	}
+	numberOperators = map[string]struct{}{
+		opEQ: {}, opNEQ: {}, opLT: {}, opLTE: {}, opGT: {}, opGTE: {},
+		opPresent: {}, opNotPresent: {},
+	}
+	booleanOperators = map[string]struct{}{
+		opTrue: {}, opFalse: {}, opPresent: {}, opNotPresent: {},
+	}
+	decimalNumber = regexp.MustCompile(`^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$`)
+)
+
+const (
+	totalBucketNum    uint    = 1000
+	percentMultiplier float32 = float32(totalBucketNum) / 100
+)
+
+func normalizedOperator(operator string) string {
+	return strings.ToLower(strings.TrimSpace(operator))
+}
+
+func validate(c constraint) error {
+	if strings.TrimSpace(c.Property) == "" {
+		return ErrInvalid("empty property")
+	}
+	op := normalizedOperator(c.Operator)
+	if op == "" {
+		return ErrInvalid("empty operator")
+	}
+	if _, ok := validOperators[op]; !ok {
+		return ErrInvalidf("unsupported operator: %q", op)
+	}
+	return nil
+}
+
+func matchesConstraint(c constraint, value string, present bool) (bool, error) {
+	if err := validate(c); err != nil {
+		return false, err
+	}
+	c.Operator = normalizedOperator(c.Operator)
+	switch c.Type {
+	case flipt.ComparisonType_STRING_COMPARISON_TYPE:
+		if _, ok := stringOperators[c.Operator]; !ok {
+			return false, ErrInvalidf("constraint operator %q is not valid for type string", c.Operator)
+		}
+		return matchesString(c, value), nil
+	case flipt.ComparisonType_NUMBER_COMPARISON_TYPE:
+		if _, ok := numberOperators[c.Operator]; !ok {
+			return false, ErrInvalidf("constraint operator %q is not valid for type number", c.Operator)
+		}
+		if !present && c.Operator != opPresent && c.Operator != opNotPresent {
+			return false, nil
+		}
+		return matchesNumber(c, value)
+	case flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE:
+		if _, ok := booleanOperators[c.Operator]; !ok {
+			return false, ErrInvalidf("constraint operator %q is not valid for type boolean", c.Operator)
+		}
+		if !present && c.Operator != opPresent && c.Operator != opNotPresent {
+			return false, nil
+		}
+		return matchesBool(c, value)
+	default:
+		return false, ErrInvalid("unknown constraint type")
+	}
+}
+
+func matchesString(c constraint, value string) bool {
+	value = strings.TrimSpace(value)
+	compare := strings.TrimSpace(c.Value)
+	switch normalizedOperator(c.Operator) {
+	case opEQ:
+		return value == compare
+	case opNEQ:
+		return value != compare
+	case opEmpty:
+		return value == ""
+	case opNotEmpty:
+		return value != ""
+	case opPrefix:
+		return strings.HasPrefix(value, compare)
+	case opSuffix:
+		return strings.HasSuffix(value, compare)
+	}
+	return false
+}
+
+func parseDecimal(value string) (float64, error) {
+	trimmed := strings.TrimSpace(value)
+	if !decimalNumber.MatchString(trimmed) {
+		return 0, fmt.Errorf("parsing number from %q", value)
+	}
+	number, err := strconv.ParseFloat(trimmed, 64)
+	if err != nil || math.IsNaN(number) || math.IsInf(number, 0) {
+		return 0, fmt.Errorf("parsing number from %q", value)
+	}
+	return number, nil
+}
+
+func matchesNumber(c constraint, value string) (bool, error) {
+	value = strings.TrimSpace(value)
+	switch normalizedOperator(c.Operator) {
+	case opPresent:
+		return value != "", nil
+	case opNotPresent:
+		return value == "", nil
+	}
+	number, err := parseDecimal(value)
+	if err != nil {
+		return false, err
+	}
+	compare, err := parseDecimal(c.Value)
+	if err != nil {
+		return false, err
+	}
+	switch normalizedOperator(c.Operator) {
+	case opEQ:
+		return number == compare, nil
+	case opNEQ:
+		return number != compare, nil
+	case opLT:
+		return number < compare, nil
+	case opLTE:
+		return number <= compare, nil
+	case opGT:
+		return number > compare, nil
+	case opGTE:
+		return number >= compare, nil
+	}
+	return false, nil
+}
+
+func matchesBool(c constraint, value string) (bool, error) {
+	value = strings.TrimSpace(value)
+	switch normalizedOperator(c.Operator) {
+	case opPresent:
+		return value != "", nil
+	case opNotPresent:
+		return value == "", nil
+	}
+	parsed, err := strconv.ParseBool(value)
+	if err != nil {
+		return false, fmt.Errorf("parsing boolean from %q", value)
+	}
+	switch normalizedOperator(c.Operator) {
+	case opTrue:
+		return parsed, nil
+	case opFalse:
+		return !parsed, nil
+	}
+	return false, nil
+}
