+package storage
+
+import (
+	"context"
+	"fmt"
+	"hash/crc32"
+	"strings"
+	"testing"
+	"time"
+
+	sq "github.com/Masterminds/squirrel"
+	"github.com/golang/protobuf/ptypes"
+	flipt "github.com/markphelps/flipt/rpc"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func createEvaluatorFlag(t *testing.T, suffix string, enabled bool) string {
+	t.Helper()
+	key := t.Name() + "/" + suffix
+	_, err := flagStore.CreateFlag(context.Background(), &flipt.CreateFlagRequest{
+		Key: key, Name: key, Enabled: enabled,
+	})
+	require.NoError(t, err)
+	return key
+}
+
+func createEvaluatorRule(t *testing.T, flagKey, suffix string, rank int32) (*flipt.Rule, *flipt.Segment) {
+	t.Helper()
+	key := flagKey + "/" + suffix
+	segment, err := segmentStore.CreateSegment(context.Background(), &flipt.CreateSegmentRequest{
+		Key: key, Name: key,
+	})
+	require.NoError(t, err)
+	rule, err := ruleStore.CreateRule(context.Background(), &flipt.CreateRuleRequest{
+		FlagKey: flagKey, SegmentKey: segment.Key, Rank: rank,
+	})
+	require.NoError(t, err)
+	return rule, segment
+}
+
+func createEvaluatorConstraint(t *testing.T, segmentKey string, typ flipt.ComparisonType, property, operator, value string) *flipt.Constraint {
+	t.Helper()
+	c, err := segmentStore.CreateConstraint(context.Background(), &flipt.CreateConstraintRequest{
+		SegmentKey: segmentKey, Type: typ, Property: property, Operator: operator, Value: value,
+	})
+	require.NoError(t, err)
+	return c
+}
+
+func TestEvaluatorStorageFlagErrorsAndResponse(t *testing.T) {
+	evaluator := evaluatorStore
+	ctx := context.Background()
+
+	_, err := evaluator.Evaluate(ctx, &flipt.EvaluationRequest{FlagKey: t.Name() + "/missing", EntityId: "entity"})
+	require.IsType(t, ErrNotFound(""), err)
+	assert.EqualError(t, err, fmt.Sprintf("flag %q not found", t.Name()+"/missing"))
+
+	disabledKey := createEvaluatorFlag(t, "disabled", false)
+	_, err = evaluator.Evaluate(ctx, &flipt.EvaluationRequest{FlagKey: disabledKey, EntityId: "entity"})
+	require.IsType(t, ErrInvalid(""), err)
+	assert.EqualError(t, err, fmt.Sprintf("flag %q is disabled", disabledKey))
+
+	flagKey := createEvaluatorFlag(t, "enabled", true)
+	requestContext := map[string]string{"region": "us", "tier": "gold"}
+	req := &flipt.EvaluationRequest{
+		RequestId: "original-request-id", FlagKey: flagKey, EntityId: "entity", Context: requestContext,
+	}
+	before := time.Now().UTC()
+	resp, err := evaluator.Evaluate(ctx, req)
+	after := time.Now().UTC()
+	require.NoError(t, err)
+	require.NotNil(t, resp)
+	assert.False(t, resp.Match)
+	assert.Empty(t, resp.SegmentKey)
+	assert.Empty(t, resp.Value)
+	assert.Equal(t, req.RequestId, resp.RequestId)
+	assert.Equal(t, req.FlagKey, resp.FlagKey)
+	assert.Equal(t, req.EntityId, resp.EntityId)
+	assert.Equal(t, requestContext, resp.RequestContext)
+	require.NotNil(t, resp.Timestamp)
+	ts, err := ptypes.Timestamp(resp.Timestamp)
+	require.NoError(t, err)
+	assert.Equal(t, time.UTC, ts.Location())
+	assert.False(t, ts.Before(before))
+	assert.False(t, ts.After(after))
+
+	generated, err := evaluator.Evaluate(ctx, &flipt.EvaluationRequest{FlagKey: flagKey, EntityId: "entity"})
+	require.NoError(t, err)
+	assert.Regexp(t, `^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`, generated.RequestId)
+}
+
+func TestEvaluatorStorageEvaluatesRulesByRank(t *testing.T) {
+	ctx := context.Background()
+	flagKey := createEvaluatorFlag(t, "flag", true)
+	_, later := createEvaluatorRule(t, flagKey, "later", 20)
+	createEvaluatorConstraint(t, later.Key, flipt.ComparisonType_STRING_COMPARISON_TYPE, "tier", "eq", "gold")
+	_, first := createEvaluatorRule(t, flagKey, "first", 1)
+	createEvaluatorConstraint(t, first.Key, flipt.ComparisonType_STRING_COMPARISON_TYPE, "tier", "eq", "gold")
+	createEvaluatorConstraint(t, first.Key, flipt.ComparisonType_STRING_COMPARISON_TYPE, "region", "eq", "us")
+
+	for _, tc := range []struct {
+		name, tier, region, segment string
+		match                       bool
+	}{
+		{"first matching rank wins", "gold", "us", first.Key, true},
+		{"later rank after first misses", "gold", "eu", later.Key, true},
+		{"all constraints required", "silver", "us", "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			resp, err := evaluatorStore.Evaluate(ctx, &flipt.EvaluationRequest{
+				FlagKey: flagKey, EntityId: "entity", Context: map[string]string{"tier": tc.tier, "region": tc.region},
+			})
+			require.NoError(t, err)
+			assert.Equal(t, tc.match, resp.Match)
+			assert.Equal(t, tc.segment, resp.SegmentKey)
+			assert.Empty(t, resp.Value)
+		})
+	}
+}
+
+func TestEvaluatorStorageTypedOperators(t *testing.T) {
+	const (
+		stringType = flipt.ComparisonType_STRING_COMPARISON_TYPE
+		numberType = flipt.ComparisonType_NUMBER_COMPARISON_TYPE
+		boolType   = flipt.ComparisonType_BOOLEAN_COMPARISON_TYPE
+	)
+
+	cases := []struct {
+		name, operator, value, contextValue string
+		typ                                 flipt.ComparisonType
+		present, match, wantError           bool
+	}{
+		{"string eq trims both values", "eq", " gold ", "\tgold  ", stringType, true, true, false},
+		{"string neq", "neq", "gold", " silver ", stringType, true, true, false},
+		{"string empty without value", "empty", "", " \t ", stringType, true, true, false},
+		{"string notempty without value", "notempty", "", " gold ", stringType, true, true, false},
+		{"prefix trims both values", "prefix", " gold ", " gold-tier ", stringType, true, true, false},
+		{"suffix trims both values", "suffix", " tier ", " gold-tier ", stringType, true, true, false},
+		{"number eq decimal", "eq", "1.20", "1.2", numberType, true, true, false},
+		{"number neq", "neq", "1.2", "2.0", numberType, true, true, false},
+		{"number lt", "lt", "2.0", "1.2", numberType, true, true, false},
+		{"number lte equal", "lte", "1.2", "1.2", numberType, true, true, false},
+		{"number gt", "gt", "1.2", "2.0", numberType, true, true, false},
+		{"number gte equal", "gte", "1.2", "1.2", numberType, true, true, false},
+		{"number present without value", "present", "", "1.2", numberType, true, true, false},
+		{"number notpresent without value", "notpresent", "", "", numberType, false, true, false},
+		{"boolean true without value", "true", "", "TRUE", boolType, true, true, false},
+		{"boolean false without value", "false", "", "0", boolType, true, true, false},
+		{"boolean present without value", "present", "", "true", boolType, true, true, false},
+		{"boolean notpresent without value", "notpresent", "", "", boolType, false, true, false},
+		{"number invalid context", "eq", "1.2", "not-a-number", numberType, true, false, true},
+		{"number invalid constraint", "eq", "not-a-number", "1.2", numberType, true, false, true},
+		{"number present empty context", "eq", "1.2", "", numberType, true, false, true},
+		{"number present whitespace context", "eq", "1.2", " \t ", numberType, true, false, true},
+		{"number absent context", "eq", "1.2", "", numberType, false, false, false},
+		{"boolean invalid context", "true", "", "maybe", boolType, true, false, true},
+		{"boolean present empty context", "true", "", "", boolType, true, false, true},
+		{"boolean present whitespace context", "true", "", " \t ", boolType, true, false, true},
+		{"boolean absent context", "true", "", "", boolType, false, false, false},
+		{"string mismatch", "eq", "gold", "silver", stringType, true, false, false},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			flagKey := createEvaluatorFlag(t, "flag", true)
+			_, segment := createEvaluatorRule(t, flagKey, "segment", 1)
+			c := createEvaluatorConstraint(t, segment.Key, tc.typ, "subject", tc.operator, tc.value)
+
+			// API writes normalize operators. Store uppercase to exercise SQL reads too.
+			_, err := evaluatorStore.(*EvaluatorStorage).builder.Update("constraints").
+				Set("operator", strings.ToUpper(tc.operator)).
+				Where(sq.Eq{"id": c.Id}).ExecContext(context.Background())
+			require.NoError(t, err)
+
+			requestContext := map[string]string{}
+			if tc.present {
+				requestContext["subject"] = tc.contextValue
+			}
+			resp, err := evaluatorStore.Evaluate(context.Background(), &flipt.EvaluationRequest{
+				FlagKey: flagKey, EntityId: "entity", Context: requestContext,
+			})
+			if tc.wantError {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.match, resp.Match)
+			if tc.match {
+				assert.Equal(t, segment.Key, resp.SegmentKey)
+			} else {
+				assert.Empty(t, resp.SegmentKey)
+				assert.Empty(t, resp.Value)
+			}
+		})
+	}
+}
+
+func entityForBucket(t *testing.T, flagKey string, wanted uint32) string {
+	t.Helper()
+	for i := 0; i < 100000; i++ {
+		id := fmt.Sprintf("entity-%d", i)
+		if crc32.ChecksumIEEE([]byte(flagKey+id))%1000 == wanted {
+			return id
+		}
+	}
+	t.Fatalf("could not find entity in bucket %d", wanted)
+	return ""
+}
+
+func TestEvaluatorStorageDistributionCutoffs(t *testing.T) {
+	ctx := context.Background()
+	flagKey := createEvaluatorFlag(t, "flag", true)
+	rule, segment := createEvaluatorRule(t, flagKey, "segment", 1)
+
+	for _, tc := range []struct {
+		key     string
+		rollout float32
+	}{
+		{"first", 50},
+		{"second", 50},
+	} {
+		variant, err := flagStore.CreateVariant(ctx, &flipt.CreateVariantRequest{
+			FlagKey: flagKey, Key: flagKey + "/" + tc.key, Name: tc.key,
+		})
+		require.NoError(t, err)
+		_, err = ruleStore.CreateDistribution(ctx, &flipt.CreateDistributionRequest{
+			FlagKey: flagKey, RuleId: rule.Id, VariantId: variant.Id, Rollout: tc.rollout,
+		})
+		require.NoError(t, err)
+	}
+
+	for _, tc := range []struct {
+		bucket uint32
+		key    string
+	}{
+		{0, "first"},
+		{500, "first"},
+		{501, "second"},
+		{999, "second"},
+	} {
+		t.Run(fmt.Sprintf("bucket %d", tc.bucket), func(t *testing.T) {
+			entityID := entityForBucket(t, flagKey, tc.bucket)
+			req := &flipt.EvaluationRequest{FlagKey: flagKey, EntityId: entityID}
+			for i := 0; i < 3; i++ {
+				resp, err := evaluatorStore.Evaluate(ctx, req)
+				require.NoError(t, err)
+				assert.True(t, resp.Match)
+				assert.Equal(t, segment.Key, resp.SegmentKey)
+				assert.Equal(t, flagKey+"/"+tc.key, resp.Value)
+			}
+		})
+	}
+}
+
+func TestEvaluatorStorageZeroRolloutStillMatchesRule(t *testing.T) {
+	for _, withZeroDistribution := range []bool{false, true} {
+		t.Run(fmt.Sprintf("zero distribution: %t", withZeroDistribution), func(t *testing.T) {
+			ctx := context.Background()
+			flagKey := createEvaluatorFlag(t, "flag", true)
+			rule, segment := createEvaluatorRule(t, flagKey, "segment", 1)
+			if withZeroDistribution {
+				variant, err := flagStore.CreateVariant(ctx, &flipt.CreateVariantRequest{
+					FlagKey: flagKey, Key: flagKey + "/zero", Name: "zero",
+				})
+				require.NoError(t, err)
+				_, err = ruleStore.CreateDistribution(ctx, &flipt.CreateDistributionRequest{
+					FlagKey: flagKey, RuleId: rule.Id, VariantId: variant.Id, Rollout: 0,
+				})
+				require.NoError(t, err)
+			}
+			resp, err := evaluatorStore.Evaluate(ctx, &flipt.EvaluationRequest{
+				FlagKey: flagKey, EntityId: "entity",
+			})
+			require.NoError(t, err)
+			assert.True(t, resp.Match)
+			assert.Equal(t, segment.Key, resp.SegmentKey)
+			assert.Empty(t, resp.Value)
+		})
+	}
+}
