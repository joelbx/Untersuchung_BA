diff --git a/utils/paths.go b/utils/paths.go
new file mode 100644
index 0000000..9ce2dab
--- /dev/null
+++ b/utils/paths.go
@@ -0,0 +1,22 @@
+package utils
+
+import (
+	"os"
+
+	"github.com/navidrome/navidrome/log"
+)
+
+// IsDirReadable reports whether path can be opened by the operating system.
+func IsDirReadable(path string) (bool, error) {
+	dir, err := os.Open(path)
+	if err != nil {
+		return false, err
+	}
+	defer func() {
+		if err := dir.Close(); err != nil {
+			log.Warn("Error closing directory", "path", path, err)
+		}
+	}()
+
+	return true, nil
+}
