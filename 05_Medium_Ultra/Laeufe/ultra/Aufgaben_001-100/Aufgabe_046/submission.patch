+def build_payload(module_source):
+    stream = BytesIO()
+    names = set()
+    cache = {}
+    with zipfile.ZipFile(stream, mode='w', compression=zipfile.ZIP_STORED) as payload:
+        module_common.recursive_finder('example', MODULE_FQN, module_source.encode('utf-8'), names, cache, payload)
+    with zipfile.ZipFile(stream) as payload:
+        return dict((name, payload.read(name)) for name in payload.namelist())
+
