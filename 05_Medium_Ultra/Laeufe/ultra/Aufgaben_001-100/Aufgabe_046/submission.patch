+@pytest.mark.parametrize('suffix, expected_suffixes', [
+    (('missing',), [('missing',)]),
+    (('missing', 'attribute'), [('missing', 'attribute'), ('missing',)]),
+])
+def test_collection_locator_ambiguity_starts_below_module_utils(collection_file, suffix, expected_suffixes):
+    collection_file('testns.source', 'plugins/module_utils/exists.py', 'VALUE = 1\n')
+    root = tuple(MODULE_UTILS.split('.'))
+
+    locator = module_common.CollectionModuleUtilLocator(root + suffix, is_ambiguous=True)
+
+    assert locator.candidate_names_joined() == ['.'.join(root + candidate) for candidate in expected_suffixes]
