+def get_service_ip(image_name: str) -> str:
+    """Get a Compose service container's IP address from Docker inspect."""
+    container_name = image_name
+    if not container_name.startswith("openlibrary-"):
+        container_name = f"openlibrary-{container_name}"
+    if not container_name.rsplit("-", 1)[-1].isdigit():
+        container_name = f"{container_name}-1"
+
+    result = subprocess.run(
+        [
+            "docker",
+            "inspect",
+            "--format",
+            "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}",
+            container_name,
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    ip_address = result.stdout.strip()
+    if not ip_address:
+        raise ValueError(f"No IP address found for {container_name}")
+    return ip_address
