+import asyncio
+from unittest.mock import AsyncMock, patch
+
+from scripts.monitoring import monitor
+
+
+def test_monitor_haproxy_uses_local_container_and_production_delivery():
+    with (
+        patch.object(monitor, "get_service_ip", return_value="172.23.0.5") as get_ip,
+        patch.object(monitor.haproxy_monitor, "main", new_callable=AsyncMock) as collect,
+    ):
+        asyncio.run(monitor.monitor_haproxy())
+
+    get_ip.assert_called_once_with("web_haproxy")
+    collect.assert_awaited_once_with(
+        haproxy_url="http://172.23.0.5:7072/admin?stats", dry_run=False
+    )
