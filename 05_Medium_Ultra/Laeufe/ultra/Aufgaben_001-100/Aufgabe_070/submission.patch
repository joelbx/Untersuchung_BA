+def _language_name_key(name: str) -> str:
+    """Compare language names without differences in case or accents."""
+    return ''.join(
+        character
+        for character in normalize('NFKD', name.strip().casefold())
+        if not combining(character)
+    )
+
+
+@cache
+def _locale_language_names() -> dict[str, set[str]]:
+    """Index the English and native names supplied by the installed CLDR data."""
+    from babel import Locale, localedata
+
+    names: dict[str, set[str]] = {}
+    for iso_code in localedata.locale_identifiers():
+        if len(iso_code) != 2 or not iso_code.isascii() or not iso_code.isalpha():
+            continue
+        locale = Locale.parse(iso_code)
+        for name in (locale.get_display_name('en'), locale.get_display_name(iso_code)):
+            names.setdefault(_language_name_key(name), set()).add(iso_code)
+    return names
+
+
+def _add_language_match(index: dict[str, set[str]], name: str, code: str) -> None:
+    index.setdefault(_language_name_key(name), set()).add(code)
+
+
+def _load_language_matches(site) -> tuple[
+    dict[str, set[str]], dict[str, set[str]], dict[str, set[str]]
+]:
+    """Read current language records without relying on the shared site cache."""
+    iso_codes: dict[str, set[str]] = {}
+    english_names: dict[str, set[str]] = {}
+    native_names: dict[str, set[str]] = {}
+    offset = 0
+    while keys := site.things(
+        {'type': '/type/language', 'limit': 1000, 'offset': offset}
+    ):
+        for record in site.get_many(keys):
+            if not record or record.get('deprecated'):
+                continue
+            code = record.get('code')
+            if not code:
+                continue
+            code = code.casefold()
+
+            if name := record.get('name'):
+                _add_language_match(english_names, name, code)
+
+            translated = record.get('name_translated') or {}
+            for name in translated.get('en', []) or []:
+                _add_language_match(english_names, name, code)
+
+            identifiers = record.get('identifiers') or {}
+            for iso_code in identifiers.get('iso_639_1', []) or []:
+                iso_code = iso_code.strip().casefold()
+                iso_codes.setdefault(iso_code, set()).add(code)
+                for name in translated.get(iso_code, []) or []:
+                    _add_language_match(native_names, name, code)
+
+        if len(keys) < 1000:
+            break
+        offset += len(keys)
+
+    return iso_codes, english_names, native_names
+
+
+def _sole_language_match(codes: set[str] | None, language: str) -> str | None:
+    if not codes:
+        return None
+    if len(codes) != 1:
+        raise InvalidLanguage(language)
+    return next(iter(codes))
+
+
+def _iso_to_marc(
+    iso_code: str,
+    language: str,
+    site,
+    iso_codes: dict[str, set[str]],
+    english_names: dict[str, set[str]],
+) -> str | None:
+    from babel import Locale
+    from babel.core import UnknownLocaleError
+
+    from openlibrary.plugins.upstream.utils import get_marc21_language
+
+    if code := _sole_language_match(iso_codes.get(iso_code), language):
+        return code
+
+    # Records without ISO identifiers can still be matched by their English
+    # name. This also avoids incorrect entries in the older fallback map.
+    try:
+        english_name = Locale.parse(iso_code).get_display_name('en')
+    except UnknownLocaleError:
+        english_name = None
+
+    if english_name and (
+        code := _sole_language_match(
+            english_names.get(_language_name_key(english_name)), language
+        )
+    ):
+        return code
+
+    code = get_marc21_language(iso_code)
+    record = site.get(f'/languages/{code}') if code else None
+    if record is None:
+        return None
+    if english_name and (record_name := record.get('name')):
+        expected = _language_name_key(english_name)
+        actual = _language_name_key(record_name)
+        if actual != expected and not actual.startswith((expected + ',', expected + ' (')):
+            return None
+    return code
+
+
