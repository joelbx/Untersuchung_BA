+
+import React from 'react';
+import { act, render, waitFor } from '@testing-library/react';
+import { logger } from 'matrix-js-sdk/src/logger';
+
+import MatrixClientContext from '../../../../../src/contexts/MatrixClientContext';
+import { DevicesState, useOwnDevices } from '../../../../../src/components/views/settings/devices/useOwnDevices';
+import { getMockClientWithEventEmitter, mockClientMethodsUser } from '../../../../test-utils';
+
+describe('useOwnDevices', () => {
+    const deviceId = 'alices_device';
+    const mockClient = getMockClientWithEventEmitter({
+        ...mockClientMethodsUser(),
+        getDeviceId: jest.fn().mockReturnValue(deviceId),
+        getDevices: jest.fn(),
+        getStoredCrossSigningForUser: jest.fn().mockReturnValue({
+            checkDeviceTrust: () => ({ isCrossSigningVerified: () => false }),
+        }),
+        getStoredDevice: jest.fn().mockReturnValue({}),
+        setDeviceDetails: jest.fn(),
+    });
+    let state: DevicesState;
+
+    const Probe = () => {
+        state = useOwnDevices();
+        return <span data-testid="device-name">{ state.devices[deviceId]?.display_name }</span>;
+    };
+
+    const renderHook = async () => {
+        const result = render(<MatrixClientContext.Provider value={mockClient}>
+            <Probe />
+        </MatrixClientContext.Provider>);
+        await waitFor(() => expect(result.getByTestId('device-name').textContent).toEqual('Old name'));
+        return result;
+    };
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+        mockClient.getDevices.mockResolvedValue({ devices: [{ device_id: deviceId, display_name: 'Old name' }] });
+        mockClient.setDeviceDetails.mockResolvedValue({});
+    });
+
+    it('persists a new name, including an empty string, and updates loaded device state', async () => {
+        const { getByTestId } = await renderHook();
+
+        await act(async () => state.saveDeviceName(deviceId, 'Work laptop'));
+        expect(mockClient.setDeviceDetails).toHaveBeenCalledWith(deviceId, { display_name: 'Work laptop' });
+        expect(getByTestId('device-name').textContent).toEqual('Work laptop');
+
+        await act(async () => state.saveDeviceName(deviceId, ''));
+        expect(mockClient.setDeviceDetails).toHaveBeenCalledWith(deviceId, { display_name: '' });
+        expect(getByTestId('device-name').textContent).toEqual('');
+    });
+
+    it('propagates a clear error and preserves the loaded name if the save fails', async () => {
+        const logSpy = jest.spyOn(logger, 'error').mockImplementation(() => {});
+        mockClient.setDeviceDetails.mockRejectedValue(new Error('Network error'));
+        const { getByTestId } = await renderHook();
+
+        await act(async () => {
+            await expect(state.saveDeviceName(deviceId, 'New name')).rejects.toThrow('Failed to set display name.');
+        });
+        expect(getByTestId('device-name').textContent).toEqual('Old name');
+        logSpy.mockRestore();
+    });
+});
