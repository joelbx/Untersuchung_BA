new file mode 100644
index 0000000..fd71354
--- /dev/null
+++ b/src/components/views/settings/devices/DeviceDetailHeading.tsx
@@ -0,0 +1,149 @@
+/*
+Copyright 2022 The Matrix.org Foundation C.I.C.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect, useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Field from '../../elements/Field';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+/** The name and rename form shown at the top of a session's details. */
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [savedName, setSavedName] = useState<{ deviceId: string, name: string }>();
+    const [draftName, setDraftName] = useState('');
+    const [isEditing, setIsEditing] = useState(false);
+    const [isSaving, setIsSaving] = useState(false);
+    const [hasError, setHasError] = useState(false);
+
+    // A refresh or a different selected session should replace a local save.
+    useEffect(() => {
+        setSavedName(undefined);
+        setIsEditing(false);
+        setHasError(false);
+    }, [device.device_id, device.display_name]);
+
+    const displayName = savedName?.deviceId === device.device_id ? savedName.name : device.display_name;
+    const visibleName = displayName ?? device.device_id;
+
+    const startEditing = (): void => {
+        setDraftName(visibleName);
+        setHasError(false);
+        setIsEditing(true);
+    };
+
+    const cancelEditing = (): void => {
+        setHasError(false);
+        setIsEditing(false);
+    };
+
+    const save = async (): Promise<void> => {
+        if (isSaving) return;
+        if (draftName === visibleName) {
+            setIsEditing(false);
+            return;
+        }
+
+        setIsSaving(true);
+        setHasError(false);
+        try {
+            await saveDeviceName(device.device_id, draftName);
+            setSavedName({ deviceId: device.device_id, name: draftName });
+            setIsEditing(false);
+        } catch {
+            setHasError(true);
+        } finally {
+            setIsSaving(false);
+        }
+    };
+
+    if (!isEditing) {
+        return <div className='mx_DeviceDetailHeading' data-testid='device-detail-heading'>
+            <Heading size='h3' data-testid='device-detail-heading-name'>{ visibleName }</Heading>
+            <AccessibleButton
+                kind='link_inline'
+                onClick={startEditing}
+                data-testid='device-detail-heading-rename'
+            >
+                { _t('Rename') }
+            </AccessibleButton>
+        </div>;
+    }
+
+    return <form
+        className='mx_DeviceDetailHeading_edit'
+        data-testid='device-detail-heading-edit'
+        aria-busy={isSaving}
+        onSubmit={(event) => {
+            event.preventDefault();
+            void save();
+        }}
+    >
+        <Field
+            label={_t('Session name')}
+            type='text'
+            value={draftName}
+            maxLength={100}
+            autoComplete='off'
+            autoFocus
+            disabled={isSaving}
+            data-testid='device-detail-heading-input'
+            onChange={(event) => setDraftName(event.target.value.slice(0, 100))}
+        />
+        <p className='mx_DeviceDetailHeading_visibility'>
+            { _t('Session names may be visible to people you communicate with.') }
+        </p>
+        { hasError && <p
+            className='mx_DeviceDetailHeading_error'
+            role='alert'
+            data-testid='device-detail-heading-error'
+        >
+            { _t('Failed to set display name') + '.' }
+        </p> }
+        <div className='mx_DeviceDetailHeading_actions'>
+            <AccessibleButton
+                kind='primary_sm'
+                onClick={() => { void save(); }}
+                disabled={isSaving}
+                data-testid='device-detail-heading-save'
+            >
+                { _t('Save') }
+                { isSaving && <span
+                    className='mx_DeviceDetailHeading_spinner'
+                    data-testid='device-detail-heading-spinner'
+                    role='status'
+                >
+                    <Spinner w={16} h={16} />
+                </span> }
+            </AccessibleButton>
+            <AccessibleButton
+                kind='link_inline'
+                onClick={cancelEditing}
+                disabled={isSaving}
+                data-testid='device-detail-heading-cancel'
+            >
+                { _t('Cancel') }
+            </AccessibleButton>
+        </div>
+    </form>;
+};
