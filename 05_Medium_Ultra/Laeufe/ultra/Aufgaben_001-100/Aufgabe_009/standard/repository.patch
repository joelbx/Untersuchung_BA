+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from 'react';
+import { act, fireEvent, render } from '@testing-library/react';
+
+import { DeviceDetailHeading } from '../../../../../src/components/views/settings/devices/DeviceDetailHeading';
+
+describe('<DeviceDetailHeading />', () => {
+    const device = { device_id: 'device-id', display_name: 'Original name', isVerified: false };
+
+    it('shows the device ID when a display name is unavailable', () => {
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={{ device_id: device.device_id, isVerified: false }}
+            saveDeviceName={jest.fn()}
+        />);
+        expect(getByTestId('device-detail-heading-name').textContent).toBe(device.device_id);
+    });
+
+    it('opens an edit form with a length limit and visibility notice, then cancels without saving', () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        const input = getByTestId('device-detail-heading-input') as HTMLInputElement;
+        expect(input.value).toBe('Original name');
+        expect(input.maxLength).toBe(100);
+        expect(getByTestId('device-detail-heading-edit').textContent)
+            .toMatch(/visible to people you communicate with/i);
+
+        fireEvent.change(input, { target: { value: 'A'.repeat(101) } });
+        expect(input.value).toHaveLength(100);
+
+        fireEvent.change(input, { target: { value: 'Unsaved name' } });
+        fireEvent.click(getByTestId('device-detail-heading-cancel'));
+
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading').textContent).toContain('Original name');
+        expect(saveDeviceName).not.toHaveBeenCalled();
+    });
+
+    it('closes without an API call when the name is unchanged', async () => {
+        const saveDeviceName = jest.fn();
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        await act(async () => {
+            fireEvent.click(getByTestId('device-detail-heading-save'));
+        });
+
+        expect(saveDeviceName).not.toHaveBeenCalled();
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading-name').textContent).toBe('Original name');
+    });
+
+    it('shows progress and immediately displays a saved name', async () => {
+        let resolveSave: () => void;
+        const saveDeviceName = jest.fn(() => new Promise<void>(resolve => { resolveSave = resolve; }));
+        const { getByTestId, queryByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Work Laptop' } });
+        fireEvent.click(getByTestId('device-detail-heading-save'));
+
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', 'Work Laptop');
+        expect(getByTestId('device-detail-heading-spinner')).toBeTruthy();
+
+        await act(async () => { resolveSave(); });
+
+        expect(queryByTestId('device-detail-heading-edit')).toBeNull();
+        expect(getByTestId('device-detail-heading-name').textContent).toBe('Work Laptop');
+    });
+
+    it('accepts an empty name', async () => {
+        const saveDeviceName = jest.fn().mockResolvedValue(undefined);
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: '' } });
+        await act(async () => { fireEvent.click(getByTestId('device-detail-heading-save')); });
+
+        expect(saveDeviceName).toHaveBeenCalledWith('device-id', '');
+        expect(getByTestId('device-detail-heading')).toBeTruthy();
+    });
+
+    it('shows the required error message when saving fails', async () => {
+        const saveDeviceName = jest.fn().mockRejectedValue(new Error('network failure'));
+        const { getByTestId } = render(<DeviceDetailHeading
+            device={device}
+            saveDeviceName={saveDeviceName}
+        />);
+
+        fireEvent.click(getByTestId('device-detail-heading-rename'));
+        fireEvent.change(getByTestId('device-detail-heading-input'), { target: { value: 'Home PC' } });
+        await act(async () => { fireEvent.click(getByTestId('device-detail-heading-save')); });
+
+        expect(getByTestId('device-detail-heading-error').textContent).toBe('Failed to set display name.');
+        expect(getByTestId('device-detail-heading-edit')).toBeTruthy();
+    });
+});
