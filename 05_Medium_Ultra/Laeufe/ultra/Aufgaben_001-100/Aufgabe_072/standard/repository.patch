@@ -0,0 +1,99 @@
+import { useRef } from 'react';
+
+import { fireEvent, render, screen } from '@testing-library/react';
+
+import { MailSettings } from '@proton/shared/lib/interfaces';
+
+import { useLinkHandler } from './useLinkHandler';
+
+const mockCreateNotification = jest.fn();
+
+jest.mock('../components', () => ({
+    useModalState: () => {
+        const [open, setOpen] = jest.requireActual('react').useState(false);
+        return [{ open }, setOpen];
+    },
+}));
+
+jest.mock('../components/notifications/LinkConfirmationModal', () => ({
+    __esModule: true,
+    default: ({ link, open }: { link?: string; open: boolean }) =>
+        jest
+            .requireActual('react')
+            .createElement('div', { 'data-testid': 'link-confirmation', 'data-open': open }, link),
+}));
+
+jest.mock('./index', () => ({
+    useHandler: (handler: (event: Event) => void) => handler,
+    useNotifications: () => ({ createNotification: mockCreateNotification }),
+}));
+
+const TestLinkHandler = ({ href, confirmLink }: { href?: string; confirmLink?: number }) => {
+    const wrapperRef = useRef<HTMLDivElement>(null);
+    const { modal } = useLinkHandler(wrapperRef, { ConfirmLink: confirmLink } as MailSettings);
+
+    return (
+        <div ref={wrapperRef}>
+            <a data-testid="link" href={href}>
+                Link
+            </a>
+            {modal}
+        </div>
+    );
+};
+
+describe('useLinkHandler', () => {
+    beforeEach(() => mockCreateNotification.mockClear());
+
+    it('shows the punycode hostname in external link confirmation', () => {
+        render(<TestLinkHandler href="https://www.аррӏе.com/path?next=https://example.com/#section" confirmLink={1} />);
+
+        fireEvent.click(screen.getByTestId('link'));
+
+        expect(screen.getByTestId('link-confirmation')).toHaveAttribute('data-open', 'true');
+        expect(screen.getByTestId('link-confirmation')).toHaveTextContent(
+            'https://www.xn--80ak6aa92e.com/path?next=https://example.com/#section'
+        );
+    });
+
+    it('uses the punycode URL for direct external navigation', () => {
+        render(<TestLinkHandler href="https://www.аррӏе.com/path?query=1#section" confirmLink={0} />);
+
+        const link = screen.getByTestId('link');
+        fireEvent.click(link);
+
+        expect(link).toHaveAttribute('href', 'https://www.xn--80ak6aa92e.com/path?query=1#section');
+        expect(screen.getByTestId('link-confirmation')).toHaveAttribute('data-open', 'false');
+    });
+
+    it('shows an error notification when an anchor has no URL', () => {
+        render(<TestLinkHandler />);
+
+        fireEvent.click(screen.getByTestId('link'));
+
+        expect(mockCreateNotification).toHaveBeenCalledWith(
+            expect.objectContaining({ type: 'error', text: expect.stringContaining('URL') })
+        );
+    });
+
+    it('blocks an external link that cannot be parsed', () => {
+        render(<TestLinkHandler href="https://[invalid" confirmLink={0} />);
+
+        const link = screen.getByTestId('link');
+        const clickWasAllowed = fireEvent.click(link);
+
+        expect(clickWasAllowed).toBe(false);
+        expect(mockCreateNotification).toHaveBeenCalledWith(expect.objectContaining({ type: 'error' }));
+    });
+
+    it('leaves a telephone link usable when link confirmation is off', () => {
+        render(<TestLinkHandler href="tel:+123456789" confirmLink={0} />);
+
+        const link = screen.getByTestId('link');
+        const clickWasAllowed = fireEvent.click(link);
+
+        expect(clickWasAllowed).toBe(true);
+        expect(link).toHaveAttribute('href', 'tel:+123456789');
+        expect(mockCreateNotification).not.toHaveBeenCalled();
+    });
+});
