+/** Return the domain label from a URL or hostname. */
+export const getHostnameWithRegex = (url: string): string => {
+    const hostname =
+        /^(?:(?:[a-z][a-z\d+.-]*:)?\/\/)?(?:[^/?#@]*@)?([^/?#:]+)(?::\d+)?(?:[/?#]|$)/i.exec(url)?.[1] || '';
+    const withoutTrailingDot = hostname.replace(/\.$/, '');
+    return (
+        /(?:^|\.)www\.([^.]+)/i.exec(withoutTrailingDot)?.[1] ||
+        /(?:^|\.)([^.]+)\.[^.]+$/.exec(withoutTrailingDot)?.[1] ||
+        withoutTrailingDot
+    );
+};
+
+/** Encode only the hostname, keeping the other URL components as supplied. */
+export const punycodeUrl = (url: string): string => {
+    // Keep the original path, query, and fragment: URL serialization can encode
+    // their Unicode characters and change the text of a link.
+    const parts = /^((?:[a-z][a-z\d+.-]*:)?\/\/)([^/?#\\]+)([^?#]*)(\?[^#]*)?(#.*)?$/i.exec(url);
+    if (!parts || url.includes('\\')) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const [, prefix, authority, pathname, search = '', hash = ''] = parts;
+    const authorityParts = /^(.*@)?(\[[^\]]+\]|[^:]+)(:\d*)?$/.exec(authority);
+    if (!authorityParts) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const parsed = new URL(url, 'https://example.invalid');
+    if (!parsed.hostname) {
+        throw new TypeError('Invalid URL');
+    }
+
+    const [, userInfo = '', , port = ''] = authorityParts;
+    const hostname = punycode.toASCII(parsed.hostname);
+    return `${prefix}${userInfo}${hostname}${port}${pathname.replace(/\/+$/, '')}${search}${hash}`;
+};
+
 export const isMailTo = (url: string): boolean => {
     return url.toLowerCase().startsWith('mailto:');
 };
