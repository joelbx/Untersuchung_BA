@@ -0,0 +1,51 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthenticationConfigValidateSessionDomain(t *testing.T) {
+	tests := []struct {
+		name   string
+		domain string
+		want   string
+	}{
+		{name: "HTTP URL with port", domain: "http://localhost:8080", want: "localhost"},
+		{name: "HTTPS URL with port", domain: "https://auth.flipt.io:8443", want: "auth.flipt.io"},
+		{name: "host with port", domain: "auth.flipt.io:8080", want: "auth.flipt.io"},
+		{name: "host only", domain: "auth.flipt.io", want: "auth.flipt.io"},
+		{name: "localhost", domain: "localhost", want: "localhost"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := AuthenticationConfig{
+				Session: AuthenticationSession{Domain: tt.domain},
+				Methods: AuthenticationMethods{
+					OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+				},
+			}
+
+			require.NoError(t, cfg.validate())
+			assert.Equal(t, tt.want, cfg.Session.Domain)
+		})
+	}
+}
+
+func TestAuthenticationConfigValidateSessionDomainParseError(t *testing.T) {
+	const malformedDomain = "http://%zz"
+	_, parseErr := getHostname(malformedDomain)
+	require.Error(t, parseErr)
+
+	cfg := AuthenticationConfig{
+		Session: AuthenticationSession{Domain: malformedDomain},
+		Methods: AuthenticationMethods{
+			OIDC: AuthenticationMethod[AuthenticationMethodOIDCConfig]{Enabled: true},
+		},
+	}
+
+	require.EqualError(t, cfg.validate(), parseErr.Error())
+}
