@@ -0,0 +1,90 @@
+package oidc
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+)
+
+func TestMiddlewareHandlerStateCookie(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		domain     string
+		wantDomain string
+	}{
+		{name: "localhost", domain: "localhost"},
+		{name: "other host", domain: "auth.example.com", wantDomain: "auth.example.com"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{Domain: tc.domain, StateLifetime: time.Minute})
+			var state string
+			handler := m.Handler(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+				state = r.URL.Query().Get("state")
+			}))
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(http.MethodGet, "/auth/v1/method/oidc/google/authorize?state=original", nil)
+
+			handler.ServeHTTP(recorder, request)
+
+			cookies := recorder.Result().Cookies()
+			if len(cookies) != 1 {
+				t.Fatalf("got %d cookies, want 1", len(cookies))
+			}
+			cookie := cookies[0]
+			if cookie.Name != stateCookieKey || cookie.Value == "" || cookie.Value != state {
+				t.Errorf("state cookie does not match request state: cookie=%q state=%q", cookie.Value, state)
+			}
+			if cookie.Path != "/auth/v1/method/oidc/google/callback" {
+				t.Errorf("cookie path = %q", cookie.Path)
+			}
+			if cookie.Domain != tc.wantDomain {
+				t.Errorf("cookie domain = %q, want %q", cookie.Domain, tc.wantDomain)
+			}
+			if got := strings.Contains(recorder.Header().Get("Set-Cookie"), "Domain="); got != (tc.wantDomain != "") {
+				t.Errorf("Domain attribute present = %t", got)
+			}
+		})
+	}
+}
+
+func TestMiddlewareForwardResponseTokenCookie(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		domain     string
+		wantDomain string
+	}{
+		{name: "localhost", domain: "localhost"},
+		{name: "other host", domain: "auth.example.com", wantDomain: "auth.example.com"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := NewHTTPMiddleware(config.AuthenticationSession{Domain: tc.domain, TokenLifetime: time.Minute})
+			recorder := httptest.NewRecorder()
+			response := &auth.CallbackResponse{ClientToken: "token"}
+
+			if err := m.ForwardResponseOption(context.Background(), recorder, response); err != nil {
+				t.Fatal(err)
+			}
+
+			cookies := recorder.Result().Cookies()
+			if len(cookies) != 1 {
+				t.Fatalf("got %d cookies, want 1", len(cookies))
+			}
+			cookie := cookies[0]
+			if cookie.Name != tokenCookieKey || cookie.Value != "token" || cookie.Path != "/" {
+				t.Errorf("unexpected token cookie: %#v", cookie)
+			}
+			if cookie.Domain != tc.wantDomain {
+				t.Errorf("cookie domain = %q, want %q", cookie.Domain, tc.wantDomain)
+			}
+			if got := strings.Contains(recorder.Header().Get("Set-Cookie"), "Domain="); got != (tc.wantDomain != "") {
+				t.Errorf("Domain attribute present = %t", got)
+			}
+		})
+	}
+}
