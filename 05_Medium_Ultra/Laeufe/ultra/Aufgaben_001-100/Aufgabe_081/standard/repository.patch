+package oidc
+
+import "testing"
+
+func TestCallbackURL(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		host string
+		want string
+	}{
+		{
+			name: "scheme and port",
+			host: "http://localhost:8080",
+			want: "http://localhost:8080/auth/v1/method/oidc/google/callback",
+		},
+		{
+			name: "one trailing slash",
+			host: "https://auth.example.com:8443/",
+			want: "https://auth.example.com:8443/auth/v1/method/oidc/google/callback",
+		},
+		{
+			name: "only one slash removed",
+			host: "https://auth.example.com:8443//",
+			want: "https://auth.example.com:8443//auth/v1/method/oidc/google/callback",
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := callbackURL(tc.host, "google"); got != tc.want {
+				t.Errorf("callbackURL(%q, %q) = %q, want %q", tc.host, "google", got, tc.want)
+			}
+		})
+	}
+}
