 }
 
+// pkgPs associates each running process with packages that own its executable
+// or a loaded file. getOwnerPkgs resolves paths using the distro's package
+// manager and returns package names from the installed package list.
+func (l *base) pkgPs(getOwnerPkgs func([]string) ([]string, error)) error {
+	stdout, err := l.ps()
+	if err != nil {
+		return xerrors.Errorf("Failed to ps: %w", err)
+	}
+	pidNames := l.parsePs(stdout)
+	pidLoadedFiles := map[string][]string{}
+	for pid := range pidNames {
+		stdout, err := l.lsProcExe(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/exe: %s", pid, err)
+		} else if path, err := l.parseLsProcExe(stdout); err != nil {
+			l.log.Debugf("Failed to parse /proc/%s/exe: %s", pid, err)
+		} else {
+			pidLoadedFiles[pid] = append(pidLoadedFiles[pid], path)
+		}
+
+		stdout, err = l.grepProcMap(pid)
+		if err != nil {
+			l.log.Debugf("Failed to exec /proc/%s/maps: %s", pid, err)
+			continue
+		}
+		pidLoadedFiles[pid] = append(pidLoadedFiles[pid], l.parseGrepProcMap(stdout)...)
+	}
+
+	pidListenPorts := map[string][]models.PortStat{}
+	stdout, err = l.lsOfListen()
+	if err != nil {
+		// Port detection is optional; continue with process ownership.
+		l.log.Warnf("Failed to lsof: %+v", err)
+	}
+	for ipPort, pids := range l.parseLsOf(stdout) {
+		portStat, err := models.NewPortStat(ipPort)
+		if err != nil {
+			l.log.Warnf("Failed to parse ip:port: %s, err: %+v", ipPort, err)
+			continue
+		}
+		for _, pid := range pids {
+			pidListenPorts[pid] = append(pidListenPorts[pid], *portStat)
+		}
+	}
+
+	for pid, paths := range pidLoadedFiles {
+		ownerPaths := make([]string, 0, len(paths))
+		seenPaths := map[string]struct{}{}
+		for _, path := range paths {
+			if !strings.HasPrefix(path, "/") {
+				continue
+			}
+			if _, ok := seenPaths[path]; ok {
+				continue
+			}
+			seenPaths[path] = struct{}{}
+			ownerPaths = append(ownerPaths, path)
+		}
+		if len(ownerPaths) == 0 {
+			continue
+		}
+		pkgNames, err := getOwnerPkgs(ownerPaths)
+		if err != nil {
+			l.log.Debugf("Failed to get owning packages for %v: %s", ownerPaths, err)
+			continue
+		}
+		proc := models.AffectedProcess{
+			PID:             pid,
+			Name:            pidNames[pid],
+			ListenPortStats: pidListenPorts[pid],
+		}
+		seen := map[string]struct{}{}
+		for _, name := range pkgNames {
+			if _, ok := seen[name]; ok {
+				continue
+			}
+			seen[name] = struct{}{}
+			pack, ok := l.Packages[name]
+			if !ok {
+				l.log.Debugf("Owning package %s is not in the installed package list", name)
+				continue
+			}
+			pack.AffectedProcs = append(pack.AffectedProcs, proc)
+			l.Packages[name] = pack
+		}
+	}
+	return nil
+}
