+func TestRedhatBaseParseRPMQfOutput(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Packages = models.NewPackages(
+		models.Package{Name: "libgcc", Version: "4.8.5", Release: "39.el7", Arch: "x86_64"},
+		models.Package{Name: "bash", Version: "4.2.46", Release: "34.el7", Arch: "x86_64"},
+		models.Package{Name: "epoch-pkg", Version: "1:2.0", Release: "1.el7", Arch: "noarch"},
+	)
+
+	tests := []struct {
+		name  string
+		input string
+		want  []string
+		bad   bool
+	}{
+		{
+			name: "matching owners, variants, and duplicate output",
+			input: `libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 38.el7 x86_64
+libgcc 0 4.8.5 39.el7 x86_64
+libgcc 0 4.8.5 39.el7 x86_64
+bash 0 4.2.46 34.el7 x86_64
+epoch-pkg 1 2.0 1.el7 noarch
+missing 0 1.0 1.el7 x86_64`,
+			want: []string{"libgcc", "bash", "epoch-pkg"},
+		},
+		{
+			name: "known ownership diagnostics",
+			input: `error: file /run/log/journal/system.journal: Permission denied
+file /tmp/unowned is not owned by any package
+error: file /tmp/gone: No such file or directory`,
+		},
+		{
+			name: "only other installed variants",
+			input: `libgcc 0 4.8.5 39.el7 i686
+libgcc 0 4.8.5 38.el7 x86_64`,
+			want: []string{"libgcc"},
+		},
+		{
+			name:  "unknown output",
+			input: "unexpected rpm output",
+			bad:   true,
+		},
+		{
+			name:  "invalid epoch",
+			input: "libgcc invalid 4.8.5 39.el7 x86_64",
+			bad:   true,
+		},
+		{
+			name:  "unexpected extra field",
+			input: "libgcc 0 4.8.5 39.el7 x86_64 extra",
+			bad:   true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := r.parseRPMQfOutput(tt.input)
+			if (err != nil) != tt.bad {
+				t.Fatalf("parseRPMQfOutput() error = %v, want error = %t", err, tt.bad)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("parseRPMQfOutput() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
