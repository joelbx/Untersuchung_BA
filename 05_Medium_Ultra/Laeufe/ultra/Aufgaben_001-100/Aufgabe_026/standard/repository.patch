+func TestIsCveInfoUpdatedChecksAllFamilySources(t *testing.T) {
+	const cveID = "CVE-2024-0001"
+	base := time.Date(2024, time.January, 1, 0, 0, 0, 0, time.UTC)
+	newer := base.Add(time.Hour)
+	content := func(ctype models.CveContentType, modified time.Time) models.CveContent {
+		return models.CveContent{Type: ctype, CveID: cveID, LastModified: modified}
+	}
+
+	tests := []struct {
+		name     string
+		family   string
+		previous []models.CveContent
+		current  []models.CveContent
+		want     bool
+	}{
+		{
+			name:     "Ubuntu API updated",
+			family:   "ubuntu",
+			previous: []models.CveContent{content(models.Ubuntu, base), content(models.UbuntuAPI, base)},
+			current:  []models.CveContent{content(models.Ubuntu, base), content(models.UbuntuAPI, newer)},
+			want:     true,
+		},
+		{
+			name:     "Debian tracker added",
+			family:   "debian",
+			previous: []models.CveContent{content(models.Debian, base)},
+			current:  []models.CveContent{content(models.Debian, base), content(models.DebianSecurityTracker, base)},
+			want:     true,
+		},
+		{
+			name:     "Red Hat API removed",
+			family:   "redhat",
+			previous: []models.CveContent{content(models.RedHat, base), content(models.RedHatAPI, base)},
+			current:  []models.CveContent{content(models.RedHat, base)},
+			want:     true,
+		},
+		{
+			name:     "Ubuntu sources unchanged",
+			family:   "ubuntu",
+			previous: []models.CveContent{content(models.Ubuntu, base), content(models.UbuntuAPI, base)},
+			current:  []models.CveContent{content(models.Ubuntu, base), content(models.UbuntuAPI, base)},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			previous := models.ScanResult{Family: tt.family, ScannedCves: models.VulnInfos{
+				cveID: {CveID: cveID, CveContents: models.NewCveContents(tt.previous...)},
+			}}
+			current := models.ScanResult{Family: tt.family, ScannedCves: models.VulnInfos{
+				cveID: {CveID: cveID, CveContents: models.NewCveContents(tt.current...)},
+			}}
+			if got := isCveInfoUpdated(cveID, previous, current); got != tt.want {
+				t.Errorf("isCveInfoUpdated() = %t, want %t", got, tt.want)
+			}
+		})
+	}
+}
