@@ -29,31 +29,69 @@ from ansible.plugins.shell import ShellBase
 _common_args = ['PowerShell', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Unrestricted']
 
 
-def _parse_clixml(data, stream="Error"):
+_CLIXML_ESCAPE = re.compile(r'_x([0-9A-Fa-f]{4})_')
+_CLIXML_BLOCK = re.compile(rb'<Objs(?:\s[^>]*)?>.*?</Objs>', re.DOTALL)
+
+
+def _decode_clixml_escapes(value: str) -> str:
+    matches = list(_CLIXML_ESCAPE.finditer(value))
+    result = []
+    position = 0
+    index = 0
+
+    while index < len(matches):
+        match = matches[index]
+        result.append(value[position:match.start()])
+        code_unit = int(match.group(1), 16)
+        next_match = matches[index + 1] if index + 1 < len(matches) else None
+        adjacent = next_match is not None and next_match.start() == match.end()
+
+        if match.group() == '_x005F_' and not adjacent:
+            # PowerShell only escapes a literal underscore when it precedes
+            # another escape token.
+            result.append(match.group())
+        elif adjacent and 0xD800 <= code_unit <= 0xDBFF:
+            low_surrogate = int(next_match.group(1), 16)
+            if 0xDC00 <= low_surrogate <= 0xDFFF:
+                result.append(chr(0x10000 + (code_unit - 0xD800) * 0x400 + low_surrogate - 0xDC00))
+                position = next_match.end()
+                index += 2
+                continue
+            result.append(chr(code_unit))
+        else:
+            result.append(chr(code_unit))
+
+        position = match.end()
+        index += 1
+
+    result.append(value[position:])
+    return ''.join(result)
+
+
+def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
     """
     Takes a byte string like '#< CLIXML\r\n<Objs...' and extracts the stream
     message encoded in the XML data. CLIXML is used by PowerShell to encode
     multiple objects in stderr.
     """
-    lines = []
+    blocks = []
 
     # There are some scenarios where the stderr contains a nested CLIXML element like
     # '<# CLIXML\r\n<# CLIXML\r\n<Objs>...</Objs><Objs>...</Objs>'.
-    # Parse each individual <Objs> element and add the error strings to our stderr list.
+    # Parse each individual <Objs> element before combining the selected stream text.
     # https://github.com/ansible/ansible/issues/69550
-    while data:
-        end_idx = data.find(b"</Objs>") + 7
-        current_element = data[data.find(b"<Objs "):end_idx]
-        data = data[end_idx:]
-
-        clixml = ET.fromstring(current_element)
+    for block in _CLIXML_BLOCK.finditer(data):
+        clixml = ET.fromstring(block.group())
         namespace_match = re.match(r'{(.*)}', clixml.tag)
         namespace = "{%s}" % namespace_match.group(1) if namespace_match else ""
 
-        strings = clixml.findall("./%sS" % namespace)
-        lines.extend([e.text.replace('_x000D__x000A_', '') for e in strings if e.attrib.get('S') == stream])
+        strings = clixml.iter("%sS" % namespace)
+        raw_text = ''.join(element.text or '' for element in strings if element.attrib.get('S') == stream)
+        decoded = _decode_clixml_escapes(raw_text)
+        if decoded:
+            blocks.append(decoded)
 
-    return to_bytes('\r\n'.join(lines))
+    return to_bytes('\r\n'.join(blocks), errors='surrogatepass')
 
 
