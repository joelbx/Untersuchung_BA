+def test_parse_clixml_annotations():
+    assert get_type_hints(_parse_clixml) == {'data': bytes, 'stream': str, 'return': bytes}
+
+
+def test_parse_clixml_decodes_unicode_and_control_characters():
+    data = (b'<Objs Version="1.1.0.1"><S S="Error">'
+            b'A_x000D_B_x000A_C_x000D__x000A__x263A__xD83D__xDE00__x0001_Z'
+            b'</S></Objs>')
+
+    assert _parse_clixml(data) == 'A\rB\nC\r\n\u263a\U0001f600\x01Z'.encode('utf-8')
+
+
+def test_parse_clixml_preserves_invalid_escapes_and_unpaired_surrogates():
+    data = (b'<Objs Version="1.1.0.1"><S S="Error">_x005G_|_x123_|_xD800_A_xDC00_</S></Objs>')
+
+    assert _parse_clixml(data) == '_x005G_|_x123_|\ud800A\udc00'.encode('utf-8', errors='surrogatepass')
+
+
+def test_parse_clixml_decodes_surrogate_pair_across_elements():
+    data = (b'<Objs Version="1.1.0.1"><S S="Error">_xD83D_</S>'
+            b'<S S="Error">_xDE00_</S></Objs>')
+
+    assert _parse_clixml(data) == '\U0001f600'.encode('utf-8')
+
+
+def test_parse_clixml_underscore_escape():
+    data = (b'<Objs Version="1.1.0.1"><S S="Error">_x005F__x000A_|_x005F_|_x005f_|_x005F__x005G_</S></Objs>')
+
+    assert _parse_clixml(data) == b'_\n|_x005F_|_|_x005F__x005G_'
+
+
+def test_parse_clixml_filters_stream_and_concatenates_elements():
+    data = (b'<Objs Version="1.1.0.1"><S S="Info">ignored</S><S S="Error" />'
+            b'<S>also ignored</S><S S="Error">first</S><S S="Info">ignored again</S>'
+            b'<S S="Error"></S><S S="Error">second</S></Objs>')
+
+    assert _parse_clixml(data) == b'firstsecond'
+    assert _parse_clixml(data, stream='Info') == b'ignoredignored again'
+    assert _parse_clixml(data, stream='Warning') == b''
+
+
+def test_parse_clixml_only_empty_matching_elements():
+    data = b'<Objs Version="1.1.0.1"><S S="Error" /><S S="Info">ignored</S><S S="Error"></S></Objs>'
+
+    assert _parse_clixml(data) == b''
+
+
+def test_parse_clixml_multiple_blocks_with_no_matching_text():
+    data = (b'<Objs Version="1.1.0.1"><S S="Info">ignored</S></Objs>'
+            b'<Objs Version="1.1.0.1"><S S="Error" /></Objs>')
+
+    assert _parse_clixml(data) == b''
+
+
+def test_parse_clixml_multiple_blocks_separate_only_blocks():
+    data = (b'#< CLIXML\r\n<Objs Version="1.1.0.1"><S S="Error">one</S><S S="Error">two</S></Objs>'
+            b'<Objs Version="1.1.0.1"><S S="Error">three</S><S S="Error">four</S></Objs>')
+
+    assert _parse_clixml(data) == b'onetwo\r\nthreefour'
+
+
