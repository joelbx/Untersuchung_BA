 }
 
 
+def _js_log_to_ui(
+    level: usertypes.JsLogLevel,
+    source: str,
+    line: int,
+    msg: str,
+) -> bool:
+    """Show a JavaScript message in the UI if enabled and not excluded."""
+    levels_by_source = config.cache['content.javascript.log_message.levels']
+    if levels_by_source is None:
+        return False
+
+    for pattern, levels in levels_by_source.items():
+        if not fnmatch.fnmatchcase(source, pattern) or level.name not in levels:
+            continue
+
+        excludes_by_source = config.cache['content.javascript.log_message.excludes']
+        if excludes_by_source is not None:
+            for source_pattern, messages in excludes_by_source.items():
+                if (fnmatch.fnmatchcase(source, source_pattern) and
+                        any(fnmatch.fnmatchcase(msg, pattern)
+                            for pattern in messages)):
+                    return False
+
+        _JS_LOGMAP_MESSAGE[level](f"JS: [{source}:{line}] {msg}")
+        return True
+
+    return False
+
+
