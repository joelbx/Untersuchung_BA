@@ -0,0 +1,89 @@
+import { configureStore } from '@reduxjs/toolkit';
+import elementsReducer, { newState } from './elementsSlice';
+import { invalidate, load } from './elementsActions';
+import { shouldSendRequest } from './elementsSelectors';
+
+const makeStore = () =>
+    configureStore({
+        reducer: { elements: elementsReducer },
+        middleware: (getDefaultMiddleware) => getDefaultMiddleware({ serializableCheck: false }),
+    });
+
+const query = (api: any) => ({
+    api,
+    abortController: undefined,
+    conversationMode: true,
+    page: 0,
+    params: newState().params,
+});
+
+describe('element list retries', () => {
+    afterEach(() => jest.useRealTimers());
+
+    it('discards stale results and releases the request for retry after one second', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const api = jest.fn().mockResolvedValue({ Total: 1, Conversations: [{ ID: 'stale' }], Stale: 1 });
+
+        const result = await store.dispatch(load(query(api)));
+
+        expect(load.rejected.match(result)).toBe(true);
+        expect(store.getState().elements.elements).toEqual({});
+        expect(store.getState().elements.pendingRequest).toBe(true);
+
+        jest.advanceTimersByTime(999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toEqual({
+            payload: expect.objectContaining({ Page: 0 }),
+            count: 1,
+            error: undefined,
+        });
+    });
+
+    it('releases a failed request for retry after two seconds and records its error', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const error = new Error('Request failed');
+        const api = jest.fn().mockRejectedValue(error);
+
+        const result = await store.dispatch(load(query(api)));
+
+        expect(load.rejected.match(result)).toBe(true);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+
+        jest.advanceTimersByTime(1999);
+        expect(store.getState().elements.pendingRequest).toBe(true);
+
+        jest.advanceTimersByTime(1);
+        expect(store.getState().elements.pendingRequest).toBe(false);
+        expect(store.getState().elements.retry).toEqual({
+            payload: expect.objectContaining({ Page: 0 }),
+            count: 1,
+            error,
+        });
+    });
+
+    it('keeps retrying when a cached page refresh fails', async () => {
+        jest.useFakeTimers();
+        const store = makeStore();
+        const params = store.getState().elements.params;
+        const api = jest
+            .fn()
