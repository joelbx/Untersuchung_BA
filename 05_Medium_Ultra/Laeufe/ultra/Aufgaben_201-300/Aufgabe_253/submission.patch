+def test_reused_process_empty_streams(qtbot, proc, py_proc, message_mock,
+                                      caplog):
+    """Output from a previous run must not produce summaries on the next."""
+    proc._output_messages = True
+
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import sys
+                print('stdout text')
+                print('stderr text', file=sys.stderr)
+            """))
+
+        assert proc.stdout.strip() == 'stdout text'
+        assert proc.stderr.strip() == 'stderr text'
+        previous_messages = list(message_mock.messages)
+
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc('pass'))
+
+    assert proc.stdout == ''
+    assert proc.stderr == ''
+    assert message_mock.messages == previous_messages
+
+
