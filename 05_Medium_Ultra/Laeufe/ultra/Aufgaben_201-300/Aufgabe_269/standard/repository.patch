+type trivySourceDetails struct {
+	severity    string
+	hasSeverity bool
+	cvss        trivydbTypes.CVSS
+	hasCVSS     bool
+}
+
+func trivyCveContents(vuln types.DetectedVulnerability) models.CveContents {
+	var references models.References
+	for _, reference := range vuln.References {
+		references = append(references, models.Reference{Source: "trivy", Link: reference})
+	}
+	sort.Slice(references, func(i, j int) bool {
+		return references[i].Link < references[j].Link
+	})
+
+	var published, lastModified time.Time
+	if vuln.PublishedDate != nil {
+		published = *vuln.PublishedDate
+	}
+	if vuln.LastModifiedDate != nil {
+		lastModified = *vuln.LastModifiedDate
+	}
+
+	sources := map[string]trivySourceDetails{}
+	severitySources := make([]trivydbTypes.SourceID, 0, len(vuln.VendorSeverity))
+	for source := range vuln.VendorSeverity {
+		severitySources = append(severitySources, source)
+	}
+	sort.Slice(severitySources, func(i, j int) bool { return severitySources[i] < severitySources[j] })
+	for _, source := range severitySources {
+		name := normalizeTrivySource(source)
+		details := sources[name]
+		if !details.hasSeverity {
+			details.severity = vuln.VendorSeverity[source].String()
+			details.hasSeverity = true
+			sources[name] = details
+		}
+	}
+	cvssSources := make([]trivydbTypes.SourceID, 0, len(vuln.CVSS))
+	for source := range vuln.CVSS {
+		cvssSources = append(cvssSources, source)
+	}
+	sort.Slice(cvssSources, func(i, j int) bool { return cvssSources[i] < cvssSources[j] })
+	for _, source := range cvssSources {
+		name := normalizeTrivySource(source)
+		details := sources[name]
+		if !details.hasCVSS {
+			details.cvss = vuln.CVSS[source]
+			details.hasCVSS = true
+			sources[name] = details
+		}
+	}
+	selectedSource := normalizeTrivySource(vuln.SeveritySource)
+	if selectedSource != "" {
+		if _, found := sources[selectedSource]; !found {
+			sources[selectedSource] = trivySourceDetails{}
+		}
+	}
+	// Older Trivy results may have only an overall severity and no source metadata.
+	if len(sources) == 0 {
+		sources[""] = trivySourceDetails{}
+	}
+
+	sortedSources := make([]string, 0, len(sources))
+	for source := range sources {
+		sortedSources = append(sortedSources, source)
+	}
+	sort.Strings(sortedSources)
+
+	contents := models.CveContents{}
+	for _, source := range sortedSources {
+		ctype := models.Trivy
+		if source != "" {
+			ctype = models.CveContentType("trivy:" + source)
+		}
+		details := sources[source]
+		severity := details.severity
+		if !details.hasSeverity && (source == selectedSource || source == "") {
+			severity = vuln.Severity
+		}
+		cvss := details.cvss
+		contents[ctype] = append(contents[ctype], models.CveContent{
+			Type:          ctype,
+			CveID:         vuln.VulnerabilityID,
+			Title:         vuln.Title,
+			Summary:       vuln.Description,
+			Cvss2Score:    cvss.V2Score,
+			Cvss2Vector:   cvss.V2Vector,
+			Cvss3Score:    cvss.V3Score,
+			Cvss3Vector:   cvss.V3Vector,
+			Cvss3Severity: severity,
+			References:    references,
+			Published:     published,
+			LastModified:  lastModified,
+		})
+	}
+	return contents
+}
+
+func normalizeTrivySource(source trivydbTypes.SourceID) string {
+	return strings.ToLower(strings.TrimSpace(string(source)))
+}
