+func TestConvertPreservesTrivySourcesAcrossTargets(t *testing.T) {
+	published := time.Date(2024, 1, 2, 3, 4, 5, 0, time.UTC)
+	modified := time.Date(2024, 2, 3, 4, 5, 6, 0, time.UTC)
+	results := types.Results{
+		{
+			Type: ftypes.Debian,
+			Vulnerabilities: []types.DetectedVulnerability{{
+				VulnerabilityID: "CVE-2024-1234",
+				PkgName:         "example",
+				SeveritySource:  "debian",
+				Vulnerability: trivydbTypes.Vulnerability{
+					Title:          "Example vulnerability",
+					Description:    "Example description",
+					Severity:       "LOW",
+					VendorSeverity: trivydbTypes.VendorSeverity{"debian": trivydbTypes.SeverityLow, "nvd": trivydbTypes.SeverityHigh},
+					CVSS: trivydbTypes.VendorCVSS{
+						"debian": {V3Score: 3.1, V3Vector: "CVSS:3.1/debian"},
+						"nvd":    {V2Score: 7.5, V2Vector: "AV:N/AC:L", V3Score: 8.1, V3Vector: "CVSS:3.1/nvd"},
+					},
+					References:       []string{"https://example.test/z", "https://example.test/a"},
+					PublishedDate:    &published,
+					LastModifiedDate: &modified,
+				},
+			}},
+		},
+		{
+			Type: ftypes.Ubuntu,
+			Vulnerabilities: []types.DetectedVulnerability{{
+				VulnerabilityID: "CVE-2024-1234",
+				PkgName:         "example",
+				SeveritySource:  "ubuntu",
+				Vulnerability: trivydbTypes.Vulnerability{
+					Title:            "Example vulnerability",
+					Description:      "Example description",
+					Severity:         "MEDIUM",
+					VendorSeverity:   trivydbTypes.VendorSeverity{"ubuntu": trivydbTypes.SeverityMedium},
+					CVSS:             trivydbTypes.VendorCVSS{"ubuntu": {V3Score: 5.5, V3Vector: "CVSS:3.1/ubuntu"}},
+					References:       []string{"https://example.test/ubuntu"},
+					PublishedDate:    &published,
+					LastModifiedDate: &modified,
+				},
+			}},
+		},
+	}
+
+	converted, err := Convert(results)
+	if err != nil {
+		t.Fatal(err)
+	}
+	contents := converted.ScannedCves["CVE-2024-1234"].CveContents
+	if len(contents) != 3 {
+		t.Fatalf("got %d sources, want 3: %#v", len(contents), contents)
+	}
+
+	checks := []struct {
+		source   models.CveContentType
+		severity string
+		v2score  float64
+		v2vector string
+		v3score  float64
+		v3vector string
+	}{
+		{models.CveContentType("trivy:debian"), "LOW", 0, "", 3.1, "CVSS:3.1/debian"},
+		{models.CveContentType("trivy:nvd"), "HIGH", 7.5, "AV:N/AC:L", 8.1, "CVSS:3.1/nvd"},
+		{models.CveContentType("trivy:ubuntu"), "MEDIUM", 0, "", 5.5, "CVSS:3.1/ubuntu"},
+	}
+	for _, check := range checks {
+		entries := contents[check.source]
+		if len(entries) != 1 {
+			t.Fatalf("%s: got %d entries, want 1", check.source, len(entries))
+		}
+		content := entries[0]
+		if content.Type != check.source || content.CveID != "CVE-2024-1234" ||
+			content.Title != "Example vulnerability" || content.Summary != "Example description" ||
+			content.Cvss3Severity != check.severity || content.Cvss2Score != check.v2score ||
+			content.Cvss2Vector != check.v2vector || content.Cvss3Score != check.v3score ||
+			content.Cvss3Vector != check.v3vector || !content.Published.Equal(published) ||
+			!content.LastModified.Equal(modified) {
+			t.Errorf("%s: unexpected content: %#v", check.source, content)
+		}
+		if len(content.References) == 0 {
+			t.Errorf("%s: missing references", check.source)
+		}
+	}
+	debianReferences := contents["trivy:debian"][0].References
+	if len(debianReferences) != 2 || debianReferences[0].Link != "https://example.test/a" || debianReferences[1].Link != "https://example.test/z" {
+		t.Errorf("Debian references were not preserved and sorted: %#v", debianReferences)
+	}
+}
