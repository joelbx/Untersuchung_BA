+func expectedTrivyCveContents(cveID string, base models.CveContent) models.CveContents {
+	metadata, ok := trivyExpectedMetadata[cveID]
+	if !ok {
+		panic("missing expected Trivy metadata for " + cveID)
+	}
+	published, err := time.Parse(time.RFC3339, metadata.published)
+	if err != nil {
+		panic(err)
+	}
+	lastModified, err := time.Parse(time.RFC3339, metadata.lastModified)
+	if err != nil {
+		panic(err)
+	}
+	contents := models.CveContents{}
+	for _, source := range metadata.sources {
+		content := base
+		content.Type = source.name
+		content.CveID = cveID
+		content.Cvss2Score = source.v2score
+		content.Cvss2Vector = source.v2vector
+		content.Cvss3Score = source.v3score
+		content.Cvss3Vector = source.v3vector
+		content.Cvss3Severity = source.severity
+		content.Published = published
+		content.LastModified = lastModified
+		contents[source.name] = []models.CveContent{content}
+	}
+	return contents
+}
