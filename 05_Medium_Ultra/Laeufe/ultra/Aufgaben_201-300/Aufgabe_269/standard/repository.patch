+		}
+		severity, hasSeverity := vul.VendorSeverity[source]
+		cvss, hasCVSS := vul.CVSS[source]
+		grouped[ctype] = append(grouped[ctype], trivySourceValues{
+			severity: severity, cvss: cvss, hasSeverity: hasSeverity, hasCVSS: hasCVSS,
+		})
+	}
+
+	for ctype, values := range grouped {
+		severities := map[trivydbTypes.Severity]struct{}{}
+		cvsses := map[trivydbTypes.CVSS]struct{}{}
+		var uniqueSeverity trivydbTypes.Severity
+		var uniqueCVSS trivydbTypes.CVSS
+		for _, value := range values {
+			if value.hasSeverity {
+				severities[value.severity] = struct{}{}
+				uniqueSeverity = value.severity
+			}
+			if value.hasCVSS {
+				cvsses[value.cvss] = struct{}{}
+				uniqueCVSS = value.cvss
+			}
+		}
+		for i := range values {
+			if !values[i].hasSeverity && len(severities) == 1 {
+				values[i].severity = uniqueSeverity
+				values[i].hasSeverity = true
+			}
+			if !values[i].hasCVSS && len(cvsses) == 1 {
+				values[i].cvss = uniqueCVSS
+				values[i].hasCVSS = true
+			}
+		}
+		for i, value := range values {
+			// Multiple raw source labels can normalize to the same key. Keep distinct
+			// assessments, but omit duplicates and entries covered by fuller ones.
+			subsumed := false
+			for j, other := range values {
+				if i == j || (value.hasSeverity && (!other.hasSeverity || value.severity != other.severity)) ||
+					(value.hasCVSS && (!other.hasCVSS || value.cvss != other.cvss)) {
+					continue
+				}
+				if (!value.hasSeverity && other.hasSeverity) || (!value.hasCVSS && other.hasCVSS) ||
+					(value.hasSeverity == other.hasSeverity && value.hasCVSS == other.hasCVSS && j < i) {
+					subsumed = true
+					break
+				}
+			}
+			if subsumed {
+				continue
+			}
+			perSource := content
+			perSource.Type = ctype
+			if value.hasSeverity {
+				perSource.Cvss3Severity = value.severity.String()
+			}
+			if value.hasCVSS {
+				perSource.Cvss2Score = value.cvss.V2Score
+				perSource.Cvss2Vector = value.cvss.V2Vector
+				perSource.Cvss3Score = value.cvss.V3Score
+				perSource.Cvss3Vector = value.cvss.V3Vector
+			}
+			contents[ctype] = append(contents[ctype], perSource)
+		}
+	}
+	if len(contents) == 0 {
+		content.Type = models.Trivy
+		content.Cvss3Severity = vul.Severity
+		contents[models.Trivy] = []models.CveContent{content}
 	}
 	return contents
 }
diff --git a/detector/library_test.go b/detector/library_test.go
new file mode 100644
index 0000000..bc56709
--- /dev/null
+++ b/detector/library_test.go
@@ -0,0 +1,116 @@
+//go:build !scanner
+// +build !scanner
+
+package detector
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	trivydbTypes "github.com/aquasecurity/trivy-db/pkg/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestGetCveContentsByTrivySource(t *testing.T) {
+	published := time.Date(2022, time.January, 2, 3, 4, 5, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	vul := trivydbTypes.Vulnerability{
+		Title:            "Example vulnerability",
+		Description:      "Example description",
+		Severity:         "CRITICAL",
+		CweIDs:           []string{"CWE-79"},
+		References:       []string{"https://example.com/advisory"},
+		PublishedDate:    &published,
+		LastModifiedDate: &modified,
+		VendorSeverity: trivydbTypes.VendorSeverity{
+			"debian": trivydbTypes.SeverityLow,
+			"ubuntu": trivydbTypes.SeverityMedium,
+			"nvd":    trivydbTypes.SeverityHigh,
+		},
+		CVSS: trivydbTypes.VendorCVSS{
+			"debian": {V2Score: 2.1, V2Vector: "AV:L", V3Score: 3.2, V3Vector: "CVSS:3.1/debian"},
+			"ubuntu": {V3Score: 5.3, V3Vector: "CVSS:3.1/ubuntu"},
+			"nvd":    {V3Score: 8.1, V3Vector: "CVSS:3.1/nvd"},
+			"ghsa":   {V3Score: 6.5, V3Vector: "CVSS:3.1/ghsa"},
+		},
+	}
+
+	contents := getCveContents("CVE-2022-1234", vul)
+	if len(contents) != 4 {
+		t.Fatalf("got %d source entries, want 4: %#v", len(contents), contents)
+	}
+	for source, wantSeverity := range map[string]string{
+		"debian": "LOW",
+		"ubuntu": "MEDIUM",
+		"nvd":    "HIGH",
+		"ghsa":   "",
+	} {
+		ctype := models.CveContentType("trivy:" + source)
+		entries := contents[ctype]
+		if len(entries) != 1 {
+			t.Fatalf("%s has %d entries, want 1", ctype, len(entries))
+		}
+		got := entries[0]
+		cvss := vul.CVSS[trivydbTypes.SourceID(source)]
+		if got.Type != ctype || got.CveID != "CVE-2022-1234" || got.Title != vul.Title || got.Summary != vul.Description ||
+			got.Cvss3Severity != wantSeverity || got.Cvss2Score != cvss.V2Score || got.Cvss2Vector != cvss.V2Vector ||
+			got.Cvss3Score != cvss.V3Score || got.Cvss3Vector != cvss.V3Vector ||
+			!got.Published.Equal(published) || !got.LastModified.Equal(modified) {
+			t.Errorf("%s content lost source metadata: %#v", ctype, got)
+		}
+		if !reflect.DeepEqual(got.References, models.References{{Source: "trivy", Link: vul.References[0]}}) ||
+			!reflect.DeepEqual(got.CweIDs, vul.CweIDs) {
+			t.Errorf("%s content lost references or CWEs: %#v", ctype, got)
+		}
+	}
+	if _, ok := contents[models.Trivy]; ok {
+		t.Error("source-specific content was collapsed into trivy")
+	}
+}
+
+func TestGetCveContentsWithoutSourceData(t *testing.T) {
+	contents := getCveContents("CVE-2022-1234", trivydbTypes.Vulnerability{Severity: "HIGH"})
+	got := contents[models.Trivy]
+	if len(contents) != 1 || len(got) != 1 || got[0].Type != models.Trivy || got[0].Cvss3Severity != "HIGH" {
+		t.Errorf("generic Trivy content missing: %#v", contents)
+	}
+}
+
+func TestGetCveContentsNormalizesSourceIDs(t *testing.T) {
+	vul := trivydbTypes.Vulnerability{
+		VendorSeverity: trivydbTypes.VendorSeverity{
+			" Debian ": trivydbTypes.SeverityLow,
+			"DEBIAN":   trivydbTypes.SeverityMedium,
+		},
+		CVSS: trivydbTypes.VendorCVSS{
+			"debian": {V3Score: 5.0, V3Vector: "CVSS:3.1/debian"},
+		},
+	}
+	contents := getCveContents("CVE-2022-1234", vul)
+	entries := contents[models.CveContentType("trivy:debian")]
+	if len(contents) != 1 || len(entries) != 2 {
+		t.Fatalf("normalized source entries were lost or split: %#v", contents)
+	}
+	severities := map[string]bool{}
+	for _, entry := range entries {
+		if entry.Type != "trivy:debian" || entry.Cvss3Score != 5.0 || entry.Cvss3Vector != "CVSS:3.1/debian" {
+			t.Errorf("source severity and CVSS were not combined: %#v", entry)
+		}
+		severities[entry.Cvss3Severity] = true
+	}
+	if !severities["LOW"] || !severities["MEDIUM"] {
+		t.Errorf("case-colliding source severities were lost: %#v", entries)
+	}
+}
+
+func TestMergeCveContents(t *testing.T) {
+	debian := models.CveContent{Type: "trivy:debian", CveID: "CVE-2022-1234", Cvss3Severity: "LOW"}
+	ubuntu := models.CveContent{Type: "trivy:ubuntu", CveID: "CVE-2022-1234", Cvss3Severity: "MEDIUM"}
+	dst := mergeCveContents(nil, models.NewCveContents(debian))
+	dst = mergeCveContents(dst, models.NewCveContents(debian, ubuntu))
+	if !reflect.DeepEqual(dst, models.NewCveContents(debian, ubuntu)) {
+		t.Errorf("source content was dropped or duplicated: %#v", dst)
+	}
+}
