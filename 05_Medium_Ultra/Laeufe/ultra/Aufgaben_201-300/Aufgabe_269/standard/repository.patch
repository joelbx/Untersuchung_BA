+func TestTrivyCveContentsSourceOnlyAndFallback(t *testing.T) {
+	vuln := types.DetectedVulnerability{
+		VulnerabilityID: "CVE-2024-5678",
+		SeveritySource:  "GHSA",
+		Vulnerability: trivydbTypes.Vulnerability{
+			Severity: "HIGH",
+			CVSS:     trivydbTypes.VendorCVSS{"Oracle-OVAL": {V3Score: 7.2}},
+		},
+	}
+	contents := trivyCveContents(vuln)
+	if contents["trivy:ghsa"][0].Cvss3Severity != "HIGH" {
+		t.Errorf("selected severity source was lost: %#v", contents["trivy:ghsa"])
+	}
+	if contents["trivy:oracle-oval"][0].Cvss3Score != 7.2 {
+		t.Errorf("CVSS-only source was lost: %#v", contents["trivy:oracle-oval"])
+	}
+
+	vuln.SeveritySource = ""
+	vuln.CVSS = nil
+	contents = trivyCveContents(vuln)
+	if len(contents) != 1 || contents[models.Trivy][0].Cvss3Severity != "HIGH" {
+		t.Errorf("source-free fallback was lost: %#v", contents)
+	}
+
+	vuln.SeveritySource = "NVD"
+	vuln.VendorSeverity = trivydbTypes.VendorSeverity{"NVD": trivydbTypes.SeverityMedium}
+	vuln.CVSS = trivydbTypes.VendorCVSS{"nvd": {V3Score: 6.1}}
+	contents = trivyCveContents(vuln)
+	if len(contents) != 1 || len(contents["trivy:nvd"]) != 1 ||
+		contents["trivy:nvd"][0].Cvss3Severity != "MEDIUM" ||
+		contents["trivy:nvd"][0].Cvss3Score != 6.1 {
+		t.Errorf("case variants of one source were not combined: %#v", contents)
+	}
+}
