+
+// Preserve the actual connection address before RealIP processes forwarded
+// headers. Authentication must never use a client-controlled forwarded address.
+func captureTransportPeer(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ctx := request.WithTransportPeerAddr(r.Context(), r.RemoteAddr)
+		next.ServeHTTP(w, r.WithContext(ctx))
+	})
+}
