diff --git a/ui/src/authProvider.test.js b/ui/src/authProvider.test.js
new file mode 100644
index 0000000..c00347b
--- /dev/null
+++ b/ui/src/authProvider.test.js
@@ -0,0 +1,76 @@
+const token = 'eyJhbGciOiJub25lIn0.eyJ1aWQiOiIxIn0.signature'
+
+beforeEach(() => {
+  localStorage.clear()
+  jest.resetModules()
+})
+
+afterEach(() => {
+  delete window.__APP_CONFIG__
+  localStorage.clear()
+})
+
+it('starts a session from reverse proxy authentication in the app config', async () => {
+  window.__APP_CONFIG__ = JSON.stringify({
+    firstTime: true,
+    auth: {
+      id: '1',
+      isAdmin: true,
+      name: 'Jane Doe',
+      username: 'jane',
+      token,
+      subsonicSalt: 'salt',
+      subsonicToken: 'subsonic-token',
+    },
+  })
+
+  const authProvider = require('./authProvider').default
+  const config = require('./config').default
+
+  await expect(authProvider.checkAuth()).resolves.toBeUndefined()
+  await expect(authProvider.getPermissions()).resolves.toBe('admin')
+  expect(authProvider.getIdentity()).toEqual({
+    id: 'jane',
+    fullName: 'Jane Doe',
+    avatar: null,
+  })
+  expect(localStorage.getItem('token')).toBe(token)
+  expect(localStorage.getItem('userId')).toBe('1')
+  expect(localStorage.getItem('name')).toBe('Jane Doe')
+  expect(localStorage.getItem('username')).toBe('jane')
+  expect(localStorage.getItem('role')).toBe('admin')
+  expect(localStorage.getItem('subsonic-salt')).toBe('salt')
+  expect(localStorage.getItem('subsonic-token')).toBe('subsonic-token')
+  expect(config.firstTime).toBe(false)
+})
+
+it.each([undefined, null])(
+  'does not start a session when proxy authentication is %s',
+  async (auth) => {
+    window.__APP_CONFIG__ = JSON.stringify({ auth })
+
+    const authProvider = require('./authProvider').default
+
+    await expect(authProvider.checkAuth()).rejects.toBeUndefined()
+    expect(localStorage.getItem('token')).toBeNull()
+  }
+)
+
+it('ignores an invalid proxy authentication token', async () => {
+  window.__APP_CONFIG__ = JSON.stringify({
+    auth: {
+      id: '1',
+      isAdmin: false,
+      name: 'Jane Doe',
+      username: 'jane',
+      token: 'invalid',
+      subsonicSalt: 'salt',
+      subsonicToken: 'subsonic-token',
+    },
+  })
+
+  const authProvider = require('./authProvider').default
+
+  await expect(authProvider.checkAuth()).rejects.toBeUndefined()
+  expect(localStorage.getItem('token')).toBeNull()
+})
