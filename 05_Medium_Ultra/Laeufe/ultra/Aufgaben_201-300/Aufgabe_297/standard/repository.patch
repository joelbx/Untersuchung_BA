--- /dev/null
+++ b/server/transport_peer_test.go
@@ -0,0 +1,26 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/go-chi/chi/v5/middleware"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+func TestCaptureTransportPeerBeforeRealIP(t *testing.T) {
+	r := httptest.NewRequest("GET", "/", nil)
+	r.RemoteAddr = "198.51.100.9:2345"
+	r.Header.Set("X-Forwarded-For", "192.0.2.4")
+
+	handler := captureTransportPeer(middleware.RealIP(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		if got := r.RemoteAddr; got != "192.0.2.4" {
+			t.Errorf("RealIP RemoteAddr = %q", got)
+		}
+		if got := request.OriginalRemoteAddr(r); got != "198.51.100.9:2345" {
+			t.Errorf("original transport peer = %q", got)
+		}
+	})))
+	handler.ServeHTTP(httptest.NewRecorder(), r)
+}
