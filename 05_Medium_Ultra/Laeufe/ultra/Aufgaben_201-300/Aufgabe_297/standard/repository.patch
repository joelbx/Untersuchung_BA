+		t.Fatal("a later proxy user was made admin")
+	}
+
+	first.Name = "Updated Name"
+	first.IsAdmin = false
+	first.LastLoginAt = nil
+	config = extractAppConfig(request("127.0.0.1:5000", "first").Body.String())
+	payload = config["auth"].(map[string]interface{})
+	if payload["name"] != "Updated Name" || payload["isAdmin"] != false || payload["id"] != first.ID {
+		t.Fatalf("existing user state was not reflected: %#v", payload)
