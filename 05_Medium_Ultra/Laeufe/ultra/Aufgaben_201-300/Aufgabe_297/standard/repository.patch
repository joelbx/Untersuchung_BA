+package request
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+func TestOriginalRemoteAddr(t *testing.T) {
+	r := httptest.NewRequest("GET", "/", nil)
+	r.RemoteAddr = "192.0.2.4:1234"
+	if got := OriginalRemoteAddr(r); got != "192.0.2.4:1234" {
+		t.Fatalf("without captured peer, got %q", got)
+	}
+	r = r.WithContext(WithTransportPeerAddr(r.Context(), r.RemoteAddr))
+	r.RemoteAddr = "10.0.0.1:1234"
+	if got := OriginalRemoteAddr(r); got != "192.0.2.4:1234" {
+		t.Fatalf("after RemoteAddr changed, got %q", got)
+	}
+}
