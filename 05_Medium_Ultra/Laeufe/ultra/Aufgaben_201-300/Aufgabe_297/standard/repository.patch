+// handleLoginFromHeaders authenticates a request only when it comes from a
+// configured reverse proxy and carries a username in the configured header.
+// A proxy-provided username is enough to create an account on its first visit.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+	if !validateIPAgainstList(request.OriginalRemoteAddr(r), conf.Server.ReverseProxyWhitelist) {
+		return nil
+	}
+
+	header := conf.Server.ReverseProxyUserHeader
+	if header == "" {
+		header = "Remote-User"
+	}
+	username := strings.TrimSpace(r.Header.Get(header))
+	if username == "" {
+		return nil
+	}
+
+	userRepo := ds.User(r.Context())
+	user, err := userRepo.FindByUsername(username)
+	// Some repositories use SQL LIKE for this lookup. A wildcard in the
+	// forwarded username must never resolve to somebody else's account.
+	if err == nil && (user == nil || !strings.EqualFold(user.UserName, username)) {
+		return nil
+	}
+	if err == model.ErrNotFound {
+		count, countErr := userRepo.CountAll()
+		if countErr != nil {
+			log.Error(r, "Could not count users for reverse proxy login", countErr)
+			return nil
+		}
+
+		now := time.Now()
+		user = &model.User{
+			ID:          uuid.NewString(),
+			UserName:    username,
+			Name:        strings.Title(username),
+			NewPassword: uuid.NewString(),
+			IsAdmin:     count == 0,
+			LastLoginAt: &now,
+		}
+		if err = userRepo.Put(user); err != nil {
+			log.Error(r, "Could not create reverse proxy user", "username", username, err)
+			return nil
+		}
+		// Read the account as stored, including its password for Subsonic auth.
+		user, err = userRepo.FindByUsername(username)
+	} else if err == nil {
+		if err = userRepo.UpdateLastLoginAt(user.ID); err != nil {
+			log.Error(r, "Could not update LastLoginAt for reverse proxy user", "username", username, err)
+			return nil
+		}
+		now := time.Now()
+		user.LastLoginAt = &now
+	}
+	if err != nil || user == nil || !strings.EqualFold(user.UserName, username) {
+		log.Error(r, "Could not load reverse proxy user", "username", username, err)
+		return nil
+	}
+
+	auth.Init(ds)
+	token, err := auth.CreateToken(user)
+	if err != nil {
+		log.Error(r, "Could not create reverse proxy login token", "username", username, err)
+		return nil
+	}
+
+	salt := uuid.NewString()[:6]
+	subsonicToken := fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt)))
+	payload := map[string]interface{}{
+		"id":            user.ID,
+		"isAdmin":       user.IsAdmin,
+		"name":          user.Name,
+		"username":      user.UserName,
+		"token":         token,
+		"subsonicSalt":  salt,
+		"subsonicToken": subsonicToken,
+	}
+	if conf.Server.EnableGravatar && user.Email != "" {
+		payload["avatar"] = gravatar.Url(user.Email, 50)
+	}
+	return payload
+}
