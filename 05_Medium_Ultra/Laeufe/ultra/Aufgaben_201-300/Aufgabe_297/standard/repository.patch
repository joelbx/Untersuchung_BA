@@ -0,0 +1,55 @@
+package app
+
+import (
+	"net"
+	"strconv"
+	"strings"
+)
+
+// validateIPAgainstList reports whether the connection peer is in one of the
+// configured proxy networks. Invalid entries are skipped so they cannot grant
+// access or prevent later valid entries from matching.
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+	if whitelist == "" {
+		return false
+	}
+
+	remoteAddr = strings.TrimSpace(remoteAddr)
+	ip := parseProxyIP(remoteAddr)
+	for _, rawEntry := range strings.Split(whitelist, ",") {
+		entry := strings.TrimSpace(rawEntry)
+		if entry == "@" && remoteAddr == "@" {
+			return true
+		}
+		if ip == nil || entry == "" {
+			continue
+		}
+		if _, network, err := net.ParseCIDR(entry); err == nil {
+			if network.Contains(ip) {
+				return true
+			}
+			continue
+		}
+		// A single IP address is also a useful whitelist entry. Host:port
+		// forms are accepted for compatibility; the whitelist checks the IP.
+		if allowedIP := parseProxyIP(entry); allowedIP != nil && allowedIP.Equal(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func parseProxyIP(address string) net.IP {
+	if ip := net.ParseIP(address); ip != nil {
+		return ip
+	}
+	host, port, err := net.SplitHostPort(address)
+	if err != nil || port == "" {
+		return nil
+	}
+	portNumber, err := strconv.Atoi(port)
+	if err != nil || portNumber < 0 || portNumber > 65535 {
+		return nil
+	}
+	return net.ParseIP(host)
+}
