+		conf.Server.ReverseProxyWhitelist = oldWhitelist
+		conf.Server.ReverseProxyUserHeader = oldHeader
+	}()
+	conf.Server.ReverseProxyWhitelist = "127.0.0.1/32"
+	conf.Server.ReverseProxyUserHeader = "X-Proxy-User"
+
+	repo := &loginTrackingUserRepo{MockedUserRepo: tests.CreateMockUserRepo()}
+	ds := &tests.MockDataStore{MockedUser: repo}
+	request := func(remoteAddr, username string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest("GET", "/app/", nil)
+		r.RemoteAddr = remoteAddr
+		r.Header.Set("X-Proxy-User", username)
+		w := httptest.NewRecorder()
+		serveIndex(ds, os.DirFS("tests/fixtures"))(w, r)
+		return w
+	}
+
+	for _, remoteAddr := range []string{"192.0.2.1:5000", "@"} {
+		config := extractAppConfig(request(remoteAddr, "first").Body.String())
+		if _, ok := config["auth"]; ok {
+			t.Fatalf("untrusted peer %q received authentication data", remoteAddr)
+		}
+	}
+	if count, _ := repo.CountAll(); count != 0 {
+		t.Fatalf("untrusted request created %d users", count)
+	}
+
+	config := extractAppConfig(request("127.0.0.1:5000", "first").Body.String())
+	payload, ok := config["auth"].(map[string]interface{})
+	if !ok {
+		t.Fatal("trusted proxy login has no auth payload")
+	}
+	if config["firstTime"] != false || payload["username"] != "first" || payload["name"] != "First" || payload["isAdmin"] != true {
+		t.Fatalf("unexpected first proxy user state: %#v", payload)
+	}
+	if payload["id"] == "" || payload["token"] == "" || payload["subsonicSalt"] == "" || payload["subsonicToken"] == "" {
+		t.Fatalf("incomplete proxy auth payload: %#v", payload)
+	}
+	if _, err := auth.Validate(payload["token"].(string)); err != nil {
+		t.Fatalf("invalid proxy auth token: %v", err)
+	}
