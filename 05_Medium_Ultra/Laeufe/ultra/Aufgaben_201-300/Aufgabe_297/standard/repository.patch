+// redactValue preserves map keys while redacting their values, including
+// values in nested maps. Other values use Go's default string formatting.
+func redactValue(re *regexp.Regexp, value interface{}) interface{} {
+	v := reflect.ValueOf(value)
+	if v.IsValid() && v.Kind() == reflect.Map {
+		if v.IsNil() {
+			return value
+		}
+
+		keys := v.MapKeys()
+		values := make([]interface{}, len(keys))
+		preserveType := true
+		for i, key := range keys {
+			if re.MatchString(fmt.Sprintf("%v", key.Interface())) {
+				values[i] = "[REDACTED]"
+			} else {
+				values[i] = redactValue(re, v.MapIndex(key).Interface())
+			}
+			redactedType := reflect.TypeOf(values[i])
+			if redactedType == nil || !redactedType.AssignableTo(v.Type().Elem()) {
+				preserveType = false
+			}
+		}
+
+		mapType := v.Type()
+		if !preserveType {
+			mapType = reflect.MapOf(mapType.Key(), reflect.TypeOf((*interface{})(nil)).Elem())
+		}
+		redacted := reflect.MakeMapWithSize(mapType, len(keys))
+		for i, key := range keys {
+			if values[i] == nil {
+				redacted.SetMapIndex(key, reflect.Zero(mapType.Elem()))
+			} else {
+				redacted.SetMapIndex(key, reflect.ValueOf(values[i]))
+			}
+		}
+		return redacted.Interface()
+	}
+
+	text := fmt.Sprintf("%v", value)
+	if v.IsValid() && v.Kind() == reflect.String {
+		text = v.String()
+	}
+	return re.ReplaceAllString(text, "$1[REDACTED]$2")
+}
