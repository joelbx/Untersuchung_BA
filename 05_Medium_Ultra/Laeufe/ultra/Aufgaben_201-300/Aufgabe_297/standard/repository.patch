+func (repo *loginTrackingUserRepo) UpdateLastLoginAt(id string) error {
+	repo.updatedID = id
+	for _, user := range repo.Data {
+		if user.ID == id {
+			now := time.Now()
+			user.LastLoginAt = &now
+		}
+	}
+	return nil
