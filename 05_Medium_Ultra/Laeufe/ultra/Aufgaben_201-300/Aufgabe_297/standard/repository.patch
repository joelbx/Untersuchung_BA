+package app
+
+import "testing"
+
+func TestValidateIPAgainstList(t *testing.T) {
+	tests := []struct {
+		name, remoteAddr, whitelist string
+		want                        bool
+	}{
+		{"disabled", "192.0.2.4:1234", "", false},
+		{"ipv4 network", "192.0.2.4:1234", "192.0.2.0/24", true},
+		{"ipv4 outside network", "192.0.3.4:1234", "192.0.2.0/24", false},
+		{"ipv6 network with port", "[2001:db8::4]:1234", "2001:db8::/32", true},
+		{"ipv6 literal", "2001:db8::4", "2001:db8::4", true},
+		{"mixed ranges", "[2001:db8::4]:1234", "192.0.2.0/24, 2001:db8::/32", true},
+		{"invalid entries skipped", "192.0.2.4:1234", "not-a-cidr, 192.0.2.0/33, 192.0.2.0/24", true},
+		{"invalid entries cannot match", "192.0.2.4:1234", "not-a-cidr, 192.0.2.0/33", false},
+		{"single ipv4", "192.0.2.4:1234", "192.0.2.4", true},
+		{"single ipv4 with port", "192.0.2.4:1234", "192.0.2.4:8080", true},
+		{"invalid port ignored", "192.0.2.4:1234", "192.0.2.4:notaport", false},
+		{"single bracketed ipv6 with port", "[2001:db8::4]:1234", "[2001:db8::4]:8080", true},
+		{"unix socket allowed", "@", "192.0.2.0/24, @", true},
+		{"unix socket denied", "@", "192.0.2.0/24", false},
+		{"unix socket marker does not permit IP", "192.0.2.4:1234", "@", false},
+		{"forwarded value rejected", "192.0.2.4, 10.0.0.1", "192.0.2.0/24", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := validateIPAgainstList(tt.remoteAddr, tt.whitelist); got != tt.want {
+				t.Errorf("validateIPAgainstList(%q, %q) = %t, want %t", tt.remoteAddr, tt.whitelist, got, tt.want)
+			}
+		})
+	}
+}
