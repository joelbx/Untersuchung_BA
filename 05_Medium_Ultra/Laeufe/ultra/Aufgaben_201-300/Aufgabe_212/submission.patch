 )
 
+func TestConvertToVinfosWPScanFields(t *testing.T) {
+	const payloadPrefix = `{"6.3.1":{"vulnerabilities":[{
+		"id":"12345",
+		"title":"Example vulnerability",
+		"created_at":"2024-01-02T12:30:00+09:00",
+		"updated_at":"2024-02-03T14:45:00+09:00",
+		"vuln_type":"SQLi",
+		"references":{
+			"cve":["2024-12345","2024-99999"],
+			"url":["https://example.org/z","https://example.org/a","https://example.org/m"]
+		}`
+	const payloadSuffix = `}]}}`
+
+	tests := []struct {
+		name          string
+		extraFields   string
+		fixedIn       string
+		summary       string
+		optional      map[string]string
+		cvss3Score    float64
+		cvss3Vector   string
+		cvss3Severity string
+	}{
+		{
+			name: "enterprise fields",
+			extraFields: `,
+				"fixed_in":"6.3.2",
+				"description":"An authenticated user can inject SQL.",
+				"poc":"https://example.org/proof",
+				"introduced_in":"6.2.0",
+				"cvss":{"score":9.8,"vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","severity":"critical"}`,
+			fixedIn:       "6.3.2",
+			summary:       "An authenticated user can inject SQL.",
+			optional:      map[string]string{"poc": "https://example.org/proof", "introduced_in": "6.2.0"},
+			cvss3Score:    9.8,
+			cvss3Vector:   "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
+			cvss3Severity: "critical",
+		},
+		{
+			name:     "basic fields omitted",
+			optional: map[string]string{},
+		},
+		{
+			name: "basic fields null",
+			extraFields: `,
+				"fixed_in":null,
+				"description":null,
+				"poc":null,
+				"introduced_in":null,
+				"cvss":null`,
+			optional: map[string]string{},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			vinfos, err := convertToVinfos("core", payloadPrefix+tt.extraFields+payloadSuffix)
+			if err != nil {
+				t.Fatalf("convertToVinfos: %v", err)
+			}
+			if len(vinfos) != 1 {
+				t.Fatalf("got %d vulnerability records, want one for the first CVE", len(vinfos))
+			}
+
+			got := vinfos[0]
+			if got.CveID != "CVE-2024-12345" {
+				t.Errorf("CveID = %q, want first references.cve", got.CveID)
+			}
+			if got.VulnType != "SQLi" {
+				t.Errorf("VulnType = %q, want SQLi", got.VulnType)
+			}
+			if len(got.WpPackageFixStats) != 1 || got.WpPackageFixStats[0].Name != "core" || got.WpPackageFixStats[0].FixedIn != tt.fixedIn {
+				t.Errorf("WpPackageFixStats = %#v, want core fixed in %q", got.WpPackageFixStats, tt.fixedIn)
+			}
+
+			contents := got.CveContents[models.WpScan]
+			if len(contents) != 1 {
+				t.Fatalf("got %d WPScan contents, want one", len(contents))
+			}
+			content := contents[0]
+			if content.Type != models.WpScan || string(content.Type) != "wpscan" {
+				t.Errorf("content.Type = %q, want wpscan", content.Type)
+			}
+			if content.CveID != got.CveID {
+				t.Errorf("content.CveID = %q, want %q", content.CveID, got.CveID)
+			}
+			if content.Title != "Example vulnerability" {
+				t.Errorf("content.Title = %q, want Example vulnerability", content.Title)
+			}
+			wantRefs := models.References{
+				{Link: "https://example.org/z"},
+				{Link: "https://example.org/a"},
+				{Link: "https://example.org/m"},
+			}
+			if !reflect.DeepEqual(content.References, wantRefs) {
+				t.Errorf("References = %#v, want %#v", content.References, wantRefs)
+			}
+			wantPublished := time.Date(2024, time.January, 2, 3, 30, 0, 0, time.UTC)
+			wantModified := time.Date(2024, time.February, 3, 5, 45, 0, 0, time.UTC)
+			if !content.Published.Equal(wantPublished) || content.Published.Location() != time.UTC {
+				t.Errorf("Published = %v, want %v in UTC", content.Published, wantPublished)
+			}
+			if !content.LastModified.Equal(wantModified) || content.LastModified.Location() != time.UTC {
+				t.Errorf("LastModified = %v, want %v in UTC", content.LastModified, wantModified)
+			}
+			if content.Summary != tt.summary {
+				t.Errorf("Summary = %q, want %q", content.Summary, tt.summary)
+			}
+			if content.Optional == nil || !reflect.DeepEqual(content.Optional, tt.optional) {
+				t.Errorf("Optional = %#v, want non-nil %#v", content.Optional, tt.optional)
+			}
+			if content.Cvss3Score != tt.cvss3Score || content.Cvss3Vector != tt.cvss3Vector || content.Cvss3Severity != tt.cvss3Severity {
+				t.Errorf("CVSS3 = (%v, %q, %q), want (%v, %q, %q)",
+					content.Cvss3Score, content.Cvss3Vector, content.Cvss3Severity,
+					tt.cvss3Score, tt.cvss3Vector, tt.cvss3Severity)
+			}
+		})
+	}
+}
