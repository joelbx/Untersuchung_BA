diff --git a/cmd/flipt/config_test.go b/cmd/flipt/config_test.go
new file mode 100644
index 0000000..b002d1b
--- /dev/null
+++ b/cmd/flipt/config_test.go
@@ -0,0 +1,222 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io/ioutil"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestSchemeString(t *testing.T) {
+	for _, test := range []struct {
+		scheme Scheme
+		want   string
+	}{
+		{HTTP, "http"},
+		{HTTPS, "https"},
+	} {
+		if got := test.scheme.String(); got != test.want {
+			t.Errorf("%v.String() = %q; want %q", test.scheme, got, test.want)
+		}
+	}
+}
+
+func TestConfigureDefaults(t *testing.T) {
+	got, err := configure("testdata/config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if want := defaultConfig(); !reflect.DeepEqual(got, want) {
+		t.Errorf("default YAML configuration = %#v; want %#v", got, want)
+	}
+}
+
+func TestConfigureAdvancedHTTPS(t *testing.T) {
+	got, err := configure("testdata/config/advanced.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	want := &config{
+		LogLevel: "WARN",
+		UI:       uiConfig{Enabled: false},
+		Cors: corsConfig{
+			Enabled:        true,
+			AllowedOrigins: []string{"foo.com"},
+		},
+		Cache: cacheConfig{Memory: memoryCacheConfig{Enabled: true, Items: 5000}},
+		Server: serverConfig{
+			Host:      "127.0.0.1",
+			Protocol:  HTTPS,
+			HTTPPort:  8081,
+			HTTPSPort: 8080,
+			GRPCPort:  9001,
+			CertFile:  "./testdata/config/ssl_cert.pem",
+			CertKey:   "./testdata/config/ssl_key.pem",
+		},
+		Database: databaseConfig{
+			URL:            "postgres://postgres@localhost:5432/flipt?sslmode=disable",
+			MigrationsPath: "./config/migrations",
+		},
+	}
+
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("advanced YAML configuration = %#v; want %#v", got, want)
+	}
+}
+
+func TestConfigureLegacyHTTP(t *testing.T) {
+	path, cleanup := writeTestConfig(t, "server:\n  host: 127.0.0.1\n  http_port: 8081\n  grpc_port: 9001\n")
+	defer cleanup()
+
+	got, err := configure(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if got.Server.Protocol != HTTP || got.Server.Host != "127.0.0.1" || got.Server.HTTPPort != 8081 || got.Server.HTTPSPort != 443 || got.Server.GRPCPort != 9001 {
+		t.Errorf("legacy HTTP server configuration = %#v", got.Server)
+	}
+}
+
+func TestConfigureAllowedOriginsForms(t *testing.T) {
+	for _, enabled := range []string{"", "  enabled: false\n", "  enabled: true\n"} {
+		for _, origins := range []string{"\"foo.com\"", "[foo.com]"} {
+			path, cleanup := writeTestConfig(t, "cors:\n"+enabled+"  allowed_origins: "+origins+"\n")
+			got, err := configure(path)
+			cleanup()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if want := []string{"foo.com"}; !reflect.DeepEqual(got.Cors.AllowedOrigins, want) {
+				t.Errorf("allowed_origins: %s with enabled %q = %q; want %q", origins, enabled, got.Cors.AllowedOrigins, want)
+			}
+		}
+	}
+}
+
+func TestConfigureEnvironmentOverrides(t *testing.T) {
+	name := "FLIPT_SERVER_HTTP_PORT"
+	old, hadOld := os.LookupEnv(name)
+	if err := os.Setenv(name, "8181"); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if hadOld {
+			_ = os.Setenv(name, old)
+		} else {
+			_ = os.Unsetenv(name)
+		}
+	}()
+
+	got, err := configure("testdata/config/default.yml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Server.HTTPPort != 8181 {
+		t.Errorf("FLIPT_SERVER_HTTP_PORT override = %d; want 8181", got.Server.HTTPPort)
+	}
+}
+
+func TestHTTPSValidation(t *testing.T) {
+	missingDir, err := ioutil.TempDir("", "flipt-missing-tls-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(missingDir)
+
+	cert := "./testdata/config/ssl_cert.pem"
+	key := "./testdata/config/ssl_key.pem"
+	missingCert := filepath.Join(missingDir, "missing-cert.pem")
+	missingKey := filepath.Join(missingDir, "missing-key.pem")
+
+	for _, test := range []struct {
+		name     string
+		certFile string
+		certKey  string
+		wantErr  string
+	}{
+		{"empty cert file", "", key, "cert_file cannot be empty when using HTTPS"},
+		{"empty cert key", cert, "", "cert_key cannot be empty when using HTTPS"},
+		{"missing cert file", missingCert, key, fmt.Sprintf("cannot find TLS cert_file at %q", missingCert)},
+		{"missing cert key", cert, missingKey, fmt.Sprintf("cannot find TLS cert_key at %q", missingKey)},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			cfg := defaultConfig()
+			cfg.Server.Protocol = HTTPS
+			cfg.Server.CertFile = test.certFile
+			cfg.Server.CertKey = test.certKey
+			if err := cfg.validate(); err == nil || err.Error() != test.wantErr {
+				t.Errorf("validate() error = %v; want %q", err, test.wantErr)
+			}
+		})
+	}
+
+	cfg := defaultConfig()
+	cfg.Server.Protocol = HTTP
+	cfg.Server.CertFile = missingCert
+	cfg.Server.CertKey = missingKey
+	if err := cfg.validate(); err != nil {
+		t.Errorf("HTTP validation with unused certificate paths: %v", err)
+	}
+}
+
+func TestConfigureReturnsValidationError(t *testing.T) {
+	path, cleanup := writeTestConfig(t, "server:\n  protocol: https\n")
+	defer cleanup()
+
+	_, err := configure(path)
+	if err == nil || err.Error() != "cert_file cannot be empty when using HTTPS" {
+		t.Errorf("configure() error = %v; want exact missing certificate error", err)
+	}
+}
+
+func TestMetadataHandlers(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		handler http.Handler
+		field   string
+	}{
+		{"config", defaultConfig(), "server"},
+		{"info", info{Version: "test-version"}, "version"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			test.handler.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/meta/"+test.name, nil))
+			if recorder.Code != http.StatusOK {
+				t.Errorf("status = %d; want %d", recorder.Code, http.StatusOK)
+			}
+			if strings.TrimSpace(recorder.Body.String()) == "" {
+				t.Fatal("response body is empty")
+			}
+			var body map[string]interface{}
+			if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
+				t.Fatalf("response is not JSON: %v", err)
+			}
+			if _, ok := body[test.field]; !ok {
+				t.Errorf("response body does not contain %q: %s", test.field, recorder.Body.String())
+			}
+		})
+	}
+}
+
+func writeTestConfig(t *testing.T, contents string) (string, func()) {
+	t.Helper()
+	dir, err := ioutil.TempDir("", "flipt-config-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "config.yml")
+	if err := ioutil.WriteFile(path, []byte(contents), 0600); err != nil {
+		_ = os.RemoveAll(dir)
+		t.Fatal(err)
+	}
+	return path, func() { _ = os.RemoveAll(dir) }
+}
