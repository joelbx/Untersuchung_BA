+tokens.generate = async (data) => {
+	if (!data || !['string', 'number'].includes(typeof data.uid) || String(data.uid).trim() === '') {
+		throw invalidData();
+	}
+
+	const uid = Number(data.uid);
+	if (!Number.isSafeInteger(uid) || uid < 0) {
+		throw invalidData();
+	}
+	if (data.description !== undefined && typeof data.description !== 'string') {
+		throw invalidData();
+	}
+	if (uid !== 0 && !await user.exists(uid)) {
+		throw new Error('[[error:no-user]]');
+	}
+
+	const token = generateUUID();
+	const timestamp = Date.now();
+	if (!Number.isFinite(timestamp)) {
+		throw invalidData();
+	}
+	await db.setObject(`token:${token}`, {
+		uid: uid,
+		description: data.description === undefined ? '' : data.description,
+		timestamp: timestamp,
+	});
+	await Promise.all([
+		db.sortedSetAdd('tokens:createtime', timestamp, token),
+		db.sortedSetAdd('tokens:uid', uid, token),
+	]);
+	return token;
+};
+
+tokens.get = async (input) => {
+	const isArray = Array.isArray(input);
+	const tokenIds = isArray ? input : [input];
+	if (!tokenIds.every(isToken)) {
+		throw invalidData();
+	}
+	if (!tokenIds.length) {
+		return [];
+	}
+
+	const [objects, lastSeen] = await Promise.all([
+		db.getObjects(tokenIds.map(token => `token:${token}`)),
+		tokens.getLastSeen(tokenIds),
+	]);
+	const result = objects.map((object, index) => {
+		if (!object) {
+			return null;
+		}
+		const uid = Number(object.uid);
+		const timestamp = Number(object.timestamp);
+		if (!Number.isSafeInteger(uid) || !Number.isFinite(timestamp)) {
+			throw invalidData();
+		}
+		return {
+			token: tokenIds[index],
+			uid: uid,
+			description: object.description === undefined ? '' : object.description,
+			timestamp: timestamp,
+			lastSeen: lastSeen[index],
+		};
+	});
+	return isArray ? result : result[0];
+};
+
+tokens.update = async (token, data) => {
+	if (!isToken(token) || !data || typeof data.description !== 'string') {
+		throw invalidData();
+	}
+	if (!await db.exists(`token:${token}`)) {
+		throw invalidData();
+	}
+	await db.setObjectField(`token:${token}`, 'description', data.description);
+	return await tokens.get(token);
+};
+
+tokens.delete = async (token) => {
+	if (!isToken(token)) {
+		throw invalidData();
+	}
+	await db.delete(`token:${token}`);
+	await db.sortedSetRemove(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen'], token);
+};
+
+tokens.log = async (token) => {
+	if (!isToken(token)) {
+		throw invalidData();
+	}
 	await db.sortedSetAdd('tokens:lastSeen', Date.now(), token);
 };
 
-utils.getLastSeen = async tokens => await db.sortedSetScores('tokens:lastSeen', tokens);
+tokens.getLastSeen = async (tokenIds) => {
+	if (!Array.isArray(tokenIds) || !tokenIds.every(isToken)) {
+		throw invalidData();
+	}
+	if (!tokenIds.length) {
+		return [];
+	}
+	const scores = await db.sortedSetScores('tokens:lastSeen', tokenIds);
+	return tokenIds.map((token, index) => {
+		const score = scores[index];
+		if (score === null || score === undefined) {
+			return null;
+		}
+		const value = Number(score);
+		return Number.isFinite(value) ? value : null;
+	});
+};
+
+// Keep the existing api.utils callers working while exposing a single token namespace.
+Object.assign(utils, tokens);
