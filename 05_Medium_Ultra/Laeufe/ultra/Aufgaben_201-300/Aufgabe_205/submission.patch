diff --git a/test/api-utils-tokens.js b/test/api-utils-tokens.js
new file mode 100644
index 0000000..530349b
--- /dev/null
+++ b/test/api-utils-tokens.js
@@ -0,0 +1,152 @@
+'use strict';
+
+const assert = require('assert');
+const mockdate = require('mockdate');
+
+const db = require('./mocks/databasemock');
+const api = require('../src/api');
+const user = require('../src/user');
+const { generateUUID } = require('../src/utils');
+
+describe('API token utilities', () => {
+	const { tokens } = api.utils;
+	let created = [];
+
+	afterEach(async () => {
+		mockdate.reset();
+		await Promise.all(created.map(token => tokens.delete(token)));
+		created = [];
+	});
+
+	async function generate(data) {
+		const token = await tokens.generate(data);
+		created.push(token);
+		return token;
+	}
+
+	it('returns an empty list before tokens are created', async () => {
+		assert.deepStrictEqual(await tokens.list(), []);
+	});
+
+	it('generates master and user tokens with metadata and index scores', async () => {
+		const uid = await user.create({ username: `token-${generateUUID().slice(0, 12)}` });
+		const before = Date.now();
+		const masterToken = await generate({ uid: 0 });
+		const userToken = await generate({ uid, description: 'integration test' });
+		const after = Date.now();
+
+		assert.strictEqual(typeof masterToken, 'string');
+		assert.strictEqual(typeof userToken, 'string');
+		assert.notStrictEqual(masterToken, userToken);
+		await Promise.all([[masterToken, 0], [userToken, uid]].map(async ([token, expectedUid]) => {
+			// The hash representation may stringify numbers, but its values must remain numeric.
+			const stored = await db.getObject(`token:${token}`);
+			assert.strictEqual(Number(stored.uid), expectedUid);
+			assert(Object.prototype.hasOwnProperty.call(stored, 'description'));
+			const timestamp = Number(stored.timestamp);
+			assert(Number.isFinite(timestamp));
+			assert(timestamp >= before && timestamp <= after);
+			assert.strictEqual(await db.sortedSetScore('tokens:createtime', token), timestamp);
+			assert.strictEqual(await db.sortedSetScore('tokens:uid', token), expectedUid);
+		}));
+		assert.strictEqual((await db.getObject(`token:${userToken}`)).description, 'integration test');
+		assert.strictEqual((await tokens.get(masterToken)).lastSeen, null);
+	});
+
+	it('rejects a token for a user that does not exist', async () => {
+		await assert.rejects(tokens.generate({ uid: Number.MAX_SAFE_INTEGER }), {
+			message: '[[error:no-user]]',
+		});
+	});
+
+	it('returns a single token or an aligned array and handles empty input', async () => {
+		const first = await generate({ uid: 0, description: 'first' });
+		const second = await generate({ uid: 0, description: 'second' });
+		const firstDetails = await tokens.get(first);
+		const secondDetails = await tokens.get(second);
+
+		assert.strictEqual(firstDetails.token, first);
+		assert.strictEqual(firstDetails.uid, 0);
+		assert.strictEqual(firstDetails.description, 'first');
+		assert(Number.isFinite(firstDetails.timestamp));
+		assert.strictEqual(firstDetails.lastSeen, null);
+		assert.deepStrictEqual(await tokens.get([second, first, second]), [
+			secondDetails, firstDetails, secondDetails,
+		]);
+		assert.deepStrictEqual(await tokens.get([]), []);
+		await assert.rejects(tokens.get(null), { message: '[[error:invalid-data]]' });
+		await assert.rejects(tokens.get(undefined), { message: '[[error:invalid-data]]' });
+	});
+
+	it('lists hydrated tokens in creation-time order', async () => {
+		const base = Date.now();
+		let first;
+		let second;
+		try {
+			mockdate.set(base);
+			first = await generate({ uid: 0, description: 'created first' });
+			mockdate.set(base + 10);
+			second = await generate({ uid: 0, description: 'created second' });
+		} finally {
+			mockdate.reset();
+		}
+
+		const indexTokens = await db.getSortedSetRange('tokens:createtime', 0, -1);
+		const listed = await tokens.list();
+		assert.deepStrictEqual(listed.map(item => item.token), indexTokens);
+		assert(indexTokens.indexOf(first) < indexTokens.indexOf(second));
+		assert.deepStrictEqual(listed.find(item => item.token === first), await tokens.get(first));
+		assert.deepStrictEqual(listed.find(item => item.token === second), await tokens.get(second));
+	});
+
+	it('updates only the description and preserves metadata and last-seen time', async () => {
+		const token = await generate({ uid: 0, description: 'original' });
+		await tokens.log(token);
+		const before = await tokens.get(token);
+		const updated = await tokens.update(token, { description: 'changed' });
+		const stored = await db.getObject(`token:${token}`);
+
+		assert.deepStrictEqual(updated, { ...before, description: 'changed' });
+		assert.strictEqual(Number(stored.uid), before.uid);
+		assert.strictEqual(Number(stored.timestamp), before.timestamp);
+		assert.strictEqual(stored.description, 'changed');
+		assert.strictEqual(await db.sortedSetScore('tokens:createtime', token), before.timestamp);
+		assert.strictEqual(await db.sortedSetScore('tokens:uid', token), before.uid);
+	});
+
+	it('logs usage and returns last-seen scores in input order', async () => {
+		const first = await generate({ uid: 0 });
+		const second = await generate({ uid: 0 });
+		assert.deepStrictEqual(await tokens.getLastSeen([first, second]), [null, null]);
+		assert.deepStrictEqual(await tokens.getLastSeen([]), []);
+
+		const before = Date.now();
+		await tokens.log(second);
+		const after = Date.now();
+		const scores = await tokens.getLastSeen([first, second, first]);
+		assert.strictEqual(scores[0], null);
+		assert.strictEqual(scores[2], null);
+		assert(Number.isFinite(scores[1]));
+		assert(scores[1] >= before && scores[1] <= after);
+		assert.strictEqual(scores[1], await db.sortedSetScore('tokens:lastSeen', second));
+
+		await tokens.log(first);
+		const seen = await tokens.getLastSeen([second, first]);
+		assert.deepStrictEqual(seen, [
+			(await tokens.get(second)).lastSeen,
+			(await tokens.get(first)).lastSeen,
+		]);
+	});
+
+	it('deletes the token hash and all index memberships', async () => {
+		const token = await generate({ uid: 0 });
+		await tokens.log(token);
+		await tokens.delete(token);
+
+		assert.strictEqual(await db.exists(`token:${token}`), false);
+		const scores = await Promise.all(['tokens:createtime', 'tokens:uid', 'tokens:lastSeen']
+			.map(key => db.sortedSetScore(key, token)));
+		assert.deepStrictEqual(scores, [null, null, null]);
+		assert.strictEqual(await tokens.get(token), null);
+	});
+});
