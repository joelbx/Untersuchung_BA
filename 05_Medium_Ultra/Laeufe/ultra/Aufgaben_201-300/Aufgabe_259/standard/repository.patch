+    @pytest.mark.asyncio
+    async def test_public_edition_preferred_after_restricted_editions(self):
+        w = make_work()
+        update_work.data_provider = FakeDataProvider(
+            [
+                w,
+                make_edition(
+                    w,
+                    key="/books/OL11M",
+                    ocaid='borrowable-item',
+                    _ia_meta={
+                        "collection": ['inlibrary', 'lendinglibrary', 'americana']
+                    },
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL12M",
+                    ocaid='printdisabled-one',
+                    _ia_meta={"collection": ['printdisabled']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL13M",
+                    ocaid='printdisabled-two',
+                    _ia_meta={"collection": ['printdisabled', 'inlibrary']},
+                ),
+                make_edition(
+                    w,
+                    key="/books/OL14M",
+                    ocaid='public-item',
+                    _ia_meta={"collection": ['opensource', 'americana']},
+                ),
+            ]
+        )
