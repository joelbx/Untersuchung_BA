+            'borrowable-item',
+            'printdisabled-one',
+            'printdisabled-two',
+            'public-item',
+        }
+        assert sss(d['ia_collection_s']) == sss(
+            'americana;inlibrary;lendinglibrary;printdisabled;opensource'
+        )
