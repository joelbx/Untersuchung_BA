+func TestDeleteAuthenticationAudit(t *testing.T) {
+	tests := []struct {
+		name                string
+		tokenDeletedEnabled bool
+		method              rpcauth.Method
+		deleteFails         bool
+		wantGetCalls        int
+		wantEvent           bool
+	}{
+		{name: "token deletion enabled", tokenDeletedEnabled: true, method: rpcauth.Method_METHOD_TOKEN, wantGetCalls: 1, wantEvent: true},
+		{name: "token deletion disabled", method: rpcauth.Method_METHOD_TOKEN},
+		{name: "other authentication method", tokenDeletedEnabled: true, method: rpcauth.Method_METHOD_OIDC, wantGetCalls: 1},
+		{name: "failed token deletion", tokenDeletedEnabled: true, method: rpcauth.Method_METHOD_TOKEN, deleteFails: true, wantGetCalls: 1},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			store := &auditStore{Store: memory.NewStore()}
+			if tt.deleteFails {
+				store.deleteErr = fmt.Errorf("delete failed")
+			}
+
+			_, authentication, err := store.CreateAuthentication(context.Background(), &storageauth.CreateAuthenticationRequest{
+				Method:   tt.method,
+				Metadata: map[string]string{"name": "example"},
+			})
+			require.NoError(t, err)
+
+			recorder := tracetest.NewSpanRecorder()
+			provider := sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(recorder))
+			t.Cleanup(func() { require.NoError(t, provider.Shutdown(context.Background())) })
+			ctx, span := provider.Tracer("auth-test").Start(context.Background(), "DeleteAuthentication")
+
+			server := auth.NewServer(zaptest.NewLogger(t), store, auth.WithAuditLoggingEnabled(tt.tokenDeletedEnabled))
+			_, err = server.DeleteAuthentication(ctx, &rpcauth.DeleteAuthenticationRequest{Id: authentication.Id})
+			span.End()
+
+			if tt.deleteFails {
+				require.ErrorContains(t, err, "delete failed")
+			} else {
+				require.NoError(t, err)
+			}
+			require.Equal(t, tt.wantGetCalls, store.getCalls)
+
+			spans := recorder.Ended()
+			require.Len(t, spans, 1)
+			events := spans[0].Events()
+			if !tt.wantEvent {
+				require.Empty(t, events)
+				return
+			}
+
+			require.Len(t, events, 1)
+			attributes := make(map[string]string)
+			for _, attr := range events[0].Attributes {
+				attributes[string(attr.Key)] = attr.Value.AsString()
+			}
+			require.Equal(t, "token", attributes["flipt.event.type"])
+			require.Equal(t, "deleted", attributes["flipt.event.action"])
+			require.JSONEq(t, `{"name":"example"}`, attributes["flipt.event.payload"])
+		})
+	}
+}
