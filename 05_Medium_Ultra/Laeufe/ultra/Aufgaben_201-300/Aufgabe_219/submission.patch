+func TestCheckerTokenEvents(t *testing.T) {
+	testCases := []struct {
+		name           string
+		eventPairs     []string
+		createdEnabled bool
+		deletedEnabled bool
+	}{
+		{
+			name:           "token creation enabled",
+			eventPairs:     []string{"token:created"},
+			createdEnabled: true,
+		},
+		{
+			name:           "token deletion enabled",
+			eventPairs:     []string{"token:deleted"},
+			deletedEnabled: true,
+		},
+		{
+			name:           "all token actions enabled",
+			eventPairs:     []string{"token:*"},
+			createdEnabled: true,
+			deletedEnabled: true,
+		},
+		{
+			name:           "deletion enabled for all resources",
+			eventPairs:     []string{"*:deleted"},
+			deletedEnabled: true,
+		},
+		{
+			name:           "all events enabled",
+			eventPairs:     []string{"*:*"},
+			createdEnabled: true,
+			deletedEnabled: true,
+		},
+		{
+			name:       "unrelated event enabled",
+			eventPairs: []string{"flag:deleted"},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			checker, err := NewChecker(tc.eventPairs)
+			assert.NoError(t, err)
+			if checker == nil {
+				return
+			}
+
+			assert.Equal(t, tc.createdEnabled, checker.Check("token:created"))
+			assert.Equal(t, tc.deletedEnabled, checker.Check("token:deleted"))
+		})
+	}
+}
