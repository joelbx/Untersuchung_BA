+
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { handleEvent } from "../../../src/legacy/LegacyCallHandler/handleEvent";
+import SettingsStore from "../../../src/settings/SettingsStore";
+
+describe("handleEvent", () => {
+    let audio: HTMLAudioElement;
+    let errorSpy: jest.SpyInstance;
+    let debugSpy: jest.SpyInstance;
+    let settingSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+        audio = document.createElement("audio");
+        audio.id = "ringAudio";
+        errorSpy = jest.spyOn(logger, "error").mockImplementation(() => {});
+        debugSpy = jest.spyOn(logger, "debug").mockImplementation(() => {});
+        settingSpy = jest.spyOn(SettingsStore, "getValue").mockReturnValue(false);
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it.each(["error", "stalled"])("logs %s events with the media element id", (type) => {
+        audio.addEventListener(type, handleEvent);
+        audio.dispatchEvent(new Event(type));
+
+        expect(errorSpy).toHaveBeenCalledWith("Legacy call audio event", expect.objectContaining({
+            elementId: "ringAudio",
+            type,
+        }));
+        expect(debugSpy).not.toHaveBeenCalled();
+        expect(settingSpy).not.toHaveBeenCalled();
+    });
+
+    it("logs media state events when debug logging is enabled", () => {
+        settingSpy.mockReturnValue(true);
+        audio.addEventListener("playing", handleEvent);
+        audio.dispatchEvent(new Event("playing"));
+
+        expect(settingSpy).toHaveBeenCalledWith("debug_legacy_call_handler");
+        expect(debugSpy).toHaveBeenCalledWith("Legacy call audio event", {
+            elementId: "ringAudio",
+            type: "playing",
+        });
+        expect(errorSpy).not.toHaveBeenCalled();
+    });
+
+    it("does not log media state events when debug logging is disabled", () => {
+        audio.addEventListener("playing", handleEvent);
+        audio.dispatchEvent(new Event("playing"));
+
+        expect(settingSpy).toHaveBeenCalledWith("debug_legacy_call_handler");
+        expect(debugSpy).not.toHaveBeenCalled();
+        expect(errorSpy).not.toHaveBeenCalled();
+    });
+
+    it("ignores unrelated events", () => {
+        audio.addEventListener("click", handleEvent);
+        audio.dispatchEvent(new Event("click"));
+
+        expect(settingSpy).not.toHaveBeenCalled();
+        expect(debugSpy).not.toHaveBeenCalled();
+        expect(errorSpy).not.toHaveBeenCalled();
+    });
+});
