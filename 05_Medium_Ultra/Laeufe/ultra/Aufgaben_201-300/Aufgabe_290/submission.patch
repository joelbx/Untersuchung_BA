+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import { waitFor } from '@testing-library/react';
+
+import LegacyCallHandler, { AudioID } from '../src/LegacyCallHandler';
+
+describe('LegacyCallHandler call sounds', () => {
+    let audio: HTMLAudioElement;
+    let play: jest.SpyInstance;
+    let load: jest.SpyInstance;
+
+    beforeEach(() => {
+        audio = document.createElement('audio');
+        play = jest.spyOn(audio, 'play').mockResolvedValue(undefined);
+        load = jest.spyOn(audio, 'load').mockImplementation(() => undefined);
+    });
+
+    afterEach(() => {
+        audio.remove();
+        play.mockRestore();
+        load.mockRestore();
+    });
+
+    it.each([
+        AudioID.Ring,
+        AudioID.Ringback,
+        AudioID.Busy,
+        AudioID.CallEnd,
+    ])('unmutes %s before playing it', audioId => {
+        audio.id = audioId;
+        audio.muted = true;
+        document.body.appendChild(audio);
+        play.mockImplementation(() => {
+            expect(audio.muted).toBe(false);
+            return Promise.resolve();
+        });
+
+        new LegacyCallHandler().play(audioId);
+
+        expect(play).toHaveBeenCalledTimes(1);
+        expect(audio.muted).toBe(false);
+    });
+
+    it('plays an already unmuted sound without changing its muted state', () => {
+        audio.id = AudioID.Ring;
+        document.body.appendChild(audio);
+        const setMuted = jest.fn();
+        Object.defineProperty(audio, 'muted', {
+            configurable: true,
+            get: () => false,
+            set: setMuted,
+        });
+
+        new LegacyCallHandler().play(AudioID.Ring);
+
+        expect(play).toHaveBeenCalledTimes(1);
+        expect(setMuted).not.toHaveBeenCalled();
+    });
+
+    it('unmutes before a queued replay', async () => {
+        audio.id = AudioID.Ring;
+        document.body.appendChild(audio);
+        let finishFirstPlay: () => void;
+        const firstPlay = new Promise<void>(resolve => {
+            finishFirstPlay = resolve;
+        });
+        play.mockImplementationOnce(() => firstPlay).mockImplementationOnce(() => {
+            expect(audio.muted).toBe(false);
+            return Promise.resolve();
+        });
+
+        const handler = new LegacyCallHandler();
+        handler.play(AudioID.Ring);
+        handler.play(AudioID.Ring);
+        audio.muted = true;
+        finishFirstPlay();
+
+        await waitFor(() => expect(play).toHaveBeenCalledTimes(2));
+        expect(load).toHaveBeenCalledTimes(1);
+        expect(audio.muted).toBe(false);
+    });
+});
