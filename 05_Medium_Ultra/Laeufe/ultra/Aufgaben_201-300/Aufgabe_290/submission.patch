+import { logger } from "matrix-js-sdk/src/logger";
+
+import SettingsStore from "../../settings/SettingsStore";
+
+const errorEvents = new Set(["error", "stalled"]);
+const debugEvents = new Set([
+    "abort", "canplay", "canplaythrough", "durationchange", "emptied", "ended",
+    "loadeddata", "loadedmetadata", "loadstart", "pause", "play", "playing",
+    "ratechange", "seeked", "seeking", "suspend", "volumechange", "waiting",
+]);
+
+/** Listener for diagnostic events from a call sound's media element. */
+export function handleEvent(e: Event): void {
+    if (!errorEvents.has(e.type) && !debugEvents.has(e.type)) return;
+
+    // currentTarget is the element when this function is attached as an event listener.
+    // target also supports callers which invoke the listener directly.
+    const element = (e.currentTarget ?? e.target) as HTMLMediaElement | null;
+    const eventDetails = { elementId: element?.id, type: e.type };
+
+    if (errorEvents.has(e.type)) {
+        logger.error("Legacy call audio event", { ...eventDetails, error: element?.error });
+    } else if (SettingsStore.getValue("debug_legacy_call_handler")) {
+        logger.debug("Legacy call audio event", eventDetails);
+    }
+}
