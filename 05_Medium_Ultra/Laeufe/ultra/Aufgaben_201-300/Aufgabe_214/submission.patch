+
 func (l *base) ps() (string, error) {
 	cmd := `LANGUAGE=en_US.UTF-8 ps --no-headers --ppid 2 -p 2 --deselect -o pid,comm`
 	r := l.exec(util.PrependProxyEnv(cmd), noSudo)
diff --git a/scanner/portscan.go b/scanner/portscan.go
new file mode 100644
index 0000000..5169056
--- /dev/null
+++ b/scanner/portscan.go
@@ -0,0 +1,174 @@
+package scanner
+
+import (
+	"encoding/xml"
+	"net"
+	osExec "os/exec"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/future-architect/vuls/config"
+	"golang.org/x/xerrors"
+)
+
+// setScanTechniques converts configured scan types to nmap command arguments.
+func setScanTechniques(techniques []config.ScanTechnique) ([]string, error) {
+	options := make([]string, 0, len(techniques))
+	for _, technique := range techniques {
+		switch technique {
+		case config.TCPSYN, config.TCPConnect, config.TCPACK, config.TCPWindow,
+			config.TCPMaimon, config.TCPNull, config.TCPFIN, config.TCPXmas:
+			options = append(options, "-"+technique.String())
+		default:
+			return nil, xerrors.Errorf("unsupported port scan technique: %v", technique)
+		}
+	}
+	return options, nil
+}
+
+func formatNmapOptionsToString(options []string) string {
+	return strings.Join(options, " ")
+}
+
+type nmapScanResult struct {
+	XMLName xml.Name       `xml:"nmaprun"`
+	Hosts   []nmapScanHost `xml:"host"`
+}
+
+type nmapScanHost struct {
+	Addresses []struct {
+		Address string `xml:"addr,attr"`
+	} `xml:"address"`
+	Ports []struct {
+		Protocol string `xml:"protocol,attr"`
+		Number   string `xml:"portid,attr"`
+		State    struct {
+			Name string `xml:"state,attr"`
+		} `xml:"state"`
+	} `xml:"ports>port"`
+}
+
+func (l *base) execExternalPortScan(scanDestIPPorts map[string][]string) ([]string, error) {
+	conf := l.ServerInfo.PortScan
+	if conf == nil || conf.ScannerBinPath == "" {
+		return nil, xerrors.New("external port scanner path is empty")
+	}
+
+	scanOptions, err := setScanTechniques(conf.GetScanTechniques())
+	if err != nil {
+		return nil, err
+	}
+	if len(scanOptions) == 0 {
+		if conf.HasPrivileged {
+			scanOptions = []string{"-sS"}
+		} else {
+			scanOptions = []string{"-sT"}
+		}
+	}
+
+	options := []string{"-Pn", "-n"}
+	if conf.HasPrivileged {
+		options = append(options, "--privileged")
+	} else {
+		options = append(options, "--unprivileged")
+	}
+	options = append(options, scanOptions...)
+	if conf.SourcePort != "" {
+		options = append(options, "-g", conf.SourcePort)
+	}
+	options = append(options, "-oX", "-")
+
+	addresses := make([]string, 0, len(scanDestIPPorts))
+	for ip := range scanDestIPPorts {
+		addresses = append(addresses, ip)
+	}
+	sort.Strings(addresses)
+
+	openPorts := []string{}
+	for _, ip := range addresses {
+		if l.skipLoopbackPortScan(ip) {
+			continue
+		}
+		ports, err := portNumbersForNmap(scanDestIPPorts[ip])
+		if err != nil {
+			return nil, xerrors.Errorf("invalid port scan destination %s: %w", ip, err)
+		}
+		if len(ports) == 0 {
+			continue
+		}
+
+		args := append([]string{}, options...)
+		if parsed := net.ParseIP(ip); parsed != nil && parsed.To4() == nil {
+			args = append(args, "-6")
+		}
+		args = append(args, "-p", strings.Join(ports, ","), ip)
+		output, err := osExec.Command(conf.ScannerBinPath, args...).Output()
+		if err != nil {
+			if exitErr, ok := err.(*osExec.ExitError); ok {
+				return nil, xerrors.Errorf("nmap scan failed (%s): %w: %s", formatNmapOptionsToString(args), err, strings.TrimSpace(string(exitErr.Stderr)))
+			}
+			return nil, xerrors.Errorf("nmap scan failed (%s): %w", formatNmapOptionsToString(args), err)
+		}
+
+		var result nmapScanResult
+		if err := xml.Unmarshal(output, &result); err != nil {
+			return nil, xerrors.Errorf("failed to parse nmap XML for %s: %w", ip, err)
+		}
+		requested := make(map[string]bool, len(ports))
+		for _, port := range ports {
+			requested[port] = true
+		}
+		for _, host := range result.Hosts {
+			if !nmapHostMatchesTarget(host, ip) {
+				continue
+			}
+			for _, port := range host.Ports {
+				// Only "open" confirms the reachability reported by the native TCP scan.
+				if port.Protocol == "tcp" && port.State.Name == "open" && requested[port.Number] {
+					openPorts = append(openPorts, ip+":"+port.Number)
+				}
+			}
+		}
+	}
+	return openPorts, nil
+}
+
+func portNumbersForNmap(ports []string) ([]string, error) {
+	unique := map[string]bool{}
+	for _, port := range ports {
+		number, err := strconv.Atoi(port)
+		if err != nil || number < 1 || number > 65535 {
+			return nil, xerrors.Errorf("invalid TCP port: %q", port)
+		}
+		unique[strconv.Itoa(number)] = true
+	}
+	result := make([]string, 0, len(unique))
+	for port := range unique {
+		result = append(result, port)
+	}
+	sort.Slice(result, func(i, j int) bool {
+		left, _ := strconv.Atoi(result[i])
+		right, _ := strconv.Atoi(result[j])
+		return left < right
+	})
+	return result, nil
+}
+
+func nmapHostMatchesTarget(host nmapScanHost, target string) bool {
+	if len(host.Addresses) == 0 {
+		return true
+	}
+	targetIP := net.ParseIP(target)
+	for _, address := range host.Addresses {
+		if address.Address == target {
+			return true
+		}
+		if targetIP != nil {
+			if addressIP := net.ParseIP(address.Address); addressIP != nil && addressIP.Equal(targetIP) {
+				return true
+			}
+		}
+	}
+	return false
+}
