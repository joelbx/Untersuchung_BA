new file mode 100644
index 0000000..7a6e22c
--- /dev/null
+++ b/scanner/portscan_test.go
@@ -0,0 +1,120 @@
+package scanner
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestSetScanTechniques(t *testing.T) {
+	tests := []struct {
+		technique config.ScanTechnique
+		option    string
+	}{
+		{config.TCPSYN, "-sS"},
+		{config.TCPConnect, "-sT"},
+		{config.TCPACK, "-sA"},
+		{config.TCPWindow, "-sW"},
+		{config.TCPMaimon, "-sM"},
+		{config.TCPNull, "-sN"},
+		{config.TCPFIN, "-sF"},
+		{config.TCPXmas, "-sX"},
+	}
+	for _, tt := range tests {
+		got, err := setScanTechniques([]config.ScanTechnique{tt.technique})
+		if err != nil || !reflect.DeepEqual(got, []string{tt.option}) {
+			t.Errorf("setScanTechniques(%v) = %v, %v; want %s", tt.technique, got, err, tt.option)
+		}
+	}
+	if _, err := setScanTechniques([]config.ScanTechnique{config.NotSupportTechnique}); err == nil {
+		t.Fatal("unsupported scan technique was accepted")
+	}
+}
+
+func TestExecPortsScanExternal(t *testing.T) {
+	scannerPath := filepath.Join(t.TempDir(), "fake-nmap")
+	const expectedArgs = "-Pn -n --privileged -sS -g 443 -oX - -p 22,80 192.0.2.10"
+	script := `#!/bin/sh
+if [ "$*" != "` + expectedArgs + `" ]; then
+  echo "unexpected arguments: $*" >&2
+  exit 2
+fi
+cat <<'EOF'
+<?xml version="1.0"?>
+<nmaprun>
+  <host>
+    <address addr="192.0.2.10" addrtype="ipv4"/>
+    <ports>
+      <port protocol="tcp" portid="22"><state state="open"/></port>
+      <port protocol="tcp" portid="80"><state state="closed"/></port>
+      <port protocol="tcp" portid="443"><state state="open"/></port>
+    </ports>
+  </host>
+  <host><address addr="192.0.2.11"/><ports><port protocol="tcp" portid="80"><state state="open"/></port></ports></host>
+</nmaprun>
+EOF
+`
+	if err := os.WriteFile(scannerPath, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{
+		Host: "192.0.2.10",
+		Port: "22",
+		PortScan: &config.PortScanConf{
+			ScannerBinPath:       scannerPath,
+			HasPrivileged:        true,
+			ScanTechniques:       []string{"sS"},
+			SourcePort:           "443",
+			IsUseExternalScanner: true,
+		},
+	}}
+	got, err := l.execPortsScan(map[string][]string{
+		"192.0.2.10": {"80", "22", "22"},
+		"127.0.0.1":  {"22"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"192.0.2.10:22"}) {
+		t.Errorf("execPortsScan() = %v; want only the requested open port on the target", got)
+	}
+}
+
+func TestExecPortsScanNative(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	port := strconv.Itoa(listener.Addr().(*net.TCPAddr).Port)
+	l := &base{ServerInfo: config.ServerInfo{Host: "localhost", Port: "local", PortScan: &config.PortScanConf{}}}
+	got, err := l.execPortsScan(map[string][]string{"127.0.0.1": {port}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []string{"127.0.0.1:" + port}) {
+		t.Errorf("native execPortsScan() = %v", got)
+	}
+}
+
+func TestExecExternalPortScanReportsCommandError(t *testing.T) {
+	scannerPath := filepath.Join(t.TempDir(), "failing-nmap")
+	if err := os.WriteFile(scannerPath, []byte("#!/bin/sh\necho scan-failed >&2\nexit 9\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	l := &base{ServerInfo: config.ServerInfo{PortScan: &config.PortScanConf{
+		ScannerBinPath:       scannerPath,
+		ScanTechniques:       []string{"sT"},
+		IsUseExternalScanner: true,
+	}}}
+	_, err := l.execPortsScan(map[string][]string{"192.0.2.10": {"22"}})
+	if err == nil || !strings.Contains(err.Error(), "scan-failed") {
+		t.Errorf("execPortsScan error = %v; want scanner stderr", err)
+	}
+}
