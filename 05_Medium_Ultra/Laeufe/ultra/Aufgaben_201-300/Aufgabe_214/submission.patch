+package config
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestScanTechniqueOptions(t *testing.T) {
+	want := map[ScanTechnique]string{
+		TCPSYN:     "sS",
+		TCPConnect: "sT",
+		TCPACK:     "sA",
+		TCPWindow:  "sW",
+		TCPMaimon:  "sM",
+		TCPNull:    "sN",
+		TCPFIN:     "sF",
+		TCPXmas:    "sX",
+	}
+	for technique, option := range want {
+		if got := technique.String(); got != option {
+			t.Errorf("%v.String() = %q, want %q", technique, got, option)
+		}
+		for _, spelling := range []string{option, strings.ToLower(option), strings.ToUpper(option)} {
+			conf := PortScanConf{ScanTechniques: []string{spelling}}
+			if got := conf.GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{technique}) {
+				t.Errorf("GetScanTechniques(%q) = %v, want %v", spelling, got, technique)
+			}
+		}
+	}
+
+	if got := (&PortScanConf{}).GetScanTechniques(); len(got) != 0 {
+		t.Errorf("empty scan techniques = %v, want empty slice", got)
+	}
+	unknown := PortScanConf{ScanTechniques: []string{"bad", "unknown"}}
+	if got := unknown.GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{NotSupportTechnique}) {
+		t.Errorf("unsupported scan techniques = %v, want one NotSupportTechnique", got)
+	}
+	mixed := PortScanConf{ScanTechniques: []string{"sT", "bad"}}
+	if got := mixed.GetScanTechniques(); !reflect.DeepEqual(got, []ScanTechnique{TCPConnect, NotSupportTechnique}) {
+		t.Errorf("mixed scan techniques = %v", got)
+	}
+}
+
+func TestPortScanConfIsZero(t *testing.T) {
+	if !(PortScanConf{IsUseExternalScanner: true}).IsZero() {
+		t.Fatal("internal external scanner flag must not affect IsZero")
+	}
+	for _, conf := range []PortScanConf{
+		{ScannerBinPath: "/usr/bin/nmap"},
+		{ScanTechniques: []string{"sT"}},
+		{SourcePort: "443"},
+		{HasPrivileged: true},
+	} {
+		if conf.IsZero() {
+			t.Errorf("IsZero returned true for %+v", conf)
+		}
+	}
+}
+
+func TestPortScanConfValidate(t *testing.T) {
+	scannerPath := filepath.Join(t.TempDir(), "nmap")
+	if err := os.WriteFile(scannerPath, []byte("#!/bin/sh\nexit 0\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name string
+		conf PortScanConf
+		want string
+	}{
+		{"connect", PortScanConf{ScannerBinPath: scannerPath, ScanTechniques: []string{"sT"}}, ""},
+		{"default connect", PortScanConf{ScannerBinPath: scannerPath}, ""},
+		{"missing path", PortScanConf{ScanTechniques: []string{"sT"}}, "scannerBinPath is required"},
+		{"blank path", PortScanConf{ScannerBinPath: " ", ScanTechniques: []string{"sT"}}, "scannerBinPath is required"},
+		{"nonexistent path", PortScanConf{ScannerBinPath: filepath.Join(t.TempDir(), "missing"), ScanTechniques: []string{"sT"}}, "scannerBinPath"},
+		{"unsupported", PortScanConf{ScannerBinPath: scannerPath, ScanTechniques: []string{"sZ"}}, "unsupported"},
+		{"multiple", PortScanConf{ScannerBinPath: scannerPath, ScanTechniques: []string{"sT", "sT"}}, "multiple scan techniques"},
+		{"privilege", PortScanConf{ScannerBinPath: scannerPath, ScanTechniques: []string{"sS"}}, "requires hasPrivileged"},
+		{"connect source port", PortScanConf{ScannerBinPath: scannerPath, ScanTechniques: []string{"sT"}, SourcePort: "443"}, "cannot be used"},
+		{"default connect source port", PortScanConf{ScannerBinPath: scannerPath, SourcePort: "443"}, "cannot be used"},
+		{"zero source port", PortScanConf{ScannerBinPath: scannerPath, SourcePort: "0"}, "0 is reserved"},
+		{"negative source port", PortScanConf{ScannerBinPath: scannerPath, SourcePort: "-1"}, "integer in [0, 65535]"},
+		{"too large source port", PortScanConf{ScannerBinPath: scannerPath, SourcePort: "65536"}, "integer in [0, 65535]"},
+		{"noninteger source port", PortScanConf{ScannerBinPath: scannerPath, SourcePort: "port"}, "integer in [0, 65535]"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			errs := tt.conf.Validate()
+			if tt.want == "" {
+				if len(errs) != 0 {
+					t.Fatalf("Validate() = %v, want no errors", errs)
+				}
+				return
+			}
+			for _, err := range errs {
+				if strings.Contains(err.Error(), tt.want) {
+					return
+				}
+			}
+			t.Errorf("Validate() = %v, want error containing %q", errs, tt.want)
+		})
+	}
+}
+
+func TestPortScanValidationFollowsServerScanModule(t *testing.T) {
+	server := ServerInfo{PortScan: &PortScanConf{ScanTechniques: []string{"unsupported"}}}
+	conf := Config{Servers: map[string]ServerInfo{"example": server}}
+	if errs := conf.validatePortScans(); len(errs) != 0 {
+		t.Fatalf("port scan disabled, got validation errors: %v", errs)
+	}
+
+	server.Module.Set(Port)
+	conf.Servers["example"] = server
+	if errs := conf.validatePortScans(); len(errs) == 0 {
+		t.Fatal("port scan enabled, expected configuration errors")
+	}
+	if conf.ValidateOnScan() {
+		t.Fatal("ValidateOnScan accepted an invalid port scan configuration")
+	}
+	if conf.ValidateOnConfigtest() {
+		t.Fatal("ValidateOnConfigtest accepted an invalid port scan configuration")
+	}
+}
+
+func TestParseScannerCapabilities(t *testing.T) {
+	const path = "/tmp/nmap"
+	tests := []struct {
+		name   string
+		output string
+		want   string
+	}{
+		{"ordinary", path + " cap_net_raw,cap_net_admin=ep\n", ""},
+		{"equals prefix", path + " = cap_net_admin,cap_net_raw+eip\n", ""},
+		{"none", "", "no file capabilities"},
+		{"wrong path", "/tmp/other cap_net_raw,cap_net_admin=ep", "malformed capability data"},
+		{"missing separator", path + " cap_net_raw,cap_net_admin", "malformed capability data"},
+		{"missing capability", path + " cap_net_raw=ep", "missing cap_net_admin"},
+		{"missing effective", path + " cap_net_raw,cap_net_admin=p", "needs effective and permitted"},
+		{"bad flags", path + " cap_net_raw,cap_net_admin=ep junk", "malformed capability data"},
+		{"multiple lines", path + " cap_net_raw,cap_net_admin=ep\nother", "malformed capability data"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := parseScannerCapabilities(path, tt.output)
+			if tt.want == "" {
+				if err != nil {
+					t.Fatalf("parseScannerCapabilities() = %v, want nil", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.want) {
+				t.Errorf("parseScannerCapabilities() = %v, want error containing %q", err, tt.want)
+			}
+		})
+	}
+}
