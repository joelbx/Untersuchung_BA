+++ b/config/portscan.go
@@ -0,0 +1,195 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+)
+
+// ScanTechnique identifies an nmap TCP scan technique.
+type ScanTechnique int
+
+const (
+	// NotSupportTechnique identifies an unsupported configuration value.
+	NotSupportTechnique ScanTechnique = iota
+	TCPSYN
+	TCPConnect
+	TCPACK
+	TCPWindow
+	TCPMaimon
+	TCPNull
+	TCPFIN
+	TCPXmas
+)
+
+// String returns the nmap option for the scan technique, without its leading dash.
+func (t ScanTechnique) String() string {
+	switch t {
+	case TCPSYN:
+		return "sS"
+	case TCPConnect:
+		return "sT"
+	case TCPACK:
+		return "sA"
+	case TCPWindow:
+		return "sW"
+	case TCPMaimon:
+		return "sM"
+	case TCPNull:
+		return "sN"
+	case TCPFIN:
+		return "sF"
+	case TCPXmas:
+		return "sX"
+	default:
+		return ""
+	}
+}
+
+// PortScanConf configures nmap on the Vuls host for a server's port scan.
+type PortScanConf struct {
+	ScannerBinPath       string   `toml:"scannerBinPath,omitempty" json:"scannerBinPath,omitempty"`
+	ScanTechniques       []string `toml:"scanTechniques,omitempty" json:"scanTechniques,omitempty"`
+	HasPrivileged        bool     `toml:"hasPrivileged,omitempty" json:"hasPrivileged,omitempty"`
+	SourcePort           string   `toml:"sourcePort,omitempty" json:"sourcePort,omitempty"`
+	IsUseExternalScanner bool     `toml:"-" json:"-"`
+}
+
+// IsZero reports whether all user-configurable fields are unset.
+func (c PortScanConf) IsZero() bool {
+	return c.ScannerBinPath == "" && len(c.ScanTechniques) == 0 && c.SourcePort == "" && !c.HasPrivileged
+}
+
+// GetScanTechniques converts case-insensitive nmap options to scan techniques.
+// Unknown options appear once as NotSupportTechnique so callers can reject them.
+func (c *PortScanConf) GetScanTechniques() (scanTechniques []ScanTechnique) {
+	if c == nil || len(c.ScanTechniques) == 0 {
+		return []ScanTechnique{}
+	}
+
+	scanTechniques = make([]ScanTechnique, 0, len(c.ScanTechniques))
+	unsupported := false
+	for _, option := range c.ScanTechniques {
+		technique := NotSupportTechnique
+		for _, candidate := range []ScanTechnique{
+			TCPSYN, TCPConnect, TCPACK, TCPWindow, TCPMaimon, TCPNull, TCPFIN, TCPXmas,
+		} {
+			if strings.EqualFold(option, candidate.String()) {
+				technique = candidate
+				break
+			}
+		}
+		if technique == NotSupportTechnique {
+			if unsupported {
+				continue
+			}
+			unsupported = true
+		}
+		scanTechniques = append(scanTechniques, technique)
+	}
+	return scanTechniques
+}
+
+// Validate checks options that affect an external port scan.
+func (c PortScanConf) Validate() (errs []error) {
+	if c.IsZero() && !c.IsUseExternalScanner {
+		return nil
+	}
+
+	if strings.TrimSpace(c.ScannerBinPath) == "" {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath is required for external scanning"))
+	} else if stat, err := os.Stat(c.ScannerBinPath); err != nil {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q: %w", c.ScannerBinPath, err))
+	} else if !stat.Mode().IsRegular() || stat.Mode()&0111 == 0 {
+		errs = append(errs, fmt.Errorf("portscan.scannerBinPath %q must be an executable file", c.ScannerBinPath))
+	} else if c.HasPrivileged && os.Geteuid() != 0 {
+		if err := validateScannerCapabilities(c.ScannerBinPath); err != nil {
+			errs = append(errs, err)
+		}
+	}
+
+	if len(c.ScanTechniques) > 1 {
+		errs = append(errs, fmt.Errorf("portscan.scanTechniques: multiple scan techniques are not supported"))
+	}
+	for _, option := range c.ScanTechniques {
+		technique := (&PortScanConf{ScanTechniques: []string{option}}).GetScanTechniques()[0]
+		if technique == NotSupportTechnique {
+			errs = append(errs, fmt.Errorf("portscan.scanTechniques: %q is unsupported", option))
+			continue
+		}
+		if !c.HasPrivileged && technique != TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan.scanTechniques: %s requires hasPrivileged = true", technique.String()))
+		}
+		if c.SourcePort != "" && technique == TCPConnect {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort cannot be used with TCP connect scan"))
+		}
+	}
+
+	if c.SourcePort != "" {
+		if len(c.ScanTechniques) == 0 && !c.HasPrivileged {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort cannot be used with the default TCP connect scan"))
+		}
+		port, err := strconv.Atoi(c.SourcePort)
+		if err != nil || port < 0 || port > 65535 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort must be an integer in [0, 65535]: %q", c.SourcePort))
+		} else if port == 0 {
+			errs = append(errs, fmt.Errorf("portscan.sourcePort 0 is reserved and cannot be used"))
+		}
+	}
+
+	return errs
+}
+
+// validateScannerCapabilities checks that an unprivileged process can use the
+// packet capabilities needed by nmap's privileged scan techniques.
+func validateScannerCapabilities(path string) error {
+	output, err := exec.Command("getcap", path).Output()
+	if err != nil {
+		return fmt.Errorf("portscan.scannerBinPath %q: failed to check capabilities: %w", path, err)
+	}
+	return parseScannerCapabilities(path, string(output))
+}
+
+func parseScannerCapabilities(path, output string) error {
+	capabilities := strings.TrimSpace(string(output))
+	if capabilities == "" {
+		return fmt.Errorf("portscan.scannerBinPath %q has no file capabilities", path)
+	}
+	if strings.ContainsAny(capabilities, "\r\n") || !strings.HasPrefix(capabilities, path) {
+		return fmt.Errorf("portscan.scannerBinPath %q has malformed capability data: %q", path, capabilities)
+	}
+	capabilities = strings.TrimSpace(strings.TrimPrefix(capabilities, path))
+	capabilities = strings.TrimSpace(strings.TrimPrefix(capabilities, "="))
+	separator := strings.IndexAny(capabilities, "=+")
+	if separator <= 0 || separator == len(capabilities)-1 {
+		return fmt.Errorf("portscan.scannerBinPath %q has malformed capability data: %q", path, string(output))
+	}
+	flags := strings.TrimSpace(capabilities[separator+1:])
+	for _, flag := range flags {
+		if !strings.ContainsRune("eip", flag) {
+			return fmt.Errorf("portscan.scannerBinPath %q has malformed capability data: %q", path, output)
+		}
+	}
+	if !strings.Contains(flags, "e") || !strings.Contains(flags, "p") {
+		return fmt.Errorf("portscan.scannerBinPath %q needs effective and permitted capabilities", path)
+	}
+	configured := make(map[string]bool)
+	for _, capability := range strings.Split(capabilities[:separator], ",") {
+		name := strings.TrimSpace(capability)
+		if !strings.HasPrefix(name, "cap_") || len(name) == len("cap_") ||
+			strings.IndexFunc(name[len("cap_"):], func(r rune) bool {
+				return !(r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '_')
+			}) >= 0 {
+			return fmt.Errorf("portscan.scannerBinPath %q has malformed capability data: %q", path, string(output))
+		}
+		configured[name] = true
+	}
+	for _, required := range []string{"cap_net_raw", "cap_net_admin"} {
+		if !configured[required] {
+			return fmt.Errorf("portscan.scannerBinPath %q is missing %s capability", path, required)
+		}
+	}
+	return nil
+}
