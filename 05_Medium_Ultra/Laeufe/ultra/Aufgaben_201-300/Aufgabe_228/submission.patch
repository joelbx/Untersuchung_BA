@@ -20,12 +20,44 @@
 """Test qutebrowser.misc.earlyinit."""
 
 import sys
+import unittest.mock
 
 import pytest
+from PyQt5 import QtCore
 
 from qutebrowser.misc import earlyinit
 
 
+@pytest.mark.parametrize('runtime, compiled_qt, compiled_pyqt, valid', [
+    ('5.12.0', '5.12.0', '5.12.0', True),
+    ('5.11.9', '5.12.0', '5.12.0', False),
+    ('5.12.0', '5.11.9', '5.12.0', False),
+    ('5.12.0', '5.12.0', '5.11.9', False),
+])
+def test_check_qt_version(monkeypatch, runtime, compiled_qt, compiled_pyqt,
+                          valid):
+    """Check the minimum runtime, compiled Qt, and compiled PyQt versions."""
+    library_info = unittest.mock.Mock(
+        version=lambda: QtCore.QVersionNumber.fromString(runtime)[0])
+    monkeypatch.setattr(QtCore, 'QLibraryInfo', library_info)
+    monkeypatch.setattr(QtCore, 'QT_VERSION_STR', compiled_qt)
+    monkeypatch.setattr(QtCore, 'PYQT_VERSION_STR', compiled_pyqt)
+    reported_qt = '{} (compiled {})'.format(runtime, compiled_qt)
+    monkeypatch.setattr(earlyinit, 'qt_version', lambda: reported_qt)
+    die = unittest.mock.Mock()
+    monkeypatch.setattr(earlyinit, '_die', die)
+
+    earlyinit.check_qt_version()
+
+    if valid:
+        die.assert_not_called()
+    else:
+        die.assert_called_once()
+        message = die.call_args[0][0]
+        assert reported_qt in message
+        assert compiled_pyqt in message
+
+
