+// decodeKEVulnResponse accepts the combined response and the older CISA-only
+// array returned by previous versions of go-kev's HTTP API.
+func decodeKEVulnResponse(body string) (kevulndb.Response, error) {
+	var response kevulndb.Response
+	if err := json.Unmarshal([]byte(body), &response); err == nil {
+		return response, nil
+	}
+	var cisa []kevulnmodels.KEVuln
+	if err := json.Unmarshal([]byte(body), &cisa); err != nil {
+		return kevulndb.Response{}, err
+	}
+	return kevulndb.Response{CISA: cisa}, nil
+}
+
+func convertKEVulns(cisa []kevulnmodels.KEVuln, vulncheck []kevulnmodels.VulnCheck) []models.KEV {
+	if len(cisa)+len(vulncheck) == 0 {
+		return nil
+	}
+	kevs := make([]models.KEV, 0, len(cisa)+len(vulncheck))
+	for _, record := range cisa {
+		kevs = append(kevs, models.KEV{
+			Type:                       models.CISAKEVType,
+			VendorProject:              record.VendorProject,
+			Product:                    record.Product,
+			VulnerabilityName:          record.VulnerabilityName,
+			ShortDescription:           record.ShortDescription,
+			RequiredAction:             record.RequiredAction,
+			KnownRansomwareCampaignUse: record.KnownRansomwareCampaignUse,
+			DateAdded:                  record.DateAdded,
+			DueDate:                    validKEVDueDate(&record.DueDate),
+			CISA:                       &models.CISAKEV{Note: record.Notes},
+		})
+	}
+	for _, record := range vulncheck {
+		details := &models.VulnCheckKEV{}
+		for _, xdb := range record.VulnCheckXDB {
+			details.XDB = append(details.XDB, models.VulnCheckXDB{
+				XDBID:       xdb.XDBID,
+				XDBURL:      xdb.XDBURL,
+				DateAdded:   xdb.DateAdded,
+				ExploitType: xdb.ExploitType,
+				CloneSSHURL: xdb.CloneSSHURL,
+			})
+		}
+		for _, exploitation := range record.VulnCheckReportedExploitation {
+			details.ReportedExploitation = append(details.ReportedExploitation, models.VulnCheckReportedExploitation{
+				URL:       exploitation.URL,
+				DateAdded: exploitation.DateAdded,
+			})
+		}
+		kevs = append(kevs, models.KEV{
+			Type:                       models.VulnCheckKEVType,
+			VendorProject:              record.VendorProject,
+			Product:                    record.Product,
+			VulnerabilityName:          record.Name,
+			ShortDescription:           record.Description,
+			RequiredAction:             record.RequiredAction,
+			KnownRansomwareCampaignUse: record.KnownRansomwareCampaignUse,
+			DateAdded:                  record.DateAdded,
+			DueDate:                    validKEVDueDate(record.DueDate),
+			VulnCheck:                  details,
+		})
+	}
+	return kevs
+}
+
+func validKEVDueDate(date *time.Time) *time.Time {
+	if date == nil || date.Year() <= 1 {
+		return nil
+	}
+	dueDate := *date
+	return &dueDate
+}
