@@ -0,0 +1,145 @@
+//go:build !scanner
+// +build !scanner
+
+package detector
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/models"
+	kevulnmodels "github.com/vulsio/go-kev/models"
+)
+
+func TestDecodeKEVulnResponse(t *testing.T) {
+	tests := []struct {
+		name          string
+		body          string
+		wantCISA      string
+		wantVulnCheck string
+		wantErr       bool
+	}{
+		{
+			name:          "combined response",
+			body:          `{"cisa":[{"vulnerabilityName":"CISA entry"}],"vulncheck":[{"vulnerabilityName":"VulnCheck entry"}]}`,
+			wantCISA:      "CISA entry",
+			wantVulnCheck: "VulnCheck entry",
+		},
+		{
+			name:     "legacy CISA array",
+			body:     `[{"vulnerabilityName":"Legacy entry"}]`,
+			wantCISA: "Legacy entry",
+		},
+		{name: "malformed response", body: `{"cisa":`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := decodeKEVulnResponse(tt.body)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatal("decodeKEVulnResponse() unexpectedly succeeded")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got.CISA) != 1 || got.CISA[0].VulnerabilityName != tt.wantCISA {
+				t.Errorf("CISA entries = %#v, want one named %q", got.CISA, tt.wantCISA)
+			}
+			if tt.wantVulnCheck == "" {
+				if len(got.VulnCheck) != 0 {
+					t.Errorf("VulnCheck entries = %#v, want none", got.VulnCheck)
+				}
+			} else if len(got.VulnCheck) != 1 || got.VulnCheck[0].Name != tt.wantVulnCheck {
+				t.Errorf("VulnCheck entries = %#v, want one named %q", got.VulnCheck, tt.wantVulnCheck)
+			}
+		})
+	}
+}
+
+func TestConvertKEVulns(t *testing.T) {
+	added := time.Date(2024, 4, 1, 0, 0, 0, 0, time.UTC)
+	due := time.Date(2024, 5, 1, 0, 0, 0, 0, time.UTC)
+	xdbAdded := time.Date(2024, 4, 2, 0, 0, 0, 0, time.UTC)
+	reportedAdded := time.Date(2024, 4, 3, 0, 0, 0, 0, time.UTC)
+	placeholderDue := time.Date(1, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	got := convertKEVulns(
+		[]kevulnmodels.KEVuln{
+			{
+				VendorProject: "CISA Vendor", Product: "CISA Product", VulnerabilityName: "CISA Valid",
+				ShortDescription: "CISA description", RequiredAction: "CISA action",
+				KnownRansomwareCampaignUse: "Known", DateAdded: added, DueDate: due, Notes: "CISA note",
+			},
+			{VulnerabilityName: "CISA Placeholder", DueDate: placeholderDue},
+		},
+		[]kevulnmodels.VulnCheck{
+			{
+				VendorProject: "VulnCheck Vendor", Product: "VulnCheck Product", Name: "VulnCheck Valid",
+				Description: "VulnCheck description", RequiredAction: "VulnCheck action",
+				KnownRansomwareCampaignUse: "Unknown", DateAdded: added, DueDate: &due,
+				VulnCheckXDB: []kevulnmodels.VulnCheckXDB{{
+					XDBID: "XDB-1", XDBURL: "https://example.test/xdb/1", DateAdded: xdbAdded,
+					ExploitType: "poc", CloneSSHURL: "git@example.test:xdb/1.git",
+				}},
+				VulnCheckReportedExploitation: []kevulnmodels.VulnCheckReportedExploitation{{
+					URL: "https://example.test/report/1", DateAdded: reportedAdded,
+				}},
+			},
+			{Name: "VulnCheck Placeholder", DueDate: &placeholderDue},
+		},
+	)
+
+	want := map[string]models.KEV{
+		"cisa:CISA Valid": {
+			Type: models.CISAKEVType, VendorProject: "CISA Vendor", Product: "CISA Product",
+			VulnerabilityName: "CISA Valid", ShortDescription: "CISA description",
+			RequiredAction: "CISA action", KnownRansomwareCampaignUse: "Known",
+			DateAdded: added, DueDate: &due, CISA: &models.CISAKEV{Note: "CISA note"},
+		},
+		"cisa:CISA Placeholder": {
+			Type: models.CISAKEVType, VulnerabilityName: "CISA Placeholder",
+			CISA: &models.CISAKEV{},
+		},
+		"vulncheck:VulnCheck Valid": {
+			Type: models.VulnCheckKEVType, VendorProject: "VulnCheck Vendor", Product: "VulnCheck Product",
+			VulnerabilityName: "VulnCheck Valid", ShortDescription: "VulnCheck description",
+			RequiredAction: "VulnCheck action", KnownRansomwareCampaignUse: "Unknown",
+			DateAdded: added, DueDate: &due,
+			VulnCheck: &models.VulnCheckKEV{
+				XDB: []models.VulnCheckXDB{{
+					XDBID: "XDB-1", XDBURL: "https://example.test/xdb/1", DateAdded: xdbAdded,
+					ExploitType: "poc", CloneSSHURL: "git@example.test:xdb/1.git",
+				}},
+				ReportedExploitation: []models.VulnCheckReportedExploitation{{
+					URL: "https://example.test/report/1", DateAdded: reportedAdded,
+				}},
+			},
+		},
+		"vulncheck:VulnCheck Placeholder": {
+			Type: models.VulnCheckKEVType, VulnerabilityName: "VulnCheck Placeholder",
+			VulnCheck: &models.VulnCheckKEV{},
+		},
+	}
+
+	if len(got) != len(want) {
+		t.Fatalf("convertKEVulns returned %d entries, want %d: %#v", len(got), len(want), got)
+	}
+	for _, entry := range got {
+		key := string(entry.Type) + ":" + entry.VulnerabilityName
+		expected, ok := want[key]
+		if !ok {
+			t.Errorf("unexpected KEV %q: %#v", key, entry)
+			continue
+		}
+		if !reflect.DeepEqual(entry, expected) {
+			t.Errorf("KEV %q = %#v, want %#v", key, entry, expected)
+		}
+		delete(want, key)
+	}
+	for key := range want {
+		t.Errorf("missing KEV %q", key)
+	}
+}
