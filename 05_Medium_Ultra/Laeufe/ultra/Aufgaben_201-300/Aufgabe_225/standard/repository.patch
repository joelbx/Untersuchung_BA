@@ -0,0 +1,97 @@
+package models
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestFormatKEVCveSummary(t *testing.T) {
+	tests := []struct {
+		name string
+		cves VulnInfos
+		want string
+	}{
+		{name: "no CVEs", want: "0 KEVs"},
+		{
+			name: "counts CVEs with KEV entries, not entries or legacy alerts",
+			cves: VulnInfos{
+				"CVE-1": {KEVs: []KEV{{Type: CISAKEVType}, {Type: VulnCheckKEVType}}},
+				"CVE-2": {AlertDict: AlertDict{CISA: []Alert{{Title: "legacy"}}}},
+				"CVE-3": {KEVs: []KEV{{Type: VulnCheckKEVType}}},
+				"CVE-4": {},
+			},
+			want: "2 KEVs",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := ScanResult{ScannedCves: tt.cves}
+			if got := r.FormatKEVCveSummary(); got != tt.want {
+				t.Errorf("FormatKEVCveSummary() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestSortForJSONOutputOrdersKEVs(t *testing.T) {
+	r := ScanResult{ScannedCves: VulnInfos{
+		"CVE-1": {KEVs: []KEV{
+			{Type: VulnCheckKEVType, VulnerabilityName: "Zulu"},
+			{Type: CISAKEVType, VulnerabilityName: "Zulu"},
+			{Type: VulnCheckKEVType, VulnerabilityName: "Alpha"},
+			{Type: CISAKEVType, VulnerabilityName: "Alpha"},
+		}},
+	}}
+
+	r.SortForJSONOutput()
+	got := r.ScannedCves["CVE-1"].KEVs
+	want := []KEV{
+		{Type: CISAKEVType, VulnerabilityName: "Alpha"},
+		{Type: CISAKEVType, VulnerabilityName: "Zulu"},
+		{Type: VulnCheckKEVType, VulnerabilityName: "Alpha"},
+		{Type: VulnCheckKEVType, VulnerabilityName: "Zulu"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("sorted KEVs = %#v, want %#v", got, want)
+	}
+}
+
+func TestVulnInfoKEVsJSON(t *testing.T) {
+	vuln := VulnInfo{
+		KEVs:      []KEV{{Type: CISAKEVType, VulnerabilityName: "Example", CISA: &CISAKEV{Note: "CISA note"}}},
+		AlertDict: AlertDict{CISA: []Alert{{Title: "legacy alert"}}},
+	}
+	b, err := json.Marshal(vuln)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var body map[string]json.RawMessage
+	if err := json.Unmarshal(b, &body); err != nil {
+		t.Fatal(err)
+	}
+	var kevs []struct {
+		Type              string `json:"type"`
+		VulnerabilityName string `json:"vulnerabilityName"`
+		CISA              struct {
+			Note string `json:"note"`
+		} `json:"cisa"`
+	}
+	if err := json.Unmarshal(body["kevs"], &kevs); err != nil {
+		t.Fatalf("decode first-class kevs field: %v; JSON: %s", err, b)
+	}
+	if len(kevs) != 1 || kevs[0].Type != "cisa" || kevs[0].VulnerabilityName != "Example" || kevs[0].CISA.Note != "CISA note" {
+		t.Errorf("kevs JSON = %s", body["kevs"])
+	}
+	var alerts struct {
+		CISA []struct {
+			Title string `json:"title"`
+		} `json:"cisa"`
+	}
+	if err := json.Unmarshal(body["alertDict"], &alerts); err != nil {
+		t.Fatalf("decode legacy alertDict field: %v; JSON: %s", err, b)
+	}
+	if len(alerts.CISA) != 1 || alerts.CISA[0].Title != "legacy alert" {
+		t.Errorf("alertDict JSON = %s", body["alertDict"])
+	}
+}
