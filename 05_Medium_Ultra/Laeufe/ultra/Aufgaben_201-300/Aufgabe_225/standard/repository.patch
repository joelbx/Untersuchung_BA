--- /dev/null
+++ b/reporter/kev_test.go
@@ -0,0 +1,32 @@
+package reporter
+
+import (
+	"encoding/csv"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestCSVListShowsKEVSeparatelyFromAlerts(t *testing.T) {
+	r := models.ScanResult{ScannedCves: models.VulnInfos{
+		"CVE-1": {CveID: "CVE-1", KEVs: []models.KEV{{Type: models.CISAKEVType}}},
+	}}
+	path := filepath.Join(t.TempDir(), "result.csv")
+	if err := formatCsvList(r, path); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	rows, err := csv.NewReader(f).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 2 || rows[0][4] != "KEV" || rows[1][4] != "KEV" || rows[1][5] != "" {
+		t.Fatalf("unexpected KEV and CERT columns: %v", rows)
+	}
+}
