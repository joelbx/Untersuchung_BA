+package scanner
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/navidrome/navidrome/model"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("album image files", func() {
+	It("joins every image from distinct media directories in path order", func() {
+		firstDir := filepath.Join("music", "disc1")
+		secondDir := filepath.Join("music", "disc2")
+		files := model.MediaFiles{
+			{Path: filepath.Join(secondDir, "song2.mp3")},
+			{Path: filepath.Join(firstDir, "song1.mp3")},
+			{Path: filepath.Join(firstDir, "song3.mp3")},
+		}
+		dirs := dirMap{
+			firstDir:  {ImageFiles: []string{"back.png", "cover.jpg"}},
+			secondDir: {ImageFiles: []string{"front.webp"}},
+		}
+
+		want := strings.Join([]string{
+			filepath.Join(firstDir, "back.png"),
+			filepath.Join(firstDir, "cover.jpg"),
+			filepath.Join(secondDir, "front.webp"),
+		}, string(filepath.ListSeparator))
+		Expect(imageFilesForAlbum(files, dirs)).To(Equal(want))
+	})
+})
