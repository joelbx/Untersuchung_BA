+    path, cadata, paths_checked = urls.get_ca_certs(str(cafile))
+
+    assert path == str(cafile)
+    assert cadata == bytearray()
+    assert paths_checked == [str(cafile)]
+
+
+def test_ssl_validation_handler_uses_ciphers(mocker):
+    ciphers = ['ECDHE-RSA-AES128-SHA256']
+    handler = urls.maybe_add_ssl_handler('https://ansible.com/', True, ciphers=ciphers)
+    make_context_mock = mocker.patch.object(urls, 'make_context')
+
+    handler.make_context(None, None)
+
+    make_context_mock.assert_called_once_with(cafile=None, cadata=None, ciphers=ciphers, validate_certs=True)
+
+
+@pytest.mark.skipif(not urls.HAS_SSLCONTEXT, reason='requires SSLContext')
+@pytest.mark.parametrize('ciphers', [
+    ['ECDHE-RSA-AES128-SHA256', 'ECDHE-RSA-AES256-GCM-SHA384'],
+    'ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-GCM-SHA384',
+])
+def test_make_context_ciphers(ciphers):
+    context = urls.make_context(ciphers=ciphers)
+    names = [cipher['name'] for cipher in context.get_ciphers()]
+
+    assert names.index('ECDHE-RSA-AES128-SHA256') < names.index('ECDHE-RSA-AES256-GCM-SHA384')
+
+
+@pytest.mark.parametrize('ciphers', [
+    42,
+    [42],
+    [],
+    'sensitive-invalid-cipher',
+])
+def test_make_context_rejects_invalid_ciphers(ciphers):
+    with pytest.raises(ValueError) as excinfo:
+        urls.make_context(ciphers=ciphers)
+
+    assert 'cipher' in str(excinfo.value).lower()
+    assert 'sensitive-invalid-cipher' not in str(excinfo.value)
+
+
+@pytest.mark.skipif(not urls.HAS_SSLCONTEXT, reason='requires SSLContext')
+def test_make_context_without_certificate_validation():
+    context = urls.make_context(validate_certs=False, ciphers='ECDHE-RSA-AES128-SHA256')
+
+    assert context.verify_mode == urls.ssl.CERT_NONE
+    assert context.check_hostname is False
+    assert context.options & urls.ssl.OP_NO_SSLv3
+    if urls.ssl.OP_NO_SSLv2:
+        assert context.options & urls.ssl.OP_NO_SSLv2
+
+
