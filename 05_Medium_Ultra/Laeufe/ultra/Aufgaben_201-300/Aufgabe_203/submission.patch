+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React from "react";
+import classNames from "classnames";
+
+import { _t } from "../../../languageHandler";
+
+let nextDescriptionId = 0;
+
+/** An external link with a visible icon and an accessible new-tab cue. */
+export default function ExternalLink({
+    children,
+    className,
+    target = "_blank",
+    rel = "noreferrer noopener",
+    "aria-label": ariaLabel,
+    "aria-labelledby": ariaLabelledBy,
+    "aria-describedby": ariaDescribedBy,
+    ...props
+}: React.AnchorHTMLAttributes<HTMLAnchorElement>): JSX.Element {
+    const [descriptionId] = React.useState(() => `mx_ExternalLink_newTab_${++nextDescriptionId}`);
+    const opensNewTab = target === "_blank";
+    const hasExplicitName = Boolean(ariaLabel || ariaLabelledBy);
+    const describedBy = opensNewTab && hasExplicitName
+        ? [ariaDescribedBy, descriptionId].filter(Boolean).join(" ")
+        : ariaDescribedBy;
+
+    return <a
+        {...props}
+        className={classNames("mx_ExternalLink", className)}
+        target={target}
+        rel={rel}
+        aria-label={ariaLabel}
+        aria-labelledby={ariaLabelledBy}
+        aria-describedby={describedBy}
+    >
+        { children }
+        { opensNewTab && <>
+            <span className="mx_ExternalLink_icon" aria-hidden="true" />
+            <span className="mx_ExternalLink_newTab" id={descriptionId}> { _t("Opens in a new tab") }</span>
+        </> }
+    </a>;
+}
