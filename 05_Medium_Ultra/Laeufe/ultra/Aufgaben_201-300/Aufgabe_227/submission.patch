+@pytest.mark.parametrize("runtime_version, expected", [
+    ("6.2.2", set()),
+    ("6.2.3", {".jpg", ".jpe"}),
+    ("6.6.9", {".jpg", ".jpe"}),
+    ("6.7.0", set()),
+])
+def test_suffixes_workaround_runtime_bounds(
+    suffix_mocks, monkeypatch, runtime_version, expected
+):
+    runtime = tuple(map(int, runtime_version.split(".")))
+
+    def version(string, *, compiled):
+        assert compiled is False
+        return runtime >= tuple(map(int, string.split(".")))
+
+    monkeypatch.setattr(qtutils, "version_check", version)
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == expected
+
+
+@pytest.mark.parametrize("runtime, compiled_qt, compiled_pyqt, expected", [
+    ("6.2.3", "6.2.2", "6.2.3", {".jpg"}),
+    ("6.2.3", "6.2.3", "6.2.2", {".jpg"}),
+    ("6.6.9", "6.7.0", "6.7.0", {".jpg"}),
+    ("6.7.0", "6.6.9", "6.6.9", set()),
+])
+def test_suffixes_workaround_ignores_compiled_versions(
+    monkeypatch, runtime, compiled_qt, compiled_pyqt, expected
+):
+    monkeypatch.setattr(qtutils, "qVersion", lambda: runtime)
+    monkeypatch.setattr(qtutils, "QT_VERSION_STR", compiled_qt)
+    monkeypatch.setattr(qtutils, "PYQT_VERSION_STR", compiled_pyqt)
+    monkeypatch.setattr(mimetypes, "guess_all_extensions", lambda mime: [".jpg"])
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == expected
+
+
+def test_suffixes_workaround_only_returns_extensions(suffix_mocks, monkeypatch):
+    monkeypatch.setattr(mimetypes, "guess_all_extensions",
+                        lambda mime: ["jpg", ".jpg"])
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == {".jpg"}
+
+
