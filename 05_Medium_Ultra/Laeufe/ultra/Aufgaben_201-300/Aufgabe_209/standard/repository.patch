diff --git a/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
new file mode 100644
index 0000000..324b642
--- /dev/null
+++ b/packages/components/containers/calendar/subscribeCalendarModal/SubscribeCalendarModal.spec.tsx
@@ -0,0 +1,106 @@
+import React from 'react';
+import { fireEvent, render, screen } from '@testing-library/react';
+
+import { MAX_LENGTHS_API } from '@proton/shared/lib/calendar/constants';
+
+import useGetCalendarActions from '../hooks/useGetCalendarActions';
+import useGetCalendarSetup from '../hooks/useGetCalendarSetup';
+import SubscribeCalendarModal from './SubscribeCalendarModal';
+
+jest.mock('../hooks/useGetCalendarSetup', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ error: false, loading: false })),
+}));
+jest.mock('../hooks/useGetCalendarActions', () => ({
+    __esModule: true,
+    default: jest.fn(() => ({ handleCreateCalendar: jest.fn() })),
+}));
+
+const mockedUseGetCalendarSetup = useGetCalendarSetup as jest.Mock;
+const mockedUseGetCalendarActions = useGetCalendarActions as jest.Mock;
+const handleCreateCalendar = jest.fn();
+
+const getURLInput = () => screen.getByLabelText(/Calendar URL/) as HTMLInputElement;
+const getSubmitButton = () => screen.getByText('Add calendar', { selector: 'button' });
+
+const enterURL = (value: string) => fireEvent.change(getURLInput(), { target: { value } });
+
+describe('SubscribeCalendarModal', () => {
+    beforeEach(() => {
+        mockedUseGetCalendarSetup.mockReturnValue({ error: false, loading: false });
+        mockedUseGetCalendarActions.mockReturnValue({ handleCreateCalendar });
+        handleCreateCalendar.mockClear();
+    });
+
+    it('enables submission only for a non-empty, valid URL and trims input changes', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        expect(getSubmitButton()).toBeDisabled();
+
+        enterURL('invalid URL');
+        expect(getSubmitButton()).toBeDisabled();
+
+        enterURL('  https://example.com/calendar.ics  ');
+        expect(getURLInput()).toHaveValue('https://example.com/calendar.ics');
+        expect(getSubmitButton()).toBeEnabled();
+
+        enterURL('   ');
+        expect(getURLInput()).toHaveValue('');
+        expect(getSubmitButton()).toBeDisabled();
+    });
+
+    it('allows a URL at the API length limit and warns and blocks one character beyond it', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        const prefix = 'https://example.com/';
+        const atLimit = prefix + 'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL - prefix.length);
+        enterURL(atLimit);
+        expect(getURLInput()).toHaveValue(atLimit);
+        expect(getSubmitButton()).toBeEnabled();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+
+        enterURL(`${atLimit}a`);
+        expect(getURLInput()).toHaveValue(`${atLimit}a`);
+        expect(getSubmitButton()).toBeDisabled();
+        expect(screen.getByText('URL is too long')).toBeInTheDocument();
+        expect(getURLInput()).not.toHaveAttribute('maxLength');
+
+        fireEvent.click(getSubmitButton());
+        fireEvent.submit(getSubmitButton().closest('form')!);
+        expect(handleCreateCalendar).not.toHaveBeenCalled();
+    });
+
+    it('prioritizes missing .ics warnings over public Google and length warnings', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        enterURL(`https://calendar.google.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}/public/test`);
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(screen.queryByText(/By using this link/)).not.toBeInTheDocument();
+
+        enterURL('https://outlook.live.com/calendar/test');
+        expect(screen.getByText('This link might be wrong')).toBeInTheDocument();
+    });
+
+    it('prioritizes the Google public warning over the length warning', () => {
+        render(<SubscribeCalendarModal isOpen />);
+
+        enterURL(`https://calendar.google.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}/public/test.ics`);
+        expect(
+            screen.getByText('By using this link, Google will make the calendar you are subscribing to public')
+        ).toBeInTheDocument();
+        expect(screen.queryByText('URL is too long')).not.toBeInTheDocument();
+        expect(screen.queryByText('This link might be wrong')).not.toBeInTheDocument();
+        expect(getSubmitButton()).toBeDisabled();
+    });
+
+    it('uses the same disabled state for the error flow', () => {
+        const { rerender } = render(<SubscribeCalendarModal isOpen />);
+
+        enterURL(`https://example.com/${'a'.repeat(MAX_LENGTHS_API.CALENDAR_URL)}`);
+        mockedUseGetCalendarSetup.mockReturnValue({ error: true, loading: false });
+        rerender(<SubscribeCalendarModal isOpen />);
+
+        expect(screen.getByText('Close', { selector: 'button' })).toBeDisabled();
+    });
+});
