 const Topics = module.exports;
+const postingLocks = new Set();
+
+Topics.lockPosting = (req, error) => {
+	if (!(req.uid > 0) && !req.sessionID) {
+		throw new Error('[[error:invalid-data]]');
+	}
+	const key = req.uid > 0 ? `postinguid:${req.uid}` : `postingsession:${req.sessionID}`;
+	if (postingLocks.has(key)) {
+		throw new Error(error);
+	}
+	postingLocks.add(key);
+	return key;
+};
 
