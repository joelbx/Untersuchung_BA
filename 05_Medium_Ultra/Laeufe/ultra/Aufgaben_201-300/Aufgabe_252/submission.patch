+def get_sysctl_uptime(module):
+    try:
+        sysctl_cmd = module.get_bin_path('sysctl')
+        if not sysctl_cmd:
+            raise ValueError('Unable to find sysctl')
+        rc, out, err = module.run_command([sysctl_cmd, '-n', 'kern.boottime'])
+    except (IOError, OSError) as e:
+        if (getattr(e, 'errno', None) == errno.ENOENT or
+                'no such file or directory' in str(e).lower()):
+            raise ValueError('Unable to execute sysctl: %s' % e)
+        module.warn('Unable to read sysctl: %s' % e)
+        return {}
+
+    if rc != 0:
+        module.warn('Unable to read sysctl: %s' % (err.strip() or 'exit status %s' % rc))
+        return {}
+
+    boot_time_text = out.strip()
+    if not re.match(r'^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$', boot_time_text):
+        return {}
+    boot_time = float(boot_time_text)
+    if math.isnan(boot_time) or math.isinf(boot_time):
+        return {}
+
+    return {'uptime_seconds': int(time.time() - boot_time)}
diff --git a/test/units/module_utils/facts/hardware/test_bsd_get_uptime_facts.py b/test/units/module_utils/facts/hardware/test_bsd_get_uptime_facts.py
