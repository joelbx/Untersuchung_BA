@@ -0,0 +1,48 @@
+import { combine } from '@proton/shared/lib/contacts/helpers/csvFormat';
+import { serialize } from '@proton/shared/lib/contacts/vcard';
+import { PreVcardProperty } from '@proton/shared/lib/interfaces/contacts/Import';
+import { VCardContact } from '@proton/shared/lib/interfaces/contacts/VCard';
+
+const dateProperty = (field: 'bday' | 'anniversary', value: string): PreVcardProperty => ({
+    header: field,
+    checked: true,
+    field,
+    value,
+});
+
+describe('CSV date fields', () => {
+    it('converts common text dates and preserves their calendar values in vCard', () => {
+        const cases = [
+            { text: '2014-02-11T11:30:30', date: new Date(2014, 1, 11, 11, 30, 30), vcardDate: '20140211' },
+            { text: 'Jun 9, 2022', date: new Date(2022, 5, 9), vcardDate: '20220609' },
+            { text: '03/12/1969', date: new Date(1969, 2, 12), vcardDate: '19690312' },
+            { text: '2023/12/3', date: new Date(2023, 11, 3), vcardDate: '20231203' },
+        ];
+
+        cases.forEach(({ text, date, vcardDate }) => {
+            const value = combine.bday([dateProperty('bday', text)]);
+            expect(value).toEqual({ date });
+
+            const contact: VCardContact = {
+                fn: [{ field: 'fn', value: 'Example', uid: 'fn' }],
+                bday: { field: 'bday', value, uid: 'bday' },
+            };
+            expect(serialize(contact)).toContain(`BDAY:${vcardDate}`);
+        });
+    });
+
+    it('uses the same date conversion for anniversaries', () => {
+        const value = combine.anniversary([dateProperty('anniversary', '2023/12/3')]);
+        expect(value).toEqual({ date: new Date(2023, 11, 3) });
+
+        const contact: VCardContact = {
+            fn: [{ field: 'fn', value: 'Example', uid: 'fn' }],
+            anniversary: { field: 'anniversary', value, uid: 'anniversary' },
+        };
+        expect(serialize(contact)).toContain('ANNIVERSARY:20231203');
+    });
+
+    it('leaves the date unset when text cannot be parsed', () => {
+        expect(combine.bday([dateProperty('bday', 'not a date')])).toEqual({ text: 'not a date' });
+    });
+});
