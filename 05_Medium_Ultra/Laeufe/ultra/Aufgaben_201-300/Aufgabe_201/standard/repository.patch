+		{name: "multiple keys with default version", segment: "\n      keys: [foo, bar]\n      operator: OR_SEGMENT_OPERATOR", valid: true},
+		{name: "single key with ignored operator", segment: "\n      keys: [foo]\n      operator: UNKNOWN_SEGMENT_OPERATOR", valid: true},
+		{name: "single key with nonstring operator", segment: "\n      keys: [foo]\n      operator: 42", valid: true},
