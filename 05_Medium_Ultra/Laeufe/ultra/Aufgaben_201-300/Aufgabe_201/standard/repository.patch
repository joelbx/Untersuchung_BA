+		{name: "number", segment: "42", valid: false},
+		{name: "empty keys", segment: "\n      keys: []\n      operator: OR_SEGMENT_OPERATOR", valid: false},
+		{name: "missing keys", segment: "\n      operator: OR_SEGMENT_OPERATOR", valid: false},
+		{name: "missing operator with one key", segment: "\n      keys: [foo]", valid: false},
+		{name: "missing operator", segment: "\n      keys: [foo, bar]", valid: false},
+		{name: "invalid operator with multiple keys", segment: "\n      keys: [foo, bar]\n      operator: UNKNOWN_SEGMENT_OPERATOR", valid: false},
+		{name: "nonstring key", segment: "\n      keys: [foo, 42]\n      operator: AND_SEGMENT_OPERATOR", valid: false},
+		{name: "unknown field", segment: "\n      keys: [foo, bar]\n      operator: AND_SEGMENT_OPERATOR\n      extra: true", valid: false},
