+			wantOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR,
+		},
+		{
+			name:         "one key object uses OR",
+			segment:      "{keys: [segment1], operator: AND_SEGMENT_OPERATOR}",
+			wantKey:      "segment1",
+			wantOperator: flipt.SegmentOperator_OR_SEGMENT_OPERATOR,
+		},
+		{
+			name:         "two key object uses AND",
+			segment:      "{keys: [segment1, segment2], operator: AND_SEGMENT_OPERATOR}",
+			wantKeys:     []string{"segment1", "segment2"},
+			wantOperator: flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+		},
+		{
+			name:      "missing segment",
+			wantError: "must have a segment",
+		},
+		{
+			name:      "null rule",
+			doc:       "flags:\n  - key: flag1\n    rules:\n      - null\n",
+			wantError: "must have a segment",
+		},
+		{
+			name:      "unknown operator for multiple keys",
+			segment:   "{keys: [segment1, segment2], operator: UNKNOWN}",
+			wantError: "unsupported operator",
+		},
+	}
+
