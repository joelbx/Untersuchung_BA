+package ext
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v2"
+	yamlv3 "gopkg.in/yaml.v3"
+)
+
+func TestRuleSegmentUnmarshalYAML(t *testing.T) {
+	tests := []struct {
+		name    string
+		input   string
+		segment IsSegment
+		wantErr bool
+	}{
+		{name: "string", input: "segment: foo\n", segment: SegmentKey("foo")},
+		{name: "object", input: "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n", segment: Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}},
+		{name: "single key object uses shorthand", input: "segment:\n  keys: [foo]\n  operator: AND_SEGMENT_OPERATOR\n", segment: SegmentKey("foo")},
+		{name: "single key ignores operator", input: "segment:\n  keys: [foo]\n  operator: invalid\n", segment: SegmentKey("foo")},
+		{name: "single key without operator", input: "segment:\n  keys: [foo]\n", wantErr: true},
+		{name: "empty string", input: "segment: ''\n", wantErr: true},
+		{name: "number", input: "segment: 42\n", wantErr: true},
+		{name: "list", input: "segment: [foo]\n", wantErr: true},
+		{name: "empty object", input: "segment: {}\n", wantErr: true},
+		{name: "empty keys", input: "segment:\n  keys: []\n  operator: AND_SEGMENT_OPERATOR\n", wantErr: true},
+		{name: "missing operator", input: "segment:\n  keys: [foo, bar]\n", wantErr: true},
+		{name: "invalid operator", input: "segment:\n  keys: [foo, bar]\n  operator: invalid\n", wantErr: true},
+		{name: "invalid key", input: "segment:\n  keys: [foo, 42]\n  operator: AND_SEGMENT_OPERATOR\n", wantErr: true},
+		{name: "unknown field", input: "segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n  extra: true\n", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var rule Rule
+			err := yaml.Unmarshal([]byte(tt.input), &rule)
+			if tt.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.NotNil(t, rule.Segment)
+			require.Equal(t, tt.segment, rule.Segment.IsSegment)
+		})
+	}
+}
+
+func TestRuleSegmentUnmarshalYAMLv3(t *testing.T) {
+	var rule Rule
+	err := yamlv3.Unmarshal([]byte("segment:\n  keys: [foo, bar]\n  operator: AND_SEGMENT_OPERATOR\n"), &rule)
+	require.NoError(t, err)
+	require.Equal(t, Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}, rule.Segment.IsSegment)
+}
+
+func TestRuleSegmentMarshalYAML(t *testing.T) {
+	tests := []struct {
+		name    string
+		segment IsSegment
+		want    string
+		wantErr bool
+	}{
+		{name: "string", segment: SegmentKey("foo"), want: "segment: foo\n"},
+		{name: "object", segment: Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}, want: "segment:\n  keys:\n  - foo\n  - bar\n  operator: AND_SEGMENT_OPERATOR\n"},
+		{name: "single key fallback", segment: Segments{Keys: []string{"foo"}, SegmentOperator: "AND_SEGMENT_OPERATOR"}, want: "segment:\n  keys:\n  - foo\n  operator: OR_SEGMENT_OPERATOR\n"},
+		{name: "empty", wantErr: true},
+		{name: "invalid operator", segment: Segments{Keys: []string{"foo", "bar"}, SegmentOperator: "invalid"}, wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			out, err := yaml.Marshal(&Rule{Segment: &SegmentEmbed{IsSegment: tt.segment}})
+			if tt.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.want, string(out))
+		})
+	}
+}
