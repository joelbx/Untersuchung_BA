index 591ea9c..ff2e05d 100644
--- a/internal/ext/common.go
+++ b/internal/ext/common.go
@@ -1,5 +1,7 @@
 package ext
 
+import "fmt"
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -26,11 +28,168 @@ type Variant struct {
 }
 
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *SegmentEmbed   `yaml:"segment,omitempty"`
+	Rank          uint            `yaml:"rank,omitempty"`
+	Distributions []*Distribution `yaml:"distributions,omitempty"`
+}
+
+// IsSegment is implemented by both supported rule segment representations.
+type IsSegment interface {
+	isSegment()
+}
+
+// SegmentKey is the shorthand form of a rule segment.
+type SegmentKey string
+
+func (SegmentKey) isSegment() {}
+
+// Segments is the object form of a rule segment.
+type Segments struct {
+	Keys            []string `yaml:"keys"`
+	SegmentOperator string   `yaml:"operator"`
+}
+
+func (Segments) isSegment() {}
+
+// SegmentEmbed allows a rule's segment to be either a key or a group of keys.
+type SegmentEmbed struct {
+	IsSegment
+}
+
+// MarshalYAML preserves the representation held by SegmentEmbed.
+func (s *SegmentEmbed) MarshalYAML() (interface{}, error) {
+	if s == nil {
+		return nil, fmt.Errorf("invalid segment: missing value")
+	}
+
+	switch segment := s.IsSegment.(type) {
+	case SegmentKey:
+		if segment == "" {
+			return nil, fmt.Errorf("invalid segment: empty key")
+		}
+		return string(segment), nil
+	case *SegmentKey:
+		if segment == nil || *segment == "" {
+			return nil, fmt.Errorf("invalid segment: empty key")
+		}
+		return string(*segment), nil
+	case Segments:
+		if len(segment.Keys) == 1 {
+			segment.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		if err := validateSegments(segment); err != nil {
+			return nil, err
+		}
+		return segment, nil
+	case *Segments:
+		if segment == nil {
+			return nil, fmt.Errorf("invalid segment: missing value")
+		}
+		value := *segment
+		if len(value.Keys) == 1 {
+			value.SegmentOperator = "OR_SEGMENT_OPERATOR"
+		}
+		if err := validateSegments(value); err != nil {
+			return nil, err
+		}
+		return value, nil
+	default:
+		return nil, fmt.Errorf("invalid segment: unsupported value %T", s.IsSegment)
+	}
+}
+
+// UnmarshalYAML accepts a key or an object with keys and an operator.
+func (s *SegmentEmbed) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw interface{}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+
+	switch value := raw.(type) {
+	case string:
+		if value == "" {
+			return fmt.Errorf("invalid segment: empty key")
+		}
+		s.IsSegment = SegmentKey(value)
+		return nil
+	case map[interface{}]interface{}:
+		fields := make(map[string]interface{}, len(value))
+		for key, field := range value {
+			name, ok := key.(string)
+			if !ok {
+				return fmt.Errorf("invalid segment: unsupported field %v", key)
+			}
+			fields[name] = field
+		}
+		return s.unmarshalSegmentMap(fields)
+	case map[string]interface{}:
+		return s.unmarshalSegmentMap(value)
+	default:
+		return fmt.Errorf("invalid segment: expected a key or keys and operator, got %T", raw)
+	}
+}
+
+func (s *SegmentEmbed) unmarshalSegmentMap(fields map[string]interface{}) error {
+	var segment Segments
+	var hasKeys, hasOperator bool
+	var operatorValue interface{}
+	for key, field := range fields {
+		switch key {
+		case "keys":
+			hasKeys = true
+			keys, ok := field.([]interface{})
+			if !ok {
+				return fmt.Errorf("invalid segment: keys must be a list of strings")
+			}
+			for _, key := range keys {
+				name, ok := key.(string)
+				if !ok || name == "" {
+					return fmt.Errorf("invalid segment: keys must be nonempty strings")
+				}
+				segment.Keys = append(segment.Keys, name)
+			}
+		case "operator":
+			hasOperator = true
+			operatorValue = field
+		default:
+			return fmt.Errorf("invalid segment: unsupported field %v", key)
+		}
+	}
+	if !hasKeys || len(segment.Keys) == 0 {
+		return fmt.Errorf("invalid segment: keys must be a nonempty list")
+	}
+	if !hasOperator {
+		return fmt.Errorf("invalid segment: missing operator")
+	}
+	if len(segment.Keys) == 1 {
+		s.IsSegment = SegmentKey(segment.Keys[0])
+		return nil
+	}
+	operator, ok := operatorValue.(string)
+	if !ok {
+		return fmt.Errorf("invalid segment: operator must be a string")
+	}
+	segment.SegmentOperator = operator
+	if err := validateSegments(segment); err != nil {
+		return err
+	}
+	s.IsSegment = segment
+	return nil
+}
+
+func validateSegments(segment Segments) error {
+	if len(segment.Keys) == 0 {
+		return fmt.Errorf("invalid segment: keys must be a nonempty list")
+	}
+	for _, key := range segment.Keys {
+		if key == "" {
+			return fmt.Errorf("invalid segment: keys must be nonempty strings")
+		}
+	}
+	if segment.SegmentOperator != "AND_SEGMENT_OPERATOR" && segment.SegmentOperator != "OR_SEGMENT_OPERATOR" {
+		return fmt.Errorf("invalid segment: unsupported operator %q", segment.SegmentOperator)
+	}
+	return nil
 }
 
