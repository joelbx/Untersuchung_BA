+func snapshotRuleSegment(segment *ext.SegmentEmbed) ([]string, flipt.SegmentOperator, error) {
+	if segment == nil {
+		return nil, 0, fmt.Errorf("segment is required")
+	}
+
+	switch value := segment.IsSegment.(type) {
+	case ext.SegmentKey:
+		return snapshotSingleSegment(string(value))
+	case *ext.SegmentKey:
+		if value != nil {
+			return snapshotSingleSegment(string(*value))
+		}
+	case ext.Segments:
+		operator, err := snapshotSegmentOperator(value.Keys, value.SegmentOperator)
+		return value.Keys, operator, err
+	case *ext.Segments:
+		if value != nil {
+			operator, err := snapshotSegmentOperator(value.Keys, value.SegmentOperator)
+			return value.Keys, operator, err
+		}
+	}
+
+	return nil, 0, fmt.Errorf("invalid segment format %T", segment.IsSegment)
+}
+
+func snapshotSingleSegment(key string) ([]string, flipt.SegmentOperator, error) {
+	if key == "" {
+		return nil, 0, fmt.Errorf("segment key is required")
+	}
+
+	return []string{key}, flipt.SegmentOperator_OR_SEGMENT_OPERATOR, nil
+}
+
+func snapshotSegmentOperator(keys []string, operator string) (flipt.SegmentOperator, error) {
+	if len(keys) == 0 {
+		return 0, fmt.Errorf("at least one segment key is required")
+	}
+
+	for _, key := range keys {
+		if key == "" {
+			return 0, fmt.Errorf("segment key is required")
+		}
+	}
+
+	if len(keys) == 1 {
+		return flipt.SegmentOperator_OR_SEGMENT_OPERATOR, nil
+	}
+
+	switch operator {
+	case "OR_SEGMENT_OPERATOR":
+		return flipt.SegmentOperator_OR_SEGMENT_OPERATOR, nil
+	case "AND_SEGMENT_OPERATOR":
+		return flipt.SegmentOperator_AND_SEGMENT_OPERATOR, nil
+	}
+
+	return 0, fmt.Errorf("invalid segment operator %q", operator)
+}
+
 func (ss storeSnapshot) String() string {
 	return "snapshot"
 }
