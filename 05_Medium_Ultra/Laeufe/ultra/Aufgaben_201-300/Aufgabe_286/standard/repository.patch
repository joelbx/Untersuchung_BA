diff --git a/internal/release/check.go b/internal/release/check.go
new file mode 100644
index 0000000..39fc4fb
--- /dev/null
+++ b/internal/release/check.go
@@ -0,0 +1,65 @@
+package release
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/blang/semver/v4"
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+)
+
+// Info describes the running version and the latest published release.
+type Info struct {
+	CurrentVersion   string
+	LatestVersion    string
+	UpdateAvailable  bool
+	LatestVersionURL string
+}
+
+// Is reports whether version identifies a proper release build.
+func Is(version string) bool {
+	v, err := semver.ParseTolerant(version)
+	return err == nil && len(v.Pre) == 0
+}
+
+// Check compares version with the latest published Flipt release.
+func Check(ctx context.Context, version string) (Info, error) {
+	info, err := check(ctx, version, func(ctx context.Context) (*github.RepositoryRelease, error) {
+		client := github.NewClient(nil)
+		release, _, err := client.Repositories.GetLatestRelease(ctx, "flipt-io", "flipt")
+		return release, err
+	})
+	if err != nil {
+		zap.L().Warn("checking for updates", zap.Error(err))
+	}
+	return info, err
+}
+
+func check(ctx context.Context, version string, latestRelease func(context.Context) (*github.RepositoryRelease, error)) (Info, error) {
+	info := Info{CurrentVersion: version}
+
+	current, err := semver.ParseTolerant(version)
+	if err != nil {
+		return info, fmt.Errorf("parsing current version: %w", err)
+	}
+	info.CurrentVersion = current.String()
+
+	release, err := latestRelease(ctx)
+	if err != nil {
+		return info, fmt.Errorf("getting latest release: %w", err)
+	}
+	if release == nil {
+		return info, fmt.Errorf("getting latest release: empty response")
+	}
+
+	latest, err := semver.ParseTolerant(release.GetTagName())
+	if err != nil {
+		return info, fmt.Errorf("parsing latest version: %w", err)
+	}
+
+	info.LatestVersion = latest.String()
+	info.LatestVersionURL = release.GetHTMLURL()
+	info.UpdateAvailable = current.Compare(latest) < 0
+	return info, nil
+}
diff --git a/internal/release/check_test.go b/internal/release/check_test.go
new file mode 100644
index 0000000..9679164
--- /dev/null
+++ b/internal/release/check_test.go
@@ -0,0 +1,106 @@
+package release
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+
+	"github.com/google/go-github/v32/github"
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestIs(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"", false},
+		{"dev", false},
+		{"1.2.3-dev", false},
+		{"1.2.3-snapshot", false},
+		{"1.2.3-rc", false},
+		{"1.2.3-rc.1", false},
+		{"v1.2.3-rc", false},
+		{"v1.2.3-rc.1", false},
+		{"v1.2.3-dev.1", false},
+		{"v1.2.3-snapshot.1", false},
+		{"1.2.3-beta.1", false},
+		{"1.2.3", true},
+		{"v1.2.3", true},
+		{"1.2.3+build.1", true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			if got := Is(tt.version); got != tt.want {
+				t.Errorf("Is(%q) = %t, want %t", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name           string
+		currentVersion string
+		latestVersion  string
+		wantUpdate     bool
+	}{
+		{"update available", "1.2.3", "v1.3.0", true},
+		{"running latest", "1.3.0", "v1.3.0", false},
+		{"running newer", "1.4.0", "v1.3.0", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			const url = "https://example.com/releases/latest"
+			tag := tt.latestVersion
+			info, err := check(context.Background(), tt.currentVersion, func(context.Context) (*github.RepositoryRelease, error) {
+				return &github.RepositoryRelease{TagName: &tag, HTMLURL: github.String(url)}, nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := Info{
+				CurrentVersion:   tt.currentVersion,
+				LatestVersion:    "1.3.0",
+				LatestVersionURL: url,
+				UpdateAvailable:  tt.wantUpdate,
+			}
+			if !reflect.DeepEqual(info, want) {
+				t.Errorf("check() = %#v, want %#v", info, want)
+			}
+		})
+	}
+}
+
+func TestCheckFailurePreservesCurrentVersion(t *testing.T) {
+	wantErr := errors.New("unavailable")
+	info, err := check(context.Background(), "v1.2.3", func(context.Context) (*github.RepositoryRelease, error) {
+		return nil, wantErr
+	})
+	if !errors.Is(err, wantErr) {
+		t.Fatalf("check() error = %v, want %v", err, wantErr)
+	}
+	if info.CurrentVersion != "1.2.3" || info.LatestVersion != "" || info.UpdateAvailable {
+		t.Errorf("check() = %#v, want current version only", info)
+	}
+}
+
+func TestCheckLogsWarningWithError(t *testing.T) {
+	core, logs := observer.New(zap.WarnLevel)
+	restore := zap.ReplaceGlobals(zap.New(core))
+	defer restore()
+
+	_, err := Check(context.Background(), "invalid-version")
+	if err == nil {
+		t.Fatal("Check() succeeded for an invalid version")
+	}
+
+	entries := logs.FilterMessage("checking for updates").All()
+	if len(entries) != 1 || entries[0].Level != zap.WarnLevel || entries[0].ContextMap()["error"] == nil {
+		t.Errorf("Check() logs = %#v, want warning with error", logs.All())
+	}
+}
