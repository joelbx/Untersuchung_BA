+func TestLoadAuthenticationRequiredFields(t *testing.T) {
+	fields := []struct {
+		name  string
+		value string
+	}{
+		{name: "client_id", value: "test-id"},
+		{name: "client_secret", value: "test-secret"},
+		{name: "redirect_address", value: "http://localhost/callback"},
+	}
+
+	for _, method := range []struct {
+		name     string
+		provider string
+	}{
+		{name: "github", provider: "github"},
+		{name: "oidc", provider: "foo"},
+		{name: "oidc", provider: "Foo-BAR"},
+	} {
+		for _, requiredField := range fields {
+			for _, form := range []struct {
+				name    string
+				present bool
+			}{
+				{name: "missing"},
+				{name: "empty", present: true},
+			} {
+				t.Run(fmt.Sprintf("%s/%s/%s/%s", method.name, method.provider, requiredField.name, form.name), func(t *testing.T) {
+					var config strings.Builder
+					config.WriteString("authentication:\n  session:\n    domain: localhost\n  methods:\n")
+					indent := "      "
+					if method.name == "github" {
+						config.WriteString("    github:\n      enabled: true\n")
+					} else {
+						fmt.Fprintf(&config, "    oidc:\n      enabled: true\n      providers:\n        %s:\n", method.provider)
+						indent = "          "
+					}
+					for _, field := range fields {
+						if field.name == requiredField.name && !form.present {
+							continue
+						}
+						value := field.value
+						if field.name == requiredField.name {
+							value = `""`
+						}
+						fmt.Fprintf(&config, "%s%s: %s\n", indent, field.name, value)
+					}
+
+					path := filepath.Join(t.TempDir(), "config.yml")
+					require.NoError(t, os.WriteFile(path, []byte(config.String()), 0600))
+					_, err := Load(path)
+					require.EqualError(t, err, fmt.Sprintf("provider %q: field %q: non-empty value is required", method.provider, requiredField.name))
+				})
+			}
+		}
+	}
+}
