diff --git a/internal/config/oidc_provider_names.go b/internal/config/oidc_provider_names.go
new file mode 100644
index 0000000..183c38e
--- /dev/null
+++ b/internal/config/oidc_provider_names.go
@@ -0,0 +1,73 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// preserveOIDCProviderNames restores the spelling of provider keys from YAML.
+// Viper lowercases map keys during unmarshalling, including provider names used
+// in authentication URLs and validation errors.
+func preserveOIDCProviderNames(path string, cfg *Config) error {
+	if !cfg.Authentication.Methods.OIDC.Enabled {
+		return nil
+	}
+
+	switch strings.ToLower(filepath.Ext(path)) {
+	case ".yaml", ".yml":
+	default:
+		return nil
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("reading OIDC provider names: %w", err)
+	}
+
+	var raw struct {
+		Authentication struct {
+			Methods struct {
+				OIDC struct {
+					Providers map[string]any `yaml:"providers"`
+				} `yaml:"oidc"`
+			} `yaml:"methods"`
+		} `yaml:"authentication"`
+	}
+	if err := yaml.Unmarshal(data, &raw); err != nil {
+		return fmt.Errorf("reading OIDC provider names: %w", err)
+	}
+
+	names := make([]string, 0, len(raw.Authentication.Methods.OIDC.Providers))
+	for name := range raw.Authentication.Methods.OIDC.Providers {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+
+	seen := make(map[string]string, len(names))
+	for _, name := range names {
+		normalized := strings.ToLower(name)
+		if previous, ok := seen[normalized]; ok {
+			return fmt.Errorf("OIDC provider keys %q and %q conflict when case is ignored", previous, name)
+		}
+		seen[normalized] = name
+	}
+
+	providers := cfg.Authentication.Methods.OIDC.Method.Providers
+	if providers == nil && len(names) > 0 {
+		providers = make(map[string]AuthenticationMethodOIDCProvider, len(names))
+		cfg.Authentication.Methods.OIDC.Method.Providers = providers
+	}
+	for _, name := range names {
+		normalized := strings.ToLower(name)
+		provider := providers[normalized]
+		delete(providers, normalized)
+		providers[name] = provider
+	}
+
+	return nil
+}
