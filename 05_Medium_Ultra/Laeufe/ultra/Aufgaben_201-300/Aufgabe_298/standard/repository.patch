+func (c *simpleCache[K, V]) Values() []V {
+	c.evictExpired()
+	items := c.data.Items()
+	values := make([]V, 0, len(items))
+	for _, item := range items {
+		values = append(values, item.Value())
+	}
+	return values
+}
+
+// scheduleEviction keeps the earliest known expiration as the next sweep time.
+func (c *simpleCache[K, V]) scheduleEviction(expiresAt time.Time) {
+	if expiresAt.IsZero() {
+		return
+	}
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline != nil && !expiresAt.Before(*deadline) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(deadline, &expiresAt) {
+			return
+		}
+	}
+}
+
+// evictExpired sweeps only when an item could have reached its TTL. The
+// deadline is claimed before sweeping so concurrent callers do not all scan
+// the cache. New items can still move the deadline earlier during a sweep.
+func (c *simpleCache[K, V]) evictExpired() {
+	for {
+		deadline := c.evictionDeadline.Load()
+		if deadline == nil || time.Now().Before(*deadline) {
+			return
+		}
+		if c.evictionDeadline.CompareAndSwap(deadline, nil) {
+			break
+		}
+	}
+
+	c.data.DeleteExpired()
+	for _, item := range c.data.Items() {
+		c.scheduleEviction(item.ExpiresAt())
+	}
+	// An item can expire while Items is building its active snapshot.
+	c.data.DeleteExpired()
 }
