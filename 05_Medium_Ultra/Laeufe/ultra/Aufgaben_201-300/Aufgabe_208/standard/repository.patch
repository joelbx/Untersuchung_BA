+
+describe('email confirmation lifecycle', () => {
+	const email = 'pending@example.org';
+	const expiryMs = 2 * 24 * 60 * 60 * 1000;
+	const intervalMs = 10 * 60 * 1000;
+	let uid;
+	let nextUser = 0;
+	let previousConfig;
+
+	before(() => {
+		previousConfig = {
+			emailConfirmExpiry: meta.config.emailConfirmExpiry,
+			emailConfirmInterval: meta.config.emailConfirmInterval,
+			sendValidationEmail: meta.config.sendValidationEmail,
+		};
+		meta.config.emailConfirmExpiry = 2;
+		meta.config.emailConfirmInterval = 10;
+		meta.config.sendValidationEmail = 1;
+		plugins.hooks.register('email-confirmation-lifecycle-test', {
+			hook: 'filter:email.send',
+			method: async () => {},
+		});
+	});
+
+	after(() => {
+		plugins.hooks.unregister('email-confirmation-lifecycle-test', 'filter:email.send');
+		Object.assign(meta.config, previousConfig);
+	});
+
+	beforeEach(async () => {
+		nextUser += 1;
+		uid = await user.create({ username: `email-lifecycle-${nextUser}`, password: '123456' });
+	});
+
+	it('returns strict pending booleans and null expiry without a confirmation', async () => {
+		assert.strictEqual(await user.email.isValidationPending(uid), false);
+		assert.strictEqual(await user.email.isValidationPending(uid, email), false);
+		assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+	});
+
+	it('reports the live remaining confirmation lifetime in milliseconds', async () => {
+		await user.email.sendValidationEmail(uid, { email });
+		assert.strictEqual(await user.email.isValidationPending(uid), true);
+		assert.strictEqual(await user.email.isValidationPending(uid, email), true);
+		assert.strictEqual(await user.email.isValidationPending(uid, email.toUpperCase()), true);
+		assert.strictEqual(await user.email.isValidationPending(uid, 'other@example.org'), false);
+
+		const originalTtl = await user.email.getValidationExpiry(uid);
+		const code = await db.get(`confirm:byUid:${uid}`);
+		const recordTtl = await db.pttl(`confirm:${code}`);
+		assert(Number.isFinite(originalTtl));
+		assert(originalTtl > 0 && originalTtl <= expiryMs);
+		assert(recordTtl > 0 && recordTtl <= expiryMs);
+		await db.pexpireAt(`confirm:byUid:${uid}`, Date.now() + 30000);
+		const reducedTtl = await user.email.getValidationExpiry(uid);
+		assert(reducedTtl > 0 && reducedTtl <= 30000);
+		assert(reducedTtl < originalTtl - 1000);
+	});
+
+	it('clears both confirmation keys and permits an immediate resend after expiry', async () => {
+		const oldCode = await user.email.sendValidationEmail(uid, { email });
+		await user.email.expireValidation(uid);
+
+		assert.strictEqual(await db.get(`confirm:byUid:${uid}`), null);
+		assert.strictEqual(await db.getObject(`confirm:${oldCode}`), null);
+		assert.strictEqual(await user.email.isValidationPending(uid), false);
+		assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+
+		const newCode = await user.email.sendValidationEmail(uid, { email });
+		assert.notStrictEqual(newCode, oldCode);
+		assert.strictEqual(await user.email.isValidationPending(uid, email), true);
+	});
+
+	it('blocks resend for the interval and replaces the old confirmation afterward', async () => {
+		const oldCode = await user.email.sendValidationEmail(uid, { email });
+		assert.strictEqual(await user.email.canSendValidation(uid, email), false);
+		await assert.rejects(
+			user.email.sendValidationEmail(uid, { email }),
+			/\[\[error:confirm-email-already-sent/
+		);
+
+		await db.pexpireAt(`confirm:byUid:${uid}`, Date.now() + expiryMs - intervalMs + 5000);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), false);
+		await db.pexpireAt(`confirm:byUid:${uid}`, Date.now() + expiryMs - intervalMs - 5000);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+
+		const newCode = await user.email.sendValidationEmail(uid, { email });
+		assert.notStrictEqual(newCode, oldCode);
+		assert.strictEqual(await db.getObject(`confirm:${oldCode}`), null);
+		assert.strictEqual(await user.email.isValidationPending(uid, email), true);
+	});
+
+	it('rejects an old link after its pending marker expires', async () => {
+		const code = await user.email.sendValidationEmail(uid, { email });
+		await db.pexpireAt(`confirm:byUid:${uid}`, Date.now() - 1);
+
+		assert.strictEqual(await user.email.isValidationPending(uid), false);
+		assert.strictEqual(await user.email.getValidationExpiry(uid), null);
+		assert.strictEqual(await user.email.canSendValidation(uid, email), true);
+		await assert.rejects(user.email.confirmByCode(code), /\[\[error:invalid-data\]\]/);
+	});
+});
