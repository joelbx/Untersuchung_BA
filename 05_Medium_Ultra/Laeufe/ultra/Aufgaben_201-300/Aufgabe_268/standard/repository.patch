+@pytest.mark.parametrize('error, error_type', [
+    (QProcess.FailedToStart, 'failed to start'),
+    (QProcess.Crashed, 'crashed'),
+    (QProcess.Timedout, 'timed out'),
+    (QProcess.WriteError, 'write error'),
+    (QProcess.ReadError, 'read error'),
+])
+def test_error_messages(fake_proc, message_mock, monkeypatch, caplog,
+                        error, error_type):
+    """Show the command, error type, and process error detail."""
+    monkeypatch.setattr(utils, 'is_windows', False)
+    fake_proc.start('my-command', [])
+    fake_proc._proc.errorString.return_value = 'some detail'
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_error(error)
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == "Testprocess 'my-command' {}: some detail".format(
+        error_type)
+
+
+@pytest.mark.parametrize('detail, windows, hint', [
+    ('No such file or directory', False, True),
+    ('Permission denied', False, True),
+    ('Other error', False, False),
+    ('No such file or directory', True, False),
+])
+def test_error_hint(fake_proc, message_mock, monkeypatch, caplog,
+                    detail, windows, hint):
+    """Hint about the command only for relevant non-Windows start errors."""
+    monkeypatch.setattr(utils, 'is_windows', windows)
+    fake_proc.start('my-command', [])
+    fake_proc._proc.errorString.return_value = detail
+
+    with caplog.at_level(logging.ERROR):
+        fake_proc._on_error(QProcess.FailedToStart)
+
+    expected = "Testprocess 'my-command' failed to start: {}".format(detail)
+    if hint:
+        expected += (" (Hint: Make sure 'my-command' exists and is "
+                     "executable)")
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == expected
 
 
