+@pytest.mark.parametrize(
+    'fields,error',
+    [
+        ({'publish_date': '1499'}, PublicationYearTooOld),
+        ({'publish_date': '3000'}, PublishedInFutureYear),
+        ({'publishers': ['Independently Published']}, IndependentlyPublished),
+        ({'source_records': ['amazon:123']}, SourceNeedsISBN),
+    ],
+)
+def test_validate_record_override_validation(fields, error):
+    rec = {'title': 'Test book', 'source_records': ['test:123'], **fields}
+
+    with pytest.raises(error):
+        validate_record(rec)
+    with pytest.raises(error):
+        validate_record(rec, override_validation=False)
+
+    validate_record(rec, override_validation=True)
+
+
+@pytest.mark.parametrize('missing_field', ['title', 'source_records'])
+def test_validate_record_override_still_requires_fields(missing_field):
+    rec = {'title': 'Test book', 'source_records': ['test:123']}
+    rec.pop(missing_field)
+
+    with pytest.raises(RequiredField):
+        validate_record(rec, override_validation=True)
+
+
+def test_load_forwards_validation_override(mock_site):
+    rec = {'title': 'Test book', 'source_records': ['amazon:123']}
+
+    with pytest.raises(SourceNeedsISBN):
+        load(deepcopy(rec))
+
+    reply = load(deepcopy(rec), override_validation=True)
+    assert reply['success'] is True
+    assert mock_site.get(reply['edition']['key']).source_records == ['amazon:123']
