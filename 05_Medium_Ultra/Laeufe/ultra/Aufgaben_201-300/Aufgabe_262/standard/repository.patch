+def test_process_cover_url(edition, allowed_hosts, expected_cover, expected_edition):
+    cover_url, updated_edition = process_cover_url(edition, allowed_hosts)
+
+    assert cover_url == expected_cover
+    assert updated_edition is edition
+    assert updated_edition == expected_edition
+    assert edition == expected_edition
+
+
+def test_process_cover_url_uses_allowed_hosts_by_default():
+    allowed_host = next(iter(ALLOWED_COVER_HOSTS))
+    cover_url = f'https://{allowed_host}/image.jpg'
+    edition = {'title': 'Default hosts', 'cover': cover_url}
+
+    assert process_cover_url(edition) == (cover_url, {'title': 'Default hosts'})
