+import { act, renderHook } from '@testing-library/react';
+
+import metrics from '@proton/metrics';
+import { resumeSession } from '@proton/shared/lib/authentication/persistedSessionHelper';
+import { srpAuth } from '@proton/shared/lib/srp';
+import { formatUser } from '@proton/shared/lib/user/helpers';
+
+import usePublicSession, { PublicSessionProvider } from './usePublicSession';
+
+const mockApi = jest.fn();
+const mockAuth = {
+    setPassword: jest.fn(),
+    setUID: jest.fn(),
+    setLocalID: jest.fn(),
+};
+
+jest.mock('@proton/components', () => ({
+    useApi: () => mockApi,
+    useAuthentication: () => mockAuth,
+}));
+jest.mock('@proton/metrics', () => ({
+    __esModule: true,
+    default: { setAuthHeaders: jest.fn() },
+}));
+jest.mock('@proton/shared/lib/authentication/persistedSessionHelper', () => ({
+    resumeSession: jest.fn(),
+}));
+jest.mock('@proton/shared/lib/srp', () => ({
+    srpAuth: jest.fn(),
+}));
+jest.mock('@proton/shared/lib/user/helpers', () => ({
+    formatUser: jest.fn(),
+}));
+jest.mock('../_shares', () => ({
+    hasCustomPassword: jest.fn(),
+    hasGeneratedPasswordIncluded: jest.fn(),
+    isLegacySharedUrl: jest.fn(),
+}));
+jest.mock('./useDebouncedRequest', () => ({
+    __esModule: true,
+    default: () => jest.fn(),
+}));
+
+const handshakeInfo = {
+    Flags: 0,
+    Modulus: 'modulus',
+    ServerEphemeral: 'server-ephemeral',
+    UrlPasswordSalt: 'salt',
+    SRPSession: 'srp-session',
+    Version: 4,
+};
+
+describe('usePublicSession', () => {
+    beforeEach(() => {
+        localStorage.clear();
+        jest.clearAllMocks();
+        mockApi.mockResolvedValue(handshakeInfo);
+        jest.mocked(resumeSession).mockResolvedValue({
+            UID: 'new-uid',
+            LocalID: 2,
+            keyPassword: 'key-password',
+            User: { ID: 'new-user' },
+        } as any);
+        jest.mocked(formatUser).mockReturnValue({ ID: 'new-user', Name: 'Newest user' } as any);
+        jest.mocked(srpAuth).mockResolvedValue({
+            json: async () => ({ AccessToken: 'access-token', UID: 'public-uid' }),
+        } as any);
+    });
+
+    it('resumes the newest persisted session and uses its UID for public authentication', async () => {
+        localStorage.setItem('ps-1', JSON.stringify({ UID: 'old-uid', UserID: 'old-user', persistedAt: 100 }));
+        localStorage.setItem('ps-2', JSON.stringify({ UID: 'new-uid', UserID: 'new-user', persistedAt: 200 }));
+        const { result } = renderHook(() => usePublicSession(), { wrapper: PublicSessionProvider });
+
+        await act(async () => {
+            await result.current.initHandshake('token');
+        });
+
+        expect(metrics.setAuthHeaders).toHaveBeenCalledWith('new-uid');
+        expect(resumeSession).toHaveBeenCalledWith({ api: mockApi, localID: 2 });
+        expect(mockAuth.setPassword).toHaveBeenCalledWith('key-password');
+        expect(mockAuth.setUID).toHaveBeenCalledWith('new-uid');
+        expect(mockAuth.setLocalID).toHaveBeenCalledWith(2);
+        expect(result.current.user).toEqual({ ID: 'new-user', Name: 'Newest user' });
+
+        await act(async () => {
+            await result.current.initSession('token', 'password', handshakeInfo as any);
+        });
+
+        expect(srpAuth).toHaveBeenCalledWith(
+            expect.objectContaining({
+                config: expect.objectContaining({ headers: { 'x-pm-uid': 'new-uid' } }),
+            })
+        );
+    });
+
+    it('continues the public handshake when no persisted session exists', async () => {
+        const { result } = renderHook(() => usePublicSession(), { wrapper: PublicSessionProvider });
+
+        await act(async () => {
+            await result.current.initHandshake('token');
+        });
+
+        expect(resumeSession).not.toHaveBeenCalled();
+        expect(metrics.setAuthHeaders).not.toHaveBeenCalled();
+        expect(mockApi).toHaveBeenCalledTimes(1);
+        expect(result.current.user).toBeUndefined();
+    });
+});
