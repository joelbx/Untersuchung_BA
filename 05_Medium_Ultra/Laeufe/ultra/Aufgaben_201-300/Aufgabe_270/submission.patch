+import { renderHook } from '@testing-library/react';
+
+import { usePublicSessionUser } from './usePublicSessionUser';
+
+let mockLocalID: number | undefined;
+const mockUser = { ID: 'resumed-user' };
+
+jest.mock('@proton/components', () => ({
+    useAuthentication: () => ({ getLocalID: () => mockLocalID }),
+}));
+jest.mock('../_api', () => ({
+    usePublicSession: () => ({ user: mockUser }),
+}));
+
+describe('usePublicSessionUser', () => {
+    afterEach(() => {
+        localStorage.clear();
+    });
+
+    it('returns the authenticated local ID after a session resumes', () => {
+        localStorage.setItem('ps-5', JSON.stringify({ UID: 'stale-uid', persistedAt: 100 }));
+        mockLocalID = undefined;
+
+        const { result, rerender } = renderHook(() => usePublicSessionUser());
+        expect(result.current).toEqual({ user: mockUser, localID: undefined });
+
+        mockLocalID = 42;
+        rerender();
+        expect(result.current).toEqual({ user: mockUser, localID: 42 });
+    });
+});
