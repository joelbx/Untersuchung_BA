+func TestNewRuleSegments(t *testing.T) {
+	tests := []struct {
+		name         string
+		segmentKey   string
+		segmentKeys  []string
+		operator     flipt.SegmentOperator
+		wantKey      string
+		wantOperator string
+	}{
+		{
+			name:       "legacy single segment",
+			segmentKey: "legacy",
+			wantKey:    "legacy",
+		},
+		{
+			name:        "single segment in list",
+			segmentKey:  "legacy",
+			segmentKeys: []string{"first"},
+			wantKey:     "first",
+		},
+		{
+			name:         "multiple segments",
+			segmentKey:   "legacy",
+			segmentKeys:  []string{"first", "second"},
+			operator:     flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+			wantKey:      "first,second",
+			wantOperator: "AND_SEGMENT_OPERATOR",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rule := NewRule(&flipt.Rule{
+				SegmentKey:      tt.segmentKey,
+				SegmentKeys:     tt.segmentKeys,
+				SegmentOperator: tt.operator,
+			})
+			assert.Equal(t, tt.wantKey, rule.SegmentKey)
+			assert.Equal(t, tt.wantOperator, rule.SegmentOperator)
+		})
+	}
+}
+
+func TestNewRolloutSegments(t *testing.T) {
+	tests := []struct {
+		name         string
+		segmentKey   string
+		segmentKeys  []string
+		operator     flipt.SegmentOperator
+		wantKey      string
+		wantOperator string
+	}{
+		{
+			name:       "legacy single segment",
+			segmentKey: "legacy",
+			wantKey:    "legacy",
+		},
+		{
+			name:        "single segment in list",
+			segmentKey:  "legacy",
+			segmentKeys: []string{"first"},
+			wantKey:     "first",
+		},
+		{
+			name:         "multiple segments",
+			segmentKey:   "legacy",
+			segmentKeys:  []string{"first", "second"},
+			operator:     flipt.SegmentOperator_AND_SEGMENT_OPERATOR,
+			wantKey:      "first,second",
+			wantOperator: "AND_SEGMENT_OPERATOR",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rollout := NewRollout(&flipt.Rollout{
+				Rule: &flipt.Rollout_Segment{Segment: &flipt.RolloutSegment{
+					SegmentKey:      tt.segmentKey,
+					SegmentKeys:     tt.segmentKeys,
+					SegmentOperator: tt.operator,
+					Value:           true,
+				}},
+			})
+			require.NotNil(t, rollout.Segment)
+			assert.Equal(t, tt.wantKey, rollout.Segment.Key)
+			assert.Equal(t, tt.wantOperator, rollout.Segment.Operator)
+			assert.True(t, rollout.Segment.Value)
+		})
+	}
+}
+
+func TestSegmentOperatorJSONOmitEmpty(t *testing.T) {
+	tests := []struct {
+		name    string
+		payload any
+		field   string
+	}{
+		{"rule", &Rule{}, "segment_operator"},
+		{"rollout segment", &RolloutSegment{}, "operator"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			data, err := json.Marshal(tt.payload)
+			require.NoError(t, err)
+
+			var fields map[string]any
+			require.NoError(t, json.Unmarshal(data, &fields))
+			assert.NotContains(t, fields, tt.field)
+		})
+	}
+
+	for _, tt := range []struct {
+		name    string
+		payload any
+		field   string
+	}{
+		{"rule", &Rule{SegmentOperator: "AND_SEGMENT_OPERATOR"}, "segment_operator"},
+		{"rollout segment", &RolloutSegment{Operator: "AND_SEGMENT_OPERATOR"}, "operator"},
+	} {
+		t.Run(tt.name+" populated", func(t *testing.T) {
+			data, err := json.Marshal(tt.payload)
+			require.NoError(t, err)
+
+			var fields map[string]any
+			require.NoError(t, json.Unmarshal(data, &fields))
+			assert.Equal(t, "AND_SEGMENT_OPERATOR", fields[tt.field])
+		})
+	}
+}
