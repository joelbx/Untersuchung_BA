+// sqliteDSN applies the connection settings to every configured database path,
+// including custom paths that already have other SQLite query parameters.
+func sqliteDSN(path string) string {
+	name, query, _ := strings.Cut(path, "?")
+	params, err := url.ParseQuery(query)
+	if err != nil {
+		panic(fmt.Errorf("invalid SQLite database path %q: %w", path, err))
+	}
+	for key, value := range map[string]string{
+		"cache":         "shared",
+		"_cache_size":   "1000000000",
+		"_busy_timeout": "5000",
+		"_journal_mode": "WAL",
+		"_synchronous":  "NORMAL",
+		"_foreign_keys": "on",
+		"_txlock":       "immediate",
+	} {
+		params.Set(key, value)
+	}
+	return name + "?" + params.Encode()
+}
+
 func Close() error {
 	log.Info("Closing Database")
 	return Db().Close()
