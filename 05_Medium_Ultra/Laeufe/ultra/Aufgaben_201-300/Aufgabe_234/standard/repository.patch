@@ -2,6 +2,9 @@ package db
 
 import (
 	"database/sql"
+	"net/url"
+	"path/filepath"
+	"strings"
 	"testing"
 
 	"github.com/navidrome/navidrome/log"
@@ -10,6 +13,63 @@ import (
 	. "github.com/onsi/gomega"
 )
 
+func TestSQLiteDSN(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "test.db")
+	dsn := sqliteDSN(path + "?mode=rwc&cache=private&_busy_timeout=15000")
+	name, query, found := strings.Cut(dsn, "?")
+	if !found || name != path {
+		t.Fatalf("unexpected SQLite database path: %q", dsn)
+	}
+	params, err := url.ParseQuery(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]string{
+		"mode":          "rwc",
+		"cache":         "shared",
+		"_cache_size":   "1000000000",
+		"_busy_timeout": "5000",
+		"_journal_mode": "WAL",
+		"_synchronous":  "NORMAL",
+		"_foreign_keys": "on",
+		"_txlock":       "immediate",
+	} {
+		if got := params.Get(key); got != want {
+			t.Errorf("SQLite parameter %s = %q, want %q", key, got, want)
+		}
+	}
+
+	conn, err := sql.Open(Driver, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for _, check := range []struct {
+		pragma string
+		want   int
+	}{
+		{"cache_size", 1000000000},
+		{"busy_timeout", 5000},
+		{"synchronous", 1},
+		{"foreign_keys", 1},
+	} {
+		var got int
+		if err := conn.QueryRow("PRAGMA " + check.pragma).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != check.want {
+			t.Errorf("PRAGMA %s = %d, want %d", check.pragma, got, check.want)
+		}
+	}
+	var journalMode string
+	if err := conn.QueryRow("PRAGMA journal_mode").Scan(&journalMode); err != nil {
+		t.Fatal(err)
+	}
+	if journalMode != "wal" {
+		t.Errorf("PRAGMA journal_mode = %q, want wal", journalMode)
+	}
+}
+
