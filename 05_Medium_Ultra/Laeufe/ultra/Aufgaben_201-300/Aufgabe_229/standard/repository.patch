+		if (typeof url !== 'string') {
+			return false;
+		}
+		const localUrl = url.startsWith('/assets/uploads/profile/') ? `${nconf.get('relative_path') || ''}${url}` : url;
+		if (!localUrl.startsWith(prefix)) {
+			return false;
+		}
+		const filename = localUrl.slice(prefix.length);
+		if (!filename || path.basename(filename) !== filename || !isProfileImageFilename(filename, uid, type)) {
+			return false;
+		}
+		const folder = profileFolder();
+		const localPath = path.resolve(folder, filename);
+		return path.dirname(localPath) === folder ? localPath : false;
+	}
