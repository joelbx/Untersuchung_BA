+		const extensions = User.getAllowedProfileImageExtensions();
+		if (!extensions.includes(parsed.ext.slice(1).toLowerCase())) {
+			return false;
+		}
+		const prefix = `${uid}-profile${type}`;
+		return parsed.name === prefix ||
+			(parsed.name.startsWith(prefix) && /^-\d+$/.test(parsed.name.slice(prefix.length)));
+	}
+
+	function getLocalProfilePath(url, uid, type) {
