+func TestNewWithClient_ConfigFromEnvironment(t *testing.T) {
+	require.Equal(t, "KUBE_NAMESPACE", NamespaceEnv)
+	require.Equal(t, "RELEASE_NAME", ReleaseNameEnv)
+	t.Setenv(NamespaceEnv, "test")
+	t.Setenv("TELEPORT_REPLICA_NAME", "agent-0")
+	t.Setenv(ReleaseNameEnv, "teleport")
+
+	client := fake.NewSimpleClientset()
+	b, err := NewWithClient(client)
+	require.NoError(t, err)
+	require.Equal(t, "test", b.Namespace)
+	require.Equal(t, "agent-0", b.ReplicaName)
+	require.Equal(t, "agent-0-state", b.SecretName)
+	require.Equal(t, "teleport", b.ReleaseName)
+	require.Same(t, client, b.KubeClient)
+	require.Equal(t, map[string]string{
+		"meta.helm.sh/release-name":      "teleport",
+		"meta.helm.sh/release-namespace": "test",
+		"helm.sh/resource-policy":        "keep",
+	}, b.genSecretObject().Annotations)
+}
