+                                    cli_args, config_args):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        config_stub.val.scrolling.bar = 'never'
+        config_stub.val.qt.args = config_args
+
+        args = qtargs.qt_args(parser.parse_args(cli_args))
+
+        assert not any(arg == '--enable-features' or
+                       arg.startswith('--enable-features=') for arg in args)
+
+    def test_enable_features_qt_arg(self, config_stub, monkeypatch, parser):
