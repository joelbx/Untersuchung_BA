+    @pytest.mark.parametrize('bar, new_qt, is_mac, overlay', [
+        ('overlay', True, False, True),
+        ('overlay', False, False, False),
+        ('overlay', True, True, False),
+        ('never', True, False, False),
+    ])
+    def test_enable_features_combined(self, config_stub, monkeypatch, parser,
+                                      bar, new_qt, is_mac, overlay):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.qtutils, 'version_check',
+                            lambda version, exact=False, compiled=True:
+                            new_qt)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', is_mac)
+        config_stub.val.scrolling.bar = bar
+        config_stub.val.qt.args = [
+            'enable-features=ConfigOne,ConfigTwo',
+            'enable-features=ConfigThree',
+        ]
+        parsed = parser.parse_args([
+            '--qt-flag', 'enable-features=CliOne,CliTwo',
+            '--qt-flag', 'enable-features=CliThree',
+        ])
+
+        args = qtargs.qt_args(parsed)
+        features = [arg for arg in args
+                    if arg.startswith('--enable-features=')]
+        expected = ['CliOne', 'CliTwo', 'CliThree',
+                    'ConfigOne', 'ConfigTwo', 'ConfigThree']
+        if overlay:
+            expected.append('OverlayScrollbar')
+
+        assert features == ['--enable-features=' + ','.join(expected)]
+
+    @pytest.mark.parametrize('cli_args, config_args', [
+        ([], []),
+        (['--qt-flag', 'enable-features='], ['enable-features=']),
+        (['--qt-flag', 'enable-features'], []),
+    ])
