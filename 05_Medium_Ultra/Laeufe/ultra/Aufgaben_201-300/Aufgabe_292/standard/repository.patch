diff --git a/internal/storage/fs/poll_test.go b/internal/storage/fs/poll_test.go
new file mode 100644
index 0000000..3824cf2
--- /dev/null
+++ b/internal/storage/fs/poll_test.go
@@ -0,0 +1,89 @@
+package fs
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+func TestPollerCloseWithoutPolling(t *testing.T) {
+	p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+		t.Fatal("update called after close")
+		return false, nil
+	}, WithInterval(time.Millisecond))
+
+	require.NoError(t, p.Close())
+	p.Poll()
+	require.NoError(t, p.Close())
+	require.False(t, p.started)
+}
+
+func TestPollerCloseImmediatelyAfterPoll(t *testing.T) {
+	for i := 0; i < 32; i++ {
+		p := NewPoller(context.Background(), zap.NewNop(), func(context.Context) (bool, error) {
+			t.Fatal("update called after close")
+			return false, nil
+		}, WithInterval(time.Hour))
+
+		p.Poll()
+		require.NoError(t, p.Close())
+		require.ErrorIs(t, p.ctx.Err(), context.Canceled)
+	}
+}
+
+func TestPollerCloseWaitsForUpdate(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	finished := make(chan struct{})
+	var releaseOnce sync.Once
+
+	p := NewPoller(context.Background(), zap.NewNop(), func(ctx context.Context) (bool, error) {
+		close(started)
+		<-ctx.Done()
+		<-release
+		close(finished)
+		return false, nil
+	}, WithInterval(time.Millisecond))
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(release) })
+		require.NoError(t, p.Close())
+	})
+
+	p.Poll()
+	p.Poll() // Starting the same poller again must not start another update loop.
+	select {
+	case <-started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("polling did not start")
+	}
+
+	closed := make(chan error, 1)
+	go func() { closed <- p.Close() }()
+	select {
+	case <-p.ctx.Done():
+	case <-time.After(2 * time.Second):
+		t.Fatal("close did not cancel the update context")
+	}
+	select {
+	case <-closed:
+		t.Fatal("close returned while update was still running")
+	default:
+	}
+
+	releaseOnce.Do(func() { close(release) })
+	select {
+	case <-finished:
+	case <-time.After(2 * time.Second):
+		t.Fatal("update did not finish")
+	}
+	select {
+	case err := <-closed:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("close did not wait for polling to terminate")
+	}
+}
