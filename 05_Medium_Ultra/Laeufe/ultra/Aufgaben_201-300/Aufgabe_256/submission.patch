+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load(dict(hosts=hosts))
+            self.assertEqual(str(error.exception), "Hosts list contains an invalid host value: '%s'" % bad_host)
+
+    def test_explicit_name_does_not_skip_hosts_validation(self):
