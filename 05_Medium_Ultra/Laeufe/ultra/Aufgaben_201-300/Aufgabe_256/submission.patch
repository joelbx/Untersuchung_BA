+    def test_play_without_hosts_does_not_validate_hosts(self):
+        p = Play.load(dict(name='play without hosts'))
+        self.assertEqual(p.get_name(), 'play without hosts')
+
+    def test_play_name_is_derived_without_changing_input(self):
+        play_data = dict(hosts=['first', 'second'])
+
+        p = Play.load(play_data)
+
+        self.assertEqual(play_data, dict(hosts=['first', 'second']))
+        self.assertEqual(p.name, '')
+        self.assertEqual(p.get_name(), 'first,second')
+        p.hosts = ['third', 'fourth']
+        self.assertEqual(p.get_name(), 'third,fourth')
+
+    def test_play_name_from_other_hosts_types(self):
+        self.assertEqual(Play.load(dict(hosts=('first', 'second'))).get_name(), 'first,second')
+        self.assertEqual(Play.load(dict(hosts=['first', b'second'])).get_name(), 'first,second')
+        self.assertEqual(Play.load(dict(hosts='first')).get_name(), 'first')
+        self.assertEqual(Play.load(dict(hosts=b'first')).get_name(), b'first')
+
+    def test_explicit_play_name_takes_precedence_over_hosts(self):
+        p = Play.load(dict(name='given name', hosts=['first', 'second']))
+        self.assertEqual(p.get_name(), 'given name')
+        p.hosts = ['third']
+        self.assertEqual(p.get_name(), 'given name')
+
+    def test_empty_hosts_raise_parser_error(self):
+        message = 'Hosts list cannot be empty. Please check your playbook'
+        for hosts in (None, [], (), ''):
+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load(dict(hosts=hosts))
+            self.assertEqual(str(error.exception), message, repr(hosts))
+
+    def test_none_in_hosts_sequence_raises_parser_error(self):
+        message = "Hosts list cannot contain values of 'None'. Please check your playbook"
+        for hosts in (['first', None], (None, 'second')):
+            with self.assertRaises(AnsibleParserError) as error:
+                Play.load(dict(hosts=hosts))
+            self.assertEqual(str(error.exception), message, repr(hosts))
+
+    def test_invalid_host_in_sequence_raises_parser_error(self):
