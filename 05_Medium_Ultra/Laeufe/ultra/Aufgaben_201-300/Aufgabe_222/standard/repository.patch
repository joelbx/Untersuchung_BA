+    def _build_doc(self, role, path, collection, argspec, entry_point=None):
+        """Build documentation for a role's entry points.
+
+        :returns: A (fqcn, doc) tuple, with doc set to None when no entry point matches.
+        """
+        if collection:
+            fqcn = '.'.join([collection, role])
+        else:
+            fqcn = role
+
+        entry_points = {}
+        for ep, entry_spec in (argspec or {}).items():
+            if entry_point is None or ep == entry_point:
+                entry_points[ep] = entry_spec
+
+        if not entry_points:
+            return fqcn, None
+
+        doc = {
+            'path': path,
+            'collection': collection,
+            'entry_points': entry_points,
+        }
+        return fqcn, doc
+
