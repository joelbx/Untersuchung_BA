+		const updatedKeys = [];
+		let firstError;
+		results.forEach(([err], index) => {
+			if (err) {
+				firstError = firstError || err;
+			} else {
+				updatedKeys.push(writes[index][0]);
+			}
+		});
+		if (updatedKeys.length) {
+			cache.del(updatedKeys);
+		}
+		if (firstError) {
+			throw firstError;
+		}
+	};
