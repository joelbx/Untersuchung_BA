+/* global BigInt */
+
 module.exports = function (module) {
 	const helpers = require('./helpers');
 
 	const cache = require('../cache').create('redis');
+	const maxRedisInteger = BigInt('9223372036854775807');
+	const minRedisInteger = -maxRedisInteger - BigInt(1);
+	const maxSafeInteger = BigInt(Number.MAX_SAFE_INTEGER);
+	const bulkIncrementScript = `
+local function compare_integers(a, b)
+	local a_negative = a:sub(1, 1) == '-'
+	local b_negative = b:sub(1, 1) == '-'
+	if a_negative ~= b_negative then
+		return a_negative and -1 or 1
+	end
+	if a_negative then a = a:sub(2) end
+	if b_negative then b = b:sub(2) end
+	if #a ~= #b then
+		if a_negative then return #a > #b and -1 or 1 end
+		return #a < #b and -1 or 1
+	end
+	if a == b then return 0 end
+	if a_negative then return a > b and -1 or 1 end
+	return a < b and -1 or 1
+end
+
+local function is_decimal(value)
+	local mantissa, exponent = value:match('^([^eE]+)[eE]([+-]?%d+)$')
+	if not mantissa then
+		if value:find('[eE]') then return false end
+		mantissa = value
+	elseif math.abs(tonumber(exponent) or math.huge) > 300 then
+		-- Keep the value within Lua's reliable floating-point preflight range.
+		return false
+	end
+	if mantissa:sub(1, 1) == '+' or mantissa:sub(1, 1) == '-' then
+		mantissa = mantissa:sub(2)
+	end
+	return (mantissa:match('^%d+$') or mantissa:match('^%d+%.%d*$') or
+		mantissa:match('^%.%d+$')) ~= nil
+end
+
+local float_fields = {}
+for i = 1, #ARGV, 3 do
+	local current = redis.call('HGET', KEYS[1], ARGV[i])
+	if current then
+		if current == '0' or current:match('^[1-9]%d*$') or
+			current:match('^%-[1-9]%d*$') then
+			if compare_integers(current, '-9223372036854775808') < 0 or
+				compare_integers(current, '9223372036854775807') > 0 then
+				return redis.error_reply('ERR hash value is out of range')
+			end
+			local limit = ARGV[i + 2]
+			if (ARGV[i + 1]:sub(1, 1) == '-' and compare_integers(current, limit) < 0) or
+				(ARGV[i + 1]:sub(1, 1) ~= '-' and compare_integers(current, limit) > 0) then
+				return redis.error_reply('ERR increment or decrement would overflow')
