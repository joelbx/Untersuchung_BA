+				number == math.huge or number == -math.huge or
+				result == math.huge or result == -math.huge or
+				math.abs((result - number) - increment) > 1e-9 then
+				return redis.error_reply('ERR hash value is not a finite decimal')
+			end
+			float_fields[i] = true
+		end
+	end
+end
+
+for i = 1, #ARGV, 3 do
+	if float_fields[i] then
+		if ARGV[i + 1] ~= '0' then
+			redis.call('HINCRBYFLOAT', KEYS[1], ARGV[i], ARGV[i + 1])
+		end
+	else
+		redis.call('HINCRBY', KEYS[1], ARGV[i], ARGV[i + 1])
+	end
+end
+return 1`;
 
