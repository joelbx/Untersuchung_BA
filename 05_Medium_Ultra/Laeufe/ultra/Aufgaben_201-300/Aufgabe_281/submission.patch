diff --git a/test/database/hash-bulk.js b/test/database/hash-bulk.js
new file mode 100644
index 0000000..2ca5c95
--- /dev/null
+++ b/test/database/hash-bulk.js
@@ -0,0 +1,326 @@
+'use strict';
+
+const assert = require('assert');
+
+const createMongoHash = require('../../src/database/mongo/hash');
+const createRedisHash = require('../../src/database/redis/hash');
+
+function createMongoHarness() {
+	const rows = new Map();
+	const calls = [];
+	const collection = {
+		async bulkWrite(operations, options) {
+			calls.push({ method: 'bulkWrite', operations, options });
+			assert.deepStrictEqual(options, { ordered: false });
+			const writeErrors = [];
+			operations.forEach((operation, index) => {
+				const { filter, update, upsert } = operation.updateOne;
+				assert.strictEqual(upsert, true);
+				assert(update.$inc);
+				const oldValue = rows.get(filter._key) || {};
+				const fields = Object.entries(update.$inc);
+				if (fields.some(([field]) => Object.prototype.hasOwnProperty.call(oldValue, field) &&
+					typeof oldValue[field] !== 'number')) {
+					writeErrors.push({ index, code: 14, errmsg: 'Cannot apply $inc to a non-numeric value' });
+					return;
+				}
+				const nextValue = { ...oldValue };
+				fields.forEach(([field, increment]) => {
+					nextValue[field] = (nextValue[field] || 0) + increment;
+				});
+				rows.set(filter._key, nextValue);
+			});
+			if (writeErrors.length) {
+				const error = new Error('Bulk write failed');
+				error.writeErrors = writeErrors;
+				throw error;
+			}
+		},
+		find(filter) {
+			calls.push({ method: 'find', filter });
+			return {
+				toArray: async () => {
+					const keys = typeof filter._key === 'string' ? [filter._key] : filter._key.$in;
+					return keys.filter(key => rows.has(key)).map(key => ({ _key: key, ...rows.get(key) }));
+				},
+			};
+		},
+	};
+	const hash = {
+		client: {
+			collection(name) {
+				calls.push({ method: 'collection', name });
+				assert.strictEqual(name, 'objects');
+				return collection;
+			},
+		},
+	};
+	createMongoHash(hash);
+	return {
+		hash,
+		rows,
+		calls,
+		seed(key, value) { rows.set(key, { ...value }); },
+	};
+}
+
+function createRedisHarness() {
+	const rows = new Map();
+	const calls = [];
+	const hash = {
+		client: {
+			batch() {
+				calls.push({ method: 'batch' });
+				const commands = [];
+				return {
+					eval(script, keyCount, key, ...args) {
+						calls.push({ method: 'eval', script, keyCount, key, args });
+						assert.match(script, /HINCRBY/i);
+						assert.match(script, /HINCRBYFLOAT/i);
+						assert.match(script, /HGET/i);
+						assert.strictEqual(keyCount, 1);
+						assert.strictEqual(args.length % 3, 0);
+						commands.push({ key, args });
+						return this;
+					},
+					async exec() {
+						calls.push({ method: 'exec' });
+						return commands.map(({ key, args }) => {
+							const current = rows.get(key) || {};
+							const next = { ...current };
+							for (let index = 0; index < args.length; index += 3) {
+								const field = args[index];
+								const oldValue = current[field];
+								if (oldValue !== undefined &&
+									(!/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/.test(oldValue) ||
+									!Number.isFinite(Number(oldValue)))) {
+									return [new Error('ERR hash value is not numeric'), null];
+								}
+							}
+							for (let index = 0; index < args.length; index += 3) {
+								const field = args[index];
+								next[field] = String(Number(next[field] || 0) + Number(args[index + 1]));
+							}
+							rows.set(key, next);
+							return [null, 1];
+						});
+					},
+				};
+			},
+			async hgetall(key) {
+				calls.push({ method: 'hgetall', key });
+				return { ...(rows.get(key) || {}) };
+			},
+		},
+	};
+	createRedisHash(hash);
+	return {
+		hash,
+		rows,
+		calls,
+		seed(key, value) {
+			rows.set(key, Object.fromEntries(Object.entries(value).map(([field, item]) => [field, String(item)])));
+		},
+	};
+}
+
+[
+	['Mongo', createMongoHarness],
+	['Redis', createRedisHarness],
+].forEach(([backend, createHarness]) => {
+	describe(`${backend} incrObjectFieldByBulk()`, () => {
+		let harness;
+
+		before(() => {
+			harness = createHarness();
+		});
+
+		beforeEach(() => {
+			harness.rows.clear();
+			harness.calls.length = 0;
+			harness.hash.objectCache.reset();
+		});
+
+		it('increments several fields and keys, creates missing values, and returns void', async () => {
+			const { hash, rows } = harness;
+			harness.seed('existing', { age: 10 });
+			hash.objectCache.set('existing', { age: 10 });
+			hash.objectCache.set('created', null);
+
+			const result = await hash.incrObjectFieldByBulk([
+				['existing', { age: 5, newField: 10 }],
+				['created', { balance: -2 }],
+			]);
+
+			assert.strictEqual(result, undefined);
+			assert.strictEqual(Number(rows.get('existing').age), 15);
+			assert.strictEqual(Number(rows.get('existing').newField), 10);
+			assert.strictEqual(Number(rows.get('created').balance), -2);
+			assert.strictEqual(hash.objectCache.has('existing'), false);
+			assert.strictEqual(hash.objectCache.has('created'), false);
+			assert.strictEqual(Number((await hash.getObject('existing')).age), 15);
+			assert.strictEqual(Number((await hash.getObject('created')).balance), -2);
+		});
+
+		it('combines repeated keys into one atomic per-key write', async () => {
+			const { hash, rows, calls } = harness;
+			await hash.incrObjectFieldByBulk([
+				['repeated', { age: 2 }],
+				['repeated', { age: -3, newField: 4 }],
+			]);
+			assert.strictEqual(Number(rows.get('repeated').age), -1);
+			assert.strictEqual(Number(rows.get('repeated').newField), 4);
+			const perKeyWrites = backend === 'Mongo' ?
+				calls.find(call => call.method === 'bulkWrite').operations.length :
+				calls.filter(call => call.method === 'eval').length;
+			assert.strictEqual(perKeyWrites, 1);
+		});
+
+		it('rejects malformed input before any backend call', async () => {
+			const invalid = [
+				undefined, null, {}, 'key', ['key', { age: 1 }],
+				[['key']], [[123, { age: 1 }]], [['key', null]],
+				[['key', []]], [['key', { age: 1 }, 'extra']],
+			];
+			for (const data of invalid) {
+				// eslint-disable-next-line no-await-in-loop
+				await assert.rejects(harness.hash.incrObjectFieldByBulk(data));
+			}
+			assert.deepStrictEqual(harness.calls, []);
+		});
+
+		it('rejects unsafe increments before writing any key', async () => {
+			const invalid = [1.5, NaN, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1, '1', null, true];
+			for (const value of invalid) {
+				// eslint-disable-next-line no-await-in-loop
+				await assert.rejects(harness.hash.incrObjectFieldByBulk([['bad', { age: value }]]));
+			}
+			harness.seed('good', { age: 1 });
+			await assert.rejects(async () => harness.hash.incrObjectFieldByBulk([
+				['good', { age: 1 }], ['bad', { age: 1.5 }],
+			]));
+			assert.strictEqual(Number(harness.rows.get('good').age), 1);
+			assert.deepStrictEqual(harness.calls, []);
+		});
+
+		it('rejects dangerous field names before writing', async () => {
+			for (const field of ['__proto__', 'constructor', 'a.b', '$value', 'a$b']) {
+				const increments = Object.fromEntries([[field, 1]]);
+				// eslint-disable-next-line no-await-in-loop
+				await assert.rejects(harness.hash.incrObjectFieldByBulk([['bad', increments]]));
+			}
+			assert.deepStrictEqual(harness.calls, []);
+		});
+
+		it('keeps each failed key unchanged while updating other keys', async () => {
+			const { hash, rows } = harness;
+			harness.seed('bad', { count: 2, label: 'text' });
+			harness.seed('good', { count: 3 });
+			hash.objectCache.set('bad', { count: 2, label: 'text' });
+			hash.objectCache.set('good', { count: 3 });
+
+			await assert.rejects(async () => hash.incrObjectFieldByBulk([
+				['bad', { count: 5, label: 1 }],
+				['good', { count: -1, created: 7 }],
+			]));
+
+			assert.strictEqual(Number(rows.get('bad').count), 2);
+			assert.strictEqual(rows.get('bad').label, 'text');
+			assert.strictEqual(Number(rows.get('good').count), 2);
+			assert.strictEqual(Number(rows.get('good').created), 7);
+			assert.strictEqual(hash.objectCache.has('bad'), true);
+			assert.strictEqual(hash.objectCache.has('good'), false);
+		});
+
+		it('does no database or cache work for an empty array', async () => {
+			const { hash, calls } = harness;
+			const cache = hash.objectCache;
+			const methods = ['del', 'get', 'set', 'getUnCachedKeys'];
+			const originals = Object.fromEntries(methods.map(method => [method, cache[method]]));
+			let cacheCalls = 0;
+			methods.forEach((method) => {
+				cache[method] = function (...args) {
+					cacheCalls += 1;
+					return originals[method].apply(this, args);
+				};
+			});
+			try {
+				assert.strictEqual(await hash.incrObjectFieldByBulk([]), undefined);
+				assert.deepStrictEqual(calls, []);
+				assert.strictEqual(cacheCalls, 0);
+			} finally {
+				methods.forEach((method) => { cache[method] = originals[method]; });
+			}
+		});
+
+		if (backend === 'Mongo') {
+			it('retries a duplicate-key upsert with an atomic increment', async () => {
+				const { hash, rows } = harness;
+				const originalCollection = hash.client.collection;
+				const operations = [];
+				hash.objectCache.set('racing', { count: 0 });
+				hash.client.collection = function (name) {
+					assert.strictEqual(name, 'objects');
+					return {
+						async bulkWrite(writes, options) {
+							assert.deepStrictEqual(options, { ordered: false });
+							assert.strictEqual(writes.length, 1);
+							operations.push('bulkWrite');
+							rows.set('racing', { count: 7 });
+							const error = new Error('E11000 duplicate key error');
+							error.writeErrors = [{ index: 0, code: 11000 }];
+							throw error;
+						},
+						async updateOne(filter, update, options) {
+							operations.push('updateOne');
+							assert.deepStrictEqual(filter, { _key: 'racing' });
+							assert.deepStrictEqual({ ...update.$inc }, { count: 5, newField: 10 });
+							assert.deepStrictEqual(options, { upsert: true });
+							const oldValue = rows.get('racing');
+							rows.set('racing', { count: oldValue.count + 5, newField: 10 });
+						},
+					};
+				};
+				try {
+					assert.strictEqual(await hash.incrObjectFieldByBulk([['racing', { count: 5, newField: 10 }]]), undefined);
+				} finally {
