+		if (!writes.length) {
+			return;
+		}
+
+		const batch = module.client.batch();
+		for (const [key, fields] of writes) {
+			const args = [];
+			for (const [field, increment] of fields) {
+				const amount = BigInt(increment);
+				const limit = amount < 0 ? minRedisInteger - amount : maxRedisInteger - amount;
+				args.push(field, String(increment), String(limit));
