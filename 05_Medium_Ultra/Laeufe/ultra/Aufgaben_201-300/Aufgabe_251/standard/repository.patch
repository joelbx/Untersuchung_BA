+// validate keeps output separate from process exit handling so callers can use
+// the command's output writers and validation failures can retain JSON stdout.
+func (v *validateCommand) validate(cmd *cobra.Command, files []string) error {
+	if len(files) == 0 {
+		return errors.New("validation failed: no YAML files provided")
+	}
+	if v.format != "text" && v.format != "json" {
+		return fmt.Errorf("invalid validation output format %q: use text or json", v.format)
+	}
+
+	validator, err := cue.NewFeaturesValidator()
+	if err != nil {
+		return fmt.Errorf("initialize features validator: %w", err)
+	}
+
+	result := cue.Result{Errors: make([]cue.Error, 0)}
+	for _, file := range files {
+		b, err := os.ReadFile(file)
+		if err != nil {
+			return fmt.Errorf("read %s: %w", file, err)
+		}
+
+		fileResult, err := validator.Validate(file, b)
+		result.Errors = append(result.Errors, fileResult.Errors...)
+		if err != nil && !errors.Is(err, cue.ErrValidationFailed) {
+			return fmt.Errorf("validate %s: %w", file, err)
+		}
+	}
+
+	if v.format == "json" {
+		if err := json.NewEncoder(cmd.OutOrStdout()).Encode(result); err != nil {
+			return fmt.Errorf("write validation result: %w", err)
+		}
+	} else if len(result.Errors) == 0 {
+		if _, err := fmt.Fprintln(cmd.OutOrStdout(), "✅ Validation success!"); err != nil {
+			return fmt.Errorf("write validation result: %w", err)
+		}
+	} else {
+		if _, err := fmt.Fprintln(cmd.OutOrStdout(), "❌ Validation failure!"); err != nil {
+			return fmt.Errorf("write validation result: %w", err)
+		}
+		for _, issue := range result.Errors {
+			if _, err := fmt.Fprintf(cmd.OutOrStdout(), "%s:%d:%d: %s: %s\n", issue.Location.File, issue.Location.Line, issue.Location.Column, issue.Path, issue.Message); err != nil {
+				return fmt.Errorf("write validation result: %w", err)
+			}
+		}
+	}
+
+	if len(result.Errors) > 0 {
+		return cue.ErrValidationFailed
+	}
+	return nil
+}
