+
+func TestValidateCommandFormatsAndAggregatesFiles(t *testing.T) {
+	invalid, err := os.ReadFile("../../internal/cue/fixtures/invalid.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var files []string
+	for _, name := range []string{"first.yaml", "second.yaml"} {
+		file := filepath.Join(t.TempDir(), name)
+		if err := os.WriteFile(file, invalid, 0600); err != nil {
+			t.Fatal(err)
+		}
+		files = append(files, file)
+	}
+
+	for _, format := range []string{"json", "text"} {
+		t.Run(format, func(t *testing.T) {
+			var output bytes.Buffer
+			cmd := &cobra.Command{}
+			cmd.SetOut(&output)
+			v := &validateCommand{format: format}
+			if err := v.validate(cmd, files); !errors.Is(err, cue.ErrValidationFailed) {
+				t.Fatalf("validate error = %v, want validation failed", err)
+			}
+
+			if format == "text" {
+				for _, file := range files {
+					if !strings.Contains(output.String(), file+":17:16: flags.0.rules.0.distributions.0.rollout:") {
+						t.Errorf("text result has no precise rollout location for %s: %s", file, output.String())
+					}
+				}
+				return
+			}
+
+			var result cue.Result
+			if err := json.Unmarshal(output.Bytes(), &result); err != nil {
+				t.Fatalf("decode JSON result: %v: %s", err, output.String())
+			}
+			if len(result.Errors) != 2 {
+				t.Fatalf("got %d errors, want one for each file: %s", len(result.Errors), output.String())
+			}
+			for i, issue := range result.Errors {
+				if issue.Location.File != files[i] || issue.Location.Line != 17 || issue.Location.Column != 16 {
+					t.Errorf("error %d location = %+v, want %s:17:16", i, issue.Location, files[i])
+				}
+				if issue.Path != "flags.0.rules.0.distributions.0.rollout" || !strings.Contains(issue.Message, "<=100") {
+					t.Errorf("error %d = %+v, want rollout bound issue", i, issue)
+				}
+			}
+		})
+	}
+}
+
+func TestValidateCommandNoFiles(t *testing.T) {
+	v := &validateCommand{format: "json"}
+	if err := v.validate(&cobra.Command{}, nil); err == nil || !strings.Contains(err.Error(), "no YAML files") {
+		t.Fatalf("validate error = %v, want missing files error", err)
+	}
+}
+
+func TestValidateCommandJSONSuccess(t *testing.T) {
+	var output bytes.Buffer
+	cmd := &cobra.Command{}
+	cmd.SetOut(&output)
+	v := &validateCommand{format: "json"}
+	if err := v.validate(cmd, []string{"../../internal/cue/fixtures/valid.yaml"}); err != nil {
+		t.Fatal(err)
+	}
+	var result cue.Result
+	if err := json.Unmarshal(output.Bytes(), &result); err != nil {
+		t.Fatalf("decode JSON result: %v: %s", err, output.String())
+	}
+	if result.Errors == nil || len(result.Errors) != 0 {
+		t.Errorf("JSON success result = %s, want empty errors array", output.String())
+	}
+}
+
+func TestValidateCommandProcessExit(t *testing.T) {
+	if os.Getenv("FLIPT_TEST_VALIDATE_PROCESS") == "1" {
+		separator := -1
+		for i, arg := range os.Args {
+			if arg == "--" {
+				separator = i
+				break
+			}
+		}
+		if separator < 0 {
+			os.Exit(99)
+		}
+		cmd := newValidateCommand()
+		cmd.SetArgs(os.Args[separator+1:])
+		if err := cmd.Execute(); err != nil {
+			os.Exit(98)
+		}
+		return
+	}
+
+	file := "../../internal/cue/fixtures/invalid.yaml"
+	process := exec.Command(os.Args[0], "-test.run=^TestValidateCommandProcessExit$", "--", "--issue-exit-code", "7", "-F", "json", file)
+	process.Env = []string{"FLIPT_TEST_VALIDATE_PROCESS=1"}
+	var stdout, stderr bytes.Buffer
+	process.Stdout = &stdout
+	process.Stderr = &stderr
+	err := process.Run()
+	var exitErr *exec.ExitError
+	if !errors.As(err, &exitErr) || exitErr.ExitCode() != 7 {
+		t.Fatalf("process error = %v, want exit code 7; stderr: %s", err, stderr.String())
+	}
+	if !strings.Contains(stderr.String(), "validation failed") {
+		t.Errorf("stderr has no validation failure signal: %s", stderr.String())
+	}
+	var result cue.Result
+	if err := json.Unmarshal(stdout.Bytes(), &result); err != nil || len(result.Errors) == 0 {
+		t.Errorf("stdout is not a JSON validation result: %v: %s", err, stdout.String())
+	}
+}
