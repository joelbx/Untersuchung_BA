+
+    assert entity._get_statement_values('P1960') == expected
+
+
+def test_get_external_profiles_with_localized_wikipedia_and_multiple_scholar_ids():
+    entity = createWikidataEntity()
+    entity.sitelinks = {
+        'frwiki': {'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams'},
+        'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'},
+    }
+    entity.statements = {
+        'P1960': [
+            {'value': {'content': 'first-id'}},
+            {'value': {'content': 'second-id'}},
+        ]
+    }
+
+    profiles = entity.get_external_profiles('fr')
+
+    assert len(profiles) == 4
+    assert {frozenset(profile.items()) for profile in profiles} == {
+        frozenset(
+            {
+                'url': 'https://fr.wikipedia.org/wiki/Douglas_Adams',
+                'icon_url': '/static/images/identifier_icons/wikipedia.svg',
+                'label': 'Wikipedia',
+            }.items()
+        ),
+        frozenset(
+            {
+                'url': 'https://www.wikidata.org/wiki/Q42',
+                'icon_url': '/static/images/identifier_icons/wikidata.svg',
+                'label': 'Wikidata',
+            }.items()
+        ),
+        frozenset(
+            {
+                'url': 'https://scholar.google.com/citations?user=first-id',
+                'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+                'label': 'Google Scholar',
+            }.items()
+        ),
+        frozenset(
+            {
+                'url': 'https://scholar.google.com/citations?user=second-id',
+                'icon_url': '/static/images/identifier_icons/google_scholar.svg',
+                'label': 'Google Scholar',
+            }.items()
+        ),
+    }
+
+
+@pytest.mark.parametrize(
+    'sitelinks, expected_wikipedia_url',
+    [
+        (
+            {'enwiki': {'url': 'https://en.wikipedia.org/wiki/Douglas_Adams'}},
+            'https://en.wikipedia.org/wiki/Douglas_Adams',
+        ),
+        ({'dewiki': {'url': 'https://de.wikipedia.org/wiki/Douglas_Adams'}}, None),
+    ],
+)
+def test_get_external_profiles_wikipedia_fallback_or_omission(
+    sitelinks, expected_wikipedia_url
+):
+    entity = createWikidataEntity()
+    entity.sitelinks = sitelinks
+    entity.statements = {}
+
+    profiles = entity.get_external_profiles('fr')
+
+    assert {
+        profile['url']
+        for profile in profiles
+        if profile['label'] == 'Wikipedia'
+    } == ({expected_wikipedia_url} if expected_wikipedia_url else set())
+    assert {
+        profile['url'] for profile in profiles if profile['label'] == 'Wikidata'
+    } == {'https://www.wikidata.org/wiki/Q42'}
+    assert all(set(profile) == {'url', 'icon_url', 'label'} for profile in profiles)
