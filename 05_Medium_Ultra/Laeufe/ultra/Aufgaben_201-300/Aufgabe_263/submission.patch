+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package dynamoevents
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/aws/aws-sdk-go/service/dynamodb/dynamodbattribute"
+	"github.com/gravitational/trace"
+)
+
+const keyFieldsMap = "FieldsMap"
+
+// fieldsMapFromJSON converts event JSON to a DynamoDB map without first
+// converting numbers to float64. The SDK's default encoder also converts empty
+// strings and collections to NULL, so the AttributeValues are built directly.
+func fieldsMapFromJSON(data []byte) (map[string]*dynamodb.AttributeValue, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var fields map[string]interface{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if fields == nil {
+		return nil, trace.BadParameter("event fields must be a JSON object")
+	}
+	var trailing interface{}
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return nil, trace.BadParameter("unexpected data after event fields")
+		}
+		return nil, trace.Wrap(err)
+	}
+
+	return jsonObjectToAttributeMap(fields)
+}
+
+func jsonObjectToAttributeMap(object map[string]interface{}) (map[string]*dynamodb.AttributeValue, error) {
+	result := make(map[string]*dynamodb.AttributeValue, len(object))
+	for name, value := range object {
+		attribute, err := jsonValueToAttribute(value)
+		if err != nil {
+			return nil, trace.WrapWithMessage(err, "invalid event field %q", name)
+		}
+		result[name] = attribute
+	}
+	return result, nil
+}
+
+func jsonValueToAttribute(value interface{}) (*dynamodb.AttributeValue, error) {
+	switch value := value.(type) {
+	case nil:
+		return &dynamodb.AttributeValue{NULL: aws.Bool(true)}, nil
+	case bool:
+		return &dynamodb.AttributeValue{BOOL: aws.Bool(value)}, nil
+	case string:
+		return &dynamodb.AttributeValue{S: aws.String(value)}, nil
+	case json.Number:
+		return &dynamodb.AttributeValue{N: aws.String(string(value))}, nil
+	case map[string]interface{}:
+		fields, err := jsonObjectToAttributeMap(value)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return &dynamodb.AttributeValue{M: fields}, nil
+	case []interface{}:
+		list := make([]*dynamodb.AttributeValue, 0, len(value))
+		for _, element := range value {
+			attribute, err := jsonValueToAttribute(element)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			list = append(list, attribute)
+		}
+		return &dynamodb.AttributeValue{L: list}, nil
+	default:
+		return nil, trace.BadParameter("unsupported JSON event field type %T", value)
+	}
+}
+
+// fieldsMapToJSON reconstructs JSON from the supported DynamoDB attribute
+// types. json.Number keeps numeric values exact during migration validation.
+func fieldsMapToJSON(fields map[string]*dynamodb.AttributeValue) ([]byte, error) {
+	if fields == nil {
+		return nil, trace.BadParameter("event FieldsMap is missing")
+	}
+	object, err := attributeMapToJSONObject(fields)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	data, err := json.Marshal(object)
+	return data, trace.Wrap(err)
+}
+
+func attributeMapToJSONObject(attributes map[string]*dynamodb.AttributeValue) (map[string]interface{}, error) {
+	object := make(map[string]interface{}, len(attributes))
+	for name, attribute := range attributes {
+		value, err := attributeToJSONValue(attribute)
+		if err != nil {
+			return nil, trace.WrapWithMessage(err, "invalid event field %q", name)
+		}
+		object[name] = value
+	}
+	return object, nil
+}
+
+func attributeToJSONValue(attribute *dynamodb.AttributeValue) (interface{}, error) {
+	if attribute == nil {
+		return nil, trace.BadParameter("nil DynamoDB event field")
+	}
+	switch {
+	case attribute.S != nil:
+		return *attribute.S, nil
+	case attribute.N != nil:
+		return json.Number(*attribute.N), nil
+	case attribute.BOOL != nil:
+		return *attribute.BOOL, nil
+	case attribute.NULL != nil && *attribute.NULL:
+		return nil, nil
+	case attribute.M != nil:
+		return attributeMapToJSONObject(attribute.M)
+	case attribute.L != nil:
+		list := make([]interface{}, 0, len(attribute.L))
+		for _, element := range attribute.L {
+			value, err := attributeToJSONValue(element)
+			if err != nil {
+				return nil, trace.Wrap(err)
+			}
+			list = append(list, value)
+		}
+		return list, nil
+	default:
+		return nil, trace.BadParameter("unsupported DynamoDB event field type")
+	}
+}
+
+func (e event) fieldsJSON() ([]byte, error) {
+	if e.FieldsMap != nil {
+		data, err := fieldsMapToJSON(e.FieldsMap)
+		if err == nil {
+			return data, nil
+		}
+		if e.Fields == "" {
+			return nil, trace.Wrap(err)
+		}
+	}
+	if e.Fields == "" {
+		return nil, trace.BadParameter("event has neither FieldsMap nor Fields")
+	}
+	return []byte(e.Fields), nil
+}
+
+func marshalEvent(e event) (map[string]*dynamodb.AttributeValue, error) {
+	item, err := dynamodbattribute.MarshalMap(e)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if e.FieldsMap != nil {
+		delete(item, "Fields")
+		item[keyFieldsMap] = &dynamodb.AttributeValue{M: e.FieldsMap}
+	}
+	return item, nil
+}
+
+func unmarshalEvent(item map[string]*dynamodb.AttributeValue) (event, error) {
+	var e event
+	if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+		return event{}, trace.Wrap(err)
+	}
+	if attribute, ok := item[keyFieldsMap]; ok {
+		if attribute == nil || attribute.M == nil {
+			if e.Fields == "" {
+				return event{}, trace.BadParameter("event FieldsMap is not a DynamoDB map")
+			}
+			return e, nil
+		}
+		e.FieldsMap = attribute.M
+	}
+	return e, nil
+}
diff --git a/lib/events/dynamoevents/fieldsmap_migration.go b/lib/events/dynamoevents/fieldsmap_migration.go
new file mode 100644
index 0000000..49b4301
--- /dev/null
+++ b/lib/events/dynamoevents/fieldsmap_migration.go
@@ -0,0 +1,506 @@
+/*
