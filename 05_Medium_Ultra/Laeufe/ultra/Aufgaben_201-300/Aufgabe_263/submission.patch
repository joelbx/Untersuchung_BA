+
+package dynamoevents
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/awserr"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/service/dynamodb"
+	"github.com/gravitational/teleport/lib/backend"
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/gravitational/trace"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// Old auth servers can still write legacy events during a rolling upgrade.
+	// A periodic full pass picks up those late writes, while the shared backend
+	// timestamp prevents every auth server from scanning the table in turn.
+	fieldsMapRescanInterval = time.Hour
+	fieldsMapRetryInterval  = time.Minute
+	fieldsMapPageSize       = DynamoBatchSize * maxMigrationWorkers
+)
+
+// fieldsMapMigrationState is persisted only after all writes in a scan page
+// have completed. A failed or interrupted page is therefore safe to replay.
+type fieldsMapMigrationState struct {
+	LastEvaluatedKey map[string]*dynamodb.AttributeValue `json:"last_evaluated_key,omitempty"`
+	InvalidCount     int64                               `json:"invalid_count,omitempty"`
+	ConflictCount    int64                               `json:"conflict_count,omitempty"`
+	MigratedCount    int64                               `json:"migrated_count,omitempty"`
+	CompletedAt      time.Time                           `json:"completed_at,omitempty"`
+}
+
+type fieldsMapMigrationClient interface {
+	ScanWithContext(aws.Context, *dynamodb.ScanInput, ...request.Option) (*dynamodb.ScanOutput, error)
+	TransactWriteItemsWithContext(aws.Context, *dynamodb.TransactWriteItemsInput, ...request.Option) (*dynamodb.TransactWriteItemsOutput, error)
+	UpdateItemWithContext(aws.Context, *dynamodb.UpdateItemInput, ...request.Option) (*dynamodb.UpdateItemOutput, error)
+}
+
+// migrateFieldsMapWithRetry keeps checking for legacy rows after the first
+// successful pass. Old nodes may write them until a rolling upgrade is over.
+func (l *Log) migrateFieldsMapWithRetry(ctx context.Context) {
+	for ctx.Err() == nil {
+		delay := fieldsMapRescanInterval
+		if err := l.migrateFieldsMap(ctx); err != nil {
+			if ctx.Err() != nil {
+				return
+			}
+			log.WithError(err).Error("DynamoDB FieldsMap migration failed; retrying")
+			delay = utils.HalfJitter(fieldsMapRetryInterval)
+		}
+		select {
+		case <-time.After(delay):
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// migrateFieldsMap converts legacy Fields strings to native FieldsMap values.
+// The RFD24 lock also protects the older date migration, which rewrites full
+// items using BatchWriteItem.
+func (l *Log) migrateFieldsMap(ctx context.Context) error {
+	return l.migrateFieldsMapWithClient(ctx, l.svc)
+}
+
+func (l *Log) migrateFieldsMapWithClient(ctx context.Context, client fieldsMapMigrationClient) error {
+	return trace.Wrap(backend.RunWhileLocked(ctx, l.backend, rfd24MigrationLock, rfd24MigrationLockTTL, func(ctx context.Context) error {
+		return l.migrateFieldsMapLocked(ctx, client)
+	}))
+}
+
+func (l *Log) fieldsMapMigrationKey() []byte {
+	return backend.FlagKey("dynamoEvents", l.Tablename, "fieldsMapMigration")
+}
+
+func (l *Log) loadFieldsMapMigrationState(ctx context.Context) (fieldsMapMigrationState, error) {
+	var state fieldsMapMigrationState
+	item, err := l.backend.Get(ctx, l.fieldsMapMigrationKey())
+	if trace.IsNotFound(err) {
+		return state, nil
+	}
+	if err != nil {
+		return state, trace.Wrap(err)
+	}
+	if err := json.Unmarshal(item.Value, &state); err != nil {
+		return state, trace.WrapWithMessage(err, "invalid FieldsMap migration checkpoint")
+	}
+	return state, nil
+}
+
+func (l *Log) saveFieldsMapMigrationState(ctx context.Context, state fieldsMapMigrationState) error {
+	data, err := json.Marshal(state)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	_, err = l.backend.Put(ctx, backend.Item{Key: l.fieldsMapMigrationKey(), Value: data})
+	return trace.Wrap(err)
+}
+
+// migrateFieldsMapLocked must only run while the RFD24 migration lock is held.
+func (l *Log) migrateFieldsMapLocked(ctx context.Context, client fieldsMapMigrationClient) error {
+	state, err := l.loadFieldsMapMigrationState(ctx)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if !state.CompletedAt.IsZero() && l.backend.Clock().Now().UTC().Before(state.CompletedAt.Add(fieldsMapRescanInterval)) {
+		return nil
+	}
+
+	// Clear a previous completion marker before starting a new sweep. A crash
+	// before its first page will then cause the next attempt to start at the
+	// beginning rather than treating an old pass as current.
+	if !state.CompletedAt.IsZero() {
+		state = fieldsMapMigrationState{}
+		if err := l.saveFieldsMapMigrationState(ctx, state); err != nil {
+			return trace.Wrap(err)
+		}
+	}
+
+	log.WithField("table", l.Tablename).Info("Starting DynamoDB FieldsMap migration pass")
+	for {
+		if err := ctx.Err(); err != nil {
+			return trace.Wrap(err)
+		}
+		out, err := client.ScanWithContext(ctx, &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: state.LastEvaluatedKey,
+			ConsistentRead:    aws.Bool(true),
+			Limit:             aws.Int64(fieldsMapPageSize),
+			FilterExpression:  aws.String("attribute_exists(#fields)"),
+			ExpressionAttributeNames: map[string]*string{
+				"#fields": aws.String("Fields"),
+			},
+		})
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		if out == nil {
+			return trace.BadParameter("DynamoDB scan returned no result during FieldsMap migration")
+		}
+
+		updates := make([]*fieldsMapUpdate, 0, len(out.Items))
+		for _, item := range out.Items {
+			update, err := fieldsMapMigrationUpdate(item)
+			if err != nil {
+				state.InvalidCount++
+				var sessionID, eventIndex string
+				if key := item[keySessionID]; key != nil {
+					sessionID = aws.StringValue(key.S)
+				}
+				if key := item[keyEventIndex]; key != nil {
+					eventIndex = aws.StringValue(key.N)
+				}
+				log.WithFields(log.Fields{
+					"table":       l.Tablename,
+					"session_id":  sessionID,
+					"event_index": eventIndex,
+				}).WithError(err).Error("Unable to convert DynamoDB audit event Fields")
+				continue
+			}
+			updates = append(updates, update)
+		}
+
+		conflicts, err := writeFieldsMapBatches(ctx, client, l.Tablename, updates)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		state.ConflictCount += conflicts
+		state.MigratedCount += int64(len(updates)) - conflicts
+		state.LastEvaluatedKey = out.LastEvaluatedKey
+		if err := l.saveFieldsMapMigrationState(ctx, state); err != nil {
+			return trace.Wrap(err)
+		}
+		if len(updates) != 0 {
+			log.WithFields(log.Fields{"table": l.Tablename, "migrated": state.MigratedCount, "invalid": state.InvalidCount, "conflicts": state.ConflictCount}).Info("DynamoDB FieldsMap migration progress")
+		}
+		if len(out.LastEvaluatedKey) == 0 {
+			break
+		}
+	}
+
+	if state.InvalidCount != 0 || state.ConflictCount != 0 {
+		// Restart at the beginning on the next retry so invalid records are
+		// revisited after they have been repaired, and concurrent updates are
+		// scanned again. Converted records no longer match the scan filter.
+		if err := l.saveFieldsMapMigrationState(ctx, fieldsMapMigrationState{}); err != nil {
+			return trace.Wrap(err)
+		}
+		return trace.BadParameter("FieldsMap migration could not convert %d invalid and %d concurrently changed audit events in table %q", state.InvalidCount, state.ConflictCount, l.Tablename)
+	}
+	state.CompletedAt = l.backend.Clock().Now().UTC()
+	if err := l.saveFieldsMapMigrationState(ctx, state); err != nil {
+		return trace.Wrap(err)
+	}
+	log.WithFields(log.Fields{"table": l.Tablename, "migrated": state.MigratedCount}).Info("Completed DynamoDB FieldsMap migration pass")
+	return nil
+}
+
+type fieldsMapUpdate struct {
+	key          map[string]*dynamodb.AttributeValue
+	legacyFields string
+	fieldsMap    map[string]*dynamodb.AttributeValue
+	legacyKey    string
+}
+
+func fieldsMapMigrationUpdate(item map[string]*dynamodb.AttributeValue) (*fieldsMapUpdate, error) {
+	if item[keySessionID] == nil || item[keySessionID].S == nil || item[keyEventIndex] == nil || item[keyEventIndex].N == nil {
+		return nil, trace.BadParameter("audit event is missing its DynamoDB key")
+	}
+	legacy := item["Fields"]
+	if legacy == nil || legacy.S == nil {
+		return nil, trace.BadParameter("legacy Fields attribute is not a string")
+	}
+	fieldsMap, err := fieldsMapFromJSON([]byte(*legacy.S))
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	roundTrip, err := fieldsMapToJSON(fieldsMap)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if err := validateFieldsMapContent([]byte(*legacy.S), roundTrip); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if existing := item["FieldsMap"]; existing != nil {
+		if existing.M == nil {
+			return nil, trace.BadParameter("existing FieldsMap attribute is not a map")
+		}
+		existingJSON, err := fieldsMapToJSON(existing.M)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		if err := validateFieldsMapContent([]byte(*legacy.S), existingJSON); err != nil {
+			return nil, trace.WrapWithMessage(err, "existing FieldsMap differs from Fields")
+		}
+	}
+	legacyEvent, err := unmarshalEvent(item)
+	if err != nil {
+		return nil, trace.WrapWithMessage(err, "invalid legacy audit event")
+	}
+	legacyKey := legacySubPageCheckpoint(&legacyEvent)
+	if legacyKey == "" {
+		return nil, trace.BadParameter("could not calculate legacy audit event checkpoint")
+	}
+	return &fieldsMapUpdate{
+		key: map[string]*dynamodb.AttributeValue{
+			keySessionID:  item[keySessionID],
+			keyEventIndex: item[keyEventIndex],
+		},
+		legacyFields: *legacy.S,
+		fieldsMap:    fieldsMap,
+		legacyKey:    legacyKey,
+	}, nil
+}
+
+func (update *fieldsMapUpdate) expressionAttributes() (map[string]*string, map[string]*dynamodb.AttributeValue) {
+	return map[string]*string{
+			"#fields":    aws.String("Fields"),
+			"#fieldsMap": aws.String("FieldsMap"),
+			"#legacyKey": aws.String("LegacyEventKey"),
+		}, map[string]*dynamodb.AttributeValue{
+			":legacyFields": {S: aws.String(update.legacyFields)},
+			":fieldsMap":    {M: update.fieldsMap},
+			":legacyKey":    {S: aws.String(update.legacyKey)},
+		}
+}
+
+func (update *fieldsMapUpdate) transactionItem(table string) *dynamodb.TransactWriteItem {
+	names, values := update.expressionAttributes()
+	return &dynamodb.TransactWriteItem{Update: &dynamodb.Update{
+		TableName:                 aws.String(table),
+		Key:                       update.key,
+		UpdateExpression:          aws.String("SET #fieldsMap = :fieldsMap, #legacyKey = :legacyKey REMOVE #fields"),
+		ConditionExpression:       aws.String("#fields = :legacyFields"),
+		ExpressionAttributeNames:  names,
+		ExpressionAttributeValues: values,
+	}}
+}
+
+func (update *fieldsMapUpdate) updateItemInput(table string) *dynamodb.UpdateItemInput {
+	names, values := update.expressionAttributes()
+	return &dynamodb.UpdateItemInput{
+		TableName:                 aws.String(table),
+		Key:                       update.key,
+		UpdateExpression:          aws.String("SET #fieldsMap = :fieldsMap, #legacyKey = :legacyKey REMOVE #fields"),
+		ConditionExpression:       aws.String("#fields = :legacyFields"),
+		ExpressionAttributeNames:  names,
+		ExpressionAttributeValues: values,
+	}
+}
+
+func validateFieldsMapContent(legacyJSON, mapJSON []byte) error {
+	decode := func(data []byte) (interface{}, error) {
+		decoder := json.NewDecoder(bytes.NewReader(data))
+		decoder.UseNumber()
+		var value interface{}
+		if err := decoder.Decode(&value); err != nil {
+			return nil, trace.Wrap(err)
+		}
+		var extra interface{}
+		if err := decoder.Decode(&extra); err != io.EOF {
+			if err == nil {
+				return nil, trace.BadParameter("multiple JSON values in event Fields")
+			}
+			return nil, trace.Wrap(err)
+		}
+		return value, nil
+	}
+	before, err := decode(legacyJSON)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	after, err := decode(mapJSON)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if !fieldsJSONEqual(before, after) {
+		return trace.BadParameter("FieldsMap changes event metadata")
+	}
+	return nil
+}
+
+// fieldsJSONEqual compares parsed JSON values without turning numbers into
+// float64. DynamoDB can normalize numeric spellings such as 1.0 to 1.
+func fieldsJSONEqual(before, after interface{}) bool {
+	switch before := before.(type) {
+	case json.Number:
+		after, ok := after.(json.Number)
+		if !ok {
+			return false
+		}
+		if before == after {
+			return true
+		}
+		// DynamoDB limits numbers to 38 significant digits. Bound work on
+		// malformed input with huge exponents before using exact rational math.
+		for _, number := range []json.Number{before, after} {
+			if len(number) > 256 {
+				return false
+			}
+			if exponent := strings.IndexAny(string(number), "eE"); exponent >= 0 {
+				value, err := strconv.Atoi(string(number)[exponent+1:])
+				if err != nil || value < -1000 || value > 1000 {
+					return false
+				}
+			}
+		}
+		var beforeRat, afterRat big.Rat
+		if _, ok := beforeRat.SetString(string(before)); !ok {
+			return false
+		}
+		if _, ok := afterRat.SetString(string(after)); !ok {
+			return false
+		}
+		return beforeRat.Cmp(&afterRat) == 0
+	case map[string]interface{}:
+		after, ok := after.(map[string]interface{})
+		if !ok || len(before) != len(after) {
+			return false
+		}
+		for key, value := range before {
+			other, found := after[key]
+			if !found || !fieldsJSONEqual(value, other) {
+				return false
+			}
+		}
+		return true
+	case []interface{}:
+		after, ok := after.([]interface{})
+		if !ok || len(before) != len(after) {
+			return false
+		}
+		for index, value := range before {
+			if !fieldsJSONEqual(value, after[index]) {
+				return false
+			}
+		}
+		return true
+	default:
+		return reflect.DeepEqual(before, after)
+	}
+}
+
+func writeFieldsMapBatches(ctx context.Context, client fieldsMapMigrationClient, table string, updates []*fieldsMapUpdate) (int64, error) {
+	if len(updates) == 0 {
+		return 0, nil
+	}
+	jobs := make(chan []*fieldsMapUpdate, (len(updates)+DynamoBatchSize-1)/DynamoBatchSize)
+	for len(updates) != 0 {
+		count := DynamoBatchSize
+		if len(updates) < count {
+			count = len(updates)
+		}
+		jobs <- updates[:count]
+		updates = updates[count:]
+	}
+	close(jobs)
+
+	workerCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var workers sync.WaitGroup
+	var firstErr error
+	var errOnce sync.Once
+	var conflictCount int64
+	var conflictMu sync.Mutex
+	workerCount := len(jobs)
+	if workerCount > maxMigrationWorkers {
+		workerCount = maxMigrationWorkers
+	}
+	for i := 0; i < workerCount; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for {
+				select {
+				case <-workerCtx.Done():
+					return
+				case batch, ok := <-jobs:
+					if !ok {
+						return
+					}
+					conflicts, err := writeFieldsMapBatch(workerCtx, client, table, batch)
+					if conflicts != 0 {
+						conflictMu.Lock()
+						conflictCount += conflicts
+						conflictMu.Unlock()
+					}
+					if err != nil {
+						errOnce.Do(func() { firstErr = err; cancel() })
+						return
+					}
+				}
+			}
+		}()
+	}
+	workers.Wait()
+	if firstErr != nil {
+		return 0, trace.Wrap(firstErr)
+	}
+	return conflictCount, trace.Wrap(ctx.Err())
+}
+
+// writeFieldsMapBatch first attempts one atomic transaction for a bounded
+// group. On transaction failure, individual conditional updates allow valid
+// rows to make progress and identify the row that caused a write error.
+func writeFieldsMapBatch(ctx context.Context, client fieldsMapMigrationClient, table string, updates []*fieldsMapUpdate) (int64, error) {
+	items := make([]*dynamodb.TransactWriteItem, 0, len(updates))
+	for _, update := range updates {
+		items = append(items, update.transactionItem(table))
+	}
+	if _, err := client.TransactWriteItemsWithContext(ctx, &dynamodb.TransactWriteItemsInput{TransactItems: items}); err == nil {
+		return 0, nil
+	} else if ctx.Err() != nil {
+		return 0, trace.Wrap(ctx.Err())
+	} else {
+		log.WithFields(log.Fields{"table": table, "batch_size": len(updates)}).WithError(err).Warn("DynamoDB FieldsMap transaction failed; retrying records individually")
+	}
+
+	var conflicts int64
+	for _, update := range updates {
+		_, err := client.UpdateItemWithContext(ctx, update.updateItemInput(table))
+		if err == nil {
+			continue
+		}
+		fields := log.Fields{
+			"table":       table,
+			"session_id":  aws.StringValue(update.key[keySessionID].S),
+			"event_index": aws.StringValue(update.key[keyEventIndex].N),
+		}
+		if awsErr, ok := err.(awserr.Error); ok && awsErr.Code() == dynamodb.ErrCodeConditionalCheckFailedException {
+			conflicts++
+			log.WithFields(fields).WithError(err).Warn("DynamoDB audit event changed or expired during FieldsMap migration")
+			continue
+		}
+		log.WithFields(fields).WithError(err).Error("Unable to write DynamoDB audit event FieldsMap")
+		return conflicts, trace.Wrap(convertError(err))
+	}
+	return conflicts, nil
+}
