+package backend
+
+import "testing"
+
+func TestFlagKey(t *testing.T) {
+	tests := []struct {
+		name  string
+		parts []string
+		want  string
+	}{
+		{name: "prefix", want: "/.flags"},
+		{name: "single part", parts: []string{"migration"}, want: "/.flags/migration"},
+		{name: "multiple parts", parts: []string{"migration", "events"}, want: "/.flags/migration/events"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := string(FlagKey(tt.parts...)); got != tt.want {
+				t.Fatalf("FlagKey(%q) = %q, want %q", tt.parts, got, tt.want)
+			}
+		})
+	}
+}
