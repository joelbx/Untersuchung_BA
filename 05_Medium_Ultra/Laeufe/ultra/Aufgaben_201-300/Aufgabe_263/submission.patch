+func TestFieldsMapMigrationResumesAfterFailedPage(t *testing.T) {
+	ctx := context.Background()
+	store, err := memory.New(memory.Config{})
+	require.NoError(t, err)
+	defer store.Close()
+	l := &Log{Config: Config{Tablename: "audit"}, backend: store}
+	first := migrationTestItem("first", "1", `{"user":"alice"}`)
+	second := migrationTestItem("second", "2", `{"user":"bob"}`)
+	cursor := map[string]*dynamodb.AttributeValue{
+		keySessionID:  first[keySessionID],
+		keyEventIndex: first[keyEventIndex],
+	}
+	var scanCalls, writeCalls int
+	client := testFieldsMapMigrationClient{
+		scan: func(input *dynamodb.ScanInput) (*dynamodb.ScanOutput, error) {
+			scanCalls++
+			require.True(t, aws.BoolValue(input.ConsistentRead))
+			require.Equal(t, "attribute_exists(#fields)", aws.StringValue(input.FilterExpression))
+			if scanCalls == 1 {
+				require.Empty(t, input.ExclusiveStartKey)
+				return &dynamodb.ScanOutput{Items: []map[string]*dynamodb.AttributeValue{first}, LastEvaluatedKey: cursor}, nil
+			}
+			require.Equal(t, cursor, input.ExclusiveStartKey)
+			return &dynamodb.ScanOutput{Items: []map[string]*dynamodb.AttributeValue{second}}, nil
+		},
+		transact: func(input *dynamodb.TransactWriteItemsInput) (*dynamodb.TransactWriteItemsOutput, error) {
+			writeCalls++
+			require.Len(t, input.TransactItems, 1)
+			if writeCalls == 2 {
+				return nil, errors.New("temporary write failure")
+			}
+			return &dynamodb.TransactWriteItemsOutput{}, nil
+		},
+		update: func(input *dynamodb.UpdateItemInput) (*dynamodb.UpdateItemOutput, error) {
+			require.Equal(t, "second", aws.StringValue(input.Key[keySessionID].S))
+			return nil, errors.New("temporary write failure")
+		},
+	}
+	require.Error(t, l.migrateFieldsMapWithClient(ctx, client))
+	require.Equal(t, 2, scanCalls)
+	state, err := l.loadFieldsMapMigrationState(ctx)
+	require.NoError(t, err)
+	require.Equal(t, cursor, state.LastEvaluatedKey)
+	require.EqualValues(t, 1, state.MigratedCount)
+	require.True(t, state.CompletedAt.IsZero())
+
+	resumedScans := 0
+	client = testFieldsMapMigrationClient{
+		scan: func(input *dynamodb.ScanInput) (*dynamodb.ScanOutput, error) {
+			resumedScans++
+			require.Equal(t, cursor, input.ExclusiveStartKey)
+			return &dynamodb.ScanOutput{Items: []map[string]*dynamodb.AttributeValue{second}}, nil
+		},
+		transact: func(input *dynamodb.TransactWriteItemsInput) (*dynamodb.TransactWriteItemsOutput, error) {
+			require.Len(t, input.TransactItems, 1)
+			return &dynamodb.TransactWriteItemsOutput{}, nil
+		},
+	}
+	require.NoError(t, l.migrateFieldsMapWithClient(ctx, client))
+	require.Equal(t, 1, resumedScans)
+	state, err = l.loadFieldsMapMigrationState(ctx)
+	require.NoError(t, err)
+	require.Empty(t, state.LastEvaluatedKey)
+	require.EqualValues(t, 2, state.MigratedCount)
+	require.False(t, state.CompletedAt.IsZero())
+}
