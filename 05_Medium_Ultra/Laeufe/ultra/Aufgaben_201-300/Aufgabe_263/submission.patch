+func TestFieldsMapRoundTrip(t *testing.T) {
+	data := []byte(`{"emptyList":[],"emptyMap":{},"emptyString":"","large":9007199254740993,"nested":{"flags":[true,null,{"n":-1.25e-4}]},"nil":null}`)
+	fields, err := fieldsMapFromJSON(data)
+	require.NoError(t, err)
+	require.Equal(t, "9007199254740993", aws.StringValue(fields["large"].N))
+	require.Equal(t, "", aws.StringValue(fields["emptyString"].S))
+	require.NotNil(t, fields["emptyMap"].M)
+	require.NotNil(t, fields["emptyList"].L)
+	require.NotNil(t, fields["nested"].M)
+
+	restored, err := fieldsMapToJSON(fields)
+	require.NoError(t, err)
+	require.Equal(t, string(data), string(restored))
+
+	_, err = fieldsMapFromJSON([]byte(`{"field":1} {"other":2}`))
+	require.Error(t, err)
+	_, err = fieldsMapFromJSON([]byte(`null`))
+	require.Error(t, err)
+}
+
+func TestEventFieldsFormats(t *testing.T) {
+	fieldsMap, err := fieldsMapFromJSON([]byte(`{"empty":"","number":9007199254740993}`))
+	require.NoError(t, err)
+	original := event{
+		SessionID:     "session",
+		EventIndex:    1,
+		FieldsMap:     fieldsMap,
+		CreatedAtDate: "2021-04-10",
+	}
+	item, err := marshalEvent(original)
+	require.NoError(t, err)
+	require.NotContains(t, item, "Fields")
+	require.NotNil(t, item[keyFieldsMap].M)
+	decoded, err := unmarshalEvent(item)
+	require.NoError(t, err)
+	data, err := decoded.fieldsJSON()
+	require.NoError(t, err)
+	require.Equal(t, `{"empty":"","number":9007199254740993}`, string(data))
+
+	legacy := original
+	legacy.FieldsMap = nil
+	legacy.Fields = `{"number":1}`
+	legacyItem, err := dynamodbattribute.MarshalMap(legacy)
+	require.NoError(t, err)
+	decodedLegacy, err := unmarshalEvent(legacyItem)
+	require.NoError(t, err)
+	data, err = decodedLegacy.fieldsJSON()
+	require.NoError(t, err)
+	require.Equal(t, legacy.Fields, string(data))
+
+	// A map added during migration takes precedence if a read sees both formats.
+	legacyItem[keyFieldsMap] = item[keyFieldsMap]
+	decodedBoth, err := unmarshalEvent(legacyItem)
+	require.NoError(t, err)
+	data, err = decodedBoth.fieldsJSON()
+	require.NoError(t, err)
+	require.Equal(t, `{"empty":"","number":9007199254740993}`, string(data))
+
+	// A partially converted row stays readable while its malformed map is repaired.
+	legacyItem[keyFieldsMap] = &dynamodb.AttributeValue{S: aws.String("invalid map")}
+	decodedMalformed, err := unmarshalEvent(legacyItem)
+	require.NoError(t, err)
+	data, err = decodedMalformed.fieldsJSON()
+	require.NoError(t, err)
+	require.Equal(t, legacy.Fields, string(data))
+	legacyItem[keyFieldsMap] = &dynamodb.AttributeValue{M: map[string]*dynamodb.AttributeValue{
+		"invalid": {B: []byte("binary is not JSON")},
+	}}
+	decodedMalformed, err = unmarshalEvent(legacyItem)
+	require.NoError(t, err)
+	data, err = decodedMalformed.fieldsJSON()
+	require.NoError(t, err)
+	require.Equal(t, legacy.Fields, string(data))
+
+	legacyKey, err := getSubPageCheckpoint(&decodedLegacy)
+	require.NoError(t, err)
+	mapKey, err := getSubPageCheckpoint(&decoded)
+	require.NoError(t, err)
+	require.Equal(t, legacyKey, mapKey)
+
+	migrated := decoded
+	migrated.LegacyEventKey = legacySubPageCheckpoint(&decodedLegacy)
+	require.NotEmpty(t, migrated.LegacyEventKey)
+	require.Equal(t, migrated.LegacyEventKey, legacySubPageCheckpoint(&migrated))
+}
