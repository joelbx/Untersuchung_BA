+func TestFieldsMapMigrationSkipsConcurrentChangeAndRetries(t *testing.T) {
+	ctx := context.Background()
+	store, err := memory.New(memory.Config{})
+	require.NoError(t, err)
+	defer store.Close()
+	l := &Log{Config: Config{Tablename: "audit"}, backend: store}
+	changed := migrationTestItem("changed", "1", `{"user":"old"}`)
+	stable := migrationTestItem("stable", "2", `{"user":"alice"}`)
+	var updated []string
+	client := testFieldsMapMigrationClient{
+		scan: func(*dynamodb.ScanInput) (*dynamodb.ScanOutput, error) {
+			return &dynamodb.ScanOutput{Items: []map[string]*dynamodb.AttributeValue{changed, stable}}, nil
+		},
+		transact: func(input *dynamodb.TransactWriteItemsInput) (*dynamodb.TransactWriteItemsOutput, error) {
+			require.Len(t, input.TransactItems, 2)
+			for _, item := range input.TransactItems {
+				require.Equal(t, "#fields = :legacyFields", aws.StringValue(item.Update.ConditionExpression))
+			}
+			return nil, awserr.New(dynamodb.ErrCodeTransactionCanceledException, "one event changed", nil)
+		},
+		update: func(input *dynamodb.UpdateItemInput) (*dynamodb.UpdateItemOutput, error) {
+			session := aws.StringValue(input.Key[keySessionID].S)
+			require.Equal(t, "#fields = :legacyFields", aws.StringValue(input.ConditionExpression))
+			updated = append(updated, session)
+			if session == "changed" {
+				return nil, awserr.New(dynamodb.ErrCodeConditionalCheckFailedException, "event changed", nil)
+			}
+			return &dynamodb.UpdateItemOutput{}, nil
+		},
+	}
+	err = l.migrateFieldsMapWithClient(ctx, client)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "1 concurrently changed")
+	require.Equal(t, []string{"changed", "stable"}, updated)
+	state, err := l.loadFieldsMapMigrationState(ctx)
+	require.NoError(t, err)
+	require.Empty(t, state.LastEvaluatedKey)
+	require.True(t, state.CompletedAt.IsZero())
+
+	// The next pass sees the current version of the changed event.
+	current := migrationTestItem("changed", "1", `{"user":"new"}`)
+	client.scan = func(input *dynamodb.ScanInput) (*dynamodb.ScanOutput, error) {
+		require.Empty(t, input.ExclusiveStartKey)
+		return &dynamodb.ScanOutput{Items: []map[string]*dynamodb.AttributeValue{current}}, nil
+	}
+	client.transact = func(input *dynamodb.TransactWriteItemsInput) (*dynamodb.TransactWriteItemsOutput, error) {
+		require.Len(t, input.TransactItems, 1)
+		require.Equal(t, `{"user":"new"}`, aws.StringValue(input.TransactItems[0].Update.ExpressionAttributeValues[":legacyFields"].S))
+		return &dynamodb.TransactWriteItemsOutput{}, nil
+	}
+	require.NoError(t, l.migrateFieldsMapWithClient(ctx, client))
+}
