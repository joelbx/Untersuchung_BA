+func TestValidateFieldsMapContentUsesJSONNumberSemantics(t *testing.T) {
+	require.NoError(t, validateFieldsMapContent([]byte(`{"number":1.0,"nested":[-0,2e1]}`), []byte(`{"nested":[0,20],"number":1}`)))
+	require.Error(t, validateFieldsMapContent([]byte(`{"number":9007199254740993}`), []byte(`{"number":9007199254740992}`)))
+	require.Error(t, validateFieldsMapContent([]byte(`{"number":"1"}`), []byte(`{"number":1}`)))
+}
