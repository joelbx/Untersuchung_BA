+func TestFieldsMapMigrationBoundsTransactions(t *testing.T) {
+	updates := make([]*fieldsMapUpdate, DynamoBatchSize+1)
+	for index := range updates {
+		updates[index] = &fieldsMapUpdate{
+			key: map[string]*dynamodb.AttributeValue{
+				keySessionID:  {S: aws.String("session")},
+				keyEventIndex: {N: aws.String(strconv.Itoa(index))},
+			},
+			legacyFields: `{}`,
+			fieldsMap:    map[string]*dynamodb.AttributeValue{},
+			legacyKey:    "hash",
+		}
+	}
+	var sizes []int
+	var mu sync.Mutex
+	client := testFieldsMapMigrationClient{
+		transact: func(input *dynamodb.TransactWriteItemsInput) (*dynamodb.TransactWriteItemsOutput, error) {
+			mu.Lock()
+			sizes = append(sizes, len(input.TransactItems))
+			mu.Unlock()
+			return &dynamodb.TransactWriteItemsOutput{}, nil
+		},
+	}
+	conflicts, err := writeFieldsMapBatches(context.Background(), client, "audit", updates)
+	require.NoError(t, err)
+	require.Zero(t, conflicts)
+	sort.Ints(sizes)
+	require.Equal(t, []int{1, DynamoBatchSize}, sizes)
+}
