+
+func migrationTestItem(session string, index string, fields string) map[string]*dynamodb.AttributeValue {
+	return map[string]*dynamodb.AttributeValue{
+		keySessionID:    {S: aws.String(session)},
+		keyEventIndex:   {N: aws.String(index)},
+		"EventType":     {S: aws.String("test.event")},
+		"Fields":        {S: aws.String(fields)},
+		"OtherMetadata": {BOOL: aws.Bool(true)},
+	}
+}
+
+func TestFieldsMapMigrationRequestPreservesEvent(t *testing.T) {
+	fields := `{"user":"alice","empty":"","nested":{"roles":[],"settings":{}},"large":9007199254740993,"nil":null}`
+	item := migrationTestItem("session", "1", fields)
+	legacy, err := unmarshalEvent(item)
+	require.NoError(t, err)
+	legacyKey := legacySubPageCheckpoint(&legacy)
+	update, err := fieldsMapMigrationUpdate(item)
+	require.NoError(t, err)
+
+	input := update.updateItemInput("audit")
+	require.Equal(t, "SET #fieldsMap = :fieldsMap, #legacyKey = :legacyKey REMOVE #fields", aws.StringValue(input.UpdateExpression))
+	require.Equal(t, "#fields = :legacyFields", aws.StringValue(input.ConditionExpression))
+	require.Equal(t, item[keySessionID], input.Key[keySessionID])
+	require.Equal(t, item[keyEventIndex], input.Key[keyEventIndex])
+	require.Equal(t, fields, aws.StringValue(input.ExpressionAttributeValues[":legacyFields"].S))
+	require.NotNil(t, item["Fields"], "conversion must not mutate the scanned item")
+	require.Equal(t, legacyKey, aws.StringValue(input.ExpressionAttributeValues[":legacyKey"].S))
+	converted := input.ExpressionAttributeValues[":fieldsMap"].M
+	require.NotNil(t, converted)
+	require.Equal(t, "9007199254740993", aws.StringValue(converted["large"].N))
+	require.Equal(t, "", aws.StringValue(converted["empty"].S))
+	require.NotNil(t, converted["nested"].M["roles"].L)
+	require.NotNil(t, converted["nested"].M["settings"].M)
+}
