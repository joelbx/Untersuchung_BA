new file mode 100644
index 0000000..418fb20
--- /dev/null
+++ b/internal/version/major.go
@@ -0,0 +1,15 @@
+package version
+
+import "strings"
+
+// Major returns the part of a version before its first period, ignoring an
+// optional epoch prefix.
+func Major(value string) string {
+	if colon := strings.IndexByte(value, ':'); colon >= 0 {
+		value = value[colon+1:]
+	}
+	if period := strings.IndexByte(value, '.'); period >= 0 {
+		return value[:period]
+	}
+	return value
+}
