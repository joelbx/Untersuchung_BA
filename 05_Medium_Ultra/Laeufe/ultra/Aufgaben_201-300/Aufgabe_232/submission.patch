+package scan
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func eolTestDate(t *testing.T, value string) time.Time {
+	t.Helper()
+	date, err := time.Parse("2006-01-02", value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return date
+}
+
+func TestEOLWarnings(t *testing.T) {
+	const standardEnded = "Standard OS support is EOL(End-of-Life). Purchase extended support if available or Upgrading your OS is strongly recommended."
+	const extendedEnded = "Extended support is also EOL. There are many Vulnerabilities that are not detected, Upgrading your OS strongly recommended."
+
+	tests := []struct {
+		name, family, release, now string
+		want                       []string
+	}{
+		{
+			name:   "fully EOL",
+			family: config.Ubuntu, release: "14.10", now: "2015-07-31",
+			want: []string{standardEnded, extendedEnded},
+		},
+		{
+			name:   "extended support available",
+			family: config.Ubuntu, release: "18.04", now: "2024-01-01",
+			want: []string{standardEnded, "Extended support available until 2028-04-30. Check the vendor site."},
+		},
+		{
+			name:   "Red Hat point release uses major lifecycle",
+			family: config.RedHat, release: "7.9", now: "2024-07-01",
+			want: []string{standardEnded},
+		},
+		{
+			name:   "Alpine patch release uses minor lifecycle",
+			family: config.Alpine, release: "3.10.4", now: "2021-05-30",
+			want: []string{"Standard OS support will be end in 3 months. EOL date: 2021-05-30"},
+		},
+		{
+			name:   "standard support ends in exactly three months",
+			family: config.FreeBSD, release: "11.4-RELEASE-p1", now: "2021-06-30",
+			want: []string{"Standard OS support will be end in 3 months. EOL date: 2021-09-30"},
+		},
+		{
+			name:   "standard support ends beyond three months",
+			family: config.FreeBSD, release: "11.4-RELEASE-p1", now: "2021-06-29",
+		},
+		{
+			name:   "support end date is inclusive",
+			family: config.Ubuntu, release: "14.10", now: "2015-07-30",
+			want: []string{"Standard OS support will be end in 3 months. EOL date: 2015-07-30"},
+		},
+		{
+			name:   "Amazon Linux 1 single-token release",
+			family: config.Amazon, release: "2018.03", now: "2023-07-01",
+			want: []string{standardEnded, extendedEnded},
+		},
+		{
+			name:   "no extended support",
+			family: config.Amazon, release: "2 (Karoo)", now: "2025-07-01",
+			want: []string{standardEnded},
+		},
+		{
+			name:   "unknown normalized release",
+			family: config.RedHat, release: "9.1", now: "2026-01-01",
+			want: []string{"Failed to check EOL. Register the issue to https://github.com/future-architect/vuls/issues with the information in 'Family: redhat Release: 9.1'"},
+		},
+		{
+			name:   "pseudo excluded",
+			family: config.ServerTypePseudo, release: "", now: "2026-01-01",
+		},
+		{
+			name:   "raspbian excluded",
+			family: config.Raspbian, release: "11", now: "2026-01-01",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := eolWarnings(tt.family, tt.release, eolTestDate(t, tt.now))
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("eolWarnings(%q, %q, %q) = %#v, want %#v", tt.family, tt.release, tt.now, got, tt.want)
+			}
+		})
+	}
+}
