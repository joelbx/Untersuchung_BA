@@ -0,0 +1,120 @@
+package config
+
+import "time"
+
+// OS families used throughout the scanner.
+const (
+	RedHat                = "redhat"
+	Debian                = "debian"
+	Ubuntu                = "ubuntu"
+	CentOS                = "centos"
+	Fedora                = "fedora"
+	Amazon                = "amazon"
+	Oracle                = "oracle"
+	FreeBSD               = "freebsd"
+	Raspbian              = "raspbian"
+	Windows               = "windows"
+	OpenSUSE              = "opensuse"
+	OpenSUSELeap          = "opensuse.leap"
+	SUSEEnterpriseServer  = "suse.linux.enterprise.server"
+	SUSEEnterpriseDesktop = "suse.linux.enterprise.desktop"
+	SUSEOpenstackCloud    = "suse.openstack.cloud"
+	Alpine                = "alpine"
+
+	// ServerTypePseudo is used for ServerInfo.Type and synthetic scan results.
+	ServerTypePseudo = "pseudo"
+)
+
+// EOL contains the support end dates for an OS release. Ended may explicitly
+// mark a release as out of standard support when no date is available.
+type EOL struct {
+	StandardSupportUntil time.Time
+	ExtendedSupportUntil time.Time
+	Ended                bool
+}
+
+// IsStandardSupportEnded reports whether standard support is over at now.
+// A release remains supported on its end date.
+func (e EOL) IsStandardSupportEnded(now time.Time) bool {
+	if e.StandardSupportUntil.IsZero() {
+		return e.Ended
+	}
+	return now.After(e.StandardSupportUntil)
+}
+
+// IsExtendedSuppportEnded reports whether extended support is over at now.
+// A zero date means that extended support is not applicable.
+func (e EOL) IsExtendedSuppportEnded(now time.Time) bool {
+	return !e.ExtendedSupportUntil.IsZero() && now.After(e.ExtendedSupportUntil)
+}
+
+// GetEOL returns lifecycle data for an exact OS family and release identifier.
+// The caller should use the release identifier appropriate for that family.
+func GetEOL(family string, release string) (EOL, bool) {
+	releases, ok := eolByFamily[family]
+	if !ok {
+		return EOL{}, false
+	}
+	eol, ok := releases[release]
+	return eol, ok
+}
+
+var eolByFamily = map[string]map[string]EOL{
+	Amazon: {
+		"2018.03":   eolDates("2023-06-30", "2023-06-30"),
+		"2 (Karoo)": eolDates("2025-06-30", ""),
+	},
+	RedHat: {
+		"7": eolDates("2024-06-30", ""),
+		"8": eolDates("2029-05-31", ""),
+		"6": eolDates("2020-11-30", "2024-06-30"),
+	},
+	CentOS: {
+		"7": eolDates("2024-06-30", ""),
+		"8": eolDates("2021-12-31", ""),
+		"6": eolDates("2020-11-30", "2020-11-30"),
+	},
+	Oracle: {
+		"7": eolDates("2024-06-30", ""),
+		"8": eolDates("2029-05-31", ""),
+		"6": eolDates("2021-03-31", "2022-03-31"),
+	},
+	Ubuntu: {
+		"18.04": eolDates("2023-05-31", "2028-04-30"),
+		"14.04": eolDates("2019-04-30", "2024-04-30"),
+		"14.10": eolDates("2015-07-30", "2015-07-30"),
+		"21.04": eolDates("2022-01-30", ""),
+	},
+	Debian: {
+		"9":  eolDates("2022-06-30", ""),
+		"10": eolDates("2024-06-30", ""),
+		"8":  eolDates("2020-06-30", "2020-06-30"),
+	},
+	Alpine: {
+		"3.10": eolDates("2021-05-30", ""),
+		"3.11": eolDates("2021-11-30", ""),
+		"3.12": eolDates("2022-05-30", ""),
+		"3.9":  eolDates("2020-11-30", "2020-11-30"),
+	},
+	FreeBSD: {
+		"11": eolDates("2021-09-30", "2021-09-30"),
+		"12": eolDates("2023-12-31", ""),
+		"10": eolDates("2019-10-30", "2019-10-30"),
+	},
+}
+
+func eolDates(standard, extended string) EOL {
+	eol := EOL{StandardSupportUntil: mustParseEOLDate(standard)}
+	if extended != "" {
+		eol.ExtendedSupportUntil = mustParseEOLDate(extended)
+	}
+	return eol
+}
+
+func mustParseEOLDate(value string) time.Time {
+	date, err := time.Parse("2006-01-02", value)
+	if err != nil {
+		panic(err)
+	}
+	return date
+}
diff --git a/config/os_test.go b/config/os_test.go
new file mode 100644
index 0000000..659ccb5
--- /dev/null
+++ b/config/os_test.go
@@ -0,0 +1,60 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestEOLSupportEndBoundaries(t *testing.T) {
+	eol, found := GetEOL(Ubuntu, "18.04")
+	if !found {
+		t.Fatal("Ubuntu 18.04 EOL data was not found")
+	}
+
+	standardEnd := time.Date(2023, time.May, 31, 0, 0, 0, 0, time.UTC)
+	if !eol.StandardSupportUntil.Equal(standardEnd) {
+		t.Fatalf("standard support ends on %s, want %s", eol.StandardSupportUntil, standardEnd)
+	}
+	if eol.IsStandardSupportEnded(standardEnd) {
+		t.Fatal("standard support must remain active at its exact end time")
+	}
+	if !eol.IsStandardSupportEnded(standardEnd.Add(time.Nanosecond)) {
+		t.Fatal("standard support must end strictly after its end time")
+	}
+	if (EOL{StandardSupportUntil: standardEnd, Ended: true}).IsStandardSupportEnded(standardEnd) {
+		t.Fatal("a dated phase must use the strict date boundary")
+	}
+
+	extendedEnd := time.Date(2028, time.April, 30, 0, 0, 0, 0, time.UTC)
+	if !eol.ExtendedSupportUntil.Equal(extendedEnd) {
+		t.Fatalf("extended support ends on %s, want %s", eol.ExtendedSupportUntil, extendedEnd)
+	}
+	if eol.IsExtendedSuppportEnded(extendedEnd) {
+		t.Fatal("extended support must remain active at its exact end time")
+	}
+	if !eol.IsExtendedSuppportEnded(extendedEnd.Add(time.Nanosecond)) {
+		t.Fatal("extended support must end strictly after its end time")
+	}
+
+	noExtended, found := GetEOL(Ubuntu, "21.04")
+	if !found || noExtended.IsExtendedSuppportEnded(extendedEnd.AddDate(10, 0, 0)) {
+		t.Fatal("an omitted extended support date must not be treated as ended")
+	}
+}
+
+func TestGetEOLExactReleaseKeys(t *testing.T) {
+	first, found := GetEOL(Amazon, "2018.03")
+	if !found || first.ExtendedSupportUntil.IsZero() {
+		t.Fatal("Amazon Linux 1 must have its own EOL record")
+	}
+	second, found := GetEOL(Amazon, "2 (Karoo)")
+	if !found || !second.ExtendedSupportUntil.IsZero() {
+		t.Fatal("Amazon Linux 2 must have a distinct EOL record")
+	}
+	if _, found := GetEOL(Amazon, "2"); found {
+		t.Fatal("unlisted Amazon release must not match")
+	}
+	if _, found := GetEOL(RedHat, "9"); found {
+		t.Fatal("unlisted Red Hat release must not match")
+	}
+}
