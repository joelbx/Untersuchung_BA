@@ -0,0 +1,97 @@
+import { MemoryRouter, Route, useLocation } from 'react-router-dom';
+
+import { render, screen, waitFor } from '@testing-library/react';
+
+import { ActiveShareProvider, useActiveShare } from '../hooks/drive/useActiveShare';
+import FolderContainer from './FolderContainer';
+
+const mockGetShare = jest.fn();
+const mockStartSubscription = jest.fn(() => Promise.resolve());
+const mockPauseSubscription = jest.fn();
+
+jest.mock('@proton/components', () => ({
+    useAppTitle: jest.fn(),
+    generateUID: jest.fn(() => 'navigation-event'),
+}));
+
+jest.mock('../components/sections/Drive/DriveView', () => () => null);
+jest.mock('./PreviewContainer', () => () => null);
+jest.mock('../hooks/drive/useFolderContainerTitle', () => ({ useFolderContainerTitle: jest.fn() }));
+
+jest.mock('../store', () => ({
+    useDefaultShare: jest.requireActual('../store/_shares/useDefaultShare').default,
+    useDriveEventManager: () => ({
+        shares: {
+            startSubscription: mockStartSubscription,
+            pauseSubscription: mockPauseSubscription,
+        },
+    }),
+}));
+
+jest.mock('../store/_api', () => ({
+    useDebouncedRequest: () => jest.fn(),
+    shareMetaShortToShare: (share: unknown) => share,
+}));
+jest.mock('../store/_utils', () => ({
+    useDebouncedFunction: () => (callback: (signal: AbortSignal) => unknown) => callback(new AbortController().signal),
+}));
+jest.mock('../store/_shares/useShare', () => () => ({
+    getShare: mockGetShare,
+    getShareWithKey: jest.fn(),
+}));
+jest.mock('../store/_shares/useSharesState', () => () => ({
+    getDefaultShareId: jest.fn(),
+    setShares: jest.fn(),
+}));
+jest.mock('../store/_shares/useVolume', () => () => ({ createVolume: jest.fn() }));
+
+const RouteState = () => {
+    const { pathname } = useLocation();
+    const { activeFolder } = useActiveShare();
+    return (
+        <>
+            <div data-testid="location">{pathname}</div>
+            <div data-testid="active-folder">{`${activeFolder.shareId}/${activeFolder.linkId}`}</div>
+        </>
+    );
+};
+
+const renderFolderUrl = () =>
+    render(
+        <MemoryRouter initialEntries={['/shared/folder/child']}>
+            <ActiveShareProvider defaultShareRoot={{ shareId: 'default', linkId: 'root' }}>
+                <RouteState />
+                <Route path="/:shareId?/:type/:linkId?" component={FolderContainer} />
+            </ActiveShareProvider>
+        </MemoryRouter>
+    );
+
+describe('FolderContainer share availability', () => {
+    beforeEach(() => {
+        jest.clearAllMocks();
+        Object.defineProperty(globalThis, 'reportError', { value: jest.fn(), configurable: true });
+    });
+
+    it('selects the folder when its share is available', async () => {
+        mockGetShare.mockResolvedValue({ isLocked: false, isVolumeSoftDeleted: false });
+
+        renderFolderUrl();
+
+        await waitFor(() => expect(screen.getByTestId('active-folder').textContent).toBe('shared/child'));
+        expect(screen.getByTestId('location').textContent).toBe('/shared/folder/child');
+        expect(mockGetShare).toHaveBeenCalledWith(expect.any(AbortSignal), 'shared');
+    });
+
+    it.each([
+        ['locked', { isLocked: true, isVolumeSoftDeleted: false }],
+        ['soft-deleted', { isLocked: false, isVolumeSoftDeleted: true }],
+    ])('redirects a %s share to root without selecting its folder', async (_state, share) => {
+        mockGetShare.mockResolvedValue(share);
+
+        renderFolderUrl();
+
+        await waitFor(() => expect(screen.getByTestId('location').textContent).toBe('/'));
+        expect(screen.getByTestId('active-folder').textContent).toBe('default/root');
+        expect(mockGetShare).toHaveBeenCalledWith(expect.any(AbortSignal), 'shared');
+    });
+});
