+@pytest.mark.parametrize('status', [400, 404, 501, 503])
+def test_http_error_fails_without_retry(module, mocker, status):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         return_value=fetch_response(status))
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+
+    with pytest.raises(HTTPError):
+        module.request('resource', method='GET')
+
+    assert module.status == status
+    assert fetch.call_count == 1
+    sleep.assert_not_called()
+
+
+def test_rate_limit_retries_then_succeeds(module, mocker, capsys):
+    fetch = mocker.patch('ansible.module_utils.network.meraki.meraki.fetch_url',
+                         side_effect=[fetch_response(429), fetch_response(429), fetch_response(200)])
+    sleep = mocker.patch('ansible.module_utils.network.meraki.meraki.time.sleep')
+    payload = to_bytes('{"name": "updated"}')
+
+    assert module.request('resource', method='PUT', payload=payload) == {'ok': True}
+
+    assert module.status == 200
+    assert fetch.call_count == 3
+    assert sleep.call_count == 2
+    for call in fetch.call_args_list:
+        assert call[1]['method'] == 'PUT'
+        assert call[1]['data'] == payload
+    with pytest.raises(SystemExit) as result:
+        module.exit_json()
+    assert result.value.code == 0
+    task_output = json.loads(capsys.readouterr().out)
+    warnings = ' '.join(warning.lower() for warning in task_output['warnings'])
+    assert task_output['status'] == 200
+    assert 'rate limit' in warnings
+    assert 'retr' in warnings
+    assert re.search(r'\b2\b', warnings)
+
+
