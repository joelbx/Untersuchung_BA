+def fetch_response(status):
+    info = {'status': status,
+            'msg': 'HTTP {0}'.format(status),
+            'url': 'https://api.meraki.com/api/v0/resource',
+            }
+    if status >= 400:
+        info['body'] = to_bytes('{"errors": ["request failed"]}')
+        return None, info
+    response = mock.Mock()
+    response.read.return_value = to_bytes('{"ok": true}')
+    return response, info
+
