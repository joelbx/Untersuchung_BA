 """py.test tests for addbook"""
+import pytest
 import web
 from .. import addbook
 from openlibrary import accounts
@@ -21,6 +22,53 @@ def mock_user():
     )()
 
 
+@pytest.mark.parametrize(
+    "author_fields",
+    [
+        {},
+        {"author_key": ["OL1A"]},
+        {"author_name": ["An Author"]},
+    ],
+)
+def test_make_work_without_paired_authors(author_fields):
+    web.ctx.site = MockSite()
+    doc = {"key": "OL1W", "title": "A Work", **author_fields}
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert work == {
+        **doc,
+        "authors": [],
+        "cover_url": "/images/icons/avatar_book-sm.png",
+        "ia": [],
+        "first_publish_year": None,
+    }
+
+
+def test_make_work_creates_authors_and_preserves_metadata():
+    web.ctx.site = MockSite()
+    doc = {
+        "key": "OL1W",
+        "title": "A Work",
+        "author_key": ["OL1A", "OL2A"],
+        "author_name": ["First Author", "Second Author"],
+        "cover_url": "/custom/cover.jpg",
+        "ia": ["archive-id"],
+        "first_publish_year": 2001,
+    }
+
+    work = addbook.make_work(doc)
+
+    assert isinstance(work, web.Storage)
+    assert all(work[field] == value for field, value in doc.items())
+    assert [author.key for author in work.authors] == ["/authors/OL1A", "/authors/OL2A"]
+    assert [author.name for author in work.authors] == [
+        "First Author",
+        "Second Author",
+    ]
+
+
 class TestSaveBookHelper:
     def setup_method(self, method):
         web.ctx.site = MockSite()
