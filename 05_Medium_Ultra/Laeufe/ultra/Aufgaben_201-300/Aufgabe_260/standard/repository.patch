-func injectLogger(next http.Handler) http.Handler {
+const clientUniqueIDCookieName = "nd-client-unique-id"
+
+func clientUniqueID(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		clientUniqueID, present := "", false
+		if values, ok := r.Header[http.CanonicalHeaderKey(consts.UIClientUniqueIDHeader)]; ok {
+			present = true
+			if len(values) > 0 {
+				clientUniqueID = values[0]
+			}
+			http.SetCookie(w, &http.Cookie{
+				Name:     clientUniqueIDCookieName,
+				Value:    clientUniqueID,
+				Path:     "/",
+				MaxAge:   consts.CookieExpiry,
+				HttpOnly: true,
+			})
+		} else if cookie, err := r.Cookie(clientUniqueIDCookieName); err == nil {
+			clientUniqueID = cookie.Value
+			present = true
+		}
+		if present {
+			r = r.WithContext(request.WithClientUniqueId(r.Context(), clientUniqueID))
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func injectLogContext(next http.Handler) http.Handler {
 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 		ctx := r.Context()
-		ctx = log.NewContext(r.Context(), "requestId", ctx.Value(middleware.RequestIDKey))
+		logArgs := []interface{}{"requestId", middleware.GetReqID(ctx)}
+		if clientUniqueID, ok := request.ClientUniqueIdFrom(ctx); ok {
+			logArgs = append(logArgs, "clientUniqueId", clientUniqueID)
+		}
+		ctx = log.NewContext(ctx, logArgs...)
 		next.ServeHTTP(w, r.WithContext(ctx))
 	})
 }
