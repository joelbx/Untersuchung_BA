diff --git a/server/events/sse_test.go b/server/events/sse_test.go
new file mode 100644
index 0000000..4e1cb17
--- /dev/null
+++ b/server/events/sse_test.go
@@ -0,0 +1,51 @@
+package events
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("SSE delivery", func() {
+	var b *broker
+	var origin, sameUser, otherUser client
+
+	BeforeEach(func() {
+		b = &broker{}
+		origin = client{clientUniqueId: "origin", username: "alice"}
+		sameUser = client{clientUniqueId: "another", username: "alice"}
+		otherUser = client{clientUniqueId: "elsewhere", username: "bob"}
+	})
+
+	It("delivers user events only to other clients of the same user", func() {
+		ctx := request.WithClientUniqueId(context.Background(), "origin")
+		ctx = request.WithUser(ctx, model.User{UserName: "alice"})
+		msg := b.prepareMessage(ctx, &RefreshResource{})
+
+		Expect(msg.shouldSendTo(origin)).To(BeFalse())
+		Expect(msg.shouldSendTo(sameUser)).To(BeTrue())
+		Expect(msg.shouldSendTo(otherUser)).To(BeFalse())
+	})
+
+	It("uses the Subsonic username to limit delivery", func() {
+		ctx := request.WithClientUniqueId(context.Background(), "origin")
+		ctx = request.WithUsername(ctx, "alice")
+		msg := b.prepareMessage(ctx, &RefreshResource{})
+
+		Expect(msg.shouldSendTo(origin)).To(BeFalse())
+		Expect(msg.shouldSendTo(sameUser)).To(BeTrue())
+		Expect(msg.shouldSendTo(otherUser)).To(BeFalse())
+	})
+
+	It("broadcasts events without a sender client ID even when a username is present", func() {
+		ctx := request.WithUsername(context.Background(), "alice")
+		msg := b.prepareMessage(ctx, &RefreshResource{})
+
+		Expect(msg.shouldSendTo(origin)).To(BeTrue())
+		Expect(msg.shouldSendTo(sameUser)).To(BeTrue())
+		Expect(msg.shouldSendTo(otherUser)).To(BeTrue())
+	})
+})
