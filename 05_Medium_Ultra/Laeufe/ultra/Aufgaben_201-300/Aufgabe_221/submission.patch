+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards"
+    encoding = "json"
+
+    def POST(self, work_id):
+        from openlibrary.core.bestbook import Bestbook
+
+        def response(data):
+            return delegate.RawText(json.dumps(data), content_type="application/json")
+
+        user = accounts.get_current_user()
+        if not user:
+            return response({'errors': 'Authentication failed'})
+
+        content_type = getattr(web.ctx, 'env', {}).get('CONTENT_TYPE', '')
+        if content_type.split(';', 1)[0].lower() == 'application/json':
+            try:
+                i = json.loads(web.data())
+            except (TypeError, ValueError):
+                return response({'errors': 'Invalid JSON body'})
+            if not isinstance(i, dict):
+                return response({'errors': 'Invalid JSON body'})
+        else:
+            i = web.input(op=None, topic=None, comment='', edition_key=None)
+
+        op = i.get('op')
+        if op not in ('add', 'remove', 'update'):
+            return response({'errors': 'Invalid operation'})
+
+        username = user.key.split('/')[2]
+        if op == 'remove':
+            rows = Bestbook.remove(username=username, work_id=work_id)
+            return response({'success': True, 'rows': rows})
+
+        topic = i.get('topic')
+        topic = topic.strip() if isinstance(topic, str) else None
+        if not topic:
+            return response({'errors': 'Topic is required'})
+
+        comment = i.get('comment')
+        if comment is None:
+            comment = ''
+        if not isinstance(comment, str):
+            return response({'errors': 'Invalid comment'})
+
+        edition_id = None
+        edition_key = i.get('edition_key')
+        if edition_key not in (None, ''):
+            if not isinstance(edition_key, str) or not re.fullmatch(
+                r'(?:/books/)?OL(\d+)M', edition_key
+            ):
+                return response({'errors': 'Invalid edition key'})
+            edition_id = int(extract_numeric_id_from_olid(edition_key))
+
+        try:
+            action = Bestbook.add if op == 'add' else Bestbook.update
+            award = action(
+                username=username,
+                work_id=work_id,
+                topic=topic,
+                comment=comment,
+                edition_id=edition_id,
+            )
+        except Bestbook.AwardConditionsError as exc:
+            return response({'errors': str(exc)})
+
+        return response({'success': True, 'award': award})
+
+
+class bestbook_count(delegate.page):
+    path = r"/awards/count"
+    encoding = "json"
+
+    def GET(self):
+        from openlibrary.core.bestbook import Bestbook
+
+        i = web.input(work_id=None, username=None, topic=None)
+        work_id = i.work_id or None
+        if work_id is not None:
+            match = re.fullmatch(r'(?:/works/)?OL(\d+)W|(\d+)', str(work_id))
+            if not match:
+                return delegate.RawText(
+                    json.dumps({'errors': 'Invalid work ID'}),
+                    content_type="application/json",
+                )
+            work_id = match.group(1) or match.group(2)
+
+        count = Bestbook.get_count(
+            work_id=work_id, username=i.username or None, topic=i.topic or None
+        )
+        return delegate.RawText(
+            json.dumps({'count': count}), content_type="application/json"
+        )
+
