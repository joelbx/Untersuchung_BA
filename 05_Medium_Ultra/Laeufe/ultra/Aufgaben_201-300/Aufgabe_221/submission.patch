@@ -0,0 +1,151 @@
+import json
+from types import SimpleNamespace
+
+import web
+
+from infogami.utils import app as routing
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.plugins.openlibrary import api
+
+
+def test_bestbook_json_routes(monkeypatch):
+    monkeypatch.setattr(web.ctx, 'encoding', 'json', raising=False)
+    monkeypatch.setattr(web.ctx, 'path', '/works/OL123W/awards.json', raising=False)
+    assert routing.find_page() == (api.bestbook_award, ('123',))
+
+    monkeypatch.setattr(web.ctx, 'path', '/awards/count.json', raising=False)
+    assert routing.find_page() == (api.bestbook_count, ())
+
+
+def test_bestbook_award_requires_login(monkeypatch):
+    monkeypatch.setattr(api.accounts, 'get_current_user', lambda: None)
+
+    response = api.bestbook_award().POST('123')
+
+    assert json.loads(response.rawtext) == {'errors': 'Authentication failed'}
+
+
+def test_bestbook_award_add_update_and_remove(monkeypatch):
+    monkeypatch.setattr(
+        api.accounts,
+        'get_current_user',
+        lambda: SimpleNamespace(key='/people/alice'),
+    )
+    monkeypatch.setattr(web.ctx, 'env', {}, raising=False)
+    fields = {'op': 'add', 'topic': 'fiction', 'comment': 'My choice', 'edition_key': 'OL5M'}
+    monkeypatch.setattr(api.web, 'input', lambda **defaults: web.storage(fields))
+    calls = []
+    monkeypatch.setattr(Bestbook, 'add', lambda **kwargs: calls.append(('add', kwargs)) or 7)
+    monkeypatch.setattr(
+        Bestbook, 'update', lambda **kwargs: calls.append(('update', kwargs)) or 7
+    )
+    monkeypatch.setattr(
+        Bestbook, 'remove', lambda **kwargs: calls.append(('remove', kwargs)) or 1
+    )
+
+    assert json.loads(api.bestbook_award().POST('123').rawtext) == {
+        'success': True,
+        'award': 7,
+    }
+    assert calls[-1] == (
+        'add',
+        {
+            'username': 'alice',
+            'work_id': '123',
+            'topic': 'fiction',
+            'comment': 'My choice',
+            'edition_id': 5,
+        },
+    )
+
+    fields['op'] = 'update'
+    assert json.loads(api.bestbook_award().POST('123').rawtext) == {
+        'success': True,
+        'award': 7,
+    }
+    assert calls[-1][0] == 'update'
+
+    fields['op'] = 'remove'
+    assert json.loads(api.bestbook_award().POST('123').rawtext) == {
+        'success': True,
+        'rows': 1,
+    }
+    assert calls[-1] == ('remove', {'username': 'alice', 'work_id': '123'})
+
+
+def test_bestbook_award_returns_condition_errors(monkeypatch):
+    monkeypatch.setattr(
+        api.accounts,
+        'get_current_user',
+        lambda: SimpleNamespace(key='/people/alice'),
+    )
+    monkeypatch.setattr(web.ctx, 'env', {}, raising=False)
+    monkeypatch.setattr(
+        api.web,
+        'input',
+        lambda **defaults: web.storage({'op': 'add', 'topic': 'fiction'}),
+    )
+
+    def fail(**kwargs):
+        raise Bestbook.AwardConditionsError(
+            'Only books which have been marked as read may be given awards'
+        )
+
+    monkeypatch.setattr(Bestbook, 'add', fail)
+
+    assert json.loads(api.bestbook_award().POST('123').rawtext) == {
+        'errors': 'Only books which have been marked as read may be given awards'
+    }
+
+
+def test_bestbook_award_accepts_json_body(monkeypatch):
+    monkeypatch.setattr(
+        api.accounts,
+        'get_current_user',
+        lambda: SimpleNamespace(key='/people/alice'),
+    )
+    monkeypatch.setattr(web.ctx, 'env', {'CONTENT_TYPE': 'application/json'}, raising=False)
+    monkeypatch.setattr(
+        api.web, 'data', lambda: b'{"op":"add","topic":"fiction"}'
+    )
+    monkeypatch.setattr(Bestbook, 'add', lambda **kwargs: 7)
+
+    assert json.loads(api.bestbook_award().POST('123').rawtext) == {
+        'success': True,
+        'award': 7,
+    }
+
+
+def test_bestbook_award_rejects_invalid_comment(monkeypatch):
+    monkeypatch.setattr(
+        api.accounts,
+        'get_current_user',
+        lambda: SimpleNamespace(key='/people/alice'),
+    )
+    monkeypatch.setattr(web.ctx, 'env', {'CONTENT_TYPE': 'application/json'}, raising=False)
+    monkeypatch.setattr(
+        api.web, 'data', lambda: b'{"op":"add","topic":"fiction","comment":7}'
+    )
+
+    assert json.loads(api.bestbook_award().POST('123').rawtext) == {
+        'errors': 'Invalid comment'
+    }
+
+
+def test_bestbook_count_passes_filters(monkeypatch):
+    query = {'work_id': '123', 'username': 'alice', 'topic': 'fiction'}
+    monkeypatch.setattr(
+        api.web,
+        'input',
+        lambda **defaults: web.storage(query),
+    )
+    filters = []
+    monkeypatch.setattr(Bestbook, 'get_count', lambda **kwargs: filters.append(kwargs) or 2)
+
+    for work_id in ('123', 'OL123W', '/works/OL123W'):
+        query['work_id'] = work_id
+        assert json.loads(api.bestbook_count().GET().rawtext) == {'count': 2}
+
+    assert filters == [
+        {'work_id': '123', 'username': 'alice', 'topic': 'fiction'}
+    ] * 3
