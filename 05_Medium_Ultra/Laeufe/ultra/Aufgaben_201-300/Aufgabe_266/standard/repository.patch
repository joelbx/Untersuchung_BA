 from openlibrary.core import models
 
 
@@ -57,6 +59,58 @@ class TestEdition:
         e = self.mock_edition(MockPrivateEdition)
         assert not e.in_borrowable_collection()
 
+    @pytest.mark.parametrize(
+        ('status', 'requested_isbn', 'matching_field'),
+        [
+            ('staged', '9780306406157', 'isbn_13'),
+            ('pending', '0306406152', 'isbn_10'),
+        ],
+    )
+    def test_from_isbn_imports_local_item(
+        self, monkeypatch, status, requested_isbn, matching_field
+    ):
+        isbn13 = '9780306406157'
+        isbn10 = '0306406152'
+        edition_key = '/books/OL1M'
+        edition = object()
+        row = models.web.storage(
+            id=1, ia_id=f'idb:{requested_isbn}', status=status
+        )
+        finder_calls = []
+        imported_items = []
+        lookups = []
+
+        class LocalSite:
+            def things(self, query):
+                lookups.append(query)
+                if imported_items and query.get(matching_field) == (
+                    isbn13 if matching_field == 'isbn_13' else isbn10
+                ):
+                    return [edition_key]
+                return []
+
+            def get(self, key):
+                assert key == edition_key
+                return edition
+
+        def find_staged_or_pending(identifiers):
+            finder_calls.append(identifiers)
+            return [row]
+
+        monkeypatch.setattr(models.web.ctx, 'site', LocalSite(), raising=False)
+        monkeypatch.setattr(
+            models.ImportItem, 'find_staged_or_pending', find_staged_or_pending
+        )
+        monkeypatch.setattr(models, 'do_import', lambda item: imported_items.append(item))
+
+        assert models.Edition.from_isbn(requested_isbn) is edition
+        assert finder_calls == [[isbn13, isbn10]]
+        assert len(imported_items) == 1
+        assert isinstance(imported_items[0], models.ImportItem)
+        assert imported_items[0].ia_id == row.ia_id
+        assert imported_items[0].status == status
+        assert {'type': '/type/edition', 'isbn_10': isbn10} in lookups
+
 
