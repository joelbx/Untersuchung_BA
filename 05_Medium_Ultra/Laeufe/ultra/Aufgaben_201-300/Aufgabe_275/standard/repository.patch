+package httplib
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/julienschmidt/httprouter"
+)
+
+func TestHandlersWithErrorWriter(t *testing.T) {
+	tests := []struct {
+		name string
+		make func(*testing.T, StdHandlerFunc, ErrorWriter) http.HandlerFunc
+	}{
+		{
+			name: "router",
+			make: func(t *testing.T, fn StdHandlerFunc, errWriter ErrorWriter) http.HandlerFunc {
+				handler := MakeHandlerWithErrorWriter(func(w http.ResponseWriter, r *http.Request, p httprouter.Params) (interface{}, error) {
+					if p.ByName("cluster") != "test" {
+						t.Errorf("router parameters were not passed to handler: %v", p)
+					}
+					return fn(w, r)
+				}, errWriter)
+				return func(w http.ResponseWriter, r *http.Request) {
+					handler(w, r, httprouter.Params{{Key: "cluster", Value: "test"}})
+				}
+			},
+		},
+		{
+			name: "standard",
+			make: func(_ *testing.T, fn StdHandlerFunc, errWriter ErrorWriter) http.HandlerFunc {
+				return MakeStdHandlerWithErrorWriter(fn, errWriter)
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			wantErr := errors.New("handler failed")
+			writerCalled := false
+			errWriter := func(w http.ResponseWriter, err error) {
+				writerCalled = true
+				if err != wantErr {
+					t.Errorf("error writer received %v, want %v", err, wantErr)
+				}
+				http.Error(w, "custom error", http.StatusTeapot)
+			}
+			request := httptest.NewRequest(http.MethodGet, "/", nil)
+			response := httptest.NewRecorder()
+			tt.make(t, func(http.ResponseWriter, *http.Request) (interface{}, error) {
+				return nil, wantErr
+			}, errWriter)(response, request)
+			if !writerCalled || response.Code != http.StatusTeapot {
+				t.Errorf("error writer called = %v, status = %d", writerCalled, response.Code)
+			}
+			if response.Header().Get("Cache-Control") != "no-cache, no-store, must-revalidate" {
+				t.Errorf("missing no-cache header: %v", response.Header())
+			}
+
+			writerCalled = false
+			response = httptest.NewRecorder()
+			tt.make(t, func(http.ResponseWriter, *http.Request) (interface{}, error) {
+				return map[string]bool{"ok": true}, nil
+			}, errWriter)(response, request)
+			if writerCalled || response.Code != http.StatusOK {
+				t.Errorf("error writer called = %v, success status = %d", writerCalled, response.Code)
+			}
+			var payload map[string]bool
+			if err := json.Unmarshal(response.Body.Bytes(), &payload); err != nil || !payload["ok"] {
+				t.Errorf("invalid JSON response %q: %v", response.Body.String(), err)
+			}
+		})
+	}
+}
