+func Test_OCISchemas(t *testing.T) {
+	ctx := cuecontext.New()
+	cueBytes, err := os.ReadFile("flipt.schema.cue")
+	require.NoError(t, err)
+	cueSchema := ctx.CompileBytes(cueBytes)
+	require.NoError(t, cueSchema.Err())
+	ociSpec := cueSchema.LookupPath(cue.MakePath(cue.Def("#FliptSpec")))
+
+	jsonBytes, err := os.ReadFile("flipt.schema.json")
+	require.NoError(t, err)
+	jsonSchema := gojsonschema.NewBytesLoader(jsonBytes)
+
+	for _, tt := range []struct {
+		name  string
+		oci   map[string]any
+		valid bool
+	}{
+		{
+			name: "all OCI fields",
+			oci: map[string]any{
+				"repository":        "flipt://bundle:latest",
+				"bundles_directory": "/tmp/flipt-bundles",
+				"poll_interval":     "5m",
+				"authentication": map[string]any{
+					"username": "user",
+					"password": "password",
+				},
+			},
+			valid: true,
+		},
+		{
+			name:  "missing repository",
+			oci:   map[string]any{"poll_interval": "5m"},
+			valid: false,
+		},
+		{
+			name:  "invalid poll interval",
+			oci:   map[string]any{"repository": "flipt://bundle:latest", "poll_interval": "later"},
+			valid: false,
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			conf := map[string]any{"storage": map[string]any{"type": "oci", "oci": tt.oci}}
+
+			cueErr := ociSpec.Unify(ctx.Encode(conf)).Validate(cue.Concrete(true))
+			assert.Equal(t, tt.valid, cueErr == nil, "CUE schema: %v", cueErr)
+
+			jsonResult, err := gojsonschema.Validate(jsonSchema, gojsonschema.NewGoLoader(conf))
+			require.NoError(t, err)
+			assert.Equal(t, tt.valid, jsonResult.Valid(), "JSON schema: %v", jsonResult.Errors())
+		})
+	}
+}
