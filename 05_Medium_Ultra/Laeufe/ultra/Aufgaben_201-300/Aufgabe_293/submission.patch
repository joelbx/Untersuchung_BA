+func oci(ctx context.Context, client *dagger.Client, base, flipt *dagger.Container, conf testConfig) func() error {
+	flipt = flipt.
+		WithDirectory("/tmp/testdata", base.Directory(testdataDir)).
+		WithWorkdir("/tmp/testdata").
+		WithEnvVariable("FLIPT_STORAGE_TYPE", "oci").
+		WithEnvVariable("FLIPT_STORAGE_OCI_REPOSITORY", "flipt://local/testdata:latest").
+		WithEnvVariable("FLIPT_STORAGE_OCI_BUNDLES_DIRECTORY", "/tmp/bundles").
+		WithEnvVariable("FLIPT_STORAGE_OCI_AUTHENTICATION_USERNAME", "test-user").
+		WithEnvVariable("FLIPT_STORAGE_OCI_AUTHENTICATION_PASSWORD", "test-password").
+		WithEnvVariable("FLIPT_STORAGE_OCI_POLL_INTERVAL", "5m").
+		WithEnvVariable("UNIQUE", uuid.New().String()).
+		WithExec([]string{"/flipt", "bundle", "build", "testdata:latest"})
+
+	return suite(ctx, "readonly", base, flipt.WithExec(nil), conf)
+}
