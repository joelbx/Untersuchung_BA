+        assert 'ignored.txt' not in built_tar.getnames()
+        link_member = built_tar.getmember('docs/ignored_link.txt')
+        assert link_member.issym()
+        assert link_member.linkname == '../ignored.txt'
+        with pytest.raises(KeyError):
+            built_tar.extractfile(link_member)
+
+    output_path = os.path.join(os.path.dirname(collection_tar), b'output')
+    installed_path = os.path.join(output_path, b'ansible_namespace', b'collection')
+    temp_path = os.path.join(os.path.dirname(collection_tar), b'temp')
+    os.makedirs(temp_path)
+
+    req = collection.CollectionRequirement.from_tar(collection_tar, True, True)
+    req.install(to_text(output_path), temp_path)
+
+    installed_link = os.path.join(installed_path, b'docs', b'ignored_link.txt')
+    assert os.path.islink(installed_link)
+    assert os.readlink(installed_link) == b'../ignored.txt'
+    assert not os.path.exists(installed_link)
+    assert not os.path.lexists(os.path.join(installed_path, b'ignored.txt'))
+    assert os.listdir(temp_path) == []
