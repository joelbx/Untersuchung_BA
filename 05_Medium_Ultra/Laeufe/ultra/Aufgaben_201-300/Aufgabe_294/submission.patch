+def _is_child_path(path, root, link_target=None):
+    """Whether a path, or a link at that path, resolves within root."""
+    b_root_path = os.path.abspath(to_bytes(root, errors='surrogate_or_strict'))
+    b_path = os.path.abspath(to_bytes(path, errors='surrogate_or_strict'))
+    b_sep = to_bytes(os.path.sep)
+    if b_path != b_root_path and not b_path.startswith(b_root_path.rstrip(b_sep) + b_sep):
+        return False
+
+    b_root = os.path.realpath(b_root_path)
+    if link_target is not None:
+        b_path = os.path.join(os.path.dirname(b_path), to_bytes(link_target, errors='surrogate_or_strict'))
+
+    b_path = os.path.realpath(b_path)
+    return b_path == b_root or b_path.startswith(b_root.rstrip(b_sep) + b_sep)
 
 
