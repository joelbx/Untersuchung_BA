+# (c) 2019, NetApp Inc.
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import os
+import tempfile
+
+from units.compat import mock
+from units.modules.utils import AnsibleExitJson, AnsibleFailJson, ModuleTestCase, set_module_args
+from ansible.modules.storage.netapp.netapp_e_drive_firmware import NetAppESeriesDriveFirmware
+
+
+class NetAppESeriesDriveFirmwareTest(ModuleTestCase):
+    REQUIRED_PARAMS = {
+        "api_username": "rw",
+        "api_password": "password",
+        "api_url": "http://localhost/devmgr/v2",
+        "ssid": "1",
+        "firmware": ["/tmp/drive_A.dlp"],
+    }
+    REQUEST_PATH = "ansible.modules.storage.netapp.netapp_e_drive_firmware.NetAppESeriesDriveFirmware.request"
+    COMPATIBILITY_PATH = "storage-systems/1/firmware/drives"
+    STATE_PATH = "storage-systems/1/firmware/drives/state"
+
+    def _module(self, args=None):
+        module_args = self.REQUIRED_PARAMS.copy()
+        if args:
+            module_args.update(args)
+        set_module_args(module_args)
+        return NetAppESeriesDriveFirmware()
+
+    @staticmethod
+    def _detail(ref, version="1", status="online", online_capable=True):
+        return {"driveRef": ref, "firmwareVersion": version, "status": status,
+                "onlineUpgradeCapable": online_capable}
+
+    def _request(self, compat=None, details=None, states=None):
+        compat = compat if compat is not None else [
+            {"filename": "drive_A.dlp", "firmwareVersion": "2", "driveRefList": ["r1"]}]
+        details = details if details is not None else {"r1": self._detail("r1")}
+        states = states if states is not None else [{"driveRef": "r1", "status": "okay"}]
+
+        def request(path, data=None, method="GET", **kwargs):
+            if path == self.COMPATIBILITY_PATH:
+                return 200, compat
+            if path == self.STATE_PATH:
+                return 200, states
+            for ref, detail in details.items():
+                if path.endswith("/" + ref):
+                    return 200, detail
+            if method == "GET":
+                return 200, []
+            raise AssertionError("Unexpected request: %s %s" % (method, path))
+
+        return request
+
+    def test_parameters_and_defaults(self):
+        module = self._module()
+        self.assertEqual(module.firmware_list, ["/tmp/drive_A.dlp"])
+        self.assertFalse(module.wait_for_completion)
+        self.assertFalse(module.ignore_inaccessible_drives)
+        self.assertTrue(module.upgrade_drives_online)
+        self.assertFalse(module.upgrade_in_progress)
+
+    def test_upgrade_list_selects_only_supplied_basename_and_outdated_drives(self):
+        module = self._module({"firmware": ["/tmp/drive_A.dlp", "/var/lib/drive_B.dlp"]})
+        compat = [
+            {"filename": "drive_A.dlp", "firmwareVersion": "2", "driveRefList": ["r1", "r2"]},
+            {"filename": "drive_B.dlp", "firmwareVersion": "5", "driveRefList": ["r3"]},
+            {"filename": "drive_C.dlp", "firmwareVersion": "9", "driveRefList": ["r4"]},
+        ]
+        details = {"r1": self._detail("r1"),
+                   "r2": self._detail("r2", version="2"),
+                   "r3": self._detail("r3", version="4")}
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(compat, details)) as request:
+            result = module.upgrade_list()
+        self.assertEqual(result, [{"filename": "drive_A.dlp", "driveRefList": ["r1"]},
+                                  {"filename": "drive_B.dlp", "driveRefList": ["r3"]}])
+        self.assertFalse(any("r4" in str(call) for call in request.call_args_list))
+
+    def test_inaccessible_drive_fails_by_default(self):
+        module = self._module()
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(
+                details={"r1": self._detail("r1", status="offline")})):
+            with self.assertRaises(AnsibleFailJson):
+                module.upgrade_list()
+
+    def test_inaccessible_drive_is_skipped_when_ignored(self):
+        module = self._module({"ignore_inaccessible_drives": True})
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(
+                details={"r1": self._detail("r1", status="unavailable")})):
+            self.assertEqual(module.upgrade_list(), [])
+
+    def test_health_state_is_used_to_skip_inaccessible_drive(self):
+        module = self._module({"ignore_inaccessible_drives": True})
+        states = [{"driveRef": "r1", "status": "offline"}]
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(states=states)):
+            self.assertEqual(module.upgrade_list(), [])
+
+    def test_incompatible_drive_model_is_not_selected(self):
+        module = self._module()
+        compatibility = [{"filename": "drive_A.dlp", "firmwareVersion": "2",
+                          "productID": "model-A", "driveRefList": ["r1"]}]
+        details = {"r1": dict(self._detail("r1", status="offline"), productID="model-B")}
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(compat=compatibility, details=details)):
+            self.assertEqual(module.upgrade_list(), [])
+
+    def test_online_upgrade_capability_and_offline_option(self):
+        detail = {"r1": self._detail("r1", online_capable=False)}
+        module = self._module()
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(details=detail)):
+            with self.assertRaises(AnsibleFailJson) as failure:
+                module.upgrade_list()
+        self.assertIn("Drive is not capable of online upgrade.", failure.exception.args[0]["msg"])
+
+        module = self._module({"upgrade_drives_online": False})
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(details=detail)):
+            self.assertEqual(module.upgrade_list(),
+                             [{"filename": "drive_A.dlp", "driveRefList": ["r1"]}])
+
+    def test_conflicting_firmware_for_one_drive_fails(self):
+        module = self._module({"firmware": ["/tmp/drive_A.dlp", "/tmp/drive_B.dlp"]})
+        compat = [
+            {"filename": "drive_A.dlp", "firmwareVersion": "2", "driveRefList": ["r1"]},
+            {"filename": "drive_B.dlp", "firmwareVersion": "3", "driveRefList": ["r1"]},
+        ]
+        with mock.patch(self.REQUEST_PATH, side_effect=self._request(compat=compat)):
