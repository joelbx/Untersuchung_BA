diff --git a/src/topics/system-tags.js b/src/topics/system-tags.js
new file mode 100644
index 0000000..1df62a9
--- /dev/null
+++ b/src/topics/system-tags.js
@@ -0,0 +1,26 @@
+'use strict';
+
+const meta = require('../meta');
+const user = require('../user');
+const utils = require('../utils');
+
+function isSystemTag(tag) {
+	const { systemTags } = meta.config;
+	if (!Array.isArray(systemTags)) {
+		return false;
+	}
+
+	const cleanedTag = utils.cleanUpTag(tag, meta.config.maximumTagLength);
+	return !!cleanedTag && systemTags.some((systemTag) => {
+		const cleanedSystemTag = utils.cleanUpTag(systemTag, meta.config.maximumTagLength);
+		return cleanedSystemTag === cleanedTag;
+	});
+}
+
+async function validate(tags, uid) {
+	if (Array.isArray(tags) && tags.some(isSystemTag) && !await user.isPrivileged(uid)) {
+		throw new Error('You can not use this system tag.');
+	}
+}
+
+module.exports = { isSystemTag, validate };
