+			await db.sortedSetRemove('users:joindate', uids);
+			await db.deleteAll(uids.flatMap(uid => [
+				`user:${uid}:settings`, `following:${uid}`, `followingRemote:${uid}`,
+			]));
+		}
+	});
 });
