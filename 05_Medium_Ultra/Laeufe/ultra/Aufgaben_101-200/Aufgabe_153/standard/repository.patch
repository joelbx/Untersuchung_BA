diff --git a/applications/drive/src/app/zustand/share/members.store.test.ts b/applications/drive/src/app/zustand/share/members.store.test.ts
new file mode 100644
index 0000000..1553a80
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/members.store.test.ts
@@ -0,0 +1,47 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import type { ShareMember } from '../../store';
+import { useMembersStore } from './members.store';
+
+const createMember = (id: string): ShareMember =>
+    ({
+        memberId: id,
+        email: `${id}@example.com`,
+    }) as ShareMember;
+
+describe('useMembersStore', () => {
+    beforeEach(() => {
+        useMembersStore.setState({ members: {} });
+    });
+
+    it('returns only the members for a share and an empty array for an absent share', () => {
+        const memberA = createMember('member-a');
+        const memberB = createMember('member-b');
+        const store = useMembersStore.getState();
+
+        store.setMembers('share-a', [memberA]);
+        store.setMembers('share-b', [memberB]);
+
+        expect(store.getMembers('share-a')).toEqual([memberA]);
+        expect(store.getMembers('share-b')).toEqual([memberB]);
+        expect(store.getMembers('missing')).toEqual([]);
+    });
+
+    it("replaces one share's members without changing another share", () => {
+        const oldMember = createMember('old-member');
+        const newMember = createMember('new-member');
+        const otherMember = createMember('other-member');
+        const store = useMembersStore.getState();
+
+        store.setMembers('share-a', [oldMember]);
+        store.setMembers('share-b', [otherMember]);
+        store.setMembers('share-a', [newMember]);
+
+        expect(store.getMembers('share-a')).toEqual([newMember]);
+        expect(store.getMembers('share-b')).toEqual([otherMember]);
+
+        store.setMembers('share-a', []);
+        expect(store.getMembers('share-a')).toEqual([]);
+        expect(store.getMembers('share-b')).toEqual([otherMember]);
+    });
+});
