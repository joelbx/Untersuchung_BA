diff --git a/applications/drive/src/app/zustand/share/invitations.store.test.ts b/applications/drive/src/app/zustand/share/invitations.store.test.ts
new file mode 100644
index 0000000..d92e54b
--- /dev/null
+++ b/applications/drive/src/app/zustand/share/invitations.store.test.ts
@@ -0,0 +1,115 @@
+import { beforeEach, describe, expect, it } from '@jest/globals';
+
+import { SHARE_MEMBER_PERMISSIONS } from '@proton/shared/lib/drive/permissions';
+
+import type { ShareExternalInvitation, ShareInvitation } from '../../store';
+import { useInvitationsStore } from './invitations.store';
+
+const createInvitation = (id: string): ShareInvitation =>
+    ({
+        invitationId: id,
+        inviteeEmail: `${id}@example.com`,
+        permissions: SHARE_MEMBER_PERMISSIONS.VIEWER,
+    }) as ShareInvitation;
+
+const createExternalInvitation = (id: string): ShareExternalInvitation =>
+    ({
+        externalInvitationId: id,
+        inviteeEmail: `${id}@example.com`,
+        permissions: SHARE_MEMBER_PERMISSIONS.VIEWER,
+    }) as ShareExternalInvitation;
+
+describe('useInvitationsStore', () => {
+    beforeEach(() => {
+        useInvitationsStore.setState({ invitations: {}, externalInvitations: {} });
+    });
+
+    it('keeps internal and external invitations separate for each share', () => {
+        const internalA = createInvitation('internal-a');
+        const internalB = createInvitation('internal-b');
+        const externalA = createExternalInvitation('external-a');
+        const externalB = createExternalInvitation('external-b');
+        const store = useInvitationsStore.getState();
+
+        store.setInvitations('share-a', [internalA]);
+        store.setInvitations('share-b', [internalB]);
+        store.setExternalInvitations('share-a', [externalA]);
+        store.setExternalInvitations('share-b', [externalB]);
+
+        expect(store.getInvitations('share-a')).toEqual([internalA]);
+        expect(store.getInvitations('share-b')).toEqual([internalB]);
+        expect(store.getExternalInvitations('share-a')).toEqual([externalA]);
+        expect(store.getExternalInvitations('share-b')).toEqual([externalB]);
+        expect(store.getInvitations('missing')).toEqual([]);
+        expect(store.getExternalInvitations('missing')).toEqual([]);
+
+        store.setInvitations('share-a', []);
+        store.setExternalInvitations('share-a', []);
+
+        expect(store.getInvitations('share-a')).toEqual([]);
+        expect(store.getExternalInvitations('share-a')).toEqual([]);
+        expect(store.getInvitations('share-b')).toEqual([internalB]);
+        expect(store.getExternalInvitations('share-b')).toEqual([externalB]);
+    });
+
+    it('updates and removes internal invitations only in the specified share', () => {
+        const internalA1 = createInvitation('internal-a-1');
+        const internalA2 = createInvitation('internal-a-2');
+        const internalB = createInvitation('internal-b');
+        const externalA = createExternalInvitation('external-a');
+        const store = useInvitationsStore.getState();
+
+        store.setInvitations('share-a', [internalA1, internalA2]);
+        store.setInvitations('share-b', [internalB]);
+        store.setExternalInvitations('share-a', [externalA]);
+
+        const updated = { ...internalA1, permissions: SHARE_MEMBER_PERMISSIONS.EDITOR };
+        store.updateInvitationsPermissions('share-a', [updated, internalA2]);
+        expect(store.getInvitations('share-a')).toEqual([updated, internalA2]);
+        expect(store.getInvitations('share-b')).toEqual([internalB]);
+
+        store.removeInvitations('share-a', [internalA2]);
+        expect(store.getInvitations('share-a')).toEqual([internalA2]);
+        expect(store.getInvitations('share-b')).toEqual([internalB]);
+        expect(store.getExternalInvitations('share-a')).toEqual([externalA]);
+    });
+
+    it('updates and removes external invitations only in the specified share', () => {
+        const externalA1 = createExternalInvitation('external-a-1');
+        const externalA2 = createExternalInvitation('external-a-2');
+        const externalB = createExternalInvitation('external-b');
+        const internalA = createInvitation('internal-a');
+        const store = useInvitationsStore.getState();
+
+        store.setExternalInvitations('share-a', [externalA1, externalA2]);
+        store.setExternalInvitations('share-b', [externalB]);
+        store.setInvitations('share-a', [internalA]);
+
+        const updated = { ...externalA1, permissions: SHARE_MEMBER_PERMISSIONS.EDITOR };
+        store.updateExternalInvitations('share-a', [updated, externalA2]);
+        expect(store.getExternalInvitations('share-a')).toEqual([updated, externalA2]);
+        expect(store.getExternalInvitations('share-b')).toEqual([externalB]);
+
+        store.removeExternalInvitations('share-a', [externalA2]);
+        expect(store.getExternalInvitations('share-a')).toEqual([externalA2]);
+        expect(store.getExternalInvitations('share-b')).toEqual([externalB]);
+        expect(store.getInvitations('share-a')).toEqual([internalA]);
+    });
+
+    it('adds internal and external invitations together without changing another share', () => {
+        const internalA = createInvitation('internal-a');
+        const internalB = createInvitation('internal-b');
+        const externalA = createExternalInvitation('external-a');
+        const externalB = createExternalInvitation('external-b');
+        const store = useInvitationsStore.getState();
+
+        store.setInvitations('share-b', [internalB]);
+        store.setExternalInvitations('share-b', [externalB]);
+        store.addMultipleInvitations('share-a', [internalA], [externalA]);
+
+        expect(store.getInvitations('share-a')).toEqual([internalA]);
+        expect(store.getExternalInvitations('share-a')).toEqual([externalA]);
+        expect(store.getInvitations('share-b')).toEqual([internalB]);
+        expect(store.getExternalInvitations('share-b')).toEqual([externalB]);
+    });
+});
