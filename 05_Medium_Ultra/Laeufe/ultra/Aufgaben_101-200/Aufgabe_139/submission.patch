+            {'title': 'Found'},
+        ]
+    )
+    monkeypatch.setattr(promise_imports, 'get_amazon_metadata', lookup)
+
+    promise_imports.stage_b_asins_for_import(
+        [
+            {
+                'title': 'Complete',
+                'authors': [{'name': 'Author'}],
+                'publish_date': '2020',
