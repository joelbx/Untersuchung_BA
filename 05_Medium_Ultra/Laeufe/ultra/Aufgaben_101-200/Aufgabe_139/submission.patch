+def test_map_book_omits_missing_metadata():
+    book = {
+        'ASIN': '123456789X',
+        'ISBN': '9781234567890',
+        'BookSKUB': 'sku1',
+        'ProductJSON': {
+            'Title': 'A book',
+            'Author': 'null',
+            'Publisher': '????',
+            'PublicationDate': '',
+        },
+    }
+
+    result = promise_imports.map_book_to_olbook(book, 'promise1')
+
+    assert result['title'] == 'A book'
+    assert result['isbn_10'] == ['123456789X']
+    assert not {'authors', 'publishers', 'publish_date'} & result.keys()
+    assert promise_imports.is_incomplete(result)
+
+
