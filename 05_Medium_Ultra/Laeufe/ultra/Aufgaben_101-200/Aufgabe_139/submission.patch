+            },
+            {
+                'title': 'Missing author',
+                'publish_date': '2020',
+                'isbn_10': ['123456789X'],
+                'identifiers': {'amazon': ['B000000001']},
+            },
+            {
+                'title': 'Missing date',
+                'authors': [{'name': 'Author'}],
+                'identifiers': {'amazon': ['B000000002']},
+            },
+            {
+                'authors': [{'name': 'Author'}],
+                'publish_date': '2020',
+                'identifiers': {'amazon': ['B000000003']},
