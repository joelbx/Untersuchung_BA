diff --git a/internal/cmd/auth_test.go b/internal/cmd/auth_test.go
new file mode 100644
index 0000000..4c4c96f
--- /dev/null
+++ b/internal/cmd/auth_test.go
@@ -0,0 +1,38 @@
+package cmd
+
+import (
+	"context"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+func TestAuthenticationGRPCWithoutDatabase(t *testing.T) {
+	for _, storageType := range []config.StorageType{
+		config.GitStorageType,
+		config.LocalStorageType,
+		config.ObjectStorageType,
+	} {
+		t.Run(string(storageType), func(t *testing.T) {
+			cfg := &config.Config{
+				Storage:  config.StorageConfig{Type: storageType},
+				Database: config.DatabaseConfig{URL: "://invalid"},
+			}
+
+			register, interceptors, shutdown, err := authenticationGRPC(context.Background(), zap.NewNop(), cfg, false)
+			if err != nil {
+				t.Fatalf("authenticationGRPC attempted database setup: %v", err)
+			}
+			if len(register) != 2 {
+				t.Fatalf("got %d authentication services, want 2", len(register))
+			}
+			if len(interceptors) != 0 {
+				t.Fatalf("got %d authentication interceptors, want 0", len(interceptors))
+			}
+			if err := shutdown(context.Background()); err != nil {
+				t.Fatalf("shutting down authentication: %v", err)
+			}
+		})
+	}
+}
