diff --git a/packages/components/payments/client-extensions/usePollEvents.test.tsx b/packages/components/payments/client-extensions/usePollEvents.test.tsx
new file mode 100644
index 0000000..41c21cb
--- /dev/null
+++ b/packages/components/payments/client-extensions/usePollEvents.test.tsx
@@ -0,0 +1,177 @@
+import { renderHook } from '@testing-library/react-hooks';
+
+import { EVENT_ACTIONS } from '@proton/shared/lib/constants';
+
+import { useEventManager } from '../../hooks';
+import { interval, maxPollingSteps, usePollEvents } from './usePollEvents';
+
+jest.mock('../../hooks', () => ({
+    useEventManager: jest.fn(),
+}));
+
+describe('usePollEvents', () => {
+    const call = jest.fn().mockResolvedValue(undefined);
+    const unsubscribe = jest.fn();
+    let onEvent: (event: any) => void;
+    const subscribe = jest.fn((handler: typeof onEvent) => {
+        onEvent = handler;
+        return unsubscribe;
+    });
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        jest.clearAllMocks();
+        jest.mocked(useEventManager).mockReturnValue({ call, subscribe } as any);
+    });
+
+    afterEach(() => {
+        jest.clearAllTimers();
+        jest.useRealTimers();
+    });
+
+    it('uses five attempts spaced five seconds apart', async () => {
+        expect(interval).toBe(5000);
+        expect(maxPollingSteps).toBe(5);
+
+        const { result } = renderHook(() => usePollEvents());
+        const polling = result.current();
+
+        expect(call).not.toHaveBeenCalled();
+        await jest.advanceTimersByTimeAsync(interval - 1);
+        expect(call).not.toHaveBeenCalled();
+
+        await jest.advanceTimersByTimeAsync(1);
+        expect(call).toHaveBeenCalledTimes(1);
+
+        for (let attempt = 2; attempt <= maxPollingSteps; attempt++) {
+            await jest.advanceTimersByTimeAsync(interval - 1);
+            expect(call).toHaveBeenCalledTimes(attempt - 1);
+            await jest.advanceTimersByTimeAsync(1);
+            expect(call).toHaveBeenCalledTimes(attempt);
+        }
+
+        await polling;
+        await jest.advanceTimersByTimeAsync(interval * 2);
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    });
+
+    it('stops early and unsubscribes for a matching property and action', async () => {
+        const { result } = renderHook(() => usePollEvents());
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        expect(subscribe).toHaveBeenCalledTimes(1);
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(1);
+
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await polling;
+
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        expect(call).toHaveBeenCalledTimes(1);
+    });
+
+    it('continues polling through unrelated properties and actions', async () => {
+        const { result } = renderHook(() => usePollEvents());
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        onEvent({ Contacts: [{ Action: EVENT_ACTIONS.CREATE }] });
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }] });
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(1);
+
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.DELETE }, { Action: EVENT_ACTIONS.UPDATE }] });
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(2);
+
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.UPDATE }, { Action: EVENT_ACTIONS.CREATE }] });
+        await polling;
+
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        expect(call).toHaveBeenCalledTimes(2);
+    });
+
+    it('unsubscribes after all attempts and ignores events from the old subscription', async () => {
+        const { result } = renderHook(() => usePollEvents());
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        for (let attempt = 1; attempt <= maxPollingSteps; attempt++) {
+            await jest.advanceTimersByTimeAsync(interval);
+            expect(call).toHaveBeenCalledTimes(attempt);
+        }
+        await polling;
+
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await jest.advanceTimersByTimeAsync(interval * 2);
+
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+        expect(call).toHaveBeenCalledTimes(maxPollingSteps);
+    });
+
+    it('stops on a matching event while a request is in flight', async () => {
+        let resolveCall!: () => void;
+        call.mockImplementationOnce(
+            () =>
+                new Promise<void>((resolve) => {
+                    resolveCall = resolve;
+                })
+        );
+
+        const { result } = renderHook(() => usePollEvents());
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(1);
+
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await polling;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        resolveCall();
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+    });
+
+    it('unsubscribes and rejects if an event manager request fails', async () => {
+        const error = new Error('Event request failed');
+        call.mockRejectedValueOnce(error);
+
+        const { result } = renderHook(() => usePollEvents());
+        const polling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+        const rejection = expect(polling).rejects.toBe(error);
+
+        await jest.advanceTimersByTimeAsync(interval);
+        await rejection;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await jest.advanceTimersByTimeAsync(interval * maxPollingSteps);
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+    });
+
+    it('keeps repeated invocations independent of a late event from an earlier one', async () => {
+        const { result } = renderHook(() => usePollEvents());
+
+        const firstPolling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+        const firstHandler = onEvent;
+        firstHandler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await firstPolling;
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        const secondPolling = result.current('PaymentMethods', EVENT_ACTIONS.CREATE);
+        expect(subscribe).toHaveBeenCalledTimes(2);
+        firstHandler({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+
+        await jest.advanceTimersByTimeAsync(interval);
+        expect(call).toHaveBeenCalledTimes(1);
+        expect(unsubscribe).toHaveBeenCalledTimes(1);
+
+        onEvent({ PaymentMethods: [{ Action: EVENT_ACTIONS.CREATE }] });
+        await secondPolling;
+        expect(unsubscribe).toHaveBeenCalledTimes(2);
+    });
+});
