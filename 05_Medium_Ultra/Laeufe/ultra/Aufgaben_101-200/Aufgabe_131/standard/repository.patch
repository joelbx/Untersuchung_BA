+    const { call, subscribe } = useEventManager();
+
+    const pollEventsMultipleTimes = (property?: string, action?: EVENT_ACTIONS) =>
+        new Promise<void>((resolve, reject) => {
+            let completed = false;
+            let pollingSteps = 0;
+            let timeout: ReturnType<typeof setTimeout> | undefined;
+            let unsubscribe: (() => void) | undefined;
+
+            const cleanup = () => {
+                if (completed) {
+                    return false;
+                }
+
+                completed = true;
+                if (timeout !== undefined) {
+                    clearTimeout(timeout);
+                    timeout = undefined;
+                }
+                unsubscribe?.();
+                unsubscribe = undefined;
+                return true;
+            };
+
+            const finish = () => {
+                if (cleanup()) {
+                    resolve();
+                }
+            };
+
+            const fail = (error: unknown) => {
+                if (cleanup()) {
+                    reject(error);
+                }
+            };
+
+            let poll: () => Promise<void>;
+
+            const schedule = () => {
+                timeout = setTimeout(() => {
+                    timeout = undefined;
+                    void poll();
+                }, interval);
+            };
+
+            poll = async () => {
+                if (completed) {
+                    return;
+                }
+
+                pollingSteps += 1;
+                try {
+                    await call();
+                } catch (error) {
+                    fail(error);
+                    return;
+                }
+
+                if (completed) {
+                    return;
+                }
+
+                if (pollingSteps === maxPollingSteps) {
+                    finish();
+                } else {
+                    schedule();
+                }
+            };
+
+            if (property !== undefined && action !== undefined) {
+                const unsubscribeFromEvents = subscribe((event: Record<string, unknown>) => {
+                    if (completed) {
+                        return;
+                    }
+
+                    const updates = event?.[property];
+                    if (Array.isArray(updates) && updates.some((update) => update?.Action === action)) {
+                        finish();
+                    }
+                });
+
+                if (completed) {
+                    unsubscribeFromEvents();
+                    return;
+                }
+                unsubscribe = unsubscribeFromEvents;
+            }
+
+            schedule();
+        });
 
     return pollEventsMultipleTimes;
