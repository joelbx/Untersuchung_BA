+@pytest.mark.parametrize('filter_name, expected', (('min', 'small'), ('max', 'large')))
+def test_min_max_attribute_in_template(filter_name, expected):
+    if not getattr(ms, 'HAS_%s' % filter_name.upper()):
+        pytest.skip('Jinja2 does not provide do_%s' % filter_name)
+    template_env = Environment()
+    template_env.filters.update(ms.FilterModule().filters())
+    template = template_env.from_string("{{ (values | %s(attribute='size')).name }}" % filter_name)
+    values = [{'name': 'large', 'size': 20}, {'name': 'small', 'size': 5}]
+
+    assert template.render(values=values) == expected
+
+
+@pytest.mark.parametrize('filter_name, insensitive, sensitive',
+                         (('min', 'a', 'B'), ('max', 'B', 'a')))
+def test_min_max_case_sensitive(filter_name, insensitive, sensitive):
+    if not getattr(ms, 'HAS_%s' % filter_name.upper()):
+        pytest.skip('Jinja2 does not provide do_%s' % filter_name)
+    filter_func = getattr(ms, filter_name)
+
+    assert filter_func(env, ['a', 'B'], case_sensitive=False) == insensitive
+    assert filter_func(env, ['a', 'B'], case_sensitive=True) == sensitive
+
+
+@pytest.mark.parametrize('filter_name', ('min', 'max'))
+def test_min_max_forwards_all_kwargs(monkeypatch, filter_name):
+    values = [{'size': 1}]
+    result = object()
+
+    def jinja_filter(filter_env, filter_values, **kwargs):
+        assert filter_env is env
+        assert filter_values is values
+        assert kwargs == {'attribute': 'size', 'case_sensitive': True, 'other': 42}
+        return result
+
+    monkeypatch.setattr(ms, 'HAS_%s' % filter_name.upper(), True)
+    monkeypatch.setattr(ms, 'do_%s' % filter_name, jinja_filter, raising=False)
+    assert getattr(ms, filter_name)(env, values, attribute='size', case_sensitive=True, other=42) is result
+
+
+@pytest.mark.parametrize('filter_name, expected', (('min', 1), ('max', 2)))
+def test_min_max_fallback(monkeypatch, filter_name, expected):
+    monkeypatch.setattr(ms, 'HAS_%s' % filter_name.upper(), False)
+    filter_func = getattr(ms, filter_name)
+    assert filter_func(env, (2, 1)) == expected
+
+    message = ("Ansible's %s filter does not support any keyword arguments. "
