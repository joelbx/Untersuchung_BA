+func TestLoadDeprecationsRequireExplicitConfigKeys(t *testing.T) {
+	const (
+		memoryEnabledWarning    = "\"cache.memory.enabled\" is deprecated and will be removed in a future version. Please use 'cache.backend' and 'cache.enabled' instead."
+		memoryExpirationWarning = "\"cache.memory.expiration\" is deprecated and will be removed in a future version. Please use 'cache.ttl' instead."
+		uiEnabledWarning        = "\"ui.enabled\" is deprecated and will be removed in a future version."
+	)
+
+	tests := []struct {
+		name     string
+		contents string
+		warnings []string
+	}{
+		{
+			name:     "empty config uses defaults without warnings",
+			contents: "{}\n",
+		},
+		{
+			name:     "explicit ui enabled true",
+			contents: "ui:\n  enabled: true\n",
+			warnings: []string{uiEnabledWarning},
+		},
+		{
+			name:     "explicit ui enabled false",
+			contents: "ui:\n  enabled: false\n",
+			warnings: []string{uiEnabledWarning},
+		},
+		{
+			name:     "explicit deprecated memory enabled false",
+			contents: "cache:\n  memory:\n    enabled: false\n",
+			warnings: []string{memoryEnabledWarning},
+		},
+		{
+			name:     "explicit memory expiration without memory enabled",
+			contents: "cache:\n  memory:\n    expiration: 10m\n",
+			warnings: []string{memoryExpirationWarning},
+		},
+		{
+			name:     "explicit memory expiration with memory disabled",
+			contents: "cache:\n  memory:\n    enabled: false\n    expiration: 10m\n",
+			warnings: []string{memoryEnabledWarning, memoryExpirationWarning},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yml")
+			require.NoError(t, os.WriteFile(path, []byte(tt.contents), 0600))
+
+			result, err := Load(path)
+			require.NoError(t, err)
+			require.NotNil(t, result)
+			assert.Equal(t, tt.warnings, result.Warnings)
 		})
 	}
 }
