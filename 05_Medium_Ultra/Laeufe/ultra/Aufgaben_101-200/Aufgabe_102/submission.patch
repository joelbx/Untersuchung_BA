+    def get_locally_reachable_ips(self, ip_path):
+        """Return local, host-scope routes from all IPv4 and IPv6 route tables."""
+        reachable = {'ipv4': [], 'ipv6': []}
+        if not ip_path:
+            self.module.warn('Could not gather locally reachable IPs: ip command not found.')
+            return reachable
+
+        for family, option, version in (('ipv4', '-4', 4), ('ipv6', '-6', 6)):
+            if version == 6 and not socket.has_ipv6:
+                continue
+
+            command = [ip_path, option, 'route', 'show', 'table', 'all']
+            # IPv6 local routes can omit a printed scope, so select them by
+            # route type. IPv4 supports a host-scope filter at query time.
+            if version == 4:
+                command.extend(['scope', 'host'])
+            try:
+                rc, output, stderr = self.module.run_command(command, errors='surrogate_then_replace')
+            except Exception:
+                self.module.warn('Could not query locally reachable %s routes.' % family)
+                continue
+            if rc != 0:
+                self.module.warn('Could not query locally reachable %s routes (exit status %s).' % (family, rc))
+                continue
+
+            routes = {}
+            malformed = False
+            for line in output.splitlines():
+                words = line.split()
+                if len(words) < 2 or words[0] != 'local':
+                    continue
+                if 'scope' in words[2:]:
+                    scope_index = words.index('scope', 2)
+                    if len(words) <= scope_index + 1 or words[scope_index + 1] != 'host':
+                        continue
+
+                destination = words[1]
+                if destination == 'default':
+                    destination = '0.0.0.0/0' if version == 4 else '::/0'
+                try:
+                    network = ipaddress.ip_network(destination, strict=False)
+                except ValueError:
+                    malformed = True
+                    continue
+                if network.version != version:
+                    malformed = True
+                    continue
+
+                if network.prefixlen == network.max_prefixlen:
+                    normalized = str(network.network_address)
+                else:
+                    normalized = str(network)
+                routes[normalized] = (int(network.network_address), network.prefixlen)
+
+            if malformed:
+                self.module.warn('Ignored malformed locally reachable %s route.' % family)
+            reachable[family] = sorted(routes, key=routes.get)
+
+        return reachable
+
