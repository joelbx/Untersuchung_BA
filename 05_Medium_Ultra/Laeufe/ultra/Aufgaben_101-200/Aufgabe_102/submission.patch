+
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat import unittest
+from units.compat.mock import Mock, patch
+
+from ansible.module_utils.facts import collector
+from ansible.module_utils.facts.network.linux import LinuxNetwork, LinuxNetworkCollector
+
+
+class TestLocallyReachableIps(unittest.TestCase):
+
+    def setUp(self):
+        self.module = Mock()
+        self.network = LinuxNetwork(self.module)
+
+    @patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', True)
+    def test_collects_canonical_local_routes_in_numeric_order(self):
+        routes = {
+            '-4': '''
+local 192.168.1.42/24 dev lo proto static scope host
+local 192.168.0.1 dev eth7 proto kernel scope host src 192.168.0.1
+broadcast 192.168.1.255 dev eth7 proto kernel scope host
+local 127.0.0.1/32 dev lo proto kernel scope host
+local 127.0.0.0/8 dev lo proto kernel scope host
+local 192.168.0.1 dev eth8 proto kernel scope host
+local 198.51.100.1 dev eth8 proto kernel scope link
+unreachable 203.0.113.0/24 scope host
+''',
+            '-6': '''
+local 2001:0DB8:0000:0001::1/64 dev lo proto static
+local ::1/128 dev lo proto kernel
+local 2001:db8:0:1::/64 dev lo proto static
+local 2001:db8::1 dev eth7 proto kernel
+anycast 2001:db8::ffff dev eth7 proto kernel
+''',
+        }
+
+        def run_command(args, **kwargs):
+            return 0, routes[args[1]], ''
+
+        self.module.run_command.side_effect = run_command
+
+        result = self.network.get_locally_reachable_ips('/sbin/ip')
+
+        self.assertEqual(result, {
+            'ipv4': ['127.0.0.0/8', '127.0.0.1', '192.168.0.1', '192.168.1.0/24'],
+            'ipv6': ['::1', '2001:db8::1', '2001:db8:0:1::/64'],
+        })
+        self.assertEqual([call[0][0] for call in self.module.run_command.call_args_list], [
+            ['/sbin/ip', '-4', 'route', 'show', 'table', 'all', 'scope', 'host'],
+            ['/sbin/ip', '-6', 'route', 'show', 'table', 'all'],
+        ])
+
+    @patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', True)
+    def test_failed_family_keeps_other_family_and_warns(self):
+        def run_command(args, **kwargs):
+            if args[1] == '-4':
+                return 1, '', 'route query failed'
+            return 0, 'local ::1 dev lo proto kernel scope host\n', ''
+
+        self.module.run_command.side_effect = run_command
+
+        self.assertEqual(self.network.get_locally_reachable_ips('/sbin/ip'), {
+            'ipv4': [],
+            'ipv6': ['::1'],
+        })
+        self.module.warn.assert_called_once()
+
+    @patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', False)
+    def test_skips_ipv6_when_unavailable(self):
+        self.module.run_command.return_value = (0, 'local 127.0.0.1 dev lo proto kernel scope host\n', '')
+
+        self.assertEqual(self.network.get_locally_reachable_ips('/sbin/ip'), {
+            'ipv4': ['127.0.0.1'],
+            'ipv6': [],
+        })
+        self.assertEqual(self.module.run_command.call_count, 1)
+        self.module.warn.assert_not_called()
+
+    @patch('ansible.module_utils.facts.network.linux.socket.has_ipv6', False)
+    def test_malformed_local_route_is_skipped_with_warning(self):
+        self.module.run_command.return_value = (0, 'local invalid-prefix dev lo scope host\n', '')
+
+        self.assertEqual(self.network.get_locally_reachable_ips('/sbin/ip'), {
+            'ipv4': [],
+            'ipv6': [],
+        })
+        self.module.warn.assert_called_once()
+
+    def test_fact_can_be_selected_as_gather_subset(self):
+        subsets, aliases = collector.build_fact_id_to_collector_map([LinuxNetworkCollector])
+        selected = collector.get_collector_names(
+            valid_subsets=frozenset(subsets),
+            gather_subset=['!all', 'locally_reachable_ips'],
+            aliases_map=aliases,
+        )
+
+        self.assertEqual(collector.select_collector_classes(selected, subsets), [LinuxNetworkCollector])
+
+    def test_populate_exposes_new_fact_with_existing_network_facts(self):
+        self.module.get_bin_path.return_value = '/sbin/ip'
+        self.network.get_default_interfaces = Mock(return_value=({'interface': 'eth7'}, {}))
+        self.network.get_interfaces_info = Mock(return_value=({'eth7': {'device': 'eth7'}}, {
+            'all_ipv4_addresses': ['192.168.0.1'],
+            'all_ipv6_addresses': [],
+        }))
+        self.network.get_locally_reachable_ips = Mock(return_value={
+            'ipv4': ['127.0.0.0/8', '192.168.0.1'],
+            'ipv6': ['::1'],
+        })
+
+        result = self.network.populate()
+
+        self.assertEqual(result['locally_reachable_ips'], {
+            'ipv4': ['127.0.0.0/8', '192.168.0.1'],
+            'ipv6': ['::1'],
+        })
+        self.assertEqual(result['default_ipv4'], {'interface': 'eth7'})
+        self.assertEqual(result['default_ipv6'], {})
+        self.assertEqual(result['all_ipv4_addresses'], ['192.168.0.1'])
+        self.assertEqual(result['all_ipv6_addresses'], [])
+        self.assertEqual(list(result['interfaces']), ['eth7'])
+        self.assertEqual(result['eth7'], {'device': 'eth7'})
+        self.network.get_locally_reachable_ips.assert_called_once_with('/sbin/ip')
+
+    def test_populate_without_ip_exposes_empty_fact_and_warns(self):
+        self.module.get_bin_path.return_value = None
+
+        self.assertEqual(self.network.populate(), {
+            'locally_reachable_ips': {'ipv4': [], 'ipv6': []},
+        })
+        self.module.warn.assert_called_once()
