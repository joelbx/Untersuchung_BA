+package scanner
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/logging"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParseInstalledPackagesLineReleaseAndEpoch(t *testing.T) {
+	tests := []struct {
+		name        string
+		epoch       string
+		release     string
+		wantVersion string
+		wantSource  string
+	}{
+		{name: "zero epoch, release", epoch: "0", release: "7", wantVersion: "2.4", wantSource: "2.4-7"},
+		{name: "zero epoch, empty release", epoch: "0", wantVersion: "2.4", wantSource: "2.4"},
+		{name: "none epoch, release", epoch: "(none)", release: "7", wantVersion: "2.4", wantSource: "2.4-7"},
+		{name: "none epoch, empty release", epoch: "(none)", wantVersion: "2.4", wantSource: "2.4"},
+		{name: "nonzero epoch, release", epoch: "3", release: "7", wantVersion: "3:2.4", wantSource: "3:2.4-7"},
+		{name: "nonzero epoch, empty release", epoch: "3", wantVersion: "3:2.4", wantSource: "3:2.4"},
+	}
+
+	for _, tt := range tests {
+		for _, parser := range []struct {
+			name       string
+			parse      func(*redhatBase, string) (*models.Package, *models.SrcPackage, error)
+			repository string
+			suffix     string
+		}{
+			{name: "rpm", parse: (*redhatBase).parseInstalledPackagesLine},
+			{name: "repoquery", parse: (*redhatBase).parseInstalledPackagesLineFromRepoquery, repository: "extras", suffix: " @extras"},
+		} {
+			t.Run(parser.name+"/"+tt.name, func(t *testing.T) {
+				line := "sample " + tt.epoch + " 2.4 " + tt.release + " x86_64 sample-2.4-" + tt.release + ".src.rpm" + parser.suffix
+				binary, source, err := parser.parse(&redhatBase{}, line)
+				if err != nil {
+					t.Fatalf("parse %q: %v", line, err)
+				}
+				wantBinary := &models.Package{
+					Name:       "sample",
+					Version:    tt.wantVersion,
+					Release:    tt.release,
+					Arch:       "x86_64",
+					Repository: parser.repository,
+				}
+				wantSource := &models.SrcPackage{
+					Name:        "sample",
+					Version:     tt.wantSource,
+					Arch:        "src",
+					BinaryNames: []string{"sample"},
+				}
+				if !reflect.DeepEqual(binary, wantBinary) {
+					t.Errorf("binary = %#v, want %#v", binary, wantBinary)
+				}
+				if !reflect.DeepEqual(source, wantSource) {
+					t.Errorf("source = %#v, want %#v", source, wantSource)
+				}
+			})
+		}
+	}
+}
+
+func TestParseInstalledPackagesPreservesEmptyRelease(t *testing.T) {
+	tests := []struct {
+		name       string
+		distro     config.Distro
+		line       string
+		repository string
+	}{
+		{
+			name:   "rpm with modularity label",
+			distro: config.Distro{Family: constant.Alma, Release: "9"},
+			line:   "sample 0 2.4  x86_64 sample-2.4-.src.rpm sample:2.4:context",
+		},
+		{
+			name:   "amazon 2 rpm",
+			distro: config.Distro{Family: constant.Amazon, Release: "2 (Karoo)"},
+			line:   "sample 0 2.4  x86_64 sample-2.4-.src.rpm",
+		},
+		{
+			name:       "amazon 2 repoquery",
+			distro:     config.Distro{Family: constant.Amazon, Release: "2 (Karoo)"},
+			line:       "sample 0 2.4  x86_64 sample-2.4-.src.rpm @extras",
+			repository: "extras",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			o := &redhatBase{base: base{Distro: tt.distro, log: logging.NewIODiscardLogger()}}
+			binaries, sources, err := o.parseInstalledPackages(tt.line)
+			if err != nil {
+				t.Fatalf("parseInstalledPackages(%q): %v", tt.line, err)
+			}
+			wantBinary := models.Package{
+				Name:       "sample",
+				Version:    "2.4",
+				Arch:       "x86_64",
+				Repository: tt.repository,
+			}
+			if tt.name == "rpm with modularity label" {
+				wantBinary.ModularityLabel = "sample:2.4:context"
+			}
+			if got := binaries["sample"]; !reflect.DeepEqual(got, wantBinary) {
+				t.Errorf("binary = %#v, want %#v", got, wantBinary)
+			}
+			wantSource := models.SrcPackage{
+				Name:        "sample",
+				Version:     "2.4",
+				Arch:        "src",
+				BinaryNames: []string{"sample"},
+			}
+			if got := sources["sample"]; !reflect.DeepEqual(got, wantSource) {
+				t.Errorf("source = %#v, want %#v", got, wantSource)
+			}
+		})
+	}
+}
