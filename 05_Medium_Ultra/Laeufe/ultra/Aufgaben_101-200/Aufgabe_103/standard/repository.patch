+package scanner
+
+import "testing"
+
+func TestSplitFileName(t *testing.T) {
+	valid := []struct {
+		filename string
+		name     string
+		version  string
+		release  string
+		epoch    string
+		arch     string
+	}{
+		{"foo-1.0-1.i386.rpm", "foo", "1.0", "1", "", "i386"},
+		{"1:bar-9-123a.ia64.rpm", "bar", "9", "123a", "1", "ia64"},
+		{"my-package-0-1.src.rpm", "my-package", "0", "1", "", "src"},
+		{"package-0-1-src.rpm", "package", "0", "1", "", "src"},
+		{"package-0--src.rpm", "package", "0", "", "", "src"},
+		{"elasticsearch-8.17.0-1-src.rpm", "elasticsearch", "8.17.0", "1", "", "src"},
+	}
+	for _, tt := range valid {
+		t.Run(tt.filename, func(t *testing.T) {
+			name, version, release, epoch, arch, err := splitFileName(tt.filename)
+			if err != nil {
+				t.Fatalf("splitFileName(%q): %v", tt.filename, err)
+			}
+			if name != tt.name || version != tt.version || release != tt.release || epoch != tt.epoch || arch != tt.arch {
+				t.Errorf("splitFileName(%q) = (%q, %q, %q, %q, %q), want (%q, %q, %q, %q, %q)",
+					tt.filename, name, version, release, epoch, arch,
+					tt.name, tt.version, tt.release, tt.epoch, tt.arch)
+			}
+		})
+	}
+
+	malformed := []string{
+		"package-1-2.src",
+		"package-1-2.rpm",
+		"package-1-2..rpm",
+		"package-1.src.rpm",
+		"package--1.src.rpm",
+		"-1-2.src.rpm",
+		"package---1-2.src.rpm",
+		"x:package-1-2.src.rpm",
+		"1:-package-1-2.src.rpm",
+		"package-1-2.src-.rpm",
+		"path/package-1-2.src.rpm",
+	}
+	for _, filename := range malformed {
+		t.Run(filename, func(t *testing.T) {
+			if _, _, _, _, _, err := splitFileName(filename); err == nil {
+				t.Errorf("splitFileName(%q) accepted malformed filename", filename)
+			}
+		})
+	}
+}
