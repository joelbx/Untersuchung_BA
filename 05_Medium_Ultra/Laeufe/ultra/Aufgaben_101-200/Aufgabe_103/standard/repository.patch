+package scanner
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParseUpdatablePacksLinesEmptyRelease(t *testing.T) {
+	tests := []struct {
+		name   string
+		parse  func(string) (models.Packages, error)
+		output string
+		want   models.Packages
+	}{
+		{
+			name:  "CentOS",
+			parse: newCentOS(config.ServerInfo{}).parseUpdatablePacksLines,
+			output: `Loading repository metadata
+audit-libs 0 2.3.7 5.el6 base
+pytalloc 3 2.0.7  @CentOS 6.5/6.5`,
+			want: models.NewPackages(
+				models.Package{Name: "audit-libs", NewVersion: "2.3.7", NewRelease: "5.el6", Repository: "base"},
+				models.Package{Name: "pytalloc", NewVersion: "3:2.0.7", Repository: "@CentOS 6.5/6.5"},
+			),
+		},
+		{
+			name:  "Amazon Linux",
+			parse: newAmazon(config.ServerInfo{}).parseUpdatablePacksLines,
+			output: `bind-libs 32 9.8.2 0.37.rc1.45.amzn1 amzn-main
+java-1.7.0-openjdk  (none) 1.7.0  amzn-main`,
+			want: models.NewPackages(
+				models.Package{Name: "bind-libs", NewVersion: "32:9.8.2", NewRelease: "0.37.rc1.45.amzn1", Repository: "amzn-main"},
+				models.Package{Name: "java-1.7.0-openjdk", NewVersion: "1.7.0", Repository: "amzn-main"},
+			),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.parse(tt.output)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("packages = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestParseUpdatablePacksLineRejectsMissingRepository(t *testing.T) {
+	if _, err := (&redhatBase{}).parseUpdatablePacksLine("package 0 1.0 2"); err == nil {
+		t.Fatal("expected an error for a missing repository")
+	}
+}
