 import mimetypes
 import ctypes
 import ctypes.util
+from fractions import Fraction
 from typing import (Any, Callable, IO, Iterator, Optional, Sequence, Tuple, Type, Union,
                     TYPE_CHECKING, cast)
 
@@ -177,6 +178,41 @@ def compact_text(text: str, elidelength: int = None) -> str:
     return out
 
 
+_DURATION_NUMBER = r'(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)'
+_DURATION_RE = re.compile(
+    r'(?:(?P<hours>' + _DURATION_NUMBER + r')h\s*)?'
+    r'(?:(?P<minutes>' + _DURATION_NUMBER + r')m\s*)?'
+    r'(?:(?P<seconds>' + _DURATION_NUMBER + r')s\s*)?')
+
+
+def parse_duration(duration: str) -> int:
+    """Parse a duration into milliseconds.
+
+    Unit expressions contain hours, minutes, and seconds in that order, with
+    optional decimal values and whitespace between components. A bare integer
+    is interpreted as milliseconds for backwards compatibility. Fractional
+    milliseconds are discarded.
+
+    Raises:
+        ValueError: If the duration is empty or has an invalid format.
+    """
+    value = duration.strip()
+    if re.fullmatch(r'[0-9]+', value):
+        return int(value)
+
+    match = _DURATION_RE.fullmatch(value)
+    if match is None or not any(match.groupdict().values()):
+        raise ValueError('Invalid duration: {!r}'.format(duration))
+
+    milliseconds = Fraction()
+    for unit, factor in [('hours', 3600000), ('minutes', 60000),
+                         ('seconds', 1000)]:
+        amount = match.group(unit)
+        if amount is not None:
+            milliseconds += Fraction(amount) * factor
+    return int(milliseconds)
+
+
