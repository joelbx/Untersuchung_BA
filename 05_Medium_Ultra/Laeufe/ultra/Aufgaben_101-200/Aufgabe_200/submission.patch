diff --git a/tests/unit/misc/test_utilcmds.py b/tests/unit/misc/test_utilcmds.py
index e8f651d..e3f5a1a 100644
--- a/tests/unit/misc/test_utilcmds.py
+++ b/tests/unit/misc/test_utilcmds.py
@@ -40,6 +40,35 @@ def test_repeat_command_initial(mocker, mode_manager):
         utilcmds.repeat_command(win_id=0)
 
 
+@pytest.mark.parametrize('duration, expected_ms', [
+    ('2m30s', 150000),
+    ('5000', 5000),
+])
+def test_later_duration(mocker, duration, expected_ms):
+    """The command passes unit durations and bare milliseconds to its timer."""
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer').return_value
+    mocker.patch('qutebrowser.misc.utilcmds.runners.CommandRunner')
+
+    utilcmds.later(duration, 'scroll down', win_id=0)
+
+    timer.setInterval.assert_called_once_with(expected_ms)
+    timer.start.assert_called_once_with()
+
+
+@pytest.mark.parametrize('duration, message', [
+    ('nonsense', 'Invalid duration'),
+    ('-1s', "I can't run something in the past!"),
+])
+def test_later_invalid_duration(mocker, duration, message):
+    """An invalid duration surfaces as a command error without a timer."""
+    timer = mocker.patch('qutebrowser.misc.utilcmds.usertypes.Timer')
+
+    with pytest.raises(cmdutils.CommandError, match=message):
+        utilcmds.later(duration, 'scroll down', win_id=0)
+
+    timer.assert_not_called()
+
+
