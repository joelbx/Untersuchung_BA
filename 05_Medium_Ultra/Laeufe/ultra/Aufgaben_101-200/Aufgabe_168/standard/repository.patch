+type AdminActionLock = {
+    pending: boolean;
+    acquire(): boolean;
+    release(): void;
+};
+
+const AdminActionLockContext = React.createContext<AdminActionLock | null>(null);
+
+// The container shares a lock between its buttons. Keep a local lock for buttons rendered on their own.
+const useAdminActionLock = (): AdminActionLock => {
+    const sharedLock = useContext(AdminActionLockContext);
+    const [pending, setPending] = useState(false);
+    const pendingRef = useRef(false);
+
+    return (
+        sharedLock ?? {
+            pending,
+            acquire: () => {
+                if (pendingRef.current) return false;
+                pendingRef.current = true;
+                setPending(true);
+                return true;
+            },
+            release: () => {
+                pendingRef.current = false;
+                setPending(false);
+            },
+        }
+    );
+};
