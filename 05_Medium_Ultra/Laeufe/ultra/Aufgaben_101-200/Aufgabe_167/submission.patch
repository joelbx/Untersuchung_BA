+func TestStore_Fetch_RemoteRegistry(t *testing.T) {
+	layerPayload := []byte(`{"flags":[{"key":"remote","name":"Remote"}]}`)
+	layerDigest := digest.FromBytes(layerPayload)
+	layerDesc := v1.Descriptor{
+		MediaType: MediaTypeFliptNamespace,
+		Digest:    layerDigest,
+		Size:      int64(len(layerPayload)),
+		Annotations: map[string]string{
+			AnnotationFliptNamespace: "production",
+		},
+	}
+	manifestPayload, err := json.Marshal(map[string]any{
+		"schemaVersion": 2,
+		"mediaType":     v1.MediaTypeImageManifest,
+		"config": v1.Descriptor{
+			MediaType: "application/vnd.oci.empty.v1+json",
+			Digest:    digest.FromString("{}"),
+			Size:      2,
+		},
+		"layers": []v1.Descriptor{layerDesc},
+		"annotations": map[string]string{
+			v1.AnnotationCreated: time.Now().UTC().Format(time.RFC3339),
+		},
+	})
+	require.NoError(t, err)
+	manifestDigest := digest.FromBytes(manifestPayload)
+
+	var blobFetches atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/v2/":
+			w.WriteHeader(http.StatusOK)
+		case "/v2/repo/manifests/latest", "/v2/repo/manifests/" + manifestDigest.String():
+			w.Header().Set("Content-Type", v1.MediaTypeImageManifest)
+			w.Header().Set("Docker-Content-Digest", manifestDigest.String())
+			w.Header().Set("Content-Length", fmt.Sprint(len(manifestPayload)))
+			if r.Method != http.MethodHead {
+				_, _ = w.Write(manifestPayload)
+			}
+		case "/v2/repo/blobs/" + layerDigest.String():
+			blobFetches.Add(1)
+			w.Header().Set("Content-Type", MediaTypeFliptNamespace)
+			w.Header().Set("Content-Length", fmt.Sprint(len(layerPayload)))
+			_, _ = w.Write(layerPayload)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	store, err := NewStore(&config.OCI{Repository: "http://" + strings.TrimPrefix(server.URL, "http://") + "/repo:latest"})
+	require.NoError(t, err)
+	first, err := store.Fetch(context.Background())
+	require.NoError(t, err)
+	snapshot, err := storagefs.SnapshotFromFiles(first.Files...)
+	require.NoError(t, err)
+	flag, err := snapshot.GetFlag(context.Background(), "production", "remote")
+	require.NoError(t, err)
+	assert.Equal(t, "Remote", flag.Name)
+	assert.EqualValues(t, 1, blobFetches.Load())
+
+	second, err := store.Fetch(context.Background(), IfNoMatch(first.Digest))
+	require.NoError(t, err)
+	assert.True(t, second.Matched)
+	assert.EqualValues(t, 1, blobFetches.Load())
+}
