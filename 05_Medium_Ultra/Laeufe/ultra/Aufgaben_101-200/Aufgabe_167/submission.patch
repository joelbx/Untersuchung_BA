+// encodingFormat returns a file extension and whether a layer must be
+// decompressed before passing its contents to the snapshot parser.
+func encodingFormat(encoding string) (string, bool) {
+	switch encoding {
+	case "", "json":
+		return "json", false
+	case "yaml", "yml":
+		return encoding, false
+	case "gzip", "json+gzip":
+		return "json", true
+	case "yaml+gzip", "yml+gzip":
+		return strings.TrimSuffix(encoding, "+gzip"), true
+	default:
+		return "", false
+	}
+}
+
+// setNamespace makes the layer annotation authoritative while retaining the
+// original bytes when the document already has the expected namespace.
+func setNamespace(payload []byte, format, namespace string) ([]byte, error) {
+	if namespace == "" {
+		return payload, nil
+	}
+
+	if format == "json" {
+		var doc map[string]json.RawMessage
+		if err := json.Unmarshal(payload, &doc); err != nil {
+			return nil, err
+		}
+		if doc == nil {
+			return nil, errors.New("expected a JSON object")
+		}
+		var current string
+		if value, ok := doc["namespace"]; ok {
+			if err := json.Unmarshal(value, &current); err != nil {
+				return nil, err
+			}
+		}
+		if current == namespace {
+			return payload, nil
+		}
+		value, err := json.Marshal(namespace)
+		if err != nil {
+			return nil, err
+		}
+		doc["namespace"] = value
+		return json.Marshal(doc)
+	}
+
+	decoder := yaml.NewDecoder(bytes.NewReader(payload))
+	var docs []*yaml.Node
+	changed := false
+	for {
+		var doc yaml.Node
+		if err := decoder.Decode(&doc); err != nil {
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			return nil, err
+		}
+		if len(doc.Content) != 1 || doc.Content[0].Kind != yaml.MappingNode {
+			return nil, errors.New("expected a YAML mapping")
+		}
+		mapping := doc.Content[0]
+		found := false
+		for i := 0; i+1 < len(mapping.Content); i += 2 {
+			if mapping.Content[i].Value == "namespace" {
+				found = true
+				if mapping.Content[i+1].Value != namespace {
+					mapping.Content[i+1] = &yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: namespace}
+					changed = true
+				}
+				break
+			}
+		}
+		if !found {
+			mapping.Content = append(mapping.Content,
+				&yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: "namespace"},
+				&yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: namespace})
+			changed = true
+		}
+		docs = append(docs, &doc)
+	}
+	if !changed {
+		return payload, nil
+	}
+	var out bytes.Buffer
+	encoder := yaml.NewEncoder(&out)
+	for _, doc := range docs {
+		if err := encoder.Encode(doc); err != nil {
+			return nil, err
+		}
+	}
+	if err := encoder.Close(); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
