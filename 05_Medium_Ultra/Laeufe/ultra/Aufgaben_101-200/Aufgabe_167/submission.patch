new file mode 100644
index 0000000..8509a0e
--- /dev/null
+++ b/internal/storage/fs/oci/source.go
@@ -0,0 +1,137 @@
+// Package oci provides a filesystem snapshot source backed by an OCI repository.
+package oci
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap"
+)
+
+var _ storagefs.SnapshotSource = (*Source)(nil)
+
+// Source builds snapshots from a reference in an OCI repository.
+type Source struct {
+	mu       sync.Mutex
+	snapshot *storagefs.StoreSnapshot
+	digest   digest.Digest
+	logger   *zap.Logger
+	interval time.Duration
+	store    *fliptoci.Store
+}
+
+// NewSource constructs a source for an OCI store.
+func NewSource(logger *zap.Logger, store *fliptoci.Store, opts ...containers.Option[Source]) (*Source, error) {
+	if store == nil {
+		return nil, fmt.Errorf("OCI store is nil")
+	}
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	s := &Source{
+		logger:   logger,
+		store:    store,
+		interval: 30 * time.Second,
+	}
+	containers.ApplyAll(s, opts...)
+	if s.interval <= 0 {
+		return nil, fmt.Errorf("OCI poll interval must be positive")
+	}
+	return s, nil
+}
+
+// WithPollInterval configures how often a subscription checks for updates.
+func WithPollInterval(tick time.Duration) containers.Option[Source] {
+	return func(s *Source) {
+		s.interval = tick
+	}
+}
+
+// String returns the source identifier.
+func (*Source) String() string {
+	return "oci"
+}
+
+// Get returns the current snapshot, rebuilding it when the OCI content changes.
+func (s *Source) Get(ctx context.Context) (*storagefs.StoreSnapshot, error) {
+	snapshot, _, err := s.fetch(ctx)
+	return snapshot, err
+}
+
+// fetch returns a snapshot and its digest from the same fetch operation.
+func (s *Source) fetch(ctx context.Context) (*storagefs.StoreSnapshot, digest.Digest, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.logger.Debug("fetching OCI snapshot")
+	response, err := s.store.Fetch(ctx, fliptoci.IfNoMatch(s.digest))
+	if err != nil {
+		s.logger.Error("fetching OCI snapshot failed", zap.Error(err))
+		return nil, "", err
+	}
+	if response.Matched {
+		if s.snapshot == nil {
+			return nil, "", fmt.Errorf("OCI content matched without an existing snapshot")
+		}
+		s.logger.Debug("OCI snapshot is unchanged", zap.Stringer("digest", s.digest))
+		return s.snapshot, s.digest, nil
+	}
+
+	snapshot, err := storagefs.SnapshotFromFiles(response.Files...)
+	if err != nil {
+		s.logger.Error("building OCI snapshot failed", zap.Error(err))
+		return nil, "", err
+	}
+
+	s.snapshot = snapshot
+	s.digest = response.Digest
+	s.logger.Debug("updated OCI snapshot", zap.Stringer("digest", s.digest))
+	return snapshot, s.digest, nil
+}
+
+// Subscribe sends a snapshot whenever the referenced OCI content changes.
+// It closes ch after the context is cancelled.
+func (s *Source) Subscribe(ctx context.Context, ch chan<- *storagefs.StoreSnapshot) {
+	defer close(ch)
+	ticker := time.NewTicker(s.interval)
+	defer ticker.Stop()
+	s.mu.Lock()
+	lastPublished := s.digest
+	s.mu.Unlock()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+
+		snapshot, current, err := s.fetch(ctx)
+		if err != nil {
+			if ctx.Err() != nil {
+				return
+			}
+			s.logger.Error("checking OCI snapshot failed", zap.Error(err))
+			continue
+		}
+
+		if current == lastPublished {
+			continue
+		}
+
+		s.logger.Debug("sending updated OCI snapshot")
+		select {
+		case ch <- snapshot:
+			lastPublished = current
+		case <-ctx.Done():
+			return
+		}
+	}
+}
