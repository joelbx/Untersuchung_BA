+package oci
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/internal/containers"
+	fliptoci "go.flipt.io/flipt/internal/oci"
+	storagefs "go.flipt.io/flipt/internal/storage/fs"
+	"go.uber.org/zap/zaptest"
+	"oras.land/oras-go/v2"
+	ocistore "oras.land/oras-go/v2/content/oci"
+)
+
+func publish(t *testing.T, layoutPath, flag string) {
+	t.Helper()
+	store, err := ocistore.New(layoutPath)
+	require.NoError(t, err)
+
+	content := fmt.Sprintf("flags:\n- key: %s\n  name: %s\n  enabled: true\n  variants: []\n  rules: []\nsegments: []\n", flag, flag)
+	layer := v1.Descriptor{
+		Digest:    digest.FromString(content),
+		Size:      int64(len(content)),
+		MediaType: fliptoci.MediaTypeFliptNamespace + "+yaml",
+		Annotations: map[string]string{
+			fliptoci.AnnotationFliptNamespace: "team",
+		},
+	}
+	ctx := context.Background()
+	require.NoError(t, store.Push(ctx, layer, bytes.NewReader([]byte(content))))
+	manifest, err := oras.PackManifest(ctx, store, oras.PackManifestVersion1_1_RC4, fliptoci.MediaTypeFliptFeatures, oras.PackManifestOptions{
+		Layers: []v1.Descriptor{layer},
+	})
+	require.NoError(t, err)
+	require.NoError(t, store.Tag(ctx, manifest, "latest"))
+}
+
+func newLocalSource(t *testing.T, opts ...containers.Option[Source]) (*Source, string) {
+	t.Helper()
+	dir := t.TempDir()
+	layoutPath := filepath.Join(dir, "flags")
+	publish(t, layoutPath, "first")
+	store, err := fliptoci.NewStore(&config.OCI{
+		BundleDirectory: dir,
+		Repository:      "flipt://local/flags:latest",
+	})
+	require.NoError(t, err)
+
+	source, err := NewSource(zaptest.NewLogger(t), store, opts...)
+	require.NoError(t, err)
+	return source, layoutPath
+}
+
+func TestSourceGetRereadsLocalLayout(t *testing.T) {
+	source, layoutPath := newLocalSource(t)
+	ctx := context.Background()
+	first, err := source.Get(ctx)
+	require.NoError(t, err)
+	assert.Equal(t, "oci", source.String())
+	assertFlag(t, first, "first")
+
+	unchanged, err := source.Get(ctx)
+	require.NoError(t, err)
+	assert.Same(t, first, unchanged)
+
+	publish(t, layoutPath, "second")
+	second, err := source.Get(ctx)
+	require.NoError(t, err)
+	assert.NotSame(t, first, second)
+	assertFlag(t, second, "second")
+}
+
+func TestSourceSubscribeSendsOnlyChangesAndCloses(t *testing.T) {
+	source, layoutPath := newLocalSource(t, WithPollInterval(10*time.Millisecond))
+	_, err := source.Get(context.Background())
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	updates := make(chan *storagefs.StoreSnapshot, 1)
+	go source.Subscribe(ctx, updates)
+
+	select {
+	case <-updates:
+		t.Fatal("unchanged OCI content produced an update")
+	case <-time.After(40 * time.Millisecond):
+	}
+
+	publish(t, layoutPath, "second")
+	select {
+	case snapshot := <-updates:
+		assertFlag(t, snapshot, "second")
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for OCI update")
+	}
+
+	select {
+	case <-updates:
+		t.Fatal("unchanged OCI content produced another update")
+	case <-time.After(40 * time.Millisecond):
+	}
+
+	cancel()
+	select {
+	case _, open := <-updates:
+		assert.False(t, open)
+	case <-time.After(2 * time.Second):
+		t.Fatal("subscription did not stop after cancellation")
+	}
+}
+
+func TestSourceSubscribePublishesChangeReadByGet(t *testing.T) {
+	source, layoutPath := newLocalSource(t, WithPollInterval(100*time.Millisecond))
+	_, err := source.Get(context.Background())
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	updates := make(chan *storagefs.StoreSnapshot, 1)
+	go source.Subscribe(ctx, updates)
+
+	// Let the subscription observe the initial digest before another caller
+	// reads an update. The update must still reach its subscriber.
+	select {
+	case <-updates:
+		t.Fatal("unchanged OCI content produced an update")
+	case <-time.After(120 * time.Millisecond):
+	}
+
+	publish(t, layoutPath, "second")
+	snapshot, err := source.Get(context.Background())
+	require.NoError(t, err)
+	assertFlag(t, snapshot, "second")
+
+	select {
+	case snapshot := <-updates:
+		assertFlag(t, snapshot, "second")
+	case <-time.After(time.Second):
+		t.Fatal("subscription missed content read by Get")
+	}
+}
+
+func assertFlag(t *testing.T, snapshot *storagefs.StoreSnapshot, key string) {
+	t.Helper()
+	flag, err := snapshot.GetFlag(context.Background(), "team", key)
+	require.NoError(t, err)
+	assert.Equal(t, key, flag.Key)
+}
