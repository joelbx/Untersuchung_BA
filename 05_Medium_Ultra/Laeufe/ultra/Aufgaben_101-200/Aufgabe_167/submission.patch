+func TestOCIStorageValidation(t *testing.T) {
+	tests := []struct {
+		name    string
+		oci     *OCI
+		wantErr string
+	}{
+		{name: "missing settings", wantErr: "oci storage repository must be specified"},
+		{name: "local reference", oci: &OCI{Repository: "flipt://local/features:latest"}},
+		{name: "http reference", oci: &OCI{Repository: "http://registry.example/features:latest"}},
+		{name: "https reference", oci: &OCI{Repository: "https://registry.example/features:latest"}},
+		{name: "unsupported scheme", oci: &OCI{Repository: "ftp://registry.example/features:latest"}, wantErr: `unexpected oci repository scheme: "ftp"`},
+		{name: "unexpected local registry", oci: &OCI{Repository: "flipt://registry.example/features:latest"}, wantErr: `unexpected local reference: "flipt://registry.example/features:latest"`},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := (&StorageConfig{Type: OCIStorageType, OCI: tt.oci}).validate()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+			} else {
+				require.EqualError(t, err, tt.wantErr)
+			}
+		})
+	}
+}
