+func TestLoadOCILocalReference(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("XDG_CONFIG_HOME", dir)
+	t.Setenv("APPDATA", dir)
+
+	configPath := filepath.Join(dir, "flipt.yml")
+	require.NoError(t, os.WriteFile(configPath, []byte("storage:\n  type: oci\n  oci:\n    repository: flipt://local/features:latest\n"), 0600))
+
+	result, err := Load(configPath)
+	require.NoError(t, err)
+	require.NotNil(t, result.Config.Storage.OCI)
+	assert.Equal(t, 30*time.Second, result.Config.Storage.OCI.PollInterval)
+
+	configDir, err := Dir()
+	require.NoError(t, err)
+	assert.Equal(t, filepath.Join(configDir, "bundles"), result.Config.Storage.OCI.BundleDirectory)
+}
