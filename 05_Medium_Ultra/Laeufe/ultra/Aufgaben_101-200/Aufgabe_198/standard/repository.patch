+		{name: "Red Hat bug fix", family: constant.RedHat, title: "RHBA-2024:1234: bug fix", wantID: "RHBA-2024:1234"},
+		{name: "CentOS", family: constant.CentOS, title: "RHSA-2024:1234: security update", wantID: "RHSA-2024:1234"},
+		{name: "Alma", family: constant.Alma, title: "RHBA-2024:1234: bug fix", wantID: "RHBA-2024:1234"},
+		{name: "Rocky", family: constant.Rocky, title: "RHSA-2024:1234: security update", wantID: "RHSA-2024:1234"},
+		{name: "Oracle", family: constant.Oracle, title: "ELSA-2024-1234: security update", wantID: "ELSA-2024-1234"},
+		{name: "Amazon", family: constant.Amazon, title: "ALAS2-2024-1234: security update", wantID: "ALAS2-2024-1234"},
+		{name: "Amazon 2023", family: constant.Amazon, title: "ALAS2023-2024-1234", wantID: "ALAS2023-2024-1234"},
+		{name: "Fedora", family: constant.Fedora, title: "FEDORA-2024-1234: security update", wantID: "FEDORA-2024-1234"},
+		{name: "wrong Red Hat prefix", family: constant.RedHat, title: "ELSA-2024-1234: security update"},
+		{name: "wrong Oracle prefix", family: constant.Oracle, title: "RHSA-2024:1234: security update"},
+		{name: "wrong Amazon prefix", family: constant.Amazon, title: "RHSA-2024:1234: security update"},
+		{name: "wrong Fedora prefix", family: constant.Fedora, title: "ALAS2-2024-1234: security update"},
+		{name: "unsupported title", family: constant.RedHat, title: "CVE-2024-1234"},
+		{name: "empty title", family: constant.RedHat, title: "  "},
+		{name: "unsupported family", family: constant.Ubuntu, title: "RHSA-2024:1234"},
