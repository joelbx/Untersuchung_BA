+func componentMatchLevel(component string, pack ovalmodels.Package) int {
+	if pack.ModularityLabel != "" {
+		// A resolution can name a module instead of a binary package. A full
+		// label may include version, context and architecture after name:stream.
+		parts := strings.Split(pack.ModularityLabel, ":")
+		if len(parts) >= 2 {
+			module := parts[0] + ":" + parts[1]
+			if component == module || component == pack.ModularityLabel ||
+				component == module+"::"+pack.Name || component == pack.ModularityLabel+"::"+pack.Name {
+				return 2
+			}
+		}
+	}
+	if component == pack.Name {
+		return 1
+	}
+	return 0
 }
 
