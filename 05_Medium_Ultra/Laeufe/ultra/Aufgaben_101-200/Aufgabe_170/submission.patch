+def add_db_name(rec: dict) -> None:
+    """Add a name with available dates to each author in ``rec``, in place."""
+    for author in rec.get('authors') or []:
+        if not isinstance(author, dict):
+            continue
+        if author.get('db_name'):
+            continue
+        name = author.get('name')
+        if not name:
+            author['db_name'] = author.get('db_name') or ''
+            continue
+
+        date = author.get('date')
+        if not date:
+            birth = author.get('birth_date') or ''
+            death = author.get('death_date') or ''
+            if birth or death:
+                date = f'{birth}-{death}'
+        author['db_name'] = f'{name} {date}' if date else name
+
+
+def expand_record(rec: dict) -> dict:
+    """Build the fields used to compare a raw or already expanded edition."""
+    title = rec.get('title')
+    if title:
+        prefix = rec.get('title_prefix') or ''
+        if prefix and not prefix.endswith(' '):
+            prefix += ' '
+        full_title = prefix + title
+        if subtitle := rec.get('subtitle'):
+            full_title += f' {subtitle}'
+    else:
+        full_title = rec.get('full_title') or rec.get('normalized_title') or ''
+
+    # Keep the legacy side effect used by callers of catalog.utils.expand_record.
+    rec['full_title'] = full_title
+    expanded_rec = build_titles(full_title)
+    expanded_rec['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field) or []
+        expanded_rec['isbn'].extend(
+            value for value in ([values] if isinstance(values, str) else values) if value
+        )
+
+    country = rec.get('publish_country')
+    if country and country.strip() and country != '|||':
+        expanded_rec['publish_country'] = country
+
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if field in rec and rec[field] is not None:
+            expanded_rec[field] = rec[field]
+
+    add_db_name(expanded_rec)
+    if 'contribs' in expanded_rec:
+        add_db_name({'authors': expanded_rec['contribs']})
+    return expanded_rec
+
