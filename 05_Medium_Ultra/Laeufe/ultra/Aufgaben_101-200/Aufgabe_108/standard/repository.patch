diff --git a/utils/cache/simple_cache.go b/utils/cache/simple_cache.go
new file mode 100644
index 0000000..b743344
--- /dev/null
+++ b/utils/cache/simple_cache.go
@@ -0,0 +1,160 @@
+package cache
+
+import (
+	"fmt"
+	"sort"
+	"sync"
+	"time"
+)
+
+// SimpleCache stores typed values under string keys. Reading an entry does not
+// extend its lifetime.
+type SimpleCache[V any] interface {
+	Add(key string, value V) error
+	AddWithTTL(key string, value V, ttl time.Duration) error
+	Get(key string) (V, error)
+	GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error)
+	Keys() []string
+}
+
+type cacheEntry[V any] struct {
+	value     V
+	expiresAt time.Time
+	sequence  uint64
+	timer     *time.Timer
+}
+
+type simpleCache[V any] struct {
+	mu           sync.Mutex
+	entries      map[string]cacheEntry[V]
+	limit        int
+	nextSequence uint64
+}
+
+// NewSimpleCache constructs a cache with no size limit. Entries added without
+// a TTL remain until they are replaced.
+func NewSimpleCache[V any]() SimpleCache[V] {
+	return newSimpleCacheWithLimit[V](0)
+}
+
+// newSimpleCacheWithLimit retains a size bound for caches that need one.
+// The oldest inserted entry is removed when the limit is reached.
+func newSimpleCacheWithLimit[V any](limit int) SimpleCache[V] {
+	return &simpleCache[V]{entries: make(map[string]cacheEntry[V]), limit: limit}
+}
+
+func (c *simpleCache[V]) Add(key string, value V) error {
+	c.set(key, value, time.Time{})
+	return nil
+}
+
+func (c *simpleCache[V]) AddWithTTL(key string, value V, ttl time.Duration) error {
+	if ttl <= 0 {
+		c.mu.Lock()
+		c.deleteEntry(key)
+		c.mu.Unlock()
+		return nil
+	}
+	c.set(key, value, time.Now().Add(ttl))
+	return nil
+}
+
+func (c *simpleCache[V]) set(key string, value V, expiresAt time.Time) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if _, exists := c.entries[key]; exists {
+		c.deleteEntry(key)
+	}
+	if c.limit > 0 && len(c.entries) >= c.limit {
+		c.removeExpired(time.Now())
+		if len(c.entries) >= c.limit {
+			var oldestKey string
+			var oldestSequence uint64
+			first := true
+			for k, entry := range c.entries {
+				if first || entry.sequence < oldestSequence {
+					oldestKey, oldestSequence, first = k, entry.sequence, false
+				}
+			}
+			c.deleteEntry(oldestKey)
+		}
+	}
+
+	c.nextSequence++
+	entry := cacheEntry[V]{value: value, expiresAt: expiresAt, sequence: c.nextSequence}
+	if !expiresAt.IsZero() {
+		sequence := entry.sequence
+		entry.timer = time.AfterFunc(time.Until(expiresAt), func() {
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			current, exists := c.entries[key]
+			if exists && current.sequence == sequence && !time.Now().Before(current.expiresAt) {
+				c.deleteEntry(key)
+			}
+		})
+	}
+	c.entries[key] = entry
+}
+
+func (c *simpleCache[V]) Get(key string) (V, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	entry, exists := c.entries[key]
+	if exists && (entry.expiresAt.IsZero() || time.Now().Before(entry.expiresAt)) {
+		return entry.value, nil
+	}
+	c.deleteEntry(key)
+	var zero V
+	return zero, fmt.Errorf("cache: key %q not found", key)
+}
+
+func (c *simpleCache[V]) GetWithLoader(key string, loader func(key string) (V, time.Duration, error)) (V, error) {
+	if value, err := c.Get(key); err == nil {
+		return value, nil
+	}
+
+	value, ttl, err := loader(key)
+	if err != nil {
+		var zero V
+		return zero, err
+	}
+	if err := c.AddWithTTL(key, value, ttl); err != nil {
+		var zero V
+		return zero, err
+	}
+	return value, nil
+}
+
+func (c *simpleCache[V]) Keys() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.removeExpired(time.Now())
+	keys := make([]string, 0, len(c.entries))
+	for key := range c.entries {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// removeExpired requires c.mu to be held.
+func (c *simpleCache[V]) removeExpired(now time.Time) {
+	for key, entry := range c.entries {
+		if !entry.expiresAt.IsZero() && !now.Before(entry.expiresAt) {
+			c.deleteEntry(key)
+		}
+	}
+}
+
+// deleteEntry requires c.mu to be held.
+func (c *simpleCache[V]) deleteEntry(key string) {
+	if entry, exists := c.entries[key]; exists {
+		if entry.timer != nil {
+			entry.timer.Stop()
+		}
+		delete(c.entries, key)
+	}
+}
diff --git a/utils/cache/simple_cache_test.go b/utils/cache/simple_cache_test.go
new file mode 100644
index 0000000..7bc4e13
--- /dev/null
+++ b/utils/cache/simple_cache_test.go
@@ -0,0 +1,83 @@
+package cache
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestSimpleCacheAddAndGet(t *testing.T) {
+	c := NewSimpleCache[int]()
+	if err := c.Add("one", 42); err != nil {
+		t.Fatal(err)
+	}
+	if value, err := c.Get("one"); err != nil || value != 42 {
+		t.Fatalf("Get(one) = %d, %v; want 42, nil", value, err)
+	}
+	if value, err := c.Get("missing"); err == nil || value != 0 {
+		t.Fatalf("Get(missing) = %d, %v; want zero value and an error", value, err)
+	}
+}
+
+func TestSimpleCacheExpirationAndKeys(t *testing.T) {
+	c := NewSimpleCache[string]()
+	if err := c.Add("persistent", "kept"); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.AddWithTTL("temporary", "value", 100*time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	if value, err := c.Get("temporary"); err != nil || value != "value" {
+		t.Fatalf("Get(temporary) before expiry = %q, %v", value, err)
+	}
+	if got := c.Keys(); !reflect.DeepEqual(got, []string{"persistent", "temporary"}) {
+		t.Fatalf("Keys before expiry = %v", got)
+	}
+
+	time.Sleep(150 * time.Millisecond)
+	if value, err := c.Get("temporary"); err == nil || value != "" {
+		t.Fatalf("Get(temporary) after expiry = %q, %v; want zero value and an error", value, err)
+	}
+	if got := c.Keys(); !reflect.DeepEqual(got, []string{"persistent"}) {
+		t.Fatalf("Keys after expiry = %v", got)
+	}
+}
+
+func TestSimpleCacheGetWithLoader(t *testing.T) {
+	c := NewSimpleCache[string]()
+	loads := 0
+	loader := func(key string) (string, time.Duration, error) {
+		loads++
+		return key + "-value", time.Minute, nil
+	}
+	for range 2 {
+		if value, err := c.GetWithLoader("one", loader); err != nil || value != "one-value" {
+			t.Fatalf("GetWithLoader(one) = %q, %v", value, err)
+		}
+	}
+	if loads != 1 {
+		t.Fatalf("loader called %d times; want once", loads)
+	}
+
+	loadErr := errors.New("load failed")
+	value, err := c.GetWithLoader("failed", func(string) (string, time.Duration, error) {
+		return "unused", time.Minute, loadErr
+	})
+	if err != loadErr || value != "" {
+		t.Fatalf("GetWithLoader(failed) = %q, %v; want zero value and original error", value, err)
+	}
+	if _, err := c.Get("failed"); err == nil {
+		t.Fatal("failed load was cached")
+	}
+}
+
+func TestSimpleCacheSizeLimit(t *testing.T) {
+	c := newSimpleCacheWithLimit[int](2)
+	_ = c.Add("first", 1)
+	_ = c.Add("second", 2)
+	_ = c.Add("third", 3)
+	if got := c.Keys(); !reflect.DeepEqual(got, []string{"second", "third"}) {
+		t.Fatalf("Keys after eviction = %v", got)
+	}
+}
