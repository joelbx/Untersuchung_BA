+# -*- coding: utf-8 -*-
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from queue import Queue
+from unittest.mock import MagicMock, call
+
+from ansible.executor.task_queue_manager import DisplaySend
+from ansible.plugins.strategy import StrategyBase
+
+
+def test_strategy_cleanup_drains_pending_display_events(mocker):
+    final_q = Queue()
+    tqm = MagicMock()
+    tqm._workers = []
+    tqm._final_q = final_q
+    display = mocker.patch('ansible.plugins.strategy.display.display')
+    strategy = StrategyBase(tqm)
+
+    final_q.put(DisplaySend('first', color='blue', stderr=True))
+    final_q.put(DisplaySend('second', screen_only=True, newline=False))
+    strategy.cleanup()
+
+    assert display.call_args_list == [
+        call('first', color='blue', stderr=True),
+        call('second', screen_only=True, newline=False),
+    ]
