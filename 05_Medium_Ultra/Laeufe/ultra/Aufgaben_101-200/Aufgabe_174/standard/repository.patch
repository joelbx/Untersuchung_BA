index 0000000..24b78b4
--- /dev/null
+++ b/test/units/executor/test_final_queue_display.py
@@ -0,0 +1,95 @@
+# -*- coding: utf-8 -*-
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from unittest.mock import MagicMock
+
+from ansible.executor.task_queue_manager import DisplaySend, FinalQueue, TaskQueueManager
+from ansible.utils.display import Display
+from ansible.utils.multiprocessing import context as multiprocessing_context
+
+
+def _send_display_from_fork(final_q):
+    display = Display()
+    display.set_queue(final_q)
+    display.display('from child', stderr=True, newline=False)
+
+
+def test_display_send_preserves_call_arguments():
+    event = DisplaySend('message', 'blue', stderr=True, screen_only=True, log_only=False, newline=False)
+
+    assert event.args == ('message', 'blue')
+    assert event.kwargs == {
+        'stderr': True,
+        'screen_only': True,
+        'log_only': False,
+        'newline': False,
+    }
+
+
+def test_final_queue_sends_display_event_without_blocking(mocker):
+    queue = FinalQueue()
+    put = mocker.patch.object(queue, 'put')
+
+    try:
+        queue.send_display('message', color='blue', stderr=True, screen_only=True, log_only=False, newline=False)
+    finally:
+        queue.close()
+
+    put.assert_called_once()
+    event = put.call_args[0][0]
+    assert isinstance(event, DisplaySend)
+    assert event.args == ('message',)
+    assert event.kwargs == {
+        'color': 'blue',
+        'stderr': True,
+        'screen_only': True,
+        'log_only': False,
+        'newline': False,
+    }
+    assert put.call_args[1] == {'block': False}
+
+
+def test_forked_display_round_trip_while_parent_lock_is_held():
+    final_q = FinalQueue()
+    display = Display()
+    worker = multiprocessing_context.Process(target=_send_display_from_fork, args=(final_q,))
+    display._lock.acquire()
+
+    try:
+        worker.start()
+        event = final_q.get(timeout=5)
+        worker.join(timeout=5)
+        assert worker.exitcode == 0
+        assert isinstance(event, DisplaySend)
+        assert event.args == ('from child',)
+        assert event.kwargs['stderr'] is True
+        assert event.kwargs['newline'] is False
+    finally:
+        if worker.is_alive():
+            worker.terminate()
+            worker.join(timeout=5)
+        display._lock.release()
+        final_q.close()
+        final_q.join_thread()
+
+
+def test_cleanup_flushes_both_output_streams(mocker):
+    tqm = TaskQueueManager.__new__(TaskQueueManager)
+    tqm._final_q = MagicMock()
+    tqm._workers = []
+    tqm.terminate = MagicMock()
+    stdout = MagicMock()
+    stderr = MagicMock()
+    mocker.patch('ansible.executor.task_queue_manager.display.debug')
+    mocker.patch('ansible.executor.task_queue_manager.sys.stdout', stdout)
+    mocker.patch('ansible.executor.task_queue_manager.sys.stderr', stderr)
+
+    tqm.cleanup()
+
+    tqm.terminate.assert_called_once_with()
+    tqm._final_q.close.assert_called_once_with()
+    stdout.flush.assert_called_once_with()
+    stderr.flush.assert_called_once_with()
