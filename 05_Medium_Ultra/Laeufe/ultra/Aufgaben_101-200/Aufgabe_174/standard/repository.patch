+
+def test_parent_display_holds_lock_while_writing(monkeypatch, mocker):
+    display = Display()
+    monkeypatch.setattr(display, '_final_q', None)
+    assert isinstance(display._lock, type(threading.Lock()))
+
+    def check_lock(*args):
+        assert display._lock.locked()
+
+    write = mocker.patch.object(display, '_display', side_effect=check_lock)
+    display.display('parent message', stderr=True)
+
+    write.assert_called_once_with('parent message', None, True, False, False, True)
+    assert not display._lock.locked()
