+def test_forked_display_sends_all_arguments_without_taking_parent_lock(monkeypatch, mocker):
+    display = Display()
+    queue = mocker.Mock()
+    lock = mocker.MagicMock()
+    monkeypatch.setattr(display, '_parent_pid', os.getpid() + 1)
+    monkeypatch.setattr(display, '_final_q', None)
