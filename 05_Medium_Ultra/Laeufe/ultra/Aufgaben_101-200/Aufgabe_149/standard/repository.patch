diff --git a/tests/unit/config/test_qtargs.py b/tests/unit/config/test_qtargs.py
index b38fab4..ddd39f8 100644
--- a/tests/unit/config/test_qtargs.py
+++ b/tests/unit/config/test_qtargs.py
@@ -383,6 +383,58 @@ class TestQtArgs:
         assert combined_flag in args
         assert overlay_flag not in args
 
+    @pytest.mark.parametrize('enable_via_commandline', [True, False])
+    @pytest.mark.parametrize('disable_via_commandline', [True, False])
+    def test_enabled_and_disabled_features(self, config_stub, monkeypatch,
+                                           parser, enable_via_commandline,
+                                           disable_via_commandline):
+        """Keep disabled features separate while combining enabled ones."""
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'overlay'
+
+        enabled = 'enable-features=FirstFeature,SecondFeature'
+        disabled = ['disable-features=OverlayScrollbar,BlockedTwo',
+                    'disable-features=BlockedThree']
+        cli_flags = []
+        config_flags = []
+        for flag, via_commandline in [(enabled, enable_via_commandline)] + [
+                (flag, disable_via_commandline) for flag in disabled]:
+            if via_commandline:
+                cli_flags.extend(['--qt-flag', flag])
+            else:
+                config_flags.append(flag)
+
+        config_stub.val.qt.args = config_flags
+        args = qtargs.qt_args(parser.parse_args(cli_flags))
+
+        enabled_flags = [arg for arg in args
+                         if arg.startswith('--enable-features=')]
+        assert enabled_flags == [
+            '--enable-features=FirstFeature,SecondFeature,OverlayScrollbar']
+        disabled_flags = [arg for arg in args
+                          if arg.startswith('--disable-features=')]
+        assert sorted(disabled_flags) == sorted('--' + flag for flag in disabled)
+        assert args.index(enabled_flags[0]) < args.index('--' + disabled[0])
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disabled_features_only(self, config_stub, monkeypatch, parser,
+                                    via_commandline):
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        config_stub.val.scrolling.bar = 'never'
+
+        flag = 'disable-features=BlockedOne,BlockedTwo'
+        config_stub.val.qt.args = [] if via_commandline else [flag]
+        cli_flags = ['--qt-flag', flag] if via_commandline else []
+        args = qtargs.qt_args(parser.parse_args(cli_flags))
+
+        assert '--' + flag in args
+        assert not any(arg.startswith('--enable-features=') for arg in args)
+
