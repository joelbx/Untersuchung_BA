@@ -0,0 +1,93 @@
+package sbom
+
+import (
+	"testing"
+
+	ftypes "github.com/aquasecurity/trivy/pkg/fanal/types"
+
+	"github.com/future-architect/vuls/models"
+)
+
+func TestParsePkgName(t *testing.T) {
+	tests := []struct {
+		name      string
+		pkgType   string
+		pkgName   string
+		namespace string
+		parsed    string
+		subpath   string
+	}{
+		{name: "maven", pkgType: "maven", pkgName: "com.google.guava:guava", namespace: "com.google.guava", parsed: "guava"},
+		{name: "maven without group", pkgType: "maven", pkgName: "guava", parsed: "guava"},
+		{name: "pypi", pkgType: "pypi", pkgName: "My_Package_NAME", parsed: "my-package-name"},
+		{name: "golang", pkgType: "golang", pkgName: "github.com/protobom/protobom", namespace: "github.com/protobom", parsed: "protobom"},
+		{name: "golang nested path", pkgType: "golang", pkgName: "github.com/acme/lib/v2", namespace: "github.com/acme/lib", parsed: "v2"},
+		{name: "npm scoped", pkgType: "npm", pkgName: "@babel/core", namespace: "@babel", parsed: "core"},
+		{name: "npm unscoped", pkgType: "npm", pkgName: "react", parsed: "react"},
+		{name: "cocoapods", pkgType: "cocoapods", pkgName: "GoogleUtilities/NSData+zlib", parsed: "GoogleUtilities", subpath: "NSData+zlib"},
+		{name: "cocoapods without subpath", pkgType: "cocoapods", pkgName: "GoogleUtilities", parsed: "GoogleUtilities"},
+		{name: "other type", pkgType: "cargo", pkgName: "acme/widget", parsed: "acme/widget"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			namespace, name, subpath := parsePkgName(tt.pkgType, tt.pkgName)
+			if namespace != tt.namespace || name != tt.parsed || subpath != tt.subpath {
+				t.Errorf("parsePkgName(%q, %q) = (%q, %q, %q), want (%q, %q, %q)", tt.pkgType, tt.pkgName, namespace, name, subpath, tt.namespace, tt.parsed, tt.subpath)
+			}
+		})
+	}
+}
+
+func TestLibraryPackageURLs(t *testing.T) {
+	tests := []struct {
+		name    string
+		libType ftypes.LangType
+		libName string
+		want    string
+	}{
+		{name: "maven", libType: ftypes.Pom, libName: "com.google.guava:guava", want: "pkg:maven/com.google.guava/guava@1.0.0?file_path=lockfile"},
+		{name: "pypi", libType: ftypes.Pip, libName: "My_Package", want: "pkg:pypi/my-package@1.0.0?file_path=lockfile"},
+		{name: "golang", libType: ftypes.GoModule, libName: "github.com/protobom/protobom", want: "pkg:golang/github.com/protobom/protobom@1.0.0?file_path=lockfile"},
+		{name: "npm", libType: ftypes.Npm, libName: "@babel/core", want: "pkg:npm/%40babel/core@1.0.0?file_path=lockfile"},
+		{name: "cocoapods", libType: ftypes.Cocoapods, libName: "GoogleUtilities/NSData+zlib", want: "pkg:cocoapods/GoogleUtilities@1.0.0?file_path=lockfile#NSData+zlib"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			libscanner := models.LibraryScanner{
+				Type:         tt.libType,
+				LockfilePath: "lockfile",
+				Libs:         []models.Library{{Name: tt.libName, Version: "1.0.0"}},
+			}
+			pkgToPURL := map[string]map[string]string{"lockfile": {}}
+			components := libpkgToCdxComponents(libscanner, pkgToPURL)
+			if got := components[1].PackageURL; got != tt.want {
+				t.Errorf("package URL = %q, want %q", got, tt.want)
+			}
+			if got := pkgToPURL["lockfile"][tt.libName]; got != tt.want {
+				t.Errorf("package URL lookup = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestGitHubManifestPackageURL(t *testing.T) {
+	manifest := models.DependencyGraphManifest{
+		Filename:   "pom.xml",
+		Repository: "https://example.com/acme/repo",
+		Dependencies: []models.Dependency{{
+			PackageName:  "com.google.guava:guava",
+			Requirements: "= 1.0.0",
+		}},
+	}
+	pkgToPURL := map[string]map[string]string{manifest.RepoURLFilename(): {}}
+	components := ghpkgToCdxComponents(manifest, pkgToPURL)
+	want := "pkg:maven/com.google.guava/guava@1.0.0?file_path=pom.xml&repo_url=https%3A%2F%2Fexample.com%2Facme%2Frepo"
+	if got := components[1].PackageURL; got != want {
+		t.Errorf("package URL = %q, want %q", got, want)
+	}
+	if got := pkgToPURL[manifest.RepoURLFilename()][manifest.Dependencies[0].PackageName]; got != want {
+		t.Errorf("package URL lookup = %q, want %q", got, want)
+	}
+}
