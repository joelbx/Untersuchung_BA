+func purlPkgType(t string) string {
+	switch t {
+	case string(ftypes.Jar), string(ftypes.Pom), string(ftypes.Gradle):
+		return "maven"
+	case string(ftypes.Pip), string(ftypes.Pipenv), string(ftypes.Poetry), string(ftypes.Uv), string(ftypes.PythonPkg):
+		return "pypi"
+	case string(ftypes.GoBinary), string(ftypes.GoModule):
+		return "golang"
+	case string(ftypes.Npm), string(ftypes.Yarn), string(ftypes.Pnpm), string(ftypes.NodePkg), string(ftypes.JavaScript):
+		return "npm"
+	case string(ftypes.Cocoapods):
+		return "cocoapods"
+	default:
+		return t
+	}
+}
+
+func parsePkgName(t, n string) (namespace, name, subpath string) {
+	name = n
+	switch t {
+	case "maven":
+		if group, artifact, ok := strings.Cut(n, ":"); ok {
+			return group, artifact, ""
+		}
+	case "pypi":
+		name = strings.ToLower(strings.ReplaceAll(n, "_", "-"))
+	case "golang":
+		if i := strings.LastIndex(n, "/"); i >= 0 {
+			return n[:i], n[i+1:], ""
+		}
+	case "npm":
+		if strings.HasPrefix(n, "@") {
+			if scope, pkg, ok := strings.Cut(n, "/"); ok {
+				return scope, pkg, ""
+			}
+		}
+	case "cocoapods":
+		if main, part, ok := strings.Cut(n, "/"); ok {
+			return "", main, part
+		}
+	}
+	return "", name, ""
+}
