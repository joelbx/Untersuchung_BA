diff --git a/openlibrary/catalog/utils/__init__.py b/openlibrary/catalog/utils/__init__.py
index 0833435..29d349c 100644
--- a/openlibrary/catalog/utils/__init__.py
+++ b/openlibrary/catalog/utils/__init__.py
@@ -5,6 +5,87 @@ from unicodedata import normalize
 import openlibrary.catalog.merge.normalize as merge
 
 
+re_amazon_title_paren = re.compile(r'^(.*) \([^)]+?\)$')
+
+
+def _normalize_title(title: str) -> str:
+    """Normalize a title for comparison and remove remaining punctuation."""
+    legacy_normalized = merge.normalize(title)
+    without_punctuation = ''.join(
+        c if c.isalnum() or c.isspace() else ' ' for c in legacy_normalized
+    )
+    return ' '.join(without_punctuation.split())
+
+
+def build_titles(title: str) -> dict[str, str | list[str]]:
+    """Expand a full title into forms useful for edition matching."""
+    normalized_title = _normalize_title(title)
+    titles = [title]
+    if title.strip() != title:
+        titles.append(title.strip())
+    titles.extend([normalized_title, merge.normalize(title).lower()])
+
+    if ' & ' in title:
+        with_and = title.replace(' & ', ' and ')
+        titles.extend([with_and, merge.normalize(with_and), _normalize_title(with_and)])
+
+    for variant in titles.copy():
+        if variant.lower().startswith('the '):
+            titles.append(variant[4:])
+        elif variant.lower().startswith('a '):
+            titles.append(variant[2:])
+
+    for variant in titles.copy():
+        if match := re_amazon_title_paren.match(variant):
+            without_parenthetical = match.group(1)
+            titles.extend(
+                [
+                    without_parenthetical,
+                    merge.normalize(without_parenthetical),
+                    _normalize_title(without_parenthetical),
+                ]
+            )
+
+    return {
+        'full_title': title,
+        'normalized_title': normalized_title,
+        'titles': list(dict.fromkeys(titles)),
+        'short_title': normalized_title[:25],
+    }
+
+
+def expand_record(rec: dict) -> dict[str, str | list[str]]:
+    """Expand an edition record for title, ISBN, and field comparisons.
+
+    ``rec`` must include ``full_title``. ISBN variants are combined into one
+    list, and comparison fields are copied when present.
+    """
+    expanded: dict = build_titles(rec['full_title'])
+    expanded['isbn'] = []
+    for field in ('isbn', 'isbn_10', 'isbn_13'):
+        values = rec.get(field, [])
+        if isinstance(values, str):
+            expanded['isbn'].append(values)
+        elif values:
+            expanded['isbn'].extend(values)
+
+    for field in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if field in rec:
+            expanded[field] = rec[field]
+
+    if 'publish_country' in rec and rec['publish_country'] not in ('   ', '|||'):
+        expanded['publish_country'] = rec['publish_country']
+
+    return expanded
+
+
 def cmp(x, y):
     return (x > y) - (x < y)
 
