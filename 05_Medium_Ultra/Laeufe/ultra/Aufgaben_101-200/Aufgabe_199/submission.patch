+           b'<file name="item_text.txt"><size>5</size></file></files>')
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', lambda url: make_response(xml))
+
+    assert list(get_ia.files('item')) == [('item_meta.mrc', 10)]
+
+
+def test_marc_formats_parses_xml_response_content(monkeypatch):
