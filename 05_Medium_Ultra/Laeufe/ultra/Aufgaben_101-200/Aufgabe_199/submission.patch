 from __future__ import print_function
 import os
 import pytest
+import requests
 from openlibrary.catalog import get_ia
 from openlibrary.core import ia
 from openlibrary.catalog.marc.marc_xml import MarcXml
 from openlibrary.catalog.marc.marc_binary import MarcBinary, BadLength, BadMARC
 
+
+def make_response(content, status_code=200, headers=None, encoding=None):
+    response = requests.Response()
+    response._content = content
+    response.status_code = status_code
+    response.url = 'https://example.org/test'
+    response.encoding = encoding
+    response.headers.update(headers or {})
+    return response
+
 def return_test_marc_bin(url):
     assert url, "return_test_marc_bin({})".format(url)
     return return_test_marc_data(url, "bin_input")
@@ -18,7 +29,110 @@ def return_test_marc_data(url, test_data_subdir="xml_input"):
     filename = url.split('/')[-1]
     test_data_dir = "/../../catalog/marc/tests/test_data/%s/" % test_data_subdir
     path = os.path.dirname(__file__) + test_data_dir + filename
-    return open(path, mode='rb')
+    with open(path, mode='rb') as marc_file:
+        return make_response(marc_file.read())
+
+
+def test_urlopen_keep_trying_forwards_headers_and_kwargs(monkeypatch):
+    calls = []
+    response = make_response(b'catalog data')
+
+    def fake_get(url, **kwargs):
+        calls.append((url, kwargs))
+        return response
+
+    monkeypatch.setattr(get_ia.requests, 'get', fake_get)
+
+    result = get_ia.urlopen_keep_trying(
+        'https://example.org/catalog', headers={'Accept': 'application/xml'}, timeout=7
+    )
+
+    assert result is response
+    assert calls == [(
+        'https://example.org/catalog',
+        {'headers': {'Accept': 'application/xml'}, 'timeout': 7},
+    )]
+
+
+def test_urlopen_keep_trying_retries_http_errors(monkeypatch):
+    responses = [make_response(b'', status_code=500), make_response(b'catalog data')]
+    sleeps = []
+    monkeypatch.setattr(get_ia.requests, 'get', lambda url, **kwargs: responses.pop(0))
+    monkeypatch.setattr(get_ia, 'sleep', sleeps.append)
+
+    assert get_ia.urlopen_keep_trying('https://example.org/catalog').content == b'catalog data'
+    assert sleeps == [2]
+
+
+@pytest.mark.parametrize('status_code', [403, 404, 416])
+def test_urlopen_keep_trying_raises_permanent_http_errors(monkeypatch, status_code):
+    response = make_response(b'', status_code=status_code)
+    monkeypatch.setattr(get_ia.requests, 'get', lambda url, **kwargs: response)
+    monkeypatch.setattr(get_ia, 'sleep', lambda seconds: pytest.fail('unexpected retry'))
+
+    with pytest.raises(requests.exceptions.HTTPError) as error:
+        get_ia.urlopen_keep_trying('https://example.org/catalog')
+
+    assert error.value.response.status_code == status_code
+
+
+@pytest.mark.parametrize('response, expected_encoding, expected_text', [
+    (make_response('caf\u00e9'.encode('utf-8'), headers={'Content-Type': 'text/plain'},
+                   encoding='ISO-8859-1'), 'utf-8', 'caf\u00e9'),
+    (make_response('caf\u00e9'.encode('iso-8859-1'),
+                   headers={'Content-Type': 'text/plain; charset=iso-8859-1'},
+                   encoding='iso-8859-1'), 'iso-8859-1', 'caf\u00e9'),
+])
+def test_urlopen_keep_trying_honors_charset(monkeypatch, response, expected_encoding, expected_text):
+    monkeypatch.setattr(get_ia.requests, 'get', lambda url, **kwargs: response)
+
+    result = get_ia.urlopen_keep_trying('https://example.org/catalog')
+
+    assert result.encoding.lower() == expected_encoding.lower()
+    assert result.text == expected_text
+
+
+def test_get_from_archive_bulk_requests_range_and_truncates_response(monkeypatch):
+    calls = []
+    monkeypatch.setattr(get_ia, 'MAX_MARC_LENGTH', 15)
+
+    def fake_urlopen(url, headers=None, **kwargs):
+        calls.append((url, headers))
+        return make_response(b'00010abcde00005' + b'ignored extra bytes')
+
+    monkeypatch.setattr(get_ia, 'urlopen_keep_trying', fake_urlopen)
+
+    result = get_ia.get_from_archive_bulk('marc:item/file.mrc:20:10')
+
+    assert calls == [(
+        get_ia.IA_DOWNLOAD_URL + 'item/file.mrc',
+        {'Range': 'bytes=20-34'},
+    )]
+    assert result == (b'00010abcde', 30, 5)
+
+
+def test_files_parses_xml_response_content(monkeypatch):
