+
+package parse
+
+import (
+	"fmt"
+	"net/mail"
+	"reflect"
+	"regexp"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+// Expr is a parsed string or boolean expression. String expressions evaluate
+// to []string and boolean expressions evaluate to bool.
+type Expr interface {
+	fmt.Stringer
+	Kind() reflect.Kind
+	Evaluate(EvaluateContext) (any, error)
+}
+
+// EvaluateContext supplies values for variables and input for regex predicates.
+type EvaluateContext struct {
+	VarValue     func(VarExpr) ([]string, error)
+	MatcherInput string
+}
+
+// StringLitExpr is a constant string.
+type StringLitExpr struct{ Value string }
+
+func (e StringLitExpr) String() string   { return fmt.Sprintf("%q", e.Value) }
+func (StringLitExpr) Kind() reflect.Kind { return reflect.String }
+func (e StringLitExpr) Evaluate(EvaluateContext) (any, error) {
+	return []string{e.Value}, nil
+}
+
+// VarExpr is a namespaced variable.
+type VarExpr struct {
+	Namespace string
+	Name      string
+}
+
+func (e VarExpr) String() string   { return e.Namespace + "." + e.Name }
+func (VarExpr) Kind() reflect.Kind { return reflect.String }
+func (e VarExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	if err := validateNamespace(e.Namespace); err != nil {
+		return nil, trace.Wrap(err)
+	}
+	if e.Name == "" {
+		return nil, trace.BadParameter("incomplete variable %q: expected namespace.name or namespace[\"name\"]", e.Namespace)
+	}
+	if e.Namespace == LiteralNamespace {
+		return []string{e.Name}, nil
+	}
+	if ctx.VarValue == nil {
+		return nil, trace.BadParameter("variable resolver is unavailable for %s", e)
+	}
+	return ctx.VarValue(e)
+}
+
+// EmailLocalExpr extracts the RFC 5322 local part from each address.
+type EmailLocalExpr struct{ Expr Expr }
+
+func (e EmailLocalExpr) String() string   { return fmt.Sprintf("email.local(%s)", e.Expr) }
+func (EmailLocalExpr) Kind() reflect.Kind { return reflect.String }
+func (e EmailLocalExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Expr, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if value == "" {
+			return nil, trace.BadParameter("email.local address is empty")
+		}
+		addr, err := mail.ParseAddress(value)
+		if err != nil {
+			return nil, trace.BadParameter("email.local failed to parse address: %v", err)
+		}
+		at := strings.LastIndexByte(addr.Address, '@')
+		if at <= 0 || at == len(addr.Address)-1 {
+			return nil, trace.BadParameter("email.local address has no local part")
+		}
+		out = append(out, addr.Address[:at])
+	}
+	return out, nil
+}
+
+// RegexpReplaceExpr replaces pattern matches in each source value. Values
+// without a match are omitted.
+type RegexpReplaceExpr struct {
+	Expr        Expr
+	Pattern     string
+	Replacement string
+	re          *regexp.Regexp
+}
+
+func (e RegexpReplaceExpr) String() string {
+	return fmt.Sprintf("regexp.replace(%s, %q, %q)", e.Expr, e.Pattern, e.Replacement)
+}
+func (RegexpReplaceExpr) Kind() reflect.Kind { return reflect.String }
+func (e RegexpReplaceExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	values, err := evaluateStrings(e.Expr, ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	re := e.re
+	if re == nil {
+		re, err = compileRegexp(e.Pattern, false)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		if re.MatchString(value) {
+			out = append(out, re.ReplaceAllString(value, e.Replacement))
+		}
+	}
+	return out, nil
+}
+
+// RegexpMatchExpr tests the matcher input against a regular expression.
+type RegexpMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpMatchExpr) String() string   { return fmt.Sprintf("regexp.match(%q)", e.Pattern) }
+func (RegexpMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	if re == nil {
+		var err error
+		re, err = compileRegexp(e.Pattern, false)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	return re.MatchString(ctx.MatcherInput), nil
+}
+
+// RegexpNotMatchExpr negates a regular expression test of the matcher input.
+type RegexpNotMatchExpr struct {
+	Pattern string
+	re      *regexp.Regexp
+}
+
+func (e RegexpNotMatchExpr) String() string   { return fmt.Sprintf("regexp.not_match(%q)", e.Pattern) }
+func (RegexpNotMatchExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e RegexpNotMatchExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	re := e.re
+	if re == nil {
+		var err error
+		re, err = compileRegexp(e.Pattern, false)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+	}
+	return !re.MatchString(ctx.MatcherInput), nil
+}
+
+// boolAndExpr, boolOrExpr, and boolNotExpr retain boolean composition in the AST.
+type boolAndExpr struct{ left, right Expr }
+type boolOrExpr struct{ left, right Expr }
+type boolNotExpr struct{ expr Expr }
+
+func (e boolAndExpr) String() string   { return fmt.Sprintf("(%s && %s)", e.left, e.right) }
+func (boolAndExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e boolAndExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	left, err := evaluateBool(e.left, ctx)
+	if err != nil || !left {
+		return left, err
+	}
+	return evaluateBool(e.right, ctx)
+}
+func (e boolOrExpr) String() string   { return fmt.Sprintf("(%s || %s)", e.left, e.right) }
+func (boolOrExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e boolOrExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	left, err := evaluateBool(e.left, ctx)
+	if err != nil || left {
+		return left, err
+	}
+	return evaluateBool(e.right, ctx)
+}
+func (e boolNotExpr) String() string   { return fmt.Sprintf("!%s", e.expr) }
+func (boolNotExpr) Kind() reflect.Kind { return reflect.Bool }
+func (e boolNotExpr) Evaluate(ctx EvaluateContext) (any, error) {
+	value, err := evaluateBool(e.expr, ctx)
+	return !value, err
+}
+
+func evaluateStrings(expr Expr, ctx EvaluateContext) ([]string, error) {
+	if expr == nil || expr.Kind() != reflect.String {
+		return nil, trace.BadParameter("expected string expression, got %v", expr)
+	}
+	value, err := expr.Evaluate(ctx)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	values, ok := value.([]string)
+	if !ok {
+		return nil, trace.BadParameter("string expression %s returned %T instead of []string", expr, value)
+	}
+	return values, nil
+}
+
+func evaluateBool(expr Expr, ctx EvaluateContext) (bool, error) {
+	if expr == nil || expr.Kind() != reflect.Bool {
+		return false, trace.BadParameter("expected boolean expression, got %v", expr)
+	}
+	value, err := expr.Evaluate(ctx)
+	if err != nil {
+		return false, trace.Wrap(err)
+	}
+	result, ok := value.(bool)
+	if !ok {
+		return false, trace.BadParameter("boolean expression %s returned %T instead of bool", expr, value)
+	}
+	return result, nil
+}
