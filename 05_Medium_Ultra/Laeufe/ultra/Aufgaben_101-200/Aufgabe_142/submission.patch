+// compileRegexp is the single regex compilation path for replacement and
+// matching. Plain matcher strings are anchored and glob wildcards expanded.
+func compileRegexp(pattern string, plainMatcher bool) (*regexp.Regexp, error) {
+	compiled := pattern
+	if plainMatcher && (!strings.HasPrefix(pattern, "^") || !strings.HasSuffix(pattern, "$")) {
+		compiled = "^" + utils.GlobToRegexp(pattern) + "$"
+	}
+	re, err := regexp.Compile(compiled)
+	if err != nil {
+		return nil, trace.BadParameter("invalid regular expression %q: %v", pattern, err)
 	}
+	return re, nil
 }
