+func TestNewPropagator(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		options []config.TracingPropagator
+		keys    []string
+	}{
+		{"tracecontext", []config.TracingPropagator{config.TracingPropagatorTraceContext}, []string{"traceparent"}},
+		{"baggage", []config.TracingPropagator{config.TracingPropagatorBaggage}, []string{"baggage"}},
+		{"b3", []config.TracingPropagator{config.TracingPropagatorB3}, []string{"b3"}},
+		{"b3multi", []config.TracingPropagator{config.TracingPropagatorB3Multi}, []string{"x-b3-traceid"}},
+		{"jaeger", []config.TracingPropagator{config.TracingPropagatorJaeger}, []string{"uber-trace-id"}},
+		{"xray", []config.TracingPropagator{config.TracingPropagatorXRay}, []string{"X-Amzn-Trace-Id"}},
+		{"ottrace", []config.TracingPropagator{config.TracingPropagatorOTTrace}, []string{"ot-tracer-traceid"}},
+		{"none", []config.TracingPropagator{config.TracingPropagatorNone}, nil},
+		{"mixed with none", []config.TracingPropagator{config.TracingPropagatorTraceContext, config.TracingPropagatorNone, config.TracingPropagatorBaggage}, []string{"traceparent", "baggage"}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			member, err := baggage.NewMember("test", "value")
+			assert.NoError(t, err)
+			bag, err := baggage.New(member)
+			assert.NoError(t, err)
+			ctx := baggage.ContextWithBaggage(context.Background(), bag)
+			ctx = trace.ContextWithSpanContext(ctx, trace.NewSpanContext(trace.SpanContextConfig{
+				TraceID:    trace.TraceID{1},
+				SpanID:     trace.SpanID{1},
+				TraceFlags: trace.FlagsSampled,
+			}))
+
+			carrier := propagation.MapCarrier{}
+			NewPropagator(tt.options).Inject(ctx, carrier)
+			if len(tt.keys) == 0 {
+				assert.Empty(t, carrier)
+			}
+			for _, key := range tt.keys {
+				assert.NotEmpty(t, carrier.Get(key))
+			}
+		})
+	}
+}
