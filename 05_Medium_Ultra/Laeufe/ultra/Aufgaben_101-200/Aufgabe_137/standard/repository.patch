+func TestSamplingExporterKeepsWholeTraces(t *testing.T) {
+	underlying := tracetest.NewInMemoryExporter()
+	provider, err := NewProvider(context.Background(), "test", 0.5, true)
+	assert.NoError(t, err)
+	if !assert.NotNil(t, provider) {
+		return
+	}
+	provider.RegisterSpanProcessor(tracesdk.NewSimpleSpanProcessor(NewSamplingExporter(underlying, 0.5)))
+	t.Cleanup(func() { assert.NoError(t, provider.Shutdown(context.Background())) })
+
+	selectedID := trace.TraceID{1}
+	droppedID := trace.TraceID{1, 0, 0, 0, 0, 0, 0, 0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff}
+	for _, tt := range []struct {
+		name string
+		id   trace.TraceID
+	}{
+		{name: "selected one", id: selectedID},
+		{name: "dropped", id: droppedID},
+		{name: "selected two", id: selectedID},
+	} {
+		parent := trace.NewSpanContext(trace.SpanContextConfig{
+			TraceID:    tt.id,
+			SpanID:     trace.SpanID{1},
+			TraceFlags: trace.FlagsSampled,
+			Remote:     true,
+		})
+		ctx := trace.ContextWithRemoteSpanContext(context.Background(), parent)
+		_, span := provider.Tracer("test").Start(ctx, tt.name)
+		assert.True(t, span.IsRecording())
+		span.End()
+	}
+
+	spans := underlying.GetSpans()
+	if assert.Len(t, spans, 2) {
+		assert.Equal(t, "selected one", spans[0].Name)
+		assert.Equal(t, "selected two", spans[1].Name)
+	}
+}
