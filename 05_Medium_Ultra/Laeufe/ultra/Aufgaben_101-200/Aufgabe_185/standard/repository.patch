@@ -0,0 +1,54 @@
+import { render } from '@testing-library/react';
+import { addMonths, format, getUnixTime, startOfDay } from 'date-fns';
+
+import type { SubscriptionModel } from '@proton/shared/lib/interfaces';
+import { subscriptionMock, upcomingSubscriptionMock } from '@proton/testing/data';
+
+import { ExpirationTime as B2BExpirationTime } from './b2bCommonConfig';
+import { ExpirationTime as B2CExpirationTime } from './b2cCommonConfig';
+
+const cases = [
+    {
+        name: 'B2C subscription ending at renewal',
+        renderExpiration: (subscription: SubscriptionModel) => (
+            <B2CExpirationTime subscription={subscription} cancellablePlan />
+        ),
+        showsDate: true,
+    },
+    {
+        name: 'B2C subscription ending immediately',
+        renderExpiration: (subscription: SubscriptionModel) => <B2CExpirationTime subscription={subscription} />,
+        showsDate: false,
+    },
+    {
+        name: 'B2B subscription ending at renewal',
+        renderExpiration: (subscription: SubscriptionModel) => (
+            <B2BExpirationTime subscription={subscription} isChargeBeeUser />
+        ),
+        showsDate: true,
+    },
+    {
+        name: 'B2B subscription ending immediately',
+        renderExpiration: (subscription: SubscriptionModel) => <B2BExpirationTime subscription={subscription} />,
+        showsDate: false,
+    },
+];
+
+it.each(cases)('shows the current term expiry for $name', ({ renderExpiration, showsDate }) => {
+    const currentEnd = addMonths(startOfDay(new Date()), 2);
+    const upcomingEnd = addMonths(currentEnd, 12);
+    const subscription = {
+        ...subscriptionMock,
+        PeriodEnd: getUnixTime(currentEnd),
+        UpcomingSubscription: { ...upcomingSubscriptionMock, PeriodEnd: getUnixTime(upcomingEnd) },
+    };
+
+    const { container } = render(renderExpiration(subscription));
+    const expiry = container.querySelector('time');
+
+    expect(expiry).toHaveAttribute('dateTime', format(currentEnd, 'yyyy-MM-dd'));
+    expect(expiry).not.toHaveAttribute('dateTime', format(upcomingEnd, 'yyyy-MM-dd'));
+    if (showsDate) {
+        expect(expiry).toHaveTextContent(format(currentEnd, 'PP'));
+    }
+});
