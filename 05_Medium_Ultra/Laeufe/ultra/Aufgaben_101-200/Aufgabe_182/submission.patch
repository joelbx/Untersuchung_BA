diff --git a/test/units/executor/test_task_queue_manager_display.py b/test/units/executor/test_task_queue_manager_display.py
new file mode 100644
index 0000000..c62f498
--- /dev/null
+++ b/test/units/executor/test_task_queue_manager_display.py
@@ -0,0 +1,18 @@
+# Copyright (c) Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from ansible.executor.task_queue_manager import DisplaySend, FinalQueue
+
+
+def test_send_display_preserves_method_and_arguments():
+    queue = FinalQueue()
+    try:
+        queue.send_display('warning', 'message', formatted=True)
+        result = queue.get()
+    finally:
+        queue.close()
+
+    assert isinstance(result, DisplaySend)
+    assert result.method == 'warning'
+    assert result.args == ('message',)
+    assert result.kwargs == {'formatted': True}
diff --git a/test/units/plugins/strategy/test_results_thread_display.py b/test/units/plugins/strategy/test_results_thread_display.py
new file mode 100644
index 0000000..5d4b36f
--- /dev/null
+++ b/test/units/plugins/strategy/test_results_thread_display.py
@@ -0,0 +1,43 @@
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from unittest.mock import MagicMock
+
+from ansible.executor.task_queue_manager import DisplaySend
+from ansible.plugins import strategy as strategy_module
+
+
+def test_results_thread_replays_display_with_arguments(monkeypatch):
+    output = MagicMock()
+    monkeypatch.setattr(strategy_module.display, 'display', output)
+    strategy = MagicMock()
+    strategy._final_q.get.side_effect = [
+        DisplaySend('display', 'worker message', stderr=True, newline=False),
+        strategy_module.StrategySentinel(),
+    ]
+
+    strategy_module.results_thread_main(strategy)
+
+    output.assert_called_once_with('worker message', stderr=True, newline=False)
+
+
+def test_results_thread_deduplicates_worker_warnings_and_deprecations(monkeypatch):
+    output = MagicMock()
+    monkeypatch.setattr(strategy_module.display, '_final_q', None)
+    monkeypatch.setattr(strategy_module.display, '_warns', {})
+    monkeypatch.setattr(strategy_module.display, '_deprecations', {})
+    monkeypatch.setattr(strategy_module.display, 'display', output)
+    monkeypatch.setattr(strategy_module.C, 'DEPRECATION_WARNINGS', True)
+    strategy = MagicMock()
+    strategy._final_q.get.side_effect = [
+        DisplaySend('warning', 'same worker warning'),
+        DisplaySend('warning', 'same worker warning'),
+        DisplaySend('deprecated', 'same worker deprecation', version='2.99'),
+        DisplaySend('deprecated', 'same worker deprecation', version='2.99'),
+        strategy_module.StrategySentinel(),
+    ]
+
+    strategy_module.results_thread_main(strategy)
+
+    assert output.call_count == 2
+    assert output.call_args_list[0].args[0].startswith('[WARNING]: same worker warning')
+    assert output.call_args_list[1].args[0].startswith('[DEPRECATION WARNING]: same worker deprecation')
