+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import os
+
+from units.compat.mock import patch
+from ansible.modules.network.icx import icx_logging
+from units.modules.utils import set_module_args
+from .icx_module import TestICXModule
+
+
+class TestICXLoggingModule(TestICXModule):
+
+    module = icx_logging
+
+    def setUp(self):
+        super(TestICXLoggingModule, self).setUp()
+        self.config = ''
+        self.mock_get_config = patch('ansible.modules.network.icx.icx_logging.get_config')
+        self.get_config = self.mock_get_config.start()
+        self.mock_load_config = patch('ansible.modules.network.icx.icx_logging.load_config')
+        self.load_config = self.mock_load_config.start()
+        self.addCleanup(self.mock_get_config.stop)
+        self.addCleanup(self.mock_load_config.stop)
+
+    def load_fixtures(self, commands=None):
+        self.get_config.return_value = self.config
+        self.load_config.return_value = None
+
+    def test_add_ipv4_host_with_udp_port(self):
+        set_module_args(dict(dest='host', name='192.0.2.10', udp_port=1514))
+        self.execute_module(changed=True, commands=['logging host 192.0.2.10 udp-port 1514'])
+
+    def test_add_ipv6_host_with_literal_ipv6_keyword(self):
+        set_module_args(dict(dest='host', name='2001:db8::10', udp_port=1514))
+        self.execute_module(changed=True, commands=['logging host ipv6 2001:db8::10 udp-port 1514'])
+
+    def test_ipv4_host_with_matching_port_is_idempotent(self):
+        self.config = 'logging host 192.0.2.10 udp-port 1514\n'
+        set_module_args(dict(dest='host', name='192.0.2.10', udp_port=1514))
+        self.execute_module(changed=False, commands=[])
+        self.load_config.assert_not_called()
+
+    def test_ipv6_host_with_matching_port_is_idempotent(self):
+        self.config = 'logging host ipv6 2001:db8::10 udp-port 1514\n'
+        set_module_args(dict(dest='host', name='2001:db8::10', udp_port=1514))
+        self.execute_module(changed=False, commands=[])
+
+    def test_remove_ipv4_host_uses_discovered_port(self):
+        self.config = 'logging host 192.0.2.10 udp-port 1514\n'
+        set_module_args(dict(dest='host', name='192.0.2.10', state='absent'))
+        self.execute_module(changed=True, commands=['no logging host 192.0.2.10 udp-port 1514'])
+
+    def test_remove_ipv6_host_uses_discovered_port_and_keyword(self):
+        self.config = 'logging host ipv6 2001:db8::10 udp-port 1514\n'
+        set_module_args(dict(dest='host', name='2001:db8::10', state='absent'))
+        self.execute_module(changed=True, commands=['no logging host ipv6 2001:db8::10 udp-port 1514'])
+
+    def test_remove_missing_host_is_idempotent(self):
+        set_module_args(dict(dest='host', name='192.0.2.10', state='absent'))
+        self.execute_module(changed=False, commands=[])
+
+    def test_host_port_change_removes_old_entry_and_adds_new(self):
+        self.config = 'logging host ipv6 2001:db8::10 udp-port 514\n'
+        set_module_args(dict(dest='host', name='2001:db8::10', udp_port=1514))
+        self.execute_module(changed=True, commands=[
+            'no logging host ipv6 2001:db8::10 udp-port 514',
+            'logging host ipv6 2001:db8::10 udp-port 1514',
+        ], sort=False)
+
+    def test_set_facility(self):
+        self.config = 'logging facility local2\n'
+        set_module_args(dict(facility='local7'))
+        self.execute_module(changed=True, commands=['logging facility local7'])
+
+    def test_matching_facility_is_idempotent(self):
+        self.config = 'logging facility local7\n'
+        set_module_args(dict(facility='local7'))
+        self.execute_module(changed=False, commands=[])
+
+    def test_default_user_facility_is_idempotent(self):
+        set_module_args(dict(facility='user'))
+        self.execute_module(changed=False, commands=[])
+
+    def test_clear_facility(self):
+        self.config = 'logging facility local7\n'
+        set_module_args(dict(facility='local7', state='absent'))
+        self.execute_module(changed=True, commands=['no logging facility'])
+
+    def test_clear_facility_without_specifying_old_value(self):
+        self.config = 'logging facility local7\n'
+        set_module_args(dict(dest='facility', state='absent'))
+        self.execute_module(changed=True, commands=['no logging facility'])
+
+    def test_clear_other_facility_is_idempotent(self):
+        self.config = 'logging facility local2\n'
+        set_module_args(dict(facility='local7', state='absent'))
+        self.execute_module(changed=False, commands=[])
+
