+type billingModeDynamoDBMock struct {
+	dynamodbiface.DynamoDBAPI
+	createInput    *dynamodb.CreateTableInput
+	describeOutput *dynamodb.DescribeTableOutput
+	describeError  error
+	waited         bool
+}
+
+func (m *billingModeDynamoDBMock) CreateTableWithContext(_ aws.Context, input *dynamodb.CreateTableInput, _ ...request.Option) (*dynamodb.CreateTableOutput, error) {
+	m.createInput = input
+	return &dynamodb.CreateTableOutput{}, nil
+}
+
+func (m *billingModeDynamoDBMock) WaitUntilTableExistsWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.WaiterOption) error {
+	m.waited = true
+	return nil
+}
+
+func (m *billingModeDynamoDBMock) DescribeTableWithContext(_ aws.Context, _ *dynamodb.DescribeTableInput, _ ...request.Option) (*dynamodb.DescribeTableOutput, error) {
+	return m.describeOutput, m.describeError
+}
+
+func TestBillingModeDefaultsAndValidation(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		billingMode string
+		wantMode    string
+		wantError   bool
+	}{
+		{name: "default", wantMode: billingModePayPerRequest},
+		{name: "on demand", billingMode: billingModePayPerRequest, wantMode: billingModePayPerRequest},
+		{name: "provisioned", billingMode: billingModeProvisioned, wantMode: billingModeProvisioned},
+		{name: "invalid", billingMode: "unknown", wantError: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := Config{TableName: "test-table", BillingMode: tc.billingMode}
+			err := cfg.CheckAndSetDefaults()
+			if tc.wantError {
+				require.True(t, trace.IsBadParameter(err), "error = %v", err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.wantMode, cfg.BillingMode)
+			if tc.wantMode == billingModeProvisioned {
+				require.Equal(t, int64(DefaultReadCapacityUnits), cfg.ReadCapacityUnits)
+				require.Equal(t, int64(DefaultWriteCapacityUnits), cfg.WriteCapacityUnits)
+			} else {
+				require.Zero(t, cfg.ReadCapacityUnits)
+				require.Zero(t, cfg.WriteCapacityUnits)
+			}
+		})
+	}
+}
+
+func TestBillingModeConfigurationField(t *testing.T) {
+	var cfg *Config
+	require.NoError(t, utils.ObjectToStruct(map[string]interface{}{
+		"table_name":   "test-table",
+		"billing_mode": billingModeProvisioned,
+	}, &cfg))
+	require.NotNil(t, cfg)
+	require.NoError(t, cfg.CheckAndSetDefaults())
+	require.Equal(t, billingModeProvisioned, cfg.BillingMode)
+}
+
+func TestCreateTableBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		billingMode    string
+		wantAWSMode    string
+		wantThroughput bool
+	}{
+		{name: "default on demand", wantAWSMode: dynamodb.BillingModePayPerRequest},
+		{name: "on demand ignores capacity", billingMode: billingModePayPerRequest, wantAWSMode: dynamodb.BillingModePayPerRequest},
+		{name: "provisioned uses capacity", billingMode: billingModeProvisioned, wantAWSMode: dynamodb.BillingModeProvisioned, wantThroughput: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := Config{
+				TableName:          "test-table",
+				BillingMode:        tc.billingMode,
+				ReadCapacityUnits:  17,
+				WriteCapacityUnits: 29,
+			}
+			require.NoError(t, cfg.CheckAndSetDefaults())
+			mock := &billingModeDynamoDBMock{}
+			logger := log.New()
+			logger.SetOutput(io.Discard)
+			b := &Backend{Config: cfg, Entry: logger.WithField("test", t.Name()), svc: mock}
+			require.NoError(t, b.createTable(context.Background(), cfg.TableName, fullPathKey))
+			require.True(t, mock.waited)
+			require.NotNil(t, mock.createInput)
+			require.Equal(t, tc.wantAWSMode, aws.StringValue(mock.createInput.BillingMode))
+			if tc.wantThroughput {
+				require.NotNil(t, mock.createInput.ProvisionedThroughput)
+				require.Equal(t, int64(17), aws.Int64Value(mock.createInput.ProvisionedThroughput.ReadCapacityUnits))
+				require.Equal(t, int64(29), aws.Int64Value(mock.createInput.ProvisionedThroughput.WriteCapacityUnits))
+			} else {
+				require.Nil(t, mock.createInput.ProvisionedThroughput)
+			}
+		})
+	}
+}
+
+func TestGetTableStatusIncludesBillingMode(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		output      *dynamodb.DescribeTableOutput
+		describeErr error
+		wantStatus  tableStatus
+		wantMode    string
+		wantError   bool
+	}{
+		{
+			name: "on demand",
+			output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+				BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+			}},
+			wantStatus: tableStatusOK,
+			wantMode:   dynamodb.BillingModePayPerRequest,
+		},
+		{
+			name: "provisioned",
+			output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+				BillingModeSummary: &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModeProvisioned)},
+			}},
+			wantStatus: tableStatusOK,
+			wantMode:   dynamodb.BillingModeProvisioned,
+		},
+		{
+			name:       "missing billing summary",
+			output:     &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{}},
+			wantStatus: tableStatusOK,
+		},
+		{
+			name: "needs migration",
+			output: &dynamodb.DescribeTableOutput{Table: &dynamodb.TableDescription{
+				AttributeDefinitions: []*dynamodb.AttributeDefinition{{AttributeName: aws.String(oldPathAttr)}},
+				BillingModeSummary:   &dynamodb.BillingModeSummary{BillingMode: aws.String(dynamodb.BillingModePayPerRequest)},
+			}},
+			wantStatus: tableStatusNeedsMigration,
+		},
+		{
+			name:        "missing table",
+			describeErr: awserr.New(dynamodb.ErrCodeResourceNotFoundException, "table missing", nil),
+			wantStatus:  tableStatusMissing,
+		},
+		{
+			name:        "describe error",
+			describeErr: errors.New("describe failed"),
+			wantStatus:  tableStatusError,
+			wantError:   true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := &Backend{svc: &billingModeDynamoDBMock{describeOutput: tc.output, describeError: tc.describeErr}}
+			status, mode, err := b.getTableStatus(context.Background(), "test-table")
+			if tc.wantError {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+			require.Equal(t, tc.wantStatus, status)
+			require.Equal(t, tc.wantMode, mode)
+		})
+	}
+}
