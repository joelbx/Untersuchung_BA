+def archive(test=True):
+    """Stage up to 10,000 unarchived covers, retaining sources until verified."""
+    cover_db = CoverDB()
+    candidates = cover_db.get_unarchived(limit=10_000)
+    groups = defaultdict(list)
+    for row in candidates:
+        groups[Cover.id_to_item_and_batch_id(row.id)].append(row.id)
+
+    for (item_id, batch_id), selected_ids in sorted(groups.items()):
+        if test:
+            for cover_id in selected_ids:
+                print(f'Would archive cover {cover_id}')
+            continue
+        batch = Batch(item_id, batch_id)
+        with batch.lock():
+            # Re-read under the item lock; the initial query may now be stale.
+            rows = [row for row in cover_db.get_unarchived_batch(item_id, batch_id)
+                    if row.id in selected_ids]
+            manager = ZipManager()
+            staged = []
+            try:
+                for row in rows:
+                    cover = Cover(row)
+                    if not cover.has_valid_files():
+                        cover_db.mark_failed(row.id)
+                        print(f'Missing image file for {row.id:010d}')
+                        continue
+                    created = row.created
+                    if isinstance(created, str):
+                        from infogami.infobase import utils
+
+                        created = utils.parse_datetime(created)
+                    timestamp = time.mktime(created.timetuple())
+                    for _, name, path in cover.local_files():
