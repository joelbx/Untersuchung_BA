+"""Retrieval behavior while local and legacy archives coexist with zip uploads."""
+
+import datetime
+
+import pytest
+import web
+
+from openlibrary.coverstore import code, config, coverlib
+
+
+def _cover(coverid, **values):
+    row = web.storage(
+        id=coverid,
+        created=datetime.datetime(2020, 1, 1),
+        filename='local.jpg',
+        filename_s='local-S.jpg',
+        filename_m='local-M.jpg',
+        filename_l='local-L.jpg',
+        archived=False,
+        uploaded=False,
+    )
+    row.update(values)
+    return row
+
+
+@pytest.mark.parametrize(
+    'size,prefix,suffix',
+    [('', '', ''), ('S', 's_', '-S'), ('M', 'm_', '-M'), ('L', 'l_', '-L')],
+)
+def test_uploaded_cover_redirects_to_recorded_zip_url(monkeypatch, size, prefix, suffix):
+    coverid = 8_500_000  # Formerly caught by the hard-coded tar redirect.
+    filename = f'0008500000{suffix}.jpg'
+    url = (
+        f'https://archive.org/download/{prefix}covers_0008/'
+        f'{prefix}covers_0008_50.zip/{filename}'
+    )
+    row = _cover(coverid, archived=True, uploaded=True)
+    row['filename' + ('_' + size.lower() if size else '')] = url
+    monkeypatch.setattr(code.db, 'details', lambda ident: row)
+
+    response = code.app.request(f'/b/id/{coverid}{suffix}.jpg')
+
+    assert response.status == '302 Found'
+    assert response.headers['Location'] == url
+
+
+def test_local_cover_in_legacy_range_uses_its_database_file(monkeypatch, tmp_path):
+    (tmp_path / 'localdisk').mkdir()
+    (tmp_path / 'localdisk' / 'local.jpg').write_bytes(b'local image')
+    monkeypatch.setattr(config, 'data_root', str(tmp_path))
+    monkeypatch.setattr(config, 'max_coveritem_index', 1000, raising=False)
+    monkeypatch.setattr(code.db, 'details', lambda ident: _cover(8_500_000))
+
+    response = code.app.request('/b/id/8500000.jpg')
+
+    assert response.status == '200 OK'
+    assert response.data == b'local image'
+
+
+def test_legacy_tar_redirect_remains_available(monkeypatch):
+    monkeypatch.setattr(code.db, 'details', lambda ident: None)
+
+    response = code.app.request('/b/id/8500000-M.jpg')
+
+    assert response.status == '302 Found'
+    assert response.headers['Location'].endswith(
+        '/m_covers_0008/m_covers_0008_50.tar/0008500000-M.jpg'
+    )
+
+
+def test_missing_remote_size_is_not_derived_from_original(monkeypatch):
+    original_url = (
+        'https://archive.org/download/covers_0008/'
+        'covers_0008_50.zip/0008500000.jpg'
+    )
+    row = _cover(8_500_000, filename=original_url, filename_m=None, uploaded=True)
+    monkeypatch.setattr(code.db, 'details', lambda ident: row)
+
+    assert coverlib.get_image_filename(row, 'M') is None
+    assert code.app.request('/b/id/8500000-M.jpg').status == '404 Not Found'
