+@pytest.mark.parametrize('patch_ansible_module', [None])
+def test_get_pip_uses_current_interpreter_when_pip_binary_is_absent(mocker):
+    module = mocker.Mock()
+    module.get_bin_path.return_value = None
+    mocker.patch('ansible.modules.pip._have_pip_module', return_value=True)
+
+    assert pip._get_pip(module) == [sys.executable, '-m', 'pip']
+    module.fail_json.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [None])
+def test_get_pip_normalizes_explicit_executable(mocker):
+    module = mocker.Mock()
+
+    assert pip._get_pip(module, executable='/custom/pip') == ['/custom/pip']
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [None])
+def test_get_pip_normalizes_virtualenv_executable(mocker, tmpdir):
+    module = mocker.Mock()
+    bin_dir = tmpdir.mkdir('bin')
+    pip_path = bin_dir.join('pip3' if pip.PY3 else 'pip2')
+    pip_path.write('')
+    pip_path.chmod(0o755)
+
+    assert pip._get_pip(module, env=str(tmpdir)) == [str(pip_path)]
+    module.get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [None])
+@pytest.mark.skipif(not pip.PY3, reason='modern import finder is unavailable on Python 2')
+def test_have_pip_module_returns_false_when_finder_raises(mocker):
+    mocker.patch('importlib.util.find_spec', side_effect=RuntimeError('finder failed'))
+
+    assert pip._have_pip_module() is False
+
+
+@pytest.mark.parametrize('patch_ansible_module', [{'name': 'six'}], indirect=['patch_ansible_module'])
+def test_main_uses_current_interpreter_without_pip_binary(mocker, capfd):
+    get_bin_path = mocker.patch('ansible.module_utils.basic.AnsibleModule.get_bin_path', return_value=None)
+    mocker.patch('ansible.modules.pip._have_pip_module', return_value=True)
+    run_command = mocker.patch('ansible.module_utils.basic.AnsibleModule.run_command',
+                               return_value=(0, 'Successfully installed six-1.0\n', ''))
+
+    with pytest.raises(SystemExit):
+        pip.main()
+
+    out, err = capfd.readouterr()
+    results = json.loads(out)
+    assert results['changed']
+    assert results['cmd'] == [sys.executable, '-m', 'pip', 'install', 'six']
+    assert run_command.call_args[0][0] == results['cmd']
+    get_bin_path.assert_not_called()
+
+
+@pytest.mark.parametrize('patch_ansible_module', [None])
+def test_get_packages_uses_modern_listing(mocker):
+    module = mocker.Mock()
+    module.run_command.return_value = (0, 'six==1.0\n', '')
+    mocker.patch('ansible.modules.pip.get_best_parsable_locale', return_value='C')
+
+    result = pip._get_packages(module, ['/usr/bin/python3', '-m', 'pip'], '/tmp')
+
+    assert result == ('/usr/bin/python3 -m pip list --format=freeze', 'six==1.0\n', '')
+    assert module.run_command.call_count == 1
+    assert module.run_command.call_args[0][0] == [
+        '/usr/bin/python3', '-m', 'pip', 'list', '--format=freeze',
+    ]
+
+
+@pytest.mark.parametrize('patch_ansible_module', [None])
+def test_get_packages_falls_back_to_freeze(mocker):
+    module = mocker.Mock()
+    module.run_command.side_effect = [
+        (1, '', 'list is unsupported'),
+        (0, 'six==1.0\n', ''),
+    ]
+    mocker.patch('ansible.modules.pip.get_best_parsable_locale', return_value='C')
+
+    result = pip._get_packages(module, ['/usr/bin/python3', '-m', 'pip'], '/tmp')
+
+    assert result == ('/usr/bin/python3 -m pip freeze', 'six==1.0\n', '')
+    assert [call[0][0] for call in module.run_command.call_args_list] == [
+        ['/usr/bin/python3', '-m', 'pip', 'list', '--format=freeze'],
+        ['/usr/bin/python3', '-m', 'pip', 'freeze'],
+    ]
+
+
