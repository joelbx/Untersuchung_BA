+def _have_pip_module():
+    """Return whether the current Python interpreter can find pip."""
+    try:
+        if PY3:
+            from importlib.util import find_spec
+            return find_spec('pip') is not None
+        else:
+            import imp
+            file, _, _ = imp.find_module('pip')
+            if file is not None:
+                file.close()
+            return True
+    except Exception:
+        return False
+
