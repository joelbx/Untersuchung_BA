diff --git a/test/units/modules/test_iptables.py b/test/units/modules/test_iptables.py
index 7326b65..bf19826 100644
--- a/test/units/modules/test_iptables.py
+++ b/test/units/modules/test_iptables.py
@@ -953,3 +953,149 @@ class TestIptables(ModuleTestCase):
             '-m', 'comment',
             '--comment', 'this is a comment'
         ])
+
+    def test_match_set_with_explicit_and_implicit_match(self):
+        """Both forms create the same set-based rule, including common options."""
+        for match in ([], ['set']):
+            set_module_args({
+                'chain': 'INPUT',
+                'protocol': 'tcp',
+                'match': match,
+                'match_set': 'admin_hosts',
+                'match_set_flags': 'src',
+                'destination_port': '22',
+                'jump': 'ACCEPT',
+                'comment': 'Allow SSH from admin hosts',
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.side_effect = [(1, '', ''), (0, '', '')]
+                with self.assertRaises(AnsibleExitJson) as result:
+                    iptables.main()
+
+            self.assertTrue(result.exception.args[0]['changed'])
+            self.assertEqual(run_command.call_count, 2)
+            expected = [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-p', 'tcp',
+                '-m', 'set', '--match-set', 'admin_hosts', 'src',
+                '-j', 'ACCEPT',
+                '--destination-port', '22',
+                '-m', 'comment', '--comment', 'Allow SSH from admin hosts',
+            ]
+            self.assertEqual(run_command.call_args_list[0][0][0], expected)
+            expected[3] = '-A'
+            self.assertEqual(run_command.call_args_list[1][0][0], expected)
+
+    def test_match_set_flags_choices(self):
+        """All four source and destination combinations are accepted."""
+        for flags in ('src', 'dst', 'src,dst', 'dst,src'):
+            set_module_args({
+                'chain': 'INPUT',
+                'match_set': 'admin_hosts',
+                'match_set_flags': flags,
+                'jump': 'ACCEPT',
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                run_command.return_value = 0, '', ''
+                with self.assertRaises(AnsibleExitJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_count, 1)
+            self.assertEqual(run_command.call_args[0][0], [
+                '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+                '-m', 'set', '--match-set', 'admin_hosts', flags,
+                '-j', 'ACCEPT',
+            ])
+
+    def test_match_set_among_explicit_matches(self):
+        """The set options follow their extension, without a second set match."""
+        set_module_args({
+            'chain': 'INPUT',
+            'protocol': 'tcp',
+            'match': ['tcp', 'set', 'conntrack'],
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'src',
+            'ctstate': ['NEW'],
+            'jump': 'ACCEPT',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 0, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_count, 1)
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-p', 'tcp',
+            '-m', 'tcp',
+            '-m', 'set', '--match-set', 'admin_hosts', 'src',
+            '-m', 'conntrack',
+            '-j', 'ACCEPT',
+            '--ctstate', 'NEW',
+        ])
+
+    def test_match_set_inversion(self):
+        """The inversion operator applies to the set match option."""
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': '!admin_hosts',
+            'match_set_flags': 'src',
+            'jump': 'DROP',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            run_command.return_value = 0, '', ''
+            with self.assertRaises(AnsibleExitJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_count, 1)
+        self.assertEqual(run_command.call_args[0][0], [
+            '/sbin/iptables', '-t', 'filter', '-C', 'INPUT',
+            '-m', 'set', '!', '--match-set', 'admin_hosts', 'src',
+            '-j', 'DROP',
+        ])
+
+    def test_match_set_parameters_required_together(self):
+        """An incomplete set match fails before running iptables."""
+        for option in ({'match_set': 'admin_hosts'}, {'match_set_flags': 'src'}):
+            args = {'chain': 'INPUT', 'jump': 'ACCEPT'}
+            args.update(option)
+            set_module_args(args)
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_count, 0)
+
+    def test_match_set_flags_rejects_unknown_value(self):
+        set_module_args({
+            'chain': 'INPUT',
+            'match_set': 'admin_hosts',
+            'match_set_flags': 'source',
+            'jump': 'ACCEPT',
+        })
+
+        with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+            with self.assertRaises(AnsibleFailJson):
+                iptables.main()
+
+        self.assertEqual(run_command.call_count, 0)
+
+    def test_match_set_rejects_empty_name(self):
+        for name in ('', '!'):
+            set_module_args({
+                'chain': 'INPUT',
+                'match_set': name,
+                'match_set_flags': 'src',
+                'jump': 'ACCEPT',
+            })
+
+            with patch.object(basic.AnsibleModule, 'run_command') as run_command:
+                with self.assertRaises(AnsibleFailJson):
+                    iptables.main()
+
+            self.assertEqual(run_command.call_count, 0)
