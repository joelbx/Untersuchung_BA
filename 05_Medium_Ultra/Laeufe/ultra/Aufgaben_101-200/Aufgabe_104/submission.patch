+func TestLoadMetadata(t *testing.T) {
+	assert.True(t, Default().Metadata.CheckForUpdates)
+
+	tests := []struct {
+		name            string
+		extension       string
+		content         string
+		checkForUpdates bool
+	}{
+		{
+			name:            "YAML without metadata",
+			extension:       ".yml",
+			content:         "{}\n",
+			checkForUpdates: true,
+		},
+		{
+			name:            "YAML with empty metadata",
+			extension:       ".yml",
+			content:         "metadata: {}\n",
+			checkForUpdates: true,
+		},
+		{
+			name:            "YAML with version check disabled",
+			extension:       ".yml",
+			content:         "metadata:\n  check_for_updates: false\n",
+			checkForUpdates: false,
+		},
+		{
+			name:            "YAML with version check enabled",
+			extension:       ".yml",
+			content:         "metadata:\n  check_for_updates: true\n",
+			checkForUpdates: true,
+		},
+		{
+			name:            "JSON without metadata",
+			extension:       ".json",
+			content:         `{}`,
+			checkForUpdates: true,
+		},
+		{
+			name:            "JSON with empty metadata",
+			extension:       ".json",
+			content:         `{"metadata":{}}`,
+			checkForUpdates: true,
+		},
+		{
+			name:            "JSON with version check disabled",
+			extension:       ".json",
+			content:         `{"metadata":{"check_for_updates":false}}`,
+			checkForUpdates: false,
+		},
+		{
+			name:            "JSON with camel case version check disabled",
+			extension:       ".json",
+			content:         `{"metadata":{"checkForUpdates":false}}`,
+			checkForUpdates: false,
+		},
+		{
+			name:            "JSON with version check enabled",
+			extension:       ".json",
+			content:         `{"metadata":{"check_for_updates":true}}`,
+			checkForUpdates: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dir, err := ioutil.TempDir("", "flipt-config-metadata-")
+			require.NoError(t, err)
+			defer os.RemoveAll(dir)
+
+			path := filepath.Join(dir, "config"+tt.extension)
+			require.NoError(t, ioutil.WriteFile(path, []byte(tt.content), 0600))
+
+			cfg, err := Load(path)
+			require.NoError(t, err)
+			assert.Equal(t, tt.checkForUpdates, cfg.Metadata.CheckForUpdates)
+		})
+	}
+}
+
