+def test_replace_stderr_clixml_without_header():
+    stderr = b'plain stderr\r\n<Objs><S S="Error">not CLIXML</S></Objs>\r\n'
+
+    assert _replace_stderr_clixml(stderr) == stderr
+
+
+def test_replace_stderr_clixml_embedded_with_trailing_bytes():
+    stderr = (
+        b'before\r\n'
+        b'#< CLIXML\r\n'
+        b'<Objs Version="1.1.0.1"><S S="Error">decoded</S></Objs> after\r\n'
+        b'last line\r\n'
+    )
+
+    assert _replace_stderr_clixml(stderr) == b'before\r\ndecoded after\r\nlast line\r\n'
+
+
+def test_replace_stderr_clixml_multiline_and_multiple_blocks():
+    stderr = (
+        b'#< CLIXML\r\n'
+        b'<Objs Version="1.1.0.1">\r\n<S S="Error">first</S>\r\n</Objs>\r\n'
+        b'between\r\n'
+        b'#< CLIXML\r\n'
+        b'<Objs Version="1.1.0.1"><S S="Error">second</S></Objs> tail'
+    )
+
+    assert _replace_stderr_clixml(stderr) == b'first\r\nbetween\r\nsecond tail'
+
+
+def test_replace_stderr_clixml_multiple_xml_elements_in_one_block():
+    stderr = (
+        b'#< CLIXML\r\n'
