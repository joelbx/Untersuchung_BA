+# along with qutebrowser.  If not, see <https://www.gnu.org/licenses/>.
+
+"""Tests for WebEngine certificate error wrappers."""
+
+import pytest
+
+pytest.importorskip('qutebrowser.qt.webenginecore')
+
+from qutebrowser.browser.webengine import certificateerror, webview
+from qutebrowser.qt import machinery
+from qutebrowser.qt.core import QUrl
+from qutebrowser.qt.webenginecore import QWebEngineCertificateError
+from qutebrowser.utils import usertypes
+
+
+class FakeError:
+
+    def __init__(self):
+        self.decisions = []
+
+    def errorDescription(self):
+        return 'Certificate <invalid> & unsafe'
+
+    def description(self):
+        return self.errorDescription()
+
+    def error(self):
+        return QWebEngineCertificateError.CertificateContainsErrors
+
+    def type(self):
+        return self.error()
+
+    def url(self):
+        return QUrl('https://example.com/')
+
+    def isOverridable(self):
+        return True
+
+    def acceptCertificate(self):
+        self.decisions.append('accept')
+
+    def rejectCertificate(self):
+        self.decisions.append('reject')
+
+    def defer(self):
+        self.decisions.append('defer')
+
+
+@pytest.mark.parametrize('qt6, wrapper_class', [
+    (False, certificateerror.CertificateErrorWrapperQt5),
+    (True, certificateerror.CertificateErrorWrapperQt6),
+])
+def test_create_and_render(monkeypatch, qt6, wrapper_class):
+    monkeypatch.setattr(machinery, 'IS_QT6', qt6)
+    qt_error = FakeError()
+
+    wrapper = certificateerror.create(qt_error)
+
+    assert isinstance(wrapper, wrapper_class)
+    assert qt_error.decisions == []
+    assert wrapper.url() == QUrl('https://example.com/')
+    assert wrapper.is_overridable()
+    assert 'CertificateContainsErrors' in repr(wrapper)
+    assert wrapper.html() == '<p>Certificate &lt;invalid&gt; &amp; unsafe</p>'
+
+
+def test_qt5_decision():
+    qt_error = FakeError()
+    wrapper = certificateerror.CertificateErrorWrapperQt5(qt_error)
+
+    assert not wrapper.ignore
+    assert not wrapper.certificate_was_accepted()
+    wrapper.accept_certificate()
+    assert wrapper.ignore
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.ignore
+    assert not wrapper.certificate_was_accepted()
+    with pytest.raises(usertypes.UndeferrableError):
+        wrapper.defer()
+    assert qt_error.decisions == []
+
+
+def test_qt6_decision():
+    qt_error = FakeError()
+    wrapper = certificateerror.CertificateErrorWrapperQt6(qt_error)
+
+    wrapper.defer()
+    wrapper.accept_certificate()
+    assert wrapper.certificate_was_accepted()
+    wrapper.reject_certificate()
+    assert not wrapper.certificate_was_accepted()
+    assert qt_error.decisions == ['defer', 'accept', 'reject']
+
+
+@pytest.mark.skipif(machinery.IS_QT6, reason='Qt 5 page callback only')
+def test_qt5_page_returns_certificate_decision():
+    class Signal:
+
+        def emit(self, wrapper):
+            wrapper.accept_certificate()
+
+    class Page:
+        certificate_error = Signal()
+
+    assert webview.WebEnginePage.certificateError(Page(), FakeError())
