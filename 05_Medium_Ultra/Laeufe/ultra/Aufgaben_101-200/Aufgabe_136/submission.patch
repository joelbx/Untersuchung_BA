+class FakeReply:
+
+    def __init__(self):
+        self.ignore_calls = 0
+
+    def ignoreSslErrors(self):
+        self.ignore_calls += 1
+
+
+def test_reply_decision():
+    reply = FakeReply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply=reply, errors=[FakeError('test')])
+
+    assert reply.ignore_calls == 0
+    assert not wrapper.certificate_was_accepted()
+
+    wrapper.accept_certificate()
+    assert reply.ignore_calls == 1
+    assert wrapper.certificate_was_accepted()
+
+    wrapper.reject_certificate()
+    assert reply.ignore_calls == 1
+    assert not wrapper.certificate_was_accepted()
+
+    with pytest.raises(usertypes.UndeferrableError):
+        wrapper.defer()
+
+
+def test_positional_reply():
+    reply = FakeReply()
+    wrapper = certificateerror.CertificateErrorWrapper(
+        reply, [FakeError('test')])
+    wrapper.accept_certificate()
+    assert reply.ignore_calls == 1
