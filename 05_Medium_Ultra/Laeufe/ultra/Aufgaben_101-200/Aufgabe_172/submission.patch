+func TestNewPortStat(t *testing.T) {
+	tests := []struct {
+		name    string
+		input   string
+		want    PortStat
+		wantErr bool
+	}{
+		{name: "empty", input: "", want: PortStat{}},
+		{name: "ipv4", input: "127.0.0.1:22", want: PortStat{BindAddress: "127.0.0.1", Port: "22"}},
+		{name: "wildcard", input: "*:80", want: PortStat{BindAddress: "*", Port: "80"}},
+		{name: "ipv6", input: "[::1]:443", want: PortStat{BindAddress: "[::1]", Port: "443"}},
+		{name: "missing separator", input: "127.0.0.1", wantErr: true},
+		{name: "missing address", input: ":22", wantErr: true},
+		{name: "missing port", input: "127.0.0.1:", wantErr: true},
+		{name: "unbracketed ipv6", input: "::1:22", wantErr: true},
+		{name: "non ip address", input: "example.com:22", wantErr: true},
+		{name: "non numeric port", input: "127.0.0.1:ssh", wantErr: true},
+		{name: "out of range port", input: "127.0.0.1:65536", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := NewPortStat(tt.input)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("NewPortStat(%q) error = %v, wantErr %v", tt.input, err, tt.wantErr)
+			}
+			if !tt.wantErr && (got == nil || !reflect.DeepEqual(*got, tt.want)) {
+				t.Errorf("NewPortStat(%q) = %#v, want %#v", tt.input, got, tt.want)
+			}
+		})
+	}
+}
