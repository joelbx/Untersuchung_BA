+// UnmarshalJSON accepts listening ports from both string-based scan results and
+// results that stored structured ports in the listenPorts field.
+func (ap *AffectedProcess) UnmarshalJSON(data []byte) error {
+	var value struct {
+		PID             string          `json:"pid"`
+		Name            string          `json:"name"`
+		ListenPorts     json.RawMessage `json:"listenPorts"`
+		ListenPortStats []PortStat      `json:"listenPortStats"`
+	}
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	*ap = AffectedProcess{PID: value.PID, Name: value.Name, ListenPortStats: value.ListenPortStats}
+	if len(value.ListenPorts) == 0 || string(value.ListenPorts) == "null" {
+		return nil
+	}
+	var stringPorts []string
+	if err := json.Unmarshal(value.ListenPorts, &stringPorts); err == nil {
+		ap.ListenPorts = stringPorts
+		return nil
+	}
+
+	var oldPorts []struct {
+		Address           string   `json:"address"`
+		Port              string   `json:"port"`
+		PortScanSuccessOn []string `json:"portScanSuccessOn"`
+	}
+	if err := json.Unmarshal(value.ListenPorts, &oldPorts); err != nil {
+		return err
+	}
+	for _, port := range oldPorts {
+		ap.ListenPorts = append(ap.ListenPorts, port.Address+":"+port.Port)
+		ap.ListenPortStats = append(ap.ListenPortStats, PortStat{
+			BindAddress:     port.Address,
+			Port:            port.Port,
+			PortReachableTo: port.PortScanSuccessOn,
+		})
+	}
+	return nil
+}
+
+// PortStat has the result of parsing the port information to the address and port.
+type PortStat struct {
+	BindAddress     string   `json:"bindAddress"`
+	Port            string   `json:"port"`
+	PortReachableTo []string `json:"portReachableTo"`
+}
+
+// NewPortStat parses an IP address and port from a listening socket address.
+func NewPortStat(ipPort string) (*PortStat, error) {
+	stat := &PortStat{}
+	if ipPort == "" {
+		return stat, nil
+	}
+
+	host, port, err := net.SplitHostPort(ipPort)
+	if err != nil || host == "" || port == "" || (host != "*" && net.ParseIP(host) == nil) {
+		return nil, xerrors.Errorf("Invalid listening port: %s", ipPort)
+	}
+	portNumber, err := strconv.Atoi(port)
+	if err != nil || portNumber < 0 || portNumber > 65535 {
+		return nil, xerrors.Errorf("Invalid listening port: %s", ipPort)
+	}
+	if strings.Contains(host, ":") {
+		host = "[" + host + "]"
+	}
+	stat.BindAddress = host
+	stat.Port = port
+	return stat, nil
 }
 
