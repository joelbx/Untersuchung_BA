@@ -0,0 +1,48 @@
+import { parseStringToDOM } from '@proton/shared/lib/helpers/dom';
+
+import { prepareContentToModel } from './input';
+import { parseModelResult } from './result';
+
+describe('assistant content round trip', () => {
+    it('restores link and image formatting only for their originating message', () => {
+        const input =
+            '<a href="https://example.com" class="link" style="color: red">Link</a>' +
+            '<img src="https://example.com/image.png" class="image" style="width: 20px">';
+        const markdown = prepareContentToModel(input, 'uid', 'message-1');
+
+        const originalMessage = parseStringToDOM(parseModelResult(markdown, 'message-1'));
+        expect(originalMessage.querySelector('a')?.getAttribute('href')).toBe('https://example.com');
+        expect(originalMessage.querySelector('a')?.getAttribute('class')).toBe('link');
+        expect(originalMessage.querySelector('a')?.getAttribute('style')).toBe('color: red');
+        expect(originalMessage.querySelector('img')?.getAttribute('src')).toBe('https://example.com/image.png');
+        expect(originalMessage.querySelector('img')?.getAttribute('class')).toBe('image');
+        expect(originalMessage.querySelector('img')?.getAttribute('style')).toBe('width: 20px');
+
+        const otherMessage = parseStringToDOM(parseModelResult(markdown, 'message-2'));
+        expect(otherMessage.querySelector('a, img')).toBeNull();
+        expect(otherMessage.body.textContent).toContain('Link');
+    });
+
+    it('does not expose an unloaded image URL to the model', () => {
+        const markdown = prepareContentToModel(
+            '<img proton-src="https://example.com/private.png" class="image" style="width: 20px">',
+            'uid',
+            'message-1'
+        );
+
+        expect(markdown).not.toContain('https://example.com/private.png');
+        expect(markdown).toContain('<img');
+    });
+
+    it('drops generated links and images that were not in the message', () => {
+        const result = parseStringToDOM(
+            parseModelResult(
+                '[Visible text](https://unknown.example) ![Image](https://unknown.example/image.png)',
+                'message-1'
+            )
+        );
+
+        expect(result.querySelector('a, img')).toBeNull();
+        expect(result.body.textContent).toContain('Visible text');
+    });
+});
