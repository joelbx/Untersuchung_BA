@@ -0,0 +1,47 @@
+import { fixNestedLists, htmlToMarkdown, markdownToHTML } from './markdown';
+
+describe('assistant Markdown conversion', () => {
+    it('moves sibling nested lists into their preceding list item', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ol><li>Child</li></ol></ul>';
+
+        fixNestedLists(dom);
+
+        expect(dom.body.querySelector('ul > ol')).toBeNull();
+        expect(dom.body.querySelector('ul > li > ol > li')?.textContent).toBe('Child');
+    });
+
+    it('keeps nested list indentation through HTML and Markdown', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ul><li>Parent</li><ul><li>Child</li></ul></ul>';
+
+        const markdown = htmlToMarkdown(dom);
+        const converted = document.implementation.createHTMLDocument();
+        converted.body.innerHTML = markdownToHTML(markdown);
+
+        expect(converted.body.querySelector('ul > li > ul > li')?.textContent).toBe('Child');
+    });
+
+    it('retains ordered list items through HTML and Markdown', () => {
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = '<ol><li>First</li><li>Second</li></ol>';
+
+        const converted = document.implementation.createHTMLDocument();
+        converted.body.innerHTML = markdownToHTML(htmlToMarkdown(dom));
+
+        expect(Array.from(converted.querySelectorAll('ol > li'), (item) => item.textContent)).toEqual([
+            'First',
+            'Second',
+        ]);
+    });
+
+    it('renders headings, fenced code, and horizontal rules from assistant Markdown', () => {
+        const html = markdownToHTML('# Heading\n\n```js\nconst one = 1;\n  const path = "C:\\tmp";\n```\n\n---');
+        const dom = document.implementation.createHTMLDocument();
+        dom.body.innerHTML = html;
+
+        expect(dom.querySelector('h1')?.textContent).toBe('Heading');
+        expect(dom.querySelector('pre code')?.textContent).toBe('const one = 1;\n  const path = "C:\\tmp";\n');
+        expect(dom.querySelector('hr')).not.toBeNull();
+    });
+});
