+/** Resolve the server and .well-known policies for encryption in a new room. */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const wellKnownForcesDisabled = shouldForceDisableEncryption(client);
+    const serverForcesEnabled = await client.doesServerForceEncryptionForPreset(chatPreset);
+
+    if (serverForcesEnabled) {
+        if (wellKnownForcesDisabled) {
+            console.warn("Conflicting room encryption policies: server requires encryption, .well-known disables it");
+        }
+        return { allowChange: false, forcedValue: true };
+    }
+
+    if (wellKnownForcesDisabled) return { allowChange: false, forcedValue: false };
+    return { allowChange: true };
+}
