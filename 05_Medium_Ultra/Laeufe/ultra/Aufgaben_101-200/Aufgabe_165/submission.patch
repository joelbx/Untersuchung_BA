+import { MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import { shouldForceDisableEncryption } from "../../../src/utils/room/shouldForceDisableEncryption";
+
+describe("shouldForceDisableEncryption", () => {
+    const getClientWellKnown = jest.fn();
+    const client = { getClientWellKnown } as unknown as MatrixClient;
+
+    it.each([
+        ["missing well-known", null, false],
+        ["missing E2EE settings", {}, false],
+        ["missing force_disable", { "io.element.e2ee": { default: false } }, false],
+        ["force_disable false", { "io.element.e2ee": { force_disable: false } }, false],
+        ["non-boolean force_disable", { "io.element.e2ee": { force_disable: "true" } }, false],
+        ["force_disable true", { "io.element.e2ee": { force_disable: true } }, true],
+        ["legacy E2EE key with force_disable true", { "im.vector.riot.e2ee": { force_disable: true } }, true],
+    ])("returns %s policy correctly", (_description, wellKnown, expected) => {
+        getClientWellKnown.mockReturnValue(wellKnown);
+
+        expect(shouldForceDisableEncryption(client)).toBe(expected);
+    });
+});
