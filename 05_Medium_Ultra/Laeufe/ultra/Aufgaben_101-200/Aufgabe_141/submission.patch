new file mode 100644
index 0000000..d7895e7
--- /dev/null
+++ b/wordpress/wordpress_test.go
@@ -0,0 +1,138 @@
+package wordpress
+
+import (
+	"io"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+type stringReadCloser struct {
+	io.Reader
+}
+
+func (stringReadCloser) Close() error { return nil }
+
+func TestFillWordPressIgnoresInactive(t *testing.T) {
+	previousConf := config.Conf
+	previousTransport := http.DefaultTransport
+	defer func() {
+		config.Conf = previousConf
+		http.DefaultTransport = previousTransport
+	}()
+
+	for _, tt := range []struct {
+		name         string
+		ignore       bool
+		wantRequests []string
+		wantPackages int
+	}{
+		{
+			name: "default scans all packages",
+			wantRequests: []string{
+				"/api/v3/wordpresses/52", "/api/v3/themes/active-theme",
+				"/api/v3/themes/inactive-theme", "/api/v3/plugins/active-plugin",
+				"/api/v3/plugins/inactive-plugin",
+			},
+			wantPackages: 5,
+		},
+		{
+			name:   "flag skips inactive packages",
+			ignore: true,
+			wantRequests: []string{
+				"/api/v3/wordpresses/52", "/api/v3/themes/active-theme",
+				"/api/v3/plugins/active-plugin",
+			},
+			wantPackages: 3,
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf.WpIgnoreInactive = tt.ignore
+			requests := []string{}
+			http.DefaultTransport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				requests = append(requests, req.URL.Path)
+				return &http.Response{
+					StatusCode: http.StatusNotFound,
+					Body:       stringReadCloser{strings.NewReader("")},
+				}, nil
+			})
+
+			packages := models.WordPressPackages{
+				{Name: models.WPCore, Type: models.WPCore, Version: "5.2"},
+				{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+				{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+				{Name: "active-plugin", Type: models.WPPlugin, Status: "active"},
+				{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+			}
+			r := models.ScanResult{WordPressPackages: &packages}
+			if _, err := FillWordPress(&r, "token"); err != nil {
+				t.Fatalf("FillWordPress returned error: %v", err)
+			}
+			if !reflect.DeepEqual(requests, tt.wantRequests) {
+				t.Errorf("requested paths = %v, want %v", requests, tt.wantRequests)
+			}
+			if got := len(*r.WordPressPackages); got != tt.wantPackages {
+				t.Errorf("result package count = %d, want %d", got, tt.wantPackages)
+			}
+		})
+	}
+}
+
+func TestRemoveInactives(t *testing.T) {
+	tests := []struct {
+		name     string
+		packages models.WordPressPackages
+		want     models.WordPressPackages
+	}{
+		{
+			name: "mixed statuses and package types",
+			packages: models.WordPressPackages{
+				{Name: "wordpress", Type: models.WPCore, Version: "5.2"},
+				{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive},
+				{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+				{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive},
+				{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+				{Name: "unknown-status-plugin", Type: models.WPPlugin},
+			},
+			want: models.WordPressPackages{
+				{Name: "wordpress", Type: models.WPCore, Version: "5.2"},
+				{Name: "active-theme", Type: models.WPTheme, Status: "active"},
+				{Name: "must-use-plugin", Type: models.WPPlugin, Status: "must-use"},
+				{Name: "unknown-status-plugin", Type: models.WPPlugin},
+			},
+		},
+		{
+			name: "all inactive",
+			packages: models.WordPressPackages{
+				{Name: "theme", Type: models.WPTheme, Status: models.Inactive},
+				{Name: "plugin", Type: models.WPPlugin, Status: models.Inactive},
+			},
+		},
+		{
+			name:     "empty input",
+			packages: models.WordPressPackages{},
+		},
+		{
+			name: "nil input",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := removeInactives(tt.packages)
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("removeInactives(%v) = %v, want %v", tt.packages, got, tt.want)
+			}
+		})
+	}
+}
