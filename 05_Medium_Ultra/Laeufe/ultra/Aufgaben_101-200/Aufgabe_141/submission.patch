+package commands
+
+import (
+	"flag"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+)
+
+func TestWpIgnoreInactiveFlag(t *testing.T) {
+	previousConf := config.Conf
+	defer func() { config.Conf = previousConf }()
+
+	for _, tt := range []struct {
+		name     string
+		setFlags func(*flag.FlagSet)
+	}{
+		{name: "report", setFlags: (&ReportCmd{}).SetFlags},
+		{name: "tui", setFlags: (&TuiCmd{}).SetFlags},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf = config.Config{}
+			flags := flag.NewFlagSet(tt.name, flag.ContinueOnError)
+			tt.setFlags(flags)
+			if flags.Lookup("wp-ignore-inactive") == nil {
+				t.Fatal("wp-ignore-inactive flag is not registered")
+			}
+			if err := flags.Parse([]string{"-wp-ignore-inactive"}); err != nil {
+				t.Fatal(err)
+			}
+			if !config.Conf.WpIgnoreInactive {
+				t.Error("wp-ignore-inactive flag did not enable config")
+			}
+		})
+	}
+}
