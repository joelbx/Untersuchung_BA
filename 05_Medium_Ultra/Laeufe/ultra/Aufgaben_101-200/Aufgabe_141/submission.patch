+
+	dir, err := ioutil.TempDir("", "vuls-wp-ignore-inactive-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	tests := []struct {
+		name      string
+		tomlValue string
+		cliValue  bool
+		want      bool
+	}{
+		{name: "enabled by config", tomlValue: "true", want: true},
+		{name: "disabled by config", tomlValue: "false", want: false},
+		{name: "CLI true survives config false", tomlValue: "false", cliValue: true, want: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			Conf = Config{WpIgnoreInactive: tt.cliValue}
+			path := filepath.Join(dir, "config.toml")
+			if err := ioutil.WriteFile(path, []byte("wpIgnoreInactive = "+tt.tomlValue+"\n"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if err := (TOMLLoader{}).Load(path, ""); err != nil {
+				t.Fatal(err)
+			}
+			if Conf.WpIgnoreInactive != tt.want {
+				t.Errorf("WpIgnoreInactive = %t, want %t", Conf.WpIgnoreInactive, tt.want)
+			}
+		})
+	}
+}
