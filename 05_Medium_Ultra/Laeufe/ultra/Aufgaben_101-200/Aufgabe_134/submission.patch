diff --git a/openlibrary/tests/core/test_book_providers.py b/openlibrary/tests/core/test_book_providers.py
new file mode 100644
index 0000000..2c86c44
--- /dev/null
+++ b/openlibrary/tests/core/test_book_providers.py
@@ -0,0 +1,32 @@
+from openlibrary.book_providers import (
+    Acquisition,
+    ProjectRunebergProvider,
+    get_book_provider,
+    is_non_ia_ocaid,
+)
+
+
+def test_project_runeberg_provider_for_edition():
+    edition = {
+        'key': '/books/OL1M',
+        'identifiers': {'project_runeberg': ['nordic/work', 'other/work']},
+    }
+
+    provider = get_book_provider(edition)
+
+    assert isinstance(provider, ProjectRunebergProvider)
+    assert provider.solr_key == 'id_project_runeberg'
+    assert provider.get_acquisitions(edition) == [
+        Acquisition(
+            access='open-access',
+            format='web',
+            price=None,
+            url='https://runeberg.org/nordic/work/',
+            provider_name='runeberg',
+        )
+    ]
+
+
+def test_project_runeberg_archives_are_recognized():
+    assert is_non_ia_ocaid('nordic_runeberg_1900')
+    assert not ProjectRunebergProvider().is_own_ocaid('unrelated_archive')
