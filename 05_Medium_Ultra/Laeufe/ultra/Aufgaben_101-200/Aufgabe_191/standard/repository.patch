+import React from "react";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MatrixClient } from "matrix-js-sdk/src/client";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+import { MatrixError } from "matrix-js-sdk/src/http-api/errors";
+
+import InteractiveAuth from "../../../src/components/structures/InteractiveAuth";
+
+describe("InteractiveAuth registration token flow", () => {
+    const matrixClient = {
+        generateClientSecret: jest.fn().mockReturnValue("client-secret"),
+    } as unknown as MatrixClient;
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "completes a %s stage and passes the server response and session metadata to the callback",
+        async (loginType) => {
+            const serverResponse = { user_id: "@new-user:example.org" };
+            const makeRequest = jest.fn().mockResolvedValue(serverResponse);
+            const onAuthFinished = jest.fn();
+            const onStagePhaseChange = jest.fn();
+
+            render(
+                <InteractiveAuth
+                    matrixClient={matrixClient}
+                    authData={{ session: "session-id", flows: [{ stages: [loginType] }] }}
+                    clientSecret="client-secret"
+                    makeRequest={makeRequest}
+                    onAuthFinished={onAuthFinished}
+                    onStagePhaseChange={onStagePhaseChange}
+                />,
+            );
+
+            const input = await screen.findByRole("textbox", { name: "Registration token" });
+            expect(onStagePhaseChange).toHaveBeenCalledWith(loginType, 0);
+            fireEvent.change(input, { target: { value: "token-from-admin" } });
+            fireEvent.submit(input.closest("form"));
+
+            await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+            expect(makeRequest).toHaveBeenCalledTimes(1);
+            expect(makeRequest).toHaveBeenCalledWith({
+                session: "session-id",
+                type: loginType,
+                token: "token-from-admin",
+            });
+            expect(onAuthFinished).toHaveBeenCalledWith(true, serverResponse, {
+                clientSecret: "client-secret",
+                emailSid: undefined,
+            });
+        },
+    );
+
+    it("continues to the next advertised stage after the token is accepted", async () => {
+        const stages = [AuthType.RegistrationToken, AuthType.Dummy];
+        const serverResponse = { user_id: "@new-user:example.org" };
+        const makeRequest = jest
+            .fn()
+            .mockRejectedValueOnce(
+                new MatrixError(
+                    { session: "session-id", flows: [{ stages }], completed: [AuthType.RegistrationToken] },
+                    401,
+                ),
+            )
+            .mockResolvedValueOnce(serverResponse);
+        const onAuthFinished = jest.fn();
+
+        render(
+            <InteractiveAuth
+                matrixClient={matrixClient}
+                authData={{ session: "session-id", flows: [{ stages }] }}
+                clientSecret="client-secret"
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />,
+        );
+
+        const input = await screen.findByRole("textbox", { name: "Registration token" });
+        fireEvent.change(input, { target: { value: "token-from-admin" } });
+        fireEvent.submit(input.closest("form"));
+
+        await waitFor(() => expect(onAuthFinished).toHaveBeenCalledTimes(1));
+        expect(makeRequest.mock.calls).toEqual([
+            [{ session: "session-id", type: AuthType.RegistrationToken, token: "token-from-admin" }],
+            [{ session: "session-id", type: AuthType.Dummy }],
+        ]);
+        expect(onAuthFinished).toHaveBeenCalledWith(true, serverResponse, {
+            clientSecret: "client-secret",
+            emailSid: undefined,
+        });
+    });
+});
