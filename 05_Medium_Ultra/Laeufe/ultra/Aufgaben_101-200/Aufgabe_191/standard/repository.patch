+import React from "react";
+import { fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MatrixClient } from "matrix-js-sdk/src/client";
+import { AuthType } from "matrix-js-sdk/src/interactive-auth";
+
+import {
+    DEFAULT_PHASE,
+    RegistrationTokenAuthEntry,
+} from "../../../../src/components/views/auth/InteractiveAuthEntryComponents";
+
+describe("RegistrationTokenAuthEntry", () => {
+    const matrixClient = {} as MatrixClient;
+    const submitAuthDict = jest.fn();
+    const onPhaseChange = jest.fn();
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+    });
+
+    const renderEntry = (loginType: AuthType = AuthType.RegistrationToken, busy = false, errorText?: string) =>
+        render(
+            <RegistrationTokenAuthEntry
+                matrixClient={matrixClient}
+                authSessionId="session"
+                loginType={loginType}
+                busy={busy}
+                errorText={errorText}
+                submitAuthDict={submitAuthDict}
+                onPhaseChange={onPhaseChange}
+            />,
+        );
+
+    const getPrimaryAction = (container: HTMLElement): HTMLElement =>
+        container.querySelector(".mx_AccessibleButton_kind_primary");
+
+    it("shows a focused, labelled token field and enables the primary action when filled", () => {
+        const { container } = renderEntry();
+        const input = screen.getByRole("textbox", { name: "Registration token" });
+        const action = getPrimaryAction(container);
+
+        expect(RegistrationTokenAuthEntry.LOGIN_TYPE).toBe(AuthType.RegistrationToken);
+        expect(onPhaseChange).toHaveBeenCalledWith(DEFAULT_PHASE);
+        expect(input).toHaveAttribute("name", "registrationTokenField");
+        expect(input).toHaveFocus();
+        expect(screen.getByText("Enter a registration token provided by the homeserver administrator.")).toBeVisible();
+        expect(action).toHaveAttribute("role", "button");
+        expect(action).toHaveAttribute("aria-disabled", "true");
+        fireEvent.submit(input.closest("form"));
+        expect(submitAuthDict).not.toHaveBeenCalled();
+
+        fireEvent.change(input, { target: { value: "secret-token" } });
+        expect(getPrimaryAction(container)).not.toHaveAttribute("aria-disabled");
+
+        fireEvent.click(getPrimaryAction(container));
+        fireEvent.submit(input.closest("form"));
+        expect(submitAuthDict).toHaveBeenCalledTimes(1);
+        expect(submitAuthDict).toHaveBeenCalledWith({ type: AuthType.RegistrationToken, token: "secret-token" });
+    });
+
+    it.each([AuthType.RegistrationToken, AuthType.UnstableRegistrationToken])(
+        "submits %s with Enter using the advertised stage type and no session",
+        async (loginType) => {
+            renderEntry(loginType);
+            await userEvent.type(
+                screen.getByRole("textbox", { name: "Registration token" }),
+                "token-from-admin{enter}",
+            );
+
+            expect(submitAuthDict).toHaveBeenCalledTimes(1);
+            expect(submitAuthDict).toHaveBeenCalledWith({ type: loginType, token: "token-from-admin" });
+        },
+    );
+
+    it("shows a loading indicator and prevents another submission while busy", () => {
+        const { container, rerender } = renderEntry();
+        fireEvent.change(screen.getByRole("textbox", { name: "Registration token" }), {
+            target: { value: "secret-token" },
+        });
+
+        rerender(
+            <RegistrationTokenAuthEntry
+                matrixClient={matrixClient}
+                authSessionId="session"
+                loginType={AuthType.RegistrationToken}
+                busy={true}
+                submitAuthDict={submitAuthDict}
+                onPhaseChange={onPhaseChange}
+            />,
+        );
+
+        expect(screen.getByRole("progressbar")).toBeVisible();
+        expect(getPrimaryAction(container)).toBeNull();
+        fireEvent.submit(container.querySelector("form"));
+        expect(submitAuthDict).not.toHaveBeenCalled();
+    });
+
+    it("allows another token after the server rejects an attempt", () => {
+        const { rerender } = renderEntry();
+        const input = screen.getByRole("textbox", { name: "Registration token" });
+        fireEvent.change(input, { target: { value: "wrong-token" } });
+        fireEvent.submit(input.closest("form"));
+
+        rerender(
+            <RegistrationTokenAuthEntry
+                matrixClient={matrixClient}
+                authSessionId="session"
+                loginType={AuthType.RegistrationToken}
+                busy={true}
+                submitAuthDict={submitAuthDict}
+                onPhaseChange={onPhaseChange}
+            />,
+        );
+        rerender(
+            <RegistrationTokenAuthEntry
+                matrixClient={matrixClient}
+                authSessionId="session"
+                loginType={AuthType.RegistrationToken}
+                busy={false}
+                errorText="Invalid registration token"
+                submitAuthDict={submitAuthDict}
+                onPhaseChange={onPhaseChange}
+            />,
+        );
+
+        fireEvent.change(input, { target: { value: "correct-token" } });
+        fireEvent.submit(input.closest("form"));
+        expect(submitAuthDict).toHaveBeenNthCalledWith(2, {
+            type: AuthType.RegistrationToken,
+            token: "correct-token",
+        });
+    });
+
+    it("shows authentication errors as alerts", () => {
+        renderEntry(AuthType.RegistrationToken, false, "Invalid registration token");
+
+        expect(screen.getByRole("alert")).toHaveTextContent("Invalid registration token");
+        expect(screen.getByRole("alert")).toHaveClass("error");
+    });
+});
