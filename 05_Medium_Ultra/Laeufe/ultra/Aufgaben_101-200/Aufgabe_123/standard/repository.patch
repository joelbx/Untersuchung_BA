diff --git a/packages/components/containers/notifications/notifications.test.tsx b/packages/components/containers/notifications/notifications.test.tsx
new file mode 100644
index 0000000..f485d36
--- /dev/null
+++ b/packages/components/containers/notifications/notifications.test.tsx
@@ -0,0 +1,229 @@
+import { Dispatch, SetStateAction, useState } from 'react';
+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import NotificationsContainer from './Container';
+import { NotificationOptions } from './interfaces';
+import createNotificationManager from './manager';
+
+const renderNotification = (text: NotificationOptions['text']) => {
+    const notifications: NotificationOptions[] = [{ id: 1, key: 1, text, type: 'info', isClosing: false }];
+
+    return render(
+        <NotificationsContainer
+            notifications={notifications}
+            removeNotification={jest.fn()}
+            hideNotification={jest.fn()}
+        />
+    );
+};
+
+const expectSecureLinks = (links: HTMLAnchorElement[]) => {
+    links.forEach((link) => {
+        expect(link).toHaveAttribute('target', '_blank');
+        expect(link.getAttribute('rel')?.split(/\s+/)).toEqual(expect.arrayContaining(['noopener', 'noreferrer']));
+    });
+};
+
+const createTestManager = () => {
+    let notifications: NotificationOptions[] = [];
+    const setNotifications: Dispatch<SetStateAction<NotificationOptions[]>> = (value) => {
+        notifications = typeof value === 'function' ? value(notifications) : value;
+    };
+
+    return {
+        manager: createNotificationManager(setNotifications),
+        getNotifications: () => notifications,
+    };
+};
+
+describe('notification content', () => {
+    it('renders HTML strings as formatted content with secure, interactive links', () => {
+        const { container, getByRole, getByText } = renderNotification(
+            '<strong>Important</strong> <a href="https://example.com/help" target="_self" rel="external">Help</a> <a href="https://example.com/contact">Contact</a>'
+        );
+
+        expect(getByText('Important').tagName).toBe('STRONG');
+        expect(getByRole('link', { name: 'Help' })).toHaveAttribute('href', 'https://example.com/help');
+        expect(getByRole('link', { name: 'Contact' })).toHaveAttribute('href', 'https://example.com/contact');
+        const links = Array.from(container.querySelectorAll('a'));
+        expect(links).toHaveLength(2);
+        expectSecureLinks(links);
+    });
+
+    it('removes unsafe HTML and unsafe link destinations from strings', () => {
+        const { container, getByText } = renderNotification(
+            '<a href="javascript:alert(1)" onclick="alert(1)">Unsafe link</a><img src="x" onerror="alert(1)"><script>alert(1)</script>'
+        );
+
+        const link = getByText('Unsafe link');
+        expect(link).not.toHaveAttribute('href');
+        expect(link).not.toHaveAttribute('onclick');
+        expect(container.querySelector('img')?.hasAttribute('onerror')).not.toBe(true);
+        expect(container.querySelector('script')).toBeNull();
+        expectSecureLinks([link as HTMLAnchorElement]);
+    });
+
+    it('preserves plain strings and React elements, and secures links inside React elements', () => {
+        const plain = renderNotification('1 < 2');
+        expect(plain.getByRole('alert')).toHaveTextContent('1 < 2');
+        plain.unmount();
+
+        const { container, getByTestId, getByText } = renderNotification(
+            <span data-testid="react-content">
+                React <strong>content</strong>
+                <a href="https://example.com/one" target="_self">
+                    One
+                </a>
+                <a href="https://example.com/two" rel="external">
+                    Two
+                </a>
+            </span>
+        );
+
+        expect(getByTestId('react-content')).toBeInTheDocument();
+        expect(getByText('content').tagName).toBe('STRONG');
+        const links = Array.from(container.querySelectorAll('a'));
+        expect(links).toHaveLength(2);
+        expectSecureLinks(links);
+    });
+
+    it('secures links added later by React element content', async () => {
+        const DynamicContent = () => {
+            const [showLink, setShowLink] = useState(false);
+            return (
+                <>
+                    <button onClick={() => setShowLink(true)}>Show link</button>
+                    {showLink && (
+                        <a href="https://example.com/later" target="_self">
+                            Later
+                        </a>
+                    )}
+                </>
+            );
+        };
+
+        const { getByRole } = renderNotification(<DynamicContent />);
+        fireEvent.click(getByRole('button', { name: 'Show link' }));
+        await waitFor(() => expectSecureLinks([getByRole('link', { name: 'Later' }) as HTMLAnchorElement]));
+    });
+});
+
+describe('notification manager keys and deduplication', () => {
+    it('uses string text as the fallback key and replaces duplicate non-success notifications', () => {
+        const { manager, getNotifications } = createTestManager();
+
+        const firstId = manager.createNotification({ text: 'Same message', type: 'error', expiration: -1 });
+        expect(getNotifications()).toHaveLength(1);
+        expect(getNotifications()[0].key).toBe('Same message');
+
+        const secondId = manager.createNotification({ text: 'Same message', type: 'info', expiration: -1 });
+        expect(secondId).not.toBe(firstId);
+        expect(getNotifications()).toHaveLength(1);
+        expect(getNotifications()[0]).toMatchObject({ id: secondId, key: 'Same message', type: 'info' });
+    });
+
+    it('uses an explicit key in preference to text, including a falsy key', () => {
+        const { manager, getNotifications } = createTestManager();
+
+        manager.createNotification({ text: 'Same text', key: 0, type: 'error', expiration: -1 });
+        manager.createNotification({ text: 'Same text', key: 'other', type: 'warning', expiration: -1 });
+        expect(getNotifications()).toHaveLength(2);
+
+        const replacementId = manager.createNotification({
+            text: 'Different text',
+            key: 0,
+            type: 'info',
+            expiration: -1,
+        });
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications()[0]).toMatchObject({ id: replacementId, key: 0, text: 'Different text' });
+        expect(getNotifications()[1].key).toBe('other');
+    });
+
+    it('uses the identifier as the fallback key for React element text', () => {
+        const { manager, getNotifications } = createTestManager();
+
+        const firstId = manager.createNotification({
+            text: <strong>Same message</strong>,
+            type: 'error',
+            expiration: -1,
+        });
+        const secondId = manager.createNotification({
+            text: <strong>Same message</strong>,
+            type: 'error',
+            expiration: -1,
+        });
+
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications().map(({ key }) => key)).toEqual([firstId, secondId]);
+    });
+
+    it('deduplicates React element text when an explicit key is shared', () => {
+        const { manager, getNotifications } = createTestManager();
+
+        manager.createNotification({
+            text: <strong>First</strong>,
+            key: 'react-message',
+            type: 'error',
+            expiration: -1,
+        });
+        const replacementId = manager.createNotification({
+            text: <em>Updated</em>,
+            key: 'react-message',
+            type: 'warning',
+            expiration: -1,
+        });
+
+        expect(getNotifications()).toHaveLength(1);
+        expect(getNotifications()[0]).toMatchObject({ id: replacementId, key: 'react-message' });
+    });
+
+    it('clears the replaced notification timer', () => {
+        jest.useFakeTimers();
+        try {
+            const { manager, getNotifications } = createTestManager();
+            manager.createNotification({ text: 'Retry', type: 'error', expiration: 1000 });
+            expect(jest.getTimerCount()).toBe(1);
+
+            manager.createNotification({ text: 'Retry', type: 'error', expiration: 2000 });
+            expect(getNotifications()).toHaveLength(1);
+            expect(jest.getTimerCount()).toBe(1);
+
+            manager.clearNotifications();
+        } finally {
+            jest.clearAllTimers();
+            jest.useRealTimers();
+        }
+    });
+
+    it('allows repeated success notifications with identical text and keys', () => {
+        const { manager, getNotifications } = createTestManager();
+
+        manager.createNotification({ text: 'Saved', key: 'saved', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Saved', key: 'saved', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Saved', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Saved', type: 'success', expiration: -1 });
+
+        expect(getNotifications()).toHaveLength(4);
+        expect(getNotifications().map(({ key }) => key)).toEqual(['saved', 'saved', 'Saved', 'Saved']);
+
+        const { getAllByRole } = render(
+            <NotificationsContainer
+                notifications={getNotifications()}
+                removeNotification={jest.fn()}
+                hideNotification={jest.fn()}
+            />
+        );
+        expect(getAllByRole('alert')).toHaveLength(4);
+    });
+
+    it('does not replace a success notification when an error has the same key', () => {
+        const { manager, getNotifications } = createTestManager();
+
+        manager.createNotification({ text: 'Saved', key: 'shared', type: 'success', expiration: -1 });
+        manager.createNotification({ text: 'Failed', key: 'shared', type: 'error', expiration: -1 });
+
+        expect(getNotifications()).toHaveLength(2);
+        expect(getNotifications().map(({ type }) => type)).toEqual(['success', 'error']);
+    });
+});
