+// UpdateRemoteClusterStatus updates a remote cluster from its tunnel connections.
+// It keeps the latest heartbeat even after the connection that supplied it is gone.
+// It returns true if the resource changed.
+func UpdateRemoteClusterStatus(rc RemoteCluster, connections []TunnelConnection) bool {
+	status := teleport.RemoteClusterStatusOffline
+	lastHeartbeat := rc.GetLastHeartbeat()
+	if len(connections) > 0 {
+		// Tunnel records expire when their heartbeat becomes stale.
+		status = teleport.RemoteClusterStatusOnline
+		for _, conn := range connections {
+			if conn.GetLastHeartbeat().After(lastHeartbeat) {
+				lastHeartbeat = conn.GetLastHeartbeat()
+			}
+		}
+		lastHeartbeat = lastHeartbeat.UTC()
+	}
+	if rc.GetConnectionStatus() == status &&
+		rc.GetLastHeartbeat().Equal(lastHeartbeat) &&
+		rc.GetLastHeartbeat().Location() == lastHeartbeat.Location() {
+		return false
+	}
+	rc.SetConnectionStatus(status)
+	rc.SetLastHeartbeat(lastHeartbeat)
+	return true
+}
