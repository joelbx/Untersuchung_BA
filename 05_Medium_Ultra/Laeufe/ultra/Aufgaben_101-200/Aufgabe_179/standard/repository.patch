+func (s *AuthSuite) TestRemoteClusterStatusAndHeartbeat(c *C) {
+	clusterName := "remote.example.com"
+	rc, err := services.NewRemoteCluster(clusterName)
+	c.Assert(err, IsNil)
+	c.Assert(s.a.Presence.CreateRemoteCluster(rc), IsNil)
+
+	assertCluster := func(status string, heartbeat time.Time) {
+		cluster, err := s.a.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(cluster.GetConnectionStatus(), Equals, status)
+		c.Assert(cluster.GetLastHeartbeat().Equal(heartbeat), Equals, true)
+		c.Assert(cluster.GetLastHeartbeat().Location(), Equals, time.UTC)
+
+		// The computed status and heartbeat must survive a fresh backend read.
+		stored, err := s.a.Presence.GetRemoteCluster(clusterName)
+		c.Assert(err, IsNil)
+		c.Assert(stored.GetConnectionStatus(), Equals, status)
+		c.Assert(stored.GetLastHeartbeat().Equal(heartbeat), Equals, true)
+		c.Assert(stored.GetLastHeartbeat().Location(), Equals, time.UTC)
+	}
+
+	assertCluster(teleport.RemoteClusterStatusOffline, time.Time{})
+
+	// Tunnel records remain online even when their heartbeat is old. A non-UTC
+	// input also verifies that the stored heartbeat is normalized to UTC.
+	heartbeat1 := time.Date(2020, time.January, 2, 3, 4, 5, 0, time.FixedZone("UTC+02", 2*60*60))
+	heartbeat2 := heartbeat1.Add(time.Minute)
+	heartbeat3 := heartbeat2.Add(time.Minute)
+	conn1, err := services.NewTunnelConnection("conn1", services.TunnelConnectionSpecV2{
+		ClusterName: clusterName, ProxyName: "proxy1", LastHeartbeat: heartbeat1,
+	})
+	c.Assert(err, IsNil)
+	conn2, err := services.NewTunnelConnection("conn2", services.TunnelConnectionSpecV2{
+		ClusterName: clusterName, ProxyName: "proxy2", LastHeartbeat: heartbeat2,
+	})
+	c.Assert(err, IsNil)
+
+	c.Assert(s.a.Presence.UpsertTunnelConnection(conn1), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, heartbeat1)
+	c.Assert(s.a.Presence.UpsertTunnelConnection(conn2), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, heartbeat2)
+
+	conn1.SetLastHeartbeat(heartbeat3)
+	c.Assert(s.a.Presence.UpsertTunnelConnection(conn1), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, heartbeat3)
+
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, conn1.GetName()), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, heartbeat3)
+	c.Assert(s.a.Presence.DeleteTunnelConnection(clusterName, conn2.GetName()), IsNil)
+	assertCluster(teleport.RemoteClusterStatusOffline, heartbeat3)
+}
