+func (s *PresenceSuite) TestRemoteClusterTunnelTransitions(c *check.C) {
+	presence := NewPresenceService(s.bk)
+	name := "remote.example.com"
+	rc, err := services.NewRemoteCluster(name)
+	c.Assert(err, check.IsNil)
+	c.Assert(presence.CreateRemoteCluster(rc), check.IsNil)
+
+	assertCluster := func(status string, heartbeat time.Time) {
+		stored, err := presence.GetRemoteCluster(name)
+		c.Assert(err, check.IsNil)
+		c.Assert(stored.GetConnectionStatus(), check.Equals, status)
+		c.Assert(stored.GetLastHeartbeat().Equal(heartbeat), check.Equals, true)
+		c.Assert(stored.GetLastHeartbeat().Location(), check.Equals, time.UTC)
+	}
+	assertCluster(teleport.RemoteClusterStatusOffline, time.Time{})
+
+	first := time.Date(2020, time.January, 2, 3, 4, 5, 0, time.FixedZone("UTC+02", 2*60*60))
+	second := first.Add(time.Minute)
+	third := second.Add(time.Minute)
+	conn1, err := services.NewTunnelConnection("conn1", services.TunnelConnectionSpecV2{
+		ClusterName: name, ProxyName: "proxy1", LastHeartbeat: first,
+	})
+	c.Assert(err, check.IsNil)
+	conn2, err := services.NewTunnelConnection("conn2", services.TunnelConnectionSpecV2{
+		ClusterName: name, ProxyName: "proxy2", LastHeartbeat: second,
+	})
+	c.Assert(err, check.IsNil)
+
+	c.Assert(presence.UpsertTunnelConnection(conn1), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, first)
+	c.Assert(presence.UpsertTunnelConnection(conn2), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, second)
+	conn1.SetLastHeartbeat(third)
+	c.Assert(presence.UpsertTunnelConnection(conn1), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, third)
+	c.Assert(presence.DeleteTunnelConnection(name, conn1.GetName()), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, third)
+	c.Assert(presence.DeleteTunnelConnection(name, conn2.GetName()), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOffline, third)
+
+	c.Assert(presence.UpsertTunnelConnection(conn1), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOnline, third)
+	c.Assert(presence.DeleteTunnelConnections(name), check.IsNil)
+	assertCluster(teleport.RemoteClusterStatusOffline, third)
+
+	fourth := third.Add(time.Minute)
+	conn2.SetLastHeartbeat(fourth)
