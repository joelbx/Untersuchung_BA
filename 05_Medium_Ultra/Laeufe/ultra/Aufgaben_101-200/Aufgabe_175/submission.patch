+package cmd
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/db"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	backupCmd := &cobra.Command{
+		Use:   "backup",
+		Short: "Manage database backups",
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			return cmd.Help()
+		},
+	}
+
+	createCmd := &cobra.Command{
+		Use:   "create",
+		Short: "Create a database backup",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, err := db.Db().Backup(cmd.Context())
+			if err != nil {
+				return fmt.Errorf("create database backup: %w", err)
+			}
+			cmd.Printf("Created backup: %s\n", path)
+			return nil
+		},
+	}
+
+	pruneCmd := &cobra.Command{
+		Use:   "prune",
+		Short: "Delete old database backups",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			force, err := cmd.Flags().GetBool("force")
+			if err != nil {
+				return err
+			}
+			if conf.Server.Backup.Count < 0 {
+				return fmt.Errorf("backup.count cannot be negative")
+			}
+			if conf.Server.Backup.Count == 0 && !force {
+				confirmed, err := confirmBackupAction(cmd,
+					fmt.Sprintf("backup.count is 0; this will delete all database backups in %q", conf.Server.Backup.Path))
+				if err != nil {
+					return err
+				}
+				if !confirmed {
+					cmd.Println("Backup pruning cancelled.")
+					return nil
+				}
+			}
+
+			count, err := db.Db().Prune(cmd.Context())
+			if err != nil {
+				return fmt.Errorf("prune database backups: %w", err)
+			}
+			cmd.Printf("Pruned %d database backup(s).\n", count)
+			return nil
+		},
+	}
+	pruneCmd.Flags().Bool("force", false, "prune without confirmation when backup.count is 0")
+
+	restoreCmd := &cobra.Command{
+		Use:   "restore",
+		Short: "Restore the database from a backup file",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			path, err := cmd.Flags().GetString("backup-file")
+			if err != nil {
+				return err
+			}
+			if strings.TrimSpace(path) == "" {
+				return fmt.Errorf("--backup-file must specify a backup path")
+			}
+			force, err := cmd.Flags().GetBool("force")
+			if err != nil {
+				return err
+			}
+			if !force {
+				confirmed, err := confirmBackupAction(cmd, fmt.Sprintf("Restore %q over the current database", path))
+				if err != nil {
+					return err
+				}
+				if !confirmed {
+					cmd.Println("Database restore cancelled.")
+					return nil
+				}
+			}
+
+			if err := db.Db().Restore(cmd.Context(), path); err != nil {
+				return fmt.Errorf("restore database backup %q: %w", path, err)
+			}
+			cmd.Printf("Restored database from %s.\n", path)
+			return nil
+		},
+	}
+	restoreCmd.Flags().String("backup-file", "", "path to the database backup to restore")
+	restoreCmd.Flags().Bool("force", false, "restore without confirmation")
+	_ = restoreCmd.MarkFlagRequired("backup-file")
+
+	backupCmd.AddCommand(createCmd, pruneCmd, restoreCmd)
+	rootCmd.AddCommand(backupCmd)
+}
+
+// confirmBackupAction accepts an explicit "yes" before a destructive backup operation.
+// An empty response or closed input cancels the operation.
+func confirmBackupAction(cmd *cobra.Command, action string) (bool, error) {
+	if _, err := fmt.Fprintf(cmd.OutOrStdout(), "%s. Type 'yes' to continue: ", action); err != nil {
+		return false, fmt.Errorf("write confirmation prompt: %w", err)
+	}
+	scanner := bufio.NewScanner(cmd.InOrStdin())
+	if !scanner.Scan() {
+		if err := scanner.Err(); err != nil {
+			return false, fmt.Errorf("read confirmation response: %w", err)
+		}
+		return false, nil
+	}
+	return strings.EqualFold(strings.TrimSpace(scanner.Text()), "yes"), nil
+}
