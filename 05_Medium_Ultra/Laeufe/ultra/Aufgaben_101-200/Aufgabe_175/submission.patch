@@ -0,0 +1,145 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestBackupAndRestore(t *testing.T) {
+	previous := conf.Server.Backup
+	t.Cleanup(func() { conf.Server.Backup = previous })
+	conf.Server.Backup.Path = filepath.Join(t.TempDir(), "backups?#")
+	conf.Server.Backup.Count = 0 // Manual backups do not depend on retention.
+
+	livePath := filepath.Join(t.TempDir(), "live.db")
+	live, err := sql.Open(Driver, livePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = live.Close() })
+	if _, err := live.Exec("PRAGMA journal_mode=WAL"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := live.Exec("CREATE TABLE records (value TEXT); INSERT INTO records (value) VALUES ('before')"); err != nil {
+		t.Fatal(err)
+	}
+	database := &db{readDB: live, writeDB: live}
+	ctx := context.Background()
+
+	backupPath, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Dir(backupPath) != conf.Server.Backup.Path || !isBackupName(filepath.Base(backupPath)) {
+		t.Fatalf("unexpected backup path %q", backupPath)
+	}
+	backupURL, err := sqliteFileURL(backupPath, "ro")
+	if err != nil {
+		t.Fatal(err)
+	}
+	backup, err := sql.Open(Driver, backupURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value string
+	if err := backup.QueryRow("SELECT value FROM records").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if err := backup.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if value != "before" {
+		t.Fatalf("backup contains %q, want before", value)
+	}
+
+	if _, err := live.Exec("UPDATE records SET value = 'after'"); err != nil {
+		t.Fatal(err)
+	}
+	secondPath, err := database.Backup(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if secondPath == backupPath {
+		t.Fatal("backups made close together used the same path")
+	}
+	if err := database.Restore(ctx, backupPath); err != nil {
+		t.Fatal(err)
+	}
+	if err := live.QueryRow("SELECT value FROM records").Scan(&value); err != nil {
+		t.Fatal(err)
+	}
+	if value != "before" {
+		t.Fatalf("restored value is %q, want before", value)
+	}
+
+	if err := database.Restore(ctx, livePath); err == nil || !strings.Contains(err.Error(), "live database") {
+		t.Fatalf("restoring from live database returned %v", err)
+	}
+	invalidPath := filepath.Join(t.TempDir(), "invalid.db")
+	if err := os.WriteFile(invalidPath, []byte("not a database"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := database.Restore(ctx, invalidPath); err == nil {
+		t.Fatal("restoring an invalid database succeeded")
+	}
+	if err := live.QueryRow("SELECT value FROM records").Scan(&value); err != nil || value != "before" {
+		t.Fatalf("invalid restore modified live database: value=%q, err=%v", value, err)
+	}
+}
+
+func TestPruneBackups(t *testing.T) {
+	previous := conf.Server.Backup
+	t.Cleanup(func() { conf.Server.Backup = previous })
+	backupDir := t.TempDir()
+	conf.Server.Backup.Path = backupDir
+	conf.Server.Backup.Count = 2
+	var names []string
+	for i := range 4 {
+		name := backupPrefix + time.Date(2024, 1, i+1, 0, 0, 0, 0, time.UTC).Format(backupTimeFormat) + backupSuffix
+		names = append(names, name)
+		if err := os.WriteFile(filepath.Join(backupDir, name), []byte("backup"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	unrelated := filepath.Join(backupDir, "unrelated.db")
+	if err := os.WriteFile(unrelated, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(backupDir, backupPrefix+"invalid.db"), []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	removed, err := (&db{}).Prune(context.Background())
+	if err != nil || removed != 2 {
+		t.Fatalf("Prune() = %d, %v; want 2, nil", removed, err)
+	}
+	for i, name := range names {
+		_, err := os.Stat(filepath.Join(backupDir, name))
+		if i < 2 && !os.IsNotExist(err) {
+			t.Fatalf("old backup %q was not removed: %v", name, err)
+		}
+		if i >= 2 && err != nil {
+			t.Fatalf("recent backup %q was removed: %v", name, err)
+		}
+	}
+
+	conf.Server.Backup.Count = 0
+	removed, err = prune(context.Background())
+	if err != nil || removed != 2 {
+		t.Fatalf("prune() with count zero = %d, %v; want 2, nil", removed, err)
+	}
+	if _, err := os.Stat(unrelated); err != nil {
+		t.Fatalf("unrelated file was removed: %v", err)
+	}
+	conf.Server.Backup.Count = -1
+	if _, err := prune(context.Background()); err == nil {
+		t.Fatal("negative backup count did not return an error")
+	}
+}
