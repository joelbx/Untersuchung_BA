index 0000000..3ae258d
--- /dev/null
+++ b/db/backup.go
@@ -0,0 +1,268 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/mattn/go-sqlite3"
+	"github.com/navidrome/navidrome/conf"
+)
+
+const (
+	backupPrefix     = "navidrome_backup_"
+	backupTimeFormat = "20060102T150405.000000000"
+	backupSuffix     = ".db"
+)
+
+// Backup creates a consistent snapshot of the live SQLite database.
+func (d *db) Backup(ctx context.Context) (path string, err error) {
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	backupDir := conf.Server.Backup.Path
+	if backupDir == "" {
+		return "", errors.New("backup path is not configured")
+	}
+	if err := os.MkdirAll(backupDir, 0700); err != nil {
+		return "", fmt.Errorf("create backup directory %q: %w", backupDir, err)
+	}
+
+	// Exclusive creation ensures two backups made close together cannot overwrite one another.
+	for timestamp := time.Now().UTC(); ; timestamp = timestamp.Add(time.Nanosecond) {
+		path = filepath.Join(backupDir, backupPrefix+timestamp.Format(backupTimeFormat)+backupSuffix)
+		file, createErr := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if errors.Is(createErr, os.ErrExist) {
+			continue
+		}
+		if createErr != nil {
+			return "", fmt.Errorf("create backup file %q: %w", path, createErr)
+		}
+		if closeErr := file.Close(); closeErr != nil {
+			removeBackupFiles(path)
+			return "", fmt.Errorf("close backup file %q: %w", path, closeErr)
+		}
+		break
+	}
+	backupPath := path
+	defer func() {
+		if err != nil {
+			removeBackupFiles(backupPath)
+			path = ""
+		}
+	}()
+
+	destinationURL, err := sqliteFileURL(path, "rwc")
+	if err != nil {
+		return "", fmt.Errorf("resolve backup file %q: %w", path, err)
+	}
+	destination, err := sql.Open(Driver, destinationURL)
+	if err != nil {
+		return "", fmt.Errorf("open backup file %q: %w", path, err)
+	}
+	defer func() { err = errors.Join(err, destination.Close()) }()
+
+	err = copySQLite(ctx, destination, d.readDB)
+	if err != nil {
+		return "", fmt.Errorf("back up database to %q: %w", path, err)
+	}
+	return path, nil
+}
+
+// Restore replaces the live SQLite database with the specified backup.
+func (d *db) Restore(ctx context.Context, path string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if path == "" {
+		return errors.New("backup file path is required")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return fmt.Errorf("stat backup file %q: %w", path, err)
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("backup file %q is not a regular file", path)
+	}
+	if same, err := sameSQLiteFile(ctx, d.writeDB, info); err != nil {
+		return fmt.Errorf("check live database path: %w", err)
+	} else if same {
+		return fmt.Errorf("backup file %q is the live database", path)
+	}
+	fileURL, err := sqliteFileURL(path, "ro")
+	if err != nil {
+		return fmt.Errorf("resolve backup file %q: %w", path, err)
+	}
+	source, err := sql.Open(Driver, fileURL)
+	if err != nil {
+		return fmt.Errorf("open backup file %q: %w", path, err)
+	}
+	defer source.Close()
+
+	// Validate the source before allowing SQLite to replace the destination.
+	var check string
+	if err := source.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&check); err != nil {
+		return fmt.Errorf("check backup file %q: %w", path, err)
+	}
+	if check != "ok" {
+		return fmt.Errorf("backup file %q failed integrity check: %s", path, check)
+	}
+	if err := copySQLite(ctx, d.writeDB, source); err != nil {
+		return fmt.Errorf("restore database from %q: %w", path, err)
+	}
+	return nil
+}
+
+func sqliteFileURL(path, mode string) (string, error) {
+	absolutePath, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	uriPath := filepath.ToSlash(absolutePath)
+	if filepath.VolumeName(absolutePath) != "" && !strings.HasPrefix(uriPath, "/") {
+		uriPath = "/" + uriPath
+	}
+	return (&url.URL{Scheme: "file", Path: uriPath, RawQuery: "mode=" + mode}).String(), nil
+}
+
+func sameSQLiteFile(ctx context.Context, live *sql.DB, backupInfo os.FileInfo) (bool, error) {
+	var sequence int
+	var name, livePath string
+	if err := live.QueryRowContext(ctx, "PRAGMA database_list").Scan(&sequence, &name, &livePath); err != nil {
+		return false, err
+	}
+	if livePath == "" { // In-memory SQLite databases have no on-disk path.
+		return false, nil
+	}
+	liveInfo, err := os.Stat(livePath)
+	if err != nil {
+		return false, err
+	}
+	return os.SameFile(liveInfo, backupInfo), nil
+}
+
+// Prune removes all but the newest configured number of backup files.
+func (d *db) Prune(ctx context.Context) (int, error) {
+	return prune(ctx)
+}
+
+func prune(ctx context.Context) (int, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	backupDir := conf.Server.Backup.Path
+	if backupDir == "" {
+		return 0, errors.New("backup path is not configured")
+	}
+	count := conf.Server.Backup.Count
+	if count < 0 {
+		return 0, fmt.Errorf("backup count must not be negative: %d", count)
+	}
+	entries, err := os.ReadDir(backupDir)
+	if err != nil {
+		return 0, fmt.Errorf("read backup directory %q: %w", backupDir, err)
+	}
+	var backups []string
+	for _, entry := range entries {
+		if !entry.Type().IsRegular() || !isBackupName(entry.Name()) {
+			continue
+		}
+		backups = append(backups, entry.Name())
+	}
+	// The UTC timestamp format sorts lexically in the same order as time.
+	sort.Sort(sort.Reverse(sort.StringSlice(backups)))
+	pruned := 0
+	for _, name := range backups[min(count, len(backups)):] {
+		if err := ctx.Err(); err != nil {
+			return pruned, err
+		}
+		path := filepath.Join(backupDir, name)
+		if err := os.Remove(path); err != nil {
+			return pruned, fmt.Errorf("remove backup file %q: %w", path, err)
+		}
+		pruned++
+	}
+	return pruned, nil
+}
+
+func isBackupName(name string) bool {
+	if !strings.HasPrefix(name, backupPrefix) || !strings.HasSuffix(name, backupSuffix) {
+		return false
+	}
+	timestamp := strings.TrimSuffix(strings.TrimPrefix(name, backupPrefix), backupSuffix)
+	_, err := time.Parse(backupTimeFormat, timestamp)
+	return err == nil
+}
+
+// copySQLite uses SQLite's online backup API in batches so cancellation can
+// interrupt a long copy or a database that remains locked.
+func copySQLite(ctx context.Context, destination, source *sql.DB) error {
+	destConn, err := destination.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer destConn.Close()
+	srcConn, err := source.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer srcConn.Close()
+
+	return destConn.Raw(func(destRaw any) error {
+		destSQLite, ok := destRaw.(*sqlite3.SQLiteConn)
+		if !ok {
+			return fmt.Errorf("destination connection is %T, expected SQLite", destRaw)
+		}
+		return srcConn.Raw(func(srcRaw any) error {
+			srcSQLite, ok := srcRaw.(*sqlite3.SQLiteConn)
+			if !ok {
+				return fmt.Errorf("source connection is %T, expected SQLite", srcRaw)
+			}
+			backup, err := destSQLite.Backup("main", srcSQLite, "main")
+			if err != nil {
+				return err
+			}
+			return stepSQLiteBackup(ctx, backup)
+		})
+	})
+}
+
+func stepSQLiteBackup(ctx context.Context, backup *sqlite3.SQLiteBackup) (err error) {
+	defer func() { err = errors.Join(err, backup.Finish()) }()
+	remaining := backup.Remaining()
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		done, err := backup.Step(128)
+		if err != nil {
+			return err
+		}
+		if done {
+			return nil
+		}
+		nextRemaining := backup.Remaining()
+		if nextRemaining >= remaining {
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(10 * time.Millisecond):
+			}
+		}
+		remaining = nextRemaining
+	}
+}
+
+func removeBackupFiles(path string) {
+	_ = os.Remove(path)
+	_ = os.Remove(path + "-journal")
+	_ = os.Remove(path + "-wal")
+	_ = os.Remove(path + "-shm")
+}
