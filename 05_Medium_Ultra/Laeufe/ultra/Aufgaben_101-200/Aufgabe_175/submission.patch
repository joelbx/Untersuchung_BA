@@ -0,0 +1,36 @@
+package conf
+
+import "testing"
+
+func TestValidateBackupSchedule(t *testing.T) {
+	previous := Server
+	defer func() { Server = previous }()
+
+	tests := []struct {
+		name     string
+		schedule string
+		want     string
+		wantErr  bool
+	}{
+		{name: "disabled", schedule: "", want: ""},
+		{name: "duration", schedule: "2h", want: "@every 2h"},
+		{name: "cron expression", schedule: "0 3 * * *", want: "0 3 * * *"},
+		{name: "invalid", schedule: "not a schedule", want: "not a schedule", wantErr: true},
+		{name: "zero duration", schedule: "0s", want: "0s", wantErr: true},
+		{name: "negative duration", schedule: "-1h", want: "-1h", wantErr: true},
+		{name: "zero descriptor", schedule: "@every 0s", want: "@every 0s", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			Server = &configOptions{Backup: backupOptions{Schedule: tt.schedule}}
+			err := validateBackupSchedule()
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("validateBackupSchedule() error = %v, wantErr %t", err, tt.wantErr)
+			}
+			if Server.Backup.Schedule != tt.want {
+				t.Errorf("schedule = %q, want %q", Server.Backup.Schedule, tt.want)
+			}
+		})
+	}
+}
