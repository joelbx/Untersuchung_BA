+
+import React from "react";
+import { fireEvent, render, screen } from "@testing-library/react";
+
+import { KebabContextMenu } from "../../../../src/components/views/context_menus/KebabContextMenu";
+import { IconizedContextMenuOption } from "../../../../src/components/views/context_menus/IconizedContextMenu";
+import { mockPlatformPeg } from "../../../test-utils";
+
+mockPlatformPeg();
+
+describe("<KebabContextMenu />", () => {
+    const title = "Session actions";
+
+    const renderMenu = (onSignOut = jest.fn()) => {
+        const result = render(<KebabContextMenu
+            title={title}
+            options={[<IconizedContextMenuOption key="sign-out" label="Sign out" onClick={onSignOut} />]}
+        />);
+        return { ...result, trigger: result.getByRole("button", { name: title }), onSignOut };
+    };
+
+    it("exposes its title, icon and popup state", () => {
+        const { trigger } = renderMenu();
+
+        expect(trigger).toHaveAttribute("aria-haspopup", "true");
+        expect(trigger).toHaveAttribute("aria-expanded", "false");
+        expect(trigger.querySelector(".mx_KebabContextMenu_icon")).toBeInTheDocument();
+
+        fireEvent.click(trigger);
+        expect(trigger).toHaveAttribute("aria-expanded", "true");
+        expect(screen.getByRole("menuitem", { name: "Sign out" })).toBeInTheDocument();
+        expect(screen.getByRole("menuitem", { name: "Sign out" })).toHaveFocus();
+
+        fireEvent.keyDown(screen.getByRole("menu"), { key: "Escape" });
+        expect(trigger).toHaveAttribute("aria-expanded", "false");
+        expect(screen.queryByRole("menu")).not.toBeInTheDocument();
+        expect(trigger).toHaveFocus();
+    });
+
+    it.each([
+        ["Enter", "keyDown"],
+        [" ", "keyUp"],
+    ] as const)("activates an item with %s and closes the menu", (key, eventType) => {
+        const { trigger, onSignOut } = renderMenu();
+        trigger.focus();
+        fireEvent.click(trigger);
+        const item = screen.getByRole("menuitem", { name: "Sign out" });
+
+        if (eventType === "keyDown") {
+            fireEvent.keyDown(item, { key });
+        } else {
+            fireEvent.keyDown(item, { key });
+            fireEvent.keyUp(item, { key });
+        }
+
+        expect(onSignOut).toHaveBeenCalledTimes(1);
+        expect(trigger).toHaveAttribute("aria-expanded", "false");
+        expect(screen.queryByRole("menu")).not.toBeInTheDocument();
+        expect(trigger).toHaveFocus();
+    });
+
+    it.each([
+        ["Enter", "keyDown"],
+        [" ", "keyUp"],
+    ] as const)("opens the menu from the trigger with %s", (key, eventType) => {
+        const { trigger } = renderMenu();
+        trigger.focus();
+        if (eventType === "keyDown") {
+            fireEvent.keyDown(trigger, { key });
+        } else {
+            fireEvent.keyDown(trigger, { key });
+            fireEvent.keyUp(trigger, { key });
+        }
+
+        expect(trigger).toHaveAttribute("aria-expanded", "true");
+        expect(screen.getByRole("menuitem", { name: "Sign out" })).toHaveFocus();
+    });
+
+    it("moves focus between items with arrow keys", () => {
+        const { getByRole } = render(<KebabContextMenu
+            title={title}
+            options={[
+                <IconizedContextMenuOption key="current" label="Sign out" onClick={jest.fn()} />,
+                <IconizedContextMenuOption key="others" label="Sign out all other sessions" onClick={jest.fn()} />,
+            ]}
+        />);
+        fireEvent.click(getByRole("button", { name: title }));
+        const first = screen.getByRole("menuitem", { name: "Sign out" });
+        const second = screen.getByRole("menuitem", { name: "Sign out all other sessions" });
+        Object.defineProperty(second, "offsetParent", { value: second.parentElement });
+
+        expect(first).toHaveFocus();
+        fireEvent.keyDown(first, { key: "ArrowDown" });
+        expect(second).toHaveFocus();
+    });
+
+    it("closes when an item stops click propagation", () => {
+        const onSignOut = jest.fn();
+        const { getByRole } = render(<KebabContextMenu
+            title={title}
+            options={[<IconizedContextMenuOption
+                key="sign-out"
+                label="Sign out"
+                onClick={(event) => {
+                    event.stopPropagation();
+                    onSignOut();
+                }}
+            />]}
+        />);
+        const trigger = getByRole("button", { name: title });
+
+        fireEvent.click(trigger);
+        fireEvent.click(screen.getByRole("menuitem", { name: "Sign out" }));
+
+        expect(onSignOut).toHaveBeenCalledTimes(1);
+        expect(trigger).toHaveAttribute("aria-expanded", "false");
+        expect(trigger).toHaveFocus();
+    });
+
+    it("places the menu below the trigger with its right edge aligned", () => {
+        const { trigger } = renderMenu();
+        jest.spyOn(trigger, "getBoundingClientRect").mockReturnValue({
+            x: 200,
+            y: 40,
+            width: 40,
+            height: 20,
+            top: 40,
+            left: 200,
+            right: 240,
+            bottom: 60,
+            toJSON: () => ({}),
+        });
+
+        fireEvent.click(trigger);
+        const menu = screen.getByRole("menu");
+        const wrapper = menu.closest(".mx_ContextualMenu_wrapper") as HTMLElement;
+
+        expect(wrapper).toHaveStyle({ left: "240px", top: "68px" });
+        expect(menu).toHaveClass("mx_ContextualMenu_rightAligned");
+    });
+
+    it("does not open when disabled", () => {
+        const { getByRole, queryByRole } = render(<KebabContextMenu
+            title={title}
+            disabled
+            options={[<IconizedContextMenuOption key="sign-out" label="Sign out" onClick={jest.fn()} />]}
+        />);
+        const trigger = getByRole("button", { name: title });
+
+        expect(trigger).toHaveAttribute("aria-disabled", "true");
+        fireEvent.click(trigger);
+        expect(trigger).toHaveAttribute("aria-expanded", "false");
+        expect(queryByRole("menu")).not.toBeInTheDocument();
+    });
+});
