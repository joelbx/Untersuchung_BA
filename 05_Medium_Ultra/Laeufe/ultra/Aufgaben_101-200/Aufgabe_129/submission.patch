+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import React, { useEffect } from "react";
+import classNames from "classnames";
+
+import { ChevronFace, ContextMenuButton, useContextMenu } from "../../structures/ContextMenu";
+import AccessibleButton, { ButtonEvent } from "../elements/AccessibleButton";
+import IconizedContextMenu from "./IconizedContextMenu";
+
+interface IProps extends Omit<React.ComponentProps<typeof AccessibleButton>,
+    "onClick" | "children" | "title" | "inputRef"> {
+    options: React.ReactNode[];
+    title: string;
+}
+
+/** An icon button with a right-aligned context menu of supplied actions. */
+export const KebabContextMenu: React.FC<IProps> = ({
+    options,
+    title,
+    disabled,
+    className,
+    kind,
+    onKeyDown,
+    ...buttonProps
+}) => {
+    const [menuDisplayed, button, openMenu, closeMenu] = useContextMenu<HTMLButtonElement>();
+
+    useEffect(() => {
+        if (disabled && menuDisplayed) closeMenu();
+    }, [disabled, menuDisplayed, closeMenu]);
+
+    const onOpen = (event: ButtonEvent): void => {
+        // ContextMenu restores focus to the element focused when it opens.
+        button.current?.focus();
+        openMenu(event);
+    };
+
+    const onFinished = (): void => {
+        closeMenu();
+        button.current?.focus();
+    };
+
+    const onTriggerKeyDown = (event: React.KeyboardEvent<Element>): void => {
+        if (event.key === "Escape" && menuDisplayed) {
+            closeMenu(event);
+            return;
+        }
+        onKeyDown?.(event);
+    };
+
+    const rect = menuDisplayed && button.current?.getBoundingClientRect();
+
+    return <>
+        <ContextMenuButton
+            {...buttonProps}
+            element="button"
+            type="button"
+            kind={kind ?? "icon"}
+            className={classNames("mx_KebabContextMenu", className)}
+            inputRef={button}
+            label={title}
+            disabled={disabled}
+            aria-disabled={disabled}
+            isExpanded={menuDisplayed}
+            onClick={onOpen}
+            onKeyDown={onTriggerKeyDown}
+        >
+            <span className="mx_KebabContextMenu_icon" aria-hidden="true" />
+        </ContextMenuButton>
+        { rect && <IconizedContextMenu
+            left={rect.right}
+            top={rect.bottom + 8}
+            rightAligned
+            chevronFace={ChevronFace.None}
+            menuClassName="mx_KebabContextMenu_menu"
+            onFinished={onFinished}
+            closeOnInteraction
+        >
+            { options }
+        </IconizedContextMenu> }
+    </>;
+};
+
+export default KebabContextMenu;
