+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	mux, err := New(Config{Listener: listener, Context: ctx})
+	require.NoError(t, err)
+	go mux.Serve()
+	defer func() {
+		require.NoError(t, mux.Close())
+		mux.Wait()
+	}()
+
+	remoteAddrs := make(chan string, 1)
+	server, err := sshutils.NewServer(
+		"test",
+		utils.NetAddr{AddrNetwork: "tcp", Addr: "localhost:0"},
+		sshutils.NewChanHandlerFunc(func(_ context.Context, _ *sshutils.ConnectionContext, ch ssh.NewChannel) {
+			ch.Reject(ssh.Prohibited, "unexpected channel")
+		}),
+		[]ssh.Signer{signer},
+		sshutils.AuthMethods{Password: func(conn ssh.ConnMetadata, password []byte) (*ssh.Permissions, error) {
+			remoteAddrs <- conn.RemoteAddr().String()
+			return nil, nil
+		}},
+	)
+	require.NoError(t, err)
+	go server.Serve(mux.SSH())
+	defer server.Close()
+
+	client, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	defer client.Close()
+	require.NoError(t, client.SetDeadline(time.Now().Add(10*time.Second)))
+	const clientAddr = "192.0.2.10:3022"
+	_, err = io.WriteString(client, apisshutils.ProxyHelloSignature+`{"clientAddr":"`+clientAddr+`"}`+"\x00")
