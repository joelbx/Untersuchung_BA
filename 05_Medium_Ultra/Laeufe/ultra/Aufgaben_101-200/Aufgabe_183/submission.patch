 	ovalmodels "github.com/vulsio/goval-dictionary/models"
 )
 
+func TestUbuntu2204FillWithOval(t *testing.T) {
+	defs := []ovalmodels.Definition{{
+		DefinitionID: "oval:ubuntu:22.04:1",
+		Advisory: ovalmodels.Advisory{
+			Cves: []ovalmodels.Cve{{CveID: "CVE-2022-0001"}},
+		},
+		AffectedPacks: []ovalmodels.Package{{
+			Name:    "openssl",
+			Version: "1.0.0-1",
+		}},
+	}}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/packs/ubuntu/22.04/openssl" {
+			t.Errorf("request path = %q, want /packs/ubuntu/22.04/openssl", r.URL.Path)
+		}
+		if err := json.NewEncoder(w).Encode(defs); err != nil {
+			t.Errorf("encode definitions: %v", err)
+		}
+	}))
+	defer server.Close()
+
+	result := models.ScanResult{
+		Family:      constant.Ubuntu,
+		Release:     "22.04",
+		Container:   models.Container{ContainerID: "test-container"},
+		Packages:    models.Packages{"openssl": {Name: "openssl", Version: "1.0.0-0"}},
+		ScannedCves: models.VulnInfos{},
+	}
+	count, err := NewUbuntu(nil, server.URL).FillWithOval(&result)
+	if err != nil {
+		t.Fatalf("FillWithOval() error = %v", err)
+	}
+	if count != 1 {
+		t.Errorf("FillWithOval() count = %d, want 1", count)
+	}
+	if _, ok := result.ScannedCves["CVE-2022-0001"]; !ok {
+		t.Error("FillWithOval() did not add CVE-2022-0001")
+	}
+}
