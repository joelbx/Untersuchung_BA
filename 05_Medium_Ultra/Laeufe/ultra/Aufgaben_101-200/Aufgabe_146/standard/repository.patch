+class TestFactsLinuxHardwareGetSysinfoFacts(unittest.TestCase):
+
+    def setUp(self):
+        self.hardware = linux.LinuxHardware(module=Mock(), load_on_init=False)
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines')
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=False)
+    def test_missing_sysinfo(self, mock_exists, mock_get_file_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {})
+        mock_exists.assert_any_call('/proc/sysinfo')
+        mock_get_file_lines.assert_not_called()
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer:         IBM',
+        'Type:                 3906',
+        'Sequence Code:        00000000123ABC',
+        'Model:                123',
+        'UUID:                 unrelated',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_complete_sysinfo(self, mock_exists, mock_get_file_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'IBM',
+            'product_name': '3906',
+            'product_serial': '123ABC',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+        mock_get_file_lines.assert_called_once_with('/proc/sysinfo')
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Type:                 2964',
+        'Manufacturer:         ',
+        'Sequence Code:        ',
+        'Other Manufacturer:   unrelated',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', return_value=True)
+    def test_partial_sysinfo(self, mock_exists, mock_get_file_lines):
+        self.assertEqual(self.hardware.get_sysinfo_facts(), {
+            'system_vendor': 'NA',
+            'product_name': '2964',
+            'product_serial': 'NA',
+            'product_version': 'NA',
+            'product_uuid': 'NA',
+        })
+
+    @patch('ansible.module_utils.facts.hardware.linux.get_best_parsable_locale', return_value='C')
+    @patch('ansible.module_utils.facts.hardware.linux.get_file_lines', return_value=[
+        'Manufacturer:         IBM',
+        'Type:                 3906',
+        'Sequence Code:        00000000123ABC',
+    ])
+    @patch('ansible.module_utils.facts.hardware.linux.os.path.exists', side_effect=lambda path: path == '/proc/sysinfo')
+    def test_populate_uses_sysinfo_when_dmi_is_unavailable(self, mock_exists, mock_get_file_lines, mock_locale):
+        self.hardware.module.get_bin_path.return_value = None
+        with patch.object(self.hardware, 'get_cpu_facts', return_value={}), \
+                patch.object(self.hardware, 'get_memory_facts', return_value={}), \
+                patch.object(self.hardware, 'get_device_facts', return_value={}), \
+                patch.object(self.hardware, 'get_uptime_facts', return_value={}), \
+                patch.object(self.hardware, 'get_lvm_facts', return_value={}), \
+                patch.object(self.hardware, 'get_mount_facts', return_value={}):
+            facts = self.hardware.populate(collected_facts={'ansible_architecture': 's390x'})
+
+        self.assertEqual(facts['system_vendor'], 'IBM')
+        self.assertEqual(facts['product_name'], '3906')
+        self.assertEqual(facts['product_serial'], '123ABC')
+        self.assertEqual(facts['product_version'], 'NA')
+        self.assertEqual(facts['product_uuid'], 'NA')
