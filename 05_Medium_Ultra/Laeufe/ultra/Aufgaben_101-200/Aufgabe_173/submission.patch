+package types
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestDatabaseServerStringIncludesHostID(t *testing.T) {
+	server := NewDatabaseServerV3("orders", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	if got := server.String(); !strings.Contains(got, "HostID=host-1") {
+		t.Fatalf("server string %q does not contain host ID", got)
+	}
+}
+
+func TestSortedDatabaseServers(t *testing.T) {
+	servers := []DatabaseServer{
+		NewDatabaseServerV3("orders", nil, DatabaseServerSpecV3{HostID: "host-2"}),
+		NewDatabaseServerV3("users", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+		NewDatabaseServerV3("orders", nil, DatabaseServerSpecV3{HostID: "host-1"}),
+	}
+	sort.Sort(SortedDatabaseServers(servers))
+
+	want := [][2]string{{"orders", "host-1"}, {"orders", "host-2"}, {"users", "host-1"}}
+	for i, server := range servers {
+		if got := [2]string{server.GetName(), server.GetHostID()}; got != want[i] {
+			t.Errorf("server %d: got %v, want %v", i, got, want[i])
+		}
+	}
+}
+
+func TestDeduplicateDatabaseServers(t *testing.T) {
+	first := NewDatabaseServerV3("orders", nil, DatabaseServerSpecV3{HostID: "host-1"})
+	second := NewDatabaseServerV3("users", nil, DatabaseServerSpecV3{HostID: "host-2"})
+	duplicate := NewDatabaseServerV3("orders", nil, DatabaseServerSpecV3{HostID: "host-3"})
+	servers := []DatabaseServer{first, second, duplicate}
+
+	got := DeduplicateDatabaseServers(servers)
+	if len(got) != 2 || got[0] != first || got[1] != second {
+		t.Fatalf("deduplicated servers = %v, want first orders and users servers", got)
+	}
+	got[0] = duplicate
+	if servers[0] != first {
+		t.Fatal("deduplicated slice shares backing storage with input")
+	}
+}
