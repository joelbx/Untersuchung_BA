+++ b/lib/srv/db/proxy_test.go
@@ -25,10 +25,60 @@ import (
 	"github.com/gravitational/teleport/lib/auth"
 	"github.com/gravitational/teleport/lib/events"
 	"github.com/gravitational/teleport/lib/multiplexer"
+	"github.com/gravitational/teleport/lib/reversetunnel"
 
 	"github.com/stretchr/testify/require"
 )
 
+// TestProxyDatabaseServerFailover verifies that an offline service instance
+// does not prevent connecting through another instance of the same database.
+func TestProxyDatabaseServerFailover(t *testing.T) {
+	ctx := context.Background()
+	testCtx := setupTestContext(ctx, t, withSelfHostedPostgres("postgres"))
+	healthy := testCtx.postgres["postgres"].server
+	offline := healthy.Copy().(*types.DatabaseServerV3)
+	offline.Spec.HostID = "offline-host"
+	_, err := testCtx.authClient.UpsertDatabaseServer(ctx, offline)
+	require.NoError(t, err)
+
+	tunnel := testCtx.proxyServer.cfg.Tunnel.(*reversetunnel.FakeServer)
+	site := tunnel.Sites[0].(*reversetunnel.FakeRemoteSite)
+	site.OfflineTunnels = map[string]bool{
+		offline.GetHostID() + "." + testCtx.clusterName: true,
+	}
+	// Always attempt the offline tunnel first, independent of auth server order.
+	candidateCounts := make(chan int, 2)
+	testCtx.proxyServer.cfg.Shuffle = func(servers []types.DatabaseServer) []types.DatabaseServer {
+		candidateCounts <- len(servers)
+		ordered := make([]types.DatabaseServer, 0, len(servers))
+		for _, server := range servers {
+			if server.GetHostID() == offline.GetHostID() {
+				ordered = append(ordered, server)
+			}
+		}
+		for _, server := range servers {
+			if server.GetHostID() != offline.GetHostID() {
+				ordered = append(ordered, server)
+			}
+		}
+		return ordered
+	}
+
+	go testCtx.startHandlingConnections()
+	testCtx.createUserAndRole(ctx, t, "alice", "admin", []string{"postgres"}, []string{"postgres"})
+
+	psql, err := testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.NoError(t, err)
+	require.NoError(t, psql.Close(ctx))
+	require.Equal(t, 2, <-candidateCounts)
+
+	site.OfflineTunnels[healthy.GetHostID()+"."+testCtx.clusterName] = true
+	_, err = testCtx.postgresClient(ctx, "alice", "postgres", "postgres", "postgres")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "could not connect to any database server")
+	require.Equal(t, 2, <-candidateCounts)
+}
+
