+import type { MARK_AS_STATUS } from '../../../hooks/actions/useMarkAs';
+import { Element } from '../../../models/element';
+import { getElementsToBypassFilter } from './elementBypassFilters';
+
+describe('getElementsToBypassFilter', () => {
+    const elements = [{ ID: 'first' }, { ID: 'second' }] as Element[];
+
+    it.each([
+        { action: 'unread' as MARK_AS_STATUS, unreadFilter: 1, shouldRemove: true },
+        { action: 'read' as MARK_AS_STATUS, unreadFilter: 0, shouldRemove: true },
+        { action: 'read' as MARK_AS_STATUS, unreadFilter: 1, shouldRemove: false },
+        { action: 'unread' as MARK_AS_STATUS, unreadFilter: 0, shouldRemove: false },
+        { action: 'read' as MARK_AS_STATUS, unreadFilter: undefined, shouldRemove: false },
+        { action: 'unread' as MARK_AS_STATUS, unreadFilter: undefined, shouldRemove: false },
+    ])('routes $action elements with Unread=$unreadFilter', ({ action, unreadFilter, shouldRemove }) => {
+        expect(getElementsToBypassFilter(elements, action, unreadFilter)).toEqual({
+            elementsToBypass: shouldRemove ? [] : elements,
+            elementsToRemove: shouldRemove ? elements : [],
+        });
+    });
+});
