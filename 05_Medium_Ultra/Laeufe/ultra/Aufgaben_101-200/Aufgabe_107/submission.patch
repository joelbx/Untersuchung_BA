+import type { MARK_AS_STATUS } from '../../hooks/actions/useMarkAs';
+import { Element } from '../../models/element';
+import { optimisticMarkAs } from './elementsActions';
+import elementsReducer, { newState } from './elementsSlice';
+
+describe('optimistic mark-as bypass filter', () => {
+    const read = 'read' as MARK_AS_STATUS;
+    const unread = 'unread' as MARK_AS_STATUS;
+
+    it.each([
+        { mode: 'message', conversationMode: false, bypassID: 'message-1' },
+        { mode: 'conversation', conversationMode: true, bypassID: 'conversation-1' },
+    ])(
+        'removes a message bypass ID after it matches the Unread filter in $mode mode',
+        ({ conversationMode, bypassID }) => {
+            const message = { ID: 'message-1', ConversationID: 'conversation-1' } as Element;
+            const state = newState({ params: { filter: { Unread: 1 } } });
+            state.bypassFilter = ['unrelated'];
+
+            const markRead = optimisticMarkAs({
+                elements: [message],
+                bypass: true,
+                markAsStatus: read,
+                conversationMode,
+            });
+            const bypassed = elementsReducer(state, markRead);
+            expect(bypassed.bypassFilter).toEqual(['unrelated', bypassID]);
+            expect(elementsReducer(bypassed, markRead).bypassFilter).toEqual(['unrelated', bypassID]);
+
+            const restored = elementsReducer(
+                bypassed,
+                optimisticMarkAs({ elements: [message], bypass: true, markAsStatus: unread, conversationMode })
+            );
+            expect(restored.bypassFilter).toEqual(['unrelated']);
+            expect(restored.elements[message.ID]).toEqual(message);
+        }
+    );
+
+    it('removes a conversation bypass ID after it matches the Read filter', () => {
+        const conversation = { ID: 'conversation-2' } as Element;
+        const state = newState({ params: { filter: { Unread: 0 } } });
+
+        const bypassed = elementsReducer(
+            state,
+            optimisticMarkAs({ elements: [conversation], bypass: true, markAsStatus: unread, conversationMode: true })
+        );
+        expect(bypassed.bypassFilter).toEqual([conversation.ID]);
+
+        const restored = elementsReducer(
+            bypassed,
+            optimisticMarkAs({ elements: [conversation], bypass: true, markAsStatus: read, conversationMode: true })
+        );
+        expect(restored.bypassFilter).toEqual([]);
+    });
+
+    it.each([
+        { bypass: true, markAsStatus: undefined },
+        { bypass: false, markAsStatus: read },
+    ])('leaves bypass IDs alone when bypass=$bypass and markAsStatus=$markAsStatus', ({ bypass, markAsStatus }) => {
+        const conversation = { ID: 'conversation-2' } as Element;
+        const state = newState({ params: { filter: { Unread: 1 } } });
+        state.bypassFilter = ['unrelated'];
+
+        const updated = elementsReducer(
+            state,
+            optimisticMarkAs({ elements: [conversation], bypass, markAsStatus, conversationMode: true })
+        );
+        expect(updated.bypassFilter).toEqual(['unrelated']);
+        expect(updated.elements[conversation.ID]).toEqual(conversation);
+    });
+});
