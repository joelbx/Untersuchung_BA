+@pytest.mark.parametrize("blocked_set", ["_blocked_hosts", "_config_blocked_hosts"])
+@pytest.mark.parametrize(
+    "blocked_host, request_url, expected",
+    [
+        ("example.com", "https://example.com/path", True),
+        ("example.com", "https://sub.example.com/path", True),
+        ("example.com", "https://a.b.example.com/path", True),
+        ("sub.example.com", "https://a.sub.example.com/path", True),
+        ("example.com", "https://example.com./path", True),
+        ("example.com", "https://a.example.com./path", True),
+        ("example.com.", "https://example.com/path", True),
+        ("example.com.", "https://a.example.com/path", True),
+        ("example.com.", "https://a.example.com./path", True),
+        ("example.com", "https://notexample.com/path", False),
+        ("example.com", "https://example.com.other.net/path", False),
+        ("sub.example.com", "https://example.com/path", False),
+    ],
+)
+def test_parent_domains_blocked(
+    config_stub, host_blocker_factory, blocked_set, blocked_host, request_url, expected
+):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.whitelist = []
+
+    host_blocker = host_blocker_factory()
+    getattr(host_blocker, blocked_set).add(blocked_host)
+
+    assert host_blocker._is_blocked(QUrl(request_url)) is expected
+
+
+def test_parent_domain_whitelist_override(config_stub, host_blocker_factory):
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.whitelist = [
+        "https://allowed.example.com/safe/*"
+    ]
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts.add("example.com")
+    host_blocker._config_blocked_hosts.add("example.com")
+
+    assert not host_blocker._is_blocked(QUrl("https://allowed.example.com/safe/ad"))
+    assert host_blocker._is_blocked(QUrl("https://allowed.example.com/other"))
+    assert host_blocker._is_blocked(QUrl("https://other.example.com/path"))
+
+
+def test_whitelist_short_circuits_host_lookup(config_stub, host_blocker_factory):
+    class NoLookupSet(set):
+        def __contains__(self, host):
+            raise AssertionError(f"Unexpected blocked-host lookup for {host}")
+
+    config_stub.val.content.blocking.method = "hosts"
+    config_stub.val.content.blocking.enabled = True
+    config_stub.val.content.blocking.hosts.lists = []
+    config_stub.val.content.blocking.whitelist = [
+        "https://allowed.example.com/safe/*"
+    ]
+
+    host_blocker = host_blocker_factory()
+    host_blocker._blocked_hosts = NoLookupSet({"example.com"})
+    host_blocker._config_blocked_hosts = NoLookupSet({"example.com"})
+
+    assert not host_blocker._is_blocked(QUrl("https://allowed.example.com/safe/ad"))
+
+
