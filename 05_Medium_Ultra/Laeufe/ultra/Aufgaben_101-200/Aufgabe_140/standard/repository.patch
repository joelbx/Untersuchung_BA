 HostTupleType = Tuple[str, str, int]
 
 
+def widened_hostnames(hostname: Optional[str]) -> Iterable[str]:
+    """Yield a hostname and its parent domains, from most to least specific.
+
+    Empty labels are retained, including a trailing dot. For example,
+    ``.example.`` yields ``.example.`` and ``example.``.
+    """
+    while hostname:
+        yield hostname
+        hostname = hostname.partition('.')[2]
+
