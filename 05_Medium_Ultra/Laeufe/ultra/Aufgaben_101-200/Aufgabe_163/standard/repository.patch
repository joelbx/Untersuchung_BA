+  user: app
+  password: secret
+  name: flipt
+  max_idle_conn: 7
+`,
+			want: DatabaseConfig{Protocol: Postgres, Host: "db.internal", Port: 5433, User: "app", Password: "secret", Name: "flipt", MigrationsPath: "/etc/flipt/config/migrations", MaxIdleConn: 7},
+		},
+		{
+			name: "sqlite path alias",
+			config: `db:
+  protocol: sqlite3
+  path: /var/opt/flipt
+  name: flipt.db
+`,
+			want: DatabaseConfig{Protocol: SQLite, Path: "/var/opt/flipt", Name: "flipt.db", MigrationsPath: "/etc/flipt/config/migrations", MaxIdleConn: 2},
+		},
+		{
+			name: "url takes precedence",
+			config: `db:
+  url: file:existing.db
+  protocol: mysql
+  host: ignored.internal
+  port: nonsense
+  user: ignored
+  password: ignored-secret
+  name: ignored
+`,
+			want: DatabaseConfig{URL: "file:existing.db", Protocol: MySQL, Host: "ignored.internal", User: "ignored", Password: "ignored-secret", Name: "ignored", MigrationsPath: "/etc/flipt/config/migrations", MaxIdleConn: 2},
+		},
+		{
+			name: "explicit empty url selects fields",
+			config: `db:
+  url: ""
+  protocol: mysql
+  host: db.internal
+  name: flipt
+`,
+			want: DatabaseConfig{Protocol: MySQL, Host: "db.internal", Name: "flipt", MigrationsPath: "/etc/flipt/config/migrations", MaxIdleConn: 2},
+		},
+		{
+			name: "unknown protocol with url",
+			config: `db:
