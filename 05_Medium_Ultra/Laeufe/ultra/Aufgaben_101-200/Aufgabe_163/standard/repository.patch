+func TestDatabaseProtocol(t *testing.T) {
+	assert.Equal(t, "sqlite", SQLite.String())
+	assert.Equal(t, "postgres", Postgres.String())
+	assert.Equal(t, "mysql", MySQL.String())
+}
+
+func loadConfigText(t *testing.T, content string) (*Config, error) {
+	t.Helper()
+	f, err := ioutil.TempFile("", "flipt-config-*.yml")
+	require.NoError(t, err)
+	defer os.Remove(f.Name())
+	_, err = f.WriteString(content)
+	require.NoError(t, err)
+	require.NoError(t, f.Close())
+	return Load(f.Name())
+}
+
+func TestLoadDatabaseFields(t *testing.T) {
