+func TestFilterInactiveWordPressLibs(t *testing.T) {
+	originalConf := config.Conf
+	defer func() { config.Conf = originalConf }()
+
+	packages := WordPressPackages{
+		{Name: "active-plugin", Status: "active", Type: WPPlugin},
+		{Name: "inactive-plugin", Status: "inactive", Type: WPPlugin},
+		{Name: "active-theme", Status: "active", Type: WPTheme},
+		{Name: "inactive-theme", Status: "inactive", Type: WPTheme},
+	}
+	allCves := VulnInfos{
+		"CVE-2024-0001": {CveID: "CVE-2024-0001", WpPackageFixStats: []WpPackageFixStatus{{Name: "active-plugin"}}},
+		"CVE-2024-0002": {CveID: "CVE-2024-0002", WpPackageFixStats: []WpPackageFixStatus{{Name: "inactive-plugin"}}},
+		"CVE-2024-0003": {CveID: "CVE-2024-0003", WpPackageFixStats: []WpPackageFixStatus{{Name: "active-theme"}}},
+		"CVE-2024-0004": {CveID: "CVE-2024-0004", WpPackageFixStats: []WpPackageFixStatus{{Name: "inactive-theme"}}},
+		"CVE-2024-0005": {CveID: "CVE-2024-0005", WpPackageFixStats: []WpPackageFixStatus{{Name: "inactive-plugin"}, {Name: "active-theme"}}},
+		"CVE-2024-0006": {CveID: "CVE-2024-0006"},
+	}
+
+	tests := []struct {
+		name           string
+		ignoreInactive bool
+		wantIDs        []string
+	}{
+		{
+			name:           "include inactive when disabled",
+			ignoreInactive: false,
+			wantIDs:        []string{"CVE-2024-0001", "CVE-2024-0002", "CVE-2024-0003", "CVE-2024-0004", "CVE-2024-0005", "CVE-2024-0006"},
+		},
+		{
+			name:           "exclude inactive when enabled",
+			ignoreInactive: true,
+			wantIDs:        []string{"CVE-2024-0001", "CVE-2024-0003", "CVE-2024-0005", "CVE-2024-0006"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			config.Conf.Servers = map[string]config.ServerInfo{
+				"wordpress-server": {WordPress: config.WordPressConf{IgnoreInactive: tt.ignoreInactive}},
+			}
+			config.Conf.WpIgnoreInactive = !tt.ignoreInactive
+			r := ScanResult{
+				ServerName:        "wordpress-server",
+				WordPressPackages: &packages,
+				ScannedCves:       allCves,
+			}
+			got := r.FilterInactiveWordPressLibs().ScannedCves
+			if len(got) != len(tt.wantIDs) {
+				t.Errorf("got %d CVEs, want %d", len(got), len(tt.wantIDs))
+			}
+			for _, id := range tt.wantIDs {
+				if _, ok := got[id]; !ok {
+					t.Errorf("missing %s", id)
+				}
+			}
+		})
+	}
+}
