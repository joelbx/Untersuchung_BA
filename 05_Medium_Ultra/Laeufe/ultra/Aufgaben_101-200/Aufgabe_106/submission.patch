@@ -0,0 +1,76 @@
+package wordpress
+
+import (
+	"testing"
+
+	c "github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestFillWordPressUsesServerIgnoreInactive(t *testing.T) {
+	previousConf := c.Conf
+	defer func() { c.Conf = previousConf }()
+
+	packages := models.WordPressPackages{
+		{Name: "wordpress", Type: models.WPCore, Version: "6.2"},
+		{Name: "active-theme", Type: models.WPTheme, Status: "active", Version: "1.0"},
+		{Name: "inactive-theme", Type: models.WPTheme, Status: models.Inactive, Version: "1.0"},
+		{Name: "active-plugin", Type: models.WPPlugin, Status: "active", Version: "1.0"},
+		{Name: "inactive-plugin", Type: models.WPPlugin, Status: models.Inactive, Version: "1.0"},
+	}
+
+	cacheBody := func(body string) *string { return &body }
+	cache := map[string]*string{
+		"62":              cacheBody(`{}`),
+		"active-theme":    cacheBody(`{"theme":{"vulnerabilities":[{"id":101,"fixed_in":"2.0"}]}}`),
+		"inactive-theme":  cacheBody(`{"theme":{"vulnerabilities":[{"id":102,"fixed_in":"2.0"}]}}`),
+		"active-plugin":   cacheBody(`{"plugin":{"vulnerabilities":[{"id":103,"fixed_in":"2.0"}]}}`),
+		"inactive-plugin": cacheBody(`{"plugin":{"vulnerabilities":[{"id":104,"fixed_in":"2.0"}]}}`),
+	}
+
+	for _, test := range []struct {
+		name           string
+		ignoreInactive bool
+		wantIDs        []string
+	}{
+		{
+			name:           "ignore inactive",
+			ignoreInactive: true,
+			wantIDs:        []string{"WPVDBID-101", "WPVDBID-103"},
+		},
+		{
+			name:           "include inactive",
+			ignoreInactive: false,
+			wantIDs:        []string{"WPVDBID-101", "WPVDBID-102", "WPVDBID-103", "WPVDBID-104"},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			// Set the old global flag to the opposite value to catch accidental use.
+			c.Conf.WpIgnoreInactive = !test.ignoreInactive
+			c.Conf.Servers = map[string]c.ServerInfo{
+				"server": {WordPress: c.WordPressConf{IgnoreInactive: test.ignoreInactive}},
+			}
+			result := models.ScanResult{
+				ServerName:        "server",
+				WordPressPackages: &packages,
+				ScannedCves:       models.VulnInfos{},
+			}
+
+			count, err := FillWordPress(&result, "unused-token", cache)
+			if err != nil {
+				t.Fatalf("FillWordPress returned an error: %v", err)
+			}
+			if count != len(test.wantIDs) {
+				t.Errorf("vulnerability count = %d, want %d", count, len(test.wantIDs))
+			}
+			if len(result.ScannedCves) != len(test.wantIDs) {
+				t.Errorf("scanned CVEs = %d, want %d", len(result.ScannedCves), len(test.wantIDs))
+			}
+			for _, id := range test.wantIDs {
+				if _, ok := result.ScannedCves[id]; !ok {
+					t.Errorf("missing vulnerability %s", id)
+				}
+			}
+		})
+	}
+}
