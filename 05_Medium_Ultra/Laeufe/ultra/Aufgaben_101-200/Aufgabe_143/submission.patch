+def test_add_db_name():
+    authors = [
+        {'name': 'Name only'},
+        {'name': 'General date', 'date': 'fl. 1950'},
+        {'name': 'Birth only', 'birth_date': '1895'},
+        {'name': 'Death only', 'death_date': '1964'},
+        {'name': 'Both dates', 'birth_date': '1895', 'death_date': '1964'},
+    ]
+    assert add_db_name({'authors': authors}) is None
+    assert [author['db_name'] for author in authors] == [
+        'Name only',
+        'General date fl. 1950',
+        'Birth only 1895-',
+        'Death only -1964',
+        'Both dates 1895-1964',
+    ]
+
+    for record in ({}, {'authors': None}, {'authors': []}):
+        assert add_db_name(record) is None
+
+
+def test_expand_record_adds_author_identifiers():
+    edition = {
+        'title': 'A test title',
+        'authors': [
+            {'name': 'Author without dates'},
+            {'name': 'Author with dates', 'birth_date': '1900', 'death_date': '1980'},
+        ],
+    }
+
+    expanded_record = expand_record(edition)
+
+    assert [author['db_name'] for author in expanded_record['authors']] == [
+        'Author without dates',
+        'Author with dates 1900-1980',
+    ]
+
