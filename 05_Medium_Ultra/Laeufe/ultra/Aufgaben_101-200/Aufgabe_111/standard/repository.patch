+func parseAmazonLinuxRelease(systemRelease string) string {
+	fields := strings.Fields(systemRelease)
+	if len(fields) >= 4 && fields[0] == "Amazon" && fields[1] == "Linux" && fields[2] == "release" {
+		return strings.Join(fields[3:], " ")
+	}
+	if len(fields) >= 3 && fields[0] == "Amazon" && fields[1] == "Linux" && fields[2] != "AMI" {
+		return strings.Join(fields[2:], " ")
+	}
+	if len(fields) == 5 {
+		return fields[4]
+	}
+	return "unknown"
+}
+
+func isAmazonLinux2023OrLater(distro config.Distro) bool {
+	if distro.Family != constant.Amazon {
+		return false
+	}
+	version, err := distro.MajorVersion()
+	return err == nil && version >= 2023
+}
