+func getOvalRelease(family, release string) (string, error) {
+	switch family {
+	case constant.CentOS:
+		return strings.TrimPrefix(release, "stream"), nil
+	case constant.Amazon:
+		version, err := (config.Distro{Family: family, Release: release}).MajorVersion()
+		if err != nil {
+			return "", xerrors.Errorf("Failed to determine Amazon Linux release %q: %w", release, err)
+		}
+		return strconv.Itoa(version), nil
+	default:
+		return release, nil
+	}
+}
