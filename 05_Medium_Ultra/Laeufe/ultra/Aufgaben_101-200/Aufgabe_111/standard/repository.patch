+func TestGetEOLAmazonLinux(t *testing.T) {
+	tests := []struct {
+		release string
+		year    int
+	}{
+		{release: "2023", year: 2028},
+		{release: "2023 (Amazon Linux)", year: 2028},
+		{release: "2025", year: 2030},
+		{release: "2027", year: 2032},
+		{release: "2029", year: 2034},
+	}
+	for _, tt := range tests {
+		t.Run(tt.release, func(t *testing.T) {
+			eol, found := GetEOL(Amazon, tt.release)
+			if !found {
+				t.Fatal("GetEOL did not find the Amazon Linux release")
+			}
+			end := time.Date(tt.year, 6, 30, 23, 59, 59, 0, time.UTC)
+			if !eol.StandardSupportUntil.Equal(end) {
+				t.Errorf("StandardSupportUntil = %s, want %s", eol.StandardSupportUntil, end)
+			}
+			if eol.IsStandardSupportEnded(end) || eol.IsExtendedSupportEnded(end) {
+				t.Error("support ended before the end of the final support day")
+			}
+			if !eol.IsStandardSupportEnded(end.Add(time.Second)) || !eol.IsExtendedSupportEnded(end.Add(time.Second)) {
+				t.Error("support did not end after the final support day")
+			}
+		})
+	}
+	for _, release := range []string{"", "2024", "2024 (Amazon Linux)", "unknown"} {
+		t.Run("unknown "+release, func(t *testing.T) {
+			if _, found := GetEOL(Amazon, release); found {
+				t.Errorf("GetEOL unexpectedly found Amazon Linux release %q", release)
+			}
+		})
+	}
+}
