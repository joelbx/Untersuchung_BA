+func amazonAdvisorySourceLink(advisoryID string) string {
+	if matches := amazonYearAdvisoryPattern.FindStringSubmatch(advisoryID); matches != nil {
+		return fmt.Sprintf("https://alas.aws.amazon.com/AL%s/ALAS-%s.html", matches[1], matches[2])
+	}
+	if strings.HasPrefix(advisoryID, "ALAS2-") {
+		return fmt.Sprintf("https://alas.aws.amazon.com/AL2/%s.html", strings.Replace(advisoryID, "ALAS2", "ALAS", 1))
+	}
+	if strings.HasPrefix(advisoryID, "ALAS-") {
+		return fmt.Sprintf("https://alas.aws.amazon.com/%s.html", advisoryID)
+	}
+	return ""
+}
