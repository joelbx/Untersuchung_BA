+def match_current_rt(rt, direction, current, rt_commands):
+    """Append any commands needed for the requested route-target direction."""
+    if direction == 'both':
+        for entry_direction in ('import', 'export'):
+            match_current_rt(rt, entry_direction, current, rt_commands)
+        return rt_commands
+
+    command = 'route-target %s %s' % (direction, rt['rt'])
+    configured = command in set(line.strip() for line in (current or '').splitlines())
+    if rt.get('state', 'present') == 'present' and not configured:
+        if command not in rt_commands:
+            rt_commands.append(command)
+    elif rt.get('state', 'present') == 'absent' and configured:
+        no_command = 'no %s' % command
+        if no_command not in rt_commands:
+            rt_commands.append(no_command)
+    return rt_commands
