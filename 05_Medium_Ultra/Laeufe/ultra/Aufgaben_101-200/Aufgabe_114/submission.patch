+// ArtistFolder returns the folder shared by the albums of an artist. Albums
+// whose media is spread across multiple directories may have their tracks in
+// separate disc folders, or in separate album folders. When the folder names
+// cannot distinguish these layouts, the other albums must agree on a folder.
+func (als Albums) ArtistFolder() string {
+	var candidates []string
+	for _, al := range als {
+		folders := al.artistFolderCandidates()
+		if len(folders) == 0 {
+			continue
+		}
+		if candidates == nil {
+			candidates = folders
+			continue
+		}
+		var shared []string
+		for _, candidate := range candidates {
+			for _, folder := range folders {
+				if candidate == folder {
+					shared = append(shared, candidate)
+					break
+				}
+			}
+		}
+		if len(shared) == 0 {
+			return ""
+		}
+		candidates = shared
+	}
+	if len(candidates) == 1 {
+		return candidates[0]
+	}
+	return ""
+}
+
+func (al Album) artistFolderCandidates() []string {
+	dirs := al.Dirs()
+	common := commonMediaDir(dirs)
+	if common == "" {
+		return nil
+	}
+	parent := filepath.Dir(common)
+	commonIsArtist := sameDirectoryName(common, al.AlbumArtist) && !sameDirectoryName(parent, al.AlbumArtist)
+	parentIsArtist := sameDirectoryName(parent, al.AlbumArtist)
+
+	if commonIsArtist {
+		return validArtistFolders(common)
+	}
+	if len(dirs) == 1 || parentIsArtist || sameDirectoryName(common, al.Name) {
+		return validArtistFolders(parent)
+	}
+	return validArtistFolders(common, parent)
+}
+
+func sameDirectoryName(folder, name string) bool {
+	return name != "" && strings.EqualFold(filepath.Base(folder), name)
+}
+
+func validArtistFolders(folders ...string) []string {
+	var valid []string
+	for _, folder := range folders {
+		if folder != "" && folder != "." && folder != filepath.Dir(folder) {
+			valid = append(valid, folder)
+		}
+	}
+	return valid
+}
+
+// commonMediaDir finds the deepest directory that contains every media
+// directory. filepath.Rel keeps component boundaries intact (for example,
+// Artist and Artist Two do not share a directory named Artist).
+func commonMediaDir(dirs []string) string {
+	if len(dirs) == 0 {
+		return ""
+	}
+	base := filepath.Clean(dirs[0])
+	for _, dir := range dirs[1:] {
+		for {
+			rel, err := filepath.Rel(base, filepath.Clean(dir))
+			if err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+				break
+			}
+			parent := filepath.Dir(base)
+			if parent == base {
+				return ""
+			}
+			base = parent
+		}
+	}
+	return base
+}
