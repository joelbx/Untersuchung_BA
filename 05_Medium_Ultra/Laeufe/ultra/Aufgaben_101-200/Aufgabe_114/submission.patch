+func fromArtistFolder(ctx context.Context, folder string) sourceFunc {
+	return func() (io.ReadCloser, string, error) {
+		if folder == "" {
+			return nil, "", nil
+		}
+		files, err := artistImageFiles(folder)
+		if err != nil {
+			return nil, "", err
+		}
+		for _, file := range files {
+			f, err := os.Open(file)
+			if err != nil {
+				log.Warn(ctx, "Could not open artist image file", "file", file, err)
+				continue
+			}
+			return f, file, nil
+		}
+		return nil, "", nil
+	}
+}
+
+func artistImageFiles(folder string) ([]string, error) {
+	entries, err := os.ReadDir(folder)
+	if err != nil {
+		return nil, err
+	}
+	var files []string
+	for _, entry := range entries {
+		match, _ := filepath.Match("artist.*", strings.ToLower(entry.Name()))
+		if !match || !model.IsImageFile(entry.Name()) {
+			continue
+		}
+		file := filepath.Join(folder, entry.Name())
+		info, err := os.Stat(file)
+		if err == nil && info.Mode().IsRegular() {
+			files = append(files, file)
+		}
+	}
+	return files, nil
+}
