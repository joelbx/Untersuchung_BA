+// artistFolderVersion changes the artist image cache key when a local image is
+// added, removed, or replaced, including when album timestamps stay the same.
+func artistFolderVersion(folder string) string {
+	if folder == "" {
+		return "artist-folder-v1-none"
+	}
+	h := fnv.New64a()
+	_, _ = io.WriteString(h, "artist-folder-v1:"+folder)
+	if info, err := os.Stat(folder); err == nil {
+		_, _ = fmt.Fprintf(h, ":%d", info.ModTime().UnixNano())
+	}
+	files, _ := artistImageFiles(folder)
+	for _, file := range files {
+		if info, err := os.Stat(file); err == nil {
+			_, _ = fmt.Fprintf(h, ":%s:%d:%d", filepath.Base(file), info.Size(), info.ModTime().UnixNano())
+		}
+	}
+	return strconv.FormatUint(h.Sum64(), 16)
+}
