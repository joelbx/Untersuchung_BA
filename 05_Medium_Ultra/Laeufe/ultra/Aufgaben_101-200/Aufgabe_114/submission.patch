+package migrations
+
+import (
+	"database/sql"
+	"encoding/json"
+	"path/filepath"
+	"sort"
+
+	"github.com/pressly/goose"
+)
+
+func init() {
+	goose.AddMigration(upAddAlbumMediaFileDirs, downAddAlbumMediaFileDirs)
+}
+
+func upAddAlbumMediaFileDirs(tx *sql.Tx) error {
+	if _, err := tx.Exec(`alter table album add media_file_dirs varchar not null default '[]'`); err != nil {
+		return err
+	}
+
+	// Populate existing albums so artist images can be found without a new scan.
+	rows, err := tx.Query(`select album_id, path from media_file where path <> '' order by album_id, path`)
+	if err != nil {
+		return err
+	}
+	defer rows.Close()
+	stmt, err := tx.Prepare(`update album set media_file_dirs = ? where id = ?`)
+	if err != nil {
+		return err
+	}
+	defer stmt.Close()
+
+	var albumID string
+	hasAlbum := false
+	dirs := make(map[string]struct{})
+	update := func() error {
+		if !hasAlbum {
+			return nil
+		}
+		unique := make([]string, 0, len(dirs))
+		for dir := range dirs {
+			unique = append(unique, dir)
+		}
+		sort.Strings(unique)
+		encoded, err := json.Marshal(unique)
+		if err != nil {
+			return err
+		}
+		_, err = stmt.Exec(string(encoded), albumID)
+		return err
+	}
+	for rows.Next() {
+		var id, path string
+		if err := rows.Scan(&id, &path); err != nil {
+			return err
+		}
+		if hasAlbum && id != albumID {
+			if err := update(); err != nil {
+				return err
+			}
+			dirs = make(map[string]struct{})
+		}
+		albumID, hasAlbum = id, true
+		dirs[filepath.Dir(path)] = struct{}{}
+	}
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	return update()
+}
+
+func downAddAlbumMediaFileDirs(tx *sql.Tx) error {
+	_, err := tx.Exec(`alter table album drop column media_file_dirs`)
+	return err
+}
