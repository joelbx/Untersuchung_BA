+		}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("uses the parent of a single album folder", func() {
+		albums := Albums{album("Artist", "/music/Artist/First")}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("handles an album split between disc folders", func() {
+		albums := Albums{
+			album("Artist", "/music/Artist/First/CD1", "/music/Artist/First/CD2"),
+			album("Artist", "/music/Artist/Second"),
+		}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("uses an album's name to resolve disc folders when it is the only album", func() {
+		al := album("Artist", "/music/Artist/First/CD1", "/music/Artist/First/CD2")
+		al.Name = "First"
+		Expect((Albums{al}).ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("does not guess for one album spread across differently named folders", func() {
+		albums := Albums{album("Artist", "/music/Artist Dir/First", "/music/Artist Dir/Second")}
+		Expect(albums.ArtistFolder()).To(BeEmpty())
+	})
+
+	It("uses the artist folder when tracks are directly in it", func() {
+		albums := Albums{album("Artist", "/music/Artist")}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("agrees across flat tracks and a separate album", func() {
+		albums := Albums{album("Artist", "/music/Artist"), album("Artist", "/music/Artist/Second")}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("uses the parent for a self-titled album", func() {
+		albums := Albums{album("Artist", "/music/Artist/Artist")}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("does not use a shared library folder for unrelated artist trees", func() {
+		albums := Albums{
+			album("Artist", "/music/Artist One/First"),
+			album("Artist", "/music/Artist Two/Second"),
+		}
+		Expect(albums.ArtistFolder()).To(BeEmpty())
+	})
+
+	It("ignores albums without media directories", func() {
+		albums := Albums{album("Artist"), album("Artist", "/music/Artist/First")}
+		Expect(albums.ArtistFolder()).To(Equal("/music/Artist"))
+	})
+
+	It("does not use the filesystem root as an artist folder", func() {
+		albums := Albums{album("Artist", "/")}
+		Expect(albums.ArtistFolder()).To(BeEmpty())
+	})
+})
