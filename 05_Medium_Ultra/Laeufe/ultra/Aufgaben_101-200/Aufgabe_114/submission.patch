@@ -0,0 +1,85 @@
+package migrations
+
+import (
+	"database/sql"
+	"encoding/json"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestAddAlbumMediaFileDirsBackfillsExistingAlbums(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	_, err = db.Exec(`
+		create table album (id text primary key);
+		create table media_file (album_id text, path text);
+		insert into album (id) values ('album1'), ('album2'), ('album3');
+		insert into media_file (album_id, path) values
+			('album1', 'artist/album/disc2/02.flac'),
+			('album1', 'artist/album/disc1/01.flac'),
+			('album1', 'artist/album/disc1/02.flac'),
+			('album2', 'artist/other/01.flac');
+	`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	specialPath := filepath.Join("artist", "album"+string(filepath.ListSeparator)+"live", "disc3", "03.flac")
+	if _, err := db.Exec(`insert into media_file (album_id, path) values ('album1', ?)`, specialPath); err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := upAddAlbumMediaFileDirs(tx); err != nil {
+		_ = tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	var encoded string
+	if err := db.QueryRow(`select media_file_dirs from album where id = 'album1'`).Scan(&encoded); err != nil {
+		t.Fatal(err)
+	}
+	var dirs []string
+	if err := json.Unmarshal([]byte(encoded), &dirs); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		filepath.FromSlash("artist/album/disc1"),
+		filepath.FromSlash("artist/album/disc2"),
+		filepath.Dir(specialPath),
+	}
+	sort.Strings(want)
+	if !reflect.DeepEqual(dirs, want) {
+		t.Fatalf("album1 directories = %q, want %q", dirs, want)
+	}
+	if err := db.QueryRow(`select media_file_dirs from album where id = 'album2'`).Scan(&encoded); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal([]byte(encoded), &dirs); err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{filepath.FromSlash("artist/other")}; !reflect.DeepEqual(dirs, want) {
+		t.Fatalf("album2 directories = %q, want %q", dirs, want)
+	}
+	if err := db.QueryRow(`select media_file_dirs from album where id = 'album3'`).Scan(&encoded); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal([]byte(encoded), &dirs); err != nil {
+		t.Fatal(err)
+	}
+	if len(dirs) != 0 {
+		t.Fatalf("album3 directories = %q, want none", dirs)
+	}
+}
