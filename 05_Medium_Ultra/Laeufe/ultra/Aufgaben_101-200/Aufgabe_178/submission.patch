+def test_do_encrypt_bcrypt_ident():
+    if not encrypt.PASSLIB_AVAILABLE:
+        pytest.skip("passlib not available")
+
+    result = encrypt.do_encrypt('123', 'bcrypt', salt='123456789012345678901u', ident='2a')
+    assert result.startswith('$2a$')
