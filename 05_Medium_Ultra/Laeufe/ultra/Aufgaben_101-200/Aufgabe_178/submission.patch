+class TestLookupModuleIdent(BaseTestLookupModule):
+    def _lookup(self, term, stored_content=None):
+        with patch.object(password, '_get_lock', return_value=(False, b'lock')), \
+                patch.object(password, '_read_password_file', return_value=stored_content), \
+                patch.object(password, '_write_password_file') as write_file, \
+                patch.object(password, 'random_password', return_value=u'hunter42'), \
+                patch.object(password, 'random_salt', return_value=u'A' * 22), \
+                patch.object(password, 'do_encrypt', return_value=u'hashed') as encrypt:
+            result = self.password_lookup.run([term], None)
+        return result, write_file, encrypt
+
+    def test_explicit_ident_is_saved_and_reused(self):
+        result, write_file, encrypt = self._lookup(u'/path/to/somewhere encrypt=bcrypt ident=2b')
+        self.assertEqual(result, [u'hashed'])
+        write_file.assert_called_once_with(
+            to_bytes('/path/to/somewhere'), u'hunter42 salt=' + u'A' * 22 + u' ident=2b')
+        encrypt.assert_called_once_with(u'hunter42', 'bcrypt', salt=u'A' * 22, ident='2b')
+
+        saved = u'hunter42 salt=' + u'A' * 22 + u' ident=2b'
+        result, write_file, encrypt = self._lookup(u'/path/to/somewhere encrypt=bcrypt', saved)
+        self.assertEqual(result, [u'hashed'])
+        write_file.assert_not_called()
+        encrypt.assert_called_once_with(u'hunter42', 'bcrypt', salt=u'A' * 22, ident='2b')
+
+    def test_bcrypt_defaults_to_2a(self):
+        result, write_file, encrypt = self._lookup(u'/path/to/somewhere encrypt=bcrypt')
+        self.assertEqual(result, [u'hashed'])
+        write_file.assert_called_once_with(
+            to_bytes('/path/to/somewhere'), u'hunter42 salt=' + u'A' * 22 + u' ident=2a')
+        encrypt.assert_called_once_with(u'hunter42', 'bcrypt', salt=u'A' * 22, ident='2a')
+
+    def test_legacy_salt_only_file_gets_default_ident(self):
+        saved = u'hunter42 salt=' + u'A' * 22
+        result, write_file, encrypt = self._lookup(u'/path/to/somewhere encrypt=bcrypt', saved)
+        self.assertEqual(result, [u'hashed'])
+        write_file.assert_called_once_with(to_bytes('/path/to/somewhere'), saved + u' ident=2a')
+        encrypt.assert_called_once_with(u'hunter42', 'bcrypt', salt=u'A' * 22, ident='2a')
+
+    def test_explicit_ident_updates_saved_ident(self):
+        saved = u'hunter42 salt=' + u'A' * 22 + u' ident=2y'
+        result, write_file, encrypt = self._lookup(u'/path/to/somewhere encrypt=bcrypt ident=2b', saved)
+        self.assertEqual(result, [u'hashed'])
+        write_file.assert_called_once_with(
+            to_bytes('/path/to/somewhere'), u'hunter42 salt=' + u'A' * 22 + u' ident=2b')
+        encrypt.assert_called_once_with(u'hunter42', 'bcrypt', salt=u'A' * 22, ident='2b')
+
+    def test_non_bcrypt_ignores_ident(self):
