+        encrypt.assert_called_once_with(u'hunter42', 'sha256_crypt', salt=u'A' * 22)
+
+    def test_invalid_bcrypt_ident_rejected_before_lock(self):
+        with patch.object(password, '_get_lock') as get_lock:
+            self.assertRaises(AnsibleError, self.password_lookup.run,
+                              [u'/path/to/somewhere encrypt=bcrypt ident=invalid'], None)
+        get_lock.assert_not_called()
+
+
+def test_bcrypt_ident_roundtrip(tmpdir):
+    path = str(tmpdir.join('password'))
+    lookup = password.LookupModule(loader=DictDataLoader({}))
+
+    first = lookup.run([path + ' encrypt=bcrypt ident=2b'], None)[0]
+    assert first.startswith('$2b$')
+    saved = tmpdir.join('password').read()
+    assert saved.rstrip().endswith(' ident=2b')
+
+    second = lookup.run([path + ' encrypt=bcrypt'], None)[0]
+    assert second == first
+    assert tmpdir.join('password').read() == saved
+
