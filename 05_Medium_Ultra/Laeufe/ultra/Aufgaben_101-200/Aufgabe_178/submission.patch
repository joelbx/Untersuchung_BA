+def test_crypt_bcrypt_ident_saltstring(monkeypatch, ident):
+    seen = []
+
+    def crypt_hash(secret, saltstring):
+        seen.append((secret, saltstring))
+        return saltstring + 'hash'
+
+    monkeypatch.setattr(encrypt.crypt, 'crypt', crypt_hash)
+    result = encrypt.CryptHash('bcrypt').hash('123', salt='123456789012345678901u', rounds=4, ident=ident)
+    assert seen == [('123', '$%s$04$123456789012345678901u' % ident)]
+    assert result.startswith('$%s$' % ident)
+
+
+@pytest.mark.skipif(sys.platform.startswith('darwin'), reason='macOS requires passlib')
+def test_crypt_bcrypt_rejects_unsupported_ident(monkeypatch):
+    monkeypatch.setattr(encrypt.crypt, 'crypt', lambda secret, saltstring: '*0')
+    with pytest.raises(AnsibleError, match="crypt.crypt does not support 'bcrypt' algorithm with ident '2'"):
+        encrypt.CryptHash('bcrypt').hash('123', salt='123456789012345678901u', rounds=4, ident='2')
+
+
+@pytest.mark.parametrize('algorithm', ('md5_crypt', 'sha256_crypt', 'sha512_crypt'))
+def test_ident_ignored_for_non_bcrypt(algorithm):
+    salt = '12345678'
+    assert encrypt.passlib_or_crypt('123', algorithm, salt=salt, ident='unsupported') == encrypt.passlib_or_crypt('123', algorithm, salt=salt)
+
