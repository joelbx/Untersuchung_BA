+	cvemodels "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestGetMaxConfidenceWithFortinet(t *testing.T) {
+	tests := []struct {
+		name   string
+		detail cvemodels.CveDetail
+		want   models.Confidence
+	}{
+		{
+			name:   "Fortinet exact version",
+			detail: cvemodels.CveDetail{Fortinets: []cvemodels.Fortinet{{DetectionMethod: cvemodels.FortinetExactVersionMatch}}},
+			want:   models.FortinetExactVersionMatch,
+		},
+		{
+			name: "Fortinet rough version beats NVD vendor product",
+			detail: cvemodels.CveDetail{
+				Nvds:      []cvemodels.Nvd{{DetectionMethod: cvemodels.NvdVendorProductMatch}},
+				Fortinets: []cvemodels.Fortinet{{DetectionMethod: cvemodels.FortinetVendorProductMatch}, {DetectionMethod: cvemodels.FortinetRoughVersionMatch}},
+				Jvns:      []cvemodels.Jvn{{DetectionMethod: cvemodels.JvnVendorProductMatch}},
+			},
+			want: models.FortinetRoughVersionMatch,
+		},
+		{
+			name: "NVD exact version beats Fortinet rough version",
+			detail: cvemodels.CveDetail{
+				Nvds:      []cvemodels.Nvd{{DetectionMethod: cvemodels.NvdExactVersionMatch}},
+				Fortinets: []cvemodels.Fortinet{{DetectionMethod: cvemodels.FortinetRoughVersionMatch}},
+			},
+			want: models.NvdExactVersionMatch,
+		},
+		{
+			name: "Fortinet vendor product beats JVN on equal score",
+			detail: cvemodels.CveDetail{
+				Fortinets: []cvemodels.Fortinet{{DetectionMethod: cvemodels.FortinetVendorProductMatch}},
+				Jvns:      []cvemodels.Jvn{{DetectionMethod: cvemodels.JvnVendorProductMatch}},
+			},
+			want: models.FortinetVendorProductMatch,
+		},
+		{
+			name: "JVN remains a signal when NVD method is unknown",
+			detail: cvemodels.CveDetail{
+				Nvds: []cvemodels.Nvd{{DetectionMethod: "unknown"}},
+				Jvns: []cvemodels.Jvn{{DetectionMethod: cvemodels.JvnVendorProductMatch}},
+			},
+			want: models.JvnVendorProductMatch,
+		},
+		{
+			name:   "no sources",
+			detail: cvemodels.CveDetail{},
+			want:   models.Confidence{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := getMaxConfidence(tt.detail); got != tt.want {
+				t.Fatalf("getMaxConfidence() = %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestDetectCveByCpeURIRetainsFortinetWithoutJVN(t *testing.T) {
+	details := []cvemodels.CveDetail{
+		{CveID: "CVE-NVD", Nvds: []cvemodels.Nvd{{}}, Jvns: []cvemodels.Jvn{{}}},
+		{CveID: "CVE-FORTINET", Fortinets: []cvemodels.Fortinet{{}}, Jvns: []cvemodels.Jvn{{}}},
+		{CveID: "CVE-JVN", Jvns: []cvemodels.Jvn{{}}},
+		{CveID: "CVE-EMPTY"},
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if err := json.NewEncoder(w).Encode(details); err != nil {
+			t.Errorf("encode response: %v", err)
+		}
+	}))
+	defer server.Close()
+
+	client := goCveDictClient{baseURL: server.URL}
+	got, err := client.detectCveByCpeURI("cpe:/o:fortinet:fortios:4.3.0", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].CveID != "CVE-NVD" || got[1].CveID != "CVE-FORTINET" {
+		t.Fatalf("filtered CVEs = %+v", got)
+	}
+	for _, detail := range got {
+		if detail.HasJvn() {
+			t.Fatalf("JVN data was not removed from %s", detail.CveID)
+		}
+	}
+}
+
+func TestFortinetOnlyCpeDetectionAndEnrichment(t *testing.T) {
+	const cveID = "CVE-2023-0001"
+	const cpeURI = "cpe:/o:fortinet:fortios:4.3.0"
+	detail := cvemodels.CveDetail{
+		CveID: cveID,
+		Fortinets: []cvemodels.Fortinet{
+			{
+				AdvisoryID:      "FG-IR-23-001",
+				AdvisoryURL:     "https://fortiguard.example/001",
+				Title:           "FortiOS vulnerability",
+				Summary:         "Affected versions",
+				Cvss3:           cvemodels.FortinetCvss3{Cvss3: cvemodels.Cvss3{BaseScore: 8.8}},
+				DetectionMethod: cvemodels.FortinetExactVersionMatch,
+			},
+			{
+				AdvisoryID:      "FG-IR-23-002",
+				AdvisoryURL:     "https://fortiguard.example/002",
+				Title:           "Another advisory",
+				DetectionMethod: cvemodels.FortinetRoughVersionMatch,
+			},
+		},
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		var err error
+		switch req.URL.Path {
+		case "/cpes":
+			err = json.NewEncoder(w).Encode([]cvemodels.CveDetail{detail})
+		case "/cves/" + cveID:
+			err = json.NewEncoder(w).Encode(detail)
+		default:
+			http.NotFound(w, req)
+			return
+		}
+		if err != nil {
+			t.Errorf("encode response: %v", err)
+		}
+	}))
+	defer server.Close()
+
+	cnf := config.GoCveDictConf{VulnDict: config.VulnDict{Type: "http", URL: server.URL}}
+	r := models.ScanResult{ScannedCves: models.VulnInfos{}}
+	if err := DetectCpeURIsCves(&r, []Cpe{{CpeURI: cpeURI, UseJVN: false}, {CpeURI: cpeURI, UseJVN: false}}, cnf, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	v, ok := r.ScannedCves[cveID]
+	if !ok {
+		t.Fatal("Fortinet-only CVE was not detected")
+	}
+	if len(v.DistroAdvisories) != 2 || v.DistroAdvisories[0].AdvisoryID != "FG-IR-23-001" || v.DistroAdvisories[1].AdvisoryID != "FG-IR-23-002" {
+		t.Fatalf("Fortinet advisories = %+v", v.DistroAdvisories)
+	}
+	if len(v.Confidences) != 1 || v.Confidences[0] != models.FortinetExactVersionMatch {
+		t.Fatalf("Fortinet confidence = %+v", v.Confidences)
+	}
+	if err := FillCvesWithNvdJvnFortinet(&r, cnf, logging.LogOpts{}); err != nil {
+		t.Fatal(err)
+	}
+	contents := r.ScannedCves[cveID].CveContents[models.Fortinet]
+	if len(contents) != 2 || contents[0].SourceLink != "https://fortiguard.example/001" || contents[0].Cvss3Score != 8.8 || contents[1].Title != "Another advisory" {
+		t.Fatalf("Fortinet contents = %+v", contents)
+	}
+}
