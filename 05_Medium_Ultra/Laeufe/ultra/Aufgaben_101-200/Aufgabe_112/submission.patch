@@ -0,0 +1,69 @@
+//go:build !scanner
+// +build !scanner
+
+package models
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	cvedict "github.com/vulsio/go-cve-dictionary/models"
+)
+
+func TestConvertFortinetToModel(t *testing.T) {
+	published := time.Date(2023, 1, 2, 3, 4, 5, 0, time.UTC)
+	modified := published.Add(24 * time.Hour)
+	got := ConvertFortinetToModel("CVE-2023-0001", []cvedict.Fortinet{
+		{
+			Title:   "FortiOS advisory",
+			Summary: "Affected FortiOS versions",
+			Cvss3:   cvedict.FortinetCvss3{Cvss3: cvedict.Cvss3{BaseScore: 8.8, VectorString: "CVSS:3.1/AV:N", BaseSeverity: "HIGH"}},
+			Cwes:    []cvedict.FortinetCwe{{CweID: "CWE-79"}, {CweID: "CWE-89"}},
+			References: []cvedict.FortinetReference{
+				{Reference: cvedict.Reference{Link: "https://example.com/reference", Source: "Fortinet", Tags: "Vendor Advisory,Third Party Advisory"}},
+				{Reference: cvedict.Reference{Link: "https://example.com/related", Name: "Related advisory"}},
+			},
+			AdvisoryURL:      "https://fortiguard.example/advisory-1",
+			PublishedDate:    published,
+			LastModifiedDate: modified,
+		},
+		{
+			Title:       "Second advisory",
+			AdvisoryURL: "https://fortiguard.example/advisory-2",
+		},
+	})
+	want := []CveContent{
+		{
+			Type:          Fortinet,
+			CveID:         "CVE-2023-0001",
+			Title:         "FortiOS advisory",
+			Summary:       "Affected FortiOS versions",
+			Cvss3Score:    8.8,
+			Cvss3Vector:   "CVSS:3.1/AV:N",
+			Cvss3Severity: "HIGH",
+			SourceLink:    "https://fortiguard.example/advisory-1",
+			CweIDs:        []string{"CWE-79", "CWE-89"},
+			References: []Reference{
+				{Link: "https://example.com/reference", Source: "Fortinet", Tags: []string{"Vendor Advisory", "Third Party Advisory"}},
+				{Link: "https://example.com/related", Source: "Related advisory"},
+			},
+			Published:    published,
+			LastModified: modified,
+		},
+		{
+			Type:       Fortinet,
+			CveID:      "CVE-2023-0001",
+			Title:      "Second advisory",
+			SourceLink: "https://fortiguard.example/advisory-2",
+			CweIDs:     []string{},
+			References: []Reference{},
+		},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("ConvertFortinetToModel() = %#v, want %#v", got, want)
+	}
+	if got[1].Empty() {
+		t.Fatal("title-only Fortinet advisory must not be empty")
+	}
+}
