+def test_extra_suffixes_workaround_qt_versions(monkeypatch, qt_version,
+                                               expected):
+    monkeypatch.setattr(webview.qtutils, "qVersion", lambda: qt_version)
+    # The workaround checks the runtime Qt version, even with older build versions.
+    monkeypatch.setattr(webview.qtutils, "QT_VERSION_STR", "6.2.2")
+    monkeypatch.setattr(webview.qtutils, "PYQT_VERSION_STR", "6.2.2")
+    monkeypatch.setattr(
+        webview.mimetypes, "guess_all_extensions",
+        lambda mime: [".jpg", ".jpe"] if mime == "image/jpeg" else [],
+    )
+
+    assert webview.extra_suffixes_workaround(["image/jpeg"]) == expected
+
