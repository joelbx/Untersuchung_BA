+def test_extra_suffixes_workaround_specific_mimes(monkeypatch, accepted,
+                                                  expected):
+    monkeypatch.setattr(webview.qtutils, "qVersion", lambda: "6.5.2")
+    suffixes = {
+        "image/jpeg": [".jpg", ".jpe"],
+        "image/png": [".png"],
+        "video/mp4": [".m4v", ".mpg4"],
+    }
+    monkeypatch.setattr(webview.mimetypes, "guess_all_extensions",
+                        lambda mime: suffixes[mime])
+
+    assert webview.extra_suffixes_workaround(accepted) == expected
+
