+def test_extra_suffixes_workaround_wildcard(monkeypatch):
+    monkeypatch.setattr(webview.qtutils, "qVersion", lambda: "6.5.2")
+    monkeypatch.setattr(webview.mimetypes, "types_map", {
+        ".jpg": "image/jpeg",
+        ".jpe": "image/jpeg",
+        ".png": "image/png",
+        ".mp4": "video/mp4",
+        ".other": "application/image",
+    })
+    monkeypatch.setattr(
