+def test_choose_files_adds_missing_suffixes(monkeypatch, config_stub, qapp):
+    config_stub.val.fileselect.handler = "default"
+    monkeypatch.setattr(webview.qtutils, "qVersion", lambda: "6.5.2")
+    monkeypatch.setattr(
+        webview.mimetypes, "guess_all_extensions",
+        lambda mime: [".jpg", ".jpe"] if mime == "image/jpeg" else [],
+    )
+    calls = []
+
+    def parent_choose_files(self, mode, old_files, accepted_mimetypes):
+        calls.append((mode, old_files, list(accepted_mimetypes)))
+        return ["chosen.jpg"]
+
+    monkeypatch.setattr(QWebEnginePage, "chooseFiles", parent_choose_files)
+    profile = QWebEngineProfile(qapp)
+    page = webview.WebEnginePage(theme_color=QColor("white"), profile=profile,
+                                  parent=profile)
+    mode = QWebEnginePage.FileSelectionMode.FileSelectOpen
+
+    accepted = iter(["image/jpeg", ".jpg"])
+    assert page.chooseFiles(mode, [], accepted) == ["chosen.jpg"]
+    assert len(calls) == 1
+    assert calls[0][:2] == (mode, [])
+    assert set(calls[0][2]) == {"image/jpeg", ".jpg", ".jpe"}
+    assert calls[0][2].count(".jpg") == 1
+    delete_qt_object(page)
