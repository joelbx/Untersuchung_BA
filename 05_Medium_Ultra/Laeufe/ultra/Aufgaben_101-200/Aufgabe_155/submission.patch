+func TestImageLocalReportRoundTrip(t *testing.T) {
+	dir, err := ioutil.TempDir("", "vuls-image-report-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	previousConf := config.Conf
+	defer func() { config.Conf = previousConf }()
+	config.Conf = config.Config{FormatJSON: true}
+
+	want := models.ScanResult{
+		ServerName: "0@host",
+		Image: models.Image{
+			Name:   "registry.example/team/app",
+			Digest: "sha256:abc",
+		},
+	}
+	if err := (LocalFileWriter{CurrentDir: dir}).Write(want); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, want.ReportFileName()+".json")); err != nil {
+		t.Fatalf("image report file was not written: %v", err)
+	}
+	results, err := LoadScanResults(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(results) != 1 || results[0].Image != want.Image || results[0].ServerName != want.ServerName {
+		t.Fatalf("loaded results = %+v, want image %+v on %q", results, want.Image, want.ServerName)
+	}
+
+	previousDir := filepath.Join(dir, "2020-01-01T03:04:05Z")
+	currentDir := filepath.Join(dir, "2020-01-02T03:04:05Z")
+	for _, path := range []string{previousDir, currentDir} {
+		if err := os.Mkdir(path, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	config.Conf.ResultsDir = dir
+	if err := (LocalFileWriter{CurrentDir: previousDir}).Write(want); err != nil {
+		t.Fatal(err)
+	}
+	previous, err := loadPrevious(models.ScanResults{want})
+	if err != nil || len(previous) != 1 || previous[0].Image != want.Image {
+		t.Fatalf("previous image result = %+v, err = %v", previous, err)
+	}
+	// Older reports used the server name as the image filename.
+	if err := os.Rename(filepath.Join(previousDir, want.ReportFileName()+".json"),
+		filepath.Join(previousDir, want.ServerName+".json")); err != nil {
+		t.Fatal(err)
+	}
+	previous, err = loadPrevious(models.ScanResults{want})
+	if err != nil || len(previous) != 1 || previous[0].Image != want.Image {
+		t.Fatalf("legacy image result = %+v, err = %v", previous, err)
+	}
+	changed := want
+	changed.Image.Digest = "sha256:def"
+	previous, err = loadPrevious(models.ScanResults{changed})
+	if err != nil || len(previous) != 0 {
+		t.Fatalf("previous result for a different digest = %+v, err = %v", previous, err)
+	}
