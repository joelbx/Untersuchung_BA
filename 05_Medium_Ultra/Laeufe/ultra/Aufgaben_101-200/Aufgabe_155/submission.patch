+// Image scans use an index-prefixed result name, while their configuration
+// remains under the original server name.
+func configServerNameForUUID(r models.ScanResult) string {
+	if !r.IsImage() {
+		return r.ServerName
+	}
+	if _, ok := c.Conf.Servers[r.ServerName]; ok {
+		return r.ServerName
+	}
+	for original, server := range c.Conf.Servers {
+		for alias, image := range server.Images {
+			if alias+"@"+original == r.ServerName &&
+				image.Name == r.Image.Name && image.Tag == r.Image.Tag && image.Digest == r.Image.Digest {
+				return original
+			}
+		}
+	}
+	return r.ServerName
+}
